    x64.sub r8, 8
    x64.lock inc qword ptr [r8]
    x64.mov r8d, 42
    x64.mov [rbx+0], r8 (8b)
    x64.lea rdx, [rip+__destruct_Outer]
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.xor r9d, r9d
    x64.mov [r8+0], r9 (8b)
    x64.mov [r8+0], rbx (8b)
    x64.mov r9, [r8+0] (8b)
    x64.mov rbx, [r9+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp rbx, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_34cd2ee1458d065c]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
}
