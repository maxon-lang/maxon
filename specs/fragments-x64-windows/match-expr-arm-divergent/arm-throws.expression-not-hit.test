  eval_0.merge:
    x64.xor edx, edx
    x64.ret
  eval_0.case0:
    x64.mov edx, 1
    x64.xor r8d, r8d
    x64.ret
  eval_0.next0:
    x64.cmp rcx, 2
    x64.jne eval_0.next1
  eval_0.case1:
    x64.mov r8d, 20
    x64.jmp eval_0.merge
  eval_0.next1:
    x64.cmp rcx, 3
    x64.jne eval_0.case3
  eval_0.case2:
    x64.mov r8d, 30
    x64.jmp eval_0.merge
  eval_0.case3:
    x64.xor r8d, r8d
    x64.jmp eval_0.merge
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 2
    x64.call pick
    x64.test rdx, rdx
    x64.je try_0.merge
  try_0.otherwise:
    x64.mov r8d, 99
  try_0.merge:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_63355f7d8f1f07d0]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
