// Test: explicit-string-backed-rawvalue
enum Planet
	earth = "Earth"
	mars = "Mars"
end 'Planet'

function main() returns ExitCode
	let p = Planet.mars
	// Binding `.rawValue` and using it as data (printing) is fine; comparing
	// that value with `==` is E3097.
	let name = p.rawValue
	print("{name}\n")
	return 0
end 'main'
