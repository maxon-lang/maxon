// Test: builtins-type.bits-to-float
function main() returns ExitCode
	let value = __Builtins.bitsToFloat(4607182418800017408)
	// IEEE 754: 0x3FF0000000000000 = 4607182418800017408 is exactly 1.0.
	// A numeric conversion would instead yield ~4.6e18, so this distinguishes
	// a bitcast from a widening int-to-float conversion.
	if value == 1.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov rax, 4607182418800017408
    x64.movq xmm0, rax
    x64.movsd xmm1, [rip+__float_1]
    x64.ucomisd xmm0, xmm1
    x64.jne main.check_0.after
    x64.jp main.check_0.after
  check_0:
    x64.xor eax, eax
    x64.ret
  check_0.after:
    x64.mov rax, 1
    x64.ret
  }
}
---
