// Test: a-negative-sentinel-in-a-non-negative-type-still-decodes
typealias Slot = int(0 to u64.max)

function findSlot(key Slot) returns Slot
	if key == 7 'found'
		return 3 as Slot
	end 'found'
	return 0 - 1
end 'findSlot'

function main() returns ExitCode
	let slot = findSlot(9 as Slot)

	if slot >= 0 'wronglyFound'
		return 1
	end 'wronglyFound'
	return 42
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @findSlot(key: i64) -> u64 {
  entry:
    x64.mov rax, 7
    x64.cmp rcx, rax
    x64.jne findSlot.found_0.after
  found_0:
    x64.mov rax, 3
    x64.ret
  found_0.after:
    x64.xor eax, eax
    x64.mov rcx, 1
    x64.sub rax, rcx
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, 9
    x64.call findSlot
    x64.xor ecx, ecx
    x64.cmp rax, rcx
    x64.jl main.wronglyFound_0.after
  wronglyFound_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  wronglyFound_0.after:
    x64.mov rax, 42
    x64.epilogue
    x64.ret
  }
}
---
