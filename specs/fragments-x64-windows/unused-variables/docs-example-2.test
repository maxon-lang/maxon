// Test: docs-example-2
typealias Integer = int(i64.min to i64.max)

function sideEffect() returns Integer
	print("hello\n")
	return 42
end 'sideEffect'

function main() returns ExitCode
	_ = sideEffect()  // OK: underscore discards return value
	return 0
end 'main'

---
ExitCode: 0
---
// CompiledIR
module {
  func @sideEffect() -> i64 {
  entry:
    x64.prologue stack_size=16
    x64.lea rax, [rip+__static_lit_0]
    x64.mov rcx, rax
    x64.mov rdx, 32
    x64.add rcx, rdx
    x64.mov [rbp-8], rcx
    x64.mov rbx, [rbp-8]
    x64.mov rcx, [rbp-8]
    x64.call mm_incref
    x64.mov rsi, [rbp-8]
    x64.mov rcx, [rbp-8]
    x64.call stdlib.print
    x64.mov rdi, [rbp-8]
    x64.test rdi, rdi
    x64.jz __nonnull_skip_0
    x64.mov rcx, [rbp-8]
    x64.call mm_decref
    x64.label __nonnull_skip_0
    x64.mov rax, 42
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.call sideEffect
    x64.xor ecx, ecx
    x64.mov rax, rcx
    x64.epilogue
    x64.ret
  }
}
---
