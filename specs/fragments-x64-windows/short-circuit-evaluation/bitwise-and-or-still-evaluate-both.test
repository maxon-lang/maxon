module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov r8d, 22
  __cast_check_lo_0:
    x64.test r8, r8
    x64.jge __cast_ok_0
  __cast_panic_0:
    x64.lea r12, [rip+__panic_msg_850cedb306b0b477]
    x64.mov rcx, r12
    x64.call mrt_panic
  __cast_ok_0:
    x64.epilogue
    x64.ret
  }
}
