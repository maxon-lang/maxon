// Test: short-circuit-in-if-condition
typealias Integer = int(0 to u64.max)

var trace = 0 as Integer

function setFlag(bit Integer) returns bool
	trace = trace or bit
	return false
end 'setFlag'

function main() returns ExitCode
	if setFlag(1) and setFlag(2) 'never'
		return 99
	end 'never'
	return trace as ExitCode
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea r8, [rip+__data_trace]
    x64.mov r9, [r8+0] (8b)
    x64.mov r8d, 1
    x64.lea rsi, [rip+__data_trace]
    x64.or r9, r8
    x64.mov [rsi+0], r9 (8b)
    x64.xor r8d, r8d
  shortAnd.merge:
    x64.test r8, r8
    x64.je never_0.after
  never_0:
    x64.mov r8d, 99
    x64.epilogue
    x64.ret
  never_0.after:
    x64.lea r9, [rip+__data_trace]
    x64.mov r8, [r9+0] (8b)
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jle __cast_check_lo_0
    x64.jmp __cast_panic_0
  __cast_check_lo_0:
    x64.test r8, r8
    x64.jge __cast_ok_0
  __cast_panic_0:
    x64.lea r12, [rip+__panic_msg_aa639d198ea517a8]
    x64.mov rcx, r12
    x64.call mrt_panic
  __cast_ok_0:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_692456e1c504ac6e]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
---
