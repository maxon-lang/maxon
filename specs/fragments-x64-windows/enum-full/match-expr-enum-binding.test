// Test: match-expr-enum-binding

typealias Integer = int(i64.min to i64.max)

union Container
	empty
	value(n Integer)
end 'Container'

function main() returns ExitCode
	let c = Container.value(10)
	let result = match c 'get'
		empty gives 0
		value(n) gives n * 2
	end 'get'
	return result
end 'main'
