// Test: enum-member-constant
enum Color
	Red
	Green
	Blue
end 'Color'

let DEFAULT_COLOR = Color.Green

function main() returns ExitCode
	match DEFAULT_COLOR 'check'
		Red then return 1
		Green then return 2
		Blue then return 3
	end 'check'
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 1
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.xor edx, edx
    x64.cmp rcx, rdx
    x64.je main.check_0.case0
  check_0.dispatch0:
    x64.mov rax, 1
    x64.mov rcx, [rbp-8]
    x64.cmp rcx, rax
    x64.je main.check_0.case1
  check_0.dispatch1:
    x64.mov rax, 2
    x64.mov rcx, [rbp-8]
    x64.cmp rcx, rax
    x64.je main.check_0.case2
  check_0.dispatch2:
    x64.jmp main.check_0.merge
  check_0.case0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  check_0.case1:
    x64.mov rax, 2
    x64.epilogue
    x64.ret
  check_0.case2:
    x64.mov rax, 3
    x64.epilogue
    x64.ret
  check_0.merge:
  }
}
---
