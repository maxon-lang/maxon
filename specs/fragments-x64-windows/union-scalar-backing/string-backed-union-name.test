// Test: string-backed-union-name
union Mnemonic
	add = "mir.add.i64"
	sub = "mir.sub.i64"
end 'Mnemonic'

function main() returns ExitCode
	let m = Mnemonic.sub
	if m.rawValue == "mir.sub.i64" and m.name == "sub" 'ok'
		return 3
	end 'ok'
	return 1
end 'main'
