// Test: url.parse-scheme-lowercase
function main() returns ExitCode
	let url = try URL.parse("HTTP://Example.COM/Path") otherwise 'err'
		return 1
	end 'err'
	print("{url.scheme()}\n")
	let host = try url.host() otherwise 'nh'
		return 2
	end 'nh'
	print("{host}\n")
	print("{url.path()}\n")
	return 0
end 'main'
