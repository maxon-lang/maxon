// Test: throw-matching-the-declared-clause-is-untouched
typealias Code = int(0 to u32.max)

enum ErrA implements Error
	aZero
	aOne
end 'ErrA'

enum ErrB implements Error
	bZero
	bOne
end 'ErrB'

function f(x Code) returns Code throws ErrB
	if x < 10 'small'
		throw ErrB.bOne
	end 'small'
	return x
end 'f'

function main() returns ExitCode
	return try f(3) otherwise (e) 'caught'
		match e 'which'
			bZero then return 1
			bOne then return 2
		end 'which'
	end 'caught'
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @f(x: i64) -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov [rbp-8], rcx
    x64.mov rax, 10
    x64.cmp rcx, rax
    x64.jge f.small_0.after
  small_0:
    x64.mov rax, 1
    x64.mov rcx, 1
    x64.add rax, rcx
    x64.mov rdx, rax
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  small_0.after:
    x64.mov rax, [rbp-8]
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg f.__range_panic_0
    x64.cmp rax, rcx
    x64.jl f.__range_panic_0
    x64.jmp f.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.xor edx, edx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.mov rcx, 3
    x64.call f
    x64.mov ecx, rax
    x64.mov [rbp-8], rdx
    x64.mov [rbp-16], rcx
    x64.xor eax, eax
    x64.cmp rdx, rax
    x64.je main.otherwise_continue_0
  otherwise_error_0:
    x64.mov rax, [rbp-8]
    x64.mov rcx, 1
    x64.sub rax, rcx
    x64.mov [rbp-24], rax
    x64.mov rdx, [rbp-24]
    x64.xor ebx, ebx
    x64.cmp rdx, rbx
    x64.je main.which_0.case0
  which_0.dispatch0:
    x64.mov rax, 1
    x64.mov rcx, [rbp-24]
    x64.cmp rcx, rax
    x64.je main.which_0.case1
  which_0.dispatch1:
    x64.jmp main.which_0.merge
  which_0.case0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  which_0.case1:
    x64.mov rax, 2
    x64.epilogue
    x64.ret
  which_0.merge:
  otherwise_continue_0:
    x64.mov rax, [rbp-16]
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg main.__range_panic_0
    x64.cmp rax, rcx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_1]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
