// Test: error.rethrow-caught-binding

typealias Integer = int(i64.min to i64.max)

// Re-throw a caught `(e)` binding from an expression-form `try ... otherwise (e)`
// handler. `outer` catches `inner`'s error into `e`, then `throw e` re-publishes
// the SAME error to `outer`'s caller. The propagated variant must survive the
// hop: `main` distinguishes `low` (1) from `high` (7) by re-throwing it again
// and matching at the top, proving the ordinal carries through every re-throw.
enum Fault implements Error
	low
	high
end 'Fault'

function inner() returns Integer throws Fault
	throw Fault.high
end 'inner'

function outer() returns Integer throws Fault
	return try inner() otherwise (e) 'h'
		throw e
	end 'h'
end 'outer'

function main() returns ExitCode
	var code = 0 as ExitCode
	try outer() otherwise (e) 'top'
		match e 'm'
			low then code = 1
			high then code = 7
		end 'm'
	end 'top'
	return code
end 'main'
---
ExitCode: 7
---
// CompiledIR
module {
  func @inner() -> i64 {
  entry:
    x64.mov rax, 1
    x64.mov rcx, 1
    x64.add rax, rcx
    x64.mov rdx, rax
    x64.xor eax, eax
    x64.ret
  }
  func @outer() -> i64 {
  entry:
    x64.prologue stack_size=32
    x64.call inner
    x64.mov [rbp-8], rdx
    x64.mov [rbp-16], rax
    x64.xor eax, eax
    x64.cmp rdx, rax
    x64.je outer.otherwise_continue_0
  otherwise_error_0:
    x64.mov rax, [rbp-8]
    x64.mov rcx, 1
    x64.sub rax, rcx
    x64.mov [rbp-24], rax
    x64.mov rdx, [rbp-24]
    x64.mov rbx, 1
    x64.add rdx, rbx
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  otherwise_continue_0:
    x64.mov rax, [rbp-16]
    x64.xor edx, edx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.xor eax, eax
    x64.mov [rbp-8], rax
    x64.call outer
    x64.mov [rbp-16], rdx
    x64.xor ecx, ecx
    x64.cmp rdx, rcx
    x64.je main.otherwise_continue_0
  otherwise_error_0:
    x64.mov rax, [rbp-16]
    x64.mov rcx, 1
    x64.sub rax, rcx
    x64.mov [rbp-24], rax
    x64.jmp main.m_0.cmp0
  m_0.cmp0:
    x64.mov rax, [rbp-24]
    x64.xor ecx, ecx
    x64.cmp rax, rcx
    x64.jne main.m_0.cmp1
  m_0.case0:
    x64.mov rax, 1
    x64.mov [rbp-8], rax
    x64.jmp main.m_0.merge
  m_0.cmp1:
    x64.mov rax, [rbp-24]
    x64.mov rcx, 1
    x64.cmp rax, rcx
    x64.jne main.m_0.merge
  m_0.case1:
    x64.mov rax, 7
    x64.mov [rbp-8], rax
    x64.jmp main.m_0.merge
  m_0.merge:
    x64.jmp main.otherwise_continue_0
  otherwise_continue_0:
    x64.mov rax, [rbp-8]
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg main.__range_panic_0
    x64.cmp rax, rcx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
---
