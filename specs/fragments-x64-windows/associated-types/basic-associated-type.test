    x64.mov r9d, 42
    x64.mov [r8+0], r9 (8b)
    x64.mov rbx, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp rbx, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_178ce3e012ac9575]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
}
