type Holder
	export var name as String

	static var greeting = Holder{name: "hi"}

	export static function get() returns Holder
		return Holder.greeting
	end 'get'
end 'Holder'

function main() returns ExitCode
	let h = Holder.get()
	print("{h.name}")
	return 0
end 'main'
