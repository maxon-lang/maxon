// Test: lazy-static.assigned-inside-the-initializers-own-call
typealias Tally = int(0 to 100)

type Box
	static var t = compute()
end 'Box'

function compute() returns Tally
	print("I")
	Box.t = 5
	return 7
end 'compute'

function main() returns ExitCode
	print("{Box.t}|{Box.t}")
	return 0
end 'main'
