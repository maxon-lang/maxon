// Test: lazy-static.assignment-reading-its-own-field
typealias Tally = int(0 to 100)

function compute() returns Tally
	print("I")
	return 7
end 'compute'

type Box
	static var t = compute()
end 'Box'

function main() returns ExitCode
	Box.t = Box.t + 1
	Box.t = Box.t + 1
	print("{Box.t}")
	return 0
end 'main'
