    x64.xor r8d, r8d
  try_0.merge:
    x64.cmp r8, 100
    x64.jle big_0.after
  big_0:
    x64.mov r8d, 1
    x64.epilogue
    x64.ret
  big_0.after:
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea rcx, [rip+__layout_Array_Octet]
    x64.call Array.create
    x64.mov r12, r8
    x64.lea rax, [rip+__layout_Array_Octet]
    x64.mov edx, 200
    x64.mov rcx, r12
    x64.call Array.push
    x64.xor edx, edx
    x64.mov rcx, r12
    x64.call check
    x64.mov r13, r8
    x64.mov rcx, r12
    x64.call __mm_decref_maybenull_helper
    x64.mov r8d, 4294967295
    x64.cmp r13, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_d7bd7685b91967e4]
