    x64.je inlined_Array.get_3_0
  inlined_Array.get_1_0:
    x64.mov edx, 1
    x64.xor r8d, r8d
    x64.jmp inline_cont_check_0
  inlined_Array.get_3_0:
    x64.xor edx, edx
  inline_cont_check_0:
    x64.test rdx, rdx
    x64.je try_0.merge
