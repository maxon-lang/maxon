// Test: non-exported-enum-values-compare-across-a-file-boundary
// --- file: shade.maxon
typealias Integer = int(i64.min to i64.max)

enum Shade
	dim
	bright
end 'Shade'

export function pick(n Integer) returns Shade
	if n > 5 'b'
		return Shade.bright
	end 'b'
	return Shade.dim
end 'pick'

// --- file: main.maxon
function main() returns ExitCode
	let s = pick(7)
	let t = pick(1)
	if s == t 'same'
		return 1
	end 'same'
	return 9
end 'main'
---
ExitCode: 9
---
// CompiledIR
module {
  func @pick(n: i64) -> i64 {
  entry:
    x64.mov rax, 5
    x64.cmp rcx, rax
    x64.jle pick.b_0.after
  b_0:
    x64.mov rax, 1
    x64.ret
  b_0.after:
    x64.xor eax, eax
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, 7
    x64.call pick
    x64.mov [rbp-8], rax
    x64.mov rcx, 1
    x64.call pick
    x64.mov [rbp-16], rax
    x64.mov rax, [rbp-8]
    x64.mov rcx, [rbp-16]
    x64.cmp rax, rcx
    x64.jne main.same_0.after
  same_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  same_0.after:
    x64.mov rax, 9
    x64.epilogue
    x64.ret
  }
}
---
