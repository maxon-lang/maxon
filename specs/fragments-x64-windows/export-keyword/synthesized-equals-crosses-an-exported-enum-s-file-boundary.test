// Test: synthesized-equals-crosses-an-exported-enum-s-file-boundary
// --- file: shade.maxon
typealias Integer = int(i64.min to i64.max)

export enum Shade
	dim
	bright
end 'Shade'

export function pick(n Integer) returns Shade
	if n > 1 'b'
		return Shade.bright
	end 'b'
	return Shade.dim
end 'pick'

// --- file: main.maxon
function main() returns ExitCode
	let a = pick(0)
	let b = pick(5)
	if a.equals(b) 'same'
		return 1
	end 'same'
	return 7
end 'main'
---
ExitCode: 7
---
// CompiledIR
module {
  func @Shade.equals(self: i64, other: i64) -> i1 {
  entry:
    x64.jmp stdlib.int.equals
  }
  func @pick(n: i64) -> i64 {
  entry:
    x64.mov rax, 1
    x64.cmp rcx, rax
    x64.jle pick.b_0.after
  b_0:
    x64.mov rax, 1
    x64.ret
  b_0.after:
    x64.xor eax, eax
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor ecx, ecx
    x64.call pick
    x64.mov [rbp-8], rax
    x64.mov rcx, 5
    x64.call pick
    x64.mov [rbp-16], rax
    x64.mov rax, [rbp-8]
    x64.mov rcx, [rbp-16]
    x64.mov rcx, [rbp-8]
    x64.mov rdx, [rbp-16]
    x64.call Shade.equals
    x64.test rax, rax
    x64.je main.same_0.after
  same_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  same_0.after:
    x64.mov rax, 7
    x64.epilogue
    x64.ret
  }
}
---
