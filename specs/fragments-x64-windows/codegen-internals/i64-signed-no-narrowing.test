// Test: i64-signed-no-narrowing
typealias BigInt = int(-1000000000000 to 1000000000000)

function main() returns ExitCode
	let a = 20 as BigInt
	let b = 3 as BigInt
	return a / b
end 'main'
---
ExitCode: 6
RequiredIRSelfhosted: ```
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov r8d, 3
    x64.mov eax, 20
    x64.xor edx, edx
    x64.idiv r8
    x64.mov r8, rax
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_e3b71750342575b4]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}

