// Test: managed-memory-loop-growth-generates-realloc
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	var arr = IntArray.create()
	var i = 0
	while i < 10 'loop'
		arr.push(i)
		i = i + 1
	end 'loop'
	return arr.count()
end 'main'
---
ExitCode: 10
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea rcx, [rip+__layout_Array_Integer]
    x64.call Array.create
    x64.mov rbx, r8
    x64.xor edx, edx
    x64.mov r12, rdx
  loop_0.header:
    x64.cmp r12, 10
    x64.jge loop_0.exit
  loop_0:
    x64.lea rax, [rip+__layout_Array_Integer]
    x64.mov rcx, rbx
    x64.mov rdx, r12
    x64.call Array.push
    x64.mov rdx, r12
    x64.add rdx, 1
    x64.mov r12, rdx
    x64.jmp loop_0.header
  loop_0.exit:
    x64.lea rdx, [rip+__layout_Array_Integer]
    x64.mov rcx, rbx
    x64.call Array.count
    x64.mov r12, r8
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_9acdad994761428e]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, r12
    x64.epilogue
    x64.ret
  }
}
---
