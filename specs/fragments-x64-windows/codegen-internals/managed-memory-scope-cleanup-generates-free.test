// Test: managed-memory-scope-cleanup-generates-free
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	if true 'outer'
		var outer_arr = IntArray.create()
		outer_arr.push(100)
		if true 'inner'
			var inner_arr = IntArray.create()
			inner_arr.push(200)
		end 'inner'
	end 'outer'
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea rcx, [rip+__layout_Array_Integer]
    x64.call Array.create
    x64.mov rbx, r8
    x64.lea rax, [rip+__layout_Array_Integer]
    x64.mov edx, 100
    x64.mov rcx, rbx
    x64.call Array.push
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
  inner_0:
    x64.lea rcx, [rip+__layout_Array_Integer]
    x64.call Array.create
    x64.mov rbx, r8
    x64.lea rax, [rip+__layout_Array_Integer]
    x64.mov edx, 200
    x64.mov rcx, rbx
    x64.call Array.push
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
  outer_0.after:
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  }
}
---
