// Test: match-statements.try-propagate
typealias Tally = int(0 to 100)

enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) throws Err
	match kind 'k'
		1 then try leaf()
		default throws Err.bad
	end 'k'
end 'dispatch'

function main() returns ExitCode
	try dispatch(1) otherwise ignore
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov r9d, 1
  inlined_dispatch_0_0:
    x64.cmp r9, 1
    x64.jne inlined_dispatch_6_0
  inlined_dispatch_2_0:
    x64.mov edx, 1
  inlined_dispatch_4_0:
    x64.xor r8d, r8d
    x64.jmp inline_cont_main_0
  inlined_dispatch_6_0:
    x64.mov edx, 1
    x64.xor r8d, r8d
  inline_cont_main_0:
    x64.test rdx, rdx
    x64.je try_0.merge
  try_0.otherwise:
    x64.xor r8d, r8d
    x64.mov r9, r8
  try_0.merge:
    x64.xor r8d, r8d
    x64.ret
  }
}
