// Test: match-range.with-or
function main() returns ExitCode
	let x = 95
	match x 'check'
		1 to 10 or 90 to 100 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 95
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.mov rdx, 1
    x64.mov rbx, rcx
    x64.sub rbx, rdx
    x64.mov rsi, 9
    x64.cmp rbx, rsi
    x64.jbe main.check_0.case0
  check_0.dispatch0:
    x64.mov rax, 90
    x64.mov rcx, [rbp-8]
    x64.sub rcx, rax
    x64.mov rdx, 10
    x64.cmp rcx, rdx
    x64.jbe main.check_0.case0
  check_0.dispatch1:
    x64.jmp main.check_0.case1
  check_0.case0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  check_0.case1:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  check_0.merge:
  }
}
---
