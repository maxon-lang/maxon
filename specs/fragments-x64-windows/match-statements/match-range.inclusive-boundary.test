// Test: match-range.inclusive-boundary
function main() returns ExitCode
	let x = 1
	match x 'check'
		1 to 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov r8d, 1
  check_0.case0:
    x64.ret
  }
}
