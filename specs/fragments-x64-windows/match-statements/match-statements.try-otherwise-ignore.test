// Test: match-statements.try-otherwise-ignore
enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally)
	match kind 'k'
		1 then try leaf() otherwise ignore
		default panic("unreachable")
	end 'k'
end 'dispatch'

typealias Tally = int(0 to 100)

function main() returns ExitCode
	dispatch(1)
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @dispatch(rcx: u8) {
  entry:
    x64.prologue stack_size=16
    x64.cmp rcx, 1
    x64.jne k_0.case1
    x64.jmp try_0.otherwise
  k_0.merge:
    x64.epilogue
    x64.ret
  try_0.otherwise:
    x64.xor r8d, r8d
  try_0.merge:
    x64.jmp k_0.merge
  k_0.case1:
    x64.lea r12, [rip+__panic_msg_e19d0f099385d973]
    x64.mov rcx, r12
    x64.call mrt_panic
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov r12d, 1
    x64.mov rcx, r12
    x64.call dispatch
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  }
}
