// Test: docs-example-11
function main() returns ExitCode
	let x = 50
	match x 'check'
		1 to 10 or 90 to 100 then return 1   // extreme values
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov r9d, 50
    x64.jmp check_0.cmp1
  check_0.case0:
    x64.mov r8d, 1
    x64.ret
  check_0.cmp1:
    x64.cmp r9, 100
    x64.setle r8
    x64.cmp r9, 90
    x64.setge rsi
    x64.and rsi, r8
    x64.je check_0.case1
    x64.jmp check_0.case0
  check_0.case1:
    x64.xor r8d, r8d
    x64.ret
  }
}
---
