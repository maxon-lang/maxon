// Test: match-range.multiple-ranges
function main() returns ExitCode
	let score = 85
	match score 'grade'
		90 to 100 then return 65
		80 upto 90 then return 66
		70 upto 80 then return 67
		default then return 70
	end 'grade'
end 'main'
---
ExitCode: 66
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov r9d, 85
  grade_0.next0:
    x64.cmp r9, 90
    x64.setl r8
    x64.cmp r9, 80
    x64.setge rsi
    x64.and rsi, r8
    x64.je grade_0.next1
  grade_0.case1:
    x64.mov r8d, 66
    x64.ret
  grade_0.next1:
    x64.cmp r9, 80
    x64.setl r8
    x64.cmp r9, 70
    x64.setge r9
    x64.and r9, r8
    x64.je grade_0.case3
  grade_0.case2:
    x64.mov r8d, 67
    x64.ret
  grade_0.case3:
    x64.mov r8d, 70
    x64.ret
  }
}
---
