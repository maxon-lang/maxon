// Test: match-range.multiple-ranges
function main() returns ExitCode
	let score = 85
	match score 'grade'
		90 to 100 then return 65
		80 upto 90 then return 66
		70 upto 80 then return 67
		default then return 70
	end 'grade'
end 'main'
---
ExitCode: 66
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 85
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.mov rdx, 70
    x64.mov rbx, rcx
    x64.sub rbx, rdx
    x64.mov rsi, 9
    x64.cmp rbx, rsi
    x64.jbe main.grade_0.case2
  grade_0.dispatch0:
    x64.mov rax, 80
    x64.mov rdx, [rbp-8]
    x64.sub rdx, rax
    x64.mov rbx, 9
    x64.cmp rdx, rbx
    x64.jbe main.grade_0.case1
  grade_0.dispatch1:
    x64.mov rax, 90
    x64.mov rcx, [rbp-8]
    x64.sub rcx, rax
    x64.mov rdx, 10
    x64.cmp rcx, rdx
    x64.jbe main.grade_0.case0
  grade_0.dispatch2:
    x64.jmp main.grade_0.case3
  grade_0.case0:
    x64.mov rax, 65
    x64.epilogue
    x64.ret
  grade_0.case1:
    x64.mov rax, 66
    x64.epilogue
    x64.ret
  grade_0.case2:
    x64.mov rax, 67
    x64.epilogue
    x64.ret
  grade_0.case3:
    x64.mov rax, 70
    x64.epilogue
    x64.ret
  grade_0.merge:
  }
}
---
