// Test: match-break.inside-loop
function main() returns ExitCode
	var result = 0
	var i = 0
	while i < 5 'loop'
		match i 'check'
			3 then break 'loop'
			default then result = result + 1
		end 'check'
		i = i + 1
	end 'loop'
	return result
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor r8d, r8d
    x64.xor r9d, r9d
    x64.xchg r8, r9
  loop_0.header:
    x64.cmp r9, 5
    x64.jge loop_0.exit
  loop_0:
    x64.cmp r9, 3
    x64.jne check_0.case1
  loop_0.exit:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  check_0.merge:
    x64.add r9, 1
    x64.jmp loop_0.header
  check_0.case1:
    x64.add r8, 1
    x64.jmp check_0.merge
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_82431bc9b59d4e65]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
