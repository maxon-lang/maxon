// Test: match-range.character-lowercase
function main() returns ExitCode
	let c = 'm'
	match c 'classify'
		'a' to 'z' then return 1
		'A' to 'Z' then return 2
		default then return 0
	end 'classify'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov r8d, 1
    x64.ret
  }
}
---
