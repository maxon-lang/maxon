module {
  func @classify(rcx: u8) -> u8 {
  entry:
    x64.prologue stack_size=16
    x64.cmp rcx, 1
    x64.jne check_0.next0
    x64.jmp check_0.case0
  check_0.merge:
    x64.cmp r8, 100
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  check_0.case0:
    x64.mov r8d, 10
    x64.jmp check_0.merge
  check_0.next0:
    x64.cmp rcx, 2
    x64.jne check_0.case2
  check_0.case1:
    x64.mov r8d, 20
    x64.jmp check_0.merge
  check_0.case2:
    x64.lea rbx, [rip+__panic_msg_4b2c02120e9e9903]
    x64.mov rcx, rbx
    x64.call mrt_panic
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_072e867f54b5f523]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 2
    x64.call classify
    x64.cmp r8, 20
    x64.jne check_0.after
  check_0:
    x64.mov r8d, 1
    x64.epilogue
    x64.ret
  check_0.after:
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  }
}
