// Test: match-range.negative
function main() returns ExitCode
	let x = -5
	match x 'check'
		-10 to -1 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, -5
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.mov rdx, -10
    x64.sub rcx, rdx
    x64.mov rbx, 9
    x64.cmp rcx, rbx
    x64.jbe main.check_0.case0
  check_0.dispatch0:
    x64.jmp main.check_0.case1
  check_0.case0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  check_0.case1:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  check_0.merge:
  }
}
---
