// Test: propagate-throw-otherwise-no-binding-decrefs
typealias N = int(0 to i64.max)

union LexErr implements Error
	unterminatedString(line N, column N)
end 'LexErr'

function tokenize() returns N throws LexErr
	throw LexErr.unterminatedString(7, column: 13)
end 'tokenize'

function main() returns ExitCode
	var ran = false
	let v = try tokenize() otherwise 'noBinding'
		ran = true
		return 0
	end 'noBinding'
	if ran 'ranOk'
		return (v + 5)
	end 'ranOk'
	return 99
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @tokenize() -> u64 {
  entry:
    x64.prologue stack_size=16
    x64.xor edx, edx
    x64.mov ecx, 24
    x64.call stdlib.__mm_alloc
    x64.mov rbx, r8
    x64.mov rcx, rbx
    x64.call stdlib.__mm_incref
    x64.xor r8d, r8d
    x64.mov [rbx+0], r8 (8b)
    x64.mov r8d, 7
    x64.mov [rbx+8], r8 (8b)
    x64.mov r8d, 13
    x64.mov [rbx+16], r8 (8b)
    x64.xor r8d, r8d
    x64.mov rdx, rbx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.call tokenize
    x64.mov rbx, r8
    x64.mov r12, rdx
    x64.mov rcx, r12
    x64.call __mm_decref_maybenull_helper
    x64.xor r9d, r9d
    x64.test r12, r12
    x64.je try_0.merge
  try_0.otherwise:
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  try_0.merge:
    x64.test r9, r9
    x64.je ranOk_0.after
  ranOk_0:
    x64.mov r9d, 4294967295
    x64.mov r8, rbx
    x64.add r8, 5
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  ranOk_0.after:
    x64.mov r8d, 99
    x64.epilogue
    x64.ret
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_336cea91c4813784]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
