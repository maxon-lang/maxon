// Test: multi-exit-match-arm-brackets
typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Box'

union Tag
	first
	second
end 'Tag'

function main() returns ExitCode
	@heap let a = Box.create(42)
	let tag = Tag.first
	var total = 0
	if true 'inner'
		let b = a
		match tag 'branch'
			first then total = b.value
			second then total = b.value + 1
		end 'branch'
	end 'inner'
	return total
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.mov r9d, 42
    x64.mov [r8+0], r9 (8b)
    x64.xor ebx, ebx
    x64.xor r9d, r9d
  inner_0:
    x64.test r9, r9
    x64.jne branch_0.next0
    x64.jmp branch_0.case0
  branch_0.merge:
    x64.jmp inner_0.after
  branch_0.case0:
    x64.mov rbx, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.mov r8, rbx
    x64.jmp branch_0.merge
  branch_0.next0:
    x64.cmp r9, 1
    x64.jne __rc_edge_4_0
  branch_0.case1:
    x64.mov rbx, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.add rbx, 1
    x64.mov r8, rbx
    x64.jmp branch_0.merge
  inner_0.after:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  __rc_edge_4_0:
    x64.mov rcx, r8
    x64.call mm_drop
    x64.mov r8, rbx
    x64.jmp branch_0.merge
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_45e3f24af717f791]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
---
