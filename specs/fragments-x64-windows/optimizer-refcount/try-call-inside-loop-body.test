    x64.mov rbx, r8
    x64.mov r8d, 7
    x64.mov [rbx+0], r8 (8b)
    x64.xor r8d, r8d
    x64.mov r12, r8
    x64.mov r9, r8
  loop_0.header:
    x64.cmp r9, 3
    x64.jge loop_0.exit
  inlined_peek_0_0:
    x64.mov rsi, [rbx+0] (8b)
    x64.test rsi, rsi
    x64.jge inlined_peek_2_0
  inlined_peek_1_0:
    x64.mov edx, 1
    x64.xor esi, esi
    x64.jmp inline_cont_main_0
  inlined_peek_2_0:
    x64.mov rsi, [rbx+0] (8b)
    x64.xor edx, edx
  inline_cont_main_0:
    x64.test rdx, rdx
    x64.je try_0.ok
    x64.mov rsi, r8
    x64.jmp try_0.merge
  loop_0.step:
    x64.add r9, 1
    x64.jmp loop_0.header
  loop_0.exit:
    x64.mov rcx, rbx
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  try_0.ok:
  try_0.merge:
    x64.add r12, rsi
    x64.jmp loop_0.step
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_2309f3aa1be95597]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, r12
    x64.epilogue
    x64.ret
  }
