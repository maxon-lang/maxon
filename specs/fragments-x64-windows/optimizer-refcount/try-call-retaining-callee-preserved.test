  entry:
    x64.prologue stack_size=16
    x64.mov rbx, rcx
    x64.mov r12, rdx
    x64.mov r8, [r12+0] (8b)
    x64.test r8, r8
    x64.jge neg_0.after
  neg_0:
    x64.mov rcx, r12
    x64.call __mm_decref_maybenull_helper
    x64.mov edx, 1
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  neg_0.after:
    x64.mov rcx, r12
    x64.call stdlib.__mm_incref
    x64.lea rax, [rip+__layout_Array_Box]
    x64.mov rcx, rbx
    x64.mov rdx, r12
    x64.call Array.push
    x64.mov rbx, [r12+0] (8b)
    x64.mov rcx, r12
    x64.call __mm_decref_maybenull_helper
    x64.xor edx, edx
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.lea rcx, [rip+__layout_Array_Box]
    x64.call Array.create
    x64.mov rbx, r8
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.mov r12, r8
    x64.mov rcx, r12
    x64.call stdlib.__mm_incref
    x64.mov r8d, 42
    x64.mov [r12+0], r8 (8b)
    x64.mov rcx, rbx
    x64.mov rdx, r12
    x64.call stash
    x64.mov r12, r8
    x64.xor r13d, r13d
    x64.test rdx, rdx
    x64.je try_0.ok
    x64.jmp __rc_edge_0_0
  try_0.ok:
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
    x64.mov r8, r12
  try_0.merge:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  __rc_edge_0_0:
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
    x64.mov r8, r13
    x64.jmp try_0.merge
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_16ef55549fd7508a]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
