    x64.xor r12d, r12d
  inner_0:
    x64.mov rcx, rbx
    x64.call peek
    x64.mov r13, r8
    x64.test rdx, rdx
    x64.je try_0.ok
    x64.jmp __rc_edge_1_0
  try_0.ok:
    x64.mov rcx, rbx
    x64.call mm_drop
  try_0.merge:
    x64.mov r8, r13
  inner_0.after:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  __rc_edge_1_0:
    x64.mov rcx, rbx
    x64.call mm_drop
    x64.mov r13, r12
    x64.jmp try_0.merge
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_179938c0f6a9b2e8]
    x64.call mrt_panic
