// Test: shared-record-not-written-through-a-union-payload
union Tagged
	named(name String)
end 'Tagged'

function main() returns ExitCode
	var boxed = Tagged.named("tag")
	match boxed 'grow'
		named(n) then n.append("!")
	end 'grow'
	let untouched = "tag"
	print("untouched={untouched}")
	return 0
end 'main'
---
ExitCode: 0
Stdout: ```
untouched=tag
