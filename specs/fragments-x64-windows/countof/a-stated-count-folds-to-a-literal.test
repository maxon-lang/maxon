// Test: a-stated-count-folds-to-a-literal
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

function main() returns ExitCode
	return countof(Vec3)
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov rax, 3
    x64.ret
  }
}
---
