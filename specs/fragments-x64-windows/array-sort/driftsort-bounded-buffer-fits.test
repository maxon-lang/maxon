	a.push(12)
	a.push(16)
	a.push(31)
	a.push(27)
	a.push(23)
	a.push(33)
	a.push(25)
	a.push(22)
	a.push(37)
	a.push(21)
	a.push(39)
	a.push(28)
	a.push(24)
	a.push(35)
	a.push(26)
	a.push(40)
	a.push(30)
	a.push(34)
	a.push(29)
	a.push(38)
	a.push(32)
	a.push(36)
	Log.startCapture()
	a.sort(ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "buffer.alloc") 'ba'
		print("buffer.alloc ")
	end 'ba'
	if Log.fired(keys, key: "mergeBuffer.fits") 'mf'
		print("mergeBuffer.fits ")
	end 'mf'
	if not Log.fired(keys, key: "mergeBuffer.exhausted") 'no'
		print("no-rotation")
	end 'no'
	print("\n")
	return 0
end 'main'
