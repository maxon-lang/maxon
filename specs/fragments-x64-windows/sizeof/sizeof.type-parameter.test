    x64.lea r8, [rip+__layout_Sizer_Bool]
    x64.mov rdx, [r8+40] (8b)
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.mov rbx, r8
    x64.xor r8d, r8d
    x64.mov [rbx+0], r8 (8b)
    x64.mov rcx, rbx
    x64.call mm_drop
    x64.lea r9, [rip+__layout_Sizer_Bool]
    x64.mov r8, [r9+56] (8b)
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_5fc2eaa1829b94f4]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
