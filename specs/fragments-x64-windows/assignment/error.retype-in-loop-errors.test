// Test: error.retype-in-loop-errors

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var acc = 0 as Integer
	var i = 0 as Integer
	while i < 3 'loop'
		acc = "hello"
		i = i + 1
	end 'loop'
	return 0 as ExitCode
end 'main'
---
