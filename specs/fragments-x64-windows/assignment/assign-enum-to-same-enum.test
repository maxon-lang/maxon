// Test: assign-enum-to-same-enum

enum Color
	red
	green
end 'Color'

type Holder
	export var c as Color

	static function create() returns Self
		return Self{c: Color.red}
	end 'create'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	h.c = Color.green
	var c = Color.red
	c = Color.green
	return h.c.ordinal + c.ordinal
end 'main'
