// Test: union-payload-kinds
typealias Coord = int(i64.min to i64.max)

union Node
	leaf
	named(label String)
	pair(a Coord, b Coord)
end 'Node'

function main() returns ExitCode
	let a = Node.leaf
	let b = Node.named("hello")
	let c = Node.pair(1, b: 2)
	print("{a} {b} {c}\n")
	return 0
end 'main'
