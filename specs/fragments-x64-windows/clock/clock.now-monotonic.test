// Test: clock.now-monotonic
function main() returns ExitCode
		let a = Clock.nowMs()
		let b = Clock.nowMs()
		let c = Clock.nowMs()
		var score = 0
		if b >= a 'nondecreasing1'
				score = score + 1
		end 'nondecreasing1'
		if c >= b 'nondecreasing2'
				score = score + 1
		end 'nondecreasing2'
		print("score={score}\n")
		return 0
end 'main'
---
Stdout: ```
score=2
```
