// Test: clock.now-nanos-monotonic
function main() returns ExitCode
		let a = Clock.nowNanos()
		let b = Clock.nowNanos()
		let c = Clock.nowNanos()
		var score = 0
		if b >= a 'nondecreasing1'
				score = score + 1
		end 'nondecreasing1'
		if c >= b 'nondecreasing2'
				score = score + 1
		end 'nondecreasing2'
		print("score={score}\n")
		return 0
end 'main'
