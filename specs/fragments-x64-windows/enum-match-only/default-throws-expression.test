// Test: default-throws-expression
enum Color
	red
	green
	blue
end 'Color'

enum MatchError
	unmatched
end 'MatchError'

function colorValue(c Color) returns ExitCode throws MatchError
	let result = match c 'check'
		red gives 10
		green gives 20
		default throws MatchError.unmatched
	end 'check'
	return result
end 'colorValue'

function main() returns ExitCode
	let c = Color.green
	let result = try colorValue(c) otherwise 0
	return result
end 'main'
---
ExitCode: 20
---
// CompiledIR
module {
  func @colorValue(rcx: u8) -> u32 {
  entry:
    x64.test rcx, rcx
    x64.jne check_0.next0
    x64.jmp check_0.case0
  check_0.merge:
    x64.xor edx, edx
    x64.ret
  check_0.case0:
    x64.mov r8d, 10
    x64.jmp check_0.merge
  check_0.next0:
    x64.cmp rcx, 1
    x64.jne check_0.case2
  check_0.case1:
    x64.mov r8d, 20
    x64.jmp check_0.merge
  check_0.case2:
    x64.mov edx, 1
    x64.xor r8d, r8d
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 1
    x64.call colorValue
    x64.test rdx, rdx
    x64.je try_0.merge
  try_0.otherwise:
    x64.xor r8d, r8d
  try_0.merge:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_dba1d9c19f5b6d5a]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
---
