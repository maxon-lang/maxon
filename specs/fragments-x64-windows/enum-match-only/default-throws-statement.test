// Test: default-throws-statement
enum Color
	red
	green
	blue
end 'Color'

enum MatchError
	unmatched
end 'MatchError'

function checkColor(c Color) returns ExitCode throws MatchError
	match c 'check'
		green then return 1
		default throws MatchError.unmatched
	end 'check'
end 'checkColor'

function main() returns ExitCode
	let c = Color.green
	let result = try checkColor(c) otherwise 0
	return result
end 'main'
