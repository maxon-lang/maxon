// Test: try-impure-let-discard

typealias Integer = int(i64.min to i64.max)

var counter = 0 as Integer

enum ParseError implements Error
	invalidFormat
end 'ParseError'

function parseNum(s String) returns Integer throws ParseError
	counter = counter + s.byteLength()
	throw ParseError.invalidFormat
end 'parseNum'

function main() returns ExitCode
	_ = try parseNum("abc") otherwise 0
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @parseNum(s: i64) -> i64 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, qword [rip+counter]
    x64.mov [rbp-8], rcx
    x64.mov rcx, [rbp-8]
    x64.mov rdx, [rcx+8]
    x64.add rax, rdx
    x64.mov qword [rip+counter], rax
    x64.xor ebx, ebx
    x64.mov rsi, 1
    x64.lea rdx, [rbx + rsi]
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea rax, [rip+__static_lit_1]
    x64.mov rcx, rax
    x64.mov rdx, 32
    x64.add rcx, rdx
    x64.mov [rbp-8], rcx
    x64.mov rbx, [rbp-8]
    x64.mov rcx, [rbp-8]
    x64.call mm_incref
    x64.mov rsi, [rbp-8]
    x64.mov rcx, [rbp-8]
    x64.call parseNum
    x64.xor edi, edi
    x64.cmp rdx, rdi
    x64.je main.otherwise_default_success_0
  otherwise_default_error_0:
    x64.jmp main.otherwise_default_continue_0
  otherwise_default_success_0:
    x64.jmp main.otherwise_default_continue_0
  otherwise_default_continue_0:
    x64.mov rax, [rbp-8]
    x64.test rax, rax
    x64.jz __nonnull_skip_0
    x64.mov rcx, [rbp-8]
    x64.call mm_decref
    x64.label __nonnull_skip_0
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  }
}
---
