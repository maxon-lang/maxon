// Test: enum-exhaustive.mix-explicit-and-range
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.low
	match p 'check'
		low then return 1
		medium to critical then return 2
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor eax, eax
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.xor edx, edx
    x64.cmp rcx, rdx
    x64.je main.check_0.case0
  check_0.dispatch0:
    x64.mov rax, 1
    x64.mov rcx, [rbp-8]
    x64.sub rcx, rax
    x64.mov rdx, 2
    x64.cmp rcx, rdx
    x64.jbe main.check_0.case1
  check_0.dispatch1:
    x64.jmp main.check_0.merge
  check_0.case0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  check_0.case1:
    x64.mov rax, 2
    x64.epilogue
    x64.ret
  check_0.merge:
  }
}
---
