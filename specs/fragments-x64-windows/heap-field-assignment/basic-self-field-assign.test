    x64.mov r8d, 10
    x64.mov [rbx+0], r8 (8b)
    x64.lea rdx, [rip+__destruct_Container]
    x64.mov ecx, 16
    x64.call stdlib.__mm_alloc
    x64.mov r12, r8
    x64.xor r8d, r8d
    x64.mov [r12+8], r8 (8b)
    x64.mov r8d, 1
    x64.mov [r12+0], r8 (8b)
    x64.mov rcx, [r12+8] (8b)
    x64.mov [r12+8], rbx (8b)
    x64.call __mm_decref_maybenull_helper
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.mov rbx, r8
    x64.mov rcx, rbx
    x64.call stdlib.__mm_incref
    x64.mov r8d, 20
    x64.mov [rbx+0], r8 (8b)
    x64.mov rcx, [r12+8] (8b)
    x64.call __mm_decref_maybenull_helper
    x64.mov [r12+8], rbx (8b)
    x64.mov r8, [r12+8] (8b)
    x64.mov rbx, [r8+0] (8b)
    x64.mov rcx, r12
