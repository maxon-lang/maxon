// Test: unsigned-full-alias-admits-the-unsigned-extreme
typealias Slot = int(0 to u64.max)

let NO_SLOT = u64.max as Slot

function isSentinel(s Slot) returns bool
	return s == NO_SLOT
end 'isSentinel'

function main() returns ExitCode
	if isSentinel(NO_SLOT) 'yes'
		return 7
	end 'yes'
	return 0
end 'main'
---
ExitCode: 7
---
// CompiledIR
module {
  func @isSentinel(s: i64) -> i1 {
  entry:
    x64.mov rax, -1
    x64.cmp rcx, rax
    x64.sete rax
    x64.movzx rax, raxb
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, -1
    x64.call isSentinel
    x64.test rax, rax
    x64.je main.yes_0.after
  yes_0:
    x64.mov rax, 7
    x64.epilogue
    x64.ret
  yes_0.after:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  }
}
---
