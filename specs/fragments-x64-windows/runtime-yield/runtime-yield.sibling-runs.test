    x64.jmp spinner.spin_0.header
  spin_0.header:
    x64.mov rax, [rbp-16]
    x64.mov rcx, [rbp-8]
    x64.cmp rax, rcx
    x64.jge spinner.spin_0.exit
  spin_0:
    x64.call stdlib.Runtime.yield
    x64.jmp spinner.spin_0.incr
  spin_0.incr:
    x64.mov rax, 1
    x64.mov rcx, [rbp-16]
    x64.add rcx, rax
    x64.mov [rbp-16], rcx
    x64.jmp spinner.spin_0.header
  spin_0.exit:
    x64.mov rax, qword [rip+flag]
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, 16
    x64.call mm_raw_alloc
    x64.xor ecx, ecx
    x64.mov [rax+0], rcx
    x64.xor edx, edx
    x64.mov [rax+8], rdx
    x64.lea_func rdx, [setter]
    x64.mov r8, rax
    x64.xchg rdx, rcx
    x64.call __gt_spawn
    x64.mov [rbp-8], rax
    x64.mov rcx, 16
    x64.call mm_raw_alloc
    x64.xor ecx, ecx
    x64.mov [rax+0], rcx
    x64.xor edx, edx
    x64.mov [rax+8], rdx
    x64.lea_func rdx, [spinner]
    x64.mov r8, rax
    x64.xchg rdx, rcx
    x64.call __gt_spawn
    x64.mov rcx, rax
    x64.call __gt_await
    x64.mov [rbp-16], rax
    x64.mov rcx, [rbp-8]
    x64.call __gt_await
    x64.mov rcx, [rbp-16]
    x64.add rcx, rax
    x64.xor eax, eax
    x64.mov edx, 4294967295
    x64.cmp rcx, rdx
    x64.jg main.__range_panic_0
    x64.cmp rcx, rax
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
