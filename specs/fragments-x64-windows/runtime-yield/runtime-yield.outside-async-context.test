// Test: runtime-yield.outside-async-context
function main() returns ExitCode
	Runtime.yield()
	Runtime.yield()
	Runtime.yield()
	return 3
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.call stdlib.Runtime.yield
    x64.call stdlib.Runtime.yield
    x64.call stdlib.Runtime.yield
    x64.mov rax, 3
    x64.epilogue
    x64.ret
  }
}
---
