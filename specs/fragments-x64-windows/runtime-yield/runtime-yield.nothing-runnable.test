    x64.mov [rax+8], rdx
    x64.lea_func rdx, [lonely]
    x64.mov r8, rax
    x64.xchg rdx, rcx
    x64.call __gt_spawn
    x64.mov rcx, rax
    x64.call __gt_await
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg main.__range_panic_0
    x64.cmp rax, rcx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
