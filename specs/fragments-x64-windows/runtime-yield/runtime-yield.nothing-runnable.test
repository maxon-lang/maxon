// Test: runtime-yield.nothing-runnable
typealias Integer = int(i64.min to i64.max)

function lonely() returns Integer
	var i = 0
	while i < 100 'l'
		Runtime.yield()
		i = i + 1
	end 'l'
	return 7
end 'lonely'

function main() returns ExitCode
	let p = async lonely()
	return await p as ExitCode
end 'main'
---
ExitCode: 7
---
