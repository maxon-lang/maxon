    x64.xor r8d, r8d
    x64.ret
  check_0.after:
    x64.xor edx, edx
    x64.mov r8d, 7
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor ebx, ebx
    x64.mov rcx, rbx
    x64.call maybeFail
    x64.mov r12, r8
    x64.test rdx, rdx
    x64.jne tryblock_2.err
  tryblock_0.cont:
    x64.mov ecx, 1
    x64.call maybeFail
    x64.test rdx, rdx
    x64.jne tryblock_2.err
  tryblock_1.cont:
    x64.add r12, r8
    x64.mov r8, r12
    x64.jmp tryblock_3.after
  tryblock_2.err:
    x64.sub rdx, 1
    x64.test rdx, rdx
    x64.jne k_0.merge
    x64.jmp k_0.case0
  tryblock_3.after:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  k_0.merge:
    x64.mov r8, rbx
    x64.jmp tryblock_3.after
  k_0.case0:
    x64.mov ebx, 42
    x64.jmp k_0.merge
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_0e7d92a963268e6e]
    x64.call mrt_panic
