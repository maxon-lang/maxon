    x64.jmp k_0.case0
  gate_0:
    x64.mov r9d, 1
    x64.jmp tryblock_0.err
  tryblock_1.after:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jle __cast_check_lo_0
    x64.jmp __cast_panic_0
  __cast_check_lo_0:
    x64.test r8, r8
    x64.jge __cast_ok_0
  __cast_panic_0:
    x64.lea r12, [rip+__panic_msg_ba90d27b9f88f44a]
    x64.mov rcx, r12
    x64.call mrt_panic
  __cast_ok_0:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  k_0.merge:
    x64.jmp tryblock_1.after
  k_0.case0:
    x64.mov r8d, 5
    x64.jmp k_0.merge
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_ba90d27b9f88f44a]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
