// Test: literal-overrides-default
type Thing
	export var value = 7

	export static function make(value Integer) returns Self
		return Self{value: value}
	end 'make'
end 'Thing'

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let t = Thing.make(42)
	return t.value
end 'main'
