module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov eax, 1
    x64.xor edx, edx
    x64.mov ecx, 16
    x64.call stdlib.__mm_alloc_needzero
    x64.mov r9d, 41
    x64.mov [r8+0], r9 (8b)
    x64.mov r9d, 1
    x64.mov [r8+8], r9 (8b)
    x64.mov rbx, [r8+8] (8b)
    x64.mov r12, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.mov r9d, 4294967295
    x64.mov r8, r12
    x64.add r8, rbx
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_cd08c5d3bff54436]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
