// Test: module-enum-stays-scalar
enum Color
	red
	green
end 'Color'

var c = Color.red

function seed()
	c = Color.green
end 'seed'

function main() returns ExitCode
	seed()
	return match c 'm'
		red gives 0
		green gives 7
	end 'm'
end 'main'
---
ExitCode: 7
