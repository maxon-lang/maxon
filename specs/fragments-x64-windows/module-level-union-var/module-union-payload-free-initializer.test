// Test: module-union-payload-free-initializer
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.unowned

function main() returns ExitCode
	return match hold 'm'
		unowned gives 4
		owned(v) gives v
	end 'm'
end 'main'
