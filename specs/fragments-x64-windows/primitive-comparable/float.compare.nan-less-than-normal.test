    x64.mulsd xmm2, xmm1
    x64.movsd xmm3, xmm2
    x64.subsd xmm3, xmm2
    x64.movsd xmm4, [rip+__float_42]
    x64.movsd xmm0, xmm3
    x64.movsd xmm1, xmm4
    x64.call stdlib.float.compare
    x64.mov [rbp-8], rax
    x64.jmp main.check_0.cmp0
  check_0.cmp0:
    x64.mov rax, [rbp-8]
