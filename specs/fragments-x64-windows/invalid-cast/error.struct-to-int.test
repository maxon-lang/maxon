// Test: error.struct-to-int
typealias Age = int(0 to 200)
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer

	export static function make() returns Self
		return Self{x: 1}
	end 'make'
end 'Point'

function main() returns ExitCode
	let p = Point.make()
	let bad = p as Age
	return 0
end 'main'
