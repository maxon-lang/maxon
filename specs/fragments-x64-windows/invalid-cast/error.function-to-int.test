// Test: error.function-to-int
typealias Age = int(0 to 200)
typealias Integer = int(i64.min to i64.max)

function double(x Integer) returns Integer
	return x * 2
end 'double'

function main() returns ExitCode
	let f = double
	let bad = f as Age
	return 0
end 'main'
