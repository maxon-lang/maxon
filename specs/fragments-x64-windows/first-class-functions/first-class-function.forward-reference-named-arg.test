  entry:
    x64.prologue stack_size=16
    x64.mov [rbp-8], rdx
    x64.mov r10, rdx
    x64.mov rdx, r8
    x64.call r10
    x64.epilogue
    x64.ret
  }
  func @useDbl() -> i64 {
  entry:
    x64.lea_func rax, [dbl]
    x64.mov rdx, rax
    x64.mov rcx, 20
    x64.xor r8d, r8d
    x64.jmp apply
  }
  func @useTrip() -> i64 {
  entry:
    x64.lea_func rax, [trip]
    x64.mov rdx, rax
    x64.mov rcx, 10
    x64.xor r8d, r8d
    x64.jmp apply
  }
  func @dbl(n: i64) -> i64 {
  entry:
    x64.mov rax, 2
    x64.imul rcx, rax
    x64.mov rax, rcx
    x64.ret
  }
  func @trip(n: i64) -> i64 {
  entry:
    x64.mov rax, 3
    x64.imul rcx, rax
    x64.mov rax, rcx
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.call useDbl
    x64.mov [rbp-8], rax
    x64.call useTrip
    x64.mov rcx, [rbp-8]
    x64.sub rcx, rax
    x64.xor eax, eax
    x64.mov edx, 4294967295
    x64.cmp rcx, rdx
    x64.jg main.__range_panic_0
    x64.cmp rcx, rax
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.mov rax, rcx
    x64.epilogue
    x64.ret
  }
}
