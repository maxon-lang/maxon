// Test: first-class-function.non-capturing-closure-through-ternary

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let c = 1
	let twice = function(n Integer) gives n * 2
	let thrice = function(n Integer) gives n * 3
	let h = twice if c > 0 else thrice
	return h(21)
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.mov rax, 1
    x64.lea_func rcx, [_$closure_14]
    x64.lea_func rdx, [_$closure_15]
    x64.mov [rbp-8], rdx
    x64.xor ebx, ebx
    x64.cmp rax, rbx
    x64.mov [rbp-24], rcx
    x64.jle main.ternary_0.false
  ternary_0.true:
    x64.mov rax, [rbp-24]
    x64.mov [rbp-16], rax
    x64.jmp main.ternary_0.merge
  ternary_0.false:
    x64.mov rax, [rbp-8]
    x64.mov [rbp-16], rax
    x64.jmp main.ternary_0.merge
  ternary_0.merge:
    x64.mov rax, [rbp-16]
    x64.mov rcx, 21
    x64.xor edx, edx
    x64.mov r10, rax
    x64.call r10
    x64.xor ebx, ebx
    x64.mov esi, 4294967295
    x64.cmp rax, rsi
    x64.jg main.__range_panic_0
    x64.cmp rax, rbx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
