    x64.jle __cast_check_lo_0
    x64.jmp __cast_panic_0
  __cast_check_lo_0:
    x64.test r8, r8
    x64.jge __cast_ok_0
  __cast_panic_0:
    x64.lea r12, [rip+__panic_msg_4d9813e62b96ab4c]
    x64.mov rcx, r12
    x64.call mrt_panic
  __cast_ok_0:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_4d9813e62b96ab4c]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
