  ternary_0.false:
    x64.mov rax, 2
    x64.mov [rbp-8], rax
    x64.jmp main.ternary_0.merge
  ternary_0.merge:
    x64.mov rax, [rbp-8]
    x64.mov rcx, 2
    x64.cmp rax, rcx
    x64.je main.v_0.after
  v_0:
    x64.mov rax, 99
    x64.epilogue
    x64.ret
  v_0.after:
    x64.mov rax, qword [rip+sideEffectCount]
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg main.__range_panic_0
    x64.cmp rax, rcx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
