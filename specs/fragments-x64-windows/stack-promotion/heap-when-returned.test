// Test: heap-when-returned
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function makePoint(x Integer, y Integer) returns Point
	return Point.create(x, y: y)
end 'makePoint'

function main() returns ExitCode
	let p = makePoint(5, y: 10)
	return p.x
end 'main'
---
ExitCode: 5
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor edx, edx
    x64.mov ecx, 16
    x64.call stdlib.__mm_alloc
    x64.mov r9d, 5
    x64.mov [r8+0], r9 (8b)
    x64.mov r9d, 10
    x64.mov [r8+8], r9 (8b)
    x64.mov rbx, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp rbx, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_537b316012f994cc]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
}
---
