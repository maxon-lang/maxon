// Test: rc-break-frees-before-exit
typealias Integer = int(i64.min to i64.max)

type Step
	export var val as Integer

	static function create(val Integer) returns Self
		return Self{val: val}
	end 'create'
end 'Step'

function main() returns ExitCode
	var i = 0
	while i < 10 'loop'
		@heap let s = Step.create(i)
		if s.val == 3 'stop'
			break
		end 'stop'
		i = i + 1
	end 'loop'
	return i
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor r8d, r8d
    x64.mov rbx, r8
  loop_0.header:
    x64.cmp rbx, 10
    x64.jge loop_0.exit
  loop_0:
    x64.mov eax, 1
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc_needzero
    x64.mov [r8+0], rbx (8b)
    x64.mov r12, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.cmp r12, 3
    x64.jne stop_0.after
  loop_0.exit:
    x64.mov r8d, 4294967295
    x64.cmp rbx, r8
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  stop_0.after:
    x64.add rbx, 1
    x64.jmp loop_0.header
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_37b47744f11c8d94]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
}
---
