    x64.mov rbx, r8
    x64.mov r8d, 7
    x64.mov [rbx+0], r8 (8b)
    x64.mov r8, [rbx+0] (8b)
    x64.mov r12, r8
  inner_0.after:
    x64.mov rcx, rbx
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rbx, [rip+__panic_msg_90c91a5c2757aba1]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, r12
    x64.epilogue
    x64.ret
  }
}
