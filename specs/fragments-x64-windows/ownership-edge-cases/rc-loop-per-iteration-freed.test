// Test: rc-loop-per-iteration-freed
typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Counter'

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 4 'loop'
		@heap let c = Counter.create(i)
		total = total + c.n
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 6
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.xor r8d, r8d
    x64.xor r9d, r9d
    x64.mov rbx, r9
    x64.mov r12, r8
  loop_0.header:
    x64.cmp r12, 4
    x64.jge loop_0.exit
  loop_0:
    x64.mov eax, 1
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc_needzero
    x64.mov [r8+0], r12 (8b)
    x64.mov r13, [r8+0] (8b)
    x64.mov rcx, r8
    x64.call mm_drop
    x64.add r12, 1
    x64.add rbx, r13
    x64.jmp loop_0.header
  loop_0.exit:
    x64.mov r8d, 4294967295
    x64.cmp rbx, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_232552b6b6b495af]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
}
---
