    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.mov r12, r8
    x64.mov rcx, r12
    x64.call stdlib.__mm_incref
    x64.mov r8d, 50
    x64.mov [r12+0], r8 (8b)
    x64.mov rcx, rbx
    x64.mov rdx, r12
    x64.call mrt_managed_list_insert_first_value
    x64.mov rcx, rbx
    x64.mov rdx, r8
    x64.call mrt_managed_list_remove
    x64.mov rcx, r8
    x64.call __mm_decref_maybenull_helper
    x64.mov rcx, rbx
    x64.call mrt_managed_list_count
    x64.mov r12, r8
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_917691590ff78259]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, r12
    x64.epilogue
    x64.ret
  }
}
