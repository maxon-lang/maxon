// Test: rc-enum-name-no-leak
enum Color
	Red
	Green
	Blue
end 'Color'

function main() returns ExitCode
	let c = Color.Green
	// Printing `.name` still allocates + frees the name String (the leak check);
	// the value can't be compared directly (E3097).
	print("{c.name}\n")
	return 0
end 'main'
---
ExitCode: 0
