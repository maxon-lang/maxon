// Test: rc-enum-string-rawvalue-from-function
enum Planet
	earth = "Earth"
	mars = "Mars"
	venus = "Venus"
end 'Planet'

function getName(p Planet) returns String
	return p.rawValue
end 'getName'

function main() returns ExitCode
	let p = Planet.mars
	let n = getName(p)
	if n == "Mars" 'check'
		return 1
	end 'check'
	return 0
end 'main'
