// Test: rc-match-char-range-cleanup
function main() returns ExitCode
	let c = 'G'
	match c 'classify'
		'a' to 'z' then return 1
		'A' to 'Z' then return 2
		'0' to '9' then return 3
		default then return 0
	end 'classify'
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.mov r9d, 71
  classify_0.next0:
    x64.cmp r9, 90
    x64.setle r8
    x64.cmp r9, 65
    x64.setge rsi
    x64.and rsi, r8
    x64.je classify_0.next1
  classify_0.case1:
    x64.mov r8d, 2
    x64.ret
  classify_0.next1:
    x64.cmp r9, 57
    x64.setle r8
    x64.cmp r9, 48
    x64.setge r9
    x64.and r9, r8
    x64.je classify_0.case3
  classify_0.case2:
    x64.mov r8d, 3
    x64.ret
  classify_0.case3:
    x64.xor r8d, r8d
    x64.ret
  }
}
---
