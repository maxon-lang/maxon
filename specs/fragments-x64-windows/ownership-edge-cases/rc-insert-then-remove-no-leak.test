    x64.jle pop_0.exit
  pop_0:
    x64.lea rax, [rip+__layout_Array_Entry]
    x64.mov rcx, rbx
    x64.mov rdx, r12
    x64.call Array.remove
    x64.mov r14, r8
    x64.test rdx, rdx
