    x64.call __mm_decref_maybenull_helper
    x64.mov r9, [r13+0] (8b)
    x64.mov r12, [r9+0] (8b)
    x64.mov rcx, r13
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_f10e1e2bab9d3897]
    x64.mov rcx, r12
