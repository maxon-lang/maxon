    x64.lea rax, [rip+__layout_Array_Item]
    x64.mov rcx, r13
    x64.mov rdx, r14
    x64.call Array.push
    x64.add r12, 1
    x64.jmp push_0.header
  remove_0.header:
    x64.lea r8, [rip+__data_globalArr]
    x64.mov rcx, [r8+0] (8b)
    x64.lea rdx, [rip+__layout_Array_Item]
    x64.call Array.count
    x64.test r8, r8
    x64.jle remove_0.exit
  remove_0:
    x64.lea r8, [rip+__data_globalArr]
    x64.mov rcx, [r8+0] (8b)
    x64.lea rax, [rip+__layout_Array_Item]
    x64.mov rdx, rbx
    x64.call Array.remove
    x64.mov r9, r8
    x64.test rdx, rdx
    x64.je try_0.merge
    x64.jmp try_0.otherwise
  remove_0.exit:
    x64.mov r8d, 4294967295
    x64.cmp r13, r8
    x64.jbe __range_ok_0
    x64.jmp __range_panic_0
  try_0.otherwise:
