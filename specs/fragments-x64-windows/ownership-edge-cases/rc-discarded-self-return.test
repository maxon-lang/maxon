    x64.add r8, 1
    x64.mov [rbx+0], r8 (8b)
    x64.mov r12, [rbx+0] (8b)
    x64.mov rcx, rbx
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
