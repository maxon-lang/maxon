module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor eax, eax
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.xor edx, edx
    x64.xor ebx, ebx
    x64.cmp rcx, rbx
    x64.sete rsi
    x64.movzx rsi, rsib
    x64.mov rdi, 2
    x64.test rsi, rsi
    x64.mov r8, rdx
    x64.cmovne r8, rdi
    x64.mov r9, 1
    x64.cmp rcx, r9
    x64.sete rax
    x64.movzx rax, raxb
    x64.mov rcx, 1
    x64.test rax, rax
    x64.mov rdx, r8
    x64.cmovne rdx, rcx
    x64.xor eax, eax
    x64.mov ecx, 4294967295
    x64.cmp rdx, rcx
    x64.jg main.__range_panic_0
    x64.cmp rdx, rax
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.mov rax, rdx
    x64.epilogue
    x64.ret
  }
}
