    x64.call stdlib.__mm_alloc
    x64.mov r15, r8
    x64.imul r14, r13
    x64.mov r8d, 3
    x64.cmp r12, 1
    x64.sete r9
    x64.imul r9, r8
    x64.add r14, 0
    x64.add r14, r9
    x64.mov [r15+0], r14 (1b)
    x64.movzx r12, [r15+0] (1b)
    x64.mov rcx, r15
    x64.call mm_drop
    x64.cmp r12, 50
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_042f0bc3623bca69]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, r12
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 1
    x64.call latencyOf
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_dbc87f470d29cbe6]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
