// Test: struct-backing-rawvalue-nonconst-receiver
typealias Latency = int(0 to 50)

type Meta
	export let value as Latency
end 'Meta'

enum TestOp
	add = Meta{value: 1}
	mul = Meta{value: 3}
end 'TestOp'

// `op` is a parameter — not a compile-time-known case — so `op.rawValue.value`
// cannot be const-folded and must materialize the backing struct at runtime.
function latencyOf(op TestOp) returns Latency
	return op.rawValue.value
end 'latencyOf'

function main() returns ExitCode
	return latencyOf(TestOp.mul)
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @latencyOf(rcx: u8) -> u8 {
  entry:
    x64.prologue stack_size=16
    x64.mov r8d, 1
    x64.test rcx, rcx
    x64.sete r9
    x64.imul r9, r8
    x64.mov r8d, 3
    x64.cmp rcx, 1
    x64.sete rsi
    x64.imul rsi, r8
    x64.add r9, 0
    x64.mov r8, r9
    x64.add r8, rsi
    x64.cmp r8, 50
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_042f0bc3623bca69]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 1
    x64.call latencyOf
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_dbc87f470d29cbe6]
    x64.mov rcx, r12
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
