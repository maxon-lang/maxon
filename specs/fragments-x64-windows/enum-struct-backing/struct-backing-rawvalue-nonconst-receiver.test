// Test: struct-backing-rawvalue-nonconst-receiver
typealias Latency = int(0 to 50)

type Meta
	export let value as Latency
end 'Meta'

enum TestOp
	add = Meta{value: 1}
	mul = Meta{value: 3}
end 'TestOp'

// `op` is a parameter — not a compile-time-known case — so `op.rawValue.value`
// cannot be const-folded and must materialize the backing struct at runtime.
function latencyOf(op TestOp) returns Latency
	return op.rawValue.value
end 'latencyOf'

function main() returns ExitCode
	return latencyOf(TestOp.mul)
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @latencyOf(op: i64) -> u8 {
  entry:
    x64.prologue stack_size=16
    x64.mov [rbp-8], rcx
    x64.mov rax, [rbp-8]
    x64.xor edx, edx
    x64.xor ebx, ebx
    x64.cmp rax, rbx
    x64.sete rbx
    x64.movzx rbx, rbxb
    x64.mov rsi, 1
    x64.test rbx, rbx
    x64.mov rdi, rdx
    x64.cmovne rdi, rsi
    x64.mov rdx, 1
    x64.cmp rax, rdx
    x64.sete rax
    x64.movzx rax, raxb
    x64.mov rdx, 3
    x64.test rax, rax
    x64.mov rbx, rdi
    x64.cmovne rbx, rdx
    x64.xor eax, eax
    x64.mov rdx, 50
    x64.cmp rbx, rdx
    x64.jg latencyOf.__range_panic_0
    x64.cmp rbx, rax
    x64.jl latencyOf.__range_panic_0
    x64.jmp latencyOf.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.mov rax, rbx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, 1
    x64.call latencyOf
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg main.__range_panic_0
    x64.cmp rax, rcx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_1]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
