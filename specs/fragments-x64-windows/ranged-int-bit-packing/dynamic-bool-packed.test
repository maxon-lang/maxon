// Test: dynamic-bool-packed
typealias BoolArray = Array with bool

function main() returns ExitCode
	var a = BoolArray.create()
	a.push(true)
	a.push(false)
	a.push(true)
	if a.managed.elementSize() != -1 'notPacked'
		return 99
	end 'notPacked'
	return 5
end 'main'
---
ExitCode: 5
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea rcx, [rip+__layout_Array_Bool]
    x64.call Array.create
    x64.mov rbx, r8
    x64.lea rax, [rip+__layout_Array_Bool]
    x64.mov edx, 1
    x64.mov rcx, rbx
    x64.call Array.push
    x64.lea rax, [rip+__layout_Array_Bool]
    x64.xor edx, edx
    x64.mov rcx, rbx
    x64.call Array.push
    x64.lea rax, [rip+__layout_Array_Bool]
    x64.mov edx, 1
    x64.mov rcx, rbx
    x64.call Array.push
    x64.mov r8, [rbx+0] (8b)
    x64.mov r12, [r8+24] (8b)
    x64.mov rcx, rbx
    x64.call __mm_decref_maybenull_helper
    x64.mov r8, -1
    x64.cmp r12, r8
    x64.je notPacked_0.after
  notPacked_0:
    x64.mov r8d, 99
    x64.epilogue
    x64.ret
  notPacked_0.after:
    x64.mov r8d, 5
    x64.epilogue
    x64.ret
  }
}
---
