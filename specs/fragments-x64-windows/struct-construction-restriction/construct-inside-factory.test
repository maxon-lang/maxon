// Test: construct-inside-factory
typealias Val = int(0 to 100)

type Box
	export var v as Val

	static function create(x Val) returns Box
		return Self{v: x}
	end 'create'

	function get() returns Val
		return self.v
	end 'get'
end 'Box'

function main() returns ExitCode
	let b = Box.create(5)
	return b.get()
end 'main'
