// Test: dispatch-named-first-arg

typealias Integer = int(i64.min to i64.max)

// An interface (or type-parameter) method call may name its FIRST argument:
// the receiver dispatches through interface monomorphization, which is
// receiver-type-dependent and so cannot be ruled out syntactically at parse
// time. The C# bootstrap accepts this (it routes interface/type-param method
// calls through a path that silently consumes a first-arg label); the self-
// hosted parser defers the E2052 check to TypeResolution, which re-applies it
// only for concrete-struct / enum / builtin receivers. This is the regression
// guard for that split.
interface Combiner
	function combine(first Integer, second Integer) returns Integer
end 'Combiner'

type Summer implements Combiner
	let bias as Integer

	function combine(first Integer, second Integer) returns Integer
		return bias + first + second
	end 'combine'

	static function create(bias Integer) returns Self
		return Self{bias: bias}
	end 'create'
end 'Summer'

function combineVia(c Combiner) returns Integer
	return c.combine(first: 12, second: 30)
end 'combineVia'

function main() returns ExitCode
	let s = Summer.create(0)
	return combineVia(s)
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @Summer.combine(rcx: i64, rdx: i64, rax: i64) -> i64 {
  entry:
    x64.mov r8, [rcx+0] (8b)
    x64.add r8, rdx
    x64.add r8, rax
    x64.ret
  }
  func @combineVia(rcx: i64, rdx: i64) -> i64 {
  entry:
    x64.prologue stack_size=16
    x64.mov [rbp-8], rcx
    x64.mov [rbp-16], rdx
    x64.mov r8, [rbp-16]
    x64.mov rcx, [rbp-8]
    x64.mov eax, 30
    x64.mov edx, 12
    x64.mov r10, [r8+24] (8b)
    x64.call r10
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov eax, 1
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc_needzero
    x64.mov rbx, r8
    x64.xor r8d, r8d
    x64.mov [rbx+0], r8 (8b)
    x64.lea rdx, [rip+__witness_Summer_Combiner]
    x64.mov rcx, rbx
    x64.call combineVia
    x64.mov r12, r8
    x64.mov rcx, rbx
    x64.call mm_drop
    x64.mov r8d, 4294967295
    x64.cmp r12, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_ceec5066efc32245]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, r12
    x64.epilogue
    x64.ret
  }
}
