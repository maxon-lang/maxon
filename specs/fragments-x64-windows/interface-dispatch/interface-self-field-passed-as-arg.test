    x64.mov [rbp-16], rdx
    x64.lea rdx, [rip+__destruct_Holder]
    x64.mov ecx, 16
    x64.call stdlib.__mm_alloc
    x64.mov rbx, r8
    x64.mov rcx, rbx
    x64.call stdlib.__mm_incref
    x64.xor r8d, r8d
    x64.mov [rbx+0], r8 (8b)
    x64.mov r12, [rbp-8]
    x64.mov rcx, r12
    x64.call stdlib.__mm_incref
    x64.mov r8, [rbp-16]
    x64.mov [rbx+0], r12 (8b)
    x64.mov [rbx+8], r8 (8b)
    x64.mov rcx, [rbp-8]
    x64.call __mm_decref_maybenull_helper
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc
    x64.mov rbx, r8
