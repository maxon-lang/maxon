// Test: float-payload-write-back
typealias Fraction = float(0.0 to 1000.0)

union Sample
	blank
	measured(d Fraction)
end 'Sample'

function main() returns ExitCode
	var s = Sample.measured(0.5)
	match s 'update'
		measured(d) then d = 0.25
		blank then return 0
	end 'update'
	let after = match s 'read'
		measured(d) gives d
		blank gives 0.0
	end 'read'
	if after == 0.25 'exact'
		return 7
	end 'exact'
	return 1
end 'main'
---
ExitCode: 7
