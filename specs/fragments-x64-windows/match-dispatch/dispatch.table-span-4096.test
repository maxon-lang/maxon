function main() returns ExitCode
	// walk the two edges, both interval boundaries, and the just-outside neighbours
	if classify(0) != 1 'a'
		return 101
	end 'a'
	if classify(31) != 1 'b'
		return 102
	end 'b'
	if classify(32) != 2 'c'
		return 103
