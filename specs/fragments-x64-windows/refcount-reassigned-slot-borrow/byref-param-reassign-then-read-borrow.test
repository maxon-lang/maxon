    x64.call stdlib.__mm_incref
    x64.mov r8d, 99
    x64.mov [r13+0], r8 (4b)
    x64.mov rcx, [rbx+0] (8b)
    x64.mov [rbx+0], r13 (8b)
    x64.call __mm_decref_maybenull_helper
    x64.mov rbx, [r12+0] (4b)
    x64.mov rcx, r12
    x64.call __mm_decref_maybenull_helper
    x64.cmp rbx, 1000000
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_4282ed76405cdb25]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.xor r8d, r8d
    x64.mov [rbp-8], r8
    x64.mov eax, 1
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc_needzero
    x64.mov rbx, r8
    x64.mov rcx, rbx
    x64.call stdlib.__mm_incref
    x64.mov r8d, 5
    x64.mov [rbx+0], r8 (4b)
    x64.mov rcx, [rbp-8]
    x64.call __mm_decref_maybenull_helper
    x64.mov [rbp-8], rbx
    x64.lea rax, [rbp-8]
