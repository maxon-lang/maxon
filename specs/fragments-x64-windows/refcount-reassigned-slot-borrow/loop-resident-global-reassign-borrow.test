// Test: loop-resident-global-reassign-borrow
typealias Int = int(0 to 1000000)

type Box
	export var n as Int

	static function create(v Int) returns Self
		return Self{n: v}
	end 'create'
end 'Box'

var gbox = Box.create(0)

function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 3 'loop'
		let old = gbox
		gbox = Box.create(i + 1)
		sum = sum + old.n
		i = i + 1
	end 'loop'
	return sum
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=32
    x64.xor r8d, r8d
    x64.xor r9d, r9d
    x64.mov rbx, r9
    x64.mov r12, r8
  loop_0.header:
    x64.cmp r12, 3
    x64.jge loop_0.exit
  loop_0:
    x64.lea r8, [rip+__data_gbox]
    x64.mov r13, [r8+0] (8b)
    x64.mov rcx, r13
    x64.call stdlib.__mm_incref
    x64.mov eax, 1
    x64.xor edx, edx
    x64.mov ecx, 8
    x64.call stdlib.__mm_alloc_needzero
    x64.mov r14, r8
    x64.mov rcx, r14
    x64.call stdlib.__mm_incref
    x64.mov r8, r12
    x64.add r8, 1
    x64.mov [r14+0], r8 (4b)
    x64.lea r8, [rip+__data_gbox]
    x64.mov rcx, [r8+0] (8b)
    x64.mov [r8+0], r14 (8b)
    x64.call __mm_decref_maybenull_helper
    x64.mov r14, [r13+0] (4b)
    x64.mov rcx, r13
    x64.call __mm_decref_maybenull_helper
    x64.add r12, 1
    x64.add rbx, r14
    x64.jmp loop_0.header
  loop_0.exit:
    x64.mov r8d, 4294967295
    x64.cmp rbx, r8
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_b7a3c87c13f841b8]
    x64.call mrt_panic
  __range_ok_0:
    x64.mov r8, rbx
    x64.epilogue
    x64.ret
  }
}
