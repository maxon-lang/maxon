// Test: loop-resident-global-reassign-borrow
typealias Int = int(0 to 1000000)

type Box
	export var n as Int

	static function create(v Int) returns Self
		return Self{n: v}
	end 'create'
end 'Box'

var gbox = Box.create(0)

function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 3 'loop'
		let old = gbox
		gbox = Box.create(i + 1)
		sum = sum + old.n
		i = i + 1
	end 'loop'
	return sum
end 'main'
---
ExitCode: 3
