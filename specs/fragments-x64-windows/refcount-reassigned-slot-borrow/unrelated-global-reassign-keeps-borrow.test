// Test: unrelated-global-reassign-keeps-borrow
typealias Int = int(0 to 1000000)

type Box
	export var n as Int

	static function create(v Int) returns Self
		return Self{n: v}
	end 'create'
end 'Box'

var ga = Box.create(3)
var gb = Box.create(9)

function main() returns ExitCode
	let a = ga
	gb = Box.create(2)
	return a.n
end 'main'
---
ExitCode: 3
---
