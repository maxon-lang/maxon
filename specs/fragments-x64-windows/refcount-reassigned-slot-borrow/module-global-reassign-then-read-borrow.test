// Test: module-global-reassign-then-read-borrow
typealias Int = int(0 to 1000000)

type Box
	export var n as Int

	static function create(v Int) returns Self
		return Self{n: v}
	end 'create'
end 'Box'

var gbox = Box.create(1)

function main() returns ExitCode
	let old = gbox
	gbox = Box.create(2)
	return old.n
end 'main'
