// Test: return-in-if-then-reachable
function classify(x ExitCode) returns ExitCode
	if x > 0 'positive'
		return 1
	end 'positive'
	return 0
end 'classify'

function main() returns ExitCode
	return classify(5)
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @classify(rcx: u32) -> u32 {
  entry:
    x64.test rcx, rcx
    x64.jle positive_0.after
  positive_0:
    x64.mov r8d, 1
    x64.ret
  positive_0.after:
    x64.xor r8d, r8d
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 5
    x64.call classify
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_5ddadb253efb62df]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
