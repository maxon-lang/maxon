// Test: union-case-named-self-allowed
typealias Tally = int(0 to 125)

union Node
	leaf(value Tally)
	self
end 'Node'

function pick(n Node) returns Tally
	return match n 'm'
		leaf(v) gives v
		self gives 7
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(Node.self)
end 'main'
