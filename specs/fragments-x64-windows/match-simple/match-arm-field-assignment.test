    x64.mov r13d, 1
    x64.mov rcx, r13
    x64.mov rdx, r12
    x64.call scan
    x64.movsx r13, [r12+0] (1b)
    x64.mov rcx, r12
    x64.call mm_drop
    x64.xor r8d, r8d
    x64.mov r9d, 1
    x64.test r13, r13
    x64.je ternary.else
    x64.mov r8, r9
    x64.jmp ternary.merge
  ternary.else:
  ternary.merge:
    x64.mov r9d, 4294967295
    x64.cmp r8, r9
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea r12, [rip+__panic_msg_1f11ad2503825abb]
    x64.mov rcx, r12
