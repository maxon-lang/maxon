    x64.jne m_0.next1
  m_0.case1:
    x64.mov r8d, 1
    x64.mov [rdx+0], r8 (1b)
    x64.jmp m_0.merge
  m_0.next1:
    x64.mov r8d, 2
    x64.jmp m_0.merge
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
