// Test: match-statements.simple
function main() returns ExitCode
	let x = 2
	match x 'check'
		1 then return 10
		2 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 2
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.mov rdx, 1
    x64.cmp rcx, rdx
    x64.je main.check_0.case0
  check_0.dispatch0:
    x64.mov rax, 2
    x64.mov rcx, [rbp-8]
    x64.cmp rcx, rax
    x64.je main.check_0.case1
  check_0.dispatch1:
    x64.jmp main.check_0.case2
  check_0.case0:
    x64.mov rax, 10
    x64.epilogue
    x64.ret
  check_0.case1:
    x64.mov rax, 20
    x64.epilogue
    x64.ret
  check_0.case2:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  check_0.merge:
  }
}
---
