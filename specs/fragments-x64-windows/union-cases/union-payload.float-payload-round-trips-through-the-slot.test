// Test: union-payload.float-payload-round-trips-through-the-slot
typealias Fraction = float(0.0 to 1000.0)

union Sample
	blank
	measured(d Fraction)
end 'Sample'

function main() returns ExitCode
	let s = Sample.measured(0.5)
	let d = match s 'm'
		blank gives 0.0
		measured(v) gives v
	end 'm'
	if d == 0.5 'exact'
		return 7
	end 'exact'
	return 1
end 'main'
---
ExitCode: 7
