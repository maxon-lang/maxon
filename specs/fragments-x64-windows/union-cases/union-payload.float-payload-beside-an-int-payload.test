// Test: union-payload.float-payload-beside-an-int-payload
typealias Fraction = float(0.0 to 1000.0)
typealias Integer = int(i64.min to i64.max)

union Sample
	counted(n Integer)
	measured(d Fraction)
end 'Sample'

function main() returns ExitCode
	let a = Sample.counted(5)
	let b = Sample.measured(0.25)
	let n = match a 'ma'
		counted(v) gives v
		measured gives 0
	end 'ma'
	let d = match b 'mb'
		counted gives 0.0
		measured(v) gives v
	end 'mb'
	if d == 0.25 'exact'
		return n + 2
	end 'exact'
	return 1
end 'main'
---
ExitCode: 7
