typealias IntArray = Array with Integer

function makeEmpty() returns IntArray
	return IntArray.create()
end 'makeEmpty'

function main() returns ExitCode
	let c = makeEmpty()
	let d = makeEmpty()
	if c is d 'shared'
		return c.count() + 1
	end 'shared'
	return 0
end 'main'
