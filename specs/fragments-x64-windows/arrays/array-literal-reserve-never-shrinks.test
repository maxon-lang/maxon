// Test: array-literal-reserve-never-shrinks
function main() returns ExitCode
	var a = [10, 20, 30]
	a.reserve(1)
	if a.count() != 3 'cnt'
		return 1
	end 'cnt'
	if a.capacity() < a.count() 'cap'
		return 2
	end 'cap'
	return try a.get(2) otherwise 3
end 'main'
---
ExitCode: 30
