// Test: array-literal-resize-shrink-and-grow
function main() returns ExitCode
	var a = [10, 20, 30]
	a.resize(1)
	if a.count() != 1 'shrunk'
		return 1
	end 'shrunk'
	a.resize(3)
	if a.count() != 3 'regrown'
		return 2
	end 'regrown'
	let kept = try a.get(0) otherwise 0
	let vacated = try a.get(2) otherwise 0
	return 0 if kept == 10 and vacated == 0 else 3
end 'main'
