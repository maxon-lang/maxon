// Test: public-may-name-an-enum-case
enum Access
	public
	private
end 'Access'

function main() returns ExitCode
	let a = Access.public
	match a 'which'
		public then return 3
		private then return 0
	end 'which'
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor eax, eax
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.xor edx, edx
    x64.cmp rcx, rdx
    x64.je main.which_0.case0
  which_0.dispatch0:
    x64.mov rax, 1
    x64.mov rcx, [rbp-8]
    x64.cmp rcx, rax
    x64.je main.which_0.case1
  which_0.dispatch1:
    x64.jmp main.which_0.merge
  which_0.case0:
    x64.mov rax, 3
    x64.epilogue
    x64.ret
  which_0.case1:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  which_0.merge:
  }
}
---
