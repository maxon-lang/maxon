typealias Integer = int(i64.min to i64.max)

function grow(s String) returns Integer
	s.append("XY")
	return s.byteLength()
end 'grow'

function main() returns ExitCode
	let g = "hello"
	return grow(g.toUpper()) as ExitCode
end 'main'
