// Test: cast-to-another-alias-of-the-same-function-type
typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

function twice(n Integer) returns Integer
	return n * 2
end 'twice'

function apply(f UnaryOp, n Integer) returns Integer
	return f(n)
end 'apply'

function main() returns ExitCode
	let f = twice as UnaryOp
	return apply(f, n: 21)
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @twice(n: i64) -> i64 {
  entry:
    x64.mov rax, 2
    x64.imul rcx, rax
    x64.mov rax, rcx
    x64.ret
  }
  func @apply(f: i64, __env_f: i64, n: i64) -> i64 {
  entry:
    x64.prologue stack_size=16
    x64.mov [rbp-8], rcx
    x64.mov r10, rcx
    x64.mov rcx, r8
    x64.call r10
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.lea_func rax, [twice]
    x64.mov rcx, rax
    x64.xor edx, edx
    x64.mov r8, 21
    x64.call apply
    x64.xor ecx, ecx
    x64.mov edx, 4294967295
    x64.cmp rax, rdx
    x64.jg main.__range_panic_0
    x64.cmp rax, rcx
    x64.jl main.__range_panic_0
    x64.jmp main.__range_ok_0
  __range_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
}
---
