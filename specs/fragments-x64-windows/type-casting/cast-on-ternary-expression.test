// Test: cast-on-ternary-expression
typealias Mask = int(i64.min to i64.max)

// The cast operand is a ternary whose result is defined in a merge block, so
// `currentBlock` advances past the block the cast started in. The `convert`
// (and its `castCheck`) must emit into the merge block where the operand value
// is bound — emitting into the original block referenced the value before its
// definition and tripped E3013 "unresolved value name" at lowering.
function maskFor(negate bool) returns Mask
	return (1 if negate else (0 - 1)) as Mask
end 'maskFor'

function main() returns ExitCode
	let m = maskFor(false)
	if m < 0 'neg'
		return 2
	end 'neg'
	return 1
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @maskFor(negate: i1) -> i64 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 1
    x64.xor edx, edx
    x64.mov rbx, 1
    x64.sub rdx, rbx
    x64.test rcx, rcx
    x64.mov [rbp-16], rdx
    x64.je maskFor.ternary_0.false
  ternary_0.true:
    x64.mov rax, 1
    x64.mov [rbp-8], rax
    x64.jmp maskFor.ternary_0.merge
  ternary_0.false:
    x64.mov rax, [rbp-16]
    x64.mov [rbp-8], rax
    x64.jmp maskFor.ternary_0.merge
  ternary_0.merge:
    x64.mov rax, [rbp-8]
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor ecx, ecx
    x64.call maskFor
    x64.xor ecx, ecx
    x64.cmp rax, rcx
    x64.jge main.neg_0.after
  neg_0:
    x64.mov rax, 2
    x64.epilogue
    x64.ret
  neg_0.after:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  }
}
---
