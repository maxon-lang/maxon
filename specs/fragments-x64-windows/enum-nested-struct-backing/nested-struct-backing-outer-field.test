// Test: nested-struct-backing-outer-field
typealias Latency = int(0 to 50)

type OpMeta
	export let latency as Latency

	static function create(latency Latency) returns Self
		return Self{latency: latency}
	end 'create'
end 'OpMeta'

type TargetMeta
	export let meta as OpMeta
	export let setsFlags as bool

	static function create(meta OpMeta, setsFlags bool) returns Self
		return Self{meta: meta, setsFlags: setsFlags}
	end 'create'
end 'TargetMeta'

enum Op
	add = TargetMeta.create(OpMeta.create(1), setsFlags: true)
	mov = TargetMeta.create(OpMeta.create(2), setsFlags: false)
end 'Op'

function main() returns ExitCode
	let op = Op.add
	if op.rawValue.setsFlags 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor eax, eax
    x64.mov [rbp-8], rax
    x64.mov rcx, [rbp-8]
    x64.xor edx, edx
    x64.xor ebx, ebx
    x64.cmp rcx, rbx
    x64.sete rsi
    x64.movzx rsi, rsib
    x64.mov rdi, 1
    x64.test rsi, rsi
    x64.mov r8, rdx
    x64.cmovne r8, rdi
    x64.mov r9, 1
    x64.cmp rcx, r9
    x64.sete rax
    x64.movzx rax, raxb
    x64.xor ecx, ecx
    x64.test rax, rax
    x64.mov rdx, r8
    x64.cmovne rdx, rcx
    x64.test rdx, rdx
    x64.je main.check_0.after
  check_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  check_0.after:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  }
}
---
