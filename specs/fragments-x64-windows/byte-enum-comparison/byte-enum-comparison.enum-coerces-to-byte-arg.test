// Test: byte-enum-comparison.enum-coerces-to-byte-arg

typealias Byte = int(0 to u8.max)

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function takesByte(b Byte) returns Byte
	return b
end 'takesByte'

function main() returns ExitCode
	let r = takesByte(Ascii.underscore)
	if r == 95 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @takesByte(rcx: u8) -> u8 {
  entry:
    x64.prologue stack_size=16
    x64.mov r8, rcx
    x64.cmp r8, 255
    x64.jbe __range_ok_0
  __range_panic_0:
    x64.lea rcx, [rip+__panic_msg_1ba662e4b876302c]
    x64.call mrt_panic
  __range_ok_0:
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov ecx, 95
    x64.call takesByte
    x64.cmp r8, 95
    x64.jne ok_0.after
  ok_0:
    x64.xor r8d, r8d
    x64.epilogue
    x64.ret
  ok_0.after:
    x64.mov r8d, 1
    x64.epilogue
    x64.ret
  }
}
