// Test: mod-at-int-min-by-minus-one-is-zero
typealias Integer = int(i64.min to i64.max)

function ident(v Integer) returns Integer
	return v
end 'ident'

function main() returns ExitCode
	let n = ident(i64.min)
	let d = ident(0 - 1)
	let r = try (n mod d) otherwise 77
	print("r={r}\n")
	return 0
end 'main'
---
ExitCode: 0
Stdout: ```
r=0
```
