// Test: shr-unsigned-operand-zero-fills
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function shrConst(v Wide) returns Wide
	return v shr 60
end 'shrConst'

function shrDynamic(v Wide, d Num) returns Wide
	return v shr d
end 'shrDynamic'

function shrPastWidth(v Wide) returns Wide
	return v shr 64
end 'shrPastWidth'

function main() returns ExitCode
	// An UNSIGNED left operand zero-fills. Folded count, then a count the compiler cannot see.
	if shrConst(u64.max) != 15 'foldedCount'
		return 1
	end 'foldedCount'
	if shrDynamic(u64.max, d: 60) != 15 'dynamicCount'
		return 2
	end 'dynamicCount'

	// Zero-filling, so shifting every bit out leaves 0 — NOT the sign, and NOT the masked shift
	// the hardware would have performed.
	if shrPastWidth(u64.max) != 0 'foldedPastWidth'
		return 3
	end 'foldedPastWidth'
	if shrDynamic(u64.max, d: 100) != 0 'dynamicPastWidth'
		return 4
	end 'dynamicPastWidth'

	// A count of 0 is the identity, under either fill.
	if shrDynamic(u64.max, d: 0) != u64.max 'zeroCount'
		return 5
	end 'zeroCount'

	return 42
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @shrConst(v: i64) -> u64 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 60
    x64.mov rdx, rcx
    x64.mov [rbp-8], rcx
    x64.mov rcx, rax
    x64.shr rdx, cl
    x64.mov rax, rdx
    x64.epilogue
    x64.ret
  }
  func @shrDynamic(v: i64, d: i64) -> u64 {
  entry:
    x64.prologue stack_size=16
    x64.xor eax, eax
    x64.cmp rdx, rax
    x64.jge shrDynamic.__shift_count_ok_0
  __shift_count_panic_0:
    x64.lea_symdata rax, [__panic_msg_0]
    x64.mov rcx, rax
    x64.call mrt_panic
  __shift_count_ok_0:
    x64.mov rax, 64
    x64.cmp rdx, rax
    x64.setb rax
    x64.movzx rax, raxb
    x64.mov rbx, rcx
    x64.mov [rbp-8], rcx
    x64.mov rcx, rdx
    x64.shr rbx, cl
    x64.xor ecx, ecx
    x64.test rax, rax
    x64.mov rdx, rcx
    x64.cmovne rdx, rbx
    x64.mov rax, rdx
    x64.epilogue
    x64.ret
  }
  func @shrPastWidth(v: i64) -> u64 {
  entry:
    x64.xor eax, eax
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, -1
    x64.call shrConst
    x64.mov rcx, 15
    x64.cmp rax, rcx
    x64.je main.foldedCount_0.after
  foldedCount_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  foldedCount_0.after:
    x64.mov rcx, -1
    x64.mov rdx, 60
    x64.call shrDynamic
    x64.mov rcx, 15
    x64.cmp rax, rcx
    x64.je main.dynamicCount_0.after
  dynamicCount_0:
    x64.mov rax, 2
    x64.epilogue
    x64.ret
  dynamicCount_0.after:
    x64.mov rcx, -1
    x64.call shrPastWidth
    x64.xor ecx, ecx
    x64.cmp rax, rcx
    x64.je main.foldedPastWidth_0.after
  foldedPastWidth_0:
    x64.mov rax, 3
    x64.epilogue
    x64.ret
  foldedPastWidth_0.after:
    x64.mov rcx, -1
    x64.mov rdx, 100
    x64.call shrDynamic
    x64.xor ecx, ecx
    x64.cmp rax, rcx
    x64.je main.dynamicPastWidth_0.after
  dynamicPastWidth_0:
    x64.mov rax, 4
    x64.epilogue
    x64.ret
  dynamicPastWidth_0.after:
    x64.mov rcx, -1
    x64.xor edx, edx
    x64.call shrDynamic
    x64.mov rcx, -1
    x64.cmp rax, rcx
    x64.je main.zeroCount_0.after
  zeroCount_0:
    x64.mov rax, 5
    x64.epilogue
    x64.ret
  zeroCount_0.after:
    x64.mov rax, 42
    x64.epilogue
    x64.ret
  }
}
