    x64.jge main.__shift_count_ok_1
  __shift_count_panic_1:
    x64.lea_symdata rax, [__panic_msg_1]
    x64.mov rcx, rax
    x64.call mrt_panic
  __shift_count_ok_1:
    x64.mov rdx, 64
