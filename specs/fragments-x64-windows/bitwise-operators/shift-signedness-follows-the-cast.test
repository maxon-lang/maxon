// Test: shift-signedness-follows-the-cast
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function viaCast(p Num) returns Wide
	let w = p as Wide
	return w shr 60
end 'viaCast'

function viaParam(w Wide) returns Wide
	return w shr 60
end 'viaParam'

function main() returns ExitCode
	if viaParam(u64.max) != 15 'declaredParam'
		return 1
	end 'declaredParam'
	if viaCast(u64.max) != 15 'castLocal'
		return 2
	end 'castLocal'
	if viaCast(u64.max) != viaParam(u64.max) 'twoRoutesOneType'
		return 3
	end 'twoRoutesOneType'
	return 42
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @viaCast(p: i64) -> u64 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 60
    x64.mov rdx, rcx
    x64.mov [rbp-8], rcx
    x64.mov rcx, rax
    x64.shr rdx, cl
    x64.mov rax, rdx
    x64.epilogue
    x64.ret
  }
  func @viaParam(w: i64) -> u64 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 60
    x64.mov rdx, rcx
    x64.mov [rbp-8], rcx
    x64.mov rcx, rax
    x64.shr rdx, cl
    x64.mov rax, rdx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov rcx, -1
    x64.call viaParam
    x64.mov rcx, 15
    x64.cmp rax, rcx
    x64.je main.declaredParam_0.after
  declaredParam_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  declaredParam_0.after:
    x64.mov rcx, -1
    x64.call viaCast
    x64.mov rcx, 15
    x64.cmp rax, rcx
    x64.je main.castLocal_0.after
  castLocal_0:
    x64.mov rax, 2
    x64.epilogue
    x64.ret
  castLocal_0.after:
    x64.mov rcx, -1
    x64.call viaCast
    x64.mov [rbp-8], rax
    x64.mov rcx, -1
    x64.call viaParam
    x64.mov rcx, [rbp-8]
    x64.cmp rcx, rax
    x64.je main.twoRoutesOneType_0.after
  twoRoutesOneType_0:
    x64.mov rax, 3
    x64.epilogue
    x64.ret
  twoRoutesOneType_0.after:
    x64.mov rax, 42
    x64.epilogue
    x64.ret
  }
}
---
