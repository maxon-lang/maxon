  step_0.exit:
    x64.mov rax, 71
    x64.mov rcx, [rbp-8]
    x64.cmp rcx, rax
    x64.je main.reached_0.after
  reached_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  reached_0.after:
    x64.mov rax, 1
