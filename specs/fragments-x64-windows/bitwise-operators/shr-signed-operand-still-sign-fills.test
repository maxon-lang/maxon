    x64.mov rax, 64
    x64.cmp rdx, rax
    x64.setb rax
    x64.movzx rax, raxb
    x64.mov rbx, 63
    x64.test rax, rax
    x64.mov rsi, rbx
    x64.cmovne rsi, rdx
    x64.mov rax, rcx
    x64.mov [rbp-8], rcx
    x64.mov rcx, rsi
    x64.sar rax, cl
    x64.epilogue
    x64.ret
  }
  func @shrPastWidth(v: i64) -> i64 {
  entry:
    x64.prologue stack_size=16
    x64.mov rax, 63
    x64.mov rdx, rcx
    x64.mov [rbp-8], rcx
    x64.mov rcx, rax
    x64.sar rdx, cl
    x64.mov rax, rdx
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.xor eax, eax
    x64.mov rcx, 8
