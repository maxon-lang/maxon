    x64.mov rcx, rax
    x64.call shrConst
    x64.xor edx, edx
    x64.mov rbx, 1
    x64.sub rdx, rbx
    x64.cmp rax, rdx
    x64.je main.foldedCount_0.after
  foldedCount_0:
