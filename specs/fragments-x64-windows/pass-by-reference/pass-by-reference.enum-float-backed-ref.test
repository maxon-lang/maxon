// Test: pass-by-reference.enum-float-backed-ref

enum Ratio
	half = 0.5
	quarter = 0.25
end 'Ratio'

function switchRatio(r Ratio)
	r = Ratio.quarter
end 'switchRatio'

function main() returns ExitCode
	var r = Ratio.half
	switchRatio(r)
	if r == Ratio.quarter 'changed'
		return 1
	end 'changed'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @switchRatio(r: i64) {
  entry:
    x64.prologue stack_size=16
    x64.mov [rbp-8], rcx
    x64.movsd xmm0, [rip+__float_0.25]
    x64.movsd [rbp-16], xmm0
    x64.mov rax, [rbp-8]
    x64.movsd xmm1, [rbp-16]
    x64.movsd [rax+0], xmm1
    x64.epilogue
    x64.ret
  }
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.movsd xmm0, [rip+__float_0.5]
    x64.movsd [rbp-8], xmm0
    x64.lea rax, [rbp-8]
    x64.mov rcx, rax
    x64.call switchRatio
    x64.movsd xmm1, [rip+__float_0.25]
    x64.movsd xmm2, [rbp-8]
    x64.ucomisd xmm2, xmm1
    x64.jne main.changed_0.after
    x64.jp main.changed_0.after
  changed_0:
    x64.mov rax, 1
    x64.epilogue
    x64.ret
  changed_0.after:
    x64.xor eax, eax
    x64.epilogue
    x64.ret
  }
}
