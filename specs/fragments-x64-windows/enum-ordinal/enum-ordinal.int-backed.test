// Test: enum-ordinal.int-backed
enum HttpStatus
	ok = 200
	notFound = 404
	serverError = 500
end 'HttpStatus'

function main() returns ExitCode
	let s = HttpStatus.serverError
	// ordinal is 2 (third case), not 500 (the raw value)
	return s.ordinal as ExitCode
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u32 {
  entry:
    x64.prologue stack_size=16
    x64.mov r8d, 2
  __cast_check_lo_0:
    x64.test r8, r8
    x64.jge __cast_ok_0
  __cast_panic_0:
    x64.lea rbx, [rip+__panic_msg_f7e3a2dc19cd0c97]
    x64.mov rcx, rbx
    x64.call mrt_panic
  __cast_ok_0:
    x64.epilogue
    x64.ret
  }
}
---
