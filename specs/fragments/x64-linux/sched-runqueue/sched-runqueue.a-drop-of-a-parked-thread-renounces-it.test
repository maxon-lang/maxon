func @done {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Runtime.yield
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @sleeper {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 200
  __rc_ok:
    x64.callDirect __gt_sleep
  __il_cont:
    x64.movRegImm32 r8, 9
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

