// Test: co-owned-nested-payload-bound-inside-a-borrowed-union-s-arm
typealias Integer = int(i64.min to i64.max)

union Ty
	concrete(name String)
	stringy
end 'Ty'

union Expr
	direct(ty Ty)
	unresolved
end 'Expr'

function steal(e Expr) returns Integer
	return match e 'i'
		direct(ty) gives match ty 't'
			concrete(name) gives name.byteLength()
			stringy gives 0
		end 't'
		unresolved gives 99
	end 'i'
end 'steal'

function main() returns ExitCode
	let e = Expr.direct(Ty.concrete("a nested payload string, long enough to be a real heap allocation"))
	let stolen = steal(e)
	let again = match e 'k'
		direct(ty) gives match ty 'u'
			concrete(name) gives name.byteLength()
			stringy gives 0
		end 'u'
		unresolved gives 99
	end 'k'
	print("stolen={stolen} again={again}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @steal {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#9
  matcharm#1:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#5
  matcharm#2:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  __il_body:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.cmpRegImm32 r13, 0
    x64.jcc greaterEqual, __il_cont
  __il_slow:
    x64.movRegReg rcx, r12
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
  __il_cont:
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.jmp matchcont#6
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#4
  matcharm#3:
    x64.movRegImm32 r12, 0
    x64.movRegReg r13, r12
  matchcont#6:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Ty
    x64.movRegReg r8, r13
    x64.jmp matchcont#10
  matchdead#4:
  matchnext#9:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#8
  matcharm#7:
    x64.movRegImm32 r8, 99
  matchcont#10:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#8:
}

func @main {
  entry:
    x64.pushReg rbp
