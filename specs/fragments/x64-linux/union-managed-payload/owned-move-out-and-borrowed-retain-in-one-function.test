// Test: owned-move-out-and-borrowed-retain-in-one-function
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function mixed(borrowed M) returns Integer
	let owned = M.text("a locally built payload string long enough for the heap")
	let a = match owned 'o'
		silent gives 0
		text(s) gives 1 if s.byteLength() > 0 else 0
	end 'o'
	let b = match borrowed 'b'
		silent gives 0
		text(t) gives 2 if t.byteLength() > 0 else 0
	end 'b'
	return a + b
end 'mixed'

function main() returns ExitCode
	let m = M.text("the caller's payload string, long enough to be a real heap allocation")
	return mixed(m) as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "the caller's payload string, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#5:
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "a locally built payload string long enough for the heap"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#12
  matcharm#6:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont#13
  matchnext#12:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#11
  matcharm#7:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 8], rax
  __il_body#23:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont#22:
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, ternaryfalse#9
  ternarytrue#8:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont#10
  ternaryfalse#9:
    x64.movRegImm32 rbx, 0
  matchcont#10:
    x64.callDirect __str_decref
  matchcont#13:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#20
  matcharm#14:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont#21
  matchnext#20:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#19
  matcharm#15:
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
  __il_body#25:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
  __il_cont#24:
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, ternaryfalse#17
  ternarytrue#16:
    x64.movRegImm32 r15, 2
    x64.jmp matchcont#18
  ternaryfalse#17:
    x64.movRegImm32 r15, 0
  matchcont#18:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rax, r15
  matchcont#21:
    x64.leaRegRegReg rbx, rbx, rax
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_M
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#19:
  matchdead#11:
}
