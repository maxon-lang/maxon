// Test: retained-payload-outlives-its-container
union M
	silent
	text(body String)
end 'M'

function grab(m M) returns String
	return match m 'k'
		silent gives "a fallback literal long enough to be a real heap string"
		text(s) gives s
	end 'k'
end 'grab'

function makeAndExtract() returns String
	let m = M.text("the payload that must outlive its own container, heap-long")
	return grab(m)
end 'makeAndExtract'

function main() returns ExitCode
	print(makeAndExtract())
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body#4:
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "the payload that must outlive its own container, heap-long"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#6:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#7:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "a fallback literal long enough to be a real heap string"
    x64.callDirect __str_retain
    x64.movRegReg rbx, r8
    x64.jmp __il_cont#5
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#8:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
  __il_body#2:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont#1:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
