// Test: the-same-borrowed-container-matched-again-inside-its-own-arm
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function depth(m M) returns Integer
	return match m 'k'
		silent gives 0
		text(s) gives match m 'again'
			silent gives 1
			text(t) gives 6 if t.byteLength() > 0 and s.byteLength() > 0 else 0
		end 'again'
	end 'k'
end 'depth'

function main() returns ExitCode
	let m = M.text("a re-entrantly matched payload string, long enough for the heap")
	return depth(m) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "a re-entrantly matched payload string, long enough for the heap"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#5:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#19
  matcharm#6:
    x64.movRegImm32 rbx, 0
    x64.jmp __rc_ok
  matchnext#19:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#18
  matcharm#7:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#16
  matcharm#8:
    x64.movRegImm32 r13, 1
    x64.jmp matchcont#17
  matchnext#16:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#15
  matcharm#9:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
  __il_body#22:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
  __il_cont#21:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rax, 0
    x64.jcc belowEqual, scmerge
  __il_body#24:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#23:
    x64.cmpRegImm32 rax, 0
    x64.setccReg above, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r14, 6
    x64.jmp matchcont#14
  ternaryfalse:
    x64.movRegImm32 r14, 0
  matchcont#14:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg r13, r14
  matchcont#17:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rbx, r13
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#15:
  matchdead#18:
}
