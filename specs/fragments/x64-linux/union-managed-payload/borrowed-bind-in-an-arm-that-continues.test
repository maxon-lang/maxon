// Test: borrowed-bind-in-an-arm-that-continues
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 1000)

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer
	var i = 0 as Round
	var n = 0 as Integer
	var seen = 0 as Integer
	while i < 200 'spin'
		i = i + 1
		match m 'k'
			text(s) then seen = s.byteLength() and fallthrough
			silent then continue
		end 'k'
		n = n + 2
	end 'spin'
	return n if seen > 0 else 99
end 'show'

function main() returns ExitCode
	let m = M.text("a continued-arm payload string, long enough to be a real heap allocation")
	print("n={show(m)}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "a continued-arm payload string, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "n="
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
  __il_body#4:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.storeSlotReg slot2, rcx
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  spin:
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeSlotReg slot4, rax
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#9
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#8:
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
  __il_body#17:
    x64.loadRegBaseDisp.word64 r15, [r14 + 8]
  __il_cont#16:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, r15
  matcharm#9:
    x64.loadRegSlot rax, slot4
  whilehdr:
    x64.cmpRegImm32 rax, 200
    x64.jcc less, spin
    x64.jmp whileexit
  matchdead:
  whileexit:
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, ternaryfalse
  ternarytrue:
    x64.loadRegSlot r12, slot2
    x64.jmp __il_cont#3
  ternaryfalse:
    x64.movRegImm32 r12, 99
  __il_cont#3:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRegReg rax, r13, r12
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot1
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
  __il_body#2:
    x64.loadRegSlot rcx, slot3
    x64.callDirect __write_stdout
  __il_cont#1:
    x64.loadRegSlot rcx, slot3
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
