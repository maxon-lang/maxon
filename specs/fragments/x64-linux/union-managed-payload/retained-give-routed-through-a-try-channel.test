// Test: retained-give-routed-through-a-try-channel
union Fail implements Error
	because(why String)
end 'Fail'

union M
	silent
	text(body String)
end 'M'

function grab(m M, strict bool) returns String throws Fail
	if strict 'strict'
		throw Fail.because("strict")
	end 'strict'

	return match m 'k'
		silent gives "a fallback literal long enough to be a real heap string"
		text(s) gives s
	end 'k'
end 'grab'

function main() returns ExitCode
	let m = M.text("a payload string routed through a try channel, heap-long")
	let out = try grab(m, strict: false) otherwise "an otherwise literal long enough to be a heap string"
	print(out)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @grab {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont
  strict:
    x64.leaRegRdata rbx, [rip + __str_rec_4]  ; "strict"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "a fallback literal long enough to be a real heap string"
    x64.callDirect __str_retain
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#4:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg r8, rbx
  matchcont:
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_6]  ; "a payload string routed through a try channel, heap-long"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect grab
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rbx, [rip + __str_rec_7]  ; "an otherwise literal long enough to be a heap string"
    x64.movRegReg rcx, r10
    x64.callDirect __destruct_Fail
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.movRegReg rbx, r8
    x64.jmp __il_body
  tryok:
    x64.movRegReg rbx, r8
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
