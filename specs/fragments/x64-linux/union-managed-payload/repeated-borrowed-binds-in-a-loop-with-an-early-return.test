    x64.callDirect __mm_incref
  __il_body#22:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
  __il_cont#21:
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r15, 1
    x64.jmp matchcont#15
  ternaryfalse:
    x64.movRegImm32 r15, 0
  matchcont#15:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rax, r15
  matchcont#18:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont
  stop:
    x64.movRegImm32 rbx, 0
    x64.jmp __il_cont#6
  ifcont:
    x64.leaRegRegReg r13, r13, rax
    x64.leaRegRegImm32 rbx, rbx, 1
  whilehdr:
    x64.cmpRegImm32 rbx, 5
