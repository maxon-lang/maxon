// Test: nested-matches-of-two-borrowed-unions
typealias Integer = int(i64.min to i64.max)

union Inner
	quiet
	loud(word String)
end 'Inner'

union Outer
	blank
	holds(label String)
end 'Outer'

function both(o Outer, i Inner) returns Integer
	return match o 'x'
		blank gives 0
		holds(label) gives match i 'y'
			quiet gives 1
			loud(word) gives 2 if word.byteLength() > 0 and label.byteLength() > 0 else 0
		end 'y'
	end 'x'
end 'both'

function main() returns ExitCode
	let o = Outer.holds("the outer label string, long enough to be a heap allocation")
	let i = Inner.loud("the inner word string, long enough to be a heap allocation")
	let a = both(o, i: i)
	let b = both(o, i: i)
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @both {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#14
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont#15
  matchnext#14:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#13
  matcharm#2:
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#11
  matcharm#3:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont#12
  matchnext#11:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#10
  matcharm#4:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
  __il_body#17:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#16:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rax, 0
    x64.jcc belowEqual, scmerge
  __il_body#19:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
  __il_cont#18:
    x64.cmpRegImm32 rax, 0
    x64.setccReg above, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r13, 2
    x64.jmp matchcont#9
  ternaryfalse:
    x64.movRegImm32 r13, 0
  matchcont#9:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rbx, r13
  matchcont#12:
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r8, rbx
  matchcont#15:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#10:
  matchdead#13:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "the outer label string, long enough to be a heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "the inner word string, long enough to be a heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect both
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect both
    x64.leaRegRegReg rbx, rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Inner
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Outer
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at nested-matches-of-two-borrowed-unions.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
