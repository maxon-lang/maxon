// Test: a-caught-retained-error-box-is-not-moved-out-of
typealias Integer = int(i64.min to i64.max)

union Err
	bad(why String)
end 'Err'

type Holder
	export var e as Err

	static function create(e Err) returns Self
		return Self{e: e}
	end 'create'
end 'Holder'

function boom(h Holder) returns Integer throws Err
	throw h.e
end 'boom'

function whyLen(e Err) returns Integer
	return match e 'l'
		bad(why) gives why.byteLength() as Integer
	end 'l'
end 'whyLen'

function main() returns ExitCode
	let h = Holder.create(Err.bad("a caught retained payload, long enough for the heap"))
	var first = 0 as Integer
	try boom(h) otherwise (e) 'caught'
		first = match e 'm'
			bad(why) gives why.byteLength() as ExitCode
		end 'm'
	end 'caught'
	let second = whyLen(h.e)
	print("first={first} second={second}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @boom {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

