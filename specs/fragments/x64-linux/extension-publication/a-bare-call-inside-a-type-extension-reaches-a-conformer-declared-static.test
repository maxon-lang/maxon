// Test: a-bare-call-inside-a-type-extension-reaches-a-conformer-declared-static
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer

	static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'
end 'Box'

extension Box
	function twin() returns Integer
		return of(7).v + self.v
	end 'twin'
end 'Box'

function main() returns ExitCode
	let b = Box.of(4)
	return b.twin() as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 4
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body:
    x64.movRegImm32 rax, 7
    x64.leaRegSlot rdx, slot1
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r8, rax, rcx
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-bare-call-inside-a-type-extension-reaches-a-conformer-declared-static.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
