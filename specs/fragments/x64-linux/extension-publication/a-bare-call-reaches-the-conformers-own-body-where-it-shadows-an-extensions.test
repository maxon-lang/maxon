// Test: a-bare-call-reaches-the-conformers-own-body-where-it-shadows-an-extensions
typealias Integer = int(i64.min to i64.max)

interface Holder
	function only() returns Integer
end 'Holder'

extension Holder
	export function has() returns Integer
		return 1
	end 'has'

	export function report() returns Integer
		return has() + only()
	end 'report'
end 'Holder'

type Bag implements Holder
	export static function make() returns Self
		return Self{}
	end 'make'

	export function only() returns Integer
		return 3
	end 'only'

	export function has() returns Integer
		return 40
	end 'has'
end 'Bag'

function main() returns ExitCode
	let b = Bag.make()
	return b.report() as ExitCode
end 'main'
---
ExitCode: 43
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
  __il_body#10:
    x64.movRegImm32 rax, 40
  __il_cont:
    x64.leaRegRegImm32 rbx, rax, 3
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
