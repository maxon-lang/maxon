// Test: user-generic-inner-alias-create-is-the-cure
typealias ExitCode = int(0 to 125)

type Pair uses T
	export var a as T

	export static function create(a T) returns Self
		return Self{a: a}
	end 'create'
end 'Pair'

type Plain
	typealias IntPair = Pair with ExitCode

	static function make() returns ExitCode
		let p = IntPair.create(9)
		return p.a
	end 'make'
end 'Plain'

function main() returns ExitCode
	return Plain.make()
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#2:
    x64.movRegImm32 rbx, 9
  __il_body#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#3:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  __il_cont#1:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
