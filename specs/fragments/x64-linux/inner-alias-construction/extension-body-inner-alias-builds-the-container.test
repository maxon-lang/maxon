// Test: extension-body-inner-alias-builds-the-container
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

interface Tagged
	function tag() returns ExitCode
end 'Tagged'

export extension Tagged
	typealias TagArray = Array with ExitCode

	export function tags() returns Count
		var result = TagArray{}
		result.push(self.tag())
		return result.count()
	end 'tags'
end 'Tagged'

type Box implements Tagged
	export var v as ExitCode

	export static function create() returns Self
		return Self{v: 2}
	end 'create'

	export function tag() returns ExitCode
		return self.v
	end 'tag'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	let c = b.tags()
	if c == 1 'ok'
		return 6
	end 'ok'
	return 1
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#4:
    x64.movRegImm32 rbx, 2
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#6:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
  __il_body#8:
    x64.loadRegBaseDisp.word64 rdx, [r12 + 0]
  __il_cont#7:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont#5:
    x64.cmpRegImm32 r13, 1
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 rbx, 6
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
