// Test: an-inner-alias-shadowing-its-own-type
typealias ExitCode = int(0 to 125)

type Holder
	typealias Holder = Array with ExitCode

	export var seed as ExitCode

	static function create() returns Holder
		return Self{seed: 4}
	end 'create'

	function seedValue() returns ExitCode
		return self.seed
	end 'seedValue'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create()
	return h.seedValue()
end 'main'
---
ExitCode: 4
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#3:
    x64.movRegImm32 rbx, 4
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#4:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
  __il_cont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
