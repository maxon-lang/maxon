// Test: generic-body-user-generic-inner-alias-create
typealias ExitCode = int(0 to 125)

type Holder uses Held
	let value as Held

	export static function create(value Held) returns Self
		return Self{value: value}
	end 'create'

	export function get() returns Held
		return value
	end 'get'
end 'Holder'

type Wrap uses Item
	typealias ItemHolder = Holder with Item

	var seed as Item

	export static function create(seed Item) returns Self
		return Self{seed: seed}
	end 'create'

	export function boxed() returns ItemHolder
		return ItemHolder.create(seed)
	end 'boxed'
end 'Wrap'

typealias IntWrap = Wrap with ExitCode

function main() returns ExitCode
	let w = IntWrap.create(7)
	return w.boxed().get()
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 7
  __il_body#3:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#2:
    x64.leaRegRdata rax, [rip + __layout_Wrap_ExitCode$0_125]
  __il_body#6:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#5:
    x64.leaRegRdata rcx, [rip + __layout_Holder_ExitCode$0_125]
  __il_body#4:
    x64.loadRegBaseDisp.word64 rdx, [r13 + 0]
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
  __il_cont#1:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
