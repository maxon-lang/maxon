// Test: type-as-parameter-name-crossfile
// --- file: api/shared.maxon
export typealias StdType = int(i64.min to i64.max)

// --- file: api/helper.maxon
export function identity(type StdType) returns StdType
	return type
end 'identity'

// --- file: app/main.maxon
function main() returns ExitCode
	return identity(42)
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
