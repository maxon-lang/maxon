    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, forhdr#6
  __us_test#36:
    x64.leaRegRegImm32 rsi, rdx, -24
    x64.loadRegBaseDisp.word64 rsi, [rsi + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, forhdr#6
    x64.jmp forhdr#24
  fill:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 16]
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __im_slow#16
  __im_bounds:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.cmpRegReg rax, rdx
    x64.jcc aboveEqual, __im_slow#16
  __im_buffer:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __im_slow#16
  __im_viewed:
    x64.leaRegRegImm32 rsi, rdx, -24
    x64.loadRegBaseDisp.word64 rsi, [rsi + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow#16
  __im_store#20:
    x64.storeBaseIndexScaleReg.word64 [rdx + rax*8 + 0], rax
  forstep#8:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr#6:
    x64.cmpRegReg rax, rcx
    x64.jcc less, fill
    x64.jmp forexit
  __im_store#29:
    x64.storeBaseIndexScaleReg.word64 [rdx + rax*8 + 0], rax
  forstep#25:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr#24:
    x64.cmpRegReg rax, rcx
    x64.jcc less, __im_store#29
  forexit:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_resize
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#22
    x64.jmp __im_load
  tryerr#13:
    x64.movRegImm32 rcx, 1
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegReg r8, rax
  tryok:
    x64.movRegReg rcx, r8
  trycont:
    x64.movRegImm32 rax, 100
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.movRegReg r13, rax
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_cont:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
