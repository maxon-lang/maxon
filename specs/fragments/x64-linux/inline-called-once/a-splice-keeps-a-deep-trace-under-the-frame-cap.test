// Test: a-splice-keeps-a-deep-trace-under-the-frame-cap
typealias Integer = int(i64.min to i64.max)

function innermost(n Integer) returns Integer
	if n > 0 'deep'
		panic("innermost: reached with a positive n")
	end 'deep'

	return n
end 'innermost'

function middle(n Integer) returns Integer
	return innermost(n) + 1
end 'middle'

function outer(n Integer) returns Integer
	return middle(n) + 1
end 'outer'

function descend(depth Integer, n Integer) returns Integer
	if depth == 0 'bottom'
		return outer(n)
	end 'bottom'

	return descend(depth - 1, n: n) + 1
end 'descend'

function main() returns ExitCode
	return descend(96, n: 1) as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @descend {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  __il_body:
    x64.cmpRegImm32 rdx, 0
    x64.jcc lessEqual, __il_cont#7
  deep:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-splice-keeps-a-deep-trace-under-the-frame-cap.test:6: innermost: reached with a positive n\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __il_cont#7:
    x64.leaRegRegImm32 rax, rdx, 1
  __il_cont#5:
    x64.leaRegRegImm32 r8, rax, 1
  __il_cont#3:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect descend
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 96
    x64.movRegImm32 rdx, 1
    x64.callDirect descend
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-splice-keeps-a-deep-trace-under-the-frame-cap.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
