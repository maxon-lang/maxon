  __im_viewed:
    x64.leaRegRegImm32 r9, r8, -24
    x64.loadRegBaseDisp.word64 r9, [r9 + 16]
    x64.cmpRegImm32 r9, 0
    x64.jcc notEqual, __im_slow#17
  __im_store:
    x64.storeBaseIndexScaleReg.word64 [r8 + rsi*8 + 0], rdi
  tryok#7:
    x64.loadRegBaseDisp.word64 rdi, [rax + 0]
    x64.leaRegRegImm32 rdi, rdi, 1
    x64.storeBaseDispReg.word64 [rax + 0], rdi
  forstep:
    x64.leaRegRegImm32 rsi, rsi, 1
