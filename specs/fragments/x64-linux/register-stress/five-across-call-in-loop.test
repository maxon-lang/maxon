// Test: five-across-call-in-loop
function bump(x Integer) returns Integer
	return x + 1
end 'bump'

function fourAcross(p Integer) returns Integer
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var i = 0
	while i < 3 'loop'
		let d = bump(i)
		a1 = a1 + d
		a2 = a2 + d
		a3 = a3 + d
		a4 = a4 + d
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4
end 'fourAcross'

function main() returns ExitCode
	let r = fourAcross(0)
	if r == 34 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#4:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rsi, 4
    x64.movRegImm32 rdi, 0
    x64.jmp whilehdr
  __il_body#9:
    x64.leaRegRegImm32 rdi, rdi, 1
  __il_cont#8:
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rcx, rcx, rdi
    x64.leaRegRegReg rdx, rdx, rdi
    x64.leaRegRegReg rsi, rsi, rdi
  whilehdr:
    x64.cmpRegImm32 rdi, 3
    x64.jcc less, __il_body#9
  whileexit:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
  __il_cont#3:
    x64.cmpRegImm32 rax, 34
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
