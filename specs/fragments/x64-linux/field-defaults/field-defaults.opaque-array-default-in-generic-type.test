// Test: field-defaults.opaque-array-default-in-generic-type
typealias Count = int(0 to u64.max)

type Bag uses Element
	typealias ElementArray = Array with Element
	var items as ElementArray = ElementArray.create()
	var seen = 0

	export static function create() returns Self
		return Self{}
	end 'create'

	export function add(item Element)
		items.push(item)
		seen = seen + 1
	end 'add'

	export function size() returns Count
		return seen
	end 'size'
end 'Bag'

typealias Integer = int(i64.min to i64.max)
typealias IntBag = Bag with Integer

function main() returns ExitCode
	var b = IntBag.create()
	b.add(4)
	b.add(9)
	return b.size()
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_push
    x64.movRegReg rax, r8
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __layout_Bag_Integer]
  __il_body#11:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
  __il_cont#10:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_cont#8:
    x64.movRegImm32 rdx, 4
    x64.leaRegRdata rax, [rip + __layout_Bag_Integer]
    x64.movRegReg rcx, r13
    x64.callDirect Bag.add
    x64.movRegImm32 rdx, 9
    x64.leaRegRdata rax, [rip + __layout_Bag_Integer]
    x64.movRegReg rcx, r13
    x64.callDirect Bag.add
  __il_body#5:
    x64.loadRegBaseDisp.word64 rbx, [r13 + 8]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#7
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Bag_Integer
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at field-defaults.opaque-array-default-in-generic-type.test:19: Range check failed: value outside typealias 'Count'\x0a"
