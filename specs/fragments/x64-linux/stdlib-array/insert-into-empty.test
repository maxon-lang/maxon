// Test: insert-into-empty
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()

	arr.insert(0, value: 42)

	if arr.count() != 1 'cnt'
		return 1
	end 'cnt'

	let v0 = try arr.get(0) otherwise -1
	if v0 != 42 'c0'
		return 2
	end 'c0'

	return 0
end 'main'
