// Test: args-with-multiple-args
function main() returns ExitCode
	let args = CommandLine.args()
	return args.count()
end 'main'
---
Args: one two three
ExitCode: 4
---
data {
  __cl_argc@0 = i64 0
  __cl_argv@8 = i64 0
  __cl_empty_arg@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
  __il_body#5:
    x64.callDirect __cl_count
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 0
    x64.jmp forhdr#6
  loop:
    x64.callDirect __cl_arg
    x64.storeSlotReg slot1, r8
    x64.movRegReg rcx, r8
    x64.callDirect __managed_retain
    x64.movRegReg r13, r8
  __il_body#13:
    x64.loadRegBaseDisp.word64 r14, [r13 + 8]
    x64.movRegImm32 r15, 0
    x64.jmp forhdr#14
  scan:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.callDirect __managed_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.movRegImm32 rax, 1
    x64.jcc greaterEqual, scmerge
  orrhs:
    x64.cmpRegImm32 r8, 13
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, forstep#16
  notSingleByte:
    x64.movRegImm32 rdx, 0
    x64.jmp __il_cont#12
  forstep#16:
    x64.leaRegRegImm32 r15, r15, 1
  forhdr#14:
    x64.cmpRegReg r15, r14
    x64.jcc less, scan
  forexit:
    x64.movRegImm32 rdx, 1
  __il_cont#12:
    x64.movRegReg rcx, r13
    x64.callDirect __str_of_buffer
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
  __il_cont#10:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_push
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
  forstep#8:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rcx, rax, 1
  forhdr#6:
    x64.storeSlotReg slot0, rcx
    x64.cmpRegReg rcx, rbx
    x64.jcc less, loop
  __il_cont#4:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at String.maxon:1136: scanSingleByteGraphemes: byteAt OOB \xe2\x80\x94 i < len invariant\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at args-with-multiple-args.test:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
