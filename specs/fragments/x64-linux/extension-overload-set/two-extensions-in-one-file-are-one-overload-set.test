// Test: two-extensions-in-one-file-are-one-overload-set
typealias Integer = int(i64.min to i64.max)

interface Tagged
	function tag() returns Integer
end 'Tagged'

extension Tagged
	function pick(n Integer) returns Integer
		return tag() + n
	end 'pick'
end 'Tagged'

extension Tagged
	function pick(flag bool) returns Integer
		return tag() + (100 if flag else 0)
	end 'pick'
end 'Tagged'

type Five implements Tagged
	static function make() returns Self
		return Self{}
	end 'make'

	function tag() returns Integer
		return 5
	end 'tag'
end 'Five'

function main() returns ExitCode
	let f = Five.make()
	return f.pick(2) + f.pick(true)
end 'main'
---
ExitCode: 112
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
  __il_body#14:
    x64.movRegImm32 rax, 5
  __il_cont#13:
    x64.leaRegRegImm32 rax, rax, 2
  ternarytrue:
    x64.movRegImm32 rcx, 100
  matchcont:
    x64.leaRegRegImm32 rcx, rcx, 5
  __il_cont#4:
    x64.leaRegRegReg rbx, rax, rcx
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
