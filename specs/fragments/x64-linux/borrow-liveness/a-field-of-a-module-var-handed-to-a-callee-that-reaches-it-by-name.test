// Test: a-field-of-a-module-var-handed-to-a-callee-that-reaches-it-by-name
typealias Count = int(0 to 1000)

type Cell
	export var s as String

	export static function create() returns Cell
		return Cell{s: ""}
	end 'create'

	export function fill(n Count)
		var t = ""
		for _ in 0 upto n 'grow'
			t = "{t}x"
		end 'grow'
		self.s = t
	end 'fill'
end 'Cell'

var g = Cell.create()

function clobber(borrowed String) returns String
	g.s = "clobbered"
	return "[{borrowed}]"
end 'clobber'

function main() returns ExitCode
	g.fill(10)
	print("{clobber(g.s)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_g@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 152
    x64.leaRegGlobal rax, __data_g
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot2, rcx
    x64.callDirect __mm_retain
    x64.storeSlotReg slot0, r8
  __rc_ok:
    x64.leaRegRdata rax, [rip + __str_rec_6]  ; ""
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, r13
    x64.jmp forhdr
  grow:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.leaRegRdata rax, [rip + __str_rec_7]  ; "x"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, r12, r14
    x64.storeSlotReg slot10, rax
    x64.leaRegRegImm32 rcx, rax, 57
