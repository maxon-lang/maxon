// Test: an-unsigned-subtraction-that-borrows-is-refused-at-a-store
typealias Count = int(0 to u64.max)

type Tally
	export var total as Count

	static function create(c Count) returns Tally
		var t = Self{total: 0}
		t.total = c - 5
		return t
	end 'create'
end 'Tally'

function main() returns ExitCode
	print("{Tally.create(3).total}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at an-unsigned-subtraction-that-borrows-is-refused-at-a-store.test:9: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
