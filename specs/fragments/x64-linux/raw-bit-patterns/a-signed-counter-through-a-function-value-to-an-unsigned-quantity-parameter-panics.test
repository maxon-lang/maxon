    x64.loadRegSlot rcx, slot3
    x64.callDirect __str_decref
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rcx, rax, 1
  forhdr:
    x64.storeSlotReg slot0, rcx
    x64.cmpRegImm32 rcx, 1
    x64.jcc less, each
