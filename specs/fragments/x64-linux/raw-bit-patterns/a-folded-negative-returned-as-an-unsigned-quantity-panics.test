// Test: a-folded-negative-returned-as-an-unsigned-quantity-panics
typealias Count = int(0 to u64.max)

function below() returns Count
	let d = 2
	return d - 3
end 'below'

function main() returns ExitCode
	print("{below()}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-folded-negative-returned-as-an-unsigned-quantity-panics.test:6: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
