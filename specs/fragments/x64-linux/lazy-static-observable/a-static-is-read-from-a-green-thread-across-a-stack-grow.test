func @deepThenRead {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  __il_body:
    x64.leaRegGlobal rax, __data_Cache.value
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
  __il_cont:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "read "
    x64.callDirect print
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect deepThenRead
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

