// Test: module-is-an-ordinary-identifier
typealias Integer = int(i64.min to i64.max)

let module = 5

type Holder
	export var module as Integer

	export static function create(module Integer) returns Self
		return Self{module: module}
	end 'create'
end 'Holder'

function twice(module Integer) returns Integer
	var doubled = module
	doubled = doubled + module
	return doubled
end 'twice'

function main() returns ExitCode
	let h = Holder.create(16)
	var module = 5
	module = module + 1
	return (twice(module) + h.module + module) as ExitCode
end 'main'
---
ExitCode: 34
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 16
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 12
    x64.leaRegRegImm32 r8, rax, 6
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at module-is-an-ordinary-identifier.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
