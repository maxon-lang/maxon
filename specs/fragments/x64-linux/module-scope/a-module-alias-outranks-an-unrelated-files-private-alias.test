// Test: a-module-alias-outranks-an-unrelated-files-private-alias
// --- file: lib/a.maxon
module typealias Score = int(0 to 200)

// --- file: lib/b.maxon
export function pick() returns ExitCode
	return 150 as Score
end 'pick'

// --- file: z/z.maxon
typealias Score = int(0 to 5)

export function tiny() returns ExitCode
	let s = 1 as Score
	return s
end 'tiny'

// --- file: main.maxon
function main() returns ExitCode
	return pick() + tiny()
end 'main'
---
ExitCode: 151
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 150
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
