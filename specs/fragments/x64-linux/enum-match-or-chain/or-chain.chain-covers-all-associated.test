// Test: or-chain.chain-covers-all-associated
typealias Integer = int(i64.min to i64.max)

union Mixed
	a(x Integer)
	b(y Integer)
	c(z Integer)
end 'Mixed'

function main() returns ExitCode
	let m = Mixed.b(42)
	match m 'check'
		a or
			b or
			c then return 1
	end 'check'
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 2
    x64.setccReg lessEqual, rax
    x64.andRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matchdead
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
