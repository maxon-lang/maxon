// Test: crossfile-return-type-is-the-declaring-files-meaning
// --- file: a.maxon
typealias Widget = int(0 to 5)

export function fromA() returns Widget
	return 3
end 'fromA'

// --- file: b.maxon
typealias Slot = int(0 to 100)

export type Widget
	export var value as Slot

	export static function create(value Slot) returns Widget
		return Self{value: value}
	end 'create'
end 'Widget'

export function fromB() returns Widget
	return Widget.create(9)
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	let boxed = fromB()

	return fromA() + boxed.value
end 'main'
---
ExitCode: 12
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.movRegImm32 rbx, 9
  __rc_ok#10:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rbx, rax, 3
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#1:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
