// Test: cross-directory-type-and-exported-typealias-coexist
// --- file: a/score.maxon
export type Score
	export let v as ExitCode

	export static function make() returns Score
		return Score{v: 40}
	end 'make'
end 'Score'

// --- file: b/score.maxon
export typealias Score = int(0 to 10)

// --- file: app/main.maxon
function total(s a.Score, n b.Score) returns ExitCode
	return s.v + (n as ExitCode)
end 'total'

function main() returns ExitCode
	return total(a.Score.make(), n: 2)
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 r8, 42
  __il_cont:
    x64.popReg rbp
    x64.ret
}
