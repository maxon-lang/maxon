  __us_test:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 8]
    x64.loadRegBaseDisp.word64 rsi, [r13 + 0]
    x64.loadRegBaseDisp.word64 rdi, [r13 + 40]
    x64.cmpRegImm32 rdi, 0
