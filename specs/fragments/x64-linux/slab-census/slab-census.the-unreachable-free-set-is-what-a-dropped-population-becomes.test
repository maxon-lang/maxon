// Test: slab-census.the-unreachable-free-set-is-what-a-dropped-population-becomes
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Seed = int(0 to 65536)

let Population = 16000

function build(seed Seed) returns ByteArray
	var b = ByteArray.create()
	b.reserve(96)
	for i in 0 upto 96 'fill'
		b.push(((seed + i) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var bufs = Bufs.create()
	for k in 0 upto Population 'alloc'
		bufs.push(build(k as Seed))
	end 'alloc'

	bufs = Bufs.create()

	let free = __Builtins.slabFreeBytes()
	let cached = __Builtins.slabCachedFreeBytes()
	let parked = __Builtins.slabParkedBytes()

	if cached > free 'cachedIsNotASubset'
		return 1
	end 'cachedIsNotASubset'

	if parked > free 'parkedIsNotASubset'
		return 2
	end 'parkedIsNotASubset'

	if free <= cached 'everythingFreeWasReachable'
		return 3
	end 'everythingFreeWasReachable'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  __rc_ok#17:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 96
  __rc_ok#29:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 96
    x64.jcc greaterEqual, __il_cont#23
  grow:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont#23
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont#23:
    x64.movRegImm32 r14, 0
    x64.jmp forhdr#13
  fill:
    x64.leaRegRegReg rcx, r12, r14
    x64.movRegImm rax, 367465021388636487
    x64.mulHighReg rcx
    x64.movRegReg rax, rcx
    x64.subRegReg rax, rcx, rdx
    x64.shrRegImm8 rax, rax, 1
    x64.leaRegRegReg rax, rax, rdx
    x64.shrRegImm8 rax, rax, 7
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, rcx
    x64.subRegReg rdx, rcx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#20:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
  forstep#15:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr#13:
    x64.cmpRegImm32 r14, 96
    x64.jcc less, fill
  __il_cont#11:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 16000
    x64.jcc less, __rc_ok#17
  forexit:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.callDirect __slab_free_bytes
    x64.movRegReg rbx, r8
    x64.callDirect __slab_cached_free_bytes
    x64.movRegReg r13, r8
    x64.callDirect __slab_parked_bytes
    x64.cmpRegReg r13, rbx
    x64.jcc lessEqual, ifcont#6
  cachedIsNotASubset:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.cmpRegReg r8, rbx
    x64.jcc lessEqual, ifcont#8
  parkedIsNotASubset:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.cmpRegReg rbx, r13
    x64.jcc greater, ifcont#10
  everythingFreeWasReachable:
    x64.movRegImm32 rbx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at slab-census.the-unreachable-free-set-is-what-a-dropped-population-becomes.test:13: Range check failed: value outside typealias 'Byte'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
