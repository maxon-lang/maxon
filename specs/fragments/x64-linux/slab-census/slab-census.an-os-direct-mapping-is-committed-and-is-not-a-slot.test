// Test: slab-census.an-os-direct-mapping-is-committed-and-is-not-a-slot
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

let Big = 400000

function main() returns ExitCode
	let committedBefore = __Builtins.slabCommittedBytes()
	let liveBefore = __Builtins.slabLiveBytes()

	var buf = ByteArray.create()
	buf.reserve(Big)
	for i in 0 upto Big 'fill'
		buf.push((i mod 251) as Byte)
	end 'fill'

	let committedHolding = __Builtins.slabCommittedBytes()

	if (committedHolding - committedBefore) < Big 'mappingNotCounted'
		return 1
	end 'mappingNotCounted'

	if (__Builtins.slabLiveBytes() - liveBefore) >= Big 'mappingCountedAsASlot'
		return 2
	end 'mappingCountedAsASlot'

	buf = ByteArray.create()

	if __Builtins.slabCommittedBytes() >= committedHolding 'mappingNotGivenBack'
		return 3
	end 'mappingNotGivenBack'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect __slab_committed_bytes
    x64.movRegReg rbx, r8
    x64.callDirect __slab_live_bytes
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 400000
  __rc_ok#20:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 400000
    x64.jcc greaterEqual, __il_cont
  grow:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont:
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  fill:
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg r14
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, r14
    x64.subRegReg rdx, r14, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#11:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr:
    x64.cmpRegImm32 r14, 400000
    x64.jcc less, fill
  forexit:
    x64.callDirect __slab_committed_bytes
    x64.movRegReg r14, r8
    x64.movRegReg rax, r14
    x64.subRegReg rax, r14, rbx
    x64.cmpRegImm32 rax, 400000
    x64.jcc greaterEqual, ifcont#6
  mappingNotCounted:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.callDirect __slab_live_bytes
    x64.subRegReg r8, r8, r12
    x64.cmpRegImm32 r8, 400000
    x64.jcc less, ifcont#8
  mappingCountedAsASlot:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.callDirect __slab_committed_bytes
    x64.cmpRegReg r8, r14
    x64.jcc less, ifcont#10
  mappingNotGivenBack:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at slab-census.an-os-direct-mapping-is-committed-and-is-not-a-slot.test:14: Range check failed: value outside typealias 'Byte'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
