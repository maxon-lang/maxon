// Test: iteration.large-list
typealias Integer = int(i64.min to i64.max)
typealias IntList = List with Integer

function main() returns ExitCode
	var list = IntList.create()
	for i in 1 to 100 'build'
		list.append(i)
	end 'build'
	var sum = 0
	for item in list 'loop'
		sum = sum + item
	end 'loop'
	return sum - 5050
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __layout_List_Integer]
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rax + 40]
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont:
    x64.movRegImm32 rbx, 1
    x64.jmp forhdr#1
  build:
    x64.leaRegRdata rax, [rip + __layout_List_Integer]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect List.append
  forstep#3:
    x64.leaRegRegImm32 rbx, rbx, 1
  forhdr#1:
    x64.cmpRegImm32 rbx, 100
    x64.jcc lessEqual, build
  forexit#4:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect List.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forhdr#5
    x64.jmp forempty
  loop:
    x64.leaRegRdata rdx, [rip + __layout_ListIterator_Integer]
    x64.movRegReg rcx, r13
    x64.callDirect ListIterator.current
    x64.leaRegRegReg rbx, rbx, r8
  forstep#8:
    x64.movRegReg rcx, r13
    x64.callDirect ListIterator.advance
    x64.movRegReg rax, r10
  forhdr#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, loop
  forexit#9:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ListIterator_Integer
    x64.movRegReg rax, rbx
    x64.jmp forjoin
  forempty:
    x64.movRegReg rax, rbx
  forjoin:
    x64.leaRegRegImm32 rbx, rax, -5050
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_List_Integer
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at iteration.large-list.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
