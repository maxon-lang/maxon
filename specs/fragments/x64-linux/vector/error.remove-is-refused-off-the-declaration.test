// Test: error.remove-is-refused-off-the-declaration
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

function main() returns ExitCode
	var v = Vec3.create()
	return try v.remove(0) otherwise 0
end 'main'
