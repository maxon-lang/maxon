// Test: iterate
typealias Int = int(i64.min to i64.max)
typealias Vec4 = Vector with 4 Int

function main() returns ExitCode
	var v = Vec4.create()
	try v.set(0, value: 1) otherwise panic("test invariant: set OOB")
	try v.set(1, value: 2) otherwise panic("test invariant: set OOB")
	try v.set(2, value: 3) otherwise panic("test invariant: set OOB")
	try v.set(3, value: 4) otherwise panic("test invariant: set OOB")
	var sum = 0
	for elem in v 'loop'
		sum = sum + elem
	end 'loop'
	return sum
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rdx, 4
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at iterate.test:7: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 2
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at iterate.test:8: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at iterate.test:9: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 4
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#7
  tryerr#8:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at iterate.test:10: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forjoin
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, forexit
  loop:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Int]
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.current
    x64.leaRegRegReg r12, r12, r8
  forstep:
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ArrayIterator_Int
  forjoin:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at iterate.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
