// Test: a-vector-in-an-extension-body-over-an-associated-type
typealias Int = int(i64.min to i64.max)

interface Sized uses Element
	typealias Slot = Vector with 4 Element
	function tally() returns Int
end 'Sized'

extension Sized
	export function tallyTwice() returns Int
		var v = Slot.create()
		return (v.count() as Int) + tally()
	end 'tallyTwice'
end 'Sized'

type Bag uses Element implements Sized with Element
	typealias Slot = Vector with 4 Element
	var n as Int

	export static function create() returns Self
		return Self{n: 1}
	end 'create'

	export function tally() returns Int
		return n
	end 'tally'
end 'Bag'

typealias IntBag = Bag with Int

function main() returns ExitCode
	var b = IntBag.create()
	return b.tallyTwice()
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#4:
    x64.leaRegRdata rax, [rip + __layout_Bag_Int]
  __il_body#7:
    x64.movRegImm32 rbx, 4
  __il_body#11:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
  __il_body#15:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
  __il_cont#8:
    x64.leaRegRegImm32 rbx, rax, 4
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
  __il_cont#6:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-vector-in-an-extension-body-over-an-associated-type.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
