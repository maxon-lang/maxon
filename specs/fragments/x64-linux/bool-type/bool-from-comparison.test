// Test: bool-from-comparison
function main() returns ExitCode
	let result = 5 > 3
	if result 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
