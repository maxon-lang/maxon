// Test: mixed-values
enum Priority
	low
	medium
	high = 10
	critical
end 'Priority'

function main() returns ExitCode
	let result = match Priority.critical 'check'
		low gives 0
		medium gives 1
		high gives 10
		critical gives 11
	end 'check'
	return result
end 'main'
---
ExitCode: 11
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 11
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
