// Test: function-param
enum Status
	on
	off
end 'Status'

function isOn(s Status) returns bool
	if s == Status.on 'check'
		return true
	end 'check'
	return false
end 'isOn'

function main() returns ExitCode
	let status = Status.on
	if isOn(status) 'test'
		return 1
	end 'test'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  test:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
