// Test: top-level-constant
enum Color
	red
	green
	blue
end 'Color'

let DEFAULT_COLOR = Color.green

function main() returns ExitCode
	if DEFAULT_COLOR == Color.green 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
