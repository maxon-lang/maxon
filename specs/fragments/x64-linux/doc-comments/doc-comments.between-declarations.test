    x64.prologue 32
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 4
  __il_body:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#15
  __rc_chk#16:
    x64.cmpRegImm32 r8, 1000
    x64.jcc greater, __rc_panic#15
  __rc_chk#3:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#15:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at doc-comments.between-declarations.test:19: Range check failed: value outside typealias 'Coord'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at doc-comments.between-declarations.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
