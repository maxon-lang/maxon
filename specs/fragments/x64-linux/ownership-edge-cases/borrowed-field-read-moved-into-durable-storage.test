// Test: borrowed-field-read-moved-into-durable-storage
typealias Integer = int(i64.min to i64.max)

type Item
	export let n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Item'

type Holder
	export let item as Item

	static function create(item Item) returns Self
		return Self{item: item}
	end 'create'

	static function copyOf(other Holder) returns Self
		return Self{item: other.item}
	end 'copyOf'
end 'Holder'

function main() returns ExitCode
	let a = Holder.create(Item.create(5))
	let b = Holder.copyOf(a)
	return a.item.n + b.item.n
end 'main'
---
ExitCode: 10
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 5
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.storeBaseDispReg.word64 [rbx + 0], r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
  __il_body#9:
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.storeBaseDispReg.word64 [r13 + 0], r8
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r12, rax, rcx
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Holder
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at borrowed-field-read-moved-into-durable-storage.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
