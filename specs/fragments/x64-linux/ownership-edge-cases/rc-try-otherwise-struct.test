// Test: rc-try-otherwise-struct
typealias Integer = int(i64.min to i64.max)

type Fallback
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Fallback'

typealias FallbackArray = Array with Fallback

function main() returns ExitCode
	var arr = FallbackArray.create()
	arr.push(Fallback.create(10))
	let a = try arr.get(0) otherwise Fallback.create(99)
	let b = try arr.get(5) otherwise Fallback.create(42)
	return a.n + b.n
end 'main'
---
ExitCode: 52
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Fallback.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 10
    x64.callDirect Fallback.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#11
  __im_load#12:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#18
  __im_empty#13:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, critsplit#19
  __im_slow#11:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.jmp __im_cont#10
  critsplit#19:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#10
  critsplit#18:
    x64.movRegReg r10, rax
  __im_cont#10:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rcx, 99
    x64.callDirect Fallback.create
    x64.movRegReg r12, r8
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  trycont#3:
    x64.movRegImm32 rdx, 5
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 5
    x64.jcc belowEqual, __im_slow#15
  __im_load#16:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 40
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#20
  __im_empty#17:
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, critsplit#21
  __im_slow#15:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r13, r8
    x64.jmp __im_cont#14
  critsplit#21:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#14
  critsplit#20:
    x64.movRegReg r10, rax
  __im_cont#14:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 rcx, 42
    x64.callDirect Fallback.create
    x64.movRegReg rcx, r8
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r13
  trycont#6:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.leaRegRegReg r13, rax, rdx
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at rc-try-otherwise-struct.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
