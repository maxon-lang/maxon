// Test: rc-char-inner-block-freed
function main() returns ExitCode
	var result = 0
	if true 'inner'
		let c = 'Q'
		result = c.byteLength()
	end 'inner'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  inner:
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; "Q"
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at rc-char-inner-block-freed.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
