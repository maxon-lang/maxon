// Test: rc-struct-field-store
typealias Integer = int(i64.min to i64.max)

type Inner
	export var val as Integer

	static function create(val Integer) returns Self
		return Self{val: val}
	end 'create'
end 'Inner'

type Outer
	export var child as Inner

	export function setChild(c Inner)
		child = c
	end 'setChild'

	static function create(child Inner) returns Self
		return Self{child: child}
	end 'create'
end 'Outer'

function main() returns ExitCode
	var o = Outer.create(Inner.create(0))
	let i = Inner.create(55)
	o.setChild(i)
	return o.child.val
end 'main'
---
ExitCode: 55
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Inner.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect Inner.create
    x64.movRegReg rbx, r8
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
  __il_cont#5:
    x64.movRegImm32 rcx, 55
    x64.callDirect Inner.create
    x64.movRegReg rbx, r8
  __il_body#7:
    x64.loadRegBaseDisp.word64 r13, [r12 + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.storeBaseDispReg.word64 [r12 + 0], r14
  __il_cont#4:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Outer
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at rc-struct-field-store.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
