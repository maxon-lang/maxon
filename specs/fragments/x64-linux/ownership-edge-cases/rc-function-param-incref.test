// Test: rc-function-param-incref
typealias Integer = int(i64.min to i64.max)

type Config
	export var level as Integer

	static function create(level Integer) returns Self
		return Self{level: level}
	end 'create'
end 'Config'

function readLevel(c Config) returns Integer
	return c.level
end 'readLevel'

function main() returns ExitCode
	let cfg = Config.create(77)
	let l = readLevel(cfg)
	return l + cfg.level - 77
end 'main'
---
ExitCode: 77
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 77
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
  __il_cont:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 r8, rax, -77
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at rc-function-param-incref.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
