// Test: rc-release-break-for-in
typealias Integer = int(i64.min to i64.max)

type Item
	export var val as Integer

	static function create(val Integer) returns Self
		return Self{val: val}
	end 'create'
end 'Item'

function main() returns ExitCode
	let items = [10, 20, 30, 40, 50]
	var result = 0

	for item in items 'search'
		let wrapped = Item.create(item)
		if wrapped.val == 30 'found'
			result = wrapped.val
			break
		end 'found'
	end 'search'

	return result
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 5
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  search:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rcx + rax*8 + 0]
  __im_cont:
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.cmpRegImm32 rcx, 30
    x64.jcc notEqual, forstep
  found:
    x64.loadRegBaseDisp.word64 rbx, [rdx + 0]
    x64.jmp forexit
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at rc-release-break-for-in.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
