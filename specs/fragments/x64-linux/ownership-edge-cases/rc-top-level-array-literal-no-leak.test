// Test: rc-top-level-array-literal-no-leak
var items = [10, 20, 30]

function main() returns ExitCode
	let a = try items.get(0) otherwise 0
	let b = try items.get(1) otherwise 0
	let c = try items.get(2) otherwise 0
	return a + b + c
end 'main'
---
ExitCode: 60
---
data {
  __data_items@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegGlobal rax, __data_items
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#14
    x64.jmp __im_load#15
  tryerr#2:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#3
  __im_load#15:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegReg r8, rax
  tryok#1:
    x64.movRegReg rax, r8
  trycont#3:
    x64.leaRegGlobal rcx, __data_items
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.cmpRegImm32 rsi, 1
    x64.jcc belowEqual, __im_slow#17
    x64.jmp __im_load#18
  tryerr#5:
    x64.movRegImm32 rcx, 0
    x64.jmp trycont#6
  __im_load#18:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 8
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg r8, rcx
  tryok#4:
    x64.movRegReg rcx, r8
  trycont#6:
    x64.leaRegGlobal rdx, __data_items
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegImm32 rsi, 2
    x64.loadRegBaseDisp.word64 rdi, [rdx + 8]
    x64.cmpRegImm32 rdi, 2
    x64.jcc belowEqual, __im_slow#20
    x64.jmp __im_load#21
  tryerr#8:
    x64.movRegImm32 rdx, 0
    x64.jmp trycont#9
  __im_load#21:
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.leaRegRegImm32 rdx, rdx, 16
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegReg r8, rdx
  tryok#7:
    x64.movRegReg rdx, r8
  trycont#9:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rdx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __im_slow#14:
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  __im_slow#17:
    x64.storeSlotReg slot0, rax
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  __im_slow#20:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at rc-top-level-array-literal-no-leak.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
