// Test: try-block.bare-throw-routed
typealias Count = int(0 to 1000)

enum Kind
    alpha
    beta
    gamma
end 'Kind'

enum MyError implements Error
    fooErr
    barErr
end 'MyError'

function dispatch(k Kind) returns Count throws MyError
    var result = 0
    try 'd'
        match k 'm'
            alpha then result = 1
            beta then throw MyError.barErr
            default throws MyError.fooErr
        end 'm'
    end 'd' otherwise (e) 'h'
        match e 'he'
            fooErr then result = 40
            barErr then result = 80
        end 'he'
    end 'h'

    if result == 0 'unset'
        throw MyError.fooErr
    end 'unset'

    return result
end 'dispatch'

function main() returns ExitCode
    let a = try dispatch(Kind.alpha) otherwise panic("alpha escaped")
    let b = try dispatch(Kind.beta) otherwise panic("beta escaped")
    let c = try dispatch(Kind.gamma) otherwise panic("gamma escaped")
    return a + b + c
end 'main'
---
ExitCode: 121
---
func @dispatch {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.jmp ifcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdefault
  matcharm#3:
    x64.movRegImm32 rax, 2
    x64.jmp tryblkerr
  matchdefault:
    x64.movRegImm32 rax, 1
  tryblkerr:
    x64.leaRegRegImm32 rax, rax, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#8
  matcharm#7:
    x64.movRegImm32 rax, 40
    x64.jmp matchcont
  matcharm#8:
    x64.movRegImm32 rax, 80
  matchcont:
    x64.movRegReg r8, rax
  ifcont:
    x64.movRegImm32 r10, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect dispatch
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
  tryok#1:
    x64.movRegImm32 rcx, 1
    x64.callDirect dispatch
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
  tryok#3:
    x64.movRegImm32 rcx, 2
    x64.callDirect dispatch
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
  tryok#5:
    x64.leaRegRegReg rax, rbx, r12
    x64.leaRegRegReg r8, rax, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at try-block.bare-throw-routed.test:38: alpha escaped\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#4:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at try-block.bare-throw-routed.test:39: beta escaped\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at try-block.bare-throw-routed.test:40: gamma escaped\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at try-block.bare-throw-routed.test:41: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
