// Test: try-block.array-get-out-of-bounds
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
    var arr = IntArray.create()
    arr.push(7)
    arr.push(11)

    var sum = 0
    try 'work'
        let a = arr.get(0)
        let b = arr.get(99)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            indexOutOfBounds then sum = 42
            emptySlot then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 11
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#14
  __im_load#15:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#22
  __im_empty#16:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, critsplit#23
  __im_slow#14:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.jmp __im_cont#13
  critsplit#23:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#13
  critsplit#22:
    x64.movRegReg r10, rax
  __im_cont#13:
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryblkerr
  tryblkok#2:
    x64.movRegImm32 rdx, 99
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 99
    x64.jcc belowEqual, __im_slow#18
  __im_load#19:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 792
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#25
  __im_empty#20:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#26
  __im_slow#18:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.jmp __im_cont#17
  critsplit#26:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont#17
  critsplit#25:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont#17:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#3
  tryblkerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#4:
    x64.movRegImm32 rax, 42
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#5:
    x64.movRegImm32 rax, 99
  matchcont:
    x64.movRegReg r12, rax
    x64.jmp tryblkcont
  matchdead:
  tryblkok#3:
    x64.leaRegRegReg r12, r12, r8
  tryblkcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at try-block.array-get-out-of-bounds.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
