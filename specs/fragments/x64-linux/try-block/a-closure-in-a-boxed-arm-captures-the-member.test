    x64.loadRegSlot rcx, slot8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 248
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
