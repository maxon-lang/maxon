// Test: implied-try-block-explicit-try-of-a-rebranded-call
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias Scores = Array with Integer
typealias Tally = int(0 to 100)

enum ApiError implements Error
	notFound
end 'ApiError'

enum OtherError implements Error
	failed
end 'OtherError'

function items(hit bool) returns IntArray throws ApiError
	if not hit 'miss'
		throw ApiError.notFound
	end 'miss'

	var found = IntArray.create()
	found.push(4)
	return found
end 'items'

function other(fail bool) returns Tally throws OtherError
	if fail 'boom'
		throw OtherError.failed
	end 'boom'

	return 7
end 'other'

function main() returns ExitCode
	var result = 0 as Tally

	try 'work'
		let s = try (items(false) as Scores) otherwise Scores.create()
		result = (s.count() as Tally) + other(false)
	end 'work' otherwise (e) 'h'
		match e 'k'
			failed then result = 55
		end 'k'
	end 'h'

	return result
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @items {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  miss:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @other {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  boom:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 7
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect items
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
  trycont:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.cmpRegImm32 r12, 100
    x64.jcc greater, __rc_panic#12
  __rc_ok#11:
    x64.movRegImm32 rcx, 0
    x64.callDirect other
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, tryblkok
  tryblkthrow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  tryblkerr:
    x64.leaRegRegImm32 rax, r13, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 r8, 55
    x64.jmp tryblkcont
  matchdead:
  tryblkok:
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#15
  __rc_chk#16:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#15
  __rc_ok#14:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at implied-try-block-explicit-try-of-a-rebranded-call.test:38: Range check failed: value outside typealias 'Tally'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#15:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at implied-try-block-explicit-try-of-a-rebranded-call.test:45: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
