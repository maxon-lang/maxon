// Test: break.in-loop
function main() returns ExitCode
	var x = 0
	while true 'loop'
		x = x + 1
		if x == 5 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  loop:
    x64.leaRegRegImm32 r8, rax, 1
    x64.cmpRegImm32 r8, 5
    x64.jcc notEqual, ifcont
  __rc_ok:
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp loop
}
