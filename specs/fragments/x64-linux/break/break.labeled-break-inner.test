// Test: break.labeled-break-inner
function main() returns ExitCode
	var x = 0
	var y = 0
	while x < 5 'outer'
		x = x + 1
		while y < 10 'inner'
			y = y + 1
			if y == 3 'check'
				break
			end 'check'
		end 'inner'
	end 'outer'
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr#1
  outer:
    x64.leaRegRegImm32 r8, r8, 1
    x64.jmp whilehdr#4
  inner:
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, whilehdr#1
  whilehdr#4:
    x64.cmpRegImm32 rax, 10
    x64.jcc less, inner
  whilehdr#1:
    x64.cmpRegImm32 r8, 5
    x64.jcc less, outer
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at break.labeled-break-inner.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
