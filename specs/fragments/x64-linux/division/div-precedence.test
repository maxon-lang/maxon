// Test: div-precedence
function main() returns ExitCode
	return 10 + 20 / 4
end 'main'
---
ExitCode: 15
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 20
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 62
    x64.leaRegRegImm32 rax, rax, 20
    x64.sarRegImm8 rax, rax, 2
    x64.leaRegRegImm32 r8, rax, 10
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
