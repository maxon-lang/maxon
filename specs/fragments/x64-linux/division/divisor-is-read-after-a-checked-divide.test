// Test: divisor-is-read-after-a-checked-divide
function opaque(x Integer) returns Integer
	return x
end 'opaque'

function main() returns ExitCode
	let d = opaque(7)
	let z = opaque(0)
	let q = try (100 / d) otherwise 99
	let r = try (100 / z) otherwise 0
	return (q + d + r + z) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 21
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_cont:
    x64.movRegImm32 rcx, 100
    x64.movRegImm rax, 5270498306774157605
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rcx, rdx, rax
  trycont#3:
    x64.movRegImm32 rax, 100
    x64.movRegImm32 rsi, 1
    x64.cqo
    x64.idivReg rsi
  trycont#6:
    x64.leaRegRegImm32 r8, rcx, 7
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at divisor-is-read-after-a-checked-divide.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
