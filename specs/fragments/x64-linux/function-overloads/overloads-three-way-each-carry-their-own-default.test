// Test: overloads-three-way-each-carry-their-own-default
typealias Integer = int(i64.min to i64.max)

function tag(value Integer, mark String = "a") returns Integer
	return value + (mark.count() as Integer)
end 'tag'

function tag(value String, mark String = "bb") returns Integer
	return value.count() + mark.count()
end 'tag'

function tag(value bool, mark String = "ccc") returns Integer
	if value 'yes'
		return mark.count()
	end 'yes'
	return 0
end 'tag'

function main() returns ExitCode
	return (tag(1) + tag("xy") + tag(true)) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
  __il_body#10:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "a"
    x64.callDirect __str_retain
    x64.movRegReg rbx, r8
  __il_body#11:
    x64.movRegReg rcx, rbx
    x64.callDirect String.count
    x64.leaRegRegImm32 r12, r8, 1
  __il_cont#8:
    x64.leaRegRdata r13, [rip + __str_rec_4]  ; "xy"
  __il_body#12:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "bb"
    x64.callDirect __str_retain
    x64.movRegReg r14, r8
  __il_body#13:
    x64.movRegReg rcx, r13
    x64.callDirect String.count
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r14
    x64.callDirect String.count
    x64.leaRegRegReg rax, r13, r8
  __il_cont#6:
    x64.leaRegRegReg r12, r12, rax
  __il_body#14:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "ccc"
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
  yes:
    x64.movRegReg rcx, r13
    x64.callDirect String.count
  __il_cont#4:
    x64.leaRegRegReg r12, r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_20]  ; "panic at overloads-three-way-each-carry-their-own-default.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
