// Test: folded-and-unfolded-agree
// --- stdlib-overlay: Builtins.maxon
export typealias WrittenBytes = int(0 to u64.max)

export function writeFolded(text String) returns WrittenBytes
	return __Builtins.writeStdout(text.addressableBytes())
end 'writeFolded'

export function writeThroughABinding(text String) returns WrittenBytes
	let bytes = text.addressableBytes()
	return __Builtins.writeStdout(bytes)
end 'writeThroughABinding'
// --- file: main.maxon
function main() returns ExitCode
	let a = writeFolded("ab\n")
	let b = writeThroughABinding("cde\n")
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "ab\x0a"
  __il_body#5:
    x64.callDirect __write_stdout
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#7
  __il_cont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "cde\x0a"
  __il_body#13:
    x64.callDirect __str_bytes_view
    x64.movRegReg r12, r8
  __il_cont#12:
    x64.movRegReg rcx, r12
    x64.callDirect __write_stdout
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic#11
  __il_cont#8:
    x64.leaRegRegReg r8, rbx, r13
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#2
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at Builtins.maxon:4: Range check failed: value outside typealias 'WrittenBytes'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#11:
    x64.leaRegRdata rcx, [rip + __str_blob_7]  ; "panic at Builtins.maxon:9: Range check failed: value outside typealias 'WrittenBytes'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
