// Test: min.fractional
function main() returns ExitCode
	let x = min(3.5, 5.2)
	// min of 3.5 and 5.2 is 3.5, trunc gives 3
	return trunc(x)
end 'main'
---
ExitCode: 3
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 3
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
