// Test: module-enum-stays-scalar
enum Color
	red
	green
end 'Color'

var c = Color.red

function seed()
	c = Color.green
end 'seed'

function main() returns ExitCode
	seed()
	return match c 'm'
		red gives 0
		green gives 7
	end 'm'
end 'main'
---
ExitCode: 7
---
data {
  __data_c@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_c
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_cont:
    x64.leaRegGlobal rax, __data_c
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
  matchdead:
}
