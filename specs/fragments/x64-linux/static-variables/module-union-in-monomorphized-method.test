// Test: module-union-in-monomorphized-method
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.unowned

type Cell uses T
	export var item as T

	static function create(item T) returns Self
		return Self{item: item}
	end 'create'

	function stash(v Small)
		hold = Hold.owned(v)
	end 'stash'

	function readBack() returns Small
		return match hold 'r'
			unowned gives 0
			owned(v) gives v
		end 'r'
	end 'readBack'
end 'Cell'

typealias SmallCell = Cell with Small

function main() returns ExitCode
	let c = SmallCell.create(1)
	c.stash(5)
	return c.readBack()
end 'main'
---
ExitCode: 5
---
data {
  __data_hold@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __il_body#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#3:
    x64.movRegImm32 rbx, 5
  __rc_ok:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.leaRegGlobal rax, __data_hold
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_decref
    x64.leaRegGlobal rax, __data_hold
    x64.storeBaseDispReg.word64 [rax + 0], r13
  __il_body#9:
    x64.leaRegGlobal rax, __data_hold
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#10:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#11:
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
  matchcont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 100
    x64.jcc greater, __rc_panic
  __il_cont#1:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at module-union-in-monomorphized-method.test:23: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
