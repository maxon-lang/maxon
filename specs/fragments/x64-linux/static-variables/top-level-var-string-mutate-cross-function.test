// Test: top-level-var-string-mutate-cross-function
var msg = "hi"

function bump()
	msg.append("!")
end 'bump'

function main() returns ExitCode
	bump()
	bump()
	print(msg)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_msg@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegGlobal rax, __data_msg
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.leaRegRdata r12, [rip + __str_rec_2]  ; "!"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
  __il_body:
    x64.movRegReg rcx, r12
    x64.callDirect __str_bytes_view
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __managed_append
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.loadRegBaseDisp.byte rax, [r12 + 48]
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont
  clearFlag:
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.byte [rbx + 48], rax
  __il_cont:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect bump
    x64.callDirect bump
    x64.leaRegGlobal rax, __data_msg
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.movRegReg r12, r8
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
