// Test: a-declared-hash-beats-the-synthesized-impl
extension int implements Hashable
	function hash() returns HashValue
		return 77
	end 'hash'
end 'int'

function main() returns ExitCode
	let n = 5
	return n.hash()
end 'main'
---
ExitCode: 77
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 77
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
