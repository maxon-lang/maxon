// Test: self-in-return-position-on-a-primitive-extension
extension int
	export function twin() returns Self
		return self + 1
	end 'twin'
end 'int'

function main() returns ExitCode
	let n = 40
	return n.twin().twin() as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
