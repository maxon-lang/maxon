// Test: le-boundary-equal
function main() returns ExitCode
	var r = 7
	let x = 4.25
	let y = 4.25
	if x <= y 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
