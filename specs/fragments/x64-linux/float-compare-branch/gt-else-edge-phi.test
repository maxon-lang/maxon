// Test: gt-else-edge-phi
function main() returns ExitCode
	var r = 7
	let x = 3.5
	let y = 9.5
	if x > y 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
