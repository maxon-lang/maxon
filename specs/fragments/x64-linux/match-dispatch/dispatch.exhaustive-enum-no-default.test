// Test: dispatch.exhaustive-enum-no-default
enum Color
	red
	green
	blue
	cyan
	magenta
	yellow
end 'Color'

function idx(c Color) returns ExitCode
	return match c 'm'
		red gives 1
		green gives 2
		blue gives 3
		cyan gives 4
		magenta gives 5
		yellow gives 6
	end 'm'
end 'idx'

function main() returns ExitCode
	var n = 0 as ExitCode
	if idx(Color.red) == 1 'a'
		n = n + 1
	end 'a'
	if idx(Color.green) == 2 'b'
		n = n + 1
	end 'b'
	if idx(Color.blue) == 3 'c'
		n = n + 1
	end 'c'
	if idx(Color.cyan) == 4 'd'
		n = n + 1
	end 'd'
	if idx(Color.magenta) == 5 'e'
		n = n + 1
	end 'e'
	if idx(Color.yellow) == 6 'f'
		n = n + 1
	end 'f'
	return n
end 'main'
