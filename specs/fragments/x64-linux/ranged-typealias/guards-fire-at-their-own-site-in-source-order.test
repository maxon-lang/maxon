// Test: guards-fire-at-their-own-site-in-source-order
typealias Small = int(0 to 10)
typealias Wide = int(0 to 100000)

function widen(n Wide) returns Wide
	return n + 1
end 'widen'

function main() returns ExitCode
	let a = widen(1)
	let b = widen(2)
	let c = widen(5000)
	print("start\n")
	let x = a as Small
	print("after-x\n")
	let y = b as Small
	print("after-y\n")
	let z = c as Small
	print("after-z\n")
	return x + y + z
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __rc_ok#17:
    x64.movRegImm32 rbx, 2
  __rc_ok#23:
    x64.movRegImm32 r12, 3
  __rc_ok#29:
    x64.movRegImm32 r13, 5001
  __il_cont:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "start\x0a"
    x64.callDirect print
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rbx, 10
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_10]  ; "panic at guards-fire-at-their-own-site-in-source-order.test:14: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "after-x\x0a"
    x64.callDirect print
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 r12, 10
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_11]  ; "panic at guards-fire-at-their-own-site-in-source-order.test:16: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "after-y\x0a"
    x64.callDirect print
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic#8
  __rc_chk#9:
    x64.cmpRegImm32 r13, 10
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_12]  ; "panic at guards-fire-at-their-own-site-in-source-order.test:18: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "after-z\x0a"
    x64.callDirect print
    x64.leaRegRegReg rax, rbx, r12
    x64.leaRegRegReg r8, rax, r13
