// Test: overloaded-generic-method-is-not-range-checked
typealias Byte = int(0 to 255)
typealias BA = Array with Byte

function main() returns ExitCode
	var a = BA.create()
	a.push(3)
	a.push(4)
	var needle = BA.create()
	needle.push(4)
	if a.contains(needle) 'has'
		return 7
	end 'has'
	return 9
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.leaRegRdata rax, [rip + __layout_Array_Byte]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Array.contains#struct
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  has:
    x64.movRegImm32 r13, 7
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 9
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
