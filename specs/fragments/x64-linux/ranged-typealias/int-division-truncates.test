// Test: int-division-truncates
function main() returns ExitCode
	let a = 7
	let b = 2
	return a / b
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 7
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 r8, rax, 7
    x64.sarRegImm8 r8, r8, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
