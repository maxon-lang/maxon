// Test: range-id-arithmetic
function main() returns ExitCode
	let x = u8.max + 1
	return x - 206
end 'main'
---
ExitCode: 50
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 50
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
