// Test: range-id-assign
function main() returns ExitCode
	let x = u16.max
	return x - 65500
end 'main'
---
ExitCode: 35
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 35
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
