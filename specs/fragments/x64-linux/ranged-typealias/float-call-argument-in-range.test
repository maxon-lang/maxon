// Test: float-call-argument-in-range
typealias Pct = float(0.0 to 100.0)

function take(p Pct) returns Pct
	return p
end 'take'

function main() returns ExitCode
	return trunc(take(42.5))
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
