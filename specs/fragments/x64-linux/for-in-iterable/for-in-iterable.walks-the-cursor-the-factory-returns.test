// Test: for-in-iterable.walks-the-cursor-the-factory-returns
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type IntCursor
	var items as IntArray
	var pos as Integer

	export static function create(items IntArray) returns Self throws IterationError
		if items.count() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{items: items, pos: 0}
	end 'create'

	export function current() returns Integer
		return try self.items.get(self.pos) otherwise panic("oob")
	end 'current'

	export function advance() throws IterationError
		if self.pos + 1 >= self.items.count() 'atEnd'
			throw IterationError.exhausted
		end 'atEnd'
		self.pos = self.pos + 1
	end 'advance'
end 'IntCursor'

type IntSeq
	var items as IntArray

	export static function create(items IntArray) returns Self
		return Self{items: items}
	end 'create'

	export function createIterator() returns IntCursor throws IterationError
		return try IntCursor.create(self.items)
	end 'createIterator'
end 'IntSeq'

function main() returns ExitCode
	var a = IntArray.create()
	a.push(10)
	a.push(20)
	a.push(30)
	let s = IntSeq.create(a)
	var sum = 0
	for v in s 'each'
		sum = sum + v
	end 'each'
	return sum
end 'main'
---
ExitCode: 60
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @IntCursor.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont
  empty:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @IntCursor.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at for-in-iterable.walks-the-cursor-the-factory-returns.test:17: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegBaseDisp.word64 rcx, [rax + 8]
    x64.cmpRegReg rdx, rcx
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.loadRegBaseIndexScale.word64 r8, [rcx + rdx*8 + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rax + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#9
  __im_empty:
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#10
  __im_slow:
    x64.movRegReg rcx, rax
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#10:
    x64.movRegReg r10, rcx
    x64.jmp __im_cont
  critsplit#9:
    x64.movRegReg r10, rcx
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at for-in-iterable.walks-the-cursor-the-factory-returns.test:17: oob\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @IntCursor.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.leaRegRegImm32 rax, rax, 1
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 8]
    x64.cmpRegReg rax, rdx
    x64.jcc less, ifcont
  atEnd:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rcx + 8], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

