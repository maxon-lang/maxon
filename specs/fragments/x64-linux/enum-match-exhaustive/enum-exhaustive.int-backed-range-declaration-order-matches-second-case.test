// Test: enum-exhaustive.int-backed-range-declaration-order-matches-second-case
enum Code
	ok = 500
	notFound = 200
	serverError = 404
end 'Code'

function classify(c Code) returns ExitCode
	let r = match c 'm'
		ok or
			notFound gives 41
		serverError gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Code.notFound)
end 'main'
---
ExitCode: 41
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 41
  __il_cont:
    x64.popReg rbp
    x64.ret
}
