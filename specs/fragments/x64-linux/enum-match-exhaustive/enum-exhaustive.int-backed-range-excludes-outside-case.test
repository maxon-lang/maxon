// Test: enum-exhaustive.int-backed-range-excludes-outside-case
enum Level
	low = 10
	medium = 20
	high = 30
end 'Level'

function classify(l Level) returns ExitCode
	let r = match l 'm'
		low or
			medium gives 41
		high gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Level.high)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 42
  __il_cont:
    x64.popReg rbp
    x64.ret
}
