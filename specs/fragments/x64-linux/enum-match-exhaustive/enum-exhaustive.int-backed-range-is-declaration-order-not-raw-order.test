// Test: enum-exhaustive.int-backed-range-is-declaration-order-not-raw-order
enum Code
	ok = 500
	notFound = 200
	serverError = 404
end 'Code'

function classify(c Code) returns ExitCode
	let r = match c 'm'
		ok or
			notFound gives 41
		serverError gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Code.serverError)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 42
  __il_cont:
    x64.popReg rbp
    x64.ret
}
