// Test: cross-file-shadowed-union
// --- file: ops.maxon
export union BigOp
	condBr
	br
	cmp
	call
	ret
end 'BigOp'

export union SmallOp
	condBr
	br
end 'SmallOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op SmallOp) returns Code
	return match op 'check'
		condBr gives 1
		br gives 2
	end 'check'
end 'classify'

function describeBig(op BigOp) returns Code
	return match op 'check'
		condBr gives 10
		br gives 20
		cmp gives 30
		call gives 40
		ret gives 50
	end 'check'
end 'describeBig'

function main() returns ExitCode
	let small = classify(SmallOp.br)
	let big = describeBig(BigOp.cmp)
	if big == 30 'bigOk'
		return small
	end 'bigOk'
	return 99
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm#7:
    x64.movRegImm32 r8, 2
  __il_cont#4:
    x64.movRegImm32 rax, 2
  __il_body:
    x64.jumpTable rax, default=matchdead [[0]=matcharm#15, [1]=matcharm#16, [2]=matcharm#17, [3]=matcharm#18, [4]=matcharm#19] @__jumptable_2
  matchdead:
  matcharm#15:
    x64.movRegImm32 rax, 10
    x64.jmp __il_cont#3
  matcharm#16:
    x64.movRegImm32 rax, 20
    x64.jmp __il_cont#3
  matcharm#17:
    x64.movRegImm32 rax, 30
    x64.jmp __il_cont#3
  matcharm#18:
    x64.movRegImm32 rax, 40
    x64.jmp __il_cont#3
  matcharm#19:
    x64.movRegImm32 rax, 50
  __il_cont#3:
    x64.cmpRegImm32 rax, 30
    x64.jcc notEqual, ifcont
  bigOk:
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
