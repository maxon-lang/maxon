// Test: enum-exhaustive.trailing-fallthrough
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	var x = 0
	let c = Color.blue
	match c 'check'
		red then x = 1
		green then x = 2
		blue then x = 3 and fallthrough
	end 'check'
	return x
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 3
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
