// Test: condition-form-try-over-a-substituted-return-whose-receiver-is-a-fork-temporary
typealias Integer = int(0 to 125)
enum Boom implements Error
	bad
end 'Boom'
type Alpha
	export var a as Integer
	export static function create(v Integer) returns Self
		return Self{a: v}
	end 'create'
end 'Alpha'
type Box uses T
	export var value as T
	export var fail as bool
	export static function create(v T, f bool) returns Self
		return Self{value: v, fail: f}
	end 'create'
	export function fetch() returns T throws Boom
		if self.fail 'boom'
			throw Boom.bad
		end 'boom'
		return self.value
	end 'fetch'
end 'Box'
typealias AlphaBox = Box with Alpha
function make(f bool) returns AlphaBox
	return AlphaBox.create(Alpha.create(11), f: f)
end 'make'
function forkTemp(f bool) returns Integer
	if let got = try make(f).fetch() 'ok'
		return got.a
	end 'ok' else 'bad'
		return 1
	end 'bad'
end 'forkTemp'
function main() returns ExitCode
	print("ok={forkTemp(false)} err={forkTemp(true)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Box.fetch {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.byte rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  boom:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @forkTemp {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
  __il_body#5:
    x64.movRegImm32 r12, 11
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
  __il_cont#7:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_own
    x64.movRegReg r12, r8
  __il_body#12:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], r12
    x64.storeBaseDispReg.byte [r14 + 8], rbx
  __il_cont#6:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  __il_cont#4:
    x64.leaRegRdata rdx, [rip + __layout_Box_Alpha]
    x64.movRegReg rcx, r14
    x64.callDirect Box.fetch
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, ifelse
  ok:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Box_Alpha
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Box_Alpha
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "ok="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
    x64.movRegImm32 rcx, 0
    x64.callDirect forkTemp
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot6, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __uint_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; " err="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot5, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 1
    x64.callDirect forkTemp
    x64.movRegReg r14, r8
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r15
    x64.callDirect __uint_to_string
    x64.storeSlotReg slot4, r8
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "\x0a"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot3, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot2, rax
    x64.leaRegRegReg rcx, rbx, r12
    x64.leaRegRegReg rcx, rcx, r13
    x64.leaRegRegReg rcx, rcx, r8
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot0, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot1, r8
    x64.leaRegRegImm32 r14, r8, 56
    x64.loadRegSlot rdx, slot7
    x64.movRegReg rcx, r14
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r14, rbx
    x64.loadRegSlot rdx, slot6
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r12
    x64.loadRegSlot rdx, slot5
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.loadRegSlot rax, slot4
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect __str_copy
    x64.loadRegSlot rax, slot4
    x64.leaRegRegReg rbx, rbx, rax
    x64.loadRegSlot rax, slot2
    x64.loadRegSlot rdx, slot3
    x64.movRegReg rcx, rbx
    x64.callDirect __str_copy
    x64.loadRegSlot rax, slot2
    x64.leaRegRegReg rax, rbx, rax
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rax + 0], r14
    x64.loadRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.loadRegSlot rcx, slot6
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
  __il_body:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __write_stdout
  __il_cont:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
