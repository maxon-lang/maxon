// Test: generic-managed-return-drops-once
typealias Integer = int(i64.min to i64.max)
type Alpha
	export var a as Integer
	export static function create(a Integer) returns Self
		return Self{a: a}
	end 'create'
end 'Alpha'
type Box uses T
	export var tag as Integer
	export static function create() returns Self
		return Self{tag: 0}
	end 'create'
	export function echo(v T) returns T
		return v
	end 'echo'
end 'Box'
typealias AlphaBox = Box with Alpha
function main() returns ExitCode
	var bx = AlphaBox.create()
	var i = 0
	var total = 0
	while i < 100 'loop'
		let back = bx.echo(Alpha.create(i))
		total = total + back.a
		i = i + 1
	end 'loop'
	return total - 4950
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
  __il_body#8:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#7:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r13, 0
    x64.jmp whilehdr
  __il_body#11:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], rbx
  __il_cont#10:
    x64.leaRegRdata rcx, [rip + __layout_Box_Alpha]
  __il_body#12:
    x64.movRegReg rdx, r14
    x64.callDirect __retain_type_param
    x64.movRegReg r15, r8
  __il_cont#9:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.loadRegBaseDisp.word64 rax, [r15 + 0]
    x64.leaRegRegReg r13, r13, rax
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
  whilehdr:
    x64.cmpRegImm32 rbx, 100
    x64.jcc less, __il_body#11
  whileexit:
    x64.leaRegRegImm32 rbx, r13, -4950
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at generic-managed-return-drops-once.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
