// Test: scalar-double-store
typealias Integer = int(i64.min to i64.max)
type IntPair
	export var a as Integer
	export var b as Integer
	export static function create(n Integer) returns Self
		return Self{a: n, b: n}
	end 'create'
end 'IntPair'
function main() returns ExitCode
	let p = IntPair.create(7)
	return p.a - 7
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 7
  __il_cont:
    x64.leaRegRegImm32 r8, rax, -7
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at scalar-double-store.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
