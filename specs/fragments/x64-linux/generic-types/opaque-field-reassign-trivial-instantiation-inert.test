// Test: opaque-field-reassign-trivial-instantiation-inert
type Box uses Element
	export var saved as Element
	export static function create(first Element) returns Self
		return Self{ saved: first }
	end 'create'
	export function replace(next Element)
		self.saved = next
	end 'replace'
end 'Box'
typealias SmallInt = int(0 to 100)
typealias IntBox = Box with SmallInt
function main() returns ExitCode
	var b = IntBox.create(7)
	b.replace(9)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 7
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 9
  __il_body:
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
