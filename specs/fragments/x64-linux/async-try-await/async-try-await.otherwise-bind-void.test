func @maySetFlag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
  __il_body:
    x64.callDirect __gt_resched
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_flag
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r10, 2
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

