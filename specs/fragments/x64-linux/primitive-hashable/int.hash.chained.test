// Test: int.hash.chained
function main() returns ExitCode
	let i = 42
	let once = i.hash()
	let twice = i.hash().hash()
	if once != twice 'chainDiffers'
		return 1
	end 'chainDiffers'
	if not once.equals(42) 'hashValueEquals'
		return 2
	end 'hashValueEquals'
	match once.compare(41) 'cmp'
		lessThan then return 3
		equalTo then return 4
		greaterThan then return 0
	end 'cmp'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
  __il_cont:
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
  hashValueEquals:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matcharm:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
