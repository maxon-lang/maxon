// Test: float.hash.negative
function main() returns ExitCode
	let pos = 3.14
	let neg = -3.14
	if neg.hash() == pos.hash() 'signLost'
		return 1
	end 'signLost'
	if neg.hash() != 2447547303 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
