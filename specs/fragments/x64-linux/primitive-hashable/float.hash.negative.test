// Test: float.hash.negative
function main() returns ExitCode
	let pos = 3.14
	let neg = -3.14
	if neg.hash() != pos.hash() 'signMasked'
		return 1
	end 'signMasked'
	if neg.hash() != 1374389535 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
