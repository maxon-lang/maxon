// Test: named-args-out-of-order
typealias Num = int(0 to 100)

function pick(a Num, b String, c bool) returns Num
	if c 'isTrue'
		return a
	end 'isTrue'
	return b.byteLength() as Num
end 'pick'

function main() returns ExitCode
	return pick(1, c: true, b: "longer")
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; "longer"
  __il_cont:
    x64.popReg rbp
    x64.ret
}
