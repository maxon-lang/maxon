  k:
    x64.leaRegRdata rcx, [rip + __str_rec_20]  ; "insertion-fired\x0a"
    x64.callDirect print
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_21]  ; "insertion-MISSING\x0a"
    x64.callDirect print
