// Test: small-sort-dispatch-n2
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	a.push(2)
	a.push(1)
	Log.startCapture()
	a.sort(ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "smallSort.network") 'n'
		print("network ")
	end 'n'
	if not Log.fired(keys, key: "smallSort.insertion") 'noi'
		print("no-insertion ")
	end 'noi'
	for x in a 'p'
		print("{x} ")
	end 'p'
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc lessEqual, ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.callDirect Log.startCapture
    x64.leaRegFunc rdx, [rip + __fnref_ascending]
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Array_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.sort#Array.SortComparator
    x64.callDirect Log.stopCapture
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.leaRegRdata rdx, [rip + __str_rec_21]  ; "smallSort.network"
    x64.movRegReg rcx, r12
    x64.callDirect Log.fired
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  n:
    x64.leaRegRdata rcx, [rip + __str_rec_22]  ; "network "
    x64.callDirect print
  ifcont#2:
    x64.leaRegRdata rdx, [rip + __str_rec_23]  ; "smallSort.insertion"
    x64.movRegReg rcx, r12
    x64.callDirect Log.fired
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  noi:
    x64.leaRegRdata rcx, [rip + __str_rec_24]  ; "no-insertion "
    x64.callDirect print
  ifcont#4:
    x64.movRegImm32 rax, 0
  forhdr:
    x64.storeSlotReg slot1, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  p:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r12, [rcx + rax*8 + 0]
  __im_cont:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot2, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_25]  ; " "
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot5, rax
    x64.leaRegRegReg rax, r12, rax
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.loadRegSlot r13, slot5
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot4
    x64.storeBaseDispReg.word64 [r12 + 0], r15
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.loadRegSlot rcx, slot2
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
  forstep:
    x64.loadRegSlot rax, slot1
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.leaRegRdata rcx, [rip + __str_rec_26]  ; "\x0a"
    x64.callDirect print
    x64.movRegImm32 r12, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
