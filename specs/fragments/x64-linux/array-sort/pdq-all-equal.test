// Test: pdq-all-equal
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	for _ in 0 upto 35 'fill'
		a.push(7)
	end 'fill'
	Log.startCapture()
	a.sortUnstable(ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "pdq.equalElements") 'e'
		print("equal-path-fired\n")
	end 'e'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc lessEqual, ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}

