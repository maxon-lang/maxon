    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  fill:
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 35
    x64.jcc less, fill
  __il_body#10:
    x64.leaRegGlobal rax, __data_captured
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect Array.clear
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_capturing
    x64.storeBaseDispReg.byte [rcx + 0], rax
  __il_cont#9:
    x64.leaRegFunc r9, [rip + __fnref_ascending]
    x64.movRegImm32 rsi, 0
    x64.leaRegRdata rdi, [rip + __layout_Array_Integer]
  __il_body#11:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.pdqsortRange
  __il_body#23:
    x64.movRegImm32 rax, 0
    x64.leaRegGlobal rcx, __data_capturing
    x64.storeBaseDispReg.byte [rcx + 0], rax
    x64.leaRegGlobal rax, __data_captured
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.movRegReg r13, r8
    x64.leaRegRdata r9, [rip + __layout_Array_String]
  __il_body#25:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
