// Test: driftsort-large-sqrt-cross-check
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	var b = IntArray.create()
	var r = 2463534242
	for i in 0 upto 5000 'fill'
		r = (r * 1103515245 + 12345) and 0x7FFFFFFF
		let v = r and 0xFFFF
		a.push(v)
		b.push(v)
	end 'fill'
	a.sort(ascending)
	b.referenceMergeSort(ascending)
	var equal = a.count() == b.count()
	if equal 'check'
		for i in 0 upto a.count() 'walk'
			let av = try a.get(i) otherwise return 99
			let bv = try b.get(i) otherwise return 99
			if av != bv 'diff'
				equal = false
			end 'diff'
		end 'walk'
	end 'check'
	if equal 'eq'
		print("equal\n")
	end 'eq' else 'ne'
		print("diverged\n")
	end 'ne'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc lessEqual, ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 2463534242
    x64.movRegImm32 r13, 0
    x64.jmp forhdr#1
  fill:
    x64.imulRegRegImm32 rax, rax, 1103515245
    x64.leaRegRegImm32 r14, rax, 12345
    x64.andRegImm32 r14, r14, 2147483647
    x64.movRegReg r15, r14
    x64.andRegImm32 r15, r14, 65535
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rax, r14
  forhdr#1:
    x64.cmpRegImm32 r13, 5000
    x64.jcc less, fill
  forexit:
    x64.leaRegFunc r9, [rip + __fnref_ascending]
    x64.movRegImm32 rsi, 0
    x64.leaRegRdata rdi, [rip + __layout_Array_Integer]
  __il_body#27:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.driftsortRange
  __il_cont#26:
    x64.leaRegFunc r9, [rip + __fnref_ascending]
    x64.movRegImm32 rsi, 0
    x64.leaRegRdata rdi, [rip + __layout_Array_Integer]
  __il_body#29:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.movRegReg rcx, r12
    x64.callDirect Array.mergeSortRange
  __il_cont#28:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.loadRegBaseDisp.word64 rcx, [r12 + 8]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rax
    x64.jcc notEqual, ifcont#16
  check:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rsi, [r12 + 8]
    x64.loadRegBaseDisp.word64 rdi, [r12 + 0]
    x64.loadRegBaseDisp.word64 r8, [rbx + 0]
    x64.jmp forhdr#6
  __im_load#22:
    x64.loadRegBaseIndexScale.word64 r9, [r8 + rdx*8 + 0]
  tryok#10:
    x64.cmpRegReg rdx, rsi
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load#25
  tryerr:
    x64.movRegImm32 r13, 99
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_load#25:
    x64.loadRegBaseIndexScale.word64 r10, [rdi + rdx*8 + 0]
    x64.movRegReg r11, r10
  tryok#12:
    x64.cmpRegReg r9, r11
    x64.jcc equal, forstep#8
  diff:
    x64.movRegImm32 rax, 0
  forstep#8:
    x64.leaRegRegImm32 rdx, rdx, 1
  forhdr#6:
    x64.cmpRegReg rdx, rcx
