    x64.callDirect print
    x64.jmp ifcont#19
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_22]  ; "diverged\x0a"
    x64.callDirect print
  ifcont#19:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
