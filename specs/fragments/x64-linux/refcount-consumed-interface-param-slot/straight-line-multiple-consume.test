    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.run
    x64.leaRegRegReg rax, r14, r8
    x64.leaRegRegImm32 r14, rax, 4
    x64.movRegReg rcx, rbx
