// Test: a-byte-vector-at-constant-indexes
typealias Byte = int(0 to u8.max)
typealias ByteVec4 = Vector with 4 Byte

function main() returns ExitCode
	var v = ByteVec4.create()
	try v.set(0, value: 200) otherwise panic("test invariant: set OOB")
	try v.set(3, value: 55) otherwise panic("test invariant: set OOB")
	let a = try v.get(0) otherwise 0
	let b = try v.get(3) otherwise 0
	return a - b
end 'main'
---
ExitCode: 145
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __layout_Vector_N4_Byte]
    x64.movRegImm32 rbx, 4
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
  __il_cont:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 200
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Byte]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, r12
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
  tryok#1:
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 55
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Byte]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, r12
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
  tryok#3:
    x64.movRegImm32 rdx, 0
    x64.leaRegRdata rax, [rip + __layout_Vector_N4_Byte]
    x64.movRegReg rcx, r12
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#7
  tryok#5:
    x64.movRegReg rbx, r8
  trycont#7:
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __layout_Vector_N4_Byte]
    x64.movRegReg rcx, r12
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#8
  tryerr#9:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#10
  tryok#8:
    x64.movRegReg rax, r8
  trycont#10:
    x64.subRegReg rbx, rbx, rax
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-byte-vector-at-constant-indexes.test:7: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#4:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-byte-vector-at-constant-indexes.test:8: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-byte-vector-at-constant-indexes.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
