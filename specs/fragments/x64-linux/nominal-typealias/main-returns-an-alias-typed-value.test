// Test: main-returns-an-alias-typed-value
typealias Score = int(0 to 100)

function main() returns ExitCode
	let s = 7 as Score
	return s
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
