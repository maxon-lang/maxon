// Test: a-mixed-expression-into-an-overload-is-guarded-at-the-call
typealias Small = int(0 to 10)
typealias BlockId = int(0 to 10) implements Small
typealias VarId = int(0 to 10) implements Small

function show(b BlockId) returns String
	return "block {b}"
end 'show'

function show(s String) returns String
	return s
end 'show'

function main() returns ExitCode
	let block = 8 as BlockId
	let varId = 5 as VarId
	print(show(block + varId))
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-mixed-expression-into-an-overload-is-guarded-at-the-call.test:17: Range check failed: value outside typealias 'BlockId'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
