// Test: map-set-with-declared-ranged-alias
typealias Integer = int(i64.min to i64.max)
typealias IntSet = Set with Integer

function main() returns ExitCode
	var s = IntSet.create()
	s.insert(1)
	s.insert(2)
	let t = s.map(function(a Integer) gives a + 1)
	print("{t.count()}\n")
	return 0
end 'main'
