// Test: an-enum-conformer-is-returned-as-the-interface
typealias Integer = int(i64.min to i64.max)

interface Greeter
	function greet() returns Integer
end 'Greeter'

enum Step implements Greeter
	one
	two

	function greet() returns Integer
		return match self 'which'
			one gives 41
			two gives 7
		end 'which'
	end 'greet'
end 'Step'

function make() returns Greeter
	return Step.two
end 'make'

function callGreet(g Greeter) returns Integer
	return g.greet() + 1
end 'callGreet'

function main() returns ExitCode
	let g = make()
	return callGreet(g)
end 'main'
---
ExitCode: 8
---
func @Step.greet {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 41
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 7
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.leaRegRdata r10, [rip + __witness_Step.Greeter]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect make
    x64.movRegReg rbx, r8
    x64.movRegReg r12, r10
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callMem [r12 + 48]
    x64.leaRegRegImm32 r13, r8, 1
  __il_cont:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-enum-conformer-is-returned-as-the-interface.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
