// Test: a-bare-call-to-a-roster-member-takes-the-roster
typealias Num = int(0 to 1000)

type Array uses Element implements BuiltinArrayLiteral
	export typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	static function create() returns Self
		return Self{}
	end 'create'

	function count() returns Num
		return 99 as Num
	end 'count'

	function bareCount() returns Num
		return count()
	end 'bareCount'
end 'Array'

typealias NumArray = Array with Num

function main() returns ExitCode
	var a = NumArray.create()
	a.push(41 as Num)
	a.push(42 as Num)
	a.push(43 as Num)
	return a.bareCount()
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 41
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 43
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  __il_body:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 r12, 1000
    x64.jcc greater, __rc_panic#7
  __rc_chk#3:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-bare-call-to-a-roster-member-takes-the-roster.test:22: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-bare-call-to-a-roster-member-takes-the-roster.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
