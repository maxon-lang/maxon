// Test: a-declared-own-array-value-reaches-a-library-parameter
type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Array'

typealias MyBytes = Array with Byte

function main() returns ExitCode
	var mine = MyBytes.create()
	mine.push(72 as Byte)
	mine.push(105 as Byte)
	mine.push(33 as Byte)
	let s = String.from(mine)
	print(s)
	return s.byteLength() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 72
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 105
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 33
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  __il_body#9:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.movRegReg r13, r8
  __il_body#11:
    x64.loadRegBaseDisp.word64 r14, [r13 + 8]
    x64.movRegImm32 r15, 0
    x64.jmp forhdr
  scan:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.callDirect __managed_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.movRegImm32 rax, 1
    x64.jcc greaterEqual, scmerge
  orrhs:
    x64.cmpRegImm32 r8, 13
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, forstep
  notSingleByte:
    x64.movRegImm32 rdx, 0
    x64.jmp __il_cont#10
  forstep:
    x64.leaRegRegImm32 r15, r15, 1
  forhdr:
    x64.cmpRegReg r15, r14
    x64.jcc less, scan
  forexit:
    x64.movRegImm32 rdx, 1
  __il_cont#10:
    x64.movRegReg rcx, r12
    x64.callDirect __str_of_buffer
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_body#6:
    x64.movRegReg rcx, r14
    x64.callDirect __write_stdout
  __il_body#7:
    x64.loadRegBaseDisp.word64 r12, [r14 + 8]
  __il_cont#4:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at String.maxon:1155: scanSingleByteGraphemes: byteAt OOB \xe2\x80\x94 i < len invariant\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-declared-own-array-value-reaches-a-library-parameter.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
