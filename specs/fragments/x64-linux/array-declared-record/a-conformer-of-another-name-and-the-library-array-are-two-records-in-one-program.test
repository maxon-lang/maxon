// Test: a-conformer-of-another-name-and-the-library-array-are-two-records-in-one-program
type Bag uses Element implements BuiltinArrayLiteral
	export typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	static function create() returns Self
		return Self{}
	end 'create'
end 'Bag'

typealias StringBag = Bag with String

function main() returns ExitCode
	var mine = StringBag.create()
	mine.push("xy")

	var total = mine.count()
	for part in "a,bb,ccc".split(",") 'librarysLoop'
		total = total + part.byteLength()
	end 'librarysLoop'

	return total as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot1, rbx
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "xy"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.storeSlotReg slot0, rax
    x64.leaRegRdata rbx, [rip + __str_rec_4]  ; "a,bb,ccc"
    x64.leaRegRdata r12, [rip + __str_rec_5]  ; ","
  __il_body#10:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.storeSlotReg slot2, r13
  __il_body#24:
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
  __il_cont#23:
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, __il_body#26
  __il_body#20:
    x64.movRegImm32 rdx, 0
  __il_body#28:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#27:
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.callDirect String.sliceBytes
  __il_cont#19:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.jmp __il_cont#9
  __il_body#26:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
  __il_cont#25:
    x64.movRegImm32 r15, 0
    x64.jmp whilehdr
  search:
    x64.movRegReg rax, r13
    x64.subRegReg rax, r13, r15
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg r9, r12
    x64.callDirect findIn
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, whileexit
  try_find:
    x64.leaRegRegReg rax, r15, r8
    x64.storeSlotReg slot3, rax
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.loadRegSlot rax, slot3
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect String.sliceBytes
    x64.loadRegSlot rcx, slot2
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegSlot rax, slot3
    x64.leaRegRegReg rax, rax, r14
  ifcont:
    x64.movRegReg r15, rax
  whilehdr:
    x64.movRegReg rax, r13
    x64.subRegReg rax, r13, r14
    x64.cmpRegReg r15, rax
    x64.jcc lessEqual, search
  whileexit:
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r13
    x64.callDirect String.sliceBytes
    x64.loadRegSlot rcx, slot2
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_cont#9:
    x64.movRegImm32 rax, 0
    x64.loadRegSlot rcx, slot2
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegSlot rbx, slot0
    x64.jmp forhdr
  librarysLoop:
    x64.loadRegBaseIndexScale.word64 rsi, [rcx + rax*8 + 0]
  __il_body#22:
    x64.loadRegBaseDisp.word64 rsi, [rsi + 8]
  __il_cont#21:
    x64.leaRegRegReg rbx, rbx, rsi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegReg rax, rdx
    x64.jcc less, librarysLoop
  forexit:
    x64.loadRegSlot rcx, slot2
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]  ; "panic at a-conformer-of-another-name-and-the-library-array-are-two-records-in-one-program.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
