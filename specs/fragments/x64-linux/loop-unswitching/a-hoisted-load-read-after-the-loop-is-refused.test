// Test: a-hoisted-load-read-after-the-loop-is-refused
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function tally(a WordArray) returns Word
	var t = 0
	var last = 0
	var i = 0
	while true 'l'
		t = t + (try a.get(i) otherwise 0)
		last = a.count()
		if i >= 2 'stop'
			break
		end 'stop'
		i = i + 1
	end 'l'
	return last * 100 + t
end 'tally'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(1)
	a.push(2)
	a.push(3)
	a.push(4)
	a.push(5)
	if tally(a) != 506 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  __il_body:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rdx, 0
  __rc_ok:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg rdx, rcx
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rcx, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rcx + rdx*8 + 0]
    x64.movRegReg r8, rcx
  tryok:
    x64.movRegReg rcx, r8
  trycont:
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegImm32 rdx, 2
    x64.jcc less, ifcont#12
  whileexit:
    x64.imulRegRegImm32 rcx, rcx, 100
    x64.leaRegRegReg rax, rcx, rax
  __il_cont:
    x64.cmpRegImm32 rax, 506
    x64.jcc equal, ifcont#2
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp __rc_ok
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rdx, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
}
