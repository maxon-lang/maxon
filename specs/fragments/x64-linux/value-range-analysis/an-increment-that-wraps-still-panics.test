// Test: an-increment-that-wraps-still-panics
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function main() returns ExitCode
	var a = WordArray.create()
	a.push(9223372036854775807)
	let big = try a.get(0) otherwise 0
	if big <= 0 'small'
		return 2
	end 'small'
	let wrapped = big + 1
	let v = try a.get(wrapped) otherwise 5
	return 3 if v == 5 else 4
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm rdx, 9223372036854775807
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#18
    x64.jmp __im_load#19
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  __im_load#19:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegReg r8, rax
  tryok#1:
    x64.movRegReg rax, r8
  trycont:
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, ifcont
  small:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rdx, rax, 1
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_ok#12:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow#21
  __im_load#22:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + rdx*8 + 0]
    x64.movRegReg r8, rax
  tryok#6:
    x64.cmpRegImm32 r8, 5
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 3
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 4
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __rc_ok#14:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow#18:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-increment-that-wraps-still-panics.test:13: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow#21:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp tryok#6
}
