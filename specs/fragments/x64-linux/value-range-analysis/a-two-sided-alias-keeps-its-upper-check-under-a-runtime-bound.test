// Test: a-two-sided-alias-keeps-its-upper-check-under-a-runtime-bound
typealias Word = int(i64.min to i64.max)
typealias Small = int(0 to 100)
typealias WordArray = Array with Word

function weigh(x Small) returns Word
	return x * 2
end 'weigh'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(150)
	let n = try a.get(0) otherwise 0
	var t = 0
	for i in 0 upto n 'each'
		t = t + weigh(i)
	end 'each'
	return 3 if t == 0 else 4
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @weigh {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 100
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.imulRegRegImm32 r8, rcx, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-two-sided-alias-keeps-its-upper-check-under-a-runtime-bound.test:6: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 150
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegReg r8, rax
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.xchgRegReg rcx, rdx
  forhdr:
    x64.cmpRegReg rcx, rax
    x64.jcc greaterEqual, forexit
  __rc_chk#20:
    x64.cmpRegImm32 rcx, 100
    x64.jcc greater, __il_slow
  __rc_ok#19:
    x64.imulRegRegImm32 rsi, rcx, 2
    x64.movRegReg r8, rsi
  __il_cont:
    x64.leaRegRegReg rdx, rdx, r8
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 3
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 4
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __rc_chk#13:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok#11:
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  __il_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.callDirect weigh
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.jmp __il_cont
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-two-sided-alias-keeps-its-upper-check-under-a-runtime-bound.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
