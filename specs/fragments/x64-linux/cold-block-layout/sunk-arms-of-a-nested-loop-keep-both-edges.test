// Test: sunk-arms-of-a-nested-loop-keep-both-edges
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function grid(a WordArray, rows Word, width Word) returns Word
	var t = 0
	for r in 0 upto rows 'row'
		var line = 0
		for c in 0 upto width 'col'
			line = line + (try a.get(r * width + c) otherwise 100)
		end 'col'
		t = t + line * (r + 1)
	end 'row'
	return t
end 'grid'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 7 'seed'
		a.push(i)
	end 'seed'
	return grid(a, rows: 3, width: 3) - 600
end 'main'
---
ExitCode: 45
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @grid {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 112
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rsi, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.loadRegBaseDisp.word64 r9, [rcx + 0]
  forhdr#1:
    x64.cmpRegReg rsi, rdx
    x64.jcc greaterEqual, forexit#4
  row:
    x64.movRegImm32 r10, 0
    x64.movRegImm32 r11, 0
  forhdr#5:
    x64.cmpRegReg r11, rax
    x64.jcc greaterEqual, forexit#8
  col:
    x64.movRegReg rbx, rsi
    x64.imulRegReg rbx, rsi, rax
    x64.leaRegRegReg rbx, rbx, r11
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_ok:
    x64.cmpRegReg rbx, rdi
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rbx, 100
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 rbx, [r9 + rbx*8 + 0]
  trycont:
    x64.leaRegRegReg r10, r10, rbx
  forstep:
    x64.leaRegRegImm32 r11, r11, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.imulRegReg r10, r10, rsi
    x64.leaRegRegReg r8, r8, r10
    x64.jmp forhdr#1
  forexit#4:
    x64.epilogue 112
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at sunk-arms-of-a-nested-loop-keep-both-edges.test:10: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 112
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.storeSlotReg slot6, r9
    x64.storeSlotReg slot7, r10
    x64.storeSlotReg slot8, r11
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rbx, r8
    x64.movRegReg r12, r10
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.loadRegSlot r9, slot6
    x64.loadRegSlot r10, slot7
    x64.loadRegSlot r11, slot8
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, tryerr
    x64.jmp trycont
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  forhdr:
    x64.cmpRegImm32 r12, 7
    x64.jcc greaterEqual, forexit
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 3
    x64.movRegReg rcx, rbx
    x64.callDirect grid
    x64.leaRegRegImm32 r12, r8, -600
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at sunk-arms-of-a-nested-loop-keep-both-edges.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
