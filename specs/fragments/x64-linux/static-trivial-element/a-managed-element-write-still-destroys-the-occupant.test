    x64.jcc less, __il_body#19
  forexit#8:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegSlot rdx, slot2
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.jmp forhdr#9
  measure:
    x64.loadRegBaseIndexScale.word64 rdi, [rdx + rcx*8 + 0]
  __il_body#28:
    x64.loadRegBaseDisp.word64 rdi, [rdi + 8]
  __il_cont:
    x64.leaRegRegReg rax, rax, rdi
  forstep#11:
