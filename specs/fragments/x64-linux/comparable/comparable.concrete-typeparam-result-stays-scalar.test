// Test: comparable.concrete-typeparam-result-stays-scalar
typealias Integer = int(0 to u32.max)

type Box uses T
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function get() returns T
		return self.item
	end 'get'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	let b = IntBox.create(7)
	let v = b.get()
	if v < 9 'lt'
		return 1
	end 'lt'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 7
  __il_body#5:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#4:
    x64.leaRegRdata rcx, [rip + __layout_Box_Integer]
  __il_body#6:
    x64.loadRegBaseDisp.word64 rdx, [r12 + 0]
    x64.callDirect __retain_type_param
  __il_cont#3:
    x64.cmpRegImm32 r8, 9
    x64.jcc greaterEqual, ifcont
  lt:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
