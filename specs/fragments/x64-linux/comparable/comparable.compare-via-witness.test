// Test: comparable.compare-via-witness
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	function order() returns Integer
		let o = self.a.compare(self.b)
		let r = match o 'check'
			lessThan gives 1
			equalTo gives 2
			greaterThan gives 3
		end 'check'
		return r
	end 'order'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let less = IntPair.create(3, b: 9)
	let same = IntPair.create(7, b: 7)
	let more = IntPair.create(9, b: 3)

	return less.order() * 100 + same.order() * 10 + more.order()
end 'main'
---
ExitCode: 123
---
data {
  __slab_state@0 = i64 0
}

func @Pair.order {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rax, rdx
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rsi
    x64.callMem [rax + 48]
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp __rc_ok
  matchnext#5:
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp __rc_ok
  matchnext#6:
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 r8, 3
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 88
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 9
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.movRegImm32 rax, 7
    x64.movRegImm32 rcx, 7
    x64.leaRegRdata rsi, [rip + __witness_int.Comparable]
    x64.leaRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], rcx
    x64.movRegImm32 rax, 9
    x64.movRegImm32 rcx, 3
    x64.leaRegRdata rsi, [rip + __witness_int.Comparable]
    x64.leaRegSlot r12, slot4
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rcx
    x64.leaRegRdata rax, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect Pair.order
    x64.imulRegRegImm32 r13, r8, 100
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, rbx
    x64.callDirect Pair.order
    x64.imulRegRegImm32 rax, r8, 10
    x64.leaRegRegReg rbx, r13, rax
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, r12
    x64.callDirect Pair.order
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 88
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at comparable.compare-via-witness.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 88
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
