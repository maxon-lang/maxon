// Test: first-class-function.exitcode-param-through-alias
typealias Outcome = int(0 to u32.max)
typealias Bump = function(ExitCode) returns Outcome

function bump(c ExitCode) returns Outcome
	return c + 1
end 'bump'

function applyIt(f Bump, c ExitCode) returns Outcome
	return f(c)
end 'applyIt'

function main() returns ExitCode
	return applyIt(bump, c: 8)
end 'main'
---
ExitCode: 9
---
func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#1:
    x64.leaRegRegImm32 r8, rcx, 1
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.exitcode-param-through-alias.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_bump]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
  __rc_ok#6:
    x64.callReg rax
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok#1:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at first-class-function.exitcode-param-through-alias.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
