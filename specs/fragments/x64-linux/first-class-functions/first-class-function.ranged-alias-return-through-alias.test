// Test: first-class-function.ranged-alias-return-through-alias
typealias Code = int(0 to u32.max)
typealias CodeThunk = function() returns Code

function nine() returns Code
	return 9
end 'nine'

function callThunk(t CodeThunk) returns Code
	return t()
end 'callThunk'

function main() returns ExitCode
	return callThunk(nine)
end 'main'
---
ExitCode: 9
---
func @nine {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 9
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_nine]
    x64.movRegImm32 rcx, 0
  __il_body:
    x64.callReg rax
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.ranged-alias-return-through-alias.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
