// Test: first-class-function.bool-param-through-fnref-thunk
typealias Integer = int(i64.min to i64.max)
typealias BoolFn = function(bool) returns Integer

function takesBool(loud bool) returns Integer
	return 7 if loud else 3
end 'takesBool'

function apply(f BoolFn) returns Integer
	return f(true)
end 'apply'

function main() returns ExitCode
	return apply(takesBool) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @takesBool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 7
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 3
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rdx, [rip + __fnrec_takesBool]
  __il_body:
    x64.movRegImm32 rcx, 1
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.callReg rax
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.bool-param-through-fnref-thunk.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
