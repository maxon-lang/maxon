// Test: first-class-function.matching-enum-shape-agrees-across-doors

enum Color
	red
	green
	blue
end 'Color'

typealias ColorFn = function(Color) returns Color

union Holder
	held(f ColorFn)
	empty
end 'Holder'

function next(c Color) returns Color
	match c 'k'
		red then return Color.green
		green then return Color.blue
		blue then return Color.red
	end 'k'
end 'next'

function pick() returns ColorFn
	return next
end 'pick'

function callThrough(f ColorFn) returns Color
	return f(Color.red)
end 'callThrough'

function callPayload(h Holder) returns Color
	return match h 'm'
		held(f) gives f(Color.green)
		empty gives Color.red
	end 'm'
end 'callPayload'

function show(c Color)
	match c 'k'
		red then print("red\n")
		green then print("green\n")
		blue then print("blue\n")
	end 'k'
end 'show'

function main() returns ExitCode
	show(callThrough(next))
	show(callPayload(Holder.held(next)))
	show(pick()(Color.blue))
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __slab_state@0 = i64 0
}

func @next {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @show {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "red\x0a"
    x64.callDirect print
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "green\x0a"
    x64.callDirect print
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "blue\x0a"
    x64.callDirect print
  matchcont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_next]
    x64.movRegImm32 rdx, 0
  __il_body#4:
    x64.movRegImm32 rcx, 0
    x64.callReg rax
  __il_cont#3:
    x64.movRegReg rcx, r8
    x64.callDirect show
    x64.leaRegFunc rax, [rip + __fnref_next]
    x64.movRegImm32 rcx, 0
  __il_body#5:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#6:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callReg rax
    x64.movRegReg rcx, r8
    x64.jmp __il_cont#2
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#7:
    x64.movRegImm32 rcx, 0
  __il_cont#2:
    x64.callDirect show
  __il_body#11:
    x64.leaRegFunc rax, [rip + __fnref_next]
  __il_cont#1:
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callReg rax
    x64.movRegReg rcx, r8
    x64.callDirect show
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
