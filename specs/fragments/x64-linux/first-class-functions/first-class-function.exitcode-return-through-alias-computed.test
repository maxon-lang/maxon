// Test: first-class-function.exitcode-return-through-alias-computed
typealias Thunk = function() returns ExitCode

function four() returns ExitCode
	return 4
end 'four'

function twice(t Thunk) returns ExitCode
	let v = t()
	return v + v + 1
end 'twice'

function main() returns ExitCode
	return twice(four)
end 'main'
---
ExitCode: 9
---
func @four {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_four]
    x64.movRegImm32 rcx, 0
  __il_body:
    x64.callReg rax
    x64.leaRegRegReg rax, r8, r8
    x64.leaRegRegImm32 r8, rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.exitcode-return-through-alias-computed.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
