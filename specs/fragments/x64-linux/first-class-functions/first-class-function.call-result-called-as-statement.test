// Test: first-class-function.call-result-called-as-statement
var sideEffect = 0

typealias Task = function()

function bump()
	sideEffect = sideEffect + 6
end 'bump'

function pickBump() returns Task
	return bump
end 'pickBump'

function main() returns ExitCode
	pickBump()()
	pickBump()()
	return sideEffect as ExitCode
end 'main'
---
ExitCode: 12
---
data {
  __data_sideEffect@0 = i64 0
}

func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_sideEffect
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 6
    x64.leaRegGlobal rcx, __data_sideEffect
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#6:
    x64.leaRegFunc rbx, [rip + __fnref_bump]
  __il_cont#5:
    x64.movRegImm32 rcx, 0
    x64.callReg rbx
  __il_body#7:
    x64.leaRegFunc rbx, [rip + __fnref_bump]
  __il_cont#4:
    x64.movRegImm32 rcx, 0
    x64.callReg rbx
    x64.leaRegGlobal rax, __data_sideEffect
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.call-result-called-as-statement.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
