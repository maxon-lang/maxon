// Test: first-class-function.int-literal-widens-at-indirect-call

typealias Real = float(f64.min to f64.max)
typealias Scaler = function(v Real) returns Real

function twice(v Real) returns Real
	return v * 2.0
end 'twice'

function apply(f Scaler) returns Real
	return f(2)
end 'apply'

function main() returns ExitCode
	let fn = twice
	let r = apply(fn)
	return trunc(r) as ExitCode
end 'main'
---
ExitCode: 4
---
func @twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.popReg rbp
    x64.ret
}

func @apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.movRegReg rcx, rdx
    x64.callReg rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + __fnref_twice]
    x64.movRegImm32 rdx, 0
    x64.callDirect apply
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.int-literal-widens-at-indirect-call.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
