  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rbx, 3
  __il_body#2:
    x64.movRegImm32 r12, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
  __il_cont#1:
    x64.leaRegRdata rbx, [rip + __witness_Numbered.Lines]
  walk:
    x64.movRegReg rcx, r13
    x64.callMem [rbx + 40]
