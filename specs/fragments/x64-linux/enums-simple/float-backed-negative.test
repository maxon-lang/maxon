// Test: float-backed-negative
enum FloatSigned
	below = -2.2
	zero = 0.0
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	let result = match f 'check'
		below gives 2
		zero gives 0
		above gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
