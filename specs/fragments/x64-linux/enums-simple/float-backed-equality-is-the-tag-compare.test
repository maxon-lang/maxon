// Test: float-backed-equality-is-the-tag-compare
enum SignedZero
	negz = -0.0
	posz = 0.0
end 'SignedZero'

function main() returns ExitCode
	let x = SignedZero.negz
	if x == SignedZero.posz 'floatEquality'
		return 9
	end 'floatEquality'
	return match x 'check'
		negz gives 4
		posz gives 7
	end 'check'
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.movRegImm32 r8, 4
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-backed-equality-is-the-tag-compare.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
