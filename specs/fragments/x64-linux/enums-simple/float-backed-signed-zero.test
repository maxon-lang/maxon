// Test: float-backed-signed-zero
enum SignedZero
	negz = -0.0
	posz = 0.0
end 'SignedZero'

function main() returns ExitCode
	let x = SignedZero.negz
	return match x 'check'
		negz gives 4
		posz gives 7
	end 'check'
end 'main'
---
ExitCode: 4
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 4
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
