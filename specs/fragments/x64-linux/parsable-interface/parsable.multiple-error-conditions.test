// Test: parsable.multiple-error-conditions

typealias Integer = int(i64.min to i64.max)

// Parsable can throw different errors for different conditions
enum MoneyParseError implements Error
	InvalidFormat = 1
	NegativeValue = 2
end 'MoneyParseError'

type Money implements Parsable
	export var cents as Integer

	static function fromString(input String) returns Self throws MoneyParseError
		if input.byteLength() == 0 'empty'
			throw MoneyParseError.InvalidFormat
		end 'empty'

		if input.startsWith("-") 'negative'
			throw MoneyParseError.NegativeValue
		end 'negative'

		return Money{cents: input.byteLength() as Integer}
	end 'fromString'
end 'Money'

function main() returns ExitCode
	let price = try Money.fromString("-50") otherwise 'err'
		return 99
	end 'err'
	return price.cents
end 'main'
---
ExitCode: 99
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Money.fromString {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
  __il_body#28:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#27:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont
  empty:
    x64.movRegImm32 r10, 2
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata r12, [rip + __str_rec_2]  ; "-"
  __il_body#33:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
  __il_body#34:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#31:
    x64.cmpRegReg r13, rax
    x64.jcc belowEqual, __rc_ok#23
  tooLong:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont#5
  __rc_ok#23:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_ok#25:
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  compare_loop:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect String.byteAt
    x64.movRegReg r15, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#16
  tryok#15:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#18
  tryok#17:
    x64.cmpRegReg r15, r8
    x64.jcc equal, forstep
  byte_check:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont#5
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr:
    x64.cmpRegReg r14, r13
    x64.jcc less, compare_loop
  forexit:
    x64.movRegImm32 rax, 1
  __il_cont#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#30
  negative:
    x64.movRegImm32 r10, 3
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body#30:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
  __il_cont#29:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_10]  ; "panic at String.maxon:1036: Range check failed: value outside typealias 'BytePos'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#16:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at String.maxon:1038: bytesEqual: byteAt OOB \xe2\x80\x94 caller guarantees aOffset + len <= a.byteLength()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#18:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at String.maxon:1039: bytesEqual: byteAt OOB \xe2\x80\x94 caller guarantees bOffset + len <= b.byteLength()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "-50"
    x64.callDirect Money.fromString
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_7]  ; "panic at parsable.multiple-error-conditions.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
