// Test: subtract-order
function sub(a Integer, b Integer) returns Integer
	return a - b
end 'sub'

function main() returns ExitCode
	return sub(20, b: 8)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 12
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 12
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
