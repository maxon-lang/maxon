// Test: directives.type-body-field-pair
type Box
	#if testing(false)
		export let first as ExitCode
	#else
		export let unwanted as ExitCode
	#endif
	export let second as ExitCode

	static function create(second ExitCode) returns Box
		return Box{first: 2, second: second}
	end 'create'
end 'Box'

function main() returns ExitCode
	let b = Box.create(32)
	return b.second
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 rax, 8194
  __il_cont:
    x64.shrRegImm8 rax, rax, 8
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 255
    x64.popReg rbp
    x64.ret
}
