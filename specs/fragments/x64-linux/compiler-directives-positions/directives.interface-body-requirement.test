// Test: directives.interface-body-requirement
interface Shape
	function area() returns ExitCode
	#if testing(false)
		function perimeter() returns ExitCode
	#endif
end 'Shape'

type Square implements Shape
	export let side as ExitCode

	static function create(side ExitCode) returns Square
		return Square{side: side}
	end 'create'

	function area() returns ExitCode
		return side
	end 'area'

	function perimeter() returns ExitCode
		return 29
	end 'perimeter'
end 'Square'

function main() returns ExitCode
	let s = Square.create(4)
	return s.perimeter()
end 'main'
---
ExitCode: 29
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 29
  __il_cont:
    x64.popReg rbp
    x64.ret
}
