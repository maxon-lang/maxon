// Test: the-same-sequence-inside-a-type-method-body
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

type Holder
	export var base as Idx

	static function create() returns Holder
		return Self{base: 20}
	end 'create'

	function trips(m Marker, flag bool) returns Idx
		if m == Marker.function and (flag or not flag) 'both'
			return self.base
		end 'both'
		return 0
	end 'trips'
end 'Holder'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	let h = Holder.create()
	return (h.trips(Marker.function, flag: true) + pick(Victim.found(22))) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#7:
    x64.movRegImm32 rbx, 20
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  both:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_cont#5:
    x64.movRegImm32 rcx, 22
    x64.movRegImm32 rdx, 0
  __il_body#15:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __il_cont#4
  matchnext:
    x64.cmpRegImm32 rdx, 1
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 rcx, 0
  __il_cont#4:
    x64.leaRegRegReg rbx, rax, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at the-same-sequence-inside-a-type-method-body.test:38: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
