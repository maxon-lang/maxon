// Test: a-closure-with-a-block-keyword-parameter-inside-an-arm-body
typealias Idx = int(0 to 100)
typealias Step = function(Idx) returns Idx

enum Marker
	function
	other
end 'Marker'

function apply(f Step, x Idx) returns Idx
	return f(x)
end 'apply'

function classify(m Marker, seed Idx) returns Idx
	var total = match m 'm'
		function gives apply(function(if Idx) gives 33 + if, x: seed)
		other gives 0
	end 'm'

	var i = 0
	while i < 2 'bump'
		total = total + 1
		i = i + 1
	end 'bump'
	return total
end 'classify'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	return (classify(Marker.function, seed: 5) + pick(Victim.found(2))) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @classify$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 100
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.leaRegRegImm32 r8, rcx, 33
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-closure-with-a-block-keyword-parameter-inside-an-arm-body.test:16: Range check failed: value outside typealias 'Idx'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
  matcharm#13:
    x64.leaRegFunc rax, [rip + classify$closure_0]
    x64.movRegImm32 rdx, 0
  __il_body#28:
