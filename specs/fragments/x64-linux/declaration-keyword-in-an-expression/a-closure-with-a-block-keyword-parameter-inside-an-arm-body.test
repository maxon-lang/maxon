    x64.jmp whilehdr
  bump:
    x64.leaRegRegImm32 r8, r8, 1
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegImm32 rax, 2
    x64.jcc less, bump
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#25
  __rc_chk#26:
    x64.cmpRegImm32 r8, 100
    x64.jcc greater, __rc_panic#25
  __il_cont#11:
    x64.movRegImm32 rax, 2
    x64.movRegImm32 rcx, 0
  __il_body#5:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_cont#4
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#7:
    x64.movRegImm32 rax, 0
  __il_cont#4:
    x64.leaRegRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
