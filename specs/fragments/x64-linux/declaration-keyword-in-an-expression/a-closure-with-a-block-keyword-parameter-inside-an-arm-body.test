  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at a-closure-with-a-block-keyword-parameter-inside-an-arm-body.test:41: Range check failed: value outside typealias 'ExitCode'\x0a"
