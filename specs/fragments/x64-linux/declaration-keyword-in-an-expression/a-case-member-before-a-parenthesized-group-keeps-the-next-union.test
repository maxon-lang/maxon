// Test: a-case-member-before-a-parenthesized-group-keeps-the-next-union
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

function trips(m Marker, flag bool) returns bool
	if m == Marker.function and (flag or not flag) 'both'
		return true
	end 'both'
	return false
end 'trips'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	if trips(Marker.function, flag: true) 'ok'
		return pick(Victim.found(42))
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  both:
    x64.movRegImm32 rax, 1
  __il_cont#3:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 r8, 42
    x64.movRegImm32 rax, 0
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont#11
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 r8, 0
  __il_cont#11:
    x64.popReg rbp
    x64.ret
  matchdead:
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
