// Test: builtins-cpu-parallel.sched-max-active-workers-is-one
function main() returns ExitCode
	let workers = __Builtins.schedMaxActiveWorkers()
	var score = 0
	if workers >= 1 'contractFloor'
		score = score + 1
	end 'contractFloor'
	if workers == 1 'singleM'
		score = score + 2
	end 'singleM'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __sched_progress@0 = i64 0
  __sched_active_workers@8 = i64 1
  __sched_max_active_workers@16 = i64 1
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __sched_max_active_workers
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 1
    x64.jcc less, ifcont#2
  contractFloor:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, critsplit
  singleM:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp ifcont#4
  critsplit:
    x64.movRegReg r8, rax
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at builtins-cpu-parallel.sched-max-active-workers-is-one.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
