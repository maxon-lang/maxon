// Test: constructing-a-payload-carrying-keyword-case
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	end(a Num, b Num)
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		alpha(n) then return n
		end(a, b) then return a + b
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var acc = 0
	var i = 0
	while i < 2 'spin'
		if tagOf(Kw.end(20, b: 1)) == 21 'ok'
			acc = acc + 21
		end 'ok'
		i = i + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  spin:
    x64.movRegImm32 r13, 20
    x64.movRegImm32 r14, 1
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r13
    x64.storeBaseDispReg.word64 [r8 + 16], r14
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#11:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.jmp __il_cont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#12:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 16]
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#17
  __rc_chk#18:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic#17
  __il_cont:
    x64.cmpRegImm32 rax, 21
    x64.setccReg equal, r13
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, critsplit
  ok:
    x64.leaRegRegImm32 rax, rbx, 21
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, rbx
  ifcont:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg rbx, rax
  whilehdr:
    x64.cmpRegImm32 r12, 2
    x64.jcc less, spin
    x64.jmp whileexit
  matchdead:
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic#7
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#17:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at constructing-a-payload-carrying-keyword-case.test:12: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at constructing-a-payload-carrying-keyword-case.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
