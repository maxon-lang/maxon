  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
  __il_cont:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-generic-alias-binding-agrees-with-the-conformers-instance.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
