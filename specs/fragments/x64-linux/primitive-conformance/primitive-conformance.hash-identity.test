// Test: primitive-conformance.hash-identity
typealias Integer = int(0 to u32.max)

type Box uses T where T is Hashable
	export var item as T
	static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	function itemHash() returns HashValue
		return self.item.hash()
	end 'itemHash'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	let b = IntBox.create(97)
	if b.itemHash() == 97 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 97
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
  __il_body#5:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#4:
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
  __il_body#6:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callMem [rax + 48]
  __il_cont#3:
    x64.cmpRegImm32 r8, 97
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
