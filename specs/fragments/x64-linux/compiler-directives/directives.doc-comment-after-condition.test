// Test: directives.doc-comment-after-condition
function main() returns ExitCode
	#if os(Windows) /// a doc comment riding the directive line
		return 7
	#else /// and on the else
		return 7
	#endif /// and the endif
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
