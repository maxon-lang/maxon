// Test: directives.arch-supported
function main() returns ExitCode
	#if arch(x64) or arch(arm64) or arch(wasm32)
		return 7
	#else
		return 99
	#endif
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
