// Test: character-ordering-compares-bytes-unsigned
function main() returns ExitCode
	let decomposed = 'é'
	let precomposed = 'é'
	if decomposed < precomposed 'lt'
		print("lt\n")
	end 'lt'
	if precomposed < decomposed 'reversed'
		print("REVERSED\n")
	end 'reversed'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_4]  ; "e\xcc\x81"
    x64.leaRegRdata r12, [rip + __str_rec_5]  ; "\xc3\xa9"
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ifcont#2
  lt:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "lt\x0a"
    x64.callDirect print
  ifcont#2:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ifcont#4
  reversed:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "REVERSED\x0a"
    x64.callDirect print
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
