// Test: match-expr-result-from-payload-binding-arm
typealias Idx = int(0 to 100)

union Op
	none
	alloc(name ByteArray)
end 'Op'

function firstByte(b ByteArray) returns Idx
	return (try b.get(0) otherwise 0) as Idx
end 'firstByte'

function nameOf(op Op) returns Idx
	let n = match op 'pick'
		alloc(name) gives name
		default panic("none")
	end 'pick'
	return firstByte(n)
end 'nameOf'

function main() returns ExitCode
	var b = ByteArray.create()
	b.push(65)
	return nameOf(Op.alloc(b))
end 'main'
---
ExitCode: 65
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 65
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#2:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegReg rcx, r13
    x64.callDirect __managed_incref
  __il_body#7:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r13 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load#20:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp tryok
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load#21:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp tryok
  __im_slow:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
  tryerr:
    x64.movRegImm32 r14, 0
    x64.jmp trycont
  critsplit:
    x64.movRegReg rax, r8
  tryok:
    x64.movRegReg r14, rax
  trycont:
    x64.cmpRegImm32 r14, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r14, 100
    x64.jcc greater, __rc_panic
  __il_cont#6:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
  __il_cont#1:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Op
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at match-expr-result-from-payload-binding-arm.test:16: none\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at match-expr-result-from-payload-binding-arm.test:10: Range check failed: value outside typealias 'Idx'\x0a"
    x64.callDirect mrt_panic
