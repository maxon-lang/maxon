// Test: match-statements.fallthrough-to-default
function main() returns ExitCode
	let x = 3
	var result = 0
	match x 'check'
		1 then result = 10
		2 then result = 20
		3 then result = result + 20 and fallthrough
		default then result = result + 100
	end 'check'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 rax, 20
  matchdefault:
    x64.leaRegRegImm32 r8, rax, 100
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
