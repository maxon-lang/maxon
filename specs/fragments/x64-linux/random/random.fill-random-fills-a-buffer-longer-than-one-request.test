    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect Array.withIterator
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, unfilled
  critsplit#21:
    x64.movRegReg rcx, r12
    x64.jmp forhdr
  eachByte:
    x64.leaRegRdata r12, [rip + __layout_WithIterIterator_ArrayIterator_Byte_Byte]
    x64.leaRegRdata rax, [rip + __witness_ArrayIterator_Byte.Iterator]
  __il_body#17:
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
