// Test: factory-self-assign-straight-line

typealias Integer = int(i64.min to i64.max)

type Counter
	export var value as Integer
	export var version as Integer

	export static function make(initial Integer) returns Self
		self.value = initial
		self.version = 1
		return Self{}
	end 'make'
end 'Counter'

function main() returns ExitCode
	let c = Counter.make(41)
	return c.value + c.version
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 41
  __il_body:
    x64.movRegImm32 rcx, 1
  __il_cont:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at factory-self-assign-straight-line.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
