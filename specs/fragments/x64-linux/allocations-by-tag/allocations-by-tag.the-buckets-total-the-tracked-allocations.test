// Test: allocations-by-tag.the-buckets-total-the-tracked-allocations
typealias WidgetField = int(0 to 65536)

let Population = 64
let TallyBuckets = 2048

type Widget
	export var low as WidgetField
	export var high as WidgetField

	export static function create(low WidgetField, high WidgetField) returns Widget
		return Widget{low: low, high: high}
	end 'create'
end 'Widget'

typealias Widgets = Array with Widget

function main() returns ExitCode
	var holder = Widgets.create()
	holder.reserve(Population)

	let totalBefore = __Builtins.mmAllocTotal()
	var sumBefore = 0
	for i in 0 upto TallyBuckets 'totalTheBucketsBefore'
		sumBefore = sumBefore + __Builtins.mmAllocTotalByTag(i)
	end 'totalTheBucketsBefore'

	if sumBefore != totalBefore 'theBucketsMissedTheTotalBeforeTheBuild'
		return 1
	end 'theBucketsMissedTheTotalBeforeTheBuild'

	for k in 0 upto Population 'buildWidgets'
		holder.push(Widget.create((k mod 65536) as WidgetField, high: ((k + 1) mod 65536) as WidgetField))
	end 'buildWidgets'

	let totalAfter = __Builtins.mmAllocTotal()
	var sumAfter = 0
	for i in 0 upto TallyBuckets 'totalTheBucketsAfter'
		sumAfter = sumAfter + __Builtins.mmAllocTotalByTag(i)
	end 'totalTheBucketsAfter'

	if sumAfter != totalAfter 'theBucketsMissedTheTotalAfterTheBuild'
		return 2
	end 'theBucketsMissedTheTotalAfterTheBuild'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@32768 = i64 0
  __slab_arena_list@32776 = i64 0
  __slab_arena_map_l1@32784 = i64 0
  __slab_state@32792 = i64 0
  __ds_base@32800 = i64 0
  __ds_buf_size@32808 = i64 0
  __ds_buf_mask@32816 = i64 0
  __ds_start_ts@32824 = i64 0
  __ds_lock@32832 = i64 0
  __mm_alloc_id@32840 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 64
  __rc_ok#29:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 64
    x64.jcc greaterEqual, __il_cont#23
  grow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont#23
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont#23:
    x64.callDirect __mm_counter_alloc_total
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
    x64.jmp forhdr#1
  totalTheBucketsBefore:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_counter_alloc_total_by_tag
    x64.leaRegRegReg r13, r13, r8
  forstep#3:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr#1:
    x64.cmpRegImm32 r14, 2048
    x64.jcc less, totalTheBucketsBefore
  forexit#4:
    x64.cmpRegReg r13, r12
    x64.jcc equal, ifcont#6
  theBucketsMissedTheTotalBeforeTheBuild:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#7
  buildWidgets:
    x64.movRegReg rax, r12
    x64.sarRegImm8 rax, r12, 63
    x64.shrRegImm8 rax, rax, 48
    x64.leaRegRegReg rax, r12, rax
    x64.sarRegImm8 rax, rax, 16
    x64.imulRegRegImm32 rax, rax, 65536
    x64.movRegReg r13, r12
    x64.subRegReg r13, r12, rax
  __rc_ok#17:
    x64.leaRegRegImm32 rax, r12, 1
    x64.movRegReg rcx, rax
    x64.sarRegImm8 rcx, rax, 63
    x64.shrRegImm8 rcx, rcx, 48
    x64.leaRegRegReg rcx, rax, rcx
    x64.sarRegImm8 rcx, rcx, 16
    x64.imulRegRegImm32 rcx, rcx, 65536
    x64.movRegReg r14, rax
    x64.subRegReg r14, rax, rcx
  __rc_ok#36:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 14
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r13
    x64.storeBaseDispReg.word64 [r8 + 8], r14
  __il_cont#31:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  forstep#9:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#7:
    x64.cmpRegImm32 r12, 64
    x64.jcc less, buildWidgets
  forexit#10:
    x64.callDirect __mm_counter_alloc_total
    x64.movRegReg r12, r8
