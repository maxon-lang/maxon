// Test: shr-count-past-width
function main() returns ExitCode
	if (-1) shr 100 != -1 'negWrong'
		return 1
	end 'negWrong'
	if 8 shr 100 != 0 'posWrong'
		return 2
	end 'posWrong'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
