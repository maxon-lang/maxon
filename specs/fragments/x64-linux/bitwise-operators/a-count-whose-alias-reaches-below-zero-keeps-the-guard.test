// Test: a-count-whose-alias-reaches-below-zero-keeps-the-guard
typealias Num = int(i64.min to i64.max)
typealias Word = bits(64)
typealias Small = int(-1 to 5)

function shlBy(value Num, n Small) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n Small) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n Small) returns Word
	return value shr n
end 'shrWordBy'

function below(step Num) returns Small
	return (-step) as Small
end 'below'

function main() returns ExitCode
	let negative = below(1)

	if shlBy(1, n: negative) != 0 'shl'
		return 1
	end 'shl'
	if shrBy(-4, n: negative) != -1 'shrSign'
		return 2
	end 'shrSign'
	if shrWordBy(u64.max, n: negative) != 0 'shrZeroFill'
		return 3
	end 'shrZeroFill'

	// The in-range end of the same alias, so the case cannot pass by refusing the whole type.
	if shlBy(1, n: below(-5)) != 32 'shlInRange'
		return 4
	end 'shlInRange'

	return 42
end 'main'
---
ExitCode: 1
---
func @shlBy {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rax, rcx
    x64.cmpRegImm32 rdx, -1
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 5
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, shiftneg
  shiftok:
    x64.movRegReg rcx, rdx
    x64.andRegImm32 rcx, rdx, -64
    x64.movRegReg rsi, rcx
    x64.negReg rsi, rcx
    x64.orRegReg rsi, rsi, rcx
    x64.sarRegImm8 rsi, rsi, 63
    x64.movRegReg rcx, rdx
    x64.shlRegCl rax, rax
    x64.notReg rsi, rsi
    x64.movRegReg r8, rax
    x64.andRegReg r8, rax, rsi
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:6: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  shiftneg:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:7: negative shift count\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_ok:
    x64.movRegImm rdx, 18446744073709551615
  __il_cont:
    x64.movRegImm32 rcx, 1
    x64.callDirect shlBy
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, shiftneg
  shl:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  shiftneg:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:11: negative shift count\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
