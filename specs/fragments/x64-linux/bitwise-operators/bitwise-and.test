// Test: bitwise-and
function main() returns ExitCode
	let a = 12
	let b = 10
	return a and b
end 'main'
---
ExitCode: 8
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 8
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
