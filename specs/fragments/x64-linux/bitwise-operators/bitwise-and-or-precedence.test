// Test: bitwise-and-or-precedence
function main() returns ExitCode
	// and has higher precedence than or
	// 12 and 10 = 8, then 8 or 1 = 9
	return 12 and 10 or 1
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 9
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
