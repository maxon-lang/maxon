// Test: url.parse-err-bad-percent
function main() returns ExitCode
	try URL.parse("https://example.com/path%GG") otherwise 'err'
		print("invalidEncoding\n")
		return 0
	end 'err'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_15]  ; "https://example.com/path%GG"
    x64.callDirect URL.parse
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_rec_16]  ; "invalidEncoding\x0a"
  __il_body:
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_URL
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
