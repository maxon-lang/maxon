// Test: a-nested-alias-and-a-file-scope-alias-of-one-name-are-not-unneeded
typealias Level = int(0 to 64)
typealias Integer = int(i64.min to i64.max)

type Meter
	let reading as Integer

	static function create() returns Self
		return Self{reading: 7}
	end 'create'

	function raw() returns Integer
		return self.reading
	end 'raw'
end 'Meter'

extension Meter
	typealias Level = int(0 to 10)

	function level() returns Level
		return self.raw() as Level
	end 'level'
end 'Meter'

function main() returns ExitCode
	let meter = Meter.create()
	let narrow = meter.raw() as Meter.Level
	let wide = narrow as Level
	return wide
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#7:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 10
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-nested-alias-and-a-file-scope-alias-of-one-name-are-not-unneeded.test:27: Range check failed: value outside typealias 'Level'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
