// Test: error.unneeded.literal-return
typealias Score = int(0 to 100)

function passing() returns Score
	return 50 as Score
end 'passing'

function main() returns ExitCode
	return passing()
end 'main'
---
CompilerError:
error E3010: <fragment>:5:12: unneeded cast: the literal 50 already fits in 'Score'
