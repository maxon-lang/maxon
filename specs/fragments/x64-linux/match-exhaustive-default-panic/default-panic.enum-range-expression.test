// Test: default-panic.enum-range-expression
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.mul
	let result = match op 'eval'
		add or
			sub gives 1
		mul gives 2
		default panic("unexpected op")
	end 'eval'
	return result
end 'main'
---
ExitCode: 2
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 0
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp __rc_ok
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at default-panic.enum-range-expression.test:17: unexpected op\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
