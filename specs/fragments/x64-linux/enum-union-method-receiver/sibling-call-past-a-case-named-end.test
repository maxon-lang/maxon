// Test: sibling-call-past-a-case-named-end
enum Sib
	alpha
	end
	omega

	function outer() returns Integer
		return inner() + 1
	end 'outer'

	function inner() returns Integer
		return 6
	end 'inner'
end 'Sib'

function main() returns ExitCode
	let a = Sib.alpha
	return a.outer() as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 6
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
