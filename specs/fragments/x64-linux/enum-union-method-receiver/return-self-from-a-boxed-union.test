// Test: return-self-from-a-boxed-union
union Boxed
	one(v Integer)
	two(s String)

	function giveBack() returns Boxed
		return self
	end 'giveBack'
end 'Boxed'

function main() returns ExitCode
	let b = Boxed.one(3)
	let c = b.giveBack()
	match c 'k'
		one(v) then return v as ExitCode
		two then return 1
	end 'k'
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 3
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
  __il_body:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_retain
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Boxed
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Boxed
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Boxed
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Boxed
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at return-self-from-a-boxed-union.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
