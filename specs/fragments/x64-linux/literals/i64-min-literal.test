// Test: i64-min-literal
typealias Big = int(i64.min to i64.max)

function main() returns ExitCode
	let lo = -9223372036854775808 as Big
	let back = lo - i64.min
	return back as ExitCode
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
