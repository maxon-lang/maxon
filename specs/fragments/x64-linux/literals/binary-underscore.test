// Test: binary-underscore
function main() returns ExitCode
	return 0b0101_1010
end 'main'
---
ExitCode: 90
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 90
    x64.popReg rbp
    x64.ret
}
