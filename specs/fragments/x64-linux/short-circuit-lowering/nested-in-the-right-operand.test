// Test: nested-in-the-right-operand
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if f() or (t() and t()) 'a'
		code = code + 1
	end 'a'
	if t() and (f() or t()) 'b'
		code = code + 2
	end 'b'
	if f() or (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  a:
    x64.movRegImm32 rax, 1
  b:
    x64.leaRegRegImm32 r8, rax, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
