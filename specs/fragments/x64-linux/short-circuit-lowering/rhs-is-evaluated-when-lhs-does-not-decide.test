// Test: rhs-is-evaluated-when-lhs-does-not-decide
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if t() and f() 'a'
		code = code + 1
	end 'a'
	if t() and t() 'b'
		code = code + 2
	end 'b'
	if f() and t() 'c'
		code = code + 4
	end 'c'
	if f() or f() 'd'
		code = code + 8
	end 'd'
	if f() or t() 'e'
		code = code + 16
	end 'e'
	if t() or f() 'g'
		code = code + 32
	end 'g'
	return code
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  b:
    x64.leaRegRegImm32 rax, rax, 2
  e:
    x64.leaRegRegImm32 rax, rax, 16
  g:
    x64.leaRegRegImm32 r8, rax, 32
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
