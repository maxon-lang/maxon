// Test: a-generic-instance-method
typealias Score = int(0 to 100)

type Tally
	var total as Score

	static function create() returns Self
		return Self{total: 0}
	end 'create'

	function describe(v T) uses T returns String
		return "{self.total}:{v}"
	end 'describe'
end 'Tally'

function main() returns ExitCode
	let t = Tally.create()
	print("{t.describe("a")} {t.describe(7)}\n")
	return 0
end 'main'
