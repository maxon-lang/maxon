// Test: slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Len = int(0 to 65536)

let FirstLen = 32700
let LenStep = 4
let SweepCount = 26

function build(n Len) returns ByteArray
	var b = ByteArray.create()
	b.reserve(n)
	for i in 0 upto n 'fill'
		b.push(((i + n) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function sweep() returns Integer
	var bufs = Bufs.create()
	for k in 0 upto SweepCount 'alloc'
		bufs.push(build((FirstLen + k * LenStep) as Len))
	end 'alloc'

	var bad = 0
	for k in 0 upto SweepCount 'check'
		let n = FirstLen + k * LenStep
		let b = try bufs.get(k) otherwise return 1
		if b.count() != n 'length'
			bad = bad + 1
		end 'length'
		for i in 0 upto n 'bytes'
			let got = try b.get(i) otherwise return 1
			if got != ((i + n) mod 251) 'value'
				bad = bad + 1
			end 'value'
		end 'bytes'
	end 'check'
	return bad
end 'sweep'

function main() returns ExitCode
	if sweep() != 0 'firstRound'
		return 3
	end 'firstRound'

	// The first sweep's buffers are all dead by now, so this one re-asks for the same sizes with both
	// free routes already run — a span slot recycled, a mapping unmapped and re-mapped.
	if sweep() != 0 'secondRound'
		return 4
	end 'secondRound'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#6
  __rc_chk#7:
    x64.cmpRegImm32 rbx, 65536
    x64.jcc lessEqual, __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands.test:11: Range check failed: value outside typealias 'Len'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Array.reserve
    x64.movRegImm32 r13, 0
  forhdr:
    x64.cmpRegReg r13, rbx
    x64.jcc greaterEqual, forexit
  fill:
    x64.leaRegRegReg rsi, r13, rbx
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg rsi
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, rsi
    x64.subRegReg rdx, rsi, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#9
  __rc_chk#10:
    x64.cmpRegImm32 rdx, 255
    x64.jcc lessEqual, __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands.test:15: Range check failed: value outside typealias 'Byte'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

