func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect sweep
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  firstRound:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.callDirect sweep
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
