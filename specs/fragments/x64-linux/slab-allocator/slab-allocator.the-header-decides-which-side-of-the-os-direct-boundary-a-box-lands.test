    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#9:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegReg rax, r13
    x64.jcc equal, critsplit#39
  length:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont
  critsplit#39:
    x64.movRegReg rax, r12
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg r15, rax
  forhdr#13:
    x64.cmpRegReg r12, r13
    x64.jcc greaterEqual, forstep#7
  bytes:
    x64.cmpRegImm32 r12, 0
    x64.jcc greaterEqual, __rc_ok#24
  __rc_panic#25:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands.test:34: Range check failed: value outside typealias 'ElementIndex'\x0a"
