// Test: slab-allocator.a-fresh-slot-reads-zero
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function dirty()
	let mm = try __ManagedMemory.create(4096, elementSize: 1) otherwise return
	try mm.setLength(4096) otherwise return
	var arr = ByteArray.init(mm)
	for i in 0 upto 4096 'fill'
		try arr.set(i, value: 255) otherwise return
	end 'fill'
end 'dirty'

function countNonZero() returns Integer
	let mm = try __ManagedMemory.create(4096, elementSize: 1) otherwise return 1
	try mm.setLength(4096) otherwise return 2
	let arr = ByteArray.init(mm)
	var seen = 0
	for i in 0 upto 4096 'scan'
		let got = try arr.get(i) otherwise return 3
		if got != 0 'nonZero'
			seen = seen + 1
		end 'nonZero'
	end 'scan'
	return seen
end 'countNonZero'

function main() returns ExitCode
	for _ in 0 upto 8 'rounds'
		dirty()
	end 'rounds'

	if countNonZero() != 0 'dirtySlot'
		return 3
	end 'dirtySlot'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @dirty {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 4096
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_mem_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 4096
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
  forhdr:
    x64.cmpRegImm32 r13, 4096
    x64.jcc greaterEqual, forexit
  fill:
    x64.movRegImm32 rax, 255
    x64.loadRegBaseDisp.word64 rcx, [r12 + 24]
    x64.cmpRegImm32 rcx, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
  __im_owned#16:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __im_slow
  __im_bounds#17:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 8]
    x64.cmpRegReg r13, rcx
    x64.jcc aboveEqual, __im_slow
  __im_buffer#18:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow
  __im_viewed#19:
    x64.leaRegRegImm32 rdx, rcx, -24
    x64.loadRegBaseDisp.word64 rdx, [rdx + 16]
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __im_slow
  __im_store#20:
    x64.storeBaseIndexScaleReg.word64 [rcx + r13*8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
  __im_owned#21:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __im_slow
  __im_bounds#22:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 8]
    x64.cmpRegReg r13, rcx
    x64.jcc aboveEqual, __im_slow
  __im_buffer#23:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow
  __im_viewed#24:
    x64.leaRegRegImm32 rdx, rcx, -24
    x64.loadRegBaseDisp.word64 rdx, [rdx + 16]
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __im_slow
  __im_store#25:
    x64.leaRegRegReg rcx, rcx, r13
    x64.storeBaseDispReg.byte [rcx + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_set
    x64.movRegReg rax, r10
  __im_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, forstep
  tryerr#10:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @countNonZero {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 4096
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_mem_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 4096
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
  forhdr:
    x64.cmpRegImm32 r14, 4096
    x64.jcc greaterEqual, forexit
  scan:
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegReg r14, rax
    x64.jcc aboveEqual, __im_slow
  __im_load#19:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r14*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegReg r14, rax
    x64.jcc aboveEqual, __im_slow
  __im_load#20:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [r12 + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __im_cont
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __im_cont
  __im_slow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
  __im_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, tryok#9
  tryerr#10:
    x64.movRegImm32 r13, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#9:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
  nonZero:
    x64.leaRegRegImm32 rax, r13, 1
    x64.jmp forstep
  critsplit:
    x64.movRegReg rax, r13
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
    x64.movRegReg r13, rax
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  forhdr:
    x64.cmpRegImm32 rbx, 8
    x64.jcc greaterEqual, forexit
  rounds:
    x64.callDirect dirty
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp forhdr
  forexit:
    x64.callDirect countNonZero
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  dirtySlot:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
