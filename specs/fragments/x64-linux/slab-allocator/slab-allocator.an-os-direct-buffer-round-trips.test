// Test: slab-allocator.an-os-direct-buffer-round-trips
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Round = int(0 to 255)

function roundTrip(r Round) returns Integer
	var big = ByteArray.create()
	big.reserve(300000)
	for i in 0 upto 512 'fill'
		big.push(((r + i) mod 251) as Byte)
	end 'fill'

	var wrong = 0
	for i in 0 upto 512 'check'
		let got = try big.get(i) otherwise return 1
		if (got as Round) != ((r + i) mod 251) 'value'
			wrong = wrong + 1
		end 'value'
	end 'check'
	return wrong
end 'roundTrip'

function main() returns ExitCode
	var bad = 0
	for r in 0 upto 64 'rounds'
		bad = bad + roundTrip(r as Round)
	end 'rounds'

	if bad != 0 'corrupted'
		return 3
	end 'corrupted'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr#1
  __rc_ok#21:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 300000
  __rc_ok#41:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 300000
    x64.jcc greaterEqual, __il_cont#35
  grow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont#35
  tryerr#39:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:418: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont#35:
    x64.movRegImm32 r13, 0
    x64.jmp forhdr#9
  fill:
    x64.leaRegRegReg rax, rbx, r13
    x64.movRegImm32 rcx, 251
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#24:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
  forstep#11:
    x64.leaRegRegImm32 r13, r13, 1
  forhdr#9:
    x64.cmpRegImm32 r13, 512
    x64.jcc less, fill
  forexit#12:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rbx, 0
  __us_test:
    x64.loadRegBaseDisp.word64 r13, [r12 + 24]
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
    x64.loadRegBaseDisp.word64 r15, [r12 + 0]
    x64.jmp forhdr#13
  check:
    x64.cmpRegImm32 r13, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.cmpRegReg rbx, r14
    x64.jcc aboveEqual, __im_slow
  __im_load#33:
    x64.loadRegBaseIndexScale.word64 rax, [r15 + rbx*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 r13, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.cmpRegReg rbx, r14
    x64.jcc aboveEqual, __im_slow
  __im_load#34:
    x64.leaRegRegReg rax, r15, rbx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegReg rcx, rax
    x64.jmp tryok
  __im_slow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit#45
  tryerr#18:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rax, rbx
    x64.jmp __il_cont#7
  critsplit#45:
    x64.movRegReg rcx, r8
  tryok:
    x64.loadRegSlot rax, slot3
    x64.leaRegRegReg rax, rax, rbx
    x64.movRegImm32 rsi, 251
    x64.movRegImm32 rdx, 0
    x64.divReg rsi
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, critsplit#44
  value:
    x64.loadRegSlot rax, slot2
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forstep#15
  critsplit#44:
    x64.loadRegSlot rax, slot2
  forstep#15:
    x64.loadRegSlot rcx, slot1
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.movRegReg rbx, rcx
  forhdr#13:
    x64.storeSlotReg slot2, rax
    x64.storeSlotReg slot1, rbx
    x64.cmpRegImm32 rbx, 512
    x64.jcc less, check
  forexit#16:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.loadRegSlot rax, slot2
  __il_cont#7:
    x64.loadRegSlot rcx, slot0
    x64.leaRegRegReg rax, rcx, rax
  forstep#3:
    x64.loadRegSlot rcx, slot3
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.movRegReg rbx, rcx
  forhdr#1:
    x64.storeSlotReg slot3, rbx
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rbx, 64
    x64.jcc less, __rc_ok#21
  forexit#4:
    x64.loadRegSlot rax, slot0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  corrupted:
    x64.movRegImm32 r8, 3
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at slab-allocator.an-os-direct-buffer-round-trips.test:10: Range check failed: value outside typealias 'Byte'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
