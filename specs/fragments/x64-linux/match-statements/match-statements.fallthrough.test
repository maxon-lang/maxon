// Test: match-statements.fallthrough
function main() returns ExitCode
	let x = 1
	var result = 0
	match x 'check'
		1 then result = result + 10 and fallthrough
		2 then result = result + 20
		default then result = result + 100
	end 'check'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm#1:
    x64.movRegImm32 rax, 10
  matcharm#2:
    x64.leaRegRegImm32 r8, rax, 20
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
