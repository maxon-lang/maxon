// Test: match-break.fallthrough-into-break-arm
function main() returns ExitCode
	var r = 0
	var n = 1
	match n 'check'
		1 then r = 5 and fallthrough
		2 then break
		default then r = 9
	end 'check'
	return r
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 5
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
