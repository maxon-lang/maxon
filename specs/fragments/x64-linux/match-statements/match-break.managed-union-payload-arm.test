// Test: match-break.managed-union-payload-arm
union Note
	text(s String)
	none
end 'Note'

typealias Count = int(0 to 1000)

function weigh(n Note) returns Count
	var r = 0
	match n 'check'
		text then break
		none then r = 5
	end 'check'
	return r + 1
end 'weigh'

function main() returns ExitCode
	let a = weigh(Note.text("hello"))
	let b = weigh(Note.none)
	return a + b
end 'main'
