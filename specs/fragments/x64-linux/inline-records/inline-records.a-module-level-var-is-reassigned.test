// Test: inline-records.a-module-level-var-is-reassigned
typealias Half = int(0 to u32.max)

type Pair
	export let lo as Half
	export let hi as Half

	export static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

var slot = Pair.create(1, hi: 2)

function main() returns ExitCode
	let before = __Builtins.mmAllocLive()

	if slot.lo != 1 'firstLo'
		return 1
	end 'firstLo'

	slot = Pair.create(7, hi: 9)

	if slot.lo != 7 'secondLo'
		return 2
	end 'secondLo'

	if slot.hi != 9 'secondHi'
		return 3
	end 'secondHi'

	let after = __Builtins.mmAllocLive()

	if after != before 'alloc'
		return 4
	end 'alloc'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_slot@0 = i64 8589934593
  __slab_state@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect __mm_counter_alloc_live
    x64.movRegReg rbx, r8
    x64.leaRegGlobal rax, __data_slot
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 4294967295
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __rc_ok
  firstLo:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm rax, 38654705671
  __il_cont:
    x64.leaRegGlobal rcx, __data_slot
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_slot
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 4294967295
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 7
    x64.jcc equal, ifcont#4
  secondLo:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.leaRegGlobal rax, __data_slot
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.shrRegImm8 rax, rax, 32
    x64.movRegImm32 rcx, 4294967295
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 9
    x64.jcc equal, ifcont#6
  secondHi:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.callDirect __mm_counter_alloc_live
    x64.cmpRegReg r8, rbx
    x64.jcc equal, ifcont#8
  alloc:
    x64.movRegImm32 r8, 4
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
