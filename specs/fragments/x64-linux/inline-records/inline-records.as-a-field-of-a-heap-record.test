// Test: inline-records.as-a-field-of-a-heap-record
typealias Half = int(0 to u32.max)
typealias Integer = int(i64.min to i64.max)

type Pair
	export let lo as Half
	export let hi as Half

	static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

type Outer
	export var p as Pair
	export var n as Integer

	static function create(p Pair, n Integer) returns Self
		return Self{p: p, n: n}
	end 'create'
end 'Outer'

function main() returns ExitCode
	return sizeof(Outer)
end 'main'
---
ExitCode: 16
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 16
    x64.popReg rbp
    x64.ret
}
