// Test: inline-records.captured-by-a-closure
typealias Half = int(0 to u32.max)

type Pair
	export let lo as Half
	export let hi as Half

	export static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

function main() returns ExitCode
	let p = Pair.create(3, hi: 4)
	let sum = function() gives p.lo + p.hi

	let before = __Builtins.mmAllocLive()
	let first = sum()
	let second = sum()
	let after = __Builtins.mmAllocLive()

	if first != 7 'firstValue'
		return 1
	end 'firstValue'

	if second != 7 'secondValue'
		return 1
	end 'secondValue'

	if after != before 'alloc'
		return 2
	end 'alloc'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
  __rc_ok:
    x64.movRegImm rbx, 17179869187
  __il_cont:
    x64.leaRegFunc r12, [rip + main$closure_0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.callDirect __mm_counter_alloc_live
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callReg r12
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callReg r12
    x64.movRegReg r12, r8
    x64.callDirect __mm_counter_alloc_live
    x64.cmpRegImm32 r14, 7
    x64.jcc equal, ifcont#2
  firstValue:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 r12, 7
    x64.jcc equal, ifcont#4
  secondValue:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.cmpRegReg r8, rbx
    x64.jcc equal, ifcont#6
  alloc:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegImm32 rdx, 4294967295
    x64.andRegReg rax, rax, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.shrRegImm8 rcx, rcx, 32
    x64.movRegImm32 rdx, 4294967295
    x64.andRegReg rcx, rcx, rdx
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}
