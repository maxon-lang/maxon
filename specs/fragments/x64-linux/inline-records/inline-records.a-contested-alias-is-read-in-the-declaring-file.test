  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok#15:
    x64.movRegImm rax, 34359738367
  __il_cont:
    x64.movRegImm32 rcx, 4294967295
    x64.movRegReg rdx, rax
    x64.andRegReg rdx, rax, rcx
    x64.movRegImm32 rcx, 4294967295
    x64.cmpRegReg rdx, rcx
    x64.jcc equal, ifcont
  lo:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.shrRegImm8 rax, rax, 32
    x64.movRegImm32 rcx, 4294967295
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 7
    x64.jcc equal, __il_body
  hi:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.movRegImm32 r8, 8
  __rc_ok#7:
    x64.popReg rbp
    x64.ret
}
