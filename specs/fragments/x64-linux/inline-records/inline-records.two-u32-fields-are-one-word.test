// Test: inline-records.two-u32-fields-are-one-word
typealias Half = int(0 to u32.max)

type Pair
	export let lo as Half
	export let hi as Half

	static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

function main() returns ExitCode
	return sizeof(Pair)
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 8
    x64.popReg rbp
    x64.ret
}
