    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at witness-closure-inheritance.one-constraint-dispatched-twice-takes-one-slot.test:10: Range check failed: value outside typealias 'Code'\x0a"
    x64.callDirect mrt_panic
