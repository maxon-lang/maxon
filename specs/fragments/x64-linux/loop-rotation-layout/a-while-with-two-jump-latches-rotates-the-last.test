// Test: a-while-with-two-jump-latches-rotates-the-last
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function weightedSum(a WordArray, n Word) returns Word
	var t = 0
	var i = 0
	while i < n 'each'
		let v = try a.get(i) otherwise panic("weightedSum: i < n = a.count()")
		i = i + 1
		if v mod 2 == 0 'even'
			t = t + 10
			continue
		end 'even'
		t = t + v
	end 'each'
	return t
end 'weightedSum'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 1 to 8 'seed'
		a.push(i)
	end 'seed'
	return weightedSum(a, n: 8)
end 'main'
---
ExitCode: 56
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @weightedSum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 80
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.loadRegBaseDisp.word64 rdi, [rcx + 0]
    x64.jmp whilehdr
  __rc_ok:
    x64.cmpRegReg rax, rsi
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseIndexScale.word64 r9, [rdi + rax*8 + 0]
  tryok:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r10, r9
    x64.sarRegImm8 r10, r9, 63
    x64.shrRegImm8 r10, r10, 63
    x64.leaRegRegReg r10, r9, r10
    x64.sarRegImm8 r10, r10, 1
    x64.imulRegRegImm32 r10, r10, 2
    x64.movRegReg r11, r9
    x64.subRegReg r11, r9, r10
    x64.cmpRegImm32 r11, 0
    x64.jcc notEqual, ifcont
  even:
    x64.leaRegRegImm32 r8, r8, 10
    x64.jmp whilehdr
  ifcont:
    x64.leaRegRegReg r8, r8, r9
  whilehdr:
    x64.cmpRegReg rax, rdx
    x64.jcc less, __rc_ok
  whileexit:
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rdx, rax
    x64.callDirect __managed_get
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-while-with-two-jump-latches-rotates-the-last.test:9: weightedSum: i < n = a.count()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
    x64.jmp forhdr
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr:
    x64.cmpRegImm32 r12, 8
    x64.jcc lessEqual, seed
  forexit:
    x64.movRegImm32 rdx, 8
    x64.movRegReg rcx, rbx
    x64.callDirect weightedSum
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-while-with-two-jump-latches-rotates-the-last.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
