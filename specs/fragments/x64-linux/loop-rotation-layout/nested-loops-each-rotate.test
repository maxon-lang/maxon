// Test: nested-loops-each-rotate
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function grid(a WordArray, rows Word, width Word) returns Word
	var t = 0
	for r in 0 upto rows 'row'
		var line = 0
		for c in 0 upto width 'col'
			line = line + (try a.get(r * width + c) otherwise panic("grid: r * width + c < rows * width = a.count()"))
		end 'col'
		t = t + line * (r + 1)
	end 'row'
	return t
end 'grid'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 9 'seed'
		a.push(i)
	end 'seed'
	return grid(a, rows: 3, width: 3)
end 'main'
---
ExitCode: 90
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 80
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 9
    x64.jcc less, seed
  __il_body:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr#10
  row:
    x64.movRegImm32 rsi, 0
    x64.movRegImm32 rdi, 0
    x64.jmp forhdr#14
  col:
    x64.imulRegRegImm32 r8, rax, 3
    x64.leaRegRegReg r8, r8, rdi
  __rc_ok#20:
    x64.cmpRegReg r8, rcx
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseIndexScale.word64 r8, [rdx + r8*8 + 0]
  tryok:
    x64.leaRegRegReg rsi, rsi, r8
  forstep#16:
    x64.leaRegRegImm32 rdi, rdi, 1
  forhdr#14:
    x64.cmpRegImm32 rdi, 3
    x64.jcc less, col
  forexit:
    x64.leaRegRegImm32 rax, rax, 1
    x64.imulRegReg rsi, rsi, rax
    x64.leaRegRegReg r12, r12, rsi
  forhdr#10:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, row
  __il_cont:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok#5:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at nested-loops-each-rotate.test:10: grid: r * width + c < rows * width = a.count()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at nested-loops-each-rotate.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
