    x64.movRegImm32 rax, 0
    x64.movRegImm rsi, 18446744073709551615
  __us_test:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.jmp whilehdr
  __rc_ok:
    x64.cmpRegReg rax, rdi
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseIndexScale.word64 r9, [r8 + rax*8 + 0]
  tryok:
    x64.cmpRegImm32 r9, 0
    x64.jcc less, whileexit
  ifcont:
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegReg rax, rdx
    x64.jcc less, __rc_ok
  critsplit:
    x64.movRegReg rax, rsi
  whileexit:
    x64.leaRegRegImm32 r8, rax, 100
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rdx, rax
    x64.callDirect __managed_get
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-break-leaves-a-rotated-loop-from-its-body.test:9: firstNegative: i < n = a.count()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
