// Test: a-while-true-whose-exit-sits-above-its-latch-is-not-rotated
typealias Small = int(0 to 100)

function spinTo(limit Small) returns Small
	var i = 0 as Small
	while true 'spin'
		i = i + 1
		if i == limit 'done'
			break
		end 'done'
	end 'spin'
	return i
end 'spinTo'

function main() returns ExitCode
	return spinTo(5) + spinTo(37)
end 'main'
---
ExitCode: 42
---
func @spinTo {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 rcx, 100
    x64.jcc greater, __rc_panic#7
  __rc_ok#6:
    x64.movRegImm32 rax, 0
  spin:
    x64.leaRegRegImm32 r8, rax, 1
    x64.cmpRegReg r8, rcx
    x64.jcc notEqual, ifcont
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#10
  __rc_chk#11:
    x64.cmpRegImm32 r8, 100
    x64.jcc greater, __rc_panic#10
  __rc_ok#9:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp spin
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-while-true-whose-exit-sits-above-its-latch-is-not-rotated.test:4: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-while-true-whose-exit-sits-above-its-latch-is-not-rotated.test:12: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 5
    x64.callDirect spinTo
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 37
    x64.callDirect spinTo
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-while-true-whose-exit-sits-above-its-latch-is-not-rotated.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
