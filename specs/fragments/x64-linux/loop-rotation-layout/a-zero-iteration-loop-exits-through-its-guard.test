// Test: a-zero-iteration-loop-exits-through-its-guard
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function sumFrom(a WordArray, n Word, start Word) returns Word
	var t = start
	for i in 0 upto n 'each'
		t = t + (try a.get(i) otherwise panic("sumFrom: i < n = a.count()"))
	end 'each'
	return t
end 'sumFrom'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 1 to 3 'seed'
		a.push(i)
	end 'seed'
	return sumFrom(a, n: 0, start: 100)
end 'main'
---
ExitCode: 100
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
    x64.jmp forhdr
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr:
    x64.cmpRegImm32 r12, 3
    x64.jcc lessEqual, seed
  forexit:
    x64.movRegImm32 r12, 100
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
