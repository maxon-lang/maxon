// Test: public-typealias-not-flagged
// --- file: api/lib.maxon
public typealias UnusedAlias = int(0 to 100)

export typealias Integer = int(i64.min to i64.max)

function consumeAlias(value UnusedAlias) returns Integer
	return value
end 'consumeAlias'

export function entry() returns Integer
	return consumeAlias(42)
end 'entry'

// --- file: app/main.maxon
function main() returns ExitCode
	return entry()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok#8:
    x64.movRegImm32 r8, 42
  __rc_ok#1:
    x64.popReg rbp
    x64.ret
}
