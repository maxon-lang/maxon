// Test: cross-file-alias-in-a-signature-is-a-reference
// --- file: api/lib.maxon
export typealias Score = int(0 to 100)

// --- file: app/main.maxon
function scoreOf(s Score) returns Score
	return s
end 'scoreOf'

function main() returns ExitCode
	return scoreOf(5)
end 'main'
---
ExitCode: 5
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 5
  __il_cont:
    x64.popReg rbp
    x64.ret
}
