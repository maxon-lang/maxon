// Test: first-last-borrow-opaque-element
typealias ExitCode = int(0 to 125)

type Container uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray

	static function create() returns Self
		return Self{ items: ElementArray.create() }
	end 'create'

	function push(item Element)
		self.items.push(item)
	end 'push'

	// Both ends are BOUND and read: an end borrow is a pure read, so discarding one is E3064
	// (`discarded-results.md`), and binding it exercises the same take-and-release this case exists for.
	function peekEnds() returns Element throws ArrayError
		let front = try self.items.first()
		let back = try self.items.last()
		if self.items.count() == 1 'oneElement'
			return front
		end 'oneElement'
		return back
	end 'peekEnds'
end 'Container'

typealias StringContainer = Container with String

function main() returns ExitCode
	var sc = StringContainer.create()
	sc.push("only element long enough to force a heap allocation")
	let seen = try sc.peekEnds() otherwise return 1
	return 0 if seen.byteLength() > 0 else 2
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Container.peekEnds {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_first
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r12
    x64.callDirect Array.last
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, ifcont
  oneElement:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __drop_type_param
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __layout_Container_String]
  __il_body#11:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#10:
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; "only element long enough to force a heap allocation"
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.leaRegRdata rax, [rip + __layout_Container_String]
  __il_body#12:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.movRegReg rdx, r14
    x64.callDirect __managed_push
  __il_cont#9:
    x64.leaRegRdata rdx, [rip + __layout_Container_String]
    x64.movRegReg rcx, r12
    x64.callDirect Container.peekEnds
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_body#14
  tryerr:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Container_String
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body#14:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
  __il_cont#13:
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rbx, 2
  matchcont:
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Container_String
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
