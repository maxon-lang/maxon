// Test: conditional-static-factory-feed-leak-free
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Holder uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray

	export static function ofMaybe(first Element, flag bool) returns Self
		var xs = ElementArray.create()
		if flag 'maybe'
			xs.push(first)
		end 'maybe'
		return Self{ items: xs }
	end 'ofMaybe'

	export function count() returns Count
		return items.count()
	end 'count'
end 'Holder'

typealias StringHolder = Holder with String

function main() returns ExitCode
	var kept = 0
	for i in 0 upto 200 'loop'
		let h = StringHolder.ofMaybe("a heap-allocated element numbered {i}", flag: false)
		kept = kept + h.count()
	end 'loop'
	if kept == 0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr
  loop:
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; "a heap-allocated element numbered "
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRegReg rax, r13, rbx
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, rbx
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot2
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.leaRegRdata rbx, [rip + __layout_Holder_String]
  __il_body#9:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rbx + 40]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
  iffalse:
    x64.loadRegSlot rdx, slot3
    x64.movRegReg rcx, rbx
    x64.callDirect __drop_type_param
  ifcont#11:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.storeBaseDispReg.word64 [rbx + 0], r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_body#13:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont:
    x64.loadRegSlot rcx, slot1
    x64.leaRegRegReg r12, rcx, rax
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder_String
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg rbx, rax
    x64.movRegReg rax, r12
  forhdr:
    x64.storeSlotReg slot1, rax
    x64.storeSlotReg slot0, rbx
    x64.cmpRegImm32 rbx, 200
    x64.jcc less, loop
  forexit:
    x64.loadRegSlot rax, slot1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont#6
  check:
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 1
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
