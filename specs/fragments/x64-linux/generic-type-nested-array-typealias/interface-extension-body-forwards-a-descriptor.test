// Test: interface-extension-body-forwards-a-descriptor
typealias Count = int(0 to u64.max)
typealias Integer = int(i64.min to i64.max)

interface Appendable uses Func
	function opsCount() returns Count
	function absorb(other Func)
end 'Appendable'

extension Appendable
	export function absorbTwice(a Func, b Func)
		self.absorb(a)
		self.absorb(b)
	end 'absorbTwice'
end 'Appendable'

type Bag uses Op implements Appendable with Integer
	typealias OpArray = Array with Op
	export var ops as OpArray

	export static function create() returns Self
		return Self{ops: OpArray.create()}
	end 'create'

	export function opsCount() returns Count
		return self.ops.count()
	end 'opsCount'

	export function absorb(other Integer)
		self.ops.append(self.ops)
		_ = other
	end 'absorb'
end 'Bag'

typealias IntBag = Bag with Integer

function main() returns ExitCode
	var a = IntBag.create()
	a.absorbTwice(1, b: 2)
	if a.opsCount() == 0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Bag.absorb {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_append_opaque
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __layout_Bag_Integer]
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rbx, 2
    x64.leaRegRdata r13, [rip + __layout_Bag_Integer]
  __il_body#7:
    x64.movRegReg rcx, r12
    x64.movRegReg rax, r13
    x64.callDirect Bag.absorb
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r13
    x64.callDirect Bag.absorb
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#3:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Bag_Integer
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Bag_Integer
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
