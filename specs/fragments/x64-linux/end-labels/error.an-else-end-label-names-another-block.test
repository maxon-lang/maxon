// Test: error.an-else-end-label-names-another-block
function main() returns ExitCode
	var total = 0

	if total == 1 'one'
		total = 2
	end 'one' else 'other'
		total = 3
	end 'one'

	return total
end 'main'
---
CompilerError:
error E2008: <fragment>:9:2: Mismatched end label: expected 'other', got 'one'
