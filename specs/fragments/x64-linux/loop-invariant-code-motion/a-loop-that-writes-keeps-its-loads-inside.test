// Test: a-loop-that-writes-keeps-its-loads-inside
typealias Word = int(i64.min to i64.max)

type Cell
	export var value as Word

	export static function of(value Word) returns Cell
		return Self{value: value}
	end 'of'
end 'Cell'

function drain(c Cell, budget Word) returns Word
	var trips = 0
	var room = budget
	while c.value + room > 0 'loop'
		c.value = c.value - 1
		room = room - 1
		trips = trips + 1
	end 'loop'
	return trips
end 'drain'

function main() returns ExitCode
	var c = Cell.of(3)
	// 3+2, 2+1, 1+0, then 0+(-1) stops: three trips, and the field reaches zero.
	if drain(c, budget: 2) != 3 'trips'
		return 1
	end 'trips'
	if c.value != 0 'drained'
		return 2
	end 'drained'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 3
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 2
  __il_body:
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.leaRegRegReg rsi, rsi, rax
    x64.cmpRegImm32 rsi, 0
    x64.jcc lessEqual, __il_cont
  loop:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.leaRegRegImm32 rsi, rsi, -1
    x64.storeBaseDispReg.word64 [rcx + 0], rsi
    x64.leaRegRegImm32 rax, rax, -1
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp whilehdr
  __il_cont:
    x64.cmpRegImm32 rdx, 3
    x64.jcc equal, ifcont#2
  trips:
    x64.movRegImm32 r8, 1
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#4
  drained:
    x64.movRegImm32 r8, 2
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
