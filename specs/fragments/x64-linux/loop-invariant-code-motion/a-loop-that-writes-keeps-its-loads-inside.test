// Test: a-loop-that-writes-keeps-its-loads-inside
typealias Word = int(i64.min to i64.max)

type Cell
	export var value as Word

	export static function of(value Word) returns Cell
		return Self{value: value}
	end 'of'
end 'Cell'

function drain(c Cell, budget Word) returns Word
	var trips = 0
	var room = budget
	while c.value + room > 0 'loop'
		c.value = c.value - 1
		room = room - 1
		trips = trips + 1
	end 'loop'
	return trips
end 'drain'

function main() returns ExitCode
	var c = Cell.of(3)
	// 3+2, 2+1, 1+0, then 0+(-1) stops: three trips, and the field reaches zero.
	if drain(c, budget: 2) != 3 'trips'
		return 1
	end 'trips'
	if c.value != 0 'drained'
		return 2
	end 'drained'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 3
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#6:
    x64.movRegImm32 rax, 2
  __il_body#8:
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  loop:
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.leaRegRegImm32 rdx, rdx, -1
    x64.storeBaseDispReg.word64 [r8 + 0], rdx
    x64.leaRegRegImm32 rax, rax, -1
    x64.leaRegRegImm32 rcx, rcx, 1
  whilehdr:
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.leaRegRegReg rdx, rdx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc greater, loop
  __il_cont#5:
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, ifcont#2
  trips:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#4
  drained:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
