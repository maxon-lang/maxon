// Test: shrink-then-grow-reads-zero-past-a-byte-elements-old-length
function main() returns ExitCode
	var b = ByteArray.create()
	var i = 0
	while i < 5 'fill'
		b.push(9)
		i = i + 1
	end 'fill'
	b.resize(2)
	b.resize(5)
	var total = 0
	var k = 2
	while k < 5 'sum'
		total = total + (try b.get(k) otherwise 99)
		k = k + 1
	end 'sum'
	return total as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr#1
  fill:
    x64.movRegImm32 rdx, 9
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRegImm32 r12, r12, 1
  whilehdr#1:
    x64.cmpRegImm32 r12, 5
    x64.jcc less, fill
  whileexit#3:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rdx, 2
  __us_test:
    x64.loadRegBaseDisp.word64 r13, [rbx + 24]
    x64.loadRegBaseDisp.word64 r14, [rbx + 8]
    x64.loadRegBaseDisp.word64 r15, [rbx + 0]
    x64.jmp whilehdr#4
  __rc_ok#10:
    x64.cmpRegImm32 r13, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.cmpRegReg rdx, r14
    x64.jcc aboveEqual, __im_slow
  __im_load#21:
    x64.loadRegBaseIndexScale.word64 rax, [r15 + rdx*8 + 0]
    x64.jmp trycont
  __im_stride:
    x64.cmpRegImm32 r13, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.cmpRegReg rdx, r14
    x64.jcc aboveEqual, __im_slow
  __im_load#22:
    x64.leaRegRegReg rax, r15, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp trycont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
  tryerr:
    x64.movRegImm32 rax, 99
    x64.jmp trycont
  critsplit:
    x64.movRegReg rax, r8
  trycont:
    x64.leaRegRegReg r12, r12, rax
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rdx, rax, 1
  whilehdr#4:
    x64.storeSlotReg slot0, rdx
    x64.cmpRegImm32 rdx, 5
    x64.jcc less, __rc_ok#10
  whileexit#6:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok#12:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at shrink-then-grow-reads-zero-past-a-byte-elements-old-length.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
