// Test: process-background-priority.answers-the-posix-nice-value
function main() returns ExitCode
	let backgroundNiceValue = 10
	let normalNiceValue = 0
	let priority = __Builtins.enterBackgroundPriority()
	var score = 0
	if priority == backgroundNiceValue 'isBackground'
		score = score + 1
	end 'isBackground'
	if priority != normalNiceValue 'isNotStillNormal'
		score = score + 2
	end 'isNotStillNormal'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __proc_bg_priority
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 10
    x64.jcc notEqual, ifcont#2
  isBackground:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  isNotStillNormal:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp ifcont#4
  critsplit:
    x64.movRegReg r8, rax
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at process-background-priority.answers-the-posix-nice-value.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
