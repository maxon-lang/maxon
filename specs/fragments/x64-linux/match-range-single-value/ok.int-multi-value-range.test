// Test: ok.int-multi-value-range
function main() returns ExitCode
	let x = 6
	let result = match x 'eval'
		5 to 7 gives 0
		default gives 1
	end 'eval'
	return result
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
