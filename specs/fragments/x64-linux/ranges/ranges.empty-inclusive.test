// Test: ranges.empty-inclusive
function main() returns ExitCode
		var count = 0
		for _ in 5 to 3 'loop'
				count = count + 1
		end 'loop'
		return count
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
