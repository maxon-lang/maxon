// Test: enum-ordinal.bare-case-arithmetic-index
typealias Idx = int(0 to u64.max)
typealias IdxArray = Array with Idx

enum Col
	a
	b
	c
	COUNT
end 'Col'

enum Row
	x
	y
	COUNT
end 'Row'

function lookup(table IdxArray, index Idx) returns Idx
	return try table.get(index) otherwise 0
end 'lookup'

function main() returns ExitCode
	var table = IdxArray.create()
	var i = 0
	while i < 100 'fill'
		table.push(i)
		i = i + 1
	end 'fill'
	let col = Col.b
	let idx = Row.y * Col.COUNT + col
	return lookup(table, index: idx)
end 'main'
---
ExitCode: 4
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  __rc_ok#4:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.leaRegRegImm32 r12, r12, 1
  whilehdr:
    x64.cmpRegImm32 r12, 100
    x64.jcc less, __rc_ok#4
  whileexit:
    x64.movRegImm32 rdx, 4
  __rc_ok#14:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 4
    x64.jcc belowEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 r12, 0
    x64.jmp __il_cont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 32
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegReg r8, rax
  tryok:
    x64.movRegReg r12, r8
  __il_cont:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok#6:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at enum-ordinal.bare-case-arithmetic-index.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
