// Test: a-constraint-bound-result-crosses-from-the-owner-types-file
// --- file: a.maxon
typealias Level = int(0 to 100)

interface Cursor uses Element
	function current() returns Element
end 'Cursor'

type Gauge implements Cursor with Level
	var v as Level

	static function create() returns Self
		return Self{v: 90}
	end 'create'

	function current() returns Level
		return self.v
	end 'current'
end 'Gauge'

type W uses S where S is Cursor with Level
	var s as S

	static function create(s S) returns Self
		return Self{s: s}
	end 'create'

	function read() returns Level
		return self.s.current()
	end 'read'
end 'W'

typealias GaugeW = W with Gauge

function main() returns ExitCode
	let w = GaugeW.create(Gauge.create())
	if smallOk() 'ok'
		return w.read()
	end 'ok'
	return 1
end 'main'

// --- file: z.maxon
typealias Level = int(0 to 3)

export function smallOk() returns bool
	let low = 1 as Level
	return low == 1
end 'smallOk'
---
ExitCode: 90
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Gauge.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#6:
    x64.movRegImm32 rbx, 90
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Gauge.Cursor]
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#4:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
  ok:
    x64.leaRegRdata rax, [rip + __layout_W_Gauge]
    x64.leaRegRdata rax, [rip + __witness_Gauge.Cursor]
  __il_body#10:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callMem [rax + 48]
    x64.movRegReg rbx, r8
  __il_cont#9:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_W_Gauge
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
