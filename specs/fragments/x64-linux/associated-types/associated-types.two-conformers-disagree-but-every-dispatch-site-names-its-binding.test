// Test: associated-types.two-conformers-disagree-but-every-dispatch-site-names-its-binding
typealias Integer = int(i64.min to i64.max)
typealias IntTaker = Taker with Integer
typealias TextTaker = Taker with String

interface Taker uses Element
	function take(e Element) returns Integer
end 'Taker'

type IntRunner implements Taker with Integer
	let base as Integer

	function take(e Integer) returns Integer
		return base + e
	end 'take'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'IntRunner'

type TextRunner implements Taker with String
	let base as Integer

	function take(e String) returns Integer
		return base + (e.byteLength() as Integer)
	end 'take'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'TextRunner'

function useInt(t IntTaker) returns Integer
	return t.take(20)
end 'useInt'

function useText(t TextTaker) returns Integer
	return t.take("abcdefghij")
end 'useText'

function main() returns ExitCode
	return (useInt(IntRunner.create(20)) + useText(TextRunner.create(11))) as ExitCode
end 'main'
---
ExitCode: 61
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @IntRunner.take {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg r8, rax, rdx
    x64.popReg rbp
    x64.ret
}

func @TextRunner.take {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
  __il_cont:
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 20
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#7:
    x64.leaRegRdata rax, [rip + __witness_IntRunner.Taker]
  __il_body#9:
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, r12
    x64.callMem [rax + 40]
    x64.movRegReg rbx, r8
  __il_cont#6:
    x64.movRegImm32 r13, 11
  __il_body#10:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], r13
  __il_cont#5:
    x64.leaRegRdata rax, [rip + __witness_TextRunner.Taker]
  __il_body#11:
    x64.leaRegRdata rdx, [rip + __str_rec_1]  ; "abcdefghij"
    x64.movRegReg rcx, r14
    x64.callMem [rax + 40]
  __il_cont#4:
    x64.leaRegRegReg rbx, rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at associated-types.two-conformers-disagree-but-every-dispatch-site-names-its-binding.test:43: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
