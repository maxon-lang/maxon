// Test: a-buffer-alias-serves-the-roster-at-a-declared-return
typealias Byte = int(0 to u8.max)
typealias ByteBuffer = __ManagedMemory with Byte

function makeBuf() returns ByteBuffer
	return "hello".toByteArray()
end 'makeBuf'

function main() returns ExitCode
	return makeBuf().length() as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body#5:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello"
  __il_body#7:
    x64.movRegImm32 rdx, 0
  __il_body#11:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont#10:
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at String.maxon:161: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont#4:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 8]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-buffer-alias-serves-the-roster-at-a-declared-return.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
