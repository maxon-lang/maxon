// Test: an-inner-alias-return-carries-the-argument-spelling-one-hop-further
type Cell uses U
	export var slot as U

	export static function make(slot U) returns Self
		return Self{slot: slot}
	end 'make'

	export function get() returns U
		return slot
	end 'get'
end 'Cell'

type Holder uses T
	typealias TCell = Cell with T
	export var cell as TCell

	export static function make(cell TCell) returns Self
		return Self{cell: cell}
	end 'make'

	export function inner() returns TCell
		return cell
	end 'inner'
end 'Holder'

typealias BufCell = Cell with __ManagedMemory
typealias BufHolder = Holder with __ManagedMemory

function main() returns ExitCode
	let h = BufHolder.make(BufCell.make("hello".toByteArray()))
	return h.inner().get().length() as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello"
  __il_body#13:
    x64.movRegImm32 rdx, 0
  __il_body#17:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont#16:
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at String.maxon:157: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont#12:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.movRegReg rbx, r8
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_body#9:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [rbx + 0], r13
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  __il_cont#6:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_body#10:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
  __il_cont#5:
    x64.leaRegRdata rcx, [rip + __layout_Cell___ManagedMemory]
  __il_body#11:
    x64.loadRegBaseDisp.word64 rdx, [r12 + 0]
    x64.callDirect __retain_type_param
  __il_cont#4:
    x64.loadRegBaseDisp.word64 r13, [r8 + 8]
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Cell___ManagedMemory
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder___ManagedMemory
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at an-inner-alias-return-carries-the-argument-spelling-one-hop-further.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
