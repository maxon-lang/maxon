// Test: struct-payload-dispatch
typealias Val = int(0 to 1000)

type Wrapped
	export var n as Val

	static function create(x Val) returns Wrapped
		return Self{n: x}
	end 'create'
end 'Wrapped'

union Holder
	full(w Wrapped)
	empty
end 'Holder'

function get(h Holder) returns Val
	return match h 'm'
		full(w) gives w.n
		empty gives 0
	end 'm'
end 'get'

function main() returns ExitCode
	return get(Holder.full(Wrapped.create(7)))
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 7
  __rc_ok#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], r12
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#11:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 r13, [r12 + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.jmp __il_cont#4
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#12:
    x64.movRegImm32 r12, 0
    x64.movRegReg r13, r12
  __il_cont#4:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
  __rc_ok#1:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at struct-payload-dispatch.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
