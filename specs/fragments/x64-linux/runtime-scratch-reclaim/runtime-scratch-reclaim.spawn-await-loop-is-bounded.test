func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect __parallel_boundary
    x64.leaRegRegImm32 r8, rbx, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @spawnAndAwait {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.leaRegFunc rcx, [rip + work]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 200], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r12
    x64.callDirect __gt_await
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect spawnAndAwait
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r12, r8
    x64.callDirect __mm_counter_raw_alloc_live
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
