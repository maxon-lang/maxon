    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r14, r8
    x64.subRegReg r14, r8, r12
    x64.callDirect __mm_counter_raw_alloc_live
    x64.subRegReg r8, r8, r13
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rbx, 9
    x64.jcc notEqual, ifcont#2
  everyThreadRanExactlyOnce:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.cmpRegImm32 r14, 8
    x64.jcc less, ifcont#4
  eachSpawnTookAStruct:
    x64.leaRegRegImm32 rax, rax, 2
  ifcont#4:
    x64.cmpRegImm32 r8, 1
    x64.jcc greater, critsplit
  andEachAwaitGaveItBack:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#6
  critsplit:
    x64.movRegReg r8, rax
  ifcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at runtime-scratch-reclaim.spawn-await-loop-is-bounded.test:36: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
