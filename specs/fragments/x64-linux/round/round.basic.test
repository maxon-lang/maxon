// Test: round.basic
function main() returns ExitCode
	let x = 3.7
	let y = trunc(round(x))
	return y
end 'main'
---
ExitCode: 4
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 4
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
