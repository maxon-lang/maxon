// Test: return-a-minus-b
function diff(a Integer, b Integer) returns Integer
	return a - b
end 'diff'

function chainDiff(a Integer, b Integer, c Integer) returns Integer
	return a - b - c
end 'chainDiff'

function main() returns ExitCode
	let r = diff(200, b: 137) * 1000 + chainDiff(90, b: 20, c: 5)
	if r == 63065 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 63
  __il_cont#4:
    x64.imulRegRegImm32 rax, rax, 1000
  __il_cont#3:
    x64.leaRegRegImm32 rax, rax, 65
    x64.cmpRegImm32 rax, 63065
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
