// Test: public-constant-and-var-are-visible-across-files
// --- file: api/limits.maxon
public let BASE = 30
public var counter = 5

// --- file: app/main.maxon
function main() returns ExitCode
	counter = counter + BASE
	return counter
end 'main'
---
ExitCode: 35
---
data {
  __data_counter@0 = i64 5
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_counter
    x64.aluBaseDispImm32.add [rax + 0], 30
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at main.maxon:3: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
