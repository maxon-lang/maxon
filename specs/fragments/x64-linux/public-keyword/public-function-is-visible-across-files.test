// Test: public-function-is-visible-across-files
// --- file: api/lib.maxon
public typealias Integer = int(i64.min to i64.max)

public function answer() returns Integer
	return 42
end 'answer'

// --- file: app/main.maxon
function main() returns ExitCode
	return answer()
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
