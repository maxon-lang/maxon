// Test: jump-table.four-cases-expression
enum Direction
		north
		south
		east
		west
end 'Direction'

function main() returns ExitCode
		let d = Direction.east
		let code = match d 'dir'
				north gives 10
				south gives 20
				east gives 30
				west gives 40
		end 'dir'
		return code
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_1
  matchdead:
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.jmp __rc_ok
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.jmp __rc_ok
  matcharm#3:
    x64.movRegImm32 r8, 30
    x64.jmp __rc_ok
  matcharm#4:
    x64.movRegImm32 r8, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
