// Test: if-else-block-before-later-sibling

typealias Integer = int(i64.min to i64.max)

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function branchy(x Integer) returns Integer
		if x > 0 'pos'
			return helper() + 1
		end 'pos' else 'neg'
			return helper()
		end 'neg'
	end 'branchy'

	function helper() returns Integer
		return 5
	end 'helper'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.branchy(1)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#6:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#12:
    x64.movRegImm32 rax, 5
  __il_cont:
    x64.leaRegRegImm32 rbx, rax, 1
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
