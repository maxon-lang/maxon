// Test: Self-case-in-every-arm-of-a-match
typealias Num = int(0 to 100)

union R
	a(v Num)
	b(v Num)
	c

	export function norm() returns R
		return match self 'k'
			a(v) gives Self.b(v)
			b(v) gives Self.a(v)
			c gives Self.c
		end 'k'
	end 'norm'
end 'R'

function main() returns ExitCode
	let x = R.a(42)
	let y = x.norm()
	return match y 'k'
		a gives 1
		b(v) gives v
		c gives 2
	end 'k'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 42
    x64.movRegImm32 rax, 0
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#17
  matcharm#13:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.movRegReg rcx, r8
    x64.jmp __il_cont
  matchnext#17:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#18
  matcharm#14:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.movRegReg rcx, r8
    x64.jmp __il_cont
  matchnext#18:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead#16
  matcharm#15:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegReg rcx, r8
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead#4
  matcharm#3:
    x64.movRegImm32 rbx, 2
  matchcont:
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#4:
  matchdead#16:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at Self-case-in-every-arm-of-a-match.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
