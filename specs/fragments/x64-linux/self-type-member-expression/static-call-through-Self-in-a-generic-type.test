// Test: static-call-through-Self-in-a-generic-type
typealias Num = int(0 to 1000)

type Box uses T
	export var v as T

	export static function make(x T) returns Self
		return Self{v: x}
	end 'make'

	export static function twice(x T) returns Self
		return Self.make(x)
	end 'twice'
end 'Box'

typealias IntBox = Box with Num

function main() returns ExitCode
	return IntBox.twice(42).v
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 42
    x64.leaRegRdata rax, [rip + __layout_Box_Num]
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at static-call-through-Self-in-a-generic-type.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
