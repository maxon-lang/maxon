// Test: managed-payload-case-through-Self
union Msg
	text(s String)
	silent

	export function shout() returns Msg
		return Self.text("hi")
	end 'shout'
end 'Msg'

function main() returns ExitCode
	let m = Msg.silent
	let n = m.shout()
	return match n 'k'
		text(s) gives s.byteLength() as ExitCode
		silent gives 1
	end 'k'
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
  __il_body#10:
    x64.leaRegRdata r12, [rip + __str_rec_1]  ; "hi"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
  __il_cont#9:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 r12, [r13 + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  __il_body#12:
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
  __il_cont#11:
    x64.cmpRegImm32 r14, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r14, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r12, 1
    x64.movRegReg r14, r12
  matchcont:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Msg
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Msg
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at managed-payload-case-through-Self.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
