// Test: static-method-named-Self-through-Self
typealias Num = int(0 to 1000)

type Gate
	export var n as Num

	static function make(v Num) returns Gate
		return Self{n: v}
	end 'make'

	static function Self(v Num) returns Num
		return v
	end 'Self'

	function twin() returns Num
		return Self.Self(42)
	end 'twin'
end 'Gate'

function main() returns ExitCode
	return Gate.make(0).twin()
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  __rc_ok#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body:
    x64.movRegImm32 rbx, 42
  __rc_ok#1:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
