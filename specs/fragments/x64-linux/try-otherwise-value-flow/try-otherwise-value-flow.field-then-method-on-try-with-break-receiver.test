// Test: try-otherwise-value-flow.field-then-method-on-try-with-break-receiver
type Row
	export var label as String

	export static function create(label String) returns Row
		return Self{label: label}
	end 'create'
end 'Row'

typealias RowArray = Array with Row

function longestLen(rows RowArray) returns ExitCode
	var best = 0
	var i = 0
	while i < rows.count() 'scan'
		let len = (try rows.get(i) otherwise break).label.count()
		if len > best 'bigger'
			best = len
		end 'bigger'
		i = i + 1
	end 'scan'
	return best as ExitCode
end 'longestLen'

function main() returns ExitCode
	var rows = RowArray.create()
	rows.push(Row.create("ab"))
	rows.push(Row.create("abcd"))
	rows.push(Row.create("a"))
	return longestLen(rows)
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Row.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

