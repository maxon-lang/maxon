// Test: static-method-statement.void-static-for-effect
type Helper
	static function shout()
		print("hi")
	end 'shout'
end 'Helper'

function main() returns ExitCode
	Helper.shout()
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body#2:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hi"
  __il_body#4:
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
