// Test: assign-constants-enum-to-backing

typealias Byte = int(0 to u8.max)

enum JsonByte as Byte
	lBracket = 91
	rBracket = 93
end 'JsonByte'

function main() returns ExitCode
	var b = 0 as Byte
	b = JsonByte.lBracket
	return b
end 'main'
---
ExitCode: 91
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 91
    x64.popReg rbp
    x64.ret
}
