// Test: assign-ranged-typealias

typealias Score = int(0 to 100)

function main() returns ExitCode
	var s = 0 as Score
	s = 5
	s = s + 20
	return s
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 25
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
