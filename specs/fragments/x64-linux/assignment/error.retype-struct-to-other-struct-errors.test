// Test: error.retype-struct-to-other-struct-errors

typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer

	static function create(x Integer) returns Self
		return Self{x: x}
	end 'create'
end 'Point'

type Other
	export var v as Integer

	static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'Other'

function main() returns ExitCode
	var p = Point.create(1)
	p = Other.create(2)
	print("{p.x}")
	return 0 as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:23:2: cannot assign a value of type 'Other' to variable 'p', which holds 'Point'
