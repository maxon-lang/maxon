    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at a-constant-divisor-gives-the-same-answer-as-a-runtime-one.test:11: Range check failed: value outside typealias 'PosDivisor'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

