    x64.imulRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at an-assignment-replaces-an-interface-typed-field-with-another-conformer.test:16: Range check failed: value outside typealias 'Tally'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

