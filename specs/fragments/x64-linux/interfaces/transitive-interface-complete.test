// Test: transitive-interface-complete

typealias Integer = int(i64.min to i64.max)

interface BaseInterface
	function baseMethod() returns Integer
end 'BaseInterface'

interface DerivedInterface extends BaseInterface
	function derivedMethod() returns Integer
end 'DerivedInterface'

// CompleteType implements all methods from both interfaces
type CompleteType implements DerivedInterface
	let value as Integer

	function baseMethod() returns Integer
		return value
	end 'baseMethod'

	function derivedMethod() returns Integer
		return value * 2
	end 'derivedMethod'

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'CompleteType'

function main() returns ExitCode
	let t = CompleteType.create(21)
	return t.baseMethod() + t.derivedMethod()
end 'main'
---
ExitCode: 63
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 21
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_body#9:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.imulRegRegImm32 rcx, rcx, 2
  __il_cont:
    x64.leaRegRegReg rbx, rax, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at transitive-interface-complete.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
