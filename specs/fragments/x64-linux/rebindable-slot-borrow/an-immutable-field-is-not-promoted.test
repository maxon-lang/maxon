// Test: an-immutable-field-is-not-promoted
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Frozen
	let items as IntArray

	export static function create() returns Self
		var a = IntArray.create()
		a.push(4)
		a.push(5)
		return Self{items: a}
	end 'create'

	export function total() returns Integer
		let held = items

		var sum = 0
		for i in 0 upto held.count() 'walk'
			sum = sum + (try held.get(i) otherwise 0)
		end 'walk'
		return sum
	end 'total'
end 'Frozen'

function main() returns ExitCode
	var f = Frozen.create()
	return f.total() as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rax + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp forhdr
  __im_load:
    x64.loadRegBaseIndexScale.word64 rsi, [rax + rcx*8 + 0]
  trycont:
    x64.leaRegRegReg rbx, rbx, rsi
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
  forhdr:
    x64.cmpRegReg rcx, rdx
    x64.jcc less, __im_load
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Frozen
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at an-immutable-field-is-not-promoted.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
