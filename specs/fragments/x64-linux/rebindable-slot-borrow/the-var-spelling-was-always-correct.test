// Test: the-var-spelling-was-always-correct
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Holder
	var items as IntArray

	export static function create() returns Self
		return Self{items: IntArray.create()}
	end 'create'

	export function swapAndRead() returns Integer
		items.push(3)
		items.push(4)
		var old = items
		items = IntArray.create()

		var sum = 0
		for i in 0 upto old.count() 'walk'
			sum = sum + (try old.get(i) otherwise 0)
		end 'walk'
		return sum
	end 'swapAndRead'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	return h.swapAndRead() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#7:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.movRegImm32 rdx, 3
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.movRegImm32 rdx, 4
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callDirect __managed_retain
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callDirect __managed_decref
    x64.storeBaseDispReg.word64 [r12 + 0], r13
    x64.movRegImm32 r13, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr
  __im_load:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  trycont:
    x64.leaRegRegReg r13, r13, rsi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc less, __im_load
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at the-var-spelling-was-always-correct.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
