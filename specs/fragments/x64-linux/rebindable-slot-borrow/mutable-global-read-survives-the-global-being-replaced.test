// Test: mutable-global-read-survives-the-global-being-replaced
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

var G = IntArray.create()

function main() returns ExitCode
	G.push(1)
	G.push(2)
	let old = G
	var fresh = IntArray.create()
	fresh.push(99)
	G = fresh

	var sum = 0
	for i in 0 upto old.count() 'walk'
		sum = sum + (try old.get(i) otherwise 0)
	end 'walk'
	print("sum {sum}")
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __data_G@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.leaRegGlobal rax, __data_G
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_push
    x64.leaRegGlobal rax, __data_G
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 2
    x64.callDirect __managed_push
    x64.leaRegGlobal rax, __data_G
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __managed_retain
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.storeSlotReg slot1, r12
    x64.movRegImm32 rdx, 99
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
    x64.leaRegGlobal rax, __data_G
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __managed_decref
    x64.leaRegGlobal rax, __data_G
    x64.storeBaseDispReg.word64 [rax + 0], r12
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr
  __im_load:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  trycont:
    x64.leaRegRegReg r12, r12, rsi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc less, __im_load
  forexit:
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; "sum "
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRegReg rax, r13, r12
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot2
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
  __il_body:
    x64.loadRegSlot rcx, slot3
    x64.callDirect __write_stdout
  __il_cont:
    x64.loadRegSlot rcx, slot3
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
