// Test: managed-field-read-survives-the-field-being-replaced
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Holder
	var items as IntArray

	export static function create() returns Self
		return Self{items: IntArray.create()}
	end 'create'

	export function fill(n Integer)
		for i in 0 upto n 'each'
			items.push(i)
		end 'each'
	end 'fill'

	export function swapAndRead() returns Integer
		let old = items
		var fresh = IntArray.create()
		fresh.push(99)
		items = fresh

		var sum = 0
		for i in 0 upto old.count() 'walk'
			sum = sum + (try old.get(i) otherwise 0)
		end 'walk'
		return sum
	end 'swapAndRead'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	h.fill(5)
	return h.swapAndRead() as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#8:
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr#9
  each:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
  forstep#11:
    x64.leaRegRegImm32 rbx, rbx, 1
  forhdr#9:
    x64.cmpRegImm32 rbx, 5
    x64.jcc less, each
  __il_body#13:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callDirect __managed_retain
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 99
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 r14, [r12 + 0]
    x64.movRegReg rcx, r13
    x64.callDirect __managed_retain
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.storeBaseDispReg.word64 [r12 + 0], r15
    x64.movRegImm32 r14, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr#14
  __im_load:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  trycont:
    x64.leaRegRegReg r14, r14, rsi
  forstep#16:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr#14:
    x64.cmpRegReg rax, rcx
    x64.jcc less, __im_load
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont:
    x64.cmpRegImm32 r14, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r14, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r14
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at managed-field-read-survives-the-field-being-replaced.test:35: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
