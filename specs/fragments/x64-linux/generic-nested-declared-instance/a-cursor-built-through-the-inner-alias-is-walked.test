// Test: a-cursor-built-through-the-inner-alias-is-walked
typealias Int = int(i64.min to i64.max)

type BagIter uses E implements Iterator with Int
	typealias EArray = Array with E
	var items as EArray
	var i as Int

	static function create() returns Self
		return Self{items: EArray.create(), i: 3}
	end 'create'

	function current() returns Int
		return i
	end 'current'

	function advance() throws IterationError
		i = i - 1
		if i <= 0 'exhausted'
			throw IterationError.exhausted
		end 'exhausted'
	end 'advance'
end 'BagIter'

type Bag uses Element implements Iterable with (Int, BIter)
	export typealias BIter = BagIter with Element
	var n as Int

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function createIterator() returns BIter throws IterationError
		return BIter.create()
	end 'createIterator'

	function walk() returns Int
		var total = 0
		for x in self 'loop'
			total = total + x
		end 'loop'
		return total
	end 'walk'
end 'Bag'

typealias IntBag = Bag with Int

function main() returns ExitCode
	var b = IntBag.create()
	return b.walk()
end 'main'
---
ExitCode: 6
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @BagIter.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.aluBaseDispImm32.sub [rcx + 8], 1
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, ifcont
  exhausted:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @Bag.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rdx + 40]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 3
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
  __il_cont:
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#4:
    x64.leaRegRdata rdx, [rip + __layout_Bag_Int]
  __il_body#7:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect Bag.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forhdr
    x64.jmp __il_cont#6
  __il_body#15:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
  __il_cont#14:
    x64.leaRegRegReg rbx, rbx, rax
  forstep:
    x64.movRegReg rcx, r13
    x64.callDirect BagIter.advance
    x64.movRegReg rax, r10
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#15
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_BagIter_T779624e88745be2b
  __il_cont#6:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-cursor-built-through-the-inner-alias-is-walked.test:50: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
