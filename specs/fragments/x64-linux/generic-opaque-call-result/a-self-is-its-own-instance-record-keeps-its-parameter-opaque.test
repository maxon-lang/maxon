    x64.leaRegRdata r12, [rip + __str_rec_2]  ; "a stored string long enough to force a heap allocation"
    x64.leaRegRdata r13, [rip + __layout_Array_String]
    x64.leaRegRdata r14, [rip + __witness_String.Equatable]
  __il_body#7:
    x64.movRegImm32 rdx, 0
