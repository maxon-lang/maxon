    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_15]  ; "panic at a-self-is-its-own-instance-record-keeps-its-parameter-opaque.test:45: Range check failed: value outside typealias 'ExitCode'\x0a"
