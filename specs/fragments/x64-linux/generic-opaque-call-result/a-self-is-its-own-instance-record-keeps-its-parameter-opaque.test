// Test: a-self-is-its-own-instance-record-keeps-its-parameter-opaque
typealias Idx = int(0 to u64.max)

enum BagError implements Error
	oob
end 'BagError'

type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element
	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'

	export function count() returns Idx
		return managed.length()
	end 'count'

	export function at(i Idx) returns Element throws BagError
		return try managed.get(i) otherwise throw BagError.oob
	end 'at'
end 'Array'

extension Array where Element is Equatable
	export function contains(element Element) returns bool
		let mine = try at(0) otherwise return false
		return mine == element
	end 'contains'
end 'Array'

typealias StrArray = Array with String

function main() returns ExitCode
	var b = StrArray.create()
	b.push("a stored string long enough to force a heap allocation")
	if not b.contains("a stored string long enough to force a heap allocation") 'missing'
		return 1
	end 'missing'
	print("found\n")
	return b.count() as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Array.at {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_ok:
    x64.loadRegBaseDisp.word64 rax, [rcx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load#11:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + rdx*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load#12:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#14
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
  critsplit#15:
    x64.movRegReg rdx, rax
    x64.jmp __im_cont
  critsplit#14:
    x64.movRegReg rdx, rax
    x64.jmp __im_cont
  __im_slow:
    x64.callDirect __managed_get
    x64.movRegReg rdx, r8
    x64.movRegReg rsi, r10
  __im_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __retain_type_param
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_14]  ; "panic at a-self-is-its-own-instance-record-keeps-its-parameter-opaque.test:24: Range check failed: value outside typealias 'Idx'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
