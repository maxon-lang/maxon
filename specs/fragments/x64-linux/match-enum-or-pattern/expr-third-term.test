// Test: expr-third-term
enum E
	a
	b
	c
	d
end 'E'

function pick(v E) returns ExitCode
	return match v 'm'
		a or
			b or
			c gives 7
		d gives 9
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(E.c)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 7
  __il_cont:
    x64.popReg rbp
    x64.ret
}
