// Test: cycle-indirect-via-container
typealias FolderArray = Array with Folder

type Folder
	export var name as String
	export var children as FolderArray
end 'Folder'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E4014: <fragment>:4:6: type 'Folder' contains a reference cycle (via Folder → children: FolderArray → Folder); recursive type references are not allowed
