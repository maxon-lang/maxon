// Test: an-interface-field-is-legal-when-no-conformer-reaches-back
typealias Small = int(0 to 255)

interface Backref
	function tag() returns Small
end 'Backref'

type Plain implements Backref
	let mark as Small

	static function create(m Small) returns Self
		return Self{mark: m}
	end 'create'

	function tag() returns Small
		return self.mark
	end 'tag'
end 'Plain'

type Cell
	var back as Backref

	static function create(b Backref) returns Self
		return Self{back: b}
	end 'create'

	function tag() returns Small
		return self.back.tag()
	end 'tag'
end 'Cell'

function main() returns ExitCode
	let c = Cell.create(Plain.create(7))
	return c.tag() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Plain.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.andRegImm32 r8, rcx, 255
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __rc_ok:
    x64.movRegImm32 rbx, 7
  __il_cont#3:
    x64.leaRegRdata r12, [rip + __witness_Plain.Backref]
  __il_body#8:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
  __il_body#9:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.callMem [rax + 48]
    x64.movRegReg rbx, r8
  __il_cont#1:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Cell
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
