// Test: the-panic-rule-holds-when-the-argument-is-an-inlined-element
typealias Percent = int(0 to 100)

function clampPct(x Percent) returns Percent
	return x
end 'clampPct'

function main() returns ExitCode
	let a = [101]
	var last = 0
	for v in a 'each'
		last = clampPct(v)
	end 'each'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.jmp forhdr
  each:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __il_body:
    x64.cmpRegImm32 rsi, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.cmpRegImm32 rsi, 100
    x64.jcc greater, __rc_panic#12
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg rbx, rsi
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc less, each
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#6
  __rc_chk#7:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic#6
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at the-panic-rule-holds-when-the-argument-is-an-inlined-element.test:4: Range check failed: value outside typealias 'Percent'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at the-panic-rule-holds-when-the-argument-is-an-inlined-element.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
