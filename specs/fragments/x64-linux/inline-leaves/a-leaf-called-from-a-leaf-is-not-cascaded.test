// Test: a-leaf-called-from-a-leaf-is-not-cascaded
typealias Integer = int(i64.min to i64.max)

function inner(a Integer) returns Integer
	return a + 1
end 'inner'

function outer(a Integer) returns Integer
	return inner(a) * 2
end 'outer'

function main() returns ExitCode
	return outer(20) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 21
  __il_cont:
    x64.imulRegRegImm32 r8, rax, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
