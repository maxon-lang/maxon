// Test: process-namespace.is-named
function main() returns ExitCode
	let name = String.init(__Builtins.processNamespace())

	if name.isEmpty() 'unnamed'
		return 1
	end 'unnamed'

	return 3
end 'main'
---
ExitCode: 3
---
