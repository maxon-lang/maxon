// Test: filepath-normalize-folds-dot-segments
function main() returns ExitCode
	for spelled in ["a/./b/../c", "a//b/", "../a/../../b", "a/..", "./", ""] 'eachPath'
		let p = try FilePath.from(spelled) otherwise panic("unspellable path '{spelled}'")
		print("[{p.normalize()}]\n")
	end 'eachPath'

	return 0
end 'main'
