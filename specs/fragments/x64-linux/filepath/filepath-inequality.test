// Test: filepath-inequality
function main() returns ExitCode
	let a = FilePath from "C:\\a.txt"
	let b = FilePath from "C:\\b.txt"
	if a != b 'neq'
		print("not equal\n")
	end 'neq'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_19]  ; "C:\\a.txt"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_20]  ; "C:\\b.txt"
    x64.callDirect FilePath.init
    x64.movRegReg r12, r8
  __il_body#4:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect FilePath.canonicalForCompare
    x64.movRegReg r13, r8
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callDirect FilePath.canonicalForCompare
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __str_eq
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
  __il_cont:
    x64.xorRegImm32 r15, r15, 1
    x64.cmpRegImm32 r15, 0
    x64.jcc equal, ifcont
  neq:
    x64.leaRegRdata rcx, [rip + __str_rec_21]  ; "not equal\x0a"
  __il_body#6:
    x64.callDirect __write_stdout
  ifcont:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_FilePath
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
