// Test: process-liveness.a-negative-id-is-not-alive
function main() returns ExitCode
	if __Builtins.processIsAlive(0 - 1) 'claimed'
		return 1
	end 'claimed'
	if __Builtins.processIsAlive(0 - __Builtins.currentProcessId()) 'mirrored'
		return 4
	end 'mirrored'
	return 3
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm rcx, 18446744073709551615
    x64.callDirect __proc_alive
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  claimed:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rbx, 0
    x64.callDirect __proc_pid
    x64.movRegReg rcx, rbx
    x64.subRegReg rcx, rbx, r8
    x64.callDirect __proc_alive
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  mirrored:
    x64.movRegImm32 r8, 4
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
