// Test: a-print-enters-a-kernel-bracket
function main() returns ExitCode
	let before = __Builtins.schedSyscallCount()
	print("writing\n")
	let entered = __Builtins.schedSyscallCount() - before
	print("entered={entered > 0}\n")

	return 0
end 'main'
