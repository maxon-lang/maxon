// Test: error.interface-typed-function-type-parameter
typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Sq implements Shape
	let s as Integer

	function area() returns Integer
		return self.s
	end 'area'

	static function create(s Integer) returns Self
		return Self{s: s}
	end 'create'
end 'Sq'

typealias ShapeFn = function(Shape) returns Integer

function measure(c Shape) returns Integer
	return c.area()
end 'measure'

function apply(f ShapeFn, v Shape) returns Integer
	return f(v)
end 'apply'

function main() returns ExitCode
	return apply(measure, v: Sq.create(31)) as ExitCode
end 'main'
---
CompilerError:
error E2015: <fragment>:20:30: Unsupported: a function type's parameter declared at the interface type 'Shape' — a value held at an interface type is a two-word fat pointer `(value, witness)`, and a function value is called through the uniform `(userargs, env)` indirect ABI, which carries one machine word per argument and reserves no adjacent slot for the witness half. Declare the parameter at a concrete type, or pass the interface to a named function DIRECTLY, whose signature reserves the adjacent slot
