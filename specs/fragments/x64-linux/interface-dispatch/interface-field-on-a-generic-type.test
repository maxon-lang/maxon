// Test: interface-field-on-a-generic-type
typealias Integer = int(i64.min to i64.max)
typealias IntBox = Box with Integer

interface Tagged
	function tag() returns Integer
end 'Tagged'

type Marker implements Tagged
	let n as Integer

	function tag() returns Integer
		return n
	end 'tag'

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Marker'

type Box uses T
	export let t as Tagged
	export let v as T

	static function create(t Tagged, v T) returns Self
		return Self{t: t, v: v}
	end 'create'

	function score() returns Integer
		return self.t.tag()
	end 'score'
end 'Box'

function main() returns ExitCode
	let b = IntBox.create(Marker.create(8), v: 1)
	return b.score()
end 'main'
---
ExitCode: 8
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Marker.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 8
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#6:
    x64.movRegImm32 rbx, 1
    x64.leaRegRdata r13, [rip + __witness_Marker.Tagged]
  __il_body#8:
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r12
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r14 + 0], r8
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.storeBaseDispReg.word64 [r14 + 16], rbx
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r12
    x64.callDirect __drop_existential
  __il_body#9:
    x64.loadRegBaseDisp.word64 rcx, [r14 + 0]
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.callMem [rax + 40]
    x64.movRegReg rbx, r8
  __il_cont#4:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Box_Integer
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at interface-field-on-a-generic-type.test:36: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
