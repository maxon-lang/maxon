// Test: a-witness-argument-of-a-contested-nominal-name-reads-the-interfaces-file
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

union Msg
	ping(n Integer)
	quit
end 'Msg'

interface Sink
	function take(m Msg) returns Integer
end 'Sink'

type Counter implements Sink
	let base as Integer

	static function create() returns Self
		return Self{base: 0}
	end 'create'

	function take(m Msg) returns Integer
		match m 'which'
			ping(n) then return self.base + n
			quit then return self.base
		end 'which'
	end 'take'
end 'Counter'

type Post
	let sink as Sink

	static function create() returns Self
		return Self{sink: Counter.create()}
	end 'create'

	function send() returns Integer
		return self.sink.take(Msg.ping(1))
	end 'send'
end 'Post'

function main() returns ExitCode
	let post = Post.create()
	if post.send() == 1 and bothWays() 'sent'
		return 1
	end 'sent'
	return 0
end 'main'

// --- file: z.maxon
typealias Msg = int(0 to 3)

export function bothWays() returns bool
	let low = 1 as Msg
	return low == 1
end 'bothWays'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @Counter.take {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 rax, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
  __il_body#12:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#11:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Counter.Sink]
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.storeBaseDispReg.word64 [rbx + 8], rax
  __il_body#6:
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.movRegImm32 r14, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r15 + 0], rax
    x64.storeBaseDispReg.word64 [r15 + 8], r14
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.callMem [r13 + 48]
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
  __il_cont#5:
    x64.cmpRegImm32 r12, 1
    x64.movRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  __il_body#8:
    x64.movRegImm32 rax, 1
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  sent:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Post
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Post
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
