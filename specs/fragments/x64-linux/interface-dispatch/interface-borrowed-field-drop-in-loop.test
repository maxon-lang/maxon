// Test: interface-borrowed-field-drop-in-loop
typealias StrArray = Array with String
typealias Tag = int(0 to u64.max)

interface Query
	function score() returns bool
end 'Query'

type ConcreteQuery implements Query
	export let tag as Tag

	static function create(tag Tag) returns ConcreteQuery
		return Self{tag: tag}
	end 'create'

	function score() returns bool
		return self.tag >= 0
	end 'score'
end 'ConcreteQuery'

// `Allocator` stores a BORROWED interface value into a field, alongside enough
// fresh state that its constructor exceeds the inline budget (a real non-inlined
// constructor, like the compiler's own `FunctionRegAllocator`). The allocator is a
// short-lived local dropped at the end of `allocateFor`, and its synthesized
// destructor decrefs the interface field. The conformer passed in is OWNED by
// `main` and kept alive across the whole loop, so the field holds only a BORROW —
// the destructor must NOT release it. Before interface values were refcount-managed
// consistently (the field is drop-tracked, but the borrowed value stored into it
// got no store-incref), the destructor over-released the caller's conformer — the
// `__destruct_FunctionRegAllocator` `regTarget`/`opQuery` over-release that blocked
// the self-hosted bootstrap. Runs under the suite's leak gate (and `--rc-sanitize`),
// so an over-release or leak fails it.
type Allocator
	export var query as Query
	export var f0 as StrArray
	export var f1 as StrArray
	export var f2 as StrArray
	export var f3 as StrArray
	export var f4 as StrArray
	export var f5 as StrArray

	static function create(query Query) returns Allocator
		return Self{query: query, f0: StrArray.create(), f1: StrArray.create(), f2: StrArray.create(), f3: StrArray.create(), f4: StrArray.create(), f5: StrArray.create()}
	end 'create'

	function run() returns bool
		return self.query.score() and self.f0.count() == 0
	end 'run'
end 'Allocator'

function allocateFor(query Query) returns bool
	var allocator = Allocator.create(query)
	return allocator.run()
end 'allocateFor'

function main() returns ExitCode
	let concrete = ConcreteQuery.create(7)
	var trueCount = 0
	var i = 0
	while i < 4 'loop'
		if allocateFor(concrete) 'ok'
			trueCount = trueCount + 1
		end 'ok'
		i = i + 1
	end 'loop'
	return trueCount
end 'main'
---
ExitCode: 4
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @ConcreteQuery.score {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.setccReg aboveEqual, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
  __rc_ok#11:
    x64.movRegImm32 rbx, 7
  __il_cont#9:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  loop:
    x64.leaRegRdata r12, [rip + __witness_ConcreteQuery.Query]
  __il_body#14:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.movRegReg r13, r8
    x64.storeSlotReg slot2, r13
  __il_body#17:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r14, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.storeSlotReg slot7, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.storeSlotReg slot6, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.storeSlotReg slot5, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.storeSlotReg slot4, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.storeSlotReg slot3, r8
    x64.movRegImm32 rcx, 64
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r15 + 0], r8
    x64.storeBaseDispReg.word64 [r15 + 8], r12
    x64.storeBaseDispReg.word64 [r15 + 16], r14
    x64.loadRegSlot rax, slot7
    x64.storeBaseDispReg.word64 [r15 + 24], rax
    x64.loadRegSlot rax, slot6
    x64.storeBaseDispReg.word64 [r15 + 32], rax
    x64.loadRegSlot rax, slot5
    x64.storeBaseDispReg.word64 [r15 + 40], rax
    x64.loadRegSlot rax, slot4
    x64.storeBaseDispReg.word64 [r15 + 48], rax
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [r15 + 56], rax
    x64.loadRegSlot rdx, slot2
    x64.movRegReg rcx, r12
    x64.callDirect __drop_existential
  __il_body#18:
    x64.loadRegBaseDisp.word64 rcx, [r15 + 0]
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.callMem [rax + 48]
    x64.movRegImm32 r12, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, __il_cont#15
  andrhs:
    x64.loadRegBaseDisp.word64 rax, [r15 + 16]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, r12
  __il_cont#15:
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_Allocator
  __il_cont#13:
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, critsplit
  ok:
    x64.loadRegSlot rax, slot1
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont
  critsplit:
    x64.loadRegSlot rax, slot1
  ifcont:
    x64.loadRegSlot rcx, slot0
    x64.leaRegRegImm32 rcx, rcx, 1
  whilehdr:
    x64.storeSlotReg slot1, rax
    x64.storeSlotReg slot0, rcx
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, loop
  whileexit:
    x64.loadRegSlot rax, slot1
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.loadRegSlot rax, slot1
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic
  __rc_ok#6:
    x64.loadRegSlot r8, slot1
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at interface-borrowed-field-drop-in-loop.test:66: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
