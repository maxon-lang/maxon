// Test: interface-dispatch.interface-parameter-on-a-plain-function-still-compiles
typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Sq implements Shape
	let s as Integer

	function area() returns Integer
		return self.s
	end 'area'

	static function create(s Integer) returns Self
		return Self{s: s}
	end 'create'
end 'Sq'

function takeShape(c Shape, base Integer) returns Integer
	return base + c.area()
end 'takeShape'

type Holder
	let base as Integer

	function measure(c Shape) returns Integer
		return self.base + c.area()
	end 'measure'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Holder'

type Helper
	static function measure(c Shape, base Integer) returns Integer
		return base + c.area()
	end 'measure'
end 'Helper'

function main() returns ExitCode
	return (takeShape(Sq.create(11), base: 20) - Holder.create(20).measure(Sq.create(11)) + Helper.measure(Sq.create(11), base: 31)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Sq.area {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Sq.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 11
    x64.callDirect Sq.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Sq.Shape]
  __il_body#8:
    x64.movRegReg rcx, rbx
    x64.callMem [rax + 40]
    x64.leaRegRegImm32 r12, r8, 20
  __il_cont#7:
    x64.movRegImm32 r13, 20
  __il_body#9:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], r13
  __il_cont#6:
    x64.movRegImm32 rcx, 11
    x64.callDirect Sq.create
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __witness_Sq.Shape]
  __il_body#10:
    x64.loadRegBaseDisp.word64 r15, [r14 + 0]
    x64.movRegReg rcx, r13
    x64.callMem [rax + 40]
    x64.leaRegRegReg rax, r15, r8
  __il_cont#5:
    x64.subRegReg r12, r12, rax
    x64.movRegImm32 rcx, 11
    x64.callDirect Sq.create
    x64.movRegReg r15, r8
    x64.leaRegRdata rax, [rip + __witness_Sq.Shape]
  __il_body#11:
    x64.movRegReg rcx, r15
    x64.callMem [rax + 40]
    x64.leaRegRegImm32 rax, r8, 31
  __il_cont#4:
    x64.leaRegRegReg r12, r12, rax
