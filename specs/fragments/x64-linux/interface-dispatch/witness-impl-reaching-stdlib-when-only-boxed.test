// Test: witness-impl-reaching-stdlib-when-only-boxed
typealias Tag = int(0 to 100)

interface Printer
	function show()
end 'Printer'

type Thing implements Printer
	let label as Tag

	static function create(label Tag) returns Self
		return Self{label: label}
	end 'create'

	function show()
		print("never shown\n")
	end 'show'
end 'Thing'

type Holder
	let p as Printer
	export let n as ExitCode

	static function create(p Printer, n ExitCode) returns Self
		return Self{p: p, n: n}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(Thing.create(7), n: 3 as ExitCode)
	return h.n
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Thing.show {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "never shown\x0a"
  __il_body:
    x64.callDirect __write_stdout
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
  __rc_ok#4:
    x64.movRegImm32 rbx, 7
  __il_cont#2:
    x64.movRegImm32 r12, 3
    x64.leaRegRdata r13, [rip + __witness_Thing.Printer]
  __rc_ok#8:
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r14 + 0], r8
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.storeBaseDispReg.word64 [r14 + 16], r12
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
  __il_cont#1:
    x64.loadRegBaseDisp.word64 rbx, [r14 + 16]
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
