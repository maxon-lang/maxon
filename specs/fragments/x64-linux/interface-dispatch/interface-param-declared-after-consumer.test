// Test: interface-param-declared-after-consumer
typealias Num = int(0 to 100)

function run(q OpQuery) returns Num
	return q.value()
end 'run'

type X64Query implements OpQuery
	export var v as Num

	export static function make(v Num) returns X64Query
		return X64Query{v: v}
	end 'make'

	export function value() returns Num
		return self.v
	end 'value'
end 'X64Query'

interface OpQuery
	function value() returns Num
end 'OpQuery'

function main() returns ExitCode
	let q = X64Query.make(7)
	return run(q)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @run {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @X64Query.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at interface-param-declared-after-consumer.test:11: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @X64Query.value {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 7
    x64.callDirect X64Query.make
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __witness_X64Query.OpQuery]
    x64.movRegReg rcx, rbx
    x64.callDirect run
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
