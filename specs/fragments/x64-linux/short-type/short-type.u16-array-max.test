// Test: short-type.u16-array-max
typealias U16 = int(0 to 65535)
typealias Result = int(0 to u32.max)

function sumWide(a U16, b U16) returns Result
	return a + b
end 'sumWide'

function main() returns ExitCode
	let arr = [65535 as U16, 0 as U16, 1 as U16]
	let a = try arr.get(0) otherwise 0
	let b = try arr.get(2) otherwise 0
	// 65535 + 1 = 65536 (printed, not returned: 65536 > the valid
	// ExitCode range of 0..125 on the wasm target)
	print("{sumWide(a, b: b)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @sumWide {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 65535
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at short-type.u16-array-max.test:5: Range check failed: value outside typealias 'U16'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 rdx, 65535
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at short-type.u16-array-max.test:5: Range check failed: value outside typealias 'U16'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.leaRegRegReg r8, rcx, rdx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#8
  __rc_chk#9:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at short-type.u16-array-max.test:6: Range check failed: value outside typealias 'Result'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

