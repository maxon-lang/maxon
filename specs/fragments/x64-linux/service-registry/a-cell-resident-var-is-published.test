// Test: a-cell-resident-var-is-published
type Config
	export let n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Config'

typealias ConfigCell = SharedValue with Config

function refresh(c Config)
	c = Config.create(c.n + 1)
end 'refresh'

function main() returns ExitCode
	let cell = ConfigCell.create(Config.create(1))
	var next = Config.create(4)
	refresh(next)
	cell.publish(next)
	return cell.current().n as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @Config.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @refresh {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rcx, rax, 1
    x64.callDirect Config.create
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __mm_decref
    x64.movRegReg rax, r8
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect Config.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __share_Config
    x64.movRegReg rcx, r8
    x64.callDirect __mm_walk_settle
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.leaRegFunc rax, [rip + __mm_retain]
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_box_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 4
    x64.callDirect Config.create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.movRegReg rcx, r13
    x64.callDirect refresh
    x64.loadRegBaseDisp.word64 r12, [r13 + 0]
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __share_Config
    x64.movRegReg rcx, r8
    x64.callDirect __mm_walk_settle
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; ""
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __shv_publish
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_current
    x64.loadRegBaseDisp.word64 r12, [r8 + 0]
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_box_drop
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-cell-resident-var-is-published.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
