    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-value-default-may-hold-a-spawned-handle.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
