// Test: a-value-default-of-a-record-with-a-narrow-int-field
typealias Count = int(0 to 1000)

type Config
	export let n as Count

	static function create(n Count) returns Self
		return Self{n: n}
	end 'create'
end 'Config'

default Config = Config.create(3)

function main() returns ExitCode
	return Config.current().n as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __default.Config@0 = i64 0
  __mrt_envp@8 = i64 0
  __mrt_signal_stack_bytes@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
  __mrt_program_started@48 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rcx, __default.Config
    x64.callDirect __shv_current
    x64.andRegImm32 r8, r8, 65535
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-value-default-of-a-record-with-a-narrow-int-field.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
