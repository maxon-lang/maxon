// Test: zero-mantissa-ignores-a-wild-exponent
function main() returns ExitCode
	if 0.0e999 == 0.0 'isZero'
		return 1
	end 'isZero'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  isZero:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
