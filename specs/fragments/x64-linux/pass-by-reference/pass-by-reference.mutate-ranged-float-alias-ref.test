  __data_scale@0 = f64 1
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @setTo99 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic
  __rc_chk:
    x64.movsdRegRip xmm1, [rip + __fconst_1000]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, __rc_panic
  __rc_ok:
    x64.movsdRegRip xmm0, [rip + __fconst_99]
    x64.storeBaseDispReg.word64 [rcx + 0], xmm0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_205]  ; "panic at pass-by-reference.mutate-ranged-float-alias-ref.test:7: Range check failed: value outside typealias 'Weight'\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

