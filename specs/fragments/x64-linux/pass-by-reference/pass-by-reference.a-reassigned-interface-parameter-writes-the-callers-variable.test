// Test: pass-by-reference.a-reassigned-interface-parameter-writes-the-callers-variable
typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Square implements Shape
	var side as Integer

	static function create(side Integer) returns Self
		return Self{side: side}
	end 'create'

	function area() returns Integer
		return self.side * self.side
	end 'area'
end 'Square'

function squareShape(side Integer) returns Shape
	return Square.create(side)
end 'squareShape'

function grow(s Shape)
	if s.area() < 5 'small'
		s = squareShape(4)
	end 'small'
end 'grow'

function main() returns ExitCode
	var shape = squareShape(1)
	grow(shape)
	grow(squareShape(3))
	grow(Square.create(1))
	print("{shape.area()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @Square.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Square.area {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegReg r8, r8, rax
    x64.popReg rbp
    x64.ret
}

func @squareShape {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Square.create
    x64.leaRegRdata r10, [rip + __witness_Square.Shape]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @grow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.callMem [rax + 48]
    x64.cmpRegImm32 r8, 5
    x64.jcc greaterEqual, ifcont
  small:
    x64.movRegImm32 rcx, 4
    x64.callDirect squareShape
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.callDirect __drop_existential
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.storeBaseDispReg.word64 [rbx + 8], r13
  ifcont:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

