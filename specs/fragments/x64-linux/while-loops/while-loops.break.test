// Test: while-loops.break
function main() returns ExitCode
	var x = 5
	while true 'loop'
		x = x + 2
		if x == 11 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 5
  loop:
    x64.leaRegRegImm32 r8, rax, 2
    x64.cmpRegImm32 r8, 11
    x64.jcc notEqual, ifcont
  __rc_ok:
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp loop
}
