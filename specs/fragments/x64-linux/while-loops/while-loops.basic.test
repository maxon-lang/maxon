// Test: while-loops.basic
function main() returns ExitCode
	var x = 5
	var i = 3
	while i > 0 'loop'
		x = x + 2
		i = i - 1
		if i == 0 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rcx, 3
  whilehdr:
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, critsplit
  loop:
    x64.leaRegRegImm32 r8, rax, 2
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, whileexit
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp whilehdr
  critsplit:
    x64.movRegReg r8, rax
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at while-loops.basic.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
