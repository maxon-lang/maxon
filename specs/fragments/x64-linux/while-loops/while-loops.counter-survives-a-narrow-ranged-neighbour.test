  __rc_panic#15:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at while-loops.counter-survives-a-narrow-ranged-neighbour.test:48: Range check failed: value outside typealias 'ExitCode'\x0a"
