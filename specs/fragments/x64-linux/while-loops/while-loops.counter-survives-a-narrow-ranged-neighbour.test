    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegSlot rax, slot1
    x64.loadRegSlot rcx, slot4
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot0
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rax, 2000
    x64.jcc greater, runaway
  whilehdr:
    x64.storeSlotReg slot1, rax
    x64.storeSlotReg slot0, rcx
    x64.cmpRegImm32 rcx, 2
    x64.jcc less, passes
