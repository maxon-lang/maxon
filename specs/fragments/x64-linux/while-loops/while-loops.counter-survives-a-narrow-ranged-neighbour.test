    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
  __im_cont#17:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#42
  one:
    x64.loadRegSlot rax, slot4
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forstep#6
  critsplit#42:
    x64.loadRegSlot rax, slot4
  forstep#6:
    x64.loadRegSlot rcx, slot2
    x64.leaRegRegImm32 rdx, rcx, 1
  forhdr#4:
    x64.storeSlotReg slot4, rax
    x64.storeSlotReg slot2, rdx
    x64.cmpRegReg rdx, r13
    x64.jcc less, inner
  forexit#7:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.loadRegSlot rax, slot4
    x64.cmpRegImm32 rax, 141
    x64.jcc equal, ifcont
  paddingLeakedIn:
