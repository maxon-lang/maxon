// Test: while-loops.counter-survives-a-narrow-ranged-neighbour
typealias SlotTally = int(0 to 16)

enum Pair
	first
	second
end 'Pair'

function liveCount(both bool) returns SlotTally
	var n = 0
	for c in Pair.allCases 'walk'
		if c == Pair.first or both 'live'
			n = n + 1
		end 'live'
	end 'walk'
	return n
end 'liveCount'

function main() returns ExitCode
	let scaled = 20 * (liveCount(false) + 1)
	let seed = 100 + scaled

	var guard = 0
	var pass = 0
	while pass < 2 'passes'
		var running = seed
		for c in Pair.allCases 'inner'
			if c == Pair.first 'one'
				running = running + 1
			end 'one'
		end 'inner'
		// ⚠ `running` is NARROW-typed, so it takes a 4-byte store while this read is 8 bytes wide — the
		// high half is slot padding. Checking it here means that padding can never be depended on
		// SILENTLY: if it is ever non-zero this case says 98 instead of quietly computing the right
		// answer. (Measured: exactly one variable in the whole bootstrap suite has this store/load
		// width pair, and it is this one.)
		if running != 141 'paddingLeakedIn'
			return 98
		end 'paddingLeakedIn'

		guard = guard + running
		pass = pass + 1
		if guard > 2000 'runaway'
			return 99
		end 'runaway'
	end 'passes'

	return pass
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rax, 0
    x64.storeSlotReg slot3, rax
  __il_body:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
  __us_test#41:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.loadRegBaseDisp.word64 r14, [r12 + 24]
    x64.loadRegBaseDisp.word64 r15, [r12 + 0]
    x64.jmp forhdr#24
  walk:
    x64.cmpRegImm32 r14, 8
    x64.jcc notEqual, __im_stride#39
  __im_word#37:
