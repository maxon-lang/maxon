    x64.movRegReg rbx, rax
  forhdr#24:
    x64.storeSlotReg slot5, rdx
    x64.cmpRegReg rdx, r13
    x64.jcc less, walk
  forexit#27:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#33
  __rc_chk#34:
    x64.cmpRegImm32 rbx, 16
    x64.jcc greater, __rc_panic#33
  __il_cont:
    x64.leaRegRegImm32 rax, rbx, 1
    x64.imulRegRegImm32 rax, rax, 20
    x64.leaRegRegImm32 rbx, rax, 100
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  passes:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
  __us_test#40:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.loadRegBaseDisp.word64 r14, [r12 + 24]
    x64.loadRegBaseDisp.word64 r15, [r12 + 0]
    x64.movRegReg rax, rbx
