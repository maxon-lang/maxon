// Test: while-loops.loop-carried-var-narrower-than-its-update
function firstExit() returns ExitCode
	return 0
end 'firstExit'

function pick() returns ExitCode
	var r = firstExit()
	var i = 0
	while i < 3 'lp'
		r = i
		i = i + 1
	end 'lp'
	return r
end 'pick'

function main() returns ExitCode
	return pick()
end 'main'
---
ExitCode: 2
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 r8, 0
  __il_cont:
    x64.movRegImm32 rax, 0
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc greaterEqual, whileexit
  lp:
    x64.leaRegRegImm32 rcx, rax, 1
    x64.movRegReg r8, rax
    x64.movRegReg rax, rcx
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at while-loops.loop-carried-var-narrower-than-its-update.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect pick
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
