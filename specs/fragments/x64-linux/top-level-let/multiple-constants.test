// Test: multiple-constants
let A = 1
let B = 2
let C = 3

function main() returns ExitCode
	return A + B + C
end 'main'
---
ExitCode: 6
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 6
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
