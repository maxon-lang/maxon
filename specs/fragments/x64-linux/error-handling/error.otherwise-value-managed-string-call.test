// Test: error.otherwise-value-managed-string-call

// A managed String try-result whose `otherwise` fallback is itself an OWNED String from a call — both
// phi edges are owned, so the phi drops once with no promotion, on the ok AND the error edge alike.
enum MyError implements Error
	failed
end 'MyError'

function tryIt(flag bool) returns String throws MyError
	if flag 'c'
		throw MyError.failed
	end 'c'
	return "ok"
end 'tryIt'

function fallback() returns String
	return "fb"
end 'fallback'

function pick(flag bool) returns String
	let s = try tryIt(flag) otherwise fallback()
	return s
end 'pick'

function main() returns ExitCode
	let a = pick(false)
	let b = pick(true)
	if a == "ok" 'x'
		if b == "fb" 'y'
			return 0
		end 'y'
	end 'x'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tryIt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  c:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "ok"
    x64.callDirect __str_retain
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @fallback {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "fb"
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect tryIt
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.callDirect fallback
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_2]  ; "ok"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  x:
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "fb"
    x64.movRegReg rcx, r12
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  y:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
