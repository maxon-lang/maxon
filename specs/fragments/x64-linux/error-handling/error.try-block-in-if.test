// Test: error.try-block-in-if
typealias Code = int(i64.min to i64.max)

enum Fault implements Error
	broken
end 'Fault'

function risky(_ Code) returns Code throws Fault
	throw Fault.broken
end 'risky'

function main() returns ExitCode
	var acc = 0 as Code
	if acc < 5 'guard'
		try risky(3) otherwise (e) 'h'
			acc = 7
		end 'h'
		acc = acc + 1
	end 'guard'
	return acc
end 'main'
---
ExitCode: 8
---
func @risky {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  guard:
    x64.movRegImm32 rcx, 3
    x64.callDirect risky
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.movRegImm32 rax, 7
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, rbx
  trycont:
    x64.leaRegRegImm32 r8, rax, 1
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at error.try-block-in-if.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
