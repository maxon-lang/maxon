// Test: range-check-panic.field-store-checks-the-fields-own-alias
// --- file: a.maxon
export typealias Item = int(0 to 255)

export type Box
  export var item as Item

  export static function create() returns Self
    return Self{item: 0}
  end 'create'
end 'Box'

// --- file: main.maxon
typealias Item = int(0 to 200)

function main() returns ExitCode
  let floor = 0 as Item
  var b = Box.create()
  b.item = 250
  if floor == 0 'stored'
    return b.item
  end 'stored'
  return 1
end 'main'
---
ExitCode: 250
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.movRegImm32 rax, 250
    x64.storeBaseDispReg.word64 [r8 + 0], rax
  stored:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
