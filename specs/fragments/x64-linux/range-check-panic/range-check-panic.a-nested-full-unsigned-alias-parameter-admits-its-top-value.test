// Test: range-check-panic.a-nested-full-unsigned-alias-parameter-admits-its-top-value
typealias Integer = int(i64.min to i64.max)

type Meter
  let reading as Integer

  static function create() returns Self
    return Self{reading: 0}
  end 'create'

  function raw() returns Integer
    return self.reading
  end 'raw'
end 'Meter'

extension Meter
  typealias Wide = int(0 to u64.max)

  function take(w Wide) returns bool
    return w == u64.max
  end 'take'
end 'Meter'

function main() returns ExitCode
  let meter = Meter.create()
  if meter.take(u64.max) and meter.raw() == 0 'top'
    return 0
  end 'top'
  return 1
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#7:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  top:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
