// Test: range-check-panic.an-uncontained-return-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias Wide = int(0 to 1000)
typealias Narrow = int(0 to 100)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function widen() returns Wide
  return opaque(101)
end 'widen'

function narrow() returns Narrow
  return widen()
end 'narrow'

function main() returns ExitCode
  return narrow()
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at range-check-panic.an-uncontained-return-is-still-guarded.test:15: Range check failed: value outside typealias 'Narrow'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
