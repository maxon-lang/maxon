// Test: range-check-panic.a-counted-limit-proves-the-floor
typealias Integer = int(i64.min to i64.max)
typealias NonNeg = int(0 to i64.max)
typealias Ints = Array with Integer

function main() returns ExitCode
  var xs = Ints.create()
  xs.push(10)
  xs.push(20)
  xs.push(30)
  var total = 0 as Integer
  for i in 0 upto xs.count() 'each'
    let g = i as NonNeg
    total = total + g
  end 'each'
  print("total={total}\n")
  return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRegReg r12, r12, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "total="
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "\x0a"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot4, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot3, rax
    x64.leaRegRegReg rcx, r13, r12
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r12
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot4
    x64.loadRegSlot r12, slot3
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
