// Test: range-check-panic.a-computed-value-in-the-selected-ternary-arm-still-panics
typealias Wide = int(0 to u64.max)
typealias Small = int(0 to 100)

function widen(n Wide) returns Wide
  return n * 100
end 'widen'

function pick(i Wide, flag bool) returns Small
  return ((i + 1) as Small) if flag else 7
end 'pick'

function main() returns ExitCode
  return pick(widen(5), flag: true)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at range-check-panic.a-computed-value-in-the-selected-ternary-arm-still-panics.test:10: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
