// Test: range-check-panic.an-interface-result-crossing-into-a-same-named-alias-is-guarded
// --- file: a.maxon
export typealias Level = int(0 to 100)

export interface Gauge
  function read() returns Level
end 'Gauge'

type Tank implements Gauge
  let fill as Level

  static function create() returns Self
    return Self{fill: 90}
  end 'create'

  function read() returns Level
    return self.fill
  end 'read'
end 'Tank'

export function makeTank() returns Gauge
  return Tank.create()
end 'makeTank'

// --- file: z.maxon
typealias Level = int(0 to 3)

function relay(g Gauge) returns Level
  return g.read()
end 'relay'

function main() returns ExitCode
  return relay(makeTank())
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @Tank.read {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.andRegImm32 r8, rcx, 255
    x64.popReg rbp
    x64.ret
}

func @makeTank {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 90
  __il_cont:
    x64.leaRegRdata r10, [rip + __witness_Tank.Gauge]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect makeTank
    x64.movRegReg rbx, r8
    x64.movRegReg r12, r10
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callMem [r12 + 48]
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 3
    x64.jcc greater, __rc_panic
  __il_cont:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at z.maxon:4: Range check failed: value outside typealias 'Level'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
