// Test: range-check-panic.return-of-a-reassigned-shadow-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 10)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function check(x SmallInt) returns SmallInt
  var y = x
  y = opaque(99) as SmallInt
  return y
end 'check'

function main() returns ExitCode
  return check(5)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at range-check-panic.return-of-a-reassigned-shadow-is-still-guarded.test:11: Range check failed: value outside typealias 'SmallInt'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
