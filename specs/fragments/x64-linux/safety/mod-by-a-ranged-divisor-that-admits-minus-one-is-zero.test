// Test: mod-by-a-ranged-divisor-that-admits-minus-one-is-zero
typealias Integer = int(i64.min to i64.max)
typealias NegativeOne = int(-1 to -1)

function ident(v Integer) returns Integer
	return v
end 'ident'

function remainder(d NegativeOne) returns Integer
	return (dividend mod d) as Integer
end 'remainder'

function main() returns ExitCode
	dividend = ident(i64.min)
	let d = ident(-1)
	let r = remainder(d as NegativeOne)
	print("r={r}\n")
	return 0
end 'main'
var dividend = 0
