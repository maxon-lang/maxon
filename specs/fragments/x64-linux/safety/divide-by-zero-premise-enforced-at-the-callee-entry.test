// Test: divide-by-zero-premise-enforced-at-the-callee-entry
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function ident(v Integer) returns Integer
	return v
end 'ident'

function divide(n NonZero, d NonZero) returns Integer
	return (n / d) as Integer
end 'divide'

function main() returns ExitCode
	z = ident(0)
	return divide(10, d: z) as ExitCode
end 'main'
var z = 0
---
ExitCode: 1
---
data {
  __data_z@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
  __il_cont#5:
    x64.leaRegGlobal rcx, __data_z
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 10
    x64.leaRegGlobal rcx, __data_z
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
  __rc_ok#8:
    x64.cmpRegImm32 rcx, 1
    x64.jcc less, __rc_panic#11
  __rc_ok#10:
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
  __il_cont#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#2
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.movRegReg r8, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#11:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:9: Range check failed: value outside typealias 'NonZero'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
