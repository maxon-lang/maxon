// Test: equals-branching

typealias Integer = int(i64.min to i64.max)

type Token implements Equatable
	export var id as Integer

	function equals(other Token) returns bool
		return id == other.id
	end 'equals'

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Token'

function main() returns ExitCode
	let a = Token.create(10)
	let b = Token.create(10)
	let c = Token.create(20)
	var result = 0
	if a.equals(b) 'first'
		result = result + 1
	end 'first'
	if a.equals(c) 'second'
		result = result + 10
	end 'second'
	if b.equals(c) 'third'
		result = result + 100
	end 'third'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 64
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rdx, slot1
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.movRegImm32 rax, 20
    x64.leaRegSlot rsi, slot2
    x64.storeBaseDispReg.word64 [rsi + 0], rax
    x64.movRegImm32 rax, 0
  __il_body#11:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 0]
    x64.loadRegBaseDisp.word64 r8, [rdx + 0]
    x64.cmpRegReg rdi, r8
    x64.setccReg equal, rdi
  __il_cont#10:
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, __il_body#13
  first:
    x64.movRegImm32 rax, 1
  __il_body#13:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdi, [rsi + 0]
    x64.cmpRegReg rcx, rdi
    x64.setccReg equal, rcx
  __il_cont#12:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_body#15
  second:
    x64.leaRegRegImm32 rax, rax, 10
  __il_body#15:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rsi + 0]
    x64.cmpRegReg rcx, rdx
    x64.setccReg equal, rcx
  __il_cont#14:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  third:
    x64.leaRegRegImm32 r8, rax, 100
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at equals-branching.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
}
