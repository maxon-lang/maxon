func @sleeper {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.callDirect sleep
    x64.leaRegGlobal rax, __data_order
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegReg rax, rax, rbx
    x64.leaRegGlobal rcx, __data_order
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @hog {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at async-sleep.coalesced-pass-fires-in-deadline-order.test:13: Range check failed: value outside typealias 'DurationNanos'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.callDirect Clock.nowNanos
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
  whilehdr:
    x64.movRegReg rcx, r12
    x64.callDirect Clock.elapsedNanos
    x64.cmpRegReg r8, rbx
    x64.jcc greaterEqual, whileexit
  spin:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

