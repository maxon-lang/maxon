// Test: day2

typealias Integer = int(i64.min to i64.max)

function add(x Integer, y Integer) returns Integer
		return x + y
end 'add'

function main() returns ExitCode
	return add(3, y: 4)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
