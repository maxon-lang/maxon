// Test: keyword-named-INTERFACE-REQUIREMENTS-among-others
typealias Integer = int(i64.min to i64.max)

interface Bounded
	function end(k Integer) returns Integer
	function while(k Integer) returns Integer
	function match(k Integer) returns Integer
end 'Bounded'

type Span implements Bounded
	export let lo as Integer

	static function from(k Integer) returns Self
		return Self{lo: k}
	end 'from'

	function end(k Integer) returns Integer
		return lo + k
	end 'end'

	function while(k Integer) returns Integer
		return k
	end 'while'

	function match(k Integer) returns Integer
		return k
	end 'match'
end 'Span'

function main() returns ExitCode
	let s = Span.from(40)
	return s.end(2) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 40
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rbx, rax, 2
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at keyword-named-INTERFACE-REQUIREMENTS-among-others.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
