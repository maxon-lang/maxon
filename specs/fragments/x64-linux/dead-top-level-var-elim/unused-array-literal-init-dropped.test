// Test: unused-array-literal-init-dropped
let deadArr = [1, 2, 3, 4, 5]

function main() returns ExitCode
	return 7
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
