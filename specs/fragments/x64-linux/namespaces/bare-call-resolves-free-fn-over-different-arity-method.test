// Test: bare-call-resolves-free-fn-over-different-arity-method
// --- file: lib/free.maxon
typealias Code = int(0 to 125)

export function store(base Code, offset Code, scale Code) returns Code
	return base + offset + scale
end 'store'

// --- file: lib/cache.maxon
typealias Code = int(0 to 125)

export type Cache
	export var last as Code

	export static function make() returns Cache
		return Cache{last: 0}
	end 'make'

	export function store(key Code)
		self.last = key
	end 'store'
end 'Cache'

// --- file: app/main.maxon
function main() returns ExitCode
	let viaFree = store(2, offset: 3, scale: 4)
	var c = Cache.make()
	c.store(99)
	return viaFree
end 'main'
---
ExitCode: 9
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __rc_ok#11:
    x64.movRegImm32 rbx, 9
  __il_body:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r12
  __il_cont#2:
    x64.movRegImm32 rax, 99
  __rc_ok#19:
    x64.storeBaseDispReg.word64 [r8 + 0], rax
  __il_cont#1:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
