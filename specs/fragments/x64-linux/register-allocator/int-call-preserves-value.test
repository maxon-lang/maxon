// Test: int-call-preserves-value

typealias Integer = int(i64.min to i64.max)

function getForty() returns Integer
	return 40
end 'getForty'

function main() returns ExitCode
	let x = 2
	let y = getForty()
	return x + y
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
