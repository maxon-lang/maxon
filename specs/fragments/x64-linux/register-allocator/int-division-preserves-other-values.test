// Test: int-division-preserves-other-values
function main() returns ExitCode
	let x = 10
	let a = 84
	let b = 2
	let quotient = a / b
	return quotient - x
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 84
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 rax, rax, 84
    x64.sarRegImm8 rax, rax, 1
    x64.leaRegRegImm32 r8, rax, -10
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
