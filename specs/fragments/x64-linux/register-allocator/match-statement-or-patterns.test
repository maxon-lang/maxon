// Test: match-statement-or-patterns
function main() returns ExitCode
	let x = 3
	match x 'check'
		1 or
			2 then return 10
		3 or
			4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
}
