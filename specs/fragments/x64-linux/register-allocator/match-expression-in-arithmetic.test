// Test: match-expression-in-arithmetic
function main() returns ExitCode
	let x = 2
	let doubled = match x 'eval'
		1 gives 10
		2 gives 20
		default gives 0
	end 'eval' * 2
	return doubled
end 'main'
---
ExitCode: 40
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 rax, 20
  matchcont:
    x64.imulRegRegImm32 r8, rax, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
