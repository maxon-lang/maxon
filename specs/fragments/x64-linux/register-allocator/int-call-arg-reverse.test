// Test: int-call-arg-reverse

typealias Integer = int(i64.min to i64.max)

function sub(a Integer, b Integer) returns Integer
	return a - b
end 'sub'

function main() returns ExitCode
	let x = 10
	let y = 3
	let result = sub(y, b: x)
	return result + 45
end 'main'
---
ExitCode: 38
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm rax, 18446744073709551609
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 45
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
