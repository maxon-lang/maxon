// Test: int-if-else-value-survives-branch
function main() returns ExitCode
	let base = 40
	let cond = 1
	var extra = 0
	if cond == 1 'check'
		extra = 2
	end 'check' else 'other'
		extra = 100
	end 'other'
	return base + extra
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 rax, 2
  ifcont:
    x64.leaRegRegImm32 r8, rax, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
