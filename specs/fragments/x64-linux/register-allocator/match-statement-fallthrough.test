// Test: match-statement-fallthrough
function main() returns ExitCode
	let x = 1
	var result = 0
	match x 'cascade'
		1 then result = result + 10 and fallthrough
		2 then result = result + 20 and fallthrough
		3 then result = result + 30
		default then result = 100
	end 'cascade'
	return result
end 'main'
---
ExitCode: 60
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm#1:
    x64.movRegImm32 rax, 10
  matcharm#2:
    x64.leaRegRegImm32 rax, rax, 20
  matcharm#3:
    x64.leaRegRegImm32 r8, rax, 30
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
