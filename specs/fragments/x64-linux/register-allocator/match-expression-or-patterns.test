// Test: match-expression-or-patterns
function main() returns ExitCode
	let x = 4
	let result = match x 'eval'
		1 or
			2 gives 10
		3 or
			4 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 20
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
