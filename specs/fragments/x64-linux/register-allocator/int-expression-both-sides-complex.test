// Test: int-expression-both-sides-complex
function main() returns ExitCode
	let a = 3
	let b = 5
	let c = 7
	let d = 2
	return (a + b) * (c - d)
end 'main'
---
ExitCode: 40
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
