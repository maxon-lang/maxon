// Test: let-struct-to-transitive-self-mutating-method-ok
typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create() returns Counter
		return Self{n: 0}
	end 'create'

	export function bump()
		n = n + 1
	end 'bump'

	export function bumpTwice()
		bump()
		bump()
	end 'bumpTwice'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	c.bumpTwice()
	return c.n as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#6:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#10:
    x64.aluBaseDispImm32.add [r8 + 0], 1
  __il_body#11:
    x64.aluBaseDispImm32.add [r8 + 0], 1
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at let-struct-to-transitive-self-mutating-method-ok.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
