// Test: let-to-callee-calling-a-self-writing-method-ok
typealias Tally = int(0 to 1000)

type Counter
	export var n as Tally

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function bump()
		self.n = self.n + 1
	end 'bump'
end 'Counter'

function tick(c Counter)
	c.bump()
end 'tick'

function main() returns ExitCode
	let c = Counter.create()
	tick(c)
	tick(c)
	return c.n as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic#12
  __rc_ok#11:
    x64.storeBaseDispReg.word64 [r8 + 0], rax
  __il_body#16:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#18
  __rc_chk#19:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic#18
  __rc_ok#17:
    x64.storeBaseDispReg.word64 [r8 + 0], rax
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at let-to-callee-calling-a-self-writing-method-ok.test:12: Range check failed: value outside typealias 'Tally'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#18:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at let-to-callee-calling-a-self-writing-method-ok.test:12: Range check failed: value outside typealias 'Tally'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
