// Test: stdlib-user-shadows.user-enum-coexists-with-a-listed-modules-typealias
enum RepeatCount
	first = 1
	second = 7
end 'RepeatCount'

function main() returns ExitCode
	return RepeatCount.second.rawValue
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
