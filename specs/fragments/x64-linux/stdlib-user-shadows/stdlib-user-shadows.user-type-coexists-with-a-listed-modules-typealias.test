// Test: stdlib-user-shadows.user-type-coexists-with-a-listed-modules-typealias
typealias Value = int(0 to 200)

type ParsedInt
	export let value as Value

	export static function create(value Value) returns ParsedInt
		return Self{value: value}
	end 'create'
end 'ParsedInt'

function main() returns ExitCode
	let p = ParsedInt.create(7)
	return p.value
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 7
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
