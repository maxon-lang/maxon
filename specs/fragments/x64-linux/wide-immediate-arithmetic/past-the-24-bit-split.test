// Test: past-the-24-bit-split
function main() returns ExitCode
	let cell = [1000]
	let x = try cell.get(0) otherwise 0
	let addFirst = x + 16777216
	if addFirst != 16778216 'addFirst'
		return 31
	end 'addFirst'
	let subFirst = x - 16777216
	if subFirst != -16776216 'subFirst'
		return 32
	end 'subFirst'
	let addWide = x + 1000000007
	if addWide != 1000001007 'addWide'
		return 33
	end 'addWide'
	let subWide = x - 1000000007
	if subWide != -999999007 'subWide'
		return 34
	end 'subWide'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  trycont:
    x64.leaRegRegImm32 rcx, rax, 16777216
    x64.cmpRegImm32 rcx, 16778216
    x64.jcc equal, ifcont#5
  addFirst:
    x64.movRegImm32 rbx, 31
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.leaRegRegImm32 rcx, rax, -16777216
    x64.cmpRegImm32 rcx, -16776216
    x64.jcc equal, ifcont#7
  subFirst:
    x64.movRegImm32 rbx, 32
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#7:
    x64.leaRegRegImm32 rcx, rax, 1000000007
    x64.cmpRegImm32 rcx, 1000001007
    x64.jcc equal, ifcont#9
  addWide:
    x64.movRegImm32 rbx, 33
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#9:
    x64.leaRegRegImm32 rax, rax, -1000000007
    x64.cmpRegImm32 rax, -999999007
    x64.jcc equal, ifcont#11
  subWide:
    x64.movRegImm32 rbx, 34
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#11:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, r8
    x64.movRegReg rcx, r8
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.loadRegSlot r8, slot0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp trycont
}
