// Test: past-the-24-bit-split
function main() returns ExitCode
	let cell = [1000]
	let x = try cell.get(0) otherwise 0
	let addFirst = x + 16777216
	if addFirst != 16778216 'addFirst'
		return 31
	end 'addFirst'
	let subFirst = x - 16777216
	if subFirst != -16776216 'subFirst'
		return 32
	end 'subFirst'
	let addWide = x + 1000000007
	if addWide != 1000001007 'addWide'
		return 33
	end 'addWide'
	let subWide = x - 1000000007
	if subWide != -999999007 'subWide'
		return 34
	end 'subWide'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#16
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#17
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#17:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont
  critsplit#16:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.leaRegRegImm32 rcx, rax, 16777216
    x64.cmpRegImm32 rcx, 16778216
    x64.jcc equal, ifcont#5
  addFirst:
    x64.movRegImm32 r12, 31
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.leaRegRegImm32 rcx, rax, -16777216
    x64.cmpRegImm32 rcx, -16776216
    x64.jcc equal, ifcont#7
  subFirst:
    x64.movRegImm32 r12, 32
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#7:
    x64.leaRegRegImm32 rcx, rax, 1000000007
    x64.cmpRegImm32 rcx, 1000001007
    x64.jcc equal, ifcont#9
  addWide:
    x64.movRegImm32 r12, 33
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#9:
    x64.leaRegRegImm32 rax, rax, -1000000007
    x64.cmpRegImm32 rax, -999999007
    x64.jcc equal, ifcont#11
  subWide:
    x64.movRegImm32 r12, 34
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#11:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
