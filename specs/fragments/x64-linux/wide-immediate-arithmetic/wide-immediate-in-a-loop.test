// Test: wide-immediate-in-a-loop
function main() returns ExitCode
	let cell = [0]
	var acc = try cell.get(0) otherwise 0
	var i = 0
	while i < 3 'loop'
		acc = acc + 1000000007
		i = i + 1
	end 'loop'
	if acc != 3000000021 'acc'
		return 61
	end 'acc'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  trycont:
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  loop:
    x64.leaRegRegImm32 rax, rax, 1000000007
    x64.leaRegRegImm32 rcx, rcx, 1
  whilehdr:
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, loop
  whileexit:
    x64.movRegImm32 rcx, 3000000021
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont
  acc:
    x64.movRegImm32 rbx, 61
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, r8
    x64.movRegReg rcx, r8
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.loadRegSlot r8, slot0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp trycont
}
