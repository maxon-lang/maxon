  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 1000
    x64.callDirect sleep
    x64.movRegReg rcx, rbx
    x64.callDirect TcpListener.accept
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
