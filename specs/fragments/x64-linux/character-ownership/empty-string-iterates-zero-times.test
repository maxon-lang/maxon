// Test: empty-string-iterates-zero-times
function main() returns ExitCode
	let s = ""
	var n = 0
	for _ in s 'each'
		n = n + 1
	end 'each'
	print("{s.count()} {n} {s.bytes().count()}\n")
	return 0
end 'main'
