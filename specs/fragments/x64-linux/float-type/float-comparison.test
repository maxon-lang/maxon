// Test: float-comparison
function main() returns ExitCode
	let x = 3.5
	let y = 2.1
	if x > y 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
