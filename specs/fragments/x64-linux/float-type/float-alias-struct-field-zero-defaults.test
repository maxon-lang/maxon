// Test: float-alias-struct-field-zero-defaults

typealias Weight = float(f64.min to f64.max)

type Particle
	export var mass as Weight = 0
	export var vel as Weight = 0.0

	static function make() returns Self
		return Self{}
	end 'make'
end 'Particle'

function main() returns ExitCode
	let p = Particle.make()
	if p.mass == 0.0 'zeroMass'
		if p.vel == 0.0 'zeroVel'
			return trunc((p.mass + p.vel + 4.2) * 10.0)
		end 'zeroVel'
	end 'zeroMass'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 56
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
  __il_body:
    x64.movsdRegRip xmm6, [rip + __fconst_0]
    x64.movsdRegRip xmm7, [rip + __fconst_0]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], xmm6
    x64.storeBaseDispReg.word64 [r8 + 8], xmm7
  __il_cont:
    x64.loadRegBaseDisp.word64 xmm0, [r8 + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered#11:
    x64.jcc notEqual, ifcont
  zeroMass:
    x64.loadRegBaseDisp.word64 xmm0, [r8 + 8]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered#10:
    x64.jcc notEqual, ifcont
  zeroVel:
    x64.loadRegBaseDisp.word64 xmm0, [r8 + 0]
    x64.loadRegBaseDisp.word64 xmm1, [r8 + 8]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_4.2]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_10]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg rbx, xmm0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 7
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at float-alias-struct-field-zero-defaults.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
