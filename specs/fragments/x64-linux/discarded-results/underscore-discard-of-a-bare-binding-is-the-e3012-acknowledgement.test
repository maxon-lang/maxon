// Test: underscore-discard-of-a-bare-binding-is-the-e3012-acknowledgement
typealias Tally = int(0 to u64.max)

function main() returns ExitCode
	let seen = 3 as Tally
	_ = seen
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
