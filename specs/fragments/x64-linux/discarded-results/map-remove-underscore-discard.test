// Test: map-remove-underscore-discard
typealias Tally = int(0 to u64.max)
typealias TallyMap = Map with (String, Tally)

function main() returns ExitCode
	var m = TallyMap.create()
	m.upsert("a", value: 1)
	_ = m.remove("a")
	return m.count()
end 'main'
