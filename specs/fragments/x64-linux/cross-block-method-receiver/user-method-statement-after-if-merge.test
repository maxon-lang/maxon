// Test: user-method-statement-after-if-merge
typealias Integer = int(i64.min to i64.max)

type Box
	var v as Integer

	function show()
		print("v={v}\n")
	end 'show'

	static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var b = Box.create(1)
	if 2 > 1 'grow'
		b = Box.create(7)
	end 'grow'
	b.show()
	return 0
end 'main'
---
ExitCode: 0
---
