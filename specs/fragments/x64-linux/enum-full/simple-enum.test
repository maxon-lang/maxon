// Test: simple-enum
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	let dir = Direction.north
	let result = match dir 'check'
		north gives 1
		south gives 0
		east gives 0
		west gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_1
  matchdead:
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp __rc_ok
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok
  matcharm#4:
    x64.movRegImm32 r8, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
