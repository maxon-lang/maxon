// Test: union-method-with-assoc-values

typealias Code = int(0 to 1000)

union Outcome
	ok
	failure(code Code)

	function statusCode() returns Code
		return match self 'check'
			ok gives 0
			failure(code) gives code
		end 'check'
	end 'statusCode'
end 'Outcome'

function main() returns ExitCode
	let o = Outcome.failure(42)
	return o.statusCode()
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 42
    x64.movRegImm32 rax, 1
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.cmpRegImm32 r8, 1000
    x64.jcc greater, __rc_panic#12
  __rc_chk#3:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at union-method-with-assoc-values.test:10: Range check failed: value outside typealias 'Code'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at union-method-with-assoc-values.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
