// Test: empty-otherwise
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var a = IntArray.create()
	a.push(1)
	var n = 0
	n = try a.get(0) otherwise 'oops'
	end 'oops'
	return n as ExitCode
end 'main'
---
