// Test: a-self-returning-static-built-from-a-call-results-field-is-served
type Cell uses T
	export var v as T

	static function make(v T) returns Self
		return Self{v: v}
	end 'make'

	static function copyVia(v T) returns Self
		return Self{v: Self.make(v).v}
	end 'copyVia'
end 'Cell'

typealias StrCell = Cell with String

function heapString(a String, b String) returns String
	var sb = StringBuilder.create()
	sb.append(a)
	sb.append(b)
	return sb.build()
end 'heapString'

function main() returns ExitCode
	let c = StrCell.copyVia(heapString("first payload ", b: "long enough to allocate"))
	print("{c.v}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "first payload "
    x64.leaRegRdata r12, [rip + __str_rec_4]  ; "long enough to allocate"
  __il_body#10:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.storeBaseDispReg.word64 [r15 + 0], r13
    x64.storeBaseDispReg.byte [r15 + 8], r14
  __il_cont#9:
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.callDirect StringBuilder.append
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.callDirect StringBuilder.append
  __il_body#12:
    x64.loadRegBaseDisp.word64 rcx, [r15 + 0]
    x64.loadRegBaseDisp.byte rbx, [r15 + 8]
  __il_body#14:
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __str_of_buffer
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_cont#13:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rcx, [r15 + 0]
    x64.callDirect __managed_decref
    x64.storeBaseDispReg.word64 [r15 + 0], r12
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.byte [r15 + 8], rax
  __il_cont#11:
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_StringBuilder
  __il_cont#7:
    x64.leaRegRdata r12, [rip + __layout_Cell_String]
  __il_body#4:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_type_param
    x64.movRegReg r13, r8
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], r13
  __il_cont#5:
    x64.loadRegBaseDisp.word64 r13, [r14 + 0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.storeSlotReg slot0, r15
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __retain_type_param
    x64.storeBaseDispReg.word64 [r15 + 0], r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __destruct_dict_Cell
  __il_cont#3:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.loadRegBaseDisp.word64 rax, [r15 + 0]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, r12, r14
