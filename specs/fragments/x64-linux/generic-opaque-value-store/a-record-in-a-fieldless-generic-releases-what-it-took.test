// Test: a-record-in-a-fieldless-generic-releases-what-it-took
typealias Integer = int(i64.min to i64.max)

type Pack uses T
	var n as Integer

	export static function create() returns Self
		return Self{n: 40}
	end 'create'

	export function tag(t T) returns Integer
		let pair = (t, n)
		return pair.1
	end 'tag'
end 'Pack'

typealias StrPack = Pack with String

function main() returns ExitCode
	var p = StrPack.create()
	let s = "hello"
	return p.tag(s) + p.tag("literal")
end 'main'
---
ExitCode: 80
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pack.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.loadRegBaseDisp.word64 r13, [rcx + 0]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_type_param
    x64.storeBaseDispReg.word64 [r14 + 0], r8
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.loadRegBaseDisp.word64 rbx, [r14 + 8]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __destruct_dict___Tuple2.T7cffa0a77d7fac6b.int
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.leaRegSlot rbx, slot0
    x64.movRegImm32 rax, 40
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.leaRegRdata rdx, [rip + __str_rec_2]  ; "hello"
    x64.leaRegRdata rax, [rip + __layout_Pack_String]
    x64.movRegReg rcx, rbx
    x64.callDirect Pack.tag
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "literal"
    x64.leaRegRdata rax, [rip + __layout_Pack_String]
    x64.movRegReg rcx, rbx
    x64.callDirect Pack.tag
    x64.leaRegRegReg r8, r12, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-record-in-a-fieldless-generic-releases-what-it-took.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
