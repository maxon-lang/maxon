// Test: a-nested-view-another-file-reaches-stores-use-first
// --- file: a_use.maxon
typealias TextOuter = Outer with String

function main() returns ExitCode
	let o = TextOuter.create("x")
	return o.tag()
end 'main'


// --- file: b_holder.maxon
export typealias Int = int(0 to 1000)

type Cell uses T
	export var value as T
	static function create(value T) returns Self
		return Self{value: value}
	end 'create'
end 'Cell'

type Holder uses T
	var cell as Cell
	static function create(value T) returns Self
		return Self{cell: Cell.create(value)}
	end 'create'
	function replace(next Cell)
		self.cell = next
	end 'replace'
end 'Holder'

export type Outer uses T
	var holder as Holder
	export static function create(value T) returns Self
		return Self{holder: Holder.create(value)}
	end 'create'
	export function tag() returns Int
		return 3
	end 'tag'
end 'Outer'
---
ExitCode: 3
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rdx, [rip + __str_rec_1]  ; "x"
    x64.leaRegRdata rcx, [rip + __layout_Outer_String]
  __il_body#9:
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
  __il_body#11:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#10:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.storeBaseDispReg.word64 [rbx + 0], r12
  __il_cont#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#5:
    x64.movRegImm32 rbx, 3
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Outer_String
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
