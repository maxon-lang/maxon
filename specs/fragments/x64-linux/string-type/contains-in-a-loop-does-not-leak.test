// Test: contains-in-a-loop-does-not-leak
function main() returns ExitCode
	var hits = 0
	for i in 0 upto 200 'each'
		let s = "hello world {i}"
		if s.contains('o') 'ch'
			hits = hits + 1
		end 'ch'
		if s.contains("wor") 'st'
			hits = hits + 1
		end 'st'
	end 'each'
	print("{hits}")
	return 0
end 'main'
---
ExitCode: 0
