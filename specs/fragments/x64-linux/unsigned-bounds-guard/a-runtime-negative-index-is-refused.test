// Test: a-runtime-negative-index-is-refused
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function readAt(a IntArray, i Int) returns Int
	return try a.managed.get(i) otherwise -7
end 'readAt'

function main() returns ExitCode
	var a = IntArray.create()
	a.push(11)
	a.push(22)
	a.push(33)

	let n = a.count()
	if readAt(a, i: -n) != -7 'minusCount'
		return 1
	end 'minusCount'
	if readAt(a, i: -n - 1) != -7 'belowThat'
		return 2
	end 'belowThat'
	if readAt(a, i: 1 - n) != -7 'minusTwo'
		return 3
	end 'minusTwo'
	if readAt(a, i: n - 1) != 33 'lastStillReadable'
		return 4
	end 'lastStillReadable'
	if readAt(a, i: n) != -7 'atLength'
		return 5
	end 'atLength'
	if a.count() != 3 'countUnchanged'
		return 6
	end 'countUnchanged'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @readAt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + rdx*8 + 0]
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#8
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#9
  __im_slow:
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#9:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
    x64.jmp __im_cont
  critsplit#8:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm r8, 18446744073709551609
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 11
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 22
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 33
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rdx, r12
    x64.negReg rdx, r12
    x64.movRegReg rcx, rbx
    x64.callDirect readAt
    x64.cmpRegImm32 r8, -7
    x64.jcc equal, ifcont#2
  minusCount:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegReg rax, r12
    x64.negReg rax, r12
    x64.leaRegRegImm32 rdx, rax, -1
    x64.movRegReg rcx, rbx
    x64.callDirect readAt
    x64.cmpRegImm32 r8, -7
    x64.jcc equal, ifcont#4
  belowThat:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rdx, 1
    x64.subRegReg rdx, rdx, r12
    x64.movRegReg rcx, rbx
    x64.callDirect readAt
    x64.cmpRegImm32 r8, -7
    x64.jcc equal, ifcont#6
  minusTwo:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.leaRegRegImm32 rdx, r12, -1
    x64.movRegReg rcx, rbx
    x64.callDirect readAt
    x64.cmpRegImm32 r8, 33
    x64.jcc equal, ifcont#8
  lastStillReadable:
    x64.movRegImm32 r12, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect readAt
    x64.cmpRegImm32 r8, -7
    x64.jcc equal, ifcont#10
  atLength:
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, ifcont#12
  countUnchanged:
    x64.movRegImm32 r12, 6
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
