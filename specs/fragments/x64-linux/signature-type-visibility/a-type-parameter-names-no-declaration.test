// Test: a-type-parameter-names-no-declaration
// --- file: api/lib.maxon
export typealias Tally = int(0 to 100)

export type Box uses T
	export var item as T

	export static function create(item T) returns Self
		return Self{item: item}
	end 'create'

	export function get() returns T
		return self.item
	end 'get'
end 'Box'

// --- file: app/main.maxon
typealias TallyBox = Box with Tally

function main() returns ExitCode
	let b = TallyBox.create(11)
	return b.get() as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 11
  __il_body#3:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#2:
    x64.leaRegRdata rcx, [rip + __layout_Box_Tally]
  __il_body#4:
    x64.loadRegBaseDisp.word64 rdx, [r12 + 0]
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
  __il_cont#1:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
