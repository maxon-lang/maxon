// Test: error.sizeof-in-a-closure-in-a-static-is-refused
typealias Int = int(i64.min to i64.max)

type Cell uses T
	var v as T

	static function create(v T) returns Self
		return Self{v: v}
	end 'create'

	static function sized(v T, n Int) returns Self
		let f = function() gives sizeof(T) + n
		_ = f()
		return Self{v: v}
	end 'sized'
end 'Cell'

typealias IntCell = Cell with Int

function main() returns ExitCode
	let c = IntCell.create(4)
	let d = IntCell.sized(2, n: 1)
	return (d.v + c.v) as ExitCode
end 'main'
---
CompilerError:
error E2015: <fragment>:12:28: Unsupported: sizeof of a type parameter with no instance receiver in scope — a `static function`, and a closure written inside one, are receiverless, and B1 threads the layout descriptor from the instance a method is called on; read the size through an instance method on `self`, or a concrete instance, instead
