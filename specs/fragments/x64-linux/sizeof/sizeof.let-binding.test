// Test: sizeof.let-binding
function main() returns ExitCode
	let size = sizeof(int)
	return size
end 'main'
---
ExitCode: 8
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 8
    x64.popReg rbp
    x64.ret
}
