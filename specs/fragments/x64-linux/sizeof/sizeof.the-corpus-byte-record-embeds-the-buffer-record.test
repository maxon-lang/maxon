// Test: sizeof.the-corpus-byte-record-embeds-the-buffer-record
function main() returns ExitCode
	return sizeof(String) as ExitCode
end 'main'
---
ExitCode: 56
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 56
    x64.popReg rbp
    x64.ret
}
