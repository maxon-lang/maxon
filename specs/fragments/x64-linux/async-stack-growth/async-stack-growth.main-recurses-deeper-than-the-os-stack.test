  __gt_gfree_head@184 = i64 0
  __sched_npidle@192 = i64 0
  __sched_runq_size@200 = i64 0
  __sched_mcount@208 = i64 0
  __sched_num_procs@216 = i64 0
  __sched_shutdown_flag@224 = i64 0
  __sched_lock@232 = i64 0
  __sched_nmspinning@240 = i64 0
  __sched_parked_drivers@248 = i64 0
  __sched_sysmon_started@256 = i64 0
  __mrt_envp@264 = i64 0
  __mrt_tls_next_key@272 = i64 0
  __mrt_errno@280 = i64 0
  __mrt_tls_ready@288 = i64 0
  __slab_arena_list@296 = i64 0
  __slab_arena_map_l1@304 = i64 0
  __slab_state@312 = i64 0
}

func @down {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  bottom:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect down
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 1
    x64.callDirect sleep
    x64.movRegImm32 rcx, 2000000
    x64.callDirect down
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "depth="
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
