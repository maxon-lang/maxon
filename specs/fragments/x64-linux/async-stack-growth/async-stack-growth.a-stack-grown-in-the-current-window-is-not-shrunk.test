func @down {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  bottom:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect down
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

