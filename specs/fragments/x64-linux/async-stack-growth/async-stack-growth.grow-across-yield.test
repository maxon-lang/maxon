func @deepRecurse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  base:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect deepRecurse
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @yieldThenRecurse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
  __rc_ok:
    x64.callDirect __gt_sleep
  __il_cont:
    x64.movRegImm32 rcx, 200
    x64.callDirect deepRecurse
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + yieldThenRecurse]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at async-stack-growth.grow-across-yield.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
