// Test: byte-string-literal.constant-into-a-struct-field-detaches
let Keyword = b"critsplit"

type Holder
		export var b as ByteArray

		export static function create(b ByteArray) returns Self
				return Self{b: b}
		end 'create'
end 'Holder'

function main() returns ExitCode
		let h = Holder.create(Keyword)
		h.b.push(88)
		let k = try Keyword.get(0) otherwise 0
		print("{h.b.count()} {Keyword.count()} {k}")
		return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 120
    x64.leaRegRdata rcx, [rip + __barr_rec_2]
    x64.callDirect __managed_retain
    x64.movRegReg rbx, r8
