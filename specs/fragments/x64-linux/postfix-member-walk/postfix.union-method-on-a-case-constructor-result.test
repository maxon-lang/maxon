  matchnext#16:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead#15
  matcharm#14:
    x64.movRegReg rcx, rdx
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
