  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 125
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.imulRegRegImm32 r8, rcx, 3
  __rc_chk#6:
    x64.cmpRegImm32 r8, 125
    x64.jcc greater, __rc_panic#5
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at util.maxon:3: Range check failed: value outside typealias 'Integer'\x0a"
    x64.callDirect mrt_panic
