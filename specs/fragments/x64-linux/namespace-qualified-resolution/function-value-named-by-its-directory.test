    x64.ret
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at util.maxon:4: Range check failed: value outside typealias 'Integer'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_triple]
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 0
    x64.callReg rax
    x64.epilogue 32
    x64.popReg rbp
