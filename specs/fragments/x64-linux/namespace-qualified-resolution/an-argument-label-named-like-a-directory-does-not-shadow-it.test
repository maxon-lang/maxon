// Test: an-argument-label-named-like-a-directory-does-not-shadow-it
// --- file: api/score.maxon
export type Score
	export let v as ExitCode

	export static function make() returns Score
		return Score{v: 30}
	end 'make'
end 'Score'

// --- file: app/main.maxon
typealias Score = int(0 to 10)

function scaled(by ExitCode, api ExitCode) returns ExitCode
	return by + api
end 'scaled'

function main() returns ExitCode
	let local = 4 as Score
	let base = scaled(1, api: 2)
	return base + api.Score.make().v + (local as ExitCode)
end 'main'
---
ExitCode: 37
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 30
  __il_cont:
    x64.andRegImm32 rax, rax, 255
    x64.leaRegRegImm32 rax, rax, 3
    x64.leaRegRegImm32 r8, rax, 4
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
