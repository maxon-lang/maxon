// Test: a-file-private-and-an-exported-alias-in-one-directory-coexist
// --- file: api/a.maxon
typealias Score = int(0 to 10)

export function small() returns ExitCode
	return 4 as Score
end 'small'

// --- file: api/b.maxon
export typealias Score = int(0 to 100)

// --- file: app/main.maxon
function main() returns ExitCode
	let s = 38 as Score
	return (s + (small() as Score)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 38
  __rc_ok#1:
    x64.leaRegRegImm32 r8, rax, 4
  __rc_ok#4:
    x64.popReg rbp
    x64.ret
}
