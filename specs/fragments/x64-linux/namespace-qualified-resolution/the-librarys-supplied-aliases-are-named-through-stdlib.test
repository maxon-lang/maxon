// Test: the-librarys-supplied-aliases-are-named-through-stdlib
function main() returns ExitCode
	let c = 70 as stdlib.Codepoint
	let i = 2 as stdlib.ElementIndex
	let p = 3 as stdlib.BytePos
	let bytes = "hello".toByteArray()
	let b = try bytes.get(p) otherwise 0
	return (c + (b as Codepoint) - 100 + (i as Codepoint)) as ExitCode
end 'main'
---
ExitCode: 80
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 3
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello"
  __il_body#19:
    x64.movRegImm32 rdx, 0
  __il_body#23:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont#22:
    x64.callDirect __managed_slice
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr#21:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at String.maxon:149: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_cont#18:
    x64.loadRegBaseDisp.word64 rax, [r13 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 3
    x64.jcc belowEqual, __im_slow
  __im_load#16:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.leaRegRegImm32 rax, rax, 24
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp trycont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 3
    x64.jcc belowEqual, __im_slow
  __im_load#17:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.leaRegRegImm32 rax, rax, 3
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp trycont
  __im_slow:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
  tryerr#2:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  critsplit:
    x64.movRegReg rax, r8
  trycont:
    x64.leaRegRegImm32 rax, rax, 70
    x64.leaRegRegImm32 rax, rax, -100
  __rc_ok#4:
    x64.leaRegRegImm32 rbx, rax, 2
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#7:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at the-librarys-supplied-aliases-are-named-through-stdlib.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
