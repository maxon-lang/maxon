// Test: a-top-level-binding-named-like-a-directory-keeps-its-member-access
// --- file: api/upper.maxon
export type Upper
	export let v as ExitCode

	export static function make() returns Upper
		return Upper{v: 30}
	end 'make'
end 'Upper'

// --- file: app/main.maxon
type Holder
	export let Upper as ExitCode

	static function make() returns Holder
		return Holder{Upper: 7}
	end 'make'
end 'Holder'

let api = Holder.make()

function main() returns ExitCode
	return api.Upper + seven()
end 'main'

// --- file: app/other.maxon
module function seven() returns ExitCode
	return api.Upper.make().v
end 'seven'
---
ExitCode: 37
---
data {
  __data_api@0 = i64 0
  __mrt_envp@8 = i64 0
  __mrt_signal_stack_bytes@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_api
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.andRegImm32 rax, rax, 255
  __il_body:
    x64.movRegImm32 rcx, 30
  __il_cont#6:
    x64.andRegImm32 rcx, rcx, 255
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at main.maxon:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
