// Test: one-alias-reached-by-its-bare-and-qualified-spellings-is-one-type
// --- file: aaa/s.maxon
export typealias Small = int(0 to 1000)

export function bump(v Small) returns Small
	return v + 1
end 'bump'

// --- file: app/main.maxon
function main() returns ExitCode
	let x = 5 as aaa.Small
	return (aaa.bump(3) + x) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok#6:
    x64.movRegImm32 rax, 4
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 5
  __rc_ok#1:
    x64.popReg rbp
    x64.ret
}
