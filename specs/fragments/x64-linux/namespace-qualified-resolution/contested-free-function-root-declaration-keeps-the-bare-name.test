// Test: contested-free-function-root-declaration-keeps-the-bare-name
// --- file: r.maxon
public typealias Integer = int(0 to 125)

public function pick() returns Integer
	return 3
end 'pick'

// --- file: beta/b.maxon
export typealias Integer = int(0 to 125)

export function pick() returns Integer
	return 5
end 'pick'

// --- file: app/main.maxon
function main() returns ExitCode
	return (pick() * 10 + beta.pick()) as ExitCode
end 'main'
---
ExitCode: 35
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 3
  __il_cont#5:
    x64.imulRegRegImm32 rax, rax, 10
  __il_cont#4:
    x64.leaRegRegImm32 r8, rax, 5
  __rc_ok:
    x64.popReg rbp
    x64.ret
