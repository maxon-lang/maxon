// Test: byte.clone

typealias Integer = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let x = 65 as Byte
	let y = x.clone() as Integer
	return y
end 'main'
---
ExitCode: 65
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 65
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
