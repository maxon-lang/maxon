// Test: where-clauses.user-defined

typealias Integer = int(i64.min to i64.max)

interface Valuable
		function value() returns Integer
end 'Valuable'

type Wrapper implements Valuable
		let n as Integer

		function value() returns Integer
				return self.n
		end 'value'

		static function create(n Integer) returns Self
			return Self{n: n}
		end 'create'
end 'Wrapper'

type Holder uses T where T is Valuable
		export var item as T

		static function create(item T) returns Self
			return Self{item: item}
		end 'create'
end 'Holder'

typealias WrapperHolder = Holder with Wrapper

function main() returns ExitCode
		let w = Wrapper.create(10)
		let h = WrapperHolder.create(w)
		return h.item.value()
end 'main'
---
ExitCode: 10
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Wrapper.value {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 10
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Wrapper.Valuable]
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#4:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_body#9:
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
  __il_cont#8:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Holder_Wrapper
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at where-clauses.user-defined.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
