// Test: where-clauses.float-formal-among-int-formals
typealias Coord = int(0 to 1000)

interface Mixed
	function combine(a Integer, k Real, b Integer) returns Real
end 'Mixed'

type Point implements Mixed
	export var x as Coord
	export static function create(x Coord) returns Self
		return Self{ x: x }
	end 'create'
	export function combine(a Integer, k Real, b Integer) returns Real
		return k + a + b
	end 'combine'
end 'Point'

type Box uses T where T is Mixed
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function go() returns Real
		return self.item.combine(1, k: 3, b: 5)
	end 'go'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let b = PointBox.create(Point.create(7))
	if b.go() == 9.0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
typealias Integer = int(i64.min to i64.max)
typealias Real = float(f64.min to f64.max)
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Point.combine {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cvtsi2sdRegReg xmm1, rdx
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.cvtsi2sdRegReg xmm1, rax
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 7
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Point.Mixed]
  __il_body#10:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#4:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRdata rsi, [rip + __witness_Point.Mixed]
  __il_body#11:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 5
    x64.movsdRegRip xmm0, [rip + __fconst_3]
    x64.callMem [rsi + 24]
  __il_cont#3:
    x64.movsdRegRip xmm1, [rip + __fconst_9]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Point
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Point
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
