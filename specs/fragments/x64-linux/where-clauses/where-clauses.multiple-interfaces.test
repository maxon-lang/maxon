// Test: where-clauses.multiple-interfaces

typealias Integer = int(i64.min to i64.max)

interface HasName
		function name() returns Integer
end 'HasName'

interface HasAge
		function age() returns Integer
end 'HasAge'

type Person implements HasName, HasAge
		let age as Integer

		function name() returns Integer
				return 1
		end 'name'

		function age() returns Integer
				return self.age
		end 'age'

		static function create(age Integer) returns Self
			return Self{age: age}
		end 'create'
end 'Person'

type Registry uses T where T is HasName and HasAge
		export var item as T

		static function create(item T) returns Self
			return Self{item: item}
		end 'create'
end 'Registry'

typealias PersonRegistry = Registry with Person

function main() returns ExitCode
		let p = Person.create(30)
		let r = PersonRegistry.create(p)
		return r.item.age()
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Person.name {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @Person.age {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Person.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Registry.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 30
    x64.callDirect Person.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_Person.HasName]
    x64.leaRegRdata rax, [rip + __witness_Person.HasAge]
    x64.movRegReg rcx, rbx
    x64.callDirect Registry.create
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
  __il_cont:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Registry_Person
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at where-clauses.multiple-interfaces.test:42: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
