// Test: iterate
function main() returns ExitCode
	let arr = [true, false, true, true, false]
	var count = 0
	for v in arr 'loop'
		if v 'check'
			count = count + 1
		end 'check'
	end 'loop'
	return count
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 5
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm rax, 18446744073709551615
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  __us_test:
    x64.loadRegBaseDisp.word64 r14, [rbx + 8]
    x64.jmp forhdr
  loop:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get_unchecked
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  check:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp forstep
  critsplit:
    x64.movRegReg rax, r12
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, rax
  forhdr:
    x64.cmpRegReg r13, r14
    x64.jcc less, loop
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at iterate.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
