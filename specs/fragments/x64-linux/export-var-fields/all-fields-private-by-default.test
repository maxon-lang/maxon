// Test: all-fields-private-by-default

typealias Integer = int(i64.min to i64.max)

type Simple
	var x as Integer
	var y as Integer

	static function make(a Integer, b Integer) returns Self
		return Simple{x: a, y: b}
	end 'make'

	function sum() returns Integer
		return x + y
	end 'sum'
end 'Simple'

function main() returns ExitCode
	let s = Simple.make(20, b: 22)
	return s.sum()
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 20
    x64.movRegImm32 rcx, 22
  __il_body:
    x64.leaRegRegReg r8, rax, rcx
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at all-fields-private-by-default.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
