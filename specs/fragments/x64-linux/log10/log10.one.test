// Test: log10.one
function main() returns ExitCode
	let result = Math.log10(1.0)
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  one:
    x64.movsdRegRip xmm0, [rip + __fconst_0]
  __il_cont#5:
    x64.movsdRegRip xmm1, [rip + __fconst_2.302585092994046]
    x64.divsdRegReg xmm0, xmm0, xmm1
  __il_cont#3:
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
