// Test: same-file-payload-free-enum-field-off-a-temporary
enum Color
	red
	green
end 'Color'

type Gate
	export var c as Color

	static function make() returns Gate
		return Gate{c: Color.green}
	end 'make'
end 'Gate'

function main() returns ExitCode
	let c = Gate.make().c
	match c 'which'
		red then return 1
		green then return 42
	end 'which'
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rbx, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 42
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
