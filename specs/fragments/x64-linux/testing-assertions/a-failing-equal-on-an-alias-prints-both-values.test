// Test: a-failing-equal-on-an-alias-prints-both-values
// --- file: main.maxon
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let i = 5 as Integer
	try Expect.equal(i, expected: 6) otherwise ignore

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 r12, 6
  __il_body:
    x64.leaRegRdata rcx, [rip + __str_rec_27]  ; ""
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
  __il_cont:
    x64.leaRegRdata r9, [rip + __str_rec_14]  ; "main.maxon"
    x64.movRegImm32 rsi, 5
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect Expect.equal#__with165_25#int
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, trycont
  trycont:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
