// Test: ternary-expression.basic-false
function main() returns ExitCode
	let x = 10 if false else 20
	return x
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ternaryfalse:
    x64.movRegImm32 r8, 20
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
