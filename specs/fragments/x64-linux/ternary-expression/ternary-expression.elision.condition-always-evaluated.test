// Test: ternary-expression.elision.condition-always-evaluated
var sideEffectCount = 0

function pick() returns bool
	sideEffectCount = sideEffectCount + 1
	return false
end 'pick'

function main() returns ExitCode
	let x = 1 if pick() else 2
	if x != 2 'v'
		return 99
	end 'v'
	return sideEffectCount
end 'main'
---
ExitCode: 1
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.leaRegGlobal rax, __data_sideEffectCount
    x64.aluBaseDispImm32.add [rax + 0], 1
  ifcont:
    x64.leaRegGlobal rax, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ternary-expression.elision.condition-always-evaluated.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
