// Test: ternary-expression.with-bools
function main() returns ExitCode
	let x = true if true else false
	let result = 1 if x else 0
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  ternarytrue#1:
    x64.movRegImm32 rax, 1
  matchcont#3:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse
  ternarytrue#4:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont#6
  ternaryfalse:
    x64.movRegImm32 r8, 0
  matchcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ternary-expression.with-bools.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
