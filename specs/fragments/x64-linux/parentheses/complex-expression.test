// Test: complex-expression
function main() returns ExitCode
	let result = trunc((10 + (2 * 3)) / (4 - 2))
	return result
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 16
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 r8, rax, 16
    x64.sarRegImm8 r8, r8, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
