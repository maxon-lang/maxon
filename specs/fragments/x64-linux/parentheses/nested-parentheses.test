// Test: nested-parentheses
function main() returns ExitCode
	return ((5 + 3) * 2) - 6
end 'main'
---
ExitCode: 10
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 10
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
