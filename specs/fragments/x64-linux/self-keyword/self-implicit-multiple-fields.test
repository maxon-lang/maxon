// Test: self-implicit-multiple-fields

typealias Integer = int(i64.min to i64.max)

type Rectangle
	var width as Integer
	var height as Integer

	function area() returns Integer
		return width * height
	end 'area'

	static function create(width Integer, height Integer) returns Self
		return Self{width: width, height: height}
	end 'create'
end 'Rectangle'

function main() returns ExitCode
	let r = Rectangle.create(6, height: 7)
	return r.area()
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 6
    x64.movRegImm32 rcx, 7
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
  __il_body:
    x64.loadRegBaseDisp.word64 r8, [rdx + 0]
    x64.loadRegBaseDisp.word64 rax, [rdx + 8]
    x64.imulRegReg r8, r8, rax
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at self-implicit-multiple-fields.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
