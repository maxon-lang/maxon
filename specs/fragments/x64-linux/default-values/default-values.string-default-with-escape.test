// Test: default-values.string-default-with-escape
function show(msg String = "line1\nline2") returns ExitCode
	print(msg)
	return 0
end 'show'

function main() returns ExitCode
	return show()
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body#2:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "line1\x0aline2"
    x64.callDirect __str_retain
    x64.movRegReg rbx, r8
  __il_body#6:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont#5:
    x64.movRegImm32 r12, 0
  __il_cont#3:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
