// Test: locals-inside-a-generic-body-are-named
typealias Tick = int(0 to 1000)

type Accum uses T
	export var seed as T

	static function create(seed T) returns Self
		return Self{seed: seed}
	end 'create'

	function fold(bump Tick) returns Tick
		var total = bump
		var step = 1
		var rounds = 0
		while rounds < 3 'roll'
			total = (total + step) mod 91
			step = step + rounds
			rounds = rounds + 1
		end 'roll'

		return total
	end 'fold'
end 'Accum'

typealias TickAccum = Accum with Tick

function main() returns ExitCode
	let acc = TickAccum.create(5)
	print("{acc.fold(7)}\n")

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
