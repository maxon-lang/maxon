// Test: locals-inside-a-generic-body-are-named
typealias Tick = int(0 to 1000)

type Accum uses T
	export var seed as T

	export static function create(seed T) returns Self
		return Self{seed: seed}
	end 'create'

	export function fold(bump Tick) returns Tick
		var total = bump
		var step = 1
		var rounds = 0
		while rounds < 3 'roll'
			total = (total + step) mod 91
			step = step + rounds
			rounds = rounds + 1
		end 'roll'

		return total
	end 'fold'
end 'Accum'

typealias TickAccum = Accum with Tick

function main() returns ExitCode
	let acc = TickAccum.create(5)
	print("{acc.fold(7)}\n")

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Accum.fold {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 rdx, 1000
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at locals-inside-a-generic-body-are-named.test:11: Range check failed: value outside typealias 'Tick'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rsi, 0
    x64.movRegReg r8, rdx
  whilehdr:
    x64.cmpRegImm32 rsi, 3
    x64.jcc greaterEqual, whileexit
  roll:
    x64.leaRegRegReg rax, r8, rcx
    x64.movRegImm32 rdi, 91
    x64.movRegImm32 rdx, 0
    x64.divReg rdi
    x64.leaRegRegReg rcx, rcx, rsi
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.movRegReg r8, rdx
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#8
  __rc_chk#9:
    x64.cmpRegImm32 r8, 1000
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at locals-inside-a-generic-body-are-named.test:21: Range check failed: value outside typealias 'Tick'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rax, 5
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rdx, 7
    x64.callDirect Accum.fold
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot1, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __uint_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_1]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, rbx, r14
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rbx, slot3
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
