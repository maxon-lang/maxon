// Test: module-let-struct-of-empty-containers-costs-no-allocation
typealias Count = int(0 to 1000)
typealias CountArray = Array with Count
typealias NameArray = Array with String

type Facts
	export var counts as CountArray = CountArray.create()
	export var names as NameArray = NameArray.create()
	static function create() returns Facts
		return Self{}
	end 'create'
end 'Facts'

let SharedFacts = Facts.create()

function main() returns ExitCode
	return (SharedFacts.counts.count() + SharedFacts.names.count()) as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@32768 = i64 0
  __slab_arena_list@32776 = i64 0
  __slab_arena_map_l1@32784 = i64 0
  __slab_state@32792 = i64 0
  __ds_base@32800 = i64 0
  __ds_buf_size@32808 = i64 0
  __ds_buf_mask@32816 = i64 0
  __ds_start_ts@32824 = i64 0
  __ds_lock@32832 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.leaRegRdata rcx, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at module-let-struct-of-empty-containers-costs-no-allocation.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
