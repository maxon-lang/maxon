// Test: struct-enum-field-nested-array-push
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

union Instruction
		load(slot Integer)
		store(slot Integer)
		nop
end 'Instruction'

type Function
		export var name as Integer
		export var body as IntArray
		export var terminator as Instruction
		export var hasTerminator as bool

		static function create(name Integer, body IntArray, terminator Instruction, hasTerminator bool) returns Self
			return Self{name: name, body: body, terminator: terminator, hasTerminator: hasTerminator}
		end 'create'
end 'Function'

function main() returns ExitCode
		var f = Function.create(1, body: IntArray.create(), terminator: Instruction.load(99), hasTerminator: true)
		var i = 0
		while i < 20 'fill'
				f.body.push(i)
				i = i + 1
		end 'fill'
		return f.body.count()
end 'main'
---
ExitCode: 20
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 99
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm32 r13, 1
  __il_body:
    x64.movRegImm32 rcx, 32
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.storeBaseDispReg.word64 [r15 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.storeBaseDispReg.word64 [r15 + 8], r8
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r15 + 16], r14
    x64.storeBaseDispReg.byte [r15 + 24], r13
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_cont:
    x64.movRegImm32 rbx, 0
    x64.jmp whilehdr
  fill:
    x64.loadRegBaseDisp.word64 rcx, [r15 + 8]
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.leaRegRegImm32 rbx, rbx, 1
  whilehdr:
    x64.cmpRegImm32 rbx, 20
    x64.jcc less, fill
  whileexit:
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_Function
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at struct-enum-field-nested-array-push.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
