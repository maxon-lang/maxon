  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at nested-struct-enum-array-grow.test:46: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
