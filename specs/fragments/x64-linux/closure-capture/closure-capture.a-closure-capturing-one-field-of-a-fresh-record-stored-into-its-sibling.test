// Test: closure-capture.a-closure-capturing-one-field-of-a-fresh-record-stored-into-its-sibling
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

function idle() returns Integer
	return 0
end 'idle'

type Inner
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: idle}
	end 'create'
end 'Inner'

type Outer
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: idle}
	end 'create'
end 'Outer'

type Pair
	export var left as Inner
	export var right as Outer

	static function build() returns Self
		var pair = Self{left: Inner.create(3), right: Outer.create(4)}
		let borrowed = pair.left
		pair.right.read = function() gives borrowed.n
		return pair
	end 'build'
end 'Pair'

function main() returns ExitCode
	let pair = Pair.build()
	print("{pair.right.read()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @idle {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Pair.build$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}

func @Pair.build$closure_0$drop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.callDirect __destruct_Inner
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
