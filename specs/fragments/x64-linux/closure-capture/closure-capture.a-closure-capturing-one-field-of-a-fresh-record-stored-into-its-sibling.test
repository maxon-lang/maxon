    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
  __il_body#4:
    x64.movRegImm32 rbx, 3
  __il_body#7:
    x64.leaRegRdata r12, [rip + __fnrec_idle]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_cont#6:
    x64.movRegImm32 rbx, 4
  __il_body#8:
    x64.leaRegRdata r12, [rip + __fnrec_idle]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], rbx
    x64.storeBaseDispReg.word64 [r14 + 8], r12
  __il_cont#5:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
