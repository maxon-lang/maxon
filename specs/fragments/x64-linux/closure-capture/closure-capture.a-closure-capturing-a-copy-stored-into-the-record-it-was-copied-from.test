// Test: closure-capture.a-closure-capturing-a-copy-stored-into-the-record-it-was-copied-from
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

function idle() returns Integer
	return 0
end 'idle'

type Counter
	export var n as Integer
	export var label as String
	export var read as Thunk

	static function create() returns Self
		return Self{n: 7, label: "a label padded long enough to heap allocate {1}", read: idle}
	end 'create'

	export function arm()
		let count = self.n
		let copy = self.label.clone()
		self.read = function() gives count + (copy.byteLength() as Integer) - (copy.byteLength() as Integer)
	end 'arm'
end 'Counter'

function main() returns ExitCode
	var c = Counter.create()
	c.arm()
	print("{c.read()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @idle {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Counter.arm$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 16]
  __il_body#3:
    x64.loadRegBaseDisp.word64 rdx, [rdx + 8]
  __il_cont#2:
    x64.leaRegRegReg r8, rax, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 16]
  __il_body#4:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#1:
    x64.subRegReg r8, r8, rax
    x64.popReg rbp
    x64.ret
}

func @Counter.arm$closure_0$drop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.callDirect __str_decref
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
  __il_body#3:
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "a label padded long enough to heap allocate "
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.movRegImm32 r13, 1
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRegReg rax, r12, r13
    x64.storeSlotReg slot4, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot6, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r13
    x64.loadRegSlot rbx, slot6
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot4
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.leaRegRdata r12, [rip + __fnrec_idle]
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot0, r13
    x64.movRegImm32 rax, 7
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.storeBaseDispReg.word64 [r13 + 16], r12
  __il_body#6:
    x64.loadRegBaseDisp.word64 rbx, [r13 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 8]
  __il_body#8:
    x64.movRegImm32 rdx, 0
  __il_body#14:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont#13:
    x64.loadRegBaseDisp.byte r12, [rcx + 48]
  __il_body#10:
    x64.callDirect __managed_slice
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
  tryok:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.callDirect __str_of_buffer
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
  __il_cont#7:
    x64.leaRegFunc rdx, [rip + Counter.arm$closure_0$drop]
    x64.movRegImm32 rcx, 24
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegFunc rax, [rip + Counter.arm$closure_0]
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.storeBaseDispReg.word64 [r14 + 8], rbx
    x64.storeBaseDispReg.word64 [r14 + 16], r12
    x64.loadRegBaseDisp.word64 rcx, [r13 + 16]
    x64.callDirect __mm_decref
    x64.storeBaseDispReg.word64 [r13 + 16], r14
  __il_cont#5:
    x64.loadRegBaseDisp.word64 rbx, [r13 + 16]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.storeSlotReg slot1, r8
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.movRegReg rcx, rbx
    x64.callReg rax
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot2, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, rbx, r14
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot5, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rax, slot5
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot3
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.loadRegSlot rcx, slot2
    x64.callDirect __mm_decref
  __il_body#4:
    x64.loadRegSlot rcx, slot5
    x64.callDirect __write_stdout
  __il_cont#1:
    x64.loadRegSlot rcx, slot5
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __destruct_Counter
    x64.movRegReg r8, rbx
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at String.maxon:356: String.sliceBytes: caller guarantees 0 <= start <= end <= byteLength()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
