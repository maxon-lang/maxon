// Test: closure-capture.enum-declared-after-a-closure

typealias Integer = int(i64.min to i64.max)

function bumped(n Integer) returns Integer
	let step = function(k Integer) gives k + 1
	return step(n)
end 'bumped'

enum Color
	red
	green
end 'Color'

function shade(c Color) returns Integer
	return match c 'shade'
		red gives 1
		green gives 41
	end 'shade'
end 'shade'

function main() returns ExitCode
	return shade(Color.green) + bumped(0)
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @bumped$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 rax, 41
  __il_body:
    x64.leaRegRdata rcx, [rip + __fnrec_bumped$closure_0]
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
