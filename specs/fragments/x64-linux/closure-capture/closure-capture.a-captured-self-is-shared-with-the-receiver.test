// Test: closure-capture.a-captured-self-is-shared-with-the-receiver
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

type Counter
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'

	function reader() returns Thunk
		return function() gives self.n
	end 'reader'
end 'Counter'

function main() returns ExitCode
	var counter = Counter.create(3)
	let read = counter.reader()
	counter.n = 5
	print("{read()} {counter.n}\n")
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @Counter.reader$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}

func @Counter.reader$closure_0$drop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.callDirect __mm_decref
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

