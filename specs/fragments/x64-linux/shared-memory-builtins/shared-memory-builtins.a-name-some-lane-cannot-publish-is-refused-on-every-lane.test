func @createOutcome {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rdx, 4096
    x64.callDirect SharedSegment.create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.jumpTable rax, default=matchdead [[0]=matcharm#4, [1]=matcharm#5, [2]=matcharm#3, [3]=matcharm#5] @__jumptable_42
  matchdead:
  matcharm#4:
    x64.movRegImm32 r8, 3
    x64.jmp __rc_ok
  matcharm#5:
    x64.movRegImm32 r8, 4
    x64.jmp __rc_ok
  matcharm#3:
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect SharedSegment.close
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_SharedSegment
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

