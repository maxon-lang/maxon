// Test: ranged-codepoint-alias-stays-legal
typealias Codepoint = int(0 to 1114111)

function main() returns ExitCode
	let c = 128512 as Codepoint
	return c - 128512
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
