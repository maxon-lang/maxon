// Test: from-round-trips-non-ascii-bytes
function main() returns ExitCode
	let src = "中文字"
	let back = String.from(src.toByteArray())
	print("{back} {back.count()} {back.byteLength()} {back == src}\n")
	return 0
end 'main'
