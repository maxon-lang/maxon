// Test: max.zero
function main() returns ExitCode
	let x = max(0.0, -5.0)
	if x == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
