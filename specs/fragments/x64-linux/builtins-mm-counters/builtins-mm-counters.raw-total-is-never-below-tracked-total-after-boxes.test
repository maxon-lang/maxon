// Test: builtins-mm-counters.raw-total-is-never-below-tracked-total-after-boxes
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let rawBefore = __Builtins.mmRawAllocTotal()
	let boxesBefore = __Builtins.mmAllocTotal()
	var buf = ByteArray.create()
	for _ in 0 upto 256 'push'
		buf.push(3)
	end 'push'
	let raw = __Builtins.mmRawAllocTotal()
	let boxes = __Builtins.mmAllocTotal()
	var score = 0
	if boxes > boxesBefore 'theWindowBoxedSomething'
		score = score + 1
	end 'theWindowBoxedSomething'
	if raw >= 0 'theSubtractionStaysPositive'
		score = score + 2
	end 'theSubtractionStaysPositive'
	if raw + boxes - rawBefore - boxesBefore >= boxes - boxesBefore 'everyBoxIsASlabRequest'
		score = score + 4
	end 'everyBoxIsASlabRequest'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_alloc_total
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  push:
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr:
    x64.cmpRegImm32 r14, 256
    x64.jcc less, push
  forexit:
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r14, r8
    x64.callDirect __mm_counter_alloc_total
    x64.movRegImm32 rax, 0
    x64.cmpRegReg r8, r12
    x64.jcc lessEqual, ifcont#6
  theWindowBoxedSomething:
    x64.movRegImm32 rax, 1
  ifcont#6:
    x64.cmpRegImm32 r14, 0
    x64.jcc less, ifcont#8
  theSubtractionStaysPositive:
    x64.leaRegRegImm32 rax, rax, 2
  ifcont#8:
    x64.leaRegRegReg rcx, r14, r8
    x64.subRegReg rcx, rcx, rbx
    x64.subRegReg rcx, rcx, r12
    x64.subRegReg r8, r8, r12
    x64.cmpRegReg rcx, r8
    x64.jcc less, critsplit
  everyBoxIsASlabRequest:
    x64.leaRegRegImm32 rbx, rax, 4
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg rbx, rax
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
