module function probeDebugStreamWords() returns MachineWord
	return __Raw.loadWord(__Raw.dsBaseAddr(), offset: 0) + __Raw.loadWord(__Raw.dsAllocIdAddr(), offset: 0)
end 'probeDebugStreamWords'
// --- file: main.maxon
