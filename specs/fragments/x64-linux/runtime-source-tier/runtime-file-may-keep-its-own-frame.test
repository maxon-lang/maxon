// Test: runtime-file-may-keep-its-own-frame
// --- runtime-file: Probe.maxon
function __probe_marked()
	__Raw.ownFrame()
end '__probe_marked'
// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
