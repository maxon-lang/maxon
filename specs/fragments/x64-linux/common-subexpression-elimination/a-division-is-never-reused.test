// Test: a-division-is-never-reused
typealias Word = int(i64.min to i64.max)
// The divisor's type excludes zero, but a NEGATIVE dividend needs a signed division, which is spelled only
// through a `Word` divisor the compiler must treat as possibly zero — hence the `try`. The op is still impure.
typealias NonZeroWord = int(1 to i64.max)

function halves(a Word, b NonZeroWord) returns Word
	return (try (a / (b as Word)) otherwise panic("b is never zero")) + (try (a / (b as Word)) otherwise panic("b is never zero")) + (try (a mod (b as Word)) otherwise panic("b is never zero")) + (try (a mod (b as Word)) otherwise panic("b is never zero"))
end 'halves'

function main() returns ExitCode
	if halves(17, b: 5) != 10 'quotientAndRemainder'
		return 1
	end 'quotientAndRemainder'
	if halves(-17, b: 5) != -10 'negativeTruncatesTowardZero'
		return 2
	end 'negativeTruncatesTowardZero'
	return 0
end 'main'
---
ExitCode: 0
---
func @halves {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.cmpRegImm32 rsi, 1
    x64.jcc less, __rc_panic
  __rc_ok:
    x64.movRegImm rax, 9223372036854775808
    x64.movRegReg rdx, rcx
    x64.xorRegReg rdx, rcx, rax
    x64.movRegReg rdi, rsi
    x64.xorRegImm32 rdi, rsi, -1
    x64.orRegReg rdx, rdx, rdi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, divovf#1
  divok#2:
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.movRegReg r8, rax
  tryok#3:
    x64.movRegImm rax, 9223372036854775808
    x64.movRegReg rdx, rcx
    x64.xorRegReg rdx, rcx, rax
    x64.orRegReg rdx, rdx, rdi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, divovf#5
  divok#6:
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
  tryok#7:
    x64.leaRegRegReg rdi, r8, rax
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -1
    x64.andRegReg rax, rax, rcx
    x64.cqo
    x64.idivReg rsi
  tryok#9:
    x64.leaRegRegReg rdi, rdi, rdx
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -1
    x64.andRegReg rax, rax, rcx
    x64.cqo
    x64.idivReg rsi
  tryok#11:
    x64.leaRegRegReg r8, rdi, rdx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-division-is-never-reused.test:7: Range check failed: value outside typealias 'NonZeroWord'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  divovf#1:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic: integer overflow\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  divovf#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic: integer overflow\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 17
    x64.movRegImm32 rdx, 5
    x64.callDirect halves
    x64.cmpRegImm32 r8, 10
    x64.jcc equal, ifcont#2
  quotientAndRemainder:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm rcx, 18446744073709551599
    x64.movRegImm32 rdx, 5
    x64.callDirect halves
    x64.cmpRegImm32 r8, -10
    x64.jcc equal, ifcont#4
  negativeTruncatesTowardZero:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
