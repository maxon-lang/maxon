  __il_cont:
    x64.cmpRegImm32 rax, 100
    x64.setccReg equal, r12
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok
  ternaryfalse:
