// Test: union-cond-reassign-else
typealias Integer = int(i64.min to i64.max)

union Num
	none
	val(v Integer)
end 'Num'

function pick(u Num, c Integer) returns Integer
	var q = u
	if c > 0 'b'
		q = Num.val(7)
	end 'b'
	return match q 'm'
		none gives 0
		val(v) gives v
	end 'm'
end 'pick'

function main() returns ExitCode
	let base = Num.val(5)
	return pick(base, c: 0)
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
  __il_body:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_retain
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#8:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#9:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
  matchcont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at union-cond-reassign-else.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
