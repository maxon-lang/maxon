// Test: a-counter-step-on-a-global
var hits = 0

function main() returns ExitCode
	var n = 0

	while n < 7 'loop'
		hits = hits + 1
		n = n + 1
	end 'loop'

	return hits
end 'main'
---
ExitCode: 7
---
data {
  __data_hits@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  loop:
    x64.leaRegGlobal rcx, __data_hits
    x64.aluBaseDispImm32.add [rcx + 0], 1
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegImm32 rax, 7
    x64.jcc less, loop
  whileexit:
    x64.leaRegGlobal rax, __data_hits
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-counter-step-on-a-global.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
