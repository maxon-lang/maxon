// Test: the-word-read-on-the-right-of-a-sum-is-the-same-step
var hits = 4
var operand = 0

function main() returns ExitCode
	operand = 10
	hits = operand + hits
	return hits
end 'main'
---
ExitCode: 14
---
data {
  __data_hits@0 = i64 4
  __data_operand@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 10
    x64.leaRegGlobal rcx, __data_operand
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_operand
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegGlobal rcx, __data_hits
    x64.aluBaseDispReg.add [rcx + 0], rax
    x64.leaRegGlobal rax, __data_hits
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at the-word-read-on-the-right-of-a-sum-is-the-same-step.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
