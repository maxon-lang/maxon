// Test: a-constant-on-the-left-of-a-sum-is-the-same-step
var hits = 4

function main() returns ExitCode
	hits = 1 + hits
	return hits
end 'main'
---
ExitCode: 5
---
data {
  __data_hits@0 = i64 4
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_hits
    x64.aluBaseDispImm32.add [rax + 0], 1
    x64.leaRegGlobal rax, __data_hits
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-constant-on-the-left-of-a-sum-is-the-same-step.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
