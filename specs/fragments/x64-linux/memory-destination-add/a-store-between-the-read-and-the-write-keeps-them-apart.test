// Test: a-store-between-the-read-and-the-write-keeps-them-apart
var slot = 5

function main() returns ExitCode
	let seen = slot
	slot = 100
	slot = seen + 1
	return slot
end 'main'
---
ExitCode: 6
---
data {
  __data_slot@0 = i64 5
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_slot
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 100
    x64.leaRegGlobal rdx, __data_slot
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_slot
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_slot
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-store-between-the-read-and-the-write-keeps-them-apart.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
