func @down {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  bottom:
    x64.movRegReg r8, rdx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rsi, rcx, -1
    x64.imulRegRegImm32 rax, rdx, 31
    x64.leaRegRegReg rdi, rax, rcx
    x64.movRegImm rax, 9671377542784405045
    x64.imulHighReg rdi
    x64.leaRegRegReg rax, rdx, rdi
    x64.sarRegImm8 rax, rax, 19
    x64.movRegReg rcx, rax
    x64.shrRegImm8 rcx, rax, 63
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rax, rax, 1000003
    x64.movRegReg rdx, rdi
    x64.subRegReg rdx, rdi, rax
    x64.movRegReg rcx, rsi
    x64.callDirect down
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

