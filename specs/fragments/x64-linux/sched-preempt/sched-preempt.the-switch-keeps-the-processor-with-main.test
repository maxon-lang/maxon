    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, ifcont
  leaf:
    x64.imulRegRegImm32 rax, rcx, 31
    x64.leaRegRegImm32 r8, rax, 7
    x64.movRegImm rax, 9671377542784405045
    x64.imulHighReg r8
    x64.leaRegRegReg rax, rdx, r8
    x64.sarRegImm8 rax, rax, 19
    x64.movRegReg rcx, rax
    x64.shrRegImm8 rcx, rax, 63
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rax, rax, 1000003
    x64.subRegReg r8, r8, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.imulRegRegImm32 rax, rcx, 17
    x64.leaRegRegReg rcx, rax, rsi
    x64.movRegImm rax, 9671377542784405045
    x64.imulHighReg rcx
    x64.leaRegRegReg rax, rdx, rcx
    x64.sarRegImm8 rax, rax, 19
    x64.movRegReg rdx, rax
    x64.shrRegImm8 rdx, rax, 63
    x64.leaRegRegReg rax, rax, rdx
    x64.imulRegRegImm32 rax, rax, 1000003
    x64.subRegReg rcx, rcx, rax
    x64.leaRegRegImm32 rdx, rsi, -1
    x64.callDirect step
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

