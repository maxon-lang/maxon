// Test: an-honest-signed-sentinel-still-decodes
typealias Slot = int(-1 to 4095)

function findSlot(key Slot) returns Slot
	if key == 7 'found'
		return 3
	end 'found'
	return -1
end 'findSlot'

function main() returns ExitCode
	let slot = findSlot(9)

	if slot >= 0 'wronglyFound'
		return 1
	end 'wronglyFound'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
