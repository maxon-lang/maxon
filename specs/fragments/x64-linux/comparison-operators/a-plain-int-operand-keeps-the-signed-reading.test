// Test: a-plain-int-operand-keeps-the-signed-reading
typealias Wide = bits(64)
typealias Signed = int(i64.min to i64.max)

function wide(n Wide) returns Wide
	return n
end 'wide'

function signed(n Signed) returns Signed
	return n
end 'signed'

function main() returns ExitCode
	let three = signed(3)
	let minusOne = signed(-1)

	if three > minusOne 'ordered'
		return 42
	end 'ordered'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ordered:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
