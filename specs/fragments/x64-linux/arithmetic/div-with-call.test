// Test: div-with-call

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function helper(x Integer) returns Integer
	return x * 2
end 'helper'

function divCall(a Integer, b NonZero) returns Integer
	let temp = trunc(try (a / (b as Integer)) otherwise panic("b is never zero"))
	let result = helper(temp)
	return result + temp
end 'divCall'

function main() returns ExitCode
	return divCall(10, b: 2)
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 10
  __rc_ok#8:
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 rax, rax, 10
    x64.sarRegImm8 rax, rax, 1
  __il_body:
    x64.imulRegRegImm32 rcx, rax, 2
  __il_cont:
    x64.leaRegRegReg r8, rcx, rax
  __rc_ok#1:
    x64.popReg rbp
    x64.ret
}
