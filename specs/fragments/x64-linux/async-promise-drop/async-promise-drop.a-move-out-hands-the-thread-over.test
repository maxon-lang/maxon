  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_17]  ; "noyield.txt"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
