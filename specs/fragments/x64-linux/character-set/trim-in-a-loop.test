// Test: trim-in-a-loop
function main() returns ExitCode
	var i = 0
	var total = 0
	while i < 50 'loop'
		let padded = "  x  "
		let t = padded.trim()
		total = total + t.byteLength()
		i = i + 1
	end 'loop'
	print("{total}")
	return 0
end 'main'
