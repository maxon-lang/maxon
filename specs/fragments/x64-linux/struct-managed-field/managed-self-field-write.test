// Test: managed-self-field-write
type Box
	export var name as String

	function setName(n String)
		name = n
	end 'setName'

	static function create() returns Self
		return Self{name: "aaa"}
	end 'create'
end 'Box'

function main() returns ExitCode
	var b = Box.create()
	b.setName("bb")
	if b.name == "bb" 'ok'
		return 2
	end 'ok'
	return 0
end 'main'
---
ExitCode: 2
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#5:
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "aaa"
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
  __il_cont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "bb"
  __il_body#6:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.storeBaseDispReg.word64 [r12 + 0], r13
  __il_cont#3:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "bb"
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Box
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Box
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
