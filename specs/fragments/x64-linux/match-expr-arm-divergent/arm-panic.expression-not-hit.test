// Test: arm-panic.expression-not-hit
function main() returns ExitCode
	let x = 3
	let result = match x 'eval'
		1 panic("not one")
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 30
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
