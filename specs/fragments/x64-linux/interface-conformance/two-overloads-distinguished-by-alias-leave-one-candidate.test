// Test: two-overloads-distinguished-by-alias-leave-one-candidate
typealias Code = int(0 to u32.max)
typealias Small = int(0 to 100)

interface Labeled
	function label(v Code) returns Code
end 'Labeled'

type Tag implements Labeled
	export var x as Code

	export static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'

	export function label(v Code) returns Code
		return v
	end 'label'

	export function label(v Small) returns Code
		return 7
	end 'label'
end 'Tag'

function main() returns ExitCode
	let t = Tag.create(42)
	return t.label(t.x)
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 42
  __rc_ok#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
  __il_body:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic#12
  __rc_chk#3:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at two-overloads-distinguished-by-alias-leave-one-candidate.test:16: Range check failed: value outside typealias 'Code'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at two-overloads-distinguished-by-alias-leave-one-candidate.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
