// Test: builtin-interface-user-code
type MyCollection uses Element implements BuiltinArrayLiteral
	typealias Buf = __ManagedMemory with Element

	var managed as Buf

	static function init(managed Buf) returns Self
		return Self{managed: managed}
	end 'init'
end 'MyCollection'

function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
