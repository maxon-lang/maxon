// Test: process-executable-path.is-absolute-posix
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	var score = 0
	if exe.path.byteLength() > 1 'longerThanTheRoot'
		score = score + 1
	end 'longerThanTheRoot'
	if exe.path.startsWith("/") 'rootQualified'
		score = score + 2
	end 'rootQualified'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mrt_envp@8 = i64 0
  __mrt_signal_stack_bytes@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Process.executablePath
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont:
    x64.cmpRegImm32 rax, 1
    x64.jcc belowEqual, ifcont
  longerThanTheRoot:
    x64.movRegImm32 r12, 1
  ifcont:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.leaRegRdata rdx, [rip + __str_rec_29]  ; "/"
    x64.callDirect String.startsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, __rc_ok
  rootQualified:
    x64.leaRegRegImm32 r12, r12, 2
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
