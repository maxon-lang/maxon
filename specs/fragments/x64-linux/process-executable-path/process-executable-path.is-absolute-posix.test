// Test: process-executable-path.is-absolute-posix
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	var score = 0
	if exe.path.byteLength() > 1 'longerThanTheRoot'
		score = score + 1
	end 'longerThanTheRoot'
	if exe.path.startsWith("/") 'rootQualified'
		score = score + 2
	end 'rootQualified'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Process.executablePath
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
  __il_body#15:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#14:
    x64.cmpRegImm32 rax, 1
    x64.jcc belowEqual, ifcont#4
  longerThanTheRoot:
    x64.movRegImm32 r12, 1
  ifcont#4:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.leaRegRdata rax, [rip + __str_rec_16]  ; "/"
  __il_body#18:
    x64.loadRegBaseDisp.word64 rsi, [rax + 8]
  __il_body#19:
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
  __il_cont#16:
    x64.cmpRegReg rsi, rdx
    x64.jcc belowEqual, ifcont#13
  tooLong:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont#10
  ifcont#13:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 r9, 0
    x64.callDirect bytesEqual
    x64.movRegReg rax, r8
  __il_cont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __rc_ok
  rootQualified:
    x64.leaRegRegImm32 r12, r12, 2
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
