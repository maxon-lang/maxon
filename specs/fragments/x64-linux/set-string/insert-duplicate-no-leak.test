// Test: insert-duplicate-no-leak
typealias StrSet = Set with String

function main() returns ExitCode
	var s = StrSet.create()
	s.insert("alice")
	s.insert("bob")
	s.insert("carol")
	s.insert("bob")
	return s.count()
end 'main'
