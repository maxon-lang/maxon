// Test: remove-drops-stored-key
typealias StrSet = Set with String

function main() returns ExitCode
	var s = StrSet.create()
	s.insert("alice")
	s.insert("bob")
	s.insert("carol")
	let removed = s.remove("alice")
	if removed 'ok'
		return s.count()
	end 'ok'
	return 1
end 'main'
---
ExitCode: 2
