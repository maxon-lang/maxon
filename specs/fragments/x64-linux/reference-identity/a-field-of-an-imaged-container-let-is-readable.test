// Test: a-field-of-an-imaged-container-let-is-readable
typealias Ver = int(0 to 100)

type Bag uses T
	typealias Items = Array with T
	export var items as Items = Items.create()
	export var version as Ver = 7
	export static function create() returns Self
		return Self{}
	end 'create'
	export function size() returns ExitCode
		return self.items.count() as ExitCode
	end 'size'
end 'Bag'

typealias StrBag = Bag with String

let Shared = StrBag.create()

function main() returns ExitCode
	let viaMethod = Shared.size()
	let viaField = Shared.items.count() as ExitCode
	return ((Shared.version as ExitCode) * 10) + viaMethod + viaField
end 'main'
---
ExitCode: 70
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __struct_rec_0]
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#10
  __rc_chk#11:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic#10
  __il_cont:
    x64.leaRegRdata rcx, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 255
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.leaRegRdata rdx, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 8]
    x64.imulRegRegImm32 rdx, rdx, 10
    x64.leaRegRegReg rax, rdx, rax
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#5
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-field-of-an-imaged-container-let-is-readable.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-field-of-an-imaged-container-let-is-readable.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-field-of-an-imaged-container-let-is-readable.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
