// Test: an-inverted-slice-range-aborts
function main() returns ExitCode
	let s = "hello world"
	let a = try s.findFirst("world") otherwise s.endIndex()
	let bad = s.slice(a, endIndex: s.startIndex())
	print("{bad}\n")
	return 0
end 'main'
