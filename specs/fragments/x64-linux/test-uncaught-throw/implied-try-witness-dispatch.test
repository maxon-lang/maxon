// Test: implied-try-witness-dispatch
// --- file: suite.test.maxon
typealias Code = int(0 to u32.max)

enum DigestError implements Error
	tooSmall
end 'DigestError'

interface Digest
	function digest() returns Code throws DigestError
end 'Digest'

type Point implements Digest
	let x as Code

	static function create(x Code) returns Self
		return Self{x: x}
	end 'create'

	function digest() returns Code throws DigestError
		if self.x < 10 'small'
			throw DigestError.tooSmall
		end 'small'

		return self.x
	end 'digest'
end 'Point'

function make(x Code) returns Digest
	return Point.create(x)
end 'make'

test 'dispatches a throwing requirement'
	let d = make(42)
	let v = d.digest()
	print("digest {v}\n")
end 'dispatches a throwing requirement'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_wireWrapper@0 = i64 0
  __data_wireSeparator@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Point.digest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg rdx, rcx
    x64.andRegReg rdx, rcx, rax
    x64.cmpRegImm32 rdx, 10
    x64.jcc greaterEqual, ifcont
  small:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rcx
    x64.andRegReg r8, rcx, rax
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rcx, rax
    x64.jcc greater, __rc_panic
  __il_cont:
    x64.leaRegRdata r10, [rip + __witness_Point.Digest]
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_14]  ; "panic at suite.test.maxon:27: Range check failed: value outside typealias 'Code'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

