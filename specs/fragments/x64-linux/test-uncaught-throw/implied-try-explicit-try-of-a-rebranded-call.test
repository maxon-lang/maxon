// Test: implied-try-explicit-try-of-a-rebranded-call
// --- file: suite.test.maxon
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias Scores = Array with Integer

enum ApiError implements Error
	notFound
end 'ApiError'

function items(hit bool) returns IntArray throws ApiError
	if not hit 'miss'
		throw ApiError.notFound
	end 'miss'

	var found = IntArray.create()
	found.push(4)
	found.push(5)
	return found
end 'items'

test 'rebrands the fetched items'
	let s = try (items(true) as Scores) otherwise Scores.create()
	Expect.equal(s.count() as AssertedInt, expected: 2)
end 'rebrands the fetched items'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @items {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  miss:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @__test_rebrands_the_fetched_items {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect items
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.jmp trycont
  tryok#1:
    x64.movRegReg rbx, r8
  trycont:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegImm32 r13, 2
  __il_body:
    x64.leaRegRdata rcx, [rip + __str_rec_29]  ; ""
    x64.callDirect __str_retain
    x64.movRegReg r14, r8
  __il_cont:
    x64.leaRegRdata r9, [rip + __str_rec_15]  ; "suite.test.maxon"
    x64.movRegImm32 rsi, 22
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect Expect.equal
    x64.movRegReg r12, r10
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#4:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
