// Test: builtins-type.print-via-stdlib
function main() returns ExitCode
	print("hello\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello\x0a"
  __il_body:
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
