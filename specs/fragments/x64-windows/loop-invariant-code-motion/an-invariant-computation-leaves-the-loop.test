// Test: an-invariant-computation-leaves-the-loop
typealias Word = int(i64.min to i64.max)

function weighted(n Word, k Word) returns Word
	var t = 0
	for _ in 0 upto n 'loop'
		t = t + k * 31 + 7
	end 'loop'
	return t
end 'weighted'

function main() returns ExitCode
	var seed = 0
	for i in 0 upto 4 'feed'
		seed = seed + weighted(i, k: i + 1)
	end 'feed'
	// k*31+7 per trip, n trips: 0 + 69 + 2*100 + 3*131 = 662.
	if seed != 662 'value'
		return 1
	end 'value'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp forhdr#1
  feed:
    x64.leaRegRegImm32 rdx, rcx, 1
  __il_body:
    x64.movRegImm32 rsi, 0
    x64.movRegImm32 rdi, 0
    x64.imulRegRegImm32 r8, rdx, 31
    x64.jmp forhdr#9
  loop:
    x64.leaRegRegReg rsi, rsi, r8
    x64.leaRegRegImm32 rsi, rsi, 7
  forstep#11:
    x64.leaRegRegImm32 rdi, rdi, 1
  forhdr#9:
    x64.cmpRegReg rdi, rcx
    x64.jcc less, loop
  __il_cont:
    x64.leaRegRegReg rax, rax, rsi
  forstep#3:
    x64.movRegReg rcx, rdx
  forhdr#1:
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, feed
  forexit:
    x64.cmpRegImm32 rax, 662
    x64.jcc equal, ifcont
  value:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
