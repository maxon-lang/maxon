// Test: a-scaled-address-with-no-memory-reader-is-still-one-lea
typealias Word = int(i64.min to i64.max)

function scaledAddress(base Word, i Word) returns Word
	return base + i * 8
end 'scaledAddress'

function sharedScaling(base Word, i Word) returns Word
	let scaled = i * 8
	let hi = base + scaled
	let lo = base - scaled
	return hi + lo + scaled
end 'sharedScaling'

function main() returns ExitCode
	var seed = 0
	for i in 0 upto 4 'feed'
		seed = seed + scaledAddress(i, i: i + 1) + sharedScaling(i, i: i + 2)
	end 'feed'
	// scaledAddress: 8, 17, 26, 35 = 86.  sharedScaling: 2*base + 8*(i+2) = 16, 26, 36, 46 = 124.
	if seed != 210 'value'
		return 1
	end 'value'
	if scaledAddress(0, i: seed) != 1680 'scaleOfARuntimeValue'
		return 2
	end 'scaleOfARuntimeValue'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  forhdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc greaterEqual, forexit
  feed:
    x64.leaRegRegImm32 rdx, rcx, 1
  __il_body#11:
    x64.leaRegBaseIndexScale rsi, [rcx + rdx*8]
  __il_cont#10:
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegImm32 rsi, rcx, 2
  __il_body#12:
    x64.imulRegRegImm32 rsi, rsi, 8
    x64.leaRegRegReg rdi, rcx, rsi
    x64.subRegReg rcx, rcx, rsi
    x64.leaRegRegReg rcx, rdi, rcx
    x64.leaRegRegReg rcx, rcx, rsi
  __il_cont#9:
    x64.leaRegRegReg rax, rax, rcx
  forstep:
    x64.movRegReg rcx, rdx
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rax, 210
    x64.jcc equal, __il_body#14
  value:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body#14:
    x64.imulRegRegImm32 rax, rax, 8
  __il_cont#13:
    x64.cmpRegImm32 rax, 1680
    x64.jcc equal, ifcont
  scaleOfARuntimeValue:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
