// Test: ranges.create-iterator
function main() returns ExitCode
		let it = try (1 upto 4).createIterator() otherwise return 99
		var sum = 0
		for v in it 'loop'
				sum = sum + v
		end 'loop'
		return sum
end 'main'
---
ExitCode: 6
