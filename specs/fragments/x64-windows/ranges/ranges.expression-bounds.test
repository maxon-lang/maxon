// Test: ranges.expression-bounds

typealias Integer = int(i64.min to i64.max)

function getStart() returns Integer
		return 1
end 'getStart'

function getEnd() returns Integer
		return 4
end 'getEnd'

function main() returns ExitCode
		var sum = 0
		for i in getStart() to getEnd() 'loop'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
  __il_body:
    x64.movRegImm32 rax, 1
  forhdr:
    x64.cmpRegImm32 rax, 4
    x64.jcc greater, forexit
  loop:
    x64.leaRegRegReg r8, r8, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ranges.expression-bounds.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
