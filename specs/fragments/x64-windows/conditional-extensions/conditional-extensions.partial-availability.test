    x64.jcc notEqual, critsplit#10
  __im_slow:
    x64.movRegReg rcx, rax
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.jmp __im_cont
  critsplit#10:
    x64.movRegReg r10, rsi
    x64.jmp __im_cont
  critsplit#9:
    x64.movRegReg r10, rsi
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at conditional-extensions.partial-availability.test:46: NotEqSeq.current: idx out of bounds\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @NotEqSeq.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.leaRegRegImm32 rax, rax, 1
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
