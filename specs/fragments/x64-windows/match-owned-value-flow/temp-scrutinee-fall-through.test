// Test: temp-scrutinee-fall-through
typealias Integer = int(i64.min to i64.max)

union Num
	zero
	val(n Integer)
end 'Num'

function main() returns ExitCode
	match Num.val(5) 'check'
		zero then print("z")
		val then print("v")
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "z"
    x64.callDirect print
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "v"
    x64.callDirect print
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
