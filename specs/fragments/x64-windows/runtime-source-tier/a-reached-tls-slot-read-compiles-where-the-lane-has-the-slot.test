// Test: a-reached-tls-slot-read-compiles-where-the-lane-has-the-slot
// --- runtime-file: Probe.maxon
function __probe_tls_slot(tebOffset ExitCode) returns ExitCode
	if tebOffset == 0 'neverAMachine'
		return 0
	end 'neverAMachine'

	return __Raw.tlsSlotLoad(tebOffset as MachineWord) as ExitCode
end '__probe_tls_slot'
// --- stdlib-overlay: Builtins.maxon
export function probeTlsSlot(tebOffset ExitCode) returns ExitCode
	return __probe_tls_slot(tebOffset)
end 'probeTlsSlot'
// --- file: main.maxon
function main() returns ExitCode
	return probeTlsSlot(0)
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
  __rc_ok:
    x64.callDirect __probe_tls_slot
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
