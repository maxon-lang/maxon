// Test: runtime-file-may-walk-raw-words-in-a-loop
// --- runtime-file: Probe.maxon
module function probeWords() returns MachineWord
	var total = 0 as MachineWord

	for i in 0 upto 4 'eachIndex'
		total = total + (i as MachineWord)
	end 'eachIndex'

	var bits = total
	var runs = 0 as MachineWord

	while bits > 0 'eachRun'
		runs = runs + (bits and 1)
		bits = bits shr 1
	end 'eachRun'

	return runs
end 'probeWords'
// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
