    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_doubleFn]
    x64.imulRegRegImm32 rax, rax, 0
    x64.leaRegFunc rcx, [rip + __fnref_tripleFn]
    x64.leaRegRegReg rax, rax, rcx
    x64.movRegImm32 rcx, 14
    x64.movRegImm32 rdx, 0
    x64.callReg rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
