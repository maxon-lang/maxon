// Test: function-backing.multi-case-dispatch

typealias Integer = int(i64.min to i64.max)

function doubleFn(x Integer) returns Integer
	return x * 2
end 'doubleFn'

function tripleFn(x Integer) returns Integer
	return x * 3
end 'tripleFn'

enum Op
	doubleOp = doubleFn
	tripleOp = tripleFn
end 'Op'

function main() returns ExitCode
	let dFn = Op.doubleOp.rawValue
	let tFn = Op.tripleOp.rawValue
	return dFn(5) + tFn(10)
end 'main'
---
ExitCode: 40
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @doubleFn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @tripleFn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 3
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_doubleFn]
    x64.leaRegFunc rcx, [rip + __fnref_tripleFn]
    x64.imulRegRegImm32 rcx, rcx, 0
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegFunc rcx, [rip + __fnref_doubleFn]
    x64.imulRegRegImm32 rcx, rcx, 0
    x64.leaRegFunc rdx, [rip + __fnref_tripleFn]
    x64.leaRegRegReg rbx, rcx, rdx
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 0
    x64.callReg rax
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.leaRegRegReg r8, r12, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at function-backing.multi-case-dispatch.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
