// Test: break-then-if-is-refused
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 5 'loop'
		i = i + 1
		if i == 2 'skip'
			break
			if i > 0 'inner'
				total = total + 100
			end 'inner'
		end 'skip'
		total = total + 1
	end 'loop'
	print("{total}\n")
	return 0
end 'main'
---
CompilerError:
error E3071: <fragment>:9:4: unreachable code after 'break'
