// Test: builtins-mm-counters.live-returns-to-its-floor
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function fill()
	var buf = ByteArray.create()
	for _ in 0 upto 64 'push'
		buf.push(3)
	end 'push'
end 'fill'

function main() returns ExitCode
	let liveBefore = __Builtins.mmAllocLive()
	let totalBefore = __Builtins.mmAllocTotal()
	fill()
	let liveAfter = __Builtins.mmAllocLive()
	let totalAfter = __Builtins.mmAllocTotal()
	var score = 0
	if liveAfter == liveBefore 'liveCameBack'
		score = score + 3
	end 'liveCameBack'
	if totalAfter > totalBefore 'totalDidNotComeBack'
		score = score + 4
	end 'totalDidNotComeBack'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect __mm_counter_alloc_live
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_alloc_total
    x64.movRegReg r12, r8
  __il_body:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  push:
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr:
    x64.cmpRegImm32 r14, 64
    x64.jcc less, push
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
  __il_cont:
    x64.callDirect __mm_counter_alloc_live
    x64.movRegReg r13, r8
    x64.callDirect __mm_counter_alloc_total
    x64.movRegImm32 rax, 0
    x64.cmpRegReg r13, rbx
    x64.jcc notEqual, ifcont
  liveCameBack:
    x64.leaRegRegImm32 rax, rax, 3
  ifcont:
    x64.cmpRegReg r8, r12
    x64.jcc lessEqual, critsplit
  totalDidNotComeBack:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rax
  __rc_ok:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
