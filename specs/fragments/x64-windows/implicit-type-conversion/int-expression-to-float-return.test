// Test: int-expression-to-float-return

typealias Float = float(f64.min to f64.max)

function widen(a Integer, b Integer) returns Float
	return a + b
end 'widen'

function main() returns ExitCode
	return trunc(widen(20, b: 22) + 0.5)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movsdRegRip xmm0, [rip + __fconst_42]
  __il_cont:
    x64.movsdRegRip xmm1, [rip + __fconst_0.5]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at int-expression-to-float-return.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
