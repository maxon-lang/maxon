// Test: a-signed-negative-into-an-unsigned-quantity-panics
typealias Count = int(0 to u64.max)
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
	return n
end 'opaque'

function main() returns ExitCode
	let c = opaque(-1) as Count
	print("{c}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-signed-negative-into-an-unsigned-quantity-panics.test:10: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
