// Test: an-unsigned-quantity-cast-to-a-signed-alias-reinterprets
typealias Count = int(0 to u64.max)
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
	return n
end 'opaque'

function main() returns ExitCode
	let c = u64.max as Count
	let minusOne = opaque(0) - 1
	return 7 if (c as Integer) == minusOne else 1
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  ternarytrue:
    x64.movRegImm32 r8, 7
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-unsigned-quantity-cast-to-a-signed-alias-reinterprets.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
