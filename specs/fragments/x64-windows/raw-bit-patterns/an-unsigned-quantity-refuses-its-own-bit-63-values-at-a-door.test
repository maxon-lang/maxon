// Test: an-unsigned-quantity-refuses-its-own-bit-63-values-at-a-door
typealias Count = int(0 to u64.max)

function take(c Count) returns Count
	return c
end 'take'

function main() returns ExitCode
	let extreme = u64.max as Count
	print("{take(extreme)}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at an-unsigned-quantity-refuses-its-own-bit-63-values-at-a-door.test:4: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
