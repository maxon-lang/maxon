// Test: a-mixed-overload-set-guards-at-the-call-against-the-resolved-member
typealias Count = int(0 to u64.max)

function show(c Count) returns Count
	return c
end 'show'

function show(s String) returns Count
	print(s)
	return 0
end 'show'

function main() returns ExitCode
	for i in -2 upto 1 'each'
		print("{show(i)}\n")
	end 'each'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-mixed-overload-set-guards-at-the-call-against-the-resolved-member.test:15: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
