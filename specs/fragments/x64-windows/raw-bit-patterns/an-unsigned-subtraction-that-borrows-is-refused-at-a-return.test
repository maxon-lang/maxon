// Test: an-unsigned-subtraction-that-borrows-is-refused-at-a-return
typealias Count = int(0 to u64.max)

function lessFive(c Count) returns Count
	return c - 5
end 'lessFive'

function main() returns ExitCode
	print("{lessFive(3)}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
  __mrt_program_started@11 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at an-unsigned-subtraction-that-borrows-is-refused-at-a-return.test:5: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
