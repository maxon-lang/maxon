// Test: inclusive-range-start-bound-mutated-in-body
function main() returns ExitCode
	var n = 1
	var total = 0
	for i in n to 3 'l'
		n = n + 1
		total = total + i
	end 'l'
	return total
end 'main'
---
ExitCode: 6
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.movRegImm32 r8, 0
    x64.movRegReg rcx, rax
    x64.jmp forhdr
  l:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegRegReg r8, r8, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc lessEqual, l
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at inclusive-range-start-bound-mutated-in-body.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
