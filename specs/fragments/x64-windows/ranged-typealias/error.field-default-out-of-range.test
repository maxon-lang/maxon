// Test: error.field-default-out-of-range
typealias Percent = int(0 to 100)

type Box
	export var v as Percent = 500

	static function create() returns Self
		return Self{}
	end 'create'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.v
end 'main'
---
CompilerError:
error E3005: <fragment>:8:10: Value 500 is outside the range of 'Percent' (int(0 to 100))
