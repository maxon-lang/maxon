// Test: float-straddling-zero-in-range
typealias Unit = float(-1.0 to 1.0)

function main() returns ExitCode
	let u = -0.5 as Unit
	return trunc(-u * 100.0)
end 'main'
---
ExitCode: 50
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 50
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
