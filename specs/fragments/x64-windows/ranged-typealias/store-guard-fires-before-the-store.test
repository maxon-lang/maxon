// Test: store-guard-fires-before-the-store
typealias Percent = int(0 to 100)
typealias Wide = int(0 to 100000)

type Box
	export var v as Percent = 1

	export static function make() returns Box
		return Self{}
	end 'make'
end 'Box'

function widen(n Wide) returns Wide
	return n + 400
end 'widen'

function main() returns ExitCode
	var b = Box.make()
	let bad = widen(100)
	b.v = bad as Percent
	print("stored\n")
	print("v={b.v}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_9]  ; "panic at store-guard-fires-before-the-store.test:20: Range check failed: value outside typealias 'Percent'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
