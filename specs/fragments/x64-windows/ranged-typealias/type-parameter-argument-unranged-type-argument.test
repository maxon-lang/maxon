// Test: type-parameter-argument-unranged-type-argument
typealias FullInt = int(i64.min to i64.max)

type Box uses T
	export var v as T

	static function create(seed T) returns Self
		return Self{v: seed}
	end 'create'

	function put(value T)
		self.v = value
	end 'put'
end 'Box'

typealias IB = Box with FullInt

function main() returns ExitCode
	var b = IB.create(1)
	b.put(1000000)
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __il_body#3:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#2:
    x64.movRegImm32 rax, 1000000
  __il_body#4:
    x64.storeBaseDispReg.word64 [r8 + 0], rax
  __il_cont#1:
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
