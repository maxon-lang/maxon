// Test: cast-guard-fires-before-the-division
typealias NonZero = int(1 to 1000)
typealias Wide = int(0 to 100000)

function pick(n Wide) returns Wide
	return n - 7
end 'pick'

function main() returns ExitCode
	let z = pick(7)
	let d = z as NonZero
	let q = 100 / d
	print("q={q}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_ok:
    x64.movRegImm32 rax, 0
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at cast-guard-fires-before-the-division.test:11: Range check failed: value outside typealias 'NonZero'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
