// Test: guards-run-in-source-order
typealias Small = int(0 to 10)
typealias Wide = int(0 to 100000)

function widen(n Wide) returns Wide
	return n + 1
end 'widen'

function main() returns ExitCode
	let a = widen(500)
	let b = widen(900)
	let x = a as Small
	let y = b as Small
	return x + y
end 'main'
---
ExitCode: 1
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at guards-run-in-source-order.test:12: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
