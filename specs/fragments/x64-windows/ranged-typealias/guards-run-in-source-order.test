// Test: guards-run-in-source-order
typealias Small = int(0 to 10)
typealias Wide = int(0 to 100000)

function widen(n Wide) returns Wide
	return n + 1
end 'widen'

function main() returns ExitCode
	let a = widen(500)
	let b = widen(900)
	let x = a as Small
	let y = b as Small
	return x + y
end 'main'
---
ExitCode: 1
---
