// Test: error.array-push-out-of-range
typealias Percent = int(0 to 100)
typealias PA = Array with Percent

function main() returns ExitCode
	var a = PA.create()
	a.push(500)
	return a.count()
end 'main'
---
CompilerError:
error E3005: <fragment>:7:4: Value 500 is outside the range of 'Percent' (int(0 to 100))
