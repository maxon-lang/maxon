// Test: guards-fire-at-their-own-site-in-source-order
typealias Small = int(0 to 10)
typealias Wide = int(0 to 100000)

function widen(n Wide) returns Wide
	return n + 1
end 'widen'

function main() returns ExitCode
	let a = widen(1)
	let b = widen(2)
	let c = widen(5000)
	print("start\n")
	let x = a as Small
	print("after-x\n")
	let y = b as Small
	print("after-y\n")
	let z = c as Small
	print("after-z\n")
	return x + y + z
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_cont:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "start\x0a"
    x64.callDirect print
  __rc_ok#1:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "after-x\x0a"
    x64.callDirect print
  __rc_ok#4:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "after-y\x0a"
    x64.callDirect print
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]  ; "panic at guards-fire-at-their-own-site-in-source-order.test:18: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
