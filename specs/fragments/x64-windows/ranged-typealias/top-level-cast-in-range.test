// Test: top-level-cast-in-range
typealias SmallByte = int(0 to 10)

let GOOD = 7 as SmallByte

function main() returns ExitCode
	return GOOD as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
