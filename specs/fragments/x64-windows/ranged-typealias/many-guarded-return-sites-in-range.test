    x64.cmpRegImm32 rcx, 100000
    x64.jcc greater, __rc_panic#12
  __rc_ok#11:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont#2
  a:
    x64.leaRegRegImm32 r8, rcx, 1
  __rc_ok#14:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, ifcont#4
  b:
    x64.leaRegRegImm32 r8, rcx, 2
  __rc_ok#17:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, ifcont#6
  c:
    x64.leaRegRegImm32 r8, rcx, 3
  __rc_ok#20:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.cmpRegImm32 rcx, 3
    x64.jcc notEqual, ifcont#8
  d:
    x64.leaRegRegImm32 r8, rcx, 4
  __rc_ok#23:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.cmpRegImm32 rcx, 4
    x64.jcc notEqual, ifcont#10
  e:
    x64.leaRegRegImm32 r8, rcx, 5
  __rc_ok#26:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.leaRegRegImm32 r8, rcx, 6
  __rc_chk#31:
    x64.cmpRegImm32 r8, 100
    x64.jcc greater, __rc_panic#30
  __rc_ok#29:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at many-guarded-return-sites-in-range.test:5: Range check failed: value outside typealias 'Wide'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
