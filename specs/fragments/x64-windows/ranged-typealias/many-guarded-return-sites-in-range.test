// Test: many-guarded-return-sites-in-range
typealias Small = int(0 to 100)
typealias Wide = int(0 to 100000)

function pick(n Wide) returns Small
	if n == 0 'a'
		return n + 1
	end 'a'

	if n == 1 'b'
		return n + 2
	end 'b'

	if n == 2 'c'
		return n + 3
	end 'c'

	if n == 3 'd'
		return n + 4
	end 'd'

	if n == 4 'e'
		return n + 5
	end 'e'

	return n + 6
end 'pick'

function main() returns ExitCode
	var acc = 0
	acc = acc + pick(0)
	acc = acc + pick(1)
	acc = acc + pick(2)
	acc = acc + pick(3)
	acc = acc + pick(4)
	acc = acc + pick(9)
	return acc as ExitCode
end 'main'
---
ExitCode: 40
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#12
