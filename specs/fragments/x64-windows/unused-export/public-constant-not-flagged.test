// Test: public-constant-not-flagged
// --- file: api/limits.maxon
typealias Integer = int(i64.min to i64.max)

public let MAX_UNUSED = 100

export function readMax() returns Integer
	return MAX_UNUSED
end 'readMax'

// --- file: app/main.maxon
function main() returns ExitCode
	return readMax()
end 'main'
---
ExitCode: 100
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 100
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
