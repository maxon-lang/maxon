// Test: error.unused-exported-union-nothing-outside-reaches
// --- file: api/answer.maxon
export typealias Integer = int(i64.min to i64.max)

export union Answer
	small
	big(n Integer)
end 'Answer'

function classify(n Integer) returns Answer
	if n > 10 'big'
		return Answer.big(n)
	end 'big'

	return Answer.small
end 'classify'

function score(a Answer) returns Integer
	return match a 'm'
		small gives 1
		big(n) gives n
	end 'm'
end 'score'

export function run(n Integer) returns Integer
	return score(classify(n))
end 'run'

// --- file: app/main.maxon
function main() returns ExitCode
	return run(42) as ExitCode
end 'main'
---
CompilerError:
error E3092: api/<fragment>:5:14: exported type 'Answer' is never referenced outside its declaring file
