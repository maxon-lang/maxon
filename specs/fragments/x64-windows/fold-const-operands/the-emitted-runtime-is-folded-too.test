    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
  trycont:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_10]  ; "panic at the-emitted-runtime-is-folded-too.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
