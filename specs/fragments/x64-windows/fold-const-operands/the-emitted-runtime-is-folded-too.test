// Test: the-emitted-runtime-is-folded-too
function main() returns ExitCode
	var a = [1, 2, 3]
	a.refill(6, value: 7)
	return (try a.get(5) otherwise 9) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
