// Test: an-array-of-string-arrays-needs-no-copy-to-compile
typealias StringArrayArray = Array with StringArray

function firstOf(candidates StringArrayArray) returns String
	for segments in candidates 'each'
		for s in segments 'inner'
			return s
		end 'inner'
	end 'each'
	return "none"
end 'firstOf'

function main() returns ExitCode
	var outer = StringArrayArray.create()
	var inner = StringArray.create()
	inner.push("a hit long enough to reach the heap")
	outer.push(inner)
	print("{firstOf(outer)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.storeSlotReg slot1, r12
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "a hit long enough to reach the heap"
    x64.callDirect __str_retain
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __managed_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_body#3:
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr#4
  each:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont#12:
    x64.movRegImm32 rdi, 0
  forhdr#8:
    x64.loadRegBaseDisp.word64 r8, [rsi + 8]
    x64.cmpRegReg rdi, r8
    x64.jcc greaterEqual, forstep
  inner:
    x64.loadRegBaseDisp.word64 rax, [rsi + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + rdi*8 + 0]
  __im_cont#13:
    x64.callDirect __str_retain
    x64.jmp __il_cont#2
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr#4:
    x64.cmpRegReg rax, rcx
    x64.jcc less, each
  forexit:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "none"
    x64.callDirect __str_retain
  __il_cont#2:
    x64.storeSlotReg slot2, r8
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.loadRegBaseDisp.word64 r12, [r8 + 8]
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
