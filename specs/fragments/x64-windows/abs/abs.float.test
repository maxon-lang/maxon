// Test: abs.float
function main() returns ExitCode
	let neg = -5.5
	let x = abs(neg)
	let y = trunc(x)
	return y
end 'main'
---
ExitCode: 5
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 5
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
