// Test: error.otherwise-throw

typealias Integer = int(i64.min to i64.max)

// Single-statement otherwise: rethrow a different error type
enum InnerError implements Error
	low
end 'InnerError'

enum OuterError implements Error
	high
end 'OuterError'

function inner() returns Integer throws InnerError
	throw InnerError.low
end 'inner'

function outer() returns Integer throws OuterError
	let v = try inner() otherwise throw OuterError.high
	return v
end 'outer'

function main() returns ExitCode
	let v = try outer() otherwise 77
	return v
end 'main'
---
ExitCode: 77
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @inner {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @outer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect inner
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect outer
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 77
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at error.otherwise-throw.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
