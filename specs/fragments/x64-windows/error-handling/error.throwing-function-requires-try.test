// Test: error.throwing-function-requires-try

typealias Integer = int(i64.min to i64.max)

// Calling a throwing function without try is an error
enum MyError implements Error
	failed
end 'MyError'

function mayFail() returns Integer throws MyError
	return try int.fromString("42") otherwise throw MyError.failed
end 'mayFail'

function main() returns ExitCode
	let val = mayFail()
	return val
end 'main'
---
CompilerError:
error E3057: <fragment>:15:12: throwing function requires try: 'mayFail'
