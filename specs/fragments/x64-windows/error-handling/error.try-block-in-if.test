// Test: error.try-block-in-if
typealias Code = int(i64.min to i64.max)

enum Fault implements Error
	broken
end 'Fault'

function risky(_ Code) returns Code throws Fault
	throw Fault.broken
end 'risky'

function main() returns ExitCode
	var acc = 0 as Code
	if acc < 5 'guard'
		try risky(3) otherwise (e) 'h'
			match e 'f'
				broken then acc = 7
			end 'f'
		end 'h'
		acc = acc + 1
	end 'guard'
	return acc
end 'main'
---
ExitCode: 8
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @risky {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  guard:
    x64.movRegImm32 rcx, 3
    x64.callDirect risky
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 rax, 7
    x64.jmp trycont
  matchdead:
  tryok:
    x64.movRegReg rax, rbx
  trycont:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
