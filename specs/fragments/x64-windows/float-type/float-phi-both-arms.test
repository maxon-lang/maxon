// Test: float-phi-both-arms
function work(a Integer) returns Integer
	var f = a + 0.0
	if a > 100 'big'
		f = f * 2.0
	end 'big' else 'small'
		f = f - 4.5
	end 'small'
	return trunc(f)
end 'work'

function main() returns ExitCode
	return work(19)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 14
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  ifcont:
    x64.movRegImm32 r8, 14
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegImm32 rax, 14
    x64.jcc less, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-phi-both-arms.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
