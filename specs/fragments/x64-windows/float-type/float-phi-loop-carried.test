// Test: float-phi-loop-carried
function main() returns ExitCode
	var f = 0.0
	var i = 0
	while i < 4 'loop'
		f = f + 2.5
		i = i + 1
	end 'loop'
	return trunc(f)
end 'main'
---
ExitCode: 10
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  loop:
    x64.movsdRegRip xmm1, [rip + __fconst_2.5]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegImm32 rax, 4
    x64.jcc less, loop
  whileexit:
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-phi-loop-carried.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
