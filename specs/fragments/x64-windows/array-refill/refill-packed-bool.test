// Test: refill-packed-bool
typealias BoolArray = Array with bool

function main() returns ExitCode
	var arr = BoolArray.create()
	arr.push(false)
	arr.push(true)
	arr.push(false)
	arr.refill(11, value: true)
	var lit = 0
	for b in arr 'count'
		if b 'set'
			lit = lit + 1
		end 'set'
	end 'count'
	return lit
end 'main'
---
