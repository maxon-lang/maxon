// Test: default-throws-statement
enum Color
	red
	green
	blue
end 'Color'

enum MatchError
	unmatched
end 'MatchError'

function checkColor(c Color) returns ExitCode throws MatchError
	match c 'check'
		green then return 1
		default throws MatchError.unmatched
	end 'check'
end 'checkColor'

function main() returns ExitCode
	let c = Color.green
	let result = try checkColor(c) otherwise 0
	return result
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @checkColor {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.movRegImm32 r8, 1
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect checkColor
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 0
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
