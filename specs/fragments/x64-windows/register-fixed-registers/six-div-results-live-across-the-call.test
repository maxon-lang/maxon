  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#4:
    x64.movRegImm32 rcx, 100
    x64.movRegImm32 rsi, 45
    x64.movRegImm32 rdi, 23
  divok#6:
    x64.movRegImm rax, 3074457345618258603
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rcx, rdx, rax
  tryok#7:
