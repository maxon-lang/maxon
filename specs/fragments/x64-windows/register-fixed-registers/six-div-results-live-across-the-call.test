    x64.imulHighReg r8
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 12
    x64.subRegReg r8, r8, rax
  divok#12:
    x64.movRegImm rax, 5270498306774157605
    x64.imulHighReg rsi
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rsi, rdx, rax
  tryok#13:
    x64.movRegImm32 r9, 45
    x64.movRegImm rax, 5270498306774157605
    x64.imulHighReg r9
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 7
    x64.subRegReg r9, r9, rax
  divok#18:
    x64.movRegImm rax, 2049638230412172402
    x64.imulHighReg rdi
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rdi, rdx, rax
  tryok#19:
    x64.movRegImm32 r10, 23
    x64.movRegImm rax, 2049638230412172402
    x64.imulHighReg r10
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 9
    x64.subRegReg r10, r10, rax
  __il_body#24:
    x64.imulRegRegImm32 rax, rcx, 100000
    x64.imulRegRegImm32 rcx, r8, 10000
    x64.leaRegRegReg rdx, rax, rcx
    x64.imulRegRegImm32 rsi, rsi, 1000
    x64.leaRegRegReg rdx, rdx, rsi
