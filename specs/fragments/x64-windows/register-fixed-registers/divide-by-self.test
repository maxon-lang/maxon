// Test: divide-by-self
function main() returns ExitCode
	let x = 37
	let q = x / x
	let m = x mod x
	let r = x * 100 + q * 10 + m
	if r == 3710 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 37
    x64.movRegImm rax, 3988485205126389539
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 3
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rsi, rdx, rax
    x64.movRegImm rax, 3988485205126389539
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 3
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 37
    x64.subRegReg rcx, rcx, rax
    x64.imulRegRegImm32 rax, rsi, 10
    x64.leaRegRegImm32 rax, rax, 3700
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 3710
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
