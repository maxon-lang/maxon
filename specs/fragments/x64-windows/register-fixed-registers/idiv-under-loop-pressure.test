// Test: idiv-under-loop-pressure

function press(p Integer) returns Integer
	let k1 = p + 11
	let k2 = p + 12
	let k3 = p + 13
	let k4 = p + 14
	let k5 = p + 15
	let k6 = p + 16
	let k7 = p + 17
	let k8 = p + 18
	let k9 = p + 19
	var sum = 0
	var i = 1
	while i <= 5 'loop'
		let t = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9
		sum = sum + (try (t / i) otherwise panic("i is never zero"))
		i = i + 1
	end 'loop'
	return sum
end 'press'

function main() returns ExitCode
	let r = press(0)
	if r == 307 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rsi, 1
    x64.jmp whilehdr
  loop:
    x64.movRegImm32 rax, 135
    x64.movRegImm rdx, 9223372036854775943
    x64.movRegReg rdi, rsi
    x64.xorRegImm32 rdi, rsi, -1
    x64.orRegReg rdx, rdx, rdi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, divovf
  divok:
    x64.cqo
    x64.idivReg rsi
  tryok:
    x64.leaRegRegReg rcx, rcx, rax
    x64.leaRegRegImm32 rsi, rsi, 1
  whilehdr:
    x64.cmpRegImm32 rsi, 5
    x64.jcc lessEqual, loop
  __il_cont:
    x64.cmpRegImm32 rcx, 307
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  divovf:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic: integer overflow\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
