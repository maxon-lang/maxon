// Test: live-across-idiv-and-call
function sink(x Integer) returns Integer
	return x + 1
end 'sink'

function f(p Integer) returns Integer
	let a = p + 100
	let q = a / 7
	let s = sink(3)
	return a + q + s
end 'f'

function main() returns ExitCode
	let v = f(0)
	if v == 118 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rcx, 100
    x64.movRegImm rax, 5270498306774157605
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
  __il_cont#5:
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegRegImm32 rax, rax, 4
  __il_cont#3:
    x64.cmpRegImm32 rax, 118
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
