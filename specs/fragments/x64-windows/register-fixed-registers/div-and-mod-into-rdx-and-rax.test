// Test: div-and-mod-into-rdx-and-rax
function take3(p1 Integer, p2 Integer, p3 Integer) returns Integer
	return p1 * 10000 + p2 * 100 + p3
end 'take3'

function main() returns ExitCode
	let n = 97
	let d = 5
	let r = take3(1, p2: n / d, p3: n mod d)
	if r == 11902 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 97
    x64.movRegImm rax, 7378697629483820647
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rsi, rdx, rax
    x64.movRegImm rax, 7378697629483820647
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 5
    x64.subRegReg rcx, rcx, rax
  __il_body:
    x64.imulRegRegImm32 rax, rsi, 100
    x64.leaRegRegImm32 rax, rax, 10000
    x64.leaRegRegReg rax, rax, rcx
  __il_cont:
    x64.cmpRegImm32 rax, 11902
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
