// Test: implied-try-bounds-of-a-parenthesized-range-target
// --- file: suite.maxtest
enum ApiError implements Error
	notFound
end 'ApiError'

function first(hit bool) returns RangeBound throws ApiError
	if not hit 'miss'
		throw ApiError.notFound
	end 'miss'

	return 2
end 'first'

function last(hit bool) returns RangeBound throws ApiError
	if not hit 'miss'
		throw ApiError.notFound
	end 'miss'

	return 5
end 'last'

test 'iterates a range built from throwing bounds'
	let it = try (first(true) upto last(true)).createIterator()
	Expect.equal(it.current() as AssertedInt, expected: 2)
end 'iterates a range built from throwing bounds'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_wireWrapper@0 = i64 0
  __data_wireSeparator@8 = i64 0
  __sched_tls_teb_offset@16 = i64 0
  __sched_allm@24 = i64 0
  __sched_lock@32 = i64 0
  __sched_preempt_ext_lock@40 = i64 0
  __sched_preempt_context@48 = i64 0
  __slab_arena_list@56 = i64 0
  __slab_arena_map_l1@64 = i64 0
  __slab_state@72 = i64 0
  __ds_base@80 = i64 0
  __dbg_ctl@88 = i64 0
  __mrt_console_probe_stdin@96 = i8 0
  __mrt_console_probe_stdout@97 = i8 0
  __mrt_console_probe_stderr@98 = i8 0
}

func @first {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  miss:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 2
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @last {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  miss:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @__test_iterates_a_range_built_from_throwing_bounds {
