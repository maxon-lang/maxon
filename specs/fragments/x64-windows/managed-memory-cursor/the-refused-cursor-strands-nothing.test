// Test: the-refused-cursor-strands-nothing
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var refusals = 0
	for _ in 0 upto 100 'many'
		var arr = ByteArray.create()
		let cursor = try arr.managed.createCursor() otherwise 'empty'
			refusals = refusals + 1
			continue
		end 'empty'
		refusals = refusals + cursor.current()
	end 'many'
	return refusals as ExitCode
end 'main'
---
ExitCode: 100
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp forhdr
  many:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_cursor_create
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rax, rbx
    x64.jmp forstep
  tryok:
    x64.movRegReg rcx, r14
    x64.callDirect __managed_cursor_current
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_cursor_decref
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rax, rbx
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg rbx, rax
  forhdr:
    x64.cmpRegImm32 r12, 100
    x64.jcc less, many
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at the-refused-cursor-strands-nothing.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
