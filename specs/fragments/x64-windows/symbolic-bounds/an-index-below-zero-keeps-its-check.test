// Test: an-index-below-zero-keeps-its-check
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function lastOr(a WordArray, fallback Word) returns Word
	let last = a.count() - 1
	return try a.get(last) otherwise fallback
end 'lastOr'

function main() returns ExitCode
	var empty = WordArray.create()
	if lastOr(empty, fallback: 7) != 7 'emptyFallsBack'
		return 1
	end 'emptyFallsBack'
	var a = WordArray.create()
	a.push(3)
	a.push(8)
	if lastOr(a, fallback: 7) != 8 'lastElement'
		return 2
	end 'lastElement'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @lastOr {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.leaRegRegImm32 rax, rax, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-index-below-zero-keeps-its-check.test:7: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.cmpRegReg rax, rsi
    x64.jcc below, __im_load
  __im_slow:
    x64.storeSlotReg slot0, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __managed_get
    x64.loadRegSlot rdx, slot0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegReg r8, rdx
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rcx + rax*8 + 0]
    x64.movRegReg r8, rax
  trycont:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect lastOr
    x64.cmpRegImm32 r8, 7
    x64.jcc equal, ifcont#2
  emptyFallsBack:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, r12
    x64.callDirect lastOr
    x64.cmpRegImm32 r8, 8
    x64.jcc equal, ifcont#4
  lastElement:
    x64.movRegImm32 r13, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
