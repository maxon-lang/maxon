// Test: an-index-one-past-the-length-fires
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function nextSum(a WordArray) returns Word
	var t = 0
	for i in 0 upto a.count() 'each'
		let j = i + 1
		t = t + (try a.get(j) otherwise 1000)
	end 'each'
	return t
end 'nextSum'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(10)
	a.push(20)
	a.push(30)
	a.push(40)
	if nextSum(a) != 1090 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @nextSum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 r14, [rbx + 0]
  forhdr:
    x64.cmpRegReg rax, r13
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRegImm32 r15, rax, 1
  __rc_ok:
    x64.cmpRegReg r15, r13
    x64.jcc below, __im_load
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rax, 1000
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 rax, [r14 + r15*8 + 0]
    x64.movRegReg r8, rax
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.leaRegRegReg r12, r12, rax
  forstep:
    x64.movRegReg rax, r15
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 40
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect nextSum
    x64.cmpRegImm32 r8, 1090
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
