// Test: an-index-one-past-the-length-fires
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function nextSum(a WordArray) returns Word
	var t = 0
	for i in 0 upto a.count() 'each'
		let j = i + 1
		t = t + (try a.get(j) otherwise 1000)
	end 'each'
	return t
end 'nextSum'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(10)
	a.push(20)
	a.push(30)
	a.push(40)
	if nextSum(a) != 1090 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 40
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  __il_body:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
    x64.jmp forhdr
  each:
    x64.leaRegRegImm32 rdi, rcx, 1
  __rc_ok:
    x64.cmpRegReg rdi, rdx
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rcx, 1000
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 rcx, [rsi + rdi*8 + 0]
    x64.movRegReg r8, rcx
  tryok:
    x64.movRegReg rcx, r8
  trycont:
    x64.leaRegRegReg rax, rax, rcx
  forstep:
    x64.movRegReg rcx, rdi
  forhdr:
    x64.cmpRegReg rcx, rdx
    x64.jcc less, each
  __il_cont:
    x64.cmpRegImm32 rax, 1090
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rdx
    x64.storeSlotReg slot2, rsi
    x64.storeSlotReg slot3, rdi
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, rdi
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rdx, slot1
    x64.loadRegSlot rsi, slot2
    x64.loadRegSlot rdi, slot3
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
}
