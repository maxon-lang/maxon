// Test: an-index-one-past-the-length-fires
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function nextSum(a WordArray) returns Word
	var t = 0
	for i in 0 upto a.count() 'each'
		let j = i + 1
		t = t + (try a.get(j) otherwise 1000)
	end 'each'
	return t
end 'nextSum'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(10)
	a.push(20)
	a.push(30)
	a.push(40)
	if nextSum(a) != 1090 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @nextSum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 80
    x64.movRegReg rax, rcx
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rax + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 rdi, [rax + 0]
  forhdr:
    x64.cmpRegReg rcx, rsi
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRegImm32 r9, rcx, 1
  __rc_ok:
    x64.cmpRegReg r9, rsi
    x64.jcc below, __im_load
  __im_slow:
    x64.movRegReg rcx, rax
    x64.movRegReg rdx, r9
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rsi
    x64.storeSlotReg slot2, rdi
    x64.storeSlotReg slot3, r8
    x64.storeSlotReg slot4, r9
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rsi, slot1
    x64.loadRegSlot rdi, slot2
    x64.loadRegSlot r8, slot3
    x64.loadRegSlot r9, slot4
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 rcx, 1000
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 rcx, [rdi + r9*8 + 0]
  trycont:
    x64.leaRegRegReg r8, r8, rcx
  forstep:
    x64.movRegReg rcx, r9
    x64.jmp forhdr
  forexit:
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 40
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect nextSum
    x64.cmpRegImm32 r8, 1090
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
