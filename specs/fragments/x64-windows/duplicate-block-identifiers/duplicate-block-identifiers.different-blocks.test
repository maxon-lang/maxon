// Test: duplicate-block-identifiers.different-blocks
function main() returns ExitCode
	var x = 0
	if true 'outer'
		x = 1
	end 'outer'
	
	if true 'inner'
		x = 2
	end 'inner'
	
	return x
end 'main'
---
ExitCode: 2
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  inner:
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
