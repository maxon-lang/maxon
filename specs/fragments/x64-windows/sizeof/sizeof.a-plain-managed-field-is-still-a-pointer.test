// Test: sizeof.a-plain-managed-field-is-still-a-pointer
type Plain
	var managed as __ManagedMemory
	var flag as bool
end 'Plain'

function main() returns ExitCode
	return sizeof(Plain) as ExitCode
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 16
    x64.popReg rbp
    x64.ret
}
