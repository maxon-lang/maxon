// Test: a-static-reads-the-count
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Vec5 = Vector with 5 Int

var trips = 0

extension Vector
	export static function counted() returns Self
		var i = 0
		while i < countof(Self) 'each'
			trips = trips + 1
			i = i + 1
		end 'each'
		return Self{}
	end 'counted'

	export function rebuild() returns Int
		let fresh = Self.counted()
		var slots = 0
		for _ in fresh 'countTheRecordsSlots'
			slots = slots + 1
		end 'countTheRecordsSlots'
		if slots == countof(Self) 'theStaticsResultStatesTheReceiversCount'
			return 0
		end 'theStaticsResultStatesTheReceiversCount'
		panic("a `Self`-returning static builds the instance its call site holds")
	end 'rebuild'
end 'Vector'

function main() returns ExitCode
	var a = Vec3.create()
	var b = Vec5.create()
	return a.rebuild() + b.rebuild() + trips
end 'main'
---
ExitCode: 8
---
data {
  __data_trips@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @Vector.rebuild {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
  __il_body#10:
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  each:
    x64.leaRegGlobal rcx, __data_trips
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_trips
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegReg rax, r12
    x64.jcc less, each
  whileexit:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rbx + 40]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r12
    x64.callDirect __managed_resize
  __il_cont#9:
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, r13
    x64.callDirect Vector.createIterator
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forhdr
    x64.jmp forempty
  __il_body#15:
    x64.loadRegBaseDisp.word64 rcx, [r15 + 0]
    x64.callDirect __managed_cursor_current
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __retain_type_param
  __il_cont#14:
    x64.leaRegRegImm32 r14, r14, 1
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __drop_type_param
  forstep:
    x64.movRegReg rcx, r15
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#15
  forexit:
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_ArrayIterator_T4b39db24a89d29c9
    x64.movRegReg rax, r14
    x64.jmp forjoin
  forempty:
    x64.movRegReg rax, r14
  forjoin:
    x64.cmpRegReg rax, r12
    x64.jcc notEqual, ifcont
  theStaticsResultStatesTheReceiversCount:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-static-reads-the-count.test:27: a `Self`-returning static builds the instance its call site holds\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

