// Test: from-literal-initializer
let path = FilePath from "test.txt"

function main() returns ExitCode
	print(path.toString())
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __data_path@0 = i64 0
  __data_CharacterSet.cachedWhitespacesAndNewlines@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_console_probe_stdin@40 = i8 0
  __mrt_console_probe_stdout@41 = i8 0
  __mrt_console_probe_stderr@42 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegGlobal rax, __data_path
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  __il_body#3:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __str_retain
    x64.movRegReg rbx, r8
  __il_body#4:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
