func @Churner.__loop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
  serve:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.storeSlotReg slot1, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, stopping
  dispatch:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.jumpTable rax, default=stopping [[0]=__shutdown, [1]=churn] @__jumptable_16
  __shutdown:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.storeBaseDispReg.word64 [r12 + 56], rax
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  stopping:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_close
  drain:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, abandon
  finished:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_service_exit
    x64.movRegReg rax, r8
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  abandon:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_abandon
    x64.jmp drain
  churn:
    x64.loadRegBaseDisp.word64 r13, [r8 + 8]
    x64.loadRegBaseDisp.word64 rax, [r8 + 16]
    x64.storeSlotReg slot0, rax
  __il_body:
    x64.movRegImm32 r14, 0
    x64.movRegImm32 rax, 0
    x64.jmp forhdr
  eachRound:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg r15, r8
    x64.leaRegGlobal rax, __data_roster
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __managed_retain
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.leaRegRegReg r14, r14, rax
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
  forstep:
    x64.loadRegSlot rax, slot2
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.storeSlotReg slot2, rax
    x64.cmpRegReg rax, r13
    x64.jcc less, eachRound
  __il_cont:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.movRegImm32 rax, 0
    x64.loadRegSlot rcx, slot0
    x64.movRegReg rdx, r14
    x64.callDirect __gt_cell_complete
    x64.jmp serve
}

