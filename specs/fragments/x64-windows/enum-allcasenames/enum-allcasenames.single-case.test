// Test: enum-allcasenames.single-case
enum Singleton
	only
end 'Singleton'

function main() returns ExitCode
	let count = Singleton.allCaseNames.count()
	if count == 1 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "only"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 1
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
