// Test: pdq-dispatch-small-no-pdq
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function captureTrace(key String)
	Log.trace(key)
end 'captureTrace'

function main() returns ExitCode
	var a = IntArray.create()
	a.push(8)
	a.push(3)
	a.push(1)
	a.push(7)
	a.push(2)
	a.push(6)
	a.push(4)
	a.push(5)
	Log.startCapture()
	a.sortUnstable(ascending, trace: captureTrace)
	let keys = Log.stopCapture()
	if not Log.fired(keys, key: "pdq.partition") 'p'
		print("no-partition ")
	end 'p'
	if Log.fired(keys, key: "smallSort.network") 'n'
		print("network")
	end 'n'
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __data_capturing@32 = i1 0
  __mrt_console_probe_stdin@33 = i8 0
  __mrt_console_probe_stdout@34 = i8 0
  __mrt_console_probe_stderr@35 = i8 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc lessEqual, ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @captureTrace {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.leaRegGlobal rax, __data_capturing
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont
  on:
    x64.leaRegGlobal rax, __data_captured
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_cont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

