// Test: driftsort-large-sqrt-cross-check
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	var r = 2463534242

	for i in 0 upto 5000 'fill'
		r = (r * 1103515245 + 12345) and 0x7FFFFFFF
		a.push(r and 0xFFFF)
	end 'fill'

	let n = a.count()
	var sum = 0
	var squares = 0

	for x in a 'tally'
		sum = sum + x
		squares = squares + x * x
	end 'tally'

	a.sort(ascending)

	var ordered = a.count() == n
	var sumAfter = 0
	var squaresAfter = 0

	for i in 0 upto a.count() 'walk'
		let v = try a.get(i) otherwise return 99
		sumAfter = sumAfter + v
		squaresAfter = squaresAfter + v * v

		if i > 0 'pair'
			let p = try a.get(i - 1) otherwise return 99

			if p > v 'oop'
				ordered = false
			end 'oop'
		end 'pair'
	end 'walk'

	if ordered and sumAfter == sum and squaresAfter == squares 'ok'
		print("sorted\n")
	end 'ok' else 'bad'
		print("BROKEN\n")
	end 'bad'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc lessEqual, ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 2463534242
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  fill:
    x64.imulRegRegImm32 rax, rax, 1103515245
    x64.leaRegRegImm32 r13, rax, 12345
    x64.andRegImm32 r13, r13, 2147483647
    x64.movRegReg rdx, r13
    x64.andRegImm32 rdx, r13, 65535
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg rax, r13
  forhdr#1:
    x64.cmpRegImm32 r12, 5000
    x64.jcc less, fill
  forexit#4:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr#5
  tally:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont:
    x64.leaRegRegReg r13, r13, rsi
    x64.imulRegReg rsi, rsi, rsi
    x64.leaRegRegReg r14, r14, rsi
  forstep#7:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr#5:
    x64.cmpRegReg rax, rcx
    x64.jcc less, tally
  forexit#8:
    x64.leaRegFunc r9, [rip + __fnref_ascending]
    x64.movRegImm32 rsi, 0
    x64.leaRegRdata rdi, [rip + __layout_Array_Integer]
  __il_body:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.driftsortRange
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg rax, r12
    x64.setccReg equal, rax
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rbx + 8]
  __us_test:
    x64.loadRegBaseDisp.word64 r8, [rbx + 0]
    x64.jmp forhdr#9
  __im_load#33:
    x64.loadRegBaseIndexScale.word64 r9, [r8 + rsi*8 + 0]
  tryok#13:
    x64.leaRegRegReg rcx, rcx, r9
    x64.movRegReg r10, r9
    x64.imulRegReg r10, r9, r9
    x64.leaRegRegReg rdx, rdx, r10
    x64.cmpRegImm32 rsi, 0
    x64.jcc lessEqual, forstep#11
  pair:
    x64.leaRegRegImm32 r10, rsi, -1
  __im_load#36:
    x64.loadRegBaseIndexScale.word64 r10, [r8 + r10*8 + 0]
  tryok#16:
    x64.cmpRegReg r10, r9
    x64.jcc lessEqual, forstep#11
  oop:
    x64.movRegImm32 rax, 0
  forstep#11:
    x64.leaRegRegImm32 rsi, rsi, 1
  forhdr#9:
    x64.cmpRegReg rsi, rdi
    x64.jcc less, __im_load#33
  forexit#12:
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit#40
  andrhs#21:
    x64.cmpRegReg rcx, r13
    x64.setccReg equal, rax
    x64.jmp scmerge#22
  critsplit#40:
    x64.movRegReg rax, rsi
  scmerge#22:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit#43
  andrhs#23:
    x64.cmpRegReg rdx, r14
    x64.setccReg equal, rax
    x64.jmp scmerge#24
  critsplit#43:
    x64.movRegReg rax, rcx
  scmerge#24:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifelse
  ok:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "sorted\x0a"
    x64.callDirect print
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "BROKEN\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
