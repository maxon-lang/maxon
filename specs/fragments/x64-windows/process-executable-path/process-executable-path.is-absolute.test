// Test: process-executable-path.is-absolute
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	var score = 0
	if exe.path.byteLength() > 3 'longerThanADrive'
		score = score + 1
	end 'longerThanADrive'
	if exe.path.contains(":") 'driveQualified'
		score = score + 2
	end 'driveQualified'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
  __ds_base@72 = i64 0
  __dbg_ctl@80 = i64 0
  __mrt_console_probe_stdin@88 = i8 0
  __mrt_console_probe_stdout@89 = i8 0
  __mrt_console_probe_stderr@90 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Process.executablePath
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
  __il_body#13:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#12:
    x64.cmpRegImm32 rax, 3
    x64.jcc belowEqual, ifcont
  longerThanADrive:
    x64.movRegImm32 r12, 1
  ifcont:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.leaRegRdata rax, [rip + __str_rec_16]  ; ":"
  __il_body#15:
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
  __il_cont#14:
    x64.callDirect needleOccursIn
  __il_cont#10:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, __rc_ok
  driveQualified:
    x64.leaRegRegImm32 r12, r12, 2
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
