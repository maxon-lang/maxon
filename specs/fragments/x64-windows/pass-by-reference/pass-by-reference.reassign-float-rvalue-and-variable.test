  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @reassignReturn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.storeBaseDispReg.word64 [rcx + 0], xmm0
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @reassignVoid {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_50]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.storeBaseDispReg.word64 [rcx + 0], xmm0
    x64.popReg rbp
    x64.ret
}

