// Test: pass-by-reference.an-interface-parameter-after-a-reassigned-one-keeps-its-witness
typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Square implements Shape
	var side as Integer

	static function create(side Integer) returns Self
		return Self{side: side}
	end 'create'

	function area() returns Integer
		return self.side * self.side
	end 'area'
end 'Square'

function squareShape(side Integer) returns Shape
	return Square.create(side)
end 'squareShape'

function adopt(s Shape, from Shape) returns Integer
	let wanted = from.area()

	if s.area() < wanted 'smaller'
		s = squareShape(2)
	end 'smaller'

	return wanted
end 'adopt'

function main() returns ExitCode
	var shape = squareShape(1)
	let wanted = adopt(shape, from: Square.create(3))
	print("{wanted} {shape.area()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
  __mrt_program_started@27 = i8 0
}

func @Square.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Square.area {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegReg r8, r8, rax
    x64.popReg rbp
    x64.ret
}

func @squareShape {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Square.create
    x64.leaRegRdata r10, [rip + __witness_Square.Shape]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @adopt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.callMem [rax + 48]
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.callMem [rax + 48]
    x64.cmpRegReg r8, r12
    x64.jcc greaterEqual, ifcont
  smaller:
    x64.movRegImm32 rcx, 2
    x64.callDirect squareShape
    x64.movRegReg r13, r8
    x64.movRegReg r14, r10
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.callDirect __drop_existential
    x64.storeBaseDispReg.word64 [rbx + 0], r13
    x64.storeBaseDispReg.word64 [rbx + 8], r14
  ifcont:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

