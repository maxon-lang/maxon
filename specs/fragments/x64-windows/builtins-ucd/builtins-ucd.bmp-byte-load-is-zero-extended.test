// Test: builtins-ucd.bmp-byte-load-is-zero-extended
function main() returns ExitCode
	var i = 0
	var negatives = 0
	while i < 65536 'scan'
		if __Builtins.ucdByteAt("__ucd_bmp", offset: i) < 0 'negative'
			negatives = negatives + 1
		end 'negative'
		i = i + 1
	end 'scan'
	if negatives == 0 'allUnsigned'
		return 5
	end 'allUnsigned'
	return 1
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
  whilehdr:
    x64.cmpRegImm32 rbx, 65536
    x64.jcc greaterEqual, whileexit
  scan:
    x64.movRegReg rcx, rbx
    x64.callDirect __ucd_bmp_at
    x64.cmpRegImm32 r8, 0
    x64.jcc greaterEqual, critsplit
  negative:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont#5
  critsplit:
    x64.movRegReg rax, r12
  ifcont#5:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, ifcont#7
  allUnsigned:
    x64.movRegImm32 r8, 5
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#7:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
