// Test: builtins-ucd.supp-i64-load
function main() returns ExitCode
	let entry = __Builtins.ucdI64At("__ucd_supp", index: 0)
	let next = __Builtins.ucdI64At("__ucd_supp", index: 1)
	var score = 0
	if (entry and 2097151) == 65536 'rangeStart'
		score = score + 1
	end 'rangeStart'
	if ((entry shr 21) and 2097151) == 65547 'rangeEnd'
		score = score + 1
	end 'rangeEnd'
	if ((entry shr 42) and 31) == 5 'category'
		score = score + 1
	end 'category'
	if (next and 2097151) == 65549 'nextRangeStart'
		score = score + 1
	end 'nextRangeStart'
	if ((next shr 21) and 2097151) == 65574 'nextRangeEnd'
		score = score + 1
	end 'nextRangeEnd'
	if (next and 2097151) > ((entry shr 21) and 2097151) 'sortedAndDisjoint'
		score = score + 1
	end 'sortedAndDisjoint'
	return score as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect __ucd_supp_at
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect __ucd_supp_at
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, rbx
    x64.andRegImm32 rcx, rbx, 2097151
    x64.cmpRegImm32 rcx, 65536
    x64.jcc notEqual, ifcont#2
  rangeStart:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.sarRegImm8 rcx, rbx, 21
    x64.andRegImm32 rcx, rcx, 2097151
    x64.cmpRegImm32 rcx, 65547
    x64.jcc notEqual, ifcont#4
  rangeEnd:
    x64.leaRegRegImm32 rax, rax, 1
  ifcont#4:
    x64.sarRegImm8 rbx, rbx, 42
    x64.andRegImm32 rbx, rbx, 31
    x64.cmpRegImm32 rbx, 5
    x64.jcc notEqual, ifcont#6
  category:
    x64.leaRegRegImm32 rax, rax, 1
  ifcont#6:
    x64.movRegReg rdx, r8
    x64.andRegImm32 rdx, r8, 2097151
    x64.cmpRegImm32 rdx, 65549
    x64.jcc notEqual, ifcont#8
  nextRangeStart:
    x64.leaRegRegImm32 rax, rax, 1
  ifcont#8:
    x64.sarRegImm8 r8, r8, 21
    x64.andRegImm32 r8, r8, 2097151
    x64.cmpRegImm32 r8, 65574
    x64.jcc notEqual, ifcont#10
  nextRangeEnd:
    x64.leaRegRegImm32 rax, rax, 1
  ifcont#10:
    x64.cmpRegReg rdx, rcx
    x64.jcc lessEqual, critsplit
  sortedAndDisjoint:
    x64.leaRegRegImm32 r8, rax, 1
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rax
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
