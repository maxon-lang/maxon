// Test: slice-cleanup-decrefs-parent
function main() returns ExitCode
	let s = "hello world that is long enough to require heap allocation and more text to be sure"
	let start = s.startIndex()
	let idx = try s.findFirst(" ") otherwise s.endIndex()
	let sub = s.slice(start, endIndex: idx)
	print("{sub}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "hello world that is long enough to require heap allocation and more text to be sure"
    x64.movRegReg rcx, rbx
    x64.callDirect String.startIndex
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.leaRegRdata rdx, [rip + __str_rec_4]  ; " "
    x64.movRegReg rcx, rbx
    x64.callDirect String.findFirst
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect String.endIndex
    x64.movRegReg rax, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.storeSlotReg slot1, rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect String.slice
    x64.storeSlotReg slot2, r8
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.loadRegBaseDisp.word64 r12, [r8 + 8]
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, r12, r14
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rbx, slot4
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot2
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
