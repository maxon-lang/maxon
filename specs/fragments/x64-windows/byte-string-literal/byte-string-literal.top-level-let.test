// Test: byte-string-literal.top-level-let
let Keyword = b"critsplit"

function takes(b ByteArray) returns ExitCode
		return 0 if b.count() == 9 else 1
end 'takes'

function main() returns ExitCode
		return takes(Keyword)
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRdata rax, [rip + __barr_rec_1]
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 9
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ternaryfalse:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}
