    x64.leaRegRdata rcx, [rip + __str_rec_35]  ; "file://[unclosed/path.txt"
    x64.callDirect FilePath.from
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.leaRegRdata rcx, [rip + __str_rec_36]  ; "caught "
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
    x64.leaRegRdata rdx, [rip + __str_rec_37]  ; "invalidCharacter"
    x64.imulRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rdx
    x64.leaRegRdata rsi, [rip + __str_rec_38]  ; "notFileURL"
    x64.imulRegReg rdx, rdx, rsi
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, rdx
    x64.leaRegRdata rsi, [rip + __str_rec_39]  ; "malformedURL"
    x64.imulRegReg rdx, rdx, rsi
    x64.leaRegRegReg rcx, rcx, rdx
