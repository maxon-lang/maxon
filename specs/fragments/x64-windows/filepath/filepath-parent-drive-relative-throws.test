// Test: filepath-parent-drive-relative-throws
function main() returns ExitCode
	let p = FilePath from "C:foo"
	try p.parent() otherwise 'noParent'
		print("caught noParent\n")
		return 0
	end 'noParent'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
  __ds_base@72 = i64 0
  __dbg_ctl@80 = i64 0
  __mrt_console_probe_stdin@88 = i8 0
  __mrt_console_probe_stdout@89 = i8 0
  __mrt_console_probe_stderr@90 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_18]  ; "C:foo"
  __il_body#4:
    x64.callDirect FilePath.create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
  __il_cont#3:
    x64.movRegReg rcx, rbx
    x64.callDirect FilePath.parent
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_rec_19]  ; "caught noParent\x0a"
  __il_body#8:
    x64.callDirect __write_stdout
  __il_cont#7:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_FilePath
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_31]  ; "panic at FilePath.maxon:35: FilePath: invalid path\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
