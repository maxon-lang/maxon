// Test: filepath-equality
function main() returns ExitCode
	let a = FilePath from "C:\\test.txt"
	let b = FilePath from "C:\\test.txt"
	if a == b 'eq'
		print("equal\n")
	end 'eq'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
  __ds_base@72 = i64 0
  __dbg_ctl@80 = i64 0
  __mrt_console_probe_stdin@88 = i8 0
  __mrt_console_probe_stdout@89 = i8 0
  __mrt_console_probe_stderr@90 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_18]  ; "C:\\test.txt"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_18]  ; "C:\\test.txt"
    x64.callDirect FilePath.init
    x64.movRegReg r12, r8
  __il_body#4:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect FilePath.canonicalForCompare
    x64.movRegReg r13, r8
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callDirect FilePath.canonicalForCompare
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __str_eq
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
  __il_cont:
    x64.cmpRegImm32 r15, 0
    x64.jcc equal, ifcont
  eq:
    x64.leaRegRdata rcx, [rip + __str_rec_19]  ; "equal\x0a"
  __il_body#6:
    x64.callDirect __write_stdout
  ifcont:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_FilePath
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
