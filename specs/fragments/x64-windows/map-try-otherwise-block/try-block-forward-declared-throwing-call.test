// Test: try-block-forward-declared-throwing-call
enum BumpError implements Error
		tooBig
end 'BumpError'

function run() returns ExitCode
		try 'work'
				step()
		end 'work' otherwise (e) 'bad'
				match e 'kind'
						tooBig then return 7
				end 'kind'
		end 'bad'
		return 3
end 'run'

function step() throws BumpError
		throw BumpError.tooBig
end 'step'

function main() returns ExitCode
		return run()
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @step {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.callDirect step
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok
  tryblkerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 r8, 7
    x64.jmp __il_cont
  matchdead:
  tryblkok:
    x64.movRegImm32 r8, 3
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
