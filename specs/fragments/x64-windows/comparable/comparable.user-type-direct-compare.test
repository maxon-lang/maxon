// Test: comparable.user-type-direct-compare
typealias Coord = int(0 to 1000)

type Point implements Comparable
	export var x as Coord
	static function create(x Coord) returns Self
		return Self{ x: x }
	end 'create'
	function compare(other Point) returns Ordering
		if self.x < other.x 'lt'
			return Ordering.lessThan
		end 'lt'
		if self.x > other.x 'gt'
			return Ordering.greaterThan
		end 'gt'
		return Ordering.equalTo
	end 'compare'
end 'Point'

function main() returns ExitCode
	let a = Point.create(3)
	let b = Point.create(9)
	let o = a.compare(b)
	let r = match o 'check'
		lessThan gives 1
		equalTo gives 2
		greaterThan gives 3
	end 'check'
	return r
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Point.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at comparable.user-type-direct-compare.test:6: Range check failed: value outside typealias 'Coord'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 3
    x64.callDirect Point.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 9
    x64.callDirect Point.create
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, ifcont#14
  lt:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#14:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.cmpRegReg rax, rcx
    x64.jcc lessEqual, ifcont#16
  gt:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#16:
    x64.movRegImm32 rax, 1
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r12, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matcharm#3
  matcharm#2:
    x64.movRegImm32 r12, 2
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r12, 3
  matchcont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
