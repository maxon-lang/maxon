// Test: error.enum-case-range-upto
typealias Code = int(0 to 125)

enum Color
	red
	green
	blue
end 'Color'

function pick(c Color) returns Code
	match c 'c'
		red upto blue then return 1
		blue then return 2
	end 'c'
end 'pick'

function main() returns ExitCode
	return pick(Color.red)
end 'main'
---
CompilerError:
error E3146: <fragment>:12:3: 'red upto blue' is not a match pattern: name each case in an 'or'-chain, one per line
