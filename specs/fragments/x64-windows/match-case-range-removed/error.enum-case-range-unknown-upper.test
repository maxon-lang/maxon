// Test: error.enum-case-range-unknown-upper
typealias Code = int(0 to 125)

enum Color
	red
	green
	blue
end 'Color'

function pick(c Color) returns Code
	match c 'c'
		red to nope then return 1
	end 'c'
end 'pick'

function main() returns ExitCode
	return pick(Color.red)
end 'main'
---
CompilerError:
error E3146: <fragment>:12:3: 'red to nope' is not a match pattern: name each case in an 'or'-chain, one per line
