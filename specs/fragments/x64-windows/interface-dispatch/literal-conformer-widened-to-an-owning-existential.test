// Test: literal-conformer-widened-to-an-owning-existential
typealias Tally = int(0 to 100)

var widenings = 0 as Tally

// The discard below is the whole shape, so `widen` must have an effect — discarding a PURE result is
// E3064 (`discarded-results.md`) and the program would never reach the retain this case is about.
function widen(h Hashable) returns Hashable
	widenings = widenings + 1
	return h
end 'widen'

function main() returns ExitCode
	print("A")
	_ = widen("abc")
	print("B")
	return widenings - 1
end 'main'
---
ExitCode: 0
---
data {
  __data_widenings@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_console_probe_stdin@40 = i8 0
  __mrt_console_probe_stdout@41 = i8 0
  __mrt_console_probe_stderr@42 = i8 0
}

func @widen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rax, rcx
    x64.movRegReg rbx, rdx
    x64.leaRegGlobal rcx, __data_widenings
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_widenings
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_existential
    x64.movRegReg r10, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "A"
    x64.callDirect print
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "abc"
    x64.leaRegRdata rdx, [rip + __witness_String.Hashable]
    x64.callDirect widen
    x64.movRegReg rcx, r10
    x64.movRegReg rdx, r8
    x64.callDirect __drop_existential
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "B"
    x64.callDirect print
    x64.leaRegGlobal rax, __data_widenings
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 r8, rax, -1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_16]  ; "panic at literal-conformer-widened-to-an-owning-existential.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
