  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @SumWorker.process {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.jmp whilehdr
  __im_load:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  trycont:
    x64.leaRegRegReg r8, r8, rsi
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegReg rax, rcx
    x64.jcc less, __im_load
  whileexit:
    x64.popReg rbp
    x64.ret
}

