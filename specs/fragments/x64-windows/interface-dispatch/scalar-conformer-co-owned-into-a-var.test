// Test: scalar-conformer-co-owned-into-a-var
typealias Integer = int(i64.min to i64.max)

function use(h Comparable, replace bool) returns Integer
	var v = h
	if replace 'maybe'
		v = h
	end 'maybe'
	return 11 if true else 12
end 'use'

function main() returns ExitCode
	return use(7, replace: false) as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rdx, 7
    x64.leaRegRdata rbx, [rip + __witness_int.Comparable]
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callDirect __retain_existential
  ternarytrue:
    x64.movRegImm32 r12, 11
  matchcont:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __drop_existential
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
