// Test: witness-impl-reaching-stdlib-when-dispatched
typealias Tag = int(0 to 100)

interface Printer
	function show()
end 'Printer'

type Thing implements Printer
	let label as Tag

	static function create(label Tag) returns Self
		return Self{label: label}
	end 'create'

	function show()
		print("shown: {label}\n")
	end 'show'
end 'Thing'

type Holder
	export let p as Printer
	export let n as ExitCode

	static function create(p Printer, n ExitCode) returns Self
		return Self{p: p, n: n}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(Thing.create(7), n: 3 as ExitCode)
	h.p.show()
	return h.n
end 'main'
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Thing.show {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "shown: "
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.movRegReg r13, rcx
    x64.andRegImm32 r13, rcx, 255
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __uint_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "\x0a"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot3, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot2, rax
    x64.leaRegRegReg rcx, r12, r13
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot0, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot1, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.loadRegSlot rax, slot2
    x64.loadRegSlot rdx, slot3
    x64.movRegReg rcx, rbx
    x64.callDirect __str_copy
    x64.loadRegSlot rax, slot2
    x64.leaRegRegReg rax, rbx, rax
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
  __il_body:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __write_stdout
  __il_cont:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __str_decref
    x64.movRegReg rax, r8
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
  __rc_ok#4:
    x64.movRegImm32 rbx, 7
  __il_cont#2:
    x64.movRegImm32 r12, 3
    x64.leaRegRdata r13, [rip + __witness_Thing.Printer]
  __rc_ok#8:
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r14 + 0], r8
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.storeBaseDispReg.word64 [r14 + 16], r12
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
  __il_cont#1:
    x64.loadRegBaseDisp.word64 rcx, [r14 + 0]
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.callMem [rax + 48]
    x64.loadRegBaseDisp.word64 rbx, [r14 + 16]
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
