// Test: a-durable-store-of-a-constant-copies-it
typealias Num = int(0 to 1000)
typealias NumArray = Array with Num
typealias Holder = Array with NumArray

let Anchor = NumArray.create()

function main() returns ExitCode
	var result = 0
	let bound = Anchor
	if bound is Anchor 'bindingBorrows'
		result = result + 1
	end 'bindingBorrows'

	var h = Holder.create()
	h.push(Anchor)
	let stored = try h.get(0) otherwise NumArray.create()
	if stored is not Anchor 'storeCopies'
		result = result + 2
	end 'storeCopies'

	return result
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.leaRegRdata rax, [rip + __barr_empty_2_trivial]
    x64.leaRegRdata rcx, [rip + __barr_empty_2_trivial]
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, ifcont#2
  bindingBorrows:
    x64.movRegImm32 rbx, 1
  ifcont#2:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.leaRegRdata rcx, [rip + __barr_empty_2_trivial]
    x64.callDirect __managed_retain
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r12 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#17
  __im_empty:
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, critsplit#18
  __im_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.movRegReg r13, r8
    x64.jmp __im_cont
  critsplit#18:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#17:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rcx, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_incref
    x64.movRegReg rcx, r13
  trycont:
    x64.leaRegRdata rax, [rip + __barr_empty_2_trivial]
    x64.cmpRegReg rcx, rax
    x64.jcc equal, ifcont#7
  storeCopies:
    x64.leaRegRegImm32 rbx, rbx, 2
  ifcont#7:
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-durable-store-of-a-constant-copies-it.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
