// Test: int-and-float-overflow-share-one-stack-area
typealias Integer = int(i64.min to i64.max)

function mix(i1 Integer, i2 Integer, i3 Integer, i4 Integer, i5 Integer, i6 Integer, i7 Integer, f1 Real, f2 Real, f3 Real, f4 Real, f5 Real, f6 Real, f7 Real) returns Integer
	if f1 + f2 + f3 + f4 + f5 + f6 + f7 == 127.0 'floatsOk'
		return i1 + i2 + i3 + i4 + i5 + i6 + i7
	end 'floatsOk'
	return 0
end 'mix'

function main() returns ExitCode
	return mix(1, i2: 2, i3: 4, i4: 8, i5: 16, i6: 32, i7: 64, f1: 1.0, f2: 2.0, f3: 4.0, f4: 8.0, f5: 16.0, f6: 32.0, f7: 64.0)
end 'main'
typealias Real = float(f64.min to f64.max)
---
ExitCode: 127
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  floatsOk:
    x64.movRegImm32 r8, 127
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
