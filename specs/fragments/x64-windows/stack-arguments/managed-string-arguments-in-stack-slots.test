// Test: managed-string-arguments-in-stack-slots
typealias ByteTotal = int(0 to 100000)

function joinLengths(a String, b String, c String, d String, e String, f String, g String, h String) returns ByteTotal
	return a.byteLength() + b.byteLength() + c.byteLength() + d.byteLength() + e.byteLength() + f.byteLength() + g.byteLength() + h.byteLength()
end 'joinLengths'

function main() returns ExitCode
	return joinLengths("a string long enough to be heap allocated, one", b: "bb", c: "ccc", d: "dddd", e: "eeeee", f: "ffffff", g: "another heap allocated string, seven", h: "hhhhhhhhhhhhhhhhhhhhhhhhh")
end 'main'
---
ExitCode: 127
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __str_rec_8]  ; "a string long enough to be heap allocated, one"
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "bb"
    x64.leaRegRdata rdx, [rip + __str_rec_10]  ; "ccc"
    x64.leaRegRdata rsi, [rip + __str_rec_11]  ; "dddd"
    x64.leaRegRdata rdi, [rip + __str_rec_12]  ; "eeeee"
    x64.leaRegRdata r8, [rip + __str_rec_13]  ; "ffffff"
    x64.leaRegRdata r9, [rip + __str_rec_14]  ; "another heap allocated string, seven"
    x64.leaRegRdata r10, [rip + __str_rec_15]  ; "hhhhhhhhhhhhhhhhhhhhhhhhh"
  __il_body#14:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_body#15:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
  __il_cont#12:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#16:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
  __il_cont#11:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#17:
    x64.loadRegBaseDisp.word64 rcx, [rsi + 8]
  __il_cont#10:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#18:
    x64.loadRegBaseDisp.word64 rcx, [rdi + 8]
  __il_cont#9:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#19:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
  __il_cont#8:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#20:
    x64.loadRegBaseDisp.word64 rcx, [r9 + 8]
  __il_cont#7:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#21:
    x64.loadRegBaseDisp.word64 rcx, [r10 + 8]
  __il_cont#6:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 100000
    x64.jcc greater, __rc_panic
  __il_cont#1:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_17]  ; "panic at managed-string-arguments-in-stack-slots.test:5: Range check failed: value outside typealias 'ByteTotal'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
