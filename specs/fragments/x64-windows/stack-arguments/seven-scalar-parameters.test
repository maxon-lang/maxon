// Test: seven-scalar-parameters
typealias Integer = int(i64.min to i64.max)

function sum7(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer, g Integer) returns Integer
	return a + b + c + d + e + f + g
end 'sum7'

function main() returns ExitCode
	return sum7(1, b: 2, c: 4, d: 8, e: 16, f: 32, g: 64)
end 'main'
---
ExitCode: 127
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 127
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
