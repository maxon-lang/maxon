    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  base:
    x64.cvttsd2siRegReg r8, xmm0
