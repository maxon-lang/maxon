func @threadA {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 4
    x64.callDirect sleep
    x64.movRegImm32 rcx, 4
    x64.callDirect sleep
    x64.movRegImm32 r8, 79
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @threadB {
