// Test: sqrt.rt-zero
function main() returns ExitCode
	let args = CommandLine.args()
	let x = try float.fromString(try args.get(1) otherwise "") otherwise 0.0
	let result = sqrt(x)
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
