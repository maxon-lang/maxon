// Test: floor.negative
function main() returns ExitCode
	let neg = -3.2
	let y = trunc(floor(neg))
	return y + 10
end 'main'
---
ExitCode: 6
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 6
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
