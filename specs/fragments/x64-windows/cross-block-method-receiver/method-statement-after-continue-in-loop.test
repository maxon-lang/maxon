    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  ifcont:
    x64.movRegImm32 rbx, 4
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 4
    x64.jcc greaterEqual, __il_cont#12
  grow#14:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont#12
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:418: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont#12:
    x64.movRegReg rbx, r13
    x64.movRegReg rax, r12
  whilehdr:
    x64.cmpRegImm32 rax, 5
    x64.jcc less, loop
  whileexit:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont#3:
