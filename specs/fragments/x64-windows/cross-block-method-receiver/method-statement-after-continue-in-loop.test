    x64.jmp whilehdr
  loop:
    x64.leaRegRegImm32 r12, rax, 1
    x64.cmpRegImm32 r12, 2
    x64.jcc notEqual, grow#10
  skip:
    x64.movRegReg rax, r12
    x64.jmp whilehdr
  grow#10:
