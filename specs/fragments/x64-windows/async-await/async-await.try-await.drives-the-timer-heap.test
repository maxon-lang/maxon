  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_20]  ; "noyield.txt"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect File.exists
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegImm32 rcx, 10
    x64.callDirect sleep
    x64.movRegImm32 r8, 1
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

