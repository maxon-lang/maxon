function swap(a T, b T) uses T
	a = b
end 'swap'

export function fromB() returns String
	var s = "b1"
	swap(s, b: "b2")
	return s
end 'fromB'

// --- file: main.maxon
typealias Integer = int(0 to 100)

function swap(a Integer) returns Integer
	return a + 1
end 'swap'

function main() returns ExitCode
	var x = 5 as Integer
	print("{swap(x)} {fromB()}\n")
	return 0
end 'main'
