    x64.movRegReg rcx, r14
    x64.callDirect __retain_type_param
    x64.movRegReg r15, r8
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.movRegReg rcx, r14
    x64.callDirect __drop_type_param
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, ifcont
  direct:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_type_param
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_type_param
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
