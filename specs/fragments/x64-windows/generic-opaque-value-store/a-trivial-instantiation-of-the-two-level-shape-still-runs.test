  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_first
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_body#4
  tryerr:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body#4:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_body#6:
    x64.loadRegBaseDisp.word64 rdx, [rax + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __retain_type_param
  __il_cont:
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

