// Test: two-files-private-generic-functions-of-one-name-each-keep-their-own-by-reference-parameter
// --- file: a.maxon
function settle(dest T, src T) uses T
	dest = src
end 'settle'

export function fromA() returns String
	var s = "a before"
	var w = "a after"
	settle(s, src: w)
	return s
end 'fromA'

// --- file: main.maxon
function settle(dest T, src T) uses T
	src = dest
end 'settle'

function main() returns ExitCode
	var s = "b dest"
	var w = "b src"
	settle(s, src: w)
	print("{w} / {fromA()}\n")
	return 0
end 'main'
