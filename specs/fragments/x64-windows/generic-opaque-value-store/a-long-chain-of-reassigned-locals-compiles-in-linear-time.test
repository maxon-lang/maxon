    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_type_param
    x64.storeBaseDispReg.word64 [r13 + 0], r8
  __il_cont#2:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
