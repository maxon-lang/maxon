// Test: remove-reinsert
function main() returns ExitCode
	var m = [1: 10, 2: 20, 3: 30]
	_ = m.remove(2)
	try m.insert(2, value: 99) otherwise ignore
	let result = try m.get(2) otherwise 0
	return result
end 'main'
