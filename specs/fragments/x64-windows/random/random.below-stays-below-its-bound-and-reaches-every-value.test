// Test: random.below-stays-below-its-bound-and-reaches-every-value
typealias FaceCounts = Array with bool

function main() returns ExitCode
	var seen = FaceCounts.create()
	seen.resize(6)

	for _ in 0 upto 1000 'eachDraw'
		let face = try Random.below(6) otherwise return 1

		if face >= 6 'outOfRange'
			return 2
		end 'outOfRange'

		try seen.set(face as ElementIndex, value: true) otherwise return 3
	end 'eachDraw'

	for wasSeen in seen 'eachFace'
		if not wasSeen 'missing'
			return 4
		end 'missing'
	end 'eachFace'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
  __mrt_program_started@27 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm rcx, 18446744073709551615
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 6
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  eachDraw:
    x64.movRegImm32 rcx, 6
    x64.callDirect Random.below
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr#6:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 6
    x64.jcc less, ifcont
  outOfRange:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rax, 1
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forstep#3
  tryerr#10:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 1000
    x64.jcc less, eachDraw
  forexit#4:
    x64.movRegImm32 r12, 0
  __us_test:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.jmp forhdr#11
  eachFace:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get_unchecked
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, forstep#13
  missing:
    x64.movRegImm32 r12, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  forstep#13:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#11:
    x64.cmpRegReg r12, r13
    x64.jcc less, eachFace
  forexit#14:
    x64.movRegImm32 r12, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
