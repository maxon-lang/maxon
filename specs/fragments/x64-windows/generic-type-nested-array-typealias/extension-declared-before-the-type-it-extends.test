// Test: extension-declared-before-the-type-it-extends
typealias Num = int(i64.min to i64.max)

extension Pair where A is Comparable
	function firstIsVia(x A) returns bool
		return self.firstIs(x)
	end 'firstIsVia'
end 'Pair'

type Pair uses A, B where A is Equatable, B is Equatable
	export var first as A
	export var second as B
	static function create(a A, b B) returns Self
		return Self{first: a, second: b}
	end 'create'
	function firstIs(x A) returns bool
		return self.first == x
	end 'firstIs'
end 'Pair'

typealias NumPair = Pair with (Num, Num)

function main() returns ExitCode
	let p = NumPair.create(1, b: 2)
	if p.firstIs(1) 'a'
		print("a=true\n")
	end 'a'
	if p.firstIsVia(1) 'c'
		print("via=true\n")
	end 'c'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Pair.firstIs {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rax + 48]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 2
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_body#6:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_cont#5:
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect Pair.firstIs
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  a:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "a=true\x0a"
    x64.callDirect print
  ifcont#2:
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.leaRegRdata rcx, [rip + __witness_int.Comparable]
  __il_body#8:
    x64.movRegReg rcx, r13
    x64.callDirect Pair.firstIs
  __il_cont#7:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  c:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "via=true\x0a"
    x64.callDirect print
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "done\x0a"
    x64.callDirect print
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
