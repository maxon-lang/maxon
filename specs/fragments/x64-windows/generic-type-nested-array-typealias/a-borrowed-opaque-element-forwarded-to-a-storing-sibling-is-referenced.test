// Test: a-borrowed-opaque-element-forwarded-to-a-storing-sibling-is-referenced
typealias ExitCode = int(0 to 125)
typealias Idx = int(0 to u64.max)

type GHolder uses T
	typealias TArray = Array with T

	export var items as TArray
	export var spare as TArray

	static function create() returns Self
		return Self{ items: TArray.create(), spare: TArray.create() }
	end 'create'

	function seed(s T)
		items.push(s)
	end 'seed'

	function stash(v T)
		spare.push(v)
	end 'stash'

	function relay(i Idx)
		stash(try items.get(i) otherwise panic("out of range"))
	end 'relay'

	function spareCount() returns Idx
		return spare.count()
	end 'spareCount'
end 'GHolder'

typealias StringHolder = GHolder with String

function main() returns ExitCode
	var h = StringHolder.create()
	h.seed("a value long enough to force a heap allocation")
	var n = 0 as Idx
	while n < 100 'relayMany'
		h.relay(0)
		n = n + 1
	end 'relayMany'
	print("spare {h.spareCount()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

