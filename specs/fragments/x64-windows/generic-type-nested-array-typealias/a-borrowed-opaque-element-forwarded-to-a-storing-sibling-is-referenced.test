  whileexit:
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "spare "
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
  __il_cont#9:
