// Test: feed-into-a-borrowing-user-push-releases-what-it-took
typealias ExitCode = int(0 to 125)

type Sink uses S
	export var n as ExitCode

	export static function create() returns Self
		return Self{ n: 0 }
	end 'create'

	// `Container.add` DISCARDS this result — the shape under test — so the method must have an effect, or
	// the discard is E3064 (`discarded-results.md`).
	export function push(x S) returns S
		self.n = self.n + 1
		return x
	end 'push'
end 'Sink'

type Container uses Element
	typealias ElementSink = Sink with Element

	export var sink as ElementSink

	export static function create() returns Self
		return Self{ sink: ElementSink.create() }
	end 'create'

	export function add(item Element)
		_ = self.sink.push(item)
	end 'add'
end 'Container'

typealias StringContainer = Container with String

function main() returns ExitCode
	var sc = StringContainer.create()
	var i = 0 as ExitCode
	while i < 100 'addMany'
		sc.add("a string number {i} long enough to force a heap allocation")
		i = i + 1
	end 'addMany'
	print("added\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Sink.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Sink.push {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.cmpRegImm32 rsi, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rsi, 125
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at feed-into-a-borrowing-user-push-releases-what-it-took.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.storeBaseDispReg.word64 [rcx + 0], rsi
    x64.movRegReg rcx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Container.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect Sink.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Container.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect Sink.push
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __drop_type_param
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_type_param
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.callDirect Container.create
    x64.storeSlotReg slot1, r8
    x64.movRegImm32 rbx, 0
  whilehdr:
    x64.storeSlotReg slot0, rbx
    x64.cmpRegImm32 rbx, 100
    x64.jcc greaterEqual, whileexit
  addMany:
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "a string number "
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __uint_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; " long enough to force a heap allocation"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot5, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot4, rax
    x64.leaRegRegReg rcx, r13, rbx
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r12, rbx
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot5
    x64.loadRegSlot r12, slot4
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot3
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __layout_Container_String]
    x64.loadRegSlot rcx, slot1
    x64.movRegReg rdx, rbx
    x64.callDirect Container.add
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg rbx, rax
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "added\x0a"
    x64.callDirect print
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot1
    x64.callDirect __destruct_Container_String
    x64.movRegReg r8, rbx
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
