    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Container_String]
    x64.loadRegSlot rcx, slot1
    x64.movRegReg rdx, rbx
    x64.callDirect Container.stashIf
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "heap-built element number "
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 r13, rax, 1
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; " long enough to escape any small-string envelope"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot9, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot7, rax
