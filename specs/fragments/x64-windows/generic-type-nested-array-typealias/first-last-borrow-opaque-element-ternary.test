// Test: first-last-borrow-opaque-element-ternary
typealias ExitCode = int(0 to 125)

type Container uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray

	export static function create() returns Self
		return Self{ items: ElementArray.create() }
	end 'create'

	export function push(item Element)
		self.items.push(item)
	end 'push'

	export function peekEnds() returns Element throws ArrayError
		let front = try self.items.first()
		let back = try self.items.last()
		return front if self.items.count() == 2 else back
	end 'peekEnds'
end 'Container'

typealias StringContainer = Container with String

function main() returns ExitCode
	var pair = StringContainer.create()
	pair.push("front element, long enough to force a heap allocation")
	pair.push("back element, also long enough to force a heap allocation")
	let fromBorrowedArm = try pair.peekEnds() otherwise return 1

	var trio = StringContainer.create()
	trio.push("front element, long enough to force a heap allocation")
	trio.push("middle element, long enough to force a heap allocation")
	trio.push("back element, also long enough to force a heap allocation")
	let fromOwnedArm = try trio.peekEnds() otherwise return 2

	if not fromBorrowedArm.equals("front element, long enough to force a heap allocation") 'wrongFront'
		return 3
	end 'wrongFront'

	if not fromOwnedArm.equals("back element, also long enough to force a heap allocation") 'wrongBack'
		return 4
	end 'wrongBack'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Container.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Container.push {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Container.peekEnds {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_first
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r12
    x64.callDirect Array.last
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.movRegReg rbx, r14
  matchcont:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __drop_type_param
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

