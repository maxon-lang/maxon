// Test: unconditional-extension-body-that-dispatches-no-witness
typealias Num = int(i64.min to i64.max)

type Pair uses A, B where A is Equatable, B is Equatable
	export var first as A
	export var second as B
	static function create(a A, b B) returns Self
		return Self{first: a, second: b}
	end 'create'
	function firstIs(x A) returns bool
		return self.first == x
	end 'firstIs'
end 'Pair'

extension Pair
	function firstCopy() returns A
		return self.first
	end 'firstCopy'
end 'Pair'

typealias NumPair = Pair with (Num, Num)

function main() returns ExitCode
	let p = NumPair.create(1, b: 2)
	if p.firstIs(1) 'a'
		print("a=true\n")
	end 'a'
	if p.firstCopy() == 1 'c'
		print("copy=true\n")
	end 'c'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_cont#6:
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata rcx, [rip + __witness_int.Equatable]
  __il_body#8:
    x64.movRegReg rcx, rbx
    x64.callMem [rax + 48]
  __il_cont#5:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  a:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "a=true\x0a"
    x64.callDirect print
  ifcont#2:
    x64.leaRegRdata rcx, [rip + __layout_Pair_Num_Num]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_body#10:
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_type_param
  __il_cont#9:
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, ifcont#4
  c:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "copy=true\x0a"
    x64.callDirect print
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "done\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
