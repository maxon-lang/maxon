// Test: closure-capture.a-closure-stored-into-a-record-it-does-not-capture
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

type Counter
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: function() gives 0}
	end 'create'

	function lend(other Counter)
		other.read = function() gives self.n
	end 'lend'
end 'Counter'

function main() returns ExitCode
	let source = Counter.create(7)
	var target = Counter.create(1)
	source.lend(target)
	return target.read() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
  __mrt_program_started@27 = i8 0
}

func @Counter.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.leaRegRdata r12, [rip + __fnrec_Counter.create$closure_0]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Counter.create$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Counter.lend$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}

func @Counter.lend$closure_0$drop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.callDirect __destruct_Counter
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 7
    x64.callDirect Counter.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect Counter.create
    x64.movRegReg r12, r8
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own
    x64.movRegReg r13, r8
    x64.leaRegFunc rdx, [rip + Counter.lend$closure_0$drop]
    x64.movRegImm32 rcx, 16
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegFunc rax, [rip + Counter.lend$closure_0]
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.loadRegBaseDisp.word64 rcx, [r12 + 8]
    x64.callDirect __mm_decref
    x64.storeBaseDispReg.word64 [r12 + 8], r14
  __il_cont:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_retain
    x64.movRegReg r14, r8
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.movRegReg rcx, r13
    x64.callReg rax
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Counter
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Counter
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at closure-capture.a-closure-stored-into-a-record-it-does-not-capture.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
