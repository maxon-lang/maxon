    x64.leaRegFunc r12, [rip + Box.greet$closure_0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegImm32 rcx, 10
    x64.movRegReg rdx, r13
    x64.callReg r12
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Box.greet$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.leaRegRegReg r8, rcx, rax
