// Test: closure-capture.a-call-through-a-function-value-lands-only-on-bodies-of-its-arity
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

function idle() returns Integer
	return 0
end 'idle'

type Counter
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: idle}
	end 'create'
end 'Counter'

function wire(target Counter, source Counter)
	target.read = function() gives source.n
end 'wire'

function readTwice(c Counter) returns Integer
	let reader = function(t Counter) gives t.n + c.n
	return reader(c)
end 'readTwice'

function main() returns ExitCode
	let wiring = wire
	var a = Counter.create(1)
	let b = Counter.create(2)
	wiring(a, b)
	print("{a.read()} {readTwice(b)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
  __mrt_program_started@27 = i8 0
}

func @idle {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Counter.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.leaRegRdata r12, [rip + __fnrec_idle]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @wire {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.callDirect __mm_own
    x64.movRegReg r12, r8
    x64.leaRegFunc rdx, [rip + wire$closure_0$drop]
    x64.movRegImm32 rcx, 16
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegFunc rax, [rip + wire$closure_0]
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.callDirect __mm_decref
    x64.movRegReg rax, r8
    x64.storeBaseDispReg.word64 [rbx + 8], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @wire$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}

func @wire$closure_0$drop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.callDirect __destruct_Counter
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @readTwice$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @readTwice$closure_0$drop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.callDirect __destruct_Counter
    x64.movRegReg rax, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

