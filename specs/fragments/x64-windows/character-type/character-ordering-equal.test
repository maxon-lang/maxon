// Test: character-ordering-equal
function main() returns ExitCode
	let a = 'é'
	let b = 'é'
	if a <= b 'le'
		print("le\n")
	end 'le'
	if a >= b 'ge'
		print("ge\n")
	end 'ge'
	if a < b 'lt'
		print("LT\n")
	end 'lt'
	if a > b 'gt'
		print("GT\n")
	end 'gt'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_5]  ; "\xc3\xa9"
    x64.leaRegRdata r12, [rip + __str_rec_5]  ; "\xc3\xa9"
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, ifcont#2
  le:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "le\x0a"
    x64.callDirect print
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  ge:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "ge\x0a"
    x64.callDirect print
  ifcont#4:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ifcont#6
  lt:
    x64.leaRegRdata rcx, [rip + __str_rec_8]  ; "LT\x0a"
    x64.callDirect print
  ifcont#6:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, ifcont#8
  gt:
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "GT\x0a"
    x64.callDirect print
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
