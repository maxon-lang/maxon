// Test: inline-ternary-before-later-sibling

typealias Integer = int(i64.min to i64.max)

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function pick() returns Integer
		let r = 1 if n > 0 else 2
		return r + later()
	end 'pick'

	function later() returns Integer
		return 9
	end 'later'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.pick()
end 'main'
---
ExitCode: 11
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  ternaryfalse:
    x64.movRegImm32 rax, 2
  __il_cont:
    x64.leaRegRegImm32 rbx, rax, 9
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
