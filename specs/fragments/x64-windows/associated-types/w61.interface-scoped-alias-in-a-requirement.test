// Test: w61.interface-scoped-alias-in-a-requirement
typealias Num = int(0 to 1000)

interface Holder uses Element
	export typealias ElementArray = Array with Element
	function absorb(value ElementArray)
end 'Holder'

interface Maker
	static function spawn() returns Self
end 'Maker'

type Bag uses Element implements Holder with Element, Maker
	typealias ElementArray = Array with Element
	var items as ElementArray = ElementArray.create()

	static function spawn() returns Self
		return Self{}
	end 'spawn'

	function absorb(value ElementArray)
		items = value.clone()
	end 'absorb'

	function count() returns Num
		return items.count()
	end 'count'
end 'Bag'

function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
