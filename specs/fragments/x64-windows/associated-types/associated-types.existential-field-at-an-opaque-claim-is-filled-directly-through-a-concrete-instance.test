// Test: associated-types.existential-field-at-an-opaque-claim-is-filled-directly-through-a-concrete-instance
typealias Integer = int(i64.min to i64.max)

interface Taker uses Element
	function take(e Element) returns Integer
end 'Taker'

type Runner implements Taker with Integer
	let base as Integer

	function take(e Integer) returns Integer
		return base + e
	end 'take'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Runner'

type Box uses T
	typealias TakerOfT = Taker with T

	export var t as TakerOfT

	static function create(t TakerOfT) returns Self
		return Self{t: t}
	end 'create'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	var box = IntBox.create(Runner.create(1))
	box.t = Runner.create(21)
	return box.t.take(10) as ExitCode
end 'main'
---
ExitCode: 31
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Runner.take {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg r8, rax, rdx
    x64.popReg rbp
    x64.ret
}

func @Runner.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect Runner.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata r12, [rip + __witness_Runner.Taker]
  __il_body:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
  __il_cont:
    x64.movRegImm32 rcx, 21
    x64.callDirect Runner.create
    x64.movRegReg rbx, r8
