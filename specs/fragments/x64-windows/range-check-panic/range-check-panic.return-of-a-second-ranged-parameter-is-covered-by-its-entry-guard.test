// Test: range-check-panic.return-of-a-second-ranged-parameter-is-covered-by-its-entry-guard
typealias SmallInt = int(0 to 10)

function pick(_ SmallInt, b SmallInt) returns SmallInt
  return b
end 'pick'

function main() returns ExitCode
  return pick(1, b: 7)
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
