// Test: range-check-panic.entry-guard-covers-a-return-inside-a-branch
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 10)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function pick(x SmallInt, flag Integer) returns SmallInt
  if flag > 0 'yes'
    return x
  end 'yes'
  return 3
end 'pick'

function main() returns ExitCode
  return pick(opaque(99) as SmallInt, flag: 1) as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at range-check-panic.entry-guard-covers-a-return-inside-a-branch.test:17: Range check failed: value outside typealias 'SmallInt'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
