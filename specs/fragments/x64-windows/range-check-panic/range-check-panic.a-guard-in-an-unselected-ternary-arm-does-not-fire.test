// Test: range-check-panic.a-guard-in-an-unselected-ternary-arm-does-not-fire
typealias Wide = int(0 to u64.max)
typealias Small = int(0 to 100)

function widen(n Wide) returns Wide
  return n * 100
end 'widen'

function pick(i Wide, flag bool) returns Small
  return (i as Small) if flag else 7
end 'pick'

function main() returns ExitCode
  return pick(widen(5), flag: false)
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ternaryfalse:
    x64.movRegImm32 r8, 7
  __il_cont:
    x64.popReg rbp
    x64.ret
}
