// Test: range-check-panic.lower-bound
typealias Integer = int(i64.min to i64.max)
typealias Natural = int(0 to i64.max)

function check(n Natural) returns Natural
  return n
end 'check'

function neg(n Integer) returns Integer
  return -n
end 'neg'

function main() returns ExitCode
  let below = neg(1)
  return check(below as Natural) as ExitCode
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at range-check-panic.lower-bound.test:15: Range check failed: value outside typealias 'Natural'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
