// Test: string-field-reassign-drops-old
type Holder
	export var text as String

	static function create() returns Self
		return Self{text: "old"}
	end 'create'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	h.text = "brandnew"
	if h.text == "brandnew" 'updated'
		return 8
	end 'updated'
	return 0
end 'main'
---
ExitCode: 8
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body:
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "old"
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
  __il_cont:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "brandnew"
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.storeBaseDispReg.word64 [r12 + 0], r13
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "brandnew"
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  updated:
    x64.movRegImm32 rbx, 8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
