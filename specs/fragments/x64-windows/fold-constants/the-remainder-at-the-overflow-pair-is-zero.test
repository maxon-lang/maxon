// Test: the-remainder-at-the-overflow-pair-is-zero
typealias Word = int(i64.min to i64.max)

function pick(a Word) returns Word
	return a
end 'pick'

function main() returns ExitCode
	if (try (pick(i64.min) mod pick(-1)) otherwise -79) != 0 'remainderAtTheOverflowPair'
		return 1
	end 'remainderAtTheOverflowPair'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 9223372036854775808
  __il_cont:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 1
    x64.leaRegRegImm32 rdx, rdx, -1
    x64.andRegReg rax, rax, rdx
    x64.orRegImm32 rcx, rcx, -1
    x64.cqo
    x64.idivReg rcx
  tryok:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont
  remainderAtTheOverflowPair:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
