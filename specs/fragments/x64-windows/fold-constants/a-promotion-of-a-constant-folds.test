// Test: a-promotion-of-a-constant-folds
typealias Real = float(f64.min to f64.max)
typealias Word = int(i64.min to i64.max)

function mix(i Word, f Real) returns Real
	return i + f
end 'mix'

function main() returns ExitCode
	if mix(3, f: 0.5) != 3.5 'anOrdinaryPromotion'
		return 1
	end 'anOrdinaryPromotion'
	if "{mix(9007199254740993, f: 0.0)}" != "9007199254740992.0" 'roundsToNearestEven'
		return 2
	end 'roundsToNearestEven'
	if mix(-2, f: -0.5) != -2.5 'andTheNegativeSide'
		return 3
	end 'andTheNegativeSide'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
  __il_body#8:
    x64.movsdRegRip xmm0, [rip + __fconst_3.5]
  __il_cont#7:
    x64.movsdRegRip xmm1, [rip + __fconst_3.5]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, anOrdinaryPromotion
  fordered#13:
    x64.jcc equal, __il_body#10
  anOrdinaryPromotion:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body#10:
    x64.movsdRegRip xmm0, [rip + __fconst_9007199254740992]
  __il_cont#9:
    x64.callDirect __float_toString
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.leaRegRdata rdx, [rip + __str_rec_94]  ; "9007199254740992.0"
    x64.movRegReg rcx, r14
    x64.callDirect __str_eq
    x64.movRegReg r12, r8
    x64.xorRegImm32 r12, r8, 1
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, __il_body#12
  roundsToNearestEven:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body#12:
    x64.movsdRegRip xmm0, [rip + __fconst_-2.5]
  __il_cont#11:
    x64.movsdRegRip xmm1, [rip + __fconst_-2.5]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, andTheNegativeSide
  fordered#14:
    x64.jcc equal, ifcont
  andTheNegativeSide:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
