// Test: a-constant-condition-costs-nothing
typealias Word = int(i64.min to i64.max)

function pick(a Word) returns Word
	return a
end 'pick'

function main() returns ExitCode
	var taken = 0
	if pick(5) > 3 'thenArm'
		taken = 7
	end 'thenArm' else 'elseArm'
		taken = 11
	end 'elseArm'
	if taken != 7 'thenArmRan'
		return 1
	end 'thenArmRan'

	var other = 0
	if pick(5) < 3 'falseThenArm'
		other = 7
	end 'falseThenArm' else 'falseElseArm'
		other = 11
	end 'falseElseArm'
	if other != 11 'elseArmRan'
		return 2
	end 'elseArmRan'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  thenArm:
    x64.movRegImm32 rax, 7
  ifcont#3:
    x64.cmpRegImm32 rax, 7
    x64.jcc equal, ifelse
  thenArmRan:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegImm32 rax, 11
  ifcont#8:
    x64.cmpRegImm32 rax, 11
    x64.jcc equal, ifcont#10
  elseArmRan:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
