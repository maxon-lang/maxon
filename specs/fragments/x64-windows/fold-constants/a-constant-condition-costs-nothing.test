// Test: a-constant-condition-costs-nothing
typealias Word = int(i64.min to i64.max)

function pick(a Word) returns Word
	return a
end 'pick'

function main() returns ExitCode
	var taken = 0
	if pick(5) > 3 'thenArm'
		taken = 7
	end 'thenArm' else 'elseArm'
		taken = 11
	end 'elseArm'
	if taken != 7 'thenArmRan'
		return 1
	end 'thenArmRan'

	var other = 0
	if pick(5) < 3 'falseThenArm'
		other = 7
	end 'falseThenArm' else 'falseElseArm'
		other = 11
	end 'falseElseArm'
	if other != 11 'elseArmRan'
		return 2
	end 'elseArmRan'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
