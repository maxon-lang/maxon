// Test: a-shift-folds-inside-the-window-and-is-left-alone-outside-it
typealias Word = int(i64.min to i64.max)

function shiftLeft(v Word, n Word) returns Word
	return v shl n
end 'shiftLeft'

function shiftRight(v Word, n Word) returns Word
	return v shr n
end 'shiftRight'

function main() returns ExitCode
	if shiftLeft(1, n: 62) != 4611686018427387904 'inWindow'
		return 1
	end 'inWindow'
	if shiftLeft(1, n: 63) != i64.min 'atTheTopOfTheWindow'
		return 2
	end 'atTheTopOfTheWindow'
	if shiftLeft(1, n: 64) != 0 'firstCountPastTheWindow'
		return 3
	end 'firstCountPastTheWindow'
	if shiftLeft(1, n: 100) != 0 'wellPastTheWindow'
		return 4
	end 'wellPastTheWindow'
	if shiftRight(-8, n: 1) != -4 'signFillingInWindow'
		return 5
	end 'signFillingInWindow'
	if shiftRight(-8, n: 70) != -1 'signFillingPastTheWindow'
		return 6
	end 'signFillingPastTheWindow'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  shiftok#15:
    x64.movRegImm rax, 4611686018427387904
  shiftok#19:
    x64.movRegImm rax, 9223372036854775808
  ifcont#4:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 64
  shiftok#23:
    x64.shlRegCl rax, rax
    x64.andRegImm32 rax, rax, 0
  ifcont#6:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 100
  shiftok#27:
    x64.shlRegCl rax, rax
    x64.andRegImm32 rax, rax, 0
  ifcont#10:
    x64.movRegImm rax, 18446744073709551608
  shiftok#35:
    x64.movRegImm rcx, 18446744073709551615
    x64.sarRegCl rax, rax
  __il_cont:
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, ifcont#12
  signFillingPastTheWindow:
    x64.movRegImm32 r8, 6
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
