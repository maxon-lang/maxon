// Test: match-character-range
function main() returns ExitCode
	let c = 'ñ'
	match c 'check'
		'é' to 'ü' then print("inrange\n")
		default then print("out\n")
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_5]  ; "\xc3\xb1"
    x64.leaRegRdata rdx, [rip + __str_rec_6]  ; "\xc3\xa9"
    x64.leaRegRdata r12, [rip + __str_rec_7]  ; "\xc3\xbc"
    x64.movRegReg rcx, rbx
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.setccReg notEqual, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 2
    x64.setccReg notEqual, rax
    x64.andRegReg r13, r13, rax
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, matchnext
  matcharm:
    x64.leaRegRdata rcx, [rip + __str_rec_8]  ; "inrange\x0a"
    x64.callDirect print
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "out\x0a"
    x64.callDirect print
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
