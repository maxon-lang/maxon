// Test: match-statements.try-otherwise-default
enum Err implements Error
	bad
end 'Err'

typealias Tally = int(0 to 100)
typealias Score = int(0 to 100)

function leaf() returns Score throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) returns Score
	match kind 'k'
		1 then return try leaf() otherwise 42
		default panic("unreachable")
	end 'k'
end 'dispatch'

function main() returns ExitCode
	return dispatch(1)
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @leaf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.callDirect leaf
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont
  tryerr:
    x64.movRegImm32 r8, 42
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
