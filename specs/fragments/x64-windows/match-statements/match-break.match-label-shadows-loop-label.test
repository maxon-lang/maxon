// Test: match-break.match-label-shadows-loop-label
function main() returns ExitCode
	var n = 0
	var trips = 0
	while n < 3 'dup'
		n = n + 1
		match n 'dup'
			1 then break 'dup'
			default then trips = trips + 1
		end 'dup'
		trips = trips + 10
	end 'dup'
	return trips
end 'main'
---
ExitCode: 32
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  dup:
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matchcont
  matchdefault:
    x64.leaRegRegImm32 rcx, r8, 1
    x64.movRegReg r8, rcx
  matchcont:
    x64.leaRegRegImm32 r8, r8, 10
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, dup
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at match-break.match-label-shadows-loop-label.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
