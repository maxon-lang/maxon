// Test: match-string.or-patterns
function main() returns ExitCode
	let name = "carol"
	match name 'greet'
		"alice" or
			"bob" then return 1
		"carol" or
			"dave" then return 2
		default then return 0
	end 'greet'
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_4]  ; "carol"
    x64.leaRegRdata rdx, [rip + __str_rec_5]  ; "alice"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_6]  ; "bob"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.orRegReg r12, r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, matchnext#2
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#2:
    x64.leaRegRdata rdx, [rip + __str_rec_4]  ; "carol"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_7]  ; "dave"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.orRegReg r12, r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, matchnext#4
  matcharm#3:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
