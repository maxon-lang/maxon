// Test: match-character-range-over-an-owned-scrutinee
function main() returns ExitCode
	let s = "éxü"
	var hits = 0
	for c in s 'each'
		match c 'classify'
			'é' to 'ü' then hits = hits + 1
			default then hits = hits + 100
		end 'classify'
	end 'each'
	print("{hits}\n")
	return 0
end 'main'
