// Test: match-character-literal
function main() returns ExitCode
	let c = 'ñ'
	match c 'check'
		'ñ' then print("eq\n")
		default then print("ne\n")
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "\xc3\xb1"
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "\xc3\xb1"
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext
  matcharm:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "eq\x0a"
    x64.callDirect print
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "ne\x0a"
    x64.callDirect print
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
