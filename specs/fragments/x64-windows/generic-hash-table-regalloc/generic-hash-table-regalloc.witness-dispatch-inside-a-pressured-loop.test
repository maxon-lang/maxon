// Test: generic-hash-table-regalloc.witness-dispatch-inside-a-pressured-loop
typealias Integer = int(i64.min to i64.max)
typealias IntKey = int(0 to u32.max)

function bump(x Integer) returns Integer
	return x + 1
end 'bump'

type Mixer uses T where T is Hashable and Equatable
	var base as Integer

	export static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'

	export function mix(key T) returns Integer
		var a1 = base + 1
		var a2 = base + 2
		var a3 = base + 3
		var a4 = base + 4
		var a5 = base + 5
		var a6 = base + 6
		var a7 = base + 7
		var a8 = base + 8
		var a9 = base + 9
		var a10 = base + 10
		var a11 = base + 11
		var a12 = base + 12
		var i = 0
		while i < 3 'loop'
			let d = bump(i)
			let h = key.hash()
			var step = d
			if key.equals(key) 'sameKey'
				step = d + (h as Integer)
			end 'sameKey'
			a1 = a1 + step
			a2 = a2 + step
			a3 = a3 + step
			a4 = a4 + step
			a5 = a5 + step
			a6 = a6 + step
			a7 = a7 + step
			a8 = a8 + step
			a9 = a9 + step
			a10 = a10 + step
			a11 = a11 + step
			a12 = a12 + step
			i = i + 1
		end 'loop'
		return a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12
	end 'mix'
end 'Mixer'

typealias IntMixer = Mixer with IntKey

function main() returns ExitCode
	var m = IntMixer.create(0)
	if m.mix(5 as IntKey) != 330 'wrongSum'
		return 90
	end 'wrongSum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 136
    x64.movRegImm32 rbx, 0
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_body#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot0, r8
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#3:
    x64.leaRegRdata rbx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.storeSlotReg slot1, rax
  __il_body#6:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 r12, rax, 1
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 r13, rax, 2
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 3
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.leaRegRegImm32 rcx, rcx, 4
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.leaRegRegImm32 rdx, rdx, 5
    x64.loadRegBaseDisp.word64 rsi, [r8 + 0]
    x64.leaRegRegImm32 rsi, rsi, 6
    x64.loadRegBaseDisp.word64 rdi, [r8 + 0]
    x64.leaRegRegImm32 rdi, rdi, 7
    x64.loadRegBaseDisp.word64 r9, [r8 + 0]
    x64.leaRegRegImm32 r9, r9, 8
    x64.loadRegBaseDisp.word64 r10, [r8 + 0]
    x64.leaRegRegImm32 r10, r10, 9
    x64.loadRegBaseDisp.word64 r11, [r8 + 0]
    x64.leaRegRegImm32 r11, r11, 10
    x64.loadRegBaseDisp.word64 r14, [r8 + 0]
    x64.leaRegRegImm32 r14, r14, 11
    x64.loadRegBaseDisp.word64 r8, [r8 + 0]
    x64.leaRegRegImm32 r8, r8, 12
    x64.movRegImm32 r15, 0
    x64.xchgRegReg r8, r14
    x64.jmp whilehdr
  __il_body#13:
    x64.leaRegRegImm32 r14, r15, 1
  __il_cont#12:
    x64.movRegImm32 rcx, 5
    x64.callMem [rbx + 24]
    x64.movRegReg r15, r8
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 5
    x64.loadRegSlot rax, slot1
    x64.callMem [rax + 24]
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  sameKey:
    x64.leaRegRegReg rax, r14, r15
    x64.jmp ifcont#11
  critsplit:
    x64.movRegReg rax, r14
  ifcont#11:
    x64.leaRegRegReg r12, r12, rax
    x64.leaRegRegReg r13, r13, rax
    x64.loadRegSlot rcx, slot12
    x64.leaRegRegReg rcx, rcx, rax
    x64.loadRegSlot rdx, slot11
    x64.leaRegRegReg rdx, rdx, rax
    x64.loadRegSlot rsi, slot10
    x64.leaRegRegReg rsi, rsi, rax
    x64.loadRegSlot rdi, slot9
    x64.leaRegRegReg rdi, rdi, rax
    x64.loadRegSlot r8, slot8
    x64.leaRegRegReg r8, r8, rax
    x64.loadRegSlot r9, slot7
    x64.leaRegRegReg r9, r9, rax
    x64.loadRegSlot r10, slot6
    x64.leaRegRegReg r10, r10, rax
    x64.loadRegSlot r11, slot5
    x64.leaRegRegReg r11, r11, rax
    x64.loadRegSlot r14, slot4
    x64.leaRegRegReg r14, r14, rax
    x64.loadRegSlot r15, slot3
    x64.leaRegRegReg rax, r15, rax
    x64.loadRegSlot r15, slot2
    x64.leaRegRegImm32 r15, r15, 1
    x64.xchgRegReg rax, rcx
    x64.xchgRegReg rcx, rdx
    x64.xchgRegReg rdx, rsi
    x64.xchgRegReg rsi, rdi
    x64.xchgRegReg rdi, r8
    x64.xchgRegReg r8, r14
  whilehdr:
    x64.storeSlotReg slot12, rax
    x64.storeSlotReg slot11, rcx
    x64.storeSlotReg slot10, rdx
    x64.storeSlotReg slot9, rsi
    x64.storeSlotReg slot8, rdi
    x64.storeSlotReg slot7, r9
    x64.storeSlotReg slot6, r10
    x64.storeSlotReg slot5, r11
    x64.storeSlotReg slot4, r8
    x64.storeSlotReg slot3, r14
    x64.storeSlotReg slot2, r15
    x64.cmpRegImm32 r15, 3
    x64.jcc less, __il_body#13
  whileexit:
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot rcx, slot12
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot11
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot10
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot9
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot7
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot6
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot5
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot4
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot3
    x64.leaRegRegReg rax, rax, rcx
  __il_cont#5:
    x64.cmpRegImm32 rax, 330
    x64.jcc equal, ifcont#2
  wrongSum:
    x64.movRegImm32 rbx, 90
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 136
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 136
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
