// Test: a-user-phi-of-constants-agreeing-on-one-target
typealias Word = int(i64.min to i64.max)

function classify(p bool, q bool, n Word) returns Word
	var flag = 0
	if p 'first'
		flag = 0
	end 'first' else if q 'second'
		flag = n - 5
	end 'second' else 'third'
		flag = 0
	end 'third'
	if flag != 0 'nonzero'
		return 1
	end 'nonzero'
	return 2
end 'classify'

function main() returns ExitCode
	if classify(true, q: true, n: 9) != 2 'a'
		return 1
	end 'a'
	if classify(false, q: true, n: 9) != 1 'b'
		return 2
	end 'b'
	if classify(false, q: true, n: 5) != 2 'c'
		return 3
	end 'c'
	if classify(false, q: false, n: 9) != 2 'd'
		return 4
	end 'd'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont#18:
    x64.movRegImm32 rax, 2
  second#23:
    x64.movRegImm32 rax, 4
  nonzero:
    x64.movRegImm32 rax, 1
  second#33:
    x64.movRegImm32 rax, 0
  ifcont#38:
    x64.movRegImm32 rax, 2
  ifelse:
    x64.movRegImm32 rax, 0
  ifcont#48:
    x64.movRegImm32 rax, 2
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
