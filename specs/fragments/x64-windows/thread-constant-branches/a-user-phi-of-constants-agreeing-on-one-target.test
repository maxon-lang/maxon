// Test: a-user-phi-of-constants-agreeing-on-one-target
typealias Word = int(i64.min to i64.max)

function classify(p bool, q bool, n Word) returns Word
	var flag = 0
	if p 'first'
		flag = 0
	end 'first' else if q 'second'
		flag = n - 5
	end 'second' else 'third'
		flag = 0
	end 'third'
	if flag != 0 'nonzero'
		return 1
	end 'nonzero'
	return 2
end 'classify'

function main() returns ExitCode
	if classify(true, q: true, n: 9) != 2 'a'
		return 1
	end 'a'
	if classify(false, q: true, n: 9) != 1 'b'
		return 2
	end 'b'
	if classify(false, q: true, n: 5) != 2 'c'
		return 3
	end 'c'
	if classify(false, q: false, n: 9) != 2 'd'
		return 4
	end 'd'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
