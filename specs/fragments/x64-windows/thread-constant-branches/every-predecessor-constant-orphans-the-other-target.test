// Test: every-predecessor-constant-orphans-the-other-target
typealias Word = int(i64.min to i64.max)

function f(p bool, n Word) returns Word
	var flag = 0
	if p 'a'
		flag = 0
	end 'a' else 'b'
		flag = 0
	end 'b'
	if flag != 0 'nz'
		return n + 1
	end 'nz'
	return 2
end 'f'

function main() returns ExitCode
	var t = 0
	for i in 0 upto 4 'each'
		t = t + f(i mod 2 == 0, n: i)
	end 'each'
	if t != 8 'total'
		return 1
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp forhdr
  each:
    x64.movRegReg rdx, rcx
    x64.sarRegImm8 rdx, rcx, 63
    x64.shrRegImm8 rdx, rdx, 63
    x64.leaRegRegReg rdx, rcx, rdx
    x64.sarRegImm8 rdx, rdx, 1
    x64.imulRegRegImm32 rdx, rdx, 2
    x64.movRegReg rsi, rcx
    x64.subRegReg rsi, rcx, rdx
    x64.cmpRegImm32 rsi, 0
    x64.setccReg equal, rdx
  __il_body:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ifcont#13
  ifcont#13:
    x64.movRegImm32 rdx, 2
  __il_cont:
    x64.leaRegRegReg rax, rax, rdx
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
  forhdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, each
  forexit:
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, ifcont#6
  total:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
