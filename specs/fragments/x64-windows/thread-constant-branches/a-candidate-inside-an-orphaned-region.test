// Test: a-candidate-inside-an-orphaned-region
typealias Word = int(i64.min to i64.max)

function f(p bool, q bool, n Word) returns Word
	var flag = 0
	if p 'a'
		flag = 0
	end 'a' else 'b'
		flag = 0
	end 'b'
	if flag != 0 'nz'
		var g = 0
		if q 'c'
			g = 0
		end 'c' else 'd'
			g = n
		end 'd'
		if g != 0 'gz'
			return 1
		end 'gz'
		return 3
	end 'nz'
	return 2
end 'f'

function main() returns ExitCode
	var t = 0
	for i in 0 upto 4 'each'
		t = t + f(i mod 2 == 0, q: i > 1, n: i)
	end 'each'
	if t != 8 'total'
		return 1
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp forhdr
  each:
    x64.movRegReg rdx, rcx
    x64.sarRegImm8 rdx, rcx, 63
    x64.shrRegImm8 rdx, rdx, 63
    x64.leaRegRegReg rdx, rcx, rdx
    x64.sarRegImm8 rdx, rdx, 1
    x64.imulRegRegImm32 rdx, rdx, 2
    x64.movRegReg rsi, rcx
    x64.subRegReg rsi, rcx, rdx
    x64.cmpRegImm32 rsi, 0
    x64.setccReg equal, rdx
    x64.cmpRegImm32 rcx, 1
  __il_body:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __il_cont
  __il_cont:
    x64.leaRegRegImm32 rax, rax, 2
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
  forhdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, each
  forexit:
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, ifcont
  total:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
