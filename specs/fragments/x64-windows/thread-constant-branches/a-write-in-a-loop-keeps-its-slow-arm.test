// Test: a-write-in-a-loop-keeps-its-slow-arm
typealias Word = int(i64.min to i64.max)
typealias Idx = int(0 to u64.max)
typealias WordArray = Array with Word

function put(a WordArray, i Idx, v Word) returns bool
	try a.set(i, value: v) otherwise return false
	return true
end 'put'

function main() returns ExitCode
	var a = WordArray.create()
	a.resize(4)
	var stored = 0
	for i in 0 upto 5 'each'
		if put(a, i: i, v: i * 10) 'ok'
			stored = stored + 1
		end 'ok'
	end 'each'
	if stored != 4 'count'
		return 1
	end 'count'
	var seen = 0
	for v in a 'check'
		seen = seen + v
	end 'check'
	if seen != 60 'sum'
		return 2
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rdx, 0
  __us_test#41:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, forhdr#1
  __us_test#42:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, forhdr#1
  __us_test#43:
    x64.leaRegRegImm32 rdi, rsi, -24
    x64.loadRegBaseDisp.word64 rdi, [rdi + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, forhdr#1
    x64.jmp forhdr#26
  each#2:
    x64.imulRegRegImm32 rsi, rdx, 10
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __im_slow#21
  __im_bounds#22:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg rdx, rcx
    x64.jcc aboveEqual, __im_slow#21
  __im_buffer:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow#21
  __im_viewed:
    x64.leaRegRegImm32 rdi, rcx, -24
    x64.loadRegBaseDisp.word64 rdi, [rdi + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __im_slow#21
    x64.jmp __im_store#25
  tryerr#18:
    x64.movRegImm32 rcx, 0
    x64.jmp __il_cont#16
  __im_store#25:
    x64.storeBaseIndexScaleReg.word64 [rcx + rdx*8 + 0], rsi
  tryok#17:
    x64.movRegImm32 rcx, 1
  __il_cont#16:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, forstep#3
  ok#5:
    x64.leaRegRegImm32 rax, rax, 1
  forstep#3:
    x64.leaRegRegImm32 rdx, rdx, 1
  forhdr#1:
    x64.cmpRegImm32 rdx, 5
    x64.jcc less, each#2
    x64.jmp forexit#4
  each#38:
    x64.imulRegRegImm32 rdi, rdx, 10
  __im_bounds#35:
    x64.cmpRegReg rdx, rcx
    x64.jcc aboveEqual, __im_slow#33
    x64.jmp __im_store#40
  tryerr#32:
    x64.movRegImm32 rdi, 0
    x64.jmp __il_cont#30
  __im_store#40:
    x64.storeBaseIndexScaleReg.word64 [rsi + rdx*8 + 0], rdi
  tryok#31:
    x64.movRegImm32 rdi, 1
  __il_cont#30:
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, forstep#27
  ok#29:
    x64.leaRegRegImm32 rax, rax, 1
  forstep#27:
    x64.leaRegRegImm32 rdx, rdx, 1
  forhdr#26:
    x64.cmpRegImm32 rdx, 5
    x64.jcc less, each#38
  forexit#4:
    x64.cmpRegImm32 rax, 4
    x64.jcc equal, ifcont#8
  count:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
    x64.jmp forhdr#9
  check:
    x64.loadRegBaseIndexScale.word64 rdi, [rsi + rcx*8 + 0]
  __im_cont:
    x64.leaRegRegReg rax, rax, rdi
  forstep#11:
    x64.leaRegRegImm32 rcx, rcx, 1
  forhdr#9:
    x64.cmpRegReg rcx, rdx
    x64.jcc less, check
  forexit#12:
    x64.cmpRegImm32 rax, 60
    x64.jcc equal, ifcont#14
  sum:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#14:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow#21:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rdx
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, rsi
    x64.callDirect __managed_set
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rdx, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#18
    x64.jmp tryok#17
  __im_slow#33:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot2, rcx
    x64.storeSlotReg slot1, rdx
    x64.storeSlotReg slot3, rsi
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, rdi
    x64.callDirect __managed_set
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot2
    x64.loadRegSlot rdx, slot1
    x64.loadRegSlot rsi, slot3
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#32
    x64.jmp tryok#31
}
