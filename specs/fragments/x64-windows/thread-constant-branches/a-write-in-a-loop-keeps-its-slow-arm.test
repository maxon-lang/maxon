  forhdr#1:
    x64.cmpRegImm32 rdx, 5
    x64.jcc less, each#2
    x64.jmp forexit#4
  each#41:
    x64.imulRegRegImm32 rdi, rdx, 10
  __im_bounds#37:
    x64.cmpRegReg rdx, rcx
    x64.jcc aboveEqual, __im_slow#35
    x64.jmp __im_store#43
  tryerr#34:
    x64.movRegImm32 rdi, 0
    x64.jmp __il_cont#32
  __im_store#43:
    x64.storeBaseIndexScaleReg.word64 [rsi + rdx*8 + 0], rdi
  tryok#33:
