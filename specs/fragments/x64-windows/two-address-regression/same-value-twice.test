// Test: same-value-twice
function sameTwice(p Integer) returns Integer
	let x = p + 9
	let y = p + 7
	let sq = x * x
	let df = x - x
	let t = y * y
	return sq * 100 + df * 10 + x + t
end 'sameTwice'

function main() returns ExitCode
	let r = sameTwice(0)
	if r == 8158 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 8158
  __il_cont:
    x64.cmpRegImm32 rax, 8158
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
