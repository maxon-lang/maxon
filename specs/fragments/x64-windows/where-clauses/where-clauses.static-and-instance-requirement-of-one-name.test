// Test: where-clauses.static-and-instance-requirement-of-one-name
typealias Code = int(0 to u32.max)

interface StaticOrigin
	static function origin() returns Code
end 'StaticOrigin'

interface InstanceOrigin
	function origin() returns Code
end 'InstanceOrigin'

type Box uses T where T is StaticOrigin, T is InstanceOrigin
	export var item as T

	function go() returns Code
		return self.item.origin()
	end 'go'
end 'Box'

function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
