// Test: where-clauses.int-actual-for-float-formal
typealias Coord = int(0 to 1000)

interface Scaled
	function scale(k Real) returns Real
end 'Scaled'

type Point implements Scaled
	export var x as Coord
	export static function create(x Coord) returns Self
		return Self{ x: x }
	end 'create'
	export function scale(k Real) returns Real
		return k * 2.0
	end 'scale'
end 'Point'

type Box uses T where T is Scaled
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function fromInt() returns Real
		return self.item.scale(2)
	end 'fromInt'
	export function fromFloat() returns Real
		return self.item.scale(1.5)
	end 'fromFloat'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let b = PointBox.create(Point.create(7))
	if b.fromInt() == 4.0 and b.fromFloat() == 3.0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
typealias Real = float(f64.min to f64.max)
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @Point.scale {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 7
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#7:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Point.Scaled]
  __il_body#12:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#6:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __witness_Point.Scaled]
  __il_body#13:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.callMem [rax + 24]
  __il_cont#5:
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.ucomisdRegReg xmm0, xmm1
    x64.movRegImm32 rax, 0
    x64.jcc parity, scmerge
  fordered:
    x64.jcc notEqual, scmerge
  andrhs:
    x64.leaRegRdata rax, [rip + __witness_Point.Scaled]
  __il_body#15:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movsdRegRip xmm0, [rip + __fconst_1.5]
    x64.callMem [rax + 24]
  __il_cont#14:
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Point
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Point
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
