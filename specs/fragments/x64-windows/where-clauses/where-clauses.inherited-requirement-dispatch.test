    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 7
  __rc_ok#9:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#7:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Widget.Derived]
  __il_body#12:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#6:
    x64.leaRegRdata rax, [rip + __witness_Widget.Derived]
  __il_body#13:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callMem [rax + 48]
  __il_cont#5:
    x64.imulRegRegImm32 rbx, r8, 10
    x64.leaRegRdata rax, [rip + __witness_Widget.Derived]
  __il_body#14:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callMem [rax + 40]
  __il_cont#4:
    x64.leaRegRegReg rbx, rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
