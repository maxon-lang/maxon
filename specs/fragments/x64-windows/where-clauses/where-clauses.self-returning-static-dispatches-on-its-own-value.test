// Test: where-clauses.self-returning-static-dispatches-on-its-own-value
typealias Integer = int(i64.min to i64.max)

type Holder uses T where T is Hashable and Equatable
	var v as T

	export static function of(v T) returns Self
		var built = Self{v: v}
		if built.matches(v) 'sameValue'
			return built
		end 'sameValue'
		panic("Holder.of: the value it was built from must equal itself")
	end 'of'

	export function matches(other T) returns bool
		return v.equals(other)
	end 'matches'

	export function digest() returns HashValue
		return v.hash()
	end 'digest'
end 'Holder'

typealias H = Holder with Integer

function main() returns ExitCode
	let h = H.of(41)
	return h.digest()
end 'main'
---
ExitCode: 41
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 41
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata r12, [rip + __witness_int.Equatable]
  __il_body#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_body#8:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegReg rdx, rbx
    x64.callMem [r12 + 40]
  __il_cont#7:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  __il_cont#3:
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata rcx, [rip + __witness_int.Equatable]
  __il_body#2:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callMem [rax + 40]
    x64.movRegReg rbx, r8
  __il_cont#1:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at where-clauses.self-returning-static-dispatches-on-its-own-value.test:12: Holder.of: the value it was built from must equal itself\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
