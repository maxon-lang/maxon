  __sched_procs@160 = i64 0
  __sched_allm@168 = i64 0
  __sched_midle@176 = i64 0
  __sched_pidle@184 = i64 0
  __sched_num_procs@192 = i64 0
  __sched_shutdown_flag@200 = i64 0
  __sched_lock@208 = i64 0
  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __sched_sysmon_started@232 = i64 0
  __slab_arena_list@240 = i64 0
  __slab_arena_map_l1@248 = i64 0
  __slab_state@256 = i64 0
}

func @slow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect sleep
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @quick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Runtime.yield
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __gt_promise_drop]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 120
    x64.leaRegFunc rcx, [rip + slow]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 200], r12
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.leaRegFunc rcx, [rip + quick]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 240
    x64.leaRegFunc rcx, [rip + slow]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 200], r12
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await_any
