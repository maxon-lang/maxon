// Test: seven-across-call-in-loop
function bump(x Integer) returns Integer
	return x + 1
end 'bump'

function sevenAcross(p Integer) returns Integer
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var a5 = p + 5
	var a6 = p + 6
	var a7 = p + 7
	var i = 0
	while i < 3 'loop'
		let d = bump(i)
		a1 = a1 + d
		a2 = a2 + d
		a3 = a3 + d
		a4 = a4 + d
		a5 = a5 + d
		a6 = a6 + d
		a7 = a7 + d
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4 + a5 + a6 + a7
end 'sevenAcross'

function main() returns ExitCode
	let r = sevenAcross(0)
	if r == 70 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#4:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rsi, 4
    x64.movRegImm32 rdi, 5
    x64.movRegImm32 r8, 6
    x64.movRegImm32 r9, 7
    x64.movRegImm32 r10, 0
    x64.jmp whilehdr
  __il_body#9:
    x64.leaRegRegImm32 r10, r10, 1
  __il_cont#8:
    x64.leaRegRegReg rax, rax, r10
    x64.leaRegRegReg rcx, rcx, r10
    x64.leaRegRegReg rdx, rdx, r10
    x64.leaRegRegReg rsi, rsi, r10
    x64.leaRegRegReg rdi, rdi, r10
    x64.leaRegRegReg r8, r8, r10
    x64.leaRegRegReg r9, r9, r10
  whilehdr:
    x64.cmpRegImm32 r10, 3
    x64.jcc less, __il_body#9
  whileexit:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, r9
  __il_cont#3:
    x64.cmpRegImm32 rax, 70
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
