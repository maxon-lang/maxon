// Test: an-integer-element-write-asks-no-destructor-question
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function fill(a WordArray, n Word)
	for i in 0 upto n 'each'
		try a.set(i, value: i * 3 + 1) otherwise panic("set: index out of range")
	end 'each'
end 'fill'

function main() returns ExitCode
	var a = WordArray.create()
	a.resize(5)
	fill(a, n: 5)
	var seen = 0
	for v in a 'check'
		seen = seen + v
	end 'check'
	if seen != 35 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @fill {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 r13, 0
  forhdr:
    x64.cmpRegReg r13, r12
    x64.jcc greaterEqual, forexit
  each:
    x64.imulRegRegImm32 rax, r13, 3
    x64.leaRegRegImm32 rax, rax, 1
  __rc_ok:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __im_slow
  __im_bounds:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg r13, rcx
    x64.jcc aboveEqual, __im_slow
  __im_buffer:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow
  __im_viewed:
    x64.leaRegRegImm32 rdx, rcx, -24
    x64.loadRegBaseDisp.word64 rdx, [rdx + 16]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __im_store
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forstep
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-integer-element-write-asks-no-destructor-question.test:7: set: index out of range\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_store:
    x64.storeBaseIndexScaleReg.word64 [rcx + r13*8 + 0], rax
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect fill
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
  forhdr:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forexit
  check:
    x64.loadRegBaseIndexScale.word64 rdi, [rsi + rcx*8 + 0]
  __im_cont:
    x64.leaRegRegReg rax, rax, rdi
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rax, 35
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
