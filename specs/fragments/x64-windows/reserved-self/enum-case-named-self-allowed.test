// Test: enum-case-named-self-allowed
enum Marker
	first = 1
	self = 2
	last = 3
end 'Marker'

function main() returns ExitCode
	let m = Marker.self
	return m.rawValue as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
