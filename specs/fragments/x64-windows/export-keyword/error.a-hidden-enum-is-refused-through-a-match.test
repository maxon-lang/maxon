// Test: error.a-hidden-enum-is-refused-through-a-match
// --- file: lib.maxon
enum Mode
	fast
	slow
end 'Mode'

export type Settings
	export var mode as Mode

	export static function make() returns Self
		return Self{mode: Mode.fast}
	end 'make'
end 'Settings'

// --- file: main.maxon
function main() returns ExitCode
	let s = Settings.make()

	match s.mode 'mode'
		fast then return 42
		slow then return 0
	end 'mode'
end 'main'
---
CompilerError:
error E3008: <fragment>:20:2: type 'Mode' is not exported
