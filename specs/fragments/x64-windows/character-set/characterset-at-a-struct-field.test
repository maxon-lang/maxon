// Test: characterset-at-a-struct-field
type Trimmer
	var chars as CharacterSet

	static function init(cs CharacterSet) returns Self
		return Self{chars: cs}
	end 'init'
end 'Trimmer'

function main() returns ExitCode
	_ = Trimmer.init(CharacterSet.whitespaces())
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespaces@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
  __ds_base@72 = i64 0
  __dbg_ctl@80 = i64 0
  __mrt_console_probe_stdin@88 = i8 0
  __mrt_console_probe_stdout@89 = i8 0
  __mrt_console_probe_stderr@90 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body#3:
    x64.leaRegGlobal rax, __data_CharacterSet.cachedWhitespaces
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.leaRegFunc rdx, [rip + __clone_CharacterSet]
    x64.callDirect __mm_own_deep
    x64.movRegReg rbx, r8
  __il_body#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.leaRegFunc rdx, [rip + __clone_CharacterSet]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own_deep
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_CharacterSet
  __il_cont:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Trimmer
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
