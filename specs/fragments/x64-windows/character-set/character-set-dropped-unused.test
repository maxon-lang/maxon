// Test: character-set-dropped-unused
function main() returns ExitCode
	let punctuation = CharacterSet.punctuation()
	let blanks = CharacterSet.whitespacesAndNewlines()
	print("ok" if punctuation.contains('!') and blanks.contains('	') else "no")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __data_CharacterSet.cachedPunctuation@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_console_probe_stdin@40 = i8 0
  __mrt_console_probe_stdout@41 = i8 0
  __mrt_console_probe_stderr@42 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#8:
    x64.leaRegGlobal rax, __data_CharacterSet.cachedPunctuation
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.leaRegFunc rdx, [rip + __clone_CharacterSet]
    x64.callDirect __mm_own_deep
    x64.movRegReg rbx, r8
  __il_body#9:
    x64.leaRegGlobal rax, __data_CharacterSet.cachedWhitespacesAndNewlines
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.leaRegFunc rdx, [rip + __clone_CharacterSet]
    x64.callDirect __mm_own_deep
    x64.movRegReg r12, r8
  __il_cont#6:
    x64.leaRegRdata rdx, [rip + __str_rec_10]  ; "!"
    x64.movRegReg rcx, rbx
    x64.callDirect CharacterSet.contains
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  andrhs:
    x64.leaRegRdata rdx, [rip + __str_rec_11]  ; "\x09"
    x64.movRegReg rcx, r12
    x64.callDirect CharacterSet.contains
    x64.jmp scmerge
  critsplit:
    x64.movRegReg r8, rax
  scmerge:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.leaRegRdata rcx, [rip + __str_rec_12]  ; "ok"
    x64.jmp __il_body#11
  ternaryfalse:
    x64.leaRegRdata rcx, [rip + __str_rec_13]  ; "no"
  __il_body#11:
    x64.callDirect __write_stdout
  __il_cont#10:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_CharacterSet
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_CharacterSet
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
