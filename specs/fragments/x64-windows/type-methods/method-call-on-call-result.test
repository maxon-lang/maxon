// Test: method-call-on-call-result

typealias Integer = int(i64.min to i64.max)

type Value
	var n as Integer

	function get() returns Integer
		return n
	end 'get'

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Value'

function main() returns ExitCode
	let a = Value.create(3)
	let b = Value.create(5)
	match a.get().compare(b.get()) 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 2
	end 'check'
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 3
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 5
    x64.leaRegSlot rdx, slot1
    x64.storeBaseDispReg.word64 [rdx + 0], rax
  __il_body#16:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
  __il_body#17:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
  __il_body#9:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, ifcont#11
  lt:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#11:
    x64.cmpRegReg rax, rcx
    x64.jcc lessEqual, ifcont#13
  gt:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#13:
    x64.movRegImm32 rax, 1
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matcharm#3
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
  matcharm#3:
    x64.movRegImm32 r8, 2
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
