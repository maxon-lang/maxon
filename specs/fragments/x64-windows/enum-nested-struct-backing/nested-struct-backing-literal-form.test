// Test: nested-struct-backing-literal-form
typealias Latency = int(0 to 50)

type Inner
	export let value as Latency
end 'Inner'

type Outer
	export let inner as Inner
	export let flag as bool
end 'Outer'

enum Op
	add = Outer{inner: Inner{value: 1}, flag: true}
	nop = Outer{inner: Inner{value: 0}, flag: false}
end 'Op'

function main() returns ExitCode
	let op = Op.add
	if op.rawValue.flag 'flagged'
		return op.rawValue.inner.value
	end 'flagged'
	return 9
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  flagged:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
