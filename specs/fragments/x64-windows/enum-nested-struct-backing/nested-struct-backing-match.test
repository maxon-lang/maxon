// Test: nested-struct-backing-match
typealias Latency = int(0 to 50)

type Inner
	export let latency as Latency

	static function create(latency Latency) returns Self
		return Self{latency: latency}
	end 'create'
end 'Inner'

type Outer
	export let inner as Inner
	export let fast as bool

	static function create(inner Inner, fast bool) returns Self
		return Self{inner: inner, fast: fast}
	end 'create'
end 'Outer'

enum Op
	add = Outer.create(Inner.create(1), fast: true)
	div = Outer.create(Inner.create(40), fast: false)
end 'Op'

function main() returns ExitCode
	let op = Op.div
	return match op 'dispatch'
		add gives 10
		div gives 20
	end 'dispatch'
end 'main'
---
ExitCode: 20
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 20
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
