// Test: nested-struct-backing-outer-field
typealias Latency = int(0 to 50)

type OpMeta
	export let latency as Latency

	static function create(latency Latency) returns Self
		return Self{latency: latency}
	end 'create'
end 'OpMeta'

type TargetMeta
	export let meta as OpMeta
	export let setsFlags as bool

	static function create(meta OpMeta, setsFlags bool) returns Self
		return Self{meta: meta, setsFlags: setsFlags}
	end 'create'
end 'TargetMeta'

enum Op
	add = TargetMeta.create(OpMeta.create(1), setsFlags: true)
	mov = TargetMeta.create(OpMeta.create(2), setsFlags: false)
end 'Op'

function main() returns ExitCode
	let op = Op.add
	if op.rawValue.setsFlags 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
