    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rcx, [rip + __str_rec_19]  ; "noyield.txt"
    x64.callDirect FilePath.init
