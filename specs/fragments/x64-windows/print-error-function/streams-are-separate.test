// Test: streams-are-separate
function main() returns ExitCode
	print("out\n")
	printError("err\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "out\x0a"
    x64.callDirect print
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "err\x0a"
    x64.callDirect printError
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
