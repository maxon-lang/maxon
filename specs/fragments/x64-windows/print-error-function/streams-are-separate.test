// Test: streams-are-separate
function main() returns ExitCode
	print("out\n")
	printError("err\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "out\x0a"
  __il_body#3:
    x64.callDirect __write_stdout
  __il_cont#2:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "err\x0a"
  __il_body#4:
    x64.callDirect __write_stderr
  __il_cont#1:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
