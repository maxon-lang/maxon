// Test: struct-backing-type-qualified-field
typealias W = int(0 to 50)

type Spec
	export let width as W
end 'Spec'

enum Preset
	small = Spec{width: 3}
	large = Spec{width: 9}
end 'Preset'

function main() returns ExitCode
	return Preset.large.width
end 'main'
---
ExitCode: 9
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 9
    x64.popReg rbp
    x64.ret
}
