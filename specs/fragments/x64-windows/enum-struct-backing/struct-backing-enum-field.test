// Test: struct-backing-enum-field
typealias Cost = int(0 to 100)

enum Priority
	low
	medium
	high
end 'Priority'

type TaskInfo
	export let priority as Priority
	export let cost as Cost
end 'TaskInfo'

enum Task
	quick = TaskInfo{priority: Priority.low, cost: 1}
	normal = TaskInfo{priority: Priority.medium, cost: 5}
	heavy = TaskInfo{priority: Priority.high, cost: 10}
end 'Task'

function main() returns ExitCode
	let t = Task.heavy
	return t.rawValue.priority.ordinal
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
