// Test: struct-backing-keyword-enum-case-field
enum Cat
	bool
	int
end 'Cat'

type Info
	export let cat as Cat
end 'Info'

enum Kind
	a = Info{cat: Cat.bool}
	b = Info{cat: Cat.int}
end 'Kind'

function classify(k Kind) returns ExitCode
	return match k 'm'
		a gives 4
		b gives 1
	end 'm'
end 'classify'

function main() returns ExitCode
	return classify(Kind.b)
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}
