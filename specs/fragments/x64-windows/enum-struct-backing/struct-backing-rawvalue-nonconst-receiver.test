// Test: struct-backing-rawvalue-nonconst-receiver
typealias Latency = int(0 to 50)

type Meta
	export let value as Latency
end 'Meta'

enum TestOp
	add = Meta{value: 1}
	mul = Meta{value: 3}
end 'TestOp'

// `op` is a parameter — not a compile-time-known case — so `op.rawValue.value`
// cannot be const-folded and must materialize the backing struct at runtime.
function latencyOf(op TestOp) returns Latency
	return op.rawValue.value
end 'latencyOf'

function main() returns ExitCode
	return latencyOf(TestOp.mul)
end 'main'
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 3
  __il_cont:
    x64.popReg rbp
    x64.ret
}
