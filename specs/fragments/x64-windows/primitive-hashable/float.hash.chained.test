  __il_body:
    x64.movRegImm32 rax, 4294967295
    x64.andRegImm32 rax, rax, 300063655
  __il_cont:
    x64.cmpRegImm32 rax, 300063655
    x64.jcc equal, ifcont
  chainDiffers:
