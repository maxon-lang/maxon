// Test: float.hash.chained
function main() returns ExitCode
	let f = 3.14
	let once = f.hash()
	let twice = f.hash().hash()
	if once != twice 'chainDiffers'
		return 1
	end 'chainDiffers'
	if once != 300063655 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
