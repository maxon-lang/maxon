// Test: float.hash.chained
function main() returns ExitCode
	let f = 3.14
	let once = f.hash()
	let twice = f.hash().hash()
	if once != twice 'chainDiffers'
		return 1
	end 'chainDiffers'
	if once != 300063655 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 4294967295
    x64.andRegImm32 rax, rax, 300063655
  __il_cont:
    x64.cmpRegImm32 rax, 300063655
    x64.jcc equal, ifcont
  chainDiffers:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
