// Test: float.hash.equal-values-equal-hashes
function main() returns ExitCode
	let a = 1.5
	let b = 3.0 / 2.0
	if a.hash() != b.hash() 'differ'
		return 1
	end 'differ'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont#7:
    x64.movRegImm32 rax, 0
  ifcont#13:
    x64.movRegImm32 rcx, 0
  __il_cont:
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#2
  differ:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
