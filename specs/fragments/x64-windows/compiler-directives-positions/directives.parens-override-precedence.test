// Test: directives.parens-override-precedence
function main() returns ExitCode
	#if (testing(false) or testing(true)) and testing(true)
		return 94
	#else
		return 28
	#endif
end 'main'
---
ExitCode: 28
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 28
    x64.popReg rbp
    x64.ret
}
