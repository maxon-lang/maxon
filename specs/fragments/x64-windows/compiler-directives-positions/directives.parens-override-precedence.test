// Test: directives.parens-override-precedence
function main() returns ExitCode
	#if (testing(false) or testing(true)) and testing(true)
		return 94
	#else
		return 28
	#endif
end 'main'
---
ExitCode: 28
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 28
    x64.popReg rbp
    x64.ret
}
