// Test: directives.precedence-and-binds-tighter
function main() returns ExitCode
	#if testing(false) or testing(true) and testing(true)
		return 27
	#else
		return 95
	#endif
end 'main'
---
ExitCode: 27
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 27
    x64.popReg rbp
    x64.ret
}
