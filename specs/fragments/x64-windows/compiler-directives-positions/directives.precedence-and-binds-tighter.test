// Test: directives.precedence-and-binds-tighter
function main() returns ExitCode
	#if testing(false) or testing(true) and testing(true)
		return 27
	#else
		return 95
	#endif
end 'main'
---
ExitCode: 27
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 27
    x64.popReg rbp
    x64.ret
}
