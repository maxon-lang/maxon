// Test: directives.unknown-os-argument-is-false
function main() returns ExitCode
	#if os(Plan9)
		return 96
	#else
		return 25
	#endif
end 'main'
---
ExitCode: 25
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 25
    x64.popReg rbp
    x64.ret
}
