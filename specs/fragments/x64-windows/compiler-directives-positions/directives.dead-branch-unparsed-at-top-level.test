// Test: directives.dead-branch-unparsed-at-top-level
#if testing(true)
	function ghost() returns ExitCode
		return no_such_function_anywhere()
	end 'ghost'
#endif

function main() returns ExitCode
	return 30
end 'main'
---
ExitCode: 30
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 30
    x64.popReg rbp
    x64.ret
}
