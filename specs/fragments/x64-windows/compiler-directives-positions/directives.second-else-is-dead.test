// Test: directives.second-else-is-dead
#if os(Plan9)
function main() returns ExitCode
	return 1
end 'main'
#else
function main() returns ExitCode
	return 2
end 'main'
#else
function main() returns ExitCode
	return 3
end 'main'
#endif
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
}
