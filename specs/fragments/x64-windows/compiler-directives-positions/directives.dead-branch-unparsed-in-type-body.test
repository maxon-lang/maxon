// Test: directives.dead-branch-unparsed-in-type-body
type Holder
	#if testing(true)
		static function ghost() returns ExitCode
			return no_such_function_anywhere()
		end 'ghost'
	#endif

	static function value() returns ExitCode
		return 33
	end 'value'
end 'Holder'

function main() returns ExitCode
	return Holder.value()
end 'main'
---
ExitCode: 33
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 33
  __il_cont:
    x64.popReg rbp
    x64.ret
}
