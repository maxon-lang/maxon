// Test: builtins-cpu-parallel.cpu-count-is-in-range
function main() returns ExitCode
	let cpus = __Builtins.cpuCount()
	let windowsCeiling = 4096
	var score = 0
	if cpus >= 1 'atLeastOne'
		score = score + 1
	end 'atLeastOne'
	if cpus <= windowsCeiling 'belowTheCeiling'
		score = score + 2
	end 'belowTheCeiling'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __cpu_count
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 1
    x64.jcc less, ifcont
  atLeastOne:
    x64.movRegImm32 rax, 1
  ifcont:
    x64.cmpRegImm32 r8, 4096
    x64.jcc greater, critsplit
  belowTheCeiling:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rax
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
