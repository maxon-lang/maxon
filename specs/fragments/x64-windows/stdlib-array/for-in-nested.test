// Test: for-in-nested
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function innerSum(arr IntArray) returns Int
	var total = 0
	for item in arr 'inner'
		total = total + item
	end 'inner'
	return total
end 'innerSum'

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(1)
	arr.push(2)
	arr.push(3)

	var outerTotal = 0
	for item in arr 'outer'
		outerTotal = outerTotal + item + innerSum(arr)
	end 'outer'

	// Each outer item: item + innerSum(arr) = item + 6
	// Outer loop: (1+6) + (2+6) + (3+6) = 7+8+9 = 24
	if outerTotal == 24 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
    x64.loadRegBaseDisp.word64 rdi, [rbx + 8]
    x64.loadRegBaseDisp.word64 r8, [rbx + 0]
  forhdr#1:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forexit
  outer:
    x64.loadRegBaseIndexScale.word64 r9, [rsi + rcx*8 + 0]
  __im_cont#7:
    x64.leaRegRegReg rax, rax, r9
  __il_body:
    x64.movRegImm32 r9, 0
    x64.movRegImm32 r10, 0
  forhdr#10:
    x64.cmpRegReg r10, rdi
    x64.jcc greaterEqual, __il_cont
  inner:
    x64.loadRegBaseIndexScale.word64 r11, [r8 + r10*8 + 0]
  __im_cont#14:
    x64.leaRegRegReg r9, r9, r11
  forstep#12:
    x64.leaRegRegImm32 r10, r10, 1
    x64.jmp forhdr#10
  __il_cont:
    x64.leaRegRegReg rax, rax, r9
  forstep#3:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr#1
  forexit:
    x64.cmpRegImm32 rax, 24
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
