  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at panic.in-function.test:3: failure in helper\x0a"
    x64.callDirect mrt_panic
