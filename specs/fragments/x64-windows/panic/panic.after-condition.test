// Test: panic.after-condition
typealias Integer = int(i64.min to i64.max)

function check(n Integer) returns Integer
		if n < 0 'negative'
				panic("negative value")
		end 'negative'
		return n
end 'check'

function main() returns ExitCode
		return check(-1)
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  negative:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at panic.after-condition.test:6: negative value\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
