// Test: panic.basic
function main() returns ExitCode
		if true 'check'
				panic("something went wrong")
		end 'check'
		return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  check:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at panic.basic.test:4: something went wrong\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
