// Test: a-value-narrowed-into-an-implements-alias-is-guarded
typealias FooId = int(0 to 1000) implements ElementIndex

function takesFoo(f FooId) returns FooId
	return f
end 'takesFoo'

function main() returns ExitCode
	let i = 4000 as ElementIndex
	let f = takesFoo(i as FooId)
	print("{f}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
  __mrt_program_started@11 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-value-narrowed-into-an-implements-alias-is-guarded.test:10: Range check failed: value outside typealias 'FooId'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
