// Test: a-narrowing-cast-keeps-its-guard
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 16)

function widen(n Narrow) returns Wide
	return n as Wide
end 'widen'

function main() returns ExitCode
	let w = widen(9) * 40
	let n = w as Narrow
	print("{n}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_ok:
    x64.movRegImm32 rax, 9
  __il_cont:
    x64.imulRegRegImm32 rax, rax, 40
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-narrowing-cast-keeps-its-guard.test:11: Range check failed: value outside typealias 'Narrow'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
