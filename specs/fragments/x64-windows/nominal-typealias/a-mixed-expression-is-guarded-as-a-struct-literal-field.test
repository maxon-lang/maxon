// Test: a-mixed-expression-is-guarded-as-a-struct-literal-field
typealias Small = int(0 to 10)
typealias BlockId = int(0 to 10) implements Small
typealias VarId = int(0 to 10) implements Small

type Holder
	export var block as BlockId

	static function create(block BlockId, varId VarId) returns Self
		return Self{block: block + varId}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(8, varId: 5)
	print("{h.block}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
  __mrt_program_started@11 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-mixed-expression-is-guarded-as-a-struct-literal-field.test:10: Range check failed: value outside typealias 'BlockId'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
