// Test: a-widening-return-emits-no-guard
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 16)

function widen(n Narrow) returns Wide
	return n
end 'widen'

function main() returns ExitCode
	return widen(9) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok#6:
    x64.movRegImm32 r8, 9
  __rc_ok#1:
    x64.popReg rbp
    x64.ret
}
