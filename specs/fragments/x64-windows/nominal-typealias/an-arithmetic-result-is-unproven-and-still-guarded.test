// Test: an-arithmetic-result-is-unproven-and-still-guarded
typealias Score = int(0 to 100)

function takesScore(s Score) returns Score
	return s
end 'takesScore'

function main() returns ExitCode
	let a = 60 as Score
	let a2 = a + 10
	let r = takesScore(a + a2)
	print("{r}")
	return 0
end 'main'
