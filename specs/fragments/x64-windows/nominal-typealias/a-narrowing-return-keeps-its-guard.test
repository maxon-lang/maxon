// Test: a-narrowing-return-keeps-its-guard
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 16)

function shrink(w Wide) returns Narrow
	return w
end 'shrink'

function main() returns ExitCode
	let n = shrink(360)
	print("{n}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-narrowing-return-keeps-its-guard.test:6: Range check failed: value outside typealias 'Narrow'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
