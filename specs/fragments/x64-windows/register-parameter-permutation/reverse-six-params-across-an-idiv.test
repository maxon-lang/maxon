// Test: reverse-six-params-across-an-idiv
function digits6(p1 Integer, p2 Integer, p3 Integer, p4 Integer, p5 Integer, p6 Integer) returns Integer
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function divPermute(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer) returns Integer
	let sum = a + b + c + d + e + f
	let q = sum / 2
	let r = digits6(f, p2: e, p3: d, p4: c, p5: b, p6: a)
	return r + q
end 'divPermute'

function main() returns ExitCode
	let v = divPermute(1, b: 2, c: 3, d: 4, e: 5, f: 6)
	if v == 654331 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 21
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 rax, rax, 21
    x64.sarRegImm8 rax, rax, 1
  __il_cont:
    x64.leaRegRegImm32 rax, rax, 654321
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
