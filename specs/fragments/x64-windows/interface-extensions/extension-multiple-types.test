// Test: extension-multiple-types

typealias Integer = int(i64.min to i64.max)

interface Valued
	function val() returns Integer
end 'Valued'

extension Valued
	function valPlusTen() returns Integer
		return self.val() + 10
	end 'valPlusTen'
end 'Valued'

type TypeA implements Valued
	let a as Integer
	function val() returns Integer
		return a
	end 'val'

	static function create(a Integer) returns Self
		return Self{a: a}
	end 'create'
end 'TypeA'

type TypeB implements Valued
	var b as Integer
	function val() returns Integer
		return b * 2
	end 'val'

	static function create(b Integer) returns Self
		return Self{b: b}
	end 'create'
end 'TypeB'

function main() returns ExitCode
	let ta = TypeA.create(5)
	let tb = TypeB.create(10)
	return ta.valPlusTen() + tb.valPlusTen()
end 'main'
---
ExitCode: 45
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @TypeA.valPlusTen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}

func @TypeB.valPlusTen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegRegImm32 rax, rax, 2
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rax, 5
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rbx, slot1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.callDirect TypeA.valPlusTen
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect TypeB.valPlusTen
    x64.leaRegRegReg r8, r12, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at extension-multiple-types.test:40: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
