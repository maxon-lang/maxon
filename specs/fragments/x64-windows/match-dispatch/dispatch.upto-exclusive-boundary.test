// Test: dispatch.upto-exclusive-boundary
function classify(x Integer) returns Integer
	return match x 'm'
		10 upto 20 gives 1
		20 upto 30 gives 2
		30 gives 3
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `upto` excludes its upper: 10..20 covers 10..19, 20..30 covers 20..29, and 30 is its own arm.
	var n = 0 as ExitCode
	if classify(19) == 1 'a'
		n = n + 1
	end 'a'
	if classify(20) == 2 'b'
		n = n + 1
	end 'b'
	if classify(29) == 2 'c'
		n = n + 1
	end 'c'
	if classify(30) == 3 'd'
		n = n + 1
	end 'd'
	if classify(9) == 0 'e'
		n = n + 1
	end 'e'
	return n
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  a:
    x64.movRegImm32 rax, 1
  b:
    x64.leaRegRegImm32 rax, rax, 1
  c:
    x64.leaRegRegImm32 rax, rax, 1
  d:
    x64.leaRegRegImm32 rax, rax, 1
  e:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
