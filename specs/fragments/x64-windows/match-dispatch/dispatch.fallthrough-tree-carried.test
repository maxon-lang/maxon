// Test: dispatch.fallthrough-tree-carried
typealias N = int(0 to 1000000)

function perms(role N) returns N
	var p = 0 as N
	match role 'auth'
		1 then p = p + 1 and fallthrough
		2 then p = p + 2 and fallthrough
		3 then p = p + 4 and fallthrough
		4 then p = p + 8 and fallthrough
		5 then p = p + 16
		default then p = 0
	end 'auth'
	return p
end 'perms'

function main() returns ExitCode
	var n = 0 as N
	if perms(1) == 31 'a'
		n = n + 1
	end 'a'
	if perms(3) == 28 'b'
		n = n + 1
	end 'b'
	if perms(5) == 16 'c'
		n = n + 1
	end 'c'
	if perms(6) == 0 'd'
		n = n + 1
	end 'd'
	return n as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @perms {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000000
    x64.jcc greater, __rc_panic
  __rc_ok#8:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.jumpTable rcx, default=matchdefault [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_3
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok#11
  matcharm#1:
    x64.leaRegRegImm32 rax, rax, 1
  matcharm#2:
    x64.leaRegRegImm32 rax, rax, 2
  matcharm#3:
    x64.leaRegRegImm32 rax, rax, 4
  matcharm#4:
    x64.leaRegRegImm32 rax, rax, 8
  matcharm#5:
    x64.leaRegRegImm32 r8, rax, 16
  __rc_ok#11:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at dispatch.fallthrough-tree-carried.test:4: Range check failed: value outside typealias 'N'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect perms
    x64.cmpRegImm32 r8, 31
    x64.jcc notEqual, ifcont#2
  a:
    x64.movRegImm32 rbx, 1
  ifcont#2:
    x64.movRegImm32 rcx, 3
    x64.callDirect perms
    x64.cmpRegImm32 r8, 28
    x64.jcc notEqual, ifcont#4
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#4:
    x64.movRegImm32 rcx, 5
    x64.callDirect perms
    x64.cmpRegImm32 r8, 16
    x64.jcc notEqual, ifcont#6
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#6:
    x64.movRegImm32 rcx, 6
    x64.callDirect perms
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit
  d:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rbx
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
