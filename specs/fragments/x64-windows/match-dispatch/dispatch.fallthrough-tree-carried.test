    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at dispatch.fallthrough-tree-carried.test:14: Range check failed: value outside typealias 'N'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#11:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

