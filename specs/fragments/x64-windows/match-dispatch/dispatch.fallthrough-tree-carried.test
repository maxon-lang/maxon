    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.jumpTable rcx, default=matchdefault [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_3
  matchdefault:
