// Test: dispatch.default-only
typealias N = int(0 to 100)

function only(x N) returns N
	return match x 'c'
		default gives 7
	end 'c'
end 'only'

function main() returns ExitCode
	var n = 0 as N
	if only(5) == 7 'a'
		n = n + 1
	end 'a'
	if only(0) == 7 'b'
		n = n + 1
	end 'b'
	return n as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  a:
    x64.movRegImm32 rax, 1
  b:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
