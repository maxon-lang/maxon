// Test: dispatch.upto-min-upto-min-empty
function classify(x Integer) returns Integer
	return match x 'm'
		-9223372036854775808 upto -9223372036854775808 gives 1
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `min upto min` is also empty. The wrap bug turned it into `[i64.min, i64.max]`, matching every
	// value; that the ordinary values below still fall to default proves the arm is dead.
	var n = 0 as ExitCode
	if classify(5) == 0 'a'
		n = n + 1
	end 'a'
	if classify(0) == 0 'b'
		n = n + 1
	end 'b'
	if classify(-1) == 0 'c'
		n = n + 1
	end 'c'
	return n
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  a:
    x64.movRegImm32 rax, 1
  b:
    x64.leaRegRegImm32 rax, rax, 1
  c:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
