// Test: dispatch.dense-nonzero-enum
enum Priority
	p0 = 10
	p1 = 11
	p2 = 12
	p3 = 13
	p4 = 14
end 'Priority'

function rank(p Priority) returns ExitCode
	return match p 'm'
		p0 gives 1
		p1 gives 2
		p2 gives 3
		p3 gives 4
		p4 gives 5
	end 'm'
end 'rank'

function main() returns ExitCode
	var n = 0 as ExitCode
	if rank(Priority.p0) == 1 'a'
		n = n + 1
	end 'a'
	if rank(Priority.p1) == 2 'b'
		n = n + 1
	end 'b'
	if rank(Priority.p2) == 3 'c'
		n = n + 1
	end 'c'
	if rank(Priority.p3) == 4 'd'
		n = n + 1
	end 'd'
	if rank(Priority.p4) == 5 'e'
		n = n + 1
	end 'e'
	return n
end 'main'
---
ExitCode: 5
