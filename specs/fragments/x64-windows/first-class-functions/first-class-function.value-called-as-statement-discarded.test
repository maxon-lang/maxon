// Test: first-class-function.value-called-as-statement-discarded
typealias Integer = int(i64.min to i64.max)

function inc(n Integer) returns Integer
	return n + 1
end 'inc'

function main() returns ExitCode
	let f = inc
	f(10)
	return f(41)
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
  __mrt_program_started@3 = i8 0
}

func @inc {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRdata rax, [rip + __fnrec_inc]
  __il_body:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
