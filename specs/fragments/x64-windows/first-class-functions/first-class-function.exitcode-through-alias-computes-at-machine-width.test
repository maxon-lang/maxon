  __mrt_console_probe_stderr@34 = i8 0
}

func @big {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 4000000000
    x64.popReg rbp
    x64.ret
}

