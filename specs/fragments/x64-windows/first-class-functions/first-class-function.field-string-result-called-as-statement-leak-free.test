// Test: first-class-function.field-string-result-called-as-statement-leak-free
typealias Msg = function() returns String

type Holder
	export var op as Msg

	static function create(op Msg) returns Self
		return Self{op: op}
	end 'create'
end 'Holder'

function greet() returns String
	return "hello world this is a heap string"
end 'greet'

function main() returns ExitCode
	let h = Holder.create(greet)
	h.op()
	h.op()
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @greet {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello world this is a heap string"
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegFunc rbx, [rip + __fnref_greet]
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.movRegImm32 rcx, 0
    x64.callReg rax
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.movRegImm32 rcx, 0
    x64.callReg rax
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
