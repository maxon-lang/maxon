    x64.movsdRegRip xmm1, [rip + __fconst_1000]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok#3
  __rc_panic#4:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.float-then-int-params-indirect.test:7: Range check failed: value outside typealias 'Ratio'\x0a"
    x64.callDirect mrt_panic
