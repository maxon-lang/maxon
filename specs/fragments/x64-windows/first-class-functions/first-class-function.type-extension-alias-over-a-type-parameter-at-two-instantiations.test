    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg rdx, rax
    x64.callReg rsi
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Holder.check {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg rdx, rax
    x64.callReg rsi
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @flip {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.xorRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @isBig {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 10
    x64.setccReg greater, r8
    x64.popReg rbp
    x64.ret
}

