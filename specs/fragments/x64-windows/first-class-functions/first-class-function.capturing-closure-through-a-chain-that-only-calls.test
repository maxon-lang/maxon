// Test: first-class-function.capturing-closure-through-a-chain-that-only-calls
typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

function ping(f UnaryOp, n Integer) returns Integer
	if n <= 0 'done'
		return f(n)
	end 'done'
	return pong(f, n: n - 1)
end 'ping'

function pong(f UnaryOp, n Integer) returns Integer
	return ping(f, n: n - 1)
end 'pong'

function main() returns ExitCode
	let bump = 20
	return ping(function(n Integer) gives n + bump, n: 5) as ExitCode
end 'main'
---
ExitCode: 19
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @ping {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc greater, ifcont
  done:
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callReg rsi
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rdx, -1
  __il_body:
    x64.leaRegRegImm32 rdx, rcx, -1
    x64.movRegReg rcx, rsi
    x64.callDirect ping
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 20
    x64.leaRegFunc r12, [rip + main$closure_0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, r12
    x64.movRegReg rax, r13
    x64.callDirect ping
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at first-class-function.capturing-closure-through-a-chain-that-only-calls.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}
