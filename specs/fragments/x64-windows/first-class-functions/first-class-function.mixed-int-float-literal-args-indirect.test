// Test: first-class-function.mixed-int-float-literal-args-indirect

typealias Ratio = float(0.0 to 1000.0)
typealias Count = int(0 to 1000)
typealias MixFn = function(n Count, x Ratio) returns Ratio

function combine(n Count, x Ratio) returns Ratio
	if n == 3 'exact'
		return x * 10.0
	end 'exact'
	return x
end 'combine'

function apply(f MixFn) returns Ratio
	return f(3, 5)
end 'apply'

function main() returns ExitCode
	let fn = combine
	return trunc(apply(fn)) as ExitCode
end 'main'
---
ExitCode: 50
---
func @combine {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#4
  __rc_chk#5:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc lessEqual, __rc_ok#3
  __rc_panic#4:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.mixed-int-float-literal-args-indirect.test:7: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#3:
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic#7
  __rc_chk#8:
    x64.movsdRegRip xmm1, [rip + __fconst_1000]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at first-class-function.mixed-int-float-literal-args-indirect.test:7: Range check failed: value outside typealias 'Ratio'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.cmpRegImm32 rcx, 3
    x64.jcc notEqual, ifcont
  exact:
    x64.movsdRegRip xmm1, [rip + __fconst_10]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic#10
  __rc_chk#11:
    x64.movsdRegRip xmm1, [rip + __fconst_1000]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at first-class-function.mixed-int-float-literal-args-indirect.test:9: Range check failed: value outside typealias 'Ratio'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
