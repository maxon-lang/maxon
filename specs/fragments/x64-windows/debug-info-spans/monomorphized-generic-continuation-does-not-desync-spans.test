// Test: monomorphized-generic-continuation-does-not-desync-spans
typealias Num = int(0 to 1000)

type Cell
	export var v as Num

	static function init(v Num) returns Self
		return Self{v: v}
	end 'init'
end 'Cell'

typealias CellArray = Array with Cell

type Chain uses T
	export var seed as T

	export static function create(seed T) returns Self
		return Self{seed: seed}
	end 'create'

	export function churn(d Num) returns Num
		print("churn\n")
		let pad = 1
		var arr = CellArray.create()
		arr.push(Cell.init(pad))
		let missed = try arr.get(7) otherwise Cell.init(3)
		return try (missed.v / d) otherwise 9
	end 'churn'
end 'Chain'

typealias NumChain = Chain with Num

function main() returns ExitCode
	let ch = NumChain.create(1)
	return ch.churn(0)
end 'main'
---
ExitCode: 9
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @Cell.init {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at monomorphized-generic-continuation-does-not-desync-spans.test:7: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __il_body#2:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#1:
    x64.leaRegRdata rax, [rip + __layout_Chain_Num]
  __rc_ok:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "churn\x0a"
  __il_body#22:
    x64.callDirect __write_stdout
  __il_cont#21:
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Cell.init
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 7
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 7
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseIndexScale.word64 rbx, [rax + rdx*8 + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r13 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#23
  __im_empty:
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, __im_slow
  critsplit#24:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#23:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr#6:
    x64.movRegImm32 rcx, 3
    x64.callDirect Cell.init
    x64.movRegReg rcx, r8
    x64.jmp trycont#7
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
  trycont#7:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegImm32 rsi, 1
    x64.movRegImm32 rdx, 0
    x64.divReg rsi
  tryerr#9:
    x64.movRegImm32 rbx, 9
  trycont#10:
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
  __il_cont#3:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.movRegReg rbx, r8
    x64.jmp __im_cont
