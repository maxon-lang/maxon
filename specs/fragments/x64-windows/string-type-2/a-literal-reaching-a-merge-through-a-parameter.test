// Test: a-literal-reaching-a-merge-through-a-parameter
function grow(s String)
	s.append("XY")
end 'grow'

function pick(s String, c bool)
	grow(s if c else "lit")
end 'pick'

function main() returns ExitCode
	pick("ab", c: true)
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "ab"
    x64.callDirect __str_clone
    x64.movRegReg rbx, r8
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.movRegReg r12, r8
  __il_body#9:
    x64.leaRegRdata r13, [rip + __str_rec_4]  ; "XY"
  __il_body#11:
    x64.movRegReg rcx, r13
    x64.callDirect __str_bytes_view
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_append
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.loadRegBaseDisp.byte rax, [r13 + 48]
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont#8
  clearFlag:
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.byte [r12 + 48], rax
  __il_cont#8:
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
  __il_cont#3:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "done\x0a"
  __il_body#2:
    x64.callDirect __write_stdout
  __il_cont#1:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
