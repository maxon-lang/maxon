// Test: string-literal-through-a-merge-of-two-literals
function grow(s String)
	s.append("XY")
end 'grow'

function main() returns ExitCode
	let c = true
	grow("a" if c else "b")
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  ternarytrue:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "a"
  matchcont:
    x64.callDirect __str_retain
    x64.movRegReg rbx, r8
  __il_body#7:
    x64.leaRegRdata r12, [rip + __str_rec_4]  ; "XY"
  __il_body#9:
    x64.movRegReg rcx, r12
    x64.callDirect __str_bytes_view
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_append
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.loadRegBaseDisp.byte rax, [r12 + 48]
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont#6
  clearFlag:
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.byte [rbx + 48], rax
  __il_cont#6:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "done\x0a"
  __il_body#5:
    x64.callDirect __write_stdout
  __il_cont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
