// Test: a-compare-branches-on-its-own-flags-across-a-counter-step
var lo = 0
var hi = 0
var hits = 0

function main() returns ExitCode
	lo = 1
	hi = 2
	let next = hits + 1
	let less = lo < hi
	hits = next

	if less 'less'
		return 40 + hits
	end 'less'

	return 7
end 'main'
---
ExitCode: 41
---
data {
  __data_lo@0 = i64 0
  __data_hi@8 = i64 0
  __data_hits@16 = i64 0
  __sched_tls_teb_offset@24 = i64 0
  __sched_allm@32 = i64 0
  __sched_lock@40 = i64 0
  __sched_preempt_ext_lock@48 = i64 0
  __sched_preempt_context@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_lo
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 2
    x64.leaRegGlobal rcx, __data_hi
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_hits
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_lo
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegGlobal rdx, __data_hi
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.cmpRegReg rcx, rdx
    x64.leaRegGlobal rcx, __data_hits
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jcc greaterEqual, ifcont
  less:
    x64.leaRegGlobal rax, __data_hits
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 r8, rax, 40
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 7
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-compare-branches-on-its-own-flags-across-a-counter-step.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
