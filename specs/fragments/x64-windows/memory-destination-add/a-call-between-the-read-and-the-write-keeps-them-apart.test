// Test: a-call-between-the-read-and-the-write-keeps-them-apart
typealias Depth = int(0 to 3)

var slot = 5

function reset(depth Depth)
	if depth > 0 'deeper'
		reset(depth - 1)
		return
	end 'deeper'

	slot = 100
end 'reset'

function main() returns ExitCode
	let seen = slot
	reset(3)
	slot = seen + 1
	return slot
end 'main'
---
ExitCode: 6
---
data {
  __data_slot@0 = i64 5
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
