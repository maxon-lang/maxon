// Test: jump-table.seven-cases-middle
enum Weekday
		mon
		tue
		wed
		thu
		fri
		sat
		sun
end 'Weekday'

function main() returns ExitCode
		let w = Weekday.thu
		let name = match w 'w'
				mon gives "Monday"
				tue gives "Tuesday"
				wed gives "Wednesday"
				thu gives "Thursday"
				fri gives "Friday"
				sat gives "Saturday"
				sun gives "Sunday"
		end 'w'
		print(name)
		return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 3
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5, [5]=matcharm#6, [6]=matcharm#7] @__jumptable_14
  matchdead:
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "Monday"
    x64.jmp __il_body
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_8]  ; "Tuesday"
    x64.jmp __il_body
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "Wednesday"
    x64.jmp __il_body
  matcharm#4:
    x64.leaRegRdata rcx, [rip + __str_rec_10]  ; "Thursday"
    x64.jmp __il_body
  matcharm#5:
    x64.leaRegRdata rcx, [rip + __str_rec_11]  ; "Friday"
    x64.jmp __il_body
  matcharm#6:
    x64.leaRegRdata rcx, [rip + __str_rec_12]  ; "Saturday"
    x64.jmp __il_body
  matcharm#7:
    x64.leaRegRdata rcx, [rip + __str_rec_13]  ; "Sunday"
  __il_body:
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
