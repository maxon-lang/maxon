    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegGlobal rax, __data_Shared
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
  __il_body#5:
    x64.leaRegFunc rdx, [rip + __clone_Guards]
    x64.callDirect __mm_own_deep
    x64.movRegReg rbx, r8
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.leaRegFunc rdx, [rip + __clone_Guards]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own_deep
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Guards
  __il_cont#6:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_push
  __il_cont#4:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegGlobal rcx, __data_Shared
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg rbx, rax, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Blocks
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-let-global-held-by-a-record-a-callee-builds-is-not-written-by-writing-that-record.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
