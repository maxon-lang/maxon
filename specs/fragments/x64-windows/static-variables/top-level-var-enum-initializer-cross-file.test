// Test: top-level-var-enum-initializer-cross-file
// --- file: api/defs.maxon
export enum CpuArch
	x64
	arm64
	wasm32
end 'CpuArch'

// --- file: app/main.maxon
var currentCpu = CpuArch.x64

function main() returns ExitCode
	let result = match currentCpu 'check'
		x64 gives 42
		arm64 gives 1
		wasm32 gives 2
	end 'check'
	return result
end 'main'
---
ExitCode: 42
---
data {
  __data_currentCpu@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_currentCpu
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 42
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 r8, 2
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at main.maxon:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
