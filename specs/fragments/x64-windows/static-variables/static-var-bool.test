// Test: static-var-bool
var initialized = false

function init()
	initialized = true
end 'init'

function main() returns ExitCode
	if initialized 'check1'
		return 1
	end 'check1'
	init()
	if initialized 'check2'
		return 42
	end 'check2'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __data_initialized@0 = i1 0
  __sched_tls_teb_offset@1 = i64 0
  __sched_allm@9 = i64 0
  __sched_lock@17 = i64 0
  __sched_preempt_ext_lock@25 = i64 0
  __sched_preempt_context@33 = i64 0
  __ds_base@41 = i64 0
  __dbg_ctl@49 = i64 0
  __mrt_console_probe_stdin@57 = i8 0
  __mrt_console_probe_stdout@58 = i8 0
  __mrt_console_probe_stderr@59 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_initialized
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body
  check1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_initialized
    x64.storeBaseDispReg.byte [rcx + 0], rax
  __il_cont:
    x64.leaRegGlobal rax, __data_initialized
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  check2:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
