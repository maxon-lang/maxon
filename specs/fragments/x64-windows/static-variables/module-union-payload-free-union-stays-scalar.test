// Test: module-union-payload-free-union-stays-scalar
union Mode
	off
	on
end 'Mode'

var mode = Mode.off

function seed()
	mode = Mode.on
end 'seed'

function main() returns ExitCode
	seed()
	return match mode 'm'
		off gives 0
		on gives 6
	end 'm'
end 'main'
---
ExitCode: 6
---
data {
  __data_mode@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_mode
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_cont:
    x64.leaRegGlobal rax, __data_mode
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 6
  __rc_ok:
    x64.popReg rbp
    x64.ret
  matchdead:
}
