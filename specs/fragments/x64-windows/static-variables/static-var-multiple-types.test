// Test: static-var-multiple-types
type TypeA
	static var value = 10
end 'TypeA'

type TypeB
	static var value = 20
end 'TypeB'

function main() returns ExitCode
	TypeA.value = TypeA.value + 2
	TypeB.value = TypeB.value + 10
	return TypeA.value + TypeB.value
end 'main'
---
ExitCode: 42
---
data {
  __data_TypeA.value@0 = i64 10
  __data_TypeB.value@8 = i64 20
  __sched_tls_teb_offset@16 = i64 0
  __sched_allm@24 = i64 0
  __sched_lock@32 = i64 0
  __sched_preempt_ext_lock@40 = i64 0
  __sched_preempt_context@48 = i64 0
  __ds_base@56 = i64 0
  __dbg_ctl@64 = i64 0
  __mrt_console_probe_stdin@72 = i8 0
  __mrt_console_probe_stdout@73 = i8 0
  __mrt_console_probe_stderr@74 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_TypeA.value
    x64.aluBaseDispImm32.add [rax + 0], 2
    x64.leaRegGlobal rax, __data_TypeB.value
    x64.aluBaseDispImm32.add [rax + 0], 10
    x64.leaRegGlobal rax, __data_TypeA.value
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegGlobal rcx, __data_TypeB.value
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at static-var-multiple-types.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
