// Test: data-section-i64-8byte
var counter = 42

function main() returns ExitCode
	return counter - 42
end 'main'
---
ExitCode: 0
---
data {
  __data_counter@0 = i64 42
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 r8, rax, -42
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at data-section-i64-8byte.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
