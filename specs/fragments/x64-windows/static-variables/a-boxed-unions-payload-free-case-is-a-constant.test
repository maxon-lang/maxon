// Test: a-boxed-unions-payload-free-case-is-a-constant
typealias Integer = int(i64.min to i64.max)

union Boxed
	plain
	withPayload(n Integer)
end 'Boxed'

let boxedCase = Boxed.plain

function main() returns ExitCode
	return match boxedCase 'k'
		plain gives 0
		withPayload(n) gives n as ExitCode
	end 'k'
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#7
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#10
  __rc_chk#11:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#10
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-boxed-unions-payload-free-case-is-a-constant.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-boxed-unions-payload-free-case-is-a-constant.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
