// Test: an-overload-a-let-initializer-does-not-call-may-read-a-managed-var
type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 7}
	end 'create'

	static function make() returns Self
		return Self{n: 1}
	end 'make'

	static function make(seed Integer) returns Self
		return Self{n: g.n + seed}
	end 'make'
end 'Box'

var g = Box.create()
let l = Box.make()

function main() returns ExitCode
	g.n = 9
	let m = Box.make(1)
	print("l={l.n} g={g.n} m={m.n}\n")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __data_g@0 = i64 0
  __data_l@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_console_probe_stdin@40 = i8 0
  __mrt_console_probe_stdout@41 = i8 0
  __mrt_console_probe_stderr@42 = i8 0
}

