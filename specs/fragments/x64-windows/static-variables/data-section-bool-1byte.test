// Test: data-section-bool-1byte
var flag = true

function main() returns ExitCode
	if flag 'read'
		return 0
	end 'read'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_flag@0 = i1 1
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
