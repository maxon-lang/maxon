    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, ifcont#2
  bad:
    x64.movRegImm32 rbx, 50
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rax, r8
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.storeBaseDispReg.word64 [rax + 8], rbx
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, ifcont#4
  worse:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rax, r8
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at try-block.or-arm-within-one-union-member-binds-its-payload.test:13: Range check failed: value outside typealias 'Score'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

