// Test: try-block.single-enum-success-path
typealias Score = int(0 to 100)

enum MyError implements Error
    failed
end 'MyError'

function maybeFail(x bool) returns Score throws MyError
    if x 'check'
        throw MyError.failed
    end 'check'
    return 7
end 'maybeFail'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = maybeFail(false)
        let b = maybeFail(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            failed then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 14
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @maybeFail {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 7
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect maybeFail
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryblkerr
  tryblkok#2:
    x64.movRegImm32 rcx, 0
    x64.callDirect maybeFail
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#3
  tryblkerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 r8, 99
    x64.jmp tryblkcont
  matchdead:
  tryblkok#3:
    x64.leaRegRegReg r8, rbx, r8
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at try-block.single-enum-success-path.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
