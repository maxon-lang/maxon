// Test: try-block.inline-managed-arg-throws
typealias Idx = int(0 to u64.max)
typealias IntArray = Array with Idx

enum MyError implements Error
    failed
end 'MyError'

function workFunc(arr IntArray) throws MyError
    if arr.count() == 0 'empty'
        throw MyError.failed
    end 'empty'
    arr.push(1)
end 'workFunc'

function main() returns ExitCode
    var sum = 0
    try 'work'
        workFunc(IntArray.create())
    end 'work' otherwise (e) 'h'
        match e 'k'
            failed then sum = 42
        end 'k'
    end 'h'
    return sum as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @workFunc {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont
  empty:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_push
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect workFunc
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, tryblkok
  tryblkthrow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  tryblkerr:
    x64.leaRegRegImm32 rax, r13, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 r8, 42
    x64.jmp __rc_ok
  matchdead:
  tryblkok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
  __rc_ok:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
