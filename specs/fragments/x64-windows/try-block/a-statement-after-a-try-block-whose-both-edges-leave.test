// Test: a-statement-after-a-try-block-whose-both-edges-leave
enum Failure implements Error
	bad
end 'Failure'

function main() returns ExitCode
	try 'work'
		throw Failure.bad
	end 'work' otherwise (e) 'handler'
		match e 'kind'
			bad then return 3
		end 'kind'
	end 'handler'

	return 0
end 'main'
---
ExitCode: 3
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}
