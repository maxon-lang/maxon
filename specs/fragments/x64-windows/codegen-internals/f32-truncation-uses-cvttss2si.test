// Test: f32-truncation-uses-cvttss2si
typealias F = float(f32.min to f32.max)

function main() returns ExitCode
	let a = 42.9 as F
	return trunc(a)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
