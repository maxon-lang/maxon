// Test: i32-unsigned-mod
typealias SmallInt = int(0 to 1000)

function main() returns ExitCode
	let a = 20 as SmallInt
	let b = 3 as SmallInt
	return a mod b
end 'main'
---
ExitCode: 2
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 20
    x64.movRegImm rax, 12297829382473034411
    x64.mulHighReg r8
    x64.shrRegImm8 rdx, rdx, 1
    x64.imulRegRegImm32 rax, rdx, 3
    x64.subRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at i32-unsigned-mod.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
