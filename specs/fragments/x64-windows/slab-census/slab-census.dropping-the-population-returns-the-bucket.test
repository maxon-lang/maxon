    x64.callDirect __slab_free_bytes
    x64.storeSlotReg slot1, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 rcx, 1
    x64.callDirect __slab_census_tally
    x64.movRegReg rbx, r8
    x64.callDirect __slab_live_bytes
    x64.cmpRegReg rbx, r8
    x64.jcc equal, ifcont#18
  theSecondTallysOwnWalkMissedTheLevel:
