    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#18:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r14, 0
    x64.jmp forhdr#19
  compare:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegReg r14, rax
    x64.jcc aboveEqual, __im_slow#40
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseIndexScale.word64 r15, [rax + r14*8 + 0]
  tryok:
    x64.movRegReg rcx, r14
    x64.callDirect __slab_census_count
    x64.subRegReg r15, r15, r8
    x64.cmpRegReg r15, rbx
