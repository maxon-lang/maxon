    x64.jcc less, __im_slow#43
  __im_bounds:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegReg r13, rax
    x64.jcc aboveEqual, __im_slow#43
  __im_buffer:
