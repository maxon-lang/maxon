// Test: slab-census.a-scavenge-lowers-committed-and-leaves-live-alone
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Seed = int(0 to 65536)

function build(seed Seed) returns ByteArray
	var b = ByteArray.create()
	b.reserve(96)
	for i in 0 upto 96 'fill'
		b.push(((seed + i) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var kept = Bufs.create()
	for k in 0 upto 200 'keep'
		kept.push(build(k as Seed))
	end 'keep'

	var bufs = Bufs.create()
	for k in 0 upto 16000 'alloc'
		bufs.push(build(k as Seed))
	end 'alloc'
	bufs = Bufs.create()

	let committedBefore = __Builtins.slabCommittedBytes()
	let parkedBefore = __Builtins.slabParkedBytes()
	let liveBefore = __Builtins.slabLiveBytes()

	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	if __Builtins.slabCommittedBytes() >= committedBefore 'nothingDecommitted'
		return 1
	end 'nothingDecommitted'

	if __Builtins.slabParkedBytes() >= parkedBefore 'parkedSpansSurvived'
		return 2
	end 'parkedSpansSurvived'

	if __Builtins.slabLiveBytes() != liveBefore 'theLiveSetMoved'
		return 3
	end 'theLiveSetMoved'

	if kept.count() != 200 'populationLost'
		return 4
	end 'populationLost'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#6
  __rc_chk#7:
    x64.cmpRegImm32 rbx, 65536
    x64.jcc greater, __rc_panic#6
  __rc_ok#5:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 96
  __rc_ok#17:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 96
    x64.jcc greaterEqual, __il_cont
  grow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont:
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  fill:
    x64.leaRegRegReg rcx, rbx, r13
    x64.movRegImm rax, 367465021388636487
    x64.mulHighReg rcx
    x64.movRegReg rax, rcx
    x64.subRegReg rax, rcx, rdx
    x64.shrRegImm8 rax, rax, 1
    x64.leaRegRegReg rax, rax, rdx
    x64.shrRegImm8 rax, rax, 7
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, rcx
    x64.subRegReg rdx, rcx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#9
  __rc_chk#10:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic#9
  __rc_ok#8:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
  forhdr:
    x64.cmpRegImm32 r13, 96
    x64.jcc less, fill
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at slab-census.a-scavenge-lowers-committed-and-leaves-live-alone.test:7: Range check failed: value outside typealias 'Seed'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at slab-census.a-scavenge-lowers-committed-and-leaves-live-alone.test:11: Range check failed: value outside typealias 'Byte'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

