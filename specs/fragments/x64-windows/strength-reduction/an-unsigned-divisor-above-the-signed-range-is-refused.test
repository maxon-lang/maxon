// Test: an-unsigned-divisor-above-the-signed-range-is-refused
typealias Unsigned = bits(64)
typealias UPosDivisor = int(2 to u64.max)

function refUDiv(n Unsigned, d UPosDivisor) returns Unsigned
	return try (n / (d as Unsigned)) otherwise panic("d is never zero")
end 'refUDiv'

function refUMod(n Unsigned, d UPosDivisor) returns Unsigned
	return try (n mod (d as Unsigned)) otherwise panic("d is never zero")
end 'refUMod'

function main() returns ExitCode
	let huge = ((9223372036854775807 as Unsigned) + (9223372036854775793 as Unsigned)) as Unsigned
	let a = ((9223372036854775807 as Unsigned) + 1000) as Unsigned
	if a / huge != refUDiv(a, d: huge as UPosDivisor) 'quotient'
		return 1
	end 'quotient'
	if a mod huge != refUMod(a, d: huge as UPosDivisor) 'remainder'
		return 2
	end 'remainder'
	if a / huge != 0 'quotientIsZero'
		return 3
	end 'quotientIsZero'
	if a mod huge != a 'remainderIsTheDividend'
		return 4
	end 'remainderIsTheDividend'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rcx, 18446744073709551600
    x64.movRegImm rsi, 9223372036854776807
    x64.movRegReg rax, rsi
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.movRegReg rdi, rax
  __rc_ok#19:
    x64.movRegImm r8, 18446744073709551600
    x64.movRegReg rax, rsi
    x64.movRegImm32 rdx, 0
    x64.divReg r8
  __il_cont#15:
    x64.cmpRegReg rdi, rax
    x64.jcc equal, ifcont#2
  quotient:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegReg rax, rsi
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.movRegReg rdi, rdx
  __rc_ok#26:
    x64.movRegImm rax, 9223372036854776807
    x64.movRegImm r8, 18446744073709551600
    x64.movRegImm32 rdx, 0
    x64.divReg r8
  __il_cont#22:
    x64.cmpRegReg rdi, rdx
    x64.jcc equal, ifcont#4
  remainder:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg rax, rsi
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#6
  quotientIsZero:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegReg rax, rsi
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.cmpRegReg rdx, rsi
    x64.jcc equal, ifcont#8
  remainderIsTheDividend:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
