// Test: the-refused-divisors-keep-their-answers
typealias Word = int(i64.min to i64.max)

function main() returns ExitCode
	let lo = i64.min as Word
	if lo mod -1 != 0 'minModMinusOne'
		return 1
	end 'minModMinusOne'
	if lo / 1 != lo 'divByOne'
		return 2
	end 'divByOne'
	if lo mod 1 != 0 'modByOne'
		return 3
	end 'modByOne'
	if lo / i64.min != 1 'minDividedByItself'
		return 4
	end 'minDividedByItself'
	if 7 / i64.min != 0 'smallDividedByMin'
		return 5
	end 'smallDividedByMin'
	if 7 mod i64.min != 7 'smallModMin'
		return 6
	end 'smallModMin'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rcx, 9223372036854775808
    x64.movRegImm rsi, 18446744073709551615
    x64.movRegImm32 rax, 0
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont#2
  minModMinusOne:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rsi, 1
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#4
  divByOne:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rsi, 1
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont#6
  modByOne:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm rsi, 9223372036854775808
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, ifcont#8
  minDividedByItself:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 rax, 7
    x64.movRegImm rcx, 9223372036854775808
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#10
  smallDividedByMin:
    x64.movRegImm32 r8, 5
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 rax, 7
    x64.movRegImm rcx, 9223372036854775808
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rdx, 7
    x64.jcc equal, ifcont#12
  smallModMin:
    x64.movRegImm32 r8, 6
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
