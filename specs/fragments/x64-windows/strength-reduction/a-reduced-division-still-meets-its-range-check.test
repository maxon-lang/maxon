// Test: a-reduced-division-still-meets-its-range-check
typealias Small = int(0 to 10)

function narrow(x Small) returns Small
	return x
end 'narrow'

function main() returns ExitCode
	var last = 0
	for i in 1000 to 1000 'once'
		last = narrow(i / 3)
	end 'once'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rcx, 1000
    x64.jmp forhdr
  once:
    x64.movRegImm rax, 6148914691236517206
    x64.imulHighReg rcx
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg r8, rdx, rax
  __il_body:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#11
  __rc_chk#12:
    x64.cmpRegImm32 r8, 10
    x64.jcc greater, __rc_panic#11
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
  forhdr:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc lessEqual, once
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#6
  __rc_chk#7:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#6
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#11:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-reduced-division-still-meets-its-range-check.test:4: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-reduced-division-still-meets-its-range-check.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
