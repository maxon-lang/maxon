    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, ifcont#7
  notCompleteOnArrival:
    x64.movRegImm32 rcx, 1
  ifcont#7:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, critsplit#17
  completeAfterTheDrive:
    x64.leaRegRegImm32 r12, rcx, 2
    x64.jmp ifcont#9
  critsplit#17:
    x64.movRegReg r12, rcx
  ifcont#9:
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.cmpRegImm32 r8, 42
    x64.jcc notEqual, critsplit#18
  stillAwaitable:
    x64.leaRegRegImm32 r8, r12, 4
    x64.jmp __rc_ok
  critsplit#18:
    x64.movRegReg r8, r12
  __rc_ok:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
