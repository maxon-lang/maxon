// Test: owned-struct-in-block
type Box
	export var v as Integer

	static function create(v Integer) returns Box
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var i = 0
	var seen = 0
	while i < 3 'loop'
		if i < 2 'b'
			let b = Box.create(i)
			seen = seen + b.v
		end 'b'
		i = i + 1
	end 'loop'
	return 0 if seen == 1 else 1
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  loop:
    x64.cmpRegImm32 rbx, 2
    x64.jcc greaterEqual, critsplit
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegReg r12, r12, rax
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rax, r12
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, r12
  ifcont:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg r12, rax
  whilehdr:
    x64.cmpRegImm32 rbx, 3
    x64.jcc less, loop
  whileexit:
    x64.cmpRegImm32 r12, 1
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 0
    x64.jmp __rc_ok
  ternaryfalse:
    x64.movRegImm32 r8, 1
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
