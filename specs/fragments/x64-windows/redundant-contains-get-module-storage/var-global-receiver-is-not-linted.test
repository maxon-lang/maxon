    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.leaRegFunc rdx, [rip + __clone_Map_String_String]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own_deep
    x64.storeSlotReg slot0, r8
    x64.leaRegRdata r13, [rip + __layout_Map_String_String]
    x64.leaRegRdata r14, [rip + __witness_String.Hashable]
    x64.leaRegRdata r15, [rip + __witness_String.Equatable]
  __il_body#7:
    x64.movRegReg rcx, rbx
    x64.callMem [r14 + 48]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r8
    x64.movRegReg r9, r13
    x64.movRegReg rsi, r14
    x64.movRegReg rdi, r15
    x64.callDirect Map.findSlot
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#8
  tryerr#9:
    x64.movRegImm32 r12, 0
    x64.jmp __il_cont#6
  tryok#8:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.movRegReg rax, r13
    x64.movRegReg r9, r14
    x64.movRegReg rsi, r15
    x64.callDirect Map.slotHoldsKey
    x64.movRegReg r12, r8
  __il_cont#6:
    x64.loadRegSlot rcx, slot0
    x64.callDirect __destruct_Map_String_String
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, ifcont
  has:
    x64.leaRegGlobal rax, __data_m
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.leaRegFunc rdx, [rip + __clone_Map_String_String]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own_deep
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __layout_Map_String_String]
    x64.leaRegRdata r9, [rip + __witness_String.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Map.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#2
  tryerr#3:
