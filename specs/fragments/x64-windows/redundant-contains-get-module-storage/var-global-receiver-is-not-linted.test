// Test: var-global-receiver-is-not-linted
typealias StrMap = Map with (String, String)

var m = StrMap.create()

function main() returns ExitCode
	let k = "a"
	if m.contains(k) 'has'
		print(try m.get(k) otherwise "?")
	end 'has'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_m@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
