// Test: managed-payload-escapes-through-the-receiver
union Record
	pass(specName String, testName String)
	fail(specName String, testName String, reason String)

	export function spec() returns String
		return match self 's'
			pass(s, _) gives s
			fail(s, _, _) gives s
		end 's'
	end 'spec'
end 'Record'

function main() returns ExitCode
	let r = Record.fail("the spec name, long enough to force a real heap allocation", testName: "the test name, also long enough to be heap allocated", reason: "the failure reason, likewise long enough for the heap")
	print(r.spec())
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "the spec name, long enough to force a real heap allocation"
    x64.leaRegRdata r12, [rip + __str_rec_4]  ; "the test name, also long enough to be heap allocated"
    x64.leaRegRdata r13, [rip + __str_rec_5]  ; "the failure reason, likewise long enough for the heap"
    x64.movRegImm32 rcx, 32
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 8], r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 16], r8
    x64.movRegReg rcx, r13
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 24], r8
  __il_body#3:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#4:
    x64.loadRegBaseDisp.word64 rbx, [r14 + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.jmp __il_body#9
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#5:
    x64.loadRegBaseDisp.word64 rbx, [r14 + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
  __il_body#9:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Record
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
