// Test: a-free-call-beside-a-case-named-while
enum Sib
	alpha
	while

	export function outer() returns Integer
		return helper() + 1
	end 'outer'
end 'Sib'

type Later
	export var n as Integer

	export function helper() returns Integer
		return 99
	end 'helper'
end 'Later'

function helper() returns Integer
	return 6
end 'helper'

function main() returns ExitCode
	let a = Sib.alpha
	return a.outer() as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 6
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
