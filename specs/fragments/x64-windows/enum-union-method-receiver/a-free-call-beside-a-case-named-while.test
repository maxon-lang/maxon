// Test: a-free-call-beside-a-case-named-while
enum Sib
	alpha
	while

	function outer() returns Integer
		return helper() + 1
	end 'outer'
end 'Sib'

type Later
	export var n as Integer

	function helper() returns Integer
		return 99
	end 'helper'
end 'Later'

function helper() returns Integer
	return 6
end 'helper'

function main() returns ExitCode
	let a = Sib.alpha
	return a.outer() as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 6
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
