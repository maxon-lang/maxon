// Test: a-directive-inside-a-method-body
enum Plat
	alpha

	function tag() returns Integer
#if testing(true)
		return 3
#else
		return 7
#endif
	end 'tag'

	omega
end 'Plat'

function main() returns ExitCode
	let p = Plat.omega
	match p 'k'
		alpha then return 1
		omega then return p.tag() as ExitCode
	end 'k'
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
