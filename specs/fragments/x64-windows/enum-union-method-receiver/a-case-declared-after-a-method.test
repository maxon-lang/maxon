// Test: a-case-declared-after-a-method
enum Order
	alpha

	function bump() returns Integer
		return 1
	end 'bump'

	omega
end 'Order'

function tagOf(k Order) returns Integer
	return match k 'w'
		alpha gives 1
		omega gives 5
	end 'w'
end 'tagOf'

function main() returns ExitCode
	let e = Order.omega
	return tagOf(e) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 5
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
