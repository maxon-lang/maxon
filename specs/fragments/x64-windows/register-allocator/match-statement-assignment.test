// Test: match-statement-assignment
function main() returns ExitCode
	let x = 2
	var result = 0
	match x 'process'
		1 then result = 100
		2 then result = 200
		default then result = 0
	end 'process'
	return result and 125
end 'main'
---
ExitCode: 72
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 rax, 200
  matchcont:
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 125
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
