// Test: int-parallel-accumulation
function main() returns ExitCode
	var sum1 = 0
	var sum2 = 0
	var sum3 = 0
	sum1 = sum1 + 10
	sum2 = sum2 + 20
	sum3 = sum3 + 30
	sum1 = sum1 + 5
	sum2 = sum2 + 10
	sum3 = sum3 + 15
	return sum1 + sum2 + sum3
end 'main'
---
ExitCode: 90
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 90
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
