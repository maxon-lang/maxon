// Test: phi-merge-split-multi-anchor
function main() returns ExitCode
	var a = 0
	var b = 0
	var c = 0
	var d = 0
	if 1 < 2 'g1'
		a = 1
		b = 2
		c = 3
		d = 4
	end 'g1' else 'g1e'
		a = 10
		b = 20
		c = 30
		d = 40
	end 'g1e'
	if a > 0 'g2'
		a = a + 100
		c = c + 100
	end 'g2' else 'g2e'
		b = b + 100
		d = d + 100
	end 'g2e'
	if b > 0 'g3'
		a = a + b
		c = c + d
	end 'g3' else 'g3e'
		b = a - 1
		d = c - 1
	end 'g3e'
	return (a + b + c + d) and 125
end 'main'
---
ExitCode: 88
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  g1:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rsi, 4
  g2:
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegRegImm32 rdx, rdx, 100
  g3:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rdx, rdx, rsi
  ifcont:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg r8, rax, rsi
    x64.andRegImm32 r8, r8, 125
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
