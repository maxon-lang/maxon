// Test: int-division-high-pressure
function main() returns ExitCode
	let a = 10
	let b = 20
	let c = 30
	let d = 40
	let e = 50
	let f = 60
	let g = 70
	let h = 2
	return ((a + b + c + d + e + f + g) / h) and 125
end 'main'
---
ExitCode: 12
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 280
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 rax, rax, 280
    x64.sarRegImm8 rax, rax, 1
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 125
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
