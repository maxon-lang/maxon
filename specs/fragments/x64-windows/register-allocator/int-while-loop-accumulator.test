// Test: int-while-loop-accumulator
function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 10 'loop'
		sum = sum + i
		i = i + 1
	end 'loop'
	return sum mod 256
end 'main'
---
ExitCode: 45
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  whilehdr:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greaterEqual, whileexit
  loop:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, rax
    x64.sarRegImm8 rcx, rax, 63
    x64.shrRegImm8 rcx, rcx, 56
    x64.leaRegRegReg rcx, rax, rcx
    x64.sarRegImm8 rcx, rcx, 8
    x64.imulRegRegImm32 rcx, rcx, 256
    x64.movRegReg r8, rax
    x64.subRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at int-while-loop-accumulator.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
