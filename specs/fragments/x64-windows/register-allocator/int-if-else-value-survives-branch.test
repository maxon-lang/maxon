// Test: int-if-else-value-survives-branch
function main() returns ExitCode
	let base = 40
	let cond = 1
	var extra = 0
	if cond == 1 'check'
		extra = 2
	end 'check' else 'other'
		extra = 100
	end 'other'
	return base + extra
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 rax, 2
  ifcont:
    x64.leaRegRegImm32 r8, rax, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
