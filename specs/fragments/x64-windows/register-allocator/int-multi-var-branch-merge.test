// Test: int-multi-var-branch-merge
function main() returns ExitCode
	var x = 0
	var y = 0
	var z = 0
	if 1 < 2 'branch'
		x = 10
		y = 20
		z = 12
	end 'branch' else 'other'
		x = 1
		y = 2
		z = 3
	end 'other'
	return x + y + z
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  branch:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 12
  ifcont:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rdx
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
