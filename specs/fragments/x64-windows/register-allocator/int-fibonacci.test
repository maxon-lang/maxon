// Test: int-fibonacci
function main() returns ExitCode
	var a = 0
	var b = 1
	var i = 0
	while i < 13 'loop'
		let temp = a + b
		a = b
		b = temp
		i = i + 1
	end 'loop'
	return a and 125
end 'main'
---
ExitCode: 105
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.jmp whilehdr
  loop:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.xchgRegReg rax, rcx
  whilehdr:
    x64.cmpRegImm32 rdx, 13
    x64.jcc less, loop
  whileexit:
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 125
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
