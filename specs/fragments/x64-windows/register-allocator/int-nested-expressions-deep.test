// Test: int-nested-expressions-deep
function main() returns ExitCode
	return ((((1 + 2) * 3) + 4) * 2) + 6
end 'main'
---
ExitCode: 32
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 32
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
