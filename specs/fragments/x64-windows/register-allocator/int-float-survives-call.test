// Test: int-float-survives-call

typealias Integer = int(i64.min to i64.max)

function getInt() returns Integer
	return 40
end 'getInt'

function main() returns ExitCode
	let f = 3.14
	let x = getInt()
	return trunc(f) + x
end 'main'
---
ExitCode: 43
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.movRegImm32 rax, 3
    x64.leaRegRegImm32 r8, rax, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
