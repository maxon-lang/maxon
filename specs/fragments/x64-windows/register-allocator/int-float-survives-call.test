// Test: int-float-survives-call

typealias Integer = int(i64.min to i64.max)

function getInt() returns Integer
	return 40
end 'getInt'

function main() returns ExitCode
	let f = 3.14
	let x = getInt()
	return trunc(f) + x
end 'main'
