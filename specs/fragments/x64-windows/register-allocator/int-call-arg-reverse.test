  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm rax, 18446744073709551609
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 45
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
