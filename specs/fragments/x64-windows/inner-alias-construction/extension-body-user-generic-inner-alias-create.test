// Test: extension-body-user-generic-inner-alias-create
typealias ExitCode = int(0 to 125)

type Wrapped uses T
	let value as T

	export static function create(value T) returns Self
		return Self{value: value}
	end 'create'

	export function get() returns T
		return value
	end 'get'
end 'Wrapped'

interface Tagged uses Tag
	function tag() returns Tag
end 'Tagged'

export extension Tagged
	typealias WrappedTag = Wrapped with Tag

	export function wrapped() returns WrappedTag
		return WrappedTag.create(self.tag())
	end 'wrapped'
end 'Tagged'

type Box implements Tagged with ExitCode
	export var v as ExitCode

	export static function create() returns Self
		return Self{v: 5}
	end 'create'

	export function tag() returns ExitCode
		return self.v
	end 'tag'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.wrapped().get()
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
  __il_body#3:
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#9:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
  __il_body#10:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#5:
    x64.leaRegRdata rcx, [rip + __layout_Wrapped_ExitCode$0_125]
  __il_body#4:
    x64.loadRegBaseDisp.word64 rdx, [r13 + 0]
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
  __il_cont#1:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
