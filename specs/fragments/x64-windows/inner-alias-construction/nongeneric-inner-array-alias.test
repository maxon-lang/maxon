// Test: nongeneric-inner-array-alias
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Plain
	typealias Nums = Array with ExitCode

	static function make() returns Count
		var n = Nums{}
		n.resize(4)
		return n.count()
	end 'make'
end 'Plain'

function main() returns ExitCode
	let c = Plain.make()
	if c == 4 'ok'
		return 4
	end 'ok'
	return 1
end 'main'
---
ExitCode: 4
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont:
    x64.cmpRegImm32 r12, 4
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 4
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
