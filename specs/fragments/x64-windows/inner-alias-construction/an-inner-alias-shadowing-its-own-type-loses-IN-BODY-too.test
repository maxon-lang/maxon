// Test: an-inner-alias-shadowing-its-own-type-loses-IN-BODY-too
typealias ExitCode = int(0 to 125)

type Pair uses T
	export var a as T

	static function create(a T) returns Self
		return Self{a: a}
	end 'create'
end 'Pair'

type Holder
	typealias Holder = Pair with ExitCode

	export var seed as ExitCode

	static function create() returns Holder
		return Self{seed: 4}
	end 'create'

	static function probe() returns ExitCode
		let h = Holder.create()
		return h.seed
	end 'probe'
end 'Holder'

function main() returns ExitCode
	return Holder.probe()
end 'main'
---
ExitCode: 4
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.movRegImm32 rbx, 4
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#3:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  __il_cont#1:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
