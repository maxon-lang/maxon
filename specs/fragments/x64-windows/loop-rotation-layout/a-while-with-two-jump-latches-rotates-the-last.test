// Test: a-while-with-two-jump-latches-rotates-the-last
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function weightedSum(a WordArray, n Word) returns Word
	var t = 0
	var i = 0
	while i < n 'each'
		let v = try a.get(i) otherwise panic("weightedSum: i < n = a.count()")
		i = i + 1
		if v mod 2 == 0 'even'
			t = t + 10
			continue
		end 'even'
		t = t + v
	end 'each'
	return t
end 'weightedSum'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 1 to 8 'seed'
		a.push(i)
	end 'seed'
	return weightedSum(a, n: 8)
end 'main'
---
ExitCode: 56
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
    x64.jmp forhdr
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr:
    x64.cmpRegImm32 r12, 8
    x64.jcc lessEqual, seed
  __il_body:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rdx, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.jmp whilehdr
  __rc_ok#17:
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseIndexScale.word64 rsi, [rcx + rdx*8 + 0]
    x64.movRegReg r8, rsi
  tryok:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.movRegReg rsi, r8
    x64.sarRegImm8 rsi, r8, 63
    x64.shrRegImm8 rsi, rsi, 63
    x64.leaRegRegReg rsi, r8, rsi
    x64.sarRegImm8 rsi, rsi, 1
    x64.imulRegRegImm32 rsi, rsi, 2
    x64.movRegReg rdi, r8
    x64.subRegReg rdi, r8, rsi
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, ifcont
  even:
    x64.leaRegRegImm32 r12, r12, 10
    x64.jmp whilehdr
  ifcont:
    x64.leaRegRegReg r12, r12, r8
  whilehdr:
    x64.cmpRegImm32 rdx, 8
    x64.jcc less, __rc_ok#17
  __il_cont:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
  __rc_ok#5:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-while-with-two-jump-latches-rotates-the-last.test:9: weightedSum: i < n = a.count()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-while-with-two-jump-latches-rotates-the-last.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
