// Test: range-alias-bounds-scale-too
typealias Astronomical = float(1.0e-30 to 1.0e30)

function main() returns ExitCode
	let x = 1.0e20 as Astronomical
	let y = 1.0e19 as Astronomical
	return trunc(x / y)
end 'main'
---
ExitCode: 10
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 10
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
