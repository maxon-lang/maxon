// Test: subnormals
function main() returns ExitCode
	var r = 0
	if 1.0e-310 > 0.0 'e310IsPositive'
		r = r + 1
	end 'e310IsPositive'
	if 1.0e-320 > 0.0 'e320IsPositive'
		r = r + 2
	end 'e320IsPositive'
	if 1.0e-310 > 1.0e-320 'ordered'
		r = r + 4
	end 'ordered'
	return r
end 'main'
---
ExitCode: 7
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  e310IsPositive:
    x64.movRegImm32 rax, 1
  e320IsPositive:
    x64.leaRegRegImm32 rax, rax, 2
  ordered:
    x64.leaRegRegImm32 r8, rax, 4
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
