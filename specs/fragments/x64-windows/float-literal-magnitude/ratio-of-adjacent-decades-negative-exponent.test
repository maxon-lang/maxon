// Test: ratio-of-adjacent-decades-negative-exponent
function main() returns ExitCode
	let a = 1.0e-30
	let b = 1.0e-31
	return trunc(a / b)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 10
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
