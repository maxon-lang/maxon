// Test: underflow-to-zero-is-not-an-error
function main() returns ExitCode
	if 1.0e-400 == 0.0 'roundsToZero'
		return 1
	end 'roundsToZero'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  roundsToZero:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
