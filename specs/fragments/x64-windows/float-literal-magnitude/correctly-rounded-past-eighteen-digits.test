// Test: correctly-rounded-past-eighteen-digits
function main() returns ExitCode
	var r = 0
	if 7.46658662666203984963311900685e13 == 74665866266620.4 'thirtyDigits'
		r = r + 1
	end 'thirtyDigits'
	if 2.3744998132743940991053240e-19 == 2.3744998132743943e-19 'twentyFiveDigits'
		r = r + 2
	end 'twentyFiveDigits'
	if 2.755371525302782724e-4 == 0.0002755371525302783 'nineteenDigits'
		r = r + 4
	end 'nineteenDigits'
	if 3.14159265358979323846 == 3.141592653589793 'piAsWrittenInTheTree'
		r = r + 8
	end 'piAsWrittenInTheTree'
	if 2.71828182845904523536 == 2.718281828459045 'eAsWrittenInTheTree'
		r = r + 16
	end 'eAsWrittenInTheTree'
	return r
end 'main'
---
ExitCode: 31
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  thirtyDigits:
    x64.movRegImm32 rax, 1
  twentyFiveDigits:
    x64.leaRegRegImm32 rax, rax, 2
  nineteenDigits:
    x64.leaRegRegImm32 rax, rax, 4
  piAsWrittenInTheTree:
    x64.leaRegRegImm32 rax, rax, 8
  eAsWrittenInTheTree:
    x64.leaRegRegImm32 r8, rax, 16
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at correctly-rounded-past-eighteen-digits.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
