// Test: while-loops.sequential-loops-across-a-call
function work(x Integer) returns Integer
	return x + 1
end 'work'

function big(n Integer) returns Integer
	var total = 0
	var a = 1
	var i0 = 0
	while i0 < n 'L0'
		let r = work(i0)
		a = a + r
		i0 = i0 + 1
	end 'L0'
	total = total + a
	var b = 1
	var i1 = 0
	while i1 < n 'L1'
		let s = work(i1)
		b = b + s
		i1 = i1 + 1
	end 'L1'
	total = total + b
	return total
end 'big'

function main() returns ExitCode
	return big(3)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 14
