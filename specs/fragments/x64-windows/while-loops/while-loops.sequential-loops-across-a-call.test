    x64.jcc less, __il_body#13
  whileexit#8:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.jmp whilehdr#9
  __il_body#15:
    x64.leaRegRegImm32 rdx, rdx, 1
  __il_cont#14:
