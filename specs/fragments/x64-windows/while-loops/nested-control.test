// Test: nested-control
function main() returns ExitCode
	var result = 0
	var i = 0
	while i < 3 'outer'
		var j = 0
		while j < 3 'inner'
			if (i + j) mod 2 == 0 'even'
				result = result + 1
			end 'even'
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return result
end 'main'
---
ExitCode: 5
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr#1
  outer:
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr#4
  inner:
    x64.leaRegRegReg rdx, rax, rcx
    x64.movRegReg rsi, rdx
    x64.sarRegImm8 rsi, rdx, 63
    x64.shrRegImm8 rsi, rsi, 63
    x64.leaRegRegReg rsi, rdx, rsi
    x64.sarRegImm8 rsi, rsi, 1
    x64.imulRegRegImm32 rsi, rsi, 2
    x64.subRegReg rdx, rdx, rsi
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, critsplit
  even:
    x64.leaRegRegImm32 rdx, r8, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rdx, r8
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.movRegReg r8, rdx
  whilehdr#4:
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, inner
  whileexit#6:
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr#1:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, outer
  whileexit#3:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at nested-control.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
