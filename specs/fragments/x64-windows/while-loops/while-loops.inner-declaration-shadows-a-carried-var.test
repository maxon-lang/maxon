// Test: while-loops.inner-declaration-shadows-a-carried-var
function main() returns ExitCode
	var t = 0
	t = 100
	var i = 0
	while i < 3 'l'
		var t = 0
		t = i + 1
		i = i + t
	end 'l'
	return t
end 'main'
---
ExitCode: 100
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 100
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  l:
    x64.leaRegRegImm32 rcx, rax, 1
    x64.leaRegRegReg rax, rax, rcx
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, l
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
