// Test: an-unemitted-lookalike-name-is-legal
typealias Integer = int(i64.min to i64.max)

function mrt_not_a_chunk() returns Integer
	return 7
end 'mrt_not_a_chunk'

function main() returns ExitCode
	let emitted = mrt_not_a_chunk
	return emitted() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @mrt_not_a_chunk {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_mrt_not_a_chunk]
    x64.movRegImm32 rcx, 0
    x64.callReg rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-unemitted-lookalike-name-is-legal.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
