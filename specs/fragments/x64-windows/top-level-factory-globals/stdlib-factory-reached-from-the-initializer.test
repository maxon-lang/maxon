// Test: stdlib-factory-reached-from-the-initializer
var sep = FilePath.separator()

function main() returns ExitCode
	return sep.byteLength() as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __data_sep@0 = i64 0
  __data_CharacterSet.cachedWhitespacesAndNewlines@8 = i64 0
  __sched_tls_teb_offset@16 = i64 0
  __sched_allm@24 = i64 0
  __sched_lock@32 = i64 0
  __sched_preempt_ext_lock@40 = i64 0
  __sched_preempt_context@48 = i64 0
  __slab_arena_list@56 = i64 0
  __slab_arena_map_l1@64 = i64 0
  __slab_state@72 = i64 0
  __ds_base@80 = i64 0
  __dbg_ctl@88 = i64 0
  __mrt_console_probe_stdin@96 = i8 0
  __mrt_console_probe_stdout@97 = i8 0
  __mrt_console_probe_stderr@98 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegGlobal rax, __data_sep
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
  __il_body:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_85]  ; "panic at stdlib-factory-reached-from-the-initializer.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
