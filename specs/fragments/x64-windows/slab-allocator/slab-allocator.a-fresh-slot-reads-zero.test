    x64.cmpRegImm32 rax, 0
    x64.jcc less, forhdr#13
  __us_test#73:
    x64.loadRegBaseDisp.word64 r15, [r12 + 8]
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.storeSlotReg slot4, rax
    x64.loadRegSlot rax, slot4
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, forhdr#13
  __us_test#74:
    x64.loadRegSlot rax, slot4
