// Test: clock.now-unix-nanos-has-sub-second-resolution
function main() returns ExitCode
	for _ in 0 upto 1000 'eachReading'
		let nanos = WallClock.nowUnixNanos()

		if nanos mod 1_000_000 != 0 'subMillisecond'
			print("ok\n")
			return 0
		end 'subMillisecond'
	end 'eachReading'

	print("every reading was a whole millisecond\n")
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr
  __il_body:
    x64.callDirect __clock_now_unix_ns
  __il_cont:
    x64.movRegImm rax, 4835703278458516699
    x64.imulHighReg r8
    x64.sarRegImm8 rdx, rdx, 18
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 1000000
    x64.subRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, forstep
  subMillisecond:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "ok\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
  forhdr:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc less, __il_body
  forexit:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "every reading was a whole millisecond\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
