// Test: clock.wall-clock-advances
function main() returns ExitCode
		let before = WallClock.nowUnixSeconds()
		sleep(1100)
		let after = WallClock.nowUnixSeconds()
		var ok = 0
		if after >= before + 1 'advanced'
				ok = 1
		end 'advanced'
		print("ok={ok}\n")
		return 0
end 'main'
