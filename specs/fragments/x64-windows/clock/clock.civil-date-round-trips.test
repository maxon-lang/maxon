// Test: clock.civil-date-round-trips
function show(days UnixDays)
	let date = CivilDate.fromDays(days)
	print("{days}: {date.year}-{date.month}-{date.day} -> {date.days()}\n")
end 'show'

function main() returns ExitCode
	show(0)
	show(11016)
	show(19782)
	show(-1)
	show(-719162)
	return 0
end 'main'
