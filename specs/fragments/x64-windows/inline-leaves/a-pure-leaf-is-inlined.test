// Test: a-pure-leaf-is-inlined
typealias RegNum = int(0 to 63)
typealias RegMask = int(0 to u64.max)

function maskContains(mask RegMask, regNum RegNum) returns bool
	return ((mask shr regNum) and 1) != 0
end 'maskContains'

function main() returns ExitCode
	let mask = 5 as RegMask
	var count = 0
	var i = 0
	while i < 8 'each'
		if maskContains(mask, regNum: i as RegNum) 'set'
			count = count + 1
		end 'set'
		i = i + 1
	end 'each'
	return count as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 5
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.cmpRegImm32 rdx, 8
    x64.jcc greaterEqual, whileexit
  __rc_ok#15:
    x64.movRegReg rcx, rdx
    x64.movRegReg rsi, rax
    x64.shrRegCl rsi, rax
    x64.andRegImm32 rsi, rsi, 1
    x64.cmpRegImm32 rsi, 0
    x64.setccReg notEqual, rsi
  __il_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit
  set:
    x64.leaRegRegImm32 rcx, r8, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rcx, r8
  ifcont:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.movRegReg r8, rcx
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#9
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-pure-leaf-is-inlined.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
