// Test: the-inlined-guard-still-panics-with-the-callees-frame
typealias Percent = int(0 to 100)

function clampPct(x Percent) returns Percent
	return x
end 'clampPct'

function main() returns ExitCode
	var last = 0
	for i in 1 to 1 'once'
		last = clampPct(i * 101)
	end 'once'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
    x64.jmp forhdr
  once:
    x64.imulRegRegImm32 rcx, rax, 101
    x64.jmp __rc_panic
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, once
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.storeSlotReg slot0, rax
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at the-inlined-guard-still-panics-with-the-callees-frame.test:4: Range check failed: value outside typealias 'Percent'\x0a"
    x64.callDirect mrt_panic
    x64.loadRegSlot rax, slot0
    x64.movRegImm32 r8, 0
    x64.jmp forstep
}
