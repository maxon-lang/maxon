// Test: the-inlined-guard-still-panics-with-the-callees-frame
typealias Percent = int(0 to 100)

function clampPct(x Percent) returns Percent
	return x
end 'clampPct'

function main() returns ExitCode
	var last = 0
	for i in 1 to 1 'once'
		last = clampPct(i * 101)
	end 'once'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
  once:
    x64.imulRegRegImm32 rax, rax, 101
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at the-inlined-guard-still-panics-with-the-callees-frame.test:4: Range check failed: value outside typealias 'Percent'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
