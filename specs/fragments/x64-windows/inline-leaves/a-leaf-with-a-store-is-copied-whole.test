// Test: a-leaf-with-a-store-is-copied-whole
typealias Integer = int(i64.min to i64.max)

type Minter
	export var next as Integer

	export static function create() returns Self
		return Self{next: 0}
	end 'create'

	export function mint() returns Integer
		let id = self.next
		self.next = self.next + 1
		return id
	end 'mint'
end 'Minter'

function main() returns ExitCode
	var m = Minter.create()
	let a = m.mint()
	let b = m.mint()
	let c = m.mint()
	return (a + b + c + 39) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#5:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#9:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rcx
  __il_body#10:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rdx
  __il_body#11:
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.loadRegBaseDisp.word64 rsi, [r8 + 0]
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rsi
  __il_cont:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegImm32 rbx, rax, 39
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-leaf-with-a-store-is-copied-whole.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
