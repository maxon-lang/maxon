// Test: two-returns
typealias Integer = int(i64.min to i64.max)

function pick(a Integer) returns Integer
	if a > 10 'big'
		return 4
	end 'big'
	return 2
end 'pick'

function main() returns ExitCode
	return (pick(50) * 10 + pick(1)) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  big:
    x64.movRegImm32 rax, 4
  __il_cont#5:
    x64.imulRegRegImm32 rax, rax, 10
  ifcont:
    x64.movRegImm32 rcx, 2
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
