// Test: an-identity-leaf-returns-its-argument
typealias Integer = int(i64.min to i64.max)

function identity(a Integer) returns Integer
	return a
end 'identity'

function main() returns ExitCode
	return identity(42) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
