// Test: an-out-of-bounds-fallback-keeps-the-fast-loop-going
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function walk(a WordArray, n Word) returns Word
	var t = 0
	for i in 0 upto n 'each'
		t = t + (try a.get(i) otherwise 99)
		try a.set(i, value: i * 2) otherwise ignore
	end 'each'
	return t
end 'walk'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 5 'seed'
		a.push(i)
	end 'seed'
	if walk(a, n: 9) != 406 'sum'
		return 1
	end 'sum'
	var seen = 0
	for v in a 'check'
		seen = seen + v
	end 'check'
	if seen != 20 'rewritten'
		return 2
	end 'rewritten'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @walk {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 80
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rsi, 0
  __us_test#44:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rcx + 16]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, forhdr#1
  __us_test#45:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, forhdr#1
  __us_test#46:
    x64.leaRegRegImm32 r9, r8, -24
    x64.loadRegBaseDisp.word64 r9, [r9 + 16]
    x64.cmpRegImm32 r9, 0
    x64.jcc notEqual, forhdr#1
    x64.jmp forhdr#24
  __rc_ok#11:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow#16
    x64.jmp __im_load#17
  tryerr#6:
    x64.movRegImm32 rdi, 99
    x64.jmp trycont#7
  __im_load#17:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 rdi, [rdi + rsi*8 + 0]
    x64.movRegReg r8, rdi
  tryok:
    x64.movRegReg rdi, r8
  trycont#7:
    x64.leaRegRegReg rax, rax, rdi
    x64.imulRegRegImm32 rdi, rsi, 2
  __rc_ok#13:
    x64.loadRegBaseDisp.word64 r8, [rcx + 16]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __im_slow#19
  __im_bounds#20:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.cmpRegReg rsi, r8
    x64.jcc aboveEqual, __im_slow#19
  __im_buffer:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, __im_slow#19
  __im_viewed:
    x64.leaRegRegImm32 r9, r8, -24
    x64.loadRegBaseDisp.word64 r9, [r9 + 16]
    x64.cmpRegImm32 r9, 0
    x64.jcc notEqual, __im_slow#19
  __im_store#23:
    x64.storeBaseIndexScaleReg.word64 [r8 + rsi*8 + 0], rdi
  forstep#3:
    x64.leaRegRegImm32 rsi, rsi, 1
  forhdr#1:
    x64.cmpRegReg rsi, rdx
    x64.jcc less, __rc_ok#11
  critsplit#48:
    x64.movRegReg r8, rax
    x64.jmp forexit
  __rc_ok#38:
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow#37
    x64.jmp __im_load#41
  tryerr#36:
    x64.movRegImm32 r9, 99
    x64.jmp trycont#34
  __im_load#41:
    x64.loadRegBaseIndexScale.word64 r9, [r8 + rsi*8 + 0]
  trycont#34:
    x64.leaRegRegReg rax, rax, r9
    x64.imulRegRegImm32 r9, rsi, 2
  __im_bounds#31:
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow#29
  __im_store#43:
    x64.storeBaseIndexScaleReg.word64 [r8 + rsi*8 + 0], r9
  forstep#25:
    x64.leaRegRegImm32 rsi, rsi, 1
  forhdr#24:
    x64.cmpRegReg rsi, rdx
    x64.jcc less, __rc_ok#38
  critsplit#51:
    x64.movRegReg r8, rax
  forexit:
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
  __im_slow#16:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok
  __im_slow#19:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.movRegReg rdx, rsi
    x64.movRegReg rax, rdi
    x64.callDirect __managed_set
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forstep#3
    x64.jmp forstep#3
  __im_slow#37:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#36
    x64.jmp trycont#34
  __im_slow#29:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rdx, rsi
    x64.movRegReg rax, r9
    x64.callDirect __managed_set
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forstep#25
    x64.jmp forstep#25
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 5
    x64.jcc less, seed
  forexit#4:
    x64.movRegImm32 rdx, 9
    x64.movRegReg rcx, rbx
    x64.callDirect walk
    x64.cmpRegImm32 r8, 406
    x64.jcc equal, ifcont#6
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
    x64.jmp forhdr#7
  check:
    x64.loadRegBaseIndexScale.word64 rdi, [rsi + rcx*8 + 0]
  __im_cont:
    x64.leaRegRegReg rax, rax, rdi
  forstep#9:
    x64.leaRegRegImm32 rcx, rcx, 1
  forhdr#7:
    x64.cmpRegReg rcx, rdx
    x64.jcc less, check
  forexit#10:
    x64.cmpRegImm32 rax, 20
    x64.jcc equal, ifcont#12
  rewritten:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
