// Test: witness-throws.success-edge-through-witness
typealias Code = int(0 to u32.max)

enum DigestError implements Error
	tooSmall
end 'DigestError'

interface Digest
	function digest() returns Code throws DigestError
end 'Digest'

type Point implements Digest
	export var x as Code
	export static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'
	export function digest() returns Code throws DigestError
		if self.x < 10 'small'
			throw DigestError.tooSmall
		end 'small'
		return self.x
	end 'digest'
end 'Point'

type Box uses T where T is Digest
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function itemDigest() returns Code throws DigestError
		return try self.item.digest()
	end 'itemDigest'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let p = Point.create(42)
	let b = PointBox.create(p)
	let v = try b.itemDigest() otherwise 55
	return v
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @Point.digest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 10
    x64.jcc greaterEqual, ifcont
  small:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @Box.itemDigest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rdx + 40]
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 42
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Point.Digest]
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#4:
    x64.leaRegRdata rdx, [rip + __witness_Point.Digest]
    x64.movRegReg rcx, r13
    x64.callDirect Box.itemDigest
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rbx, 55
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
  trycont:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Point
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
