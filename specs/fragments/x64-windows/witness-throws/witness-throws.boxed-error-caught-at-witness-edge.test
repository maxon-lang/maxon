// Test: witness-throws.boxed-error-caught-at-witness-edge
typealias Code = int(0 to u32.max)

union CheckError implements Error
	tooSmall(limit Code)
end 'CheckError'

interface Checked
	function check() returns Code throws CheckError
end 'Checked'

type Point implements Checked
	export var x as Code
	export static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'
	export function check() returns Code throws CheckError
		if self.x < 10 'small'
			throw CheckError.tooSmall(7)
		end 'small'
		return self.x
	end 'check'
end 'Point'

type Box uses T where T is Checked
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function itemCheck() returns Code
		var out = 1 as Code
		try self.item.check() otherwise (e) 'caught'
			match e 'k'
				tooSmall(limit) then out = limit + 1
			end 'k'
		end 'caught'
		return out
	end 'itemCheck'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let b = PointBox.create(Point.create(3))
	return b.itemCheck()
end 'main'
---
ExitCode: 8
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @Point.check {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 10
    x64.jcc greaterEqual, ifcont
  small:
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rax, r8
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.storeBaseDispReg.word64 [rax + 8], rbx
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 3
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#3:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Point.Checked]
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#2:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __witness_Point.Checked]
  __il_body#9:
    x64.movRegImm32 rbx, 1
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callMem [rax + 24]
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.loadRegBaseDisp.word64 rax, [r10 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead
  matcharm:
    x64.loadRegBaseDisp.word64 rax, [r10 + 8]
    x64.leaRegRegImm32 rbx, rax, 1
  matchcont:
    x64.movRegReg rcx, r10
    x64.callDirect __mm_decref
    x64.jmp trycont
  matchdead:
  tryok:
  trycont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __il_cont#1:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Point
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at witness-throws.boxed-error-caught-at-witness-edge.test:37: Range check failed: value outside typealias 'Code'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
