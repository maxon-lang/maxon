    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
    x64.movRegReg rsi, rbx
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, matcharm
  loop:
    x64.loadRegBaseIndexScale.word64 rdi, [rdx + rax*8 + 0]
  __im_cont:
    x64.leaRegRegReg rsi, rsi, rdi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  matcharm:
    x64.movRegImm32 rax, 20
  __il_cont:
    x64.leaRegRegReg rbx, rsi, rax
  ifcont:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at test-stays-an-ordinary-identifier.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
