// Test: slab-scavenger.an-os-direct-mapping-is-not-a-span
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var big = ByteArray.create()
	big.reserve(300000)
	for i in 0 upto 512 'fill'
		big.push((i mod 251) as Byte)
	end 'fill'

	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	var bad = 0
	for i in 0 upto 512 'check'
		let got = try big.get(i) otherwise return 1
		if got != (i mod 251) 'value'
			bad = bad + 1
		end 'value'
	end 'check'
	if bad != 0 'corrupted'
		return 2
	end 'corrupted'

	big = ByteArray.create()
	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 300000
  __rc_ok#32:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_capacity
    x64.cmpRegImm32 r8, 300000
    x64.jcc greaterEqual, __il_cont
  grow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_cont
  tryerr#30:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at Array.maxon:418: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_cont:
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  fill:
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg r12
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, r12
    x64.subRegReg rdx, r12, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
  __rc_ok#15:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 512
    x64.jcc less, fill
  forexit#4:
    x64.callDirect __slab_scavenge
    x64.callDirect __slab_scavenge
    x64.movRegImm32 rax, 0
    x64.movRegImm32 r12, 0
  __us_test:
    x64.loadRegBaseDisp.word64 r13, [rbx + 24]
    x64.loadRegBaseDisp.word64 r14, [rbx + 8]
    x64.loadRegBaseDisp.word64 r15, [rbx + 0]
    x64.jmp forhdr#5
  check:
    x64.cmpRegImm32 r13, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.cmpRegReg r12, r14
    x64.jcc aboveEqual, __im_slow
  __im_load#24:
    x64.loadRegBaseIndexScale.word64 rax, [r15 + r12*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 r13, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.cmpRegReg r12, r14
    x64.jcc aboveEqual, __im_slow
  __im_load#25:
    x64.leaRegRegReg rax, r15, r12
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegReg rcx, rax
    x64.jmp tryok
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit#36
  tryerr#10:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  critsplit#36:
    x64.movRegReg rcx, r8
  tryok:
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg r12
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, r12
    x64.subRegReg rdx, r12, rax
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, critsplit#35
  value:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forstep#7
  critsplit#35:
    x64.loadRegSlot rax, slot0
  forstep#7:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#5:
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 r12, 512
    x64.jcc less, check
  forexit#8:
    x64.loadRegSlot rax, slot0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  corrupted:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.callDirect __slab_scavenge
    x64.callDirect __slab_scavenge
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at slab-scavenger.an-os-direct-mapping-is-not-a-span.test:9: Range check failed: value outside typealias 'Byte'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
