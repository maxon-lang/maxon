// Test: slab-scavenger.an-idle-heap-releases-nothing
function main() returns ExitCode
	let first = __Builtins.scavengeMemory()
	if first != 0 'releasedSomething'
		return 1
	end 'releasedSomething'

	let second = __Builtins.scavengeMemory()
	if second != 0 'releasedSomethingLater'
		return 2
	end 'releasedSomethingLater'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __slab_scavenge
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  releasedSomething:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.callDirect __slab_scavenge
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  releasedSomethingLater:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
