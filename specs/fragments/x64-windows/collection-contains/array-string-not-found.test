    x64.callDirect __str_retain
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "cherry"
    x64.callDirect __str_retain
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata rbx, [rip + __str_rec_7]  ; "grape"
    x64.leaRegRdata rax, [rip + __layout_Array_String]
    x64.leaRegRdata r13, [rip + __witness_String.Equatable]
  __il_body:
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  scan:
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + r14*8 + 0]
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegBaseDisp.byte rcx, [rax + 0]
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rcx, r8
  __im_cont:
    x64.movRegReg rdx, rbx
    x64.callMem [r13 + 24]
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, forstep
  found:
