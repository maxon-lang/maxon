func @yielder {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.jmp whilehdr
  __il_body:
    x64.callDirect __gt_resched
  __il_cont:
    x64.leaRegRegImm32 rbx, rbx, 1
  whilehdr:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc less, __il_body
  whileexit:
    x64.leaRegGlobal rax, __data_siblingRan
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @sibling {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __parallel_boundary
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_siblingRan
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

