    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, __il_body
  each:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + r13*8 + 0]
  __im_cont:
    x64.callDirect String.toByteArray
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect Hasher.combine#struct
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  __il_body:
    x64.loadRegBaseDisp.word64 r8, [r12 + 0]
  __il_cont:
    x64.epilogue 48
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

