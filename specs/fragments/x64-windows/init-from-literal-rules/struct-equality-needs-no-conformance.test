// Test: struct-equality-needs-no-conformance
typealias Count = int(0 to 100)

type Box
	export let n as Count

	static function make(n Count) returns Box
		return Box{n: n}
	end 'make'

	function equals(other Box) returns bool
		return n == other.n
	end 'equals'
end 'Box'

function main() returns ExitCode
	let a = Box.make(1)
	let b = Box.make(1)
	let c = Box.make(2)
	if a == b 'eq'
		print("equal\n")
	end 'eq'
	if a != c 'neq'
		print("not equal\n")
	end 'neq'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  eq:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "equal\x0a"
    x64.callDirect print
  __il_body:
    x64.movRegImm32 rax, 0
  __il_cont:
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  neq:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "not equal\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
