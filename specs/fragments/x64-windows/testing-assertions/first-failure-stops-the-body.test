// Test: first-failure-stops-the-body
// --- file: main.maxon
function runChecks() throws TestFailure
	print("before\n")
	try Expect.equal(1, expected: 2)
	print("after\n")
end 'runChecks'

function main() returns ExitCode
	try runChecks() otherwise ignore

	print("resumed\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @runChecks {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_18]  ; "before\x0a"
    x64.callDirect print
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 2
  __il_body:
    x64.leaRegRdata rcx, [rip + __str_rec_46]  ; ""
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
  __il_cont:
    x64.leaRegRdata r9, [rip + __str_rec_19]  ; "main.maxon"
    x64.movRegImm32 rsi, 3
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect Expect.equal
    x64.movRegReg rbx, r10
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.leaRegRdata rcx, [rip + __str_rec_20]  ; "after\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect runChecks
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, trycont
  trycont:
    x64.leaRegRdata rcx, [rip + __str_rec_21]  ; "resumed\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
