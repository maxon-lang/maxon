// Test: the-thrown-error-is-testfailure-assertion
// --- file: main.maxon
function main() returns ExitCode
	try Expect.equal(1, expected: 2) otherwise (e) 'caught'
		match e 'kind'
			assertion then print("caught assertion\n")
		end 'kind'
		print("rendered as {e}\n")
	end 'caught'

	return 0
end 'main'
