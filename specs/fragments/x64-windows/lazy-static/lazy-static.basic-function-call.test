// Test: lazy-static.basic-function-call
typealias Count = int(0 to u64.max)

type Config
	static var value = Config.makeValue()
	export var n as Count

	static function makeValue() returns Config
		return Config{n: 42}
	end 'makeValue'

	export static function getValue() returns Config
		return Config.value
	end 'getValue'
end 'Config'

function main() returns ExitCode
	let c = Config.getValue()
	return c.n
end 'main'
---
ExitCode: 42
---
data {
  __data_Config.value@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body:
    x64.leaRegGlobal rax, __data_Config.value
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_retain
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at lazy-static.basic-function-call.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
