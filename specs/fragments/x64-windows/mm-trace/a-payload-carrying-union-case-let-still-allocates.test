    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#18
  matcharm#15:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont#19
  matchnext#18:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#17
  matcharm#16:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  matchcont#19:
