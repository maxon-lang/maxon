// Test: module-var-byte-string-read-allocates-no-record-per-read
var Buffer = b"critsplit"

function main() returns ExitCode
	let a = try Buffer.get(0) otherwise 0
	let b = try Buffer.get(1) otherwise 0
	let c = try Buffer.get(2) otherwise 0
	return 0 if a + b + c == 318 else 1
end 'main'
---
ExitCode: 0
---
data {
  __data_Buffer@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __ds_base@32 = i64 0
  __ds_buf_size@40 = i64 0
  __ds_buf_mask@48 = i64 0
  __ds_start_ts@56 = i64 0
  __ds_lock@64 = i64 0
  __mm_alloc_id@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

