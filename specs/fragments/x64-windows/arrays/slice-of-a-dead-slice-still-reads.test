// Test: slice-of-a-dead-slice-still-reads
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function build() returns IntArray
	var a = IntArray.create()
	var i = 0
	while i < 10 'fill'
		a.push(i * 10)
		i = i + 1
	end 'fill'
	return a
end 'build'

function innerOf(a IntArray) returns IntArray
	let mid = try a.slice(2, endIndex: 8) otherwise IntArray.create()
	return try mid.slice(1, endIndex: 4) otherwise IntArray.create()
end 'innerOf'

function main() returns ExitCode
	let inner = innerOf(build())
	let a = try inner.get(0) otherwise 0
	let b = try inner.get(1) otherwise 0
	let c = try inner.get(2) otherwise 0
	return (a + b + c) / 10
end 'main'
---
ExitCode: 12
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  whilehdr:
    x64.cmpRegImm32 r12, 10
    x64.jcc greaterEqual, whileexit
  fill:
    x64.imulRegRegImm32 rdx, r12, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

