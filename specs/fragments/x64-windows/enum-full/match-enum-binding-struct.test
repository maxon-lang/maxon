// Test: match-enum-binding-struct

typealias Integer = int(i64.min to i64.max)

type EnumPoint
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'EnumPoint'

union Shape
	circle(radius Integer)
	rect(origin EnumPoint)
end 'Shape'

function main() returns ExitCode
	let s = Shape.rect(EnumPoint.create(10, y: 20))
	match s 'handle'
		circle(r) then return r
		rect(p) then return p.x + p.y
	end 'handle'
end 'main'
---
ExitCode: 30
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 10
    x64.movRegImm32 r12, 20
  __il_body:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_cont:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], r13
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic#7
  __rc_ok#6:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Shape
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.leaRegRegReg r12, rax, rdx
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#10
  __rc_chk#11:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic#10
  __rc_ok#9:
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Shape
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at match-enum-binding-struct.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at match-enum-binding-struct.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
