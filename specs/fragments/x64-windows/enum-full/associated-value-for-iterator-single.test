// Test: associated-value-for-iterator-single

typealias Integer = int(i64.min to i64.max)

union Box
		empty
		full(n Integer)
end 'Box'

typealias BoxArray = Array with Box

function main() returns ExitCode
		var boxes = BoxArray.create()
		boxes.push(Box.full(42))
		var result = 0
		for b in boxes 'loop'
				match b 'check'
						empty then result = 0
						full(n) then result = n
				end 'check'
		end 'loop'
		return result
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 42
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp forhdr
  loop:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont:
    x64.loadRegBaseDisp.word64 rdi, [rsi + 0]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, matchnext
  matcharm#5:
    x64.movRegImm32 rsi, 0
    x64.jmp forstep
  matchnext:
    x64.cmpRegImm32 rdi, 1
    x64.jcc notEqual, matchdead
  matcharm#6:
    x64.loadRegBaseDisp.word64 rsi, [rsi + 8]
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r12, rsi
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc less, loop
    x64.jmp forexit
  matchdead:
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at associated-value-for-iterator-single.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
