// Test: implicit-string-backed
enum StringBacked
	"North"
	"South"
	"East"
end 'StringBacked'

function main() returns ExitCode
	let dir = StringBacked.North
	let result = match dir 'check'
		North gives 1
		South gives 0
		East gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
