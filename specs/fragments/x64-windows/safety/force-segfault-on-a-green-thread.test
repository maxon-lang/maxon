// Test: force-segfault-on-a-green-thread
function faultOnAGreenThread() returns ExitCode
	__Builtins.forceSegfault()
	return 0
end 'faultOnAGreenThread'

function main() returns ExitCode
	let p = async faultOnAGreenThread()
	let r = await p
	return r
end 'main'
