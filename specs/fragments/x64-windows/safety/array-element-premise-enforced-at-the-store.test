// Test: array-element-premise-enforced-at-the-store
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)
typealias NonZeroArray = Array with NonZero

function ident(v Integer) returns Integer
	return v
end 'ident'

function main() returns ExitCode
	var xs = NonZeroArray.create()
	xs.push(ident(0))
	let d = try xs.get(0) otherwise 1
	print("before\n")
	return 100 / d
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at array-element-premise-enforced-at-the-store.test:12: Range check failed: value outside typealias 'NonZero'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
