// Test: a-bool-half-pair-return-is-read-back-correctly
typealias Num = int(0 to 1000)

function probe(x Num) returns (bool, Num)
	return (x > 500, x - 500)
end 'probe'

function main() returns ExitCode
	let hit = probe(542)
	let miss = probe(500)
	let value = hit._1 if hit._0 else 100
	let bonus = 200 if miss._0 else 0
	return value + bonus
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @probe {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.cmpRegImm32 rcx, 500
    x64.setccReg greater, r8
    x64.leaRegRegImm32 r10, rcx, -500
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-bool-half-pair-return-is-read-back-correctly.test:4: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 rax, 0
    x64.movRegReg r8, rax
    x64.movRegReg r10, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 542
    x64.callDirect probe
    x64.movRegReg rbx, r8
    x64.movRegReg r12, r10
    x64.movRegImm32 rcx, 500
    x64.callDirect probe
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ternaryfalse#2
  ternarytrue#1:
    x64.movRegReg rax, r12
    x64.jmp matchcont#3
  ternaryfalse#2:
    x64.movRegImm32 rax, 100
  matchcont#3:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ternaryfalse#5
  ternarytrue#4:
    x64.movRegImm32 rcx, 200
    x64.jmp matchcont#6
  ternaryfalse#5:
    x64.movRegImm32 rcx, 0
  matchcont#6:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-bool-half-pair-return-is-read-back-correctly.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
