  __rc_ok:
    x64.movRegReg rcx, r15
    x64.callDirect __destruct___Tuple2.A.B
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __destruct___Tuple2.A.B
    x64.loadRegSlot r8, slot0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-bound-tuple-literal-owns-both-when-another-signature-spells-the-tuple.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
