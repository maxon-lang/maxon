// Test: a-bound-tuple-literal-owns-both-when-another-signature-spells-the-tuple
type A
	export var n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'A'

type B
	export var m as Integer

	export static function create(m Integer) returns Self
		return Self{m: m}
	end 'create'
end 'B'

function pair() returns (A, B)
	return (A.create(0), B.create(0))
end 'pair'

function main() returns ExitCode
	let (p, q) = pair()
	let a = A.create(40)
	let b = B.create(2)
	let t = (a, b)
	return (t.0.n + t.1.m + p.n + q.m) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @A.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @B.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
  __il_body:
    x64.movRegImm32 rcx, 0
    x64.callDirect A.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 0
    x64.callDirect B.create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot1, r13
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_cont:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 rcx, [r13 + 8]
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 40
    x64.callDirect A.create
    x64.movRegReg r13, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect B.create
    x64.movRegReg r14, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_own
    x64.storeBaseDispReg.word64 [r15 + 0], r8
    x64.movRegReg rcx, r14
    x64.callDirect __mm_own
    x64.storeBaseDispReg.word64 [r15 + 8], r8
    x64.loadRegBaseDisp.word64 rax, [r15 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [r15 + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rcx, 4294967295
