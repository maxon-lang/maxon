// Test: ranged-alias-elements-are-one-tuple-type
typealias Num = int(0 to 1000)

function f(t (Num, Num)) returns Num
	return t.0 + t.1
end 'f'

function g(t (Integer, Integer)) returns Integer
	return t.0 + t.1
end 'g'

function main() returns ExitCode
	let t = (10, 32)
	return (f(t) - (g(t) as Num)) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 32
  __il_body#9:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#11
  __rc_chk#12:
    x64.cmpRegImm32 r8, 1000
    x64.jcc greater, __rc_panic#11
  __il_body#13:
    x64.leaRegRegReg rax, rax, rcx
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.subRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#11:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at ranged-alias-elements-are-one-tuple-type.test:5: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at ranged-alias-elements-are-one-tuple-type.test:14: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at ranged-alias-elements-are-one-tuple-type.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
