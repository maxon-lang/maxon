// Test: comparison-operands
function main() returns ExitCode
	let x = 4
	let y = 0
	var code = 0
	if x > 0 and y > 0 'both'
		code = code + 1
	end 'both'
	if x > 0 or y > 0 'either'
		code = code + 2
	end 'either'
	if x > 0 and y == 0 'mixed'
		code = code + 4
	end 'mixed'
	return code
end 'main'
---
ExitCode: 6
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  either:
    x64.leaRegRegImm32 rax, rax, 2
  mixed:
    x64.leaRegRegImm32 r8, rax, 4
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
