// Test: in-a-call-argument
typealias Tag = int(0 to 100)

function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function consume(flag bool) returns Tag
	if flag 'isTrue'
		return 1
	end 'isTrue'
	return 0
end 'consume'

function main() returns ExitCode
	let a = consume(t() or f())
	let b = consume(t() and f())
	let c = consume(f() or t())
	return a * 4 + b * 2 + c
end 'main'
---
ExitCode: 5
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  isTrue#17:
    x64.movRegImm32 rax, 1
  ifcont:
    x64.movRegImm32 rcx, 0
  isTrue#32:
    x64.movRegImm32 rdx, 1
  __il_cont:
    x64.imulRegRegImm32 rax, rax, 4
    x64.leaRegBaseIndexScale rax, [rax + rcx*2]
    x64.leaRegRegReg r8, rax, rdx
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
