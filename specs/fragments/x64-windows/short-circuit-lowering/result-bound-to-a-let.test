// Test: result-bound-to-a-let
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	let a = t() and t()
	let b = t() and f()
	let c = f() or t()
	var code = 0
	if a 'a'
		code = code + 1
	end 'a'
	if b 'b'
		code = code + 2
	end 'b'
	if c 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 5
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  a:
    x64.movRegImm32 rax, 1
  c:
    x64.leaRegRegImm32 r8, rax, 4
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
