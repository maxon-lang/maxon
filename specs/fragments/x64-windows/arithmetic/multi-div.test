// Test: multi-div

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function multiDiv(a Integer, b NonZero, c Integer, d NonZero) returns Integer
	let r1 = try (a / (b as Integer)) otherwise panic("b is never zero")
	let r2 = try (c / (d as Integer)) otherwise panic("d is never zero")
	return trunc(r1 + r2)
end 'multiDiv'

function main() returns ExitCode
	return multiDiv(10, b: 2, c: 20, d: 4)
end 'main'
---
ExitCode: 10
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
  __rc_ok#12:
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 rax, rax, 10
    x64.sarRegImm8 rax, rax, 1
  tryok#6:
    x64.sarRegImm8 rcx, rcx, 63
    x64.shrRegImm8 rcx, rcx, 62
    x64.leaRegRegImm32 rcx, rcx, 20
    x64.sarRegImm8 rcx, rcx, 2
  tryok#8:
    x64.leaRegRegReg r8, rax, rcx
  __rc_ok#1:
    x64.popReg rbp
    x64.ret
}
