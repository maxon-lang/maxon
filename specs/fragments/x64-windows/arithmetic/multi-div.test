// Test: multi-div

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function multiDiv(a Integer, b NonZero, c Integer, d NonZero) returns Integer
	let r1 = try (a / (b as Integer)) otherwise panic("b is never zero")
	let r2 = try (c / (d as Integer)) otherwise panic("d is never zero")
	return trunc(r1 + r2)
end 'multiDiv'

function main() returns ExitCode
	return multiDiv(10, b: 2, c: 20, d: 4)
end 'main'
---
ExitCode: 10
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
  divok#7:
    x64.movRegImm32 rsi, 0
    x64.orRegImm32 rsi, rsi, 2
    x64.cqo
    x64.idivReg rsi
  divok#11:
    x64.sarRegImm8 rcx, rcx, 63
    x64.shrRegImm8 rcx, rcx, 62
    x64.leaRegRegImm32 rcx, rcx, 20
    x64.sarRegImm8 rcx, rcx, 2
  tryok:
    x64.leaRegRegReg r8, rax, rcx
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at multi-div.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
