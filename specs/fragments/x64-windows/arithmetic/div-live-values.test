// Test: div-live-values

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function divLive(a Integer, b NonZero, x Integer) returns Integer
	let preserved = x + 1
	let result = try (a / (b as Integer)) otherwise panic("b is never zero")
	return trunc(result + preserved)
end 'divLive'

function main() returns ExitCode
	return divLive(10, b: 2, x: 5)
end 'main'
---
ExitCode: 11
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 10
  __rc_ok#8:
    x64.sarRegImm8 rax, rax, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegImm32 rax, rax, 10
    x64.sarRegImm8 rax, rax, 1
  tryok:
    x64.leaRegRegImm32 r8, rax, 6
  __rc_ok#1:
    x64.popReg rbp
    x64.ret
}
