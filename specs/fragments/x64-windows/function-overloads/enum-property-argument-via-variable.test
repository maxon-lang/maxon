// Test: enum-property-argument-via-variable
typealias Wide = int(i64.min to i64.max)

enum Kind
	alpha
	beta
end 'Kind'

function over(x Wide) returns Wide
	return x + 100
end 'over'

function over(x String) returns Wide
	return x.count() + 200
end 'over'

function main() returns ExitCode
	let k = Kind.alpha
	let name = k.name
	return over(name)
end 'main'
