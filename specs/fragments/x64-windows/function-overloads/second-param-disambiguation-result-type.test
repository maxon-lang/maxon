  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 5
  yes:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greater, rcx
  __il_body#15:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  on:
