// Test: enum-struct-backing-field-argument
typealias Wide = int(i64.min to i64.max)

type Spec
	export var width as Wide
	export var height as Wide

	static function make(width Wide, height Wide) returns Spec
		return Spec{width: width, height: height}
	end 'make'
end 'Spec'

enum Preset
	small = Spec{width: 3, height: 2}
	large = Spec{width: 9, height: 4}
end 'Preset'

function over(x String) returns Wide
	return x.count() + 200
end 'over'

function over(x Wide) returns Wide
	return x + 100
end 'over'

function main() returns ExitCode
	let p = Preset.large
	return over(p.width)
end 'main'
---
ExitCode: 109
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 109
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
