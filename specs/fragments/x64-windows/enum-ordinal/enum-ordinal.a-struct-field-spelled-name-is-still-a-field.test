// Test: enum-ordinal.a-struct-field-spelled-name-is-still-a-field
typealias Integer = int(i64.min to i64.max)

enum Status
	ok = 200
	notFound = 404
end 'Status'

type Named
	export let name as Integer

	export static function create(name Integer) returns Self
		return Self{name: name}
	end 'create'
end 'Named'

type Holder
	export let s as Status
	export let n as Named

	export static function create(s Status, n Named) returns Self
		return Self{s: s, n: n}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(Status.notFound, n: Named.create(7))
	print("enumAccessor={h.s.name} plainField={h.n.name}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Named.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rbx, 404
    x64.movRegImm32 rcx, 7
    x64.callDirect Named.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect Holder.create
    x64.storeSlotReg slot0, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; "enumAccessor="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot6, rcx
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 200
    x64.setccReg equal, rcx
    x64.leaRegRdata rdx, [rip + __str_rec_5]  ; "ok"
    x64.imulRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 404
    x64.setccReg equal, rax
    x64.leaRegRdata rdx, [rip + __str_rec_6]  ; "notFound"
    x64.imulRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rcx, rax
