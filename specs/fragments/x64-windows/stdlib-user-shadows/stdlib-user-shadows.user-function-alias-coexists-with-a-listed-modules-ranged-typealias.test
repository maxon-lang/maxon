  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rcx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at stdlib-user-shadows.user-function-alias-coexists-with-a-listed-modules-ranged-typealias.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rax, [rip + __fnref_identity]
    x64.movRegImm32 rcx, 7
