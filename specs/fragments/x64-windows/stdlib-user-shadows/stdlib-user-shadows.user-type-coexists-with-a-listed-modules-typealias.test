// Test: stdlib-user-shadows.user-type-coexists-with-a-listed-modules-typealias
typealias Value = int(0 to 200)

type ParsedInt
	export let value as Value

	static function create(value Value) returns ParsedInt
		return Self{value: value}
	end 'create'
end 'ParsedInt'

function main() returns ExitCode
	let p = ParsedInt.create(7)
	return p.value
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 r8, 7
  __il_cont:
    x64.andRegImm32 r8, r8, 255
    x64.popReg rbp
    x64.ret
}
