// Test: a-borrowed-opaque-field-read-is-stored
typealias Idx = int(0 to u64.max)

type Bag uses Element
	typealias Items = Array with Element
	export var items as Items
	export var saved as Element

	static function of(value Element) returns Self
		return Self{items: Items.create(), saved: value}
	end 'of'

	function count() returns Idx
		return items.count()
	end 'count'

	function keepSaved()
		items.push(saved)
	end 'keepSaved'

	function at(i Idx) returns Element throws ArrayError
		return try items.get(i)
	end 'at'
end 'Bag'

typealias StrBag = Bag with String

function main() returns ExitCode
	var b = StrBag.of("a saved field string long enough to force a heap allocation")
	b.keepSaved()
	b.keepSaved()
	let stored = try b.at(1) otherwise return 1
	print("{stored}\n")
	return b.count() as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
