// Test: builtins-type.command-line-arg-out-of-bounds
function main() returns ExitCode
	let managed = __Builtins.commandLineArg(9999)
	let s = String.init(managed)
	if s == "" 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
Args: one
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 9999
    x64.callDirect __cl_arg
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
  __il_body:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  scan:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.movRegImm32 rax, 1
    x64.jcc greaterEqual, scmerge
  orrhs:
    x64.cmpRegImm32 r8, 13
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, forstep
  notSingleByte:
    x64.movRegImm32 rdx, 0
    x64.jmp __il_cont#5
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
  forhdr:
    x64.cmpRegReg r14, r13
    x64.jcc less, scan
  forexit:
    x64.movRegImm32 rdx, 1
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __str_of_buffer
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __il_cont#3:
    x64.leaRegRdata rdx, [rip + __str_rec_1]  ; ""
    x64.movRegReg rcx, r13
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at String.maxon:1136: scanSingleByteGraphemes: byteAt OOB \xe2\x80\x94 i < len invariant\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
