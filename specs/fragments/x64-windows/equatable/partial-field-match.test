// Test: partial-field-match

typealias Integer = int(i64.min to i64.max)

type Point implements Equatable
	export var x as Integer
	export var y as Integer

	function equals(other Point) returns bool
		return x == other.x and y == other.y
	end 'equals'

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = Point.create(1, y: 99)
	if a.equals(b) 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 99
    x64.leaRegSlot rsi, slot2
    x64.storeBaseDispReg.word64 [rsi + 0], rax
    x64.storeBaseDispReg.word64 [rsi + 8], rcx
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rsi + 0]
    x64.cmpRegReg rax, rcx
    x64.movRegImm32 rax, 0
    x64.jcc notEqual, __il_cont
  andrhs:
    x64.loadRegBaseDisp.word64 rax, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rsi + 8]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rax
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
