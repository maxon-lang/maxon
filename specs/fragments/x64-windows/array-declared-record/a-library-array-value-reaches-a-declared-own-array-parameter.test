// Test: a-library-array-value-reaches-a-declared-own-array-parameter
type Array uses Element implements BuiltinArrayLiteral
	export typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	static function create() returns Self
		return Self{}
	end 'create'
end 'Array'

typealias MyStrings = Array with String

function takesMine(parts MyStrings) returns Integer
	return parts.count()
end 'takesMine'

function main() returns ExitCode
	let s = "a,b,c"
	return takesMine(s.split(",")) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "a,b,c"
    x64.leaRegRdata r12, [rip + __str_rec_3]  ; ","
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.storeSlotReg slot0, r13
  __il_body#19:
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
  __il_cont#18:
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, __il_body#21
  __il_body#17:
    x64.movRegImm32 rdx, 0
  __il_body#23:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#22:
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.callDirect String.sliceBytes
  __il_cont#16:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.jmp __il_body#5
  __il_body#21:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
  __il_cont#20:
    x64.movRegImm32 r15, 0
    x64.jmp whilehdr
  search:
    x64.movRegReg rax, r13
    x64.subRegReg rax, r13, r15
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg r9, r12
    x64.callDirect findIn
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, whileexit
  try_find:
    x64.leaRegRegReg rax, r15, r8
    x64.storeSlotReg slot1, rax
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.loadRegSlot rax, slot1
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect String.sliceBytes
    x64.loadRegSlot rcx, slot0
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegSlot rax, slot1
    x64.leaRegRegReg rax, rax, r14
  ifcont:
    x64.movRegReg r15, rax
  whilehdr:
    x64.movRegReg rax, r13
    x64.subRegReg rax, r13, r14
    x64.cmpRegReg r15, rax
    x64.jcc lessEqual, search
  whileexit:
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r13
    x64.callDirect String.sliceBytes
    x64.loadRegSlot rcx, slot0
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_body#5:
    x64.loadRegSlot rax, slot0
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
  __il_cont#4:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_10]  ; "panic at a-library-array-value-reaches-a-declared-own-array-parameter.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
