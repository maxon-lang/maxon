    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  __us_test:
    x64.loadRegBaseDisp.word64 r14, [rbx + 8]
    x64.jmp forhdr#1
  ownLoop:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get_unchecked
    x64.leaRegRegReg r12, r12, r8
  forstep#3:
    x64.leaRegRegImm32 r13, r13, 1
  forhdr#1:
    x64.storeSlotReg slot0, r12
    x64.cmpRegReg r13, r14
    x64.jcc less, ownLoop
  forexit#4:
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "a,bb,ccc"
    x64.leaRegRdata r12, [rip + __str_rec_3]  ; ","
  __il_body#14:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.storeSlotReg slot2, r13
  __il_body#28:
    x64.loadRegBaseDisp.word64 r14, [r12 + 8]
  __il_cont#27:
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, __il_body#30
  __il_body#24:
    x64.movRegImm32 rdx, 0
  __il_body#32:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#31:
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.callDirect String.sliceBytes
  __il_cont#23:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.jmp __il_cont#13
  __il_body#30:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
  __il_cont#29:
