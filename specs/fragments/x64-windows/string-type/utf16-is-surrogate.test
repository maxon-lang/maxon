// Test: utf16-is-surrogate
function main() returns ExitCode
	if utf16IsSurrogate(55357) 'c7'
		print("1\n")
	end 'c7'
	if utf16IsSurrogate(56832) 'c8'
		print("2\n")
	end 'c8'
	if utf16IsSurrogate(65) 'c9'
		print("0\n")
	end 'c9'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  c7:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "1\x0a"
    x64.callDirect print
  c8:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "2\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
