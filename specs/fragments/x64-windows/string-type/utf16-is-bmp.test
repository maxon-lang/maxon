// Test: utf16-is-bmp
function main() returns ExitCode
	if utf16IsBmp(65) 'c10'
		print("1\n")       // ASCII
	end 'c10'
	if utf16IsBmp(945) 'c11'
		print("2\n")      // Greek α
	end 'c11'
	if utf16IsBmp(65535) 'c12'
		print("3\n")    // U+FFFF (last BMP)
	end 'c12'
	if utf16IsBmp(128512) 'c13'
		print("0\n")   // 😀 (not BMP)
	end 'c13'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  c10:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "1\x0a"
    x64.callDirect print
  c11:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "2\x0a"
    x64.callDirect print
  c12:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "3\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
