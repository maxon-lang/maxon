// Test: endsWith
function main() returns ExitCode
	let s = "hello world"
	if s.endsWith("world") 'c1'
		print("1\n")
	end 'c1'
	if s.endsWith("hello") 'c2'
		print("0\n")
	end 'c2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_5]  ; "hello world"
    x64.leaRegRdata rdx, [rip + __str_rec_6]  ; "world"
    x64.movRegReg rcx, rbx
    x64.callDirect String.endsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  c1:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "1\x0a"
    x64.callDirect print
  ifcont#2:
    x64.leaRegRdata rdx, [rip + __str_rec_8]  ; "hello"
    x64.movRegReg rcx, rbx
    x64.callDirect String.endsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  c2:
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "0\x0a"
    x64.callDirect print
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
