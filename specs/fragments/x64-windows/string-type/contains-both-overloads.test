// Test: contains-both-overloads
function main() returns ExitCode
	let s = "hello world"
	let a = s.contains("lo wo")
	let b = s.contains("xyz")
	let c = s.contains('o')
	let d = s.contains('z')
	let e = "café naïve"
	let f = e.contains('é')
	let g = e.contains('ü')
	print("{a} {b} {c} {d} {f} {g}")
	return 0
end 'main'
