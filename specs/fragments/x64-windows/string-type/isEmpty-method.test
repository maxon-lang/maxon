// Test: isEmpty-method
function main() returns ExitCode
	let empty = ""
	let nonempty = "hello"
	if empty.isEmpty() 'check1'
		print("1\n")
	end 'check1'
	if nonempty.isEmpty() 'check2'
		print("0\n")
	end 'check2' else 'not_empty'
		print("2\n")
	end 'not_empty'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; ""
    x64.leaRegRdata rbx, [rip + __str_rec_6]  ; "hello"
  __il_body#9:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#8:
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rax
  __il_cont#6:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#13
  check1:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "1\x0a"
    x64.callDirect print
  __il_body#13:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
  __il_cont#12:
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rax
  __il_cont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifelse
  check2:
    x64.leaRegRdata rcx, [rip + __str_rec_8]  ; "0\x0a"
    x64.callDirect print
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "2\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
