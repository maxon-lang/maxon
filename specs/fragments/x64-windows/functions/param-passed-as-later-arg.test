// Test: param-passed-as-later-arg
function diff(x Integer, y Integer) returns Integer
	return x - y
end 'diff'

function combine(a Integer, b Integer, c Integer) returns Integer
	let r = diff(b, y: a)
	return r + c
end 'combine'

function main() returns ExitCode
	return combine(10, b: 20, c: 30)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 40
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 10
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 30
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
