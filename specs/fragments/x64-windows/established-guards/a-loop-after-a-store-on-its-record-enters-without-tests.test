// Test: a-loop-after-a-store-on-its-record-enters-without-tests
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function carry(count WordArray, n Word) returns Word
	try count.set(1, value: 0) otherwise panic("carry: n >= 2")
	var carried = 0
	for i in 1 upto n 'each'
		let digit = try count.get(i) otherwise panic("carry: i < n = count.count()")
		carried = carried + digit + 1
		try count.set(i, value: digit + 1) otherwise panic("carry: i < n = count.count()")
	end 'each'
	return carried
end 'carry'

function main() returns ExitCode
	var count = WordArray.create()
	count.resize(6)
	if carry(count, n: 6) != 5 'firstPass'
		return 1
	end 'firstPass'
	if carry(count, n: 6) != 9 'secondPass'
		return 2
	end 'secondPass'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @carry {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 80
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc less, __im_slow#16
  __im_bounds:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.cmpRegImm32 rdi, 1
    x64.jcc belowEqual, __im_slow#16
  __im_buffer:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 0]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, __im_slow#16
  __im_viewed:
    x64.leaRegRegImm32 r8, rdi, -24
    x64.loadRegBaseDisp.word64 r8, [r8 + 16]
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, __im_slow#16
  __im_store#20:
    x64.leaRegRegImm32 rax, rdi, 8
    x64.storeBaseDispReg.word64 [rax + 0], rsi
  tryok#1:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rsi, 1
  __us_test#46:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
  __us_test#47:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.jmp forhdr
  __rc_ok:
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow#42
  __im_load:
    x64.loadRegBaseIndexScale.word64 r9, [r8 + rsi*8 + 0]
  tryok#40:
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 r9, r9, 1
  __im_store#35:
    x64.storeBaseIndexScaleReg.word64 [r8 + rsi*8 + 0], r9
  forstep:
    x64.leaRegRegImm32 rsi, rsi, 1
  forhdr:
    x64.cmpRegReg rsi, rdx
    x64.jcc less, __rc_ok
  forexit:
    x64.movRegReg r8, rax
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
  __im_slow#16:
    x64.storeSlotReg slot0, rcx
    x64.storeSlotReg slot1, rdx
    x64.movRegReg rdx, rax
    x64.movRegReg rax, rsi
    x64.callDirect __managed_set
    x64.loadRegSlot rcx, slot0
    x64.loadRegSlot rdx, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-loop-after-a-store-on-its-record-enters-without-tests.test:6: carry: n >= 2\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
  __im_slow#42:
    x64.storeSlotReg slot2, rax
    x64.storeSlotReg slot0, rcx
    x64.storeSlotReg slot1, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot2
    x64.loadRegSlot rcx, slot0
    x64.loadRegSlot rdx, slot1
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#40
  tryerr#8:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-loop-after-a-store-on-its-record-enters-without-tests.test:9: carry: i < n = count.count()\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 6
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 rdx, 6
    x64.movRegReg rcx, rbx
    x64.callDirect carry
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, ifcont#2
  firstPass:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 6
    x64.movRegReg rcx, rbx
    x64.callDirect carry
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, ifcont#4
  secondPass:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
