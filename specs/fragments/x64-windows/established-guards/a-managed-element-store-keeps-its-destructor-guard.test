// Test: a-managed-element-store-keeps-its-destructor-guard
typealias StringArray = Array with String

function rewrite(a StringArray)
	try a.set(0, value: "first heap string with enough bytes to be allocated") otherwise panic("rewrite: a holds an element")
	try a.set(0, value: "second heap string with enough bytes to be allocated") otherwise panic("rewrite: a holds an element")
end 'rewrite'

function main() returns ExitCode
	var a = StringArray.create()
	a.push("seed")
	rewrite(a)
	let kept = try a.get(0) otherwise ""
	if kept.count() != 52 'secondWriteLanded'
		return 1
	end 'secondWriteLanded'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @rewrite {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "first heap string with enough bytes to be allocated"
    x64.callDirect __str_retain
    x64.loadRegBaseDisp.word64 rax, [rbx + 40]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __im_slow#6
  __im_owned#7:
    x64.loadRegBaseDisp.word64 rax, [rbx + 16]
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __im_slow#6
  __im_bounds#8:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#6
  __im_buffer#9:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow#6
  __im_viewed#10:
    x64.leaRegRegImm32 rcx, rax, -24
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_store#11
  __im_slow#6:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r8
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  __im_store#11:
    x64.storeBaseDispReg.word64 [rax + 0], r8
  tryok#1:
    x64.movRegImm32 r12, 0
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "second heap string with enough bytes to be allocated"
    x64.callDirect __str_retain
    x64.loadRegBaseDisp.word64 rax, [rbx + 40]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __im_slow#13
  __im_owned#14:
    x64.loadRegBaseDisp.word64 rax, [rbx + 16]
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __im_slow#13
  __im_bounds#15:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#13
  __im_buffer#16:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow#13
  __im_viewed#17:
    x64.leaRegRegImm32 rcx, rax, -24
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_store#18
  __im_slow#13:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r8
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  __im_store#18:
    x64.storeBaseDispReg.word64 [rax + 0], r8
  tryok#3:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at a-managed-element-store-keeps-its-destructor-guard.test:5: rewrite: a holds an element\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr#4:
    x64.leaRegRdata rcx, [rip + __str_blob_7]  ; "panic at a-managed-element-store-keeps-its-destructor-guard.test:6: rewrite: a holds an element\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_8]  ; "seed"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect rewrite
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#10
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
  critsplit#11:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont
  critsplit#10:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; ""
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r8
  trycont:
    x64.callDirect String.count
    x64.cmpRegImm32 r8, 52
    x64.jcc equal, ifcont
  secondWriteLanded:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.jmp __im_cont
}
