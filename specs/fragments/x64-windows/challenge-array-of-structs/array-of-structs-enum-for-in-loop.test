// Test: array-of-structs-enum-for-in-loop
// Regression test: enum match works in for-in loop over struct array
enum Status
	pending
	active
	done
end 'Status'

type Task
	export var status as Status

	static function create(status Status) returns Self
		return Self{status: status}
	end 'create'
end 'Task'

typealias TaskArray = Array with Task

function main() returns ExitCode
	var tasks = TaskArray.create()
	tasks.push(Task.create(Status.pending))
	tasks.push(Task.create(Status.active))
	tasks.push(Task.create(Status.done))

	var activeCount = 0
	for task in tasks 'loop'
		match task.status 'check'
			active then activeCount = activeCount + 1
			pending then break
			done then break
		end 'check'
	end 'loop'

	return activeCount
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Task.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 0
    x64.callDirect Task.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 1
    x64.callDirect Task.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 2
    x64.callDirect Task.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  loop:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont:
    x64.loadRegBaseDisp.word64 rsi, [rsi + 0]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, matchnext#11
  matcharm#6:
    x64.movRegReg rsi, r12
    x64.jmp forstep
  matchnext#11:
    x64.cmpRegImm32 rsi, 1
    x64.jcc notEqual, matchnext#12
  matcharm#5:
    x64.leaRegRegImm32 rsi, r12, 1
    x64.jmp forstep
  matchnext#12:
    x64.cmpRegImm32 rsi, 2
    x64.jcc notEqual, matchdead
  matcharm#8:
    x64.movRegReg rsi, r12
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r12, rsi
    x64.jmp forhdr
  matchdead:
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at array-of-structs-enum-for-in-loop.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
