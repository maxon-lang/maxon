// Test: an-empty-container-refuses-every-index
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function probe(a IntArray) returns Int
	var hits = 0
	if (try a.managed.get(0) otherwise -1) != -1 'zero'
		hits = hits + 1
	end 'zero'
	if (try a.managed.get(1) otherwise -1) != -1 'one'
		hits = hits + 1
	end 'one'
	if (try a.managed.get(-1) otherwise -1) != -1 'negative'
		hits = hits + 1
	end 'negative'
	return hits
end 'probe'

function main() returns ExitCode
	var fresh = IntArray.create()
	if probe(fresh) != 0 'freshAdmittedSomething'
		return 1
	end 'freshAdmittedSomething'

	var emptied = IntArray.create()
	emptied.push(7)
	emptied.push(8)
	emptied.clear()
	if emptied.count() != 0 'clearedCount'
		return 2
	end 'clearedCount'
	if probe(emptied) != 0 'clearedAdmittedSomething'
		return 3
	end 'clearedAdmittedSomething'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @probe {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegReg rax, rcx
    x64.movRegImm32 rsi, 0
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rcx, [rax + 8]
    x64.cmpRegImm32 rcx, 0
    x64.jcc above, __im_load#18
  __im_slow#17:
    x64.movRegReg rcx, rax
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rsi
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rsi, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm rcx, 18446744073709551615
    x64.jmp trycont#3
  __im_load#18:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg r8, rcx
  tryok#1:
    x64.movRegReg rcx, r8
  trycont#3:
    x64.cmpRegImm32 rcx, -1
    x64.jcc equal, ifcont#5
  zero:
    x64.movRegImm32 rsi, 1
  ifcont#5:
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rcx, [rax + 8]
    x64.cmpRegImm32 rcx, 1
    x64.jcc above, __im_load#21
  __im_slow#20:
    x64.movRegReg rcx, rax
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rsi
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rsi, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#6
  tryerr#7:
    x64.movRegImm rcx, 18446744073709551615
    x64.jmp trycont#8
  __im_load#21:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.leaRegRegImm32 rcx, rcx, 8
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg r8, rcx
  tryok#6:
    x64.movRegReg rcx, r8
  trycont#8:
    x64.cmpRegImm32 rcx, -1
    x64.jcc equal, ifcont#10
  one:
    x64.leaRegRegImm32 rsi, rsi, 1
  ifcont#10:
    x64.movRegImm rdx, 18446744073709551615
    x64.loadRegBaseDisp.word64 rcx, [rax + 8]
    x64.cmpRegImm32 rcx, -1
    x64.jcc above, __im_load#24
  __im_slow#23:
    x64.movRegReg rcx, rax
    x64.storeSlotReg slot1, rsi
    x64.callDirect __managed_get
    x64.loadRegSlot rsi, slot1
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#11
  tryerr#12:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont#13
  __im_load#24:
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, -8
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegReg r8, rax
  tryok#11:
    x64.movRegReg rax, r8
  trycont#13:
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, critsplit
  negative:
    x64.leaRegRegImm32 r8, rsi, 1
    x64.jmp ifcont#15
  critsplit:
    x64.movRegReg r8, rsi
  ifcont#15:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect probe
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  freshAdmittedSomething:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect Array.clear
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#4
  clearedCount:
    x64.movRegImm32 r13, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg rcx, r12
    x64.callDirect probe
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#6
  clearedAdmittedSomething:
    x64.movRegImm32 r13, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
