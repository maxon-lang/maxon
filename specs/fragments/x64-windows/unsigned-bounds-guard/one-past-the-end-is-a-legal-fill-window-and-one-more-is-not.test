// Test: one-past-the-end-is-a-legal-fill-window-and-one-more-is-not
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var a = IntArray.create()
	for _ in 0 upto 4 'seed'
		a.push(0)
	end 'seed'

	// stop == length: the window reaches the end exactly, and applies.
	let whole = try a.managed.fill(0, count: 4, value: 3) otherwise 'wholeErr'
		return 1
	end 'wholeErr'
	if not whole 'wholeDeclined'
		return 2
	end 'wholeDeclined'

	// stop == length + 1: one element past, refused, and nothing written.
	try a.managed.fill(1, count: 4, value: 9) otherwise 'pastEnd'
		var sum = 0
		for v in a 'check'
			sum = sum + v
		end 'check'
		if sum != 12 'fillLanded'
			return 3
		end 'fillLanded'
		return 0
	end 'pastEnd'

	// The past-the-end fill was supposed to throw.
	return 4
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  forhdr#1:
    x64.cmpRegImm32 r12, 4
    x64.jcc greaterEqual, forexit#4
  seed:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 4
    x64.movRegImm32 r9, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_fill
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#8
  wholeDeclined:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 4
    x64.movRegImm32 r9, 9
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_fill
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#9
  tryerr#10:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
  forhdr#11:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forexit#14
  check:
    x64.loadRegBaseIndexScale.word64 rdi, [rsi + rcx*8 + 0]
  __im_cont:
    x64.leaRegRegReg rax, rax, rdi
  forstep#13:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr#11
  forexit#14:
    x64.cmpRegImm32 rax, 12
    x64.jcc equal, ifcont#16
  fillLanded:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#16:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#9:
    x64.movRegImm32 r12, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
