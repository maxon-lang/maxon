// Test: nested-short-circuit
var calls = 0

function a() returns bool
	calls = calls + 1
	return true
end 'a'

function b() returns bool
	calls = calls + 10
	return false
end 'b'

function c() returns bool
	calls = calls + 100
	return true
end 'c'

function main() returns ExitCode
	let inner = b() or c()
	let result = a() and inner
	if result 'r'
		return calls as ExitCode
	end 'r'
	return 99
end 'main'
---
ExitCode: 111
---
data {
  __data_calls@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body#11:
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 10
    x64.leaRegGlobal rcx, __data_calls
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body#13:
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegGlobal rcx, __data_calls
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 1
  __il_body#15:
    x64.leaRegGlobal rcx, __data_calls
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_calls
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  r:
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at nested-short-circuit.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
