// Test: compare-against-a-literal-keeps-the-operand-width
function big() returns ExitCode
	return 4000000000
end 'big'

function hundred() returns ExitCode
	return 100
end 'hundred'

function main() returns ExitCode
	let e = big()
	if e > 100 'literalForm'
		print("literal=gt\n")
	end 'literalForm' else 'literalNot'
		print("literal=le\n")
	end 'literalNot'

	if e > hundred() 'valueForm'
		print("value=gt\n")
	end 'valueForm' else 'valueNot'
		print("value=le\n")
	end 'valueNot'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  literalForm:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "literal=gt\x0a"
    x64.callDirect print
  valueForm:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "value=gt\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
