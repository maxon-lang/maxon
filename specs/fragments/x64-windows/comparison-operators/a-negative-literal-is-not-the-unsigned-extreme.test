// Test: a-negative-literal-is-not-the-unsigned-extreme
typealias Wide = bits(64)

function wide(n Wide) returns Wide
	return n
end 'wide'

function main() returns ExitCode
	let three = wide(3 as Wide)

	if three > -1 'aboveNegativeOne'
		return 42
	end 'aboveNegativeOne'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  aboveNegativeOne:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
