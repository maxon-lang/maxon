// Test: compared-against-the-unsigned-extreme
typealias Wide = bits(64)

function wide(n Wide) returns Wide
	return n
end 'wide'

function main() returns ExitCode
	let three = wide(3 as Wide)

	if three > u64.max 'impossible'
		return 1
	end 'impossible'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
  __il_cont:
    x64.cmpRegImm32 rax, -1
    x64.jcc belowEqual, ifcont
  impossible:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
