// Test: value-call-result-may-still-be-discarded
typealias Integer = int(i64.min to i64.max)

var calls = 0 as Integer

function answer() returns Integer
	calls = calls + 1
	return 42
end 'answer'

function main() returns ExitCode
	_ = answer()
	return 41 + calls
end 'main'
---
ExitCode: 42
---
data {
  __data_calls@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.leaRegGlobal rax, __data_calls
    x64.aluBaseDispImm32.add [rax + 0], 1
  __il_cont:
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 r8, rax, 41
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at value-call-result-may-still-be-discarded.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
