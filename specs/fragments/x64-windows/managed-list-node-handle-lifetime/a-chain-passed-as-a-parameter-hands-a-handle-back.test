// Test: a-chain-passed-as-a-parameter-hands-a-handle-back
typealias Small = int(0 to 255)
typealias IntChain = __ManagedList with Small
typealias IntNode = __ManagedListNode with Small

function appendTo(chain IntChain, value Small) returns IntNode
	return chain.insertLast(value)
end 'appendTo'

function main() returns ExitCode
	var chain = IntChain.create()
	let node = appendTo(chain, value: 55)
	return node.value()
end 'main'
---
ExitCode: 55
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 55
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_append
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  __il_cont:
    x64.movRegReg rcx, r12
    x64.callDirect __list_node_value
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __list_node_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __list_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
