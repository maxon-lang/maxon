    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at union-payload-declared-an-array-of-buffers-serves-the-roster.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
