// Test: a-sibling-files-buffer-alias-serves-the-roster-alias-file-first
// --- file: alias.maxon
typealias Byte = int(0 to u8.max)
typealias Int = int(i64.min to i64.max)
typealias ByteBuffer = __ManagedMemory with Byte

export function seed(x ByteBuffer) returns Int
	return x.length()
end 'seed'

// --- file: main.maxon
type Holder
	export var buf as ByteBuffer

	export static function create(buf ByteBuffer) returns Self
		return Self{buf: buf}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create("hello".toByteArray() as ByteBuffer)
	return (h.buf.length() + seed("hi".toByteArray() as ByteBuffer)) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "hello"
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
  __il_body#6:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont#5:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "hi"
    x64.callDirect String.toByteArray
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
  __il_cont#4:
    x64.leaRegRegReg rbx, rbx, rax
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at main.maxon:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
