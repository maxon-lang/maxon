// Test: a-contested-alias-takes-each-files-own-buffer-spelling
// --- file: buffer.maxon
typealias Byte = int(0 to u8.max)
typealias Int = int(i64.min to i64.max)
typealias B = __ManagedMemory with Byte

export function bufferWidth(m B) returns Int
	return m.length()
end 'bufferWidth'

// --- file: main.maxon
typealias Int2 = int(i64.min to i64.max)
typealias B = Array with Int2

function arrayWidth(xs B) returns Int2
	return xs.count()
end 'arrayWidth'

function main() returns ExitCode
	var xs = B.create()
	xs.push(7 as Int2)
	return (bufferWidth("hello".toByteArray()) + arrayWidth(xs)) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello"
    x64.callDirect String.toByteArray
  __il_body#6:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
  __il_body#7:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
  __il_cont:
    x64.leaRegRegReg r12, rax, rcx
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at main.maxon:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
