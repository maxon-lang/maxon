// Test: a-byte-array-payload-still-serves-count
typealias Int = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

union Held
	mem(m ByteArray)
	nothing
end 'Held'

function size(h Held) returns Int
	return match h 'k'
		mem(x) gives x.count()
		nothing gives 0
	end 'k'
end 'size'

function main() returns ExitCode
	let h = Held.mem("hello".toByteArray())
	return size(h) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello"
  __il_body#12:
    x64.movRegImm32 rdx, 0
  __il_body#16:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont#15:
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at String.maxon:157: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __il_cont#11:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], r12
  __il_body#5:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#6:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_incref
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.jmp __il_cont#4
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#7:
    x64.movRegImm32 r12, 0
    x64.movRegReg r13, r12
  __il_cont#4:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Held
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-byte-array-payload-still-serves-count.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
