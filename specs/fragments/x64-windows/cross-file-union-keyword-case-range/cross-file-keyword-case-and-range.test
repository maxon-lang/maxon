// Test: cross-file-keyword-case-and-range
// --- file: kind.maxon
export enum Kind
	boolean
	integer
	float
	named
	function
	unresolved
	other
end 'Kind'

// --- file: main.maxon
function isScalar(k Kind) returns bool
	return match k 'check'
		boolean or
			integer or
			float gives true
		named or
			function or
			unresolved or
			other gives false
	end 'check'
end 'isScalar'

function pickFloat() returns Kind
	return Kind.float
end 'pickFloat'

function pickBoolean() returns Kind
	return Kind.boolean
end 'pickBoolean'

function pickNamed() returns Kind
	return Kind.named
end 'pickNamed'

function main() returns ExitCode
	var score = 0
	if isScalar(pickFloat()) 'f'
		score = score + 1
	end 'f'
	if isScalar(pickBoolean()) 'b'
		score = score + 2
	end 'b'
	if isScalar(pickNamed()) 'n'
		score = score + 4
	end 'n'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  f:
    x64.movRegImm32 rax, 1
  b:
    x64.leaRegRegImm32 r8, rax, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
