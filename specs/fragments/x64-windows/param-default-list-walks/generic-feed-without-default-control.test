    x64.callDirect __destruct_Box_String
    x64.movRegReg r8, r12
  whilehdr:
    x64.cmpRegImm32 rbx, 50
    x64.jcc less, loop
  __rc_ok:
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
