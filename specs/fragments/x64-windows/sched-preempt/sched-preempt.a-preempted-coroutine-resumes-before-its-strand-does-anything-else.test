func @step {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, ifcont
  leaf:
    x64.imulRegRegImm32 rax, rcx, 31
    x64.leaRegRegImm32 r8, rax, 7
    x64.movRegImm rax, 9671377542784405045
    x64.imulHighReg r8
    x64.leaRegRegReg rax, rdx, r8
    x64.sarRegImm8 rax, rax, 19
    x64.movRegReg rcx, rax
    x64.shrRegImm8 rcx, rax, 63
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rax, rax, 1000003
    x64.subRegReg r8, r8, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.imulRegRegImm32 rax, rcx, 17
    x64.leaRegRegReg rcx, rax, rsi
    x64.movRegImm rax, 9671377542784405045
    x64.imulHighReg rcx
    x64.leaRegRegReg rax, rdx, rcx
    x64.sarRegImm8 rax, rax, 19
    x64.movRegReg rdx, rax
    x64.shrRegImm8 rdx, rax, 63
    x64.leaRegRegReg rax, rax, rdx
    x64.imulRegRegImm32 rax, rax, 1000003
    x64.subRegReg rcx, rcx, rax
    x64.leaRegRegImm32 rdx, rsi, -1
    x64.callDirect step
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @busy {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect sleep
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_phase
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.callDirect Clock.nowMs
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr#1
  spin:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.jmp whilehdr#4
  burst:
    x64.movRegImm32 rdx, 4
    x64.callDirect step
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rcx, r8
  whilehdr#4:
    x64.cmpRegImm32 r13, 1000
    x64.jcc less, burst
  whileexit#6:
    x64.movRegReg r12, rcx
  whilehdr#1:
    x64.movRegReg rcx, rbx
    x64.callDirect Clock.elapsedMs
    x64.cmpRegImm32 r8, 150
    x64.jcc less, spin
  whileexit#3:
    x64.movRegImm32 rax, 2
    x64.leaRegGlobal rcx, __data_phase
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegReg rax, r12
    x64.sarRegImm8 rax, r12, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegReg rax, r12, rax
    x64.sarRegImm8 rax, rax, 1
    x64.imulRegRegImm32 rax, rax, 2
    x64.subRegReg r12, r12, rax
    x64.leaRegRegImm32 r8, r12, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @nap {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 30
    x64.callDirect sleep
    x64.leaRegGlobal rax, __data_phase
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

