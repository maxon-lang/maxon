  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "cmd /c exit 3"
    x64.callDirect __gt_process_run
