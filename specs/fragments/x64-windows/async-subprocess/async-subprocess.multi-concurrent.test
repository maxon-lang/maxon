  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at async-subprocess.multi-concurrent.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
