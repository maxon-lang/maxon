  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __sched_sysmon_started@232 = i64 0
  __slab_arena_list@240 = i64 0
  __slab_arena_map_l1@248 = i64 0
  __slab_state@256 = i64 0
}

func @c1 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "cmd /c exit 1"
    x64.callDirect __gt_process_run
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 99
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

