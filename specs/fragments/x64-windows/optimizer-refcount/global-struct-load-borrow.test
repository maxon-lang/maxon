// Test: global-struct-load-borrow
typealias Integer = int(i64.min to i64.max)

type Config
	export var threshold as Integer

	static function create(threshold Integer) returns Self
		return Self{threshold: threshold}
	end 'create'
end 'Config'

var cfg = Config.create(10)

function check(value Integer) returns Integer
	if value > cfg.threshold 'high'
		return value
	end 'high'
	return 0
end 'check'

function main() returns ExitCode
	return check(42)
end 'main'
---
ExitCode: 42
---
data {
  __data_cfg@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
  __ds_base@72 = i64 0
  __dbg_ctl@80 = i64 0
  __mrt_console_probe_stdin@88 = i8 0
  __mrt_console_probe_stdout@89 = i8 0
  __mrt_console_probe_stderr@90 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
  __il_body:
    x64.leaRegGlobal rax, __data_cfg
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 42
    x64.jcc less, __rc_ok
  ifcont:
    x64.movRegImm32 r8, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
