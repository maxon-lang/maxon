// Test: the-whole-chain-over-a-managed-element
typealias Int = int(i64.min to i64.max)

type Inner uses T
	typealias TArray = Array with T
	var items as TArray

	static function create() returns Self
		return Self{items: TArray.create()}
	end 'create'

	function add(v T)
		items.push(v)
	end 'add'

	function count() returns Int
		return items.count()
	end 'count'
end 'Inner'

type Bag uses Element
	typealias EChain = Inner with Element
	var chain as EChain

	static function create() returns Self
		return Self{chain: EChain.create()}
	end 'create'

	function add(v Element)
		chain.add(v)
	end 'add'

	function size() returns Int
		return chain.count()
	end 'size'
end 'Bag'

typealias StrBag = Bag with String

function main() returns ExitCode
	var b = StrBag.create()
	b.add("a string long enough to be heap allocated")
	b.add("another string long enough to be heap allocated")
	return b.size()
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Bag.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.movRegReg rcx, rax
    x64.callDirect __retain_type_param
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_cont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __layout_Bag_String]
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.storeBaseDispReg.word64 [rbx + 0], r12
  __il_cont#5:
    x64.leaRegRdata rdx, [rip + __str_rec_2]  ; "a string long enough to be heap allocated"
    x64.leaRegRdata rax, [rip + __layout_Bag_String]
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.add
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "another string long enough to be heap allocated"
    x64.leaRegRdata rax, [rip + __layout_Bag_String]
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.add
  __il_body#9:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
  __il_body#11:
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
  __il_cont#4:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Bag_String
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at the-whole-chain-over-a-managed-element.test:44: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
