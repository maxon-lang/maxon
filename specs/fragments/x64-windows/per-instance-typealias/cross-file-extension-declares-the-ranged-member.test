// Test: cross-file-extension-declares-the-ranged-member
// --- file: a.maxon
export typealias Num = int(0 to 200)

export type Holder
	export var v as Num

	export static function create(v Num) returns Holder
		return Holder{v: v}
	end 'create'
end 'Holder'

extension Holder
	export typealias Idx = int(0 to 100)

	export function fromA(i Idx) returns Num
		return self.v + (i as Num)
	end 'fromA'
end 'Holder'

// --- file: b.maxon
extension Holder
	export function fromB(i Idx) returns Num
		return self.v + (i as Num)
	end 'fromB'
end 'Holder'

// --- file: main.maxon
function main() returns ExitCode
	let h = Holder.create(1)
	let total = h.fromA(3) + h.fromB(30)
	if total == 35 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
  __mrt_program_started@27 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __rc_ok#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __rc_ok#11:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 3
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#15
  __rc_chk#16:
    x64.cmpRegImm32 rax, 200
    x64.jcc greater, __rc_panic#15
  __rc_ok#18:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.leaRegRegImm32 rcx, rcx, 30
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#22
  __rc_chk#23:
    x64.cmpRegImm32 rcx, 200
    x64.jcc greater, __rc_panic#22
  __il_cont:
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 35
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#15:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a.maxon:15: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#22:
