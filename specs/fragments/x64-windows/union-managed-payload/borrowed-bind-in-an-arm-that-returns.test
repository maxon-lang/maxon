// Test: borrowed-bind-in-an-arm-that-returns
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer
	match m 'k'
		silent then return 0
		text(s) then print(s)
	end 'k'
	return 3
end 'show'

function main() returns ExitCode
	let m = M.text("a returned-arm payload string, long enough to be a real heap allocation")
	return show(m) as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @show {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
  matchcont:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "a returned-arm payload string, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegReg rcx, r12
    x64.callDirect show
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at borrowed-bind-in-an-arm-that-returns.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
