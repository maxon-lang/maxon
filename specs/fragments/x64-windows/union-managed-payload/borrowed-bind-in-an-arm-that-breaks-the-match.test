// Test: borrowed-bind-in-an-arm-that-breaks-the-match
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 1000)

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer
	var i = 0 as Round
	var n = 0 as Integer
	var seen = 0 as Integer
	while i < 200 'spin'
		match m 'k'
			text(s) then seen = s.byteLength() and fallthrough
			silent then break 'k'
		end 'k'
		n = n + 7
		i = i + 1
	end 'spin'
	return n if seen > 0 else 0
end 'show'

function main() returns ExitCode
	let m = M.text("a match-break payload string, long enough to be a real heap allocation")
	print("n={show(m)}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "a match-break payload string, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "n="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot3, rcx
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
  __il_body#4:
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  spin:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm:
    x64.loadRegBaseDisp.word64 r15, [r12 + 8]
    x64.movRegReg rcx, r15
    x64.callDirect __mm_incref
  __il_body#18:
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.storeSlotReg slot2, rax
  __il_cont#17:
    x64.movRegReg rcx, r15
    x64.callDirect __str_decref
    x64.loadRegSlot rax, slot2
  matchcont:
    x64.leaRegRegImm32 r14, r14, 7
    x64.leaRegRegImm32 r13, r13, 1
  whilehdr:
    x64.cmpRegImm32 r13, 200
    x64.jcc less, spin
    x64.jmp whileexit
  matchdead:
  whileexit:
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, __il_cont#3
  ternaryfalse:
    x64.movRegImm32 r12, 0
    x64.movRegReg r14, r12
  __il_cont#3:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRegReg rax, rbx, r13
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.loadRegSlot rdx, slot3
    x64.movRegReg rcx, r15
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [r14 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
