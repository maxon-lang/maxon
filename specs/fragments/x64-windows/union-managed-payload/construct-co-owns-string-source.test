// Test: construct-co-owns-string-source
typealias Integer = int(i64.min to i64.max)

function build(x Integer) returns String
	return "v{x}"
end 'build'

union Message
	silent
	text(body String)
end 'Message'

function main() returns ExitCode
	let msg = build(1)
	let m = Message.text(msg)
	print("{m}")
	print(msg)
	return 0
end 'main'
