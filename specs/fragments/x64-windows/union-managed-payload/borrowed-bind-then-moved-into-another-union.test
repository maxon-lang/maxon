// Test: borrowed-bind-then-moved-into-another-union
union M
	silent
	text(body String)
end 'M'

union Held
	nothing
	holds(v String)
end 'Held'

function rewrap(m M) returns Held
	return match m 'k'
		silent gives Held.nothing
		text(s) gives Held.holds(s)
	end 'k'
end 'rewrap'

function main() returns ExitCode
	let m = M.text("a rewrapped payload string, long enough to be a real heap allocation")
	let h = rewrap(m)
	match h 'j'
		nothing then return 0
		holds(v) then print(v)
	end 'j'
	return 8
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "a rewrapped payload string, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#11
  matcharm#8:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegReg rbx, r8
    x64.jmp __il_cont#6
  matchnext#11:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#10
  matcharm#9:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
