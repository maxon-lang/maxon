// Test: a-var-moved-in-a-fallthrough-arm-is-dropped-on-the-dispatch-edge-of-a-planned-default
typealias Code = int(0 to 255)

function main() returns ExitCode
	var s = "a heap string long enough to be a real allocation".clone()
	var t = "a second heap string long enough to be a real allocation".clone()
	var n = 0 as Code
	match 2 'k'
		1 then t = s and fallthrough
		default then n = n + 7
	end 'k'
	return n as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "a heap string long enough to be a real allocation"
    x64.callDirect String.clone
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "a second heap string long enough to be a real allocation"
    x64.callDirect String.clone
    x64.movRegReg r12, r8
  ftdispatch:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
  __rc_ok:
    x64.movRegImm32 rbx, 7
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
