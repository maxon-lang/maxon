// Test: two-borrowed-unions-a-string-one-and-a-struct-one
typealias Integer = int(i64.min to i64.max)

type Body
	export var mass as Integer

	static function create(mass Integer) returns Self
		return Self{mass: mass}
	end 'create'
end 'Body'

union A
	none
	one(s String)
end 'A'

union B
	none
	two(b Body)
end 'B'

function both(a A, b B) returns Integer
	let x = match a 'x'
		none gives 0
		one(s) gives 5 if s.byteLength() > 0 else 0
	end 'x'
	let y = match b 'y'
		none gives 0
		two(body) gives body.mass
	end 'y'
	return x + y
end 'both'

function main() returns ExitCode
	let a = A.one("the first union's payload, long enough to be a heap string")
	let b = B.two(Body.create(9))
	let r1 = both(a, b: b)
	let r2 = both(a, b: b)
	return (r1 + r2) as ExitCode
end 'main'
---
ExitCode: 28
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @both {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#7
  matcharm#1:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont#8
  matchnext#7:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#6
  matcharm#2:
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r13, 5
    x64.jmp matchcont#5
  ternaryfalse:
    x64.movRegImm32 r13, 0
  matchcont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r12, r13
  matchcont#8:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#12
  matcharm#9:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont#13
  matchnext#12:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#11
  matcharm#10:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rax, r13
  matchcont#13:
    x64.leaRegRegReg r8, r12, rax
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#11:
  matchdead#6:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "the first union's payload, long enough to be a heap string"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 rbx, 9
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect both
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect both
    x64.leaRegRegReg r13, r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_B
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_A
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at two-borrowed-unions-a-string-one-and-a-struct-one.test:39: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
