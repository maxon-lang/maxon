// Test: borrowed-bind-out-of-a-union-held-in-a-struct-field
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 1000)

union M
	silent
	text(body String)
end 'M'

type Holder
	export var m as M

	static function create(m M) returns Self
		return Self{m: m}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(M.text("a field-held payload string, long enough to be a real heap allocation"))
	var i = 0 as Round
	var n = 0 as Integer
	while i < 200 'spin'
		match h.m 'k'
			silent then n = n + 1
			text(s) then n = n + s.byteLength()
		end 'k'
		i = i + 1
	end 'spin'
	print("n={n}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "a field-held payload string, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#10:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
  __il_cont#9:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
    x64.jmp whilehdr
  spin:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#4:
    x64.leaRegRegImm32 rax, r13, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#5:
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
  __il_body#14:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
  __il_cont#13:
    x64.leaRegRegReg r13, r13, rax
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rax, r13
  matchcont:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg r13, rax
  whilehdr:
    x64.cmpRegImm32 r12, 200
    x64.jcc less, spin
    x64.jmp whileexit
  matchdead:
  whileexit:
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "n="
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRegReg rax, r12, r13
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r13
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot1
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
  __il_body#12:
    x64.loadRegSlot rcx, slot2
    x64.callDirect __write_stdout
  __il_cont#11:
    x64.loadRegSlot rcx, slot2
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
