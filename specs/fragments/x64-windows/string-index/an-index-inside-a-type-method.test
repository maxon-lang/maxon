// Test: an-index-inside-a-type-method
type Label
	var text as String

	export static function create(t String) returns Label
		return Label{text: t}
	end 'create'

	export function head() returns String
		return text.slice(text.startIndex(), length: 2)
	end 'head'

	export function width() returns Integer
		let last = text.endIndex()
		return last.charIndex()
	end 'width'

	export function upTo(needle String) returns String
		let hit = try text.findFirst(needle) otherwise text.endIndex()
		return text.slice(text.startIndex(), endIndex: hit)
	end 'upTo'
end 'Label'

function main() returns ExitCode
	var l = Label.create("aébcdé")
	let needle = "cd"
	print("{l.head()} {l.width()} {l.upTo(needle)}\n")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Label.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Label.head {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect String.startIndex
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 2
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect String.slice#StringIndex#GraphemeIndex
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Label.width {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect String.endIndex
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Label.upTo {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect String.findFirst
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect String.endIndex
    x64.movRegReg r12, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
  trycont:
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect String.startIndex
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect String.slice
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

