// Test: char-at-and-index-after-walk-the-clusters
function main() returns ExitCode
	let uni = "aéb👨‍👩‍👧cd"
	var i = uni.startIndex()
	var n = 0
	while n < 6 'walk'
		print(uni.charAt(i).toString())
		print(" {i.charIndex()}")
		print(",{i.bytePos()}\n")
		i = try uni.indexAfter(i) otherwise uni.endIndex()
		n = n + 1
	end 'walk'
	return 0
end 'main'
