    x64.movRegReg rcx, rbx
    x64.callDirect String.startIndex
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_9]  ; "ghij"
    x64.movRegReg rcx, rbx
    x64.callDirect String.findFirst
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  __il_body#30:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
  __il_body#31:
    x64.loadRegBaseDisp.byte rax, [rbx + 48]
  __il_cont#28:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#20
  oneByteEach:
    x64.movRegReg rcx, r13
    x64.jmp __il_body#27
  ifcont#20:
    x64.movRegImm32 r14, 0
    x64.movRegImm32 rdx, 0
    x64.jmp whilehdr
  countLoop:
    x64.movRegReg rcx, rbx
    x64.callDirect findGraphemeEnd
    x64.leaRegRegImm32 r14, r14, 1
    x64.movRegReg rdx, r8
  whilehdr:
    x64.cmpRegReg rdx, r13
    x64.jcc less, countLoop
  whileexit:
    x64.cmpRegImm32 r14, 0
    x64.jcc less, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
  __il_body#27:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
  __il_cont#26:
    x64.callDirect StringIndex.create
  __il_cont#13:
    x64.movRegReg r13, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
  trycont:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.cmpRegReg rax, rcx
    x64.jcc aboveEqual, ifelse#5
  ordered:
    x64.leaRegRdata rcx, [rip + __str_rec_10]  ; "lt\x0a"
    x64.callDirect print
    x64.jmp ifcont#6
  ifelse#5:
    x64.leaRegRdata rcx, [rip + __str_rec_11]  ; "NOT lt\x0a"
    x64.callDirect print
  ifcont#6:
    x64.movRegReg rcx, rbx
    x64.callDirect String.startIndex
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rbx
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifelse#8
  same:
    x64.leaRegRdata rcx, [rip + __str_rec_12]  ; "eq\x0a"
    x64.callDirect print
    x64.jmp ifcont#9
  ifelse#8:
    x64.leaRegRdata rcx, [rip + __str_rec_13]  ; "NOT eq\x0a"
    x64.callDirect print
  ifcont#9:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegReg rax, rcx
