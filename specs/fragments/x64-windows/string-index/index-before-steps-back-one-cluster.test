// Test: index-before-steps-back-one-cluster
function main() returns ExitCode
	let uni = "aéb👨‍👩‍👧cd"
	var back = uni.endIndex()
	var m = 0
	while m < 3 'walkBack'
		back = try uni.indexBefore(back) otherwise uni.startIndex()
		print("{back.charIndex()}")
		print(",{back.bytePos()}\n")
		m = m + 1
	end 'walkBack'
	return 0
end 'main'
