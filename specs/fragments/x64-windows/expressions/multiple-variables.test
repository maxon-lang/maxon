// Test: multiple-variables
function main() returns ExitCode
	let x = 42
	let y = 10
	let result = x + y
	return result
end 'main'
---
ExitCode: 52
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 52
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
