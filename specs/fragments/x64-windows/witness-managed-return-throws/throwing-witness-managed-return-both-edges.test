  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.leaRegRdata r10, [rip + __witness_Backend.ChunkMaker]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
