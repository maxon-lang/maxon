// Test: match-statements.fallthrough-to-default
function main() returns ExitCode
	let x = 3
	var result = 0
	match x 'check'
		1 then result = 10
		2 then result = 20
		3 then result = result + 20 and fallthrough
		default then result = result + 100
	end 'check'
	return result
end 'main'
---
ExitCode: 120
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 rax, 20
  matchdefault:
    x64.leaRegRegImm32 r8, rax, 100
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
