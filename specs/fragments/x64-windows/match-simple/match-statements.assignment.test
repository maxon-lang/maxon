// Test: match-statements.assignment
function main() returns ExitCode
	let x = 2
	var result = 0
	match x 'process'
		1 then result = 100
		2 then result = 120
		default then result = 0
	end 'process'
	return result
end 'main'
---
ExitCode: 120
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 120
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
