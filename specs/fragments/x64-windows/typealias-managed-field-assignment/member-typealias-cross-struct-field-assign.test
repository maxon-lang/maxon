// Test: member-typealias-cross-struct-field-assign
typealias Num = int(i64.min to i64.max)

type Blk
	typealias NumArray = Array with Num
	export var args as NumArray

	export static function create() returns Blk
		return Self{args: NumArray.create()}
	end 'create'
end 'Blk'

function main() returns ExitCode
	var i = 0

	while i < 3000 'l'
		var a = Blk.create()
		a.args.push(i)
		var b = Blk.create()
		b.args = a.args
		i = i + 1
	end 'l'

	print("done")
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Blk.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  whilehdr:
    x64.cmpRegImm32 rbx, 3000
    x64.jcc greaterEqual, whileexit
  l:
    x64.callDirect Blk.create
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.callDirect Blk.create
    x64.movRegReg r13, r8
    x64.loadRegBaseDisp.word64 r14, [r12 + 0]
    x64.loadRegBaseDisp.word64 r15, [r13 + 0]
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Blk
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Blk
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "done"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
