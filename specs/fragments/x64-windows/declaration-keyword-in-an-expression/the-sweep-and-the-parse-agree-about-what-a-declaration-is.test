// Test: the-sweep-and-the-parse-agree-about-what-a-declaration-is
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

function trips(m Marker) returns bool
	return m == Marker.function and (true or false)
end 'trips'

type Holder
	export var base as Idx

	static function create() returns Holder
		return Self{base: 12}
	end 'create'

	function total() returns Idx
		return self.base + bonus()
	end 'total'

	function bonus() returns Idx
		return 10
	end 'bonus'
end 'Holder'

function exported() returns Idx
	let h = Holder.create()
	return h.total()
end 'exported'

function scoped() returns Idx
	return 20
end 'scoped'

function main() returns ExitCode
	if trips(Marker.function) 'ok'
		return (exported() + scoped()) as ExitCode
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  __il_body#17:
    x64.movRegImm32 rbx, 12
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#19:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_cont#23:
    x64.leaRegRegImm32 rbx, rax, 10
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 100
    x64.jcc greater, __rc_panic
  __il_cont#18:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  __il_cont#12:
    x64.leaRegRegImm32 r8, rbx, 20
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at the-sweep-and-the-parse-agree-about-what-a-declaration-is.test:21: Range check failed: value outside typealias 'Idx'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
