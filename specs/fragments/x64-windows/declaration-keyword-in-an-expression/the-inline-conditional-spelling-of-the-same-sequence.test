// Test: the-inline-conditional-spelling-of-the-same-sequence
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

function picked(flag bool) returns Marker
	return Marker.function if (flag) else Marker.other
end 'picked'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	if picked(true) == Marker.function 'ok'
		return pick(Victim.found(42))
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ok:
    x64.movRegImm32 r8, 42
    x64.movRegImm32 rax, 0
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm:
    x64.movRegImm32 r8, 0
  __il_cont:
    x64.popReg rbp
    x64.ret
  matchdead:
}
