// Test: deeply-nested-struct

typealias Integer = int(i64.min to i64.max)

type Level1
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Level1'

type Level2
	export var inner as Level1

	static function create(inner Level1) returns Self
		return Self{inner: inner}
	end 'create'
end 'Level2'

type Level3
	export var inner as Level2

	static function create(inner Level2) returns Self
		return Self{inner: inner}
	end 'create'
end 'Level3'

function main() returns ExitCode
	let l1 = Level1.create(42)
	let l2 = Level2.create(l1)
	let l3 = Level3.create(l2)
	return l3.inner.inner.value
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 42
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#6:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
  __il_cont#5:
    x64.leaRegFunc rdx, [rip + __clone_Level2]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_own_deep
    x64.movRegReg rbx, r8
  __il_body#9:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegFunc rdx, [rip + __clone_Level2]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_own_deep
    x64.storeBaseDispReg.word64 [r14 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Level2
  __il_cont#4:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Level3
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Level2
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at deeply-nested-struct.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
