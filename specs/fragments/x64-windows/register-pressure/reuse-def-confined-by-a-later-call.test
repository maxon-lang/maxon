  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @keep {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc greaterEqual, ifcont
  never:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; ""
    x64.callDirect print
  ifcont:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

