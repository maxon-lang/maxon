// Test: a-hot-call-in-a-loop-confines-as-before
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function weigh(a WordArray, i Word) returns Word
	let v = try a.get(i) otherwise 0
	if v > 2 'heavy'
		print("")
	end 'heavy'
	return v * 2
end 'weigh'

function total(a WordArray, n Word) returns Word
	var t = 0
	var w = 5
	for i in 0 upto n 'each'
		w = w + i
		t = t + weigh(a, i: i) + w
	end 'each'
	return t
end 'total'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 5 'seed'
		a.push(i)
	end 'seed'
	if total(a, n: 5) != 65 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 5
    x64.jcc less, seed
  __il_body#8:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 5
    x64.movRegImm32 r13, 0
    x64.jmp forhdr#9
  each:
    x64.leaRegRegReg r14, rax, r13
  __rc_ok:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 r15, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r13*8 + 0]
    x64.movRegReg r8, rax
  tryok:
    x64.movRegReg r15, r8
  trycont:
    x64.cmpRegImm32 r15, 2
    x64.jcc lessEqual, ifcont#19
  heavy:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; ""
  __il_body#26:
    x64.callDirect __write_stdout
  ifcont#19:
    x64.imulRegRegImm32 rax, r15, 2
  __il_cont#13:
    x64.leaRegRegReg rax, r12, rax
    x64.leaRegRegReg rax, rax, r14
  forstep#11:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, rax
    x64.movRegReg rax, r14
  forhdr#9:
    x64.cmpRegImm32 r13, 5
    x64.jcc less, each
  __il_cont#7:
    x64.cmpRegImm32 r12, 65
    x64.jcc equal, ifcont#6
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
}
