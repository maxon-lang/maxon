    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 r15, 99
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 r15, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 r15, [r15 + rax*8 + 0]
  trycont:
    x64.leaRegRegReg r14, r14, r15
