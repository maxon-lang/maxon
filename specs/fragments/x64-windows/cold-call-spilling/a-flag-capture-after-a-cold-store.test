  matchcont:
    x64.leaRegRegReg rsi, rsi, rax
    x64.imulRegReg rsi, rsi, r15
    x64.xorRegReg rdi, rdi, rsi
    x64.imulRegReg rdi, rdi, r15
    x64.leaRegRegReg r8, r8, rdi
    x64.imulRegReg r8, r8, r15
