    x64.leaRegRegReg r14, r14, rdi
    x64.leaRegRegReg r14, r14, r8
    x64.leaRegRegReg r14, r14, r9
    x64.leaRegRegReg r14, r14, r10
    x64.leaRegRegReg r14, r14, r11
    x64.leaRegRegReg r14, r14, rbx
    x64.leaRegRegReg r14, r14, r12
    x64.leaRegRegReg r14, r14, r13
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegReg rax, rdx
    x64.jcc less, each
  forexit:
    x64.movRegReg r8, r14
    x64.epilogue 120
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot1, rax
    x64.storeSlotReg slot2, rcx
    x64.storeSlotReg slot3, rdx
    x64.storeSlotReg slot4, rsi
    x64.storeSlotReg slot5, rdi
    x64.storeSlotReg slot6, r8
    x64.storeSlotReg slot7, r9
    x64.storeSlotReg slot8, r10
    x64.storeSlotReg slot9, r11
    x64.movRegReg rdx, rax
    x64.callDirect __managed_get
    x64.movRegReg r15, r8
    x64.storeSlotReg slot0, r15
    x64.movRegReg r15, r10
    x64.loadRegSlot rax, slot1
    x64.loadRegSlot rcx, slot2
    x64.loadRegSlot rdx, slot3
    x64.loadRegSlot rsi, slot4
    x64.loadRegSlot rdi, slot5
    x64.loadRegSlot r8, slot6
    x64.loadRegSlot r9, slot7
    x64.loadRegSlot r10, slot8
    x64.loadRegSlot r11, slot9
    x64.cmpRegImm32 r15, 0
    x64.jcc notEqual, tryerr
  critsplit:
    x64.loadRegSlot r15, slot0
    x64.jmp trycont
}

