// Test: a-cold-arm-that-runs-reloads-what-it-saved
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function walk(a WordArray, n Word) returns Word
	var t = 0
	var w = 1
	for i in 0 upto n 'each'
		w = w * 3 + i
		t = t + (try a.get(i) otherwise 99) + w
	end 'each'
	return t
end 'walk'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 5 'seed'
		a.push(i)
	end 'seed'
	if walk(a, n: 9) != 37285 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @walk {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 96
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rsi, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.loadRegBaseDisp.word64 r9, [rcx + 0]
    x64.jmp forhdr
  each:
    x64.imulRegRegImm32 rax, rax, 3
    x64.leaRegRegReg rax, rax, rsi
  __rc_ok:
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 r10, 99
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 r10, [r9 + rsi*8 + 0]
  trycont:
    x64.leaRegRegReg r8, r8, r10
    x64.leaRegRegReg r8, r8, rax
  forstep:
    x64.leaRegRegImm32 rsi, rsi, 1
  forhdr:
    x64.cmpRegReg rsi, rdx
    x64.jcc less, each
  forexit:
    x64.epilogue 96
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.storeSlotReg slot6, r9
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.movRegReg r11, r10
    x64.movRegReg r10, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.loadRegSlot r9, slot6
    x64.cmpRegImm32 r11, 0
    x64.jcc notEqual, tryerr
    x64.jmp trycont
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr:
    x64.cmpRegImm32 r12, 5
    x64.jcc less, seed
  forexit:
    x64.movRegImm32 rdx, 9
    x64.movRegReg rcx, rbx
    x64.callDirect walk
    x64.cmpRegImm32 r8, 37285
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
