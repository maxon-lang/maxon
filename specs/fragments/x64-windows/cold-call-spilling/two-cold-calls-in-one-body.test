// Test: two-cold-calls-in-one-body
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function pairs(a WordArray, n Word) returns Word
	var t = 0
	var w = 2
	for i in 0 upto n 'each'
		let first = try a.get(i) otherwise 100
		let second = try a.get(i + 1) otherwise 1000
		w = w + 1
		t = t + first + second + w
	end 'each'
	return t
end 'pairs'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 4 'seed'
		a.push(i)
	end 'seed'
	if pairs(a, n: 6) != 3245 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @pairs {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 104
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 2
    x64.movRegImm32 rsi, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rdi, [rcx + 8]
    x64.loadRegBaseDisp.word64 r9, [rcx + 0]
    x64.jmp forhdr
  __rc_ok#11:
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow#16
    x64.jmp __im_load#17
  tryerr#6:
    x64.movRegImm32 r10, 100
    x64.jmp trycont#7
  __im_load#17:
    x64.loadRegBaseIndexScale.word64 r10, [r9 + rsi*8 + 0]
    x64.movRegReg r11, r10
  tryok:
    x64.movRegReg r10, r11
  trycont#7:
    x64.leaRegRegImm32 rsi, rsi, 1
  __rc_ok#13:
    x64.cmpRegReg rsi, rdi
    x64.jcc aboveEqual, __im_slow#19
    x64.jmp __im_load#20
  tryerr#9:
    x64.movRegImm32 r11, 1000
    x64.jmp trycont#10
  __im_load#20:
    x64.loadRegBaseIndexScale.word64 r11, [r9 + rsi*8 + 0]
  trycont#10:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegReg r8, r8, r10
    x64.leaRegRegReg r8, r8, r11
    x64.leaRegRegReg r8, r8, rax
  forhdr:
    x64.cmpRegReg rsi, rdx
    x64.jcc less, __rc_ok#11
  forexit:
    x64.epilogue 104
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow#16:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.storeSlotReg slot6, r9
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.movRegReg r11, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.loadRegSlot r9, slot6
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok
  __im_slow#19:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.storeSlotReg slot6, r9
    x64.storeSlotReg slot7, r10
    x64.movRegReg rdx, rsi
    x64.callDirect __managed_get
    x64.movRegReg r11, r8
    x64.movRegReg rbx, r10
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.loadRegSlot r9, slot6
    x64.loadRegSlot r10, slot7
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, tryerr#9
    x64.jmp trycont#10
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr:
    x64.cmpRegImm32 r12, 4
    x64.jcc less, seed
  forexit:
    x64.movRegImm32 rdx, 6
    x64.movRegReg rcx, rbx
    x64.callDirect pairs
    x64.cmpRegImm32 r8, 3245
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
