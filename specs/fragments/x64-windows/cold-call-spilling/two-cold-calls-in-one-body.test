// Test: two-cold-calls-in-one-body
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function pairs(a WordArray, n Word) returns Word
	var t = 0
	var w = 2
	for i in 0 upto n 'each'
		let first = try a.get(i) otherwise 100
		let second = try a.get(i + 1) otherwise 1000
		w = w + 1
		t = t + first + second + w
	end 'each'
	return t
end 'pairs'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 4 'seed'
		a.push(i)
	end 'seed'
	if pairs(a, n: 6) != 3245 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 80
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 4
    x64.jcc less, seed
  __il_body:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rsi, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdi, [rbx + 0]
    x64.jmp forhdr#9
  __rc_ok#19:
    x64.cmpRegReg rdx, rsi
    x64.jcc aboveEqual, __im_slow#24
    x64.jmp __im_load#25
  tryerr#14:
    x64.movRegImm32 r8, 100
    x64.jmp trycont#15
  __im_load#25:
    x64.loadRegBaseIndexScale.word64 r8, [rdi + rdx*8 + 0]
  trycont#15:
    x64.leaRegRegImm32 rdx, rdx, 1
  __rc_ok#21:
    x64.cmpRegReg rdx, rsi
    x64.jcc aboveEqual, __im_slow#27
    x64.jmp __im_load#28
  tryerr#17:
    x64.movRegImm32 r9, 1000
    x64.jmp trycont#18
  __im_load#28:
    x64.loadRegBaseIndexScale.word64 r9, [rdi + rdx*8 + 0]
  trycont#18:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg rax, rax, rcx
  forhdr#9:
    x64.cmpRegImm32 rdx, 6
    x64.jcc less, __rc_ok#19
  forexit:
    x64.cmpRegImm32 rax, 3245
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow#24:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#14
    x64.jmp trycont#15
  __im_slow#27:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#17
    x64.jmp trycont#18
}
