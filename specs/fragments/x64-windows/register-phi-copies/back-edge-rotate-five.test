// Test: back-edge-rotate-five
function rotate5(p Integer) returns Integer
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var d = p + 4
	var e = p + 5
	var i = 0
	while i < 3 'loop'
		let t = a
		a = b
		b = c
		c = d
		d = e
		e = t
		i = i + 1
	end 'loop'
	return a * 10000 + b * 1000 + c * 100 + d * 10 + e
end 'rotate5'

function main() returns ExitCode
	let r = rotate5(0)
	if r == 45123 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rsi, 4
    x64.movRegImm32 rdi, 5
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  loop:
    x64.leaRegRegImm32 r8, r8, 1
    x64.xchgRegReg rax, rcx
    x64.xchgRegReg rcx, rdx
    x64.xchgRegReg rdx, rsi
    x64.xchgRegReg rsi, rdi
  whilehdr:
    x64.cmpRegImm32 r8, 3
    x64.jcc less, loop
  whileexit:
    x64.imulRegRegImm32 rax, rax, 10000
    x64.imulRegRegImm32 rcx, rcx, 1000
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rdx, 100
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rsi, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdi
  __il_cont:
    x64.cmpRegImm32 rax, 45123
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
