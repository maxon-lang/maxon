// Test: back-edge-swap
function swapLoop(p Integer) returns Integer
	var a = p + 1
	var b = p + 2
	var i = 0
	while i < 3 'loop'
		let t = a
		a = b
		b = t
		i = i + 1
	end 'loop'
	return a * 10 + b
end 'swapLoop'

function main() returns ExitCode
	let r = swapLoop(0)
	if r == 21 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.jmp whilehdr
  loop:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.xchgRegReg rax, rcx
  whilehdr:
    x64.cmpRegImm32 rdx, 3
    x64.jcc less, loop
  whileexit:
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegReg rax, rax, rcx
  __il_cont:
    x64.cmpRegImm32 rax, 21
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
