// Test: two-preds-different-permutations
function twoPerms(p Integer) returns Integer
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var i = 0
	while i < 4 'loop'
		if i mod 2 == 0 'even'
			let t = a
			a = b
			b = t
		end 'even' else 'odd'
			let u = b
			b = c
			c = u
		end 'odd'
		i = i + 1
	end 'loop'
	return a * 100 + b * 10 + c
end 'twoPerms'

function main() returns ExitCode
	let r = twoPerms(0)
	if r == 312 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rsi, 0
    x64.jmp whilehdr
  loop:
    x64.movRegReg rdi, rsi
    x64.sarRegImm8 rdi, rsi, 63
    x64.shrRegImm8 rdi, rdi, 63
    x64.leaRegRegReg rdi, rsi, rdi
    x64.sarRegImm8 rdi, rdi, 1
    x64.imulRegRegImm32 rdi, rdi, 2
    x64.movRegReg r8, rsi
    x64.subRegReg r8, rsi, rdi
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#10
  ifelse:
    x64.xchgRegReg rcx, rax
    x64.xchgRegReg rax, rdx
  ifcont#10:
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.xchgRegReg rax, rcx
  whilehdr:
    x64.cmpRegImm32 rsi, 4
    x64.jcc less, loop
  whileexit:
    x64.imulRegRegImm32 rax, rax, 100
    x64.imulRegRegImm32 rcx, rcx, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
  __il_cont:
    x64.cmpRegImm32 rax, 312
    x64.jcc notEqual, ifcont#2
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
