// Test: builtins-clock.thread-cpu-ticks-monotonic
function main() returns ExitCode
	let first = __Builtins.threadCpuTicks()
	let second = __Builtins.threadCpuTicks()
	let third = __Builtins.threadCpuTicks()
	var score = 0
	if second >= first 'firstPair'
		score = score + 1
	end 'firstPair'
	if third >= second 'secondPair'
		score = score + 2
	end 'secondPair'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __thread_cpu_ticks
    x64.movRegReg rbx, r8
    x64.callDirect __thread_cpu_ticks
    x64.movRegReg r12, r8
    x64.callDirect __thread_cpu_ticks
    x64.movRegImm32 rax, 0
    x64.cmpRegReg r12, rbx
    x64.jcc less, ifcont
  firstPair:
    x64.movRegImm32 rax, 1
  ifcont:
    x64.cmpRegReg r8, r12
    x64.jcc less, critsplit
  secondPair:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rax
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
