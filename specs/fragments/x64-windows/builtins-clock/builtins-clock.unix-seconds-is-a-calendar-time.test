// Test: builtins-clock.unix-seconds-is-a-calendar-time
function main() returns ExitCode
	let now = __Builtins.currentUnixTimeSeconds()
	var score = 0
	if now > 1735689600 'afterKnownPast'
		score = score + 1
	end 'afterKnownPast'
	if now < 4102444800 'beforeFarFuture'
		score = score + 1
	end 'beforeFarFuture'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __clock_now_unix_s
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 1735689600
    x64.jcc lessEqual, ifcont
  afterKnownPast:
    x64.movRegImm32 rax, 1
  ifcont:
    x64.movRegImm32 rcx, 4102444800
    x64.cmpRegReg r8, rcx
    x64.jcc greaterEqual, critsplit
  beforeFarFuture:
    x64.leaRegRegImm32 r8, rax, 1
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rax
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
