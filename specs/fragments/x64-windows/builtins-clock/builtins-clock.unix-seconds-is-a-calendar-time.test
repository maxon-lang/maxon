// Test: builtins-clock.unix-seconds-is-a-calendar-time
function main() returns ExitCode
	let now = __Builtins.currentUnixTimeSeconds()
	var score = 0
	if now > 1735689600 'afterKnownPast'
		score = score + 1
	end 'afterKnownPast'
	if now < 4102444800 'beforeFarFuture'
		score = score + 1
	end 'beforeFarFuture'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __clock_now_unix_s
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 1735689600
    x64.jcc lessEqual, ifcont#2
  afterKnownPast:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.movRegImm32 rcx, 4102444800
    x64.cmpRegReg r8, rcx
    x64.jcc greaterEqual, critsplit
  beforeFarFuture:
    x64.leaRegRegImm32 r8, rax, 1
    x64.jmp ifcont#4
  critsplit:
    x64.movRegReg r8, rax
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at builtins-clock.unix-seconds-is-a-calendar-time.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
