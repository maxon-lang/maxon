// Test: a-bare-call-inside-a-type-extension-reaches-the-conformers-own-method
typealias Idx = int(0 to u64.max)

type Box uses T
	export var slot as T

	static function make(v T) returns Self
		return Self{slot: v}
	end 'make'

	function tag() returns Idx
		return 5
	end 'tag'
end 'Box'

export extension Box
	function bareCall() returns Idx
		return tag()
	end 'bareCall'

	function qualifiedCall() returns Idx
		return self.tag()
	end 'qualifiedCall'
end 'Box'

function main() returns ExitCode
	let b = Box.make(1 as Idx)
	return (b.bareCall() + b.qualifiedCall() * 2) as ExitCode
end 'main'
---
ExitCode: 15
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#13:
    x64.movRegImm32 rax, 5
  __il_cont:
    x64.imulRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 rbx, rax, 5
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
