// Test: a-bare-call-inside-an-extension-reaches-a-method-a-sibling-extension-published
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer

	static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'
end 'Box'

extension Box
	function tripled() returns Integer
		return self.v * 3
	end 'tripled'
end 'Box'

extension Box
	function reported() returns Integer
		return tripled() + 1
	end 'reported'
end 'Box'

function main() returns ExitCode
	let b = Box.of(5)
	return b.reported() as ExitCode
end 'main'
---
ExitCode: 16
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 5
  __il_body#5:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#9:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.imulRegRegImm32 rax, rax, 3
  __il_cont#8:
    x64.leaRegRegImm32 rbx, rax, 1
  __il_cont#6:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-bare-call-inside-an-extension-reaches-a-method-a-sibling-extension-published.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
