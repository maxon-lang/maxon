    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r15, r8
    x64.subRegReg r15, r8, r12
    x64.callDirect __mm_counter_raw_alloc_live
    x64.movRegReg r12, r8
    x64.subRegReg r12, r8, r13
    x64.callDirect __sched_gt_recycle_count
    x64.subRegReg r8, r8, r14
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rbx, 9
    x64.jcc notEqual, ifcont#2
  everyThreadRanExactlyOnce:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.cmpRegImm32 r15, 0
    x64.movRegImm32 rcx, 0
    x64.jcc notEqual, scmerge
  andrhs:
    x64.cmpRegImm32 r8, 8
    x64.setccReg equal, rcx
  scmerge:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#6
  everySpawnReusedAStruct:
    x64.leaRegRegImm32 rax, rax, 2
  ifcont#6:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, critsplit
  andNothingWasLeftLive:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp __rc_ok
  critsplit:
    x64.movRegReg r8, rax
  __rc_ok:
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
