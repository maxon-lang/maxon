// Test: discard-a-position
function main() returns ExitCode
	let m = [1: 10, 2: 20]
	var total = 0
	for (_, v) in m 'each'
		total = total + v
	end 'each'
	return total
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
