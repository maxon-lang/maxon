// Test: wide-file-cast-still-accepted
// --- file: narrow.maxon
typealias Unit = int(1 to 2)

export function unitVal() returns ExitCode
	let u = 2 as Unit
	return u
end 'unitVal'

// --- file: wide.maxon
typealias Unit = int(0 to u64.max)

export function wideVal() returns ExitCode
	let w = 40 as Unit
	return w
end 'wideVal'

// --- file: main.maxon
function main() returns ExitCode
	return unitVal() + wideVal()
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 2
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 40
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
