// Test: sibling-files-tuple-alias-of-one-name-crosses-as-a-parameter
// --- file: a-main.maxon
function main() returns ExitCode
	useGamma()

	return relayA((4, 1))
end 'main'

// --- file: m-alpha.maxon
export function relayA(p Pair) returns ExitCode
	return (p.0 - p.1) as ExitCode
end 'relayA'

typealias Pair = (int, int)

// --- file: z-gamma.maxon
