// Test: overloaded-conformer-is-a-candidate
typealias Code = int(0 to u32.max)

var noise = 0 as Code

interface Digest
	function digest() returns Code
end 'Digest'

type Quiet implements Digest
	export var x as Code

	static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'

	function digest() returns Code
		return self.x
	end 'digest'
end 'Quiet'

type Loud implements Digest
	export var x as Code

	static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'

	function digest(salt Code) returns Code
		return self.x + salt
	end 'digest'

	function digest() returns Code
		noise = noise + 1
		return self.x
	end 'digest'
end 'Loud'

type Box uses T where T is Digest
	export var item as T

	static function create(item T) returns Self
		return Self{ item: item }
	end 'create'

	function itemDigest() returns Code
		return self.item.digest()
	end 'itemDigest'
end 'Box'

typealias LoudBox = Box with Loud
typealias QuietBox = Box with Quiet

function main() returns ExitCode
	let loud = LoudBox.create(Loud.create(3))
	_ = loud.itemDigest()
	let quiet = QuietBox.create(Quiet.create(3))
	return quiet.itemDigest() + noise - 4
end 'main'
---
ExitCode: 0
---
data {
  __data_noise@0 = i64 0
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
  __ds_base@72 = i64 0
  __dbg_ctl@80 = i64 0
  __mrt_console_probe_stdin@88 = i8 0
  __mrt_console_probe_stdout@89 = i8 0
  __mrt_console_probe_stderr@90 = i8 0
}

func @Quiet.digest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Loud.digest# {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_noise
    x64.aluBaseDispImm32.add [rax + 0], 1
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Box.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Box.itemDigest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rdx + 48]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 3
  __rc_ok#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.leaRegRdata rdx, [rip + __witness_Loud.Digest]
    x64.movRegReg rcx, r8
    x64.callDirect Box.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRdata rdx, [rip + __witness_Loud.Digest]
    x64.movRegReg rcx, rbx
    x64.callDirect Box.itemDigest
    x64.movRegImm32 r12, 3
  __rc_ok#11:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
  __il_cont#4:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_own
    x64.leaRegRdata rdx, [rip + __witness_Quiet.Digest]
    x64.movRegReg rcx, r8
    x64.callDirect Box.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.leaRegRdata rdx, [rip + __witness_Quiet.Digest]
    x64.movRegReg rcx, r12
    x64.callDirect Box.itemDigest
    x64.leaRegGlobal rax, __data_noise
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegReg rax, r8, rax
    x64.leaRegRegImm32 r13, rax, -4
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok#1:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Box_Quiet
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Box_Loud
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at overloaded-conformer-is-a-candidate.test:58: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
