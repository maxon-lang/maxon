// Test: Self-static-called-from-an-instance-method-of-a-generic
typealias Num = int(0 to 1000)

type Holder uses T
	export var v as T

	static function make(x T) returns Self
		return Self{v: x}
	end 'make'

	function twin() returns T
		return Self.make(self.v).v
	end 'twin'
end 'Holder'

typealias NumHolder = Holder with Num

function main() returns ExitCode
	return NumHolder.make(42).twin()
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Holder.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rbx, [rip + __layout_Holder_Num]
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect Holder.make
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rdx, [r12 + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __retain_type_param
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __destruct_dict_Holder
  __il_cont:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
