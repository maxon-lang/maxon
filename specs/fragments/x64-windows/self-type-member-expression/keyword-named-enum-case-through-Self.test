// Test: keyword-named-enum-case-through-Self
enum Kw
	while
	end

	function pick() returns Kw
		if self == Self.while 'w'
			return Self.end
		end 'w'
		return Self.while
	end 'pick'
end 'Kw'

function main() returns ExitCode
	let k = Kw.while
	if k.pick() == Kw.end 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
