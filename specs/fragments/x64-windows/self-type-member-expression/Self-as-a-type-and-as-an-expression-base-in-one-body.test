// Test: Self-as-a-type-and-as-an-expression-base-in-one-body
enum Toggle
	off
	on

	function same() returns Self
		return self
	end 'same'

	function matches(other Self) returns bool
		return self == other
	end 'matches'

	function isOff() returns bool
		return self.matches(Self.off)
	end 'isOff'
end 'Toggle'

function main() returns ExitCode
	let t = Toggle.off
	if t.isOff() 'ok'
		if t.same() == Toggle.off 'ok2'
			return 42
		end 'ok2'
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ok2:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
