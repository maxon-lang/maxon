// Test: a-struct-literal-field-survives-a-diverging-try
typealias StrArray = Array with String
typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

function mayFail(n Integer) returns Integer throws Boom
	if n > 100 'big'
		throw Boom.bad
	end 'big'
	return n
end 'mayFail'

type Conf
	export var argv as StrArray
	export var n as Integer

	static function create(n Integer) returns Conf
		return Conf{argv: StrArray.create(), n: try mayFail(n) otherwise panic("mayFail cannot fail for a small n")}
	end 'create'
end 'Conf'

function main() returns ExitCode
	var c = Conf.create(3)
	c.argv.push("a")
	return c.argv.count() + c.n as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @mayFail {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, ifcont
  big:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 3
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect mayFail
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
  tryok:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rbx, [r13 + 0]
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "a"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 8]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.movRegImm32 rdx, 4294967295
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, __rc_panic#2
  __rc_ok#1:
    x64.leaRegRegReg rbx, rax, rcx
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Conf
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic#5
  __rc_ok#4:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-struct-literal-field-survives-a-diverging-try.test:21: mayFail cannot fail for a small n\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-struct-literal-field-survives-a-diverging-try.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at a-struct-literal-field-survives-a-diverging-try.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
