// Test: a-struct-field-read-cast-to-another-alias-is-a-real-cast
typealias Narrow = int(0 to u32.max)
typealias Wide = int(i64.min to i64.max)

type Segment
	export let base as Narrow

	static function create(base Narrow) returns Self
		return Self{base: base}
	end 'create'
end 'Segment'

function main() returns ExitCode
	let seg = Segment.create(7)
	let w = seg.base as Wide
	return w as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.movRegImm32 r8, 4294967295
    x64.andRegImm32 r8, r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
