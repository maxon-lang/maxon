// Test: the-same-collision-over-a-managed-element
typealias Int = int(i64.min to i64.max)

export type BagIter uses Element implements Iterator with Element
	var item as Element

	static function create(v Element) returns Self
		return Self{item: v}
	end 'create'

	export function current() returns Element
		return item
	end 'current'

	export function advance() throws IterationError
		throw IterationError.exhausted
	end 'advance'
end 'BagIter'

type Bag uses Element implements Iterable with (Element, BagIter)
	var item as Element
	var result as Int

	static function create(v Element) returns Self
		return Self{item: v, result: 0}
	end 'create'

	export function createIterator() returns BagIter throws IterationError
		return BagIter.create(item)
	end 'createIterator'
end 'Bag'

typealias StrBag = Bag with String

function isLong(s String) returns bool
	return s.byteLength() > 5
end 'isLong'

function main() returns ExitCode
	var b = StrBag.create("a string long enough to be heap allocated")
	if b.contains(isLong) 'long'
		print("long\n")
		return 1
	end 'long'
	print("short\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @BagIter.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Bag.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @isLong {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
  __il_cont:
    x64.cmpRegImm32 rax, 5
    x64.setccReg above, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "a string long enough to be heap allocated"
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
