// Test: a-conformer-field-named-like-an-extension-local
typealias Int = int(i64.min to i64.max)

type BagIter uses Element implements Iterator with Element
	var item as Element

	export static function create(v Element) returns Self
		return Self{item: v}
	end 'create'

	export function current() returns Element
		return item
	end 'current'

	export function advance() throws IterationError
		throw IterationError.exhausted
	end 'advance'
end 'BagIter'

type Bag uses Element implements Iterable with (Element, BagIter)
	var item as Element

	export static function create(v Element) returns Self
		return Self{item: v}
	end 'create'

	export function createIterator() returns BagIter throws IterationError
		return BagIter.create(item)
	end 'createIterator'
end 'Bag'

typealias IntBag = Bag with Int

function isBig(n Int) returns bool
	return n > 10
end 'isBig'

function main() returns ExitCode
	var b = IntBag.create(30)
	if b.contains(isBig) 'yes'
		return 1
	end 'yes'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @BagIter.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Bag.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @isBig {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 10
    x64.setccReg greater, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 30
  __il_body#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot0, r8
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont#3:
    x64.leaRegFunc rbx, [rip + __fnref_isBig]
    x64.movRegImm32 r12, 0
    x64.leaRegRdata r13, [rip + __layout_Bag_Int]
  __il_body#6:
    x64.movRegReg rcx, r8
    x64.movRegReg rdx, r13
    x64.callDirect Bag.createIterator
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forhdr
    x64.jmp forjoin
  __il_body#16:
    x64.loadRegBaseDisp.word64 rdx, [r14 + 0]
    x64.movRegReg rcx, r13
    x64.callDirect __retain_type_param
    x64.movRegReg r15, r8
  __il_cont#15:
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.callReg rbx
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#13
  match:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.callDirect __drop_type_param
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rax, rbx
    x64.jmp __il_cont#5
  ifcont#13:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.callDirect __drop_type_param
  forstep:
    x64.movRegReg rcx, r14
    x64.callDirect BagIter.advance
    x64.movRegReg rax, r10
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#16
  forexit:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
  forjoin:
    x64.movRegImm32 rax, 0
  __il_cont#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#2
  yes:
    x64.movRegImm32 rbx, 1
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
