func @Outer.go {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 3
    x64.callDirect Calc.create
    x64.leaRegFunc rcx, [rip + Calc.__loop]
