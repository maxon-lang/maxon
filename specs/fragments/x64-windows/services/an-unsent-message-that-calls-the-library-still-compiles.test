// Test: an-unsent-message-that-calls-the-library-still-compiles
typealias Integer = int(i64.min to i64.max)

type Reader
	var id as Integer

	static function create() returns Self
		return Self{id: 0}
	end 'create'

	export function read() returns Integer
		let line = "hello"
		return line.count() as Integer
	end 'read'
end 'Reader'

function main() returns ExitCode
	let reader = spawn Reader.create()
	_ = reader
	return 7 as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_timer_seq@56 = i64 0
