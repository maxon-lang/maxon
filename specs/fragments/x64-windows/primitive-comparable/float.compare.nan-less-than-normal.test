// Test: float.compare.nan-less-than-normal
function main() returns ExitCode
	// NaN from overflow (inf - inf), NOT `0.0 / 0.0` — a literal zero divisor is now a compile
	// error and a runtime one throws DivisionByZero. Overflow and inf - inf stay silent.
	let inf = 1.0e308 * 10.0
	let nan = inf - inf
	let x = 42.0
	let result = nan.compare(x)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0x7ff0000000000000]
    x64.subsdRegReg xmm0, xmm0, xmm0
    x64.movsdRegRip xmm1, [rip + __fconst_42]
  __il_body:
    x64.ucomisdRegReg xmm0, xmm0
    x64.jcc parity, ifcont#12
  fordered:
    x64.jcc equal, ifcont#15
  ifcont#12:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#15:
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc belowEqual, ifcont#17
  lt:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#17:
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont#19
  gt:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#19:
    x64.movRegImm32 rax, 1
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matcharm#3
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matcharm#3:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
