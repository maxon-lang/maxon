// Test: round.a-declaration-takes-the-name-back
typealias Tally = int(0 to 1000)

function round(n Tally) returns Tally
	return n + 1
end 'round'

function main() returns ExitCode
	return round(10)
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 r8, 11
  __il_cont:
    x64.popReg rbp
    x64.ret
}
