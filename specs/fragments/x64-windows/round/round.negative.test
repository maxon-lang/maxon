// Test: round.negative
function main() returns ExitCode
	let neg = -2.3
	let y = trunc(round(neg))
	return y + 10
end 'main'
---
ExitCode: 8
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 8
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
