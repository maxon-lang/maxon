// Test: crossfile-boxed-union-temporary-is-discarded-by-a-stranger
// --- file: a.maxon
typealias Container = int(0 to 5)

export function fromA() returns ExitCode
	return 2 as Container
end 'fromA'

// --- file: b.maxon
typealias CallTally = int(0 to 100)

export union Container
	empty
	holds(s String)
end 'Container'

var fromBCalls = 0 as CallTally

// `main.maxon` DISCARDS this function's result, which is the whole shape this case is about — so the
// callee must have an effect, or the discard is E3064 (`specs/discarded-results.md`) and the
// program never reaches the union it exists to exercise.
export function fromB() returns Container
	fromBCalls = fromBCalls + 1
	return Container.holds("hi")
end 'fromB'

export function valueOf(c Container) returns ExitCode
	match c 'pick'
		empty then return 0
		holds(s) then return 3 if s.equals("hi") else 0
	end 'pick'
end 'valueOf'

// --- file: main.maxon
function relay(c Container) returns ExitCode
	return valueOf(c)
end 'relay'

function main() returns ExitCode
	_ = fromB()

	return 5 + fromA()
end 'main'
---
ExitCode: 7
---
data {
  __data_fromBCalls@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_console_probe_stdin@40 = i8 0
  __mrt_console_probe_stdout@41 = i8 0
  __mrt_console_probe_stderr@42 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
  __il_body:
    x64.leaRegGlobal rax, __data_fromBCalls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_fromBCalls
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "hi"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_cont#5:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Container
    x64.movRegImm32 rax, 5
  __il_cont#4:
    x64.leaRegRegImm32 r8, rax, 2
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
