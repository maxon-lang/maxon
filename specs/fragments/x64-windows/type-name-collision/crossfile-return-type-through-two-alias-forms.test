// Test: crossfile-return-type-through-two-alias-forms
// --- file: a.maxon
typealias Pair = int(0 to 5)

export function fromA() returns Pair
	return 4
end 'fromA'

// --- file: b.maxon
typealias Coord = int(0 to 100)
typealias Pair = (Coord, Coord)

export function fromB() returns Pair
	return (7, 9)
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	let p = fromB()

	return fromA() + p.0 + p.1
end 'main'
---
ExitCode: 20
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rax, slot0
    x64.movRegImm32 rcx, 7
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.movRegImm32 rcx, 9
    x64.storeBaseDispReg.word64 [rax + 8], rcx
  __il_cont:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.leaRegRegImm32 rcx, rcx, 4
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
