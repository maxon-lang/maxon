// Test: crossfile-return-type-through-two-alias-forms
// --- file: a.maxon
typealias Pair = int(0 to 5)

export function fromA() returns ExitCode
	let n = 4 as Pair

	return n as ExitCode
end 'fromA'

// --- file: b.maxon
export typealias Pair = (ExitCode, ExitCode)

export function fromB() returns Pair
	return (7, 9)
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	let p = fromB()

	return fromA() + p.0 + p.1
end 'main'
---
ExitCode: 20
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rax, 7
    x64.movRegImm32 rcx, 9
  __il_cont:
    x64.leaRegRegImm32 rax, rax, 4
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
