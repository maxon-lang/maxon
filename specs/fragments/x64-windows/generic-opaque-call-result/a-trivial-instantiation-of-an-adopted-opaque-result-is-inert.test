// Test: a-trivial-instantiation-of-an-adopted-opaque-result-is-inert
typealias Num = int(0 to 1000)

type Cell uses U
	export var slot as U

	static function make(slot U) returns Self
		return Self{slot: slot}
	end 'make'

	function get() returns U
		return slot
	end 'get'
end 'Cell'

type Holder uses T where T is Equatable
	export typealias TCell = Cell with T
	export var cell as TCell

	static function make(cell TCell) returns Self
		return Self{cell: cell}
	end 'make'

	function holds(other T) returns bool
		let mine = cell.get()
		return mine == other
	end 'holds'
end 'Holder'

typealias NumCell = Cell with Num
typealias NumHolder = Holder with Num

function main() returns ExitCode
	let h = NumHolder.make(NumCell.make(7 as Num))
	if not h.holds(7 as Num) 'mismatch'
		return 1
	end 'mismatch'
	if h.holds(8 as Num) 'falsePositive'
		return 2
	end 'falsePositive'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Holder.holds {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.movRegReg r13, r9
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 rdx, [rax + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __retain_type_param
    x64.movRegReg r14, r8
  __il_cont:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.callMem [r13 + 48]
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __drop_type_param
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 7
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#6:
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
  __il_cont#5:
    x64.movRegImm32 rdx, 7
    x64.leaRegRdata rax, [rip + __layout_Holder_Num]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.holds
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  mismatch:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder_Num
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 8
    x64.leaRegRdata rax, [rip + __layout_Holder_Num]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.holds
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  falsePositive:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder_Num
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder_Num
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
