// Test: remove-reinsert
function main() returns ExitCode
	var s = Set from [1, 2, 3]
	_ = s.remove(2)
	s.insert(2)
	if s.contains(2) 'check'
		return s.count()
	end 'check'
	return 1
end 'main'
