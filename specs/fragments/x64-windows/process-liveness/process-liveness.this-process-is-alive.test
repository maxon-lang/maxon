// Test: process-liveness.this-process-is-alive
function main() returns ExitCode
	if __Builtins.processIsAlive(__Builtins.currentProcessId()) 'alive'
		return 3
	end 'alive'
	return 1
end 'main'
---
ExitCode: 3
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __proc_pid
    x64.movRegReg rcx, r8
    x64.callDirect __proc_alive
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  alive:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
