// Test: process-liveness.a-windows-id-off-the-granule-is-not-alive
function main() returns ExitCode
	let pid = __Builtins.currentProcessId()
	for offset in 1 to 3 'offGranule'
		if __Builtins.processIsAlive(pid + offset) 'claimed'
			return offset
		end 'claimed'
	end 'offGranule'
	return 7
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __proc_pid
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
    x64.jmp forhdr
  offGranule:
    x64.leaRegRegReg rcx, rbx, r12
    x64.callDirect __proc_alive
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, forstep
  claimed:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr:
    x64.cmpRegImm32 r12, 3
    x64.jcc lessEqual, offGranule
  forexit:
    x64.movRegImm32 r8, 7
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
