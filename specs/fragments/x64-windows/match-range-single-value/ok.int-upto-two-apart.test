// Test: ok.int-upto-two-apart
function main() returns ExitCode
	let x = 5
	let result = match x 'eval'
		5 upto 7 gives 0
		default gives 1
	end 'eval'
	return result
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 0
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
