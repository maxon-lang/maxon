// Test: stdlib-loading.a-stdlib-modules-literals-cannot-reach-the-rdata-image
function main() returns ExitCode
	var scale = 12.5
	let floor = 1.5
	var spins = 0
	while spins < 1 'spin'
		scale = scale + floor
		spins = spins + 1
	end 'spin'
	if scale > floor 'gt'
		return 8
	end 'gt'
	return 1
end 'main'
---
ExitCode: 8
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_12.5]
    x64.movsdRegRip xmm1, [rip + __fconst_1.5]
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  spin:
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegImm32 rax, 1
    x64.jcc less, spin
  whileexit:
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont
  gt:
    x64.movRegImm32 r8, 8
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
