// Test: stdlib-loading.range-is-constructible-from-to-in-expression-position
function main() returns ExitCode
	let r = 3 to 7
	var sum = 0
	for x in r 'walk'
		sum = sum + x
	end 'walk'
	return sum as ExitCode
end 'main'
---
ExitCode: 25
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
