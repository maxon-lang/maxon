  __il_body#5:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_body#7:
    x64.leaRegFunc rbx, [rip + Widget.compute$closure_0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], r13
  __il_body#9:
    x64.movRegReg rcx, r12
    x64.callReg rbx
    x64.movRegReg rbx, r8
  __il_cont#8:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
  __il_cont#6:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at bare-self-field-name-in-closure.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
