// Test: missing-return-satisfied-by-a-diverging-tail-call
function fatal(tag Integer)
	panic("fatal {tag}")
end 'fatal'

function pick(b bool) returns Integer
	if b 'y'
		return 6
	end 'y'
	fatal(9)
end 'pick'

function main() returns ExitCode
	return pick(true) * 7
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  y:
    x64.movRegImm32 rax, 6
  __il_cont:
    x64.imulRegRegImm32 r8, rax, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
