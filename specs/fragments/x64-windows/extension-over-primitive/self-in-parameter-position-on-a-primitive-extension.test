// Test: self-in-parameter-position-on-a-primitive-extension
typealias Integer = int(i64.min to i64.max)

extension int
	export function plus(other Self) returns Integer
		return self + other
	end 'plus'
end 'int'

function main() returns ExitCode
	let n = 20
	return n.plus(22) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
