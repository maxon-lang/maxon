// Test: multiple-struct-returns

typealias Integer = int(i64.min to i64.max)

type Value
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Value'

function step1() returns Value
	return Value.create(1)
end 'step1'

function step2(v Value) returns Value
	return Value.create(v.n + 10)
end 'step2'

function step3(v Value) returns Value
	return Value.create(v.n + 100)
end 'step3'

function main() returns ExitCode
	let v1 = step1()
	let v2 = step2(v1)
	let v3 = step3(v2)
	return v3.n
end 'main'
---
ExitCode: 111
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 64
  __il_body#7:
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 10
    x64.leaRegSlot rcx, slot1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body#9:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegSlot rcx, slot2
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_cont:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at multiple-struct-returns.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
}
