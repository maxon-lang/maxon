    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#10:
    x64.movRegImm32 rbx, 91
    x64.movRegImm32 r13, 4
    x64.leaRegRdata rax, [rip + __layout_Bag_Integer]
  __il_body#16:
    x64.loadRegBaseDisp.word64 r14, [r12 + 0]
  __il_body#18:
    x64.movRegImm32 rcx, 16
