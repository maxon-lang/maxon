    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#10:
    x64.movRegImm32 rbx, 91
    x64.movRegImm32 r13, 4
    x64.leaRegRdata rax, [rip + __layout_Bag_Integer]
  __il_body#15:
    x64.loadRegBaseDisp.word64 r14, [r12 + 0]
  __il_body#17:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r13
  __il_cont#16:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_cont#14:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.callDirect __managed_retain
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + rdx*8 + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [r8 + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#18
