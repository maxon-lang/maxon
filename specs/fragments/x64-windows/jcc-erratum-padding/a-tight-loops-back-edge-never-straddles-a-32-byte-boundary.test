// Test: a-tight-loops-back-edge-never-straddles-a-32-byte-boundary
typealias Rounds = int(0 to 1000000)

function spin(rounds Rounds) returns Rounds
	var acc = 0
	var i = 0

	while i < rounds 'spin'
		acc = acc + i
		i = i + 1
	end 'spin'

	return acc mod 251
end 'spin'

function main() returns ExitCode
	return spin(1000)
end 'main'
---
ExitCode: 10
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_ok:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  spin:
    x64.leaRegRegReg rcx, rcx, rax
    x64.leaRegRegImm32 rax, rax, 1
  whilehdr:
    x64.cmpRegImm32 rax, 1000
    x64.jcc less, spin
  whileexit:
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 1000000
    x64.jcc greater, __rc_panic
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-tight-loops-back-edge-never-straddles-a-32-byte-boundary.test:13: Range check failed: value outside typealias 'Rounds'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
