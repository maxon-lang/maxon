// Test: immutable-rebind-on-assign-from-outside-a-loop
typealias Integer = int(i64.min to i64.max)
typealias Step = int(0 to 100)

function build(x Integer) returns String
	return "v{x}"
end 'build'

function main() returns ExitCode
	let src = build(9)
	var dest = build(0)
	var i = 0 as Step
	while i < 2 'spin'
		dest = src
		i = i + 1
	end 'spin'
	print(dest)
	print(src)
	return 0
end 'main'
---
CompilerError:
error E3102: <fragment>:14:10: use of moved value 'src': it was moved in an earlier iteration of this loop
