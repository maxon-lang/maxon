// Test: ternary-expression.logical-op-condition
type Flags
	export let a as bool
	export let b as bool

	export static function make(a bool, b bool) returns Flags
		return Flags{a: a, b: b}
	end 'make'
end 'Flags'

function pick(f Flags) returns ExitCode
	let either = f.a or f.b
	let both = f.a and f.b
	let one = 4 if either else 0
	let two = 1 if both else 0
	return (one + two) as ExitCode
end 'pick'

function main() returns ExitCode
	return pick(Flags.make(true, b: false))
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 0
  __il_body#3:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.byte [r8 + 0], rbx
    x64.storeBaseDispReg.byte [r8 + 8], r12
  __il_body#4:
    x64.loadRegBaseDisp.byte rax, [r8 + 0]
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, scmerge#6
  orrhs:
    x64.loadRegBaseDisp.byte rax, [r8 + 8]
    x64.movRegReg rcx, rax
  scmerge#6:
    x64.loadRegBaseDisp.byte rax, [r8 + 0]
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
  andrhs:
    x64.loadRegBaseDisp.byte rax, [r8 + 8]
    x64.jmp scmerge#8
  critsplit:
    x64.movRegReg rax, rdx
  scmerge#8:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse#10
  ternarytrue#9:
    x64.movRegImm32 rcx, 4
    x64.jmp matchcont#11
  ternaryfalse#10:
    x64.movRegImm32 rcx, 0
  matchcont#11:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse#13
  ternarytrue#12:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont#14
  ternaryfalse#13:
    x64.movRegImm32 rax, 0
  matchcont#14:
    x64.leaRegRegReg rbx, rcx, rax
  __il_cont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
