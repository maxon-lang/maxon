// Test: a-value-checked-once-is-known-non-negative-after
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function bump(a WordArray, i Word) returns Word
	let before = try a.get(i) otherwise panic("bump: i is in range")
	try a.set(i, value: before + 1) otherwise panic("bump: i is in range")
	return try a.get(i) otherwise panic("bump: i is in range")
end 'bump'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(5)
	if bump(a, i: 0) != 6 'first'
		return 1
	end 'first'
	if bump(a, i: 0) != 7 'second'
		return 2
	end 'second'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.cmpRegImm32 r12, 0
    x64.jcc greaterEqual, __rc_ok#7
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-value-checked-once-is-known-non-negative-after.test:6: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r12, rax
    x64.jcc below, __im_load#15
  __im_slow#14:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-value-checked-once-is-known-non-negative-after.test:6: bump: i is in range\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_load#15:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r12*8 + 0]
    x64.movRegReg r8, rax
  tryok#1:
    x64.leaRegRegImm32 rax, r8, 1
  __rc_ok#9:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __im_slow#17
  __im_bounds:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg r12, rcx
    x64.jcc aboveEqual, __im_slow#17
  __im_buffer:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow#17
  __im_viewed:
    x64.leaRegRegImm32 rdx, rcx, -24
    x64.loadRegBaseDisp.word64 rdx, [rdx + 16]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __im_store
  __im_slow#17:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __rc_ok#11
  tryerr#4:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-value-checked-once-is-known-non-negative-after.test:7: bump: i is in range\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_store:
    x64.storeBaseIndexScaleReg.word64 [rcx + r12*8 + 0], rax
  __rc_ok#11:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r12, rax
    x64.jcc below, __im_load#24
  __im_slow#23:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at a-value-checked-once-is-known-non-negative-after.test:8: bump: i is in range\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_load#24:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r8, [rax + r12*8 + 0]
  tryok#5:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect bump
    x64.cmpRegImm32 r8, 6
    x64.jcc equal, ifcont#2
  first:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect bump
    x64.cmpRegImm32 r8, 7
    x64.jcc equal, ifcont#4
  second:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
