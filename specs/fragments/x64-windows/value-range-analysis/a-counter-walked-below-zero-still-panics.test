// Test: a-counter-walked-below-zero-still-panics
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function main() returns ExitCode
	var a = WordArray.create()
	a.push(1)
	a.push(2)
	a.push(3)
	var i = 2
	var t = 0
	while i > -2 'walk'
		t = t + (try a.get(i) otherwise 0)
		i = i - 1
	end 'walk'
	if t != 6 'total'
		return 2
	end 'total'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rax, 2
    x64.movRegImm32 rsi, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rdi, [rbx + 8]
    x64.loadRegBaseDisp.word64 r8, [rbx + 0]
  whilehdr:
    x64.cmpRegImm32 rax, -2
    x64.jcc lessEqual, whileexit
  walk:
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-counter-walked-below-zero-still-panics.test:13: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegReg rax, rdi
    x64.jcc below, __im_load
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, rax
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rsi
    x64.storeSlotReg slot2, rdi
    x64.storeSlotReg slot3, r8
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rsi, slot1
    x64.loadRegSlot rdi, slot2
    x64.loadRegSlot r8, slot3
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 rcx, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 rcx, [r8 + rax*8 + 0]
  trycont:
    x64.leaRegRegReg rsi, rsi, rcx
    x64.leaRegRegImm32 rax, rax, -1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rsi, 6
    x64.jcc equal, ifcont
  total:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
