  __il_body#14:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.byte [r13 + 8], r12
  __il_cont#11:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  again:
    x64.movRegReg rcx, r13
    x64.callDirect Stdin.readLine
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_body#10
  tryerr:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.leaRegRegImm32 r12, r12, 1
  whilehdr:
    x64.cmpRegImm32 r12, 3
    x64.jcc less, again
    x64.jmp whileexit
  __il_body#10:
    x64.movRegReg rcx, r14
    x64.callDirect __write_stdout
  __il_cont#9:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Stdin
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Stdin
    x64.movRegReg r8, rbx
    x64.epilogue 32
