    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.byte [r13 + 8], r12
  __il_cont#5:
    x64.movRegReg rcx, r13
    x64.callDirect Stdin.readLine
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_body#4
  tryerr:
    x64.movRegImm32 rbx, 9
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Stdin
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body#4:
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stdout
  __il_cont#3:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
