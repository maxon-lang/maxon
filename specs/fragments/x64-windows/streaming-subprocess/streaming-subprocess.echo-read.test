// Test: streaming-subprocess.echo-read
function main() returns ExitCode
	let h = subpSpawn("cmd /c echo hello")
	let line = subpReadLine(h)
	let n = line.byteLength()
	let code = subpWait(h)
	print("{code}")
	subpRelease(h)
	return n as ExitCode
end 'main'
---
ExitCode: 7
