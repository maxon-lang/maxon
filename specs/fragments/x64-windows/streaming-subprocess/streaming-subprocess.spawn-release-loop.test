// Test: streaming-subprocess.spawn-release-loop
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 12 'loop'
		let h = subpSpawn("cmd /c echo hello")
		let line = subpReadLine(h)
		total = total + line.byteLength()
		_ = subpWait(h)
		subpRelease(h)
		i = i + 1
	end 'loop'
	return total as ExitCode
end 'main'
---
ExitCode: 84
