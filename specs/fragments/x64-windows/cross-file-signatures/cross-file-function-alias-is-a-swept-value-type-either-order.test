// Test: cross-file-function-alias-is-a-swept-value-type-either-order
// --- file: main.maxon
function twice(n Int) returns Int
	return n * 2
end 'twice'

type Holder
	export var op as UnaryOp

	static function create() returns Holder
		return Self{op: twice}
	end 'create'
end 'Holder'

function pick() returns UnaryOp
	return twice
end 'pick'

function main() returns ExitCode
	let h = Holder.create()
	let f = pick()
	return (h.op(7) + f(14)) as ExitCode
end 'main'

// --- file: alias.maxon
export typealias Int = int(i64.min to i64.max)
export typealias UnaryOp = function(Int) returns Int
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
  __mrt_program_started@27 = i8 0
}

func @twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
  __il_body#6:
    x64.leaRegRdata rbx, [rip + __fnrec_twice]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#7:
    x64.leaRegRdata rbx, [rip + __fnrec_twice]
  __il_cont:
    x64.loadRegBaseDisp.word64 r13, [r12 + 0]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_retain
    x64.movRegReg r14, r8
    x64.movRegImm32 rcx, 7
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.movRegReg rdx, r13
    x64.callReg rax
    x64.movRegReg r13, r8
    x64.movRegImm32 rcx, 14
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.movRegReg rdx, rbx
    x64.callReg rax
    x64.leaRegRegReg r13, r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at main.maxon:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
