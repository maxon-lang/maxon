// Test: a-load-across-a-store-is-not-reused
typealias Word = int(i64.min to i64.max)

type Cell
	export var slot as Word

	export static function create(slot Word) returns Cell
		return Self{slot: slot}
	end 'create'
end 'Cell'

function main() returns ExitCode
	var c = Cell.create(1)
	let before = c.slot
	c.slot = 2
	let after = c.slot
	if before + after != 3 'staleRead'
		return 1
	end 'staleRead'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.movRegImm32 rcx, 2
    x64.storeBaseDispReg.word64 [r8 + 0], rcx
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, ifcont
  staleRead:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
