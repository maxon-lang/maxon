// Test: let-record-alias-of-a-parameter-bound-through-a-call

function pass(s String) returns String
	return s
end 'pass'

function tagIt(p String)
	let q = p
	var x = pass(q)
	x.append("!")
end 'tagIt'

function main() returns ExitCode
	let n = 7
	var a = "lit{n}"
	tagIt(a)
	a.append("?")
	print("{a}\n")
	return 0
end 'main'
