    x64.subRegReg rax, rax, rcx
    x64.movRegImm32 rcx, 2147484648
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#15
  subMin:
    x64.movRegImm32 rbx, 46
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#15:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
