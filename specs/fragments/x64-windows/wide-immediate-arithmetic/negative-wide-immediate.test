// Test: negative-wide-immediate
function main() returns ExitCode
	let cell = [1000]
	let x = try cell.get(0) otherwise 0
	let addNeg = x + -1000000007
	if addNeg != -999999007 'addNeg'
		return 41
	end 'addNeg'
	let subNeg = x - -1000000007
	if subNeg != 1000001007 'subNeg'
		return 42
	end 'subNeg'
	let addMax = x + 2147483647
	if addMax != 2147484647 'addMax'
		return 43
	end 'addMax'
	let subMax = x - 2147483647
	if subMax != -2147482647 'subMax'
		return 44
	end 'subMax'
	let addMin = x + -2147483648
	if addMin != -2147482648 'addMin'
		return 45
	end 'addMin'
	let subMin = x - -2147483648
	if subMin != 2147484648 'subMin'
		return 46
	end 'subMin'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  trycont:
    x64.leaRegRegImm32 rcx, rax, -1000000007
    x64.cmpRegImm32 rcx, -999999007
    x64.jcc equal, ifcont#5
  addNeg:
    x64.movRegImm32 rbx, 41
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.leaRegRegImm32 rcx, rax, 1000000007
    x64.cmpRegImm32 rcx, 1000001007
    x64.jcc equal, ifcont#7
  subNeg:
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#7:
    x64.leaRegRegImm32 rcx, rax, 2147483647
    x64.movRegImm32 rdx, 2147484647
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, ifcont#9
  addMax:
    x64.movRegImm32 rbx, 43
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#9:
    x64.leaRegRegImm32 rcx, rax, -2147483647
    x64.cmpRegImm32 rcx, -2147482647
    x64.jcc equal, ifcont#11
  subMax:
    x64.movRegImm32 rbx, 44
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#11:
    x64.leaRegRegImm32 rcx, rax, -2147483648
    x64.cmpRegImm32 rcx, -2147482648
    x64.jcc equal, ifcont#13
  addMin:
    x64.movRegImm32 rbx, 45
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#13:
