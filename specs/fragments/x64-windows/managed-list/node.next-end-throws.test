    x64.popReg rbp
    x64.ret
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "caught\x0a"
    x64.callDirect print
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot2
    x64.callDirect __list_node_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __list_node_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __list_decref
    x64.movRegReg r8, rbx
    x64.epilogue 136
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
