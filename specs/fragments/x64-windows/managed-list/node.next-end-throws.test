// Test: node.next-end-throws
typealias Integer = int(i64.min to i64.max)
typealias IntManagedList = __ManagedList with Integer

function main() returns ExitCode
	var list = IntManagedList.create()
	let node = list.insertFirst(42)
	// Use the node handle
	print("{node.value()}\n")
	let h = try list.head() otherwise 'err'
		return 1
	end 'err'
	// Try to go past end
	if let after = try h.next() 'try'
		print("{after.value()}\n")
		return 1
	end 'try' else 'err2'
		print("caught\n")
		return 0
	end 'err2'
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
