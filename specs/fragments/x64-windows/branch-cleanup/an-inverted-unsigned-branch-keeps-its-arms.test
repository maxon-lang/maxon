// Test: an-inverted-unsigned-branch-keeps-its-arms
typealias Cell = int(0 to u8.max)
typealias CellArray = Array with Cell

function main() returns ExitCode
	var xs = CellArray.create()
	xs.push(4)
	xs.push(5)
	let a = try xs.get(0) otherwise 200
	let b = try xs.get(1) otherwise 200
	var hits = 0

	if a < b 'lo'
		hits = hits + 1
	end 'lo' else 'loElse'
		return 31
	end 'loElse'

	if a > b 'hi'
		return 32
	end 'hi' else 'hiElse'
		hits = hits + 1
	end 'hiElse'

	if a <= b 'ls'
		hits = hits + 1
	end 'ls' else 'lsElse'
		return 33
	end 'lsElse'

	if a >= b 'hs'
		return 34
	end 'hs' else 'hsElse'
		hits = hits + 1
	end 'hsElse'

	return 0 if hits == 4 else 35
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
