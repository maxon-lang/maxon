  critsplit#42:
    x64.movRegReg rax, r8
  trycont#6:
    x64.cmpRegReg r12, rax
    x64.jcc greaterEqual, ifelse#8
  ifcont#9:
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, ifcont#12
  hi:
    x64.movRegImm32 r12, 32
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#12:
