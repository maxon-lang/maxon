// Test: a-count-whose-alias-reaches-64-keeps-the-guard
typealias Num = int(i64.min to i64.max)
typealias Word = bits(64)
typealias UpTo64 = int(0 to 64)

function shlBy(value Num, n UpTo64) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n UpTo64) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n UpTo64) returns Word
	return value shr n
end 'shrWordBy'

function widen(step Num) returns UpTo64
	return (step * 64) as UpTo64
end 'widen'

function main() returns ExitCode
	let past = widen(1)

	if shlBy(7, n: past) != 0 'shl'
		return 1
	end 'shl'
	if shrBy(-1, n: past) != -1 'shrSign'
		return 2
	end 'shrSign'
	if shrWordBy(u64.max, n: past) != 0 'shrZeroFill'
		return 3
	end 'shrZeroFill'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok:
    x64.movRegImm32 rax, 64
  __il_cont#8:
    x64.movRegImm32 rdx, 7
  shiftok#15:
    x64.movRegReg rcx, rax
    x64.shlRegCl rdx, rdx
    x64.andRegImm32 rdx, rdx, 0
  ifcont#2:
    x64.movRegImm rdx, 18446744073709551615
  shiftok#22:
    x64.movRegImm rcx, 18446744073709551615
    x64.sarRegCl rdx, rdx
  __il_cont#19:
    x64.cmpRegImm32 rdx, -1
    x64.jcc equal, ifcont#4
  shrSign:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm rdx, 18446744073709551615
  shiftok#29:
    x64.movRegReg rcx, rax
    x64.shrRegCl rdx, rdx
    x64.andRegImm32 rdx, rdx, 0
  ifcont#6:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
