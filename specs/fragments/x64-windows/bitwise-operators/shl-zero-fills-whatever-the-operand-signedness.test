// Test: shl-zero-fills-whatever-the-operand-signedness
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function shlDynamic(v Wide, d Num) returns Wide
	return v shl d
end 'shlDynamic'

function shlPastWidth(v Wide) returns Wide
	return v shl 64
end 'shlPastWidth'

function main() returns ExitCode
	if shlDynamic(u64.max, d: 63) != i64.min 'topBitOnly'
		return 1
	end 'topBitOnly'
	if shlPastWidth(u64.max) != 0 'everyBitOut'
		return 2
	end 'everyBitOut'
	if shlDynamic(u64.max, d: 100) != 0 'everyBitOutDynamic'
		return 3
	end 'everyBitOutDynamic'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#8:
    x64.movRegImm rax, 9223372036854775808
  __il_cont#7:
    x64.movRegImm rcx, 9223372036854775808
    x64.cmpRegReg rax, rcx
    x64.jcc equal, __il_body#10
  topBitOnly:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body#10:
    x64.movRegImm32 rax, 0
  __il_cont#9:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#4
  everyBitOut:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm rax, 18446744073709551615
    x64.movRegImm32 rcx, 100
  __il_body#12:
    x64.shlRegCl rax, rax
    x64.andRegImm32 rax, rax, 0
  __il_cont#11:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#6
  everyBitOutDynamic:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
