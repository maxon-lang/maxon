// Test: a-proven-count-through-a-cast-site
typealias Bits = int(0 to 63)

function main() returns ExitCode
	var acc = 0
	for i in 0 upto 8 'lowBits'
		let n = i as Bits
		acc = acc + (1 shl n)
	end 'lowBits'
	if acc != 255 'sum'
		return 1
	end 'sum'

	var top = 0
	for i in 0 upto 2 'boundary'
		let n = (i * 63) as Bits
		top = top + (1 shl n)
	end 'boundary'
	if top != -9223372036854775807 'topSum'
		return 2
	end 'topSum'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rdx, 0
    x64.jmp forhdr#1
  lowBits:
    x64.movRegImm32 rsi, 1
    x64.movRegReg rcx, rdx
    x64.shlRegCl rsi, rsi
    x64.leaRegRegReg rax, rax, rsi
  forstep#3:
    x64.leaRegRegImm32 rdx, rdx, 1
  forhdr#1:
    x64.cmpRegImm32 rdx, 8
    x64.jcc less, lowBits
  forexit#4:
    x64.cmpRegImm32 rax, 255
    x64.jcc equal, ifcont#6
  sum:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rdx, 0
    x64.jmp forhdr#7
  boundary:
    x64.imulRegRegImm32 rcx, rdx, 63
  __rc_ok:
    x64.movRegImm32 rsi, 1
    x64.shlRegCl rsi, rsi
    x64.leaRegRegReg rax, rax, rsi
  forstep#9:
    x64.leaRegRegImm32 rdx, rdx, 1
  forhdr#7:
    x64.cmpRegImm32 rdx, 2
    x64.jcc less, boundary
  forexit#10:
    x64.movRegImm rcx, 9223372036854775809
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#12
  topSum:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
