// Test: shr-signed-operand-still-sign-fills
typealias Num = int(i64.min to i64.max)

function shrConst(v Num) returns Num
	return v shr 60
end 'shrConst'

function shrDynamic(v Num, d Num) returns Num
	return v shr d
end 'shrDynamic'

function shrPastWidth(v Num) returns Num
	return v shr 100
end 'shrPastWidth'

function main() returns ExitCode
	if shrConst(-8) != -1 'foldedCount'
		return 1
	end 'foldedCount'
	if shrDynamic(-8, d: 60) != -1 'dynamicCount'
		return 2
	end 'dynamicCount'

	// A sign-filling shift saturates to the SIGN, not to 0: `x shr 63` already IS the sign.
	if shrPastWidth(-8) != -1 'foldedPastWidth'
		return 3
	end 'foldedPastWidth'
	if shrDynamic(-8, d: 100) != -1 'dynamicPastWidth'
		return 4
	end 'dynamicPastWidth'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont#6:
    x64.movRegImm rax, 18446744073709551608
  shiftok:
    x64.movRegImm rcx, 18446744073709551615
    x64.sarRegCl rax, rax
  __il_cont:
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, ifcont#8
  dynamicPastWidth:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
