// Test: a-bare-int-count-keeps-the-guard
function main() returns ExitCode
	var seen = 0
	for n in 68 upto 72 'each'
		if 7 shl n != 0 'shl'
			return 1
		end 'shl'
		if 1024 shr n != 0 'shr'
			return 2
		end 'shr'
		seen = seen + 1
	end 'each'

	if seen != 4 'iterations'
		return 3
	end 'iterations'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rdx, 68
    x64.jmp forhdr
  each:
    x64.movRegImm32 rsi, 7
  shiftok#6:
    x64.movRegReg rcx, rdx
    x64.andRegImm32 rcx, rdx, -64
    x64.movRegReg rdi, rcx
    x64.negReg rdi, rcx
    x64.orRegReg rdi, rdi, rcx
    x64.sarRegImm8 rdi, rdi, 63
    x64.movRegReg rcx, rdx
    x64.shlRegCl rsi, rsi
    x64.movRegReg r8, rdi
    x64.notReg r8, rdi
    x64.andRegReg rsi, rsi, r8
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, ifcont#8
  shl:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 rsi, 1024
  shiftok#10:
    x64.movRegReg rcx, rdx
    x64.orRegReg rcx, rdx, rdi
    x64.sarRegCl rsi, rsi
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, ifcont#12
  shr:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.leaRegRegImm32 rax, rax, 1
  forstep:
    x64.leaRegRegImm32 rdx, rdx, 1
  forhdr:
    x64.cmpRegImm32 rdx, 72
    x64.jcc less, each
  forexit:
    x64.cmpRegImm32 rax, 4
    x64.jcc equal, ifcont#14
  iterations:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#14:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
