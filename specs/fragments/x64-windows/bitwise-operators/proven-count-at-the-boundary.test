// Test: proven-count-at-the-boundary
typealias Num = int(i64.min to i64.max)
typealias Word = bits(64)
typealias Bits = int(0 to 63)

function shlBy(value Num, n Bits) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n Bits) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n Bits) returns Word
	return value shr n
end 'shrWordBy'

function boundary(step Num) returns Bits
	return (step * 63) as Bits
end 'boundary'

function main() returns ExitCode
	let low = boundary(0)
	let high = boundary(1)

	if shlBy(1, n: low) != 1 'shlZero'
		return 1
	end 'shlZero'
	if shlBy(1, n: high) != -9223372036854775807 - 1 'shlTop'
		return 2
	end 'shlTop'
	if shrBy(-8, n: low) != -8 'shrZero'
		return 3
	end 'shrZero'
	if shrBy(-8, n: high) != -1 'shrTop'
		return 4
	end 'shrTop'
	if shrWordBy(u64.max, n: low) != u64.max 'shrWordZero'
		return 5
	end 'shrWordZero'
	if shrWordBy(u64.max, n: high) != 1 'shrWordTop'
		return 6
	end 'shrWordTop'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
