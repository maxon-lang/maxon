// Test: shift-by-parameter-count
typealias Num = int(i64.min to i64.max)

function shiftLeft(value Num, count Num) returns Num
	return value shl count
end 'shiftLeft'

function shiftRight(value Num, count Num) returns Num
	return value shr count
end 'shiftRight'

function main() returns ExitCode
	if shiftLeft(7, count: 65) != 0 'shlPastWidth'
		return 1
	end 'shlPastWidth'
	if shiftLeft(7, count: 3) != 56 'shlInRange'
		return 2
	end 'shlInRange'
	if shiftRight(-1, count: 100) != -1 'shrNegPastWidth'
		return 3
	end 'shrNegPastWidth'
	if shiftRight(8, count: 100) != 0 'shrPosPastWidth'
		return 4
	end 'shrPosPastWidth'
	if shiftRight(-8, count: 1) != -4 'shrInRange'
		return 5
	end 'shrInRange'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 7
    x64.movRegImm32 rcx, 65
  __il_body#12:
    x64.shlRegCl rax, rax
    x64.andRegImm32 rax, rax, 0
  __il_cont#11:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#14
  shlPastWidth:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body#14:
    x64.movRegImm32 rax, 56
  __il_cont#13:
    x64.cmpRegImm32 rax, 56
    x64.jcc equal, ifcont#4
  shlInRange:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm rax, 18446744073709551615
  __il_body#16:
    x64.movRegImm rcx, 18446744073709551615
    x64.sarRegCl rax, rax
  __il_cont#15:
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, ifcont#6
  shrNegPastWidth:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rax, 8
  __il_body#18:
    x64.movRegImm rcx, 18446744073709551615
    x64.sarRegCl rax, rax
  __il_cont#17:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#20
  shrPosPastWidth:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  __il_body#20:
    x64.movRegImm rax, 18446744073709551612
  __il_cont#19:
    x64.cmpRegImm32 rax, -4
    x64.jcc equal, ifcont#10
  shrInRange:
    x64.movRegImm32 r8, 5
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
