// Test: bitwise-xor-precedence
function main() returns ExitCode
	// and has higher precedence than xor
	// 12 and 10 = 8, then 8 xor 3 = 11
	return 12 and 10 xor 3
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 11
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
