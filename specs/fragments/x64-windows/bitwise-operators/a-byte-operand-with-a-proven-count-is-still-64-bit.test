// Test: a-byte-operand-with-a-proven-count-is-still-64-bit
typealias Num = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias Bits = int(0 to 63)

function shlLowByte(n Bits) returns Num
	let b = 200 as Byte
	return b shl n
end 'shlLowByte'

function shlTopByte(n Bits) returns Num
	let b = 255 as Byte
	return b shl n
end 'shlTopByte'

function shrLowByte(n Bits) returns Num
	let b = 200 as Byte
	return b shr n
end 'shrLowByte'

function bits(step Num) returns Bits
	return step as Bits
end 'bits'

function main() returns ExitCode
	if shlLowByte(bits(10)) != 204800 'tenBits'
		return 1
	end 'tenBits'
	if shlTopByte(bits(56)) != -72057594037927936 'topByte'
		return 2
	end 'topByte'
	if shrLowByte(bits(3)) != 25 'shrByte'
		return 3
	end 'shrByte'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __rc_ok#9:
    x64.movRegImm32 rax, 200
    x64.shlRegImm8 rax, rax, 10
  __il_cont#7:
    x64.cmpRegImm32 rax, 204800
    x64.jcc equal, __rc_ok#14
  tenBits:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __rc_ok#14:
    x64.movRegImm32 rax, 255
    x64.shlRegImm8 rax, rax, 56
  __il_cont#12:
    x64.movRegImm rcx, 18374686479671623680
    x64.cmpRegReg rax, rcx
    x64.jcc equal, __rc_ok#19
  topByte:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  __rc_ok#19:
    x64.movRegImm32 rax, 200
    x64.shrRegImm8 rax, rax, 3
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
