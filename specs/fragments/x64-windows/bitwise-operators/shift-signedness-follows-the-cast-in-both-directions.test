// Test: shift-signedness-follows-the-cast-in-both-directions
typealias Wide = bits(64)
typealias Num = int(i64.min to i64.max)

function sourceKeepsItsOwnType(p Num) returns Num
	let w = p as Wide
	return ((w shr 60) as Num) - (p shr 60)
end 'sourceKeepsItsOwnType'

function castToSigned(v Wide) returns Num
	let n = v as Num
	return n shr 60
end 'castToSigned'

function main() returns ExitCode
	if sourceKeepsItsOwnType(u64.max) != 16 'sourceKeeps'
		return 1
	end 'sourceKeeps'
	if castToSigned(u64.max) != -1 'toSigned'
		return 2
	end 'toSigned'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
