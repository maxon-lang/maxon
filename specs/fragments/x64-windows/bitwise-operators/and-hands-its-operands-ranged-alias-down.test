// Test: and-hands-its-operands-ranged-alias-down
typealias Wide = bits(64)
typealias Num = int(i64.min to i64.max)

function andThenShift(a Wide, b Wide) returns Wide
	let m = a and b
	return m shr 60
end 'andThenShift'

function andThenDivide(a Wide, b Wide) returns Wide
	let m = a and b
	return m / 3
end 'andThenDivide'

function orThenShift(a Wide, b Wide) returns Num
	let m = a or b
	return m shr 60
end 'orThenShift'

function xorThenShift(a Wide, b Wide) returns Num
	let m = a xor b
	return m shr 60
end 'xorThenShift'

function main() returns ExitCode
	if andThenShift(u64.max, b: u64.max) != 15 'andKeepsUnsigned'
		return 1
	end 'andKeepsUnsigned'
	if andThenDivide(u64.max, b: u64.max) != 6148914691236517205 'andDividesUnsigned'
		return 2
	end 'andDividesUnsigned'
	if orThenShift(u64.max, b: 0) != -1 'orCarriesNothing'
		return 3
	end 'orCarriesNothing'
	if xorThenShift(u64.max, b: 0) != -1 'xorCarriesNothing'
		return 4
	end 'xorCarriesNothing'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm rcx, 18446744073709551615
    x64.movRegImm rax, 12297829382473034411
    x64.mulHighReg rcx
    x64.shrRegImm8 rdx, rdx, 1
  __il_cont:
    x64.movRegImm rax, 6148914691236517205
    x64.cmpRegReg rdx, rax
    x64.jcc equal, ifcont
  andDividesUnsigned:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
