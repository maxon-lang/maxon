// Test: rc-global-array-push-remove-loop-no-leak
typealias Integer = int(i64.min to i64.max)

type Item
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Item'

typealias ItemArray = Array with Item

var globalArr = ItemArray.create()

function main() returns ExitCode
	var i = 0
	while i < 10 'push'
		globalArr.push(Item.create(i))
		i = i + 1
	end 'push'
	var total = 0
	while globalArr.count() > 0 'remove'
		let elem = try globalArr.remove(0) otherwise 'err'
			return 99
		end 'err'
		total = total + elem.value
		i = i + 1
	end 'remove'
	return total
end 'main'
---
ExitCode: 45
---
data {
  __data_globalArr@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.jmp whilehdr#1
  push:
    x64.leaRegGlobal rax, __data_globalArr
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_cont:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRegImm32 rbx, rbx, 1
  whilehdr#1:
    x64.cmpRegImm32 rbx, 10
    x64.jcc less, push
  whileexit#3:
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr#4
  remove:
    x64.leaRegGlobal rax, __data_globalArr
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_retain
    x64.movRegReg r15, r8
    x64.leaRegRdata rax, [rip + __layout_Array_Item]
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect Array.remove
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rbx, 99
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.leaRegRegReg r12, r12, rax
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  whilehdr#4:
    x64.leaRegGlobal rax, __data_globalArr
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, remove
  whileexit#6:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at rc-global-array-push-remove-loop-no-leak.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
