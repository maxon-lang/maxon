  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at rc-container-overwrite-decrefs-old.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
