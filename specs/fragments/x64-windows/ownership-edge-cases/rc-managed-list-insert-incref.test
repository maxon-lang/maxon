    x64.callDirect __list_node_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __list_decref
    x64.movRegReg r8, r15
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at rc-managed-list-insert-incref.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
