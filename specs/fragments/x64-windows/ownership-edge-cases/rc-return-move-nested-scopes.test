  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_9]  ; "panic at rc-return-move-nested-scopes.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
