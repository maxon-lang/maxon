// Test: opener-case-member-in-for-iterable
enum Kw
	alpha
	for
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		for then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var acc = 0
	for i in 0 upto tagOf(Kw.for) 'each'
		acc = acc + 10 + i
	end 'each'
	return acc as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 21
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
    x64.jmp forhdr
  each:
    x64.leaRegRegImm32 rcx, r8, 10
    x64.leaRegRegReg r8, rcx, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
  forhdr:
    x64.cmpRegImm32 rax, 2
    x64.jcc less, each
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at opener-case-member-in-for-iterable.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
