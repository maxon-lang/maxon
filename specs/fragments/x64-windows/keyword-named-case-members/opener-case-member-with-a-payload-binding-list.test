// Test: opener-case-member-with-a-payload-binding-list
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	while(m Num)
	omega
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		alpha(n) then return n
		while(m) then return m + 40
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	let v = tagOf(Kw.while(2))
	if v == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.movRegImm32 rcx, 1
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_cont
  matchnext#9:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext#10
  matcharm#6:
    x64.leaRegRegImm32 rax, rax, 40
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic
    x64.jmp __il_cont
  matchnext#10:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdead
  matcharm#7:
    x64.movRegImm32 rax, 3
  __il_cont:
    x64.cmpRegImm32 rax, 42
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at opener-case-member-with-a-payload-binding-list.test:13: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
