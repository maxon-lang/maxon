// Test: a-keyword-named-condition-after-a-case-list-spelling-block-keywords
typealias Idx = int(0 to 100)

enum Kw
	while
	match
	for
	omega
end 'Kw'

function span(to Idx, from Idx) returns Idx
	if to >= from 'forward'
		return to - from
	end 'forward'
	return from - to
end 'span'

function tagOf(k Kw) returns Idx
	match k 'm'
		while then return 1
		match then return 2
		for then return 3
		omega then return 0
	end 'm'
end 'tagOf'

function main() returns ExitCode
	return (span(50, from: 8) + tagOf(Kw.omega)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont#5:
    x64.movRegImm32 rax, 3
  __il_body:
    x64.jumpTable rax, default=matchdead [[0]=matcharm#22, [1]=matcharm#23, [2]=matcharm#24, [3]=matcharm#25] @__jumptable_4
  matchdead:
  matcharm#22:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont#4
  matcharm#23:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont#4
  matcharm#24:
    x64.movRegImm32 rax, 3
    x64.jmp __il_cont#4
  matcharm#25:
    x64.movRegImm32 rax, 0
  __il_cont#4:
    x64.leaRegRegImm32 r8, rax, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
