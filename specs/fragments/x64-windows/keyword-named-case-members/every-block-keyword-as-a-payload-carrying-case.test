// Test: every-block-keyword-as-a-payload-carrying-case
typealias Num = int(0 to 1000)

union Kw
	if(a Num)
	else(b Num)
	end(c Num)
	while(d Num)
	match(e Num)
	for(f Num)
	otherwise(g Num)
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		if(a) then return a
		else(b) then return b
		end(c) then return c
		while(d) then return d
		match(e) then return e
		for(f) then return f
		otherwise(g) then return g
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 2 'spin'
		sum = sum + tagOf(Kw.if(1)) + tagOf(Kw.else(2)) + tagOf(Kw.end(4)) + tagOf(Kw.while(8))
		i = i + 1
	end 'spin'
	if sum == 30 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  spin:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rsi, 0
  __il_body#10:
    x64.jumpTable rsi, default=matchdead#18 [[0..6]=__il_cont#9] @__jumptable_8
  matchdead#18:
  matcharm#11:
  __il_cont#9:
    x64.leaRegRegReg rax, rax, rdx
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rsi, 1
  __il_body#20:
    x64.jumpTable rsi, default=matchdead#28 [[0..6]=__il_cont#8] @__jumptable_9
  matchdead#28:
  matcharm#21:
  __il_cont#8:
    x64.leaRegRegReg rax, rax, rdx
    x64.movRegImm32 rdx, 4
    x64.movRegImm32 rsi, 2
  __il_body#30:
    x64.jumpTable rsi, default=matchdead#38 [[0..6]=__il_cont#7] @__jumptable_10
  matchdead#38:
  matcharm#31:
  __il_cont#7:
    x64.leaRegRegReg rax, rax, rdx
    x64.movRegImm32 rdx, 8
    x64.movRegImm32 rsi, 3
  __il_body#40:
    x64.jumpTable rsi, default=matchdead#48 [[0..6]=__il_cont#6] @__jumptable_11
  matchdead#48:
  matcharm#41:
  __il_cont#6:
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegImm32 rcx, rcx, 1
  whilehdr:
    x64.cmpRegImm32 rcx, 2
    x64.jcc less, spin
  whileexit:
    x64.cmpRegImm32 rax, 30
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
