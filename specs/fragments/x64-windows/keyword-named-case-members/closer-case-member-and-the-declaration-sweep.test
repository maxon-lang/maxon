// Test: closer-case-member-and-the-declaration-sweep
enum Kw
	alpha
	end
	omega
end 'Kw'

var counter = 10

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function shadowing() returns Integer
	let a = tagOf(Kw.end)
	var counter = 100
	counter = counter + 1
	return a + counter
end 'shadowing'

function main() returns ExitCode
	return (shadowing() + counter) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 113
---
data {
  __data_counter@0 = i64 10
  __sched_tls_teb_offset@8 = i64 0
  __sched_allm@16 = i64 0
  __sched_lock@24 = i64 0
  __sched_preempt_ext_lock@32 = i64 0
  __sched_preempt_context@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.movRegImm32 rax, 2
  __il_cont#6:
    x64.leaRegRegImm32 rax, rax, 101
  __il_cont#4:
    x64.leaRegGlobal rcx, __data_counter
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at closer-case-member-and-the-declaration-sweep.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
