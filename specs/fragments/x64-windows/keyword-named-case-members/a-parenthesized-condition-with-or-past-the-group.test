// Test: a-parenthesized-condition-with-or-past-the-group
function main() returns ExitCode
	var i = 0
	var acc = 0
	while ((i < 2) or (i < 0)) or false 'spin'
		if ((i == 0) or (i == 1)) and true 'inner'
			acc = acc + 21
		end 'inner'
		i = i + 1
	end 'spin'
	if acc == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  whilehdr:
    x64.cmpRegImm32 rax, 2
    x64.movRegImm32 rdx, 1
    x64.jcc less, scmerge#3
  orrhs#2:
    x64.movRegImm32 rdx, 0
  scmerge#3:
    x64.movRegImm32 rsi, 1
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, scmerge#5
  orrhs#4:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rsi, rdx
  scmerge#5:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, whileexit
  spin:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rdx, 1
    x64.jcc equal, scmerge#9
  orrhs#8:
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rdx
  scmerge#9:
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, critsplit
  andrhs:
    x64.movRegImm32 rdx, 1
    x64.jmp scmerge#11
  critsplit:
    x64.movRegReg rdx, rsi
  scmerge#11:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont#13
  inner:
    x64.leaRegRegImm32 rcx, rcx, 21
  ifcont#13:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rcx, 42
    x64.jcc notEqual, ifcont#15
  ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont#15:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
