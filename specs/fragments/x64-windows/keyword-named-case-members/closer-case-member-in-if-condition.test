// Test: closer-case-member-in-if-condition
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	if tagOf(Kw.end) == 2 'ok'
		return 20
	end 'ok'
	return 1
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 20
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ok:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
}
