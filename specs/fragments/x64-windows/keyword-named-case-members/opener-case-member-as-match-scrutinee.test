// Test: opener-case-member-as-match-scrutinee
enum Kw
	alpha
	match
	omega
end 'Kw'

function main() returns ExitCode
	match Kw.match 'm'
		alpha then return 11
		match then return 22
		omega then return 33
	end 'm'
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 22
    x64.popReg rbp
    x64.ret
}
