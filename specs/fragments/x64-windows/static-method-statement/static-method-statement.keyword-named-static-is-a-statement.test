// Test: static-method-statement.keyword-named-static-is-a-statement
type Helper
	export static function match()
		print("m")
	end 'match'

	export static function upto()
		print("u")
	end 'upto'

	export static function to()
		print("t")
	end 'to'
end 'Helper'

function main() returns ExitCode
	Helper.match()
	Helper.upto()
	Helper.to()
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body#4:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "m"
    x64.callDirect print
  __il_body#5:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "u"
    x64.callDirect print
  __il_body#6:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "t"
    x64.callDirect print
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
