// Test: sunk-arms-of-a-nested-loop-keep-both-edges
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function grid(a WordArray, rows Word, width Word) returns Word
	var t = 0
	for r in 0 upto rows 'row'
		var line = 0
		for c in 0 upto width 'col'
			line = line + (try a.get(r * width + c) otherwise 100)
		end 'col'
		t = t + line * (r + 1)
	end 'row'
	return t
end 'grid'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 7 'seed'
		a.push(i)
	end 'seed'
	return grid(a, rows: 3, width: 3) - 600
end 'main'
---
ExitCode: 45
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 80
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  seed:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 7
    x64.jcc less, seed
  __il_body:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  __us_test:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
    x64.jmp forhdr#10
  row:
    x64.movRegImm32 rdi, 0
    x64.movRegImm32 r8, 0
    x64.jmp forhdr#14
  col:
    x64.imulRegRegImm32 r9, rcx, 3
    x64.leaRegRegReg r9, r9, r8
  __rc_ok#21:
    x64.cmpRegReg r9, rdx
    x64.jcc aboveEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 r9, 100
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseIndexScale.word64 r9, [rsi + r9*8 + 0]
  trycont:
    x64.leaRegRegReg rdi, rdi, r9
  forstep#16:
    x64.leaRegRegImm32 r8, r8, 1
  forhdr#14:
    x64.cmpRegImm32 r8, 3
    x64.jcc less, col
  forexit:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.imulRegReg rdi, rdi, rcx
    x64.leaRegRegReg rax, rax, rdi
  forhdr#10:
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, row
  __il_cont:
    x64.leaRegRegImm32 r12, rax, -600
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
  __rc_ok#5:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.storeSlotReg slot0, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot2, rdx
    x64.storeSlotReg slot3, rsi
    x64.storeSlotReg slot4, rdi
    x64.storeSlotReg slot5, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r9
    x64.callDirect __managed_get
    x64.movRegReg r9, r8
    x64.loadRegSlot rax, slot0
    x64.loadRegSlot rcx, slot1
    x64.loadRegSlot rdx, slot2
    x64.loadRegSlot rsi, slot3
    x64.loadRegSlot rdi, slot4
    x64.loadRegSlot r8, slot5
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp trycont
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at sunk-arms-of-a-nested-loop-keep-both-edges.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
