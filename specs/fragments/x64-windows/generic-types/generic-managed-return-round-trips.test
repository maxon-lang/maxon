    x64.storeSlotReg slot0, r12
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_body#5:
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#2:
    x64.leaRegRdata rax, [rip + __layout_Box_Alpha]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect Box.echo
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot1, rbx
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __layout_Box_Alpha]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Box.echo
    x64.storeSlotReg slot2, r8
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "a="
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
