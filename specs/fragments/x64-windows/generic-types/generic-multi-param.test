  __il_body#7:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
  __il_cont#6:
    x64.leaRegRdata rcx, [rip + __layout_Pair_Integer_Integer]
  __il_body#8:
    x64.loadRegBaseDisp.word64 rdx, [r13 + 0]
    x64.callDirect __retain_type_param
  __il_cont#5:
    x64.cmpRegImm32 r8, 3
    x64.jcc notEqual, ifcont
  c1:
    x64.leaRegRdata rax, [rip + __layout_Pair_Integer_Integer]
  __il_body#10:
    x64.loadRegBaseDisp.word64 rdx, [r13 + 8]
    x64.leaRegRegImm32 rcx, rax, 72
    x64.callDirect __retain_type_param
  __il_cont#9:
    x64.cmpRegImm32 r8, 4
    x64.jcc notEqual, ifcont
  c2:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
