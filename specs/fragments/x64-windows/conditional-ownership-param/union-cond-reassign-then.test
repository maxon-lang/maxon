// Test: union-cond-reassign-then
typealias Integer = int(i64.min to i64.max)

union Num
	none
	val(v Integer)
end 'Num'

function pick(u Num, c Integer) returns Integer
	var q = u
	if c > 0 'b'
		q = Num.val(7)
	end 'b'
	return match q 'm'
		none gives 0
		val(v) gives v
	end 'm'
end 'pick'

function main() returns ExitCode
	let base = Num.val(5)
	return pick(base, c: 1)
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
  __il_body:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_retain
  b:
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  ifcont:
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, matchnext
  matcharm:
    x64.movRegImm32 rbx, 0
    x64.jmp __il_cont
  matchnext:
    x64.cmpRegImm32 r13, 1
    x64.jcc notEqual, matchdead
  __il_cont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at union-cond-reassign-then.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
