// Test: struct-continue-after-reassign
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer

	static function create(x Integer) returns Self
		return Self{x: x}
	end 'create'
end 'Point'

function pick(p Point, n Integer) returns Integer
	var q = p
	var i = 0
	while i < n 'l'
		if i > 0 'b'
			q = Point.create(9)
			i = i + 1
			continue
		end 'b'
		i = i + 1
	end 'l'
	return q.x
end 'pick'

function main() returns ExitCode
	let base = Point.create(5)
	return pick(base, n: 2)
end 'main'
---
ExitCode: 9
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Point.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.callDirect Point.create
    x64.movRegReg rbx, r8
  __il_body:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegImm32 r12, 0
    x64.movRegReg r13, r12
    x64.movRegReg r12, r8
    x64.jmp whilehdr
  l:
    x64.cmpRegImm32 r13, 0
    x64.jcc lessEqual, ifcont
  b:
    x64.movRegImm32 rcx, 9
    x64.callDirect Point.create
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, r14
    x64.jmp whilehdr
  ifcont:
    x64.leaRegRegImm32 r13, r13, 1
  whilehdr:
    x64.cmpRegImm32 r13, 2
    x64.jcc less, l
  whileexit:
    x64.loadRegBaseDisp.word64 r13, [r12 + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
  __il_cont:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at struct-continue-after-reassign.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
