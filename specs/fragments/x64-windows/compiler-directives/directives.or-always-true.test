// Test: directives.or-always-true
function main() returns ExitCode
	#if os(Windows) or os(Linux) or os(Macos) or os(Wasi)
		return 5
	#else
		return 99
	#endif
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 5
    x64.popReg rbp
    x64.ret
}
