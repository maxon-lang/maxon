// Test: runtime-yield.managed-across-yield
typealias Integer = int(i64.min to i64.max)

function held() returns Integer
	let label = "green"
	var i = 0
	while i < 50 'l'
		Runtime.yield()
		i = i + 1
	end 'l'
	return label.count()
end 'held'

function main() returns ExitCode
	let p = async held()
	let n = await p
	let echo = "green"
	Runtime.yield()
	return (n + (echo.count() as Integer)) as ExitCode
end 'main'
---
ExitCode: 10
