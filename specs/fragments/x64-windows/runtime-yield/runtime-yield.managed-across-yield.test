func @held {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "green"
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  l:
    x64.callDirect Runtime.yield
    x64.leaRegRegImm32 r12, r12, 1
  whilehdr:
    x64.cmpRegImm32 r12, 50
    x64.jcc less, l
  whileexit:
    x64.movRegReg rcx, rbx
    x64.callDirect String.count
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

