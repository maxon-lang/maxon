// Test: module-struct-container-field-read
typealias Count = int(0 to 1000)
typealias CountArray = Array with Count
typealias NameArray = Array with String

type Facts
	export var counts as CountArray = CountArray.create()
	export var names as NameArray = NameArray.create()
	export static function create() returns Facts
		return Self{}
	end 'create'
end 'Facts'

let SharedFacts = Facts.create()
var MutableFacts = Facts.create()

function main() returns ExitCode
	MutableFacts.counts.push(7)
	let shared = SharedFacts.counts.count() + SharedFacts.names.count()
	let mutable = MutableFacts.counts.count() + MutableFacts.names.count()
	return (shared + mutable) as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __data_MutableFacts@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_console_probe_stdin@40 = i8 0
  __mrt_console_probe_stdout@41 = i8 0
  __mrt_console_probe_stderr@42 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_MutableFacts
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 7
    x64.callDirect __managed_push
    x64.leaRegRdata rax, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.leaRegRdata rcx, [rip + __struct_rec_0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegGlobal rcx, __data_MutableFacts
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegGlobal rdx, __data_MutableFacts
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 8]
    x64.leaRegRegReg rcx, rcx, rdx
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at module-struct-container-field-read.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @__fieldDefault#Facts#counts {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @__fieldDefault#Facts#names {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
