// Test: panic-runtime-chunk
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

chunk @mrt_panic {
    0000: 55 48 89 e5 48 83 ec 20 e8 00 00 00 00 48 8d 0d
    0010: 21 00 00 00 e8 00 00 00 00 48 89 e9 48 89 ea e8
    0020: 00 00 00 00 b9 01 00 00 00 ff 15 00 00 00 00 48
    0030: 83 c4 20 5d c3 53 74 61 63 6b 20 74 72 61 63 65
    0040: 3a 0a 00
}
