// Test: terminal-color-detection.answers-false-when-stdout-is-captured
function main() returns ExitCode
	if __Builtins.stdoutWantsAnsiColor() 'wantsColor'
		return 1
	end 'wantsColor'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __tty_stdout_wants_color
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  wantsColor:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
