// Test: if-inside-a-try-handler
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var flag = 0 as Integer
	try [10, 20, 30].get(9) otherwise 'h'
		if [1, 2].count() == 2 'y'
			flag = 4
		end 'y'
	end 'h'
	return flag
end 'main'
---
ExitCode: 4
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.movRegImm32 rdx, 9
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 9
    x64.jcc belowEqual, __im_slow
    x64.jmp __im_load
  tryerr:
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_1]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, r13
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, critsplit
  y:
    x64.movRegImm32 rax, 4
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, rbx
  ifcont:
    x64.movRegReg rbx, rax
    x64.jmp trycont
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegImm32 rax, rax, 72
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  trycont:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __im_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp trycont
}
