// Test: builtin-interface-user-code
type MyCollection uses Element implements BuiltinArrayLiteral
	typealias Buf = __ManagedMemory with Element

	var managed as Buf

	static function init(managed Buf) returns Self
		return Self{managed: managed}
	end 'init'
end 'MyCollection'

function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
  __mrt_console_probe_stdin@8 = i8 0
  __mrt_console_probe_stdout@9 = i8 0
  __mrt_console_probe_stderr@10 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
