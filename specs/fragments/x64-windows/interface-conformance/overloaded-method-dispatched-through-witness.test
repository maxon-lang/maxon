// Test: overloaded-method-dispatched-through-witness
typealias Code = int(0 to u32.max)

interface Labeled
	function label() returns Code
end 'Labeled'

type Tag implements Labeled
	export var x as Code

	static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'

	function label(extra Code) returns Code
		return 7
	end 'label'

	function label() returns Code
		return 42
	end 'label'
end 'Tag'

type Box uses T where T is Labeled
	export var item as T

	static function create(item T) returns Self
		return Self{ item: item }
	end 'create'

	function run() returns Code
		return self.item.label()
	end 'run'
end 'Box'

typealias TagBox = Box with Tag

function main() returns ExitCode
	let t = Tag.create(1)
	let b = TagBox.create(t)
	return b.run()
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @Tag.label# {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#3:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_own
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __witness_Tag.Labeled]
  __il_body#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
  __il_cont#2:
    x64.leaRegRdata rax, [rip + __witness_Tag.Labeled]
  __il_body#9:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.callMem [rax + 48]
    x64.movRegReg rbx, r8
  __il_cont#1:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Tag
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
