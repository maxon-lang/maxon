// Test: cmp-shifted-imm12-band
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(16773120)
	if not (x == 16773120) 'eqTop'
		return 21
	end 'eqTop'
	if x > 16773120 'gtTop'
		return 22
	end 'gtTop'
	if not (x < 16777216) 'ltPair'
		return 23
	end 'ltPair'
	if x == 16777216 'eqPair'
		return 24
	end 'eqPair'
	let y = base(16777216)
	if not (y == 16777216) 'eqPairSelf'
		return 25
	end 'eqPairSelf'
	if not (y > 16773120) 'gtTopFromPair'
		return 26
	end 'gtTopFromPair'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
