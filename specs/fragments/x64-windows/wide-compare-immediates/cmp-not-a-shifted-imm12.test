// Test: cmp-not-a-shifted-imm12
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(65535)
	if not (x == 65535) 'eqWord'
		return 31
	end 'eqWord'
	if x > 65535 'gtWord'
		return 32
	end 'gtWord'
	if not (x < 65536) 'ltNext'
		return 33
	end 'ltNext'
	let y = base(16777215)
	if not (y == 16777215) 'eqPairMax'
		return 34
	end 'eqPairMax'
	if not (y > 65535) 'gtWordFromPair'
		return 35
	end 'gtWordFromPair'
	if y == 16777214 'eqOffByOne'
		return 36
	end 'eqOffByOne'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
