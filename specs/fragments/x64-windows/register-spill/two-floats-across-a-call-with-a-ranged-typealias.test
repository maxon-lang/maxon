  __rc_chk#3:
    x64.cmpRegImm32 rcx, 1000000000
    x64.jcc greater, __rc_panic#2
  __il_body:
    x64.leaRegRegImm32 rax, rcx, 1
  __rc_chk#11:
    x64.cmpRegImm32 rax, 1000000000
    x64.jcc greater, __rc_panic#10
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 348
  __rc_chk#6:
    x64.cmpRegImm32 r8, 1000000000
    x64.jcc greater, __rc_panic#5
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at two-floats-across-a-call-with-a-ranged-typealias.test:8: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at two-floats-across-a-call-with-a-ranged-typealias.test:5: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at two-floats-across-a-call-with-a-ranged-typealias.test:14: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect probe
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 0
    x64.callDirect probe
    x64.subRegReg rbx, rbx, r8
    x64.leaRegRegImm32 r8, rbx, 41
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
