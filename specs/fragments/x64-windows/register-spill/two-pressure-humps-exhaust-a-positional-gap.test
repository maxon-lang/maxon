// Test: two-pressure-humps-exhaust-a-positional-gap
typealias WideNum = int(0 to 100000000)

function scaleOpaque(x WideNum) returns WideNum
	return x
end 'scaleOpaque'

function humps(g WideNum) returns WideNum
	let a0 = scaleOpaque(0)
	let a1 = scaleOpaque(1)
	let a2 = scaleOpaque(2)
	let a3 = scaleOpaque(3)
	let a4 = scaleOpaque(4)
	let a5 = scaleOpaque(5)
	let a6 = scaleOpaque(6)
	let a7 = scaleOpaque(7)
	let a8 = scaleOpaque(8)
	let a9 = scaleOpaque(9)
	let a10 = scaleOpaque(10)
	let a11 = scaleOpaque(11)
	let p0 = a0 + a1
	let p1 = a2 + a3
	let p2 = a4 + a5
	let p3 = a6 + a7
	let p4 = a8 + a9
	let p5 = a10 + a11
	let b0 = scaleOpaque(0)
	let b1 = scaleOpaque(1)
	let b2 = scaleOpaque(2)
	let b3 = scaleOpaque(3)
	let b4 = scaleOpaque(4)
	let b5 = scaleOpaque(5)
	let b6 = scaleOpaque(6)
	let b7 = scaleOpaque(7)
	let b8 = scaleOpaque(8)
	let b9 = scaleOpaque(9)
	let b10 = scaleOpaque(10)
	let b11 = scaleOpaque(11)
	let q0 = b0 + b1
	let q1 = b2 + b3
	let q2 = b4 + b5
	let q3 = b6 + b7
	let q4 = b8 + b9
	let q5 = b10 + b11
	return g + p0 + p1 + p2 + p3 + p4 + p5 + q0 + q1 + q2 + q3 + q4 + q5
end 'humps'

function main() returns ExitCode
	let r = humps(7)
	if r == 139 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
  __rc_ok:
    x64.movRegImm32 rax, 0
  __il_cont#33:
    x64.movRegImm32 rcx, 2
  __il_cont#31:
    x64.movRegImm32 rdx, 4
  __il_cont#29:
    x64.movRegImm32 rsi, 6
  __il_cont#27:
    x64.movRegImm32 rdi, 8
  __il_cont#25:
    x64.movRegImm32 r8, 10
  __il_cont#23:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 rcx, rcx, 3
    x64.leaRegRegImm32 rdx, rdx, 5
    x64.leaRegRegImm32 rsi, rsi, 7
    x64.leaRegRegImm32 rdi, rdi, 9
    x64.leaRegRegImm32 r8, r8, 11
    x64.movRegImm32 r9, 0
  __il_cont#21:
    x64.movRegImm32 r10, 2
  __il_cont#19:
    x64.movRegImm32 r11, 4
  __il_cont#17:
    x64.movRegImm32 rbx, 6
  __il_cont#15:
    x64.movRegImm32 r12, 8
  __il_cont#13:
    x64.movRegImm32 r13, 10
  __il_cont#11:
    x64.leaRegRegImm32 r9, r9, 1
    x64.leaRegRegImm32 r10, r10, 3
    x64.leaRegRegImm32 r11, r11, 5
    x64.leaRegRegImm32 rbx, rbx, 7
    x64.leaRegRegImm32 r12, r12, 9
    x64.leaRegRegImm32 r13, r13, 11
    x64.leaRegRegImm32 rax, rax, 7
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg rax, rax, r10
    x64.leaRegRegReg rax, rax, r11
    x64.leaRegRegReg rax, rax, rbx
    x64.leaRegRegReg rax, rax, r12
    x64.leaRegRegReg rax, rax, r13
  ok:
