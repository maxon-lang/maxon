// Test: loop-invariant-read-across-a-call-in-a-loop
function sink(x Integer) returns Integer
	return x
end 'sink'

function invariantsAcrossCall(p Integer) returns Integer
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	var acc = 0
	var i = 0
	while i < 3 'loop'
		let pre = acc + a1 + a2 + a3 + a4 + a5 + a6
		let r = sink(i)
		acc = pre + r + a1 + a2 + a3 + a4 + a5 + a6
		i = i + 1
	end 'loop'
	return acc
end 'invariantsAcrossCall'

function main() returns ExitCode
	return invariantsAcrossCall(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 129
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
