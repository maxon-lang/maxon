// Test: float-locals-read-after-each-of-four-calls
function work(x Integer) returns Integer
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var acc = 0
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	return acc
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 16
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#8:
    x64.movRegImm32 rax, 1
  __il_cont#7:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 rax, rax, 2
  __il_body#9:
    x64.leaRegRegImm32 rax, rax, 1
  __il_cont#6:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 rax, rax, 2
  __il_body#10:
    x64.leaRegRegImm32 rax, rax, 1
  __il_cont#5:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 rax, rax, 2
  __il_body#11:
    x64.leaRegRegImm32 rax, rax, 1
  __il_cont#4:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 r8, rax, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
