// Test: the-statement-form-the-diagnostic-names-compiles
enum Colour
	red
	green
end 'Colour'

function main() returns ExitCode
	let c = Colour.green
	match c 'e'
		red then panic("a")
		green then print("green")
	end 'e'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "green"
  __il_body:
    x64.callDirect __write_stdout
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
