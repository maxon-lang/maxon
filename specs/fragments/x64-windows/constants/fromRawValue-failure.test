// Test: fromRawValue-failure

typealias Integer = int(i64.min to i64.max)

enum HttpStatus
	ok = 200
	notFound = 404
end 'HttpStatus'

function getCode() returns Integer
	return 999
end 'getCode'

function main() returns ExitCode
	let code = getCode()
	let status = try HttpStatus.fromRawValue(code) otherwise HttpStatus.ok
	if status == HttpStatus.ok 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rcx, 999
  __il_cont:
    x64.callDirect __enum_from_raw_HttpStatus
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, check
  tryok:
    x64.cmpRegImm32 r8, 200
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
