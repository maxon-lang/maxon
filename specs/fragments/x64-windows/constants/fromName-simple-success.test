// Test: fromName-simple-success
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	let dir = try Direction.fromName("south") otherwise Direction.north
	if dir == Direction.south 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "south"
    x64.callDirect __enum_from_name_Direction
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, ifcont
  tryok:
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
