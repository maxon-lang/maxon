// Test: char-comparison
enum Escape
	newline = '\n'
	tab = '\t'
end 'Escape'

function main() returns ExitCode
	let ch = '\n'
	if ch == Escape.newline 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "\x0a"
    x64.movRegImm32 rcx, 10
    x64.callDirect __char_from_cp
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_eq
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
