// Test: contested-free-function-root-declaration-does-not-inherit-a-subdirectory-candidates-facts
// --- file: alpha/f.maxon
function pick()
	panic("alpha never returns")
end 'pick'

// --- file: beta/f.maxon
function pick()
	print("beta pick\n")
end 'pick'

// --- file: main.maxon
function pick()
	print("root pick\n")
end 'pick'

function main() returns ExitCode
	pick()
	print("after\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "root pick\x0a"
    x64.callDirect print
  __il_cont:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "after\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
