// Test: a-qualified-type-reaches-its-declaration-past-the-readers-own-alias
// --- file: a/foo.maxon
export type Foo
	export let v as ExitCode

	export static function make() returns Foo
		return Foo{v: 42}
	end 'make'
end 'Foo'

// --- file: app/main.maxon
typealias Foo = int(0 to 10)

function take(f a.Foo) returns ExitCode
	return f.v
end 'take'

function main() returns ExitCode
	let local = 3 as Foo
	return take(a.Foo.make()) + (local as ExitCode)
end 'main'
---
ExitCode: 45
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
  __mrt_program_started@3 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 42
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 3
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
