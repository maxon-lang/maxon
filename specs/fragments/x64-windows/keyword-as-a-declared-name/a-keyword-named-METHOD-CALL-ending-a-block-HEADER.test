// Test: a-keyword-named-METHOD-CALL-ending-a-block-HEADER
typealias Integer = int(i64.min to i64.max)

type Ops
	static function otherwise(n Integer) returns bool
		return n < 3
	end 'otherwise'
end 'Ops'

function main() returns ExitCode
	var i = 0
	while Ops.otherwise(i) 'loop'
		i = i + 1
	end 'loop'

	if Ops.otherwise(i) 'lbl'
		i = 99
	end 'lbl'

	return (i * 14) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jmp __il_body
  loop:
    x64.leaRegRegImm32 rax, rax, 1
  __il_body:
    x64.cmpRegImm32 rax, 3
    x64.setccReg less, rcx
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, loop
  ifcont:
    x64.imulRegRegImm32 r8, rax, 14
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-keyword-named-METHOD-CALL-ending-a-block-HEADER.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
