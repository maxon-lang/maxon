// Test: a-keyword-named-condition-BESIDE-keyword-named-match-arms
typealias Integer = int(i64.min to i64.max)

enum Kw
	function
	end
	if
	other
end 'Kw'

function score(k Kw) returns Integer
	return match k 'classify'
		function gives 1
		end gives 4
		if gives 8
		other gives 16
	end 'classify'
end 'score'

function gap(to Integer, from Integer) returns Integer
	if to >= from 'forward'
		return to - from
	end 'forward'

	return 0
end 'gap'

function main() returns ExitCode
	return (score(Kw.end) + gap(46, from: 8)) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
  __il_body:
    x64.jumpTable rax, default=matchdead [[0]=matcharm#7, [1]=matcharm#8, [2]=matcharm#9, [3]=matcharm#10] @__jumptable_1
  matchdead:
  matcharm#7:
    x64.movRegImm32 rax, 1
    x64.jmp forward
  matcharm#8:
    x64.movRegImm32 rax, 4
    x64.jmp forward
  matcharm#9:
    x64.movRegImm32 rax, 8
    x64.jmp forward
  matcharm#10:
    x64.movRegImm32 rax, 16
  forward:
    x64.movRegImm32 rcx, 38
  __il_cont:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-keyword-named-condition-BESIDE-keyword-named-match-arms.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
