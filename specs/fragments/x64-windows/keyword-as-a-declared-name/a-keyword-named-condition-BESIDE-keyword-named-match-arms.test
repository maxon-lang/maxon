// Test: a-keyword-named-condition-BESIDE-keyword-named-match-arms
typealias Integer = int(i64.min to i64.max)

enum Kw
	function
	end
	if
	other
end 'Kw'

function score(k Kw) returns Integer
	return match k 'classify'
		function gives 1
		end gives 4
		if gives 8
		other gives 16
	end 'classify'
end 'score'

function gap(to Integer, from Integer) returns Integer
	if to >= from 'forward'
		return to - from
	end 'forward'

	return 0
end 'gap'

function main() returns ExitCode
	return (score(Kw.end) + gap(46, from: 8)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
  __il_body:
    x64.jumpTable rax, default=matchdead [[0]=matcharm#7, [1]=matcharm#8, [2]=matcharm#9, [3]=matcharm#10] @__jumptable_1
  matchdead:
  matcharm#7:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  matcharm#8:
    x64.movRegImm32 rax, 4
    x64.jmp __il_cont
  matcharm#9:
    x64.movRegImm32 rax, 8
    x64.jmp __il_cont
  matcharm#10:
    x64.movRegImm32 rax, 16
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 38
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
