// Test: let-arg-at-mutated-position-error
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function copyInto(dest IntArray, src IntArray)
	dest.push(src.count())
end 'copyInto'

function main() returns ExitCode
	let a = IntArray.create()
	var b = IntArray.create()
	copyInto(a, src: b)
	return b.count() as ExitCode
end 'main'
---
CompilerError:
error E3019: <fragment>:12:2: cannot pass 'a' to function that mutates parameter 'dest' (in main)
