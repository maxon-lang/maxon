  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#9
  __rc_chk#10:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic#9
  __rc_ok#8:
    x64.storeBaseDispReg.word64 [r8 + 0], rax
  __il_body#13:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#15
  __rc_chk#16:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __rc_panic#15
