// Test: postfix.method-on-a-set-call-result
typealias Wide = int(i64.min to i64.max)
typealias WideSet = Set with Wide

function main() returns ExitCode
	return WideSet.create().count() + 11
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Set_Wide]
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.callDirect Set.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 24]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk#7:
    x64.movRegImm rsi, 4611686018427387904
    x64.cmpRegReg rcx, rsi
    x64.jcc lessEqual, __rc_ok#6
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect Set.count
    x64.jmp __il_cont
  __rc_ok#6:
    x64.movRegReg r8, rcx
  __il_cont:
    x64.leaRegRegImm32 r12, r8, 11
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Set_Wide
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk#3:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_17]  ; "panic at postfix.method-on-a-set-call-result.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
