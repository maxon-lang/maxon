// Test: swapping-managed-elements-through-a-whole-reversal
typealias StrArray = Array with String

function main() returns ExitCode
	var xs = StrArray.create()
	xs.push("one heap string long enough to require an allocation")
	xs.push("two heap string long enough to require an allocation")
	xs.push("three heap string long enough to require an allocation")
	xs.push("four heap string long enough to require an allocation")

	var lo = 0
	var hi = xs.count() - 1
	while lo < hi 'reverse'
		try xs.managed.swap(lo, j: hi) otherwise return 99
		lo = lo + 1
		hi = hi - 1
	end 'reverse'

	for s in xs 'each'
		print("{s}\n")
	end 'each'
	return xs.count()
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "one heap string long enough to require an allocation"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "two heap string long enough to require an allocation"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "three heap string long enough to require an allocation"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata rcx, [rip + __str_rec_8]  ; "four heap string long enough to require an allocation"
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.leaRegRegImm32 r13, rax, -1
  whilehdr:
    x64.cmpRegReg r12, r13
    x64.jcc greaterEqual, whileexit
  reverse:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __managed_mem_swap
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.leaRegRegImm32 r12, r12, 1
    x64.leaRegRegImm32 r13, r13, -1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rax, 0
  forhdr:
    x64.storeSlotReg slot0, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  each:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rcx + rax*8 + 0]
  __im_cont:
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRdata rax, [rip + __str_rec_9]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot3, rax
    x64.leaRegRegReg rax, r13, rax
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.loadRegSlot r13, slot3
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot2
    x64.storeBaseDispReg.word64 [r12 + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_10]  ; "panic at swapping-managed-elements-through-a-whole-reversal.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
