// Test: shift-left-closes-the-hole
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var arr = ByteArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)
	try arr.managed.shiftLeft(2, 1) otherwise return 98
	try arr.managed.setLength(2) otherwise return 97
	var total = 0
	for v in arr 'sum'
		total = total + v
	end 'sum'
	return total
end 'main'
---
ExitCode: 40
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_mem_shift_left
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 98
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r12, 97
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rdx, 0
  __us_test:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.loadRegBaseDisp.word64 r14, [rbx + 24]
    x64.loadRegBaseDisp.word64 r15, [rbx + 0]
    x64.jmp forhdr
  sum:
    x64.cmpRegImm32 r14, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseIndexScale.word64 rax, [r15 + rdx*8 + 0]
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 r14, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.leaRegRegReg rax, r15, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
  __im_cont:
    x64.leaRegRegReg r12, r12, rax
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rdx, rax, 1
  forhdr:
    x64.storeSlotReg slot0, rdx
    x64.cmpRegReg rdx, r13
    x64.jcc less, sum
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at shift-left-closes-the-hole.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
