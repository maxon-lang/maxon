// Test: max.fractional
function main() returns ExitCode
	let x = max(3.5, 5.2)
	// max of 3.5 and 5.2 is 5.2, trunc gives 5
	return trunc(x)
end 'main'
---
ExitCode: 5
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 5
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
