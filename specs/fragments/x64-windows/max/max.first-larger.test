// Test: max.first-larger
function main() returns ExitCode
	let x = max(10.0, 2.0)
	return trunc(x)
end 'main'
---
ExitCode: 10
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 10
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
