// Test: inline-records.as-a-field-of-a-heap-record
typealias Half = int(0 to u32.max)
typealias Integer = int(i64.min to i64.max)

type Pair
	export let lo as Half
	export let hi as Half

	static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

type Outer
	export var p as Pair
	export var n as Integer

	static function create(p Pair, n Integer) returns Self
		return Self{p: p, n: n}
	end 'create'
end 'Outer'

function main() returns ExitCode
	return sizeof(Outer)
end 'main'
---
ExitCode: 16
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 16
    x64.popReg rbp
    x64.ret
}
