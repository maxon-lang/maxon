// Test: inline-records.a-nonzero-lower-bound-stays-a-heap-record
typealias Tri = int(1 to 3)

type Duo
	export let a as Tri
	export let b as Tri

	static function create(a Tri, b Tri) returns Self
		return Self{a: a, b: b}
	end 'create'
end 'Duo'

function main() returns ExitCode
	return sizeof(Duo)
end 'main'
---
ExitCode: 16
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 16
    x64.popReg rbp
    x64.ret
}
