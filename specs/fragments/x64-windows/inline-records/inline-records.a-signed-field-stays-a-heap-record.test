// Test: inline-records.a-signed-field-stays-a-heap-record
typealias Signed = int(i64.min to i64.max)

type Span
	export let low as Signed
	export let high as Signed

	static function create(low Signed, high Signed) returns Self
		return Self{low: low, high: high}
	end 'create'
end 'Span'

function main() returns ExitCode
	return sizeof(Span)
end 'main'
---
ExitCode: 16
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_state@40 = i64 0
  __ds_base@48 = i64 0
  __dbg_ctl@56 = i64 0
  __mrt_console_probe_stdin@64 = i8 0
  __mrt_console_probe_stdout@65 = i8 0
  __mrt_console_probe_stderr@66 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 16
    x64.popReg rbp
    x64.ret
}
