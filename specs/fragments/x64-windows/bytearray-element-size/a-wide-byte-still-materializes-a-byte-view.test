// Test: a-wide-byte-still-materializes-a-byte-view
typealias Byte = int(0 to 1000)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	let first = try b.get(0) otherwise 0
	let second = try b.get(1) otherwise 0
	return 0 if b.count() == 2 and first == 195 and second == 159 else 1
end 'takes'

function main() returns ExitCode
	let c = 'ß'
	return takes(c.bytes())
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "\xc3\x9f"
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
  __il_body:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#5
  tryok#3:
    x64.movRegReg rbx, r8
  trycont#5:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#6
  tryerr#7:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg rax, r8
  trycont#8:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 8]
    x64.cmpRegImm32 rcx, 2
    x64.movRegImm32 rcx, 0
    x64.jcc notEqual, scmerge#10
  andrhs#9:
    x64.cmpRegImm32 rbx, 195
    x64.setccReg equal, rcx
  scmerge#10:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  andrhs#11:
    x64.cmpRegImm32 rax, 159
    x64.setccReg equal, rax
    x64.jmp scmerge#12
  critsplit:
    x64.movRegReg rax, rdx
  scmerge#12:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rbx, 0
    x64.jmp __il_cont
  ternaryfalse:
    x64.movRegImm32 rbx, 1
  __il_cont:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
