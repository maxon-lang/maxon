// Test: a-raw-byte-write-is-accepted-when-the-element-fills-its-two-byte-slot
typealias Byte = int(0 to u16.max)
typealias Bytes = Array with Byte

function main() returns ExitCode
	var a = Bytes.create()
	a.push(1)
	try a.managed.setByte(1, 223) otherwise return 3
	return 0 if (try a.get(0) otherwise 0) == 57089 else 4
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 223
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_byte
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, ternaryfalse
  tryok#3:
    x64.cmpRegImm32 r8, 57089
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 4
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
