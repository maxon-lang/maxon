// Test: a-byte-packed-buffer-under-the-canonical-byte-still-takes-a-raw-byte-write
typealias Byte = int(0 to u8.max)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	return (try b.get(0) otherwise 0)
end 'takes'

function main() returns ExitCode
	var buf = try __ManagedMemory.create(8, 1) otherwise return 1
	try buf.setLength(4) otherwise return 2
	try buf.setByte(0, 223) otherwise return 3
	return 0 if takes(buf) == 223 else 4
end 'main'
---
ExitCode: 0
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_mem_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 223
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_byte
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_body
  tryerr#6:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load#24:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load#25:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __il_cont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
  tryerr#16:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  critsplit:
    x64.movRegReg rax, r8
  __il_cont:
    x64.cmpRegImm32 rax, 223
    x64.jcc notEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 4
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
