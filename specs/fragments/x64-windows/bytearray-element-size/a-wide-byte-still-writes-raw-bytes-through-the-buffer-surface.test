// Test: a-wide-byte-still-writes-raw-bytes-through-the-buffer-surface
typealias Byte = int(0 to u16.max)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	return (try b.get(0) otherwise 0)
end 'takes'

function main() returns ExitCode
	var buf = Bytes.create()
	buf.push(0)
	try buf.managed.setByte(0, 223) otherwise return 3
	return takes(buf)
end 'main'
---
ExitCode: 223
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 223
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_byte
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, __il_body
  tryerr#2:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr#6:
    x64.movRegImm32 r12, 0
    x64.jmp __il_cont
  tryok:
    x64.movRegReg r12, r8
  __il_cont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
