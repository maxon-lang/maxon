// Test: promoted-record-in-a-loop-reuses-one-slot
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	var total = 0
	for i in 0 upto 6 'each'
		let p = Point.create(i, y: i + 1)
		total = total + p.x + p.y
	end 'each'
	return total
end 'main'
---
ExitCode: 36
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  forhdr:
    x64.cmpRegImm32 rax, 6
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRegImm32 rcx, rax, 1
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.leaRegRegReg rcx, r8, rcx
    x64.loadRegBaseDisp.word64 rdx, [rdx + 8]
    x64.leaRegRegReg r8, rcx, rdx
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at promoted-record-in-a-loop-reuses-one-slot.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
