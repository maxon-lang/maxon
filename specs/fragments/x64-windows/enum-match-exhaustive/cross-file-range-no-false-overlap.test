// Test: cross-file-range-no-false-overlap
// --- file: ops.maxon
export union WideOp
	call
	ret
	param
	extra
end 'WideOp'

export union NarrowOp
	ret
	call
	param
end 'NarrowOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op NarrowOp) returns Code
	return match op 'check'
		ret gives 1
		call or
			param gives 2
	end 'check'
end 'classify'

function describeWide(op WideOp) returns Code
	return match op 'check'
		call or
			ret or
			param or
			extra gives 9
	end 'check'
end 'describeWide'

function main() returns ExitCode
	let narrow = classify(NarrowOp.call)
	let wide = describeWide(WideOp.ret)
	if wide == 9 'wideOk'
		return narrow
	end 'wideOk'
	return 99
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 2
  wideOk:
    x64.popReg rbp
    x64.ret
}
