// Test: enum-exhaustive.int-backed-range-covers-lower-bound
enum Level
	low = 10
	medium = 20
	high = 30
end 'Level'

function classify(l Level) returns ExitCode
	let r = match l 'm'
		low or
			medium gives 41
		high gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Level.low)
end 'main'
---
ExitCode: 41
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 41
  __il_cont:
    x64.popReg rbp
    x64.ret
}
