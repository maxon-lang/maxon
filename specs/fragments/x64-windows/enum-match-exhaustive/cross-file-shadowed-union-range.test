// Test: cross-file-shadowed-union-range
// --- file: spans.maxon
export union BigSpan
	condBr
	cmp
	call
	br
	ret
end 'BigSpan'

export union SpanOp
	condBr
	br
end 'SpanOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op SpanOp) returns Code
	return match op 'check'
		condBr or
			br gives 7
	end 'check'
end 'classify'

function describeBig(op BigSpan) returns Code
	return match op 'check'
		condBr or
			cmp or
			call or
			br or
			ret gives 3
	end 'check'
end 'describeBig'

function main() returns ExitCode
	let span = classify(SpanOp.br)
	let big = describeBig(BigSpan.call)
	if big == 3 'bigOk'
		return span
	end 'bigOk'
	return 99
end 'main'
---
ExitCode: 7
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 7
  bigOk:
    x64.popReg rbp
    x64.ret
}
