// Test: enum-exhaustive.float-backed-range
enum Threshold
		low = 0.1
		medium = 0.5
		high = 0.9
end 'Threshold'

function main() returns ExitCode
	let t = Threshold.medium
	match t 'check'
		low to high then return 1
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
