// Test: for-in-iterable.an-infallible-factory-needs-no-entry-edge
typealias Integer = int(i64.min to i64.max)

type Countdown
	var n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'

	export function current() returns Integer
		return self.n
	end 'current'

	export function advance() throws IterationError
		if self.n <= 1 'done'
			throw IterationError.exhausted
		end 'done'
		self.n = self.n - 1
	end 'advance'
end 'Countdown'

type Countable
	var start as Integer

	export static function create(start Integer) returns Self
		return Self{start: start}
	end 'create'

	export function createIterator() returns Countdown
		return Countdown.create(self.start)
	end 'createIterator'
end 'Countable'

function main() returns ExitCode
	let c = Countable.create(4)
	var sum = 0
	for v in c 'each'
		sum = sum + v
	end 'each'
	return sum
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __mrt_console_probe_stdin@32 = i8 0
  __mrt_console_probe_stdout@33 = i8 0
  __mrt_console_probe_stderr@34 = i8 0
}

func @Countdown.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 1
    x64.jcc greater, ifcont
  done:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, -1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 4
  __il_body#11:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#10:
    x64.movRegImm32 rbx, 0
  __il_body#15:
    x64.loadRegBaseDisp.word64 r13, [r12 + 0]
  __il_body#17:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], r13
  __il_cont#14:
    x64.movRegImm32 rax, 0
    x64.jmp forhdr
  __il_body#13:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
  __il_cont#12:
    x64.leaRegRegReg rbx, rbx, rax
  forstep:
    x64.movRegReg rcx, r14
    x64.callDirect Countdown.advance
    x64.movRegReg rax, r10
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#13
  forexit:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
  forjoin:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at for-in-iterable.an-infallible-factory-needs-no-entry-edge.test:41: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
