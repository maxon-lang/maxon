// Test: no-leak.string-scope
function make_string()
	let s = "this string is long enough to require heap allocation for sure and even more text"
	print(s)
end 'make_string'

function main() returns ExitCode
	make_string()
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body#2:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "this string is long enough to require heap allocation for sure and even more text"
  __il_body#4:
    x64.callDirect __write_stdout
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
