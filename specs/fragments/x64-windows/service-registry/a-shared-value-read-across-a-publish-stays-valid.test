// Test: a-shared-value-read-across-a-publish-stays-valid
type Snapshot
	export let n as Integer
	export let label as String

	static function create(n Integer, label String) returns Self
		return Self{n: n, label: label}
	end 'create'
end 'Snapshot'

typealias SnapshotCell = SharedValue with Snapshot

function main() returns ExitCode
	let cell = SnapshotCell.create(Snapshot.create(3, label: "the first snapshot, long enough to be a heap string"))
	let held = cell.current()
	cell.publish(Snapshot.create(4, label: "the second snapshot, long enough to be a heap string"))
	cell.publish(Snapshot.create(5, label: "the third snapshot, long enough to be a heap string"))

	if cell.current().n != 5 'latest'
		return 1
	end 'latest'

	print("{held.label}\n")
	return held.n as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_console_probe_stdin@24 = i8 0
  __mrt_console_probe_stdout@25 = i8 0
  __mrt_console_probe_stderr@26 = i8 0
}

func @Snapshot.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rbx, 3
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; "the first snapshot, long enough to be a heap string"
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect Snapshot.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __share_Snapshot
    x64.movRegReg rcx, r8
    x64.callDirect __mm_walk_settle
    x64.leaRegFunc rdx, [rip + __destruct_Snapshot]
    x64.leaRegFunc rax, [rip + __mm_retain]
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_box_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_current
    x64.movRegReg r12, r8
    x64.storeSlotReg slot1, r12
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "the second snapshot, long enough to be a heap string"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegImm32 rcx, r14, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r14
    x64.loadRegSlot rdx, slot4
    x64.storeBaseDispReg.word64 [rdx + 0], r15
    x64.storeBaseDispReg.word64 [rdx + 8], r14
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rdx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rdx + 24], rax
    x64.movRegImm32 rcx, 4
    x64.callDirect Snapshot.create
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __share_Snapshot
    x64.movRegReg rcx, r8
    x64.callDirect __mm_walk_settle
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __shv_publish
    x64.leaRegRdata rax, [rip + __str_rec_6]  ; "the third snapshot, long enough to be a heap string"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegImm32 rcx, r14, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot5, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r14
    x64.loadRegSlot rdx, slot5
    x64.storeBaseDispReg.word64 [rdx + 0], r15
    x64.storeBaseDispReg.word64 [rdx + 8], r14
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rdx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rdx + 24], rax
    x64.movRegImm32 rcx, 5
    x64.callDirect Snapshot.create
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __share_Snapshot
    x64.movRegReg rcx, r8
    x64.callDirect __mm_walk_settle
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __shv_publish
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_current
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 5
    x64.setccReg notEqual, r13
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Snapshot
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, ifcont
  latest:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Snapshot
    x64.movRegReg rcx, rbx
    x64.callDirect __shv_box_drop
    x64.movRegReg r8, r13
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRdata rax, [rip + __str_rec_7]  ; "\x0a"
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, r12, r14
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot2
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
  __il_body:
    x64.loadRegSlot rcx, slot3
    x64.callDirect __write_stdout
  __il_cont:
    x64.loadRegSlot rcx, slot3
    x64.callDirect __str_decref
    x64.loadRegSlot rax, slot1
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.loadRegSlot rcx, slot1
    x64.callDirect __destruct_Snapshot
    x64.loadRegSlot rcx, slot0
    x64.callDirect __shv_box_drop
    x64.movRegReg r8, rbx
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_9]  ; "panic at a-shared-value-read-across-a-publish-stays-valid.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
