// Test: bool-vector-overwrite-clear
typealias Bits8 = Vector with 8 bool

function main() returns ExitCode
	var v = Bits8.create()
	try v.set(2, value: true) otherwise panic("test invariant: set OOB")
	try v.set(5, value: true) otherwise panic("test invariant: set OOB")
	try v.set(2, value: false) otherwise panic("test invariant: set OOB")
	let a = try v.get(2) otherwise true
	let b = try v.get(5) otherwise false
	var r = 0
	if not a 'cleared'
		r = r + 1
	end 'cleared'
	if b 'stillSet'
		r = r + 10
	end 'stillSet'
	return r
end 'main'
---
ExitCode: 11
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rbx, 8
  __il_body:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
  __il_cont:
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, r12
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
  tryok#1:
    x64.movRegImm32 rdx, 5
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, r12
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
  tryok#3:
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, r12
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
  tryok#5:
    x64.movRegImm32 rdx, 2
    x64.leaRegRdata rax, [rip + __layout_Vector_N8_bool]
    x64.movRegReg rcx, r12
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#7
  tryerr#8:
    x64.movRegImm32 rbx, 1
    x64.jmp trycont#9
  tryok#7:
    x64.movRegReg rbx, r8
  trycont#9:
    x64.movRegImm32 rdx, 5
    x64.leaRegRdata rax, [rip + __layout_Vector_N8_bool]
    x64.movRegReg rcx, r12
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
