// Test: distinct-capacities-are-distinct-instances
typealias Int = int(i64.min to i64.max)

type Holder4 uses Element
	typealias Slot4 = Vector with 4 Element

	var quad as Slot4

	static function create() returns Self
		return Self{quad: Slot4.create()}
	end 'create'

	function size() returns Int
		return quad.count()
	end 'size'
end 'Holder4'

type Holder7 uses Element
	typealias Slot7 = Vector with 7 Element

	var septet as Slot7

	static function create() returns Self
		return Self{septet: Slot7.create()}
	end 'create'

	function size() returns Int
		return septet.count()
	end 'size'
end 'Holder7'

typealias IntHolder4 = Holder4 with Int
typealias IntHolder7 = Holder7 with Int

function main() returns ExitCode
	var a = IntHolder4.create()
	var b = IntHolder7.create()
	return a.size() * 10 + b.size()
end 'main'
---
ExitCode: 47
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Holder4_Int]
  __il_body#8:
    x64.movRegImm32 rdx, 4
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
  __il_cont#7:
    x64.leaRegRdata rcx, [rip + __layout_Holder7_Int]
  __il_body#9:
    x64.movRegImm32 rdx, 7
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
  __il_cont#12:
    x64.movRegImm32 rax, 4
  __il_cont#5:
    x64.imulRegRegImm32 rax, rax, 10
  __il_body#11:
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
  __il_cont#4:
    x64.leaRegRegImm32 rbx, rax, 7
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Holder7_Int
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder4_Int
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
