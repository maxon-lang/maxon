// Test: the-slice-a-member-returns-is-served
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

extension Vector
	function part() returns ElementMemory
		return try managed.slice(0, 2) otherwise panic("slice")
	end 'part'
end 'Vector'

function main() returns ExitCode
	var v = Vec3.create()
	var got = v.part()
	got.clear()
	return ((got.length() as Int) + (10 * (v.count() as Int))) as ExitCode
end 'main'
---
ExitCode: 30
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __slab_arena_list@40 = i64 0
  __slab_arena_map_l1@48 = i64 0
  __slab_state@56 = i64 0
  __ds_base@64 = i64 0
  __dbg_ctl@72 = i64 0
  __mrt_console_probe_stdin@80 = i8 0
  __mrt_console_probe_stdout@81 = i8 0
  __mrt_console_probe_stderr@82 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __layout_Vector_N3_Int]
    x64.movRegImm32 rbx, 3
  __il_body#7:
    x64.movRegImm32 rcx, 8
    x64.loadRegBaseDisp.word64 rdx, [rax + 40]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
  __il_cont#6:
    x64.leaRegRdata r9, [rip + __layout_Vector_N3_Int]
  __il_body#8:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_slice_opaque
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
  __il_cont#5:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_clear
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.movRegImm32 rcx, 3
  __il_cont#4:
    x64.imulRegRegImm32 rcx, rcx, 10
    x64.leaRegRegReg r13, rax, rcx
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at the-slice-a-member-returns-is-served.test:7: slice\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at the-slice-a-member-returns-is-served.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
