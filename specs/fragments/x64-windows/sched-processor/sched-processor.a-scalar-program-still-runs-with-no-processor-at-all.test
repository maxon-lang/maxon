// Test: sched-processor.a-scalar-program-still-runs-with-no-processor-at-all
function twice(n Integer) returns Integer
	return n * 2
end 'twice'

function main() returns ExitCode
	return twice(21) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
data {
  __mrt_console_probe_stdin@0 = i8 0
  __mrt_console_probe_stdout@1 = i8 0
  __mrt_console_probe_stderr@2 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
