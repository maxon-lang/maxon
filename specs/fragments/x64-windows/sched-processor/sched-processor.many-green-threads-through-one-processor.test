    x64.movRegImm32 r13, 0
    x64.jmp forhdr#5
  await:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r14, [rax + r13*8 + 0]
  __im_cont:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_vacate
    x64.movRegReg rcx, r14
    x64.callDirect __gt_await
    x64.leaRegRegReg r12, r12, r8
  forstep#7:
    x64.leaRegRegImm32 r13, r13, 1
  forhdr#5:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc less, await
  forexit#8:
    x64.cmpRegImm32 r12, 1488
    x64.jcc notEqual, ifcont
  expected:
    x64.movRegImm32 r12, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
