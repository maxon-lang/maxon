// Test: float-backed-negative
enum FloatSigned
	below = -2.2
	zero = 0.0
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	let result = match f 'check'
		below gives 2
		zero gives 0
		above gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 2
---
data {
  __sched_tls_teb_offset@0 = i64 0
  __sched_allm@8 = i64 0
  __sched_lock@16 = i64 0
  __sched_preempt_ext_lock@24 = i64 0
  __sched_preempt_context@32 = i64 0
  __ds_base@40 = i64 0
  __dbg_ctl@48 = i64 0
  __mrt_console_probe_stdin@56 = i8 0
  __mrt_console_probe_stdout@57 = i8 0
  __mrt_console_probe_stderr@58 = i8 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
