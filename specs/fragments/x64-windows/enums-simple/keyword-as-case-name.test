// Test: keyword-as-case-name
enum TokenType
	function
	return
	end
	if
	else
	let
	var
	identifier
end 'TokenType'

function main() returns ExitCode
	let t = TokenType.function
	let result = match t 'check'
		function gives 1
		return gives 0
		end gives 0
		if gives 0
		else gives 0
		let gives 0
		var gives 0
		identifier gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5, [5]=matcharm#6, [6]=matcharm#7, [7]=matcharm#8] @__jumptable_1
  matchdead:
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm#4:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm#5:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm#6:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm#7:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm#8:
    x64.movRegImm32 r8, 0
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at keyword-as-case-name.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
