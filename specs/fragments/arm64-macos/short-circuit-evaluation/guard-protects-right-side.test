// Test: guard-protects-right-side
typealias Index = int(0 to u64.max)

function main() returns ExitCode
	let arr = [10 as Index, 20 as Index, 30 as Index]
	let i = 5 as Index

	if i < arr.count() and (try arr.get(i) otherwise 0 as Index) > 0 'check'
		return 1
	end 'check'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 3
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x1, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.movImm x1, 8
    arm64.storeBaseDispReg.word64 [x0 + 24], x1
    arm64.movImm x1, 5
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 5
    arm64.movImm x2, 0
    arm64.b.le critsplit
  andrhs:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 5
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x1, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x1, x1, 40
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont:
    arm64.cmp x1, 0
    arm64.cset x1, hi
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x1, x2
  scmerge:
    arm64.cbz x1, ifcont
  check:
    arm64.movImm x19, 1
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 42
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}
