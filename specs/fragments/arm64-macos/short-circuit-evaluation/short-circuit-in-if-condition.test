// Test: short-circuit-in-if-condition
typealias Integer = int(0 to u64.max)

var trace = 0 as Integer

function setFlag(bit Integer) returns bool
	trace = trace or bit
	return false
end 'setFlag'

function main() returns ExitCode
	if setFlag(1) and setFlag(2) 'never'
		return 99
	end 'never'
	return trace as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __data_trace@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok#10:
    arm64.leaGlobal x0, __data_trace
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.orr x0, x0, 1
    arm64.leaGlobal x1, __data_trace
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  ifcont:
    arm64.leaGlobal x0, __data_trace
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok#5:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at short-circuit-in-if-condition.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
