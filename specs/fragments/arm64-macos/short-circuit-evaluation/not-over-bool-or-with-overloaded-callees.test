  __il_body#21:
    arm64.loadRegBaseDisp.word64 x3, [x1 + 0]
    arm64.cmp x3, 1
    arm64.cset x3, eq
  __il_cont#20:
    arm64.movImm x4, 1
    arm64.cbnz x3, scmerge#6
  __il_body#23:
    arm64.loadRegBaseDisp.word64 x3, [x2 + 0]
    arm64.cmp x3, 1
    arm64.cset x3, eq
  __il_cont#22:
    arm64.movRegReg x4, x3
  scmerge#6:
    arm64.eor x3, x4, 1
    arm64.cbz x3, __il_body#25
  c:
    arm64.add x0, x0, 10
