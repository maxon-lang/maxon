  __il_cont#17:
    arm64.movImm x19, 9
  __il_body#19:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_cont#16:
    arm64.movImm x1, 0
  __il_body#31:
    arm64.loadRegBaseDisp.word64 x2, [x20 + 0]
    arm64.cmp x2, 5
    arm64.cset x2, eq
  __il_cont#30:
    arm64.movImm x3, 1
    arm64.cbnz x2, scmerge#2
  __il_body#21:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.cmp x2, 1
    arm64.cset x2, eq
  __il_cont#20:
    arm64.movRegReg x3, x2
  scmerge#2:
    arm64.eor x2, x3, 1
    arm64.cbz x2, __il_body#23
  a:
    arm64.add x1, x1, 1
  __il_body#23:
    arm64.loadRegBaseDisp.word64 x2, [x20 + 0]
    arm64.cmp x2, 1
    arm64.cset x2, eq
  __il_cont#22:
    arm64.movImm x3, 1
    arm64.cbnz x2, scmerge#6
  __il_body#25:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.cmp x2, 1
    arm64.cset x2, eq
  __il_cont#24:
    arm64.movRegReg x3, x2
  scmerge#6:
    arm64.eor x2, x3, 1
    arm64.cbz x2, __il_body#27
  c:
    arm64.add x1, x1, 10
  __il_body#27:
