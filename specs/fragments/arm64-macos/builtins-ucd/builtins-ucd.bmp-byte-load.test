// Test: builtins-ucd.bmp-byte-load
function main() returns ExitCode
	var score = 0
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 65) == 1 'upper'
		score = score + 1
	end 'upper'
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 122) == 2 'lower'
		score = score + 1
	end 'lower'
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 53) == 9 'digit'
		score = score + 1
	end 'digit'
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 32) == 23 'space'
		score = score + 1
	end 'space'
	return score as ExitCode
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 65
    arm64.bl __ucd_bmp_at
    arm64.cmp x0, 1
    arm64.b.ne ifcont#2
  upper:
    arm64.movImm x19, 1
  ifcont#2:
    arm64.movImm x0, 122
    arm64.bl __ucd_bmp_at
    arm64.cmp x0, 2
    arm64.b.ne ifcont#4
  lower:
    arm64.add x19, x19, 1
  ifcont#4:
    arm64.movImm x0, 53
    arm64.bl __ucd_bmp_at
    arm64.cmp x0, 9
    arm64.b.ne ifcont#6
  digit:
    arm64.add x19, x19, 1
  ifcont#6:
    arm64.movImm x0, 32
    arm64.bl __ucd_bmp_at
    arm64.cmp x0, 23
    arm64.b.ne critsplit
  space:
    arm64.add x0, x19, 1
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x19
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
