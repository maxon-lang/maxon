// Test: qualified-call
function main() returns ExitCode
	return trunc(Math.pow(2.0, exponent: 4.0))
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_2]
    arm64.fpLoadRdata d1, [rdata + __fconst_4]
    arm64.bl Math.pow
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at qualified-call.test:3: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
