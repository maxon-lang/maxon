// Test: over-budget-digits-round-through-the-sticky-bit
function main() returns ExitCode
	var r = 0
	if 9007199254740993. == 9007199254740992.0 'tieRoundsToEven'
		r = r + 1
	end 'tieRoundsToEven'
	if 9007199254740993. == 9007199254740994.0 'stickyBitRoundsUp'
		r = r + 2
	end 'stickyBitRoundsUp'
	return r
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
  tieRoundsToEven:
    arm64.movImm x0, 1
  stickyBitRoundsUp:
    arm64.add x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
