// Test: subnormals
function main() returns ExitCode
	var r = 0
	if 1.0e-310 > 0.0 'e310IsPositive'
		r = r + 1
	end 'e310IsPositive'
	if 1.0e-320 > 0.0 'e320IsPositive'
		r = r + 2
	end 'e320IsPositive'
	if 1.0e-310 > 1.0e-320 'ordered'
		r = r + 4
	end 'ordered'
	return r
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  e310IsPositive:
    arm64.movImm x0, 1
  e320IsPositive:
    arm64.add x0, x0, 2
  ordered:
    arm64.add x0, x0, 4
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
