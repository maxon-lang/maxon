// Test: process-id.fits-in-a-dword
function main() returns ExitCode
	let pid = __Builtins.currentProcessId()
	let dwordLimit = 4294967296
	var score = 0
	if pid > 0 'aboveZero'
		score = score + 1
	end 'aboveZero'
	if pid < dwordLimit 'belowTheDwordCeiling'
		score = score + 2
	end 'belowTheDwordCeiling'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.bl __proc_pid
    arm64.movImm x1, 4294967296
    arm64.movImm x2, 0
    arm64.cmp x0, 0
    arm64.b.le ifcont
  aboveZero:
    arm64.movImm x2, 1
  ifcont:
    arm64.cmp x0, x1
    arm64.b.ge critsplit
  belowTheDwordCeiling:
    arm64.add x0, x2, 2
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
