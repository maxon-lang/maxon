    arm64.add x1, x1, 1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#18
  __rc_chk#19:
    arm64.cmp x1, 1000
    arm64.b.gt __rc_panic#18
  __rc_ok#17:
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
  __il_cont:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic#2
  __rc_ok#1:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
