    arm64.epilogue 32
    arm64.ret
  __rc_panic#12:
    arm64.leaRdata x0, __str_blob_1  ; "panic at let-to-callee-calling-a-self-writing-method-ok.test:12: Range check failed: value outside typealias 'Tally'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic#18:
    arm64.leaRdata x0, __str_blob_1  ; "panic at let-to-callee-calling-a-self-writing-method-ok.test:12: Range check failed: value outside typealias 'Tally'\x0a"
    arm64.bl mrt_panic
