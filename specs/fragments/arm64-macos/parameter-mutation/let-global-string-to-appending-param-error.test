// Test: let-global-string-to-appending-param-error
typealias Integer = int(i64.min to i64.max)

let GREETING = "hi"

function grow(s String) returns Integer
	s.append("XY")
	return s.byteLength()
end 'grow'

function main() returns ExitCode
	return grow(GREETING) as ExitCode
end 'main'
