// Test: returned-alias-written-in-the-callee
function pass(s String) returns String
	return s
end 'pass'

function tag(p String)
	var x = pass(p)
	x.append(" TAGGED")
end 'tag'

function main() returns ExitCode
	let n = 7
	let a = "lit{n}"
	tag(a)
	print("{a}\n")
	return 0
end 'main'
---
CompilerError:
error E3019: <fragment>:14:2: cannot pass 'a' to function that mutates parameter 'p' (in main)
