// Test: stdlib-user-shadows.user-union-shadows-a-listed-module
union CursorError
	mine
	yours
end 'CursorError'

function main() returns ExitCode
	let e = CursorError.mine
	return match e 'which'
		mine gives 6
		yours gives 1
	end 'which'
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 6
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
