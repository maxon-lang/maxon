// Test: a-mixed-expression-is-guarded-as-an-assigned-field
typealias Small = int(0 to 10)
typealias BlockId = int(0 to 10) implements Small
typealias VarId = int(0 to 10) implements Small

type Holder
	export var block as BlockId

	static function create() returns Self
		return Self{block: 1}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let block = 8 as BlockId
	let varId = 5 as VarId
	var h = Holder.create()
	h.block = block + varId
	print("{h.block}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x19, 1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-mixed-expression-is-guarded-as-an-assigned-field.test:18: Range check failed: value outside typealias 'BlockId'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
