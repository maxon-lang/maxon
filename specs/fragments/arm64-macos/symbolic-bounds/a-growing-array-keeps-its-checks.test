// Test: a-growing-array-keeps-its-checks
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function growAndSum(a WordArray) returns Word
	var t = 0
	for i in 0 upto a.count() 'each'
		a.push(i)
		t = t + (try a.get(i) otherwise 1000)
	end 'each'
	return t
end 'growAndSum'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 4 'seed'
		a.push(i + 10)
	end 'seed'
	if growAndSum(a) != 46 'sum'
		return 1
	end 'sum'
	if a.count() != 8 'count'
		return 2
	end 'count'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @growAndSum {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.loadRegBaseDisp.word64 x22, [x19 + 8]
  forhdr:
    arm64.cmp x21, x22
    arm64.b.ge forexit
  each:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x0, 1000
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x21*8 + 0]
  trycont:
    arm64.add x20, x20, x0
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 4
    arm64.b.ge forexit
  seed:
    arm64.add x1, x20, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x19
    arm64.bl growAndSum
    arm64.cmp x0, 46
    arm64.b.eq ifcont#6
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#6:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 8
    arm64.b.eq ifcont#8
  count:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#8:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
