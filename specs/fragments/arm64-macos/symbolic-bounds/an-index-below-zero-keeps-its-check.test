// Test: an-index-below-zero-keeps-its-check
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function lastOr(a WordArray, fallback Word) returns Word
	let last = a.count() - 1
	return try a.get(last) otherwise fallback
end 'lastOr'

function main() returns ExitCode
	var empty = WordArray.create()
	if lastOr(empty, fallback: 7) != 7 'emptyFallsBack'
		return 1
	end 'emptyFallsBack'
	var a = WordArray.create()
	a.push(3)
	a.push(8)
	if lastOr(a, fallback: 7) != 8 'lastElement'
		return 2
	end 'lastElement'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @lastOr {
  entry:
    arm64.prologue 32
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.sub x2, x2, 1
    arm64.cmp x2, 0
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.cmp x2, x3
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movRegReg x0, x1
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x2*8 + 0]
  trycont:
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-index-below-zero-keeps-its-check.test:7: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.loadRegSlot x1, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 7
    arm64.movRegReg x0, x19
    arm64.bl lastOr
    arm64.cmp x0, 7
    arm64.b.eq ifcont#2
  emptyFallsBack:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 8
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 7
    arm64.movRegReg x0, x20
    arm64.bl lastOr
    arm64.cmp x0, 8
    arm64.b.eq ifcont#4
  lastElement:
    arm64.movImm x21, 2
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#4:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
