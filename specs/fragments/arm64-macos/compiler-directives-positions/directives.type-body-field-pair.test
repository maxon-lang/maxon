// Test: directives.type-body-field-pair
type Box
	#if testing(false)
		export let first as ExitCode
	#else
		export let unwanted as ExitCode
	#endif
	export let second as ExitCode

	static function create(second ExitCode) returns Box
		return Box{first: 2, second: second}
	end 'create'
end 'Box'

function main() returns ExitCode
	let b = Box.create(32)
	return b.second
end 'main'
---
ExitCode: 32
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 8194
  __il_cont:
    arm64.lsr x0, x0, 8
    arm64.and x0, x0, 255
    arm64.epilogue 16
    arm64.ret
}
