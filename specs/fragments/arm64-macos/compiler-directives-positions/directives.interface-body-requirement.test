// Test: directives.interface-body-requirement
interface Shape
	function area() returns ExitCode
	#if testing(false)
		function perimeter() returns ExitCode
	#endif
end 'Shape'

type Square implements Shape
	export let side as ExitCode

	export static function create(side ExitCode) returns Square
		return Square{side: side}
	end 'create'

	export function area() returns ExitCode
		return side
	end 'area'

	export function perimeter() returns ExitCode
		return 29
	end 'perimeter'
end 'Square'

function main() returns ExitCode
	let s = Square.create(4)
	return s.perimeter()
end 'main'
---
ExitCode: 29
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 4
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body:
    arm64.movImm x19, 29
  __il_cont:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
