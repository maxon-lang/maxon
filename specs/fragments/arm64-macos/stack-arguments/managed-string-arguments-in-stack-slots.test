// Test: managed-string-arguments-in-stack-slots
typealias ByteTotal = int(0 to 100000)

function joinLengths(a String, b String, c String, d String, e String, f String, g String, h String) returns ByteTotal
	return a.byteLength() + b.byteLength() + c.byteLength() + d.byteLength() + e.byteLength() + f.byteLength() + g.byteLength() + h.byteLength()
end 'joinLengths'

function main() returns ExitCode
	return joinLengths("a string long enough to be heap allocated, one", b: "bb", c: "ccc", d: "dddd", e: "eeeee", f: "ffffff", g: "another heap allocated string, seven", h: "hhhhhhhhhhhhhhhhhhhhhhhhh")
end 'main'
---
ExitCode: 127
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_8  ; "a string long enough to be heap allocated, one"
    arm64.leaRdata x1, __str_rec_9  ; "bb"
    arm64.leaRdata x2, __str_rec_10  ; "ccc"
    arm64.leaRdata x3, __str_rec_11  ; "dddd"
    arm64.leaRdata x4, __str_rec_12  ; "eeeee"
    arm64.leaRdata x5, __str_rec_13  ; "ffffff"
    arm64.leaRdata x6, __str_rec_14  ; "another heap allocated string, seven"
    arm64.leaRdata x7, __str_rec_15  ; "hhhhhhhhhhhhhhhhhhhhhhhhh"
  __il_body#17:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __il_body#18:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
  __il_cont#15:
    arm64.add x0, x0, x1
  __il_body#19:
    arm64.loadRegBaseDisp.word64 x1, [x2 + 8]
  __il_cont#14:
    arm64.add x0, x0, x1
  __il_body#20:
    arm64.loadRegBaseDisp.word64 x1, [x3 + 8]
  __il_cont#13:
    arm64.add x0, x0, x1
  __il_body#21:
    arm64.loadRegBaseDisp.word64 x1, [x4 + 8]
  __il_cont#12:
    arm64.add x0, x0, x1
  __il_body#22:
    arm64.loadRegBaseDisp.word64 x1, [x5 + 8]
  __il_cont#11:
    arm64.add x0, x0, x1
  __il_body#23:
    arm64.loadRegBaseDisp.word64 x1, [x6 + 8]
  __il_cont#10:
    arm64.add x0, x0, x1
  __il_body#24:
    arm64.loadRegBaseDisp.word64 x1, [x7 + 8]
  __il_cont#9:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#7
  __rc_chk#8:
    arm64.movImm x16, 100000
    arm64.cmp x0, x16
    arm64.b.gt __rc_panic#7
  __rc_chk#3:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_17  ; "panic at managed-string-arguments-in-stack-slots.test:5: Range check failed: value outside typealias 'ByteTotal'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_18  ; "panic at managed-string-arguments-in-stack-slots.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
