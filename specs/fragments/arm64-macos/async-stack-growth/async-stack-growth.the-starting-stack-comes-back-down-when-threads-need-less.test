func @down {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne ifcont
  bottom:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x0, x0, 1
    arm64.bl down
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @seedBytes {
  entry:
    arm64.prologue 16
    arm64.bl Runtime.yield
    arm64.bl __sched_gt_stack_bytes
    arm64.epilogue 16
    arm64.ret
}

func @deep {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl Runtime.yield
    arm64.movRegReg x0, x19
    arm64.bl down
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @shallow {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl Runtime.yield
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

