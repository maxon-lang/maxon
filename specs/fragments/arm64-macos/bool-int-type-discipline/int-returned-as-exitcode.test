// Test: int-returned-as-exitcode
typealias Integer = int(i64.min to i64.max)

function double(n Integer) returns Integer
	return n * 2
end 'double'

function main() returns ExitCode
	return double(21)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
