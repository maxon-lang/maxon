// Test: a-vector-in-an-extension-body-over-an-associated-type
typealias Int = int(i64.min to i64.max)

interface Sized uses Element
	typealias Slot = Vector with 4 Element
	function tally() returns Int
end 'Sized'

extension Sized
	export function tallyTwice() returns Int
		var v = Slot.create()
		return (v.count() as Int) + tally()
	end 'tallyTwice'
end 'Sized'

type Bag uses Element implements Sized with Element
	typealias Slot = Vector with 4 Element
	var n as Int

	export static function create() returns Self
		return Self{n: 1}
	end 'create'

	export function tally() returns Int
		return n
	end 'tally'
end 'Bag'

typealias IntBag = Bag with Int

function main() returns ExitCode
	var b = IntBag.create()
	return b.tallyTwice()
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#5:
    arm64.movImm x19, 1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#4:
    arm64.leaRdata x0, __layout_Bag_Int
  __il_body#7:
    arm64.movImm x19, 4
  __il_body#11:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __managed_resize
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
  __il_cont#8:
    arm64.add x19, x0, 4
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
  __il_cont#6:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-vector-in-an-extension-body-over-an-associated-type.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
