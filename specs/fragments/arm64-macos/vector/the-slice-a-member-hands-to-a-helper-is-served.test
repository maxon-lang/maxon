// Test: the-slice-a-member-hands-to-a-helper-is-served
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

extension Vector
	export function sliceThenClear() returns Int
		var s = try managed.slice(0, 2) otherwise panic("slice")
		return wipe(s) + (10 * (managed.length() as Int))
	end 'sliceThenClear'

	function wipe(m ElementMemory) returns Int
		m.clear()
		return m.length() as Int
	end 'wipe'
end 'Vector'

function main() returns ExitCode
	var v = Vec3.create()
	return v.sliceThenClear() as ExitCode
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x19, 3
  __il_body#5:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_resize
  __il_cont#4:
    arm64.leaRdata x3, __layout_Vector_N3_Int
  __il_body#7:
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.movRegReg x0, x20
    arm64.bl __managed_slice_opaque
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  __il_body#11:
    arm64.movRegReg x0, x19
    arm64.bl __managed_clear
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
  __il_cont#10:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.movImm x16, 10
    arm64.mul x1, x1, x16
    arm64.add x21, x0, x1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __il_cont#6:
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at the-slice-a-member-hands-to-a-helper-is-served.test:7: slice\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at the-slice-a-member-hands-to-a-helper-is-served.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
