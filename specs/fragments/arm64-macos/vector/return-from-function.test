    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 30
    arm64.movImm x20, 12
  __il_body#11:
    arm64.leaRdata x0, __layout_Vector_N2_Integer
    arm64.movImm x21, 2
  __il_body#17:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x21
    arm64.bl __managed_resize
  __il_cont#16:
    arm64.movImm x1, 0
    arm64.leaRdata x3, __layout_Vector_N2_Integer
    arm64.movImm x4, 2
    arm64.movRegReg x0, x22
    arm64.movRegReg x2, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.ne tryerr#13
  tryok#12:
    arm64.movImm x1, 1
    arm64.leaRdata x3, __layout_Vector_N2_Integer
    arm64.movImm x4, 2
    arm64.movRegReg x0, x22
    arm64.movRegReg x2, x20
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.ne tryerr#15
  __il_cont#10:
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_Vector_N2_Integer
    arm64.movRegReg x0, x22
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x19, 0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x19, x0
  trycont#3:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Vector_N2_Integer
    arm64.movRegReg x0, x22
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 0
  trycont#6:
    arm64.add x19, x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
