func @slowProc {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "sleep 2"
    arm64.bl __gt_process_run
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 99
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @fast {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.bl __gt_resched
  __il_cont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, slowProc
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.leaFuncAddr x0, fast
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movRegReg x0, x20
    arm64.bl __gt_await
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_is_complete
    arm64.add x20, x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __gt_promise_drop
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at async-promise-drop.posix-parked-subprocess-drop-cancel.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
