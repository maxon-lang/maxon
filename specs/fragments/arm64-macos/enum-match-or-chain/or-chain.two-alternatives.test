// Test: or-chain.two-alternatives
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.mul
	let result = match op 'check'
		add or
			sub gives 1
		mul gives 2
		exec(code) gives code
	end 'check'
	return result
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.cmp x0, 0
    arm64.cset x2, ge
    arm64.cmp x0, 1
    arm64.cset x3, le
    arm64.and x2, x2, x3
    arm64.cbz x2, matchnext#5
  matcharm#1:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x0, 2
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 3
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movRegReg x0, x1
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at or-chain.two-alternatives.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
