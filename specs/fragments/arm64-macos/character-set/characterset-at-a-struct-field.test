// Test: characterset-at-a-struct-field
type Trimmer
	var chars as CharacterSet

	export static function init(cs CharacterSet) returns Self
		return Self{chars: cs}
	end 'init'
end 'Trimmer'

function main() returns ExitCode
	_ = Trimmer.init(CharacterSet.whitespaces())
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespaces@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#3:
    arm64.leaGlobal x0, __data_CharacterSet.cachedWhitespaces
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaFuncAddr x1, __clone_CharacterSet
    arm64.bl __mm_own_deep
    arm64.movRegReg x19, x0
  __il_body#4:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaFuncAddr x1, __clone_CharacterSet
    arm64.movRegReg x0, x19
    arm64.bl __mm_own_deep
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_CharacterSet
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Trimmer
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
