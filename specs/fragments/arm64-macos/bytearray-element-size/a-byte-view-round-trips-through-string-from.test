    arm64.add x23, x23, 1
  forhdr:
    arm64.cmp x23, x22
    arm64.b.lt scan
  forexit:
    arm64.movImm x1, 1
  __il_cont#11:
    arm64.movRegReg x0, x19
    arm64.bl __str_of_buffer
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __il_body#2:
