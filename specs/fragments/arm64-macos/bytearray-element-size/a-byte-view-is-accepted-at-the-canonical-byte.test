// Test: a-byte-view-is-accepted-at-the-canonical-byte
typealias Byte = int(0 to u8.max)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	return (try b.get(0) otherwise 0)
end 'takes'

function main() returns ExitCode
	return takes("abc".toByteArray() as Bytes)
end 'main'
---
ExitCode: 97
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1  ; "abc"
  __il_body#15:
    arm64.movImm x1, 0
  __il_body#19:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
  __il_cont#18:
    arm64.bl __managed_slice
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#16
  tryerr#17:
    arm64.leaRdata x0, __str_blob_2  ; "panic at String.maxon:157: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#16:
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __il_body#2:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b tryok#3
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load#13:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b tryok#3
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.movImm x19, 0
    arm64.b __il_cont#1
  tryok#3:
    arm64.movRegReg x19, x0
  __il_cont#1:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
