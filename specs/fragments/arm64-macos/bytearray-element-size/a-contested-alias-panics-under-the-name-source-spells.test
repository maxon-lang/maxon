// Test: a-contested-alias-panics-under-the-name-source-spells
typealias Byte = int(0 to 1000)
typealias Bytes = Array with Byte

function feed(v Integer) returns Integer
	var made = Bytes.create()
	made.push(v)
	return try made.get(0) otherwise 0
end 'feed'

function main() returns ExitCode
	return feed(2000) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-contested-alias-panics-under-the-name-source-spells.test:7: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
