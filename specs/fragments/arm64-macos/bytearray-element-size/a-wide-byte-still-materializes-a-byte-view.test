// Test: a-wide-byte-still-materializes-a-byte-view
typealias Byte = int(0 to 1000)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	let first = try b.get(0) otherwise 0
	let second = try b.get(1) otherwise 0
	return 0 if b.count() == 2 and first == 195 and second == 159 else 1
end 'takes'

function main() returns ExitCode
	let c = 'ß'
	return takes(c.bytes())
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "\xc3\x9f"
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __str_to_bytes
  __il_body:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#4:
    arm64.movImm x19, 0
    arm64.b trycont#5
  tryok:
    arm64.movRegReg x19, x0
  trycont#5:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq trycont#8
  tryerr#7:
    arm64.movImm x0, 0
  trycont#8:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.cmp x1, 2
    arm64.movImm x1, 0
    arm64.b.ne scmerge#10
  andrhs#9:
    arm64.cmp x19, 195
    arm64.cset x1, eq
  scmerge#10:
    arm64.movImm x2, 0
    arm64.cbz x1, critsplit
  andrhs#11:
    arm64.cmp x0, 159
    arm64.cset x0, eq
    arm64.b scmerge#12
  critsplit:
    arm64.movRegReg x0, x2
  scmerge#12:
    arm64.cbz x0, ternaryfalse
  ternarytrue:
    arm64.movImm x19, 0
    arm64.b __il_cont
  ternaryfalse:
    arm64.movImm x19, 1
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
