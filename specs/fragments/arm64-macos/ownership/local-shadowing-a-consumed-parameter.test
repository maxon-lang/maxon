// Test: local-shadowing-a-consumed-parameter
type Wrap
	export var v as String

	export static function make(p String) returns Wrap
		let p = "local value"
		return Wrap{v: p}
	end 'make'
end 'Wrap'

function main() returns ExitCode
	let w = Wrap.make("the argument")
	return w.v.count() as ExitCode
end 'main'
