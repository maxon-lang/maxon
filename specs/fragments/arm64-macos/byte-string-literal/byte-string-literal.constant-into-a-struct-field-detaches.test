// Test: byte-string-literal.constant-into-a-struct-field-detaches
let Keyword = b"critsplit"

type Holder
		export var b as ByteArray

		export static function create(b ByteArray) returns Self
				return Self{b: b}
		end 'create'
end 'Holder'

function main() returns ExitCode
		let h = Holder.create(Keyword)
		h.b.push(88)
		let k = try Keyword.get(0) otherwise 0
		print("{h.b.count()} {Keyword.count()} {k}")
		return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

