// Test: byte-string-literal.top-level-let
let Keyword = b"critsplit"

function takes(b ByteArray) returns ExitCode
		return 0 if b.count() == 9 else 1
end 'takes'

function main() returns ExitCode
		return takes(Keyword)
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __barr_rec_1
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 9
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ternaryfalse:
    arm64.movImm x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
