    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
  forhdr:
    arm64.cmp x1, x2
    arm64.b.ge forexit
  each:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x19, x19, x4
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at deepmove.a-reply-carries-a-container-back.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
