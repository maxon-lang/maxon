func @Calc.divide {
  entry:
    arm64.prologue 16
    arm64.cmp x2, 0
    arm64.cset x0, eq
    arm64.b.ne ifcont
  zero:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x3, 9223372036854775808
    arm64.eor x3, x1, x3
    arm64.movImm x16, 18446744073709551615
    arm64.eor x4, x2, x16
    arm64.orr x3, x3, x4
    arm64.cmp x3, 0
    arm64.b.eq divovf
  divok:
    arm64.orr x2, x2, x0
    arm64.sdiv x1, x1, x2
    arm64.cmp x0, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x1
  trycont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  divovf:
    arm64.leaRdata x0, __str_blob_0  ; "panic: integer overflow\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

