    arm64.bl Svc.start
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movImm x2, 0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x23
    arm64.bl __gt_cell_complete
    arm64.b serve
  finish:
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
  __il_body:
