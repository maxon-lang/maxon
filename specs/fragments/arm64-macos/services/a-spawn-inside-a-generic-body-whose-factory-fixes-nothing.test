    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-spawn-inside-a-generic-body-whose-factory-fixes-nothing.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
