// Test: shared-nested-struct-in-literal
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

export type Inner
		export var data as IntArray
		export var value as Integer

		static function create(data IntArray, value Integer) returns Self
			return Self{data: data, value: value}
		end 'create'
end 'Inner'

export type Outer
		export var first as Inner
		export var second as Inner
		export var deps as IntArray

		static function create(first Inner, second Inner, deps IntArray) returns Self
			return Self{first: first, second: second, deps: deps}
		end 'create'
end 'Outer'

function makeOuter() returns Outer
		let shared = Inner.create(IntArray.create(), value: 42)
		return Outer.create(shared, second: shared, deps: IntArray.create())
end 'makeOuter'

function main() returns ExitCode
		var o = makeOuter()
		o.deps.push(1)
		o.deps.push(2)
		o.deps.push(3)
		return o.deps.count()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Inner.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Outer.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x22 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x22 + 16], x21
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Inner
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Inner
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @makeOuter {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movImm x1, 42
    arm64.bl Inner.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl Outer.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Inner
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl makeOuter
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.movImm x1, 1
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.movImm x1, 2
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.movImm x1, 3
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Outer
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at shared-nested-struct-in-literal.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
