// Test: a-rebind-out-of-range-is-caught-at-the-return-door

typealias Score = int(0 to 100)

function bump(start Score) returns Score
	var s = start
	s = s + 200
	print("s={s}\n")
	return s
end 'bump'

function main() returns ExitCode
	let r = bump(0)
	print("unreachable r={r}\n")
	return 0 as ExitCode
end 'main'
