// Test: the-same-sequence-inside-a-type-method-body
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

type Holder
	export var base as Idx

	export static function create() returns Holder
		return Self{base: 20}
	end 'create'

	export function trips(m Marker, flag bool) returns Idx
		if m == Marker.function and (flag or not flag) 'both'
			return self.base
		end 'both'
		return 0
	end 'trips'
end 'Holder'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	let h = Holder.create()
	return (h.trips(Marker.function, flag: true) + pick(Victim.found(22))) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 20
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
  andrhs:
    arm64.movImm x1, 1
  scmerge:
    arm64.cbz x1, ifcont
  both:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.b __il_cont#5
  ifcont:
    arm64.movImm x19, 0
  __il_cont#5:
    arm64.movImm x20, 22
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#14:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.b __il_cont#4
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#15:
    arm64.movImm x1, 0
  __il_cont#4:
    arm64.add x19, x19, x1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at the-same-sequence-inside-a-type-method-body.test:38: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}
