// Test: a-call-on-the-field-reads-the-forwarded-block
typealias Int = int(i64.min to i64.max)

type Inner uses T
	var v as T

	export static function create(x T) returns Self
		return Self{v: x}
	end 'create'

	export function slotSize() returns Int
		return sizeof(T)
	end 'slotSize'
end 'Inner'

type Bag uses Element
	typealias EChain = Inner with Element
	var chain as EChain

	export static function create(x Element) returns Self
		return Self{chain: EChain.create(x)}
	end 'create'

	export function probe() returns Int
		return chain.slotSize()
	end 'probe'
end 'Bag'

typealias IntBag = Bag with Int

function main() returns ExitCode
	var b = IntBag.create(7)
	return b.probe()
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
    arm64.leaRdata x0, __layout_Bag_Int
  __il_body#8:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_cont#5:
    arm64.leaRdata x1, __layout_Bag_Int
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x19, [x1 + 56]
  __il_cont#4:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __destruct_Bag_Int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-call-on-the-field-reads-the-forwarded-block.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
