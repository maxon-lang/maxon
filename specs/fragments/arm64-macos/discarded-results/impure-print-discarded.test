// Test: impure-print-discarded

typealias Integer = int(i64.min to i64.max)

function computeAndPrint(x Integer) returns Integer
	print("computing")
	return x * 2
end 'computeAndPrint'

function main() returns ExitCode
	_ = computeAndPrint(5)
	return 0
end 'main'
---
ExitCode: 0
---
func @computeAndPrint {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1  ; "computing"
    arm64.bl print
    arm64.lsl x0, x19, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl computeAndPrint
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
