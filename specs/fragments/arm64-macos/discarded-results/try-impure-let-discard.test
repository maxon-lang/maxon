// Test: try-impure-let-discard

typealias Integer = int(i64.min to i64.max)

var counter = 0 as Integer

enum ParseError implements Error
	invalidFormat
end 'ParseError'

function parseNum(s String) returns Integer throws ParseError
	counter = counter + s.byteLength()
	throw ParseError.invalidFormat
end 'parseNum'

function main() returns ExitCode
	_ = try parseNum("abc") otherwise 0
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_counter@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @parseNum {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x1, __data_counter
    arm64.loadRegBaseDisp.word64 x19, [x1 + 0]
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.b.ge __rc_ok
  __il_slow:
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.add x0, x19, x0
    arm64.leaGlobal x1, __data_counter
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "abc"
    arm64.bl parseNum
    arm64.cmp x9, 0
    arm64.b.ne trycont
  trycont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
