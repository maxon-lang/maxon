// Test: a-count-whose-alias-reaches-64-keeps-the-guard
typealias Num = int(i64.min to i64.max)
typealias Word = bits(64)
typealias UpTo64 = int(0 to 64)

function shlBy(value Num, n UpTo64) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n UpTo64) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n UpTo64) returns Word
	return value shr n
end 'shrWordBy'

function widen(step Num) returns UpTo64
	return (step * 64) as UpTo64
end 'widen'

function main() returns ExitCode
	let past = widen(1)

	if shlBy(7, n: past) != 0 'shl'
		return 1
	end 'shl'
	if shrBy(-1, n: past) != -1 'shrSign'
		return 2
	end 'shrSign'
	if shrWordBy(u64.max, n: past) != 0 'shrZeroFill'
		return 3
	end 'shrZeroFill'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 64
  __il_cont#8:
    arm64.movImm x1, 7
  shiftok#15:
    arm64.lslv x1, x1, x0
    arm64.movImm x16, 0
    arm64.and x1, x1, x16
  ifcont#2:
    arm64.movImm x1, 18446744073709551615
  shiftok#22:
    arm64.movImm x2, 18446744073709551615
    arm64.asrv x1, x1, x2
  __il_cont#19:
    arm64.cmp x1, -1
    arm64.b.eq ifcont#4
  shrSign:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x1, 18446744073709551615
  shiftok#29:
    arm64.lsrv x0, x1, x0
    arm64.movImm x16, 0
    arm64.and x0, x0, x16
  ifcont#6:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
