// Test: panic.after-condition
typealias Integer = int(i64.min to i64.max)

function check(n Integer) returns Integer
		if n < 0 'negative'
				panic("negative value")
		end 'negative'
		return n
end 'check'

function main() returns ExitCode
		return check(-1)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  negative:
    arm64.leaRdata x0, __str_blob_0  ; "panic at panic.after-condition.test:6: negative value\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
