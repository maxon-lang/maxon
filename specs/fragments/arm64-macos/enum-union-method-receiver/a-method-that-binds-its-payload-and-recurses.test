// Test: a-method-that-binds-its-payload-and-recurses
typealias Integer = int(i64.min to i64.max)
typealias Depth = int(0 to 10)

union M
	silent
	text(body String)

	export function spin(d Depth) returns Integer
		return match self 'k'
			silent gives 0
			text(s) gives 1 + self.spin((d - 1) if d > 0 else 0) if d > 0 and s.byteLength() > 0 else 1
		end 'k'
	end 'spin'
end 'M'

function main() returns ExitCode
	let m = M.text("a recursively bound payload string, long enough for the heap")
	return m.spin(4) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @M.spin {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 10
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont#13
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.cmp x20, 0
    arm64.cset x0, gt
    arm64.movImm x1, 0
    arm64.b.le scmerge
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
  __il_cont:
    arm64.cmp x1, 0
    arm64.cset x1, hi
  scmerge:
    arm64.cbz x1, ternaryfalse#9
  ternarytrue#8:
    arm64.cbz x0, ternaryfalse#4
  ternarytrue#3:
    arm64.sub x1, x20, 1
    arm64.b matchcont#5
  ternaryfalse#4:
    arm64.movImm x1, 0
  matchcont#5:
    arm64.movRegReg x0, x19
    arm64.bl M.spin
    arm64.add x19, x0, 1
    arm64.b matchcont#10
  ternaryfalse#9:
    arm64.movImm x19, 1
  matchcont#10:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
  matchcont#13:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-method-that-binds-its-payload-and-recurses.test:9: Range check failed: value outside typealias 'Depth'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a recursively bound payload string, long enough for the heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x20
    arm64.bl M.spin
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at a-method-that-binds-its-payload-and-recurses.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
