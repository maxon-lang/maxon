    arm64.bl __managed_push
  __il_cont#10:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#20
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  critsplit#21:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#20:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  tryok:
    arm64.add x1, x20, x21
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x1, x1, x2
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x20, x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok#3:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __im_slow:
    arm64.movRegReg x0, x19
