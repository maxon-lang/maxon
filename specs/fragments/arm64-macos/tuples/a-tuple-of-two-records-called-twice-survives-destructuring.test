// Test: a-tuple-of-two-records-called-twice-survives-destructuring
type A
	export var n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'A'

type B
	export var m as Integer

	export static function create(m Integer) returns Self
		return Self{m: m}
	end 'create'
end 'B'

function pair(seed Integer) returns (A, B)
	let a = A.create(seed)
	let b = B.create(seed + 2)
	return (a, b)
end 'pair'

function main() returns ExitCode
	let (x, y) = pair(10)
	let (p, q) = pair(9)
	return (x.n + y.m + p.n + q.m) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pair {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
  __il_body#3:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#2:
    arm64.add x19, x19, 2
  __il_body#4:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
  __il_cont#1:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_own
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 10
    arm64.bl pair
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.movImm x0, 9
    arm64.bl pair
    arm64.movRegReg x22, x0
    arm64.loadRegBaseDisp.word64 x0, [x22 + 0]
    arm64.bl __mm_retain
    arm64.movRegReg x23, x0
    arm64.loadRegBaseDisp.word64 x0, [x22 + 8]
    arm64.bl __mm_retain
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x21 + 0]
    arm64.add x1, x1, x2
    arm64.loadRegBaseDisp.word64 x2, [x23 + 0]
    arm64.add x1, x1, x2
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x24, x1, x2
    arm64.cmp x24, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x24, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.bl __destruct___Tuple2.A.B
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct___Tuple2.A.B
    arm64.movRegReg x0, x24
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
