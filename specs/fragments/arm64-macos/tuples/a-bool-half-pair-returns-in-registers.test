// Test: a-bool-half-pair-returns-in-registers
typealias Num = int(0 to 1000)

function classify(x Num) returns (bool, Num)
	if x == 0 'zero'
		return (false, 0)
	end 'zero'

	return (x > 500, x + 1)
end 'classify'

function main() returns ExitCode
	let p = classify(750)
	print("{p._0} {p._1}")
	return 0
end 'main'
