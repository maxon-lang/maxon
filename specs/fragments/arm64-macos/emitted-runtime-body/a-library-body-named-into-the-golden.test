// Test: a-library-body-named-into-the-golden
function main() returns ExitCode
	let s = "  abc  "
	return s.trim().byteLength() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_8  ; "  abc  "
    arm64.bl String.trim#
    arm64.movRegReg x19, x0
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.cmp x20, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl String.byteLength
    arm64.movRegReg x20, x0
  __il_cont:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_51  ; "panic at a-library-body-named-into-the-golden.test:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @String.trim {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
  __il_body:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.cmp x21, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl String.byteLength
    arm64.movRegReg x21, x0
  __il_cont:
    arm64.cmp x21, 0
    arm64.b.ne ifcont#2
  empty:
    arm64.movRegReg x0, x19
    arm64.bl String.clone
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#2:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl String.scanTrimStart
    arm64.movRegReg x22, x0
    arm64.cmp x22, x21
    arm64.b.lt ifcont#4
  allMatch:
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.movImm x3, 1
    arm64.movRegReg x0, x19
    arm64.bl String.sliceBytes
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#4:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.movRegReg x3, x22
    arm64.bl String.scanTrimEnd
    arm64.movRegReg x2, x0
    arm64.loadRegBaseDisp.byte x3, [x19 + 48]
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl String.sliceBytes
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
