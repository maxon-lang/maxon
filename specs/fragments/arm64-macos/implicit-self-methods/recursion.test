// Test: recursion

typealias Integer = int(i64.min to i64.max)

type Rec
	export var seed as Integer

	static function create() returns Self
		return Self{seed: 0}
	end 'create'

	function sumTo(k Integer) returns Integer
		if k <= 0 'base'
			return 0
		end 'base'
		return k + sumTo(k - 1)
	end 'sumTo'
end 'Rec'

function main() returns ExitCode
	let r = Rec.create()
	return r.sumTo(3)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Rec.sumTo {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.cmp x19, 0
    arm64.b.gt ifcont
  base:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.sub x1, x19, 1
    arm64.bl Rec.sumTo
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 3
    arm64.bl Rec.sumTo
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at recursion.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
