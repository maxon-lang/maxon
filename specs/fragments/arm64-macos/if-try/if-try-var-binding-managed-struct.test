    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_2  ; "hello"
    arm64.bl __str_retain
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

