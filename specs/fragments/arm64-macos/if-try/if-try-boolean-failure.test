// Test: if-try-boolean-failure

enum MyError implements Error
	failed
end 'MyError'

function runStep(succeed bool) throws MyError
	if not succeed 'check'
		throw MyError.failed
	end 'check'
end 'runStep'

function main() returns ExitCode
	var result = 0
	if try runStep(false) 'check'
		result = 1
	end 'check'
	return result
end 'main'
---
ExitCode: 0
---
func @runStep {
  entry:
    arm64.prologue 16
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 0
    arm64.bl runStep
    arm64.cmp x9, 0
    arm64.b.ne ifelse
  check:
    arm64.movImm x0, 1
    arm64.b __rc_ok
  ifelse:
    arm64.movRegReg x0, x19
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
