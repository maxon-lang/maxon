func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  loop:
    arm64.movImm x0, 1
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.b.ne ifelse
  check:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.cmp x3, 0
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x1, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont:
    arm64.add x19, x19, x1
    arm64.bl __destruct_MultiManaged
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifelse:
    arm64.movRegReg x0, x19
  ifcont:
    arm64.add x20, x20, 1
    arm64.movRegReg x19, x0
  whilehdr:
    arm64.cmp x20, 3
    arm64.b.lt loop
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at if-try-binding-struct-multiple-managed-fields.test:38: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
