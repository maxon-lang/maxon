    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.epilogue 80
    arm64.ret
  ifcont:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaRdata x20, __str_rec_2  ; "hello"
    arm64.leaRdata x21, __str_rec_3  ; "world"
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.movRegReg x22, x0
    arm64.loadRegBaseDisp.word64 x23, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x20 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x25, x20
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
    arm64.storeBaseDispReg.word64 [x24 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x24 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x24 + 24], x0
    arm64.loadRegBaseDisp.word64 x20, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x21 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
