// Test: a-declared-clone-beats-the-inline-lowering
extension int implements Cloneable
	export function clone() returns Self
		return self + 100
	end 'clone'
end 'int'

function main() returns ExitCode
	let n = 5
	return n.clone() as ExitCode
end 'main'
---
ExitCode: 105
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 105
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
