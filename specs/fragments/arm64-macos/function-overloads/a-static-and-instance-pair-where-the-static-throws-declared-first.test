// Test: a-static-and-instance-pair-where-the-static-throws-declared-first
typealias Num = int(-1000 to 1000)

enum Boom
	bad
end 'Boom'

type T
	export var v as Num

	export static function make(v Num) returns T
		return Self{v: v}
	end 'make'

	export static function m(a Num) returns Num throws Boom
		if a < 0 'neg'
			throw Boom.bad
		end 'neg'
		return a
	end 'm'

	export function m(b Num) returns Num
		return self.v + b
	end 'm'
end 'T'

function main() returns ExitCode
	let t = T.make(1)
	let s = try T.m(4) otherwise 0
	return (s + t.m(2)) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @T.m#__static {
  entry:
    arm64.prologue 16
    arm64.cmp x0, -1000
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.cmp x0, 0
    arm64.b.ge ifcont
  neg:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-static-and-instance-pair-where-the-static-throws-declared-first.test:15: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
  __rc_ok#9:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#7:
    arm64.movImm x0, 4
    arm64.bl T.m#__static
    arm64.cmp x9, 0
    arm64.b.eq __rc_ok#14
  tryerr:
    arm64.movImm x0, 0
  __rc_ok#14:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.add x1, x1, 2
    arm64.cmp x1, -1000
    arm64.b.lt __rc_panic#18
  __rc_chk#19:
    arm64.cmp x1, 1000
    arm64.b.gt __rc_panic#18
  __il_cont#12:
    arm64.add x19, x0, x1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#5
  __rc_chk#6:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic#5
  __rc_ok#4:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic#18:
    arm64.leaRdata x0, __str_blob_4  ; "panic at a-static-and-instance-pair-where-the-static-throws-declared-first.test:23: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_5  ; "panic at a-static-and-instance-pair-where-the-static-throws-declared-first.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
