// Test: all-in-literal

typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	export static function make(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'make'
end 'Point'

function main() returns ExitCode
	let p = Point.make(1, y: 41)
	return p.x + p.y
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 41
  __il_cont:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at all-in-literal.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
