// Test: all-defaults
type Defaults
	export var a = 10
	export var b = 32

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Defaults'

function main() returns ExitCode
	let d = Defaults.make()
	return d.a + d.b
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 10
    arm64.movImm x1, 32
  __il_cont:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at all-defaults.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
