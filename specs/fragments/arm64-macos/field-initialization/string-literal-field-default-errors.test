// Test: string-literal-field-default-errors

type Box
	export var name = "hello"

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return 0
end 'main'
---
CompilerError:
error E2004: <fragment>:4:20: Expected default value: literal (int, float, bool, or enum case). For other expressions, add a type annotation: 'var name Type = expr'.
