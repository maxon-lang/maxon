// Test: computed-in-range-return-is-unchanged
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function code() returns ExitCode
  return opaque(3) + 4
end 'code'

function main() returns ExitCode
  return code()
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont#6:
    arm64.movImm x0, 7
  __il_cont#1:
    arm64.epilogue 16
    arm64.ret
}
