// Test: builtins-mm-counters.raw-total-is-never-below-tracked-total-after-boxes
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let rawBefore = __Builtins.mmRawAllocTotal()
	let boxesBefore = __Builtins.mmAllocTotal()
	var buf = ByteArray.create()
	for _ in 0 upto 256 'push'
		buf.push(3)
	end 'push'
	let raw = __Builtins.mmRawAllocTotal()
	let boxes = __Builtins.mmAllocTotal()
	var score = 0
	if boxes > boxesBefore 'theWindowBoxedSomething'
		score = score + 1
	end 'theWindowBoxedSomething'
	if raw >= 0 'theSubtractionStaysPositive'
		score = score + 2
	end 'theSubtractionStaysPositive'
	if raw + boxes - rawBefore - boxesBefore >= boxes - boxesBefore 'everyBoxIsASlabRequest'
		score = score + 4
	end 'everyBoxIsASlabRequest'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl __mm_counter_raw_alloc_total
    arm64.movRegReg x19, x0
    arm64.bl __mm_counter_alloc_total
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 0
    arm64.b forhdr
  push:
    arm64.movImm x1, 3
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
  forstep:
    arm64.add x22, x22, 1
  forhdr:
    arm64.cmp x22, 256
    arm64.b.lt push
  forexit:
    arm64.bl __mm_counter_raw_alloc_total
    arm64.movRegReg x22, x0
    arm64.bl __mm_counter_alloc_total
    arm64.movImm x1, 0
    arm64.cmp x0, x20
    arm64.b.le ifcont#6
  theWindowBoxedSomething:
    arm64.movImm x1, 1
  ifcont#6:
    arm64.cmp x22, 0
    arm64.b.lt ifcont#8
  theSubtractionStaysPositive:
    arm64.add x1, x1, 2
  ifcont#8:
    arm64.add x2, x22, x0
    arm64.sub x2, x2, x19
    arm64.sub x2, x2, x20
    arm64.sub x0, x0, x20
    arm64.cmp x2, x0
    arm64.b.lt critsplit
  everyBoxIsASlabRequest:
    arm64.add x19, x1, 4
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x19, x1
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
