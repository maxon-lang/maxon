// Test: builtins-mm-counters.bytes-scale-with-the-request
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias PushCount = int(0 to 65536)

function volume() returns BytePos
	return (__Builtins.mmAllocBytes() + __Builtins.mmRawAllocBytes()) as BytePos
end 'volume'

function fill(n PushCount)
	var buf = ByteArray.create()
	for _ in 0 upto n 'push'
		buf.push(3)
	end 'push'
end 'fill'

function main() returns ExitCode
	let before = volume()
	fill(16)
	let afterSmall = volume()
	fill(1024)
	let afterLarge = volume()
	let small = afterSmall - before
	let large = afterLarge - afterSmall
	var score = 0
	if large > small 'bytesScaleWithTheRequest'
		score = score + 2
	end 'bytesScaleWithTheRequest'
	if large >= 1024 'atLeastThePayloadAsked'
		score = score + 3
	end 'atLeastThePayloadAsked'
	return score as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __mm_alloc_total@8 = i64 0
  __mm_alloc_bytes@16 = i64 0
  __mm_raw_alloc_count@24 = i64 0
  __mm_raw_live_count@32 = i64 0
  __mm_raw_alloc_bytes@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
}

func @volume {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __mm_counter_alloc_bytes
    arm64.movRegReg x19, x0
    arm64.bl __mm_counter_raw_alloc_bytes
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at builtins-mm-counters.bytes-scale-with-the-request.test:7: Range check failed: value outside typealias 'BytePos'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @fill {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 65536
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.b forhdr
  push:
    arm64.movImm x1, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x21, x21, 1
  forhdr:
    arm64.cmp x21, x19
    arm64.b.lt push
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at builtins-mm-counters.bytes-scale-with-the-request.test:10: Range check failed: value outside typealias 'PushCount'\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl volume
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.bl fill
    arm64.bl volume
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1024
    arm64.bl fill
    arm64.bl volume
    arm64.sub x1, x20, x19
    arm64.sub x0, x0, x20
    arm64.movImm x2, 0
    arm64.cmp x0, x1
    arm64.b.ls critsplit#8
  bytesScaleWithTheRequest:
    arm64.movImm x1, 2
    arm64.b ifcont
  critsplit#8:
    arm64.movRegReg x1, x2
  ifcont:
    arm64.cmp x0, 1024
    arm64.b.lo critsplit#9
  atLeastThePayloadAsked:
    arm64.add x0, x1, 3
    arm64.b __rc_ok
  critsplit#9:
    arm64.movRegReg x0, x1
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
