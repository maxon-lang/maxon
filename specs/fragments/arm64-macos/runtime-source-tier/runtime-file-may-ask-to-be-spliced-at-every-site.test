// Test: runtime-file-may-ask-to-be-spliced-at-every-site
// --- runtime-file: Probe.maxon
module function __probe_spliced(seed MachineWord) returns MachineWord
	__Raw.splicedAtEverySite()

	return seed + 1
end '__probe_spliced'
// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
