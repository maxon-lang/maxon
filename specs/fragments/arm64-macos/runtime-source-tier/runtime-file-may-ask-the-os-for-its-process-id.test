// Test: runtime-file-may-ask-the-os-for-its-process-id
// --- runtime-file: Probe.maxon
function probePid() returns MachineWord
	return __Raw.osGetPid()
end 'probePid'
// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
