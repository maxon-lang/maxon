// Test: interface-param-checked-float-divide-survives-specialization
typealias Real = float(f64.min to f64.max)

interface Scorer
	function score() returns Real
end 'Scorer'

type Alpha implements Scorer
	let n as Real
	function score() returns Real
		return n * 2.0
	end 'score'
	static function create(n Real) returns Self
		return Self{n: n}
	end 'create'
end 'Alpha'

function opaque(x Real) returns Real
	return x
end 'opaque'

function ratioVia(s Scorer, d Real) returns Real
	let base = s.score()
	return try (base / d) otherwise panic("ratioVia: d was 0")
end 'ratioVia'

function main() returns ExitCode
	let a = Alpha.create(21.0)
	let r = ratioVia(a, d: opaque(3.0))
	return 14 if r == 14.0 else 1
end 'main'
---
ExitCode: 14
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Alpha.score {
  entry:
    arm64.prologue 16
    arm64.movRegReg x1, x0
    arm64.loadRegBaseDisp.word64 d0, [x1 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, d8
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.fpLoadRdata d8, [rdata + __fconst_21]
  __il_body#10:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.storeBaseDispReg.word64 [x19 + 0], d8
  __il_cont#9:
    arm64.fpLoadRdata d8, [rdata + __fconst_3]
  __il_cont#8:
    arm64.leaRdata x1, __witness_Alpha.Scorer
  __il_body#12:
    arm64.movRegReg x0, x19
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
    arm64.blr x16
    arm64.fdiv d0, d0, d8
  __il_cont#7:
    arm64.fpLoadRdata d1, [rdata + __fconst_14]
    arm64.fcmp d0, d1
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x20, 14
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x20, 1
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot d8, slot2
    arm64.epilogue 48
    arm64.ret
}
