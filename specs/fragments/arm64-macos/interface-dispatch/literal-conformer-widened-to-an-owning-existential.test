// Test: literal-conformer-widened-to-an-owning-existential
typealias Tally = int(0 to 100)

var widenings = 0 as Tally

// The discard below is the whole shape, so `widen` must have an effect — discarding a PURE result is
// E3064 (`discarded-results.md`) and the program would never reach the retain this case is about.
function widen(h Hashable) returns Hashable
	widenings = widenings + 1
	return h
end 'widen'

function main() returns ExitCode
	print("A")
	_ = widen("abc")
	print("B")
	return widenings - 1
end 'main'
---
ExitCode: 0
---
data {
  __data_widenings@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @widen {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x2, x0
    arm64.movRegReg x19, x1
    arm64.leaGlobal x0, __data_widenings
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_widenings
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x2
    arm64.bl __retain_existential
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_3  ; "A"
    arm64.bl print
    arm64.leaRdata x0, __str_rec_4  ; "abc"
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.bl widen
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.bl __drop_existential
    arm64.leaRdata x0, __str_rec_5  ; "B"
    arm64.bl print
    arm64.leaGlobal x0, __data_widenings
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.sub x0, x0, 1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_16  ; "panic at literal-conformer-widened-to-an-owning-existential.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
