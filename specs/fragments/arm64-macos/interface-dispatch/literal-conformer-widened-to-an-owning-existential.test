// Test: literal-conformer-widened-to-an-owning-existential
function widen(h Hashable) returns Hashable
	return h
end 'widen'

function main() returns ExitCode
	print("A")
	_ = widen("abc")
	print("B")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @widen {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x2, x0
    arm64.movRegReg x19, x1
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x2
    arm64.bl __retain_existential
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_3  ; "A"
    arm64.bl print
    arm64.leaRdata x0, __str_rec_4  ; "abc"
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.bl widen
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.bl __drop_existential
    arm64.leaRdata x0, __str_rec_5  ; "B"
    arm64.bl print
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
