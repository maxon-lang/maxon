// Test: interface-dispatch.interface-parameter-on-a-plain-function-still-compiles
typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Sq implements Shape
	let s as Integer

	function area() returns Integer
		return self.s
	end 'area'

	static function create(s Integer) returns Self
		return Self{s: s}
	end 'create'
end 'Sq'

function takeShape(c Shape, base Integer) returns Integer
	return base + c.area()
end 'takeShape'

type Holder
	let base as Integer

	function measure(c Shape) returns Integer
		return self.base + c.area()
	end 'measure'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Holder'

type Helper
	static function measure(c Shape, base Integer) returns Integer
		return base + c.area()
	end 'measure'
end 'Helper'

function main() returns ExitCode
	return (takeShape(Sq.create(11), base: 20) - Holder.create(20).measure(Sq.create(11)) + Helper.measure(Sq.create(11), base: 31)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Sq.area {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Sq.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 11
    arm64.bl Sq.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_Sq.Shape
  __il_body#8:
    arm64.movRegReg x0, x19
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
    arm64.blr x16
    arm64.add x20, x0, 20
  __il_cont#7:
    arm64.movImm x21, 20
  __il_body#9:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.storeBaseDispReg.word64 [x22 + 0], x21
  __il_cont#6:
    arm64.movImm x0, 11
    arm64.bl Sq.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __witness_Sq.Shape
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x23, [x22 + 0]
    arm64.movRegReg x0, x21
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
    arm64.blr x16
    arm64.add x0, x23, x0
  __il_cont#5:
    arm64.sub x20, x20, x0
    arm64.movImm x0, 11
    arm64.bl Sq.create
    arm64.movRegReg x23, x0
    arm64.leaRdata x1, __witness_Sq.Shape
  __il_body#11:
    arm64.movRegReg x0, x23
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
    arm64.blr x16
    arm64.add x0, x0, 31
  __il_cont#4:
    arm64.add x20, x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
