// Test: interface-dispatch.narrow-formal-through-throwing-requirement
typealias Integer = int(i64.min to i64.max)

enum TakeError implements Error
	tooSmall
end 'TakeError'

interface Exiter
	function take(c ExitCode) returns Integer throws TakeError
end 'Exiter'

type Runner implements Exiter
	let base as Integer

	function take(c ExitCode) returns Integer throws TakeError
		if c < 5 'small'
			throw TakeError.tooSmall
		end 'small'
		return base + (c as Integer)
	end 'take'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Runner'

type Box uses T where T is Exiter
	let item as T

	export function run() returns Integer
		return try self.item.take(11 as ExitCode) otherwise 55
	end 'run'

	static function create(item T) returns Self
		return Self{item: item}
	end 'create'
end 'Box'

typealias RunnerBox = Box with Runner

function main() returns ExitCode
	return RunnerBox.create(Runner.create(20)).run() as ExitCode
end 'main'
---
ExitCode: 31
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Runner.take {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.cmp x1, 5
    arm64.b.ge ifcont
  small:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, x1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at interface-dispatch.narrow-formal-through-throwing-requirement.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 20
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#6:
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __witness_Runner.Exiter
  __il_body#8:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
  __il_cont#5:
    arm64.leaRdata x2, __witness_Runner.Exiter
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.movImm x1, 11
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 55
    arm64.b __il_cont#4
  tryok:
    arm64.movRegReg x19, x0
  __il_cont#4:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Box_Runner
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
