  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at interface-dispatch.narrow-formal-through-throwing-requirement.test:42: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
