// Test: scalar-conformer-stored-directly-in-an-interface-field
typealias Integer = int(i64.min to i64.max)

type Holder
	export let key as Hashable
	export let size as Integer

	static function create(size Integer) returns Self
		return Self{key: size, size: size}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(7)
	return h.size as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
  __il_body:
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.storeBaseDispReg.word64 [x0 + 16], x19
  __il_cont:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 16]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_10  ; "panic at scalar-conformer-stored-directly-in-an-interface-field.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
