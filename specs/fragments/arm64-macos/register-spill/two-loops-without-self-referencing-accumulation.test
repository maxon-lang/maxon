// Test: two-loops-without-self-referencing-accumulation
function main() returns ExitCode
	let b = [72]
	var one = ""
	for x in b 'eachOne'
		one = "{x}"
	end 'eachOne'
	var two = ""
	for x in b 'eachTwo'
		two = "{x}"
	end 'eachTwo'
	print("{one} {two}\n")
	return 0
end 'main'
