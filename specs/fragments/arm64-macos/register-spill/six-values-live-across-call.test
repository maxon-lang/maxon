// Test: six-values-live-across-call
function sink(x Integer) returns Integer
	return x
end 'sink'

function caller(p Integer) returns Integer
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let r = sink(p)
	return a1 + a2 + a3 + a4 + a5 + a6 + r
end 'caller'

function main() returns ExitCode
	return caller(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 21
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont:
    arm64.movImm x0, 21
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
