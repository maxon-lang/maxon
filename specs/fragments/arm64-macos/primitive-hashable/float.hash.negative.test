// Test: float.hash.negative
function main() returns ExitCode
	let pos = 3.14
	let neg = -3.14
	if neg.hash() != pos.hash() 'signMasked'
		return 1
	end 'signMasked'
	if neg.hash() != 1374389535 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
