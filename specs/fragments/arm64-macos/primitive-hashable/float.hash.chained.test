// Test: float.hash.chained
function main() returns ExitCode
	let f = 3.14
	let once = f.hash()
	let twice = f.hash().hash()
	if once != twice 'chainDiffers'
		return 1
	end 'chainDiffers'
	if once != 1374389535 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  ifcont#10:
    arm64.movImm x19, 1374389535
  ifcont#16:
    arm64.movImm x0, 1374389535
  __il_body:
    arm64.movImm x1, 4294967295
    arm64.and x1, x0, x1
    arm64.cmp x1, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.movImm x2, 4294967295
    arm64.cmp x1, x2
    arm64.b.le __rc_ok
  __il_slow:
    arm64.bl int.hash
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.cmp x19, x0
    arm64.b.eq ifcont#2
  chainDiffers:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x16, 1374389535
    arm64.cmp x19, x16
    arm64.b.eq ifcont#4
  pinned:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
