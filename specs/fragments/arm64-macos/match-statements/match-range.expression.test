// Test: match-range.expression
function main() returns ExitCode
	let temp = 22
	let category = match temp 'weather'
		min upto 0 gives 1
		0 upto 15 gives 2
		15 upto 25 gives 3
		25 to max gives 4
		default gives 0
	end 'weather'
	return category
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 3
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
