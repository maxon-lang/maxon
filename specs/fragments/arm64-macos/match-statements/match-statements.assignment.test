// Test: match-statements.assignment
function main() returns ExitCode
	let x = 2
	var result = 0
	match x 'process'
		1 then result = 60
		2 then result = 120
		default then result = 0
	end 'process'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 120
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
