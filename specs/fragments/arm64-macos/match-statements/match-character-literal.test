// Test: match-character-literal
function main() returns ExitCode
	let c = 'ñ'
	match c 'check'
		'ñ' then print("eq\n")
		default then print("ne\n")
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_3  ; "\xc3\xb1"
    arm64.leaRdata x1, __str_rec_3  ; "\xc3\xb1"
    arm64.bl __str_eq
    arm64.cbz x0, matchnext
  matcharm:
    arm64.leaRdata x0, __str_rec_4  ; "eq\x0a"
    arm64.bl print
    arm64.b matchcont
  matchnext:
    arm64.leaRdata x0, __str_rec_5  ; "ne\x0a"
    arm64.bl print
  matchcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
