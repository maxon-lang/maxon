// Test: match-statements.nested-in-function

typealias Integer = int(i64.min to i64.max)

function categorize(n Integer) returns Integer
	match n 'cat'
		1 or 2 or 3 then return 1
		4 or 5 or 6 then return 2
		default then return 0
	end 'cat'
end 'categorize'

function main() returns ExitCode
	return categorize(5)
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 4
    arm64.jumpTable x0, default=matchdefault [[0..2]=matcharm#6, [3..5]=matcharm#7] @__jumptable_1
  matchdefault:
    arm64.movImm x0, 0
    arm64.b __il_cont
  matcharm#6:
    arm64.movImm x0, 1
    arm64.b __il_cont
  matcharm#7:
    arm64.movImm x0, 2
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-statements.nested-in-function.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
