// Test: match-statements.fallthrough
function main() returns ExitCode
	let x = 1
	var result = 0
	match x 'check'
		1 then result = result + 10 and fallthrough
		2 then result = result + 20
		default then result = result + 100
	end 'check'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    arm64.prologue 16
  matcharm#1:
    arm64.movImm x0, 10
  matcharm#2:
    arm64.add x0, x0, 20
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
