// Test: match-statements.try-otherwise-default
enum Err implements Error
	bad
end 'Err'

typealias Tally = int(0 to 100)
typealias Score = int(0 to 100)

function leaf() returns Score throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) returns Score
	match kind 'k'
		1 then return try leaf() otherwise 42
		default panic("unreachable")
	end 'k'
end 'dispatch'

function main() returns ExitCode
	return dispatch(1)
end 'main'
---
ExitCode: 42
---
func @leaf {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @dispatch {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at match-statements.try-otherwise-default.test:13: Range check failed: value outside typealias 'Tally'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 1
    arm64.b.ne matchdefault
  matcharm:
    arm64.bl leaf
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 42
  trycont:
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-statements.try-otherwise-default.test:16: unreachable\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl dispatch
    arm64.epilogue 16
    arm64.ret
}
