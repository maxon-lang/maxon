// Test: match-statements.try-otherwise-panic
enum Err implements Error
	bad
end 'Err'

function ok(strict bool) throws Err
	if strict 'strict'
		throw Err.bad
	end 'strict'

	return
end 'ok'

function dispatch(kind Tally)
	match kind 'k'
		1 then try ok(false) otherwise panic("unreachable")
		default panic("unreachable")
	end 'k'
end 'dispatch'

typealias Tally = int(0 to 100)

function main() returns ExitCode
	dispatch(1)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_program_started@0 = i8 0
}

func @ok {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  strict:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 0
    arm64.bl ok
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  __il_cont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-statements.try-otherwise-panic.test:16: unreachable\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
