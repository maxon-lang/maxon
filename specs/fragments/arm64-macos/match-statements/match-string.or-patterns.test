// Test: match-string.or-patterns
function main() returns ExitCode
	let name = "carol"
	match name 'greet'
		"alice" or "bob" then return 1
		"carol" or "dave" then return 2
		default then return 0
	end 'greet'
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_4  ; "carol"
    arm64.leaRdata x1, __str_rec_5  ; "alice"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __str_rec_6  ; "bob"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.orr x0, x20, x0
    arm64.cbz x0, matchnext#2
  matcharm#1:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext#2:
    arm64.leaRdata x1, __str_rec_4  ; "carol"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __str_rec_7  ; "dave"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.orr x0, x20, x0
    arm64.cbz x0, matchnext#4
  matcharm#3:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext#4:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
