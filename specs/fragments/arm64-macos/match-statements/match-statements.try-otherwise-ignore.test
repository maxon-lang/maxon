// Test: match-statements.try-otherwise-ignore
enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally)
	match kind 'k'
		1 then try leaf() otherwise ignore
		default panic("unreachable")
	end 'k'
end 'dispatch'

typealias Tally = int(0 to 100)

function main() returns ExitCode
	dispatch(1)
	return 0
end 'main'
---
ExitCode: 0
---
func @leaf {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.bl leaf
    arm64.cmp x9, 0
    arm64.b.ne __il_cont
  __il_cont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
