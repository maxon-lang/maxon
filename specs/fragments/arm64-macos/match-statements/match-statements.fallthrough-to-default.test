// Test: match-statements.fallthrough-to-default
function main() returns ExitCode
	let x = 3
	var result = 0
	match x 'check'
		1 then result = 10
		2 then result = 20
		3 then result = result + 30 and fallthrough
		default then result = result + 90
	end 'check'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 30
  matchdefault:
    arm64.add x0, x0, 90
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
