// Test: break.in-loop
function main() returns ExitCode
	var x = 0
	while true 'loop'
		x = x + 1
		if x == 5 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  loop:
    arm64.add x0, x0, 1
    arm64.cmp x0, 5
    arm64.b.ne loop
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
