// Test: enum-hash-direct
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	let d = Direction.south
	let h = d.hash()
	return h
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
