// Test: imm12-boundary
function main() returns ExitCode
	let cell = [1000]
	let x = try cell.get(0) otherwise 0
	let addLo = x + 4095
	if addLo != 5095 'addLo'
		return 11
	end 'addLo'
	let subLo = x - 4095
	if subLo != -3095 'subLo'
		return 12
	end 'subLo'
	let addHi = x + 4096
	if addHi != 5096 'addHi'
		return 13
	end 'addHi'
	let subHi = x - 4096
	if subHi != -3096 'subHi'
		return 14
	end 'subHi'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#16
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#17
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#17:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#16:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 0
  trycont:
    arm64.add x1, x0, 4095
    arm64.movImm x16, 5095
    arm64.cmp x1, x16
    arm64.b.eq ifcont#5
  addLo:
    arm64.movImm x20, 11
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#5:
    arm64.sub x1, x0, 4095
    arm64.cmp x1, -3095
    arm64.b.eq ifcont#7
  subLo:
    arm64.movImm x20, 12
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#7:
    arm64.add x1, x0, 4096
    arm64.movImm x16, 5096
    arm64.cmp x1, x16
    arm64.b.eq ifcont#9
  addHi:
    arm64.movImm x20, 13
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#9:
    arm64.sub x0, x0, 4096
    arm64.cmp x0, -3096
    arm64.b.eq ifcont#11
  subHi:
    arm64.movImm x20, 14
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#11:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
