// Test: shifted-imm12-boundary
function main() returns ExitCode
	let cell = [1000]
	let x = try cell.get(0) otherwise 0
	let addShifted = x + 16773120
	if addShifted != 16774120 'addShifted'
		return 21
	end 'addShifted'
	let subShifted = x - 16773120
	if subShifted != -16772120 'subShifted'
		return 22
	end 'subShifted'
	let addPair = x + 16777215
	if addPair != 16778215 'addPair'
		return 23
	end 'addPair'
	let subPair = x - 16777215
	if subPair != -16776215 'subPair'
		return 24
	end 'subPair'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x1, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.movImm x1, 8
    arm64.storeBaseDispReg.word64 [x0 + 24], x1
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x1, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont:
    arm64.add x2, x1, 16773120
    arm64.movImm x16, 16774120
    arm64.cmp x2, x16
    arm64.b.eq ifcont#5
  addShifted:
    arm64.movImm x19, 21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#5:
    arm64.sub x2, x1, 16773120
    arm64.movImm x16, 18446744073692779496
    arm64.cmp x2, x16
    arm64.b.eq ifcont#7
  subShifted:
    arm64.movImm x19, 22
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#7:
    arm64.add x2, x1, 16777215
    arm64.movImm x16, 16778215
    arm64.cmp x2, x16
    arm64.b.eq ifcont#9
  addPair:
    arm64.movImm x19, 23
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#9:
    arm64.sub x1, x1, 16777215
    arm64.movImm x16, 18446744073692775401
    arm64.cmp x1, x16
    arm64.b.eq ifcont#11
  subPair:
    arm64.movImm x19, 24
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#11:
    arm64.movImm x19, 0
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}
