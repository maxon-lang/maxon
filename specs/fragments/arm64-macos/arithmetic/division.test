// Test: division
function main() returns ExitCode
	return trunc(100 / 4)
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 62
    arm64.add x0, x0, 100
    arm64.asr x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
