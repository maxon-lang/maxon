// Test: div-live-values

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function divLive(a Integer, b NonZero, x Integer) returns Integer
	let preserved = x + 1
	let result = try (a / (b as Integer)) otherwise panic("b is never zero")
	return trunc(result + preserved)
end 'divLive'

function main() returns ExitCode
	return divLive(10, b: 2, x: 5)
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
  divok:
    arm64.movImm x1, 0
    arm64.orr x1, x1, 2
    arm64.sdiv x0, x0, x1
  tryok:
    arm64.add x0, x0, 6
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at div-live-values.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
