// Test: div-live-values

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function divLive(a Integer, b NonZero, x Integer) returns Integer
	let preserved = x + 1
	let result = try (a / (b as Integer)) otherwise panic("b is never zero")
	return trunc(result + preserved)
end 'divLive'

function main() returns ExitCode
	return divLive(10, b: 2, x: 5)
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
  __rc_ok#8:
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 10
    arm64.asr x0, x0, 1
  tryok:
    arm64.add x0, x0, 6
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
