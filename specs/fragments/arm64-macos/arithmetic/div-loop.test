// Test: div-loop

typealias Integer = int(i64.min to i64.max)

function divLoop(n Integer) returns Integer
	var sum = 0
	var i = 1
	while i <= n 'loop'
		sum = sum + trunc(try (50 / i) otherwise panic("divLoop: i was 0"))
		i = i + 1
	end 'loop'
	return sum
end 'divLoop'

function main() returns ExitCode
	return divLoop(5)
end 'main'
---
ExitCode: 113
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.b whilehdr
  loop:
    arm64.movImm x2, 50
    arm64.sdiv x2, x2, x1
  tryok:
    arm64.add x0, x0, x2
    arm64.add x1, x1, 1
  whilehdr:
    arm64.cmp x1, 5
    arm64.b.le loop
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at div-loop.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
