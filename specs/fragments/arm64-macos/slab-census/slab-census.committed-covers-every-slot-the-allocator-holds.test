// Test: slab-census.committed-covers-every-slot-the-allocator-holds
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Seed = int(0 to 65536)

function build(seed Seed) returns ByteArray
	var b = ByteArray.create()
	b.reserve(96)
	for i in 0 upto 96 'fill'
		b.push(((seed + i) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var bufs = Bufs.create()

	if __Builtins.slabCommittedBytes() <= 0 'nothingCommittedAtStart'
		return 1
	end 'nothingCommittedAtStart'

	for k in 0 upto 8000 'alloc'
		bufs.push(build(k as Seed))

		if __Builtins.slabCommittedBytes() < (__Builtins.slabLiveBytes() + __Builtins.slabFreeBytes()) 'slotsOutsideTheCommittedSet'
			return 2
		end 'slotsOutsideTheCommittedSet'
	end 'alloc'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.bl __slab_committed_bytes
    arm64.cmp x0, 0
    arm64.b.gt ifcont
  nothingCommittedAtStart:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.b forhdr#3
  __rc_ok#15:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 96
  __rc_ok#27:
    arm64.movRegReg x0, x21
    arm64.bl __managed_capacity
    arm64.cmp x0, 96
    arm64.b.ge __il_cont#21
  grow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont#21
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __il_cont#21:
    arm64.movImm x22, 0
    arm64.b forhdr#11
  fill:
    arm64.add x0, x20, x22
    arm64.movImm x1, 367465021388636487
    arm64.umulh x1, x1, x0
    arm64.sub x2, x0, x1
    arm64.lsr x2, x2, 1
    arm64.add x1, x2, x1
    arm64.lsr x1, x1, 7
    arm64.movImm x16, 251
    arm64.mul x1, x1, x16
    arm64.sub x1, x0, x1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok#18:
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
  forstep#13:
    arm64.add x22, x22, 1
  forhdr#11:
    arm64.cmp x22, 96
    arm64.b.lt fill
  __il_cont#9:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
    arm64.bl __slab_committed_bytes
    arm64.movRegReg x21, x0
    arm64.bl __slab_live_bytes
    arm64.movRegReg x22, x0
    arm64.bl __slab_free_bytes
    arm64.add x0, x22, x0
    arm64.cmp x21, x0
    arm64.b.ge forstep#5
  slotsOutsideTheCommittedSet:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  forstep#5:
    arm64.add x20, x20, 1
  forhdr#3:
    arm64.movImm x16, 8000
    arm64.cmp x20, x16
    arm64.b.lt __rc_ok#15
  forexit:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at slab-census.committed-covers-every-slot-the-allocator-holds.test:11: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
