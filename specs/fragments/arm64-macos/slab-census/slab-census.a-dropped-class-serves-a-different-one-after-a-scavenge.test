    arm64.cmp x9, 0
    arm64.b.eq __il_cont
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __il_cont:
    arm64.movImm x22, 0
    arm64.b forhdr
  fill:
    arm64.add x0, x19, x22
    arm64.movImm x1, 367465021388636487
    arm64.umulh x1, x1, x0
    arm64.sub x2, x0, x1
