typealias Count = int(0 to 100)

function pick(n Count)
	print("n{n}\n")
end 'pick'

// --- file: main.maxon
typealias Integer = int(i64.min to i64.max)

function pick(pair (Integer, Integer)) returns String
	return "p{pair.0}"
end 'pick'

function main() returns ExitCode
	pick(7)
	return 0
end 'main'
