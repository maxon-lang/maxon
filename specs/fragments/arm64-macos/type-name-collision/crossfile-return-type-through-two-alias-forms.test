// Test: crossfile-return-type-through-two-alias-forms
// --- file: a.maxon
typealias Pair = int(0 to 5)

export function fromA() returns Pair
	return 4
end 'fromA'

// --- file: b.maxon
typealias Coord = int(0 to 100)
typealias Pair = (Coord, Coord)

export function fromB() returns Pair
	return (7, 9)
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	let p = fromB()

	return fromA() + p.0 + p.1
end 'main'
---
ExitCode: 20
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 7
    arm64.movImm x1, 9
  __il_cont:
    arm64.add x0, x0, 4
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
