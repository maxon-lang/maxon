// Test: borrowed-field-read-moved-into-durable-storage
typealias Integer = int(i64.min to i64.max)

type Item
	export let n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Item'

type Holder
	export let item as Item

	static function create(item Item) returns Self
		return Self{item: item}
	end 'create'

	static function copyOf(other Holder) returns Self
		return Self{item: other.item}
	end 'copyOf'
end 'Holder'

function main() returns ExitCode
	let a = Holder.create(Item.create(5))
	let b = Holder.copyOf(a)
	return a.item.n + b.item.n
end 'main'
---
ExitCode: 10
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_body#8:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
  __il_cont:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x20, x0, x1
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at borrowed-field-read-moved-into-durable-storage.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
