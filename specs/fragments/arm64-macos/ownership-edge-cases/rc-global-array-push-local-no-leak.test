// Test: rc-global-array-push-local-no-leak
typealias Integer = int(i64.min to i64.max)

type Item
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Item'

typealias ItemArray = Array with Item

var globalArr = ItemArray.create()

function pushLocal()
	let item = Item.create(123)
	globalArr.push(item)
end 'pushLocal'

function main() returns ExitCode
	pushLocal()
	let elem = try globalArr.get(0) otherwise Item.create(-1)
	return elem.value
end 'main'
---
ExitCode: 123
---
data {
  __data_globalArr@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Item.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x0, 123
    arm64.bl Item.create
    arm64.movRegReg x19, x0
    arm64.leaGlobal x0, __data_globalArr
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_own
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
  __il_cont:
    arm64.leaGlobal x0, __data_globalArr
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x19, [x2 + x1*8 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x0 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#13
  __im_empty:
    arm64.cmp x19, 0
    arm64.b.eq __im_slow
  critsplit#14:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#13:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 18446744073709551615
    arm64.bl Item.create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
  trycont:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow:
    arm64.bl __managed_get
    arm64.movRegReg x19, x0
    arm64.b __im_cont
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at rc-global-array-push-local-no-leak.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
