// Test: rc-generic-function-with-scope-ops
typealias Integer = int(i64.min to i64.max)

type Wrapper
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Wrapper'

typealias WrapperArray = Array with Wrapper

function firstOrDefault(arr WrapperArray) returns Wrapper
	let fallback = Wrapper.create(0)
	let result = try arr.get(0) otherwise fallback
	return result
end 'firstOrDefault'

function main() returns ExitCode
	var arr = WrapperArray.create()
	let w = Wrapper.create(42)
	arr.push(w)
	let got = firstOrDefault(arr)
	return got.value
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Wrapper.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @firstOrDefault {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.bl Wrapper.create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 40]
    arm64.cmp x2, 0
    arm64.b.eq critsplit#8
  __im_empty:
    arm64.cmp x21, 0
    arm64.b.ne critsplit#9
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x19, x0
    arm64.b __im_cont
  critsplit#9:
    arm64.movRegReg x19, x21
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  critsplit#8:
    arm64.movRegReg x19, x21
    arm64.movRegReg x9, x0
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x19, x20
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  trycont:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 42
    arm64.bl Wrapper.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl firstOrDefault
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rc-generic-function-with-scope-ops.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
