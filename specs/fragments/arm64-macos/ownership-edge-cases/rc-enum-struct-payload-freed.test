    arm64.storeBaseDispReg.word64 [x19 + 8], x20
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#8:
    arm64.movImm x20, 0
    arm64.b __il_cont#4
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#9:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x21, [x20 + 0]
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x20, x21
  __il_cont#4:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Shape
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
