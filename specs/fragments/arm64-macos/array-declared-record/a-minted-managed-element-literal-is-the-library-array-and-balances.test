    arm64.leaRdata x0, __str_rec_3  ; "bb"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.leaRdata x19, __str_rec_3  ; "bb"
    arm64.leaRdata x0, __layout___Array_String
    arm64.leaRdata x21, __witness_String.Equatable
  __il_body#6:
    arm64.movImm x22, 0
    arm64.b forhdr
  scan:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x22*8 + 0]
    arm64.b __im_cont
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.add x0, x0, x22
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.bl __managed_get_unchecked
  __im_cont:
    arm64.movRegReg x1, x19
    arm64.loadRegBaseDisp.word64 x16, [x21 + 40]
    arm64.blr x16
    arm64.cbz x0, forstep
