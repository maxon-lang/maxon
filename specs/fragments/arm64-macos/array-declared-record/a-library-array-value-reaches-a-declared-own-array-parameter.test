// Test: a-library-array-value-reaches-a-declared-own-array-parameter
type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Array'

typealias MyStrings = Array with String

function takesMine(parts MyStrings) returns Integer
	return parts.count()
end 'takesMine'

function main() returns ExitCode
	let s = "a,b,c"
	return takesMine(s.split(",")) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "a,b,c"
    arm64.leaRdata x20, __str_rec_3  ; ","
  __il_body#7:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
  __il_body#19:
    arm64.loadRegBaseDisp.word64 x22, [x20 + 8]
  __il_cont#18:
    arm64.cmp x22, 0
    arm64.b.ne __il_body#21
  __il_body#17:
    arm64.movImm x1, 0
  __il_body#23:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
  __il_cont#22:
    arm64.loadRegBaseDisp.byte x3, [x19 + 48]
    arm64.movRegReg x0, x19
    arm64.bl String.sliceBytes
    arm64.movRegReg x1, x0
  __il_cont#16:
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.b __il_body#5
  __il_body#21:
    arm64.loadRegBaseDisp.word64 x23, [x19 + 8]
  __il_cont#20:
    arm64.movImm x24, 0
    arm64.b whilehdr
  search:
    arm64.sub x2, x23, x24
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.movRegReg x3, x20
    arm64.bl findIn
    arm64.cmp x9, 0
    arm64.b.ne whileexit
  try_find:
    arm64.add x25, x24, x0
    arm64.loadRegBaseDisp.byte x3, [x19 + 48]
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x25
    arm64.bl String.sliceBytes
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.add x0, x25, x22
  ifcont:
    arm64.movRegReg x24, x0
  whilehdr:
    arm64.sub x0, x23, x22
    arm64.cmp x24, x0
    arm64.b.le search
  whileexit:
    arm64.loadRegBaseDisp.byte x3, [x19 + 48]
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x23
    arm64.bl String.sliceBytes
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
  __il_body#5:
    arm64.loadRegBaseDisp.word64 x19, [x21 + 8]
  __il_cont#4:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.epilogue 80
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_10  ; "panic at a-library-array-value-reaches-a-declared-own-array-parameter.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.epilogue 80
    arm64.ret
}
