    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x20, 0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x20, x0
  trycont#3:
    arm64.movImm x1, 1
