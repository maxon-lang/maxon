// Test: i32-unsigned-div
typealias SmallInt = int(0 to 1000)

function main() returns ExitCode
	let a = 20 as SmallInt
	let b = 3 as SmallInt
	return a / b
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 3
    arm64.udiv x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at i32-unsigned-div.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
