// Test: bool.clone
function main() returns ExitCode
	let x = true
	if x.clone() 'ok'
		return 1
	end 'ok'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
