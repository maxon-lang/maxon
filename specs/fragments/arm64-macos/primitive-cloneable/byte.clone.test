// Test: byte.clone

typealias Integer = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let x = 65 as Byte
	let y = x.clone() as Integer
	return y
end 'main'
---
ExitCode: 65
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 65
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
