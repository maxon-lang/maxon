// Test: borrowed-struct-payload-bind-leak-free
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 1000)

type Body
	export var mass as Integer

	static function create(mass Integer) returns Self
		return Self{mass: mass}
	end 'create'
end 'Body'

union Shape
	empty
	solid(body Body)
end 'Shape'

function massOf(s Shape) returns Integer
	return match s 'check'
		empty gives 1
		solid(b) gives b.mass
	end 'check'
end 'massOf'

function main() returns ExitCode
	let s = Shape.solid(Body.create(3))
	var i = 0 as Round
	var total = 0 as Integer
	while i < 300 'spin'
		total = total + massOf(s)
		i = i + 1
	end 'spin'
	if total != 900 'wrong'
		return 1
	end 'wrong'
	return 7
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#6:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x20
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b whilehdr
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#10:
    arm64.movImm x0, 1
    arm64.b __il_cont#8
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#11:
    arm64.loadRegBaseDisp.word64 x22, [x19 + 8]
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x23, [x22 + 0]
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x23
  __il_cont#8:
    arm64.add x21, x21, x0
    arm64.add x20, x20, 1
  whilehdr:
    arm64.cmp x20, 300
    arm64.b.lt __il_body#9
    arm64.b whileexit
  matchdead:
  whileexit:
    arm64.cmp x21, 900
    arm64.b.eq ifcont
  wrong:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Shape
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x20, 7
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Shape
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
