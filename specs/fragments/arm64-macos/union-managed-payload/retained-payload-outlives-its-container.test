// Test: retained-payload-outlives-its-container
union M
	silent
	text(body String)
end 'M'

function grab(m M) returns String
	return match m 'k'
		silent gives "a fallback literal long enough to be a real heap string"
		text(s) gives s
	end 'k'
end 'grab'

function makeAndExtract() returns String
	let m = M.text("the payload that must outlive its own container, heap-long")
	return grab(m)
end 'makeAndExtract'

function main() returns ExitCode
	print(makeAndExtract())
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#4:
    arm64.leaRdata x19, __str_rec_3  ; "the payload that must outlive its own container, heap-long"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#7:
    arm64.leaRdata x0, __str_rec_2  ; "a fallback literal long enough to be a real heap string"
    arm64.bl __str_retain
    arm64.movRegReg x19, x0
    arm64.b __il_cont#5
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#8:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_cont#5:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
  __il_body#2:
    arm64.movRegReg x0, x19
    arm64.bl __write_stdout
  __il_cont#1:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
