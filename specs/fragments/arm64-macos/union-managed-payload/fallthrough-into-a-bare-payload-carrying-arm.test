// Test: fallthrough-into-a-bare-payload-carrying-arm
typealias Code = int(0 to 255)

union U
	a(x Code)
	b(y Code)
end 'U'

function main() returns ExitCode
	let u = U.a(9)
	var t = 0 as Code
	match u 'k'
		a(n) then t = n and fallthrough
		b then t = t + 1
	end 'k'
	return t as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.cmp x1, 0
    arm64.b.eq matcharm
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  critsplit:
    arm64.movRegReg x0, x2
  matcharm:
    arm64.add x0, x0, 1
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at fallthrough-into-a-bare-payload-carrying-arm.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
