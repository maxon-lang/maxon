// Test: try-in-a-while-condition
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var i = 0 as Integer
	while (try [10, 20, 30].get(i) otherwise 0) > 0 'loop'
		i = i + 1
	end 'loop'
	return i
end 'main'
---
ExitCode: 3
