// Test: round.a-declaration-takes-the-name-back
typealias Tally = int(0 to 1000)

function round(n Tally) returns Tally
	return n + 1
end 'round'

function main() returns ExitCode
	return round(10)
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok#6:
    arm64.movImm x0, 11
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at round.a-declaration-takes-the-name-back.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
