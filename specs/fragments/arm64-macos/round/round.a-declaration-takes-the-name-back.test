// Test: round.a-declaration-takes-the-name-back
typealias Tally = int(0 to 1000)

function round(n Tally) returns Tally
	return n + 1
end 'round'

function main() returns ExitCode
	return round(10)
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok#6:
    arm64.movImm x0, 11
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
