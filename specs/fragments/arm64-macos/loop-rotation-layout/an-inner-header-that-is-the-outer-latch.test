// Test: an-inner-header-that-is-the-outer-latch
typealias Word = int(i64.min to i64.max)

function staircase(n Word) returns Word
	var i = 0
	var j = 0
	var t = 0
	while i < n 'outer'
		i = i + 1
		while j < i 'inner'
			t = t + j
			j = j + 1
		end 'inner'
	end 'outer'
	return t + 30
end 'staircase'

function main() returns ExitCode
	return staircase(5)
end 'main'
---
ExitCode: 40
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.b whilehdr#6
  outer:
    arm64.add x0, x0, 1
    arm64.b whilehdr#9
  inner:
    arm64.add x2, x2, x1
    arm64.add x1, x1, 1
  whilehdr#9:
    arm64.cmp x1, x0
    arm64.b.lt inner
  whilehdr#6:
    arm64.cmp x0, 5
    arm64.b.lt outer
  whileexit:
    arm64.add x0, x2, 30
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-inner-header-that-is-the-outer-latch.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
