// Test: a-while-true-whose-exit-sits-above-its-latch-is-not-rotated
typealias Small = int(0 to 100)

function spinTo(limit Small) returns Small
	var i = 0 as Small
	while true 'spin'
		i = i + 1
		if i == limit 'done'
			break
		end 'done'
	end 'spin'
	return i
end 'spinTo'

function main() returns ExitCode
	return spinTo(5) + spinTo(37)
end 'main'
---
ExitCode: 42
---
func @spinTo {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#7
  __rc_chk#8:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic#7
  __rc_ok#6:
    arm64.movImm x1, 0
  spin:
    arm64.add x1, x1, 1
    arm64.cmp x1, x0
    arm64.b.ne spin
  done:
    arm64.movRegReg x0, x1
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#10
  __rc_chk#11:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic#10
  __rc_ok#9:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-while-true-whose-exit-sits-above-its-latch-is-not-rotated.test:4: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#10:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-while-true-whose-exit-sits-above-its-latch-is-not-rotated.test:12: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl spinTo
    arm64.movRegReg x19, x0
    arm64.movImm x0, 37
    arm64.bl spinTo
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-while-true-whose-exit-sits-above-its-latch-is-not-rotated.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
