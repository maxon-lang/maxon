// Test: no-bool-to-int

typealias Integer = int(i64.min to i64.max)

function takeInt(x Integer) returns Integer
	return x
end 'takeInt'

function main() returns ExitCode
	let b = true
	return takeInt(b)
end 'main'
---
CompilerError:
error E3005: <fragment>:11:9: argument type mismatch for 'x': expected 'int', got 'bool'
