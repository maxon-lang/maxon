// Test: user-generic-inner-alias-create-carries-per-instance-identity
typealias ExitCode = int(0 to 125)

type Pair uses T
	typealias Idx = int(0 to 100)

	export var a as T

	export static function create(a T) returns Self
		return Self{a: a}
	end 'create'

	export function firstIndex() returns Idx
		return 3
	end 'firstIndex'

	export function offsetBy(i Idx) returns Idx
		return i + 1
	end 'offsetBy'
end 'Pair'

type Plain
	typealias IntPair = Pair with ExitCode

	static function make() returns ExitCode
		let p = IntPair.create(9)
		let i = p.firstIndex()
		return p.offsetBy(i)
	end 'make'
end 'Plain'

function main() returns ExitCode
	return Plain.make()
end 'main'
---
ExitCode: 4
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body#2:
    arm64.movImm x19, 9
  __il_body#9:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#11:
    arm64.movImm x19, 4
  __il_cont#6:
    arm64.bl __mm_decref
  __il_cont#1:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
