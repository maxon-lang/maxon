    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  whilehdr:
    arm64.bl make
    arm64.movRegReg x20, x0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x20 + 40]
    arm64.cmp x2, 0
    arm64.b.eq critsplit#14
  __im_empty:
    arm64.cmp x21, 0
    arm64.b.ne critsplit#15
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.movRegReg x21, x0
    arm64.b __im_cont
  critsplit#15:
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x9, x0
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.movRegReg x0, x21
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.movImm x16, 100
    arm64.mul x1, x1, x16
    arm64.cmp x19, x1
    arm64.cset x21, lt
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.cbz x21, whileexit
  loop:
    arm64.add x19, x19, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x0, 11805916207174113035
    arm64.smulh x0, x0, x19
    arm64.add x0, x0, x19
    arm64.asr x0, x0, 6
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
