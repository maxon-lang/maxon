  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at control-an-arm-giving-a-read-of-an-immutable-global.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
