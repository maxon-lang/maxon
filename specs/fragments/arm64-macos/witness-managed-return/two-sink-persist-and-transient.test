// Test: two-sink-persist-and-transient
typealias Payload = int(0 to u64.max)
typealias ChunkArray = Array with Chunk

// A managed struct returned BY VALUE from a witness-dispatched method — the plain
// (non-fat) witness-return path. Freshly created it owns rc 1.
type Chunk
	export var payload as Payload

	static function create(payload Payload) returns Chunk
		return Self{payload: payload}
	end 'create'
end 'Chunk'

interface ChunkMaker
	function makeChunk() returns Chunk
end 'ChunkMaker'

type Backend implements ChunkMaker
	export let seed as Payload

	static function create(seed Payload) returns Backend
		return Self{seed: seed}
	end 'create'

	function makeChunk() returns Chunk
		return Chunk.create(self.seed)
	end 'makeChunk'
end 'Backend'

// The long-lived sink. `populate` persists the witness-dispatched chunk into
// `self.saved` AND pushes the SAME chunk into a transient local array that is
// freed at the method's scope exit — before `main` reads `self.saved`.
type Store
	export var saved as Chunk

	static function create() returns Store
		return Self{saved: Chunk.create(0)}
	end 'create'

	function populate(maker ChunkMaker)
		var transient = ChunkArray.create()
		let chunk = maker.makeChunk()
		self.saved = chunk
		transient.push(chunk)
	end 'populate'

	function readSaved() returns Payload
		return self.saved.payload
	end 'readSaved'
end 'Store'

// Returns an INTERFACE value so the callee's static receiver type is the bare
// interface — forcing `maker.makeChunk()` to dispatch through the witness table
// rather than a monomorphized direct call.
function obtainMaker(seed Payload) returns ChunkMaker
	return Backend.create(seed)
end 'obtainMaker'

function main() returns ExitCode
	var store = Store.create()
	let maker = obtainMaker(42)
	store.populate(maker)
	print("{store.readSaved()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Chunk.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Backend.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Backend.makeChunk {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl Chunk.create
    arm64.epilogue 16
    arm64.ret
}

func @Store.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl Chunk.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Store.populate {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x20
    arm64.loadRegBaseDisp.word64 x16, [x21 + 24]
    arm64.blr x16
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x21, [x19 + 0]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @obtainMaker {
  entry:
    arm64.prologue 16
    arm64.bl Backend.create
    arm64.leaRdata x9, __witness_Backend.ChunkMaker
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Store.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 42
    arm64.bl obtainMaker
    arm64.movRegReg x20, x0
    arm64.movRegReg x21, x9
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl Store.populate
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 0]
