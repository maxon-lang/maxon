// Test: stdlib-range-panic-names-the-alias
function main() returns ExitCode
	var lead = 0
	for i in 1000000000 to 1000000000 'once'
		lead = utf16LeadSurrogate(i)
	end 'once'
	return 7 if lead > 65535 else 9
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at utf16.maxon:50: Range check failed: value outside typealias 'Codepoint'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
