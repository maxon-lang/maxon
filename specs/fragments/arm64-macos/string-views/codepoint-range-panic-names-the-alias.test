// Test: codepoint-range-panic-names-the-alias
function main() returns ExitCode
	let cp = utf16DecodeSurrogates(0, low: 0)
	return 7 if cp < 0 else 9
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at utf16.maxon:68: Range check failed: value outside typealias 'Codepoint'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
