// Test: a-managed-element-store-keeps-its-destructor-guard
typealias StringArray = Array with String

function rewrite(a StringArray)
	try a.set(0, value: "first heap string with enough bytes to be allocated") otherwise panic("rewrite: a holds an element")
	try a.set(0, value: "second heap string with enough bytes to be allocated") otherwise panic("rewrite: a holds an element")
end 'rewrite'

function main() returns ExitCode
	var a = StringArray.create()
	a.push("seed")
	rewrite(a)
	let kept = try a.get(0) otherwise ""
	if kept.count() != 52 'secondWriteLanded'
		return 1
	end 'secondWriteLanded'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @rewrite {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.leaRdata x0, __str_rec_4  ; "first heap string with enough bytes to be allocated"
    arm64.bl __str_retain
    arm64.movRegReg x2, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 40]
    arm64.cmp x0, 0
    arm64.b.ne __im_slow#6
  __im_owned#7:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow#6
  __im_bounds#8:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#6
  __im_buffer#9:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow#6
  __im_viewed#10:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.b.eq __im_store#11
  __im_slow#6:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
    arm64.b tryok#1
  __im_store#11:
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
  tryok#1:
    arm64.movImm x20, 0
    arm64.leaRdata x0, __str_rec_5  ; "second heap string with enough bytes to be allocated"
    arm64.bl __str_retain
    arm64.movRegReg x2, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 40]
    arm64.cmp x0, 0
    arm64.b.ne __im_slow#13
  __im_owned#14:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow#13
  __im_bounds#15:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#13
  __im_buffer#16:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow#13
  __im_viewed#17:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.b.eq __im_store#18
  __im_slow#13:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.b.ne tryerr#4
    arm64.b tryok#3
  __im_store#18:
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
  tryok#3:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#2:
    arm64.leaRdata x0, __str_blob_6  ; "panic at a-managed-element-store-keeps-its-destructor-guard.test:5: rewrite: a holds an element\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#4:
    arm64.leaRdata x0, __str_blob_7  ; "panic at a-managed-element-store-keeps-its-destructor-guard.test:6: rewrite: a holds an element\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_8  ; "seed"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl rewrite
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#10
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  critsplit#11:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#10:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.leaRdata x0, __str_rec_9  ; ""
  trycont:
    arm64.bl String.count
    arm64.cmp x0, 52
    arm64.b.eq ifcont
  secondWriteLanded:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
}
