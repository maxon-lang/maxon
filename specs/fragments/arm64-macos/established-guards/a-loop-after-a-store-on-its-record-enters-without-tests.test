// Test: a-loop-after-a-store-on-its-record-enters-without-tests
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function carry(count WordArray, n Word) returns Word
	try count.set(1, value: 0) otherwise panic("carry: n >= 2")
	var carried = 0
	for i in 1 upto n 'each'
		let digit = try count.get(i) otherwise panic("carry: i < n = count.count()")
		carried = carried + digit + 1
		try count.set(i, value: digit + 1) otherwise panic("carry: i < n = count.count()")
	end 'each'
	return carried
end 'carry'

function main() returns ExitCode
	var count = WordArray.create()
	count.resize(6)
	if carry(count, n: 6) != 5 'firstPass'
		return 1
	end 'firstPass'
	if carry(count, n: 6) != 9 'secondPass'
		return 2
	end 'secondPass'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @carry {
  entry:
    arm64.prologue 64
    arm64.movImm x2, 1
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 16]
    arm64.cmp x4, 0
    arm64.b.lt __im_slow#16
  __im_bounds:
    arm64.loadRegBaseDisp.word64 x4, [x0 + 8]
    arm64.cmp x4, 1
    arm64.b.ls __im_slow#16
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x4, [x0 + 0]
    arm64.cmp x4, 0
    arm64.b.eq __im_slow#16
  __im_viewed:
    arm64.sub x5, x4, 24
    arm64.loadRegBaseDisp.word64 x5, [x5 + 16]
    arm64.cmp x5, 0
    arm64.b.ne __im_slow#16
  __im_store#20:
    arm64.add x2, x4, 8
    arm64.storeBaseDispReg.word64 [x2 + 0], x3
  tryok#1:
    arm64.movImm x2, 0
    arm64.movImm x3, 1
  __us_test#46:
    arm64.loadRegBaseDisp.word64 x4, [x0 + 8]
  __us_test#47:
    arm64.loadRegBaseDisp.word64 x5, [x0 + 0]
    arm64.b forhdr
  __rc_ok:
    arm64.cmp x3, x4
    arm64.b.hs __im_slow#42
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x6, [x5 + x3*8 + 0]
  tryok#40:
    arm64.add x2, x2, x6
    arm64.add x2, x2, 1
    arm64.add x6, x6, 1
  __im_store#35:
    arm64.storeBaseIndexScaleReg.word64 [x5 + x3*8 + 0], x6
  forstep:
    arm64.add x3, x3, 1
  forhdr:
    arm64.cmp x3, x1
    arm64.b.lt __rc_ok
  forexit:
    arm64.movRegReg x0, x2
    arm64.epilogue 64
    arm64.ret
  __im_slow#16:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x3
    arm64.bl __managed_set
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-loop-after-a-store-on-its-record-enters-without-tests.test:6: carry: n >= 2\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 64
    arm64.ret
  __im_slow#42:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, x5
    arm64.movRegReg x1, x3
    arm64.bl __managed_get
    arm64.movRegReg x6, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot x5, slot5
    arm64.cmp x9, 0
    arm64.b.eq tryok#40
  tryerr#8:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-loop-after-a-store-on-its-record-enters-without-tests.test:9: carry: i < n = count.count()\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 6
    arm64.movRegReg x0, x19
    arm64.bl __managed_resize
    arm64.movImm x1, 6
    arm64.movRegReg x0, x19
    arm64.bl carry
    arm64.cmp x0, 5
    arm64.b.eq ifcont#2
  firstPass:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x1, 6
    arm64.movRegReg x0, x19
    arm64.bl carry
    arm64.cmp x0, 9
    arm64.b.eq ifcont#4
  secondPass:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
