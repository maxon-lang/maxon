// Test: cross-file-range-no-false-overlap
// --- file: ops.maxon
export union WideOp
	call
	ret
	param
	extra
end 'WideOp'

export union NarrowOp
	ret
	call
	param
end 'NarrowOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op NarrowOp) returns Code
	return match op 'check'
		ret gives 1
		call or
			param gives 2
	end 'check'
end 'classify'

function describeWide(op WideOp) returns Code
	return match op 'check'
		call or
			ret or
			param or
			extra gives 9
	end 'check'
end 'describeWide'

function main() returns ExitCode
	let narrow = classify(NarrowOp.call)
	let wide = describeWide(WideOp.ret)
	if wide == 9 'wideOk'
		return narrow
	end 'wideOk'
	return 99
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
  wideOk:
    arm64.epilogue 16
    arm64.ret
}
