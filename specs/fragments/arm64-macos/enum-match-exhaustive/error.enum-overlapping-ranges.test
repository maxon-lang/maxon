// Test: error.enum-overlapping-ranges
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.high
	match p 'check'
		low or
			medium or
			high then return 1
		medium or
			high or
			critical then return 2
	end 'check'
end 'main'
---
CompilerError:
error E2027: <fragment>:15:3: overlapping pattern in match: 'medium' is already covered
