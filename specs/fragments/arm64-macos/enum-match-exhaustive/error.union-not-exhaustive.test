// Test: error.union-not-exhaustive
union Shape
	circle
	square
	triangle
end 'Shape'

function main() returns ExitCode
	let s = Shape.circle
	match s 'check'
		circle then return 1
		square then return 2
	end 'check'
end 'main'
---
CompilerError:
error E2026: <fragment>:13:2: match on union 'Shape' is not exhaustive, missing: triangle
