// Test: survives-dead-function-elimination
// --- file: kept.maxtest
test 'is kept alive'
	throw TestFailure.assertion
end 'is kept alive'

// --- file: main.maxon
typealias ExitCode = int(0 to 125)

function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_program_started@0 = i8 0
}

func @__test_is_kept_alive {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
