// Test: a-bare-call-inside-the-type-body-reaches-a-method-an-extension-published
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer

	export static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'

	export function viaBare() returns Integer
		return tripled()
	end 'viaBare'

	export function viaSelf() returns Integer
		return self.tripled()
	end 'viaSelf'
end 'Box'

extension Box
	export function tripled() returns Integer
		return self.v * 3
	end 'tripled'
end 'Box'

function main() returns ExitCode
	let b = Box.of(5)
	return (b.viaBare() + b.viaSelf()) as ExitCode
end 'main'
---
ExitCode: 30
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.arm64AddLsl x1, x1, x1, lsl #1
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.arm64AddLsl x2, x2, x2, lsl #1
  __il_cont:
    arm64.add x19, x1, x2
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-bare-call-inside-the-type-body-reaches-a-method-an-extension-published.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
