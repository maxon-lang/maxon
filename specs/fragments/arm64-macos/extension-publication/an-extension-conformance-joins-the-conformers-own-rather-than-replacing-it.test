// Test: an-extension-conformance-joins-the-conformers-own-rather-than-replacing-it
typealias Integer = int(i64.min to i64.max)

interface Shower
	function show() returns Integer
end 'Shower'

interface Sizer
	function size() returns Integer
end 'Sizer'

type Thing implements Shower
	let value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'

	function show() returns Integer
		return value * 10
	end 'show'
end 'Thing'

extension Thing implements Sizer
	function size() returns Integer
		return value
	end 'size'
end 'Thing'

function display(s Shower) returns Integer
	return s.show()
end 'display'

function measure(s Sizer) returns Integer
	return s.size()
end 'measure'

function main() returns ExitCode
	let t = Thing.create(3)
	return (display(t) + measure(t)) as ExitCode
end 'main'
---
ExitCode: 33
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Thing.show {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @Thing.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#6:
    arm64.leaRdata x1, __witness_Thing.Shower
  __il_body#8:
    arm64.movRegReg x0, x20
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.movRegReg x19, x0
  __il_cont#5:
    arm64.leaRdata x1, __witness_Thing.Sizer
  __il_body#9:
    arm64.movRegReg x0, x20
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
  __il_cont#4:
    arm64.add x19, x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at an-extension-conformance-joins-the-conformers-own-rather-than-replacing-it.test:40: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
