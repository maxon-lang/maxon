  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-conditional-hands-the-slot-to-both-arms.test:10: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
