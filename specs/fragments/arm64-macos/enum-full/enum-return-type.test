// Test: enum-return-type
enum Result
	success
	failure
end 'Result'

function getResult(succeed bool) returns Result
	if succeed 'check'
		return Result.success
	end 'check'
	return Result.failure
end 'getResult'

function main() returns ExitCode
	let r = getResult(true)
	let result = match r 'handle'
		success gives 1
		failure gives 0
	end 'handle'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
