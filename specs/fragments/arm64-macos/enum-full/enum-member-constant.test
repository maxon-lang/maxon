// Test: enum-member-constant
enum Color
	Red
	Green
	Blue
end 'Color'

let DEFAULT_COLOR = Color.Green

function main() returns ExitCode
	match DEFAULT_COLOR 'check'
		Red then return 1
		Green then return 2
		Blue then return 3
	end 'check'
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}
