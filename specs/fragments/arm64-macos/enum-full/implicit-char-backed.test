// Test: implicit-char-backed
enum CharBacked
	'N'
	'S'
	'E'
end 'CharBacked'

function main() returns ExitCode
	let dir = CharBacked.N
	let result = match dir 'check'
		N gives 1
		S gives 0
		E gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
