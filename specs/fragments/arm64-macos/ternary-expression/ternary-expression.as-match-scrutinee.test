// Test: ternary-expression.as-match-scrutinee
function main() returns ExitCode
	let c = true
	match (1 if c else 2) 'm'
		1 then return 11
		default then return 22
	end 'm'
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 11
    arm64.epilogue 16
    arm64.ret
}
