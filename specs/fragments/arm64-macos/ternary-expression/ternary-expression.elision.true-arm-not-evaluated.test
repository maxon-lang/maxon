// Test: ternary-expression.elision.true-arm-not-evaluated
var sideEffectCount = 0

function track(result Integer) returns Integer
	sideEffectCount = sideEffectCount + 1
	return result
end 'track'

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let x = track(9) if false else 7
	if x != 7 'v'
		return 99
	end 'v'
	return sideEffectCount
end 'main'
---
ExitCode: 0
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  ternaryfalse:
    arm64.movImm x0, 7
  matchcont:
    arm64.cmp x0, 7
    arm64.b.eq ifcont
  v:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ternary-expression.elision.true-arm-not-evaluated.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
