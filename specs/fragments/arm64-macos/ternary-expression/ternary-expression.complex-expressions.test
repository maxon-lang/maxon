// Test: ternary-expression.complex-expressions
function main() returns ExitCode
	let a = 3
	let b = 2
	let cond = true
	let x = a + b if cond else a * b
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
  ternarytrue:
    arm64.movImm x0, 5
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
