// Test: get-borrows-opaque-element
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Container uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray

	export static function create() returns Self
		return Self{ items: ElementArray.create() }
	end 'create'

	export function push(item Element)
		self.items.push(item)
	end 'push'

	export function peekCount() returns Count
		try self.items.get(0) otherwise return 0
		return self.items.count()
	end 'peekCount'
end 'Container'

typealias StringContainer = Container with String

function main() returns ExitCode
	var sc = StringContainer.create()
	sc.push("a string long enough to force a heap allocation")
	let c = sc.peekCount()
	if c == 1 'stillThere'
		return 0
	end 'stillThere'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Container_String
  __il_body#6:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#5:
    arm64.leaRdata x0, __str_rec_1  ; "a string long enough to force a heap allocation"
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x0, __layout_Container_String
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movRegReg x1, x22
    arm64.bl __managed_push
  __il_cont#4:
    arm64.leaRdata x0, __layout_Container_String
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load#17:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x2, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load#18:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
  __im_loaded:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.b.eq __im_cont
  __im_empty:
    arm64.cmp x2, 0
    arm64.b.ne __im_cont
  __im_slow:
    arm64.bl __managed_get
    arm64.movRegReg x3, x9
  __im_cont:
    arm64.cmp x3, 0
    arm64.b.ne ifcont
  tryok:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 1
    arm64.b.ne ifcont
  stillThere:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Container_String
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Container_String
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
