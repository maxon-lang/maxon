// Test: slab-scavenger.an-os-direct-mapping-is-not-a-span
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var big = ByteArray.create()
	big.reserve(300000)
	for i in 0 upto 512 'fill'
		big.push((i mod 251) as Byte)
	end 'fill'

	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	var bad = 0
	for i in 0 upto 512 'check'
		let got = try big.get(i) otherwise return 1
		if got != (i mod 251) 'value'
			bad = bad + 1
		end 'value'
	end 'check'
	if bad != 0 'corrupted'
		return 2
	end 'corrupted'

	big = ByteArray.create()
	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 300000
    arm64.movRegReg x0, x19
    arm64.bl Array.reserve
    arm64.movImm x20, 0
  forhdr#1:
    arm64.cmp x20, 512
    arm64.b.ge forexit#4
  fill:
    arm64.movImm x0, 2351776136887273513
    arm64.smulh x0, x0, x20
    arm64.asr x0, x0, 5
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
    arm64.movImm x16, 251
    arm64.mul x0, x0, x16
    arm64.sub x1, x20, x0
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at slab-scavenger.an-os-direct-mapping-is-not-a-span.test:9: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.bl __slab_scavenge
    arm64.bl __slab_scavenge
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  forhdr#5:
    arm64.cmp x21, 512
    arm64.b.ge forexit#8
  check:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.b.hs __im_slow
  __im_load#24:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x21*8 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.b.hs __im_slow
  __im_load#25:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, x21
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
  __im_loaded:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 40]
    arm64.cmp x2, 0
    arm64.b.eq __im_cont
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne __im_cont
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get
    arm64.movRegReg x1, x9
  __im_cont:
    arm64.cmp x1, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 2351776136887273513
    arm64.smulh x1, x1, x21
    arm64.asr x1, x1, 5
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x16, 251
    arm64.mul x1, x1, x16
    arm64.sub x1, x21, x1
    arm64.cmp x0, x1
    arm64.b.eq critsplit
  value:
    arm64.add x0, x20, 1
    arm64.b forstep#7
  critsplit:
    arm64.movRegReg x0, x20
  forstep#7:
    arm64.add x21, x21, 1
    arm64.movRegReg x20, x0
    arm64.b forhdr#5
  forexit#8:
    arm64.cmp x20, 0
    arm64.b.eq ifcont
  corrupted:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.bl __slab_scavenge
    arm64.bl __slab_scavenge
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
