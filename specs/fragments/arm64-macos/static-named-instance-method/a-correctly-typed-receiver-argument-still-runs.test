// Test: a-correctly-typed-receiver-argument-still-runs
typealias Num = int(0 to 1000)

type Adder
	var value as Num

	static function create(v Num) returns Adder
		return Adder{value: v}
	end 'create'

	function bump() returns Num
		return self.value + 1
	end 'bump'
end 'Adder'

function main() returns ExitCode
	let a = Adder.create(41)
	return Adder.bump(a)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 41
  __rc_ok#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x19, x1, 1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#12
  __rc_chk#13:
    arm64.cmp x19, 1000
    arm64.b.gt __rc_panic#12
  __rc_chk#3:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic#2
  __rc_ok#1:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic#12:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-correctly-typed-receiver-argument-still-runs.test:12: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-correctly-typed-receiver-argument-still-runs.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
