// Test: Self-as-a-type-and-as-an-expression-base-in-one-body
enum Toggle
	off
	on

	export function same() returns Self
		return self
	end 'same'

	export function matches(other Self) returns bool
		return self == other
	end 'matches'

	export function isOff() returns bool
		return self.matches(Self.off)
	end 'isOff'
end 'Toggle'

function main() returns ExitCode
	let t = Toggle.off
	if t.isOff() 'ok'
		if t.same() == Toggle.off 'ok2'
			return 42
		end 'ok2'
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  ok2:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
