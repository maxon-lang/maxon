// Test: Self-static-called-from-an-instance-method-of-a-generic
typealias Num = int(0 to 1000)

type Holder uses T
	export var v as T

	export static function make(x T) returns Self
		return Self{v: x}
	end 'make'

	export function twin() returns T
		return Self.make(self.v).v
	end 'twin'
end 'Holder'

typealias NumHolder = Holder with Num

function main() returns ExitCode
	return NumHolder.make(42).twin()
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Holder.twin {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl Holder.make
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __retain_type_param
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __destruct_dict_Holder
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 42
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaRdata x2, __layout_Holder_Num
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl Holder.twin
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Self-static-called-from-an-instance-method-of-a-generic.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
