// Test: function-same-arg
typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Box'

function areSame(a Box, b Box) returns bool
	return a is b
end 'areSame'

function main() returns ExitCode
	let x = Box.create(42)
	let y = Box.create(42)
	var result = 0
	if areSame(x, b: x) 'same'
		result = result + 1
	end 'same'
	if areSame(x, b: y) 'diff'
		result = result + 10
	end 'diff'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 42
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 42
    arm64.bl Box.create
    arm64.movImm x1, 0
  __il_body#9:
    arm64.cmp x19, x19
    arm64.cset x2, eq
  __il_cont#8:
    arm64.cbz x2, __il_body#11
  same:
    arm64.movImm x1, 1
  __il_body#11:
    arm64.cmp x19, x0
    arm64.cset x2, eq
  __il_cont#10:
    arm64.cbz x2, critsplit
  diff:
    arm64.add x20, x1, 10
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x20, x1
  ifcont:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
