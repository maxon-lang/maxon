    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.bl __mbox_send
    arm64.movRegReg x0, x21
    arm64.bl __gt_try_await
    arm64.cmp x9, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 0
  trycont#6:
    arm64.movImm x16, 10
    arm64.mul x1, x19, x16
