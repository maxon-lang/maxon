// Test: an-unemitted-lookalike-name-is-legal
typealias Integer = int(i64.min to i64.max)

function mrt_not_a_chunk() returns Integer
	return 7
end 'mrt_not_a_chunk'

function main() returns ExitCode
	let emitted = mrt_not_a_chunk
	return emitted() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_program_started@0 = i8 0
}

func @mrt_not_a_chunk {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __fnrec_mrt_not_a_chunk
  __il_body:
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
