// Test: same-file-alias-scalar-field-off-a-temporary
typealias Num = int(0 to 1000)

type Gate
	export var n as Num

	export static function make(v Num) returns Gate
		return Gate{n: v}
	end 'make'

	export static function twice(v Num) returns Gate
		return Gate.make(v + v)
	end 'twice'
end 'Gate'

function main() returns ExitCode
	return Gate.twice(21).n
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __rc_ok#6:
    arm64.movImm x19, 42
  __rc_ok#11:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_cont:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok#1:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at same-file-alias-scalar-field-off-a-temporary.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
