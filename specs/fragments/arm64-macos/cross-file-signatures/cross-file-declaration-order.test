// Test: cross-file-declaration-order
// --- file: a-caller.maxon
function main() returns ExitCode
	if alwaysTrue() and alwaysTrue() 'both'
		return 42
	end 'both'
	return 1
end 'main'

// --- file: z-callee.maxon
export function alwaysTrue() returns bool
	return true
end 'alwaysTrue'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  both:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
