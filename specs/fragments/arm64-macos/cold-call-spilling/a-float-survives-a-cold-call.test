// Test: a-float-survives-a-cold-call
typealias Word = int(i64.min to i64.max)
typealias Real = float(f64.min to f64.max)
typealias WordArray = Array with Word

function halves(a WordArray, n Word) returns Real
	var f = 0.5
	for i in 0 upto n 'each'
		let v = try a.get(i) otherwise 8
		f = f + (v as Real) * 0.5
	end 'each'
	return f
end 'halves'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 4 'seed'
		a.push(i)
	end 'seed'
	if halves(a, n: 8) != 19.5 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @halves {
  entry:
    arm64.prologue 64
    arm64.fpLoadRdata d0, [rdata + __fconst_0.5]
    arm64.movImm x2, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x4, [x0 + 0]
  forhdr:
    arm64.cmp x2, x1
    arm64.b.ge forexit
  __rc_ok:
    arm64.cmp x2, x3
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x5, 8
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x5, [x4 + x2*8 + 0]
  trycont:
    arm64.scvtf d1, x5
    arm64.fpLoadRdata d2, [rdata + __fconst_0.5]
    arm64.fmul d1, d1, d2
    arm64.fadd d0, d0, d1
  forstep:
    arm64.add x2, x2, 1
    arm64.b forhdr
  forexit:
    arm64.epilogue 64
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, d0
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x5, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot d0, slot5
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 4
    arm64.b.ge forexit
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x1, 8
    arm64.movRegReg x0, x19
    arm64.bl halves
    arm64.fpLoadRdata d1, [rdata + __fconst_19.5]
    arm64.fcmp d0, d1
    arm64.b.eq ifcont
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
