// Test: opaque-owned-return-dropped-by-the-caller-immediately
type Holder uses Element
	export var value as Element

	export static function create(v Element) returns Self
		return Self{value: v}
	end 'create'

	export function remade() returns Element
		return fresh()
	end 'remade'
end 'Holder'

typealias TextHolder = Holder with String

function fresh() returns String
	return "a fresh string long enough to force a heap allocation"
end 'fresh'

function main() returns ExitCode
	let t = TextHolder.create("a held string long enough to force a heap allocation")
	var i = 0
	while i < 100 'spin'
		if t.remade().byteLength() == 0 'empty'
			return 1
		end 'empty'
		i = i + 1
	end 'spin'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_4  ; "a held string long enough to force a heap allocation"
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.add x22, x21, 56
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x22, x20
    arm64.storeBaseDispReg.word64 [x21 + 0], x22
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 24], x0
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.storeBaseDispReg.word64 [x19 + 0], x21
  __il_cont#6:
    arm64.movImm x20, 0
    arm64.b whilehdr
  spin:
    arm64.leaRdata x0, __layout_Holder_String
  __il_body#15:
    arm64.leaRdata x0, __str_rec_3  ; "a fresh string long enough to force a heap allocation"
    arm64.bl __str_retain
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#8:
    arm64.cmp x1, 0
    arm64.cset x21, eq
    arm64.bl __str_decref
    arm64.cbz x21, ifcont
  empty:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.add x20, x20, 1
  whilehdr:
    arm64.cmp x20, 100
    arm64.b.lt spin
  whileexit:
    arm64.leaRdata x0, __str_rec_5  ; "done\x0a"
  __il_body#11:
    arm64.bl __write_stdout
  __il_cont#10:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
