// Test: union-cond-reassign-then
typealias Integer = int(i64.min to i64.max)

union Num
	none
	val(v Integer)
end 'Num'

function pick(u Num, c Integer) returns Integer
	var q = u
	if c > 0 'b'
		q = Num.val(7)
	end 'b'
	return match q 'm'
		none gives 0
		val(v) gives v
	end 'm'
end 'pick'

function main() returns ExitCode
	let base = Num.val(5)
	return pick(base, c: 1)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
  __il_body:
    arm64.movRegReg x0, x20
    arm64.bl __mm_retain
  b:
    arm64.movImm x19, 7
    arm64.movImm x21, 1
    arm64.bl __mm_decref
  ifcont:
    arm64.cmp x21, 0
    arm64.b.ne matchnext
  matcharm:
    arm64.movImm x19, 0
    arm64.b __il_cont
  matchnext:
    arm64.cmp x21, 1
    arm64.b.ne matchdead
  __il_cont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at union-cond-reassign-then.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
