// Test: struct-reborrow-param-not-poisoned
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer

	static function create(x Integer) returns Self
		return Self{x: x}
	end 'create'
end 'Point'

function pick(p Point, c Integer) returns Integer
	var q = p
	let r = p
	if c > 0 'b'
		q = Point.create(9)
	end 'b'
	return q.x + r.x
end 'pick'

function main() returns ExitCode
	let base = Point.create(5)
	return pick(base, c: 1)
end 'main'
---
ExitCode: 14
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 5
    arm64.bl Point.create
    arm64.movRegReg x19, x0
  __il_body:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
  b:
    arm64.movImm x1, 9
    arm64.leaRegSlot x20, slot0
    arm64.storeBaseDispReg.word64 [x20 + 0], x1
    arm64.bl __mm_decref
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.add x20, x0, x1
  __il_cont:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at struct-reborrow-param-not-poisoned.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
