    arm64.loadRegBaseDisp.word64 d1, [x0 + 8]
    arm64.fmul d0, d0, d1
  __il_cont#4:
    arm64.fcvtzs x19, d0
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
