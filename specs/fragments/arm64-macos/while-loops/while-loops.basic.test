// Test: while-loops.basic
function main() returns ExitCode
	var x = 5
	var i = 3
	while i > 0 'loop'
		x = x + 2
		i = i - 1
		if i == 0 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.movImm x1, 3
  whilehdr:
    arm64.cmp x1, 0
    arm64.b.le whileexit
  loop:
    arm64.add x0, x0, 2
    arm64.sub x1, x1, 1
    arm64.cmp x1, 0
    arm64.b.ne whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at while-loops.basic.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
