// Test: while-loops.sequential-loops-across-a-call
function work(x Integer) returns Integer
	return x + 1
end 'work'

function big(n Integer) returns Integer
	var total = 0
	var a = 1
	var i0 = 0
	while i0 < n 'L0'
		let r = work(i0)
		a = a + r
		i0 = i0 + 1
	end 'L0'
	total = total + a
	var b = 1
	var i1 = 0
	while i1 < n 'L1'
		let s = work(i1)
		b = b + s
		i1 = i1 + 1
	end 'L1'
	total = total + b
	return total
end 'big'

function main() returns ExitCode
	return big(3)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 14
---
func @main {
  entry:
    arm64.prologue 16
  __il_body#5:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.b whilehdr#6
  __il_body#13:
    arm64.add x1, x1, 1
  __il_cont#12:
    arm64.add x0, x0, x1
  whilehdr#6:
    arm64.cmp x1, 3
    arm64.b.lt __il_body#13
  whileexit#8:
    arm64.movImm x1, 1
    arm64.movImm x2, 0
    arm64.b whilehdr#9
  __il_body#15:
    arm64.add x2, x2, 1
  __il_cont#14:
    arm64.add x1, x1, x2
  whilehdr#9:
    arm64.cmp x2, 3
    arm64.b.lt __il_body#15
  whileexit#11:
    arm64.add x0, x0, x1
  __il_cont#4:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at while-loops.sequential-loops-across-a-call.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
