// Test: owned-struct-in-block
type Box
	export var v as Integer

	static function create(v Integer) returns Box
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var i = 0
	var seen = 0
	while i < 3 'loop'
		if i < 2 'b'
			let b = Box.create(i)
			seen = seen + b.v
		end 'b'
		i = i + 1
	end 'loop'
	return 0 if seen == 1 else 1
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  loop:
    arm64.cmp x19, 2
    arm64.b.ge critsplit
  __il_body:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_cont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x20, x20, x1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x20
  ifcont:
    arm64.add x19, x19, 1
    arm64.movRegReg x20, x0
  whilehdr:
    arm64.cmp x19, 3
    arm64.b.lt loop
  whileexit:
    arm64.cmp x20, 1
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x0, 0
    arm64.b __rc_ok
  ternaryfalse:
    arm64.movImm x0, 1
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
