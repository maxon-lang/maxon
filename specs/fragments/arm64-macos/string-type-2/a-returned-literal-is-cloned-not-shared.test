// Test: a-returned-literal-is-cloned-not-shared
function lit() returns String
	return "ab"
end 'lit'

function main() returns ExitCode
	var first = lit()
	first.append("XY")
	let second = lit()
	print("first={first} second={second}\n")
	return 0
end 'main'
