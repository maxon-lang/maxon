// Test: string-substring-not-found
function main() returns ExitCode
	let s = "hello world"
	if s.contains("xyz") 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "hello world"
    arm64.leaRdata x2, __str_rec_3  ; "xyz"
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#5:
    arm64.bl needleOccursIn
  __il_cont#3:
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
