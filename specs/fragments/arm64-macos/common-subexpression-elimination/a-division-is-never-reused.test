// Test: a-division-is-never-reused
typealias Word = int(i64.min to i64.max)
// The divisor's type excludes zero, but a NEGATIVE dividend needs a signed division, which is spelled only
// through a `Word` divisor the compiler must treat as possibly zero — hence the `try`. The op is still impure.
typealias NonZeroWord = int(1 to i64.max)

function halves(a Word, b NonZeroWord) returns Word
	return (try (a / (b as Word)) otherwise panic("b is never zero")) + (try (a / (b as Word)) otherwise panic("b is never zero")) + (try (a mod (b as Word)) otherwise panic("b is never zero")) + (try (a mod (b as Word)) otherwise panic("b is never zero"))
end 'halves'

function main() returns ExitCode
	if halves(17, b: 5) != 10 'quotientAndRemainder'
		return 1
	end 'quotientAndRemainder'
	if halves(-17, b: 5) != -10 'negativeTruncatesTowardZero'
		return 2
	end 'negativeTruncatesTowardZero'
	return 0
end 'main'
---
ExitCode: 0
---
func @halves {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 1
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.sdiv x2, x0, x1
  tryok#1:
    arm64.sdiv x3, x0, x1
  tryok#3:
    arm64.add x2, x2, x3
    arm64.movImm x3, 0
    arm64.add x3, x3, -1
    arm64.and x3, x0, x3
    arm64.sdiv x16, x3, x1
    arm64.msub x3, x16, x1, x3
  tryok#5:
    arm64.add x2, x2, x3
    arm64.movImm x3, 0
    arm64.add x3, x3, -1
    arm64.and x0, x0, x3
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
  tryok#7:
    arm64.add x0, x2, x0
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-division-is-never-reused.test:7: Range check failed: value outside typealias 'NonZeroWord'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 17
    arm64.movImm x1, 5
    arm64.bl halves
    arm64.cmp x0, 10
    arm64.b.eq ifcont#2
  quotientAndRemainder:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 18446744073709551599
    arm64.movImm x1, 5
    arm64.bl halves
    arm64.cmp x0, -10
    arm64.b.eq ifcont#4
  negativeTruncatesTowardZero:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
