// Test: streams-are-separate
function main() returns ExitCode
	print("out\n")
	printError("err\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "out\x0a"
  __il_body#3:
    arm64.bl __write_stdout
  __il_cont#2:
    arm64.leaRdata x0, __str_rec_3  ; "err\x0a"
  __il_body#4:
    arm64.bl __write_stderr
  __il_cont#1:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
