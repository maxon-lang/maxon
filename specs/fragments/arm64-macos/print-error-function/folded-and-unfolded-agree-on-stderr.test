    arm64.epilogue 48
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_5  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
