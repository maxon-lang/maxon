  __il_cont#12:
    arm64.movRegReg x0, x20
    arm64.bl __write_stderr
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic#11
  __il_cont#8:
    arm64.add x0, x19, x21
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#2
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#2
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_6  ; "panic at Builtins.maxon:4: Range check failed: value outside typealias 'WrittenBytes'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic#11:
