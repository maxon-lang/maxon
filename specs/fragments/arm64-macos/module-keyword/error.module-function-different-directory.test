// Test: error.module-function-different-directory
// --- file: dir_a/helper.maxon
typealias Integer = int(i64.min to i64.max)

module function helper() returns Integer
	return 42
end 'helper'

// --- file: dir_b/main.maxon
function main() returns ExitCode
	return helper()
end 'main'
---
CompilerError:
error E3088: dir_b/<fragment>:11:9: function 'helper' is module-scoped and not visible from this directory
