// Test: filepath-equality
function main() returns ExitCode
	let a = FilePath from "C:\\test.txt"
	let b = FilePath from "C:\\test.txt"
	if a == b 'eq'
		print("equal\n")
	end 'eq'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_18  ; "C:\\test.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_18  ; "C:\\test.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl FilePath.equals
    arm64.cbz x0, ifcont
  eq:
    arm64.leaRdata x0, __str_rec_19  ; "equal\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
