// Test: atan2.origin
function main() returns ExitCode
	let angle = Math.atan2(0.0, x: 0.0)
	print("{angle}\n")
	// Origin is typically 0
	if angle == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
