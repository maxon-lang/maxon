// Test: match-gives-same-type
function main() returns ExitCode
	let c = 0
	let r = match c 'pick'
		0 gives 10
		default gives 20
	end 'pick'
	return r
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 10
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
