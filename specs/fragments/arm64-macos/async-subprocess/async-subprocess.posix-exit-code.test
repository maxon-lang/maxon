func @runChild {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "exit 3"
    arm64.bl __gt_process_run
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 99
  trycont:
    arm64.epilogue 16
