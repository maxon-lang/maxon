// Test: contains-on-a-generic-conformer
typealias Int = int(i64.min to i64.max)

type BagIter uses Element implements Iterator with Element
	var slot as Element

	export static function create(v Element) returns Self
		return Self{slot: v}
	end 'create'

	export function current() returns Element
		return slot
	end 'current'

	export function advance() throws IterationError
		throw IterationError.exhausted
	end 'advance'
end 'BagIter'

type Bag uses Element implements Iterable with (Element, BagIter)
	var slot as Element

	export static function create(v Element) returns Self
		return Self{slot: v}
	end 'create'

	export function createIterator() returns BagIter throws IterationError
		return BagIter.create(slot)
	end 'createIterator'
end 'Bag'

typealias IntBag = Bag with Int

function isBig(n Int) returns bool
	return n > 10
end 'isBig'

function main() returns ExitCode
	var b = IntBag.create(30)
	if b.contains(isBig) 'yes'
		return 1
	end 'yes'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @BagIter.advance {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @Bag.createIterator {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
  __il_body:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_cont:
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @isBig {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 10
    arm64.cset x0, gt
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 30
  __il_body#4:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#3:
    arm64.leaFuncAddr x19, __fnref_isBig
    arm64.movImm x21, 0
    arm64.leaRdata x22, __layout_Bag_Int
  __il_body#6:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.bl Bag.createIterator
    arm64.movRegReg x23, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.eq forhdr
    arm64.b forjoin
  __il_body#16:
    arm64.loadRegBaseDisp.word64 x1, [x23 + 0]
    arm64.movRegReg x0, x22
    arm64.bl __retain_type_param
    arm64.movRegReg x24, x0
  __il_cont#15:
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.blr x19
    arm64.cbz x0, ifcont#13
  match:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x24
    arm64.bl __drop_type_param
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b __il_cont#5
  ifcont#13:
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x24
    arm64.bl __drop_type_param
  forstep:
    arm64.movRegReg x0, x23
    arm64.bl BagIter.advance
    arm64.movRegReg x0, x9
  forhdr:
    arm64.cmp x0, 0
    arm64.b.eq __il_body#16
  forexit:
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
  forjoin:
    arm64.movImm x0, 0
  __il_cont#5:
    arm64.cbz x0, ifcont#2
  yes:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont#2:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
