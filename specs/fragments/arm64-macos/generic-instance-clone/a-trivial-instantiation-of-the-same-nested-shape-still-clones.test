// Test: a-trivial-instantiation-of-the-same-nested-shape-still-clones
typealias Idx = int(0 to u64.max)
typealias Small = int(0 to 100)

type Bag uses Element
	typealias Inner = Array with Element
	typealias Outer = Array with Inner
	var rows as Outer

	export function addRow(r Inner)
		rows.push(r)
	end 'addRow'

	export function copyRows() returns Outer
		return rows.clone()
	end 'copyRows'

	export function count() returns Idx
		return rows.count()
	end 'count'

	static function create() returns Self
		return Self{rows: Outer{}}
	end 'create'
end 'Bag'

typealias SmallBag = Bag with Small
typealias Smalls = Array with Small

function main() returns ExitCode
	var b = SmallBag.create()
	var r = Smalls.create()
	r.push(41)
	b.addRow(r)
	let c = b.copyRows()
	print("{c.count()}\n")
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.addRow {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_push
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Bag.copyRows {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x1, __layout_Array_Bag.Inner
    arm64.bl Array.clone
    arm64.epilogue 16
    arm64.ret
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Bag.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 41
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.leaRdata x2, __layout_Bag_Small
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Bag.addRow
    arm64.leaRdata x1, __layout_Bag_Small
    arm64.movRegReg x0, x19
    arm64.bl Bag.copyRows
    arm64.movRegReg x21, x0
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
