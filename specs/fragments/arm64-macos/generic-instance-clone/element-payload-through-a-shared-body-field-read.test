// Test: element-payload-through-a-shared-body-field-read
typealias Integer = int(i64.min to i64.max)

type Box uses T
	export var v as T
	export var tag as Integer

	export static function create(x T, tag Integer) returns Self
		return Self{v: x, tag: tag}
	end 'create'
end 'Box'

type Bag uses Element
	typealias EBox = Box with Element
	typealias EBoxArray = Array with EBox

	export var items as EBoxArray

	export static function create() returns Self
		return Self{items: EBoxArray.create()}
	end 'create'

	export function add(x Element, tag Integer)
		self.items.push(EBox.create(x, tag: tag))
	end 'add'

	export function copy() returns EBoxArray
		return self.items.clone()
	end 'copy'
end 'Bag'

typealias IntBag = Bag with Integer

function main() returns ExitCode
	var b = IntBag.create()
	b.add(91, tag: 4)

	let c = b.items
	let e = try c.get(0) otherwise return 90
	return 4 as ExitCode if e.v.equals(91) else 70 as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.add {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl Box.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Bag.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 91
    arm64.movImm x2, 4
    arm64.leaRdata x3, __layout_Bag_Integer
    arm64.movRegReg x0, x19
    arm64.bl Bag.add
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __managed_retain
    arm64.movRegReg x20, x0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x20 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#12
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#13
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#13:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#12:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x21, 90
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Integer
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  __il_body:
    arm64.cmp x0, 91
    arm64.cset x0, eq
  __il_cont:
    arm64.cbz x0, ternaryfalse
  ternarytrue:
    arm64.movImm x21, 4
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x21, 70
  matchcont:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Integer
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
