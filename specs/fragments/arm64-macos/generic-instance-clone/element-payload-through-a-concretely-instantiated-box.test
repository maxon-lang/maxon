// Test: element-payload-through-a-concretely-instantiated-box
typealias Integer = int(i64.min to i64.max)

type Box uses T
	export var v as T
	export var tag as Integer

	export static function create(x T, tag Integer) returns Self
		return Self{v: x, tag: tag}
	end 'create'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	let b = IntBox.create(91, tag: 4)
	return 4 as ExitCode if b.v.equals(91) else 70 as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 91
  __il_body:
    arm64.cmp x0, 91
    arm64.cset x0, eq
  __il_cont:
    arm64.cbz x0, ternaryfalse
  ternarytrue:
    arm64.movImm x0, 4
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 70
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
