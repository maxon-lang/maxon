// Test: a-candidate-inside-an-orphaned-region
typealias Word = int(i64.min to i64.max)

function f(p bool, q bool, n Word) returns Word
	var flag = 0
	if p 'a'
		flag = 0
	end 'a' else 'b'
		flag = 0
	end 'b'
	if flag != 0 'nz'
		var g = 0
		if q 'c'
			g = 0
		end 'c' else 'd'
			g = n
		end 'd'
		if g != 0 'gz'
			return 1
		end 'gz'
		return 3
	end 'nz'
	return 2
end 'f'

function main() returns ExitCode
	var t = 0
	for i in 0 upto 4 'each'
		t = t + f(i mod 2 == 0, q: i > 1, n: i)
	end 'each'
	if t != 8 'total'
		return 1
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
func @f {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, ifcont
  ifcont:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 4
    arm64.b.ge forexit
  each:
    arm64.asr x0, x20, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x20, x0
    arm64.asr x0, x0, 1
    arm64.lsl x0, x0, 1
    arm64.sub x0, x20, x0
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cmp x20, 1
    arm64.cset x1, gt
    arm64.movRegReg x2, x20
    arm64.bl f
    arm64.add x19, x19, x0
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x19, 8
    arm64.b.eq ifcont
  total:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
