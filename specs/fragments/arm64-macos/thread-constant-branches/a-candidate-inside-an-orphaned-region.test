// Test: a-candidate-inside-an-orphaned-region
typealias Word = int(i64.min to i64.max)

function f(p bool, q bool, n Word) returns Word
	var flag = 0
	if p 'a'
		flag = 0
	end 'a' else 'b'
		flag = 0
	end 'b'
	if flag != 0 'nz'
		var g = 0
		if q 'c'
			g = 0
		end 'c' else 'd'
			g = n
		end 'd'
		if g != 0 'gz'
			return 1
		end 'gz'
		return 3
	end 'nz'
	return 2
end 'f'

function main() returns ExitCode
	var t = 0
	for i in 0 upto 4 'each'
		t = t + f(i mod 2 == 0, q: i > 1, n: i)
	end 'each'
	if t != 8 'total'
		return 1
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr
  each:
    arm64.asr x2, x1, 63
    arm64.lsr x2, x2, 63
    arm64.add x2, x1, x2
    arm64.asr x2, x2, 1
    arm64.lsl x2, x2, 1
    arm64.sub x2, x1, x2
    arm64.cmp x2, 0
    arm64.cset x2, eq
    arm64.cmp x1, 1
  __il_body:
    arm64.cbnz x2, __il_cont
  __il_cont:
    arm64.add x0, x0, 2
  forstep:
    arm64.add x1, x1, 1
  forhdr:
    arm64.cmp x1, 4
    arm64.b.lt each
  forexit:
    arm64.cmp x0, 8
    arm64.b.eq ifcont
  total:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
