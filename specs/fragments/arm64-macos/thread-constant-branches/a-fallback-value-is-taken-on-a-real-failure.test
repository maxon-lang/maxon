// Test: a-fallback-value-is-taken-on-a-real-failure
typealias Word = int(i64.min to i64.max)
typealias Idx = int(0 to u64.max)
typealias WordArray = Array with Word

function pickOr(a WordArray, i Idx) returns Word
	return try a.get(i) otherwise 99
end 'pickOr'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 5 'seed'
		a.push(i)
	end 'seed'
	var t = 0
	for i in 0 upto 9 'sum'
		t = t + pickOr(a, i: i)
	end 'sum'
	if t != 406 'total'
		return 1
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pickOr {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x0, 99
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  trycont:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-fallback-value-is-taken-on-a-real-failure.test:6: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __im_slow:
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr#1:
    arm64.cmp x20, 5
    arm64.b.ge forexit#4
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  forhdr#5:
    arm64.cmp x21, 9
    arm64.b.ge forexit#8
  sum:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl pickOr
    arm64.add x20, x20, x0
  forstep#7:
    arm64.add x21, x21, 1
    arm64.b forhdr#5
  forexit#8:
    arm64.cmp x20, 406
    arm64.b.eq ifcont
  total:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
