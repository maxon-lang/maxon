// Test: a-write-in-a-loop-keeps-its-slow-arm
typealias Word = int(i64.min to i64.max)
typealias Idx = int(0 to u64.max)
typealias WordArray = Array with Word

function put(a WordArray, i Idx, v Word) returns bool
	try a.set(i, value: v) otherwise return false
	return true
end 'put'

function main() returns ExitCode
	var a = WordArray.create()
	a.resize(4)
	var stored = 0
	for i in 0 upto 5 'each'
		if put(a, i: i, v: i * 10) 'ok'
			stored = stored + 1
		end 'ok'
	end 'each'
	if stored != 4 'count'
		return 1
	end 'count'
	var seen = 0
	for v in a 'check'
		seen = seen + v
	end 'check'
	if seen != 60 'sum'
		return 2
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x20
    arm64.storeSlotReg slot4, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_resize
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  __us_test#41:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 16]
    arm64.cmp x2, 0
    arm64.b.lt forhdr#1
  __us_test#42:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.cmp x3, 0
    arm64.b.eq forhdr#1
  __us_test#43:
    arm64.sub x4, x3, 24
    arm64.loadRegBaseDisp.word64 x4, [x4 + 16]
    arm64.cmp x4, 0
    arm64.b.ne forhdr#1
    arm64.b forhdr#26
  each#2:
    arm64.movImm x16, 10
    arm64.mul x2, x1, x16
  __il_body:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 16]
    arm64.cmp x3, 0
    arm64.b.lt __im_slow#21
  __im_bounds#22:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 8]
    arm64.cmp x1, x3
    arm64.b.hs __im_slow#21
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.cmp x3, 0
    arm64.b.eq __im_slow#21
  __im_viewed:
    arm64.sub x4, x3, 24
    arm64.loadRegBaseDisp.word64 x4, [x4 + 16]
    arm64.cmp x4, 0
    arm64.b.ne __im_slow#21
    arm64.b __im_store#25
  tryerr#18:
    arm64.movImm x2, 0
    arm64.b __il_cont#16
  __im_store#25:
    arm64.storeBaseIndexScaleReg.word64 [x3 + x1*8 + 0], x2
  tryok#17:
    arm64.movImm x2, 1
  __il_cont#16:
    arm64.cbz x2, forstep#3
  ok#5:
    arm64.add x0, x0, 1
  forstep#3:
    arm64.add x1, x1, 1
  forhdr#1:
    arm64.cmp x1, 5
    arm64.b.lt each#2
    arm64.b forexit#4
  each#38:
    arm64.movImm x16, 10
    arm64.mul x4, x1, x16
  __im_bounds#35:
    arm64.cmp x1, x2
    arm64.b.hs __im_slow#33
    arm64.b __im_store#40
  tryerr#32:
    arm64.movImm x4, 0
    arm64.b __il_cont#30
  __im_store#40:
    arm64.storeBaseIndexScaleReg.word64 [x3 + x1*8 + 0], x4
  tryok#31:
    arm64.movImm x4, 1
  __il_cont#30:
    arm64.cbz x4, forstep#27
  ok#29:
    arm64.add x0, x0, 1
  forstep#27:
    arm64.add x1, x1, 1
  forhdr#26:
    arm64.cmp x1, 5
    arm64.b.lt each#38
  forexit#4:
    arm64.cmp x0, 4
    arm64.b.eq ifcont#8
  count:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.b forhdr#9
  check:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x0, x0, x4
  forstep#11:
    arm64.add x1, x1, 1
  forhdr#9:
    arm64.cmp x1, x2
    arm64.b.lt check
  forexit#12:
    arm64.cmp x0, 60
    arm64.b.eq ifcont#14
  sum:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont#14:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
  __im_slow#21:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.ne tryerr#18
    arm64.b tryok#17
  __im_slow#33:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.movRegReg x0, x19
    arm64.movRegReg x2, x4
    arm64.bl __managed_set
    arm64.movRegReg x4, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.cmp x9, 0
    arm64.b.ne tryerr#32
    arm64.b tryok#31
}
