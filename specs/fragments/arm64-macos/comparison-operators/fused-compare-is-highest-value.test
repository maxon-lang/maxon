// Test: fused-compare-is-highest-value
function main() returns ExitCode
	let a = 7
	let b = 3
	if a < b 'lt'
		return b
	end 'lt'
	return a
end 'main'
---
ExitCode: 7
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
