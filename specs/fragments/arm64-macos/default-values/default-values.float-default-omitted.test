// Test: default-values.float-default-omitted
typealias Number = float(f64.min to f64.max)

function scale(factor Number = 2.5) returns ExitCode
	print("{factor}")
	return 0
end 'scale'

function main() returns ExitCode
	return scale()
end 'main'
