// Test: negative
function main() returns ExitCode
	let result = Math.exp(-1.0)  // e^-1 ≈ 0.368
	return trunc(result)
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  neg:
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
  ifcont:
    arm64.movImm x0, 0
    arm64.b whilehdr#14
  reduce:
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fdiv d0, d0, d1
    arm64.add x0, x0, 1
  whilehdr#14:
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.b.gt reduce
  whileexit#16:
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fpLoadRdata d2, [rdata + __fconst_1]
    arm64.fpLoadRdata d3, [rdata + __fconst_1]
    arm64.fpLoadRdata d4, [rdata + __fconst_20]
    arm64.b whilehdr#17
  series:
    arm64.fmul d1, d1, d0
    arm64.fpLoadRdata d5, [rdata + __fconst_0]
    arm64.fcmp d3, d5
    arm64.cset x1, eq
    arm64.fdiv d1, d1, d3
    arm64.cmp x1, 0
    arm64.b.ne tryerr#21
  tryok:
    arm64.fadd d2, d2, d1
    arm64.fpLoadRdata d5, [rdata + __fconst_1]
    arm64.fadd d3, d3, d5
  whilehdr#17:
    arm64.fcmp d3, d4
    arm64.b.mi series
  whileexit#19:
    arm64.movImm x1, 0
    arm64.b forhdr
  square:
    arm64.fmul d2, d2, d2
  forstep:
    arm64.add x1, x1, 1
  forhdr:
    arm64.cmp x1, x0
    arm64.b.lt square
  invert:
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d2, d1
    arm64.cset x0, eq
    arm64.fdiv d0, d0, d2
    arm64.cmp x0, 0
    arm64.b.ne tryerr#28
  __il_cont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  tryerr#21:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Math.maxon:237: exp series divisor k is >= 1\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryerr#28:
    arm64.leaRdata x0, __str_blob_1  ; "panic at Math.maxon:253: exp result is >= 1 before inversion\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at negative.test:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
