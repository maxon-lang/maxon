// Test: nested-calls

typealias Integer = int(i64.min to i64.max)

function double(x Integer) returns Integer
	return x * 2
end 'double'

function quadruple(x Integer) returns Integer
	return double(double(x))
end 'quadruple'

function main() returns ExitCode
	return quadruple(3)
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 12
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
