// Test: field-defaults.function-call-default
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Bag
	export var items as IntArray = IntArray.create()

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Bag'

function main() returns ExitCode
	var b = Bag.create()
	b.items.push(42)
	let v = try b.items.get(0) otherwise 0
	return v
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __fieldDefault#Bag#items
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Bag.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 42
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.b.eq critsplit#11
  __im_empty:
    arm64.cmp x2, 0
    arm64.b.ne critsplit#12
  __im_slow:
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#12:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  critsplit#11:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at field-defaults.function-call-default.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @__fieldDefault#Bag#items {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.epilogue 16
    arm64.ret
}
