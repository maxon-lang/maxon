// Test: array-and-of-are-ordinary-identifiers
typealias StdType = int(i64.min to i64.max)

function repeated(array StdType, of StdType) returns StdType
	return array * of
end 'repeated'

function main() returns ExitCode
	let array = 6
	let of = 7
	return repeated(array, of: of)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
