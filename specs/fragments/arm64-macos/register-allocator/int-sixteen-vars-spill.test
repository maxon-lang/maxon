// Test: int-sixteen-vars-spill
function main() returns ExitCode
	let a = 1
	let b = 2
	let c = 3
	let d = 4
	let e = 5
	let f = 6
	let g = 7
	let h = 8
	let i = 9
	let j = 10
	let k = 11
	let l = 12
	let m = 13
	let n = 14
	let o = 15
	let p = 16
	return (a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p) and 125
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
