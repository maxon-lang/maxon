// Test: int-nested-if-in-loop
function main() returns ExitCode
	var result = 0
	var i = 1
	while i <= 10 'loop'
		if i <= 5 'first'
			result = result + i
		end 'first' else 'second'
			result = result + i * 2
		end 'second'
		i = i + 1
	end 'loop'
	return result mod 256
end 'main'
---
ExitCode: 95
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
  whilehdr:
    arm64.cmp x1, 10
    arm64.b.gt whileexit
  loop:
    arm64.cmp x1, 5
    arm64.b.gt ifelse
  first:
    arm64.add x0, x0, x1
    arm64.b ifcont
  ifelse:
    arm64.arm64AddLsl x0, x0, x1, lsl #1
  ifcont:
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 56
    arm64.add x1, x0, x1
    arm64.asr x1, x1, 8
    arm64.lsl x1, x1, 8
    arm64.sub x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-nested-if-in-loop.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
