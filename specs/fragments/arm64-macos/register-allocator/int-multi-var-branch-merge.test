// Test: int-multi-var-branch-merge
function main() returns ExitCode
	var x = 0
	var y = 0
	var z = 0
	if 1 < 2 'branch'
		x = 10
		y = 20
		z = 12
	end 'branch' else 'other'
		x = 1
		y = 2
		z = 3
	end 'other'
	return x + y + z
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  ifcont:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
