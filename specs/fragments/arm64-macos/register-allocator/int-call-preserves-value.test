// Test: int-call-preserves-value

typealias Integer = int(i64.min to i64.max)

function getForty() returns Integer
	return 40
end 'getForty'

function main() returns ExitCode
	let x = 2
	let y = getForty()
	return x + y
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
  __il_cont:
    arm64.add x0, x0, 40
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
