// Test: match-expression-or-patterns
function main() returns ExitCode
	let x = 4
	let result = match x 'eval'
		1 or
			2 gives 10
		3 or
			4 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 20
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
