// Test: match-statement-assignment
function main() returns ExitCode
	let x = 2
	var result = 0
	match x 'process'
		1 then result = 100
		2 then result = 200
		default then result = 0
	end 'process'
	return result and 125
end 'main'
---
ExitCode: 72
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 200
  matchcont:
    arm64.movImm x16, 125
    arm64.and x0, x0, x16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
