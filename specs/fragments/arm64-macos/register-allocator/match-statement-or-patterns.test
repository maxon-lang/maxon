// Test: match-statement-or-patterns
function main() returns ExitCode
	let x = 3
	match x 'check'
		1 or
			2 then return 10
		3 or
			4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 20
    arm64.epilogue 16
    arm64.ret
}
