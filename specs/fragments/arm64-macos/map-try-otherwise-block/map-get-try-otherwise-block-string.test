  entry:
    arm64.prologue 16
    arm64.leaRdata x2, __layout_Map_String_String
    arm64.leaRdata x3, __witness_String.Hashable
    arm64.leaRdata x4, __witness_String.Equatable
    arm64.bl Map.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

