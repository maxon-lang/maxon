// Test: a-byte-stamp-keeps-the-runtime-fork
typealias Byte = int(0 to 255)
typealias Total = int(0 to u64.max)

function sumBytes(b ByteArray) returns Total
	var t = 0
	for v in b 'loop'
		t = t + v
	end 'loop'
	return t
end 'sumBytes'

function main() returns ExitCode
	var b = ByteArray.create()
	for i in 0 upto 10 'seed'
		b.push(i as Byte)
	end 'seed'
	if sumBytes(b) != 45 'sum'
		return 1
	end 'sum'
	try b.set(3, value: 200) otherwise panic("set: index out of range")
	if (try b.get(3) otherwise panic("get: index out of range")) != 200 'written'
		return 2
	end 'written'
	if b.count() != 10 'count'
		return 3
	end 'count'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
  forhdr#1:
    arm64.cmp x20, 10
    arm64.b.lt seed
  __il_body:
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x22, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x23, [x19 + 24]
    arm64.loadRegBaseDisp.word64 x24, [x19 + 0]
    arm64.b forhdr#38
  loop:
    arm64.cmp x23, 8
    arm64.b.ne __im_stride#48
  __im_word#46:
    arm64.loadRegBaseIndexScale.word64 x0, [x24 + x21*8 + 0]
    arm64.b __im_cont
  __im_stride#48:
    arm64.cmp x23, 1
    arm64.b.ne __im_slow#45
  __im_byte#47:
    arm64.add x0, x24, x21
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b __im_cont
  __im_slow#45:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
  __im_cont:
    arm64.add x20, x20, x0
  forstep#40:
    arm64.add x21, x21, 1
  forhdr#38:
    arm64.cmp x21, x22
    arm64.b.lt loop
  forexit:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __il_cont:
    arm64.cmp x20, 45
    arm64.b.eq ifcont#6
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont#6:
    arm64.movImm x1, 3
    arm64.movImm x2, 200
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride#19
  __im_word#17:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow#16
  __im_bounds#20:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 3
    arm64.b.ls __im_slow#16
  __im_buffer#21:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow#16
  __im_viewed#22:
    arm64.sub x3, x0, 24
    arm64.loadRegBaseDisp.word64 x3, [x3 + 16]
    arm64.cmp x3, 0
    arm64.b.ne __im_slow#16
  __im_store#23:
    arm64.add x0, x0, 24
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
    arm64.b tryok#7
  __im_stride#19:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow#16
  __im_byte#18:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow#16
  __im_bounds#24:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 3
    arm64.b.ls __im_slow#16
  __im_buffer#25:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow#16
  __im_viewed#26:
    arm64.sub x3, x0, 24
    arm64.loadRegBaseDisp.word64 x3, [x3 + 16]
    arm64.cmp x3, 0
    arm64.b.ne __im_slow#16
  __im_store#27:
    arm64.add x0, x0, 3
    arm64.storeBaseDispReg.byte [x0 + 0], x2
    arm64.b tryok#7
  __im_slow#16:
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.b.ne tryerr#8
  tryok#7:
    arm64.movImm x1, 3
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride#32
  __im_load#34:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 24
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b tryok#9
  __im_stride#32:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow#29
  __im_load#35:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 3
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b tryok#9
  __im_slow#29:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr#10
  tryok#9:
    arm64.cmp x0, 200
    arm64.b.eq ifcont#12
  written:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont#12:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 10
    arm64.b.eq ifcont#14
  count:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont#14:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-byte-stamp-keeps-the-runtime-fork.test:10: Range check failed: value outside typealias 'Total'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  tryerr#8:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-byte-stamp-keeps-the-runtime-fork.test:21: set: index out of range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
