// Test: default-param-omitted

typealias Integer = int(i64.min to i64.max)

function repeat(value Integer, times Integer = 2) returns Integer
	return value * times
end 'repeat'

function main() returns ExitCode
	return repeat(21)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
