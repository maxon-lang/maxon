// Test: named-args

typealias Integer = int(i64.min to i64.max)

function add(a Integer, b Integer) returns Integer
	return a + b
end 'add'

function main() returns ExitCode
	return add(3, b: 4)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
