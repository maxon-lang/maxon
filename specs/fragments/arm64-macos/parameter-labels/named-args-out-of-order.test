// Test: named-args-out-of-order
typealias Num = int(0 to 100)

function pick(a Num, b String, c bool) returns Num
	if c 'isTrue'
		return a
	end 'isTrue'
	return b.byteLength() as Num
end 'pick'

function main() returns ExitCode
	return pick(1, c: true, b: "longer")
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.leaRdata x1, __str_rec_1  ; "longer"
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
