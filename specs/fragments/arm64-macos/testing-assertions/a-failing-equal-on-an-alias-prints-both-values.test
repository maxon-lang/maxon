// Test: a-failing-equal-on-an-alias-prints-both-values
// --- file: main.maxon
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let i = 5 as Integer
	try Expect.equal(i, expected: 6) otherwise ignore

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
    arm64.movImm x20, 6
  __il_body:
    arm64.leaRdata x0, __str_rec_27  ; ""
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
  __il_cont:
    arm64.leaRdata x3, __str_rec_14  ; "main.maxon"
    arm64.movImm x4, 5
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl Expect.equal#__with165_25#int
    arm64.cmp x9, 0
    arm64.b.ne trycont
  trycont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
