    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x20
    arm64.bl __destruct_QueryKey
    arm64.movRegReg x0, x19
    arm64.bl __destruct_QueryKey
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @addDep {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.leaFuncAddr x2, __clone_Dependency
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __mm_own_deep
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

