// Test: enum-ordinal.error-enum-ordinal
enum Shape
	circle
	square
end 'Shape'

function main() returns ExitCode
	let s = Shape.square
	return s.ordinal
end 'main'
---
ExitCode: 1
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
