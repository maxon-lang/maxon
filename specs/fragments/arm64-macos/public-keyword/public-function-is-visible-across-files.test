// Test: public-function-is-visible-across-files
// --- file: api/lib.maxon
typealias Integer = int(i64.min to i64.max)

public function answer() returns Integer
	return 42
end 'answer'

// --- file: app/main.maxon
function main() returns ExitCode
	return answer()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
