// Test: where-clauses.self-returning-static-dispatches-on-its-own-value
typealias Integer = int(i64.min to i64.max)

type Holder uses T where T is Hashable and Equatable
	var v as T

	export static function of(v T) returns Self
		var built = Self{v: v}
		if built.matches(v) 'sameValue'
			return built
		end 'sameValue'
		panic("Holder.of: the value it was built from must equal itself")
	end 'of'

	export function matches(other T) returns bool
		return v.equals(other)
	end 'matches'

	export function digest() returns HashValue
		return v.hash()
	end 'digest'
end 'Holder'

typealias H = Holder with Integer

function main() returns ExitCode
	let h = H.of(41)
	return h.digest()
end 'main'
---
ExitCode: 41
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 41
    arm64.leaRdata x0, __witness_int.Hashable
    arm64.leaRdata x20, __witness_int.Equatable
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.movRegReg x1, x19
    arm64.loadRegBaseDisp.word64 x16, [x20 + 40]
    arm64.blr x16
  __il_cont#10:
    arm64.cbz x0, ifcont
  __il_cont#6:
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_body#5:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
    arm64.blr x16
    arm64.movRegReg x19, x0
  __il_cont#4:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_blob_0  ; "panic at where-clauses.self-returning-static-dispatches-on-its-own-value.test:12: Holder.of: the value it was built from must equal itself\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_11  ; "panic at where-clauses.self-returning-static-dispatches-on-its-own-value.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
