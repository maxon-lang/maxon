// Test: a-qualified-type-reaches-its-declaration-past-the-readers-own-alias
// --- file: a/foo.maxon
export type Foo
	export let v as ExitCode

	export static function make() returns Foo
		return Foo{v: 42}
	end 'make'
end 'Foo'

// --- file: app/main.maxon
typealias Foo = int(0 to 10)

function take(f a.Foo) returns ExitCode
	return f.v
end 'take'

function main() returns ExitCode
	let local = 3 as Foo
	return take(a.Foo.make()) + (local as ExitCode)
end 'main'
---
ExitCode: 45
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __il_cont:
    arm64.add x0, x0, 3
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
