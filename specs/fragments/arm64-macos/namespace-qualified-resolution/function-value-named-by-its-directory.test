typealias Integer = int(0 to 125)

export function triple(raw Integer) returns Integer
	return raw * 3
end 'triple'

// --- file: app/main.maxon
function main() returns ExitCode
	let f = lib.triple
	return f(4) as ExitCode
end 'main'
