// Test: the-librarys-supplied-aliases-are-named-through-stdlib
function main() returns ExitCode
	let c = 70 as stdlib.Codepoint
	let i = 2 as stdlib.ElementIndex
	let p = 3 as stdlib.BytePos
	let bytes = "hello".toByteArray()
	let b = try bytes.get(p) otherwise 0
	return (c + (b as Codepoint) - 100 + (i as Codepoint)) as ExitCode
end 'main'
---
ExitCode: 80
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
    arm64.leaRdata x0, __str_rec_1  ; "hello"
  __il_body#19:
    arm64.movImm x1, 0
  __il_body#23:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
  __il_cont#22:
    arm64.bl __managed_slice
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#21:
    arm64.leaRdata x0, __str_blob_2  ; "panic at String.maxon:149: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_retain
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
  __il_cont#18:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 3
    arm64.b.ls __im_slow
  __im_load#16:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.add x0, x0, 24
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b trycont
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 3
    arm64.b.ls __im_slow
  __im_load#17:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.add x0, x0, 3
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b trycont
  __im_slow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr#2:
    arm64.movImm x0, 0
  trycont:
    arm64.add x0, x0, 70
    arm64.sub x0, x0, 100
  __rc_ok#4:
    arm64.add x19, x0, 2
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok#7:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at the-librarys-supplied-aliases-are-named-through-stdlib.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
