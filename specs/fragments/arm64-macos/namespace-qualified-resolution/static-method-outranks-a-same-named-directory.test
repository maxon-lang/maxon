typealias Integer = int(0 to 125)

public function make() returns Integer
	return 11
end 'make'

// --- file: app/main.maxon
typealias Integer = int(0 to 125)

public type Point
	export var x as Integer

	export static function make() returns Integer
		return 22
	end 'make'
end 'Point'

function main() returns ExitCode
	return Point.make()
end 'main'
