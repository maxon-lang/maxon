// --- file: app/main.maxon
typealias Integer = int(i64.min to i64.max)

function addOne(n Integer) returns Integer
	return n + 1
end 'addOne'

function pickLegacy() returns legacy.Score
	return addOne
end 'pickLegacy'

function runApi(f api.Score) returns Integer
	return f(20)
end 'runApi'

function main() returns ExitCode
	let h = pickLegacy()
	print("{runApi(h)}")
	return 0
end 'main'
