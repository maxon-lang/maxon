// Test: a-top-level-binding-named-like-a-directory-keeps-its-member-access
// --- file: api/upper.maxon
export type Upper
	export let v as ExitCode

	export static function make() returns Upper
		return Upper{v: 30}
	end 'make'
end 'Upper'

// --- file: app/main.maxon
type Holder
	export let Upper as ExitCode

	static function make() returns Holder
		return Holder{Upper: 7}
	end 'make'
end 'Holder'

let api = Holder.make()

function main() returns ExitCode
	return api.Upper + seven()
end 'main'

// --- file: app/other.maxon
module function seven() returns ExitCode
	return api.Upper.make().v
end 'seven'
---
ExitCode: 37
---
data {
  __data_api@0 = i64 0
  __mrt_program_started@8 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_api
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.and x0, x0, 255
  __il_body:
    arm64.movImm x1, 30
  __il_cont#6:
    arm64.and x1, x1, 255
  __il_cont#4:
    arm64.add x0, x0, x1
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at main.maxon:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
