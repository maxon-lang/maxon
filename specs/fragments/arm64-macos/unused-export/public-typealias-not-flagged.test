// Test: public-typealias-not-flagged
// --- file: api/lib.maxon
public typealias UnusedAlias = int(0 to 100)

typealias Integer = int(i64.min to i64.max)

function consumeAlias(value UnusedAlias) returns Integer
	return value
end 'consumeAlias'

export function entry() returns Integer
	return consumeAlias(42)
end 'entry'

// --- file: app/main.maxon
function main() returns ExitCode
	return entry()
end 'main'
---
ExitCode: 42
---
func @entry {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl entry
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at main.maxon:2: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
