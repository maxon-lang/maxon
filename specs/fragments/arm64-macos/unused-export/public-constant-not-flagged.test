// Test: public-constant-not-flagged
// --- file: api/limits.maxon
typealias Integer = int(i64.min to i64.max)

public let MAX_UNUSED = 100

export function readMax() returns Integer
	return MAX_UNUSED
end 'readMax'

// --- file: app/main.maxon
function main() returns ExitCode
	return readMax()
end 'main'
---
ExitCode: 100
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 100
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
