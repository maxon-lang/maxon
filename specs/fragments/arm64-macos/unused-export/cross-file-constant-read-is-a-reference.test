// Test: cross-file-constant-read-is-a-reference
// --- file: api/limits.maxon
export let MAX_USED = 7

// --- file: app/main.maxon
function main() returns ExitCode
	return MAX_USED
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
