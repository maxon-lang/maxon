func @deepThenRead {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.cmp x0, 0
    arm64.b.ne ifcont
  __il_body:
    arm64.leaGlobal x0, __data_Cache.value
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
  __il_cont:
    arm64.leaRdata x0, __str_rec_4  ; "read "
    arm64.bl print
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.sub x0, x0, 1
    arm64.bl deepThenRead
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

