// Test: a-static-initializer-reads-one-declared-later
typealias Count = int(0 to u64.max)

type Outer
	static var value = Outer.build()
	export var n as Count

	static function build() returns Outer
		print("outer ")
		return Outer{n: Inner.get() + 1}
	end 'build'

	export static function get() returns Count
		return Outer.value.n
	end 'get'
end 'Outer'

type Inner
	static var value = Inner.build()
	export var n as Count

	static function build() returns Inner
		print("inner ")
		return Inner{n: 3}
	end 'build'

	export static function get() returns Count
		return Inner.value.n
	end 'get'
end 'Inner'

function main() returns ExitCode
	print("start ")
	print("{Outer.get()}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Outer.value@0 = i64 0
  __data_Inner.value@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @Outer.build {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_3  ; "outer "
    arm64.bl print
  __il_body:
    arm64.leaGlobal x0, __data_Inner.value
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  __il_cont:
    arm64.add x19, x0, 1
    arm64.cmp x19, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6  ; "panic at a-static-initializer-reads-one-declared-later.test:10: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Inner.build {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_4  ; "inner "
    arm64.bl print
    arm64.movImm x19, 3
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_5  ; "start "
    arm64.bl print
  __il_body:
    arm64.leaGlobal x0, __data_Outer.value
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
  __il_cont:
    arm64.movImm x0, 20
    arm64.movImm x1, 0
