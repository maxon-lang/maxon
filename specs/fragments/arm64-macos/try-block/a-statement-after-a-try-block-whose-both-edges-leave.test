// Test: a-statement-after-a-try-block-whose-both-edges-leave
enum Failure implements Error
	bad
end 'Failure'

function main() returns ExitCode
	try 'work'
		throw Failure.bad
	end 'work' otherwise (e) 'handler'
		match e 'kind'
			bad then return 3
		end 'kind'
	end 'handler'

	return 0
end 'main'
---
ExitCode: 3
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
