// Test: implied-try-block-argument-of-explicit-try
typealias Score = int(0 to 100)

enum ErrA implements Error
	kaboom
end 'ErrA'

enum ErrB implements Error
	splat
end 'ErrB'

function inner(fail bool) returns Score throws ErrA
	if fail 'c'
		throw ErrA.kaboom
	end 'c'

	return 5
end 'inner'

function outer(n Score) returns Score throws ErrB
	if n > 50 'big'
		throw ErrB.splat
	end 'big'

	return n
end 'outer'

function main() returns ExitCode
	var sum = 0

	try 'work'
		let v = try outer(inner(true)) otherwise 0
		sum = v
	end 'work' otherwise (e) 'h'
		match e 'k'
			kaboom then sum = 42
		end 'k'
	end 'h'

	return sum
end 'main'
---
ExitCode: 42
---
data {
  __mrt_program_started@0 = i8 0
}

func @inner {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @outer {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.cmp x0, 50
    arm64.b.le ifcont
  big:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at implied-try-block-argument-of-explicit-try.test:20: Range check failed: value outside typealias 'Score'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl inner
    arm64.cmp x9, 0
    arm64.b.eq tryblkok
  tryblkerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.movImm x0, 42
    arm64.b tryblkcont
  matchdead:
  tryblkok:
    arm64.bl outer
    arm64.cmp x9, 0
    arm64.b.eq tryblkcont
  tryerr:
    arm64.movImm x0, 0
  tryblkcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at implied-try-block-argument-of-explicit-try.test:40: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
