// Test: closure-capture.a-closure-in-a-union-payload-is-dropped
typealias Integer = int(i64.min to i64.max)
typealias Op = function(Integer) returns Integer

union Held
	one(op Op)
	nothing
end 'Held'

function hold(n Integer) returns Held
	let word = "a word padded long enough to heap allocate {5}"
	return Held.one(function(k Integer) gives k + n + (word.byteLength() as Integer))
end 'hold'

function main() returns ExitCode
	let h = hold(1)
	print("held {h.name}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @hold$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x1 + 8]
    arm64.add x0, x0, x2
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
  __il_cont:
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @hold$closure_0$drop {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 16]
    arm64.bl __str_decref
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
