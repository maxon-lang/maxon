// Test: closure-capture.a-closure-capturing-one-field-stored-into-a-sibling-record
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

function idle() returns Integer
	return 0
end 'idle'

type Inner
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: idle}
	end 'create'
end 'Inner'

type Counter
	export var left as Inner
	export var right as Inner

	static function create() returns Self
		return Self{left: Inner.create(3), right: Inner.create(4)}
	end 'create'

	export function arm()
		let borrowed = self.left
		self.right.read = function() gives borrowed.n
	end 'arm'
end 'Counter'

function main() returns ExitCode
	var c = Counter.create()
	c.arm()
	print("{c.right.read()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @idle {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @Inner.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __fnrec_idle
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Counter.arm$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Counter.arm$closure_0$drop {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __destruct_Inner
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#4:
    arm64.movImm x0, 3
    arm64.bl Inner.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 4
    arm64.bl Inner.create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
  __il_body#5:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.bl __mm_retain
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x20, [x21 + 8]
    arm64.leaFuncAddr x1, Counter.arm$closure_0$drop
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.leaFuncAddr x0, Counter.arm$closure_0
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x19
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x20 + 8], x22
  __il_cont#2:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.blr x1
    arm64.movRegReg x19, x0
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x23, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x24, [x0 + 8]
    arm64.add x25, x19, x24
    arm64.add x0, x25, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
    arm64.add x27, x26, 56
    arm64.movRegReg x0, x27
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x19, x27, x19
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x24
    arm64.bl __str_copy
    arm64.add x0, x19, x24
    arm64.storeBaseDispReg.word64 [x26 + 0], x27
    arm64.storeBaseDispReg.word64 [x26 + 8], x25
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x26 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x26 + 24], x0
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
  __il_body#6:
    arm64.movRegReg x0, x26
    arm64.bl __write_stdout
  __il_cont#1:
    arm64.movRegReg x0, x26
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Counter
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.epilogue 96
    arm64.ret
}
