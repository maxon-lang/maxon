// Test: value-call-result-may-still-be-discarded
typealias Integer = int(i64.min to i64.max)

var calls = 0 as Integer

function answer() returns Integer
	calls = calls + 1
	return 42
end 'answer'

function main() returns ExitCode
	_ = answer()
	return 41 + calls
end 'main'
---
ExitCode: 42
---
data {
  __data_calls@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_calls
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_cont:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 41
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at value-call-result-may-still-be-discarded.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
