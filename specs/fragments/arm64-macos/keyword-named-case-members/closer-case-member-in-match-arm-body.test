// Test: closer-case-member-in-match-arm-body
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function pick(n Integer) returns Integer
	match n 'p'
		0 then return tagOf(Kw.end) * 21
		default then return 9
	end 'p'
end 'pick'

function main() returns ExitCode
	return pick(0) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
  __il_cont:
    arm64.movImm x16, 21
    arm64.mul x0, x0, x16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
