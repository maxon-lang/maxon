// Test: closer-case-member-in-match-arm-body
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function pick(n Integer) returns Integer
	match n 'p'
		0 then return tagOf(Kw.end) * 21
		default then return 9
	end 'p'
end 'pick'

function main() returns ExitCode
	return pick(0) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchdefault
  matcharm:
    arm64.movImm x0, 2
  __il_cont:
    arm64.movImm x16, 21
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.movImm x0, 9
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl pick
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at closer-case-member-in-match-arm-body.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
