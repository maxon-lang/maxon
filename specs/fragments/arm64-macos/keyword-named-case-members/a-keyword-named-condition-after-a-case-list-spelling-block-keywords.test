// Test: a-keyword-named-condition-after-a-case-list-spelling-block-keywords
typealias Idx = int(0 to 100)

enum Kw
	while
	match
	for
	omega
end 'Kw'

function span(to Idx, from Idx) returns Idx
	if to >= from 'forward'
		return to - from
	end 'forward'
	return from - to
end 'span'

function tagOf(k Kw) returns Idx
	match k 'm'
		while then return 1
		match then return 2
		for then return 3
		omega then return 0
	end 'm'
end 'tagOf'

function main() returns ExitCode
	return (span(50, from: 8) + tagOf(Kw.omega)) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont#5:
    arm64.movImm x0, 3
  __il_body:
    arm64.jumpTable x0, default=matchdead [[0]=matcharm#22, [1]=matcharm#23, [2]=matcharm#24, [3]=matcharm#25] @__jumptable_4
  matchdead:
  matcharm#22:
    arm64.movImm x0, 1
    arm64.b __il_cont#4
  matcharm#23:
    arm64.movImm x0, 2
    arm64.b __il_cont#4
  matcharm#24:
    arm64.movImm x0, 3
    arm64.b __il_cont#4
  matcharm#25:
    arm64.movImm x0, 0
  __il_cont#4:
    arm64.add x0, x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
