// Test: closer-case-member-in-if-condition
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	if tagOf(Kw.end) == 2 'ok'
		return 20
	end 'ok'
	return 1
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 20
    arm64.epilogue 16
    arm64.ret
}
