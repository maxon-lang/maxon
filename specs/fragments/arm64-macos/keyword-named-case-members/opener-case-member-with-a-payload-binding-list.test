// Test: opener-case-member-with-a-payload-binding-list
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	while(m Num)
	omega
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		alpha(n) then return n
		while(m) then return m + 40
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	let v = tagOf(Kw.while(2))
	if v == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.movImm x1, 1
  __il_body:
    arm64.cmp x1, 0
    arm64.b.eq __il_cont
  matchnext#9:
    arm64.cmp x1, 1
    arm64.b.ne matchnext#10
  matcharm#6:
    arm64.add x0, x0, 40
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.b.gt __rc_panic
    arm64.b __il_cont
  matchnext#10:
    arm64.cmp x1, 2
    arm64.b.ne matchdead
  matcharm#7:
    arm64.movImm x0, 3
  __il_cont:
    arm64.cmp x0, 42
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at opener-case-member-with-a-payload-binding-list.test:13: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
