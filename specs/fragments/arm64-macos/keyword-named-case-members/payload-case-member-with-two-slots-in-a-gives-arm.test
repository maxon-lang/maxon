// Test: payload-case-member-with-two-slots-in-a-gives-arm
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	end(a Num, b Num)
end 'Kw'

function tagOf(k Kw) returns Num
	return match k 'm'
		alpha(n) gives n
		end(a, b) gives a + b
	end 'm'
end 'tagOf'

function main() returns ExitCode
	if tagOf(Kw.end(20, b: 22)) == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 20
    arm64.movImm x20, 22
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.storeBaseDispReg.word64 [x0 + 16], x20
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#6:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 16]
    arm64.add x1, x1, x2
  matchcont:
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 1000
    arm64.b.gt __rc_panic
  __il_cont:
    arm64.cmp x1, 42
    arm64.cset x19, eq
    arm64.bl __mm_decref
    arm64.cbz x19, ifcont
  ok:
    arm64.movImm x0, 42
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at payload-case-member-with-two-slots-in-a-gives-arm.test:10: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
