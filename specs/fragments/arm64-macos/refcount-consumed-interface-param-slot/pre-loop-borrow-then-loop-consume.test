    arm64.bl __retain_existential
    arm64.storeBaseDispReg.word64 [x27 + 0], x0
    arm64.storeBaseDispReg.word64 [x27 + 8], x20
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x26
    arm64.bl __drop_existential
  __il_body#28:
