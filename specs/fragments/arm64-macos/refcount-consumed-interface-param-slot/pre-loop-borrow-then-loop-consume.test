    arm64.b forhdr#19
  r:
    arm64.movRegReg x0, x21
    arm64.loadRegBaseDisp.word64 x16, [x20 + 24]
    arm64.blr x16
    arm64.add x22, x22, x0
  forstep#21:
    arm64.add x23, x23, 1
  forhdr#19:
    arm64.cmp x23, 2
    arm64.b.lt r
  __il_cont#17:
    arm64.cmp x22, 0
    arm64.b.ne ifcont
  empty:
    arm64.movImm x20, 0
    arm64.b __il_cont#8
  ifcont:
    arm64.movImm x23, 0
    arm64.movImm x24, 0
    arm64.b forhdr#12
  each:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
