    arm64.epilogue 96
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at pre-loop-borrow-then-loop-consume.test:74: Range check failed: value outside typealias 'ExitCode'\x0a"
