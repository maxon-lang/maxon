// Test: sched-park.a-renounced-sleeper-due-at-shutdown-does-not-abort-the-exit
typealias Integer = int(i64.min to i64.max)

function child() returns Integer
	Runtime.yield()
	sleep(0)
	return 1
end 'child'

type S
	var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	export function get() returns Integer
		return 2
	end 'get'
end 'S'

function startAndStopAService()
	let s = spawn S.create()
	let t = s.clone()
	_ = t
end 'startAndStopAService'

function main() returns ExitCode
	startAndStopAService()
	var i = 0

	while i < 2000 'settle'
		Runtime.yield()
		i = i + 1
	end 'settle'

	let p = async child()
	Runtime.yield()
	p.cancel()
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_timer_count@24 = i64 0
  __gt_timer_heap_base@32 = i64 0
  __gt_timer_capacity@40 = i64 0
  __gt_timer_seq@48 = i64 0
  __gt_timer_when@56 = i64 9223372036854775807
  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_live_count@96 = i64 0
  __sched_active_workers@104 = i64 1
  __sched_max_active_workers@112 = i64 1
  __sched_tls_index@120 = i64 0
  __sched_tls_teb_offset@128 = i64 0
  __sched_procs@136 = i64 0
  __sched_allm@144 = i64 0
  __sched_midle@152 = i64 0
  __sched_pidle@160 = i64 0
  __gt_gfree_head@168 = i64 0
  __sched_npidle@176 = i64 0
  __sched_runq_size@184 = i64 0
  __sched_mcount@192 = i64 0
  __sched_nmidle@200 = i64 0
  __sched_main_m@208 = i64 0
  __sched_phase@216 = i64 0
  __sched_num_procs@224 = i64 0
  __sched_shutdown_flag@232 = i64 0
  __sched_lock@240 = i64 0
  __sched_nmspinning@248 = i64 0
  __sched_needspinning@256 = i64 0
  __sched_sysmon_started@264 = i64 0
  __slab_arena_list@272 = i64 0
  __slab_arena_map_l1@280 = i64 0
  __slab_state@288 = i64 0
}

func @child {
  entry:
    arm64.prologue 16
    arm64.bl Runtime.yield
    arm64.movImm x0, 0
    arm64.bl sleep
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @S.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @startAndStopAService {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl S.create
    arm64.movRegReg x1, x0
    arm64.leaFuncAddr x0, S.__loop
    arm64.leaFuncAddr x2, S.__abandon
    arm64.bl __svc_spawn
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl __mbox_handle_clone_box
    arm64.bl __mbox_handle_drop_box
    arm64.movRegReg x0, x20
    arm64.bl __mbox_handle_drop_box
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl startAndStopAService
    arm64.movImm x19, 0
  whilehdr:
    arm64.cmp x19, 2000
    arm64.b.ge whileexit
  settle:
    arm64.bl Runtime.yield
    arm64.add x19, x19, 1
    arm64.b whilehdr
  whileexit:
    arm64.leaFuncAddr x0, child
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.bl Runtime.yield
    arm64.movRegReg x0, x19
    arm64.bl __gt_promise_drop
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @S.__loop {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
  serve:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.cmp x0, 0
    arm64.b.eq stopping
  dispatch:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.jumpTable x1, default=stopping [[0]=__shutdown, [1]=get] @__jumptable_1
  __shutdown:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.storeBaseDispReg.word64 [x20 + 56], x1
    arm64.bl __mm_decref
  stopping:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_close
  drain:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x1, x0
    arm64.cmp x1, 0
    arm64.b.ne abandon
  finished:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mbox_service_exit
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  abandon:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_abandon
    arm64.b drain
  get:
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
  __il_body:
    arm64.movImm x22, 2
  __il_cont:
    arm64.bl __mm_decref
    arm64.movImm x2, 0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __gt_cell_complete
    arm64.b serve
}

func @S.__abandon {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.jumpTable x0, default=abandondrop [[0]=__shutdown, [1]=get] @__jumptable_2
  __shutdown:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.bl __gt_cell_complete
    arm64.b abandondrop
  get:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.bl __gt_cell_complete
  abandondrop:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
