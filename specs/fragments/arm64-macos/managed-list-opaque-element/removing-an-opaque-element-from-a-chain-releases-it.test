// Test: removing-an-opaque-element-from-a-chain-releases-it
typealias Count = int(0 to u64.max)

type Bag uses Element
	typealias EChain = List with Element
	var chain as EChain

	export static function create() returns Self
		return Self{chain: EChain.create()}
	end 'create'

	export function add(v Element)
		self.chain.append(v)
	end 'add'

	// Nothing else in this body needs a layout descriptor, so the move-out has to ask for one itself.
	export function drainOne() throws ArrayError
		_ = try self.chain.removeFirst()
	end 'drainOne'

	export function size() returns Count
		return self.chain.count()
	end 'size'
end 'Bag'

typealias StringBag = Bag with String

function main() returns ExitCode
	var b = StringBag.create()
	b.add("alpha")
	b.add("beta")
	try b.drainOne() otherwise panic("drain")
	return b.size() as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Bag.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl List.append
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @Bag.drainOne {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movRegReg x1, x19
    arm64.bl List.removeFirst
    arm64.movRegReg x1, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __drop_type_param
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Bag_String
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 40]
    arm64.bl __list_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#8:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
  __il_cont#6:
    arm64.leaRdata x0, __str_rec_2  ; "alpha"
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Bag.add
    arm64.leaRdata x0, __str_rec_3  ; "beta"
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Bag.add
    arm64.leaRdata x1, __layout_Bag_String
    arm64.movRegReg x0, x19
    arm64.bl Bag.drainOne
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __list_count
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic#15
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic#4
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_4  ; "panic at removing-an-opaque-element-from-a-chain-releases-it.test:32: drain\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_panic#15:
    arm64.leaRdata x0, __str_blob_7  ; "panic at List.maxon:34: Range check failed: value outside typealias 'NodeCount'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
