    arm64.loadRegBaseDisp.word64 x3, [x3 + 16]
    arm64.cmp x3, 0
    arm64.b.ne forhdr#10
    arm64.b forhdr#24
  each#11:
    arm64.arm64AddLsl x0, x1, x1, lsl #1
    arm64.add x2, x0, 1
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow#19
  __im_bounds#20:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x1, x0
    arm64.b.hs __im_slow#19
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow#19
  __im_viewed:
    arm64.sub x3, x0, 24
    arm64.loadRegBaseDisp.word64 x3, [x3 + 16]
    arm64.cmp x3, 0
    arm64.b.ne __im_slow#19
  __im_store#23:
