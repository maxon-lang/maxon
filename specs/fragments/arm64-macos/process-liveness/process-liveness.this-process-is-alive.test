// Test: process-liveness.this-process-is-alive
function main() returns ExitCode
	if __Builtins.processIsAlive(__Builtins.currentProcessId()) 'alive'
		return 3
	end 'alive'
	return 1
end 'main'
---
ExitCode: 3
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl __proc_pid
    arm64.bl __proc_alive
    arm64.cbz x0, ifcont
  alive:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
