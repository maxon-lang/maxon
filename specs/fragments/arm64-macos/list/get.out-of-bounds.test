// Test: get.out-of-bounds
function main() returns ExitCode
	let list = List from [10, 20, 30]
	let v = try list.get(5) otherwise 99
	return v
end 'main'
---
ExitCode: 99
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 10
    arm64.leaRdata x0, __layout_List_int
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 40]
    arm64.bl __list_create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
  __il_cont:
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl List.append
    arm64.movImm x1, 20
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.bl List.append
    arm64.movImm x1, 30
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.bl List.append
    arm64.movImm x1, 5
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.bl List.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 99
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
  trycont:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_List_int
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at get.out-of-bounds.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
