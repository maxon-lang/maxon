// Test: iteration.two-loops
function main() returns ExitCode
	let list = List from [1, 2, 3]
	var sum1 = 0
	for item in list 'loop1'
		sum1 = sum1 + item
	end 'loop1'
	var sum2 = 0
	for item in list 'loop2'
		sum2 = sum2 + item
	end 'loop2'
	if sum1 == sum2 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.leaRdata x0, __layout_List_int
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 40]
    arm64.bl __list_create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
  __il_cont:
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl List.append
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.bl List.append
    arm64.movImm x1, 3
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x21
    arm64.bl List.append
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl List.createIterator
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.eq forhdr#1
    arm64.b forjoin#6
  loop1:
    arm64.leaRdata x1, __layout_ListIterator_int
    arm64.movRegReg x0, x20
    arm64.bl ListIterator.current
    arm64.add x19, x19, x0
  forstep#4:
    arm64.movRegReg x0, x20
    arm64.bl ListIterator.advance
    arm64.movRegReg x0, x9
  forhdr#1:
    arm64.cmp x0, 0
    arm64.b.eq loop1
  forexit#5:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_ListIterator_int
  forjoin#6:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x21
    arm64.bl List.createIterator
    arm64.movRegReg x22, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.eq forhdr#7
    arm64.b forempty
  loop2:
    arm64.leaRdata x1, __layout_ListIterator_int
    arm64.movRegReg x0, x22
    arm64.bl ListIterator.current
    arm64.add x20, x20, x0
  forstep#10:
    arm64.movRegReg x0, x22
    arm64.bl ListIterator.advance
    arm64.movRegReg x0, x9
  forhdr#7:
    arm64.cmp x0, 0
    arm64.b.eq loop2
  forexit#11:
    arm64.movRegReg x0, x22
    arm64.bl __destruct_ListIterator_int
    arm64.movRegReg x0, x20
    arm64.b forjoin#12
  forempty:
    arm64.movRegReg x0, x20
  forjoin#12:
    arm64.cmp x19, x0
    arm64.b.ne ifcont
  check:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_List_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x21
    arm64.bl __destruct_List_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
