// Test: error.otherwise-wrong-struct
typealias Integer = int(i64.min to i64.max)

enum Err implements Error
	bad
end 'Err'

type BoxA
	export var s as String

	static function create(x Integer) returns Self
		return Self{s: "v{x}"}
	end 'create'
end 'BoxA'

type BoxB
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'BoxB'

function makeA(x Integer) returns BoxA throws Err
	if x > 5 'guard'
		throw Err.bad
	end 'guard'
	return BoxA.create(x)
end 'makeA'

function main() returns ExitCode
	let a = try makeA(9) otherwise BoxB.create(9)
	return 0 as ExitCode
end 'main'
---
CompilerError:
error E3059: <fragment>:32:10: type mismatch: 'otherwise type 'BoxB' does not match expected type 'BoxA''
