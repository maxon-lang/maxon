// Test: error.parse-throws-function-signature

typealias Integer = int(i64.min to i64.max)

// Functions can declare they throw a specific error type
enum MyError implements Error
	failed
end 'MyError'

// This function signature declares it throws MyError
function mayFail(n Integer) returns Integer throws MyError
	if n > 1000 'big'
		throw MyError.failed
	end 'big'

	return n
end 'mayFail'

function main() returns ExitCode
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
