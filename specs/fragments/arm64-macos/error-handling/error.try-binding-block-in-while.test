// Test: error.try-binding-block-in-while
typealias Code = int(i64.min to i64.max)

enum Fault implements Error
	broken
end 'Fault'

function risky(_ Code) returns Code throws Fault
	throw Fault.broken
end 'risky'

function main() returns ExitCode
	var acc = 0 as Code
	var i = 0 as Code
	while i < 4 'loop'
		try risky(i) otherwise (e) 'h'
			match e 'f'
				broken then acc = acc + 1
			end 'f'
		end 'h'
		i = i + 1
	end 'loop'
	return acc
end 'main'
---
ExitCode: 4
---
func @risky {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  loop:
    arm64.movRegReg x0, x20
    arm64.bl risky
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.add x0, x19, 1
    arm64.b trycont
  matchdead:
  tryok:
    arm64.movRegReg x0, x19
  trycont:
    arm64.add x20, x20, 1
    arm64.movRegReg x19, x0
  whilehdr:
    arm64.cmp x20, 4
    arm64.b.lt loop
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at error.try-binding-block-in-while.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
