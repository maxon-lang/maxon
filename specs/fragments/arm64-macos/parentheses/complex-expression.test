// Test: complex-expression
function main() returns ExitCode
	let result = trunc((10 + (2 * 3)) / (4 - 2))
	return result
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 16
    arm64.asr x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
