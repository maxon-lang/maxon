// Test: isEmpty-method
function main() returns ExitCode
	let empty = ""
	let nonempty = "hello"
	if empty.isEmpty() 'check1'
		print("1\n")
	end 'check1'
	if nonempty.isEmpty() 'check2'
		print("0\n")
	end 'check2' else 'not_empty'
		print("2\n")
	end 'not_empty'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_5  ; ""
    arm64.leaRdata x19, __str_rec_6  ; "hello"
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __il_cont#8:
    arm64.cmp x0, 0
    arm64.cset x0, eq
  __il_cont#6:
    arm64.cbz x0, __il_body#13
  check1:
    arm64.leaRdata x0, __str_rec_7  ; "1\x0a"
    arm64.bl print
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
  __il_cont#12:
    arm64.cmp x0, 0
    arm64.cset x0, eq
  __il_cont#10:
    arm64.cbz x0, ifelse
  check2:
    arm64.leaRdata x0, __str_rec_8  ; "0\x0a"
    arm64.bl print
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_9  ; "2\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
