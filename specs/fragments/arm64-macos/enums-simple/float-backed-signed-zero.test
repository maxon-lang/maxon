// Test: float-backed-signed-zero
enum SignedZero
	negz = -0.0
	posz = 0.0
end 'SignedZero'

function main() returns ExitCode
	let x = SignedZero.negz
	return match x 'check'
		negz gives 4
		posz gives 7
	end 'check'
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 4
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
