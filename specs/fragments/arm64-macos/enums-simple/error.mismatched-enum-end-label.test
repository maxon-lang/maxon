// Test: error.mismatched-enum-end-label
enum Colour
	red
	green
end 'Color'

function main() returns ExitCode
	let c = Colour.green
	if c == Colour.green 'isGreen'
		return 1
	end 'isGreen'
	return 0
end 'main'
---
CompilerError:
error E2008: <fragment>:5:1: Mismatched end label: expected 'Colour', got 'Color'
