// Test: error.a-word-after-the-enum-name-is-refused
enum Colour int
	red
	green
end 'Colour'

function main() returns ExitCode
	let c = Colour.green
	if c == Colour.green 'isGreen'
		return 1
	end 'isGreen'
	return 0
end 'main'
