// Test: int-literal-max-to-byte

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 255 as Byte
	return b
end 'main'
---
ExitCode: 255
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 255
    arm64.epilogue 16
    arm64.ret
}
