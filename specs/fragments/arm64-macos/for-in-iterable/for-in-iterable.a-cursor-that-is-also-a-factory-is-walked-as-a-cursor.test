// Test: for-in-iterable.a-cursor-that-is-also-a-factory-is-walked-as-a-cursor
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Resumable
	var items as IntArray
	var pos as Integer

	export static function create(items IntArray) returns Self
		return Self{items: items, pos: 0}
	end 'create'

	export function current() returns Integer
		return try self.items.get(self.pos) otherwise panic("oob")
	end 'current'

	export function advance() throws IterationError
		if self.pos + 1 >= self.items.count() 'atEnd'
			throw IterationError.exhausted
		end 'atEnd'
		self.pos = self.pos + 1
	end 'advance'

	export function createIterator() returns Resumable
		return Resumable.create(self.items)
	end 'createIterator'
end 'Resumable'

function main() returns ExitCode
	var a = IntArray.create()
	a.push(10)
	a.push(20)
	a.push(30)
	a.push(40)
	var it = Resumable.create(a)
	try it.advance() otherwise panic("advance")
	try it.advance() otherwise panic("advance")
	var sum = 0
	for v in it 'each'
		sum = sum + v
	end 'each'
	return sum
end 'main'
---
ExitCode: 70
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Resumable.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Resumable.advance {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.add x1, x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 8]
    arm64.cmp x1, x2
    arm64.b.lt ifcont
  atEnd:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.add x1, x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 40
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.bl Resumable.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl Resumable.advance
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
  tryok#1:
    arm64.movRegReg x0, x20
    arm64.bl Resumable.advance
    arm64.cmp x9, 0
    arm64.b.ne tryerr#4
  tryok#3:
    arm64.movImm x21, 0
    arm64.movImm x0, 0
    arm64.b forhdr
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#17
  __rc_ok#16:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.hs __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  __il_cont:
    arm64.add x21, x21, x0
  forstep:
    arm64.movRegReg x0, x20
    arm64.bl Resumable.advance
    arm64.movRegReg x0, x9
  forhdr:
    arm64.cmp x0, 0
