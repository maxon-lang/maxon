    arm64.ret
  __rc_panic#10:
    arm64.leaRdata x0, __str_blob_5  ; "panic at for-in-iterable.a-cursor-that-is-also-a-factory-is-walked-as-a-cursor.test:42: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
