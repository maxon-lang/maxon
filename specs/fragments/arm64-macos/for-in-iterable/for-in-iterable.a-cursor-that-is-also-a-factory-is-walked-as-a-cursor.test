    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic#17:
    arm64.leaRdata x0, __str_blob_4  ; "panic at for-in-iterable.a-cursor-that-is-also-a-factory-is-walked-as-a-cursor.test:14: Range check failed: value outside typealias 'ElementIndex'\x0a"
