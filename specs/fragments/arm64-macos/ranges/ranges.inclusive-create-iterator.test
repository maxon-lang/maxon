// Test: ranges.inclusive-create-iterator
function main() returns ExitCode
		let it = try (1 to 4).createIterator() otherwise return 99
		var sum = 0
		for v in it 'loop'
				sum = sum + v
		end 'loop'
		return sum
end 'main'
---
ExitCode: 10
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 4
  __il_body#11:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
  __il_cont#10:
    arm64.movRegReg x0, x21
    arm64.bl Range.createIterator
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 99
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movImm x20, 0
    arm64.movImm x0, 0
    arm64.b forhdr
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
  __il_cont#12:
    arm64.add x20, x20, x0
  forstep:
    arm64.movRegReg x0, x19
    arm64.bl RangeIterator.advance
    arm64.movRegReg x0, x9
  forhdr:
    arm64.cmp x0, 0
    arm64.b.eq __il_body#13
  forexit:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at ranges.inclusive-create-iterator.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
