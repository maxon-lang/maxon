// Test: ranges.variable-bounds
function main() returns ExitCode
		let start = 2
		let finish = 4
		var sum = 0
		for i in start to finish 'loop'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.movImm x1, 0
  forhdr:
    arm64.cmp x0, 4
    arm64.b.gt forexit
  loop:
    arm64.add x1, x1, x0
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranges.variable-bounds.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}
