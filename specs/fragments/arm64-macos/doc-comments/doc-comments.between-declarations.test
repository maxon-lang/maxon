    arm64.movImm x0, 3
    arm64.movImm x1, 4
  __il_body:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#15
  __rc_chk#16:
    arm64.cmp x0, 1000
    arm64.b.gt __rc_panic#15
  __rc_chk#3:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#15:
    arm64.leaRdata x0, __str_blob_2  ; "panic at doc-comments.between-declarations.test:19: Range check failed: value outside typealias 'Coord'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_3  ; "panic at doc-comments.between-declarations.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
