// Test: doc-comments.tail-inference-survives
typealias Count = int(0 to u64.max)

function tail(n Count) returns ExitCode
	if n > 0 'positive'
		return 1
	end 'positive'

	panic("gone")
	/// after a panic, the tail is still elided
end 'tail'

function main() returns ExitCode
	// Runtime-valued, so neither the call nor the branch folds away and the panic path
	// survives into the emitted code where the golden can record it. A spec case runs with
	// no arguments, so this is 1.
	return tail(CommandLine.args().count())
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __cl_argc@8 = i64 0
  __cl_argv@16 = i64 0
  __cl_empty_arg@24 = i64 0
  __slab_arena_list@32 = i64 0
  __slab_arena_map_l1@40 = i64 0
  __slab_state@48 = i64 0
}

func @tail {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ls ifcont
  positive:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_blob_0  ; "panic at doc-comments.tail-inference-survives.test:9: gone\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl CommandLine.args
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
  __il_body:
    arm64.cmp x0, 0
    arm64.b.ls __il_slow
  positive:
    arm64.movImm x20, 1
    arm64.b __il_cont
  __il_slow:
    arm64.bl tail
    arm64.movRegReg x20, x0
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
