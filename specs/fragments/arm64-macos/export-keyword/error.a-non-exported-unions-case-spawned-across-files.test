// Test: error.a-non-exported-unions-case-spawned-across-files
// --- file: shape.maxon
typealias Radius = int(0 to 100)

union Shape
	circle(r Radius)
	dot
end 'Shape'

// --- file: main.maxon
function main() returns ExitCode
	let p = async Shape.circle(3)
	_ = await p
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:12:16: Unsupported: `async Shape.…` — `Shape` is an enum or union, so `Shape.<case>(…)` builds a case rather than calling a function. There is nothing there for a green thread to run
error E3008: <fragment>:12:16: type 'Shape' is not exported
