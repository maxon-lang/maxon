typealias Counts = Set with ExitCode

export function probeCounts() returns ExitCode
	let s = Counts from [1, 2]
	print("{s.count()}")
	return 0
end 'probeCounts'

// --- file: main.maxon
let S = Counts from [3, 4]

function main() returns ExitCode
	print("{S.count()}")
	return probeCounts()
end 'main'
