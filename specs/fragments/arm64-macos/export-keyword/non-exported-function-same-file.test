// Test: non-exported-function-same-file

typealias Integer = int(i64.min to i64.max)

function privateHelper() returns Integer
	return 99
end 'privateHelper'

function main() returns ExitCode
	return privateHelper()
end 'main'
---
ExitCode: 99
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 99
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
