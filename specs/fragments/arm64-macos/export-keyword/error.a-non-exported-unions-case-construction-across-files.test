// Test: error.a-non-exported-unions-case-construction-across-files
// --- file: shape.maxon
typealias Radius = int(0 to 100)

union Shape
	circle(r Radius)
	dot
end 'Shape'

// --- file: main.maxon
function main() returns ExitCode
	let s = Shape.circle(3)

	match s 'shape'
		circle(r) then return r as ExitCode
		dot then return 0
	end 'shape'
end 'main'
---
CompilerError:
error E3008: <fragment>:14:2: type 'Shape' is not exported
error E3008: <fragment>:12:10: type 'Shape' is not exported
