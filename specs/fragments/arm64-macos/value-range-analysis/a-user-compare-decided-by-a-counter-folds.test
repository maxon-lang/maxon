// Test: a-user-compare-decided-by-a-counter-folds
typealias Word = int(i64.min to i64.max)

function countNonNegative(n Word) returns Word
	var c = 0
	for i in 0 upto n 'each'
		if i >= 0 'yes'
			c = c + 1
		end 'yes'
	end 'each'
	return c
end 'countNonNegative'

function main() returns ExitCode
	if countNonNegative(5) != 5 'five'
		return 1
	end 'five'
	if countNonNegative(0) != 0 'none'
		return 2
	end 'none'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body#6:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  forhdr:
    arm64.cmp x1, 5
    arm64.b.ge __il_cont
  yes:
    arm64.add x0, x0, 1
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  __il_cont:
    arm64.cmp x0, 5
    arm64.b.eq __il_body#14
  five:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  __il_body#14:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
