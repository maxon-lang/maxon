// Test: a-two-sided-alias-keeps-its-upper-check-under-a-runtime-bound
typealias Word = int(i64.min to i64.max)
typealias Small = int(0 to 100)
typealias WordArray = Array with Word

function weigh(x Small) returns Word
	return x * 2
end 'weigh'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(150)
	let n = try a.get(0) otherwise 0
	var t = 0
	for i in 0 upto n 'each'
		t = t + weigh(i)
	end 'each'
	return 3 if t == 0 else 4
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @weigh {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-two-sided-alias-keeps-its-upper-check-under-a-runtime-bound.test:6: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x20
    arm64.storeSlotReg slot3, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 150
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont:
    arm64.movImm x1, 0
    arm64.movImm x2, 0
  forhdr:
    arm64.cmp x2, x0
    arm64.b.ge forexit
  __rc_chk#20:
    arm64.cmp x2, 100
    arm64.b.gt __il_slow
  __rc_ok#19:
    arm64.lsl x3, x2, 1
  __il_cont:
    arm64.add x1, x1, x3
  forstep:
    arm64.add x2, x2, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x1, 0
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x20, 3
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x20, 4
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __rc_chk#13:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok#11:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.epilogue 64
    arm64.ret
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
  __il_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.movRegReg x0, x2
    arm64.bl weigh
    arm64.movRegReg x3, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.b __il_cont
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-two-sided-alias-keeps-its-upper-check-under-a-runtime-bound.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.epilogue 64
    arm64.ret
}
