// Test: a-value-checked-once-is-known-non-negative-after
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function bump(a WordArray, i Word) returns Word
	let before = try a.get(i) otherwise panic("bump: i is in range")
	try a.set(i, value: before + 1) otherwise panic("bump: i is in range")
	return try a.get(i) otherwise panic("bump: i is in range")
end 'bump'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(5)
	if bump(a, i: 0) != 6 'first'
		return 1
	end 'first'
	if bump(a, i: 0) != 7 'second'
		return 2
	end 'second'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @bump {
  entry:
    arm64.prologue 32
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_ok#7:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.hs __im_slow#14
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x2, [x2 + x1*8 + 0]
  tryok#1:
    arm64.add x2, x2, 1
  __rc_ok#9:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 16]
    arm64.cmp x3, 0
    arm64.b.lt __im_slow#17
  __im_bounds:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.cmp x1, x3
    arm64.b.hs __im_slow#17
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.cmp x3, 0
    arm64.b.eq __im_slow#17
  __im_viewed:
    arm64.sub x4, x3, 24
    arm64.loadRegBaseDisp.word64 x4, [x4 + 16]
    arm64.cmp x4, 0
    arm64.b.ne __im_slow#17
  __im_store:
    arm64.storeBaseIndexScaleReg.word64 [x3 + x1*8 + 0], x2
  __rc_ok#11:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.hs __im_slow#23
  __im_load#24:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  tryok#5:
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-value-checked-once-is-known-non-negative-after.test:6: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __im_slow#14:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-value-checked-once-is-known-non-negative-after.test:6: bump: i is in range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __im_slow#17:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.bl __managed_set
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.eq __rc_ok#11
  tryerr#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-value-checked-once-is-known-non-negative-after.test:7: bump: i is in range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __im_slow#23:
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok#5
  tryerr#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-value-checked-once-is-known-non-negative-after.test:8: bump: i is in range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl bump
    arm64.cmp x0, 6
    arm64.b.eq ifcont#2
  first:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl bump
    arm64.cmp x0, 7
    arm64.b.eq ifcont#4
  second:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
