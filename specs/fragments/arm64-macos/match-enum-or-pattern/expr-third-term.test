// Test: expr-third-term
enum E
	a
	b
	c
	d
end 'E'

function pick(v E) returns ExitCode
	return match v 'm'
		a or
			b or
			c gives 7
		d gives 9
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(E.c)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 7
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
