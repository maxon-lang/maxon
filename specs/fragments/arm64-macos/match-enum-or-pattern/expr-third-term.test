// Test: expr-third-term
enum E
	a
	b
	c
	d
end 'E'

function pick(v E) returns ExitCode
	return match v 'm'
		a or b or c gives 7
		d gives 9
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(E.c)
end 'main'
---
ExitCode: 7
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.jumpTable x0, default=matchdead [[0..2]=matcharm#1, [3]=matcharm#2] @__jumptable_1
  matchdead:
  matcharm#1:
    arm64.movImm x0, 7
    arm64.b matchcont
  matcharm#2:
    arm64.movImm x0, 9
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at expr-third-term.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
  __il_body:
    arm64.jumpTable x0, default=matchdead [[0..2]=matcharm#3, [3]=matcharm#4] @__jumptable_2
  matchdead:
  matcharm#3:
    arm64.movImm x1, 7
    arm64.b matchcont
  matcharm#4:
    arm64.movImm x1, 9
  matchcont:
    arm64.cmp x1, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok
  __il_slow:
    arm64.bl pick
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
