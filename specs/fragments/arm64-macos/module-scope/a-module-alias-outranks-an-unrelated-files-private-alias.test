// Test: a-module-alias-outranks-an-unrelated-files-private-alias
// --- file: lib/a.maxon
module typealias Score = int(0 to 200)

// --- file: lib/b.maxon
export function pick() returns ExitCode
	return 150 as Score
end 'pick'

// --- file: z/z.maxon
typealias Score = int(0 to 5)

export function tiny() returns ExitCode
	let s = 1 as Score
	return s
end 'tiny'

// --- file: main.maxon
function main() returns ExitCode
	return pick() + tiny()
end 'main'
---
ExitCode: 151
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 150
  __il_cont:
    arm64.add x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
