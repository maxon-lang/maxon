// Test: error.a-module-enum-binds-nothing-outside-the-subtree
// --- file: feature/color.maxon
module enum Color
	red
	blue
end 'Color'

// --- file: other/main.maxon
function main() returns ExitCode
	let c = Color.blue
	return 0
end 'main'
