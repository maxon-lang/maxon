// Test: slice-bounds-are-its-own-window
function main() returns ExitCode
	let arr = [10, 20, 30, 40, 50]
	let sub = try arr.slice(1, endIndex: 4) otherwise return 1
	let past = try sub.get(3) otherwise 77
	return past
end 'main'
---
ExitCode: 77
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 5
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.movImm x1, 1
    arm64.movImm x2, 4
    arm64.leaRdata x3, __layout_Array_int
    arm64.movRegReg x0, x19
    arm64.bl Array.slice
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movImm x1, 3
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 3
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr#4:
    arm64.movImm x20, 77
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x1, x1, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  tryok#3:
    arm64.movRegReg x20, x1
  trycont:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#4
    arm64.b tryok#3
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at slice-bounds-are-its-own-window.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
