// Test: array-literal-constant
let numbers = [1, 2, 3, 4, 5]

function main() returns ExitCode
	var sum = 0
	for n in numbers 'loop'
		sum = sum + n
	end 'loop'
	return sum
end 'main'
---
ExitCode: 15
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.leaRdata x1, __barr_rec_1
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.b forhdr
  loop:
    arm64.loadRegBaseIndexScale.word64 x4, [x1 + x2*8 + 0]
  __im_cont:
    arm64.add x0, x0, x4
  forstep:
    arm64.add x2, x2, 1
  forhdr:
    arm64.cmp x2, x3
    arm64.b.lt loop
  forexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at array-literal-constant.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
