    arm64.storeBaseDispReg.word64 [x20 + 24], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_append
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#11
    arm64.b __im_load#12
  tryerr#2:
    arm64.movImm x0, 0
    arm64.b trycont#3
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont#3:
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.cmp x2, 1
    arm64.b.ls __im_slow#14
    arm64.b __im_load#15
  tryerr#5:
    arm64.movImm x1, 0
    arm64.b trycont#6
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
