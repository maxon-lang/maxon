    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.epilogue 48
    arm64.ret
  __im_slow#11:
    arm64.movRegReg x0, x19
