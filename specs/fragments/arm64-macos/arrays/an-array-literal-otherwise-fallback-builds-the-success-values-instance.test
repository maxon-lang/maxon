// Test: an-array-literal-otherwise-fallback-builds-the-success-values-instance
typealias Measure = int(0 to 100)
typealias Items = Array with Measure

enum Nope implements Error
	no
end 'Nope'

function risky() returns Items throws Nope
	throw Nope.no
end 'risky'

function main() returns ExitCode
	let xs = try risky() otherwise [17, 18]
	return try xs.get(1) otherwise 0
end 'main'
---
ExitCode: 18
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @risky {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl risky
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 2
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x1, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 24], x1
    arm64.movRegReg x19, x0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x19, x0
  trycont#3:
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow
  __im_load#13:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b tryok#4
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow
  __im_load#14:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 1
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b tryok#4
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok#4
  tryerr#5:
    arm64.movImm x20, 0
    arm64.b trycont#6
  tryok#4:
    arm64.movRegReg x20, x0
  trycont#6:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
