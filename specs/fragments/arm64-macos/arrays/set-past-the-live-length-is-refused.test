// Test: set-past-the-live-length-is-refused
function main() returns ExitCode
	var arr = ["one long heap allocated string value here"]
	arr.reserve(8)
	try arr.set(2, value: "two long heap allocated string value here") otherwise 'pastLength'
		return 42
	end 'pastLength'
	return arr.count()
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "one long heap allocated string value here"
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x19, 8
  __rc_ok#19:
    arm64.movRegReg x0, x20
    arm64.bl __managed_capacity
    arm64.cmp x0, 8
    arm64.b.ge __il_cont
  grow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont
  tryerr#17:
    arm64.leaRdata x0, __str_blob_4  ; "panic at Array.maxon:415: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __il_cont:
    arm64.movImm x19, 2
    arm64.leaRdata x0, __str_rec_3  ; "two long heap allocated string value here"
    arm64.bl __str_retain
    arm64.movRegReg x2, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 40]
    arm64.cmp x0, 0
    arm64.b.ne __im_slow
  __im_owned:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow
  __im_bounds:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 2
    arm64.b.ls __im_slow
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  __im_viewed:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.b.eq __im_store
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.movImm x19, 42
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __im_store:
    arm64.storeBaseIndexScaleReg.word64 [x0 + x19*8 + 0], x2
  tryok:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok#3:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6  ; "panic at set-past-the-live-length-is-refused.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
