    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __il_cont#5:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
  __il_body#7:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b forhdr
  each:
    arm64.loadRegBaseIndexScale.word64 x3, [x0 + x1*8 + 0]
  __im_cont:
    arm64.fmov d1, x3
    arm64.fadd d0, d0, d1
  forstep:
    arm64.add x1, x1, 1
  forhdr:
    arm64.cmp x1, x2
    arm64.b.lt each
  __il_cont#4:
    arm64.fpLoadRdata d1, [rdata + __fconst_1.5]
    arm64.fadd d0, d0, d1
    arm64.fcvtzs x19, d0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Samples
    arm64.cmp x19, 0
