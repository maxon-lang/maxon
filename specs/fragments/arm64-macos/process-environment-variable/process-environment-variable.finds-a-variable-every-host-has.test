// Test: process-environment-variable.finds-a-variable-every-host-has
function main() returns ExitCode
	let value = try Process.environmentVariable("PATH") otherwise return 2
	if value.isEmpty() 'empty'
		return 3
	end 'empty'

	return 7
end 'main'
---
ExitCode: 7
