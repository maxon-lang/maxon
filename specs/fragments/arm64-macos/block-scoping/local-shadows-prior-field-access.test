    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_27  ; "panic at local-shadows-prior-field-access.test:9: Range check failed: value outside typealias 'Kind'\x0a"
    arm64.bl mrt_panic
