	a.push(18)
	a.push(19)
	a.push(20)
	a.push(21)
	a.push(22)
	a.push(23)
	a.push(24)
	a.push(25)
	a.push(26)
	a.push(27)
	a.push(28)
	a.push(29)
	a.push(30)
	a.push(31)
	a.push(32)
	a.push(33)
	a.push(34)
	a.push(35)
	a.push(36)
	a.push(37)
	a.push(38)
	a.push(39)
	a.push(40)
	a.push(41)
	a.push(42)
	a.push(43)
	a.push(44)
	a.push(45)
	a.push(46)
	a.push(47)
	a.push(48)
	a.push(49)
	a.push(50)
	let n = a.count()
	var sum = 0
	var squares = 0

	for x in a 'tally'
		sum = sum + x
		squares = squares + x * x
	end 'tally'

	a.sort(ascending)

	var ordered = a.count() == n
	var sumAfter = 0
	var squaresAfter = 0

	for i in 0 upto a.count() 'walk'
		let v = try a.get(i) otherwise return 99
		sumAfter = sumAfter + v
		squaresAfter = squaresAfter + v * v

		if i > 0 'pair'
			let p = try a.get(i - 1) otherwise return 99

			if p > v 'oop'
				ordered = false
			end 'oop'
		end 'pair'
	end 'walk'

	if ordered and sumAfter == sum and squaresAfter == squares 'ok'
		print("sorted\n")
	end 'ok' else 'bad'
		print("BROKEN\n")
	end 'bad'
	return 0
end 'main'
