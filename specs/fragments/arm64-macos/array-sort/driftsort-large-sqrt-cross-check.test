// Test: driftsort-large-sqrt-cross-check
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	var r = 2463534242

	for i in 0 upto 5000 'fill'
		r = (r * 1103515245 + 12345) and 0x7FFFFFFF
		a.push(r and 0xFFFF)
	end 'fill'

	let n = a.count()
	var sum = 0
	var squares = 0

	for x in a 'tally'
		sum = sum + x
		squares = squares + x * x
	end 'tally'

	a.sort(ascending)

	var ordered = a.count() == n
	var sumAfter = 0
	var squaresAfter = 0

	for i in 0 upto a.count() 'walk'
		let v = try a.get(i) otherwise return 99
		sumAfter = sumAfter + v
		squaresAfter = squaresAfter + v * v

		if i > 0 'pair'
			let p = try a.get(i - 1) otherwise return 99

			if p > v 'oop'
				ordered = false
			end 'oop'
		end 'pair'
	end 'walk'

	if ordered and sumAfter == sum and squaresAfter == squares 'ok'
		print("sorted\n")
	end 'ok' else 'bad'
		print("BROKEN\n")
	end 'bad'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @ascending {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.cmp x0, x1
    arm64.b.ge ifcont#4
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#4:
    arm64.cmp x0, x1
    arm64.b.le ifcont#6
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#6:
    arm64.movImm x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 2463534242
    arm64.movImm x20, 0
    arm64.b forhdr#1
  fill:
    arm64.movImm x16, 1103515245
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 12345
    arm64.and x21, x0, 2147483647
    arm64.and x1, x21, 65535
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
    arm64.movRegReg x0, x21
  forhdr#1:
    arm64.movImm x16, 5000
    arm64.cmp x20, x16
    arm64.b.lt fill
  forexit#4:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movImm x21, 0
    arm64.movImm x22, 0
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.b forhdr#5
  tally:
    arm64.loadRegBaseIndexScale.word64 x3, [x2 + x0*8 + 0]
  __im_cont:
    arm64.add x21, x21, x3
    arm64.mul x3, x3, x3
    arm64.add x22, x22, x3
  forstep#7:
    arm64.add x0, x0, 1
  forhdr#5:
    arm64.cmp x0, x1
    arm64.b.lt tally
  forexit#8:
    arm64.leaFuncAddr x1, __fnref_ascending
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Array_Integer
    arm64.movRegReg x0, x19
    arm64.bl Array.sort#Array.SortComparator
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, x20
    arm64.cset x0, eq
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x19 + 8]
  __us_test:
    arm64.loadRegBaseDisp.word64 x5, [x19 + 0]
    arm64.b forhdr#9
  __im_load#33:
    arm64.loadRegBaseIndexScale.word64 x6, [x5 + x3*8 + 0]
  tryok#13:
    arm64.add x1, x1, x6
    arm64.mul x7, x6, x6
    arm64.add x2, x2, x7
    arm64.cmp x3, 0
    arm64.b.le forstep#11
  pair:
    arm64.sub x7, x3, 1
  __im_load#36:
    arm64.loadRegBaseIndexScale.word64 x7, [x5 + x7*8 + 0]
  tryok#16:
    arm64.cmp x7, x6
    arm64.b.le forstep#11
  oop:
    arm64.movImm x0, 0
  forstep#11:
    arm64.add x3, x3, 1
  forhdr#9:
    arm64.cmp x3, x4
    arm64.b.lt __im_load#33
  forexit#12:
    arm64.movImm x3, 0
    arm64.cbz x0, critsplit#38
  andrhs#21:
    arm64.cmp x1, x21
    arm64.cset x0, eq
    arm64.b scmerge#22
  critsplit#38:
    arm64.movRegReg x0, x3
  scmerge#22:
    arm64.movImm x1, 0
    arm64.cbz x0, critsplit#41
  andrhs#23:
    arm64.cmp x2, x22
    arm64.cset x0, eq
    arm64.b scmerge#24
  critsplit#41:
    arm64.movRegReg x0, x1
  scmerge#24:
    arm64.cbz x0, ifelse
  ok:
    arm64.leaRdata x0, __str_rec_19  ; "sorted\x0a"
    arm64.bl print
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_20  ; "BROKEN\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
