// Test: first-empty-slot
typealias Integer = int(i64.min to i64.max)

type Slot
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Slot'

typealias SlotArray = Array with Slot

function main() returns ExitCode
	var arr = SlotArray.create()
	arr.reserve(3)
	try arr.managed.setLength(3) otherwise panic("setLength: capacity just reserved for 3")
	let result = try arr.first() otherwise Slot.create(77)
	return result.value
end 'main'
---
ExitCode: 77
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Slot.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Array.reserve
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-empty-slot.test:17: setLength: capacity just reserved for 3\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x19
    arm64.bl __managed_first
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.movImm x0, 77
    arm64.bl Slot.create
    arm64.b trycont
  tryok#3:
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x20
  trycont:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at first-empty-slot.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
