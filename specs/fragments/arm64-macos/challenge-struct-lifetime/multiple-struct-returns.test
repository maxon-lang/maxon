// Test: multiple-struct-returns

typealias Integer = int(i64.min to i64.max)

type Value
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Value'

function step1() returns Value
	return Value.create(1)
end 'step1'

function step2(v Value) returns Value
	return Value.create(v.n + 10)
end 'step2'

function step3(v Value) returns Value
	return Value.create(v.n + 100)
end 'step3'

function main() returns ExitCode
	let v1 = step1()
	let v2 = step2(v1)
	let v3 = step3(v2)
	return v3.n
end 'main'
---
ExitCode: 111
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
  __il_body#7:
    arm64.movImm x0, 1
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 10
    arm64.leaRegSlot x1, slot1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 100
    arm64.leaRegSlot x1, slot2
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_cont:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at multiple-struct-returns.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
}
