// Test: duplicate-block-identifiers.different-blocks
function main() returns ExitCode
	var x = 0
	if true 'outer'
		x = 1
	end 'outer'
	
	if true 'inner'
		x = 2
	end 'inner'
	
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  inner:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
