// Test: duplicate-block-identifiers.else-nested
function main() returns ExitCode
	var x = 0
	if false 'check'
		x = 1
	end 'check' else 'else_check'
		if true 'nested'
			x = 2
		end 'nested'
	end 'else_check'
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  nested:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
