// Test: a-folded-value-still-meets-its-range-check
typealias Word = int(i64.min to i64.max)
typealias Small = int(0 to 100)

function scale(a Word, b Word) returns Word
	return a * b
end 'scale'

function main() returns ExitCode
	print("before\n")
	let v = scale(50, b: 4) as Small
	print("{v}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "before\x0a"
    arm64.bl print
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at a-folded-value-still-meets-its-range-check.test:11: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
