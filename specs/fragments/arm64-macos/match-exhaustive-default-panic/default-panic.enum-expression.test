// Test: default-panic.enum-expression
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	let result = match c 'eval'
		red gives 1
		green gives 2
		default panic("unhandled color")
	end 'eval'
	return result
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
