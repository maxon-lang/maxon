// Test: default-panic.enum-range-statement
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.sub
	match op 'check'
		add or
			sub or
			mul then return 1
		default panic("unexpected op")
	end 'check'
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.cmp x0, 0
    arm64.cset x1, ge
    arm64.cmp x0, 2
    arm64.cset x0, le
    arm64.and x0, x1, x0
    arm64.cbz x0, matchdefault
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at default-panic.enum-range-statement.test:17: unexpected op\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
