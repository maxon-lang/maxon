// Test: default-panic.expression
function main() returns ExitCode
	let x = 3
	let result = match x 'eval'
		1 gives 10
		2 gives 20
		3 gives 30
		default panic("unexpected value")
	end 'eval'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 30
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
