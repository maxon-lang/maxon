    arm64.cmp x3, 0
    arm64.b.lt forhdr#16
  __us_test#60:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.cmp x3, 0
    arm64.b.eq forhdr#16
  __us_test#61:
    arm64.sub x4, x3, 24
    arm64.loadRegBaseDisp.word64 x4, [x4 + 16]
