// Test: a-read-loop-hoists-its-header-loads
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function total(a WordArray, n Word) returns Word
	var t = 0
	for i in 0 upto n 'sum'
		t = t + (try a.get(i) otherwise panic("total: i < n = a.count()"))
	end 'sum'
	return t
end 'total'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 6 'seed'
		a.push(i * i)
	end 'seed'
	if total(a, n: 6) != 55 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @total {
  entry:
    arm64.prologue 64
    arm64.movImm x2, 0
    arm64.movImm x3, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x4, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x5, [x0 + 0]
  forhdr:
    arm64.cmp x3, x1
    arm64.b.ge forexit
  __rc_ok:
    arm64.cmp x3, x4
    arm64.b.hs __im_slow
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x6, [x5 + x3*8 + 0]
  tryok:
    arm64.add x2, x2, x6
  forstep:
    arm64.add x3, x3, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x2
    arm64.epilogue 64
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, x5
    arm64.movRegReg x1, x3
    arm64.bl __managed_get
    arm64.movRegReg x6, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot x5, slot5
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-read-loop-hoists-its-header-loads.test:8: total: i < n = a.count()\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 6
    arm64.b.ge forexit
  seed:
    arm64.mul x1, x20, x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x1, 6
    arm64.movRegReg x0, x19
    arm64.bl total
    arm64.cmp x0, 55
    arm64.b.eq ifcont
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
