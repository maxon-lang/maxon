// Test: a-hoisted-load-read-after-the-loop-is-refused
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function tally(a WordArray) returns Word
	var t = 0
	var last = 0
	var i = 0
	while true 'l'
		t = t + (try a.get(i) otherwise 0)
		last = a.count()
		if i >= 2 'stop'
			break
		end 'stop'
		i = i + 1
	end 'l'
	return last * 100 + t
end 'tally'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(1)
	a.push(2)
	a.push(3)
	a.push(4)
	a.push(5)
	if tally(a) != 506 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tally {
  entry:
    arm64.prologue 48
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.movImm x3, 0
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x3, x2
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x2, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x2, [x2 + x3*8 + 0]
  trycont:
    arm64.add x1, x1, x2
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x3, 2
    arm64.b.lt ifcont
  whileexit:
    arm64.movImm x16, 100
    arm64.mul x0, x2, x16
    arm64.add x0, x0, x1
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.add x3, x3, 1
    arm64.b __rc_ok
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x3
    arm64.movRegReg x1, x3
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x3, slot2
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl tally
    arm64.cmp x0, 506
    arm64.b.eq ifcont
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
