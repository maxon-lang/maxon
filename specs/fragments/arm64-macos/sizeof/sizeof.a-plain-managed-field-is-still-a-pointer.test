// Test: sizeof.a-plain-managed-field-is-still-a-pointer
type Plain
	var managed as __ManagedMemory
	var flag as bool
end 'Plain'

function main() returns ExitCode
	return sizeof(Plain) as ExitCode
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16
    arm64.epilogue 16
    arm64.ret
}
