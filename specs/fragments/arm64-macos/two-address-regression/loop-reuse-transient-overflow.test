// Test: loop-reuse-transient-overflow
function loopReuse(p Integer) returns Integer
	let k1 = p + 1
	let k2 = p + 2
	let k3 = p + 3
	let k4 = p + 4
	let k5 = p + 5
	let k6 = p + 6
	let k7 = p + 7
	let k8 = p + 8
	let k9 = p + 9
	let k10 = p + 10
	let k11 = p + 11
	let a = p + 20
	var b = p + 5
	var i = 0
	while i < 3 'loop'
		b = a - b
		i = i + 1
	end 'loop'
	return b + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11
end 'loopReuse'

function main() returns ExitCode
	let r = loopReuse(0)
	if r == 81 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 20
    arm64.movImm x1, 5
    arm64.movImm x2, 0
    arm64.b whilehdr
  loop:
    arm64.sub x1, x0, x1
    arm64.add x2, x2, 1
  whilehdr:
    arm64.cmp x2, 3
    arm64.b.lt loop
  whileexit:
    arm64.add x0, x1, 1
    arm64.add x0, x0, 2
    arm64.add x0, x0, 3
    arm64.add x0, x0, 4
    arm64.add x0, x0, 5
    arm64.add x0, x0, 6
    arm64.add x0, x0, 7
    arm64.add x0, x0, 8
    arm64.add x0, x0, 9
    arm64.add x0, x0, 10
    arm64.add x0, x0, 11
  __il_cont:
    arm64.cmp x0, 81
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
