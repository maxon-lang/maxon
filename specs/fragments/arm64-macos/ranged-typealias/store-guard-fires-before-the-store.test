    arm64.storeSlotReg slot3, x21
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
  __rc_ok#6:
    arm64.movImm x0, 500
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_8  ; "panic at store-guard-fires-before-the-store.test:20: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.loadRegSlot x22, slot4
    arm64.loadRegSlot x23, slot5
    arm64.loadRegSlot x24, slot6
    arm64.loadRegSlot x25, slot7
    arm64.loadRegSlot x26, slot8
    arm64.loadRegSlot x27, slot9
    arm64.epilogue 96
    arm64.ret
  __rc_ok#1:
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.leaRdata x0, __str_rec_3  ; "stored\x0a"
    arm64.bl print
    arm64.leaRdata x0, __str_rec_4  ; "v="
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
