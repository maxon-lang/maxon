// Test: store-guard-fires-before-the-store
typealias Percent = int(0 to 100)
typealias Wide = int(0 to 100000)

type Box
	export var v as Percent = 1

	export static function make() returns Box
		return Self{}
	end 'make'
end 'Box'

function widen(n Wide) returns Wide
	return n + 400
end 'widen'

function main() returns ExitCode
	var b = Box.make()
	let bad = widen(100)
	b.v = bad as Percent
	print("stored\n")
	print("v={b.v}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x19, 1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __rc_panic:
    arm64.leaRdata x0, __str_blob_9  ; "panic at store-guard-fires-before-the-store.test:20: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
