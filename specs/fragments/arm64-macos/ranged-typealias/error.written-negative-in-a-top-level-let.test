// Test: error.written-negative-in-a-top-level-let
typealias Slot = int(0 to u64.max)

let NO_SLOT = -1 as Slot

function main() returns ExitCode
	let s = NO_SLOT
	return s as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:4:18: Value -1 is outside the range of 'Slot' (int(0 to 18446744073709551615))
