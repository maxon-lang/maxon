  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at float-narrow-f64-to-f32.test:6: Range check failed: value outside typealias 'Narrow'\x0a"
    arm64.bl mrt_panic
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_1E+300]
  __il_slow:
    arm64.bl narrow
  __il_cont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at float-narrow-f64-to-f32.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
