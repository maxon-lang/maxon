// Test: float-narrow-f64-to-f32
typealias Wide = float(f64.min to f64.max)
typealias Narrow = float(f32.min to f32.max)

function narrow(x Wide) returns Narrow
	return x
end 'narrow'

function main() returns ExitCode
	return trunc(narrow(1.0e300))
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at float-narrow-f64-to-f32.test:6: Range check failed: value outside typealias 'Narrow'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
