// Test: float-runtime-range-panic
typealias Pct = float(0.0 to 100.0)
typealias Wide = float(f64.min to f64.max)

function scale(x Wide) returns Wide
	return x * 2.0
end 'scale'

function main() returns ExitCode
	let big = scale(300.0)
	let p = big as Pct
	return trunc(p)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.fpLoadRdata d0, [rdata + __fconst_600]
  __il_cont:
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.mi __rc_panic#2
  __rc_chk#3:
    arm64.fpLoadRdata d1, [rdata + __fconst_100]
    arm64.fcmp d0, d1
    arm64.b.le __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at float-runtime-range-panic.test:11: Range check failed: value outside typealias 'Pct'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#5
  __rc_chk#6:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at float-runtime-range-panic.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.epilogue 16
    arm64.ret
}
