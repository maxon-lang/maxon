// Test: unsigned-max-upper-runtime-pass
typealias Big = int(5 to u64.max)

function main() returns ExitCode
	let big = 1 shl 63
	let r = big as Big
	if r == 1 shl 63 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
