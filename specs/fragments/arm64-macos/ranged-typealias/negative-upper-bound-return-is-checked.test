// Test: negative-upper-bound-return-is-checked
typealias Integer = int(i64.min to i64.max)
typealias BelowMinusOne = int(i64.min to -2)

function ident(v Integer) returns Integer
	return v
end 'ident'

function narrow() returns BelowMinusOne
	return ident(-1)
end 'narrow'

function main() returns ExitCode
	print("v={narrow()}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "v="
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at negative-upper-bound-return-is-checked.test:10: Range check failed: value outside typealias 'BelowMinusOne'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
