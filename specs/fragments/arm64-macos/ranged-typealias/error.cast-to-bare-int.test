// Test: error.cast-to-bare-int
typealias Score = int(0 to 100)

function main() returns ExitCode
	let s = 5 as Score
	let n = s as int
	return 0 as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:6:15: Cannot cast to bare 'int'. Define a typealias with range constraints, e.g., 'value as MyInt' where 'typealias MyInt = int(0 to 100)'
