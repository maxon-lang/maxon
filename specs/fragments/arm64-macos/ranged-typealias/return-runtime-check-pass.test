// Test: return-runtime-check-pass
typealias Score = int(0 to 100)

function half(s Score) returns Score
	return s / 2
end 'half'

function main() returns ExitCode
	return half(84)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 84
  __rc_ok:
    arm64.lsr x0, x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
