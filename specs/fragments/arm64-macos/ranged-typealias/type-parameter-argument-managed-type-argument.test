// Test: type-parameter-argument-managed-type-argument
type Box uses T
	export var v as T

	static function create(seed T) returns Self
		return Self{v: seed}
	end 'create'

	export function put(value T)
		self.v = value
	end 'put'
end 'Box'

typealias SB = Box with String

function main() returns ExitCode
	var b = SB.create("a")
	b.put("hello")
	return b.v.byteLength()
end 'main'
