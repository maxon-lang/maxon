// Test: ascii-value-emoji
function main() returns ExitCode
	let c = '🎉'
	if let ascii = try c.asciiValue() 'hasAscii'
		return ascii
	end 'hasAscii'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "\xf0\x9f\x8e\x89"
    arm64.bl __char_ascii
    arm64.cmp x9, 0
    arm64.b.ne ifcont
  hasAscii:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at ascii-value-emoji.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
