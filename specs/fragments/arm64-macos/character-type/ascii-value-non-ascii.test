// Test: ascii-value-non-ascii
function main() returns ExitCode
	let c = 'é'
	if let ascii = try c.asciiValue() 'hasAscii'
		return ascii
	end 'hasAscii'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "\xc3\xa9"
    arm64.bl __char_ascii
    arm64.cmp x9, 0
    arm64.b.ne ifcont
  hasAscii:
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
