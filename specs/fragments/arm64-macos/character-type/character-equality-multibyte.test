// Test: character-equality-multibyte
function main() returns ExitCode
	let a = 'é'
	let b = 'é'
	if a == b 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "\xc3\xa9"
    arm64.leaRdata x1, __str_rec_1  ; "\xc3\xa9"
    arm64.bl __str_eq
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
