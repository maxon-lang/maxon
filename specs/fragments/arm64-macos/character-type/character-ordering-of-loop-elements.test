// Test: character-ordering-of-loop-elements
function main() returns ExitCode
	let s = "caféüñ"
	let pivot = 'ü'
	var below = 0
	for c in s 'each'
		if c < pivot 'lt'
			below = below + 1
		end 'lt'
	end 'each'
	print("{below}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_3  ; "caf\xc3\xa9\xc3\xbc\xc3\xb1"
    arm64.leaRdata x20, __str_rec_4  ; "\xc3\xbc"
    arm64.movImm x21, 0
    arm64.movImm x22, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x22, x0
    arm64.b.ge forexit
  each:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl findGraphemeEnd
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl __char_at
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x20
    arm64.bl __char_cmp
    arm64.cmp x0, 0
    arm64.b.ne ifcont
  lt:
    arm64.add x21, x21, 1
  ifcont:
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
  forstep:
    arm64.movRegReg x22, x23
    arm64.b forhdr
  forexit:
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __int_to_string
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __str_rec_5  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x23, x20, x22
    arm64.add x0, x23, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x20, x25, x20
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x20, x22
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
    arm64.storeBaseDispReg.word64 [x24 + 8], x23
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x24 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x24 + 24], x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x24
