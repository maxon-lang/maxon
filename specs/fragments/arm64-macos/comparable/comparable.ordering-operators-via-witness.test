// Test: comparable.ordering-operators-via-witness
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function lt() returns bool
		return self.a < self.b
	end 'lt'
	export function le() returns bool
		return self.a <= self.b
	end 'le'
	export function gt() returns bool
		return self.a > self.b
	end 'gt'
	export function ge() returns bool
		return self.a >= self.b
	end 'ge'
	export function mask() returns Integer
		var m = 0 as Integer
		if self.lt() 'a1'
			m = m + 1
		end 'a1'
		if self.le() 'a2'
			m = m + 2
		end 'a2'
		if self.gt() 'a3'
			m = m + 4
		end 'a3'
		if self.ge() 'a4'
			m = m + 8
		end 'a4'
		return m
	end 'mask'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let low = IntPair.create(3, b: 9)
	if low.mask() != 3 'p1'
		return 1
	end 'p1'
	let same = IntPair.create(7, b: 7)
	if same.mask() != 10 'p2'
		return 2
	end 'p2'
	let high = IntPair.create(9, b: 3)
	if high.mask() != 12 'p3'
		return 3
	end 'p3'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @Pair.mask {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x21, 0
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x16, [x20 + 40]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, eq
  __il_cont#12:
    arm64.cbz x0, __il_body#15
  a1:
    arm64.movImm x21, 1
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x16, [x20 + 40]
    arm64.blr x16
    arm64.cmp x0, 2
    arm64.cset x0, ne
  __il_cont#14:
    arm64.cbz x0, __il_body#17
  a2:
    arm64.add x21, x21, 2
  __il_body#17:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x16, [x20 + 40]
    arm64.blr x16
    arm64.cmp x0, 2
    arm64.cset x0, eq
  __il_cont#16:
    arm64.cbz x0, __il_body#19
  a3:
    arm64.add x21, x21, 4
  __il_body#19:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x16, [x20 + 40]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, ne
  __il_cont#18:
    arm64.cbz x0, critsplit
  a4:
    arm64.add x0, x21, 8
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x21
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.movImm x0, 3
    arm64.movImm x1, 9
    arm64.leaRdata x2, __witness_int.Comparable
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x2
    arm64.bl Pair.mask
    arm64.cmp x0, 3
    arm64.b.eq ifcont#2
  p1:
    arm64.movImm x0, 1
    arm64.epilogue 64
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 7
    arm64.movImm x1, 7
    arm64.leaRdata x2, __witness_int.Comparable
    arm64.leaRegSlot x2, slot2
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x2
    arm64.bl Pair.mask
    arm64.cmp x0, 10
    arm64.b.eq ifcont#4
  p2:
    arm64.movImm x0, 2
    arm64.epilogue 64
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 9
    arm64.movImm x1, 3
    arm64.leaRdata x2, __witness_int.Comparable
    arm64.leaRegSlot x2, slot4
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x2
    arm64.bl Pair.mask
    arm64.cmp x0, 12
    arm64.b.eq ifcont#6
  p3:
    arm64.movImm x0, 3
    arm64.epilogue 64
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 64
    arm64.ret
}
