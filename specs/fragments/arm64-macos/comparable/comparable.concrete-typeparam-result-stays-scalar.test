// Test: comparable.concrete-typeparam-result-stays-scalar
typealias Integer = int(0 to u32.max)

type Box uses T
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function get() returns T
		return self.item
	end 'get'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	let b = IntBox.create(7)
	let v = b.get()
	if v < 9 'lt'
		return 1
	end 'lt'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
  __il_body#5:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#4:
    arm64.leaRdata x0, __layout_Box_Integer
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.bl __retain_type_param
  __il_cont#3:
    arm64.cmp x0, 9
    arm64.b.ge ifcont
  lt:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
