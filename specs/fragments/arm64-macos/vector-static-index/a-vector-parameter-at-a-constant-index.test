    arm64.leaRdata x3, __layout_Vector_N3_Int
    arm64.movImm x4, 3
    arm64.movRegReg x0, x20
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
  __il_body#9:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Vector_N3_Int
    arm64.movRegReg x0, x20
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#11:
    arm64.movImm x19, 0
    arm64.b __il_cont#8
  tryok:
    arm64.movRegReg x19, x0
  __il_cont#8:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-vector-parameter-at-a-constant-index.test:11: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
