    arm64.movRegReg x2, x25
    arm64.movRegReg x3, x26
    arm64.movRegReg x4, x27
    arm64.movRegReg x5, x22
    arm64.bl Array.driftsortRange
    arm64.movRegReg x0, x27
    arm64.bl __mm_decref
  __il_cont:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 0
