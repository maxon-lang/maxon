// Test: free-function-may-share-a-stdlib-methods-name
typealias Integer = int(i64.min to i64.max)

type Node
	export var tag as Integer

	static function create(t Integer) returns Self
		return Self{tag: t}
	end 'create'
end 'Node'

function swap(n Node) returns Integer
	n = Node.create(99)
	return n.tag
end 'swap'

function main() returns ExitCode
	var owned = Node.create(5)
	let bumped = swap(owned)
	var nums = [3, 1, 2]
	nums.sort()
	return bumped + (try nums.get(0) otherwise 0)
end 'main'
---
ExitCode: 100
---
data {
  __data_captured@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __data_capturing@32 = i1 0
}

func @Node.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @swap {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 99
    arm64.bl Node.create
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl Node.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl swap
    arm64.movRegReg x19, x0
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movImm x0, 3
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x21 + 24], x0
    arm64.leaRdata x22, __layout_Array_int
    arm64.leaRdata x23, __witness_int.Comparable
  __il_body:
    arm64.movImm x24, 0
    arm64.loadRegBaseDisp.word64 x25, [x21 + 8]
    arm64.leaFuncAddr x26, Array.sort$closure_0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
