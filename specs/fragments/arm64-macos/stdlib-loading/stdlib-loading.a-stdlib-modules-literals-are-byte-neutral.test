// Test: stdlib-loading.a-stdlib-modules-literals-are-byte-neutral
typealias Weight = float(0.0 to 100.0)

enum Marker
	alpha
	beta
	gamma
	delta
	epsilon
	zeta
	eta
	theta
end 'Marker'

function main() returns ExitCode
	let scale = 12.5 as Weight
	let pick = Marker.gamma
	let slot = match pick 'which'
		alpha gives 0
		beta gives 1
		gamma gives 2
		delta gives 3
		epsilon gives 4
		zeta gives 5
		eta gives 6
		theta gives 7
	end 'which'
	return trunc(scale) + slot
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.jumpTable x0, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5, [5]=matcharm#6, [6]=matcharm#7, [7]=matcharm#8] @__jumptable_1
  matchdead:
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm#2:
    arm64.movImm x0, 1
    arm64.b matchcont
  matcharm#3:
    arm64.movImm x0, 2
    arm64.b matchcont
  matcharm#4:
    arm64.movImm x0, 3
    arm64.b matchcont
  matcharm#5:
    arm64.movImm x0, 4
    arm64.b matchcont
  matcharm#6:
    arm64.movImm x0, 5
    arm64.b matchcont
  matcharm#7:
    arm64.movImm x0, 6
    arm64.b matchcont
  matcharm#8:
    arm64.movImm x0, 7
  matchcont:
    arm64.add x0, x0, 12
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at stdlib-loading.a-stdlib-modules-literals-are-byte-neutral.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
