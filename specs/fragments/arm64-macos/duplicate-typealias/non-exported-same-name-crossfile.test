// Test: non-exported-same-name-crossfile
// --- file: a.maxon
typealias MyInt = int(0 to 1000)

export function doubleIt(x MyInt) returns MyInt
	return x + x
end 'doubleIt'

// --- file: b.maxon
typealias MyInt = int(0 to 1000)

export function tripleIt(x MyInt) returns MyInt
	return x + x + x
end 'tripleIt'

// --- file: main.maxon
function main() returns ExitCode
	let a = doubleIt(5)
	let b = tripleIt(3)
	return a + b
end 'main'
