// Test: keyword-named-INTERFACE-REQUIREMENTS-among-others
typealias Integer = int(i64.min to i64.max)

interface Bounded
	function end(k Integer) returns Integer
	function while(k Integer) returns Integer
	function match(k Integer) returns Integer
end 'Bounded'

type Span implements Bounded
	export let lo as Integer

	export static function from(k Integer) returns Self
		return Self{lo: k}
	end 'from'

	export function end(k Integer) returns Integer
		return lo + k
	end 'end'

	export function while(k Integer) returns Integer
		return k
	end 'while'

	export function match(k Integer) returns Integer
		return k
	end 'match'
end 'Span'

function main() returns ExitCode
	let s = Span.from(40)
	return s.end(2) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 40
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 2
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at keyword-named-INTERFACE-REQUIREMENTS-among-others.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
