  __slab_arena_list@248 = i64 0
  __slab_arena_map_l1@256 = i64 0
  __slab_state@264 = i64 0
}

func @square {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl Runtime.yield
    arm64.mul x0, x19, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
