// Test: async-scheduler.gt-recycle-a-reclaimed-struct-serves-the-next-spawn
typealias Integer = int(i64.min to i64.max)

function square(n Integer) returns Integer
	Runtime.yield()
	return n * n
end 'square'

function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 200 'rounds'
		let p = async square(i)
		sum = sum + await p
		i = i + 1
	end 'rounds'
	print("sum={sum} recycled={__Builtins.schedGtRecycleCount()}\n")
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
