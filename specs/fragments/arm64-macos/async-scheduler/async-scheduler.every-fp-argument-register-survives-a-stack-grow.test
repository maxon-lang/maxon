func @six {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.fcvtzs x0, d1
    arm64.fcvtzs x1, d2
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d3
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d4
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d5
    arm64.add x19, x0, x1
    arm64.fpLoadRdata d6, [rdata + __fconst_1]
    arm64.fcmp d0, d6
    arm64.b.pl ifcont
  base:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.fpLoadRdata d6, [rdata + __fconst_1]
    arm64.fsub d0, d0, d6
    arm64.bl six
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @fpArgs {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.bl __gt_resched
  __il_cont:
    arm64.fpLoadRdata d0, [rdata + __fconst_6]
    arm64.fpLoadRdata d1, [rdata + __fconst_1.5]
    arm64.fpLoadRdata d2, [rdata + __fconst_2.5]
    arm64.fpLoadRdata d3, [rdata + __fconst_3.5]
    arm64.fpLoadRdata d4, [rdata + __fconst_4.5]
    arm64.fpLoadRdata d5, [rdata + __fconst_5.5]
    arm64.bl six
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, fpArgs
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl __gt_await
    arm64.cmp x0, 105
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
