func @threadA {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.bl sleep
    arm64.movImm x0, 4
    arm64.bl sleep
    arm64.movImm x0, 79
    arm64.epilogue 16
    arm64.ret
}

func @threadB {
