    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_13  ; "panic at iterating-a-field-of-a-call-result-survives-a-rebind-of-that-field.test:8: Range check failed: value outside typealias 'Tally'\x0a"
