// Test: inline-records.is-on-an-inline-record-is-refused
typealias Half = int(0 to u32.max)

type Pair
	export let lo as Half
	export let hi as Half

	static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

function main() returns ExitCode
	let a = Pair.create(1, hi: 2)
	let b = Pair.create(1, hi: 2)
	if a is b 'same'
		return 1
	end 'same'
	return 0
end 'main'
---
CompilerError:
error E3068: <fragment>:16:7: 'is' requires reference types (structs), not primitive values
