// Test: inline-records.passed-and-returned-through-functions
typealias Half = int(0 to u32.max)

type Pair
	export let lo as Half
	export let hi as Half

	export static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

function bumped(p Pair) returns Pair
	return Pair.create(p.lo + 1, hi: p.hi + 1)
end 'bumped'

function main() returns ExitCode
	let a = Pair.create(1, hi: 10)

	let before = __Builtins.mmAllocLive()
	let b = bumped(a)
	let c = bumped(b)
	let after = __Builtins.mmAllocLive()

	if c.lo != 3 'lo'
		return 1
	end 'lo'

	if c.hi != 12 'hi'
		return 1
	end 'hi'

	if after != before 'alloc'
		return 2
	end 'alloc'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @bumped {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 4294967295
    arm64.and x1, x0, x1
    arm64.add x1, x1, 1
    arm64.lsr x0, x0, 32
    arm64.movImm x2, 4294967295
    arm64.and x0, x0, x2
    arm64.add x0, x0, 1
  __rc_chk#5:
    arm64.movImm x2, 4294967295
    arm64.cmp x1, x2
    arm64.b.gt __rc_panic#4
  __rc_chk#8:
    arm64.movImm x2, 4294967295
    arm64.cmp x0, x2
    arm64.b.gt __rc_panic#7
  __rc_ok:
    arm64.lsl x0, x0, 32
    arm64.orr x0, x1, x0
  __il_cont:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at inline-records.passed-and-returned-through-functions.test:8: Range check failed: value outside typealias 'Half'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_1  ; "panic at inline-records.passed-and-returned-through-functions.test:8: Range check failed: value outside typealias 'Half'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __rc_ok:
    arm64.movImm x19, 42949672961
  __il_cont:
    arm64.bl __mm_counter_alloc_live
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl bumped
    arm64.bl bumped
    arm64.movRegReg x19, x0
    arm64.bl __mm_counter_alloc_live
    arm64.movImm x1, 4294967295
    arm64.and x1, x19, x1
    arm64.cmp x1, 3
    arm64.b.eq ifcont#2
  lo:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.lsr x1, x19, 32
    arm64.movImm x2, 4294967295
    arm64.and x1, x1, x2
    arm64.cmp x1, 12
    arm64.b.eq ifcont#4
  hi:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.cmp x0, x20
    arm64.b.eq ifcont#6
  alloc:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
