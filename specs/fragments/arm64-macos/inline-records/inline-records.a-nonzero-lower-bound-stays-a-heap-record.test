// Test: inline-records.a-nonzero-lower-bound-stays-a-heap-record
typealias Tri = int(1 to 3)

type Duo
	export let a as Tri
	export let b as Tri

	export static function create(a Tri, b Tri) returns Self
		return Self{a: a, b: b}
	end 'create'
end 'Duo'

function main() returns ExitCode
	return sizeof(Duo)
end 'main'
---
ExitCode: 16
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16
    arm64.epilogue 16
    arm64.ret
}
