// Test: inline-records.array-of-inline-records-is-eight-byte-strided
typealias Half = int(0 to u32.max)

type Pair
	export let lo as Half
	export let hi as Half

	export static function create(lo Half, hi Half) returns Self
		return Self{lo: lo, hi: hi}
	end 'create'
end 'Pair'

typealias PairArray = Array with Pair

function main() returns ExitCode
	var arr = PairArray.create()
	arr.reserve(500)

	let before = __Builtins.mmAllocLive()
	for i in 0 upto 500 'push'
		arr.push(Pair.create(i, hi: i))
	end 'push'
	let after = __Builtins.mmAllocLive()

	if arr.managed.elementSize() != 8 'stride'
		return 2
	end 'stride'

	if after != before 'alloc'
		return 3
	end 'alloc'

	var sum = 0
	for p in arr 'read'
		sum = sum + p.lo
	end 'read'

	if sum != 124750 'values'
		return 4
	end 'values'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 500
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_capacity
    arm64.cmp x0, 500
    arm64.b.ge __il_cont#16
  grow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont#16
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __il_cont#16:
    arm64.bl __mm_counter_alloc_live
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.b forhdr#1
  __il_body:
    arm64.lsl x0, x21, 32
    arm64.orr x1, x21, x0
  __il_cont#24:
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep#3:
    arm64.add x21, x21, 1
  forhdr#1:
    arm64.cmp x21, 500
    arm64.b.lt __il_body
  forexit#4:
    arm64.bl __mm_counter_alloc_live
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_element_size
    arm64.cmp x0, 8
    arm64.b.eq ifcont#6
  stride:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#6:
    arm64.cmp x21, x20
    arm64.b.eq ifcont#8
  alloc:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.b forhdr#9
  read:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.movImm x5, 4294967295
    arm64.and x4, x4, x5
    arm64.add x0, x0, x4
  forstep#11:
    arm64.add x1, x1, 1
  forhdr#9:
    arm64.cmp x1, x2
    arm64.b.lt read
  forexit#12:
    arm64.movImm x16, 124750
    arm64.cmp x0, x16
    arm64.b.eq ifcont#14
  values:
    arm64.movImm x20, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#14:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
