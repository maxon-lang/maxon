// Test: a-commutative-op-whose-both-operands-survive-keeps-its-copy
typealias Word = int(i64.min to i64.max)

function classifyBoth(flags Word, n Word) returns Word
	let edge = n and 1
	let merged = flags or edge
	return merged + flags + edge
end 'classifyBoth'

function main() returns ExitCode
	var seen = 0
	for i in 0 upto 4 'feed'
		seen = seen + classifyBoth(i * 2, n: i)
	end 'feed'
	// merged+flags = 0,5,8,13; plus edge 0,1,0,1 -> 0,6,8,14 -> 28
	if seen != 28 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  forhdr:
    arm64.cmp x1, 4
    arm64.b.ge forexit
  feed:
    arm64.lsl x2, x1, 1
  __il_body:
    arm64.and x3, x1, 1
    arm64.orr x4, x2, x3
    arm64.add x2, x4, x2
    arm64.add x2, x2, x3
  __il_cont:
    arm64.add x0, x0, x2
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 28
    arm64.b.eq ifcont
  sum:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
