// Test: allocations-by-tag.an-untraced-build-tallies-nothing
typealias WidgetField = int(0 to 65536)

let Population = 1000
let TallyBuckets = 2048

type Widget
	export var low as WidgetField
	export var high as WidgetField

	export static function create(low WidgetField, high WidgetField) returns Widget
		return Widget{low: low, high: high}
	end 'create'
end 'Widget'

typealias Widgets = Array with Widget

function main() returns ExitCode
	var holder = Widgets.create()
	holder.reserve(Population)

	let totalBefore = __Builtins.mmAllocTotal()

	for k in 0 upto Population 'buildWidgets'
		holder.push(Widget.create((k mod 65536) as WidgetField, high: ((k + 1) mod 65536) as WidgetField))
	end 'buildWidgets'

	if __Builtins.mmAllocTotal() <= totalBefore 'theProgramAllocatedNothing'
		return 1
	end 'theProgramAllocatedNothing'

	for i in 0 upto TallyBuckets 'readCountBuckets'
		if __Builtins.mmAllocTotalByTag(i) != 0 'aCountBucketWasTallied'
			return 2
		end 'aCountBucketWasTallied'
	end 'readCountBuckets'

	for i in 0 upto TallyBuckets 'readByteBuckets'
		if __Builtins.mmAllocBytesByTag(i) != 0 'aByteBucketWasTallied'
			return 3
		end 'aByteBucketWasTallied'
	end 'readByteBuckets'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1000
  __rc_ok#31:
    arm64.movRegReg x0, x19
    arm64.bl __managed_capacity
    arm64.cmp x0, 1000
    arm64.b.ge __il_cont#25
  grow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont#25
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __il_cont#25:
    arm64.bl __mm_counter_alloc_total
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.b forhdr#1
  buildWidgets:
    arm64.asr x0, x21, 63
    arm64.lsr x0, x0, 48
    arm64.add x0, x21, x0
    arm64.asr x0, x0, 16
    arm64.lsl x0, x0, 16
    arm64.sub x22, x21, x0
  __rc_ok#19:
    arm64.add x0, x21, 1
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 48
    arm64.add x1, x0, x1
    arm64.asr x1, x1, 16
    arm64.lsl x1, x1, 16
    arm64.sub x23, x0, x1
  __rc_ok#38:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.storeBaseDispReg.word64 [x1 + 0], x22
    arm64.storeBaseDispReg.word64 [x1 + 8], x23
  __il_cont#33:
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep#3:
    arm64.add x21, x21, 1
  forhdr#1:
    arm64.cmp x21, 1000
    arm64.b.lt buildWidgets
  forexit#4:
    arm64.bl __mm_counter_alloc_total
    arm64.cmp x0, x20
    arm64.b.gt ifcont
  theProgramAllocatedNothing:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.b forhdr#7
  readCountBuckets:
    arm64.movRegReg x0, x20
    arm64.bl __mm_counter_alloc_total_by_tag
    arm64.cmp x0, 0
    arm64.b.eq forstep#9
  aCountBucketWasTallied:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  forstep#9:
    arm64.add x20, x20, 1
  forhdr#7:
    arm64.cmp x20, 2048
    arm64.b.lt readCountBuckets
  forexit#10:
    arm64.movImm x20, 0
    arm64.b forhdr#13
  readByteBuckets:
    arm64.movRegReg x0, x20
    arm64.bl __mm_counter_alloc_bytes_by_tag
    arm64.cmp x0, 0
    arm64.b.eq forstep#15
  aByteBucketWasTallied:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  forstep#15:
    arm64.add x20, x20, 1
  forhdr#13:
    arm64.cmp x20, 2048
    arm64.b.lt readByteBuckets
  forexit#16:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
