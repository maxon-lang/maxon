// Test: one-past-the-end-is-a-legal-fill-window-and-one-more-is-not
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var a = IntArray.create()
	for _ in 0 upto 4 'seed'
		a.push(0)
	end 'seed'

	// stop == length: the window reaches the end exactly, and applies.
	let whole = try a.managed.fill(0, count: 4, value: 3) otherwise 'wholeErr'
		return 1
	end 'wholeErr'
	if not whole 'wholeDeclined'
		return 2
	end 'wholeDeclined'

	// stop == length + 1: one element past, refused, and nothing written.
	try a.managed.fill(1, count: 4, value: 9) otherwise 'pastEnd'
		var sum = 0
		for v in a 'check'
			sum = sum + v
		end 'check'
		if sum != 12 'fillLanded'
			return 3
		end 'fillLanded'
		return 0
	end 'pastEnd'

	// The past-the-end fill was supposed to throw.
	return 4
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr#1:
    arm64.cmp x20, 4
    arm64.b.ge forexit#4
  seed:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.movImm x1, 0
    arm64.movImm x2, 4
    arm64.movImm x3, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_fill
    arm64.cmp x9, 0
    arm64.b.eq tryok#5
  tryerr#6:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#5:
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont#8
  wholeDeclined:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#8:
    arm64.movImm x1, 1
    arm64.movImm x2, 4
    arm64.movImm x3, 9
    arm64.movRegReg x0, x19
    arm64.bl __managed_fill
    arm64.cmp x9, 0
    arm64.b.eq tryok#9
  tryerr#10:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
  forhdr#11:
    arm64.cmp x1, x2
    arm64.b.ge forexit#14
  check:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x0, x0, x4
  forstep#13:
    arm64.add x1, x1, 1
    arm64.b forhdr#11
  forexit#14:
    arm64.cmp x0, 12
    arm64.b.eq ifcont#16
  fillLanded:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#16:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#9:
    arm64.movImm x20, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
