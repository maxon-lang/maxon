// Test: an-empty-container-refuses-every-index
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function probe(a IntArray) returns Int
	var hits = 0
	if (try a.managed.get(0) otherwise -1) != -1 'zero'
		hits = hits + 1
	end 'zero'
	if (try a.managed.get(1) otherwise -1) != -1 'one'
		hits = hits + 1
	end 'one'
	if (try a.managed.get(-1) otherwise -1) != -1 'negative'
		hits = hits + 1
	end 'negative'
	return hits
end 'probe'

function main() returns ExitCode
	var fresh = IntArray.create()
	if probe(fresh) != 0 'freshAdmittedSomething'
		return 1
	end 'freshAdmittedSomething'

	var emptied = IntArray.create()
	emptied.push(7)
	emptied.push(8)
	emptied.clear()
	if emptied.count() != 0 'clearedCount'
		return 2
	end 'clearedCount'
	if probe(emptied) != 0 'clearedAdmittedSomething'
		return 3
	end 'clearedAdmittedSomething'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @probe {
  entry:
    arm64.prologue 32
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.cmp x3, 0
    arm64.b.ls __im_slow#17
    arm64.b __im_load#18
  tryerr#2:
    arm64.movImm x2, 18446744073709551615
    arm64.b trycont#3
  __im_load#18:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
  trycont#3:
    arm64.cmp x2, -1
    arm64.b.eq ifcont#5
  zero:
    arm64.movImm x1, 1
  ifcont#5:
    arm64.movImm x2, 1
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.cmp x3, 1
    arm64.b.ls __im_slow#20
    arm64.b __im_load#21
  tryerr#7:
    arm64.movImm x2, 18446744073709551615
    arm64.b trycont#8
  __im_load#21:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 8
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
  trycont#8:
    arm64.cmp x2, -1
    arm64.b.eq ifcont#10
  one:
    arm64.add x1, x1, 1
  ifcont#10:
    arm64.movImm x2, 18446744073709551615
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.cmp x3, -1
    arm64.b.ls __im_slow#23
    arm64.b __im_load#24
  tryerr#12:
    arm64.movImm x0, 18446744073709551615
    arm64.b trycont#13
  __im_load#24:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, -8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont#13:
    arm64.cmp x0, -1
    arm64.b.eq critsplit
  negative:
    arm64.add x0, x1, 1
    arm64.b ifcont#15
  critsplit:
    arm64.movRegReg x0, x1
  ifcont#15:
    arm64.epilogue 32
    arm64.ret
  __im_slow#17:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
    arm64.b trycont#3
  __im_slow#20:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.ne tryerr#7
    arm64.b trycont#8
  __im_slow#23:
    arm64.storeSlotReg slot1, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.ne tryerr#12
    arm64.b trycont#13
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl probe
    arm64.cmp x0, 0
    arm64.b.eq ifcont#2
  freshAdmittedSomething:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 7
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 8
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
  __il_body:
    arm64.movRegReg x0, x20
    arm64.bl __managed_clear
  __il_cont:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.eq ifcont#4
  clearedCount:
    arm64.movImm x21, 2
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#4:
    arm64.movRegReg x0, x20
    arm64.bl probe
    arm64.cmp x0, 0
    arm64.b.eq ifcont#6
  clearedAdmittedSomething:
    arm64.movImm x21, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#6:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
