// Test: result-bound-to-a-let
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	let a = t() and t()
	let b = t() and f()
	let c = f() or t()
	var code = 0
	if a 'a'
		code = code + 1
	end 'a'
	if b 'b'
		code = code + 2
	end 'b'
	if c 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
  a:
    arm64.movImm x0, 1
  c:
    arm64.add x0, x0, 4
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
