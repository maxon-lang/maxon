// Test: nested-in-the-right-operand
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if f() or (t() and t()) 'a'
		code = code + 1
	end 'a'
	if t() and (f() or t()) 'b'
		code = code + 2
	end 'b'
	if f() or (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
  a:
    arm64.movImm x0, 1
  b:
    arm64.add x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
