// Test: comparison-operands
function main() returns ExitCode
	let x = 4
	let y = 0
	var code = 0
	if x > 0 and y > 0 'both'
		code = code + 1
	end 'both'
	if x > 0 or y > 0 'either'
		code = code + 2
	end 'either'
	if x > 0 and y == 0 'mixed'
		code = code + 4
	end 'mixed'
	return code
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  andrhs#1:
    arm64.movImm x1, 0
  scmerge#2:
    arm64.cbz x1, ifcont#4
  both:
    arm64.movImm x0, 1
  ifcont#4:
    arm64.movImm x1, 1
  scmerge#6:
    arm64.cbz x1, andrhs#9
  either:
    arm64.add x0, x0, 2
  andrhs#9:
    arm64.movImm x1, 1
  scmerge#10:
    arm64.cbz x1, ifcont#12
  mixed:
    arm64.add x0, x0, 4
  ifcont#12:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at comparison-operands.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
