    arm64.epilogue 32
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at generic-type-parameter-slots.function-value-element.test:31: Holder.first: one element was added\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
