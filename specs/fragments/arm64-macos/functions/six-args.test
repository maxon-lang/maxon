// Test: six-args
function sum6(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer) returns Integer
	return a + b + c + d + e + f
end 'sum6'

function main() returns ExitCode
	return sum6(1, b: 2, c: 3, d: 4, e: 5, f: 6)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 21
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 21
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
