// Test: subtract-order
function sub(a Integer, b Integer) returns Integer
	return a - b
end 'sub'

function main() returns ExitCode
	return sub(20, b: 8)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 12
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 12
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
