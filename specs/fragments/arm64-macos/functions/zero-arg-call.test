// Test: zero-arg-call
function answer() returns Integer
	return 42
end 'answer'

function main() returns ExitCode
	return answer()
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
