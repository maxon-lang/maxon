// Test: match-binding-return-plus-panic-arm
typealias Code = int(0 to 125)

union Op
	systemOp(x Code)
	callOp
end 'Op'

function pick(o Op) returns Code
	match o 'm'
		systemOp(v) then return v
		callOp then panic("no")
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(Op.systemOp(3))
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-binding-return-plus-panic-arm.test:12: no\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.b __il_cont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  __il_slow:
    arm64.movRegReg x0, x20
    arm64.bl pick
    arm64.movRegReg x19, x0
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
