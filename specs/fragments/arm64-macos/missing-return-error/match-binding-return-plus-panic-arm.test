// Test: match-binding-return-plus-panic-arm
typealias Code = int(0 to 125)

union Op
	systemOp(x Code)
	callOp
end 'Op'

function pick(o Op) returns Code
	match o 'm'
		systemOp(v) then return v
		callOp then panic("no")
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(Op.systemOp(3))
end 'main'
---
ExitCode: 3
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.movImm x1, 0
  __il_body:
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  __il_cont:
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-binding-return-plus-panic-arm.test:12: no\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}
