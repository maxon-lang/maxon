// Test: error.struct-literal-initializer-at-file-scope
typealias Count = int(0 to u64.max)

type Pair
	export var a as Count
	export var b as Count
end 'Pair'

let origin = Pair{a: 1, b: 2}

function main() returns ExitCode
	print("{origin.a}")
	return 0
end 'main'
---
CompilerError:
error E3076: <fragment>:9:19: type 'Pair' can only be constructed from within its own methods; use a static factory method instead
