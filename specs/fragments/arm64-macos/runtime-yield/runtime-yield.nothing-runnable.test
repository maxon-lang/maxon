// Test: runtime-yield.nothing-runnable
typealias Integer = int(i64.min to i64.max)

function lonely() returns Integer
	var i = 0
	while i < 100 'l'
		Runtime.yield()
		i = i + 1
	end 'l'
	return 7
end 'lonely'

function main() returns ExitCode
	let p = async lonely()
	return await p as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_timer_seq@56 = i64 0
  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_proc_wait_snapshot@96 = i64 0
  __gt_proc_poller@104 = i64 0
  __gt_live_count@112 = i64 0
  __sched_progress@120 = i64 0
  __sched_active_workers@128 = i64 1
  __sched_max_active_workers@136 = i64 1
  __sched_tls_index@144 = i64 0
  __sched_tls_teb_offset@152 = i64 0
  __sched_procs@160 = i64 0
  __sched_allm@168 = i64 0
  __sched_midle@176 = i64 0
  __sched_pidle@184 = i64 0
  __sched_num_procs@192 = i64 0
  __sched_shutdown_flag@200 = i64 0
  __sched_lock@208 = i64 0
  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __sched_sysmon_started@232 = i64 0
  __slab_arena_list@240 = i64 0
  __slab_arena_map_l1@248 = i64 0
  __slab_state@256 = i64 0
}

func @lonely {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  whilehdr:
    arm64.cmp x19, 100
    arm64.b.ge whileexit
  l:
    arm64.bl Runtime.yield
    arm64.add x19, x19, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x0, 7
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, lonely
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl __gt_await
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at runtime-yield.nothing-runnable.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
