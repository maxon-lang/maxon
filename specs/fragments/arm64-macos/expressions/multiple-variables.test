// Test: multiple-variables
function main() returns ExitCode
	let x = 42
	let y = 10
	let result = x + y
	return result
end 'main'
---
ExitCode: 52
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 52
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
