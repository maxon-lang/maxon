// Test: jump-table.enum-with-associated-values
typealias ID = int(i64.min to i64.max)

union Shape
		circle(r ID)
		square(s ID)
		triangle(b ID, h ID)
		rectangle(w ID, h ID)
end 'Shape'

function describe(s Shape) returns String
		return match s 'sh'
				circle gives "circle"
				square gives "square"
				triangle gives "triangle"
				rectangle gives "rectangle"
		end 'sh'
end 'describe'

function main() returns ExitCode
		print(describe(Shape.triangle(3, h: 4)))
		print(describe(Shape.circle(5)))
		print(describe(Shape.rectangle(2, h: 3)))
		print(describe(Shape.square(4)))
		return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @describe {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.jumpTable x0, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_8
  matchdead:
  matcharm#1:
    arm64.leaRdata x0, __str_rec_4  ; "circle"
    arm64.b matchcont
  matcharm#2:
    arm64.leaRdata x0, __str_rec_5  ; "square"
    arm64.b matchcont
  matcharm#3:
    arm64.leaRdata x0, __str_rec_6  ; "triangle"
    arm64.b matchcont
  matcharm#4:
    arm64.leaRdata x0, __str_rec_7  ; "rectangle"
  matchcont:
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
    arm64.movImm x20, 4
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 2
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x19
    arm64.storeBaseDispReg.word64 [x21 + 16], x20
    arm64.movRegReg x0, x21
    arm64.bl describe
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl print
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movImm x19, 5
