// Test: div-simple
function main() returns ExitCode
	return 20 / 4
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 62
    arm64.add x0, x0, 20
    arm64.asr x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
