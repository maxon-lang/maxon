// Test: an-unsigned-divisor-above-the-signed-range-is-refused
typealias Unsigned = bits(64)
typealias UPosDivisor = int(2 to u64.max)

function refUDiv(n Unsigned, d UPosDivisor) returns Unsigned
	return try (n / (d as Unsigned)) otherwise panic("d is never zero")
end 'refUDiv'

function refUMod(n Unsigned, d UPosDivisor) returns Unsigned
	return try (n mod (d as Unsigned)) otherwise panic("d is never zero")
end 'refUMod'

function main() returns ExitCode
	let huge = ((9223372036854775807 as Unsigned) + (9223372036854775793 as Unsigned)) as Unsigned
	let a = ((9223372036854775807 as Unsigned) + 1000) as Unsigned
	if a / huge != refUDiv(a, d: huge as UPosDivisor) 'quotient'
		return 1
	end 'quotient'
	if a mod huge != refUMod(a, d: huge as UPosDivisor) 'remainder'
		return 2
	end 'remainder'
	if a / huge != 0 'quotientIsZero'
		return 3
	end 'quotientIsZero'
	if a mod huge != a 'remainderIsTheDividend'
		return 4
	end 'remainderIsTheDividend'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 18446744073709551600
    arm64.movImm x1, 9223372036854776807
    arm64.udiv x2, x1, x0
  __rc_ok#19:
    arm64.movImm x3, 18446744073709551600
    arm64.udiv x3, x1, x3
  __il_cont#15:
    arm64.cmp x2, x3
    arm64.b.eq ifcont#2
  quotient:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.udiv x16, x1, x0
    arm64.msub x2, x16, x0, x1
  __rc_ok#26:
    arm64.movImm x3, 9223372036854776807
    arm64.movImm x4, 18446744073709551600
    arm64.udiv x16, x3, x4
    arm64.msub x3, x16, x4, x3
  __il_cont#22:
    arm64.cmp x2, x3
    arm64.b.eq ifcont#4
  remainder:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.udiv x2, x1, x0
    arm64.cmp x2, 0
    arm64.b.eq ifcont#6
  quotientIsZero:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.udiv x16, x1, x0
    arm64.msub x0, x16, x0, x1
    arm64.cmp x0, x1
    arm64.b.eq ifcont#8
  remainderIsTheDividend:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
