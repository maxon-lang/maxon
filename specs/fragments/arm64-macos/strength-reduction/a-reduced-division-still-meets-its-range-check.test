// Test: a-reduced-division-still-meets-its-range-check
typealias Small = int(0 to 10)

function narrow(x Small) returns Small
	return x
end 'narrow'

function main() returns ExitCode
	var last = 0
	for i in 1000 to 1000 'once'
		last = narrow(i / 3)
	end 'once'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
func @narrow {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 10
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-reduced-division-still-meets-its-range-check.test:4: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.movImm x19, 1000
  forhdr:
    arm64.cmp x19, 1000
    arm64.b.gt forexit
  once:
    arm64.movImm x0, 6148914691236517206
    arm64.smulh x0, x0, x19
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
  __il_body:
    arm64.cmp x0, 0
    arm64.b.lt __il_slow
  __rc_chk#11:
    arm64.cmp x0, 10
    arm64.b.le forstep
  __il_slow:
    arm64.bl narrow
  forstep:
    arm64.add x19, x19, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk#7:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-reduced-division-still-meets-its-range-check.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
