// Test: two-files-private-aliases-of-one-name-over-different-primitives
// --- file: a.maxon
typealias Measure = int(0 to 100)

export function fromA() returns ExitCode
	let m = 41 as Measure
	return m + 1
end 'fromA'

// --- file: b.maxon
typealias Measure = float(0.0 to 1.0)

export function fromB() returns ExitCode
	let m = 0.5 as Measure
	return trunc(m * 2.0)
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	return fromA() + fromB()
end 'main'
---
ExitCode: 43
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok#7:
    arm64.movImm x0, 42
  __il_cont:
    arm64.add x0, x0, 1
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
