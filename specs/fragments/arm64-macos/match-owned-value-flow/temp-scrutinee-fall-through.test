// Test: temp-scrutinee-fall-through
typealias Integer = int(i64.min to i64.max)

union Num
	zero
	val(n Integer)
end 'Num'

function main() returns ExitCode
	match Num.val(5) 'check'
		zero then print("z")
		val then print("v")
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.leaRdata x0, __str_rec_2  ; "z"
    arm64.bl print
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.leaRdata x0, __str_rec_3  ; "v"
    arm64.bl print
  matchcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
