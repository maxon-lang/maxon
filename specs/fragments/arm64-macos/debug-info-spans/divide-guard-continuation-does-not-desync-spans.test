// Test: divide-guard-continuation-does-not-desync-spans
typealias Num = int(0 to 1000)

function pick(x Num) returns Num
	return x
end 'pick'

function main() returns ExitCode
	print("before\n")
	let n = pick(10)
	let d = pick(0)
	let q = try (n / d) otherwise 77
	print("after\n")
	return q as ExitCode
end 'main'
---
ExitCode: 77
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_2  ; "before\x0a"
    arm64.bl print
    arm64.movImm x0, 10
  __il_cont:
    arm64.movImm x1, 1
    arm64.udiv x0, x0, x1
  tryerr:
    arm64.movImm x19, 77
  trycont:
    arm64.leaRdata x0, __str_rec_3  ; "after\x0a"
    arm64.bl print
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
