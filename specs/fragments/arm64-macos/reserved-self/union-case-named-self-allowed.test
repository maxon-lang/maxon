// Test: union-case-named-self-allowed
typealias Tally = int(0 to 125)

union Node
	leaf(value Tally)
	self
end 'Node'

function pick(n Node) returns Tally
	return match n 'm'
		leaf(v) gives v
		self gives 7
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(Node.self)
end 'main'
---
ExitCode: 7
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
  __il_body:
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#3:
    arm64.movRegReg x0, x1
    arm64.b __il_cont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#4:
    arm64.movImm x0, 7
  __il_cont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
