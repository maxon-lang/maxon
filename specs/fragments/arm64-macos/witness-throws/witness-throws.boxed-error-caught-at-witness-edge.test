// Test: witness-throws.boxed-error-caught-at-witness-edge
typealias Code = int(0 to u32.max)

union CheckError implements Error
	tooSmall(limit Code)
end 'CheckError'

interface Checked
	function check() returns Code throws CheckError
end 'Checked'

type Point implements Checked
	export var x as Code
	export static function create(x Code) returns Self
		return Self{ x: x }
	end 'create'
	export function check() returns Code throws CheckError
		if self.x < 10 'small'
			throw CheckError.tooSmall(7)
		end 'small'
		return self.x
	end 'check'
end 'Point'

type Box uses T where T is Checked
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function itemCheck() returns Code
		var out = 1 as Code
		try self.item.check() otherwise (e) 'caught'
			match e 'k'
				tooSmall(limit) then out = limit + 1
			end 'k'
		end 'caught'
		return out
	end 'itemCheck'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let b = PointBox.create(Point.create(3))
	return b.itemCheck()
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Point.check {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 10
    arm64.b.ge ifcont
  small:
    arm64.movImm x19, 7
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
  __rc_ok#8:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#6:
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __witness_Point.Checked
  __il_body#11:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
  __il_cont#5:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.leaRdata x1, __witness_Point.Checked
  __il_body#12:
    arm64.movImm x19, 1
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 8]
    arm64.add x19, x0, 1
  matchcont:
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.b trycont
  matchdead:
  tryok:
  trycont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#20
  __rc_chk#21:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.b.gt __rc_panic#20
  __rc_chk#3:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic#2
  __rc_ok#1:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Box_Point
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic#20:
    arm64.leaRdata x0, __str_blob_2  ; "panic at witness-throws.boxed-error-caught-at-witness-edge.test:37: Range check failed: value outside typealias 'Code'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
