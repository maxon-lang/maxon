// Test: error.fromRawValue-type-mismatch
enum HttpStatus
	ok = 200
	notFound = 404
end 'HttpStatus'

function main() returns ExitCode
	_ = try HttpStatus.fromRawValue("404") otherwise HttpStatus.ok
	return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:8:34: type mismatch: 'expected int, got String'
