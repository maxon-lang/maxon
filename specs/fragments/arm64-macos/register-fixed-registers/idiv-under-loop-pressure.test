// Test: idiv-under-loop-pressure

function press(p Integer) returns Integer
	let k1 = p + 11
	let k2 = p + 12
	let k3 = p + 13
	let k4 = p + 14
	let k5 = p + 15
	let k6 = p + 16
	let k7 = p + 17
	let k8 = p + 18
	let k9 = p + 19
	var sum = 0
	var i = 1
	while i <= 5 'loop'
		let t = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9
		sum = sum + (try (t / i) otherwise panic("i is never zero"))
		i = i + 1
	end 'loop'
	return sum
end 'press'

function main() returns ExitCode
	let r = press(0)
	if r == 307 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.b whilehdr
  loop:
    arm64.movImm x2, 135
    arm64.movImm x3, 9223372036854775943
    arm64.movImm x16, 18446744073709551615
    arm64.eor x4, x1, x16
    arm64.orr x3, x3, x4
    arm64.cmp x3, 0
    arm64.b.eq divovf
  divok:
    arm64.sdiv x2, x2, x1
  tryok:
    arm64.add x0, x0, x2
    arm64.add x1, x1, 1
  whilehdr:
    arm64.cmp x1, 5
    arm64.b.le loop
  __il_cont:
    arm64.cmp x0, 307
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  divovf:
    arm64.leaRdata x0, __str_blob_0  ; "panic: integer overflow\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
