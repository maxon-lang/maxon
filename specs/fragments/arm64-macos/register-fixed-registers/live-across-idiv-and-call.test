// Test: live-across-idiv-and-call
function sink(x Integer) returns Integer
	return x + 1
end 'sink'

function f(p Integer) returns Integer
	let a = p + 100
	let q = a / 7
	let s = sink(3)
	return a + q + s
end 'f'

function main() returns ExitCode
	let v = f(0)
	if v == 118 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 100
    arm64.movImm x1, 5270498306774157605
    arm64.smulh x0, x1, x0
    arm64.asr x0, x0, 1
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
  __il_cont#5:
    arm64.add x0, x0, 100
    arm64.add x0, x0, 4
  __il_cont#3:
    arm64.cmp x0, 118
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
