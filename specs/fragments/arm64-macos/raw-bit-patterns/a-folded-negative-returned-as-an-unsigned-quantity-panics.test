// Test: a-folded-negative-returned-as-an-unsigned-quantity-panics
typealias Count = int(0 to u64.max)

function below() returns Count
	let d = 2
	return d - 3
end 'below'

function main() returns ExitCode
	print("{below()}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
  __mrt_program_started@8 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-folded-negative-returned-as-an-unsigned-quantity-panics.test:6: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
