// Test: an-unsigned-quantity-refuses-its-own-bit-63-values-at-a-door
typealias Count = int(0 to u64.max)

function take(c Count) returns Count
	return c
end 'take'

function main() returns ExitCode
	let extreme = u64.max as Count
	print("{take(extreme)}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at an-unsigned-quantity-refuses-its-own-bit-63-values-at-a-door.test:4: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
