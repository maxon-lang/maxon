    arm64.b.eq __im_slow
  critsplit#29:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  critsplit#28:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.leaRdata x0, __str_rec_3  ; "?"
  trycont:
    arm64.bl __str_retain
  __il_body#27:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
  __il_cont#26:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
