// Test: match-expr-result-from-payload-binding-arm
typealias Idx = int(0 to 100)

union Op
	none
	alloc(name ByteArray)
end 'Op'

function firstByte(b ByteArray) returns Idx
	return try b.get(0) otherwise 0 as Idx
end 'firstByte'

function nameOf(op Op) returns Idx
	let n = match op 'pick'
		alloc(name) gives name
		default panic("none")
	end 'pick'
	return firstByte(n)
end 'nameOf'

function main() returns ExitCode
	var b = ByteArray.create()
	b.push(65)
	return nameOf(Op.alloc(b))
end 'main'
---
ExitCode: 65
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @firstByte {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load#13:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x2, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load#14:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
  __im_loaded:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.b.eq __im_cont
  __im_empty:
    arm64.cmp x2, 0
    arm64.b.ne __im_cont
  __im_slow:
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.movRegReg x3, x9
  __im_cont:
    arm64.cmp x3, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x2
  trycont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at match-expr-result-from-payload-binding-arm.test:10: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @nameOf {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 1
    arm64.b.ne matchdefault
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl firstByte
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-expr-result-from-payload-binding-arm.test:16: none\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 65
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movRegReg x0, x20
    arm64.bl nameOf
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Op
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
