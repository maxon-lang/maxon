// Test: builtins-cpu-parallel.cpu-count-body-is-runtime-source
function main() returns ExitCode
	let first = __Builtins.cpuCount()
	let second = __Builtins.cpuCount()
	var score = 0
	if first >= 1 'atLeastOne'
		score = score + 1
	end 'atLeastOne'
	if second == first 'stable'
		score = score + 1
	end 'stable'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __cpu_count
    arm64.movRegReg x19, x0
    arm64.bl __cpu_count
    arm64.movImm x1, 0
    arm64.cmp x19, 1
    arm64.b.lt ifcont
  atLeastOne:
    arm64.movImm x1, 1
  ifcont:
    arm64.cmp x0, x19
    arm64.b.ne critsplit
  stable:
    arm64.add x0, x1, 1
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x1
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @__cpu_count {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 58
    arm64.importCall 7
    arm64.cmp x0, 1
    arm64.b.ge ifcont
  belowFloor:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
