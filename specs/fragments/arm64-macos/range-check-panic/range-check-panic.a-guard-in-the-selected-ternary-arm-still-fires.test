// Test: range-check-panic.a-guard-in-the-selected-ternary-arm-still-fires
typealias Wide = int(0 to u64.max)
typealias Small = int(0 to 100)

function widen(n Wide) returns Wide
  return n * 100
end 'widen'

function pick(i Wide, flag bool) returns Small
  return (i as Small) if flag else 7
end 'pick'

function main() returns ExitCode
  return pick(widen(5), flag: true)
end 'main'
---
ExitCode: 1
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.cbz x1, ternaryfalse
  ternarytrue:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#5
  __rc_chk#6:
    arm64.cmp x0, 100
    arm64.b.le matchcont
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.a-guard-in-the-selected-ternary-arm-still-fires.test:10: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ternaryfalse:
    arm64.movImm x0, 7
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#8
  __rc_chk#9:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic#8:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.a-guard-in-the-selected-ternary-arm-still-fires.test:10: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 500
  __il_cont#2:
    arm64.movImm x1, 1
  __il_slow:
    arm64.bl pick
  __il_cont#1:
    arm64.epilogue 16
    arm64.ret
}
