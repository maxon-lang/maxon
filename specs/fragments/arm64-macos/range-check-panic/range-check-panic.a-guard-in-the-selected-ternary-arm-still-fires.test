// Test: range-check-panic.a-guard-in-the-selected-ternary-arm-still-fires
typealias Wide = int(0 to u64.max)
typealias Small = int(0 to 100)

function widen(n Wide) returns Wide
  return n * 100
end 'widen'

function pick(i Wide, flag bool) returns Small
  return (i as Small) if flag else 7
end 'pick'

function main() returns ExitCode
  return pick(widen(5), flag: true)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at range-check-panic.a-guard-in-the-selected-ternary-arm-still-fires.test:10: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
