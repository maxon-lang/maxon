// Test: range-check-panic.a-wider-parameter-does-not-prove-a-narrower-one
typealias Integer = int(i64.min to i64.max)
typealias RegNum = int(0 to 63)
typealias Wide = int(0 to 1000)

function weigh(table Integer, regNum RegNum) returns Integer
  return table + (regNum as Integer)
end 'weigh'

function twice(table Integer, reg Wide) returns Integer
  return weigh(table, regNum: reg as RegNum) + weigh(table, regNum: reg as RegNum)
end 'twice'

function main() returns ExitCode
  print("t={twice(1, reg: 200)}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "t="
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __rc_panic:
    arm64.leaRdata x0, __str_blob_7  ; "panic at range-check-panic.a-wider-parameter-does-not-prove-a-narrower-one.test:11: Range check failed: value outside typealias 'RegNum'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
