// Test: range-check-panic.return-through-a-narrower-alias-is-still-guarded
typealias Wide = int(0 to 100)
typealias Narrow = int(0 to 10)

function narrow(x Wide) returns Narrow
  return x
end 'narrow'

function main() returns ExitCode
  return narrow(50)
end 'main'
---
ExitCode: 1
---
func @narrow {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.return-through-a-narrower-alias-is-still-guarded.test:5: Range check failed: value outside typealias 'Wide'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.cbnz x1, __rc_panic#5
  __rc_chk#6:
    arm64.cmp x0, 10
    arm64.b.le __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at range-check-panic.return-through-a-narrower-alias-is-still-guarded.test:6: Range check failed: value outside typealias 'Narrow'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 50
  __il_slow:
    arm64.bl narrow
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
