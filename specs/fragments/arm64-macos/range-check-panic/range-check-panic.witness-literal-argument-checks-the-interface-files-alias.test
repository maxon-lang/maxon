    arm64.cmp x1, 100
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.and x0, x0, 255
    arm64.cmp x1, x0
    arm64.b.le ifcont
  above:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a.maxon:14: Range check failed: value outside typealias 'Item'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#12:
    arm64.movImm x19, 0
  __il_cont#11:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __witness_Shelf.Store
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x20 + 8]
    arm64.movImm x1, 50
    arm64.loadRegBaseDisp.word64 x16, [x2 + 48]
    arm64.blr x16
  __il_cont#5:
    arm64.cmp x0, 50
    arm64.movImm x0, 0
