// Test: range-check-panic.a-nested-full-unsigned-alias-parameter-admits-its-top-value
typealias Integer = int(i64.min to i64.max)

type Meter
  let reading as Integer

  static function create() returns Self
    return Self{reading: 0}
  end 'create'

  function raw() returns Integer
    return self.reading
  end 'raw'
end 'Meter'

extension Meter
  typealias Wide = int(0 to u64.max)

  function take(w Wide) returns bool
    return w == u64.max
  end 'take'
end 'Meter'

function main() returns ExitCode
  let meter = Meter.create()
  if meter.take(u64.max) and meter.raw() == 0 'top'
    return 0
  end 'top'
  return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body#7:
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
  __il_cont:
    arm64.cmp x1, 0
    arm64.cset x1, eq
  scmerge:
    arm64.cbz x1, ifcont
  top:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
