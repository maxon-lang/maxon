// Test: range-check-panic.lower-bound
typealias Integer = int(i64.min to i64.max)
typealias Natural = int(0 to i64.max)

function check(n Natural) returns Natural
  return n
end 'check'

function neg(n Integer) returns Integer
  return -n
end 'neg'

function main() returns ExitCode
  let below = neg(1)
  return check(below)
end 'main'
---
ExitCode: 1
---
func @check {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.lower-bound.test:5: Range check failed: value outside typealias 'Natural'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 18446744073709551615
  __il_slow:
    arm64.bl check
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at range-check-panic.lower-bound.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
