// Test: range-check-panic.return-of-a-reassigned-shadow-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 10)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function check(x SmallInt) returns SmallInt
  var y = x
  y = opaque(99)
  return y
end 'check'

function main() returns ExitCode
  return check(5)
end 'main'
---
ExitCode: 1
---
func @check {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#2
  __rc_chk:
    arm64.cmp x0, 10
    arm64.b.le __rc_panic#5
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.return-of-a-reassigned-shadow-is-still-guarded.test:9: Range check failed: value outside typealias 'SmallInt'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at range-check-panic.return-of-a-reassigned-shadow-is-still-guarded.test:12: Range check failed: value outside typealias 'SmallInt'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl check
    arm64.epilogue 16
    arm64.ret
}
