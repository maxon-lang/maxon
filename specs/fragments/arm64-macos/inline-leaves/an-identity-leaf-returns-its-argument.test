// Test: an-identity-leaf-returns-its-argument
typealias Integer = int(i64.min to i64.max)

function identity(a Integer) returns Integer
	return a
end 'identity'

function main() returns ExitCode
	return identity(42) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
