// Test: the-inlined-guard-still-panics-with-the-callees-frame
typealias Percent = int(0 to 100)

function clampPct(x Percent) returns Percent
	return x
end 'clampPct'

function main() returns ExitCode
	var last = 0
	for i in 1 to 1 'once'
		last = clampPct(i * 101)
	end 'once'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
  once:
    arm64.movImm x16, 101
    arm64.mul x0, x0, x16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at the-inlined-guard-still-panics-with-the-callees-frame.test:4: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
