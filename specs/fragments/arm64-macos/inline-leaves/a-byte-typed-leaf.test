// Test: a-byte-typed-leaf
typealias Integer = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)

function doubled(b Byte) returns Integer
	return b + b
end 'doubled'

function main() returns ExitCode
	return doubled(21 as Byte) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok#6:
    arm64.movImm x0, 42
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
