// Test: a-pure-leaf-is-inlined
typealias RegNum = int(0 to 63)
typealias RegMask = int(0 to u64.max)

function maskContains(mask RegMask, regNum RegNum) returns bool
	return ((mask shr regNum) and 1) != 0
end 'maskContains'

function main() returns ExitCode
	let mask = 5 as RegMask
	var count = 0
	var i = 0
	while i < 8 'each'
		if maskContains(mask, regNum: i as RegNum) 'set'
			count = count + 1
		end 'set'
		i = i + 1
	end 'each'
	return count as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.b whilehdr
  __rc_ok#16:
    arm64.lsrv x3, x0, x2
    arm64.and x3, x3, 1
    arm64.cmp x3, 0
    arm64.cset x3, ne
  __il_cont:
    arm64.cbz x3, ifcont
  set:
    arm64.add x1, x1, 1
  ifcont:
    arm64.add x2, x2, 1
  whilehdr:
    arm64.cmp x2, 8
    arm64.b.lt __rc_ok#16
  whileexit:
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok#9:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-pure-leaf-is-inlined.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
