// Test: a-leaf-with-a-store-is-copied-whole
typealias Integer = int(i64.min to i64.max)

type Minter
	export var next as Integer

	export static function create() returns Self
		return Self{next: 0}
	end 'create'

	export function mint() returns Integer
		let id = self.next
		self.next = self.next + 1
		return id
	end 'mint'
end 'Minter'

function main() returns ExitCode
	var m = Minter.create()
	let a = m.mint()
	let b = m.mint()
	let c = m.mint()
	return (a + b + c + 39) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body#5:
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.add x3, x3, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x3
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x4, [x0 + 0]
    arm64.add x4, x4, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x4
  __il_cont:
    arm64.add x1, x1, x2
    arm64.add x1, x1, x3
    arm64.add x19, x1, 39
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-leaf-with-a-store-is-copied-whole.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
