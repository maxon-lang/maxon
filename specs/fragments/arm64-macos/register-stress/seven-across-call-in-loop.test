// Test: seven-across-call-in-loop
function bump(x Integer) returns Integer
	return x + 1
end 'bump'

function sevenAcross(p Integer) returns Integer
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var a5 = p + 5
	var a6 = p + 6
	var a7 = p + 7
	var i = 0
	while i < 3 'loop'
		let d = bump(i)
		a1 = a1 + d
		a2 = a2 + d
		a3 = a3 + d
		a4 = a4 + d
		a5 = a5 + d
		a6 = a6 + d
		a7 = a7 + d
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4 + a5 + a6 + a7
end 'sevenAcross'

function main() returns ExitCode
	let r = sevenAcross(0)
	if r == 70 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body#4:
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x3, 4
    arm64.movImm x4, 5
    arm64.movImm x5, 6
    arm64.movImm x6, 7
    arm64.movImm x7, 0
    arm64.b whilehdr
  __il_body#9:
    arm64.add x7, x7, 1
  __il_cont#8:
    arm64.add x0, x0, x7
    arm64.add x1, x1, x7
    arm64.add x2, x2, x7
    arm64.add x3, x3, x7
    arm64.add x4, x4, x7
    arm64.add x5, x5, x7
    arm64.add x6, x6, x7
  whilehdr:
    arm64.cmp x7, 3
    arm64.b.lt __il_body#9
  whileexit:
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x3
    arm64.add x0, x0, x4
    arm64.add x0, x0, x5
    arm64.add x0, x0, x6
  __il_cont#3:
    arm64.cmp x0, 70
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
