// Test: nested-loops-pressure-at-depth-two
function depthTwo(p Integer) returns Integer
	let k1 = p + 1
	let k2 = p + 2
	let k3 = p + 3
	let k4 = p + 4
	let k5 = p + 5
	let k6 = p + 6
	let k7 = p + 7
	let k8 = p + 8
	let k9 = p + 9
	let k10 = p + 10
	let k11 = p + 11
	let k12 = p + 12
	var sum = 0
	var i = 0
	while i < 3 'outer'
		var j = 0
		while j < 3 'inner'
			sum = sum + j
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return sum + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + k12
end 'depthTwo'

function main() returns ExitCode
	let r = depthTwo(0)
	if r == 87 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @depthTwo {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x3, x0, 3
    arm64.add x4, x0, 4
    arm64.add x5, x0, 5
    arm64.add x6, x0, 6
    arm64.add x7, x0, 7
    arm64.add x8, x0, 8
    arm64.add x9, x0, 9
    arm64.add x10, x0, 10
    arm64.add x11, x0, 11
    arm64.add x0, x0, 12
    arm64.movImm x12, 0
    arm64.movImm x13, 0
  whilehdr#1:
    arm64.cmp x13, 3
    arm64.b.ge whileexit#3
  outer:
    arm64.movImm x14, 0
  whilehdr#4:
    arm64.cmp x14, 3
    arm64.b.ge whileexit#6
  inner:
    arm64.add x12, x12, x14
    arm64.add x14, x14, 1
    arm64.b whilehdr#4
  whileexit#6:
    arm64.add x13, x13, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.add x1, x12, x1
    arm64.add x1, x1, x2
    arm64.add x1, x1, x3
    arm64.add x1, x1, x4
    arm64.add x1, x1, x5
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
    arm64.add x1, x1, x9
    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl depthTwo
    arm64.cmp x0, 87
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
