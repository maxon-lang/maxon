// Test: mod-by-zero
typealias Integer = int(i64.min to i64.max)

function opaque(x Integer) returns Integer
	return x
end 'opaque'

function main() returns ExitCode
	let zero = opaque(0)
	let result = try (5 mod zero) otherwise 7
	return result as ExitCode
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont:
    arm64.movImm x0, 5
    arm64.movImm x1, 1
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
  tryerr:
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
