// Test: divide-by-zero-premise-enforced-at-the-callee-entry
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function ident(v Integer) returns Integer
	return v
end 'ident'

function divide(n NonZero, d NonZero) returns Integer
	return (n / d) as Integer
end 'divide'

function main() returns ExitCode
	z = ident(0)
	return divide(10, d: z) as ExitCode
end 'main'
var z = 0
---
ExitCode: 1
---
data {
  __data_z@0 = i64 0
}

func @divide {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 1
    arm64.b.ge __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:9: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.cmp x1, 1
    arm64.b.ge __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_0  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:9: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#3:
    arm64.udiv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  __il_cont:
    arm64.leaGlobal x1, __data_z
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 10
    arm64.leaGlobal x1, __data_z
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.bl divide
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
