}

func @bySignal {
  entry:
    arm64.prologue 16
    arm64.lsl x0, x0, 56
    arm64.asr x0, x0, 56
    arm64.lsl x1, x1, 56
    arm64.asr x1, x1, 56
    arm64.cmp x0, x1
    arm64.b.ge ifcont#2
  less:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.cmp x0, x1
    arm64.b.le ifcont#4
  greater:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @markNegative {
  entry:
    arm64.prologue 16
    arm64.lsl x0, x0, 56
    arm64.asr x0, x0, 56
    arm64.cmp x0, 0
    arm64.b.ge ifcont
  wasNegative:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
