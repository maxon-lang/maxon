// Test: nested-enum-array-push-get
typealias Integer = int(i64.min to i64.max)

union CfOp
		br(target Integer)
		condBr(cond Integer)
end 'CfOp'

union IrOp
		cf(op CfOp)
		arith(value Integer)
end 'IrOp'

typealias IrOpArray = Array with IrOp

function checkFirst(ops IrOpArray) returns Integer
		let first = try ops.get(0) otherwise IrOp.arith(0)
		match first 'checkFirst'
				arith(v) then return v
				cf then return 99
		end 'checkFirst'
end 'checkFirst'

function checkMid(ops IrOpArray) returns Integer
		let mid = try ops.get(2) otherwise IrOp.arith(0)
		match mid 'checkMid'
				cf then return 1
				arith then return 0
		end 'checkMid'
end 'checkMid'

function main() returns ExitCode
		var ops = IrOpArray.create()
		ops.push(IrOp.arith(10))
		ops.push(IrOp.arith(20))
		ops.push(IrOp.cf(CfOp.br(99)))
		ops.push(IrOp.arith(30))
		ops.push(IrOp.arith(40))

		if ops.count() != 5 'badCount'
				return 1
		end 'badCount'

		// First element must still be arith(10), not overwritten
		let v = checkFirst(ops)
		if v != 10 'wrong'
				return 2
		end 'wrong'

		// Middle element must be cf variant
		let m = checkMid(ops)
		if m != 1 'wrongMid'
				return 3
		end 'wrongMid'

		return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @checkFirst {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x2 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x0 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#13
  __im_empty:
    arm64.cmp x19, 0
    arm64.b.ne critsplit#14
  __im_slow:
    arm64.bl __managed_get
    arm64.movRegReg x19, x0
    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#13:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#5:
    arm64.movImm x19, 99
    arm64.bl __destruct_IrOp
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#4:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.bl __destruct_IrOp
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}

