    arm64.b.ne __im_slow#14
  __im_store:
    arm64.storeBaseIndexScaleReg.word64 [x0 + x1*8 + 0], x3
  tryok:
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at top-level-var-array-mutate-cross-function.test:8: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.epilogue 32
    arm64.ret
  __im_slow#11:
    arm64.storeSlotReg slot0, x1
    arm64.bl __managed_get
    arm64.loadRegSlot x1, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
    arm64.b trycont
  __im_slow#14:
    arm64.movRegReg x0, x2
    arm64.movRegReg x2, x3
