    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.add x3, x0, 1
  __rc_ok#8:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow#14
  __im_bounds:
