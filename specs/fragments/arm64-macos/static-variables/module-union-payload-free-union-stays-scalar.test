// Test: module-union-payload-free-union-stays-scalar
union Mode
	off
	on
end 'Mode'

var mode = Mode.off

function seed()
	mode = Mode.on
end 'seed'

function main() returns ExitCode
	seed()
	return match mode 'm'
		off gives 0
		on gives 6
	end 'm'
end 'main'
---
ExitCode: 6
---
data {
  __data_mode@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 1
    arm64.leaGlobal x1, __data_mode
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_cont:
    arm64.leaGlobal x0, __data_mode
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b __rc_ok
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x0, 6
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
