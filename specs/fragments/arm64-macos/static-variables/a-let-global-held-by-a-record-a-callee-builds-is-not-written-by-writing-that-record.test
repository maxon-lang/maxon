// Test: a-let-global-held-by-a-record-a-callee-builds-is-not-written-by-writing-that-record
typealias Count = int(0 to u64.max)
typealias CountArray = Array with Count

type Guards
	export var cols as CountArray

	export static function make() returns Guards
		return Guards{cols: CountArray.create()}
	end 'make'
end 'Guards'

let Shared = Guards.make()

type Blocks
	export var subst as CountArray
	export var guards as Guards

	export static function create(guards Guards) returns Blocks
		return Blocks{subst: CountArray.create(), guards: guards}
	end 'create'
end 'Blocks'

function mint(guards Guards) returns Blocks
	var blocks = Blocks.create(guards)
	blocks.subst.push(1)
	return blocks
end 'mint'

function main() returns ExitCode
	let b = mint(Shared)
	return (b.subst.count() * 10 + Shared.cols.count()) as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __data_Shared@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_Shared
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  __il_body#5:
    arm64.leaFuncAddr x1, __clone_Guards
    arm64.bl __mm_own_deep
    arm64.movRegReg x19, x0
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
    arm64.leaFuncAddr x1, __clone_Guards
    arm64.movRegReg x0, x19
    arm64.bl __mm_own_deep
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Guards
  __il_cont#6:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.movImm x1, 1
    arm64.bl __managed_push
  __il_cont#4:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.leaGlobal x1, __data_Shared
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x19, x0, x1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Blocks
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-let-global-held-by-a-record-a-callee-builds-is-not-written-by-writing-that-record.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
