// Test: first-class-function.capturing-closure-through-a-cycle-that-stores
typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

type Holder
	export var op as UnaryOp

	static function create(op UnaryOp) returns Self
		return Self{op: op}
	end 'create'
end 'Holder'

function ping(f UnaryOp, n Integer) returns Holder
	if n <= 0 'done'
		return Holder.create(f)
	end 'done'
	return pong(f, n: n - 1)
end 'ping'

function pong(f UnaryOp, n Integer) returns Holder
	return ping(f, n: n - 1)
end 'pong'

function main() returns ExitCode
	let bump = 20
	let h = pong(function(n Integer) gives n + bump, n: 5)
	return h.op(21) as ExitCode
end 'main'
---
ExitCode: 41
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @pong {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.sub x0, x1, 1
  __il_body#2:
    arm64.cmp x0, 0
    arm64.b.gt ifcont
  done:
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_body#6:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
  __il_cont#5:
    arm64.movRegReg x0, x20
    arm64.b __il_cont#1
  ifcont:
    arm64.sub x1, x0, 1
    arm64.movRegReg x0, x19
    arm64.bl pong
  __il_cont#1:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 20
    arm64.movImm x1, 0
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaFuncAddr x0, main$closure_0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movImm x1, 5
    arm64.movRegReg x0, x20
    arm64.bl pong
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movRegReg x0, x20
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.movImm x0, 21
    arm64.loadRegBaseDisp.word64 x2, [x20 + 0]
    arm64.movRegReg x1, x20
    arm64.blr x2
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.capturing-closure-through-a-cycle-that-stores.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
