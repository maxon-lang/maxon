// Test: first-class-function.matching-enum-shape-agrees-across-doors

enum Color
	red
	green
	blue
end 'Color'

typealias ColorFn = function(Color) returns Color

union Holder
	held(f ColorFn)
	empty
end 'Holder'

function next(c Color) returns Color
	match c 'k'
		red then return Color.green
		green then return Color.blue
		blue then return Color.red
	end 'k'
end 'next'

function pick() returns ColorFn
	return next
end 'pick'

function callThrough(f ColorFn) returns Color
	return f(Color.red)
end 'callThrough'

function callPayload(h Holder) returns Color
	return match h 'm'
		held(f) gives f(Color.green)
		empty gives Color.red
	end 'm'
end 'callPayload'

function show(c Color)
	match c 'k'
		red then print("red\n")
		green then print("green\n")
		blue then print("blue\n")
	end 'k'
end 'show'

function main() returns ExitCode
	show(callThrough(next))
	show(callPayload(Holder.held(next)))
	show(pick()(Color.blue))
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __slab_state@0 = i64 0
}

func @next {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchnext#6:
    arm64.cmp x0, 2
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @show {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.leaRdata x0, __str_rec_3  ; "red\x0a"
    arm64.bl print
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.leaRdata x0, __str_rec_4  ; "green\x0a"
    arm64.bl print
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 2
    arm64.b.ne matchdead
  matcharm#3:
    arm64.leaRdata x0, __str_rec_5  ; "blue\x0a"
    arm64.bl print
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaFuncAddr x2, __fnref_next
    arm64.movImm x1, 0
  __il_body#4:
    arm64.movImm x0, 0
    arm64.blr x2
  __il_cont#3:
    arm64.bl show
    arm64.leaFuncAddr x2, __fnref_next
    arm64.movImm x0, 0
  __il_body#5:
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#6:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.blr x2
    arm64.b __il_cont#2
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#7:
    arm64.movImm x0, 0
  __il_cont#2:
    arm64.bl show
  __il_body#11:
    arm64.leaFuncAddr x2, __fnref_next
  __il_cont#1:
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.blr x2
    arm64.bl show
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
