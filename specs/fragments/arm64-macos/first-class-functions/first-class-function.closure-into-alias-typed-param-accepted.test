// Test: first-class-function.closure-into-alias-typed-param-accepted

typealias Ratio = float(0.0 to 1000.0)
typealias ScaleFn = function(x Ratio) returns Ratio

function apply(f ScaleFn, v Ratio) returns Ratio
	return f(v)
end 'apply'

function main() returns ExitCode
	let g = function(x Ratio) gives x * 3.0
	return trunc(apply(g, v: 4.0)) as ExitCode
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaFuncAddr x1, main$closure_0
    arm64.fpLoadRdata d0, [rdata + __fconst_4]
    arm64.movImm x0, 0
  __rc_ok#6:
    arm64.blr x1
  __il_cont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.closure-into-alias-typed-param-accepted.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.mi __rc_panic
  __rc_chk:
    arm64.fpLoadRdata d1, [rdata + __fconst_1000]
    arm64.fcmp d0, d1
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.fpLoadRdata d1, [rdata + __fconst_3]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at first-class-function.closure-into-alias-typed-param-accepted.test:11: Range check failed: value outside typealias 'Ratio'\x0a"
    arm64.bl mrt_panic
