// Test: first-class-function.exitcode-through-alias-struct-field
typealias Thunk = function() returns ExitCode

type Holder
	export let cb as Thunk
	export static function create(cb Thunk) returns Self
		return Self{ cb: cb }
	end 'create'
end 'Holder'

function nine() returns ExitCode
	return 9
end 'nine'

function main() returns ExitCode
	let h = Holder.create(nine)
	return h.cb()
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @nine {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, __fnref_nine
  __il_body:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.movImm x0, 0
    arm64.blr x1
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.exitcode-through-alias-struct-field.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
