typealias Op = function(Small) returns Small

function apply(o Op, v Small) returns Small
	return o(v)
end 'apply'

function main() returns ExitCode
	print("{apply(function(_) gives 5, v: 1)}")
	return apply(function(v) gives v * 3, v: 4) as ExitCode
end 'main'
