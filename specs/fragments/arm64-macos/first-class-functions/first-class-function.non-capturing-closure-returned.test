// Test: first-class-function.non-capturing-closure-returned

typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

function pick() returns UnaryOp
	return function(n Integer) gives n * 2
end 'pick'

function main() returns ExitCode
	let f = pick()
	return f(21)
end 'main'
---
ExitCode: 42
---
func @pick$closure_0 {
  entry:
    arm64.prologue 16
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.leaFuncAddr x2, pick$closure_0
  __il_cont:
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.blr x2
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.non-capturing-closure-returned.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
