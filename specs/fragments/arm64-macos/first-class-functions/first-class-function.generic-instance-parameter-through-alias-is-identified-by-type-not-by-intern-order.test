// Test: first-class-function.generic-instance-parameter-through-alias-is-identified-by-type-not-by-intern-order

typealias Integer = int(i64.min to i64.max)
typealias Small = int(0 to 10)
typealias SmallArray = Array with Small

type Field
	export var v as Integer

	export static function create(v Integer) returns Field
		return Self{v: v}
	end 'create'
end 'Field'

typealias FieldArray = Array with Field
typealias FieldConsumer = function(FieldArray) returns Integer

function countFields(fields FieldArray) returns Integer
	return fields.count()
end 'countFields'

function apply(f FieldConsumer) returns Integer
	var fields = FieldArray.create()
	fields.push(Field.create(5))
	return f(fields)
end 'apply'

function main() returns ExitCode
	var s = SmallArray.create()
	s.push(3)
	return (apply(countFields) + s.count()) as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @countFields {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 18446744073709551612
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaFuncAddr x20, __fnref_countFields
    arm64.movImm x21, 0
  __il_body#5:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x22, x0
    arm64.movImm x23, 5
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.storeBaseDispReg.word64 [x1 + 0], x23
  __il_cont#6:
    arm64.movRegReg x0, x22
    arm64.bl __managed_push
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x21
    arm64.blr x20
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
  __il_cont#4:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.add x20, x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.generic-instance-parameter-through-alias-is-identified-by-type-not-by-intern-order.test:31: Range check failed: value outside type"...
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
