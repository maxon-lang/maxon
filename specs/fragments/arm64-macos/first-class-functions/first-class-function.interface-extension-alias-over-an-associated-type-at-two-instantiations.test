    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x20
    arm64.blr x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __drop_type_param
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.only {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @isBig {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 10
    arm64.cset x0, gt
    arm64.epilogue 16
    arm64.ret
}

func @isLoud {
  entry:
    arm64.prologue 16
    arm64.bl String.count
    arm64.cmp x0, 3
    arm64.cset x0, gt
    arm64.epilogue 16
    arm64.ret
}

