// Test: a-closure-literal-result-takes-the-exit-code-its-function-type-returns
type Box
	let v as ExitCode

	static function make() returns Box
		return Box{v: 9}
	end 'make'
end 'Box'

typealias Op = function(Box) returns ExitCode

function probe(o Op) returns ExitCode
	return o(Box.make())
end 'probe'

function main() returns ExitCode
	return probe(function(_) gives 4)
end 'main'
---
ExitCode: 4
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x1, __fnrec_main$closure_0
  __il_body:
    arm64.movImm x0, 9
  __il_cont#6:
    arm64.loadRegBaseDisp.word64 x2, [x1 + 0]
    arm64.blr x2
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __il_cont#1:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-closure-literal-result-takes-the-exit-code-its-function-type-returns.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
}
