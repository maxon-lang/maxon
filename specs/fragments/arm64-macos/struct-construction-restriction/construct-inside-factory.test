// Test: construct-inside-factory
typealias Val = int(0 to 100)

type Box
	export var v as Val

	static function create(x Val) returns Box
		return Self{v: x}
	end 'create'

	function get() returns Val
		return self.v
	end 'get'
end 'Box'

function main() returns ExitCode
	let b = Box.create(5)
	return b.get()
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
  __il_cont:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
