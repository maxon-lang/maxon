// Test: directives.both-branches-balance
function main() returns ExitCode
	#if os(Wasi)
		return 42
	#else
		return 42
	#endif
end 'main'
---
ExitCode: 42
---
data {
  __mrt_program_started@0 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
