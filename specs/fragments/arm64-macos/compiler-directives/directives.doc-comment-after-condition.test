// Test: directives.doc-comment-after-condition
function main() returns ExitCode
	#if os(Windows) /// a doc comment riding the directive line
		return 7
	#else /// and on the else
		return 7
	#endif /// and the endif
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
