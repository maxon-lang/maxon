    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @A.idb {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
}

