// Test: error.a-top-level-cast-to-a-directory-qualified-alias-checks-its-range
// --- file: api/score.maxon
export typealias Score = int(0 to 100)

// --- file: legacy/score.maxon
export typealias Score = int(0 to 50)

// --- file: app/main.maxon
