// Test: crossfile-ranged-and-function-alias-coexist
// --- file: a.maxon
typealias Handler = int(0 to 10)

export function useA() returns Handler
	return 5 as Handler
end 'useA'

// --- file: b.maxon
typealias Handler = function() returns Integer

export function useB(h Handler) returns ExitCode
	return h() as ExitCode
end 'useB'

typealias Integer = int(i64.min to i64.max)
// --- file: main.maxon
function zero() returns Integer
	return 0
end 'zero'

function main() returns ExitCode
	return useA() + useB(zero)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
func @zero {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  __il_cont#5:
    arm64.leaFuncAddr x1, __fnref_zero
    arm64.movImm x0, 0
  __il_body:
    arm64.blr x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#9
  __rc_chk#10:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#9
  __il_cont#4:
    arm64.add x0, x0, 5
  __rc_chk#3:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_0  ; "panic at b.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_1  ; "panic at main.maxon:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
