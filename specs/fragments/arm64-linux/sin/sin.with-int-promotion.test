// Test: sin.with-int-promotion
function main() returns ExitCode
	let x = 0  // int
	let result = Math.sin(x)  // x promoted to 0.0
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
