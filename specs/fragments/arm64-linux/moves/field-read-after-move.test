// Test: field-read-after-move
type Point
	export var x as Integer

	static function create(x Integer) returns Point
		return Self{x: x}
	end 'create'
end 'Point'

function main() returns ExitCode
	var p = Point.create(7)
	let q = p
	return p.x
end 'main'
typealias Integer = int(i64.min to i64.max)
