// Test: export-static-method

typealias Integer = int(i64.min to i64.max)

type Factory
	export var id as Integer

	export static function create(val Integer) returns Factory
		return Factory{id: val}
	end 'create'

	export static function zero() returns Factory
		return Factory.create(0)
	end 'zero'
end 'Factory'

function main() returns ExitCode
	let f1 = Factory.create(100)
	let f2 = Factory.zero()
	return f1.id + f2.id
end 'main'
---
ExitCode: 100
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 100
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_body:
    arm64.movImm x0, 0
    arm64.leaRegSlot x2, slot1
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
  __il_cont:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x2 + 0]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at export-static-method.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}
