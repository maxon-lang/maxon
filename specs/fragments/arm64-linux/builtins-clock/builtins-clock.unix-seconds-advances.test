// Test: builtins-clock.unix-seconds-advances
function main() returns ExitCode
	let before = __Builtins.currentUnixTimeSeconds()
	sleep(1100)
	let after = __Builtins.currentUnixTimeSeconds()
	if after >= before + 1 'advanced'
		return 4
	end 'advanced'
	return 1
end 'main'
