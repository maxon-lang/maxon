  __sched_lock@208 = i64 0
  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __sched_sysmon_started@232 = i64 0
  __mrt_errno@240 = i64 0
  __mrt_envp@248 = i64 0
  __mrt_tls_next_key@256 = i64 0
  __slab_arena_list@264 = i64 0
  __slab_arena_map_l1@272 = i64 0
  __slab_state@280 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __gt_now_ns
    arm64.movRegReg x19, x0
    arm64.bl __gt_now_ns
    arm64.movImm x1, 4835703278458516699
    arm64.smulh x0, x1, x0
    arm64.asr x0, x0, 18
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
    arm64.movImm x1, 4835703278458516699
    arm64.smulh x1, x1, x19
    arm64.asr x1, x1, 18
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x2, 0
    arm64.cmp x0, x1
    arm64.b.lt ifcont#2
  notBehind:
    arm64.movImm x2, 1
  ifcont#2:
    arm64.sub x0, x0, x1
    arm64.cmp x0, 50
    arm64.b.ge critsplit
  notAhead:
    arm64.add x0, x2, 1
    arm64.b ifcont#4
  critsplit:
    arm64.movRegReg x0, x2
  ifcont#4:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at builtins-clock.ms-tracks-nanos.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
