// Test: builtins-clock.unix-seconds-is-a-calendar-time
function main() returns ExitCode
	let now = __Builtins.currentUnixTimeSeconds()
	var score = 0
	if now > 1735689600 'afterKnownPast'
		score = score + 1
	end 'afterKnownPast'
	if now < 4102444800 'beforeFarFuture'
		score = score + 1
	end 'beforeFarFuture'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.bl __clock_now_unix_s
    arm64.movImm x1, 0
    arm64.movImm x16, 1735689600
    arm64.cmp x0, x16
    arm64.b.le ifcont
  afterKnownPast:
    arm64.movImm x1, 1
  ifcont:
    arm64.movImm x2, 4102444800
    arm64.cmp x0, x2
    arm64.b.ge critsplit
  beforeFarFuture:
    arm64.add x0, x1, 1
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
