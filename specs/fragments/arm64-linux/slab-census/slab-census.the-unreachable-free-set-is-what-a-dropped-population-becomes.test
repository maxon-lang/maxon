// Test: slab-census.the-unreachable-free-set-is-what-a-dropped-population-becomes
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Seed = int(0 to 65536)

let Population = 16000

function build(seed Seed) returns ByteArray
	var b = ByteArray.create()
	b.reserve(96)
	for i in 0 upto 96 'fill'
		b.push(((seed + i) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var bufs = Bufs.create()
	for k in 0 upto Population 'alloc'
		bufs.push(build(k as Seed))
	end 'alloc'

	bufs = Bufs.create()

	let free = __Builtins.slabFreeBytes()
	let cached = __Builtins.slabCachedFreeBytes()
	let parked = __Builtins.slabParkedBytes()

	if cached > free 'cachedIsNotASubset'
		return 1
	end 'cachedIsNotASubset'

	if parked > free 'parkedIsNotASubset'
		return 2
	end 'parkedIsNotASubset'

	if free <= cached 'everythingFreeWasReachable'
		return 3
	end 'everythingFreeWasReachable'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  __rc_ok#17:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 96
  __rc_ok#29:
    arm64.movRegReg x0, x21
    arm64.bl __managed_capacity
    arm64.cmp x0, 96
    arm64.b.ge __il_cont#23
  grow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont#23
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __il_cont#23:
    arm64.movImm x22, 0
    arm64.b forhdr#13
  fill:
    arm64.add x0, x20, x22
    arm64.movImm x1, 251
    arm64.udiv x16, x0, x1
    arm64.msub x1, x16, x1, x0
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok#20:
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
  forstep#15:
    arm64.add x22, x22, 1
  forhdr#13:
    arm64.cmp x22, 96
    arm64.b.lt fill
  __il_cont#11:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
  forhdr#1:
    arm64.movImm x16, 16000
    arm64.cmp x20, x16
    arm64.b.lt __rc_ok#17
  forexit:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.bl __slab_free_bytes
    arm64.movRegReg x19, x0
    arm64.bl __slab_cached_free_bytes
    arm64.movRegReg x21, x0
    arm64.bl __slab_parked_bytes
    arm64.cmp x21, x19
    arm64.b.le ifcont#6
  cachedIsNotASubset:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#6:
    arm64.cmp x0, x19
    arm64.b.le ifcont#8
  parkedIsNotASubset:
    arm64.movImm x19, 2
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#8:
    arm64.cmp x19, x21
    arm64.b.gt ifcont#10
  everythingFreeWasReachable:
    arm64.movImm x19, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#10:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at slab-census.the-unreachable-free-set-is-what-a-dropped-population-becomes.test:13: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
