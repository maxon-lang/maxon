    arm64.sub x0, x25, x0
    arm64.cmp x0, x19
    arm64.b.gt forstep#21
  critsplit#56:
    arm64.movRegReg x0, x19
  forstep#21:
    arm64.add x24, x24, 1
    arm64.movRegReg x19, x0
  forhdr#19:
