// Test: slab-census.an-os-direct-mapping-is-committed-and-is-not-a-slot
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

let Big = 400000

function main() returns ExitCode
	let committedBefore = __Builtins.slabCommittedBytes()
	let liveBefore = __Builtins.slabLiveBytes()

	var buf = ByteArray.create()
	buf.reserve(Big)
	for i in 0 upto Big 'fill'
		buf.push((i mod 251) as Byte)
	end 'fill'

	let committedHolding = __Builtins.slabCommittedBytes()

	if (committedHolding - committedBefore) < Big 'mappingNotCounted'
		return 1
	end 'mappingNotCounted'

	if (__Builtins.slabLiveBytes() - liveBefore) >= Big 'mappingCountedAsASlot'
		return 2
	end 'mappingCountedAsASlot'

	buf = ByteArray.create()

	if __Builtins.slabCommittedBytes() >= committedHolding 'mappingNotGivenBack'
		return 3
	end 'mappingNotGivenBack'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl __slab_committed_bytes
    arm64.movRegReg x19, x0
    arm64.bl __slab_live_bytes
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 400000
  __rc_ok#20:
    arm64.movRegReg x0, x21
    arm64.bl __managed_capacity
    arm64.movImm x16, 400000
    arm64.cmp x0, x16
    arm64.b.ge __il_cont
  grow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:325: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __il_cont:
    arm64.movImm x22, 0
    arm64.b forhdr
  fill:
    arm64.movImm x0, 2351776136887273513
    arm64.smulh x0, x0, x22
    arm64.asr x0, x0, 5
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
    arm64.movImm x16, 251
    arm64.mul x0, x0, x16
    arm64.sub x1, x22, x0
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok#11:
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
  forstep:
    arm64.add x22, x22, 1
  forhdr:
    arm64.movImm x16, 400000
    arm64.cmp x22, x16
    arm64.b.lt fill
  forexit:
    arm64.bl __slab_committed_bytes
    arm64.movRegReg x22, x0
    arm64.sub x0, x22, x19
    arm64.movImm x16, 400000
    arm64.cmp x0, x16
    arm64.b.ge ifcont#6
  mappingNotCounted:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#6:
    arm64.bl __slab_live_bytes
    arm64.sub x0, x0, x20
    arm64.movImm x16, 400000
    arm64.cmp x0, x16
    arm64.b.lt ifcont#8
  mappingCountedAsASlot:
    arm64.movImm x19, 2
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.bl __slab_committed_bytes
    arm64.cmp x0, x22
    arm64.b.lt ifcont#10
  mappingNotGivenBack:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#10:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at slab-census.an-os-direct-mapping-is-committed-and-is-not-a-slot.test:14: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
