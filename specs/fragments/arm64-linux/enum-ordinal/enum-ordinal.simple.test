// Test: enum-ordinal.simple
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	// `.ordinal` may only be observed as data, not compared (E3097) — surface
	// it as the exit code; green is the second case, so ordinal 1.
	return c.ordinal as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
