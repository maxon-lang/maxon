// Test: enum-ordinal.char-backed
enum Grade
	a = 'A'
	b = 'B'
	c = 'C'
end 'Grade'

function main() returns ExitCode
	let g = Grade.c
	return g.ordinal as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
