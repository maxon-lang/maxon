// Test: with-parameters

typealias Integer = int(i64.min to i64.max)

function add(a Integer, b Integer) returns Integer
	return a + b
end 'add'

function main() returns ExitCode
	return add(10, b: 20)
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 30
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
