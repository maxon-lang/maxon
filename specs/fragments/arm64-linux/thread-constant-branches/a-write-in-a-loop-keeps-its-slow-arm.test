// Test: a-write-in-a-loop-keeps-its-slow-arm
typealias Word = int(i64.min to i64.max)
typealias Idx = int(0 to u64.max)
typealias WordArray = Array with Word

function put(a WordArray, i Idx, v Word) returns bool
	try a.set(i, value: v) otherwise return false
	return true
end 'put'

function main() returns ExitCode
	var a = WordArray.create()
	a.resize(4)
	var stored = 0
	for i in 0 upto 5 'each'
		if put(a, i: i, v: i * 10) 'ok'
			stored = stored + 1
		end 'ok'
	end 'each'
	if stored != 4 'count'
		return 1
	end 'count'
	var seen = 0
	for v in a 'check'
		seen = seen + v
	end 'check'
	if seen != 60 'sum'
		return 2
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @put {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 16]
    arm64.cmp x3, 0
    arm64.b.lt __im_slow
  __im_bounds:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.cmp x1, x3
    arm64.b.hs __im_slow
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.cmp x3, 0
    arm64.b.eq __im_slow
  __im_viewed:
    arm64.sub x4, x3, 24
    arm64.loadRegBaseDisp.word64 x4, [x4 + 16]
    arm64.cmp x4, 0
    arm64.b.ne __im_slow
    arm64.b __im_store
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __im_store:
    arm64.storeBaseIndexScaleReg.word64 [x3 + x1*8 + 0], x2
  tryok:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-write-in-a-loop-keeps-its-slow-arm.test:6: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __im_slow:
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b tryok
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_resize
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  forhdr#1:
    arm64.cmp x21, 5
    arm64.b.ge forexit#4
  each:
    arm64.movImm x16, 10
    arm64.mul x2, x21, x16
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl put
    arm64.cbz x0, critsplit
  ok:
    arm64.add x0, x20, 1
    arm64.b forstep#3
  critsplit:
    arm64.movRegReg x0, x20
  forstep#3:
    arm64.add x21, x21, 1
    arm64.movRegReg x20, x0
    arm64.b forhdr#1
  forexit#4:
    arm64.cmp x20, 4
    arm64.b.eq ifcont#8
  count:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
  forhdr#9:
    arm64.cmp x1, x2
    arm64.b.ge forexit#12
  check:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x0, x0, x4
  forstep#11:
    arm64.add x1, x1, 1
    arm64.b forhdr#9
  forexit#12:
    arm64.cmp x0, 60
    arm64.b.eq ifcont#14
  sum:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#14:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
