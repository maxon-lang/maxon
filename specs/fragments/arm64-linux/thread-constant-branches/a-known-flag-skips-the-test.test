// Test: a-known-flag-skips-the-test
typealias Word = int(i64.min to i64.max)
typealias Idx = int(0 to u64.max)
typealias WordArray = Array with Word

function pick(a WordArray, i Idx) returns Word
	return try a.get(i) otherwise panic("pick: index out of range")
end 'pick'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 6 'seed'
		a.push(i * 2)
	end 'seed'
	var t = 0
	for i in 0 upto 6 'sum'
		t = t + pick(a, i: i)
	end 'sum'
	if t != 30 'total'
		return 1
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x20
    arm64.storeSlotReg slot4, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  seed:
    arm64.lsl x1, x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
  forhdr#1:
    arm64.cmp x20, 6
    arm64.b.lt seed
  forexit#4:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.b forhdr#5
  __il_body:
    arm64.cmp x1, x2
    arm64.b.hs __im_slow
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __il_cont:
    arm64.add x0, x0, x4
  forstep#7:
    arm64.add x1, x1, 1
  forhdr#5:
    arm64.cmp x1, 6
    arm64.b.lt __il_body
  forexit#8:
    arm64.cmp x0, 30
    arm64.b.eq ifcont
  total:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x4, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.cmp x9, 0
    arm64.b.eq __il_cont
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-known-flag-skips-the-test.test:7: pick: index out of range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
}
