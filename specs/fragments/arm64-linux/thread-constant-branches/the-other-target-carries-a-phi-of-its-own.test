// Test: the-other-target-carries-a-phi-of-its-own
typealias Word = int(i64.min to i64.max)

function bump(p bool, n Word) returns Word
	var flag = 0
	var acc = 5
	if p 'yes'
		flag = 1
		acc = n
	end 'yes' else 'no'
		flag = n
		acc = 7
	end 'no'
	if flag != 0 'nz'
		acc = acc + 1
	end 'nz'
	return acc
end 'bump'

function main() returns ExitCode
	if bump(true, n: 9) != 10 'a'
		return 1
	end 'a'
	if bump(true, n: 0) != 1 'b'
		return 2
	end 'b'
	if bump(false, n: 9) != 8 'c'
		return 3
	end 'c'
	if bump(false, n: 0) != 7 'd'
		return 4
	end 'd'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  yes#11:
    arm64.movImm x0, 9
  nz#14:
    arm64.add x0, x0, 1
  yes#18:
    arm64.movImm x0, 0
  nz#21:
    arm64.add x0, x0, 1
  ifelse#26:
    arm64.movImm x0, 7
  nz#28:
    arm64.add x0, x0, 1
  ifelse#33:
    arm64.movImm x0, 0
    arm64.movImm x1, 7
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
