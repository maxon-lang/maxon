// Test: an-increment-that-wraps-still-panics
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function main() returns ExitCode
	var a = WordArray.create()
	a.push(9223372036854775807)
	let big = try a.get(0) otherwise 0
	if big <= 0 'small'
		return 2
	end 'small'
	let wrapped = big + 1
	let v = try a.get(wrapped) otherwise 5
	return 3 if v == 5 else 4
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 9223372036854775807
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#18
    arm64.b __im_load#19
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  __im_load#19:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont:
    arm64.cmp x0, 0
    arm64.b.gt ifcont
  small:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.add x1, x0, 1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_ok#12:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x1, x0
    arm64.b.hs __im_slow#21
  __im_load#22:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  tryok:
    arm64.cmp x0, 5
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x20, 3
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x20, 4
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __rc_ok#14:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow#18:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-increment-that-wraps-still-panics.test:13: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow#21:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne ternarytrue
    arm64.b tryok
}
