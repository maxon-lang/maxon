// Test: div-mod-variables
function main() returns ExitCode
	let a = 100
	let b = 7
	let q = a / b
	let r = a mod b
	return q + r
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 5270498306774157605
    arm64.smulh x1, x1, x0
    arm64.asr x1, x1, 1
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x2, 5270498306774157605
    arm64.smulh x2, x2, x0
    arm64.asr x2, x2, 1
    arm64.lsr x3, x2, 63
    arm64.add x2, x2, x3
    arm64.movImm x16, 7
    arm64.mul x2, x2, x16
    arm64.sub x0, x0, x2
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at div-mod-variables.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
