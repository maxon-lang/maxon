// Test: mod-precedence
function main() returns ExitCode
	return 2 * 6 mod 4
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 12
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 12
    arm64.asr x1, x1, 2
    arm64.lsl x1, x1, 2
    arm64.sub x0, x0, x1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
