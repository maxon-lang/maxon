// Test: in-a-call-argument
typealias Tag = int(0 to 100)

function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function consume(flag bool) returns Tag
	if flag 'isTrue'
		return 1
	end 'isTrue'
	return 0
end 'consume'

function main() returns ExitCode
	let a = consume(t() or f())
	let b = consume(t() and f())
	let c = consume(f() or t())
	return a * 4 + b * 2 + c
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont#10:
    arm64.movImm x0, 1
  __il_body#16:
    arm64.cbz x0, ifcont#18
  isTrue#17:
    arm64.movImm x0, 1
    arm64.b __il_body#21
  ifcont#18:
    arm64.movImm x0, 0
  __il_body#21:
    arm64.movImm x1, 0
  __il_body#24:
    arm64.cbz x1, ifcont#26
  isTrue#25:
    arm64.movImm x1, 1
    arm64.b __il_body#29
  ifcont#26:
    arm64.movImm x1, 0
  __il_body#29:
    arm64.movImm x2, 1
  __il_body#31:
    arm64.cbz x2, ifcont#33
  isTrue#32:
    arm64.movImm x2, 1
    arm64.b __il_cont#30
  ifcont#33:
    arm64.movImm x2, 0
  __il_cont#30:
    arm64.lsl x0, x0, 2
    arm64.arm64AddLsl x0, x0, x1, lsl #1
    arm64.add x0, x0, x2
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at in-a-call-argument.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
