// Test: in-a-call-argument
typealias Tag = int(0 to 100)

function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function consume(flag bool) returns Tag
	if flag 'isTrue'
		return 1
	end 'isTrue'
	return 0
end 'consume'

function main() returns ExitCode
	let a = consume(t() or f())
	let b = consume(t() and f())
	let c = consume(f() or t())
	return a * 4 + b * 2 + c
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
  isTrue#17:
    arm64.movImm x0, 1
  ifcont:
    arm64.movImm x1, 0
  isTrue#32:
    arm64.movImm x2, 1
  __il_cont:
    arm64.lsl x0, x0, 2
    arm64.arm64AddLsl x0, x0, x1, lsl #1
    arm64.add x0, x0, x2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
