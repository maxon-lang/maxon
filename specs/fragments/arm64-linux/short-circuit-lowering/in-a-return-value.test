// Test: in-a-return-value
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function bothTrue() returns bool
	return t() and t()
end 'bothTrue'

function eitherTrue() returns bool
	return f() or t()
end 'eitherTrue'

function main() returns ExitCode
	var code = 0
	if bothTrue() 'a'
		code = code + 1
	end 'a'
	if eitherTrue() 'b'
		code = code + 2
	end 'b'
	return code
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
  a:
    arm64.movImm x0, 1
  b:
    arm64.add x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
