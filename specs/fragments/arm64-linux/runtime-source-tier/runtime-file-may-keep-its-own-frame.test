// Test: runtime-file-may-keep-its-own-frame
// --- runtime-file: Probe.maxon
function __probe_marked()
	__Raw.ownFrame()
end '__probe_marked'
// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
