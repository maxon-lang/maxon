// Test: enum-as-parameter-name-crossfile
// --- file: api/shared.maxon
export typealias StdType = int(i64.min to i64.max)

// --- file: api/helper.maxon
export function pickOne(enum StdType) returns StdType
	return enum
end 'pickOne'

// --- file: app/main.maxon
function main() returns ExitCode
	return pickOne(7)
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
