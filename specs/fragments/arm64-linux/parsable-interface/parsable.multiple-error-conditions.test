    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.leaRdata x20, __str_rec_2  ; "-"
  __il_body#33:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
  __il_body#34:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
  __il_cont#31:
    arm64.cmp x21, x0
    arm64.b.ls __rc_ok#23
  tooLong:
    arm64.movImm x0, 0
    arm64.b __il_cont#5
  __rc_ok#23:
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_ok#25:
    arm64.movImm x22, 0
    arm64.b forhdr
  compare_loop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl String.byteAt
    arm64.movRegReg x23, x0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#16
  tryok#15:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.bl String.byteAt
    arm64.cmp x9, 0
    arm64.b.ne tryerr#18
  tryok#17:
    arm64.cmp x23, x0
    arm64.b.eq forstep
  byte_check:
    arm64.movImm x0, 0
    arm64.b __il_cont#5
  forstep:
    arm64.add x22, x22, 1
  forhdr:
    arm64.cmp x22, x21
    arm64.b.lt compare_loop
  forexit:
    arm64.movImm x0, 1
  __il_cont#5:
    arm64.cbz x0, __il_body#30
  negative:
    arm64.movImm x9, 3
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __il_body#30:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
  __il_cont#29:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
