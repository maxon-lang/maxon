// Test: list-of-structs-iterate
typealias Integer = int(i64.min to i64.max)

type Entry
	export var id as Integer
	export var value as Integer

	static function create(id Integer, value Integer) returns Self
		return Self{id: id, value: value}
	end 'create'
end 'Entry'

typealias EntryList = List with Entry

function main() returns ExitCode
	var list = EntryList.create()
	list.append(Entry.create(1, value: 100))
	list.append(Entry.create(2, value: 200))
	list.append(Entry.create(3, value: 300))
	var sum = 0
	for item in list 'loop'
		sum = sum + item.value
	end 'loop'
	print("{sum}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Entry.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 112
    arm64.storeSlotReg slot10, x28
