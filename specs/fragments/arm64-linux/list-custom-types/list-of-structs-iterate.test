    arm64.storeSlotReg slot1, x19
    arm64.leaRdata x0, __layout_List_Entry
    arm64.bl List.create
    arm64.movRegReg x19, x0
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 100
    arm64.bl Entry.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.leaRdata x2, __layout_List_Entry
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl List.append
    arm64.movImm x0, 2
    arm64.movImm x1, 200
    arm64.bl Entry.create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.leaRdata x2, __layout_List_Entry
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl List.append
    arm64.movImm x0, 3
    arm64.movImm x1, 300
    arm64.bl Entry.create
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.leaRdata x2, __layout_List_Entry
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl List.append
    arm64.movImm x23, 0
    arm64.movRegReg x0, x19
    arm64.bl List.createIterator
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.ne forjoin
  forhdr:
    arm64.cmp x0, 0
