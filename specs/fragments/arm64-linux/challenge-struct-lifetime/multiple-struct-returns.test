// Test: multiple-struct-returns

typealias Integer = int(i64.min to i64.max)

type Value
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Value'

function step1() returns Value
	return Value.create(1)
end 'step1'

function step2(v Value) returns Value
	return Value.create(v.n + 10)
end 'step2'

function step3(v Value) returns Value
	return Value.create(v.n + 100)
end 'step3'

function main() returns ExitCode
	let v1 = step1()
	let v2 = step2(v1)
	let v3 = step3(v2)
	return v3.n
end 'main'
---
ExitCode: 111
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Value.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @step1 {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl Value.create
    arm64.epilogue 16
    arm64.ret
}

func @step2 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 10
    arm64.bl Value.create
    arm64.epilogue 16
    arm64.ret
}

func @step3 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 100
    arm64.bl Value.create
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl step1
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl step2
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl step3
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at multiple-struct-returns.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
