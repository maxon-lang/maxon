    arm64.bl spawnAndAwait
    arm64.movRegReg x19, x0
    arm64.bl __mm_counter_raw_alloc_total
    arm64.sub x20, x0, x20
    arm64.bl __mm_counter_raw_alloc_live
    arm64.sub x21, x0, x21
    arm64.bl __sched_gt_recycle_count
    arm64.sub x0, x0, x22
    arm64.movImm x1, 0
    arm64.cmp x19, 9
    arm64.b.ne ifcont#2
  everyThreadRanExactlyOnce:
    arm64.movImm x1, 1
  ifcont#2:
    arm64.cmp x20, 0
    arm64.movImm x2, 0
    arm64.b.ne critsplit#13
  andrhs:
    arm64.cmp x0, 8
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit#13:
    arm64.movRegReg x0, x2
  scmerge:
    arm64.cbz x0, critsplit#14
  everySpawnReusedAStruct:
    arm64.add x0, x1, 2
    arm64.b ifcont#6
  critsplit#14:
    arm64.movRegReg x0, x1
  ifcont#6:
    arm64.cmp x21, 0
    arm64.b.ne __rc_ok
  andNothingWasLeftLive:
    arm64.add x0, x0, 4
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
