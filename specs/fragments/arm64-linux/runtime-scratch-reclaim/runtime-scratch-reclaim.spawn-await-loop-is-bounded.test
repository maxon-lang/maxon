func @work {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl __parallel_boundary
    arm64.add x0, x19, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @spawnAndAwait {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaFuncAddr x0, work
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 200], x19
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movRegReg x0, x20
    arm64.bl __gt_await
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

