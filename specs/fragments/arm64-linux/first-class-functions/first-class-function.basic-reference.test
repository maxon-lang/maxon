// Test: first-class-function.basic-reference

typealias Integer = int(i64.min to i64.max)

function double(x Integer) returns Integer
	return x * 2
end 'double'

function main() returns ExitCode
	let f = double
	return f(21)
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @double {
  entry:
    arm64.prologue 16
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __fnrec_double
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
