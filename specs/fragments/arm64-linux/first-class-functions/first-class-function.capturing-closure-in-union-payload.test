// Test: first-class-function.capturing-closure-in-union-payload

typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

union Action
	run(op UnaryOp)
	idle
end 'Action'

function make(bump Integer) returns Action
	return Action.run(function(n Integer) gives n + bump)
end 'make'

function main() returns ExitCode
	let a = make(20)
	match a 'go'
		run(op) then return op(22)
		idle then return 1
	end 'go'
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @make$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 20
  __il_body:
    arm64.movImm x1, 0
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaFuncAddr x0, make$closure_0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x20
  __il_cont:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movImm x0, 22
    arm64.loadRegBaseDisp.word64 x2, [x20 + 0]
    arm64.movRegReg x1, x20
    arm64.blr x2
    arm64.movRegReg x21, x0
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Action
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Action
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
  matchcont:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.capturing-closure-in-union-payload.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
