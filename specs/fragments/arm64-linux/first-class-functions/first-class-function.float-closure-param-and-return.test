    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.mi __rc_panic
  __rc_chk:
    arm64.fpLoadRdata d1, [rdata + __fconst_1000]
    arm64.fcmp d0, d1
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.float-closure-param-and-return.test:6: Range check failed: value outside typealias 'Ratio'\x0a"
    arm64.bl mrt_panic
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
