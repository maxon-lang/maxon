// Test: first-class-function.value-called-as-statement-discarded
typealias Integer = int(i64.min to i64.max)

function inc(n Integer) returns Integer
	return n + 1
end 'inc'

function main() returns ExitCode
	let f = inc
	f(10)
	return f(41)
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @inc {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __fnrec_inc
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
