// Test: first-class-function.capturing-closure-through-witness-dispatch
typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

interface Stasher
	function stash(fn UnaryOp) returns Integer
end 'Stasher'

type Slot implements Stasher
	export var op as UnaryOp

	static function create(op UnaryOp) returns Self
		return Self{op: op}
	end 'create'

	function stash(fn UnaryOp) returns Integer
		self.op = fn
		return self.op(2)
	end 'stash'
end 'Slot'

type W uses T where T is Stasher
	export var inner as T

	static function create(inner T) returns Self
		return Self{inner: inner}
	end 'create'

	function put(k Integer) returns Integer
		return self.inner.stash(function(n Integer) gives n + k)
	end 'put'
end 'W'

typealias SlotW = W with Slot

function plain(n Integer) returns Integer
	return n
end 'plain'

function main() returns ExitCode
	let s = Slot.create(plain)
	let w = SlotW.create(s)
	return w.put(5)
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @Slot.stash {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.loadRegBaseDisp.word64 x21, [x19 + 0]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.movImm x0, 2
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.movRegReg x1, x19
    arm64.blr x2
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @W.put$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @plain {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __fnrec_plain
  __il_body#7:
    arm64.movImm x0, 8
