// Test: first-class-function.field-string-result-called-as-statement-leak-free
typealias Msg = function() returns String

type Holder
	export var op as Msg

	static function create(op Msg) returns Self
		return Self{op: op}
	end 'create'
end 'Holder'

function greet() returns String
	return "hello world this is a heap string"
end 'greet'

function main() returns ExitCode
	let h = Holder.create(greet)
	h.op()
	h.op()
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @greet {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "hello world this is a heap string"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, __fnref_greet
  __il_body:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.movImm x0, 0
    arm64.blr x1
    arm64.bl __str_decref
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.movImm x0, 0
    arm64.blr x1
    arm64.bl __str_decref
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
