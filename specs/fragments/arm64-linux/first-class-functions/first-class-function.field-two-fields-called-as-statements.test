// Test: first-class-function.field-two-fields-called-as-statements
var effA = 0
var effB = 0

typealias Task = function()

type Pair
	export var first as Task
	export var second as Task

	static function create(first Task, second Task) returns Self
		return Self{first: first, second: second}
	end 'create'
end 'Pair'

function bumpA()
	effA = effA + 10
end 'bumpA'

function bumpB()
	effB = effB + 4
end 'bumpB'

function main() returns ExitCode
	let p = Pair.create(bumpA, second: bumpB)
	p.first()
	p.second()
	return (effA + effB) as ExitCode
end 'main'
---
ExitCode: 14
---
data {
  __data_effA@0 = i64 0
  __data_effB@8 = i64 0
  __mrt_envp@16 = i64 0
  __mrt_signal_stack_bytes@24 = i64 0
  __slab_arena_list@32 = i64 0
  __slab_arena_map_l1@40 = i64 0
  __slab_state@48 = i64 0
  __mrt_program_started@56 = i8 0
}

func @bumpA {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_effA
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 10
    arm64.leaGlobal x2, __data_effA
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @bumpB {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_effB
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 4
    arm64.leaGlobal x2, __data_effB
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __fnrec_bumpA
    arm64.leaRdata x20, __fnrec_bumpB
  __il_body:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
  __il_cont:
    arm64.loadRegBaseDisp.word64 x19, [x21 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.blr x1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.loadRegBaseDisp.word64 x19, [x21 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.blr x1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.leaGlobal x0, __data_effA
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaGlobal x1, __data_effB
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x19, x0, x1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Pair
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.field-two-fields-called-as-statements.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
