// Test: first-class-function.capturing-closure-through-a-chain-that-only-calls
typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

function ping(f UnaryOp, n Integer) returns Integer
	if n <= 0 'done'
		return f(n)
	end 'done'
	return pong(f, n: n - 1)
end 'ping'

function pong(f UnaryOp, n Integer) returns Integer
	return ping(f, n: n - 1)
end 'pong'

function main() returns ExitCode
	let bump = 20
	return ping(function(n Integer) gives n + bump, n: 5) as ExitCode
end 'main'
---
ExitCode: 19
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @ping {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x0
    arm64.cmp x1, 0
    arm64.b.gt ifcont
  done:
    arm64.loadRegBaseDisp.word64 x3, [x2 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.blr x3
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x0, x1, 1
  __il_body:
    arm64.sub x1, x0, 1
    arm64.movRegReg x0, x2
    arm64.bl ping
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 20
    arm64.movImm x1, 0
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaFuncAddr x0, main$closure_0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movImm x1, 5
    arm64.movRegReg x0, x20
    arm64.bl ping
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.capturing-closure-through-a-chain-that-only-calls.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
