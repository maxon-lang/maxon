// Test: first-class-function.matching-signature-cast-accepted

typealias Real = float(f64.min to f64.max)
typealias Scaler = function(v Real) returns Real

function twice(v Real) returns Real
	return v * 2.0
end 'twice'

function main() returns ExitCode
	let f = twice as Scaler
	return trunc(f(3.0)) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @twice {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __fnrec_twice
  __il_body:
    arm64.fpLoadRdata d0, [rdata + __fconst_6]
  __il_cont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.matching-signature-cast-accepted.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
