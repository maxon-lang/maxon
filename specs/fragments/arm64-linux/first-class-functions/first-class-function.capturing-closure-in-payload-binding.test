    arm64.bl __mm_incref
    arm64.movImm x1, 0
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.leaFuncAddr x0, main$closure_0
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x19
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x21 + 8], x22
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
  matchcont#5:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#9
  matcharm#6:
    arm64.loadRegBaseDisp.word64 x19, [x21 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x0, 22
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.movRegReg x1, x19
    arm64.blr x2
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
