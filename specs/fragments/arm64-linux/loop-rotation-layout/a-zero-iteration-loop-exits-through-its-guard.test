// Test: a-zero-iteration-loop-exits-through-its-guard
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function sumFrom(a WordArray, n Word, start Word) returns Word
	var t = start
	for i in 0 upto n 'each'
		t = t + (try a.get(i) otherwise panic("sumFrom: i < n = a.count()"))
	end 'each'
	return t
end 'sumFrom'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 1 to 3 'seed'
		a.push(i)
	end 'seed'
	return sumFrom(a, n: 0, start: 100)
end 'main'
---
ExitCode: 100
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1
    arm64.b forhdr
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
  forhdr:
    arm64.cmp x20, 3
    arm64.b.le seed
  forexit:
    arm64.movImm x20, 100
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
