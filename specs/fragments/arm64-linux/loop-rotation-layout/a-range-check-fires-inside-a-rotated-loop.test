// Test: a-range-check-fires-inside-a-rotated-loop
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function walkDown(a WordArray, start Word) returns Word
	var t = 0
	var i = start
	while i > -2 'down'
		t = t + (try a.get(i) otherwise 0)
		i = i - 1
	end 'down'
	return t
end 'walkDown'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 1 to 3 'seed'
		a.push(i)
	end 'seed'
	return walkDown(a, start: 1)
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x20
    arm64.storeSlotReg slot3, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1
    arm64.b forhdr
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
  forhdr:
    arm64.cmp x20, 3
    arm64.b.le seed
  forexit:
    arm64.movImm x1, 1
  __il_body:
    arm64.movImm x20, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.b whilehdr
  down:
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#17
  __rc_ok#16:
    arm64.cmp x1, x0
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x3, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x3, [x2 + x1*8 + 0]
  trycont:
    arm64.add x20, x20, x3
    arm64.sub x1, x1, 1
  whilehdr:
    arm64.cmp x1, -2
    arm64.b.gt down
  __il_cont:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic#6
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic#6
  __rc_ok#5:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_panic#17:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-range-check-fires-inside-a-rotated-loop.test:9: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.epilogue 64
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x3, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
  __rc_panic#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-range-check-fires-inside-a-rotated-loop.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.epilogue 64
    arm64.ret
}
