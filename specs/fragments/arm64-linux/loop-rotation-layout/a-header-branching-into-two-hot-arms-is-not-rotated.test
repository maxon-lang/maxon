// Test: a-header-branching-into-two-hot-arms-is-not-rotated
typealias Small = int(0 to 100)

function stepTo(limit Small) returns Small
	var i = 0 as Small
	while true 'spin'
		if i mod 2 == 0 'evenStep'
			i = i + 3
		end 'evenStep' else 'oddStep'
			i = i + 1
		end 'oddStep'
		if i >= limit 'done'
			break
		end 'done'
	end 'spin'
	return i
end 'stepTo'

function main() returns ExitCode
	return stepTo(10) + stepTo(5)
end 'main'
---
ExitCode: 18
---
func @stepTo {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#10
  __rc_chk#11:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic#10
  __rc_ok#9:
    arm64.movImm x1, 0
  spin:
    arm64.and x2, x1, 1
    arm64.cmp x2, 0
    arm64.b.ne ifelse
  evenStep:
    arm64.add x1, x1, 3
    arm64.b ifcont
  ifelse:
    arm64.add x1, x1, 1
  ifcont:
    arm64.cmp x1, x0
    arm64.b.lt spin
  done:
    arm64.movRegReg x0, x1
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#13
  __rc_chk#14:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic#13
  __rc_ok#12:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#10:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-header-branching-into-two-hot-arms-is-not-rotated.test:4: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#13:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-header-branching-into-two-hot-arms-is-not-rotated.test:16: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 10
    arm64.bl stepTo
    arm64.movRegReg x19, x0
    arm64.movImm x0, 5
    arm64.bl stepTo
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
