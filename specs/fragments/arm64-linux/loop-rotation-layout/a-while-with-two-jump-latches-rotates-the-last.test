// Test: a-while-with-two-jump-latches-rotates-the-last
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function weightedSum(a WordArray, n Word) returns Word
	var t = 0
	var i = 0
	while i < n 'each'
		let v = try a.get(i) otherwise panic("weightedSum: i < n = a.count()")
		i = i + 1
		if v mod 2 == 0 'even'
			t = t + 10
			continue
		end 'even'
		t = t + v
	end 'each'
	return t
end 'weightedSum'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 1 to 8 'seed'
		a.push(i)
	end 'seed'
	return weightedSum(a, n: 8)
end 'main'
---
ExitCode: 56
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @weightedSum {
  entry:
    arm64.prologue 64
    arm64.movImm x2, 0
    arm64.movImm x3, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x4, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x5, [x0 + 0]
    arm64.b whilehdr
  __rc_ok:
    arm64.cmp x3, x4
    arm64.b.hs __im_slow
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x6, [x5 + x3*8 + 0]
  tryok:
    arm64.add x3, x3, 1
    arm64.asr x7, x6, 63
    arm64.lsr x7, x7, 63
    arm64.add x7, x6, x7
    arm64.asr x7, x7, 1
    arm64.lsl x7, x7, 1
    arm64.sub x7, x6, x7
    arm64.cmp x7, 0
    arm64.b.ne ifcont
  even:
    arm64.add x2, x2, 10
    arm64.b whilehdr
  ifcont:
    arm64.add x2, x2, x6
  whilehdr:
    arm64.cmp x3, x1
    arm64.b.lt __rc_ok
  whileexit:
    arm64.movRegReg x0, x2
    arm64.epilogue 64
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, x5
    arm64.movRegReg x1, x3
    arm64.bl __managed_get
    arm64.movRegReg x6, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot x5, slot5
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-while-with-two-jump-latches-rotates-the-last.test:9: weightedSum: i < n = a.count()\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1
    arm64.b forhdr
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
  forhdr:
    arm64.cmp x20, 8
    arm64.b.le seed
  forexit:
    arm64.movImm x1, 8
    arm64.movRegReg x0, x19
    arm64.bl weightedSum
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-while-with-two-jump-latches-rotates-the-last.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
