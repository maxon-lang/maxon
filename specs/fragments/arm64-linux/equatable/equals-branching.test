// Test: equals-branching

typealias Integer = int(i64.min to i64.max)

type Token implements Equatable
	export var id as Integer

	function equals(other Token) returns bool
		return id == other.id
	end 'equals'

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Token'

function main() returns ExitCode
	let a = Token.create(10)
	let b = Token.create(10)
	let c = Token.create(20)
	var result = 0
	if a.equals(b) 'first'
		result = result + 1
	end 'first'
	if a.equals(c) 'second'
		result = result + 10
	end 'second'
	if b.equals(c) 'third'
		result = result + 100
	end 'third'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 10
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 10
    arm64.leaRegSlot x2, slot1
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.movImm x0, 20
    arm64.leaRegSlot x3, slot2
    arm64.storeBaseDispReg.word64 [x3 + 0], x0
    arm64.movImm x0, 0
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x4, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x5, [x2 + 0]
    arm64.cmp x4, x5
    arm64.cset x4, eq
  __il_cont#10:
    arm64.cbz x4, __il_body#13
  first:
    arm64.movImm x0, 1
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x4, [x3 + 0]
    arm64.cmp x1, x4
    arm64.cset x1, eq
  __il_cont#12:
    arm64.cbz x1, __il_body#15
  second:
    arm64.add x0, x0, 10
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x1, [x2 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x3 + 0]
    arm64.cmp x1, x2
    arm64.cset x1, eq
  __il_cont#14:
    arm64.cbz x1, ifcont
  third:
    arm64.add x0, x0, 100
  ifcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at equals-branching.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.epilogue 48
    arm64.ret
}
