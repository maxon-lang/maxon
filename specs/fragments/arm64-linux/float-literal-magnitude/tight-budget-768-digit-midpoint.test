// Test: tight-budget-768-digit-midpoint
function main() returns ExitCode
	var r = 0
	if 0. == 2.2250738585072004e-308 'tieRoundsToEven'
		r = r + 1
	end 'tieRoundsToEven'
	if 0. == 2.225073858507201e-308 'stickyBitRoundsUp'
		r = r + 2
	end 'stickyBitRoundsUp'
	return r
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
  tieRoundsToEven:
    arm64.movImm x0, 1
  stickyBitRoundsUp:
    arm64.add x0, x0, 2
  ifcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at tight-budget-768-digit-midpoint.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
