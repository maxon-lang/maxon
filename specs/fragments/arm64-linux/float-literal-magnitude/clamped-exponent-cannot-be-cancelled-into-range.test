// Test: clamped-exponent-cannot-be-cancelled-into-range
function main() returns ExitCode
	if .0e-999999999 == 0.0 'underflowsToZero'
		return 1
	end 'underflowsToZero'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  underflowsToZero:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
