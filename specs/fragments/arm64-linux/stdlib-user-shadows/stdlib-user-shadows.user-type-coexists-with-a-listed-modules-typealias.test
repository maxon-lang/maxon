// Test: stdlib-user-shadows.user-type-coexists-with-a-listed-modules-typealias
typealias Value = int(0 to 200)

type ParsedInt
	export let value as Value

	static function create(value Value) returns ParsedInt
		return Self{value: value}
	end 'create'
end 'ParsedInt'

function main() returns ExitCode
	let p = ParsedInt.create(7)
	return p.value
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 7
  __il_cont:
    arm64.and x0, x0, 255
    arm64.epilogue 16
    arm64.ret
}
