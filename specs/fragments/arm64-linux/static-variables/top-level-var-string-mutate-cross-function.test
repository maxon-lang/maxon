// Test: top-level-var-string-mutate-cross-function
var msg = "hi"

function bump()
	msg.append("!")
end 'bump'

function main() returns ExitCode
	bump()
	bump()
	print(msg)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_msg@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @bump {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_msg
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.leaRdata x20, __str_rec_2  ; "!"
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
  __il_body:
    arm64.movRegReg x0, x20
    arm64.bl __str_bytes_view
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl __managed_append
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.loadRegBaseDisp.byte x0, [x20 + 48]
    arm64.eor x0, x0, 1
    arm64.cbz x0, __il_cont
  clearFlag:
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.byte [x19 + 48], x0
  __il_cont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl bump
    arm64.bl bump
    arm64.leaGlobal x0, __data_msg
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.movRegReg x20, x0
  __il_body:
    arm64.movRegReg x0, x19
    arm64.bl __write_stdout
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
