// Test: top-level-array-grow-reassign-untouched

var grow = [1]
var untouched = [7, 7, 7]
let fixed = [4, 5, 6]

function main() returns ExitCode
	var i = 0
	while i < 200 'fill'
		grow.push(i)
		i = i + 1
	end 'fill'
	grow = [3, 4]
	let a = try grow.get(0) otherwise 0
	let b = try grow.get(1) otherwise 0
	let c = try fixed.get(2) otherwise 0
	return a + b + c + grow.count()
end 'main'
