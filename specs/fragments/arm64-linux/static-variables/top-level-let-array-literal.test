    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont#10
  critsplit#18:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
  __im_cont#10:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.movImm x19, 0
    arm64.b trycont#3
  tryok:
    arm64.movRegReg x19, x0
