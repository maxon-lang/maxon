// Test: top-level-let-array-literal
let NUMS = [10, 20, 30]

function main() returns ExitCode
	let a = try NUMS.get(0) otherwise 0
	let b = try NUMS.get(2) otherwise 0
	return a + b
end 'main'
---
ExitCode: 40
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRdata x0, __barr_rec_1
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow#11
    arm64.b __im_load#12
  tryerr#2:
    arm64.movImm x0, 0
    arm64.b trycont#3
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont#3:
    arm64.leaRdata x1, __barr_rec_1
    arm64.movImm x2, 2
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.cmp x3, 2
    arm64.b.ls __im_slow#14
    arm64.b __im_load#15
  tryerr#5:
    arm64.movImm x1, 0
    arm64.b trycont#6
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 16
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont#6:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
  __im_slow#11:
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
    arm64.b trycont#3
  __im_slow#14:
    arm64.storeSlotReg slot0, x0
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#5
    arm64.b trycont#6
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at top-level-let-array-literal.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}
