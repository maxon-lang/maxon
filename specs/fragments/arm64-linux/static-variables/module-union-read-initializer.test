// Test: module-union-read-initializer
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.owned(9)

function main() returns ExitCode
	return match hold 'm'
		unowned gives 0
		owned(v) gives v
	end 'm'
end 'main'
---
ExitCode: 9
---
data {
  __data_hold@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_hold
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at module-union-read-initializer.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
