// Test: a-boxed-union-vars-payload-slots-are-zeroed
typealias Integer = int(i64.min to i64.max)

union Counter
	none
	some(n Integer)
end 'Counter'

var sentinel = Counter.none

function valueOf(c Counter) returns Integer
	return match c 'k'
		none or
			some(n) gives n
	end 'k'
end 'valueOf'

function main() returns ExitCode
	return valueOf(sentinel) as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __data_sentinel@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_sentinel
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, ge
    arm64.cmp x1, 1
    arm64.cset x1, le
    arm64.and x1, x2, x1
    arm64.cbz x1, matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
  __il_cont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-boxed-union-vars-payload-slots-are-zeroed.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
