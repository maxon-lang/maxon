// Test: bitwise-and-or-still-evaluate-both
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let a = 12 as Integer
	let b = 10 as Integer
	let andResult = a and b
	let orResult = a or b
	return (andResult + orResult) as ExitCode
end 'main'
---
ExitCode: 22
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 22
    arm64.epilogue 16
    arm64.ret
}
