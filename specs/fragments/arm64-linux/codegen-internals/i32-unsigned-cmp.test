// Test: i32-unsigned-cmp
typealias SmallInt = int(0 to 1000)

function main() returns ExitCode
	let a = 10 as SmallInt
	let b = 3 as SmallInt
	if a > b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
