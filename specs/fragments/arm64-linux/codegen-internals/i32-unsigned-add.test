// Test: i32-unsigned-add
typealias SmallInt = int(0 to 1000)

function main() returns ExitCode
	let a = 10 as SmallInt
	let b = 3 as SmallInt
	return a + b
end 'main'
---
ExitCode: 13
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 13
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
