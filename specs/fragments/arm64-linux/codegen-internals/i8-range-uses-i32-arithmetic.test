// Test: i8-range-uses-i32-arithmetic
typealias Tiny = int(0 to 100)

function main() returns ExitCode
	let a = 21 as Tiny
	let b = 3 as Tiny
	return a / b
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 21
    arm64.movImm x1, 12297829382473034411
    arm64.umulh x0, x1, x0
    arm64.lsr x0, x0, 1
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at i8-range-uses-i32-arithmetic.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
