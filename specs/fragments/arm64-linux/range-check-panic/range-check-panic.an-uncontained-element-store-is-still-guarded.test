// Test: range-check-panic.an-uncontained-element-store-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias Loose = int(0 to 2000)
typealias Wide = int(0 to 1000)
typealias Wides = Array with Wide

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function loose() returns Loose
  return opaque(1001)
end 'loose'

function main() returns ExitCode
  var a = Wides.create()
  a.push(loose())
  let v = try a.get(0) otherwise panic("no slot")
  print("v={v}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
  __rc_panic:
    arm64.leaRdata x0, __str_blob_7  ; "panic at range-check-panic.an-uncontained-element-store-is-still-guarded.test:17: Range check failed: value outside typealias 'Wide'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
