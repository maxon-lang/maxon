// Test: range-check-panic.lower-bound
typealias Integer = int(i64.min to i64.max)
typealias Natural = int(0 to i64.max)

function check(n Natural) returns Natural
  return n
end 'check'

function neg(n Integer) returns Integer
  return -n
end 'neg'

function main() returns ExitCode
  let below = neg(1)
  return check(below as Natural) as ExitCode
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at range-check-panic.lower-bound.test:15: Range check failed: value outside typealias 'Natural'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
