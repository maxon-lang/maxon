// Test: range-check-panic.an-uncontained-field-store-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias Loose = int(0 to 2000)
typealias Wide = int(0 to 1000)

type Box
  export var v as Wide

  static function create() returns Box
    return Self{v: 1}
  end 'create'
end 'Box'

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function loose() returns Loose
  return opaque(1001)
end 'loose'

function main() returns ExitCode
  var b = Box.create()
  b.v = loose() as Wide
  print("v={b.v}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x19, 1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6  ; "panic at range-check-panic.an-uncontained-field-store-is-still-guarded.test:24: Range check failed: value outside typealias 'Wide'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
