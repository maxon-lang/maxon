// Test: range-check-panic.runtime-argument
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function divide(a Integer, by NonZero) returns Integer
  return ((a as NonZero) / by) as Integer
end 'divide'

function main() returns ExitCode
  return divide(10, by: opaque(0) as NonZero) as ExitCode
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at range-check-panic.runtime-argument.test:14: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
