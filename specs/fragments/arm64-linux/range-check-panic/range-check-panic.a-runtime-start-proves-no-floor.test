// Test: range-check-panic.a-runtime-start-proves-no-floor
typealias Integer = int(i64.min to i64.max)
typealias NonNeg = int(0 to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function main() returns ExitCode
  var total = 0 as Integer
  for i in opaque(-2) upto opaque(3) 'each'
    let g = i as NonNeg
    total = total + g
  end 'each'
  print("total={total}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at range-check-panic.a-runtime-start-proves-no-floor.test:12: Range check failed: value outside typealias 'NonNeg'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
