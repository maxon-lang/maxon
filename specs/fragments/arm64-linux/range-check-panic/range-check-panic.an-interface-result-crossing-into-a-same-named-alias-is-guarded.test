// Test: range-check-panic.an-interface-result-crossing-into-a-same-named-alias-is-guarded
// --- file: a.maxon
export typealias Level = int(0 to 100)

export interface Gauge
  function read() returns Level
end 'Gauge'

type Tank implements Gauge
  let fill as Level

  static function create() returns Self
    return Self{fill: 90}
  end 'create'

  function read() returns Level
    return self.fill
  end 'read'
end 'Tank'

export function makeTank() returns Gauge
  return Tank.create()
end 'makeTank'

// --- file: z.maxon
typealias Level = int(0 to 3)

function relay(g Gauge) returns Level
  return g.read()
end 'relay'

function main() returns ExitCode
  return relay(makeTank())
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @Tank.read {
  entry:
    arm64.prologue 16
    arm64.and x0, x0, 255
    arm64.epilogue 16
    arm64.ret
}

func @makeTank {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 90
  __il_cont:
    arm64.leaRdata x9, __witness_Tank.Gauge
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl makeTank
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x9
  __il_body:
    arm64.movRegReg x0, x19
    arm64.loadRegBaseDisp.word64 x16, [x20 + 48]
    arm64.blr x16
    arm64.movRegReg x21, x0
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 3
    arm64.b.gt __rc_panic
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __drop_existential
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at z.maxon:4: Range check failed: value outside typealias 'Level'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
