    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6  ; "panic at range-check-panic.an-inclusive-counted-loop-past-the-unsigned-top-still-panics.test:10: Range check failed: value outside typealias 'Neg'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.loadRegSlot x21, slot5
    arm64.loadRegSlot x22, slot6
