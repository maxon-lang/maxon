// Test: multiple-constants
let A = 1
let B = 2
let C = 3

function main() returns ExitCode
	return A + B + C
end 'main'
---
ExitCode: 6
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 6
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
