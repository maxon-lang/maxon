    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x1, x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
  __il_cont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at type-method-basic.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
