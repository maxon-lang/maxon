// Test: round.halfway
function main() returns ExitCode
	let x = 2.5
	let y = trunc(round(x))
	return y
end 'main'
---
ExitCode: 2
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
