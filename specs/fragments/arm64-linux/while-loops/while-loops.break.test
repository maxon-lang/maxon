// Test: while-loops.break
function main() returns ExitCode
	var x = 5
	while true 'loop'
		x = x + 2
		if x == 11 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
  loop:
    arm64.add x0, x0, 2
    arm64.cmp x0, 11
    arm64.b.ne loop
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
