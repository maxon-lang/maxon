// Test: while-loops.inner-declaration-shadows-a-carried-var
function main() returns ExitCode
	var t = 0
	t = 100
	var i = 0
	while i < 3 'l'
		var t = 0
		t = i + 1
		i = i + t
	end 'l'
	return t
end 'main'
---
ExitCode: 100
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 0
    arm64.b whilehdr
  l:
    arm64.add x2, x1, 1
    arm64.add x1, x1, x2
  whilehdr:
    arm64.cmp x1, 3
    arm64.b.lt l
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
