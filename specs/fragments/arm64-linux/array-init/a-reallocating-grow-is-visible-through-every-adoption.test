// Test: a-reallocating-grow-is-visible-through-every-adoption
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let mm = try __ManagedMemory.create(2, elementSize: 1) otherwise return 1
	var a = ByteArray.init(mm)
	var b = ByteArray.init(mm)
	var i = 0
	while i < 200 'fill'
		a.push(1)
		i = i + 1
	end 'fill'
	if b.count() != 200 'notShared'
		return 2
	end 'notShared'
	let last = try b.get(199) otherwise return 3
	return (last + mm.length() - 200) as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 2
    arm64.movImm x1, 1
    arm64.bl __managed_mem_create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.movImm x22, 0
  whilehdr:
    arm64.cmp x22, 200
    arm64.b.ge whileexit
  fill:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.add x22, x22, 1
    arm64.b whilehdr
  whileexit:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 200
    arm64.b.eq ifcont
  notShared:
    arm64.movImm x22, 2
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x1, 199
    arm64.loadRegBaseDisp.word64 x0, [x21 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 199
    arm64.b.ls __im_slow
  __im_load#19:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.add x0, x0, 1592
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 199
    arm64.b.ls __im_slow
  __im_load#20:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.add x0, x0, 199
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
  __im_loaded:
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x21 + 40]
    arm64.cmp x3, 0
    arm64.b.eq __im_cont
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne __im_cont
  __im_slow:
    arm64.movRegReg x0, x21
    arm64.bl __managed_get
    arm64.movRegReg x2, x9
  __im_cont:
    arm64.cmp x2, 0
    arm64.b.eq tryok#8
  tryerr#9:
    arm64.movImm x22, 3
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#8:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.add x0, x0, x1
    arm64.sub x22, x0, 200
    arm64.cmp x22, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x22, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-reallocating-grow-is-visible-through-every-adoption.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
