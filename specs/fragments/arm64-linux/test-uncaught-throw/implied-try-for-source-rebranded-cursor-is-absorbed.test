// Test: implied-try-for-source-rebranded-cursor-is-absorbed
// --- file: suite.maxtest
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias Walk = ArrayIterator with Integer

test 'an empty rebranded traversal runs no trips'
	var total = 0

	for x in IntArray.create().cursor() as Walk 'each'
		total = total + x
	end 'each'

	Expect.equal(total, expected: 0)
end 'an empty rebranded traversal runs no trips'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @__test_an_empty_rebranded_traversal_runs_no_trips {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl Array.cursor
    arm64.movRegReg x21, x0
    arm64.movRegReg x22, x9
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movImm x0, 0
    arm64.cmp x22, 0
    arm64.b.eq forhdr
    arm64.b forjoin
  each:
    arm64.leaRdata x20, __layout_ArrayIterator_Integer
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.bl __managed_cursor_current
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __retain_type_param
  __il_cont#9:
    arm64.add x19, x19, x0
  forstep:
    arm64.movRegReg x0, x21
    arm64.bl ArrayIterator.advance
    arm64.movRegReg x0, x9
  forhdr:
    arm64.cmp x0, 0
    arm64.b.eq each
  forexit:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_ArrayIterator_Integer
  forjoin:
    arm64.movImm x20, 0
  __il_body#12:
    arm64.leaRdata x0, __str_rec_27  ; ""
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
  __il_cont#11:
    arm64.leaRdata x3, __str_rec_14  ; "suite.maxtest"
    arm64.movImm x4, 12
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl Expect.equal#__with165_25#int
    arm64.movRegReg x19, x9
    arm64.cmp x19, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
