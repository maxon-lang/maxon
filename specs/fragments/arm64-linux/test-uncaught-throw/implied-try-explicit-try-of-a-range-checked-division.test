// Test: implied-try-explicit-try-of-a-range-checked-division
// --- file: suite.maxtest
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias Wide = int(-1000000000000 to 1000000000000)

test 'divides by a counted value'
	let d = IntArray.create().count()
	let n = try ((8 / d) as Wide) otherwise 5
	Expect.equal(n, expected: 5)
end 'divides by a counted value'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @__test_divides_by_a_counted_value {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.bl __managed_decref
    arm64.movImm x0, 8
    arm64.cmp x19, 0
    arm64.cset x1, eq
    arm64.orr x2, x19, x1
    arm64.udiv x19, x0, x2
    arm64.movImm x0, 18446743073709551616
    arm64.cmp x19, x0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.movImm x0, 1000000000000
    arm64.cmp x19, x0
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.cmp x1, 0
    arm64.b.eq trycont
  tryerr#2:
    arm64.movImm x19, 5
  trycont:
    arm64.movImm x20, 5
  __il_body:
    arm64.leaRdata x0, __str_rec_27  ; ""
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
  __il_cont:
    arm64.leaRdata x3, __str_rec_14  ; "suite.maxtest"
    arm64.movImm x4, 8
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl Expect.equal#__with165_25#Wide
    arm64.movRegReg x19, x9
    arm64.cmp x19, 0
    arm64.b.eq tryok
  tryerr#5:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_40  ; "panic at suite.maxtest:7: Range check failed: value outside typealias 'Wide'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
