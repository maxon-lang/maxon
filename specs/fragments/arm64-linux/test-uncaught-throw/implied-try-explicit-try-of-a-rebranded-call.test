// Test: implied-try-explicit-try-of-a-rebranded-call
// --- file: suite.maxtest
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias Scores = Array with Integer

enum ApiError implements Error
	notFound
end 'ApiError'

function items(hit bool) returns IntArray throws ApiError
	if not hit 'miss'
		throw ApiError.notFound
	end 'miss'

	var found = IntArray.create()
	found.push(4)
	found.push(5)
	return found
end 'items'

test 'rebrands the fetched items'
	let s = try (items(true) as Scores) otherwise Scores.create()
	Expect.equal(s.count(), expected: 2)
end 'rebrands the fetched items'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @items {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  miss:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x9, 0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @__test_rebrands_the_fetched_items {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl items
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.b trycont
  tryok#1:
    arm64.movRegReg x19, x0
  trycont:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movImm x21, 2
  __il_body:
    arm64.leaRdata x0, __str_rec_27  ; ""
    arm64.bl __str_retain
    arm64.movRegReg x22, x0
  __il_cont:
    arm64.leaRdata x3, __str_rec_14  ; "suite.maxtest"
    arm64.movImm x4, 22
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl Expect.equal#__with165_25#ElementIndex
    arm64.movRegReg x20, x9
    arm64.cmp x20, 0
    arm64.b.eq tryok#4
  tryerr#5:
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#4:
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
