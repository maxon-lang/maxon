// Test: a-body-that-panics-on-only-one-path-does-not-diverge
function notFatal(b bool)
	if b 'y'
		panic("boom")
	end 'y'
	print("survived\n")
end 'notFatal'

function main() returns ExitCode
	notFatal(false)
	print("back in main\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  ifcont:
    arm64.leaRdata x0, __str_rec_3  ; "survived\x0a"
    arm64.bl print
  __il_cont:
    arm64.leaRdata x0, __str_rec_4  ; "back in main\x0a"
    arm64.bl print
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
