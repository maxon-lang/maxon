// Test: try-block-shadowed-binding.closure-inside-a-handler-matches-its-own-binding
typealias Score = int(0 to 100)

enum ErrA implements Error
    bad
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

enum Inner
    bad
    splat
end 'Inner'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(true)
        let b = callB(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        let pick = function(e Inner) gives match e 'inner'
            bad gives 3
            splat gives 8
        end 'inner'
        match e 'k'
            ErrA.bad then sum = pick(Inner.splat)
            ErrB.splat then sum = pick(Inner.bad)
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 8
---
func @callA {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @callB {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 6
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl callA
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne tryblkerr
  tryblkok#2:
    arm64.movImm x0, 0
    arm64.bl callB
    arm64.add x1, x9, 1
    arm64.cmp x9, 0
    arm64.b.eq tryblkok#3
  critsplit:
    arm64.movRegReg x9, x1
  tryblkerr:
    arm64.leaFuncAddr x19, main$closure_0
    arm64.cmp x9, 1
    arm64.b.ne matchnext
  matcharm#4:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.b tryblkcont
  matchnext:
    arm64.cmp x9, 2
    arm64.b.ne matchdead
  matcharm#5:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.b tryblkcont
  matchdead:
  tryblkok#3:
    arm64.add x0, x19, x0
  tryblkcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at try-block-shadowed-binding.closure-inside-a-handler-matches-its-own-binding.test:48: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 3
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x0, 8
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
