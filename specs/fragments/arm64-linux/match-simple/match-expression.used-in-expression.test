// Test: match-expression.used-in-expression
function main() returns ExitCode
	let x = 2
	let doubled = match x 'eval'
		1 gives 10
		2 gives 20
		default gives 0
	end 'eval' * 2
	return doubled
end 'main'
---
ExitCode: 40
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 20
  matchcont:
    arm64.lsl x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
