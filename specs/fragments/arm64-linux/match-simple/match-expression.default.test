// Test: match-expression.default
function main() returns ExitCode
	let x = 99
	let result = match x 'eval'
		1 gives 10
		2 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  matchdefault:
    arm64.movImm x0, 0
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
