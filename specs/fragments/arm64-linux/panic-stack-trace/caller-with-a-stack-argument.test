// Test: caller-with-a-stack-argument
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 100)

function total(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer, g Integer, h Integer, i Integer) returns SmallInt
	return (a + b + c + d + e + f + g + h + i) as SmallInt
end 'total'

function spread(n Integer) returns SmallInt
	return total(n, b: n, c: n, d: n, e: n, f: n, g: n, h: n, i: n)
end 'spread'

function main() returns ExitCode
	return spread(20)
end 'main'
---
ExitCode: 1
---
func @total {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x8, [x29 + 16]
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x3
    arm64.add x0, x0, x4
    arm64.add x0, x0, x5
    arm64.add x0, x0, x6
    arm64.add x0, x0, x7
    arm64.add x0, x0, x8
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at caller-with-a-stack-argument.test:6: Range check failed: value outside typealias 'SmallInt'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @spread {
  entry:
    arm64.prologue 32 record@8
    arm64.movRegReg x7, x0
  __il_body:
    arm64.add x0, x7, x7
    arm64.add x0, x0, x7
    arm64.add x0, x0, x7
    arm64.add x0, x0, x7
    arm64.add x0, x0, x7
    arm64.add x0, x0, x7
    arm64.add x0, x0, x7
    arm64.add x0, x0, x7
    arm64.cmp x0, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.gt __il_slow
  __il_cont:
    arm64.epilogue 32 record@8
    arm64.ret
  __il_slow:
    arm64.storeOutgoingArg [sp + arg0], x7
    arm64.movRegReg x0, x7
    arm64.movRegReg x1, x7
    arm64.movRegReg x2, x7
    arm64.movRegReg x3, x7
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x7
    arm64.movRegReg x6, x7
    arm64.bl total
    arm64.b __il_cont
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.bl spread
    arm64.epilogue 16
    arm64.ret
}
