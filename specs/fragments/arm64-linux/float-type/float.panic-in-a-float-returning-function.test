// Test: float.panic-in-a-float-returning-function
function scaled(x Real) returns Real
	if x < 0.0 'negative'
		panic("scaled: negative input")
	end 'negative'
	return x * 2.0
end 'scaled'

function main() returns ExitCode
	return trunc(scaled(21.0))
end 'main'
typealias Real = float(f64.min to f64.max)
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  ifcont:
    arm64.fpLoadRdata d0, [rdata + __fconst_42]
  __il_cont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at float.panic-in-a-float-returning-function.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
