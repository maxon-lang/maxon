// Test: float-alias-struct-field-zero-defaults

typealias Weight = float(f64.min to f64.max)

type Particle
	export var mass as Weight = 0
	export var vel as Weight = 0.0

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Particle'

function main() returns ExitCode
	let p = Particle.make()
	if p.mass == 0.0 'zeroMass'
		if p.vel == 0.0 'zeroVel'
			return trunc((p.mass + p.vel + 4.2) * 10.0)
		end 'zeroVel'
	end 'zeroMass'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, d9
    arm64.storeSlotReg slot1, d8
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.fpLoadRdata d8, [rdata + __fconst_0]
    arm64.fpLoadRdata d9, [rdata + __fconst_0]
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], d8
    arm64.storeBaseDispReg.word64 [x0 + 8], d9
  __il_cont:
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.ne ifcont
  zeroMass:
    arm64.loadRegBaseDisp.word64 d0, [x0 + 8]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.ne ifcont
  zeroVel:
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 d1, [x0 + 8]
    arm64.fadd d0, d0, d1
    arm64.fpLoadRdata d1, [rdata + __fconst_4.2]
    arm64.fadd d0, d0, d1
    arm64.fpLoadRdata d1, [rdata + __fconst_10]
    arm64.fmul d0, d0, d1
    arm64.fcvtzs x19, d0
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.loadRegSlot d9, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x19, 7
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.loadRegSlot d9, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at float-alias-struct-field-zero-defaults.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.loadRegSlot d9, slot2
    arm64.epilogue 48
    arm64.ret
}
