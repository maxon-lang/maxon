    arm64.cmp x0, 0
    arm64.b.ls __im_slow#16
  __im_buffer#18:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow#16
  __im_viewed#19:
    arm64.sub x3, x0, 24
    arm64.loadRegBaseDisp.word64 x3, [x3 + 16]
    arm64.cmp x3, 0
    arm64.b.ne __im_slow#16
  __im_store#20:
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
  tryok#1:
    arm64.leaRdata x1, __layout_Array_Word
    arm64.movRegReg x0, x19
    arm64.bl Array.clone
    arm64.movImm x1, 0
    arm64.movImm x2, 20
    arm64.loadRegBaseDisp.word64 x3, [x19 + 16]
    arm64.cmp x3, 0
    arm64.b.lt __im_slow#22
  __im_bounds#23:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 8]
    arm64.cmp x3, 0
    arm64.b.ls __im_slow#22
  __im_buffer#24:
