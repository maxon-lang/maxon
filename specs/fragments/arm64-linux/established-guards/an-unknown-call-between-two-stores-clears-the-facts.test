  __im_slow#12:
    arm64.storeSlotReg slot0, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at an-unknown-call-between-two-stores-clears-the-facts.test:12: rewrite: a holds an element\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
