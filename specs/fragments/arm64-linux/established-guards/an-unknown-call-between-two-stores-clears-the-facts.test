    arm64.cmp x0, 0
    arm64.b.eq __im_slow#6
  __im_viewed#9:
    arm64.sub x3, x0, 24
    arm64.loadRegBaseDisp.word64 x3, [x3 + 16]
    arm64.cmp x3, 0
    arm64.b.ne __im_slow#6
  __im_store#10:
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
  tryok#1:
    arm64.movRegReg x0, x19
    arm64.bl share
    arm64.movImm x1, 0
    arm64.movImm x2, 20
    arm64.loadRegBaseDisp.word64 x3, [x19 + 16]
    arm64.cmp x3, 0
    arm64.b.lt __im_slow#12
  __im_bounds#13:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 8]
    arm64.cmp x3, 0
    arm64.b.ls __im_slow#12
  __im_buffer#14:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.cmp x3, 0
    arm64.b.eq __im_slow#12
  __im_viewed#15:
    arm64.sub x4, x3, 24
    arm64.loadRegBaseDisp.word64 x4, [x4 + 16]
    arm64.cmp x4, 0
    arm64.b.ne __im_slow#12
  __im_store#16:
    arm64.storeBaseDispReg.word64 [x3 + 0], x2
  tryok#3:
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow#6:
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
