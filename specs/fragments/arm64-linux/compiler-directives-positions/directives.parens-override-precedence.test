// Test: directives.parens-override-precedence
function main() returns ExitCode
	#if (testing(false) or testing(true)) and testing(true)
		return 94
	#else
		return 28
	#endif
end 'main'
---
ExitCode: 28
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 28
    arm64.epilogue 16
    arm64.ret
}
