// Test: directives.union-body-cases
union Reading
	#if testing(false)
		settled
	#else
		discarded
	#endif
	pending
end 'Reading'

function main() returns ExitCode
	return match Reading.settled 'r'
		settled gives 35
		pending gives 90
	end 'r'
end 'main'
---
ExitCode: 35
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 35
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
