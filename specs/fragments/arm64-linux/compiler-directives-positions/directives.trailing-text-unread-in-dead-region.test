// Test: directives.trailing-text-unread-in-dead-region
#if os(Plan9)
	#if os(Windows) this is not a condition
	#endif
#endif

function main() returns ExitCode
	return 21
end 'main'
---
ExitCode: 21
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 21
    arm64.epilogue 16
    arm64.ret
}
