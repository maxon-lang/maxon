// Test: directives.same-name-in-both-branches
#if testing(false)
	let marker = 31
#else
	let marker = 91
#endif

function main() returns ExitCode
	return marker
end 'main'
---
ExitCode: 31
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 31
    arm64.epilogue 16
    arm64.ret
}
