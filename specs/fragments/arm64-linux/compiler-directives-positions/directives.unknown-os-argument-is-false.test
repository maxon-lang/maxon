// Test: directives.unknown-os-argument-is-false
function main() returns ExitCode
	#if os(Plan9)
		return 96
	#else
		return 25
	#endif
end 'main'
---
ExitCode: 25
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 25
    arm64.epilogue 16
    arm64.ret
}
