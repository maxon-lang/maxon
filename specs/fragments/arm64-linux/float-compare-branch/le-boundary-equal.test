// Test: le-boundary-equal
function main() returns ExitCode
	var r = 7
	let x = 4.25
	let y = 4.25
	if x <= y 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
