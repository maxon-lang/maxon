    arm64.cbz x0, ifcont
  c:
    arm64.movImm x19, 50
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @callB {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 6
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

