// Test: try-block.bare-throw-routed
typealias Count = int(0 to 1000)

enum Kind
    alpha
    beta
    gamma
end 'Kind'

enum MyError implements Error
    fooErr
    barErr
end 'MyError'

function dispatch(k Kind) returns Count throws MyError
    var result = 0
    try 'd'
        match k 'm'
            alpha then result = 1
            beta then throw MyError.barErr
            default throws MyError.fooErr
        end 'm'
    end 'd' otherwise (e) 'h'
        match e 'he'
            fooErr then result = 40
            barErr then result = 80
        end 'he'
    end 'h'
    return result
end 'dispatch'

function main() returns ExitCode
    let a = try dispatch(Kind.alpha) otherwise panic("alpha escaped")
    let b = try dispatch(Kind.beta) otherwise panic("beta escaped")
    let c = try dispatch(Kind.gamma) otherwise panic("gamma escaped")
    return a + b + c
end 'main'
---
ExitCode: 121
---
func @dispatch {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#2:
    arm64.movImm x0, 1
    arm64.b tryblkcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdefault
  matcharm#3:
    arm64.movImm x0, 2
    arm64.b tryblkerr
  matchdefault:
    arm64.movImm x0, 1
  tryblkerr:
    arm64.sub x0, x0, 1
    arm64.cmp x0, 0
    arm64.b.ne matcharm#8
  matcharm#7:
    arm64.movImm x0, 40
    arm64.b tryblkcont
  matcharm#8:
    arm64.movImm x0, 80
  tryblkcont:
    arm64.movImm x9, 0
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl dispatch
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
  tryok#1:
    arm64.movImm x0, 1
    arm64.bl dispatch
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#4
  tryok#3:
    arm64.movImm x0, 2
    arm64.bl dispatch
    arm64.cmp x9, 0
    arm64.b.ne tryerr#6
  tryok#5:
    arm64.add x1, x19, x20
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at try-block.bare-throw-routed.test:33: alpha escaped\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at try-block.bare-throw-routed.test:34: beta escaped\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at try-block.bare-throw-routed.test:35: gamma escaped\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at try-block.bare-throw-routed.test:36: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
