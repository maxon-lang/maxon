// Test: try-block.multi-union-assoc-default
typealias Score = int(0 to 1000)

union ErrA implements Error
    bad(code Score)
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad(50)
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(true)
        let b = callB(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            ErrB.splat then sum = 99
            default panic("unhandled error variant")
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @callA {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x19, 50
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @callB {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 6
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl callA
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryblkok#2
  tryblkthrow:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.b tryblkerr
  tryblkok#2:
    arm64.movImm x0, 0
    arm64.bl callB
    arm64.cmp x9, 0
    arm64.b.eq tryblkok#4
  critsplit:
    arm64.movRegReg x0, x9
    arm64.movRegReg x1, x9
  tryblkerr:
    arm64.cmp x1, 1
    arm64.b.ne matchdefault
  matcharm:
    arm64.movImm x0, 99
    arm64.b tryblkcont
  matchdefault:
    arm64.cmp x1, 0
    arm64.b.lt errunionnext
  errunionclean:
    arm64.cmp x1, 0
    arm64.b.gt errunionnext
  errunionfree:
    arm64.bl __mm_decref
  errunionnext:
    arm64.leaRdata x0, __str_blob_0  ; "panic at try-block.multi-union-assoc-default.test:36: unhandled error variant\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryblkok#4:
    arm64.add x0, x19, x0
  tryblkcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at try-block.multi-union-assoc-default.test:39: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
