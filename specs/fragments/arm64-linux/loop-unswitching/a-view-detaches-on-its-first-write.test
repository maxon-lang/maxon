    arm64.b.lt seed
  forexit#4:
    arm64.movImm x1, 0
    arm64.movImm x2, 4
    arm64.leaRdata x3, __layout_Array_Word
    arm64.movRegReg x0, x19
    arm64.bl Array.slice
    arm64.cmp x9, 0
    arm64.b.ne tryerr#6
  __il_body:
    arm64.movImm x1, 0
  __us_test#48:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 16]
    arm64.cmp x2, 0
    arm64.b.lt forhdr#23
  __us_test#49:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.cmp x3, 0
    arm64.b.eq forhdr#23
  __us_test#50:
    arm64.sub x4, x3, 24
