    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.epilogue 64
    arm64.ret
  tryerr#6:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-view-detaches-on-its-first-write.test:16: main: 0..4 is within a\x0a"
    arm64.bl mrt_panic
