  whilehdr:
    arm64.cmp x1, 10
    arm64.b.lt grow
  matcharm#12:
    arm64.add x1, x1, 2
  matchcont#15:
    arm64.movImm x2, 2
    arm64.movImm x3, 1
    arm64.cmp x3, 0
    arm64.b.ne matchnext
  matcharm#16:
    arm64.add x19, x1, 1
    arm64.b matchcont#20
  matchnext:
    arm64.cmp x3, 1
    arm64.b.ne matchdead
  matcharm#17:
    arm64.add x19, x1, x2
  matchcont#20:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#22
  __rc_chk#23:
