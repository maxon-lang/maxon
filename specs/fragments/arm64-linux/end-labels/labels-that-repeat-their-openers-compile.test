    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_body#29:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
  __il_cont#24:
    arm64.cmp x1, 2
    arm64.b.le ifelse
  __il_body#31:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.lsl x1, x1, 1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#33
  __rc_chk#34:
    arm64.cmp x1, 100
    arm64.b.gt __rc_panic#33
  __il_cont#30:
    arm64.add x1, x1, 1
    arm64.b ifcont
  ifelse:
    arm64.add x1, x19, 1
  ifcont:
    arm64.movImm x2, 0
    arm64.b forhdr
  eachStep:
    arm64.add x1, x1, x2
  forstep:
