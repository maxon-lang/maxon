// Test: cross-file-constant-read-is-a-reference
// --- file: api/limits.maxon
export let MAX_USED = 7

// --- file: app/main.maxon
function main() returns ExitCode
	return MAX_USED
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
