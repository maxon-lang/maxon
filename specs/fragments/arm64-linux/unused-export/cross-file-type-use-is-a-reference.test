// Test: cross-file-type-use-is-a-reference
// --- file: api/shapes.maxon
typealias Integer = int(i64.min to i64.max)

export type UsedPoint
	export var x as Integer

	export static function origin() returns UsedPoint
		return UsedPoint{x: 4}
	end 'origin'
end 'UsedPoint'

// --- file: app/main.maxon
function main() returns ExitCode
	let p = UsedPoint.origin()
	return p.x
end 'main'
---
ExitCode: 4
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x19, 4
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_cont:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at main.maxon:3: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
