// Test: overloads-agree-on-the-error-they-throw
typealias Num = int(-1000 to 1000)

enum Boom
	bad
end 'Boom'

type Chk

	export static function want(actual Num, expected Num) returns Num throws Boom
		if actual != expected 'differ'
			throw Boom.bad
		end 'differ'
		return 5
	end 'want'

	export static function want(actual bool, expected bool) returns Num throws Boom
		if actual != expected 'differ'
			throw Boom.bad
		end 'differ'
		return 9
	end 'want'

end 'Chk'

function main() returns ExitCode
	let a = try Chk.want(1, expected: 1) otherwise 0
	let b = try Chk.want(true, expected: true) otherwise 0
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 14
---
func @Chk.want {
  entry:
    arm64.prologue 16
    arm64.cmp x0, -1000
    arm64.b.lt __rc_panic#4
  __rc_chk#5:
    arm64.cmp x0, 1000
    arm64.b.le __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_0  ; "panic at overloads-agree-on-the-error-they-throw.test:10: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#3:
    arm64.cmp x1, -1000
    arm64.b.lt __rc_panic#7
  __rc_chk#8:
    arm64.cmp x1, 1000
    arm64.b.le __rc_ok#6
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_0  ; "panic at overloads-agree-on-the-error-they-throw.test:10: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#6:
    arm64.cmp x0, x1
    arm64.b.eq ifcont
  differ:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @Chk.want#bool#bool {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.b.eq ifcont
  differ:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 9
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 1
    arm64.bl Chk.want
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.movImm x19, 0
    arm64.b trycont#3
  tryok:
    arm64.movRegReg x19, x0
  trycont#3:
    arm64.movImm x0, 1
    arm64.movImm x1, 1
    arm64.bl Chk.want#bool#bool
    arm64.cmp x9, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 0
  trycont#6:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at overloads-agree-on-the-error-they-throw.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
