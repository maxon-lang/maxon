// Test: string-contains-string
function main() returns ExitCode
	let text = "hello world"
	if text.contains("world") 'check'
		return 1
	end 'check' else 'other'
		return 0
	end 'other'
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "hello world"
    arm64.leaRdata x2, __str_rec_3  ; "world"
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#6:
    arm64.bl needleOccursIn
  __il_cont#4:
    arm64.cbz x0, ifelse
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
