// Test: basic-type-disambiguation
typealias Integer = int(i64.min to i64.max)

function process(value Integer) returns Integer
	return value * 2
end 'process'

function process(value String) returns Integer
	return value.count()
end 'process'

function main() returns ExitCode
	return process(21)
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
