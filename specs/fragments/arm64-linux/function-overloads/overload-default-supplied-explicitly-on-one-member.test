// Test: overload-default-supplied-explicitly-on-one-member
typealias Integer = int(i64.min to i64.max)

function width(value Integer, unit String = "mm") returns Integer
	return value + (unit.count() as Integer)
end 'width'

function width(value bool, unit String = "inches") returns Integer
	if value 'yes'
		return unit.count()
	end 'yes'
	return 0
end 'width'

function main() returns ExitCode
	return (width(3, unit: "centimetre") + width(true)) as ExitCode
end 'main'
---
ExitCode: 19
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_3  ; "centimetre"
  __il_body#7:
    arm64.bl String.count
    arm64.add x19, x0, 3
  __il_body#8:
    arm64.leaRdata x0, __str_rec_5  ; "inches"
    arm64.bl __str_retain
    arm64.movRegReg x20, x0
  yes:
    arm64.movRegReg x0, x20
    arm64.bl String.count
  __il_cont:
    arm64.add x19, x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_18  ; "panic at overload-default-supplied-explicitly-on-one-member.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
