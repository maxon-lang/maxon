// Test: enum-member-constant
enum Color
	Red
	Green
	Blue
end 'Color'

let DEFAULT_COLOR = Color.Green

function main() returns ExitCode
	match DEFAULT_COLOR 'check'
		Red then return 1
		Green then return 2
		Blue then return 3
	end 'check'
end 'main'
---
ExitCode: 2
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}
