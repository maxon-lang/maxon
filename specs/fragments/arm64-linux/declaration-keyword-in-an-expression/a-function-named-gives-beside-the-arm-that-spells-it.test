// Test: a-function-named-gives-beside-the-arm-that-spells-it
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

function classify(m Marker) returns Idx
	return match m 'm'
		function gives (1 + 1)
		other gives 3
	end 'm'
end 'classify'

function gives(x Idx) returns Idx
	return x * 10
end 'gives'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	return (gives(classify(Marker.function) * 2) + pick(Victim.found(2))) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm#8:
    arm64.movImm x0, 2
  __il_cont#6:
    arm64.lsl x0, x0, 1
  __rc_ok#17:
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
  __il_cont#5:
    arm64.movImm x1, 2
    arm64.movImm x2, 0
  __il_body:
    arm64.cmp x2, 0
    arm64.b.eq __il_cont#4
  matchnext:
    arm64.cmp x2, 1
    arm64.b.ne matchdead
  matcharm#25:
    arm64.movImm x1, 0
  __il_cont#4:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at a-function-named-gives-beside-the-arm-that-spells-it.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
