// Test: a-closure-with-a-block-keyword-parameter-inside-an-arm-body
typealias Idx = int(0 to 100)
typealias Step = function(Idx) returns Idx

enum Marker
	function
	other
end 'Marker'

function apply(f Step, x Idx) returns Idx
	return f(x)
end 'apply'

function classify(m Marker, seed Idx) returns Idx
	var total = match m 'm'
		function gives apply(function(if Idx) gives 33 + if, x: seed)
		other gives 0
	end 'm'

	var i = 0
	while i < 2 'bump'
		total = total + 1
		i = i + 1
	end 'bump'
	return total
end 'classify'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	return (classify(Marker.function, seed: 5) + pick(Victim.found(2))) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @classify$closure_0 {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.add x0, x0, 33
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at a-closure-with-a-block-keyword-parameter-inside-an-arm-body.test:16: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
  matcharm#13:
    arm64.leaFuncAddr x2, classify$closure_0
    arm64.movImm x1, 0
  __il_body#28:
    arm64.blr x2
  matchcont:
    arm64.movImm x1, 0
    arm64.b whilehdr
  bump:
    arm64.add x0, x0, 1
    arm64.add x1, x1, 1
  whilehdr:
    arm64.cmp x1, 2
    arm64.b.lt bump
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#25
  __rc_chk#26:
    arm64.cmp x0, 100
    arm64.b.gt __rc_panic#25
  __il_cont#11:
    arm64.movImm x1, 2
    arm64.movImm x2, 0
  __il_body#5:
    arm64.cmp x2, 0
    arm64.b.eq __il_cont#4
  matchnext:
    arm64.cmp x2, 1
    arm64.b.ne matchdead
  matcharm#7:
    arm64.movImm x1, 0
  __il_cont#4:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  __rc_panic#25:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-closure-with-a-block-keyword-parameter-inside-an-arm-body.test:25: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_5  ; "panic at a-closure-with-a-block-keyword-parameter-inside-an-arm-body.test:41: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
