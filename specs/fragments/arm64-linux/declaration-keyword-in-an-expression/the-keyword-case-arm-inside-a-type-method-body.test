  __il_cont#5:
    arm64.movImm x2, 20
    arm64.movImm x3, 0
  __il_body#17:
    arm64.cmp x3, 0
    arm64.b.eq __il_cont#4
  matchnext:
    arm64.cmp x3, 1
    arm64.b.ne matchdead
  matcharm:
    arm64.movImm x2, 0
  __il_cont#4:
    arm64.add x19, x1, x2
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
