  __rc_panic#15:
    arm64.leaRdata x0, __str_blob_1  ; "panic at the-keyword-case-arm-inside-a-type-method-body.test:21: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
