// Test: a-keyword-case-arm-with-a-parenthesized-value-keeps-the-next-top-level-binding
enum Marker
	function
	other
end 'Marker'

function classify(m Marker) returns Idx
	return match m 'm'
		function gives (1 + 1)
		other gives 3
	end 'm'
end 'classify'

let counter = 42

function main() returns ExitCode
	if classify(Marker.function) == 2 'ok'
		return counter as ExitCode
	end 'ok'
	return 1
end 'main'
typealias Idx = int(0 to 100)
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
