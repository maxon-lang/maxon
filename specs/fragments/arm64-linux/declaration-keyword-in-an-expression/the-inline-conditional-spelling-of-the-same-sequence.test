// Test: the-inline-conditional-spelling-of-the-same-sequence
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

function picked(flag bool) returns Marker
	return Marker.function if (flag) else Marker.other
end 'picked'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	if picked(true) == Marker.function 'ok'
		return pick(Victim.found(42))
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 42
    arm64.movImm x1, 0
  __il_body:
    arm64.cmp x1, 0
    arm64.b.eq __il_cont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm:
    arm64.movImm x0, 0
  __il_cont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
