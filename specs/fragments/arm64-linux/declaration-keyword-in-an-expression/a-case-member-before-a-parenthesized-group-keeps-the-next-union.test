// Test: a-case-member-before-a-parenthesized-group-keeps-the-next-union
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

function trips(m Marker, flag bool) returns bool
	if m == Marker.function and (flag or not flag) 'both'
		return true
	end 'both'
	return false
end 'trips'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	if trips(Marker.function, flag: true) 'ok'
		return pick(Victim.found(42))
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  both:
    arm64.movImm x0, 1
  __il_cont#3:
    arm64.cbz x0, ifcont
  ok:
    arm64.movImm x0, 42
    arm64.movImm x1, 0
  __il_body:
    arm64.cmp x1, 0
    arm64.b.eq __il_cont#11
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm:
    arm64.movImm x0, 0
  __il_cont#11:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
