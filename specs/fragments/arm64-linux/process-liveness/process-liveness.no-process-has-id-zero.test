// Test: process-liveness.no-process-has-id-zero
function main() returns ExitCode
	if __Builtins.processIsAlive(0) 'claimed'
		return 1
	end 'claimed'
	return 3
end 'main'
---
ExitCode: 3
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl __proc_alive
    arm64.cbz x0, ifcont
  claimed:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
