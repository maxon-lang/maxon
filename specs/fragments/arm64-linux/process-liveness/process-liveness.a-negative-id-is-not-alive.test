// Test: process-liveness.a-negative-id-is-not-alive
function main() returns ExitCode
	if __Builtins.processIsAlive(0 - 1) 'claimed'
		return 1
	end 'claimed'
	if __Builtins.processIsAlive(0 - __Builtins.currentProcessId()) 'mirrored'
		return 4
	end 'mirrored'
	return 3
end 'main'
---
ExitCode: 3
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 18446744073709551615
    arm64.bl __proc_alive
    arm64.cbz x0, ifcont#2
  claimed:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x19, 0
    arm64.bl __proc_pid
    arm64.sub x0, x19, x0
    arm64.bl __proc_alive
    arm64.cbz x0, ifcont#4
  mirrored:
    arm64.movImm x0, 4
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
