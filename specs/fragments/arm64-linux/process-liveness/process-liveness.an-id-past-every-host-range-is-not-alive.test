// Test: process-liveness.an-id-past-every-host-range-is-not-alive
function main() returns ExitCode
	if __Builtins.processIsAlive(4294967296 + __Builtins.currentProcessId()) 'claimed'
		return 1
	end 'claimed'
	return 3
end 'main'
---
ExitCode: 3
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 4294967296
    arm64.bl __proc_pid
    arm64.add x0, x19, x0
    arm64.bl __proc_alive
    arm64.cbz x0, ifcont
  claimed:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
