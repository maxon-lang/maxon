// Test: in-range-literal-is-unchanged
function code() returns ExitCode
  return 7
end 'code'

function main() returns ExitCode
  return code()
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 7
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
