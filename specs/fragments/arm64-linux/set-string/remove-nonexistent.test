// Test: remove-nonexistent
typealias StrSet = Set with String

function main() returns ExitCode
	var s = StrSet.create()
	s.insert("alice")
	let removed = s.remove("zzz")
	if removed 'ok'
		return 1
	end 'ok'
	return 0
end 'main'
