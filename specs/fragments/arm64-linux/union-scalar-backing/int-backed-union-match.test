// Test: int-backed-union-match
union Status
	ok = 200
	notFound = 404
	serverError = 500
end 'Status'

function classify(s Status) returns ExitCode
	return match s 'm'
		ok gives 0
		notFound gives 4
		serverError gives 5
	end 'm'
end 'classify'

function main() returns ExitCode
	return classify(Status.notFound)
end 'main'
---
ExitCode: 4
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 200
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x0, 404
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.movImm x0, 4
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 500
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movImm x0, 5
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-backed-union-match.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 404
    arm64.bl classify
    arm64.epilogue 16
    arm64.ret
}
