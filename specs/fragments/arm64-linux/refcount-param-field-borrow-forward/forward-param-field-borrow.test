    arm64.add x0, x0, 10
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.leaRdata x1, __layout_ArrayIterator_Tok
    arm64.bl ArrayIterator.current
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.bl ArrayIterator.advance
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
