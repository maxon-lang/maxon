// Test: rc-enum-name-from-function
enum Direction
	north
	south
	east
	west
end 'Direction'

function getName(d Direction) returns String
	return d.name
end 'getName'

function main() returns ExitCode
	let d = Direction.west
	let n = getName(d)
	if n == "west" 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @getName {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.leaRdata x2, __str_rec_4  ; "north"
    arm64.mul x1, x1, x2
    arm64.cmp x0, 1
    arm64.cset x2, eq
    arm64.leaRdata x3, __str_rec_5  ; "south"
    arm64.mul x2, x2, x3
    arm64.add x1, x1, x2
    arm64.cmp x0, 2
    arm64.cset x2, eq
    arm64.leaRdata x3, __str_rec_6  ; "east"
    arm64.mul x2, x2, x3
    arm64.add x1, x1, x2
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.leaRdata x2, __str_rec_7  ; "west"
    arm64.mul x0, x0, x2
    arm64.add x0, x1, x0
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.bl getName
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __str_rec_7  ; "west"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
