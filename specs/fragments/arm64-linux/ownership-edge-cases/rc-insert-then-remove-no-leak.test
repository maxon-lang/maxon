// Test: rc-insert-then-remove-no-leak
typealias Integer = int(i64.min to i64.max)

type Entry
	export var key as Integer

	static function create(key Integer) returns Self
		return Self{key: key}
	end 'create'
end 'Entry'

typealias EntryArray = Array with Entry

function main() returns ExitCode
	var arr = EntryArray.create()
	var i = 0
	while i < 5 'push'
		arr.push(Entry.create(i))
		i = i + 1
	end 'push'
	var total = 0
	while arr.count() > 0 'pop'
		let e = try arr.remove(0) otherwise 'err'
			return 99
		end 'err'
		total = total + e.key
	end 'pop'
	return total
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Entry.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  whilehdr#1:
    arm64.cmp x20, 5
    arm64.b.ge whileexit#3
  push:
    arm64.movRegReg x0, x20
    arm64.bl Entry.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x20, x20, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.movImm x20, 0
  whilehdr#4:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.le whileexit#6
  pop:
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_Array_Entry
    arm64.movRegReg x0, x19
    arm64.bl Array.remove
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x20, x20, x1
    arm64.bl __mm_decref
    arm64.b whilehdr#4
  whileexit#6:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rc-insert-then-remove-no-leak.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
