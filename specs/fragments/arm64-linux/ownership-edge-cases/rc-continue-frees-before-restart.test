// Test: rc-continue-frees-before-restart
typealias Integer = int(i64.min to i64.max)

type Item
	export var v as Integer

	static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'Item'

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 5 'loop'
		@heap let item = Item.create(i)
		i = i + 1
		if item.v == 2 'skip'
			continue
		end 'skip'
		total = total + item.v
	end 'loop'
	return total
end 'main'
---
ExitCode: 8
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  __il_body:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_cont:
    arm64.add x20, x20, 1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 2
    arm64.b.ne ifcont
  skip:
    arm64.bl __mm_decref
    arm64.b whilehdr
  ifcont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x19, x19, x1
    arm64.bl __mm_decref
  whilehdr:
    arm64.cmp x20, 5
    arm64.b.lt __il_body
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at rc-continue-frees-before-restart.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
