    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.bl StringIndex.create
    arm64.movRegReg x20, x0
  __il_cont#4:
    arm64.leaRdata x1, __str_rec_3  ; " "
    arm64.movRegReg x0, x19
    arm64.bl String.findFirst
    arm64.cmp x9, 0
    arm64.b.eq tryok
  __il_body#27:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
  __il_body#28:
    arm64.loadRegBaseDisp.byte x0, [x19 + 48]
  __il_cont#25:
    arm64.cbz x0, ifcont
  oneByteEach:
    arm64.movRegReg x0, x21
    arm64.b __il_body#24
  ifcont:
    arm64.movImm x22, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  countLoop:
    arm64.movRegReg x0, x19
    arm64.bl findGraphemeEnd
    arm64.add x22, x22, 1
    arm64.movRegReg x1, x0
  whilehdr:
    arm64.cmp x1, x21
    arm64.b.lt countLoop
  whileexit:
    arm64.cmp x22, 0
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x22
  __il_body#24:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
  __il_cont#23:
    arm64.bl StringIndex.create
