// Test: rc-global-struct-outlives-local
typealias Integer = int(i64.min to i64.max)

type Cfg
	export var level as Integer

	static function create(level Integer) returns Self
		return Self{level: level}
	end 'create'
end 'Cfg'

var globalCfg = Cfg.create(0)

function setup()
	globalCfg = Cfg.create(42)
end 'setup'

function main() returns ExitCode
	setup()
	return globalCfg.level
end 'main'
---
ExitCode: 42
---
data {
  __data_globalCfg@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#5:
    arm64.movImm x19, 42
  __il_body#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#6:
    arm64.leaGlobal x0, __data_globalCfg
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_decref
    arm64.leaGlobal x0, __data_globalCfg
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_cont#4:
    arm64.leaGlobal x0, __data_globalCfg
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at rc-global-struct-outlives-local.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
