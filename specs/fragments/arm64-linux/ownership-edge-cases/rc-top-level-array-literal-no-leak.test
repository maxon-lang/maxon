// Test: rc-top-level-array-literal-no-leak
var items = [10, 20, 30]

function main() returns ExitCode
	let a = try items.get(0) otherwise 0
	let b = try items.get(1) otherwise 0
	let c = try items.get(2) otherwise 0
	return a + b + c
end 'main'
---
ExitCode: 60
---
data {
  __data_items@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaGlobal x0, __data_items
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow#14
    arm64.b __im_load#15
  tryerr#2:
    arm64.movImm x0, 0
    arm64.b trycont#3
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont#3:
    arm64.leaGlobal x1, __data_items
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.movImm x2, 1
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.cmp x3, 1
    arm64.b.ls __im_slow#17
    arm64.b __im_load#18
  tryerr#5:
    arm64.movImm x1, 0
    arm64.b trycont#6
  __im_load#18:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 8
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont#6:
    arm64.leaGlobal x2, __data_items
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.movImm x3, 2
    arm64.loadRegBaseDisp.word64 x4, [x2 + 8]
    arm64.cmp x4, 2
    arm64.b.ls __im_slow#20
    arm64.b __im_load#21
  tryerr#8:
    arm64.movImm x2, 0
    arm64.b trycont#9
  __im_load#21:
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.add x2, x2, 16
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
  trycont#9:
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
  __im_slow#14:
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
    arm64.b trycont#3
  __im_slow#17:
    arm64.storeSlotReg slot0, x0
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#5
    arm64.b trycont#6
  __im_slow#20:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.movRegReg x0, x2
    arm64.movRegReg x1, x3
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.cmp x9, 0
    arm64.b.ne tryerr#8
    arm64.b trycont#9
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at rc-top-level-array-literal-no-leak.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}
