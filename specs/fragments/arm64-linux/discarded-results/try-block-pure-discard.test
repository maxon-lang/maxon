// Test: try-block-pure-discard

typealias Integer = int(i64.min to i64.max)

enum ParseError implements Error
	invalidFormat
end 'ParseError'

function parseNum(s String) returns Integer throws ParseError
	if s.byteLength() == 0 'empty'
		throw ParseError.invalidFormat
	end 'empty'
	return s.byteLength()
end 'parseNum'

function main() returns ExitCode
	try 'work'
		_ = parseNum("abc")
	end 'work' otherwise (e) 'h'
		match e 'why'
			invalidFormat then print("failed\n")
		end 'why'
	end 'h'

	return 0
end 'main'
---
CompilerError:
error E3064: <fragment>:18:3: result of pure function 'parseNum' must be used
