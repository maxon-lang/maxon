// Test: primitive-conformance.hashable-and-equatable
typealias Integer = int(0 to u32.max)

type Key uses T where T is Hashable and Equatable
	export var value as T
	export static function create(value T) returns Self
		return Self{ value: value }
	end 'create'
	export function digest() returns HashValue
		return self.value.hash()
	end 'digest'
	export function matches(other T) returns bool
		return self.value.equals(other)
	end 'matches'
end 'Key'

typealias IntKey = Key with Integer

function main() returns ExitCode
	let k = IntKey.create(7)
	if k.digest() != 7 'h'
		return 1
	end 'h'
	if not k.matches(7) 'e1'
		return 2
	end 'e1'
	if k.matches(9) 'e2'
		return 3
	end 'e2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Key.matches {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x3 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
    arm64.leaRdata x0, __witness_int.Hashable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_body#9:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#8:
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
  __il_cont#7:
    arm64.cmp x0, 7
    arm64.b.eq ifcont#2
  h:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x1, 7
    arm64.leaRdata x2, __witness_int.Hashable
    arm64.leaRdata x3, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl Key.matches
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont#4
  e1:
    arm64.movImm x19, 2
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x1, 9
    arm64.leaRdata x2, __witness_int.Hashable
    arm64.leaRdata x3, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl Key.matches
    arm64.cbz x0, ifcont#6
  e2:
    arm64.movImm x19, 3
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#6:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
