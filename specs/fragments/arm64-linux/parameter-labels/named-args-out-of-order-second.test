// Test: named-args-out-of-order-second
typealias Num = int(0 to 100)

function pick(a Num, b String, c bool) returns Num
	if c 'isTrue'
		return a
	end 'isTrue'
	return b.byteLength() as Num
end 'pick'

function main() returns ExitCode
	return pick(1, c: false, b: "abcde")
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#4
  __rc_chk#5:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_2  ; "panic at named-args-out-of-order-second.test:4: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#3:
    arm64.cbz x2, __il_body
  isTrue:
    arm64.epilogue 16
    arm64.ret
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.cmp x0, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x1
    arm64.bl String.byteLength
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#7
  __rc_chk#8:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#6
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_3  ; "panic at named-args-out-of-order-second.test:8: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#6:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x2, 0
    arm64.leaRdata x1, __str_rec_1  ; "abcde"
    arm64.bl pick
    arm64.epilogue 16
    arm64.ret
}
