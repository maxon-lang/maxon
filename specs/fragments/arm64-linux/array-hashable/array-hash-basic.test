// Test: array-hash-basic
function main() returns ExitCode
	let arr = [10, 20, 30]
	let h = arr.hash()
	if h != 0 'nonzero'
		return 1
	end 'nonzero'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 3
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.leaRdata x0, __witness_int.Hashable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __managed_element_size
    arm64.mul x20, x20, x0
    arm64.movImm x21, 5381
    arm64.movImm x22, 0
    arm64.b forhdr
  hash_loop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl __managed_byte_at
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  tryok:
    arm64.movImm x16, 33
    arm64.mul x1, x21, x16
    arm64.add x0, x1, x0
  forstep:
    arm64.add x22, x22, 1
    arm64.movRegReg x21, x0
  forhdr:
    arm64.cmp x22, x20
    arm64.b.lt hash_loop
  forexit:
    arm64.movImm x0, 4294967295
    arm64.and x0, x21, x0
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.eq ifcont
  nonzero:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_6  ; "panic at Array.maxon:736: Array.hash: byteAt OOB \xe2\x80\x94 i < byteLen invariant\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
