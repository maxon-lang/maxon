    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl Vector.createIterator
    arm64.movRegReg x21, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.eq forhdr
    arm64.b forjoin
  loop:
    arm64.leaRdata x22, __layout_ArrayIterator_int
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.bl __managed_cursor_current
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x22
    arm64.bl __retain_type_param
  __il_cont:
    arm64.add x20, x20, x0
  forstep:
    arm64.movRegReg x0, x21
    arm64.bl ArrayIterator.advance
    arm64.movRegReg x0, x9
  forhdr:
    arm64.cmp x0, 0
    arm64.b.eq loop
  forexit:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_ArrayIterator_int
  forjoin:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
