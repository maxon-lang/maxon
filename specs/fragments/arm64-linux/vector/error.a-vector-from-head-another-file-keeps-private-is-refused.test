typealias Pair = Vector with 2 ExitCode

export function probePair() returns ExitCode
	let v = Pair from [1, 2]
	print("{v.count()}")
	return 0
end 'probePair'

// --- file: main.maxon
function main() returns ExitCode
	let v = Pair from [3, 4]
	print("{v.count()}")
	return probePair()
end 'main'
