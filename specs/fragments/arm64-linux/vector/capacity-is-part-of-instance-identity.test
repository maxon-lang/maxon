// Test: capacity-is-part-of-instance-identity
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

type Holder uses Element
	typealias Slot = Vector with 4 Element

	var slot as Slot

	export static function create() returns Self
		return Self{slot: Slot.create()}
	end 'create'

	export function size() returns Int
		return slot.count()
	end 'size'
end 'Holder'

typealias IntHolder = Holder with Int

function main() returns ExitCode
	var v = Vec3.create()
	var h = IntHolder.create()
	return ((v.count() as Int) + h.size()) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __layout_Holder_Int
  __il_body#6:
    arm64.movImm x1, 4
    arm64.bl Vector.create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_cont#8:
    arm64.movImm x1, 3
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
  __il_cont#4:
    arm64.add x20, x1, 4
  __rc_ok:
    arm64.bl __destruct_Holder_Int
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
