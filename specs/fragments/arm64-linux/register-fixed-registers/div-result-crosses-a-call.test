// Test: div-result-crosses-a-call
function twice(x Integer) returns Integer
	return x + x
end 'twice'

function main() returns ExitCode
	let n = 1000
	let d = 7
	let q = n / d
	let t = twice(q)
	let r = q + t
	if r == 426 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1000
    arm64.movImm x1, 5270498306774157605
    arm64.smulh x0, x1, x0
    arm64.asr x0, x0, 1
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
  __il_body:
    arm64.add x1, x0, x0
  __il_cont:
    arm64.add x0, x0, x1
    arm64.cmp x0, 426
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
