// Test: comparable.ordering-reversed-operands
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function forwardLess() returns bool
		return self.a < self.b
	end 'forwardLess'
	export function reverseLess() returns bool
		return self.b < self.a
	end 'reverseLess'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let p = IntPair.create(3, b: 9)
	var r = 0 as Integer
	if p.forwardLess() 'f'
		r = r + 1
	end 'f'
	if p.reverseLess() 'g'
		r = r + 10
	end 'g'
	return r
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
    arm64.movImm x20, 9
    arm64.leaRdata x0, __witness_int.Comparable
  __il_cont#9:
    arm64.movImm x21, 0
    arm64.leaRdata x2, __witness_int.Comparable
  __il_body#11:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, eq
  __il_cont#8:
    arm64.cbz x0, ifcont
  f:
    arm64.add x21, x21, 1
  ifcont:
    arm64.leaRdata x2, __witness_int.Comparable
  __il_body#13:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, eq
  __il_cont#12:
    arm64.cbz x0, critsplit
  g:
    arm64.add x0, x21, 10
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x21
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
