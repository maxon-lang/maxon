// Test: byte-array-constant-identity
let A = b"hi"
let B = b"hi"
let C = b"ho"

function main() returns ExitCode
	var result = 0
	if A is A 'self'
		result = result + 1
	end 'self'
	if A is B 'sameBytes'
		result = result + 2
	end 'sameBytes'
	if A is not C 'otherBytes'
		result = result + 4
	end 'otherBytes'
	if A is not b"hi" 'inlineIsItsOwn'
		result = result + 8
	end 'inlineIsItsOwn'
	return result
end 'main'
---
ExitCode: 15
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.leaRdata x1, __barr_rec_2
    arm64.leaRdata x2, __barr_rec_2
    arm64.cmp x1, x2
    arm64.b.ne ifcont#2
  self:
    arm64.movImm x0, 1
  ifcont#2:
    arm64.leaRdata x1, __barr_rec_2
    arm64.leaRdata x2, __barr_rec_2
    arm64.cmp x1, x2
    arm64.b.ne ifcont#4
  sameBytes:
    arm64.add x0, x0, 2
  ifcont#4:
    arm64.leaRdata x1, __barr_rec_2
    arm64.leaRdata x2, __barr_rec_3
    arm64.cmp x1, x2
    arm64.b.eq critsplit#14
  otherBytes:
    arm64.add x19, x0, 4
    arm64.b ifcont#6
  critsplit#14:
    arm64.movRegReg x19, x0
  ifcont#6:
    arm64.leaRdata x20, __barr_rec_2
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 2
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x1, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 24], x1
    arm64.cmp x20, x0
    arm64.cset x20, ne
    arm64.bl __managed_decref
    arm64.cbz x20, critsplit#15
  inlineIsItsOwn:
    arm64.add x0, x19, 8
    arm64.b __rc_ok
  critsplit#15:
    arm64.movRegReg x0, x19
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
