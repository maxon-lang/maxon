// Test: shl-count-100
function main() returns ExitCode
	let a = 1
	let SHIFT = 100
	if a shl SHIFT != 0 'namedWrong'
		return 1
	end 'namedWrong'
	if a shl 100 != 0 'literalWrong'
		return 2
	end 'literalWrong'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
