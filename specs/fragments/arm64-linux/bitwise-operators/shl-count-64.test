// Test: shl-count-64
function main() returns ExitCode
	let a = 1
	if a shl 64 != 0 'wrong'
		return 1
	end 'wrong'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
