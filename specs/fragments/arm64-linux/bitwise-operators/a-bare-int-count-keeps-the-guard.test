// Test: a-bare-int-count-keeps-the-guard
function main() returns ExitCode
	var seen = 0
	for n in 68 upto 72 'each'
		if 7 shl n != 0 'shl'
			return 1
		end 'shl'
		if 1024 shr n != 0 'shr'
			return 2
		end 'shr'
		seen = seen + 1
	end 'each'

	if seen != 4 'iterations'
		return 3
	end 'iterations'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 68
  forhdr:
    arm64.cmp x1, 72
    arm64.b.ge forexit
  each:
    arm64.movImm x2, 7
    arm64.and x3, x1, -64
    arm64.neg x4, x3
    arm64.orr x3, x3, x4
    arm64.asr x3, x3, 63
    arm64.lslv x2, x2, x1
    arm64.mvn x4, x3
    arm64.and x2, x2, x4
    arm64.cmp x2, 0
    arm64.b.eq ifcont#6
  shl:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x2, 1024
    arm64.orr x3, x1, x3
    arm64.asrv x2, x2, x3
    arm64.cmp x2, 0
    arm64.b.eq ifcont#8
  shr:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.add x0, x0, 1
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 4
    arm64.b.eq ifcont#10
  iterations:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#10:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
