// Test: a-count-whose-alias-reaches-below-zero-keeps-the-guard
typealias Num = int(i64.min to i64.max)
typealias Word = bits(64)
typealias Small = int(-1 to 5)

function shlBy(value Num, n Small) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n Small) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n Small) returns Word
	return value shr n
end 'shrWordBy'

function below(step Num) returns Small
	return (-step) as Small
end 'below'

function main() returns ExitCode
	let negative = below(1)

	if shlBy(1, n: negative) != 0 'shl'
		return 1
	end 'shl'
	if shrBy(-4, n: negative) != -1 'shrSign'
		return 2
	end 'shrSign'
	if shrWordBy(u64.max, n: negative) != 0 'shrZeroFill'
		return 3
	end 'shrZeroFill'

	// The in-range end of the same alias, so the case cannot pass by refusing the whole type.
	if shlBy(1, n: below(-5)) != 32 'shlInRange'
		return 4
	end 'shlInRange'

	return 42
end 'main'
---
ExitCode: 1
---
func @shlBy {
  entry:
    arm64.prologue 16
    arm64.cmp x1, -1
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 5
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.cmp x1, 0
    arm64.b.ge shiftok
  shiftneg:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:7: negative shift count\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  shiftok:
    arm64.and x2, x1, -64
    arm64.neg x3, x2
    arm64.orr x2, x2, x3
    arm64.asr x2, x2, 63
    arm64.lslv x0, x0, x1
    arm64.mvn x1, x2
    arm64.and x0, x0, x1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:6: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x1, 18446744073709551615
  __il_cont:
    arm64.movImm x0, 1
    arm64.bl shlBy
    arm64.cmp x0, 0
    arm64.b.eq shiftneg
  shl:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  shiftneg:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:11: negative shift count\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
