// Test: var-target-declares-a-mutable-binding
typealias Integer = int(i64.min to i64.max)

function pair(n Integer) returns (Integer, Integer)
	return (n, n + 1)
end 'pair'

function main() returns ExitCode
	(let a, var b) = pair(5)
	b = b + 10
	return a + b
end 'main'
---
ExitCode: 21
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
  __il_body:
    arm64.movImm x1, 6
  __il_cont:
    arm64.add x1, x1, 10
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at var-target-declares-a-mutable-binding.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
