// Test: int-ten-vars-alive
function main() returns ExitCode
	let a = 1
	let b = 2
	let c = 3
	let d = 4
	let e = 5
	let f = 6
	let g = 7
	let h = 8
	let i = 9
	let j = 10
	return a + b + c + d + e + f + g + h + i + j
end 'main'
---
ExitCode: 55
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 55
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
