// Test: int-fibonacci
function main() returns ExitCode
	var a = 0
	var b = 1
	var i = 0
	while i < 13 'loop'
		let temp = a + b
		a = b
		b = temp
		i = i + 1
	end 'loop'
	return a and 125
end 'main'
---
ExitCode: 105
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.movImm x2, 0
    arm64.b whilehdr
  loop:
    arm64.add x0, x0, x1
    arm64.add x2, x2, 1
    arm64.xchgRegReg x0, x1
  whilehdr:
    arm64.cmp x2, 13
    arm64.b.lt loop
  whileexit:
    arm64.movImm x16, 125
    arm64.and x0, x0, x16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
