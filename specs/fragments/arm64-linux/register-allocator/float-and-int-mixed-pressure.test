// Test: float-and-int-mixed-pressure
function main() returns ExitCode
	let x = 3.14
	let y = 2.86
	let sum_f = x + y
	let a = 10
	let b = 20
	let sum_i = a + b
	return trunc(sum_f) + sum_i
end 'main'
---
ExitCode: 36
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 36
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
