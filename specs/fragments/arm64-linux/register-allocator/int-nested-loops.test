// Test: int-nested-loops
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 5 'outer'
		var j = 0
		while j < 4 'inner'
			total = total + 1
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return total
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  whilehdr#1:
    arm64.cmp x1, 5
    arm64.b.ge whileexit#3
  outer:
    arm64.movImm x2, 0
  whilehdr#4:
    arm64.cmp x2, 4
    arm64.b.ge whileexit#6
  inner:
    arm64.add x0, x0, 1
    arm64.add x2, x2, 1
    arm64.b whilehdr#4
  whileexit#6:
    arm64.add x1, x1, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-nested-loops.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
