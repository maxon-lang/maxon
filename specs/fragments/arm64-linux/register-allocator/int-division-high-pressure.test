// Test: int-division-high-pressure
function main() returns ExitCode
	let a = 10
	let b = 20
	let c = 30
	let d = 40
	let e = 50
	let f = 60
	let g = 70
	let h = 2
	return ((a + b + c + d + e + f + g) / h) and 125
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 280
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 280
    arm64.asr x0, x0, 1
    arm64.movImm x16, 125
    arm64.and x0, x0, x16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
