// Test: int-division-preserves-other-values
function main() returns ExitCode
	let x = 10
	let a = 84
	let b = 2
	let quotient = a / b
	return quotient - x
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 84
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 84
    arm64.asr x0, x0, 1
    arm64.sub x0, x0, 10
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
