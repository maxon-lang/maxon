// Test: phi-merge-split-multi-anchor
function main() returns ExitCode
	var a = 0
	var b = 0
	var c = 0
	var d = 0
	if 1 < 2 'g1'
		a = 1
		b = 2
		c = 3
		d = 4
	end 'g1' else 'g1e'
		a = 10
		b = 20
		c = 30
		d = 40
	end 'g1e'
	if a > 0 'g2'
		a = a + 100
		c = c + 100
	end 'g2' else 'g2e'
		b = b + 100
		d = d + 100
	end 'g2e'
	if b > 0 'g3'
		a = a + b
		c = c + d
	end 'g3' else 'g3e'
		b = a - 1
		d = c - 1
	end 'g3e'
	return (a + b + c + d) and 125
end 'main'
---
ExitCode: 88
---
func @main {
  entry:
    arm64.prologue 16
  g1:
    arm64.movImm x0, 1
    arm64.movImm x1, 3
  g2:
    arm64.add x0, x0, 100
    arm64.add x1, x1, 100
  g3:
    arm64.add x0, x0, 2
    arm64.add x1, x1, 4
  ifcont:
    arm64.add x0, x0, 2
    arm64.add x0, x0, x1
    arm64.add x0, x0, 4
    arm64.movImm x16, 125
    arm64.and x0, x0, x16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
