// Test: int-float-survives-call

typealias Integer = int(i64.min to i64.max)

function getInt() returns Integer
	return 40
end 'getInt'

function main() returns ExitCode
	let f = 3.14
	let x = getInt()
	return trunc(f) + x
end 'main'
---
ExitCode: 43
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont:
    arm64.movImm x0, 3
    arm64.add x0, x0, 40
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
