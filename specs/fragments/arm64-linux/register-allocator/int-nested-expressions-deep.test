// Test: int-nested-expressions-deep
function main() returns ExitCode
	return ((((1 + 2) * 3) + 4) * 2) + 6
end 'main'
---
ExitCode: 32
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 32
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
