// Test: contested-free-function-bare-call-means-its-own-directory
// --- file: alpha/a.maxon
typealias Integer = int(0 to 125)

public function pick() returns Integer
	return 3
end 'pick'

export function localCaller() returns Integer
	return pick()
end 'localCaller'

// --- file: beta/b.maxon
typealias Integer = int(0 to 125)

public function pick() returns Integer
	return 5
end 'pick'

export function localCaller() returns Integer
	return pick()
end 'localCaller'

// --- file: app/main.maxon
function main() returns ExitCode
	return (alpha.localCaller() * 10 + beta.localCaller()) as ExitCode
end 'main'
---
ExitCode: 35
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 3
  __il_cont#5:
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
  __il_cont#4:
    arm64.add x0, x0, 5
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
