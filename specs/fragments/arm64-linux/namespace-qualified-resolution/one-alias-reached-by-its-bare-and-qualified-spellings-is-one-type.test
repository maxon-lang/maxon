// Test: one-alias-reached-by-its-bare-and-qualified-spellings-is-one-type
// --- file: aaa/s.maxon
export typealias Small = int(0 to 1000)

export function bump(v Small) returns Small
	return v + 1
end 'bump'

// --- file: app/main.maxon
function main() returns ExitCode
	let x = 5 as aaa.Small
	return (aaa.bump(3) + x) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok#6:
    arm64.movImm x0, 4
  __il_cont:
    arm64.add x0, x0, 5
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
