// Test: a-qualified-enum-keeps-its-identity-where-the-files-own-alias-takes-its-name
// --- file: a/c.maxon
export enum Color
	red = 40
	blue = 41
end 'Color'

// --- file: app/main.maxon
typealias Color = int(0 to 10)

function main() returns ExitCode
	let local = 3 as Color
	let d = a.Color.red
	return (d.rawValue - 38 + local) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
}
