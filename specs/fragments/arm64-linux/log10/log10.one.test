// Test: log10.one
function main() returns ExitCode
	let result = Math.log10(1.0)
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  one:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
  __il_cont#5:
    arm64.fpLoadRdata d1, [rdata + __fconst_2.302585092994046]
    arm64.fdiv d0, d0, d1
  __il_cont#3:
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.ne ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
