// Test: a-dominating-block-supplies-the-value
typealias Word = int(i64.min to i64.max)

function pick(x Word, y Word) returns Word
	let base = x * 31 + y
	if y > 0 'positive'
		return base + x * 31 + y
	end 'positive' else 'negative'
		return base * 2 - (x * 31 + y)
	end 'negative'
end 'pick'

function main() returns ExitCode
	var seed = 0
	for i in 0 upto 4 'feed'
		seed = seed + pick(i, y: i - 2)
	end 'feed'
	if seed != 278 'wrongSum'
		return 1
	end 'wrongSum'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  forhdr:
    arm64.cmp x1, 4
    arm64.b.ge forexit
  feed:
    arm64.sub x2, x1, 2
  __il_body:
    arm64.movImm x16, 31
    arm64.mul x3, x1, x16
    arm64.add x4, x3, x2
    arm64.cmp x2, 0
    arm64.b.le ifelse
  positive:
    arm64.add x3, x4, x3
    arm64.add x2, x3, x2
    arm64.b __il_cont
  ifelse:
    arm64.lsl x2, x4, 1
    arm64.sub x2, x2, x4
  __il_cont:
    arm64.add x0, x0, x2
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 278
    arm64.b.eq ifcont
  wrongSum:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
