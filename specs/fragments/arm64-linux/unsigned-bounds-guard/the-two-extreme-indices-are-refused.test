    arm64.bl __managed_push
    arm64.movImm x1, 9223372036854775807
    arm64.movImm x2, 9223372036854775808
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x1, x0
    arm64.b.hs __im_slow#19
  __im_load#20:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, -8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  tryok#1:
    arm64.cmp x0, -5
    arm64.b.eq ifcont#5
  topGet:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#5:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x2, x0
    arm64.b.hs __im_slow#22
  __im_load#23:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  tryok#6:
    arm64.cmp x0, -5
    arm64.b.eq ifcont#10
  bottomGet:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#10:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x2
    arm64.bl __managed_remove
    arm64.cmp x9, 0
    arm64.b.ne ifcont#15
  tryok#11:
    arm64.cmp x0, -5
    arm64.b.eq ifcont#15
  bottomRemove:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#15:
