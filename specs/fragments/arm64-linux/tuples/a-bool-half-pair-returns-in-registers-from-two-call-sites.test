// Test: a-bool-half-pair-returns-in-registers-from-two-call-sites
typealias Num = int(0 to 1000)

function split(x Num) returns (Num, bool)
	if x == 0 'zero'
		return (0, false)
	end 'zero'

	return (x + 1, x > 500)
end 'split'

function main() returns ExitCode
	let a = split(10)
	let b = split(700)
	print("{a._0} {a._1} {b._0} {b._1}")
	return 0
end 'main'
