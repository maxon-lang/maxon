    arm64.movRegReg x0, x21
    arm64.bl StringBuilder.append
    arm64.leaRdata x1, __str_rec_3  ; "and then some"
    arm64.movRegReg x0, x21
    arm64.bl StringBuilder.append
  __il_body#13:
