  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.bl sleep
    arm64.leaGlobal x0, __data_order
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x0, x0, x19
    arm64.leaGlobal x1, __data_order
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @hog {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at async-sleep.coalesced-pass-fires-in-deadline-order.test:13: Range check failed: value outside typealias 'DurationNanos'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.bl Clock.nowNanos
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
  whilehdr:
    arm64.movRegReg x0, x20
    arm64.bl Clock.elapsedNanos
    arm64.cmp x0, x19
    arm64.b.ge whileexit
  spin:
    arm64.add x21, x21, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

