// Test: cross-file-shadowed-union-range
// --- file: spans.maxon
export union BigSpan
	condBr
	cmp
	call
	br
	ret
end 'BigSpan'

export union SpanOp
	condBr
	br
end 'SpanOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op SpanOp) returns Code
	return match op 'check'
		condBr or
			br gives 7
	end 'check'
end 'classify'

function describeBig(op BigSpan) returns Code
	return match op 'check'
		condBr or
			cmp or
			call or
			br or
			ret gives 3
	end 'check'
end 'describeBig'

function main() returns ExitCode
	let span = classify(SpanOp.br)
	let big = describeBig(BigSpan.call)
	if big == 3 'bigOk'
		return span
	end 'bigOk'
	return 99
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 7
  bigOk:
    arm64.epilogue 16
    arm64.ret
}
