// Test: enum-exhaustive.default-throws
enum Color
		red
		green
		blue
end 'Color'

enum AppError
		unmatched
end 'AppError'

typealias ColorCode = int(0 to 10)

function checkColor(c Color) returns ColorCode throws AppError
	match c 'check'
		red then return 1
		default throws AppError.unmatched
	end 'check'
end 'checkColor'

function main() returns ExitCode
	let result = try checkColor(Color.red) otherwise 'err'
		return 99
	end 'err'
	return result
end 'main'
---
ExitCode: 1
---
func @checkColor {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchdefault
  matcharm:
    arm64.movImm x0, 1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl checkColor
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.epilogue 16
    arm64.ret
}
