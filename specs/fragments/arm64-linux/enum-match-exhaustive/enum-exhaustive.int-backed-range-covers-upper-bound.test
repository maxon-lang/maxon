// Test: enum-exhaustive.int-backed-range-covers-upper-bound
enum Level
	low = 10
	medium = 20
	high = 30
end 'Level'

function classify(l Level) returns ExitCode
	let r = match l 'm'
		low or
			medium gives 41
		high gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Level.medium)
end 'main'
---
ExitCode: 41
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 41
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
