// Test: enum-exhaustive.trailing-fallthrough
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	var x = 0
	let c = Color.blue
	match c 'check'
		red then x = 1
		green then x = 2
		blue then x = 3 and fallthrough
	end 'check'
	return x
end 'main'
---
ExitCode: 3
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 3
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
