// Test: enum-exhaustive.int-backed-range-is-declaration-order-not-raw-order
enum Code
	ok = 500
	notFound = 200
	serverError = 404
end 'Code'

function classify(c Code) returns ExitCode
	let r = match c 'm'
		ok or
			notFound gives 41
		serverError gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Code.serverError)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 42
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
