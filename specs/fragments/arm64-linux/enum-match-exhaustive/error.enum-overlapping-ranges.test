// Test: error.enum-overlapping-ranges
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.high
	match p 'check'
		low to high then return 1
		medium to critical then return 2
	end 'check'
end 'main'
---
CompilerError:
error E2027: <fragment>:13:3: overlapping pattern in match: 'medium' is already covered
