// Test: enum-exhaustive.mix-explicit-and-range
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.low
	match p 'check'
		low then return 1
		medium to critical then return 2
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
