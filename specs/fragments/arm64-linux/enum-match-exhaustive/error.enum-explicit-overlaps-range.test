// Test: error.enum-explicit-overlaps-range
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	match c 'check'
		red or
			green or
			blue then return 1
		green then return 2
	end 'check'
end 'main'
---
CompilerError:
error E2027: <fragment>:14:3: overlapping pattern in match: 'green' is already covered
