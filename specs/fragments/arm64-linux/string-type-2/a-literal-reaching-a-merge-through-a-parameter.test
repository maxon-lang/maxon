    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_6  ; "ab"
    arm64.bl __str_clone
    arm64.movRegReg x19, x0
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.movRegReg x20, x0
  __il_body#9:
    arm64.leaRdata x21, __str_rec_4  ; "XY"
  __il_body#11:
    arm64.movRegReg x0, x21
    arm64.bl __str_bytes_view
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.bl __managed_append
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.loadRegBaseDisp.byte x0, [x21 + 48]
    arm64.eor x0, x0, 1
    arm64.cbz x0, __il_cont#8
  clearFlag:
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.byte [x20 + 48], x0
  __il_cont#8:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
  __il_cont#3:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.leaRdata x0, __str_rec_7  ; "done\x0a"
  __il_body#2:
    arm64.bl __write_stdout
  __il_cont#1:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
