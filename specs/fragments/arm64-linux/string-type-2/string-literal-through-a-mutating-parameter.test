  __il_body#4:
    arm64.leaRdata x20, __str_rec_3  ; "XY"
  __il_body#6:
    arm64.movRegReg x0, x20
    arm64.bl __str_bytes_view
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_append
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.loadRegBaseDisp.byte x0, [x20 + 48]
    arm64.eor x0, x0, 1
    arm64.cbz x0, __il_cont#3
  clearFlag:
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.byte [x19 + 48], x0
  __il_cont#3:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.leaRdata x0, __str_rec_5  ; "survived\x0a"
  __il_body#2:
    arm64.bl __write_stdout
  __il_cont#1:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
