// Test: inner-set-alias-create
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Plain
	typealias Nums = Set with ExitCode

	static function make() returns Count
		var s = Nums.create()
		s.insert(3)
		s.insert(3)
		return s.count()
	end 'make'
end 'Plain'

function main() returns ExitCode
	let c = Plain.make()
	if c == 1 'ok'
		return 8
	end 'ok'
	return 1
end 'main'
