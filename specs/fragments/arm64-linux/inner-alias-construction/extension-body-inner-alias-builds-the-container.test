// Test: extension-body-inner-alias-builds-the-container
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

interface Tagged
	function tag() returns ExitCode
end 'Tagged'

export extension Tagged
	typealias TagArray = Array with ExitCode

	export function tags() returns Count
		var result = TagArray{}
		result.push(self.tag())
		return result.count()
	end 'tags'
end 'Tagged'

type Box implements Tagged
	export var v as ExitCode

	export static function create() returns Self
		return Self{v: 2}
	end 'create'

	export function tag() returns ExitCode
		return self.v
	end 'tag'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	let c = b.tags()
	if c == 1 'ok'
		return 6
	end 'ok'
	return 1
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.tags {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 2
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.bl Box.tags
    arm64.cmp x0, 1
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 6
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 32
    arm64.ret
}
