// Test: cast-to-loaded-stdlib-internal-typealias
function main() returns ExitCode
	let n = 5 as Milliseconds
	return n as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
}
