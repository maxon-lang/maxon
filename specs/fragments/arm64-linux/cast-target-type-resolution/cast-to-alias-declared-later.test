// Test: cast-to-alias-declared-later
function main() returns ExitCode
	let n = 7 as Later
	return n
end 'main'

typealias Later = int(0 to 100)
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
