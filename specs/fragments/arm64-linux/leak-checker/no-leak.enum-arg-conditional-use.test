    arm64.movImm x19, 5
    arm64.movImm x20, 6
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.storeBaseDispReg.word64 [x0 + 16], x20
  branch:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x21 + 16]
    arm64.add x19, x1, x2
    arm64.b __il_cont#2
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#6:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x21 + 16]
    arm64.mul x19, x1, x2
  __il_cont#2:
    arm64.bl __mm_decref
