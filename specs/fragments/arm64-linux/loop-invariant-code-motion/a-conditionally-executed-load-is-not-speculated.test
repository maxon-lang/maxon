// Test: a-conditionally-executed-load-is-not-speculated
typealias Word = int(i64.min to i64.max)

type Cell
	export var value as Word

	export static function of(value Word) returns Cell
		return Self{value: value}
	end 'of'
end 'Cell'

function conditionalRead(c Cell, n Word) returns Word
	var t = 0
	var i = 0
	while i < n 'loop'
		if i == 3 'once'
			t = t + c.value
		end 'once'
		i = i + 1
	end 'loop'
	return t
end 'conditionalRead'

function main() returns ExitCode
	var trips = 0
	for _ in 0 upto 9 'feed'
		trips = trips + 1
	end 'feed'

	var c = Cell.of(9)
	if conditionalRead(c, n: trips) != 9 'readOnce'
		return 1
	end 'readOnce'
	if conditionalRead(c, n: 0) != 0 'noTrips'
		return 2
	end 'noTrips'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 0
    arm64.b forhdr
  feed:
    arm64.add x19, x19, 1
  forstep:
    arm64.add x0, x0, 1
  forhdr:
    arm64.cmp x0, 9
    arm64.b.lt feed
  forexit:
    arm64.movImm x20, 9
  __il_body#10:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_body#19:
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.b whilehdr
  loop:
    arm64.cmp x2, 3
    arm64.b.ne ifcont#24
  once:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.add x1, x1, x3
  ifcont#24:
    arm64.add x2, x2, 1
  whilehdr:
    arm64.cmp x2, x19
    arm64.b.lt loop
  __il_cont:
    arm64.cmp x1, 9
    arm64.b.eq ifcont#8
  readOnce:
    arm64.movImm x19, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#8:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
