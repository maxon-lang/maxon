// Test: escape-into-a-returned-closure
typealias Integer = int(i64.min to i64.max)
typealias Reader = function() returns Integer

type Item
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Item'

function churn(seed Integer) returns Integer
	let v0 = seed + 1
	let v1 = seed + 2
	let v2 = seed + 3
	let v3 = seed + 4
	let v4 = seed + 5
	let v5 = seed + 6
	let v6 = seed + 7
	let v7 = seed + 8
	let v8 = seed + 9
	let v9 = seed + 10
	let v10 = seed + 11
	let v11 = seed + 12
	let v12 = seed + 13
	let v13 = seed + 14
	let v14 = seed + 15
	let v15 = seed + 16
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15
end 'churn'

function makeReader(seed Integer) returns Reader
	let item = Item.create(seed)
	return function() gives item.value
end 'makeReader'

function main() returns ExitCode
	let read = makeReader(42)
	let noise = churn(1000)
	return read() as ExitCode if noise > 0 else 1
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @makeReader$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @makeReader$closure_0$drop {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __mm_decref
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 42
  __il_body#12:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#11:
    arm64.leaFuncAddr x1, makeReader$closure_0$drop
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaFuncAddr x0, makeReader$closure_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x20
  __il_cont#9:
    arm64.movImm x0, 1000
  __il_body#8:
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x3, x0, 3
    arm64.add x4, x0, 4
    arm64.add x5, x0, 5
    arm64.add x6, x0, 6
    arm64.add x7, x0, 7
    arm64.add x8, x0, 8
    arm64.add x9, x0, 9
    arm64.add x10, x0, 10
    arm64.add x11, x0, 11
    arm64.add x12, x0, 12
    arm64.add x13, x0, 13
    arm64.add x14, x0, 14
    arm64.add x20, x0, 15
    arm64.add x0, x0, 16
    arm64.add x1, x1, x2
    arm64.add x1, x1, x3
    arm64.add x1, x1, x4
    arm64.add x1, x1, x5
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
    arm64.add x1, x1, x9
    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x1, x1, x12
    arm64.add x1, x1, x13
    arm64.add x1, x1, x14
    arm64.add x1, x1, x20
    arm64.add x0, x1, x0
  ternarytrue:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.blr x1
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
