// Test: bare-call-resolves-free-fn-over-different-arity-method
// --- file: lib/free.maxon
typealias Code = int(0 to 125)

export function store(base Code, offset Code, scale Code) returns Code
	return base + offset + scale
end 'store'

// --- file: lib/cache.maxon
typealias Code = int(0 to 125)

export type Cache
	export var last as Code

	export static function make() returns Cache
		return Cache{last: 0}
	end 'make'

	export function store(key Code)
		self.last = key
	end 'store'
end 'Cache'

// --- file: app/main.maxon
function main() returns ExitCode
	let viaFree = store(2, offset: 3, scale: 4)
	var c = Cache.make()
	c.store(99)
	return viaFree
end 'main'
---
ExitCode: 9
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __rc_ok#11:
    arm64.movImm x19, 9
  __il_body:
    arm64.movImm x20, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
  __il_cont#2:
    arm64.movImm x1, 99
  __rc_ok#19:
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
  __il_cont#1:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
