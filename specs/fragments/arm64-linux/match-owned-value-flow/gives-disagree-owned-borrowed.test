// Test: gives-disagree-owned-borrowed
enum C
	first
	second
end 'C'

function main() returns ExitCode
	let c = C.second
	let out = match c 'check'
		first gives "interpolated arm {1} padded to heap"
		second gives "a plain literal give also long enough"
	end 'check'
	print(out)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  matcharm:
    arm64.leaRdata x0, __str_rec_5  ; "a plain literal give also long enough"
    arm64.bl __str_retain
    arm64.movRegReg x19, x0
  __il_body:
    arm64.movRegReg x0, x19
    arm64.bl __write_stdout
  __il_cont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
