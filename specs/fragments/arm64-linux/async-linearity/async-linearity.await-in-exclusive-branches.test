// Test: async-linearity.await-in-exclusive-branches
function makeValue() returns Integer
	Scheduler.yield()
	return 21
end 'makeValue'

function no() returns bool
	return false
end 'no'

function main() returns ExitCode
	let p = async makeValue()
	if no() 'branch'
		let a = await p
		return a as ExitCode
	end 'branch'
	let b = await p
	return (b + 1) as ExitCode
end 'main'
