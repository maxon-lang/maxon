// Test: default-values.string-default-with-escape
function show(msg String = "line1\nline2") returns ExitCode
	print(msg)
	return 0
end 'show'

function main() returns ExitCode
	return show()
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @show {
  entry:
    arm64.prologue 16
    arm64.bl print
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl __paramDefault#show#0
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl show
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @__paramDefault#show#0 {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "line1\x0aline2"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}
