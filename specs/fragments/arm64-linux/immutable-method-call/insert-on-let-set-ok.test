// Test: insert-on-let-set-ok
typealias Integer = int(i64.min to i64.max)
typealias IntSet = Set with Integer

function main() returns ExitCode
	let s = IntSet.create()
	s.insert(1)
	return s.count() as ExitCode
end 'main'
