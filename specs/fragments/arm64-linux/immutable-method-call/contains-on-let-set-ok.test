// Test: contains-on-let-set-ok
typealias Integer = int(i64.min to i64.max)
typealias IntSet = Set with Integer

function main() returns ExitCode
	let s = IntSet.create()
	let has = s.contains(1)
	if has 'h'
		return 1
	end 'h'
	return s.count() as ExitCode
end 'main'
