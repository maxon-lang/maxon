func @step {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.b.ne ifcont
  leaf:
    arm64.movImm x16, 31
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 7
    arm64.movImm x1, 9671377542784405045
    arm64.smulh x1, x1, x0
    arm64.add x1, x1, x0
    arm64.asr x1, x1, 19
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x16, 1000003
    arm64.mul x1, x1, x16
    arm64.sub x0, x0, x1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 17
    arm64.mul x0, x0, x16
    arm64.add x0, x0, x1
    arm64.movImm x2, 9671377542784405045
    arm64.smulh x2, x2, x0
    arm64.add x2, x2, x0
    arm64.asr x2, x2, 19
    arm64.lsr x3, x2, 63
    arm64.add x2, x2, x3
    arm64.movImm x16, 1000003
    arm64.mul x2, x2, x16
    arm64.sub x0, x0, x2
    arm64.sub x1, x1, 1
    arm64.bl step
    arm64.epilogue 16
    arm64.ret
}

