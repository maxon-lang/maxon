    arm64.bl sleep
    arm64.movImm x0, 1
    arm64.leaGlobal x1, __data_phase
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.bl Clock.nowMs
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b whilehdr#1
  spin:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.b whilehdr#4
  burst:
    arm64.movImm x1, 4
    arm64.bl step
    arm64.add x21, x21, 1
  whilehdr#4:
    arm64.cmp x21, 1000
    arm64.b.lt burst
  whileexit#6:
    arm64.movRegReg x20, x0
  whilehdr#1:
    arm64.movRegReg x0, x19
    arm64.bl Clock.elapsedMs
    arm64.cmp x0, 150
    arm64.b.lt spin
  whileexit#3:
    arm64.movImm x0, 2
    arm64.leaGlobal x1, __data_phase
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.asr x0, x20, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x20, x0
    arm64.asr x0, x0, 1
    arm64.lsl x0, x0, 1
    arm64.sub x0, x20, x0
    arm64.add x0, x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

