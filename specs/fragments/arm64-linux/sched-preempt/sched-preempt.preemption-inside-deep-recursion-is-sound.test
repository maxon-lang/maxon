func @down {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne ifcont
  bottom:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x2, x0, 1
    arm64.movImm x16, 31
    arm64.mul x1, x1, x16
    arm64.add x0, x1, x0
    arm64.movImm x1, 9671377542784405045
    arm64.smulh x1, x1, x0
    arm64.add x1, x1, x0
    arm64.asr x1, x1, 19
    arm64.lsr x3, x1, 63
    arm64.add x1, x1, x3
    arm64.movImm x16, 1000003
    arm64.mul x1, x1, x16
    arm64.sub x1, x0, x1
    arm64.movRegReg x0, x2
    arm64.bl down
    arm64.epilogue 16
    arm64.ret
}

