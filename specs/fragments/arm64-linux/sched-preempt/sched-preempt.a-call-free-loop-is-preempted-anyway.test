    arm64.add x1, x0, x1
    arm64.asr x1, x1, 1
    arm64.lsl x1, x1, 1
    arm64.sub x0, x0, x1
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

