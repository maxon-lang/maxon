    arm64.add x0, x0, x2
    arm64.movImm x3, 9671377542784405045
    arm64.smulh x3, x3, x0
    arm64.add x3, x3, x0
    arm64.asr x3, x3, 19
    arm64.lsr x4, x3, 63
    arm64.add x3, x3, x4
    arm64.movImm x16, 1000003
    arm64.mul x3, x3, x16
    arm64.sub x0, x0, x3
    arm64.add x2, x2, 1
  whilehdr:
    arm64.cmp x2, x1
    arm64.b.lt spin
  whileexit:
