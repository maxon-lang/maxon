// Test: extension-declared-before-the-type-it-extends
typealias Num = int(i64.min to i64.max)

extension Pair where A is Comparable
	export function firstIsVia(x A) returns bool
		return self.firstIs(x)
	end 'firstIsVia'
end 'Pair'

type Pair uses A, B where A is Equatable, B is Equatable
	export var first as A
	export var second as B
	export static function create(a A, b B) returns Self
		return Self{first: a, second: b}
	end 'create'
	export function firstIs(x A) returns bool
		return self.first == x
	end 'firstIs'
end 'Pair'

typealias NumPair = Pair with (Num, Num)

function main() returns ExitCode
	let p = NumPair.create(1, b: 2)
	if p.firstIs(1) 'a'
		print("a=true\n")
	end 'a'
	if p.firstIsVia(1) 'c'
		print("via=true\n")
	end 'c'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Pair.firstIs {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 2
    arm64.leaRdata x0, __witness_int.Equatable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_body#6:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
  __il_cont#5:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.leaRdata x3, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Pair.firstIs
    arm64.cbz x0, ifcont#2
  a:
    arm64.leaRdata x0, __str_rec_3  ; "a=true\x0a"
    arm64.bl print
  ifcont#2:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.leaRdata x3, __witness_int.Equatable
    arm64.leaRdata x0, __witness_int.Comparable
  __il_body#8:
    arm64.movRegReg x0, x21
    arm64.bl Pair.firstIs
  __il_cont#7:
    arm64.cbz x0, ifcont#4
  c:
    arm64.leaRdata x0, __str_rec_4  ; "via=true\x0a"
    arm64.bl print
  ifcont#4:
    arm64.leaRdata x0, __str_rec_5  ; "done\x0a"
    arm64.bl print
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
