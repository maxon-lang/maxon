// Test: unconditional-extension-body-that-dispatches-no-witness
typealias Num = int(i64.min to i64.max)

type Pair uses A, B where A is Equatable, B is Equatable
	export var first as A
	export var second as B
	export static function create(a A, b B) returns Self
		return Self{first: a, second: b}
	end 'create'
	export function firstIs(x A) returns bool
		return self.first == x
	end 'firstIs'
end 'Pair'

extension Pair
	export function firstCopy() returns A
		return self.first
	end 'firstCopy'
end 'Pair'

typealias NumPair = Pair with (Num, Num)

function main() returns ExitCode
	let p = NumPair.create(1, b: 2)
	if p.firstIs(1) 'a'
		print("a=true\n")
	end 'a'
	if p.firstCopy() == 1 'c'
		print("copy=true\n")
	end 'c'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.leaRdata x0, __witness_int.Equatable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_cont#6:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.leaRdata x0, __witness_int.Equatable
  __il_body#8:
    arm64.movRegReg x0, x19
    arm64.loadRegBaseDisp.word64 x16, [x2 + 40]
    arm64.blr x16
  __il_cont#5:
    arm64.cbz x0, ifcont#2
  a:
    arm64.leaRdata x0, __str_rec_3  ; "a=true\x0a"
    arm64.bl print
  ifcont#2:
    arm64.leaRdata x0, __layout_Pair_Num_Num
    arm64.leaRdata x1, __witness_int.Equatable
    arm64.leaRdata x1, __witness_int.Equatable
  __il_body#10:
    arm64.movRegReg x1, x19
    arm64.bl __retain_type_param
  __il_cont#9:
    arm64.cmp x0, 1
    arm64.b.ne ifcont#4
  c:
    arm64.leaRdata x0, __str_rec_4  ; "copy=true\x0a"
    arm64.bl print
  ifcont#4:
    arm64.leaRdata x0, __str_rec_5  ; "done\x0a"
    arm64.bl print
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
