// Test: dispatch.upto-exclusive-boundary
function classify(x Integer) returns Integer
	return match x 'm'
		10 upto 20 gives 1
		20 upto 30 gives 2
		30 gives 3
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `upto` excludes its upper: 10..20 covers 10..19, 20..30 covers 20..29, and 30 is its own arm.
	var n = 0 as ExitCode
	if classify(19) == 1 'a'
		n = n + 1
	end 'a'
	if classify(20) == 2 'b'
		n = n + 1
	end 'b'
	if classify(29) == 2 'c'
		n = n + 1
	end 'c'
	if classify(30) == 3 'd'
		n = n + 1
	end 'd'
	if classify(9) == 0 'e'
		n = n + 1
	end 'e'
	return n
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  matcharm#16:
    arm64.movImm x1, 1
  __il_cont#14:
    arm64.cmp x1, 1
    arm64.b.ne matcharm#26
  a:
    arm64.movImm x0, 1
  matcharm#26:
    arm64.movImm x1, 2
  __il_cont#23:
    arm64.cmp x1, 2
    arm64.b.ne matcharm#35
  b:
    arm64.add x0, x0, 1
  matcharm#35:
    arm64.movImm x1, 2
  __il_cont#32:
    arm64.cmp x1, 2
    arm64.b.ne matcharm#45
  c:
    arm64.add x0, x0, 1
  matcharm#45:
    arm64.movImm x1, 3
  __il_cont#41:
    arm64.cmp x1, 3
    arm64.b.ne matchdefault
  d:
    arm64.add x0, x0, 1
  matchdefault:
    arm64.movImm x1, 0
  __il_cont#50:
    arm64.cmp x1, 0
    arm64.b.ne ifcont
  e:
    arm64.add x0, x0, 1
  ifcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at dispatch.upto-exclusive-boundary.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
