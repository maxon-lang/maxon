// Test: dispatch.upto-exclusive-boundary
function classify(x Integer) returns Integer
	return match x 'm'
		10 upto 20 gives 1
		20 upto 30 gives 2
		30 gives 3
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `upto` excludes its upper: 10..20 covers 10..19, 20..30 covers 20..29, and 30 is its own arm.
	var n = 0 as ExitCode
	if classify(19) == 1 'a'
		n = n + 1
	end 'a'
	if classify(20) == 2 'b'
		n = n + 1
	end 'b'
	if classify(29) == 2 'c'
		n = n + 1
	end 'c'
	if classify(30) == 3 'd'
		n = n + 1
	end 'd'
	if classify(9) == 0 'e'
		n = n + 1
	end 'e'
	return n
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
  a:
    arm64.movImm x0, 1
  b:
    arm64.add x0, x0, 1
  c:
    arm64.add x0, x0, 1
  d:
    arm64.add x0, x0, 1
  e:
    arm64.add x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
