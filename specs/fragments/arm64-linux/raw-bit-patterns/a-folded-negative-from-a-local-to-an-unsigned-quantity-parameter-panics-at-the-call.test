// Test: a-folded-negative-from-a-local-to-an-unsigned-quantity-parameter-panics-at-the-call
typealias Count = int(0 to u64.max)

function show(c Count) returns Count
	return c
end 'show'

function main() returns ExitCode
	let d = 2
	print("{show(d - 3)}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-folded-negative-from-a-local-to-an-unsigned-quantity-parameter-panics-at-the-call.test:10: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
