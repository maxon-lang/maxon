// Test: a-signed-counter-through-a-function-value-to-an-unsigned-quantity-parameter-panics
typealias Count = int(0 to u64.max)

function show(c Count) returns Count
	return c
end 'show'

function main() returns ExitCode
	let f = show

	for i in -2 upto 1 'each'
		print("{f(i)}\n")
	end 'each'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_state@16 = i64 0
  __mrt_program_started@24 = i8 0
}

func @show {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-signed-counter-through-a-function-value-to-an-unsigned-quantity-parameter-panics.test:4: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __fnrec_show
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-signed-counter-through-a-function-value-to-an-unsigned-quantity-parameter-panics.test:4: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
