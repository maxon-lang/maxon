// Test: a-whole-word-pattern-into-a-signed-nonnegative-alias-panics
typealias Word = bits(64)
typealias Small = int(0 to i64.max)
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
	return n
end 'opaque'

function main() returns ExitCode
	let w = (opaque(0) - 1) as Word
	print("{w as Small}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-whole-word-pattern-into-a-signed-nonnegative-alias-panics.test:12: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
