// Test: a-signed-counter-argument-to-an-unsigned-quantity-parameter-panics
typealias Count = int(0 to u64.max)

function show(c Count) returns Count
	return c
end 'show'

function main() returns ExitCode
	for i in -2 upto 1 'each'
		print("{show(i)}\n")
	end 'each'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-signed-counter-argument-to-an-unsigned-quantity-parameter-panics.test:10: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
