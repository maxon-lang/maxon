// Test: error.an-undeclared-argument-is-reported-once
function larger(a T, b T) uses T returns T where T is Comparable
	if a > b 'first'
		return a
	end 'first'

	return b
end 'larger'

function main() returns ExitCode
	print("{larger(nope(), b: 5)}\n")
	return 0
end 'main'
