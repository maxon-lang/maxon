// Test: error.all-discard-two-payloads
typealias Integer = int(i64.min to i64.max)

union Container
	empty
	two(a Integer, b Integer)
end 'Container'

function main() returns ExitCode
	let c = Container.two(1, b: 2)
	match c 'check'
		empty then return 1
		two(_, _) then return 0
	end 'check'
end 'main'
---
CompilerError:
error E3081: <fragment>:13:3: use 'two' instead of 'two(_, _)' to ignore associated values
