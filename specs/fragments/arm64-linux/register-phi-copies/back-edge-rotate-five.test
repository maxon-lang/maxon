// Test: back-edge-rotate-five
function rotate5(p Integer) returns Integer
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var d = p + 4
	var e = p + 5
	var i = 0
	while i < 3 'loop'
		let t = a
		a = b
		b = c
		c = d
		d = e
		e = t
		i = i + 1
	end 'loop'
	return a * 10000 + b * 1000 + c * 100 + d * 10 + e
end 'rotate5'

function main() returns ExitCode
	let r = rotate5(0)
	if r == 45123 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x3, 4
    arm64.movImm x4, 5
    arm64.movImm x5, 0
    arm64.b whilehdr
  loop:
    arm64.add x5, x5, 1
    arm64.xchgRegReg x0, x1
    arm64.xchgRegReg x1, x2
    arm64.xchgRegReg x2, x3
    arm64.xchgRegReg x3, x4
  whilehdr:
    arm64.cmp x5, 3
    arm64.b.lt loop
  whileexit:
    arm64.movImm x16, 10000
    arm64.mul x0, x0, x16
    arm64.movImm x16, 1000
    arm64.mul x1, x1, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 100
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 10
    arm64.mul x1, x3, x16
    arm64.add x0, x0, x1
    arm64.add x0, x0, x4
  __il_cont:
    arm64.movImm x16, 45123
    arm64.cmp x0, x16
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
