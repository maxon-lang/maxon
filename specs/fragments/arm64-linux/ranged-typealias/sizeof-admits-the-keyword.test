// Test: sizeof-admits-the-keyword
function main() returns ExitCode
	return (sizeof(int) + sizeof(float)) as ExitCode
end 'main'
---
ExitCode: 16
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
