// Test: int-division-truncates
function main() returns ExitCode
	let a = 7
	let b = 2
	return a / b
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 7
    arm64.asr x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
