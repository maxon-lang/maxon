// Test: array-element-runtime-panic
typealias Wide = int(0 to 1000)
typealias Percent = int(0 to 100)
typealias PA = Array with Percent

function grow(n Wide) returns Wide
	return n * 101
end 'grow'

function main() returns ExitCode
	var a = PA.create()
	a.push(grow(5))
	return a.count()
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at array-element-runtime-panic.test:12: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
