// Test: type-parameter-argument-runtime-panic
typealias Wide = int(0 to 1000)
typealias Percent = int(0 to 100)

type Box uses T
	export var v as T

	static function create(seed T) returns Self
		return Self{v: seed}
	end 'create'

	export function put(value T)
		self.v = value
	end 'put'
end 'Box'

typealias PB = Box with Percent

function grow(n Wide) returns Wide
	return n * 101
end 'grow'

function main() returns ExitCode
	var b = PB.create(1)
	b.put(grow(5))
	return b.v
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 1
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __rc_ok:
    arm64.movImm x0, 505
  __il_cont#4:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __il_body
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at type-parameter-argument-runtime-panic.test:25: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __il_body:
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_cont#11:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.epilogue 32
    arm64.ret
}
