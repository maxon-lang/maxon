// Test: unsigned-max-upper-literal-in-range
typealias Big = int(5 to u64.max)

function main() returns ExitCode
	let x = u64.max as Big
	if x == u64.max 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
