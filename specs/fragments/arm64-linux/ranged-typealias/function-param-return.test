// Test: function-param-return
typealias Score = int(0 to 100)

function double(s Score) returns Score
	return s * 2
end 'double'

function main() returns ExitCode
	return double(21)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 42
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
