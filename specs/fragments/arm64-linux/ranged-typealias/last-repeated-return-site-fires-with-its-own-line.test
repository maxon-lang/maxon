// Test: last-repeated-return-site-fires-with-its-own-line
typealias Narrow = int(10 to 100)
typealias Wide = int(0 to 100000)

function pick(n Wide) returns Narrow
	if n > 1000 'high'
		return n
	end 'high'

	if n > 100 'mid'
		return n
	end 'mid'

	return n
end 'pick'

function main() returns ExitCode
	print("first={pick(7)}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "first="
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __rc_panic:
    arm64.leaRdata x0, __str_blob_8  ; "panic at last-repeated-return-site-fires-with-its-own-line.test:14: Range check failed: value outside typealias 'Narrow'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
