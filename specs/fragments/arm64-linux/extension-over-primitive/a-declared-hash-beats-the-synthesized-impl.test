// Test: a-declared-hash-beats-the-synthesized-impl
extension int implements Hashable
	export function hash() returns HashValue
		return 77
	end 'hash'
end 'int'

function main() returns ExitCode
	let n = 5
	return n.hash()
end 'main'
---
ExitCode: 77
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 77
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
