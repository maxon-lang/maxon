// Test: self-in-return-position-on-a-primitive-extension
extension int
	export function twin() returns Self
		return self + 1
	end 'twin'
end 'int'

function main() returns ExitCode
	let n = 40
	return n.twin().twin() as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
