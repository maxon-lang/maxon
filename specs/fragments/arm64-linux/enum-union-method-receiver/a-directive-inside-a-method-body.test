// Test: a-directive-inside-a-method-body
enum Plat
	alpha

	export function tag() returns Integer
#if testing(true)
		return 3
#else
		return 7
#endif
	end 'tag'

	omega
end 'Plat'

function main() returns ExitCode
	let p = Plat.omega
	match p 'k'
		alpha then return 1
		omega then return p.tag() as ExitCode
	end 'k'
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
