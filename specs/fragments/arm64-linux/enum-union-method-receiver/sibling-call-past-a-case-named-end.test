// Test: sibling-call-past-a-case-named-end
enum Sib
	alpha
	end
	omega

	export function outer() returns Integer
		return inner() + 1
	end 'outer'

	export function inner() returns Integer
		return 6
	end 'inner'
end 'Sib'

function main() returns ExitCode
	let a = Sib.alpha
	return a.outer() as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 6
  __il_cont:
    arm64.add x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
