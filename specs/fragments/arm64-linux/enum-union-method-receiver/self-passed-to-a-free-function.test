// Test: self-passed-to-a-free-function
union Outcome
	pass
	fail(reason String)

	export function viaHelper() returns bool
		return helper(self)
	end 'viaHelper'
end 'Outcome'

function helper(o Outcome) returns bool
	return match o 'p'
		pass gives true
		fail gives false
	end 'p'
end 'helper'

function main() returns ExitCode
	let o = Outcome.fail("yet another long heap allocated reason string for the probe")
	if o.viaHelper() 'y'
		return 1
	end 'y'
	return 7
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Outcome.viaHelper {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#3:
    arm64.movImm x0, 1
    arm64.b __il_cont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#4:
    arm64.movImm x0, 0
  __il_cont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "yet another long heap allocated reason string for the probe"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl Outcome.viaHelper
    arm64.cbz x0, ifcont
  y:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outcome
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 7
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outcome
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
