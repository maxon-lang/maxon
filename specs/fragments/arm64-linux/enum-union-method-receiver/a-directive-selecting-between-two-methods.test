// Test: a-directive-selecting-between-two-methods
enum Plat
	alpha

#if testing(true)
	function tag() returns Integer
		return 3
	end 'tag'
#else
	function tag() returns Integer
		return 7
	end 'tag'
#endif

	omega
end 'Plat'

function main() returns ExitCode
	let p = Plat.omega
	match p 'k'
		alpha then return 1
		omega then return p.tag() as ExitCode
	end 'k'
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
