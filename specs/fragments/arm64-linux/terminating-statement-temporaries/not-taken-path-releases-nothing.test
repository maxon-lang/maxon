// Test: not-taken-path-releases-nothing
typealias Integer = int(i64.min to i64.max)

function check(n Integer) returns Integer
	if n > 0 'hot'
		panic("value is {n}")
	end 'hot'
	return 7
end 'check'

function main() returns ExitCode
	let a = check(-1)
	let b = check(-2)
	return (a + b) - 14
end 'main'
