    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 5
    arm64.bl Alpha.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_Box_Alpha
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Box.echo
    arm64.bl Wrap.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
