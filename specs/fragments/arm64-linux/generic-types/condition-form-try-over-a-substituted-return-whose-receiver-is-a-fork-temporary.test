// Test: condition-form-try-over-a-substituted-return-whose-receiver-is-a-fork-temporary
typealias Integer = int(0 to 125)
enum Boom implements Error
	bad
end 'Boom'
type Alpha
	export var a as Integer
	export static function create(v Integer) returns Self
		return Self{a: v}
	end 'create'
end 'Alpha'
type Box uses T
	export var value as T
	export var fail as bool
	export static function create(v T, f bool) returns Self
		return Self{value: v, fail: f}
	end 'create'
	export function fetch() returns T throws Boom
		if self.fail 'boom'
			throw Boom.bad
		end 'boom'
		return self.value
	end 'fetch'
end 'Box'
typealias AlphaBox = Box with Alpha
function make(f bool) returns AlphaBox
	return AlphaBox.create(Alpha.create(11), f: f)
end 'make'
function forkTemp(f bool) returns Integer
	if let got = try make(f).fetch() 'ok'
		return got.a
	end 'ok' else 'bad'
		return 1
	end 'bad'
end 'forkTemp'
function main() returns ExitCode
	print("ok={forkTemp(false)} err={forkTemp(true)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Box.fetch {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.byte x2, [x0 + 8]
    arm64.cbz x2, ifcont
  boom:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @forkTemp {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
  __il_body#5:
    arm64.movImm x20, 11
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
  __il_cont#7:
    arm64.movRegReg x0, x21
    arm64.bl __mm_own
    arm64.movRegReg x20, x0
  __il_body#12:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.storeBaseDispReg.word64 [x22 + 0], x20
    arm64.storeBaseDispReg.byte [x22 + 8], x19
  __il_cont#6:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
  __il_cont#4:
    arm64.leaRdata x1, __layout_Box_Alpha
    arm64.movRegReg x0, x22
    arm64.bl Box.fetch
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne ifelse
  ok:
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Box_Alpha
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifelse:
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Box_Alpha
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 128
