// Test: clock.now-unix-nanos-has-sub-second-resolution
function main() returns ExitCode
	for _ in 0 upto 1000 'eachReading'
		let nanos = WallClock.nowUnixNanos()

		if nanos mod 1_000_000 != 0 'subMillisecond'
			print("ok\n")
			return 0
		end 'subMillisecond'
	end 'eachReading'

	print("every reading was a whole millisecond\n")
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.b forhdr
  __il_body:
    arm64.bl __clock_now_unix_ns
  __il_cont:
    arm64.movImm x1, 4835703278458516699
    arm64.smulh x1, x1, x0
    arm64.asr x1, x1, 18
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x16, 1000000
    arm64.mul x1, x1, x16
    arm64.sub x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.eq forstep
  subMillisecond:
    arm64.leaRdata x0, __str_rec_3  ; "ok\x0a"
    arm64.bl print
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  forstep:
    arm64.add x19, x19, 1
  forhdr:
    arm64.cmp x19, 1000
    arm64.b.lt __il_body
  forexit:
    arm64.leaRdata x0, __str_rec_2  ; "every reading was a whole millisecond\x0a"
    arm64.bl print
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
