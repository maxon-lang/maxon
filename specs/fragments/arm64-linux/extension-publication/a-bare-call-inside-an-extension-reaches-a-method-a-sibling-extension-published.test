// Test: a-bare-call-inside-an-extension-reaches-a-method-a-sibling-extension-published
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer

	export static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'
end 'Box'

extension Box
	export function tripled() returns Integer
		return self.v * 3
	end 'tripled'
end 'Box'

extension Box
	export function reported() returns Integer
		return tripled() + 1
	end 'reported'
end 'Box'

function main() returns ExitCode
	let b = Box.of(5)
	return b.reported() as ExitCode
end 'main'
---
ExitCode: 16
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
  __il_body#5:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.arm64AddLsl x1, x1, x1, lsl #1
  __il_cont#8:
    arm64.add x19, x1, 1
  __il_cont#6:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-bare-call-inside-an-extension-reaches-a-method-a-sibling-extension-published.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
