    arm64.bl __managed_push
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x22, [x19 + 8]
    arm64.b forhdr#1
  ownLoop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
    arm64.add x20, x20, x0
  forstep#3:
    arm64.add x21, x21, 1
  forhdr#1:
    arm64.cmp x21, x22
    arm64.b.lt ownLoop
  forexit#4:
    arm64.leaRdata x21, __str_rec_2  ; "a,bb,ccc"
    arm64.leaRdata x22, __str_rec_3  ; ","
  __il_body#14:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x23, x0
  __il_body#28:
    arm64.loadRegBaseDisp.word64 x24, [x22 + 8]
  __il_cont#27:
    arm64.cmp x24, 0
