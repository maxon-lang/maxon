// Test: jump-table.four-cases-expression
enum Direction
		north
		south
		east
		west
end 'Direction'

function main() returns ExitCode
		let d = Direction.east
		let code = match d 'dir'
				north gives 10
				south gives 20
				east gives 30
				west gives 40
		end 'dir'
		return code
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.jumpTable x0, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_1
  matchdead:
  matcharm#1:
    arm64.movImm x0, 10
    arm64.b __rc_ok
  matcharm#2:
    arm64.movImm x0, 20
    arm64.b __rc_ok
  matcharm#3:
    arm64.movImm x0, 30
    arm64.b __rc_ok
  matcharm#4:
    arm64.movImm x0, 40
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
