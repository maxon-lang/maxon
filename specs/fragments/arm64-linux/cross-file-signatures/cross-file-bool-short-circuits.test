// Test: cross-file-bool-short-circuits
// --- file: a.maxon

export function ready() returns bool
	return false
end 'ready'

function opaqueZero() returns Integer
	return 0
end 'opaqueZero'

export function enabled() returns bool
	let zero = opaqueZero()
	return (try (1 / zero) otherwise panic("`and` did not short-circuit: enabled() was evaluated")) == 0
end 'enabled'

typealias Integer = int(i64.min to i64.max)
// --- file: b.maxon
function main() returns ExitCode
	if not (ready() and enabled()) 'skipped'
		return 42
	end 'skipped'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont:
    arm64.movImm x0, 0
  scmerge:
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  skipped:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
