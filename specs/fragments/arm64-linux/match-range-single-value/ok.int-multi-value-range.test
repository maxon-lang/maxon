// Test: ok.int-multi-value-range
function main() returns ExitCode
	let x = 6
	let result = match x 'eval'
		5 to 7 gives 0
		default gives 1
	end 'eval'
	return result
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 0
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
