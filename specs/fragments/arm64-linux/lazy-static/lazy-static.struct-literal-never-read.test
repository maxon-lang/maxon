// Test: lazy-static.struct-literal-never-read
typealias Count = int(0 to u64.max)

type Pair
	export var a as Count
	export var b as Count

	static var origin = Pair{a: 1, b: 2}
end 'Pair'

function main() returns ExitCode
	print("no read")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Pair.origin@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "no read"
  __il_body:
    arm64.bl __write_stdout
  __il_cont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
