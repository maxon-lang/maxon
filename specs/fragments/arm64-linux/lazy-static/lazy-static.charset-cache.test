    arm64.cbz x0, ifcont#6
  c3:
    arm64.leaRdata x0, __str_rec_17  ; "tab"
    arm64.bl print
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
