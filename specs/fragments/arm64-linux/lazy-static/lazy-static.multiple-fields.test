// Test: lazy-static.multiple-fields
typealias Count = int(0 to u64.max)

type Cache
	static var a = Cache.buildA()
	static var b = Cache.buildB()
	export var n as Count

	static function buildA() returns Cache
		return Cache{n: 10}
	end 'buildA'

	static function buildB() returns Cache
		return Cache{n: 20}
	end 'buildB'

	export static function sum() returns Count
		return Cache.a.n + Cache.b.n
	end 'sum'
end 'Cache'

function main() returns ExitCode
	return Cache.sum()
end 'main'
---
ExitCode: 30
---
data {
  __data_Cache.a@0 = i64 0
  __data_Cache.b@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.leaGlobal x0, __data_Cache.a
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaGlobal x1, __data_Cache.b
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#7
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_1  ; "panic at lazy-static.multiple-fields.test:18: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_2  ; "panic at lazy-static.multiple-fields.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
