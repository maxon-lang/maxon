  __slab_arena_list@272 = i64 0
  __slab_arena_map_l1@280 = i64 0
  __slab_state@288 = i64 0
}

func @worker {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.leaGlobal x1, __data_progressed
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.bl Runtime.yield
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, worker
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 1000
    arm64.b.ge forexit
  spin:
    arm64.bl Runtime.yield
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.leaGlobal x0, __data_progressed
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __gt_await
    arm64.add x0, x20, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at runtime-yield.spin-wait-from-main.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
