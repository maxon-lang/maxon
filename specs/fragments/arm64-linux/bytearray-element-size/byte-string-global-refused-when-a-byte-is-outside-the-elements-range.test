// Test: byte-string-global-refused-when-a-byte-is-outside-the-elements-range
typealias Byte = int(0 to 100)
typealias Bytes = Array with Byte

var BUFFER = b"\xdf"

function main() returns ExitCode
	var made = Bytes.create()
	made.push(1)
	BUFFER.push(2)
	return made.count() + BUFFER.count()
end 'main'
---
CompilerError:
error E3005: <fragment>:5:14: byte 223 at offset 0 of a `b"…"` byte-string literal is outside the range of 'Byte' (int(0 to 100))
