// Test: a-wide-byte-still-writes-raw-bytes-through-the-buffer-surface
typealias Byte = int(0 to u16.max)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	return (try b.get(0) otherwise 0)
end 'takes'

function main() returns ExitCode
	var buf = Bytes.create()
	buf.push(0)
	try buf.managed.setByte(0, 223) otherwise return 3
	return takes(buf)
end 'main'
---
ExitCode: 223
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @takes {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 0
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 0
  trycont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-wide-byte-still-writes-raw-bytes-through-the-buffer-surface.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movImm x2, 223
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_byte
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl takes
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
