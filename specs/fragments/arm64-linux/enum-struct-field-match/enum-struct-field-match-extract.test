// Test: enum-struct-field-match-extract
typealias SmallInt = int(0 to u8.max)

union Value
		number(n SmallInt)
		empty
end 'Value'

type Container
		export var item as Value

		static function create(item Value) returns Self
			return Self{item: item}
		end 'create'
end 'Container'

function getNumber(c Container) returns SmallInt
		let v = c.item
		match v 'mv'
				number(n) then return n
				empty then return 0
		end 'mv'
end 'getNumber'

function main() returns ExitCode
		let c = Container.create(Value.number(42))
		return getNumber(c)
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 42
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
  __il_body#3:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
  __il_body#4:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __mm_retain
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.bl __mm_decref
    arm64.b __il_cont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#6:
    arm64.movImm x20, 0
    arm64.bl __mm_decref
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Container
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
