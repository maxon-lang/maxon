// Test: a-narrowing-return-keeps-its-guard
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 16)

function shrink(w Wide) returns Narrow
	return w
end 'shrink'

function main() returns ExitCode
	let n = shrink(360)
	print("{n}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @shrink {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 16
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-narrowing-return-keeps-its-guard.test:6: Range check failed: value outside typealias 'Narrow'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 360
  __il_slow:
    arm64.bl shrink
    arm64.movRegReg x19, x0
  __il_cont:
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __uint_to_string
    arm64.movRegReg x19, x0
    arm64.add x0, x19, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.add x22, x21, 56
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x22, x19
    arm64.storeBaseDispReg.word64 [x21 + 0], x22
    arm64.storeBaseDispReg.word64 [x21 + 8], x19
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.bl print
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
