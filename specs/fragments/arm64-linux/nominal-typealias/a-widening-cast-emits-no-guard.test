// Test: a-widening-cast-emits-no-guard
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 16)

function widen(n Narrow) returns Wide
	return n as Wide
end 'widen'

function main() returns ExitCode
	return widen(9) as ExitCode
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    arm64.prologue 16
  __rc_ok#6:
    arm64.movImm x0, 9
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
