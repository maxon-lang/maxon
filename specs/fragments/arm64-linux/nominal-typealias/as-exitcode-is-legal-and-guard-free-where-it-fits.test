// Test: as-exitcode-is-legal-and-guard-free-where-it-fits
typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 7 as Byte
	return b as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
