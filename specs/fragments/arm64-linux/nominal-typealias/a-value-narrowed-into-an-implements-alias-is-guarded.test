// Test: a-value-narrowed-into-an-implements-alias-is-guarded
typealias FooId = int(0 to 1000) implements ElementIndex

function takesFoo(f FooId) returns FooId
	return f
end 'takesFoo'

function main() returns ExitCode
	let i = 4000 as ElementIndex
	let f = takesFoo(i as FooId)
	print("{f}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-value-narrowed-into-an-implements-alias-is-guarded.test:10: Range check failed: value outside typealias 'FooId'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
