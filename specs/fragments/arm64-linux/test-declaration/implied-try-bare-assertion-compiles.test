// Test: implied-try-bare-assertion-compiles
// --- file: assertions.maxon
export function assertTrue(ok bool) throws TestFailure
	if not ok 'bad'
		throw TestFailure.assertion
	end 'bad'
end 'assertTrue'

// --- file: example.maxtest
test 'forgets its try'
	assertTrue(true)
end 'forgets its try'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @assertTrue {
  entry:
    arm64.prologue 16
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  bad:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @__test_forgets_its_try {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl assertTrue
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
