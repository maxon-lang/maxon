// Test: appendMemory-takes-another-arrays-managed
function main() returns ExitCode
	var a = [1, 2, 3]
	let b = [4, 5, 6]
	a.appendMemory(b.managed)
	var sum = 0
	var i = 0
	while i < a.count() 'loop'
		sum = sum + (try a.get(i) otherwise 0)
		i = i + 1
	end 'loop'
	return sum
end 'main'
---
ExitCode: 21
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 3
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __barr_blob_1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movImm x0, 3
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x20 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x20 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_retain
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_append
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movImm x21, 0
    arm64.movImm x0, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.b whilehdr
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x3, [x2 + x0*8 + 0]
  trycont:
    arm64.add x21, x21, x3
    arm64.add x0, x0, 1
  whilehdr:
    arm64.cmp x0, x1
    arm64.b.lt __im_load
  whileexit:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at appendMemory-takes-another-arrays-managed.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
