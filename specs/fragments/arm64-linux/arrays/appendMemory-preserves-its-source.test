// Test: appendMemory-preserves-its-source
function main() returns ExitCode
	var a = [1, 2]
	let b = [3, 4]
	a.appendMemory(b.managed)
	// b should still have its original elements
	let b0 = try b.get(0) otherwise 0
	let b1 = try b.get(1) otherwise 0
	return b0 + b1
end 'main'
---
ExitCode: 7
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x21
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 2
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __barr_blob_1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movImm x0, 2
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x20 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x20 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_retain
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_append
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#11
    arm64.b __im_load#12
  tryerr#2:
    arm64.movImm x0, 0
    arm64.b trycont#3
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  trycont#3:
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x20 + 8]
    arm64.cmp x2, 1
    arm64.b.ls __im_slow#14
    arm64.b __im_load#15
  tryerr#5:
    arm64.movImm x1, 0
    arm64.b trycont#6
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.add x1, x1, 8
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont#6:
    arm64.add x21, x0, x1
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.epilogue 48
    arm64.ret
  __im_slow#11:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr#2
    arm64.b trycont#3
  __im_slow#14:
    arm64.storeSlotReg slot0, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x0, slot0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#5
    arm64.b trycont#6
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at appendMemory-preserves-its-source.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
