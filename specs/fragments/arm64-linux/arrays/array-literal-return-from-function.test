    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  __il_cont:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#14
    arm64.b __im_load#15
  tryerr#2:
    arm64.movImm x0, 0
    arm64.b trycont#3
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  trycont#3:
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.cmp x2, 1
    arm64.b.ls __im_slow#17
    arm64.b __im_load#18
  tryerr#5:
    arm64.movImm x1, 0
    arm64.b trycont#6
  __im_load#18:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.add x1, x1, 8
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  trycont#6:
    arm64.movImm x2, 2
    arm64.loadRegBaseDisp.word64 x3, [x19 + 8]
    arm64.cmp x3, 2
    arm64.b.ls __im_slow#20
    arm64.b __im_load#21
  tryerr#8:
    arm64.movImm x2, 0
    arm64.b trycont#9
  __im_load#21:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.add x2, x2, 16
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
  trycont#9:
    arm64.add x0, x0, x1
    arm64.add x20, x0, x2
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
