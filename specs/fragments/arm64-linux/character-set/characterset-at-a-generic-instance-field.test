// Test: characterset-at-a-generic-instance-field
type Box uses T
	var v as T

	export static function init(x T) returns Self
		return Self{v: x}
	end 'init'
end 'Box'

typealias CharacterSetBox = Box with CharacterSet

function main() returns ExitCode
	_ = CharacterSetBox.init(CharacterSet.whitespaces())
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespaces@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Box.init {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl CharacterSet.whitespaces
    arm64.bl Box.init
    arm64.bl __destruct_Box_CharacterSet
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
