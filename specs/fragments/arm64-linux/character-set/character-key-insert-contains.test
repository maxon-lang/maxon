// Test: character-key-insert-contains
function main() returns ExitCode
	var cs = CharSet.create()
	cs.insert('x')
	cs.insert('é')
	cs.insert('中')
	cs.insert('x')
	print("{cs.count()}\n")
	print("{cs.contains('x')}\n")
	print("{cs.contains('é')}\n")
	print("{cs.contains('y')}")
	return 0
end 'main'
