func @work {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl Scheduler.yield
    arm64.add x0, x19, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @start {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.cbz x0, ifcont
  refuse:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.leaFuncAddr x0, work
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 200], x19
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movImm x9, 0
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @fallback {
  entry:
    arm64.prologue 16
    arm64.bl Scheduler.yield
    arm64.movImm x0, 40
    arm64.epilogue 16
    arm64.ret
}

func @run {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl start
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.leaFuncAddr x0, fallback
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movRegReg x0, x20
  trycont:
    arm64.cbz x19, ifcont
  awaitTheFallback:
    arm64.bl __gt_await
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 2
    arm64.bl __gt_promise_drop
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

