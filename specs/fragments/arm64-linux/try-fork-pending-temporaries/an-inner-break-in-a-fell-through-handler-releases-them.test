// Test: an-inner-break-in-a-fell-through-handler-releases-them
typealias StrArray = Array with String
typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

function consume(argv StrArray, n Integer) returns Integer throws Boom
	if n > 100 'big'
		throw Boom.bad
	end 'big'
	return argv.count() + n
end 'consume'

function run(limit Integer) returns Integer
	var seen = 0 as Integer
	var i = 0 as Integer
	while i < limit 'loop'
		try consume(["x", "y"], n: i * 400) otherwise 'h'
			if i > 1 'deep'
				break
			end 'deep'
		end 'h'
		seen = seen + 1
		i = i + 1
	end 'loop'
	return seen
end 'run'

function main() returns ExitCode
	return run(9) as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @consume {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 100
    arm64.b.le ifcont
  big:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x0, x0, x1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @run {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  whilehdr:
    arm64.cmp x21, x19
    arm64.b.ge whileexit
  loop:
    arm64.leaRdata x22, __str_rec_2  ; "x"
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x23
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_3  ; "y"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x23
    arm64.bl __managed_push
    arm64.movImm x16, 400
    arm64.mul x1, x21, x16
    arm64.movRegReg x0, x23
    arm64.bl consume
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.cmp x21, 1
    arm64.b.le trycont
  deep:
    arm64.movRegReg x0, x23
    arm64.bl __managed_decref
    arm64.b whileexit
  trycont:
    arm64.movRegReg x0, x23
    arm64.bl __managed_decref
    arm64.add x20, x20, 1
    arm64.add x21, x21, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9
    arm64.bl run
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at an-inner-break-in-a-fell-through-handler-releases-them.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
