// Test: a-qualified-array-from-head-names-the-alias-it-qualifies-at-top-level
// --- file: api/types.maxon
export typealias Smalls = Array with ExitCode

// --- file: legacy/types.maxon
export typealias Smalls = Array with bool

// --- file: app/main.maxon
let Xs = api.Smalls from [1, 2, 3]

function main() returns ExitCode
	return Xs.count() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_Xs@0 = i64 0
  __mrt_envp@8 = i64 0
  __mrt_signal_stack_bytes@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
  __mrt_program_started@48 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_Xs
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
