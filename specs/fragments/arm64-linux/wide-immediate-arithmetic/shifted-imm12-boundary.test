    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#16:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 0
  trycont:
    arm64.add x1, x0, 16773120
    arm64.movImm x16, 16774120
    arm64.cmp x1, x16
    arm64.b.eq ifcont#5
  addShifted:
    arm64.movImm x20, 21
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
