// Test: builtins-parallel-boundary.statement-position
function checkpoint()
	__Builtins.parallelBoundary()
end 'checkpoint'

function main() returns ExitCode
	checkpoint()
	checkpoint()
	return 3
end 'main'
---
ExitCode: 3
---
func @checkpoint {
  entry:
    arm64.prologue 16
    arm64.bl __parallel_boundary
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl checkpoint
    arm64.bl checkpoint
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
