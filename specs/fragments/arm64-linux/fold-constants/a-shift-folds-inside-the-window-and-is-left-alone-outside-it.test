// Test: a-shift-folds-inside-the-window-and-is-left-alone-outside-it
typealias Word = int(i64.min to i64.max)

function shiftLeft(v Word, n Word) returns Word
	return v shl n
end 'shiftLeft'

function shiftRight(v Word, n Word) returns Word
	return v shr n
end 'shiftRight'

function main() returns ExitCode
	if shiftLeft(1, n: 62) != 4611686018427387904 'inWindow'
		return 1
	end 'inWindow'
	if shiftLeft(1, n: 63) != i64.min 'atTheTopOfTheWindow'
		return 2
	end 'atTheTopOfTheWindow'
	if shiftLeft(1, n: 64) != 0 'firstCountPastTheWindow'
		return 3
	end 'firstCountPastTheWindow'
	if shiftLeft(1, n: 100) != 0 'wellPastTheWindow'
		return 4
	end 'wellPastTheWindow'
	if shiftRight(-8, n: 1) != -4 'signFillingInWindow'
		return 5
	end 'signFillingInWindow'
	if shiftRight(-8, n: 70) != -1 'signFillingPastTheWindow'
		return 6
	end 'signFillingPastTheWindow'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  ifcont#4:
    arm64.movImm x0, 1
    arm64.movImm x1, 64
  shiftok#24:
    arm64.lslv x0, x0, x1
    arm64.movImm x16, 0
    arm64.and x0, x0, x16
  ifcont#6:
    arm64.movImm x0, 1
    arm64.movImm x1, 100
  shiftok#28:
    arm64.lslv x0, x0, x1
    arm64.movImm x16, 0
    arm64.and x0, x0, x16
  ifcont#10:
    arm64.movImm x0, 18446744073709551608
  shiftok#36:
    arm64.movImm x1, 18446744073709551615
    arm64.asrv x0, x0, x1
  __il_cont:
    arm64.cmp x0, -1
    arm64.b.eq ifcont#12
  signFillingPastTheWindow:
    arm64.movImm x0, 6
    arm64.epilogue 16
    arm64.ret
  ifcont#12:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
