// Test: the-remainder-at-the-overflow-pair-is-zero
typealias Word = int(i64.min to i64.max)

function pick(a Word) returns Word
	return a
end 'pick'

function main() returns ExitCode
	if (try (pick(i64.min) mod pick(-1)) otherwise -79) != 0 'remainderAtTheOverflowPair'
		return 1
	end 'remainderAtTheOverflowPair'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9223372036854775808
  __il_cont:
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.add x2, x2, -1
    arm64.and x0, x0, x2
    arm64.movImm x16, 18446744073709551615
    arm64.orr x1, x1, x16
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
  tryok:
    arm64.cmp x0, 0
    arm64.b.eq ifcont
  remainderAtTheOverflowPair:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
