// Test: closure-capture.a-call-through-a-function-value-lands-only-on-bodies-of-its-arity
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

function idle() returns Integer
	return 0
end 'idle'

type Counter
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: idle}
	end 'create'
end 'Counter'

function wire(target Counter, source Counter)
	target.read = function() gives source.n
end 'wire'

function readTwice(c Counter) returns Integer
	let reader = function(t Counter) gives t.n + c.n
	return reader(c)
end 'readTwice'

function main() returns ExitCode
	let wiring = wire
	var a = Counter.create(1)
	let b = Counter.create(2)
	wiring(a, b)
	print("{a.read()} {readTwice(b)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @idle {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @Counter.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __fnrec_idle
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @wire {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.bl __mm_own
    arm64.movRegReg x20, x0
    arm64.leaFuncAddr x1, wire$closure_0$drop
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.leaFuncAddr x0, wire$closure_0
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.bl __mm_decref
    arm64.movRegReg x1, x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @wire$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @wire$closure_0$drop {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __destruct_Counter
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @readTwice$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @readTwice$closure_0$drop {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __destruct_Counter
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

