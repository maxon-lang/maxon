// Test: closure-capture.a-closure-stored-into-a-record-it-does-not-capture
typealias Integer = int(i64.min to i64.max)
typealias Thunk = function() returns Integer

type Counter
	export var n as Integer
	export var read as Thunk

	static function create(n Integer) returns Self
		return Self{n: n, read: function() gives 0}
	end 'create'

	function lend(other Counter)
		other.read = function() gives self.n
	end 'lend'
end 'Counter'

function main() returns ExitCode
	let source = Counter.create(7)
	var target = Counter.create(1)
	source.lend(target)
	return target.read() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @Counter.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __fnrec_Counter.create$closure_0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Counter.create$closure_0 {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @Counter.lend$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Counter.lend$closure_0$drop {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __destruct_Counter
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 7
    arm64.bl Counter.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl Counter.create
    arm64.movRegReg x20, x0
  __il_body:
    arm64.movRegReg x0, x19
    arm64.bl __mm_own
    arm64.movRegReg x21, x0
    arm64.leaFuncAddr x1, Counter.lend$closure_0$drop
    arm64.movImm x0, 16
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.leaFuncAddr x0, Counter.lend$closure_0
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x20 + 8], x22
  __il_cont:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __mm_retain
    arm64.movRegReg x22, x0
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.movRegReg x0, x21
    arm64.blr x1
    arm64.movRegReg x21, x0
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Counter
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Counter
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at closure-capture.a-closure-stored-into-a-record-it-does-not-capture.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
