// Test: opener-case-member-in-a-method-body-adopts-no-free-function
enum Kw
	alpha
	while
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		while then return 2
		omega then return 3
	end 'm'
end 'tagOf'

type Holder
	export var base as Integer

	export static function create() returns Holder
		return Self{base: tagOf(Kw.while)}
	end 'create'

	export function total() returns Integer
		return self.base + helper()
	end 'total'
end 'Holder'

function helper() returns Integer
	return 40
end 'helper'

function main() returns ExitCode
	let h = Holder.create()
	return h.total() as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  matcharm:
    arm64.movImm x19, 2
  __il_cont#7:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
  __il_cont#17:
    arm64.add x19, x1, 40
  __il_cont#4:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at opener-case-member-in-a-method-body-adopts-no-free-function.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
