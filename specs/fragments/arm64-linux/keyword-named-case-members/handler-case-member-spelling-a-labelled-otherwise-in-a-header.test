// Test: handler-case-member-spelling-a-labelled-otherwise-in-a-header
enum Kw
	otherwise
	alpha
end 'Kw'

function main() returns ExitCode
	let k = Kw.alpha
	var i = 0
	while k == Kw.otherwise 'loop'
		i = i + 1
	end 'loop'

	if k == Kw.otherwise 'chk'
		i = 9
	end 'chk'

	return (42 + i) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  ifcont:
    arm64.add x0, x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
