// Test: float-locals-read-after-each-of-two-calls
function work(x Integer) returns Integer
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var acc = 0
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	return acc
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 8
---
func @main {
  entry:
    arm64.prologue 16
  __il_body#6:
    arm64.movImm x0, 1
  __il_cont#5:
    arm64.add x0, x0, 1
    arm64.add x0, x0, 2
  __il_body#7:
    arm64.add x0, x0, 1
  __il_cont#4:
    arm64.add x0, x0, 1
    arm64.add x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
