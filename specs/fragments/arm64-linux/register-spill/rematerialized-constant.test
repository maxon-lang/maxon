// Test: rematerialized-constant
function rematConstant(p Integer) returns Integer
	let c = 7
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let a7 = p + 7
	let a8 = p + 8
	let a9 = p + 9
	let a10 = p + 10
	let a11 = p + 11
	let a12 = p + 12
	let a13 = p + 13
	let a14 = p + 14
	let s = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14
	return s / c
end 'rematConstant'

function main() returns ExitCode
	return rematConstant(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 105
    arm64.movImm x1, 5270498306774157605
    arm64.smulh x0, x1, x0
    arm64.asr x0, x0, 1
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rematerialized-constant.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
