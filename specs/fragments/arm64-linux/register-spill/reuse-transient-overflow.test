// Test: reuse-transient-overflow
function reuseTransientOverflow(p Integer) returns Integer
	let a = p + 100
	let b1 = p + 2
	let b2 = p + 3
	let b3 = p + 4
	let b4 = p + 5
	let b5 = p + 6
	let b6 = p + 7
	let b7 = p + 8
	let b8 = p + 9
	let b9 = p + 10
	let b10 = p + 11
	let b11 = p + 12
	let b12 = p + 13
	let rhs = p + 50
	let d = a - rhs
	let s = b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + d + a
	return s
end 'reuseTransientOverflow'

function main() returns ExitCode
	return reuseTransientOverflow(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 240
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 240
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
