// Test: loop-invariant-read-across-a-call-in-a-loop
function sink(x Integer) returns Integer
	return x
end 'sink'

function invariantsAcrossCall(p Integer) returns Integer
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	var acc = 0
	var i = 0
	while i < 3 'loop'
		let pre = acc + a1 + a2 + a3 + a4 + a5 + a6
		let r = sink(i)
		acc = pre + r + a1 + a2 + a3 + a4 + a5 + a6
		i = i + 1
	end 'loop'
	return acc
end 'invariantsAcrossCall'

function main() returns ExitCode
	return invariantsAcrossCall(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 129
---
func @invariantsAcrossCall {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x3, x0, 3
    arm64.add x4, x0, 4
    arm64.add x5, x0, 5
    arm64.add x0, x0, 6
    arm64.movImm x6, 0
    arm64.movImm x7, 0
  whilehdr:
    arm64.cmp x7, 3
    arm64.b.ge whileexit
  loop:
    arm64.add x6, x6, x1
    arm64.add x6, x6, x2
    arm64.add x6, x6, x3
    arm64.add x6, x6, x4
    arm64.add x6, x6, x5
    arm64.add x6, x6, x0
  __il_cont:
    arm64.add x6, x6, x7
    arm64.add x6, x6, x1
    arm64.add x6, x6, x2
    arm64.add x6, x6, x3
    arm64.add x6, x6, x4
    arm64.add x6, x6, x5
    arm64.add x6, x6, x0
    arm64.add x7, x7, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x6
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl invariantsAcrossCall
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at loop-invariant-read-across-a-call-in-a-loop.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
