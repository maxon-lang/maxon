// Test: values-confined-by-different-calls
function sink(x Integer) returns Integer
	return x
end 'sink'

function pick(k Integer) returns Integer
	let v1 = k + 11
	let v2 = k + 22
	let v3 = k + 33
	let v4 = k + 44
	let v5 = k + 55
	let v6 = k + 66
	var out = 0
	if k == 1 'b1'
		let t = sink(1)
		out = v1 + t
	end 'b1' else if k == 2 'b2'
		let t = sink(2)
		out = v2 + t
	end 'b2' else if k == 3 'b3'
		let t = sink(3)
		out = v3 + t
	end 'b3' else if k == 4 'b4'
		let t = sink(4)
		out = v4 + t
	end 'b4' else if k == 5 'b5'
		let t = sink(5)
		out = v5 + t
	end 'b5' else 'b6'
		let t = sink(6)
		out = v6 + t
	end 'b6'
	return out
end 'pick'

function main() returns ExitCode
	if pick(1) != 13 'a1'
		return 1
	end 'a1'
	if pick(2) != 26 'a2'
		return 2
	end 'a2'
	if pick(3) != 39 'a3'
		return 3
	end 'a3'
	if pick(4) != 52 'a4'
		return 4
	end 'a4'
	if pick(5) != 65 'a5'
		return 5
	end 'a5'
	if pick(6) != 78 'a6'
		return 6
	end 'a6'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 11
    arm64.add x2, x0, 22
    arm64.add x3, x0, 33
    arm64.add x4, x0, 44
    arm64.add x5, x0, 55
    arm64.add x6, x0, 66
    arm64.cmp x0, 1
    arm64.b.ne ifelse#2
  __il_cont#16:
    arm64.add x0, x1, 1
    arm64.b ifcont
  ifelse#2:
    arm64.cmp x0, 2
    arm64.b.ne ifelse#4
  __il_cont#18:
    arm64.add x0, x2, 2
    arm64.b ifcont
  ifelse#4:
    arm64.cmp x0, 3
    arm64.b.ne ifelse#6
  __il_cont#20:
    arm64.add x0, x3, 3
    arm64.b ifcont
  ifelse#6:
    arm64.cmp x0, 4
    arm64.b.ne ifelse#8
  __il_cont#22:
    arm64.add x0, x4, 4
    arm64.b ifcont
  ifelse#8:
    arm64.cmp x0, 5
    arm64.b.ne __il_cont#26
  __il_cont#24:
    arm64.add x0, x5, 5
    arm64.b ifcont
  __il_cont#26:
    arm64.add x0, x6, 6
  ifcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.cmp x0, 13
    arm64.b.eq ifcont#2
  a1:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 2
    arm64.bl pick
    arm64.cmp x0, 26
    arm64.b.eq ifcont#4
  a2:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 3
    arm64.bl pick
    arm64.cmp x0, 39
    arm64.b.eq ifcont#6
  a3:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 4
    arm64.bl pick
    arm64.cmp x0, 52
    arm64.b.eq ifcont#8
  a4:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 5
    arm64.bl pick
    arm64.cmp x0, 65
    arm64.b.eq ifcont#10
  a5:
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
  ifcont#10:
    arm64.movImm x0, 6
    arm64.bl pick
    arm64.cmp x0, 78
    arm64.b.eq ifcont#12
  a6:
    arm64.movImm x0, 6
    arm64.epilogue 16
    arm64.ret
  ifcont#12:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
