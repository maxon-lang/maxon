// Test: utf16-is-lead-surrogate
function main() returns ExitCode
	// 0xD83D = 55357 (high surrogate for 😀)
	if utf16IsLeadSurrogate(55357) 'c1'
		print("1\n")
	end 'c1'
	if utf16IsLeadSurrogate(56832) 'c2'
		print("0\n")
	end 'c2'
	if utf16IsLeadSurrogate(65) 'c3'
		print("0\n")
	end 'c3'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  andrhs#9:
    arm64.movImm x0, 1
  __il_cont#7:
    arm64.cbz x0, andrhs#16
  c1:
    arm64.leaRdata x0, __str_rec_2  ; "1\x0a"
    arm64.bl print
  andrhs#16:
    arm64.movImm x0, 0
  __il_cont#14:
    arm64.cbz x0, __rc_ok
  c2:
    arm64.leaRdata x0, __str_rec_3  ; "0\x0a"
    arm64.bl print
  __rc_ok:
    arm64.movImm x0, 0
  __il_cont#21:
    arm64.cbz x0, ifcont
  c3:
    arm64.leaRdata x0, __str_rec_3  ; "0\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
