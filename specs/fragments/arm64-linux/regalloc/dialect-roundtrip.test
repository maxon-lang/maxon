// Test: dialect-roundtrip
typealias Integer = int(i64.min to i64.max)

function ident(x Integer) returns Integer
	return x
end 'ident'

function main() returns ExitCode
	let args = CommandLine.args()
	let seed = try int.fromString(try args.get(1) otherwise "0") otherwise 0

	// Two values defined via opaque calls so the constant folder cannot
	// see through them. Each combines with a small set of distinct masks
	// using and/or/xor/cmp — the exact ALU mix that Phase 3 will eventually
	// fold into addRegMem / andRegMem / xorRegMem when the values spill.
	let v1 = ident(seed + 7)
	let v2 = ident(seed + 13)

	var acc = 0
	acc = acc + (v1 and 255)
	acc = acc + (v2 or 4096)
	acc = acc + (v1 xor 21845)
	acc = acc + (v2 + 1)

	let masked = acc and 255
	return masked as ExitCode
end 'main'
---
Args: 0
ExitCode: 116
---
data {
  __mm_alloc_count@0 = i64 0
  __cl_argc@8 = i64 0
  __cl_argv@16 = i64 0
  __cl_empty_arg@24 = i64 0
  __slab_arena_list@32 = i64 0
  __slab_arena_map_l1@40 = i64 0
  __slab_state@48 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl CommandLine.args
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#18
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#19
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#19:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#18:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont#3
  tryerr#2:
    arm64.leaRdata x0, __str_rec_1  ; "0"
  trycont#3:
    arm64.bl __int_fromString
    arm64.cmp x9, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 0
  trycont#6:
    arm64.add x1, x0, 7
  __il_cont#15:
    arm64.add x0, x0, 13
  __il_cont#14:
    arm64.and x2, x1, 255
    arm64.orr x3, x0, 4096
    arm64.add x2, x2, x3
    arm64.movImm x16, 21845
    arm64.eor x1, x1, x16
    arm64.add x1, x2, x1
    arm64.add x0, x0, 1
    arm64.add x0, x1, x0
    arm64.and x20, x0, 255
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_11  ; "panic at dialect-roundtrip.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
