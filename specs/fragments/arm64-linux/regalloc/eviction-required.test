    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl CommandLine.args
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#37
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#38
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#38:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#37:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont#3
  tryerr#2:
    arm64.leaRdata x0, __str_rec_1  ; "0"
  trycont#3:
    arm64.bl __int_fromString
    arm64.cmp x9, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 0
  trycont#6:
    arm64.add x1, x0, 100
  __il_cont#22:
    arm64.add x2, x0, 200
  __il_cont#21:
