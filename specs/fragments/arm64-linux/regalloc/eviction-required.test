  __il_body#35:
    arm64.add x12, x9, 3
  __il_body#36:
    arm64.add x9, x9, 4
  __il_cont#29:
    arm64.add x7, x7, x10
    arm64.add x7, x7, x11
    arm64.add x7, x7, x12
    arm64.add x7, x7, x9
