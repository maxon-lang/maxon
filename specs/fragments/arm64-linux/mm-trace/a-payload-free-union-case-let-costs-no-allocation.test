// Test: a-payload-free-union-case-let-costs-no-allocation
typealias Count = int(0 to 100)
typealias CountArray = Array with Count

union Column
	unwritten
	entries(items CountArray)
end 'Column'

let NoColumn = Column.unwritten

function main() returns ExitCode
	match NoColumn 'probe'
		unwritten then return 0
		entries(c) then return c.count() as ExitCode
	end 'probe'
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __mrt_envp@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __ds_base@40 = i64 0
  __ds_buf_size@48 = i64 0
  __ds_buf_mask@56 = i64 0
  __ds_start_ts@64 = i64 0
  __ds_lock@72 = i64 0
  __mm_alloc_id@80 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __struct_rec_0
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __managed_incref
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-payload-free-union-case-let-costs-no-allocation.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
