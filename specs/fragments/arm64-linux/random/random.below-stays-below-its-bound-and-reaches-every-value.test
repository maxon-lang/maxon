// Test: random.below-stays-below-its-bound-and-reaches-every-value
typealias FaceCounts = Array with bool

function main() returns ExitCode
	var seen = FaceCounts.create()
	seen.resize(6)

	for _ in 0 upto 1000 'eachDraw'
		let face = try Random.below(6) otherwise return 1

		if face >= 6 'outOfRange'
			return 2
		end 'outOfRange'

		try seen.set(face as ElementIndex, value: true) otherwise return 3
	end 'eachDraw'

	for wasSeen in seen 'eachFace'
		if not wasSeen 'missing'
			return 4
		end 'missing'
	end 'eachFace'

	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __mrt_program_started@40 = i8 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 18446744073709551615
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 6
    arm64.movRegReg x0, x19
    arm64.bl __managed_resize
    arm64.movImm x20, 0
    arm64.b forhdr#1
  eachDraw:
    arm64.movImm x0, 6
    arm64.bl Random.below
    arm64.movRegReg x1, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#6:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.cmp x1, 6
    arm64.b.lt ifcont
  outOfRange:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x2, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.b.eq forstep#3
  tryerr#10:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  forstep#3:
    arm64.add x20, x20, 1
  forhdr#1:
    arm64.cmp x20, 1000
    arm64.b.lt eachDraw
  forexit#4:
    arm64.movImm x20, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.b forhdr#11
  eachFace:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_get_unchecked
    arm64.eor x0, x0, 1
    arm64.cbz x0, forstep#13
  missing:
    arm64.movImm x20, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  forstep#13:
    arm64.add x20, x20, 1
  forhdr#11:
    arm64.cmp x20, x21
    arm64.b.lt eachFace
  forexit#14:
    arm64.movImm x20, 42
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
