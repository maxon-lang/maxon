// Test: mixed-values
enum Priority
	low
	medium
	high = 10
	critical
end 'Priority'

function main() returns ExitCode
	let result = match Priority.critical 'check'
		low gives 0
		medium gives 1
		high gives 10
		critical gives 11
	end 'check'
	return result
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 11
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
