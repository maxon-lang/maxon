// Test: fromRawValue-failure

typealias Integer = int(i64.min to i64.max)

enum HttpStatus
	ok = 200
	notFound = 404
end 'HttpStatus'

function getCode() returns Integer
	return 999
end 'getCode'

function main() returns ExitCode
	let code = getCode()
	let status = try HttpStatus.fromRawValue(code) otherwise HttpStatus.ok
	if status == HttpStatus.ok 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 999
  __il_cont:
    arm64.bl __enum_from_raw_HttpStatus
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 200
  trycont:
    arm64.cmp x0, 200
    arm64.b.ne ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
