// Test: float-arithmetic
enum Weight
	light = 0.5
	heavy = 2.0
end 'Weight'

function main() returns ExitCode
	let scale = 4.0
	let result = Weight.light * scale
	if result == 2.0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
