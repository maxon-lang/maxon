// Test: keyword-as-case-name
enum TokenKind
	function
	return
	end
	if
end 'TokenKind'

function main() returns ExitCode
	let t = TokenKind.function
	if t == TokenKind.function 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
