// Test: folded-and-unfolded-agree-on-stderr
// --- stdlib-overlay: Builtins.maxon
export typealias WrittenBytes = int(0 to u64.max)

export function errFolded(text String) returns WrittenBytes
	return __Builtins.writeStderr(text.addressableBytes())
end 'errFolded'

export function errThroughABinding(text String) returns WrittenBytes
	let bytes = text.addressableBytes()
	return __Builtins.writeStderr(bytes)
end 'errThroughABinding'
// --- file: main.maxon
function main() returns ExitCode
	let a = errFolded("xy\n")
	let b = errThroughABinding("z\n")
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_2  ; "xy\x0a"
    arm64.bl errFolded
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_3  ; "z\x0a"
    arm64.bl errThroughABinding
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
