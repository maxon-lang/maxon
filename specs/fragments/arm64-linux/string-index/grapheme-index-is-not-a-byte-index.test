// Test: grapheme-index-is-not-a-byte-index
function main() returns ExitCode
	let uni = "aéb👨‍👩‍👧cd"
	let cd = try uni.findFirst("cd") otherwise uni.endIndex()
	print("{cd.charIndex()} {cd.bytePos()} {uni.count()}\n")
	return 0
end 'main'
