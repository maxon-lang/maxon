// Test: filepath-is-absolute-unc
function main() returns ExitCode
	let p = FilePath from "\\\\server\\share"
	if p.isAbsolute() 'abs'
		print("absolute\n")
	end 'abs'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_18  ; "\\\\server\\share"
  __il_body#5:
    arm64.bl FilePath.create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
  __il_body#16:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __il_cont#15:
    arm64.cmp x0, 1
    arm64.b.lo ifcont#12
  checkSlash:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 0
    arm64.bl String.byteAtOrPanic
    arm64.cmp x0, 47
    arm64.b.ne ifcont#12
  isAbsUnix:
    arm64.movImm x0, 1
    arm64.b __il_cont#3
  ifcont#12:
    arm64.movImm x0, 0
  __il_cont#3:
    arm64.cbz x0, ifcont#2
  abs:
    arm64.leaRdata x0, __str_rec_19  ; "absolute\x0a"
  __il_body#14:
    arm64.bl __write_stdout
  ifcont#2:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_28  ; "panic at FilePath.maxon:31: FilePath: invalid path\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
