// Test: filepath-equality
function main() returns ExitCode
	let a = FilePath from "C:\\test.txt"
	let b = FilePath from "C:\\test.txt"
	if a == b 'eq'
		print("equal\n")
	end 'eq'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_18  ; "C:\\test.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_18  ; "C:\\test.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x20, x0
  __il_body#4:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl FilePath.canonicalForCompare
    arm64.movRegReg x21, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.bl FilePath.canonicalForCompare
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __str_eq
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
  __il_cont:
    arm64.cbz x23, ifcont
  eq:
    arm64.leaRdata x0, __str_rec_19  ; "equal\x0a"
  __il_body#6:
    arm64.bl __write_stdout
  ifcont:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
