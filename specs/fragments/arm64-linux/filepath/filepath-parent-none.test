// Test: filepath-parent-none
function main() returns ExitCode
	let p = FilePath from "file.txt"
	try p.parent() otherwise 'noParent'
		print("caught noParent\n")
		return 0
	end 'noParent'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_18  ; "file.txt"
  __il_body#4:
    arm64.bl FilePath.create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne tryerr#6
  __il_cont#3:
    arm64.movRegReg x0, x19
    arm64.bl FilePath.parent
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.leaRdata x0, __str_rec_19  ; "caught noParent\x0a"
  __il_body#8:
    arm64.bl __write_stdout
  __il_cont#7:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.bl __destruct_FilePath
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryerr#6:
    arm64.leaRdata x0, __str_blob_28  ; "panic at FilePath.maxon:31: FilePath: invalid path\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
