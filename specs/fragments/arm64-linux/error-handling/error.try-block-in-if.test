// Test: error.try-block-in-if
typealias Code = int(i64.min to i64.max)

enum Fault implements Error
	broken
end 'Fault'

function risky(_ Code) returns Code throws Fault
	throw Fault.broken
end 'risky'

function main() returns ExitCode
	var acc = 0 as Code
	if acc < 5 'guard'
		try risky(3) otherwise (e) 'h'
			match e 'f'
				broken then acc = 7
			end 'f'
		end 'h'
		acc = acc + 1
	end 'guard'
	return acc
end 'main'
---
ExitCode: 8
---
func @risky {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  guard:
    arm64.movImm x0, 3
    arm64.bl risky
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.movImm x0, 7
    arm64.b trycont
  matchdead:
  tryok:
    arm64.movRegReg x0, x19
  trycont:
    arm64.add x0, x0, 1
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
