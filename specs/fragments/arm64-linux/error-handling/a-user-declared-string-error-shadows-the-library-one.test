// Test: a-user-declared-string-error-shadows-the-library-one
typealias Num = int(0 to 1000)

enum StringError implements Error
	somethingElse
	another
end 'StringError'

function firstSpace(s String) returns Num throws StringError
	let idx = try s.findFirst(" ") otherwise throw StringError.another
	return idx.bytePos() as Num
end 'firstSpace'

function main() returns ExitCode
	let hit = try firstSpace("ab cd") otherwise 99
	let miss = try firstSpace("abcd") otherwise 7
	return hit + miss
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @firstSpace {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x1, __str_rec_3  ; " "
    arm64.bl String.findFirst
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x9, 2
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 1000
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_21  ; "panic at a-user-declared-string-error-shadows-the-library-one.test:11: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_4  ; "ab cd"
    arm64.bl firstSpace
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.movImm x19, 99
    arm64.b trycont#3
  tryok:
    arm64.movRegReg x19, x0
  trycont#3:
    arm64.leaRdata x0, __str_rec_5  ; "abcd"
    arm64.bl firstSpace
    arm64.cmp x9, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 7
  trycont#6:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_22  ; "panic at a-user-declared-string-error-shadows-the-library-one.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
