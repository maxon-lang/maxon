// Test: a-parameter-named-type-beside-a-real-type-declaration
typealias Integer = int(i64.min to i64.max)

type Holder
	export let n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Holder'

function unwrap(type Holder) returns Integer
	return type.n
end 'unwrap'

function main() returns ExitCode
	return unwrap(Holder.create(42))
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 42
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-parameter-named-type-beside-a-real-type-declaration.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
