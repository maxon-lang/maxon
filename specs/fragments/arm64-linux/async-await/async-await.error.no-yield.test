// Test: async-await.error.no-yield
typealias Integer = int(i64.min to i64.max)

function heavyCompute(n Integer) returns Integer
		return n * n
end 'heavyCompute'

function main() returns ExitCode
		let p = async heavyCompute(5)
		let result = await p
		return result
end 'main'
---
CompilerError:
error E3073: <fragment>:9:11: 'async heavyCompute(5)' — function never yields; 'async' is for I/O-concurrent work only
