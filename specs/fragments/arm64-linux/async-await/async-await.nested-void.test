// Test: async-await.nested-void
typealias Integer = int(i64.min to i64.max)

var flag = 0

function setFlag()
		_ = File.exists(FilePath from "noyield.txt")
		flag = 1
end 'setFlag'

function bump() returns Integer
		let p = async setFlag()
		await p
		return flag + 40
end 'bump'

function main() returns ExitCode
		let q = async bump()
		return await q
end 'main'
