// Test: keyword-prefix-ident
function main() returns ExitCode
	let function2 = 5
	return function2 - 5
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
