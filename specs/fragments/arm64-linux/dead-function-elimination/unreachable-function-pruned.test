// Test: unreachable-function-pruned
typealias Integer = int(i64.min to i64.max)

function unusedHelper(x Integer) returns Integer
	return x * 3
end 'unusedHelper'

function main() returns ExitCode
	return 7
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
