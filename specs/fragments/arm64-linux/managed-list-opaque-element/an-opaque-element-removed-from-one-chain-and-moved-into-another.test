    arm64.b.lt __rc_panic#11
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic#4
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Bag_String
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  tryerr:
    arm64.leaRdata x0, __str_blob_4  ; "panic at an-opaque-element-removed-from-one-chain-and-moved-into-another.test:33: shift\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
