// Test: an-opaque-element-removed-from-one-chain-and-moved-into-another
typealias Count = int(0 to u64.max)

type Bag uses Element
	typealias EChain = List with Element
	var chain as EChain
	var spare as EChain

	export static function create() returns Self
		return Self{chain: EChain.create(), spare: EChain.create()}
	end 'create'

	export function add(v Element)
		self.chain.append(v)
	end 'add'

	export function shift() throws ArrayError
		let moved = try self.chain.removeFirst()
		self.spare.append(moved)
	end 'shift'

	export function total() returns Count
		return self.chain.count() + self.spare.count()
	end 'total'
end 'Bag'

typealias StringBag = Bag with String

function main() returns ExitCode
	var b = StringBag.create()
	b.add("alpha")
	b.add("beta")
	try b.shift() otherwise panic("shift")
	return b.total() as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Bag.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl List.append
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @Bag.shift {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movRegReg x1, x20
    arm64.bl List.removeFirst
    arm64.movRegReg x1, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movRegReg x2, x20
    arm64.bl List.append
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __layout_Bag_String
  __il_body#7:
    arm64.movRegReg x0, x19
    arm64.bl List.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl List.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
    arm64.storeBaseDispReg.word64 [x21 + 8], x19
  __il_cont:
    arm64.leaRdata x0, __str_rec_2  ; "alpha"
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x23, x20
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl Bag.add
    arm64.leaRdata x0, __str_rec_3  ; "beta"
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x23, x20
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl Bag.add
    arm64.leaRdata x1, __layout_Bag_String
    arm64.movRegReg x0, x21
    arm64.bl Bag.shift
    arm64.cmp x9, 0
    arm64.b.ne tryerr
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.bl List.count
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
