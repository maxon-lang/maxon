// Test: a-type-parameter-names-no-declaration
// --- file: api/lib.maxon
export typealias Tally = int(0 to 100)

export type Box uses T
	export var item as T

	export static function create(item T) returns Self
		return Self{item: item}
	end 'create'

	export function get() returns T
		return self.item
	end 'get'
end 'Box'

// --- file: app/main.maxon
typealias TallyBox = Box with Tally

function main() returns ExitCode
	let b = TallyBox.create(11)
	return b.get() as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 11
  __il_body#3:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#2:
    arm64.leaRdata x0, __layout_Box_Tally
  __il_body#4:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.bl __retain_type_param
    arm64.movRegReg x19, x0
  __il_cont#1:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
