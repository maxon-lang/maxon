// Test: builtins-mm-counters.total-is-never-below-live
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var buf = ByteArray.create()
	buf.push(1)
	let total = __Builtins.mmAllocTotal()
	let live = __Builtins.mmAllocLive()
	let rawTotal = __Builtins.mmRawAllocTotal()
	let rawLive = __Builtins.mmRawAllocLive()
	var score = 0
	if total >= live 'trackedInvariant'
		score = score + 1
	end 'trackedInvariant'
	if rawTotal >= rawLive 'rawInvariant'
		score = score + 2
	end 'rawInvariant'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.bl __mm_counter_alloc_total
    arm64.movRegReg x20, x0
    arm64.bl __mm_counter_alloc_live
    arm64.movRegReg x21, x0
    arm64.bl __mm_counter_raw_alloc_total
    arm64.movRegReg x22, x0
    arm64.bl __mm_counter_raw_alloc_live
    arm64.movImm x1, 0
    arm64.cmp x20, x21
    arm64.b.lt ifcont
  trackedInvariant:
    arm64.movImm x1, 1
  ifcont:
    arm64.cmp x22, x0
    arm64.b.lt critsplit
  rawInvariant:
    arm64.add x20, x1, 2
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x20, x1
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
