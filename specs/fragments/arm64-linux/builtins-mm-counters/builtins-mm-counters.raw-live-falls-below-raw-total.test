// Test: builtins-mm-counters.raw-live-falls-below-raw-total
typealias Integer = int(i64.min to i64.max)

type Counter
	var calls as Integer

	static function create() returns Self
		return Self{calls: 0}
	end 'create'

	export function next(n Integer) returns Integer
		self.calls = self.calls + 1

		return n + 1
	end 'next'
end 'Counter'

function main() returns ExitCode
	let c = spawn Counter.create()
	let a = try await c.next(1) otherwise 0
	let total = __Builtins.mmRawAllocTotal()
	let live = __Builtins.mmRawAllocLive()
	var score = a
	if total > 0 'somethingToCompare'
		score = score + 1
	end 'somethingToCompare'
	if live < total 'theDeliveredEnvelopeWentBack'
		score = score + 4
	end 'theDeliveredEnvelopeWentBack'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __mm_alloc_total@8 = i64 0
  __mm_alloc_bytes@16 = i64 0
  __mm_raw_alloc_count@24 = i64 0
  __mm_raw_live_count@32 = i64 0
  __mm_raw_alloc_bytes@40 = i64 0
  __gt_run_queue_head@48 = i64 0
  __gt_run_queue_tail@56 = i64 0
  __gt_init_done@64 = i64 0
  __gt_timer_count@72 = i64 0
  __gt_timer_heap_base@80 = i64 0
  __gt_timer_capacity@88 = i64 0
  __gt_timer_seq@96 = i64 0
  __gt_trace_counter@104 = i64 0
  __gt_proc_count@112 = i64 0
  __gt_proc_handles_base@120 = i64 0
  __gt_proc_gts_base@128 = i64 0
  __gt_proc_wait_snapshot@136 = i64 0
  __gt_proc_poller@144 = i64 0
  __gt_live_count@152 = i64 0
  __sched_progress@160 = i64 0
  __sched_active_workers@168 = i64 1
  __sched_max_active_workers@176 = i64 1
  __sched_tls_index@184 = i64 0
  __sched_tls_teb_offset@192 = i64 0
  __sched_procs@200 = i64 0
  __sched_allm@208 = i64 0
  __sched_midle@216 = i64 0
  __sched_pidle@224 = i64 0
  __gt_gfree_head@232 = i64 0
  __sched_num_procs@240 = i64 0
  __sched_shutdown_flag@248 = i64 0
  __sched_lock@256 = i64 0
  __sched_nmspinning@264 = i64 0
  __sched_parked_drivers@272 = i64 0
  __sched_sysmon_started@280 = i64 0
  __mrt_errno@288 = i64 0
  __mrt_envp@296 = i64 0
  __mrt_tls_next_key@304 = i64 0
  __slab_arena_list@312 = i64 0
  __slab_arena_map_l1@320 = i64 0
  __slab_state@328 = i64 0
}

func @Counter.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Counter.create
    arm64.movRegReg x1, x0
    arm64.leaFuncAddr x0, Counter.__loop
    arm64.leaFuncAddr x2, Counter.__abandon
    arm64.bl __svc_spawn
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movImm x19, 1
    arm64.movImm x0, 0
    arm64.bl __gt_cell_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.storeBaseDispReg.word64 [x1 + 16], x21
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.bl __mbox_send
    arm64.movRegReg x0, x21
    arm64.bl __gt_try_await
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
  trycont:
    arm64.bl __mm_counter_raw_alloc_total
    arm64.movRegReg x21, x0
    arm64.bl __mm_counter_raw_alloc_live
    arm64.cmp x21, 0
    arm64.b.le critsplit#11
  somethingToCompare:
    arm64.add x1, x19, 1
    arm64.b ifcont#5
  critsplit#11:
    arm64.movRegReg x1, x19
  ifcont#5:
    arm64.cmp x0, x21
    arm64.b.ge critsplit#12
  theDeliveredEnvelopeWentBack:
    arm64.add x19, x1, 4
    arm64.b ifcont#7
  critsplit#12:
    arm64.movRegReg x19, x1
  ifcont#7:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at builtins-mm-counters.raw-live-falls-below-raw-total.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_handle_drop_box
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Counter.__loop {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
  serve:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.cmp x0, 0
    arm64.b.eq stopping
  dispatch:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.jumpTable x1, default=stopping [[0]=__shutdown, [1]=next] @__jumptable_1
  __shutdown:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.storeBaseDispReg.word64 [x20 + 56], x1
    arm64.bl __mm_decref
  stopping:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_close
  drain:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x1, x0
    arm64.cmp x1, 0
    arm64.b.ne abandon
  finished:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mbox_service_exit
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  abandon:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_abandon
    arm64.b drain
  next:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 16]
  __il_body:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.add x2, x2, 1
    arm64.storeBaseDispReg.word64 [x19 + 0], x2
    arm64.add x22, x1, 1
  __il_cont:
    arm64.bl __mm_decref
    arm64.movImm x2, 0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __gt_cell_complete
    arm64.b serve
}

func @Counter.__abandon {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.jumpTable x0, default=abandondrop [[0]=__shutdown, [1]=next] @__jumptable_2
  __shutdown:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.bl __gt_cell_complete
    arm64.b abandondrop
  next:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.bl __gt_cell_complete
  abandondrop:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
