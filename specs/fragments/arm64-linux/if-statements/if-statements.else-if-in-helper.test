// Test: if-statements.else-if-in-helper

typealias Integer = int(i64.min to i64.max)

function classify(x Integer) returns Integer
	if x == 0 'zero'
		return 0
	end 'zero' else if x < 10 'small'
		return 1
	end 'small' else if x < 100 'medium'
		return 2
	end 'medium' else 'large'
		return 3
	end 'large'
end 'classify'

function main() returns ExitCode
	let a = classify(0)
	let b = classify(5)
	let c = classify(50)
	let d = classify(200)
	return a + b * 3 + c * 9 + d * 27
end 'main'
---
ExitCode: 102
---
func @main {
  entry:
    arm64.prologue 16
  small:
    arm64.movImm x0, 1
  medium:
    arm64.movImm x1, 2
  ifelse:
    arm64.movImm x2, 3
  __il_cont:
    arm64.arm64AddLsl x0, x0, x0, lsl #1
    arm64.arm64AddLsl x1, x1, x1, lsl #3
    arm64.add x0, x0, x1
    arm64.movImm x16, 27
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
