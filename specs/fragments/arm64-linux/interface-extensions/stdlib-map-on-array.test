    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 5
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.leaFuncAddr x1, main$closure_0
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Array_int
    arm64.movRegReg x0, x19
    arm64.bl Array.map
    arm64.movImm x20, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
  forhdr:
    arm64.cmp x1, x2
    arm64.b.ge forexit
  loop:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x20, x20, x4
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at stdlib-map-on-array.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
