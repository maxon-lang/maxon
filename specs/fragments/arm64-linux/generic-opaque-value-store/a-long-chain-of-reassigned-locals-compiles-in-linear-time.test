// Test: a-long-chain-of-reassigned-locals-compiles-in-linear-time
type Cell uses T
	export var v as T

	static function chain(v T) returns Self
		var a0 = v
		a0 = v
		var a1 = a0
		a1 = a0
		var a2 = a1
		a2 = a1
		var a3 = a2
		a3 = a2
		var a4 = a3
		a4 = a3
		var a5 = a4
		a5 = a4
