		var a22 = a21
		a22 = a21
		var a23 = a22
		a23 = a22
		var a24 = a23
		a24 = a23
		return Self{v: a24}
	end 'chain'
end 'Cell'

typealias StrCell = Cell with String

function main() returns ExitCode
	let c = StrCell.chain("payload")
	print("{c.v}\n")
	return 0
end 'main'
