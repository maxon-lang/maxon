// Test: unrelated-self-field-stays-writable
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

type Bag
	export var items as IntArray
	export var seen as Int

	static function create() returns Self
		var a = IntArray.create()
		a.push(5)
		a.push(7)
		return Self{items: a, seen: 0}
	end 'create'

	function sum() returns Int
		var total = 0
		for it in self.items 'scan'
			seen = seen + 1
			total = total + it
		end 'scan'
		return total + seen
	end 'sum'
end 'Bag'

function main() returns ExitCode
	var b = Bag.create()
	return b.sum() as ExitCode
end 'main'
---
ExitCode: 14
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#6:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 7
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x20, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __il_body#7:
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.movImm x2, 0
    arm64.b forhdr
  scan:
    arm64.loadRegBaseDisp.word64 x3, [x1 + 0]
    arm64.loadRegBaseIndexScale.word64 x3, [x3 + x2*8 + 0]
  __im_cont:
    arm64.loadRegBaseDisp.word64 x4, [x21 + 8]
    arm64.add x4, x4, 1
    arm64.storeBaseDispReg.word64 [x21 + 8], x4
    arm64.add x0, x0, x3
  forstep:
    arm64.add x2, x2, 1
  forhdr:
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.cmp x2, x3
    arm64.b.lt scan
  forexit:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.add x19, x0, x1
  __il_cont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Bag
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at unrelated-self-field-stays-writable.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
