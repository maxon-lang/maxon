// Test: tuple-assign-in-loop
typealias Integer = int(i64.min to i64.max)

function step(n Integer) returns (Integer, Integer)
	return (n + 1, n * 2)
end 'step'

function main() returns ExitCode
	var a = 0
	var b = 0
	var i = 0
	while i < 3 'loop'
		(a, b) = step(a)
		i = i + 1
	end 'loop'
	return b
end 'main'
---
ExitCode: 4
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.b whilehdr
  __il_body:
    arm64.add x1, x0, 1
    arm64.lsl x0, x0, 1
  __il_cont:
    arm64.add x2, x2, 1
    arm64.xchgRegReg x0, x1
  whilehdr:
    arm64.cmp x2, 3
    arm64.b.lt __il_body
  whileexit:
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at tuple-assign-in-loop.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
