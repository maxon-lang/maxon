// Test: the-count-reaches-a-chained-call
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

extension Vector
	export function dup() returns Self
		return Self{}
	end 'dup'

	export function capacity() returns Int
		return countof(Self)
	end 'capacity'

	export function chained() returns Int
		return self.dup().capacity()
	end 'chained'
end 'Vector'

function main() returns ExitCode
	var v = Vec3.create()
	return v.chained()
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x19, 3
  __il_body#5:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_resize
  __il_cont#4:
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x19, 3
  __il_body#10:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __managed_resize
  __il_cont#8:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
