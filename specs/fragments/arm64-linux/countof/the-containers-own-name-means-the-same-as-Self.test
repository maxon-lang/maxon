// Test: the-containers-own-name-means-the-same-as-Self
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

extension Vector
	export function byName() returns Int
		return countof(Vector)
	end 'byName'
end 'Vector'

function main() returns ExitCode
	var v = Vec3.create()
	return v.byName()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x19, 3
  __il_body:
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_resize
  __il_cont:
    arm64.movImm x19, 3
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
