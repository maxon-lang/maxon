// Test: the-count-reaches-a-Self-typed-parameter
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

extension Vector
	export function capacity() returns Int
		return countof(Self)
	end 'capacity'

	export function pairWith(other Self) returns Int
		return other.capacity()
	end 'pairWith'
end 'Vector'

function main() returns ExitCode
	var a = Vec3.create()
	var b = Vec3.create()
	return a.pairWith(b)
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
  __rc_ok:
    arm64.movImm x20, 3
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
