// Test: map-literal-with-enum-values
enum TokenKind
	Function
	Var
end 'TokenKind'

function main() returns ExitCode
	let keywords = ["function": TokenKind.Function, "var": TokenKind.Var]
	let kind = try keywords.get("function") otherwise TokenKind.Var
	match kind 'match'
		Function then return 1
		Var then return 2
	end 'match'
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
