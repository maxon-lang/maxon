// Test: iteration.large-list
typealias Integer = int(i64.min to i64.max)
typealias IntList = List with Integer

function main() returns ExitCode
	var list = IntList.create()
	for i in 1 to 100 'build'
		list.append(i)
	end 'build'
	var sum = 0
	for item in list 'loop'
		sum = sum + item
	end 'loop'
	return sum - 5050
end 'main'
---
ExitCode: 0
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_List_Integer
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 40]
    arm64.bl __list_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont:
    arm64.movImm x19, 1
    arm64.b forhdr#1
  build:
    arm64.leaRdata x2, __layout_List_Integer
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl List.append
  forstep#3:
    arm64.add x19, x19, 1
  forhdr#1:
    arm64.cmp x19, 100
    arm64.b.le build
  forexit#4:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl List.createIterator
    arm64.movRegReg x21, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.eq forhdr#5
    arm64.b forempty
  loop:
    arm64.leaRdata x1, __layout_ListIterator_Integer
    arm64.movRegReg x0, x21
    arm64.bl ListIterator.current
    arm64.add x19, x19, x0
  forstep#8:
    arm64.movRegReg x0, x21
    arm64.bl ListIterator.advance
    arm64.movRegReg x0, x9
  forhdr#5:
    arm64.cmp x0, 0
    arm64.b.eq loop
  forexit#9:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_ListIterator_Integer
    arm64.movRegReg x0, x19
    arm64.b forjoin
  forempty:
    arm64.movRegReg x0, x19
  forjoin:
    arm64.sub x19, x0, 5050
    arm64.movRegReg x0, x20
    arm64.bl __destruct_List_Integer
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at iteration.large-list.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
