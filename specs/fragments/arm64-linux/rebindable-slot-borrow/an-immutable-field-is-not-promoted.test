// Test: an-immutable-field-is-not-promoted
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Frozen
	let items as IntArray

	export static function create() returns Self
		var a = IntArray.create()
		a.push(4)
		a.push(5)
		return Self{items: a}
	end 'create'

	export function total() returns Integer
		let held = items

		var sum = 0
		for i in 0 upto held.count() 'walk'
			sum = sum + (try held.get(i) otherwise 0)
		end 'walk'
		return sum
	end 'total'
end 'Frozen'

function main() returns ExitCode
	var f = Frozen.create()
	return f.total() as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#6:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movImm x19, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
  __us_test:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b forhdr
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x3, [x0 + x1*8 + 0]
  trycont:
    arm64.add x19, x19, x3
  forstep:
    arm64.add x1, x1, 1
  forhdr:
    arm64.cmp x1, x2
    arm64.b.lt __im_load
  __il_cont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Frozen
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at an-immutable-field-is-not-promoted.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
