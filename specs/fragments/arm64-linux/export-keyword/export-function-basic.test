// Test: export-function-basic
// --- file: api/lib.maxon
typealias Integer = int(i64.min to i64.max)

export function helper() returns Integer
	return 21
end 'helper'

// --- file: app/main.maxon
function main() returns ExitCode
	return helper() + helper()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 21
  __il_cont:
    arm64.add x0, x0, 21
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
