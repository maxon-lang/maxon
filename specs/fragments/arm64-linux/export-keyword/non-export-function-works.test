// Test: non-export-function-works

typealias Integer = int(i64.min to i64.max)

function helper() returns Integer
	return 42
end 'helper'

function main() returns ExitCode
	return helper()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
