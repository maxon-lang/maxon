// Test: default-panic.enum-range-expression
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.mul
	let result = match op 'eval'
		add or
			sub gives 1
		mul gives 2
		default panic("unexpected op")
	end 'eval'
	return result
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.cmp x0, 0
    arm64.cset x1, ge
    arm64.cmp x0, 1
    arm64.cset x2, le
    arm64.and x1, x1, x2
    arm64.cbz x1, matchnext
  matcharm#1:
    arm64.movImm x0, 1
    arm64.b __rc_ok
  matchnext:
    arm64.cmp x0, 2
    arm64.b.ne matchdefault
  matcharm#2:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at default-panic.enum-range-expression.test:17: unexpected op\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
