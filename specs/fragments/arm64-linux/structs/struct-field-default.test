// Test: struct-field-default
type Counter
	export var value = 0
	export var step = 1

	static function create() returns Self
		return Self{}
	end 'create'

	static function create(value CounterValue, step CounterStep) returns Self
		return Self{value: value, step: step}
	end 'create'
end 'Counter'

typealias CounterValue = int(0 to u64.max)
typealias CounterStep = int(0 to u64.max)

function main() returns ExitCode
	let c1 = Counter.create()
	let c2 = Counter.create(40, step: 1)
	let c3 = Counter.create(10, step: 2)
	return c1.value + c2.value + c3.step
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.create#CounterValue#CounterStep {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#2
  __rc_ok#1:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic#4
  __rc_ok#3:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_1  ; "panic at struct-field-default.test:10: Range check failed: value outside typealias 'CounterValue'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_2  ; "panic at struct-field-default.test:10: Range check failed: value outside typealias 'CounterStep'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x19, 0
  __il_cont:
    arm64.movImm x0, 40
    arm64.movImm x1, 1
    arm64.bl Counter.create#CounterValue#CounterStep
    arm64.movRegReg x20, x0
    arm64.movImm x0, 10
    arm64.movImm x1, 2
    arm64.bl Counter.create#CounterValue#CounterStep
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.add x1, x19, x1
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at struct-field-default.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
