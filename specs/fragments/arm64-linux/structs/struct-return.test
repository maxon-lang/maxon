// Test: struct-return

typealias Integer = int(i64.min to i64.max)

type Pair
	export var first as Integer
	export var second as Integer

	static function create(first Integer, second Integer) returns Self
		return Self{first: first, second: second}
	end 'create'
end 'Pair'

function makePair(a Integer, b Integer) returns Pair
	return Pair.create(a, second: b)
end 'makePair'

function main() returns ExitCode
	let p = makePair(5, b: 7)
	return p.first + p.second
end 'main'
---
ExitCode: 12
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.movImm x1, 7
  __il_cont:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at struct-return.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
