// Test: nested-calls
function zero() returns Integer
	return 7
end 'zero'

function inc(x Integer) returns Integer
	return x + 1
end 'inc'

function main() returns ExitCode
	return inc(inc(inc(zero())))
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 10
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
