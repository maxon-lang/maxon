// Test: unknown-function-result-assigned-to-a-struct-variable
type Box
	export var n = 0

	static function create() returns Box
		return Box{}
	end 'create'
end 'Box'

function main() returns ExitCode
	var b = Box.create()
	b = frobnicate(2)
	return b.n as ExitCode
end 'main'
