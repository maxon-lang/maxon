// Test: console-stdin.repeat-reads-at-eof-are-idempotent
function main() returns ExitCode
	var stdin = Console.stdin()
	var thrown = 0
	var i = 0
	while i < 3 'again'
		let line = try stdin.readLine() otherwise 'atEof'
			thrown = thrown + 1
			i = i + 1
			continue
		end 'atEof'
		print(line)
		return 1
	end 'again'
	return thrown as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mrt_errno@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#14:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.byte [x21 + 8], x20
  __il_cont#11:
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  again:
    arm64.movRegReg x0, x21
    arm64.bl Stdin.readLine
    arm64.movRegReg x22, x0
    arm64.cmp x9, 0
    arm64.b.eq __il_body#10
  tryerr:
    arm64.add x19, x19, 1
    arm64.add x20, x20, 1
  whilehdr:
    arm64.cmp x20, 3
    arm64.b.lt again
    arm64.b whileexit
  __il_body#10:
    arm64.movRegReg x0, x22
    arm64.bl __write_stdout
  __il_cont#9:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_12  ; "panic at console-stdin.repeat-reads-at-eof-are-idempotent.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
