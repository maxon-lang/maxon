// Test: console-stdin.read-line-at-eof-throws
function main() returns ExitCode
	var stdin = Console.stdin()
	let line = try stdin.readLine() otherwise 'atEof'
		return 9
	end 'atEof'
	print(line)
	return 1
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __mrt_errno@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#8:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.byte [x21 + 8], x20
  __il_cont#5:
    arm64.movRegReg x0, x21
    arm64.bl Stdin.readLine
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq __il_body#4
  tryerr:
    arm64.movImm x19, 9
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __il_body#4:
    arm64.movRegReg x0, x19
    arm64.bl __write_stdout
  __il_cont#3:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
