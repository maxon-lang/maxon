// Test: if-else-block-before-later-sibling

typealias Integer = int(i64.min to i64.max)

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function branchy(x Integer) returns Integer
		if x > 0 'pos'
			return helper() + 1
		end 'pos' else 'neg'
			return helper()
		end 'neg'
	end 'branchy'

	function helper() returns Integer
		return 5
	end 'helper'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.branchy(1)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.branchy {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.b.le __il_body#7
  __il_body#5:
    arm64.movImm x0, 5
  __il_cont#4:
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
  __il_body#7:
    arm64.movImm x0, 5
  __il_cont#6:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 1
    arm64.bl Box.branchy
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at if-else-block-before-later-sibling.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
