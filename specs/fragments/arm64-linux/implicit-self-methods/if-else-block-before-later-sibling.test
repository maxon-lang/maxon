// Test: if-else-block-before-later-sibling

typealias Integer = int(i64.min to i64.max)

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function branchy(x Integer) returns Integer
		if x > 0 'pos'
			return helper() + 1
		end 'pos' else 'neg'
			return helper()
		end 'neg'
	end 'branchy'

	function helper() returns Integer
		return 5
	end 'helper'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.branchy(1)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body#6:
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#12:
    arm64.movImm x1, 5
  __il_cont:
    arm64.add x19, x1, 1
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
