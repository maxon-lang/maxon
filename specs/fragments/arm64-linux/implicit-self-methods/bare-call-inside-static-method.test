// Test: bare-call-inside-static-method

typealias Integer = int(i64.min to i64.max)

type Maker
	export var n as Integer

	static function mk() returns Integer
		return 7
	end 'mk'

	static function build() returns Integer
		return mk() + 1
	end 'build'
end 'Maker'

function main() returns ExitCode
	return Maker.build()
end 'main'
---
ExitCode: 8
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 7
  __il_cont:
    arm64.add x0, x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
