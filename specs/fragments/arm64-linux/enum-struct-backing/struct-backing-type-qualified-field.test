// Test: struct-backing-type-qualified-field
typealias W = int(0 to 50)

type Spec
	export let width as W
end 'Spec'

enum Preset
	small = Spec{width: 3}
	large = Spec{width: 9}
end 'Preset'

function main() returns ExitCode
	return Preset.large.width
end 'main'
---
ExitCode: 9
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9
    arm64.epilogue 16
    arm64.ret
}
