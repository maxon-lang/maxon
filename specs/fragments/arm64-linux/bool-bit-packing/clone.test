    arm64.cmp x9, 0
    arm64.b.eq tryok#18
  tryerr#19:
    arm64.leaRdata x0, __str_blob_1  ; "panic at Array.maxon:172: Array.clone: slice OOB \xe2\x80\x94 0..len is always valid\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
