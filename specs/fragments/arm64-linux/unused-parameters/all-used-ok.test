// Test: all-used-ok

typealias Integer = int(i64.min to i64.max)

function add(a Integer, b Integer) returns Integer
	return a + b
end 'add'

function main() returns ExitCode
	return add(5, b: 10)
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 15
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
