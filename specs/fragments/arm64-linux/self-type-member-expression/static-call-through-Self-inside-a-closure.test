// Test: static-call-through-Self-inside-a-closure
typealias Num = int(0 to 1000)

type Gate
	export var n as Num

	static function make(v Num) returns Gate
		return Self{n: v}
	end 'make'

	static function dbl(v Num) returns Num
		return v + v
	end 'dbl'

	function viaClosure() returns Num
		let f = function(v Num) gives Self.dbl(v)
		return f(21)
	end 'viaClosure'
end 'Gate'

function main() returns ExitCode
	return Gate.make(1).viaClosure()
end 'main'
