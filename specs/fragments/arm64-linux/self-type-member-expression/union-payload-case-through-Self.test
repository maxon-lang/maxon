// Test: union-payload-case-through-Self
typealias Num = int(0 to 100)

union Res
	ok(v Num)
	none

	export function bump() returns Res
		return Self.ok(42)
	end 'bump'

	export function blank() returns Res
		return Self.none
	end 'blank'
end 'Res'

function main() returns ExitCode
	let r = Res.none
	let s = r.bump()
	let t = s.blank()
	return match t 'blanked'
		ok gives 1
		none gives match s 'bumped'
			ok(v) gives v
			none gives 2
		end 'bumped'
	end 'blanked'
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body#16:
    arm64.movImm x0, 42
    arm64.movImm x1, 0
  __il_body#17:
    arm64.movImm x2, 1
  __il_cont:
    arm64.cmp x2, 0
    arm64.b.ne matchnext#9
  matcharm#1:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext#9:
    arm64.cmp x2, 1
    arm64.b.ne matchdead#8
  matcharm#2:
    arm64.cmp x1, 0
    arm64.b.eq matchcont
  matchnext#6:
    arm64.cmp x1, 1
    arm64.b.ne matchdead#5
  matcharm#4:
    arm64.movImm x0, 2
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead#5:
  matchdead#8:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at union-payload-case-through-Self.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
