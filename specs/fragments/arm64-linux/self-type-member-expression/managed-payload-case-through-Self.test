    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movRegReg x0, x19
    arm64.bl Msg.shout
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
    arm64.cmp x22, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x21
    arm64.bl String.byteLength
    arm64.movRegReg x22, x0
  __il_cont:
    arm64.cmp x22, 0
    arm64.b.lt __rc_panic#7
  __rc_chk#8:
    arm64.cmp x22, 255
    arm64.b.le __rc_ok#6
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_2  ; "panic at managed-payload-case-through-Self.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok#6:
