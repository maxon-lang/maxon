func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_17  ; "nonexistent_path_12345"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Directory.isDirectory
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.cbz x20, ifcont
  check:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
