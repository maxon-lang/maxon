// Test: reassign-within-class
function main() returns ExitCode
	var flag = true
	var n = 5

	if n > 0 'pos'
		flag = false
		n = n * 2
	end 'pos'

	if flag 'stillTrue'
		return 99
	end 'stillTrue'

	if n == 10 'doubled'
		return 1
	end 'doubled'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  doubled:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
