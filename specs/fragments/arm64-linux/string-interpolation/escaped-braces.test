// Test: escaped-braces
function main() returns ExitCode
	print("Use \{expr\} for interpolation")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "Use {expr} for interpolation"
  __il_body:
    arm64.bl __write_stdout
  __il_cont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
