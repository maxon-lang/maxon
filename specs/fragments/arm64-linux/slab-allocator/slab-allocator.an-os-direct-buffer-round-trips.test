// Test: slab-allocator.an-os-direct-buffer-round-trips
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Round = int(0 to 255)

function roundTrip(r Round) returns Integer
	var big = ByteArray.create()
	big.reserve(300000)
	for i in 0 upto 512 'fill'
		big.push(((r + i) mod 251) as Byte)
	end 'fill'

	var wrong = 0
	for i in 0 upto 512 'check'
		let got = try big.get(i) otherwise return 1
		if (got as Round) != ((r + i) mod 251) 'value'
			wrong = wrong + 1
		end 'value'
	end 'check'
	return wrong
end 'roundTrip'

function main() returns ExitCode
	var bad = 0
	for r in 0 upto 64 'rounds'
		bad = bad + roundTrip(r as Round)
	end 'rounds'

	if bad != 0 'corrupted'
		return 3
	end 'corrupted'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  __rc_ok#21:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 300000
  __rc_ok#41:
    arm64.movRegReg x0, x21
    arm64.bl __managed_capacity
    arm64.movImm x16, 300000
    arm64.cmp x0, x16
    arm64.b.ge __il_cont#35
  grow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __managed_mem_grow
    arm64.cmp x9, 0
    arm64.b.eq __il_cont#35
  tryerr#39:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:415: Array.reserve: grow failed \xe2\x80\x94 minCapacity > cap guaranteed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
  __il_cont#35:
    arm64.movImm x22, 0
    arm64.b forhdr#9
  fill:
    arm64.add x0, x20, x22
    arm64.movImm x1, 251
    arm64.udiv x16, x0, x1
    arm64.msub x1, x16, x1, x0
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.gt __rc_panic
  __rc_ok#24:
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
  forstep#11:
    arm64.add x22, x22, 1
  forhdr#9:
    arm64.cmp x22, 512
    arm64.b.lt fill
  forexit#12:
    arm64.movImm x22, 0
    arm64.movImm x23, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x24, [x21 + 24]
    arm64.loadRegBaseDisp.word64 x25, [x21 + 8]
    arm64.loadRegBaseDisp.word64 x26, [x21 + 0]
    arm64.b forhdr#13
  check:
    arm64.cmp x24, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.cmp x23, x25
    arm64.b.hs __im_slow
  __im_load#33:
    arm64.loadRegBaseIndexScale.word64 x0, [x26 + x23*8 + 0]
    arm64.b tryok
  __im_stride:
    arm64.cmp x24, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.cmp x23, x25
    arm64.b.hs __im_slow
  __im_load#34:
    arm64.add x0, x26, x23
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b tryok
  __im_slow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x23
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#18:
    arm64.movImm x22, 1
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.b __il_cont#7
  tryok:
    arm64.add x1, x20, x23
    arm64.movImm x2, 251
    arm64.udiv x16, x1, x2
    arm64.msub x1, x16, x2, x1
    arm64.cmp x0, x1
    arm64.b.eq critsplit
  value:
    arm64.add x0, x22, 1
    arm64.b forstep#15
  critsplit:
    arm64.movRegReg x0, x22
  forstep#15:
    arm64.add x23, x23, 1
    arm64.movRegReg x22, x0
  forhdr#13:
    arm64.cmp x23, 512
    arm64.b.lt check
  forexit#16:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
  __il_cont#7:
    arm64.add x19, x19, x0
  forstep#3:
    arm64.add x20, x20, 1
  forhdr#1:
    arm64.cmp x20, 64
    arm64.b.lt __rc_ok#21
  forexit#4:
    arm64.cmp x19, 0
    arm64.b.eq ifcont
  corrupted:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at slab-allocator.an-os-direct-buffer-round-trips.test:10: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
}
