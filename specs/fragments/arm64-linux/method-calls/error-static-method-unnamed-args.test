// Test: error-static-method-unnamed-args

typealias Integer = int(i64.min to i64.max)

type Factory
	static function create(x Integer, y Integer) returns Integer
		return x * 10 + y
	end 'create'
end 'Factory'

function main() returns ExitCode
	return Factory.create(4, 2)
end 'main'
---
CompilerError:
error E2053: <fragment>:12:27: the second and later arguments must be named ('name: value')
