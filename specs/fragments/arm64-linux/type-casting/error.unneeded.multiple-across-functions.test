// Test: error.unneeded.multiple-across-functions

typealias Byte = int(0 to u8.max)

function first(b Byte) returns Byte
	let x = b as Byte
	return x
end 'first'

function second(b Byte) returns Byte
	let y = b as Byte
	return y
end 'second'

function main() returns ExitCode
	let a = 1 as Byte
	let b = first(a)
	let c = second(b)
	return c
end 'main'
---
CompilerError:
error E3010: <fragment>:6:12: unneeded cast: 'Byte' already fits in 'Byte'
error E3010: <fragment>:11:12: unneeded cast: 'Byte' already fits in 'Byte'
