// Test: a-literal-cast-to-a-same-named-alias-from-another-file-is-not-unneeded
// --- file: a.maxon
export typealias Item = int(0 to 255)

export function put(x Item) returns ExitCode
	return x
end 'put'

// --- file: main.maxon
typealias Item = int(0 to 200)

function main() returns ExitCode
	return put(5 as Item)
end 'main'
---
ExitCode: 5
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok:
    arm64.movImm x0, 5
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
