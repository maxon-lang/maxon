// Test: literal-casts-that-together-pick-the-overload-are-not-unneeded
typealias Real = float(0.0 to 100.0)
typealias Integer = int(i64.min to i64.max)

function pick(a Real, b Real) returns ExitCode
	if a + b > 0.0 'positive'
		return 1
	end 'positive'
	return 3
end 'pick'

function pick(a Integer, b Integer) returns ExitCode
	if a + b > 0 'positive'
		return 2
	end 'positive'
	return 4
end 'pick'

function main() returns ExitCode
	return pick(1 as Real, b: 2 as Real)
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  positive:
    arm64.movImm x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
