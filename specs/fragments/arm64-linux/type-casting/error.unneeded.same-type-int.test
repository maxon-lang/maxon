// Test: error.unneeded.same-type-int

typealias Integer = int(i64.min to i64.max)

function identity(x Integer) returns Integer
	return x
end 'identity'

function main() returns ExitCode
	let x = identity(42)
	let y = x as Integer
	return y
end 'main'
---
CompilerError:
error E3010: <fragment>:11:12: unneeded cast: 'Integer' already fits in 'Integer'
