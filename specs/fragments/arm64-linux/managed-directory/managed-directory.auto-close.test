func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  whilehdr:
    arm64.cmp x19, 200
    arm64.b.ge whileexit
  loop:
    arm64.leaRdata x0, __str_rec_1  ; "./*"
    arm64.bl String.toByteArray
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __md_open_search
    arm64.movRegReg x21, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#4
  tryerr#5:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#4:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.bl __md_next
    arm64.cmp x9, 0
    arm64.b.eq tryok#6
  tryerr#7:
    arm64.movImm x19, 2
    arm64.movRegReg x0, x21
    arm64.bl __md_destruct
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
