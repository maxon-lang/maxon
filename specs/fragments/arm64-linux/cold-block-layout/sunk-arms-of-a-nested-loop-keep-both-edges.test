// Test: sunk-arms-of-a-nested-loop-keep-both-edges
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function grid(a WordArray, rows Word, width Word) returns Word
	var t = 0
	for r in 0 upto rows 'row'
		var line = 0
		for c in 0 upto width 'col'
			line = line + (try a.get(r * width + c) otherwise 100)
		end 'col'
		t = t + line * (r + 1)
	end 'row'
	return t
end 'grid'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 7 'seed'
		a.push(i)
	end 'seed'
	return grid(a, rows: 3, width: 3) - 600
end 'main'
---
ExitCode: 45
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x20
    arm64.storeSlotReg slot6, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep#3:
    arm64.add x20, x20, 1
  forhdr#1:
    arm64.cmp x20, 7
    arm64.b.lt seed
  __il_body:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.b forhdr#10
  row:
    arm64.movImm x4, 0
    arm64.movImm x5, 0
    arm64.b forhdr#14
  col:
    arm64.arm64AddLsl x6, x1, x1, lsl #1
    arm64.add x6, x6, x5
  __rc_ok#21:
    arm64.cmp x6, x2
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x6, 100
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x6, [x3 + x6*8 + 0]
  trycont:
    arm64.add x4, x4, x6
  forstep#16:
    arm64.add x5, x5, 1
  forhdr#14:
    arm64.cmp x5, 3
    arm64.b.lt col
  forexit:
    arm64.add x1, x1, 1
    arm64.mul x4, x4, x1
    arm64.add x0, x0, x4
  forhdr#10:
    arm64.cmp x1, 3
    arm64.b.lt row
  __il_cont:
    arm64.sub x20, x0, 600
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok#5:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot6
    arm64.loadRegSlot x20, slot7
    arm64.epilogue 80
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, x5
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x6
    arm64.bl __managed_get
    arm64.movRegReg x6, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot x5, slot5
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at sunk-arms-of-a-nested-loop-keep-both-edges.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot6
    arm64.loadRegSlot x20, slot7
    arm64.epilogue 80
    arm64.ret
}
