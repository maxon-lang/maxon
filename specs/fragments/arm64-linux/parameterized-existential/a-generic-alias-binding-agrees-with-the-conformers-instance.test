    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-generic-alias-binding-agrees-with-the-conformers-instance.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
