func @makeValue {
  entry:
    arm64.prologue 16
    arm64.bl Scheduler.yield
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}

func @peek {
  entry:
    arm64.prologue 16
    arm64.bl __gt_is_complete
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, makeValue
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl peek
    arm64.movRegReg x20, x0
