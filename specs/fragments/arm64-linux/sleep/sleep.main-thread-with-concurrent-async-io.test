func @probe {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  forhdr:
    arm64.cmp x19, 20
    arm64.b.ge forexit
  each:
    arm64.leaRdata x0, __str_rec_19  ; "noyield.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl File.exists
    arm64.movRegReg x0, x20
    arm64.bl __destruct_FilePath
  forstep:
    arm64.add x19, x19, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x0, 7
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

