// Test: ternary-expression.basic-true
function main() returns ExitCode
	let x = 10 if true else 20
	return x
end 'main'
---
ExitCode: 10
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ternarytrue:
    arm64.movImm x0, 10
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
