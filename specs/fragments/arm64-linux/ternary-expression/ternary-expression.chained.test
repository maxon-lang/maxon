// Test: ternary-expression.chained
function main() returns ExitCode
	let a = false
	let b = true
	let x = 1 if a else 2 if b else 3
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  ternarytrue:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
