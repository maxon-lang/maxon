// Test: ternary-expression.with-variable-condition
function main() returns ExitCode
	let flag = true
	let x = 1 if flag else 0
	return x
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  ternarytrue:
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
