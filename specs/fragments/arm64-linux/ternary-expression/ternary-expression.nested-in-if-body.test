// Test: ternary-expression.nested-in-if-body
function main() returns ExitCode
	var total = 0
	let c = true
	if c 'g'
		let x = 5 if c else 9
		total = total + x
	end 'g'
	return total
end 'main'
---
ExitCode: 5
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ternarytrue:
    arm64.movImm x0, 5
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
