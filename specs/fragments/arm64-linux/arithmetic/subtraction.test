// Test: subtraction
function main() returns ExitCode
	return 20-8
end 'main'
---
ExitCode: 12
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 12
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
