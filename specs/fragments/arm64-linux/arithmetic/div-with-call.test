// Test: div-with-call

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function helper(x Integer) returns Integer
	return x * 2
end 'helper'

function divCall(a Integer, b NonZero) returns Integer
	let temp = trunc(try (a / (b as Integer)) otherwise panic("b is never zero"))
	let result = helper(temp)
	return result + temp
end 'divCall'

function main() returns ExitCode
	return divCall(10, b: 2)
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
  __rc_ok#8:
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 10
    arm64.asr x0, x0, 1
  __il_body:
    arm64.lsl x1, x0, 1
  __il_cont:
    arm64.add x0, x1, x0
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
