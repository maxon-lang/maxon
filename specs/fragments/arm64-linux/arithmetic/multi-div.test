// Test: multi-div

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function multiDiv(a Integer, b NonZero, c Integer, d NonZero) returns Integer
	let r1 = try (a / (b as Integer)) otherwise panic("b is never zero")
	let r2 = try (c / (d as Integer)) otherwise panic("d is never zero")
	return trunc(r1 + r2)
end 'multiDiv'

function main() returns ExitCode
	return multiDiv(10, b: 2, c: 20, d: 4)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 20
  divok#7:
    arm64.movImm x2, 0
    arm64.orr x2, x2, 2
    arm64.sdiv x0, x0, x2
  divok#11:
    arm64.asr x1, x1, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 20
    arm64.asr x1, x1, 2
  tryok:
    arm64.add x0, x0, x1
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at multi-div.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
