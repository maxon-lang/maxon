// Test: multi-div

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function multiDiv(a Integer, b NonZero, c Integer, d NonZero) returns Integer
	let r1 = try (a / (b as Integer)) otherwise panic("b is never zero")
	let r2 = try (c / (d as Integer)) otherwise panic("d is never zero")
	return trunc(r1 + r2)
end 'multiDiv'

function main() returns ExitCode
	return multiDiv(10, b: 2, c: 20, d: 4)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 20
  __rc_ok#12:
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 10
    arm64.asr x0, x0, 1
  tryok#6:
    arm64.asr x1, x1, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 20
    arm64.asr x1, x1, 2
  tryok#8:
    arm64.add x0, x0, x1
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
