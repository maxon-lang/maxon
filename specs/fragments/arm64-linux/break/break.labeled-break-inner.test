// Test: break.labeled-break-inner
function main() returns ExitCode
	var x = 0
	var y = 0
	while x < 5 'outer'
		x = x + 1
		while y < 10 'inner'
			y = y + 1
			if y == 3 'check'
				break
			end 'check'
		end 'inner'
	end 'outer'
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr#1
  outer:
    arm64.add x0, x0, 1
    arm64.b whilehdr#4
  inner:
    arm64.add x1, x1, 1
    arm64.cmp x1, 3
    arm64.b.eq whilehdr#1
  whilehdr#4:
    arm64.cmp x1, 10
    arm64.b.lt inner
  whilehdr#1:
    arm64.cmp x0, 5
    arm64.b.lt outer
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at break.labeled-break-inner.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
