// Test: a-loop-at-the-pools-edge-keeps-its-registers
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function viaArray(a WordArray, n Word) returns Word
	var a0 = 1
	var a1 = 2
	var a2 = 3
	var a3 = 4
	var a4 = 5
	var a5 = 6
	var a6 = 7
	var a7 = 8
	var a8 = 9
	var t = 0
	for i in 0 upto n 'each'
		a0 = a0 + i
		a1 = a1 xor a0
		a2 = a2 + a1
		a3 = a3 xor a2
		a4 = a4 + a3
		a5 = a5 xor a4
		a6 = a6 + a5
		a7 = a7 xor a6
		a8 = a8 + a7
		let e = try a.get(i) otherwise 99
		t = t + e + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8
	end 'each'
	return t
end 'viaArray'

function reference(n Word) returns Word
	var a0 = 1
	var a1 = 2
	var a2 = 3
	var a3 = 4
	var a4 = 5
	var a5 = 6
	var a6 = 7
	var a7 = 8
	var a8 = 9
	var t = 0
	for i in 0 upto n 'each'
		a0 = a0 + i
		a1 = a1 xor a0
		a2 = a2 + a1
		a3 = a3 xor a2
		a4 = a4 + a3
		a5 = a5 xor a4
		a6 = a6 + a5
		a7 = a7 xor a6
		a8 = a8 + a7
		let e = i if i < 6 else 99
		t = t + e + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8
	end 'each'
	return t
end 'reference'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 6 'seed'
		a.push(i)
	end 'seed'
	return 0 if viaArray(a, n: 12) == reference(12) else 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @viaArray {
  entry:
    arm64.prologue 144
    arm64.storeSlotReg slot15, x19
    arm64.movImm x2, 1
    arm64.movImm x3, 2
    arm64.movImm x4, 3
    arm64.movImm x5, 4
    arm64.movImm x6, 5
    arm64.movImm x7, 6
    arm64.movImm x8, 7
    arm64.movImm x9, 8
    arm64.movImm x10, 9
    arm64.movImm x11, 0
    arm64.movImm x12, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x13, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x14, [x0 + 0]
  forhdr:
    arm64.cmp x12, x1
    arm64.b.ge forexit
  each:
    arm64.add x2, x2, x12
    arm64.eor x3, x3, x2
    arm64.add x4, x4, x3
    arm64.eor x5, x5, x4
    arm64.add x6, x6, x5
    arm64.eor x7, x7, x6
    arm64.add x8, x8, x7
    arm64.eor x9, x9, x8
    arm64.add x10, x10, x9
  __rc_ok:
    arm64.cmp x12, x13
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x15, 99
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x15, [x14 + x12*8 + 0]
  trycont:
    arm64.add x11, x11, x15
    arm64.add x11, x11, x2
    arm64.add x11, x11, x3
    arm64.add x11, x11, x4
    arm64.add x11, x11, x5
    arm64.add x11, x11, x6
    arm64.add x11, x11, x7
    arm64.add x11, x11, x8
    arm64.add x11, x11, x9
    arm64.add x11, x11, x10
  forstep:
    arm64.add x12, x12, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x11
    arm64.loadRegSlot x19, slot15
    arm64.epilogue 144
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, x5
    arm64.storeSlotReg slot6, x6
    arm64.storeSlotReg slot7, x7
    arm64.storeSlotReg slot8, x8
    arm64.storeSlotReg slot9, x9
    arm64.storeSlotReg slot10, x10
    arm64.storeSlotReg slot11, x11
    arm64.storeSlotReg slot12, x12
    arm64.storeSlotReg slot13, x13
    arm64.storeSlotReg slot14, x14
    arm64.movRegReg x1, x12
    arm64.bl __managed_get
    arm64.movRegReg x15, x0
    arm64.movRegReg x19, x9
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot x5, slot5
    arm64.loadRegSlot x6, slot6
    arm64.loadRegSlot x7, slot7
    arm64.loadRegSlot x8, slot8
    arm64.loadRegSlot x9, slot9
    arm64.loadRegSlot x10, slot10
    arm64.loadRegSlot x11, slot11
    arm64.loadRegSlot x12, slot12
    arm64.loadRegSlot x13, slot13
    arm64.loadRegSlot x14, slot14
    arm64.cmp x19, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @reference {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 1
    arm64.movImm x2, 2
    arm64.movImm x3, 3
    arm64.movImm x4, 4
    arm64.movImm x5, 5
    arm64.movImm x6, 6
    arm64.movImm x7, 7
    arm64.movImm x8, 8
    arm64.movImm x9, 9
    arm64.movImm x10, 0
    arm64.movImm x11, 0
  forhdr:
    arm64.cmp x11, x0
    arm64.b.ge forexit
  each:
    arm64.add x1, x1, x11
    arm64.eor x2, x2, x1
    arm64.add x3, x3, x2
    arm64.eor x4, x4, x3
    arm64.add x5, x5, x4
    arm64.eor x6, x6, x5
    arm64.add x7, x7, x6
    arm64.eor x8, x8, x7
    arm64.add x9, x9, x8
    arm64.cmp x11, 6
    arm64.b.ge ternaryfalse
  ternarytrue:
    arm64.movRegReg x12, x11
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x12, 99
  matchcont:
    arm64.add x10, x10, x12
    arm64.add x10, x10, x1
    arm64.add x10, x10, x2
    arm64.add x10, x10, x3
    arm64.add x10, x10, x4
    arm64.add x10, x10, x5
    arm64.add x10, x10, x6
    arm64.add x10, x10, x7
    arm64.add x10, x10, x8
    arm64.add x10, x10, x9
  forstep:
    arm64.add x11, x11, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x10
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 6
    arm64.b.ge forexit
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x1, 12
    arm64.movRegReg x0, x19
    arm64.bl viaArray
    arm64.movRegReg x20, x0
    arm64.movImm x0, 12
    arm64.bl reference
    arm64.cmp x20, x0
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x20, 0
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x20, 1
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
