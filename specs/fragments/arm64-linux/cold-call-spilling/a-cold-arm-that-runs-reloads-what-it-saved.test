// Test: a-cold-arm-that-runs-reloads-what-it-saved
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function walk(a WordArray, n Word) returns Word
	var t = 0
	var w = 1
	for i in 0 upto n 'each'
		w = w * 3 + i
		t = t + (try a.get(i) otherwise 99) + w
	end 'each'
	return t
end 'walk'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 5 'seed'
		a.push(i)
	end 'seed'
	if walk(a, n: 9) != 37285 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @walk {
  entry:
    arm64.prologue 80
    arm64.movImm x2, 0
    arm64.movImm x3, 1
    arm64.movImm x4, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x5, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 0]
  forhdr:
    arm64.cmp x4, x1
    arm64.b.ge forexit
  each:
    arm64.arm64AddLsl x3, x3, x3, lsl #1
    arm64.add x3, x3, x4
  __rc_ok:
    arm64.cmp x4, x5
    arm64.b.hs __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x7, 99
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseIndexScale.word64 x7, [x6 + x4*8 + 0]
  trycont:
    arm64.add x2, x2, x7
    arm64.add x2, x2, x3
  forstep:
    arm64.add x4, x4, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x2
    arm64.epilogue 80
    arm64.ret
  __im_slow:
    arm64.storeSlotReg slot0, x0
    arm64.storeSlotReg slot1, x1
    arm64.storeSlotReg slot2, x2
    arm64.storeSlotReg slot3, x3
    arm64.storeSlotReg slot4, x4
    arm64.storeSlotReg slot5, x5
    arm64.storeSlotReg slot6, x6
    arm64.movRegReg x1, x4
    arm64.bl __managed_get
    arm64.movRegReg x7, x0
    arm64.loadRegSlot x0, slot0
    arm64.loadRegSlot x1, slot1
    arm64.loadRegSlot x2, slot2
    arm64.loadRegSlot x3, slot3
    arm64.loadRegSlot x4, slot4
    arm64.loadRegSlot x5, slot5
    arm64.loadRegSlot x6, slot6
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b trycont
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 5
    arm64.b.ge forexit
  seed:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x1, 9
    arm64.movRegReg x0, x19
    arm64.bl walk
    arm64.movImm x16, 37285
    arm64.cmp x0, x16
    arm64.b.eq ifcont
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
