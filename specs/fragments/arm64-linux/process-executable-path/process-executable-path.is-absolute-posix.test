// Test: process-executable-path.is-absolute-posix
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	var score = 0
	if exe.path.byteLength() > 1 'longerThanTheRoot'
		score = score + 1
	end 'longerThanTheRoot'
	if exe.path.startsWith("/") 'rootQualified'
		score = score + 2
	end 'rootQualified'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Process.executablePath
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movImm x20, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  __il_cont#14:
    arm64.cmp x0, 1
    arm64.b.ls ifcont#4
  longerThanTheRoot:
    arm64.movImm x20, 1
  ifcont#4:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.leaRdata x2, __str_rec_16  ; "/"
  __il_body#18:
    arm64.loadRegBaseDisp.word64 x4, [x2 + 8]
  __il_body#19:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#16:
    arm64.cmp x4, x1
    arm64.b.ls ifcont#13
  tooLong:
    arm64.movImm x0, 0
    arm64.b __il_cont#10
  ifcont#13:
    arm64.movImm x1, 0
    arm64.movImm x3, 0
    arm64.bl bytesEqual
  __il_cont#10:
    arm64.cbz x0, __rc_ok
  rootQualified:
    arm64.add x20, x20, 2
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
