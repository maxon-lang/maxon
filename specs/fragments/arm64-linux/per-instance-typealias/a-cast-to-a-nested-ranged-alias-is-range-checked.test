// Test: a-cast-to-a-nested-ranged-alias-is-range-checked
typealias Integer = int(i64.min to i64.max)

type Holder
	typealias Small = int(0 to 10)

	var unused as bool

	static function create() returns Holder
		return Holder{unused: false}
	end 'create'

	function narrow(n Integer) returns Integer
		let small = n as Small
		return small
	end 'narrow'
end 'Holder'

function main() returns ExitCode
	let holder = Holder.create()
	print("{holder.narrow(50)}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.byte [x0 + 0], x19
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-cast-to-a-nested-ranged-alias-is-range-checked.test:14: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
