// Test: cross-file-extension-declares-the-ranged-member
// --- file: a.maxon
typealias Num = int(0 to 200)

export type Holder
	export var v as Num

	export static function create(v Num) returns Holder
		return Holder{v: v}
	end 'create'
end 'Holder'

extension Holder
	typealias Idx = int(0 to 100)

	export function fromA(i Idx) returns Num
		return self.v + i
	end 'fromA'
end 'Holder'

// --- file: b.maxon
extension Holder
	export function fromB(i Idx) returns Num
		return self.v + i
	end 'fromB'
end 'Holder'

// --- file: main.maxon
function main() returns ExitCode
	let h = Holder.create(1)
	let total = h.fromA(3) + h.fromB(30)
	if total == 35 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x1, x1, 3
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#12
  __rc_chk#13:
    arm64.cmp x1, 200
    arm64.b.gt __rc_panic#12
  __il_body#14:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 30
    arm64.cmp x2, 0
    arm64.b.lt __rc_panic#16
  __rc_chk#17:
    arm64.cmp x2, 200
    arm64.b.gt __rc_panic#16
  __il_cont:
    arm64.add x1, x1, x2
    arm64.cmp x1, 35
    arm64.b.ne ifcont
  ok:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic#12:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a.maxon:15: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic#16:
    arm64.leaRdata x0, __str_blob_3  ; "panic at b.maxon:3: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
