// Test: mixed-default-and-literal

typealias Integer = int(i64.min to i64.max)

type Mixed
	export var a = 10
	export var b as Integer

	export static function make(b Integer) returns Self
		return Self{b: b}
	end 'make'
end 'Mixed'

function main() returns ExitCode
	let m = Mixed.make(32)
	return m.a + m.b
end 'main'
---
ExitCode: 42
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 32
  __il_body:
    arm64.movImm x1, 10
  __il_cont:
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at mixed-default-and-literal.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
