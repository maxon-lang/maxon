    arm64.bl __gt_spawn
    arm64.movRegReg x25, x0
    arm64.storeBaseDispReg.word64 [x25 + 200], x19
    arm64.storeBaseDispReg.word64 [x25 + 208], x20
    arm64.storeBaseDispReg.word64 [x25 + 216], x21
    arm64.storeBaseDispReg.word64 [x25 + 224], x22
    arm64.storeBaseDispReg.word64 [x25 + 232], x23
    arm64.storeBaseDispReg.word64 [x25 + 240], x24
    arm64.movRegReg x0, x25
    arm64.bl __gt_ready
