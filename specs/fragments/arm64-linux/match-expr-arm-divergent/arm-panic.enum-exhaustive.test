// Test: arm-panic.enum-exhaustive
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.blue
	let result = match c 'eval'
		red panic("no red")
		green gives 1
		blue gives 2
	end 'eval'
	return result
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
