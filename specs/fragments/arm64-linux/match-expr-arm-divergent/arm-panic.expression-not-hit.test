// Test: arm-panic.expression-not-hit
function main() returns ExitCode
	let x = 3
	let result = match x 'eval'
		1 panic("not one")
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 30
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 30
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
