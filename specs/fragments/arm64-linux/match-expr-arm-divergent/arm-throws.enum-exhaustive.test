// Test: arm-throws.enum-exhaustive
enum Color
	red
	green
	blue
end 'Color'

enum E
	rejected
end 'E'

function classify(c Color) returns ExitCode throws E
	let result = match c 'eval'
		red throws E.rejected
		green gives 1
		blue gives 2
	end 'eval'
	return result
end 'classify'

function main() returns ExitCode
	let r = try classify(Color.green) otherwise 99
	return r
end 'main'
---
ExitCode: 1
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 2
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movImm x0, 2
  matchcont:
    arm64.movImm x9, 0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at arm-throws.enum-exhaustive.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl classify
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 99
  trycont:
    arm64.epilogue 16
    arm64.ret
}
