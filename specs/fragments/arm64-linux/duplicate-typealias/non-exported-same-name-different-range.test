// Test: non-exported-same-name-different-range
// --- file: a.maxon
typealias Limit = int(0 to 500)

export function clampA(x Limit) returns Limit
	return x
end 'clampA'

// --- file: b.maxon
typealias Limit = int(0 to 2000)

export function clampB(x Limit) returns Limit
	return x
end 'clampB'

// --- file: main.maxon
function main() returns ExitCode
	let a = clampA(40)
	let b = clampB(60)
	return a + b
end 'main'
---
ExitCode: 100
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 40
  __il_cont:
    arm64.add x0, x0, 60
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
