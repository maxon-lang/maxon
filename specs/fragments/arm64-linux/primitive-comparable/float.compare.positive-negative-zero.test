// Test: float.compare.positive-negative-zero
function main() returns ExitCode
	let pos = 0.0
	let neg = -0.0
	let result = pos.compare(neg)
	match result 'check'
		lessThan then return 1
		equalTo then return 0
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
