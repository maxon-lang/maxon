// Test: float.compare.nan-less-than-normal
function main() returns ExitCode
	// NaN from overflow (inf - inf), NOT `0.0 / 0.0` — a literal zero divisor is now a compile
	// error and a runtime one throws DivisionByZero. Overflow and inf - inf stay silent.
	let inf = 1.0e308 * 10.0
	let nan = inf - inf
	let x = 42.0
	let result = nan.compare(x)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0x7ff0000000000000]
    arm64.fsub d0, d0, d0
    arm64.fpLoadRdata d1, [rdata + __fconst_42]
  __il_body:
    arm64.fcmp d0, d0
    arm64.b.eq ifcont#15
  ifcont#12:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#15:
    arm64.fcmp d0, d1
    arm64.b.pl ifcont#17
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#17:
    arm64.fcmp d0, d1
    arm64.b.le ifcont#19
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#19:
    arm64.movImm x0, 1
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext#6:
    arm64.cmp x0, 2
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
