// Test: byte.compare.less

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let a = 10 as Byte
	let b = 20 as Byte
	let result = a.compare(b)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
