// Test: int.compare.greater
function main() returns ExitCode
	let a = 20
	let b = 10
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 1
		greaterThan then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
