// Test: atan2.positive-x-axis
function main() returns ExitCode
	let angle = Math.atan2(0.0, x: 1.0)
	if angle == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  ifcont#14:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
  tryok:
    arm64.bl Math.atan
  __il_cont:
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.b.ne ifcont#2
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
