// Test: match-statements.try-otherwise-ignore
enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally)
	match kind 'k'
		1 then try leaf() otherwise ignore
		default panic("unreachable")
	end 'k'
end 'dispatch'

typealias Tally = int(0 to 100)

function main() returns ExitCode
	dispatch(1)
	return 0
end 'main'
---
ExitCode: 0
---
func @leaf {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @dispatch {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at match-statements.try-otherwise-ignore.test:10: Range check failed: value outside typealias 'Tally'\x0a"
    arm64.bl mrt_panic
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 1
    arm64.b.ne matchdefault
  matcharm:
    arm64.bl leaf
    arm64.cmp x9, 0
    arm64.b.ne matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-statements.try-otherwise-ignore.test:13: unreachable\x0a"
    arm64.bl mrt_panic
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl dispatch
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
