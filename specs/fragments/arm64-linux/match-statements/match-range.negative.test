// Test: match-range.negative
function main() returns ExitCode
	let x = -5
	match x 'check'
		-10 to -1 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
