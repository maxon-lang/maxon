  __il_body#7:
    arm64.movImm x2, 0
    arm64.cmp x0, 0
    arm64.b.eq __il_cont#6
  matchnext#12:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#11
  matcharm#10:
    arm64.movRegReg x2, x1
  __il_cont#6:
    arm64.movImm x0, 42
    arm64.movImm x1, 1
  __il_body#14:
    arm64.movImm x3, 0
    arm64.cmp x1, 0
    arm64.b.eq __il_cont#5
  matchnext#19:
    arm64.cmp x1, 1
    arm64.b.ne matchdead#18
  matcharm#17:
    arm64.movRegReg x3, x0
  __il_cont#5:
    arm64.cmp x2, 0
    arm64.movImm x0, 0
    arm64.b.ne scmerge
  andrhs:
    arm64.cmp x3, 42
    arm64.cset x0, eq
  scmerge:
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead#18:
  matchdead#11:
  afterbreak#9:
