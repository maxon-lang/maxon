// Test: match-break.managed-string-live-across
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'loop'
		let s = "abc"
		match i 'check'
			1 then break
			default then total = total + s.byteLength()
		end 'check'
		total = total + 1
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 9
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  loop:
    arm64.leaRdata x2, __str_rec_1  ; "abc"
    arm64.cmp x1, 1
    arm64.b.eq matchcont
  __il_body:
    arm64.loadRegBaseDisp.word64 x2, [x2 + 8]
  __il_cont:
    arm64.add x0, x0, x2
  matchcont:
    arm64.add x0, x0, 1
    arm64.add x1, x1, 1
  whilehdr:
    arm64.cmp x1, 3
    arm64.b.lt loop
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at match-break.managed-string-live-across.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
