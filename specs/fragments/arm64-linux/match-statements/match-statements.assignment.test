// Test: match-statements.assignment
function main() returns ExitCode
	let x = 2
	var result = 0
	match x 'process'
		1 then result = 60
		2 then result = 120
		default then result = 0
	end 'process'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 120
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-statements.assignment.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
