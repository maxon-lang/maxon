// Test: match-statements.try-otherwise-default
enum Err implements Error
	bad
end 'Err'

typealias Tally = int(0 to 100)
typealias Score = int(0 to 100)

function leaf() returns Score throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) returns Score
	match kind 'k'
		1 then return try leaf() otherwise 42
		default panic("unreachable")
	end 'k'
end 'dispatch'

function main() returns ExitCode
	return dispatch(1)
end 'main'
---
ExitCode: 42
---
func @leaf {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.bl leaf
    arm64.cmp x9, 0
    arm64.b.eq __il_cont
  tryerr:
    arm64.movImm x0, 42
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
