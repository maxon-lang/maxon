// Test: match-statements.nested-in-function

typealias Integer = int(i64.min to i64.max)

function categorize(n Integer) returns Integer
	match n 'cat'
		1 or
			2 or
			3 then return 1
		4 or
			5 or
			6 then return 2
		default then return 0
	end 'cat'
end 'categorize'

function main() returns ExitCode
	return categorize(5)
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
