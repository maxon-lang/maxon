// Test: match-statements.or-patterns-second
function main() returns ExitCode
	let x = 2
	match x 'check'
		1 or
			2 then return 10
		3 or
			4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 10
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 10
    arm64.epilogue 16
    arm64.ret
}
