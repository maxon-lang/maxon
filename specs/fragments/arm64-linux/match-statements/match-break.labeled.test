// Test: match-break.labeled
function main() returns ExitCode
	var result = 0
	match 3 'outer'
		1 then result = 10
		2 then result = 20
		3 then break 'outer'
		default then result = 99
	end 'outer'
	return result
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
