// Test: module-struct-receiver-is-the-record-not-its-first-field
typealias Tag = int(0 to 1000)

type Inner
	export var n as Tag = 5
	export static function create() returns Inner
		return Self{}
	end 'create'
	export function value() returns Tag
		return self.n
	end 'value'
end 'Inner'

type Outer
	export var inner as Inner = Inner.create()
	export var extra as Tag = 100
	export static function create() returns Outer
		return Self{}
	end 'create'
	export function value() returns Tag
		return (self.inner.value() + self.extra) as Tag
	end 'value'
end 'Outer'

let G = Outer.create()

function main() returns ExitCode
	print("value={G.value()}")
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __data_G@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Inner.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Outer.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl __fieldDefault#Outer#inner
    arm64.movRegReg x19, x0
    arm64.movImm x20, 100
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Outer.value {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  __il_cont:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at module-struct-receiver-is-the-record-not-its-first-field.test:21: Range check failed: value outside typealias 'Tag'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 80
