// Test: a-co-owned-payload-moved-out-of-a-sole-box-is-still-co-owned
typealias Integer = int(i64.min to i64.max)

union Inner
	text(body String)
end 'Inner'

union Wrap
	held(i Inner)
end 'Wrap'

function probe(inner Inner) returns Integer
	let w = Wrap.held(inner)
	return match w 'o'
		held(i) gives match i 'n'
			text(body) gives body.byteLength()
		end 'n'
	end 'o'
end 'probe'

function main() returns ExitCode
	let inner = Inner.text("a co-owned payload inside a sole box, long enough for the heap")
	let n = probe(inner)
	let again = match inner 'k'
		text(body) gives body.byteLength()
	end 'k'
	print("n={n} again={again}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @probe {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchdead#5
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchdead#3
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
    arm64.cmp x22, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x21
    arm64.bl String.byteLength
    arm64.movRegReg x22, x0
  __il_cont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
  matchcont#4:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Inner
  matchcont#6:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Wrap
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  matchdead#3:
  matchdead#5:
}

func @main {
  entry:
    arm64.prologue 112
    arm64.storeSlotReg slot11, x28
    arm64.storeSlotReg slot10, x27
    arm64.storeSlotReg slot9, x26
    arm64.storeSlotReg slot8, x25
    arm64.storeSlotReg slot7, x24
    arm64.storeSlotReg slot6, x23
    arm64.storeSlotReg slot5, x22
    arm64.storeSlotReg slot4, x21
    arm64.storeSlotReg slot3, x20
    arm64.storeSlotReg slot2, x19
    arm64.leaRdata x19, __str_rec_3  ; "a co-owned payload inside a sole box, long enough for the heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeSlotReg slot0, x20
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl probe
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x21 + 8]
    arm64.cmp x20, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x21
    arm64.bl String.byteLength
    arm64.movRegReg x20, x0
  __il_cont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
  matchcont:
    arm64.leaRdata x0, __str_rec_4  ; "n="
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
