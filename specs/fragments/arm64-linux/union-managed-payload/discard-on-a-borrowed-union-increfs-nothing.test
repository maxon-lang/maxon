// Test: discard-on-a-borrowed-union-increfs-nothing
typealias Integer = int(i64.min to i64.max)

union Message
	silent
	text(body String, code Integer)
end 'Message'

function codeOf(m Message) returns Integer
	return match m 'k'
		silent gives 0
		text(_, tag) gives tag
	end 'k'
end 'codeOf'

function main() returns ExitCode
	let m = Message.text("a discarded payload string long enough to be a heap one", code: 4)
	let a = codeOf(m)
	let b = codeOf(m)
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a discarded payload string long enough to be a heap one"
    arm64.movImm x20, 4
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.storeBaseDispReg.word64 [x21 + 16], x20
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#10
  matcharm#7:
    arm64.movImm x0, 0
    arm64.b __il_body#12
  matchnext#10:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#9
  matcharm#8:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 16]
  __il_body#12:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext#16
  matcharm#13:
    arm64.movImm x1, 0
    arm64.b __il_cont
  matchnext#16:
    arm64.cmp x1, 1
    arm64.b.ne matchdead#15
  matcharm#14:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 16]
  __il_cont:
    arm64.add x19, x0, x1
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at discard-on-a-borrowed-union-increfs-nothing.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Message
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead#15:
  matchdead#9:
}
