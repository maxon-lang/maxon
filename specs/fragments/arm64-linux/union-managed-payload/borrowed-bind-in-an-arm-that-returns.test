// Test: borrowed-bind-in-an-arm-that-returns
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer
	match m 'k'
		silent then return 0
		text(s) then print(s)
	end 'k'
	return 3
end 'show'

function main() returns ExitCode
	let m = M.text("a returned-arm payload string, long enough to be a real heap allocation")
	return show(m) as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a returned-arm payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body#5:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#6:
    arm64.movImm x19, 0
    arm64.b __rc_ok
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#7:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_body#12:
    arm64.movRegReg x0, x19
    arm64.bl __write_stdout
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
  matchcont:
    arm64.movImm x19, 3
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
