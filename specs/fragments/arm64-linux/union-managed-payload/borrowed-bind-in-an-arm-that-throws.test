// Test: borrowed-bind-in-an-arm-that-throws
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 1000)

enum Boom implements Error
	bad
end 'Boom'

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer throws Boom
	var seen = 0 as Integer
	match m 'k'
		text(s) then seen = s.byteLength() and fallthrough
		silent then throw Boom.bad
	end 'k'
	return 3 if seen > 0 else 0
end 'show'

function main() returns ExitCode
	let m = M.text("a thrown-arm payload string, long enough to be a real heap allocation")
	var i = 0 as Round
	var n = 0 as Integer
	while i < 200 'spin'
		n = try show(m) otherwise 4
		i = i + 1
	end 'spin'
	return n as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @show {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.cmp x2, 0
    arm64.b.eq matcharm#2
  matchnext:
    arm64.cmp x2, 1
    arm64.b.ne matchdead
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x1, x20
  matcharm#2:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont#5:
    arm64.cmp x1, 0
    arm64.b.le ternaryfalse
  ternarytrue:
    arm64.movImm x0, 3
    arm64.b matchcont#8
  ternaryfalse:
    arm64.movImm x0, 0
  matchcont#8:
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a thrown-arm payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x19, 0
    arm64.movImm x21, 0
    arm64.b whilehdr
  spin:
    arm64.movRegReg x0, x20
    arm64.bl show
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 4
  trycont:
    arm64.add x19, x19, 1
    arm64.movRegReg x21, x0
  whilehdr:
    arm64.cmp x19, 200
    arm64.b.lt spin
  whileexit:
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at borrowed-bind-in-an-arm-that-throws.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
