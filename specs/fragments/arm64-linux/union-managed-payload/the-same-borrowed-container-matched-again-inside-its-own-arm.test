// Test: the-same-borrowed-container-matched-again-inside-its-own-arm
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function depth(m M) returns Integer
	return match m 'k'
		silent gives 0
		text(s) gives match m 'again'
			silent gives 1
			text(t) gives 6 if t.byteLength() > 0 and s.byteLength() > 0 else 0
		end 'again'
	end 'k'
end 'depth'

function main() returns ExitCode
	let m = M.text("a re-entrantly matched payload string, long enough for the heap")
	return depth(m) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a re-entrantly matched payload string, long enough for the heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body#5:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#19
  matcharm#6:
    arm64.movImm x19, 0
    arm64.b __rc_ok
  matchnext#19:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#18
  matcharm#7:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#16
  matcharm#8:
    arm64.movImm x21, 1
    arm64.b matchcont#17
  matchnext#16:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#15
  matcharm#9:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
  __il_body#22:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
  __il_cont#21:
    arm64.cmp x0, 0
    arm64.movImm x0, 0
    arm64.b.ls scmerge
  __il_body#24:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
  __il_cont#23:
    arm64.cmp x0, 0
    arm64.cset x0, hi
  scmerge:
    arm64.cbz x0, ternaryfalse
  ternarytrue:
    arm64.movImm x22, 6
    arm64.b matchcont#14
  ternaryfalse:
    arm64.movImm x22, 0
  matchcont#14:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x21, x22
  matchcont#17:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x19, x21
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  matchdead#15:
  matchdead#18:
}
