// Test: borrowed-bind-in-an-arm-that-breaks
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 100)

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer
	var i = 0 as Round
	var seen = 0 as Integer
	while i < 10 'spin'
		match m 'k'
			text(s) then seen = s.byteLength() and fallthrough
			silent then break 'spin'
		end 'k'
		i = i + 1
	end 'spin'
	return 5 if seen > 0 else 0
end 'show'

function main() returns ExitCode
	let m = M.text("a broken-arm payload string, long enough to be a real heap allocation")
	return show(m) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a broken-arm payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body#5:
    arm64.movImm x0, 0
  spin:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.cmp x1, 0
    arm64.b.eq whileexit
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_body#18:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
  whileexit:
    arm64.cmp x0, 0
    arm64.b.le ternaryfalse
  ternarytrue:
    arm64.movImm x19, 5
    arm64.b __rc_ok
  ternaryfalse:
    arm64.movImm x19, 0
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}
