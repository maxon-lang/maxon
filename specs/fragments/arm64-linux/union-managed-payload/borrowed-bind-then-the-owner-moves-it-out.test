  matcharm#2:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x19 + 8], x1
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.bl __mm_decref
