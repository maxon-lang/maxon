// Test: owned-move-out-and-borrowed-retain-in-one-function
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function mixed(borrowed M) returns Integer
	let owned = M.text("a locally built payload string long enough for the heap")
	let a = match owned 'o'
		silent gives 0
		text(s) gives 1 if s.byteLength() > 0 else 0
	end 'o'
	let b = match borrowed 'b'
		silent gives 0
		text(t) gives 2 if t.byteLength() > 0 else 0
	end 'b'
	return a + b
end 'mixed'

function main() returns ExitCode
	let m = M.text("the caller's payload string, long enough to be a real heap allocation")
	return mixed(m) as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_3  ; "the caller's payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
  __il_body#5:
    arm64.leaRdata x19, __str_rec_2  ; "a locally built payload string long enough for the heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#12
  matcharm#6:
    arm64.movImm x19, 0
    arm64.b matchcont#13
  matchnext#12:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#11
  matcharm#7:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x21 + 8], x1
  __il_body#23:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#22:
    arm64.cmp x1, 0
    arm64.b.ls ternaryfalse#9
  ternarytrue#8:
    arm64.movImm x19, 1
    arm64.b matchcont#10
  ternaryfalse#9:
    arm64.movImm x19, 0
  matchcont#10:
    arm64.bl __str_decref
  matchcont#13:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#20
  matcharm#14:
    arm64.movImm x0, 0
    arm64.b matchcont#21
  matchnext#20:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#19
  matcharm#15:
    arm64.loadRegBaseDisp.word64 x22, [x20 + 8]
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
  __il_body#25:
    arm64.loadRegBaseDisp.word64 x0, [x22 + 8]
  __il_cont#24:
    arm64.cmp x0, 0
    arm64.b.ls ternaryfalse#17
  ternarytrue#16:
    arm64.movImm x23, 2
    arm64.b matchcont#18
  ternaryfalse#17:
    arm64.movImm x23, 0
  matchcont#18:
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x23
  matchcont#21:
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_M
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  matchdead#19:
  matchdead#11:
}
