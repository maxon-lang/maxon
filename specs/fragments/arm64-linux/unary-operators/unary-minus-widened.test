// Test: unary-minus-widened
function base() returns ExitCode
	return 5
end 'base'

function main() returns ExitCode
	let r = base()
	return -r + 12
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 5
  __il_cont:
    arm64.neg x0, x0
    arm64.add x0, x0, 12
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at unary-minus-widened.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
