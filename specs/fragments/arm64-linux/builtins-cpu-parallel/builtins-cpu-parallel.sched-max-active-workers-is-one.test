// Test: builtins-cpu-parallel.sched-max-active-workers-is-one
function main() returns ExitCode
	let workers = __Builtins.schedMaxActiveWorkers()
	var score = 0
	if workers >= 1 'contractFloor'
		score = score + 1
	end 'contractFloor'
	if workers == 1 'singleM'
		score = score + 2
	end 'singleM'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __sched_active_workers@0 = i64 1
  __sched_max_active_workers@8 = i64 1
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl __sched_max_active_workers
    arm64.movImm x1, 0
    arm64.cmp x0, 1
    arm64.b.lt ifcont
  contractFloor:
    arm64.movImm x1, 1
  ifcont:
    arm64.cmp x0, 1
    arm64.b.ne critsplit
  singleM:
    arm64.add x0, x1, 2
    arm64.b __rc_ok
  critsplit:
    arm64.movRegReg x0, x1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
