// Test: assign-widening-byte-to-int

typealias Byte = int(0 to u8.max)
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var i = 0 as Integer
	let b = 7 as Byte
	i = b as Integer
	return i as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
