// Test: assign-struct-to-same-struct

typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function makePoint(v Integer) returns Point
	return Point.create(v, y: v)
end 'makePoint'

function main() returns ExitCode
	var p = Point.create(1, y: 2)
	p = makePoint(7)
	p.x = 9
	let q = Point.create(5, y: 5)
	p = q
	return p.x as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x21
    arm64.storeSlotReg slot5, x20
    arm64.storeSlotReg slot4, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.movImm x0, 7
  __il_body:
    arm64.leaRegSlot x1, slot2
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x0
  __il_cont:
    arm64.movImm x0, 9
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 5
    arm64.movImm x1, 5
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x21, [x20 + 0]
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.loadRegSlot x21, slot6
    arm64.epilogue 80
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at assign-struct-to-same-struct.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.loadRegSlot x21, slot6
    arm64.epilogue 80
    arm64.ret
}
