// Test: field-defaults.method-before-field
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Bag
	export static function create() returns Self
		return Self{}
	end 'create'

	export var items as IntArray = IntArray.create()
end 'Bag'

function main() returns ExitCode
	var b = Bag.create()
	b.items.push(42)
	let v = try b.items.get(0) otherwise 0
	return v
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
  __il_cont#12:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#10:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movImm x1, 42
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  tryok:
    arm64.movRegReg x19, x0
  trycont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Bag
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __im_slow:
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b tryok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at field-defaults.method-before-field.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
