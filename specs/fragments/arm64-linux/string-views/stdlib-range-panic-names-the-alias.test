// Test: stdlib-range-panic-names-the-alias
function main() returns ExitCode
	var lead = 0
	for i in 1000000000 to 1000000000 'once'
		lead = utf16LeadSurrogate(i)
	end 'once'
	return 7 if lead > 65535 else 9
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.movImm x19, 1000000000
  forhdr:
    arm64.movImm x16, 1000000000
    arm64.cmp x19, x16
    arm64.b.gt forexit
  once:
    arm64.movRegReg x0, x19
    arm64.bl utf16LeadSurrogate
  forstep:
    arm64.add x19, x19, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x16, 65535
    arm64.cmp x0, x16
    arm64.b.le ternaryfalse
  ternarytrue:
    arm64.movImm x0, 7
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 9
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at stdlib-range-panic-names-the-alias.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
