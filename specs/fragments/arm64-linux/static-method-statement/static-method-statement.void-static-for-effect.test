// Test: static-method-statement.void-static-for-effect
type Helper
	export static function shout()
		print("hi")
	end 'shout'
end 'Helper'

function main() returns ExitCode
	Helper.shout()
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body#2:
    arm64.leaRdata x0, __str_rec_1  ; "hi"
  __il_body#4:
    arm64.bl __write_stdout
  __il_cont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
