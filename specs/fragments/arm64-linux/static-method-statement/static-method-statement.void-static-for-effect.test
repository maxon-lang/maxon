// Test: static-method-statement.void-static-for-effect
type Helper
	export static function shout()
		print("hi")
	end 'shout'
end 'Helper'

function main() returns ExitCode
	Helper.shout()
	return 0
end 'main'
---
ExitCode: 0
---
func @Helper.shout {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "hi"
    arm64.bl print
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl Helper.shout
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
