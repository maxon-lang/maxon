// Test: static-method-statement.void-static-for-effect
type Helper
	static function shout()
		print("hi")
	end 'shout'
end 'Helper'

function main() returns ExitCode
	Helper.shout()
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body#2:
    arm64.leaRdata x0, __str_rec_1  ; "hi"
  __il_body#4:
    arm64.bl __write_stdout
  __il_cont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
