func @Box_Small.__loop {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
  serve:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x21, x0
    arm64.cmp x21, 0
    arm64.b.eq stopping
  dispatch:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.jumpTable x0, default=stopping [[0]=__shutdown, [1]=peek] @__jumptable_8
  __shutdown:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.storeBaseDispReg.word64 [x20 + 56], x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
  stopping:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_close
  drain:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x1, x0
    arm64.cmp x1, 0
    arm64.b.ne abandon
  finished:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mbox_service_exit
    arm64.movRegReg x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  abandon:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_abandon
    arm64.b drain
  peek:
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
    arm64.leaRdata x0, __layout_Box_Small
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.bl __retain_type_param
    arm64.movRegReg x23, x0
  __il_cont:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movImm x2, 0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x23
    arm64.bl __gt_cell_complete
    arm64.b serve
}

func @Box.__abandon {
  entry:
