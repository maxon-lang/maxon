    arm64.movRegReg x21, x0
    arm64.cmp x21, 0
    arm64.b.eq stopping
  dispatch:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.jumpTable x0, default=stopping [[0]=__shutdown, [1]=divide] @__jumptable_13
