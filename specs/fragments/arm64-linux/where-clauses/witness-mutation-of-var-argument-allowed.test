// Test: witness-mutation-of-var-argument-allowed
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

interface Grower
	function grow(dest IntArray)
end 'Grower'

type Pusher implements Grower
	export var n as Integer
	export static function create(n Integer) returns Self
		return Self{ n: n }
	end 'create'
	export function grow(dest IntArray)
		dest.push(9)
	end 'grow'
end 'Pusher'

type Box uses T where T is Grower
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function run(dest IntArray)
		self.item.grow(dest)
	end 'run'
end 'Box'

typealias PusherBox = Box with Pusher

function main() returns ExitCode
	var a = IntArray.create()
	let b = PusherBox.create(Pusher.create(1))
	b.run(a)
	return try a.get(0) otherwise 55
end 'main'
---
ExitCode: 9
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Pusher.grow {
  entry:
    arm64.prologue 16
    arm64.movImm x2, 9
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_push
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1
  __il_body#13:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
  __il_cont#12:
    arm64.movRegReg x0, x21
    arm64.bl __mm_own
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __witness_Pusher.Grower
  __il_body#14:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.storeBaseDispReg.word64 [x22 + 0], x20
  __il_cont#11:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.leaRdata x2, __witness_Pusher.Grower
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x0, [x22 + 0]
    arm64.movRegReg x1, x19
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
  __il_cont#10:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
    arm64.b __im_load
  tryerr:
    arm64.movImm x20, 55
    arm64.b trycont
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  tryok:
    arm64.movRegReg x20, x0
  trycont:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Box_Pusher
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.ne tryerr
    arm64.b tryok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at witness-mutation-of-var-argument-allowed.test:35: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
