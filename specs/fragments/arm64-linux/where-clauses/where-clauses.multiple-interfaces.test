// Test: where-clauses.multiple-interfaces

typealias Integer = int(i64.min to i64.max)

interface HasName
		function name() returns Integer
end 'HasName'

interface HasAge
		function age() returns Integer
end 'HasAge'

type Person implements HasName, HasAge
		let age as Integer

		function name() returns Integer
				return 1
		end 'name'

		function age() returns Integer
				return self.age
		end 'age'

		static function create(age Integer) returns Self
			return Self{age: age}
		end 'create'
end 'Person'

type Registry uses T where T is HasName and HasAge
		export var item as T

		static function create(item T) returns Self
			return Self{item: item}
		end 'create'
end 'Registry'

typealias PersonRegistry = Registry with Person

function main() returns ExitCode
		let p = Person.create(30)
		let r = PersonRegistry.create(p)
		return r.item.age()
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Person.name {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @Person.age {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Person.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Registry.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 30
    arm64.bl Person.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.leaRdata x1, __witness_Person.HasName
    arm64.leaRdata x2, __witness_Person.HasAge
    arm64.movRegReg x0, x19
    arm64.bl Registry.create
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x1 + 0]
  __il_cont:
    arm64.bl __destruct_Registry_Person
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at where-clauses.multiple-interfaces.test:42: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
