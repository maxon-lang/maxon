// Test: scalar-conformer-co-owned-into-a-var
typealias Integer = int(i64.min to i64.max)

function use(h Comparable, replace bool) returns Integer
	var v = h
	if replace 'maybe'
		v = h
	end 'maybe'
	return 11 if true else 12
end 'use'

function main() returns ExitCode
	return use(7, replace: false) as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 7
    arm64.leaRdata x19, __witness_int.Comparable
  __il_body:
    arm64.movRegReg x0, x19
    arm64.bl __retain_existential
    arm64.movRegReg x1, x0
  ternarytrue:
    arm64.movImm x20, 11
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __drop_existential
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
