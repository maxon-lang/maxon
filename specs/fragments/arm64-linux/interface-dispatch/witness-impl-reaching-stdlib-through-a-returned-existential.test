// Test: witness-impl-reaching-stdlib-through-a-returned-existential
typealias Tag = int(0 to 100)

interface Printer
	function show()
end 'Printer'

type Thing implements Printer
	let label as Tag

	export static function create(label Tag) returns Self
		return Self{label: label}
	end 'create'

	export function show()
		print("never shown\n")
	end 'show'
end 'Thing'

var boxes = 0 as Tag

// The discard is the shape under test, so `box` must have an effect — see `discarded-results.md`.
function box() returns Printer
	boxes = boxes + 1
	return Thing.create(7)
end 'box'

function main() returns ExitCode
	_ = box()
	return 2 + boxes
end 'main'
---
ExitCode: 3
---
data {
  __data_boxes@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Thing.show {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "never shown\x0a"
  __il_body:
    arm64.bl __write_stdout
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @box {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_boxes
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_boxes
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x19, 7
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
  __il_cont:
    arm64.leaRdata x9, __witness_Thing.Printer
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl box
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.bl __drop_existential
    arm64.leaGlobal x0, __data_boxes
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 2
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at witness-impl-reaching-stdlib-through-a-returned-existential.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
