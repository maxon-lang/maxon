// Test: witness-impl-reaching-stdlib-when-only-boxed
typealias Tag = int(0 to 100)

interface Printer
	function show()
end 'Printer'

type Thing implements Printer
	let label as Tag

	export static function create(label Tag) returns Self
		return Self{label: label}
	end 'create'

	export function show()
		print("never shown\n")
	end 'show'
end 'Thing'

type Holder
	let p as Printer
	export let n as ExitCode

	export static function create(p Printer, n ExitCode) returns Self
		return Self{p: p, n: n}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(Thing.create(7), n: 3 as ExitCode)
	return h.n
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Thing.show {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "never shown\x0a"
  __il_body:
    arm64.bl __write_stdout
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
  __rc_ok#4:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#2:
    arm64.movImm x19, 3
    arm64.leaRdata x21, __witness_Thing.Printer
  __rc_ok#8:
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x20
    arm64.bl __retain_existential
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.storeBaseDispReg.word64 [x22 + 16], x19
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x20
    arm64.bl __drop_existential
  __il_cont#1:
    arm64.loadRegBaseDisp.word64 x19, [x22 + 16]
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
