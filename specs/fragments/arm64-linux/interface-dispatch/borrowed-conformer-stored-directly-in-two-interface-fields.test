// Test: borrowed-conformer-stored-directly-in-two-interface-fields
typealias Integer = int(i64.min to i64.max)

interface Tagged
	function tag() returns Integer
end 'Tagged'

type Marker implements Tagged
	let n as Integer

	function tag() returns Integer
		return n
	end 'tag'

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Marker'

type Pair
	var first as Tagged
	let second as Tagged

	static function create(m Marker) returns Self
		return Self{first: m, second: m}
	end 'create'

	function total() returns Integer
		self.first = Marker.create(9)
		return self.second.tag() + self.first.tag()
	end 'total'
end 'Pair'

function main() returns ExitCode
	let m = Marker.create(3)
	var p = Pair.create(m)
	return p.total()
end 'main'
---
ExitCode: 12
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @Marker.tag {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Marker.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.bl Marker.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_own
    arm64.movRegReg x20, x0
  __il_body#6:
    arm64.movImm x0, 32
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.leaRdata x1, __witness_Marker.Tagged
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x1
    arm64.movRegReg x0, x20
    arm64.bl __mm_own
    arm64.leaRdata x1, __witness_Marker.Tagged
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.storeBaseDispReg.word64 [x21 + 24], x1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
  __il_body#7:
    arm64.movImm x0, 9
    arm64.bl Marker.create
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.bl __drop_existential
    arm64.leaRdata x0, __witness_Marker.Tagged
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 16]
    arm64.loadRegBaseDisp.word64 x1, [x21 + 24]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
    arm64.blr x16
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 40]
