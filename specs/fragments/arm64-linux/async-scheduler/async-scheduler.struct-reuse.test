func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 0
    arm64.b whilehdr
  loop:
    arm64.leaFuncAddr x0, dbl
    arm64.bl __gt_spawn
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 200], x19
    arm64.movRegReg x0, x21
    arm64.bl __gt_ready
    arm64.movRegReg x0, x21
    arm64.bl __gt_await
    arm64.add x20, x20, x0
    arm64.add x19, x19, 1
  whilehdr:
