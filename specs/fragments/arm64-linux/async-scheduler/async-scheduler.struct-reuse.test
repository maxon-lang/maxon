// Test: async-scheduler.struct-reuse

function dbl(x Integer) returns Integer
	Scheduler.yield()
	return x * 2
end 'dbl'

function main() returns ExitCode
	var i = 1
	var acc = 0
	while i <= 5 'loop'
		let p = async dbl(i)
		let r = await p
		acc = acc + r
		i = i + 1
	end 'loop'
	return acc as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 30
---
