// Test: async-scheduler.parallel

function ten() returns Integer
	Runtime.yield()
	return 10
end 'ten'

function twenty() returns Integer
	Runtime.yield()
	return 20
end 'twenty'

function main() returns ExitCode
	let a = async ten()
	let b = async twenty()
	let ra = await a
	let rb = await b
	return (ra + rb) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 30
