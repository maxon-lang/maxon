  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.cmp x0, x1
    arm64.b.ge ifcont#4
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#4:
    arm64.cmp x0, x1
    arm64.b.le ifcont#6
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#6:
    arm64.movImm x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

