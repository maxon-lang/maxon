// Test: a-loop-whose-element-access-keeps-a-slow-arm-is-not-a-leaf
typealias Integer = int(i64.min to i64.max)
typealias Bytes = Array with Byte

function totalBytes(b Bytes) returns Integer
	var t = 0
	for v in b 'each'
		t = t + v
	end 'each'
	return t
end 'totalBytes'

function main() returns ExitCode
	var b = Bytes.create()
	b.push(20 as Byte)
	b.push(22 as Byte)
	return totalBytes(b) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 22
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  __il_body:
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  __us_test:
    arm64.loadRegBaseDisp.word64 x22, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x23, [x19 + 24]
    arm64.loadRegBaseDisp.word64 x24, [x19 + 0]
    arm64.b forhdr
  each:
    arm64.cmp x23, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseIndexScale.word64 x0, [x24 + x21*8 + 0]
    arm64.b __im_cont
  __im_stride:
    arm64.cmp x23, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.add x0, x24, x21
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
  __im_cont:
    arm64.add x20, x20, x0
  forstep:
    arm64.add x21, x21, 1
  forhdr:
    arm64.cmp x21, x22
    arm64.b.lt each
  __il_cont:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-loop-whose-element-access-keeps-a-slow-arm-is-not-a-leaf.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
