// Test: two-returns
typealias Integer = int(i64.min to i64.max)

function pick(a Integer) returns Integer
	if a > 10 'big'
		return 4
	end 'big'
	return 2
end 'pick'

function main() returns ExitCode
	return (pick(50) * 10 + pick(1)) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
  big:
    arm64.movImm x0, 4
  __il_cont#5:
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
  __il_cont#4:
    arm64.add x0, x0, 2
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
