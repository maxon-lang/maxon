// Test: chained-two-hop
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function make() returns IntArray
	var arr = IntArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)
	return arr
end 'make'

function main() returns ExitCode
	let v = try make().clone().get(1) otherwise return 9
	return v
end 'main'
---
ExitCode: 20
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl make
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __layout_Array_Integer
    arm64.movRegReg x0, x19
    arm64.bl Array.clone
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x20 + 40]
    arm64.cmp x2, 0
    arm64.b.eq critsplit#10
  __im_empty:
    arm64.cmp x21, 0
    arm64.b.ne critsplit#11
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.movRegReg x21, x0
    arm64.b __im_cont
  critsplit#11:
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  critsplit#10:
    arm64.movRegReg x9, x0
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x21, 9
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at chained-two-hop.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
