// Test: a-string-is-ordered-as-its-bytes
function main() returns ExitCode
	let a = "apple"
	let b = "banana"
	let c = "app"
	if a < b and c < a and not (b <= a) 'ordered'
		return 0
	end 'ordered'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_3  ; "apple"
    arm64.leaRdata x20, __str_rec_4  ; "banana"
    arm64.leaRdata x21, __str_rec_5  ; "app"
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __char_cmp
    arm64.cmp x0, 0
    arm64.movImm x0, 0
    arm64.b.ne scmerge#2
  andrhs#1:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __char_cmp
    arm64.cmp x0, 0
    arm64.cset x0, eq
  scmerge#2:
    arm64.movImm x1, 0
    arm64.cbz x0, critsplit
  andrhs#3:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __char_cmp
    arm64.cmp x0, 2
    arm64.cset x0, ne
    arm64.eor x0, x0, 1
    arm64.b scmerge#4
  critsplit:
    arm64.movRegReg x0, x1
  scmerge#4:
    arm64.cbz x0, ifcont
  ordered:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
