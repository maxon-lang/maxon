// Test: character-ordering-of-loop-elements
function main() returns ExitCode
	let s = "caféüñ"
	let pivot = 'ü'
	var below = 0
	for c in s 'each'
		if c < pivot 'lt'
			below = below + 1
		end 'lt'
	end 'each'
	print("{below}\n")
	return 0
end 'main'
