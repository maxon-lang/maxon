// Test: char-literal-lhs-coercion
function main() returns ExitCode
	let cp = 45
	if '-' == cp 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
