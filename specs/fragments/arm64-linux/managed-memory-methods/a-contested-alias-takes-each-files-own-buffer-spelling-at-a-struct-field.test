// Test: a-contested-alias-takes-each-files-own-buffer-spelling-at-a-struct-field
// --- file: buffer.maxon
typealias Byte = int(0 to u8.max)
typealias Int = int(i64.min to i64.max)
typealias B = __ManagedMemory with Byte

type Holder
	export var buf as B

	export static function create(buf B) returns Self
		return Self{buf: buf}
	end 'create'
end 'Holder'

export function seed() returns Int
	let h = Holder.create("hello".toByteArray() as B)
	return h.buf.length()
end 'seed'

// --- file: main.maxon
typealias Int2 = int(i64.min to i64.max)
typealias B = Array with Int2
typealias Nums = Array with Int2

type Bag
	export var items as B

	export static function create(items Nums) returns Self
		return Self{items: items as B}
	end 'create'
end 'Bag'

function main() returns ExitCode
	var xs = Nums.create()
	xs.push(7 as Int2)
	let b = Bag.create(xs)
	return (seed() + b.items.count()) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __slab_arena_list@0 = i64 0
  __slab_arena_map_l1@8 = i64 0
  __slab_state@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 7
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  __il_body#5:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_retain
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
  __il_body#7:
    arm64.leaRdata x0, __str_rec_1  ; "hello"
  __il_body#11:
    arm64.movImm x1, 0
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
  __il_cont#14:
    arm64.bl __managed_slice
    arm64.movRegReg x21, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_2  ; "panic at String.maxon:157: String.toByteArray: slice 0..byteLength() is in bounds by construction\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __managed_retain
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
  __il_body#9:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x22
    arm64.bl __managed_retain
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
  __il_cont#8:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Holder
  __il_cont#6:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x21, x22, x0
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Bag
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at main.maxon:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
