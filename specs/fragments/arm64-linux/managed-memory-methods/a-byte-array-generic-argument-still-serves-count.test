// Test: a-byte-array-generic-argument-still-serves-count
type Cell uses U
	export var slot as U

	export static function make(slot U) returns Self
		return Self{slot: slot}
	end 'make'

	export function get() returns U
		return slot
	end 'get'
end 'Cell'

typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias BytesCell = Cell with ByteArray

function main() returns ExitCode
	let c = BytesCell.make("hello".toByteArray())
	return c.get().count() as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Cell.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Cell.get {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1  ; "hello"
    arm64.bl String.toByteArray
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.bl Cell.make
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.leaRdata x1, __layout_Cell_ByteArray
    arm64.movRegReg x0, x20
    arm64.bl Cell.get
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-byte-array-generic-argument-still-serves-count.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Cell_ByteArray
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
