// Test: ranges.empty-inclusive
function main() returns ExitCode
		var count = 0
		for _ in 5 to 3 'loop'
				count = count + 1
		end 'loop'
		return count
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
