	for r in 0 to lastRow 'l'
		total = total + r
	end 'l'
	return total
end 'sumTo'

function main() returns ExitCode
	var chars = 0
	for _ in 'a' to 'e' 'k'
		chars = chars + 1
	end 'k'
	return (sumTo(5) + chars) as ExitCode
end 'main'
