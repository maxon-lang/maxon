    arm64.ret
  __rc_panic#18:
    arm64.leaRdata x0, __str_blob_2  ; "panic at ranges.ranged-alias-parameter-bound-stays-legal.test:9: Range check failed: value outside typealias 'Row'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
