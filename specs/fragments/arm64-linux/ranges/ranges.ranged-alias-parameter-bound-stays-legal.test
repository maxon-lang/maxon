    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr#10
  l:
    arm64.add x0, x0, x1
  forstep#12:
    arm64.add x1, x1, 1
  forhdr#10:
    arm64.cmp x1, 5
    arm64.b.le l
  forexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#18
  __rc_chk#19:
    arm64.cmp x0, 63
    arm64.b.gt __rc_panic#18
  __il_cont:
    arm64.add x0, x0, x19
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#6
  __rc_chk#7:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic#6
  __rc_ok#5:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
