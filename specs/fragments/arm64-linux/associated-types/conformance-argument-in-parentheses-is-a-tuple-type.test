// Test: conformance-argument-in-parentheses-is-a-tuple-type

typealias Integer = int(i64.min to i64.max)
typealias Float = float(f64.min to f64.max)

interface One uses A
	function get() returns A
end 'One'

type Holder implements One with ((Integer, Float))
	let v as Integer
	let f as Float

	function get() returns (Integer, Float)
		return (v, f)
	end 'get'

	static function create(v Integer, f Float) returns Self
		return Self{v: v, f: f}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(42, f: 1.5)
	let t = h.get()
	return t.0
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, d8
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 42
    arm64.fpLoadRdata d8, [rdata + __fconst_1.5]
  __il_body#6:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.storeBaseDispReg.word64 [x20 + 8], d8
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 0]
    arm64.loadRegBaseDisp.word64 d8, [x20 + 8]
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], d8
  __il_cont:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot d8, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at conformance-argument-in-parentheses-is-a-tuple-type.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot d8, slot2
    arm64.epilogue 48
    arm64.ret
}
