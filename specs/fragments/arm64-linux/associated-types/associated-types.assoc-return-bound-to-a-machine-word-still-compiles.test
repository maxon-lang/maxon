// Test: associated-types.assoc-return-bound-to-a-machine-word-still-compiles
typealias Integer = int(i64.min to i64.max)

interface Maker uses Element
	function make() returns Element
end 'Maker'

type Runner implements Maker with Integer
	let base as Integer

	function make() returns Integer
		return base
	end 'make'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Runner'

function useIt(m Maker) returns Integer
	return m.make() + 11
end 'useIt'

function main() returns ExitCode
	return useIt(Runner.create(20)) as ExitCode
end 'main'
---
ExitCode: 31
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Runner.make {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Runner.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @useIt {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.add x0, x0, 11
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 20
    arm64.bl Runner.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_Runner.Maker
    arm64.movRegReg x0, x19
    arm64.bl useIt
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at associated-types.assoc-return-bound-to-a-machine-word-still-compiles.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
