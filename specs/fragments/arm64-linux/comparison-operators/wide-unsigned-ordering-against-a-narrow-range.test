// Test: wide-unsigned-ordering-against-a-narrow-range
typealias Wide = bits(64)
typealias Narrow = int(0 to 100)

function wide(n Wide) returns Wide
	return n
end 'wide'

function narrow(n Narrow) returns Narrow
	return n
end 'narrow'

function main() returns ExitCode
	let big = wide(u64.max)
	let small = narrow(3)

	if big > (small as Wide) 'ordered'
		return 42
	end 'ordered'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __mrt_envp@0 = i64 0
  __mrt_signal_stack_bytes@8 = i64 0
  __mrt_program_started@16 = i8 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_cont#4:
    arm64.movImm x0, 3
  __il_cont#3:
    arm64.cmp x0, -1
    arm64.b.hs ifcont
  ordered:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
