// Test: false-direction-and-boundary
function main() returns ExitCode
	let x = 5
	var r = 0
	if x == 6 'eqFalse'
		r = r + 1
	end 'eqFalse'
	if x != 5 'neFalse'
		r = r + 2
	end 'neFalse'
	if x > 5 'gtBoundary'
		r = r + 4
	end 'gtBoundary'
	if x <= 5 'leBoundary'
		r = r + 8
	end 'leBoundary'
	if x >= 5 'geBoundary'
		r = r + 16
	end 'geBoundary'
	if x < 5 'ltFalse'
		r = r + 32
	end 'ltFalse'
	return r
end 'main'
---
ExitCode: 24
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  leBoundary:
    arm64.add x0, x0, 8
  geBoundary:
    arm64.add x0, x0, 16
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
