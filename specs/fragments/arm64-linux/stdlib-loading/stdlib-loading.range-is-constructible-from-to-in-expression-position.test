// Test: stdlib-loading.range-is-constructible-from-to-in-expression-position
function main() returns ExitCode
	let r = 3 to 7
	var sum = 0
	for x in r 'walk'
		sum = sum + x
	end 'walk'
	return sum as ExitCode
end 'main'
---
ExitCode: 25
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 7
    arm64.bl Range.create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl Range.createIterator
    arm64.movRegReg x21, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.ne forjoin
  forhdr:
    arm64.cmp x0, 0
    arm64.b.ne forexit
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 16]
  __il_cont:
    arm64.add x20, x20, x0
  forstep:
    arm64.movRegReg x0, x21
    arm64.bl RangeIterator.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
  forjoin:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at stdlib-loading.range-is-constructible-from-to-in-expression-position.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
