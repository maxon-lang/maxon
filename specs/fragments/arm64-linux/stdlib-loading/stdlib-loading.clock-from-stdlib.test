  __sched_midle@176 = i64 0
  __sched_pidle@184 = i64 0
  __gt_gfree_head@192 = i64 0
  __sched_num_procs@200 = i64 0
  __sched_shutdown_flag@208 = i64 0
  __sched_lock@216 = i64 0
  __sched_nmspinning@224 = i64 0
  __sched_parked_drivers@232 = i64 0
  __sched_sysmon_started@240 = i64 0
  __mrt_errno@248 = i64 0
  __mrt_envp@256 = i64 0
  __mrt_tls_next_key@264 = i64 0
  __slab_arena_list@272 = i64 0
  __slab_arena_map_l1@280 = i64 0
  __slab_state@288 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Clock.nowMs
    arm64.movRegReg x19, x0
    arm64.bl WallClock.nowUnixSeconds
    arm64.movImm x1, 0
    arm64.cmp x19, 0
    arm64.b.ls ifcont#2
  monotonicPositive:
    arm64.movImm x1, 1
  ifcont#2:
    arm64.cmp x0, 0
    arm64.b.ls critsplit
  calendarPositive:
    arm64.add x0, x1, 1
    arm64.b ifcont#4
  critsplit:
    arm64.movRegReg x0, x1
  ifcont#4:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at stdlib-loading.clock-from-stdlib.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
