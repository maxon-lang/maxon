// Test: noncontiguous-alternatives
enum E
	a
	b
	c
	d
end 'E'

function classify(v E) returns ExitCode
	return match v 'm'
		a or
			c or
			d gives 1
		b gives 2
	end 'm'
end 'classify'

function main() returns ExitCode
	for x in E.allCases 'e'
		print("{x.name}={classify(x)}\n")
	end 'e'
	return 0
end 'main'
