// Test: int.hash.chained
function main() returns ExitCode
	let i = 42
	let once = i.hash()
	let twice = i.hash().hash()
	if once != twice 'chainDiffers'
		return 1
	end 'chainDiffers'
	if not once.equals(42) 'hashValueEquals'
		return 2
	end 'hashValueEquals'
	match once.compare(41) 'cmp'
		lessThan then return 3
		equalTo then return 4
		greaterThan then return 0
	end 'cmp'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 1
  __il_cont:
    arm64.eor x0, x0, 1
    arm64.cbz x0, matcharm
  hashValueEquals:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matcharm:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
