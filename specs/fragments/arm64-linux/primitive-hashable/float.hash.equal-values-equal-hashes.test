// Test: float.hash.equal-values-equal-hashes
function main() returns ExitCode
	let a = 1.5
	let b = 3.0 / 2.0
	if a.hash() != b.hash() 'differ'
		return 1
	end 'differ'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  ifcont#7:
    arm64.movImm x0, 0
  ifcont#13:
    arm64.movImm x1, 0
  __il_cont:
    arm64.cmp x0, x1
    arm64.b.eq ifcont#2
  differ:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
