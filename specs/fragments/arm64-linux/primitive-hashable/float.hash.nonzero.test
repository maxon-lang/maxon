// Test: float.hash.nonzero
function main() returns ExitCode
	let f = 3.14
	let h = f.hash()
	if h != 0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  ifcont#6:
    arm64.movImm x0, 1374389535
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.eq ifcont#2
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
