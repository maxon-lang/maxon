// Test: refill-a-string-element-array
typealias StringArray = Array with String

function main() returns ExitCode
	var arr = StringArray.create()
	arr.push("alpha")
	arr.push("beta")
	arr.refill(4, value: "zeta")
	var hits = 0
	for s in arr 'sum'
		if s == "zeta" 'match'
			hits = hits + 1
		end 'match'
	end 'sum'
	return hits + arr.count()
end 'main'
---
ExitCode: 8
---
