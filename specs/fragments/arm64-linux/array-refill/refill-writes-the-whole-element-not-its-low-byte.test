// Test: refill-writes-the-whole-element-not-its-low-byte
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	var arr = IntArray.create()
	arr.refill(3, value: 16909060)
	var total = 0
	for v in arr 'sum'
		total = total + v
	end 'sum'
	if total == 50727180 'everyByteSurvived'
		return 7
	end 'everyByteSurvived'
	return 1
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.movImm x2, 16909060
    arm64.leaRdata x3, __layout_Array_Integer
    arm64.movRegReg x0, x19
    arm64.bl Array.refill
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
  forhdr:
    arm64.cmp x1, x2
    arm64.b.ge forexit
  sum:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x0, x0, x4
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x16, 50727180
    arm64.cmp x0, x16
    arm64.b.ne ifcont
  everyByteSurvived:
    arm64.movImm x20, 7
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
