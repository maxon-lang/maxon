// Test: or-chain.first-alternative
typealias Integer = int(i64.min to i64.max)

union Action
	noop
	skip
	run(code Integer)
end 'Action'

function main() returns ExitCode
	let a = Action.noop
	let result = match a 'check'
		noop or
			skip gives 1
		run(code) gives code
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __slab_state@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.cmp x0, 0
    arm64.cset x2, ge
    arm64.cmp x0, 1
    arm64.cset x3, le
    arm64.and x2, x2, x3
    arm64.cbz x2, matchnext
  matcharm#1:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movRegReg x0, x1
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at or-chain.first-alternative.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
