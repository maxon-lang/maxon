// Test: enum-comparison
enum Status
	pending
	active
	done
end 'Status'

function main() returns ExitCode
	let s1 = Status.pending
	match s1 'check'
		pending then return 1
		active then return 0
		done then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
