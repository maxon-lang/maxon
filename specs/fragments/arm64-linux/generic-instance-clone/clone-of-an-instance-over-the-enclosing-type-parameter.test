    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#12:
    arm64.movImm x19, 91
    arm64.movImm x21, 4
    arm64.leaRdata x0, __layout_Bag_Integer
  __il_body#16:
    arm64.loadRegBaseDisp.word64 x22, [x20 + 0]
  __il_body#18:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.storeBaseDispReg.word64 [x1 + 0], x19
    arm64.storeBaseDispReg.word64 [x1 + 8], x21
  __il_cont#17:
    arm64.movRegReg x0, x22
    arm64.bl __managed_push
  __il_cont#15:
    arm64.leaRdata x0, __layout_Bag_Integer
  __il_body#19:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.leaRdata x3, __layout_Array_Bag.EBox
  __il_body#21:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.movImm x1, 0
    arm64.bl __managed_slice_opaque
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#22
  tryerr#23:
    arm64.leaRdata x0, __str_blob_0  ; "panic at Array.maxon:172: Array.clone: slice OOB \xe2\x80\x94 0..len is always valid\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#22:
    arm64.movRegReg x0, x19
