// Test: element-payload-through-a-shared-body-field-read
typealias Integer = int(i64.min to i64.max)

type Box uses T
	export var v as T
	export var tag as Integer

	export static function create(x T, tag Integer) returns Self
		return Self{v: x, tag: tag}
	end 'create'
end 'Box'

type Bag uses Element
	typealias EBox = Box with Element
	typealias EBoxArray = Array with EBox

	export var items as EBoxArray

	export static function create() returns Self
		return Self{items: EBoxArray.create()}
	end 'create'

	export function add(x Element, tag Integer)
		self.items.push(EBox.create(x, tag: tag))
	end 'add'

	export function copy() returns EBoxArray
		return self.items.clone()
	end 'copy'
end 'Bag'

typealias IntBag = Bag with Integer

function main() returns ExitCode
	var b = IntBag.create()
	b.add(91, tag: 4)

	let c = b.items
	let e = try c.get(0) otherwise return 90
	return 4 as ExitCode if e.v.equals(91) else 70 as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x22
    arm64.storeSlotReg slot3, x21
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
  __il_body#11:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
  __il_cont#10:
    arm64.movImm x19, 91
    arm64.movImm x21, 4
    arm64.leaRdata x0, __layout_Bag_Integer
  __il_body#15:
    arm64.loadRegBaseDisp.word64 x22, [x20 + 0]
  __il_body#17:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.storeBaseDispReg.word64 [x1 + 0], x19
    arm64.storeBaseDispReg.word64 [x1 + 8], x21
  __il_cont#16:
    arm64.movRegReg x0, x22
    arm64.bl __managed_push
  __il_cont#14:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.bl __managed_retain
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x2, [x2 + x1*8 + 0]
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.b.eq critsplit#18
  __im_empty:
    arm64.cmp x2, 0
    arm64.b.eq __im_slow
  critsplit#19:
    arm64.movRegReg x1, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  critsplit#18:
    arm64.movRegReg x1, x2
    arm64.movRegReg x9, x3
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 90
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Bag_Integer
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.loadRegSlot x22, slot4
    arm64.epilogue 64
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  __il_body#13:
    arm64.cmp x1, 91
    arm64.cset x1, eq
  __il_cont#12:
    arm64.cbz x1, ternaryfalse
  ternarytrue:
    arm64.movImm x19, 4
    arm64.b matchcont
  ternaryfalse:
