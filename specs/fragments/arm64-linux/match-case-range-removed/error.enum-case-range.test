// Test: error.enum-case-range
typealias Code = int(0 to 125)

union Op
	add
	sub
	mul
end 'Op'

function pick(op Op) returns Code
	match op 'op'
		add to mul then return 1
	end 'op'
end 'pick'

function main() returns ExitCode
	return pick(Op.add)
end 'main'
---
CompilerError:
error E3146: <fragment>:12:3: 'add to mul' is not a match pattern: name each case in an 'or'-chain, one per line
