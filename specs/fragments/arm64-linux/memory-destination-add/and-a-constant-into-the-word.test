// Test: and-a-constant-into-the-word
var slot = 12

function main() returns ExitCode
	slot = slot and 10
	return slot
end 'main'
---
ExitCode: 8
---
data {
  __data_slot@0 = i64 12
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 10
    arm64.and x0, x0, x16
    arm64.leaGlobal x1, __data_slot
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at and-a-constant-into-the-word.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
