// Test: a-call-between-the-read-and-the-write-keeps-them-apart
typealias Depth = int(0 to 3)

var slot = 5

function reset(depth Depth)
	if depth > 0 'deeper'
		reset(depth - 1)
		return
	end 'deeper'

	slot = 100
end 'reset'

function main() returns ExitCode
	let seen = slot
	reset(3)
	slot = seen + 1
	return slot
end 'main'
---
ExitCode: 6
---
data {
  __data_slot@0 = i64 5
}

func @reset {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 3
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.cmp x0, 0
    arm64.b.le ifcont
  deeper:
    arm64.sub x0, x0, 1
    arm64.bl reset
    arm64.movRegReg x1, x0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x1, 100
    arm64.leaGlobal x2, __data_slot
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-call-between-the-read-and-the-write-keeps-them-apart.test:6: Range check failed: value outside typealias 'Depth'\x0a"
    arm64.bl mrt_panic
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movImm x0, 3
    arm64.bl reset
    arm64.add x0, x19, 1
    arm64.leaGlobal x1, __data_slot
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-call-between-the-read-and-the-write-keeps-them-apart.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
