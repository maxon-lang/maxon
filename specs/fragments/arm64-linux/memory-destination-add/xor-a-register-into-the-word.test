// Test: xor-a-register-into-the-word
var slot = 12
var operand = 0

function main() returns ExitCode
	operand = 10
	slot = slot xor operand
	return slot
end 'main'
---
ExitCode: 6
---
data {
  __data_slot@0 = i64 12
  __data_operand@8 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.leaGlobal x1, __data_operand
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaGlobal x1, __data_operand
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.eor x0, x0, x1
    arm64.leaGlobal x1, __data_slot
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at xor-a-register-into-the-word.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
