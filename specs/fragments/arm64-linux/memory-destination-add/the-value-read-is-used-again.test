// Test: the-value-read-is-used-again
var total = 20

function main() returns ExitCode
	let before = total
	total = before + 1
	return before + total
end 'main'
---
ExitCode: 41
---
data {
  __data_total@0 = i64 20
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_total
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x1, x0, 1
    arm64.leaGlobal x2, __data_total
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.leaGlobal x1, __data_total
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at the-value-read-is-used-again.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
