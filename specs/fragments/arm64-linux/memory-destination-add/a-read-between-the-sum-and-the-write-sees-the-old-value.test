// Test: a-read-between-the-sum-and-the-write-sees-the-old-value
var hits = 0

function main() returns ExitCode
	hits = 3
	let next = hits + 1
	let seen = hits
	hits = next
	return seen * 10 + hits
end 'main'
---
ExitCode: 34
---
data {
  __data_hits@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.leaGlobal x1, __data_hits
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_hits
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_hits
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.leaGlobal x2, __data_hits
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.movImm x16, 10
    arm64.mul x0, x1, x16
    arm64.leaGlobal x1, __data_hits
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-read-between-the-sum-and-the-write-sees-the-old-value.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
