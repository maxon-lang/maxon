// Test: two-globals-are-two-words
var a = 5
var b = 0

function main() returns ExitCode
	b = 20
	a = b + 1
	return a
end 'main'
---
ExitCode: 21
---
data {
  __data_a@0 = i64 5
  __data_b@8 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.leaGlobal x1, __data_b
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_b
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_a
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_a
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at two-globals-are-two-words.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
