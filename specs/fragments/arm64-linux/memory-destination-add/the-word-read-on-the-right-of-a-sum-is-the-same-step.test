// Test: the-word-read-on-the-right-of-a-sum-is-the-same-step
var hits = 4
var operand = 0

function main() returns ExitCode
	operand = 10
	hits = operand + hits
	return hits
end 'main'
---
ExitCode: 14
---
data {
  __data_hits@0 = i64 4
  __data_operand@8 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.leaGlobal x1, __data_operand
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_operand
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaGlobal x1, __data_hits
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.leaGlobal x1, __data_hits
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_hits
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.gt __rc_panic
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at the-word-read-on-the-right-of-a-sum-is-the-same-step.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
