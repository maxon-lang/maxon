// Test: negative-range-cast-guard-fires-before-the-divide
typealias Integer = int(i64.min to i64.max)
typealias NegativeOnly = int(-100 to -1)

function ident(v Integer) returns Integer
	return v
end 'ident'

function main() returns ExitCode
	let z = ident(0)
	let d = z as NegativeOnly
	let q = 100 / d
	print("q={q}\n")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at negative-range-cast-guard-fires-before-the-divide.test:11: Range check failed: value outside typealias 'NegativeOnly'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
