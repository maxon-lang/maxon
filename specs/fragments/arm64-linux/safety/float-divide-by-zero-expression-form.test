// Test: float-divide-by-zero-expression-form
typealias Float = float(f64.min to f64.max)

function opaque(x Float) returns Float
	return x
end 'opaque'

function main() returns ExitCode
	let zero = opaque(0.0)
	var result = 0
	try (100.0 / zero) otherwise (e) 'handle'
		match e 'kind'
			divisionByZero then result = 42
		end 'kind'
	end 'handle'
	return result as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
  __il_cont:
    arm64.fpLoadRdata d1, [rdata + __fconst_100]
    arm64.movImm x0, 1
    arm64.fdiv d0, d1, d0
  tryerr:
    arm64.sub x0, x0, 1
  matcharm:
    arm64.movImm x0, 42
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
