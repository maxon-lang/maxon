// Test: module-union-reassign-releases-old
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.unowned

function main() returns ExitCode
	var i = 0
	while i < 10 'fill'
		hold = Hold.owned(i as Small)
		i = i + 1
	end 'fill'

	return match hold 'm'
		unowned gives 0
		owned(v) gives v
	end 'm'
end 'main'
