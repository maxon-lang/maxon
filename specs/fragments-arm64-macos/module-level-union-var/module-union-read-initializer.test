// Test: module-union-read-initializer
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.owned(9)

function main() returns ExitCode
	return match hold 'm'
		unowned gives 0
		owned(v) gives v
	end 'm'
end 'main'
