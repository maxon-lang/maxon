// Test: module-union-store-then-match
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.unowned

function seed()
	hold = Hold.owned(5)
end 'seed'

function main() returns ExitCode
	seed()
	return match hold 'm'
		unowned gives 0
		owned(v) gives v
	end 'm'
end 'main'
