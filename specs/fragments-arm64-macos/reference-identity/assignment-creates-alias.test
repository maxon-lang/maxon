// Test: assignment-creates-alias
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = a
	if a is b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x1, #0
    arm64.mov x0, #16
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, #1
    arm64.str x0, [x19, #0] (8b)
    arm64.mov x0, #2
    arm64.str x0, [x19, #8] (8b)
    arm64.mov x0, x19
    arm64.bl mm_drop
    arm64.cmp x19, x19
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
---
