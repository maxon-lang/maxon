    arm64.b.ne __destruct_String.raw_free_0
    arm64.b __destruct_String.skip_buf_0
  raw_free_0:
    arm64.ldr x0, [x29, #-8]
    arm64.ldr x1, [x0, #0]
    arm64.mov x0, x1
    arm64.bl mm_raw_free
    arm64.b __destruct_String.skip_buf_0
  skip_buf_0:
    arm64.b __destruct_String.done
  done:
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
---
