// Test: async-tcp.trace-connect-error
function connect() returns ExitCode throws NetworkError
	_ = try TcpClient.connect("192.0.2.1", port: 1)
	return 0
end 'connect'

function main() returns ExitCode
	let p = async connect()
	let result = try await p otherwise 99
	return result
end 'main'
