// Test: float-to-int-struct-field-rejected

typealias Integer = int(i64.min to i64.max)

type P
	export var v as Integer

	static function create() returns Self
		return Self{v: 3.7}
	end 'create'
end 'P'

function main() returns ExitCode
	let p = P.create()
	return p.v
end 'main'
