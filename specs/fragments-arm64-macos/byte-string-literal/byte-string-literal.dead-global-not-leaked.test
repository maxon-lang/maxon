// Test: byte-string-literal.dead-global-not-leaked
typealias Integer = int(i64.min to i64.max)

let Live = b"aa"
let Dead = b"bbbb"

function readDead() returns Integer
		return Dead.count()
end 'readDead'

function main() returns ExitCode
		return Live.count()
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.global_load x0, [Live]
    arm64.str x0, [x29, #-8]
    arm64.ldr x1, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.bl ByteArray.count
    arm64.mov x2, #0
    arm64.cmp x0, x2
    arm64.cset x3, lt
    arm64.mov x4, #255
    arm64.cmp x0, x4
    arm64.cset x5, gt
    arm64.orr x6, x3, x5
    arm64.cmp x6, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_8
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
---
