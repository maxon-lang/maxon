// Test: cos.with-int-promotion
function main() returns ExitCode
	let x = 0  // int
	let result = Math.cos(x)  // x promoted to 0.0
	if result == 1.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #0
    arm64.scvtf d0, x0
    arm64.bl Math.cos
    arm64.ldr d1, [rdata+__float_4607182418800017408]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  }
}
---
