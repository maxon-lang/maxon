// Test: a-bare-int-count-keeps-the-guard
function main() returns ExitCode
	var seen = 0
	for n in 68 upto 72 'each'
		if 7 shl n != 0 'shl'
			return 1
		end 'shl'
		if 1024 shr n != 0 'shr'
			return 2
		end 'shr'
		seen = seen + 1
	end 'each'

	if seen != 4 'iterations'
		return 3
	end 'iterations'

	return 42
end 'main'
---
ExitCode: 42
