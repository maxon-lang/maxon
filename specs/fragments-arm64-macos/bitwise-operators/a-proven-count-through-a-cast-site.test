// Test: a-proven-count-through-a-cast-site
typealias Bits = int(0 to 63)

function main() returns ExitCode
	var acc = 0
	for i in 0 upto 8 'lowBits'
		let n = i as Bits
		acc = acc + (1 shl n)
	end 'lowBits'
	if acc != 255 'sum'
		return 1
	end 'sum'

	var top = 0
	for i in 0 upto 2 'boundary'
		let n = (i * 63) as Bits
		top = top + (1 shl n)
	end 'boundary'
	if top != 0 - 9223372036854775807 'topSum'
		return 2
	end 'topSum'

	return 42
end 'main'
