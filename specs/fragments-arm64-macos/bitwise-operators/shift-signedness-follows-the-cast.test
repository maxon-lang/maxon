// Test: shift-signedness-follows-the-cast
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function viaCast(p Num) returns Wide
	let w = p as Wide
	return w shr 60
end 'viaCast'

function viaParam(w Wide) returns Wide
	return w shr 60
end 'viaParam'

function main() returns ExitCode
	if viaParam(u64.max) != 15 'declaredParam'
		return 1
	end 'declaredParam'
	if viaCast(u64.max) != 15 'castLocal'
		return 2
	end 'castLocal'
	if viaCast(u64.max) != viaParam(u64.max) 'twoRoutesOneType'
		return 3
	end 'twoRoutesOneType'
	return 42
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @viaCast(p: i64) -> u64 {
  entry:
    arm64.mov x1, #60
    arm64.lsrv x2, x0, x1
    arm64.mov x0, x2
    arm64.ret
  }
  func @viaParam(w: i64) -> u64 {
  entry:
    arm64.mov x1, #60
    arm64.lsrv x2, x0, x1
    arm64.mov x0, x2
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x0, #-1
    arm64.bl viaParam
    arm64.mov x1, #15
    arm64.cmp x0, x1
    arm64.cset x2, ne
    arm64.cmp x2, #0
    arm64.b.ne main.declaredParam_0
    arm64.b main.declaredParam_0.after
  declaredParam_0:
    arm64.mov x0, #1
    arm64.epilogue stack_size=32
    arm64.ret
  declaredParam_0.after:
    arm64.mov x0, #-1
    arm64.bl viaCast
    arm64.mov x1, #15
    arm64.cmp x0, x1
    arm64.cset x2, ne
    arm64.cmp x2, #0
    arm64.b.ne main.castLocal_0
    arm64.b main.castLocal_0.after
  castLocal_0:
    arm64.mov x0, #2
    arm64.epilogue stack_size=32
    arm64.ret
  castLocal_0.after:
    arm64.mov x0, #-1
    arm64.bl viaCast
    arm64.str x0, [x29, #-8]
    arm64.mov x0, #-1
    arm64.bl viaParam
    arm64.ldr x1, [x29, #-8]
    arm64.cmp x1, x0
    arm64.cset x2, ne
    arm64.cmp x2, #0
    arm64.b.ne main.twoRoutesOneType_0
    arm64.b main.twoRoutesOneType_0.after
  twoRoutesOneType_0:
    arm64.mov x0, #3
    arm64.epilogue stack_size=32
    arm64.ret
  twoRoutesOneType_0.after:
    arm64.mov x0, #42
    arm64.epilogue stack_size=32
    arm64.ret
  }
}
---
