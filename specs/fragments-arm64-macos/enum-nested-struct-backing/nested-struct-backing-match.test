    arm64.b.ne main.dispatch_0.dispatch1
    arm64.b main.dispatch_0.case1
  dispatch_0.dispatch1:
    arm64.b main.dispatch_0.merge
  dispatch_0.case0:
    arm64.mov x0, #10
    arm64.str x0, [x29, #-16]
    arm64.b main.dispatch_0.merge
  dispatch_0.case1:
    arm64.mov x0, #20
    arm64.str x0, [x29, #-16]
    arm64.b main.dispatch_0.merge
  dispatch_0.merge:
    arm64.ldr x0, [x29, #-16]
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x3, #255
    arm64.cmp x0, x3
    arm64.cset x4, gt
    arm64.orr x5, x2, x4
