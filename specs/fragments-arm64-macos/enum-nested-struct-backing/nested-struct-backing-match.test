  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #0
    arm64.mov x1, #1
    arm64.b dispatch_0.next0
  dispatch_0.merge:
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x1, hi
    arm64.b.ls __range_ok_0
    arm64.b __range_panic_0
  dispatch_0.next0:
    arm64.mov x2, #1
    arm64.cmp x1, x2
    arm64.cset x1, eq
    arm64.b.ne dispatch_0.merge
  dispatch_0.case1:
    arm64.mov x0, #20
    arm64.b dispatch_0.merge
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_2f70161b52e1e2ef
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue
    arm64.ret
  }
}
