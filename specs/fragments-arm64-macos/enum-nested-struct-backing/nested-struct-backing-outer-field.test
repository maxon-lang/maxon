// Test: nested-struct-backing-outer-field
typealias Latency = int(0 to 50)

type OpMeta
	export let latency as Latency

	static function create(latency Latency) returns Self
		return Self{latency: latency}
	end 'create'
end 'OpMeta'

type TargetMeta
	export let meta as OpMeta
	export let setsFlags as bool

	static function create(meta OpMeta, setsFlags bool) returns Self
		return Self{meta: meta, setsFlags: setsFlags}
	end 'create'
end 'TargetMeta'

enum Op
	add = TargetMeta.create(OpMeta.create(1), setsFlags: true)
	mov = TargetMeta.create(OpMeta.create(2), setsFlags: false)
end 'Op'

function main() returns ExitCode
	let op = Op.add
	if op.rawValue.setsFlags 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #0
    arm64.str x0, [x29, #-8]
    arm64.ldr x1, [x29, #-8]
    arm64.mov x2, #0
    arm64.mov x3, #0
    arm64.cmp x1, x3
    arm64.cset x4, eq
    arm64.mov x5, #1
    arm64.cmp x4, #0
    arm64.csel x6, x5, x2, ne
    arm64.mov x7, #1
    arm64.cmp x1, x7
    arm64.cset x8, eq
    arm64.mov x9, #0
    arm64.cmp x8, #0
    arm64.csel x10, x9, x6, ne
    arm64.cmp x10, #0
    arm64.b.ne main.check_0
    arm64.b main.check_0.after
  check_0:
    arm64.mov x0, #1
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
---
