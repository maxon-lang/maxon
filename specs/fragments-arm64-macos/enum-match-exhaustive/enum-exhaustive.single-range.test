// Test: enum-exhaustive.single-range
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	match c 'check'
		red to blue then return 1
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #1
    arm64.str x0, [x29, #-8]
    arm64.ldr x1, [x29, #-8]
    arm64.mov x2, #2
    arm64.cmp x1, x2
    arm64.cset x3, hi
    arm64.cmp x3, #0
    arm64.b.ne main.check_0.dispatch0
    arm64.b main.check_0.case0
  check_0.dispatch0:
    arm64.b main.check_0.merge
  check_0.case0:
    arm64.mov x0, #1
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.merge:
  }
}
---
