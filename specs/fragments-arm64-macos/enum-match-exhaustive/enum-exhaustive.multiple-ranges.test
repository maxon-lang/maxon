    arm64.mov x2, #2
    arm64.cmp x0, x1
    arm64.cset x1, le
    arm64.cmp x0, x2
    arm64.cset x0, ge
    arm64.ands x2, x0, x1
    arm64.b.eq check_0.next1
  check_0.case1:
    arm64.mov x0, #2
    arm64.epilogue
    arm64.ret
  check_0.next1:
    arm64.adrp_add_rdata x0, __panic_msg_96c7daeb3f9a871f
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
