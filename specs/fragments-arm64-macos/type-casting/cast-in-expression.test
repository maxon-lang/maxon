// Test: cast-in-expression

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 10 as Byte
	let result = b + 32
	return result
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #10
    arm64.mov x1, #32
    arm64.mov x2, x0
    arm64.mov x3, x1
    arm64.add x4, x2, x3
    arm64.mov x5, #0
    arm64.mov x6, x4
    arm64.cmp x6, x5
    arm64.cset x7, lt
    arm64.mov x8, #255
    arm64.mov x9, x4
    arm64.cmp x9, x8
    arm64.cset x10, gt
    arm64.orr x11, x7, x10
    arm64.cmp x11, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_4
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x4
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
