typealias AlsoInts = Array with Integer

function total(xs Ints) returns Integer
	var sum = 0
	for x in xs 'each'
		sum = sum + x
	end 'each'
	return sum
end 'total'

function main() returns ExitCode
	var xs = AlsoInts.create()
	xs.push(20)
	xs.push(22)
	return total(xs as Ints)
end 'main'
