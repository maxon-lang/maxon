// Test: countof-folds-in-expression-position
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Vec5 = Vector with 5 Int

function main() returns ExitCode
	let total = countof(Vec3) + countof(Vec5)
	return total
end 'main'
---
ExitCode: 8
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #3
    arm64.mov x1, #5
    arm64.add x2, x0, x1
    arm64.mov x3, #0
    arm64.cmp x2, x3
    arm64.cset x4, lt
    arm64.mov x5, #255
    arm64.cmp x2, x5
    arm64.cset x6, gt
    arm64.orr x7, x4, x6
    arm64.cmp x7, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_0
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x2
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
