// Test: var-redeclare-after-scope
function main() returns ExitCode
	if true 'check'
		let x = 10
	end 'check'
	let x = 42
	return x
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #1
    arm64.cmp x0, #0
    arm64.b.ne main.check_0
    arm64.b main.check_0.merge
  check_0:
    arm64.b main.check_0.merge
  check_0.merge:
    arm64.mov x0, #42
    arm64.ret
  }
}
---
