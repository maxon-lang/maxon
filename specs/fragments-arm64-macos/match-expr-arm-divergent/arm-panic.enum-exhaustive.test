    arm64.cset x1, hi
    arm64.b.ls __range_ok_0
    arm64.b __range_panic_0
  eval_0.next0:
    arm64.mov x2, #1
    arm64.cmp x1, x2
    arm64.cset x2, eq
    arm64.b.ne eval_0.next1
  eval_0.case1:
    arm64.mov x0, #1
    arm64.b eval_0.merge
  eval_0.next1:
    arm64.mov x2, #2
    arm64.cmp x1, x2
    arm64.cset x1, eq
    arm64.b.ne eval_0.merge
  eval_0.case2:
    arm64.mov x0, #2
