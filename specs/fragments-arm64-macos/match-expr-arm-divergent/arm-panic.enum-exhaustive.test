  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_aee5fec6c78ef0e6
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
