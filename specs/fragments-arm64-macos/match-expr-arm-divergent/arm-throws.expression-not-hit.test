    arm64.mov x2, #0
    arm64.cmp x1, x2
    arm64.cset x1, ne
    arm64.b.eq try_0.merge
  try_0.otherwise:
    arm64.mov x0, #99
  try_0.merge:
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x1, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_63355f7d8f1f07d0
