    arm64.cmp x0, x1
    arm64.cset x1, lt
    arm64.b.ge __cast_ok_0
  __cast_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_f7e3a2dc19cd0c97
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __cast_ok_0:
    arm64.epilogue
    arm64.ret
  }
}
