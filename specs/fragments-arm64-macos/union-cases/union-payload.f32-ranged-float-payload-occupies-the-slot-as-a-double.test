// Test: union-payload.f32-ranged-float-payload-occupies-the-slot-as-a-double
typealias Tiny = float(f32.min to f32.max)

union Sample
	blank
	measured(d Tiny)
end 'Sample'

function main() returns ExitCode
	let v = 0.5 as Tiny
	let s = Sample.measured(v)
	let d = match s 'm'
		blank gives 0.0
		measured(x) gives x
	end 'm'
	if d == 0.5 'exact'
		return 7
	end 'exact'
	return 1
end 'main'
