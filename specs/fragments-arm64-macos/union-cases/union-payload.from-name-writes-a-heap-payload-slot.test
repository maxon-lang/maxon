// Test: union-payload.from-name-writes-a-heap-payload-slot
union Named
	blank
	titled(t String)
end 'Named'

function main() returns ExitCode
	let n = try Named.fromName("titled", "a payload long enough to be a real heap allocation") otherwise Named.blank
	let s = match n 'k'
		blank gives "blank"
		titled(t) gives t
	end 'k'
	print("{s}\n")
	return 0
end 'main'
