// Test: union-payload.from-name-writes-a-bool-payload-slot
union Flagged
	blank
	set(b bool)
end 'Flagged'

function main() returns ExitCode
	let s = try Flagged.fromName("set", true) otherwise Flagged.blank
	let v = match s 'm'
		blank gives false
		set(b) gives b
	end 'm'
	if v 'yes'
		return 7
	end 'yes'
	return 1
end 'main'
