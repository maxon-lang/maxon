// Test: a-negative-literal-is-not-the-unsigned-extreme
typealias Wide = int(0 to u64.max)

function wide(n Wide) returns Wide
	return n
end 'wide'

function main() returns ExitCode
	let three = wide(3 as Wide)

	if three > 0 - 1 'aboveNegativeOne'
		return 42
	end 'aboveNegativeOne'
	return 1
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @wide(n: i64) -> u64 {
  entry:
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #3
    arm64.bl wide
    arm64.mov x1, #0
    arm64.mov x2, #1
    arm64.sub x3, x1, x2
    arm64.cmp x0, x3
    arm64.cset x1, gt
    arm64.cmp x1, #0
    arm64.b.ne main.aboveNegativeOne_0
    arm64.b main.aboveNegativeOne_0.after
  aboveNegativeOne_0:
    arm64.mov x0, #42
    arm64.epilogue stack_size=16
    arm64.ret
  aboveNegativeOne_0.after:
    arm64.mov x0, #1
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
