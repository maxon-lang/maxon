// Test: wide-unsigned-ordering
typealias Wide = int(0 to u64.max)

function wide(n Wide) returns Wide
	return n
end 'wide'

function main() returns ExitCode
	let big = wide(u64.max)
	let three = wide(3 as Wide)

	if three < big 'ordered'
		return 42
	end 'ordered'
	return 1
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @wide(n: i64) -> u64 {
  entry:
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x0, #-1
    arm64.bl wide
    arm64.str x0, [x29, #-8]
    arm64.mov x0, #3
    arm64.bl wide
    arm64.ldr x1, [x29, #-8]
    arm64.cmp x0, x1
    arm64.cset x2, lo
    arm64.cmp x2, #0
    arm64.b.ne main.ordered_0
    arm64.b main.ordered_0.after
  ordered_0:
    arm64.mov x0, #42
    arm64.epilogue stack_size=32
    arm64.ret
  ordered_0.after:
    arm64.mov x0, #1
    arm64.epilogue stack_size=32
    arm64.ret
  }
}
---
