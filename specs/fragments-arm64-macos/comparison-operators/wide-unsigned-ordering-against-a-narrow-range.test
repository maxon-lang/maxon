// Test: wide-unsigned-ordering-against-a-narrow-range
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 100)

function wide(n Wide) returns Wide
	return n
end 'wide'

function narrow(n Narrow) returns Narrow
	return n
end 'narrow'

function main() returns ExitCode
	let big = wide(u64.max)
	let small = narrow(3 as Narrow)

	if big > small 'ordered'
		return 42
	end 'ordered'
	return 1
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @wide(n: i64) -> u64 {
  entry:
    arm64.ret
  }
  func @narrow(n: i64) -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.str x0, [x29, #-8]
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x1, #100
    arm64.cmp x0, x1
    arm64.cset x3, gt
    arm64.orr x0, x2, x3
    arm64.cmp x0, #0
    arm64.b.ne narrow.__range_panic_0
    arm64.b narrow.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_0
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.ldr x0, [x29, #-8]
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x3, #100
    arm64.cmp x0, x3
    arm64.cset x4, gt
    arm64.orr x5, x2, x4
    arm64.cmp x5, #0
    arm64.b.ne narrow.__range_panic_1
    arm64.b narrow.__range_ok_1
  __range_panic_1:
    arm64.adrp_add_symdata x0, __panic_msg_1
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_1:
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x0, #-1
    arm64.bl wide
    arm64.str x0, [x29, #-8]
    arm64.mov x0, #3
    arm64.bl narrow
    arm64.ldr x1, [x29, #-8]
    arm64.cmp x1, x0
    arm64.cset x2, hi
    arm64.cmp x2, #0
    arm64.b.ne main.ordered_0
    arm64.b main.ordered_0.after
  ordered_0:
    arm64.mov x0, #42
    arm64.epilogue stack_size=32
    arm64.ret
  ordered_0.after:
    arm64.mov x0, #1
    arm64.epilogue stack_size=32
    arm64.ret
  }
}
---
