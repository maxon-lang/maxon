    arm64.fmov d31, d0
    arm64.fmov d0, d1
    arm64.fmov d1, d31
    arm64.bl Math.pow
    arm64.ldr d1, [rdata+__float_4620130267728707584]
    arm64.fcmp d0, d1
    arm64.cset x0, gt
    arm64.b.le check_0.after
  check_0:
    arm64.mov x0, #8
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
