    arm64.mov x0, #42
    arm64.str x0, [x19, #0] (8b)
    arm64.adrp+add x1, __destruct_Outer
    arm64.mov x0, #8
    arm64.bl stdlib.__mm_alloc
    arm64.mov x20, x0
    arm64.mov x0, #0
    arm64.str x0, [x20, #0] (8b)
    arm64.str x19, [x20, #0] (8b)
    arm64.ldr x1, [x20, #0] (8b)
    arm64.ldr x19, [x1, #0] (8b)
    arm64.mov x0, x20
    arm64.bl mm_drop
    arm64.mov x0, #255
    arm64.cmp x19, x0
    arm64.cset x0, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_34cd2ee1458d065c
    arm64.ldr x19, [x29, #16]
