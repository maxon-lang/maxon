// Test: literal-accepted
typealias Integer = int(i64.min to i64.max)

type Wrapper uses T
	export typealias Idx = int(0 to u64.max)

	export var value as T
	export var tag as Idx

	export static function create(value T, tag Idx) returns Self
		return Self{value: value, tag: tag}
	end 'create'

	export function getTag() returns Idx
		return self.tag
	end 'getTag'
end 'Wrapper'

typealias IntWrapper = Wrapper with Integer

function main() returns ExitCode
	let w = IntWrapper.create(42, tag: 5)
	let t = w.getTag()
	if t == 5 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.adrp_add_rdata x0, __layout_Wrapper_Integer
    arm64.ldr x0, [x29, #16]
    arm64.ldr x1, [x0, #40] (8b)
    arm64.mov x0, #16
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, #42
    arm64.str x0, [x19, #0] (8b)
    arm64.mov x0, #5
    arm64.str x0, [x19, #8] (8b)
    arm64.ldr x20, [x19, #8] (8b)
    arm64.mov x0, x19
    arm64.bl mm_drop
    arm64.mov x0, #5
    arm64.cmp x20, x0
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  }
}
---
