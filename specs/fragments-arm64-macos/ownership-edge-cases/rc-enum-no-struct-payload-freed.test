    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne colorCode.pick_0.case1
    arm64.b colorCode.pick_0.cmp2
  pick_0.case1:
    arm64.mov x0, #2
    arm64.str x0, [x29, #-16]
    arm64.b colorCode.pick_0.merge
  pick_0.cmp2:
    arm64.ldr x0, [x29, #-24]
    arm64.mov x1, #2
    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne colorCode.pick_0.case2
    arm64.b colorCode.pick_0.merge
  pick_0.case2:
    arm64.mov x0, #3
    arm64.str x0, [x29, #-16]
    arm64.b colorCode.pick_0.merge
  pick_0.merge:
    arm64.ldr x0, [x29, #-16]
    arm64.epilogue stack_size=80
