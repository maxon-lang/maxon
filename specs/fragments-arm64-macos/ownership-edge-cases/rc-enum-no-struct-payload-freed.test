    arm64.str x0, [x29, #-24]
    arm64.b colorCode.pick_0.cmp0
  pick_0.cmp0:
    arm64.ldr x0, [x29, #-24]
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne colorCode.pick_0.case0
    arm64.b colorCode.pick_0.cmp1
  pick_0.case0:
    arm64.mov x0, #1
