// Test: rc-match-char-range-cleanup
function main() returns ExitCode
	let c = 'G'
	match c 'classify'
		'a' to 'z' then return 1
		'A' to 'Z' then return 2
		'0' to '9' then return 3
		default then return 0
	end 'classify'
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x1, #71
  classify_0.next0:
    arm64.mov x0, #90
    arm64.mov x2, #65
    arm64.cmp x1, x0
    arm64.cset x0, le
    arm64.cmp x1, x2
    arm64.cset x2, ge
    arm64.ands x3, x2, x0
    arm64.b.eq classify_0.next1
  classify_0.case1:
    arm64.mov x0, #2
    arm64.ret
  classify_0.next1:
    arm64.mov x0, #57
    arm64.mov x2, #48
    arm64.cmp x1, x0
    arm64.cset x0, le
    arm64.cmp x1, x2
    arm64.cset x1, ge
    arm64.ands x2, x1, x0
    arm64.b.eq classify_0.case3
  classify_0.case2:
    arm64.mov x0, #3
    arm64.ret
  classify_0.case3:
    arm64.mov x0, #0
    arm64.ret
  }
}
---
