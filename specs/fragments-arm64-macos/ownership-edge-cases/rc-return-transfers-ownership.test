    arm64.mov x0, #8
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, #99
    arm64.str x0, [x19, #0] (8b)
    arm64.ldr x20, [x19, #0] (8b)
    arm64.mov x0, x19
    arm64.bl mm_drop
    arm64.mov x0, #255
    arm64.cmp x20, x0
    arm64.cset x0, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_f09617b4e82e9d47
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x20
    arm64.epilogue
    arm64.ret
  }
}
