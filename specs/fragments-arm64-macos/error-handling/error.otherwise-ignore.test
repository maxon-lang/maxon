// Test: error.otherwise-ignore

typealias Integer = int(i64.min to i64.max)

// Test try otherwise ignore
enum MyError implements Error
	failed
end 'MyError'

var counter = 0 as Integer

function mayFail() returns Integer throws MyError
	counter = counter + 1
	throw MyError.failed
end 'mayFail'

function main() returns ExitCode
	try mayFail() otherwise ignore
	return 42
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.ldr x1, [x0, #0] (8b)
    arm64.mov x2, #1
    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.add x3, x1, x2
    arm64.str x3, [x0, #0] (8b)
  try_0.otherwise:
    arm64.mov x0, #0
  try_0.merge:
    arm64.mov x0, #42
    arm64.epilogue
    arm64.ret
  }
}
---
