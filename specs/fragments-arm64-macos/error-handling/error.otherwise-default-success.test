// Test: error.otherwise-default-success

typealias Integer = int(i64.min to i64.max)

// Test try otherwise when no error occurs
enum MyError implements Error
	failed
end 'MyError'

function mayFail(shouldFail bool) returns Integer throws MyError
	if shouldFail 'check'
		throw MyError.failed
	end 'check'
	return 100
end 'mayFail'

function main() returns ExitCode
	let val = try mayFail(false) otherwise 42
	return val
end 'main'
---
ExitCode: 100
---
// CompiledIR
module {
  func @mayFail(shouldFail: i1) -> i64 {
  entry:
    arm64.cmp x0, #0
    arm64.b.ne mayFail.check_0
    arm64.b mayFail.check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.mov x1, #1
    arm64.add x2, x0, x1
    arm64.mov x1, x2
    arm64.mov x0, #0
    arm64.ret
  check_0.after:
    arm64.mov x0, #100
    arm64.mov x1, #0
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #0
    arm64.bl mayFail
    arm64.mov x2, #0
    arm64.cmp x1, x2
    arm64.cset x3, ne
    arm64.cmp x3, #0
    arm64.str x0, [x29, #-16]
    arm64.b.ne main.otherwise_default_error_0
    arm64.b main.otherwise_default_success_0
  otherwise_default_error_0:
    arm64.mov x0, #42
    arm64.str x0, [x29, #-8]
    arm64.b main.otherwise_default_continue_0
  otherwise_default_success_0:
    arm64.ldr x0, [x29, #-16]
    arm64.str x0, [x29, #-8]
    arm64.b main.otherwise_default_continue_0
  otherwise_default_continue_0:
    arm64.ldr x0, [x29, #-8]
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x3, #255
    arm64.cmp x0, x3
    arm64.cset x4, gt
    arm64.orr x5, x2, x4
    arm64.cmp x5, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_2
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
