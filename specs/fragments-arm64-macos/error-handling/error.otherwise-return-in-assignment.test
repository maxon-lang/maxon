// Test: error.otherwise-return-in-assignment

typealias Integer = int(i64.min to i64.max)

// Single-statement otherwise: success path still yields a value
enum MyError implements Error
	failed
end 'MyError'

function maybeFail(flag bool) returns Integer throws MyError
	if flag 'check'
		throw MyError.failed
	end 'check'
	return 42
end 'maybeFail'

function runIt(flag bool) returns Integer
	let value = try maybeFail(flag) otherwise return -1
	return value
end 'runIt'

function main() returns ExitCode
	let good = runIt(false)
	if good == 42 'checkGood'
		let bad = runIt(true)
		if bad == -1 'checkBad'
			return 7
		end 'checkBad'
	end 'checkGood'
	return 0
end 'main'
---
ExitCode: 7
---
// CompiledIR
module {
  func @maybeFail(flag: i1) -> i64 {
  entry:
    arm64.cmp x0, #0
    arm64.b.ne maybeFail.check_0
    arm64.b maybeFail.check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.mov x1, #1
    arm64.add x2, x0, x1
    arm64.mov x1, x2
    arm64.mov x0, #0
    arm64.ret
  check_0.after:
    arm64.mov x0, #42
    arm64.mov x1, #0
    arm64.ret
  }
  func @runIt(flag: i1) -> i64 {
  entry:
    arm64.prologue stack_size=48
    arm64.bl maybeFail
    arm64.str x0, [x29, #-8]
    arm64.mov x0, #0
    arm64.cmp x1, x0
    arm64.cset x2, ne
    arm64.cmp x2, #0
    arm64.b.ne runIt.otherwise_stmt_0
    arm64.b runIt.otherwise_continue_0
  otherwise_stmt_0:
    arm64.mov x0, #-1
    arm64.epilogue stack_size=48
    arm64.ret
  otherwise_continue_0:
    arm64.ldr x0, [x29, #-8]
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #0
    arm64.bl runIt
    arm64.mov x1, #42
    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne main.checkGood_0
    arm64.b main.checkGood_0.merge
  checkGood_0:
    arm64.mov x0, #1
    arm64.bl runIt
    arm64.mov x1, #-1
    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne main.checkBad_0
    arm64.b main.checkBad_0.after
  checkBad_0:
    arm64.mov x0, #7
    arm64.epilogue stack_size=16
    arm64.ret
  checkBad_0.after:
    arm64.b main.checkGood_0.merge
  checkGood_0.merge:
    arm64.mov x0, #0
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
