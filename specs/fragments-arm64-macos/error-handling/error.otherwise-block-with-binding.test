    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.add x3, x1, x2
    arm64.str x3, [x0, #0] (8b)
    arm64.mov x0, #1
    arm64.mov x1, #0
  try_0.otherwise:
