    arm64.mov x2, #1
    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.add x3, x1, x2
    arm64.str x3, [x0, #0] (8b)
    arm64.mov x0, #1
    arm64.mov x1, #0
  try_0.otherwise:
    arm64.mov x2, #1
    arm64.mov x3, #0
    arm64.sub x4, x0, x2
    arm64.cmp x4, x3
    arm64.cset x0, eq
    arm64.b.ne check_0.merge
    arm64.b check_0.case0
  check_0.merge:
    arm64.mov x2, #0
    arm64.mov x0, x1
    arm64.b try_0.merge
  check_0.case0:
    arm64.mov x1, #42
    arm64.b check_0.merge
  try_0.merge:
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x1, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_448bb8da13ae287b
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue
    arm64.ret
  }
}
