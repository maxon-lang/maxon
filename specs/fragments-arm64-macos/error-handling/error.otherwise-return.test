// Test: error.otherwise-return

typealias Integer = int(i64.min to i64.max)

// Single-statement otherwise: return on error
enum MyError implements Error
	failed
end 'MyError'

function mayFail() returns Integer throws MyError
	throw MyError.failed
end 'mayFail'

function runIt() returns Integer
	let value = try mayFail() otherwise return -1
	return value
end 'runIt'

function main() returns ExitCode
	let v = runIt()
	if v == -1 'check'
		return 99
	end 'check'
	return 0
end 'main'
---
ExitCode: 99
---
// CompiledIR
module {
  func @mayFail() -> i64 {
  entry:
    arm64.mov x0, #0
    arm64.mov x1, #1
    arm64.add x2, x0, x1
    arm64.mov x1, x2
    arm64.mov x0, #0
    arm64.ret
  }
  func @runIt() -> i64 {
  entry:
    arm64.prologue stack_size=48
    arm64.bl mayFail
    arm64.str x0, [x29, #-8]
    arm64.mov x0, #0
    arm64.cmp x1, x0
    arm64.cset x2, ne
    arm64.cmp x2, #0
    arm64.b.ne runIt.otherwise_stmt_0
    arm64.b runIt.otherwise_continue_0
  otherwise_stmt_0:
    arm64.mov x0, #-1
    arm64.epilogue stack_size=48
    arm64.ret
  otherwise_continue_0:
    arm64.ldr x0, [x29, #-8]
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.bl runIt
    arm64.mov x1, #-1
    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne main.check_0
    arm64.b main.check_0.after
  check_0:
    arm64.mov x0, #99
    arm64.epilogue stack_size=16
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
