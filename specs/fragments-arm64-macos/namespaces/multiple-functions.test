    arm64.add x2, x1, x0
    arm64.mov x0, #0
    arm64.cmp x2, x0
    arm64.cset x1, lt
    arm64.mov x0, #255
    arm64.cmp x2, x0
    arm64.cset x3, gt
    arm64.orr x0, x1, x3
    arm64.cmp x0, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_1
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x2
    arm64.epilogue stack_size=32
    arm64.ret
  }
}
