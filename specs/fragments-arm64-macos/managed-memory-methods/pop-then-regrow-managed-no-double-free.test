  free_buf_0:
    arm64.ldr x0, [x29, #-8]
    arm64.bl mm_decref_managed_elements
    arm64.ldr x1, [x29, #-8]
    arm64.ldr x2, [x1, #32]
    arm64.mov x3, #-3
    arm64.cmp x2, x3
    arm64.cset x4, ne
    arm64.cmp x4, #0
    arm64.b.ne __destruct_StrArray.raw_free_0
    arm64.b __destruct_StrArray.skip_buf_0
  raw_free_0:
    arm64.ldr x0, [x29, #-8]
    arm64.ldr x1, [x0, #0]
    arm64.mov x0, x1
    arm64.bl mm_raw_free
    arm64.b __destruct_StrArray.skip_buf_0
  skip_buf_0:
    arm64.b __destruct_StrArray.done
  done:
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
---
