// Test: first-class-function.non-capturing-closure-returned

typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

function pick() returns UnaryOp
	return function(n Integer) gives n * 2
end 'pick'

function main() returns ExitCode
	let f = pick()
	return f(21)
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @pick() -> fn(Integer) returns Integer {
  entry:
    arm64.adrp_add_func x0, _$closure_12
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.bl pick
    arm64.mov x1, #21
    arm64.mov x2, #0
    arm64.str x0, [x29, #-8]
    arm64.mov x9, x0
    arm64.mov x0, x1
    arm64.mov x1, x2
    arm64.blr x9
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x3, gt
    arm64.orr x1, x2, x3
    arm64.cmp x1, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_28
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue stack_size=32
    arm64.ret
  }
}
