    arm64.mov x1, #2
    arm64.mul x2, x0, x1
    arm64.mov x0, x2
    arm64.ret
  }
  func @trip(n: i64) -> i64 {
  entry:
    arm64.mov x1, #3
    arm64.mul x2, x0, x1
    arm64.mov x0, x2
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.bl useDbl
    arm64.str x0, [x29, #-8]
