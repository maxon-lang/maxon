// Test: enum-allcasenames.union-associated
typealias Integer = int(i64.min to i64.max)

union Container
	empty
	value(n Integer)
	pair(a Integer, b Integer)
end 'Container'

function main() returns ExitCode
	for name in Container.allCaseNames 'loop'
		print("{name}\n")
	end 'loop'
	return 0
end 'main'
