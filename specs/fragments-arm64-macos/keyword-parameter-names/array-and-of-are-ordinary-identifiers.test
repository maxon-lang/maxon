// Test: array-and-of-are-ordinary-identifiers
typealias StdType = int(i64.min to i64.max)

function repeated(array StdType, of StdType) returns StdType
	return array * of
end 'repeated'

function main() returns ExitCode
	let array = 6
	let of = 7
	return repeated(array, of: of)
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @repeated(array: i64, of: i64) -> i64 {
  entry:
    arm64.mul x2, x0, x1
    arm64.mov x0, x2
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #6
    arm64.mov x1, #7
    arm64.bl repeated
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x3, gt
    arm64.orr x1, x2, x3
    arm64.cmp x1, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_0
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
