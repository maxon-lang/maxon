// Test: current-directory-not-empty
function main() returns ExitCode
	let cwd = Directory.currentPath()
	if cwd.toString().count() > 0 'ok'
		return 42
	end 'ok'
	return 0
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.bl Directory.currentPath
    arm64.mov x19, x0
    arm64.ldr x20, [x19, #0] (8b)
    arm64.mov x0, #8
    arm64.sub x1, x20, x0
    arm64.atomic_inc [x1]
    arm64.mov x0, x20
    arm64.bl String.count
    arm64.mov x21, x0
    arm64.mov x0, x19
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, x20
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, #0
    arm64.cmp x21, x0
    arm64.cset x0, gt
    arm64.b.le ok_0.after
  ok_0:
    arm64.mov x0, #42
    arm64.epilogue
    arm64.ret
  ok_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
---
