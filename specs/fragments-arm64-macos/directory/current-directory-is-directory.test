// Test: current-directory-is-directory
function main() returns ExitCode
	let cwd = Directory.currentPath()
	if Directory.exists(cwd) 'ok'
		return 42
	end 'ok'
	return 0
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.bl Directory.currentPath
    arm64.mov x19, x0
    arm64.ldr x0, [x19, #0] (8b)
    arm64.ldr x1, [x0, #0] (8b)
    arm64.mov x0, x1
    arm64.bl mrt_directory_exists
    arm64.mov x20, x0
    arm64.mov x0, x19
    arm64.bl __mm_decref_maybenull_helper
    arm64.cmp x20, #0
    arm64.b.eq ok_0.after
  ok_0:
    arm64.mov x0, #42
    arm64.epilogue
    arm64.ret
  ok_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
