// Test: stdlib-call-exp
function main() returns ExitCode
	let result = Math.exp(0.0)
	if result == 1.0 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.ldr d0, [rdata+__float_0]
    arm64.bl Math.exp
    arm64.ldr d1, [rdata+__float_4607182418800017408]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #42
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
---
