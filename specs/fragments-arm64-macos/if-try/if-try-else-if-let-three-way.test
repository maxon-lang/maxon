module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
  fallback_0:
    arm64.mov x0, #7
  b_0.merge:
  a_0.merge:
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x1, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_9b0b2428c8d11347
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue
    arm64.ret
  }
}
