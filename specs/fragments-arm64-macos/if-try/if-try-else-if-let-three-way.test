    arm64.ldr x0, [x29, #-8]
    arm64.str x0, [x29, #-16]
    arm64.b main.a_0.merge
  a_0.elseif:
    arm64.bl tryB
    arm64.str x0, [x29, #-24]
    arm64.mov x0, #0
    arm64.cmp x1, x0
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne main.b_0
    arm64.b main.fallback_0
  b_0:
    arm64.ldr x0, [x29, #-24]
    arm64.str x0, [x29, #-16]
    arm64.b main.b_0.merge
  fallback_0:
    arm64.mov x0, #7
    arm64.str x0, [x29, #-16]
    arm64.b main.b_0.merge
  b_0.merge:
    arm64.b main.a_0.merge
  a_0.merge:
    arm64.ldr x0, [x29, #-16]
    arm64.mov x1, #0
    arm64.cmp x0, x1
