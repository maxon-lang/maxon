    arm64.str x0, [x29, #-24]
    arm64.b main.check_0.merge
  check_0.elseif:
    arm64.mov x0, #2
    arm64.ldr x1, [x29, #-8]
    arm64.cmp x1, x0
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne main.two_0
    arm64.b main.fallback_0
  two_0:
    arm64.mov x0, #22
    arm64.str x0, [x29, #-24]
    arm64.b main.two_0.merge
  fallback_0:
    arm64.mov x0, #99
    arm64.str x0, [x29, #-24]
    arm64.b main.two_0.merge
  two_0.merge:
    arm64.b main.check_0.merge
  check_0.merge:
    arm64.ldr x0, [x29, #-24]
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x3, #255
    arm64.cmp x0, x3
    arm64.cset x4, gt
    arm64.orr x5, x2, x4
    arm64.cmp x5, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_19
