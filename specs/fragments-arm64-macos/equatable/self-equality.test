// Test: self-equality

typealias Integer = int(i64.min to i64.max)

type Box implements Equatable
	export var value as Integer

	function equals(other Box) returns bool
		return value == other.value
	end 'equals'

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Box'

function main() returns ExitCode
	let a = Box.create(7)
	if a.equals(a) 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x1, #0
    arm64.mov x0, #8
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, #7
    arm64.str x0, [x19, #0] (8b)
    arm64.ldr x20, [x19, #0] (8b)
    arm64.ldr x21, [x19, #0] (8b)
    arm64.mov x0, x19
    arm64.bl mm_drop
    arm64.cmp x21, x20
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  }
}
---
