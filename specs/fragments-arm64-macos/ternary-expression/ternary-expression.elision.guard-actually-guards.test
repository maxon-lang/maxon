// Test: ternary-expression.elision.guard-actually-guards
typealias Integer = int(i64.min to i64.max)

function safeDiv(n Integer, d Integer) returns Integer
	return 0 if d == 0 else (n / d)
end 'safeDiv'

function main() returns ExitCode
	let guarded = safeDiv(100, d: 0) // the divide is in the arm NOT selected
	let divided = safeDiv(100, d: 5)
	return (guarded + divided) as ExitCode
end 'main'
---
ExitCode: 20
---
// CompiledIR
module {
  func @safeDiv(n: i64, d: i64) -> i64 {
  entry:
    arm64.prologue stack_size=80
    arm64.str x0, [x29, #-8]
    arm64.str x1, [x29, #-16]
    arm64.mov x0, #0
    arm64.cmp x1, x0
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne safeDiv.ternary_0.true
    arm64.b safeDiv.ternary_0.false
  ternary_0.true:
    arm64.mov x0, #0
    arm64.str x0, [x29, #-24]
    arm64.b safeDiv.ternary_0.merge
  ternary_0.false:
    arm64.ldr x0, [x29, #-8]
    arm64.ldr x1, [x29, #-16]
    arm64.cmp x1, #0
    arm64.b.ne safeDiv.__div_ok_0
    arm64.bl mrt_div_by_zero
    arm64.label safeDiv.__div_ok_0
    arm64.sdiv x2, x0, x1
    arm64.str x2, [x29, #-24]
    arm64.b safeDiv.ternary_0.merge
  ternary_0.merge:
    arm64.ldr x0, [x29, #-24]
    arm64.epilogue stack_size=80
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x0, #100
    arm64.mov x1, #0
    arm64.bl safeDiv
    arm64.str x0, [x29, #-8]
    arm64.mov x0, #100
    arm64.mov x1, #5
    arm64.bl safeDiv
    arm64.ldr x1, [x29, #-8]
    arm64.add x2, x1, x0
    arm64.mov x0, #0
    arm64.cmp x2, x0
    arm64.cset x1, lt
    arm64.mov x0, #255
    arm64.cmp x2, x0
    arm64.cset x3, gt
    arm64.orr x0, x1, x3
    arm64.cmp x0, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_21
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, #0
    arm64.cmp x2, x0
    arm64.cset x1, lt
    arm64.mov x0, #255
    arm64.cmp x2, x0
    arm64.cset x3, gt
    arm64.orr x0, x1, x3
    arm64.cmp x0, #0
    arm64.b.ne main.__range_panic_1
    arm64.b main.__range_ok_1
  __range_panic_1:
    arm64.adrp_add_symdata x0, __panic_msg_21
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_1:
