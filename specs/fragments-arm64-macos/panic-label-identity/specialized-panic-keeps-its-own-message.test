// Test: specialized-panic-keeps-its-own-message
function main() returns ExitCode
	let s = "  héllo wörld  "
	var n = s.trim(CharacterSet.letters()).count()
	n = n + s.bytes().count()
	for cp in "héllo".codepoints() 'c'
		n = n + cp
	end 'c'
	for u in "h€llo".utf16() 'u'
		n = n + u
	end 'u'
	let m = ["a": 1, "b": 2]
	n = n + m.count()
	print("{n}\n")
	var a = [10, 20, 30]
	a.resize(-2)
	return 0
end 'main'
---
ExitCode: 1
