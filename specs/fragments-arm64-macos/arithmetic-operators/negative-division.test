// Test: negative-division
function main() returns ExitCode
	let neg = -7
	let a = neg / 2           // -7/2 = -3 (truncating toward zero)
	if a == -3 'pass'
			return 0
	end 'pass'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #2
    arm64.mov x1, #-7
    arm64.sdiv x2, x1, x0
    arm64.mov x0, #-3
    arm64.cmp x2, x0
    arm64.cset x0, eq
    arm64.b.ne pass_0.after
  pass_0:
    arm64.mov x0, #0
    arm64.ret
  pass_0.after:
    arm64.mov x0, #1
    arm64.ret
  }
}
---
