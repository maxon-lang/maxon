    arm64.ldr x2, [x29, #16]
    arm64.mov x1, #67
    arm64.mov x0, x19
    arm64.bl Array.push
    arm64.adrp_add_rdata x0, __witness_int_Equatable
    arm64.ldr x3, [x29, #16]
    arm64.adrp_add_rdata x0, __witness_int_Hashable
    arm64.ldr x2, [x29, #16]
    arm64.adrp_add_rdata x0, __layout_Array_ByteVal
    arm64.ldr x1, [x29, #16]
    arm64.mov x0, x19
    arm64.bl Array.hash
    arm64.mov x20, x0
    arm64.mov x0, x19
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, #0
    arm64.cmp x20, x0
    arm64.cset x0, ne
    arm64.b.eq nonzero_0.after
  nonzero_0:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  nonzero_0.after:
    arm64.mov x0, #0
