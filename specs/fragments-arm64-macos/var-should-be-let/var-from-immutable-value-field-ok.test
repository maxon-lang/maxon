// Test: var-from-immutable-value-field-ok

typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let p = Point.create(1, y: 2)
	var x = p.x
	x = 99
	return x
end 'main'
---
ExitCode: 99
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x1, #0
    arm64.mov x0, #16
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, #1
    arm64.str x0, [x19, #0] (8b)
    arm64.mov x0, #2
    arm64.str x0, [x19, #8] (8b)
    arm64.ldr x0, [x19, #0] (8b)
    arm64.mov x0, x19
    arm64.bl mm_drop
    arm64.mov x0, #99
    arm64.epilogue
    arm64.ret
  }
}
---
