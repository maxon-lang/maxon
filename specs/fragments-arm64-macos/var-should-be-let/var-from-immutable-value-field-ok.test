    arm64.mov x2, #1
    arm64.bl mm_alloc
    arm64.str x0, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.ldr x1, [x29, #-16]
    arm64.str x1, [x0, #0]
    arm64.ldr x2, [x29, #-8]
    arm64.ldr x3, [x29, #-24]
    arm64.str x3, [x2, #8]
    arm64.ldr x4, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.bl mm_incref
    arm64.ldr x5, [x29, #-8]
    arm64.mov x0, x5
    arm64.epilogue stack_size=64
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #1
    arm64.mov x1, #2
    arm64.bl Point.create
    arm64.str x0, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.cmp x0, #0
    arm64.b.eq main.__skip_guarded_6
    arm64.bl mm_decref
    arm64.label main.__skip_guarded_6
    arm64.mov x0, #99
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @__destruct_Point(ptr: i64) {
