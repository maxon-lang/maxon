// Test: try-impure-let-discard

typealias Integer = int(i64.min to i64.max)

var counter = 0 as Integer

enum ParseError implements Error
	invalidFormat
end 'ParseError'

function parseNum(s String) returns Integer throws ParseError
	counter = counter + s.byteLength()
	throw ParseError.invalidFormat
end 'parseNum'

function main() returns ExitCode
	_ = try parseNum("abc") otherwise 0
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @parseNum(s: i64) -> i64 {
  entry:
    arm64.prologue stack_size=48
    arm64.global_load x1, [counter]
    arm64.str x0, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.ldr x2, [x0, #8]
    arm64.add x0, x1, x2
    arm64.global_store [counter], x0
    arm64.mov x1, #0
    arm64.mov x2, #1
    arm64.add x3, x1, x2
    arm64.mov x1, x3
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.adrp_add_global x0, __static_lit_1
    arm64.mov x1, x0
    arm64.mov x2, #32
    arm64.add x3, x1, x2
    arm64.str x3, [x29, #-8]
    arm64.ldr x4, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.bl mm_incref
    arm64.ldr x5, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.bl parseNum
    arm64.mov x6, #0
    arm64.cmp x1, x6
    arm64.cset x7, ne
    arm64.cmp x7, #0
    arm64.b.ne main.otherwise_default_error_0
    arm64.b main.otherwise_default_success_0
  otherwise_default_error_0:
    arm64.b main.otherwise_default_continue_0
  otherwise_default_success_0:
    arm64.b main.otherwise_default_continue_0
  otherwise_default_continue_0:
    arm64.ldr x0, [x29, #-8]
    arm64.cmp x0, #0
    arm64.b.eq main.__skip_guarded_16
    arm64.bl mm_decref
    arm64.label main.__skip_guarded_16
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
---
