// Test: impure-function-let-discard

typealias Integer = int(i64.min to i64.max)

var counter = 0 as Integer

function incrementAndGet() returns Integer
	counter = counter + 1
	return counter
end 'incrementAndGet'

function main() returns ExitCode
	_ = incrementAndGet()
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.ldr x1, [x0, #0] (8b)
    arm64.mov x2, #1
    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.add x3, x1, x2
    arm64.str x3, [x0, #0] (8b)
    arm64.adrp_add_rdata x0, __data_counter
    arm64.ldr x0, [x29, #16]
    arm64.ldr x1, [x0, #0] (8b)
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
---
