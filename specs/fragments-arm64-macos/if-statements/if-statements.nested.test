// Test: if-statements.nested
function main() returns ExitCode
	let x = 3
	if x == 1 'outer'
		return 1
	end 'outer' else 'else_outer'
		if x == 2 'inner'
			return 2
		end 'inner' else 'else_inner'
			return 3
		end 'else_inner'
	end 'else_outer'
end 'main'
---
ExitCode: 3
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #3
  else_outer_0:
    arm64.mov x1, #2
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.b.ne else_inner_0
  inner_0:
    arm64.mov x0, #2
    arm64.ret
  else_inner_0:
    arm64.mov x0, #3
    arm64.ret
  }
}
---
