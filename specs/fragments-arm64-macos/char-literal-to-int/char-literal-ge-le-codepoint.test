// Test: char-literal-ge-le-codepoint
function main() returns ExitCode
	let cp = 53
	if cp >= '0' 'ge'
		if cp <= '9' 'le'
			return 0
		end 'le'
	end 'ge'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #53
  ge_0:
    arm64.mov x1, #57
    arm64.cmp x0, x1
    arm64.cset x0, le
    arm64.b.gt ge_0.after
  le_0:
    arm64.mov x0, #0
    arm64.ret
  ge_0.after:
    arm64.mov x0, #1
    arm64.ret
  }
}
---
