// Test: byte-enum-comparison.enum-coerces-to-struct-field

typealias Byte = int(0 to u8.max)

enum Punct
	colon = 58
end 'Punct'

type Token
	export var ch as Byte

	static function create() returns Self
		return Self{ch: Punct.colon}
	end 'create'
end 'Token'

function main() returns ExitCode
	let t = Token.create()
	if t.ch == 58 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @Token.create() -> i64 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #58
    arm64.mov x0, #8
    arm64.mov x1, #0
    arm64.mov x2, #1
    arm64.bl mm_alloc
    arm64.str x0, [x29, #-8]
    arm64.ldr x1, [x29, #-8]
    arm64.mov x2, #58
    arm64.str x2, [x1, #0]
    arm64.ldr x3, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.bl mm_incref
    arm64.ldr x4, [x29, #-8]
    arm64.mov x0, x4
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.bl Token.create
    arm64.str x0, [x29, #-8]
    arm64.ldr x0, [x29, #-8]
    arm64.ldr x1, [x0, #0]
    arm64.mov x2, #58
    arm64.cmp x1, x2
    arm64.cset x3, eq
    arm64.cmp x3, #0
    arm64.b.ne main.ok_0
    arm64.b main.ok_0.after
  ok_0:
    arm64.ldr x0, [x29, #-8]
    arm64.cmp x0, #0
    arm64.b.eq main.__skip_guarded_9
    arm64.bl mm_decref
    arm64.label main.__skip_guarded_9
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  ok_0.after:
    arm64.ldr x0, [x29, #-8]
    arm64.cmp x0, #0
    arm64.b.eq main.__skip_guarded_13
    arm64.bl mm_decref
    arm64.label main.__skip_guarded_13
    arm64.mov x0, #1
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @__destruct_Token(ptr: i64) {
  entry:
    arm64.b __destruct_Token.done
  done:
    arm64.ret
  }
