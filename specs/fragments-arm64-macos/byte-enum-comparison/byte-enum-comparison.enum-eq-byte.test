// Test: byte-enum-comparison.enum-eq-byte

typealias Byte = int(0 to u8.max)

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function main() returns ExitCode
	let s = 32 as Byte
	if Ascii.space == s 'match'
		return 0
	end 'match'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #32
    arm64.mov x1, #32
    arm64.cmp x1, x0
    arm64.cset x2, eq
    arm64.cmp x2, #0
    arm64.b.ne main.match_0
    arm64.b main.match_0.after
  match_0:
    arm64.mov x0, #0
    arm64.ret
  match_0.after:
    arm64.mov x0, #1
    arm64.ret
  }
}
---
