		throw ThrowsHitInner.bad
	end 'c'
	return 5
end 'maybeFail'

function compute() returns Integer throws ThrowsHitOuter
	var total = 0
	try 'work'
		let a = maybeFail(true)
		total = a
	end 'work'
	otherwise throws ThrowsHitOuter.failed
	return total
end 'compute'

function main() returns ExitCode
	let r = try compute() otherwise 99
	return r
end 'main'
