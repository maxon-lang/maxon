    arm64.ldr x1, [x29, #24]
    arm64.ldr x2, [x29, #16]
    arm64.str x2, [x19, #0] (8b)
    arm64.str x1, [x19, #8] (8b)
    arm64.mov x0, x19
    arm64.epilogue
