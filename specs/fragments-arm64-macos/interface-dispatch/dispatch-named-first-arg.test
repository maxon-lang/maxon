    arm64.mov x2, #30
    arm64.mov x4, #12
    arm64.mov x0, x1
    arm64.mov x1, x4
    arm64.ldr x16, [x3, #24] (8b)
    arm64.blr x16
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.epilogue
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x1, #0
    arm64.mov x0, #8
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, #0
    arm64.str x0, [x19, #0] (8b)
    arm64.adrp_add_rdata x0, __witness_Summer_Combiner
    arm64.ldr x1, [x29, #16]
