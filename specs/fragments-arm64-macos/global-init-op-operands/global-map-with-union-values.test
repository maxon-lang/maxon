// Test: global-map-with-union-values
typealias Val = int(i64.min to i64.max)

union Op
	add(value Val)
	nop
end 'Op'

var opMap = [
	b"add": Op.add(5),
	b"nop": Op.nop
]

function main() returns ExitCode
	let op = try opMap.get(b"add") otherwise Op.nop
	return match op 'check'
		add(v) gives v
		nop gives 99
	end 'check'
end 'main'
