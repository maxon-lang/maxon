// Test: byte-max

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 255 as Byte
	if b == 255 'ok'
		return 0
	end 'ok' else 'fail'
		return 1
	end 'fail'
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #0
    arm64.ret
  }
}
---
