    arm64.mov x1, #0
    arm64.mov x2, #0
    arm64.cmp x0, x2
    arm64.cset x3, eq
    arm64.mov x4, #1
    arm64.cmp x3, #0
    arm64.csel x5, x4, x1, ne
    arm64.mov x6, #1
    arm64.cmp x0, x6
    arm64.cset x7, eq
    arm64.mov x8, #3
    arm64.cmp x7, #0
    arm64.csel x9, x8, x5, ne
    arm64.mov x10, #0
    arm64.cmp x9, x10
    arm64.cset x11, lt
    arm64.mov x12, #50
    arm64.cmp x9, x12
    arm64.cset x14, gt
    arm64.orr x15, x11, x14
    arm64.cmp x15, #0
    arm64.b.ne latencyOf.__range_panic_0
    arm64.b latencyOf.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_3
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x9
    arm64.epilogue stack_size=48
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #1
    arm64.bl latencyOf
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x3, gt
    arm64.orr x1, x2, x3
    arm64.cmp x1, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_4
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
