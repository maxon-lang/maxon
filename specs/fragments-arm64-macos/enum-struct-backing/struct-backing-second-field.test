    arm64.mov x5, #2
    arm64.cmp x4, #0
    arm64.csel x6, x5, x2, ne
    arm64.mov x7, #1
    arm64.cmp x1, x7
    arm64.cset x8, eq
    arm64.mov x9, #1
    arm64.cmp x8, #0
    arm64.csel x10, x9, x6, ne
    arm64.mov x11, #0
    arm64.cmp x10, x11
    arm64.cset x12, lt
    arm64.mov x14, #255
    arm64.cmp x10, x14
