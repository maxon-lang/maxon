	a.push(8)
	a.push(46)
	a.push(36)
	a.push(26)
	a.push(16)
	a.push(6)
	a.push(44)
	a.push(34)
	a.push(24)
	a.push(14)
	a.push(4)
	a.push(42)
	a.push(32)
	a.push(22)
	a.push(12)
	a.push(2)
	a.push(49)
	a.push(39)
	a.push(29)
	a.push(19)
	a.push(9)
	a.push(47)
	a.push(37)
	a.push(27)
	a.push(17)
	a.push(7)
	Log.startCapture()
	a.sort(ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "findRun.descending") 'fd'
		print("findRun.descending ")
	end 'fd'
	if Log.fired(keys, key: "driftsort.push") 'pp'
		print("driftsort.push ")
	end 'pp'
	if Log.fired(keys, key: "driftsort.merge") 'pm'
		print("driftsort.merge")
	end 'pm'
	print("\n")
	return 0
end 'main'
