// Test: value-tuple-return-forwarded
typealias Num = int(0 to 1000)

function pair(a Num, b Num) returns (Num, Num)
	return (a + 1, b + 2)
end 'pair'

function forward(a Num, b Num) returns (Num, Num)
	return pair(a, b: b)
end 'forward'

function main() returns ExitCode
	let f = forward(10, b: 20)
	return f._0 + f._1
end 'main'
