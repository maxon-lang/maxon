// Test: small-tuple-return-allocates-nothing
typealias Num = int(0 to 1000)

function pair(a Num, b Num) returns (Num, Num)
	return (a + 1, b + 2)
end 'pair'

function main() returns ExitCode
	let p = pair(10, b: 20)
	print("{p._0} {p._1}")
	return 0
end 'main'
---
MmTrace: true
ExitCode: 0
Stdout: ```
11 22
```
