typealias Num = int(0 to 1000)
typealias PairOp = function(Num, Num) returns (Num, Num)

function pair(a Num, b Num) returns (Num, Num)
	return (a + 1, b + 2)
end 'pair'

function apply(f PairOp) returns Num
	let r = f(10, 20)
	return r._0 + r._1
end 'apply'

function main() returns ExitCode
	return apply(pair)
end 'main'
