// Test: unsigned-full-alias-admits-the-unsigned-extreme
typealias Slot = int(0 to u64.max)

let NO_SLOT = u64.max as Slot

function isSentinel(s Slot) returns bool
	return s == NO_SLOT
end 'isSentinel'

function main() returns ExitCode
	if isSentinel(NO_SLOT) 'yes'
		return 7
	end 'yes'
	return 0
end 'main'
---
ExitCode: 7
---
// CompiledIR
module {
  func @isSentinel(s: i64) -> i1 {
  entry:
    arm64.mov x1, #-1
    arm64.cmp x0, x1
    arm64.cset x2, eq
    arm64.mov x0, x2
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #-1
    arm64.bl isSentinel
    arm64.cmp x0, #0
    arm64.b.ne main.yes_0
    arm64.b main.yes_0.after
  yes_0:
    arm64.mov x0, #7
    arm64.epilogue stack_size=16
    arm64.ret
  yes_0.after:
    arm64.mov x0, #0
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
