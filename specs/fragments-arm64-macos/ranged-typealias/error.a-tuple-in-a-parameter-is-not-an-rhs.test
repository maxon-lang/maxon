// Test: error.a-tuple-in-a-parameter-is-not-an-rhs
typealias Small = int(0 to 100)

function first(t (int, int)) returns Small
	return t.0
end 'first'

function main() returns ExitCode
	return 0 as ExitCode
end 'main'
