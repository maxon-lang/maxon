// Test: type-qualified-u64-max
typealias BigId = int(0 to u64.max)

function getValue() returns BigId
	return u64.max
end 'getValue'

function main() returns ExitCode
	let v = getValue()
	if v == u64.max 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @getValue() -> u64 {
  entry:
    arm64.mov x0, #-1
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.bl getValue
    arm64.mov x1, #-1
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  }
}
---
