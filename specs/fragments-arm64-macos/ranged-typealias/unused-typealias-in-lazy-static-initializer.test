// Test: unused-typealias-in-lazy-static-initializer
typealias Tally = int(0 to 100)

type Box
	static var v = [5 as Tally, 6 as Tally]

	export static function ready() returns ExitCode
		return 0
	end 'ready'
end 'Box'

function main() returns ExitCode
	return Box.ready()
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @Box.ready() -> u8 {
  entry:
    arm64.mov x0, #0
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.bl Box.ready
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x3, gt
    arm64.orr x1, x2, x3
    arm64.cmp x1, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_26
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
