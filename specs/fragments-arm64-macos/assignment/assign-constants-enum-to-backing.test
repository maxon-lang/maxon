// Test: assign-constants-enum-to-backing

typealias Byte = int(0 to u8.max)

enum JsonByte as Byte
	lBracket = 91
	rBracket = 93
end 'JsonByte'

function main() returns ExitCode
	var b = 0 as Byte
	b = JsonByte.lBracket
	return b
end 'main'
---
ExitCode: 91
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #91
    arm64.ret
  }
}
---
