// Test: error.retype-conditional-errors

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let c = false
	var z = 0 as Integer
	if c 'maybe'
		z = "hello"
	end 'maybe'
	print("{z}")
	return 0 as ExitCode
end 'main'
