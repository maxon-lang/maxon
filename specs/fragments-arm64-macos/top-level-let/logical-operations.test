// Test: logical-operations
let BOTH = true and true
let EITHER = false or true
let NEITHER = not false

function main() returns ExitCode
	if BOTH and EITHER and NEITHER 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #1
    arm64.mov x1, #0
    arm64.str x1, [x29, #-8]
    arm64.cmp x0, #0
    arm64.b.ne main.shortAnd_0.rhs
    arm64.b main.shortAnd_0.merge
  shortAnd_0.rhs:
    arm64.mov x0, #1
    arm64.str x0, [x29, #-8]
    arm64.b main.shortAnd_0.merge
  shortAnd_0.merge:
    arm64.ldr x0, [x29, #-8]
    arm64.mov x1, #0
    arm64.str x1, [x29, #-16]
    arm64.cmp x0, #0
    arm64.b.ne main.shortAnd_1.rhs
    arm64.b main.shortAnd_1.merge
  shortAnd_1.rhs:
    arm64.mov x0, #1
    arm64.str x0, [x29, #-16]
    arm64.b main.shortAnd_1.merge
  shortAnd_1.merge:
    arm64.ldr x0, [x29, #-16]
    arm64.cmp x0, #0
    arm64.b.ne main.check_0
    arm64.b main.check_0.after
  check_0:
    arm64.mov x0, #1
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  }
}
---
