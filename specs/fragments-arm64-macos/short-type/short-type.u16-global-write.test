// Test: short-type.u16-global-write
typealias U16 = int(0 to 65535)

var counter = 0 as U16

function main() returns ExitCode
	counter = 99 as U16
	return counter
end 'main'
---
ExitCode: 99
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #99
    arm64.global_store [counter], x0
    arm64.global_load x1, [counter]
    arm64.mov x2, #0
    arm64.cmp x1, x2
    arm64.cset x3, lt
    arm64.mov x4, #255
    arm64.cmp x1, x4
    arm64.cset x5, gt
    arm64.orr x6, x3, x5
    arm64.cmp x6, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_0
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x1
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
