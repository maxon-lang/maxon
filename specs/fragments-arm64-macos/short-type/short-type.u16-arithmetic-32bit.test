// Test: short-type.u16-arithmetic-32bit
typealias U16 = int(0 to 65535)

function main() returns ExitCode
	let a = 1000 as U16
	let b = 500 as U16
	return a - b
end 'main'
---
ExitCode: 500
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #1000
    arm64.mov x1, #500
    arm64.sub x2, x0, x1
    arm64.mov x3, #0
    arm64.cmp x2, x3
    arm64.cset x4, lt
    arm64.mov x5, #255
    arm64.cmp x2, x5
    arm64.cset x6, gt
    arm64.orr x7, x4, x6
    arm64.cmp x7, #0
    arm64.b.ne main.__range_panic_0
    arm64.b main.__range_ok_0
  __range_panic_0:
    arm64.adrp_add_symdata x0, __panic_msg_0
    arm64.mov x1, x0
    arm64.mov x0, x1
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x2
    arm64.epilogue stack_size=16
    arm64.ret
  }
}
---
