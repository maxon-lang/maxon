// Test: tobytearray-is-independent-of-an-owned-source
function main() returns ExitCode
	let who = "ello"
	let s = "H{who}"
	var arr = s.toByteArray()
	try arr.set(0, value: 74) otherwise panic("set")
	let b0 = try arr.get(0) otherwise panic("get")
	print("s={s} arr[0]={b0}")
	return 0
end 'main'
