// Test: case-conversion-does-not-mutate-receiver
function main() returns ExitCode
	var a = "Hello World"
	let lower = a.toLower()
	let upper = a.toUpper()
	print("{a}\n")
	print("{lower}\n")
	print("{upper}\n")
	return 0
end 'main'
