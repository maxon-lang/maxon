// Test: comparison-with-int
enum State
	idle
	running
	done
end 'State'

function main() returns ExitCode
	let s = State.running
	if s >= State.idle and s <= State.done 'inRange'
		return 1
	end 'inRange'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #1
  shortAnd.rhs:
    arm64.mov x1, #2
    arm64.cmp x0, x1
    arm64.cset x0, le
  shortAnd.merge:
    arm64.cmp x0, #0
    arm64.b.eq inRange_0.after
  inRange_0:
    arm64.mov x0, #1
    arm64.ret
  inRange_0.after:
    arm64.mov x0, #0
    arm64.ret
  }
}
---
