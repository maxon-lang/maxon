// Test: basic-int
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	if c == Color.green 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #1
    arm64.ret
  }
}
---
