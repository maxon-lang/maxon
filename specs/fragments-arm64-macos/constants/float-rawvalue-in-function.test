module {
  func @main() -> u8 {
  entry:
    arm64.ldr d0, [rdata+__float_4611686018427387904]
    arm64.ldr d1, [rdata+__float_4612811918334230528]
    arm64.fcmp d1, d0
    arm64.cset x0, gt
    arm64.b.le check_0.after
  check_0:
    arm64.mov x0, #1
    arm64.ret
  check_0.after:
    arm64.mov x0, #0
    arm64.ret
  }
}
