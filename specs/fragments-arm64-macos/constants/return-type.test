// Test: return-type
enum Result
	success
	failure
end 'Result'

function getResult(succeed bool) returns Result
	if succeed 'check'
		return Result.success
	end 'check'
	return Result.failure
end 'getResult'

function main() returns ExitCode
	let r = getResult(true)
	if r == Result.success 'test'
		return 1
	end 'test'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @getResult(x0: i1) -> u8 {
  entry:
    arm64.cmp x0, #0
    arm64.b.eq check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.mov x0, #1
    arm64.bl getResult
    arm64.mov x1, #0
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.b.ne test_0.after
  test_0:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  test_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
---
