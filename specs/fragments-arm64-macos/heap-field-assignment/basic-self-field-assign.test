    arm64.mov x0, #1
    arm64.str x0, [x20, #0] (8b)
    arm64.ldr x0, [x20, #8] (8b)
    arm64.str x19, [x20, #8] (8b)
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x1, #0
    arm64.mov x0, #8
    arm64.bl stdlib.__mm_alloc
    arm64.mov x19, x0
    arm64.mov x0, x19
    arm64.bl stdlib.__mm_incref
    arm64.mov x0, #20
    arm64.str x0, [x19, #0] (8b)
    arm64.ldr x0, [x20, #8] (8b)
    arm64.str x19, [x20, #8] (8b)
    arm64.bl __mm_decref_maybenull_helper
    arm64.ldr x0, [x20, #8] (8b)
    arm64.ldr x19, [x0, #0] (8b)
