// Test: int-call-result-used-later

typealias Integer = int(i64.min to i64.max)

function compute() returns Integer
	return 100
end 'compute'

function main() returns ExitCode
	let a = compute()
	let b = compute()
	return (a + b) and 125
end 'main'
---
ExitCode: 72
RequiredIRSelfhosted: ```
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #72
    arm64.ret
  }
}

```
