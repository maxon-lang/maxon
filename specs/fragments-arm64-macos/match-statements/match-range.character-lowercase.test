// Test: match-range.character-lowercase
function main() returns ExitCode
	let c = 'm'
	match c 'classify'
		'a' to 'z' then return 1
		'A' to 'Z' then return 2
		default then return 0
	end 'classify'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #1
    arm64.ret
  }
}
---
