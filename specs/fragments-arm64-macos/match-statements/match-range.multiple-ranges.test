// Test: match-range.multiple-ranges
function main() returns ExitCode
	let score = 85
	match score 'grade'
		90 to 100 then return 65
		80 upto 90 then return 66
		70 upto 80 then return 67
		default then return 70
	end 'grade'
end 'main'
---
ExitCode: 66
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x1, #85
  grade_0.next0:
    arm64.mov x0, #90
    arm64.mov x2, #80
    arm64.cmp x1, x0
    arm64.cset x0, lt
    arm64.cmp x1, x2
    arm64.cset x2, ge
    arm64.ands x3, x2, x0
    arm64.b.eq grade_0.next1
  grade_0.case1:
    arm64.mov x0, #66
    arm64.ret
  grade_0.next1:
    arm64.mov x0, #80
    arm64.mov x2, #70
    arm64.cmp x1, x0
    arm64.cset x0, lt
    arm64.cmp x1, x2
    arm64.cset x1, ge
    arm64.ands x2, x1, x0
    arm64.b.eq grade_0.case3
  grade_0.case2:
    arm64.mov x0, #67
    arm64.ret
  grade_0.case3:
    arm64.mov x0, #70
    arm64.ret
  }
}
---
