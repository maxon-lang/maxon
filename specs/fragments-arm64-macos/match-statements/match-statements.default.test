// Test: match-statements.default
function main() returns ExitCode
	let x = 99
	match x 'check'
		1 then return 10
		2 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #99
  check_0.next0:
    arm64.mov x1, #2
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.b.ne check_0.case2
  check_0.case1:
    arm64.mov x0, #20
    arm64.ret
  check_0.case2:
    arm64.mov x0, #0
    arm64.ret
  }
}
---
