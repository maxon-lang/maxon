// Test: match-range.inclusive-boundary
function main() returns ExitCode
	let x = 1
	match x 'check'
		1 to 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=48
    arm64.mov x0, #1
    arm64.str x0, [x29, #-8]
    arm64.ldr x1, [x29, #-8]
    arm64.mov x2, #1
    arm64.sub x3, x1, x2
    arm64.mov x4, #4
    arm64.cmp x3, x4
    arm64.cset x5, hi
    arm64.cmp x5, #0
    arm64.b.ne main.check_0.dispatch0
    arm64.b main.check_0.case0
  check_0.dispatch0:
    arm64.b main.check_0.case1
  check_0.case0:
    arm64.mov x0, #1
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.case1:
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.merge:
  }
}
---
