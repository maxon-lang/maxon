// Test: docs-example-11
function main() returns ExitCode
	let x = 50
	match x 'check'
		1 to 10 or 90 to 100 then return 1   // extreme values
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x1, #50
    arm64.b check_0.cmp1
  check_0.case0:
    arm64.mov x0, #1
    arm64.ret
  check_0.cmp1:
    arm64.mov x0, #100
    arm64.mov x2, #90
    arm64.cmp x1, x0
    arm64.cset x0, le
    arm64.cmp x1, x2
    arm64.cset x2, ge
    arm64.ands x3, x2, x0
    arm64.b.eq check_0.case1
    arm64.b check_0.case0
  check_0.case1:
    arm64.mov x0, #0
    arm64.ret
  }
}
---
