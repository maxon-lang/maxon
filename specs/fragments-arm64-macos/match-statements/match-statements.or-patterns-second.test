// Test: match-statements.or-patterns-second
function main() returns ExitCode
	let x = 2
	match x 'check'
		1 or 2 then return 10
		3 or 4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 10
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #10
    arm64.ret
  }
}
---
