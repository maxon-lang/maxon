// Test: match-statements.try-propagate
typealias Tally = int(0 to 100)

enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) throws Err
	match kind 'k'
		1 then try leaf()
		default throws Err.bad
	end 'k'
end 'dispatch'

function main() returns ExitCode
	try dispatch(1) otherwise ignore
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x2, #1
  inlined_dispatch_0_0:
    arm64.mov x0, #1
    arm64.cmp x2, x0
    arm64.cset x0, eq
    arm64.b.ne inlined_dispatch_6_0
  inlined_dispatch_2_0:
    arm64.mov x1, #1
  inlined_dispatch_4_0:
    arm64.mov x0, #0
    arm64.b inline_cont_main_0
  inlined_dispatch_6_0:
    arm64.mov x1, #1
    arm64.mov x0, #0
  inline_cont_main_0:
    arm64.mov x0, #0
    arm64.cmp x1, x0
    arm64.cset x0, ne
    arm64.b.eq try_0.merge
  try_0.otherwise:
    arm64.mov x0, #0
    arm64.mov x2, x0
  try_0.merge:
    arm64.mov x0, #0
    arm64.ret
  }
}
