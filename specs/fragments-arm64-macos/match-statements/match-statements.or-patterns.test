    arm64.str x0, [x29, #-8]
    arm64.ldr x1, [x29, #-8]
    arm64.mov x2, #1
    arm64.sub x3, x1, x2
    arm64.mov x4, #1
    arm64.cmp x3, x4
    arm64.cset x5, hi
    arm64.cmp x5, #0
    arm64.b.ne main.check_0.dispatch0
    arm64.b main.check_0.case0
  check_0.dispatch0:
    arm64.mov x0, #3
    arm64.ldr x1, [x29, #-8]
    arm64.sub x2, x1, x0
    arm64.mov x3, #2
    arm64.cmp x2, x3
    arm64.cset x4, hi
    arm64.cmp x4, #0
    arm64.b.ne main.check_0.dispatch1
    arm64.b main.check_0.case1
  check_0.dispatch1:
    arm64.b main.check_0.case2
  check_0.case0:
    arm64.mov x0, #10
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.case1:
    arm64.mov x0, #20
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.case2:
    arm64.mov x0, #0
    arm64.epilogue stack_size=48
    arm64.ret
  check_0.merge:
  }
}
