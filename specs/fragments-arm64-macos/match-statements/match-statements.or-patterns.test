// Test: match-statements.or-patterns
function main() returns ExitCode
	let x = 3
	match x 'check'
		1 or 2 then return 10
		3 or 4 or 5 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.mov x0, #3
  check_0.next0:
    arm64.mov x1, #4
    arm64.mov x2, #3
    arm64.mov x3, #5
    arm64.cmp x0, x1
    arm64.cset x1, eq
    arm64.cmp x0, x2
    arm64.cset x2, eq
    arm64.cmp x0, x3
    arm64.cset x0, eq
    arm64.orr x3, x2, x1
    arm64.orr x1, x3, x0
    arm64.cmp x1, #0
    arm64.b.eq check_0.case2
  check_0.case1:
    arm64.mov x0, #20
    arm64.ret
  check_0.case2:
    arm64.mov x0, #0
    arm64.ret
  }
}
---
