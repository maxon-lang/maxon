module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.adrp_add_rdata x0, __data_Config.value
    arm64.ldr x0, [x29, #16]
    arm64.ldr x1, [x0, #0] (8b)
    arm64.ldr x0, [x1, #0] (8b)
    arm64.mov x1, #255
    arm64.cmp x0, x1
    arm64.cset x1, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_b9e28ea05edf259d
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.epilogue
    arm64.ret
  }
}
