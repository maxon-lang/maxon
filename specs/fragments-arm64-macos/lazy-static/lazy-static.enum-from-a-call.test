// Test: lazy-static.enum-from-a-call
enum Color
	Red
	Green
	Blue
end 'Color'

function pick() returns Color
	return Color.Green
end 'pick'

type Box
	static var c = pick()
end 'Box'

function main() returns ExitCode
	print("{Box.c.rawValue}")
	if Box.c == Color.Green 'g'
		print(" G")
	end 'g'
	Box.c = Color.Blue
	print(" {Box.c.rawValue}")
	return 0
end 'main'
