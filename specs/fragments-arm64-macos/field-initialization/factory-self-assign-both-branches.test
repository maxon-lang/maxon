    arm64.mov x19, x0
    arm64.b br_0.merge
  other_0:
    arm64.mov x0, #-42
    arm64.mov x19, x0
  br_0.merge:
    arm64.mov x1, #0
    arm64.mov x0, #8
    arm64.bl stdlib.__mm_alloc
    arm64.mov x20, x0
    arm64.mov x0, x20
    arm64.bl stdlib.__mm_incref
    arm64.str x19, [x20, #0] (8b)
    arm64.mov x0, x20
    arm64.epilogue
    arm64.ret
  }
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=32
    arm64.mov x0, #1
    arm64.bl Branched.make
    arm64.mov x1, x0
    arm64.ldr x19, [x1, #0] (8b)
    arm64.mov x0, x1
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, #255
    arm64.cmp x19, x0
    arm64.cset x0, hi
    arm64.b.ls __range_ok_0
  __range_panic_0:
    arm64.adrp_add_rdata x0, __panic_msg_9dcdf2b68cf3a6dc
    arm64.ldr x19, [x29, #16]
    arm64.mov x0, x19
    arm64.bl mrt_panic
  __range_ok_0:
    arm64.mov x0, x19
    arm64.epilogue
    arm64.ret
  }
}
