// Test: float.hash.zero-normalization
function main() returns ExitCode
	let pos = 0.0
	let neg = -0.0
	let h1 = pos.hash()
	let h2 = neg.hash()
	if h1 == h2 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.ldr d0, [rdata+__float_0]
    arm64.bl float.hash
    arm64.mov x19, x0
    arm64.ldr d0, [rdata+__float_0]
    arm64.ldr d1, [rdata+__float_0]
    arm64.fsub d2, d1, d0
    arm64.fmov d0, d2
    arm64.bl float.hash
    arm64.cmp x19, x0
    arm64.cset x0, eq
    arm64.b.ne eq_0.after
  eq_0:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  eq_0.after:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  }
}
