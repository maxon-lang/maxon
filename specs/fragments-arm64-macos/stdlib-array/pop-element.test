    arm64.adrp_add_rdata x0, __layout_Array_Int
    arm64.ldr x1, [x29, #16]
    arm64.mov x0, x19
    arm64.bl Array.pop
    arm64.mov x2, #0
    arm64.cmp x1, x2
    arm64.cset x1, ne
    arm64.b.eq try_0.merge
  try_0.otherwise:
    arm64.mov x0, #-1
  try_0.merge:
    arm64.mov x1, #30
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.b.eq check_0.after
  check_0:
    arm64.mov x0, x19
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.adrp_add_rdata x0, __layout_Array_Int
    arm64.ldr x1, [x29, #16]
    arm64.mov x0, x19
    arm64.bl Array.count
    arm64.mov x20, x0
    arm64.mov x0, x19
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, #2
