    arm64.ldr x2, [x29, #16]
    arm64.mov x1, #0
    arm64.mov x0, x19
    arm64.bl Array.remove
    arm64.mov x20, x0
    arm64.mov x21, x1
    arm64.mov x0, x19
    arm64.bl __mm_decref_maybenull_helper
    arm64.mov x0, #0
    arm64.cmp x21, x0
    arm64.cset x0, ne
    arm64.b.eq try_0.merge
  try_0.otherwise:
    arm64.mov x0, #-1
    arm64.mov x20, x0
  try_0.merge:
    arm64.mov x0, #-1
    arm64.cmp x20, x0
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  }
}
