// Test: sqrt.zero
function main() returns ExitCode
	let result = sqrt(0.0)
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.ldr d0, [rdata+__float_0]
    arm64.ldr d1, [rdata+__float_0]
    arm64.fsqrt d2, d0
    arm64.fcmp d2, d1
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.ret
  }
}
---
