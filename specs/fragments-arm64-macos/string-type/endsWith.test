// Test: endsWith
function main() returns ExitCode
	let s = "hello world"
	if s.endsWith("world") 'c1'
		print("1\n")
	end 'c1'
	if s.endsWith("hello") 'c2'
		print("0\n")
	end 'c2'
	return 0
end 'main'
