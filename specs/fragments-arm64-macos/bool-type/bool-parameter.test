// Test: bool-parameter

typealias Integer = int(i64.min to i64.max)

function test_bool_param(flag bool) returns Integer
	if flag 'check'
		return 1
	end 'check' else 'else_check'
		return 0
	end 'else_check'
end 'test_bool_param'

function main() returns ExitCode
	return test_bool_param(true)
end 'main'
---
ExitCode: 1
---
