// Test: dispatch.shape-table-biased
typealias Probe = int(0 to 1000)
typealias Result = int(0 to 100)

function classify(n Probe) returns Result
	match n 'm'
		100 then return 1
		101 then return 2
		102 then return 3
		103 then return 4
		104 then return 5
		105 then return 6
		default then return 0
	end 'm'
end 'classify'

function main() returns ExitCode
	return classify(103)
end 'main'
