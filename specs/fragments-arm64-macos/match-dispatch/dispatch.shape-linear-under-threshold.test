// Test: dispatch.shape-linear-under-threshold
typealias Probe = int(0 to 100)
typealias Result = int(0 to 100)

function classify(n Probe) returns Result
	match n 'm'
		7 then return 1
		8 then return 2
		9 then return 3
		default then return 0
	end 'm'
end 'classify'

function main() returns ExitCode
	return classify(8)
end 'main'
