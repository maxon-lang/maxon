// Test: synthesized-clone-crosses-an-exported-union-s-file-boundary
// --- file: answer.maxon
typealias Integer = int(i64.min to i64.max)

export union Answer
	small
	big(n Integer)
end 'Answer'

export function classify(n Integer) returns Answer
	if n > 10 'big'
		return Answer.big(n)
	end 'big'
	return Answer.small
end 'classify'

// --- file: main.maxon
function main() returns ExitCode
	let a = classify(42)
	let c = a.clone()
	return match c 'm'
		small gives 1
		big(n) gives n
	end 'm'
end 'main'
---
ExitCode: 42
