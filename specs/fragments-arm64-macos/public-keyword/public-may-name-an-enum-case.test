    arm64.mov x2, #0
    arm64.cmp x1, x2
    arm64.cset x3, ne
    arm64.cmp x3, #0
    arm64.b.ne main.which_0.dispatch0
    arm64.b main.which_0.case0
  which_0.dispatch0:
    arm64.mov x0, #1
    arm64.ldr x1, [x29, #-8]
    arm64.cmp x1, x0
    arm64.cset x2, ne
    arm64.cmp x2, #0
    arm64.b.ne main.which_0.dispatch1
    arm64.b main.which_0.case1
  which_0.dispatch1:
    arm64.b main.which_0.merge
  which_0.case0:
    arm64.mov x0, #3
