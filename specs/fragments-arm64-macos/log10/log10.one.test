// Test: log10.one
function main() returns ExitCode
	let result = Math.log10(1.0)
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    arm64.prologue stack_size=16
    arm64.ldr d0, [rdata+__float_4607182418800017408]
    arm64.bl Math.log10
    arm64.ldr d1, [rdata+__float_0]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.b.ne check_0.after
  check_0:
    arm64.mov x0, #0
    arm64.epilogue
    arm64.ret
  check_0.after:
    arm64.mov x0, #1
    arm64.epilogue
    arm64.ret
  }
}
---
