// Test: int-format-zero-padded-unsigned
function main() returns ExitCode
	let n = 255
	print("{n:08x}\n")
	print("{n:08X}\n")
	print("{n:06o}\n")
	print("{n:012b}\n")
	// Space fill and the signed path share the same shift-and-fill code.
	print("{n:8x}\n")
	let neg = 0 - 42
	print("{neg:08d}\n")
	return 0
end 'main'
---
