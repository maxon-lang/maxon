// Test: union-mixed-rawvalue-and-payload
union U
	a = 1001
	b(s String)
end 'U'

function main() returns ExitCode
	let x = U.a
	print("{x}\n")
	let y = U.b("hello")
	print("{y}\n")
	print("{y.rawValue}\n")
	return 0
end 'main'
