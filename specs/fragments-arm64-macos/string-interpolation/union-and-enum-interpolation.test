// Test: union-and-enum-interpolation
typealias Coord = int(i64.min to i64.max)

enum Level
	low = 10
	high = 20
end 'Level'

enum Bare
	first
	second
end 'Bare'

union Shape
	empty
	point(x Coord)
end 'Shape'

function main() returns ExitCode
	let lvl = Level.high
	let bare = Bare.second
	let shape = Shape.point(3)
	print("{lvl} {bare} {shape}\n")
	return 0
end 'main'
