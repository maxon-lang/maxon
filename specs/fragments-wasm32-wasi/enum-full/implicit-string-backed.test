// Test: implicit-string-backed
enum StringBacked
	"North"
	"South"
	"East"
end 'StringBacked'

function main() returns ExitCode
	let dir = StringBacked.North
	let result = match dir 'check'
		North gives 1
		South gives 0
		East gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
