	arr.push(10)
	arr.push(20)
	arr.push(30)

	let removed = try arr.remove(1) otherwise 'err'
		return 99
	end 'err'

	if removed != 20 'val'
		return 1
	end 'val'

	if arr.count() != 2 'cnt'
		return 2
	end 'cnt'

	let v0 = try arr.get(0) otherwise -1
	if v0 != 10 'c0'
		return 3
	end 'c0'

	let v1 = try arr.get(1) otherwise -1
	if v1 != 30 'c1'
		return 4
	end 'c1'

	return 0
end 'main'
