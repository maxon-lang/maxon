// Test: stmt-form-all-terms
enum E
	a
	b
	c
	d
	e
end 'E'

typealias Tag = int(0 to 9)

function classify(v E) returns Tag
	var r = 0 as Tag
	match v 'm'
		a or c or e then r = 1
		b or d then r = 2
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	for x in E.allCases 'e'
		print("{x.name}={classify(x)}\n")
	end 'e'
	return 0
end 'main'
---
