// Test: enum-match-range.upto
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.mul
	let result = match op 'check'
		add upto mul gives 1
		mul gives 2
		exec(code) gives code
	end 'check'
	return result
end 'main'
