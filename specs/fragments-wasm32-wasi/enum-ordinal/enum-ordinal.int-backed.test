// Test: enum-ordinal.int-backed
enum HttpStatus
	ok = 200
	notFound = 404
	serverError = 500
end 'HttpStatus'

function main() returns ExitCode
	let s = HttpStatus.serverError
	// ordinal is 2 (third case), not 500 (the raw value)
	return s.ordinal as ExitCode
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %3 = mir.mov_imm 0 : i64
    %13 = mir.mov_imm 2 : i64
    mir.br __cast_check_lo_0()
  __cast_check_lo_0:
    %17 = mir.cmp lt, %13, %3
    mir.cond_br %17 [then: __cast_panic_0(), else: __cast_ok_0()]
  __cast_panic_0:
    %18 = mir.global_addr @__panic_msg_f7e3a2dc19cd0c97
    %19 = mir.call @mrt_panic(%18)
  __cast_ok_0:
    mir.ret %13
  }
}
---
