    %12 = mir.mov_imm 16 : i64
    %13 = mir.func_addr @__destruct_String
    %11 = mir.call @stdlib.__mm_alloc(%12, %13)
    %15 = mir.call @stdlib.__mm_incref(%11)
    mir.store %5, %11, 0 width: qword
    %14 = mir.mov_imm 1 : i64
    mir.store %14, %11, 8 width: qword
