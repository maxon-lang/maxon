    mir.store %3, %10, 0 width: word
    %5 = mir.global_addr @__data_gbox
    %13 = mir.load %5, 0 width: qword
    mir.store %10, %5, 0 width: qword
    %14 = mir.call @__mm_decref_maybenull_helper(%13)
    %7 = mir.load %2, 0 width: word
    %15 = mir.call @__mm_decref_maybenull_helper(%2)
    %16 = mir.mov_imm 255 : i64
    %17 = mir.cmp ugt, %7, %16
    mir.cond_br %17 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %18 = mir.global_addr @__panic_msg_cabca1a5b17bfe0a
