    %28 = mir.call @stdlib.__mm_incref(%26)
    mir.store %6, %26, 0 width: qword
    %8 = mir.load %22, 8 width: qword
    %9 = mir.call @__mm_decref_maybenull_helper(%8)
    mir.store %26, %22, 8 width: qword
