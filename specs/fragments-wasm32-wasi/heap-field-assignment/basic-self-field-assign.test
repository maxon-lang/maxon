    %18 = mir.call @stdlib.__mm_alloc(%16, %17)
    %25 = mir.call @stdlib.__mm_incref(%18)
    mir.store %2, %18, 0 width: qword
    %19 = mir.mov_imm 16 : i64
    %20 = mir.func_addr @__destruct_Container
    %21 = mir.call @stdlib.__mm_alloc(%19, %20)
    mir.store %1, %21, 0 width: qword
