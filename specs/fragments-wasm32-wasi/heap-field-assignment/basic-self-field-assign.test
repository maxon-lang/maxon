    mir.store %18, %21, 8 width: qword
    %28 = mir.call @__mm_decref_maybenull_helper(%27)
    %6 = mir.mov_imm 20 : i64
    %22 = mir.mov_imm 8 : i64
    %23 = mir.mov_imm 0 : i64
    %24 = mir.call @stdlib.__mm_alloc(%22, %23)
    %26 = mir.call @stdlib.__mm_incref(%24)
    mir.store %6, %24, 0 width: qword
    %29 = mir.load %21, 8 width: qword
    mir.store %24, %21, 8 width: qword
    %30 = mir.call @__mm_decref_maybenull_helper(%29)
    %10 = mir.load %21, 8 width: qword
    %11 = mir.load %10, 0 width: qword
    %12 = mir.mov_imm 20 : i64
