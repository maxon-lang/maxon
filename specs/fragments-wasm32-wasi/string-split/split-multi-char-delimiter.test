// Test: split-multi-char-delimiter
function main() returns ExitCode
	let s = "one::two::three"
	let parts = s.split("::")
	print("{parts.count()}\n")
	for p in parts 'loop'
		print("{p}\n")
	end 'loop'
	return 0
end 'main'
