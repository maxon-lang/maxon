type State
	export var val as Integer

	static function create(val Integer) returns Self
		return Self{val: val}
	end 'create'
end 'State'

var g = State.create(0)

function step(n Integer)
	g = State.create(n)
end 'step'

function main() returns ExitCode
	step(10)
	step(20)
	step(30)
	return g.val
end 'main'
