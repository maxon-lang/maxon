// Test: rc-return-transfers-ownership
typealias Integer = int(i64.min to i64.max)

type Token
	export var kind as Integer

	static function create(kind Integer) returns Self
		return Self{kind: kind}
	end 'create'
end 'Token'

function makeToken(k Integer) returns Token
	let t = Token.create(k)
	return t
end 'makeToken'

function main() returns ExitCode
	let tok = makeToken(99)
	return tok.kind
end 'main'
---
ExitCode: 99
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %1 = mir.mov_imm 99 : i64
    %5 = mir.mov_imm 8 : i64
    %6 = mir.mov_imm 0 : i64
    %7 = mir.call @stdlib.__mm_alloc(%5, %6)
    mir.store %1, %7, 0 width: qword
    %4 = mir.load %7, 0 width: qword
    %8 = mir.call @mm_drop(%7)
    %9 = mir.mov_imm 125 : i64
    %10 = mir.cmp ugt, %4, %9
    mir.cond_br %10 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %11 = mir.global_addr @__panic_msg_0f9617b4e82e9d47
    %12 = mir.call @mrt_panic(%11)
  __range_ok_0:
    mir.ret %4
  }
}
---
