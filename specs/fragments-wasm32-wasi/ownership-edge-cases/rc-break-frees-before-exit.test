    mir.br loop_0.header(%1)
  loop_0.header(%15: i64):
    %3 = mir.mov_imm 10 : i64
    %4 = mir.cmp lt, %15, %3
    mir.cond_br %4 [then: loop_0(), else: loop_0.exit()]
  loop_0:
    %16 = mir.mov_imm 8 : i64
    %17 = mir.mov_imm 0 : i64
    %18 = mir.mov_imm 1 : i64
    %19 = mir.call @stdlib.__mm_alloc_needzero(%16, %17, %18)
    mir.store %15, %19, 0 width: qword
    %8 = mir.load %19, 0 width: qword
    %9 = mir.mov_imm 3 : i64
    %10 = mir.cmp eq, %8, %9
    %20 = mir.call @mm_drop(%19)
    mir.cond_br %10 [then: loop_0.exit(), else: stop_0.after()]
  loop_0.exit:
    %21 = mir.mov_imm 255 : i64
    %22 = mir.cmp ugt, %15, %21
    mir.cond_br %22 [then: __range_panic_0(), else: __range_ok_0()]
  stop_0.after:
    %13 = mir.mov_imm 1 : i64
    %14 = mir.add.i64 %15, %13
    mir.br loop_0.header(%14)
  __range_panic_0:
    %23 = mir.global_addr @__panic_msg_37b47744f11c8d94
    %24 = mir.call @mrt_panic(%23)
  __range_ok_0:
    mir.ret %15
  }
}
