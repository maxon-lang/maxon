// Test: enum-allcasenames.int-backed
enum HttpStatus
	ok = 200
	notFound = 404
	serverError = 500
end 'HttpStatus'

function main() returns ExitCode
	for name in HttpStatus.allCaseNames 'loop'
		print("{name}\n")
	end 'loop'
	return 0
end 'main'
