// Test: enum-allcasenames.string-backed
enum ContentType
	json = "application/json"
	html = "text/html"
	plain = "text/plain"
end 'ContentType'

function main() returns ExitCode
	for name in ContentType.allCaseNames 'loop'
		print("{name}\n")
	end 'loop'
	return 0
end 'main'
