// Test: negative-division
function main() returns ExitCode
	let neg = -7
	let a = neg / 2           // -7/2 = -3 (truncating toward zero)
	if a == -3 'pass'
			return 0
	end 'pass'
	return 1
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm -7 : i64
    %2 = mir.mov_imm 2 : i64
    %3 = mir.div.i64 %0, %2
    %5 = mir.mov_imm -3 : i64
    %6 = mir.cmp eq, %3, %5
    mir.cond_br %6 [then: pass_0(), else: pass_0.after()]
  pass_0:
    %7 = mir.mov_imm 0 : i64
    mir.ret %7
  pass_0.after:
    %8 = mir.mov_imm 1 : i64
    mir.ret %8
  }
}
---
