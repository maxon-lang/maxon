// Test: arm-panic.enum-exhaustive
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.blue
	let result = match c 'eval'
		red panic("no red")
		green gives 1
		blue gives 2
	end 'eval'
	return result
end 'main'
---
ExitCode: 2
