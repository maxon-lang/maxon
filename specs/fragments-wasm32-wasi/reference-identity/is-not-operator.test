// Test: is-not-operator
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = Point.create(1, y: 2)
	if a is not b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %2 = mir.mov_imm 1 : i64
    %3 = mir.mov_imm 2 : i64
    %13 = mir.mov_imm 16 : i64
    %14 = mir.mov_imm 0 : i64
    %15 = mir.mov_imm 1 : i64
    %16 = mir.call @stdlib.__mm_alloc_needzero(%13, %14, %15)
    mir.store %2, %16, 0 width: qword
    mir.store %3, %16, 8 width: qword
    %5 = mir.mov_imm 1 : i64
    %6 = mir.mov_imm 2 : i64
    %17 = mir.mov_imm 16 : i64
    %18 = mir.mov_imm 0 : i64
    %19 = mir.mov_imm 1 : i64
    %20 = mir.call @stdlib.__mm_alloc_needzero(%17, %18, %19)
    mir.store %5, %20, 0 width: qword
    mir.store %6, %20, 8 width: qword
    %10 = mir.cmp ne, %16, %20
    %22 = mir.call @mm_drop(%20)
    %21 = mir.call @mm_drop(%16)
    mir.cond_br %10 [then: check_0(), else: check_0.after()]
  check_0:
    %11 = mir.mov_imm 1 : i64
    mir.ret %11
  check_0.after:
    %12 = mir.mov_imm 0 : i64
    mir.ret %12
  }
}
---
