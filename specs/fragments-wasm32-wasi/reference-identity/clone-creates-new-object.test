// Test: clone-creates-new-object
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = a.clone()
	if a is b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %2 = mir.mov_imm 1 : i64
    %3 = mir.mov_imm 2 : i64
    %12 = mir.mov_imm 16 : i64
    %13 = mir.mov_imm 0 : i64
    %14 = mir.mov_imm 1 : i64
    %15 = mir.call @stdlib.__mm_alloc_needzero(%12, %13, %14)
    mir.store %2, %15, 0 width: qword
    mir.store %3, %15, 8 width: qword
    %16 = mir.mov_imm 16 : i64
    %17 = mir.mov_imm 0 : i64
    %21 = mir.mov_imm 1 : i64
    %22 = mir.call @stdlib.__mm_alloc_needzero(%16, %17, %21)
    %19 = mir.load %15, 0 width: qword
    mir.store %19, %22, 0 width: qword
    %20 = mir.load %15, 8 width: qword
    mir.store %20, %22, 8 width: qword
    %9 = mir.cmp eq, %15, %22
    %24 = mir.call @mm_drop(%22)
    %23 = mir.call @mm_drop(%15)
    mir.cond_br %9 [then: check_0(), else: check_0.after()]
  check_0:
    %10 = mir.mov_imm 1 : i64
    mir.ret %10
  check_0.after:
    %11 = mir.mov_imm 0 : i64
    mir.ret %11
  }
}
---
