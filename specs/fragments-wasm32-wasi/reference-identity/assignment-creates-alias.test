// Test: assignment-creates-alias
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = a
	if a is b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %2 = mir.mov_imm 1 : i64
    %3 = mir.mov_imm 2 : i64
    %11 = mir.mov_imm 16 : i64
    %12 = mir.mov_imm 0 : i64
    %13 = mir.call @stdlib.__mm_alloc(%11, %12)
    mir.store %2, %13, 0 width: qword
    mir.store %3, %13, 8 width: qword
    %8 = mir.cmp eq, %13, %13
    %14 = mir.call @mm_drop(%13)
    mir.cond_br %8 [then: check_0(), else: check_0.after()]
  check_0:
    %9 = mir.mov_imm 1 : i64
    mir.ret %9
  check_0.after:
    %10 = mir.mov_imm 0 : i64
    mir.ret %10
  }
}
---
