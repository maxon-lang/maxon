    %2 = mir.mov_imm 0 : i64
    %3 = mir.mov_imm 21 : i64
    %4 = mir.indirect_call %1(%3, %2)
    %5 = mir.mov_imm 255 : i64
    %6 = mir.cmp ugt, %4, %5
    mir.cond_br %6 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %7 = mir.global_addr @__panic_msg_c73f8697568d2025
    %8 = mir.call @mrt_panic(%7)
  __range_ok_0:
    mir.ret %4
  }
}
