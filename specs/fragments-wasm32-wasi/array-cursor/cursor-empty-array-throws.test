    %16, %17 = mir.try_call @ArrayIterator.create(%14, %5)
    %26 = mir.call @__mm_decref_maybenull_helper(%3)
    %18 = mir.mov_imm 0 : i64
    %19 = mir.cmp ne, %17, %18
    mir.cond_br %19 [then: inlined_Array.cursor_1_0(), else: inlined_Array.cursor_2_0()]
  inlined_Array.cursor_1_0:
    %20 = mir.mov_imm 0 : i64
    mir.br inline_cont_main_0(%20, %17)
  inlined_Array.cursor_2_0:
    %21 = mir.mov_imm 0 : i64
    mir.br inline_cont_main_0(%16, %21)
  inline_cont_main_0(%22: i64, %23: i64):
    %27 = mir.call @__mm_decref_maybenull_helper(%22)
    %8 = mir.mov_imm 0 : i64
    %9 = mir.cmp ne, %23, %8
    mir.cond_br %9 [then: try_0.otherwise(), else: try_0.merge()]
  try_0.otherwise:
