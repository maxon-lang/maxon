    %6 = mir.add.i64 %2, %5
    %7 = mir.mov_imm -1 : i64
    %8 = mir.cmp ugt, %6, %7
    mir.cond_br %8 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %9 = mir.global_addr @__panic_msg_1071998218daa1f3
    %10 = mir.call @mrt_panic(%9)
  __range_ok_0:
    mir.ret %6
  }
  func @main() -> u8 {
  entry:
    %0 = mir.call @Cache.sum()
    %1 = mir.mov_imm 125 : i64
    %2 = mir.cmp ugt, %0, %1
    mir.cond_br %2 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
