module {
  func @main() -> u8 {
  entry:
    %4 = mir.global_addr @__data_Config.value
    %5 = mir.load %4, 0 width: qword
    %3 = mir.load %5, 0 width: qword
    %6 = mir.mov_imm 255 : i64
    %7 = mir.cmp ugt, %3, %6
    mir.cond_br %7 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %8 = mir.global_addr @__panic_msg_b9e28ea05edf259d
    %9 = mir.call @mrt_panic(%8)
  __range_ok_0:
    mir.ret %3
  }
}
