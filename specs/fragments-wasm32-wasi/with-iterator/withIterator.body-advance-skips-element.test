// Test: withIterator.body-advance-skips-element
function main() returns ExitCode
	let arr = [10, 20, 30, 40]
	for (iter, value) in arr.withIterator() 'loop'
		print("{value}\n")
		try iter.advance() otherwise break
	end 'loop'
	return 0
end 'main'
