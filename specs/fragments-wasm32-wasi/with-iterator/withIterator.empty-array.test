// Test: withIterator.empty-array
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
function main() returns ExitCode
	let arr = IntArray.create()
	var total = 0
	for v in arr 'loop'
		total = total + v
	end 'loop'
	print("{total}\n")
	return 0
end 'main'
