    %11 = mir.param local2 : i64
    %3 = mir.load %9, 0 width: qword
    %6 = mir.add.i64 %3, %10
    %8 = mir.add.i64 %6, %11
    mir.ret %8
  }
  func @combineVia(local0: i64, local1: i64) -> i64 {
  entry:
    %7 = mir.param local0 : i64
    mir.store_slot slot_0, %7
    %8 = mir.param local1 : i64
    mir.store_slot slot_1, %8
    %2 = mir.load_slot slot_0
    %3 = mir.load_slot slot_1
    %4 = mir.mov_imm 12 : i64
    %5 = mir.mov_imm 30 : i64
    %6 = mir.witness_call %3, [0](%2, %4, %5)
    mir.ret %6
  }
  func @main() -> u8 {
  entry:
    %1 = mir.mov_imm 0 : i64
    %6 = mir.mov_imm 8 : i64
    %7 = mir.mov_imm 0 : i64
    %8 = mir.call @stdlib.__mm_alloc(%6, %7)
    mir.store %1, %8, 0 width: qword
    %4 = mir.global_addr @__witness_Summer_Combiner
    %5 = mir.call @combineVia(%8, %4)
    %9 = mir.call @mm_drop(%8)
    %10 = mir.mov_imm 125 : i64
    %11 = mir.cmp ugt, %5, %10
    mir.cond_br %11 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %12 = mir.global_addr @__panic_msg_ceec5066efc32245
    %13 = mir.call @mrt_panic(%12)
  __range_ok_0:
    mir.ret %5
  }
