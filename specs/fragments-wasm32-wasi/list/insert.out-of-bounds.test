// Test: insert.out-of-bounds
function main() returns ExitCode
	var list = List from [10]
	try list.insert(5, value: 99) otherwise 'oob'
		print("threw\n")
		print("{list.count()}\n")
		return 0
	end 'oob'
	print("no throw\n")
	return 1
end 'main'
