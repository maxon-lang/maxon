    %6 = mir.global_addr @__layout_Set_Int
    %7 = mir.global_addr @__witness_int_Hashable
    %8 = mir.global_addr @__witness_int_Equatable
    %9 = mir.call @Set.count(%4, %6, %7, %8)
    %10 = mir.mov_imm 0 : i64
    %11 = mir.cmp ne, %9, %10
    %14 = mir.call @__mm_decref_maybenull_helper(%4)
    mir.cond_br %11 [then: check_0(), else: check_0.after()]
  check_0:
    %12 = mir.mov_imm 1 : i64
    mir.ret %12
  check_0.after:
    %13 = mir.mov_imm 0 : i64
    mir.ret %13
  }
}
