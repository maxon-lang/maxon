    %4 = mir.mov_imm 0 : i64
    %5 = mir.cmp eq, %2, %4
    %6 = mir.mov_imm 1 : i64
    %7 = mir.mul.i64 %5, %6
    %8 = mir.add.i64 %3, %7
    %9 = mir.mov_imm 1 : i64
    %10 = mir.cmp eq, %2, %9
    %11 = mir.mov_imm 3 : i64
    %12 = mir.mul.i64 %10, %11
    %13 = mir.add.i64 %8, %12
    %14 = mir.mov_imm 2 : i64
    %15 = mir.cmp eq, %2, %14
    %16 = mir.mov_imm 0 : i64
    %17 = mir.mul.i64 %15, %16
    %18 = mir.add.i64 %13, %17
    %20 = mir.mov_imm 50 : i64
    %21 = mir.cmp ugt, %18, %20
    mir.cond_br %21 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %22 = mir.global_addr @__panic_msg_2dfa5c6109c8a3a9
    %23 = mir.call @mrt_panic(%22)
  __range_ok_0:
    mir.ret %18
  }
  func @main() -> u8 {
  entry:
    %3 = mir.mov_imm 10 : i64
    %4 = mir.mov_imm 20 : i64
    %5 = mir.call @__construct_TestOp_add(%3, %4)
    %6 = mir.mov_imm 1 : i64
    %7 = mir.mov_imm 2 : i64
    %8 = mir.call @__construct_TestOp_mul(%6, %7)
    %9 = mir.call @__construct_TestOp_nop()
    %11 = mir.call @latencyOf(%5)
    %13 = mir.call @latencyOf(%8)
    %14 = mir.add.i64 %11, %13
    %18 = mir.call @__mm_decref_maybenull_helper(%8)
    %16 = mir.call @latencyOf(%9)
    %17 = mir.add.i64 %14, %16
    %20 = mir.call @__mm_decref_maybenull_helper(%5)
    %19 = mir.call @__mm_decref_maybenull_helper(%9)
    %21 = mir.mov_imm 255 : i64
    %22 = mir.cmp ugt, %17, %21
    mir.cond_br %22 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
