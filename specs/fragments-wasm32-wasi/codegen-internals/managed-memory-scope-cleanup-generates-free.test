// Test: managed-memory-scope-cleanup-generates-free
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	if true 'outer'
		var outer_arr = IntArray.create()
		outer_arr.push(100)
		if true 'inner'
			var inner_arr = IntArray.create()
			inner_arr.push(200)
		end 'inner'
	end 'outer'
	return 0
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %3 = mir.global_addr @__layout_Array_Integer
    %4 = mir.call @Array.create(%3)
    %6 = mir.mov_imm 100 : i64
    %7 = mir.global_addr @__layout_Array_Integer
    %8 = mir.call @Array.push(%4, %6, %7)
    %17 = mir.call @__mm_decref_maybenull_helper(%4)
    mir.br inner_0()
  inner_0:
    %10 = mir.global_addr @__layout_Array_Integer
    %11 = mir.call @Array.create(%10)
    %13 = mir.mov_imm 200 : i64
    %14 = mir.global_addr @__layout_Array_Integer
    %15 = mir.call @Array.push(%11, %13, %14)
    %18 = mir.call @__mm_decref_maybenull_helper(%11)
    mir.br outer_0.after()
  outer_0.after:
    %16 = mir.mov_imm 0 : i64
    mir.ret %16
  }
}
---
