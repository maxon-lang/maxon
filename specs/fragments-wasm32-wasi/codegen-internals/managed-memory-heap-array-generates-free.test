// Test: managed-memory-heap-array-generates-free
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(1)
	arr.push(2)
	return arr.count()
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %1 = mir.global_addr @__layout_Array_Integer
    %2 = mir.call @Array.create(%1)
    %4 = mir.mov_imm 1 : i64
    %5 = mir.global_addr @__layout_Array_Integer
    %6 = mir.call @Array.push(%2, %4, %5)
    %8 = mir.mov_imm 2 : i64
    %9 = mir.global_addr @__layout_Array_Integer
    %10 = mir.call @Array.push(%2, %8, %9)
    %12 = mir.global_addr @__layout_Array_Integer
    %13 = mir.call @Array.count(%2, %12)
    %14 = mir.call @__mm_decref_maybenull_helper(%2)
    %15 = mir.mov_imm 255 : i64
    %16 = mir.cmp ugt, %13, %15
    mir.cond_br %16 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %17 = mir.global_addr @__panic_msg_9c72f2968d9297c3
    %18 = mir.call @mrt_panic(%17)
  __range_ok_0:
    mir.ret %13
  }
}
---
