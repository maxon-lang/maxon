        throw ErrA.kaboom
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'outer'
        try 'inner'
            let a = callA(true)
            sum = sum + a
        end 'inner'
        otherwise (ie) 'ih'
            match ie 'ik'
                kaboom then sum = sum + 1
            end 'ik'
        end 'ih'
        let b = callB(true)
        sum = sum + b
    end 'outer'
    otherwise (e) 'h'
        match e 'k'
            splat then sum = sum + 40
        end 'k'
    end 'h'
    return sum
end 'main'
