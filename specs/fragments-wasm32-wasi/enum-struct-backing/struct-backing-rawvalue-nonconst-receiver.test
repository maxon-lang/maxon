    %2 = mir.call @stdlib.__mm_alloc(%3, %4)
    %5 = mir.mov_imm 0 : i64
    %6 = mir.mov_imm 0 : i64
    %7 = mir.cmp eq, %17, %6
    %8 = mir.mov_imm 1 : i64
    %9 = mir.mul.i64 %7, %8
    %10 = mir.add.i64 %5, %9
    %11 = mir.mov_imm 1 : i64
    %12 = mir.cmp eq, %17, %11
    %13 = mir.mov_imm 3 : i64
    %14 = mir.mul.i64 %12, %13
    %15 = mir.add.i64 %10, %14
    mir.store %15, %2, 0 width: byte
    %16 = mir.load %2, 0 width: byte
    %18 = mir.call @mm_drop(%2)
    %19 = mir.mov_imm 50 : i64
    %20 = mir.cmp ugt, %16, %19
    mir.cond_br %20 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %21 = mir.global_addr @__panic_msg_402f0bc3623bca69
    %22 = mir.call @mrt_panic(%21)
  __range_ok_0:
    mir.ret %16
  }
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm 1 : i64
    %1 = mir.call @latencyOf(%0)
    %2 = mir.mov_imm 125 : i64
    %3 = mir.cmp ugt, %1, %2
    mir.cond_br %3 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %4 = mir.global_addr @__panic_msg_dbc87f470d29cbe6
