    %4 = mir.cmp eq, %13, %3
    %5 = mir.mov_imm 1 : i64
    %6 = mir.mul.i64 %4, %5
    %7 = mir.add.i64 %2, %6
    %8 = mir.mov_imm 1 : i64
    %9 = mir.cmp eq, %13, %8
    %10 = mir.mov_imm 3 : i64
    %11 = mir.mul.i64 %9, %10
    %12 = mir.add.i64 %7, %11
    %14 = mir.mov_imm 50 : i64
    %15 = mir.cmp ugt, %12, %14
    mir.cond_br %15 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %16 = mir.global_addr @__panic_msg_042f0bc3623bca69
    %17 = mir.call @mrt_panic(%16)
  __range_ok_0:
    mir.ret %12
  }
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm 1 : i64
    %1 = mir.call @latencyOf(%0)
    %2 = mir.mov_imm 125 : i64
    %3 = mir.cmp ugt, %1, %2
    mir.cond_br %3 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %4 = mir.global_addr @__panic_msg_dbc87f470d29cbe6
    %5 = mir.call @mrt_panic(%4)
  __range_ok_0:
    mir.ret %1
  }
}
