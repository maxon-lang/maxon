// Test: url.parse-path
function main() returns ExitCode
	let url = try URL.parse("https://example.com/path/to/resource") otherwise 'err'
		return 1
	end 'err'
	print("{url.scheme()}\n")
	let host = try url.host() otherwise 'nohost'
		return 2
	end 'nohost'
	print("{host}\n")
	print("{url.path()}\n")
	return 0
end 'main'
---
