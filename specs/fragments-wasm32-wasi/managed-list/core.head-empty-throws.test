// Test: core.head-empty-throws
typealias Integer = int(i64.min to i64.max)
typealias IntManagedList = __ManagedList with Integer

function main() returns ExitCode
	let list = IntManagedList.create()
	if try list.head() 'try'
		return 1
	end 'try' else 'err'
		print("caught\n")
		return 0
	end 'err'
end 'main'
---
ExitCode: 0
