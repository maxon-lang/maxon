// Test: short-type.u16-global-write
typealias U16 = int(0 to 65535)

var counter = 0 as U16

function main() returns ExitCode
	counter = 99 as U16
	return counter
end 'main'
---
ExitCode: 99
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm 99 : i64
    %1 = mir.global_addr @__data_counter
    mir.store %0, %1, 0 width: qword
    %2 = mir.global_addr @__data_counter
    %3 = mir.load %2, 0 width: qword
    %4 = mir.mov_imm 255 : i64
    %5 = mir.cmp ugt, %3, %4
    mir.cond_br %5 [then: __range_panic_0(), else: __range_ok_0()]
  __range_panic_0:
    %6 = mir.global_addr @__panic_msg_0e30109ba4dd64d0
    %7 = mir.call @mrt_panic(%6)
  __range_ok_0:
    mir.ret %3
  }
}
---
