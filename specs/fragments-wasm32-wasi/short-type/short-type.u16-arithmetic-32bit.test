// Test: short-type.u16-arithmetic-32bit
typealias U16 = int(0 to 65535)

function main() returns ExitCode
	let a = 1000 as U16
	let b = 500 as U16
	// 1000 - 500 = 500 (printed, not returned: 500 > the valid ExitCode
	// range of 0..125 on the wasm target)
	print("{a - b}\n")
	return 0
end 'main'
