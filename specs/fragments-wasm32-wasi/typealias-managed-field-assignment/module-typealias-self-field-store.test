    mir.store %32, %29, 8 width: qword
    %50 = mir.load %29, 0 width: qword
    %51 = mir.load %50, 0 width: qword
    %52 = mir.load %50, 8 width: qword
    %53 = mir.call @mrt_write_stdout(%51, %52)
    %285 = mir.call @mm_drop(%29)
    mir.ret %0
  }
}
---
