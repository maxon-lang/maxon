    %50 = mir.load %49, 0 width: qword
    %51 = mir.load %49, 8 width: qword
    %52 = mir.call @mrt_write_stdout(%50, %51)
    %284 = mir.call @mm_drop(%30)
    mir.ret %0
  }
}
---
