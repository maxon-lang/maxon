    %5 = mir.mov_imm 0 : i64
    mir.br inner_0()
  inner_0:
    %9 = mir.mov_imm 0 : i64
    %10 = mir.cmp eq, %4, %9
    mir.cond_br %10 [then: branch_0.case0(), else: branch_0.next0()]
  branch_0.merge(%20: i64):
    mir.br inner_0.after(%20)
  branch_0.case0:
