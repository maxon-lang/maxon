    %25 = mir.call @mm_drop(%24)
    mir.br branch_0.merge(%12)
  branch_0.next0:
    %13 = mir.mov_imm 1 : i64
    %14 = mir.cmp eq, %4, %13
    mir.cond_br %14 [then: branch_0.case1(), else: __rc_edge_4_0()]
  branch_0.case1:
    %16 = mir.load %24, 0 width: qword
    %17 = mir.mov_imm 1 : i64
    %18 = mir.add.i64 %16, %17
    %26 = mir.call @mm_drop(%24)
    mir.br branch_0.merge(%18)
  inner_0.after(%21: i64):
    %28 = mir.mov_imm 255 : i64
    %29 = mir.cmp ugt, %21, %28
    mir.cond_br %29 [then: __range_panic_0(), else: __range_ok_0()]
  __rc_edge_4_0:
    %27 = mir.call @mm_drop(%24)
