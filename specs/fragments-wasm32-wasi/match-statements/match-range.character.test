// Test: match-range.character
function main() returns ExitCode
	let c = 'G'
	match c 'classify'
		'a' to 'z' then return 1
		'A' to 'Z' then return 2
		'0' to '9' then return 3
		default then return 0
	end 'classify'
end 'main'
---
ExitCode: 2
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm 71 : i64
    mir.br classify_0.next0()
  classify_0.next0:
    %8 = mir.mov_imm 65 : i64
    %9 = mir.cmp ge, %0, %8
    %10 = mir.mov_imm 90 : i64
    %11 = mir.cmp le, %0, %10
    %12 = mir.and.i64 %9, %11
    mir.cond_br %12 [then: classify_0.case1(), else: classify_0.next1()]
  classify_0.case1:
    %13 = mir.mov_imm 2 : i64
    mir.ret %13
  classify_0.next1:
    %14 = mir.mov_imm 48 : i64
    %15 = mir.cmp ge, %0, %14
    %16 = mir.mov_imm 57 : i64
    %17 = mir.cmp le, %0, %16
    %18 = mir.and.i64 %15, %17
    mir.cond_br %18 [then: classify_0.case2(), else: classify_0.case3()]
  classify_0.case2:
    %19 = mir.mov_imm 3 : i64
    mir.ret %19
  classify_0.case3:
    %20 = mir.mov_imm 0 : i64
    mir.ret %20
  }
}
---
