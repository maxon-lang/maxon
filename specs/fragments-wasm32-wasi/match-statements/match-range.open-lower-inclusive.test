// Test: match-range.open-lower-inclusive
function main() returns ExitCode
	let x = 5
	match x 'check'
		min to 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %4 = mir.mov_imm 1 : i64
    mir.ret %4
  }
}
---
