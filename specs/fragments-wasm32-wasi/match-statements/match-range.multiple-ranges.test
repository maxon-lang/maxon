// Test: match-range.multiple-ranges
function main() returns ExitCode
	let score = 85
	match score 'grade'
		90 to 100 then return 65
		80 upto 90 then return 66
		70 upto 80 then return 67
		default then return 70
	end 'grade'
end 'main'
---
ExitCode: 66
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm 85 : i64
    mir.br grade_0.next0()
  grade_0.next0:
    %8 = mir.mov_imm 80 : i64
    %9 = mir.cmp ge, %0, %8
    %10 = mir.mov_imm 90 : i64
    %11 = mir.cmp lt, %0, %10
    %12 = mir.and.i64 %9, %11
    mir.cond_br %12 [then: grade_0.case1(), else: grade_0.next1()]
  grade_0.case1:
    %13 = mir.mov_imm 66 : i64
    mir.ret %13
  grade_0.next1:
    %14 = mir.mov_imm 70 : i64
    %15 = mir.cmp ge, %0, %14
    %16 = mir.mov_imm 80 : i64
    %17 = mir.cmp lt, %0, %16
    %18 = mir.and.i64 %15, %17
    mir.cond_br %18 [then: grade_0.case2(), else: grade_0.case3()]
  grade_0.case2:
    %19 = mir.mov_imm 67 : i64
    mir.ret %19
  grade_0.case3:
    %20 = mir.mov_imm 70 : i64
    mir.ret %20
  }
}
---
