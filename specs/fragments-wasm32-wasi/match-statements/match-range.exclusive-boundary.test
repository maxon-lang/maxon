// Test: match-range.exclusive-boundary
function main() returns ExitCode
	let x = 5
	match x 'check'
		1 upto 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %8 = mir.mov_imm 0 : i64
    mir.ret %8
  }
}
---
