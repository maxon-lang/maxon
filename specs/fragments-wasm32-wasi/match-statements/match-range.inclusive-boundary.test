// Test: match-range.inclusive-boundary
function main() returns ExitCode
	let x = 1
	match x 'check'
		1 to 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
// CompiledIR
module {
  func @main() -> u8 {
  entry:
    %0 = mir.mov_imm 1 : i64
    mir.br check_0.case0()
  check_0.case0:
    mir.ret %0
  }
}
---
