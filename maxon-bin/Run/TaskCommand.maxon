export function runTask(args MaxonArgs) returns ExitCode
	let search = try driverFileIn(Directory.currentPath(), extension: TaskFileExtension) otherwise (e) 'unreadableDirectory'
		reportCompileError(e)
		return 1
	end 'unreadableDirectory'

	match search 'search'
		found(taskFile) then return runTaskFrom(taskFile, args: args)
		none then return refuseWithoutATaskFile()
	end 'search'
end 'runTask'

function refuseWithoutATaskFile() returns ExitCode
	printError("Usage: maxon {RunCommandName} [<task> [args...]]\n")
	printError("\n")
	printError("A task is an exported function of no parameters returning ExitCode, declared in the `{TaskFileExtension}` file in the current directory. There is none here.\n")
	return 1
end 'refuseWithoutATaskFile'

function runTaskFrom(taskFile FilePath, args MaxonArgs) returns ExitCode
	let declared = try entryNamesDeclaredIn(taskFile) otherwise (e) 'noRoster'
		reportEntryRosterError(e)
		return 1
	end 'noRoster'

	if args.paths.count() == 0 'noTaskNamed'
		return listTasks(declared, taskFile: taskFile)
	end 'noTaskNamed'

	let word = try args.paths.get(0) otherwise panic("runTaskFrom: paths.get(0) OOB despite a non-zero count")
	let named = entryNameOf(word)

	if not declared.contains(named) 'noSuchTask'
		printError("error: {taskFile.filename()} declares no task `{word}`.\n")
		_ = listTasks(declared, taskFile: taskFile)
		return 1
	end 'noSuchTask'

	return runDeclaredTask(taskFile, named: named, args: args)
end 'runTaskFrom'

function runDeclaredTask(taskFile FilePath, named String, args MaxonArgs) returns ExitCode
	let outcome = runManifestProgram(taskFile, entry: named.toByteArray(), speaker: RunCommandName, base: ManifestBase.workingDirectory, arguments: taskArguments(args.paths), args: args, announce: false)

	return match outcome 'outcome'
		described(text) gives buildDescribedByTask(text, args: args, taskFile: taskFile)
		describedNothing(code) gives code
		notRun gives OwnFailureExit
	end 'outcome'
end 'runDeclaredTask'

function buildDescribedByTask(described String, args MaxonArgs, taskFile FilePath) returns ExitCode
	printVersionHeader()
	return buildFromManifestOutput(described, args: args, manifest: taskFile, base: ManifestBase.workingDirectory, depth: 0)
end 'buildDescribedByTask'

function taskArguments(paths SourcePathSpellingArray) returns StringArray
	var arguments = StringArray.create()

	for position in 1 upto paths.count() 'eachArgument'
		arguments.push(try paths.get(position) otherwise panic("taskArguments: index {position} is past paths.count() despite the upto bound"))
	end 'eachArgument'

	return arguments
end 'taskArguments'

function listTasks(declared TaskNameArray, taskFile FilePath) returns ExitCode
	if declared.count() == 0 'noTasks'
		printError("{taskFile.filename()} declares no tasks.\n")
		return 1
	end 'noTasks'

	printEntryWords(declared)
	return 0
end 'listTasks'
