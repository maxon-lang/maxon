export typealias LeftoverLivenessOf = function(String) returns ScratchStanding

// `itself` rather than the entry returned: a function value may not return data reached from its
// read-only parameter (E3210).
export union LeftoverKey
	itself
	belongsTo(file FilePath)
end 'LeftoverKey'

export typealias LeftoverKeyOf = function(FilePath) returns LeftoverKey
export typealias LeftoverDiscard = function(FilePath)

/// Removes what processes that have ended left in `directory`. `livenessOf` judges an entry by its
/// name, and `leftoverIsAbandoned` decides which judgments are removed. `keyOf` answers `itself`
/// for an entry that is its own key, or the file the entry belongs with: a key goes through
/// `discardKeyed`, and any other entry goes once its key is gone.
export function sweepLeftoversOfEndedOwners(directory FilePath, livenessOf LeftoverLivenessOf, keyOf LeftoverKeyOf, discardKeyed LeftoverDiscard)
	if not Directory.isDirectory(directory) 'nothingLeftYet'
		return
	end 'nothingLeftYet'

	let entries = try Directory.list(directory) otherwise (e) 'unlisted'
		printError("maxon: could not list {directory.path} to sweep what a process that ended left there ({e.name})\n")

		return
	end 'unlisted'

	for entry in entries 'eachEntry'
		if leftoverIsAbandoned(entry, standing: livenessOf(entry.filename())) 'abandoned'
			discardLeftoverOf(entry, keyOf: keyOf, discardKeyed: discardKeyed)
		end 'abandoned'
	end 'eachEntry'
end 'sweepLeftoversOfEndedOwners'

function discardLeftoverOf(entry FilePath, keyOf LeftoverKeyOf, discardKeyed LeftoverDiscard)
	match keyOf(entry) 'keyed'
		itself then discardKeyed(entry)
		belongsTo(file) then discardLeftoverKeyedBy(entry, key: file, discardKeyed: discardKeyed)
	end 'keyed'
end 'discardLeftoverOf'

function discardLeftoverKeyedBy(entry FilePath, key FilePath, discardKeyed LeftoverDiscard)
	if key.equals(entry) 'theKey'
		discardKeyed(entry)
		return
	end 'theKey'

	if not File.exists(key) 'orphaned'
		removeOwnedFile(entry)
	end 'orphaned'
end 'discardLeftoverKeyedBy'

export function leftoverIsItsOwnKey(_ FilePath) returns LeftoverKey
	return LeftoverKey.itself
end 'leftoverIsItsOwnKey'

export function ownerProcessNamed(field String) returns LeftoverOwner
	if not isDecimal(field) 'notDigits'
		return LeftoverOwner.notOwned
	end 'notDigits'

	let pid = try int.fromString(field) otherwise return LeftoverOwner.notOwned

	if pid == 0 or pid > i32.max 'notAProcessId'
		return LeftoverOwner.notOwned
	end 'notAProcessId'

	return LeftoverOwner.process(pid as OwnerProcessId)
end 'ownerProcessNamed'

function isDecimal(text String) returns bool
	return not text.isEmpty() and text.trimStart(asciiDecimalDigits()).isEmpty()
end 'isDecimal'

export function removeOwnedFile(path FilePath)
	if not File.exists(path) 'alreadyGone'
		return
	end 'alreadyGone'

	try File.delete(path) otherwise (e) 'kept'
		printError("maxon: could not delete {path.path} ({e.name}); a later sweep removes it once nothing holds it and its owner has ended\n")
	end 'kept'
end 'removeOwnedFile'

export function pathWithoutSuffix(path FilePath, suffix String) returns FilePath
	if not path.path.endsWith(suffix) 'notItsSuffix'
		panic("pathWithoutSuffix: {path.path} does not end in {suffix}")
	end 'notItsSuffix'

	let spelled = path.path.sliceLength(path.path.startIndex(), length: path.path.count() - suffix.count())

	return try FilePath.from(spelled) otherwise panic("pathWithoutSuffix: {path.path} with {suffix} taken off is a spellable path")
end 'pathWithoutSuffix'
