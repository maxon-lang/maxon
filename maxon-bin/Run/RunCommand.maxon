// RunCommand.maxon — `maxon run <file|directory> [args...]`: compile a program, or reuse a cached build
// of it, and run it as though it had been launched directly.
//
// ⭐⭐ **THE STREAMS AND THE EXIT CODE ARE THE PROGRAM'S.** stdin, stdout and stderr are inherited and the
// child's exit code is this command's, so a program run this way is indistinguishable from one launched
// by name. That is also why `quietTheBuildChatter` takes the build down to ERROR: a compiler announcing
// the bytes it wrote onto a program's own stdout is output nobody asked for and nothing downstream can
// filter back out. ⚠ **SILENCED IS NOT SILENT — the ERROR level is deliberately left speaking**, so a
// compile that fails still says why on stderr (`compile-error.maxtest` asserts exactly that), and so
// does a build the emitter could not complete.
//
// ⭐⭐ **TWO DOORS, ONE COMMAND.** The word (`maxon run f.maxon a b`) and a first argument ending in
// `.maxon` (`maxon f.maxon a b`), which is what a kernel hands the interpreter for a file whose first line
// is `#!/usr/bin/env maxon`. Both arms of `MaxonArgs.parse` file the same shape — the program at position
// 0, its own arguments after it — and reach this ONE function, so the two cannot come to behave
// differently.
//
// ⚠ **NOTHING HERE TAKES THE CHECKOUT'S TREE LOCK, AND THE COMPILE'S EXPLICIT OUTPUT PATH IS WHY THAT IS
// SAFE.** `compileToProduct` is driven directly, so `Main.acquireBuildTreeLock` is never reached — and the
// rule it enforces is met anyway: everything this writes goes to the cache slot it was told to write to,
// never to `<project>/.maxon/`, so running a program from inside a checkout cannot race a build of it.

export function runExecute(args MaxonArgs) returns ExitCode
	let spelling = try args.paths.get(0) otherwise 'noProgram'
		printError("Usage: {runUsageLine()}\n")
		printError("No program was named. Give a `{MaxonSourceExtension}` file, or a directory to compile as one project.\n")
		return OwnFailureExit
	end 'noProgram'

	let program = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return OwnFailureExit
	end 'badPath'

	let isProject = Directory.isDirectory(program)

	if not isProject and not File.exists(program) 'nothingThere'
		reportCompileError(CompileError.fileNotFound(program))
		return OwnFailureExit
	end 'nothingThere'

	_ = quietTheBuildChatter(args)

	return runProgram(program, isProject: isProject, arguments: programArguments(args.paths))
end 'runExecute'

// The one sentence a cache failure reaches a reader through: the arm IS the fact and its payload is the
// sentence, so there is nothing to decide here. `module` so `CacheCommand` reports a cache it cannot
// locate in the same words `run` and `build` do.
module function reportCacheError(e RunCacheError, speaker String)
	match e 'why'
		unavailable(reason) then printError("{speaker}: {reason}\n")
	end 'why'
end 'reportCacheError'

function runUsageLine() returns String
	return "maxon {ExecuteCommandName} <file|directory> [args...]"
end 'runUsageLine'

// The PROGRAM's own command line: everything the driver was handed after the path. ONE reader for both
// doors — the word door drops the word, the wordless one keeps the file — so neither can drift into
// passing the program a different argument list.
function programArguments(paths SourcePathSpellingArray) returns StringArray
	var arguments = StringArray.create()

	for position in 1 upto paths.count() 'eachArgument'
		arguments.push(try paths.get(position) otherwise panic("programArguments: index {position} is past paths.count() despite the upto bound"))
	end 'eachArgument'

	return arguments
end 'programArguments'

function runProgram(program FilePath, isProject bool, arguments StringArray) returns ExitCode
	let built = try cachedBuild(program, isProject: isProject, target: detectHostTarget(), entryFunction: MainFunctionName, speaker: ExecuteCommandName) otherwise return OwnFailureExit

	return spawnForwarding(Executable.path(built.executable), arguments: arguments, environment: Environment.inherit, standardInput: InputSource.inherit, workingDirectory: inheritedWorkingDirectory(), speaker: ExecuteCommandName)
end 'runProgram'

// Why there is no cached build to run. Every cause has already been reported, in `speaker`'s words.
export enum CachedBuildError implements Error
	notBuilt
end 'CachedBuildError'

// A build in the cache, and whether THIS call is what put it there. `maxon build` tells its reader which
// of the two happened to the program that runs its manifest, and `maxon run` ignores it — its contract is
// that the build says nothing at all.
export type CachedProgram
	export let executable as FilePath
	export let compiled as bool

	static function create(executable FilePath, compiled bool) returns CachedProgram
		return Self{executable: executable, compiled: compiled}
	end 'create'
end 'CachedProgram'

// The run cache's build of `program` from `entryFunction`: the one already published under these
// inputs' key, or a fresh one compiled and published first. `maxon execute`, `maxon run` and a
// path-less `maxon build` all come through here, so none writes a compiled program into the project
// it was run from.
//
// A hit is the file being THERE. Its name is the key, so there is nothing beside it to read and nothing
// to compare — a build under that name was made from these very inputs.
export function cachedBuild(program FilePath, isProject bool, target Target, entryFunction ByteArray, speaker String) returns CachedProgram throws CachedBuildError
	let slot = try locateRunSlot(program, isProject: isProject, target: target, entryFunction: entryFunction) otherwise (e) 'noCache'
		reportCacheError(e, speaker: speaker)
		throw CachedBuildError.notBuilt
	end 'noCache'

	if File.exists(slot.executable) 'alreadyCached'
		return CachedProgram.create(slot.executable, compiled: false)
	end 'alreadyCached'

	try fillSlot(slot, target: target, entryFunction: entryFunction, speaker: speaker)

	return CachedProgram.create(slot.executable, compiled: true)
end 'cachedBuild'

// Compile the program into its cache slot and publish it under the name its key gives it, having said why
// when it cannot: a failed compile through the one diagnostic sink, and a build that reported success and
// left nothing behind in `speaker`'s own words.
//
// ⭐⭐ **THE COMPILE GOES TO A PATH NO OTHER BUILD CAN BE WRITING.** Concurrent cold builds of one program
// would otherwise contend over a single output file, where a loser's failed write reaches the PROGRAM's
// stderr — the backend writers report a failed write by logging — and the `File.exists` check below is
// satisfied by the winner's file, so the loser publishes a key over a binary it did not build.
//
// ⚠ **`debugInfo` DEFAULTS TO FALSE ON `compileToProduct` AND MUST NOT HERE.** A program launched this way
// is one somebody is developing, and a crash with no sidecar beside the binary is a stack trace nobody can
// read.
function fillSlot(slot RunSlot, target Target, entryFunction ByteArray, speaker String) throws CachedBuildError
	let program = slot.program

	var inputPaths = MaxonSourcePathArray.create()
	inputPaths.push(program)

	let product = try compileToProduct(inputPaths, target: target, outputOverride: slot.pending.toString(), runtimeIrNames: RuntimeFunctionNameArray.create(), debugInfo: true, entryFunction: entryFunction) otherwise (e) 'compileFailed'
		reportCompileError(e)
		throw CachedBuildError.notBuilt
	end 'compileFailed'

	// A successful return is a claim about the BUILD; what the spawn needs is a claim about the FILE.
	// Absent it, the spawn reports "could not run" about a compiler defect.
	if not File.exists(product.outputPath) 'nothingWritten'
		printError("{speaker}: compiling {program.toString()} reported success but left no {product.outputPath.toString()}\n")
		throw CachedBuildError.notBuilt
	end 'nothingWritten'

	try publishSlotBuild(slot, built: product.outputPath) otherwise (e) 'notPublished'
		reportCacheError(e, speaker: speaker)
		throw CachedBuildError.notBuilt
	end 'notPublished'
end 'fillSlot'
