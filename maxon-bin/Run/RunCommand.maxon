// RunCommand.maxon — `maxon run <file|directory> [args...]`: compile a program, or reuse a cached build
// of it, and run it as though it had been launched directly.
//
// ⭐⭐ **THE STREAMS AND THE EXIT CODE ARE THE PROGRAM'S.** stdin, stdout and stderr are inherited and the
// child's exit code is this command's, so a program run this way is indistinguishable from one launched
// by name. That is also why `quietTheBuildChatter` takes the build down to ERROR: a compiler announcing
// the bytes it wrote onto a program's own stdout is output nobody asked for and nothing downstream can
// filter back out. ⚠ **SILENCED IS NOT SILENT — the ERROR level is deliberately left speaking**, so a
// compile that fails still says why on stderr (`compile-error.test.maxon` asserts exactly that), and so
// does a build the emitter could not complete.
//
// ⭐⭐ **TWO DOORS, ONE COMMAND.** The word (`maxon run f.maxon a b`) and a first argument ending in
// `.maxon` (`maxon f.maxon a b`), which is what a kernel hands the interpreter for a file whose first line
// is `#!/usr/bin/env maxon`. Both arms of `MaxonArgs.parse` file the same shape — the program at position
// 0, its own arguments after it — and reach this ONE function, so the two cannot come to behave
// differently.
//
// ⚠ **NOTHING HERE TAKES THE CHECKOUT'S TREE LOCK, AND THE COMPILE'S EXPLICIT OUTPUT PATH IS WHY THAT IS
// SAFE.** `compileToProduct` is driven directly, so `Main.acquireBuildTreeLock` is never reached — and the
// rule it enforces is met anyway: everything this writes goes to the cache slot it was told to write to,
// never to `<project>/.maxon/`, so running a program from inside a checkout cannot race a build of it.

// What a command line this command could not act on exits with. 1, not `NothingRanExitCode`: `run` has
// only "it ran" and "it did not", which is the answer `Main.refusedCommandLineExit` gives for the word.
let RefusedRunExit = 1 as ExitCode

// A signal number a child died on.
typealias SignalNumber = int(i64.min to i64.max)

export function runRun(args MaxonArgs) returns ExitCode
	let spelling = try args.paths.get(0) otherwise 'noProgram'
		printError("Usage: {runUsageLine()}\n")
		printError("No program was named. Give a `{MaxonSourceExtension}` file, or a directory to compile as one project.\n")
		return RefusedRunExit
	end 'noProgram'

	let typed = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return RefusedRunExit
	end 'badPath'

	// ⚠ **ABSOLUTE FROM HERE ON, AND THE REFUSAL BELOW STILL NAMES WHAT WAS TYPED.** The cache is keyed by
	// this path, so two runs from different directories must reach one slot; the reader who mistyped a name
	// needs their own spelling back.
	let program = typed.resolve(Directory.currentPath())
	let isProject = Directory.isDirectory(program)

	if not isProject and not File.exists(program) 'nothingThere'
		reportCompileError(CompileError.fileNotFound(typed))
		return RefusedRunExit
	end 'nothingThere'

	quietTheBuildChatter(args)

	return runProgram(program, isProject: isProject, arguments: programArguments(args.paths))
end 'runRun'

// The one sentence a cache failure reaches a reader through: the arm IS the fact and its payload is the
// sentence, so there is nothing to decide here.
function reportCacheError(e RunCacheError)
	match e 'why'
		unavailable(reason) then printError("{RunCommandName}: {reason}\n")
	end 'why'
end 'reportCacheError'

function runUsageLine() returns String
	return "maxon {RunCommandName} <file|directory> [args...]"
end 'runUsageLine'

// The PROGRAM's own command line: everything the driver was handed after the path. ONE reader for both
// doors — the word door drops the word, the wordless one keeps the file — so neither can drift into
// passing the program a different argument list.
function programArguments(paths SourcePathSpellingArray) returns StringArray
	var arguments = StringArray.create()
	for position in 1 upto paths.count() 'eachArgument'
		arguments.push(try paths.get(position) otherwise panic("programArguments: index {position} is past paths.count() despite the upto bound"))
	end 'eachArgument'

	return arguments
end 'programArguments'

function runProgram(program FilePath, isProject bool, arguments StringArray) returns ExitCode
	let target = detectHostTarget()

	let slot = try locateRunSlot(program, isProject: isProject, target: target) otherwise (e) 'noCache'
		reportCacheError(e)
		return RefusedRunExit
	end 'noCache'

	// A hit is the file being THERE. Its name is the key, so there is nothing beside it to read and nothing
	// to compare — a build under that name was made from these very inputs.
	if not File.exists(slot.executable) 'notCachedYet'
		if not fillSlot(program, slot: slot, target: target) 'nothingToRun'
			return RefusedRunExit
		end 'nothingToRun'
	end 'notCachedYet'

	return spawnProgram(slot.executable, arguments: arguments)
end 'runProgram'

// Compile the program into its cache slot and publish it under the name its key gives it. FALSE when
// there is nothing to run afterwards, having said why: a failed compile through the one diagnostic sink,
// and a build that reported success and left nothing behind in this command's own words.
//
// ⭐⭐ **THE COMPILE GOES TO A PATH NO OTHER RUN CAN BE WRITING.** Concurrent cold runs of one program
// would otherwise contend over a single output file, where a loser's failed write reaches the PROGRAM's
// stderr — the backend writers report a failed write by logging — and the `File.exists` check below is
// satisfied by the winner's file, so the loser publishes a key over a binary it did not build.
//
// ⚠ **`debugInfo` DEFAULTS TO FALSE ON `compileToProduct` AND MUST NOT HERE.** A program launched this way
// is one somebody is developing, and a crash with no sidecar beside the binary is a stack trace nobody can
// read.
function fillSlot(program FilePath, slot RunSlot, target Target) returns bool
	var inputPaths = MaxonSourcePathArray.create()
	inputPaths.push(program)

	let product = try compileToProduct(inputPaths, target: target, outputOverride: slot.pending.toString(), runtimeIrNames: RuntimeFunctionNameArray.create(), debugInfo: true) otherwise (e) 'compileFailed'
		reportCompileError(e)
		return false
	end 'compileFailed'

	// A successful return is a claim about the BUILD; what the spawn below needs is a claim about the FILE.
	// Absent it, the spawn reports "could not run" about a compiler defect.
	if not File.exists(product.outputPath) 'nothingWritten'
		printError("{RunCommandName}: compiling {program.toString()} reported success but left no {product.outputPath.toString()}\n")
		return false
	end 'nothingWritten'

	try publishSlotBuild(slot, built: product.outputPath) otherwise (e) 'notPublished'
		reportCacheError(e)
		return false
	end 'notPublished'

	return true
end 'fillSlot'

// ⚠ **`timeoutMs = 0` IS THE PROGRAM'S OWN RUNTIME AS THE BUDGET.** A deadline here would kill a
// long-running program the caller launched deliberately, and this command has no idea what one is.
function spawnProgram(executable FilePath, arguments StringArray) returns ExitCode
	var config = Configuration.create(Executable.path(executable))
	config.arguments = arguments
	config.standardInput = InputSource.inherit
	config.standardOutput = OutputDestination.inherit
	config.standardError = OutputDestination.inherit
	config.timeoutMs = 0

	let ran = try Subprocess.runConfiguration(config) otherwise (e) 'unspawnable'
		printError("{RunCommandName}: could not run {executable.toString()} ({e.displayReason()})\n")
		return RefusedRunExit
	end 'unspawnable'

	return match ran.status 'termination'
		exited(code) gives code as ExitCode
		signalled(code) gives reportSignalled(executable, signal: code as SignalNumber)
	end 'termination'
end 'spawnProgram'

// A program killed by a signal has no exit code to forward, so the signal is named and the failure is
// this command's own rather than a number invented on the program's behalf.
//
// ⚠ **NO TARGET'S EMITTED RUNTIME RAISES `signalled` YET** — `SubprocessRuntime` stores only the `exited`
// and `timedOut` discriminators — so an abnormally terminated child arrives as `exited` carrying the raw
// OS status (0xC00000FD for a Windows stack overflow, forwarded verbatim). The arm is what the union owes,
// and it becomes reachable the day that decoding lands.
function reportSignalled(executable FilePath, signal SignalNumber) returns ExitCode
	printError("{RunCommandName}: {executable.toString()} was killed by signal {signal}\n")
	return RefusedRunExit
end 'reportSignalled'
