// RunCache.maxon — where `maxon execute`, `maxon run` and a path-less `maxon build` keep a compiled
// program, and how the cache decides the one it kept is still the program it was asked for.
//
// ⭐⭐ **THE KEY IS THE BUILD'S FILENAME, WHICH IS WHAT MAKES A WRONG ANSWER UNREACHABLE.** Nothing is
// recorded beside the executable and nothing is compared: a build named after the inputs it was made from
// cannot vouch for any others. Two runs that compute DIFFERENT keys therefore write DIFFERENT files and
// cannot contend at all, and two that compute the SAME key are producing byte-identical output, so
// whichever of them lands is correct.
//
// ⭐⭐ **EVERY SOURCE IN THE KEY IS THERE BY ITS CONTENT HASH, NEVER BY A MODIFICATION TIME.**
// `File.info().modifiedTime` is whole SECONDS on every target this compiler emits
// (`Testing/CompilerFreshness.maxon` records the measurement), so an edit landing in the same second as
// the build it invalidates TIES — and a tie resolved either way is wrong: reuse runs STALE CODE, rebuild
// recompiles on every run inside one second. A hash has no tie, which is also what lets a test assert a
// hit and a miss without sleeping. ⚠ The COMPILER is the one input that is identified rather than
// hashed, and `compilerLine` states the tie that costs.
//
// ⭐⭐ **THE STANDARD LIBRARY AND THE COMPILER ARE IN THE KEY**, because a cached binary froze both: an
// edit under `stdlib/` or a newer compiler must produce a different program from the same source, and
// nothing in the program's own text says so.
//
// ⭐ **EACH FILE IS HASHED ON ITS OWN AND THE KEY IS TAKEN OVER THE DIGESTS**, so peak memory is about
// twice the largest source rather than the whole corpus — the standard library alone is megabytes, and
// this runs ahead of every cached run.

// Bumped when the manifest below or the slot layout changes shape, which invalidates every slot at once:
// two rules can agree on a key by accident, and the name a key becomes says nothing about which rule
// spelled it.
//
// ⭐ **THE FORMAT IS A DIRECTORY, `<root>/maxon/run/v<n>/`, SO A SUPERSEDED ONE CAN BE FOUND.** A key is a
// hash, so a slot of an older format sits under a name no run computes; only the directory above it says
// which format it belongs to. Short, because every slot path spends from Windows' 260-character budget.
let CacheFormat = 2 as CacheFormatNumber
let CacheFormatPrefix = "v"

// A format directory's name split at the prefix: nothing before it, and the number after it.
let FormatNameParts = 2
let FormatNumberPart = 1

typealias CacheFormatNumber = int(1 to u32.max)

// ⭐⭐ **EVERY ROOT IS INSIDE A DIRECTORY ONLY ITS OWNER MAY WRITE, WHICH IS WHY A HOST NAMING NONE OF
// THEM IS REFUSED BY NAME ON BOTH LANES.** A cache under a world-writable directory belongs to every user
// of the host at once: two users' builds collide in it, and a local attacker can own the root — or plant a
// directory symlink inside it — before its first use. So the whole roster is directories a variable this
// process was GIVEN names, and a host naming none is told which one to set rather than sent to a directory
// anybody can write.
#if os(Windows)
	// Where a Windows user's own files are, and the two host scratch areas that stand in when it names
	// nothing.
	let HomeDirectoryVariable = "USERPROFILE"
	let WindowsCacheRootVariable = "LOCALAPPDATA"
	let WindowsTempVariable = "TEMP"
#else
	let HomeDirectoryVariable = "HOME"
	let PosixTempVariable = "TMPDIR"
#endif

// `<scratch area>/maxon/run/<format>/<one directory per program>` — under a directory of this compiler's
// own, so a shared temp area is not littered with slot names that say nothing about what put them there.
let CacheVendorDirName = "maxon"
let CacheCommandDirName = "run"

// ⭐ **`<home>/.maxon` IS THE INSTALL SCRIPT'S OWN DEFAULT INSTALL ROOT** (`website/public/install.sh`,
// `install.ps1`), so under a home directory the cache sits beside the `bin/` and `stdlib/` it belongs to
// rather than in a second directory of Maxon's elsewhere on the machine.
let MaxonUserDirName = ".maxon"
let UserCacheDirName = "cache"

// How `cacheRootChain` spells the value of a variable, and what separates two places in it.
let VariableOpenMark = "<"
let VariableCloseMark = ">"
let ChainSeparator = ", then "

// What separates a build's name from the key that names it, and what an in-flight build carries before
// its extension.
//
// ⛔ **NOTHING PUBLISHED CAN END IN THE PENDING MARKER**, which is what keeps a half-written build out of
// the hit test: a published name ends in the key's hex digits, and `p` is not one.
let SlotKeySeparator = "-"
let PendingBuildMarker = ".tmp"

// ⛔ **A SLOT PATH HAS A BUDGET, AND WINDOWS SETS IT AT 260 CHARACTERS.** Two full SHA-256s spelled out
// is 128 of them before the root, the stem or the extension are counted — MEASURED: a checkout five
// characters deeper than usual put the `.mxdbg` sidecar at 259 and the backend could not write it, which
// reads as a build that produced no file rather than as a path too long.
//
// ⚠ **THESE ARE NAMES, NOT SIGNATURES.** 64 bits distinguishes the builds one developer's cache holds;
// the collision it risks is a stale binary served for changed inputs, at a population no cache reaches.
let CacheNameDigestBytes = 8

// How many characters a key occupies once `hexDigest` has spelled it, and the digits it may be spelled in.
// Lower case, because that is what a `{byte:02x}` field writes.
let CacheKeyCharacters = CacheNameDigestBytes * 2
let CacheKeyDigits = "0123456789abcdef"

// A stem is for a READER and for the program's own `argv[0]`, so it is trimmed rather than dropped — a
// name long enough to recognise costs a fraction of what spelling a whole digest does.
let MaxSlotStemLength = 24

// Manifest fields are tab-separated and one fact per line: a path may contain a space, and cannot contain
// a tab or a newline on any host this compiler targets.
let ManifestFieldSeparator = "\t"
let ManifestLineSeparator = "\n"

let VersionFieldLabel = "format"
let CompilerFieldLabel = "compiler"
let ProgramFieldLabel = "program"
let StdlibFieldLabel = "stdlib"
let EntryFieldLabel = "entry"

typealias CacheRootCandidateArray = Array with CacheRootCandidate
export typealias CacheRootArray = Array with FilePath
typealias ManifestFieldArray = Array with String
typealias BuildNameArray = Array with String

// ⛔ **ONE ARM CARRYING THE SENTENCE.** Every cause — no writable root, an unreadable source, a compiler
// that cannot name itself — is the SAME fact to the caller (there is no cache to build in) and a DIFFERENT
// sentence to the reader, so the arm is the fact and the payload is the sentence.
export union RunCacheError implements Error
	unavailable(reason String)
end 'RunCacheError'

// One program's place in the cache: the path its key was computed over, the build the current inputs
// name, and the private path a fresh one is written to before it takes that name.
module type RunSlot
	export let program as FilePath
	export let directory as FilePath
	export let executable as FilePath
	export let pending as FilePath
	export let binarySuffix as String
	export let formatsRoot as FilePath

	static function create(program FilePath, directory FilePath, executable FilePath, pending FilePath, binarySuffix String, formatsRoot FilePath) returns RunSlot
		return Self{program: program, directory: directory, executable: executable, pending: pending, binarySuffix: binarySuffix, formatsRoot: formatsRoot}
	end 'create'
end 'RunSlot'

// The slot this program's build belongs in, and the name a build made from the current inputs carries
// there.
//
// ⛔ The slot's identity is the program's path anchored at the working directory, and the compile
// reads that same path (`RunSlot.program`). Anchored, because a relative spelling is the same text
// in every checkout, and every checkout's `maxon.maxproj` would then share one slot and evict the
// others' builds. Its `..` components are never folded: `link/..` folds lexically to `.` while the
// filesystem answers the link target's parent, so a folded key would describe a different file from
// the one compiled.
//
// ⚠ **THE STEM IS THERE FOR A READER AND FOR THE PROGRAM'S OWN `argv[0]`**, never for finding the build:
// one slot directory holds one program's builds, so the key alone would locate them.
//
// ⭐ **THE PENDING NAME CARRIES THE PROCESS ID, WHICH IS WHAT MAKES IT ONE WRITER'S.** No two live
// processes share an id, and a process fills at most one slot per program: `maxon run` builds its one
// program and `maxon build` its one manifest, each once. A pending file a DEAD process left under a reused
// id is overwritten, which costs nothing — its writer is gone.
module function locateRunSlot(spelled FilePath, isProject bool, target Target, entryFunction ByteArray) returns RunSlot throws RunCacheError
	let program = spelled.anchoredAt(Directory.currentPath())
	let key = try freshnessKey(program, isProject: isProject, target: target, entryFunction: entryFunction)
	let stem = try slotStem(program, isProject: isProject)
	let formatsRoot = try runCacheRoot()
	let dir = try slotDirectory(program, entryFunction: entryFunction, formatsRoot: formatsRoot)
	let binarySuffix = executableExtension(target.os)
	let built = "{stem}{SlotKeySeparator}{key}"

	return RunSlot.create(program, directory: dir, executable: dir.join("{built}{binarySuffix}"), pending: dir.join("{built}.{__Builtins.currentProcessId()}{PendingBuildMarker}{binarySuffix}"), binarySuffix: binarySuffix, formatsRoot: formatsRoot)
end 'locateRunSlot'

// Take the built program's key-name, which IS publishing it: from that moment every other run reads it as
// a hit.
//
// ⭐ **A FAILED RENAME WHOSE TARGET IS THERE IS A SUCCESS.** The name is the key, so whatever occupies it
// was built from these very inputs — by a run that got there first, and which Windows will not let this
// one replace while it is executing it. A failure with NOTHING there is the real one, and it refuses by
// name rather than leaving the caller to discover there is nothing to run.
module function publishSlotBuild(slot RunSlot, built FilePath) throws RunCacheError
	try File.rename(built, to: slot.executable) otherwise 'notRenamed'
		if not File.exists(slot.executable) 'nothingPublished'
			throw RunCacheError.unavailable("could not publish {slot.executable.toString()}: {built.toString()} could not be renamed onto it, and nothing is there to run")
		end 'nothingPublished'

		discardBuild(built)
		return
	end 'notRenamed'

	publishDebugSidecar(built, to: slot.executable)
	discardSupersededBuilds(slot)
	discardOlderCacheFormats(slot)
end 'publishSlotBuild'

// The sidecar is named after the binary, so it travels with it: the name is the only thing linking a
// `.mxdbg` to an executable.
//
// Debug info is an aid rather than an output, so every step is best-effort and silent — a program that
// built correctly must not be refused because its sidecar could not be moved.
function publishDebugSidecar(built FilePath, to FilePath)
	let sidecar = try debugSidecarOf(built) otherwise return
	let published = try debugSidecarOf(to) otherwise return

	if not File.exists(sidecar) 'nothingToMove'
		return
	end 'nothingToMove'

	try File.rename(sidecar, to: published) otherwise ignore
end 'publishDebugSidecar'

// This program's earlier builds, which no run can reach again: a key is a name, so nothing that would
// find one of them has inputs that hash to it.
//
// ⛔ **EVERY FAILURE IS IGNORED AND NONE REACHES A STREAM.** A superseded build another run is EXECUTING
// cannot be removed on Windows, and the run doing the removing has already built what it was asked for.
//
// ⛔ **A PENDING NAME IS LEFT ALONE — ANOTHER RUN IS WRITING IT.** Removing one costs that run its rename,
// which it would then report as a failure with nothing published.
function discardSupersededBuilds(slot RunSlot)
	let current = slot.executable.filename()

	var kept = BuildNameArray.create()
	kept.push(current)
	kept.push("{current}{MxdbgSidecarExtension}")

	discardSlotBuilds(slot.directory, binarySuffix: slot.binarySuffix, kept: kept)
end 'discardSupersededBuilds'

// Every build an OLDER cache format left, which no run of this format can reach again. Swept when a build
// is published, so a hit pays nothing for it, and under `discardSupersededBuilds`' rules: failures ignored,
// pending names left alone — an older driver may be writing one now.
//
// ⚠ **A NEWER FORMAT'S DIRECTORY IS LEFT ALONE**, because a newer driver on this host is using it; sweeping
// both ways would have two installed drivers discard each other's builds on every miss.
//
// ⛔ **ONLY THE DEPTH A FORMAT'S LAYOUT PUTS FILES AT IS SWEPT**, never a walk: a directory at any other
// depth — a link planted in the cache included — is nothing a driver wrote, and a walk would follow it.
function discardOlderCacheFormats(slot RunSlot)
	let entries = try Directory.list(slot.formatsRoot) otherwise return
	let nothingKept = BuildNameArray.create()

	for entry in entries 'eachEntry'
		let name = entry.filename()

		// The unversioned layout kept its slots here, and a key is hex, so no slot name begins with the prefix.
		if not name.startsWith(CacheFormatPrefix) 'aSlotOfTheUnversionedLayout'
			discardSlotBuilds(entry, binarySuffix: slot.binarySuffix, kept: nothingKept)
			continue
		end 'aSlotOfTheUnversionedLayout'

		if not isOlderCacheFormatName(name) 'notOlder'
			continue
		end 'notOlder'

		let slots = try Directory.list(entry) otherwise continue

		for olderSlot in slots 'eachOlderSlot'
			discardSlotBuilds(olderSlot, binarySuffix: slot.binarySuffix, kept: nothingKept)
		end 'eachOlderSlot'

		try Directory.delete(entry) otherwise ignore
	end 'eachEntry'
end 'discardOlderCacheFormats'

// A prefixed name that is not the prefix and a number was written by no driver, and is left alone.
function isOlderCacheFormatName(name String) returns bool
	let parts = name.split(CacheFormatPrefix)

	if parts.count() != FormatNameParts 'notAFormatName'
		return false
	end 'notAFormatName'

	let digits = try parts.get(FormatNumberPart) otherwise panic("isOlderCacheFormatName: the count is {FormatNameParts} on the line above")
	let format = try int.fromString(digits) otherwise return false

	return format < CacheFormat
end 'isOlderCacheFormatName'

// A slot's files, but for `kept` and any build still being written. A non-directory `dir` lists nothing
// and is left alone.
//
// ⭐ **THE EMPTIED DIRECTORY GOES WITH THEM**, or a slot costs a name for the life of the install, one per
// program ever run. The removal is asked for unconditionally because `Directory.delete` refuses a
// directory that still holds an entry, so a slot keeping its newest build declines it by itself.
function discardSlotBuilds(dir FilePath, binarySuffix String, kept BuildNameArray)
	let entries = try Directory.list(dir) otherwise return

	for entry in entries 'eachEntry'
		let name = entry.filename()

		if kept.contains(name) or isPendingBuildName(name, binarySuffix: binarySuffix) 'leftInPlace'
			continue
		end 'leftInPlace'

		if Directory.isDirectory(entry) 'notABuild'
			continue
		end 'notABuild'

		discardQuietly(entry)
	end 'eachEntry'

	try Directory.delete(dir) otherwise ignore
end 'discardSlotBuilds'

// ⭐⭐ **WHAT A PUBLISHED BUILD IS, ASKED AS THE SHAPE ITS NAME HAS.** `locateRunSlot` names a build
// `<stem>`, the separator, the key, the target's extension — and the key is exactly `CacheKeyCharacters`
// hex digits, which is the mark the pending marker is chosen against. Asked positively because the root
// holds more than builds: the MCP server stages a snippet SOURCE under it, and a test by elimination
// counts that as a build. `export` because `maxon cache` counts them.
//
// ⚠ **EVERY TARGET'S EXECUTABLE EXTENSION IS TRIED**, because a build's name ends in the extension of the
// target it was built FOR and one root holds the builds of every target this host compiled for.
export function isPublishedBuildName(name String) returns bool
	for os in Os.allCases 'eachOs'
		let binarySuffix = executableExtension(os)

		if name.endsWith(binarySuffix) and endsInSlotKey(name, binarySuffix: binarySuffix) 'aBuildForThatTarget'
			return true
		end 'aBuildForThatTarget'
	end 'eachOs'

	return false
end 'isPublishedBuildName'

// Whether a whole key and nothing else stands between the LAST separator and `binarySuffix`, which the
// caller has already found at the end of the name. A stem may hold separators of its own, so the last one
// is the only one a key can follow.
//
// A sidecar and a build still being written both fail on the same evidence: what stands there is `.mxdbg`
// or the writer's process id, so the span is the wrong length and its characters are not all hex.
function endsInSlotKey(name String, binarySuffix String) returns bool
	let separator = try name.findLast(SlotKeySeparator) otherwise return false
	let keyStarts = try name.indexAfter(separator) otherwise return false
	let tail = name.slice(keyStarts, endIndex: name.endIndex())

	if tail.count() != CacheKeyCharacters + binarySuffix.count() 'notAWholeKey'
		return false
	end 'notAWholeKey'

	var digits = 0

	for character in tail 'eachCharacter'
		if digits >= CacheKeyCharacters 'pastTheKey'
			break
		end 'pastTheKey'

		if not CacheKeyDigits.contains(character) 'notAKey'
			return false
		end 'notAKey'

		digits = digits + 1
	end 'eachCharacter'

	return true
end 'endsInSlotKey'

// A build still being written, or its sidecar. The hit test cannot match one, and removing it costs its
// writer the rename that publishes it.
function isPendingBuildName(name String, binarySuffix String) returns bool
	let pending = "{PendingBuildMarker}{binarySuffix}"
	return name.endsWith(pending) or name.endsWith("{pending}{MxdbgSidecarExtension}")
end 'isPendingBuildName'

// A build that never took its name, sidecar included. What survives is a pending name, which the hit test
// structurally cannot match.
function discardBuild(built FilePath)
	discardQuietly(built)

	let sidecar = try debugSidecarOf(built) otherwise return
	discardQuietly(sidecar)
end 'discardBuild'

// A binary's debug sidecar. The extension is composed in ONE place because the name is the only thing
// linking the two files.
function debugSidecarOf(binary FilePath) returns FilePath throws RunCacheError
	return try FilePath.from("{binary.toString()}{MxdbgSidecarExtension}") otherwise throw RunCacheError.unavailable("{binary.toString()} has no spellable debug-sidecar path")
end 'debugSidecarOf'

function discardQuietly(path FilePath)
	if not File.exists(path) 'nothingThere'
		return
	end 'nothingThere'

	try File.delete(path) otherwise ignore
end 'discardQuietly'

// ============================================================================================
// WHERE A SLOT LIVES
// ============================================================================================

// One place this host may keep Maxon's cache: a variable naming a directory, and the path under that
// directory that is Maxon's own. A roster of variable NAMES alone could not express `<home>/.maxon/cache`,
// which is nothing any variable holds.
type CacheRootCandidate
	export let variable as String
	export let suffix as FilePath

	static function create(variable String, suffix FilePath) returns CacheRootCandidate
		return Self{variable: variable, suffix: suffix}
	end 'create'
end 'CacheRootCandidate'

// The cache directories this host consults, in order. The override comes first so a caller whose home or
// temp area is unwritable — or a test that must not touch the developer's cache — can name another without
// this having to guess.
//
// ⭐ **THE USER'S OWN MAXON DIRECTORY OUTRANKS THE HOST'S SCRATCH AREA**, because the cache belongs beside
// the install it was built by rather than in an area the host may sweep between two runs of one program.
function cacheRootCandidates() returns CacheRootCandidateArray
	let vendorDir = FilePath.empty().join(CacheVendorDirName)
	let userCacheDir = FilePath.empty().join(MaxonUserDirName).join(UserCacheDirName)

	var candidates = CacheRootCandidateArray.create()
	candidates.push(CacheRootCandidate.create(RunCacheRootVariable, suffix: vendorDir))

	#if os(Windows)
		candidates.push(CacheRootCandidate.create(HomeDirectoryVariable, suffix: userCacheDir))
		candidates.push(CacheRootCandidate.create(WindowsCacheRootVariable, suffix: vendorDir))
		candidates.push(CacheRootCandidate.create(WindowsTempVariable, suffix: vendorDir))
	#else
		candidates.push(CacheRootCandidate.create(HomeDirectoryVariable, suffix: userCacheDir))
		candidates.push(CacheRootCandidate.create(PosixTempVariable, suffix: vendorDir))
	#endif

	return candidates
end 'cacheRootCandidates'

// Every root stays on the roster, including one no run can use. A build published while a different
// variable ranked highest, or while a root that is now unusable still worked, is still on disk and
// `maxon cache clear` is the only thing that reaches it — so filtering the roster by what a run
// can create would hide exactly the disk a reader needs to reclaim.
//
// One entry per directory however many variables name it: `TEMP` and `TMPDIR` routinely hold one
// path, and a caller acting per entry would act on that directory twice.
export function hostCacheRoots() returns CacheRootArray throws RunCacheError
	var roots = CacheRootArray.create()

	for candidate in cacheRootCandidates() 'eachCandidate'
		let spelled = try Process.environmentVariable(candidate.variable) otherwise continue

		if spelled.isEmpty() 'namesNowhere'
			continue
		end 'namesNowhere'

		let named = try FilePath.from(spelled) otherwise continue
		noteRoot(roots, root: named.join(candidate.suffix))
	end 'eachCandidate'

	if roots.isEmpty() 'noneNamed'
		throw RunCacheError.unavailable(noCacheRootMessage())
	end 'noneNamed'

	return roots
end 'hostCacheRoots'

// Windows folds a path's case and POSIX does not, which `FilePath.equals` answers for the host.
function noteRoot(roots CacheRootArray, root FilePath)
	for seen in roots 'eachSeen'
		if seen.equals(root) 'alreadyNamed'
			return
		end 'alreadyNamed'
	end 'eachSeen'

	roots.push(root)
end 'noteRoot'

// The run cache keeps compiled programs under this directory and the MCP server stages inline
// snippets under it, so everything below it is Maxon's and everything beside it is somebody
// else's — which is what lets `maxon cache clear` know where to stop. A second derivation of it is
// a second answer to that.
export function hostCacheRoot() returns FilePath throws RunCacheError
	let roots = try hostCacheRoots()

	match cacheRootARunUses(roots) 'decided'
		usable(directory) then return directory
		noneUsable then throw RunCacheError.unavailable(noCacheRootMessage())
	end 'decided'
end 'hostCacheRoot'

module union CacheRootInUse
	usable(directory FilePath)
	noneUsable
end 'CacheRootInUse'

// Creating the root is the probe because it is the only question stdlib answers: `Directory.create`
// folds a path that is a file, a permission, a full disk and a lost race into one bare `false`. It
// is also exactly what the next run does, and nothing more.
//
// It answers true for a directory that already exists, so a root that exists and cannot be written
// under passes here, and the run fails later in `slotDirectory` about that one directory. Closing
// that needs a write probe on every run.
module function cacheRootARunUses(roots CacheRootArray) returns CacheRootInUse
	for root in roots 'eachRoot'
		if Directory.create(root) 'created'
			return CacheRootInUse.usable(root)
		end 'created'
	end 'eachRoot'

	return CacheRootInUse.noneUsable
end 'cacheRootARunUses'

// The refusal names the variables THIS host consults, read off the same roster that consulted them: a
// sentence naming a variable nothing reads sends its reader to set something that changes nothing.
module function noCacheRootMessage() returns String
	var named = ""

	for candidate in cacheRootCandidates() 'eachCandidate'
		named = candidate.variable if named.isEmpty() else "{named}, {candidate.variable}"
	end 'eachCandidate'

	return "no directory to keep compiled programs in: none of {named} names one this compiler can create. Set {RunCacheRootVariable} to a writable directory."
end 'noCacheRootMessage'

// Where a reader is told to look for the cache, read off the same roster that decides it. `export`
// because the command reference prints it, and a reference naming a place the code does not consult
// sends its reader to the wrong directory.
export function cacheRootChain() returns String
	var chain = ""

	for candidate in cacheRootCandidates() 'eachCandidate'
		let place = "{VariableOpenMark}{candidate.variable}{VariableCloseMark}{FilePath.separator()}{candidate.suffix.toString()}"
		chain = place if chain.isEmpty() else "{chain}{ChainSeparator}{place}"
	end 'eachCandidate'

	return chain
end 'cacheRootChain'

// The directory every cache format keeps its own directory under.
function runCacheRoot() returns FilePath throws RunCacheError
	let root = try hostCacheRoot()
	return root.join(CacheCommandDirName)
end 'runCacheRoot'

function cacheFormatName() returns String
	return "{CacheFormatPrefix}{CacheFormat}"
end 'cacheFormatName'

// ⛔ **WHAT MATTERS IS THAT THE SLOT IS THERE AFTERWARDS, NOT THAT THIS RUN MADE IT.** `Directory.create`
// answers false when the underlying create fails, and a run losing the mkdir to a simultaneous one fails
// exactly that way against a directory that now EXISTS — so the creation alone is not the question to ask.
//
// ⚠ **ONE SLOT PER PROGRAM AND ENTRY POINT.** A slot sweeps every build but its newest
// (`discardSupersededBuilds`), so two targets or two tasks of one driver file sharing one slot would
// evict each other on every use.
function slotDirectory(program FilePath, entryFunction ByteArray, formatsRoot FilePath) returns FilePath throws RunCacheError
	let identity = manifestLine(program.toString(), fields: [String.from(entryFunction)])
	let dir = formatsRoot.join(cacheFormatName()).join(hexDigest(sha256(identity.toByteArray())))

	if not Directory.create(dir) and not Directory.isDirectory(dir) 'unusable'
		throw RunCacheError.unavailable("could not create {dir.toString()}, where this program's build is kept. Set {RunCacheRootVariable} to a writable directory.")
	end 'unusable'

	return dir
end 'slotDirectory'

// A file's build is named after the FILE and a directory's after the DIRECTORY.
//
// ⚠ **THAT DELIBERATELY DIFFERS FROM `build`**, which names a directory's product after its FIRST SOURCE
// FILE: that name depends on walk order, so two builds of one project can produce two names, and a slot's
// contents must be findable by anybody reading the directory.
function slotStem(program FilePath, isProject bool) returns String throws RunCacheError
	let named = program.normalize()
	let name = named.filename() if isProject else named.stem()

	if name.isEmpty() 'unnameable'
		throw RunCacheError.unavailable("{program.toString()} has no name a cached build could be called after")
	end 'unnameable'

	// Trimmed by CHARACTER rather than by byte: a stem is a filename, and half a codepoint is not one.
	// The key that follows it is what identifies the build, so a shortened stem collides with nothing.
	var trimmed = ""
	var taken = 0

	for character in name 'eachCharacter'
		if taken >= MaxSlotStemLength 'longEnough'
			break
		end 'longEnough'

		trimmed.append("{character}")
		taken = taken + 1
	end 'eachCharacter'

	return trimmed
end 'slotStem'

// ============================================================================================
// THE KEY
// ============================================================================================

// The entry point is in the key because two entry points over one source are two programs.
function freshnessKey(program FilePath, isProject bool, target Target, entryFunction ByteArray) returns String throws RunCacheError
	var manifest = ""
	manifest.append(versionLine())
	manifest.append(try compilerLine(target))
	manifest.append(manifestLine(EntryFieldLabel, fields: [String.from(entryFunction)]))

	let sources = try programSources(program, isProject: isProject)
	manifest.append(try digestLines(ProgramFieldLabel, paths: sources))

	let library = try stdlibSources()
	manifest.append(try digestLines(StdlibFieldLabel, paths: library))

	return hexDigest(sha256(manifest.toByteArray()))
end 'freshnessKey'

// One manifest line: a label and its fields. Everything the key is computed over comes through here, so no
// caller assembles a separator of its own.
function manifestLine(label String, fields ManifestFieldArray) returns String
	var line = ""
	line.append(label)

	for field in fields 'eachField'
		line.append("{ManifestFieldSeparator}{field}")
	end 'eachField'

	line.append(ManifestLineSeparator)

	return line
end 'manifestLine'

function versionLine() returns String
	var fields = ManifestFieldArray.create()
	fields.push(cacheFormatName())

	return manifestLine(VersionFieldLabel, fields: fields)
end 'versionLine'

// ⚠ **THE COMPILER IS IDENTIFIED BY ITS PATH, SIZE AND MODIFICATION TIME, NOT BY ITS BYTES.** Hashing a
// binary of tens of megabytes ahead of every cached run is exactly the cost this cache exists to avoid.
//
// ⛔ **AND THAT IS THE ONE PLACE THE KEY CAN TIE.** A modification time is whole seconds, so two DIFFERENT
// compilers of the same size written to one path inside one second are indistinguishable here and the
// second serves the first's builds. A self-compile takes far longer than a second, so the reachable shape
// is a script copying prebuilt compilers over one path — not an edit-and-rebuild loop, which is what every
// other input is hashed to protect.
//
// The TARGET rides beside it because one compiler emits several.
function compilerLine(target Target) returns String throws RunCacheError
	let exe = try Process.executablePath() otherwise throw RunCacheError.unavailable("could not determine this compiler's own path, which the build cache key is computed over")
	let info = try File.info(exe) otherwise throw RunCacheError.unavailable("could not read {exe.toString()}, which the build cache key is computed over")

	var fields = ManifestFieldArray.create()
	fields.push(exe.toString())
	fields.push("{info.size}")
	fields.push("{info.modifiedTime}")
	fields.push(targetToString(target))

	return manifestLine(CompilerFieldLabel, fields: fields)
end 'compilerLine'

// ⭐ **WALK ORDER IS PART OF THE KEY.** The loader registers sources in the order the walk found them and
// never sorts, so two orders are two programs. The PATH rides in the line beside the digest for the same
// reason: a namespace is derived from a path, so a renamed file is a different program with identical
// bytes.
function digestLines(label String, paths MaxonSourcePathArray) returns String throws RunCacheError
	var lines = ""

	for path in paths 'eachSource'
		lines.append(try sourceLine(label, path: path))
	end 'eachSource'

	return lines
end 'digestLines'

function sourceLine(label String, path FilePath) returns String throws RunCacheError
	let bytes = try File.readBinary(path) otherwise throw RunCacheError.unavailable("could not read {path.toString()}, which the build cache key is computed over")

	var fields = ManifestFieldArray.create()
	fields.push(path.toString())
	fields.push(hexDigest(sha256(bytes)))

	return manifestLine(label, fields: fields)
end 'sourceLine'

// The sources a build of this program compiles. The walk is the compiler's own, so a file the build reads
// and this did not is not expressible.
function programSources(program FilePath, isProject bool) returns MaxonSourcePathArray throws RunCacheError
	var sources = MaxonSourcePathArray.create()

	if not isProject 'oneNamedFile'
		sources.push(program)
		return sources
	end 'oneNamedFile'

	_ = try collectMaxonSources(program, into: sources) otherwise throw RunCacheError.unavailable("could not walk {program.toString()} for the sources the build cache key is computed over")

	return sources
end 'programSources'

// ⛔ **EVERY SOURCE A COMPILE READS AND THE AUTHOR DID NOT WRITE — BOTH LIBRARY ROOTS, because a build
// reads both and a key that hashed only one would serve a stale executable after a `runtime/` edit.**
function stdlibSources() returns MaxonSourcePathArray throws RunCacheError
	let stdlibDir = try locateStdlibDir() otherwise throw RunCacheError.unavailable("could not locate the stdlib/ directory, which the build cache key is computed over")
	let runtimeDir = try runtimeDirBeside(stdlibDir) otherwise throw RunCacheError.unavailable("could not locate the runtime/ directory beside stdlib/, which the build cache key is computed over")

	var walked = MaxonSourcePathArray.create()
	_ = try collectMaxonSources(stdlibDir, into: walked) otherwise throw RunCacheError.unavailable("could not walk {stdlibDir.toString()} for the sources the build cache key is computed over")
	_ = try collectMaxonSources(runtimeDir, into: walked) otherwise throw RunCacheError.unavailable("could not walk {runtimeDir.toString()} for the sources the build cache key is computed over")

	return walked
end 'stdlibSources'

// Nothing in the standard library renders bytes as hex, and a key has to be TEXT: it is the build's
// filename. Only the leading `CacheNameDigestBytes` are spelled — see the budget beside that constant.
function hexDigest(digest ByteArray) returns String
	var rendered = ""

	for (iter, one) in digest.withIterator() 'eachByte'
		if iter.index() >= CacheNameDigestBytes 'enoughToName'
			break
		end 'enoughToName'

		rendered.append("{one:02x}")
	end 'eachByte'

	return rendered
end 'hexDigest'
