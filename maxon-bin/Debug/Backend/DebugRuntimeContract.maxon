export typealias ContractFigure = int(i64.min to i64.max)
typealias ContractFigureArray = Array with ContractFigure
typealias ContractGlobalWidthArray = Array with DebugWidth

export union ContractGlobalLookup
	none
	at(address DebugAddress, bytes DebugWidth)
end 'ContractGlobalLookup'

export type DebugRuntimeContract
	let base as DebugAddress
	let text as DebugAddress
	let bytes as DebugAddress
	var figureNames as StringArray
	var figureValues as ContractFigureArray
	var globalNames as StringArray
	var globalAddresses as DebugAddressArray
	var globalBytes as ContractGlobalWidthArray

	// ⛔ **EVERY ADDRESS BELOW IS AN OFFSET FROM WHERE THE IMAGE ACTUALLY IS, NOT FROM WHERE IT WAS LINKED.**
	// A PE and an `ET_EXEC` ELF are loaded at the base their header names, so the two are the same number
	// there; a Mach-O main executable is position-independent and the kernel slides it, and the backend that
	// drives such a program is the only party that can say where it landed.
	export static function readFrom(reader MxdbgReader, textBytes DebugAddress, placement BackendImagePlacement) returns DebugRuntimeContract
		let imageBase = match placement 'placed'
			asLinked gives reader.imageBase as DebugAddress
			loadedAt(address) gives address
		end 'placed'

		var figureNames = StringArray.create()
		var figureValues = ContractFigureArray.create()

		for index in 0 upto reader.layoutFigureCount() 'eachFigure'
			let record = reader.layoutFigureRecord(index as MxdbgIndex)
			figureNames.push(record.name)
			figureValues.push(record.figure as ContractFigure)
		end 'eachFigure'

		var globalNames = StringArray.create()
		var globalAddresses = DebugAddressArray.create()
		var globalBytes = ContractGlobalWidthArray.create()

		for index in 0 upto reader.globalCount() 'eachGlobal'
			let record = reader.globalRecord(index as MxdbgIndex)
			globalNames.push(record.name)
			globalAddresses.push(imageBase + (record.imageOffset as DebugAddress))
			globalBytes.push(contractGlobalWidthOf(record))
		end 'eachGlobal'

		let textRva = figureIn(figureNames, values: figureValues, name: ImageTextRvaFigureName)

		return Self{base: imageBase, text: imageBase + (textRva as DebugAddress), bytes: textBytes, figureNames: figureNames, figureValues: figureValues, globalNames: globalNames, globalAddresses: globalAddresses, globalBytes: globalBytes}
	end 'readFrom'

	export function textBase() returns DebugAddress
		return self.text
	end 'textBase'

	export function textSize() returns DebugAddress
		return self.bytes
	end 'textSize'

	export function figure(name String) returns ContractFigure
		return figureIn(self.figureNames, values: self.figureValues, name: name)
	end 'figure'

	export function offset(name String) returns DebugAddress
		let value = self.figure(name)

		if value < 0 'notAnOffsetAtAll'
			panic("DebugRuntimeContract.offset: the sidecar publishes '{name}' as {value}, and a record field's displacement is never negative")
		end 'notAnOffsetAtAll'

		return value as DebugAddress
	end 'offset'

	export function globalAt(name String) returns ContractGlobalLookup
		for (iter, spelled) in self.globalNames.withIterator() 'eachGlobal'
			if spelled == name 'thisOne'
				let address = try self.globalAddresses.get(iter.index()) otherwise panic("DebugRuntimeContract.globalAt: the columns are filled together, so '{name}' has an address")
				let width = try self.globalBytes.get(iter.index()) otherwise panic("DebugRuntimeContract.globalAt: the columns are filled together, so '{name}' has a width")

				return ContractGlobalLookup.at(address, bytes: width)
			end 'thisOne'
		end 'eachGlobal'

		return ContractGlobalLookup.none
	end 'globalAt'
end 'DebugRuntimeContract'

function figureIn(names StringArray, values ContractFigureArray, name String) returns ContractFigure
	for (iter, spelled) in names.withIterator() 'eachFigure'
		if spelled == name 'thisOne'
			return try values.get(iter.index()) otherwise panic("figureIn: the two columns are filled together, so '{name}' has a value")
		end 'thisOne'
	end 'eachFigure'

	panic("figureIn: the `.mxdbg` sidecar publishes no layout figure named '{name}'. `Compiler/Debug/DebugContract.maxon` is the roster it is written from, so a name that roster does not carry cannot be answered")
end 'figureIn'

function contractGlobalWidthOf(record MxdbgGlobalInfo) returns DebugWidth
	if record.slotBytes < MinDebugWidth or record.slotBytes > MaxDebugWidth 'notAScalarSlot'
		panic("DebugRuntimeContract.readFrom: the `.mxdbg` sidecar gives global '{record.name}' a {record.slotBytes}-byte slot, and every global it publishes is a scalar of {MinDebugWidth} to {MaxDebugWidth} bytes, so the sidecar is malformed")
	end 'notAScalarSlot'

	return record.slotBytes as DebugWidth
end 'contractGlobalWidthOf'
