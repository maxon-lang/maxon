export union DebugBackend
	debugPort(backend WindowsBackend)
	processTrace(backend PtraceBackend)
	remoteStub(backend GdbRemoteBackend)

	export function holdsItsScratch() returns bool
		return match self 'which'
			debugPort(backend) gives backend.holdsItsScratch()
			processTrace(backend) gives backend.holdsItsScratch()
			remoteStub(backend) gives backend.holdsItsScratch()
		end 'which'
	end 'holdsItsScratch'

	export function close()
		match self 'which'
			debugPort(backend) then backend.close()
			processTrace(backend) then backend.close()
			remoteStub(backend) then backend.close()
		end 'which'
	end 'close'

	export function exitStatus() returns BackendExitStatus
		return match self 'which'
			debugPort(backend) gives backend.exitStatus()
			processTrace(backend) gives backend.exitStatus()
			remoteStub(backend) gives backend.exitStatus()
		end 'which'
	end 'exitStatus'

	export function adoptLaunchedProgram(program Pid) returns BackendAdoption
		return match self 'which'
			debugPort or
			processTrace gives BackendAdoption.ready(BackendImagePlacement.asLinked)

			remoteStub(backend) gives backend.adoptLaunchedProgram(program)
		end 'which'
	end 'adoptLaunchedProgram'

	// ⭐⭐ **WHICH FIELD OF A MACHINE NAMES THE THREAD THIS BACKEND REPORTS.** A Win32 thread id and a Linux
	// kernel `tid` are what the scheduler records for its own preemption, so those two lanes pair on that
	// field; a debug stub on Darwin names a thread by the unique id `pthread_threadid_np` answers, which the
	// scheduler records beside the `pthread_t` its own signals need.
	export function threadIdentityFigure() returns String
		return match self 'which'
			debugPort or
			processTrace gives MOffOsThreadIdFigureName

			remoteStub(backend) gives backend.threadIdentityFigure()
		end 'which'
	end 'threadIdentityFigure'

	export function listThreads() returns BackendThreadIdArray
		return match self 'which'
			debugPort(backend) gives backend.listThreads()
			processTrace(backend) gives backend.listThreads()
			remoteStub(backend) gives backend.listThreads()
		end 'which'
	end 'listThreads'

	export function stoppedThread() returns BackendThreadId
		return match self 'which'
			debugPort(backend) gives backend.stoppedThread()
			processTrace(backend) gives backend.stoppedThread()
			remoteStub(backend) gives backend.stoppedThread()
		end 'which'
	end 'stoppedThread'

	export function waitForStop(budgetMs BackendWaitBudgetMs) returns DebugStopEvent
		return match self 'which'
			debugPort(backend) gives backend.waitForStop(budgetMs)
			processTrace(backend) gives backend.waitForStop(budgetMs)
			remoteStub(backend) gives backend.waitForStop(budgetMs)
		end 'which'
	end 'waitForStop'

	export function resumeAll() returns bool
		return match self 'which'
			debugPort(backend) gives backend.resumeAll()
			processTrace(backend) gives backend.resumeAll()
			remoteStub(backend) gives backend.resumeAll()
		end 'which'
	end 'resumeAll'

	export function stepThread(thread BackendThreadId, others BackendOtherThreads) returns bool
		return match self 'which'
			debugPort(backend) gives backend.stepThread(thread, others: others)
			processTrace(backend) gives backend.stepThread(thread, others: others)
			remoteStub(backend) gives backend.stepThread(thread, others: others)
		end 'which'
	end 'stepThread'

	export function forgetStep(thread BackendThreadId)
		match self 'which'
			debugPort(backend) then backend.forgetStep(thread)
			processTrace(backend) then backend.forgetStep(thread)
			remoteStub(backend) then backend.forgetStep(thread)
		end 'which'
	end 'forgetStep'

	export function requestStop() returns bool
		return match self 'which'
			debugPort(backend) gives backend.requestStop()
			processTrace(backend) gives backend.requestStop()
			remoteStub(backend) gives backend.requestStop()
		end 'which'
	end 'requestStop'

	export function retireStopRequest()
		match self 'which'
			debugPort(backend) then backend.retireStopRequest()
			processTrace(backend) then backend.retireStopRequest()
			remoteStub(backend) then backend.retireStopRequest()
		end 'which'
	end 'retireStopRequest'

	export function detach() returns bool
		return match self 'which'
			debugPort(backend) gives backend.detach()
			processTrace(backend) gives backend.detach()
			remoteStub(backend) gives backend.detach()
		end 'which'
	end 'detach'

	// The debuggee is the driver's own child on every lane. Where the driver is also its debugger the
	// kernel ends it — the debug port kills a debuggee whose debugger exits and `PTRACE_O_EXITKILL` says
	// the same thing — so the reap of that child is the ending and `killTheProgram` is never asked.
	export function endsTheProgramItself() returns bool
		return match self 'which'
			debugPort or
			processTrace gives false

			remoteStub gives true
		end 'which'
	end 'endsTheProgramItself'

	export function killTheProgram() returns bool
		return match self 'which'
			debugPort or
			processTrace panic("DebugBackend.killTheProgram: this lane's debuggee is the driver's own traced child and the kernel ends it, so `endsTheProgramItself` answers false and nothing may ask this")

			remoteStub(backend) gives backend.killTheProgram()
		end 'which'
	end 'killTheProgram'

	export function readMemory(address DebugAddress, bytes BackendByteCount) returns BackendMemoryRead
		return match self 'which'
			debugPort(backend) gives backend.readMemory(address, bytes: bytes)
			processTrace(backend) gives backend.readMemory(address, bytes: bytes)
			remoteStub(backend) gives backend.readMemory(address, bytes: bytes)
		end 'which'
	end 'readMemory'

	export function writeMemory(address DebugAddress, bytes ByteArray) returns bool
		return match self 'which'
			debugPort(backend) gives backend.writeMemory(address, bytes: bytes)
			processTrace(backend) gives backend.writeMemory(address, bytes: bytes)
			remoteStub(backend) gives backend.writeMemory(address, bytes: bytes)
		end 'which'
	end 'writeMemory'

	// ⭐⭐ **WHO OWNS THE TRAP BYTE.** On the two native lanes the debugger writes it and keeps what stood
	// there, which is what makes a resume off one the restore-step-replant dance; a debug stub writes its own
	// and is the only thing that can take it out again, so it hands the engine no original and the engine's
	// every byte-restoring road becomes a write of nothing.
	export function plantTrap(address DebugAddress) returns BackendTrapPlant
		return match self 'which'
			debugPort or
			processTrace gives self.plantedByWriting(address)

			remoteStub(backend) gives backend.plantTrap(address)
		end 'which'
	end 'plantTrap'

	function plantedByWriting(address DebugAddress) returns BackendTrapPlant
		let trap = hostTrapShape()
		var original = ByteArray.create()

		match self.readMemory(address, bytes: trap.bytes()) 'read'
			unreadable then return BackendTrapPlant.unreadable
			read(bytes) then original = bytes
		end 'read'

		if original.count() != trap.instruction.count() 'aShortRead'
			return BackendTrapPlant.unreadable
		end 'aShortRead'

		if not self.writeMemory(address, bytes: trap.instruction) 'theBytesAreNotTheDebuggersToWrite'
			return BackendTrapPlant.unwritable
		end 'theBytesAreNotTheDebuggersToWrite'

		return BackendTrapPlant.planted(original)
	end 'plantedByWriting'

	export function liftTrap(address DebugAddress, original ByteArray) returns bool
		return match self 'which'
			debugPort or
			processTrace gives self.writeMemory(address, bytes: original)

			remoteStub(backend) gives backend.liftTrap(address, original: original)
		end 'which'
	end 'liftTrap'

	export function readRegisters(thread BackendThreadId) returns BackendRegisterRead
		return match self 'which'
			debugPort(backend) gives backend.readRegisters(thread)
			processTrace(backend) gives backend.readRegisters(thread)
			remoteStub(backend) gives backend.readRegisters(thread)
		end 'which'
	end 'readRegisters'

	export function fillVectorRegisters(thread BackendThreadId, into DebugRegisterFile)
		match self 'which'
			debugPort(backend) then backend.fillVectorRegisters(thread, into: into)
			processTrace(backend) then backend.fillVectorRegisters(thread, into: into)
			remoteStub(backend) then backend.fillVectorRegisters(thread, into: into)
		end 'which'

		into.markVectorsRead()
	end 'fillVectorRegisters'

	export function setProgramCounter(thread BackendThreadId, address DebugAddress) returns bool
		return match self 'which'
			debugPort(backend) gives backend.setProgramCounter(thread, address: address)
			processTrace(backend) gives backend.setProgramCounter(thread, address: address)
			remoteStub(backend) gives backend.setProgramCounter(thread, address: address)
		end 'which'
	end 'setProgramCounter'
end 'DebugBackend'
