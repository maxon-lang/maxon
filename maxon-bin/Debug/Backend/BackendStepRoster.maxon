export function backendRosterHolds(roster BackendThreadIdArray, thread BackendThreadId) returns bool
	for held in roster 'eachThread'
		if held == thread 'thisOne'
			return true
		end 'thisOne'
	end 'eachThread'

	return false
end 'backendRosterHolds'

function backendRosterAmong(roster BackendThreadIdArray, reported BackendThreadIdArray) returns BackendThreadIdArray
	var kept = BackendThreadIdArray.create()

	for thread in roster 'eachThread'
		if backendRosterHolds(reported, thread: thread) 'itIsStillThere'
			kept.push(thread)
		end 'itIsStillThere'
	end 'eachThread'

	return kept
end 'backendRosterAmong'

module function backendRosterWithout(roster BackendThreadIdArray, thread BackendThreadId) returns BackendThreadIdArray
	var kept = BackendThreadIdArray.create()

	for held in roster 'eachThread'
		if held != thread 'anotherThread'
			kept.push(held)
		end 'anotherThread'
	end 'eachThread'

	return kept
end 'backendRosterWithout'

export enum BackendOtherThreads
	run
	hold
end 'BackendOtherThreads'

export type BackendStepRoster
	var threads as BackendThreadIdArray
	var holders as BackendThreadIdArray

	export static function create() returns BackendStepRoster
		return Self{threads: BackendThreadIdArray.create(), holders: BackendThreadIdArray.create()}
	end 'create'

	export function holds(thread BackendThreadId) returns bool
		return backendRosterHolds(self.threads, thread: thread)
	end 'holds'

	export function outstanding() returns BackendThreadIdArray
		return self.threads
	end 'outstanding'

	export function company() returns BackendOtherThreads
		return BackendOtherThreads.run if self.holders.count() == 0 else BackendOtherThreads.hold
	end 'company'

	export function note(thread BackendThreadId, others BackendOtherThreads)
		if not self.holds(thread) 'aNewStep'
			self.threads.push(thread)
		end 'aNewStep'

		match others 'company'
			run then return
			hold then self.notedHolder(thread)
		end 'company'
	end 'note'

	function notedHolder(thread BackendThreadId)
		if backendRosterHolds(self.holders, thread: thread) 'itAlreadyHolds'
			return
		end 'itAlreadyHolds'

		self.holders.push(thread)
	end 'notedHolder'

	export function forget(thread BackendThreadId)
		if not self.holds(thread) 'itIsNotStepping'
			return
		end 'itIsNotStepping'

		self.threads = backendRosterWithout(self.threads, thread: thread)
		self.holders = backendRosterWithout(self.holders, thread: thread)
	end 'forget'

	// True when the thread held every other thread through its step and no step holds them now. The
	// caller then stands at a stop the engine must resume, or the held threads stay stopped for good.
	export function forgetEndingTheHold(thread BackendThreadId) returns bool
		let heldTheOthers = backendRosterHolds(self.holders, thread: thread)
		self.forget(thread)

		return heldTheOthers and self.company() == BackendOtherThreads.run
	end 'forgetEndingTheHold'

	export function clear()
		self.threads = BackendThreadIdArray.create()
		self.holders = BackendThreadIdArray.create()
	end 'clear'

	export function keptAmong(reported BackendThreadIdArray)
		self.threads = backendRosterAmong(self.threads, reported: reported)
		self.holders = backendRosterAmong(self.holders, reported: reported)
	end 'keptAmong'
end 'BackendStepRoster'
