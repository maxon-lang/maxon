export typealias BackendRegisterNumber = int(0 to 79) implements ElementIndex

export let BackendRegisterSlots = 80

#if arch(arm64)
	export let BackendGprSlots = 31
	export let BackendVectorSlots = 32

	module let BackendRegSlotSp = 63
	module let BackendRegSlotFp = 29
	export let BackendRegSlotFlags = 64
	export let BackendRegSlotPc = 65
	export let BackendRegSlotLink = 30
#endif

#if not arch(arm64)
	export let BackendGprSlots = 16
	export let BackendVectorSlots = 16

	module let BackendRegSlotSp = 4
	let BackendRegSlotFp = 5
	export let BackendRegSlotFlags = 32
	export let BackendRegSlotPc = 72
#endif

export function requireRegisterSlotsAreTheCompilersOwn()
	#if arch(arm64)
		let file = arm64RegisterFile()
	#endif

	#if not arch(arm64)
		let file = x64RegisterFile()
	#endif

	if (file.firstVector as BackendRegisterNumber) != (BackendGprSlots as BackendRegisterNumber) 'aBoundaryThatIsNotTheCompilersOwn'
		panic("DebugRegisterFile: this file numbers its vector slots from {BackendGprSlots} and the compiler numbers this CPU's from {file.firstVector} — a local the sidecar records by register number would be read out of the wrong slot")
	end 'aBoundaryThatIsNotTheCompilersOwn'

	if BackendGprSlots + BackendVectorSlots > BackendRegisterSlots 'moreRegistersThanSlots'
		panic("DebugRegisterFile: {BackendGprSlots} general and {BackendVectorSlots} vector registers do not fit the {BackendRegisterSlots} slots this file holds")
	end 'moreRegistersThanSlots'

	if BackendRegSlotFlags < BackendGprSlots + BackendVectorSlots or BackendRegSlotPc < BackendGprSlots + BackendVectorSlots 'aNamedSlotInsideTheNumberedBand'
		panic("DebugRegisterFile: the status word at {BackendRegSlotFlags} or the program counter at {BackendRegSlotPc} lies inside the {BackendGprSlots + BackendVectorSlots} slots the compiler's register numbers claim, neither of which the allocator ever colours")
	end 'aNamedSlotInsideTheNumberedBand'
end 'requireRegisterSlotsAreTheCompilersOwn'

export union BackendRegisterRead
	read(file DebugRegisterFile)
	unreadable
end 'BackendRegisterRead'

typealias BackendRegisterWordArray = Array with BackendWord

export function backendIsVectorSlot(number BackendRegisterNumber) returns bool
	return number >= BackendGprSlots and number < BackendGprSlots + BackendVectorSlots
end 'backendIsVectorSlot'

export type DebugRegisterFile
	var slots as BackendRegisterWordArray
	var vectorsRead as bool

	export static function create() returns DebugRegisterFile
		var slots = BackendRegisterWordArray.create()

		for _ in 0 upto BackendRegisterSlots 'eachSlot'
			slots.push(0)
		end 'eachSlot'

		return Self{slots: slots, vectorsRead: false}
	end 'create'

	export function awaitsItsVectors(number BackendRegisterNumber) returns bool
		return backendIsVectorSlot(number) and not self.vectorsRead
	end 'awaitsItsVectors'

	export function markVectorsRead()
		self.vectorsRead = true
	end 'markVectorsRead'

	export function valueOf(number BackendRegisterNumber) returns BackendWord
		if self.awaitsItsVectors(number) 'aVectorNobodyFetched'
			panic("DebugRegisterFile.valueOf: slot {number} is a vector register and this file was read without its vector class — the engine fetches that class before any vector slot is read, so a reader that reached here went around it")
		end 'aVectorNobodyFetched'

		return try self.slots.get(number) otherwise panic("DebugRegisterFile.valueOf: slot {number} is one of the {BackendRegisterSlots} this file holds")
	end 'valueOf'

	export function setValue(number BackendRegisterNumber, value BackendWord)
		try self.slots.set(number, value: value) otherwise panic("DebugRegisterFile.setValue: slot {number} is one of the {BackendRegisterSlots} this file holds")
	end 'setValue'

	export function programCounter() returns DebugAddress
		return debugAddressOrZero(self.valueOf(BackendRegSlotPc as BackendRegisterNumber) as DebuggeeWord)
	end 'programCounter'

	export function stackPointer() returns DebugAddress
		return debugAddressOrZero(self.valueOf(BackendRegSlotSp as BackendRegisterNumber) as DebuggeeWord)
	end 'stackPointer'

	export function framePointer() returns DebugAddress
		return debugAddressOrZero(self.valueOf(BackendRegSlotFp as BackendRegisterNumber) as DebuggeeWord)
	end 'framePointer'
end 'DebugRegisterFile'
