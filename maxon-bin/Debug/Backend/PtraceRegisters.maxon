module typealias PtraceRegOffsetArray = Array with BackendWord

#if arch(arm64)
	let StackPointerOffset = 248
	let ProgramCounterOffset = 256
	let StatusWordOffset = 264

	let VectorLaneBase = 0
	let VectorLaneBytes = 16
#endif

#if not arch(arm64)
	let StackPointerOffset = 152
	let ProgramCounterOffset = 128
	let StatusWordOffset = 144

	let VectorLaneBase = 160
	let VectorLaneBytes = 16

	let UserRegsR15 = 0
	let UserRegsR14 = 8
	let UserRegsR13 = 16
	let UserRegsR12 = 24
	let UserRegsRbp = 32
	let UserRegsRbx = 40
	let UserRegsR11 = 48
	let UserRegsR10 = 56
	let UserRegsR9 = 64
	let UserRegsR8 = 72
	let UserRegsRax = 80
	let UserRegsRcx = 88
	let UserRegsRdx = 96
	let UserRegsRsi = 104
	let UserRegsRdi = 112
#endif

module function ptraceBlockWord(block RegisterBlock, at BackendWord) returns BackendWord
	return (try block.word(at as RegisterOffset) otherwise panic("PtraceRegisters.ptraceBlockWord: the word at {at} is outside the register block or off a word boundary, and every displacement this backend reads is one of the record's fixed fields")) as BackendWord
end 'ptraceBlockWord'

module function ptraceStackPointerOf(block RegisterBlock) returns BackendWord
	return ptraceBlockWord(block, at: StackPointerOffset)
end 'ptraceStackPointerOf'

module function ptraceProgramCounterOf(block RegisterBlock) returns BackendWord
	return ptraceBlockWord(block, at: ProgramCounterOffset)
end 'ptraceProgramCounterOf'

module function ptraceStatusWordOf(block RegisterBlock) returns BackendWord
	return ptraceBlockWord(block, at: StatusWordOffset)
end 'ptraceStatusWordOf'

module function ptraceVectorLaneOf(block RegisterBlock, lane BackendWord) returns BackendWord
	return ptraceBlockWord(block, at: VectorLaneBase + lane * VectorLaneBytes)
end 'ptraceVectorLaneOf'

module function ptraceWithProgramCounter(block RegisterBlock, address BackendWord) returns RegisterBlock throws DebuggeeError
	return try block.with(ProgramCounterOffset as RegisterOffset, word: address as RegisterWord)
end 'ptraceWithProgramCounter'

module function ptraceGprBlockOffsets() returns PtraceRegOffsetArray
	var offsets = PtraceRegOffsetArray.create()

	#if arch(arm64)
		for slot in 0 upto BackendGprSlots 'eachGeneralRegister'
			offsets.push((slot * DebuggeeWordBytes) as BackendWord)
		end 'eachGeneralRegister'
	#endif

	#if not arch(arm64)
		offsets.push(UserRegsRax)
		offsets.push(UserRegsRcx)
		offsets.push(UserRegsRdx)
		offsets.push(UserRegsRbx)
		offsets.push(StackPointerOffset)
		offsets.push(UserRegsRbp)
		offsets.push(UserRegsRsi)
		offsets.push(UserRegsRdi)
		offsets.push(UserRegsR8)
		offsets.push(UserRegsR9)
		offsets.push(UserRegsR10)
		offsets.push(UserRegsR11)
		offsets.push(UserRegsR12)
		offsets.push(UserRegsR13)
		offsets.push(UserRegsR14)
		offsets.push(UserRegsR15)
	#endif

	return offsets
end 'ptraceGprBlockOffsets'
