let SignalTrap = 5

let NoSignal = NoTraceSignal as BackendWord

let GroupStopSliceMs = 50

let GroupStopBudgetMs = 2000

let NoWaitMs = 0

function ptraceSignalsWith(signals PtraceOwedSignalArray, signal BackendWord) returns PtraceOwedSignalArray
	var more = signals.clone()
	more.push(signal)

	return more
end 'ptraceSignalsWith'

function ptraceFirstSignalOf(owed PtraceOwedSignalArray) returns BackendWord
	if owed.count() == 0 'nothingIsOwed'
		return NoSignal
	end 'nothingIsOwed'

	return try owed.get(0) otherwise panic("ptraceFirstSignalOf: {owed.count()} signal(s) are owed, so the first is there to hand on")
end 'ptraceFirstSignalOf'

enum PtraceFaultDrain
	keptForTheDebugger
	handedToTheProgram
end 'PtraceFaultDrain'

function ptraceStopSignal() returns BackendWord
	return posixStopSignalNumber(detectHostTarget().os) as BackendWord
end 'ptraceStopSignal'

enum PtraceTrapKind
	stepLanding
	requestedStop
	retiredRequest
	plantedTrap
end 'PtraceTrapKind'

union PtraceHeldStop
	trap(thread BackendWord, reason BackendStopReason, address DebugAddress)
	fault(thread BackendWord, signal BackendWord, address DebugAddress)
	departure(reporter BackendWord, event DebugStopEvent)

	function threadIs(id BackendThreadId) returns bool
		return match self 'held'
			trap(thread, _, _) gives thread == id as BackendWord
			fault(thread, _, _) gives thread == id as BackendWord
			departure(reporter, _) gives reporter == id as BackendWord
		end 'held'
	end 'threadIs'

	function isARequestedStop() returns bool
		return match self 'held'
			trap(_, reason, _) gives reason == BackendStopReason.interrupt

			fault or
			departure gives false
		end 'held'
	end 'isARequestedStop'
end 'PtraceHeldStop'

typealias PtraceHeldStopArray = Array with PtraceHeldStop

union PtraceStopBorrow
	alreadyStopped
	taken
	unavailable

	function wasTaken() returns bool
		return match self 'borrow'
			taken gives true

			alreadyStopped or
			unavailable gives false
		end 'borrow'
	end 'wasTaken'
end 'PtraceStopBorrow'

union PtraceHeldStopLookup
	none
	at(stop PtraceHeldStop)

	function nothingYet() returns bool
		return match self 'lookup'
			none gives true
			at gives false
		end 'lookup'
	end 'nothingYet'
end 'PtraceHeldStopLookup'

union PtraceProgramCounter
	unreadable
	at(address DebugAddress)
end 'PtraceProgramCounter'

union PtraceRequestThread
	none
	at(thread BackendWord)
end 'PtraceRequestThread'

typealias PtraceOwedSignalArray = Array with BackendWord

type PtraceThreadEntry
	export let id as BackendThreadId
	export var stopped as bool
	export var owedSignals as PtraceOwedSignalArray
	export let stopOwed as bool
	export let standingSignal as BackendWord

	static function create(id BackendThreadId, stopped bool, owedSignals PtraceOwedSignalArray, stopOwed bool, standingSignal BackendWord) returns PtraceThreadEntry
		return Self{id: id, stopped: stopped, owedSignals: owedSignals, stopOwed: stopOwed, standingSignal: standingSignal}
	end 'create'
end 'PtraceThreadEntry'

typealias PtraceThreadEntryArray = Array with PtraceThreadEntry

union PtraceThreadEntryLookup
	none
	at(entry PtraceThreadEntry)
end 'PtraceThreadEntryLookup'

export type PtraceBackend
	var trace as ProcessTrace
	var process as BackendWord
	var threads as PtraceThreadEntryArray
	var pendingThreadId as BackendWord
	var stopOutstanding as bool
	var sawFirstStop as bool
	var stopRequested as bool
	var driverTrapInFlight as bool
	var stepping as BackendStepRoster
	var held as PtraceHeldStopArray
	var status as BackendExitStatus

	export static function create() returns PtraceBackend
		return Self{trace: ProcessTrace.create(), process: 0, threads: PtraceThreadEntryArray.create(), pendingThreadId: 0, stopOutstanding: false, sawFirstStop: false, stopRequested: false, driverTrapInFlight: false, stepping: BackendStepRoster.create(), held: PtraceHeldStopArray.create(), status: BackendExitStatus.running}
	end 'create'

	export function holdsItsScratch() returns bool
		return self.trace.isReady()
	end 'holdsItsScratch'

	export function close()
		self.trace.close()
	end 'close'

	export function exitStatus() returns BackendExitStatus
		return self.status
	end 'exitStatus'

	export function listThreads() returns BackendThreadIdArray
		var ids = BackendThreadIdArray.create()

		for entry in self.threads 'eachThread'
			ids.push(entry.id)
		end 'eachThread'

		return ids
	end 'listThreads'

	export function stoppedThread() returns BackendThreadId
		return self.pendingThreadId as BackendThreadId
	end 'stoppedThread'

	// --- the stop loop ---

	export function waitForStop(budgetMs BackendWaitBudgetMs) returns DebugStopEvent
		while true 'pump'
			match self.oneWaitStatus(budgetMs as BackendWord) 'seen'
				bookkeeping then continue
				ended(ending) then return ending
				stop(stopping) then return stopping
			end 'seen'
		end 'pump'

		panic("PtraceBackend.waitForStop: the pump leaves only by answering an event, and every class below answers one")
	end 'waitForStop'

	function oneWaitStatus(budgetMs BackendWord) returns BackendEventClass
		match self.takeTheHeldStop() 'held'
			none then break
			at(stop) then return self.heldStopDelivered(stop)
		end 'held'

		let waited = self.trace.wait(budgetMs as DebuggeeWaitMs, process: self.process as DebuggeeProcessId)
		let report = self.noted(waited)

		return self.classified(report)
	end 'oneWaitStatus'

	function noted(report TraceReport) returns TraceReport
		match report 'which'
			stopped(thread, signal, event) then self.rememberThread(thread as BackendThreadId, signal: signal as BackendWord, event: event)

			nothing or
			exited or
			killed then break
		end 'which'

		return report
	end 'noted'

	function classified(report TraceReport) returns BackendEventClass
		return match report 'which'
			nothing gives BackendEventClass.ended(DebugStopEvent.timedOut)
			exited(thread, code) gives self.reporterDeparted(thread as BackendWord, event: DebugStopEvent.exited(code as BackendExitCode))
			killed(thread, waitStatus) gives self.reporterDeparted(thread as BackendWord, event: DebugStopEvent.signalled(waitStatus as BackendWord))
			stopped(thread, signal, event) gives self.reporterStopped(thread as BackendWord, signal: signal as BackendWord, event: event)
		end 'which'
	end 'classified'

	function reporterStopped(reporter BackendWord, signal BackendWord, event TraceEvent) returns BackendEventClass
		if self.process == 0 'theTraceeArrived'
			self.process = reporter
		end 'theTraceeArrived'

		self.pendingThreadId = reporter

		return self.stoppedWith(reporter, signal: signal, event: event)
	end 'reporterStopped'

	function reporterDeparted(reporter BackendWord, event DebugStopEvent) returns BackendEventClass
		if self.process == 0 'noTraceeHasReportedYet'
			return BackendEventClass.bookkeeping
		end 'noTraceeHasReportedYet'

		self.pendingThreadId = reporter

		return self.departed(reporter, event: event)
	end 'reporterDeparted'

	function departed(reporter BackendWord, event DebugStopEvent) returns BackendEventClass
		if reporter != self.process 'anotherThreadOfTheGroup'
			if self.forgotEndingTheHold(reporter as BackendThreadId) 'theHoldEndsWithIt'
				self.stopOutstanding = true
			end 'theHoldEndsWithIt'

			return BackendEventClass.stop(DebugStopEvent.threadExited(reporter as BackendThreadId))
		end 'anotherThreadOfTheGroup'

		self.stopOutstanding = false

		match event 'ending'
			exited(code) then self.status = BackendExitStatus.ended(code)
			threadStarted or
			threadExited or
			signalled or
			stopped or
			timedOut then break
		end 'ending'

		return BackendEventClass.ended(event)
	end 'departed'

	// ⛔ The options ride the FIRST stop rather than the spawn: `PTRACE_TRACEME` makes the child a tracee but
	// only a stopped tracee can be configured, and `PTRACE_O_EXITKILL` is what makes the debuggee die with its
	// debugger — so a session that set it later would leave an orphan for the window in between.
	function stoppedWith(reporter BackendWord, signal BackendWord, event TraceEvent) returns BackendEventClass
		if event == TraceEvent.cloneEvent 'aThreadWasBorn'
			return self.resumedUnlessHeld(reporter, signal: NoSignal)
		end 'aThreadWasBorn'

		if not self.sawFirstStop 'theExecStop'
			self.sawFirstStop = true
			_ = self.trace.configure(self.process as DebuggeeProcessId)

			return self.standing(reporter, reason: BackendStopReason.entry, faultCode: 0, at: self.programCounterOf(reporter))
		end 'theExecStop'

		if signal == ptraceStopSignal() 'aThreadArrivedStopped'
			return self.resumedUnlessHeld(reporter, signal: NoSignal)
		end 'aThreadArrivedStopped'

		if signal == SignalTrap 'aTrapOrAStep'
			return self.trapStop(reporter)
		end 'aTrapOrAStep'

		if self.debuggerOwns(signal) 'aFault'
			self.recordPendingSignal(reporter as BackendThreadId, signal: signal)
			self.stepping.forget(reporter as BackendThreadId)

			return self.standing(reporter, reason: BackendStopReason.fault, faultCode: signal, at: self.programCounterOf(reporter))
		end 'aFault'

		return self.resumedUnlessHeld(reporter, signal: signal)
	end 'stoppedWith'

	function resumedUnlessHeld(reporter BackendWord, signal BackendWord) returns BackendEventClass
		let thread = reporter as BackendThreadId

		if signal != NoSignal 'aSignalToHandOn'
			self.recordPendingSignal(thread, signal: signal)
		end 'aSignalToHandOn'

		if self.mayRun(thread) 'itIsNotHeldThroughAStep'
			_ = self.resumeThread(reporter, asAStep: self.resumesAsAStep(thread))
		end 'itIsNotHeldThroughAStep'

		return BackendEventClass.bookkeeping
	end 'resumedUnlessHeld'

	function debuggerOwns(signal BackendWord) returns bool
		return posixSignalIsAHardwareFault(signal as MachineWord, on: detectHostTarget().os)
	end 'debuggerOwns'

	function trapStop(reporter BackendWord) returns BackendEventClass
		return match self.programCounterOf(reporter) 'counter'
			unreadable gives BackendEventClass.bookkeeping
			at(pc) gives self.trapStopAt(reporter, pc: pc)
		end 'counter'
	end 'trapStop'

	// ⭐⭐ ONLY A TRAP STOP IS REWOUND. `atTheTrap` carries whether this host's trap moves the program counter
	// past it; a single-step landing and a requested stop are already at the instruction they reached, and
	// rewinding either reports an address the program never stopped at. Which of the three arrived is a fact
	// this backend alone holds, because it is the party that asked.
	function trapStopAt(reporter BackendWord, pc DebugAddress) returns BackendEventClass
		return match self.tookTheTrapsKind(reporter) 'kind'
			stepLanding gives self.standingAt(reporter, reason: BackendStopReason.singleStep, faultCode: 0, at: pc)
			requestedStop gives self.standingAt(reporter, reason: BackendStopReason.interrupt, faultCode: 0, at: pc)
			retiredRequest gives self.resumedUnlessHeld(reporter, signal: NoSignal)
			plantedTrap gives self.standingAt(reporter, reason: BackendStopReason.breakpoint, faultCode: 0, at: atTheTrap(pc))
		end 'kind'
	end 'trapStopAt'

	// The pause is claimed on the kernel's evidence rather than on `stopRequested`, which is one flag
	// for the whole process and would be taken by whichever thread's trap is reaped first — reporting
	// that thread's breakpoint hit as an interrupt, at an address the trap rewind never reached. Asked
	// ahead of the step roster, so a thread that takes the injected signal mid-step keeps its step.
	function tookTheTrapsKind(reporter BackendWord) returns PtraceTrapKind
		if self.driverTrapInFlight and self.trapCameFromTheDriversSignal(reporter) 'theDriversOwnSignal'
			self.driverTrapInFlight = false

			if not self.stopRequested 'itsPauseWasAnsweredAlready'
				return PtraceTrapKind.retiredRequest
			end 'itsPauseWasAnsweredAlready'

			self.stopRequested = false

			return PtraceTrapKind.requestedStop
		end 'theDriversOwnSignal'

		if self.stepping.holds(reporter as BackendThreadId) 'theStepLanded'
			self.stepping.forget(reporter as BackendThreadId)

			return PtraceTrapKind.stepLanding
		end 'theStepLanded'

		return PtraceTrapKind.plantedTrap
	end 'tookTheTrapsKind'

	function trapCameFromTheDriversSignal(reporter BackendWord) returns bool
		return self.trace.signalWasSentByKill(reporter as DebuggeeThreadId)
	end 'trapCameFromTheDriversSignal'

	function hold(stop PtraceHeldStop)
		self.held.push(stop)
	end 'hold'

	// ⚠ The leader's departure outranks every other held stop, and a trap held for a thread that has
	// since departed is dropped: a breakpoint answered after the program has gone would send the
	// driver to read a process that is not there.
	function takeTheHeldStop() returns PtraceHeldStopLookup
		var taken = PtraceHeldStopLookup.none
		var kept = PtraceHeldStopArray.create()
		let leaderLeft = self.holdsTheLeadersDeparture()

		for stop in self.held 'eachHeld'
			if self.heldTrapNamesADepartedThread(stop) 'itsThreadIsGone'
				continue
			end 'itsThreadIsGone'

			if taken.nothingYet() and (self.isTheLeadersDeparture(stop) or not leaderLeft) 'thisOne'
				taken = PtraceHeldStopLookup.at(stop)

				continue
			end 'thisOne'

			kept.push(stop)
		end 'eachHeld'

		self.held = kept

		return taken
	end 'takeTheHeldStop'

	function holdsTheLeadersDeparture() returns bool
		for stop in self.held 'eachHeld'
			if self.isTheLeadersDeparture(stop) 'thisOne'
				return true
			end 'thisOne'
		end 'eachHeld'

		return false
	end 'holdsTheLeadersDeparture'

	function isTheLeadersDeparture(stop PtraceHeldStop) returns bool
		return match stop 'held'
			trap or
			fault gives false

			departure(reporter, _) gives reporter == self.process
		end 'held'
	end 'isTheLeadersDeparture'

	function heldTrapNamesADepartedThread(stop PtraceHeldStop) returns bool
		return match stop 'held'
			trap(thread, _, _) gives not self.knowsThread(thread as BackendThreadId)
			fault(thread, _, _) gives not self.knowsThread(thread as BackendThreadId)
			departure gives false
		end 'held'
	end 'heldTrapNamesADepartedThread'

	function knowsThread(id BackendThreadId) returns bool
		return match self.entryOf(id) 'known'
			none gives false
			at gives true
		end 'known'
	end 'knowsThread'

	function heldStopDelivered(stop PtraceHeldStop) returns BackendEventClass
		return match stop 'held'
			trap(thread, reason, address) gives self.deliveredStop(thread, reason: reason, faultCode: 0, at: address)
			fault(thread, signal, address) gives self.deliveredStop(thread, reason: BackendStopReason.fault, faultCode: signal, at: address)
			departure(reporter, event) gives self.departed(reporter, event: event)
		end 'held'
	end 'heldStopDelivered'

	function deliveredStop(thread BackendWord, reason BackendStopReason, faultCode BackendWord, at DebugAddress) returns BackendEventClass
		self.pendingThreadId = thread

		return self.standingAt(thread, reason: reason, faultCode: faultCode, at: at)
	end 'deliveredStop'

	function holdsAStopFor(id BackendThreadId) returns bool
		for stop in self.held 'eachHeld'
			if stop.threadIs(id) 'thisThread'
				return true
			end 'thisThread'
		end 'eachHeld'

		return false
	end 'holdsAStopFor'

	// ⛔ **A ptrace STOP IS PER THREAD AND THE ENGINE READS THE WHOLE PROCESS**, so every other running thread
	// is stopped before the stop is reported — the group stop a debug port gives for free.
	//
	// ⭐⭐ **EXCEPT ON A STEP LANDING, AND THAT EXCEPTION IS WHAT MAKES STEPPING AFFORDABLE.** A walk single-steps
	// once per instruction and consults no other thread between steps, so group-stopping the process at each
	// landing would pay a signal and a wait per instruction, which exhausts the engine's walk budget
	// on a step over a library call and lets the program run to exit.
	function standing(reporter BackendWord, reason BackendStopReason, faultCode BackendWord, at PtraceProgramCounter) returns BackendEventClass
		return match at 'counter'
			unreadable gives BackendEventClass.bookkeeping
			at(address) gives self.standingAt(reporter, reason: reason, faultCode: faultCode, at: address)
		end 'counter'
	end 'standing'

	function standingAt(reporter BackendWord, reason BackendStopReason, faultCode BackendWord, at DebugAddress) returns BackendEventClass
		self.stopOutstanding = true

		if reason != BackendStopReason.singleStep 'aStopTheDriverWillLookAround'
			self.stopEveryOtherThread()
		end 'aStopTheDriverWillLookAround'

		return BackendEventClass.stop(DebugStopEvent.stopped(reporter as BackendThreadId, reason: reason, faultCode: faultCode, address: at))
	end 'standingAt'

	function stopEveryOtherThread()
		var running = BackendThreadIdArray.create()

		for entry in self.threads 'eachThread'
			if not entry.stopped 'stillRunning'
				running.push(entry.id)
			end 'stillRunning'
		end 'eachThread'

		_ = self.threadsBroughtToAStop(running)
	end 'stopEveryOtherThread'

	function threadsBroughtToAStop(targets BackendThreadIdArray) returns bool
		var asked = BackendThreadIdArray.create()

		for id in targets 'eachTarget'
			if self.owesAStop(id) or self.stopSignalSent(id) 'itWillStop'
				asked.push(id)
			end 'itWillStop'
		end 'eachTarget'

		self.awaitStops(asked)
		self.drainOwedStops(asked, faults: PtraceFaultDrain.keptForTheDebugger)

		return self.everyAskedThreadStopped(asked)
	end 'threadsBroughtToAStop'

	function stopSignalSent(id BackendThreadId) returns bool
		if not self.signalRaised(id, signal: ptraceStopSignal()) 'theSignalWasRefused'
			return false
		end 'theSignalWasRefused'

		self.markStopOwed(id)

		return true
	end 'stopSignalSent'

	// A thread that answered this backend's SIGSTOP with another stop still has the SIGSTOP pending
	// (`stopOwed`), so it is continued until it takes it, before anything resumes or detaches it: left
	// pending, it lands later as a stop nobody asked for. A lower-numbered pending signal such as SIGCHLD
	// is delivered ahead of it, which is why this loops.
	function drainOwedStops(asked BackendThreadIdArray, faults PtraceFaultDrain)
		let deadline = debugDeadlineAfter(GroupStopBudgetMs as StopTimeoutMs)

		while not debugDeadlinePassed(deadline) 'eachRound'
			let owing = self.continuedToTheirOwedStops(asked, faults: faults)

			if owing.count() == 0 'noneOwesAStop'
				return
			end 'noneOwesAStop'

			self.awaitStops(owing)
		end 'eachRound'
	end 'drainOwedStops'

	function continuedToTheirOwedStops(asked BackendThreadIdArray, faults PtraceFaultDrain) returns BackendThreadIdArray
		var owing = BackendThreadIdArray.create()

		for id in asked 'eachAsked'
			if self.standsOwingAStop(id) and self.continuedTowardItsStop(id, faults: faults) 'itGoesToTakeIt'
				owing.push(id)
			end 'itGoesToTakeIt'
		end 'eachAsked'

		return owing
	end 'continuedToTheirOwedStops'

	// A thread standing in a fault is resumed only from that stop, its fault's own delivery-stop, where
	// the kernel still holds the fault's siginfo (`si_addr`) for the program's handler.
	function continuedTowardItsStop(id BackendThreadId, faults PtraceFaultDrain) returns bool
		if not self.standsInAFault(id) and not self.holdsAStopFor(id) 'nothingTheDebuggerIsShownStands'
			return self.continuedKeepingItsSignal(id)
		end 'nothingTheDebuggerIsShownStands'

		return match faults 'fault'
			keptForTheDebugger gives false
			handedToTheProgram gives self.resumeThread(id as BackendWord, asAStep: false)
		end 'fault'
	end 'continuedTowardItsStop'

	function standsInAFault(id BackendThreadId) returns bool
		return match self.entryOf(id) 'known'
			none gives false
			at(entry) gives entry.stopped and self.debuggerOwns(entry.standingSignal)
		end 'known'
	end 'standsInAFault'

	function standsOwingAStop(id BackendThreadId) returns bool
		return match self.entryOf(id) 'known'
			none gives false
			at(entry) gives entry.stopped and entry.stopOwed
		end 'known'
	end 'standsOwingAStop'

	function continuedKeepingItsSignal(id BackendThreadId) returns bool
		if not self.trace.resume(id as DebuggeeThreadId, signal: NoTraceSignal, stepping: false) 'theKernelRefused'
			return false
		end 'theKernelRefused'

		self.markResumed(id, keepsItsSignals: true)

		return true
	end 'continuedKeepingItsSignal'

	function awaitStops(asked BackendThreadIdArray)
		let deadline = debugDeadlineAfter(GroupStopBudgetMs as StopTimeoutMs)

		while not self.everyAskedThreadStopped(asked) and not debugDeadlinePassed(deadline) 'eachAnswer'
			_ = self.settledOneReport(GroupStopSliceMs)
		end 'eachAnswer'
	end 'awaitStops'

	function settledOneReport(budgetMs BackendWord) returns bool
		let waited = self.trace.wait(budgetMs as DebuggeeWaitMs, process: self.process as DebuggeeProcessId)
		let report = self.noted(waited)

		if not report.arrived() 'nothingCameBack'
			return false
		end 'nothingCameBack'

		self.settleGroupStop(report)

		return true
	end 'settledOneReport'

	function everyAskedThreadStopped(asked BackendThreadIdArray) returns bool
		for id in asked 'eachAsked'
			if self.threadIsStillRunning(id) 'stillRunning'
				return false
			end 'stillRunning'
		end 'eachAsked'

		return true
	end 'everyAskedThreadStopped'

	function threadIsStillRunning(id BackendThreadId) returns bool
		return match self.entryOf(id) 'known'
			none gives false
			at(entry) gives not entry.stopped
		end 'known'
	end 'threadIsStillRunning'

	// ⚠ A thread answering the group stop may be answering with a stop of its own — a breakpoint it reached in
	// the same instant. A trap of its own is classified here and held, drained ahead of the next
	// wait and reported to the driver, and a thread that owes a held report is never resumed, so the
	// hit cannot be run past. Any other signal is kept for that thread's resume, so a fault stays
	// owed to the program; a fault is also held and shown to the debugger.
	function settleGroupStop(report TraceReport)
		match report 'status'
			nothing then panic("PtraceBackend.settleGroupStop: an empty wait is answered by settledOneReport before it settles anything")
			exited(thread, code) then self.departureHeld(thread as BackendWord, event: DebugStopEvent.exited(code as BackendExitCode))
			killed(thread, waitStatus) then self.departureHeld(thread as BackendWord, event: DebugStopEvent.signalled(waitStatus as BackendWord))
			stopped(thread, signal, event) then self.settleStoppedThread(thread as BackendWord, signal: signal as BackendWord, event: event)
		end 'status'
	end 'settleGroupStop'

	function settleStoppedThread(reporter BackendWord, signal BackendWord, event TraceEvent)
		if event != TraceEvent.signalStop 'aPtraceEventRatherThanASignal'
			return
		end 'aPtraceEventRatherThanASignal'

		if signal == SignalTrap 'aTrapOrAStepOfItsOwn'
			self.settleTrapTakenByTheBackend(reporter)

			return
		end 'aTrapOrAStepOfItsOwn'

		if signal == ptraceStopSignal() 'oursToSwallow'
			return
		end 'oursToSwallow'

		self.recordPendingSignal(reporter as BackendThreadId, signal: signal)

		if self.debuggerOwns(signal) 'aFaultTheDebuggerIsShown'
			self.faultHeld(reporter, signal: signal)
		end 'aFaultTheDebuggerIsShown'
	end 'settleStoppedThread'

	function faultHeld(reporter BackendWord, signal BackendWord)
		self.stepping.forget(reporter as BackendThreadId)

		match self.programCounterOf(reporter) 'counter'
			unreadable then return
			at(pc) then self.hold(PtraceHeldStop.fault(reporter, signal: signal, address: pc))
		end 'counter'
	end 'faultHeld'

	function settleTrapTakenByTheBackend(reporter BackendWord)
		match self.programCounterOf(reporter) 'counter'
			unreadable then return
			at(pc) then self.settleTrapAt(reporter, pc: pc)
		end 'counter'
	end 'settleTrapTakenByTheBackend'

	function settleTrapAt(reporter BackendWord, pc DebugAddress)
		match self.tookTheTrapsKind(reporter) 'kind'
			stepLanding then self.hold(PtraceHeldStop.trap(reporter, reason: BackendStopReason.singleStep, address: pc))
			requestedStop then self.hold(PtraceHeldStop.trap(reporter, reason: BackendStopReason.interrupt, address: pc))
			retiredRequest then return
			plantedTrap then self.rewoundAndHeld(reporter, pc: pc)
		end 'kind'
	end 'settleTrapAt'

	function rewoundAndHeld(reporter BackendWord, pc DebugAddress)
		self.rewindOntoTheTrap(reporter, pc: pc)
		self.hold(PtraceHeldStop.trap(reporter, reason: BackendStopReason.breakpoint, address: atTheTrap(pc)))
	end 'rewoundAndHeld'

	function departureHeld(reporter BackendWord, event DebugStopEvent)
		_ = self.forgotEndingTheHold(reporter as BackendThreadId)
		self.hold(PtraceHeldStop.departure(reporter, event: event))
	end 'departureHeld'

	function drainEveryPendingReport()
		while self.settledOneReport(NoWaitMs) 'eachReport'
			continue
		end 'eachReport'
	end 'drainEveryPendingReport'

	function rewindOntoTheTrap(reporter BackendWord, pc DebugAddress)
		let trap = atTheTrap(pc)

		if trap == pc 'theCounterAlreadyStandsOnIt'
			return
		end 'theCounterAlreadyStandsOnIt'

		if not self.setProgramCounter(reporter as BackendThreadId, address: trap) 'unwritable'
			panic("PtraceBackend.rewindOntoTheTrap: thread {reporter} took the trap at {trap} while this backend held a stop of its own, and its program counter could not be put back onto the trap byte — a resume would enter that instruction one byte in")
		end 'unwritable'
	end 'rewindOntoTheTrap'

	// --- resuming ---

	export function resumeAll() returns bool
		if not self.stopOutstanding 'nothingIsStopped'
			return true
		end 'nothingIsStopped'

		self.stopOutstanding = false

		return self.stoppedThreadsResumed()
	end 'resumeAll'

	// A step resumes the stepping threads stepping and the rest continuing, or held where the step
	// asks for it, so `stepping` is a roster and more than one step can be outstanding. ⚠ Every ptrace resume
	// takes its request from `resumesAsAStep`: one that downgraded an outstanding step to a
	// continue would run past the landing the engine replants a breakpoint on, leaving that
	// breakpoint out of the program for good.
	export function stepThread(thread BackendThreadId, others BackendOtherThreads) returns bool
		if not self.stopOutstanding 'nothingIsStopped'
			return false
		end 'nothingIsStopped'

		self.stopOutstanding = false
		self.stepping.note(thread, others: others)

		if not self.stoppedThreadsResumed() 'theKernelRefused'
			self.stepping.forget(thread)

			return false
		end 'theKernelRefused'

		return true
	end 'stepThread'

	function stoppedThreadsResumed() returns bool
		var resumed = true

		for entry in self.resumableRoster() 'eachStoppedThread'
			if not self.resumeThread(entry.id as BackendWord, asAStep: self.resumesAsAStep(entry.id)) 'theKernelRefused'
				resumed = false
			end 'theKernelRefused'
		end 'eachStoppedThread'

		return resumed
	end 'stoppedThreadsResumed'

	// The reporter resumes last, giving every thread held through the stop a head start on it.
	function resumableRoster() returns PtraceThreadEntryArray
		let reporter = self.stoppedThread()
		var roster = PtraceThreadEntryArray.create()

		for entry in self.threads 'eachThread'
			if entry.id != reporter and self.resumable(entry) 'anotherThreadResumes'
				roster.push(entry)
			end 'anotherThreadResumes'
		end 'eachThread'

		for entry in self.threads 'theReporterLast'
			if entry.id == reporter and self.resumable(entry) 'theReporterResumes'
				roster.push(entry)
			end 'theReporterResumes'
		end 'theReporterLast'

		return roster
	end 'resumableRoster'

	function resumable(entry PtraceThreadEntry) returns bool
		if not entry.stopped or self.holdsAStopFor(entry.id) 'itStaysWhereItIs'
			return false
		end 'itStaysWhereItIs'

		return self.mayRun(entry.id)
	end 'resumable'

	function mayRun(id BackendThreadId) returns bool
		return match self.stepping.company() 'company'
			run gives true
			hold gives self.stepping.holds(id)
		end 'company'
	end 'mayRun'

	function resumesAsAStep(id BackendThreadId) returns bool
		return self.stepping.holds(id)
	end 'resumesAsAStep'

	// A ptrace resume injects one signal, so every other owed signal is raised again once the request
	// succeeds: the kernel does not re-raise an asynchronous signal its tracer withheld.
	function resumeThread(thread BackendWord, asAStep bool) returns bool
		let id = thread as BackendThreadId
		view owed = self.owedSignalsOf(id)

		if not self.trace.resume(thread as DebuggeeThreadId, signal: ptraceFirstSignalOf(owed) as DebuggeeSignal, stepping: asAStep) 'theKernelRefused'
			return false
		end 'theKernelRefused'

		self.markResumed(id, keepsItsSignals: false)
		self.laterSignalsRaised(id, owed: owed)

		return true
	end 'resumeThread'

	export function requestStop() returns bool
		if not self.driverTrapInFlight 'noSignalIsOnItsWay'
			if not self.trace.signalProcess(self.process as DebuggeeProcessId, signal: SignalTrap as DebuggeeSignal) 'theKernelRefused'
				return false
			end 'theKernelRefused'

			self.driverTrapInFlight = true
		end 'noSignalIsOnItsWay'

		self.stopRequested = true

		return true
	end 'requestStop'

	export function forgetStep(thread BackendThreadId)
		self.stepping.forget(thread)
	end 'forgetStep'

	export function retireStopRequest()
		self.stopRequested = false
		var kept = PtraceHeldStopArray.create()

		for stop in self.held 'eachHeld'
			if not stop.isARequestedStop() 'notTheDriversPause'
				kept.push(stop)
			end 'notTheDriversPause'
		end 'eachHeld'

		self.held = kept
	end 'retireStopRequest'

	// A SIGTRAP the driver sent for a pause is taken before the detach: delivered after it, its default
	// action would kill the program.
	function driverTrapTaken()
		let leader = self.process as BackendThreadId

		if not self.driverTrapInFlight or not self.knowsThread(leader) 'nothingIsOnItsWay'
			return
		end 'nothingIsOnItsWay'

		if not self.continuedKeepingItsSignal(leader) 'theKernelRefused'
			return
		end 'theKernelRefused'

		var leaderAlone = BackendThreadIdArray.create()
		leaderAlone.push(leader)
		self.awaitStops(leaderAlone)
	end 'driverTrapTaken'

	export function detach() returns bool
		self.drainEveryPendingReport()
		_ = self.borrowedStop()
		self.stopEveryOtherThread()
		self.drainOwedStops(self.listThreads(), faults: PtraceFaultDrain.handedToTheProgram)
		self.stopRequested = false
		self.driverTrapTaken()
		var detached = true

		for entry in self.threads 'eachThread'
			if not self.trace.detach(entry.id as DebuggeeThreadId, signal: ptraceFirstSignalOf(entry.owedSignals) as DebuggeeSignal) 'theKernelRefused'
				detached = false

				continue
			end 'theKernelRefused'

			self.laterSignalsRaised(entry.id, owed: entry.owedSignals)
		end 'eachThread'

		self.stopOutstanding = false
		self.stepping.clear()
		self.held = PtraceHeldStopArray.create()

		return detached
	end 'detach'

	// --- memory ---

	// ⛔⛔ **PTRACE READS AND WRITES A TRACEE ONLY WHILE IT IS STOPPED**, which is the one place this lane's
	// contract differs from a debug port's: `ReadProcessMemory` and `WriteProcessMemory` serve a RUNNING
	// process, so the driver arms and clears breakpoints without asking whether the program is stopped. A
	// borrowed stop restores that: the process is halted, the access is made, and it is resumed exactly as it
	// was — so a driver that never stopped it cannot tell, and one that did keeps its own stop.
	function borrowedStop() returns PtraceStopBorrow
		if self.stopOutstanding 'itIsAlreadyStopped'
			return PtraceStopBorrow.alreadyStopped
		end 'itIsAlreadyStopped'

		let leader = self.process as BackendThreadId

		if not self.knowsThread(leader) 'theLeaderHasLeft'
			return PtraceStopBorrow.unavailable
		end 'theLeaderHasLeft'

		if not self.threadIsStillRunning(leader) 'theLeaderStandsAlready'
			return PtraceStopBorrow.alreadyStopped
		end 'theLeaderStandsAlready'

		var leaderAlone = BackendThreadIdArray.create()
		leaderAlone.push(leader)

		return PtraceStopBorrow.taken if self.threadsBroughtToAStop(leaderAlone) else PtraceStopBorrow.unavailable
	end 'borrowedStop'

	function returnedTheBorrowedStop(borrowed PtraceStopBorrow)
		if not borrowed.wasTaken() 'nothingWasBorrowed'
			return
		end 'nothingWasBorrowed'

		_ = self.stoppedThreadsResumed()
	end 'returnedTheBorrowedStop'

	export function readMemory(address DebugAddress, bytes BackendByteCount) returns BackendMemoryRead
		let borrowed = self.borrowedStop()
		let copied = try self.trace.readMemory(self.process as DebuggeeProcessId, address: address as DebuggeeAddress, count: bytes as DebuggeeByteCount) otherwise 'unreadable'
			self.returnedTheBorrowedStop(borrowed)

			return BackendMemoryRead.unreadable
		end 'unreadable'

		self.returnedTheBorrowedStop(borrowed)

		return BackendMemoryRead.read(copied)
	end 'readMemory'

	// ⛔ `process_vm_writev` CANNOT WRITE A READ-ONLY TEXT PAGE and every breakpoint write is exactly that, so
	// the write road is `PTRACE_POKEDATA` — which is word-granular, so a partial word is read back first and
	// overlaid.
	export function writeMemory(address DebugAddress, bytes ByteArray) returns bool
		match transferSizeOf(bytes.count() as TransferByteCount) 'size'
			nothing then return true
			pastTheWindow then return false
			withinTheWindow then break
		end 'size'

		let borrowed = self.borrowedStop()
		let wrote = self.codeWrittenByAStoppedThread(address, bytes: bytes)
		self.returnedTheBorrowedStop(borrowed)

		return wrote
	end 'writeMemory'

	// ⛔⛔ **A `PEEKDATA`/`POKEDATA` NAMES A THREAD AND THE THREAD MUST BE IN PTRACE-STOP**, so the request goes
	// to one this backend knows is stopped rather than to the thread group's leader: a walk single-steps one
	// thread while the others run on, and aiming a poke at a RUNNING leader answers `ESRCH` — which planted no
	// trap and reported no failure the driver could act on, so the walk ran to the program's exit.
	function codeWrittenByAStoppedThread(address DebugAddress, bytes ByteArray) returns bool
		match self.stoppedThreadForRequests() 'stopped'
			none then return false
			at(thread) then try self.trace.writeCode(thread as DebuggeeThreadId, address: address as DebuggeeAddress, content: bytes) otherwise return false
		end 'stopped'

		return true
	end 'codeWrittenByAStoppedThread'

	function stoppedThreadForRequests() returns PtraceRequestThread
		for entry in self.threads 'eachThread'
			if entry.stopped 'itIsStopped'
				return PtraceRequestThread.at(entry.id as BackendWord)
			end 'itIsStopped'
		end 'eachThread'

		return PtraceRequestThread.none
	end 'stoppedThreadForRequests'

	// --- registers ---

	export function readRegisters(thread BackendThreadId) returns BackendRegisterRead
		let block = try self.trace.registers(thread as DebuggeeThreadId) otherwise return BackendRegisterRead.unreadable
		var file = DebugRegisterFile.create()
		let offsets = ptraceGprBlockOffsets()

		for (iter, offset) in offsets.withIterator() 'eachGeneralRegister'
			file.setValue(iter.index() as BackendRegisterNumber, value: ptraceBlockWord(block, at: offset))
		end 'eachGeneralRegister'

		file.setValue(BackendRegSlotPc as BackendRegisterNumber, value: ptraceProgramCounterOf(block))
		file.setValue(BackendRegSlotFlags as BackendRegisterNumber, value: ptraceStatusWordOf(block))
		file.setValue(BackendRegSlotSp as BackendRegisterNumber, value: ptraceStackPointerOf(block))

		return BackendRegisterRead.read(file)
	end 'readRegisters'

	// ⛔ **`PTRACE_GETREGS` ANSWERS THE GENERAL REGISTERS ONLY**, so a float local — which lives in an XMM —
	// reads as zero without a second request. A lane that cannot serve it leaves the vector slots as
	// `DebugRegisterFile.create` left them, which is what the engine already reads for a thread it cannot
	// reach; only the low half of each XMM is taken, because that is the half the other lane's `CONTEXT`
	// decode stores and the slot is one word wide.
	export function fillVectorRegisters(thread BackendThreadId, into DebugRegisterFile)
		let block = try self.trace.vectorRegisters(thread as DebuggeeThreadId) otherwise return

		for lane in 0 upto BackendVectorSlots 'eachVectorRegister'
			into.setValue((BackendGprSlots + lane) as BackendRegisterNumber, value: ptraceVectorLaneOf(block, lane: lane as BackendWord))
		end 'eachVectorRegister'
	end 'fillVectorRegisters'

	export function setProgramCounter(thread BackendThreadId, address DebugAddress) returns bool
		let block = try self.trace.registers(thread as DebuggeeThreadId) otherwise return false
		let patched = try ptraceWithProgramCounter(block, address: address as BackendWord) otherwise panic("PtraceBackend.setProgramCounter: ptraceWithProgramCounter refused a register block registers just produced — the program counter sits at a constant offset inside the fixed-length block")
		try self.trace.setRegisters(thread as DebuggeeThreadId, block: patched) otherwise return false

		return true
	end 'setProgramCounter'

	function programCounterOf(thread BackendWord) returns PtraceProgramCounter
		let block = try self.trace.registers(thread as DebuggeeThreadId) otherwise return PtraceProgramCounter.unreadable

		return PtraceProgramCounter.at(debugAddressOrZero(ptraceProgramCounterOf(block) as DebuggeeWord))
	end 'programCounterOf'

	// --- the thread table ---

	function rememberThread(id BackendThreadId, signal BackendWord, event TraceEvent)
		let standingSignal = signal if event == TraceEvent.signalStop else NoSignal
		let stopObserved = standingSignal == ptraceStopSignal()

		match self.entryOf(id) 'known'
			none then self.threads.push(PtraceThreadEntry.create(id, stopped: true, owedSignals: PtraceOwedSignalArray.create(), stopOwed: false, standingSignal: standingSignal))
			at(entry) then self.withEntryReplaced(PtraceThreadEntry.create(id, stopped: true, owedSignals: entry.owedSignals, stopOwed: entry.stopOwed and not stopObserved, standingSignal: standingSignal))
		end 'known'
	end 'rememberThread'

	function entryOf(id BackendThreadId) returns PtraceThreadEntryLookup
		for entry in self.threads 'eachThread'
			if entry.id == id 'thisOne'
				return PtraceThreadEntryLookup.at(entry)
			end 'thisOne'
		end 'eachThread'

		return PtraceThreadEntryLookup.none
	end 'entryOf'

	function withEntryReplaced(updated PtraceThreadEntry)
		var kept = PtraceThreadEntryArray.create()

		for entry in self.threads 'eachThread'
			if entry.id == updated.id 'thisOne'
				kept.push(updated)
			end 'thisOne' else 'anotherThread'
				kept.push(entry)
			end 'anotherThread'
		end 'eachThread'

		self.threads = kept
	end 'withEntryReplaced'

	function recordPendingSignal(id BackendThreadId, signal BackendWord)
		match self.entryOf(id) 'known'
			none then return
			at(entry) then self.withEntryReplaced(PtraceThreadEntry.create(id, stopped: entry.stopped, owedSignals: ptraceSignalsWith(entry.owedSignals, signal: signal), stopOwed: entry.stopOwed, standingSignal: entry.standingSignal))
		end 'known'
	end 'recordPendingSignal'

	function markResumed(id BackendThreadId, keepsItsSignals bool)
		match self.entryOf(id) 'known'
			none then return
			at(entry) then self.withEntryReplaced(PtraceThreadEntry.create(id, stopped: false, owedSignals: entry.owedSignals if keepsItsSignals else PtraceOwedSignalArray.create(), stopOwed: entry.stopOwed, standingSignal: NoSignal))
		end 'known'
	end 'markResumed'

	function markStopOwed(id BackendThreadId)
		match self.entryOf(id) 'known'
			none then return
			at(entry) then self.withEntryReplaced(PtraceThreadEntry.create(id, stopped: entry.stopped, owedSignals: entry.owedSignals, stopOwed: true, standingSignal: entry.standingSignal))
		end 'known'
	end 'markStopOwed'

	function owedSignalsOf(id BackendThreadId) returns PtraceOwedSignalArray
		return match self.entryOf(id) 'known'
			none gives PtraceOwedSignalArray.create()
			at(entry) gives entry.owedSignals
		end 'known'
	end 'owedSignalsOf'

	function laterSignalsRaised(id BackendThreadId, owed PtraceOwedSignalArray)
		for (iter, signal) in owed.withIterator() 'eachLaterSignal'
			if iter.index() > 0 and not self.signalRaised(id, signal: signal) 'theThreadHasLeft'
				return
			end 'theThreadHasLeft'
		end 'eachLaterSignal'
	end 'laterSignalsRaised'

	function signalRaised(id BackendThreadId, signal BackendWord) returns bool
		return self.trace.signalThread(self.process as DebuggeeProcessId, thread: id as DebuggeeThreadId, signal: signal as DebuggeeSignal)
	end 'signalRaised'

	function owesAStop(id BackendThreadId) returns bool
		return match self.entryOf(id) 'known'
			none gives false
			at(entry) gives entry.stopOwed
		end 'known'
	end 'owesAStop'

	function forgotEndingTheHold(id BackendThreadId) returns bool
		let holdEnded = self.stepping.forgetEndingTheHold(id)
		var kept = PtraceThreadEntryArray.create()

		for entry in self.threads 'eachThread'
			if entry.id != id 'anotherThread'
				kept.push(entry)
			end 'anotherThread'
		end 'eachThread'

		self.threads = kept

		return holdEnded
	end 'forgotEndingTheHold'
end 'PtraceBackend'
