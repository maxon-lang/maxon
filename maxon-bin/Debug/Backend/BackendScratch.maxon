let ScratchBytes = 0x1000

export let TransferWindowBytes = 512

module typealias BackendPageOffset = int(0 to 0xFF8)

module let MaxBackendPageOffset = 0xFF8

export function requireBackendPageOffsetSpansItsScratch()
	if MaxBackendPageOffset != ScratchBytes - DebuggeeWordBytes 'aBoundThatIsNotTheScratchs'
		panic("BackendScratch: BackendPageOffset is bounded at {MaxBackendPageOffset} and the last whole word of a {ScratchBytes}-byte scratch page begins at {ScratchBytes - DebuggeeWordBytes}")
	end 'aBoundThatIsNotTheScratchs'
end 'requireBackendPageOffsetSpansItsScratch'

export let BackendScratchRefusal = "could not reserve the pages the debugger reads a stopped thread's registers through"

module type BackendScratchPage
	var base as BackendHandle

	module static function create() returns BackendScratchPage
		return Self{base: __Builtins.profileScratchAlloc(ScratchBytes) as BackendHandle}
	end 'create'

	module function held() returns bool
		return self.base != 0
	end 'held'

	module function close()
		if self.base != 0 'holdsPages'
			__Builtins.profileScratchFree(self.base, ScratchBytes)
			self.base = 0
		end 'holdsPages'
	end 'close'

	module function word(offset BackendPageOffset) returns BackendWord
		return __Builtins.profileReadWord(self.base, offset)
	end 'word'

	module function setWord(offset BackendPageOffset, value BackendWord)
		__Builtins.profileWriteWord(self.base, offset, value)
	end 'setWord'

	module function addressOf(offset BackendPageOffset) returns BackendWord
		return (self.base as BackendWord) + (offset as BackendWord)
	end 'addressOf'

	module function bytesAt(offset BackendPageOffset, count BackendByteCount) returns ByteArray
		var taken = ByteArray.create()
		var index = 0 as BackendByteCount

		while index < count 'eachWord'
			taken.append(debuggeeWordBytes(self.word(((offset as BackendByteCount) + index) as BackendPageOffset) as DebuggeeWord, width: debugWordWidthWithin((count - index) as DebugAddress)))
			index = index + (DebuggeeWordBytes as BackendByteCount)
		end 'eachWord'

		return taken
	end 'bytesAt'

	module function fill(offset BackendPageOffset, bytes ByteArray)
		let count = bytes.count() as BackendByteCount
		var index = 0 as BackendByteCount

		while index < count 'eachWord'
			match debugLittleEndianAt(bytes, at: index as DebugAddress, width: debugWordWidthWithin((count - index) as DebugAddress)) 'word'
				pastTheBytes then panic("BackendScratchPage.fill: the word at byte {index} is cut to the {count} bytes in hand")
				read(value) then self.setWord(((offset as BackendByteCount) + index) as BackendPageOffset, value: value as BackendWord)
			end 'word'

			index = index + (DebuggeeWordBytes as BackendByteCount)
		end 'eachWord'
	end 'fill'
end 'BackendScratchPage'
