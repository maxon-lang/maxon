let TrapFlagBit = 0x100

let PeNewHeaderPointerOffset = 0x3C
let PeSizeOfImageOffset = 0x50
let PeDwordBytes = 4

let ExceptionCodeBreakpoint = 0x80000003
let ExceptionCodeSingleStep = 0x80000004

let DetachDrainBudgetMs = 2000
let DetachDrainSliceMs = 50

let Win64GprCount = 16
let Win64XmmCount = 16

type BackendThreadEntry
	export let id as BackendThreadId
	export let handle as DebugHandle

	static function create(id BackendThreadId, handle DebugHandle) returns BackendThreadEntry
		return Self{id: id, handle: handle}
	end 'create'
end 'BackendThreadEntry'

typealias BackendThreadEntryArray = Array with BackendThreadEntry

union BackendThreadHandleLookup
	none
	at(handle DebugHandle)
end 'BackendThreadHandleLookup'

union BackendProcessHandle
	absent
	held(handle DebugHandle)
end 'BackendProcessHandle'

function registerFileOf(context RegisterBlock) returns DebugRegisterFile throws DebuggeeError
	var file = DebugRegisterFile.create()

	for slot in 0 upto Win64GprCount 'eachGeneralRegister'
		file.setValue(slot as BackendRegisterNumber, value: (try context.gpr(slot as Win64GprIndex)) as BackendWord)
	end 'eachGeneralRegister'

	file.setValue(BackendRegSlotPc as BackendRegisterNumber, value: (try context.programCounter()) as BackendWord)
	file.setValue(BackendRegSlotFlags as BackendRegisterNumber, value: (try context.flags()) as BackendWord)

	return file
end 'registerFileOf'

export type WindowsBackend
	var port as DebugPort
	var process as BackendProcessHandle
	var processId as DebuggeeProcessId
	var threads as BackendThreadEntryArray
	var pendingUnowned as bool
	var stopOutstanding as bool
	var sawFirstBreakpoint as bool
	var stopRequested as bool
	var stepping as BackendStepRoster
	var suspended as BackendThreadIdArray
	var imageBase as BackendWord
	var imageEnd as BackendWord
	var breakInThreads as BackendThreadIdArray
	var breakInsOwed as BackendWord
	var status as BackendExitStatus

	export static function create() returns WindowsBackend
		return Self{port: DebugPort.create(), process: BackendProcessHandle.absent, processId: 0, threads: BackendThreadEntryArray.create(), pendingUnowned: false, stopOutstanding: false, sawFirstBreakpoint: false, stopRequested: false, stepping: BackendStepRoster.create(), suspended: BackendThreadIdArray.create(), imageBase: 0, imageEnd: 0, breakInThreads: BackendThreadIdArray.create(), breakInsOwed: 0, status: BackendExitStatus.running}
	end 'create'

	export function holdsItsScratch() returns bool
		return self.port.isReady()
	end 'holdsItsScratch'

	export function close()
		self.port.close()
	end 'close'

	export function exitStatus() returns BackendExitStatus
		return self.status
	end 'exitStatus'

	export function listThreads() returns BackendThreadIdArray
		var ids = BackendThreadIdArray.create()

		for entry in self.threads 'eachThread'
			ids.push(entry.id)
		end 'eachThread'

		return ids
	end 'listThreads'

	export function stoppedThread() returns BackendThreadId
		return self.port.eventThread() as BackendThreadId
	end 'stoppedThread'

	// --- the stop loop ---

	export function waitForStop(budgetMs BackendWaitBudgetMs) returns DebugStopEvent
		while true 'pump'
			let arrived = self.port.waitEvent(budgetMs as DebuggeeWaitMs)

			match self.classified(arrived) 'event'
				bookkeeping then continue
				ended(ending) then return ending
				stop(stopping) then return stopping
			end 'event'
		end 'pump'

		panic("WindowsBackend.waitForStop: the pump leaves only by answering an event, and every class above answers one")
	end 'waitForStop'

	function classified(arrived DebugPortEvent) returns BackendEventClass
		return match arrived 'which'
			timedOut gives BackendEventClass.ended(DebugStopEvent.timedOut)
			processCreated(pid, thread, created, threadHandle, loadedAt) gives self.processArrived(pid, thread: thread, created: created, threadHandle: threadHandle, loadedAt: loadedAt)
			threadCreated(thread, threadHandle, startAddress) gives self.threadArrived(thread, threadHandle: threadHandle, startAddress: startAddress)
			threadExited(thread) gives self.threadLeft(thread)
			processExited(_, exitCode) gives self.processLeft(exitCode)

			libraryLoaded or
			other gives self.continuedPast()

			exception(thread, code, address) gives self.exceptionStop(thread, code: code, address: address)
		end 'which'
	end 'classified'

	function continuedPast() returns BackendEventClass
		_ = self.port.continueEvent(DebugDisposition.handled)

		return BackendEventClass.bookkeeping
	end 'continuedPast'

	function processArrived(pid DebuggeeProcessId, thread DebuggeeThreadId, created DebugHandle, threadHandle DebugHandle, loadedAt DebuggeeAddress) returns BackendEventClass
		self.process = BackendProcessHandle.held(created)
		self.processId = pid
		self.rememberThread(thread as BackendThreadId, handle: threadHandle)
		self.imageBase = loadedAt as BackendWord
		self.imageEnd = self.imageBase + self.imageDwordAt(self.imageBase + self.imageDwordAt(self.imageBase + PeNewHeaderPointerOffset) + PeSizeOfImageOffset)

		return self.continuedPast()
	end 'processArrived'

	function threadArrived(thread DebuggeeThreadId, threadHandle DebugHandle, startAddress DebuggeeAddress) returns BackendEventClass
		self.rememberThread(thread as BackendThreadId, handle: threadHandle)

		if not self.insideTheImage(startAddress as BackendWord) 'aThreadTheProgramDidNotStart'
			self.breakInThreads.push(thread as BackendThreadId)
		end 'aThreadTheProgramDidNotStart'

		if self.stepping.company() == BackendOtherThreads.hold 'bornDuringAHeldStep'
			self.suspendEveryThreadNotStepping()
		end 'bornDuringAHeldStep'

		return self.continuedPast()
	end 'threadArrived'

	function threadLeft(thread DebuggeeThreadId) returns BackendEventClass
		let departed = thread as BackendThreadId

		if self.stepping.holds(departed) 'aStepperLeft'
			self.stepping.forget(departed)
			self.forgetThread(departed)
			self.stopOutstanding = true
			self.pendingUnowned = false

			return BackendEventClass.stop(DebugStopEvent.threadExited(departed))
		end 'aStepperLeft'

		self.forgetThread(departed)

		return self.continuedPast()
	end 'threadLeft'

	function processLeft(exitCode DebuggeeExitCode) returns BackendEventClass
		let ending = exitCode as BackendExitCode
		self.status = BackendExitStatus.ended(ending)
		self.stepping.clear()
		self.suspended = BackendThreadIdArray.create()
		_ = self.port.continueEvent(DebugDisposition.handled)

		return BackendEventClass.ended(DebugStopEvent.exited(ending))
	end 'processLeft'

	// ⭐ The breakpoint address is `ExceptionRecord.ExceptionAddress` and never arithmetic on the reported
	// program counter: the two conventions differ by one byte and this field is authoritative on both.
	function exceptionStop(thread DebuggeeThreadId, code DebuggeeFaultCode, address DebuggeeAddress) returns BackendEventClass
		let stopAddress = address as DebugAddress
		let stopThread = thread as BackendThreadId
		self.stopOutstanding = true
		self.stepping.forget(stopThread)

		if code == ExceptionCodeBreakpoint 'aPlantedByteOrTheLoadersOwn'
			self.pendingUnowned = false

			return self.breakpointExceptionStop(stopThread, address: stopAddress)
		end 'aPlantedByteOrTheLoadersOwn'

		if code == ExceptionCodeSingleStep 'aStepLanded'
			self.pendingUnowned = false

			return BackendEventClass.stop(DebugStopEvent.stopped(stopThread, reason: BackendStopReason.singleStep, faultCode: 0, address: stopAddress))
		end 'aStepLanded'

		self.pendingUnowned = true

		return BackendEventClass.stop(DebugStopEvent.stopped(stopThread, reason: BackendStopReason.fault, faultCode: code as BackendWord, address: stopAddress))
	end 'exceptionStop'

	// A pause's `DebugBreakProcess` breaks in on a thread started outside the image, at an address outside
	// it. Both are asked, because a thread the loader started can still reach a trap planted in the image.
	function breakpointExceptionStop(thread BackendThreadId, address DebugAddress) returns BackendEventClass
		if not self.sawFirstBreakpoint 'theLoadersOwn'
			self.sawFirstBreakpoint = true

			return BackendEventClass.stop(DebugStopEvent.stopped(thread, reason: BackendStopReason.entry, faultCode: 0, address: address))
		end 'theLoadersOwn'

		if not backendRosterHolds(self.breakInThreads, thread: thread) or self.insideTheImage(address as BackendWord) 'aProgramThreadsTrap'
			return BackendEventClass.stop(DebugStopEvent.stopped(thread, reason: BackendStopReason.breakpoint, faultCode: 0, address: address))
		end 'aProgramThreadsTrap'

		self.breakInsOwed = self.breakInsOwed - 1 if self.breakInsOwed > 0 else 0

		if not self.stopRequested 'aBreakInAnsweredAlready'
			_ = self.resumeAll()

			return BackendEventClass.bookkeeping
		end 'aBreakInAnsweredAlready'

		self.stopRequested = false

		return BackendEventClass.stop(DebugStopEvent.stopped(thread, reason: BackendStopReason.interrupt, faultCode: 0, address: address))
	end 'breakpointExceptionStop'

	function insideTheImage(address BackendWord) returns bool
		return address >= self.imageBase and address < self.imageEnd
	end 'insideTheImage'

	function imageDwordAt(address BackendWord) returns BackendWord
		let dword = match self.readMemory(debugAddressOrZero(address as DebuggeeWord), bytes: PeDwordBytes as BackendByteCount) 'read'
			unreadable panic("WindowsBackend.imageDwordAt: the program's image header at {address:x} could not be read while the process was being created, so no thread could be told from a debugger break-in")
			read(bytes) gives debugLittleEndianAt(bytes, at: 0, width: PeDwordBytes as DebugWidth)
		end 'read'

		return match dword 'dword'
			pastTheBytes panic("WindowsBackend.imageDwordAt: the {PeDwordBytes} bytes asked for at {address:x} came back short")
			read(value) gives value as BackendWord
		end 'dword'
	end 'imageDwordAt'

	// --- resuming ---

	export function resumeAll() returns bool
		if not self.stopOutstanding 'nothingIsStopped'
			return true
		end 'nothingIsStopped'

		self.stopOutstanding = false

		if self.stepping.company() == BackendOtherThreads.run 'noStepHoldsTheOthers'
			self.releaseEverySuspendedThread()
		end 'noStepHoldsTheOthers'

		return self.port.continueEvent(DebugDisposition.unhandled if self.pendingUnowned else DebugDisposition.handled)
	end 'resumeAll'

	export function stepThread(thread BackendThreadId, others BackendOtherThreads) returns bool
		if not self.trapFlagSet(thread, armed: true) 'noRegisterFile'
			return false
		end 'noRegisterFile'

		self.stepping.note(thread, others: others)
		self.releasedFromTheHold(thread)

		if self.stepping.company() == BackendOtherThreads.hold 'aStepOverALiftedTrap'
			self.suspendEveryThreadNotStepping()
		end 'aStepOverALiftedTrap'

		if not self.resumeAll() 'theKernelRefused'
			self.forgetStep(thread)
			self.releaseEverySuspendedThread()

			return false
		end 'theKernelRefused'

		return true
	end 'stepThread'

	function suspendEveryThreadNotStepping()
		for entry in self.threads 'eachThread'
			if self.stepping.holds(entry.id) or backendRosterHolds(self.suspended, thread: entry.id) 'itRunsOrIsHeldAlready'
				continue
			end 'itRunsOrIsHeldAlready'

			if self.port.suspend(entry.handle) 'theKernelSuspendedIt'
				self.suspended.push(entry.id)
			end 'theKernelSuspendedIt'
		end 'eachThread'
	end 'suspendEveryThreadNotStepping'

	function releasedFromTheHold(thread BackendThreadId)
		if not backendRosterHolds(self.suspended, thread: thread) 'itWasNotSuspended'
			return
		end 'itWasNotSuspended'

		self.suspended = backendRosterWithout(self.suspended, thread: thread)
		self.threadResumed(thread)
	end 'releasedFromTheHold'

	function releaseEverySuspendedThread()
		if self.suspended.count() == 0 'noneIsSuspended'
			return
		end 'noneIsSuspended'

		for thread in self.suspended 'eachSuspended'
			self.threadResumed(thread)
		end 'eachSuspended'

		self.suspended = BackendThreadIdArray.create()
	end 'releaseEverySuspendedThread'

	function threadResumed(thread BackendThreadId)
		match self.handleOf(thread) 'known'
			none then return
			at(handle) then self.handleResumed(thread, handle: handle)
		end 'known'
	end 'threadResumed'

	function handleResumed(thread BackendThreadId, handle DebugHandle)
		if not self.port.resume(handle) 'theKernelRefused'
			panic("WindowsBackend.threadResumed: ResumeThread refused thread {thread}, which this backend suspended to hold it through a step, so it would stay frozen for the rest of the session")
		end 'theKernelRefused'
	end 'handleResumed'

	export function requestStop() returns bool
		let interrupted = match self.process 'process'
			absent gives false
			held(handle) gives self.port.breakIn(handle)
		end 'process'

		if not interrupted 'theKernelRefused'
			return false
		end 'theKernelRefused'

		self.breakInsOwed = self.breakInsOwed + 1
		self.stopRequested = true

		return true
	end 'requestStop'

	export function forgetStep(thread BackendThreadId)
		self.stepping.forget(thread)
		_ = self.trapFlagSet(thread, armed: false)
	end 'forgetStep'

	export function retireStopRequest()
		self.stopRequested = false
	end 'retireStopRequest'

	// Before `DebugActiveProcessStop` every stepper's trap flag is cleared, since left set it raises a
	// single-step exception no debugger answers, and every queued event is drained and continued here.
	export function detach() returns bool
		for stepper in self.stepping.outstanding().clone() 'eachStepper'
			self.stepperLetGo(stepper)
		end 'eachStepper'

		self.releaseEverySuspendedThread()
		_ = self.resumeAll()
		self.stopRequested = false
		self.queuedEventsDrained()

		return self.port.detach(self.processId)
	end 'detach'

	// A thread's context is written only while it stands still, so a stepper still running is suspended
	// around the write.
	function stepperLetGo(thread BackendThreadId)
		if self.stopOutstanding 'everyThreadStandsStill'
			self.forgetStep(thread)

			return
		end 'everyThreadStandsStill'

		match self.handleOf(thread) 'known'
			none then self.stepping.forget(thread)
			at(handle) then self.suspendedStepperLetGo(thread, handle: handle)
		end 'known'
	end 'stepperLetGo'

	function suspendedStepperLetGo(thread BackendThreadId, handle DebugHandle)
		if not self.port.suspend(handle) 'itHasLeft'
			self.stepping.forget(thread)

			return
		end 'itHasLeft'

		self.forgetStep(thread)
		self.threadResumed(thread)
	end 'suspendedStepperLetGo'

	function queuedEventsDrained()
		let deadline = debugDeadlineAfter(DetachDrainBudgetMs as StopTimeoutMs)

		while not debugDeadlinePassed(deadline) and self.oneQueuedEventDrained() 'eachEvent'
			continue
		end 'eachEvent'
	end 'queuedEventsDrained'

	function oneQueuedEventDrained() returns bool
		return match self.waitForStop(DetachDrainSliceMs as BackendWaitBudgetMs) 'seen'
			stopped(thread, reason, _, address) gives self.resumedPastAStopNobodyTakes(thread, reason: reason, address: address)

			threadStarted or
			threadExited gives true

			timedOut gives self.breakInsOwed > 0

			exited or
			signalled gives false
		end 'seen'
	end 'oneQueuedEventDrained'

	// A breakpoint stop queued before its byte was restored leaves the program counter past the trap; it
	// is put back onto the restored instruction, or the program resumes inside it.
	function resumedPastAStopNobodyTakes(thread BackendThreadId, reason BackendStopReason, address DebugAddress) returns bool
		if reason == BackendStopReason.breakpoint and self.trapByteRemovedAt(address) 'backOntoTheRestoredInstruction'
			_ = self.setProgramCounter(thread, address: address)
		end 'backOntoTheRestoredInstruction'

		return self.resumeAll()
	end 'resumedPastAStopNobodyTakes'

	function trapByteRemovedAt(address DebugAddress) returns bool
		let trap = hostTrapShape()

		return match trap.presenceIn(self.readMemory(address, bytes: trap.bytes())) 'presence'
			removed gives true

			stands or
			unreadable gives false
		end 'presence'
	end 'trapByteRemovedAt'

	// --- memory ---

	export function readMemory(address DebugAddress, bytes BackendByteCount) returns BackendMemoryRead
		return match self.process 'process'
			absent gives BackendMemoryRead.unreadable
			held(handle) gives self.memoryReadThrough(handle, address: address, bytes: bytes)
		end 'process'
	end 'readMemory'

	function memoryReadThrough(handle DebugHandle, address DebugAddress, bytes BackendByteCount) returns BackendMemoryRead
		let taken = try self.port.readMemory(handle, address: address as DebuggeeAddress, count: bytes as DebuggeeByteCount) otherwise return BackendMemoryRead.unreadable

		return BackendMemoryRead.read(taken)
	end 'memoryReadThrough'

	export function writeMemory(address DebugAddress, bytes ByteArray) returns bool
		match self.process 'process'
			absent then return false
			held(handle) then try self.port.writeCode(handle, address: address as DebuggeeAddress, content: bytes) otherwise return false
		end 'process'

		return true
	end 'writeMemory'

	// --- registers ---

	export function readRegisters(thread BackendThreadId) returns BackendRegisterRead
		return match self.handleOf(thread) 'known'
			none gives BackendRegisterRead.unreadable
			at(handle) gives self.registersOf(handle)
		end 'known'
	end 'readRegisters'

	function registersOf(handle DebugHandle) returns BackendRegisterRead
		let context = try self.port.readContext(handle) otherwise return BackendRegisterRead.unreadable
		let file = try registerFileOf(context) otherwise panic("WindowsBackend.registersOf: registerFileOf refused a context readContext just produced — the context is read at its fixed CONTEXT length and every field it decodes sits at a constant offset inside it")

		return BackendRegisterRead.read(file)
	end 'registersOf'

	export function fillVectorRegisters(thread BackendThreadId, into DebugRegisterFile)
		match self.handleOf(thread) 'known'
			none then return
			at(handle) then self.vectorsFilled(handle, into: into)
		end 'known'
	end 'fillVectorRegisters'

	function vectorsFilled(handle DebugHandle, into DebugRegisterFile)
		let context = try self.port.readContext(handle) otherwise return

		for lane in 0 upto Win64XmmCount 'eachVectorRegister'
			let word = try context.xmmLane(lane as Win64XmmIndex) otherwise panic("WindowsBackend.vectorsFilled: xmmLane refused lane {lane} of a context readContext just produced — the sixteen XMM lanes sit at constant offsets inside the fixed-length CONTEXT")
			into.setValue((BackendGprSlots + lane) as BackendRegisterNumber, value: word as BackendWord)
		end 'eachVectorRegister'
	end 'vectorsFilled'

	export function setProgramCounter(thread BackendThreadId, address DebugAddress) returns bool
		return match self.handleOf(thread) 'known'
			none gives false
			at(handle) gives self.programCounterSetFor(handle, address: address)
		end 'known'
	end 'setProgramCounter'

	function programCounterSetFor(handle DebugHandle, address DebugAddress) returns bool
		let context = try self.port.readContext(handle) otherwise return false
		let patched = try context.withProgramCounter(address as RegisterWord) otherwise panic("WindowsBackend.programCounterSetFor: withProgramCounter refused a context readContext just produced — the program counter sits at a constant offset inside the fixed-length CONTEXT")
		try self.port.writeContext(handle, context: patched) otherwise return false

		return true
	end 'programCounterSetFor'

	// ⭐ A step is the x86 trap flag in the thread's own saved register file, not a system call.
	function trapFlagSet(thread BackendThreadId, armed bool) returns bool
		return match self.handleOf(thread) 'known'
			none gives false
			at(handle) gives self.trapFlagSetFor(handle, armed: armed)
		end 'known'
	end 'trapFlagSet'

	function trapFlagSetFor(handle DebugHandle, armed bool) returns bool
		let context = try self.port.readContext(handle) otherwise return false
		let flags = try context.flags() otherwise panic("WindowsBackend.trapFlagSetFor: flags refused a context readContext just produced — the flags word sits at a constant offset inside the fixed-length CONTEXT")
		let changed = flags or TrapFlagBit if armed else flags - (flags and TrapFlagBit)
		let patched = try context.withFlags(changed) otherwise panic("WindowsBackend.trapFlagSetFor: withFlags refused a context readContext just produced — the flags word sits at a constant offset inside the fixed-length CONTEXT")
		try self.port.writeContext(handle, context: patched) otherwise return false

		return true
	end 'trapFlagSetFor'

	// --- the thread table ---

	function rememberThread(id BackendThreadId, handle DebugHandle)
		self.forgetThread(id)
		self.threads.push(BackendThreadEntry.create(id, handle: handle))
	end 'rememberThread'

	function forgetThread(id BackendThreadId)
		self.suspended = backendRosterWithout(self.suspended, thread: id)
		self.breakInThreads = backendRosterWithout(self.breakInThreads, thread: id)
		var kept = BackendThreadEntryArray.create()

		for entry in self.threads 'eachThread'
			if entry.id != id 'anotherThread'
				kept.push(entry)
			end 'anotherThread'
		end 'eachThread'

		self.threads = kept
	end 'forgetThread'

	function handleOf(id BackendThreadId) returns BackendThreadHandleLookup
		for entry in self.threads 'eachThread'
			if entry.id == id 'thisOne'
				return BackendThreadHandleLookup.at(entry.handle)
			end 'thisOne'
		end 'eachThread'

		return BackendThreadHandleLookup.none
	end 'handleOf'
end 'WindowsBackend'
