export let ChildPollMs = 5

export enum ChildStream
	stdout
	stderr
end 'ChildStream'

export function pollChildStreamLine(child StreamingSubprocess, stream ChildStream) returns LinePoll
	return match stream 'which'
		stdout gives try child.tryReadStdoutLine() otherwise panic("the child's stdout is out with a StdoutReader")
		stderr gives child.tryReadStderrLine()
	end 'which'
end 'pollChildStreamLine'

export union ChildProgress
	finished(status TerminationStatus)
	waiting
end 'ChildProgress'

export function childProgress(child StreamingSubprocess) returns ChildProgress
	if not child.outputHasEnded() 'stillOpen'
		return ChildProgress.waiting
	end 'stillOpen'

	return match child.pollTermination() 'polled'
		ended(status) gives ChildProgress.finished(status)
		running gives ChildProgress.waiting
	end 'polled'
end 'childProgress'
