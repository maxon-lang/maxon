export function pumpOfSpawned(child StreamingSubprocess) returns ChildPump
	let pump = try ChildPump.of(child) otherwise (e) 'notTaken'
		panic("pumpOfSpawned: the output of a child nothing has read from or released could not be taken ({e.displayReason()})")
	end 'notTaken'

	return pump
end 'pumpOfSpawned'
