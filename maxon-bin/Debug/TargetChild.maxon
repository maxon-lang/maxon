export enum ChildStream
	stdout
	stderr
end 'ChildStream'

export type ChildOutputLine
	export let stream as ChildStream
	export let text as String

	static function create(stream ChildStream, text String) returns ChildOutputLine
		return Self{stream: stream, text: text}
	end 'create'
end 'ChildOutputLine'

export typealias ChildOutputLineArray = Array with ChildOutputLine
typealias ChildOutputLineList = List with ChildOutputLine
typealias SinkBytes = int(0 to u64.max)

let OutputSinkByteCapacity = 4194304 as SinkBytes

export type CollectedLines
	export var lines as ChildOutputLineArray
	export var dropped as ChildLineTally

	export static function create() returns CollectedLines
		return Self{lines: ChildOutputLineArray.create(0), dropped: 0}
	end 'create'

	static function of(lines ChildOutputLineArray, dropped ChildLineTally) returns CollectedLines
		return Self{lines: lines, dropped: dropped}
	end 'of'

	export function followedBy(later CollectedLines) returns CollectedLines
		var joined = ChildOutputLineArray.create(self.lines.count() + later.lines.count(), zeroed: false)

		for line in self.lines 'eachEarlier'
			joined.push(line)
		end 'eachEarlier'

		for line in later.lines 'eachLater'
			joined.push(line)
		end 'eachLater'

		return Self{lines: joined, dropped: self.dropped + later.dropped}
	end 'followedBy'
end 'CollectedLines'

export function droppedOutputNotice(dropped ChildLineTally) returns String
	return "[maxon: {dropped} earlier line(s) of the program's output were dropped, to hold what is waiting for the debugger under {OutputSinkByteCapacity} bytes]"
end 'droppedOutputNotice'

export type OutputSink
	var lines as ChildOutputLineList
	var heldBytes as SinkBytes
	var dropped as ChildLineTally

	export static function create() returns OutputSink
		return Self{lines: ChildOutputLineList.create(), heldBytes: 0, dropped: 0}
	end 'create'

	function record(text String, stream ChildStream)
		let kept = self.withinCapacity(text)
		self.lines.append(ChildOutputLine.create(stream, text: kept))
		self.heldBytes = self.heldBytes + (kept.byteLength() as SinkBytes)

		while self.heldBytes > OutputSinkByteCapacity and self.lines.count() > 1 'dropTheOldest'
			let oldest = try self.lines.removeFirst() otherwise panic("OutputSink.record: a sink holding {self.lines.count()} lines has a first")
			self.heldBytes = self.heldBytes - (oldest.text.byteLength() as SinkBytes)
			self.dropped = self.dropped + 1
		end 'dropTheOldest'
	end 'record'

	function withinCapacity(text String) returns String
		if text.byteLength() <= (OutputSinkByteCapacity as BytePos) 'fits'
			return text
		end 'fits'

		self.dropped = self.dropped + 1

		return firstBytes(text, max: OutputSinkByteCapacity as BytePos)
	end 'withinCapacity'

	export function takeAll() returns CollectedLines
		var taken = ChildOutputLineArray.create(self.lines.count(), zeroed: false)

		for line in self.lines 'eachHeld'
			taken.push(line)
		end 'eachHeld'

		var collected = CollectedLines.of(taken, dropped: self.dropped)
		self.lines.clear()
		self.heldBytes = 0
		self.dropped = 0

		return collected
	end 'takeAll'
end 'OutputSink'

// `allToStandardError` puts both of the child's streams on this process's stderr, which keeps
// stdout exactly the report (the profiler's table, the debugger's JSON) and nothing else.
export union ChildOutputRouting
	verbatim
	allToStandardError
	collect(sink OutputSink)
end 'ChildOutputRouting'

export typealias ChildLineTally = int(0 to u32.max)

export union ChildLineBudget
	unbounded
	atMost(lines ChildLineTally)
end 'ChildLineBudget'

export union TargetEnvParse
	pair(name String, value String)
	malformed
end 'TargetEnvParse'

export typealias TargetSeconds = float(0.0 to f64.max)

export type TargetSecondsReading
	export var seconds as TargetSeconds

	export static function create(seconds TargetSeconds) returns TargetSecondsReading
		return Self{seconds: seconds}
	end 'create'
end 'TargetSecondsReading'

export union TargetSecondsParse
	reading(value TargetSecondsReading)
	refused
end 'TargetSecondsParse'

let EnvAssignment = "="

// The longest deadline accepted: the most a signed 64-bit count of 100 ns ticks holds. It also
// excludes an infinity, which a float can carry and a wait cannot.
export let MaxTargetSeconds = 922337203685.0 as TargetSeconds

// One millisecond: a bound is taken in whole milliseconds, and a shorter reading would truncate
// to zero.
export let LeastTargetSeconds = 0.001 as TargetSeconds

let TreeNotEndedNotice = "maxon: the target's process tree is not known to have ended, so the rest of its output is not waited for: "
let EndedTailBoundNotice = "maxon: a process the target started and left outside its process tree still holds its output, so the rest of it is not waited for\n"
let EndedTailBoundMs = 1000
let EndedTailPollMs = 5
let UnendedTailLines = 64

// Emptiness is not the stopping rule and cannot be: a child's own blank line and a pipe with
// nothing in it are the same string once the terminator is off, so a loop keyed off the text drops
// every blank line the child writes. The poll's `none` is the stopping rule.
//
// The budget bounds one pass: a chatty child must not starve the caller's own schedule.
export function forwardChildOutput(child StreamingSubprocess, routing ChildOutputRouting, budget ChildLineBudget) returns bool
	var faulted = false
	var taken = 0 as ChildLineTally
	var buffered = true

	while buffered and withinBudget(budget, taken: taken) 'interleaved'
		let pass = forwardOneLineEach(child, routing: routing)
		faulted = pass.faulted or faulted
		buffered = pass.moved
		taken = taken + 1
	end 'interleaved'

	return faulted
end 'forwardChildOutput'

type ChildPass
	export let moved as bool
	export let faulted as bool

	static function create(moved bool, faulted bool) returns ChildPass
		return Self{moved: moved, faulted: faulted}
	end 'create'
end 'ChildPass'

function forwardOneLineEach(child StreamingSubprocess, routing ChildOutputRouting) returns ChildPass
	var moved = false
	var faulted = false

	for stream in ChildStream.allCases 'eachStream'
		match pollChildStreamLine(child, stream: stream) 'polled'
			none then continue
			line(text) then faulted = emitChildStreamLine(text, stream: stream, routing: routing) or faulted
		end 'polled'

		moved = true
	end 'eachStream'

	return ChildPass.create(moved, faulted: faulted)
end 'forwardOneLineEach'

// Everything the child left behind, including a last line it wrote with no terminator — the poll above
// stops at a newline that never arrives. The reads block until each stream ends, so a process still
// holding a pipe, a descendant the child left behind, blocks them for as long as it lives: a caller
// needs the child's whole tree ended, and `endChildAndForwardTail` is the form that bounds the wait.
// A read that refuses ends its stream exactly as end of stream does.
export function forwardChildTail(child StreamingSubprocess, routing ChildOutputRouting) returns bool
	var faulted = forwardChildOutput(child, routing: routing, budget: ChildLineBudget.unbounded)

	for stream in ChildStream.allCases 'eachStream'
		faulted = forwardChildStreamToItsEnd(child, stream: stream, routing: routing) or faulted
	end 'eachStream'

	return faulted
end 'forwardChildTail'

function forwardChildStreamToItsEnd(child StreamingSubprocess, stream ChildStream, routing ChildOutputRouting) returns bool
	var faulted = false

	while true 'eachLine'
		let line = try readChildStreamLine(child, stream: stream) otherwise break
		faulted = emitChildStreamLine(line, stream: stream, routing: routing) or faulted
	end 'eachLine'

	return faulted
end 'forwardChildStreamToItsEnd'

export function endChildAndForwardTail(child StreamingSubprocess, routing ChildOutputRouting) returns bool
	let treeEnd = child.endTree()

	match treeEnd 'tree'
		ended then return forwardEndedChildTail(child, routing: routing)
		survived or
		unconfirmed then return forwardUnendedChildOutput(child, treeEnd: treeEnd, routing: routing)
	end 'tree'
end 'endChildAndForwardTail'

// A confirmed kill ends the child's tree, not a process the child started outside it, which can hold
// the pipes open for good: the drain stops at `EndedTailBoundMs` instead of waiting for their end.
function forwardEndedChildTail(child StreamingSubprocess, routing ChildOutputRouting) returns bool
	let start = Clock.nowMs()
	var faulted = false

	while Clock.elapsedMs(start) < EndedTailBoundMs 'untilItEnds'
		let pass = forwardOneLineEach(child, routing: routing)
		faulted = pass.faulted or faulted

		if not pass.moved and childStreamsEnded(child) 'drained'
			return faulted
		end 'drained'

		if not pass.moved 'idle'
			sleep(EndedTailPollMs)
		end 'idle'
	end 'untilItEnds'

	printError(EndedTailBoundNotice)

	return faulted
end 'forwardEndedChildTail'

function childStreamsEnded(child StreamingSubprocess) returns bool
	return child.streamHasEnded(StdioStream.stdout) and child.streamHasEnded(StdioStream.stderr)
end 'childStreamsEnded'

function forwardUnendedChildOutput(child StreamingSubprocess, treeEnd TreeEnd, routing ChildOutputRouting) returns bool
	printError("{TreeNotEndedNotice}{treeEnd.displayReason()}\n")

	return forwardChildOutput(child, routing: routing, budget: ChildLineBudget.atMost(UnendedTailLines))
end 'forwardUnendedChildOutput'

export function endChild(child StreamingSubprocess, routing ChildOutputRouting) returns bool
	let faulted = endChildAndForwardTail(child, routing: routing)
	child.release()

	return faulted
end 'endChild'

// Everything past the FIRST `=` is the value, because a value may contain one of its own.
export function parseTargetEnv(raw String) returns TargetEnvParse
	let halves = raw.split(EnvAssignment)
	let name = try halves.get(0) otherwise panic("parseTargetEnv: a split answers at least one piece, even of an empty string")

	if name.isEmpty() or halves.count() < 2 'noName'
		return TargetEnvParse.malformed
	end 'noName'

	return TargetEnvParse.pair(name, value: targetEnvValueOf(halves))
end 'parseTargetEnv'

export function parsePositiveSeconds(raw String) returns TargetSecondsParse
	let seconds = try float.fromString(raw) otherwise 'notANumber'
		return TargetSecondsParse.refused
	end 'notANumber'

	return targetSecondsReading(seconds as AskedSeconds)
end 'parsePositiveSeconds'

export typealias AskedSeconds = float(f64.min to f64.max)

export function targetSecondsReading(seconds AskedSeconds) returns TargetSecondsParse
	if not (seconds >= (LeastTargetSeconds as AskedSeconds) and seconds <= (MaxTargetSeconds as AskedSeconds)) 'notAFiniteDurationOfAMillisecondOrMore'
		return TargetSecondsParse.refused
	end 'notAFiniteDurationOfAMillisecondOrMore'

	return TargetSecondsParse.reading(TargetSecondsReading.create(seconds as TargetSeconds))
end 'targetSecondsReading'

export function targetSecondsRange() returns String
	return "from {LeastTargetSeconds} to {MaxTargetSeconds:.0}"
end 'targetSecondsRange'

export function targetSecondsRefusal(named String) returns String
	return "{named} must be a number of seconds {targetSecondsRange()}"
end 'targetSecondsRefusal'

export function targetSecondsMisreadRefusal(named String, asked String) returns String
	return "{targetSecondsRefusal(named)}; {asked} is not"
end 'targetSecondsMisreadRefusal'

function childFaultLineSeen(text String) returns bool
	for kind in HardwareFaultKind.allCases 'eachKind'
		if text.contains(String.from(faultPanicLinePrefix(kind))) 'aFaultReport'
			return true
		end 'aFaultReport'
	end 'eachKind'

	return false
end 'childFaultLineSeen'

function targetEnvValueOf(halves StringArray) returns String
	var value = ""

	for (iter, piece) in halves.withIterator() 'eachPiece'
		if iter.index() == 0 'theName'
			continue
		end 'theName'

		value.append(piece if value.isEmpty() and iter.index() == 1 else "{EnvAssignment}{piece}")
	end 'eachPiece'

	return value
end 'targetEnvValueOf'

function withinBudget(budget ChildLineBudget, taken ChildLineTally) returns bool
	return match budget 'which'
		unbounded gives true
		atMost(lines) gives taken < lines
	end 'which'
end 'withinBudget'

function pollChildStreamLine(child StreamingSubprocess, stream ChildStream) returns LinePoll
	return match stream 'which'
		stdout gives try child.tryReadStdoutLine() otherwise panic("the child's stdout is out with a StdoutReader")
		stderr gives child.tryReadStderrLine()
	end 'which'
end 'pollChildStreamLine'

function readChildStreamLine(child StreamingSubprocess, stream ChildStream) returns String throws SubprocessError
	match stream 'which'
		stdout then return try child.readStdoutLine()
		stderr then return try child.readStderrLine()
	end 'which'
end 'readChildStreamLine'

function emitChildStreamLine(text String, stream ChildStream, routing ChildOutputRouting) returns bool
	match routing 'where'
		allToStandardError then printError("{text}\n")
		verbatim then emitChildLineVerbatim(text, stream: stream)
		collect(sink) then sink.record(text, stream: stream)
	end 'where'

	return childFaultLineSeen(text)
end 'emitChildStreamLine'

function emitChildLineVerbatim(text String, stream ChildStream)
	match stream 'which'
		stdout then print("{text}\n")
		stderr then printError("{text}\n")
	end 'which'
end 'emitChildLineVerbatim'
