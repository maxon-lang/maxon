export typealias DebugConditionWidth = int(1 to 8)

let ConditionWordSeparator = " "
let ConditionPathSeparator = "."
let ConditionWords = 3

let EqualSpelling = "=="
let NotEqualSpelling = "!="
let LessSpelling = "<"
let LessOrEqualSpelling = "<="
let GreaterSpelling = ">"
let GreaterOrEqualSpelling = ">="

let TrueSpelling = "true"
let FalseSpelling = "false"
let TrueWord = 1 as DebuggeeWord
let FalseWord = 0 as DebuggeeWord

let BoolTypeSpelling = "i1"
let DoubleTypeSpelling = "f64"
let SingleTypeSpelling = "f32"

let NegativeSign = "-"
let HexLiteralPrefix = "0x"

typealias LiteralBase = int(2 to 16)
typealias LiteralMagnitude = int(0 to u64.max)
typealias LiteralQuotient = int(1 to u64.max) implements LiteralMagnitude
typealias LiteralPattern = bits(64)

let HexLiteralBase = 16 as LiteralBase
let DecimalLiteralBase = 10 as LiteralBase
let MaxLiteralMagnitude = u64.max as LiteralMagnitude
let MaxNegatedLiteralMagnitude = 9223372036854775808 as LiteralMagnitude
let MaxSignedLiteralMagnitude = 9223372036854775807

let AsciiZero = 48
let AsciiNine = 57
let AsciiLowerA = 97
let AsciiLowerF = 102
let AsciiUpperA = 65
let AsciiUpperF = 70
let LetterDigitBase = 10

export type DebugConditionRecord
	export let operand as DebugConditionOperand
	export let width as DebugConditionWidth
	export let signedness as DebugConditionSignedness
	export let comparison as DebugConditionComparison
	export let literal as DebuggeeWord

	static function create(operand DebugConditionOperand, width DebugConditionWidth, signedness DebugConditionSignedness, comparison DebugConditionComparison, literal DebuggeeWord) returns DebugConditionRecord
		return Self{operand: operand, width: width, signedness: signedness, comparison: comparison, literal: literal}
	end 'create'
end 'DebugConditionRecord'

export union DebugConditionOperand
	register(number EngineRegisterNumber)
	stackSlot(offset DebuggeeWord)
end 'DebugConditionOperand'

export enum DebugConditionSignedness
	signed
	unsigned
end 'DebugConditionSignedness'

export enum DebugConditionComparison
	equal
	notEqual
	less
	lessOrEqual
	greater
	greaterOrEqual
end 'DebugConditionComparison'

let DbgWidthByte = 1
let DbgWidthHalf = 2
let DbgWidthWord32 = 4
let DbgWidthWord64 = 8

union ConditionOperandRead
	unreadable
	word(value DebuggeeWord)
end 'ConditionOperandRead'

// ⚠ Every road this cannot decide answers TRUE — an unreadable frame slot. A breakpoint the reader
// armed then stops on every hit, which is the recoverable direction: answering false would swallow
// the stop and read as a breakpoint that was never placed.
function debugConditionHolds(record DebugConditionRecord, memory DebugMemory, framePointer DebugAddress) returns bool
	match conditionOperandValue(record.operand, memory: memory, framePointer: framePointer) 'read'
		unreadable then return true
		word(raw) then return conditionCompare(narrowedToWidth(raw, width: record.width, signedness: record.signedness), literal: record.literal, comparison: record.comparison, signedness: record.signedness)
	end 'read'
end 'debugConditionHolds'

function conditionOperandValue(operand DebugConditionOperand, memory DebugMemory, framePointer DebugAddress) returns ConditionOperandRead
	return match operand 'located'
		register(number) gives ConditionOperandRead.word(memory.registerValue(number))
		stackSlot(offset) gives frameSlotValue(offset, memory: memory, framePointer: framePointer)
	end 'located'
end 'conditionOperandValue'

function frameSlotValue(offset DebuggeeWord, memory DebugMemory, framePointer DebugAddress) returns ConditionOperandRead
	let slot = (framePointer as DebuggeeWord) + offset

	if slot <= 0 'notAnAddressAtAll'
		return ConditionOperandRead.unreadable
	end 'notAnAddressAtAll'

	return ConditionOperandRead.word(try memory.readDebuggeeWord(slot as DebugAddress, width: DebuggeeWordBytes) otherwise return ConditionOperandRead.unreadable)
end 'frameSlotValue'

function narrowedToWidth(raw DebuggeeWord, width DebugConditionWidth, signedness DebugConditionSignedness) returns DebuggeeWord
	let masked = debugMaskedToWidth(raw, width: width as DebugWidth)

	return match signedness 'extended'
		signed gives debugSignExtended(masked, width: width as DebugWidth)
		unsigned gives masked
	end 'extended'
end 'narrowedToWidth'

function conditionCompare(value DebuggeeWord, literal DebuggeeWord, comparison DebugConditionComparison, signedness DebugConditionSignedness) returns bool
	return match comparison 'compared'
		equal gives value == literal
		notEqual gives value != literal
		less gives conditionIsBelow(value, than: literal, signedness: signedness)
		lessOrEqual gives not conditionIsBelow(literal, than: value, signedness: signedness)
		greater gives conditionIsBelow(literal, than: value, signedness: signedness)
		greaterOrEqual gives not conditionIsBelow(value, than: literal, signedness: signedness)
	end 'compared'
end 'conditionCompare'

function conditionIsBelow(a DebuggeeWord, than DebuggeeWord, signedness DebugConditionSignedness) returns bool
	return match signedness 'ordered'
		signed gives a < than
		unsigned gives unsignedIsBelow(a, than: than)
	end 'ordered'
end 'conditionIsBelow'

function unsignedIsBelow(a DebuggeeWord, than DebuggeeWord) returns bool
	if (a < 0) != (than < 0) 'oneHasTheTopBit'
		return than < 0
	end 'oneHasTheTopBit'

	return a < than
end 'unsignedIsBelow'

export union DebugConditionCompile
	compiled(record DebugConditionRecord)
	unsupported
	invalid
end 'DebugConditionCompile'

export union DebugConditionRequest
	none
	carried(record DebugConditionRecord)

	export function holds(memory DebugMemory, framePointer DebugAddress) returns bool
		return match self 'asked'
			none gives true
			carried(record) gives debugConditionHolds(record, memory: memory, framePointer: framePointer)
		end 'asked'
	end 'holds'
end 'DebugConditionRequest'

export union DebugBreakRequest
	plain(target String)
	conditional(target String, condition String)
end 'DebugBreakRequest'

export union DebugBreakCondition
	unconditional
	when(let text String)

	export function sameAs(other DebugBreakCondition) returns bool
		return match self 'own'
			unconditional gives not other.isConditional()
			when(text) gives other.isWhen(text)
		end 'own'
	end 'sameAs'

	export function isConditional() returns bool
		return match self 'own'
			unconditional gives false
			when gives true
		end 'own'
	end 'isConditional'

	function isWhen(text String) returns bool
		return match self 'own'
			unconditional gives false
			when(own) gives own == text
		end 'own'
	end 'isWhen'

	export function text() returns String throws AbsentError
		match self 'own'
			unconditional then throw AbsentError.absent
			when(text) then return text
		end 'own'
	end 'text'
end 'DebugBreakCondition'

export function debugBreakRequestIn(argument String, conditionWord String) returns DebugBreakRequest
	let pieces = argument.split(conditionWord)

	if pieces.count() < 2 'noCondition'
		return DebugBreakRequest.plain(argument.trim())
	end 'noCondition'

	let target = try pieces.get(0) otherwise panic("debugBreakRequestIn: a split into {pieces.count()} pieces has a first")

	return DebugBreakRequest.conditional(target.trim(), condition: conditionTailOf(pieces, conditionWord: conditionWord))
end 'debugBreakRequestIn'

function conditionTailOf(pieces StringArray, conditionWord String) returns String
	var tail = ""

	for (iter, piece) in pieces.withIterator() 'eachPiece'
		if iter.index() == 0 'theTarget'
			continue
		end 'theTarget'

		tail.append(piece if tail.isEmpty() else "{conditionWord}{piece}")
	end 'eachPiece'

	return tail.trim()
end 'conditionTailOf'

export function compileDebugCondition(symbols DebugSymbols, offset DebugAddress, site MxdbgInlineSiteLookup, text String) returns DebugConditionCompile
	let words = conditionWordsOf(text)

	if words.count() != ConditionWords 'notAThreePartComparison'
		return DebugConditionCompile.unsupported
	end 'notAThreePartComparison'

	let name = try words.get(0) otherwise panic("compileDebugCondition: a three-word comparison holds a first word")
	let opSpelling = try words.get(1) otherwise panic("compileDebugCondition: a three-word comparison holds a second word")
	let literalSpelling = try words.get(2) otherwise panic("compileDebugCondition: a three-word comparison holds a third word")

	if name.contains(ConditionPathSeparator) 'aFieldPath'
		return DebugConditionCompile.unsupported
	end 'aFieldPath'

	match conditionComparisonOf(opSpelling) 'known'
		none then return DebugConditionCompile.unsupported
		comparison(known) then return compiledAgainstName(symbols, offset: offset, site: site, name: name, comparison: known, literalSpelling: literalSpelling)
	end 'known'
end 'compileDebugCondition'

function compiledAgainstName(symbols DebugSymbols, offset DebugAddress, site MxdbgInlineSiteLookup, name String, comparison DebugConditionComparison, literalSpelling String) returns DebugConditionCompile
	let locals = symbols.localsAt(offset, site: site)

	match symbols.localCoveringIn(locals, offset: offset, name: name) 'known'
		undeclared or
		notLiveHere then return DebugConditionCompile.unsupported
		live(local) then return compiledAgainstLocal(symbols, local: local, comparison: comparison, literalSpelling: literalSpelling)
	end 'known'
end 'compiledAgainstName'

function compiledAgainstLocal(symbols DebugSymbols, local MxdbgLocalInfo, comparison DebugConditionComparison, literalSpelling String) returns DebugConditionCompile
	if local.isAConstant() or local.isAFoldedAggregate() or local.holdsAPointer() or local.locKind == MxdbgLocKindOptimizedOut 'nowhereTheDriverCanRead'
		return DebugConditionCompile.unsupported
	end 'nowhereTheDriverCanRead'

	if not symbols.typeIsDescribed(local.typeId) 'noLayout'
		return DebugConditionCompile.unsupported
	end 'noLayout'

	let record = symbols.typeRecordOf(local.typeId)
	let typeName = symbols.typeNameOf(local.typeId)

	if not comparesAsAWholeNumber(record, typeName: typeName) 'notAWholeNumber'
		return DebugConditionCompile.unsupported
	end 'notAWholeNumber'

	match conditionWidthOf(record) 'sized'
		none then return DebugConditionCompile.unsupported
		bytes(width) then return compiledWithWidth(local, signedness: DebugConditionSignedness.signed if record.isSigned() else DebugConditionSignedness.unsigned, comparison: comparison, width: width, literalSpelling: literalSpelling, isABool: typeName == BoolTypeSpelling)
	end 'sized'
end 'compiledAgainstLocal'

function compiledWithWidth(local MxdbgLocalInfo, signedness DebugConditionSignedness, comparison DebugConditionComparison, width DebugConditionWidth, literalSpelling String, isABool bool) returns DebugConditionCompile
	match conditionLiteralOf(literalSpelling, isABool: isABool) 'read'
		none then return DebugConditionCompile.invalid
		value(literal) then return compiledWithLiteral(local, signedness: signedness, comparison: comparison, width: width, literal: literal)

		// A signed compare reads the word as a negative, so it would stop on a value nobody wrote.
		aboveSignedRange(literal) then return compiledWithLiteral(local, signedness: signedness, comparison: comparison, width: width, literal: literal) if signedness == DebugConditionSignedness.unsigned else DebugConditionCompile.invalid
	end 'read'
end 'compiledWithWidth'

function compiledWithLiteral(local MxdbgLocalInfo, signedness DebugConditionSignedness, comparison DebugConditionComparison, width DebugConditionWidth, literal DebuggeeWord) returns DebugConditionCompile
	match conditionOperandOf(local) 'located'
		none then return DebugConditionCompile.unsupported
		operand(located) then return DebugConditionCompile.compiled(DebugConditionRecord.create(located, width: width, signedness: signedness, comparison: comparison, literal: literal))
	end 'located'
end 'compiledWithLiteral'

union ConditionOperandLookup
	none
	operand(let located DebugConditionOperand)
end 'ConditionOperandLookup'

function conditionOperandOf(local MxdbgLocalInfo) returns ConditionOperandLookup
	if local.locKind == MxdbgLocKindRegister 'aRegister'
		if local.locValue < 0 or local.locValue >= BackendGprSlots 'outsideTheGeneralFile'
			return ConditionOperandLookup.none
		end 'outsideTheGeneralFile'

		return ConditionOperandLookup.operand(DebugConditionOperand.register(local.locValue as EngineRegisterNumber))
	end 'aRegister'

	if local.locKind != MxdbgLocKindStackSlot 'notASlotEither'
		return ConditionOperandLookup.none
	end 'notASlotEither'

	return ConditionOperandLookup.operand(DebugConditionOperand.stackSlot(local.locValue as DebuggeeWord))
end 'conditionOperandOf'

function comparesAsAWholeNumber(record MxdbgTypeInfo, typeName String) returns bool
	if typeName == DoubleTypeSpelling or typeName == SingleTypeSpelling 'aRealNumber'
		return false
	end 'aRealNumber'

	return record.kind == MxdbgTypeKindPrimitive or record.kind == MxdbgTypeKindIntRanged or record.kind == MxdbgTypeKindEnum
end 'comparesAsAWholeNumber'

union ConditionWidthLookup
	none
	bytes(value DebugConditionWidth)
end 'ConditionWidthLookup'

function conditionWidthOf(record MxdbgTypeInfo) returns ConditionWidthLookup
	let size = record.size as DebugAddress

	if size == DbgWidthByte or size == DbgWidthHalf or size == DbgWidthWord32 or size == DbgWidthWord64 'aWidthTheDriverLoads'
		return ConditionWidthLookup.bytes(size as DebugConditionWidth)
	end 'aWidthTheDriverLoads'

	return ConditionWidthLookup.none
end 'conditionWidthOf'

union ConditionComparisonLookup
	none
	comparison(value DebugConditionComparison)
end 'ConditionComparisonLookup'

function conditionComparisonOf(spelling String) returns ConditionComparisonLookup
	if spelling == EqualSpelling 'equal'
		return ConditionComparisonLookup.comparison(DebugConditionComparison.equal)
	end 'equal'

	if spelling == NotEqualSpelling 'notEqual'
		return ConditionComparisonLookup.comparison(DebugConditionComparison.notEqual)
	end 'notEqual'

	if spelling == LessSpelling 'less'
		return ConditionComparisonLookup.comparison(DebugConditionComparison.less)
	end 'less'

	if spelling == LessOrEqualSpelling 'lessOrEqual'
		return ConditionComparisonLookup.comparison(DebugConditionComparison.lessOrEqual)
	end 'lessOrEqual'

	if spelling == GreaterSpelling 'greater'
		return ConditionComparisonLookup.comparison(DebugConditionComparison.greater)
	end 'greater'

	if spelling == GreaterOrEqualSpelling 'greaterOrEqual'
		return ConditionComparisonLookup.comparison(DebugConditionComparison.greaterOrEqual)
	end 'greaterOrEqual'

	return ConditionComparisonLookup.none
end 'conditionComparisonOf'

union ConditionLiteralLookup
	none
	value(word DebuggeeWord)
	aboveSignedRange(word DebuggeeWord)
end 'ConditionLiteralLookup'

union ConditionMagnitudeLookup
	none
	value(magnitude LiteralMagnitude)
end 'ConditionMagnitudeLookup'

function conditionLiteralOf(spelling String, isABool bool) returns ConditionLiteralLookup
	if isABool 'aFlag'
		if spelling == TrueSpelling 'itIsTrue'
			return ConditionLiteralLookup.value(TrueWord)
		end 'itIsTrue'

		if spelling == FalseSpelling 'itIsFalse'
			return ConditionLiteralLookup.value(FalseWord)
		end 'itIsFalse'
	end 'aFlag'

	let negative = spelling.startsWith(NegativeSign)
	let digits = spelling.replaceFirst(NegativeSign, with: "") if negative else spelling

	match unsignedLiteralOf(digits) 'read'
		none then return ConditionLiteralLookup.none
		value(magnitude) then return conditionLiteralOfMagnitude(magnitude, negative: negative)
	end 'read'
end 'conditionLiteralOf'

function conditionLiteralOfMagnitude(magnitude LiteralMagnitude, negative bool) returns ConditionLiteralLookup
	let word = (magnitude as LiteralPattern) as DebuggeeWord

	if negative 'belowZero'
		return ConditionLiteralLookup.value(0 - word) if magnitude <= MaxNegatedLiteralMagnitude else ConditionLiteralLookup.none
	end 'belowZero'

	return ConditionLiteralLookup.value(word) if magnitude <= MaxSignedLiteralMagnitude else ConditionLiteralLookup.aboveSignedRange(word)
end 'conditionLiteralOfMagnitude'

function unsignedLiteralOf(spelling String) returns ConditionMagnitudeLookup
	let hex = spelling.startsWith(HexLiteralPrefix)
	let base = HexLiteralBase if hex else DecimalLiteralBase
	let digits = spelling.replaceFirst(HexLiteralPrefix, with: "") if hex else spelling

	if digits.isEmpty() 'nothingToRead'
		return ConditionMagnitudeLookup.none
	end 'nothingToRead'

	var value = 0 as LiteralMagnitude

	for character in digits 'eachDigit'
		match nextLiteralValue(value, character: character, base: base) 'read'
			none then return ConditionMagnitudeLookup.none
			value(next) then value = next
		end 'read'
	end 'eachDigit'

	return ConditionMagnitudeLookup.value(value)
end 'unsignedLiteralOf'

function nextLiteralValue(value LiteralMagnitude, character Character, base LiteralBase) returns ConditionMagnitudeLookup
	match literalDigitOf(character, base: base) 'read'
		none then return ConditionMagnitudeLookup.none
		digit(read) then return ConditionMagnitudeLookup.value(value * (base as LiteralMagnitude) + read) if value <= ((MaxLiteralMagnitude - read) as LiteralQuotient) / (base as LiteralQuotient) else ConditionMagnitudeLookup.none
	end 'read'
end 'nextLiteralValue'

union ConditionDigitLookup
	none
	digit(read LiteralMagnitude)
end 'ConditionDigitLookup'

function literalDigitOf(character Character, base LiteralBase) returns ConditionDigitLookup
	let code = try character.asciiValue() otherwise return ConditionDigitLookup.none
	var read = 0 as LiteralMagnitude

	if code >= AsciiZero and code <= AsciiNine 'aDecimalDigit'
		read = (code - AsciiZero) as LiteralMagnitude
	end 'aDecimalDigit' else if code >= AsciiLowerA and code <= AsciiLowerF 'aLowerCaseLetter'
		read = ((code - AsciiLowerA) as LiteralMagnitude) + LetterDigitBase
	end 'aLowerCaseLetter' else if code >= AsciiUpperA and code <= AsciiUpperF 'anUpperCaseLetter'
		read = ((code - AsciiUpperA) as LiteralMagnitude) + LetterDigitBase
	end 'anUpperCaseLetter' else 'notADigitAtAll'
		return ConditionDigitLookup.none
	end 'notADigitAtAll'

	return ConditionDigitLookup.digit(read) if read < (base as LiteralMagnitude) else ConditionDigitLookup.none
end 'literalDigitOf'

function conditionWordsOf(text String) returns StringArray
	var words = StringArray.create()

	for piece in text.trim().split(ConditionWordSeparator) 'eachPiece'
		if not piece.isEmpty() 'aWord'
			words.push(piece)
		end 'aWord'
	end 'eachPiece'

	return words
end 'conditionWordsOf'
