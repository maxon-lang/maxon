export typealias DebugWidth = int(1 to 8)
module typealias DebugBitShift = int(0 to 63)

let DebugByteBits = 8
module let DebugWordBytes = 8 as DebugWidth
module let DebugUserSpaceLimit = 0x0000800000000000 as DebugWord

let DebugSignBearingByteValue = 128
let DebugByteModulus = 256

export union DebugBytesRead
	pastTheBytes
	read(value DebugWord)
end 'DebugBytesRead'

export union DebugUserSpaceAddress
	unresolved
	at(address DebugAddress)
end 'DebugUserSpaceAddress'

// An eight-byte read is signed, the only reading a `DebugWord` can hold. A narrower one is unsigned,
// for `debugSignExtended` to widen when its type is signed.
module function debugLittleEndianAt(bytes ByteArray, at DebugAddress, width DebugWidth) returns DebugBytesRead
	let available = bytes.count() as DebugAddress

	if at > available or (width as DebugAddress) > available - at 'pastTheEnd'
		return DebugBytesRead.pastTheBytes
	end 'pastTheEnd'

	var value = 0 as DebugWord

	for i in 0 upto width 'eachByte'
		let byte = (try bytes.get(at + (i as DebugAddress)) otherwise panic("debugLittleEndianAt: byte {at} + {i} was bounds-checked against {bytes.count()} bytes")) as DebugWord
		let weight = (1 as DebugWord) shl ((i * DebugByteBits) as DebugBitShift)

		if i + 1 == DebugWordBytes and byte >= DebugSignBearingByteValue 'theWordsSignByte'
			value = value + (byte - DebugByteModulus) * weight
			continue
		end 'theWordsSignByte'

		value = value + byte * weight
	end 'eachByte'

	return DebugBytesRead.read(value)
end 'debugLittleEndianAt'

module function debugSignExtended(value DebugWord, width DebugWidth) returns DebugWord
	if width >= DebugWordBytes 'theWordCarriesItsSign'
		return value
	end 'theWordCarriesItsSign'

	let signBit = (1 as DebugWord) shl ((width * DebugByteBits - 1) as DebugBitShift)

	return value - signBit * 2 if value >= signBit else value
end 'debugSignExtended'

module function debugMaskedToWidth(value DebugWord, width DebugWidth) returns DebugWord
	if width >= DebugWordBytes 'theWholeWord'
		return value
	end 'theWholeWord'

	return value and (((1 as DebugWord) shl ((width * DebugByteBits) as DebugBitShift)) - 1)
end 'debugMaskedToWidth'

module function debugUserSpaceAddress(value DebugWord) returns DebugUserSpaceAddress
	if value < 0 or value >= DebugUserSpaceLimit 'notAUserSpaceAddress'
		return DebugUserSpaceAddress.unresolved
	end 'notAUserSpaceAddress'

	return DebugUserSpaceAddress.at(value as DebugAddress)
end 'debugUserSpaceAddress'
