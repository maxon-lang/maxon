export typealias DebugAddress = int(0 to u64.max)
export typealias DebugAddressArray = Array with DebugAddress
export typealias DebugLineNumber = int(1 to u32.max)
export typealias DebugColumnNumber = int(1 to u32.max)
export typealias DebugWireNumber = int(0 to u32.max)
export typealias DebugFrameNumber = int(0 to u32.max)
export typealias DebugTally = int(0 to u32.max) implements ElementIndex
export typealias DebugExitCode = int(i64.min to i64.max)

// Signed, although a debuggee word is not: the range is what the debuggee's own `int(0 to u64.max)` is
// stored in, and a word with its top bit set fails the check on the way into an unsigned alias.
export typealias DebuggeeWord = int(i64.min to i64.max)

export function debugAddressOrZero(word DebuggeeWord) returns DebugAddress
	return 0 if word < 0 else word as DebugAddress
end 'debugAddressOrZero'

export typealias DebugThreadId = int(1 to u32.max)

export let LowestDebugThreadId = 1 as DebugThreadId

export union DebugRegisterAccess
	readable
	unavailable(reason String)
end 'DebugRegisterAccess'

export union DebugThreadRef
	none
	id(value DebugThreadId)
end 'DebugThreadRef'

export function debugNamePhrase(name DebugFunctionNameLookup, lead String) returns String
	return match name 'known'
		none gives ""
		named(spelled) gives "{lead}{spelled}"
	end 'known'
end 'debugNamePhrase'

export type DebugThreadRow
	export var id as DebugThreadId
	export var status as String
	export var functionName as DebugFunctionNameLookup
	export var file as DebugFileName
	export var line as DebugLineLookup
	export var handle as DebugAddress

	export static function create(id DebugThreadId, status String, functionName DebugFunctionNameLookup, file DebugFileName, line DebugLineLookup, handle DebugAddress) returns DebugThreadRow
		return Self{id: id, status: status, functionName: functionName, file: file, line: line, handle: handle}
	end 'create'
end 'DebugThreadRow'

export typealias DebugThreadRowArray = Array with DebugThreadRow

export type DebugThreadRoster
	export var rows as DebugThreadRowArray
	export var truncated as bool
	export var availability as DebugAvailability

	export static function listed(rows DebugThreadRowArray, truncated bool) returns DebugThreadRoster
		return Self{rows: rows, truncated: truncated, availability: DebugAvailability.available}
	end 'listed'

	export static function missing(reason String) returns DebugThreadRoster
		return Self{rows: DebugThreadRowArray.create(), truncated: false, availability: DebugAvailability.unavailable(reason)}
	end 'missing'
end 'DebugThreadRoster'

export type DebugThreadOutcome
	export var event as String
	export var thread as DebugThreadRef
	export var result as String
	export var reason as StatedText

	export static function create(event String, thread DebugThreadRef, result String, reason StatedText) returns DebugThreadOutcome
		return Self{event: event, thread: thread, result: result, reason: reason}
	end 'create'
end 'DebugThreadOutcome'

export type DebugThreadWalk
	export var thread as DebugThreadRef
	export var frames as DebugFrameArray
	export var availability as DebugAvailability

	export static function walked(thread DebugThreadRef, frames DebugFrameArray) returns DebugThreadWalk
		return Self{thread: thread, frames: frames, availability: DebugAvailability.available}
	end 'walked'

	export static function missing(thread DebugThreadRef, reason String) returns DebugThreadWalk
		return Self{thread: thread, frames: DebugFrameArray.create(), availability: DebugAvailability.unavailable(reason)}
	end 'missing'
end 'DebugThreadWalk'

export type DebugTraceEvent
	export var seq as DebugAddress
	export var kind as String
	export var text as String

	export static function create(seq DebugAddress, kind String, text String) returns DebugTraceEvent
		return Self{seq: seq, kind: kind, text: text}
	end 'create'
end 'DebugTraceEvent'

export typealias DebugTraceEventArray = Array with DebugTraceEvent

export union DebugTraceSince
	none
	at(position DebugAddress)
end 'DebugTraceSince'

export type DebugTraceSlice
	export var events as DebugTraceEventArray
	export var since as DebugTraceSince
	export var availability as DebugAvailability

	export static function taken(events DebugTraceEventArray, since DebugTraceSince) returns DebugTraceSlice
		return Self{events: events, since: since, availability: DebugAvailability.available}
	end 'taken'

	export static function missing(reason String) returns DebugTraceSlice
		return Self{events: DebugTraceEventArray.create(), since: DebugTraceSince.none, availability: DebugAvailability.unavailable(reason)}
	end 'missing'
end 'DebugTraceSlice'

export type DebugSourceLine
	export var line as DebugLineNumber
	export var text as String
	export var current as bool

	export static function create(line DebugLineNumber, text String, current bool) returns DebugSourceLine
		return Self{line: line, text: text, current: current}
	end 'create'
end 'DebugSourceLine'

export typealias DebugSourceLineArray = Array with DebugSourceLine

let UnknownWireNumber = 0 as DebugWireNumber

export union DebugLineLookup
	unknown
	line(number DebugLineNumber)

	export function wireNumber() returns DebugWireNumber
		return match self 'lookup'
			unknown gives UnknownWireNumber
			line(number) gives number as DebugWireNumber
		end 'lookup'
	end 'wireNumber'
end 'DebugLineLookup'

export union DebugSourceSpot
	unknown
	at(line DebugLineNumber, column DebugColumnNumber)

	export function lineLookup() returns DebugLineLookup
		return match self 'spot'
			unknown gives DebugLineLookup.unknown
			at(line, _) gives DebugLineLookup.line(line)
		end 'spot'
	end 'lineLookup'

	export function wireLine() returns DebugWireNumber
		return match self 'spot'
			unknown gives UnknownWireNumber
			at(line, _) gives line as DebugWireNumber
		end 'spot'
	end 'wireLine'

	export function wireColumn() returns DebugWireNumber
		return match self 'spot'
			unknown gives UnknownWireNumber
			at(_, column) gives column as DebugWireNumber
		end 'spot'
	end 'wireColumn'
end 'DebugSourceSpot'

export union DebugSourcePath
	unknown
	file(path String)

	export function filePath() returns String throws AbsentError
		match self 'path'
			unknown then throw AbsentError.absent
			file(path) then return path
		end 'path'
	end 'filePath'

	export function fileName() returns DebugFileName
		return match self 'path'
			unknown gives DebugFileName.unknown
			file(path) gives DebugFileName.named(baseNameOf(path))
		end 'path'
	end 'fileName'
end 'DebugSourcePath'

export union DebugFileName
	unknown
	named(name String)

	export function wireName() returns String
		return match self 'file'
			unknown gives UnknownWireFileName
			named(name) gives name
		end 'file'
	end 'wireName'
end 'DebugFileName'

let UnknownWireFileName = ""

export type DebugFrame
	export var number as DebugFrameNumber
	export var functionName as String
	export var path as DebugSourcePath
	export var spot as DebugSourceSpot
	export var offset as DebugAddress
	export var inlined as bool
	export var site as MxdbgInlineSiteLookup
	export var framePointer as DebugAddress

	export static function create(number DebugFrameNumber, functionName String, path DebugSourcePath, spot DebugSourceSpot, offset DebugAddress, inlined bool, site MxdbgInlineSiteLookup, framePointer DebugAddress) returns DebugFrame
		return Self{number: number, functionName: functionName, path: path, spot: spot, offset: offset, inlined: inlined, site: site, framePointer: framePointer}
	end 'create'
end 'DebugFrame'

export typealias DebugFrameArray = Array with DebugFrame

export type DebugStop
	export var reason as String
	export var fault as StatedText
	export var functionName as DebugFunctionNameLookup
	export var file as DebugFileName
	export var spot as DebugSourceSpot
	export var offset as DebugAddress
	export var source as DebugSourceLineArray
	export var frames as DebugFrameArray
	export var machine as DebugAddress
	export var thread as DebugThreadRef

	export static function create(reason String, fault StatedText, functionName DebugFunctionNameLookup, file DebugFileName, spot DebugSourceSpot, offset DebugAddress, source DebugSourceLineArray, frames DebugFrameArray, machine DebugAddress, thread DebugThreadRef) returns DebugStop
		return Self{reason: reason, fault: fault, functionName: functionName, file: file, spot: spot, offset: offset, source: source, frames: frames, machine: machine, thread: thread}
	end 'create'
end 'DebugStop'

export union DebugAvailability
	available
	unavailable(reason String)

	export function reason() returns String throws AbsentError
		match self 'availability'
			available then throw AbsentError.absent
			unavailable(reason) then return reason
		end 'availability'
	end 'reason'
end 'DebugAvailability'

export typealias DebugValueIndex = int(0 to u32.max) implements ElementIndex
export typealias DebugValueIndexArray = Array with DebugValueIndex

export type DebugValueNode
	export var name as String
	export var typeName as String
	export var kind as String
	export var display as String
	export var availability as DebugAvailability
	export var children as DebugValueIndexArray

	export static function create(name String, typeName String, kind String, display String, availability DebugAvailability, children DebugValueIndexArray) returns DebugValueNode
		return Self{name: name, typeName: typeName, kind: kind, display: display, availability: availability, children: children}
	end 'create'

	export static function rendered(name String, typeName String, kind String, display String) returns DebugValueNode
		return Self{name: name, typeName: typeName, kind: kind, display: display, availability: DebugAvailability.available, children: DebugValueIndexArray.create()}
	end 'rendered'

	export static function withChildren(name String, typeName String, kind String, display String, children DebugValueIndexArray) returns DebugValueNode
		return Self{name: name, typeName: typeName, kind: kind, display: display, availability: DebugAvailability.available, children: children}
	end 'withChildren'

	export static function missing(name String, typeName String, kind String, reason String) returns DebugValueNode
		return Self{name: name, typeName: typeName, kind: kind, display: "", availability: DebugAvailability.unavailable(reason), children: DebugValueIndexArray.create()}
	end 'missing'
end 'DebugValueNode'

export typealias DebugValueNodeArray = Array with DebugValueNode

export type DebugValueTree
	export var nodes as DebugValueNodeArray
	export var roots as DebugValueIndexArray

	export static function create() returns DebugValueTree
		return Self{nodes: DebugValueNodeArray.create(), roots: DebugValueIndexArray.create()}
	end 'create'

	export function add(node DebugValueNode) returns ElementIndex
		self.nodes.push(node)

		return (self.nodes.count() - 1) as ElementIndex
	end 'add'

	export function nodeAt(index ElementIndex) returns DebugValueNode
		return try self.nodes.get(index) otherwise panic("DebugValueTree.nodeAt: index {index} is past the {self.nodes.count()} nodes this tree holds")
	end 'nodeAt'
end 'DebugValueTree'

export type DebugBreakpointAnswer
	export var action as String
	export var target as String
	export var functionName as DebugFunctionNameLookup
	export var file as DebugFileName
	export var line as DebugLineLookup
	export var offsets as DebugAddressArray
	export var candidates as StringArray
	export var suggestion as StatedText
	export var reason as StatedText
	export var condition as DebugBreakCondition

	export static function create(action String, target String, functionName DebugFunctionNameLookup, file DebugFileName, line DebugLineLookup, offsets DebugAddressArray, candidates StringArray, suggestion StatedText, reason StatedText, condition DebugBreakCondition = DebugBreakCondition.unconditional) returns DebugBreakpointAnswer
		return Self{action: action, target: target, functionName: functionName, file: file, line: line, offsets: offsets, candidates: candidates, suggestion: suggestion, reason: reason, condition: condition}
	end 'create'
end 'DebugBreakpointAnswer'

export union DebugReply
	breakpoint(answer DebugBreakpointAnswer)
	stopped(stop DebugStop)
	walked(frames DebugFrameArray)
	locals(functionName DebugFunctionNameLookup, values DebugValueTree)
	value(tree DebugValueTree)
	exited(code DebugExitCode)
	crashed(status DebugAddress)
	threads(roster DebugThreadRoster)
	threadWalked(walk DebugThreadWalk)
	threadOutcome(outcome DebugThreadOutcome)
	traced(slice DebugTraceSlice)
	timedOut(waitingFor String)
	running
	failed(message String, suggestion StatedText)
	spoken(lines StringArray)
	quit
end 'DebugReply'

export typealias DebugReplyArray = Array with DebugReply
