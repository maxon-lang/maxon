let FrameIndent = "  "
let InFunctionLead = " in "
let ValueIndent = "    "

export function debugTextLinesFor(reply DebugReply) returns StringArray
	var lines = StringArray.create()

	match reply 'which'
		quit then lines.push("quit")
		spoken(spokenLines) then appendSpoken(lines, spokenLines: spokenLines)
		breakpoint(answer) then lines.push(breakpointText(answer))
		stopped(stop) then appendStop(lines, stop: stop)
		walked(frames) then appendFrames(lines, frames: frames)
		locals(functionName, values) then appendLocals(lines, functionName: functionName, values: values)
		value(tree) then appendRoots(lines, tree: tree, indent: "")
		exited(code) then lines.push("the program exited with code {code}")
		crashed(status) then lines.push("the program crashed with status {hexWord(status)}")
		threads(roster) then appendThreads(lines, roster: roster)
		threadWalked(walk) then appendThreadWalk(lines, walk: walk)
		threadOutcome(outcome) then lines.push(threadOutcomeText(outcome))
		traced(slice) then appendTrace(lines, slice: slice)
		timedOut(waitingFor) then lines.push("timed out waiting for {waitingFor}")
		running then lines.push("the program is running")
		failed(message, suggestion) then lines.push(errorText(message, suggestion: suggestion))
	end 'which'

	return lines
end 'debugTextLinesFor'

function appendThreads(lines StringArray, roster DebugThreadRoster)
	if let reason = try roster.availability.reason() 'nothingToList'
		lines.push("no green-thread roster: {reason}")

		return
	end 'nothingToList'

	for row in roster.rows 'eachRow'
		lines.push("{FrameIndent}#{row.id} {row.status}{debugNamePhrase(row.functionName, lead: " ")} at {row.file.wireName()}:{row.line.wireNumber()}")
	end 'eachRow'

	if roster.truncated 'moreThanThePageHolds'
		lines.push("{FrameIndent}… the roster is truncated")
	end 'moreThanThePageHolds'
end 'appendThreads'

function appendThreadWalk(lines StringArray, walk DebugThreadWalk)
	if let reason = try walk.availability.reason() 'nothingToWalk'
		lines.push("no stack for {threadName(walk.thread)}: {reason}")

		return
	end 'nothingToWalk'

	lines.push("stack of {threadName(walk.thread)}:")
	appendFrames(lines, frames: walk.frames)
end 'appendThreadWalk'

function threadOutcomeText(outcome DebugThreadOutcome) returns String
	let reason = try outcome.reason.text() otherwise return "{outcome.event} {threadName(outcome.thread)}: {outcome.result}"
	return "{outcome.event} {threadName(outcome.thread)}: {outcome.result} ({reason})"
end 'threadOutcomeText'

function threadName(thread DebugThreadRef) returns String
	return match thread 'named'
		none gives "no thread"
		id(value) gives "thread #{value}"
	end 'named'
end 'threadName'

function appendTrace(lines StringArray, slice DebugTraceSlice)
	if let reason = try slice.availability.reason() 'nothingToShow'
		lines.push("no trace: {reason}")

		return
	end 'nothingToShow'

	for event in slice.events 'eachEvent'
		lines.push("{FrameIndent}{event.seq} {event.kind} {event.text}")
	end 'eachEvent'
end 'appendTrace'

function appendSpoken(lines StringArray, spokenLines StringArray)
	for spoken in spokenLines 'eachLine'
		lines.push(spoken)
	end 'eachLine'
end 'appendSpoken'

function breakpointText(answer DebugBreakpointAnswer) returns String
	if answer.action == BreakpointAmbiguousAction 'moreThanOneName'
		return "'{answer.target}' is ambiguous: it names {joinedWith(answer.candidates, separator: CandidateSeparator)}"
	end 'moreThanOneName'

	if answer.action == BreakpointNoMatchAction 'nothingAnswersToIt'
		return "'{answer.target}' names no function{suggestionTail(answer.suggestion)}"
	end 'nothingAnswersToIt'

	if answer.action == BreakpointRefusedAction 'refused'
		let reason = try answer.reason.text() otherwise panic("breakpointText: a refused breakpoint answer carries no reason")
		return "breakpoint at {answer.file.wireName()}:{answer.line.wireNumber()} refused ({reason})"
	end 'refused'

	if answer.action == BreakpointNoCodeAction 'noCodeThere'
		return "no code at {answer.file.wireName()}:{answer.line.wireNumber()}"
	end 'noCodeThere'

	if answer.action == BreakpointConditionUnsupportedAction 'aConditionTheDebuggerCannotJudge'
		let condition = refusedConditionText(answer)
		return "breakpoint at {answer.file.wireName()}:{answer.line.wireNumber()} not set: the debugger cannot evaluate `{condition}`, which must compare one integer or bool local held in a register or a frame slot with a literal"
	end 'aConditionTheDebuggerCannotJudge'

	if answer.action == BreakpointConditionInvalidAction 'notACondition'
		return "breakpoint at {answer.file.wireName()}:{answer.line.wireNumber()} not set: `{refusedConditionText(answer)}` is not `<local> <op> <literal>`"
	end 'notACondition'

	return "breakpoint {answer.action} at {answer.file.wireName()}:{answer.line.wireNumber()}{debugNamePhrase(answer.functionName, lead: " in ")} ({answer.offsets.count()} site(s))"
end 'breakpointText'

function refusedConditionText(answer DebugBreakpointAnswer) returns String
	return try answer.condition.text() otherwise panic("breakpointText: a breakpoint refused for its condition carries none")
end 'refusedConditionText'

function suggestionTail(suggestion StatedText) returns String
	return match suggestion 'suggestion'
		unstated gives ""
		stated(name) gives " — did you mean '{name}'?"
	end 'suggestion'
end 'suggestionTail'

function appendStop(lines StringArray, stop DebugStop)
	lines.push(stopHeadline(stop))

	for row in stop.source 'eachSourceLine'
		lines.push("{"->" if row.current else "  "} {row.line}\t{row.text}")
	end 'eachSourceLine'
end 'appendStop'

function stopHeadline(stop DebugStop) returns String
	if stop.reason == TrapStopReasonName 'anInt3NobodyPlanted'
		return "trap at {stop.file.wireName()}:{stop.spot.wireLine()} ({hexWord(stop.offset)})"
	end 'anInt3NobodyPlanted'

	if stop.reason == FaultStopReasonName 'theProgramFaulted'
		return "fault at {stop.file.wireName()}:{stop.spot.wireLine()}{debugNamePhrase(stop.functionName, lead: InFunctionLead)}: {try stop.fault.text() otherwise panic("stopHeadline: a fault stop carries its fault's description")} ({hexWord(stop.offset)}); continuing ends the program"
	end 'theProgramFaulted'

	return "stopped ({stop.reason}) at {stop.file.wireName()}:{stop.spot.wireLine()}{debugNamePhrase(stop.functionName, lead: InFunctionLead)}"
end 'stopHeadline'

function appendFrames(lines StringArray, frames DebugFrameArray)
	for frame in frames 'eachFrame'
		lines.push("{FrameIndent}#{frame.number} {frame.functionName}{inlinedTail(frame.inlined)} {frameWhere(frame)}")
	end 'eachFrame'
end 'appendFrames'

function frameWhere(frame DebugFrame) returns String
	return match frame.path 'path'
		unknown gives UnknownPositionText
		file gives "at {frame.path.fileName().wireName()}:{frame.spot.wireLine()}"
	end 'path'
end 'frameWhere'

let UnknownPositionText = "at an unknown position"

function inlinedTail(inlined bool) returns String
	return " [inlined]" if inlined else ""
end 'inlinedTail'

function appendLocals(lines StringArray, functionName DebugFunctionNameLookup, values DebugValueTree)
	lines.push("locals{debugNamePhrase(functionName, lead: " of ")}:")
	appendRoots(lines, tree: values, indent: ValueIndent)
end 'appendLocals'

function appendRoots(lines StringArray, tree DebugValueTree, indent String)
	for root in tree.roots 'eachRoot'
		appendValue(lines, tree: tree, index: root, indent: indent)
	end 'eachRoot'
end 'appendRoots'

function appendValue(lines StringArray, tree DebugValueTree, index ElementIndex, indent String)
	let value = tree.nodeAt(index)
	lines.push("{indent}{value.name} : {value.typeName} = {valueText(value)}")

	for child in value.children 'eachChild'
		appendValue(lines, tree: tree, index: child, indent: "{indent}{ValueIndent}")
	end 'eachChild'
end 'appendValue'

function valueText(value DebugValueNode) returns String
	return match value.availability 'availability'
		available gives value.display
		unavailable(reason) gives "<{reason}>"
	end 'availability'
end 'valueText'

let CandidateSeparator = ", "

function errorText(message String, suggestion StatedText) returns String
	return "error: {message}{suggestionTail(suggestion)}"
end 'errorText'
