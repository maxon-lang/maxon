export union TargetOutcome
	running
	exited(code DebugExitCode)
	crashed(status DebugAddress)
	terminated
end 'TargetOutcome'

export union TargetSettling
	// ⭐ The debug interface is the only thing that sees the child stop and the only thing that sees it end,
	// so the status arrives from there rather than from a liveness poll: a poll that reaped the child would
	// take the debugger's own notification with it.
	exitedWith(code DebugExitCode)
	polled
	reaped
	killed
	letGo
end 'TargetSettling'

let WindowsExitCodeMask = 0xFFFFFFFF
let NtStatusSeverityMask = 0xC0000000

export type DebugTarget
	var child as StreamingSubprocess
	let routing as ChildOutputRouting
	var faulted as bool
	var settled as TargetOutcome

	export static function launchTraced(program FilePath, arguments StringArray, workingDirectory FilePath, environment EnvMap, routing ChildOutputRouting) returns DebugTarget throws SubprocessError
		var spawned = try StreamingSubprocess.spawnTraceable(Executable.path(program), arguments: arguments, workingDirectory: workingDirectory, environment: Environment.inheritUpdating(environment), traced: true)
		spawned.closeStdin()

		return Self{child: spawned, routing: routing, faulted: false, settled: TargetOutcome.running}
	end 'launchTraced'

	export function processId() returns Pid
		return try self.child.processId() otherwise panic("DebugTarget.processId: the program was spawned by this target and its handle is released only when it is settled, so the spawn recorded a process id for it")
	end 'processId'

	export function pump()
		self.faulted = forwardChildOutput(self.child, routing: self.routing, budget: ChildLineBudget.unbounded) or self.faulted
	end 'pump'

	export function settle(how TargetSettling) returns TargetOutcome
		if not targetIsRunning(self.settled) 'alreadySettled'
			return self.settled
		end 'alreadySettled'

		match how 'how'
			exitedWith(code) then self.settleAfterExit(code)
			polled then self.settleIfItExited()
			reaped then self.settleEvenIfRunning()
			killed then self.settleAfterKill()
			letGo then self.releasedRunning()
		end 'how'

		return self.settled
	end 'settle'

	function settleIfItExited()
		match self.child.pollExit() 'polled'
			exited(code) then self.settleAfterExit(code as DebugExitCode)
			running then return
		end 'polled'
	end 'settleIfItExited'

	function settleEvenIfRunning()
		self.settleIfItExited()

		if targetIsRunning(self.settled) 'itIsEndedHere'
			self.settleAfterKill()
		end 'itIsEndedHere'
	end 'settleEvenIfRunning'

	function releasedRunning()
		self.pump()
		self.child.release()
	end 'releasedRunning'

	function settleAfterExit(code DebugExitCode)
		self.faulted = forwardChildTail(self.child, routing: self.routing) or self.faulted
		self.child.release()
		self.settled = self.outcomeOf(code)
	end 'settleAfterExit'

	function settleAfterKill()
		self.faulted = endChild(self.child, routing: self.routing) or self.faulted
		self.settled = TargetOutcome.terminated
	end 'settleAfterKill'

	// A faulting Maxon program is handled by its own vectored handler and exits 1, so an exit code alone
	// cannot tell a crash from an ordinary failure. Either half answers: the NTSTATUS severity bits a
	// process killed by the kernel carries, or the runtime's own fault line seen on the child's stderr.
	function outcomeOf(code DebugExitCode) returns TargetOutcome
		let masked = (code and WindowsExitCodeMask) as DebugAddress

		if self.faulted or (masked and NtStatusSeverityMask) == NtStatusSeverityMask 'aHardwareFault'
			return TargetOutcome.crashed(masked)
		end 'aHardwareFault'

		return TargetOutcome.exited(code)
	end 'outcomeOf'
end 'DebugTarget'

export function targetIsRunning(outcome TargetOutcome) returns bool
	return match outcome 'which'
		running gives true
		exited gives false
		crashed gives false
		terminated gives false
	end 'which'
end 'targetIsRunning'
