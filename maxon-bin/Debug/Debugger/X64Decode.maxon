let MovByteImmediateHigh = 0xB7 as X64ByteValue
let MovWordImmediateLow = 0xB8 as X64ByteValue
let MovWordImmediateHigh = 0xBF as X64ByteValue
let ShiftByImm8Byte = 0xC0 as X64ByteValue
let ShiftByImm8Word = 0xC1 as X64ByteValue
let NearReturnImm16 = 0xC2 as X64ByteValue
let NearReturn = 0xC3 as X64ByteValue
let MovByteModRmImm8 = 0xC6 as X64ByteValue
let MovWordModRmImm32 = 0xC7 as X64ByteValue
let Leave = 0xC9 as X64ByteValue
let Int3 = 0xCC as X64ByteValue
let ShiftByOneByte = 0xD0 as X64ByteValue
let ShiftByClWord = 0xD3 as X64ByteValue
let CallRel32 = 0xE8 as X64ByteValue
let JmpRel32 = 0xE9 as X64ByteValue
let JmpRel8 = 0xEB as X64ByteValue
let Hlt = 0xF4 as X64ByteValue
let GroupThreeByte = 0xF6 as X64ByteValue
let GroupThreeWord = 0xF7 as X64ByteValue
let GroupFourByte = 0xFE as X64ByteValue
let GroupFive = 0xFF as X64ByteValue

let Syscall = 0x05 as X64ByteValue
let Ud2 = 0x0B as X64ByteValue
let PrefetchWrite = 0x0D as X64ByteValue
let VectorMoveLow = 0x10 as X64ByteValue
let VectorMoveHigh = 0x17 as X64ByteValue
let PrefetchGroup = 0x18 as X64ByteValue
let MultiByteNop = 0x1F as X64ByteValue
let AlignedMoveLow = 0x28 as X64ByteValue
let AlignedMoveHigh = 0x2F as X64ByteValue
let Rdtsc = 0x31 as X64ByteValue
let ConditionalMoveLow = 0x40 as X64ByteValue
let ConditionalMoveHigh = 0x4F as X64ByteValue
let PackedArithmeticLow = 0x50 as X64ByteValue
let PackedArithmeticHigh = 0x6F as X64ByteValue
let VectorShuffleImm8 = 0x70 as X64ByteValue
let VectorShiftImm8High = 0x73 as X64ByteValue
let PackedCompareLow = 0x74 as X64ByteValue
let PackedCompareHigh = 0x7F as X64ByteValue
let LongJccLow = 0x80 as X64ByteValue
let LongJccHigh = 0x8F as X64ByteValue
let SetOnConditionLow = 0x90 as X64ByteValue
let SetOnConditionHigh = 0x9F as X64ByteValue
let PushFs = 0xA0 as X64ByteValue
let PopFs = 0xA1 as X64ByteValue
let Cpuid = 0xA2 as X64ByteValue
let BitTest = 0xA3 as X64ByteValue
let PushGs = 0xA8 as X64ByteValue
let PopGs = 0xA9 as X64ByteValue
let BitTestSet = 0xAB as X64ByteValue
let FenceGroup = 0xAE as X64ByteValue
let ImulRegModRm = 0xAF as X64ByteValue
let CompareExchangeByte = 0xB0 as X64ByteValue
let CompareExchangeWord = 0xB1 as X64ByteValue
let BitTestReset = 0xB3 as X64ByteValue
let MovzxByte = 0xB6 as X64ByteValue
let MovzxWord = 0xB7 as X64ByteValue
let BitTestImm8 = 0xBA as X64ByteValue
let BitTestComplement = 0xBB as X64ByteValue
let MovsxWord = 0xBF as X64ByteValue
let ExchangeAddByte = 0xC0 as X64ByteValue
let ExchangeAddWord = 0xC1 as X64ByteValue
let VectorCompareImm8 = 0xC2 as X64ByteValue
let MovntiStore = 0xC3 as X64ByteValue
let VectorInsertWordImm8 = 0xC4 as X64ByteValue
let VectorShuffleSelectImm8 = 0xC6 as X64ByteValue
let CompareExchangeGroup = 0xC7 as X64ByteValue
