let DbgReturnReleasesNothing = 0

export typealias X64Condition = int(0 to 15)

typealias X64ByteValue = int(0 to 255)
typealias X64ModRmField = int(0 to 7)

export type X64Instruction
	export var length as DecodedLength
	export var instructionClass as DecodedClass
	export var condition as X64Condition
	export var displacementPosition as DecodedLength
	export var releasePosition as DecodedLength
	export var target as DecodedTarget
	export var pushesARegister as bool
	export var callOperand as DecodedCallOperand

	export static function create(length DecodedLength, instructionClass DecodedClass, condition X64Condition, displacementPosition DecodedLength, releasePosition DecodedLength, target DecodedTarget, pushesARegister bool, callOperand DecodedCallOperand) returns X64Instruction
		return Self{length: length, instructionClass: instructionClass, condition: condition, displacementPosition: displacementPosition, releasePosition: releasePosition, target: target, pushesARegister: pushesARegister, callOperand: callOperand}
	end 'create'
end 'X64Instruction'

export union X64Decode
	unclassified
	decoded(instruction X64Instruction)
end 'X64Decode'

export union X64FrameStep
	pushesAWord(length DecodedLength)
	setsTheFramePointer
	neither
end 'X64FrameStep'

let SetFramePointerBytes = b"\x48\x89\xE5"
let PushRegisterLow = 0x50 as X64ByteValue
let PushRegisterHigh = 0x57 as X64ByteValue
let PopRegisterHigh = 0x5F as X64ByteValue

/// What the prologue instruction at `at` does to the frame: `mov rbp, rsp` exactly, a push of a
/// register, or neither.
export function x64FrameStepAt(code ByteArray, at DecodedOffset) returns X64FrameStep
	if codeHoldsAt(code, at: at, bytes: SetFramePointerBytes) 'set'
		return X64FrameStep.setsTheFramePointer
	end 'set'

	return match decodeX64Instruction(code, at: at, address: at as DecodedAddress) 'decoded'
		unclassified gives X64FrameStep.neither
		decoded(instruction) gives X64FrameStep.pushesAWord(instruction.length) if instruction.pushesARegister else X64FrameStep.neither
	end 'decoded'
end 'x64FrameStepAt'

function codeHoldsAt(code ByteArray, at DecodedOffset, bytes ByteArray) returns bool
	if at + (bytes.count() as DecodedOffset) > (code.count() as DecodedOffset) 'pastTheCode'
		return false
	end 'pastTheCode'

	for (iter, expected) in bytes.withIterator() 'eachByte'
		if (try code.get(at + (iter.index() as DecodedOffset)) otherwise panic("codeHoldsAt: offset {at} plus {iter.index()} was bounds-checked against {code.count()} bytes")) != expected 'aDifferentByte'
			return false
		end 'aDifferentByte'
	end 'eachByte'

	return true
end 'codeHoldsAt'

union X64Immediate
	none
	fixed(bytes DecodedLength)
	operandSized
	registerSized
	groupThree
end 'X64Immediate'

union X64Shape
	unknown
	operation(hasModRm bool, immediate X64Immediate, family X64Family)
end 'X64Shape'

enum X64Family
	ordinary
	pushingRegister
	directCall
	directJump
	conditionalJump
	returning
	modRmGroupFive
end 'X64Family'

type X64Cursor
	let code as ByteArray
	export var position as DecodedOffset
	let limit as DecodedOffset

	static function create(code ByteArray, at DecodedOffset) returns X64Cursor
		return Self{code: code, position: at, limit: code.count() as DecodedOffset}
	end 'create'

	function exhausted() returns bool
		return self.position >= self.limit
	end 'exhausted'

	function take() returns X64ByteValue throws X64DecodeError
		if self.exhausted() 'pastTheEnd'
			throw X64DecodeError.pastTheCode
		end 'pastTheEnd'

		let byte = try self.code.get(self.position) otherwise throw X64DecodeError.pastTheCode
		self.position = self.position + 1

		return byte as X64ByteValue
	end 'take'

	function peek() returns X64ByteValue throws X64DecodeError
		if self.exhausted() 'pastTheEnd'
			throw X64DecodeError.pastTheCode
		end 'pastTheEnd'

		return (try self.code.get(self.position) otherwise throw X64DecodeError.pastTheCode) as X64ByteValue
	end 'peek'

	function skip(bytes DecodedLength) throws X64DecodeError
		for _ in 0 upto bytes 'eachByte'
			_ = try self.take()
		end 'eachByte'
	end 'skip'

	function spanFrom(at DecodedOffset) returns DecodedLength throws X64DecodeError
		let span = self.position - at

		if span > (MaxInstructionBytes as DecodedOffset) 'longerThanAnyInstruction'
			throw X64DecodeError.notAnInstructionThisBuildDecodes
		end 'longerThanAnyInstruction'

		return span as DecodedLength
	end 'spanFrom'

	function signedAt(offset DecodedOffset, width DebugWidth) returns DecodedDisplacement throws X64DecodeError
		match debugLittleEndianAt(self.code, at: offset as DebugAddress, width: width) 'read'
			pastTheBytes then throw X64DecodeError.pastTheCode
			read(value) then return debugSignExtended(value, width: width) as DecodedDisplacement
		end 'read'
	end 'signedAt'
end 'X64Cursor'

enum X64DecodeError implements Error
	pastTheCode
	notAnInstructionThisBuildDecodes
	targetOutsideTheAddressSpace
end 'X64DecodeError'

let RexLow = 0x40 as X64ByteValue
let RexHigh = 0x4F as X64ByteValue
let RexWideBit = 0x08
let RexIndexBit = 0x02 as X64ByteValue
let RexBaseBit = 0x01 as X64ByteValue
let RexExtendedRegisters = 8
let NoRex = 0 as X64ByteValue

let OperandSizePrefix = 0x66 as X64ByteValue
let AddressSizePrefix = 0x67 as X64ByteValue
let LockPrefix = 0xF0 as X64ByteValue
let RepnePrefix = 0xF2 as X64ByteValue
let RepPrefix = 0xF3 as X64ByteValue
let SegmentCsPrefix = 0x2E as X64ByteValue
let SegmentSsPrefix = 0x36 as X64ByteValue
let SegmentDsPrefix = 0x3E as X64ByteValue
let SegmentEsPrefix = 0x26 as X64ByteValue
let SegmentFsPrefix = 0x64 as X64ByteValue
let SegmentGsPrefix = 0x65 as X64ByteValue

let TwoByteEscape = 0x0F as X64ByteValue

let ModRmModShift = 6
let ModRmRegShift = 3
let ModRmLowMask = 7
let ModRmModMask = 3
let ModRmDirect = 3
let ModRmNoDisplacement = 0
let ModRmDisp8 = 1
let ModRmDisp32 = 2
let ModRmSibRm = 4
let ModRmRipRm = 5
let SibNoBase = 5
let SibNoIndex = 4
let SibIndexShift = 3
let SibScaleShift = 6
let SibScaleMask = 3
let NoSib = 0 as X64ByteValue

let Disp8Bytes = 1 as DecodedLength
let Disp32Bytes = 4 as DecodedLength
let Immediate8Bytes = 1 as DecodedLength
let Immediate16Bytes = 2 as DecodedLength
let Immediate32Bytes = 4 as DecodedLength
let Immediate64Bytes = 8 as DecodedLength

let GroupThreeTestReg = 0
let GroupThreeTestAliasReg = 1
let GroupFiveCallReg = 2
let GroupFiveJumpReg = 4

let ConditionNibbleMask = 0x0F

let MaxInstructionBytes = 15 as DecodedLength

// It decodes what this compiler emits, and nothing else: VEX, EVEX, the 0F38/0F3A maps and x87 all answer
// `unclassified`, which refuses the breakpoint rather than displacing bytes it has measured wrongly.
export function decodeX64Instruction(code ByteArray, at DecodedOffset, address DecodedAddress) returns X64Decode
	return X64Decode.decoded(try x64InstructionAt(code, at: at, address: address) otherwise return X64Decode.unclassified)
end 'decodeX64Instruction'

function x64InstructionAt(code ByteArray, at DecodedOffset, address DecodedAddress) returns X64Instruction throws X64DecodeError
	var cursor = X64Cursor.create(code, at: at)
	var rex = NoRex
	var narrowOperand = false
	var addressOverridden = false
	var scanningPrefixes = true

	while scanningPrefixes 'eachPrefix'
		let byte = try cursor.peek()

		if isLegacyPrefix(byte) 'aLegacyPrefix'
			narrowOperand = narrowOperand or byte == OperandSizePrefix
			addressOverridden = addressOverridden or overridesTheAddress(byte)
			rex = NoRex
			try cursor.skip(1)
			continue
		end 'aLegacyPrefix'

		if byte >= RexLow and byte <= RexHigh 'aRexByte'
			rex = byte
			try cursor.skip(1)
			continue
		end 'aRexByte'

		scanningPrefixes = false
	end 'eachPrefix'

	let primary = try cursor.take()

	if primary == TwoByteEscape 'theSecondMap'
		let secondary = try cursor.take()

		return try decodedTwoByteInstruction(cursor, at: at, address: address, secondary: secondary, narrowOperand: narrowOperand, addressOverridden: addressOverridden, rex: rex)
	end 'theSecondMap'

	return try decodedShapedInstruction(cursor, at: at, address: address, shape: oneByteShape(primary), condition: (primary and ConditionNibbleMask) as X64Condition, relativeBytes: oneByteRelativeBytes(primary), narrowOperand: narrowOperand, addressOverridden: addressOverridden, rex: rex)
end 'x64InstructionAt'

function decodedTwoByteInstruction(cursor X64Cursor, at DecodedOffset, address DecodedAddress, secondary X64ByteValue, narrowOperand bool, addressOverridden bool, rex X64ByteValue) returns X64Instruction throws X64DecodeError
	if secondary >= LongJccLow and secondary <= LongJccHigh 'aLongConditionalJump'
		return try decodedShapedInstruction(cursor, at: at, address: address, shape: X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.conditionalJump), condition: (secondary and ConditionNibbleMask) as X64Condition, relativeBytes: Disp32Bytes, narrowOperand: narrowOperand, addressOverridden: addressOverridden, rex: rex)
	end 'aLongConditionalJump'

	return try decodedShapedInstruction(cursor, at: at, address: address, shape: twoByteShape(secondary), condition: 0, relativeBytes: 0, narrowOperand: narrowOperand, addressOverridden: addressOverridden, rex: rex)
end 'decodedTwoByteInstruction'

function decodedShapedInstruction(cursor X64Cursor, at DecodedOffset, address DecodedAddress, shape X64Shape, condition X64Condition, relativeBytes DecodedLength, narrowOperand bool, addressOverridden bool, rex X64ByteValue) returns X64Instruction throws X64DecodeError
	match shape 'known'
		unknown then throw X64DecodeError.notAnInstructionThisBuildDecodes
		operation(hasModRm, immediate, family) then return try decodedOperation(cursor, at: at, address: address, hasModRm: hasModRm, immediate: immediate, family: family, condition: condition, relativeBytes: relativeBytes, narrowOperand: narrowOperand, addressOverridden: addressOverridden, rex: rex)
	end 'known'
end 'decodedShapedInstruction'

function decodedOperation(cursor X64Cursor, at DecodedOffset, address DecodedAddress, hasModRm bool, immediate X64Immediate, family X64Family, condition X64Condition, relativeBytes DecodedLength, narrowOperand bool, addressOverridden bool, rex X64ByteValue) returns X64Instruction throws X64DecodeError
	var ripRelative = false
	var displacementPosition = 0 as DecodedLength
	var displacementBytes = 0 as DecodedLength
	var modRmReg = 0 as X64ModRmField
	var addressing = ModRmDirect as X64ByteValue
	var rm = 0 as X64ModRmField
	var sib = NoSib

	if hasModRm 'anAddressingByte'
		let modRm = try cursor.take()
		addressing = (modRm shr ModRmModShift) and ModRmModMask
		rm = (modRm and ModRmLowMask) as X64ModRmField
		modRmReg = ((modRm shr ModRmRegShift) and ModRmLowMask) as X64ModRmField

		if addressing != ModRmDirect 'aMemoryOperand'
			if rm == ModRmSibRm 'aScaledIndex'
				sib = try cursor.take()

				if addressing == ModRmNoDisplacement and (sib and ModRmLowMask) == SibNoBase 'anAbsoluteBase'
					displacementBytes = Disp32Bytes
				end 'anAbsoluteBase'
			end 'aScaledIndex' else if addressing == ModRmNoDisplacement and rm == ModRmRipRm 'programCounterRelative'
				ripRelative = true
				displacementBytes = Disp32Bytes
			end 'programCounterRelative'

			if addressing == ModRmDisp8 'aByteDisplacement'
				displacementBytes = Disp8Bytes
			end 'aByteDisplacement' else if addressing == ModRmDisp32 'aWordDisplacement'
				displacementBytes = Disp32Bytes
			end 'aWordDisplacement'

			displacementPosition = try cursor.spanFrom(at)
			try cursor.skip(displacementBytes)
		end 'aMemoryOperand'
	end 'anAddressingByte'

	let immediateBytes = immediateBytesOf(immediate, modRmReg: modRmReg, narrowOperand: narrowOperand, wideOperand: (rex and RexWideBit) != 0)
	var releasePosition = DbgReturnReleasesNothing as DecodedLength

	if family == X64Family.returning and immediateBytes > 0 'releasesArguments'
		releasePosition = try cursor.spanFrom(at)
	end 'releasesArguments'

	try cursor.skip(immediateBytes)
	try cursor.skip(relativeBytes)

	let length = try cursor.spanFrom(at)
	let instructionClass = classOf(family, modRmReg: modRmReg, ripRelative: ripRelative)

	if narrowOperand and isABranch(instructionClass) 'aSixteenBitBranch'
		throw X64DecodeError.notAnInstructionThisBuildDecodes
	end 'aSixteenBitBranch'

	let taken = condition if instructionClass == DbgClassConditionalJump else 0
	let target = try targetOf(cursor, at: at, address: address, instructionClass: instructionClass, length: length, relativeBytes: relativeBytes, displacementPosition: displacementPosition)
	var callOperand = DecodedCallOperand.none

	if instructionClass == DbgClassIndirectCall 'anIndirectCall'
		callOperand = try X64CallOperandReader.create(cursor, at: at, address: address, length: length, rex: rex, addressOverridden: addressOverridden).operandOf(addressing, rm: rm, sib: sib, displacementPosition: displacementPosition, displacementBytes: displacementBytes)
	end 'anIndirectCall'

	return X64Instruction.create(length, instructionClass: instructionClass, condition: taken, displacementPosition: displacementPosition, releasePosition: releasePosition, target: target, pushesARegister: family == X64Family.pushingRegister, callOperand: callOperand)
end 'decodedOperation'

type X64CallOperandReader
	let cursor as X64Cursor
	let at as DecodedOffset
	let address as DecodedAddress
	let length as DecodedLength
	let rex as X64ByteValue
	let addressOverridden as bool

	static function create(cursor X64Cursor, at DecodedOffset, address DecodedAddress, length DecodedLength, rex X64ByteValue, addressOverridden bool) returns X64CallOperandReader
		return Self{cursor: cursor, at: at, address: address, length: length, rex: rex, addressOverridden: addressOverridden}
	end 'create'

	function operandOf(addressing X64ByteValue, rm X64ModRmField, sib X64ByteValue, displacementPosition DecodedLength, displacementBytes DecodedLength) returns DecodedCallOperand throws X64DecodeError
		if addressing == ModRmDirect 'aRegister'
			return DecodedCallOperand.register(self.extended(rm, by: RexBaseBit))
		end 'aRegister'

		let operand = try self.memoryOperandOf(addressing, rm: rm, sib: sib, displacementPosition: displacementPosition, displacementBytes: displacementBytes)

		return DecodedCallOperand.addressOverridden(operand.callForm(), referent: operand.rebasedReferent()) if self.addressOverridden else operand
	end 'operandOf'

	function memoryOperandOf(addressing X64ByteValue, rm X64ModRmField, sib X64ByteValue, displacementPosition DecodedLength, displacementBytes DecodedLength) returns DecodedCallOperand throws X64DecodeError
		let displacement = try self.displacementOf(displacementPosition, bytes: displacementBytes)

		if addressing == ModRmNoDisplacement and rm == ModRmRipRm 'programCounterRelative'
			return DecodedCallOperand.programCounterRelative(try relativeTo(self.address, length: self.length, by: displacement))
		end 'programCounterRelative'

		if rm != ModRmSibRm 'aBaseRegister'
			return DecodedCallOperand.memory(DecodedRegisterLookup.register(self.extended(rm, by: RexBaseBit)), index: DecodedRegisterLookup.none, scale: 1, displacement: displacement)
		end 'aBaseRegister'

		let baseField = (sib and ModRmLowMask) as X64ModRmField
		let indexField = ((sib shr SibIndexShift) and ModRmLowMask) as X64ModRmField
		let index = self.extended(indexField, by: RexIndexBit)
		let base = DecodedRegisterLookup.none if addressing == ModRmNoDisplacement and baseField == SibNoBase else DecodedRegisterLookup.register(self.extended(baseField, by: RexBaseBit))
		let scaled = DecodedRegisterLookup.none if index == SibNoIndex else DecodedRegisterLookup.register(index)

		return DecodedCallOperand.memory(base, index: scaled, scale: (1 shl ((sib shr SibScaleShift) and SibScaleMask)) as DecodedScale, displacement: displacement)
	end 'memoryOperandOf'

	function extended(field X64ModRmField, by X64ByteValue) returns DecodedRegisterNumber
		return (field + (RexExtendedRegisters if (self.rex and by) != 0 else 0)) as DecodedRegisterNumber
	end 'extended'

	function displacementOf(position DecodedLength, bytes DecodedLength) returns DecodedDisplacement throws X64DecodeError
		if bytes == 0 'noDisplacement'
			return 0
		end 'noDisplacement'

		return try self.cursor.signedAt(self.at + (position as DecodedOffset), width: bytes as DebugWidth)
	end 'displacementOf'
end 'X64CallOperandReader'

function classOf(family X64Family, modRmReg X64ModRmField, ripRelative bool) returns DecodedClass
	match family 'which'
		directCall then return DbgClassDirectCall as DecodedClass
		directJump then return DbgClassDirectJump as DecodedClass
		conditionalJump then return DbgClassConditionalJump as DecodedClass
		returning then return DbgClassReturn as DecodedClass
		modRmGroupFive then return groupFiveClass(modRmReg, ripRelative: ripRelative)

		ordinary or
			pushingRegister then return dataOperandClass(ripRelative)
	end 'which'
end 'classOf'

function isABranch(instructionClass DecodedClass) returns bool
	return instructionClass == DbgClassDirectCall or instructionClass == DbgClassDirectJump or instructionClass == DbgClassConditionalJump or instructionClass == DbgClassReturn or instructionClass == DbgClassIndirectCall or instructionClass == DbgClassIndirectJump
end 'isABranch'

function groupFiveClass(modRmReg X64ModRmField, ripRelative bool) returns DecodedClass
	if modRmReg == GroupFiveCallReg 'anIndirectCall'
		return DbgClassIndirectCall as DecodedClass
	end 'anIndirectCall'

	if modRmReg == GroupFiveJumpReg 'anIndirectJump'
		return DbgClassIndirectJump as DecodedClass
	end 'anIndirectJump'

	return dataOperandClass(ripRelative)
end 'groupFiveClass'

function dataOperandClass(ripRelative bool) returns DecodedClass
	return (DbgClassPcRelativeData if ripRelative else DbgClassPlain) as DecodedClass
end 'dataOperandClass'

function targetOf(cursor X64Cursor, at DecodedOffset, address DecodedAddress, instructionClass DecodedClass, length DecodedLength, relativeBytes DecodedLength, displacementPosition DecodedLength) returns DecodedTarget throws X64DecodeError
	if instructionClass == DbgClassPcRelativeData 'aRebasedOperand'
		return DecodedTarget.at(try relativeTo(address, length: length, by: try cursor.signedAt(at + (displacementPosition as DecodedOffset), width: Disp32Bytes as DebugWidth)))
	end 'aRebasedOperand'

	if instructionClass == DbgClassDirectCall or instructionClass == DbgClassDirectJump or instructionClass == DbgClassConditionalJump 'aBranch'
		return DecodedTarget.at(try relativeTo(address, length: length, by: try cursor.signedAt(at + ((length - relativeBytes) as DecodedOffset), width: relativeBytes as DebugWidth)))
	end 'aBranch'

	return DecodedTarget.none
end 'targetOf'

function relativeTo(address DecodedAddress, length DecodedLength, by DecodedDisplacement) returns DecodedAddress throws X64DecodeError
	match debugUserSpaceAddress((address as DebuggeeWord) + (length as DebuggeeWord) + (by as DebuggeeWord)) 'reached'
		unresolved then throw X64DecodeError.targetOutsideTheAddressSpace
		at(reached) then return reached as DecodedAddress
	end 'reached'
end 'relativeTo'

function immediateBytesOf(immediate X64Immediate, modRmReg X64ModRmField, narrowOperand bool, wideOperand bool) returns DecodedLength
	return match immediate 'which'
		none gives 0
		fixed(bytes) gives bytes
		operandSized gives operandSizedImmediateBytes(narrowOperand)
		registerSized gives registerSizedImmediateBytes(narrowOperand, wideOperand: wideOperand)
		groupThree gives operandSizedImmediateBytes(narrowOperand) if modRmReg == GroupThreeTestReg or modRmReg == GroupThreeTestAliasReg else 0
	end 'which'
end 'immediateBytesOf'

function operandSizedImmediateBytes(narrowOperand bool) returns DecodedLength
	return Immediate16Bytes if narrowOperand else Immediate32Bytes
end 'operandSizedImmediateBytes'

function registerSizedImmediateBytes(narrowOperand bool, wideOperand bool) returns DecodedLength
	if wideOperand 'aFullWord'
		return Immediate64Bytes
	end 'aFullWord'

	return Immediate16Bytes if narrowOperand else Immediate32Bytes
end 'registerSizedImmediateBytes'

function isLegacyPrefix(byte X64ByteValue) returns bool
	return byte == OperandSizePrefix or byte == AddressSizePrefix or byte == LockPrefix or byte == RepnePrefix or byte == RepPrefix or byte == SegmentCsPrefix or byte == SegmentSsPrefix or byte == SegmentDsPrefix or byte == SegmentEsPrefix or byte == SegmentFsPrefix or byte == SegmentGsPrefix
end 'isLegacyPrefix'

function overridesTheAddress(byte X64ByteValue) returns bool
	return byte == AddressSizePrefix or byte == SegmentFsPrefix or byte == SegmentGsPrefix
end 'overridesTheAddress'

function oneByteRelativeBytes(opcode X64ByteValue) returns DecodedLength
	if opcode == CallRel32 or opcode == JmpRel32 'aWordBranch'
		return Immediate32Bytes
	end 'aWordBranch'

	if opcode == JmpRel8 or (opcode >= ShortJccLow and opcode <= ShortJccHigh) 'aByteBranch'
		return Immediate8Bytes
	end 'aByteBranch'

	return 0
end 'oneByteRelativeBytes'

function oneByteShape(opcode X64ByteValue) returns X64Shape
	if isArithmeticRegisterForm(opcode) 'arithRegRm'
		return X64Shape.operation(true, immediate: X64Immediate.none, family: X64Family.ordinary)
	end 'arithRegRm'

	if isArithmeticAccumulatorByte(opcode) 'arithAlImm8'
		return X64Shape.operation(false, immediate: X64Immediate.fixed(Immediate8Bytes), family: X64Family.ordinary)
	end 'arithAlImm8'

	if isArithmeticAccumulatorWord(opcode) 'arithEaxImm32'
		return X64Shape.operation(false, immediate: X64Immediate.operandSized, family: X64Family.ordinary)
	end 'arithEaxImm32'

	if opcode >= PushRegisterLow and opcode <= PushRegisterHigh 'pushRegister'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.pushingRegister)
	end 'pushRegister'

	if opcode > PushRegisterHigh and opcode <= PopRegisterHigh 'popRegister'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.ordinary)
	end 'popRegister'

	if opcode >= ShortJccLow and opcode <= ShortJccHigh 'shortConditionalJump'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.conditionalJump)
	end 'shortConditionalJump'

	if opcode >= MovByteImmediateLow and opcode <= MovByteImmediateHigh 'movByteImmediate'
		return X64Shape.operation(false, immediate: X64Immediate.fixed(Immediate8Bytes), family: X64Family.ordinary)
	end 'movByteImmediate'

	if opcode >= MovWordImmediateLow and opcode <= MovWordImmediateHigh 'movWordImmediate'
		return X64Shape.operation(false, immediate: X64Immediate.registerSized, family: X64Family.ordinary)
	end 'movWordImmediate'

	return oneByteNamedShape(opcode)
end 'oneByteShape'

function oneByteNamedShape(opcode X64ByteValue) returns X64Shape
	if opcode == Movsxd or (opcode >= TestByteModRm and opcode <= MovWordRegModRm) or opcode == Lea or opcode == PopModRm or (opcode >= ShiftByOneByte and opcode <= ShiftByClWord) or opcode == GroupFourByte 'modRmOnly'
		return X64Shape.operation(true, immediate: X64Immediate.none, family: X64Family.ordinary)
	end 'modRmOnly'

	if opcode == GroupOneByteImm8 or opcode == GroupOneWordImm8 or opcode == ShiftByImm8Byte or opcode == ShiftByImm8Word or opcode == MovByteModRmImm8 or opcode == ImulImm8 'modRmByteImmediate'
		return X64Shape.operation(true, immediate: X64Immediate.fixed(Immediate8Bytes), family: X64Family.ordinary)
	end 'modRmByteImmediate'

	if opcode == GroupOneWordImm32 or opcode == MovWordModRmImm32 or opcode == ImulImm32 'modRmWordImmediate'
		return X64Shape.operation(true, immediate: X64Immediate.operandSized, family: X64Family.ordinary)
	end 'modRmWordImmediate'

	if opcode == GroupThreeByte or opcode == GroupThreeWord 'groupThreeForm'
		return X64Shape.operation(true, immediate: X64Immediate.groupThree, family: X64Family.ordinary)
	end 'groupThreeForm'

	if opcode == GroupFive 'groupFiveForm'
		return X64Shape.operation(true, immediate: X64Immediate.none, family: X64Family.modRmGroupFive)
	end 'groupFiveForm'

	if opcode == Nop or opcode == Cdqe or opcode == Cqo or opcode == Leave or opcode == Int3 or opcode == Hlt 'noOperand'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.ordinary)
	end 'noOperand'

	if opcode == PushImm8 'pushByteImmediate'
		return X64Shape.operation(false, immediate: X64Immediate.fixed(Immediate8Bytes), family: X64Family.ordinary)
	end 'pushByteImmediate'

	if opcode == PushImm32 'pushWordImmediate'
		return X64Shape.operation(false, immediate: X64Immediate.operandSized, family: X64Family.ordinary)
	end 'pushWordImmediate'

	if opcode == TestAccumulatorImm8 'testAccumulatorByte'
		return X64Shape.operation(false, immediate: X64Immediate.fixed(Immediate8Bytes), family: X64Family.ordinary)
	end 'testAccumulatorByte'

	if opcode == TestAccumulatorImm32 'testAccumulatorWord'
		return X64Shape.operation(false, immediate: X64Immediate.operandSized, family: X64Family.ordinary)
	end 'testAccumulatorWord'

	if opcode == NearReturn 'nearReturn'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.returning)
	end 'nearReturn'

	if opcode == NearReturnImm16 'nearReturnPopping'
		return X64Shape.operation(false, immediate: X64Immediate.fixed(Immediate16Bytes), family: X64Family.returning)
	end 'nearReturnPopping'

	if opcode == CallRel32 'directCallForm'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.directCall)
	end 'directCallForm'

	if opcode == JmpRel32 or opcode == JmpRel8 'directJumpForm'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.directJump)
	end 'directJumpForm'

	return X64Shape.unknown
end 'oneByteNamedShape'

function twoByteShape(opcode X64ByteValue) returns X64Shape
	if isVectorModRmOnly(opcode) 'modRmOnly'
		return X64Shape.operation(true, immediate: X64Immediate.none, family: X64Family.ordinary)
	end 'modRmOnly'

	if (opcode >= VectorShuffleImm8 and opcode <= VectorShiftImm8High) or opcode == VectorCompareImm8 or opcode == VectorShuffleSelectImm8 or opcode == VectorInsertWordImm8 or opcode == BitTestImm8 'modRmByteImmediate'
		return X64Shape.operation(true, immediate: X64Immediate.fixed(Immediate8Bytes), family: X64Family.ordinary)
	end 'modRmByteImmediate'

	if opcode == Syscall or opcode == Ud2 or opcode == Rdtsc or opcode == Cpuid or (opcode >= PushFs and opcode <= PopFs) or (opcode >= PushGs and opcode <= PopGs) 'noOperand'
		return X64Shape.operation(false, immediate: X64Immediate.none, family: X64Family.ordinary)
	end 'noOperand'

	return X64Shape.unknown
end 'twoByteShape'

function isVectorModRmOnly(opcode X64ByteValue) returns bool
	if opcode >= VectorMoveLow and opcode <= VectorMoveHigh 'moveFamily'
		return true
	end 'moveFamily'

	if opcode >= AlignedMoveLow and opcode <= AlignedMoveHigh 'alignedMoveAndCompare'
		return true
	end 'alignedMoveAndCompare'

	if opcode >= ConditionalMoveLow and opcode <= ConditionalMoveHigh 'conditionalMove'
		return true
	end 'conditionalMove'

	if opcode >= PackedArithmeticLow and opcode <= PackedArithmeticHigh 'packedArithmetic'
		return true
	end 'packedArithmetic'

	if opcode >= PackedCompareLow and opcode <= PackedCompareHigh 'packedCompareAndMove'
		return true
	end 'packedCompareAndMove'

	if opcode >= SetOnConditionLow and opcode <= SetOnConditionHigh 'setOnCondition'
		return true
	end 'setOnCondition'

	if opcode >= PackedTailLow and opcode <= PackedTailHigh 'packedTail'
		return true
	end 'packedTail'

	if opcode >= CompareExchangeByte and opcode <= CompareExchangeWord 'compareExchange'
		return true
	end 'compareExchange'

	if opcode >= MovzxByte and opcode <= MovzxWord 'zeroExtend'
		return true
	end 'zeroExtend'

	if opcode >= BitTestComplement and opcode <= MovsxWord 'bitScanAndSignExtend'
		return true
	end 'bitScanAndSignExtend'

	if opcode >= ExchangeAddByte and opcode <= ExchangeAddWord 'exchangeAdd'
		return true
	end 'exchangeAdd'

	return opcode == PrefetchWrite or opcode == PrefetchGroup or opcode == MultiByteNop or opcode == BitTest or opcode == BitTestSet or opcode == FenceGroup or opcode == ImulRegModRm or opcode == BitTestReset or opcode == MovntiStore or opcode == CompareExchangeGroup
end 'isVectorModRmOnly'

function isArithmeticRegisterForm(opcode X64ByteValue) returns bool
	return opcode < ArithmeticOpcodeLimit and (opcode and ArithmeticFormMask) < ArithmeticAccumulatorByteForm
end 'isArithmeticRegisterForm'

function isArithmeticAccumulatorByte(opcode X64ByteValue) returns bool
	return opcode < ArithmeticOpcodeLimit and (opcode and ArithmeticFormMask) == ArithmeticAccumulatorByteForm
end 'isArithmeticAccumulatorByte'

function isArithmeticAccumulatorWord(opcode X64ByteValue) returns bool
	return opcode < ArithmeticOpcodeLimit and (opcode and ArithmeticFormMask) == ArithmeticAccumulatorWordForm
end 'isArithmeticAccumulatorWord'

let ArithmeticOpcodeLimit = 0x40 as X64ByteValue
let ArithmeticFormMask = 0x07 as X64ByteValue
let ArithmeticAccumulatorByteForm = 4 as X64ByteValue
let ArithmeticAccumulatorWordForm = 5 as X64ByteValue

let Movsxd = 0x63 as X64ByteValue
let PushImm32 = 0x68 as X64ByteValue
let ImulImm32 = 0x69 as X64ByteValue
let PushImm8 = 0x6A as X64ByteValue
let ImulImm8 = 0x6B as X64ByteValue
let ShortJccLow = 0x70 as X64ByteValue
let ShortJccHigh = 0x7F as X64ByteValue
let GroupOneByteImm8 = 0x80 as X64ByteValue
let GroupOneWordImm32 = 0x81 as X64ByteValue
let GroupOneWordImm8 = 0x83 as X64ByteValue
let TestByteModRm = 0x84 as X64ByteValue
let MovWordRegModRm = 0x8B as X64ByteValue
let Lea = 0x8D as X64ByteValue
let PopModRm = 0x8F as X64ByteValue
