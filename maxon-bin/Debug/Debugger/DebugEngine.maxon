export typealias StopTimeoutMs = int(0 to 1000000000000000)
export typealias DebugDeadline = int(0 to i64.max)
export typealias EngineSeq = int(0 to i64.max)
export typealias EngineReadLength = int(0 to 512)
export typealias EngineRegisterNumber = int(0 to 79)

let MaxEngineReadLength = 512
let MaxEngineRegisterNumber = 79

export let DbgStopReasonEntry = 1
export let DbgStopReasonBreakpoint = 2
export let DbgStopReasonStep = 3
export let DbgStopReasonPause = 4
export let DbgStopReasonTrap = 5
export let DbgStopReasonFault = 6

export let DbgGtStatusRunning = 1
export let DbgGtStatusReady = 2
export let DbgGtStatusWaiting = 3
export let DbgGtStatusHeld = 5

let MaxBacktraceFrames = 64
let MaxMachinesWalked = 4096
let FrameRecordBytes = 16

let AsyncPreemptionWithdrawn = 1

typealias HoldEpochStep = int(-1 to 1)

let HoldEpochArmStep = 1 as HoldEpochStep
let HoldEpochLiftStep = -1 as HoldEpochStep

export enum DebugMemoryError implements Error
	notReadable
end 'DebugMemoryError'

export interface DebugMemory
	function readDebuggeeWord(address DebugAddress, width DebugWidth) returns DebuggeeWord throws DebugMemoryError
	function readDebuggeeText(address DebugAddress, length EngineReadLength) returns String throws DebugMemoryError
	function registerValue(number EngineRegisterNumber) returns DebuggeeWord
end 'DebugMemory'

export type EngineStop
	export var reason as DebugAddress
	export var fault as DebugAddress
	export var machine as DebugAddress
	export var greenThread as DebugAddress
	export var traceMark as DebugAddress
	export var pc as DebugAddress
	export var stackPointer as DebugAddress
	export var framePointer as DebugAddress
	export var returnAddresses as DebugAddressArray
	export var callerFramePointers as DebugAddressArray
	export var truncated as bool
	export var conditionMissed as bool

	export static function create(reason DebugAddress, fault DebugAddress, machine DebugAddress, greenThread DebugAddress, traceMark DebugAddress, pc DebugAddress, stackPointer DebugAddress, framePointer DebugAddress, returnAddresses DebugAddressArray, callerFramePointers DebugAddressArray, truncated bool, conditionMissed bool) returns EngineStop
		return Self{reason: reason, fault: fault, machine: machine, greenThread: greenThread, traceMark: traceMark, pc: pc, stackPointer: stackPointer, framePointer: framePointer, returnAddresses: returnAddresses, callerFramePointers: callerFramePointers, truncated: truncated, conditionMissed: conditionMissed}
	end 'create'

	export static function walked(returnAddresses DebugAddressArray, callerFramePointers DebugAddressArray, truncated bool) returns EngineStop
		return Self{reason: 0, fault: 0, machine: 0, greenThread: 0, traceMark: 0, pc: 0, stackPointer: 0, framePointer: 0, returnAddresses: returnAddresses, callerFramePointers: callerFramePointers, truncated: truncated, conditionMissed: false}
	end 'walked'

	export function callerFramePointerOf(frame ElementIndex) returns DebugAddress
		return try self.callerFramePointers.get(frame) otherwise panic("EngineStop.callerFramePointerOf: the walk harvests one caller frame pointer per return address, and {frame} is past the {self.returnAddresses.count()} it holds")
	end 'callerFramePointerOf'
end 'EngineStop'

export union CommandInquiry
	answered
	refused(reason String)
	gone(outcome TargetOutcome)
end 'CommandInquiry'

export union CommandOutcome
	done
	nothingParked
	refused(reason String)
	gone(outcome TargetOutcome)

	export function accepted() returns bool
		return match self 'which'
			done gives true
			nothingParked or
				refused or
				gone gives false
		end 'which'
	end 'accepted'

	export function inquiry() returns CommandInquiry
		return match self 'which'
			done gives CommandInquiry.answered
			nothingParked gives CommandInquiry.refused(DebugNotRunningReason)
			refused(reason) gives CommandInquiry.refused(reason)
			gone(ending) gives CommandInquiry.gone(ending)
		end 'which'
	end 'inquiry'
end 'CommandOutcome'

union EngineEntrySlice
	keepWaiting
	landed
	ended(outcome TargetOutcome)
end 'EngineEntrySlice'

export union StopWait
	stopped(record EngineStop)
	ended(outcome TargetOutcome)
	timedOut
end 'StopWait'

export union EngineStart
	ready(engine DebugEngine)
	neverStopped(outcome TargetOutcome)
	refused(reason String)
end 'EngineStart'

export let DebugUnclassifiedReason = "unclassified"
export let DebugOutOfTextReason = "out-of-text"
export let DebugInsideRuntimeSymbolReason = "inside-runtime-symbol"
export let DebugNotRunningReason = "not-running"
let DebugNoSuchBreakpointReason = "no-such-breakpoint"
let DebugReturnHoldTakenReason = "return-hold-taken"
export let DebugFaultIsTerminalReason = "fault-is-terminal"
let DebugNotStoppedReason = "not-stopped"
let DebugThreadIsRunningReason = "thread-is-running"
let DebugNotPausableReason = "not-pausable"
let DebugNoSchedulerReason = "no-scheduler"
let DebugUnwritableReason = "unwritable"

let PollIntervalMs = 1
let WaitSliceMs = 5
let PauseAttemptBudgetMs = 1000

let WordBytes = 8
let FirstStopSeq = 1

type EngineBreakpoint
	export let offset as DebugAddress
	export let address as DebugAddress
	export let originalBytes as ByteArray
	export let usersOwn as bool
	export let conditioned as bool
	export let condition as DebugConditionRecord

	static function create(offset DebugAddress, address DebugAddress, originalBytes ByteArray, usersOwn bool, conditioned bool, condition DebugConditionRecord) returns EngineBreakpoint
		return Self{offset: offset, address: address, originalBytes: originalBytes, usersOwn: usersOwn, conditioned: conditioned, condition: condition}
	end 'create'
end 'EngineBreakpoint'

typealias EngineBreakpointArray = Array with EngineBreakpoint

union EngineBreakpointLookup
	none
	at(breakpoint EngineBreakpoint)
end 'EngineBreakpointLookup'

// A trap lifted for one thread's step over it, keyed BY that thread: Windows reports the next event on
// whatever thread produced it, so a single "a step is outstanding" word would attribute a service machine's
// stop to main's step and re-plant the byte under the wrong thread.
type EngineLiftedTrap
	export let thread as BackendThreadId
	export let offset as DebugAddress
	export let reportTheStep as bool

	static function create(thread BackendThreadId, offset DebugAddress, reportTheStep bool) returns EngineLiftedTrap
		return Self{thread: thread, offset: offset, reportTheStep: reportTheStep}
	end 'create'
end 'EngineLiftedTrap'

typealias EngineLiftedTrapArray = Array with EngineLiftedTrap

union EngineLiftedTrapLookup
	none
	at(lifted EngineLiftedTrap)
end 'EngineLiftedTrapLookup'

union EngineReturnPoint
	at(point DebugReturnPoint, offset DebugAddress, heldOverACondition bool)

	function holdsTheWalksHold() returns bool
		return match self 'standing'
			at(_, _, held) gives held
		end 'standing'
	end 'holdsTheWalksHold'

	function withoutTheHoldAt(armed DebugAddress) returns EngineReturnPoint
		return match self 'standing'
			at(point, offset, held) gives EngineReturnPoint.at(point, offset: offset, heldOverACondition: held and offset != armed)
		end 'standing'
	end 'withoutTheHoldAt'

	function heldIfAt(holding DebugAddress) returns EngineReturnPoint
		return match self 'standing'
			at(point, offset, held) gives EngineReturnPoint.at(point, offset: offset, heldOverACondition: held or offset == holding)
		end 'standing'
	end 'heldIfAt'

	function movedWith(movedThread DebugAddress, from DebugAddress, to DebugAddress) returns EngineReturnPoint
		return match self 'standing'
			at(point, offset, held) gives EngineReturnPoint.at(point.movedWith(movedThread, from: from, to: to), offset: offset, heldOverACondition: held)
		end 'standing'
	end 'movedWith'

	function standsAt(address DebugAddress) returns bool
		return match self 'standing'
			at(point, _, _) gives point.address == address
		end 'standing'
	end 'standsAt'

	function unheldPointAt(holding DebugAddress) returns DebugReturnPointLookup
		return match self 'standing'
			at(point, offset, held) gives DebugReturnPointLookup.at(point) if offset == holding and not held else DebugReturnPointLookup.none
		end 'standing'
	end 'unheldPointAt'

	function pointReachedBy(landed EngineStop) returns DebugReturnPointLookup
		return match self 'standing'
			at(point, _, _) gives DebugReturnPointLookup.at(point) if point.reachedBy(landed) else DebugReturnPointLookup.none
		end 'standing'
	end 'pointReachedBy'

	function offsetOf() returns DebugAddress
		return match self 'standing'
			at(_, offset, _) gives offset
		end 'standing'
	end 'offsetOf'
end 'EngineReturnPoint'

typealias EngineReturnPointArray = Array with EngineReturnPoint

module union DebugReturnPointLookup
	none
	at(point DebugReturnPoint)

	module function found() returns bool
		return match self 'lookup'
			none gives false
			at gives true
		end 'lookup'
	end 'found'
end 'DebugReturnPointLookup'

module enum DebugReturnKind
	callReturn
	frameReturn
	indirectCall
end 'DebugReturnKind'

module type DebugReturnPoint
	export let address as DebugAddress
	export let framePointer as DebugAddress
	export let greenThread as DebugAddress
	export let kind as DebugReturnKind

	module static function create(address DebugAddress, framePointer DebugAddress, greenThread DebugAddress, kind DebugReturnKind) returns DebugReturnPoint
		return Self{address: address, framePointer: framePointer, greenThread: greenThread, kind: kind}
	end 'create'

	module function reachedBy(landed EngineStop) returns bool
		if landed.pc != self.address or landed.greenThread != self.greenThread 'anotherPlaceOrThread'
			return false
		end 'anotherPlaceOrThread'

		// A call return records the frame it lands in and a frame return the frame it leaves, so only a
		// frame return needs a strictly higher frame pointer. A recursive activation reaches the same
		// address in a deeper frame, whose frame pointer is lower, and must not end the walk.
		return landed.framePointer > self.framePointer or (landed.framePointer == self.framePointer and self.kind != DebugReturnKind.frameReturn)
	end 'reachedBy'

	function movedWith(movedThread DebugAddress, from DebugAddress, to DebugAddress) returns DebugReturnPoint
		if movedThread != self.greenThread 'anotherStack'
			return self
		end 'anotherStack'

		return DebugReturnPoint.create(self.address, framePointer: self.framePointer + to - from, greenThread: self.greenThread, kind: self.kind)
	end 'movedWith'
end 'DebugReturnPoint'

module typealias DebugReturnPointArray = Array with DebugReturnPoint

union EngineStepPost
	none
	on(machine DebugAddress)
end 'EngineStepPost'

union EngineExecutedTrap
	none
	at(address DebugAddress)

	function found() returns bool
		return match self 'executed'
			none gives false
			at gives true
		end 'executed'
	end 'found'

	function addressOr(landing DebugAddress) returns DebugAddress
		return match self 'executed'
			none gives landing
			at(address) gives address
		end 'executed'
	end 'addressOr'
end 'EngineExecutedTrap'

union EngineWalk
	walked(returnAddresses DebugAddressArray, callerFramePointers DebugAddressArray, truncated bool)
end 'EngineWalk'

export type DebugEngine implements DebugMemory
	var backend as DebugBackend
	var target as DebugTarget
	var contract as DebugRuntimeContract
	let stopTimeoutMs as StopTimeoutMs
	var lastStopSeq as EngineSeq
	var breakpoints as EngineBreakpointArray
	var returnPoints as EngineReturnPointArray
	var textBase as DebugAddress
	var textSize as DebugAddress
	var cacheBase as DebugAddress
	var cacheBytes as ByteArray
	var cacheFilled as bool
	var trace as DebugTraceState
	let routing as ChildOutputRouting
	var registers as DebugRegisterFile
	var stopThread as BackendThreadId
	var stopped as bool
	var stepPosted as EngineStepPost
	var answeredUnder as DebugAddress
	var liftedTraps as EngineLiftedTrapArray
	var detached as bool
	var closed as bool
	var holdArmed as bool
	var lastReason as DebugAddress
	var lastFault as DebugAddress
	var lastPc as DebugAddress
	var lastConditionMissed as bool

	export static function start(program FilePath, reader MxdbgReader, textBytes DebugAddress, arguments StringArray, workingDirectory FilePath, targetEnv EnvMap, routing ChildOutputRouting, stopTimeoutMs StopTimeoutMs, traced bool) returns EngineStart
		requireEngineBoundsMatchTheBackend()

		if not debugSessionPinnedToItsMachine() 'noPin'
			return EngineStart.refused("this driver could not pin its own green thread to the machine the debug interface answers on")
		end 'noPin'

		var backend = backendFor(targetToString(detectHostTarget()))

		if not backend.holdsItsScratch() 'noScratch'
			return refusedBeforeLaunch(BackendScratchRefusal)
		end 'noScratch'

		var environment = EnvMap.create()

		for (name, value) in targetEnv 'eachVariable'
			environment.upsert(name, value: value)
		end 'eachVariable'

		let trace = openedTraceRing(program, traced: traced)

		match trace 'ring'
			untraced or
				noProducer then break 'ring'
			ring(collector) then environment.upsert(DsActivationEnvVar, value: collector.segmentName())
		end 'ring'

		let target = try DebugTarget.launchTraced(backend.launchPlan(program, arguments: arguments), workingDirectory: workingDirectory, environment: environment, routing: routing) otherwise (e) 'noChild'
			backend.close()
			closeTraceRing(trace)
			releaseDebugSessionPin()

			return EngineStart.refused("could not launch the program ({e.displayReason()})")
		end 'noChild'

		var placement = BackendImagePlacement.asLinked

		match backend.adoptLaunchedProgram() 'adopted'
			refused(reason) then return refusedAfterLaunch(reason, backend: backend, target: target, trace: trace)
			ready(placed) then placement = placed
		end 'adopted'

		let contract = DebugRuntimeContract.readFrom(reader, textBytes: textBytes, placement: placement)
		var engine = Self{backend: backend, target: target, contract: contract, stopTimeoutMs: stopTimeoutMs, lastStopSeq: 0, breakpoints: EngineBreakpointArray.create(), returnPoints: EngineReturnPointArray.create(), textBase: contract.textBase(), textSize: contract.textSize(), cacheBase: 0, cacheBytes: ByteArray.create(), cacheFilled: false, trace: trace, routing: routing, registers: DebugRegisterFile.create(), stopThread: 0, stopped: false, stepPosted: EngineStepPost.none, answeredUnder: 0, liftedTraps: EngineLiftedTrapArray.create(), detached: false, closed: false, holdArmed: false, lastReason: 0, lastFault: 0, lastPc: 0, lastConditionMissed: false}

		return engine.awaitEntryStop()
	end 'start'

	// ⭐ The first stop is Windows' own initial breakpoint, which arrives before any of the program's own
	// code runs. It is the window in which asynchronous preemption is withdrawn, because from here on a
	// monitor rewriting a stopped thread's registers would race the debugger's own writes.
	function awaitEntryStop() returns EngineStart
		let deadline = debugDeadlineAfter(self.stopTimeoutMs)

		while not debugDeadlinePassed(deadline) 'poll'
			self.pumpTheProgramsOutput()

			match self.oneEntrySlice() 'slice'
				keepWaiting then continue
				landed then break 'poll'
				ended(outcome) then return EngineStart.neverStopped(outcome)
			end 'slice'
		end 'poll'

		if not self.recordedAStop() 'nothingStopped'
			return EngineStart.neverStopped(self.close())
		end 'nothingStopped'

		self.withdrawAsyncPreemption()

		return EngineStart.ready(self)
	end 'awaitEntryStop'

	function oneEntrySlice() returns EngineEntrySlice
		match self.backend.waitForStop(WaitSliceMs as BackendWaitBudgetMs) 'seen'
			timedOut then return EngineEntrySlice.keepWaiting
			threadStarted or
				threadExited then return EngineEntrySlice.keepWaiting
			signalled then return self.entryEnded(self.close())
			exited(code) then return self.entryEnded(self.settledWith(code))
			stopped(thread, reason, faultCode, address) then return self.entryLanded(thread, reason: reason, faultCode: faultCode, address: address)
		end 'seen'
	end 'oneEntrySlice'

	function entryEnded(outcome TargetOutcome) returns EngineEntrySlice
		return EngineEntrySlice.ended(self.closedAfter(outcome))
	end 'entryEnded'

	function entryLanded(thread BackendThreadId, reason BackendStopReason, faultCode BackendWord, address DebugAddress) returns EngineEntrySlice
		match self.landedAt(thread, reason: reason, faultCode: faultCode, address: address) 'landed'
			stopped then return EngineEntrySlice.landed
			timedOut then return EngineEntrySlice.keepWaiting
			ended(outcome) then return self.entryEnded(outcome)
		end 'landed'
	end 'entryLanded'

	function recordedAStop() returns bool
		return self.stopped
	end 'recordedAStop'

	export function imageTextBase() returns DebugAddress
		return self.textBase
	end 'imageTextBase'

	export function imageTextSize() returns DebugAddress
		return self.textSize
	end 'imageTextSize'

	export function walkBudgetMs() returns StopTimeoutMs
		return self.stopTimeoutMs
	end 'walkBudgetMs'

	// ⛔ The detach comes FIRST and the kill after it: Windows will not let a debuggee die while a debug event
	// is outstanding and its debugger is still alive, so reaping before letting go wedges the pair — the
	// child sits burning nothing and the reap never returns.
	export function close() returns TargetOutcome
		if self.backend.endsTheProgramItself() 'theBackendEndsTheProgramItself'
			_ = self.backend.killTheProgram()

			return self.closedAfter(self.target.reap())
		end 'theBackendEndsTheProgramItself'

		_ = self.detach()

		return self.closedAfter(self.target.reap())
	end 'close'

	export function closeLeavingItRunning() returns TargetOutcome
		_ = self.detach()

		return self.closedAfter(self.target.letGo())
	end 'closeLeavingItRunning'

	function closedAfter(outcome TargetOutcome) returns TargetOutcome
		if self.closed 'alreadyClosed'
			return outcome
		end 'alreadyClosed'

		self.closed = true
		self.pumpTheProgramsOutput()
		self.backend.close()
		closeTraceRing(self.trace)
		releaseDebugSessionPin()

		return outcome
	end 'closedAfter'

	// ⭐ A detach restores every byte the debugger wrote, lifts every hold, puts asynchronous preemption
	// back and then lets the kernel go: the program runs on and reports its OWN ending, which the
	// kill-on-debugger-exit default could never do.
	export function detach() returns CommandOutcome
		if self.detached 'alreadyLetGo'
			return CommandOutcome.done
		end 'alreadyLetGo'

		self.clearEveryBreakpoint()
		self.liftEveryHold()
		self.restoreAsyncPreemption()

		if not self.backend.detach() 'theKernelRefused'
			return CommandOutcome.refused(DebugUnwritableReason)
		end 'theKernelRefused'

		self.detached = true
		self.stopped = false

		return CommandOutcome.done
	end 'detach'

	export function hasDetached() returns bool
		return self.detached
	end 'hasDetached'

	export function takeOutput() returns CollectedLines
		self.pumpTheProgramsOutput()

		return self.collectedOutput()
	end 'takeOutput'

	// ⭐ **THE PROGRAM's OUTPUT REACHES THE DRIVER BY ONE OF TWO ROADS AND BOTH ARE PUMPED HERE.** A debuggee
	// this process launched writes down a pipe; one a stub launched writes to the stub, which forwards it over
	// the debug connection — and the driver routes either the same way.
	function pumpTheProgramsOutput()
		self.target.pump()
		self.target.noteFaultSeen(routeStubOutput(self.backend.takeStubOutput(), routing: self.routing))
	end 'pumpTheProgramsOutput'

	export function collectedOutput() returns CollectedLines
		return match self.routing 'where'
			verbatim or
				allToStandardError gives CollectedLines.create()
			collect(sink) gives sink.takeAll()
		end 'where'
	end 'collectedOutput'

	export function traceSlice(mark DebugAddress, since DebugTraceSince, limit DebugTraceTally) returns DebugTraceSlice
		match self.trace 'ring'
			untraced then return DebugTraceSlice.missing(DebugTraceNotRequestedReason)
			noProducer then return DebugTraceSlice.missing(DebugTraceNoProducerReason)
			ring(collector) then return slicedFrom(collector, mark: mark, since: since, limit: limit)
		end 'ring'
	end 'traceSlice'

	function pumpTrace()
		match self.trace 'ring'
			untraced or
				noProducer then break 'ring'
			ring(collector) then collector.pump()
		end 'ring'
	end 'pumpTrace'

	// --- the debuggee's memory ---

	export function readDebuggeeWord(address DebugAddress, width DebugWidth) returns DebuggeeWord throws DebugMemoryError
		let bytes = try self.readDebuggeeBytes(address, length: width as EngineReadLength)

		match debugLittleEndianAt(bytes, at: 0, width: width) 'read'
			pastTheBytes then panic("DebugEngine.readDebuggeeWord: the {bytes.count()} bytes read from {address:x} are all in hand")
			read(value) then return value
		end 'read'
	end 'readDebuggeeWord'

	export function readDebuggeeText(address DebugAddress, length EngineReadLength) returns String throws DebugMemoryError
		return String.from(try self.readDebuggeeBytes(address, length: length))
	end 'readDebuggeeText'

	function readDebuggeeBytes(address DebugAddress, length EngineReadLength) returns ByteArray throws DebugMemoryError
		if length == 0 'nothingAsked'
			return ByteArray.create()
		end 'nothingAsked'

		if not self.cacheCovers(address, length: length) 'notHeld'
			try self.fillCache(address, length: length)
		end 'notHeld'

		if not self.cacheCovers(address, length: length) 'shortRead'
			throw DebugMemoryError.notReadable
		end 'shortRead'

		return self.slicedCache(address, length: length)
	end 'readDebuggeeBytes'

	function cacheCovers(address DebugAddress, length EngineReadLength) returns bool
		return self.cacheFilled and address >= self.cacheBase and address + (length as DebugAddress) <= self.cacheBase + (self.cacheBytes.count() as DebugAddress)
	end 'cacheCovers'

	function slicedCache(address DebugAddress, length EngineReadLength) returns ByteArray
		var taken = ByteArray.create()
		let start = address - self.cacheBase

		for i in 0 upto length 'eachByte'
			taken.push(try self.cacheBytes.get((start + (i as DebugAddress)) as ElementIndex) otherwise panic("DebugEngine.slicedCache: the caller asked a span the cache was just proven to hold"))
		end 'eachByte'

		return taken
	end 'slicedCache'

	function fillCache(address DebugAddress, length EngineReadLength) throws DebugMemoryError
		if self.fetchedInto(address, length: MaxEngineReadLength) 'aWholeChunk'
			return
		end 'aWholeChunk'

		if self.fetchedInto(address, length: length as DebugAddress) 'exactlyWhatWasAsked'
			return
		end 'exactlyWhatWasAsked'

		throw DebugMemoryError.notReadable
	end 'fillCache'

	function fetchedInto(address DebugAddress, length DebugAddress) returns bool
		match self.backend.readMemory(address, bytes: length as BackendByteCount) 'read'
			unreadable then return false
			read(bytes) then self.holdInCache(address, bytes: bytes)
		end 'read'

		return true
	end 'fetchedInto'

	// ⛔ Every read of the `.text` window answers the byte the PROGRAM has, not the trap the debugger
	// planted: a disassembly at a breakpoint would otherwise show `0xCC` where the instruction is.
	function holdInCache(address DebugAddress, bytes ByteArray)
		var held = bytes.clone()

		for breakpoint in self.breakpoints 'eachBreakpoint'
			for (iter, original) in breakpoint.originalBytes.withIterator() 'eachPlantedByte'
				let at = breakpoint.address + (iter.index() as DebugAddress)

				if at >= address and at < address + (bytes.count() as DebugAddress) 'insideTheWindow'
					try held.set((at - address) as ElementIndex, value: original) otherwise panic("DebugEngine.holdInCache: the planted address was just proven to be inside the window")
				end 'insideTheWindow'
			end 'eachPlantedByte'
		end 'eachBreakpoint'

		self.cacheBase = address
		self.cacheBytes = held
		self.cacheFilled = true
	end 'holdInCache'

	export function registerValue(number EngineRegisterNumber) returns DebuggeeWord
		return self.registers.valueOf(number as BackendRegisterNumber)
	end 'registerValue'

	// --- breakpoints ---

	export function armBreakpoint(offset DebugAddress, forTheUser bool) returns CommandOutcome
		if offset >= self.textSize 'pastTheImage'
			return CommandOutcome.refused(DebugOutOfTextReason)
		end 'pastTheImage'

		if self.armedAt(self.textBase + offset) 'armedAlready'
			self.recordBreakpoint(offset, originalBytes: self.originalBytesAt(offset), usersOwn: forTheUser or self.userBreakpointAt(self.textBase + offset), conditioned: false, condition: DebugConditionRecord.unconditioned())
			self.forgetTheHoldAt(offset)

			return CommandOutcome.done
		end 'armedAlready'

		var original = ByteArray.create()

		match self.backend.plantTrap(self.textBase + offset) 'planted'
			unreadable then return CommandOutcome.refused(DebugOutOfTextReason)
			unwritable then return CommandOutcome.refused(DebugUnwritableReason)
			planted(bytes) then original = bytes
		end 'planted'

		self.recordBreakpoint(offset, originalBytes: original, usersOwn: forTheUser, conditioned: false, condition: DebugConditionRecord.unconditioned())
		self.forgetTheHoldAt(offset)
		self.cacheFilled = false

		return CommandOutcome.done
	end 'armBreakpoint'

	function plantTrapAt(address DebugAddress) returns bool
		return match self.backend.plantTrap(address) 'planted'
			planted gives true
			unreadable or
				unwritable gives false
		end 'planted'
	end 'plantTrapAt'

	function originalBytesAt(offset DebugAddress) returns ByteArray
		return match self.breakpointAt(self.textBase + offset) 'known'
			none gives ByteArray.create()
			at(breakpoint) gives breakpoint.originalBytes
		end 'known'
	end 'originalBytesAt'

	export function clearBreakpoint(offset DebugAddress) returns CommandOutcome
		if self.returnPointAt(self.textBase + offset) 'theWalkHoldsTheAddress'
			self.forgetBreakpoint(offset)

			return CommandOutcome.done
		end 'theWalkHoldsTheAddress'

		match self.breakpointAt(self.textBase + offset) 'known'
			none then return CommandOutcome.refused(DebugNoSuchBreakpointReason)
			at then break 'known'
		end 'known'

		let restored = self.restoreBytesAt(offset)
		self.forgetBreakpoint(offset)
		self.cacheFilled = false

		return CommandOutcome.done if restored else CommandOutcome.refused(DebugUnwritableReason)
	end 'clearBreakpoint'

	function restoreBytesAt(offset DebugAddress) returns bool
		match self.breakpointAt(self.textBase + offset) 'known'
			none then return true
			at then break 'known'
		end 'known'

		return self.backend.liftTrap(self.textBase + offset, original: self.originalBytesAt(offset))
	end 'restoreBytesAt'

	export function clearEveryBreakpoint()
		_ = self.liftReturnPoint()
		var armed = DebugAddressArray.create()

		for breakpoint in self.breakpoints 'eachBreakpoint'
			armed.push(breakpoint.offset)
		end 'eachBreakpoint'

		for offset in armed 'eachArmed'
			_ = self.clearBreakpoint(offset)
		end 'eachArmed'
	end 'clearEveryBreakpoint'

	export function attachCondition(offset DebugAddress, record DebugConditionRecord) returns CommandOutcome
		match self.breakpointAt(self.textBase + offset) 'known'
			none then return CommandOutcome.refused(DebugNoSuchBreakpointReason)
			at then break 'known'
		end 'known'

		let held = self.returnPointHeldOver(offset, conditioned: true)

		if not held.accepted() 'theWalkCouldNotHoldItsReturn'
			return held
		end 'theWalkCouldNotHoldItsReturn'

		self.recordBreakpoint(offset, originalBytes: self.originalBytesAt(offset), usersOwn: true, conditioned: true, condition: record)

		return CommandOutcome.done
	end 'attachCondition'

	export function clearCondition(offset DebugAddress) returns CommandOutcome
		match self.breakpointAt(self.textBase + offset) 'known'
			none then return CommandOutcome.refused(DebugNoSuchBreakpointReason)
			at then break 'known'
		end 'known'

		self.recordBreakpoint(offset, originalBytes: self.originalBytesAt(offset), usersOwn: true, conditioned: false, condition: DebugConditionRecord.unconditioned())

		return CommandOutcome.done
	end 'clearCondition'

	// ⚠ Two questions that must not be confused: this one is PHYSICAL — a trap byte stands here, whoever
	// planted it — while `userBreakpointAt` below is the reader's, and answers only for a breakpoint the user
	// asked for. Reporting a stop by this one presents a walk's own return point as a user's hit.
	export function armedAt(address DebugAddress) returns bool
		return match self.breakpointAt(address) 'known'
			none gives false
			at gives true
		end 'known'
	end 'armedAt'

	export function userBreakpointAt(address DebugAddress) returns bool
		return match self.breakpointAt(address) 'known'
			none gives false
			at(breakpoint) gives breakpoint.usersOwn
		end 'known'
	end 'userBreakpointAt'

	function conditionedAt(address DebugAddress) returns bool
		return match self.breakpointAt(address) 'known'
			none gives false
			at(breakpoint) gives breakpoint.conditioned
		end 'known'
	end 'conditionedAt'

	function breakpointAt(address DebugAddress) returns EngineBreakpointLookup
		for breakpoint in self.breakpoints 'eachBreakpoint'
			if breakpoint.address == address 'thisOne'
				return EngineBreakpointLookup.at(breakpoint)
			end 'thisOne'
		end 'eachBreakpoint'

		return EngineBreakpointLookup.none
	end 'breakpointAt'

	function recordBreakpoint(offset DebugAddress, originalBytes ByteArray, usersOwn bool, conditioned bool, condition DebugConditionRecord)
		self.forgetBreakpoint(offset)
		self.breakpoints.push(EngineBreakpoint.create(offset, address: self.textBase + offset, originalBytes: originalBytes, usersOwn: usersOwn, conditioned: conditioned, condition: condition))
	end 'recordBreakpoint'

	function forgetBreakpoint(offset DebugAddress)
		var kept = EngineBreakpointArray.create()

		for breakpoint in self.breakpoints 'eachBreakpoint'
			if breakpoint.offset != offset 'anotherOne'
				kept.push(breakpoint)
			end 'anotherOne'
		end 'eachBreakpoint'

		self.breakpoints = kept
	end 'forgetBreakpoint'

	// --- return points ---

	module function plantReturnPoint(point DebugReturnPoint) returns CommandOutcome
		if self.returnPointAt(point.address) 'plantedAlready'
			panic("DebugEngine.plantReturnPoint: a walk plants each of its return points once, and the one at {hexWord(point.address)} already stands")
		end 'plantedAlready'

		let offset = point.address - self.textBase

		// A conditioned byte the user armed is held, so a false condition still stops the walk there
		// rather than running past its return point.
		if self.armedAt(point.address) 'theUserArmedItAlready'
			let conditioned = self.conditionedAt(point.address)
			self.returnPoints.push(EngineReturnPoint.at(point, offset: offset, heldOverACondition: conditioned))

			return CommandOutcome.done
		end 'theUserArmedItAlready'

		let outcome = self.armBreakpoint(offset, forTheUser: false)

		if outcome.accepted() 'planted'
			self.returnPoints.push(EngineReturnPoint.at(point, offset: offset, heldOverACondition: false))
		end 'planted'

		return outcome
	end 'plantReturnPoint'

	function returnPointHeldOver(offset DebugAddress, conditioned bool) returns CommandOutcome
		match self.unheldReturnPointAt(offset) 'standing'
			none then return CommandOutcome.done
			at then break 'standing'
		end 'standing'

		if not conditioned 'nothingToHold'
			return CommandOutcome.done
		end 'nothingToHold'

		var kept = EngineReturnPointArray.create()

		for standing in self.returnPoints 'eachPoint'
			kept.push(standing.heldIfAt(offset))
		end 'eachPoint'

		self.returnPoints = kept

		return CommandOutcome.done
	end 'returnPointHeldOver'

	function unheldReturnPointAt(offset DebugAddress) returns DebugReturnPointLookup
		for standing in self.returnPoints 'eachPoint'
			let unheld = standing.unheldPointAt(offset)

			if unheld.found() 'thisOne'
				return unheld
			end 'thisOne'
		end 'eachPoint'

		return DebugReturnPointLookup.none
	end 'unheldReturnPointAt'

	function forgetTheHoldAt(offset DebugAddress)
		var kept = EngineReturnPointArray.create()

		for standing in self.returnPoints 'eachPoint'
			kept.push(standing.withoutTheHoldAt(offset))
		end 'eachPoint'

		self.returnPoints = kept
	end 'forgetTheHoldAt'

	module function rebaseReturnPoint(greenThread DebugAddress, from DebugAddress, to DebugAddress)
		var kept = EngineReturnPointArray.create()

		for standing in self.returnPoints 'eachPoint'
			kept.push(standing.movedWith(greenThread, from: from, to: to))
		end 'eachPoint'

		self.returnPoints = kept
	end 'rebaseReturnPoint'

	module function returnPointsStand() returns bool
		return not self.returnPoints.isEmpty()
	end 'returnPointsStand'

	module function returnPointReachedBy(landed EngineStop) returns DebugReturnPointLookup
		for standing in self.returnPoints 'eachPoint'
			let reached = standing.pointReachedBy(landed)

			if reached.found() 'thisOne'
				return reached
			end 'thisOne'
		end 'eachPoint'

		return DebugReturnPointLookup.none
	end 'returnPointReachedBy'

	// ⛔ The roster is DRAINED before the loop, not iterated in place. `clearBreakpoint` short-circuits on an
	// address the walk still holds — it forgets the record and restores no byte — so lifting from a roster
	// that still names the point leaves a live `int3` in the debuggee with `armedAt` reading clean.
	export function liftReturnPoint() returns CommandOutcome
		let standing = self.returnPoints
		self.returnPoints = EngineReturnPointArray.create()
		var outcome = CommandOutcome.done

		for point in standing 'eachPoint'
			let lifted = self.liftedOne(point.offsetOf())

			if outcome.accepted() 'noFailureYet'
				outcome = lifted
			end 'noFailureYet'
		end 'eachPoint'

		return outcome
	end 'liftReturnPoint'

	// The guard pairs with `plantReturnPoint`'s `armedAt` road: a point that reused a byte the user had
	// already armed is left standing, and one the walk armed itself is restored. Lifting either way round
	// would clear the user's breakpoint or leave the walk's behind.
	function liftedOne(offset DebugAddress) returns CommandOutcome
		if self.userBreakpointAt(self.textBase + offset) 'theUserOwnsTheByte'
			return CommandOutcome.done
		end 'theUserOwnsTheByte'

		return self.clearBreakpoint(offset)
	end 'liftedOne'

	export function returnPointAt(address DebugAddress) returns bool
		for standing in self.returnPoints 'eachPoint'
			if standing.standsAt(address) 'thisOne'
				return true
			end 'thisOne'
		end 'eachPoint'

		return false
	end 'returnPointAt'

	export function answeredUnderAnUnseenStop() returns bool
		return self.answeredUnder > (self.lastStopSeq as DebugAddress)
	end 'answeredUnderAnUnseenStop'

	// --- resuming, stepping and interrupting ---

	export function resume() returns CommandOutcome
		self.forgetThePostedStep()

		return self.resumedFromTheStop(false)
	end 'resume'

	export function forgetThePostedStep()
		self.stepPosted = EngineStepPost.none
	end 'forgetThePostedStep'

	export function stepOneInstruction() returns CommandOutcome
		if not self.stopped 'nothingIsParked'
			return CommandOutcome.nothingParked
		end 'nothingIsParked'

		if self.lastStopWasAFault() 'aFaultIsTerminal'
			return CommandOutcome.refused(DebugFaultIsTerminalReason)
		end 'aFaultIsTerminal'

		let outcome = self.resumedFromTheStop(true)

		if outcome.accepted() 'aStepIsOutstanding'
			self.stepPosted = EngineStepPost.on(self.stopMachine())
		end 'aStepIsOutstanding'

		return outcome
	end 'stepOneInstruction'

	// ⭐⭐ Delve's dance, and the only way to resume off a byte the debugger owns: restore the original,
	// single-step it, and re-plant the trap at the next stop. `steppingOverABreakpoint` is what makes that
	// intermediate stop the engine's own rather than the reader's.
	function resumedFromTheStop(reportingTheStep bool) returns CommandOutcome
		if not self.stopped 'nothingIsParked'
			return CommandOutcome.nothingParked
		end 'nothingIsParked'

		if self.lastStopWasAFault() and reportingTheStep 'aFaultIsTerminal'
			return CommandOutcome.refused(DebugFaultIsTerminalReason)
		end 'aFaultIsTerminal'

		self.cacheFilled = false
		let pc = self.registers.programCounter()
		let thread = self.stopThread
		self.forgetLiftedTrap(thread)

		if self.armedAt(pc) 'sittingOnOurOwnTrap'
			if not self.restoreBytesAt(pc - self.textBase) 'unwritable'
				return CommandOutcome.refused(DebugUnwritableReason)
			end 'unwritable'

			self.liftedTraps.push(EngineLiftedTrap.create(thread, offset: pc - self.textBase, reportTheStep: reportingTheStep))
			self.stopped = false

			return CommandOutcome.done if self.backend.stepThread(thread) else CommandOutcome.refused(DebugUnwritableReason)
		end 'sittingOnOurOwnTrap'

		self.stopped = false

		if reportingTheStep 'aStep'
			return CommandOutcome.done if self.backend.stepThread(thread) else CommandOutcome.refused(DebugUnwritableReason)
		end 'aStep'

		return CommandOutcome.done if self.backend.resumeAll() else CommandOutcome.refused(DebugUnwritableReason)
	end 'resumedFromTheStop'

	function byteIsReplanted(offset DebugAddress) returns bool
		if self.someThreadStepsOver(offset) 'itIsStillLifted'
			return true
		end 'itIsStillLifted'

		return self.plantTrapAt(self.textBase + offset)
	end 'byteIsReplanted'

	function someThreadStepsOver(offset DebugAddress) returns bool
		for lifted in self.liftedTraps 'eachLifted'
			if lifted.offset == offset 'thisByte'
				return true
			end 'thisByte'
		end 'eachLifted'

		return false
	end 'someThreadStepsOver'

	function liftedTrapOn(thread BackendThreadId) returns EngineLiftedTrapLookup
		for lifted in self.liftedTraps 'eachLifted'
			if lifted.thread == thread 'thisOne'
				return EngineLiftedTrapLookup.at(lifted)
			end 'thisOne'
		end 'eachLifted'

		return EngineLiftedTrapLookup.none
	end 'liftedTrapOn'

	function forgetLiftedTrap(thread BackendThreadId)
		var kept = EngineLiftedTrapArray.create()

		for lifted in self.liftedTraps 'eachLifted'
			if lifted.thread != thread 'anotherThread'
				kept.push(lifted)
			end 'anotherThread'
		end 'eachLifted'

		self.liftedTraps = kept
	end 'forgetLiftedTrap'

	export function requestPause() returns CommandOutcome
		if self.stopped 'alreadyStopped'
			return CommandOutcome.done
		end 'alreadyStopped'

		self.cacheFilled = false

		if not self.backend.requestStop() 'theKernelRefused'
			return CommandOutcome.refused(DebugNotPausableReason)
		end 'theKernelRefused'

		let deadline = debugDeadlineAfter(self.stopTimeoutMs + PauseAttemptBudgetMs)

		while not debugDeadlinePassed(deadline) 'wait'
			match self.lastLookForAStop() 'seen'
				stopped then return CommandOutcome.done
				ended(ending) then return CommandOutcome.gone(ending)
				timedOut then continue
			end 'seen'
		end 'wait'

		self.backend.abandonStopRequest()

		return CommandOutcome.refused(DebugNotPausableReason)
	end 'requestPause'

	function lastStopWasAFault() returns bool
		return self.stopped and self.lastReason == DbgStopReasonFault
	end 'lastStopWasAFault'

	// --- waiting for a stop ---

	export function pollForStop(sliceMs StopTimeoutMs) returns StopWait
		let deadline = debugDeadlineAfter(sliceMs)

		while not debugDeadlinePassed(deadline) 'poll'
			let look = self.lastLookForAStop()

			match look 'seen'
				stopped or
					ended then return look
				timedOut then continue
			end 'seen'
		end 'poll'

		return self.lastLookForAStop()
	end 'pollForStop'

	// The child's two streams are pumped on every look, because a full pipe blocks the debuggee and reads
	// back as a timeout.
	export function lastLookForAStop() returns StopWait
		self.pumpTheProgramsOutput()
		self.pumpTrace()

		if self.detached 'letGo'
			return self.lookAtADetachedProgram()
		end 'letGo'

		if self.stopped 'aStopAlreadyStands'
			return StopWait.timedOut if self.parkedAtEntry() else StopWait.stopped(self.currentStop())
		end 'aStopAlreadyStands'

		match self.backend.waitForStop(WaitSliceMs as BackendWaitBudgetMs) 'seen'
			timedOut then return StopWait.timedOut
			threadStarted or
				threadExited then return StopWait.timedOut
			signalled(status) then return StopWait.ended(self.settledWith(status as BackendExitCode))
			exited(code) then return StopWait.ended(self.settledWith(code))
			stopped(thread, reason, faultCode, address) then return self.landedAt(thread, reason: reason, faultCode: faultCode, address: address)
		end 'seen'
	end 'lastLookForAStop'

	function parkedAtEntry() returns bool
		return self.lastReason == (DbgStopReasonEntry as DebugAddress)
	end 'parkedAtEntry'

	function lookAtADetachedProgram() returns StopWait
		let outcome = self.target.poll()

		if targetIsRunning(outcome) 'stillRunning'
			return StopWait.timedOut
		end 'stillRunning'

		return StopWait.ended(self.target.reap())
	end 'lookAtADetachedProgram'

	// ⚠ The last of the program's output is drained HERE, because the ending is the last thing the driver
	// asks about: a stub forwards what the program wrote over the same connection the exit arrived on, and
	// nothing polls it afterwards.
	function settledWith(code BackendExitCode) returns TargetOutcome
		self.stopped = false
		self.pumpTheProgramsOutput()

		return self.target.settleWith(code as DebugExitCode)
	end 'settledWith'

	function landedAt(thread BackendThreadId, reason BackendStopReason, faultCode BackendWord, address DebugAddress) returns StopWait
		self.stopThread = thread

		if not self.registersStandOn(thread) 'theStoppedThreadsContextIsUnreadable'
			return StopWait.timedOut
		end 'theStoppedThreadsContextIsUnreadable'

		self.cacheFilled = false

		let ranATrap = self.trapTheStepExecuted(reason, address: address)
		let landedReason = BackendStopReason.breakpoint if ranATrap.found() else reason
		let landedAddress = ranATrap.addressOr(address)

		self.rewindOntoAPlantedTrap(thread, reason: landedReason, address: landedAddress)
		self.standOnAProgramThread(thread, reason: landedReason)

		match self.liftedTrapOn(self.stopThread) 'lifted'
			none then break 'lifted'
			at(lifted) then return self.replantedAfterTheStepOver(lifted, reason: landedReason, faultCode: faultCode, address: landedAddress)
		end 'lifted'

		return self.landedFresh(landedReason, faultCode: faultCode, address: landedAddress)
	end 'landedAt'

	function trapTheStepExecuted(reason BackendStopReason, address DebugAddress) returns EngineExecutedTrap
		if reason != BackendStopReason.singleStep 'notAStepLanding'
			return EngineExecutedTrap.none
		end 'notAStepLanding'

		let trap = atTheTrap(address)

		if trap == address or not self.armedAt(trap) 'theStepLandedOnAnInstructionOfItsOwn'
			return EngineExecutedTrap.none
		end 'theStepLandedOnAnInstructionOfItsOwn'

		if self.someThreadStepsOver(trap - self.textBase) 'theStepWasOverThatVeryByte'
			return EngineExecutedTrap.none
		end 'theStepWasOverThatVeryByte'

		if not self.trapInstructionStandsAt(trap) 'theByteIsNotTheDebuggersAnyMore'
			return EngineExecutedTrap.none
		end 'theByteIsNotTheDebuggersAnyMore'

		return EngineExecutedTrap.at(trap)
	end 'trapTheStepExecuted'

	function landedFresh(reason BackendStopReason, faultCode BackendWord, address DebugAddress) returns StopWait
		match reason 'why'
			entry then return self.stoodAt(DbgStopReasonEntry, fault: 0, pc: address, conditionMissed: false)
			singleStep then return self.steppedTo(address)
			interrupt then return self.stoodAt(DbgStopReasonPause, fault: 0, pc: self.registers.programCounter(), conditionMissed: false)
			trap then return self.stoodAt(DbgStopReasonTrap, fault: 0, pc: address, conditionMissed: false)
			fault then return self.stoodAt(DbgStopReasonFault, fault: debugAddressOrZero(faultCode as DebuggeeWord), pc: address, conditionMissed: false)
			breakpoint then return self.reachedABreakpoint(address)
		end 'why'
	end 'landedFresh'

	function insideTheImage(pc DebugAddress) returns bool
		return pc >= self.textBase and pc < self.textBase + self.textSize
	end 'insideTheImage'

	function standOnAProgramThread(reported BackendThreadId, reason BackendStopReason)
		if reason != BackendStopReason.interrupt 'notARequestedHalt'
			return
		end 'notARequestedHalt'

		if self.insideTheImage(self.registers.programCounter()) 'alreadyOnOne'
			return
		end 'alreadyOnOne'

		for candidate in self.backend.listThreads() 'eachThread'
			if candidate == reported 'theInjectedOne'
				continue
			end 'theInjectedOne'

			if self.stoodOnIfItRunsTheProgram(candidate) 'thisOneRunsTheProgram'
				return
			end 'thisOneRunsTheProgram'
		end 'eachThread'
	end 'standOnAProgramThread'

	function stoodOnIfItRunsTheProgram(candidate BackendThreadId) returns bool
		match self.backend.readRegisters(candidate) 'itsContext'
			unreadable then return false
			read(file) then return self.stoodOn(candidate, file: file)
		end 'itsContext'
	end 'stoodOnIfItRunsTheProgram'

	function stoodOn(candidate BackendThreadId, file DebugRegisterFile) returns bool
		if not self.insideTheImage(file.programCounter()) 'anotherStack'
			return false
		end 'anotherStack'

		self.stopThread = candidate
		self.registers = file

		return true
	end 'stoodOn'

	function rewindOntoAPlantedTrap(thread BackendThreadId, reason BackendStopReason, address DebugAddress)
		if reason != BackendStopReason.breakpoint 'notATrapStop'
			return
		end 'notATrapStop'

		if not self.armedAt(address) 'notATrapThisDebuggerPlanted'
			return
		end 'notATrapThisDebuggerPlanted'

		if self.registers.programCounter() == address 'theProgramCounterAlreadyStands'
			return
		end 'theProgramCounterAlreadyStands'

		if not self.backend.setProgramCounter(thread, address: address) 'unwritable'
			panic("DebugEngine.rewindOntoAPlantedTrap: the trap at {address} was reported and the stopped thread's program counter could not be put back onto it, so a resume would re-enter the instruction one byte in")
		end 'unwritable'

		if not self.registersStandOn(thread) 'theContextIsUnreadable'
			panic("DebugEngine.rewindOntoAPlantedTrap: the program counter of the stopped thread was put back onto the trap at {address} and its register file could not then be read, so every later answer would be taken from the file the stop arrived with")
		end 'theContextIsUnreadable'
	end 'rewindOntoAPlantedTrap'

	function registersStandOn(thread BackendThreadId) returns bool
		match self.backend.readRegisters(thread) 'itsContext'
			unreadable then return false
			read(file) then self.registers = file
		end 'itsContext'

		return true
	end 'registersStandOn'

	function replantedAfterTheStepOver(lifted EngineLiftedTrap, reason BackendStopReason, faultCode BackendWord, address DebugAddress) returns StopWait
		self.forgetLiftedTrap(lifted.thread)

		if not self.byteIsReplanted(lifted.offset) 'unwritable'
			return StopWait.timedOut
		end 'unwritable'

		self.cacheFilled = false

		if lifted.reportTheStep 'theReaderAskedForOneInstruction'
			return self.steppedTo(self.registers.programCounter())
		end 'theReaderAskedForOneInstruction'

		match reason 'why'
			singleStep then break 'why'

			entry or
				breakpoint or
				interrupt or
				trap or
				fault then return self.landedFresh(reason, faultCode: faultCode, address: address)
		end 'why'

		if not self.backend.resumeAll() 'unresumable'
			return StopWait.timedOut
		end 'unresumable'

		return StopWait.timedOut
	end 'replantedAfterTheStepOver'

	function steppedTo(address DebugAddress) returns StopWait
		if not self.userBreakpointAt(address) 'noByteOfTheUsersHere'
			return self.stoodAt(DbgStopReasonStep, fault: 0, pc: address, conditionMissed: false)
		end 'noByteOfTheUsersHere'

		if self.conditionHoldsAt(address) 'theConditionIsMet'
			return self.stoodAt(DbgStopReasonBreakpoint, fault: 0, pc: address, conditionMissed: false)
		end 'theConditionIsMet'

		return self.stoodAt(DbgStopReasonStep, fault: 0, pc: address, conditionMissed: true)
	end 'steppedTo'

	// ⭐ The condition is judged HERE, after the stop, and a false one is resumed transparently: the
	// reader never sees the hit, which is what makes a conditional breakpoint mean what it says.
	function reachedABreakpoint(address DebugAddress) returns StopWait
		match self.breakpointAt(address) 'known'
			none then return self.reachedATrapNobodyPlanted(address)
			at then break 'known'
		end 'known'

		let holds = self.conditionHoldsAt(address)

		if holds 'theConditionIsMet'
			return self.stoodAt(DbgStopReasonBreakpoint, fault: 0, pc: address, conditionMissed: false)
		end 'theConditionIsMet'

		if self.returnPointAt(address) or self.walkHoldsTheByteAt(address) 'theWalkWantsItAnyway'
			return self.stoodAt(DbgStopReasonBreakpoint, fault: 0, pc: address, conditionMissed: true)
		end 'theWalkWantsItAnyway'

		self.standAt(DbgStopReasonBreakpoint, fault: 0, pc: address, conditionMissed: true)

		if not self.resumedFromTheStop(false).accepted() 'couldNotResume'
			return StopWait.stopped(self.currentStop())
		end 'couldNotResume'

		return StopWait.timedOut
	end 'reachedABreakpoint'

	function reachedATrapNobodyPlanted(address DebugAddress) returns StopWait
		self.standAt(DbgStopReasonTrap, fault: 0, pc: address, conditionMissed: false)

		if self.trapInstructionStandsAt(address) 'theProgramsOwnTrap'
			return StopWait.stopped(self.currentStop())
		end 'theProgramsOwnTrap'

		if not self.resumedFromTheStop(false).accepted() 'couldNotResume'
			return StopWait.stopped(self.currentStop())
		end 'couldNotResume'

		return StopWait.timedOut
	end 'reachedATrapNobodyPlanted'

	function trapInstructionStandsAt(address DebugAddress) returns bool
		let trap = hostTrapShape()

		return match self.backend.readMemory(address, bytes: trap.bytes()) 'read'
			unreadable gives false
			read(bytes) gives bytes.equals(trap.instruction)
		end 'read'
	end 'trapInstructionStandsAt'

	function walkHoldsTheByteAt(address DebugAddress) returns bool
		for standing in self.returnPoints 'eachPoint'
			if standing.offsetOf() == address - self.textBase and standing.holdsTheWalksHold() 'thisOne'
				return true
			end 'thisOne'
		end 'eachPoint'

		return false
	end 'walkHoldsTheByteAt'

	function conditionHoldsAt(address DebugAddress) returns bool
		match self.breakpointAt(address) 'known'
			none then return true
			at(breakpoint) then return true if not breakpoint.conditioned else debugConditionHolds(breakpoint.condition, memory: self, framePointer: self.registers.framePointer())
		end 'known'
	end 'conditionHoldsAt'

	function stoodAt(reason DebugAddress, fault DebugAddress, pc DebugAddress, conditionMissed bool) returns StopWait
		self.standAt(reason, fault: fault, pc: pc, conditionMissed: conditionMissed)

		return StopWait.stopped(self.currentStop())
	end 'stoodAt'

	function standAt(reason DebugAddress, fault DebugAddress, pc DebugAddress, conditionMissed bool)
		self.stopped = true
		self.lastReason = reason
		self.lastFault = fault
		self.lastPc = pc
		self.lastConditionMissed = conditionMissed
		self.lastStopSeq = self.lastStopSeq + 1
		self.answeredUnder = self.lastStopSeq as DebugAddress
		self.stepPosted = EngineStepPost.none
	end 'standAt'

	function currentStop() returns EngineStop
		let walk = self.walkedFrom(self.registers.framePointer())
		let greenThread = self.runningGreenThread()

		return match walk 'frames'
			walked(returnPcs, callers, truncated) gives EngineStop.create(self.lastReason, fault: self.lastFault, machine: self.stopMachine(), greenThread: greenThread, traceMark: self.traceMark(), pc: self.lastPc, stackPointer: self.registers.stackPointer(), framePointer: self.registers.framePointer(), returnAddresses: returnPcs, callerFramePointers: callers, truncated: truncated, conditionMissed: self.lastConditionMissed)
		end 'frames'
	end 'currentStop'

	function stopMachine() returns DebugAddress
		return self.stopThread as DebugAddress
	end 'stopMachine'

	// --- the frame-pointer walk, host-side ---

	function walkedFrom(frame DebugAddress) returns EngineWalk
		var returnPcs = DebugAddressArray.create()
		var cursors = DebugAddressArray.create()
		var cursor = frame
		var truncated = false
		var outer = 0 as DebugAddress
		let limit = self.textBase + self.textSize

		while cursor != 0 'ascend'
			let record = try self.readDebuggeeBytes(cursor, length: FrameRecordBytes as EngineReadLength) otherwise break

			let next = wordIn(record, at: 0)
			let returnPc = wordIn(record, at: WordBytes)

			if returnPc < self.textBase or returnPc >= limit 'notAReturnIntoThisImage'
				break
			end 'notAReturnIntoThisImage'

			if returnPcs.count() >= MaxBacktraceFrames 'pastTheWalksBudget'
				truncated = true
				break
			end 'pastTheWalksBudget'

			returnPcs.push(returnPc)
			cursors.push(cursor)
			outer = next

			if next <= cursor 'theChainMustAscend'
				break
			end 'theChainMustAscend'

			cursor = next
		end 'ascend'

		return EngineWalk.walked(returnPcs, callerFramePointers: callersOf(cursors, outer: outer), truncated: truncated)
	end 'walkedFrom'

	// --- the runtime contract ---

	function withdrawAsyncPreemption()
		self.writeContractWord(String.from(SchedAsyncPreemptOffLabel), value: AsyncPreemptionWithdrawn)
	end 'withdrawAsyncPreemption'

	function restoreAsyncPreemption()
		self.writeContractWord(String.from(SchedAsyncPreemptOffLabel), value: 0)
	end 'restoreAsyncPreemption'

	function writeContractWord(name String, value DebuggeeWord)
		match self.contract.globalAt(name) 'known'
			none then break 'known'
			at(address) then _ = self.backend.writeMemory(address, bytes: debuggeeWordBytes(value))
		end 'known'
	end 'writeContractWord'

	export function recordOffset(name String) returns DebugAddress
		return self.contract.offset(name)
	end 'recordOffset'

	function contractWord(name String) returns DebuggeeWord
		match self.contract.globalAt(name) 'known'
			none then return 0
			at(address) then return try self.readDebuggeeWord(address, width: WordBytes as DebugWidth) otherwise 0
		end 'known'
	end 'contractWord'

	function traceMark() returns DebugAddress
		let ring = self.contractWord(String.from(DsBaseLabel))

		if ring <= 0 'noRing'
			return 0
		end 'noRing'

		let cursor = try self.readDebuggeeWord((ring as DebugAddress) + self.contract.offset(DsOffWriteCursorFigureName), width: WordBytes as DebugWidth) otherwise 0

		return debugAddressOrZero(cursor)
	end 'traceMark'

	function runningGreenThread() returns DebugAddress
		let machine = self.machineOfTheStoppedThread()

		if machine == 0 'noScheduler'
			return 0
		end 'noScheduler'

		let gt = self.wordAt(machine + self.contract.offset(MOffCurrentGtFigureName))

		if gt <= 0 'noThread'
			return 0
		end 'noThread'

		let stackBase = self.wordAt((gt as DebugAddress) + self.contract.offset(GtOffStackBaseFigureName))

		return 0 if stackBase == 0 else gt as DebugAddress
	end 'runningGreenThread'

	// ⭐⭐ **THE PAIRING IS AN EXACT EQUALITY, SO BOTH SIDES MUST NAME A THREAD THE SAME WAY.** Which field of a
	// machine that is depends on the backend: the identity a debug interface reports is the identity the
	// scheduler must have recorded, and on Darwin those are two different numbers about one thread.
	function machineOfTheStoppedThread() returns DebugAddress
		return self.machineWhoseFieldHolds(self.contract.offset(self.backend.threadIdentityFigure()), identity: self.stopThread as DebugAddress)
	end 'machineOfTheStoppedThread'

	function machineWhoseFieldHolds(offset DebugAddress, identity DebugAddress) returns DebugAddress
		var machine = self.contractWord(String.from(SchedAllMLabel))
		let linkOffset = self.contract.offset(MOffAllNextFigureName)
		var walked = 0

		while machine > 0 and walked < MaxMachinesWalked 'eachMachine'
			if self.wordAt((machine as DebugAddress) + offset) == identity as DebuggeeWord 'thisOne'
				return machine as DebugAddress
			end 'thisOne'

			machine = self.wordAt((machine as DebugAddress) + linkOffset)
			walked = walked + 1
		end 'eachMachine'

		return 0
	end 'machineWhoseFieldHolds'

	function wordAt(address DebugAddress) returns DebuggeeWord
		return try self.readDebuggeeWord(address, width: WordBytes as DebugWidth) otherwise 0
	end 'wordAt'

	// --- green threads ---

	export function listGreenThreads() returns GreenThreadListing
		if not self.stopped 'nothingIsParked'
			return GreenThreadListing.refused(DebugNotRunningReason)
		end 'nothingIsParked'

		let roster = self.contractWord(String.from(GtAllGLabel))
		let length = self.contractWord(String.from(GtAllGLenLabel))

		if roster <= 0 or length <= 0 'noRosterYet'
			return GreenThreadListing.listed(DebugGreenThreadArray.create(), truncated: false)
		end 'noRosterYet'

		var records = DebugGreenThreadArray.create()

		for index in 0 upto length 'eachSlot'
			let gt = debugAddressOrZero(self.wordAt((roster as DebugAddress) + (index as DebugAddress) * (WordBytes as DebugAddress)))

			if self.greenThreadIsLive(gt) 'aLiveRecord'
				records.push(self.greenThreadRecordOf(gt))
			end 'aLiveRecord'
		end 'eachSlot'

		return GreenThreadListing.listed(records, truncated: false)
	end 'listGreenThreads'

	function greenThreadIsLive(gt DebugAddress) returns bool
		if gt == 0 'noRecord'
			return false
		end 'noRecord'

		if self.wordAt(gt + self.contract.offset(GtOffStackBaseFigureName)) == 0 'aSchedulerContext'
			return false
		end 'aSchedulerContext'

		return not self.fieldHoldsFigure(gt, offset: GtOffStatusFigureName, figure: GtStatusCompletedFigureName)
	end 'greenThreadIsLive'

	function greenThreadRecordOf(gt DebugAddress) returns DebugGreenThread
		let machine = self.machineRunning(gt)
		let onTheStoppedThread = machine != 0 and machine == self.machineOfTheStoppedThread()

		return DebugGreenThread.create(gt, status: self.reportedStatusOf(gt, machine: machine), entryPc: self.wordAt(gt + self.contract.offset(GtOffFuncPtrFigureName)) as DebugAddress, savedSp: self.savedWordOf(gt, machine: machine, onTheStoppedThread: onTheStoppedThread, live: self.registers.stackPointer(), figure: GtOffSpFigureName), savedFp: self.savedWordOf(gt, machine: machine, onTheStoppedThread: onTheStoppedThread, live: self.registers.framePointer(), figure: GtOffFpFigureName), parkKind: self.wordAt(gt + self.contract.offset(GtOffParkKindFigureName)) as DebugAddress, machine: self.osThreadIdOf(machine))
	end 'greenThreadRecordOf'

	function savedWordOf(gt DebugAddress, machine DebugAddress, onTheStoppedThread bool, live DebugAddress, figure String) returns DebugAddress
		if machine == 0 'parked'
			return debugAddressOrZero(self.wordAt(gt + self.contract.offset(figure)))
		end 'parked'

		return live if onTheStoppedThread else 0
	end 'savedWordOf'

	function reportedStatusOf(gt DebugAddress, machine DebugAddress) returns DebugAddress
		if machine != 0 'running'
			return DbgGtStatusRunning as DebugAddress
		end 'running'

		if self.fieldHoldsFigure(gt, offset: GtOffHoldFigureName, figure: GtHoldRequestedFigureName) 'held'
			return DbgGtStatusHeld as DebugAddress
		end 'held'

		if self.fieldHoldsFigure(gt, offset: GtOffStatusFigureName, figure: GtStatusWaitingFigureName) 'waiting'
			return DbgGtStatusWaiting as DebugAddress
		end 'waiting'

		return DbgGtStatusReady as DebugAddress
	end 'reportedStatusOf'

	function osThreadIdOf(machine DebugAddress) returns DebugAddress
		if machine == 0 'parked'
			return 0
		end 'parked'

		return debugAddressOrZero(self.wordAt(machine + self.contract.offset(self.backend.threadIdentityFigure())))
	end 'osThreadIdOf'

	function machineRunning(gt DebugAddress) returns DebugAddress
		return self.machineWhoseFieldHolds(self.contract.offset(MOffCurrentGtFigureName), identity: gt)
	end 'machineRunning'

	export function walkGreenThread(handle DebugAddress) returns GreenThreadWalkOutcome
		if not self.stopped 'nothingIsParked'
			return GreenThreadWalkOutcome.refused(DebugNotRunningReason)
		end 'nothingIsParked'

		if not self.greenThreadIsLive(handle) 'noSuchThread'
			return GreenThreadWalkOutcome.refused(DebugNoSuchThreadReason)
		end 'noSuchThread'

		let machine = self.machineRunning(handle)

		if machine != 0 and machine != self.machineOfTheStoppedThread() 'onAnotherMachine'
			return GreenThreadWalkOutcome.refused(DebugThreadIsRunningReason)
		end 'onAnotherMachine'

		let seed = self.registers.framePointer() if machine != 0 else self.parkedFramePointerOf(handle)

		return match self.walkedFrom(seed) 'frames'
			walked(returnPcs, callers, truncated) gives GreenThreadWalkOutcome.walked(EngineStop.walked(returnPcs, callerFramePointers: callers, truncated: truncated))
		end 'frames'
	end 'walkGreenThread'

	function parkedFramePointerOf(handle DebugAddress) returns DebugAddress
		return debugAddressOrZero(self.wordAt(handle + self.contract.offset(GtOffFpFigureName)))
	end 'parkedFramePointerOf'

	export function holdGreenThread(handle DebugAddress) returns CommandOutcome
		if not self.greenThreadIsLive(handle) 'noSuchThread'
			return CommandOutcome.refused(DebugNoSuchThreadReason)
		end 'noSuchThread'

		if self.machineRunning(handle) != 0 'stillOnAMachine'
			return CommandOutcome.refused(DebugThreadIsRunningReason)
		end 'stillOnAMachine'

		if not self.holdFieldSetTo(handle, hold: self.contract.figure(GtHoldRequestedFigureName)) 'unwritable'
			return CommandOutcome.refused(DebugUnwritableReason)
		end 'unwritable'

		if not self.holdArmed 'theFirstHoldOfThisSession'
			self.stepHoldEpoch(HoldEpochArmStep)
			self.holdArmed = true
		end 'theFirstHoldOfThisSession'

		return CommandOutcome.done
	end 'holdGreenThread'

	function stepHoldEpoch(step HoldEpochStep)
		let name = String.from(GtHoldEpochLabel)
		self.writeContractWord(name, value: self.contractWord(name) + (step as DebuggeeWord))
	end 'stepHoldEpoch'

	function holdFieldSetTo(gt DebugAddress, hold ContractFigure) returns bool
		return self.backend.writeMemory(gt + self.contract.offset(GtOffHoldFigureName), bytes: debuggeeWordBytes(hold as DebuggeeWord))
	end 'holdFieldSetTo'

	function fieldHoldsFigure(gt DebugAddress, offset String, figure String) returns bool
		return self.wordAt(gt + self.contract.offset(offset)) == self.contract.figure(figure) as DebuggeeWord
	end 'fieldHoldsFigure'

	export function releaseGreenThread(handle DebugAddress) returns CommandOutcome
		if not self.greenThreadIsLive(handle) 'noSuchThread'
			return CommandOutcome.refused(DebugNoSuchThreadReason)
		end 'noSuchThread'

		if not self.holdFieldSetTo(handle, hold: self.contract.figure(GtHoldReleasedFigureName)) 'unwritable'
			return CommandOutcome.refused(DebugUnwritableReason)
		end 'unwritable'

		return CommandOutcome.done
	end 'releaseGreenThread'

	function liftEveryHold()
		if not self.holdArmed 'nothingWasHeld'
			return
		end 'nothingWasHeld'

		let roster = self.contractWord(String.from(GtAllGLabel))
		let length = self.contractWord(String.from(GtAllGLenLabel))
		let released = self.contract.figure(GtHoldReleasedFigureName)

		for index in 0 upto length 'eachSlot'
			let gt = debugAddressOrZero(self.wordAt((roster as DebugAddress) + (index as DebugAddress) * (WordBytes as DebugAddress)))

			if gt != 0 'aRecord'
				_ = self.holdFieldSetTo(gt, hold: released)
			end 'aRecord'
		end 'eachSlot'

		self.stepHoldEpoch(HoldEpochLiftStep)
		self.holdArmed = false
	end 'liftEveryHold'
end 'DebugEngine'

function refusedBeforeLaunch(reason String) returns EngineStart
	releaseDebugSessionPin()

	return EngineStart.refused(reason)
end 'refusedBeforeLaunch'

// The program is already running by the time a backend can be refused, so what it launched is ended before
// the refusal is reported: on a lane whose debuggee is a stub's child the stub is that child.
function refusedAfterLaunch(reason String, backend DebugBackend, target DebugTarget, trace DebugTraceState) returns EngineStart
	if backend.endsTheProgramItself() 'theBackendEndsTheProgramItself'
		_ = backend.killTheProgram()
	end 'theBackendEndsTheProgramItself'

	_ = target.reap()
	backend.close()
	closeTraceRing(trace)

	return refusedBeforeLaunch(reason)
end 'refusedAfterLaunch'

function wordIn(record ByteArray, at ElementIndex) returns DebugAddress
	var value = 0 as DebuggeeWord

	for index in 0 upto WordBytes 'eachByte'
		let byte = try record.get(at + (index as ElementIndex)) otherwise 0
		value = value or ((byte as DebuggeeWord) shl (index * 8))
	end 'eachByte'

	return debugAddressOrZero(value)
end 'wordIn'

function debuggeeWordBytes(value DebuggeeWord) returns ByteArray
	var bytes = ByteArray.create()

	for index in 0 upto WordBytes 'eachByte'
		bytes.push(((value shr (index * 8)) and 0xFF) as Byte)
	end 'eachByte'

	return bytes
end 'debuggeeWordBytes'

// The walk records one (return address, frame pointer) pair per frame; a frame's CALLER frame pointer is
// the next frame's own, and the outermost one is the link the walk did not take.
function callersOf(cursors DebugAddressArray, outer DebugAddress) returns DebugAddressArray
	var callers = DebugAddressArray.create()

	for (iter, _) in cursors.withIterator() 'eachFrame'
		if iter.index() + 1 < cursors.count() 'hasAnOuterFrame'
			callers.push(try cursors.get(iter.index() + 1) otherwise panic("callersOf: the index was just proven to be inside the walk"))
		end 'hasAnOuterFrame' else 'theOutermost'
			callers.push(outer)
		end 'theOutermost'
	end 'eachFrame'

	return callers
end 'callersOf'

function openedTraceRing(program FilePath, traced bool) returns DebugTraceState
	if not traced 'nothingToTrace'
		return DebugTraceState.untraced
	end 'nothingToTrace'

	let decoder = try DebugStreamDecoder.create(program, filter: FamilyFilter.all) otherwise (e) 'noRing'
		return refusedTraceRing(e)
	end 'noRing'

	return DebugTraceState.ring(DebugTraceCollector.create(decoder))
end 'openedTraceRing'

function refusedTraceRing(reason DecoderError) returns DebugTraceState
	match reason 'why'
		nameTablesUnreadable or
			segmentUnavailable then return DebugTraceState.noProducer
	end 'why'
end 'refusedTraceRing'

function closeTraceRing(trace DebugTraceState)
	match trace 'ring'
		untraced or
			noProducer then break 'ring'
		ring(collector) then collector.close()
	end 'ring'
end 'closeTraceRing'

function slicedFrom(collector DebugTraceCollector, mark DebugAddress, since DebugTraceSince, limit DebugTraceTally) returns DebugTraceSlice
	collector.pump()

	return collector.slice(mark, since: since, limit: limit)
end 'slicedFrom'

export function debugDeadlineAfter(budget StopTimeoutMs) returns DebugDeadline
	return (Clock.nowMs() as DebugDeadline) + (budget as DebugDeadline)
end 'debugDeadlineAfter'

export function debugDeadlinePassed(deadline DebugDeadline) returns bool
	return (Clock.nowMs() as DebugDeadline) >= deadline
end 'debugDeadlinePassed'

export function msLeftBefore(deadline DebugDeadline) returns StopTimeoutMs
	let now = Clock.nowMs() as DebugDeadline

	return 0 if now >= deadline else (deadline - now) as StopTimeoutMs
end 'msLeftBefore'

export union GreenThreadListing
	listed(records DebugGreenThreadArray, truncated bool)
	refused(reason String)
	gone(outcome TargetOutcome)
end 'GreenThreadListing'

export union GreenThreadWalkOutcome
	walked(record EngineStop)
	refused(reason String)
	gone(outcome TargetOutcome)
end 'GreenThreadWalkOutcome'

export function refusalDependsOnTheInstruction(reason String) returns bool
	return reason == DebugUnclassifiedReason or reason == DebugOutOfTextReason or reason == DebugInsideRuntimeSymbolReason
end 'refusalDependsOnTheInstruction'

// ⚠ The two bounds below are written twice: a typed range cannot name a `let`, so the only way to keep
// them true is to compare them with the register file they describe.
function requireEngineBoundsMatchTheBackend()
	if MaxEngineReadLength != TransferWindowBytes 'aWindowThatIsNotTheBackends'
		panic("DebugEngine: EngineReadLength is bounded at {MaxEngineReadLength} and the backend answers a read of at most {TransferWindowBytes} bytes")
	end 'aWindowThatIsNotTheBackends'

	if MaxEngineRegisterNumber != BackendRegisterSlots - 1 'aFileThatIsNotTheBackends'
		panic("DebugEngine: EngineRegisterNumber is bounded at {MaxEngineRegisterNumber} and the backend's register file holds {BackendRegisterSlots} slots")
	end 'aFileThatIsNotTheBackends'

	requireBackendPageOffsetSpansItsScratch()
	requireWindowsScratchLayoutIsDisjoint()
	requirePtraceScratchLayoutIsDisjoint()
	requireRegisterSlotsAreTheCompilersOwn()
end 'requireEngineBoundsMatchTheBackend'
