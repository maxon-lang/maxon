// The driver: parses the command line, dispatches one command, and maps its outcome to an exit
// code. The command reference is `commandReference()`, which `maxon help` prints.

// Every reference row is laid out from these two numbers; see `printHelpEntry`.
let UsageEntryColumnWidth = 32 as ColumnWidth
let UsageLineWidth = 100

// Resolved against the process cwd: the runner is invoked from the repo root.
let DefaultSpecDir = "specs"

// Distinct from 1 (a command ran and reported failures) and from 101 (a leak): a caller reading
// only the exit code, such as a shell script or CI, must be able to tell "nothing ran" from
// "something failed". Same number and meaning as `cross-target-gate.sh`'s own refusal. Declared
// here, where the driver's exit codes are decided, because more than one refusal returns it.
module let NothingRanExitCode = 2

// Re-emitted on the command lines that relaunch this driver — a pool worker
// (`SpecWorkerPool.spawnNoWait`) and a delegated Linux suite (`SpecTestRunner.spawnGuestSuite`) —
// and read back by the parser in this file, so the two halves cannot drift apart into a hang.
module let SpecTestCommandName = "spec-test"

// Re-emitted by `SpecTestRunner.buildGuestCompiler` and `ScaleTestRunner.compileRung`, and read
// back by the same parser.
module let BuildSubcommandName = "build"

// Constants because `MaxonArgs.parse` matches each word and `maxon help` prints it: a word written
// twice can be renamed in one place and stay documented under the other.
let VerifyWarmRebuildCommandName = "verify-warm-rebuild"
let VerifyRecheckCommandName = "verify-recheck"
let LspServerCommandName = "lsp-server"
let DevFlag = "--dev"
let ScaleTestCommandName = "scale-test"

module let OutputFlagName = "-o"

let OutputFlagPrefix = "--output="

// `fmt` takes no options, including flags other commands implement: `runFmt` refuses any
// `-`-leading argument (`anyOption`). Silently dropping one is destructive — `maxon fmt --check`
// would find no path, fall back to the current directory and rewrite the whole tree in place.
let FmtCommandName = "fmt"

// `fmt`'s refusals are its own sentences, not the driver's `Usage:` line. Pinned byte-for-byte by
// `tests/fmt/fixtures/flag-refused`, `flag-refused-no-path` and `two-paths-refused`.
let FmtUsageLine = "usage: maxon fmt [<file|directory>]   (formats in place; no options)"

// `monitor <exe> [args...]` hands everything after the executable to the child, so `parse` stops at
// this word and files the rest verbatim.
let MonitorCommandName = "monitor"

// Tail-stopping like `monitor`: its subcommands are spelled `--dump-info` / `--symbolize`, which
// the parser would otherwise refuse as options this driver does not implement.
let DebugCommandName = "debug"

// Tail-stopping: everything after the verb is the child's command line, so a target's own flag must
// not be consumed on its way past nor abort the run before the child is spawned.
let CoverageCommandName = "coverage"

// `module` because `Run/CacheCommand.maxon` names the command in its own usage line and refusals.
module let CacheCommandName = "cache"

// Tail-stopping: `profile run <exe> <flags>` forwards everything after the executable to the child.
let ProfileCommandName = "profile"

// Tail-stopping: everything after the path is the program's own command line.
//
// Also reached with no word at all: a first argument ending in `MaxonSourceExtension`, which is
// what a kernel hands the interpreter for a file whose first line is `#!/usr/bin/env maxon`. See
// `MaxonArgs.parse`. `module` because `Run/RunCommand.maxon` names the command in its own refusals.
module let RunCommandName = "run"

// `module` because `Upgrade/UpgradeCommand.maxon` names both in its own refusals and usage line.
module let UpgradeCommandName = "upgrade"
module let DryRunFlag = "--dry-run"

// Declared here because the reference names it, and `upgrade` overrides it with the root the
// running compiler sits in.
module let InstallRootVariable = "MAXON_INSTALL"

// Declared here rather than beside the cache because the reference prints it too: a variable a
// reader is told to set must be the one the code consults.
module let RunCacheRootVariable = "MAXON_RUN_CACHE_ROOT"

module let WorkerPersistentFlag = "--worker-persistent"

let FilterFlagPrefix = "--filter="

// `module` because `SpecTestRunner.reportGoldenDrift` and `reportUnrunHere` name this flag as the
// remedy.
module let UpdateRequiredFlag = "--update-required"

// Selects the cases marked `<!-- network: live -->`, which open a socket to a real external host. A
// default run leaves them out: a verdict that turns on somebody else's uptime is not a claim about
// this compiler. The cases stay active and parsed (see `SpecTestRunner.networkModeAllows`), and
// excluding them is announced (`reportExclusions`). No count is written here: the marker is the
// census.
//
// Re-emitted to every worker: a worker that never heard the flag would answer for tests nobody
// counted.
module let NetworkFlag = "--network"

// `--compiler=<path>` is withdrawn. `spec-test` compiles every case in this process, so the
// compiler under test is this binary's own code and there is nothing a path could select; a flag
// kept as a no-op would read as though it chose something.
//
// Refused by name rather than as an unknown option, so a script still passing it is told what
// replaced it instead of being sent looking for a typo. See `withdrawnOptionMessage`.
let WithdrawnCompilerFlagPrefix = "--compiler"

// Re-emitted: a cross-target spec run forwards it to every worker (`SpecWorkerPool.spawnNoWait`),
// and the parser reads it back through this constant.
module let TargetFlagPrefix = "--target="

// `module` because the guest delegation forwards a pool size the caller typed
// (`SpecTestRunner.spawnGuestSuite`), and a spelling this parser does not read back is silently
// refused.
module let WorkersFlagPrefix = "--workers="

// The selection half of a `spec-test` command line, for both re-emitters
// (`SpecWorkerPool.spawnNoWait` and `SpecTestRunner.spawnGuestSuite`): both must answer for exactly
// the set the parent planned.
//
// The directory is the resolved one, never a default the far side would re-derive from its own
// working directory. Each flag is emitted only when set.
module function specSelectionArgv(specDir FilePath, filter String, updateRequired bool, includeNetwork bool) returns StringArray
	var argv = StringArray.create()
	argv.push(specDir.toString())

	if not filter.isEmpty() 'hasFilter'
		argv.push("{FilterFlagPrefix}{filter}")
	end 'hasFilter'

	if updateRequired 'isUpdate'
		argv.push(UpdateRequiredFlag)
	end 'isUpdate'

	if includeNetwork 'wantsLiveNetwork'
		argv.push(NetworkFlag)
	end 'wantsLiveNetwork'

	return argv
end 'specSelectionArgv'

// Matched by `MaxonArgs.parse`, the one reader of this driver's command line: a second parser would
// silently swallow a flag the first understood.
let TestListFlag = "--list"
let TestJsonFlag = "--json"
let TestNoTimingFlag = "--no-timing"
let TestIsolateFlag = "--isolate"
let TestBailFlag = "--bail"
let TestBailFlagPrefix = "--bail="
let TestTimeoutFlagPrefix = "--timeout="
let TestColorFlagPrefix = "--color="

// `-t P` is the separated form, which a pattern containing spaces needs.
let TestFilterShortFlag = "-t"
let TestFilterShortPrefix = "-t="

// Failures allowed before the run stops CLAIMING work, when `--bail` is given with no count.
let DefaultBailAfter = 1

let EmitIrFlag = "--emit-ir"

// Opt-in per build: without it the trace calls are not emitted at all rather than branched over at
// run time (see `GtRuntime.GtTraceEmitName`).
let AsyncTraceFlag = "--async-trace"

// Opt-in per build, and that is a correctness property: with the flag off not one instruction
// changes — the box header does not grow, `__mm_alloc`'s arity does not change, no event site is
// branched over — and the committed `.test` goldens depend on it. See `DebugStreamRuntime`'s header
// for the two-level gating rule.
let DebugStreamFlag = "--debugstream"

// An opt-out because the default is on: a binary built without debug info cannot be debugged after
// the fact. On by default is safe because the sidecar is metadata and the executable is
// byte-identical either way, gated by `tests/debug/byte-identical-debug-info.test.maxon`.
//
// Only `build` acts on it; every other command keeps the compiler's own default (off).
module let NoDebugInfoFlag = "--no-debug-info"

// Changes the emitted code, so it is a separate build from the one you ship. It requires the
// sidecar: a counter is an anonymous index and what it counts lives in the `.mxdbg` coverage-point
// table, so a build without it is refused (`refusedBuildOptions`). `module` because
// `Debug/CoverageCommand.maxon`'s banner names the flag.
module let CoverageFlag = "--coverage"

// Assembled from the flag names, so a rename cannot leave the sentence naming a flag that no longer
// exists.
function coverageNeedsDebugInfoMessage() returns String
	return "{CoverageFlag} requires the debug-info sidecar: the counters it emits are anonymous without the sidecar's coverage-point table, so a {MxcovDataExtension} written by this binary could never be interpreted. Drop {NoDebugInfoFlag} (or `debugInfo: false` in {BuildManifestFileName}), or drop {CoverageFlag}."
end 'coverageNeedsDebugInfoMessage'

// Names withheld functions the IR sidecar must also render: a golden otherwise shows only functions
// parsed from the program's own source, so `mrt_start`, the allocator, the `__str_*`/`__managed_*`
// families and `stdlib/` bodies carry no golden (see `TargetPrinter.printTargetModule`). Opt-in per
// build, so a fragment that does not ask is unchanged.
let EmitIrRuntimeFlagPrefix = "--emit-ir-runtime="

// One leading dash makes an argument an option. `module` because `runCoverage`'s own tail parse
// asks it too.
module let OptionPrefix = "-"

// A command rather than a flag, so `maxon` with no arguments lists it with every other command.
let HelpCommandName = "help"

// Withdrawn in favour of `maxon help`, and refused by name: these are the spellings every other CLI
// teaches people to try first, so "unknown option: --help" would claim this driver has no help. See
// `withdrawnOptionMessage`.
let WithdrawnHelpFlag = "--help"
let WithdrawnHelpFlagShort = "-h"

let VersionCommandName = "version"

// Withdrawn: a flag beside `maxon version` would be a second door onto one answer, free to drift.
// Refused by name because packagers, CI steps and bug-report templates reach for these first, and
// "unknown option" would send the reader hunting for a typo. See `withdrawnOptionMessage`.
let WithdrawnVersionFlag = "--version"
let WithdrawnVersionFlagShort = "-V"

// `module` because `ScaleTestRunner.compileRung` spawns one build per rung with it.
module let MetricsFlagPrefix = "--metrics="

// The value may contain `=` and the name may not, so the split is at the first one: a description
// or a URL needs it, and a mangled value would be found only by reading the emitted binary.
let DefineFlagPrefix = "--define="
let DefineNameValueSeparator = "="

let RungsFlagPrefix = "--rungs="
let RepeatFlagPrefix = "--repeat="
let NoteFlagPrefix = "--note="
let ResultJsonFlagPrefix = "--result-json="
let EmitCorpusFlagPrefix = "--emit-corpus="

// Comma, like the `<!-- unsupported-targets: … -->` marker: one separator for every list this
// project reads.
let RuntimeNameSeparator = ","

enum DefinePairError implements Error
	noSeparator
end 'DefinePairError'

// A pair with no `=` is refused rather than read as an empty value: `X` is more likely truncated,
// and `X=` still spells empty.
//
// The value is every piece after the first, rejoined: `Url=https://x/?a=b` splits into four pieces.
// Slicing at a byte offset is not simpler, because a `String` index is a grapheme cursor.
function defineFromPair(pair String) returns Define throws DefinePairError
	let cut = pair.split(DefineNameValueSeparator)

	if cut.count() < 2 'noValueGiven'
		throw DefinePairError.noSeparator
	end 'noValueGiven'

	var value = ""

	for i in 1 upto cut.count() 'eachPiece'
		let piece = try cut.get(i) otherwise panic("defineFromPair: cut.get OOB — i < count by loop bound")
		let separator = "" if i == 1 else DefineNameValueSeparator
		value = "{value}{separator}{piece}"
	end 'eachPiece'

	let name = try cut.get(0) otherwise panic("defineFromPair: cut.get OOB — count is at least 2")
	return Define.create(name, value: value)
end 'defineFromPair'

function main() returns ExitCode
	let args = MaxonArgs.parse()

	// A withdrawn option is reported before an unknown one: its author needs to be told what replaced
	// it rather than sent looking for a typo.
	if not args.withdrawnOption.isEmpty() 'withdrawnOption'
		printError("{withdrawnOptionMessage(args.withdrawnOption, command: args.command)}\n")

		// `upgrade`'s stdout is its dry run's report, which a script reads, so none of its refusals write
		// there.
		if args.command != MaxonCommand.upgrade 'owedTheCommandList'
			printCommandList()
		end 'owedTheCommandList'

		return refusedCommandLineExit(args.command)
	end 'withdrawnOption'

	// An option the driver does not implement aborts before any command runs: proceeding as though it
	// had been honoured is the one outcome a caller can neither see nor recover from. `fmt`, `upgrade`
	// and `mcp-server` are exempt because each refuses what it does not take itself, and the latter
	// two must be: their own flag is recorded as a bad option so that no other command silently
	// accepts it.
	if not args.badOption.isEmpty() and args.command != MaxonCommand.fmt and args.command != MaxonCommand.upgrade and args.command != MaxonCommand.mcpServer 'badOption'
		printError("error: unknown option: {args.badOption}\n")
		printCommandList()
		return refusedCommandLineExit(args.command)
	end 'badOption'

	return match args.command 'cmd'
		build gives runBuild(args)
		cache gives runCache(args)
		coverage gives runCoverage(args)
		debug gives runDebugCommand(args)
		fmt gives runFmt(args)
		help gives runHelp(args)
		lspServer gives runLspServer()
		mcpServer gives runMcpServerCommand(args)
		monitor gives runMonitor(args)
		profile gives runProfile(args)
		run gives runRun(args)
		scaleTest gives runScaleTest(args)
		specTest gives runSpecTest(args)
		test gives runTest(args)
		upgrade gives runUpgrade(args)
		verifyRecheck gives runVerifyRecheck(args)
		verifyWarmRebuild gives runVerifyWarmRebuild(args)
		version gives runVersion(args)
		unknown gives noCommandGiven(args)
	end 'cmd'
end 'main'

module union TargetResolution
	resolved(target Target)
	unrecognized(spec String)
end 'TargetResolution'

// Matched against `targetToString`, so the parser accepts exactly the spellings the printer
// produces. `module` because `GoldenCensus.reportUncomparedGoldens` asks the same question of a
// lane directory's name; a private copy there would quietly stop covering the next backend that
// lands.
module function parseBuildTarget(spec String) returns TargetResolution
	for candidate in supportedTargets() 'each'
		if targetToString(candidate) == spec 'match'
			return TargetResolution.resolved(candidate)
		end 'match'
	end 'each'

	return TargetResolution.unrecognized(spec)
end 'parseBuildTarget'

// The one list. `SpecVerdictSelfTest` sweeps it, and must cover every target or it is scoped to
// whichever its author thought of.
module function supportedTargets() returns TargetArray
	return [Target.create(CpuArch.x64, os: Os.windows), Target.create(CpuArch.x64, os: Os.linux), Target.create(CpuArch.arm64, os: Os.macos), Target.create(CpuArch.arm64, os: Os.linux), Target.create(CpuArch.wasm32, os: Os.wasi)]
end 'supportedTargets'

// Spelled from `supportedTargets()`, so every message naming the set gains the next backend when it
// lands.
function supportedTargetList() returns String
	var out = ""

	for candidate in supportedTargets() 'each'
		if out.isEmpty() 'first'
			out = targetToString(candidate)
		end 'first' else 'rest'
			out = "{out}, {targetToString(candidate)}"
		end 'rest'
	end 'each'

	return out
end 'supportedTargetList'

module enum TargetFlagError implements Error
	unrecognized
end 'TargetFlagError'

// One reader for every command that takes `--target`, so none can drift on what no `--target`
// means. An unrecognized spelling is reported here, so a caller only has to stop.
module function commandLineTarget(spec String) returns Target throws TargetFlagError
	if spec.isEmpty() 'host'
		return detectHostTarget()
	end 'host'

	match parseBuildTarget(spec) 'targetSel'
		resolved(t) then return t
		unrecognized(unknown) then printError("error: unknown --target '{unknown}' (expected one of: {supportedTargetList()})\n")
	end 'targetSel'

	throw TargetFlagError.unrecognized
end 'commandLineTarget'

// A manifest is a set of tasks, not a program with one way in; `build` is the task this command
// asks for.
let ManifestEntryFunction = b"build"

// The fields of `stdlib/Build.maxon`'s JSON that this reads back.
let ManifestNameKey = "name"
let ManifestOutputKey = "output"
let ManifestSourcesKey = "sources"
let ManifestVersionKey = "version"
let ManifestDefinesKey = "defines"
let ManifestDebugInfoKey = "debug_info"

// A name that is not a target is not an error: `maxon build <x>` may mean the path x, so a manifest
// declaring no `x` answers `noSuchTarget` and the caller falls back to path semantics. Refusing
// would let a manifest break builds it was never part of.
union ManifestRun
	ran(code ExitCode)
	noSuchTarget
end 'ManifestRun'

// A manifest's builds. ONE may be written as a bare object and SEVERAL as a JSON array, because a
// single-target manifest should not have to say it is a list of one.
function manifestBuilds(doc JsonDoc) returns JsonNodeIdArray
	var builds = JsonNodeIdArray.create()
	let count = try doc.arrayLength(doc.root) otherwise 'notArray'
		builds.push(doc.root)
		return builds
	end 'notArray'

	for i in 0 upto count 'eachBuild'
		builds.push(try doc.arrayAt(doc.root, index: i) otherwise panic("manifestBuilds: arrayAt OOB — i < count by loop bound"))
	end 'eachBuild'

	return builds
end 'manifestBuilds'

// A build's declared name, empty when it carries none. A lone build needs none: there is nothing to
// tell it apart from.
function manifestTargetName(doc JsonDoc, build JsonNodeId) returns String
	return try doc.getString(build, key: ManifestNameKey) otherwise ""
end 'manifestTargetName'

// `build.maxon` is a Maxon program, not a config file, so the paths it compiles can be computed.
// The compiler compiles and runs it and reads `stdlib/Build.maxon`'s JSON from its stdout, so both
// ends share one description of a build.
function runBuildManifest(args MaxonArgs, targetName String) returns ManifestRun
	let manifest = Directory.currentPath().join(BuildManifestFileName)

	if not File.exists(manifest) 'noManifest'
		if not targetName.isEmpty() 'nameWithoutManifest'
			return ManifestRun.noSuchTarget
		end 'nameWithoutManifest'

		printError("Usage: maxon build <file|directory|target>... [-o <output>] [--emit-ir] [--emit-ir-runtime=<name>,...] [--target=<cpu>-<os>]\n")
		printError("\n")
		printError("With no path, `maxon build` runs the {BuildManifestFileName} in the current directory. There is none here.\n")
		return ManifestRun.ran(1)
	end 'noManifest'

	// Built for this host whatever `--target` says: this machine is about to run it. The flag
	// describes the program the manifest asks for.
	//
	// Kept in the run cache, never in the project: a path inside the project is written by every
	// concurrent build of it, and which lock would apply is known only once the manifest has run.
	//
	// ⭐ **ONLY THIS COMPILE IS SILENCED, AND THE LEVEL GOES BACK BEFORE THE NEXT ONE.** The build the
	// manifest goes on to describe is what the caller asked for, and its own report is their answer;
	// the runner is scaffolding, so it owes them one line rather than a second build's worth of it.
	let spoke = quietTheBuildChatter(args)

	let runner = try cachedBuild(manifest, isProject: false, target: detectHostTarget(), entryFunction: ManifestEntryFunction, speaker: BuildSubcommandName) otherwise 'manifestNotBuilt'
		setLogLevel(spoke)
		printError("error: {BuildManifestFileName} could not be built — the reason is above\n")
		return ManifestRun.ran(1)
	end 'manifestNotBuilt'

	setLogLevel(spoke)
	reportBuildRunner(runner.compiled)

	let run = try Subprocess.run(Executable.path(runner.executable), arguments: StringArray.create()) otherwise 'manifestRunErr'
		printError("error: {BuildManifestFileName} compiled but could not be run\n")
		return ManifestRun.ran(1)
	end 'manifestRunErr'

	if run.exitCode() != 0 'manifestFailed'
		printError("error: {BuildManifestFileName} exited {run.exitCode()} and described no build\n")

		if not run.stderr.isEmpty() 'hasStderr'
			printError("{run.stderr}\n")
		end 'hasStderr'

		return ManifestRun.ran(1)
	end 'manifestFailed'

	return buildFromManifestOutput(run.stdout, args: args, targetName: targetName)
end 'runBuildManifest'

// One line on stdout, ahead of the build's own report: which of the two things happened to the
// program that describes the build. A reader waiting on a cold `build.maxon` compile is otherwise
// told nothing at all.
function reportBuildRunner(compiled bool)
	let said = "Compiled the build runner" if compiled else "Used the cached build runner"
	print("{said} ({BuildManifestFileName})\n")
end 'reportBuildRunner'

// A function rather than a reassignment, which would clone a `String` neither branch changes.
function chosenOutput(fromManifest String, fromFlag String) returns String
	if fromFlag.isEmpty() 'manifestDecides'
		return fromManifest
	end 'manifestDecides'

	return fromFlag
end 'chosenOutput'

// A field the description states and this cannot use is an error, never a default: a guess is how a
// build compiles the wrong thing while reporting success.
function buildFromManifestOutput(stdout String, args MaxonArgs, targetName String) returns ManifestRun
	let doc = try Json.parse(stdout) otherwise 'badJson'
		printError("error: {BuildManifestFileName} printed something that is not a build description.\n")
		printError("It must print what `Build.build(source, output:)` or `Build.buildWithConfig(config)` writes. It printed:\n")
		printError("{stdout}\n")
		return ManifestRun.ran(1)
	end 'badJson'

	let builds = manifestBuilds(doc)
	let buildCount = builds.count()

	// Several targets and no name are listed rather than guessed at: picking the first would report
	// success for a build nobody asked for.
	var chosen = doc.root

	if targetName.isEmpty() 'noNameGiven'
		if buildCount != 1 'severalTargets'
			printError("{BuildManifestFileName} declares {buildCount} targets. Name one:\n")

			for id in builds 'eachTargetName'
				printError("  {manifestTargetName(doc, build: id)}\n")
			end 'eachTargetName'

			return ManifestRun.ran(1)
		end 'severalTargets'

		chosen = try builds.get(0) otherwise panic("buildFromManifestOutput: builds.get OOB — buildCount is 1")
	end 'noNameGiven' else 'nameGiven'
		var found = false

		for id in builds 'findTarget'
			if manifestTargetName(doc, build: id) == targetName 'nameMatches'
				chosen = id
				found = true
			end 'nameMatches'
		end 'findTarget'

		if not found 'noSuchName'
			return ManifestRun.noSuchTarget
		end 'noSuchName'
	end 'nameGiven'

	let output = try manifestOutput(doc, build: chosen) otherwise (e) 'badOutput'
		return ManifestRun.ran(reportMalformedManifestField(ManifestOutputKey, error: e))
	end 'badOutput'

	let inputPaths = try manifestSources(doc, build: chosen) otherwise (e) 'badSources'
		return ManifestRun.ran(reportMalformedManifestField(ManifestSourcesKey, error: e))
	end 'badSources'

	// An empty `sources` is refused, not read as this directory: that would compile the whole tree
	// under a command that named nothing. `Build.build(".", output: …)` says so explicitly.
	if inputPaths.count() == 0 'noPaths'
		printError("error: {BuildManifestFileName} named no sources to compile.\n")
		printError("Use `Build.buildWithConfig` with a non-empty `{ManifestSourcesKey}`.\n")
		return ManifestRun.ran(1)
	end 'noPaths'

	// `-o` outranks the manifest: the person typing answers a narrower question than the file does.
	let outputOverride = chosenOutput(output, fromFlag: args.outputOverride)

	let target = try commandLineTarget(args.targetSpec) otherwise return ManifestRun.ran(1)

	// Either side can turn the sidecar off and neither can force it on: `--no-debug-info` has no
	// positive twin, and a manifest saying `false` means the project never wants one.
	let manifestWantsDebugInfo = try manifestDebugInfo(doc, build: chosen) otherwise (e) 'badDebugInfo'
		return ManifestRun.ran(reportMalformedManifestField(ManifestDebugInfoKey, error: e))
	end 'badDebugInfo'

	// The description's `name` is not the product name: it is whatever selected this build, which for
	// `Build.build` is the source path, often `.`. The product is named by the output.
	let productVersion = try manifestVersion(doc, build: chosen, target: target) otherwise (e) 'badVersion'
		return ManifestRun.ran(reportMalformedManifestField(ManifestVersionKey, error: e))
	end 'badVersion'

	// The manifest's defines come first, so a command-line `--define` overrides one it computed: a
	// later stamp replaces an earlier one, so order expresses the precedence.
	var defines = try manifestDefines(doc, build: chosen) otherwise (e) 'badDefines'
		return ManifestRun.ran(reportMalformedManifestField(ManifestDefinesKey, error: e))
	end 'badDefines'

	for supplied in args.defines 'eachCommandLineDefine'
		defines.push(supplied)
	end 'eachCommandLineDefine'

	return ManifestRun.ran(buildAndReport(inputPaths, target: target, args: args, outputOverride: outputOverride, debugInfo: manifestWantsDebugInfo and args.debugInfo, productVersion: productVersion, defines: defines))
end 'buildFromManifestOutput'

// `output` and `sources` are required; any other absent field reads as what `Build` writes when its
// caller says nothing.
union ManifestFieldError implements Error
	missing
	notABool
	notAString
	notAListOfStrings
	notAPath(entry String)
	notADefinePair(entry String)
	notStampable(problem ProductVersionError)
end 'ManifestFieldError'

function reportMalformedManifestField(key String, error ManifestFieldError) returns ExitCode
	let problem = match error 'whatIsWrong'
		missing gives "is missing"
		notABool gives "is not true or false"
		notAString gives "is not a string"
		notAListOfStrings gives "is not a list of strings"
		notAPath(entry) gives "holds `{entry}`, which is not a path"
		notADefinePair(entry) gives "holds `{entry}`, which is not a `<name>{DefineNameValueSeparator}<value>` pair"
		notStampable(versionProblem) gives productVersionProblem(versionProblem)
	end 'whatIsWrong'

	printError("error: {BuildManifestFileName}'s `{key}` {problem}\n")
	return 1
end 'reportMalformedManifestField'

// The readers below look a key up with `getChild`, whose one failure besides an absent key is a
// description that is not an object, which has none of the keys either.

function manifestOutput(doc JsonDoc, build JsonNodeId) returns String throws ManifestFieldError
	let valueId = try doc.getChild(build, key: ManifestOutputKey) otherwise throw ManifestFieldError.missing
	return try manifestString(doc.get(valueId))
end 'manifestOutput'

function manifestSources(doc JsonDoc, build JsonNodeId) returns MaxonSourcePathArray throws ManifestFieldError
	let listId = try doc.getChild(build, key: ManifestSourcesKey) otherwise throw ManifestFieldError.missing
	var sources = MaxonSourcePathArray.create()

	for spelling in try manifestStrings(doc, list: doc.get(listId)) 'eachSource'
		sources.push(try FilePath.from(spelling) otherwise throw ManifestFieldError.notAPath(spelling))
	end 'eachSource'

	return sources
end 'manifestSources'

function manifestDebugInfo(doc JsonDoc, build JsonNodeId) returns bool throws ManifestFieldError
	let valueId = try doc.getChild(build, key: ManifestDebugInfoKey) otherwise return true
	let value = doc.get(valueId)

	if value.kind != JsonKind.jsonBool 'notABool'
		throw ManifestFieldError.notABool
	end 'notABool'

	return value.boolValue
end 'manifestDebugInfo'

// Absent reads as "unversioned". Checked against the target's version field here, before the build, so a
// version the binary cannot carry refuses the build rather than being stamped as something else.
function manifestVersion(doc JsonDoc, build JsonNodeId, target Target) returns VersionComponentArray throws ManifestFieldError
	let valueId = try doc.getChild(build, key: ManifestVersionKey) otherwise return VersionComponentArray.create()
	let dotted = try manifestString(doc.get(valueId))
	return try productVersionFor(dotted, target: target) otherwise (e) 'unstampable'
		throw ManifestFieldError.notStampable(e)
	end 'unstampable'
end 'manifestVersion'

// Refused whole on the first bad entry: a build missing a define its manifest computed is a binary
// claiming the constant's written-out default, and nothing would say so.
function manifestDefines(doc JsonDoc, build JsonNodeId) returns DefineArray throws ManifestFieldError
	var defines = DefineArray.create()
	let listId = try doc.getChild(build, key: ManifestDefinesKey) otherwise return defines

	for pair in try manifestStrings(doc, list: doc.get(listId)) 'eachDefine'
		defines.push(try defineFromPair(pair) otherwise throw ManifestFieldError.notADefinePair(pair))
	end 'eachDefine'

	return defines
end 'manifestDefines'

function manifestString(value JsonNode) returns String throws ManifestFieldError
	if value.kind != JsonKind.jsonString 'notAString'
		throw ManifestFieldError.notAString
	end 'notAString'

	return value.stringValue
end 'manifestString'

function manifestStrings(doc JsonDoc, list JsonNode) returns ManifestStringArray throws ManifestFieldError
	if list.kind != JsonKind.jsonArray 'notAList'
		throw ManifestFieldError.notAListOfStrings
	end 'notAList'

	var strings = ManifestStringArray.create()

	for entryId in list.children 'eachEntry'
		let entry = doc.get(entryId)

		if entry.kind != JsonKind.jsonString 'notAString'
			throw ManifestFieldError.notAListOfStrings
		end 'notAString'

		strings.push(entry.stringValue)
	end 'eachEntry'

	return strings
end 'manifestStrings'

typealias ManifestStringArray = Array with String

// The header goes to stdout, so a failing build's stderr is still exactly its diagnostics.
function runBuild(args MaxonArgs) returns ExitCode
	printVersionHeader()

	if args.paths.count() == 0 'noPath'
		match runBuildManifest(args, targetName: "") 'bareBuild'
			ran(code) then return code
			noSuchTarget then panic("runBuild: the manifest was asked for no target and cannot answer noSuchTarget")
		end 'bareBuild'
	end 'noPath'

	// A target name outranks a path of the same spelling: a target also names an output, so resolving
	// `maxon build maxon-bin` as a path would compile to a different file and leave the real one
	// stale.
	if args.paths.count() == 1 'maybeTargetName'
		let only = try args.paths.get(0) otherwise panic("runBuild: paths.get OOB — count is 1")

		match runBuildManifest(args, targetName: only) 'namedBuild'
			ran(code) then return code
			noSuchTarget then return runBuildPaths(args)
		end 'namedBuild'
	end 'maybeTargetName'

	return runBuildPaths(args)
end 'runBuild'

// Every positional is compiled as one program, in the order given: `Compiler.loadSourceFiles`
// registers them in that order and roots the project at their common ancestor.
function runBuildPaths(args MaxonArgs) returns ExitCode
	var inputPaths = MaxonSourcePathArray.create()

	for spelling in args.paths 'eachPositional'
		let path = try FilePath.from(spelling) otherwise 'badPath'
			printError("error: invalid path: {spelling}\n")
			return 1
		end 'badPath'

		inputPaths.push(path)
	end 'eachPositional'

	let target = try commandLineTarget(args.targetSpec) otherwise return 1

	return buildAndReport(inputPaths, target: target, args: args, outputOverride: args.outputOverride, debugInfo: args.debugInfo, productVersion: VersionComponentArray.create(), defines: args.defines)
end 'runBuildPaths'

// The lock is asked of the command line's `-o`: `outputOverride` may be a manifest's own `output`,
// which says nothing about who else writes the tree.
function buildAndReport(inputPaths MaxonSourcePathArray, target Target, args MaxonArgs, outputOverride String, debugInfo bool, productVersion VersionComponentArray, defines DefineArray) returns ExitCode
	if refusedBuildOptions(args, target: target, debugInfo: debugInfo) 'refusedOptions'
		return 1
	end 'refusedOptions'

	let lockExit = acquireBuildTreeLock(inputPaths, outputOverride: args.outputOverride)

	if lockExit != 0 'busyTree'
		return lockExit
	end 'busyTree'

	let buildExit = compileAndReport(inputPaths, target: target, args: args, outputOverride: outputOverride, debugInfo: debugInfo, productVersion: productVersion, defines: defines)
	releaseTreeLock()
	return buildExit
end 'buildAndReport'

// `debugInfo` is the build's effective setting, which a manifest can turn off.
//
// Every build road asks this before the tree lock and the build cache: a cache hit never reaches
// the compiler, so a rule enforced inside the compile is one a warm build skips.
//
// These are refusals of the command line, not diagnostics: nothing in the program asked for an
// instrument, so there is no span, and an unsupported target is not E3104. The spec harness gates a
// per-case `debugStream` itself; both read `targetCanProduceDebugStream`.
function refusedBuildOptions(args MaxonArgs, target Target, debugInfo bool) returns bool
	if args.debugStream and not targetCanProduceDebugStream(target) 'unsupportedDebugStream'
		printError("error: {DebugStreamFlag} is not implemented for {targetToString(target)}. The DebugStream producer attaches to a NAMED shared segment named by an activation environment variable and stamps a millisecond stopwatch — two host facilities (`sharedMemory`, `uptimeClock`) this target does not provide, so the Std ops behind them (`osOpenNamedSegment`, `osMapNamedSegment`, `osTickCountMs`) have no lowering on this lane. Build for a target that has them, or implement those facilities here.\n")
		return true
	end 'unsupportedDebugStream'

	if args.coverage and not debugInfo 'coverageNeedsDebugInfo'
		printError("{Diagnostic.create(ErrorCode.codeEmitterCoverageNeedsDebugInfo, message: coverageNeedsDebugInfoMessage()).render()}\n")
		return true
	end 'coverageNeedsDebugInfo'

	if args.coverage and not targetCanMeasureCoverage(target) 'unsupportedCoverage'
		printError("error: {CoverageFlag} is not implemented for {targetToString(target)}. An instrumented binary writes its counter block to a `<output>{MxcovDataExtension}` file as it exits — the `managedFile` host facility this target does not provide. Build for a target that has it, or implement that facility here.\n")
		return true
	end 'unsupportedCoverage'

	return false
end 'refusedBuildOptions'

// A build takes this checkout's lock only when it writes into a tree at a derived output path. Two
// questions decide it, and neither is how many paths were typed:
//
// · Did the caller say where the output goes? A `-o` build writes where the caller said and takes
//   nothing, which is what keeps the harnesses' nested `build … -o …` compiles from deadlocking
//   inside a run that already holds the lock.
//
// · Otherwise, is the project root a directory? `resolveOutputPath` writes beside the input when
//   the root is a file, and into the tree otherwise.
//
// The root comes from `commonAncestorOf`, the function `loadProject` roots the project at, so the
// lock and the compile cannot disagree about which tree is written. A root with no `stdlib/` above
// it takes no lock: `acquireTreeLock` answers that itself.
function acquireBuildTreeLock(inputPaths MaxonSourcePathArray, outputOverride String) returns ExitCode
	if not outputOverride.isEmpty() 'callerOwnsTheOutput'
		return 0
	end 'callerOwnsTheOutput'

	// A list with no common root is refused by the compile moments later, with a message naming both
	// ends (`CompileError.noCommonRoot`). Taking no lock is right for it: there is no one tree it
	// writes into, which is the very thing that makes it unbuildable.
	let root = try commonAncestorOf(inputPaths) otherwise 'noTreeToLock'
		return 0
	end 'noTreeToLock'

	if not Directory.isDirectory(root) 'writesBesideOneNamedFile'
		return 0
	end 'writesBesideOneNamedFile'

	return acquireTreeLock(root)
end 'acquireBuildTreeLock'

// Separate from `buildAndReport` so the tree lock has one release: Maxon has no `defer`.
function compileAndReport(inputPaths MaxonSourcePathArray, target Target, args MaxonArgs, outputOverride String, debugInfo bool, productVersion VersionComponentArray, defines DefineArray) returns ExitCode
	let outputPath = try compile(inputPaths, target: target, outputOverride: outputOverride, emitIr: args.emitIr, metricsPath: args.metricsPath, runtimeIrNames: args.runtimeIrNames, asyncTrace: args.asyncTrace, debugStream: args.debugStream, debugInfo: debugInfo, coverage: args.coverage, productVersion: productVersion, defines: defines) otherwise (e) 'compileErr'
		reportCompileError(e)
		return 1
	end 'compileErr'

	print("Compiled -> {outputPath}\n")
	return 0
end 'compileAndReport'

// Exit 0 iff the query spine is deterministic and incremental for `<file>`.
function runVerifyWarmRebuild(args MaxonArgs) returns ExitCode
	let usage = "maxon verify-warm-rebuild <file>"

	if refusedPositionalBeyond(args, allowed: 1, usage: usage) 'tooManyPaths'
		return 1
	end 'tooManyPaths'

	let spelling = args.solePositional()

	if spelling.isEmpty() 'noPath'
		printError("Usage: {usage}\n")
		return 1
	end 'noPath'

	let inputPath = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return 1
	end 'badPath'

	let target = detectHostTarget()
	let bothPass = try verifyWarmRebuild(inputPath, target: target) otherwise (e) 'verifyErr'
		reportCompileError(e)
		return 1
	end 'verifyErr'

	if bothPass 'passed'
		return 0
	end 'passed'

	return 1
end 'runVerifyWarmRebuild'

function runVerifyRecheck(args MaxonArgs) returns ExitCode
	let usage = "maxon verify-recheck <file|dir>"

	if refusedPositionalBeyond(args, allowed: 1, usage: usage) 'tooManyPaths'
		return 1
	end 'tooManyPaths'

	let spelling = args.solePositional()

	if spelling.isEmpty() 'noPath'
		printError("Usage: {usage}\n")
		return 1
	end 'noPath'

	let inputPath = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return 1
	end 'badPath'

	let target = detectHostTarget()
	let allPass = try verifyRecheck(inputPath, target: target, defines: args.defines) otherwise (e) 'verifyErr'
		reportCompileError(e)
		return 1
	end 'verifyErr'

	if allPass 'passed'
		return 0
	end 'passed'

	return 1
end 'runVerifyRecheck'

// `harnessExe` is both what a pool worker is relaunched as and what compiles every selected test:
// every case is compiled in this process, so there is no separate compiler under test.
//
// Every worker count, `--workers=1` included, takes the one path through the pool: a serial branch
// would be a second implementation of running the suite, free to drift.
function runSpecTest(args MaxonArgs) returns ExitCode
	if refusedPositionalBeyond(args, allowed: 1, usage: "maxon spec-test [dir] [--filter=<pattern>] [--update-required] [--network] [--workers=<n>] [--target=<cpu>-<os>]") 'tooManyPaths'
		return 1
	end 'tooManyPaths'

	let specDir = try resolveSpecDir(args) otherwise 'badSpecDir'
		printError("error: invalid spec directory: {args.solePositional()}\n")
		return 1
	end 'badSpecDir'

	let harnessExe = try Process.executablePath() otherwise 'noExe'
		printError("error: could not determine the running executable's path\n")
		return 1
	end 'noExe'

	// Resolved up front so the dispatcher and a relaunched worker, which re-parses the forwarded
	// `--target`, run the same target. Prints nothing on success, so a worker's stdout wire stays
	// untouched.
	let effectiveTarget = try commandLineTarget(args.targetSpec) otherwise return 1

	// A worker speaks the job protocol on stdout, so this is checked before anything is printed.
	if args.workerPersistent 'isPoolWorker'
		// A worker asks nothing before it starts. Minting goldens for a target this host cannot execute
		// is guarded where the writing happens: see `SpecTestRunner.writeFragmentFile`'s `mayMint`.
		return runPersistentWorker(specDir, filter: args.filter, updateRequired: args.updateRequired, effectiveTarget: effectiveTarget, includeNetwork: args.includeNetwork)
	end 'isPoolWorker'

	// Below-normal priority, so a foreground process preempts the pool, which otherwise saturates
	// every core; a de-prioritised process still gets every idle core.
	//
	// After the worker branch: children inherit the priority class, so this one call reaches every
	// worker and every test binary they launch.
	//
	// The answer is discarded: on this lane the only documented failure is an invalid handle, and the
	// handle is a compile-time constant. `specs/process-background-priority.md` asserts the value.
	__Builtins.enterBackgroundPriority()

	// A stale binary reports a verdict about code that is not here, so nothing runs. Asked by the
	// parent only, after the worker branch, so the fact is reported once. The role is a bare noun
	// phrase because `refuseIfStale` makes it the subject of "<role> is STALE".
	let freshnessExit = refuseIfStale(harnessExe, role: "the spec-test harness (which is also the compiler it tests)")

	if freshnessExit != 0 'staleBinary'
		return freshnessExit
	end 'staleBinary'

	// Asked once, by the parent: a missing runner fails every test identically, and inside a worker it
	// surfaces as a dead pipe. A target with no runner on this host at all is not refused here; see
	// `requireRunnerAvailable`.
	requireRunnerAvailable(effectiveTarget)

	// An in-guest target's suite is handed whole to a compiler inside the guest
	// (`SpecTestRunner.runSuiteInGuest`), which reaches this function against the same tree: the
	// machine mirrors the checkout at identical real paths.
	//
	// The position is required. The guest contends for the same tree lock file, so the host must not
	// hold it yet; `requireRunnerAvailable` is the delegation's preflight, and `refuseIfStale` proves
	// the binary that builds the guest's compiler current.
	match runStrategyFor(effectiveTarget) 'lane'
		inGuest then return runSuiteInGuest(harnessExe, specDir: specDir, filter: args.filter, updateRequired: args.updateRequired, workerCount: args.workers, workersOverridden: args.workersOverridden, effectiveTarget: effectiveTarget, includeNetwork: args.includeNetwork)
		individually or
			wslBatch or
			noneHere then break 'lane'
	end 'lane'

	// That a verdict nothing ran is still counted and not green; see `SpecVerdictSelfTest`.
	requireSpecVerdictMapping()

	// The `.mxdbg` format is a contract with the bootstrap, which reads a sidecar this compiler
	// writes. A drifted layout is a silent misread, so it is checked before any case writes one.
	requireMxdbgRoundTrip()

	// A duplicate error-code number is the one registry defect the language cannot refuse for itself;
	// see `ErrorCodeSelfTest`.
	requireErrorCodesUnique()

	// Rides the suite because the suite is what already runs; see `LadderIndex`.
	requireLadderIndexComplete()

	// Two suites share `<specDir>/.spec-tmp`, so one would delete what the other is compiling, and a
	// build running alongside replaces the binary this run draws verdicts from. Asked after every free
	// check, so a refusal is instant and precedes any worker.
	let lockExit = acquireSuiteTreeLock(specDir)

	if lockExit != 0 'busyTree'
		return lockExit
	end 'busyTree'

	let suiteExit = runSpecSuite(args, specDir: specDir, harnessExe: harnessExe, effectiveTarget: effectiveTarget)
	releaseTreeLock()
	return suiteExit
end 'runSpecTest'

// `tests/fmt/fixtures/` pins every stream, exit code and resulting tree, so the refusals below are
// spelled here rather than through `refusedPositionalBeyond`, whose wording `fmt` does not use. A
// `-`-leading argument never reaches the walk; see `FmtCommandName`.
function runFmt(args MaxonArgs) returns ExitCode
	if not args.anyOption().isEmpty() 'refusedOption'
		printError("fmt: unrecognized option: {args.anyOption()}\n")
		printError("{FmtUsageLine}\n")
		return 1
	end 'refusedOption'

	if args.paths.count() > 1 'refusedSecondPath'
		printError("fmt: expected at most one path, got {args.paths.count()}: {joinedWith(args.paths, separator: PathListSeparator)}\n")
		return 1
	end 'refusedSecondPath'

	let spelling = args.solePositional()
	return match fmtSelection(spelling) 'selection'
		files(paths) gives formatEachFile(paths)
		notFound gives refusedFmtPath(spelling)
	end 'selection'
end 'runFmt'

union FmtSelection
	files(paths FilePathArray)

	notFound
end 'FmtSelection'

// A named file is formatted whatever it is called and wherever it sits, as `maxon build` does: the
// exclusions belong to the walk (`Formatter.collectFormattableFiles`).
function fmtSelection(spelling String) returns FmtSelection
	if spelling.isEmpty() 'noPathGiven'
		return FmtSelection.files(collectFormattableFiles(Directory.currentPath()))
	end 'noPathGiven'

	let target = try FilePath.from(spelling) otherwise return FmtSelection.notFound

	if Directory.isDirectory(target) 'aDirectory'
		return FmtSelection.files(collectFormattableFiles(target))
	end 'aDirectory'

	if File.exists(target) 'aFile'
		var only = FilePathArray.create()
		only.push(target)
		return FmtSelection.files(only)
	end 'aFile'

	return FmtSelection.notFound
end 'fmtSelection'

// An already-canonical file is not rewritten: `fmt` over a clean tree must leave every mtime alone.
function formatEachFile(files FilePathArray) returns ExitCode
	var changed = 0 as FormattedFileCount

	for file in files 'eachFile'
		let original = try File.readText(file) otherwise 'unreadable'
			printError("fmt: could not read {file}\n")
			return 1
		end 'unreadable'

		let formatted = format(original)

		if formatted != original 'differs'
			try File.writeText(file, content: formatted) otherwise 'unwritable'
				printError("fmt: could not write {file}\n")
				return 1
			end 'unwritable'

			print("formatted: {file}\n")
			changed = changed + 1
		end 'differs'
	end 'eachFile'

	print("fmt: {changed} file(s) changed, {files.count() - changed} unchanged.\n")
	return 0
end 'formatEachFile'

function refusedFmtPath(spelling String) returns ExitCode
	printError("fmt: path not found: {spelling}\n")
	return 1
end 'refusedFmtPath'

typealias FormattedFileCount = int(0 to u64.max)

let PathListSeparator = ", "

// A free function because the library carries no `String.join`.
function joinedWith(values SourcePathSpellingArray, separator String) returns String
	var out = StringBuilder.create()
	var first = true

	for value in values 'eachValue'
		if not first 'needsSeparator'
			out.append(separator)
		end 'needsSeparator'

		out.append(value)
		first = false
	end 'eachValue'

	return out.build()
end 'joinedWith'

// Taken for every suite run except a fixture sub-run, whose parent suite holds it.
function acquireSuiteTreeLock(specDir FilePath) returns ExitCode
	if isHarnessFixtureSubRun(specDir) 'parentHoldsIt'
		return 0
	end 'parentHoldsIt'

	return acquireTreeLock(specDir)
end 'acquireSuiteTreeLock'

// Separate so `runSpecTest` has one exit that releases the tree lock; see `compileAndReport`.
function runSpecSuite(args MaxonArgs, specDir FilePath, harnessExe FilePath, effectiveTarget Target) returns ExitCode
	let run = try runSpecPool(harnessExe, specDir: specDir, filter: args.filter, updateRequired: args.updateRequired, workerCount: args.workers, effectiveTarget: effectiveTarget, includeNetwork: args.includeNetwork) otherwise (e) 'runErr'
		reportCompileError(e)
		return 1
	end 'runErr'

	// A run that selected nothing fails: a mistyped `--filter` would otherwise exit 0 having tested
	// nothing, and under `--update-required` look as though it regenerated goldens.
	if run.results.count() == 0 'selectedNothing'
		// Only here does the exclusion census precede the error, because it may be the only explanation:
		// a default run's `--filter=http-client.get` selects nothing but live-network cases.
		reportExclusions(run.excluded, effectiveTarget: effectiveTarget)

		printError("error: no tests selected{filterSuffix(args.filter)}\n")
		return 1
	end 'selectedNothing'

	let testsExit = reportResults(run.results)

	// Under the verdicts rather than above them: a note printed ahead of thousands of report lines has
	// scrolled away by the summary it qualifies. Unannounced, a green column hides claims nobody
	// exercised.
	reportExclusions(run.excluded, effectiveTarget: effectiveTarget)

	// Immediately under the verdicts and above the two reports about the tree: a skip can look like
	// coverage without being any.
	reportTargetSkips(run.results, effectiveTarget: effectiveTarget)

	// One sentence for the whole lane, because the reason is the (target, host) pair.
	reportUnrunHere(tallyResults(run.results), effectiveTarget: effectiveTarget)

	// After the summary and before the exit branches, so a red run reports its cost too. Stderr,
	// because stdout must stay byte-identical between worker counts; `SuiteCpuTally.reportLine` spells
	// the line.
	printError("{run.cpu.reportLine(run.poolSize)}\n")

	// Golden drift is reported, never judged: this finds a golden that is read and disagrees. See
	// `SpecTestRunner.reportGoldenDrift`.
	reportGoldenDrift(run.results)

	// Goldens nothing compares, reported, never judged: goldens are reference, not a gate. On stderr
	// and last, so it never displaces the reason a test failed. A `.test` whose case was renamed away
	// shows in no diff, so only an enumeration finds it (`GoldenCensus`). Asked on filtered runs too,
	// because the answer comes from the spec text.
	reportUncomparedGoldens(specDir, effectiveTarget: effectiveTarget)

	if testsExit != 0 'someTestFailed'
		return testsExit
	end 'someTestFailed'

	// Every test passed — and a worker that exited NON-ZERO is still a suite failure. A worker is
	// itself a leak-gated Maxon program, so exit 101 means the harness leaked memory while
	// servicing its tests. Green tests must never be allowed to mask that.
	if run.failedWorkers > 0 'workerFailed'
		printError("error: {run.failedWorkers} spec worker(s) exited non-zero (see above) — failing the suite despite {run.results.count()} passing tests\n")
		return 1
	end 'workerFailed'

	return 0
end 'runSpecSuite'

// The trailing ` matching --filter=<pattern>` clause of the "no tests selected"
// message, omitted entirely when no filter was given (an empty spec directory and
// a filter that matched nothing are different failures and read differently).
function filterSuffix(filter String) returns String
	if filter.isEmpty() 'noFilter'
		return ""
	end 'noFilter'

	return " matching --filter={filter}"
end 'filterSuffix'

// Absolute whichever way it was spelled, and that is a correctness requirement: every path the run
// computes hangs off it, and the spawned test exe runs in `specRunWorkingDir`, against which a
// relative executable path is resolved.
function resolveSpecDir(args MaxonArgs) returns FilePath throws FilePathError
	// Bind the FilePath to a local first: a bare String constant is ambiguous between the
	// String/FilePath overloads, and an inline `try` expression in an argument position does not
	// disambiguate it.
	let spelled = try FilePath.from(specDirSpelling(args))
	return spelled.resolve(Directory.currentPath())
end 'resolveSpecDir'

function specDirSpelling(args MaxonArgs) returns String
	let spelled = args.solePositional()

	if spelled.isEmpty() 'useDefault'
		return DefaultSpecDir
	end 'useDefault'

	return spelled
end 'specDirSpelling'

// True when it refused, having printed why. A command reading at most `allowed` positionals refuses
// the next rather than obeying the first and dropping the rest: that is a command line the driver
// only partly understood. `allowed` is a count because some commands read none, and for them the
// first positional is already the typo. `module` for `Testing/ScaleTestRunner`.
module function refusedPositionalBeyond(args MaxonArgs, allowed PositionalCount, usage String) returns bool
	if args.paths.count() <= allowed 'withinBudget'
		return false
	end 'withinBudget'

	let extra = try args.paths.get(allowed) otherwise panic("refusedPositionalBeyond: the count is greater than {allowed} on the line above, so index {allowed} exists")
	printError("error: unexpected extra argument: {extra}\n")
	printError("Usage: {usage}\n")
	return true
end 'refusedPositionalBeyond'

typealias PositionalCount = int(0 to 1)

// A command's streams belong to its subject: at the default INFO level every compile announces the
// bytes it wrote, which is noise on `test`'s fixture-compared stdout, on `run`'s program streams,
// and on the report a path-less `build` makes about the build it was actually asked for. Silenced
// unless the caller asked for logging. `module` so `Testing/` and `Run/` share one rule.
//
// ⚠ **SILENCED IS NOT SILENT — the ERROR level is deliberately left speaking**, so a compile that
// fails still says why.
//
// It answers the level it found, so a caller quieting ONE compile of several can put that level
// back and let the rest be heard.
module function quietTheBuildChatter(args MaxonArgs) returns LogLevel
	let inForce = currentLogLevel()

	if args.logOverridden 'theCallerAskedForLogging'
		return inForce
	end 'theCallerAskedForLogging'

	setLogLevel(LogLevel.ERROR)
	return inForce
end 'quietTheBuildChatter'

// What `run` and `upgrade` exit with when the failure is their own; otherwise they forward the
// child's exit code. `refusedCommandLineExit` uses it for both, so the two refusals cannot exit
// differently.
module let OwnFailureExit = 1 as ExitCode

typealias SignalNumber = int(i64.min to i64.max)

// The child's stdout, stderr and exit code are the command's own (`run`'s program, `upgrade`'s
// install script). `module` so both commands share one spawn configuration.
//
// `timeoutMs = 0`: a deadline would kill a long-running child the caller launched deliberately.
module function spawnForwarding(executable Executable, arguments StringArray, environment Environment, standardInput InputSource, speaker String) returns ExitCode
	var config = Configuration.create(executable)
	config.arguments = arguments
	config.environment = environment
	config.standardInput = standardInput
	config.standardOutput = OutputDestination.inherit
	config.standardError = OutputDestination.inherit
	config.timeoutMs = 0

	let ran = try Subprocess.runConfiguration(config) otherwise (e) 'unspawnable'
		printError("{speaker}: could not run {executable.displayName()} ({e.displayReason()})\n")
		return OwnFailureExit
	end 'unspawnable'

	return match ran.status 'termination'
		exited(code) gives code as ExitCode
		signalled(code) gives reportSignalled(executable, signal: code as SignalNumber, speaker: speaker)
	end 'termination'
end 'spawnForwarding'

// A signalled child has no exit code to forward, so the signal is named and the failure is the
// command's own. No target's runtime raises `signalled` — `SubprocessRuntime` stores only the
// `exited` and `timedOut` discriminators — so an abnormal termination arrives as `exited` with the
// raw OS status; the arm is what the union owes.
function reportSignalled(executable Executable, signal SignalNumber, speaker String) returns ExitCode
	printError("{speaker}: {executable.displayName()} was killed by signal {signal}\n")
	return OwnFailureExit
end 'reportSignalled'

// A withdrawn option was understood once and is now impossible, so it owes an explanation an
// unknown one does not. The `panic` holds this list to `MaxonArgs.parse`'s: a spelling recorded
// there and unnamed here would be refused with an empty sentence.
//
// `command` matters after `upgrade`, where `--version` asks the install script for a release.
function withdrawnOptionMessage(option String, command MaxonCommand) returns String
	if option.startsWith(WithdrawnCompilerFlagPrefix) 'theCompilerFlag'
		return "error: {WithdrawnCompilerFlagPrefix}= was REMOVED. spec-test compiles every selected test IN THIS PROCESS, so the compiler under test is this executable's own code and no path can name a different one. Run the suite with the binary you mean to test: `<compiler> {SpecTestCommandName}`."
	end 'theCompilerFlag' else if option == WithdrawnVersionFlag or option == WithdrawnVersionFlagShort 'theVersionFlag'
		if command == MaxonCommand.upgrade 'aReleaseToUpgradeTo'
			return pinnedReleaseRefusal(option)
		end 'aReleaseToUpgradeTo'

		return "error: {option} was REMOVED. The version is a command, so there is one door onto it and it is listed with everything else this binary does: `maxon {VersionCommandName}`."
	end 'theVersionFlag' else if option == WithdrawnHelpFlag or option == WithdrawnHelpFlagShort 'theHelpFlag'
		return "error: {option} was REMOVED. Help is a command, so there is one door onto it and it is listed with everything else this binary does: `maxon {HelpCommandName}` for the whole reference, `maxon {HelpCommandName} <command>` for one command."
	end 'theHelpFlag'

	panic("withdrawnOptionMessage: '{option}' was recorded as a withdrawn option by `MaxonArgs.parse`, and this is the one place that says what replaced one — a flag recorded there and unnamed here would be refused with an empty sentence")
end 'withdrawnOptionMessage'

// Golden drift is not in the pass/fail counts: a test whose golden no longer matches still passed,
// so `0 failed` means the spec tests passed, and drift gets its own line.
//
// A case that did not run is in neither count; its own line and stderr note say why. The summary
// line's shape is fixed — scripts read `^N passed, M failed` — so each extra count follows on a
// line of its own.
function reportResults(results SpecTestResultArray) returns ExitCode
	for result in results 'each'
		print("{verdictLine(result.outcome, label: testLabel(result.specName, testName: result.testName))}\n")
	end 'each'

	let tally = tallyResults(results)
	print("\n{tally.passed} passed, {tally.failed} failed\n")

	// Silent at zero, like every trailer.
	if tally.skipped > 0 'anySkipped'
		print("{tally.skipped} skipped — NOT RUN on this target (see the note on stderr for the constructs)\n")
	end 'anySkipped'

	if tally.notRunHere > 0 'anyUnrunnable'
		print("{tally.notRunHere} not run here — COMPILED and compared against a committed golden where one exists, but this host cannot execute them (see the note on stderr)\n")
	end 'anyUnrunnable'

	// `scripts/shared-stdlib-memo-gate.sh` reads this: without it a run that compared nothing is
	// indistinguishable from one that compared everything.
	if tally.compared > 0 'anyCompared'
		print("{tally.compared} compared against a committed golden\n")
	end 'anyCompared'

	// Under the not-run lines because it qualifies neither: a drifted case is already counted in its
	// column. The differences are in the stderr trailer.
	if tally.drifted > 0 'anyDrifted'
		print("{goldenDriftSummary(tally.drifted)}\n")
	end 'anyDrifted'

	// A run in which nothing ran fails, like `runSpecSuite`'s empty selection: here everything
	// selected was skipped by the target or cannot execute on this host. It is also the backstop
	// should every case start answering E3104.
	if tally.provedNothing() 'nothingRan'
		printError("error: every selected test was SKIPPED or NOT RUN on this host, so this run proved nothing — the notes below name the constructs this target has no implementation for and the binaries this host cannot execute\n")
		return 1
	end 'nothingRan'

	if tally.failed > 0 'anyFailed'
		return 1
	end 'anyFailed'

	return 0
end 'reportResults'

// A SKIP prints no reason: E3104's diagnostic names a scratch path and spans lines, so the stderr
// census prints it once per case. A NOTRUN prints none because every case on such a lane shares one
// reason, stated once in the trailer.
module function verdictLine(outcome TestOutcome, label String) returns String
	return match outcome 'verdict'
		pass gives "PASS {label}"
		fail(reason) gives "FAIL {label}: {reason}"
		skipped gives "SKIP {label}"
		notRunHere gives "NOTRUN {label}"
	end 'verdict'
end 'verdictLine'

// The first bad option wins, so the report points at the flag a reader would look at first rather
// than the rightmost.
function firstBadOption(current String, arg String) returns String
	if current.isEmpty() 'firstBad'
		return arg
	end 'firstBad'

	return current
end 'firstBadOption'

// Written through the diagnostic sink, so an in-process caller capturing it
// (`SpecTestRunner.compileOneTest`) reads exactly what a command line prints — including the arms
// that never reach `project.diagnostics`.
//
// The `compileError` arm is silent: its diagnostics were already emitted through the same sink, so
// a failing build's stderr is exactly those lines (the `maxoncstderr` spec contract).
//
// `emitDiagnosticLine` terminates each line, so no arm carries its own newline.
module function reportCompileError(e CompileError)
	match e 'report'
		fileNotFound(p) then emitDiagnosticLine("error: file not found: {p}")
		directoryNotFound(p) then emitDiagnosticLine("error: directory not found: {p}")
		noSourceFiles(r) then emitDiagnosticLine("error: no source files under {r}")

		// Not "share no directory": two top-level directories on one drive share the drive root, which a
		// `FilePath` cannot hold (see `Compiler.commonAncestorOf`).
		noCommonRoot(first, other) then emitDiagnosticLine("error: {first} and {other} have no common directory this build can be rooted at. Name a directory they are both under as one of the paths, or build them separately")
		unnamedDirectory(d) then emitDiagnosticLine("error: {d} has no name for its executable to take. Name the output with -o")
		invalidOutputPath(spelling) then emitDiagnosticLine("error: -o {spelling} is not a valid path")
		readError(p) then emitDiagnosticLine("error: could not read {p}")
		stdlibNotFound then emitDiagnosticLine("error: could not locate the stdlib/ directory (every compile loads stdlib source)")
		runtimeNotFound then emitDiagnosticLine("error: could not locate the runtime/ directory beside stdlib/ (every compile loads runtime source)")
		compileError then break 'report'
	end 'report'
end 'reportCompileError'

// `test` exits 2 on a refused command line because it documents 0/1/2 as three answers and CI
// branches on "a test failed" versus "the harness never ran". Every other command's 1 is
// load-bearing for callers that already read it.
//
// Exhaustive with no default arm, so a new command has to state which it is.
function refusedCommandLineExit(command MaxonCommand) returns ExitCode
	return match command 'whichCommand'
		test gives NothingRanExitCode
		build gives 1
		cache gives 1
		coverage gives 1
		debug gives 1
		fmt gives 1
		help gives 1
		lspServer gives 1
		mcpServer gives 1
		monitor gives 1
		profile gives 1
		run gives OwnFailureExit
		scaleTest gives 1
		specTest gives 1
		upgrade gives OwnFailureExit
		verifyRecheck gives 1
		verifyWarmRebuild gives 1
		version gives 1
		unknown gives 1
	end 'whichCommand'
end 'refusedCommandLineExit'

// Shared by `version` and the no-argument overview, so the two cannot give different answers. It
// carries the host triple because several targets ship under one name.
function versionLine() returns String
	return "maxon {CompilerVersion} ({CompilerCommit} {CompilerCommitDate}) ({targetToString(detectHostTarget())})"
end 'versionLine'

// It refuses every option but `--dev`, including ones this driver implements elsewhere: it speaks a
// protocol on stdout, so a flag honoured silently would corrupt a session no caller can inspect.
// The refusal goes to stderr before the first frame.
function runMcpServerCommand(args MaxonArgs) returns ExitCode
	if refusedPositionalBeyond(args, allowed: 0, usage: "maxon {McpServerCommandName} [{DevFlag}]") 'unexpectedArgument'
		return 1
	end 'unexpectedArgument'

	let stray = args.firstOptionOtherThan(DevFlag)

	if not stray.isEmpty() 'refusedOption'
		printError("error: {McpServerCommandName} takes no option but {DevFlag}: {stray}\n")
		return 1
	end 'refusedOption'

	return runMcpServer(args.devMode)
end 'runMcpServerCommand'

// To stdout, because scripts read it (the release workflow compares it against the tag). A
// positional is refused: `maxon version 1.2.3` must not print an answer that ignores half of what
// was typed.
function runVersion(args MaxonArgs) returns ExitCode
	if refusedPositionalBeyond(args, allowed: 0, usage: "maxon {VersionCommandName}") 'unexpectedArgument'
		return 1
	end 'unexpectedArgument'

	print("{versionLine()}\n")
	return 0
end 'runVersion'

// `unknown` is the absence of a command and has no reference. Every roster walk goes through
// `namedCommands`, which leaves it out, so reaching this is a caller that did not.
enum HelpReferenceError implements Error
	notACommand
end 'HelpReferenceError'

typealias MaxonCommandArray = Array with MaxonCommand

// Ends in a colon, which no command label does: `tests/cli` tells a heading from a section by that.
let CompilerWorkHeading = "Commands for working on the compiler itself:"

let ParagraphSeparator = "\n"
let WordSeparator = " "

// Decides where a command is listed: `maxon` lists only `usingTheCompiler`, `maxon help` lists
// both. A command left off a listing is still parsed and run: `commandFromWord` walks every named
// command.
enum CommandAudience
	usingTheCompiler

	workingOnTheCompiler
end 'CommandAudience'

// Held together so no field has a second table: `commandFromWord` decides what the parser accepts
// by reading `word` back out of here.
type CommandReference
	export var word as String

	// Empty for a command that takes none.
	export var arguments as String

	// One line, and all that `maxon` with no arguments says about the command.
	export var summary as String

	// Empty when the summary says everything. Paragraphs are separated by `ParagraphSeparator`;
	// nothing is wrapped by hand.
	export var detail as String

	export var audience as CommandAudience

	export static function create(word String, arguments String, summary String, detail String, audience CommandAudience) returns CommandReference
		return Self{word: word, arguments: arguments, summary: summary, detail: detail, audience: audience}
	end 'create'

	export function label() returns String
		return self.word if self.arguments.isEmpty() else "{self.word} {self.arguments}"
	end 'label'

	export function description() returns String
		return self.summary if self.detail.isEmpty() else "{self.summary} {self.detail}"
	end 'description'
end 'CommandReference'

// The one command roster: every printer walks it and `commandFromWord` reads it backwards. The
// match is exhaustive with no default arm, so a new `MaxonCommand` does not compile until it is
// documented, and no word can be accepted without being printed.
function commandReference(command MaxonCommand) returns CommandReference throws HelpReferenceError
	return match command 'whichCommand'
		build gives CommandReference.create(BuildSubcommandName, arguments: "<file|directory>...", summary: "Compile a Maxon program to an executable.", detail: "Several paths are compiled as ONE program, in the order given.", audience: CommandAudience.usingTheCompiler)
		cache gives CommandReference.create(CacheCommandName, arguments: "[{CacheClearVerb}]", summary: "Report what this compiler has cached on the host, or remove it.", detail: "With no verb it reports, on stdout: a line per cache directory this host keeps, naming the one a run will use, how many builds it holds and how much disk. A build is the executable; the debug sidecar beside one is not a build, and its bytes are counted in the size because clearing gives them back. A directory that cannot be read says so and the command exits 1.{ParagraphSeparator}`{CacheClearVerb}` removes the compiled programs `{RunCommandName}` and a path-less `{BuildSubcommandName}` keep, the directories holding them, and the Maxon directory above those. It removes nothing else in a directory you named through {RunCacheRootVariable}, which Maxon does not own. Nothing to remove is an ordinary state and is reported as success.{ParagraphSeparator}The cache is the first of {cacheRootChain()} whose variable names a directory this compiler can create, and both the report and `{CacheClearVerb}` reach every one of them this host names, because a build published while a different one ranked first is stranded under it otherwise.", audience: CommandAudience.usingTheCompiler)
		coverage gives CommandReference.create(CoverageCommandName, arguments: "<run|report> <exe>", summary: "Run a {CoverageFlag} binary and report line + branch coverage.", detail: "Everything after the executable is the CHILD's command line and reaches it untouched.", audience: CommandAudience.usingTheCompiler)
		debug gives CommandReference.create(DebugCommandName, arguments: "<subcommand> <exe>", summary: "Read back the `.mxdbg` debug-info sidecar beside a binary.", detail: "`--dump-info <exe>` prints the sidecar; `--symbolize <exe> <offset>...` resolves `.text` code offsets to file:line:col.", audience: CommandAudience.usingTheCompiler)
		fmt gives CommandReference.create(FmtCommandName, arguments: "[<file|directory>]", summary: "Re-print Maxon sources in canonical layout, IN PLACE.", detail: "With no path it formats the working directory. A named FILE is formatted whatever it is called; a DIRECTORY is walked for `.maxon` files, skipping `build.maxon`, anything under a `.maxonignore`, and any subdirectory that is its own checkout. Takes no options.", audience: CommandAudience.usingTheCompiler)
		help gives CommandReference.create(HelpCommandName, arguments: "[<command>]", summary: "Print this reference: every command's options, or one command's.", detail: "`maxon` with no arguments prints the short list instead.", audience: CommandAudience.usingTheCompiler)
		lspServer gives CommandReference.create(LspServerCommandName, arguments: "", summary: "Speak the Language Server Protocol over stdio.", detail: "JSON-RPC bodies under Content-Length framing, the initialize / shutdown / exit lifecycle, and full text-document synchronisation.", audience: CommandAudience.usingTheCompiler)
		mcpServer gives CommandReference.create(McpServerCommandName, arguments: "[{DevFlag}]", summary: "Speak the Model Context Protocol over stdio.", detail: "JSON-RPC bodies over newline-delimited stdio, providing MCP tools for compiling, testing, inspecting, and formatting Maxon code. With {DevFlag}, also exposes compiler development tools.", audience: CommandAudience.usingTheCompiler)
		monitor gives CommandReference.create(MonitorCommandName, arguments: "<exe> [args...]", summary: "Launch an executable with the debug-stream monitor attached.", detail: "Everything after the executable is the CHILD's command line and reaches it untouched.", audience: CommandAudience.usingTheCompiler)
		profile gives CommandReference.create(ProfileCommandName, arguments: "run <exe>", summary: "Launch a program and sample where its CPU time goes.", detail: "It needs no instrumentation and no rebuild: only the `.mxdbg` sidecar is read.", audience: CommandAudience.usingTheCompiler)
		run gives CommandReference.create(RunCommandName, arguments: "<file|directory> [args...]", summary: "Compile a program and run it, reusing a cached build when nothing changed.", detail: "Everything after the path is the PROGRAM's command line and reaches it untouched; its stdin, stdout, stderr and exit code are this command's own, and the build itself says nothing.{ParagraphSeparator}A first argument ending in `{MaxonSourceExtension}` selects this command with no word at all, which is what a kernel hands the interpreter for a file whose first line is `#!/usr/bin/env maxon`.{ParagraphSeparator}The build is kept in a per-program directory under the first of {cacheRootChain()} whose variable names a directory this compiler can create, and reused while the program's sources, the standard library and this compiler all still hash the same. `{CacheCommandName} {CacheClearVerb}` empties it. Freshness is a CONTENT hash rather than a timestamp: a file's modification time is whole seconds, so an edit landing in the same second as a build would tie.", audience: CommandAudience.usingTheCompiler)
		scaleTest gives CommandReference.create(ScaleTestCommandName, arguments: "", summary: "Measure how this compiler scales, on a doubling ladder of programs.", detail: "Each rung is compiled and its per-phase cost reported. The MEMORY columns (allocations, frees and bytes) are exact and reproducible; the CPU column is the ticks the compiling thread spent. It does NOT collect WALL time: wall time counts every other process on the box, so a dated table of it would compare a loaded machine in July against an idle one in August. The ladder doubles, so the ratio between rungs IS the growth (x2.00 linear, x4.00 quadratic) and nothing is fitted.{ParagraphSeparator}An INSTRUMENT, not a gate: it renders no verdict, and it exits non-zero only when the RUN broke. The trend it feeds is {OptimizationLogRelativePath}.", audience: CommandAudience.workingOnTheCompiler)
		specTest gives CommandReference.create(SpecTestCommandName, arguments: "[dir]", summary: "Run the specs suite (default dir: {DefaultSpecDir}).", detail: "Every selected case is compiled IN THIS PROCESS, so the compiler under test is this executable's own code and no path can name a different one.", audience: CommandAudience.workingOnTheCompiler)
		test gives CommandReference.create(TestCommandName, arguments: "[dir]", summary: "Run a PROJECT's own `test` declarations (default: the working dir).", detail: "Every test found is compiled into ONE binary with a generated entry point and run; which of them RUN is a runtime argument, so a filter change costs no recompile. NOT specs: that is `{SpecTestCommandName}`.{ParagraphSeparator}Exit 0 every test passed; 1 a test failed, crashed, timed out, leaked, did not run, or NO TESTS WERE FOUND, which is never reported as success; {NothingRanExitCode} the run could not happen.", audience: CommandAudience.usingTheCompiler)
		upgrade gives CommandReference.create(UpgradeCommandName, arguments: "[{DryRunFlag}]", summary: "Update this compiler's install to the newest release.", detail: "It runs the published install script again, against the install this binary sits in, whatever {InstallRootVariable} says. A Homebrew keg, a container image and a source checkout are refused, each naming the command that does update it.", audience: CommandAudience.usingTheCompiler)
		verifyRecheck gives CommandReference.create(VerifyRecheckCommandName, arguments: "<file|dir>", summary: "Assert ONE Project can be re-checked.", detail: "Two checks over unchanged input agree, and a diagnostic introduced by an edit CLEARS when the edit is undone. `{VerifyWarmRebuildCommandName}` gates the query spine without ever running the pipeline; this gates the pipeline over it, which is what an editor holding one project open for hours actually does.", audience: CommandAudience.workingOnTheCompiler)
		verifyWarmRebuild gives CommandReference.create(VerifyWarmRebuildCommandName, arguments: "<file>", summary: "Assert the query spine is deterministic + incremental.", detail: "It exits 0 iff both properties hold, and never runs the pipeline over the spine it gates: `{VerifyRecheckCommandName}` is the command that does.", audience: CommandAudience.workingOnTheCompiler)
		version gives CommandReference.create(VersionCommandName, arguments: "", summary: "Print the version, the commit it was built from and the host target.", detail: "It runs nothing, and goes to stdout, where a pipe can reach it.", audience: CommandAudience.usingTheCompiler)
		unknown throws HelpReferenceError.notACommand
	end 'whichCommand'
end 'commandReference'

// Declaration order is listing order. `--worker-persistent` is absent: the parent sets it on a
// worker's command line and nobody usefully types it, though it is still parsed.
enum HelpOption
	output
	emitIr
	emitIrRuntime
	target
	noDebugInfo
	coverageInstrumentation
	asyncTrace
	debugStream
	define
	metrics
	specFilter
	updateRequired
	network
	workers
	rungs
	repeat
	note
	emitCorpus
	resultJson
	testFilter
	testList
	testJson
	testIsolate
	testBail
	testTimeout
	testNoTiming
	testColor
	dryRun
	devMode
end 'HelpOption'

// The commands are a field so the option is printed under each command that reads it, making `maxon
// help <command>` that command's whole surface.
type OptionReference
	export var spelling as String
	export var description as String
	export var commands as MaxonCommandArray

	export static function create(spelling String, description String, commands MaxonCommandArray) returns OptionReference
		return Self{spelling: spelling, description: description, commands: commands}
	end 'create'
end 'OptionReference'

// Every spelling is the constant the parser matches, so a renamed flag is renamed here by the same
// edit.
function optionReference(option HelpOption) returns OptionReference
	return match option 'whichOption'
		output gives OptionReference.create("{OutputFlagName}, {OutputFlagPrefix}<path>", description: "Output executable path (default: derived from input).", commands: [MaxonCommand.build])
		emitIr gives OptionReference.create(EmitIrFlag, description: "Also write the lowered Target IR beside the exe as <output>.ir.", commands: [MaxonCommand.build])
		emitIrRuntime gives OptionReference.create("{EmitIrRuntimeFlagPrefix}<a>,<b>", description: "Render these compiler-emitted functions in that IR too. A list of functions to print is a request for the printing, so it implies {EmitIrFlag}.", commands: [MaxonCommand.build])
		target gives OptionReference.create("{TargetFlagPrefix}<cpu>-<os>", description: "Use this target instead of the host, one of: {supportedTargetList()} (default: the host target). For {SpecTestCommandName} a cross target cross-compiles each selected test and runs it under the vendored runtime. For {TestCommandName} it builds the test binary for that target and then SPAWNS it, so a target this host cannot execute reports every test as not run.", commands: [MaxonCommand.build, MaxonCommand.specTest, MaxonCommand.test])
		noDebugInfo gives OptionReference.create(NoDebugInfoFlag, description: "Do NOT write the <output>.mxdbg debug-info sidecar. It is written BY DEFAULT, and the executable is byte-identical either way: the sidecar never decides which instructions are emitted, so the binary you debug is the binary you shipped.", commands: [MaxonCommand.build])
		coverageInstrumentation gives OptionReference.create(CoverageFlag, description: "Instrument for code coverage: the binary counts each statement and branch arm it executes and writes them to <output>{MxcovDataExtension} as it exits. It CHANGES the emitted code, so it is a separate build; read it back with `{CoverageCommandName}`. It requires the debug-info sidecar, which carries what each counter counts.", commands: [MaxonCommand.build])
		asyncTrace gives OptionReference.create(AsyncTraceFlag, description: "Write the green-thread trace to stderr as the program runs: one line per spawn, io_yield, io_resume and await. Opt-in per build: a build without it emits no trace calls at all.", commands: [MaxonCommand.build])
		debugStream gives OptionReference.create(DebugStreamFlag, description: "Emit the DebugStream producer that `{MonitorCommandName}` reads: the memory manager writes its events into a shared-memory ring. Opt-in per build: a build without it is unchanged. Refused on a target that cannot provide one.", commands: [MaxonCommand.build])
		define gives OptionReference.create("{DefineFlagPrefix}<name>{DefineNameValueSeparator}<value>", description: "Replace a top-level `String` constant's written-out default. The VALUE may contain `{DefineNameValueSeparator}` and the name may not, so the split is at the first one.", commands: [MaxonCommand.build, MaxonCommand.verifyRecheck])
		metrics gives OptionReference.create("{MetricsFlagPrefix}<path>", description: "Write this compile's per-phase time + memory attribution to <path> as TSV. `--log=compiler:debug` prints the same numbers as a human-readable table.", commands: [MaxonCommand.build])
		specFilter gives OptionReference.create("{FilterFlagPrefix}<pattern>", description: "Run only tests whose `<spec>/<test>` label contains <pattern>. A bare spec name selects that whole spec.", commands: [MaxonCommand.specTest])
		updateRequired gives OptionReference.create(UpdateRequiredFlag, description: "Rewrite the committed .test goldens instead of checking against them. Running a test proves its allocation is CORRECT; only the pinned IR proves the code did not get WORSE. REVIEW THE RESULTING DIFF. Pair it with {FilterFlagPrefix}: an unfiltered run rewrites EVERY golden in the suite.", commands: [MaxonCommand.specTest])
		network gives OptionReference.create(NetworkFlag, description: "Also run the cases marked `{NetworkMarker} {NetworkLiveValue} -->`, which open a socket to a REAL EXTERNAL HOST. They are OUT of a default run because their verdict measures somebody else's uptime rather than this compiler; a default run NAMES every one it left out.", commands: [MaxonCommand.specTest])
		workers gives OptionReference.create("{WorkersFlagPrefix}<n>", description: "Run the suite on <n> persistent worker subprocesses (default {defaultWorkerCount()}, this machine). 1 is this same pool with one worker in it, NOT a serial path: every worker count must print BYTE-IDENTICAL output, and that invariance is the pool's sharpest gate.", commands: [MaxonCommand.specTest])
		rungs gives OptionReference.create("{RungsFlagPrefix}<n>", description: "Climb <n> rungs (default {DefaultRungCount}, range {MinRungCount}-{MaxRungCount}). Each rung DOUBLES the program, so this is exponential in cost.", commands: [MaxonCommand.scaleTest])
		repeat gives OptionReference.create("{RepeatFlagPrefix}<n>", description: "Compile every rung <n> times (default {DefaultRepeatCount}, range {MinRepeatCount}-{MaxRepeatCount}) and report the LEAST CPU ticks any of them spent in each phase, the least-disturbed sample:  noise can only ADD to a CPU reading and a mean would be dragged by one stall. The MEMORY columns take nothing from a repeat: they are exact, so they come from the first compile and are CROSS-CHECKED for equality against the rest. A memory number that differs between two compiles of one rung is a BROKEN RUN.", commands: [MaxonCommand.scaleTest])
		note gives OptionReference.create("{NoteFlagPrefix}<text>", description: "Record this run in {OptimizationLogRelativePath}: one dated row of the per-rung allocations and bytes, with <text> as the reason. Without it a run reports and records nothing; WITH it the row is written, moved or not, because it is an INSTRUCTION. The instrument can see exactly WHAT moved and can never see why; you are the only one who knows, and only now.", commands: [MaxonCommand.scaleTest])
		emitCorpus gives OptionReference.create("{EmitCorpusFlagPrefix}<dir>", description: "Write the generated corpus to <dir> and compile nothing.", commands: [MaxonCommand.scaleTest])
		resultJson gives OptionReference.create("{ResultJsonFlagPrefix}<path>", description: "Write the whole run (per-rung and per-phase memory, and the deltas from the last recorded run) to <path> as JSON, so a tool never has to scrape the human report.", commands: [MaxonCommand.scaleTest])
		testFilter gives OptionReference.create("{TestFilterShortFlag} P, {TestFilterShortPrefix}P, {FilterFlagPrefix}P", description: "Run only tests whose NAME or FILE contains P (case-insensitive; comma-separated patterns are a union).", commands: [MaxonCommand.test])
		testList gives OptionReference.create(TestListFlag, description: "Print the tests that would run and compile nothing.", commands: [MaxonCommand.test])
		testJson gives OptionReference.create(TestJsonFlag, description: "Emit the report as JSON instead of text.", commands: [MaxonCommand.test])
		testIsolate gives OptionReference.create(TestIsolateFlag, description: "Run every test in its own process, rather than one process per test FILE.", commands: [MaxonCommand.test])
		testBail gives OptionReference.create("{TestBailFlag}, {TestBailFlagPrefix}N", description: "Stop claiming new work after N failures (default {DefaultBailAfter}); the shard already running finishes, so the total may exceed N.", commands: [MaxonCommand.test])
		testTimeout gives OptionReference.create("{TestTimeoutFlagPrefix}<ms>", description: "Kill a test process after <ms> milliseconds (default {DefaultTestTimeoutMs}). A whole file shares one process, so {TestIsolateFlag} is what gives each test the full budget to itself.", commands: [MaxonCommand.test])
		testNoTiming gives OptionReference.create(TestNoTimingFlag, description: "Omit durations, making stdout byte-reproducible.", commands: [MaxonCommand.test])
		testColor gives OptionReference.create("{TestColorFlagPrefix}{reportColorChoices()}", description: "Colour the report; `auto` means only when stdout is a terminal: not redirected, NO_COLOR unset, TERM not `dumb`. Only wasm32-wasi cannot detect a terminal; there `auto` degrades to `never`, so use `always` to force colour.", commands: [MaxonCommand.test])
		dryRun gives OptionReference.create(DryRunFlag, description: "Print the install root and the command that would update it, and run nothing. It never bypasses a refusal.", commands: [MaxonCommand.upgrade])
		devMode gives OptionReference.create(DevFlag, description: "Enable compiler development tools (run_spec_test, run_scale_test, spec_test_outcome, worktree targeting).", commands: [MaxonCommand.mcpServer])
	end 'whichOption'
end 'optionReference'

// Every roster walk comes through here, so `unknown` is skipped in one place.
function namedCommands() returns MaxonCommandArray
	var named = MaxonCommandArray.create()

	for command in MaxonCommand.allCases 'eachCase'
		if command != MaxonCommand.unknown 'itNamesACommand'
			named.push(command)
		end 'itNamesACommand'
	end 'eachCase'

	return named
end 'namedCommands'

// Declaration order is alphabetical, so a filtered run needs no sort.
function commandsFor(audience CommandAudience) returns MaxonCommandArray
	var selected = MaxonCommandArray.create()

	for command in namedCommands() 'eachCommand'
		let reference = try commandReference(command) otherwise panic("commandsFor: `namedCommands` leaves `unknown` out, so every command reaching here has a reference")

		if reference.audience == audience 'thisAudience'
			selected.push(command)
		end 'thisAudience'
	end 'eachCommand'

	return selected
end 'commandsFor'

// How `MaxonArgs.parse` tells a command word from a path. `unknown` is this enum's name for no
// command, so returning it is the answer, not a sentinel.
function commandFromWord(word String) returns MaxonCommand
	for command in namedCommands() 'eachCommand'
		let reference = try commandReference(command) otherwise panic("commandFromWord: `namedCommands` leaves `unknown` out, so every command reaching here has a reference")

		if reference.word == word 'thisOne'
			return command
		end 'thisOne'
	end 'eachCommand'

	return MaxonCommand.unknown
end 'commandFromWord'

// Every row is wrapped from one label column and one prose width, because labels are derived (the
// colour modes, the supported targets) and grow. An overlong label takes its own line.
function printHelpEntry(label String, text String)
	if text.trim().isEmpty() 'noProse'
		panic("printHelpEntry: '{label}' has no description, and every command and option in the reference owes the reader one")
	end 'noProse'

	let indent = padRight("", width: UsageEntryColumnWidth)
	var firstPrefix = padRight(label, width: UsageEntryColumnWidth)

	// Bytes here and graphemes in the wrap, deliberately: this asks `padRight`'s question, which
	// counts bytes, while the wrap asks how wide the line looks, where an em-dash is one column and
	// three bytes.
	if label.byteLength() >= UsageEntryColumnWidth 'theLabelFillsItsColumn'
		print("{label}\n")
		firstPrefix = indent.clone()
	end 'theLabelFillsItsColumn'

	printWrappedProse(text, firstPrefix: firstPrefix, indent: indent)
end 'printHelpEntry'

// `indent` also sets the measure, since an indented line has that much less room. Each paragraph
// starts a line of its own.
function printWrappedProse(text String, firstPrefix String, indent String)
	let width = UsageLineWidth - indent.count()
	var prefix = firstPrefix

	for paragraph in text.split(ParagraphSeparator) 'eachParagraph'
		var line = ""

		for word in paragraph.split(WordSeparator) 'eachWord'
			if word.isEmpty() 'aRunOfSpaces'
				continue
			end 'aRunOfSpaces'

			if line.isEmpty() 'theFirstWordOfALine'
				line = word
			end 'theFirstWordOfALine' else if line.count() + word.count() + WordSeparator.count() <= width 'itFits'
				line = "{line}{WordSeparator}{word}"
			end 'itFits' else 'itWrapsHere'
				print("{prefix}{line}\n")
				prefix = indent
				line = word
			end 'itWrapsHere'
		end 'eachWord'

		if not line.isEmpty() 'theLastLineOfTheParagraph'
			print("{prefix}{line}\n")
			prefix = indent
		end 'theLastLineOfTheParagraph'
	end 'eachParagraph'
end 'printWrappedProse'

// Short, because it answers the only question a caller with nothing to go on can ask; the full
// reference is one of the commands listed.
function printOverview()
	printVersionHeader()
	print("\n")
	printCommandList()
end 'printOverview'

// ASCII only, because a Windows console renders stdout in its own code page.
let EarlyPreviewNotice = "warning: Maxon is an early preview. The language, standard library and tools may change incompatibly between releases."

function printVersionHeader()
	print("{versionLine()}\n{EarlyPreviewNotice}\n")
end 'printVersionHeader'

// Also printed under every refusal in `main`: a refusal owes the reader the way back.
function printCommandList()
	print("Usage: maxon <command> [options]\n")
	print("\n")
	print("Commands:\n")

	for command in commandsFor(CommandAudience.usingTheCompiler) 'eachCommand'
		let reference = try commandReference(command) otherwise panic("printCommandList: `namedCommands` leaves `unknown` out, so every command reaching here has a reference")
		printHelpEntry("  {reference.label()}", text: reference.summary)
	end 'eachCommand'

	print("\n")

	// Names the omission, so a reader who needs `spec-test` knows to look further: the list is short,
	// not incomplete.
	printWrappedProse("Run `maxon {HelpCommandName}` for every command's options (including the ones for working on the compiler itself), or `maxon {HelpCommandName} <command>` for one command's.", firstPrefix: "", indent: "")
end 'printCommandList'

function printCommandSection(command MaxonCommand)
	let reference = try commandReference(command) otherwise panic("printCommandSection: `unknown` names no command, and every caller resolves a word to a real one first")
	printHelpEntry(reference.label(), text: reference.description())

	for option in HelpOption.allCases 'eachOption'
		let entry = optionReference(option)

		if entry.commands.contains(command) 'thisCommandReadsIt'
			printHelpEntry("  {entry.spelling}", text: entry.description)
		end 'thisCommandReadsIt'
	end 'eachOption'
end 'printCommandSection'

// Nothing is left out here: this is where a command the short list omits is found.
function printFullReference()
	print("Usage: maxon <command> [options]\n")
	printReferenceRun(CommandAudience.usingTheCompiler, heading: "")
	printReferenceRun(CommandAudience.workingOnTheCompiler, heading: CompilerWorkHeading)
end 'printFullReference'

// An empty heading prints none: the first run is what this binary is for.
function printReferenceRun(audience CommandAudience, heading String)
	if not heading.isEmpty() 'itIsHeaded'
		print("\n")
		print("{heading}\n")
	end 'itIsHeaded'

	for command in commandsFor(audience) 'eachCommand'
		print("\n")
		printCommandSection(command)
	end 'eachCommand'
end 'printReferenceRun'

function helpUsageLine() returns String
	return "maxon {HelpCommandName} [<command>]"
end 'helpUsageLine'

// Refuses options through `anyOption` rather than `badOption`, which never sees a flag this driver
// implements: `maxon --emit-ir help` would otherwise print the reference as though the flag meant
// something.
function runHelp(args MaxonArgs) returns ExitCode
	if not args.anyOption().isEmpty() 'refusedOption'
		printError("error: {HelpCommandName} takes no options: {args.anyOption()}\n")
		printError("Usage: {helpUsageLine()}\n")
		return 1
	end 'refusedOption'

	if refusedPositionalBeyond(args, allowed: 1, usage: helpUsageLine()) 'unexpectedArgument'
		return 1
	end 'unexpectedArgument'

	let named = args.solePositional()

	if named.isEmpty() 'theWholeReference'
		printFullReference()
		return 0
	end 'theWholeReference'

	let command = commandFromWord(named)

	if command == MaxonCommand.unknown 'noSuchCommand'
		printError("error: unknown command: {named}\n")
		printCommandList()
		return 1
	end 'noSuchCommand'

	printCommandSection(command)
	return 0
end 'runHelp'

// Nothing typed is a question: `maxon` alone answers with the version and the command list and
// exits 0. A word naming no command, or an option with no command, is a mistake: the same list
// under an error on stderr, exit 1.
function noCommandGiven(args MaxonArgs) returns ExitCode
	if args.paths.isEmpty() and args.anyOption().isEmpty() 'nothingWasTyped'
		printOverview()
		return 0
	end 'nothingWasTyped'

	if args.paths.isEmpty() 'anOptionWithNoCommand'
		printError("error: no command given, and {args.anyOption()} names an option rather than one\n")
	end 'anOptionWithNoCommand' else 'aWordThatNamesNoCommand'
		printError("error: unknown command: {args.solePositional()}\n")
	end 'aWordThatNamesNoCommand'

	printCommandList()
	return 1
end 'noCommandGiven'

// Declaration order is listing order, alphabetical by command word: `tests/cli` asserts the
// advertised list is sorted, and no usage-frequency order could be checked. Nothing reads a case's
// ordinal or raw value.
enum MaxonCommand
	build

	cache

	coverage

	debug

	fmt

	help
	lspServer
	mcpServer

	monitor

	profile

	run
	scaleTest
	specTest

	test

	upgrade
	verifyRecheck
	verifyWarmRebuild

	version

	// Not a command: the absence of one, left out of every listing by `namedCommands`.
	unknown
end 'MaxonCommand'

// Spellings, not yet `FilePath`s: an invalid path is a command-line error reported with the text
// the caller wrote.
export typealias SourcePathSpellingArray = Array with String

// `module` because `Testing/ScaleTestRunner` takes the parsed args.
module type MaxonArgs
	export var command as MaxonCommand

	// The order is load-bearing: `build` compiles every positional, and `Compiler.loadSourceFiles`
	// registers sources in this order, which is how a caller states which of two sibling files
	// declares first. Every other command refuses beyond its count (`refusedPositionalBeyond`).
	export var paths as SourcePathSpellingArray
	export var outputOverride as String
	export var emitIr as bool

	export var asyncTrace as bool

	export var debugStream as bool

	// Read only by `build`; see `NoDebugInfoFlag` for why it defaults to true.
	export var debugInfo as bool

	// Read only by `build`, which refuses it without `debugInfo` or on a target with no file surface.
	export var coverage as bool

	// Empty is the ordinary build, not a sentinel. Implies `emitIr` (see `parse`).
	export var runtimeIrNames as RuntimeFunctionNameArray

	export var filter as String

	// Deliberately an explicit act: the resulting golden diff is the review.
	export var updateRequired as bool

	// 1 is the same pool with one worker in it, not a serial branch; see `runSpecTest`.
	export var workers as WorkerCount

	// Whether `--workers=` was typed: `SpecTestRunner.spawnGuestSuite` forwards the flag only then,
	// and a typed count may equal the default this host computed.
	export var workersOverridden as bool

	// Set by the parent on a worker's command line and never typed, so absent from the reference;
	// parsed because an unrecognized flag aborts the run.
	export var workerPersistent as bool

	// An array, not a map: two defines of one name is a thing to notice, and a map would silently keep
	// the last.
	export var defines as DefineArray

	export var metricsPath as String

	export var emitCorpus as String

	export var rungs as RungCount

	export var repeat as RepeatCount

	// A run without it records nothing: scale-test runs dozens of times a day against dirty trees. See
	// `Testing/ScaleHistory.maxon`.
	export var note as String

	// So the MCP tool gets data rather than scraping the padded human report, which would mis-parse
	// silently the day a phase name outgrows its column.
	export var resultJson as String

	export var targetSpec as String

	export var includeNetwork as bool

	export var listOnly as bool

	export var jsonReport as bool

	// True by default; the field names what it controls rather than the flag.
	export var showTiming as bool

	// `auto` asks the host through `__Builtins.stdoutWantsAnsiColor()`.
	export var colorMode as ReportColorMode

	export var isolate as bool

	export var bail as BailPolicy

	export var testTimeoutMs as DurationMs

	// Whether `--log=` was accepted: `quietTheBuildChatter` must not silence a caller who asked for
	// the chatter. A bool, because `parseLogOption` already applied the spec.
	export var logOverridden as bool

	// Every `-`-leading argument, whichever arm consumes it and wherever it sat. `badOption` holds
	// only those no arm understood, so it never sees a flag this driver implements, and `maxon
	// --emit-ir fmt` would format the current directory in place. A command-gated arm cannot replace
	// this: the parser is order-independent, so a flag may precede the command word.
	//
	// Every arrival is kept so a command taking one option can ask for any option other than its own
	// (`firstOptionOtherThan`).
	export var optionsSeen as SourcePathSpellingArray

	// Set when an argument could not be understood: `main` refuses to run on a partly parsed command
	// line.
	export var badOption as String

	export var dryRun as bool

	export var devMode as bool

	// An option this driver deliberately withdrew. Separate from `badOption` because the two owe the
	// reader different sentences; see `withdrawnOptionMessage`.
	export var withdrawnOption as String

	// The defaults live here rather than in `parse`'s locals: `parse` accumulates into a record (see
	// its note), and a default at the declaration is one no arm can forget. Every field is `var` for
	// `parse`; nothing else can mutate a `MaxonArgs` through the `let` binding `main` holds (E3063).
	export static function create() returns MaxonArgs
		return Self{command: MaxonCommand.unknown, paths: SourcePathSpellingArray.create(), outputOverride: "", emitIr: false, asyncTrace: false, debugStream: false, debugInfo: true, coverage: false, runtimeIrNames: RuntimeFunctionNameArray.create(), filter: "", updateRequired: false, workers: defaultWorkerCount(), workersOverridden: false, workerPersistent: false, metricsPath: "", defines: DefineArray.create(), emitCorpus: "", rungs: DefaultRungCount, repeat: DefaultRepeatCount, note: "", resultJson: "", targetSpec: "", includeNetwork: false, listOnly: false, jsonReport: false, showTiming: true, colorMode: ReportColorMode.auto, isolate: false, bail: BailPolicy.never, testTimeoutMs: DefaultTestTimeoutMs, logOverridden: false, optionsSeen: SourcePathSpellingArray.create(), badOption: "", dryRun: false, devMode: false, withdrawnOption: ""}
	end 'create'

	// A command that takes no options refuses by this.
	export function anyOption() returns String
		return try self.optionsSeen.get(0) otherwise ""
	end 'anyOption'

	// A command that takes exactly one option refuses by this (`upgrade`, `mcp-server`); both are
	// exempt from `main`'s `badOption` gate because their own flag trips it.
	export function firstOptionOtherThan(allowed String) returns String
		for option in self.optionsSeen 'each'
			if option != allowed 'notMine'
				return option
			end 'notMine'
		end 'each'

		return ""
	end 'firstOptionOtherThan'

	// A second positional never reaches this: its callers call `refusedPositionalBeyond` first, so
	// empty means only absent.
	export function solePositional() returns String
		return try self.paths.get(0) otherwise ""
	end 'solePositional'

	// argv[0] is the executable path. The first command word selects the command and a later one is a
	// positional (see `laterCommandWordIsAPath`). An unrecognized `-`-leading argument is recorded as
	// a bad option, never absorbed as a positional: `spec-test --mm-trace` must not look for a spec
	// directory named `--mm-trace`.
	export static function parse() returns MaxonArgs
		// The working set is one record, not a `var` per flag: a `var` assigned in one arm becomes a phi
		// on the loop header, and one register per flag exceeds x64's GPRs (E5001) — a refusal, not a
		// slowdown. A field store keeps the loop carrying one value, so adding a flag means adding a
		// field, never a local. arm64's larger register pool hides this; `specs/register-pressure.md`'s
		// `assigned-only-loop-carried-vars-overflow` pins the x64 shape.
		var parsed = Self.create()

		let args = CommandLine.args()
		var i = 1

		while i < args.count() 'each'
			let arg = try args.get(i) otherwise panic("MaxonArgs.parse: index {i} >= args.count() despite the while guard i<args.count()")

			// Recorded before the chain, so it sees a flag whichever arm consumes it. See `anyOption`.
			if arg.startsWith(OptionPrefix) 'anOption'
				parsed.optionsSeen.push(arg)
			end 'anOption'

			// A `.maxon` first argument is `run`: a kernel execs the interpreter for a `#!/usr/bin/env
			// maxon` script with the script's path first. The tail keeps the file, so both doors hand
			// `runRun` the program at position 0. Position 1 only, and no command word ends in that
			// extension, so this cannot swallow a word the chain owns.
			if i == 1 and parsed.command == MaxonCommand.unknown and arg.endsWith(MaxonSourceExtension) 'wordlessRun'
				parsed.command = MaxonCommand.run
				parsed.paths = monitorTail(args, from: i)
				break
			end 'wordlessRun'

			// Tail-stopping: the arms below are order-independent, so a child's `--filter=mm` would become
			// `spec-test`'s selection and an unimplemented flag would abort the run before the child is
			// spawned. Only the first command word is the command, so a later `monitor` is an ordinary path.
			if arg == MonitorCommandName and parsed.command == MaxonCommand.unknown 'monitorCmd'
				parsed.command = MaxonCommand.monitor
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'monitorCmd'

			if arg == DebugCommandName and parsed.command == MaxonCommand.unknown 'debugCmd'
				parsed.command = MaxonCommand.debug
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'debugCmd'

			if arg == CoverageCommandName and parsed.command == MaxonCommand.unknown 'coverageCmd'
				parsed.command = MaxonCommand.coverage
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'coverageCmd'

			if arg == ProfileCommandName and parsed.command == MaxonCommand.unknown 'profileCmd'
				parsed.command = MaxonCommand.profile
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'profileCmd'

			if arg == RunCommandName and parsed.command == MaxonCommand.unknown 'runCmd'
				parsed.command = MaxonCommand.run
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'runCmd'

			// Cleared, not merely remembered, so an arm re-selecting the same command is detectable: `maxon
			// fmt fmt` would otherwise read as no change. Nothing between here and the restore reads the
			// field.
			let commandBefore = parsed.command
			parsed.command = MaxonCommand.unknown

			// `commandFromWord` reads the reference's own table, so there is no second roster here. The
			// tail-stopping words reach this arm only once a command is chosen, so a later one becomes a
			// path through the restore below.
			let named = commandFromWord(arg)

			if named != MaxonCommand.unknown 'commandWord'
				parsed.command = named
			end 'commandWord' else if arg == OutputFlagName 'dashOutput'
				i = i + 1
				parsed.outputOverride = try args.get(i) otherwise ""
			end 'dashOutput' else if arg.startsWith(OutputFlagPrefix) 'longOutput'
				parsed.outputOverride = try CommandLine.optionValue(arg) otherwise ""
			end 'longOutput' else if arg == EmitIrFlag 'emitIrFlag'
				parsed.emitIr = true
			end 'emitIrFlag' else if arg == AsyncTraceFlag 'asyncTraceFlag'
				parsed.asyncTrace = true
			end 'asyncTraceFlag' else if arg == DebugStreamFlag 'debugStreamFlag'
				parsed.debugStream = true
			end 'debugStreamFlag' else if arg == NoDebugInfoFlag 'noDebugInfoFlag'
				parsed.debugInfo = false
			end 'noDebugInfoFlag' else if arg == CoverageFlag 'coverageFlag'
				parsed.coverage = true
			end 'coverageFlag' else if arg.startsWith(EmitIrRuntimeFlagPrefix) 'emitIrRuntimeFlag'
				// Not swallowed by `--emit-ir`'s arm, which tests `==`.
				//
				// Checked on the parsed names, not the raw value: `--emit-ir-runtime=,` carries a non-empty
				// value naming no function, and an empty list would render a sidecar with no runtime body under
				// a command line that asked for one. Every such spelling is a bad option.
				let named = splitRuntimeNames(try CommandLine.optionValue(arg) otherwise "")

				if named.count() == 0 'noRuntimeNames'
					parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'noRuntimeNames' else 'hasRuntimeNames'
					parsed.runtimeIrNames = named

					// A list of functions to print is a request for the printing; otherwise the flag would be
					// inert whenever `--emit-ir` was forgotten.
					parsed.emitIr = true
				end 'hasRuntimeNames'
			end 'emitIrRuntimeFlag' else if arg.startsWith(FilterFlagPrefix) 'filterFlag'
				parsed.filter = try CommandLine.optionValue(arg) otherwise ""
			end 'filterFlag' else if arg == UpdateRequiredFlag 'updateRequiredFlag'
				parsed.updateRequired = true
			end 'updateRequiredFlag' else if arg == NetworkFlag 'networkFlag'
				parsed.includeNetwork = true
			end 'networkFlag' else if arg.startsWith(WorkersFlagPrefix) 'workersFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""

				// Recorded whatever the value parses to; see `workersOverridden`.
				parsed.workersOverridden = true

				// A bad value is a bad option, not a clamp: `--workers=0` asks for a pool that runs nothing,
				// and running the default would answer a different question. See `parseWorkerCount`.
				match parseWorkerCount(raw) 'workersArg'
					valid(count) then parsed.workers = count
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'workersArg'
			end 'workersFlag' else if arg == WorkerPersistentFlag 'workerPersistentFlag'
				parsed.workerPersistent = true
			end 'workerPersistentFlag' else if arg.startsWith(WithdrawnCompilerFlagPrefix) 'withdrawnCompilerFlag'
				// Recorded as withdrawn; see `withdrawnOptionMessage`. Matched without its `=`, so
				// `--compiler`, `--compiler=` and `--compiler=<path>` all get the sentence. Must precede the
				// anonymous `-`-leading arm, which would swallow it into `badOption`.
				parsed.withdrawnOption = firstBadOption(parsed.withdrawnOption, arg: arg)
			end 'withdrawnCompilerFlag' else if arg.startsWith(MetricsFlagPrefix) 'metricsFlag'
				parsed.metricsPath = try CommandLine.optionValue(arg) otherwise ""
			end 'metricsFlag' else if arg.startsWith(DefineFlagPrefix) 'defineFlag'
				let pair = try CommandLine.optionValue(arg) otherwise ""

				if let define = try defineFromPair(pair) 'nameAndValue'
					parsed.defines.push(define)
				end 'nameAndValue' else 'noValueGiven'
					parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'noValueGiven'
			end 'defineFlag' else if arg.startsWith(EmitCorpusFlagPrefix) 'emitCorpusFlag'
				parsed.emitCorpus = try CommandLine.optionValue(arg) otherwise ""
			end 'emitCorpusFlag' else if arg.startsWith(RungsFlagPrefix) 'rungsFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""

				// A bad value is a bad option, not a clamp: each rung doubles the program, and quietly climbing
				// a different ladder answers a question nobody asked. See `ScaleCorpus.parseRungCount`.
				match parseRungCount(raw) 'rungsArg'
					valid(count) then parsed.rungs = count
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'rungsArg'
			end 'rungsFlag' else if arg.startsWith(RepeatFlagPrefix) 'repeatFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""

				// A bad value is a bad option, as for `--rungs`. See `ScaleTestRunner.parseRepeatCount`.
				match parseRepeatCount(raw) 'repeatArg'
					valid(count) then parsed.repeat = count
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'repeatArg'
			end 'repeatFlag' else if arg.startsWith(NoteFlagPrefix) 'noteFlag'
				parsed.note = try CommandLine.optionValue(arg) otherwise ""
			end 'noteFlag' else if arg.startsWith(ResultJsonFlagPrefix) 'resultJsonFlag'
				parsed.resultJson = try CommandLine.optionValue(arg) otherwise ""
			end 'resultJsonFlag' else if arg.startsWith(TargetFlagPrefix) 'targetFlag'
				parsed.targetSpec = try CommandLine.optionValue(arg) otherwise ""
			end 'targetFlag' else if arg == TestListFlag 'listFlag'
				parsed.listOnly = true
			end 'listFlag' else if arg == TestJsonFlag 'jsonFlag'
				parsed.jsonReport = true
			end 'jsonFlag' else if arg == TestNoTimingFlag 'noTimingFlag'
				parsed.showTiming = false
			end 'noTimingFlag' else if arg == TestIsolateFlag 'isolateFlag'
				parsed.isolate = true
			end 'isolateFlag' else if arg == TestBailFlag 'bailFlag'
				parsed.bail = BailPolicy.after(DefaultBailAfter)
			end 'bailFlag' else if arg.startsWith(TestBailFlagPrefix) 'bailCountFlag'
				// A bad value is a bad option, as for `--workers`.
				match parsePositiveFlagValue(try CommandLine.optionValue(arg) otherwise "") 'bailArg'
					valid(failures) then parsed.bail = BailPolicy.after(failures as ReportedTestCount)
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'bailArg'
			end 'bailCountFlag' else if arg.startsWith(TestTimeoutFlagPrefix) 'timeoutFlag'
				match parsePositiveFlagValue(try CommandLine.optionValue(arg) otherwise "") 'timeoutArg'
					valid(ms) then parsed.testTimeoutMs = ms as DurationMs
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'timeoutArg'
			end 'timeoutFlag' else if arg.startsWith(TestColorFlagPrefix) 'colorFlag'
				match parseReportColorMode(try CommandLine.optionValue(arg) otherwise "") 'colorArg'
					valid(mode) then parsed.colorMode = mode
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'colorArg'
			end 'colorFlag' else if arg.startsWith(TestFilterShortPrefix) 'shortFilterWithValue'
				parsed.filter = try CommandLine.optionValue(arg) otherwise ""
			end 'shortFilterWithValue' else if arg == TestFilterShortFlag 'shortFilterSeparated'
				// A `-t` with nothing after it is refused: a filter naming no pattern would select everything.
				i = i + 1
				parsed.filter = try args.get(i) otherwise ""

				if parsed.filter.isEmpty() 'namesNoPattern'
					parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'namesNoPattern'
			end 'shortFilterSeparated' else if arg.startsWith("--log=") 'logFlag'
				let spec = try CommandLine.optionValue(arg) otherwise ""

				if not parseLogOption(spec) 'badSpec'
					printError("Unrecognized --log spec '{spec}' (expected <level> or <category>:<level>)\n")
				end 'badSpec' else 'goodSpec'
					// Recorded so `quietTheBuildChatter` leaves a caller's requested logging alone.
					parsed.logOverridden = true
				end 'goodSpec'
			end 'logFlag' else if arg == DryRunFlag 'dryRunFlag'
				parsed.dryRun = true

				// Also a bad option: only `upgrade` has a dry run, and `main` exempts it. Another command
				// taking the flag would do for real what the caller asked to see first.
				parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
			end 'dryRunFlag' else if arg == DevFlag 'devFlag'
				parsed.devMode = true

				// Also a bad option, as `--dry-run` is: only `mcp-server` has a contributor mode.
				parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
			end 'devFlag' else if arg == WithdrawnVersionFlag or arg == WithdrawnVersionFlagShort 'withdrawnVersionFlag'
				// Recorded as withdrawn and matched exactly: a longer spelling names no option this driver had
				// and is an ordinary typo.
				parsed.withdrawnOption = firstBadOption(parsed.withdrawnOption, arg: arg)
			end 'withdrawnVersionFlag' else if arg == WithdrawnHelpFlag or arg == WithdrawnHelpFlagShort 'withdrawnHelpFlag'
				// Recorded as withdrawn, matched exactly as the version spellings are.
				parsed.withdrawnOption = firstBadOption(parsed.withdrawnOption, arg: arg)
			end 'withdrawnHelpFlag' else if arg.startsWith(OptionPrefix) 'unknownFlag'
				parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
			end 'unknownFlag' else 'positional'
				// Kept: which positionals a command uses is the command's question, unanswerable before its
				// arity is known.
				parsed.paths.push(arg)
			end 'positional'

			// Only the first command word is the command; a later one is a path. The arms are
			// order-independent, which suits flags and is destructive for words: `maxon fmt fmt` in a tree
			// holding `fmt/` would set the command twice, leave `paths` empty and rewrite the whole working
			// directory. The bootstrap dispatches on `args[0]`, so its `fmt fmt` formats only `fmt/`;
			// restoring the earlier command and filing the word as a positional makes this parser answer the
			// same.
			if parsed.command == MaxonCommand.unknown 'noCommandWordHere'
				parsed.command = commandBefore
			end 'noCommandWordHere' else if commandBefore != MaxonCommand.unknown 'laterCommandWordIsAPath'
				parsed.command = commandBefore
				parsed.paths.push(arg)
			end 'laterCommandWordIsAPath'

			i = i + 1
		end 'each'

		return parsed
	end 'parse'
end 'MaxonArgs'

typealias CommandLineIndex = int(0 to u32.max)

// No arm of the parser consumes the child's command line and nothing rewrites it. A function rather
// than a loop in `parse`, whose loop is register-bound (see its note).
function monitorTail(args StringArray, from CommandLineIndex) returns SourcePathSpellingArray
	var tail = SourcePathSpellingArray.create()

	for position in from upto args.count() 'eachTailArgument'
		tail.push(try args.get(position) otherwise panic("monitorTail: index {position} is past args.count() despite the upto bound"))
	end 'eachTailArgument'

	return tail
end 'monitorTail'

function splitRuntimeNames(value String) returns RuntimeFunctionNameArray
	var names = RuntimeFunctionNameArray.create()

	for part in value.split(RuntimeNameSeparator) 'eachName'
		let trimmed = part.trim()

		if not trimmed.isEmpty() 'nonEmpty'
			names.push(trimmed)
		end 'nonEmpty'
	end 'eachName'

	return names
end 'splitRuntimeNames'
