// maxon compiler entry point (M1 driver).
//
// Parses the command line, dispatches a command, and maps the driver's
// CompileError outcomes to an exit code. `build` reads the input file/directory,
// runs the pipeline, and writes an executable. `verify-warm-rebuild` is the M2
// warm-rebuild gate: it asserts the query spine is deterministic + incremental for
// a file and exits 0 iff both properties hold. Diagnostics (E3001/E3002) are
// printed by `compile`/`compileToCodeResult`; Main stays silent on the
// `compileError` arm so a failing build's stderr is EXACTLY the reported
// diagnostics (the `maxoncstderr` spec contract).
//
// CLI (documented):
//   maxon build <file|directory>... [-o <output>] [--emit-ir] [--emit-ir-runtime=<name>,…] [--target=<cpu>-<os>]
//   maxon verify-warm-rebuild <file>
//   maxon lsp-server
//   maxon spec-test [dir] [--filter=<pattern>] [--update-required] [--network] [--workers=<n>] [--target=<cpu>-<os>]
//   maxon help [<command>]

// The column a reference entry's prose starts in, and how wide the whole line may be. Nothing in the
// reference is padded or broken by hand: `printWrappedProse` lays every row out from these two numbers
// and the indent it is given, so a label that outgrows its column moves its own prose down a line
// instead of going ragged, and a paragraph at the left margin gets the full width rather than an
// entry's narrower measure.
let UsageEntryColumnWidth = 32 as ColumnWidth
let UsageLineWidth = 100

// The default spec directory `spec-test` scans when no directory is given
// (resolved against the process cwd — the runner is invoked from the repo root).
let DefaultSpecDir = "specs"

// ⭐ **THE EXIT CODE THAT MEANS "NOTHING RAN".** Distinct from 1 (a command that RAN and reported
// failures) and from 101 (a leak) on purpose: "nothing ran" and "something failed" are different
// facts, and a caller reading only the exit code — a shell script, CI, the rung gate battery — must be
// able to tell them apart. Same number and same meaning as `cross-target-gate.sh`'s own refusal.
//
// TWO refusals return it, and they belong to one family: a binary older than the sources it was built
// from (`refuseIfStale`) and a checkout another command is already writing (`acquireTreeLock`). Both
// say the same thing to the reader — the tree is not in a state to be measured, fix that and re-run —
// so the number is declared once, HERE, where the driver's exit codes are decided.
module let NothingRanExitCode = 2

// The CLI spellings a spec-test command line is RE-EMITTED from, because two things relaunch this
// driver with one: a pool worker is this same executable (`SpecWorkerPool.spawnNoWait`), and a Linux
// suite is handed to a compiler inside the OrbStack machine (`SpecTestRunner.spawnGuestSuite`). Named
// here — where the parser that reads them back also lives — so the two halves of such a command line
// cannot drift apart into a hang. The rest of the driver's flags are matched inline: they are read here
// and nowhere else.
module let SpecTestCommandName = "spec-test"

// The CLI spellings a `build` command line is RE-EMITTED from, for the same reason and read back by the
// same parser: two callers spawn a compiler with one — the delegated Linux lane's per-target compiler
// (`SpecTestRunner.buildGuestCompiler`) and the scale-test ladder (`ScaleTestRunner.compileRung`).
module let BuildSubcommandName = "build"

// The remaining command words. Every one is a constant rather than a literal because TWO readers spell
// each: `MaxonArgs.parse` matches it, and the reference `maxon help` prints it. A word written down twice
// is a word that can be renamed in one place and go on being documented under the other.
let VerifyWarmRebuildCommandName = "verify-warm-rebuild"
let VerifyRecheckCommandName = "verify-recheck"
let LspServerCommandName = "lsp-server"
let ScaleTestCommandName = "scale-test"

module let OutputFlagName = "-o"

let OutputFlagPrefix = "--output="

// ⭐ **`fmt` TAKES NO OPTIONS AT ALL, AND THAT IS ENFORCED IN THE PARSER**, not left to the command:
// silently DROPPING an unrecognized flag is the most destructive thing this command could do -
// `maxon fmt --check` would find no path, fall back to the current directory and rewrite the whole tree
// in place, the exact opposite of what the flag asked for. `MaxonArgs.parse` therefore records ANY
// `-`-leading argument typed after this word as a bad option, including flags other commands implement.
let FmtCommandName = "fmt"

// ⚠ **`fmt`'s REFUSALS ARE ITS OWN SENTENCES, NOT the driver's `Usage:` line.**
// `tests/fmt/fixtures/flag-refused`, `flag-refused-no-path` and `two-paths-refused` pin these bytes, so a
// "better" wording here reddens that corpus rather than improving anything.
let FmtUsageLine = "usage: maxon fmt [<file|directory>]   (formats in place; no options)"

// ⭐⭐ **THE ONE COMMAND WHOSE TAIL IS NOT THIS DRIVER'S.** `monitor <exe> [args...]` hands everything
// after the executable to the CHILD, so `parse` stops at this word and files the rest verbatim. Named
// beside `fmt`'s for the same reason: a command word that decides how the REST of the line is read is not
// an inline literal.
let MonitorCommandName = "monitor"

// ⭐ `debug` — READ THE `.mxdbg` SIDECAR BACK. Like `monitor`, its tail is not this driver's: its
// subcommands are spelled `--dump-info` / `--symbolize`, which every other arm of the parser would read
// as options this driver does not implement and abort the run over. So the parse stops at this word and
// files the rest verbatim, exactly as it does for `monitor`.
let DebugCommandName = "debug"

// ⭐ `coverage` — RUN A `--coverage` BINARY AND REPORT WHAT IT EXECUTED. Tail-stopping for `monitor`'s
// reason and then some: everything after the verb is the CHILD's command line, so a target's own flag
// must not be consumed on its way past nor abort the run before the child is ever spawned.
let CoverageCommandName = "coverage"

// ⭐ `profile` — LAUNCH A PROGRAM AND SAMPLE WHERE ITS CPU TIME GOES. Tail-stopping for `coverage`'s reason
// in its strongest form: `profile run <exe> <the target's own flags>` forwards everything after the
// executable to a CHILD, so a flag this driver happens to implement must not be consumed on its way past
// and one it does not must not abort the run before the child is ever spawned.
let ProfileCommandName = "profile"

module let WorkerPersistentFlag = "--worker-persistent"

// Read by the parser and written by `specSelectionArgv`, both in this file, so neither leaves it.
let FilterFlagPrefix = "--filter="

// `module` because two of the suite's trailers name this flag as the remedy they are sending a reader to
// (`SpecTestRunner.reportGoldenDrift`, `reportUnrunHere`), and a flag spelled again in a message is a flag
// that can be renamed here while the messages go on naming the old one.
module let UpdateRequiredFlag = "--update-required"

// ⭐ `--network` — RUN THE CASES THAT REACH A REAL EXTERNAL HOST. The cases marked `<!-- network: live -->`
// across `tcp-client`, `async-tcp` and `http-client` open a socket to `tcpbin.com` / `httpbin.org`; a default
// run leaves them out, because a suite whose verdict turns on somebody else's uptime is not a claim about this
// compiler. The cases stay ACTIVE and PARSED — the marker sits on the CASE, never shelved as
// `disabled-test:` — and this flag selects them (see `SpecTestRunner.networkModeAllows`), which is why
// EXCLUDING them is announced rather than silent (`reportExclusions`).
//
// ⛔ **NO NUMBER IS WRITTEN HERE, DELIBERATELY.** "Seven" stood in six places in this harness while the
// corpus held EIGHT — transcribed from v1's hard-coded roster by the very comment arguing such a roster rots
// (`SpecParser.NetworkMarker`). The marker is the census; a count beside it is a second one.
//
// It is in the re-emitted set because the parent forwards it to every worker: both halves of the pool run
// the same selection rule, and a worker that never heard the flag would answer for tests nobody counted.
module let NetworkFlag = "--network"

// ⛔⛔ **`--compiler=<path>` IS WITHDRAWN, AND THE SPELLING IS KEPT SO THE REFUSAL CAN NAME IT.**
//
// It named a DIFFERENT BINARY to build each selected test with, which was a real and separate fact
// from "the executable a worker process is" for exactly as long as a test was built by a SUBPROCESS.
// `spec-test` now compiles every case IN THIS PROCESS (G20), so the compiler under test is this
// binary's own code and there is nothing a path could select. ⚖ **USER RULING 2026-08-22: in-process
// only, no dual path** — a flag kept as a no-op would be a command line that reads as though it chose
// something.
//
// ⚠ **IT IS REFUSED BY NAME, NOT LEFT TO THE ANONYMOUS `badOption` PATH.** A script still passing it
// was RIGHT to, until this rung; "unknown option: --compiler=…" would tell its author that the driver
// never heard of it, which is false and sends them looking for a typo. See `withdrawnOptionMessage`.
let WithdrawnCompilerFlagPrefix = "--compiler"

// `--target=` is in this re-emitted set (not with `build`'s options) because a cross-target
// spec run forwards it to every worker's command line — see SpecWorkerPool.spawnNoWait. The
// parser below reads it back through this same constant, so the two halves cannot drift.
module let TargetFlagPrefix = "--target="

// `module` because the guest delegation forwards a pool size the caller TYPED
// (`SpecTestRunner.spawnGuestSuite`), and a flag emitted under a spelling this parser does not read
// back is a flag that is silently refused.
module let WorkersFlagPrefix = "--workers="

// ⭐ **WHICH DIRECTORY, WHICH CASES — the selection half of a `spec-test` command line, emitted ONCE.**
//
// Two re-emitters read it: a pool worker is this executable relaunched
// (`SpecWorkerPool.spawnNoWait`), and a Linux suite is delegated to a compiler inside the OrbStack
// machine (`SpecTestRunner.spawnGuestSuite`). Both must answer for exactly the set the parent planned
// for, and a selection spelled twice is two halves of one run free to select differently.
//
// The spec directory is the RESOLVED one, never the default the far side would otherwise re-derive
// from its own working directory: which directory this run is about has already been decided, and a
// second decision could differ. `--filter` and `--network` change WHICH cases are selected, so a reader
// that never heard them answers with records nobody asked for; `--update-required` changes what the run
// WRITES. Each is emitted only when it is set, so a default run's command line carries the directory
// and nothing else.
module function specSelectionArgv(specDir FilePath, filter String, updateRequired bool, includeNetwork bool) returns StringArray
	var argv = StringArray.create()
	argv.push(specDir.toString())

	if not filter.isEmpty() 'hasFilter'
		argv.push("{FilterFlagPrefix}{filter}")
	end 'hasFilter'

	if updateRequired 'isUpdate'
		argv.push(UpdateRequiredFlag)
	end 'isUpdate'

	if includeNetwork 'wantsLiveNetwork'
		argv.push(NetworkFlag)
	end 'wantsLiveNetwork'

	return argv
end 'specSelectionArgv'

// ⭐ **`test`'S OWN FLAGS.** They are matched here with every other flag rather than parsed by the
// command, because `MaxonArgs.parse` is the ONE reader of this driver's command line — a second parser
// would be a second place for a flag to be understood, and a flag understood in one of them is silently
// swallowed by the other. Each sets a FIELD; see `MaxonArgs.parse`'s note on why never a local.
let TestListFlag = "--list"
let TestJsonFlag = "--json"
let TestNoTimingFlag = "--no-timing"
let TestIsolateFlag = "--isolate"
let TestBailFlag = "--bail"
let TestBailFlagPrefix = "--bail="
let TestTimeoutFlagPrefix = "--timeout="
let TestColorFlagPrefix = "--color="

// The short filter, in both spellings a shell user reaches for. `-t=P` carries its value; `-t P` is the
// separated form, which is what a pattern containing spaces needs.
let TestFilterShortFlag = "-t"
let TestFilterShortPrefix = "-t="

// Failures allowed before the run stops CLAIMING work, when `--bail` is given with no count.
let DefaultBailAfter = 1

// ⭐ **THE TWO IR-SIDECAR SPELLINGS.** ⛔ They used to be EXPORTED *"because the spec runner emits
// them on the command line it spawns each fragment build with"* — and it does not: since G20 the spec
// runner passes `emitIr` and `runtimeIrNames` as ARGUMENTS to `Compiler.compileToProduct`, so these
// two are read here and nowhere else, exactly like the rest of `build`'s options.
//
// `--emit-ir` writes the lowered Target IR beside the exe. `--emit-ir-runtime=<name>,<name>` says
// which WITHHELD functions that IR must ALSO render: a golden fragment otherwise shows only the
// functions parsed from the PROGRAM's own source, so `mrt_start`, the allocator and the
// `__str_*`/`__managed_*` families carry no golden at all — and neither does a `stdlib/` body such as
// `String.trim`, which the compiler compiles into the same module and this withholds for the same reason (see
// `TargetPrinter.printTargetModule`). Naming them is per-BUILD and
// opt-in, so every fragment that does not ask is byte-for-byte what it was before the flag existed.
let EmitIrFlag = "--emit-ir"

// `--async-trace` — emit the green-thread trace (`spawn #`, `io_yield #`, `io_resume #`, `await #`) to stderr.
// The spec harness asks for the same thing per case, for an `<!-- AsyncTrace -->` fragment, but it asks
// `Compiler.compileToProduct` directly (G20) rather than by spelling this flag. Opt-in and per-BUILD, so a
// program that does not ask is byte-for-byte what it was before the flag existed — the trace CALLS are not
// emitted at all rather than being branched over at run time (see `GtRuntime.GtTraceEmitName`).
let AsyncTraceFlag = "--async-trace"

// ⭐ `--debugstream` — emit the DebugStream PRODUCER: the shared-memory ring `maxon monitor` decodes,
// plus the mm_alloc / mm_incref / mm_decref / mm_free events the memory manager writes into it. The spec
// harness asks for it per case, for an mm-trace fragment, through `Compiler.compileToProduct` — exactly as
// it asks for `--async-trace`'s producer.
//
// ⚠⚠ **OPT-IN AND PER-BUILD, AND THAT IS A CORRECTNESS PROPERTY RATHER THAN A COURTESY.** With the flag
// off NOT ONE instruction of this changes: the box header does not grow, `__mm_alloc`'s arity does not
// change, no event site is branched over. Thousands of committed `.test` fragment goldens depend on it.
// See `DebugStreamRuntime`'s header for the two-level gating rule this is the compile-time half of.
let DebugStreamFlag = "--debugstream"

// ⭐⭐ `--no-debug-info` — DON'T write the `<output>.mxdbg` sidecar. An OPT-OUT, because the default is
// ON: a binary built without debug info is one nobody can debug after the fact, and a user who never
// heard of the flag would have every one of them.
//
// ⚠ **THE SIDECAR IS METADATA AND THE EXECUTABLE IS BYTE-IDENTICAL EITHER WAY**, which is what makes an
// on-by-default safe — the binary a user debugs is the binary they shipped. That property is gated where
// it can be observed, in `tests/debug/byte-identical-debug-info.test.maxon`.
//
// ⚠ Only `build` acts on it. Every other command leaves the compiler's own default (off), so a spec-test
// or a `maxon test` compile pays nothing for a sidecar nothing would read.
module let NoDebugInfoFlag = "--no-debug-info"

// ⭐⭐ `--coverage` — INSTRUMENT FOR CODE COVERAGE: the binary counts each statement and branch arm it
// executes and writes the counters to `<output>.mxcov` on its way out. It CHANGES THE EMITTED CODE, so
// it is a separate build from the one you ship; `maxon coverage` reads what it produced.
//
// ⚠ **IT REQUIRES THE SIDECAR.** A counter is an anonymous index and what it counts lives in the
// `.mxdbg` coverage-point table, so `--no-debug-info` beside it is refused in `runBuild` rather than
// half-honoured. Spelled `module` because `Debug/CoverageCommand.maxon`'s banner names the flag its
// input was built with, and a flag renamed here must not leave that sentence naming the old one.
module let CoverageFlag = "--coverage"

// Why the pair above is refused, in the reference driver's own words — assembled from the flag names so
// a rename cannot leave the sentence naming a flag that no longer exists.
function coverageNeedsDebugInfoMessage() returns String
	return "{CoverageFlag} requires the debug-info sidecar: the counters it emits are anonymous without the sidecar's coverage-point table, so a {MxcovDataExtension} written by this binary could never be interpreted. Drop {NoDebugInfoFlag} (or debug_info:false in build.maxon), or drop {CoverageFlag}."
end 'coverageNeedsDebugInfoMessage'

let EmitIrRuntimeFlagPrefix = "--emit-ir-runtime="

// `--metrics=<path>`, exported because the SCALE runner spawns one build per rung with it
// (`ScaleTestRunner.compileRung`). ⛔ The spec runner used to spawn one per test as well, and read the
// `total` row back for its cumulative-CPU indicator; it now takes that number straight off
// `CompileProduct.totalCpuTicks` (G20), which is the same number from the same whole-compile probe
// without the file. It was written out as a literal at the parser below AND at the scale runner
// until a second harness would have made a third copy.
// What makes an argument an OPTION rather than a positional: one leading dash. Named because four
// readers ask it — `anyOption`'s unconditional record, the catch-all unknown-flag arm, `fmt`'s refusal
// through the first of those, and `runCoverage`'s own tail parse — and a fifth spelling would be the
// rule written down twice.
module let OptionPrefix = "-"

// ⭐ `maxon help [<command>]` — the whole reference, or one command's part of it. A COMMAND, because a
// caller with nothing to go on does not have to know it: `maxon` with no arguments lists every command
// there is, and this word is one of them.
let HelpCommandName = "help"

// ⛔⛔ **`--help` / `-h` ARE WITHDRAWN, AND THE SPELLINGS ARE KEPT SO THE REFUSAL CAN NAME THEM** — for
// the reason `--version` is withdrawn next door, and a reader owed the same sentence. These are the two
// spellings every other CLI has taught people to try first, so a caller typing one is following a
// convention rather than making a typo; "unknown option: --help" would tell them this driver has no help
// at all. See `withdrawnOptionMessage`.
let WithdrawnHelpFlag = "--help"
let WithdrawnHelpFlagShort = "-h"

// `maxon version` — which binary is this. A COMMAND, so the driver has one door onto the answer and a
// reader learns it from the same list every other thing this binary does is listed in.
let VersionCommandName = "version"

// ⛔⛔ **`--version` / `-V` ARE WITHDRAWN, AND THE SPELLINGS ARE KEPT SO THE REFUSAL CAN NAME THEM.**
// A flag spelling left beside `maxon version` would be a second door onto one answer, and the two would
// drift the day either grew a qualifier.
//
// ⚠ **REFUSED BY NAME, NOT LEFT TO THE ANONYMOUS `badOption` PATH.** These are the spellings a
// packager, a CI step and a bug-report template reach for first, so a reader who types one is following
// a convention rather than making a typo; "unknown option: --version" would tell them this driver never
// heard of it and send them hunting for one. See `withdrawnOptionMessage`.
let WithdrawnVersionFlag = "--version"
let WithdrawnVersionFlagShort = "-V"

module let MetricsFlagPrefix = "--metrics="

// `--define=<name>=<value>`: replace a top-level `String` constant's written-out default.
//
// ⚠ **THE VALUE MAY CONTAIN `=` AND THE NAME MAY NOT**, so the split is at the FIRST one. A version
// is rarely the case that needs it, but a description or a URL is, and a flag that mangled them would
// be found only by reading the emitted binary.
let DefineFlagPrefix = "--define="
let DefineNameValueSeparator = "="

// `scale-test`'s own flags. Constants for the reason the command words above are: the parser reads each
// one and the reference prints it, and two spellings of one flag drift the day either is renamed.
let RungsFlagPrefix = "--rungs="
let RepeatFlagPrefix = "--repeat="
let NoteFlagPrefix = "--note="
let ResultJsonFlagPrefix = "--result-json="
let EmitCorpusFlagPrefix = "--emit-corpus="

// Comma, matching every other list-valued flag and directive this project reads (`--target`s in a
// `<!-- unsupported-targets: … -->` marker, the reference's own `UnsupportedTargetsDirectiveRegex`). One separator, so a
// reader never has to ask which list is spelled which way.
let RuntimeNameSeparator = ","

// Everything after the FIRST `=` of a `<name>=<value>` pair already split on it — the pieces from 1
// onward, rejoined with the separator they were split at.
//
// ⚠ **REJOINING IS THE POINT, NOT A ROUND TRIP.** `--define=Url=https://x/?a=b` splits into four
// pieces, and only the first is the name; keeping piece 1 alone would silently truncate the value at
// its first `=`. Rejoining exactly the tail restores it, and a `String` index is a GRAPHEME cursor
// rather than an integer, so slicing at a byte offset is not the simpler alternative it looks like.
function defineValueAfterName(cut StringArray) returns String
	var value = ""
	for i in 1 upto cut.count() 'eachPiece'
		let piece = try cut.get(i) otherwise ""
		let separator = "" if i == 1 else DefineNameValueSeparator
		value = "{value}{separator}{piece}"
	end 'eachPiece'

	return value
end 'defineValueAfterName'

function main() returns ExitCode
	let args = MaxonArgs.parse()

	// ⭐ A WITHDRAWN OPTION IS REPORTED BEFORE AN UNKNOWN ONE, and the order is the point: this driver
	// once accepted it, so its author needs to be told WHAT REPLACED IT rather than sent looking for a
	// typo. `firstBadOption`'s "the first one typed wins" rule decides between two equally anonymous
	// flags and does not reach across that difference.
	if not args.withdrawnOption.isEmpty() 'withdrawnOption'
		printError("{withdrawnOptionMessage(args.withdrawnOption)}\n")
		printCommandList()
		return refusedCommandLineExit(args.command)
	end 'withdrawnOption'

	// An option the driver does not implement aborts BEFORE any command runs. Every
	// command below would otherwise proceed as though the flag had been honoured,
	// which is the one outcome a caller can neither see nor recover from.
	// ⚠ `fmt` is EXEMPT and refuses its own options inside `runFmt`, in the reference's words rather
	// than this driver's. See `FmtUsageLine`.
	if not args.badOption.isEmpty() and args.command != MaxonCommand.fmt 'badOption'
		printError("error: unknown option: {args.badOption}\n")
		printCommandList()
		return refusedCommandLineExit(args.command)
	end 'badOption'

	return match args.command 'cmd'
		build gives runBuild(args)
		coverage gives runCoverage(args)
		debug gives runDebugCommand(args)
		fmt gives runFmt(args)
		help gives runHelp(args)
		lspServer gives runLspServer()
		monitor gives runMonitor(args)
		profile gives runProfile(args)
		scaleTest gives runScaleTest(args)
		specTest gives runSpecTest(args)
		test gives runTest(args)
		verifyRecheck gives runVerifyRecheck(args)
		verifyWarmRebuild gives runVerifyWarmRebuild(args)
		version gives runVersion(args)
		unknown gives noCommandGiven(args)
	end 'cmd'
end 'main'

// The outcome of resolving a `--target=<cpu>-<os>` spelling: either the Target it
// names, or the raw spelling for the error message when it names no known target.
module union TargetResolution
	resolved(target Target)
	unrecognized(spec String)
end 'TargetResolution'

// Resolve a `--target` spelling to a Target, or report it unrecognized. The targets
// maxon can build for are listed once, and matched by their own `targetToString`
// spelling — so the parser and the printer read the same table and cannot drift into
// accepting a spelling the compiler cannot name back. A spec that names none of them
// is rejected; the list grows as backends land.
//
// EXPORTED because `GoldenCensus.reportUncomparedGoldens` asks the identical question of a
// `fragments/<name>` LANE DIRECTORY's name — a lane is named by a target spelling, so "which target is
// this?" has one answer and one reader. A private copy of the loop there would be a second table in all
// but name, and its failure mode is a census that quietly stops covering the next backend that lands.
module function parseBuildTarget(spec String) returns TargetResolution
	for candidate in supportedTargets() 'each'
		if targetToString(candidate) == spec 'match'
			return TargetResolution.resolved(candidate)
		end 'match'
	end 'each'
	return TargetResolution.unrecognized(spec)
end 'parseBuildTarget'

// ⭐ **EVERY TARGET THIS COMPILER CAN BUILD FOR — the one list.**
//
// It used to sit inline in the loop above, which was fine while the flag parser was the only thing that
// wanted it. `SpecVerdictSelfTest` wants it too — its whole subject is which lane this host routes each
// target to, and it must sweep ALL of them or it is a check scoped to whichever target its author
// happened to think of. A second array spelled there would agree today and would then quietly stop
// covering the next backend that lands, which is the one it would exist to catch.
module function supportedTargets() returns TargetArray
	return [Target.create(CpuArch.x64, os: Os.windows), Target.create(CpuArch.x64, os: Os.linux), Target.create(CpuArch.arm64, os: Os.macos), Target.create(CpuArch.arm64, os: Os.linux), Target.create(CpuArch.wasm32, os: Os.wasi)]
end 'supportedTargets'

// ⭐ **THE TARGET LIST AS PROSE, SPELLED FROM `supportedTargets()` RATHER THAN BY HAND.** Two messages
// each named a partial list and BOTH had already gone stale: the usage text omitted `arm64-linux`, and
// the unknown-target error omitted `arm64-linux` and `wasm32-wasi`. A list a reader is told is the set
// has to come from the set, or the next backend that lands is missing from both the moment it lands.
function supportedTargetList() returns String
	var out = ""
	for candidate in supportedTargets() 'each'
		if out.isEmpty() 'first'
			out = targetToString(candidate)
		end 'first' else 'rest'
			out = "{out}, {targetToString(candidate)}"
		end 'rest'
	end 'each'
	return out
end 'supportedTargetList'

// Resolve the optional `--target` flag shared by `build` and `spec-test`: the host target
// (`detectHostTarget`) when the flag is empty, otherwise whatever `parseBuildTarget` makes of the
// spelling (`unrecognized` when it names no known target). Folding the host default into one place
// keeps the two commands from drifting on what "no --target" means.
module function resolveTargetFlag(spec String) returns TargetResolution
	if spec.isEmpty() 'host'
		return TargetResolution.resolved(detectHostTarget())
	end 'host'
	return parseBuildTarget(spec)
end 'resolveTargetFlag'

// Report a `--target` spelling that names no known target, as an exit code the
// build command returns directly. Separate from the match arm because a match arm
// is one statement, and this one both prints and yields the code.
module function reportUnknownTarget(spec String) returns ExitCode
	printError("error: unknown --target '{spec}' (expected one of: {supportedTargetList()})\n")
	return 1
end 'reportUnknownTarget'

// ⭐⭐ **`build` TAKES A LIST, AND THE LIST'S ORDER IS PART OF WHAT IT SAYS (A3m).** Every positional is
// compiled, in the order given; `Compiler.loadSourceFiles` registers them in exactly that order and
// roots the project at their common ancestor. Before A3m the parser kept the FIRST positional and
// dropped the rest in silence — MEASURED, `build alias.maxon main.maxon` reported `E3001: No 'main'
// function found` and `build main.maxon alias.maxon` reported `E3011: Unknown type 'Int'`, each a
// The build script a directory may carry. See `runBuildManifest`.
let BuildManifestFileName = "build.maxon"

// Where the manifest's own executable is staged: inside `.maxon/`, which is already where this
// project's build products live and already ignored everywhere.
let ManifestOutputStem = ".maxon/build-manifest"

// ⭐ **THE MANIFEST'S ENTRY POINT IS `build`, NOT `main`.** A manifest is a set of TASKS a project can
// be asked to perform, not a program with one way in — `build` is simply the task this command asks
// for, and the name it is asked for by. `compileToProduct` takes the entry function as an argument
// precisely so a caller can name one, so nothing here is special-cased: the manifest is compiled the
// way any program is, beginning somewhere else.
let ManifestEntryFunction = b"build"

// The fields of `stdlib/Build.maxon`'s JSON that this reads back.
let ManifestNameKey = "name"
let ManifestOutputKey = "output"
let ManifestSourcesKey = "sources"
let ManifestVersionKey = "version"
let ManifestDefinesKey = "defines"

// ⭐⭐ **`maxon build` WITH NO PATH RUNS `build.maxon`, WHICH IS A MAXON PROGRAM AND NOT A CONFIG
// FILE.** That distinction is the whole design: a project's build is described by CODE, with the
// standard library available to it, so the paths it compiles can be COMPUTED — read out of a
// directory, chosen from the host, stamped from a version file — rather than only spelled out.
// Nothing here parses the manifest. The compiler COMPILES it, RUNS it, and reads what it prints.
//
// ⭐ **THE PROTOCOL IS `stdlib/Build.maxon`'s JSON, ON STDOUT.** `Build.build(source, output:)` and
// `Build.buildWithConfig(config)` write it; this reads it back. Both ends therefore share ONE
// description of what a build is, held in the stdlib where each can see it, and a field added there
// is a field both ends already agree on.
//
// ⚠ A directory with no `build.maxon` gets the usage line, because "build what?" is then a question
// nobody has answered.
// Which of a manifest's builds a command is about, and whether the manifest had one at all.
//
// ⛔ A NAME THAT IS NOT A TARGET IS NOT AN ERROR. `maxon build <x>` may equally mean "compile the path
// x", so a manifest declaring no `x` answers `noSuchTarget` and the caller falls back to path
// semantics — refusing here would make a manifest's presence break builds it was never part of.
union ManifestRun
	ran(code ExitCode)
	noSuchTarget
end 'ManifestRun'

// A manifest's builds. ONE may be written as a bare object and SEVERAL as a JSON array, because a
// single-target manifest should not have to say it is a list of one.
function manifestBuilds(doc JsonDoc) returns JsonNodeIdArray
	var builds = JsonNodeIdArray.create()
	let count = try doc.arrayLength(doc.root) otherwise 'notArray'
		builds.push(doc.root)
		return builds
	end 'notArray'

	for i in 0 upto count 'eachBuild'
		let id = try doc.arrayAt(doc.root, index: i) otherwise 'badElem'
			return builds
		end 'badElem'
		builds.push(id)
	end 'eachBuild'

	return builds
end 'manifestBuilds'

// A build's declared name, empty when it carries none. A lone build needs none: there is nothing to
// tell it apart from.
function manifestTargetName(doc JsonDoc, build JsonNodeId) returns String
	return try doc.getString(build, key: ManifestNameKey) otherwise ""
end 'manifestTargetName'

function runBuildManifest(args MaxonArgs, targetName String) returns ManifestRun
	let manifest = Directory.currentPath().join(BuildManifestFileName)
	if not File.exists(manifest) 'noManifest'
		if not targetName.isEmpty() 'nameWithoutManifest'
			return ManifestRun.noSuchTarget
		end 'nameWithoutManifest'

		printError("Usage: maxon build <file|directory|target>... [-o <output>] [--emit-ir] [--emit-ir-runtime=<name>,...] [--target=<cpu>-<os>]\n")
		printError("\n")
		printError("With no path, `maxon build` runs the {BuildManifestFileName} in the current directory. There is none here.\n")
		return ManifestRun.ran(1)
	end 'noManifest'

	// ⛔ THE MANIFEST IS BUILT FOR THIS HOST, WHATEVER `--target` SAYS. It is a program this machine
	// has to RUN in a moment, so a `--target=arm64-macos` build of it would produce something this host
	// cannot execute. The flag describes the program the manifest ASKS FOR, never the manifest.
	var manifestPaths = MaxonSourcePathArray.create()
	manifestPaths.push(manifest)

	let manifestProduct = try compileToProduct(manifestPaths, target: detectHostTarget(), outputOverride: ManifestOutputStem, runtimeIrNames: RuntimeFunctionNameArray.create(), debugInfo: false, entryFunction: ManifestEntryFunction) otherwise (e) 'manifestCompileErr'
		printError("error: {BuildManifestFileName} did not compile — the diagnostics above are its own\n")
		reportCompileError(e)
		return ManifestRun.ran(1)
	end 'manifestCompileErr'

	let run = try Subprocess.run(Executable.path(manifestProduct.outputPath), arguments: StringArray.create()) otherwise 'manifestRunErr'
		printError("error: {BuildManifestFileName} compiled but could not be run\n")
		return ManifestRun.ran(1)
	end 'manifestRunErr'

	if run.exitCode() != 0 'manifestFailed'
		printError("error: {BuildManifestFileName} exited {run.exitCode()} and described no build\n")
		if not run.stderr.isEmpty() 'hasStderr'
			printError("{run.stderr}\n")
		end 'hasStderr'
		return ManifestRun.ran(1)
	end 'manifestFailed'

	return buildFromManifestOutput(run.stdout, args: args, targetName: targetName)
end 'runBuildManifest'

// `-o` on the command line, or the manifest's `output` when none was typed. A function rather than a
// reassignment because a `String` binding is immutable and copying one to choose between two would be
// a clone of a value neither branch changes.
function chosenOutput(fromManifest String, fromFlag String) returns String
	if fromFlag.isEmpty() 'manifestDecides'
		return fromManifest
	end 'manifestDecides'

	return fromFlag
end 'chosenOutput'

// Read one `BuildConfig` off the manifest's stdout and compile what it names.
//
// ⚠ EVERY FIELD IS REQUIRED, AND A MISSING ONE IS AN ERROR RATHER THAN A DEFAULT QUIETLY SUPPLIED
// HERE. The writer is `Build.emitBuildConfig`, which always emits all of them; a document missing one
// did not come from it, and guessing what its author meant is how a build compiles the wrong thing
// while reporting success.
function buildFromManifestOutput(stdout String, args MaxonArgs, targetName String) returns ManifestRun
	let doc = try Json.parse(stdout) otherwise 'badJson'
		printError("error: {BuildManifestFileName} printed something that is not a build description.\n")
		printError("It must print what `Build.build(source, output:)` or `Build.buildWithConfig(config)` writes. It printed:\n")
		printError("{stdout}\n")
		return ManifestRun.ran(1)
	end 'badJson'

	let builds = manifestBuilds(doc)
	let buildCount = builds.count()

	// ⭐ ONE TARGET NEEDS NO NAME; SEVERAL ARE LISTED RATHER THAN GUESSED AT. Picking the first of
	// several would build something the caller did not ask for and report success for it.
	var chosen = doc.root
	if targetName.isEmpty() 'noNameGiven'
		if buildCount != 1 'severalTargets'
			printError("{BuildManifestFileName} declares {buildCount} targets. Name one:\n")
			for id in builds 'eachTargetName'
				printError("  {manifestTargetName(doc, build: id)}\n")
			end 'eachTargetName'
			return ManifestRun.ran(1)
		end 'severalTargets'

		chosen = try builds.get(0) otherwise panic("buildFromManifestOutput: builds.get OOB — buildCount is 1")
	end 'noNameGiven' else 'nameGiven'
		var found = false
		for id in builds 'findTarget'
			if manifestTargetName(doc, build: id) == targetName 'nameMatches'
				chosen = id
				found = true
			end 'nameMatches'
		end 'findTarget'

		if not found 'noSuchName'
			return ManifestRun.noSuchTarget
		end 'noSuchName'
	end 'nameGiven'

	let output = try doc.getString(chosen, key: ManifestOutputKey) otherwise 'noOutput'
		printError("error: {BuildManifestFileName}'s build description has no `{ManifestOutputKey}`\n")
		return ManifestRun.ran(1)
	end 'noOutput'

	let sourcesId = try doc.getChild(chosen, key: ManifestSourcesKey) otherwise 'noSources'
		printError("error: {BuildManifestFileName}'s build description has no `{ManifestSourcesKey}`\n")
		return ManifestRun.ran(1)
	end 'noSources'

	let count = try doc.arrayLength(sourcesId) otherwise 'sourcesNotArray'
		printError("error: {BuildManifestFileName}'s `{ManifestSourcesKey}` is not a list of paths\n")
		return ManifestRun.ran(1)
	end 'sourcesNotArray'

	// ⛔ AN EMPTY `sources` IS REFUSED, NOT READ AS "THIS DIRECTORY". Accepting it would compile the
	// whole tree the manifest sits in — every spec, every test — under a command that named nothing at
	// all. A manifest that means the current directory says so: `Build.build(".", output: …)`.
	if count == 0 'noPaths'
		printError("error: {BuildManifestFileName} named no sources to compile.\n")
		printError("Use `Build.buildWithConfig` with a non-empty `{ManifestSourcesKey}`.\n")
		return ManifestRun.ran(1)
	end 'noPaths'

	var inputPaths = MaxonSourcePathArray.create()
	for i in 0 upto count 'eachSource'
		let elemId = try doc.arrayAt(sourcesId, index: i) otherwise 'badElem'
			printError("error: {BuildManifestFileName}'s `{ManifestSourcesKey}` entry {i} could not be read\n")
			return ManifestRun.ran(1)
		end 'badElem'

		let spelling = doc.get(elemId).stringValue
		let path = try FilePath.from(spelling) otherwise 'badSourcePath'
			printError("error: {BuildManifestFileName} named an invalid source path: {spelling}\n")
			return ManifestRun.ran(1)
		end 'badSourcePath'
		inputPaths.push(path)
	end 'eachSource'

	// ⚠ `-o` ON THE COMMAND LINE OUTRANKS THE MANIFEST, for the reason every flag outranks a file: the
	// person typing the command is answering a narrower question than the file was.
	let outputOverride = chosenOutput(output, fromFlag: args.outputOverride)

	var target = detectHostTarget()
	match resolveTargetFlag(args.targetSpec) 'manifestTarget'
		resolved(t) then target = t
		unrecognized(spec) then return ManifestRun.ran(reportUnknownTarget(spec))
	end 'manifestTarget'

	// ⚠ AN ABSENT `version` IS NOT AN ERROR: a manifest written before the key existed must keep
	// building, so a missing one reads as "unversioned".
	//
	// ⛔ THE DESCRIPTION'S `name` IS NOT THE PRODUCT NAME. It is whatever selected this build — a target
	// name, or for `Build.build` the SOURCE path, which is `.` for a project built from its own
	// directory. The binary's product name comes from the OUTPUT, which is what the thing is called.
	let productVersion = try doc.getString(chosen, key: ManifestVersionKey) otherwise ""

	// ⭐ THE MANIFEST'S DEFINES COME FIRST AND THE COMMAND LINE'S FOLLOW, so a `--define` typed at the
	// prompt overrides one the manifest computed — the same precedence `-o` has over the manifest's
	// `output`, for the same reason. Resolution binds a name to one declaration and stamps it, and a
	// later stamp replaces an earlier one, so ORDER is what expresses that precedence.
	var defines = manifestDefines(doc, build: chosen)
	for supplied in args.defines 'eachCommandLineDefine'
		defines.push(supplied)
	end 'eachCommandLineDefine'

	let outputPath = try compile(inputPaths, target: target, outputOverride: outputOverride, emitIr: args.emitIr, metricsPath: args.metricsPath, runtimeIrNames: args.runtimeIrNames, asyncTrace: args.asyncTrace, debugStream: args.debugStream, debugInfo: args.debugInfo, coverage: args.coverage, productVersion: productVersion, defines: defines) otherwise (e) 'buildErr'
		reportCompileError(e)
		return ManifestRun.ran(1)
	end 'buildErr'

	print("Compiled -> {outputPath}\n")
	return ManifestRun.ran(0)
end 'buildFromManifestOutput'

// The `defines` a build description carries, as the compiler's own pairs.
//
// ⚠ **A MALFORMED ENTRY IS SKIPPED HERE AND REFUSED LATER.** An entry with no `=` names no value, and
// dropping it silently would be wrong — but the diagnostic that says so belongs to the resolution pass,
// which reports every define problem at once. What this must not do is invent a name from a string that
// does not contain one.
function manifestDefines(doc JsonDoc, build JsonNodeId) returns DefineArray
	var defines = DefineArray.create()
	let listId = try doc.getChild(build, key: ManifestDefinesKey) otherwise return defines
	let count = try doc.arrayLength(listId) otherwise return defines

	for i in 0 upto count 'eachDefine'
		let elemId = try doc.arrayAt(listId, index: i) otherwise continue
		let pair = doc.get(elemId).stringValue
		let cut = pair.split(DefineNameValueSeparator)
		if cut.count() < 2 'noValueGiven'
			continue
		end 'noValueGiven'

		let name = try cut.get(0) otherwise ""
		defines.push(Define.create(name, value: defineValueAfterName(cut)))
	end 'eachDefine'

	return defines
end 'manifestDefines'

// diagnostic about a program the caller never asked for.
function runBuild(args MaxonArgs) returns ExitCode
	if args.paths.count() == 0 'noPath'
		match runBuildManifest(args, targetName: "") 'bareBuild'
			ran(code) then return code
			noSuchTarget then panic("runBuild: the manifest was asked for no target and cannot answer noSuchTarget")
		end 'bareBuild'
	end 'noPath'

	// ⛔ A TARGET NAME OUTRANKS A PATH OF THE SAME SPELLING, and it has to: a target names an OUTPUT as
	// well as a source, so `maxon build maxon-bin` resolved as a path would compile the same directory
	// to a DIFFERENT file and quietly leave the real one stale. A spelling the manifest does not
	// declare falls through to the path meaning below, so a manifest never breaks an ordinary build.
	if args.paths.count() == 1 'maybeTargetName'
		let only = try args.paths.get(0) otherwise panic("runBuild: paths.get OOB — count is 1")
		match runBuildManifest(args, targetName: only) 'namedBuild'
			ran(code) then return code
			noSuchTarget then return runBuildPaths(args)
		end 'namedBuild'
	end 'maybeTargetName'

	return runBuildPaths(args)
end 'runBuild'

// Compile the positional paths — `build`'s meaning when no manifest target claimed them. Split out so
// the fallback above is a RETURN rather than a match arm that does nothing.
function runBuildPaths(args MaxonArgs) returns ExitCode
	var inputPaths = MaxonSourcePathArray.create()
	for spelling in args.paths 'eachPositional'
		let path = try FilePath.from(spelling) otherwise 'badPath'
			printError("error: invalid path: {spelling}\n")
			return 1
		end 'badPath'
		inputPaths.push(path)
	end 'eachPositional'

	var target = detectHostTarget()
	match resolveTargetFlag(args.targetSpec) 'targetSel'
		resolved(t) then target = t
		unrecognized(spec) then return reportUnknownTarget(spec)
	end 'targetSel'

	// ⛔ **REFUSED ON A TARGET WITH NO PRODUCER, RATHER THAN SILENTLY EMITTING NOTHING.** The whole failure
	// mode of an instrument is an EMPTY answer that reads as "the program did none of that", so this must be
	// said at the command line, loudly, before anything is compiled — and here rather than as a diagnostic,
	// because nothing in the PROGRAM asked for it and there is no span to hang it on. The Std ops' own
	// lowerings refuse too, but that is a backstop for a compiler bug that got past this gate.
	//
	// ⚠ **IT GUARDS THE COMMAND LINE AND ONLY THE COMMAND LINE.** The spec harness calls `compileToProduct`
	// directly with a per-case `debugStream` and carries its own gate for the same fact
	// (`SpecTestRunner.targetCanCaptureTrace`, which SKIPS such a case rather than compiling it). Both read
	// `targetCanProduceDebugStream`, so the two doors cannot come to disagree about which lanes have one.
	if args.debugStream and not targetCanProduceDebugStream(target) 'unsupportedDebugStream'
		printError("error: {DebugStreamFlag} is not implemented for {targetToString(target)}. The DebugStream producer attaches to a NAMED shared segment named by an activation environment variable and stamps a millisecond stopwatch — two host facilities (`sharedMemory`, `uptimeClock`) this target does not provide, so the Std ops behind them (`osOpenNamedSegment`, `osMapNamedSegment`, `osTickCountMs`) have no lowering on this lane. Build for a target that has them, or implement those facilities here.\n")
		return 1
	end 'unsupportedDebugStream'

	// ⛔⛔ **BOTH COVERAGE REFUSALS RUN AHEAD OF THE TREE LOCK AND AHEAD OF THE BUILD CACHE.** A cache hit
	// hands back a binary without ever reaching the compiler, so a rule enforced inside the compile is a
	// rule a WARM build silently skips — and the binary it then hands back is instrumented code with no
	// point table to interpret it, which is exactly the artifact these two exist to prevent.
	//
	// ⚠ The message is the REFERENCE'S, word for word: `tests/coverage/coverage-refusals.test.maxon`
	// spawns both drivers at the same situation and compares their stderr byte for byte.
	if args.coverage and not args.debugInfo 'coverageNeedsDebugInfo'
		printError("{Diagnostic.create(ErrorCode.codeEmitterCoverageNeedsDebugInfo, message: coverageNeedsDebugInfoMessage()).render()}\n")
		return 1
	end 'coverageNeedsDebugInfo'

	// ⛔ **NOT E3104, AND NOT `calleeHostFacility`.** That door is keyed on a callee name the USER'S SOURCE
	// wrote and reports at that call's own span; a build flag has no span, and blaming a compiler-inserted
	// call for it is a defect `TargetFacilities.maxon` records having made once already. This is
	// `--debugstream`'s door, and it reads `targetCanMeasureCoverage` rather than naming a target pair,
	// so the lanes that can measure are read off the facility table that already holds the answer.
	if args.coverage and not targetCanMeasureCoverage(target) 'unsupportedCoverage'
		printError("error: {CoverageFlag} is not implemented for {targetToString(target)}. An instrumented binary writes its counter block to a `<output>{MxcovDataExtension}` file as it exits — the `managedFile` host facility this target does not provide. Build for a target that has it, or implement that facility here.\n")
		return 1
	end 'unsupportedCoverage'

	let lockExit = acquireBuildTreeLock(inputPaths, outputOverride: args.outputOverride)
	if lockExit != 0 'busyTree'
		return lockExit
	end 'busyTree'

	let buildExit = compileAndReport(inputPaths, target: target, args: args)
	releaseTreeLock()
	return buildExit
end 'runBuildPaths'

// ⭐ **WHICH BUILDS ARE TREE-LEVEL, and therefore take this checkout's lock: a PROJECT build that was
// not told where to put its output.** That is `maxon build maxon-bin` — the invocation that writes
// `<project>/.maxon/` and the one that actually raced (see `TreeLock`).
//
// ⚠ **AND IT IS WHAT KEEPS THE SUITE OFF THE LOCK.** The spec runner compiles every selected test
// through a real `build` subprocess and the scale runner one per rung — thousands of them, in
// parallel, INSIDE a run that already holds the lock. Every one of those passes `-o`, because the
// harness owns the output path; so `-o` is exactly the line between "put it where the tree keeps its
// products" and "put it where I said", and locking only the former is what makes a nested build a
// non-event rather than a deadlock.
//
// A FILE build takes nothing either, for the same reason from the other end: it writes beside the file
// it was handed, which is a scratch directory whenever it matters.
//
// ⛔⛔ **A `count() != 1` BYPASS SAT HERE AND IT WAS A3m'S OWN REGRESSION** (BATCH10 review). Before
// A3m `build` took ONE path and silently dropped the rest, so a multi-path build did not exist and
// `count() > 1` was unreachable; A3m made it real and the guard was not widened with it. The bypass
// said a build naming several paths "writes nothing this lock protects, because its output name comes
// from the first SOURCE FILE rather than from `<project>/.maxon/`" — and `resolveOutputPath` derives a
// DIRECTORY build's name from the first registered source file too, by the same line of the same
// function. A fact both shapes share cannot be what tells them apart. `build maxon-bin/Compiler
// maxon-bin/Testing` wrote into the checkout with no lock at all.
//
// ⇒ **THE RULE IS THE ONE `TreeLock`'s HEADER ALREADY STATES, ASKED OF THE PROJECT ROOT INSTEAD OF OF
// THE ARGUMENT LIST**: the lock covers the checkout *"containing the path the command writes into"*,
// and *"a `-o` build writes where the CALLER said and takes nothing"*. So there are exactly two
// questions, and neither is how many paths were typed:
//
//   · **Did the caller say where the output goes?** That is `-o`, and it is now asked FIRST and of
//     every shape. It is the whole reason the suite's thousands of nested `build … -o …` compiles are
//     a non-event inside a run that already holds the lock.
//   · **Otherwise the output is DERIVED — into WHAT?** `resolveOutputPath` writes beside the input
//     when the root is an existing FILE, and beside the first registered source otherwise. So the
//     question is whether the project ROOT is a directory, i.e. whether this build lands in a TREE or
//     beside one named file.
//
// ⚠ **AND THE ROOT IS ASKED OF `commonAncestorOf`, THE SAME FUNCTION `loadProject` ROOTS THE PROJECT
// AT.** Not a second derivation: the lock and the compile cannot disagree about which tree is being
// written because there is one answer to that. It also makes the single-path case provably unmoved —
// `commonAncestorOf` returns its argument untouched when nothing narrows, so `build <file>` and
// `build <directory>` reach the identical test they always did.
//
// A root with no `stdlib/` above it takes no lock regardless: `acquireTreeLock` answers that itself
// (`maxon build /tmp/scratch.maxon` has nothing shared to guard), which is why there is no
// separate scratch-path arm here.
function acquireBuildTreeLock(inputPaths MaxonSourcePathArray, outputOverride String) returns ExitCode
	if not outputOverride.isEmpty() 'callerOwnsTheOutput'
		return 0
	end 'callerOwnsTheOutput'

	// A list with no common root is refused by the compile moments later, with a message naming both
	// ends (`CompileError.noCommonRoot`). Taking no lock is right for it: there is no one tree it
	// writes into, which is the very thing that makes it unbuildable.
	let root = try commonAncestorOf(inputPaths) otherwise 'noTreeToLock'
		return 0
	end 'noTreeToLock'

	if not Directory.isDirectory(root) 'writesBesideOneNamedFile'
		return 0
	end 'writesBesideOneNamedFile'

	return acquireTreeLock(root)
end 'acquireBuildTreeLock'

// The build itself, split out so `runBuild` has ONE exit through which the tree lock is released.
// Maxon has no `defer`, and a release written at each of two returns is a release the third one
// forgets — the lock would then survive its holder and be broken 60 s later as abandoned, which is
// correct behaviour covering for a bug.
function compileAndReport(inputPaths MaxonSourcePathArray, target Target, args MaxonArgs) returns ExitCode
	let outputPath = try compile(inputPaths, target: target, outputOverride: args.outputOverride, emitIr: args.emitIr, metricsPath: args.metricsPath, runtimeIrNames: args.runtimeIrNames, asyncTrace: args.asyncTrace, debugStream: args.debugStream, debugInfo: args.debugInfo, coverage: args.coverage, defines: args.defines) otherwise (e) 'compileErr'
		reportCompileError(e)
		return 1
	end 'compileErr'

	print("Compiled -> {outputPath}\n")
	return 0
end 'compileAndReport'

// The M2 warm-rebuild gate: assert the query spine is deterministic and
// incremental for `<file>`. Exit 0 iff both properties hold. On a file/IO error
// the specific message is printed; a `compileError` stays silent (its diagnostics
// were already printed by the pipeline).
function runVerifyWarmRebuild(args MaxonArgs) returns ExitCode
	let usage = "maxon verify-warm-rebuild <file>"
	if refusedPositionalBeyond(args, allowed: 1, usage: usage) 'tooManyPaths'
		return 1
	end 'tooManyPaths'

	let spelling = args.solePositional()
	if spelling.isEmpty() 'noPath'
		printError("Usage: {usage}\n")
		return 1
	end 'noPath'

	let inputPath = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return 1
	end 'badPath'

	let target = detectHostTarget()
	let bothPass = try verifyWarmRebuild(inputPath, target: target) otherwise (e) 'verifyErr'
		reportCompileError(e)
		return 1
	end 'verifyErr'

	if bothPass 'passed'
		return 0
	end 'passed'

	return 1
end 'runVerifyWarmRebuild'

// The `verify-recheck <file|dir>` command: assert one `Project` survives being checked more than
// once. Shaped exactly like `runVerifyWarmRebuild` next door — same single-positional contract, same
// host target, and the same "the gate printed its own reasons" exit rule.
function runVerifyRecheck(args MaxonArgs) returns ExitCode
	let usage = "maxon verify-recheck <file|dir>"
	if refusedPositionalBeyond(args, allowed: 1, usage: usage) 'tooManyPaths'
		return 1
	end 'tooManyPaths'

	let spelling = args.solePositional()
	if spelling.isEmpty() 'noPath'
		printError("Usage: {usage}\n")
		return 1
	end 'noPath'

	let inputPath = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return 1
	end 'badPath'

	let target = detectHostTarget()
	let allPass = try verifyRecheck(inputPath, target: target) otherwise (e) 'verifyErr'
		reportCompileError(e)
		return 1
	end 'verifyErr'

	if allPass 'passed'
		return 0
	end 'passed'

	return 1
end 'runVerifyRecheck'

// The `spec-test [dir]` command: run every active test in `dir` (default `specs`) on a pool of
// persistent worker subprocesses, print per-test PASS/FAIL + an `N passed, M failed` summary, and
// exit non-zero iff any test failed.
//
// ⛔⛔ **ONE EXECUTABLE AGAIN — AND THIS HEADER SPENT A PARAGRAPH ARGUING THERE WERE TWO.** It read:
// *"TWO EXECUTABLES, NOT ONE … `workerExe` what a pool worker IS … `compilerExe` the COMPILER UNDER
// TEST — the binary each selected test is built with. This process unless `--compiler=<path>` names
// another."* Both facts were real, and the second existed only because a test was BUILT BY A
// SUBPROCESS whose executable a caller could name. Since G20 every test is compiled IN THIS PROCESS,
// so "the compiler under test" is this binary's own code: there is nothing left for a path to select,
// and `--compiler=` is WITHDRAWN rather than kept as a flag that could only lie (⚖ user ruling
// 2026-08-22 — in-process only, no dual path). `harnessExe` is `Process.executablePath()`, and it is
// both facts: what a worker is relaunched as, and what compiles every case. Not settable — a flag that
// spawned some OTHER harness as a worker never had a caller either.
//
// ⚠ **WHAT THE SPLIT WAS FOR IS NOT LOST.** The 🚩 Phase 1 gate was precisely the configuration that
// separated them — a harness compiled by maxon.exe driving maxon.exe as the compiler — and it is
// CLOSED (2026-08-22: the two harnesses agreed byte for byte). Its maintenance form is a self-build
// fixpoint diff, which is a question one binary can answer.
//
// There is ONE path through the pool, taken by every worker count including `--workers=1`. A serial
// in-process branch for the single-worker case would be a second implementation of "run the suite",
// and the two would drift — which is exactly what the worker-count-invariance gate exists to catch.
function runSpecTest(args MaxonArgs) returns ExitCode
	if refusedPositionalBeyond(args, allowed: 1, usage: "maxon spec-test [dir] [--filter=<pattern>] [--update-required] [--network] [--workers=<n>] [--target=<cpu>-<os>]") 'tooManyPaths'
		return 1
	end 'tooManyPaths'

	let specDir = try resolveSpecDir(args) otherwise 'badSpecDir'
		printError("error: invalid spec directory: {args.solePositional()}\n")
		return 1
	end 'badSpecDir'

	// This binary: what a worker process is relaunched as, and what compiles every selected test. See
	// this function's header for why that is one value again.
	let harnessExe = try Process.executablePath() otherwise 'noExe'
		printError("error: could not determine the running executable's path\n")
		return 1
	end 'noExe'

	// The effective target for this run: the host unless `--target` overrode it. Resolved up front so
	// BOTH sides run the SAME target — the dispatcher's pool AND a relaunched worker, which re-parses
	// the same `--target` from its own command line (SpecWorkerPool.spawnNoWait forwards it) and
	// reaches this same resolution. A bad spelling fails once, here. The target reaches each selected
	// test's build (`--target=<cpu>-<os>`) and, for a cross target, its run under the vendored runtime.
	// Resolving before the worker branch prints nothing on the success path (only an unrecognized
	// spelling prints, to stderr, and returns), so the worker's stdout wire stays untouched.
	var effectiveTarget = detectHostTarget()
	match resolveTargetFlag(args.targetSpec) 'targetSel'
		resolved(t) then effectiveTarget = t
		unrecognized(spec) then return reportUnknownTarget(spec)
	end 'targetSel'

	// A WORKER, not a dispatcher: this process was spawned by a parent's pool and speaks the job
	// protocol on stdin/stdout instead of running a suite and reporting on it. It must be checked
	// before anything is printed — a worker's stdout is a wire, not a report.
	if args.workerPersistent 'isPoolWorker'
		// ⚠ A WORKER ASKS NOTHING BEFORE IT STARTS, and that is deliberate rather than an omission. It
		// used to ask `requireRunnerAvailable` — because a worker is a second door onto the GOLDEN WRITER
		// and a `maxoncstderr` case reaches that writer without ever launching a binary — and the point
		// of asking was to PANIC for a target this host cannot execute. That refusal is gone (it threw
		// away a whole lane's worth of checkable work), so the mint door is guarded where the writing
		// happens instead: see `SpecTestRunner.writeFragmentFile`'s `mayMint`.
		return runPersistentWorker(specDir, filter: args.filter, updateRequired: args.updateRequired, effectiveTarget: effectiveTarget, includeNetwork: args.includeNetwork)
	end 'isPoolWorker'

	// ⭐⭐ **GET OUT OF THE WAY BEFORE SATURATING THE MACHINE.** A full suite runs a pool of compiling
	// subprocesses and will use every core it is given; at NORMAL priority that makes the box unusable
	// while it runs. Below-normal costs nothing on an idle machine — MEASURED at 82.8 s against 83.1 s on
	// the bootstrap's suite at a fixed worker count, inside the noise — because a de-prioritised process
	// still gets every idle core. What it buys is that a foreground process preempts the pool instantly.
	//
	// ⚠ **AFTER THE WORKER BRANCH, AND THAT IS THE POINT: A WORKER MUST NOT CALL THIS.** Children inherit
	// the priority class, so the one call here reaches every worker this dispatcher spawns AND every test
	// binary those workers launch. Calling it again in a worker would be the same fact applied twice.
	//
	// ⚠ The answer is DISCARDED here and that is not a swallowed failure: on this lane the only documented
	// way to fail is an invalid handle, and the handle is a compile-time constant. What the value is FOR is
	// `specs/process-background-priority.md`, which asserts it to tell a working lowering from one that
	// did nothing — a question a caller cannot ask about itself.
	__Builtins.enterBackgroundPriority()

	// Whether the binaries this run is ABOUT to draw conclusions from are older than the tree they
	// were built from, asked before anything is selected. A stale binary reports a verdict about code
	// that is not here — a false red, or the same lie as a false green — so the honest answer is to
	// run nothing at all. Asked by the PARENT for `requireRunnerAvailable`'s reason, and asked AFTER
	// the worker branch above so a worker never re-asks it: one fact, reported once, on the process
	// whose stdout is a report rather than a wire.
	// The role reads as the SUBJECT of "<role> is STALE" (see `refuseIfStale`), so it is a bare noun
	// phrase: a trailing relative clause put the verb behind "…it tests is STALE" and the sentence
	// stopped parsing as English.
	let freshnessExit = refuseIfStale(harnessExe, role: "the spec-test harness (which is also the compiler it tests)")
	if freshnessExit != 0 'staleBinary'
		return freshnessExit
	end 'staleBinary'

	// Whether the RUNNER this target needs is installed, asked once and by the PARENT. A cross-target
	// run whose runner is missing fails identically for every test, so discovering it per test turns
	// one fact into hundreds of failures — and inside a worker, into a dead pipe whose real message is
	// in another process's stderr. The workers inherit the answer by never starting.
	//
	// ⚠ A target with NO runner on this host at all is not refused here — it is a lane that compiles
	// and compares everything and executes nothing, reported per case. See `requireRunnerAvailable`.
	requireRunnerAvailable(effectiveTarget)

	// ⭐⭐ **THIS TARGET'S SUITE IS NOT RUN HERE AT ALL — IT IS HANDED, WHOLE, TO A COMPILER INSIDE THE
	// GUEST** (`SpecTestRunner.runSuiteInGuest`), which reaches this same function on the other side and
	// asks everything below this line for itself, against this very tree: the machine mirrors the
	// checkout at identical real paths.
	//
	// ⚠ **THE POSITION IS REQUIRED, NOT TIDY.** The tree lock is a FILE at the checkout root, so the
	// guest contends for the very same one and a host still holding it would refuse its own delegated
	// run. It is placed after `requireRunnerAvailable` because that probe is the delegation's preflight
	// — `orb` installed, the machine reachable and able to execute — and after `refuseIfStale`, which
	// proves the binary that builds the guest's compiler current.
	match runStrategyFor(effectiveTarget) 'lane'
		inGuest then return runSuiteInGuest(harnessExe, specDir: specDir, filter: args.filter, updateRequired: args.updateRequired, workerCount: args.workers, workersOverridden: args.workersOverridden, effectiveTarget: effectiveTarget, includeNetwork: args.includeNetwork)
		individually or
			wslBatch or
			noneHere then break 'lane'
	end 'lane'

	// ⭐ **AND THAT A VERDICT NOTHING RAN IS STILL COUNTED, REASONED AND NOT GREEN** — the mapping that
	// lane rests on, asked in the same slot and for `requireRunnerAvailable`'s reason. It is pure and
	// costs microseconds; see `SpecVerdictSelfTest` for why a lane whose whole job is reporting
	// "not run" needs a guard that the reporting cannot quietly become "passed".
	requireSpecVerdictMapping()

	// ⭐ **AND THAT THE `.mxdbg` CONTAINER STILL ROUND-TRIPS**, asked in the same slot and for the same
	// reason: it is pure, it costs microseconds, and the format is a contract with ANOTHER driver — the
	// bootstrap reads a sidecar this compiler writes. A layout that has drifted is not a failed read, it
	// is a silent misread, so it is checked before any case that writes one runs.
	requireMxdbgRoundTrip()

	// ⭐ **AND THAT NO TWO ERROR CODES SHARE A NUMBER**, asked in the same slot and for the same
	// reason: it is pure, it costs microseconds, and a duplicate number is the one registry defect
	// the language cannot refuse for itself (see `ErrorCodeSelfTest`).
	requireErrorCodesUnique()

	// The hand-built ladders' index against the ladders themselves, asked once and by the PARENT for
	// `requireRunnerAvailable`'s reason. It rides the suite because the suite is the thing that already
	// runs: a check nobody runs is exactly the drift it exists to catch, one level up (see LadderIndex).
	requireLadderIndexComplete()

	// ⭐ **AND WHETHER ANY OTHER COMMAND IS ALREADY WRITING THIS TREE.** Two suites share
	// `<specDir>/.spec-tmp`, so one deletes what the other is compiling — a measured FALSE RED — and a
	// build running alongside replaces the very binary this run is drawing verdicts from. Asked here,
	// after every question that costs nothing, so a refusal is instant and before a worker exists.
	//
	// ⚠ A HARNESS FIXTURE SUB-RUN TAKES NO LOCK: it is spawned BY a parent suite that holds this same
	// tree (see `requireHarnessRefusalsFire`), so acquiring here would refuse against its own parent.
	// The predicate is the one the self-test already uses to recognise itself.
	let lockExit = acquireSuiteTreeLock(specDir)
	if lockExit != 0 'busyTree'
		return lockExit
	end 'busyTree'

	let suiteExit = runSpecSuite(args, specDir: specDir, harnessExe: harnessExe, effectiveTarget: effectiveTarget)
	releaseTreeLock()
	return suiteExit
end 'runSpecTest'

// ⭐⭐ **`maxon fmt` — RE-PRINT MAXON SOURCES IN CANONICAL LAYOUT, IN PLACE.**
//
// The expectations under `tests/fmt/fixtures/` are the contract: each stream, each exit code and each
// resulting tree is pinned there, so a change to this command's OBSERVABLE BEHAVIOUR shows up as a
// fixture diff. That is why the two refusals below are spelled out here instead of going through this
// driver's shared `refusedPositionalBeyond` — that helper says `error: unexpected extra argument: <x>`
// followed by a `Usage:` line, and `fmt` says something else. See `FmtUsageLine`.
//
// ⚠ **A `-`-LEADING ARGUMENT NEVER REACHES THE WALK**: `MaxonArgs.parse` records every one of them as
// a bad option the moment the command is `fmt`, and `main` routes that here rather than to its own
// gate. The reason is in `FmtCommandName`, and it is not tidiness — a dropped flag makes this command
// rewrite the working directory.
function runFmt(args MaxonArgs) returns ExitCode
	if not args.anyOption.isEmpty() 'refusedOption'
		printError("fmt: unrecognized option: {args.anyOption}\n")
		printError("{FmtUsageLine}\n")
		return 1
	end 'refusedOption'

	if args.paths.count() > 1 'refusedSecondPath'
		printError("fmt: expected at most one path, got {args.paths.count()}: {joinedWith(args.paths, separator: PathListSeparator)}\n")
		return 1
	end 'refusedSecondPath'

	let spelling = args.solePositional()
	return match fmtSelection(spelling) 'selection'
		files(paths) gives formatEachFile(paths)
		notFound gives refusedFmtPath(spelling)
	end 'selection'
end 'runFmt'

// What a `fmt` invocation's one argument resolves to.
union FmtSelection
	// The files to rewrite, in the order they will be visited.
	files(paths FilePathArray)
	// The argument names nothing on disk.
	notFound
end 'FmtSelection'

// ⚠ **A NAMED FILE IS FORMATTED WHATEVER IT IS CALLED AND WHEREVER IT SITS** — a `build.maxon`, a
// `.test` fragment, a file under a `.maxonignore`. Naming a path outright overrides every exclusion,
// exactly as it does for `maxon build`: the filters belong to the WALK, which only ever sees paths it
// discovered itself (see `Formatter.collectFormattableFiles`).
function fmtSelection(spelling String) returns FmtSelection
	if spelling.isEmpty() 'noPathGiven'
		return FmtSelection.files(collectFormattableFiles(Directory.currentPath()))
	end 'noPathGiven'

	let target = try FilePath.from(spelling) otherwise return FmtSelection.notFound

	if Directory.isDirectory(target) 'aDirectory'
		return FmtSelection.files(collectFormattableFiles(target))
	end 'aDirectory'

	if File.exists(target) 'aFile'
		var only = FilePathArray.create()
		only.push(target)
		return FmtSelection.files(only)
	end 'aFile'

	return FmtSelection.notFound
end 'fmtSelection'

// Rewrite each file whose formatted text DIFFERS from what is on disk, and report the two counts. A
// file that is already canonical is not rewritten: `fmt` over a clean tree must leave every mtime alone.
function formatEachFile(files FilePathArray) returns ExitCode
	var changed = 0 as FormattedFileCount
	for file in files 'eachFile'
		let original = try File.readText(file) otherwise 'unreadable'
			printError("fmt: could not read {file}\n")
			return 1
		end 'unreadable'

		let formatted = format(original)
		if formatted != original 'differs'
			try File.writeText(file, content: formatted) otherwise 'unwritable'
				printError("fmt: could not write {file}\n")
				return 1
			end 'unwritable'

			print("formatted: {file}\n")
			changed = changed + 1
		end 'differs'
	end 'eachFile'

	print("fmt: {changed} file(s) changed, {files.count() - changed} unchanged.\n")
	return 0
end 'formatEachFile'

function refusedFmtPath(spelling String) returns ExitCode
	printError("fmt: path not found: {spelling}\n")
	return 1
end 'refusedFmtPath'

// How many files one `fmt` run rewrote.
typealias FormattedFileCount = int(0 to u64.max)

// What separates the paths `fmt` names back when it refuses more than one.
let PathListSeparator = ", "

// The spellings joined for a message that has to name them all — a free function because the library
// carries no `String.join`.
function joinedWith(values SourcePathSpellingArray, separator String) returns String
	var out = StringBuilder.create()
	var first = true
	for value in values 'eachValue'
		if not first 'needsSeparator'
			out.append(separator)
		end 'needsSeparator'
		out.append(value)
		first = false
	end 'eachValue'
	return out.build()
end 'joinedWith'

// The tree lock for a suite run — taken for every run except a fixture sub-run, whose parent holds it.
function acquireSuiteTreeLock(specDir FilePath) returns ExitCode
	if isHarnessFixtureSubRun(specDir) 'parentHoldsIt'
		return 0
	end 'parentHoldsIt'

	return acquireTreeLock(specDir)
end 'acquireSuiteTreeLock'

// The suite itself, split out so `runSpecTest` has ONE exit through which the tree lock is released —
// see `compileAndReport` for why that shape rather than a release at each of five returns.
function runSpecSuite(args MaxonArgs, specDir FilePath, harnessExe FilePath, effectiveTarget Target) returns ExitCode
	let run = try runSpecPool(harnessExe, specDir: specDir, filter: args.filter, updateRequired: args.updateRequired, workerCount: args.workers, effectiveTarget: effectiveTarget, includeNetwork: args.includeNetwork) otherwise (e) 'runErr'
		reportCompileError(e)
		return 1
	end 'runErr'

	// A run that selected NOTHING is a failure, not a pass. A mistyped `--filter`
	// would otherwise report "0 passed, 0 failed" and exit 0 — a green suite that
	// tested nothing, which is the most expensive kind of lie a test runner can
	// tell. It is worse still under `--update-required`, where an empty selection
	// silently regenerates no goldens while looking like it did the work.
	if run.results.count() == 0 'selectedNothing'
		// ⚠ **ON THIS PATH THE CENSUS COMES BEFORE THE VERDICT LINE, AND ONLY ON THIS PATH**, because here
		// it is the only thing that can explain it. A default `--filter=http-client.get` selects nothing at
		// all: every case it named reaches the public internet. "no tests selected" on its own states the
		// consequence and hides the cause.
		reportExclusions(run.excluded, effectiveTarget: effectiveTarget)

		printError("error: no tests selected{filterSuffix(args.filter)}\n")
		return 1
	end 'selectedNothing'

	let testsExit = reportResults(run.results)

	// ⭐ WHAT THIS RUN NEVER EVEN TRIED — the live-network cases and the ones whose instrument does not
	// reach this lane, named and counted. It heads the "not run" family below because these are the ones
	// nothing about the TARGET prevented: a reader who is
	// not told sees a green column over a claim nobody exercised. It sits UNDER the verdicts rather than
	// above them for `reportTargetSkips`'s reason — a note printed ahead of a few thousand report lines
	// has scrolled away by the time the reader reaches the summary it qualifies.
	reportExclusions(run.excluded, effectiveTarget: effectiveTarget)

	// ⭐ WHAT THIS RUN DID NOT RUN, AND WHY — immediately under the verdicts, because it is a statement
	// about the TESTS and must not sit below the two reports that are about the TREE. A skip is the one
	// outcome that can look like coverage without being any, so it is named, counted and attributed to
	// the target here rather than being left to the reader to notice a missing line.
	reportTargetSkips(run.results, effectiveTarget: effectiveTarget)

	// ⭐ AND WHAT THIS HOST COULD NOT EXECUTE, in the same slot and for the same reason — the other way
	// a case can be counted without having been verified. One sentence for the whole lane, because the
	// reason is the (target, host) pair rather than anything about a case.
	reportUnrunHere(tallyResults(run.results), effectiveTarget: effectiveTarget)

	// AFTER the summary and BEFORE the exit branches, so a red run reports its cost too: a suite that
	// went red because something got dramatically slower is exactly when the number is worth reading.
	// STDERR, because stdout is the report and must stay byte-identical between worker counts — see
	// `SuiteCpuTally.reportLine`, which is the only place this line is spelled.
	printError("{run.cpu.reportLine(run.poolSize)}\n")

	// ⚖ **GOLDENS THAT CONTRADICT THE COMPILER — REPORTED, NEVER JUDGED**, on the same ruling as the census
	// below and in the same slot, because both are facts about the TREE rather than about any test. It is
	// that census's missing direction: it finds a reference nothing READS, this finds one that IS read and
	// disagrees. See `SpecTestRunner.reportGoldenDrift` for why nothing else in this tree can.
	reportGoldenDrift(run.results)

	// ⚖ **GOLDENS NOTHING COMPARES — REPORTED, NEVER JUDGED** (user, 2026-08-02: *"the goldens are
	// NOT supposed to be a gate, they are just for reference"*). It comes AFTER the verdicts and the
	// summary, on stderr, because it is a fact about the TREE rather than about any test and must never
	// displace the reason a test failed. A `.test` whose case was renamed away is read by nothing and
	// shows in no diff, so only an enumeration can find it — see `GoldenCensus`. Asked on every run,
	// filtered included: the answer is read out of the spec text, not out of what this run executed.
	reportUncomparedGoldens(specDir, effectiveTarget: effectiveTarget)

	if testsExit != 0 'someTestFailed'
		return testsExit
	end 'someTestFailed'

	// Every test passed — and a worker that exited NON-ZERO is still a suite failure. A worker is
	// itself a leak-gated Maxon program, so exit 101 means the harness leaked memory while
	// servicing its tests. Green tests must never be allowed to mask that.
	if run.failedWorkers > 0 'workerFailed'
		printError("error: {run.failedWorkers} spec worker(s) exited non-zero (see above) — failing the suite despite {run.results.count()} passing tests\n")
		return 1
	end 'workerFailed'

	return 0
end 'runSpecSuite'

// The trailing ` matching --filter=<pattern>` clause of the "no tests selected"
// message, omitted entirely when no filter was given (an empty spec directory and
// a filter that matched nothing are different failures and read differently).
function filterSuffix(filter String) returns String
	if filter.isEmpty() 'noFilter'
		return ""
	end 'noFilter'
	return " matching --filter={filter}"
end 'filterSuffix'

// Resolve the spec directory: an explicit positional argument wins; otherwise
// the default `specs`.
//
// ⭐⭐ **THE ANSWER IS ABSOLUTE WHICHEVER WAY IT WAS SPELLED, AND SINCE R4.8 THAT IS A CORRECTNESS
// REQUIREMENT RATHER THAN TIDINESS.** Every path this run computes hangs off this one — the staged
// source, the `-o` output base, the exe that gets SPAWNED (`SpecTestRunner.spawnOneRun`, or the batch
// script `runWslBatch` writes) — and that spawn
// now names its own working directory (`specRunWorkingDir`, `<checkoutRoot>/temp/`). A path relative to
// the HARNESS's cwd handed to a child that no longer has that cwd is a path with two possible meanings,
// and which one the OS picks is a PLATFORM detail: Windows resolves a partial `lpApplicationName`
// against the CALLING process's directory (so it happens to work), while the arm64/macOS runtime does
// `posix_spawn_file_actions_addchdir_np` and then `posix_spawnp`, which resolves it against the NEW one
// (so it does not). A path that survives the crossing is the only kind this harness may hand out.
//
// ⚠ The default branch was ALREADY absolute (`Directory.currentPath().join(…)`) and the explicit branch
// was not — one rule written twice, agreeing only because nothing in-tree passed a positional argument
// except `HarnessSelfTest`, which passes a RELATIVE one. Both branches now go through the same
// `resolve`, which is `join` for a relative spelling and the identity for an absolute one.
function resolveSpecDir(args MaxonArgs) returns FilePath throws FilePathError
	// Bind the FilePath to a local first: a bare String constant is ambiguous between the
	// String/FilePath overloads, and an inline `try` expression in an argument position does not
	// disambiguate it.
	let spelled = try FilePath.from(specDirSpelling(args))
	return spelled.resolve(Directory.currentPath())
end 'resolveSpecDir'

// The spec directory AS TYPED — the positional argument, or the default when there was none. Split out
// so the "make it absolute" rule above reads once instead of once per branch.
function specDirSpelling(args MaxonArgs) returns String
	let spelled = args.solePositional()
	if spelled.isEmpty() 'useDefault'
		return DefaultSpecDir
	end 'useDefault'
	return spelled
end 'specDirSpelling'

// ⭐ **THE COMMANDS THAT TAKE AT MOST ONE POSITIONAL REFUSE A SECOND, rather than obeying the first
// and dropping the rest — TRUE means it refused, and printed why.** `build` is the one command that
// reads the whole list (A3m); for every other, a second positional is a command line the driver only
// partly understood, and `main`'s `badOption` gate exists because proceeding on one of those is the
// failure a caller can neither see nor recover from. An unrecognized FLAG was already refused there;
// a second bare word was not, so `spec-test specs specs` ran the first directory and said
// nothing at all about the second.
// ⚠ **`allowed` IS A COUNT AND NOT A BOOL, BECAUSE ONE COMMAND ALLOWS NONE.** `build`, `spec-test` and
// `verify-warm-rebuild` each read ONE positional and must refuse a second; `scale-test` reads NONE, so
// for it the FIRST is already the typo — measured, it ran the whole ladder for `scale-test foo` and
// never mentioned `foo`. A second copy of these two lines under a different predicate is how that
// message drifts, so the predicate is the parameter and the message stays here.
//
// Exported for `Testing/ScaleTestRunner`, which owns `scale-test`'s entry point the way this file owns
// the other three.
module function refusedPositionalBeyond(args MaxonArgs, allowed PositionalCount, usage String) returns bool
	if args.paths.count() <= allowed 'withinBudget'
		return false
	end 'withinBudget'

	let extra = try args.paths.get(allowed) otherwise panic("refusedPositionalBeyond: the count is greater than {allowed} on the line above, so index {allowed} exists")
	printError("error: unexpected extra argument: {extra}\n")
	printError("Usage: {usage}\n")
	return true
end 'refusedPositionalBeyond'

// How many positional arguments a command reads. Two today — one, or none.
typealias PositionalCount = int(0 to 1)

// ⭐⭐ **WHAT A WITHDRAWN OPTION SAYS — one sentence per option this driver once had.**
//
// It is its OWN message and not `badOption`'s because the two are different facts about the reader:
// an unknown option was never understood and is probably a typo, while a withdrawn one WAS
// understood and is now structurally impossible. Only the second owes an explanation, and a script
// carrying the flag needs to be edited rather than re-read.
//
// ⛔ **ONE ARM PER WITHDRAWN SPELLING, AND THE `panic` IS WHAT HOLDS THIS LIST TO `MaxonArgs.parse`'s.**
// A spelling recorded there and unnamed here would be refused with an empty sentence — less than the
// anonymous `badOption` path says, from the door that exists to say more.
function withdrawnOptionMessage(option String) returns String
	if option.startsWith(WithdrawnCompilerFlagPrefix) 'theCompilerFlag'
		return "error: {WithdrawnCompilerFlagPrefix}= was REMOVED. spec-test compiles every selected test IN THIS PROCESS, so the compiler under test is this executable's own code and no path can name a different one. Run the suite with the binary you mean to test: `<compiler> {SpecTestCommandName}`."
	end 'theCompilerFlag' else if option == WithdrawnVersionFlag or option == WithdrawnVersionFlagShort 'theVersionFlag'
		return "error: {option} was REMOVED. The version is a command, so there is one door onto it and it is listed with everything else this binary does: `maxon {VersionCommandName}`."
	end 'theVersionFlag' else if option == WithdrawnHelpFlag or option == WithdrawnHelpFlagShort 'theHelpFlag'
		return "error: {option} was REMOVED. Help is a command, so there is one door onto it and it is listed with everything else this binary does: `maxon {HelpCommandName}` for the whole reference, `maxon {HelpCommandName} <command>` for one command."
	end 'theHelpFlag'

	panic("withdrawnOptionMessage: '{option}' was recorded as a withdrawn option by `MaxonArgs.parse`, and this is the one place that says what replaced one — a flag recorded there and unnamed here would be refused with an empty sentence")
end 'withdrawnOptionMessage'

// Print each test's verdict and the summary, returning the process exit code (1
// iff any test failed). The PASS/FAIL line is built via a match EXPRESSION (both
// arms yield a real string) so the fail reason is extracted without a sentinel.
//
// ⚖ **THESE TWO NUMBERS ARE THE PRODUCT, AND NOTHING ABOUT A GOLDEN IS IN THEM** (user, 2026-08-02:
// *"the gate is the spec tests passing"*). A test whose committed golden no longer matches what the
// compiler emits still PASSED — it is counted as one and printed as one. `0 failed` means the spec
// tests passed, with no qualifications to read past. Drift gets a LINE OF ITS OWN below, which is what
// lets the report say `0 failed` and `35 drifted` in one breath without either qualifying the other.
//
// ⚠ **A CASE THAT DID NOT RUN IS IN NEITHER NUMBER, AND ITS OWN LINE IS WHY THAT IS SAFE.** Counting
// it as a pass would be a claim nothing supports, and counting it as a failure would redden every
// cross-target run over a machine limit that is not a defect. The summary line's shape is deliberately
// untouched — several scripts read `^N passed, M failed` — so each count follows on a line of its own,
// and the reason behind each is named by its own note on stderr (`reportTargetSkips` names the
// constructs; `reportUnrunHere` names the host limit, once, because every case shares it).
function reportResults(results SpecTestResultArray) returns ExitCode
	for result in results 'each'
		print("{verdictLine(result.outcome, label: testLabel(result.specName, testName: result.testName))}\n")
	end 'each'

	let tally = tallyResults(results)
	print("\n{tally.passed} passed, {tally.failed} failed\n")

	// Silent at zero, which is the host lane and most of every other — the suite's convention for every
	// trailer, where "no note" means none.
	if tally.skipped > 0 'anySkipped'
		print("{tally.skipped} skipped — NOT RUN on this target (see the note on stderr for the constructs)\n")
	end 'anySkipped'

	if tally.notRunHere > 0 'anyUnrunnable'
		print("{tally.notRunHere} not run here — COMPILED and compared against a committed golden where one exists, but this host cannot execute them (see the note on stderr)\n")
	end 'anyUnrunnable'

	// ⚖ THE SECOND AXIS, IN THE SAME BREATH AS THE FIRST (see `GoldenDrift`). It sits under the two
	// not-run lines because it qualifies neither of them: a drifted case is already counted in whichever
	// column it earned, and this line says only that its committed reference no longer describes what the
	// compiler emits. The differences are in the stderr trailer, which is where a multi-line report belongs.
	if tally.drifted > 0 'anyDrifted'
		print("{goldenDriftSummary(tally.drifted)}\n")
	end 'anyDrifted'

	// ⛔ **A RUN IN WHICH NOTHING RAN IS A FAILURE, AND IT IS THE SAME FAILURE `runSpecSuite`'s
	// empty-selection guard refuses one step earlier.** There the filter selected nothing; here
	// everything it selected was refused by the target or unexecutable on this host. Both print
	// `0 passed, 0 failed` and would otherwise exit 0 — a green run that tested nothing, which this
	// runner already calls the most expensive lie it can tell — and the only difference between them is
	// which side of the compile the emptiness arrived from. It is also the backstop on both not-run
	// mechanisms: a compiler that started emitting E3104 everywhere, or a lane on which literally every
	// case needs a runner this host lacks, would vanish the whole suite, and this is the line that
	// refuses to call that green.
	if tally.provedNothing() 'nothingRan'
		printError("error: every selected test was SKIPPED or NOT RUN on this host, so this run proved nothing — the notes below name the constructs this target has no implementation for and the binaries this host cannot execute\n")
		return 1
	end 'nothingRan'

	if tally.failed > 0 'anyFailed'
		return 1
	end 'anyFailed'
	return 0
end 'reportResults'

// One test's line in the report. A match EXPRESSION (every arm yields a real string) so the fail
// reason is extracted without a sentinel; split out of the loop above so the printed text and the
// tally beside it are not one `match` doing two jobs.
//
// A SKIP prints no reason: the reason is the compiler's E3104 diagnostic, which names an absolute
// scratch path and is genuinely multi-line, and it is printed once per case in the stderr census
// instead of being crammed onto a verdict line. A NOTRUN prints none either, for the opposite reason —
// every case on such a lane shares ONE reason, so it is stated once in the trailer instead of several
// thousand times here.
module function verdictLine(outcome TestOutcome, label String) returns String
	return match outcome 'verdict'
		pass gives "PASS {label}"
		fail(reason) gives "FAIL {label}: {reason}"
		skipped gives "SKIP {label}"
		notRunHere gives "NOTRUN {label}"
	end 'verdict'
end 'verdictLine'

// The FIRST bad option wins. A command line can be wrong in several ways at once, and reporting the
// last one found would point at whichever flag happened to be typed rightmost rather than at the one
// the reader would look for first.
function firstBadOption(current String, arg String) returns String
	if current.isEmpty() 'firstBad'
		return arg
	end 'firstBad'
	return current
end 'firstBadOption'

// ⭐⭐ **THE USER-FACING MESSAGE FOR A FILE/IO `CompileError`, WRITTEN THROUGH THE ONE DIAGNOSTIC
// SINK — so a caller compiling IN PROCESS reads exactly what a command line would have printed.**
//
// ⛔ **IT USED TO CALL `printError` DIRECTLY, AND THAT WAS THE ONE GAP IN THE CAPTURE.**
// `Diagnostics.emitDiagnosticLine`'s header recorded it as an outstanding obligation: every
// `Diagnostic` went through the sink, but the SIX `CompileError` arms that never reach
// `project.diagnostics` at all — `fileNotFound`, `directoryNotFound`, `noSourceFiles`, `readError`,
// `noCommonRoot`, `stdlibNotFound` — were printed here, past it. So a capture was exact for a REFUSED compile and
// EMPTY for a build that died on a missing file. `SpecTestRunner.compileOneTest` calls this INSIDE its
// capture, which is what closes that gap and why there is still only one renderer of these sentences.
//
// The `compileError` arm is SILENT: its diagnostics were already emitted by the pipeline, through this
// same sink, so a failing build says exactly those diagnostic lines and nothing else (the
// `maxoncstderr` spec contract).
//
// ⚠ THE TRAILING NEWLINE IS THE SINK'S NOW, NOT EACH ARM'S. `emitDiagnosticLine` terminates what it is
// handed (one call is one diagnostic), so an arm that kept its own would emit a blank line after every
// message.
//
// Shared by every command's failure path so the mapping lives in one place — including the scale-test
// runner, which is why it is exported.
module function reportCompileError(e CompileError)
	match e 'report'
		fileNotFound(p) then emitDiagnosticLine("error: file not found: {p}")
		directoryNotFound(p) then emitDiagnosticLine("error: directory not found: {p}")
		noSourceFiles(r) then emitDiagnosticLine("error: no source files under {r}")
		// NOT "share no directory": that is true of two drives and FALSE of two top-level directories on
		// one, whose common directory is the drive root — a directory `FilePath` cannot hold, because
		// `parent` cuts the separator off (see `Compiler.commonAncestorOf`). The sentence names what the
		// compiler can and cannot do rather than asserting something about the filesystem that is wrong
		// half the time, and the remedy works for both causes.
		noCommonRoot(first, other) then emitDiagnosticLine("error: {first} and {other} have no common directory this build can be rooted at. Name a directory they are both under as one of the paths, or build them separately")
		readError(p) then emitDiagnosticLine("error: could not read {p}")
		stdlibNotFound then emitDiagnosticLine("error: could not locate the stdlib/ directory (every compile loads stdlib source)")
		compileError then break 'report'
	end 'report'
end 'reportCompileError'

// ⭐⭐ **WHAT A REFUSED COMMAND LINE EXITS WITH.** For `test` it is 2 — "the run could not happen" —
// because that command documents 0/1/2 as three different answers and CI branches on the difference
// between "a test failed" (1) and "the harness never ran" (2). Every other command has only "it ran"
// and "it did not", and their 1 is load-bearing for callers that already read it.
//
// EXHAUSTIVE and with no default arm, so a command added tomorrow has to state which of the two it is
// rather than inheriting an answer nobody chose for it.
function refusedCommandLineExit(command MaxonCommand) returns ExitCode
	return match command 'whichCommand'
		test gives NothingRanExitCode
		build gives 1
		coverage gives 1
		debug gives 1
		fmt gives 1
		help gives 1
		lspServer gives 1
		monitor gives 1
		profile gives 1
		scaleTest gives 1
		specTest gives 1
		verifyRecheck gives 1
		verifyWarmRebuild gives 1
		version gives 1
		unknown gives 1
	end 'whichCommand'
end 'refusedCommandLineExit'

// ⭐⭐ **THE ONE LINE THAT SAYS WHICH BINARY THIS IS.** `version` prints it and the no-argument overview
// leads with it, so a caller comparing what the two told them cannot find two answers. It carries the
// host triple because "which maxon is this" is not fully answered by a number when four targets ship
// under one name.
function versionLine() returns String
	return "maxon {CompilerVersion} ({CompilerCommit} {CompilerCommitDate}) ({targetToString(detectHostTarget())})"
end 'versionLine'

// ⭐ **ONE LINE, TO STDOUT, EXIT 0.** A version is read by scripts far more often than by people —
// the release workflow compares it against the tag, and a packager scrapes it — so it goes to stdout
// where a pipe can reach it.
//
// ⚠ It reads NO positional, so the FIRST one is already the typo `refusedPositionalBeyond` exists to
// name — `maxon version 1.2.3` must not print an answer that ignores half of what was typed.
function runVersion(args MaxonArgs) returns ExitCode
	if refusedPositionalBeyond(args, allowed: 0, usage: "maxon {VersionCommandName}") 'unexpectedArgument'
		return 1
	end 'unexpectedArgument'

	print("{versionLine()}\n")
	return 0
end 'runVersion'

// ⛔ Asking a `MaxonCommand` for a fact only a real command has, when the value is `unknown` — which is
// the ABSENCE of a command and carries no word, no arguments and no description. Every walk over the
// roster goes through `namedCommands`, which leaves it out, so reaching this is a caller that did not.
enum HelpReferenceError implements Error
	notACommand
end 'HelpReferenceError'

typealias MaxonCommandArray = Array with MaxonCommand

// ⚠ **IT ENDS IN A COLON, AND A COMMAND LABEL NEVER DOES.** That is what tells a heading apart from a
// section in `maxon help`, where both sit at the left margin — `tests/cli` reads the roster off exactly
// that difference.
let CompilerWorkHeading = "Commands for working on the compiler itself:"

// How the reference's prose is written: paragraphs separated by a newline, words by a space. Named
// because `printHelpEntry` splits on both and its wrap arithmetic counts one of them.
let ParagraphSeparator = "\n"
let WordSeparator = " "

// ⭐⭐ **WHO A COMMAND IS FOR, AND THEREFORE WHERE IT IS LISTED.** Fourteen commands is more than a
// reader wanting to compile a program should have to read past, and four of them are about THIS
// COMPILER rather than about any program it builds — a suite over `specs/`, a scaling ladder, and the
// two spine gates. They are listed by `maxon help` and left out of what `maxon` prints.
//
// ⛔ **HIDDEN FROM A LISTING IS NOT HIDDEN FROM THE PARSER.** `commandFromWord` walks every named
// command, so a command left off the short list is typed, parsed and run exactly as before, and
// `maxon help <it>` documents it. A door that a listing does not mention is still a door; a door that
// is not there is a feature withdrawn, and this is not that.
enum CommandAudience
	// Someone USING this compiler on a program of their own. What `maxon` with no arguments lists.
	usingTheCompiler
	// Someone WORKING ON this compiler.
	workingOnTheCompiler
end 'CommandAudience'

// One command's whole entry in the reference. The five facts are held together because they are read
// together, and a second table of any one of them would be a roster that rots: `commandFromWord` decides
// what the PARSER accepts by reading `word` back out of here.
type CommandReference
	// The word that selects the command.
	export var word as String
	// Its argument sketch, or empty for a command that takes none.
	export var arguments as String
	// ONE line, and the whole of what `maxon` with no arguments says about this command.
	export var summary as String
	// The rest of the prose, or empty when the summary says everything. Paragraphs are separated by
	// `ParagraphSeparator`; nothing here is wrapped or padded by hand.
	export var detail as String
	// Who it is for, which decides which listings show it. See `CommandAudience`.
	export var audience as CommandAudience

	export static function create(word String, arguments String, summary String, detail String, audience CommandAudience) returns CommandReference
		return Self{word: word, arguments: arguments, summary: summary, detail: detail, audience: audience}
	end 'create'

	// What the reader types, which is the label every listing shows.
	export function label() returns String
		return self.word if self.arguments.isEmpty() else "{self.word} {self.arguments}"
	end 'label'

	// Everything the long forms print, as one piece of prose.
	export function description() returns String
		return self.summary if self.detail.isEmpty() else "{self.summary} {self.detail}"
	end 'description'
end 'CommandReference'

// ⭐⭐ **THE COMMAND ROSTER, AND THE ONLY ONE.** Every printer below walks it, and `MaxonArgs.parse`
// selects the command through `commandFromWord`, which reads it backwards. So a command added to
// `MaxonCommand` does not compile until it says what it is — the match is exhaustive with no default
// arm — and cannot be documented under a word the parser does not accept, nor accepted under a word the
// reference never prints.
function commandReference(command MaxonCommand) returns CommandReference throws HelpReferenceError
	return match command 'whichCommand'
		build gives CommandReference.create(BuildSubcommandName, arguments: "<file|directory>...", summary: "Compile a Maxon program to an executable.", detail: "Several paths are compiled as ONE program, in the order given.", audience: CommandAudience.usingTheCompiler)
		coverage gives CommandReference.create(CoverageCommandName, arguments: "<run|report> <exe>", summary: "Run a {CoverageFlag} binary and report line + branch coverage.", detail: "Everything after the executable is the CHILD's command line and reaches it untouched.", audience: CommandAudience.usingTheCompiler)
		debug gives CommandReference.create(DebugCommandName, arguments: "<subcommand> <exe>", summary: "Read back the `.mxdbg` debug-info sidecar beside a binary.", detail: "`--dump-info <exe>` prints the sidecar; `--symbolize <exe> <offset>...` resolves `.text` code offsets to file:line:col.", audience: CommandAudience.usingTheCompiler)
		fmt gives CommandReference.create(FmtCommandName, arguments: "[<file|directory>]", summary: "Re-print Maxon sources in canonical layout, IN PLACE.", detail: "With no path it formats the working directory. A named FILE is formatted whatever it is called; a DIRECTORY is walked for `.maxon` files, skipping `build.maxon`, anything under a `.maxonignore`, and any subdirectory that is its own checkout. Takes no options.", audience: CommandAudience.usingTheCompiler)
		help gives CommandReference.create(HelpCommandName, arguments: "[<command>]", summary: "Print this reference: every command's options, or one command's.", detail: "`maxon` with no arguments prints the short list instead.", audience: CommandAudience.usingTheCompiler)
		lspServer gives CommandReference.create(LspServerCommandName, arguments: "", summary: "Speak the Language Server Protocol over stdio.", detail: "JSON-RPC bodies under Content-Length framing, the initialize / shutdown / exit lifecycle, and full text-document synchronisation.", audience: CommandAudience.usingTheCompiler)
		monitor gives CommandReference.create(MonitorCommandName, arguments: "<exe> [args...]", summary: "Launch an executable with the debug-stream monitor attached.", detail: "Everything after the executable is the CHILD's command line and reaches it untouched.", audience: CommandAudience.usingTheCompiler)
		profile gives CommandReference.create(ProfileCommandName, arguments: "run <exe>", summary: "Launch a program and sample where its CPU time goes.", detail: "It needs no instrumentation and no rebuild: only the `.mxdbg` sidecar is read.", audience: CommandAudience.usingTheCompiler)
		scaleTest gives CommandReference.create(ScaleTestCommandName, arguments: "", summary: "Measure how this compiler scales, on a doubling ladder of programs.", detail: "Each rung is compiled and its per-phase cost reported. The MEMORY columns (allocations, frees and bytes) are exact and reproducible; the CPU column is the ticks the compiling thread spent. It does NOT collect WALL time: wall time counts every other process on the box, so a dated table of it would compare a loaded machine in July against an idle one in August. The ladder doubles, so the ratio between rungs IS the growth (x2.00 linear, x4.00 quadratic) and nothing is fitted.{ParagraphSeparator}An INSTRUMENT, not a gate: it renders no verdict, and it exits non-zero only when the RUN broke. The trend it feeds is {OptimizationLogRelativePath}.", audience: CommandAudience.workingOnTheCompiler)
		specTest gives CommandReference.create(SpecTestCommandName, arguments: "[dir]", summary: "Run the specs suite (default dir: {DefaultSpecDir}).", detail: "Every selected case is compiled IN THIS PROCESS, so the compiler under test is this executable's own code and no path can name a different one.", audience: CommandAudience.workingOnTheCompiler)
		test gives CommandReference.create(TestCommandName, arguments: "[dir]", summary: "Run a PROJECT's own `test` declarations (default: the working dir).", detail: "Every test found is compiled into ONE binary with a generated entry point and run; which of them RUN is a runtime argument, so a filter change costs no recompile. NOT specs: that is `{SpecTestCommandName}`.{ParagraphSeparator}Exit 0 every test passed; 1 a test failed, crashed, timed out, leaked, did not run, or NO TESTS WERE FOUND, which is never reported as success; {NothingRanExitCode} the run could not happen.", audience: CommandAudience.usingTheCompiler)
		verifyRecheck gives CommandReference.create(VerifyRecheckCommandName, arguments: "<file|dir>", summary: "Assert ONE Project can be re-checked.", detail: "Two checks over unchanged input agree, and a diagnostic introduced by an edit CLEARS when the edit is undone. `{VerifyWarmRebuildCommandName}` gates the query spine without ever running the pipeline; this gates the pipeline over it, which is what an editor holding one project open for hours actually does.", audience: CommandAudience.workingOnTheCompiler)
		verifyWarmRebuild gives CommandReference.create(VerifyWarmRebuildCommandName, arguments: "<file>", summary: "Assert the query spine is deterministic + incremental.", detail: "It exits 0 iff both properties hold, and never runs the pipeline over the spine it gates: `{VerifyRecheckCommandName}` is the command that does.", audience: CommandAudience.workingOnTheCompiler)
		version gives CommandReference.create(VersionCommandName, arguments: "", summary: "Print the version, the commit it was built from and the host target.", detail: "It runs nothing, and goes to stdout, where a pipe can reach it.", audience: CommandAudience.usingTheCompiler)
		unknown throws HelpReferenceError.notACommand
	end 'whichCommand'
end 'commandReference'

// The options this reference lists, in the order it lists them.
//
// ⚠ **NOT EVERY FLAG THE PARSER ACCEPTS.** `--worker-persistent` is how a pool worker is told that it is
// one — set by the parent on the command line it spawns, never typed by a person — and a flag nobody can
// usefully type is not part of the surface this describes. It is PARSED all the same, because an
// unrecognized flag aborts the run and a worker that could not read its own would fail to start.
enum HelpOption
	output
	emitIr
	emitIrRuntime
	target
	noDebugInfo
	coverageInstrumentation
	define
	metrics
	specFilter
	updateRequired
	network
	workers
	rungs
	repeat
	note
	emitCorpus
	resultJson
	testFilter
	testList
	testJson
	testIsolate
	testBail
	testTimeout
	testNoTiming
	testColor
end 'HelpOption'

// One option's entry. ⭐ **THE COMMANDS ARE A FIELD, NOT A `(build, test)` PREFIX ON THE SENTENCE**,
// because they decide where the option is PRINTED: it is listed under each command that reads it, so
// `maxon help <command>` is that command's whole surface and a reader never filters a global list.
type OptionReference
	export var spelling as String
	export var description as String
	export var commands as MaxonCommandArray

	export static function create(spelling String, description String, commands MaxonCommandArray) returns OptionReference
		return Self{spelling: spelling, description: description, commands: commands}
	end 'create'
end 'OptionReference'

// ⭐ **EVERY SPELLING IS THE CONSTANT THE PARSER MATCHES**, never a copy of it typed here: a flag renamed
// at its declaration is renamed in the reference by the same edit, and cannot go on being documented
// under a name nothing accepts.
function optionReference(option HelpOption) returns OptionReference
	return match option 'whichOption'
		output gives OptionReference.create("{OutputFlagName}, {OutputFlagPrefix}<path>", description: "Output executable path (default: derived from input).", commands: [MaxonCommand.build])
		emitIr gives OptionReference.create(EmitIrFlag, description: "Also write the lowered Target IR beside the exe as <output>.ir.", commands: [MaxonCommand.build])
		emitIrRuntime gives OptionReference.create("{EmitIrRuntimeFlagPrefix}<a>,<b>", description: "Render these compiler-emitted functions in that IR too. A list of functions to print is a request for the printing, so it implies {EmitIrFlag}.", commands: [MaxonCommand.build])
		target gives OptionReference.create("{TargetFlagPrefix}<cpu>-<os>", description: "Use this target instead of the host, one of: {supportedTargetList()} (default: the host target). For {SpecTestCommandName} a cross target cross-compiles each selected test and runs it under the vendored runtime. For {TestCommandName} it builds the test binary for that target and then SPAWNS it, so a target this host cannot execute reports every test as not run.", commands: [MaxonCommand.build, MaxonCommand.specTest, MaxonCommand.test])
		noDebugInfo gives OptionReference.create(NoDebugInfoFlag, description: "Do NOT write the <output>.mxdbg debug-info sidecar. It is written BY DEFAULT, and the executable is byte-identical either way: the sidecar never decides which instructions are emitted, so the binary you debug is the binary you shipped.", commands: [MaxonCommand.build])
		coverageInstrumentation gives OptionReference.create(CoverageFlag, description: "Instrument for code coverage: the binary counts each statement and branch arm it executes and writes them to <output>{MxcovDataExtension} as it exits. It CHANGES the emitted code, so it is a separate build; read it back with `{CoverageCommandName}`. It requires the debug-info sidecar, which carries what each counter counts.", commands: [MaxonCommand.build])
		define gives OptionReference.create("{DefineFlagPrefix}<name>{DefineNameValueSeparator}<value>", description: "Replace a top-level `String` constant's written-out default. The VALUE may contain `{DefineNameValueSeparator}` and the name may not, so the split is at the first one.", commands: [MaxonCommand.build])
		metrics gives OptionReference.create("{MetricsFlagPrefix}<path>", description: "Write this compile's per-phase time + memory attribution to <path> as TSV. `--log=compiler:debug` prints the same numbers as a human-readable table.", commands: [MaxonCommand.build])
		specFilter gives OptionReference.create("{FilterFlagPrefix}<pattern>", description: "Run only tests whose `<spec>/<test>` label contains <pattern>. A bare spec name selects that whole spec.", commands: [MaxonCommand.specTest])
		updateRequired gives OptionReference.create(UpdateRequiredFlag, description: "Rewrite the committed .test goldens instead of checking against them. Running a test proves its allocation is CORRECT; only the pinned IR proves the code did not get WORSE. REVIEW THE RESULTING DIFF. Pair it with {FilterFlagPrefix}: an unfiltered run rewrites EVERY golden in the suite.", commands: [MaxonCommand.specTest])
		network gives OptionReference.create(NetworkFlag, description: "Also run the cases marked `{NetworkMarker} {NetworkLiveValue} -->`, which open a socket to a REAL EXTERNAL HOST. They are OUT of a default run because their verdict measures somebody else's uptime rather than this compiler; a default run NAMES every one it left out.", commands: [MaxonCommand.specTest])
		workers gives OptionReference.create("{WorkersFlagPrefix}<n>", description: "Run the suite on <n> persistent worker subprocesses (default {defaultWorkerCount()}, this machine). 1 is this same pool with one worker in it, NOT a serial path: every worker count must print BYTE-IDENTICAL output, and that invariance is the pool's sharpest gate.", commands: [MaxonCommand.specTest])
		rungs gives OptionReference.create("{RungsFlagPrefix}<n>", description: "Climb <n> rungs (default {DefaultRungCount}, range {MinRungCount}-{MaxRungCount}). Each rung DOUBLES the program, so this is exponential in cost.", commands: [MaxonCommand.scaleTest])
		repeat gives OptionReference.create("{RepeatFlagPrefix}<n>", description: "Compile every rung <n> times (default {DefaultRepeatCount}, range {MinRepeatCount}-{MaxRepeatCount}) and report the LEAST CPU ticks any of them spent in each phase, the least-disturbed sample:  noise can only ADD to a CPU reading and a mean would be dragged by one stall. The MEMORY columns take nothing from a repeat: they are exact, so they come from the first compile and are CROSS-CHECKED for equality against the rest. A memory number that differs between two compiles of one rung is a BROKEN RUN.", commands: [MaxonCommand.scaleTest])
		note gives OptionReference.create("{NoteFlagPrefix}<text>", description: "Record this run in {OptimizationLogRelativePath}: one dated row of the per-rung allocations and bytes, with <text> as the reason. Without it a run reports and records nothing; WITH it the row is written, moved or not, because it is an INSTRUCTION. The instrument can see exactly WHAT moved and can never see why; you are the only one who knows, and only now.", commands: [MaxonCommand.scaleTest])
		emitCorpus gives OptionReference.create("{EmitCorpusFlagPrefix}<dir>", description: "Dump the generated corpus to <dir> for inspection (it is otherwise built into a temp dir and thrown away).", commands: [MaxonCommand.scaleTest])
		resultJson gives OptionReference.create("{ResultJsonFlagPrefix}<path>", description: "Write the whole run (per-rung and per-phase memory, and the deltas from the last recorded run) to <path> as JSON, so a tool never has to scrape the human report.", commands: [MaxonCommand.scaleTest])
		testFilter gives OptionReference.create("{TestFilterShortFlag} P, {TestFilterShortPrefix}P, {FilterFlagPrefix}P", description: "Run only tests whose NAME or FILE contains P (case-insensitive; comma-separated patterns are a union).", commands: [MaxonCommand.test])
		testList gives OptionReference.create(TestListFlag, description: "Print the tests that would run and compile nothing.", commands: [MaxonCommand.test])
		testJson gives OptionReference.create(TestJsonFlag, description: "Emit the report as JSON instead of text.", commands: [MaxonCommand.test])
		testIsolate gives OptionReference.create(TestIsolateFlag, description: "Run every test in its own process, rather than one process per test FILE.", commands: [MaxonCommand.test])
		testBail gives OptionReference.create("{TestBailFlag}, {TestBailFlagPrefix}N", description: "Stop claiming new work after N failures (default {DefaultBailAfter}); the shard already running finishes, so the total may exceed N.", commands: [MaxonCommand.test])
		testTimeout gives OptionReference.create("{TestTimeoutFlagPrefix}<ms>", description: "Kill a test process after <ms> milliseconds (default {DefaultTestTimeoutMs}). A whole file shares one process, so {TestIsolateFlag} is what gives each test the full budget to itself.", commands: [MaxonCommand.test])
		testNoTiming gives OptionReference.create(TestNoTimingFlag, description: "Omit durations, making stdout byte-reproducible.", commands: [MaxonCommand.test])
		testColor gives OptionReference.create("{TestColorFlagPrefix}{reportColorChoices()}", description: "Colour the report; `auto` means only when stdout is a terminal: not redirected, NO_COLOR unset, TERM not `dumb`. Only wasm32-wasi cannot detect a terminal; there `auto` degrades to `never`, so use `always` to force colour.", commands: [MaxonCommand.test])
	end 'whichOption'
end 'optionReference'

// The commands in declaration order, with `unknown` — which names none — left out. Every walk over the
// roster comes through here, so the skip is stated ONCE and a printer cannot forget it.
function namedCommands() returns MaxonCommandArray
	var named = MaxonCommandArray.create()
	for command in MaxonCommand.allCases 'eachCase'
		if command != MaxonCommand.unknown 'itNamesACommand'
			named.push(command)
		end 'itNamesACommand'
	end 'eachCase'

	return named
end 'namedCommands'

// The commands written for one audience, still in declaration order — which is alphabetical, so a
// filtered run is sorted for free and no listing has to sort anything.
function commandsFor(audience CommandAudience) returns MaxonCommandArray
	var selected = MaxonCommandArray.create()

	for command in namedCommands() 'eachCommand'
		let reference = try commandReference(command) otherwise panic("commandsFor: `namedCommands` leaves `unknown` out, so every command reaching here has a reference")
		if reference.audience == audience 'thisAudience'
			selected.push(command)
		end 'thisAudience'
	end 'eachCommand'

	return selected
end 'commandsFor'

// The command a word selects — the roster read backwards, and the whole of how `MaxonArgs.parse` decides
// that an argument is a command rather than a path.
//
// ⭐ `unknown` is this enum's own name for "no command", so returning it is the ANSWER and not a
// sentinel: it is exactly the value the parser leaves the field at when no command word was typed.
function commandFromWord(word String) returns MaxonCommand
	for command in namedCommands() 'eachCommand'
		let reference = try commandReference(command) otherwise panic("commandFromWord: `namedCommands` leaves `unknown` out, so every command reaching here has a reference")
		if reference.word == word 'thisOne'
			return command
		end 'thisOne'
	end 'eachCommand'

	return MaxonCommand.unknown
end 'commandFromWord'

// ⭐⭐ **NOTHING IN THIS REFERENCE IS LAID OUT BY HAND.** One label column and one prose width, and every
// row — command or option — is wrapped from them. A hand-padded table goes ragged the day a label
// outgrows the column and nothing says so, and the labels here are DERIVED: one names the colour modes,
// another the supported targets, and both grow. An overlong label takes its own line and its prose
// starts square underneath.
function printHelpEntry(label String, text String)
	if text.trim().isEmpty() 'noProse'
		panic("printHelpEntry: '{label}' has no description, and every command and option in the reference owes the reader one")
	end 'noProse'

	let indent = padRight("", width: UsageEntryColumnWidth)
	var firstPrefix = padRight(label, width: UsageEntryColumnWidth)

	// ⚠ BYTES here and GRAPHEMES in the wrap, and the difference is not an oversight: this asks the same
	// question `padRight` answered on the line above, and that one counts bytes. The prose asks a
	// different question — how wide the line LOOKS — where an em-dash is one column and three bytes.
	if label.byteLength() >= UsageEntryColumnWidth 'theLabelFillsItsColumn'
		print("{label}\n")
		firstPrefix = indent
	end 'theLabelFillsItsColumn'

	printWrappedProse(text, firstPrefix: firstPrefix, indent: indent)
end 'printHelpEntry'

// Prose broken to `UsageLineWidth` columns, every line after the first opened with `indent` — which is
// also what sets the measure, since an indented line has that much less room. Paragraphs are separated
// by `ParagraphSeparator` and each starts a line of its own.
function printWrappedProse(text String, firstPrefix String, indent String)
	let width = UsageLineWidth - indent.count()
	var prefix = firstPrefix

	for paragraph in text.split(ParagraphSeparator) 'eachParagraph'
		var line = ""

		for word in paragraph.split(WordSeparator) 'eachWord'
			if word.isEmpty() 'aRunOfSpaces'
				continue
			end 'aRunOfSpaces'

			if line.isEmpty() 'theFirstWordOfALine'
				line = word
			end 'theFirstWordOfALine' else if line.count() + word.count() + WordSeparator.count() <= width 'itFits'
				line = "{line}{WordSeparator}{word}"
			end 'itFits' else 'itWrapsHere'
				print("{prefix}{line}\n")
				prefix = indent
				line = word
			end 'itWrapsHere'
		end 'eachWord'

		if not line.isEmpty() 'theLastLineOfTheParagraph'
			print("{prefix}{line}\n")
			prefix = indent
		end 'theLastLineOfTheParagraph'
	end 'eachParagraph'
end 'printWrappedProse'

// ⭐ **WHAT `maxon` WITH NO ARGUMENTS SAYS**: which binary this is, and one line per command. It is the
// answer to the only question a caller with nothing to go on can ask, so it is SHORT — the reference
// itself is one of the commands listed, and the footer names it.
function printOverview()
	print("{versionLine()}\n")
	print("\n")
	printCommandList()
end 'printOverview'

// The list alone — what the overview prints under the version line, and what every refusal in `main`
// prints under its error. A refusal owes the reader the way back, and the way back is what this binary
// does plus the word that opens the rest of it.
function printCommandList()
	print("Usage: maxon <command> [options]\n")
	print("\n")
	print("Commands:\n")

	for command in commandsFor(CommandAudience.usingTheCompiler) 'eachCommand'
		let reference = try commandReference(command) otherwise panic("printCommandList: `namedCommands` leaves `unknown` out, so every command reaching here has a reference")
		printHelpEntry("  {reference.label()}", text: reference.summary)
	end 'eachCommand'

	print("\n")
	// ⚠ **IT SAYS THAT SOMETHING IS NOT SHOWN.** A short list that quietly omitted the commands for
	// working on the compiler would leave a reader who needs `{SpecTestCommandName}` with no reason to
	// look further; naming the omission is what makes the list short rather than incomplete.
	printWrappedProse("Run `maxon {HelpCommandName}` for every command's options (including the ones for working on the compiler itself), or `maxon {HelpCommandName} <command>` for one command's.", firstPrefix: "", indent: "")
end 'printCommandList'

// One command's whole reference: what it does, and every option it reads, indented under it.
function printCommandSection(command MaxonCommand)
	let reference = try commandReference(command) otherwise panic("printCommandSection: `unknown` names no command, and every caller resolves a word to a real one first")
	printHelpEntry(reference.label(), text: reference.description())

	for option in HelpOption.allCases 'eachOption'
		let entry = optionReference(option)
		if entry.commands.contains(command) 'thisCommandReadsIt'
			printHelpEntry("  {entry.spelling}", text: entry.description)
		end 'thisCommandReadsIt'
	end 'eachOption'
end 'printCommandSection'

// The whole reference: every command, with its options under it, the two audiences in two runs. NOTHING
// is left out here — this is where a command the short list does not show is found.
function printFullReference()
	print("Usage: maxon <command> [options]\n")
	printReferenceRun(CommandAudience.usingTheCompiler, heading: "")
	printReferenceRun(CommandAudience.workingOnTheCompiler, heading: CompilerWorkHeading)
end 'printFullReference'

// One audience's run of sections, under its heading. An EMPTY heading prints none, which is the first
// run: it is what this binary is for, and a heading over it would be labelling the default.
function printReferenceRun(audience CommandAudience, heading String)
	if not heading.isEmpty() 'itIsHeaded'
		print("\n")
		print("{heading}\n")
	end 'itIsHeaded'

	for command in commandsFor(audience) 'eachCommand'
		print("\n")
		printCommandSection(command)
	end 'eachCommand'
end 'printReferenceRun'

function helpUsageLine() returns String
	return "maxon {HelpCommandName} [<command>]"
end 'helpUsageLine'

// ⭐⭐ **`maxon help [<command>]` — THE REFERENCE, AND THE ONLY DOOR ONTO IT.** A command rather than a
// flag, so that it is listed with everything else this binary does and a caller who has only ever run
// `maxon` has already been told that it exists.
//
// ⚠ **IT TAKES NO OPTIONS, AND REFUSES THROUGH `anyOption` RATHER THAN `badOption`** — the door `fmt`
// uses, and for one half of its reason: `badOption` never sees a flag this driver DOES implement, so
// `maxon --emit-ir help` would otherwise print the reference as though the flag had meant something.
function runHelp(args MaxonArgs) returns ExitCode
	if not args.anyOption.isEmpty() 'refusedOption'
		printError("error: {HelpCommandName} takes no options: {args.anyOption}\n")
		printError("Usage: {helpUsageLine()}\n")
		return 1
	end 'refusedOption'

	if refusedPositionalBeyond(args, allowed: 1, usage: helpUsageLine()) 'unexpectedArgument'
		return 1
	end 'unexpectedArgument'

	let named = args.solePositional()
	if named.isEmpty() 'theWholeReference'
		printFullReference()
		return 0
	end 'theWholeReference'

	let command = commandFromWord(named)
	if command == MaxonCommand.unknown 'noSuchCommand'
		printError("error: unknown command: {named}\n")
		printCommandList()
		return 1
	end 'noSuchCommand'

	printCommandSection(command)
	return 0
end 'runHelp'

// ⭐⭐ **NOTHING TYPED IS A QUESTION, NOT AN ERROR.** `maxon` alone is what a caller runs to find out what
// this binary is, so it ANSWERS — the version and the command list — and exits 0. A word that names no
// command, or an option with no command to apply it to, is a mistake and is reported as one: the same
// list, under an error on stderr, exit 1.
function noCommandGiven(args MaxonArgs) returns ExitCode
	if args.paths.isEmpty() and args.anyOption.isEmpty() 'nothingWasTyped'
		printOverview()
		return 0
	end 'nothingWasTyped'

	if args.paths.isEmpty() 'anOptionWithNoCommand'
		printError("error: no command given, and {args.anyOption} names an option rather than one\n")
	end 'anOptionWithNoCommand' else 'aWordThatNamesNoCommand'
		printError("error: unknown command: {args.solePositional()}\n")
	end 'aWordThatNamesNoCommand'

	printCommandList()
	return 1
end 'noCommandGiven'

// The parsed command the driver dispatches on.
// ⭐⭐ **DECLARATION ORDER IS THE ORDER THE READER SEES, AND IT IS ALPHABETICAL BY COMMAND WORD.**
// `namedCommands` walks `allCases`, so this list IS the listing `maxon` prints — and the one ordering
// rule a gate can check is the one that holds: `tests/cli` asserts the advertised list is sorted, off
// the binary's own output. An order by how often a command is used could not be checked by anything,
// and is not one fact anyway — a compiler developer runs `spec-test` fifty times a day and `build`
// twice, and someone using Maxon does the reverse.
//
// ⚠ Nothing reads a case's ordinal or raw value, so this order decides the listing and nothing else.
enum MaxonCommand
	build
	// `maxon coverage <run|report> <exe>` — read back what a `--coverage` binary counted. Tail-stopping
	// like `monitor`, and for the sharper form of its reason: the tail is a CHILD's command line.
	coverage
	// `maxon debug --dump-info <exe>` / `--symbolize <exe> <offset...>` — the read-only faces of the
	// `.mxdbg` sidecar. Tail-stopping like `monitor`; see `DebugCommandName`.
	debug
	// `maxon fmt` - re-print `.maxon` sources in canonical layout, IN PLACE. See `runFmt`.
	fmt
	// `maxon help [<command>]` — the reference this driver prints about itself. See `runHelp`; the
	// withdrawn flag spellings for the same question are refused by name at `WithdrawnHelpFlag`.
	help
	lspServer
	// `maxon monitor` — run a `--debugstream` binary with a DebugStream ring attached and print the
	// events it writes into it. The one command whose TAIL belongs to a child process rather than to this
	// driver; see the `monitorTail` arm in `parse`.
	monitor
	// `maxon profile run <exe>` — sample a running program and report where its CPU time went. Tail-stopping
	// like `coverage`, and for exactly its reason: the tail is a CHILD's command line.
	profile
	scaleTest
	specTest
	// `maxon test` — a PROJECT's own unit tests, which is a different suite from `spec-test`'s: that one
	// runs this compiler's specs, this one runs whatever the directory it is pointed at declares.
	test
	verifyRecheck
	verifyWarmRebuild
	// `maxon version` — which binary is this. See `runVersion`; the withdrawn flag spellings for the same
	// question are refused by name at `WithdrawnVersionFlag`.
	version
	// ⛔ NOT A COMMAND and therefore not in the sorted run above: it is the ABSENCE of one, which is why
	// `namedCommands` leaves it out of every listing. See `HelpReferenceError`.
	unknown
end 'MaxonCommand'

// The positional arguments AS TYPED — source path SPELLINGS, not yet `FilePath`s, because a spelling
// that is not a valid path is a command-line error the driver reports with the text the caller wrote.
// A distinctly-named alias rather than `Project.StringArray` for the reason `MaxonSourcePathArray`
// gives next door: a name that says what the list is FOR cannot be confused with the several other
// `Array with String` aliases this compiler already carries.
export typealias SourcePathSpellingArray = Array with String

// Thin M1 argument model: a command, its input paths, an optional output override,
// and the `--emit-ir` toggle. Grows into v1's full option set (targets, logging,
// cache flags, ...) as the driver gains those capabilities.
// Exported: the scale-test runner lives in Testing/ and takes the parsed args, exactly as the
// spec-test runner takes them from inside Main.
module type MaxonArgs
	export var command as MaxonCommand
	// ⭐⭐ **EVERY POSITIONAL, IN THE ORDER TYPED (A3m).** `build` compiles them all and the ORDER is
	// load-bearing — `Compiler.loadSourceFiles` registers sources in exactly this order, which is how
	// a caller states which of two sibling files declares first without the loader ever sorting (see
	// that function, and `StdlibLoader`'s no-sort ruling). Every other command takes at most one and
	// `refusedPositionalBeyond` says so; before A3m the parser kept the first and dropped the rest
	// here, silently, without even setting `badOption`.
	export var paths as SourcePathSpellingArray
	export var outputOverride as String
	export var emitIr as bool
	// Whether this build emits the green-thread async trace (`--async-trace`). See `AsyncTraceFlag`.
	export var asyncTrace as bool
	// Whether this build emits the DebugStream producer (`--debugstream`). See `DebugStreamFlag`.
	export var debugStream as bool
	// Whether this build writes the `<output>.mxdbg` sidecar. TRUE unless `--no-debug-info` was typed —
	// see that flag for why the default is on. Read only by `build`.
	export var debugInfo as bool
	// Whether this build instruments for code coverage (`--coverage`). See that flag. Read only by
	// `build`, which refuses it against `debugInfo` and against a target with no file surface.
	export var coverage as bool
	// `--emit-ir-runtime=<name>,<name>` (build only): the compiler-EMITTED functions the IR sidecar
	// must ALSO render. EMPTY is the ordinary build and is the literal count of names given, not a
	// sentinel. It IMPLIES `--emit-ir` (see `parse`), because a list of functions to print is a
	// request for the printing.
	export var runtimeIrNames as RuntimeFunctionNameArray
	// `--filter=<pattern>` (spec-test only): run only the tests whose `<spec>/<test>` label
	// contains <pattern>. Empty selects the whole suite.
	export var filter as String
	// `--update-required` (spec-test only): REWRITE the committed `.test` goldens instead of
	// checking the emitted IR against them. The goldens are a code-quality gate — running a test
	// proves its allocation is CORRECT, but only the pinned IR can say the code did not get WORSE
	// (an extra spill still computes the right answer). So regenerating them is the one way a
	// codegen change enters the tree, and it is deliberately an explicit act: the diff is the review.
	export var updateRequired as bool
	// `--workers=<n>` (spec-test only): how many persistent worker subprocesses the pool runs. 1 is
	// the SAME pool with one worker in it, not a serial in-process branch — see runSpecTest.
	export var workers as WorkerCount
	// ⚠ Whether a `--workers=` was typed on this command line. Read by the delegated Linux lane
	// (`SpecTestRunner.spawnGuestSuite`), which forwards the flag only when it was: the field above
	// cannot answer that, because a typed count is free to equal the default this host computed.
	export var workersOverridden as bool
	// `--worker-persistent` (spec-test only, INTERNAL): this process IS a pool worker. Set by the
	// parent dispatcher on the command line it spawns, never typed by a person, and therefore left
	// out of the usage text. Undocumented but PARSED: an unrecognized flag aborts the run, so a
	// worker whose own flag was not understood would fail to start at all.
	export var workerPersistent as bool
	// `--metrics=<path>` (build only): write this compile's per-phase time + memory attribution as
	// TSV to <path> (see MetricsEmit). The scale-test harness reads it back; a human wants
	// `--log=compiler:debug`, which prints the same numbers as a table.
	// Every `--define` on this command line, in the order they were written. An ARRAY and not a map:
	// two defines of one name is a thing to notice, and a map would silently keep the last.
	export var defines as DefineArray

	export var metricsPath as String
	// `--emit-corpus=<dir>` (scale-test only): dump the generated scaling corpus to <dir> for
	// inspection instead of the temp directory it is otherwise built into and thrown away.
	export var emitCorpus as String
	// `--rungs=<n>` (scale-test only): how many rungs of the ladder to climb. Each doubles the
	// program, so this is exponential in cost — see ScaleCorpus.
	export var rungs as RungCount
	// `--repeat=<n>` (scale-test only): how many times each rung is compiled. The CPU column takes
	// the MINIMUM of the repeats (the least-disturbed sample); the memory columns take the first and
	// are cross-checked for equality across the rest, since they are bit-for-bit reproducible and a
	// difference is a broken run — see ScaleTestRunner's header.
	export var repeat as RepeatCount
	// `--note=<text>` (scale-test only): RECORD this run in docs/optimization-log.md, with <text> as
	// the reason. A run without it reports and records nothing — scale-test is run dozens of times a
	// day against dirty trees, and a log of all of them would be a log nobody reads. WITH it the row is
	// written, whether or not a number moved: it is an INSTRUCTION from the operator, who is the only
	// party who knows whether the run is a datapoint. The instrument can see exactly WHAT moved and can
	// never see why, so the reason is demanded at the one moment it is still known — see
	// Testing/ScaleHistory.maxon.
	export var note as String
	// `--result-json=<path>` (scale-test only): write the run's full result — per-rung and per-phase
	// memory, and the deltas from the last recorded run — as JSON.
	//
	// This exists so the MCP tool does not SCRAPE the human report. The report's columns are padded
	// to be read by a person; the day a phase name outgrows its column, a scrape would silently
	// mis-parse rather than fail. A caller that wants data gets data.
	export var resultJson as String
	// `--target=<cpu>-<os>` (build, spec-test): use this target instead of the host
	// (`detectHostTarget`). Empty selects the host. Resolved to a Target via `resolveTargetFlag` in
	// both `runBuild` and `runSpecTest`; an unknown spelling aborts. Needed to cross-compile
	// x64-windows on an arm64 host for golden verification, to select arm64-macos explicitly, and to
	// drive the spec suite through the wasm32-wasi backend (cross-compile-and-run under wasmtime).
	export var targetSpec as String
	// Whether this spec run may reach a real external host (`--network`). FALSE by default, and the
	// default is the whole point — see `NetworkFlag`.
	export var includeNetwork as bool
	// `--list` (test only): print the tests that WOULD run and compile nothing.
	export var listOnly as bool
	// `--json` (test only): emit the report as one JSON document instead of text.
	export var jsonReport as bool
	// `--no-timing` (test only): omit durations, which is what makes a run's stdout byte-reproducible.
	// TRUE by default — the flag turns it off, so the field reads as what it controls rather than as
	// the flag's own name.
	export var showTiming as bool
	// `--color=` (test only): when the report may use colour. See `TestRender.ReportColorMode` — `auto`
	// is the default and asks the host through `__Builtins.stdoutWantsAnsiColor()`.
	export var colorMode as ReportColorMode
	// `--isolate` (test only): run every test in its own process, rather than a process per FILE.
	export var isolate as bool
	// `--bail[=N]` (test only): stop claiming new work once N tests have failed.
	export var bail as BailPolicy
	// `--timeout=<ms>` (test only): how long ONE test process may run before it is killed.
	export var testTimeoutMs as DurationMs
	// ⚠ Whether a `--log=` was accepted on this command line. Read by `test` alone, which SILENCES the
	// compiler's INFO chatter so its stdout is a report rather than a build log — and must not do that
	// behind the back of a caller who asked for the chatter. A bool and not the spec string: the spec was
	// already applied by `parseLogOption`, and keeping it would be that setting stored twice.
	export var logOverridden as bool
	// Set when an argument could not be understood. The driver refuses to run rather
	// than proceed on a command line it only partly parsed — see `parse`.
	// ⛔⛔ **EVERY `-`-LEADING ARGUMENT, RECORDED REGARDLESS OF WHICH ARM CONSUMES IT OR WHERE IT SAT.**
	// `badOption` below is only the ones NO arm understood, and it is set from INSIDE the arm chain — so
	// it can never see a flag this driver DOES implement. That is fatal for `fmt`, whose whole contract
	// is that it takes no options: MEASURED before this field existed, `maxon --emit-ir fmt` set
	// `emitIr`, left `badOption` empty, and FORMATTED THE CURRENT DIRECTORY IN PLACE, exit 0 — the exact
	// incident the refusal exists to prevent.
	//
	// ⚠ **A COMMAND-GATED ARM CANNOT FIX THAT, AND THE FIRST ATTEMPT WAS ONE.** This parser is
	// ORDER-INDEPENDENT, so an arm asking `command == fmt` sees nothing when the flag is typed AHEAD of
	// the word `fmt`. Recorded above the chain instead, unconditionally — the one site no ordering can
	// reach around.
	export var anyOption as String
	export var badOption as String
	// ⭐ Set when an argument names an option this driver ONCE HAD and deliberately withdrew. A
	// separate field from `badOption` because the two owe the reader different sentences and `main`
	// prints them in different words: an unknown option was never understood, a withdrawn one was and
	// is now structurally impossible. See `withdrawnOptionMessage`.
	export var withdrawnOption as String

	// ⭐ **THE COMMAND LINE WITH NOTHING ON IT** — every field at the value an absent flag leaves it.
	// The defaults live here, in ONE place, rather than in `parse`'s locals: `parse` accumulates into a
	// record precisely so that it HAS no per-flag local (see its own note), and a default written at the
	// declaration is a default no arm can forget to carry through.
	//
	// ⚠ **EVERY FIELD ABOVE IS `var` FOR THAT ONE CALLER.** Nothing else mutates a `MaxonArgs`, and
	// nothing can through the `let` binding `main` holds it by (E3063) — the tier states who may write,
	// and the binding states whether anyone does.
	export static function create() returns MaxonArgs
		return Self{command: MaxonCommand.unknown, paths: SourcePathSpellingArray.create(), outputOverride: "", emitIr: false, asyncTrace: false, debugStream: false, debugInfo: true, coverage: false, runtimeIrNames: RuntimeFunctionNameArray.create(), filter: "", updateRequired: false, workers: defaultWorkerCount(), workersOverridden: false, workerPersistent: false, metricsPath: "", defines: DefineArray.create(), emitCorpus: "", rungs: DefaultRungCount, repeat: DefaultRepeatCount, note: "", resultJson: "", targetSpec: "", includeNetwork: false, listOnly: false, jsonReport: false, showTiming: true, colorMode: ReportColorMode.auto, isolate: false, bail: BailPolicy.never, testTimeoutMs: DefaultTestTimeoutMs, logOverridden: false, anyOption: "", badOption: "", withdrawnOption: ""}
	end 'create'

	// The one positional a command that takes at most one was given, or "" when there was none —
	// the same "empty means absent" convention every other optional field here uses
	// (`outputOverride`, `filter`, `note`). A SECOND positional never reaches this: the
	// commands that read it call `refusedPositionalBeyond` first, so empty cannot mean two things.
	export function solePositional() returns String
		return try self.paths.get(0) otherwise ""
	end 'solePositional'

	// Parse the process command line. argv[0] is the executable path (skipped).
	// The FIRST command word selects the command and every later one is an ordinary
	// positional (see `laterCommandWordIsAPath`); every bare (non-flag)
	// argument is KEPT, in order, as a positional; `-o <path>` / `--output=<path>` set the output;
	// `--emit-ir` requests the Target-IR sidecar; `--filter=<pattern>` narrows the
	// spec-test selection; `--update-required` regenerates the spec-test goldens.
	//
	// An unrecognized `-`-leading argument is RECORDED, not ignored. It used to fall
	// through to the positional branch and become the input path, so `spec-test
	// --mm-trace` quietly looked for a spec directory literally named `--mm-trace`
	// and reported an empty suite. A flag the driver does not implement must fail
	// loudly, not be absorbed into an unrelated slot.
	export static function parse() returns MaxonArgs
		// ⚠ **THE WORKING SET IS ONE RECORD BECAUSE TWENTY-ONE `var`s DO NOT FIT IN x64's REGISTERS**
		// (`E5001`). A `var` assigned in one arm of this chain is handed on at every join, so each one
		// becomes a phi on the loop header and the loop carries a register per flag — MEASURED at 33
		// values live against 14 GPRs, which is a refusal, not a slowdown. `parsed.filter = …` is a FIELD
		// STORE into one frame slot, so the loop carries ONE value however many flags are added below.
		// ⇒ Adding a flag means adding a FIELD, never a local.
		//
		// ⚠ **AND A GREEN SUITE ON ANOTHER HOST WOULD NOT HAVE CAUGHT IT.** The refusal is x64's alone:
		// arm64 allocates from 26 GPRs and fits a shape x64's 14 cannot, which is why
		// `specs/register-pressure.md`'s `assigned-only-loop-carried-vars-overflow` — the smaller
		// twin of this loop — carries `targets: x64-windows, x64-linux`.
		var parsed = Self.create()

		let args = CommandLine.args()
		var i = 1
		while i < args.count() 'each'
			let arg = try args.get(i) otherwise panic("MaxonArgs.parse: index {i} >= args.count() despite the while guard i<args.count()")

			// Recorded BEFORE the chain decides anything, so it sees a flag whichever arm goes on to consume
			// it and wherever on the line it sat. See `anyOption`.
			if arg.startsWith(OptionPrefix) 'anOption'
				parsed.anyOption = firstBadOption(parsed.anyOption, arg: arg)
			end 'anOption'

			// ⭐⭐ **`monitor` STOPS THE PARSE, AND THAT IS THE WHOLE OF HOW A CHILD'S COMMAND LINE SURVIVES
			// THIS DRIVER.** The arms below are order-independent, so a child's `--filter=mm` would be read as
			// `spec-test`'s TEST SELECTION and any flag this driver does not implement would set `badOption`
			// and abort the run before the child was ever spawned. Everything after the word is filed as a
			// positional verbatim instead, and `anyOption` never sees one of them.
			//
			// ⚠ **ONLY THE FIRST COMMAND WORD IS THE COMMAND**, exactly as the restore block below enforces
			// for every other one: a `monitor` typed after a command already chosen is an ordinary path, which
			// is what asking that none has been chosen yet says.
			if arg == MonitorCommandName and parsed.command == MaxonCommand.unknown 'monitorCmd'
				parsed.command = MaxonCommand.monitor
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'monitorCmd'

			// `debug` stops the parse for the same reason `monitor` does — its own subcommand words are
			// `-`-leading, and every one of them would otherwise abort the run as an unknown option.
			if arg == DebugCommandName and parsed.command == MaxonCommand.unknown 'debugCmd'
				parsed.command = MaxonCommand.debug
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'debugCmd'

			// `coverage` stops the parse for `monitor`'s reason in its strongest form: `coverage run <exe>
			// <the target's own flags>` forwards everything past the executable to a CHILD, so a flag this
			// driver happens to implement would be consumed on its way past and one it does not would set
			// `badOption` and abort the run before the child was ever spawned.
			if arg == CoverageCommandName and parsed.command == MaxonCommand.unknown 'coverageCmd'
				parsed.command = MaxonCommand.coverage
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'coverageCmd'

			// `profile` stops the parse for `coverage`'s reason exactly: everything after the executable is
			// the profiled program's own command line.
			if arg == ProfileCommandName and parsed.command == MaxonCommand.unknown 'profileCmd'
				parsed.command = MaxonCommand.profile
				parsed.paths = monitorTail(args, from: i + 1)
				break
			end 'profileCmd'

			// The command as it stood BEFORE this argument, so the arms below can stay a plain chain and
			// the first-word rule be applied once, after them. See `laterCommandWordIsAPath`.
			//
			// ⚠ **CLEARED, NOT MERELY REMEMBERED**, so that an arm firing below is detectable even when it
			// re-selects the command already chosen. `maxon fmt fmt` is exactly that shape, and it is
			// the destructive one: comparing the command before and after would read it as no change at
			// all. Nothing between here and the restore reads the field.
			let commandBefore = parsed.command
			parsed.command = MaxonCommand.unknown

			// ⭐⭐ **ONE TABLE DECIDES WHICH WORDS ARE COMMANDS, AND THE REFERENCE READS THAT SAME TABLE**
			// (`commandReference`, through `commandFromWord`). A chain of literals here would be a second
			// roster: a command word could be renamed in one and go on being printed by the other, and a
			// command added to `MaxonCommand` could be documented without ever being selectable.
			//
			// ⚠ The four tail-stopping words never reach this arm with the parse still open — each is
			// consumed above while the command is still `unknown` — so recognizing them here is what makes
			// a LATER one an ordinary path through the restore block below, exactly as every other command
			// word is.
			let named = commandFromWord(arg)
			if named != MaxonCommand.unknown 'commandWord'
				parsed.command = named
			end 'commandWord' else if arg == OutputFlagName 'dashOutput'
				i = i + 1
				parsed.outputOverride = try args.get(i) otherwise ""
			end 'dashOutput' else if arg.startsWith(OutputFlagPrefix) 'longOutput'
				parsed.outputOverride = try CommandLine.optionValue(arg) otherwise ""
			end 'longOutput' else if arg == EmitIrFlag 'emitIrFlag'
				parsed.emitIr = true
			end 'emitIrFlag' else if arg == AsyncTraceFlag 'asyncTraceFlag'
				parsed.asyncTrace = true
			end 'asyncTraceFlag' else if arg == DebugStreamFlag 'debugStreamFlag'
				parsed.debugStream = true
			end 'debugStreamFlag' else if arg == NoDebugInfoFlag 'noDebugInfoFlag'
				parsed.debugInfo = false
			end 'noDebugInfoFlag' else if arg == CoverageFlag 'coverageFlag'
				parsed.coverage = true
			end 'coverageFlag' else if arg.startsWith(EmitIrRuntimeFlagPrefix) 'emitIrRuntimeFlag'
				// ⚠ It cannot be swallowed by the arm above even though it shares its prefix: that one
				// tests `==`, and this one is the only arm that tests this prefix.
				// ⚠ **THE CHECK IS ON THE PARSED NAMES, NOT ON THE RAW VALUE, and that is the whole
				// point of doing it after the split.** A valueless `--emit-ir-runtime=` is a BAD OPTION,
				// not an empty list — the same door `--compiler=` refuses through — but so is
				// `--emit-ir-runtime=,` and `--emit-ir-runtime=" "`, which carry a NON-empty value that
				// names no function: `splitRuntimeNames` drops empty parts, so a raw-value check passed
				// them straight through to an empty list. Empty is how this field spells "the caller
				// named no runtime function", so either spelling would render a sidecar with no runtime
				// body under a command line that asked for one, and the golden built from it would pin
				// exactly what it pinned before while claiming otherwise. One check, on the value that
				// actually reaches the printer.
				let named = splitRuntimeNames(try CommandLine.optionValue(arg) otherwise "")
				if named.count() == 0 'noRuntimeNames'
					parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'noRuntimeNames' else 'hasRuntimeNames'
					parsed.runtimeIrNames = named
					// A list of functions to PRINT is a request for the printing. Without this the flag
					// would be silently inert whenever `--emit-ir` was forgotten — a no-op that looks like
					// a rendering, which is the one outcome the printer's own refusals exist to prevent.
					parsed.emitIr = true
				end 'hasRuntimeNames'
			end 'emitIrRuntimeFlag' else if arg.startsWith(FilterFlagPrefix) 'filterFlag'
				parsed.filter = try CommandLine.optionValue(arg) otherwise ""
			end 'filterFlag' else if arg == UpdateRequiredFlag 'updateRequiredFlag'
				parsed.updateRequired = true
			end 'updateRequiredFlag' else if arg == NetworkFlag 'networkFlag'
				parsed.includeNetwork = true
			end 'networkFlag' else if arg.startsWith(WorkersFlagPrefix) 'workersFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""

				// ⚠ RECORDED, because the delegated Linux lane forwards this flag only when it was typed
				// and the count alone cannot say so. See `MaxonArgs.workersOverridden`. The flag was
				// typed whatever its value parses to; an unusable one is refused below, and a refused
				// command line runs nothing to forward it to.
				parsed.workersOverridden = true

				// A bad value is a BAD OPTION, not a clamp — the same door as `--rungs`. `--workers=0`
				// asks for a pool that can run nothing; quietly running the default instead would
				// answer a question the caller never asked. See SpecWorkerPool.parseWorkerCount.
				match parseWorkerCount(raw) 'workersArg'
					valid(count) then parsed.workers = count
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'workersArg'
			end 'workersFlag' else if arg == WorkerPersistentFlag 'workerPersistentFlag'
				parsed.workerPersistent = true
			end 'workerPersistentFlag' else if arg.startsWith(WithdrawnCompilerFlagPrefix) 'withdrawnCompilerFlag'
				// ⛔ RECORDED AS WITHDRAWN, NOT AS UNKNOWN — see `WithdrawnCompilerFlagPrefix` and
				// `withdrawnOptionMessage`. The prefix is matched WITHOUT its `=`, so `--compiler`,
				// `--compiler=`, and `--compiler=<path>` all land here: every spelling a caller might still
				// be passing gets the sentence that says what happened to it, rather than only the one that
				// happens to be well-formed.
				//
				// ⚠ IT MUST SIT AHEAD OF THE ANONYMOUS `-`-leading arm below, which would otherwise swallow
				// it into `badOption` — the exact fall-through this refusal exists to avoid.
				parsed.withdrawnOption = firstBadOption(parsed.withdrawnOption, arg: arg)
			end 'withdrawnCompilerFlag' else if arg.startsWith(MetricsFlagPrefix) 'metricsFlag'
				parsed.metricsPath = try CommandLine.optionValue(arg) otherwise ""
			end 'metricsFlag' else if arg.startsWith(DefineFlagPrefix) 'defineFlag'
				let pair = try CommandLine.optionValue(arg) otherwise ""
				let cut = pair.split(DefineNameValueSeparator)
				// A `--define` with no `=` names no value. Recorded as a BAD OPTION rather than read as
				// "define it to the empty string": the two are different requests, and `--define=X` is far
				// more likely a truncated command line than a deliberate empty one — which `--define=X=`
				// still spells.
				if cut.count() < 2 'noValueGiven'
					parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'noValueGiven' else 'nameAndValue'
					let name = try cut.get(0) otherwise ""
					parsed.defines.push(Define.create(name, value: defineValueAfterName(cut)))
				end 'nameAndValue'
			end 'defineFlag' else if arg.startsWith(EmitCorpusFlagPrefix) 'emitCorpusFlag'
				parsed.emitCorpus = try CommandLine.optionValue(arg) otherwise ""
			end 'emitCorpusFlag' else if arg.startsWith(RungsFlagPrefix) 'rungsFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""
				// A bad value is recorded as a BAD OPTION, not clamped to the default. `main` refuses
				// to run on a command line it only partly understood, which is the only honest
				// response to `--rungs=99`: the caller asked for a ladder this suite will not climb
				// (each rung DOUBLES the program), and quietly climbing a different one would answer
				// a question they never asked. See ScaleCorpus.parseRungCount.
				match parseRungCount(raw) 'rungsArg'
					valid(count) then parsed.rungs = count
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'rungsArg'
			end 'rungsFlag' else if arg.startsWith(RepeatFlagPrefix) 'repeatFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""
				// The same door as `--rungs` and `--workers`: a bad value is a BAD OPTION, not a
				// clamp. `--repeat=0` asks for a rung that is never compiled, and quietly compiling
				// it three times would answer a question the caller never asked — the run they get
				// back would then differ from the one they typed in the column that is least able to
				// prove it. See ScaleTestRunner.parseRepeatCount.
				match parseRepeatCount(raw) 'repeatArg'
					valid(count) then parsed.repeat = count
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'repeatArg'
			end 'repeatFlag' else if arg.startsWith(NoteFlagPrefix) 'noteFlag'
				parsed.note = try CommandLine.optionValue(arg) otherwise ""
			end 'noteFlag' else if arg.startsWith(ResultJsonFlagPrefix) 'resultJsonFlag'
				parsed.resultJson = try CommandLine.optionValue(arg) otherwise ""
			end 'resultJsonFlag' else if arg.startsWith(TargetFlagPrefix) 'targetFlag'
				parsed.targetSpec = try CommandLine.optionValue(arg) otherwise ""
			end 'targetFlag' else if arg == TestListFlag 'listFlag'
				parsed.listOnly = true
			end 'listFlag' else if arg == TestJsonFlag 'jsonFlag'
				parsed.jsonReport = true
			end 'jsonFlag' else if arg == TestNoTimingFlag 'noTimingFlag'
				parsed.showTiming = false
			end 'noTimingFlag' else if arg == TestIsolateFlag 'isolateFlag'
				parsed.isolate = true
			end 'isolateFlag' else if arg == TestBailFlag 'bailFlag'
				parsed.bail = BailPolicy.after(DefaultBailAfter)
			end 'bailFlag' else if arg.startsWith(TestBailFlagPrefix) 'bailCountFlag'
				// A bad value is a BAD OPTION, not a clamp — the door `--workers` and `--rungs` already use.
				// `--bail=nonsense` asks a question this command cannot answer, and answering a different
				// one instead is the failure a caller can neither see nor recover from.
				match parsePositiveFlagValue(try CommandLine.optionValue(arg) otherwise "") 'bailArg'
					valid(failures) then parsed.bail = BailPolicy.after(failures as ReportedTestCount)
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'bailArg'
			end 'bailCountFlag' else if arg.startsWith(TestTimeoutFlagPrefix) 'timeoutFlag'
				match parsePositiveFlagValue(try CommandLine.optionValue(arg) otherwise "") 'timeoutArg'
					valid(ms) then parsed.testTimeoutMs = ms as DurationMs
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'timeoutArg'
			end 'timeoutFlag' else if arg.startsWith(TestColorFlagPrefix) 'colorFlag'
				match parseReportColorMode(try CommandLine.optionValue(arg) otherwise "") 'colorArg'
					valid(mode) then parsed.colorMode = mode
					invalid then parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'colorArg'
			end 'colorFlag' else if arg.startsWith(TestFilterShortPrefix) 'shortFilterWithValue'
				parsed.filter = try CommandLine.optionValue(arg) otherwise ""
			end 'shortFilterWithValue' else if arg == TestFilterShortFlag 'shortFilterSeparated'
				// `-t PATTERN` — the separated form, which is what a shell user types when the pattern has
				// spaces. A `-t` with nothing after it is REFUSED rather than ignored: a filter that named
				// no pattern would select EVERYTHING, which is the opposite of what was typed.
				i = i + 1
				parsed.filter = try args.get(i) otherwise ""
				if parsed.filter.isEmpty() 'namesNoPattern'
					parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
				end 'namesNoPattern'
			end 'shortFilterSeparated' else if arg.startsWith("--log=") 'logFlag'
				let spec = try CommandLine.optionValue(arg) otherwise ""
				if not parseLogOption(spec) 'badSpec'
					printError("Unrecognized --log spec '{spec}' (expected <level> or <category>:<level>)\n")
				end 'badSpec' else 'goodSpec'
					// ⚠ RECORDED, because `test` SILENCES the compiler's own INFO chatter — and must not do so
					// behind the back of a caller who explicitly asked for it. See
					// `TestCommand.quietTheBuildChatter`.
					parsed.logOverridden = true
				end 'goodSpec'
			end 'logFlag' else if arg == WithdrawnVersionFlag or arg == WithdrawnVersionFlagShort 'withdrawnVersionFlag'
				// ⛔ RECORDED AS WITHDRAWN, NOT AS UNKNOWN — see `WithdrawnVersionFlag` and
				// `withdrawnOptionMessage`. Both spellings are matched EXACTLY: anything longer that merely
				// starts with one of them names no option this driver ever had, and belongs on the anonymous
				// path with every other typo.
				parsed.withdrawnOption = firstBadOption(parsed.withdrawnOption, arg: arg)
			end 'withdrawnVersionFlag' else if arg == WithdrawnHelpFlag or arg == WithdrawnHelpFlagShort 'withdrawnHelpFlag'
				// ⛔ RECORDED AS WITHDRAWN, NOT AS UNKNOWN, and matched EXACTLY for the reason the version
				// spellings above are. See `WithdrawnHelpFlag`.
				parsed.withdrawnOption = firstBadOption(parsed.withdrawnOption, arg: arg)
			end 'withdrawnHelpFlag' else if arg.startsWith(OptionPrefix) 'unknownFlag'
				parsed.badOption = firstBadOption(parsed.badOption, arg: arg)
			end 'unknownFlag' else 'positional'
				// KEPT, never dropped. WHICH of them a command uses is the COMMAND's question — `build`
				// compiles them all in this order, everything else refuses a second — and that answer
				// cannot be given here, where the arity of the command being parsed is not yet known.
				parsed.paths.push(arg)
			end 'positional'

			// ⛔⛔ **ONLY THE FIRST COMMAND WORD ON A LINE IS THE COMMAND; A LATER ONE IS A PATH.** The
			// arms above are order-independent by design, which is right for FLAGS and destructive for
			// command words: MEASURED without this, in a tree holding a `fmt/` directory,
			// `maxon fmt fmt` set the command twice, left `paths` EMPTY, fell back to `fmt`'s
			// no-path default and REWROTE THE WHOLE WORKING DIRECTORY in place — exit 0, `2 file(s)
			// changed`, a file the caller never named among them. That is the 92-file incident the option
			// refusals exist to prevent, reached through the POSITIONAL door instead of the flag one.
			//
			// The BOOTSTRAP cannot have it and is the contract here: it dispatches on `args[0]` and hands
			// `args[1..]` to `RunFmt`, so its `fmt fmt` formats `fmt/` and touches nothing else (measured,
			// both compilers). Restoring the earlier command and re-filing the word as a positional is
			// what makes this parser answer the same.
			if parsed.command == MaxonCommand.unknown 'noCommandWordHere'
				parsed.command = commandBefore
			end 'noCommandWordHere' else if commandBefore != MaxonCommand.unknown 'laterCommandWordIsAPath'
				parsed.command = commandBefore
				parsed.paths.push(arg)
			end 'laterCommandWordIsAPath'

			i = i + 1
		end 'each'

		return parsed
	end 'parse'
end 'MaxonArgs'

// A position in the process command line. Declared for `monitorTail`, which is the only place an index
// into it leaves `MaxonArgs.parse`.
typealias CommandLineIndex = int(0 to u32.max)

// Everything after the word `monitor`, in the order typed. It is the CHILD's command line: no arm of the
// parser consumes it and nothing here rewrites it. A function rather than a loop inside `parse`, because
// that loop carries one register per live local and is already at the limit its own note records.
function monitorTail(args StringArray, from CommandLineIndex) returns SourcePathSpellingArray
	var tail = SourcePathSpellingArray.create()
	for position in from upto args.count() 'eachTailArgument'
		tail.push(try args.get(position) otherwise panic("monitorTail: index {position} is past args.count() despite the upto bound"))
	end 'eachTailArgument'

	return tail
end 'monitorTail'

// The function names an `--emit-ir-runtime=` value lists — split on the shared separator, each part
// trimmed, empties dropped. The same shape `parseUnsupportedTargetKeys` gives a `<!-- unsupported-targets: … -->` value,
// because they are the same kind of list and a second spelling of "comma-separated" would be one
// more thing a reader has to check.
function splitRuntimeNames(value String) returns RuntimeFunctionNameArray
	var names = RuntimeFunctionNameArray.create()
	for part in value.split(RuntimeNameSeparator) 'eachName'
		let trimmed = part.trim()
		if not trimmed.isEmpty() 'nonEmpty'
			names.push(trimmed)
		end 'nonEmpty'
	end 'eachName'
	return names
end 'splitRuntimeNames'
