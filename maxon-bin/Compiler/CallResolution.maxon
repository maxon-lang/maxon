// The call walk the closure-cycle check and the capability checks share. A named call reaches its callee's
// summary or, for a body no summary describes, the store shape of the runtime entry it is; a witness dispatch
// or a call through a function value reaches every body it may land on.

module typealias WitnessSlotKey = int(0 to u64.max)
typealias WitnessImplsMemo = Map with (WitnessSlotKey, CallLandingBodies)
typealias FunctionValueBodiesMemo = Map with (ByteArray, CallLandingBodies)
typealias FunctionShapeArray = Array with FunctionShape
typealias ExactLandingMemo = Map with (ElementIndex, CallLandingBodies)
typealias LandingByContents = Map with (ByteArray, CallLandingBodies)
typealias FunctionShapeBucketIndex = Map with (ByteArray, ElementIndex)
typealias CandidateBucketIndex = Map with (ByteArray, FuncIndexArray)
typealias BucketVerdicts = Map with (ElementIndex, bool)
typealias ReaderFreeVerdictMemo = Map with (ByteArray, BucketVerdicts)
typealias InstanceRecordMemo = Map with (GenericInstanceId, bool)
typealias FunctionRefNameMap = Map with (ValueId, immutable ByteArray)
typealias FunctionRefNamesByFunc = Map with (ElementIndex, FunctionRefNameMap)

let WitnessSlotKeyShift = 16 as WitnessSlotKey

// How the walks judge a call's callee. `refused` is a declaration poisoned by a parse error that no
// summary describes: that error is already the program's diagnostic, so the call is judged to read,
// keep, alias and write nothing and to hand back a fresh record, which keeps ownership diagnostics
// from following it. Wherever freshness is asked a refused callee answers fresh, so
// nothing is raised about one. A poisoned program never compiles, so these
// answers never reach codegen.
module union CalleeClass
	summarized(index ElementIndex)
	refused
	runtime
end 'CalleeClass'

module function requirementFirstPosition(method InterfaceMethodSig) returns ParamCount
	return 0 as ParamCount if method.isStatic else WitnessReceiverArgCount
end 'requirementFirstPosition'

module function witnessSlotKeyOf(interfaceDeclIndex ElementIndex, methodIndex WitnessMethodIndex) returns WitnessSlotKey
	return ((interfaceDeclIndex as WitnessSlotKey) shl WitnessSlotKeyShift) or (methodIndex as WitnessSlotKey)
end 'witnessSlotKeyOf'

let FunctionValueReaderSeparator = "@@"

// The reader's file is part of the key: `functionShapesAgree` resolves the shapes' names from that
// file.
function functionValueBodiesKey(calleeType ByteArray, readerFilePath FilePath) returns immutable ByteArray
	return freeze "{String.from(calleeType)}{FunctionValueReaderSeparator}{readerFilePath}".toByteArray()
end 'functionValueBodiesKey'

typealias ReachedBlockFlags = FixedArray with bool

// The block order of `CycleTrace.walk`: the first walk of a body files its call sites in the order
// it meets them, and the later walks replay that list by position, so a walker in another order reads
// another site's resolution. Reverse postorder lets the fixpoint see a block's predecessors first
// whatever order the blocks were created in; unreachable blocks are appended so their call sites
// are still filed.
module function callSiteWalkOrder(ir MaxonModule, func IrFunction) returns BlockPositionColumn
	let blockCount = func.blockRefs.count()
	let byId = ir.blockIndexById(func)
	let edgeFrom = CsrColumn.create(0)
	let edgeTo = CsrColumn.create(0)
	let successors = BlockIdArray.create(0)

	for position in 0 upto blockCount 'eachBlock'
		let block = ir.blockAtPosition(func, position: position)
		successors.clear()
		collectMaxonBlockSuccessors(ir, block: block, into: successors)

		for successorId in successors 'eachSuccessor'
			edgeFrom.push(position as CsrIndex)
			edgeTo.push((try byId.get(successorId) otherwise panic("callSiteWalkOrder: block_{block.id} branches to block_{successorId}, which is not a block of '{String.from(func.name)}'")) as CsrIndex)
		end 'eachSuccessor'
	end 'eachBlock'

	let order = StdDominatorTree.reversePostorder(buildCsr(edgeFrom, to: edgeTo, nodeCount: blockCount as CsrIndex), blockCount: blockCount)
	let reached = ReachedBlockFlags.create(blockCount)

	for position in order 'eachReached'
		try reached.set(position, value: true) otherwise panic("callSiteWalkOrder: reached.set OOB at {position}")
	end 'eachReached'

	for position in 0 upto blockCount 'eachUnreached'
		if not (try reached.get(position) otherwise panic("callSiteWalkOrder: reached.get OOB at {position}")) 'unreachable'
			order.push(position)
		end 'unreachable'
	end 'eachUnreached'

	return order
end 'callSiteWalkOrder'

module interface SummaryCallWalker
	function callSiteCursor() returns CallSiteCursor
	function tracksValue(value ValueId) returns bool
	function applyCalleeSummary(mutable self, func IrFunction, calleeIndex ElementIndex, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, argRanges SourceRangeArray)
	function storeHandedValue(mutable self, func IrFunction, receiver ValueId, stored ValueId, sharesItsElements bool, opIdx ElementIndex)
	function resultFromOperands(mutable self, func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId)
	function resultOfRuntimeCall(mutable self, func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, site ElementIndex)
end 'SummaryCallWalker'

module interface SummarizedBodies
	function tracesFirst(mutable self, index ElementIndex) returns bool
	function traceAndWiden(mutable self, index ElementIndex) returns bool

	// Bodies of one key must apply identically at any call site: `dispatchLandingCall` applies only
	// the first member of each key's class, so a fact the key leaves out is an effect silently
	// dropped.
	function landingKeyOf(mutable self, index ElementIndex, keys mutable LandingKeys) returns ElementIndex
end 'SummarizedBodies'

module function dispatchNamedCall(walker SummaryCallWalker, func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray)
	let cursor = walker.callSiteCursor()
	let site = cursor.nextCallSite(func, callee: callee, args: args, argLabels: argLabels)

	if not cursor.resolution.sites.rowIsDescribed(site) 'noSummary'
		storeThroughRuntimeShape(walker, func: func, args: args, shape: cursor.resolution.sites.shapeAt(site), opIdx: opIdx)
		walker.resultOfRuntimeCall(func, op: op, opIdx: opIdx, result: result, args: args, site: site)
		return
	end 'noSummary'

	let calleeIndex = cursor.resolution.sites.calleeAt(site)
	cursor.dependencies.note(calleeIndex)
	cursor.slotCallSiteArgs(site, argCount: args.count() as ParamCount)
	walker.applyCalleeSummary(func, calleeIndex: calleeIndex, op: op, opIdx: opIdx, result: result, args: args, argRanges: argRanges)
end 'dispatchNamedCall'

module function dispatchLandingCall(walker SummaryCallWalker, func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, bodies CallLandingBodies)
	let cursor = walker.callSiteCursor()

	if bodies.unresolvedMayStore 'aBodyMayStoreAnything'
		storeThroughRuntimeShape(walker, func: func, args: args, shape: RuntimeStoreShape.intoAnyOperand, opIdx: opIdx)
	end 'aBodyMayStoreAnything'

	if bodies.unresolved 'aBodyNoSummaryDescribes'
		walker.resultFromOperands(func, op: op, opIdx: opIdx, result: result)
	end 'aBodyNoSummaryDescribes'

	cursor.dependencies.noteLandedSet(bodies.set)
	let participants = cursor.resolution.landingSets.factsOf(bodies.set).participants
	let classes = cursor.landing.classesOf(bodies.set)

	for slot in classes.order 'eachClass'
		dispatchLandedBody(walker, func: func, op: op, opIdx: opIdx, result: result, args: args, impl: try participants.get(classes.firstOf(slot)) otherwise panic("dispatchLandingCall: class {slot} of set {bodies.set} names a first member past the {participants.count()} participants"))
	end 'eachClass'
end 'dispatchLandingCall'

function dispatchLandedBody(walker SummaryCallWalker, func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, impl ElementIndex)
	let cursor = walker.callSiteCursor()

	if cursor.resolution.implBodyWasSkipped(impl) 'notInThisProgram'
		return
	end 'notInThisProgram'

	if not cursor.resolution.implHasSummary(impl) 'noSummary'
		storeThroughRuntimeShape(walker, func: func, args: args, shape: RuntimeStoreShape.intoAnyOperand, opIdx: opIdx)
		walker.resultFromOperands(func, op: op, opIdx: opIdx, result: result)
		return
	end 'noSummary'

	cursor.slotPositionalArgs(args.count() as ParamCount)
	walker.applyCalleeSummary(func, calleeIndex: impl, op: op, opIdx: opIdx, result: result, args: args, argRanges: cursor.noArgRanges)
end 'dispatchLandedBody'

function storeThroughRuntimeShape(walker SummaryCallWalker, func IrFunction, args ValueIdArray, shape RuntimeStoreShape, opIdx ElementIndex)
	if shape == RuntimeStoreShape.nothing 'storesNothing'
		return
	end 'storesNothing'

	let resolution = walker.callSiteCursor().resolution

	for receiverIndex in 0 upto args.count() 'eachReceiver'
		let receiver = try args.get(receiverIndex) otherwise panic("storeThroughRuntimeShape: args.get OOB at receiver {receiverIndex}")

		if not shapeStoresInto(shape, receiverIndex: receiverIndex as ParamCount) or not walker.tracksValue(receiver) or not resolution.mayHoldARecord(func, value: receiver) 'cannotHoldARecord'
			continue
		end 'cannotHoldARecord'

		for storedIndex in 0 upto args.count() 'eachStored'
			if storedIndex != receiverIndex and shapeStoresOperand(shape, storedIndex: storedIndex as ParamCount) 'another'
				let stored = try args.get(storedIndex) otherwise panic("storeThroughRuntimeShape: args.get OOB at operand {storedIndex}")
				walker.storeHandedValue(func, receiver: receiver, stored: stored, sharesItsElements: shape == RuntimeStoreShape.theSourcesElementsIntoTheReceiver, opIdx: opIdx)
			end 'another'
		end 'eachStored'
	end 'eachReceiver'
end 'storeThroughRuntimeShape'

typealias FuncFlags = FixedArray with bool

// A call through a function value or a witness is one edge to its landing set, and the set grows
// when any member does: a site landing on N bodies costs one edge rather than N.
type SummaryClock
	var now as ElementIndex
	var tracedAt as FuncIndexArray
	var grewAt as FuncIndexArray
	var setGrewAt as FuncIndexArray
	var setVisitedAt as FuncIndexArray

	static function create(funcCount ElementIndex) returns SummaryClock
		return Self{now: 0, tracedAt: FuncIndexArray.create(funcCount), grewAt: FuncIndexArray.create(funcCount), setGrewAt: FuncIndexArray.create(0), setVisitedAt: FuncIndexArray.create(0)}
	end 'create'

	function coverSets(sets LandingSets)
		while self.setGrewAt.count() < sets.count() 'eachNewSet'
			self.setGrewAt.push(0)
			self.setVisitedAt.push(0)
		end 'eachNewSet'
	end 'coverSets'

	function beginTrace(index ElementIndex)
		self.now = self.now + 1
		try self.tracedAt.set(index, value: self.now) otherwise panic("SummaryClock.beginTrace: tracedAt.set OOB at {index}")
	end 'beginTrace'

	function noteGrowth(index ElementIndex, sets LandingSets)
		self.now = self.now + 1
		self.coverSets(sets)
		try self.grewAt.set(index, value: self.now) otherwise panic("SummaryClock.noteGrowth: grewAt.set OOB at {index}")

		for membership in 0 upto sets.membershipCountOf(index) 'eachSetItLandsIn'
			let set = sets.setOfMembership(index, k: membership)
			try self.setGrewAt.set(set, value: self.now) otherwise panic("SummaryClock.noteGrowth: set {set} is past the {self.setGrewAt.count()} sets the clock covers")
		end 'eachSetItLandsIn'
	end 'noteGrowth'

	function growthOfFunction(callee ElementIndex) returns ElementIndex
		return try self.grewAt.get(callee) otherwise panic("SummaryClock.growthOfFunction: grewAt.get OOB at {callee}")
	end 'growthOfFunction'

	function growthOfSet(set ElementIndex) returns ElementIndex
		return try self.setGrewAt.get(set) otherwise panic("SummaryClock.growthOfSet: set {set} is past the {self.setGrewAt.count()} sets the clock covers")
	end 'growthOfSet'

	function setAwaitsAVisit(set ElementIndex) returns bool
		return (try self.setVisitedAt.get(set) otherwise panic("SummaryClock.setAwaitsAVisit: set {set} is past the {self.setVisitedAt.count()} sets the clock covers")) < self.growthOfSet(set)
	end 'setAwaitsAVisit'

	function beginSetVisit(set ElementIndex) returns ElementIndex
		try self.setVisitedAt.set(set, value: self.now) otherwise panic("SummaryClock.beginSetVisit: set {set} is past the {self.setVisitedAt.count()} sets the clock covers")
		return self.growthOfSet(set)
	end 'beginSetVisit'

	function readsStaleGrowth(growth ElementIndex, caller ElementIndex) returns bool
		return growth > self.tracedAtOf(caller)
	end 'readsStaleGrowth'

	function tracedAtOf(caller ElementIndex) returns ElementIndex
		return try self.tracedAt.get(caller) otherwise panic("SummaryClock.tracedAtOf: tracedAt.get OOB at {caller}")
	end 'tracedAtOf'
end 'SummaryClock'

type SummaryWorklist
	module var members as FuncIndexArray
	var queued as FuncFlags
	module var clock as SummaryClock

	static function create(funcCount ElementIndex) returns SummaryWorklist
		return Self{members: FuncIndexArray.create(0), queued: FuncFlags.create(funcCount), clock: SummaryClock.create(funcCount)}
	end 'create'

	function trace(index ElementIndex, bodies SummarizedBodies, landing LandingClasses)
		self.clock.beginTrace(index)

		if not bodies.traceAndWiden(index) 'nothingGrew'
			return
		end 'nothingGrew'

		landing.rekey(index, bodies: bodies)
		self.clock.noteGrowth(index, sets: landing.sets)

		if not (try self.queued.get(index) otherwise panic("SummaryWorklist.trace: queued.get OOB at {index}")) 'callersMustLookAgain'
			self.members.push(index)
			try self.queued.set(index, value: true) otherwise panic("SummaryWorklist.trace: queued.set OOB at {index}")
		end 'callersMustLookAgain'
	end 'trace'

	function release(index ElementIndex)
		try self.queued.set(index, value: false) otherwise panic("SummaryWorklist.release: queued.set OOB at {index}")
	end 'release'
end 'SummaryWorklist'

// A least fixpoint: every body `tracesFirst` admits is traced once, then the callers of each body whose summary
// grew are traced again until nothing grows.
module function settleSummaries(project Project, order CsrColumn, bodies SummarizedBodies, dependencies CallDependencies, landing LandingClasses) throws CompileError
	let funcCount = order.count()
	let pending = SummaryWorklist.create(funcCount)
	landing.seed(bodies)

	for i in order 'firstTrace'
		try requireStillWanted(project)

		if not bodies.tracesFirst(i) 'nothingToHandOn'
			continue
		end 'nothingToHandOn'

		dependencies.recordFor(i)
		pending.trace(i, bodies: bodies, landing: landing)
		dependencies.stopRecording()
	end 'firstTrace'

	let callersByCallee = buildCsr(dependencies.callees, to: dependencies.callers, nodeCount: funcCount as CsrIndex)
	let callersBySet = buildCsr(dependencies.landedSets, to: dependencies.landedCallers, nodeCount: landing.sets.count() as CsrIndex)
	pending.clock.coverSets(landing.sets)
	var head = 0 as ElementIndex

	while head < pending.members.count() 'drain'
		try requireStillWanted(project)
		requireEverySetRecorded(landing.sets, recorded: callersBySet.nodeCount())
		let member = try pending.members.get(head) otherwise panic("settleSummaries: members.get OOB at {head}")
		head = head + 1
		pending.release(member)
		retraceCallersGrownAfter(pending.clock.growthOfFunction(member), callers: callersByCallee, node: member, pending: pending, bodies: bodies, landing: landing)

		for membership in 0 upto landing.sets.membershipCountOf(member) 'eachSetItLandsIn'
			let set = landing.sets.setOfMembership(member, k: membership)

			if not pending.clock.setAwaitsAVisit(set) 'nothingNewToRead'
				continue
			end 'nothingNewToRead'

			retraceCallersGrownAfter(pending.clock.beginSetVisit(set), callers: callersBySet, node: set, pending: pending, bodies: bodies, landing: landing)
		end 'eachSetItLandsIn'
	end 'drain'

	requireEverySetRecorded(landing.sets, recorded: callersBySet.nodeCount())
	requireEveryEdgeSettled(callersByCallee, callersBySet: callersBySet, clock: pending.clock)
end 'settleSummaries'

// A set registered after the first pass has callers no retrace revisits, so its growth could go unseen.
function requireEverySetRecorded(sets LandingSets, recorded CsrIndex)
	if sets.count() != recorded as ElementIndex 'aSetRegisteredLate'
		panic("settleSummaries: {sets.count()} landing sets are registered but the first pass recorded callers for {recorded}; a set registered after recording closes has callers no retrace revisits")
	end 'aSetRegisteredLate'
end 'requireEverySetRecorded'

function retraceCallersGrownAfter(growth ElementIndex, callers CsrGraph, node ElementIndex, pending SummaryWorklist, bodies SummarizedBodies, landing LandingClasses)
	for k in 0 upto callers.degree(node as CsrIndex) 'eachCaller'
		let caller = callers.neighbour(node as CsrIndex, k: k)

		if pending.clock.readsStaleGrowth(growth, caller: caller) 'readsSomethingNew'
			pending.trace(caller, bodies: bodies, landing: landing)
		end 'readsSomethingNew'
	end 'eachCaller'
end 'retraceCallersGrownAfter'

// The drain skips a set no member grew in since its last visit (`setAwaitsAVisit`). A skip that
// lost a growth would leave a caller's summary missing an effect, with no diagnostic to show it.
function requireEveryEdgeSettled(callersByCallee CsrGraph, callersBySet CsrGraph, clock SummaryClock)
	for callee in 0 upto callersByCallee.nodeCount() as ElementIndex 'eachCallee'
		for k in 0 upto callersByCallee.degree(callee as CsrIndex) 'eachCaller'
			let caller = callersByCallee.neighbour(callee as CsrIndex, k: k)

			if clock.readsStaleGrowth(clock.growthOfFunction(callee), caller: caller) 'staleCaller'
				panic("settleSummaries: function {caller} was last traced at {clock.tracedAtOf(caller)}, before function {callee} last grew at {clock.growthOfFunction(callee)}")
			end 'staleCaller'
		end 'eachCaller'
	end 'eachCallee'

	for set in 0 upto callersBySet.nodeCount() as ElementIndex 'eachSet'
		for k in 0 upto callersBySet.degree(set as CsrIndex) 'eachCaller'
			let caller = callersBySet.neighbour(set as CsrIndex, k: k)

			if clock.readsStaleGrowth(clock.growthOfSet(set), caller: caller) 'staleCaller'
				panic("settleSummaries: function {caller} was last traced at {clock.tracedAtOf(caller)}, before landing set {set} last grew at {clock.growthOfSet(set)}")
			end 'staleCaller'
		end 'eachCaller'
	end 'eachSet'
end 'requireEveryEdgeSettled'

// A postorder of the named-call graph, so the first pass traces a direct callee before its callers.
// Only a call cycle's back edge or a call through a landing set reaches a body traced after its
// caller.
module function calleesFirstOrder(module MaxonModule, funcNames FunctionNameIndex) returns CsrColumn
	let callers = CsrColumn.create(0)
	let callees = CsrColumn.create(0)

	for (iter, func) in module.functions.withIterator() 'eachFunction'
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("calleesFirstOrder: blockRef {blockRef} of '{String.from(func.name)}' is not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("calleesFirstOrder: opIdx {opIdx} is not in module.ops")

				if maxonOpCalleeKind(op) != MaxonCalleeKind.direct 'notANamedCall'
					continue
				end 'notANamedCall'

				if let callee = try funcNames.byName.get(maxonOpCalleeName(op)) 'aFunctionOfThisModule'
					callers.push(iter.index() as CsrIndex)
					callees.push(callee as CsrIndex)
				end 'aFunctionOfThisModule'
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunction'

	return postorderOf(buildCsr(callers, to: callees, nodeCount: module.functions.count() as CsrIndex))
end 'calleesFirstOrder'

module type LandingSetFacts
	module var bodies as CallLandingBodies
	module var participants as FuncIndexArray

	module static function create(bodies CallLandingBodies, participants FuncIndexArray) returns LandingSetFacts
		return Self{bodies: bodies, participants: participants}
	end 'create'
end 'LandingSetFacts'

typealias LandingSetFactsArray = Array with LandingSetFacts
typealias LandedBrandMemo = Map with (ElementIndex, NameRoster)

function landingPositionKey(set ElementIndex, position ParamCount) returns ElementIndex
	if position >= MaxAbiArgs 'pastTheAbi'
		panic("landingPositionKey: position {position} is past the {MaxAbiArgs} an ABI passes")
	end 'pastTheAbi'

	return set * (MaxAbiArgs as ElementIndex) + (position as ElementIndex)
end 'landingPositionKey'

module type LandingSets
	var facts as LandingSetFactsArray
	var memberships as FuncIndexRows
	var edgeArity as ParamCountArray
	var landedBrands as LandedBrandMemo

	module static function create(funcCount ElementIndex) returns LandingSets
		let memberships = FuncIndexRows.create(funcCount, zeroed: false)

		while memberships.count() < funcCount 'eachFunction'
			memberships.push(FuncIndexArray.create(0))
		end 'eachFunction'

		return Self{facts: LandingSetFactsArray.create(0), memberships: memberships, edgeArity: ParamCountArray.create(0), landedBrands: LandedBrandMemo.create()}
	end 'create'

	module function distinctBrandsAt(set ElementIndex, position ParamCount) returns NameRoster throws MapError
		return try self.landedBrands.get(landingPositionKey(set, position: position))
	end 'distinctBrandsAt'

	module function fileDistinctBrands(set ElementIndex, position ParamCount, brands NameRoster)
		self.landedBrands.upsert(landingPositionKey(set, position: position), value: brands)
	end 'fileDistinctBrands'

	module function count() returns ElementIndex
		return self.facts.count()
	end 'count'

	module function functionCount() returns ElementIndex
		return self.memberships.count()
	end 'functionCount'

	module function nodeCount() returns ElementIndex
		return self.memberships.count() + self.facts.count()
	end 'nodeCount'

	module function add(contents LandingContents, participants FuncIndexArray) returns CallLandingBodies
		let set = self.facts.count()
		let landing = CallLandingBodies.registered(contents, set: set)
		self.facts.push(LandingSetFacts.create(landing, participants: participants))
		self.edgeArity.push(0)

		for (iter, member) in participants.withIterator() 'eachParticipant'
			let row = self.membershipRow(member)
			row.push(set)
			row.push(iter.index())
		end 'eachParticipant'

		return landing
	end 'add'

	module function virtualNodeOf(set ElementIndex) returns ElementIndex
		return self.memberships.count() + set
	end 'virtualNodeOf'

	module function noteEdgeArity(set ElementIndex, arity ParamCount)
		let noted = try self.edgeArity.get(set) otherwise panic("LandingSets.noteEdgeArity: set {set} is past the {self.edgeArity.count()} registered")

		if arity > noted 'widens'
			try self.edgeArity.set(set, value: arity) otherwise panic("LandingSets.noteEdgeArity: edgeArity.set OOB at {set}")
		end 'widens'
	end 'noteEdgeArity'

	module function memberEdgesInto(edges CallParamEdges)
		for set in 0 upto self.facts.count() 'eachSet'
			let arity = try self.edgeArity.get(set) otherwise panic("LandingSets.memberEdgesInto: edgeArity.get OOB at {set}")
			let node = self.virtualNodeOf(set)

			for impl in self.factsOf(set).bodies.impls 'eachMember'
				for position in 0 upto arity 'eachHandedPosition'
					edges.record(impl, callerIndex: node, callerParam: position, calleeParam: position, carry: FrozenCarry.carries, holdsUnique: true)
				end 'eachHandedPosition'
			end 'eachMember'
		end 'eachSet'
	end 'memberEdgesInto'

	module function membershipCountOf(member ElementIndex) returns ElementIndex
		return self.membershipRow(member).count() shr 1
	end 'membershipCountOf'

	module function setOfMembership(member ElementIndex, k ElementIndex) returns ElementIndex
		return self.membershipEntry(member, at: k * 2)
	end 'setOfMembership'

	module function positionOfMembership(member ElementIndex, k ElementIndex) returns ElementIndex
		return self.membershipEntry(member, at: k * 2 + 1)
	end 'positionOfMembership'

	function membershipEntry(member ElementIndex, at ElementIndex) returns ElementIndex
		return try self.membershipRow(member).get(at) otherwise panic("LandingSets.membershipEntry: entry {at} is past the {self.membershipRow(member).count()} of function {member}")
	end 'membershipEntry'

	function membershipRow(member ElementIndex) returns FuncIndexArray
		return try self.memberships.get(member) otherwise panic("LandingSets.membershipRow: function index {member} is past the {self.memberships.count()} functions")
	end 'membershipRow'

	module function factsOf(set ElementIndex) returns LandingSetFacts
		return try self.facts.get(set) otherwise panic("LandingSets.factsOf: set {set} is past the {self.facts.count()} registered")
	end 'factsOf'
end 'LandingSets'

let UnsummarizedLandingKey = 0 as ElementIndex

typealias LandingDigestIndex = Map with (ParamPositionMaskArray, ElementIndex)
typealias LandingSlotByKey = Map with (ElementIndex, ElementIndex)

module type LandingKeys
	var keyOfDigest as LandingDigestIndex
	var internedCount as ElementIndex
	var digest as ParamPositionMaskArray

	module static function create() returns LandingKeys
		return Self{keyOfDigest: LandingDigestIndex.create(), internedCount: UnsummarizedLandingKey + 1, digest: ParamPositionMaskArray.create(0)}
	end 'create'

	module function begin()
		self.digest.clear()
	end 'begin'

	module function push(mask ParamPositionMask)
		self.digest.push(mask)
	end 'push'

	module function pushCount(count ElementIndex)
		self.digest.push(count as ParamPositionMask)
	end 'pushCount'

	module function pushFlag(flag bool)
		self.pushCount(1 if flag else 0)
	end 'pushFlag'

	module function pushStoreRow(rows ParamMaskRows, index ElementIndex)
		let row = try rows.get(index) otherwise panic("LandingKeys.pushStoreRow: function index {index} is outside the store rows")
		var length = row.count()

		while length > 0 and (try row.get(length - 1) otherwise panic("LandingKeys.pushStoreRow: row.get OOB at {length - 1}")) == NoParamPositions 'trailingEmpty'
			length = length - 1
		end 'trailingEmpty'

		self.pushCount(length)

		for k in 0 upto length 'eachMask'
			self.digest.push(try row.get(k) otherwise panic("LandingKeys.pushStoreRow: row.get OOB at {k}"))
		end 'eachMask'
	end 'pushStoreRow'

	module function intern() returns ElementIndex
		if let known = try self.keyOfDigest.get(self.digest) 'seenBefore'
			return known
		end 'seenBefore'

		let key = self.internedCount
		self.internedCount = key + 1
		self.keyOfDigest.upsert(freeze self.digest.clone(), value: key)
		return key
	end 'intern'
end 'LandingKeys'

module type LandingClassList
	var slots as FuncIndexArray
	var keys as FuncIndexArray
	var members as FuncIndexRows
	module var order as FuncIndexArray
	var slotOfKey as LandingSlotByKey

	module static function create() returns LandingClassList
		return Self{slots: FuncIndexArray.create(0), keys: FuncIndexArray.create(0), members: FuncIndexRows.create(0), order: FuncIndexArray.create(0), slotOfKey: LandingSlotByKey.create()}
	end 'create'

	module function firstOf(slot ElementIndex) returns ElementIndex
		return try self.membersOf(slot).get(0) otherwise panic("LandingClassList.firstOf: class {slot} holds no participant")
	end 'firstOf'

	module function append(key ElementIndex)
		let position = self.slots.count()
		self.slots.push(self.joinClass(key, first: position))
	end 'append'

	module function move(position ElementIndex, key ElementIndex)
		let previous = try self.slots.get(position) otherwise panic("LandingClassList.move: position {position} is past the {self.slots.count()} participants")

		if self.keyOf(previous) == key 'sameClass'
			return
		end 'sameClass'

		self.leaveClass(previous, position: position)
		try self.slots.set(position, value: self.joinClass(key, first: position)) otherwise panic("LandingClassList.move: slots.set OOB at {position}")
	end 'move'

	function keyOf(slot ElementIndex) returns ElementIndex
		return try self.keys.get(slot) otherwise panic("LandingClassList.keyOf: class {slot} is past the {self.keys.count()} opened")
	end 'keyOf'

	function membersOf(slot ElementIndex) returns FuncIndexArray
		return try self.members.get(slot) otherwise panic("LandingClassList.membersOf: class {slot} is past the {self.members.count()} opened")
	end 'membersOf'

	function memberIndexAtOrAfter(row FuncIndexArray, position ElementIndex) returns ElementIndex
		var low = 0 as ElementIndex
		var high = row.count() as ElementIndex

		while low < high 'narrowing'
			let middle = (low + high) shr 1

			if (try row.get(middle) otherwise panic("LandingClassList.memberIndexAtOrAfter: row.get OOB at {middle}")) < position 'beforeIt'
				low = middle + 1
			end 'beforeIt' else 'atOrAfterIt'
				high = middle
			end 'atOrAfterIt'
		end 'narrowing'

		return low
	end 'memberIndexAtOrAfter'

	function joinClass(key ElementIndex, first ElementIndex) returns ElementIndex
		let slot = try self.slotOfKey.get(key) otherwise return self.openClass(key, first: first)
		let row = self.membersOf(slot)
		let at = self.memberIndexAtOrAfter(row, position: first)

		if at == 0 'anEarlierMember'
			self.takeOutOfOrder(slot)
			row.insert(0, value: first)
			self.placeInOrder(slot)
			return slot
		end 'anEarlierMember'

		row.insert(at, value: first)
		return slot
	end 'joinClass'

	function openClass(key ElementIndex, first ElementIndex) returns ElementIndex
		let slot = self.keys.count()
		let row = FuncIndexArray.create(1, zeroed: false)
		row.push(first)
		self.keys.push(key)
		self.members.push(row)
		self.slotOfKey.upsert(key, value: slot)
		self.placeInOrder(slot)
		return slot
	end 'openClass'

	function leaveClass(slot ElementIndex, position ElementIndex)
		let row = self.membersOf(slot)
		let at = self.memberIndexAtOrAfter(row, position: position)

		if (try row.get(at) otherwise panic("LandingClassList.leaveClass: participant {position} is not in class {slot}")) != position 'notInTheClass'
			panic("LandingClassList.leaveClass: participant {position} is not in class {slot}")
		end 'notInTheClass'

		if at != 0 'notTheFirst'
			_ = try row.remove(at) otherwise panic("LandingClassList.leaveClass: row.remove OOB at {at}")
			return
		end 'notTheFirst'

		self.takeOutOfOrder(slot)
		_ = try row.remove(0) otherwise panic("LandingClassList.leaveClass: row.remove OOB at 0")

		if row.isEmpty() 'emptied'
			_ = self.slotOfKey.remove(self.keyOf(slot))
			return
		end 'emptied'

		self.placeInOrder(slot)
	end 'leaveClass'

	function orderIndexAtOrAfter(first ElementIndex) returns ElementIndex
		var low = 0 as ElementIndex
		var high = self.order.count() as ElementIndex

		while low < high 'narrowing'
			let middle = (low + high) shr 1

			if self.firstOf(try self.order.get(middle) otherwise panic("LandingClassList.orderIndexAtOrAfter: order.get OOB at {middle}")) < first 'beforeIt'
				low = middle + 1
			end 'beforeIt' else 'atOrAfterIt'
				high = middle
			end 'atOrAfterIt'
		end 'narrowing'

		return low
	end 'orderIndexAtOrAfter'

	function placeInOrder(slot ElementIndex)
		self.order.insert(self.orderIndexAtOrAfter(self.firstOf(slot)), value: slot)
	end 'placeInOrder'

	function takeOutOfOrder(slot ElementIndex)
		let at = self.orderIndexAtOrAfter(self.firstOf(slot))

		if (try self.order.get(at) otherwise panic("LandingClassList.takeOutOfOrder: class {slot} is not live")) != slot 'notThatClass'
			panic("LandingClassList.takeOutOfOrder: the class at {at} of the order is not {slot}")
		end 'notThatClass'

		_ = try self.order.remove(at) otherwise panic("LandingClassList.takeOutOfOrder: order.remove OOB at {at}")
	end 'takeOutOfOrder'
end 'LandingClassList'

typealias LandingClassListBySet = Map with (ElementIndex, LandingClassList)

module type LandingClasses
	module var sets as LandingSets
	var resolution as CallSummaryIndex
	var interner as LandingKeys
	var keyOfMember as FuncIndexArray
	var classesBySet as LandingClassListBySet

	module static function create(resolution CallSummaryIndex) returns LandingClasses
		return Self{sets: resolution.landingSets, resolution: resolution, interner: LandingKeys.create(), keyOfMember: FuncIndexArray.create(0), classesBySet: LandingClassListBySet.create()}
	end 'create'

	module function seed(bodies SummarizedBodies)
		self.keyOfMember.clear()
		self.classesBySet = LandingClassListBySet.create()

		for index in 0 upto self.sets.functionCount() 'eachFunction'
			if self.resolution.implHasSummary(index) 'describedBySummary'
				self.keyOfMember.push(bodies.landingKeyOf(index, keys: self.interner))
			end 'describedBySummary' else 'describedByNone'
				self.keyOfMember.push(UnsummarizedLandingKey)
			end 'describedByNone'
		end 'eachFunction'
	end 'seed'

	module function rekey(member ElementIndex, bodies SummarizedBodies)
		let previous = self.keyOf(member)

		if previous == UnsummarizedLandingKey 'summaryIsNotRead'
			return
		end 'summaryIsNotRead'

		let key = bodies.landingKeyOf(member, keys: self.interner)

		if key == previous 'sameRow'
			return
		end 'sameRow'

		try self.keyOfMember.set(member, value: key) otherwise panic("LandingClasses.rekey: keyOfMember.set OOB at {member}")

		for membership in 0 upto self.sets.membershipCountOf(member) 'eachSetItLandsIn'
			let classes = try self.classesBySet.get(self.sets.setOfMembership(member, k: membership)) otherwise continue
			classes.move(self.sets.positionOfMembership(member, k: membership), key: key)
		end 'eachSetItLandsIn'
	end 'rekey'

	module function classesOf(set ElementIndex) returns LandingClassList
		if let built = try self.classesBySet.get(set) 'asked'
			return built
		end 'asked'

		let classes = LandingClassList.create()

		for member in self.sets.factsOf(set).participants 'eachParticipant'
			classes.append(self.keyOf(member))
		end 'eachParticipant'

		self.classesBySet.upsert(set, value: classes)
		return classes
	end 'classesOf'

	function keyOf(member ElementIndex) returns ElementIndex
		return try self.keyOfMember.get(member) otherwise panic("LandingClasses.keyOf: function index {member} is past the {self.keyOfMember.count()} seeded")
	end 'keyOf'
end 'LandingClasses'

module type CallDependencies
	var recording as bool
	var caller as ElementIndex
	export var callees as CsrColumn
	export var callers as CsrColumn
	export var landedSets as CsrColumn
	export var landedCallers as CsrColumn

	module static function create() returns CallDependencies
		return Self{recording: false, caller: 0, callees: CsrColumn.create(0), callers: CsrColumn.create(0), landedSets: CsrColumn.create(0), landedCallers: CsrColumn.create(0)}
	end 'create'

	module function noteLandedSet(set ElementIndex)
		if self.recording 'firstPass'
			self.landedSets.push(set as CsrIndex)
			self.landedCallers.push(self.caller as CsrIndex)
		end 'firstPass'
	end 'noteLandedSet'

	module function recordFor(callerIndex ElementIndex)
		self.recording = true
		self.caller = callerIndex
	end 'recordFor'

	module function stopRecording()
		self.recording = false
	end 'stopRecording'

	module function note(callee ElementIndex)
		if self.recording 'firstPass'
			self.callees.push(callee as CsrIndex)
			self.callers.push(self.caller as CsrIndex)
		end 'firstPass'
	end 'note'
end 'CallDependencies'

module type FunctionRefShapes
	var shapes as FunctionShapeArray
	var bucketByKey as FunctionShapeBucketIndex
	var bucketsByCandidateKey as CandidateBucketIndex
	var bucketOfPosition as CsrColumn
	var positions as CsrColumn
	var members as CsrGraph
	var undeclared as FuncIndexArray

	module static function create() returns FunctionRefShapes
		return Self{shapes: FunctionShapeArray.create(0), bucketByKey: FunctionShapeBucketIndex.create(), bucketsByCandidateKey: CandidateBucketIndex.create(), bucketOfPosition: CsrColumn.create(0), positions: CsrColumn.create(0), members: CsrGraph.create(CsrColumn.create(0), list: CsrColumn.create(0)), undeclared: FuncIndexArray.create(0)}
	end 'create'

	module function note(position ElementIndex, shape DeclaredFunctionShape)
		match shape 'bodyShape'
			declared(declaredShape) then self.noteDeclared(position, shape: declaredShape)
			undeclared then self.undeclared.push(position)
		end 'bodyShape'
	end 'note'

	function noteDeclared(position ElementIndex, shape FunctionShape)
		let key = shape.identityKey()
		let bucket = try self.bucketByKey.get(key) otherwise self.openBucket(key, shape: shape)
		self.bucketOfPosition.push(bucket as CsrIndex)
		self.positions.push(position as CsrIndex)
	end 'noteDeclared'

	function openBucket(key immutable ByteArray, shape FunctionShape) returns ElementIndex
		let bucket = self.shapes.count()
		self.shapes.push(shape)
		self.bucketByKey.upsert(key, value: bucket)
		let candidateKey = shape.agreementParts().candidateKey()

		if var sharing = try self.bucketsByCandidateKey.get(candidateKey) 'candidateKnown'
			sharing.push(bucket)
			return bucket
		end 'candidateKnown'

		let opened = FuncIndexArray.create(0)
		opened.push(bucket)
		self.bucketsByCandidateKey.upsert(candidateKey, value: opened)
		return bucket
	end 'openBucket'

	module function candidatesFor(shape FunctionShape, mentionsATypeParameter bool) returns FuncIndexArray
		if not mentionsATypeParameter 'everyAgreeingBodyShareItsKey'
			return try self.bucketsByCandidateKey.get(shape.agreementParts().candidateKey()) otherwise FuncIndexArray.create(0)
		end 'everyAgreeingBodyShareItsKey'

		let every = FuncIndexArray.create(self.shapes.count(), zeroed: false)

		for bucket in 0 upto self.shapes.count() 'eachBucket'
			every.push(bucket)
		end 'eachBucket'

		return every
	end 'candidatesFor'

	module function seal()
		self.members = buildCsr(self.bucketOfPosition, to: self.positions, nodeCount: self.shapes.count() as CsrIndex)
	end 'seal'

	module function bucketCount() returns ElementIndex
		return self.shapes.count()
	end 'bucketCount'

	module function shapeOfBucket(bucket ElementIndex) returns FunctionShape
		return try self.shapes.get(bucket) otherwise panic("FunctionRefShapes.shapeOfBucket: bucket {bucket} is past the {self.shapes.count()} opened")
	end 'shapeOfBucket'

	module function positionsInto(bucket ElementIndex, into FuncIndexArray)
		for k in 0 upto self.members.degree(bucket as CsrIndex) 'eachMember'
			into.push(self.members.neighbour(bucket as CsrIndex, k: k))
		end 'eachMember'
	end 'positionsInto'

	module function undeclaredInto(into FuncIndexArray)
		for position in self.undeclared 'eachUndeclared'
			into.push(position)
		end 'eachUndeclared'
	end 'undeclaredInto'

	module function hasUndeclared() returns bool
		return not self.undeclared.isEmpty()
	end 'hasUndeclared'
end 'FunctionRefShapes'

module type CallSummaryIndex
	var project as Project
	var module as MaxonModule
	var signatures as ProgramSignatures
	let funcIndexByName as FuncIndexByName
	export var sites as CallSites
	var conformers as ConformersByInterface
	var witnessSlots as WitnessSlotsByDeclIndex
	var witnessImpls as WitnessImplsMemo
	var functionRefBodies as LandingContents
	var functionRefShapes as FunctionRefShapes
	var functionRefBodiesGathered as bool
	var functionValueBodies as FunctionValueBodiesMemo
	var functionValueBodiesByShape as FunctionValueBodiesMemo
	var bodiesByReaderFreeShape as FunctionValueBodiesMemo
	var readerFreeVerdicts as ReaderFreeVerdictMemo
	export var landingSets as LandingSets
	var exactLandings as ExactLandingMemo
	var landingsByContents as LandingByContents
	var callbackFlows as CallbackFlows
	var functionRefBodiless as NameRoster
	var functionRefNames as FunctionRefNamesByFunc
	var instanceHoldsARecord as InstanceRecordMemo
	var instanceSharesFunctions as InstanceRecordMemo

	module static function create(project Project, module MaxonModule, signatures ProgramSignatures, funcIndexByName FuncIndexByName, funcCount ElementIndex) returns CallSummaryIndex
		return Self{project: project, module: module, signatures: signatures, funcIndexByName: funcIndexByName, sites: CallSites.create(funcCount), conformers: ConformersByInterface.create(), witnessSlots: WitnessSlotsByDeclIndex.create(), witnessImpls: WitnessImplsMemo.create(), functionRefBodies: LandingContents.create(), functionRefShapes: FunctionRefShapes.create(), functionRefBodiesGathered: false, functionValueBodies: FunctionValueBodiesMemo.create(), functionValueBodiesByShape: FunctionValueBodiesMemo.create(), bodiesByReaderFreeShape: FunctionValueBodiesMemo.create(), readerFreeVerdicts: ReaderFreeVerdictMemo.create(), landingSets: LandingSets.create(funcCount), exactLandings: ExactLandingMemo.create(), landingsByContents: LandingByContents.create(), callbackFlows: CallbackFlows.create(), functionRefBodiless: NameRoster.create(0), functionRefNames: FunctionRefNamesByFunc.create(), instanceHoldsARecord: InstanceRecordMemo.create(), instanceSharesFunctions: InstanceRecordMemo.create()}
	end 'create'

	module function summarizedIndexOf(callee ByteArray) returns ElementIndex throws AbsentError
		let index = try self.funcIndexByName.get(callee) otherwise throw AbsentError.absent

		if not self.project.funcSignatures.contains(callee) or not self.implHasSummary(index) 'noSummaryDescribesIt'
			throw AbsentError.absent
		end 'noSummaryDescribesIt'

		return index
	end 'summarizedIndexOf'

	module function classifyCallee(func IrFunction, callee ByteArray) returns CalleeClass
		if let index = try self.summarizedIndexOf(callee) 'aSummaryDescribesIt'
			return CalleeClass.summarized(index)
		end 'aSummaryDescribesIt'

		if let index = try self.funcIndexByName.get(callee) 'declared'
			if self.project.funcSignatures.contains(callee) and self.implBodyWasSkipped(index) 'anAbandonedBody'
				return CalleeClass.refused
			end 'anAbandonedBody'
		end 'declared'

		if self.project.poison.refusesACalleeFrom(callee, reader: func.sourceFilePath, signatures: self.signatures) 'aDeclarationIsRefused'
			return CalleeClass.refused
		end 'aDeclarationIsRefused'

		return CalleeClass.runtime
	end 'classifyCallee'

	module function implHasSummary(index ElementIndex) returns bool
		return not bodyIsUnreadable(self.functionAt(index))
	end 'implHasSummary'

	module function implBodyWasSkipped(index ElementIndex) returns bool
		return self.functionAt(index).bodyStatus != BodyStatus.parsed
	end 'implBodyWasSkipped'

	function functionAt(index ElementIndex) returns IrFunction
		return try self.module.functions.get(index) otherwise panic("CallSummaryIndex.functionAt: function index {index} is past the module's functions")
	end 'functionAt'

	module function declaresFunction(name ByteArray) returns bool
		return self.funcIndexByName.contains(name)
	end 'declaresFunction'

	module function functionIndexNamed(name ByteArray) returns ElementIndex throws MapError
		return try self.funcIndexByName.get(name)
	end 'functionIndexNamed'

	module function functionIndexOf(name ByteArray) returns ElementIndex
		return try self.funcIndexByName.get(name) otherwise panic("CallSummaryIndex.functionIndexOf: '{String.from(name)}' is no function of this module")
	end 'functionIndexOf'

	module function signatureOf(callee ByteArray) returns FuncSignature
		return try self.project.funcSignatures.get(callee) otherwise panic("CallSummaryIndex.signatureOf: '{String.from(callee)}' is no declared function — the caller asked `classifyCallee` first")
	end 'signatureOf'

	module function witnessSlotOf(methodIndex WitnessMethodIndex, interfaceDeclIndex ElementIndex) returns CollectedInterfaceMethod
		return witnessSlotAt(self.signatures, interfaces: self.signatures.interfaceMap(), witnessSlots: self.witnessSlots, interfaceDeclIndex: interfaceDeclIndex, methodIndex: methodIndex)
	end 'witnessSlotOf'

	module function implsOf(methodIndex WitnessMethodIndex, interfaceDeclIndex ElementIndex) returns CallLandingBodies
		let key = witnessSlotKeyOf(interfaceDeclIndex, methodIndex: methodIndex)

		if let memoized = try self.witnessImpls.get(key) 'asked'
			return memoized
		end 'asked'

		let found = self.registerLanding(witnessDispatchImpls(self.project, signatures: self.signatures, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, funcIndexByName: self.funcIndexByName, conformers: self.conformers, witnessSlots: self.witnessSlots))
		self.witnessImpls.upsert(key, value: found)
		return found
	end 'implsOf'

	// The narrowest answer that holds. A callee a `functionRef` of `func` minted lands on that one
	// body. A parameter whose function type mentions a type parameter lands on the bodies its callers
	// hand it (`CallbackFlows.landingOf`), because the shape answer admits every function value that
	// agrees under some instantiation. Any other callee lands on the shape answer.
	module function functionValueBodiesCalledThrough(func IrFunction, callee ValueId) returns CallLandingBodies
		if let target = try self.functionRefTargetOf(func, value: callee) 'aFunctionRefResult'
			if isFunctionValueBodyName(target, funcSignatures: self.project.funcSignatures) 'aFunctionValueBody'
				if let index = try self.funcIndexByName.get(target) 'theExactBody'
					return self.exactLanding(index)
				end 'theExactBody'
			end 'aFunctionValueBody'
		end 'aFunctionRefResult'

		if let position = try self.callbackParameterPositionOf(func, callee: callee) 'aCallbackTypedOverATypeParameter'
			let flows = self.callbackFlows
			return flows.landingOf(self.project, module: self.module, calls: self, funcIndex: self.functionIndexOf(func.name), position: position)
		end 'aCallbackTypedOverATypeParameter'

		return self.functionValueBodiesOfType(functionValueOwnTypeName(self.project, func: func, value: callee), readerFilePath: func.sourceFilePath)
	end 'functionValueBodiesCalledThrough'

	function exactLanding(index ElementIndex) returns CallLandingBodies
		if let memoized = try self.exactLandings.get(index) 'asked'
			return memoized
		end 'asked'

		let contents = LandingContents.create()
		contents.impls.push(index)
		let landing = self.registerLanding(contents)
		self.exactLandings.upsert(index, value: landing)
		return landing
	end 'exactLanding'

	// A call through a function value lands only on a function used as a value whose shape agrees with the
	// callee value's function type under some instantiation of the type parameters that type mentions.
	// A type that mentions none asks the agreement every door a function value passes through asks.
	module function functionValueBodiesOfType(calleeType ByteArray, readerFilePath FilePath) returns CallLandingBodies
		let memoKey = functionValueBodiesKey(calleeType, readerFilePath: readerFilePath)

		if let memoized = try self.functionValueBodies.get(memoKey) 'asked'
			return memoized
		end 'asked'

		let registry = functionTypeRegistryOf(self.project)
		self.gatherFunctionRefBodies()

		if functionShapeIsMissingBesideAFailedFile(self.project, registry: registry, name: calleeType) 'itsDeclaringFileFailedToParse'
			let none = self.registerLanding(LandingContents.create())
			self.functionValueBodies.upsert(memoKey, value: none)
			return none
		end 'itsDeclaringFileFailedToParse'

		let calleeShape = requireFunctionShapeOf(registry, name: calleeType, side: "called")
		let shapeKey = calleeShape.identityKey()

		if let readerFree = try self.bodiesByReaderFreeShape.get(shapeKey) 'everyReaderAgreesTheSame'
			self.functionValueBodies.upsert(memoKey, value: readerFree)
			return readerFree
		end 'everyReaderAgreesTheSame'

		let readerShapeKey = functionValueBodiesKey(shapeKey, readerFilePath: readerFilePath)

		if let sameShape = try self.functionValueBodiesByShape.get(readerShapeKey) 'anotherNameOfTheShape'
			self.functionValueBodies.upsert(memoKey, value: sameShape)
			return sameShape
		end 'anotherNameOfTheShape'

		let (found, readerFree) = self.bodiesAgreeingWith(calleeShape, shapeKey: shapeKey, registry: registry, readerFilePath: readerFilePath)

		if readerFree 'noReaderWasAsked'
			self.bodiesByReaderFreeShape.upsert(shapeKey, value: found)
		end 'noReaderWasAsked' else 'aReaderWasAsked'
			self.functionValueBodiesByShape.upsert(readerShapeKey, value: found)
		end 'aReaderWasAsked'

		self.functionValueBodies.upsert(memoKey, value: found)
		return found
	end 'functionValueBodiesOfType'

	function bodiesAgreeingWith(calleeShape FunctionShape, shapeKey immutable ByteArray, registry FunctionTypeRegistry, readerFilePath FilePath) returns (CallLandingBodies, bool)
		let agreeing = FuncIndexArray.create(0)
		var readerFree = true
		let callee = calleeShape.agreementParts()
		let candidates = self.functionRefShapes.candidatesFor(calleeShape, mentionsATypeParameter: functionShapeMentionsATypeParameter(registry, signatures: self.signatures, shape: calleeShape))

		for bucket in candidates 'eachCandidate'
			let bodyShape = self.functionRefShapes.shapeOfBucket(bucket)

			if not callee.readsNoReaderAgainst(bodyShape.agreementParts()) 'dependsOnTheReader'
				readerFree = false

				if functionShapesAgreeUnderSomeInstantiation(registry, signatures: self.signatures, declared: calleeShape, got: bodyShape, readerFilePath: readerFilePath) 'agreesForThisReader'
					agreeing.push(bucket)
				end 'agreesForThisReader'

				continue
			end 'dependsOnTheReader'

			if self.readerFreeVerdict(calleeShape, shapeKey: shapeKey, bucket: bucket, registry: registry, readerFilePath: readerFilePath) 'agrees'
				agreeing.push(bucket)
			end 'agrees'
		end 'eachCandidate'

		let contentsKey = self.landingContentsKey(agreeing)

		if let sameContents = try self.internedLanding(contentsKey) 'anotherReaderAgreedTheSame'
			return (sameContents, readerFree)
		end 'anotherReaderAgreedTheSame'

		return (self.internLanding(contentsKey, contents: self.contentsOfBuckets(agreeing)), readerFree)
	end 'bodiesAgreeingWith'

	function readerFreeVerdict(calleeShape FunctionShape, shapeKey immutable ByteArray, bucket ElementIndex, registry FunctionTypeRegistry, readerFilePath FilePath) returns bool
		let verdicts = try self.readerFreeVerdicts.get(shapeKey) otherwise self.openVerdicts(shapeKey)

		if let known = try verdicts.get(bucket) 'asked'
			return known
		end 'asked'

		let agrees = functionShapesAgreeUnderSomeInstantiation(registry, signatures: self.signatures, declared: calleeShape, got: self.functionRefShapes.shapeOfBucket(bucket), readerFilePath: readerFilePath)
		verdicts.upsert(bucket, value: agrees)
		return agrees
	end 'readerFreeVerdict'

	function openVerdicts(shapeKey immutable ByteArray) returns BucketVerdicts
		let verdicts = BucketVerdicts.create()
		self.readerFreeVerdicts.upsert(shapeKey, value: verdicts)
		return verdicts
	end 'openVerdicts'

	// Landings of equal contents are one set, so the sites that land on the same bodies share its
	// per-set memos and its classes rather than each judging every body again.
	module function internedLanding(contentsKey ByteArray) returns CallLandingBodies throws MapError
		return try self.landingsByContents.get(contentsKey)
	end 'internedLanding'

	module function internLanding(contentsKey immutable ByteArray, contents LandingContents) returns CallLandingBodies
		let landing = self.registerLanding(contents)
		self.landingsByContents.upsert(contentsKey, value: landing)
		return landing
	end 'internLanding'

	function landingContentsKey(agreeing FuncIndexArray) returns immutable ByteArray
		var key = "agreeing|{self.functionRefBodies.unresolved}|{self.functionRefBodies.unresolvedMayStore}|{self.functionRefShapes.hasUndeclared()}"

		for bucket in agreeing 'eachAgreeingBucket'
			key.append("|{bucket}")
		end 'eachAgreeingBucket'

		return freeze key.toByteArray()
	end 'landingContentsKey'

	function contentsOfBuckets(agreeing FuncIndexArray) returns LandingContents
		let positions = FuncIndexArray.create(0)
		var sources = 0 as ElementIndex

		if self.functionRefShapes.hasUndeclared() 'someBodyDeclaresNoShape'
			self.functionRefShapes.undeclaredInto(positions)
			sources = sources + 1
		end 'someBodyDeclaresNoShape'

		for bucket in agreeing 'eachAgreeingBucket'
			self.functionRefShapes.positionsInto(bucket, into: positions)
			sources = sources + 1
		end 'eachAgreeingBucket'

		// Back into gathering order: a diagnostic names the first member that qualifies,
		// so bucket order would change which body it names.
		if sources > 1 'severalLists'
			positions.sort()
		end 'severalLists'

		let found = LandingContents.create()
		found.unresolved = self.functionRefBodies.unresolved
		found.unresolvedMayStore = self.functionRefBodies.unresolvedMayStore

		for position in positions 'eachPosition'
			found.impls.push(try self.functionRefBodies.impls.get(position) otherwise panic("CallSummaryIndex.contentsOfBuckets: position {position} is past the {self.functionRefBodies.impls.count()} function-reference bodies"))
		end 'eachPosition'

		return found
	end 'contentsOfBuckets'

	module function registerLanding(contents LandingContents) returns CallLandingBodies
		let participants = FuncIndexArray.create(0)

		for impl in contents.impls 'eachMember'
			if not self.implBodyWasSkipped(impl) 'inThisProgram'
				self.requireSignature(impl)
				participants.push(impl)
			end 'inThisProgram'
		end 'eachMember'

		return self.landingSets.add(contents, participants: participants)
	end 'registerLanding'

	// Set members are always signed: a member's profile reads its declared parameters, which are one fewer than
	// its IR slots for a closure (the environment slot).
	function requireSignature(impl ElementIndex)
		let name = self.functionAt(impl).name

		if not self.project.funcSignatures.contains(name) 'noSignature'
			panic("CallSummaryIndex.registerLanding: '{String.from(name)}' has no signature, and a landing set holds only bodies whose parameters a signature declares")
		end 'noSignature'
	end 'requireSignature'

	module function functionRefTargetOf(func IrFunction, value ValueId) returns immutable ByteArray throws AbsentError
		let funcIndex = self.functionIndexOf(func.name)

		if let names = try self.functionRefNames.get(funcIndex) 'gathered'
			return try names.get(value) otherwise throw AbsentError.absent
		end 'gathered'

		let names = FunctionRefNameMap.create()

		for opIdx in self.module.liveOpIndices(func) 'eachOp'
			let op = try self.module.ops.get(opIdx) otherwise panic("CallSummaryIndex.functionRefTargetOf: opIdx {opIdx} from liveOpIndices is not in module.ops")

			match maxonOpCalleeKind(op) 'calleeKind'
				functionValue then names.upsert(try maxonOpDefinedValue(op) otherwise panic("CallSummaryIndex.functionRefTargetOf: a `functionRef` defines its result"), value: maxonOpCalleeName(op))
				direct then self.noteClosureRecordTarget(func, op: op, opIdx: opIdx, names: names)
				noCallee then continue
			end 'calleeKind'
		end 'eachOp'

		self.functionRefNames.upsert(funcIndex, value: names)
		return try names.get(value) otherwise throw AbsentError.absent
	end 'functionRefTargetOf'

	function noteClosureRecordTarget(func IrFunction, op MaxonOp, opIdx ElementIndex, names FunctionRefNameMap)
		match op 'record'
			call(result, callee, _, _, _, _, _) then self.noteBoxedClosure(func, result: result, callee: callee, opIdx: opIdx, names: names)
			tryCall or
			asyncCall or
			serviceSpawn or
			serviceSend then return
			default panic("CallSummaryIndex.noteClosureRecordTarget: maxonOpCalleeKind answers direct for an op that is not call, tryCall, asyncCall, serviceSpawn or serviceSend")
		end 'record'
	end 'noteClosureRecordTarget'

	function noteBoxedClosure(func IrFunction, result ValueId, callee ByteArray, opIdx ElementIndex, names FunctionRefNameMap)
		if not callee.equals(MmAllocName) or not self.project.closureRecordSites.contains(opIdx) 'notAClosureRecord'
			return
		end 'notAClosureRecord'

		let target = functionValueOwnTypeName(self.project, func: func, value: result)

		if isLiftedClosureName(target) 'aLiftedClosure'
			names.upsert(result, value: target)
		end 'aLiftedClosure'
	end 'noteBoxedClosure'

	module function callbackParameterPositionOf(func IrFunction, callee ValueId) returns ParamCount throws AbsentError
		if not self.callsATypeParameterCallback(func, callee: callee) 'notACallbackParameter'
			throw AbsentError.absent
		end 'notACallbackParameter'

		return paramPositionOfValueId(callee)
	end 'callbackParameterPositionOf'

	module function callsATypeParameterCallback(func IrFunction, callee ValueId) returns bool
		if callee >= valueIdAtParamPosition(func.paramCount) 'notAParameter'
			return false
		end 'notAParameter'

		let registry = functionTypeRegistryOf(self.project)
		let calleeType = functionValueOwnTypeName(self.project, func: func, value: callee)

		if functionShapeIsMissingBesideAFailedFile(self.project, registry: registry, name: calleeType) 'itsDeclarationWasRefused'
			return false
		end 'itsDeclarationWasRefused'

		return functionShapeMentionsATypeParameter(registry, signatures: self.signatures, shape: requireFunctionShapeOf(registry, name: calleeType, side: "called"))
	end 'callsATypeParameterCallback'

	function gatherFunctionRefBodies()
		if self.functionRefBodiesGathered 'gathered'
			return
		end 'gathered'

		self.functionRefBodiesGathered = true
		let bodies = LandingContents.create()
		let named = FixedBoolArray.create(self.module.functions.count())

		for op in self.module.ops 'eachOp'
			if maxonOpCalleeKind(op) == MaxonCalleeKind.functionValue 'aFunctionRef'
				noteFunctionRefBody(maxonOpCalleeName(op), byName: self.funcIndexByName, named: named, funcSignatures: self.project.funcSignatures, into: bodies, bodiless: self.functionRefBodiless)
			end 'aFunctionRef'
		end 'eachOp'

		self.functionRefBodies = bodies

		let registry = functionTypeRegistryOf(self.project)

		for (iter, index) in bodies.impls.withIterator() 'eachBody'
			self.functionRefShapes.note(iter.index(), shape: declaredFunctionShapeOf(registry, name: self.functionAt(index).name))
		end 'eachBody'

		self.functionRefShapes.seal()
	end 'gatherFunctionRefBodies'

	module function mayHoldARecord(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tagIsOpaqueRecord(tag) 'mayBeAContainer'
			return true
		end 'mayBeAContainer'

		if tag != ValueTypeTag.genericInstance 'notAContainer'
			return false
		end 'notAContainer'

		let gid = instanceIdOfValue(func, value: value)

		if let memoized = try self.instanceHoldsARecord.get(gid) 'asked'
			return memoized
		end 'asked'

		let holds = self.signatures.instanceArgsMayHoldARecord(gid, textIsARecord: true)
		self.instanceHoldsARecord.upsert(gid, value: holds)
		return holds
	end 'mayHoldARecord'

	// An append clones records it can classify, but a function value is shared when copied, so an append whose
	// elements may be functions stores the source's elements into its receiver.
	//
	// Callers classify the callee `runtime` (`classifyCallee`) before asking; a summarized or refused
	// callee is not a runtime entry.
	module function runtimeShapeOf(func IrFunction, callee ByteArray, args ValueIdArray) returns RuntimeStoreShape
		if copiesItsSourceCallee(callee) and args.count() > 0 and self.appendSharesFunctions(func, receiver: try args.get(0) otherwise panic("CallSummaryIndex.runtimeShapeOf: an append has a receiver")) 'sharesTheSourcesFunctions'
			return RuntimeStoreShape.theSourcesElementsIntoTheReceiver
		end 'sharesTheSourcesFunctions'

		return runtimeCalleeStoreShape(callee)
	end 'runtimeShapeOf'

	function appendSharesFunctions(func IrFunction, receiver ValueId) returns bool
		let tag = valueTagOf(func, value: receiver)

		if tagIsOpaqueRecord(tag) 'anyElement'
			return true
		end 'anyElement'

		if tag != ValueTypeTag.genericInstance 'notAContainer'
			return false
		end 'notAContainer'

		let gid = instanceIdOfValue(func, value: receiver)

		if let memoized = try self.instanceSharesFunctions.get(gid) 'asked'
			return memoized
		end 'asked'

		let shares = self.signatures.containerElementMayHoldAFunction(gid)
		self.instanceSharesFunctions.upsert(gid, value: shares)
		return shares
	end 'appendSharesFunctions'
end 'CallSummaryIndex'

module type CallSiteCursor
	export var resolution as CallSummaryIndex
	export var dependencies as CallDependencies
	export var landing as LandingClasses
	export let noArgRanges as SourceRangeArray
	var firstRow as ElementIndex
	var cursor as ElementIndex
	var resolving as bool
	var argPositions as ParamCountArray
	var argFills as BoolArray

	module static function create(resolution CallSummaryIndex) returns CallSiteCursor
		return Self{resolution: resolution, landing: LandingClasses.create(resolution), noArgRanges: SourceRangeArray.create(0), dependencies: CallDependencies.create(), firstRow: 0, cursor: 0, resolving: false, argPositions: ParamCountArray.create(0), argFills: BoolArray.create(0)}
	end 'create'

	module function beginWalk(index ElementIndex)
		if let filed = try self.resolution.sites.ranges.firstRowOf(index) 'callsAlreadyResolved'
			self.resolving = false
			self.firstRow = filed
		end 'callsAlreadyResolved' else 'theFirstWalkOfThisBody'
			self.resolving = true
			self.firstRow = self.resolution.sites.nextRow()
		end 'theFirstWalkOfThisBody'
	end 'beginWalk'

	module function startPass()
		self.cursor = self.firstRow
	end 'startPass'

	module function finishPass(index ElementIndex)
		if self.resolving 'filedThisPass'
			self.resolution.sites.closeRows(index, firstRow: self.firstRow)
			self.resolving = false
			return
		end 'filedThisPass'

		self.requireMetEveryCallSite(index)
	end 'finishPass'

	module function replay(index ElementIndex)
		self.resolving = false
		self.cursor = try self.resolution.sites.ranges.firstRowOf(index) otherwise panic("CallSiteCursor.replay: function {index} has filed no calls — a body is replayed only after a walk of it")
	end 'replay'

	module function requireMetEveryCallSite(index ElementIndex)
		if self.cursor != self.resolution.sites.ranges.stopRowOf(index) 'outOfStep'
			panic("CallSiteCursor.requireMetEveryCallSite: function {index} stopped at call-site row {self.cursor}, not the {self.resolution.sites.ranges.stopRowOf(index)} its first walk filed")
		end 'outOfStep'
	end 'requireMetEveryCallSite'

	module function position() returns ElementIndex
		return self.cursor
	end 'position'

	module function seek(row ElementIndex)
		self.cursor = row
	end 'seek'

	module function takeCallSite() returns ElementIndex
		let site = self.cursor
		self.cursor = site + 1
		return site
	end 'takeCallSite'

	module function nextCallSite(func IrFunction, callee ByteArray, args ValueIdArray, argLabels NameRoster) returns ElementIndex
		let site = self.takeCallSite()

		if not self.resolving 'filed'
			return site
		end 'filed'

		let sites = self.resolution.sites

		if site != sites.nextRow() 'outOfStep'
			panic("CallSiteCursor.nextCallSite: call {site} of a body being resolved is not the next row ({sites.nextRow()})")
		end 'outOfStep'

		match self.resolution.classifyCallee(func, callee: callee) 'calleeClass'
			summarized(calleeIndex) then self.fileDescribedCall(calleeIndex, callee: callee, args: args, argLabels: argLabels)
			refused then self.resolution.sites.fileRuntimeRow(RuntimeStoreShape.nothing)
			runtime then self.resolution.sites.fileRuntimeRow(self.resolution.runtimeShapeOf(func, callee: callee, args: args))
		end 'calleeClass'

		return site
	end 'nextCallSite'

	function fileDescribedCall(calleeIndex ElementIndex, callee ByteArray, args ValueIdArray, argLabels NameRoster)
		self.slotNamedArgs(self.resolution.signatureOf(callee), args: args, argLabels: argLabels)
		self.resolution.sites.fileDescribedRow(calleeIndex, slottedArgs: self.argPositions, fills: self.argFills)
	end 'fileDescribedCall'

	module function slotCallSiteArgs(row ElementIndex, argCount ParamCount)
		self.argPositions.clear()
		self.argFills.clear()

		for i in 0 upto argCount 'eachArg'
			if let slot = try self.resolution.sites.argPositionAt(row, argIndex: i as ParamCount) 'fillsAParameter'
				self.pushFilledArg(slot)
			end 'fillsAParameter' else 'fillsNone'
				self.pushUnfilledArg(i)
			end 'fillsNone'
		end 'eachArg'
	end 'slotCallSiteArgs'

	module function slotNamedArgs(sig FuncSignature, args ValueIdArray, argLabels NameRoster)
		self.argPositions.clear()
		self.argFills.clear()

		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("CallSiteCursor.slotNamedArgs: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")

			if let slot = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) 'fillsAParameter'
				self.pushFilledArg(slot)
			end 'fillsAParameter' else 'fillsNone'
				self.pushUnfilledArg(i as ParamCount)
			end 'fillsNone'
		end 'eachArg'
	end 'slotNamedArgs'

	module function slotPositionalArgs(argCount ParamCount)
		self.argPositions.clear()
		self.argFills.clear()

		for i in 0 upto argCount 'eachArg'
			self.pushFilledArg(i)
		end 'eachArg'
	end 'slotPositionalArgs'

	function pushFilledArg(slot ParamCount)
		self.argPositions.push(slot)
		self.argFills.push(true)
	end 'pushFilledArg'

	function pushUnfilledArg(argIndex ParamCount)
		self.argPositions.push(argIndex)
		self.argFills.push(false)
	end 'pushUnfilledArg'

	module function argPositionAt(i ParamCount) returns ParamCount throws MapError
		if not (try self.argFills.get(i) otherwise panic("CallSiteCursor.argPositionAt: argument {i} is past the {self.argFills.count()} slotted")) 'fillsNoParameter'
			throw MapError.keyNotFound
		end 'fillsNoParameter'

		return try self.argPositions.get(i) otherwise panic("CallSiteCursor.argPositionAt: argument {i} is past the {self.argPositions.count()} slotted")
	end 'argPositionAt'
end 'CallSiteCursor'

module function instanceIdOfValue(func IrFunction, value ValueId) returns GenericInstanceId
	return (try func.valueNameIds.get(value) otherwise panic("instanceIdOfValue: v{value} of '{String.from(func.name)}' has no type name — the type columns are minted in lockstep")) as GenericInstanceId
end 'instanceIdOfValue'

// Positions into another column: its entries, or the start of each group of them.
module typealias EntryIndexArray = Array with ElementIndex

// A run of rows filed for one function in a column every function appends to — the calls a walk resolves
// and the parameter edges a trace files are both held that way, so the range bookkeeping and the one mark
// for "nothing filed for this function yet" are written once.
module enum FunctionRowsLookup implements Error
	unfiled
end 'FunctionRowsLookup'

export type FunctionRows
	var firstRows as OptionalElementIndexColumn
	var stopRows as OptionalElementIndexColumn

	export static function create(funcCount ElementIndex) returns FunctionRows
		return Self{firstRows: OptionalElementIndexColumn.absent(funcCount), stopRows: OptionalElementIndexColumn.absent(funcCount)}
	end 'create'

	// `funcIndex`'s rows are `[firstRow, stopRow)`. Filing again replaces the range, which is what a
	// re-trace does.
	export function file(funcIndex ElementIndex, firstRow ElementIndex, stopRow ElementIndex)
		self.requireFunction(funcIndex)
		self.firstRows.set(funcIndex, value: firstRow)
		self.stopRows.set(funcIndex, value: stopRow)
	end 'file'

	module function firstRowOf(funcIndex ElementIndex) returns ElementIndex throws FunctionRowsLookup
		self.requireFunction(funcIndex)
		return try self.firstRows.get(funcIndex) otherwise throw FunctionRowsLookup.unfiled
	end 'firstRowOf'

	export function stopRowOf(funcIndex ElementIndex) returns ElementIndex
		self.requireFunction(funcIndex)
		return try self.stopRows.get(funcIndex) otherwise panic("FunctionRows.stopRowOf: nothing is filed for function {funcIndex} — a caller reads the first row before the stop")
	end 'stopRowOf'

	function requireFunction(funcIndex ElementIndex)
		if funcIndex >= self.firstRows.count() 'pastTheFunctions'
			panic("FunctionRows: function {funcIndex} is past the tracer's function count")
		end 'pastTheFunctions'
	end 'requireFunction'
end 'FunctionRows'

typealias RuntimeStoreShapeArray = Array with RuntimeStoreShape

// ⭐ **EACH TRACED BODY'S CALLS AS A WALK READS THEM, RESOLVED ON THE BODY'S FIRST WALK AND KEYED BY ITS
// FUNCTION INDEX.** A call's callee and labels do not change while the tracer lives, and a walk meets every
// call of a body at every pass of every trace, so answering by
// name at each meeting (the function and signature indexes, the labels against the parameter names, the
// runtime rosters' comparisons) pays many times over for one answer.
//
// A body's rows are its `FunctionRows` range, in the order every pass of a walk meets its calls. A row is
// DESCRIBED when a summary answers for its callee (`classifyCallee`) and then names an entry
// of the described columns; otherwise it names an entry of the runtime columns.
export type CallSites
	export var ranges as FunctionRows
	var described as BoolArray
	var entries as EntryIndexArray

	// A described callee's index, and each argument's parameter position and whether it fills one, from
	// `argStarts`.
	var callees as FuncIndexArray
	var argStarts as EntryIndexArray
	var argPositions as ParamCountArray
	var argFills as BoolArray

	// A callee no summary describes: where it may store what it was handed, and the runtime families it belongs to.
	var shapes as RuntimeStoreShapeArray

	export static function create(funcCount ElementIndex) returns CallSites
		return Self{ranges: FunctionRows.create(funcCount), described: BoolArray.create(0), entries: EntryIndexArray.create(0), callees: FuncIndexArray.create(0), argStarts: EntryIndexArray.create(0), argPositions: ParamCountArray.create(0), argFills: BoolArray.create(0), shapes: RuntimeStoreShapeArray.create(0)}
	end 'create'

	export function nextRow() returns ElementIndex
		return self.described.count()
	end 'nextRow'

	export function closeRows(funcIndex ElementIndex, firstRow ElementIndex)
		self.ranges.file(funcIndex, firstRow: firstRow, stopRow: self.described.count())
	end 'closeRows'

	export function fileDescribedRow(calleeIndex ElementIndex, slottedArgs ParamCountArray, fills BoolArray)
		self.described.push(true)
		self.entries.push(self.callees.count())
		self.callees.push(calleeIndex)
		self.argStarts.push(self.argPositions.count())
		self.argPositions.append(slottedArgs)
		self.argFills.append(fills)
	end 'fileDescribedRow'

	export function fileRuntimeRow(shape RuntimeStoreShape)
		self.described.push(false)
		self.entries.push(self.shapes.count())
		self.shapes.push(shape)
	end 'fileRuntimeRow'

	export function rowIsDescribed(row ElementIndex) returns bool
		return try self.described.get(row) otherwise panic("CallSites.rowIsDescribed: described.get OOB at call-site row {row}")
	end 'rowIsDescribed'

	function entryAt(row ElementIndex) returns ElementIndex
		return try self.entries.get(row) otherwise panic("CallSites.entryAt: entries.get OOB at call-site row {row}")
	end 'entryAt'

	export function calleeAt(row ElementIndex) returns ElementIndex
		return try self.callees.get(self.entryAt(row)) otherwise panic("CallSites.calleeAt: callees.get OOB at described call-site row {row}")
	end 'calleeAt'

	export function argPositionAt(row ElementIndex, argIndex ParamCount) returns ParamCount throws MapError
		let at = (try self.argStarts.get(self.entryAt(row)) otherwise panic("CallSites.argPositionAt: argStarts.get OOB at described call-site row {row}")) + argIndex

		if not (try self.argFills.get(at) otherwise panic("CallSites.argPositionAt: argFills.get OOB at {at}")) 'fillsNoParameter'
			throw MapError.keyNotFound
		end 'fillsNoParameter'

		return try self.argPositions.get(at) otherwise panic("CallSites.argPositionAt: argPositions.get OOB at {at}")
	end 'argPositionAt'

	export function shapeAt(row ElementIndex) returns RuntimeStoreShape
		return try self.shapes.get(self.entryAt(row)) otherwise panic("CallSites.shapeAt: shapes.get OOB at runtime call-site row {row}")
	end 'shapeAt'
end 'CallSites'

// The body a `functionRef` names, once. A name `isFunctionValueBodyName` refuses is a container
// descriptor's release or copy routine, which the runtime's own walk calls and no function value
// reaches (`Parser.emitCodeAddress`). The `__` prefix alone does not decide it: a batched spec case
// runs inside `__spec_case_<n>`, so its lifted closures wear the prefix and are ordinary function
// values. Any other name no function of the module answers to is a body no summary describes.
function noteFunctionRefBody(name ByteArray, byName FuncIndexByName, named FixedBoolArray, funcSignatures FuncSignatureMap, into LandingContents, bodiless NameRoster)
	if not isFunctionValueBodyName(name, funcSignatures: funcSignatures) 'aDescriptorRoutine'
		return
	end 'aDescriptorRoutine'

	let index = try byName.get(name) otherwise 'noBodyOfThisModule'
		into.unresolved = true
		into.unresolvedMayStore = true
		bodiless.push(name)
		return
	end 'noBodyOfThisModule'

	if not (try named.get(index) otherwise panic("noteFunctionRefBody: function index {index} is past the module's functions")) 'firstMention'
		try named.set(index, value: true) otherwise panic("noteFunctionRefBody: named.set OOB at {index}")
		into.impls.push(index)
	end 'firstMention'
end 'noteFunctionRefBody'

function tagIsOpaqueRecord(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef
end 'tagIsOpaqueRecord'

// Does a callee of this shape store into argument `receiverIndex`?
module function shapeStoresInto(shape RuntimeStoreShape, receiverIndex ParamCount) returns bool
	return match shape 'shape'
		intoAnyOperand gives true
		intoTheReceiver or
		intoTheReceiverPastAnAnchor or
		theSourcesElementsIntoTheReceiver gives receiverIndex == RuntimeStoreReceiverIndex
		nothing gives false
	end 'shape'
end 'shapeStoresInto'

// Does a callee of this shape store argument `storedIndex` (into a receiver other than it)?
module function shapeStoresOperand(shape RuntimeStoreShape, storedIndex ParamCount) returns bool
	return match shape 'shape'
		intoAnyOperand or
		intoTheReceiver gives true
		intoTheReceiverPastAnAnchor gives storedIndex > RuntimeStoreAnchorIndex
		theSourcesElementsIntoTheReceiver gives storedIndex == RuntimeStoreSourceIndex
		nothing gives false
	end 'shape'
end 'shapeStoresOperand'

// A container mutator stores into its first operand, and an interior insertion's second operand is the node
// it inserts beside, which it only reads (`RuntimeStoreShape`).
let RuntimeStoreReceiverIndex = 0

let RuntimeStoreAnchorIndex = 1

let RuntimeStoreSourceIndex = 1

module function valueTagOf(func IrFunction, value ValueId) returns ValueTypeTag
	return try func.valueTags.get(value) otherwise panic("valueTagOf: v{value} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
end 'valueTagOf'

module typealias FuncIndexRows = Array with FuncIndexArray
