// The raw values are the line prefixes `tests/parallelCompile` and `tests/cli` pin byte for byte;
// the declaration order is the category number the DebugStream ring carries.
export enum CompilerLogGroup
	compiler = "CMP"
	lexer = "LEX"
	parser = "PAR"
	semantic = "SEM"
	ir = "IR "
	codegen = "GEN"
	binary = "BIN"
	testing = "TST"
end 'CompilerLogGroup'

// The level numbers the DebugStream ring carries and `maxon monitor` prints.
enum RingLogLevel
	error = 1
	info = 2
	debug = 3
	trace = 4
end 'RingLogLevel'

let GroupAttrKey = "group"
let UnattributedTraceUnit = 0
let SilencedRankAboveError = 1

enum LogSpecRefusal implements Error
	unknownLevel
end 'LogSpecRefusal'

typealias AcknowledgedReceiverSlot = Slot with CompileReceiver.handle

// The trace unit is the handler's own state, so `compilerLogger` reads no module storage. `attribute` arrives through the same mailbox as the records, so the unit
// it sets precedes every later record from that sender; across senders the last `attribute` wins.
type CompilerLogHandler implements LogHandler
	var unit as TraceUnit
	let acknowledged as AcknowledgedReceiverSlot

	static function create() returns CompilerLogHandler
		return Self{unit: UnattributedTraceUnit, acknowledged: AcknowledgedReceiverSlot.create("CompilerLogHandler.acknowledged")}
	end 'create'

	export function attribute(traceUnit TraceUnit)
		self.unit = traceUnit
	end 'attribute'

	export function flush() returns bool
		return true
	end 'flush'

	// The acknowledgement is sent through the stored handle so this thread frees nothing after the send: a
	// free landing after the run reads its counters moves between phase rows
	// (`identical-cold-compiles-report-identical-memory`).
	export function flushThen(receiver CompileReceiver.handle)
		self.acknowledged.replace(receiver)
		let target = self.acknowledged.held()

		try target.logFlushed(target.clone()) otherwise panic("CompilerLogHandler.flushThen: the run waiting for its log to drain refused the acknowledgement — it holds its handle until the acknowledgement arrives")
	end 'flushThen'

	export function releaseAcknowledged()
		self.acknowledged.clear()
	end 'releaseAcknowledged'

	export function handle(record immutable LogRecord) returns bool
		let group = recordGroupOf(record)

		if __DebugStream.enabled() 'ring'
			__DebugStream.text(group.ordinal, ringLogLevelOf(record.level).rawValue, self.unit, record.message)
			return true
		end 'ring'

		printError("[{group.rawValue}] {record.level.name()}: {record.message}\n")
		return true
	end 'handle'
end 'CompilerLogHandler'

type CompilerLogRoute
	export let handler as CompilerLogHandler.handle

	static function create(handler CompilerLogHandler.handle) returns CompilerLogRoute
		return Self{handler: handler}
	end 'create'
end 'CompilerLogRoute'

// The compiler's one handler, reached by `installCompilerLogHandler` and by `compileToProduct`'s
// `attribute` alike; the `LogSink` default holds it only as a `LogHandler.handle`, which has no
// `attribute`.
default CompilerLogRoute = CompilerLogRoute.create(spawn(capacity: InstrumentationMailboxCapacity) CompilerLogHandler.create())

export function installCompilerLogHandler()
	Log.setDefault(LogSink.create(CompilerLogRoute.current().handler.clone(), levels: LogLevelVar.create(LogLevels.minimum(LogLevel.info))))
end 'installCompilerLogHandler'

function attributeCompilerLogThen(unit TraceUnit, receiver CompileReceiver.handle)
	try CompilerLogRoute.current().handler.attribute(unit) otherwise (e) 'refused'
		match e 'why'
			mailboxFull then break
			serviceStopped then panic("attributeCompilerLogThen: the compiler's log handler stopped while the process still held its handle")
		end 'why'
	end 'refused'

	flushCompilerLogThen(receiver)
end 'attributeCompilerLogThen'

// A barrier: the handler is a service, so records still in its mailbox are handled after the sender
// moves on, allocating inside whatever measured bracket is open by then. A compile flushes before
// its totals close. The acknowledgement is a message to `receiver`, so a run that holds a service
// waits for it as a stage and not inside one.
function flushCompilerLogThen(receiver CompileReceiver.handle)
	try CompilerLogRoute.current().handler.flushThen(receiver) otherwise (e) 'refused'
		match e 'why'
			mailboxFull then panic("flushCompilerLogThen: the compiler's log mailbox is full, and a run that holds a service cannot wait for room")
			serviceStopped then panic("flushCompilerLogThen: the compiler's log handler stopped answering")
		end 'why'
	end 'refused'
end 'flushCompilerLogThen'

function releaseAcknowledgedCompilerLog()
	try CompilerLogRoute.current().handler.releaseAcknowledged() otherwise (e) 'refused'
		match e 'why'
			mailboxFull then break
			serviceStopped then panic("releaseAcknowledgedCompilerLog: the compiler's log handler stopped while the process still held its handle")
		end 'why'
	end 'refused'
end 'releaseAcknowledgedCompilerLog'

function recordGroupOf(record LogRecord) returns CompilerLogGroup
	let bound = try record.attrs.get(0) otherwise panic("CompilerLogHandler: a record carrying no attrs reached the compiler's handler — `compilerLogger` binds its group marker under the record's group on every compiler logger")

	if bound.key != GroupAttrKey 'notTheGroupMarker'
		panic("CompilerLogHandler: the record's first attr is '{bound.key}', not the group marker `compilerLogger` binds first")
	end 'notTheGroupMarker'

	let groupName = try bound.groups.get(0) otherwise panic("CompilerLogHandler: the record's first attr '{bound.key}' sits in no group — `compilerLogger` binds it under the logger's group")
	return try CompilerLogGroup.fromName(groupName) otherwise panic("CompilerLogHandler: '{groupName}' names no compiler log group")
end 'recordGroupOf'

export function compilerLogger(group CompilerLogGroup) returns Logger
	let bound = LogAttrArray.create(0)
	bound.push(LogAttr.int(GroupAttrKey, value: group.ordinal as LogInteger))
	return Log.default().withGroup(group.name).withAttrs(bound)
end 'compilerLogger'

function compilerLogEnabled(group CompilerLogGroup, level LogLevel) returns bool
	return level.rank >= Log.groupLevel(group.name).rank
end 'compilerLogEnabled'

export function compilerLogShowsDetail() returns bool
	for group in CompilerLogGroup.allCases 'eachGroup'
		if compilerLogEnabled(group, level: LogLevel.debug) 'showsDetail'
			return true
		end 'showsDetail'
	end 'eachGroup'

	return false
end 'compilerLogShowsDetail'

function ringLogLevelOf(level LogLevel) returns RingLogLevel
	if level.rank <= LogLevel.trace.rank 'trace'
		return RingLogLevel.trace
	end 'trace'

	if level.rank <= LogLevel.debug.rank 'debug'
		return RingLogLevel.debug
	end 'debug'

	if level.rank <= LogLevel.info.rank 'info'
		return RingLogLevel.info
	end 'info'

	return RingLogLevel.error
end 'ringLogLevelOf'

export function parseLogOption(option String) returns bool
	let parts = option.split(":")

	if parts.count() == 1 'noColon'
		Log.setLevel(try logLevelNamed(option) otherwise return false)
		return true
	end 'noColon'

	let categoryStr = try parts.get(0) otherwise return false
	let levelStr = try parts.get(1) otherwise return false
	let group = try CompilerLogGroup.fromName(categoryStr) otherwise return false

	Log.setGroupLevel(group.name, level: try logLevelNamed(levelStr) otherwise return false)
	return true
end 'parseLogOption'

function logLevelNamed(spelling String) returns LogLevel throws LogSpecRefusal
	return match spelling.toUpper() 'spelling'
		"NONE" gives LogLevel.create(LogLevel.error.rank + SilencedRankAboveError)
		"ERROR" gives LogLevel.error
		"INFO" gives LogLevel.info
		"DEBUG" gives LogLevel.debug
		"TRACE" gives LogLevel.trace
		default throws LogSpecRefusal.unknownLevel
	end 'spelling'
end 'logLevelNamed'
