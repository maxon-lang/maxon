// FrontEndPool — LEXING AND PARSING ON A POOL OF WORKER SERVICES, one per processor up to one per file dispatched.
//
// ⚠ A run under `MAXON_MAX_PROCS=1` is THIS pool with one worker in it, not a serial fallback, which is what
// makes the pinned and the default lane one code path and their outputs comparable at all. A binary whose runtime
// cannot move what a worker answers (`RuntimeMovesSharedRecords`), and a compile tallying
// allocations by tag, do the same worker's work on this thread (`FrontEndPlacement`).
//
// ⭐⭐ **WHAT MAKES A PARSE SAFE ON A WORKER IS THAT IT WRITES ONLY INTO AN OVERLAY OF ITS OWN.** A
// parse reads the whole program's signature index and writes into it while it runs
// (`ProgramSignatures.openParseBand`), so a worker parses against `ProgramSignatures.overlaying`:
// the published, read-only baseline (`FrontEndBaseline`) that every worker reads, plus tables the
// parse alone writes. The overlay is built per file on the worker's own thread and dropped when the
// parse ends, and what the parse wrote leaves inside the artifact. Everything else a message
// carries — a file's bytes, its resolved tokens, its job and its row-set answers — is a copy the
// send moves, so nothing else a worker reaches is reachable from any other thread.
//
// ⛔ **AND THE ARTIFACT HOLDS NO RECORD THE INDEX IT PARSED AGAINST HOLDS.** The answer moves, so a
// record both held would abort it (exit 96) — and would leave two threads stepping one count. The
// artifact's own doors take the copies (`ParseStaging.artifactOwnedOp`), and `closeParseBand`
// copies what it hands out.
//
// ⭐⭐ **AND THE OUTPUT DOES NOT DEPEND ON THE POOL.** Nothing lands in arrival order: streams are memoized and
// published, and parses are memoized, reported and merged, in SOURCE-PATH ORDER on this thread after the drain.
// A parse's own mints ride its artifact and are renumbered by the merge in that order
// (`ProgramSignatures.adoptParseMints`), so no output can depend on which worker parsed a file or on what that
// worker parsed before it (`tests/parallelCompile/front-end-byte-identical`).
//
// ⭐ **ONE POOL PER FRONT END, AND ONE HANDOFF PER WORKER PER BASELINE.** `queryAllModule` opens the
// pool and closes it on every exit, so the lex, the first fold, every refold and every body-demand
// round share its workers — and every one of those folds parses against the same settled index, so
// a worker is handed the baseline once. Workers are spawned as a drain needs them rather than when
// the pool opens: the lex needs no index, and a front end whose every file is memoized needs no
// worker at all.
//
// ⚠ **WHAT A WORKER STRUCTURALLY CANNOT DO** is `BackendPool`'s list: await, or be
// handed a record a second frame still owns (E3138 at the send, exit 96 at run time).

// A reply cell for each message that carries one. No message throws, so the promise names no error
// type.
typealias FrontEndReplyPromise = Promise with (FrontEndJob)
typealias FrontEndReplyPromiseArray = Array with FrontEndReplyPromise
typealias FrontEndWorkerHandleArray = Array with FrontEndWorker.handle

export typealias FrontEndRetirees = WorkerRetirees with FrontEndWorker.handle

// At most one: the worker state an in-process front end works with.
typealias FrontEndWorkerStateArray = Array with FrontEndWorkerState

export typealias FrontEndWorkArray = Array with FrontEndWork
typealias FrontEndOutcomeArray = Array with FrontEndOutcome
typealias ParseQueryArray = Array with ParseQuery

// At most one index: the baseline a pool parses against, or the index the in-process worker holds.
typealias HeldIndexArray = Array with ProgramSignatures
typealias WorkerHandoffArray = Array with WorkerHandoff
typealias FrontEndBaselineArray = Array with FrontEndBaseline
typealias LiveReachArray = Array with immutable LiveReach
typealias LiveKeysRevisionArray = Array with LiveKeysRevision

// The rows a worker measures, by the ordinal its costs are indexed with.
enum FrontEndStage
	lex
	directives
	parse
end 'FrontEndStage'

function compilePhaseOfStage(stage FrontEndStage) returns CompilePhase
	return match stage 'phase'
		lex gives CompilePhase.lex
		directives gives CompilePhase.directives
		parse gives CompilePhase.parse
	end 'phase'
end 'compilePhaseOfStage'

enum FrontEndDrainKind
	lexing
	parsing
end 'FrontEndDrainKind'

// A lexing drain runs `lex` and `directives` for a file back to back, so the two stages end
// together and are sampled and folded as one.
function drainOfStage(stage FrontEndStage) returns FrontEndDrainKind
	return match stage 'stage'
		lex or
		directives gives FrontEndDrainKind.lexing
		parse gives FrontEndDrainKind.parsing
	end 'stage'
end 'drainOfStage'

// Where a drain's jobs run. `inProcessForTally` exists because the tally reads process-wide
// counters, which concurrent workers all step, so a stage's allocations are separable only when jobs
// run one at a time. `inProcessForRuntime` wins when both apply.
enum FrontEndPlacement
	onWorkers
	inProcessForRuntime
	inProcessForTally
end 'FrontEndPlacement'

function inProcessReasonText(placement FrontEndPlacement) returns String
	return match placement 'placement'
		onWorkers panic("inProcessReasonText: the front end runs on its worker pool, so there is no reason it runs in process")
		inProcessForRuntime gives "this binary's runtime cannot move a shared-record graph"
		inProcessForTally gives "the allocation tally attributes each stage to the thread that runs it"
	end 'placement'
end 'inProcessReasonText'

// What one file's lex answers: the raw stream and the `#if`-resolved one, or the refusal that stopped either.
export union LexOutcome
	lexed(tokens TokenArray, active TokenArray)
	directiveFailed(tokens TokenArray, error DirectiveError)
	lexFailed(error LexerError)

	module function rawStream() returns TokenArray throws LexerError
		match self 'outcome'
			lexed(tokens, _) then return tokens
			directiveFailed(tokens, _) then return tokens
			lexFailed(error) then throw error
		end 'outcome'
	end 'rawStream'

	// `landed` is the raw stream the token query kept, which for a file the lexer refused is the empty stream —
	// and an empty stream filters to itself.
	module function resolvedStream(landed TokenArray) returns TokenArray throws DirectiveError
		match self 'outcome'
			lexed(_, active) then return active
			directiveFailed(_, error) then throw error
			lexFailed then return landed
		end 'outcome'
	end 'resolvedStream'
end 'LexOutcome'

// One file's work for a worker: its bytes to lex, or what its parse reads beside the signature
// index.
export union FrontEndWork
	lex(content String)
	parse(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable)
end 'FrontEndWork'

// What one file's work answered.
export union FrontEndOutcome
	lexed(outcome LexOutcome)
	parsed(outcome FileParseOutcome)
end 'FrontEndOutcome'

// One file's work on its way to a worker, in a one-slot holder the worker pops, and its answer on
// the way back in `answers`. The answer holds slices of the work's bytes and tokens, so work still
// in the holder beside it would be a second owner of what the answer carries.
export type FrontEndJob
	export var holder as FrontEndWorkArray
	export var answers as FrontEndAnswerArray

	// ⭐ **EVERY RETURN IS `Self{…}`**, which is what makes a call to one of these the argument of a send (E3138).
	static function holding(work FrontEndWork) returns FrontEndJob
		var holder = FrontEndWorkArray.create(0)
		holder.push(work)
		return Self{holder: holder, answers: FrontEndAnswerArray.create(0)}
	end 'holding'

	static function awaitingWork() returns FrontEndJob
		return Self{holder: FrontEndWorkArray.create(0), answers: FrontEndAnswerArray.create(0)}
	end 'awaitingWork'

	function takeWork() returns FrontEndWork
		return try self.holder.pop() otherwise panic("FrontEndJob.takeWork: the job carried no work — `FrontEndJob` pushes exactly one")
	end 'takeWork'

	function takeAnswer() returns FrontEndAnswer
		return try self.answers.pop() otherwise panic("FrontEndJob.takeAnswer: the job came back with no answer")
	end 'takeAnswer'

	// ⛔ **THE COPIES ARE TAKEN IN HERE AND IN `parsing`, NOT BY THE CALLER.** A temporary the caller
	// builds lives to the end of the sending statement, so the holder would share it with the sender's
	// frame at the send's walk (exit 96); one built in this statement has died by the time the record
	// is returned.
	static function lexing(content String) returns isolated FrontEndJob
		return Self.holding(FrontEndWork.lex(content.clone()))
	end 'lexing'

	// The job's strings are the project's and the index's, the row-set answers are the database's, and the tokens
	// are the memo's.
	static function parsing(query ParseQuery) returns isolated FrontEndJob
		match query 'query'
			memoized then panic("FrontEndJob.parsing: a memoized parse was dispatched — only a `needed` query is noted as a job")
			needed(job, tokens, overrides, _) then return Self.holding(FrontEndWork.parse(job.clone(), tokens: tokens.clone(), overrides: overrides.clone()))
		end 'query'
	end 'parsing'
end 'FrontEndJob'

export typealias FrontEndAnswerArray = Array with FrontEndAnswer

export type FrontEndAnswer
	export var outcome as FrontEndOutcome
	export var costs as PoolPhaseCosts

	static function of(outcome FrontEndOutcome, costs PoolPhaseCosts) returns FrontEndAnswer
		return Self{outcome: outcome, costs: costs}
	end 'of'
end 'FrontEndAnswer'

type FrontEndBaseline
	export let declarations as SettledDeclarationsCell
	export let template as IndexTemplateCell

	static function of(declarations SettledDeclarationsCell, template IndexTemplateCell) returns FrontEndBaseline
		return Self{declarations: declarations, template: template}
	end 'of'
end 'FrontEndBaseline'

// ⭐⭐ **THE WORKER: a service around `FrontEndTools`.**
//
// ⚠ **IT IS HANDED `cpu`, `os` AND THE FLAG, NOT THE PROJECT'S `ConditionFacts`**, for `BackendWorker`'s reason:
// a `spawn`'s factory arguments are MOVED, and the project keeps its `Target` for the rest of the compile.
export type FrontEndWorker
	let tools as FrontEndTools
	var baselines as FrontEndBaselineArray
	var reaches as LiveReachArray
	var slot as isolated FrontEndJob

	static function create(cpu CpuArch, os Os, debugStream bool) returns Self
		return Self{tools: FrontEndTools.create(cpu, os: os, debugStream: debugStream), baselines: FrontEndBaselineArray.create(0), reaches: LiveReachArray.create(0), slot: FrontEndJob.awaitingWork()}
	end 'create'

	// The messages. None awaits and none sends, which is what makes the blocking graph E3139 checks trivially
	// acyclic: a pool worker is a leaf.
	export function run(job isolated FrontEndJob) returns isolated FrontEndJob
		let idle = swap self.slot with job

		modify self.slot 'work'
			var work = self.slot.takeWork()
			let answer = self.answered(work)
			self.slot.answers.push(answer)
		end 'work'

		return swap self.slot with idle
	end 'run'

	export function adopt(declarations SettledDeclarationsCell, template IndexTemplateCell)
		self.baselines.clear()
		self.baselines.push(FrontEndBaseline.of(declarations, template: template))
		self.reaches.clear()
	end 'adopt'

	export function adoptLiveReach(reach immutable LiveReach)
		self.reaches.clear()
		self.reaches.push(reach)
	end 'adoptLiveReach'

	// ⚠ The baseline is released HERE, on the worker's own thread and awaited, rather than left to the
	// drop of the last handle to this service. Dropping a handle only queues the service's finish,
	// which runs when the scheduler next runs the service's runner, and the whole back end can pass
	// before that — leaving the published baseline alive across the backend peak. This is the one
	// point where no later drain can want it back.
	export function retire() returns bool
		let held = self.baselines.count() > 0
		self.baselines.clear()
		self.reaches.clear()
		return held
	end 'retire'

	function answered(work FrontEndWork) returns FrontEndAnswer
		var costs = PoolPhaseCosts.create(FrontEndStage.allCases.count())
		var probe = PhaseProbe.beginCounters()
		var outcome = self.outcomeOf(work, costs: costs, probe: probe)
		return FrontEndAnswer.of(outcome, costs: costs)
	end 'answered'

	function outcomeOf(work FrontEndWork, costs PoolPhaseCosts, probe PhaseProbe) returns FrontEndOutcome
		match work 'work'
			lex(content) then return FrontEndOutcome.lexed(self.tools.lexed(content, edges: UntalliedEdges.create(), costs: costs, probe: probe))
			parse(parseJob, tokens, overrides) then return FrontEndOutcome.parsed(self.tools.parsed(parseJob, tokens: tokens, overrides: overrides, index: self.privateIndex(), costs: costs, probe: probe))
		end 'work'
	end 'outcomeOf'

	function privateIndex() returns ProgramSignatures
		let baseline = try self.baselines.get(0) otherwise panic("FrontEndWorker.privateIndex: a parse reached a worker holding no baseline — the pool hands every worker its baseline before the first parse it dispatches")
		var index = ProgramSignatures.overlaying(baseline.declarations, template: baseline.template)

		if let reach = try self.reaches.get(0) 'filedSinceTheBaseline'
			index.adoptLiveReach(reach)
		end 'filedSinceTheBaseline'

		return index
	end 'privateIndex'
end 'FrontEndWorker'

// No edges to report: only the allocation tally watches them, and it is never handed a pooled
// worker. A type of its own because `settleTo` is `mutable self`, which the worker's state inside
// `run` cannot supply.
type UntalliedEdges implements PhaseEdges
	static function create() returns UntalliedEdges
		return Self{}
	end 'create'

	export function settleTo(phase CompilePhase)
		return
	end 'settleTo'
end 'UntalliedEdges'

type FrontEndTools
	let keywords as immutable KeywordTable
	var facts as ConditionFacts

	static function create(cpu CpuArch, os Os, debugStream bool) returns FrontEndTools
		return Self{keywords: KeywordTable.create(), facts: ConditionFacts.create(Target.create(cpu, os: os), debugStream: debugStream)}
	end 'create'

	// Each stage reports its end to `edges` right after its cost is recorded, failing or not, so the
	// tally's intervals partition the lex. The first edge closes the gap before the lex into
	// `frontEndPool`.
	function lexed(content String, edges PhaseEdges, costs PoolPhaseCosts, probe PhaseProbe) returns LexOutcome
		edges.settleTo(CompilePhase.frontEndPool)
		probe.reopenCounters()

		let tokens = try tokenize(content, keywords: self.keywords) otherwise (lexErr) 'lexFail'
			costs.record(FrontEndStage.lex.ordinal, probe: probe)
			edges.settleTo(CompilePhase.lex)
			return LexOutcome.lexFailed(lexErr)
		end 'lexFail'

		costs.record(FrontEndStage.lex.ordinal, probe: probe)
		edges.settleTo(CompilePhase.lex)
		probe.reopenCounters()

		let active = try filterConditionalTokens(tokens, facts: self.facts) otherwise (directiveErr) 'directiveFail'
			costs.record(FrontEndStage.directives.ordinal, probe: probe)
			edges.settleTo(CompilePhase.directives)
			return LexOutcome.directiveFailed(tokens, error: directiveErr)
		end 'directiveFail'

		costs.record(FrontEndStage.directives.ordinal, probe: probe)
		edges.settleTo(CompilePhase.directives)
		return LexOutcome.lexed(tokens, active: active)
	end 'lexed'

	function parsed(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable, index ProgramSignatures, costs PoolPhaseCosts, probe PhaseProbe) returns FileParseOutcome
		probe.reopenCounters()
		let outcome = parseFile(job, tokens: tokens, overrides: overrides, signatures: index)
		costs.record(FrontEndStage.parse.ordinal, probe: probe)
		return outcome
	end 'parsed'
end 'FrontEndTools'

// ⭐⭐ **WHAT THE IN-PROCESS FRONT END HOLDS AND DOES: its tools, its index, and the per-stage costs.**
//
// ⛔ **A TYPE OF ITS OWN, BECAUSE THE IN-PROCESS FRONT END MUST CALL NO MESSAGE.** A message's body walks what
// crosses with it even when it is called directly, and a binary whose runtime cannot move a shared-record graph
// aborts that walk (`FrontEndPool.RuntimeMovesSharedRecords`).
type FrontEndWorkerState
	var tools as FrontEndTools
	var ownIndex as HeldIndexArray
	export var costs as PoolPhaseCosts

	// Reopened per bracket (`PhaseProbe.reopenCounters`): a probe minted per file would be an allocation inside
	// every row it measures.
	var probe as PhaseProbe

	static function create(cpu CpuArch, os Os, debugStream bool) returns FrontEndWorkerState
		return Self{tools: FrontEndTools.create(cpu, os: os, debugStream: debugStream), ownIndex: HeldIndexArray.create(0), costs: PoolPhaseCosts.create(FrontEndStage.allCases.count()), probe: PhaseProbe.beginCounters()}
	end 'create'

	// The index every later parse reads, replacing any this worker held.
	function hold(index ProgramSignatures)
		self.ownIndex.clear()
		self.ownIndex.push(index)
	end 'hold'

	function ran(job FrontEndJob) returns FrontEndOutcome
		var work = job.takeWork()

		match work 'work'
			lex(content) then return FrontEndOutcome.lexed(self.lexed(content, edges: UntalliedEdges.create()))
			parse(parseJob, tokens, overrides) then return FrontEndOutcome.parsed(self.parsed(parseJob, tokens: tokens, overrides: overrides))
		end 'work'
	end 'ran'

	function lexed(content String, edges PhaseEdges) returns LexOutcome
		return self.tools.lexed(content, edges: edges, costs: self.costs, probe: self.probe)
	end 'lexed'

	function parsed(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable) returns FileParseOutcome
		var index = try self.ownIndex.get(0) otherwise panic("FrontEndWorkerState.parsed: a parse reached a worker holding no index — the pool hands every worker its baseline before the first parse it dispatches")
		return self.tools.parsed(job, tokens: tokens, overrides: overrides, index: index, costs: self.costs, probe: self.probe)
	end 'parsed'
end 'FrontEndWorkerState'

// What a drain hands out: the bytes of every file it lexes, or the parse of every file whose memo missed.
union FrontEndDrainInput
	lexing(project Project)
	parsing(queries ParseQueryArray)

	function kind() returns FrontEndDrainKind
		return match self 'input'
			lexing gives FrontEndDrainKind.lexing
			parsing gives FrontEndDrainKind.parsing
		end 'input'
	end 'kind'
end 'FrontEndDrainInput'

type WorkerHandoff
	export let declarations as SettledDeclarationsCell
	export let template as IndexTemplateCell

	// The revision the template's live keys are at. A fold after `holdBaseline` moves the baseline
	// past it, so a worker adopting later starts here and `refreshLiveKeys` brings it up to date;
	// starting it at the baseline's revision would leave it parsing with stale keys.
	export let liveKeysRevision as LiveKeysRevision

	static function of(signatures ProgramSignatures, os Os) returns WorkerHandoff
		let declarations = signatures.publishedDeclarations()
		let template = signatures.workerTemplate(os)
		return Self{declarations: declarations, template: template, liveKeysRevision: signatures.liveKeysRevision()}
	end 'of'
end 'WorkerHandoff'

// The driver, for one front end. The pool is sized by the most files one drain dispatched; `PoolSizing` owns
// the rule.
module type FrontEndPool
	// ⚖ **WHETHER THIS BINARY'S OWN RUNTIME CAN MOVE A GRAPH THAT REACHES ONE RECORD TWICE**, which a lexed stream and
	// a parse artifact both are. The compiler that builds this source binds it `true`
	// (`ProgramSignatures.bindBuilderCapability`), because the runtime it emits can; a binary a seed built carries the
	// seed's runtime, which aborts such a move (exit 96), so it keeps `false` and runs its front end in process.
	//
	// ⛔ It exists only to stage a build from a released seed whose runtime predates shared-record moves, and is
	// removed once a release carries that runtime.
	static let RuntimeMovesSharedRecords = false

	// Qualified, so that no declaration outside this compiler answers it.
	module static let RuntimeMovesSharedRecordsDefine = "Compiler.FrontEndPool.RuntimeMovesSharedRecords"

	var workers as FrontEndWorkerHandleArray
	var inProcess as FrontEndWorkerStateArray

	// The most files one drain of this pool dispatched — what the pool is sized to.
	var mostFilesDispatched as ElementIndex

	// The main thread's index the workers' copies are taken from — empty until the first parse is dispatched.
	var baseline as HeldIndexArray

	// At most one: `baseline`'s, and none when the front end runs in process.
	var handoffs as WorkerHandoffArray

	// By worker slot: whether that worker holds a copy of `baseline`.
	var adopted as BoolArray
	var adoptions as ElementIndex
	var overlayAllocations as AllocCount
	var indexCopyAllocations as AllocCount
	var baselineRevision as LiveKeysRevision
	var heldRevisions as LiveKeysRevisionArray

	// What the workers' answers spent, summed as they land.
	var spent as PoolPhaseCosts

	// Which stages ran on the workers, so only those rows are folded from them.
	var lexed as bool
	var parsed as bool

	module static function create() returns FrontEndPool
		return Self{workers: FrontEndWorkerHandleArray.create(0), inProcess: FrontEndWorkerStateArray.create(0), mostFilesDispatched: 0, baseline: HeldIndexArray.create(0), handoffs: WorkerHandoffArray.create(0), adopted: BoolArray.create(0), adoptions: 0, overlayAllocations: 0, indexCopyAllocations: 0, baselineRevision: 0, heldRevisions: LiveKeysRevisionArray.create(0), spent: PoolPhaseCosts.create(FrontEndStage.allCases.count()), lexed: false, parsed: false}
	end 'create'

	static function placement(project Project) returns FrontEndPlacement
		if not FrontEndPool.RuntimeMovesSharedRecords 'runtimeCannot'
			return FrontEndPlacement.inProcessForRuntime
		end 'runtimeCannot'

		if project.allocationsByTag 'tallying'
			return FrontEndPlacement.inProcessForTally
		end 'tallying'

		return FrontEndPlacement.onWorkers
	end 'placement'

	function noteDrain(kind FrontEndDrainKind)
		match kind 'kind'
			lexing then self.lexed = true
			parsing then self.parsed = true
		end 'kind'
	end 'noteDrain'

	function hasDrained(kind FrontEndDrainKind) returns bool
		return match kind 'kind'
			lexing gives self.lexed
			parsing gives self.parsed
		end 'kind'
	end 'hasDrained'

	function sampleLevelsAfter(project Project, kind FrontEndDrainKind)
		if not project.samplesResidency 'nothingSampled'
			return
		end 'nothingSampled'

		var sharing = false

		for stage in FrontEndStage.allCases 'eachStage'
			if drainOfStage(stage) == kind 'thisDrain'
				recordPhaseLevels(project, phase: compilePhaseOfStage(stage), sharing: sharing)
				sharing = true
			end 'thisDrain'
		end 'eachStage'
	end 'sampleLevelsAfter'

	// ⭐ **EVERY FILE WHOSE RESOLVED STREAM NO MEMO HOLDS, LEXED AND FILTERED ON THE WORKERS**, then landed through
	// `queryActiveTokens` in source-path order — so the token queries the signature sweep asks next are all hits.
	module function lexEveryFile(project Project) throws CompileError
		let buildKey = buildKeyOf(project)
		var files = PoolJobArray.create(0)
		var sizes = PoolJobSizeArray.create(0)

		for fileIndex in 0 upto project.db.sourcePaths.count() 'eachFile'
			let held = try activeTokensAreHeld(project, path: sourcePathAt(project, fileIndex: fileIndex), buildKey: buildKey)

			if held 'memoized'
				continue
			end 'memoized'

			noteJob(fileIndex, size: (try sourceEntryOf(project, path: sourcePathAt(project, fileIndex: fileIndex))).content.byteLength() as PoolJobSize, files: files, sizes: sizes)
		end 'eachFile'

		if files.count() == 0 'everyStreamIsHeld'
			return
		end 'everyStreamIsHeld'

		let probe = PhaseProbe.beginPhase(project, phase: CompilePhase.frontEndPool)
		self.noteDrain(FrontEndDrainKind.lexing)

		var outcomes = FrontEndOutcomeArray.create(0)
		var slots = LandingSlots.create(project.db.sourcePaths.count())
		try self.drainEveryJob(project, input: FrontEndDrainInput.lexing(project), files: files, sizes: sizes, outcomes: outcomes, slots: slots)

		for fileIndex in files 'landInSourcePathOrder'
			_ = try queryActiveTokens(project, path: sourcePathAt(project, fileIndex: fileIndex), lexing: LexSource.pooled(lexOutcomeOf(landedOutcome(outcomes, slots: slots, fileIndex: fileIndex))))
		end 'landInSourcePathOrder'

		recordPhase(project, phase: CompilePhase.frontEndPool, probe: probe)
		self.sampleLevelsAfter(project, kind: FrontEndDrainKind.lexing)
	end 'lexEveryFile'

	// ⭐ **EVERY FILE'S PARSE, IN SOURCE-PATH ORDER** — the memoized ones from the memo, the rest parsed on the
	// workers against `signatures`, which is at its settled baseline.
	module function parseEveryFile(project Project, signatures ProgramSignatures) returns FileParseArtifactArray throws CompileError
		var queries = ParseQueryArray.create(project.db.sourcePaths.count(), zeroed: false)
		var files = PoolJobArray.create(0)
		var sizes = PoolJobSizeArray.create(0)

		for fileIndex in 0 upto project.db.sourcePaths.count() 'eachFile'
			try requireStillWanted(project)
			var query = try parseQueryOf(project, path: sourcePathAt(project, fileIndex: fileIndex))
			noteParseJob(query, fileIndex: fileIndex, files: files, sizes: sizes)
			queries.push(query)
		end 'eachFile'

		var outcomes = FrontEndOutcomeArray.create(0)
		var slots = LandingSlots.create(project.db.sourcePaths.count())

		if files.count() == 0 'everyParseIsMemoized'
			return landParses(project, queries: queries, outcomes: outcomes, slots: slots)
		end 'everyParseIsMemoized'

		let probe = PhaseProbe.beginPhase(project, phase: CompilePhase.frontEndPool)
		self.holdBaseline(signatures, project: project)
		try requireStillWanted(project)
		self.noteDrain(FrontEndDrainKind.parsing)
		try self.drainEveryJob(project, input: FrontEndDrainInput.parsing(queries), files: files, sizes: sizes, outcomes: outcomes, slots: slots)

		let artifacts = landParses(project, queries: queries, outcomes: outcomes, slots: slots)
		recordPhase(project, phase: CompilePhase.frontEndPool, probe: probe)
		self.sampleLevelsAfter(project, kind: FrontEndDrainKind.parsing)
		return artifacts
	end 'parseEveryFile'

	function reportWorkerPool(filesDispatched ElementIndex)
		let sizing = PoolSizing.forJobs(filesDispatched)

		// The reported count is derived, while `tests/parallelCompile/` reads the line back as an
		// observation of the pool that ran; without this, that case would compare the rule with itself.
		// Equality holds by construction — `requireWorkers` grows the pool to `min(P, filesDispatched)` on
		// every drain and `min` is monotone in a maximum — so this catches a future divergence loudly.
		if sizing.workerCount != self.workers.count() 'theReportedPoolIsNotTheOneThatRan'
			panic("FrontEndPool.close: the pool holds {self.workers.count()} worker(s) where min(P, {filesDispatched}) is {sizing.workerCount} — `requireWorkers` grows it to that size on every drain, so a difference is a pool the reported line does not describe")
		end 'theReportedPoolIsNotTheOneThatRan'

		if compilerLogEnabled(CompilerLogGroup.compiler, level: LogLevel.debug) 'debugging'
			logCompilerDebugSettled("{sizing.line(PoolKind.frontEnd)}, {self.adoptions} adopted")
			logCompilerDebugSettled("front end index overlay: {self.overlayAllocations} allocations")
			logCompilerDebugSettled("front end index copy: {self.indexCopyAllocations} allocations")
		end 'debugging'
	end 'reportWorkerPool'

	function reportInProcess(filesDispatched ElementIndex, placement FrontEndPlacement)
		if compilerLogEnabled(CompilerLogGroup.compiler, level: LogLevel.debug) 'debugging'
			logCompilerDebugSettled("front end: serial, in process, {filesDispatched} file(s) — {inProcessReasonText(placement)}")
		end 'debugging'
	end 'reportInProcess'

	// Fold every worker's costs into the stages' rows, report the pool once, and retire the workers to
	// `project.retiredWorkers` (see `RetiredWorkers`).
	module function close(project Project)
		if self.workers.count() == 0 and self.inProcess.count() == 0 'nothingRan'
			return
		end 'nothingRan'

		let probe = PhaseProbe.beginPhase(project, phase: CompilePhase.frontEndPool)
		let filesDispatched = self.mostFilesDispatched

		let placement = FrontEndPool.placement(project)

		match placement 'placement'
			onWorkers then self.reportWorkerPool(filesDispatched)
			inProcessForRuntime or
			inProcessForTally then self.reportInProcess(filesDispatched, placement: placement)
		end 'placement'

		for slot in 0 upto self.workers.count() 'eachRetirement'
			var worker = try self.workers.get(slot) otherwise panic("FrontEndPool.close: workers.get OOB at {slot} below count {self.workers.count()}")
			_ = try await worker.retire() otherwise panic("{workerGoneMessage("FrontEndPool.close", subject: "worker {slot}")}")
		end 'eachRetirement'

		self.foldCosts(project, costs: self.spent)

		if let worker = try self.inProcess.get(0) 'ranInProcess'
			self.foldCosts(project, costs: worker.costs)
		end 'ranInProcess'

		self.spent = PoolPhaseCosts.create(FrontEndStage.allCases.count())
		project.retiredWorkers.frontEnd.keep(self.workers)
		self.workers = FrontEndWorkerHandleArray.create(0)
		self.inProcess.clear()
		self.baseline.clear()
		self.handoffs.clear()
		self.adopted.clear()
		self.heldRevisions.clear()
		recordPhase(project, phase: CompilePhase.frontEndPool, probe: probe)
	end 'close'

	// Sized by what this drain hands out, so a warm front end that re-parses one file spawns one worker.
	function requireWorkers(project Project, filesDispatched ElementIndex)
		let wanted = PoolSizing.forJobs(filesDispatched).workerCount

		while self.workers.count() < wanted 'eachMissingWorker'
			self.workers.push(spawn FrontEndWorker.create(project.target.cpu, os: project.target.os, debugStream: project.debugStream))
			self.adopted.push(false)
			self.heldRevisions.push(0)
		end 'eachMissingWorker'
	end 'requireWorkers'

	// Parse against `signatures` from now on. A worker already holding the baseline of this very index
	// keeps it, so the folds that follow against the same index hand a worker nothing but the live
	// keys (`refreshLiveKeys`).
	//
	// The handoff is taken while `signatures` is at its settled baseline: the fold restores it before
	// it parses, and a drain writes nothing into it.
	function holdBaseline(signatures ProgramSignatures, project Project)
		if let held = try self.baseline.get(0) 'held'
			if held is signatures 'theSameIndex'
				self.baselineRevision = signatures.liveKeysRevision()
				return
			end 'theSameIndex'
		end 'held'

		self.baseline.clear()
		self.handoffs.clear()
		self.baseline.push(signatures)
		self.baselineRevision = signatures.liveKeysRevision()
		self.adopted.refill(self.workers.count(), value: false)

		match FrontEndPool.placement(project) 'placement'
			onWorkers then self.pushHandoff(signatures, os: project.target.os)
			inProcessForRuntime or
			inProcessForTally then break
		end 'placement'
	end 'holdBaseline'

	function pushHandoff(signatures ProgramSignatures, os Os)
		let handoff = WorkerHandoff.of(signatures, os: os)

		if compilerLogEnabled(CompilerLogGroup.compiler, level: LogLevel.debug) 'measuringACopy'
			self.overlayAllocations = ProgramSignatures.overlayAllocations(handoff.declarations, template: handoff.template)
			self.indexCopyAllocations = handoff.template.current().base.copyAllocations()
		end 'measuringACopy'

		self.handoffs.push(handoff)
	end 'pushHandoff'

	// This thread hands a worker two handles to the published baseline (`FrontEndWorker.adopt`); the
	// worker builds each parse's overlay on its own thread (`FrontEndWorker.privateIndex`).
	function requireAdopted(workerSlot ElementIndex)
		let holdsTheBaseline = try self.adopted.get(workerSlot) otherwise panic("FrontEndPool.requireAdopted: adopted.get OOB at {workerSlot} below count {self.adopted.count()}")

		if holdsTheBaseline 'alreadyAdopted'
			self.refreshLiveKeys(workerSlot)
			return
		end 'alreadyAdopted'

		let handoff = try self.handoffs.get(0) otherwise panic("FrontEndPool.requireAdopted: a worker was handed the baseline before `holdBaseline` published its declarations and copied what a parse writes")
		var worker = self.workerAt(workerSlot)

		// Temporaries, so the send moves them: the handles are the worker's alone, and the declarations
		// and the template they name are shared.
		try worker.adopt(handoff.declarations.clone(), template: handoff.template.clone()) otherwise panic("{workerRefusedSendMessage("FrontEndPool.requireAdopted", subject: "the worker in slot {workerSlot}")}")
		self.adoptions = self.adoptions + 1
		try self.adopted.set(workerSlot, value: true) otherwise panic("FrontEndPool.requireAdopted: adopted.set OOB at {workerSlot} below count {self.adopted.count()}")
		try self.heldRevisions.set(workerSlot, value: handoff.liveKeysRevision) otherwise panic("FrontEndPool.requireAdopted: heldRevisions.set OOB at {workerSlot} below count {self.heldRevisions.count()}")
		self.refreshLiveKeys(workerSlot)
	end 'requireAdopted'

	// A fold moves the live keys without re-sweeping the index, so a worker takes them as a small
	// update rather than a new baseline.
	function refreshLiveKeys(workerSlot ElementIndex)
		let held = try self.heldRevisions.get(workerSlot) otherwise panic("FrontEndPool.refreshLiveKeys: heldRevisions.get OOB at {workerSlot} below count {self.heldRevisions.count()}")

		if held == self.baselineRevision 'current'
			return
		end 'current'

		try self.workerAt(workerSlot).adoptLiveReach(freeze self.baselineIndex().liveReach().clone()) otherwise panic("{workerRefusedSendMessage("FrontEndPool.refreshLiveKeys", subject: "the worker in slot {workerSlot}")}")
		try self.heldRevisions.set(workerSlot, value: self.baselineRevision) otherwise panic("FrontEndPool.refreshLiveKeys: heldRevisions.set OOB at {workerSlot} below count {self.heldRevisions.count()}")
	end 'refreshLiveKeys'

	function baselineIndex() returns ProgramSignatures
		return try self.baseline.get(0) otherwise panic("FrontEndPool.baselineIndex: a parse was dispatched before `holdBaseline` named the index it parses against")
	end 'baselineIndex'

	// Every job of one drain, on the workers or on this thread, landed by file either way.
	function drainEveryJob(project Project, input FrontEndDrainInput, files PoolJobArray, sizes PoolJobSizeArray, outcomes FrontEndOutcomeArray, slots LandingSlots) throws CompileError
		self.mostFilesDispatched = files.count() if files.count() > self.mostFilesDispatched else self.mostFilesDispatched

		match FrontEndPool.placement(project) 'placement'
			onWorkers then try self.drainOnWorkers(project, input: input, files: files, sizes: sizes, outcomes: outcomes, slots: slots)
			inProcessForRuntime or
			inProcessForTally then try self.drainInProcess(project, input: input, files: files, outcomes: outcomes, slots: slots)
		end 'placement'
	end 'drainEveryJob'

	function drainOnWorkers(project Project, input FrontEndDrainInput, files PoolJobArray, sizes PoolJobSizeArray, outcomes FrontEndOutcomeArray, slots LandingSlots) throws CompileError
		self.requireWorkers(project, filesDispatched: files.count())
		try self.drain(project, input: input, files: files, sizes: sizes, workerCount: self.drainWorkerCount(input, sizes: sizes), outcomes: outcomes, slots: slots)
	end 'drainOnWorkers'

	function drainWorkerCount(input FrontEndDrainInput, sizes PoolJobSizeArray) returns PoolSize
		return match input 'input'
			lexing gives self.workers.count() as PoolSize
			parsing gives parseDrainWorkerCount(sizes, poolSize: self.workers.count() as PoolSize)
		end 'input'
	end 'drainWorkerCount'

	// ⭐ **THE WORKER'S OWN WORK, DONE ON THIS THREAD** — the same job, the same answer and the same landing as a
	// drain on the pool, with nothing moved.
	function drainInProcess(project Project, input FrontEndDrainInput, files PoolJobArray, outcomes FrontEndOutcomeArray, slots LandingSlots) throws CompileError
		var worker = self.inProcessWorker(project, input: input)

		for job in 0 upto files.count() 'eachJob'
			try requireStillWanted(project)
			let fileIndex = fileOfJob(files, job: job)

			var outcome = match input 'input'
				lexing(sources) gives lexInProcess(project, worker: worker, content: sourceTextAt(sources, fileIndex: fileIndex))
				parsing(queries) gives parseInProcess(project, worker: worker, query: queryAt(queries, fileIndex: fileIndex))
			end 'input'

			landOutcome(outcome, fileIndex: fileIndex, outcomes: outcomes, slots: slots)
		end 'eachJob'
	end 'drainInProcess'

	// The in-process worker, holding the baseline index itself for a parse: nothing crosses a thread, so there is
	// nothing to copy.
	function inProcessWorker(project Project, input FrontEndDrainInput) returns FrontEndWorkerState
		if self.inProcess.count() == 0 'firstDrain'
			self.inProcess.push(FrontEndWorkerState.create(project.target.cpu, os: project.target.os, debugStream: project.debugStream))
		end 'firstDrain'

		var worker = try self.inProcess.get(0) otherwise panic("FrontEndPool.inProcessWorker: inProcess.get OOB at 0 after the push above")

		match input 'input'
			lexing then break
			parsing then worker.hold(self.baselineIndex())
		end 'input'

		return worker
	end 'inProcessWorker'

	// ⭐⭐ **THE DISPATCH LOOP: fill the pipeline, then serve whoever finished first.** The protocol is
	// `PoolDispatch`'s, shared with the backend's two pools.
	function drain(project Project, input FrontEndDrainInput, files PoolJobArray, sizes PoolJobSizeArray, workerCount PoolSize, outcomes FrontEndOutcomeArray, slots LandingSlots) throws CompileError
		var dispatch = PoolDispatch.create(sizes, workerCount: workerCount, assignment: PoolAssignment.staticShare)
		var replies = FrontEndReplyPromiseArray.create(dispatch.pipelineDepth(), zeroed: false)

		for _ in 0 upto dispatch.initialInFlight() 'fillThePipeline'
			self.dispatchJob(input, files: files, workerSlot: dispatch.fillWorker(), dispatch: dispatch, replies: replies)
		end 'fillThePipeline'

		while replies.count() > 0 'serveWhoeverFinishedFirst'
			let ready = replies.awaitAny()
			let freedWorker = dispatch.workerAt(ready)
			let fileIndex = fileOfJob(files, job: dispatch.land(ready, outstanding: replies.count()))
			let reply = try replies.remove(ready) otherwise panic("FrontEndPool.drain: replies.remove({ready}) — `awaitAny` answered a slot of this very array")
			var unit = await reply
			var answer = unit.takeAnswer()
			self.noteCosts(answer.costs)
			landOutcome(answer.outcome, fileIndex: fileIndex, outcomes: outcomes, slots: slots)

			if dispatch.hasUndispatchedFor(freedWorker) 'handTheFreedWorkerTheNextJob'
				try requireStillWanted(project)
				self.dispatchJob(input, files: files, workerSlot: freedWorker, dispatch: dispatch, replies: replies)
			end 'handTheFreedWorkerTheNextJob'
		end 'serveWhoeverFinishedFirst'
	end 'drain'

	function dispatchJob(input FrontEndDrainInput, files PoolJobArray, workerSlot ElementIndex, dispatch PoolDispatch, replies FrontEndReplyPromiseArray)
		let fileIndex = fileOfJob(files, job: dispatch.nextJob(workerSlot))

		match input 'input'
			lexing(project) then replies.push(try self.workerAt(workerSlot).run(FrontEndJob.lexing(sourceTextAt(project, fileIndex: fileIndex))) otherwise panic("{workerRefusedSendMessage("FrontEndPool.dispatchJob", subject: "the worker handed file {fileIndex}")}"))
			parsing(queries) then replies.push(try self.adoptedWorkerAt(workerSlot).run(FrontEndJob.parsing(queryAt(queries, fileIndex: fileIndex))) otherwise panic("{workerRefusedSendMessage("FrontEndPool.dispatchJob", subject: "the worker handed file {fileIndex}")}"))
		end 'input'
	end 'dispatchJob'

	function workerAt(workerSlot ElementIndex) returns FrontEndWorker.handle
		return try self.workers.get(workerSlot) otherwise panic("FrontEndPool.workerAt: workers.get OOB at {workerSlot} below count {self.workers.count()}")
	end 'workerAt'

	// The worker at `workerSlot`, holding the baseline.
	function adoptedWorkerAt(workerSlot ElementIndex) returns FrontEndWorker.handle
		self.requireAdopted(workerSlot)
		return self.workerAt(workerSlot)
	end 'adoptedWorkerAt'

	function noteCosts(costs PoolPhaseCosts)
		for stage in FrontEndStage.allCases 'eachStage'
			self.spent.add(stage.ordinal, delta: costs.accumulated(stage.ordinal))
		end 'eachStage'
	end 'noteCosts'

	function foldCosts(project Project, costs PoolPhaseCosts)
		for stage in FrontEndStage.allCases 'eachStage'
			if self.hasDrained(drainOfStage(stage)) 'thisStageRan'
				foldPoolPhaseDelta(project, phase: compilePhaseOfStage(stage), driver: CompilePhase.frontEndPool, delta: costs.accumulated(stage.ordinal))
			end 'thisStageRan'
		end 'eachStage'
	end 'foldCosts'
end 'FrontEndPool'

function lexInProcess(project Project, worker FrontEndWorkerState, content String) returns FrontEndOutcome
	if project.allocationsByTag 'tallied'
		return FrontEndOutcome.lexed(worker.lexed(content, edges: project.memory.allocTally))
	end 'tallied'

	return worker.ran(merge FrontEndJob.lexing(content))
end 'lexInProcess'

function parseInProcess(project Project, worker FrontEndWorkerState, query ParseQuery) returns FrontEndOutcome
	var job = merge FrontEndJob.parsing(query)

	if not project.allocationsByTag 'untallied'
		return worker.ran(job)
	end 'untallied'

	project.memory.allocTally.settleTo(CompilePhase.frontEndPool)

	let outcome = worker.ran(job)
	project.memory.allocTally.settleTo(CompilePhase.parse)

	return outcome
end 'parseInProcess'

function sourcePathAt(project Project, fileIndex ElementIndex) returns FilePath
	return try project.db.sourcePaths.get(fileIndex) otherwise panic("FrontEndPool: file {fileIndex} is not below project.db.sourcePaths.count() {project.db.sourcePaths.count()}")
end 'sourcePathAt'

function sourceTextAt(project Project, fileIndex ElementIndex) returns String
	let entry = try sourceEntryOf(project, path: sourcePathAt(project, fileIndex: fileIndex)) otherwise panic("FrontEndPool.sourceTextAt: file {fileIndex} has no source entry — the pool sized its job from it")
	return entry.content
end 'sourceTextAt'

function queryAt(queries ParseQueryArray, fileIndex ElementIndex) returns ParseQuery
	return try queries.get(fileIndex) otherwise panic("FrontEndPool.queryAt: queries.get OOB at {fileIndex} below count {queries.count()}")
end 'queryAt'

// Recorded by FILE, so the landing after the drain reads every answer in source-path order.
function landOutcome(outcome FrontEndOutcome, fileIndex ElementIndex, outcomes FrontEndOutcomeArray, slots LandingSlots)
	slots.record(fileIndex, slot: outcomes.count())
	outcomes.push(outcome)
end 'landOutcome'

function fileOfJob(files PoolJobArray, job ElementIndex) returns ElementIndex
	return try files.get(job) otherwise panic("FrontEndPool: job {job} is not below the {files.count()} file(s) dispatched")
end 'fileOfJob'

function noteJob(fileIndex ElementIndex, size PoolJobSize, files PoolJobArray, sizes PoolJobSizeArray)
	files.push(fileIndex)
	sizes.push(size)
end 'noteJob'

// ⭐ **HOW MANY OF THE POOL'S WORKERS A PARSE DRAIN USES: as many as carry the whole work in the
// time of its longest file, `ceil(total / longest)`, up to the pool.** No drain ends before its
// longest parse does, so a worker past that count shortens nothing — and each worker a drain uses
// costs this thread a baseline handoff before its first parse (`requireAdopted`).
function parseDrainWorkerCount(sizes PoolJobSizeArray, poolSize PoolSize) returns PoolSize
	var total = 0 as PoolJobSize
	var longest = 0 as PoolJobSize

	for size in sizes 'eachJob'
		total = total + size
		longest = size if size > longest else longest
	end 'eachJob'

	// Streams of no tokens are no work, and one worker parses all of them.
	if longest == 0 'noJobHasWork'
		return 1
	end 'noJobHasWork'

	let carrying = try ((total + longest - 1) / longest) otherwise panic("parseDrainWorkerCount: the longest job holds no tokens, which the test above answered")
	return poolSize if carrying >= poolSize as PoolJobSize else carrying as PoolSize
end 'parseDrainWorkerCount'

// A memoized parse is nothing to dispatch; a needed one is a job sized by its resolved tokens.
function noteParseJob(query ParseQuery, fileIndex ElementIndex, files PoolJobArray, sizes PoolJobSizeArray)
	match query 'query'
		memoized then return
		needed(_, tokens, _, _) then noteJob(fileIndex, size: tokens.count() as PoolJobSize, files: files, sizes: sizes)
	end 'query'
end 'noteParseJob'

function landedOutcome(outcomes FrontEndOutcomeArray, slots LandingSlots, fileIndex ElementIndex) returns FrontEndOutcome
	return try outcomes.get(slots.slotOf(fileIndex)) otherwise panic("FrontEndPool.landedOutcome: outcomes.get OOB for file {fileIndex}")
end 'landedOutcome'

function lexOutcomeOf(outcome FrontEndOutcome) returns LexOutcome
	match outcome 'outcome'
		lexed(lex) then return lex
		parsed then panic("FrontEndPool.lexOutcomeOf: a lex drain landed a parse — a drain dispatches one kind of work")
	end 'outcome'
end 'lexOutcomeOf'

function parseOutcomeOf(outcome FrontEndOutcome) returns FileParseOutcome
	match outcome 'outcome'
		lexed then panic("FrontEndPool.parseOutcomeOf: a parse drain landed a lex — a drain dispatches one kind of work")
		parsed(parse) then return parse
	end 'outcome'
end 'parseOutcomeOf'

// Every file's artifact in source-path order: a memoized one as the memo holds it, a parsed one landed now.
function landParses(project Project, queries ParseQueryArray, outcomes FrontEndOutcomeArray, slots LandingSlots) returns FileParseArtifactArray
	var artifacts = FileParseArtifactArray.create(queries.count(), zeroed: false)

	for fileIndex in 0 upto queries.count() 'eachFileInSourcePathOrder'
		artifacts.push(landedArtifact(project, query: queryAt(queries, fileIndex: fileIndex), fileIndex: fileIndex, outcomes: outcomes, slots: slots))
	end 'eachFileInSourcePathOrder'

	return artifacts
end 'landParses'

function landedArtifact(project Project, query ParseQuery, fileIndex ElementIndex, outcomes FrontEndOutcomeArray, slots LandingSlots) returns FileParseArtifact
	return match query 'query'
		memoized(artifact) gives artifact
		needed(_, _, _, stamp) gives landParseOutcome(project, path: sourcePathAt(project, fileIndex: fileIndex), outcome: parseOutcomeOf(landedOutcome(outcomes, slots: slots, fileIndex: fileIndex)), stamp: stamp)
	end 'query'
end 'landedArtifact'
