// The kinds of read-only root a deep `let` write is blamed on, and the wording of every refusal through
// one (E3078, E3159), of a `view` that escapes or is handed off (E3078, E3138, E3174), of a broken
// capability boundary (E3189) and of a `let` bound to writable state (E3188), for the parser,
// `SemanticCheck` and `StorageProvenance`; spec `maxoncstderr` blocks pin that wording byte for
// byte.
export enum ReadOnlyRootKind
	letBinding
	forElement
	loopVariable
	ifLetBinding
	matchBinding
	letField
	letPayload
	readOnlyElement
	storedMapKey
	storedSetElement
	moduleLet
	sharedView
	view
	destructuredTuple
end 'ReadOnlyRootKind'

// @generated library-cache begin
let CacheCasesReadOnlyRootKind = [ReadOnlyRootKind.letBinding, ReadOnlyRootKind.forElement, ReadOnlyRootKind.loopVariable, ReadOnlyRootKind.ifLetBinding, ReadOnlyRootKind.matchBinding, ReadOnlyRootKind.letField, ReadOnlyRootKind.letPayload, ReadOnlyRootKind.readOnlyElement, ReadOnlyRootKind.storedMapKey, ReadOnlyRootKind.storedSetElement, ReadOnlyRootKind.moduleLet, ReadOnlyRootKind.sharedView, ReadOnlyRootKind.view, ReadOnlyRootKind.destructuredTuple]

module function cacheReadReadOnlyRootKind(reader LibraryCacheReader) returns ReadOnlyRootKind throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesReadOnlyRootKind.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadReadOnlyRootKind'

function cacheTableAgreesReadOnlyRootKind() returns bool
	let declared = ReadOnlyRootKind.allCases

	if CacheCasesReadOnlyRootKind.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesReadOnlyRootKind.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesReadOnlyRootKind'

module function cacheEnumTablesAgreeInCompilerDeepLet() returns bool
	if not cacheTableAgreesReadOnlyRootKind() 'disagreesCacheTableAgreesReadOnlyRootKind'
		return false
	end 'disagreesCacheTableAgreesReadOnlyRootKind'

	return true
end 'cacheEnumTablesAgreeInCompilerDeepLet'

// @generated library-cache end

export function readOnlyRootDescription(root ReadOnlyRootKind) returns String
	return match root 'kind'
		letBinding gives "a `let` binding"
		forElement gives "a `for` element of a read-only source"
		loopVariable gives "a `for` loop variable"
		ifLetBinding gives "an `if let` binding"
		matchBinding gives "a `match` binding"
		letField gives "a `let` field"
		letPayload gives "a `let` payload"
		readOnlyElement gives "a `readonly` element"
		storedMapKey gives "a stored Map key"
		storedSetElement gives "a stored Set element"
		moduleLet gives "a module-level `let`"
		sharedView gives "a `SharedValue` or registry value"
		view gives "a `view`"
		destructuredTuple gives "a destructured `let` tuple"
	end 'kind'
end 'readOnlyRootDescription'

function kindIsAPartOfItsHolder(kind ReadOnlyRootKind) returns bool
	return kind == ReadOnlyRootKind.letField
end 'kindIsAPartOfItsHolder'

export let UnattributedProducer = "a value"

// Every subject that ends in a `which` clause carries its closing comma, so each message interpolates a subject
// bare. These wordings are pinned byte-for-byte by the specs' `maxoncstderr` blocks.
export function sharingStorageSubject(producer String, storage String) returns String
	return "{producer}, which may share storage with {storage},"
end 'sharingStorageSubject'

export function unattributedSharingSubject(kind ReadOnlyRootKind) returns String
	return sharingStorageSubject(UnattributedProducer, storage: readOnlyRootDescription(kind))
end 'unattributedSharingSubject'

export function readOutOfSubject(kind ReadOnlyRootKind) returns String
	if kind == ReadOnlyRootKind.moduleLet 'sharesAModuleLetsStorage'
		return unattributedSharingSubject(kind)
	end 'sharesAModuleLetsStorage'

	return readOutOfPlaceSubject(readOnlyRootDescription(kind))
end 'readOutOfSubject'

export function readOutOfPlaceSubject(place String) returns String
	return "a value read out of {place}"
end 'readOutOfPlaceSubject'

export function readOnlyNameSubject(name String) returns String
	return "the read-only '{name}'"
end 'readOnlyNameSubject'

export function readOnlyRootSubject(root String, kind ReadOnlyRootKind) returns String
	if root.isEmpty() and kind == ReadOnlyRootKind.moduleLet 'aModuleLetsStorageWithNoName'
		return readOutOfSubject(kind)
	end 'aModuleLetsStorageWithNoName'

	if root.isEmpty() 'aValueWithNoName'
		return "{readOutOfSubject(kind)}, which is read-only,"
	end 'aValueWithNoName'

	if kindIsAPartOfItsHolder(kind) 'aPartOfTheNamedHolder'
		return "{readOnlyRootDescription(kind)} of '{root}', which is read-only,"
	end 'aPartOfTheNamedHolder'

	return "'{root}', which is read-only ({readOnlyRootDescription(kind)}),"
end 'readOnlyRootSubject'

function readOnlyRootStatement(root String, kind ReadOnlyRootKind) returns String
	if root.isEmpty() 'aValueWithNoName'
		return "{readOutOfSubject(kind)} is read-only"
	end 'aValueWithNoName'

	return "'{root}' is read-only ({readOnlyRootDescription(kind)})"
end 'readOnlyRootStatement'

export function deepLetWriteMessage(place String, root String, kind ReadOnlyRootKind) returns String
	let named = place if kindIsAPartOfItsHolder(kind) else root

	return deepLetWriteStatementMessage(place, statement: readOnlyRootStatement(named, kind: kind))
end 'deepLetWriteMessage'

export function deepLetWriteSharedStorageMessage(place String, subject String) returns String
	return deepLetWriteStatementMessage(place, statement: "{subject} is read-only")
end 'deepLetWriteSharedStorageMessage'

function deepLetWriteStatementMessage(place String, statement String) returns String
	return "cannot write through '{place}': {statement} and nothing reachable through it may be written; use 'var', or write a clone()"
end 'deepLetWriteStatementMessage'

export function deepLetConsumeMessage(door ByteArray, kind ReadOnlyRootKind) returns String
	return "cannot consume with '{String.from(door)}' a promise held in {readOnlyRootDescription(kind)}: consuming a promise empties the slot it was read from, and nothing reachable through a read-only value may be written; hold it in a `var` field"
end 'deepLetConsumeMessage'

export function deepLetCallMessage(subject String, paramName String, functionName String) returns String
	return "cannot pass {subject} to a function that writes parameter '{paramName}' (in {functionName}); pass a clone()"
end 'deepLetCallMessage'

export function deepLetConversionMessage(calleeText String, interfaceName String) returns String
	return "cannot convert to '{interfaceName}' a type whose values something may write: its method '{calleeText}' keeps a value of its type parameter, and a kept value must have no other writer, which only a type nothing writes guarantees (a number, a String, or a record whose fields are all `let`); use such a type"
end 'deepLetConversionMessage'

export function deepLetBindMessage(subject String, binding String) returns String
	return "cannot assign {subject} to mutable binding '{binding}'; use 'let' instead of 'var', or use clone()"
end 'deepLetBindMessage'

export function deepLetStoreMessage(subject String, place String) returns String
	return "cannot store {subject} into mutable place '{place}'; use clone()"
end 'deepLetStoreMessage'

export function deepLetStoredRootSubject(name String, kind ReadOnlyRootKind) returns String
	return match kind 'kind'
		letBinding gives "`let` '{name}'"
		view gives "view '{name}'"
		moduleLet gives readOnlyRootSubject(name, kind: kind)
		forElement or
		loopVariable or
		ifLetBinding or
		matchBinding or
		letField or
		letPayload or
		readOnlyElement or
		storedMapKey or
		storedSetElement or
		destructuredTuple or
		sharedView gives readOutOfSubject(kind)
	end 'kind'
end 'deepLetStoredRootSubject'

export function deepLetElementKeptMessage(subject String, method String) returns String
	return deepLetStoreMessage(subject, place: "an element of the container {method} writes")
end 'deepLetElementKeptMessage'

export function viewReturnedMessage(name String) returns String
	return "cannot return view '{name}': a `view` cannot outlive its function; return a clone()"
end 'viewReturnedMessage'

export function viewSentMessage(name String, message String) returns String
	return "argument `{name}` of the message `{message}` is a `view`: it names data something else may write, so it can be neither moved nor shared with the service. Send a `.clone()`"
end 'viewSentMessage'

export function viewCapturedMessage(name String) returns String
	return "cannot capture view '{name}' in a closure; capture a clone()"
end 'viewCapturedMessage'

export function boundaryDisagreementMessage(subject String, claim String, boundary String, stance String) returns String
	return "{subject} {claim}, but '{boundary}' {stance}"
end 'boundaryDisagreementMessage'

export function parameterDemandMessage(subject String, verb String, parameter String, boundary String, qualifier String) returns String
	return boundaryDisagreementMessage(subject, claim: "{verb} its parameter '{parameter}'", boundary: boundary, stance: "does not declare it `{qualifier}`")
end 'parameterDemandMessage'

export function resultBreaksBoundaryMessage(subject String, boundary String, capability ResultCapability) returns String
	return boundaryDisagreementMessage(subject, claim: "returns a value something may still write", boundary: boundary, stance: "declares `returns {resultQualifierWord(capability)}`")
end 'resultBreaksBoundaryMessage'

export function keptUndeclaredMessage(subject String, parameter String, boundary String) returns String
	let (verb, qualifier) = paramDemandWords(ParamCapability.keep)
	return parameterDemandMessage(subject, verb: verb, parameter: parameter, boundary: boundary, qualifier: qualifier)
end 'keptUndeclaredMessage'

module function paramDemandWords(capability ParamCapability) returns (String, String)
	return match capability 'capability'
		lent panic("paramDemandWords: a lent parameter demands nothing of its boundary")
		keep gives ("keeps", String.from(KeepQualifierWord))
		sole gives ("consumes", String.from(SoleQualifierWord))
	end 'capability'
end 'paramDemandWords'

module function resultQualifierWord(capability ResultCapability) returns String
	return match capability 'capability'
		unqualified panic("resultQualifierWord: an unqualified result declares nothing a function could break")
		sole gives String.from(SoleQualifierWord)
		readonly gives String.from(ReadonlyModifierWord)
	end 'capability'
end 'resultQualifierWord'

module function handOffRefusalCode(kind MoveDestinationKind) returns ErrorCode
	return match kind 'kind'
		sentMessage gives ErrorCode.semanticServiceArgumentNotUnique
		publishedValue gives ErrorCode.registryPublishedValueNotSolelyOwned
		mutableName or
		letField or
		letFieldValue or
		letPayload or
		letPayloadValue or
		readOnlyElement or
		readOnlyElementValue or
		keptArgument or
		serviceReply or
		sharedSend or
		mutablePlace or
		returnedValue panic("handOffRefusalCode: a '{kind.name}' site is neither a send nor a publish")
	end 'kind'
end 'handOffRefusalCode'

export function viewedVarSubject(source String, view String) returns String
	return "the `var` '{source}', which has been viewed by '{view}',"
end 'viewedVarSubject'

export function viewedParameterSubject(parameter String, view String) returns String
	return "the parameter '{parameter}', which has been viewed by '{view}',"
end 'viewedParameterSubject'

export function viewedVarSentMessage(source String, view String, argumentOf String) returns String
	return "argument `{source}` {argumentOf} has been viewed by '{view}': a view's reference is a second owner for the rest of the function, so `{source}` can be neither moved nor shared with the service. Send a `.clone()`"
end 'viewedVarSentMessage'

export function viewedVarPublishedExplanation(key String, view String) returns String
	return "the value published to `{key}` has been viewed by '{view}': a view's reference is a second owner — publish a `.clone()`"
end 'viewedVarPublishedExplanation'

export function letBindsWritableStateMessage(name String, through String) returns String
	return "cannot bind `let` '{name}' to a value reached through '{through}', which something may still write; use `view` to read it, `var` to write it, or bind a clone()"
end 'letBindsWritableStateMessage'

function deepLetKeptSlotName(into ReadOnlyRootKind) returns String
	return match into 'kind'
		readOnlyElement gives "`readonly` element"
		letField gives "`let` field"
		letPayload gives "`let` payload"
		default panic("deepLetKeptSlotName: '{into.name}' is not a place a value is kept in")
	end 'kind'
end 'deepLetKeptSlotName'

function deepLetNoOtherWriterReason(into ReadOnlyRootKind) returns String
	return "a {deepLetKeptSlotName(into)} has no other writer, so it takes a fresh or moved value or a read-only one; pass a clone()"
end 'deepLetNoOtherWriterReason'

export function deepLetKeptStoreMessage(into ReadOnlyRootKind, subject String, place String) returns String
	let reason = deepLetNoOtherWriterReason(into)

	if into == ReadOnlyRootKind.readOnlyElement 'aContainerElement'
		return "cannot store {subject} into a `readonly` element of the container written by '{place}': {reason}"
	end 'aContainerElement'

	return "cannot store {subject} into a {deepLetKeptSlotName(into)} '{place}': {reason}"
end 'deepLetKeptStoreMessage'

export function rootKindOfHolder(holder WriteBlameHolder) returns ReadOnlyRootKind
	return match holder 'holder'
		binding gives ReadOnlyRootKind.letBinding
		closure gives ReadOnlyRootKind.letBinding
		forElement gives ReadOnlyRootKind.forElement
		loopVariable gives ReadOnlyRootKind.loopVariable
		ifLetBinding gives ReadOnlyRootKind.ifLetBinding
		matchBinding gives ReadOnlyRootKind.matchBinding
		letField gives ReadOnlyRootKind.letField
		letPayload gives ReadOnlyRootKind.letPayload
		readOnlyElement gives ReadOnlyRootKind.readOnlyElement
		storedMapKey gives ReadOnlyRootKind.storedMapKey
		storedSetElement gives ReadOnlyRootKind.storedSetElement
		moduleLet gives ReadOnlyRootKind.moduleLet
		sharedView gives ReadOnlyRootKind.sharedView
		view gives ReadOnlyRootKind.view
	end 'holder'
end 'rootKindOfHolder'

export function holderOfRootKind(kind ReadOnlyRootKind) returns WriteBlameHolder
	return match kind 'kind'
		letBinding gives WriteBlameHolder.binding
		forElement gives WriteBlameHolder.forElement
		loopVariable gives WriteBlameHolder.loopVariable
		ifLetBinding gives WriteBlameHolder.ifLetBinding
		matchBinding gives WriteBlameHolder.matchBinding
		letField gives WriteBlameHolder.letField
		letPayload gives WriteBlameHolder.letPayload
		readOnlyElement gives WriteBlameHolder.readOnlyElement
		storedMapKey gives WriteBlameHolder.storedMapKey
		storedSetElement gives WriteBlameHolder.storedSetElement
		moduleLet gives WriteBlameHolder.moduleLet
		sharedView gives WriteBlameHolder.sharedView
		view gives WriteBlameHolder.view
		destructuredTuple gives WriteBlameHolder.binding
	end 'kind'
end 'holderOfRootKind'

export function moveDestinationOfLetSlot(slot ReadOnlyRootKind, movesAVar bool) returns MoveDestinationKind
	return match slot 'slot'
		letField gives MoveDestinationKind.letField if movesAVar else MoveDestinationKind.letFieldValue
		letPayload gives MoveDestinationKind.letPayload if movesAVar else MoveDestinationKind.letPayloadValue
		readOnlyElement gives MoveDestinationKind.readOnlyElement if movesAVar else MoveDestinationKind.readOnlyElementValue
		letBinding or
		forElement or
		loopVariable or
		ifLetBinding or
		matchBinding or
		storedMapKey or
		storedSetElement or
		moduleLet or
		sharedView or
		destructuredTuple or
		view panic("moveDestinationOfLetSlot: '{slot.name}' is not a place a store keeps a value in")
	end 'slot'
end 'moveDestinationOfLetSlot'

export function holderIsPermanent(holder WriteBlameHolder) returns bool
	return match holder 'holder'
		binding or
		closure or
		forElement or
		loopVariable or
		ifLetBinding or
		matchBinding or
		view gives false
		letField or
		letPayload or
		readOnlyElement or
		storedMapKey or
		storedSetElement or
		moduleLet or
		sharedView gives true
	end 'holder'
end 'holderIsPermanent'

export enum ArgumentFate
	keptWhereWritable
	consumed
end 'ArgumentFate'

export function deepLetPassedMessage(subject String, paramName String, functionName String, fate ArgumentFate) returns String
	let outcome = match fate 'fate'
		keptWhereWritable gives "keeps it where something may write it"
		consumed gives "consumes it"
	end 'fate'

	return "cannot pass {subject} to parameter '{paramName}' of '{functionName}', which {outcome}; pass a clone()"
end 'deepLetPassedMessage'

export function deepLetKeptArgumentMessage(into ReadOnlyRootKind, subject String, paramName String, functionName String) returns String
	return "cannot pass {subject} to parameter '{paramName}' of '{functionName}', which stores it into a {deepLetKeptSlotName(into)}: {deepLetNoOtherWriterReason(into)}"
end 'deepLetKeptArgumentMessage'

export function deepLetInstantiationMessage(functionName String) returns String
	return "cannot call '{functionName}' with a type whose values something may write: its body keeps a value of its type parameter, and a kept value must have no other writer, which only a type nothing writes guarantees (a number, a String, or a record whose fields are all `let`); use such a type"
end 'deepLetInstantiationMessage'
