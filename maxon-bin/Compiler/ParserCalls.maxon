			end 'debugFlushCode'

			if callee.equals(BuiltinsDebugCloseHandleName) 'debugCloseHandle'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostCloseHandleName, arity: DebugHostOneArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugCloseHandle'

			if callee.equals(BuiltinsDebugSuspendThreadName) 'debugSuspendThread'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostSuspendThreadName, arity: DebugHostOneArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugSuspendThread'

			if callee.equals(BuiltinsDebugResumeThreadName) 'debugResumeThread'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostResumeThreadName, arity: DebugHostOneArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugResumeThread'

			if callee.equals(BuiltinsDebugTraceRequestName) 'debugTraceRequest'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostTraceRequestName, arity: DebugHostFourArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugTraceRequest'

			if callee.equals(BuiltinsDebugTraceeReadName) 'debugTraceeRead'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostTraceeReadName, arity: DebugHostFiveArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugTraceeRead'

			if callee.equals(BuiltinsDebugAwaitTraceeName) 'debugAwaitTracee'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostAwaitTraceeName, arity: DebugHostThreeArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugAwaitTracee'

			if callee.equals(BuiltinsDebugThreadSignalName) 'debugThreadSignal'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostThreadSignalName, arity: DebugHostThreeArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugThreadSignal'

			if callee.equals(BuiltinsDebugProcessSignalName) 'debugProcessSignal'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DebugHostProcessSignalName, arity: DebugHostTwoArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'debugProcessSignal'

			if callee.equals(BuiltinsPinToMachineName) 'pinToMachine'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: GtPinMachineName, arity: DebugHostNoArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'pinToMachine'

			if callee.equals(BuiltinsUnpinFromMachineName) 'unpinFromMachine'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: GtUnpinMachineName, arity: DebugHostNoArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.void, resultAlias: NoAnswerAlias, resultUsed: resultUsed, calleeTok: anchor)
			end 'unpinFromMachine'

			if callee.equals(BuiltinsPinDepthName) 'pinDepth'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: GtPinDepthName, arity: DebugHostNoArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'pinDepth'

			if callee.equals(BuiltinsCurrentMachineName) 'currentMachine'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: GtCurrentMachineName, arity: DebugHostNoArgArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'currentMachine'
		end 'builtinsIntrinsic'

		// ⭐⭐ **THE `__DebugStream` MEMBERS THAT REACH THE RING** — the second builtin TYPE's
		// table, gated behind ONE prefix compare for the `__Builtins` table's reason: a call to anything else
		// pays fourteen bytes and no allocation. `nameId` never arrives here; it was taken above, before the
		// arguments were parsed, because its argument is a NAME rather than a value.
		//
		// An unrecognized member falls through to `emitCall`'s reserved-callee rejection, which is this
		// table's "unknown member" arm and names the callee — see `DebugStreamQualifierPrefix`.
		if isDebugStreamCallee(callee) 'debugStreamMember'
			if callee.equals(DebugStreamEnabledCallee) 'enabled'
				return try self.emitDebugStreamEnabled(args, calleeTok: anchor)
			end 'enabled'

			// ⭐ **THE FOUR EMITTING MEMBERS GO THROUGH THE SAME DOOR THE `subprocess*` FAMILY DOES**, and it is
			// the same four questions: the right number of arguments, each one a machine word or a buffer as its
			// slot says, no result where there is none to have, and one `emitRuntimeCall`. What differs is the
			// MARKER the lowering will read and the arity — which is what the rows below say and all they say.
			//
			// ⚠ The message buffer is BORROWED: `__ds_emit_log_text` reads `buffer`/`length` through the record
			// and copies the bytes into the ring, taking no ownership, exactly as the subprocess entries borrow
			// their argv blob — which is what makes this door the right one and enrols no drop.
			//
			// The two ends of a phase SPAN differ in the wire code and in nothing else, so they take two markers
			// and one entry point; the lowering is what supplies the code (`DsEvLogPhaseBegin`/`DsEvLogPhaseEnd`).
			if callee.equals(DebugStreamPhaseBeginCallee) 'phaseBegin'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DsLogPhaseBeginMarkerName, arity: DebugStreamPhaseArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.void, resultAlias: NoAnswerAlias, resultUsed: resultUsed, calleeTok: anchor)
			end 'phaseBegin'

			if callee.equals(DebugStreamPhaseEndCallee) 'phaseEnd'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DsLogPhaseEndMarkerName, arity: DebugStreamPhaseArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.void, resultAlias: NoAnswerAlias, resultUsed: resultUsed, calleeTok: anchor)
			end 'phaseEnd'

			if callee.equals(DebugStreamEventCallee) 'event'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DsLogEventMarkerName, arity: DebugStreamEventArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.void, resultAlias: NoAnswerAlias, resultUsed: resultUsed, calleeTok: anchor)
			end 'event'

			if callee.equals(DebugStreamTextCallee) 'text'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: DsLogTextMarkerName, arity: DebugStreamTextArity, shape: IntrinsicArgShape.stringLast, resultTag: ValueTypeTag.void, resultAlias: NoAnswerAlias, resultUsed: resultUsed, calleeTok: anchor)
			end 'text'
		end 'debugStreamMember'

		let callOpFloor = self.artifact.module.ops.count()
		let callOpen = self.regionFactsForRead().pendingCallOpen if opensAnIsolatedValue else PendingCallOpen.none
		let guardsTheCall = self.callNeedsAStrandGuard(opensAnIsolatedValue)

		if guardsTheCall 'enterTheGuard'
			self.enterCallGuard(SourceRange.ofToken(anchor))
		end 'enterTheGuard'

		self.bodyState.emittedCall = EmittedCallOp.none
		let called = try self.emitResolvedCall(callee, callee: resolvedCallee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: rparenTok, resultUsed: resultUsed, constructorInstance: constructorInstance, mint: mint, inferInstanceOf: inferInstanceOf, serviceSite: serviceSite, places: places)

		let emittedCall = self.bodyState.emittedCall

		if guardsTheCall 'leaveTheGuard'
			self.leaveCallGuard(SourceRange.ofToken(rparenTok))
		end 'leaveTheGuard'

		self.noteCallResultCapability(called, callee: resolvedCallee, args: args, opensAnIsolatedValue: opensAnIsolatedValue, opFloor: callOpFloor, anchor: anchor, argLabels: argLabels, receiver: receiver)
		self.dischargeHandedBack(args, result: called)

		if let opIdx = try emittedCall.opIndex() 'aCallWasEmitted'
			self.fileCallNotes(func, opIdx: opIdx, args: args, argAnchors: argAnchors, stored: storedSlots, receiver: receiver, anchor: anchor, callOpen: callOpen)
		end 'aCallWasEmitted'

		return called
	end 'parseCallNamed'

	// ⭐ **THE ONE `__DebugStream` MEMBER THAT ANSWERS A VALUE — the SOURCE-LEVEL half of the run-time gate.**
	// It lowers to the `__ds_base != 0` test itself: a load and a compare, no call. That is what makes it the
	// right guard for a tier that ALLOCATES — `Logger.log` builds a String before it can hand one over, and
	// the emitting members' own in-body test would only be reached after that cost had been paid.
	//
	// ⚠ In a build carrying no producer it folds to the constant `false`, so every body it guards is dead
	// before the optimizer sees it (`LowerMaxonToStd.lowerDebugStreamEmit`). Its result is a `bool` and not
	// the `integer` the `__Builtins` predicates answer, because unlike them it has no stdlib declaration in
	// front of it to do the conversion: the source writes `if __DebugStream.enabled()` directly.
	function emitDebugStreamEnabled(args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: DebugStreamEnabledCallee, arity: DebugStreamEnabledArity, calleeTok: calleeTok)

		return self.emitRuntimeCall(DsLogEnabledMarkerName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitDebugStreamEnabled'

	// ⭐ **`__Builtins.currentTimeMs()` — THE NANOSECOND READING, SCALED. NOT the coarse tick.**
	//
	// `nowMs()` is `__gt_now_ns` divided by 1,000,000, which is the contract `stdlib/Clock.maxon` documents,
	// so a millisecond reading resolves whole milliseconds on every platform rather than a coarse OS tick.
	// `specs/builtins-clock.md`'s `ms-resolves-sub-tick` is the test that catches a coarse tick.
	//
	// The divide is emitted INLINE rather than as a `__clock_now_ms` runtime function, because a runtime
	// function whose whole body is one call and one divide is a call/ret wrapped around two instructions —
	// the same reasoning that makes `trunc` a builtin instead of a stdlib call. It goes through the ordinary
	// `emitDivOrMod`, so the operand rules, the result tag, the constant view AND the divide-by-zero policy are
	// the ones every source-level `/` gets; there is no second division path to keep in step.
	//
	// ⚠ It therefore RE-ASKS the fallibility question of `NanosPerMillisecond`, and gets "provably non-zero"
	// from the parser's own constant view — so this stays a BARE divide with no guard and no `try`, and it
	// stays one for a reason the compiler checks rather than one this comment asserts. Routing it around
	// `emitDivOrMod` to save that check would be the second division path the paragraph above forbids.
	function emitMonotonicMs(func IrFunction, args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		let nanos = try self.emitClockIntrinsicCall(args, name: BuiltinsCurrentTimeMsName, runtimeName: GtNowNsName, resultAlias: InstantNanosAliasName, calleeTok: calleeTok)
		let perMilli = self.emitLiteral(NanosPerMillisecond, valueType: MaxonType.integer, range: SourceRange.ofToken(calleeTok))
		return self.retypeAsLibraryAlias(try self.emitDivOrMod(func, dividend: nanos, divisor: perMilli, op: MaxonBinOp.div, opTok: calleeTok), aliasName: InstantMsAliasName)
	end 'emitMonotonicMs'

	// ⭐⭐ **ONE `__Raw.*` INTRINSIC, EMITTED UNDER ITS TABLE ROW (`RawIntrinsics`).** The row states the
	// argument shape and what the intrinsic answers; this reads the call under that shape and knows nothing
	// else about any row, so a row added to the table is written here for free.
	//
	// ⚠ Checking the arity and the operands HERE is what an intrinsic needs BECAUSE no file declares it:
	// there is no signature for SemanticCheck's ordinary battery to read. The rejections are the same
	// `builtinArity` / `builtinOperandType` / `voidCallResultUsed` every other intrinsic door raises.
	function emitRawIntrinsic(func IrFunction, intrinsic RawIntrinsic, args ValueIdArray, calleeTok Token, resultUsed bool) returns ValueId throws SourceParseError
		let callee = rawIntrinsicCalleeName(intrinsic)
		let shape = rawArgShapeOf(intrinsic)
		let expected = rawArgCountOf(shape)

		try requireBuiltinArity(args, builtinName: callee, arity: expected, calleeTok: calleeTok)

		if rawResultKindOf(intrinsic) == RawResultKind.nothing and resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(callee), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		// Zero for a shape with no constant position, which is not a sentinel: the op's `constant` field is
		// what the emitted instruction carries in place of an operand, and a shape without one carries none.
		var constant = 0 as FullRangeInt
		let words = ValueIdArray.create(0)

		for position in 0 upto args.count() 'eachArgument'
			let arg = try args.get(position) otherwise panic("emitRawIntrinsic: arity was just checked but args.get({position}) failed")

			if rawArgumentIsTheConstant(shape, position: position as ParamCount) 'compileTimeConstant'
				if not self.constIsKnown(arg) 'notAConstant'
					throw SourceParseError.builtinOperandPhrase(String.from(callee), required: RawConstantOperandRequirement, got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
				end 'notAConstant'

				constant = self.constOf(arg)
				continue
			end 'compileTimeConstant'

			if rawArgumentIsTheBuffer(shape, position: position as ParamCount) 'bufferAddress'
				try self.requireRawBufferAddressArg(arg, callee: callee, calleeTok: calleeTok)
			end 'bufferAddress' else 'machineWord'
				try self.requireIntrinsicMachineWordArg(arg, callee: callee, calleeTok: calleeTok)
			end 'machineWord'

			words.push(arg)
		end 'eachArgument'

		if intrinsic == RawIntrinsic.scratch 'frameRecord'
			constant = try self.reserveRawScratchSlot(func, bytes: constant, callee: callee, calleeTok: calleeTok)
		end 'frameRecord'

		if intrinsic == RawIntrinsic.osExit 'abortCode'
			_ = try RuntimeAbort.fromRawValue(constant) otherwise throw SourceParseError.builtinOperandPhrase(String.from(callee), required: RawExitCodeRequirement, got: "{constant}", line: calleeTok.line, column: calleeTok.column)
		end 'abortCode'

		try self.recordFrameDirective(func, intrinsic: intrinsic, calleeTok: calleeTok)

		let result = self.mintValue(rawIntrinsicResultTag(intrinsic), nameId: UnnamedTypeId)

		if rawResultKindOf(intrinsic) == RawResultKind.machineWord 'aMachineWord'
			self.recordWholeMachineWordRange(result)
		end 'aMachineWord'

		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.rawIntrinsic(result, intrinsic: intrinsic, args: words, constant: constant), range: SourceRange.ofToken(calleeTok))
		return result
	end 'emitRawIntrinsic'

	// ⭐⭐ **THE TWO DIRECTIVE ROWS ARE FACTS ABOUT THE ENCLOSING FUNCTION, AND THIS IS WHERE THEY ARE
	// RECORDED** — on the very `IrFunction` the Maxon→Std transfer hands on as the Std function, so the
	// claim needs no second carrier and the lowering appends nothing for either row.
	//
	// ⛔ **THE TWO CONTRADICT EACH OTHER AND THE CONTRADICTION IS REFUSED HERE**, at the declaration that
	// makes it, rather than at the inliner: one says the frame is the body's whole product and the other
	// that the body has no frame worth keeping, and a compiler resolving that by precedence would give a
	// runtime author a silent answer to a question they asked twice.
	function recordFrameDirective(func IrFunction, intrinsic RawIntrinsic, calleeTok Token) throws SourceParseError
		match intrinsic 'row'
			ownFrame then try self.claimOwnFrame(func, calleeTok: calleeTok)
			splicedAtEverySite then try self.claimSplicedAtEverySite(func, calleeTok: calleeTok)
			osTickCountMs or
			osReadWallClock or
			osThreadCpuTicks or
			osCpuCount or
			osGetPid or
			osEnterBackgroundPriority or
			osProcessProbe or
			osDescendants or
			osWaitHandle or
			osCloseHandle or
			osExit or
			scratch or
			schedNumProcsAddr or
			schedMaxActiveWorkersAddr or
			cpuAesUsableAddr or
			slabArenaListAddr or
			slabArenaMapL1Addr or
			slabStateAddr or
			slabSizeToClass8Addr or
			slabSizeToClass128Addr or
			slabClassGeomAddr or
			dsBaseAddr or
			dsAllocIdAddr or
			tlsSlotLoad or
			loadWord or
			storeWord or
			loadByte or
			storeByte or
			atomicAddWord or
			atomicCas or
			memFill or
			osAllocPages or
			osReservePages or
			osCommitPages or
			osDecommitPages or
			osFreePages or
			osLockInit or
			osLockEnter or
			osLockLeave or
			osThreadCreate or
			schedTlsTebOffsetAddr or
			schedAllMachinesAddr or
			schedPreemptExtLockAddr or
			schedLockAddr then break
		end 'row'
	end 'recordFrameDirective'

	function claimOwnFrame(func IrFunction, calleeTok Token) throws SourceParseError
		if func.mustBeSplicedAtEverySite 'bothSpelled'
			throw SourceParseError.contradictoryFrameDirectives(calleeTok.line, column: calleeTok.column)
		end 'bothSpelled'

		func.keepsItsOwnFrame = true
	end 'claimOwnFrame'

	function claimSplicedAtEverySite(func IrFunction, calleeTok Token) throws SourceParseError
		if func.keepsItsOwnFrame 'bothSpelled'
			throw SourceParseError.contradictoryFrameDirectives(calleeTok.line, column: calleeTok.column)
		end 'bothSpelled'

		func.mustBeSplicedAtEverySite = true
	end 'claimSplicedAtEverySite'

	// ⭐ **`__Raw.scratch(bytes)` TAKES THE NEXT SLOTS OF THIS FUNCTION'S FRAME, and what the op carries is
	// the SLOT, not the byte count** — `StdOp.stackRecordAddr` names a slot because the frame base is not
	// known until the register allocator has settled it.
	//
	// ⚠ **THE LAYOUT RUNS FROM ZERO WITHIN ONE PARSE, which is what makes it idempotent**: the `IrFunction`
	// this writes is the one THIS parse built, and a warm parse memo hands back that same object without
	// re-running the walk, so the reservation is never counted twice.
	//
	// ⛔ **IT IS THE ONLY WRITER OF `stackSize` BEFORE THE ALLOCATOR, AND THAT RESTS ON E3153.**
	// `promoteStackRecords` ASSIGNS this field rather than accumulating into it, so a function holding both
	// a promoted record and a scratch record would lose the reservation — and no runtime function can hold
	// a promoted record, because a managed value cannot be NAMED in a runtime source file at all.
	function reserveRawScratchSlot(func IrFunction, bytes FullRangeInt, callee ByteArray, calleeTok Token) returns FullRangeInt throws SourceParseError
		// Two tests rather than one disjunction: the cast below is a RANGED door that panics on a negative,
		// so the sign must be settled before the size can be read as one.
		if bytes <= 0 'notPositive'
			throw SourceParseError.builtinOperandPhrase(String.from(callee), required: RawScratchSizeRequirement, got: "{bytes}", line: calleeTok.line, column: calleeTok.column)
		end 'notPositive'

		let requested = bytes as StackSize

		if (requested mod SpillSlotBytes) != 0 'notAWholeNumberOfSlots'
			throw SourceParseError.builtinOperandPhrase(String.from(callee), required: RawScratchSizeRequirement, got: "{bytes}", line: calleeTok.line, column: calleeTok.column)
		end 'notAWholeNumberOfSlots'

		let slot = (func.stackSize / SpillSlotBytes) as FullRangeInt
		func.stackSize = func.stackSize + requested
		return slot
	end 'reserveRawScratchSlot'

	// ⭐ **THE ARITY CHECK AND THE EMIT EVERY CLOCK INTRINSIC SHARES**, written once and returning the
	// integer-tagged reading. All three take no arguments and become one call to a runtime entry point, so
	// only the entry point's NAME differs — `__gt_now_ns` is built at the Std tier, `__clock_now_unix_s` is
	// `runtime/Clock.maxon` source.
	//
	// The arity rejection is the SAME `builtinArity` every other builtin raises — a builtin has no signature
	// registry entry for SemanticCheck's ordinary arity check to consult, which is exactly why that variant
	// exists. `name` is the callee's own bytes so the diagnostic quotes what the user wrote.
	function emitClockIntrinsicCall(args ValueIdArray, name ByteArray, runtimeName ByteArray, resultAlias ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: name, arity: ClockIntrinsicArity, calleeTok: calleeTok)

		return self.emitLibraryAliasedRuntimeCall(runtimeName, args: ValueIdArray.create(0), alias: resultAlias, range: SourceRange.ofToken(calleeTok))
	end 'emitClockIntrinsicCall'

	// `trunc(x)` — **THE f64 → int BRIDGE**, and a compiler BUILTIN rather than a stdlib function.
	//
	// It is a builtin rather than a stdlib function: it lowers to ONE instruction, so a call would be
	// a call/ret wrapped around a single `cvttsd2si`, and a stdlib `trunc` would drag in the stdlib
	// cone. specs/float-type.md ends nearly every case on it, so it is the difference between the
	// float corpus running and not running at all.
	//
	// ⚠ **`trunc(int)` IS THE IDENTITY, and answering it with the operand is CORRECTNESS, not an
	// optimization.** An int → f64 → int round trip loses precision above f64's 53-bit mantissa, so
	// `trunc(i64.max)` would answer a number that is not `i64.max`. It is also what keeps `fpToSi`
	// from ever naming an int → int conversion, which `lowerUnaryOp` panics on.
	//
	function emitTrunc(args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		let operand = try self.numericBuiltinOperand(args, name: TruncBuiltinName, calleeTok: calleeTok)

		// Already an integer: `trunc` has nothing to truncate. See the precision note above.
		if not tagIsFloat(self.tagOf(operand)) 'identity'
			return operand
		end 'identity'

		return self.retypeAsLibraryAlias(self.emitUnaryOp(operand, op: MaxonUnaryOp.trunc, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(calleeTok)), aliasName: FullRangeIntAliasName)
	end 'emitTrunc'

	// ⭐ **ONE VALIDATED NUMERIC OPERAND** — `args[index]`, checked to be a number. The operand-class
	// half of the pair above, and the half that a builtin asks once per operand rather than once per
	// call. Every numeric builtin asks it in exactly the same words, so a `min` whose SECOND argument
	// is a bool is refused with the same sentence as a `sqrt` whose only one is.
	//
	// The caller has already passed `requireBuiltinArity`, which is what makes `index` in range.
	function numericBuiltinOperandAt(args ValueIdArray, index ParamCount, name ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		let operand = try args.get(index) otherwise panic("numericBuiltinOperandAt: args.get OOB at {index} — `requireBuiltinArity` has already fixed args.count() at the builtin's arity, so every index below it resolves")
		let operandTag = self.tagOf(operand)

		if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
			throw SourceParseError.builtinOperandPhrase(String.from(name), required: NumberOperandRequirement, got: self.valueKindWordAt(operand, tag: operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notANumber'

		return operand
	end 'numericBuiltinOperandAt'

	// The ARITY-1 pair asked together, returning the single validated operand — the shape `trunc` and
	// the five arity-1 math intrinsics all want, and the reason they each stayed one line.
	function numericBuiltinOperand(args ValueIdArray, name ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: name, arity: NumericBuiltinArity, calleeTok: calleeTok)

		return try self.numericBuiltinOperandAt(args, index: 0, name: name, calleeTok: calleeTok)
	end 'numericBuiltinOperand'

	// `floor(x)` / `ceil(x)` / `round(x)` / `sqrt(x)` / `abs(x)` — the arity-1 FLOAT math intrinsics, written
	// ONCE for all five because everything but the opcode is identical (specs/{floor,ceil,round,sqrt,abs}.md).
	//
	// ⭐ THE ONE PLACE IT DIVERGES FROM `emitTrunc`, AND IT IS THE WHOLE DIFFERENCE BETWEEN THE TWO:
	// `trunc` LEAVES the float domain, so an integer argument is the IDENTITY and is answered with the
	// operand itself. These STAY inside it — `sqrt(16)` is 4, not 16 — so an integer argument is
	// PROMOTED, not short-circuited. That promotion is what `specs/implicit-type-conversion.md`'s
	// `math-intrinsic-int-promotion` case pins, and it is also what keeps the Std opcode's f64-operand
	// precondition true (`assertUnaryOperandDomain`).
	//
	// The result is a FLOAT, per every one of the five spec files' signature (`floor(x float) float`),
	// which is why each of their tests ends on `trunc(...)` to reach an ExitCode. `specs/abs.md` says so
	// in its own words — "Currently only works with float type … For integer values, convert to float
	// first" — so `abs` needs no integer form, exactly like its four siblings.
	//
	// `name` is the callee's own bytes rather than a name derived from `op`: the caller already holds
	// them, and a diagnostic must quote what the user wrote.
	function emitMathIntrinsic(args ValueIdArray, op MaxonUnaryOp, name ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		let operand = try self.numericBuiltinOperand(args, name: name, calleeTok: calleeTok)
		let promoted = self.promoteToFloat(operand, opTok: calleeTok)
		let result = self.emitUnaryOp(promoted, op: op, resultTag: ValueTypeTag.float, range: SourceRange.ofToken(calleeTok))
		self.adoptOperandAlias(result, alias: OperandAlias.named(self.operandAliasName(operand)), resultTag: ValueTypeTag.float)
		self.settleFloatUnaryOp(result, operand: promoted, op: op)
		return result
	end 'emitMathIntrinsic'

	// ⭐ `__Builtins.floatToBits(x)` — the f64's IEEE-754 ENCODING as an i64. See
	// `BuiltinsFloatToBitsName` for why it exists and why there is no inverse.
	//
	// ⚠ **NO int → float PROMOTION, unlike EVERY math intrinsic beside it, and that asymmetry is the
	// point.** `sqrt(16)` means `sqrt(16.0)` because `sqrt` is a function of a NUMBER and 16 is one.
	// This is a function of an ENCODING: a promoted `floatToBits(16)` would answer the bits of 16.0
	// while READING as "the bits of the integer 16", which is a different number entirely
	// (4625196817309499392 against 16). A program that hands it an integer means something this
	// intrinsic cannot do, so it is told so rather than quietly given the other answer.
	//
	// It is also what keeps `assertUnaryOperandDomain` satisfiable: `bitcastF64ToI64` reads the float
	// register file, and the front end owns that precondition.
	function emitFloatToBits(args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: BuiltinsFloatToBitsName, arity: FloatToBitsArity, calleeTok: calleeTok)

		let operand = try args.get(0) otherwise panic("emitFloatToBits: args.count() == FloatToBitsArity just checked but get(0) failed")

		// ⚠ **THROUGH `floatResolvedTag`, NOT THE BARE TAG** — `emitDeadReturn`'s reason, and the one
		// declaration it matters most for is this intrinsic's only caller: `__float_toString(value
		// FullRangeFloat)` is a PARAMETER of a ranged float alias, which carries a `named` tag at parse time
		// (aliases erase in `resolveTypes`, later) even though the value occupies XMM exactly as a bare
		// float does. The bare tag would refuse the one program that needs this.
		let operandTag = self.floatResolvedTag(self.tagOf(operand), nameId: self.valueNameId(operand))

		if not tagIsFloat(operandTag) 'notAFloat'
			throw SourceParseError.builtinOperandType(String.from(BuiltinsFloatToBitsName), required: typeTagName(ValueTypeTag.float), got: self.valueKindWordAt(operand, tag: operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAFloat'

		return self.retypeAsLibraryAlias(self.emitUnaryOp(operand, op: MaxonUnaryOp.floatToBits, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(calleeTok)), aliasName: FullRangeIntAliasName)
	end 'emitFloatToBits'

	// ⭐ `__Builtins.bitsToFloat(bits)` — the f64 an i64's 64 bits ALREADY SPELL, and the exact inverse of
	// the door above. See `BuiltinsBitsToFloatName` for why it exists: `stdlib/Builtins.maxon` has one
	// decimal→binary64 reader and it answers BITS, so this is what lets `float.fromString` and a float
	// LITERAL be the same conversion instead of two that disagree.
	//
	// ⚠ **NO int → float PROMOTION EITHER, and here the asymmetry is not merely preserved — it is the
	// whole operation.** `emitFloatToBits` refuses an integer because promoting it would answer a
	// different question; this one refuses a FLOAT for the mirror reason. `bitsToFloat(4.0)` cannot mean
	// "the double 4.0" — the operand is an ENCODING, and a float operand has no encoding to read that is
	// not already the value it is. A program handing this a float means something the intrinsic cannot
	// do, so it is told so.
	//
	// It is also what keeps `assertUnaryOperandDomain` satisfiable from the other side:
	// `bitcastI64ToF64` reads the INTEGER register file, and the front end owns that precondition.
	function emitBitsToFloat(args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: BuiltinsBitsToFloatName, arity: BitsToFloatArity, calleeTok: calleeTok)

		let operand = try args.get(0) otherwise panic("emitBitsToFloat: args.count() == BitsToFloatArity just checked but get(0) failed")

		// ⚠ **THROUGH `rangedAliasResolvedTag`, NOT THE BARE TAG** — `emitFloatToBits`'s reason mirrored,
		// and the one declaration it matters most for is again this intrinsic's only caller. The bits
		// `__float_fromString` hands it come out of `__FloatTextResult.bits(value FullRangeInt)`, so the
		// operand is a ranged INT alias — which keeps a `named` tag at parse time (deliberately; see
		// `floatResolvedTag`). The bare tag would refuse the one program that needs this, and would say
		// so in the words "requires an argument of type int, but its argument is int", because `typeTagName` renders
		// `named` as `int`. Resolving first fixes the verdict AND the sentence.
		let operandTag = self.rangedAliasResolvedTag(self.tagOf(operand), nameId: self.valueNameId(operand))

		if not tagIsInteger(operandTag) 'notAnInteger'
			throw SourceParseError.builtinOperandType(String.from(BuiltinsBitsToFloatName), required: typeTagName(ValueTypeTag.integer), got: self.valueKindWordAt(operand, tag: operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInteger'

		return self.emitFullRangeFloatBits(operand, range: SourceRange.ofToken(calleeTok))
	end 'emitBitsToFloat'

	function emitAesCipherIntrinsic(func IrFunction, args ValueIdArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, callee ByteArray, intrinsic AesCipherIntrinsic, calleeTok Token, resultUsed bool) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: callee, arity: aesCipherArity(intrinsic), calleeTok: calleeTok)

		let answersVerdict = aesCipherAnswersVerdict(intrinsic)

		if resultUsed and not answersVerdict 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(callee), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		for index in 0 upto args.count() 'eachOperand'
			let operand = try args.get(index) otherwise panic("emitAesCipherIntrinsic: args.count() == aesCipherArity just checked but get({index}) failed")

			if aesCipherOperandIsOffset(intrinsic, index: index as ParamCount) 'anOffset'
				let operandTag = self.rangedAliasResolvedTag(self.tagOf(operand), nameId: self.valueNameId(operand))

				if not tagIsInteger(operandTag) 'notAnInteger'
					throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueKindWordAt(operand, tag: operandTag), line: calleeTok.line, column: calleeTok.column)
				end 'notAnInteger'
			end 'anOffset' else 'aBuffer'
				if not self.valueIsByteBuffer(operand) 'notAByteBuffer'
					throw SourceParseError.builtinOperandType(String.from(callee), required: AesCipherBufferRequirement, got: self.valueDisplayTypeName(operand), line: calleeTok.line, column: calleeTok.column)
				end 'notAByteBuffer'
			end 'aBuffer'
		end 'eachOperand'

		self.noteWrittenArgument(func, args: args, argImmutableNames: argImmutableNames, argAnchors: argAnchors, calleeTok: calleeTok, position: AesWrittenOperandPosition)

		return self.emitRuntimeCall(aesCipherRuntimeName(intrinsic), args: args, resultTag: ValueTypeTag.boolean if answersVerdict else ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitAesCipherIntrinsic'

	function emitOrderedWordAccess(func IrFunction, args ValueIdArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, callee ByteArray, intrinsic OrderedWordIntrinsic, calleeTok Token, resultUsed bool) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: callee, arity: OrderedWordArity, calleeTok: calleeTok)

		let buffer = try args.get(0) otherwise panic("emitOrderedWordAccess: args.count() == OrderedWordArity just checked but get(0) failed")
		let integer = try args.get(1) otherwise panic("emitOrderedWordAccess: args.count() == OrderedWordArity just checked but get(1) failed")
		let widthOperand = try args.get(2) otherwise panic("emitOrderedWordAccess: args.count() == OrderedWordArity just checked but get(2) failed")
		let width = try self.requireOrderedWordOperands(buffer, integer: integer, widthOperand: widthOperand, callee: callee, calleeTok: calleeTok)
		let entry = wordEntryName(intrinsic.access, order: intrinsic.order, width: width)
		let range = SourceRange.ofToken(calleeTok)

		if intrinsic.access == WordAccess.put and resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(callee), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		match intrinsic.access 'access'
			get then return self.emitLibraryAliasedRuntimeCall(entry, args: twoArgs(buffer, second: integer), alias: OrderedWordAliasName, range: range)
			put then break
		end 'access'

		self.noteWrittenArgument(func, args: args, argImmutableNames: argImmutableNames, argAnchors: argAnchors, calleeTok: calleeTok)
		return self.emitRuntimeCall(entry, args: twoArgs(buffer, second: integer), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitOrderedWordAccess'

	function requireOrderedWordOperands(buffer ValueId, integer ValueId, widthOperand ValueId, callee ByteArray, calleeTok Token) returns WordBytes throws SourceParseError
		if not self.valueIsByteArray(buffer) 'notAByteArray'
			throw SourceParseError.builtinOperandType(String.from(callee), required: OrderedWordSourceRequirement, got: self.valueDisplayTypeName(buffer), line: calleeTok.line, column: calleeTok.column)
		end 'notAByteArray'

		let integerTag = self.rangedAliasResolvedTag(self.tagOf(integer), nameId: self.valueNameId(integer))

		if not tagIsInteger(integerTag) 'notAnInteger'
			throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueKindWordAt(integer, tag: integerTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInteger'

		if not self.constIsKnown(widthOperand) 'notConstant'
			throw SourceParseError.builtinOperandPhrase(String.from(callee), required: OrderedWordWidthRequirement, got: NotACompileTimeConstant, line: calleeTok.line, column: calleeTok.column)
		end 'notConstant'

		return try wordBytesOfCount(self.constOf(widthOperand)) otherwise throw SourceParseError.builtinOperandPhrase(String.from(callee), required: OrderedWordWidthRequirement, got: "{self.constOf(widthOperand)}", line: calleeTok.line, column: calleeTok.column)
	end 'requireOrderedWordOperands'

	function emitFullRangeFloatBits(bits ValueId, range SourceRange) returns ValueId
		let value = self.emitUnaryOp(bits, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: range)
		self.wearFullRangeFloat(value)
		return value
	end 'emitFullRangeFloatBits'

	// ⭐ `min(a, b)` / `max(a, b)` — the ARITY-2 FLOAT MATH INTRINSICS (`specs/min.md`,
	// `specs/max.md`), and the exact mirror of `emitMathIntrinsic` one arity up: same arity gate, same
	// operand-class gate, same promotion, same explicitly-float result. Only the operand COUNT and the
	// op's tier differ, which is why the two share `requireBuiltinArity` and
	// `numericBuiltinOperandAt` rather than each stating the rules again.
	//
	// ⭐ **ONE FUNCTION SERVES BOTH, PARAMETERISED BY THE OPCODE**, exactly as `emitMathIntrinsic` serves
	// five: `min` and `max` differ in nothing this function does — not the arity, not the operand class,
	// not the promotion, not the result tag — so a second copy of it would have been five identical
	// rules and one differing token.
	//
	// ⭐ **BOTH OPERANDS ARE PROMOTED, exactly as the arity-1 intrinsics promote their one.** These
	// stay INSIDE the float domain (`min(3, 5)` is `3.0`, not an integer 3), so an integer argument is
	// converted rather than short-circuited the way `trunc`'s is — and the promotion is what keeps
	// `StdBinOpcode`'s f64-operand precondition true (`appendStdBinOp`'s float-only guard). Each spec's
	// Notes say the same in its own words: *"For integer inputs, values are automatically promoted to
	// float."*
	//
	// ⭐ It reaches `emitBinOpOverCheckedOperands`, NOT `emitBinOp`: the operand rule has already been
	// asked, in the BUILTIN's words (which quote the callee the user wrote) rather than the operator's
	// (which would quote a symbol that appears nowhere in `min(3.0, 5.0)`). That door exists for
	// exactly this — a caller that has done the checking itself — and taking it is what keeps
	// `requireBinOpOperands` a single copy instead of gaining a "trust me" flag.
	//
	// ⚠ The operand ORDER is load-bearing and must not be normalised anywhere downstream: neither op is
	// commutative on NaN input. See `StdBinOpcode`'s `min`/`max` header.
	// ⭐⭐⭐ **THE MATH-INTRINSIC FAMILY'S ONE DISPATCH, ENTERED ONLY THROUGH ITS ONE ROSTER.** The bytes
	// are turned into a `MathBuiltin` here and nowhere else downstream, because `parseCallNamed` gates
	// this call on `calleeTakesPositionalArgsOnly`, which is that same recognizer — so the SET is written
	// down once and the emit hangs off it, rather than the two being parallel lists 33,000 lines apart
	// that happen to agree today.
	//
	// ⚠⚠ **THE PARALLEL LISTS WERE SCHEDULED TO DIVERGE, THE APPOINTMENT WAS IN THE DIARY, AND IT WAS
	// KEPT.** `max` arrived at its own whitelist position, arity-2, beside `min`. Under the ORIGINAL shape
	// — two hand-written `equals` chains — an implementer who added its emit arm and forgot the roster
	// would have got a compiler where `max(3.0, b: 5.0)` answers **E2052**, the exact wrong noun this
	// family was moved off, as a WRONG ANSWER rather than a compile error, with a green suite, because no
	// `max` label case exists to catch it. That is this project's signature bug (ONE FACT WRITTEN DOWN
	// TWICE), and it is the same shape that left the arity-1 builtins on the old noun when `min` landed.
	//
	// ⭐⭐ **IT CLOSES BOTH DIRECTIONS, AND THE SECOND ONE IS NOW A COMPILE ERROR RATHER THAN A PANIC:**
	//   • a name cannot reach an emit arm without being in the roster — STRUCTURALLY, since the gate is
	//     the roster;
	//   • a `MathBuiltin` with no emit arm does not BUILD — `emitMathBuiltin` matches the enum
	//     exhaustively, so the half-edit is refused by the compiler that compiles this file rather than by
	//     the first program that calls the new builtin. `mathBuiltinSignature` and `mathBuiltinHelp` hold
	//     the member to the same standard, which is why a fourth fact about a builtin (its help text)
	//     could be added without giving anyone a fifth list to keep in step.
	//
	// The three emitters differ and that difference is the family's real content: `trunc` LEAVES the float
	// domain (so an integer argument is the identity), the five arity-1 intrinsics STAY inside it (so an
	// integer argument is promoted), and `min`/`max` are the arity-2 pair. See each. Note the emitters
	// number three while the roster numbers eight — the arms are a MEMBER→OP map, and how many members
	// share an emitter is the point of having one.
	function emitPositionalMathBuiltin(args ValueIdArray, callee ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		match mathBuiltinNamed(callee) 'roster'
			found(builtin) then return try self.emitMathBuiltin(args, builtin: builtin, callee: callee, calleeTok: calleeTok)
			absent then panic("emitPositionalMathBuiltin: '{String.from(callee)}' reached the math-intrinsic emit without being in `mathBuiltinNamed`, which is the very roster `calleeTakesPositionalArgsOnly` gated this call on — the two cannot disagree, so this is a `mathBuiltinNamed` that answered differently for one name in one call than in the other")
		end 'roster'
	end 'emitPositionalMathBuiltin'

	// The NAME→OP half of the roster. Exhaustive over `MathBuiltin`, which is what makes a member added
	// without an emit a COMPILE error here rather than a panic on the first program that calls it.
	function emitMathBuiltin(args ValueIdArray, builtin MathBuiltin, callee ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		match builtin 'member'
			trunc then return try self.emitTrunc(args, calleeTok: calleeTok)
			floor then return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.floor, name: callee, calleeTok: calleeTok)
			ceil then return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.ceil, name: callee, calleeTok: calleeTok)
			round then return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.round, name: callee, calleeTok: calleeTok)
			sqrt then return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.sqrt, name: callee, calleeTok: calleeTok)
			abs then return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.abs, name: callee, calleeTok: calleeTok)

			// The ARITY-2 pair. A `MaxonBinOp` rather than a `MaxonUnaryOp`, so they reach
			// `emitBinaryMathIntrinsic`; they differ from each other in nothing but which opcode they name.
			min then return try self.emitBinaryMathIntrinsic(args, op: MaxonBinOp.min, name: callee, calleeTok: calleeTok)
			max then return try self.emitBinaryMathIntrinsic(args, op: MaxonBinOp.max, name: callee, calleeTok: calleeTok)
		end 'member'
	end 'emitMathBuiltin'

	function emitBinaryMathIntrinsic(args ValueIdArray, op MaxonBinOp, name ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: name, arity: BinaryNumericBuiltinArity, calleeTok: calleeTok)

		let leftOperand = try self.numericBuiltinOperandAt(args, index: 0, name: name, calleeTok: calleeTok)
		let rightOperand = try self.numericBuiltinOperandAt(args, index: 1, name: name, calleeTok: calleeTok)

		// ⭐ **THE NOMINAL RULE IS ASKED OF THE OPERANDS AS WRITTEN, ABOVE THE PROMOTION** — a `min` is a
		// binary operator spelled as a builtin, and the promotion below erases the typealias each argument
		// carries. The op is quoted by the CALLEE the user wrote, for the reason `requireBinOpOperands` is
		// not asked here at all: there is no operator symbol anywhere in `min(a, y)`.
		let operandAlias = try self.operandAliasIdentity(leftOperand, rhs: rightOperand, opName: String.from(name), opTok: calleeTok)

		let lhs = self.promoteToFloat(leftOperand, opTok: calleeTok)
		let rhs = self.promoteToFloat(rightOperand, opTok: calleeTok)

		return self.emitBinOpOverCheckedOperands(lhs, rhs: rhs, op: op, leftTag: ValueTypeTag.float, rightTag: ValueTypeTag.float, opTok: calleeTok, operandAlias: operandAlias)
	end 'emitBinaryMathIntrinsic'

	// `__Builtins.writeStdout(mm)` / `__Builtins.writeStderr(mm)` — **WRITE A MANAGED BUFFER'S BYTES TO A
	// STANDARD STREAM** and answer the byte count. `stdlib/Print.maxon`'s and
	// `stdlib/PrintError.maxon`'s only floor: each module's one-line body hands over
	// `value.addressableBytes()` and this is what it reaches.
	//
	// ⚠ **THE INTRINSIC IS STDLIB'S FLOOR, NOT THE SURFACE** — `emitSleep`'s paragraph, one family over.
	// What a user writes is `print(s)`, an ordinary call to a corpus declaration, and the rules it meets
	// are that declaration's (its parameter type, its absent return), checked by SemanticCheck against
	// its signature like every other call's. The check below is what an intrinsic needs BECAUSE no file
	// declares it: there is no signature for the ordinary check to read.
	//
	// It validates its argument. Unchecked, a non-managed argument dies inside the lowering rather
	// than as a diagnostic. The check goes through `valueIsByteArray`, the SHARED predicate
	// `String.from` and every `__Managed*` parameter already ask, rather than a fourth spelling of "is
	// this a byte-packed buffer".
	//
	// The refusal NAMES THE CALLEE (`builtinOperandType`), which is the `__Builtins.*` family's spelling
	// and the right one here: an intrinsic has no declaration, so there is no parameter name to quote that
	// the author could have written.
	function emitBuiltinsStreamWrite(args ValueIdArray, callee ByteArray, runtimeName ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: callee, arity: StreamWriteArity, calleeTok: calleeTok)

		let arg = try args.get(0) otherwise panic("emitBuiltinsStreamWrite: args.count() == StreamWriteArity just checked but get(0) failed")

		if not self.valueIsByteArray(arg) 'notAManagedBuffer'
			throw SourceParseError.builtinOperandType(String.from(callee), required: String.from(ManagedMemoryTypeName), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAManagedBuffer'

		// ⭐⭐ **THE VIEW THIS WRITE WOULD HAVE CONSUMED IS FOLDED AWAY WHEN THE WRITE IS ITS ONLY CONSUMER.**
		// See `foldByteViewIntoStreamWrite` for the two conditions and for what the fold is worth.
		if let viewOpIdx = try self.filedStringBytesViewOp(arg) 'aByteViewOfAString'
			if self.pendingTempsContain(arg) and self.byteViewCallStillSitsAt(viewOpIdx) 'thisWriteIsItsSoleConsumer'
				return self.foldByteViewIntoStreamWrite(arg, viewOpIdx: viewOpIdx, runtimeName: runtimeName)
			end 'thisWriteIsItsSoleConsumer'
		end 'aByteViewOfAString'

		// The buffer is BORROWED — the runtime entry reads `buffer@0`/`length@8` through it and never takes
		// ownership — so there is no owned temporary to enrol and a literal argument needs no decref. This is
		// exactly how `__Builtins.runProcess` borrows its command line.
		let callArgs = ValueIdArray.create(1, zeroed: false)
		callArgs.push(arg)
		return self.emitLibraryAliasedRuntimeCall(runtimeName, args: callArgs, alias: CountAliasName, range: SourceRange.ofToken(calleeTok))
	end 'emitBuiltinsStreamWrite'

	// ⭐⭐ **`__Builtins.ucdByteAt("__ucd_bmp", offset: cp)` — A RAW READ OF A CHECKED-IN UNICODE TABLE.**
	// Serves both intrinsics, differing only in `load` — the TABLE — which is what makes the two
	// impossible to enforce differently: the sibling door is where this repo's recorded scar lives (a rule
	// applied to the one name that forced the question and left standing one name over).
	//
	// ⚠ **THE TABLE IS THE ONLY THING A CALLER STATES.** The label this demands, the leaf it emits a call
	// to and the parameter name it checks are DERIVED from `load` (`ucdTableStemOf` / `ucdRuntimeNameOf` /
	// `ucdIndexParamNameOf`), because all three are one fact about one table. Threaded as separate
	// arguments they were three chances for a call site to demand one table's label and read the other's
	// bytes — a wrong ANSWER with nothing to catch it, since neither the label check nor the emitted call
	// can see what the other was handed.
	//
	// ⭐⭐ **IT PARSES ITS OWN ARGUMENTS, AND ONLY THE LABEL IS THE REASON.** The label selects a blob
	// the compiler LINKS, so it has to be known while the call is parsed; taken off its token, a
	// computed label is structurally impossible rather than merely refused, and no dead
	// `stringLiteral` op or `.rdata` String record is minted for text that never becomes a value.
	//
	// ⭐ **EVERY RULE IT APPLIES IS ASKED THROUGH THE DOOR THAT OWNS IT, NOT RESTATED HERE.**
	// `consumeArgLabel` decides E2052 for the label argument and E2053 for the index argument — the one
	// place either is decided — and this function adds only the question a declared callee's own
	// signature would have answered downstream (does the label name THIS parameter?) plus the roster
	// check, which is the security guard `UnicodeCategoryRuntime`'s header measures.
	//
	// ⚠ The result is a bare i64: `tagIsIntegral` and not `tagIsInteger`, for the reason the `readStdin`
	// arm records — a ranged alias carries the `named` tag until TypeResolution collapses it, and an index
	// is exactly the sort of value a corpus spells with one (`stdlib/helpers/string/unicodeCategory.maxon`
	// hands over a `Codepoint`).
	function parseUcdTableLoad(func IrFunction, callee ByteArray, load UcdTableStride, anchor Token) returns ValueId throws SourceParseError
		// The table label is the FIRST argument and its parameter has no default, so it is positional.
		// Asked BEFORE the literal is consumed so a labelled one earns E2052 instead of "expected a
		// string literal".
		_ = try self.consumeArgLabel(0, rule: ArgLabelRule.ordinary)

		let labelTok = try self.consume(TokenKind.stringLiteral)
		let label = try self.decodedStringLiteralBytes(labelTok)
		let table = ucdLabel(ucdTableStemOf(load))

		if not label.equals(table.toByteArray()) 'notThisIntrinsicsTable'
			throw SourceParseError.ucdTableLabelUnknown(String.from(callee), table: table, label: String.from(label), line: labelTok.line, column: labelTok.column)
		end 'notThisIntrinsicsTable'

		// A call that stops after the label is a missing second argument, and `consume` says so at the
		// `)` it found. There is no builtin-arity diagnostic for this shape.
		try self.consume(TokenKind.comma)

		let indexTok = self.current()
		let argLabel = try self.consumeArgLabel(1, rule: ArgLabelRule.ordinary)

		if not argLabel.equals(ucdIndexParamNameOf(load)) 'notTheDeclaredParameter'
			throw SourceParseError.builtinUnknownArgLabel(String.from(callee), label: String.from(argLabel), line: indexTok.line, column: indexTok.column)
		end 'notTheDeclaredParameter'

		let index = try self.parseValueExpression(func)

		if not tagIsIntegral(self.numberTagOf(index)) 'notAnIndex'
			throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueKindWord(index), line: indexTok.line, column: indexTok.column)
		end 'notAnIndex'

		try self.consume(TokenKind.rightParen)

		return self.emitLibraryAliasedRuntimeCall(ucdRuntimeNameOf(load), args: argsOf(index), alias: self.ucdAnswerAliasOf(load), range: SourceRange.ofToken(anchor))
	end 'parseUcdTableLoad'

	function ucdAnswerAliasOf(load UcdTableStride) returns immutable ByteArray
		return match load 'stride'
			byteIndexed gives ByteAliasName
			packedEntry gives FullRangeIntAliasName
		end 'stride'
	end 'ucdAnswerAliasOf'

	// ⭐⭐ **`__DebugStream.nameId("…")` — THE NAME IS INTERNED, THE CALL IS A MARKER.** The literal is read
	// off its token and recorded against the op this emits (`Project.debugStreamNameSites`); the op itself
	// is a zero-argument `__ds_name_id` call that `LowerMaxonToStd` replaces WHOLE with the interned index.
	// So nothing about the name survives as a value, which is the contract — see `DebugStreamNameIdCallee`.
	//
	// ⚠ **THE INDEX CANNOT BE MINTED HERE, AND THAT IS WHY THIS EMITS AN OP AT ALL RATHER THAN A CONSTANT.**
	// The numbering is a property of the PROGRAM: two files naming `"parse"` must get one id. A parser holds
	// one file's artifact and no whole-program registry it may write to (`ProgramSignatures` takes no
	// `Project`, by design), and artifacts are cached and merged in a fixed order — so the first tier that
	// can number them is the one that walks the merged module.
	//
	// ⚠ **THE LABEL RULE IS `consumeArgLabel`'s, NOT A SECOND COPY**, exactly as the UCD loads' is: the
	// first argument of a list with no defaults is positional. Asked BEFORE the literal is consumed so
	// a labelled one earns E2052 rather than "expected a string literal".
	//
	// ⚠ **AN INTERPOLATED LITERAL IS REFUSED BY THE `)` EXPECTATION AND NOT BY A RULE OF ITS OWN.** A
	// hole cannot be known while the call is parsed; `self.at(stringLiteral)` is true for `"a{n}"`
	// too, so the consume succeeds and the interpolation start is then what the `)` finds.
	// `__Builtins.ucdByteAt`'s label answers the same way, so the shapes of one mistake read alike.
	function parseDebugStreamNameId(func IrFunction, anchor Token) returns ValueId throws SourceParseError
		_ = try self.consumeArgLabel(0, rule: ArgLabelRule.ordinary)

		// A non-literal argument is refused with the sentence `parsePanicMessage` uses for the identical
		// requirement, quoting the TYPE the author actually wrote — which means parsing the expression to
		// have a type to name. It is never emitted: the throw is unconditional on this path.
		if not self.at(TokenKind.stringLiteral) 'notALiteral'
			let argTok = self.current()
			let arg = try self.parseValueExpression(func)
			throw SourceParseError.builtinOperandPhrase(String.from(DebugStreamNameIdCallee), required: StringLiteralRequirement, got: self.valueDisplayTypeName(arg), line: argTok.line, column: argTok.column)
		end 'notALiteral'

		let nameTok = try self.consume(TokenKind.stringLiteral)
		let name = try self.decodedStringLiteralBytes(nameTok)
		try self.consume(TokenKind.rightParen)

		self.artifact.recordDebugStreamNameSite(name)
		return self.emitRuntimeCall(DebugStreamNameIdMarkerName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
	end 'parseDebugStreamNameId'

	// ⭐⭐⭐ **`__Builtins.writeStdout(s.addressableBytes())` BECOMES `__write_stdout(s)` — ONE OP REWRITTEN, ONE
	// FIELD CHANGED.** The byte value exists to satisfy a TYPE, not a USE:
	// `addressableBytes()` yields an `Array with Byte` so the value can be TYPED as one, and the write reads
	// `buffer@0` and `length@8` — the two slots a String record already carries, at the SAME offsets (see
	// `StringRuntime.buildStreamWrite`). So the whole call chain runs for a consumer that reads nothing the
	// receiver did not already have, and with it arrives `__managed_decref` and the leak gate.
	//
	// ⚠ A String record IS a buffer record, so the producer is one `__mm_incref` and the drop is a
	// `__managed_decref`. The fold removes both, plus two calls, and keeps the buffer runtime out of a
	// program that only prints.
	//
	// ⚠⚠ **THE OP IT REWRITES IS A CORPUS CALL** — `String.addressableBytes(s)`, `stdlib/String.maxon:181`'s
	// member, filed by `dispatchMethodOnBase`. It carries one result and ONE argument, and that argument is
	// the String, so re-pointing the callee turns the producer into the consumer.
	// ⇒ **The fold is NOT an inliner and does not need to be**: it never reads the callee's body, only the
	// fact that this call's one argument is the thing the write actually wants.
	//
	// ⭐ **THE REWRITE CHANGES THE CALLEE AND NOTHING ELSE.** Same result value, same single argument, same
	// labels, ranges and mint — so the shape cannot drift and there is no second op to keep in step. The
	// value's TYPE moves from the byte instance to `integer` (it is now the write's byte count) and its OWNED
	// enrolment is released, which is what removes the `__managed_decref` the statement would otherwise emit.
	//
	// ⚠⚠ **THE NON-ESCAPE CONDITION IS `pendingTempsContain`, AND IT IS A PROOF RATHER THAN A GUESS.** That
	// list holds exactly the owned temporaries no binding has taken (`removeFromPendingTemps` runs at every
	// transfer, and its own header states the two homes are disjoint by construction). So a view that reached
	// a `let`, a field, a return or a promoted scope is NOT in it and the fold declines — `arr.managed` and
	// `let b = s.addressableBytes()` both keep the record they legitimately need. The only other reader a
	// value in that list can have is the statement-end drop, which is the very op this removes.
	//
	// ⚠ **AND THE INDEX IS RE-MATCHED, NOT TRUSTED** (`byteViewCallStillSitsAt`). The filing site
	// reads `opCount()` as a FLOOR before handing the cursor to `parseCallNamed`; if that ever appends
	// a setup op first, the floor names the wrong op and the fold DECLINES rather than rewriting it.
	// ⚠ The receiver's own ownership is UNTOUCHED: the write BORROWS the String exactly as `__print_string`
	// borrowed it and as `__gt_process_run` borrows its command line, and the String is this call's argument
	// so it outlives the call by construction — the shape `stdlib/Subprocess.maxon:529-536` records a UAF for
	// (a byte view outliving its String) cannot arise, because nothing survives the call at all.
	// The fold's precondition that is about the OP rather than about ownership — asked at the call site so a
	// decline falls through to the ordinary emit, which is where the token for its range lives.
	// ⚠ **THIS ASKS RESEMBLANCE (is the op at that index a call to this callee?), NOT IDENTITY.** Its sibling
	// `currentBlockStillHoldsFiledOp` asks the stronger question — is the filed op ref still standing at the
	// filed position of the filed block — because the constant-slice fold can take an op REF out of a block
	// (`removeCurrentBlockOpAt`). This one cannot notice that, and does not have to: the op it names is a
	// corpus `addressableBytes` call, which no remover targets. **A second remover would change that**, and
	// the fix would be to file the block and position here too rather than to widen the name test.
	function byteViewCallStillSitsAt(viewOpIdx ElementIndex) returns bool
		return opIsDirectCallTo(try self.artifact.module.ops.get(viewOpIdx) otherwise panic("byteViewCallStillSitsAt: ops.get({viewOpIdx}) OOB — the index was filed by `dispatchMethodOnBase` as the floor the corpus call would land at, and `module.ops` is append-only: a fold may orphan an op REF, never renumber or drop the op"), callee: qualifiedMethodName(StringConformerName, methodName: CorpusAddressableBytes))
	end 'byteViewCallStillSitsAt'

	function foldByteViewIntoStreamWrite(view ValueId, viewOpIdx ElementIndex, runtimeName ByteArray) returns ValueId
		let viewOp = try self.artifact.module.ops.get(viewOpIdx) otherwise panic("foldByteViewIntoStreamWrite: ops.get({viewOpIdx}) OOB — `byteViewCallStillSitsAt` just read the same index")
		try self.artifact.module.ops.set(viewOpIdx, value: callWithCallee(viewOp, callee: runtimeName)) otherwise panic("foldByteViewIntoStreamWrite: ops.set({viewOpIdx}) OOB — the index was read one line above")

		self.releaseOwnedTemp(view)
		self.unmarkBufferSurface(view)
		self.retypeValue(view, valueType: MaxonType.integer)
		return view
	end 'foldByteViewIntoStreamWrite'

	// `__Builtins.sleep(ms)` — **SUSPEND THE CURRENT GREEN THREAD** for `ms` milliseconds, yielding to the
	// scheduler. It emits no `MaxonOp.call` to a user function — it routes to the
	// `__gt_sleep` scheduler runtime entry (which parks the running GT on a timer and yields). It requires
	// exactly one INTEGER argument (the duration; a float/String/bool is refused) and returns VOID, so a call
	// in value position is rejected exactly as a void user-call is.
	//
	// ⚠ **THE INTRINSIC IS STDLIB'S FLOOR, NOT THE SURFACE.** What a user writes is `sleep(ms)`, an ordinary
	// call to `stdlib/Sleep.maxon`'s declaration, and the rules it meets are that declaration's — its
	// parameter type, its absent return — checked by SemanticCheck against its signature like every other
	// call's. The checks below are what an intrinsic needs BECAUSE no file declares it: there is no signature
	// for the ordinary checks to read. So they are not a second copy of the same rule; they are the rule for
	// the one call site `stdlib/Sleep.maxon`'s body makes.
	function emitSleep(args ValueIdArray, calleeTok Token, resultUsed bool) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: BuiltinsSleepName, arity: SleepIntrinsicArity, calleeTok: calleeTok)

		let arg = try args.get(0) otherwise panic("emitSleep: args.count() == SleepIntrinsicArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)

		if not typeClassAdmits(TypeClass.numeric, tag: argTag) or tagIsFloat(argTag) 'notAnInt'
			throw SourceParseError.builtinOperandPhrase(String.from(BuiltinsSleepName), required: IntegerOperandRequirement, got: self.valueKindWord(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		// The intrinsic returns nothing, so using its result is using a value that is not there — the same
		// error a void user-call gets in value position.
		if resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(BuiltinsSleepName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		let callArgs = ValueIdArray.create(1, zeroed: false)
		callArgs.push(arg)
		return self.emitRuntimeCall(GtSleepName, args: callArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSleep'

	// ⭐⭐ **THE RULE EVERY ARGUMENTLESS VOID INTRINSIC IS CHECKED AGAINST, IN ONE PLACE** —
	// `emitCommandLineRuntimeCall`'s shape one family over, and landed for its stated reason: two doors
	// (`__Builtins.yield` ⇒ `__gt_resched`, `__Builtins.parallelBoundary` ⇒ `__parallel_boundary`) ask the
	// IDENTICAL two questions of the identical argument shape — *were any arguments written?* and *is the
	// nothing it returns being read?* — and a second verbatim copy of the answer is a second place for the
	// rule to drift.
	//
	// There is no operand-type check to make: `emitSleep`'s integer gate exists because `sleep` HAS an
	// argument, and these do not; the arity check alone is the whole rule for an intrinsic no file declares.
	//
	// ⚠ **THE ARITY IS A PARAMETER THOUGH BOTH CALLERS PASS 0**, exactly as `emitCommandLineRuntimeCall`'s is
	// though all three of ITS callers pass 1: the constant is what says what a given intrinsic IS, and
	// collapsing two documented constants into a literal here would put that fact in the wrong file.
	//
	// ⚠ The two callers differ in EVERYTHING the runtime does — one hands the processor to the next green
	// thread, the other returns immediately — and in nothing this function can see. That is the point: what is
	// shared is the CALL CONTRACT, and the entry point is a parameter.
	function emitVoidZeroArgIntrinsic(args ValueIdArray, builtinName ByteArray, runtimeName ByteArray, arity ParamCount, calleeTok Token, resultUsed bool) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: builtinName, arity: arity, calleeTok: calleeTok)

		if resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(builtinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		return self.emitRuntimeCall(runtimeName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitVoidZeroArgIntrinsic'

	// ⭐⭐ **THE RULE EVERY ARGUMENTLESS VALUE-ANSWERING INTRINSIC IS CHECKED AGAINST, IN ONE PLACE** — the
	// twin of `emitVoidZeroArgIntrinsic` above. Every caller asks the identical question of the identical
	// argument shape — *were any arguments written?* — and answers with a machine word the caller reads and
	// drops, so the rule lives here once rather than once per intrinsic.
	//
	// ⚠ **IT DIFFERS FROM THE VOID TWIN IN EXACTLY ONE THING BEYOND THE RESULT TAG: there is no
	// `resultUsed` gate.** A void intrinsic must refuse a value position because there is no value; these
	// ANSWER one, so reading it is the point and ignoring it is legal.
	//
	// ⚠ There is nothing to own, nothing to enrol as a temporary and no buffer surface to mark, which is
	// what separates this door from `emitOwnedManagedMemoryResult`'s: that one hands back a
	// `__ManagedMemory` the caller frees, and using it here would enrol a drop against an integer.
	//
	// ⚠ **THE ARITY IS A PARAMETER THOUGH EVERY CALLER PASSES 0**, exactly as `emitVoidZeroArgIntrinsic`'s
	// is: the constant is what says what a given intrinsic IS, and collapsing the documented constants into
	// a literal here would put that fact in the wrong file.
	//
	// ⚠ **THE RESULT TAG IS A PARAMETER THOUGH NEARLY EVERY CALLER PASSES `integer`.** What an intrinsic
	// ANSWERS is a fact about its own contract, and `stdoutWantsAnsiColor` answers a PREDICATE: a second
	// copy of this door differing only in that tag would be the duplication this file's other shared doors
	// exist to prevent, and a `boolean` intrinsic forced through an `integer` one would reach its caller
	// needing `!= 0`.
	function emitZeroArgIntrinsic(args ValueIdArray, builtinName ByteArray, runtimeName ByteArray, arity ParamCount, resultTag ValueTypeTag, resultAlias ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: builtinName, arity: arity, calleeTok: calleeTok)

		return self.emitIntrinsicAnswer(runtimeName, args: ValueIdArray.create(0), resultTag: resultTag, resultAlias: resultAlias, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitZeroArgIntrinsic'

	function emitZeroArgBufferIntrinsic(args ValueIdArray, builtinName ByteArray, runtimeName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: builtinName, arity: arity, calleeTok: calleeTok)

		return self.emitOwnedManagedMemoryResult(runtimeName, args: ValueIdArray.create(0), range: SourceRange.ofToken(calleeTok))
	end 'emitZeroArgBufferIntrinsic'

	// ⭐⭐ **THE ARGUMENT RULE EVERY COMMAND-LINE BUILTIN IS CHECKED AGAINST, IN ONE PLACE** — the
	// `requireHandleArg`/`requireIntrinsicArgs` shape, one family over. Three doors spawn a child from a
	// command line (`__Builtins.runProcess` → `__gt_process_run`, `spawnReadLine` → `__gt_io_read`,
	// `subpSpawn` → `__gt_subp_spawn`) and every one of them asks the identical two questions of the
	// identical argument shape: exactly one argument, and it is TEXT. They had three verbatim copies of the
	// answer, which is three places for the rule to drift and the thing `requireIntrinsicArgs`'s own header
	// says this file exists to stop (a band of doors growing one spelling each of the same two questions).
	//
	// ⚠ Checking it here at all is what an intrinsic needs BECAUSE no file declares it: there is no
	// signature for SemanticCheck's ordinary arity and argument-type checks to read.
	//
	// ⚠ **THE ARITY IS A PARAMETER THOUGH ALL THREE PASS 1**, exactly as `requireHandleArg`'s is though its
	// six callers pass two values: the constant is what says what a given builtin IS, and collapsing three
	// documented constants into a literal here would put that fact in the wrong file.
	//
	// ⚠ The String is BORROWED by all three entries — each reads `buffer`/`length` out of the 56-byte record
	// and never takes ownership — so this emits an ordinary `emitRuntimeCall` and enrols no drop. A future
	// command-line entry that CONSUMED its argument could not share this door.
	function emitCommandLineRuntimeCall(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: builtinName, arity: arity, calleeTok: calleeTok)

		let commandLine = try args.get(0) otherwise panic("emitCommandLineRuntimeCall: arity just checked but get(0) failed")
		let argTag = self.tagOf(commandLine)

		if not tagIsText(argTag) 'notAString'
			throw SourceParseError.builtinOperandType(String.from(builtinName), required: typeTagName(ValueTypeTag.string), got: self.valueKindWord(commandLine), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		let callArgs = ValueIdArray.create(1, zeroed: false)
		callArgs.push(commandLine)
		return self.emitLibraryAliasedRuntimeCall(runtimeName, args: callArgs, alias: FullRangeIntAliasName, range: SourceRange.ofToken(calleeTok))
	end 'emitCommandLineRuntimeCall'

	// Validate a streaming builtin's single INTEGER handle argument (arity 1, integer, not float) and return it —
	// the shared front of `subpReadLine`/`subpReadErrLine`/`subpCloseStdin`/`subpWait`/`subpRelease`, so the arity +
	// operand-class diagnostics are produced in one place.
	function requireHandleArg(args ValueIdArray, builtinName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: builtinName, arity: arity, calleeTok: calleeTok)

		let handle = try args.get(0) otherwise panic("requireHandleArg: arity just checked but get(0) failed")

		// ⚠ `tagIsIntegral`, NOT `typeClassAdmits(numeric, …) and not tagIsFloat(…)`. `tagIsIntegral`'s own
		// header names the composed form as the spelling to avoid and says why: the composition answers TRUE for `unresolved`, a tag that agrees with
		// everything by deferral — so a handle of a type nobody has settled reached the emit unrefused.
		// It is also the one predicate `requireIntrinsicArgs` asks one family over, which is what stops
		// the two doors of one question from drifting.
		if not tagIsIntegral(self.numberTagOf(handle)) 'notAnInt'
			throw SourceParseError.builtinOperandPhrase(String.from(builtinName), required: IntegerOperandRequirement, got: self.valueKindWord(handle), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		return handle
	end 'requireHandleArg'

	// `subpReadLine(h)` / `subpReadErrLine(h)` — **READ ONE STDOUT/STDERR LINE**: route to
	// `__gt_subp_read_line` / `__gt_subp_read_err_line`, which yield the green thread while the read is in flight and
	// return an OWNED String (the line INCLUDING its '\n', or "" on EOF). The result is enrolled as a pending owned
	// temporary (`trackOwnedTemp`) so ownership drops it exactly as an interpolation result — the same door.
	function emitSubpReadLine(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, calleeTok Token) returns ValueId throws SourceParseError
		let handle = try self.requireHandleArg(args, builtinName: builtinName, arity: SubpReadArity, calleeTok: calleeTok)
		let callArgs = ValueIdArray.create(2, zeroed: false)
		callArgs.push(handle)

		// ⭐ **THE PER-LINE CAP IS A PARAMETER OF THE ENTRY POINT**, and this builtin's one
		// argument is a HANDLE — so the cap is supplied here, as `SubpMaxLineBytes`.
		callArgs.push(self.emitLiteral(SubpMaxLineBytes as FullRangeInt, valueType: MaxonType.integer, range: SourceRange.ofToken(calleeTok)))
		return self.emitOwnedRuntimeResult(runtimeName, args: callArgs, resultTag: ValueTypeTag.string, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpReadLine'

	// `subpWriteLine(h, line: s)` — **WRITE A LINE TO STDIN**: route to `__gt_subp_write_line`, which
	// appends '\n' and does a synchronous WriteFile. Two arguments: an INTEGER handle and a BORROWED String line;
	// an INTEGER result (0 success, nonzero broken pipe).
	function emitSubpWriteLine(args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		// The arity and the HANDLE are `requireHandleArg`'s, exactly as its five siblings' are. Only the second argument is
		// this door's own, because only this door has one.
		let handle = try self.requireHandleArg(args, builtinName: SubpWriteLineBuiltinName, arity: SubpWriteArity, calleeTok: calleeTok)

		let line = try args.get(1) otherwise panic("emitSubpWriteLine: args.count() == SubpWriteArity just checked but get(1) failed")
		let lineTag = self.tagOf(line)

		if not tagIsText(lineTag) 'notAString'
			throw SourceParseError.builtinOperandType(String.from(SubpWriteLineBuiltinName), required: typeTagName(ValueTypeTag.string), got: self.valueKindWord(line), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		let callArgs = ValueIdArray.create(2, zeroed: false)
		callArgs.push(handle)
		callArgs.push(line)
		return self.emitLibraryAliasedRuntimeCall(SubpWriteLineName, args: callArgs, alias: FullRangeIntAliasName, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpWriteLine'

	// `subpCloseStdin(h)` (void) / `subpWait(h)` (integer exit code) / `subpRelease(h)` (void) — **THE HANDLE-OP
	// BUILTINS**: one INTEGER handle argument, routing to the named `__gt_subp_*` entry. A void
	// result used in value position is rejected exactly as a void user-call is.
	function emitSubpHandleOp(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, resultTag ValueTypeTag, resultUsed bool, calleeTok Token) returns ValueId throws SourceParseError
		let handle = try self.requireHandleArg(args, builtinName: builtinName, arity: SubpHandleArity, calleeTok: calleeTok)

		if resultTag == ValueTypeTag.void and resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(builtinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		let callArgs = ValueIdArray.create(1, zeroed: false)
		callArgs.push(handle)
		return self.emitIntrinsicAnswer(runtimeName, args: callArgs, resultTag: resultTag, resultAlias: FullRangeIntAliasName if resultTag == ValueTypeTag.integer else NoAnswerAlias, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpHandleOp'

	// ⭐⭐ **THE ARGUMENT RULE EVERY `__Builtins.subprocess*` INTRINSIC IS CHECKED AGAINST, IN ONE PLACE.**
	// A whole band of intrinsics, four result shapes and a handful of arities — but exactly ONE argument rule,
	// because every position in every contract is a `__ManagedMemory`, a `cstring` or a machine word, and
	// `intrinsicSlotClass` says which. Checking it at all is what an intrinsic needs BECAUSE no file declares
	// it: there is no signature for SemanticCheck's ordinary arity and argument-type checks to read. Checking
	// it HERE is what keeps a band of doors from growing one spelling each of the same two questions — the
	// shape `requireHandleArg` already took for the streaming builtins, one family wider.
	function requireIntrinsicArgs(args ValueIdArray, callee ByteArray, arity ParamCount, shape IntrinsicArgShape, calleeTok Token) returns ValueIdArray throws SourceParseError
		try requireBuiltinArity(args, builtinName: callee, arity: arity, calleeTok: calleeTok)

		let callArgs = ValueIdArray.create(arity, zeroed: false)

		for i in 0 upto arity 'each'
			let arg = try args.get(i) otherwise panic("requireIntrinsicArgs: args.count() == arity just checked but get(i) failed")

			match intrinsicSlotClass(shape, index: i, arity: arity) 'slot'
				buffer then try self.requireIntrinsicBufferArg(arg, callee: callee, calleeTok: calleeTok)
				string then try self.requireIntrinsicStringArg(arg, callee: callee, calleeTok: calleeTok)
				cstring then try self.requireIntrinsicCStringArg(arg, callee: callee, calleeTok: calleeTok)
				machineWord then try self.requireIntrinsicMachineWordArg(arg, callee: callee, calleeTok: calleeTok)
			end 'slot'

			callArgs.push(arg)
		end 'each'

		return callArgs
	end 'requireIntrinsicArgs'

	// One `__ManagedMemory` argument of a `__Builtins` intrinsic — an argv blob, an environment block, or the
	// buffer `managedIsNull` tests. Anchored on the CALLEE token for its machine-word sibling's reason.
	function requireIntrinsicBufferArg(arg ValueId, callee ByteArray, calleeTok Token) throws SourceParseError
		if not self.valueIsByteArray(arg) 'notAManagedBuffer'
			throw SourceParseError.builtinOperandType(String.from(callee), required: String.from(ManagedMemoryTypeName), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAManagedBuffer'
	end 'requireIntrinsicBufferArg'

	function requireIntrinsicStringArg(arg ValueId, callee ByteArray, calleeTok Token) throws SourceParseError
		if self.tagOf(arg) != ValueTypeTag.string 'notAString'
			throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.string), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'
	end 'requireIntrinsicStringArg'

	// One `cstring` argument — a NUL-terminated pointer the runtime will `strlen`. This is the check
	// the tag exists for: were `cstring` erased to `integer`, these slots and the machine-word ones
	// would be one slot and each would accept the other's argument — `subprocessResolveOnPath(42)`
	// handing the resolver an address made of an int, `subprocessGetPid(s.cstr())` handing a pid
	// lookup a pointer.
	//
	// ⚠ **THE TEST IS EXACT AND NOT `tagIsIntegral`'s WIDENING, WHICH IS THE WHOLE DIFFERENCE.** A ranged
	// alias IS an int and its machine-word siblings must admit one; nothing is a `cstring` but a `cstring`,
	// and the only two doors that PRODUCE one are `String.cstr()` and `__ManagedMemory.toCString()`.
	function requireIntrinsicCStringArg(arg ValueId, callee ByteArray, calleeTok Token) throws SourceParseError
		if self.tagOf(arg) != ValueTypeTag.cstring 'notACString'
			throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.cstring), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notACString'
	end 'requireIntrinsicCStringArg'

	// ⭐ **ONE MACHINE-WORD ARGUMENT OF A `__Builtins` INTRINSIC — A HANDLE, A BUDGET, A FLAG, A BUFFER
	// ADDRESS.** Not a `cstring`: that is its own class with its own door one function up.
	// Two askers that have nothing else in common: the subprocess family's per-slot walk above, and
	// `__Builtins.gtIsComplete`, whose single argument is a raw green-thread pointer. Written once because
	// the RULE is one rule — an intrinsic's word-shaped operand — and because its two halves are each a
	// measured trap: `tagIsIntegral` rather than `== ValueTypeTag.integer` (the ranged-alias false refusal
	// `parseBuiltinIntegerArg`'s header records, which has shipped twice in this file), and the CALLEE token
	// as the anchor rather than the argument (the position every `__Builtins` refusal in this table uses).
	//
	// ⚠ **IT IS NOT THE SPELLING `commandLineArg`/`readStdin` USE.** Those two render `got:` as
	// `typeTagName(self.tagOf(arg))` where this renders `valueDisplayTypeName`; the two agree on every
	// case any spec pins today. Unifying the `SourceParseError.builtinOperandType` voice moves every
	// `__Builtins.*` and `subp*` refusal at once, and four spec files pin the current wording.
	function requireIntrinsicMachineWordArg(arg ValueId, callee ByteArray, calleeTok Token) throws SourceParseError
		if not tagIsIntegral(self.numberTagOf(arg)) 'notAMachineWord'
			throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAMachineWord'
	end 'requireIntrinsicMachineWordArg'

	function requireRawBufferAddressArg(arg ValueId, callee ByteArray, calleeTok Token) throws SourceParseError
		if self.tagOf(arg) == ValueTypeTag.cstring 'aCString'
			return
		end 'aCString'

		try self.requireIntrinsicMachineWordArg(arg, callee: callee, calleeTok: calleeTok)
	end 'requireRawBufferAddressArg'

	// ⭐⭐ **`__Builtins.awaitAny(promises)` — DRIVE THE SCHEDULER UNTIL ANY OF THEM HAS COMPLETED, AND ANSWER
	// WHICH.** It emits no `MaxonOp.call` to a user function: it routes to `__gt_await_any`, the shared
	// cooperative drive loop run to a third end. The result is an INTEGER — an index into the argument array —
	// so unlike `sleep`'s void it is usable in value position and needs no `resultUsed` gate.
	//
	// ⚠ **NOTHING IS CONSUMED HERE AND NO DROP IS ENROLLED.** The array is BORROWED (the entry reads its
	// `buffer`/`length` off the record and never takes ownership, exactly as the command-line entries borrow
	// their String), and no promise is retired — the caller then `await`s one of them under the ordinary
	// rules, which is what keeps this primitive neutral on `await`'s slot-level linearity gap rather than
	// widening it.
	function emitAwaitAny(args ValueIdArray, calleeTok Token) returns ValueId throws SourceParseError
		try requireBuiltinArity(args, builtinName: BuiltinsAwaitAnyName, arity: AwaitAnyArity, calleeTok: calleeTok)

		let promises = try args.get(0) otherwise panic("emitAwaitAny: args.count() == AwaitAnyArity just checked but get(0) failed")

		if not self.valueIsPromiseArray(promises) 'notAPromiseArray'
			throw SourceParseError.builtinOperandPhrase(String.from(BuiltinsAwaitAnyName), required: PromiseArrayRequirement, got: self.valueDisplayTypeName(promises), line: calleeTok.line, column: calleeTok.column)
		end 'notAPromiseArray'

		return try self.emitAwaitAnyCall(promises, anchor: calleeTok)
	end 'emitAwaitAny'

	function emitAwaitAnyCall(promises ValueId, anchor Token) returns ValueId throws SourceParseError
		try self.requireNoWaitInsideWindow(anchor)

		// ⭐⭐ **THE CHECK BETWEEN THE TWO PLACES THE PROMISE SLOT'S WIDTH IS STATED, AND THE PREDICATE ABOVE
		// USED TO CLAIM IT WITHOUT MAKING IT.** `__gt_any_completed` strides the buffer by a CONSTANT
		// (`GtRuntime.PromiseSlotBytes`) — it must, because one compiled scan serves every array in every
		// program and the element type is gone by then — while the stride the record is really stamped with
		// comes from `ProgramSignatures.arrayElementSize`. Nothing makes those two agree. A divergence would
		// not be a diagnostic: the scan would read every slot past the first at the wrong address, answering
		// a WRONG INDEX or dereferencing a misaligned word as a green thread.
		//
		// ⚠ **IT COMPARES THE STAMP AGAINST `PromiseSlotBytes` ITSELF, NOT AGAINST `arrayElementIsMachineWord`.**
		// That predicate would tie the stamp to a THIRD constant (`ManagedArrayElementBytes`) and so would stay
		// silent for a change to the scan's own width — which is one of the two drifts this exists to catch.
		// Naming the scan's constant here is not the transcription `arrayElementIsMachineWord`'s header warns
		// about: the number is never written down again, only the one home of it is read.
		//
		// ⚠ **A PANIC AND NOT A DIAGNOSTIC.** No program can reach it today: a `Promise with …` handle IS the
		// green-thread pointer (`PromiseType.maxon`'s first fact), so its slot is one word and
		// `valueIsPromiseArray` has already established the element is one. It fires only if that fact and
		// this scan's constant come apart, which is a compiler defect and has no cure an author could apply.
		let stamped = self.signatures.arrayElementSize(self.valueInstanceId(promises))

		if stamped != PromiseSlotBytes 'strideDisagreesWithTheScan'
			panic("emitAwaitAnyCall: '__gt_any_completed' strides a promise array by {PromiseSlotBytes} bytes per slot, but `arrayElementSize` stamps this instance at {stamped} — `PromiseType.maxon`'s one-word promise handle and `GtRuntime.PromiseSlotBytes` have drifted apart")
		end 'strideDisagreesWithTheScan'

		let opIdx = self.artifact.module.ops.count()
		self.noteWaitSeed(self.bodyFunction(), site: WaitSite.selectAwait(opIdx))
		let current = self.bodyFunction()
		current.mayYieldSeed = true

		return self.emitLibraryAliasedRuntimeCall(GtAwaitAnyName, args: argsOf(promises), alias: ElementIndexAliasName, range: SourceRange.ofToken(anchor))
	end 'emitAwaitAnyCall'

	// ⭐⭐ **IS THIS VALUE AN ARRAY WHOSE ELEMENTS ARE PROMISE HANDLES?** — `awaitAny`'s whole argument rule,
	// and the thing that makes the runtime's scan sound. `__gt_any_completed` reads each slot as a
	// green-thread pointer and loads a status word THROUGH it, so an `Array with Integer` would have its
	// numbers dereferenced; and it strides the buffer by one machine word, which is what a `Promise with …`
	// slot is (`PromiseType.maxon`'s first fact) and what nothing else is guaranteed to be. Both properties
	// come from the ELEMENT TYPE, which is known here and gone by the time the call is lowered.
	//
	// ⚠ **THIS PREDICATE ESTABLISHES THE FIRST PROPERTY ONLY.** The STRIDE half is ASSERTED by the caller —
	// `emitAwaitAny` compares `arrayElementSize` of this same instance against the constant the scan really
	// strides by, and panics if they have come apart. Stated here in prose alone it is a claim nothing
	// checks.
	//
	// ⚠ **THE BASE TEST IS `isArrayBaseName` AND NOT A COMPARE AGAINST `b"Array"`.** A user program may
	// declare its own `type Array` — the corpus declaration is then renamed into the reserved space — and it
	// may declare a conformer of `BuiltinArrayLiteral` under any name at all; that predicate is the one home
	// of "which declarations ARE the array record", and a literal here would answer differently from it the
	// first time either happened.
	//
	// ⚠ **THE ELEMENT COMES THROUGH `resolvedSlotType(containerElementType(…))`, WHICH IS `push`'s OWN LINE
	// (`requireContainerElementType`) AND NOT AN APPROXIMATION OF IT.** Both halves are load-bearing and the
	// second was MEASURED: `containerElementType` alone hands back the argument as the instance recorded it,
	// which for `Array with IntPromise` is the ALIAS — a `named` leaf, tag `int` — so `typeIsPromiseStorage`
	// answered FALSE and every case in `specs/await-any.md` was refused as *"not a promise array"*.
	// `resolvedSlotType` is what crosses the index's interner and resolves the alias to the instance.
	function valueIsPromiseArray(value ValueId) returns bool
		if self.tagOf(value) != ValueTypeTag.genericInstance 'notAnInstance'
			return false
		end 'notAnInstance'

		let giid = self.valueNameId(value)

		if not self.signatures.isArrayInstance(giid as GenericInstanceId) 'notAnArray'
			return false
		end 'notAnArray'

		return typeIsPromiseStorage(self.signatures, t: self.resolvedSlotType(self.signatures.containerElementType(giid as GenericInstanceId)))
	end 'valueIsPromiseArray'

	// ⭐ **AN INTRINSIC WHOSE RESULT IS A MACHINE WORD, AN ENUM CASE, OR NOTHING AT ALL** — most of the band.
	// `resultNameId` defaults to `UnnamedTypeId`, which is what every scalar answer wants;
	// the two state queries pass the interned `__SubprocessStreamState` and so hand back a value a `match`
	// covers exhaustively.
	// The arguments are BORROWED (the runtime entry reads the argv blob's `buffer`/`length` through the
	// record and never takes ownership, exactly as `__print_string` borrows its String), so there is no owned
	// temporary to enrol and a literal argument needs no decref.
	//
	// A void result used in value position is rejected exactly as a void user-call is — the three void
	// members are `subprocessReleaseHandle`, `subprocessResultRelease` and `subprocessCloseStdin`.
	//
	// ⚠ **`resultIsMachineWord` DEFAULTS TO FALSE AND IS OPTED INTO PER MEMBER, BECAUSE IT IS A PROOF AND
	// NOT A DESCRIPTION.** Plenty of this band answers an integer that is a count, a verdict or a `-1`
	// failure; claiming the whole unsigned word for one of those deletes a guard that CAN fire. The bit
	// belongs only to a member whose answer is every 64-bit pattern and none of them an error value.
	function emitScalarIntrinsicCall(args ValueIdArray, callee ByteArray, runtimeName ByteArray, arity ParamCount, shape IntrinsicArgShape, resultTag ValueTypeTag, resultAlias ByteArray, resultUsed bool, calleeTok Token, resultNameId TypeNameId = UnnamedTypeId, resultIsMachineWord bool = false) returns ValueId throws SourceParseError
		let callArgs = try self.requireIntrinsicArgs(args, callee: callee, arity: arity, shape: shape, calleeTok: calleeTok)

		if resultTag == ValueTypeTag.void and resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(callee), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		let result = self.emitIntrinsicAnswer(runtimeName, args: callArgs, resultTag: resultTag, resultAlias: resultAlias, resultNameId: resultNameId, range: SourceRange.ofToken(calleeTok))

		if resultIsMachineWord 'aMachineWord'
			self.recordWholeMachineWordRange(result)
		end 'aMachineWord'

		return result
	end 'emitScalarIntrinsicCall'

	// ⭐ **A SUBPROCESS INTRINSIC WHOSE RESULT IS A FRESH OWNED `__ManagedMemory`** — the other six
	// (`subprocessResultStdout`/`Stderr`, the two `subprocessRead*Line` readers, `subprocessResolveOnPath`
	// and `subprocessLastErrorMessage`). `emitOwnedManagedMemoryResult` is what carries the three facts that
	// travel together — owned heap record, byte-PACKED instance, BUFFER SURFACE — so `String.init(managed)`
	// accepts it and its scope exit drops it, the same door `__Builtins.commandLineArg(i)` comes out of.
	function emitSubprocessManagedResult(args ValueIdArray, callee ByteArray, runtimeName ByteArray, arity ParamCount, shape IntrinsicArgShape, calleeTok Token) returns ValueId throws SourceParseError
		let callArgs = try self.requireIntrinsicArgs(args, callee: callee, arity: arity, shape: shape, calleeTok: calleeTok)
		return self.emitOwnedManagedMemoryResult(runtimeName, args: callArgs, range: SourceRange.ofToken(calleeTok))
	end 'emitSubprocessManagedResult'

	// Parse a comma-separated argument list into the parallel `args`/`argLabels`/
	// `argRanges` lists (all empty for `()`). The caller has consumed `(`; this leaves
	// the cursor on `)`. Each argument is an expression, optionally prefixed by a
	// `name:` label, at the positions `rule` allows (`ArgLabelRule`). Whether a `name:` label actually
	// matches a parameter is a check for whoever holds the callee's parameter names —
	// SemanticCheck for a direct call, `slottedWitnessArgs` for a witness dispatch.
	//
	// A first argument's label is judged against the callee's first-parameter default only after the
	// whole list is parsed: a generic callee's defaults are keyed by the instance its arguments pick.
	function parseCallArgs(func IrFunction, target CallArgTarget, anchor Token, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, rule ArgLabelRule, constructorInstance ConstructorInstance = ConstructorInstance.none) returns PlaceArgumentArray throws SourceParseError
		// ⭐ **WHATEVER IS ALREADY IN `args` IS THE PREPENDED RECEIVER** — one entry, or none for a free call.
		// Counted rather than passed: `parseCallNamed`'s receiver push is the only thing that can have filled the column
		// before this runs, so the count IS the fact, and a second parameter carrying it could disagree.
		let receiverArgs = args.count()
		let enclosingHandOffs = self.openByRefHandOffs.count()
		let firstLend = self.bodyState.operandOrder.lendCount()
		_ = self.bodyState.operandOrder.beginCall()
		var places = PlaceArgumentColumn.unwritten

		for i in 0 upto receiverArgs 'eachReceiver'
			let receiver = try args.get(i) otherwise panic("parseCallArgs: args.get OOB at {i} inside the receiver count")

			let heldReceiver = self.holdCallOperand(receiver, target: target, passing: OperandPassing.asValue, range: try argRanges.get(i) otherwise panic("parseCallArgs: argRanges.get OOB at {i} — the argument columns are parallel by construction"), position: self.callSuccession(OperandSuccession.receiverBeforeArguments, target: target, rule: rule, written: args.count()))

			if heldReceiver != receiver 'theCallPassesTheReference'
				try args.set(i, value: heldReceiver) otherwise panic("parseCallArgs: args.set OOB at {i} inside the receiver count")
			end 'theCallPassesTheReference'
		end 'eachReceiver'

		if not self.at(TokenKind.rightParen) 'hasArguments'
			let conventions = self.byRefConventionsOfTarget(target) if self.signatures.programTakesAParamByRef() else ByRefConventionArray.create(0)

			var argIndex = 0 as ParamCount

			while true 'argLoop'
				// The argument's leading token — the label token when labelled, else the
				// value's first token — anchors this argument's diagnostic span.
				let argFirstTok = self.current()
				let label = try self.consumeArgLabel(argIndex, rule: rule)

				if rule == ArgLabelRule.messageSend and label.equals(ServiceSendTimeoutLabel) 'theSendTimeout'
					self.statement.pendingSendTimeout = SendTimeoutArgument.given(try self.parseSendTimeoutValue(func, labelTok: argFirstTok))
					break
				end 'theSendTimeout'

				let valueTok = self.current()
				let valueStart = self.pos

				// ⭐⭐ **DOES THIS POSITION TAKE ITS ARGUMENT BY REFERENCE?** Asked BEFORE the value is
				// parsed, because the answer changes what the parse must produce — an address rather than a value —
				// and a read that has already materialized the contents cannot be un-emitted. The label and the
				// column are both in hand here, which is what makes the position answerable this early.
				let column = args.count() as ParamCount
				try requireCallArgumentFitsTheAbi(column, anchor: valueTok)
				let passing = argumentPassingAt(conventions, argIndex: column, label: label)
				let byRefPosition = passing == ArgumentPassing.byReference
				let readsAPlace = passing == ArgumentPassing.undecided

				// Requested before the value is parsed rather than tested afterwards: that is what lets the read
				// door hand back an address instead of emitting a load it could not un-emit.
				self.statement.cellArgumentToken = self.cellArgumentAnchorAt(valueStart) if byRefPosition or readsAPlace else CellArgumentToken.none
				self.statement.cellArgumentWantsAPlace = readsAPlace
				let requestedTheCell = self.statement.cellArgumentToken.isPending()

				// ⭐ **AND DOES THIS POSITION STATE AN `Array` INSTANCE?** — the by-reference question's twin one
				// slot over, asked here for the same reason: the answer changes what the parse must PRODUCE, and
				// an array literal built at the wrong element type is a record at the wrong stride rather than a
				// value a later coercion could fix. `argIndex` is the SOURCE position, which is the alignment
				// `SweptDeclaration.paramNames` carries — a prepended receiver fills no source parameter.
				self.stateLiteralTargetForArgument(target, sourceIndex: argIndex, label: label, valueStart: valueStart, args: args, receiverArgs: receiverArgs as ParamCount, constructorInstance: constructorInstance)
				let offersAClosure = self.stateClosureParamOfferForArgument(target, sourceIndex: argIndex, label: label, valueStart: valueStart, args: args, receiverArgs: receiverArgs as ParamCount, constructorInstance: constructorInstance)

				// ⚠ The blame name is CLEARED before the argument is parsed — by `parseValueExpression` itself,
				// which is the one door every value expression comes through and therefore the one place that
				// clear can be stated once. See `bareArgImmutableName` for what the clear is for.
				// `parseValueExpression` (the climber plus a trailing ternary — `f(a if c else b)`), not
				// `parseExpression`: an argument is parsed INSIDE an expression that has already seeded
				// `currentBlock`, and re-seeding it would discard a short-circuit an EARLIER argument performed.
				let holdsSend = self.bodyState.holdsSendForTryAwait
				self.bodyState.holdsSendForTryAwait = false
				let value = try self.parseValueExpression(func)
				self.bodyState.holdsSendForTryAwait = holdsSend

				// The read CLEARS the request when it takes it, so this is how the call site learns whether it was
				// handed a cell. Cleared unconditionally either way: a request the read declined (the name was not
				// cell-resident) must not outlive this argument.
				let handedTheCell = requestedTheCell and not self.statement.cellArgumentToken.isPending()
				let handed = self.takeArgumentRoot(requestedTheCell)

				let handedPlace = self.statement.takeHandedPlaceStorage()

				if offersAClosure 'anOfferMustNotOutliveItsArgument'
					self.statement.pendingClosureParamOffer = PendingClosureParamOffer.none
				end 'anOfferMustNotOutliveItsArgument'

				if readsAPlace 'bindsAfterTheCalleeIsResolved'
					self.lendOperandCell(valueStart, handed: handed, target: target, argIndex: argIndex, label: label)
					places = withPlaceArgument(places, place: PlaceArgument.create(column, value: value, storage: handedPlace, anchor: valueTok, source: PlaceSource.written(valueStart, position: argIndex)))
				end 'bindsAfterTheCalleeIsResolved'

				// An r-value at a by-reference position gets a scratch cell — a literal, an expression, a fresh
				// call result, or a binding the read door declined to hand storage for (a `let`, which
				// `checkCallArguments` refuses with E3207 a phase later; the spill keeps the IR
				// well-formed until that diagnostic is reported, exactly as every other recovery here does).
				let passed = value if readsAPlace else try self.byRefArgumentValue(func, value: value, byRefPosition: byRefPosition, handedTheCell: handedTheCell, handed: handed, target: target, argIndex: argIndex, label: label, valueStart: valueStart, callAnchor: anchor, anchor: valueTok)

				self.noteLiteralCastArgument(value, passed: passed, first: valueStart)
				self.claimLetCastArgument(target, column: column, label: label, value: value, first: valueStart)

				if byRefPosition or readsAPlace 'aPositionTheCalleeMayWrite'
					self.noteSpanMayWriteItsBinding(valueStart)
				end 'aPositionTheCalleeMayWrite'

				// A capturing closure handed to a direct callee needs no refusal here: a function value is one word
				// naming its closure record, so it travels as any argument does. (A capturing closure at a
				// NON-function parameter is a type error caught by SemanticCheck.)
				var heldPassed = passed
				let held = self.holdCallOperand(value, target: target, passing: OperandPassing.intoPlace if byRefPosition else OperandPassing.converted if passed != value else OperandPassing.asValue, range: SourceRange.ofToken(argFirstTok), position: self.callSuccession(OperandSuccession.beforeComma, target: target, rule: rule, written: args.count() + 1))

				if held != value 'theCallPassesTheReference'
					heldPassed = held
				end 'theCallPassesTheReference'

				pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, value: heldPassed, label: label, range: SourceRange.ofToken(argFirstTok), immutableName: self.expressionImmutableBlame(valueTok, valueStart: valueStart), anchorIndex: valueStart)

				argIndex = argIndex + 1

				if not self.at(TokenKind.comma) 'endArgs'
					break
				end 'endArgs'

				try self.consume(TokenKind.comma)
			end 'argLoop'
		end 'hasArguments'

		self.settleCallLends(firstLend)

		self.openByRefHandOffs.truncate(enclosingHandOffs)

		if rule == ArgLabelRule.messageSend 'aMessageSend'
			let message = try target.declaredName() otherwise panic("parseCallArgs: a message send names its message")

			try self.requireFirstArgLabelHasDefault(message, firstParam: self.serviceMessageFirstParam(message), argLabels: argLabels, argRanges: argRanges, receiverArgs: receiverArgs)
		end 'aMessageSend'

		return placeArgumentsOf(places)
	end 'parseCallArgs'

	function parseSendTimeoutValue(func IrFunction, labelTok Token) returns ValueId throws SourceParseError
		let valueTok = self.current()
		let holdsSend = self.bodyState.holdsSendForTryAwait
		self.bodyState.holdsSendForTryAwait = false
		let value = try self.parseValueExpression(func)
		self.bodyState.holdsSendForTryAwait = holdsSend
		try self.requireArgumentFitsDeclaredAlias(value, alias: self.millisecondsAlias(), paramName: labelTok.value, anchor: valueTok)

		if self.at(TokenKind.comma) 'notTheLastArgument'
			throw SourceParseError.registryRefused(ErrorCode.semanticServiceSendTimeoutReserved, explanation: serviceSendTimeoutNotLastRefusal(), line: labelTok.line, column: labelTok.column, note: DiagnosticNote.none)
		end 'notTheLastArgument'

		return value
	end 'parseSendTimeoutValue'

	function millisecondsAlias() returns RangedTypeAlias
		return try requireDeclaredAlias(self.signatures.libraryAliasDeclaration(MillisecondsAliasName)) otherwise panic("millisecondsAlias: no library file declares the ranged typealias `{String.from(MillisecondsAliasName)}`, which stdlib/Sleep.maxon declares")
	end 'millisecondsAlias'

	function bindPlaceArguments(places PlaceArgumentArray, declaration DeclarationFacts, args ValueIdArray, argLabels NameRoster, callAnchor Token, calleeName String) throws SourceParseError
		for place in places 'eachPlace'
			if not declaration.byRef.takesArgumentByRef(place.column, label: callArgumentLabel(argLabels, argIndex: place.column)) 'theValueStands'
				continue
			end 'theValueStands'

			try self.bindPlaceStorage(place, args: args, callAnchor: callAnchor, calleeName: calleeName)
		end 'eachPlace'
	end 'bindPlaceArguments'

	function bindPlaceStorage(place PlaceArgument, args ValueIdArray, callAnchor Token, calleeName String) throws SourceParseError
		match place.source 'source'
			written(valueStart, position) then try self.requireNonStorageIsNotWritten(self.bodyFunction(), valueStart: valueStart, parameter: WrittenParameter.positional(position), callAnchor: callAnchor)
			compilerMade then break
		end 'source'

		let storage = try self.placeStorageFor(place)
		self.moveLiteralCastArgument(place.value, to: storage)
		self.markArgumentStorage(storage)
		try args.set(place.column, value: storage) otherwise panic("bindPlaceStorage: a place argument's column {place.column} is outside the call's {args.count()} arguments")

		match place.storage 'storage'
			unreachable(blame) then throw SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: capturedCopyMutatingCallMessage(String.from(blame), parameter: WrittenParameter.positional(place.column), functionName: calleeName), line: callAnchor.line, column: callAnchor.column, note: DiagnosticNote.none)
			handed or
			notHanded then return
		end 'storage'
	end 'bindPlaceStorage'

	function recordDeferredArgumentBindings(places PendingArgumentBindingArray, callResult ValueId)
		for place in places 'eachPlace'
			self.bodyState.deferredArgumentBindings = withDeferredArgumentBinding(self.bodyState.deferredArgumentBindings, binding: DeferredArgumentBinding.create(callResult, column: place.column, cell: place.cell))
		end 'eachPlace'
	end 'recordDeferredArgumentBindings'

	function markArgumentStorage(storage ValueId)
		self.bodyState.argumentStorage = withValueMarked(self.bodyState.argumentStorage, value: storage)
	end 'markArgumentStorage'

	function placeStorageFor(place PlaceArgument) returns ValueId throws SourceParseError
		match place.storage 'storage'
			handed(storage) then return storage
			notHanded or
			unreachable then break
		end 'storage'

		return try self.materializeByRefScratchCell(place.value, cellType: self.typeOf(place.value), anchor: place.anchor)
	end 'placeStorageFor'

	function byRefConventionsOfTarget(target CallArgTarget) returns ByRefConventionArray
		match target 'target'
			witnessDispatch(declarations, _) then return conventionsOf(declarations)
			callee(name) then return self.byRefConventionsReachableFrom(name)
			coroutine(name) then return self.byRefConventionsReachableFrom(name)
			movedInto then return ByRefConventionArray.create(0)
		end 'target'
	end 'byRefConventionsOfTarget'

	function byRefConventionsReachableFrom(callee ByteArray) returns ByRefConventionArray
		let conventions = ByRefConventionArray.create(0)

		if not self.signatures.isGenericFunctionKey(callee) 'notAGenericName'
			conventions.push(self.signatures.byRefOf(callee))
			return conventions
		end 'notAGenericName'

		if let _ = try self.declarationNameableHere(callee) 'aNonGenericDeclarationToo'
			conventions.push(self.signatures.byRefOf(callee))
		end 'aNonGenericDeclarationToo'

		for template in self.genericTemplatesNameableFrom(callee, mint: CalleeMint.notMinted) 'eachTemplate'
			conventions.push(self.signatures.byRefOfDeclaration(template.siteKey()).clone())
		end 'eachTemplate'

		return conventions
	end 'byRefConventionsReachableFrom'

	function declarationFactsBoundBy(callee ByteArray) returns DeclarationFacts
		if let site = try self.requestedInstanceSiteKey(callee) 'aGenericInstance'
			return DeclarationFacts.create(self.signatures.byRefOfDeclaration(site), consume: self.signatures.consumeOf(callee))
		end 'aGenericInstance'

		return DeclarationFacts.create(self.signatures.byRefOf(callee), consume: self.signatures.consumeOf(callee))
	end 'declarationFactsBoundBy'

	function declarationNameableHere(callee ByteArray) returns SweptDeclaration throws MapError
		return try self.declarationNameableBy(callee, callerName: self.namingCallerName())
	end 'declarationNameableHere'

	// Takes the calling function, unlike `ProgramSignatures.visibleDeclarationOf`, because a conformance
	// grant is judged per caller (`declarationMayBeNamed`).
	function declarationNameableBy(callee ByteArray, callerName ByteArray) returns SweptDeclaration throws MapError
		let decl = try self.signatures.sweptDeclarationOf(callee)

		if not declarationMayBeNamed(self.signatures, visibility: decl.visibility, declFilePath: decl.declFilePath, registeredName: callee, readerFilePath: self.job.path, callerName: callerName) 'theCallerMayNotNameIt'
			throw MapError.keyNotFound
		end 'theCallerMayNotNameIt'

		return decl
	end 'declarationNameableBy'

	function declarationByRefConvention(sourceName ByteArray) returns ByRefConvention
		if not self.signatures.programTakesAParamByRef() 'nothingIsPassedByReference'
			return ByRefConvention.allByValue()
		end 'nothingIsPassedByReference'

		return self.signatures.byRefOf(sourceName)
	end 'declarationByRefConvention'

	// What this argument actually hands the callee: the value as parsed when the position takes it by value,
	// the binding's own cell when the read handed one over, and a fresh SCRATCH cell when the position is
	// by-reference and there was no cell to hand. Split out so the argument loop states the rule once and the
	// three outcomes are named rather than nested.
	function byRefArgumentValue(func IrFunction, value ValueId, byRefPosition bool, handedTheCell bool, handed ArgumentRoot, target CallArgTarget, argIndex ParamCount, label ByteArray, valueStart ElementIndex, callAnchor Token, anchor Token) returns ValueId throws SourceParseError
		if not byRefPosition 'takesTheValue'
			return value
		end 'takesTheValue'

		if let parameter = try self.writtenParameterAt(target, argIndex: argIndex, label: label) 'aWrittenParameter'
			try self.requireRootOfPlaceIsMutable(valueStart, parameter: parameter, callAnchor: callAnchor)
		end 'aWrittenParameter'

		if not handedTheCell 'noStorageWasHanded'
			try self.requireArgumentIsStorage(func, target: target, argIndex: argIndex, label: label, valueStart: valueStart, callAnchor: callAnchor)
		end 'noStorageWasHanded'

		self.lendOperandCell(valueStart, handed: handed, target: target, argIndex: argIndex, label: label)
		let storage = try self.byRefArgumentStorage(value, handedTheCell: handedTheCell, target: target, argIndex: argIndex, label: label, anchor: anchor)
		self.markArgumentStorage(storage)
		return storage
	end 'byRefArgumentValue'

	function lendOperandCell(valueStart ElementIndex, handed ArgumentRoot, target CallArgTarget, argIndex ParamCount, label ByteArray)
		let root = try handed.rootOfTheLend() otherwise return
		self.bodyState.operandOrder.lendCell(root, argumentStart: valueStart, write: self.lendWriteOf(target, argIndex: argIndex, label: label), heldUntilStatementEnd: target.writesAfterTheStatement())
	end 'lendOperandCell'

	function lendWriteOf(target CallArgTarget, argIndex ParamCount, label ByteArray) returns LendWrite
		let callee = target.lendedName()

		if self.signatures.isGenericFunctionKey(callee) 'aGenericTemplate'
			return self.templateLendWriteOf(callee, argIndex: argIndex, label: label)
		end 'aGenericTemplate'

		let declared = try self.declaredParamOfTarget(target, column: argIndex, label: label) otherwise return LendWrite.unknown(callee)
		return LendWrite.byParameter(callee, name: declared.name, position: declared.position)
	end 'lendWriteOf'

	function templateLendWriteOf(callee ByteArray, argIndex ParamCount, label ByteArray) returns LendWrite
		if let _ = try self.declarationNameableHere(callee) 'aNonGenericDeclarationToo'
			return LendWrite.unknown(callee)
		end 'aNonGenericDeclarationToo'

		let templates = self.genericTemplatesNameableFrom(callee, mint: CalleeMint.notMinted)

		if templates.count() != 1 'severalTemplatesMayBeCalled'
			return LendWrite.unknown(callee)
		end 'severalTemplatesMayBeCalled'

		let template = try templates.get(0) otherwise panic("templateLendWriteOf: templates.get OOB at 0 of {templates.count()}")
		let slot = try argSlotPosition(template.paramNames, argIndex: argIndex, label: label) otherwise return LendWrite.unknown(callee)
		let name = try template.paramNames.get(slot) otherwise panic("templateLendWriteOf: paramNames.get OOB at {slot} — argSlotPosition answered a position of this very roster")

		return LendWrite.byParameter(callee, name: name, position: slot + firstUserParamIndex(template.takesReceiver))
	end 'templateLendWriteOf'

	function takeArgumentRoot(requested bool) returns ArgumentRoot
		let handed = self.statement.argumentRoot
		self.statement.argumentRoot = ArgumentRoot.none

		if requested and not self.statement.cellArgumentToken.isPending() and handed.isNone() 'aDoorTookTheRequestWithoutNamingTheRoot'
			panic("takeArgumentRoot: a read door cleared a by-reference request and recorded no root — every door that answers a request names the root binding its reads note")
		end 'aDoorTookTheRequestWithoutNamingTheRoot'

		self.statement.cellArgumentToken = CellArgumentToken.none
		self.statement.cellArgumentWantsAPlace = false

		return handed
	end 'takeArgumentRoot'

	function noteOperandRead(binding VarInfo, at ElementIndex)
		if not self.signatures.programTakesAParamByRef() 'noCellCanOverlapIt'
			return
		end 'noCellCanOverlapIt'

		let root = self.operandRootOf(binding)

		if not bindingMayRootACell(root) 'noCellCanBeRootedInIt'
			return
		end 'noCellCanBeRootedInIt'

		self.bodyState.operandOrder.noteRead(root, at: at)
		self.recordOperandOverlaps()
	end 'noteOperandRead'

	function captureMentionEnd(name ByteArray, closureStart ElementIndex) returns ElementIndex
		for index in closureStart upto self.pos 'eachClosureToken'
			let tok = self.tokenAt(index)

			if tokenCanBeAName(tok) and self.baseBindingName(tok).equals(name) 'theFirstMention'
				return index + 1
			end 'theFirstMention'
		end 'eachClosureToken'

		if name.equals(SelfParamName) 'anImplicitReceiver'
			return closureStart + 1
		end 'anImplicitReceiver'

		panic("captureMentionEnd: no token of the closure mentions `{String.from(name)}`, and only the implicit receiver is captured without being spelled — the capture scan and the closure's tokens disagree about where the closure starts")
	end 'captureMentionEnd'

	function readReceiverValue(anchor Token) returns ValueId throws SourceParseError
		let receiver = try self.requireReceiverValue(anchor)
		self.noteOperandRead(self.receiverRootBinding(), at: self.pos)

		if self.job.recordsEditorFacts and self.bodyState.scope.contains(SelfParamName) 'theMethodItself'
			self.noteEditorBinding(self.bodyState.scope.getInfo(SelfParamName), line: anchor.line, column: anchor.column)
		end 'theMethodItself'

		return receiver
	end 'readReceiverValue'

	function operandRootOf(binding VarInfo) returns VarInfo
		return self.receiverRootBinding() if binding.isSelfField else binding
	end 'operandRootOf'

	function receiverRootBinding() returns VarInfo
		if self.bodyState.scope.contains(SelfParamName) 'theMethodItself'
			return self.bodyState.scope.getInfo(SelfParamName)
		end 'theMethodItself'

		match self.captureScopeOf(SelfParamName) 'capturedReceiver'
			found(enclosing, _) then return enclosing.getInfo(SelfParamName)
			notCaptured then panic("receiverRootBinding: a receiver is named where no method binds `self` and no enclosing method frame captures it — `requireReceiverInScope` refuses that before any read")
		end 'capturedReceiver'
	end 'receiverRootBinding'

	function restoreStashedOperands()
		self.bodyState.operandOrder.restoreStashed()
		self.recordOperandOverlaps()
	end 'restoreStashedOperands'

	function settleCallLends(firstLend ElementIndex)
		self.bodyState.operandOrder.settleLends(firstLend, at: self.pos)
		self.recordOperandOverlaps()
	end 'settleCallLends'

	function noteReceiverWrittenAfterArguments(operandStart ElementIndex, argumentsStart ElementIndex)
		self.bodyState.operandOrder.receiverWrittenAfterArguments(operandStart, argumentsStart: argumentsStart)
		self.recordOperandOverlaps()
	end 'noteReceiverWrittenAfterArguments'

	function recordOperandOverlaps()
		if self.bodyState.operandOrder.found.isEmpty() 'nothingOverlaps'
			return
		end 'nothingOverlaps'

		for candidate in self.bodyState.operandOrder.found 'eachCandidate'
			self.bodyState.pendingOverlaps = withPendingOverlap(self.bodyState.pendingOverlaps, overlap: self.pendingOverlapOf(candidate))
		end 'eachCandidate'

		self.bodyState.operandOrder.clearFound()
	end 'recordOperandOverlaps'

	function pendingOverlapOf(candidate OverlapCandidate) returns PendingOverlap
		let reported = self.bodyState.operandOrder.lendAt(candidate.reported)
		let tok = self.tokenAt(reported.argumentStart)

		return PendingOverlap.create(self.byReferenceOverlapMessage(reported, operandAt: candidate.operandAt, operand: candidate.operand), line: tok.line, column: tok.column, lend: candidate.write, companion: candidate.companion)
	end 'pendingOverlapOf'

	function byReferenceOverlapMessage(lend ByRefLend, operandAt ElementIndex, operand ConflictingOperand) returns String
		let pathText = self.spelledPathFrom(lend.argumentStart)
		var parameterClause = ""

		match lend.write 'write'
			unknown then break
			byParameter(_, name, _) then parameterClause = " (parameter '{String.from(name)}')"
		end 'write'

		return "argument '{pathText}' is read by another operand of this statement and passed by reference to '{String.from(unqualifiedMemberOf(lend.write.calleeName()))}'{parameterClause} — a hold cannot protect a value its by-reference cell overwrites. {overlapCureFor(operand, spelled: self.spelledOperandAt(lend.binding, at: operandAt))}"
	end 'byReferenceOverlapMessage'

	function spelledOperandAt(root VarInfo, at ElementIndex) returns String
		var index = at

		for _ in 0 upto OperandRootSearchWidth 'eachCandidate'
			let tok = self.tokenAt(index)

			if self.tokenNamesTheRoot(tok, root: root) or self.staticMemberSpellsTheRootAt(index, root: root) 'theRootsToken'
				return self.spelledPathFrom(index)
			end 'theRootsToken'

			if index == 0 'atTheFirstToken'
				break
			end 'atTheFirstToken'

			index = index - 1
		end 'eachCandidate'

		return displayParamName(root.name)
	end 'spelledOperandAt'

	function tokenNamesTheRoot(tok Token, root VarInfo) returns bool
		if not tokenCanBeAName(tok) 'notAName'
			return false
		end 'notAName'

		return self.baseBindingName(tok).equals(root.name) or (root.name.equals(SelfParamName) and self.bodyState.scope.isSelfField(tok.value))
	end 'tokenNamesTheRoot'

	function staticMemberSpellsTheRootAt(index ElementIndex, root VarInfo) returns bool
		if self.kindAt(index + 1) != TokenKind.dot or not self.namesMemberAt(index + TokensPerQualifierSegment) 'notATypeAndMember'
			return false
		end 'notATypeAndMember'

		let typeTok = try self.staticBaseTokenAt(index) otherwise return false

		return root.name.equals(qualifiedMethodName(typeTok.value, methodName: self.tokenAt(index + TokensPerQualifierSegment).value))
	end 'staticMemberSpellsTheRootAt'

	function spelledPathFrom(start ElementIndex) returns String
		var text = String.from(self.tokenAt(start).value)
		var index = start

		while self.kindAt(index + 1) == TokenKind.dot and self.namesMemberAt(index + TokensPerQualifierSegment) and self.kindAt(index + TokensPerQualifierSegment + 1) != TokenKind.leftParen 'eachFieldHop'
			index = index + TokensPerQualifierSegment
			text = "{text}.{String.from(self.tokenAt(index).value)}"
		end 'eachFieldHop'

		return text
	end 'spelledPathFrom'

	function requireArgumentIsStorage(func IrFunction, target CallArgTarget, argIndex ParamCount, label ByteArray, valueStart ElementIndex, callAnchor Token) throws SourceParseError
		let parameter = try self.writtenParameterAt(target, argIndex: argIndex, label: label) otherwise return
		try self.requireNotACapturedCopy(func, valueStart: valueStart, parameter: parameter, callAnchor: callAnchor)

		if let name = try self.bareBindingNamedBy(valueStart).localName() 'aNamedLocal'
			match parameter 'parameter'
				named then try self.requireNotAnUnmarkedParameter(func, name: name, parameter: parameter, callAnchor: callAnchor)
				positional then break
			end 'parameter'

			try self.requireLocalIsWritableByReference(name, parameter: parameter, callAnchor: callAnchor)
			return
		end 'aNamedLocal'

		try self.requireNonStorageIsNotWritten(func, valueStart: valueStart, parameter: parameter, callAnchor: callAnchor)
	end 'requireArgumentIsStorage'

	function writtenParameterAt(target CallArgTarget, argIndex ParamCount, label ByteArray) returns WrittenParameter throws AbsentError
		match target 'target'
			witnessDispatch then return WrittenParameter.positional(argIndex)
			callee or
			coroutine or
			movedInto then break
		end 'target'

		let parameter = try self.declaredParamOfTarget(target, column: argIndex, label: label)
		return WrittenParameter.named(parameter.name)
	end 'writtenParameterAt'

	// Refuses a literal or an expression handed to a `mutable` position, for the direct, witness,
	// function-value and settled-after-pick routes alike. A bare name or a field chain is not judged here:
	// later phases refuse a binding that cannot be written.
	function requireNonStorageIsNotWritten(func IrFunction, valueStart ElementIndex, parameter WrittenParameter, callAnchor Token) throws SourceParseError
		try self.requireRootOfPlaceIsMutable(valueStart, parameter: parameter, callAnchor: callAnchor)

		if self.cellArgumentAnchorAt(valueStart).isPending() 'aPlaceTheBindingRefusesLater'
			return
		end 'aPlaceTheBindingRefusesLater'

		let subject = "a literal" if self.argumentIsALiteralAt(valueStart) else "an expression"
		throw mutableArgumentNeedsAVarError(subject, parameter: parameter, functionName: self.signatures.functionDisplay(func, authoredPath: self.job.authoredPath).bare(), anchor: callAnchor)
	end 'requireNonStorageIsNotWritten'

	function requireRootOfPlaceIsMutable(valueStart ElementIndex, parameter WrittenParameter, callAnchor Token) throws SourceParseError
		if let name = try self.immutableRootOfPlaceAt(valueStart) 'aPlaceRootedAtAnImmutableName'
			throw SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: letPassedToMutableParameterMessage(String.from(name), parameter: parameter), line: callAnchor.line, column: callAnchor.column, note: DiagnosticNote.none)
		end 'aPlaceRootedAtAnImmutableName'
	end 'requireRootOfPlaceIsMutable'

	function immutableRootOfPlaceAt(valueStart ElementIndex) returns immutable ByteArray throws AbsentError
		let rootTok = self.tokenAt(valueStart)
		let spellsAChain = self.fieldChainEndAfter(valueStart, minHops: 1) == self.argumentSpanEnd(valueStart)

		if not tokenCanBeAName(rootTok) or not (spellsAChain or self.argumentIsExactlyANameAt(valueStart)) 'notAPlace'
			throw AbsentError.absent
		end 'notAPlace'

		if self.baseNamesModuleLevelAt(valueStart) 'aModuleLevelLet'
			return rootTok.value
		end 'aModuleLevelLet'

		if not spellsAChain 'aBareNameIsJudgedByItsBinding'
			throw AbsentError.absent
		end 'aBareNameIsJudgedByItsBinding'

		let root = try self.frameBindingBehind(valueStart)

		if not self.regionFactsForRead().cellRefusedRoots.contains(root.boundValue) 'aRootThatOwnsItsRecord'
			throw AbsentError.absent
		end 'aRootThatOwnsItsRecord'

		return rootTok.value
	end 'immutableRootOfPlaceAt'

	function frameBindingBehind(valueStart ElementIndex) returns VarInfo throws AbsentError
		let rootTok = self.tokenAt(valueStart)

		match self.valueBaseAt(valueStart) 'base'
			thisFrame then return self.thisFrameBindingOf(rootTok)
			captured(frame) then return self.capturedBindingOf(rootTok, frame: frame)
			unbound or
			alwaysAType then throw AbsentError.absent
		end 'base'
	end 'frameBindingBehind'

	function requireNotACapturedCopy(func IrFunction, valueStart ElementIndex, parameter WrittenParameter, callAnchor Token) throws SourceParseError
		if not self.argumentIsExactlyANameAt(valueStart) or not self.valueBaseAt(valueStart).isCaptured() 'notACapturedName'
			return
		end 'notACapturedName'

		throw SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: capturedCopyMutatingCallMessage(String.from(self.tokenAt(valueStart).value), parameter: parameter, functionName: self.signatures.functionDisplay(func, authoredPath: self.job.authoredPath).bare()), line: callAnchor.line, column: callAnchor.column, note: DiagnosticNote.none)
	end 'requireNotACapturedCopy'

	function requireLocalIsWritableByReference(name ByteArray, parameter WrittenParameter, callAnchor Token) throws SourceParseError
		let binding = self.bodyState.scope.getInfo(name)

		if binding.isMutable() or binding.isCellBinding or binding.isParameter or binding.isSelfField 'aWritableName'
			return
		end 'aWritableName'

		throw SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: letPassedToMutableParameterMessage(String.from(name), parameter: parameter), line: callAnchor.line, column: callAnchor.column, note: DiagnosticNote.none)
	end 'requireLocalIsWritableByReference'

	function requireNotAnUnmarkedParameter(func IrFunction, name ByteArray, parameter WrittenParameter, callAnchor Token) throws SourceParseError
		let binding = self.bodyState.scope.getInfo(name)

		if binding.isParameter and not binding.isCellBinding and self.parameterReassignKindOf(binding) == ParameterReassignKind.valueParameter 'anUnmarkedParameter'
			throw SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: unmarkedParameterPassedMessage(String.from(name), parameter: parameter, functionName: self.signatures.functionDisplay(func, authoredPath: self.job.authoredPath).bare()), line: callAnchor.line, column: callAnchor.column, note: DiagnosticNote.none)
		end 'anUnmarkedParameter'
	end 'requireNotAnUnmarkedParameter'

	function argumentIsALiteralAt(valueStart ElementIndex) returns bool
		let kind = self.kindAt(valueStart)
		let isLiteralKind = kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.charLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.true or kind == TokenKind.false
		return isLiteralKind and self.argumentEndsAt(valueStart + 1)
	end 'argumentIsALiteralAt'

	function placesOfArguments(args ValueIdArray, anchor Token) returns PlaceArgumentArray
		if not self.signatures.programTakesAParamByRef() 'nothingIsPassedByReference'
			return PlaceArgumentArray.create(0)
		end 'nothingIsPassedByReference'

		let places = PlaceArgumentArray.create(args.count(), zeroed: false)

		for column in 0 upto args.count() 'eachColumn'
			places.push(PlaceArgument.create(column as ParamCount, value: try args.get(column) otherwise panic("placesOfArguments: args.get OOB at {column} below count {args.count()}"), storage: noHandedPlaceStorage, anchor: anchor, source: PlaceSource.compilerMade))
		end 'eachColumn'

		return places
	end 'placesOfArguments'

	function byRefArgumentStorage(value ValueId, handedTheCell bool, target CallArgTarget, argIndex ParamCount, label ByteArray, anchor Token) returns ValueId throws SourceParseError
		if handedTheCell 'aVariableIsLent'
			try self.requireTheVariableHasTheParametersType(target, cell: value, argIndex: argIndex, label: label, range: SourceRange.ofToken(anchor))
		end 'aVariableIsLent'

		let param = try self.interfaceParamOfTarget(target, column: argIndex, label: label) otherwise return try self.ownStorageOrScratchCell(value, handedTheCell: handedTheCell, cellType: self.typeOf(value), anchor: anchor)

		if handedTheCell and not maxonTypesDenoteSame(self.typeOf(value), b: param.interfaceType) 'theCellHoldsAnotherType'
			throw SourceParseError.builtinArgumentType(String.from(param.name), expected: String.from(interfaceNameOfType(param.interfaceType, typeNames: self.artifact.typeNames)), got: self.valueDisplayTypeName(value), line: anchor.line, column: anchor.column, expectedNote: "", crossesRange: false)
		end 'theCellHoldsAnotherType'

		return try self.ownStorageOrScratchCell(value, handedTheCell: handedTheCell, cellType: param.interfaceType, anchor: anchor)
	end 'byRefArgumentStorage'

	function rangedIdentityOfType(declared MaxonType) returns immutable ByteArray
		if maxonTypeTag(declared) != ValueTypeTag.named or not self.declaresARangedAlias(self.declaredAliasOfType(declared), t: declared) 'namesNoRangedAlias'
			return EmptySourceText
		end 'namesNoRangedAlias'

		return aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: ValueTypeTag.named, nameId: typeNameIdOf(declared), readerFilePath: self.job.path)
	end 'rangedIdentityOfType'

	function requireTheVariableHasTheParametersType(target CallArgTarget, cell ValueId, argIndex ParamCount, label ByteArray, range SourceRange) throws SourceParseError
		let callee = try target.declaredName() otherwise return
		let declaration = try self.checkableDeclarationOf(callee) otherwise return
		let variableType = try self.handedCellTypeOf(cell) otherwise panic("requireTheVariableHasTheParametersType: a cell handed to a by-reference position has its variable's type recorded by `noteCellHandedByReference`")
		try self.requireTheVariableHasTheDeclarationsType(declaration, variableType: variableType, column: argIndex, label: label, range: range)
	end 'requireTheVariableHasTheParametersType'

	function checkableDeclarationOf(callee ByteArray) returns SweptDeclaration throws AbsentError
		if let declaration = try self.declarationNameableHere(callee) 'nameable'
			return declaration
		end 'nameable'

		if self.requestedInstanceSiteKeys.contains(callee) or self.signatures.isGenericFunctionKey(callee) or self.signatures.declaresCallee(callee) 'nothingToJudgeHere'
			throw AbsentError.absent
		end 'nothingToJudgeHere'

		panic("checkableDeclarationOf: '{String.from(callee)}' takes a cell by reference, so it has a declaration")
	end 'checkableDeclarationOf'

	function declaredParamOfTarget(target CallArgTarget, column ParamCount, label ByteArray) returns LandedParam throws AbsentError
		let callee = try target.declaredName()
		let declaration = try self.declarationNameableHere(callee) otherwise throw AbsentError.absent
		return declaredParamAtColumn(declaration, column: column, label: label)
	end 'declaredParamOfTarget'

	function interfaceParamOfTarget(target CallArgTarget, column ParamCount, label ByteArray) returns InterfaceParam throws AbsentError
		let param = try self.declaredParamOfTarget(target, column: column, label: label)
		let interfaceType = try self.signatures.sweptInterfaceTypeOf(param.declaredType, readerFilePath: param.declFilePath) otherwise throw AbsentError.absent
		return InterfaceParam.create(param.name, interfaceType: self.signatures.adoptType(interfaceType, into: self.artifact.typeNames))
	end 'interfaceParamOfTarget'

	function requireTheVariableHasTheDeclarationsType(declaration SweptDeclaration, variableType MaxonType, column ParamCount, label ByteArray, range SourceRange) throws SourceParseError
		let param = declaredParamAtColumn(declaration, column: column, label: label)
		try self.requireTheVariableFitsTheParameter(variableType, formal: self.byRefFormalOfParam(self.signatures.adoptType(param.declaredType, into: self.artifact.typeNames), scope: param.declFilePath), label: quotedParamLabel(String.from(param.name)), range: range)
	end 'requireTheVariableHasTheDeclarationsType'

	function requireTheVariableFitsTheParameter(variableType MaxonType, formal ByRefFormal, label String, range SourceRange) throws SourceParseError
		let variableAlias = self.rangedIdentityOfType(variableType)

		if variableAlias.isEmpty() 'theVariableHoldsNoRangedAlias'
			return
		end 'theVariableHoldsNoRangedAlias'

		match formal.verdictFor(variableAlias, signatures: self.signatures, readerFilePath: self.job.path) 'verdict'
			holds then return
			refused(words) then throw self.formalRefusalOf(label, words: words, variableAlias: variableAlias, range: range)
		end 'verdict'
	end 'requireTheVariableFitsTheParameter'

	function formalRefusalOf(label String, words FormalRefusalWords, variableAlias ByteArray, range SourceRange) returns SourceParseError
		let got = self.signatures.aliasIdentityDisplay(variableAlias)
		let mismatch = argTypeMismatchSentence(label, expected: words.expected, got: got, expectedNote: "", gotNote: "", crossesRange: false)
		return self.regionRefusal(ErrorCode.typeMismatch, message: "{mismatch}: the callee may write any '{words.expected}' through a by-reference parameter, which a '{got}' variable cannot hold. {words.cure}", line: range.line, column: range.column)
	end 'formalRefusalOf'

	function requireHandedCellsHaveTheInstancesTypes(writtenCallee ByteArray, callee ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray) throws SourceParseError
		if callee.equals(writtenCallee) 'notAGenericInstance'
			return
		end 'notAGenericInstance'

		let declaration = try self.checkableDeclarationOf(callee) otherwise return

		for position in 0 upto args.count() 'eachArgument'
			let variableType = try self.handedCellTypeOf(try args.get(position) otherwise panic("requireHandedCellsHaveTheInstancesTypes: args.get OOB at {position}")) otherwise continue
			let column = try columnOfCallPosition(declaration.takesReceiver, position: position as ParamCount) otherwise continue
			try self.requireTheVariableHasTheDeclarationsType(declaration, variableType: variableType, column: column, label: callArgumentLabel(argLabels, argIndex: position as ParamCount), range: try argRanges.get(position) otherwise panic("requireHandedCellsHaveTheInstancesTypes: argRanges.get OOB at {position} — a handed cell is a written argument, and every written argument has its range"))
		end 'eachArgument'
	end 'requireHandedCellsHaveTheInstancesTypes'

	function requireHandedCellsHaveTheRequirementsTypes(target WitnessDispatchTarget, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray) throws SourceParseError
		for column in 0 upto args.count() 'eachWrittenArgument'
			let variableType = try self.handedCellTypeOf(try args.get(column) otherwise panic("requireHandedCellsHaveTheRequirementsTypes: args.get OOB at {column}")) otherwise continue
			let position = try argSlotPosition(target.paramNames, argIndex: column as ParamCount, label: callArgumentLabel(argLabels, argIndex: column as ParamCount)) otherwise panic("requireHandedCellsHaveTheRequirementsTypes: an argument at column {column} handed to a by-reference position lands on a declared parameter")
			let formal = try target.paramTypes.get(position) otherwise panic("requireHandedCellsHaveTheRequirementsTypes: paramTypes.get OOB at {position} — a requirement's parameter columns are built in lockstep")
			let paramName = String.from(try target.paramNames.get(position) otherwise panic("requireHandedCellsHaveTheRequirementsTypes: paramNames.get OOB at {position}"))
			try self.requireTheVariableFitsTheParameter(variableType, formal: self.byRefFormalOfRequirement(formal, interfaceName: target.declaringInterfaceName), label: quotedParamLabel(paramName), range: try argRanges.get(column) otherwise panic("requireHandedCellsHaveTheRequirementsTypes: argRanges.get OOB at {column} — a handed cell is a written argument, and every written argument has its range"))
		end 'eachWrittenArgument'
	end 'requireHandedCellsHaveTheRequirementsTypes'

	function byRefFormalOfRequirement(formal RequirementType, interfaceName ByteArray) returns ByRefFormal
		if formal.isTypeParameter() 'anAssociatedType'
			return ByRefFormal.associated(self.signatures.requirementDisplay(formal))
		end 'anAssociatedType'

		return byRefFormalOfIdentity(self.signatures.requirementRangedIdentity(formal, interfaceName: interfaceName))
	end 'byRefFormalOfRequirement'

	function requireTheHandedCellHasTheFunctionTypesFormal(governing TypeNameId, column ParamCount, storage PlaceStorage, range SourceRange) throws SourceParseError
		let box = try self.handedStorageOf(storage) otherwise return
		let variableType = try self.handedCellTypeOf(box) otherwise return
		let shape = self.functionValueShape(governing)
		let param = try shape.paramTypes.get(column) otherwise panic("requireTheHandedCellHasTheFunctionTypesFormal: shape.paramTypes.get OOB at {column} — an indirect call's arity was checked against its function type")
		try self.requireTheVariableFitsTheParameter(variableType, formal: self.byRefFormalOfParam(param, scope: shape.scopeFilePath), label: argParamLabel(ArgumentParameter.unnamed, position: column), range: range)
	end 'requireTheHandedCellHasTheFunctionTypesFormal'

	function byRefFormalOfParam(param MaxonType, scope FilePath) returns ByRefFormal
		if maxonTypeTag(param) != ValueTypeTag.named 'namesNoAlias'
			return ByRefFormal.unranged
		end 'namesNoAlias'

		return byRefFormalOfIdentity(self.signatures.rangedIdentityOfSpelling(self.internedName(typeNameIdOf(param)), readerFilePath: scope))
	end 'byRefFormalOfParam'

	function ownStorageOrScratchCell(value ValueId, handedTheCell bool, cellType MaxonType, anchor Token) returns ValueId throws SourceParseError
		if handedTheCell 'theBindingsOwnCell'
			return value
		end 'theBindingsOwnCell'

		return try self.materializeByRefScratchCell(value, cellType: cellType, anchor: anchor)
	end 'ownStorageOrScratchCell'

	// ⭐⭐ **THE NAME AN E3207 WOULD BLAME FOR THE ARGUMENT JUST PARSED — and the ONE token that makes the
	// question answerable.** An argument names an immutable binding only if it IS that name and nothing
	// else: `f(a)` blames `a`, while `f(a + 1)`, `f(g(a))` and `f(a.count())` all hand over a value the
	// binding does not own and must blame nothing.
	//
	// The test is the SPAN the argument consumed, read after the parse (`bareNameOfSpan`), not a lookahead. A
	// predicate run BEFORE `parseValueExpression` would be a token-shape guess sitting in front of the
	// resolution it guards, whereas asking afterwards is a statement about what the resolution actually did.
	//
	// The ANSWER comes from the resolution itself (`Parser.lastBareBindingImmutableName`, written by
	// `parseVariableReference` and by nothing else), so the argument rule and the receiver rule reach the
	// same `immutableReceiverNameOf`. `parseCallArgs` clears it before every argument, so a bare
	// name that resolved through some OTHER primary path — one that publishes nothing — answers
	// "writable" rather than inheriting a neighbouring argument's name.
	//
	// ⚠ **A BARE NAME MAY BE SPELLED WITH A KEYWORD, so the span test asks `tokenCanBeAName`** —
	// as every other "is this a bare name?" reader does, and this one's asker is the resolution itself:
	// `parseVariableReference` publishes
	// `lastBareBindingImmutableName` for a keyword-named binding, and a test on `identifier` would throw that answer away.
	// The consequence is a MISSING E3207 — a mutation through an immutable binding accepted because of how
	// the binding is SPELLED — which is a wrong answer, not a compile error. Widening claims nothing extra:
	// the name still comes from the resolution, `parseCallArgs` clears it before every argument, and a
	// keyword that resolved through some other primary path publishes nothing and still answers "writable".
	function bareArgImmutableName(valueStart ElementIndex) returns immutable ByteArray
		try self.bareNameOfSpan(valueStart) otherwise return EmptySourceText

		return self.statement.lastBareBindingImmutableName
	end 'bareArgImmutableName'

	// E3077's argument door. `f(x)` may write `x`: whether it does is the callee's `writtenParamMask`,
	// settled a phase after E3077 is decided, or unknowable for an `ArgLabelRule.unknownMember`
	// callee. So a `var` handed to a call has exercised its mutability; see
	// `VarInfo.mutabilityExercised` for why the conservative answer is load-bearing. Asked before
	// anything moves the cursor off the argument: the span `bareNameOfSpan` reads ends at the cursor.
	function noteSpanMayWriteItsBinding(valueStart ElementIndex)
		if let name = try self.bareBindingNamedBy(valueStart).localName() 'bareNameArgument'
			self.markNameMutabilityExercised(name)
		end 'bareNameArgument'
	end 'noteSpanMayWriteItsBinding'

	// Is the span just parsed a bare name — a name, parenthesized or not, with no field step? The span test
	// the E3207 blame argues for (`bareArgImmutableName`), shared because E3077's argument door asks the
	// identical question of the identical span — "did this argument hand a BINDING over, or a value the
	// binding does not own" — and the two verdicts must not be free to disagree about what a bare name is.
	function bareNameOfSpan(valueStart ElementIndex) returns immutable ByteArray throws AbsentError
		let name = try self.rhsRootName(valueStart)

		if self.rhsSpanReadsAField(valueStart) 'aFieldNotTheBinding'
			throw AbsentError.absent
		end 'aFieldNotTheBinding'

		return name
	end 'bareNameOfSpan'

	function bareBindingNamedBy(valueStart ElementIndex) returns SourceBinding
		let name = try self.bareNameOfSpan(valueStart) otherwise return SourceBinding.none
		return self.localBindingNamed(name)
	end 'bareBindingNamedBy'

	// ⭐⭐ **THE E3207 BLAME OF AN EXPRESSION JUST PARSED — the bare-name test, OR the merge it came out of.**
	//
	// ⭐ **A LAUNDER IS NOT A LOOPHOLE.** `grow(g)` on a `let` is refused, so `grow(g if flag else g)` — the
	// SAME binding, reached through a merge that copies nothing — must be refused too. The bare-name test
	// alone cannot say so: an inline `if` is no bare name, so `bareArgImmutableName` answers
	// `unblamed` and the check skips the argument entirely. It is a MEMORY-SAFETY rule and not a message
	// one: accepted, the program writes into the literal's read-only `.rdata` record on x64 (an access
	// violation) and into a record shared by every use of that literal on wasm32-wasi.
	//
	// So the answer has two sources, asked in the order the language means them: the expression IS a bare
	// immutable name, or it is a MERGE that joined one (recorded per ARM at the three merge sites).
	// ⚠ **The merge half must be keyed on the phi and never on the arm's own value**: a per-value mark is unsound.
	//
	// It is the same three call sites' one question: a call ARGUMENT, a ternary ARM, and a `match … gives`
	// arm each ask "what would a write through this value be blamed on?", and an arm may itself be a nested
	// merge — which is exactly what the second source answers.
	function expressionImmutableBlame(valueTok Token, valueStart ElementIndex) returns immutable ByteArray
		let bare = self.bareArgImmutableName(valueStart)

		if not bare.isEmpty() 'aBareName'
			return bare
		end 'aBareName'

		if self.argWasFieldChain(valueTok, valueStart: valueStart) 'aChainOffAName'
			return self.chainBaseBindingBlame(valueStart)
		end 'aChainOffAName'

		return EmptySourceText
	end 'expressionImmutableBlame'

	function argWasFieldChain(valueTok Token, valueStart ElementIndex) returns bool
		return tokenCanBeAName(valueTok) and self.fieldChainEndAfter(valueStart, minHops: 1) == self.pos
	end 'argWasFieldChain'

	// Which positions may or must carry a `name:` label is `rule`'s regime (`ArgLabelRule`). A label
	// is two tokens; a bare value leaves the cursor untouched. Whether a label names a real parameter
	// is checked later — by SemanticCheck for a direct call, by `slottedWitnessArgs` for a witness
	// dispatch.
	//
	// A label may be spelled with a keyword because the parameter it names may be:
	// `combine(1, enum: 2)` against `function combine(type Integer, enum Integer, …)`. The trailing
	// `:` makes the reading unambiguous, since no argument value is a bare keyword followed by a
	// colon.
	function consumeArgLabel(argIndex ParamCount, rule ArgLabelRule) returns immutable ByteArray throws SourceParseError
		let labelTok = self.current()
		let isNamed = tokenCanBeAName(labelTok) and self.peekKind() == TokenKind.colon

		// The BUILTIN regime is decided WHOLE, before position is looked at, because position is not
		// what makes a label wrong here: a callee with no declaration has no parameters, so a label at
		// ANY index names one that does not exist and that nothing downstream will ever check. It
		// returns rather than falling through to the two rules below — neither of which could state
		// this, since both of their sentences speak of a callee whose parameters take labels. See
		// `argLabelRuleForCallee`.
		if rule == ArgLabelRule.allPositional 'builtinArgs'
			if isNamed 'labelled'
				throw SourceParseError.builtinArgNamed(labelTok.line, column: labelTok.column)
			end 'labelled'

			return EmptySourceText
		end 'builtinArgs'

		// Matched rather than compared, so a regime added later fails to compile here instead of silently
		// inheriting whichever answer a comparison let it fall through to.
		let firstArgMayBeNamed = match rule 'firstArgRegime'
			ordinary gives false
			firstMayBeNamed or
			firstNamedIfDefaulted or
			messageSend or
			unknownMember gives true
			allPositional panic("consumeArgLabel: `allPositional` returns above — a builtin's label verdict is decided whole, before argIndex is consulted, so it must never reach the first-argument rule")
		end 'firstArgRegime'

		let laterArgMayBeUnlabelled = match rule 'laterArgRegime'
			ordinary or
			messageSend or
			firstNamedIfDefaulted or
			firstMayBeNamed gives false
			unknownMember gives true
			allPositional panic("consumeArgLabel: `allPositional` returns above — a builtin's label verdict is decided whole, before argIndex is consulted, so it must never reach the later-argument rule")
		end 'laterArgRegime'

		if argIndex == 0 and isNamed and not firstArgMayBeNamed 'firstNamed'
			throw SourceParseError.firstArgNamed(labelTok.line, column: labelTok.column)
		end 'firstNamed'

		if argIndex > 0 and not isNamed and not laterArgMayBeUnlabelled 'missingLabel'
			throw SourceParseError.argMissingLabel(labelTok.line, column: labelTok.column)
		end 'missingLabel'

		if not isNamed 'positional'
			return EmptySourceText
		end 'positional'

		try self.consumeNameToken(NamePosition.declaration)
		try self.consume(TokenKind.colon)
		return labelTok.value
	end 'consumeArgLabel'

	// Append a `call` op defining a fresh result value; return the ValueId it defines. The
	// callee is a `ByteArray` — a slice of its identifier token for a free call, a freshly built
	// mangled name for a qualified one; the call span runs from `anchor` through the closing `)`
	// (the conventional call anchor).
	//
	// The result is minted BEFORE the op is appended, because the op stores its id — and it is
	// minted through `mintCallResult`, which can REFUSE (a void call in value position), so nothing
	// is emitted for a call the program is not allowed to make.
	//
	// `spelling` says whether those callee bytes are the AUTHOR'S or the COMPILER'S, which is the one
	// question the reserved-space door cannot answer from the name — see `CalleeMint`.
	function emitCall(writtenCallee ByteArray, anchor Token, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, rparenTok Token, resultUsed bool, constructorInstance ConstructorInstance, mint CalleeMint, inferInstanceOf FactoryInference = FactoryInference.none, serviceSite ServiceSpawnSite = sharedNotAServiceSpawn, places PlaceArgumentArray = PlaceArgumentArray.create(0)) returns ValueId throws SourceParseError
		let callee = try self.genericInstanceCallee(writtenCallee, anchor: anchor, args: args, argLabels: argLabels, mint: mint)

		return try self.emitResolvedCall(writtenCallee, callee: callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: rparenTok, resultUsed: resultUsed, constructorInstance: constructorInstance, mint: mint, inferInstanceOf: inferInstanceOf, serviceSite: serviceSite, places: places)
	end 'emitCall'

	function emitResolvedCall(writtenCallee immutable ByteArray, callee ByteArray, anchor Token, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, rparenTok Token, resultUsed bool, constructorInstance ConstructorInstance, mint CalleeMint, inferInstanceOf FactoryInference = FactoryInference.none, serviceSite ServiceSpawnSite = sharedNotAServiceSpawn, places PlaceArgumentArray = PlaceArgumentArray.create(0)) returns ValueId throws SourceParseError
		try self.requireCalleeIsNotReservedName(callee, anchor: anchor, mint: mint)
		let accessProof = try self.fixedArrayAccessProof(callee, args: args, argLabels: argLabels, anchor: anchor)

		// ⭐⭐ **A SLICE OF A LITERAL WITH COMPILE-TIME BOUNDS BECOMES A LITERAL, AND THEN THIS IS NOT A CALL AT
		// ALL** (`specs/constant-string-slice.md`). Asked FIRST, ahead of the mint, the default fill and
		// the consume, for the discipline the argument refusal above states: a call that is not going to be
		// emitted must not have minted a result or moved an argument on the way to finding that out.
		//
		// ⚠ **THE ADMISSION TEST IS SPELLED HERE, NOT INSIDE THE FOLD, BECAUSE `foldConstantStringSlice`
		// ANSWERS WITH A BOXED UNION AND THIS LINE RUNS FOR EVERY CALL IN EVERY COMPILE** — the whole stdlib
		// is parsed into every program, so a `notFolded` box built to say "this was never a slice" would be a
		// heap allocation on the hottest path the parser has. Three allocation-free compares (a length-first
		// byte compare, an arity and a flag) leave every other call having built nothing.
		if (callee.equals(StringSliceMethodName) or callee.equals(StringSliceLengthMethodName)) and args.count() == StringSliceArgCount and not self.bodyState.tryTargetMustStayACall 'aSliceCallWorthAsking'
			match self.foldConstantStringSlice(anchor, args: args, argLabels: argLabels, rparenTok: rparenTok) 'constantSlice'
				notFolded then break
				folded(literal) then return literal
			end 'constantSlice'
		end 'aSliceCallWorthAsking'

		// ⭐ **AN OMITTED ARGUMENT IS SUPPLIED HERE, BEFORE ANYTHING BUT THE PICK READS THE ARGUMENT LIST**.
		// Every direct, method and static call funnels through this one line, so the fill needs no
		// second copy at the method / static / operator-desugar doors — and by the time `applyCallerConsume`
		// and the emit below see `args`, a defaulted argument is indistinguishable from a written one, which
		// is what makes the consume transfer, the drop enrollment and `slotCallArgs`' arity gate correct for
		// it with no change to any of them.
		let defaultedArgs = try self.fillOmittedArgDefaults(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, receiverSlots: NoReceiverSlots)

		if not accessProof.isProven() and not places.isEmpty() 'someArgumentsReadAPlace'
			try self.bindPlaceArguments(places, declaration: self.declarationFactsBoundBy(callee), args: args, argLabels: argLabels, callAnchor: anchor, calleeName: self.signatures.declaredFunctionDisplay(callee).bare())
		end 'someArgumentsReadAPlace'

		try self.requireHandedCellsHaveTheInstancesTypes(writtenCallee, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges)
		self.widenArgsToInterfaceHandles(callee, args: args, argLabels: argLabels, anchor: anchor, rparenTok: rparenTok)
		try self.admitOperandAliasSetArgs(callee, args: args, argLabels: argLabels, anchor: anchor)
		let bound = self.boundReturnOf(callee)

		// ⭐ **A FACTORY CALL ON A BARE GENERIC BASE HAS ITS INSTANCE FIXED BY ITS ARGUMENTS**, and this is the
		// first line at which they are all in hand — the fill above included, so a DEFAULTED argument fixes a
		// type parameter exactly as a written one does. Every other caller gets back what it supplied.
		let constructed = try self.spawnFactoryConstructorInstance(constructorInstance, inferInstanceOf: inferInstanceOf, callee: callee, args: args, argLabels: argLabels, anchor: anchor, serviceSite: serviceSite)
		self.stampDefaultsSubject(callee, args: args, argLabels: argLabels, defaultedArgs: defaultedArgs, receiverSlots: NoReceiverSlots, constructorInstance: constructed)
		try self.requireBareGenericSubjectIsBound(callee, args: args, argLabels: argLabels, constructed: constructed, inferInstanceOf: inferInstanceOf, anchor: anchor)
		try self.requireACountSourceForAStaticCall(callee, constructed: constructed, anchor: anchor)
		let result = try self.mintCallResult(callee, anchor: anchor, resultUsed: resultUsed, bound: bound)
		try self.requireBareGenericResultIsTyped(result, callee: callee, constructed: constructed, inferInstanceOf: inferInstanceOf, anchor: anchor)
		let opaqueWordReading = try self.typeCallResultThroughInstance(result, callee: callee, args: args, argLabels: argLabels, bound: bound, constructed: constructed, anchor: anchor)
		self.noteLiteralColumnsCorpusCall(result, callee: callee, args: args)
		self.noteIdentityPrimitiveClone(result, callee: callee, args: args)
		self.settleFloatResult(result)

		// A `spawn`'s factory call is not adopted: its result is the service's state, held by the
		// cown.
		if let launch = try serviceSite.launch() 'aFactoryCall'
			try self.requireNoLinearArgumentIn(args, refusal: "a `spawn` takes no linear argument: a factory that cannot start the service drops the value it was given, and a linear value is consumed exactly once. Send the value to the service in a message once it is running", anchor: anchor)

			return try self.emitServiceSpawnOp(launch, spawnTok: try serviceSite.token() otherwise panic("emitResolvedCall: a site that answers a launch answers its token"), writtenCallee: writtenCallee, callee: callee, state: result, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: rparenTok, mint: mint, constructed: constructed, inferInstanceOf: inferInstanceOf)
		end 'aFactoryCall'

		// ⭐⭐ **THE DROP ENROLMENT COMES AFTER THE RETYPE, AND THAT ORDER IS THE WHOLE POINT.** Taken in the
		// mint's own tail, the tag is still the opaque `T` — and an opaque tag ALWAYS answers "owns nothing"
		// (`valueIsManagedHeap` tests byte-record and aggregate tags, and `typeParameter` is neither). The
		// retype is then forced to decline for a managed concrete argument rather than move a decision already
		// taken, and `bx.echo(got)` on a `Box with Alpha` is `E3005 … got 'type parameter'` for a value whose
		// type the instance fixes. Asked HERE the tag is the concrete one, so the two halves agree.
		// See `enrolOwnedCallTemp` for why re-ordering it can only ADD enrolments.
		//
		// ⭐⭐ **EVERY CALL RESULT IS ADOPTED, INCLUDING A SUBSTITUTED BARE-`T` ONE.** A caller that took its
		// OWN reference to a bare-`T` result instead would rest on the premise that a shared generic body
		// cannot classify one and so hands it back UNREFERENCED — a property of the DECLARED type, where the
		// obligation is a property of the RETURNED VALUE. The two come apart the moment a body returns
		// something it already owned: `return fresh()` through a `returns T` hands over a real `+1`, the caller
		// mints a second, and one record leaks per call (exit 101, no wrong answer). There is no convention
		// under which the caller can take that reference — a body that returns a value it created has nowhere
		// to put the one it holds — so the callee takes it for every shape instead, in `emitOwnedValueReturn`,
		// through the enclosing instance's descriptor for the one shape it cannot classify. A `returns T` is an
		// ordinary `+1` hand-off and is adopted here like every other.
		self.adoptCallResult(callee, result: result, args: args)

		// ⭐ **A CALLEE THAT DECLARED `returns __ManagedMemory` YIELDS THE BUFFER SURFACE.** Read HERE
		// rather than inside the mint chain because the mint's tail (`mintOwnedCallResult`) is handed a
		// `MaxonType` and not the callee name — and the name is the only thing that still knows the spelling,
		// the alias having erased it. Every direct, method and static call funnels through this one line.
		self.markDeclaredSurface(result, declared: self.signatures.declaredReturnSurface(callee))
		self.brandCallResult(result, callee: callee)

		// ⭐ **THE OTHER HALF OF THE CONSTANT-SLICE FOLD**: `startIndex()` / `endIndex()` on a receiver whose
		// bytes this parse minted answer a byte position the compiler already knows, so the answer is recorded
		// on the result. Here for the three lines above's reason — this is the one place a call's NAME, its
		// arguments and its result value are all in hand.
		self.recordConstStringIndexResult(result, callee: callee, args: args)

		// ⭐⭐ **AND THE OPPOSITE FACT ABOUT THE SAME HAND-OFF, HERE FOR THE TWO LINES ABOVE'S REASON.** The mark above
		// asks whether the callee may have handed back a record SOMETHING ELSE owns; this asks whether it provably
		// handed back one NOBODY else owns. Both are whole-program answers keyed by the callee's name, and this is
		// the one line that still holds it. The enrolment above has already marked the result `coOwned`, which is
		// the conservative claim this refines — see `markValueFromFreshReturn` for why the order is load-bearing.
		if self.signatures.returnsFreshValue(callee) 'handsBackARecordNobodyElseOwns'
			self.markValueFromFreshReturn(result)
		end 'handsBackARecordNobodyElseOwns'

		// The CALLER SIDE of consume-by-use: an owned argument at a position the callee
		// CONSUMES — a plain-field store, or a type-parameter field of a concrete instance whose argument owns
		// managed heap — is moved (poisoned / drained); a borrowed one is refused. Done BEFORE the op is
		// emitted so a refused call emits nothing.
		try self.applyCallerConsume(callee, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructed)

		// ⭐ An INFERRED instance is stamped on the result for the reason `retypeGenericAliasConstructorResult`
		// states about a spelled one: the value IS a `Box with String`, and the handle's own type, the state's
		// destructor and the loop's layout descriptor are all read off that identity. No brand goes with it —
		// a bare generic base has no spelling to carry (see that door).
		if inferInstanceOf.isOf() 'aSpawnFactory'
			match constructed 'inferred'
				none then break
				instance(gid) then self.stampInferredFactoryResult(result, gid: gid)
			end 'inferred'
		end 'aSpawnFactory'

		// ⭐ The provenance mark's second half: the arguments are settled, so the flag
		// `referenceOrMarkOpaqueFeed` armed now has a RESULT to travel on. Cleared whether or not it was set, so
		// one call's answer cannot stand in for the next's.
		if self.bodyState.callReferencedAnOpaqueFeedSlot 'thisCallReferencedASlot'
			self.markRecordHoldingReferencedOpaqueSlot(result)
			self.bodyState.callReferencedAnOpaqueFeedSlot = false
		end 'thisCallReferencedASlot'

		self.recordConstantArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor)
		self.recordOpaqueArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor, constructorInstance: constructed)
		let opIdx = self.artifact.module.ops.count()
		self.emitDirectCallOp(MaxonOp.call(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: settledImmutableArgNames(argImmutableNames), mint: mint), callee: callee, callResult: result, args: args, argLabels: argLabels, range: SourceRange.between(anchor, last: rparenTok))
		self.bodyState.emittedCall = EmittedCallOp.at(opIdx)
		self.fileWindowReceiverMove(opIdx)

		// ⭐ **AND WHERE THAT OP LANDED, WHEN IT IS ONE A LATER FOLD MAY DROP.** Only the two index accessors
		// over a known-bytes receiver answer true here — `recordConstStringIndexResult` above is the sole
		// writer of the domain it reads — and the gate is the PREDICATE rather than the union reader, because
		// this line runs for every call in every compile. See `FoldedIndexCallSite`.
		if self.valueIsKnownStringBytePos(result) 'aCallAConstantSliceCanDrop'
			self.recordFoldedIndexCallSite(result, opIndex: opIdx)
		end 'aCallAConstantSliceCanDrop'

		// The call door for every call the author spelled (free, method, static): a throwing one routes
		// to an enclosing block-form `try` or a test body's implied handler. `result` rides along because
		// an adopted managed one is already enrolled by `enrolOwnedCallTemp` above and must not be
		// dropped on the error edge (see `routeToTryBlock`); an opaque `T` result is enrolled on the same
		// terms.
		var produced = result

		match accessProof 'accessProof'
			notProven then self.routeBareThrowingCall(callee, opIdx: opIdx, result: result)
			proven(accessor) then produced = self.recordProvenAccess(opIdx, accessor: accessor, args: args, result: result, range: SourceRange.between(anchor, last: rparenTok))
		end 'accessProof'

		// ⭐⭐ **THE OPAQUE WORD IS READ BACK AS THE FLOAT THE RECEIVER'S INSTANCE SAYS IT IS** —
		// `typeResultThroughInstance`'s answer, spent HERE because the reinterpretation is an op and an op must
		// come after the `call` that defines its operand. Everything above deliberately keeps working on the
		// CALL's own value: the drop enrolment, the declared surface, the caller-consume and the throwing-call
		// routing are all facts about the callee's hand-off, and the bitcast is a fact about how this caller
		// reads it. Only the value handed BACK changes.
		//
		// ⚠ **THE `try` DOOR ALREADY KNOWS THIS SHAPE, WHICH IS WHY THIS IS SAFE FOR A THROWING CALLEE.**
		// `rewriteLastCallToTryCall` steps back over exactly one trailing reinterpretation whose operand is the
		// preceding op's result (`tryTargetCallOpIndex`) — built for `emitContainerElementAccessor`'s float
		// element, and true of BOTH readings below for the same reason: the reinterpretation is part of the
		// call's RESULT PRODUCTION, not a second expression the `try` was applied to. Both members are in
		// `unaryOpProducesACallResult`, which is that door's membership list.
		let callRange = SourceRange.between(anchor, last: rparenTok)

		let read = match opaqueWordReading 'reading'
			asItStands gives produced
			aFloatsBits(alias) gives self.floatReadFromTheOpaqueWord(produced, alias: alias, callee: callee, args: args, range: callRange)
			aNarrowSignedSlot(slotBytes) gives self.emitSignExtendFromSlot(produced, slotBytes: slotBytes, valueType: self.typeOf(produced), range: callRange)
		end 'reading'

		self.recordBrandHandOvers(args, kind: BrandRecordKind.handOver, first: 0, argLabels: argLabels, opIndex: opIdx, range: callRange)
		return read
	end 'emitResolvedCall'

	// A proven `get` lowers to `__managed_get_unchecked`, which loads the slot word without retaining it, while
	// the call's result is enrolled as an owned temp that releases on drop. A managed or opaque element therefore
	// takes its own reference here; an element of an immortal image record is not refcounted, so its enrolment
	// is dropped instead.
	function recordProvenAccess(opIdx ElementIndex, accessor SizedAccessor, args ValueIdArray, result ValueId, range SourceRange) returns ValueId
		self.artifact.recordProvenFixedArrayAccess(opIdx, accessor: accessor)

		match accessor.accessor 'which'
			get then break
			set then return result
		end 'which'

		let container = try args.get(0) otherwise panic("recordProvenAccess: a proven fixed-array access takes its receiver first")

		if self.tagOf(result) == ValueTypeTag.typeParameter 'anOpaqueElement'
			self.releaseOwnedTemp(result)
			let retained = self.coOwnBorrowedOpaque(result, range: range)
			self.trackOwnedTemp(retained, exclusivity: OwnedHeapExclusivity.coOwned)
			return retained
		end 'anOpaqueElement'

		if not self.valueIsManagedHeap(result) 'aTrivialElement'
			return result
		end 'aTrivialElement'

		if self.valueIsAnImmortalImageRecord(container) 'anImmortalElement'
			self.releaseOwnedTemp(result)
			return result
		end 'anImmortalElement'

		self.emitIncref(result, range: range)
		return result
	end 'recordProvenAccess'

	function floatReadFromTheOpaqueWord(word ValueId, alias TypeNameId, callee ByteArray, args ValueIdArray, range SourceRange) returns ValueId
		let reinterpreted = self.emitUnaryOp(word, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: range)

		if alias != UnnamedTypeId 'anAliasedElement'
			self.wearFloatAlias(reinterpreted, aliasId: alias)
		end 'anAliasedElement'

		self.noteLiteralColumnsCorpusCall(reinterpreted, callee: callee, args: args)
		self.settleFloatResult(reinterpreted)
		return reinterpreted
	end 'floatReadFromTheOpaqueWord'

	function adoptCallResult(callee ByteArray, result ValueId, args ValueIdArray)
		if self.callHandsBackTheReceiversField(callee, result: result, args: args) 'aFieldOfTheReceiver'
			self.markOverwritableSlotRead(result)
			self.carryStorageReadMarks(try args.get(0) otherwise panic("Parser.adoptCallResult: args.get OOB at 0 — a field-returning method takes exactly its receiver"), read: result)
			return
		end 'aFieldOfTheReceiver'

		self.enrolOwnedCallTemp(result)
	end 'adoptCallResult'

	function callHandsBackTheReceiversField(callee ByteArray, result ValueId, args ValueIdArray) returns bool
		return args.count() == 1 and self.valueIsAManagedStructRecord(result) and self.signatures.returnsAReceiverField(callee)
	end 'callHandsBackTheReceiversField'

	function genericInstanceCallee(callee immutable ByteArray, anchor Token, args ValueIdArray, argLabels NameRoster, mint CalleeMint) returns immutable ByteArray throws SourceParseError
		if not self.signatures.isGenericFunctionKey(callee) 'notAGenericName'
			return callee
		end 'notAGenericName'

		let chosen = try self.inferredGenericInstances(callee, anchor: anchor, args: args, argLabels: argLabels, mint: mint)

		let instance = try chosen.get(0) otherwise return callee
		self.requestGenericInstance(instance)
		return instance.instanceName
	end 'genericInstanceCallee'

	function inferredGenericInstances(callee ByteArray, anchor Token, args ValueIdArray, argLabels NameRoster, mint CalleeMint) returns GenericFunctionInstanceArray throws SourceParseError
		let templates = self.genericTemplatesNameableHere(callee, mint: mint)
		let refuse = templates.count() == 1 and not self.signatures.declaresCallee(callee)
		let inferred = GenericFunctionInstanceArray.create(0)

		for template in templates 'eachTemplate'
			match try self.inferGenericInstance(template, args: args, argLabels: argLabels, anchor: anchor, refuse: refuse) 'inference'
				inferred(instance) then inferred.push(instance)
				notApplicable then continue
			end 'inference'
		end 'eachTemplate'

		return inferred
	end 'inferredGenericInstances'

	// With none visible every template is kept, so the call still binds an instance and E3008 refuses
	// it rather than E3004.
	function genericTemplatesNameableHere(callee ByteArray, mint CalleeMint) returns GenericFunctionTemplateArray
		let nameable = self.genericTemplatesNameableFrom(callee, mint: mint)
		return self.signatures.genericTemplatesOf(callee) if nameable.isEmpty() else nameable
	end 'genericTemplatesNameableHere'

	function genericTemplatesNameableFrom(callee ByteArray, mint CalleeMint) returns GenericFunctionTemplateArray
		let nameable = GenericFunctionTemplateArray.create(0)
		let callerName = self.namingCallerName()
		let exempt = callNamesNothingTheReaderWrote(mint, readerFilePath: self.job.path)

		for template in self.signatures.genericTemplatesOf(callee) 'eachTemplate'
			if exempt or declarationMayBeNamed(self.signatures, visibility: template.visibility, declFilePath: template.declFilePath, registeredName: callee, readerFilePath: self.job.path, callerName: callerName) 'theCallerMayNameIt'
				nameable.push(template)
			end 'theCallerMayNameIt'
		end 'eachTemplate'

		return nameable
	end 'genericTemplatesNameableFrom'

	function inferGenericInstance(template GenericFunctionTemplate, args ValueIdArray, argLabels NameRoster, anchor Token, refuse bool) returns GenericInference throws SourceParseError
		let functionName = (bareMethodName(template.key))
		let arguments = GenericFunctionArgumentArray.create(template.typeParamNames.count(), zeroed: false)

		for position in 0 upto template.typeParamNames.count() 'eachTypeParam'
			let paramName = String.from(try template.typeParamNames.get(position) otherwise panic("inferGenericInstance: typeParamNames.get OOB at {position}"))
			let values = ValueIdArray.create(0)

			for argIndex in firstUserParamIndex(template.takesReceiver) upto args.count() 'eachArgument'
				let label = try argLabels.get(argIndex) otherwise panic("inferGenericInstance: argLabels holds {argLabels.count()} entries for {args.count()} arguments — the two columns are parallel")
				let column = try columnOfCallPosition(template.takesReceiver, position: argIndex as ParamCount) otherwise panic("inferGenericInstance: argument {argIndex} is the receiver, which the loop starts past")
				let paramIndex = try argSlotPosition(template.paramNames, argIndex: column, label: label) otherwise continue

				let slot = try template.paramSlots.get(paramIndex) otherwise continue
				let bound = try template.paramTypeParams.get(paramIndex) otherwise panic("inferGenericInstance: paramTypeParams is parallel to paramSlots")

				if slot == GenericParamSlot.typeParameter and bound == position 'thisTypeParameter'
					values.push(try args.get(argIndex) otherwise panic("inferGenericInstance: args.get OOB at {argIndex}"))
				end 'thisTypeParameter'
			end 'eachArgument'

			match try self.unifyGenericArguments(values, functionName: functionName, paramName: paramName, anchor: anchor, refuse: refuse) 'unified'
				agreed(argument) then arguments.push(argument)
				disagreed then return GenericInference.notApplicable
			end 'unified'
		end 'eachTypeParam'

		for constraint in template.constraints 'eachConstraint'
			let argument = try arguments.get(constraint.typeParamIndex) otherwise panic("inferGenericInstance: a constraint names type parameter {constraint.typeParamIndex} of {arguments.count()}")

			if not self.genericArgumentConforms(argument, interfaceName: constraint.interfaceName) 'violates'
				if not refuse 'anotherDeclarationMayServe'
					return GenericInference.notApplicable
				end 'anotherDeclarationMayServe'

				let paramName = try template.typeParamNames.get(constraint.typeParamIndex) otherwise panic("inferGenericInstance: typeParamNames.get OOB at {constraint.typeParamIndex}")
				throw SourceParseError.genericConstraintNotSatisfied(genericArgumentDisplay(argument, signatures: self.signatures), interfaceName: String.from(constraint.interfaceName), paramName: String.from(paramName), functionName: functionName, line: anchor.line, column: anchor.column)
			end 'violates'
		end 'eachConstraint'

		let owned = GenericFunctionArgumentArray.create(arguments.count(), zeroed: false)

		for argument in arguments 'eachArgument'
			owned.push(GenericFunctionArgument.create(argument.kind, name: argument.name))
		end 'eachArgument'

		let instanceName = self.signatures.genericInstanceNameOf(template, arguments: owned)
		return GenericInference.inferred(GenericFunctionInstance.create(template.key, siteKey: template.siteKey(), arguments: owned, instanceName: instanceName))
	end 'inferGenericInstance'

	function unifyGenericArguments(values ValueIdArray, functionName String, paramName String, anchor Token, refuse bool) returns GenericUnification throws SourceParseError
		let agreed = GenericFunctionArgumentArray.create(values.count(), zeroed: false)
		let aliases = NameRoster.create(0)

		for value in values 'eachValue'
			if tagIsUnresolved(self.tagOf(value)) 'notYetTyped'
				return GenericUnification.disagreed
			end 'notYetTyped'

			let argument = try self.genericArgumentOf(value, functionName: functionName, paramName: paramName, anchor: anchor)

			if argument.kind == GenericArgumentKind.rangedAlias and not aliases.contains(argument.name) 'aNewAlias'
				aliases.push(argument.name)
			end 'aNewAlias'

			agreed.push(argument)
		end 'eachValue'

		var result = try agreed.get(0) otherwise return GenericUnification.disagreed

		for argument in agreed 'eachArgument'
			if argument.sameAs(result) or (argument.kind == GenericArgumentKind.rangedAlias and result.kind == GenericArgumentKind.rangedAlias) 'agreesOrIsJoinedBelow'
				continue
			end 'agreesOrIsJoinedBelow'

			if self.genericNumericClassOf(result) != self.genericNumericClassOf(argument) or (argument.kind != GenericArgumentKind.rangedAlias and result.kind != GenericArgumentKind.rangedAlias) 'noAliasAdoptsTheOther'
				return try self.refuseGenericArguments(result, second: argument, functionName: functionName, paramName: paramName, anchor: anchor, refuse: refuse)
			end 'noAliasAdoptsTheOther'

			if argument.kind == GenericArgumentKind.rangedAlias 'thePlainNumberAdoptsThisAlias'
				result = argument
			end 'thePlainNumberAdoptsThisAlias'
		end 'eachArgument'

		if aliases.count() < 2 'oneAliasAtMost'
			return GenericUnification.agreed(result)
		end 'oneAliasAtMost'

		let ancestor = self.signatures.nearestCommonAliasAncestor(aliases, readerFilePath: self.job.path)

		if ancestor.isEmpty() 'noCommonAncestor'
			let firstAlias = GenericFunctionArgument.create(GenericArgumentKind.rangedAlias, name: try aliases.get(0) otherwise panic("unifyGenericArguments: two aliases were counted"))
			let secondAlias = GenericFunctionArgument.create(GenericArgumentKind.rangedAlias, name: try aliases.get(1) otherwise panic("unifyGenericArguments: two aliases were counted"))
			return try self.refuseGenericArguments(firstAlias, second: secondAlias, functionName: functionName, paramName: paramName, anchor: anchor, refuse: refuse)
		end 'noCommonAncestor'

		return GenericUnification.agreed(GenericFunctionArgument.create(GenericArgumentKind.rangedAlias, name: self.signatures.rangeScopedDeclaredName(ancestor, readerFilePath: self.job.path)))
	end 'unifyGenericArguments'

	function refuseGenericArguments(first GenericFunctionArgument, second GenericFunctionArgument, functionName String, paramName String, anchor Token, refuse bool) returns GenericUnification throws SourceParseError
		if not refuse 'anotherDeclarationMayServe'
			return GenericUnification.disagreed
		end 'anotherDeclarationMayServe'

		let firstShown = genericArgumentDisplay(first, signatures: self.signatures)
		let secondShown = genericArgumentDisplay(second, signatures: self.signatures)
		throw SourceParseError.genericArgumentsHaveNoCommonType(functionName, paramName: paramName, first: firstShown, firstNote: self.noteOfAlikeArgument(first, shown: firstShown, otherShown: secondShown), second: secondShown, secondNote: self.noteOfAlikeArgument(second, shown: secondShown, otherShown: firstShown), line: anchor.line, column: anchor.column)
	end 'refuseGenericArguments'

	function noteOfAlikeArgument(argument GenericFunctionArgument, shown String, otherShown String) returns String
		match argument.kind 'kind'
			rangedAlias then return self.signatures.declaredInNote(argument.name, shown: shown, otherShown: otherShown)
			integer or
			float or
			boolean or
			string or
			character or
			record or
			enumeration then return ""
		end 'kind'
	end 'noteOfAlikeArgument'

	function genericArgumentOf(value ValueId, functionName String, paramName String, anchor Token) returns GenericFunctionArgument throws SourceParseError
		let tag = self.tagOf(value)

		if self.valueIsLinear(value) 'aLinearTypeArgument'
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: linearTypeArgumentMessage(self.valueKindWord(value), holder: functionName), line: anchor.line, column: anchor.column)
		end 'aLinearTypeArgument'

		match tag 'tag'
			integer or
			float or
			named then return self.numericGenericArgumentOf(value, tag: tag)
			boolean then return GenericFunctionArgument.create(GenericArgumentKind.boolean, name: EmptySourceText)
			string then return GenericFunctionArgument.create(GenericArgumentKind.string, name: EmptySourceText)
			character then return GenericFunctionArgument.create(GenericArgumentKind.character, name: EmptySourceText)
			structRef then return GenericFunctionArgument.create(GenericArgumentKind.record, name: self.internedName(self.valueNameId(value)))
			exitCode or
			unresolved or
			void or
			function or
			typeParameter or
			genericInstance or
			interfaceRef or
			cstring then throw SourceParseError.genericArgumentKindUnsupported(functionName, paramName: paramName, typeName: self.valueKindWord(value), line: anchor.line, column: anchor.column)
		end 'tag'
	end 'genericArgumentOf'

	function numericGenericArgumentOf(value ValueId, tag ValueTypeTag) returns GenericFunctionArgument
		let plain = GenericFunctionArgument.create(GenericArgumentKind.float if tag == ValueTypeTag.float else GenericArgumentKind.integer, name: EmptySourceText)
		let nameId = self.valueNameId(value)

		if nameId == UnnamedTypeId 'unnamed'
			return plain
		end 'unnamed'

		let name = self.internedName(nameId)

		match self.signatures.enumInAnyFile(name) 'enumeration'
			declared then return GenericFunctionArgument.create(GenericArgumentKind.enumeration, name: name)
			undeclared then break
		end 'enumeration'

		let identity = self.signatures.rangedIdentityOfSpelling(name, readerFilePath: self.job.path)

		if identity.isEmpty() 'notARangedAlias'
			return plain
		end 'notARangedAlias'

		return GenericFunctionArgument.create(GenericArgumentKind.rangedAlias, name: self.signatures.rangeScopedDeclaredName(identity, readerFilePath: self.job.path))
	end 'numericGenericArgumentOf'

	function genericNumericClassOf(argument GenericFunctionArgument) returns GenericArgumentKind
		return match argument.kind 'kind'
			rangedAlias gives GenericArgumentKind.float if self.signatures.isFloatAliasFor(argument.name, readerFilePath: self.job.path) else GenericArgumentKind.integer
			integer or
			float or
			boolean or
			string or
			character or
			record or
			enumeration gives argument.kind
		end 'kind'
	end 'genericNumericClassOf'

	function genericArgumentConforms(argument GenericFunctionArgument, interfaceName ByteArray) returns bool
		let conformer = self.genericConformerNameOf(argument)
		return typeConformsTo(self.signatures.sweptConformanceIndex(), interfaces: self.signatures.interfaceMap(), typeName: conformer, interfaceName: interfaceName, discovered: self.signatures.discoveredConformerOf(conformer))
	end 'genericArgumentConforms'

	function genericConformerNameOf(argument GenericFunctionArgument) returns immutable ByteArray
		return match self.genericNumericClassOf(argument) 'class'
			integer gives IntConformerName
			float gives FloatConformerName
			boolean gives BoolConformerName
			string gives StringConformerName
			character gives CharacterConformerName
			record or
			enumeration gives argument.name
			rangedAlias panic("genericConformerNameOf: `genericNumericClassOf` answers a numeric class for every ranged alias")
		end 'class'
	end 'genericConformerNameOf'

	// ⭐⭐ **A SLICE OF A LITERAL WHOSE BOUNDS THE COMPILER KNOWS IS A LITERAL** —
	// `specs/constant-string-slice.md`, decided here and nowhere else.
	//
	// `s.slice(…)` reaches `stdlib/String.maxon`'s `sliceBytes`, which calls `__managed_slice`, whose
	// `ManagedMemoryRuntime.emitRecordView` mints a HEAP record per evaluation over the literal's immortal
	// blob. Copy-free and count-free, but an allocation all the same, and one paid on every trip of a loop.
	// When the receiver's bytes and both bounds are compile-time facts the compiler can cut the window
	// itself, and what it emits is an ORDINARY STRING LITERAL — the same `emitStringLiteral` a source `"…"`
	// goes through.
	//
	// ⭐⭐ **THAT SAMENESS IS THE WHOLE DESIGN, AND IT IS WHY THE FOLD IS HERE AND NOT AT THE MAXON TIER.**
	// An immortal `.rdata` record may not be written in place: the copy-on-write detach republishes
	// `buffer@0`/`capacity@16`/`length@8` INTO the record, which faults on x64 and arm64 and — worse —
	// silently succeeds on `wasm32-wasi`, whose linear memory has no read-only segment, corrupting every
	// other use of those deduped bytes. What keeps a literal safe is `promoteBorrowedToOwned` COPYING it at a
	// `var`'s declaration, and that promotion is decided from the value being BORROWED, a fact the parser
	// records as it binds. A rewrite one pass later would hand a `var` an immortal record the declaration had
	// already waved through as owned. Emitting the literal HERE inherits that regime, plus
	// `LiteralArgPromotion`'s copy before a mutating parameter and the four `emitRecordIsImmortal` branches —
	// and teaches no new buffer provenance, which is what `BufferOwnership`'s header requires of anything
	// that would.
	//
	// ⚠ **IT RETURNS AHEAD OF EVERY OTHER CHECK IN `emitCall`, AND THAT IS SOUND BECAUSE IT IS ONE NAMED
	// CALLEE.** `String.slice` mutates nothing, consumes nothing, throws nothing, and carries no
	// sized-container record — so the argument refusal, the default fill, the caller-consume and the
	// constant-argument range record all have nothing to say about a call that is not going to exist. The
	// range record in particular is what would refuse `length: -1`, and a negative length is exactly one of
	// the cases this DECLINES to fold, so that diagnostic still fires through the ordinary path.
	//
	// ⚠ **ADMISSION — the callee's name, the arity and the `try`-target flag — IS DECIDED BY THE CALLER**, and
	// deliberately: this answers with a boxed union, `emitCall` runs for every call in every compile, and a
	// `notFolded` box built to say "that was never a slice" would be an allocation on the parser's hottest
	// path. So everything reaching here is a three-argument `String.slice` outside a `try` target, and this
	// decides only what no compare can: whether the receiver and the bounds are compile-time facts.
	function foldConstantStringSlice(anchor Token, args ValueIdArray, argLabels NameRoster, rparenTok Token) returns ConstantSliceFold
		return match self.knownLiteralBytes(try args.get(SliceReceiverArgIndex) otherwise panic("foldConstantStringSlice: args.get OOB at the receiver of a {args.count()}-argument call")) 'receiver'
			unknown gives ConstantSliceFold.notFolded
			payload(literalOp, bytes) gives self.foldSliceOfKnownBytes(bytes, literalOp: literalOp, anchor: anchor, args: args, argLabels: argLabels, rparenTok: rparenTok)
		end 'receiver'
	end 'foldConstantStringSlice'

	// The receiver's bytes are in hand. Is the START a byte position the compiler minted?
	function foldSliceOfKnownBytes(receiverBytes immutable ByteArray, literalOp ElementIndex, anchor Token, args ValueIdArray, argLabels NameRoster, rparenTok Token) returns ConstantSliceFold
		let startArg = try args.get(SliceStartArgIndex) otherwise panic("foldSliceOfKnownBytes: args.get OOB at the start index of a {args.count()}-argument `String.slice`")
		let boundArg = try args.get(SliceBoundArgIndex) otherwise panic("foldSliceOfKnownBytes: args.get OOB at the bound of a {args.count()}-argument `String.slice`")

		// `argLabels` is parallel to `args` unconditionally — see `MaxonOp.call`.
		let boundLabel = try argLabels.get(SliceBoundArgIndex) otherwise panic("foldSliceOfKnownBytes: argLabels holds {argLabels.count()} entries for {args.count()} arguments — the two columns are parallel")

		return match self.knownStringBytePos(startArg) 'start'
			unknown gives ConstantSliceFold.notFolded
			position(startPos) gives self.foldSliceFromStart(receiverBytes, literalOp: literalOp, startPos: startPos, startArg: startArg, boundArg: boundArg, boundLabel: boundLabel, anchor: anchor, rparenTok: rparenTok)
		end 'start'
	end 'foldSliceOfKnownBytes'

	// ⭐ **`slice` AND `sliceLength` REACH THIS FOLD THROUGH ONE PATH, TOLD APART BY THE BOUND'S LABEL** —
	// only the first argument of a call may be positional, so the label says which meaning the bound carries.
	function foldSliceFromStart(receiverBytes immutable ByteArray, literalOp ElementIndex, startPos FullRangeInt, startArg ValueId, boundArg ValueId, boundLabel ByteArray, anchor Token, rparenTok Token) returns ConstantSliceFold
		if boundLabel.equals(SliceEndIndexArgLabel) 'byEndIndex'
			return match self.knownStringBytePos(boundArg) 'endBound'
				unknown gives ConstantSliceFold.notFolded
				position(endPos) gives self.foldSliceOverRange(receiverBytes, startPos: startPos, endPos: endPos, startArg: startArg, boundArg: boundArg, anchor: anchor, rparenTok: rparenTok)
			end 'endBound'
		end 'byEndIndex'

		if not boundLabel.equals(SliceLengthArgLabel) 'notALengthBound'
			return ConstantSliceFold.notFolded
		end 'notALengthBound'

		// ⚠⚠ **`length:` COUNTS GRAPHEME CLUSTERS, NOT BYTES, so this arm folds ONLY where the two are the
		// same number.** For a literal carrying multi-byte clusters the conversion is UAX#29 segmentation
		// (`graphemeOffsetToBytePos`), which is the emitted runtime's job and not the compiler's — a fold that
		// read the count as a byte offset would cut a multi-byte cluster in half and answer bytes no reading
		// of the program produces. `string-index.md:slice-by-length-counts-clusters` is that shape, and it
		// keeps the runtime call. The predicate is `StringRuntime`'s own, exported rather than re-derived so
		// the two cannot come to disagree about a CR — and MEMOIZED per literal op, because it is an O(L)
		// scan and K windows of one literal would otherwise scan it K times.
		if not self.constIsKnown(boundArg) or not self.literalHasSingleByteGraphemes(literalOp, bytes: receiverBytes) 'notAByteCount'
			return ConstantSliceFold.notFolded
		end 'notAByteCount'

		// Bounded against the receiver BEFORE the addition, so `startPos + length` cannot leave the i64 the
		// payload column is; the shared range test below still decides whether the window is inside.
		let length = self.constOf(boundArg)

		if length < 0 or length > receiverBytes.count() as FullRangeInt 'notAWindowOfThisLiteral'
			return ConstantSliceFold.notFolded
		end 'notAWindowOfThisLiteral'

		return self.foldSliceOverRange(receiverBytes, startPos: startPos, endPos: startPos + length, startArg: startArg, boundArg: boundArg, anchor: anchor, rparenTok: rparenTok)
	end 'foldSliceFromStart'

	// ⭐ **IS EVERY GRAPHEME OF THIS LITERAL ONE BYTE? ASKED ONCE PER LITERAL, NOT ONCE PER FOLD SITE.**
	// `bytesAreSingleByteGraphemes` walks the whole literal, and `sliceLength` asks it at every fold
	// site — so K sites cutting windows of one L-byte literal paid O(K·L), with K and L both growing with the
	// source. The op index is the literal's identity (`KnownLiteralBytes.payload`), which is why the memo is
	// keyed by it and survives for the whole file parse: the answer is a fact about the bytes and nothing a
	// function boundary can change.
	function literalHasSingleByteGraphemes(literalOp ElementIndex, bytes ByteArray) returns bool
		if let alreadyScanned = try self.memos.scannedGraphemeVerdict(literalOp) 'scannedOnAnEarlierFold'
			return alreadyScanned
		end 'scannedOnAnEarlierFold'

		let answer = bytesAreSingleByteGraphemes(bytes)

		// COPY-ON-WRITE off the shared empty map, exactly as `recordCharLiteralOp` does and for its reason: a
		// file that folds no `length:` slice never allocates one.
		self.memos.noteGraphemeVerdict(literalOp, verdict: answer)

		return answer
	end 'literalHasSingleByteGraphemes'

	// Both ends are numbers now. Cut the window — or decline, and let the emitted call answer.
	//
	// ⚠ **K DISTINCT WINDOWS OF ONE L-BYTE LITERAL EMIT UP TO O(K·L) `.rdata` BYTES, AND THAT IS INHERENT
	// RATHER THAN A COST TO REMOVE.** Distinct windows genuinely are distinct constants and need distinct
	// blobs; identical ones already collapse, because `GlobalDataTable.registerRdataConstant` dedupes by
	// payload bytes — which is the same sharing `a-folded-slice-does-not-corrupt-a-deduped-literal` pins the
	// safety of. The alternative — one blob plus an offset — is the runtime view record this fold exists to
	// stop allocating.
	function foldSliceOverRange(receiverBytes immutable ByteArray, startPos FullRangeInt, endPos FullRangeInt, startArg ValueId, boundArg ValueId, anchor Token, rparenTok Token) returns ConstantSliceFold
		// ⛔ **AN OUT-OF-RANGE CONSTANT RANGE IS NOT A DIAGNOSTIC HERE — IT IS A DECLINE.** `sliceBytes`
		// panics on exactly this, with a trace `string-index.md` pins verbatim, and folding the program's
		// abort away would be this pass answering a question the language has already answered. Two literals
		// are enough to reach it: `a.slice(a.startIndex(), endIndex: b.endIndex())` with `b` the longer.
		if startPos < 0 or endPos < startPos or endPos > receiverBytes.count() as FullRangeInt 'outsideTheLiteral'
			return ConstantSliceFold.notFolded
		end 'outsideTheLiteral'

		// ⭐ **THE INDEX ACCESSORS GO WITH THE CALL, AND THAT IS HALF THE COST THIS REMOVES.** A `StringIndex`
		// is a two-field HEAP box (`stdlib/String.maxon`), so `s.startIndex()` and `s.endIndex()` are an
		// allocation each — leave them and a folded `endIndex:` slice still costs two.
		//
		// ⚠ **THE BOUND GOES FIRST, AND THE ORDER IS LOAD-BEARING.** Arguments are parsed left to right, so
		// the bound's op stands AFTER the start's in the block; each removal shifts every op ref behind it
		// down by one, and `FoldedIndexCallSite` records an absolute position. Dropping the later one first
		// leaves the earlier one's record exact. The reverse order would leave the start's record naming the
		// op that followed it — which `currentBlockStillHoldsFiledOp` would catch as a mismatch and decline,
		// so it is one allocation rather than a wrong answer, but it is still the wrong order.
		self.dropFoldedStringIndexCall(boundArg)
		self.dropFoldedStringIndexCall(startArg)

		let folded = freeze try receiverBytes.slice(startPos as ElementIndex, endIndex: endPos as ElementIndex) otherwise panic("foldSliceOverRange: [{startPos}, {endPos}) is not a range of a {receiverBytes.count()}-byte literal — the guard above admits only ranges inside it")
		return ConstantSliceFold.folded(self.emitStringLiteral(folded, range: SourceRange.between(anchor, last: rparenTok)))
	end 'foldSliceOverRange'

	// ⭐⭐ **DROP THE `startIndex()` / `endIndex()` CALL THE FOLD HAS JUST MADE GARBAGE, AND THE STATEMENT'S
	// DEBT FOR ITS BOX WITH IT.** Both accessors are PURE — they read the receiver and build a fresh index —
	// and that purity is the whole licence for removing one: nothing observable happens between the call and
	// the value nobody now reads.
	//
	// ⚠ **THE GATE IS `pendingTempsContain`, NOT "does anything else name this value".** A value a BINDING
	// owns (`let i = s.startIndex()`) is read by that binding's scope drop and by every later mention of its
	// name, none of which this door can see; the pending list is precisely the owned values NO binding owns,
	// and an expression's value has exactly one syntactic consumer — the call this fold has just replaced. A
	// bound index therefore keeps its call and the slice still folds, which costs an allocation and answers
	// the same bytes.
	//
	// ⚠ It is also what makes this safe to call on the LENGTH argument: an integer literal is not an owned
	// temp, so `sliceLength`'s bound leaves through the provenance test above and nothing is removed.
	//
	// ⭐ **NOTHING IS SEARCHED FOR.** `FoldedIndexCallSite` was filed as the call was emitted, so the op ref's
	// position is read rather than hunted, and the two MISSES below — no record, or a record the block no
	// longer bears out — are ordinary answers that keep the call.
	function dropFoldedStringIndexCall(value ValueId)
		if not self.valueIsKnownStringBytePos(value) 'notAnIndexThisParseMinted'
			return
		end 'notAnIndexThisParseMinted'

		if not self.pendingTempsContain(value) 'someoneElseHoldsIt'
			return
		end 'someoneElseHoldsIt'

		if let site = try self.filedIndexCallSite(value) 'itsCallSiteIsOnFile'
			if self.currentBlockStillHoldsFiledOp(site) 'andTheBlockStillBearsItOut'
				self.removeCurrentBlockOpAt(site.blockOpPos, siteMark: site.siteMark)
				self.removeFromPendingTemps(value)
			end 'andTheBlockStillBearsItOut'
		end 'itsCallSiteIsOnFile'
	end 'dropFoldedStringIndexCall'

	// ⭐⭐ **DOES THE CURRENT BLOCK STILL HOLD THE FILED OP REF WHERE IT WAS FILED?** — an IDENTITY check, not
	// a resemblance one: `module.ops` indices are minted by append and never reused, so an op index appears in
	// exactly one block's `opRefs` at exactly one position, and this compare is the whole proof.
	//
	// ⛔ **THE `false` ANSWERS ARE REAL AND ARE WHY THIS EXISTS.** A `try` or a ternary inside the argument
	// list forks the block, so the accessor may stand in one this parse has already left — and a ternary's
	// `detachOpRefsAbove` truncates the block it was recorded in and re-attaches the ops elsewhere. Either way
	// the recorded position now names a different op or no op at all, and the removal is DECLINED: the call
	// stays, the program is correct, and it pays the one allocation this fold would have saved.
	function currentBlockStillHoldsFiledOp(site FoldedIndexCallSite) returns bool
		if site.block != self.bodyState.currentBlock.id or site.blockOpPos >= self.bodyState.currentBlock.bodyOpCount() 'theBlockHasMovedOnFromIt'
			return false
		end 'theBlockHasMovedOnFromIt'

		let standingThere = try self.bodyState.currentBlock.bodyOpAt(site.blockOpPos) otherwise panic("currentBlockStillHoldsFiledOp: bodyOpAt OOB at {site.blockOpPos} of {self.bodyState.currentBlock.bodyOpCount()} — the bound was just checked")
		return standingThere == site.opIndex
	end 'currentBlockStillHoldsFiledOp'

	// File where the op defining a known byte position was appended, so the fold that makes it garbage can
	// drop it without hunting. `recordCharLiteralOp`'s twin — same COW-off-the-shared-empty discipline, same
	// reason — differing only in what a site is: see `FoldedIndexCallSite` for why it takes four numbers.
	function recordFoldedIndexCallSite(value ValueId, opIndex ElementIndex)
		let landedAt = self.bodyState.currentBlock.bodyOpCount() - 1
		let site = FoldedIndexCallSite.create(self.bodyState.currentBlock.id, blockOpPos: landedAt, opIndex: opIndex, siteMark: self.bodyState.rangeCheckSites.count())
		let filed = self.foldedIndexCallSitesForWrite()
		filed.upsert(value, value: site)
	end 'recordFoldedIndexCallSite'

	// ⚠⚠ **AN OP'S ORDINAL IN ITS BLOCK IS A KEY, SO REMOVING ONE MOVES EVERY RANGE-CHECK SITE BEHIND IT.**
	// `RangeCheckSite` anchors a guard by (block, ordinal) because a narrowing int→int cast emits no op of
	// its own to hang it on, and `LowerMaxonToStd` consumes each block's sites in ASCENDING order against the
	// ops it walks (`requireSiteOrdinalsAscend`) — so a site left naming its old ordinal would have its guard
	// emitted one op late, which is the wrong side of the very cast it guards. This is
	// `rehomeArmRangeSites`' arithmetic for a REMOVAL rather than a relocation, and the recorded order is
	// preserved because every affected site moves by the same one.
	//
	// ⭐⭐ **BOTH WALKS ARE BOUNDED, AND BY THE SAME FACT: THE OP WAS APPENDED MOMENTS AGO.**
	//
	//   * The op refs are shifted down IN PLACE from `removedAt`, so the work is the number of ops appended
	//     AFTER the accessor — the rest of one argument list — and not the length of the block. Rebuilding
	//     the array instead cost O(B) copies plus a fresh `OpIndexArray` per removal, twice per folded slice,
	//     in a block whose length grows with the number of folds: an O(F²) that the ladder cannot see because
	//     its corpus emits no constant slice at all.
	//   * `siteMark` is `rangeCheckSites.count()` at the instant the op was appended, and a site records
	//     `maxonOpPos = bodyOpCount()` of the block it is recorded in — so every site filed before that
	//     instant names a position at or below `removedAt` and is unmoved by definition. Only the sites after
	//     the mark can move, which is `rehomeArmRangeSites`' bounded sub-range in the other direction.
	//
	// ⚠ The op keeps its `module.ops` index and is simply referenced by no block — the ops and the blocks
	// that order them are separate stores (`detachOpRefsAbove` states the same split), and every walk of this
	// IR reaches an op through some block's `opRefs`. So an unreferenced op is not visited rather than
	// visited-and-skipped, and rewriting the index space to close the gap would invalidate every index
	// already filed against it (`ConstPayloadDomain.stringLiteralOp`'s among them).
	function removeCurrentBlockOpAt(removedAt ElementIndex, siteMark ElementIndex)
		let lastPos = self.bodyState.currentBlock.bodyOpCount() - 1

		for i in removedAt upto lastPos 'shiftTheTailDown'
			let following = try self.bodyState.currentBlock.bodyOpAt(i + 1) otherwise panic("removeCurrentBlockOpAt: bodyOpAt OOB at {i + 1} of {self.bodyState.currentBlock.bodyOpCount()}")
			try self.bodyState.currentBlock.setBodyOp(i, value: following) otherwise panic("removeCurrentBlockOpAt: setBodyOp OOB at {i} of {self.bodyState.currentBlock.bodyOpCount()}")
		end 'shiftTheTailDown'

		_ = try self.bodyState.currentBlock.popBodyOp() otherwise panic("removeCurrentBlockOpAt: popBodyOp on a block the caller proved holds position {removedAt}")

		for i in siteMark upto self.bodyState.rangeCheckSites.count() 'eachSiteSinceTheOpWasAppended'
			let site = try self.bodyState.rangeCheckSites.get(i) otherwise panic("removeCurrentBlockOpAt: rangeCheckSites.get OOB at {i} of {self.bodyState.rangeCheckSites.count()}")

			if site.block != self.bodyState.currentBlock.id or site.maxonOpPos <= removedAt 'unmovedByTheRemoval'
				continue
			end 'unmovedByTheRemoval'

			try self.bodyState.rangeCheckSites.set(i, value: site.placedAt(site.block, atOrdinal: site.maxonOpPos - 1)) otherwise panic("removeCurrentBlockOpAt: rangeCheckSites.set OOB at {i}, which the read above just found in range")
		end 'eachSiteSinceTheOpWasAppended'
	end 'removeCurrentBlockOpAt'

	// ⭐ **`startIndex()` AND `endIndex()` OF A KNOWN-BYTES RECEIVER ANSWER A BYTE POSITION THE
	// COMPILER ALREADY HOLDS** — 0 and the literal's byte length. Recorded on the RESULT, keyed by
	// ValueId, so a rebinding cannot carry a stale answer:
	// `string-type-2.md:reassigned-var-equality-not-const-folded` pins that: a specializer keyed on a
	// DECLARATION id would carry a stale answer across a reassignment. A rebind mints a new ValueId,
	// so keying here is structurally safe.
	//
	// ⚠ **THE CALLEE IS TESTED BEFORE THE RECEIVER, WHICH IS THE OPPOSITE OF THE READING ORDER AND IS
	// DELIBERATE.** `knownLiteralBytes` answers with a boxed union — a heap allocation — and this runs for
	// every one-argument call in every compile. Two length-first byte compares leave every other such call
	// having built nothing.
	function recordConstStringIndexResult(result ValueId, callee ByteArray, args ValueIdArray)
		if args.count() != StringIndexAccessorArgCount 'notAnAccessorShape'
			return
		end 'notAnAccessorShape'

		let atTheFirstByte = callee.equals(StringStartIndexMethodName)

		if not atTheFirstByte and not callee.equals(StringEndIndexMethodName) 'notAnIndexAccessor'
			return
		end 'notAnIndexAccessor'

		match self.knownLiteralBytes(try args.get(SliceReceiverArgIndex) otherwise panic("recordConstStringIndexResult: args.get OOB at the receiver of a one-argument call")) 'receiver'
			unknown then break
			payload(_, bytes) then self.recordAccessorBytePos(result, atTheFirstByte: atTheFirstByte, receiverBytes: bytes)
		end 'receiver'
	end 'recordConstStringIndexResult'

	// Which position the accessor its caller identified names: the first byte, or one past the last.
	function recordAccessorBytePos(result ValueId, atTheFirstByte bool, receiverBytes ByteArray)
		let bytePos = LiteralStartBytePos if atTheFirstByte else receiverBytes.count() as FullRangeInt
		self.recordConstPayload(result, payload: bytePos, domain: ConstPayloadDomain.stringBytePos)
	end 'recordAccessorBytePos'

	// ⭐ **SUPPLY EVERY ARGUMENT THE CALL OMITTED AND THE DECLARATION DEFAULTS** — each one
	// becomes a call to the declaration's synthesized helper, appended with `slotArgLabel`'s label for its
	// slot, so `slotCallArgs` puts it in the right position whatever order the written arguments came in.
	//
	// ⚠ **IT FILLS BY SLOT, NOT BY TRAILING RUN, AND THAT IS WHAT MAKES A NON-TRAILING DEFAULT WORK.**
	// `choose(flag bool = true, a Integer = 40, b Integer = 10)` called `choose()` fills all three; the same
	// declaration called `choose(false, b: 7)` fills only `a`. The occupied slots are computed by
	// `plannedDefaultArgs` through `argSlotPosition` — the SAME label→position mapping `slotCallArgs` will
	// use — so a call cannot be filled against one slotting and validated against another.
	//
	// ⚠ **A SLOT WITH NEITHER AN ARGUMENT NOR A DEFAULT IS LEFT EMPTY ON PURPOSE**, and so is a call whose
	// label resolves to no parameter. Both are diagnostics that already exist, own their wording and their
	// position, and read the RESOLVED signature rather than the tolerant sweep — E3036 and E3037, from
	// `SemanticCheck` through `slotCallArgs`. Reporting either here would be a second opinion built on the
	// weaker registry.
	//
	// `receiverSlots` counts the leading declared parameters `args` does not hold — a message's
	// `self`, which a send never carries — so the written arguments are slotted from there. A direct
	// method call has its receiver in `args` already and passes `NoReceiverSlots`; passing that for a
	// message would fill every default one slot early.
	function fillOmittedArgDefaults(callee ByteArray, anchor Token, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, receiverSlots ParamCount) returns ParamCount throws SourceParseError
		// ⚡ The gate is the allocation-free PRESENCE test, not `defaultsOf` itself: this runs at every call
		// in the program, and a payload-free union case still heap-allocates in Maxon — an `allRequired`
		// minted per parsed call is the constant factor that reverted the math-intrinsic resolver
		// (`parseCallNamed`). Only a callee that genuinely declares a default pays for the union.
		if not self.signatures.declaresParamDefaults(callee) 'everyParameterRequired'
			return NoDefaultedArgs
		end 'everyParameterRequired'

		match self.signatures.defaultsOf(callee) 'defaults'
			allRequired then return NoDefaultedArgs
			defaults(info) then return try self.fillArgsFromParamDefaults(info, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, receiverSlots: receiverSlots)
		end 'defaults'
	end 'fillOmittedArgDefaults'

	function firstParameterHasDefault(callee ByteArray, firstParam ParamCount) returns bool
		return match self.signatures.defaultsOf(callee) 'defaults'
			allRequired gives false
			defaults(info) gives not producerIsRequired(info.producerFor(firstParam))
		end 'defaults'
	end 'firstParameterHasDefault'

	function firstArgLabelIsRefused(label ByteArray, callee ByteArray, firstParam ParamCount) returns bool
		return not label.isEmpty() and not self.firstParameterHasDefault(callee, firstParam: firstParam)
	end 'firstArgLabelIsRefused'

	function requireFirstArgLabelHasDefault(callee ByteArray, firstParam ParamCount, argLabels NameRoster, argRanges SourceRangeArray, receiverArgs Count) throws SourceParseError
		let firstLabel = try argLabels.get(receiverArgs) otherwise return

		if firstLabel.isEmpty() 'positional'
			return
		end 'positional'

		if self.firstArgLabelIsRefused(firstLabel, callee: callee, firstParam: firstParam) 'refused'
			let labelRange = try argRanges.get(receiverArgs) otherwise panic("requireFirstArgLabelHasDefault: argRanges.get OOB at {receiverArgs} — the range column is parallel to the label column")
			throw SourceParseError.firstArgNamed(labelRange.line, column: labelRange.column)
		end 'refused'
	end 'requireFirstArgLabelHasDefault'

	// Returns how many arguments it appended, which the caller hands to `stampDefaultsSubject`.
	function fillArgsFromParamDefaults(info ParamDefaultInfo, anchor Token, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, receiverSlots ParamCount) returns ParamCount throws SourceParseError
		if argLabels.count() != args.count() 'labelsOutOfStep'
			panic("fillArgsFromParamDefaults: {argLabels.count()} labels for {args.count()} arguments — the label column is pushed in lockstep with args")
		end 'labelsOutOfStep'

		let planned = plannedDefaultArgs(info, written: argLabels, receiverSlots: receiverSlots)

		for fill in planned 'fillDefaults'
			let value = try self.emitDefaultArgValue(fill.producer, anchor: anchor)
			pushDefaultedCallArg(args, argLabels: argLabels, argRanges: argRanges, value: value, label: fill.label, range: SourceRange.ofToken(anchor))
		end 'fillDefaults'

		return planned.count() as ParamCount
	end 'fillArgsFromParamDefaults'

	// ⭐⭐ **THE VALUE ONE OMITTED ARGUMENT TAKES — THE POINT THE LANGUAGE'S TWO DEFAULT DOORS DIVERGE, AND
	// THE ONLY ONE.** Everything around it — the slot bookkeeping, the slot label,
	// and every check downstream that cannot tell a defaulted argument from a written one
	// — is shared, because what differs between the doors is exactly and only what produces the value.
	//
	// ⚠ **A CALLER-LOCATION DEFAULT EMITS THE OPS THE CALLER WOULD HAVE EMITTED HAD IT WRITTEN THE VALUE
	// OUT**, and that is what makes it need no rule of its own anywhere else. An `at SourceLineNumber =
	// __line__` filled here is the same `literal` op as a hand-written `at: 7`, so the ranged-alias check in
	// front of the call (`recordConstantArgRangeChecks`) reads it, `SemanticCheck` types it, and the backend
	// sees a constant. A `from String = __file__` is the same immortal `.rdata` record a hand-written
	// `"main.maxon"` is, with the same (absent) ownership obligation.
	function emitDefaultHelperCall(name ByteArray, anchor Token) returns ValueId throws SourceParseError
		let opFloor = self.artifact.module.ops.count()
		let value = try self.emitCall(name, anchor: anchor, args: ValueIdArray.create(0), argLabels: NameRoster.create(0), argRanges: SourceRangeArray.create(0), argImmutableNames: NameRoster.create(0), rparenTok: anchor, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: CalleeMint.paramDefaultHelper)
		self.noteCallResultCapability(value, callee: name, args: ValueIdArray.create(0), opensAnIsolatedValue: false, opFloor: opFloor, anchor: anchor, argLabels: NameRoster.create(0), receiver: ReceiverArg.none)

		if not self.valueIsAValueType(value) and not self.valueIsAnUndecidedResult(value) and self.resultCapabilityDeclaredFor(name) == ResultCapability.unmarked 'judgedOnceTheHelperIsRead'
			self.noteUndecidedResult(value, opFloor: opFloor)
		end 'judgedOnceTheHelperIsRead'

		return value
	end 'emitDefaultHelperCall'

	function emitDefaultArgValue(producer ParamDefaultProducer, anchor Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(anchor)
		return match producer 'produces'
			required panic("emitDefaultArgValue: parameter is `required`, which the caller skips before asking — a slot with no default is left empty on purpose (E3036 reports it from the resolved signature)")

			// ⭐ **THE LINE OF THE TOKEN NAMING THE CALLEE**, which `anchor` is at every one of the doors that
			// funnel through `emitCall` — a free call's identifier, a method's name after the final `.`, a
			// static's after the type. That is the spec's rule word for word, and it is what makes two calls
			// to one function on two lines produce two values.
			callerLine gives self.emitLiteral(anchor.line as FullRangeInt, valueType: MaxonType.integer, range: range)
			callerFile gives self.emitStringLiteral(self.sourceFileDisplayPath(), range: range)

			// The synthesized nullary function (`SignatureIndex.ParamDefaultInfo`). It is nullary, so this
			// recursion bottoms out at once: no helper declares a parameter, hence none is in
			// `funcParamDefaults` and `fillOmittedArgDefaults` returns on its first match.
			helper(name) gives try self.emitDefaultHelperCall(name, anchor: anchor)
		end 'produces'
	end 'emitDefaultArgValue'

	// A defaulted helper of a generic declaration takes its hidden arguments from the instance stamped on
	// its result here; at a factory call that instance exists only once inference has run, so every caller
	// stamps after it.
	function stampDefaultsSubject(callee ByteArray, args ValueIdArray, argLabels NameRoster, defaultedArgs ParamCount, receiverSlots ParamCount, constructorInstance ConstructorInstance)
		if defaultedArgs == NoDefaultedArgs 'nothingWasFilled'
			return
		end 'nothingWasFilled'

		match self.defaultsSubjectOf(callee, args: args, receiverSlots: receiverSlots, constructorInstance: constructorInstance) 'subject'
			none then return
			instance(gid) then self.recordInstanceOnHelperDefaults(callee, args: args, argLabels: argLabels, defaultedArgs: defaultedArgs, instance: gid)
		end 'subject'
	end 'stampDefaultsSubject'

	function recordInstanceOnHelperDefaults(callee ByteArray, args ValueIdArray, argLabels NameRoster, defaultedArgs ParamCount, instance GenericInstanceId)
		match self.signatures.defaultsOf(callee) 'defaults'
			allRequired then return
			defaults(info) then self.recordInstanceOnHelperResults(info, args: args, argLabels: argLabels, defaultedArgs: defaultedArgs, instance: instance)
		end 'defaults'
	end 'recordInstanceOnHelperDefaults'

	function recordInstanceOnHelperResults(info ParamDefaultInfo, args ValueIdArray, argLabels NameRoster, defaultedArgs ParamCount, instance GenericInstanceId)
		let filledSlots = synthesizedArgSlots(info.paramNames, argLabels: argLabels, defaultedArgs: defaultedArgs)

		for position in 0 upto filledSlots.count() 'eachFilledSlot'
			let slot = try filledSlots.get(position) otherwise panic("recordInstanceOnHelperResults: filledSlots.get OOB at {position} below count()")
			let argIndex = synthesizedArgIndex(args.count(), defaultedArgs: defaultedArgs, k: position as ParamCount)
			let value = try args.get(argIndex) otherwise panic("recordInstanceOnHelperResults: args.get OOB at {argIndex} — the fill appends one value per filled slot")

			match info.producerFor(slot) 'producer'
				helper then self.recordValueCallInstance(value, instance: instance)
				required or
				callerLine or
				callerFile then continue
			end 'producer'
		end 'eachFilledSlot'
	end 'recordInstanceOnHelperResults'

	function defaultsSubjectOf(callee ByteArray, args ValueIdArray, receiverSlots ParamCount, constructorInstance ConstructorInstance) returns ConstructorInstance
		if receiverSlots != NoReceiverSlots or self.signatures.calleeReceiverOf(callee) != CalleeReceiver.takesReceiver 'theSubjectIsNotAnArgument'
			return constructorInstance
		end 'theSubjectIsNotAnArgument'

		let receiver = try args.get(0) otherwise return ConstructorInstance.none

		if self.tagOf(receiver) != ValueTypeTag.genericInstance 'notAnInstance'
			return ConstructorInstance.none
		end 'notAnInstance'

		return ConstructorInstance.instance(self.valueNameId(receiver) as GenericInstanceId)
	end 'defaultsSubjectOf'

	// ⭐ **HOW THE FILE BEING PARSED NAMES ITSELF INSIDE EMITTED CODE** — its path relative to the
	// compile root, `/`-separated on every host, which is what `__file__` expands to.
	//
	// It is DERIVED from the module directory the whole-program index already stamped for this file
	// (`Queries.moduleDirectoryForFile`, which is `Project.deriveModuleDirectory` against the compile
	// anchor) rather than measured a second time here. That directory is already root-relative and already
	// `/`-joined — the separator rewrite lives there, once — so the only thing left to add is the file's own
	// name. A second `relativeTo` here would be the same derivation written twice, free to disagree with the
	// one every namespace and every `Visibility.unexported` answer is decided on.
	//
	// ⚠ RELATIVE AND NOT ABSOLUTE BY CHOICE, and the reason is a gate rather than taste: an absolute path is
	// a fact about the machine that ra compiler, so embedding one makes two builds of one commit on two
	// machines emit different bytes.
	//
	// MEASURED against the oracle, which is canonical for `/specs`: a `__file__` default filled from
	// `sub/helper.maxon` in a directory build prints `sub/helper.maxon`, and one filled from the root file
	// prints `main.maxon`.
	function sourceFileDisplayPath() returns immutable ByteArray
		return freeze self.signatures.projectRelativeFileDisplay(self.job.path).toByteArray()
	end 'sourceFileDisplayPath'

	// ⭐ **RETYPE-OF-T AT A CONCRETE METHOD'S RETURN — `emitFieldLoad`'s rule, reached one op
	// further.** `c.unwrap()` on a `Cell with Wide` returns what the SHARED body declared, the opaque
	// `T`, and an opaque value AGREES WITH EVERY TYPE: it is not merely imprecise, it is the one tag
	// that cannot discriminate. The receiver's alias binds `T`, so the answer is the instance's substituted
	// argument — the same `substitutedInstanceArg` a concrete field read already asks.
	//
	// ⭐ **IT IS THE FIELD-READ RULE EXACTLY, INCLUDING FOR A MANAGED ARGUMENT.** `emitCall`
	// enrols a call RESULT's drop AFTER this call (`enrolOwnedCallTemp`), so the ownership decision is
	// made from the SUBSTITUTED tag and the substitution applies whether or not the concrete argument
	// owns heap. A field read is a BORROW and this an OWNED result; what they share is that both learn
	// what `T` is before anything reads the answer.
	//
	// The gate is ordered cheapest-first: almost every call in a program has neither a generic first argument
	// nor a constructed instance, and that test is one array read. Only past it is the callee's declaration
	// looked up.
	//
	// ⚠ **IT REPORTS NO OWNERSHIP BIT.** Whether the result is co-owned would be answered from the
	// DECLARED return type while the obligation belongs to the RETURNED VALUE, and the two disagree
	// for every body that returns a value it already owns. The callee discharges the hand-off for
	// every shape (`emitOwnedValueReturn`), so there is one convention and nothing here for a caller
	// to read back.
	function typeCallResultThroughInstance(result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, bound BoundReturn, constructed ConstructorInstance, anchor Token) returns OpaqueWordReading throws SourceParseError
		let source = self.instanceSourceOfCall(result, callee: callee, args: args, constructed: constructed)
		self.promoteBareGenericResultToCalleeScope(result, source: source)

		match bound 'bound'
			undeclared then return OpaqueWordReading.asItStands
			declared(returnType, scopeFilePath) then return try self.typeResultThroughSource(result, source: source, callee: callee, args: args, argLabels: argLabels, returnType: returnType, scopeFilePath: scopeFilePath, anchor: anchor)
		end 'bound'
	end 'typeCallResultThroughInstance'

	function typeResultThroughSource(result ValueId, source CallInstanceSource, callee ByteArray, args ValueIdArray, argLabels NameRoster, returnType MaxonReturnType, scopeFilePath FilePath, anchor Token) returns OpaqueWordReading throws SourceParseError
		match source 'source'
			nowhere or
			scopeOnly then return OpaqueWordReading.asItStands
			qualifier(gid) then return try self.typeStaticResultThroughInstance(result, gid: gid, callee: callee, args: args, argLabels: argLabels, returnType: returnType, scopeFilePath: scopeFilePath, anchor: anchor)
			receiver(value) then return try self.retypeDeclaredMethodResult(result, callee: callee, args: args, argLabels: argLabels, receiver: value, returnType: returnType, scopeFilePath: scopeFilePath, anchor: anchor)
		end 'source'
	end 'typeResultThroughSource'

	function typeStaticResultThroughInstance(result ValueId, gid GenericInstanceId, callee ByteArray, args ValueIdArray, argLabels NameRoster, returnType MaxonReturnType, scopeFilePath FilePath, anchor Token) returns OpaqueWordReading throws SourceParseError
		try self.settleStaticPromiseHandout(result, callee: callee, args: args, argLabels: argLabels, returnType: returnType, gid: gid, scopeFilePath: scopeFilePath, anchor: anchor)
		self.markSurfaceOfStaticResult(result, args: args, gid: gid, returnType: returnType)
		return self.typeResultThroughInstance(result, gid: gid, scopeFilePath: scopeFilePath)
	end 'typeStaticResultThroughInstance'

	function settleStaticPromiseHandout(result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, returnType MaxonReturnType, gid GenericInstanceId, scopeFilePath FilePath, anchor Token) throws SourceParseError
		if not self.returnHandsBackAGreenThread(returnType, gid: gid, scopeFilePath: scopeFilePath) 'nothingToBorrow'
			return
		end 'nothingToBorrow'

		let holder = try self.holderArgumentOf(callee, args: args, argLabels: argLabels, gid: gid).value() otherwise return
		try self.settleCorpusPromiseRead(result, callee: callee, args: args, argLabels: argLabels, holder: holder, returnType: returnType, gid: gid, scopeFilePath: scopeFilePath, anchor: anchor)
	end 'settleStaticPromiseHandout'

	function returnHandsBackAGreenThread(returnType MaxonReturnType, gid GenericInstanceId, scopeFilePath FilePath) returns bool
		let declared = try valueTypeOfReturn(returnType) otherwise return false
		return self.typeHandsBackAGreenThread(self.slotTypeThroughInstance(declared, gid: gid, scopeFilePath: scopeFilePath))
	end 'returnHandsBackAGreenThread'

	function markSurfaceOfStaticResult(result ValueId, args ValueIdArray, gid GenericInstanceId, returnType MaxonReturnType)
		for argument in args 'eachArgument'
			if self.valueIsInstance(argument, giid: gid) 'theQualifiersInstance'
				self.markReceiverSurfaceOfResult(result, receiver: argument, returnType: returnType)
				return
			end 'theQualifiersInstance'
		end 'eachArgument'
	end 'markSurfaceOfStaticResult'

	function holderArgumentOf(callee ByteArray, args ValueIdArray, argLabels NameRoster, gid GenericInstanceId) returns HolderArgument
		let facts = self.declarationFactsBoundBy(callee)

		for column in 0 upto args.count() as ParamCount 'eachArgument'
			let argument = try args.get(column) otherwise panic("holderArgumentOf: args.get OOB at {column}")

			// A type over the bare base may hold the instance itself: `substituteThroughInstance` hands a
			// top-level `structRef` back unchanged, so such a type never says what `T` holds.
			if not self.argumentHoldsAPromise(argument) and not self.signatures.typeNamesTheBareBase(self.spawnTypeArgumentOfValue(argument), base: self.signatures.genericInstanceBaseName(gid)) 'holdsNone'
				continue
			end 'holdsNone'

			// A position every declaration takes moves the promise into the callee, so the caller holds
			// nothing the result could borrow.
			if self.columnIsMovedIn(facts, column: column, label: callArgumentLabel(argLabels, argIndex: column), argValue: argument, gid: gid) 'movedIn'
				continue
			end 'movedIn'

			return HolderArgument.holds(argument)
		end 'eachArgument'

		return sharedNoHolderArgument
	end 'holderArgumentOf'

	function instanceSourceOfCall(result ValueId, callee ByteArray, args ValueIdArray, constructed ConstructorInstance) returns CallInstanceSource
		if not self.callMayNameAnInstance(args, constructed: constructed) 'noGenericOperand'
			return sharedNoCallInstanceSource
		end 'noGenericOperand'

		let declaration = try self.signatures.sweptDeclarationOf(callee) otherwise return sharedNoCallInstanceSource

		if declaration.takesReceiver 'aMethod'
			let receiver = try args.get(0) otherwise return sharedNoCallInstanceSource
			return self.sourceOfReceiver(result, callee: callee, receiver: receiver)
		end 'aMethod'

		match constructed 'qualifier'
			none then return sharedNoCallInstanceSource
			instance(gid) then return CallInstanceSource.qualifier(gid) if isQualifiedUnderTypeName(callee, typeName: self.signatures.genericInstanceBaseName(gid)) else sharedNoCallInstanceSource
		end 'qualifier'
	end 'instanceSourceOfCall'

	function callMayNameAnInstance(args ValueIdArray, constructed ConstructorInstance) returns bool
		match constructed 'qualifier'
			instance then return true
			none then break
		end 'qualifier'

		if args.isEmpty() 'noFirstArgument'
			return false
		end 'noFirstArgument'

		let firstTag = self.tagOf(try args.get(0) otherwise panic("Parser.callMayNameAnInstance: args.get(0) failed on a non-empty list"))
		return firstTag == ValueTypeTag.structRef or firstTag == ValueTypeTag.genericInstance
	end 'callMayNameAnInstance'

	function sourceOfReceiver(result ValueId, callee ByteArray, receiver ValueId) returns CallInstanceSource
		if self.tagOf(receiver) == ValueTypeTag.genericInstance 'anInstance'
			let base = self.signatures.genericInstanceBaseName(self.valueInstanceId(receiver))

			// The callee must be a method OF the receiver's own generic base, or `T` names a different type's
			// parameter and the substitution would be against the wrong binding.
			if isQualifiedUnderTypeName(callee, typeName: base) 'aMethodOfTheBase'
				return CallInstanceSource.receiver(receiver)
			end 'aMethodOfTheBase'

			if not self.resultNamesADeclaredType(result) 'nothingToPromoteInTheInstance'
				return sharedNoCallInstanceSource
			end 'nothingToPromoteInTheInstance'

			return self.scopeOnlySourceOfForeignCallee(callee)
		end 'anInstance'

		if not self.resultNamesADeclaredType(result) 'nothingToPromote'
			return sharedNoCallInstanceSource
		end 'nothingToPromote'

		let declaringType = try self.methodSurfaceOf(receiver).declaredTypeName() otherwise return sharedNoCallInstanceSource

		if isQualifiedUnderTypeName(callee, typeName: declaringType) 'aMethodOfTheReceiversType'
			return CallInstanceSource.scopeOnly(declaringType)
		end 'aMethodOfTheReceiversType'

		return self.scopeOnlySourceOfForeignCallee(callee)
	end 'sourceOfReceiver'

	// A callee that is not a method of the receiver's type reads a bare generic result in the scope of its own
	// declaring type, which is not the receiver's.
	function scopeOnlySourceOfForeignCallee(callee ByteArray) returns CallInstanceSource
		match self.signatures.functionDeclaringType(callee) 'declaring'
			method(typeName) then return CallInstanceSource.scopeOnly(typeName)
			freeFunction or
			undeclared then return sharedNoCallInstanceSource
		end 'declaring'
	end 'scopeOnlySourceOfForeignCallee'

	function retypeDeclaredMethodResult(result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, receiver ValueId, returnType MaxonReturnType, scopeFilePath FilePath, anchor Token) returns OpaqueWordReading throws SourceParseError
		// ⭐⭐ **THE CORPUS-CALL DOOR IS THE ONLY PLACE A CORPUS MEMBER'S ELEMENT TYPE IS CONCRETE**.
		// `stdlib/Array.maxon` is compiled ONCE over an opaque `Element`, so no rule about
		// promise elements can be written inside `last()` or `cursor()` — in there the element is a type
		// parameter and nothing about green threads is true of it yet. Here the receiver's instance is
		// known, so here is where a member that hands back a BORROWED promise element, or a copy of a
		// receiver holding one, is refused.
		try self.requireCorpusCopyHoldsNoGreenThread(callee, receiver: receiver, anchor: anchor)
		try self.settleCorpusPromiseRead(result, callee: callee, args: args, argLabels: argLabels, holder: receiver, returnType: returnType, gid: self.valueInstanceId(receiver), scopeFilePath: scopeFilePath, anchor: anchor)
		self.markReceiverSurfaceOfResult(result, receiver: receiver, returnType: returnType)
		let reading = self.typeResultThroughInstance(result, gid: self.valueInstanceId(receiver), scopeFilePath: scopeFilePath)

		// After the retype: the result is tagged `typeParameter` until then, and the image-record carry marks
		// only a non-text aggregate, so marking first leaves the `let`'s element writable through a `var`.
		self.markStoredElementResult(result, receiver: receiver, callee: callee, args: args, argLabels: argLabels, returnType: returnType)
		return reading
	end 'retypeDeclaredMethodResult'

	function markStoredElementResult(result ValueId, receiver ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, returnType MaxonReturnType)
		let instance = self.valueInstanceId(receiver)
		let declared = try valueTypeOfReturn(returnType) otherwise return
		let position = try self.signatures.storedElementPositionOf(callee, instance: instance, declared: declared) otherwise return
		self.markStoredElementRead(result, container: receiver, qualifier: self.signatures.genericInstanceArgQualifier(instance, position: position))

		if self.valueHoldsAUniqueRecord(result) and not self.calleeMovesItsElementOut(callee, args: args, argLabels: argLabels, gid: instance) 'aUniqueLentByTheContainer'
			self.markElementRead(result)
		end 'aUniqueLentByTheContainer'
	end 'markStoredElementResult'

	function markStoredElementRead(result ValueId, container ValueId, qualifier GenericArgQualifier)
		self.carryImageRecordMarkToRead(container, read: result)

		if qualifier == GenericArgQualifier.frozen and not self.valueIsAValueType(result) 'anImmutableSlot'
			self.setValueCapability(result, capability: ValueCapability.immutable)
			self.bodyState.immutableSlotReads = withValueMarked(self.bodyState.immutableSlotReads, value: result)
		end 'anImmutableSlot'
	end 'markStoredElementRead'

	function requireCorpusCopyHoldsNoGreenThread(callee ByteArray, receiver ValueId, anchor Token) throws SourceParseError
		if not self.calleeCopiesItsNonArrayReceiver(callee, receiver: receiver) 'notACorpusCopy'
			return
		end 'notACorpusCopy'

		let instance = self.valueInstanceId(receiver)
		let subject = "`{self.valueDisplayTypeName(receiver)}`"

		if self.signatures.containerElementIsOpaque(instance) 'anOpaqueElement'
			try self.requireInstantiationsCopyNoGreenThread(typeParamIdOf(self.signatures.containerElementType(instance)), fallbackSubject: subject, memberTok: anchor)
			return
		end 'anOpaqueElement'

		try self.requireCloneCopiesNoGreenThread(self.signatures.sourceCloneVerdictOfType(MaxonType.genericInstance(instance)), subject: subject, memberTok: anchor)
	end 'requireCorpusCopyHoldsNoGreenThread'

	// A corpus method that takes its receiver and returns its own declaring type is a copy of the
	// receiver (`List.clone`); its declared return is the bare base, so the element is read off the
	// receiver's instance. `Array`'s copies are refused at `admitArrayCopy`.
	function calleeCopiesItsNonArrayReceiver(callee ByteArray, receiver ValueId) returns bool
		if self.valueIsAnArray(receiver) 'anArray'
			return false
		end 'anArray'

		if not self.signatures.calleeReturnsItsDeclaringType(callee) 'notASelfReturn'
			return false
		end 'notASelfReturn'

		return self.signatures.declaredByTheCorpus(self.signatures.declaringFileOf(callee)) and self.signatures.declaredMethodTakesReceiver(callee)
	end 'calleeCopiesItsNonArrayReceiver'

	// ⭐ **A CORPUS MEMBER MAY HAND A PROMISE ELEMENT OVER ONLY IF IT STOPPED HOLDING IT, OR NAMES THE SLOT IT
	// STILL HOLDS IT IN.**
	//
	// A promise has one owner. `pop`/`remove`/`removeFirst`/`removeLast` take the element OUT — the container
	// no longer names it, so the caller owns it outright and `enrolOwnedCallTemp` adopts it. An array
	// iterator's `current()`/`peek(n)` leave it in the array at a slot the iterator's cursor names, so the read
	// records that slot and the consume empties it, exactly as `get(i)` does. Every other member that yields
	// an element (`last`, a user generic's own accessor, a `List` iterator's `current`) leaves the container
	// holding it with no slot to name, which for a refcounted element is fine — the read RETAINS — and for a
	// green thread is impossible: there is no second reference to take.
	//
	// ⛔ **`try s.last() …` then `await` runs to exit 75 unrefused**, because the await reclaims the thread and
	// the array's element walk reclaims it again — hence a refusal here rather than a note.
	//
	// ⚠ **THE ROSTERS ARE OF LIBRARY DOORS, NOT OF SPELLINGS AUTHORS MAY INVENT.** Any other member, a user
	// `pop` included, moves its element out only when its body is proved to (`calleeMovesItsElementOut`): it
	// returns what a library move-out took from a field of `self`, or a parameter every declaration moves in.
	// The rest is refused rather than assumed safe — conservative instead of silently double-freeing
	// (unsound). The array-cursor arm
	// trusts that a `current()`/`peek(n)` on a record holding a `__ManagedMemoryCursor` reads the element that
	// cursor stands on; a record whose read comes from anywhere else names a slot not holding that thread, and
	// `__managed_vacate`'s occupant check aborts at the consume rather than emptying it.
	//
	// ⚠ The cursor slot's ops are emitted HERE, before the call op, so the call stays the last op a `try`
	// rewrite looks for (`try it.peek(1)`); the position they read is the one the call reads.
	function settleCorpusPromiseRead(result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, holder ValueId, returnType MaxonReturnType, gid GenericInstanceId, scopeFilePath FilePath, anchor Token) throws SourceParseError
		// ⚠ **GATED ON WHAT THE MEMBER RETURNS, NOT ON THE RECEIVER ALONE.** The rule is about handing an
		// ELEMENT over; a member of the same container that returns something else — `count()`, `push()`,
		// `clear()` — is untouched by it.
		let declared = try valueTypeOfReturn(returnType) otherwise return
		let handedBack = self.slotTypeThroughInstance(declared, gid: gid, scopeFilePath: scopeFilePath)

		if not self.typeHandsBackAGreenThread(handedBack) or self.calleeMovesItsElementOut(callee, args: args, argLabels: argLabels, gid: gid) 'nothingBorrowed'
			return
		end 'nothingBorrowed'

		if self.signatures.typeIsAGreenThreadHandle(handedBack, from: self.artifact.typeNames) and (qualifiedMemberIs(callee, member: CursorCurrentMethod) or qualifiedMemberIs(callee, member: CursorPeekMethod)) 'aCursorRead'
			if let slot = try self.emitIteratorCursorSlot(holder, args: args, range: SourceRange.ofToken(anchor)) 'overAnArray'
				self.recordConsumablePromiseSlot(result, container: slot.container, index: slot.index, isField: false)
				return
			end 'overAnArray'
		end 'aCursorRead'

		if self.bodyState.loopClaimsWithIteratorPromise 'theLoopDestructuresThePair'
			return
		end 'theLoopDestructuresThePair'

		let cure = PromisePairReadCure if tagNamesADeclaredType(maxonTypeTag(handedBack)) else PromiseSlotReadCure
		throw SourceParseError.promiseCannotBeBorrowed(String.from(unqualifiedMemberName(callee)), cure: cure, line: anchor.line, column: anchor.column)
	end 'settleCorpusPromiseRead'

	function calleeMovesItsElementOut(callee ByteArray, args ValueIdArray, argLabels NameRoster, gid GenericInstanceId) returns bool
		if self.signatures.declaresALibraryMoveOutDoor(callee) 'aLibraryDoor'
			return true
		end 'aLibraryDoor'

		if self.signatures.returnsAMovedOutElement(callee) 'movesOneOutOfAField'
			return true
		end 'movesOneOutOfAField'

		return self.signatures.returnsAParameter(callee) and self.returnableParametersAreMovedIn(callee, args: args, argLabels: argLabels, gid: gid)
	end 'calleeMovesItsElementOut'

	function returnableParametersAreMovedIn(callee ByteArray, args ValueIdArray, argLabels NameRoster, gid GenericInstanceId) returns bool
		let declaration = try self.declarationNameableHere(callee) otherwise return false
		let facts = self.declarationFactsBoundBy(callee)

		for position in 0 upto args.count() as ParamCount 'eachArgument'
			let label = callArgumentLabel(argLabels, argIndex: position)

			if not self.declarationMayReturnColumn(declaration, position: position, label: label) 'cannotBeReturned'
				continue
			end 'cannotBeReturned'

			if not self.columnIsMovedIn(facts, column: position, label: label, argValue: try args.get(position) otherwise panic("returnableParametersAreMovedIn: args.get OOB at {position}"), gid: gid) 'isNotMovedIn'
				return false
			end 'isNotMovedIn'
		end 'eachArgument'

		return true
	end 'returnableParametersAreMovedIn'

	function declarationMayReturnColumn(decl SweptDeclaration, position ParamCount, label ByteArray) returns bool
		let column = try columnOfCallPosition(decl.takesReceiver, position: position) otherwise return false
		let returned = try valueTypeOfReturn(decl.returnType) otherwise return false
		let slot = try argSlotPosition(decl.paramNames, argIndex: column, label: label) otherwise return true
		let declared = try decl.paramTypes.get(slot) otherwise panic("declarationMayReturnColumn: paramTypes.get OOB at {slot} — a declaration's parameter columns are built in lockstep")

		return not typesProvablyDiffer(self.sweptParamType(declared, scopeFilePath: decl.declFilePath), other: self.sweptParamType(returned, scopeFilePath: decl.declFilePath))
	end 'declarationMayReturnColumn'

	function columnIsMovedIn(facts DeclarationFacts, column ParamCount, label ByteArray, argValue ValueId, gid GenericInstanceId) returns bool
		return self.declarationTakesArgument(facts, column: column, label: label, argValue: argValue, constructorInstance: ConstructorInstance.instance(gid))
	end 'columnIsMovedIn'

	// ⭐ **DOES THIS RETURN TYPE PUT A GREEN THREAD IN THE CALLER'S HANDS?** Three shapes: the promise ITSELF
	// (`last()` → `Element`), a TUPLE carrying one (`WithIterIterator.current()` → `(Source, Element)`), or a
	// VIEW that will hand one back later (`slice()` → another array of them). Each puts a second holder on a
	// thread that admits exactly one.
	//
	// ⚠ **AN ARRAY ITERATOR IS NOT SUCH A VIEW**: every read through it names its slot (`settleCorpusPromiseRead`),
	// so `cursor()` and `createIterator()` hand back nothing a consume cannot account for.
	function typeHandsBackAGreenThread(t MaxonType) returns bool
		if self.signatures.typeIsAGreenThreadHandle(t, from: self.artifact.typeNames) 'isOneItself'
			return true
		end 'isOneItself'

		let tag = maxonTypeTag(t)

		if tagNamesADeclaredType(tag) 'aStructRef'
			let name = self.internedName(typeNameIdOf(t))
			return isTupleTypeName(name) and self.signatures.tupleCarriesAGreenThreadHandle(self.signatures.canonicalNameOfStruct(name))
		end 'aStructRef'

		if tag != ValueTypeTag.genericInstance 'notAView'
			return false
		end 'notAView'

		let gid = genericInstanceIdOf(t)

		if not self.signatures.containerElementIsAGreenThreadHandle(gid) 'viewsNoPromise'
			return false
		end 'viewsNoPromise'

		return self.signatures.managedCursorFieldsOf(gid).isEmpty()
	end 'typeHandsBackAGreenThread'

	// ⭐ **THE SURFACE CROSSES THE INSTANCE WITH THE TYPE** — `emitFieldLoad`'s pairing at the method-RESULT
	// position, and it is marked even where `typeResultThroughInstance` fixes nothing: which roster the result
	// serves is a fact about the receiver's ARGUMENT SPELLING, and the substitution can leave a type untouched
	// while that spelling still decides what the value may be asked for. `inner` is the CALLEE'S DECLARED
	// return — the declaration view, before anything has retyped the result — which is exactly the view
	// `surfaceBitsThroughInstanceArg` reads.
	function markReceiverSurfaceOfResult(result ValueId, receiver ValueId, returnType MaxonReturnType)
		match returnType 'r'
			value(inner) then self.markDeclaredSurface(result, declared: self.slotSurfaceThroughReceiver(receiver, declared: inner))
			void then break
		end 'r'
	end 'markReceiverSurfaceOfResult'

	// ⛔ **THERE IS NO MANAGED/TRIVIAL SPLIT HERE.** A `managedConcrete` guard before the retype,
	// refusing the substitution whenever the instance's argument owns heap, rests entirely on the ORDER
	// `emitCall` runs in — the drop enrolment taken from the opaque tag inside the mint, so a later retype
	// would contradict it. With the enrolment after this call (`enrolOwnedCallTemp`) there is nothing left
	// for such a guard to protect, and it refuses a program the oracle runs:
	// `bx.echo(bx.echo(Alpha.create()))` on a `Box with Alpha`, and every field read of the value that comes
	// back.
	//
	// ⚠ **The guard would be wrong; the RULE it sits next to is not.** `typeIsManaged` and every other
	// `ProgramSignatures` classifier must be asked of the INDEX-SPACE type, never of one
	// `slotTypeThroughInstance` has already re-interned into this file's table — the two interners assign ids
	// in their own insertion orders, so such an answer is right exactly while they coincide and silently
	// wrong when they drift (the reason the substitution and `adoptType` are two steps). That is
	// why the substitution below goes through `slotTypeThroughInstance` and not a bare `adoptType`:
	// `declaredSlotType` re-tags a struct / generic-alias / function name and leaves a union's `named` alone,
	// which is what makes `Box with Shape` hand `overShape(x Shape)` the union rather than reading the box
	// pointer as an integer (pinned by `generic-managed-union-return-is-retyped-at-the-call`).
	//
	// ⚠ **AND IT HAS NO `typeParameter`-ONLY GATE**, for the reason the read door has none: a method
	// declared `returns Items` inside `type HoldA uses T` hands back an `Array with T` that the receiver has
	// already fixed to `Array with Num`, and a gate keyed on the bare opaque tag cannot see it.
	//
	// ⚠⚠ **IT DOES NOT ANSWER A SECOND QUESTION — *does the caller owe this result a reference?*** A bit
	// read as *"the body took no reference"* has a caller mint a SECOND reference to a record the body just
	// built: `MapIterator.current()`'s `Entry = (Key, Value)` walked by `for (_, value) in m`, one leaked
	// record per call, five cases at exit 101 with every answer still correct. The shape is a caller reading
	// a DECLARED type to decide what a RETURNED VALUE owes; the callee owes the `+1` on every shape
	// (`emitOwnedValueReturn`), so there is no such bit.
	//
	// ⭐⭐ **AND IT ANSWERS ONE THING THE CALLER MUST ACT ON: A `returns T` THE INSTANCE FIXES TO `float`
	// CANNOT BE THE TYPE IT IS FIXED TO — IT IS THAT TYPE'S 64 BITS.** Under dictionary-passing the callee is
	// compiled ONCE for every instantiation at once, so it hands its result back in the general-purpose
	// register a type parameter travels in. Writing `float` onto that value tells the allocator to colour a
	// GPR-defined value into the XMM file, which is `X64Backend`'s cross-register-file assertion verbatim.
	// So this door reports the case and `emitCall` reinterprets, exactly as `emitContainerElementAccessor`
	// does at the element boundary: the same sentence, the other kind of slot.
	function typeResultThroughInstance(result ValueId, gid GenericInstanceId, scopeFilePath FilePath) returns OpaqueWordReading
		// `typeOf` panics on a void tag.
		if self.tagOf(result) == ValueTypeTag.void 'noValueToType'
			return OpaqueWordReading.asItStands
		end 'noValueToType'

		let declared = self.typeOf(result)
		let fixedByTheInstance = self.slotTypeThroughInstance(declared, gid: gid, scopeFilePath: scopeFilePath)

		if maxonTypesDenoteSame(fixedByTheInstance, b: declared) 'theInstanceFixesNothingHere'
			return OpaqueWordReading.asItStands
		end 'theInstanceFixesNothingHere'

		// ⚠ **THE GATE READS THE DECLARED SIDE AS WELL AS THE SUBSTITUTED ONE.** A `returns Items` fixes to a
		// `genericInstance` and a `returns Entry` to a tuple; neither can BECOME a float, and only a BARE type
		// parameter occupies the opaque word this rule is about. Testing `tagIsFloat(fixed)` alone would state
		// a rule about a slot KIND while checking only its contents.
		if maxonTypeTag(declared) == ValueTypeTag.typeParameter and tagIsFloat(maxonTypeTag(fixedByTheInstance)) 'aFloatRidingTheOpaqueWord'
			// The call's own result is what the ABI says it is — an i64 — which is also what makes
			// `enrolOwnedCallTemp` decline it correctly: a float owns no heap, so the descriptor-gated drop an
			// opaque tag would have enrolled is work with no effect on every trip of every loop.
			self.retypeValue(result, valueType: MaxonType.integer)
			return OpaqueWordReading.aFloatsBits(self.floatAliasThroughInstance(declared, gid: gid))
		end 'aFloatRidingTheOpaqueWord'

		self.retypeValue(result, valueType: fixedByTheInstance)

		// ⭐⭐ **A NARROW SIGNED VALUE IS RE-EXTENDED AFTER IT RIDES THE OPAQUE WORD, FOR THE FLOAT ARM'S
		// REASON ONE STEP FURTHER ON (`enum-narrow-storage`).** A shared corpus body — `Array.pop`,
		// `Array.last`, `Array.remove`, `ArrayCursor.current` — is compiled ONCE against an opaque `Element`,
		// so it cannot know the element is signed and its load sign-extends only through the record's
		// `SignedElementStampFlag`. Only the CALLER knows, because only the caller has the instance, which is
		// precisely the situation this whole function exists for.
		//
		// ⚠ It asks the SUBSTITUTED type, not the declared one, and it does NOT require `declared` to be a bare
		// type parameter the way the float arm does. A float can only ride the opaque word as an ABI
		// accident of a bare `T`; a narrow signed slot is a property of the VALUE's own type wherever it came
		// from, and `narrowSignedSlotOf`'s header carries why re-extending an already-correct value is the
		// identity rather than a risk. `fixedByTheInstance` is in THIS FILE's interner, so the question goes
		// through `narrowSignedSlotOfLocalType` — see there for the measured wrong answer the id form gave.
		match self.narrowSignedSlotOfLocalType(fixedByTheInstance) 'slot'
			fromBytes(slotBytes) then return OpaqueWordReading.aNarrowSignedSlot(slotBytes)
			notASignExtension then return OpaqueWordReading.asItStands
		end 'slot'
	end 'typeResultThroughInstance'

	// ⭐ A CALL ARGUMENT MEETS THE PARAMETER'S DECLARED RANGE. Unchecked, `clamp(101)` runs the callee
	// with `p = 101` and the body observes `p > 100` as true. A kind is a lossy projection of a type,
	// and what it drops is exactly the range.
	//
	// ⚠ **RECORDED, NOT DECIDED, and the reason is cross-file.** Every other range-check door holds the
	// declared type with its alias still on it. This one holds a callee NAME: the parameter belongs to a
	// function that may be declared in a file this one is parsed independently of, and the whole-program
	// index built before any parse (`ProgramSignatures`) carries return types, not parameter types. So the
	// site names the callee and the argument position, and `InsertRangeChecks` — which runs once, after
	// every file has merged — reads the alias back off that callee's `paramSites`.
	//
	// ⚠ **ONLY AN ARGUMENT THAT COULD BE A COMPILE-TIME CONSTANT IS RECORDED.** A call argument owes the
	// COMPILE-TIME half alone (`RangeCheckGuard`), so an argument no constant folds to has nothing a site
	// could report, and recording one would file a row per argument in the program for a check that could
	// never fire.
	//
	// ⚠⚠ **AND THE TWO DOMAINS ANSWER THAT QUESTION DIFFERENTLY, WHICH IS NOT A WART BUT A CONSEQUENCE OF
	// WHAT THE PARSER'S CONSTANT VIEW IS FOR.** `constIsKnown` is the INTEGER view — a float literal's
	// payload is stamped `ConstPayloadDomain.float` and this reader answers only for `integer` — because its
	// readers decide integer questions (a shift COUNT, a folded operand), and a float's payload is an
	// IEEE-754 bit pattern that every one of them would read as a number it is not. So a FLOAT argument is
	// recorded on its TAG alone, and `InsertRangeChecks` decides literal-ness from its own `floatConsts` map,
	// which is built from the Std `const` ops. The cost is a site per float argument rather than per float
	// LITERAL argument; float arguments are rare.
	//
	// ⚠ **THE PARSER HAS A FLOAT-DOMAIN CONSTANT VIEW (`floatConstIsKnown`), AND NARROWING THIS SITE
	// TO IT IS A QUESTION ABOUT THE TWO VIEWS, NOT ABOUT THE RANGE RULE.** ⛔ The reason that a
	// NON-literal float argument needs a site precisely SO THAT `needsRuntimeGuard` can emit its
	// RUNTIME guard is FALSE, and it is false in the direction that would break the compiler: an
	// argument site is asked as `compileTimeOnly` (`InsertRangeChecks.checkArgAgainstParamRange`), so
	// no runtime guard is EVER emitted from one, and `checkArgAgainstParamRange` PANICS if the shared
	// decider ever answers `guard` there. The argument door's runtime half is the callee's ENTRY
	// guard, and it stands in front of every caller whether or not the caller filed a site — unless
	// every path reaching the callee checks at the call, which is the one case `EntryGuardWaivers`
	// waives it. The honest reason the tag is the admission test is the paragraph above: the parser's
	// own constant view is the INTEGER one and cannot answer for a float, so the TAG is the
	// conservative filter and `InsertRangeChecks` decides literal-ness for itself from its Std-level
	// `floatConsts`. What a narrowing would cost is therefore a COMPILE-TIME E3005 on a float literal
	// the parser's float view fails to recognize — measure the two views against each other before
	// believing they agree.
	//
	// ⚠ Without the float arm, `take(500.0)` into a `float(0 to 100)` parameter compiles and is caught
	// only by the callee's own ranged `return` at RUN time.
	//
	// The anchor is the CALLEE token — `range-check-panic.error.literal-argument` pins the column, and
	// the argument's own span would move the diagnostic off the name that decides which range applies.
	function recordConstantArgRangeChecks(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token)
		// A callee no file DECLARES has no parameter list to consult — a runtime helper (`__managed_push`), or an
		// undeclared name whose own E3004 is SemanticCheck's to raise.
		if not self.signatures.declaresCallee(callee) 'noDeclaredParams'
			return
		end 'noDeclaredParams'

		for i in 0 upto args.count() 'eachArg'
			let argIndex = i as ParamCount
			let argValue = self.valueHandedThrough(try args.get(i) otherwise panic("recordConstantArgRangeChecks: args.get OOB at {i}"))
			let label = callArgumentLabel(argLabels, argIndex: argIndex)

			if valueIsMarked(self.bodyState.literalCounters, value: argValue) or self.valueHasFloatRange(argValue) 'aLiteralCounter'
				match self.signatures.parameterAliasAt(callee, argIndex: argIndex, label: label) 'parameterAlias'
					declared(alias) then self.recordLiteralCounterUse(argValue, target: alias, line: anchor.line, column: anchor.column)
					undeclared then break
				end 'parameterAlias'

				continue
			end 'aLiteralCounter'

			if not self.argMayBeACheckedConstant(argValue) 'notACheckedConstant'
				continue
			end 'notACheckedConstant'

			if self.signatures.parameterIsARangedAliasAt(callee, argIndex: argIndex, label: label) 'theParameterNamesAnAlias'
				self.admitUnsignedLiteral(argValue)
			end 'theParameterNamesAnAlias'

			self.recordConstantArgSite(argValue, parameter: ArgSiteParameter.ofCallee(callee, argIndex: argIndex, label: label), anchor: anchor)
		end 'eachArg'
	end 'recordConstantArgRangeChecks'

	function emitDirectCallOp(op MaxonOp, callee ByteArray, callResult ValueId, args ValueIdArray, argLabels NameRoster, range SourceRange)
		self.noteCallImage(callResult, callee: callee, args: args, labels: argLabels)
		self.recordCallArgumentSites(callee, callResult: callResult, args: args, argLabels: argLabels, range: range)
		self.emitBodyOp(self.bodyState.currentBlock, op: op, range: range)
	end 'emitDirectCallOp'

	function recordCallArgumentSites(callee ByteArray, callResult ValueId, args ValueIdArray, argLabels NameRoster, range SourceRange)
		if not argLabels.isEmpty() and argLabels.count() != args.count() 'labelsOutOfStep'
			panic("recordCallArgumentSites: the call to '{String.from(callee)}' carries {argLabels.count()} labels for {args.count()} arguments — a call's label list is empty or one per argument")
		end 'labelsOutOfStep'

		for i in 0 upto args.count() 'eachArg'
			let argValue = try args.get(i) otherwise panic("recordCallArgumentSites: args.get OOB at {i}")
			let label = callArgumentLabel(argLabels, argIndex: i as ParamCount)

			if not self.argIsAnIntegerQuantity(argValue) or not self.signatures.mayTakeUnsignedQuantityAt(callee, argIndex: i as ParamCount, label: label) 'noSignFloorAtThisSlot'
				continue
			end 'noSignFloorAtThisSlot'

			let target = RangeCheckSiteTarget.callArgument(callResult, argIndex: i as ParamCount, label: label, sourceMayBeNegative: not self.valueFillsAnUnsignedQuantity(argValue))
			self.recordResolvedRangeCheckSite(argValue, target: target, line: range.line, column: range.column)
		end 'eachArg'
	end 'recordCallArgumentSites'

	function argIsAnIntegerQuantity(argValue ValueId) returns bool
		let tag = self.tagOf(argValue)
		return tag == ValueTypeTag.integer or tag == ValueTypeTag.named
	end 'argIsAnIntegerQuantity'

	function recordWitnessConstantArgRangeChecks(args ValueIdArray, target WitnessDispatchTarget, anchor Token)
		for i in 0 upto args.count() 'eachArg'
			let argValue = try self.valueAWitnessFormalReceives(try args.get(i) otherwise panic("recordWitnessConstantArgRangeChecks: args.get OOB at {i}")) otherwise continue

			if not self.argMayBeACheckedConstant(argValue) 'notACheckedConstant'
				continue
			end 'notACheckedConstant'

			let parameter = try self.interfaceFormalParameterAt(target, argIndex: i as ParamCount) otherwise continue
			self.admitUnsignedLiteral(argValue)
			self.recordConstantArgSite(argValue, parameter: parameter, anchor: anchor)
		end 'eachArg'
	end 'recordWitnessConstantArgRangeChecks'

	function argMayBeACheckedConstant(argValue ValueId) returns bool
		if not (self.constIsKnown(argValue) or tagIsFloat(self.tagOf(argValue))) 'cannotBeALiteral'
			return false
		end 'cannotBeALiteral'

		// An ENUM value is a known constant since `enum-narrow-storage` and can never be checked against
		// a ranged parameter — see `argIsAnEnumValue` for why the site would be a guaranteed dead
		// allocation at every call site in every program that passes one.
		return not self.argIsAnEnumValue(argValue)
	end 'argMayBeACheckedConstant'

	function recordConstantArgSite(argValue ValueId, parameter ArgSiteParameter, anchor Token)
		self.bodyState.rangeCheckArgSites.push(RangeCheckArgSite.create(argValue, parameter: parameter, block: self.bodyState.currentBlock.id, line: anchor.line, column: anchor.column))
	end 'recordConstantArgSite'

	function interfaceFormalParameterAt(target WitnessDispatchTarget, argIndex ParamCount) returns ArgSiteParameter throws MapError
		if argIndex < WitnessReceiverArgCount 'theBorrowedReceiver'
			throw MapError.keyNotFound
		end 'theBorrowedReceiver'

		let formal = try target.paramTypes.get((argIndex - WitnessReceiverArgCount) as ElementIndex) otherwise panic("interfaceFormalParameterAt: paramTypes.get OOB at {argIndex - WitnessReceiverArgCount} — a witness dispatch carries the receiver plus one actual per formal")

		let alias = try self.signatures.requirementRangedAlias(formal, interfaceName: target.declaringInterfaceName)
		return ArgSiteParameter.slotAlias(alias.clone())
	end 'interfaceFormalParameterAt'

	// ⭐⭐ **AN ARGUMENT AT AN OPAQUE TYPE PARAMETER IS CHECKED AGAINST WHAT THE INSTANCE BOUND IT TO — AND
	// THIS DOOR OWES BOTH HALVES, BECAUSE THE CALLEE CANNOT OWE EITHER.**
	//
	// A CONCRETE ranged parameter splits the rule between two places: the caller reports a folded
	// literal (`recordConstantArgRangeChecks`, above) and the CALLEE'S ENTRY guards everything else,
	// once per narrowed parameter, in front of every caller including the indirect ones
	// (`RangeCheckParamSite`) — unless `EntryGuardWaivers` finds every caller checking at the call.
	// Neither half is available at a bare `T`. A generic body is compiled ONCE — `Box.put` is one
	// function for `Box with Percent` and `Box with Wide` alike — so the callee has no range to guard
	// and the sweep records it no `paramSite` for the caller's argument site to resolve against. The
	// CALL SITE is the only frame that knows what `T` was bound to, so it owes the whole rule.
	//
	// ⭐ **IT IS THE ORDINARY ALIAS-NAMED SITE, AND THAT IS THE POINT: NOTHING NEW DECIDES ANYTHING.**
	// `recordRangeCheckSite` is the same door the `as` cast, the field store and the array element record,
	// so `InsertRangeChecks` raises the same E3005 for a foldable literal and emits the same cascade for
	// everything else, from one decider (`guardVerdict`). A rule with a second implementation for
	// substituted parameters would be this project's signature defect — one fact written twice — in the very
	// place the first copy is already known to be incomplete.
	//
	// ⭐⭐ **AND THE GUARD LANDS EXACTLY WHERE THE CALLEE'S ENTRY GUARD WOULD HAVE STOOD.** `RangeCheckGuard`'s
	// obstacle — *"a check is a BRANCH, and a call argument is evaluated part-way through building an
	// argument list, so the guard would land PAST the call"* — is about a site recorded WHILE the list is
	// being built. This runs after the last argument is parsed and before the `call` op is emitted, so
	// `recordRangeCheckSite`'s `bodyOpCount()` is the ordinal that op is about to take and the split puts
	// the cascade immediately in FRONT of the call. Every argument has been evaluated and the callee has not
	// run: observably the entry guard's position, in the one frame that can hold it. It is the same
	// reasoning — and the same anchor arithmetic — as `requireContainerElementType`'s store guard.
	//
	// ⚠ `range-check-panic.md` promises both the compile-time and the runtime half at every position.
	// The one position exempted from the runtime half is exempt only because the callee's entry guard
	// covers it. An opaque parameter's guard is keyed on the DECLARED type, which is `T`, so here it
	// structurally cannot — there is no exemption to inherit, and `b.put(grow(5))` would otherwise
	// exit 505.
	//
	// ⚠ **THE GATES ARE ORDERED CHEAPEST-FIRST, exactly as `instanceSourceOfCall`'s are**, and for its
	// reason: almost every call in a program has neither a generic-instance receiver nor a constructed
	// instance, and that test is one dense array read. Only past it is the whole-program index probed.
	//
	// ⚠ **AN INSTANCE THAT STILL MENTIONS A TYPE PARAMETER DECLINES BY CONSTRUCTION** — a call made inside a
	// generic body on a `self` receiver is tagged with the base `structRef` and never reaches here, and a
	// partially-opaque instance substitutes to a `typeParameter`, which names no ranged alias. So the shared
	// body defers, as it must, and only a concrete instantiation is checked.
	// ⭐ **THE TWO SHAPES A GENERIC CALL TAKES, IN THE ORDER `SemanticCheck.callInstanceSubject` ASKS THEM** —
	// an instance METHOD carries its instance on argument 0, the receiver `parseCallNamed` prepended; a STATIC
	// FACTORY has no receiver and its instance is the one the caller resolved from the alias it wrote
	// (`constructorInstanceOf`), which is also what retypes its result. The receiver is asked FIRST because a
	// method's answer must be its receiver's.
	//
	// ⚠ **IT MINTS NO UNION OF ITS OWN, and that is worth the two call sites.** A single
	// "which instance, if any?" answer would be a payload-carrying union built at EVERY generic-instance
	// method call, and a Maxon union value IS a heap box — the constant factor that reverted the
	// math-intrinsic resolver one door up (`parseCallNamed`) at +2,193 allocations at the scale ladder's top
	// step. This reads the receiver's own dense tag column and re-uses the `ConstructorInstance` the CALLER
	// already holds.
	function recordOpaqueArgRangeChecks(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token, constructorInstance ConstructorInstance)
		match constructorInstance 'constructed'
			// ⚠ **THE INSTANCE THE CALL ITSELF NAMED IS ASKED FIRST, AND THE ORDER IS THE SAFE ONE.** It is
			// the ONLY answer available to a receiverless static (`PB.create(505)`, whose instance comes from
			// the alias the call wrote), and where a call carries BOTH — every method site that passes one
			// derives it with `receiverConstructorInstance(<the receiver>)` — the two are the same instance.
			// Reading the receiver first would let a RECEIVERLESS static whose first argument happens to be an
			// instance of the same base substitute against the ARGUMENT's binding instead of the constructed
			// one.
			instance(gid) then self.recordSubstitutedArgRangeChecks(gid, callee: callee, args: args, argLabels: argLabels, anchor: anchor)
			none then self.recordReceiverSubstitutedArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor)
		end 'constructed'
	end 'recordOpaqueArgRangeChecks'

	// The ordinary method call, whose instance is the receiver `parseCallNamed` prepended at argument 0 — the
	// same place `SemanticCheck.callInstanceSubject` reads it from. Two dense reads and no map probe for
	// every call in the program that has no generic-instance receiver, which is almost all of them.
	function recordReceiverSubstitutedArgRangeChecks(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token)
		if args.isEmpty() 'noReceiver'
			return
		end 'noReceiver'

		let receiver = try args.get(0) otherwise panic("recordReceiverSubstitutedArgRangeChecks: args.get(0) failed on a non-empty list")

		if self.tagOf(receiver) != ValueTypeTag.genericInstance 'concreteReceiverOnly'
			return
		end 'concreteReceiverOnly'

		self.recordSubstitutedArgRangeChecks(self.valueInstanceId(receiver), callee: callee, args: args, argLabels: argLabels, anchor: anchor)
	end 'recordReceiverSubstitutedArgRangeChecks'

	// One call's opaque arguments, once the instance is known. Each argument is slotted to its parameter
	// position through `argSlotPosition` — the ONE label→position mapping, the same one the default fill and
	// `slotCallArgs` use, so a labelled `insert(0, value: 300)` cannot be checked against a different
	// parameter than it is passed to.
	//
	// ⚠ **THE CALLEE MUST BE QUALIFIED UNDER THE INSTANCE'S OWN BASE**, `instanceSourceOfCall`'s guard and
	// for its reason: a `T` recorded against another type's `uses` list is numbered against a list that does
	// not describe this instance, so substituting through it would bind the wrong type argument. It is asked
	// HERE rather than at each of the two doors above so both arms carry it — a fact one caller could forget.
	//
	// ⚠ A by-reference argument is a CELL ADDRESS at the call, so its check reads the value loaded out of the
	// cell; checking the address itself would test a pointer against the alias's range.
	function recordSubstitutedArgRangeChecks(gid GenericInstanceId, callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token)
		if not isQualifiedUnderTypeName(callee, typeName: self.signatures.genericInstanceBaseName(gid)) 'notThisTypesMethod'
			return
		end 'notThisTypesMethod'

		let opaque = self.signatures.opaqueParamsOf(callee)

		if not opaque.declaresATypeParameterParam() 'everyParameterIsConcrete'
			return
		end 'everyParameterIsConcrete'

		let argCount = self.signatures.genericInstanceArgCount(gid)

		for i in 0 upto args.count() 'eachArg'
			let label = callArgumentLabel(argLabels, argIndex: i as ParamCount)
			let slot = try argSlotPosition(opaque.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

			// A position past the instance's own argument list is an arity the instantiation was already
			// refused for (E2056); reading it would index a list that does not describe this type.
			let position = try opaque.positionAt(slot) otherwise continue

			if position >= argCount 'boundNothingHere'
				continue
			end 'boundNothingHere'

			// ⚠ **THROUGH `resolvedSlotType`, NEVER `adoptType` ALONE** — the substituted argument comes out
			// of the INDEX's interner, and a sweep-recorded `named` leaf read against this file's interner is
			// a name id that means something else (the trap `slotTypeThroughReceiver` and
			// `requireContainerElementType` both cross through this same door).
			let substituted = self.resolvedSlotType(self.signatures.substitutedInstanceArg(gid, position: position))
			let alias = try self.rangeCheckedAliasOf(substituted) otherwise continue
			let argValue = try args.get(i) otherwise panic("recordSubstitutedArgRangeChecks: args.get OOB at {i} inside its own count()")
			let handedValue = self.argumentValueOf(argValue, anchor: anchor)
			self.recordRangedTargetSite(handedValue, target: alias, line: anchor.line, column: anchor.column)
		end 'eachArg'
	end 'recordSubstitutedArgRangeChecks'

	// ⭐⭐ **THE CALLEE AN `async` SPAWN NAMES — a FREE call's identifier, or a QUALIFIED `<Type>.<static>`.**
	// The cursor sits on the callee's first token and is left on the `(`, so the one argument reader in
	// `parseAsyncCall` serves both shapes.
	//
	// ⚠ The qualified shape is recognized on the whole `. <member> (` tail through `memberCallFollows`, the
	// predicate every other `<base> . <member> (` dispatcher reads. A LONGER chain — `async lib.inner.deep()`,
	// `async Calc.request.unionCases.bump()` — is not that shape and falls to the free reader, which reports
	// the mismatch at the `.` it cannot consume.
	function asyncSpawnCallee() returns AsyncSpawnCallee throws SourceParseError
		match try self.enterQualifiedChainAtCursor(MethodQualifierDots) 'chain'
			value then throw self.instanceSpawnRefusal(self.current())
			declaredFunction(callee, _) then return self.consumeFunctionChainAsSpawnCallee(callee)
			unqualified or
			declaredType or
			ambiguous or
			nothing then break
		end 'chain'

		if self.memberCallFollows(self.pos + 1) 'qualifiedTarget'
			return try self.qualifiedAsyncSpawnCallee()
		end 'qualifiedTarget'

		if not self.at(TokenKind.identifier) 'notCall'
			let tok = self.current()
			throw SourceParseError.unsupported("`async` must be applied to a call — `async f(…)` or `async Type.staticMethod(…)` (got '{tok.kind.rawValue}')", line: tok.line, column: tok.column)
		end 'notCall'

		let calleeTok = try self.consume(TokenKind.identifier)
		return AsyncSpawnCallee.create(self.signatures.nameABareCallBinds(calleeTok.value, readerFilePath: self.job.path), anchor: calleeTok, mint: CalleeMint.notMinted)
	end 'asyncSpawnCallee'

	// ⭐⭐ **`async <Type>.<static>(…)` — resolved through the doors `parseQualifiedCall` resolves an ordinary
	// qualified call through, and refused at every one of them that is not a plain call to a function the
	// program declares.** The cursor sits on the base and is left on the `(`.
	//
	// ⛔ **EVERY DOOR HERE ANSWERS IN WORDS; NONE MAY FALL THROUGH.** A spawn lowers to
	// `__gt_spawn(funcAddr(<callee>), …)`, so a target that is not a linked function is a link failure or a
	// wrong answer at run time rather than a diagnostic.
	function qualifiedAsyncSpawnCallee() returns AsyncSpawnCallee throws SourceParseError
		// ⛔ **AN INSTANCE SPAWN IS REFUSED, and the two claimants `parseDottedPrimary` asks first are asked
		// first here for its reason: a base bound to a VALUE claims the whole expression before any type
		// reading.** `async obj.work()` needs receiver ownership across the green-thread boundary, and a
		// classification for the receivers that are not plain calls at all — a String/array/builtin
		// receiver lowers to a runtime call and an interface receiver to a `witnessDispatch`, and neither
		// can be an `asyncCall`.
		let baseTok = self.current()

		if self.methodCallsAt(self.pos) or self.baseNamesAValueAt(self.pos) 'instanceSpawn'
			throw self.instanceSpawnRefusal(baseTok)
		end 'instanceSpawn'

		let baseIndex = self.pos
		let typeTok = try self.consumeTypeBaseToken()

		// The E3062 use hook `parseQualifiedCall` states: a `Type.method()` base NAMES a type.
		self.recordBaseTypeNameUse(baseIndex, resolved: typeTok)

		// ⛔ `async Move.walk(Direction.east)` CONSTRUCTS a union case and calls nothing. Asked exactly as
		// `parseDottedPrimary` asks it, and BEFORE the static reading for that door's reason: a payload
		// construct and a static call are the same shape to the token.
		if self.signatures.containsEnumFor(typeTok.value, readerFilePath: self.job.path) 'unionConstruct'
			throw SourceParseError.unsupported("`async {String.from(typeTok.value)}.…` — `{String.from(typeTok.value)}` is an enum or union, so `{String.from(typeTok.value)}.<case>(…)` builds a case rather than calling a function. There is nothing there for a green thread to run", line: typeTok.line, column: typeTok.column)
		end 'unionConstruct'

		let aliasName = self.genericAliasKeyFor(typeTok.value)

		let resolved = self.resolveStaticMember(typeTok, baseIndex: baseIndex, aliasName: aliasName)

		match resolved 'member'
			surface then throw self.asyncOwnedSurfaceRefusal(typeTok)
			refused(refusal, _) then throw refusal
			requirement then throw staticRequirementCalled(self.writtenSpellingOfMemberAt(self.pos + 1), typeTok: typeTok, memberTok: self.tokenAt(self.pos + 1))
			minted or
			named or
			directory then break
		end 'member'

		try self.consume(TokenKind.dot)

		// Read and consumed here rather than left to `parseCallNamed`: this reader hands the argument list to
		// `parseAsyncCall`, which emits an `asyncCall` and never reaches that door.
		let memberTok = self.current()
		self.advance()

		match resolved 'callee'
			minted(mintedCallee) then return try self.declaredStaticAsyncSpawnCallee(mintedCallee, aliasName: aliasName, typeTok: typeTok, memberTok: memberTok, mint: CalleeMint.primitiveStatic)
			named or
			directory then return try self.declaredStaticAsyncSpawnCallee(resolved.calleeToCall(), aliasName: aliasName, typeTok: typeTok, memberTok: memberTok, mint: self.staticCallHeadMint(baseIndex, typeTok: typeTok))
			surface or
			requirement or
			refused then panic("qualifiedAsyncSpawnCallee: a surface, a requirement and a refusal were thrown above")
		end 'callee'
	end 'qualifiedAsyncSpawnCallee'

	function instanceSpawnRefusal(baseTok Token) returns SourceParseError
		return SourceParseError.unsupported("`async {String.from(baseTok.value)}.…` spawns a method on a VALUE, and a spawn has no receiver: it starts a linked function by address on the argument words it is handed, and nothing carries a receiver or its ownership across the green-thread boundary. Spawn a free function or a `Type.staticMethod(…)` that takes the value as an argument", line: baseTok.line, column: baseTok.column)
	end 'instanceSpawnRefusal'

	function consumeFunctionChainAsSpawnCallee(callee immutable ByteArray) returns AsyncSpawnCallee
		let dots = self.dottedChainLengthAt(self.pos)
		let memberTok = self.tokenAt(self.pos + dots * TokensPerQualifierSegment)
		self.pos = self.pos + dots * TokensPerQualifierSegment + 1
		return AsyncSpawnCallee.create(callee, anchor: memberTok, mint: CalleeMint.notMinted)
	end 'consumeFunctionChainAsSpawnCallee'

	function requireCalleeIsASpawnableFunction(callee ByteArray, typeTok Token, memberTok Token) throws SourceParseError
		if not isBuiltinsIntrinsicCallee(callee) 'aDeclaredFunction'
			return
		end 'aDeclaredFunction'

		throw SourceParseError.unsupported("`async {String.from(typeTok.value)}.{String.from(memberTok.value)}(…)` — `{String.from(callee)}` is a runtime intrinsic the compiler lowers in place, so it names no function a green thread could start at; call it directly, or spawn a function that calls it", line: memberTok.line, column: memberTok.column)
	end 'requireCalleeIsASpawnableFunction'

	// ⛔ **A COMPILER-OWNED STATIC IS NOT A SPAWN TARGET, and the surfaces share ONE refusal because
	// they share one reason:** each lowers to a runtime entry the compiler emits (`__mf_read_all`,
	// `__managed_create`, an `Array` create op) rather than to a function the program declares, while a spawn
	// hands the scheduler the ADDRESS of a linked function. The roster is `compilerOwnedStaticSurface`'s, so
	// a surface added there is refused here without this reader learning it exists.
	function asyncOwnedSurfaceRefusal(typeTok Token) returns SourceParseError
		return SourceParseError.unsupported("`async {String.from(typeTok.value)}.…` — a static on this type is served by a runtime entry the compiler emits rather than by a function the program declares, and a spawn hands the scheduler the ADDRESS of a linked function. Call it directly, or spawn a function of your own that wraps it", line: typeTok.line, column: typeTok.column)
	end 'asyncOwnedSurfaceRefusal'

	// ⛔ **A GENERIC-INSTANCE CONSTRUCTOR (`StrBox.create(s)`) IS REFUSED.** An ordinary call retypes its
	// result to the instance the alias fixes (`retypeGenericAliasConstructorResult`); a spawn's result is the
	// PROMISE, whose argument comes from the callee's DECLARED return
	// (`internPromiseInstanceForCallee`) — the generic BASE. There is no promise-side substitution to make,
	// so the await would hand back a value at the base type.
	function declaredStaticAsyncSpawnCallee(callee immutable ByteArray, aliasName ByteArray, typeTok Token, memberTok Token, mint CalleeMint) returns AsyncSpawnCallee throws SourceParseError
		try self.requireCalleeIsNotRawSurface(callee, anchor: memberTok)
		try self.requireCalleeIsASpawnableFunction(callee, typeTok: typeTok, memberTok: memberTok)

		match self.constructorInstanceOf(aliasName) 'constructed'
			none then return AsyncSpawnCallee.create(callee, anchor: memberTok, mint: mint)
			instance then throw SourceParseError.unsupported("`async {String.from(typeTok.value)}.{String.from(memberTok.value)}(…)` — `{String.from(typeTok.value)}` names a generic INSTANCE, and the promise a spawn mints is typed from the callee's declared return, which names the generic base rather than the instance this alias fixes. Awaiting it would hand back a value at the wrong type. Call it directly", line: memberTok.line, column: memberTok.column)
		end 'constructed'
	end 'declaredStaticAsyncSpawnCallee'

	// ⭐ **`async f(args…)` / `async Type.staticMethod(args…)` — SPAWN A GREEN THREAD**. The cursor
	// sits just past `async`, on the callee's first token. The argument grammar and `name:` label rules are
	// `parseCallArgs`, shared with an ordinary call, so a labelled async argument slots exactly as a plain one
	// does.
	//
	// ⭐⭐ **A QUALIFIED TARGET IS A `static`, AND ONLY A `static`** — `async File.readText(p)`,
	// `async Subprocess.run(exe, arguments: argv)`. `parseQualifiedCall`'s own header says why that is cheap:
	// a static call *"is an ORDINARY call with a mangled name … A static method has no receiver, so there is
	// nothing else to pass"*, so everything downstream of the name — the promise mint, the yield check, the
	// releaser, the lowering — is name-keyed and needs nothing new. An INSTANCE spawn is refused in words by
	// `asyncSpawnCallee`; see there for what it would take.
	function parseAsyncCall(func IrFunction) returns ValueId throws SourceParseError
		try self.requireNoWaitInsideWindow(self.tokenAt(self.pos - 1))

		// ⭐ The first token of the spawn — the `async` KEYWORD, which the sole caller consumed immediately
		// before dispatching here (`parseUnary`'s `async` arm). E3073 quotes the whole spawn, keyword
		// included (`'async heavyCompute(5)'`), and this is the only point at which its text still exists
		// — see `Project.asyncSpawnSites` for why nothing downstream can reconstruct it.
		let spawnStart = self.pos - 1

		let target = try self.asyncSpawnCallee()
		try self.consume(TokenKind.leftParen)

		let args = ValueIdArray.create(0)
		let argLabels = NameRoster.create(0)
		let argRanges = SourceRangeArray.create(0)
		let argImmutableNames = NameRoster.create(0)

		// Read by the hand-off (`transferThreadArguments`), which blames a refused argument at its own
		// token.
		let argAnchors = TokenIndexArray.create(0)

		// `firstNamedIfDefaulted`, unconditionally: an `async` call always emits a real `MaxonOp.call` to
		// a declared function, so its callee always has parameter names — no bare builtin is reachable
		// through this door, and the positional-argument regime would be answering for a callee that
		// cannot arrive here.
		_ = try self.parseCallArgs(func, target: CallArgTarget.coroutine(target.name), anchor: target.anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, rule: ArgLabelRule.firstNamedIfDefaulted)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let callee = try self.genericInstanceCallee(target.name, anchor: target.anchor, args: args, argLabels: argLabels, mint: target.mint)
		try self.requireFirstArgLabelHasDefault(callee, firstParam: 0, argLabels: argLabels, argRanges: argRanges, receiverArgs: 0)

		_ = try self.checkCallCapabilities(func, callee: callee, args: args, argAnchors: argAnchors, argLabels: argLabels, receiver: ReceiverArg.none, anchor: target.anchor, spawning: CallSpawning.spawned)

		// `self.pos` now sits one PAST the `)`, which is exactly `tokenTextFrom`'s exclusive end. The POSITION is
		// the `async` keyword's, so E3073's caret lands on the first character of the text it quotes.
		let asyncTok = self.tokenAt(spawnStart)
		let spawnSite = AsyncSpawnSite.create(freeze self.tokenTextFrom(spawnStart, endIndex: self.pos).toByteArray(), line: asyncTok.line, column: asyncTok.column)

		self.bodyState.emittedCall = EmittedCallOp.none
		let spawned = try self.emitAsyncCall(target.name, callee: callee, anchor: target.anchor, mint: target.mint, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, rparenTok: rparenTok, spawnSite: spawnSite)

		let spawnedOp = try self.bodyState.emittedCall.opIndex() otherwise panic("parseAsyncCall: emitAsyncCall returned without emitting its asyncCall op")

		self.fileCallNotes(func, opIdx: spawnedOp, args: args, argAnchors: argAnchors, stored: StoredSlotArgArray.create(0), receiver: ReceiverArg.none, anchor: target.anchor, callOpen: PendingCallOpen.none)

		self.noteTiedAsync(func, opIdx: spawnedOp, args: args, promise: spawned)
		return spawned
	end 'parseAsyncCall'

	function lendCellsToTheCoroutine(cells ParamPositionMask, argAnchors TokenIndexArray, promise ValueId, anchor Token) throws SourceParseError
		if cells == NoParamPositions 'nothingIsLent'
			return
		end 'nothingIsLent'

		let table = self.regionFactsForWrite()

		for column in 0 upto argAnchors.count() 'eachArgument'
			if not maskHasParam(cells, param: column as ParamCount) 'notACell'
				continue
			end 'notACell'

			let rootTok = self.tokenAt(try argAnchors.get(column) otherwise panic("lendCellsToTheCoroutine: argAnchors.get OOB at {column}"))
			let root = rootTok.value

			if not self.bodyState.scope.contains(root) or self.bodyState.scope.isSelfField(root) 'notALocalRoot'
				throw SourceParseError.unsupported("an `async` call takes only a local variable by reference, and '{String.from(root)}' is not one: the coroutine writes it while the caller is free to run, and only a local can be lent until the promise is awaited. Copy it into a local `var`", line: rootTok.line, column: rootTok.column)
			end 'notALocalRoot'

			table.lentLocals.push(LentLocal.create(self.bodyState.scope.getInfo(root), promise: promise, line: anchor.line, column: anchor.column))
		end 'eachArgument'
	end 'lendCellsToTheCoroutine'

	function requireNotLentToACoroutine(binding VarInfo, nameTok Token) throws SourceParseError
		let table = self.regionFactsForRead()

		for lent in table.lentLocals 'eachLend'
			if lent.binding is binding and self.bodyState.promiseConsumes.kindOf(lent.promise) == PromiseConsume.notConsumed 'stillLent'
				throw self.regionRefusal(ErrorCode.useAfterMove, message: "use of moved value '{String.from(nameTok.value)}': it is lent to the coroutine of the `async` call at {lent.line}:{lent.column} until that promise is awaited or cancelled", line: nameTok.line, column: nameTok.column)
			end 'stillLent'
		end 'eachLend'
	end 'requireNotLentToACoroutine'

	function valueCrossesToACoroutine(value ValueId) returns bool
		return self.valueIsAValueType(value) or self.valueIsAServiceHandle(value) or self.signatures.isSharedValueInstanceAt(self.tagOf(value), nameId: self.valueNameId(value)) or self.valueIsCleanInput(value)
	end 'valueCrossesToACoroutine'

	function noteTiedAsync(func IrFunction, opIdx ElementIndex, args ValueIdArray, promise ValueId)
		var sharesMutableData = false

		for position in 0 upto args.count() 'eachArg'
			let arg = try args.get(position) otherwise panic("noteTiedAsync: args.get OOB at {position} below the count just read")

			if not self.valueCrossesToACoroutine(arg) or valueIsMarked(self.bodyState.argumentStorage, value: arg) 'sharesTheCallersRegion'
				sharesMutableData = true
			end 'sharesTheCallersRegion'
		end 'eachArg'

		if not sharesMutableData 'untied'
			return
		end 'untied'

		self.notesForWrite(func).tiedAsyncOps.push(opIdx)
		self.bodyState.tiedPromises = withValueMarked(self.bodyState.tiedPromises, value: promise)
	end 'noteTiedAsync'

	// Mint the Promise handle an `async` spawn defines and emit the `asyncCall` op. The spawn is SCALAR ONLY: the
	// trampoline passes arguments through the GPR arg registers and captures the result from R8, so a
	// managed/float ARGUMENT or a managed/float RESULT is REFUSED here (E2015) rather than leaked or
	// miscompiled. The callee's PARAMETER types are checked by SemanticCheck, which alone holds the resolved
	// signature.
	//
	// ⭐⭐ **THE PROMISE IS BORN AT ITS OWN TYPE — `Promise with T` / `Promise with (T, E)`, the instance
	// `internPromiseInstanceForCallee` interns off the callee.** The handle's runtime value is an i64
	// (the spawned GT's pointer, whatever the awaited result type is) and lowers as one word; the i64 is
	// its REPRESENTATION rather than its TYPE.
	//
	// ⛔⛔ **IT IS NOT TAGGED `integer`, BECAUSE THAT IS A WRONG ANSWER WEARING A DESIGN NOTE.** Tagging the
	// handle with the AWAITED SCALAR makes a
	// void async's handle void-tagged, and `let p = async voidFn()` cannot bind a tag that names no value.
	// But "not the awaited scalar" does not imply "the machine word": a value carrying its representation as
	// its type is accepted everywhere that representation is accepted, and nothing is left to object.
	// MEASURED with the handle tagged `integer`: `function grab() returns Integer { return async plain() }` compiled and printed the
	// green thread's raw address; `p + 1` was pointer arithmetic; `p.clone()` handed out a second owner of a
	// thread exactly one owner may reclaim; and an `Integer` parameter took a promise. The third argument in
	// the void chain is `PromiseVoidResultName`, which fills the result position when there is no result —
	// so a void spawn binds, and does so as a `Promise`.
	//
	// ⭐ **THE REFUSALS ARE THEREFORE DERIVED, NOT ENUMERATED.** Every position that wants an `Integer`
	// already knows how to refuse something that is not one, so there is no roster of promise-misuse
	// positions to keep in step with the language — which is the property a roster can never have.
	// `await`/`try await` recover the awaited result type from the handle's `Promise` instance.
	function spawnedCalleeConventions(callee ByteArray, writtenCallee ByteArray) returns ByRefConventionArray
		if callee.equals(writtenCallee) 'notAnInstance'
			return self.byRefConventionsReachableFrom(callee)
		end 'notAnInstance'

		let site = try self.requestedInstanceSiteKey(callee) otherwise panic("Parser.spawnedCalleeConventions: '{String.from(callee)}' is the instance `genericInstanceCallee` just requested, and no request names it")
		let conventions = ByRefConventionArray.create(1, zeroed: false)
		conventions.push(self.signatures.byRefOfDeclaration(site).clone())
		return conventions
	end 'spawnedCalleeConventions'

	function spawnFactoryArgumentBlames(callee ByteArray, writtenCallee ByteArray, argLabels NameRoster, count ElementIndex) returns SpawnArgumentBlameArray
		let blames = SpawnArgumentBlameArray.create(count, zeroed: false)
		let params = self.spawnFactoryParams(writtenCallee)

		for column in 0 upto count 'eachArg'
			match params 'params'
				unbound then blames.push(serviceFactoryArgumentOrdinalBlame(callee, column: column as ParamCount))
				declared(names) then blames.push(self.declaredSpawnArgumentBlame(callee, names: names, argLabels: argLabels, column: column as ParamCount))
			end 'params'
		end 'eachArg'

		return blames
	end 'spawnFactoryArgumentBlames'

	function declaredSpawnArgumentBlame(callee ByteArray, names NameRoster, argLabels NameRoster, column ParamCount) returns String
		let position = try argSlotPosition(names, argIndex: column, label: callArgumentLabel(argLabels, argIndex: column)) otherwise return serviceFactoryArgumentOrdinalBlame(callee, column: column)
		let named = try names.get(position) otherwise panic("declaredSpawnArgumentBlame: names.get OOB at {position} — `argSlotPosition` answers a position inside the roster it was given")
		return serviceFactoryArgumentBlame(callee, paramName: named)
	end 'declaredSpawnArgumentBlame'

	function spawnFactoryParams(writtenCallee ByteArray) returns SpawnFactoryParams
		let decl = try self.signatures.sweptDeclarationOf(writtenCallee) otherwise return SpawnFactoryParams.unbound

		return SpawnFactoryParams.declared(decl.paramNames.clone())
	end 'spawnFactoryParams'

	function emitServiceSpawnOp(launch ServiceSpawnLaunch, spawnTok Token, writtenCallee immutable ByteArray, callee immutable ByteArray, state ValueId, anchor Token, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, rparenTok Token, mint CalleeMint, constructed ConstructorInstance, inferInstanceOf FactoryInference) returns ValueId throws SourceParseError
		try self.requireSpawnArgumentsRideTheStartRecord(callee, args: args, anchor: anchor)

		let argAnchors = TokenIndexArray.create(argRanges.count(), zeroed: false)

		for range in argRanges 'eachRange'
			argAnchors.push(self.argumentFirstTokenIndex(range))
		end 'eachRange'

		let blames = argImmutableNames.clone()
		try self.transferThreadArguments(callee, doors: ThreadArgumentDoors.factory(self.spawnFactoryArgumentBlames(callee, writtenCallee: writtenCallee, argLabels: argLabels, count: args.count())), args: args, argImmutableNames: blames, argAnchors: argAnchors, cells: NoParamPositions, anchor: anchor)
		self.releaseHandOffBuildTemps(launch.tempFloor, ownedFloor: launch.ownedFloor, handedOff: ValueIdArray.create(0), anchor: anchor)

		if inferInstanceOf.isOf() 'aSpawnFactory'
			match constructed 'inferred'
				none then break
				instance(gid) then self.stampInferredFactoryResult(state, gid: gid)
			end 'inferred'
		end 'aSpawnFactory'

		self.recordConstantArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor)
		self.recordOpaqueArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor, constructorInstance: constructed)
		let startReplies = self.noteSpawnStartReply(launch.cown, callee: callee)
		let spawnSpan = SourceRange.between(spawnTok, last: rparenTok)
		self.bodyState.emittedCall = EmittedCallOp.at(self.artifact.module.ops.count())
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.serviceSpawn(launch.cown, typeName: launch.typeName, state: state, capacity: launch.capacity, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: blames, mint: mint, startReplies: startReplies), range: spawnSpan)
		return state
	end 'emitServiceSpawnOp'

	// Called after `releaseHandOffBuildTemps`: the cell is enrolled here as an owned promise, and a
	// release of the hand-off's temporaries that ran later would drain it.
	function noteSpawnStartReply(cell ValueId, callee ByteArray) returns bool
		if not throwsClauseIsThrowing(self.signatures.throwsOf(callee)) 'startsAtOnce'
			self.statement.lastSpawnStart = SpawnStartReply.noReply
			return false
		end 'startsAtOnce'

		self.markValuePromise(cell)
		self.bodyState.pendingTempDrops.push(cell)
		self.statement.lastSpawnStart = SpawnStartReply.viaCell(callee)
		return true
	end 'noteSpawnStartReply'

	function requireSpawnArgumentsRideTheStartRecord(callee ByteArray, args ValueIdArray, anchor Token) throws SourceParseError
		for column in 0 upto args.count() as ParamCount 'eachArg'
			let value = try args.get(column) otherwise panic("requireSpawnArgumentsRideTheStartRecord: args.get OOB at {column}")

			if not tagRidesAsyncArgumentChannel(self.rangedAliasResolvedTag(self.tagOf(value), nameId: self.valueNameId(value))) 'unfittableArg'
				throw SourceParseError.unsupported("argument {column + 1} of `spawn {String.from(callee)}(…)` is held at an opaque type parameter, which the service's start record cannot carry: it is released through a layout descriptor the record does not hold. Spawn from a function of a concrete type", line: anchor.line, column: anchor.column)
			end 'unfittableArg'
		end 'eachArg'
	end 'requireSpawnArgumentsRideTheStartRecord'

	function emitAsyncCall(writtenCallee ByteArray, callee ByteArray, anchor Token, mint CalleeMint, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, rparenTok Token, spawnSite AsyncSpawnSite) returns ValueId throws SourceParseError
		try self.requireCalleeIsNotRawSurface(writtenCallee, anchor: anchor)
		try self.requireCalleeIsNotReservedName(callee, anchor: anchor, mint: mint)

		// ⭐ **AN OMITTED ARGUMENT IS SUPPLIED AT THIS DOOR TOO** — the SECOND of the two
		// source call doors, so `async f()` against `function f(n Integer = 1)` is the same legal call
		// `f()` is. It sits BEFORE the scalar check on purpose: the helper's result is an ordinary value and
		// must meet the async argument rule exactly as a written argument does, so a MANAGED default earns
		// the existing refusal below rather than a second one worded here.
		let defaultedArgs = try self.fillOmittedArgDefaults(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, receiverSlots: NoReceiverSlots)
		self.stampDefaultsSubject(callee, args: args, argLabels: argLabels, defaultedArgs: defaultedArgs, receiverSlots: NoReceiverSlots, constructorInstance: ConstructorInstance.none)
		try self.requireHandedCellsHaveTheInstancesTypes(writtenCallee, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges)
		let conventions = self.spawnedCalleeConventions(callee, writtenCallee: writtenCallee)
		var cells = NoParamPositions

		for i in 0 upto args.count() 'eachArg'
			let argValue = try args.get(i) otherwise panic("emitAsyncCall: args.get OOB at {i} — args are pushed in lockstep by parseCallArgs")
			let passing = argumentPassingAt(conventions, argIndex: i as ParamCount, label: callArgumentLabel(argLabels, argIndex: i as ParamCount))

			if self.valueIsLinear(argValue) 'aLinearArgument'
				throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "an `async` call takes no linear argument: a coroutine that cannot start drops the value it was given, and a linear value is consumed exactly once", line: anchor.line, column: anchor.column)
			end 'aLinearArgument'

			if passing == ArgumentPassing.byReference 'theCoroutineGetsTheCallersCell'
				cells = maskWithParam(cells, param: i as ParamCount)
			end 'theCoroutineGetsTheCallersCell'

			if asyncArgumentMayRideInACell(passing, argTag: self.tagOf(argValue)) 'theCellIsOneWord'
				continue
			end 'theCellIsOneWord'

			// Through `rangedAliasResolvedTag`, for `requireAsyncResult`'s reason mirrored onto the argument
			// side: a value of a ranged-int alias type carries tag `named` with its alias name in the parallel
			// name column, so the bare tag cannot tell `Integer` from a `String`. `let r1 = await p1` produces
			// exactly such a value, and `async step(r1)` — the whole shape of `specs/async-await.md`'s
			// `sequence` — passes an argument that is an ordinary i64.
			if not tagRidesAsyncArgumentChannel(self.rangedAliasResolvedTag(self.tagOf(argValue), nameId: self.valueNameId(argValue))) 'unfittableArg'
				throw SourceParseError.unsupported("an `async` call argument held at an opaque type parameter cannot be spawned: it is released through a layout descriptor the green-thread struct does not carry. Spawn a function of a concrete type, or call it directly", line: anchor.line, column: anchor.column)
			end 'unfittableArg'
		end 'eachArg'

		let lent = self.lentColumns(args, argAnchors: argAnchors, cells: cells, anchor: anchor)

		// ⭐⭐ **THE GREEN THREAD IS A DURABLE SINK, SO THE SPAWN HANDS IT ITS OWN REFERENCE.** Runs AFTER
		// both gates, so only arguments that fit the channel are ever transferred — and after
		// `fillOmittedArgDefaults`, so a MANAGED default is transferred exactly as a written argument is.
		try self.handIsolatedAsyncArguments(callee, args: args, argLabels: argLabels, argRanges: argRanges, cells: cells, anchor: anchor)
		try self.transferThreadArguments(callee, doors: ThreadArgumentDoors.coroutine, args: args, argImmutableNames: argImmutableNames, argAnchors: argAnchors, cells: cells, anchor: anchor)

		let result = match self.boundReturnOf(callee) 'spawned'
			declared(returnType, scopeFilePath) gives try self.spawnAtItsPromiseInstance(callee, returnType: returnType, scopeFilePath: scopeFilePath, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor)
			undeclared gives self.mintDeferredValue()
		end 'spawned'

		self.markValuePromise(result)

		// ⭐ The spawn OWNS a green thread. Enrol it as a statement-scoped pending temporary,
		// exactly as `trackOwnedTemp` enrols an interpolation result: `parseBinding` transfers it to
		// `ownedBindings` when bound (`let p = …`), `emitAwaitOp` clears it when consumed (`await async f()`),
		// and an UNBOUND, UNAWAITED spawn (`async f()` as a bare statement) is dropped at statement end
		// through `drainPendingTemps` — so no spawn path can leak its thread.
		self.bodyState.pendingTempDrops.push(result)
		try self.lendCellsToTheCoroutine(lent, argAnchors: argAnchors, promise: result, anchor: anchor)

		if self.asyncArgumentsAreChecked(callee, args: args, argLabels: argLabels, anchor: anchor) 'theQuantityDoorIsKept'
			self.markCallChecked(result)
		end 'theQuantityDoorIsKept'

		// Immediately before the emit, so the site keys the op that emit is about to append.
		self.artifact.recordAsyncSpawnSite(spawnSite)
		self.bodyState.emittedCall = EmittedCallOp.at(self.artifact.module.ops.count())
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.asyncCall(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: settledImmutableArgNames(argImmutableNames), mint: mint), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'emitAsyncCall'

	// The result gate and the minted instance are asked of one callee, so what is checked is what is awaited.
	function spawnAtItsPromiseInstance(callee ByteArray, returnType MaxonReturnType, scopeFilePath FilePath, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, anchor Token) returns ValueId throws SourceParseError
		try self.requireAsyncResult(callee, returnType: self.repairSweptReturnType(returnType, scopeFilePath: scopeFilePath), anchor: anchor)
		try self.requireAsyncResultIsNotLinear(returnType, scopeFilePath: scopeFilePath, anchor: anchor)

		try self.transferAsyncPromiseArgs(callee, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor)

		return self.mintSpawnPromise(callee)
	end 'spawnAtItsPromiseInstance'

	function requireAsyncResultIsNotLinear(returnType MaxonReturnType, scopeFilePath FilePath, anchor Token) throws SourceParseError
		let resultType = try valueTypeOfReturn(self.repairSweptReturnType(returnType, scopeFilePath: scopeFilePath)) otherwise return

		if self.signatures.valueIsLinear(maxonTypeTag(resultType), nameId: typeNameIdOf(resultType), from: self.artifact.typeNames) 'aLinearResult'
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "an `async` call of a function that returns a linear value is refused: the promise would hold a linear value, and nothing may be left to drop it", line: anchor.line, column: anchor.column)
		end 'aLinearResult'
	end 'requireAsyncResultIsNotLinear'

	function mintSpawnPromise(callee ByteArray) returns ValueId
		let promise = self.signatures.internPromiseInstanceForCallee(callee)

		return self.mintValue(ValueTypeTag.genericInstance, nameId: promise as TypeNameId)
	end 'mintSpawnPromise'

	// Refuse an `async callee(…)` whose awaited result has no GPR channel (`tagRidesAsyncGprChannel`).
	// It asks `asyncCarriedResultTag`, not the raw tag: `returnTypeOf` answers before alias
	// resolution, so a ranged int alias arrives as the same `named` a `String` and a struct do. Void
	// passes: the awaiter discards a void async's R8.
	function requireAsyncResult(callee ByteArray, returnType MaxonReturnType, anchor Token) throws SourceParseError
		let resultTag = self.asyncCarriedResultTag(returnType)

		if resultTag != ValueTypeTag.void and not tagRidesAsyncGprChannel(resultTag) 'unfittableResult'
			throw SourceParseError.unsupported("`async {String.from(callee)}(…)` must return a value the green thread can carry in R8, or void — a `float` result is returned in XMM0, which the hand-assembled trampoline never captures, and a result held at an interface type or an opaque type parameter is released through a companion the green-thread struct does not carry. A managed String/struct/array result is accepted: it is one heap pointer, and the await takes the thread's reference", line: anchor.line, column: anchor.column)
		end 'unfittableResult'
	end 'requireAsyncResult'

	// ⭐⭐ **HAND THE GREEN THREAD ITS OWN REFERENCE TO EVERY MANAGED ARGUMENT** — the spawn-site half
	// of the ownership pair whose other half is `__gt_release_<callee>`
	// (`Runtime/AsyncReleaser.maxon`), or for a `spawn`'s factory the start thunk that releases its
	// record.
	//
	// ⚠ **WITHOUT IT THE ARGUMENT IS FREED BEFORE THE THREAD RUNS.** A spawn does not call its callee; it
	// ENQUEUES one. The spawning statement then ends, this frame's scope-exit drop releases the argument, and
	// the trampoline later loads a dangling pointer out of the argument buffer — a use-after-free
	// whose symptom is a SIGSEGV inside `__gt_trampoline` once allocator churn puts the freed slot back in
	// play, which is exactly what `specs/async-await.md`'s `managed-args-many` is a regression guard for.
	//
	// A factory's arguments come through the factory door, which proves each graph as a message's door
	// does (`handOffProvesItsGraph`).
	//
	// ⭐ **FOR AN `async` CALL IT IS `handOff` THROUGH THE COROUTINE DOOR.** A temporary is MOVED —
	// drained from the pending temporaries — and anything else, a named binding included, takes a
	// reference of its own through `transferConsumedArg`, the door an ordinary consuming call comes
	// through, so the caller still reads what it passed: a parameter co-owns, and a BORROWED String —
	// an `.rdata` literal, a borrowed parameter — is PROMOTED to a fresh owned record, because
	// increfing an immortal literal writes into read-only memory.
	//
	// ⚠ **IT TRANSFERS EVERY MANAGED ARGUMENT, NOT ONLY THE DECLARED-CONSUMED ONES**, which is where it
	// departs from `transferConsumedArgs`: an ordinary call's BORROWED argument needs no transfer because the
	// caller's frame provably outlives the call, and a spawn's provably does not. The declared-consume bits
	// therefore say nothing here. A parameter the callee takes is released by the releaser only for a thread
	// that never ran (`AsyncReleasePlan.consumedArgSlots`), and a promise the callee takes is moved by
	// `transferAsyncPromiseArgs`.
	//
	// The RESULT replaces the argument, for `transferConsumedArgs`' reason: a promoted borrowed String is a
	// DIFFERENT record, and it is the one the thread's arguments must carry.
	function transferThreadArguments(callee immutable ByteArray, doors ThreadArgumentDoors, args ValueIdArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, cells ParamPositionMask, anchor Token) throws SourceParseError
		let handed = HandedOffArgumentArray.create(0)

		for i in 0 upto args.count() 'eachArgument'
			if maskHasParam(cells, param: i as ParamCount) 'theCallersCellStaysItsOwn'
				continue
			end 'theCallersCellStaysItsOwn'

			handed.push(HandedOffArgument.create(i, value: try args.get(i) otherwise panic("transferThreadArguments: args.get OOB at {i}"), anchor: self.handOffArgumentAnchor(argAnchors, index: i, fallback: anchor), door: doors.doorAt(callee, column: i)))
		end 'eachArgument'

		let plans = try self.handOffArguments(handed, args: args)

		for plan in plans 'eachHandedOver'
			let position = plan.argument.position

			if handOffTakeEndsTheWriteBlame(plan.take) and position < argImmutableNames.count() 'theBindingIsNoLongerTheCallers'
				try argImmutableNames.set(position, value: EmptySourceText) otherwise panic("transferThreadArguments: argImmutableNames.set OOB at {position} below its own count")
			end 'theBindingIsNoLongerTheCallers'
		end 'eachHandedOver'
	end 'transferThreadArguments'

	// Unlike an ordinary call, which leaves the hand-over to the declaration it binds, a
	// spawn moves the promise now or refuses it: the coroutine can outlive this frame, so a declaration that
	// only reads the promise would read a thread this frame reclaims. The E3141 waits for the loop, so a
	// promise also handed to a taking parameter is E3102 at its second argument, as
	// `specs/async-promise-drop.md` pins.
	function transferAsyncPromiseArgs(callee ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, anchor Token) throws SourceParseError
		let promiseColumns = ParamCountArray.create(0)

		for column in 0 upto args.count() as ParamCount 'eachArg'
			if self.argumentHoldsAPromise(try args.get(column) otherwise panic("transferAsyncPromiseArgs: args.get OOB at {column}")) 'aPromiseTravels'
				promiseColumns.push(column)
			end 'aPromiseTravels'
		end 'eachArg'

		if promiseColumns.isEmpty() 'noPromiseTravels'
			return
		end 'noPromiseTravels'

		let declaration = self.declarationFactsBoundBy(callee)
		let borrowedColumns = ParamCountArray.create(0)

		for column in promiseColumns 'eachPromiseColumn'
			let argValue = try args.get(column) otherwise panic("transferAsyncPromiseArgs: args.get OOB at {column}")

			if not self.declarationTakesArgument(declaration, column: column, label: callArgumentLabel(argLabels, argIndex: column), argValue: argValue, constructorInstance: ConstructorInstance.none) 'theDeclarationOnlyReadsIt'
				borrowedColumns.push(column)
				continue
			end 'theDeclarationOnlyReadsIt'

			if self.valueIsPromise(argValue) 'aPromiseItself'
				try self.takePromiseIntoCallee(argValue, column: column, args: args, argRanges: argRanges, anchor: anchor)
			end 'aPromiseItself'
		end 'eachPromiseColumn'

		let borrowed = try borrowedColumns.get(0) otherwise return
		let range = try argRanges.get(borrowed) otherwise panic("transferAsyncPromiseArgs: argRanges.get OOB at {borrowed} — args and argRanges are pushed in lockstep")
		let cure = AsyncPromiseBorrowCure if self.valueIsPromise(try args.get(borrowed) otherwise panic("transferAsyncPromiseArgs: args.get OOB at {borrowed}")) else AsyncPromiseHolderBorrowCure
		throw SourceParseError.promiseCannotBeBorrowed(String.from(anchor.value), cure: cure, line: range.line, column: range.column)
	end 'transferAsyncPromiseArgs'

	function argumentHoldsAPromise(value ValueId) returns bool
		if self.valueIsPromise(value) 'aPromise'
			return true
		end 'aPromise'

		if not self.valueIsManagedHeap(value) 'aWordHoldsNone'
			return false
		end 'aWordHoldsNone'

		return self.signatures.transferSubjectHoldsAPromise(transferSubjectOf(self.tagOf(value), nameId: self.valueNameId(value), typeNames: self.artifact.typeNames))
	end 'argumentHoldsAPromise'

	function handOffArgumentAnchor(argAnchors TokenIndexArray, index ElementIndex, fallback Token) returns Token
		if index >= argAnchors.count() 'aSuppliedDefault'
			return fallback
		end 'aSuppliedDefault'

		return self.tokenAt(try argAnchors.get(index) otherwise panic("handOffArgumentAnchor: argAnchors.get OOB at {index} below its own count"))
	end 'handOffArgumentAnchor'

	function argumentMovesOut(value ValueId) returns bool
		if not self.valueIsOwnedHeap(value) or self.valueIsOpaqueOwned(value) 'notThisFramesToGive'
			return false
		end 'notThisFramesToGive'

		return self.ownedValueLeavesThisFrame(value)
	end 'argumentMovesOut'

	function ownedValueLeavesThisFrame(value ValueId) returns bool
		let owner = try self.liveOwnerIndexOf(value) otherwise return self.pendingTempsContain(value)
		let binding = try self.bodyState.ownedBindings.get(owner) otherwise panic("ownedValueLeavesThisFrame: ownedBindings.get OOB at {owner} — the index came from `liveOwnerIndexOf`")
		return (not binding.isParameter or self.valueIsAnOwnedIsolatedLocal(value)) and not binding.isSelfField
	end 'ownedValueLeavesThisFrame'

	function moveOwnedValueOut(value ValueId)
		self.poisonMoveSource(value)
		self.removeFromPendingTemps(value)
	end 'moveOwnedValueOut'

	function takeCellOccupant(read CellOccupantRead, value ValueId, range SourceRange)
		let binding = read.binding
		let current = binding.cellEpoch.epochValue()

		if read.epoch != current 'theCellWasStoredSinceTheRead'
			panic("takeCellOccupant: v{value} was read out of `{String.from(binding.name)}`'s cell at epoch v{read.epoch} and the cell is now at epoch v{current} — a take consumes the read it follows, and no store into the cell can fall between the two")
		end 'theCellWasStoredSinceTheRead'

		self.storeCellOccupant(binding.boundValue, cellType: binding.varType, value: self.emitStringLiteral(EmptySourceText, range: range), range: range)
		binding.setMovedFrom(true, ledger: self.bodyState.moveLedger)
		forgetCellOccupantRead(self.bodyState.cellOccupantReads, occupant: value)
		self.markValueOwnsHeap(value, exclusivity: OwnedHeapExclusivity.sole if self.cellEpochExclusivityOf(read.epoch) == CellOccupantExclusivity.sole else OwnedHeapExclusivity.coOwned)
	end 'takeCellOccupant'

	function cellOccupantTakeOf(value ValueId) returns CellOccupantTake
		let read = try cellOccupantReadOf(self.bodyState.cellOccupantReads, occupant: value) otherwise return CellOccupantTake.notACellOccupant
		let binding = read.binding

		if not self.cellOccupantMoves(binding, value: value) 'theCellKeepsIt'
			return CellOccupantTake.notACellOccupant
		end 'theCellKeepsIt'

		// A stale epoch means a by-reference hand-over fell between the read and the take. A callee that
		// writes is refused by E3186; one that reads takes the ordinary path (a `String` becomes an owned
		// copy), because the callee may have kept a reference to the old occupant.
		if read.epoch != binding.cellEpoch.epochValue() 'theCellMayHoldAnotherOccupantNow'
			return CellOccupantTake.notACellOccupant
		end 'theCellMayHoldAnotherOccupantNow'

		return CellOccupantTake.takeable(read)
	end 'cellOccupantTakeOf'

	function takeableCellOccupantOf(value ValueId) returns CellOccupantRead throws AbsentError
		match self.cellOccupantTakeOf(value) 'cell'
			notACellOccupant then throw AbsentError.absent
			takeable(read) then return read
		end 'cell'
	end 'takeableCellOccupantOf'

	function cellOccupantMoves(binding VarInfo, value ValueId) returns bool
		if not binding.isMutable() or binding.isParameter or binding.movedFrom 'notThisFramesToGive'
			return false
		end 'notThisFramesToGive'

		let tag = maxonTypeTag(binding.varType)

		if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef or self.valueIsPromise(value) 'notARecordTheTombstoneStandsFor'
			return false
		end 'notARecordTheTombstoneStandsFor'

		return self.cellOwnsItsOccupant(binding.varType, crossesByReference: binding.cellCrossesByReference)
	end 'cellOccupantMoves'

	// ⭐⭐ **THE TWO FACTS AN `await` NEEDS, FROM WHICHEVER ROAD ITS PROMISE CAME BY** — see
	// `AwaitedPromise`, which carries the argument.
	//
	// ⚠⚠ **IT ANSWERS THE TYPE AND NOT THE TAG.** A bare `ValueTypeTag` has `emitAwaitOp` mint the
	// await's result with that tag beside `nameId: UnnamedTypeId` — a `named` tag carrying the FILLER
	// id. `declaredAliasOfNameId`'s header states the consequence exactly: `UnnamedTypeId` is 0 and a
	// `TypeNameInterner` starts empty, so id 0 is **the first name the file mentions**, and an `async`
	// returning a ranged alias produces an await result typed after whatever name that happens to be.
	function awaitedPromiseFacts(func IrFunction, promise ValueId) returns AwaitedPromise
		if self.valueIsDeferred(promise) 'aSpawnOfNothing'
			return AwaitedPromise.create(AwaitedResult.deferred, tryTarget: TryTarget.deferred)
		end 'aSpawnOfNothing'

		let source = self.asyncCallCalleeOf(func, promise: promise)

		// A service reply is asked before the `Promise` instance below. Its result is the message's
		// declared return type, as a spawn's is its callee's; the difference is the error type, which is
		// `tryTargetThrows`' to derive.
		//
		// ⚠ A reply cell is itself typed `Promise with (T, E)`, so it answers `typeIsPromiseStorage`
		// below and would otherwise be described by its rendered instance name instead of by the message:
		// E3057, E3059 and every reply diagnostic would name `Promise with (int, E)` rather
		// than `Calc.divide`. Asked first it changes only the subject of the sentence, because the
		// storage door proved the storage type describes the reply exactly.
		match source 'reply'
			found or
			none then break
			serviceReply(messageName, awaitedService) then return AwaitedPromise.create(AwaitedResult.declared(self.serviceReplyResultType(messageName, cell: promise)), tryTarget: TryTarget.serviceReply(messageName, awaitedService: awaitedService))
		end 'reply'

		let promiseType = self.typeOf(promise)

		if typeIsPromiseStorage(self.signatures, t: promiseType) 'fromStorage'
			let storage = typeNameIdOf(promiseType)
			return AwaitedPromise.create(AwaitedResult.declared(MaxonReturnType.value(self.resolvedSlotType(self.signatures.substitutedInstanceArg(storage as GenericInstanceId, position: PromiseResultArgPosition)))), tryTarget: TryTarget.promise(self.signatures.instanceDisplayName(storage as GenericInstanceId), throwsClause: promiseStorageThrows(self.signatures, gid: storage as GenericInstanceId)))
		end 'fromStorage'

		panic("awaitedPromiseFacts: promise v{promise} is neither a service reply nor typed at a `Promise` instance — `mintSpawnPromise` mints every declared spawn at its instance, and an undeclared one is a deferred value, answered at the top")
	end 'awaitedPromiseFacts'

	// What `await <reply>` yields: the message's declared return type, repaired through the same swept
	// walk `spawnAtItsPromiseInstance` uses.
	function serviceReplyResultType(messageName ByteArray, cell ValueId) returns MaxonReturnType
		let declaredReturn = try self.signatures.declaredReturnTypeOf(messageName, into: self.artifact.typeNames) otherwise panic("serviceReplyResultType: `{String.from(messageName)}` declares no return type — a reply cell is minted for a declared message only")
		return self.fixedReplyResultType(declaredReturn, messageName: messageName, cell: cell)
	end 'serviceReplyResultType'

	// ⭐⭐ **A RETURN THE INSTANTIATION FIXES IS READ OFF THE CELL, WHICH IS WHERE THE SEND RECORDED IT.**
	// `SignatureIndex.internPromiseInstanceForReply` substituted the result when the send minted the cell —
	// the one moment the handle was in hand — so reading it back is what makes `try await h.peek()` a
	// `String` on a `Box with String` rather than a word no member resolves against.
	//
	// ⛔⛔ **THE CONDITION IS WHOSE SERVICE IT IS, NOT WHAT THE RETURN LOOKS LIKE — AND THAT IS THE WHOLE OF
	// KEEPING ONE DEPTH.** A shape test here was one depth short and could not be repaired into one: an
	// INNER ALIAS (`returns TArray`, on `typealias TArray = Array with T`) is recorded as a `named` leaf,
	// and re-resolving it in THIS tier's interner does not reach it — the alias is qualified by a generic
	// BASE, which no per-instance alias registry is keyed by. Asking the question again in a second table is
	// how a reply came to be typed `Box.TArray`, a spelling no caller can write.
	//
	// ⇒ **A GENERIC SERVICE'S REPLY IS READ OFF THE CELL, ALWAYS.** `internPromiseInstanceForReply` computed
	// it through `ProgramSignatures.instanceResolvedSlotType` — the one home — at the one moment the handle
	// was in hand and in the table those types live in. Reading it back is the only way this tier can hold
	// the same answer rather than a second derivation of it. A MONOMORPHIC service fixes nothing, so its
	// reply is repaired as written, exactly as it always was.
	function fixedReplyResultType(declaredReturn MaxonReturnType, messageName ByteArray, cell ValueId) returns MaxonReturnType
		if self.replyServiceIsGeneric(messageName) 'fixedByTheInstance'
			return MaxonReturnType.value(self.resolvedSlotType(self.signatures.substitutedInstanceArg(self.valueInstanceId(cell), position: PromiseResultArgPosition)))
		end 'fixedByTheInstance'

		return self.repairSweptReturnType(declaredReturn, scopeFilePath: self.signatures.recordedReturnDeclFileOf(messageName))
	end 'fixedReplyResultType'

	// Does this message belong to a service whose instantiation fixes anything at all? Asked of the ROSTER,
	// which is what knows a qualified name is a message and whose it is.
	function replyServiceIsGeneric(messageName ByteArray) returns bool
		if let message = try self.signatures.serviceMessageOf(messageName) 'aMessage'
			return self.signatures.structDeclaresTypeParams(message.typeName)
		end 'aMessage'

		return false
	end 'replyServiceIsGeneric'

	// **THE OPERAND'S TYPE AS THE `await` DIAGNOSTIC NAMES IT** — the value-KIND vocabulary (`integer`,
	// `boolean`, `float`, `string`), which is NOT `typeTagName`'s ABI vocabulary (`int`, `bool`). The two
	// registers are deliberate and both are pinned across the suite: `typeTagName` says `int` because it
	// answers "what does this compile to", and every conversion and return diagnostic quotes it that way.
	// This message answers "what did you write", which is what an author who typed `await x` over an integer
	// is asking.
	//
	// It is `ValueTypeTag`'s own case name, not a hand-written word list. A ranged alias is REDUCED first, so
	// `await someInteger` says `integer` and never the tag `named`, which names no type any author wrote.
	function awaitOperandKindName(value ValueId) returns String
		return self.rangedAliasResolvedTag(self.tagOf(value), nameId: self.valueNameId(value)).name
	end 'awaitOperandKindName'

	// The whole-program sweep records a return type before the aliases are known
	// (`parseTypeReference`'s generic-alias arm is gated on `allFilesFolded`, and `adoptType`
	// re-interns by name), so `returns StringArray` arrives here as a bare `named` and is repaired
	// here, as an ordinary call's result is at its read door (`mintOwnedCallResult` →
	// `repairSweptType`).
	//
	// A ranged int alias is untouched by the repair (`repairSweptType` never resolves one), so the
	// await's result keeps its `named` tag and the alias name stays available to every downstream
	// range check.
	function repairSweptReturnType(swept MaxonReturnType, scopeFilePath FilePath) returns MaxonReturnType
		return match swept 'repair'
			void gives swept
			value(inner) gives MaxonReturnType.value(self.repairSweptType(inner, scopeFilePath: scopeFilePath))
		end 'repair'
	end 'repairSweptReturnType'

	// What the spawn's result channel carries: the spawned call's repaired return type with a ranged alias
	// reduced to the primitive it underlies (`Integer` → `integer`, `Percent` → `float`). Void answers
	// `void`, which the gate admits.
	//
	// ⚠ Kept apart from the type the await's result carries (`awaitedPromiseFacts`), which must keep a
	// ranged int's `named` tag or every downstream reader of the alias — `declaredAliasOfValue`, the
	// range-check sites — sees a plain int. The refusal asks which register file the result travels
	// in, and `named` is too coarse for that: it covers a `String`, a struct and a ranged-int alias
	// alike.
	function asyncCarriedResultTag(returnType MaxonReturnType) returns ValueTypeTag
		return match returnType 'r'
			void gives ValueTypeTag.void
			value(inner) gives self.rangedAliasResolvedTag(maxonTypeTag(inner), nameId: typeNameIdOf(inner))
		end 'r'
	end 'asyncCarriedResultTag'
end 'Parser'
