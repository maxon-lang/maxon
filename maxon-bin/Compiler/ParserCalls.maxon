extension Parser
	function notePlainResultData(func IrFunction, value ValueId, retStart ElementIndex) throws SourceParseError
		if self.effectiveCapabilityOf(value) != ValueCapability.immutable 'writableData'
			self.bodyState.returnsMutableData = true
			self.bodyState.returnsFrozenData = self.bodyState.returnsFrozenData or self.regionFactsForRead().paramSources.besideFrozen.contains(value)
			return
		end 'writableData'

		if self.valueIsFrozenAtItsRoot(func, value: value) or isInitializerFunctionName(func.name) 'frozenByItsParameter'
			return
		end 'frozenByItsParameter'

		self.bodyState.returnsFrozenData = true

		match self.bodyState.fieldDefaultSlot 'slot'
			frozen then return
			writable(place) then throw self.frozenFieldDefaultRefusal(place, value: value, retStart: retStart)
			notADefault then break
		end 'slot'

		if self.bodyState.returnsAParameterDefault or self.extensionInterfaceName.isNamed() 'aResultThatFreezesWithItsInstance'
			self.bodyState.resultFreezesWithItsInstance = true
			return
		end 'aResultThatFreezesWithItsInstance'

		match self.bodyState.frozenResultRefusal 'state'
			at then return
			none then break
		end 'state'

		let retTok = self.tokenAt(retStart)
		let subject = self.returnedSubject(retStart)
		self.bodyState.frozenResultRefusal = DeferredRefusal.at(retTok.line, column: retTok.column, code: ErrorCode.semanticResultPathsDisagree, message: "a return does not fit the declared result: {subject} is immutable, the result is not `immutable`; declare the result `immutable`")
	end 'notePlainResultData'

	function requireFrozenResultIsMixed() throws SourceParseError
		if self.bodyState.returnsMutableData 'mixedWithWritableData'
			return
		end 'mixedWithWritableData'

		match self.bodyState.frozenResultRefusal 'state'
			none then return
			at(line, column, code, message) then throw self.regionRefusal(code, message: message, line: line, column: column)
		end 'state'
	end 'requireFrozenResultIsMixed'

	function valueIsFrozenAtItsRoot(func IrFunction, value ValueId) returns bool
		let root = self.rootValueOf(value)

		if self.valueHoldsAFrozenTupleItem(root) 'aFrozenItemHolder'
			return true
		end 'aFrozenItemHolder'

		return valueIsAParameter(root, paramCount: func.paramCount) and self.capabilityOfValue(root) == ValueCapability.immutable
	end 'valueIsFrozenAtItsRoot'

	function paramSourcesOf(func IrFunction, value ValueId) returns ParamPositionMask
		let direct = paramMaskOfValue(func, value: self.rootValueOf(value))

		if direct != NoParamPositions 'aParametersData'
			return direct
		end 'aParametersData'

		return self.regionFactsForRead().paramSources.derivedSourcesOf(value)
	end 'paramSourcesOf'

	function notePhiParamSources(func IrFunction, phi ValueId, gives ValueIdArray)
		var sources = NoParamPositions

		for give in gives 'eachGive'
			if self.valueIsReadFromAnImmutableSlot(give) 'frozenByItsOwnSlot'
				continue
			end 'frozenByItsOwnSlot'

			let mask = self.paramSourcesOf(func, value: give)

			if mask == NoParamPositions 'anArmOfItsOwn'
				return
			end 'anArmOfItsOwn'

			sources = sources or mask
		end 'eachGive'

		self.regionFactsForWrite().paramSources.derived.upsert(phi, value: sources)
	end 'notePhiParamSources'

	function returnedExpressionText(retStart ElementIndex) returns String
		var textStart = retStart

		if self.kindAt(retStart) == TokenKind.try 'skipTheTry'
			textStart = retStart + 1
		end 'skipTheTry'

		var textEnd = self.pos

		for at in textStart upto self.pos 'toTheHandler'
			if self.kindAt(at) == TokenKind.otherwise 'theHandlerStarts'
				textEnd = at
				break
			end 'theHandlerStarts'
		end 'toTheHandler'

		return self.tokenTextFrom(textStart, endIndex: textEnd)
	end 'returnedExpressionText'

	function returnedSubject(retStart ElementIndex) returns String
		return self.operandSubject(retStart, alone: self.statementEndsAt(retStart + 1), spelled: self.returnedExpressionText(retStart))
	end 'returnedSubject'

	function rootValueOf(value ValueId) returns ValueId
		var current = value

		while true 'towardTheRoot'
			let origin = try self.regionFactsForRead().fieldOrigins.get(current) otherwise return current
			current = origin.holder
		end 'towardTheRoot'

		panic("rootValueOf: the walk toward a root only exits by returning at a value no field was read from")
	end 'rootValueOf'

	function emitFieldLoad(box ValueId, layout StructLayout, index FieldIndex, range SourceRange) returns ValueId
		let read = self.emitFieldLoadValue(box, layout: layout, index: index, range: range)
		let loaded = read.value

		if loaded != box 'aFieldWasRead'
			self.openStatementWindowThrough(box, floor: loaded, range: range)
			let windows = self.regionFactsForRead().windows
			let slot = layout.fieldTypeSites.capabilityAt(index)

			match self.fieldWindowState(windows, holder: box, field: index) 'windowState'
				open then self.setValueCapability(loaded, capability: windowedReadCapability(ValueCapability.mutable, slot: slot))
				paused then self.setValueCapability(loaded, capability: windowedReadCapability(ValueCapability.paused, slot: slot))
				notOpen then self.noteAdaptedSlotRead(loaded, box: box, slot: slot)
			end 'windowState'

			if not self.valueIsAValueType(loaded) and self.capabilityOfValue(loaded) == ValueCapability.mutable and self.valueIsBesideAnotherStatesWindow(box) 'readOnlyBesideAnotherState'
				self.setValueCapability(loaded, capability: ValueCapability.paused)
			end 'readOnlyBesideAnotherState'

			self.regionFactsForWrite().fieldOrigins.upsert(loaded, value: FieldOrigin.create(box, layoutName: layout.name, field: index, slot: layout.fieldTypeSites.capabilityAt(index)))

			if valueIsMarked(self.bodyState.isolatedPartReads, value: box) 'aFieldOfAPartRead'
				self.carryIsolatedPartRead(loaded, arm: box)
			end 'aFieldOfAPartRead'

			if read.typeIsUnknown 'theFieldTypeDenotesNothing'
				self.retypeValue(loaded, valueType: MaxonType.unresolved)
				self.noteDeferredValueInTryBlock()
			end 'theFieldTypeDenotesNothing'
		end 'aFieldWasRead'

		return loaded
	end 'emitFieldLoad'

	function fieldReadOf(value ValueId, layout StructLayout, index FieldIndex, declared MaxonType) returns FieldRead
		let written = try layout.fieldTypes.get(index) otherwise panic("fieldReadOf: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}`")

		if maxonTypeTag(written) != ValueTypeTag.named 'notANamedType'
			return FieldRead.create(value, typeIsUnknown: false)
		end 'notANamedType'

		return FieldRead.create(value, typeIsUnknown: self.declaredTypeIsUnknown(declared, scopeFilePath: layout.declFilePath))
	end 'fieldReadOf'

	function noteAdaptedSlotRead(loaded ValueId, box ValueId, slot ParamCapability)
		self.setValueCapability(loaded, capability: adaptedCapability(self.effectiveCapabilityOf(box), slot: slotCapabilityOf(slot)))
		self.noteCarriedDerivation(loaded, source: box, slot: slot, joins: false)

		if slot == ParamCapability.unmarked 'anUnmarkedSlot'
			self.carryUndecidedResult(box, target: loaded)
		end 'anUnmarkedSlot'
	end 'noteAdaptedSlotRead'

	function carryPayloadParamSources(payload ValueId, box ValueId, slot ParamCapability)
		if slot == ParamCapability.immutable or self.valueIsAValueType(payload) 'frozenOnItsOwn'
			return
		end 'frozenOnItsOwn'

		self.carryParamSources(payload, source: box)
	end 'carryPayloadParamSources'

	function carryUndecidedResult(source ValueId, target ValueId)
		if self.valueIsAValueType(target) 'nothingToSettleLater'
			return
		end 'nothingToSettleLater'

		if self.bodyState.undecidedResults.contains(source) 'anUndecidedResult'
			self.registerUndecidedAlias(source, target: target)
		end 'anUndecidedResult' else if self.bodyState.rebindAliasOps.contains(source) 'aCopyOfOne'
			self.registerRebindAlias(source, target: target)
		end 'aCopyOfOne'

		if self.valueSettlesAfterParsing(target) 'settledAfterParsing'
			self.setValueCapability(target, capability: ProvisionalForAUse)
		end 'settledAfterParsing'
	end 'carryUndecidedResult'

	function carryImmutableSlotRead(source ValueId, target ValueId)
		if self.valueIsAValueType(target) or not self.valueIsReadFromAnImmutableSlot(source) 'nothingFrozenToCarry'
			return
		end 'nothingFrozenToCarry'

		self.bodyState.immutableSlotReads = withValueMarked(self.bodyState.immutableSlotReads, value: target)
		self.setValueCapability(target, capability: ValueCapability.immutable)
	end 'carryImmutableSlotRead'

	function valueSettlesAfterParsing(value ValueId) returns bool
		return self.bodyState.undecidedResults.contains(value) or self.bodyState.rebindAliasOps.contains(value)
	end 'valueSettlesAfterParsing'

	function settlingOpOf(value ValueId) returns ElementIndex throws AbsentError
		if let opIdx = try self.bodyState.undecidedResults.get(value) 'anUndecidedResult'
			return opIdx
		end 'anUndecidedResult'

		return try self.bodyState.rebindAliasOps.get(value) otherwise throw AbsentError.absent
	end 'settlingOpOf'

	function settlingOpsOf(value ValueId) returns SettlingOpArray throws AbsentError
		if let merged = try self.bodyState.mergedSettlingOps.get(value) 'aMergeOfSeveralResults'
			return merged
		end 'aMergeOfSeveralResults'

		let single = SettlingOpArray.create(1, zeroed: false)
		single.push(try self.settlingOpOf(value))
		return single
	end 'settlingOpsOf'

	function adoptSettlingOps(source ValueId, target ValueId, whatIsRegistered String) returns ElementIndex
		let ops = try self.settlingOpsOf(source) otherwise panic("{whatIsRegistered} is registered with its defining op")
		let anchorOp = try ops.get(0) otherwise panic("adoptSettlingOps: a registered result has at least one defining op")

		if ops.count() > 1 'aMergeOfSeveralResults'
			self.bodyState.mergedSettlingOps.upsert(target, value: ops.clone())
		end 'aMergeOfSeveralResults' else 'oneDefiningOp'
			self.noteDerivedResult(target, op: anchorOp)
		end 'oneDefiningOp'

		return anchorOp
	end 'adoptSettlingOps'

	function registerUndecidedAlias(source ValueId, target ValueId)
		self.bodyState.undecidedResults.upsert(target, value: self.adoptSettlingOps(source, target: target, whatIsRegistered: "registerUndecidedAlias: an undecided result"))
	end 'registerUndecidedAlias'

	function registerRebindAlias(source ValueId, target ValueId)
		self.bodyState.rebindAliasOps.upsert(target, value: self.adoptSettlingOps(source, target: target, whatIsRegistered: "registerRebindAlias: a copy is made of a result"))
	end 'registerRebindAlias'

	function noteDerivedResult(target ValueId, op ElementIndex)
		let notes = self.notesForWrite(self.bodyFunction())
		notes.derivedResultValues.push(target)
		notes.derivedResultOps.push(op)
	end 'noteDerivedResult'

	function emitFieldLoadValue(box ValueId, layout StructLayout, index FieldIndex, range SourceRange) returns FieldRead
		// ⭐⭐ **READING A FUSED WRAPPER'S INLINE `managed` IS NOT A LOAD — THE FIELD *IS* THE RECEIVER.**
		// `type String`'s `managed` is the `__ManagedMemory` embedded whole at offset 0, so its ADDRESS
		// equals the record pointer; an `emitIndirectLoad` at offset 0 would read `buffer@0` and hand
		// back a raw byte pointer where a buffer RECORD is wanted. A bare `managed` reference IS `self`.
		//
		// ⭐ **AND THE CORPUS ALREADY HAS A NAME FOR THIS VALUE: `addressableBytes()`, whose entire body is
		// `return managed`** (`stdlib/String.maxon:181`). The compiler serves that through `__str_bytes_view`, which
		// CO-OWNS the receiver's own record and hands it straight back — so the ownership is the
		// debugged one rather than a second answer invented here, and the two spellings of one question land
		// in one producer. Handing back the receiver's own `ValueId` UNCOUNTED is the double free
		// `bufferSurfaceOf`'s header measures; what this door hands back is counted.
		//
		// ⭐⭐⭐ **THE DOOR ABOVE IS WHAT KEEPS THIS OFF THE HOT PATH.** A `managed` read that is immediately CALLED never
		// arrives here at all — `dispatchMethodOnBinding`'s `inlineManagedServesTheRecord` hands the receiver's own record to the
		// buffer entry, for every member. What reaches this line is `managed` used as a VALUE: bound,
		// returned (`addressableBytes()`'s whole body), passed as an argument, or stored into a `String{…}`
		// literal — every one of which may outlive the statement, and for which handing back the receiver's
		// own `ValueId` uncounted is the double free `bufferSurfaceOf`'s header measures. ⭐ **THE COST IS A REFCOUNT
		// PAIR RATHER THAN A 48-BYTE RECORD**: a String record IS a buffer
		// record, so there is nothing to mint — the whole of `__str_bytes_view` is an `__mm_incref`.
		//
		// ⛔⛔ **THE FUSED DOOR SERVES ALL FOUR CONFORMERS, BECAUSE ROUTING A NON-BYTE-RECORD `managed` CALL THROUGH HERE HAS A PRICE.**
		// Turning the fused record door away from `Array` and `FixedArray` would make a bare `managed.byteAt(i)` inside a container
		// body take `coOwnAggregateAsTemp` like any other value read. **That is not a user-code-only cost**:
		// `Array.hash` and `Array.equals` are NOT on `arraySurfaceMemberNames`, so unlike `count`/`get` they
		// are not served by a synthesized arm — the corpus bodies are what a program actually calls, and each
		// is a loop over `try managed.byteAt(i) otherwise panic(…)` (`stdlib/Array.maxon:665-688`), so the
		// pair would be paid once PER BYTE. MEASURED, on identical source built by an IDENTICAL compiler, a program hashing a 64-element
		// `Array with Int` 200,000 times: **327 ms -> 624 ms** (min of three) and **413 ms -> 684 ms**
		// (min of four), 6,160 -> 6,224 code bytes. `Character.hash` is the same loop over the
		// same member one type away and was UNCHANGED — a Character IS a byte record and kept the fused door
		// — which is what identified the re-route as the cause.
		// ⇒ The fused door hands each wrapper its OWN buffer-surface instance
		// (`bufferSurfaceInstanceOf`) instead of turning any of them away, which serves the same three
		// members and emits nothing. **`Array.hash` is what every `Set` and `Map` keyed on an
		// array runs**, and this is the 34.3x `hashString` shape of the table below one container over.
		//
		// ⛔ **WHY THAT SPLIT EXISTS, MEASURED — WITHOUT IT THE COST IS 86.7x.** `String.byteLength`'s corpus body is
		// `return managed.length()`, and without the split that ONE expression emits `__str_bytes_view` (a
		// 48-byte `Array` record + `__mm_incref`), then `__managed_count`, then `__managed_decref` — a heap allocation
		// and two refcount operations to read `length@8`. `String.byteAt` is the same shape once PER BYTE.
		// min-of-7 interleaved, same source, base / uncured / cured:
		//
		//     s.byteLength()  4,000,000 trips      3.33 ms -> 278.69 ms -> 11.13 ms   83.7x -> **3.34x**
		//     s.isEmpty()     4,000,000 trips      5.05 ms -> 287.48 ms -> 17.22 ms   56.9x -> **3.41x**
		//     hashString(s)   524,288 bytes x 8    8.82 ms -> 302.39 ms -> 19.74 ms   34.3x -> **2.24x**
		//     short.clone()   4,000,000 trips    251.03 ms -> 1370.27 ms -> 841.54 ms  5.5x -> **3.35x**
		//     integer control                     5.89 ms ->   5.83 ms ->  5.88 ms    1.0x ->   1.00x
		//
		// Never a leak (`__managed_decref` ran, no run exits 101) and never a wrong answer — every mode returns a
		// bit-identical accumulator on all three binaries, which is what says the cure deleted no work.
		//
		// ⚠⚠ **`clone()` GOES THROUGH `sliceBytes` -> `managed.slice(...)`, AND THIS LINE ALLOCATES NOTHING FOR IT.**
		// `slice` takes a String record directly: `__managed_slice` -> `emitRecordView` LOADS `@40` and STORES it
		// into the fresh view, and a String record's `@40` IS `TrivialElementDestroy`, so the view's
		// `element_destroy` is correct and no view needs minting here. `sliceBytes` asks `byteLength()`, which
		// the split makes cheap.
		// ⭐ **AND `slice` DOES NOT REACH THIS LINE AT ALL WHEN IT IS CALLED**: the fused record
		// door admits every member, so what is left here is `managed` used as a VALUE. See that
		// door's header (`dispatchMethodOnBinding`'s `aCalledManagedFieldMember`) for the census the deleted
		// whitelist carried and for the three arguments that closed it.
		if layout.fieldIsTheInlineManagedRecord(index) 'inlineManagedIsTheReceiver'
			// ⭐⭐⭐ **AN `Array`'s BUFFER IS THE `Array`, SO THERE IS NO VIEW TO MINT** — the same
			// answer `bufferSurfaceOf` gives for the SPELLED `arr.managed`, reached here by the implicit-`self`
			// read inside `type Array`'s own body. It is not an optimization of the line below; that line is
			// **WRONG** for this wrapper in two independent ways, and both are silent:
			//   • **THE ELEMENT.** `internSynthesizedByteInstance` is the BYTE buffer, which is exactly right
			//     for `String` and `Character` — their record IS a byte buffer — and is a stride lie for an
			//     `Array with Element`, whose slots are 8 bytes wide. `__str_bytes_view` mints a record
			//     stamped `element_size@24 = 1`.
			//   • **THE TYPE PARAMETER.** With the element read back as a concrete byte, the copy lowering
			//     asks which of the enclosing declaration's `uses` names that element is and there is no
			//     answer — **MEASURED as `panic … opaqueTypeParamPosition: asked for the `uses`-list position
			//     of a `int`, which names no type parameter`** on a `clone()` whose body is
			//     `managed.slice(0, len)`.
			// One record with two surfaces is the whole of this wrapper, so the read is the surface flip and
			// nothing else — which also means it allocates nothing where the String path allocates a record.
			// ⚠ **AND THE SIZED CONTAINER TAKES THIS ARM TOO** — a `FixedArray`'s value IS the same fused
			// record, so `stdlib/FixedArray.maxon`'s `managed` is the surface flip and not a `__str_bytes_view`.
			// Both silent wrongs the paragraph above enumerates apply to it word for word: the byte view's
			// stride is 1 and a fixed array's slots are its element's, and the element read back as a concrete byte
			// leaves `opaqueTypeParamPosition` with no `uses` name to answer.
			if self.signatures.declarationsValueIsTheManagedRecord(layout.name) 'theRecordISTheBuffer'
				return FieldRead.create(self.bufferSurfaceOfDeclaredRecord(box, layout: layout, range: range), typeIsUnknown: false)
			end 'theRecordISTheBuffer'

			// ⚠ **THE MINTED VIEW WEARS THE INSTANCE `bufferSurfaceInstanceOf` NAMES, NOT A CONSTANT SPELLED HERE.**
			// This is the THIRD door asking *"which instance does this fused
			// wrapper's buffer surface wear?"*, and writing `internSynthesizedByteInstance()` out
			// again would duplicate that function's FIRST ARM, which answers the identical thing behind the identical predicate,
			// `declarationsValueIsTheManagedRecord`, which is the very test the arm above just made. Provably the
			// same value, so asking it removes a spelling and changes no behaviour; what it buys is that a second
			// byte-record instance can never be taught to two of the three doors and missed at the third.
			let view = self.emitOwnedRuntimeResult(StrBytesViewName, args: argsOf(box), resultTag: ValueTypeTag.genericInstance, resultNameId: self.bufferSurfaceInstanceOf(box, layout: layout) as TypeNameId, range: range, exclusivity: OwnedHeapExclusivity.coOwned)
			self.markBufferSurface(view, origin: EmptySourceText)
			return FieldRead.create(view, typeIsUnknown: false)
		end 'inlineManagedIsTheReceiver'

		// A FUNCTION-typed field (`export var op as UnaryOp`) arrives from `fieldTypeOf` already re-tagged
		// `function` (it functionizes over the whole-program function-alias registry, since the SWEEP that
		// recorded the layout ran before the alias was known), which is what makes the loaded value carry
		// the `function` tag so `h.op(21)` reaches an indirect call.
		let declared = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)

		if self.signatures.layoutPacksInlineIntoAWord(layout) 'inlinePacked'
			return self.fieldReadOf(self.emitInlinePackedFieldRead(box, layout: layout, index: index, declared: declared, range: range), layout: layout, index: index, declared: declared)
		end 'inlinePacked'

		// ⭐⭐ **READING A PROMISE'S `inner` IS NOT A LOAD EITHER — THE HANDLE *IS* THE VALUE.** The
		// same shape as the fused-wrapper arm above and settled the same way: The compiler does not box a promise
		// (`PromiseType.maxon` carries the argument), so a `Promise with T` value IS the green-thread
		// pointer, and the line below would DEREFERENCE it, answering the word at offset 0 without a fault.
		//
		// ⚠ **IT MINTS RATHER THAN HANDING `box` BACK, AND THE MINT IS THE LOAD-BEARING HALF.** Returning the
		// receiver's own ValueId would make `let h = p.inner` a SECOND NAME for the promise: it carries
		// `valueOwnsGreenThread`, so the binding enrols a second owner and `__gt_promise_drop` runs twice, and
		// it answers `valueIsPromise`, so `await h` is a second await the linearity check cannot see as one.
		// `emitRetaggedCastValue` is the compiler's existing spelling of "the same bits, a fresh identity,
		// the target type" — the field's DECLARED type here, which is what makes the handle arrive at
		// `__Builtins.gtIsComplete` as the machine word its operand rule wants.
		//
		// ⚠ The tail below is skipped and owes nothing: `inner` is declared `int`, so there is no interface
		// witness to pair, no instance substitution to apply (the field's type names no type parameter), no
		// `named` throw-source to record and no buffer surface; and it is a `let`, so the rebindable-slot
		// mark is unreachable twice over (immutable, and not managed heap).
		if fieldReadIsThePromiseHandle(self.signatures, receiverType: self.typeOf(box), layout: layout, index: index) 'handleIsTheValue'
			return self.fieldReadOf(self.emitRetaggedCastValue(box, targetType: declared, range: range), layout: layout, index: index, declared: declared)
		end 'handleIsTheValue'

		let offset = layout.offsetOfField(index)
		let result = self.emitIndirectLoad(declared, box: box, offset: offset, storageType: self.fieldStorageType(declared), range: range)
		self.wearDeclaredFloatAlias(result, declared: self.fieldTypeKeepingAlias(layout, index: index, collapsed: declared), scopeFilePath: layout.declFilePath)

		// A field read wears the brand the field was declared under (`export var xs as Xs` reads as an `Xs`).
		self.brandValue(result, brand: self.fieldPlaceBrand(layout, index: index, resolved: declared))

		// ⭐⭐ **READING A PROMISE OUT OF A FIELD IS A PENDING MOVE, exactly as reading one out of a container
		// element is.** The field goes on owning the thread until the read is CONSUMED; at that point the
		// field is nulled, so the struct's destructor does not reclaim a thread the `await` already did.
		//
		// ⛔ **MEASURED both ways.** Without the record, `await h.p` had no slot to empty and no ownership
		// mark, so `requireConsumedPromiseIsOwned` refused a perfectly good program; with the record but
		// without the null store, the await and `__destruct_Holder` each reclaimed the same thread. ⚠ It is
		// NOT recorded as a consume: `h.p.inner` peeks the handle and moves nothing, which is the whole point
		// of `.inner`.
		if self.signatures.typeIsAGreenThreadHandle(declared, from: self.artifact.typeNames) 'aPromiseField'
			self.recordConsumablePromiseSlot(result, container: box, index: self.emitLiteral(offset as FullRangeInt, valueType: MaxonType.integer, range: range), isField: true)

			if not layout.fieldIsMutable(index) 'aLetFieldsSlot'
				self.bodyState.letFieldPromiseReads.upsert(result, value: String.from(self.fieldNameAt(layout, index: index)))
			end 'aLetFieldsSlot'
		end 'aPromiseField'

		// ⭐⭐ **AN INTERFACE-TYPED FIELD READS AS TWO LOADS, AND THE SECOND IS THE WITNESS.**
		// The field's carve-out holds both halves, so the witness comes out of
		// the box beside the value rather than being re-derived — which is the only thing that can be right:
		// a fat pointer's dynamic type is a run-time fact, and the box is where the write recorded it. Paired
		// here rather than at the six doors that reach this mint (`h.t`, a bare `t` in a method, a chain hop,
		// …) for the reason `markDeclaredSurface` sits here: every one of them funnels through this line, and
		// a per-door pairing is the enumeration that misses the seventh. Without it, passing `h.t` at an
		// interface argument position panics in `witnessOfValue` with "no witness paired".
		if maxonTypeTag(declared) == ValueTypeTag.interfaceRef 'existentialField'
			self.pairInterfaceWitness(result, witness: self.emitIndirectLoad(MaxonType.integer, box: box, offset: offset + InterfaceWitnessHalfOffset, storageType: MaxonType.integer, range: range))
		end 'existentialField'

		// ⭐ **RETYPE AT A CONCRETE FIELD READ.** A `b.value` read on a concrete
		// `Box with String` loads a field the shared body typed opaque `T`, and a `b.items` read on a
		// `HoldA with Num` loads one it typed `Array with T`. Retype the result to what the instance FIXES it to
		// (`String`, `Array with Num`) so it is usable as what it actually is — but ONLY the type moves: the read
		// is a BORROW (`emitFieldLoad` never marks it owned-heap), so the box keeps its +1 and drops the value at
		// ITS scope exit; a `let s = b.value` re-reads a live pointer and is never double-dropped. The
		// substitution ends in `adoptType`, which re-interns any named argument into this file's interner.
		let fixedByTheInstance = self.slotTypeThroughReceiver(box, declared: declared, scopeFilePath: layout.declFilePath)

		if not maxonTypesDenoteSame(fixedByTheInstance, b: declared) 'concreteSlotRead'
			self.retypeValue(result, valueType: fixedByTheInstance)

			if tagIsFloat(self.tagOf(result)) and self.tagOf(box) == ValueTypeTag.genericInstance 'aFloatSlotOfAnInstance'
				let instanceAlias = self.floatAliasThroughInstance(declared, gid: self.valueInstanceId(box))

				if instanceAlias != UnnamedTypeId 'theArgumentIsAnAlias'
					self.wearFloatAlias(result, aliasId: instanceAlias)
				end 'theArgumentIsAnAlias'
			end 'aFloatSlotOfAnInstance'
		end 'concreteSlotRead'

		// ⭐ **RECORD A BOXED-UNION-CANDIDATE FIELD READ**, so a THROW of it can MOVE it out of the container
		// (`emitThrowError` nulls this slot — the compiler's only transfer for a borrowed error). Gated on the `named`
		// tag, which a boxed union carries (as do a ranged-int alias and a scalar enum — the throw path
		// filters those out via `throwsTypeIsBoxedUnion`); a scalar/String/struct field is not `named` and is
		// never a thrown error, so the common field read leaves this slot untouched.
		if maxonTypeTag(declared) == ValueTypeTag.named 'namedFieldRead'
			self.bodyState.lastFieldRead = LastFieldRead.read(result, box: box, offset: offset)
		end 'namedFieldRead'

		// ⭐ **A FIELD DECLARED `__ManagedMemory` READS AS THE BUFFER SURFACE** — the declared SPELLING,
		// which `declared` above cannot carry (the alias resolves to the same `genericInstance` a `ByteArray`
		// field does), taken off the layout's own column. It sits at THIS mint rather than at the nine doors
		// that reach it — `h.buf`, `self.buf`, a bare `buf` in a method, a chain hop, a compound assignment's
		// read — because every one of them funnels through this line, and a per-door mark would be the
		// enumeration that misses the tenth.
		self.markDeclaredSurface(result, declared: self.signatures.fieldSurfaceOf(layout, index: index))

		// ⭐ **AND THE SPELLING THE RECEIVER'S INSTANCE ARGUMENT CARRIES, WHICH THE FIELD'S OWN DECLARATION
		// CANNOT.** A field declared `var slot as U` names no buffer anywhere — the spelling belongs to the
		// `Cell with __ManagedMemory` being read THROUGH, not to the shared body's declaration. Asked here
		// because this is where the same crossing already happens for the TYPE (`slotTypeThroughReceiver`, ten
		// lines up), and the two halves must not be able to come apart.
		self.markDeclaredSurface(result, declared: self.slotSurfaceThroughReceiver(box, declared: declared))

		// ⭐ **AND THE PER-VALUE SLOT MASK, WHICH THE LAYOUT CANNOT CARRY.** When `box` is a TUPLE, its
		// layout is SHARED with every other tuple of the same canonical element types — `(__ManagedMemory, Int)`
		// and `(ByteArray, Int)` are one registration — so the buffer-ness of slot `index` is a fact about THIS
		// VALUE and about nothing the layout knows. Read here in ADDITION to the column above rather than
		// instead of it: the column stays authoritative for a real struct field, whose declaration is its own.
		//
		// This one line is what serves `p.0`, `let (m, n) = pair()` and `h.p.0` alike — every read of a tuple
		// element in the language funnels through this mint.
		self.markDeclaredSurface(result, declared: self.valueSlotSurface(box, slot: index))

		// ⭐⭐ **A MANAGED VALUE OUT OF A WRITABLE FIELD OWES A REFERENCE THE MOMENT IT IS BOUND TO A NAME.**
		// The retype note above states this read's ownership rule — "the read is a BORROW
		// (`emitFieldLoad` never marks it owned-heap), so the box keeps its +1 and drops the value at ITS
		// scope exit" — and that is still true of the READ. What it does not survive is the field being
		// REBOUND while a name still holds the value: `emitFieldWrite` drops the old occupant, so `let old =
		// items` followed by `items = fresh` leaves `old` naming freed memory (MEASURED 0xC0000005 where the
		// oracle prints `sum 10`). The mark rides the VALUE to `declareInitializedBinding`, which promotes it
		// there — see `overwritableSlotReads` for why the mark and not a token re-walk, and why the promotion
		// belongs at the CONSUMER rather than here.
		//
		// ⛔⛔ **AN ARGUMENT IS NOT TRANSIENT, AND TREATING IT AS ONE IS A USE-AFTER-FREE.** An argument is transient in the CALLER's
		// frame and not in the CALLEE's: the callee runs with the pointer in hand and may drop the very slot
		// it came out of, and then read it. MEASURED on `clobber(b, borrowed: b.s)` whose body assigns `c.s`
		// — exit **82 `slabOsAllocFailed`**, and `panic: Range check failed` on the `byteLength()` spelling of
		// the same program. `parseCallArgs` holds such an argument, and the prepended receiver, whenever
		// anything in the statement evaluates after it (`holdIsOwedAt`).
		//
		// It sits at THIS mint rather than at the doors that reach it, for `markDeclaredSurface`'s reason
		// stated two lines up: every field read in the language funnels through this line, and a per-door mark
		// is the enumeration that misses one. Gated on the field being WRITABLE (an immutable field's occupant
		// cannot be replaced — E2013) and on the value being MANAGED (a scalar is freed by nothing), so the
		// set stays empty for the overwhelming majority of reads.
		if layout.fieldIsMutable(index) and self.valueMayNameARecord(result) 'writableManagedSlot'
			self.markOverwritableSlotRead(result)
		end 'writableManagedSlot'

		self.carryStorageReadMarks(box, read: result)
		self.carryImageRecordMarkToRead(box, read: result)
		self.noteFrozenTupleFieldRead(result, tuple: box, index: index)
		self.settleFloatResult(result)
		return self.fieldReadOf(result, layout: layout, index: index, declared: declared)
	end 'emitFieldLoadValue'

	function carryStorageReadMarks(box ValueId, read ValueId)
		if not self.valueMayNameARecord(read) 'ownsNoRecord'
			return
		end 'ownsNoRecord'

		if valueIsMarked(self.bodyState.overwritableSlotReads, value: box) 'throughARebindableHop'
			self.markOverwritableSlotRead(read)
		end 'throughARebindableHop'

		if valueIsMarked(self.bodyState.elementReads, value: box) 'throughAnElement'
			self.markElementRead(read)
		end 'throughAnElement'
	end 'carryStorageReadMarks'

	// ⭐⭐ **WHAT A SLOT DECLARED IN A SHARED GENERIC BODY ACTUALLY HOLDS WHEN IT IS READ THROUGH A CONCRETE
	// INSTANCE — the ONE answer, for the two doors that each need it at a different moment:** `emitFieldLoad`
	// retypes the loaded VALUE, and `resolveFieldChainFrom` needs the TYPE one step earlier, to decide what the
	// next hop addresses. Written out twice it would be one condition with two homes.
	//
	// ⛔ **IT IS NOT A PREDICATE OVER THE BARE `typeParameter` TAG ALONE, which is exactly the tag
	// an inner `typealias Items = Array with T` does NOT carry.** A field typed `Items` is a `genericInstance`,
	// so `b.items` on a `HoldA with Num` would keep the declaration view's `Array with T` — refused where it should
	// be accepted (`E3005: expected 'HoldANum.Items', got 'HoldA.Items'`), and accepted where a
	// `HoldA with String`'s items should be refused. The question is not "is this the body's `T`", it is
	// "does this instance FIX this type", and only the substitution can answer that.
	//
	// It returns `declared` UNCHANGED — the same object — when the receiver is not a concrete instance or when
	// the instance fixes nothing in it, so a caller distinguishes "no instance view" by asking
	// `maxonTypesDenoteSame` of what it passed in. That is one fact (the substitution) read two ways, rather
	// than a predicate that has to agree with a substitution it does not call.
	//
	// ⭐⭐ **THE CROSSING BACK IS `resolvedSlotType` AND NOT A BARE `adoptType` — AN INSTANCE'S TYPE
	// ARGUMENT IS A SLOT LIKE ANY OTHER, RECORDED BEFORE THE ALIAS REGISTRIES EXISTED.** The DECLARATION SWEEP
	// interns `Box with Point`'s argument before anything can say what `Point` denotes, so it comes back here as
	// a bare `named` for exactly the reason a struct FIELD's and an `Array` ELEMENT's declared types do — and
	// `adoptType` re-interns the NAME while leaving the tag alone. That is not a cosmetic loss: `named` reads as
	// an INTEGER (`tagIsIntegral`), so this door — the ONE place a `T`-typed read learns what `T` is — would
	// hand back a type that says "int" for a value that is a POINTER.
	//
	// ⚠ **MEASURED, THREE FACES OF THIS ONE LINE, against the runnable oracle** (which compiles and runs all
	// three): `let q = b.value` on a `Box with Point` then
	//   • `q + 0` **COMPILED AND PRINTED THE RAW HEAP ADDRESS** — arithmetic accepted against a pointer, and
	//     the worst of the three because it is the one that does not refuse (the oracle says E2004);
	//   • `q.x` was `E2015 … 'q', which is declared 'int' and not a struct type`;
	//   • with a GENERIC-ALIAS argument (`Holder with IntBox`) it was `E3011 Unknown type 'IntBox'`, said of
	//     a name the program declares one line above.
	// One decision, one cause, one door — the struct arm and the generic-alias arm of `declaredSlotType` are
	// literally the two the three faces split along.
	//
	// ⚠ **THE SUBSTITUTION ITSELF IS ASKED IN THE INDEX'S SPACE, and only the ANSWER crosses.** `typeIsManaged`
	// and every other `ProgramSignatures` classifier must be asked of an index-space type, never of one already
	// re-interned into this file's table — the two interners assign ids in their own insertion orders, so such
	// an answer is right exactly while they coincide and silently wrong when they drift. That is why
	// the two steps stay two.
	function slotTypeThroughReceiver(box ValueId, declared MaxonType, scopeFilePath FilePath) returns MaxonType
		if self.tagOf(box) != ValueTypeTag.genericInstance 'notAConcreteInstance'
			return declared
		end 'notAConcreteInstance'

		return self.slotTypeThroughInstance(declared, gid: self.valueInstanceId(box), scopeFilePath: scopeFilePath)
	end 'slotTypeThroughReceiver'

	function slotTypeThroughInstance(declared MaxonType, gid GenericInstanceId, scopeFilePath FilePath) returns MaxonType
		if maxonTypeTag(declared) == ValueTypeTag.function 'aFunctionTypesInstanceView'
			return self.functionTypeThroughInstance(declared, gid: gid, scopeFilePath: scopeFilePath)
		end 'aFunctionTypesInstanceView'

		// ⭐ **A TUPLE CROSSES AS A NAME, NOT AS AN ID** — `substituteTupleThroughInstance` states why the
		// interner-free substitution cannot answer for a `structRef`, and why a tuple's canonical name is the
		// currency that can. The composition of the two lives in `substituteThroughInstanceInterned`, beside the
		// substitutions it composes, because the ARGUMENT CHECK needs the identical rule in the PROJECT's
		// interner.
		let substituted = self.signatures.substituteThroughInstanceInterned(declared, id: gid, interner: self.artifact.typeNames)

		if maxonTypesDenoteSame(substituted, b: declared) 'theInstanceFixesNothingHere'
			return declared
		end 'theInstanceFixesNothingHere'

		// ⚠ **ONLY THE NON-TUPLE ANSWER IS RESOLVED, and the gate reads the DECLARED side rather than the
		// substituted one.** `resolvedSlotType` repairs a sweep-recorded `named` leaf (see the note above); a
		// tuple came back already interned as a `structRef` by the crossing, and handing THAT to the slot
		// resolver would ask the alias registries about a name no alias declares. A `structRef` INPUT that
		// reached this line can only be a moved tuple — every other `structRef` leaves through the
		// denotes-same return one line up — whereas a `structRef` ANSWER is also what a `typeParameter` whose
		// argument is a struct substitutes to, and that one still needs resolving.
		return substituted if tagNamesADeclaredType(maxonTypeTag(declared)) else self.resolvedSlotType(substituted)
	end 'slotTypeThroughInstance'

	function functionTypeThroughInstance(declared MaxonType, gid GenericInstanceId, scopeFilePath FilePath) returns MaxonType
		let name = self.internedName(typeNameIdOf(declared))

		if self.memos.instanceViewAliases.contains(name) 'alreadyAnInstanceView'
			return declared
		end 'alreadyAnInstanceView'

		match self.signatures.functionAliasFrom(name, readerFilePath: scopeFilePath) 'alias'
			declared(found) then return self.functionAliasThroughInstance(found, declared: declared, gid: gid)
			undeclared then return declared
		end 'alias'
	end 'functionTypeThroughInstance'

	function functionAliasThroughInstance(alias FunctionTypeAlias, declared MaxonType, gid GenericInstanceId) returns MaxonType
		let paramTypes = MaxonTypeArray.create(alias.paramTypes.count(), zeroed: false)
		var moved = false

		for param in alias.paramTypes 'eachParam'
			let stored = self.repairSweptType(maxonTypeOfStoredAliasParam(param, typeNames: self.artifact.typeNames), scopeFilePath: alias.declFilePath)
			let viewed = self.functionSlotThroughInstance(stored, gid: gid, scopeFilePath: alias.declFilePath)
			moved = moved or not maxonTypesDenoteSame(viewed, b: stored)
			paramTypes.push(viewed)
		end 'eachParam'

		var returnType = MaxonReturnType.void

		match maxonTypeOfStoredAliasReturn(alias, typeNames: self.artifact.typeNames) 'declaredReturn'
			void then break
			value(inner) then returnType = MaxonReturnType.value(self.functionSlotThroughInstance(self.repairSweptType(inner, scopeFilePath: alias.declFilePath), gid: gid, scopeFilePath: alias.declFilePath))
		end 'declaredReturn'

		if not moved and maxonReturnTypesDenoteSame(returnType, b: maxonTypeOfStoredAliasReturn(alias, typeNames: self.artifact.typeNames)) 'theInstanceFixesNothingHere'
			return declared
		end 'theInstanceFixesNothingHere'

		let viewName = self.signatures.instanceViewAliasName(alias, gid: gid)

		if not self.memos.instanceViewAliases.contains(viewName) 'firstViewInThisFile'
			self.memos.instanceViewAliases.file(viewName, value: self.artifact.functionTypeAliases.count())
			self.artifact.functionTypeAliases.push(self.instanceViewAlias(alias, viewName: viewName, paramTypes: paramTypes, returnType: returnType))
		end 'firstViewInThisFile'

		return MaxonType.function(self.artifact.typeNames.intern(viewName))
	end 'functionAliasThroughInstance'

	function functionSlotThroughInstance(slot MaxonType, gid GenericInstanceId, scopeFilePath FilePath) returns MaxonType
		if self.signatures.slotNamesTheInstancesBase(slot, interner: self.artifact.typeNames, gid: gid) 'theDeclarationsSelf'
			return MaxonType.genericInstance(gid)
		end 'theDeclarationsSelf'

		return self.slotTypeThroughInstance(slot, gid: gid, scopeFilePath: scopeFilePath)
	end 'functionSlotThroughInstance'

	function instanceViewAlias(alias FunctionTypeAlias, viewName immutable ByteArray, paramTypes MaxonTypeArray, returnType MaxonReturnType) returns FunctionTypeAlias
		let params = FunctionAliasParamArray.create(paramTypes.count(), zeroed: false) as isolated FunctionAliasParamArray

		for position in 0 upto paramTypes.count() 'eachParam'
			let paramType = try paramTypes.get(position) otherwise panic("instanceViewAlias: paramTypes.get OOB at {position} below count {paramTypes.count()}")
			let storedParam = self.storedFunctionAliasParam(paramType, name: alias.paramNameAt(position), aggregateName: self.erasedAggregateNameOf(paramType), capability: alias.paramCapabilityAt(position), marked: alias.paramMarkedAt(position))
			params.push(storedParam)
		end 'eachParam'

		match returnType 'returned'
			void then return FunctionTypeAlias.create(viewName, returnTag: ValueTypeTag.void, returnTypeName: EmptySourceText, returnIdentity: AliasSlotIdentity.nameOnly, returnAggregateName: EmptySourceText, returnCapability: alias.returnCapability, paramTypes: freeze params, paramSpelling: alias.paramSpelling, declFilePath: alias.declFilePath.clone(), visibility: alias.visibility, written: alias.written, typeSites: alias.typeSites, mutableFunction: alias.mutableFunction)
			value(inner) then return FunctionTypeAlias.create(viewName, returnTag: maxonTypeTag(inner), returnTypeName: self.functionAliasTypeName(inner), returnIdentity: functionAliasSlotIdentity(inner), returnAggregateName: self.erasedAggregateNameOf(inner), returnCapability: alias.returnCapability, paramTypes: freeze params, paramSpelling: alias.paramSpelling, declFilePath: alias.declFilePath.clone(), visibility: alias.visibility, written: alias.written, typeSites: alias.typeSites, mutableFunction: alias.mutableFunction)
		end 'returned'
	end 'instanceViewAlias'

	function storedFunctionAliasParam(paramType MaxonType, name immutable ByteArray, aggregateName immutable ByteArray, capability ParamCapability, marked bool) returns FunctionAliasParam
		return FunctionAliasParam.create(maxonTypeTag(paramType), name: name, typeName: self.functionAliasTypeName(paramType), identity: functionAliasSlotIdentity(paramType), aggregateName: aggregateName, capability: capability, marked: marked)
	end 'storedFunctionAliasParam'

	function functionAliasForName(name ByteArray) returns DeclaredFunctionAlias
		return try self.instanceViewFunctionAlias(name) otherwise self.signatures.functionAliasInAnyFile(name)
	end 'functionAliasForName'

	function functionAliasMeantFrom(name ByteArray, readerFilePath FilePath) returns DeclaredFunctionAlias
		return try self.instanceViewFunctionAlias(name) otherwise self.signatures.functionAliasFrom(name, readerFilePath: readerFilePath)
	end 'functionAliasMeantFrom'

	function instanceViewFunctionAlias(name ByteArray) returns DeclaredFunctionAlias throws MapError
		let at = try self.memos.instanceViewAliases.get(name)
		return DeclaredFunctionAlias.declared(try self.artifact.functionTypeAliases.get(at) otherwise panic("Parser.instanceViewFunctionAlias: instance view '{String.from(name)}' was filed at {at}, past the artifact's function aliases — the index is written in the same act as the push"))
	end 'instanceViewFunctionAlias'

	// ⭐⭐ **WHAT SURFACE A SLOT DECLARED IN A SHARED GENERIC BODY WEARS WHEN IT IS READ THROUGH A CONCRETE
	// INSTANCE — the twin of the door above, and it must be asked WHEREVER THAT ONE IS.** The type and the
	// surface are two halves of one crossing: the receiver's instance fixes what a `returns Element` IS, and the
	// receiver's ARGUMENT SPELLING fixes which member roster the value that comes back may reach. The door above
	// can never carry the second half — `Array with __ManagedMemory` and `Array with ByteArray` are one
	// `GenericInstanceId` by design — so a caller that retypes and does not also re-surface hands back a value
	// whose roster is the wrong one.
	//
	// ⛔ **MEASURED, which is what says the two halves are not merely symmetric but both required:** inside
	// `function peek(c BufCell)` over `typealias BufCell = Cell with __ManagedMemory`, `c.get().length()` was
	// **E2015 … `Array` member 'length'** — the buffer roster's first member refused on a value whose argument
	// the author spelled `__ManagedMemory`, while `c.get().count()` on the `Cell with ByteArray` spelling
	// answered. The roster, exactly inverted, at the one declared position the other buffer-surface marks do not reach.
	//
	// ⚠ **IT IS THE RECEIVER'S MARK THAT CARRIES THE SPELLING, AND NOTHING ELSE CAN.** `bufferSurfaceElements`
	// says *argument `BufferSurfaceArgPosition` of this value's instance was spelled the buffer*; it is written
	// from a declared position (`markDeclaredSurface`), from a builtin `Array` factory
	// (`emitOwnedContainerCreate`) and from a declared generic's factory
	// (`retypeGenericAliasConstructorResult`) — the three ways a value of such an instance is minted.
	//
	// A receiver with no mark returns the shared empty tree before anything is asked of the index, which is
	// every receiver in a program that never writes `__ManagedMemory`.
	function slotSurfaceThroughReceiver(box ValueId, declared MaxonType) returns immutable DeclaredSurface
		if self.tagOf(box) != ValueTypeTag.genericInstance 'notAConcreteInstance'
			return plainDeclaredSurface()
		end 'notAConcreteInstance'

		if not self.valueElementIsBufferSurface(box) 'itsArgumentNamesNoBuffer'
			return plainDeclaredSurface()
		end 'itsArgumentNamesNoBuffer'

		return surfaceOfRootBits(self.signatures.surfaceBitsThroughInstanceArg(declared, id: self.valueInstanceId(box), interner: self.artifact.typeNames, readerFilePath: self.job.path))
	end 'slotSurfaceThroughReceiver'

	// ⭐ **THE ONE `loadIndirect` EMIT.** A field read (`p.x`), a union tag load, a union payload read, a
	// capturing closure's
	// env-slot read (`emitCaptureRead`), a String record's field (`emitLoadStringField`) and a global's
	// slot (`emitGlobalLoad`) all reach here. One op shape, so the value's SOURCE type (`declared`,
	// minted onto the tag column so a nested `match` or the shift rule reads what the source said) and
	// its STORAGE type (the concrete primitive the op carries, because `maxonTypeToStdType` panics on a
	// `named`) are split in exactly one place. See `emitFieldLoad`'s header for why the two differ.
	//
	// ⚠ **A CALLER THAT PASSES THE SAME TYPE TWICE IS STILL A CALLER, NOT AN EXCEPTION.** The String
	// record and the global do exactly that, each for its own stated reason, and each routes through here
	// rather than owning a raw `artifact.emitOp`. The hazard is not the duplicated line; it is that the
	// split between declared and storage would then have two more homes free to disagree with this one,
	// with no compile error to say so.
	function emitIndirectLoad(declared MaxonType, box ValueId, offset ByteOffset, storageType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(declared)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.loadIndirect(result, addr: box, offset: offset, valueType: storageType), range: range)
		return result
	end 'emitIndirectLoad'

	// `storeIndirect <box> <offset> <value>` — the one op a field write is, and the exact mirror of
	// `emitFieldLoad` (same offset, same storage type, same reason for each).
	//
	// **THE ONE STORE SITE**, shared by the two paths that write a field: the `Self{…}` loop filling
	// a fresh box (`emitStructLiteral`) and the assignment statement writing a live one
	// (`parseFieldAssignment`). They were one line apart from being two copies of the offset-and-
	// width derivation, which is the pair that must never disagree — a literal that stored `y` at
	// the width the layout says and an assignment that stored it at another would corrupt the box
	// silently.
	function emitFieldStore(box ValueId, layout StructLayout, index FieldIndex, value ValueId, range SourceRange)
		let declared = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)
		let offset = layout.offsetOfField(index)

		if maxonTypeTag(declared) != ValueTypeTag.interfaceRef 'oneWordSlot'
			self.emitIndirectStore(box, offset: offset, value: value, storageType: self.fieldStorageType(declared), range: range)
			return
		end 'oneWordSlot'

		// ⭐ **THE WITNESS HALF, STORED BESIDE THE VALUE** — the exact mirror of `emitFieldLoad`'s second load, at
		// the same offset, and the write that makes the read's answer a fact about the box rather than a guess.
		// Both the `Self{…}` fill and the assignment statement land here, so a literal that recorded the
		// conformer and an assignment that did not is unrepresentable.
		let witness = self.fieldStoreWitness(box, layout: layout, index: index, declared: declared, value: value, range: range)
		self.emitIndirectStore(box, offset: offset, value: value, storageType: self.fieldStorageType(declared), range: range)
		self.emitIndirectStore(box, offset: offset + InterfaceWitnessHalfOffset, value: witness, storageType: MaxonType.integer, range: range)
	end 'emitFieldStore'

	// ⭐⭐ **A STORE INTO AN INTERFACE-TYPED FIELD IS A WIDENING SITE, AND THE FIELD'S DECLARED TYPE NAMES THE
	// WITNESS** — as a callee's declared parameter names it for an argument. A value already held at the
	// interface forwards the witness it was paired with; a concrete conformer gains
	// `__witness_<conformer>.<Iface>` through an `existentialWitness` op, which lowering materializes through
	// the argument position's own door.
	//
	// ⚠ **EVERY STORE IS RECORDED, FORWARDED OR NOT.** A conformer owes the conformance verdict and the field's
	// `with` claim; a forwarded value owes the claim when the field wrote it over its declaring type's own
	// parameter. Neither is this tier's to decide — a conformer's `implements` clause is recorded when its own
	// file is parsed — so `SemanticCheck.checkExistentialFieldStores` asks both, whole-program.
	function fieldStoreWitness(box ValueId, layout StructLayout, index FieldIndex, declared MaxonType, value ValueId, range SourceRange) returns ValueId
		let interfaceName = interfaceNameOfType(declared, typeNames: self.artifact.typeNames)
		self.recordExistentialStore(ExistentialFieldStore.create(value, subject: box, interfaceName: interfaceName, claims: self.signatures.fieldExistentialSites(layout, index: index), fieldSite: freeze self.fieldSiteName(layout, index: index).toByteArray(), place: ExistentialStorePlace.structField, line: range.line, column: range.column, filePath: self.job.path))

		return self.widenedWitnessOf(value, interfaceName: interfaceName, range: range)
	end 'fieldStoreWitness'

	function recordExistentialStore(store ExistentialFieldStore)
		self.bodyState.existentialFieldStores.push(store)
	end 'recordExistentialStore'

	// The witness half a value takes where a STORE widens it into a place declared at `interfaceName` — a
	// struct field or a message payload.
	function widenedWitnessOf(value ValueId, interfaceName ByteArray, range SourceRange) returns ValueId
		if self.tagOf(value) == ValueTypeTag.interfaceRef 'forwardsItsOwnWitness'
			return self.witnessOfValue(value)
		end 'forwardsItsOwnWitness'

		let witness = self.mintValueOfType(MaxonType.integer)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.existentialWitness(witness, interfaceName: interfaceName, conformer: value), range: range)
		return witness
	end 'widenedWitnessOf'

	// ⭐ **THE ONE `storeIndirect` EMIT**, the mirror of `emitIndirectLoad` above and true on the same
	// terms. A field write, a union tag store, a union payload store, a union's unused-slot zero-fill, a
	// capturing closure's env-slot fill (`buildClosureEnv`) and a String record's field
	// (`emitStoreStringField`) all reach here — one op shape, so
	// the offset-and-width derivation a box's stores must agree on lives in one place (a literal storing
	// `y` at one width and an assignment storing it at another would corrupt the box silently — see
	// `emitFieldStore`).
	// ⭐⭐ **THE VALUE A BINDING CURRENTLY HOLDS — THE ONE DOOR EVERY CONSUMER OF A BINDING'S VALUE ASKS.**
	//
	// For nearly every binding this is `boundValue`, the SSA value the name aliases. For a CELL-resident one
	// it is a fresh `loadIndirect`, because `boundValue` holds the cell's ADDRESS and handing that to a
	// consumer would give it a pointer where the source asked for a value.
	//
	// ⚠⚠ **THIS IS THE SAME CENSUS THE SELF-FIELD ALIAS ONCE OWED, AND THAT ONE COST THREE WRONG ANSWERS.**
	// `VarInfo.boundValue`'s header records them: three readers took an alias's unset 0 for a real id, and
	// each was a silent miscompile rather than a compile error — `return count` compiling to `return self`.
	// A cell binding is the same hazard with the opposite sign: `boundValue` is a REAL id, so nothing panics;
	// the consumer simply acts on the box instead of on what is in it. Every site that wants a binding's
	// VALUE goes through here. The sites that legitimately want `boundValue` itself are the ones asking about
	// OWNERSHIP or IDENTITY — the drop at scope exit, the owned-binding scans, the move/alias searches — and
	// for a cell binding the thing this frame owns and the thing another name could alias IS the cell.
	//
	// ⚠ The loop-phi and merge-snapshot rebinders are not in either group and need no
	// arm: a cell binding is never pushed into `mutableVars` (`declareCellLocal`), so no phi machinery can
	// reach one.
	function bindingValue(binding VarInfo, range SourceRange) returns ValueId
		if binding.isCellBinding 'livesInACell'
			let occupant = self.readOfAnUnadoptedLocal(binding, value: self.wearAdoptedBrand(binding, value: self.emitCellLoad(binding.varType, box: binding.boundValue, range: range)))
			self.carryCapability(binding.boundValue, target: occupant)
			self.bodyState.cellOccupantReads = withCellOccupantRead(self.bodyState.cellOccupantReads, occupant: occupant, read: CellOccupantRead.create(binding, epoch: binding.cellEpoch.epochValue()))
			return occupant
		end 'livesInACell'

		return binding.boundValue
	end 'bindingValue'

	// ⭐⭐ **READ A CELL-RESIDENT BINDING** — the one load, paired with the one store below. A cell
	// holds exactly one value at offset 0, so unlike an env slot there is no index to get wrong; what MUST
	// agree is the WIDTH, which is why both sides ask `wordSlotStorageType` rather than spelling a width.
	//
	// The declared type goes through `resolveFloatAliasType` for `emitCaptureRead`'s reason: a ranged
	// INT alias must stay `named` (its NAME carries the signedness `valueIsUnsigned` reads), while the
	// one alias whose VALUE is a different machine class is collapsed here so the load is minted at
	// the right register class. The collapsed float alias's NAME comes back off the box the cell
	// address wears (`wearAliasOf`), so the loaded value stays nominal.
	//
	// ⭐⭐ **A CELL IS A REBINDABLE SLOT, AS A MUTABLE FIELD IS.** `emitCellStore` decrefs the
	// occupant it displaces (`reassignBindingValue`'s cell arm), so `let old = n` + `n = Node.create(99)` on a
	// by-reference parameter leaves `old` naming freed memory for the same reason as a field's. MEASURED without
	// this line: `refcount-reassigned-slot-borrow/byref-param-reassign-then-read-borrow` returned
	// **1061109567** (`0x3F3F3F3F`, the freed-slab fill) where the spec pins 5.
	//
	// ⚠ **IT IS MARKED AT THE LOAD, NOT AT THE PARAMETER**, because that is where the field read marks and
	// because the parameter is not the only cell: a `var` LOCAL promoted to a cell (`declareCellLocal`, so a
	// callee can write it) is rebindable by this frame's own store and dangles identically. One door covers
	// both, which is the census argument `bindingValue` makes directly above.
	function emitCellLoad(cellVarType MaxonType, box ValueId, range SourceRange) returns ValueId
		let loaded = self.loadCellOccupant(cellVarType, box: box, range: range)
		self.wearAliasOf(loaded, source: box)
		self.carryFromSharedRecord(loaded, from: box, source: self.bodyState, path: ValueCarryPath.cellLoad)

		if self.valueMayNameARecord(loaded) 'managedOccupant'
			self.markOverwritableSlotRead(loaded)
		end 'managedOccupant'

		if self.cellHoldsAPromise(cellVarType) 'aPromiseOccupant'
			self.recordConsumablePromiseSlot(loaded, container: box, index: self.emitLiteral(ParameterCellValueOffset as FullRangeInt, valueType: MaxonType.integer, range: range), isField: true)
		end 'aPromiseOccupant'

		// ⭐⭐ **THE IMMUTABLE-GLOBAL MARK COMES BACK OUT OF THE CELL.** A cell holding an immutable global's record
		// hands that same record to every reader, so the load inherits the mark the STORE put on the cell. Its
		// absence was a wrong answer and not a cosmetic gap: a `var` that a closure captures becomes
		// cell-resident, and that alone launders the taint (MEASURED) — `grow(b)` in the very
		// frame that owns `b` compiles and mutates a `let` global (exit 8) purely because a closure elsewhere
		// in the body had turned `b` into a cell, while the identical program without that closure is refused.
		return loaded
	end 'emitCellLoad'

	// ⭐⭐ **WRITE A CELL-RESIDENT BINDING** — the rebind, which for this binding kind is a store and
	// not a `Scope.setValue`. That is the whole of what makes a caller observe a callee's `x = 99`.
	function emitCellStore(binding VarInfo, value ValueId, range SourceRange)
		self.storeCellOccupant(binding.boundValue, cellType: binding.varType, value: value, range: range)
		self.forgetImageRecordMark(binding.boundValue)
		self.carryFromSharedRecord(binding.boundValue, from: value, source: self.bodyState, path: ValueCarryPath.cellStore)

		// ⭐ **THE CELL ITSELF CARRIES THE IMMUTABLE-GLOBAL MARK** — put on the BOX rather than on the occupant,
		// because the occupant is a value this frame may never name again while the cell is what every later
		// read, every capture and every write door has in hand (`boundValue` of a cell binding IS the cell).
		//
		// The marks describe the CURRENT occupant, so a store replaces them.
	end 'emitCellStore'

	function loadCellOccupant(cellVarType MaxonType, box ValueId, range SourceRange) returns ValueId
		let cellType = self.resolveFloatAliasType(cellVarType, scopeFilePath: self.job.path)
		let loaded = self.emitIndirectLoad(cellType, box: box, offset: ParameterCellValueOffset, storageType: self.wordSlotStorageType(cellType), range: range)

		if parameterCellHoldsAWitness(cellType) 'andItsWitness'
			self.pairInterfaceWitness(loaded, witness: self.emitIndirectLoad(MaxonType.integer, box: box, offset: ParameterCellWitnessOffset, storageType: MaxonType.integer, range: range))
		end 'andItsWitness'

		return loaded
	end 'loadCellOccupant'

	function storeCellOccupant(cell ValueId, cellType MaxonType, value ValueId, range SourceRange)
		let resolved = self.resolveFloatAliasType(cellType, scopeFilePath: self.job.path)
		self.emitIndirectStore(cell, offset: ParameterCellValueOffset, value: value, storageType: self.wordSlotStorageType(resolved), range: range)

		if parameterCellHoldsAWitness(resolved) 'andItsWitness'
			self.emitIndirectStore(cell, offset: ParameterCellWitnessOffset, value: self.widenedWitnessOf(value, interfaceName: interfaceNameOfType(resolved, typeNames: self.artifact.typeNames), range: range), storageType: MaxonType.integer, range: range)
		end 'andItsWitness'
	end 'storeCellOccupant'

	function emitIndirectStore(box ValueId, offset ByteOffset, value ValueId, storageType MaxonType, range SourceRange)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.storeIndirect(box, offset: offset, value: value, valueType: storageType), range: range)
	end 'emitIndirectStore'

	// The CONCRETE `MaxonType` a SLOT holding a `declared`-typed value is accessed as — what the
	// `loadIndirect`/`storeIndirect` carries, and the only type in the compiler that says how wide
	// the access is.
	//
	// TWO kinds of slot ask it, and they are the same question: a struct/union FIELD, whose declared
	// type comes from the layout, and a capturing closure's ENV SLOT, whose declared type comes from
	// the captured binding. The name predates the second caller; it is left alone because three files
	// outside the parser cite it by name (`Project`, `TypeResolution`, `SignatureIndex`).
	//
	// It resolves a `named` alias through `signatures.aliasOf`, the SAME whole-program door THE
	// SHIFT RULE already asks (`valueIsUnsigned`), for the same reason: an alias declared in another
	// file is still an alias here, and this file's own table would answer for neither it nor a
	// forward reference.
	//
	// ⚠ **IT IS THE SECOND STATEMENT OF "WHAT A `named` TYPE DENOTES", AND `TypeResolution.
	// resolveNamedType` IS THE FIRST.** That is the standing shape of the two registries (see
	// `SettledDeclarations.structLayouts`): the sweep answers the PARSER, the project registry answers
	// the AUTHORITY, and the alias half is written in both places. What forces a slot's type to be
	// resolved at PARSE time is the op: `resolveTypes` never rewrites an op's type, so the parser is
	// the last tier that can make it concrete.
	// ⭐⭐ **THE CASCADE ITSELF LIVES IN `SignatureIndex`, BECAUSE A SECOND FAMILY OF ASKER EXISTS
	// WITHOUT A PARSER.** A top-level `static let origin = Pair{a: 1}` resolves its box's slot widths on the
	// INDEX side — `SynthesizedFunction` holds neither an interner nor the alias registry — and a slot stored
	// at one width by `__module_init` and loaded at another by a body is a corrupted box no diagnostic can
	// report. The two facts only a `Parser` holds are the interner an id was minted in and the READER's file
	// path, so those are what this supplies; everything else is `slotStorageType`'s, once. That is exactly the
	// arrangement `denotedSlotType` states for the id-keyed vs name-keyed halves of the type cascade.
	function fieldStorageType(declared MaxonType) returns MaxonType
		return slotStorageType(self.signatures, declared: declared, typeNames: self.artifact.typeNames, readerFilePath: self.job.path)
	end 'fieldStorageType'

	// A type-qualified numeric bound used as a VALUE (`let x = u16.max`, `if v == u64.max`).
	// The same three tokens a range declaration's endpoint is built from, resolved through
	// the same table — so `int(0 to u64.max)` and `v == u64.max` can never disagree about
	// what `u64.max` is. It materializes an ordinary integer literal.
	function parseTypeQualifiedBoundExpression() returns ValueId throws SourceParseError
		let boundTok = self.current()
		let bound = try self.parseTypeQualifiedBound(false)
		let value = self.emitLiteral(bound.value, valueType: MaxonType.integer, range: SourceRange.ofToken(boundTok))

		// ⭐ **THE SITE THAT KNOWS, MARKING FOR THE SITES THAT ASK** (`unsignedMaxLiterals`). The
		// bound already carries `exceedsSignedMax` — derived at construction from the qualifier and the
		// value, for the range-declaration check — so this is a hand-off of an existing fact and not a
		// second derivation of it. Every other extreme (`i64.max`, `u32.max`, `i8.min`) materializes a
		// pattern whose signed reading IS its value, so none of them needs marking and none is marked.
		if bound.exceedsSignedMax 'wroteTheUnsignedExtreme'
			self.markAboveSignedMax(value)
		end 'wroteTheUnsignedExtreme'

		// ⭐ **THE SAME HAND-OFF, THE OTHER DIRECTION** (`writtenNegativeLiterals`): `i8.min` … `i64.min` name
		// negative numbers, and for every extreme BUT ONE the stored pattern IS the value, so the value test
		// decides it. The one exception is `u64.max`, whose pattern is `-1` — which is exactly what the arm
		// above records — so the two marks are made MUTUALLY EXCLUSIVE here rather than left to a value test
		// that cannot tell them apart. Marking both would say a literal is the largest unsigned AND a
		// negative number, and the two readers would then answer opposite things about one value.
		if not bound.exceedsSignedMax 'notTheUnsignedExtreme'
			self.markWrittenNegative(value, value: bound.value)
		end 'notTheUnsignedExtreme'

		return value
	end 'parseTypeQualifiedBoundExpression'

	// Resolve a variable reference to the SSA value its binding aliases — the
	// value-substitution model emits NO load op; the reference simply IS the bound
	// value. A name with no local binding may still be a TOP-LEVEL CONSTANT (which inlines) or a
	// slot-backed TOP-LEVEL `let` (which loads); only a name that is none of the three is a positioned parse
	// error (undefinedVariable).
	//
	// LOCAL FIRST. A local binding SHADOWS a top-level constant of the same name — `let OFFSET = 10`
	// at file scope and `let OFFSET = 2` inside a function means 2 in that function, which is what
	// every language with both scopes does. A top-level constant is consulted only once a bare name
	// has failed to resolve as a local.
	//
	// **CONSTANT BEFORE GLOBAL, and the order costs nothing**: the two are disjoint by construction —
	// one storage key holds ONE decl, and `constantValueOf`/`globalDeclFor` each answer only for
	// their own kind — so at most one of the two probes can ever hit. The order is readability, not
	// precedence.
	// ⚠ **A SELF-FIELD ALIAS IS TESTED BEFORE `lookupValue`, AND THE ORDER IS LOAD-BEARING RATHER
	// THAN TIDY.** An alias aliases no SSA value — a read of it is a `loadIndirect`, so there is
	// nothing for `boundValue` to hold and it is left 0. `lookupValue` would hand that 0 back as if
	// it were the answer, and ValueId 0 is the RECEIVER: `return count` inside a method would
	// silently compile to `return self`, reading a box pointer as an integer. A wrong answer with
	// no diagnostic anywhere.
	// ⭐ **IT ALSO PUBLISHES WHAT THE NAME RESOLVED TO, for the ONE consumer no ValueId can serve** —
	// `lastBareBindingImmutableName`, the E3207 blame name of a bare-identifier call ARGUMENT (see
	// `bareArgImmutableName`). Each arm that can answer sets it, through the same `immutableReceiverNameOf`
	// a receiver asks, so an argument and a receiver naming the same binding get the same verdict.
	function parseVariableReference() returns ValueId throws SourceParseError
		// Captured before the cursor leaves it: a by-reference call argument identifies the ONE read that may
		// take a cell's address by the token it stands on (`cellArgumentToken`).
		let site = CellArgumentToken.at(self.pos)

		// A KEYWORD-named binding is read here too — `return type` inside `function identity(type Integer)`.
		// `parsePrimary`'s keyword arm has already established that the name RESOLVES, so this consume never
		// admits a keyword the resolution below would then have to reject.
		let tok = try self.consumeNameToken(NamePosition.declaration)

		if self.bodyState.scope.isSelfField(tok.value) 'selfField'
			// A self field's writability is the FIELD's own `var`/`let`, exactly as it is for a self-field
			// method receiver (`baseBindingOf`) — the receiver is a parameter and is never `isMutable()`.
			let binding = self.bodyState.scope.getInfo(tok.value)
			let writable = try self.selfFieldIsWritable(binding, nameTok: tok)
			self.statement.lastBareBindingImmutableName = EmptySourceText if writable else tok.value
			return try self.parseSelfFieldRead(tok, site: site, binding: binding)
		end 'selfField'

		// A LOCAL binding: reject a read of one that has been MOVED FROM through the shared liveness guard
		// (`requireBindingLive`), the SAME predicate the field/method base sites ask. This is the bare
		// READ site — a WRITE target routes through `parseAssignment`, which REVIVES the binding, so the
		// check must not run there. A name that is NOT a local (a top-level constant or `var`) is never
		// owned and never moved, so it stays on the original resolve path.
		if self.bodyState.scope.contains(tok.value) 'local'
			let binding = self.bodyState.scope.getInfo(tok.value)
			try self.requireBindingLive(binding, nameTok: tok)
			self.statement.lastBareBindingImmutableName = self.immutableReceiverNameOf(binding, baseTok: tok)

			if self.cellWasRequestedAt(site) 'aRequestedLocal'
				self.statement.argumentRoot = ArgumentRoot.rooted(self.operandRootOf(binding))
			end 'aRequestedLocal'

			// ⭐⭐ **A CELL-RESIDENT NAME ALIASES NO SSA VALUE, so its read is a LOAD** — the same shape
			// the self-field alias two arms up already takes, and for the same reason: `boundValue` holds the
			// CELL, and handing that back would give the caller a pointer where the source asked for a value.
			// Reading through memory at every use is exactly what makes a write from another frame visible here.
			if binding.isCellBinding 'livesInACell'
				// ⭐⭐ **A BY-REFERENCE ARGUMENT ASKED FOR THE CELL ITSELF, so this read hands over the ADDRESS
				// and emits no load at all.** Keyed on the token index rather than on a flag — see
				// `cellArgumentToken` for the `f(x + 1)` wrong answer a flag would give — and CLEARED
				// here, which is also how the call site learns its request was taken.
				if self.cellWasRequestedAt(site) 'handOverTheCell'
					self.noteCellHandedByReference(binding, anchor: tok)

					if not self.statement.cellArgumentWantsAPlace 'theCellAlone'
						self.statement.cellArgumentToken = CellArgumentToken.none
						return binding.boundValue
					end 'theCellAlone'

					self.handOverPlaceStorage(binding.boundValue)
				end 'handOverTheCell'

				return self.bindingValue(binding, range: SourceRange.ofToken(tok))
			end 'livesInACell'

			return self.readOfAnUnadoptedLocal(binding, value: binding.boundValue)
		end 'local'

		// ⭐ **CAPTURE.** The name is not one of the CLOSURE's own bindings (its scope, checked
		// above). If it resolves into an ENCLOSING function's scope it is a CAPTURE: `captureEnclosing`
		// records it in the current closure's capture set and returns the value read out of the env block
		// (one `loadIndirect` — capture is BY VALUE). Checked BEFORE the top-level fall-through so an
		// enclosing local that SHADOWS a same-named global is caught as the capture it is, not silently
		// resolved to the global (a wrong answer). Outside a closure `closureEnclosingFrames` is empty
		// and this returns `notCaptured` after one `count()` read.
		//
		// ⚠ **THE SAME ORDER BINDS A METHOD RECEIVER, WHICH IS THE SAME NAME IN THE SAME POSITION.** It is
		// re-encoded in `parseMethodCall`'s arms and in `methodCallsAt`'s membership tests, because neither
		// can route through this function (one needs a receiver binding, the other a side-effect-free bool).
		// `parseMethodCall` carries the measurement of what the opposite order costs; a change here is a change there.
		match try self.captureEnclosing(tok, site: site) 'capture'
			captured(value) then return value
			notCaptured then break
		end 'capture'

		if self.signatures.functionOutranksBinding(tok.value, readerFilePath: self.job.path) 'aNearerFunctionOfTheName'
			return try self.emitFunctionRef(tok)
		end 'aNearerFunctionOfTheName'

		match self.signatures.bareBindingMeaning(tok.value, readerFilePath: self.job.path) 'meaning'
			ambiguous(candidates) then throw SourceParseError.ambiguousBareName(String.from(tok.value), candidates: renderAmbiguousCandidates(candidates), use: BareNameUse.bindingRead, line: tok.line, column: tok.column)
			unrelated or
			declared then break
		end 'meaning'

		return try self.topLevelBindingReference(tok)
	end 'parseVariableReference'

	function qualifiedBindingIdentityAt(index ElementIndex) returns immutable ByteArray throws AbsentError
		let dots = self.dottedChainLengthAt(index)

		if dots == 0 or not self.signatures.namesANamespace(self.tokenAt(index).value) or self.chainCallFollowsAt(index) 'notAQualifiedRead'
			throw AbsentError.absent
		end 'notAQualifiedRead'

		return try self.signatures.qualifiedBindingIdentity(self.assembleDottedChainAt(index, dots: dots), readerFilePath: self.job.path)
	end 'qualifiedBindingIdentityAt'

	function qualifiedBindingIdentityIsAt(index ElementIndex) returns bool
		let identity = try self.qualifiedBindingIdentityAt(index) otherwise return false
		return not identity.isEmpty()
	end 'qualifiedBindingIdentityIsAt'

	function parseNamespaceQualifiedBindingRead() returns ValueId throws SourceParseError
		let headTok = self.current()
		let dots = self.dottedChainLengthAt(self.pos)
		let memberTok = self.tokenAt(self.pos + dots * TokensPerQualifierSegment)
		let identity = try self.qualifiedBindingIdentityAt(self.pos) otherwise panic("parseNamespaceQualifiedBindingRead: the chain at {self.pos} was claimed as a directory-qualified binding by the arm that calls this, and no longer is")
		self.pos = self.pos + dots * TokensPerQualifierSegment + 1

		let identityTok = Token.create(TokenKind.identifier, line: memberTok.line, column: memberTok.column, value: identity, startByte: headTok.startByte, endByte: memberTok.endByte)
		return try self.topLevelBindingReference(identityTok)
	end 'parseNamespaceQualifiedBindingRead'

	// Capture an enclosing binding into the closure's environment. A name is a capture iff it resolves
	// into one of the enclosing scopes a closure body is nested in (`closureEnclosingFrames`), an
	// enclosing local or parameter. Globals, top-level `let`/`var`, other functions and the closure's
	// own parameters live in no enclosing `Scope`, so they fall through as `notCaptured`.
	//
	// The env slot is assigned in first-seen order and deduped by name, so a capture read twice
	// occupies one slot; the enclosing binding's value and type are recorded now and read after the
	// body parse by `parseClosureExpression` to fill the env. The read loads through the reserved
	// `__env` parameter (`closureEnvValue`).
	function captureEnclosing(tok Token, site CellArgumentToken) returns CaptureResult throws SourceParseError
		let name = self.baseBindingName(tok)

		match self.captureScopeOf(name) 'scope'
			found(_, frame) then return CaptureResult.captured(try self.readCapturedName(name, enclosing: self.capturedFrame(frame).scope, frame: frame, tok: tok, site: site))
			notCaptured then return CaptureResult.notCaptured
		end 'scope'
	end 'captureEnclosing'

	function readCapturedName(name ByteArray, enclosing Scope, frame ElementIndex, tok Token, site CellArgumentToken) returns ValueId throws SourceParseError
		let binding = enclosing.getInfo(name)

		if not binding.isSelfField 'aBindingOfTheEnclosingFrame'
			self.statement.lastBareBindingImmutableName = self.immutableReceiverNameOf(binding, baseTok: tok)
		end 'aBindingOfTheEnclosingFrame'

		let captured = try self.emitCaptureRead(name, enclosing: enclosing, frame: frame, anchor: tok)

		if self.cellWasRequestedAt(site) 'storageTheClosureCannotReach'
			self.answerUnreachableStorageRequest(tok)
		end 'storageTheClosureCannotReach'

		return captured
	end 'readCapturedName'

	function answerUnreachableStorageRequest(tok Token)
		if not self.statement.cellArgumentWantsAPlace 'aByReferencePosition'
			self.statement.lastBareBindingImmutableName = tok.value
			return
		end 'aByReferencePosition'

		self.statement.cellArgumentToken = CellArgumentToken.none
		self.statement.argumentRoot = ArgumentRoot.unreachable
		self.statement.handedPlaceStorage = PlaceStorage.unreachable(tok.value)
	end 'answerUnreachableStorageRequest'

	// Does `name` resolve to a CAPTURE — a binding in any enclosing scope this closure body is nested in? A
	// cheap membership predicate that emits no capture (the actual capture goes through
	// `emitCaptureRead`). Used by `parseDottedPrimary` to route `capturedStruct.field`
	// to field access, and by `requireReceiverInScope` to answer "is the enclosing `self` reachable from
	// here?". False outside a closure (`closureEnclosingFrames` empty).
	//
	// ⚠ It takes the BINDING NAME, not the token: the receiver is bound under `SelfParamName` and no token
	// spells that (`baseBindingName` is the one place the `self` keyword and `__self` are connected). A
	// `tok.value` here would look the receiver up under the word the source happened to write and miss it.
	function nameBindsOrIsCaptured(name ByteArray) returns bool
		return self.bodyState.scope.contains(name) or self.captureScopeOf(name).isFound()
	end 'nameBindsOrIsCaptured'

	// ⭐ **THE CAPTURE-SCOPE WALK — the ONE place that answers "is this name a capture, and from
	// which enclosing frame?"** Shared by the bare read (`captureEnclosing`) and the field/method base
	// (`resolveFieldChain`/`valueBaseAt`), so they cannot disagree about what is captured. Walks the
	// enclosing scopes innermost-first — a name resolves to the nearest scope that binds it, exactly as an
	// ordinary lookup would (`popScope`'s shadowing rules), so the FIRST hit walking down is the capture
	// source. Outside a closure `closureEnclosingFrames` is empty and this returns
	// `notCaptured` after one `count()` read.
	//
	// ⚠ It keys on the BINDING NAME rather than the token, for `nameBindsOrIsCaptured`'s reason: the
	// enclosing RECEIVER is bound under `SelfParamName`, which no token spells (`baseBindingName` maps
	// the `self` keyword to it).
	function captureScopeOf(name ByteArray) returns CaptureScopeResult
		var i = self.closureEnclosingFrames.count()

		while i > 0 'eachEnclosing'
			i = i - 1
			let enclosing = (try self.closureEnclosingFrames.get(i) otherwise panic("captureScopeOf: closureEnclosingFrames.get OOB at {i}")).scope

			if enclosing.contains(name) 'captured'
				return CaptureScopeResult.found(enclosing, frame: i)
			end 'captured'
		end 'eachEnclosing'

		return CaptureScopeResult.notCaptured
	end 'captureScopeOf'

	// Assign (or reuse) the env slot for a captured name and emit its BY-VALUE read: `loadIndirect __env,
	// slot*8`. The slot column (`captureNames`) is env-array order; the parallel `captureValues`/`captureTypes`
	// carry the enclosing value to store and the type to read back, filled in lockstep on FIRST sight only so
	// a name captured twice shares one slot and one env store.
	//
	// ⚠ Keyed by the BINDING NAME, not the token — the enclosing RECEIVER captures under `SelfParamName`,
	// which no token spells. `anchor` positions the read and the diagnostics, and only that.
	function emitCaptureRead(name ByteArray, enclosing Scope, frame ElementIndex, anchor Token) returns ValueId throws SourceParseError
		// `var`, because the read is RECORDED on the binding below — a `let` here is a store through an
		// immutable local (E2013), the same rule `declareInitializedBinding` binds its own `VarInfo` under.
		let binding = enclosing.getInfo(name)

		// ⭐ **A CAPTURE IS A READ OF THE ENCLOSING BINDING, and this is the ONE read door that does not run through
		// `requireBindingLive`**, whose liveness bookkeeping is the enclosing frame's — the closure reads the binding
		// wherever it is called. The enclosing function's E3012 drain happens after this closure has been parsed
		// inline, so without this line `let x = 5` + `function(n Integer) gives n + x` would report `x` unused — a
		// false rejection.
		//
		// ⚠ The NAME half of this mention lands in the CLOSURE's `referencedNames`, which the restore
		// discards — so `parseClosureExpression` pushes the capture names back into the enclosing function's
		// list at the restore, exactly as the oracle re-adds `captures` to `_referencedVars`. The bit above
		// excuses THIS binding; the re-push is what excuses another binding of the same name.
		self.markBindingReferenced(binding)
		self.noteCapturedLetCastRead(binding, frame: frame, nameTok: anchor)

		// ⭐⭐ **A SELF-FIELD ALIAS IS NOT A CAPTURABLE BINDING — IT HOLDS NO VALUE, AND `boundValue` 0 IS
		// THE RECEIVER.** `createSelfField` leaves `boundValue` 0 because a read of the alias is a
		// `loadIndirect` through the receiver; capturing it would store the enclosing method's `self` BOX
		// in the env slot and hand it back as the field, with no diagnostic. With the field declared
		// through a ranged alias the same capture would instead panic in lowering, because the env slot's
		// type is filled from `binding.varType` at parse time and a `named` reaches `maxonTypeToStdType`
		// unresolved.
		//
		// ⭐ **SO THE BARE NAME IS NOT CAPTURED — THE RECEIVER IS, AND THE FIELD IS READ THROUGH IT.** That is
		// exactly what the alias MEANS (`n` is `self.n`), so it routes to `parseSelfFieldRead`, the one
		// self-field read door, whose `requireReceiverValue` resolves the enclosing receiver as the capture it
		// is. The env therefore holds ONE slot — the receiver — however many fields the body names, and both
		// spellings of a field read emit the identical `loadIndirect` off it.
		//
		// ⚠ It cannot recurse: the receiver's OWN binding is a parameter, so the capture this delegation
		// triggers reaches this same routine with `isSelfField` false.
		if binding.isSelfField 'capturedSelfField'
			return try self.parseSelfFieldRead(anchor, site: CellArgumentToken.none, binding: binding)
		end 'capturedSelfField'

		if self.signatures.valueIsLinear(maxonTypeTag(binding.varType), nameId: typeNameIdOf(binding.varType), from: self.artifact.typeNames) 'aLinearCapture'
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "a closure cannot capture '{String.from(anchor.value)}', a linear value: a linear value {LinearValueResidence}, so no closure keeps one", line: anchor.line, column: anchor.column)
		end 'aLinearCapture'

		self.noteOperandRead(binding, at: self.pos)

		// ⭐ **DECLARED vs STORAGE, at an env slot.** `captureType` is what the SOURCE said, and it is
		// what the read's value is minted as — a ranged INT alias stays `named` on purpose, because its
		// NAME is what carries the signedness `valueIsUnsigned` reads (a captured `int(0 to u64.max)`
		// must still `shr` zero-filling), and `resolveFloatAliasType` has already collapsed the one
		// alias whose VALUE is a different machine class (its NAME is put back on the read by
		// `wearCapturedFloatAlias`). The OP, though, carries a WIDTH, and a `named`
		// reaches `maxonTypeToStdType` unresolved — so the slot's type goes through `fieldStorageType`,
		// the same door a struct field's width comes from and the same one `buildClosureEnv`'s store
		// asks. That the two ask ONE routine is the invariant, not a tidiness: a slot filled at one
		// width and read at another corrupts the environment silently.
		let captureType = self.resolveFloatAliasType(binding.varType, scopeFilePath: self.job.path)

		let range = SourceRange.ofToken(anchor)
		let slot = self.captureSlotFor(name, captureType: captureType, anchor: anchor)
		let captured = self.emitIndirectLoad(captureType, box: self.closureEnvValue(), offset: envSlotOffset(slot), storageType: self.wordSlotStorageType(captureType), range: range)
		self.bodyState.capturedSlots = withCapturedSlot(self.bodyState.capturedSlots, value: captured, slot: slot)

		if captureCarriesAWitnessSlot(maxonTypeTag(captureType)) 'aFatPointer'
			self.pairInterfaceWitness(captured, witness: self.closureEnvWord(existentialWitnessSlotIn(self.bodyState.captureNames, name: name), anchor: anchor))
		end 'aFatPointer'

		if typeIsPromiseStorage(self.signatures, t: captureType) 'aCapturedPromise'
			self.bodyState.capturedPromiseReads = withValueMarked(self.bodyState.capturedPromiseReads, value: captured)
		end 'aCapturedPromise'

		self.carryFromSharedRecord(captured, from: binding.boundValue, source: self.capturedFrame(frame).body, path: ValueCarryPath.capture)
		self.wearCapturedFloatAlias(captured, binding: binding, frame: frame)
		return self.readOfAnUnadoptedLocal(binding, value: captured)
	end 'emitCaptureRead'

	function wearCapturedFloatAlias(captured ValueId, binding VarInfo, frame ElementIndex)
		if not tagIsFloat(self.tagOf(captured)) 'notAFloat'
			return
		end 'notAFloat'

		let enclosing = self.artifact.module.getFunc(self.capturedFrame(frame).funcIndex)
		let enclosingTag = try enclosing.valueTags.get(binding.boundValue) otherwise panic("wearCapturedFloatAlias: the enclosing function has no type slot for v{binding.boundValue} — a binding's value is minted in the function that declared it")
		let aliasId = try enclosing.valueNameIds.get(binding.boundValue) otherwise panic("wearCapturedFloatAlias: the enclosing function has no type-name slot for v{binding.boundValue} — the two type columns are filled in lockstep")

		if enclosingTag == ValueTypeTag.float and aliasId != UnnamedTypeId 'theBindingWearsOne'
			self.wearFloatAlias(captured, aliasId: aliasId)
		end 'theBindingWearsOne'
	end 'wearCapturedFloatAlias'

	// The env slot for `name`, appending a fresh one (recording the enclosing value + type to store) on first
	// sight and reusing it thereafter. Dedup keeps `multiple-captures` (`x + a + b`) at one slot per distinct
	// name and, more importantly, keeps a name read twice from storing — and later dropping — two slots.
	function captureSlotFor(name ByteArray, captureType MaxonType, anchor Token) returns EnvSlotIndex
		for k in 0 upto self.bodyState.captureNames.count() 'existing'
			let seen = try self.bodyState.captureNames.get(k) otherwise panic("captureSlotFor: captureNames.get OOB at {k}")

			if seen == name 'reuse'
				return k
			end 'reuse'
		end 'existing'

		let slot = self.claimCaptureSlot(name, captureType: captureType, anchor: anchor)

		if captureCarriesAWitnessSlot(maxonTypeTag(captureType)) 'aFatPointer'
			_ = self.claimCaptureSlot(existentialWitnessCaptureName(name), captureType: MaxonType.integer, anchor: anchor)
		end 'aFatPointer'

		return slot
	end 'captureSlotFor'

	function claimCaptureSlot(name ByteArray, captureType MaxonType, anchor Token) returns EnvSlotIndex
		self.bodyState.captureNames.push(name)
		self.bodyState.captureValues.push(CapturedValue.unfilled)
		self.bodyState.captureTypes.push(captureType)
		self.bodyState.captureAnchors.push(anchor)
		return self.bodyState.captureNames.count() - 1
	end 'claimCaptureSlot'

	// A bare name that is not a local: a top-level constant, a slot-backed top-level `let`, or nothing.
	//
	// A top-level CONSTANT is a `let`, so it is immutable wherever it is read — and for a MANAGED one that
	// is not a formality: `let G = "hi"` materializes the ONE immortal `.rdata` record every read of those
	// bytes shares, so a callee that appended through it would write read-only memory, which E3207
	// refuses. It publishes its name for the same reason a `let` local does.
	function topLevelBindingReference(tok Token) returns ValueId throws SourceParseError
		match self.constantLookup(tok.value, readerFilePath: self.job.path) 'constant'
			found(payload, tag, typeName) then return self.readFoldedConstant(tok, payload: payload, tag: tag, typeName: typeName)
			foundManaged(bytes, kind) then return self.recordImmutableConstantRead(tok, value: try self.emitManagedConstant(bytes, kind: kind, range: SourceRange.ofToken(tok)))
			foundImageRecord(image) then return self.recordImmutableConstantRead(tok, value: self.emitImageRecordRead(image, tok: tok))
			foundImageBox(nodes, root, typeName, tag) then return self.recordImmutableConstantRead(tok, value: self.emitImageBoxRead(nodes, root: root, typeName: typeName, tag: tag, tok: tok))
			recordDeferred then return self.readOfADeferredRecord()
			poisoned then return self.readOfAFailedConstant()
			notFound then break
		end 'constant'

		if self.job.initializerRole == InitializerRole.sweepFold 'aSweepReadsNoSlot'
			return try self.sweepReadOfAnUnfoldedName(tok)
		end 'aSweepReadsNoSlot'

		return try self.topLevelGlobalRead(tok)
	end 'topLevelBindingReference'

	function sweepReadOfAnUnfoldedName(tok Token) returns ValueId throws SourceParseError
		match self.signatures.resolveFunctionName(tok.value, readerFilePath: self.job.path) 'resolution'
			declaration or
			ambiguous then return self.readOfADeferredRecord()
			undeclared then throw SourceParseError.undefinedVariable(String.from(tok.value), line: tok.line, column: tok.column)
		end 'resolution'
	end 'sweepReadOfAnUnfoldedName'

	function constantLookup(name ByteArray, readerFilePath FilePath) returns TopLevelConstantLookup
		return match self.job.initializerRole 'role'
			ordinary gives self.signatures.constantValueOf(name, readerFilePath: readerFilePath)
			sweepFold gives self.signatures.constantValueDuringSweep(name, readerFilePath: readerFilePath, stack: self.constEvalStack, anchors: self.anchors)
			recordProbe gives self.signatures.constantValueDuringProbe(name, readerFilePath: readerFilePath, stack: self.constEvalStack, anchors: self.anchors)
		end 'role'
	end 'constantLookup'

	function readOfAFailedConstant() returns ValueId
		if self.job.initializerRole != InitializerRole.ordinary 'anInitializerParse'
			self.statement.constDependencyFailed = true
		end 'anInitializerParse'

		return self.mintDeferredValue()
	end 'readOfAFailedConstant'

	function readOfADeferredRecord() returns ValueId
		self.statement.constDependsOnARecord = true
		return self.mintDeferredValue()
	end 'readOfADeferredRecord'

	// Publish a top-level constant read's blame name and hand the value straight back —
	// `recordSlotRead`'s shape, for its reason: the two arms above differ only in how the value is
	// materialized, and a `let` is immutable in both.
	function readFoldedConstant(tok Token, payload FullRangeInt, tag ValueTypeTag, typeName ByteArray) returns ValueId
		self.noteModuleLetCastRead(tok, typeName: typeName)
		return self.recordImmutableConstantRead(tok, value: self.emitFoldedConstant(payload, tag: tag, typeName: typeName, range: SourceRange.ofToken(tok)))
	end 'readFoldedConstant'

	// ⭐⭐ **MATERIALIZE A FOLDED CONSTANT AT A USE — and an ENUM CASE takes the door the BODY spelling takes.**
	// `Reg.rdx` written in a body goes through `emitEnumTagLiteral`, which mints a value TAGGED `named(Reg)`
	// while the op it emits carries `integer`; that split is the whole shape of a payload-free enum in this
	// compiler — the value knows its enum, the storage is an i64.
	//
	// ⛔ **EMITTING THE LITERAL AT `MaxonType.named` INSTEAD IS A COMPILER PANIC, MEASURED:**
	// `maxonTypeToStdType: a `named` type must be resolved to a primitive before lowering`. The op's
	// valueType is a STORAGE question and `named` is not an answer to it. Routing here rather than widening
	// `constantValueType` is what keeps the two spellings of `Reg.rdx` — in a body and out of a top-level
	// `let` — one mechanism.
	function emitFoldedConstant(payload FullRangeInt, tag ValueTypeTag, typeName ByteArray, range SourceRange) returns ValueId
		if tagNamesADeclaredType(tag) 'anInlinePackedWord'
			return self.emitInlineRecordWord(payload, typeName: typeName, range: range)
		end 'anInlinePackedWord'

		if tag != ValueTypeTag.named 'aPlainScalar'
			let scalar = self.emitLiteral(payload, valueType: foldedLiteralOpType(tag), range: range)

			if tag == ValueTypeTag.exitCode 'anExitCode'
				self.retypeValue(scalar, valueType: MaxonType.exitCode)
			end 'anExitCode'

			if not typeName.isEmpty() 'anAliasValue'
				let aliasId = self.artifact.typeNames.intern(typeName)

				if tag == ValueTypeTag.integer 'anIntegerAlias'
					self.retypeValue(scalar, valueType: MaxonType.named(aliasId))
				end 'anIntegerAlias' else if tag == ValueTypeTag.float 'aFloatAlias'
					self.wearFloatAlias(scalar, aliasId: aliasId)
				end 'aFloatAlias'

				self.recordValueDeclaredAliasId(scalar, aliasId: aliasId)
			end 'anAliasValue'

			return scalar
		end 'aPlainScalar'

		return self.emitEnumTagLiteral(typeName, tag: payload, range: range)
	end 'emitFoldedConstant'

	function foldedLiteralOpType(tag ValueTypeTag) returns MaxonType
		return MaxonType.integer if tag == ValueTypeTag.exitCode else constantValueType(tag, typeNameId: 0)
	end 'foldedLiteralOpType'

	function emitInlineRecordWord(payload FullRangeInt, typeName ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.structRef, nameId: self.artifact.typeNames.intern(typeName))
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.literal(result, value: payload, valueType: MaxonType.integer), range: range)
		self.noteInlineWordImage(result, payload: payload, typeName: typeName)
		return result
	end 'emitInlineRecordWord'

	function inlineRecordWordType(typeName ByteArray) returns MaxonType
		return MaxonType.structRef(self.artifact.typeNames.intern(typeName))
	end 'inlineRecordWordType'

	function recordImmutableConstantRead(tok Token, value ValueId) returns ValueId
		self.publishModuleLetName(tok)

		return self.recordImageRead(value)
	end 'recordImmutableConstantRead'

	function recordImageRead(value ValueId) returns ValueId
		if self.valueIsAnImageUnionCase(value) 'noFieldsToWrite'
			return value
		end 'noFieldsToWrite'

		return self.recordModuleLetRoot(value)
	end 'recordImageRead'

	function publishModuleLetName(tok Token)
		self.statement.lastBareBindingImmutableName = tok.value
	end 'publishModuleLetName'

	function materializeImageOrInlineBinding(binding ManagedReceiverBinding, tok Token) returns (ValueId, MaxonType)
		return match binding 'binding'
			inlineWord(payload, typeName) gives (self.emitInlineRecordWord(payload, typeName: typeName, range: SourceRange.ofToken(tok)), self.inlineRecordWordType(typeName))
			imageRecord(image) gives (self.recordImageRead(self.emitImageRecordRead(image, tok: tok)), image.valueType)
			imageBox(nodes, root, typeName, tag) gives (self.recordImageRead(self.emitImageBoxRead(nodes, root: root, typeName: typeName, tag: tag, tok: tok)), self.imageBoxType(typeName, tag: tag))
			default panic("materializeImageOrInlineBinding: only an inline word, an imaged record and an imaged box are materialized from the binding — every other arm is answered by its reader before this door")
		end 'binding'
	end 'materializeImageOrInlineBinding'

	// ⭐ **A MODULE-LEVEL `let` READ IS AN IMMUTABLE NAME'S RECORD** wherever it is read, and it can never move.
	function recordModuleLetRoot(value ValueId) returns ValueId
		if self.valueIsManagedHeap(value) and not self.valueIsAValueType(value) 'aRecordOrArray'
			self.setValueCapability(value, capability: ValueCapability.immutable)
		end 'aRecordOrArray'

		return value
	end 'recordModuleLetRoot'

	// ⭐ **A USE OF A TOP-LEVEL MANAGED CONSTANT MATERIALIZES ITS LITERAL** — the managed twin of
	// the `literal`-op inline directly above, and the same storage model: the declaration reserves
	// nothing, and the READ is where the value comes from.
	//
	// ⭐⭐ **A `let` IS IMAGE DATA — BOTH KINDS, AND THE READ IS ONE ADDRESS** (⚖ user ruling). Nothing is
	// created at run time, no count is ever stepped and nothing is mutable, so a worker holding one shares
	// nothing. It emits the very ops the literal itself emits, and the record carries the one immortality mark
	// every count step routes away from — `MmRuntime.MmImmortalRefcount` in its synthetic header, beside
	// `ImmortalRecordCapacity` in its own `capacity@16`:
	//
	//   • a **String** literal is a wholly IMMORTAL `.rdata` record (`lowerStringLiteral`), and
	//     `registerRdataConstant` dedupes it by bytes — so every read of `let name = "Ada"` in the whole
	//     program shares ONE record, materialized once, never allocated and never freed.
	//   • a **byte string** literal is the same shape over the Array record
	//     (`ManagedMemoryRuntime.registerImmortalByteArrayRecord`): six slots in `.rdata` beside their blob,
	//     `capacity@16 = ImmortalRecordCapacity`, deduped by bytes so every read of one declaration reaches
	//     one object. The storage class is passed rather than assumed, because an INLINE `b"…"` and a STORED
	//     global's initializer emit the identical op and must keep an owned heap record a `var` may rewrite.
	//
	// ⚠⚠ **THE BYTE-ARRAY ARM MARKS NOTHING ON THE VALUE, AND THE SELF-COMPILE IS WHAT SETTLED THAT.** A
	// per-value mark cannot answer the question the acquire doors ask, because the value they are handed may
	// be a MERGE PHI: `return A if c else B` over two constants leaves a phi with NO arm promoted
	// (`resolveGivesOwnership` promotes only into an OWNED result), and a phi's provenance is not a
	// compile-time fact at all — the reading `LiteralArgPromotion`'s header already records for the String
	// half of the same question. MEASURED: with the mark, that exact shape `__mm_retain`'d a `.rdata` record
	// and segfaulted, in the compiler's own `SignatureIndex.plainBoxRetainCallee`. The fork is made at RUN
	// TIME instead, off the record's own `capacity@16` — see `retainCalleeOf` and
	// `ManagedMemoryRuntime.__managed_retain`.
	function emitManagedConstant(bytes ByteArray, kind ManagedConstKind, range SourceRange) returns ValueId throws SourceParseError
		return match kind 'k'
			string gives self.emitStringLiteral(bytes, range: range)
			byteArray gives try self.emitByteStringLiteralValue(bytes, range: range)
			character gives self.emitCharacterLiteral(bytes, range: range)
		end 'k'
	end 'emitManagedConstant'

	// ⭐⭐ **A USE OF AN IMAGE-DATA `let` IS ONE `.rdata` ADDRESS** — the record-shaped half of the ⚖ *a `let`
	// is image data* ruling, and the same emitter a byte string's constant read goes through: one
	// `constArrayLiteral` op plus the side-table mark that says which record it materializes
	// (`Project.immortalConstArraySites`). Nothing is allocated, nothing is refcounted and nothing is
	// dropped, so the declaration reserves no storage and the READ costs one instruction however often it
	// runs.
	//
	// ⚠ **NO OWNED TEMP, WHICH IS THE WHOLE OF WHY THE READ IS FREE.** An immortal record is never created,
	// so it owes no `__managed_decref` and a statement-end drop on one would be a write to a read-only page.
	//
	// ⚠ **THE IMMUTABLE-GLOBAL MARK IS STILL TAKEN.** Imaging changes where the record LIVES, not what the
	// language says about the binding: `let` still refuses to be aliased into rebindable storage, and
	// the mark is what carries that refusal to the escape doors.
	function emitImageRecordRead(image TopLevelImageRecord, tok Token) returns ValueId
		let range = SourceRange.ofToken(tok)
		let result = self.mintValue(maxonTypeTag(image.valueType), nameId: typeNameIdOf(image.valueType))
		self.brandValue(result, brand: image.brand)

		match image.kind 'shape'
			// A blob of VALUES: one payload, so the record rides `constArrayLiteral` with the side-table mark
			// that tells the lowering this site is imaged. Filed BEFORE the emit, off the count that IS the
			// index the append will land at — `recordAllocTagSite`'s contract, for its reason.
			constBlob or
			emptyContainer then self.emitImagedConstArrayLiteral(result, image: image, range: range)

			// A table of ADDRESSES: N payloads, and no heap spelling to be told apart from — its own op.
			stringTable(texts, elementDestroy) then self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.immortalStringTable(result, texts: texts, elementSize: image.elementSize, elementDestroy: elementDestroy.clone()), range: range)

			// A declared container's BOX: the arena holds the record and every image object its slots address
			// — the struct-record op, whose scalar-struct spelling is one node with no columns.
			containerBox(nodes, root) then self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.immortalStructRecord(result, nodes: nodes, root: root), range: range)
		end 'shape'

		self.markImageRecordRead(result)
		return result
	end 'emitImageRecordRead'

	// The mark and the op of an imaged constant-blob read, in the one order the mark's contract allows.
	function emitImagedConstArrayLiteral(result ValueId, image TopLevelImageRecord, range SourceRange)
		self.artifact.recordImmortalConstArraySite(image.kind)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.constArrayLiteral(result, elementSize: image.elementSize, elementCount: image.elementCount, bytes: image.bytes), range: range)

		if maxonTypeTag(image.valueType) == ValueTypeTag.genericInstance and image.elementCount > 0 and self.arrayInstanceHoldsBareNumbers(genericInstanceIdOf(image.valueType)) 'aBareNumberArrayImage'
			let words = wordsOfConstBlob(image.bytes, count: image.elementCount as ElementIndex)
			let filed = self.plainConstantArraysForWrite()
			filed.upsert(result, value: words)
			self.recordLiteralColumns(result, pair: ColumnPair.create(image.bounds, second: ColumnBounds.unknown))
		end 'aBareNumberArrayImage'
	end 'emitImagedConstArrayLiteral'

	// ⭐ The type an imaged BOX's value is minted at, in THIS file's interner — the one place the crossing
	// from the index's `typeName` bytes to a `MaxonType` happens, so the value's tag and the layout the
	// chain resolves against cannot come from two interners.
	//
	// ⛔ **THE TAG IS THE INDEX'S ANSWER AND IS NOT RE-DERIVED FROM THE NAME.** A `structRef` box and a boxed
	// union's `named` box are told apart by the OUTCOME that was imaged, and a name alone cannot say which:
	// a struct and a union both spell a bare declared name here.
	function imageBoxType(typeName ByteArray, tag ValueTypeTag) returns MaxonType
		let id = self.artifact.typeNames.intern(typeName)
		return match tag 'shape'
			structRef gives MaxonType.structRef(id)
			named gives MaxonType.named(id)
			default panic("imageBoxType: '{String.from(typeName)}' is an imaged box standing at '{typeTagName(tag)}' — only a constructed struct (`structRef`) and a boxed union case (`named`) are laid down as boxes, and every other tag names a value this door cannot mint")
		end 'shape'
	end 'imageBoxType'

	// ⭐⭐ **A USE OF AN IMAGE-DATA BOX `let` IS ONE `.rdata` ADDRESS TOO** — `emitImageRecordRead`'s twin
	// over the shapes whose mark cannot live in the record. It needs no side table: the op it emits exists
	// only for image data, where `constArrayLiteral` serves an owned heap literal as well and has to be told
	// which of the two this site is.
	//
	// ⚠ **NO OWNED TEMP AND NO DROP**, for the twin's reason: an immortal record is never created, so a
	// statement-end drop on one would be a write to a read-only page. The immutable-global mark is still
	// taken — imaging changes where the record lives, not what `let` means.
	function emitImageBoxRead(nodes ImmortalBoxNodeArray, root ElementIndex, typeName ByteArray, tag ValueTypeTag, tok Token) returns ValueId
		let range = SourceRange.ofToken(tok)
		let result = self.mintValue(tag, nameId: typeNameIdOf(self.imageBoxType(typeName, tag: tag)))
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.immortalStructRecord(result, nodes: nodes, root: root), range: range)

		if not self.valueIsAnImageUnionCase(result) 'aBoxWithFieldsToGuard'
			self.markImageRecordRead(result)
		end 'aBoxWithFieldsToGuard'

		return result
	end 'emitImageBoxRead'

	function valueIsAnImageUnionCase(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.named
	end 'valueIsAnImageUnionCase'

	// ⭐ **A USE OF A TOP-LEVEL CONSTANT INLINES ITS VALUE, AND THAT IS THE WHOLE STORAGE MODEL.**
	//
	// The constant was folded to a number by the declaration sweep, so the reference materializes as
	// an ordinary `literal` op carrying it — indistinguishable, from here down, from a program that
	// wrote the number out. Nothing is loaded, no `.data` slot is reserved, no relocation is emitted
	// and no backend knows this feature exists: `return ANSWER` compiles to exactly what `return 42`
	// compiles to.
	//
	// It goes through `emitLiteral`, so an inlined INTEGER constant lands in the parser's constant
	// column (`recordConst`) exactly as a written-out literal does — which is what keeps `let SHIFT =
	// 1` … `x shl SHIFT` folding, and THE SHIFT RULE seeing a count it can check.
	//
	// **A SLOT-BACKED TOP-LEVEL `let` IS THE OTHER HALF OF THAT STORY, AND IT IS THE OPPOSITE ONE** — see
	// `topLevelGlobalRead` directly below. It is the read that does NOT
	// disappear.

	// A use of a slot-backed top-level `let` loads from its `.data` slot — the exact inverse of a constant's read:
	// nothing is folded, a slot IS reserved, a relocation IS emitted, and the backend very much knows this
	// feature exists. A by-reference argument is the one use that loads nothing, taking the slot's own
	// address instead (`moduleSlotReference`).
	//
	// It emits the GENERAL PAIR — `globalAddr` then `loadIndirect` — rather than a fused
	// `globalLoad`, per the Std memory band's contract: the same two ops a struct field and a
	// heap value read through. The address op is its own value, so a function that reads one
	// global twice materializes the address twice and the ordinary CSE that arrives with the Std
	// optimization passes will fold them — `globalAddr` declares `isPure: true` precisely so that it
	// can.
	//
	// ⚠ The load is NOT hoisted out of a loop that writes the same global, and that is not this
	// function's doing — it is `loadIndirect`'s `isPure: false` (see StdDialect). Get that wrong and
	// this emits perfectly correct IR that a later pass silently breaks.
	function topLevelGlobalRead(tok Token) returns ValueId throws SourceParseError
		match self.signatures.globalDeclFor(tok.value, readerFilePath: self.job.path, into: self.artifact.typeNames) 'global'
			found(label, valueType, brand) then return self.noteGlobalLetMapColumns(self.moduleSlotReference(tok, label: label, valueType: valueType, brand: brand), tok: tok)
			notFound then return try self.emitFunctionRef(tok)
			poisoned then return self.mintDeferredValue()
		end 'global'
	end 'topLevelGlobalRead'

	function noteGlobalLetMapColumns(read ValueId, tok Token) returns ValueId
		if not self.signatures.isMapShapedInstanceAt(self.tagOf(read), nameId: self.valueNameId(read)) 'notAnImmutableMap'
			return read
		end 'notAnImmutableMap'

		match self.globalMapColumnsAnswerFor(tok.value) 'answer'
			known(pair) then self.recordLiteralColumns(read, pair: pair)
			notAnImmutableMapLiteral then return read
		end 'answer'

		return read
	end 'noteGlobalLetMapColumns'

	function globalMapColumnsAnswerFor(name immutable ByteArray) returns GlobalMapColumnsAnswer
		if let answered = try self.memos.globalMapColumns.get(name) 'alreadyAsked'
			return answered
		end 'alreadyAsked'

		var answer = GlobalMapColumnsAnswer.notAnImmutableMapLiteral

		if let pair = try self.signatures.globalMapColumns(name, readerFilePath: self.job.path) 'aMapLiteral'
			answer = GlobalMapColumnsAnswer.known(pair)
		end 'aMapLiteral'

		self.memos.globalMapColumns.file(name, value: answer)

		return answer
	end 'globalMapColumnsAnswerFor'

	// A global read wears the brand its initializer spelled (`let shared = Xs.create()` reads as an `Xs`).
	function moduleSlotReference(tok Token, label ByteArray, valueType MaxonType, brand ByteArray) returns ValueId
		let loaded = self.emitGlobalLoad(label, valueType: valueType, range: SourceRange.ofToken(tok))
		self.brandValue(loaded, brand: brand)

		return self.recordSlotRead(loaded, tok: tok, publishesBlame: true)
	end 'moduleSlotReference'

	// The one slot-read door for a module global, taken by the bare read and the receiver load alike: a
	// `let` receiver left unmarked lets `var q = Origins.get(0)` write the `let`'s record through `q`.
	function recordSlotRead(value ValueId, tok Token, publishesBlame bool) returns ValueId
		let inert = self.signatures.globalIsAPayloadFreeUnionCase(tok.value, readerFilePath: self.job.path)

		// The blame name (a top-level `let` refuses a write through it exactly as a `let` local does) is
		// published here so the constant and the slot-backed halves of a top-level read reach
		// `lastBareBindingImmutableName` through one decision each.
		if publishesBlame 'aBareRead'
			self.publishModuleLetName(tok)
		end 'aBareRead'

		if inert 'noRecordToMark'
			return value
		end 'noRecordToMark'

		self.markImageRecordRead(value)
		return self.recordModuleLetRoot(value)
	end 'recordSlotRead'

	function emitGlobalReceiverLoad(label ByteArray, valueType MaxonType, tok Token) returns ValueId
		let loaded = self.emitGlobalLoad(label, valueType: valueType, range: SourceRange.ofToken(tok))
		return self.recordSlotRead(loaded, tok: tok, publishesBlame: false)
	end 'emitGlobalReceiverLoad'

	// ⭐⭐ **THE ONE WRITER OF `overwritableSlotReads`** — through the install door
	// discipline (`ValueMarkColumn`).
	//
	// Its producers are the ways a managed value comes out of storage a later statement can overwrite:
	// `emitFieldLoad` (every `self.items`, `h.items` and chain hop funnels through it) and
	// `emitCellLoad` (the by-reference parameter and cell-resident `var`, whose store decrefs the
	// occupant it displaces exactly as a field store does). Both gate on the value being MANAGED, so a
	// scalar field — which owns no heap and can be freed by nothing — never enters the set and never costs a
	// hash.
	//
	// ⚠ **THE LIST OF PRODUCERS IS DERIVED BY GREPPING `self.markOverwritableSlotRead(`** rather than
	// remembered — the census `markBufferSurface` keeps two functions down, for this reason.
	function markOverwritableSlotRead(value ValueId)
		self.bodyState.overwritableSlotReads = withValueMarked(self.bodyState.overwritableSlotReads, value: value)
	end 'markOverwritableSlotRead'

	function markElementRead(value ValueId)
		self.bodyState.elementReads = withValueMarked(self.bodyState.elementReads, value: value)
	end 'markElementRead'

	function valueIsAStorageRead(value ValueId) returns bool
		return valueIsMarked(self.bodyState.overwritableSlotReads, value: value) or valueIsMarked(self.bodyState.elementReads, value: value)
	end 'valueIsAStorageRead'

	function propagateSlotReadMarkToPhi(phi ValueId, gives ValueIdArray)
		for give in gives 'eachGive'
			self.propagateSlotReadMarkFrom(phi, give: give)
		end 'eachGive'
	end 'propagateSlotReadMarkToPhi'

	function propagateSlotReadMarkFrom(phi ValueId, give ValueId)
		if valueIsMarked(self.bodyState.overwritableSlotReads, value: give) 'aSlotRead'
			self.markOverwritableSlotRead(phi)
		end 'aSlotRead'

		if valueIsMarked(self.bodyState.elementReads, value: give) 'anElementRead'
			self.markElementRead(phi)
		end 'anElementRead'
	end 'propagateSlotReadMarkFrom'

	// ⭐ **THE ONE WRITER OF `bufferSurfaceValues`** — through the install door
	// discipline (`ValueMarkColumn`). Its callers are the producers of a buffer VALUE and
	// `markDeclaredSurface` below; read them off `grep -n 'self.markBufferSurface('`, never off a list here.
	// ⚠ The CHAINED `.managed` (`arr.managed.setLength(2)`) mints NO value to mark, and it passes the surface
	// along the dispatch instead (`viaManagedField`). Only the VALUE form has a value to mark, and it mints
	// one for exactly that reason.
	//
	// The value is also branded the VIEW of `origin`, the alias the buffer was taken from
	// (`bufferViewBrandOver`), so a diagnostic can tell two views of one instance apart.
	//
	// ⚠⚠ **THE MARK IS A FACT ABOUT A `ValueId`, SO IT DOES NOT SURVIVE TYPE ERASURE — AND A *DECLARED*
	// SPELLING IS THEREFORE AN ENTRANCE A SWEEP OVER VALUE PRODUCERS STRUCTURALLY CANNOT SEE.**
	// `__ManagedMemory` is registered as a generic ALIAS of `Array with Byte`
	// (`ProgramSignatures.registerManagedFileType`), so a parameter, a struct field or a return type SPELLED
	// `__ManagedMemory` resolves to a type indistinguishable from `ByteArray`: unmarked, `m.length()` — the
	// buffer roster's FIRST member — would be refused on it while `m.push(7)` compiled. ⇒ Each of the three
	// carries a *declared-as-the-buffer-alias* bit from its declaration site to the site that binds the
	// value, and marks it here. There is no second surface mechanism: this mark is the one authority.
	function markBufferSurface(value ValueId, origin ByteArray)
		self.bodyState.bufferSurfaceValues = withValueMarked(self.bodyState.bufferSurfaceValues, value: value)
		self.brandValue(value, brand: bufferViewBrandOver(origin))
	end 'markBufferSurface'

	// ⭐ `markBufferSurface`'s inverse — the value no longer denotes a buffer because the record it denoted no
	// longer exists (`foldByteViewIntoStreamWrite`). It is CLEARED rather than left to be unreachable by
	// construction: "no integer-tagged value ever reaches a buffer-surface question" is exactly the kind of
	// premise this compiler keeps finding false, and the mark is one `remove` to retire honestly. No
	// copy-on-write is needed — a value can only be UNMARKED in a function that already marked one, so the
	// set is this function's own by then.
	function unmarkBufferSurface(value ValueId)
		// The removal's "was it there?" answer is not a fact worth asking: the caller has just proved the
		// value IS a byte view, and this door exists to make the mark's absence true, not to report on it.
		unmarkValue(self.bodyState.bufferSurfaceValues, value: value)

		// ⚠ **AND THE SIZED COLUMN WITH IT, BECAUSE THE INVARIANT IS "EVERY SIZED VALUE IS ALSO A BUFFER
		// VALUE" AND A ONE-COLUMN REMOVAL WOULD BREAK IT.** Not reachable today — the
		// only caller folds a `String.addressableBytes` view, which no sized container's record can be — so
		// this line changes no program. It is here because the two columns describe ONE value and the
		// alternative is the premise this compiler keeps finding false: a value marked sized and NOT marked
		// as a buffer would be refused a length change while being served the `Array` roster one line down,
		// which is the exact disagreement `markSizedContainerBuffer`'s door invariant exists to prevent.
		unmarkValue(self.bodyState.sizedContainerBufferValues, value: value)
	end 'unmarkBufferSurface'

	// ⭐ **THE ONE WRITER OF `bufferSurfaceSlots`** — `markBufferSurface`'s twin for a TUPLE value,
	// through the same one home for the copy-on-write (`bufferSurfaceSlotsForWrite`) and with the same
	// hazard: the anchor is module-level, so a write into it names slots of an unrelated function's
	// SSA space. `error.tuple-slot-mark-does-not-leak-across-functions` is what holds that shut.
	//
	// Only a NON-PLAIN mask is stored, so a program whose tuples name no buffer allocates no table.
	function markBufferSurfaceSlots(value ValueId, surface immutable DeclaredSurface)
		if surfaceSlotCount(surface) == 0 'notATupleWithSlots'
			return
		end 'notATupleWithSlots'

		let bySlot = self.bufferSurfaceSlotsForWrite()
		bySlot.upsert(value, value: surface)
	end 'markBufferSurfaceSlots'

	// ⭐ **THE ONE WRITER OF `bufferSurfaceElements`** — `markBufferSurface`'s twin for an ARRAY whose
	// ELEMENTS are buffers, on the same discipline and against the same anchor hazard.
	function markBufferSurfaceElements(value ValueId)
		self.bodyState.bufferSurfaceElements = withValueMarked(self.bodyState.bufferSurfaceElements, value: value)
	end 'markBufferSurfaceElements'

	// ⭐ **THE ONE WRITER OF `sizedContainerBufferValues`** — `markBufferSurface`'s twin for the one
	// receiver whose record the TYPE also describes, on the same discipline and against the same anchor
	// hazard.
	//
	// ⚠⚠ **IT TAKES THE BUFFER MARK TOO, AND THAT IS THE INVARIANT RATHER THAN A CONVENIENCE.** The refusal
	// reads THIS column alone (`dispatchArrayMethod`), so a value marked sized and not marked as a buffer
	// would be refused a length change while being served the `Array` roster one line down — two surfaces
	// answering about one value, which is the disagreement the buffer mark exists to prevent. Every caller
	// today already holds a value the buffer mark is written on — each of them marks it through
	// `markDeclaredSurface` or through `bufferSurfaceOf` a line earlier — so this line adds nothing to any
	// path that exists; it is what makes the invariant a property of the DOOR instead of a rule each caller
	// remembers, which is the same argument `ValueMarkColumn`'s doors make one level down. ⚠ **DELIBERATELY NOT
	// A CALL-SITE LIST**, for `markBufferSurface`'s reason.
	function markSizedContainerBuffer(value ValueId, origin ByteArray)
		self.markBufferSurface(value, origin: origin)
		self.bodyState.sizedContainerBufferValues = withValueMarked(self.bodyState.sizedContainerBufferValues, value: value)
	end 'markSizedContainerBuffer'

	// ⭐⭐ **THE ONE DECISION: A TYPE SPELLED `__ManagedMemory` DENOTES THE BUFFER.** ⚖ **USER RULING,
	// 2026-07-31** — ("the buffer's legitimate surface is EXACTLY what its roster names",
	// `bufferSurfaceMemberNames`) applied to the spelling that NAMES the buffer. The alternative — a declared
	// `__ManagedMemory` deliberately exposing the `Array` surface — would make the roster message false at
	// three spellings, which is the defect.
	//
	// ⚠ **IT IS ASKED OF THE TOKEN, NOT OF THE RESOLVED TYPE, AND THAT IS THE WHOLE POINT.**
	// `parseTypeReference`'s generic-alias arm folds the spelling into `genericInstance(Array with Byte)`, so
	// once a `MaxonType` exists there is nothing left to test — a `__ManagedMemory` annotation and a
	// `ByteArray` one are then the same type. Every caller therefore asks BEFORE `parseTypeReference` runs.
	// ⚠ A token test is also robust where a resolved-type test could not be: the tolerant declaration SWEEP
	// asks this too, and at sweep time the alias may not be registered yet (`registerManagedFileType` is the
	// sweep's own write), so `isGenericAlias` can still answer no there. A spelling is the same fact in both
	// passes — the property `parseOptionalReturnType` is shared for.
	//
	// `identifierNameAt` answers the empty source text for anything that is not an identifier — a `returns
	// int`, a missing clause, a token past the end — so every non-identifier type position answers "no".
	// ⭐⭐ **AND AN ALIAS FOR ONE DENOTES IT TOO** — `typealias KeyMemory = __ManagedMemory with Key`,
	// then `function init(initKeys KeyMemory)`. The alias FOLDS the spelling away (`canonicalGenericBaseName`
	// interns it as an `Array` instance, which is the binding the element-agnostic alias exists to keep), so the declaration that
	// wrote `__ManagedMemory` is the only place the fact survives — `recordGenericAlias` files it, and this is
	// where a position spelling the alias reads it back. Without it `initKeys.length()` is refused as an
	// unknown `Array` member on `stdlib/Map.maxon`'s `init`, which is the exact inversion measured for the
	// bare spelling.
	//
	// ⚠ **BOTH KEYS, because a nested alias is keyed `<Type>.<member>` and SPELLED bare.** `Map.KeyMemory` is
	// what `qualifiedInnerGenericAlias` files; `KeyMemory` is what the parameter writes. The bare probe comes
	// first — a file-scope alias is the common case and `enclosingType` is empty at file scope, where the join
	// would build a string for a key that cannot exist.
	function typeSpellingAtDenotesBuffer(index ElementIndex) returns bool
		return self.spellingDenotesBufferSurface(try self.identifierNameAt(index) otherwise return false, nameReader: self.job.path)
	end 'typeSpellingAtDenotesBuffer'

	// ⭐⭐ **WHERE DOES THE TYPE WRITTEN AT `index` NAME `__ManagedMemory`?** THE one reader every
	// declaration door asks — a parameter, a struct field, a return clause — and the generalisation of the
	// single-token test above from a BIT to a whole `DeclaredSurface` TREE:
	//
	//   • `m __ManagedMemory`              ⇒ the root's outright bit
	//   • `a BufArray`                     ⇒ the root's element bit, `BufArray = Array with __ManagedMemory`
	//   • `t (__ManagedMemory, Int)`       ⇒ slot 0's outright bit
	//   • `t (BufArray, Int)`              ⇒ slot 0's ELEMENT bit
	//   • `t ((__ManagedMemory, Int), Int)` ⇒ slot 0's slot 0's outright bit
	//
	// The last three are ONE rule, not three: a tuple slot is a declared position, so it gets whatever a
	// declared position gets, by the same function calling itself. Nothing here knows how deep it is.
	//
	// ⚠ **IT IS ASKED OF THE TOKENS, BEFORE `parseTypeReference` RUNS, FOR THE REASON THE SINGLE-TOKEN TEST STATES ABOVE** —
	// and the tuple depth is why the tree cannot be recovered afterwards even in principle: two tuple types
	// that differ only in a slot's spelling canonicalize to ONE interned name with ONE layout, so by the time
	// a `MaxonType` exists the difference is not merely erased, it does not exist.
	//
	// ⚠ **A PLAIN POSITION ALLOCATES NOTHING** — the cheap whole-spelling test runs first and hands back the
	// shared empty tree, so the overwhelming majority of declared positions in any program cost one token
	// test and one `Set.contains` on an empty set. Only a position that actually names the buffer builds.
	//
	// ⚠⚠ **THE ELEMENT BIT IS THE ONE ARM THAT CONSULTS A REGISTRY, AND AT A TUPLE SLOT THAT REGISTRY MAY BE
	// HALF-BUILT — WHICH IS WHAT `slotElementsFromAliases` IS FOR.** The tolerant declaration SWEEP reads this
	// while `bufferElementAliases` is still filling, so a slot's element bit read there is not a fact about
	// the program, it is *how far the sweep had got*; and the sweep's copy is the one the whole-program index
	// stores. ⇒ A door the sweep also feeds (a struct FIELD, a RETURN clause) passes `false`; a door only the
	// REAL parse reaches (a parameter — the sweep skips a parameter list wholesale through
	// `skipBalancedParens`) passes `true`, where the index is complete and `bindParameters` consumes the
	// answer in the same pass.
	//
	// ⚠ **MEASURED** — the identical TWO-FILE program compiled when the file declaring
	// `typealias BufArray = Array with __ManagedMemory` sorted FIRST and was refused E2015 when it sorted
	// LAST: `function make() returns (BufArray, Int)` with `make().0.get(0).length()`. A member roster that
	// depends on file order is a wrong answer in one of the two orders, whichever one that is.
	//
	// ⚠⚠ **AND THE ROOT IS THE EXACT OPPOSITE CASE — IT ALWAYS ASKS, BECAUSE ITS ANSWER IS REPAIRED AT EVERY
	// READ DOOR BY A DERIVATION THAT IS COMPLEMENTARY BY CONSTRUCTION.** `ProgramSignatures.fieldSurfaceOf`,
	// `declaredReturnSurface` and `payloadSurfaceOf` all OR in `derivedAliasSurfaceBits`, which reads the alias
	// NAME off a swept type that is still `named` — and a swept type is still `named` EXACTLY when
	// `parseTypeReference`'s generic-alias arm found no alias, i.e. exactly when this token test finds none
	// either. Both conditions are `recordGenericAlias`'s one write (`genericAliases`, `bufferElementAliases`
	// and `bufferSurfaceAliases`, adjacent lines), so the two halves cover the two orders between them and
	// their UNION is order-independent. ⚠ Suppressing the root here breaks
	// that pair and makes `var bufs as BufArray` / `returns BufArray` themselves order-dependent; measured, the
	// same two-file program then flips the other way. A SLOT has no such second half, which is the whole of
	// why the two positions answer differently.
	//
	// ⚠⚠ **BOTH ROOT BITS RIDE THAT PAIR.** The read-door derivation must carry the OUTRIGHT bit as well as
	// the ELEMENT bit, or a root spelled with an alias FOR the buffer —
	// `typealias ByteBuffer = __ManagedMemory with Byte`, then `var buf as ByteBuffer` — has only the stored
	// token half, which is empty for every alias its own file declares (`recordGenericAlias` runs at
	// `foldFile`). MEASURED without it: the field, the RETURN clause and the union PAYLOAD each refused `length`, the
	// buffer roster's first member, while a PARAMETER spelled with the same alias compiled and RAN — because a
	// parameter's surface is read in the REAL parse, where the registry is complete. The read-door twin of the
	// token test below answers for the same two bits it does.
	function declaredSurfaceAt(index ElementIndex, slotElementsFromAliases bool) returns immutable DeclaredSurface
		if self.kindAt(index) != TokenKind.leftParen 'notATuple'
			return self.rootLeafSurfaceAt(index)
		end 'notATuple'

		if not self.tupleNamesBufferAt(index, slotElementsFromAliases: slotElementsFromAliases) 'namesTheBufferNowhere'
			return plainDeclaredSurface()
		end 'namesTheBufferNowhere'

		return self.surfaceNodesAt(index, slotElementsFromAliases: slotElementsFromAliases)
	end 'declaredSurfaceAt'

	// The whole surface of a NON-TUPLE declared position: one node, or the shared empty tree when it names the
	// buffer nowhere. It always reads the alias registry — see `declaredSurfaceAt`'s ⚠⚠ block for why the ROOT
	// may and a SLOT may not.
	function rootLeafSurfaceAt(index ElementIndex) returns immutable DeclaredSurface
		return surfaceOfRootBits(self.leafSurfaceNodeAt(index, elementFromAliases: true))
	end 'rootLeafSurfaceAt'

	// Does the TUPLE type written at `open` name the buffer anywhere inside it? The cheap gate that keeps a
	// plain declaration allocation-free, and it is EXACT rather than an over-approximation — it asks the very
	// leaf test the builder below asks, under the very same `slotElementsFromAliases`, so a tree of all-clear
	// nodes can never be built and stored as a non-plain surface.
	//
	// It scans the whole balanced parenthesized range at once rather than walking element boundaries: the
	// question is "anywhere", so where the boundaries fall does not matter and the scan needs no bookkeeping
	// and no allocation.
	function tupleNamesBufferAt(open ElementIndex, slotElementsFromAliases bool) returns bool
		var depth = 0 as NestingDepth
		var at = open

		while at < self.tokens.count() 'scanTuple'
			let kind = self.kindAt(at)

			if kind == TokenKind.leftParen 'openNested'
				depth = depth + 1
			end 'openNested'

			if kind == TokenKind.rightParen 'closeNested'
				depth = depth - 1

				if depth == 0 'endOfThisTuple'
					return false
				end 'endOfThisTuple'
			end 'closeNested'

			if self.leafSurfaceNodeAt(at, elementFromAliases: slotElementsFromAliases) != 0 'namesIt'
				return true
			end 'namesIt'

			at = at + 1
		end 'scanTuple'

		return false
	end 'tupleNamesBufferAt'

	// Does the token at `index` name an array-of-buffers alias, AND is this a position that may ask? THE one
	// consultation of `bufferElementAliases` from a declared spelling, so the gate and the leaf builder cannot
	// come to hold different opinions about a position's right to the registry — which is exactly the shape
	// that made a slot's answer file-order dependent (see `declaredSurfaceAt`).
	// ⚠ **`allFilesFolded` JOINS `elementFromAliases` AS A SECOND GATE**, and it says the same thing one
	// scope wider: `elementFromAliases` refuses the registry at a sweep-fed SLOT, and this refuses it in the
	// sweep at ALL positions. Both exist because a registry read during the sweep reports how far the sweep had
	// got; see `spellingDenotesBufferSurface` for the measurement and for why the root can now afford it.
	function spellingAtNamesBufferElements(index ElementIndex, elementFromAliases bool) returns bool
		if not elementFromAliases or not self.signatures.allFilesFolded 'sweepFedSlotOrSweepItself'
			return false
		end 'sweepFedSlotOrSweepItself'

		return self.signatures.aliasElementIsBufferSurface(try self.identifierNameAt(index) otherwise return false, readerFilePath: self.job.path)
	end 'spellingAtNamesBufferElements'

	// The pre-order nodes of the type written at `index`. A tuple contributes its own node — whose payload is
	// only its SLOT COUNT, since a tuple record denotes nothing itself — and then each element's whole subtree,
	// in order: the worklist pops, so each tuple pushes its element starts last first. Everything else is one
	// leaf node carrying the two spelling bits.
	//
	// Every leaf it reaches is a tuple SLOT — `declaredSurfaceAt` answers a non-tuple position without coming
	// here at all — which is what makes `slotElementsFromAliases` the right question to carry down.
	function surfaceNodesAt(index ElementIndex, slotElementsFromAliases bool) returns immutable DeclaredSurface
		let surface = DeclaredSurface.create(0) as isolated DeclaredSurface
		let pending = TokenIndexArray.create(0)
		pending.push(index)

		while pending.count() > 0 'eachPosition'
			let at = try pending.pop() otherwise panic("surfaceNodesAt: pop failed on a worklist whose count was just read as non-zero")

			if self.kindAt(at) != TokenKind.leftParen 'leafType'
				surface.push(self.leafSurfaceNodeAt(at, elementFromAliases: slotElementsFromAliases))
				continue
			end 'leafType'

			let starts = self.tupleElementStartsAt(at)
			surface.push(tupleSurfaceNode(starts.count() as FieldIndex))

			for offset in 0 upto starts.count() 'eachElementLastFirst'
				let element = (starts.count() - 1 - offset) as ElementIndex
				pending.push(try starts.get(element) otherwise panic("surfaceNodesAt: starts.get OOB at {element} below the {starts.count()} element starts"))
			end 'eachElementLastFirst'
		end 'eachPosition'

		return freeze surface
	end 'surfaceNodesAt'

	// The two spelling bits of a non-tuple type position, in one node. A node of 0 is "names the buffer
	// nowhere", which is what both the gate above and `rootLeafSurfaceAt` test for — one decoder, so the gate
	// and the builder cannot disagree about what counts.
	function leafSurfaceNodeAt(index ElementIndex, elementFromAliases bool) returns DeclaredSurfaceNode
		var node = 0 as DeclaredSurfaceNode

		if self.typeSpellingAtDenotesBuffer(index) 'spelledTheAlias'
			node = node or SurfaceBitIsBuffer
		end 'spelledTheAlias'

		if self.spellingAtNamesBufferElements(index, elementFromAliases: elementFromAliases) 'namedAnArrayOfBuffers'
			node = node or SurfaceBitElementIsBuffer
		end 'namedAnArrayOfBuffers'

		return node
	end 'leafSurfaceNodeAt'

	// The token index each top-level element of the tuple type at `open` starts at. It counts PAREN DEPTH, so
	// a nested tuple's own commas belong to it and not to this list — which is exactly what makes the builder
	// above recurse correctly rather than flattening a nested tuple into its parent's slots.
	//
	// A malformed or unterminated type is not this walk's to report: it stops at the matching `)` or at the
	// end of the token array, and `parseTupleTypeReference` reports what is actually wrong a moment later.
	function tupleElementStartsAt(open ElementIndex) returns TokenIndexArray
		let starts = TokenIndexArray.create(0)
		starts.push(open + 1)
		var depth = 0 as NestingDepth
		var at = open

		while at < self.tokens.count() 'scanTuple'
			let kind = self.kindAt(at)

			if kind == TokenKind.leftParen 'openNested'
				depth = depth + 1
			end 'openNested'

			if kind == TokenKind.rightParen 'closeNested'
				depth = depth - 1

				if depth == 0 'endOfThisTuple'
					return starts
				end 'endOfThisTuple'
			end 'closeNested'

			if kind == TokenKind.comma and depth == 1 'nextElement'
				starts.push(at + 1)
			end 'nextElement'

			at = at + 1
		end 'scanTuple'

		return starts
	end 'tupleElementStartsAt'

	// ⭐⭐ **A CALL RESULT WEARS THE BRAND ITS CALLEE'S `returns` CLAUSE SPELLED.** `makeXs() returns Xs` hands
	// back an `Xs`; `returns Array with Integer` hands back an unbranded instance that fits any brand. It is
	// `markDeclaredSurface`'s neighbour at the same door and reads the same kind of per-callee fact.
	//
	// ⚠ **WHETHER THE SPELLING IS AN ALIAS IS UNANSWERABLE DURING THE DECLARATION SWEEP**, which is why
	// `returnAliasSpelling` below records the token's text and asks nothing; a body and a file-scope
	// initializer both run after the sweep and the generic-alias contest settle.
	function brandCallResult(result ValueId, callee ByteArray)
		if self.tagOf(result) != ValueTypeTag.genericInstance 'theResultIsNotAnInstance'
			return
		end 'theResultIsNotAnInstance'

		self.brandValue(result, brand: self.signatures.callResultBrand(callee))
	end 'brandCallResult'

	// ⭐⭐ **THE TYPE NAME THE `returns` CLAUSE WROTE, bare or directory-qualified — the CALL RESULT's half of
	// the surface provenance.** `returns DenseColumn` gives `DenseColumn` and `returns alpha.Numbers` gives
	// `alpha.Numbers`; `returns Array with Integer`, a primitive, or no clause at all gives EMPTY, because
	// none of those names an alias. Read at the same moment as `returnDeclaredSurface` and for the same
	// reason: the clause has not been consumed yet.
	//
	// ⚠ **IT ASKS NOTHING ABOUT THE NAME, and that is deliberate.** Whether the spelling is a generic alias
	// is a WHOLE-PROGRAM question and this runs inside the declaration sweep that answers it. `brandCallResult`
	// asks, at parse time.
	function returnAliasSpelling() returns ReturnAliasSpelling
		if not self.at(TokenKind.returns) 'noReturnClause'
			return ReturnAliasSpelling.none
		end 'noReturnClause'

		match self.writtenTypeNameAt(self.returnTypeTokenIndex()) 'spelling'
			named(name) then return ReturnAliasSpelling.named(name)
			unnamed then return ReturnAliasSpelling.none
		end 'spelling'
	end 'returnAliasSpelling'

	function returnDeclaredSurface() returns immutable DeclaredSurface
		if not self.at(TokenKind.returns) 'noReturnClause'
			return plainDeclaredSurface()
		end 'noReturnClause'

		// `slotElementsFromAliases: false` — the SWEEP asks this and the whole-program index stores its
		// answer, so a SLOT's element bit read here would be how far the sweep had got,
		// and a call's member roster would depend on file order. The ROOT's is safe and is left asking; see
		// `declaredSurfaceAt`'s two ⚠⚠ blocks for why the two positions differ.
		return self.declaredSurfaceAt(self.returnTypeTokenIndex(), slotElementsFromAliases: false)
	end 'returnDeclaredSurface'

	// ⭐ **THE ONE BRIDGE FROM A PRE-ERASURE SPELLING TO THE VALUE MARKS.** Several separate registries carry
	// the surface — a parameter's, a return's, a field's, a payload's — so several storage COLUMNS are
	// inherent. Several copies of the *decision* are not, and this is what keeps them at one.
	//
	// The surface is a WORD, and this is where the word is unpacked onto the three carriers — so a door
	// that gains a depth gains it here, once, rather than at each binder.
	//
	// Its EIGHT call sites in SIX functions, DERIVED by grepping `self.markDeclaredSurface(` and not
	// remembered — `markBufferSurface`'s header records what copying such a sentence has cost five times:
	//   • a PARAMETER (`bindParameters`);
	//   • a union PAYLOAD binding;
	//   • a declared generic's FACTORY, from the alias name the call site wrote
	//     (`retypeGenericAliasConstructorResult`);
	//   • a FIELD READ (`emitFieldLoad`), which is THREE of them in one function — the field's own declared
	//     surface, the receiver's instance-argument spelling, and the per-value tuple-slot mask;
	//   • a CALL RESULT's declared return (`emitCall`);
	//   • a CALL RESULT's receiver instance-argument spelling (`markReceiverSurfaceOfResult`).
	//
	// ⚠ **THE LAST TWO OF THOSE ARE NOT A DECLARED SPELLING AT ALL**, which is why this header does not say
	// "declared": `Cell with __ManagedMemory` and `Cell with ByteArray` are one `GenericInstanceId`, so a
	// `returns U` read through either has NO declaration in the callee's file that could carry the answer.
	// See `slotSurfaceThroughReceiver`.
	function markDeclaredSurface(value ValueId, declared immutable DeclaredSurface)
		if surfaceIsBuffer(declared) 'declaredTheAlias'
			self.markBufferSurface(value, origin: self.brandOf(value))
		end 'declaredTheAlias'

		if surfaceElementIsBuffer(declared) 'declaredAnArrayOfBuffers'
			self.markBufferSurfaceElements(value)
		end 'declaredAnArrayOfBuffers'

		self.markBufferSurfaceSlots(value, surface: declared)
	end 'markDeclaredSurface'

	// Does `value` denote a `__ManagedMemory` BUFFER rather than the `Array` around it? The read side of the
	// mark above — asked once per array-method dispatch, and `Set.contains` on the shared zero-capacity set
	// returns before it hashes anything, so a program that never names `__ManagedMemory` does not pay to ask.
	function valueIsBufferSurface(value ValueId) returns bool
		return valueIsMarked(self.bodyState.bufferSurfaceValues, value: value)
	end 'valueIsBufferSurface'

	// Does `value` denote a SIZED container's own record? The read side of `markSizedContainerBuffer`,
	// asked once per array-method dispatch beside the line above and on the same terms: `Set.contains` on the
	// shared zero-capacity set returns before it hashes anything, so a program that names no sized container's
	// buffer does not pay to ask.
	function valueIsASizedContainersBuffer(value ValueId) returns bool
		return valueIsMarked(self.bodyState.sizedContainerBufferValues, value: value)
	end 'valueIsASizedContainersBuffer'

	// ⭐ **THE SURFACE OF ELEMENT `slot` OF THE TUPLE `value` — A WHOLE SURFACE, NOT A BIT.** The read
	// side of `markBufferSurfaceSlots`, asked at `emitFieldLoad`, which every `p.0`, every destructured name
	// and every chain hop funnels through. Because a slot's payload is a surface like any other, `p.0` of a
	// `((__ManagedMemory, Int), Int)` binds a value carrying ITS slots — the recursion needs no case here, it
	// is the same line running again one container in.
	//
	// A value with no entry is plain, which is every tuple in a program that never writes the alias.
	function valueSlotSurface(value ValueId, slot FieldIndex) returns immutable DeclaredSurface
		let surface = self.slotSurfaceOf(value)

		if slot >= surfaceSlotCount(surface) 'noSuchMarkedSlot'
			return plainDeclaredSurface()
		end 'noSuchMarkedSlot'

		return surfaceSlot(surface, slot: slot)
	end 'valueSlotSurface'

	// Do the ELEMENTS of the array `value` denote buffers? The read side of
	// `markBufferSurfaceElements`, asked at `emitContainerElementAccessor`.
	function valueElementIsBufferSurface(value ValueId) returns bool
		return valueIsMarked(self.bodyState.bufferSurfaceElements, value: value)
	end 'valueElementIsBufferSurface'

	// ⭐ **THE RETURN HALF OF "A FUNCTION VALUE CARRIES ONE RESULT"** — asked at the TWO
	// producers of a function value whose return type nothing declares: a named function referenced by name
	// (`emitFunctionRef`) and a closure literal, whose return type is INFERRED from its `gives` expression and
	// settled the moment that expression is parsed. Both are refused at the value's own line rather than at
	// the call, so the author is shown where the type came from — and both would otherwise reach the SAME
	// panic, `witnessOfValue` on a `callIndirect` result nothing could pair (MEASURED on both routes).
	function requireFunctionValueReturnHasRoom(returnType MaxonReturnType, tok Token) throws SourceParseError
		match returnType 'declaredReturn'
			void then break
			value(inner) then try self.requireStorableDeclaredType(inner, position: DeclaredStoragePosition.functionValueReturnType, line: tok.line, column: tok.column)
		end 'declaredReturn'
	end 'requireFunctionValueReturnHasRoom'

	// ⭐⭐ **THE VALUE DOOR, THE CALL DOOR'S OTHER HALF** — `requireCalleeIsNotReservedName` refuses a reserved
	// CALLEE and this refuses the same name in VALUE position, so the tier's protection is a property of the
	// NAME rather than of how an entry is REACHED. Unrefused, `let f = __parallel_boundary` then `f()` binds
	// the tier's own declaration and reaches it through a synthesized `__fnref_` thunk, which links and runs.
	//
	// ⭐ **IT SITS AT `requireNameIsUsableAsFunctionValue` BECAUSE THAT IS THE COMPLETE SITE.** Every syntactic
	// position in which an author's name becomes a function value funnels into `emitNamedFunctionRef` — a bare
	// name READ through `emitFunctionRef`, a directory-qualified one through `parseNamespaceQualifiedFunctionValue`
	// — and the one other producer is a function-backed enum case, checked at its DECLARATION by
	// `caseFunctionName`. All of them ask this routine; an enumeration of positions here would rot.
	//
	// ⚠ **THE COMPILER'S OWN FUNCTION-VALUE MINTS DO NOT COME THROUGH HERE AT ALL**, which is why this needs no
	// `CalleeMint` and why it cannot break the destructor cascade: `emitCodeAddress` (`__destruct_<T>`,
	// `__str_decref`, `__managed_decref`) and the lifted-closure reference emit their `functionRef` op directly.
	// What reaches this door is an identifier token, and an identifier token is bytes the author typed.
	//
	// ⇒ **THE EXEMPTION IS THE CALL DOOR'S `theReservedSpacesOwnDeclaration` CLAUSE AND ONLY THAT ONE.** The
	// others are about QUALIFIED callees a bare name cannot spell: `__Raw.*`, a `<conformer>.<method>` impl, a
	// `<primitive>.<method>` or default-helper mint, and the stdlib shadow mint — whose contest moves nominal
	// TYPE names alone (`Queries.contestStdlibDeclarationsAgainstUserNames`), so no function name is ever one.
	// `declaresCallee` is conjoined for the call door's reason: the file fact says this file may write the
	// reserved space, and this says the program actually has that function.
	function requireFunctionValueNameIsNotReserved(tok Token) throws SourceParseError
		let reason = reservedCalleeReasonOf(tok.value)

		if reason == ReservedCalleeReason.notReserved 'ordinaryName'
			return
		end 'ordinaryName'

		if self.fileMayUseReservedNames() and self.signatures.declaresCallee(tok.value) 'theReservedSpacesOwnDeclaration'
			return
		end 'theReservedSpacesOwnDeclaration'

		throw SourceParseError.reservedNameAsFunctionValue(String.from(tok.value), reason: reason, line: tok.line, column: tok.column)
	end 'requireFunctionValueNameIsNotReserved'

	// ⭐ **MAY THE NAME `tok` SPELLS STAND AS A FUNCTION VALUE? — the whole of what separates a function
	// reference from an undefined variable, asked in one place.** It is not inside `emitNamedFunctionRef` because a
	// SECOND site asks the identical question about a name it will not immediately emit: a function-backed
	// enum case (`Parser.caseFunctionName`), which must refuse an unusable target at the DECLARATION even in a
	// program that never reads the enum. Both sites therefore get the RESERVED-name gate above too, which is what
	// lets that gate be stated once.
	//
	// `tok` carries the name as written, which every refusal quotes; `funcName` is the declaration it resolved to,
	// which every lookup reads.
	function requireNameIsUsableAsFunctionValue(tok Token, funcName ByteArray) throws SourceParseError
		try self.requireFunctionValueNameIsNotReserved(tok)

		match self.signatures.returnTypeOf(funcName, into: self.artifact.typeNames) 'callee'
			// ⭐ **A FUNCTION VALUE CARRIES ONE RESULT, SO A FUNCTION THAT USES THE SECONDARY RETURN SLOT CANNOT
			// BE ONE** — both disjuncts of `functionUsesSecondaryReturnSlot`, refused here at the one door a
			// named function becomes a value through. The THROWING half is refused just below;
			// the INTERFACE-RETURNING half is the same ABI fact and would otherwise reach
			// `witnessOfValue` with a call result nothing paired — MEASURED, `let f = make` then `f(42)`.
			declared(returnType) then try self.requireFunctionValueReturnHasRoom(returnType, tok: tok)
			undeclared then throw SourceParseError.undefinedVariable(String.from(tok.value), line: tok.line, column: tok.column)
		end 'callee'

		match self.signatures.throwsOf(funcName) 'throwsClause'
			throwing(errorType) then throw SourceParseError.throwingFunctionAsValue(String.from(tok.value), errorType: errorType, line: tok.line, column: tok.column)
			none then break
		end 'throwsClause'
	end 'requireNameIsUsableAsFunctionValue'

	// ⭐ **A BARE FUNCTION NAME USED AS A VALUE → a `functionRef`**, the last resort a name
	// falls to after it is not a local, a self-field, a top-level constant or a `var`. It is what makes
	// `let f = double`, `apply(triple, x: 10)` and `return double` bind a function VALUE — a code pointer.
	//
	// It resolves through the WHOLE-PROGRAM signature index, so a FORWARD reference (a function
	// declared LATER in the file, the `.forward-reference-*` cases) resolves here at parse time
	// exactly as a backward one does — the sweep records every declaration before any file is parsed,
	// so the name needs no placeholder and no later rewrite pass. A name NO file declares as a
	// function is a genuine undefined variable (E2004).
	//
	// A THROWING function is refused here (E3101): a function type has no throws clause, so the binding
	// would drop it and `indirectCall` has no error channel to carry it back. Refused at the point the
	// name becomes a value, with the callee's `throws E` type named.
	//
	// The value's type is `function(intern(name))` — the FUNCTION's own name governs its signature, which
	// is how an indirect call on it (`f(21)`) recovers the return type (`returnTypeOf(name)`).
	function emitFunctionRef(tok Token) returns ValueId throws SourceParseError
		// ⭐ **THE EXPRESSION-POSITION HALF OF E2060.** This is the LAST-RESORT door for a bare name
		// READ — not a local, not a captured binding, not a global, not a constant — so a `__line__` whose
		// form is a plain identifier READ arrives here and nowhere earlier, and a name that DID bind is never
		// asked. Placed here rather than at the top of the primary parse for exactly that reason: the check
		// then costs nothing on the path every identifier in every program takes, and runs only on a program
		// already destined for a diagnostic.
		//
		// ⚠ **"A BARE NAME READ" IS NARROWER THAN "AN ORDINARY EXPRESSION".** `parsePrimary` splits the four
		// forms an identifier can open one token before this
		// door, so the CALL, DOTTED and STRUCT-LITERAL forms never reach it and are refused under their own
		// codes. See `requireNotACallerLocationDefault`'s header for the measured table and for why the codes
		// are not brought into line here.
		try requireNotACallerLocationDefault(tok.value, at: tok)
		let funcName = try self.resolvedFunctionValueName(tok.value, anchor: tok, use: BareNameUse.value)
		return try self.emitNamedFunctionRef(tok, funcName: funcName)
	end 'emitFunctionRef'

	// The declaration a function name written as a value means in this file. A name two or more visible
	// declarations answer to is refused where it is written; one that means none is left as written, for the
	// usability check to refuse by the name the author wrote.
	function resolvedFunctionValueName(written immutable ByteArray, anchor Token, use BareNameUse) returns immutable ByteArray throws SourceParseError
		match self.signatures.resolveFunctionName(written, readerFilePath: self.job.path) 'resolution'
			declaration(name) then return name
			ambiguous(candidates) then throw SourceParseError.ambiguousBareName(String.from(written), candidates: renderAmbiguousCandidates(candidates), use: use, line: anchor.line, column: anchor.column)
			undeclared then return written
		end 'resolution'
	end 'resolvedFunctionValueName'

	// The function value of `funcName`, a name already resolved to its declaration; `tok` carries the name as
	// written, which every refusal quotes, and anchors it.
	function emitNamedFunctionRef(tok Token, funcName ByteArray) returns ValueId throws SourceParseError
		try self.requireNameIsUsableAsFunctionValue(tok, funcName: funcName)
		return self.emitImmortalFunctionRef(funcName, anchor: tok)
	end 'emitNamedFunctionRef'

	function emitFunctionRefOp(funcName ByteArray, anchor Token) returns ValueId
		let result = self.mintValue(ValueTypeTag.function, nameId: self.artifact.typeNames.intern(funcName))
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.functionRef(result, funcName: funcName, form: FunctionRefForm.functionValue), range: SourceRange.ofToken(anchor))
		return result
	end 'emitFunctionRefOp'

	function emitImmortalFunctionRef(funcName ByteArray, anchor Token) returns ValueId
		let reference = self.emitFunctionRefOp(funcName, anchor: anchor)
		self.markImmortalFunction(reference)

		self.regionFactsForWrite().cleanFunctionValues.insert(reference)

		self.trackOwnedTemp(reference, exclusivity: OwnedHeapExclusivity.sole)
		return reference
	end 'emitImmortalFunctionRef'

	function storeRootOf(binding VarInfo) returns VarInfo
		return self.bodyState.scope.getInfo(SelfParamName) if binding.isSelfField else binding
	end 'storeRootOf'

	function requireStoreRootStillLive(root VarInfo, rootTok Token) throws SourceParseError
		if root.movedFrom 'movedWhileTheValueWasBuilt'
			throw self.useAfterMoveRefusal(rootTok.value, value: root.boundValue, line: rootTok.line, column: rootTok.column)
		end 'movedWhileTheValueWasBuilt'
	end 'requireStoreRootStillLive'

	function requireElementStoreRootStillLive(destination ElementStoreDestination) throws SourceParseError
		match destination 'destination'
			none then return
			rootedAt(root, anchor) then try self.requireStoreRootStillLive(root, rootTok: anchor)
		end 'destination'
	end 'requireElementStoreRootStillLive'

	function noteClosureStoreSite(destination ClosureStoreDestination, value ValueId, at Token)
		if not self.memos.functionHoldings.mayHoldAFunction(self.tagOf(value), nameId: self.valueNameId(value), signatures: self.signatures, from: self.artifact.typeNames) 'holdsNoClosure'
			return
		end 'holdsNoClosure'

		let func = self.bodyFunction()
		func.noteClosureStoreSite(ClosureStoreSite.create(destination, value: value, line: at.line, column: at.column))
	end 'noteClosureStoreSite'

	function elementStoreDestinationOf(recv MethodReceiver) returns ElementStoreDestination
		let name = match recv.subjectName 'subject'
			storage(name) gives name
			none gives EmptySourceText
		end 'subject'

		if name.isEmpty() or not self.bodyState.scope.contains(name) 'namesNoBindingOfThisFrame'
			return ElementStoreDestination.none
		end 'namesNoBindingOfThisFrame'

		return ElementStoreDestination.rootedAt(self.storeRootOf(self.bodyState.scope.getInfo(name)), anchor: recv.anchor)
	end 'elementStoreDestinationOf'

	// A closure parameter declared at an interface type, refused through the SAME door the other seven
	// positions come through. It finds the offending parameter through the SAME scan the interface-requirement
	// reader uses — the two walked the identical `(paramTypes, paramRanges)` pair with their own copy of "is
	// this an existential", which agreed only by coincidence: widen what counts as one (an alias resolving to
	// an interface, a tuple holding one) and one arm would have kept firing while the other went quiet.
	function requireNoInterfaceClosureParam(paramTypes MaxonTypeArray, paramRanges SourceRangeArray) throws SourceParseError
		if let found = try firstExistentialParam(paramTypes, paramRanges: paramRanges) 'existentialParam'
			try self.requireStorableDeclaredType(found.declaredType, position: DeclaredStoragePosition.closureParameter, line: found.anchor.line, column: found.anchor.column)
		end 'existentialParam'
	end 'requireNoInterfaceClosureParam'

	function closurePlaceholderReturn(declaredResult ClosureResult) returns MaxonReturnType
		return match declaredResult 'result'
			declared(returnType, _, _) gives MaxonReturnType.value(returnType.clone())
			inferred gives MaxonReturnType.value(MaxonType.unresolved)
		end 'result'
	end 'closurePlaceholderReturn'

	function parseClosureBody(lifted IrFunction, block IrBlock, declaredResult ClosureResult, givesTok Token) returns MaxonType throws SourceParseError
		match declaredResult 'result'
			declared(returnType, _, _) then return try self.parseDeclaredClosureBody(lifted, block: block, returnType: returnType, givesTok: givesTok)
			inferred then return try self.parseInferredClosureBody(lifted, block: block, givesTok: givesTok)
		end 'result'
	end 'parseClosureBody'

	function parseDeclaredClosureBody(lifted IrFunction, block IrBlock, returnType MaxonType, givesTok Token) returns MaxonType throws SourceParseError
		try self.requireFunctionValueReturnHasRoom(lifted.maxonReturnType, tok: givesTok)
		try self.parseCheckedValueReturn(lifted, block: block, anchor: givesTok)
		self.noteClosureResultFrozen(lifted)
		return returnType.clone()
	end 'parseDeclaredClosureBody'

	function parseInferredClosureBody(lifted IrFunction, block IrBlock, givesTok Token) returns MaxonType throws SourceParseError
		let bodyStart = self.pos
		let bodyValue = try self.parseExpression(lifted, block: block)
		let bodyType = self.typeOf(bodyValue)
		try self.requireFunctionValueReturnHasRoom(MaxonReturnType.value(bodyType), tok: givesTok)
		try self.emitOwnedValueReturn(bodyValue, anchor: givesTok)

		if not self.valueIsAValueType(bodyValue) 'aRecordResult'
			try self.notePlainResultData(lifted, value: bodyValue, retStart: bodyStart)
		end 'aRecordResult'

		self.noteClosureResultFrozen(lifted)
		return inferredClosureResultType(bodyType)
	end 'parseInferredClosureBody'

	function noteClosureResultFrozen(lifted IrFunction)
		if not self.bodyState.returnsFrozenData 'handsBackWritableData'
			return
		end 'handsBackWritableData'

		lifted.resultMayBeFrozen = true
		self.frozenResultClosures.push(freeze lifted.name.clone())
	end 'noteClosureResultFrozen'

	// An initializer's closures lift under its binding's own host
	// (`ProgramSignatures.initializerClosureHostOf`), so the closures of two bindings never share a
	// name.
	function closureHostOf(func IrFunction) returns ByteArray
		if isInitializerFunctionName(func.name) 'anInitializerBody'
			return self.statement.initializerClosureHost.clone()
		end 'anInitializerBody'

		return func.name.clone()
	end 'closureHostOf'

	// The body parses into a FRESH function context — its own scope, value numbering, blocks and type
	// columns — swapped in around the parse and restored verbatim after, so the enclosing function's
	// parse is undisturbed.
	function parseClosureExpression(func IrFunction) returns ValueId throws SourceParseError
		let closureStart = self.pos
		let paramTypeOffer = self.takeClosureParamOfferAt(closureStart)
		let functionTok = try self.consume(TokenKind.function)
		try self.consume(TokenKind.leftParen)

		// Parse the parameters through the shared `parseFunctionParameters` — `name Type` pairs, the
		// no-default rule and the reserved-name check all apply identically. (The ARGUMENT-COUNT ceiling is
		// NOT among them and deliberately so: only a caller knows how many hidden slots its own ABI adds, so
		// each asks `requireAbiParamCount` itself — see that routine's header.) `_` is
		// a legal identifier the check accepts (the corpus's `function(_ Integer) gives …`). An UNTYPED
		// parameter (`function(p) gives …`) is typed from `paramTypeOffer` when the call argument supplied one
		// and refused with a positioned diagnostic when it did not — `parameterTypeOrOffered`.
		let paramNames = NameRoster.create(0)
		var paramTypes = MaxonTypeArray.create(0)
		let paramRanges = SourceRangeArray.create(0)

		// A closure parameter may spell `__ManagedMemory` exactly as a function's may, and may be
		// declared at a parameterized-interface type exactly as a function's may — it reaches the same
		// `parseFunctionParameters` and the same `bindParameters`, so neither needs separate treatment.
		let paramSurfaces = DeclaredSurfaceArray.create(0)
		let paramTypeStarts = TokenIndexArray.create(0)
		let paramCapabilities = ParamCapabilityArray.create(0)
		let paramMarkers = BoolArray.create(0)
		let markerTokens = TokenIndexArray.create(0)
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges, paramSurfaces: paramSurfaces, paramTypeStarts: paramTypeStarts, paramCapabilities: paramCapabilities, paramMarkers: paramMarkers, markerTokens: markerTokens, owner: ParamDefaultOwner.closureLiteral, paramTypeOffer: paramTypeOffer)
		try self.consume(TokenKind.rightParen)

		// A struct parameter is re-tagged `structRef` here, exactly as `parseFunction` does — the whole-program
		// struct registry is complete in the real parse (see `resolveNamedStruct`).
		paramTypes = self.resolveNamedStructAll(paramTypes)

		// A closure parameter may not be declared at an interface type. A value held at an interface is a
		// two-word fat pointer whose second word travels as an adjacent hidden argument only a real
		// function's signature reserves; a lifted closure's parameters are bound before any witness is
		// paired, so `witnessOfValue` would find none and panic with no source position. Refused rather
		// than paired: the `(userargs, record)` indirect ABI carries one machine word per argument,
		// so a fat pointer would need a second slot the shape has nowhere to put.
		try self.requireNoInterfaceClosureParam(paramTypes, paramRanges: paramRanges)

		// The lifted closure's ABI count is its own parameters PLUS the trailing `__env` slot reserved below —
		// so the ceiling is asked of `+ 1`. Asked HERE rather than in the shared `parseFunctionParameters` for
		// the reason `requireAbiParamCount`'s header gives: only the caller knows how many hidden slots its own
		// ABI adds, and a check that did not would be the weak second count all over again.
		//
		// ⚠ It is asked before the context save below, and that is a hard requirement. `savedBody`
		// aliases the object `self.bodyState` holds — one object, two names, no incref — until the field
		// is re-pointed at the closure's fresh state. A call that can throw while the alias is live gives
		// the enclosing frame a failure edge whose drop for the alias releases an object the field still
		// holds: a refcount underflow inside `__destruct_Parser`, compiling any closure. So nothing that
		// can throw goes between `let savedBody` and the `fresh` below. The throwing calls after it
		// (`bindParameters`, `parseExpression`, `emitOwnedValueReturn`) are safe, because by then
		// `savedBody` owns its object alone.
		let ownEnvSlot = paramNames.count() as ParamCount
		let liftedParamCount = ownEnvSlot + FunctionRecordArgCount
		try requireAbiParamCount(liftedParamCount, anchor: functionTok)
		let givesTok = try self.consume(TokenKind.gives)

		// The lifted name — `<enclosing>$closure_<k>`. `$` is unwritable in a Maxon identifier, so the name
		// can collide with no user function, alias, or OTHER closure (the counter is per enclosing
		// function). Post-increment so sibling closures get 0, 1, 2, … in source order.
		let k = func.closureSubCounter
		func.closureSubCounter = k + 1
		let closureName = liftedClosureName(self.closureHostOf(func), ordinal: k)

		// --- Switch into the lifted function's own body state. ---
		// The return alias stays empty: a closure's return type is inferred from its body expression,
		// never declared, so there is no declared ranged return for a `return` site to check against. The
		// parameter aliases are asked as `parseFunction` asks them, and they earn their keep: a closure's
		// entry guard is the only thing that can check an argument passed through a function value, which
		// has no callee name at the call site to look a parameter's range up by.
		let paramSites = try self.rangedParamSites(paramTypes, paramRanges: paramRanges) otherwise RangeCheckParamSiteArray.create(0)
		let declaredResult = closureResultOf(paramTypeOffer)
		let placeholderReturn = self.closurePlaceholderReturn(declaredResult)
		let returnAlias = self.rangedReturnAlias(placeholderReturn)

		// A closure body is a function of its own, with its own SSA and block numbering, and the
		// enclosing body resumes after it — mid-`try`, mid-loop, mid-`match` — so the enclosing state is
		// swapped out whole here and swapped back at the end, never reset. Every column names ids of one
		// function, so a column shared across the boundary would name unrelated values on the other side.
		let savedBody = self.bodyState
		let savedFuncIndex = self.artifact.currentFuncIndex
		let bodyFirstOp = self.artifact.module.opCount()

		// A closure body is a closure body whatever it was written inside (see `EnclosingBodyKind`): the
		// `test` body relaxation must not follow the keyword into a nested function, whose errors go to
		// whoever calls it. Nor is it a factory: the `Self{…}` a factory's deferred fields belong to is
		// not in it.
		//
		// A closure reserves no hidden parameter of its own: it inherits the enclosing body's descriptor and
		// count as words read out of its environment (`hiddenWordParamInheritedFrom`), and the lowering binds
		// them at its entry.
		//
		// The trailing `__env` parameter's ValueId is reserved up front: every capture read loads through
		// it, so its id is fixed before the body parses, and value numbering starts at `paramCount + 1`.
		//
		// ⚠ `declaringWitnessParamBase`/`Count` are deliberately left standing. A lifted closure reserves
		// no witness parameters, but its body still dispatches through the declaring function's
		// constraints: `function(x Element) gives x.compare(y)` inside `extension Array where Element is
		// Comparable` reaches the extension's table through the closure's environment, and
		// `witnessValueForConstraint` is the one door that tells the two routes apart. A reset would
		// leave `witnessParamValueId` nothing to name in every closure that dispatches. Nothing inside a
		// closure body writes the pair.
		self.bodyState = self.liftedBodyState(liftedParamCount as ValueId, closureEnv: ClosureEnvParam.param(ownEnvSlot as ValueId), returnAlias: returnAlias, paramSites: paramSites, layoutParam: hiddenWordParamInheritedFrom(savedBody.layoutParam), countParam: hiddenWordParamInheritedFrom(savedBody.fixedElementCountParam))
		let lifted = self.pushLiftedFunction(closureName, returnType: placeholderReturn, paramTypes: paramTypes, anchor: functionTok)
		let closureByRefParams = self.byReferenceMarkersOf(paramMarkers, paramTypes: paramTypes, capabilities: paramCapabilities)
		lifted.reassignedParamMask = closureByRefParams

		// The enclosing scope becomes a CAPTURE scope for the duration of the body — a body name resolving
		// into it (an enclosing local/param/self-field, not the closure's own params) is a capture. Pushed
		// here, popped just before the restore.
		self.closureEnclosingFrames.push(ClosureEnclosingFrame.create(savedBody.scope, funcIndex: savedFuncIndex, body: savedBody))

		// The reserved `__env` slot (ValueId `paramCount`) gets its own column entry — an i64 heap pointer —
		// so the columns stay indexable by every ValueId whether or not the closure ends up capturing.
		self.recordValueType(MaxonType.integer)
		self.bodyState.bodyStart = self.pos

		// A use-site phrase is spelled from `statementStart`; left at a fresh body's 0 it would spell the
		// file up to every use in the closure.
		self.bodyState.statementStart = self.pos
		self.bodyState.outerBodyStart = savedBody.outerBodyStart
		self.bodyState.resultOrigin = resultOriginOf(declaredResult)
		self.bodyState.boundParams = savedBody.boundParams
		self.seedCellLocalNames(paramNames, extent: BodyExtent.expression)
		try self.bindParameters(lifted, consume: self.signatures.consumeOf(closureName), paramNames: paramNames, paramTypes: paramTypes, paramRanges: paramRanges, paramSurfaces: paramSurfaces, paramTypeStarts: paramTypeStarts)

		// Parse the single body expression, then close the lifted function like a value `return`: the
		// body IS the closure's returned value, so `emitOwnedValueReturn` promotes a borrowed String to
		// owned and drains the (single-expression body's) drop sets, exactly as `parseReturnStatement`
		// does. This is what materializes a bare-string-literal body — `stringLiteral` already emits a
		// backing op, so the `ret` never references an unbound value, and the promotion makes it an owned
		// return the caller can drop (`closure-capture.string-literal-body`).
		let resultType = try self.parseClosureBody(lifted, block: self.bodyState.currentBlock, declaredResult: declaredResult, givesTok: givesTok)

		// ⭐ **THE CLOSURE ASKS `requireNoWitnessCursorElementIsDropped` OF ITSELF** — same moment in its life
		// `parseFunction` asks it (the whole body emitted, so "was a drop emitted" is answerable), and it must
		// ask because it is a function of its own.
		// It names the closure and points at the `function` keyword, so a refusal names the closure rather than
		// blaming the method around it.
		try self.requireNoWitnessCursorElementIsDropped("the closure written in {self.signatures.functionDisplay(func, authoredPath: self.job.authoredPath).quoted()}", line: functionTok.line, column: functionTok.column)

		// Claimed before the capture snapshot below: a claim is a capture slot, and the env is built from the
		// snapshot.
		self.claimHiddenWordIfRead(lifted, word: ClosureHiddenWord.descriptor)
		self.claimDescriptorForCaptureReleases()
		self.claimHiddenWordIfRead(lifted, word: ClosureHiddenWord.fixedElementCount)

		// Did the body capture? Snapshot the collected set before it is restored away. The inherited-witness
		// column is snapshotted with them because it names slots IN this set, and both are read after the
		// restore — the values half of it is still unfilled at this point, on purpose.
		let captureCount = self.bodyState.captureNames.count()

		// `var`, because `fillInheritedWitnessCaptures` WRITES into it (E3207) — the inherited-witness slots are
		// claimed during the body parse and can only be valued after the restore.
		let capturedValuesSnapshot = self.bodyState.captureValues.clone()
		let capturedTypesSnapshot = self.bodyState.captureTypes
		let captureNamesSnapshot = self.bodyState.captureNames
		let captureAnchorsSnapshot = self.bodyState.captureAnchors
		let inheritedWitnessSnapshot = self.bodyState.inheritedWitnessCaptures

		lifted.closureLayout = closureCaptureSourceOf(captureNamesSnapshot, word: ClosureHiddenWord.descriptor)
		lifted.closureFixedElementCount = closureCaptureSourceOf(captureNamesSnapshot, word: ClosureHiddenWord.fixedElementCount)

		// The reserved `__env` slot is promoted to a real trailing parameter, always. Under the
		// uniform `(userargs, record)` ABI EVERY function value is called through the SAME indirect signature, so a
		// lifted closure's own type must be `(userargs, __env) -> R` whether or not it captures — on wasm the
		// `call_indirect` functype is derived from the ARG COUNT (userargs + env), and the table element's own
		// functype must match. A NON-capturing closure never reads the slot (its body has no capture load), so the
		// param is inert there, but its presence keeps the closure's functype uniform with a capturing one and with
		// a plain function's `__fnref_` thunk. `emitParams` (lowering) reads `paramCount`/`maxonParamTypes`, so a
		// patch here is seen.
		lifted.paramCount = liftedParamCount
		let liftedParamTypes = MaxonTypeArray.create(paramTypes.count() + 1, zeroed: false)

		for pt in paramTypes 'copyUserParams'
			liftedParamTypes.push(pt.clone())
		end 'copyUserParams'

		liftedParamTypes.push(MaxonType.integer)

		lifted.maxonParamTypes = liftedParamTypes
		lifted.typeSites = self.paramTypeSites(paramTypeStarts)

		// Give the `__env` param a source origin (its declaring `function` keyword) so the register-pressure
		// diagnostic can resolve it, exactly as `bindParameters` records one per user parameter.
		self.artifact.recordParamOrigin(ownEnvSlot as ValueId, range: SourceRange.ofToken(functionTok))

		// Patch the return type now the body is known, and register the lift so it is callable (module +
		// project signature registries) and its return type is resolvable at an indirect call through a
		// closure-bound local (`closureShapes`, read by `functionValueShape`). The signature keeps the
		// USER parameters only — an indirect call is positional and never slot-validates against it, and the
		// `__env` is the function record the caller calls through, not a source arg.
		// ⚠ A body that is a call to an undefined callee has no type yet, and `MaxonReturnType.value` has no
		// spelling for that — so `integer` stands in. It is sound ONLY because such a program is refused:
		// `SemanticCheck.validateCall` reports E3004 for the callee. `requireNoUnresolvedTagsSurvivedTheMaxonTier`
		// is the gate that catches the day it is not, because this stand-in is exactly what would hide it.
		let returnType = MaxonReturnType.value(resultType)
		lifted.maxonReturnType = returnType.clone()

		// A closure's return type is INFERRED from its body expression, never spelled, so no declared
		// spelling can name the buffer alias here.

		// ⚠ The return identity is read off the INFERRED `returnType` — a closure never spells one, so this is
		// the only place its enum-ness is knowable. `function() gives Color.blue` therefore reaches an
		// enum-returning function type as a `Color` rather than as the bare `integer` resolution leaves.
		// ⚠ The PARAMETER column is filled and the RETURN one is not, and the asymmetry is the line above: a
		// closure's parameters ARE spelled (`function(t IntTaker) gives …`) and carry the same `paramTypeStarts`
		// every declared function's do, while its return type is INFERRED from the body and names no token for
		// `declaredExistentialInstanceAt` to read.
		let signature = FuncSignature.create(paramNames, paramTypes: paramTypes, paramAggregateNames: self.paramAggregateNamesOf(paramTypes), paramDeclaredNames: self.paramDeclaredNamesOf(paramNames, paramTypes: paramTypes, paramTypeStarts: paramTypeStarts), returnAggregateName: self.erasedAggregateNameOfReturn(returnType), returnBrand: EmptySourceText, paramExistentialSites: self.paramExistentialSitesOf(paramTypes, paramTypeStarts: paramTypeStarts), returnExistentialSites: GenericInstanceIdArray.create(0), extensionConstraints: WhereConstraintArray.create(0), writtenTypeNames: WrittenTypeNames.none(), selfSpelledParams: NoParamPositions, offeredResultAlias: offeredAliasOf(declaredResult), byRefParams: closureByRefParams, writtenParams: markerMaskOf(paramMarkers))
		self.publishLiftedBody(lifted, returnType: returnType, signature: signature, anchor: functionTok, synthesized: false)
		self.closureShapes.upsert(closureName, value: FunctionValueShape.create(signature.paramTypes, returnType: returnType, scopeFilePath: self.job.path, promisesTaken: BoolArray.create(0), byRefParams: closureByRefParams, isolatedParams: NoParamPositions))

		// Commit the closure's OWN range-check sites under its OWN lifted name, so `InsertRangeChecks`
		// resolves them against the function whose SSA space numbered them. It sits here — after the body,
		// BEFORE the restore below — because it reads the accumulators the body filled, which the restore is
		// about to swap back. Same call `parseFunction` makes at its own end, for the same reason.
		// The closure's own E3012/E3077 drain. Its candidates are its body state's, so they cannot be
		// reported against the enclosing function, which declared none of them, and they are drained
		// here, before the swap back hands the enclosing list over. The two scans run in the same order
		// they do at a declared
		// function's `end`, which is the precedence between the rules.
		if not self.reportUnusedBindings(closureName) 'nothingUnused'
			self.reportVarShouldBeLet()
		end 'nothingUnused'

		lifted.valueMintedSole = self.mintedSoleColumn()

		// --- Restore the enclosing function's parse context. ---
		_ = try self.closureEnclosingFrames.pop() otherwise panic("parseClosureExpression: closureEnclosingFrames underflow — the enclosing frame pushed at entry is missing")
		self.bodyState = savedBody
		self.bodyState.liftedClosureBodies.push(OpSpan.between(bodyFirstOp, pastEnd: self.artifact.module.opCount()))

		// A capture is a mention in the enclosing function. The captured binding itself is already
		// excused by its `referenced` bit, which `emitCaptureRead` set through the enclosing object; this
		// additionally excuses another binding of the same name — a `for x` loop elsewhere in the
		// enclosing function whose `x` only the closure reads. It iterates the snapshot because the
		// closure's own list left with its body state.
		for capturedName in captureNamesSnapshot 'eachCapture'
			self.bodyState.referencedNames.push(capturedName)

			if self.bodyState.scope.contains(capturedName) 'aBindingOfThisFrame'
				self.noteOperandRead(self.bodyState.scope.getInfo(capturedName), at: self.captureMentionEnd(capturedName, closureStart: closureStart))
			end 'aBindingOfThisFrame'
		end 'eachCapture'

		self.artifact.currentFuncIndex = savedFuncIndex

		if captureCount == 0 'capturesNothing'
			return self.emitImmortalFunctionRef(closureName, anchor: functionTok)
		end 'capturesNothing'

		// ⭐ **THE INHERITED WITNESSES ARE FILLED FIRST, AND THE ORDER IS LOAD-BEARING:** one hop out,
		// closing a hop EMITS a load into the block `buildClosureEnv` is about to append its stores to, so
		// the load has to be there before the store that reads it.
		self.fillInheritedWitnessCaptures(inheritedWitnessSnapshot, capturedValues: capturedValuesSnapshot, anchor: functionTok)
		self.fillHiddenWordCapture(captureNamesSnapshot, capturedValues: capturedValuesSnapshot, word: ClosureHiddenWord.descriptor, anchor: functionTok)
		self.fillHiddenWordCapture(captureNamesSnapshot, capturedValues: capturedValuesSnapshot, word: ClosureHiddenWord.fixedElementCount, anchor: functionTok)

		lifted.closureEnvFields = self.closureEnvFieldsOf(captureNamesSnapshot, capturedTypes: capturedTypesSnapshot)

		let releasedSlots = try self.handCapturesOver(captureNamesSnapshot, capturedValues: capturedValuesSnapshot, captureAnchors: captureAnchorsSnapshot, closureName: closureName, envPosition: ownEnvSlot)
		let destructor = self.closureEnvDestructor(closureName, releasedSlots: releasedSlots, captureNames: captureNamesSnapshot, capturedTypes: capturedTypesSnapshot, closureLayout: lifted.closureLayout, anchor: functionTok)
		let result = self.buildClosureEnv(closureName, captureCount: captureCount as EnvSlotIndex, capturedValues: capturedValuesSnapshot, capturedTypes: capturedTypesSnapshot, destructor: destructor, anchor: functionTok)
		self.carryReadOnlyCaptures(result, captured: capturedValuesSnapshot, captureNames: captureNamesSnapshot, captureAnchors: captureAnchorsSnapshot)
		return result
	end 'parseClosureExpression'

	function paramTypeSites(paramTypeStarts TokenIndexArray) returns DeclaredTypeSites
		let sites = DeclaredTypeSites.create()

		for start in paramTypeStarts 'eachParam'
			sites.noteWrittenType(self.tokenAt(start))
		end 'eachParam'

		return sites
	end 'paramTypeSites'

	function declaredTypeSites(paramTypeStarts TokenIndexArray, returnTypeStart ElementIndex) returns DeclaredTypeSites
		let sites = self.paramTypeSites(paramTypeStarts)
		sites.noteWrittenReturnType(self.tokenAt(returnTypeStart))

		return sites
	end 'declaredTypeSites'

	function liftedBodyState(firstValueId ValueId, closureEnv ClosureEnvParam, returnAlias DeclaredAlias, paramSites RangeCheckParamSiteArray, layoutParam HiddenWordParam, countParam HiddenWordParam) returns FunctionBodyState
		return FunctionBodyState.fresh(self.anchors, firstValueId: firstValueId, returnSpelling: EmptySourceText, returnBrand: EmptySourceText, closureEnv: closureEnv, returnAlias: returnAlias, paramSites: paramSites, layoutParam: layoutParam, countParam: countParam, nascentSelfFactory: false, kind: EnclosingBodyKind.closureBody)
	end 'liftedBodyState'

	function pushLiftedFunction(name immutable ByteArray, returnType MaxonReturnType, paramTypes MaxonTypeArray, anchor Token) returns IrFunction
		for paramType in paramTypes 'seedParamTypes'
			self.recordParamValueType(paramType)
		end 'seedParamTypes'

		let lifted = IrFunction.create(name, maxonReturnType: returnType, paramCount: paramTypes.count() as ParamCount, maxonParamTypes: paramTypes, typeSites: self.anchors.functions.noTypeSites, valueTags: self.bodyState.valueTags, valueNameIds: self.bodyState.valueNameIds, valueBrandIds: self.bodyState.valueBrandIds, valueCapabilities: self.bodyState.valueCapabilities, valueMintedSole: self.anchors.functions.mintedSole, valueWitnessIds: self.bodyState.valueWitnessIds, declaredAt: SourcePosition.declaredAt(self.job.path, nameTok: anchor), placeholders: self.anchors.functions)
		lifted.visibility = Visibility.unexported

		let index = self.artifact.module.funcCount()
		self.artifact.module.pushFunc(lifted)
		self.artifact.currentFuncIndex = index
		self.bodyState.currentBlock = self.artifact.module.addBlock(lifted, label: b"entry", heat: BlockHeat.normal)
		return lifted
	end 'pushLiftedFunction'

	function publishLiftedBody(lifted IrFunction, returnType MaxonReturnType, signature FuncSignature, anchor Token, synthesized bool)
		self.publishExistentialInstances(lifted)
		self.stampLetCastScopes(anchor.line, lastLine: self.tokenAt(self.pos - 1).line)
		self.publishDebugLocals(lifted)
		self.artifact.recordFuncSignature(lifted.name, signature: signature, returnType: returnType, nameLine: anchor.line, nameColumn: anchor.column, sourceFilePath: self.job.path, synthesized: synthesized)
		self.commitRangeChecks(lifted.name)
	end 'publishLiftedBody'

	function closureEnvFieldsOf(captureNames NameRoster, capturedTypes MaxonTypeArray) returns ClosureEnvFieldArray
		let fields = ClosureEnvFieldArray.create(0)

		for (iter, name) in captureNames.withIterator() 'eachCapture'
			if not self.nameBindsOrIsCaptured(name) 'aCompilerWord'
				continue
			end 'aCompilerWord'

			let captureType = try capturedTypes.get(iter.index()) otherwise panic("closureEnvFieldsOf: capturedTypes.get OOB at {iter.index()} — filled in lockstep with the capture names")
			fields.push(ClosureEnvField.create(freeze displayParamName(name).toByteArray(), slot: iter.index(), declaredType: captureType))
		end 'eachCapture'

		return fields
	end 'closureEnvFieldsOf'

	function hiddenWordParamOf(word ClosureHiddenWord) returns HiddenWordParam
		return match word 'word'
			descriptor gives self.bodyState.layoutParam
			fixedElementCount gives self.bodyState.fixedElementCountParam
		end 'word'
	end 'hiddenWordParamOf'

	function closureHiddenWordSlot(word ClosureHiddenWord) returns EnvSlotIndex
		return self.captureSlotFor(hiddenWordCaptureName(word), captureType: MaxonType.integer, anchor: self.current())
	end 'closureHiddenWordSlot'

	function claimHiddenWordIfRead(lifted IrFunction, word ClosureHiddenWord)
		match self.hiddenWordParamOf(word) 'inherited'
			enclosingThroughEnv then break
			none or
			slot then return
		end 'inherited'

		if self.closureBodyReads(lifted, word: word) 'readsIt'
			_ = self.closureHiddenWordSlot(word)
		end 'readsIt'
	end 'claimHiddenWordIfRead'

	function closureEnvWord(slot EnvSlotIndex, anchor Token) returns ValueId
		return self.emitIndirectLoad(MaxonType.integer, box: self.closureEnvValue(), offset: envSlotOffset(slot), storageType: self.wordSlotStorageType(MaxonType.integer), range: SourceRange.ofToken(anchor))
	end 'closureEnvWord'

	function fillHiddenWordCapture(captureNames NameRoster, capturedValues CapturedValueArray, word ClosureHiddenWord, anchor Token)
		let slot = try captureSlotNamed(captureNames, name: hiddenWordCaptureName(word)) otherwise return
		try capturedValues.set(slot, value: CapturedValue.filled(self.hiddenWordValue(word, anchor: anchor))) otherwise panic("fillHiddenWordCapture: env slot {slot} is past the {capturedValues.count()} capture(s) this closure collected — the slot came from `captureSlotFor`, which fills every column in lockstep")
	end 'fillHiddenWordCapture'

	function hiddenWordValue(word ClosureHiddenWord, anchor Token) returns ValueId
		match self.hiddenWordParamOf(word) 'param'
			slot(valueId) then return self.ownHiddenWordValue(word, slot: valueId, anchor: anchor)
			enclosingThroughEnv then return self.closureEnvWord(self.closureHiddenWordSlot(word), anchor: anchor)
			none then panic("hiddenWordValue: the {String.from(hiddenWordCaptureName(word))} word was read inside a body that carries none — a closure inherits each hidden parameter of the body it is written in, so a reader and the reservation are one fact")
		end 'param'
	end 'hiddenWordValue'

	function ownHiddenWordValue(word ClosureHiddenWord, slot ValueId, anchor Token) returns ValueId
		return match word 'word'
			descriptor gives self.emitRuntimeCall(LayoutWordName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
			fixedElementCount gives slot
		end 'word'
	end 'ownHiddenWordValue'

	function closureBodyReads(lifted IrFunction, word ClosureHiddenWord) returns bool
		for blockRef in lifted.blockRefs 'eachBlock'
			let block = try self.artifact.module.blocks.get(blockRef) otherwise panic("closureBodyReads: blockRef from lifted.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				if self.opReads(try self.artifact.module.ops.get(opIdx) otherwise panic("closureBodyReads: opIdx {opIdx} not in module.ops"), word: word) 'aReader'
					return true
				end 'aReader'
			end 'eachOp'
		end 'eachBlock'

		return false
	end 'closureBodyReads'

	function opReads(op MaxonOp, word ClosureHiddenWord) returns bool
		if maxonOpCalleeKind(op) != MaxonCalleeKind.direct 'notADirectCall'
			return false
		end 'notADirectCall'

		match op 'reader'
			call(result, callee, args, _, _, _, _) then return self.callReads(result, callee: callee, args: args, word: word)
			tryCall(result, _, callee, args, _, _, _, _) then return self.callReads(result, callee: callee, args: args, word: word)
			serviceSpawn(_, _, state, _, callee, args, _, _, _, _, _) then return self.callReads(state, callee: callee, args: args, word: word)
			asyncCall or
			serviceSend then return false
			default panic("opReads: maxonOpCalleeKind answers direct for an op that is not call, tryCall, serviceSpawn, asyncCall or serviceSend")
		end 'reader'
	end 'opReads'

	function callReads(result ValueId, callee ByteArray, args ValueIdArray, word ClosureHiddenWord) returns bool
		return match word 'word'
			descriptor gives self.callReadsTheDescriptor(result, callee: callee, args: args)
			fixedElementCount gives self.callForwardsTheFixedElementCount(result, callee: callee, args: args)
		end 'word'
	end 'callReads'

	function callForwardsTheFixedElementCount(result ValueId, callee ByteArray, args ValueIdArray) returns bool
		if not self.signatures.functionReadsFixedElementCount(callee) 'passesNoCount'
			return false
		end 'passesNoCount'

		match try self.callLayoutSource(result, callee: callee, args: args) otherwise return true 'source'
			forwardedFromTheCaller then return true
			ofInstance(instance) then return self.instanceCountIsForwarded(instance)
		end 'source'
	end 'callForwardsTheFixedElementCount'

	function instanceCountIsForwarded(instance GenericInstanceId) returns bool
		return match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: instance as TypeNameId) 'countSource'
			stated or
			inTheRecord gives false
			callerSlot gives true
		end 'countSource'
	end 'instanceCountIsForwarded'

	function callReadsTheDescriptor(result ValueId, callee ByteArray, args ValueIdArray) returns bool
		if descriptorRuntimeCallOf(self.signatures, callee: callee, result: instanceViewOf(self.bodyState.valueTags, nameIds: self.bodyState.valueNameIds, value: result)) != DescriptorRuntimeCall.none 'aDescriptorRuntimeEntry'
			return true
		end 'aDescriptorRuntimeEntry'

		if not self.signatures.calleeMayCarryALayoutDescriptor(callee) 'passesNoDescriptor'
			return false
		end 'passesNoDescriptor'

		let source = try self.callLayoutSource(result, callee: callee, args: args) otherwise return true
		return carrierNeedOf(self.signatures, source: source) != CarrierCallNeed.none
	end 'callReadsTheDescriptor'

	function callLayoutSource(result ValueId, callee ByteArray, args ValueIdArray) returns CallLayoutSource throws AbsentError
		return try callLayoutSourceFrom(self.signatures, callee: callee, argIds: args, result: result, tags: self.bodyState.valueTags, nameIds: self.bodyState.valueNameIds, callInstances: self.callInstanceMap())
	end 'callLayoutSource'

	function callInstanceMap() returns ValueCallInstanceMap
		match self.bodyState.valueCallInstance 'state'
			unwritten then return ValueCallInstanceMap.create()
			entries(byValue) then return byValue
		end 'state'
	end 'callInstanceMap'

	function handCapturesOver(captureNames NameRoster, capturedValues CapturedValueArray, captureAnchors TokenArray, closureName immutable ByteArray, envPosition ParamCount) returns EnvSlotIndexArray throws SourceParseError
		let released = EnvSlotIndexArray.create(0)

		for (iter, name) in captureNames.withIterator() 'eachCapture'
			let slot = iter.index() as EnvSlotIndex
			let anchor = try captureAnchors.get(slot) otherwise panic("handCapturesOver: captureAnchors.get OOB at {slot} — filled in lockstep with the capture names")

			match try self.capturedBindingValue(name, anchor: anchor) 'binding'
				captured(value) then try self.handCaptureOver(value, slot: slot, anchor: anchor, captureNames: captureNames, capturedValues: capturedValues, released: released, closureName: closureName, envPosition: envPosition)
				notCaptured then continue
			end 'binding'
		end 'eachCapture'

		return released
	end 'handCapturesOver'

	function handCaptureOver(value ValueId, slot EnvSlotIndex, anchor Token, captureNames NameRoster, capturedValues CapturedValueArray, released EnvSlotIndexArray, closureName immutable ByteArray, envPosition ParamCount) throws SourceParseError
		let name = try captureNames.get(slot) otherwise panic("handCaptureOver: captureNames.get OOB at {slot} — the slot came from walking the names")
		try self.requireNotAnAcquiredState(value, verb: "captured by a closure", anchor: anchor)
		let handed = try self.handOff(slot, value: value, door: ThreadHandOffDoor.closureCapture(name), anchor: anchor)

		try capturedValues.set(slot, value: CapturedValue.filled(handed)) otherwise panic("handCaptureOver: capturedValues.set OOB at {slot} — filled in lockstep with the capture names")
		self.noteClosureCapture(closureName, position: capturedParamPosition(envPosition, slot: slot), value: handed, name: name, anchor: anchor)

		if captureCarriesAWitnessSlot(self.tagOf(handed)) 'aFatPointer'
			let witnessSlot = existentialWitnessSlotIn(captureNames, name: name)
			try capturedValues.set(witnessSlot, value: CapturedValue.filled(self.witnessOfValue(handed))) otherwise panic("handCaptureOver: capturedValues.set OOB at {witnessSlot} — filled in lockstep with the capture names")
		end 'aFatPointer'

		if self.valueIsImmortalFunction(handed) 'sharedByEveryHolder'
			return
		end 'sharedByEveryHolder'

		if self.valueIsManagedHeap(handed) or self.valueIsPromise(handed) or self.tagOf(handed) == ValueTypeTag.typeParameter 'heldByTheEnvironment'
			released.push(slot)
		end 'heldByTheEnvironment'
	end 'handCaptureOver'

	function capturedBindingValue(name ByteArray, anchor Token) returns CaptureResult throws SourceParseError
		if self.bodyState.scope.contains(name) 'thisFramesBinding'
			let binding = self.bodyState.scope.getInfo(name)
			try self.requireBindingLive(binding, nameTok: anchor)
			return CaptureResult.captured(self.bindingValue(binding, range: SourceRange.ofToken(anchor)))
		end 'thisFramesBinding'

		match self.captureScopeOf(name) 'outerFrame'
			found(_, frame) then return CaptureResult.captured(try self.emitCaptureRead(name, enclosing: self.capturedFrame(frame).scope, frame: frame, anchor: anchor))
			notCaptured then return CaptureResult.notCaptured
		end 'outerFrame'
	end 'capturedBindingValue'

	function buildClosureEnv(closureName ByteArray, captureCount EnvSlotIndex, capturedValues CapturedValueArray, capturedTypes MaxonTypeArray, destructor ValueId, anchor Token) returns ValueId
		let range = SourceRange.ofToken(anchor)
		let size = self.emitLiteral(envSlotOffset(captureCount) as FullRangeInt, valueType: MaxonType.integer, range: range)
		self.artifact.recordClosureRecordSite()
		let closureValue = self.emitBoxAllocWithDestructor(size, destructor: destructor, resultTag: ValueTypeTag.function, resultNameId: self.artifact.typeNames.intern(closureName), range: range, tag: MmTag.ClosureEnv)
		let code = self.emitCodeAddress(closureName, range: range)
		self.emitIndirectStore(closureValue, offset: FunctionRecordCodeOffset, value: code, storageType: self.wordSlotStorageType(MaxonType.integer), range: range)

		for i in 0 upto captureCount 'storeEach'
			let slotValue = try capturedValues.get(i) otherwise panic("buildClosureEnv: capturedValues.get OOB at {i} — filled in lockstep with captureNames")
			let capValue = match slotValue 'slot'
				filled(value) gives value
				unfilled panic("buildClosureEnv: env slot {i} of '{String.from(closureName)}' was never filled — every capture, hidden word and inherited witness is filled before the record is built")
			end 'slot'

			let capType = try capturedTypes.get(i) otherwise panic("buildClosureEnv: capturedTypes.get OOB at {i} — filled in lockstep with captureNames")
			self.emitIndirectStore(closureValue, offset: envSlotOffset(i), value: capValue, storageType: self.wordSlotStorageType(capType), range: range)
		end 'storeEach'

		self.trackOwnedTemp(closureValue, exclusivity: OwnedHeapExclusivity.sole)
		self.noteClosureRecordInRuntimeSource(closureValue)
		return closureValue
	end 'buildClosureEnv'

	function claimDescriptorForCaptureReleases()
		match self.hiddenWordParamOf(ClosureHiddenWord.descriptor) 'inherited'
			enclosingThroughEnv then break
			none or
			slot then return
		end 'inherited'

		if self.someCaptureMayReleaseThroughTheDescriptor() 'mayReleaseThroughIt'
			_ = self.closureHiddenWordSlot(ClosureHiddenWord.descriptor)
		end 'mayReleaseThroughIt'
	end 'claimDescriptorForCaptureReleases'

	function someCaptureMayReleaseThroughTheDescriptor() returns bool
		for capType in self.bodyState.captureTypes 'eachCapture'
			if maxonTypeTag(capType) == ValueTypeTag.typeParameter or self.signatures.typeIsManagedFor(capType, from: self.artifact.typeNames, readerFilePath: self.job.path) 'mayReleaseThroughIt'
				return true
			end 'mayReleaseThroughIt'
		end 'eachCapture'

		return false
	end 'someCaptureMayReleaseThroughTheDescriptor'

	function closureEnvDestructor(closureName ByteArray, releasedSlots EnvSlotIndexArray, captureNames NameRoster, capturedTypes MaxonTypeArray, closureLayout ClosureCaptureSource, anchor Token) returns ValueId
		let range = SourceRange.ofToken(anchor)

		if releasedSlots.isEmpty() 'holdsNothing'
			return self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)
		end 'holdsNothing'

		let dropName = self.buildClosureEnvDrop(closureName, releasedSlots: releasedSlots, captureNames: captureNames, capturedTypes: capturedTypes, closureLayout: closureLayout, anchor: anchor)
		return self.emitCodeAddress(dropName, range: range)
	end 'closureEnvDestructor'

	function buildClosureEnvDrop(closureName ByteArray, releasedSlots EnvSlotIndexArray, captureNames NameRoster, capturedTypes MaxonTypeArray, closureLayout ClosureCaptureSource, anchor Token) returns immutable ByteArray
		let dropName = closureEnvDropName(closureName)
		let range = SourceRange.ofToken(anchor)
		let savedBody = self.bodyState
		let savedFuncIndex = self.artifact.currentFuncIndex
		let envParam = 0 as ValueId

		let paramTypes = MaxonTypeArray.create(0)
		paramTypes.push(MaxonType.integer)
		self.bodyState = self.liftedBodyState(ClosureEnvDropParamCount as ValueId, closureEnv: ClosureEnvParam.param(envParam), returnAlias: self.anchors.undeclaredAlias, paramSites: RangeCheckParamSiteArray.create(0), layoutParam: closureEnvDropLayoutParam(closureLayout), countParam: HiddenWordParam.none)
		let drop = self.pushLiftedFunction(dropName, returnType: MaxonReturnType.void, paramTypes: paramTypes, anchor: anchor)
		drop.closureLayout = closureLayout
		self.artifact.recordParamOrigin(envParam, range: range)

		for slot in releasedSlots 'releaseEach'
			let capType = try capturedTypes.get(slot) otherwise panic("buildClosureEnvDrop: capturedTypes.get OOB at {slot} — a released slot is one of the closure's own captures")
			let held = self.emitIndirectLoad(capType, box: envParam, offset: envSlotOffset(slot), storageType: self.wordSlotStorageType(capType), range: range)

			if typeIsPromiseStorage(self.signatures, t: capType) 'aPromiseTheClosureOwns'
				self.markValuePromise(held)
			end 'aPromiseTheClosureOwns'

			if captureCarriesAWitnessSlot(maxonTypeTag(capType)) 'aFatPointer'
				let name = try captureNames.get(slot) otherwise panic("buildClosureEnvDrop: captureNames.get OOB at {slot} — a released slot is one of the closure's own captures")
				let witnessSlot = existentialWitnessSlotIn(captureNames, name: name)
				self.pairInterfaceWitness(held, witness: self.emitIndirectLoad(MaxonType.integer, box: envParam, offset: envSlotOffset(witnessSlot), storageType: MaxonType.integer, range: range))
			end 'aFatPointer'

			self.emitDecrefOps(held, range: range)
		end 'releaseEach'

		self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.retVoid, range: range)

		let paramNames = NameRoster.create(0)
		paramNames.push(ClosureEnvDropParamName)
		let paramDeclaredNames = NameRoster.create(0)
		paramDeclaredNames.push(EmptySourceText)
		self.publishLiftedBody(drop, returnType: MaxonReturnType.void, signature: FuncSignature.create(paramNames, paramTypes: paramTypes, paramAggregateNames: self.paramAggregateNamesOf(paramTypes), paramDeclaredNames: paramDeclaredNames, returnAggregateName: EmptySourceText, returnBrand: EmptySourceText, paramExistentialSites: ParamExistentialSiteArray.create(0), returnExistentialSites: GenericInstanceIdArray.create(0), extensionConstraints: WhereConstraintArray.create(0), writtenTypeNames: WrittenTypeNames.none(), selfSpelledParams: NoParamPositions, offeredResultAlias: EmptySourceText, byRefParams: NoParamPositions), anchor: anchor, synthesized: true)
		drop.valueMintedSole = self.mintedSoleColumn()

		self.bodyState = savedBody
		self.artifact.currentFuncIndex = savedFuncIndex
		return dropName
	end 'buildClosureEnvDrop'

	// The width of one full-word slot: `fieldStorageType`, except that an `exitCode` occupies the
	// whole machine word. It is the one door for every store and load into a slot with no neighbour to
	// pack against — a closure env slot (`buildClosureEnv`, `emitCaptureRead`) and a cell
	// (`emitCellLoad`, `emitCellStore`) — so a second spelling would silently corrupt the slot.
	//
	// An env slot is `EnvSlotBytes` wide by construction (`envSlotOffset` strides by it). `exitCode`
	// is the one scalar whose `StdType` (u32) is narrower than the word, and the slot is a whole word; the
	// value is unsigned, so a word access zero-extends it unambiguously. Not
	// folded into `fieldStorageType`: a struct field is packed against its neighbours, and widening it
	// there would move every following field.
	//
	// An `exitCode` value arrives from two producers — an indirect call through a function alias
	// (`mintIndirectCallResult`) and an interface method (`interfaceReturnMaxonType`) — so the
	// widening is at this sink rather than at either. Pinned by
	// `closure-capture.capture-exitcode-from-alias-call`, `.capture-exitcode-from-interface-method`
	// and `.capture-exitcode-wide-value`; only the last carries a value wider than one byte, so only
	// it pins the width.
	function wordSlotStorageType(declared MaxonType) returns MaxonType
		// An `unresolved` value comes only from an undeclared callee, and E3004 rejects the program
		// before anything lowers, so no width is ever read off it; `slotStorageType` panics on one.
		if tagIsUnresolved(maxonTypeTag(declared)) 'aDeferredValue'
			return declared
		end 'aDeferredValue'

		let stored = self.fieldStorageType(declared)

		return MaxonType.integer if maxonTypeTag(stored) == ValueTypeTag.exitCode else stored
	end 'wordSlotStorageType'

	// `globalAddr <label>` then `loadIndirect <addr> 0` — the two ops a global's read is.
	//
	// OFFSET 0, ALWAYS: each global is its OWN labelled slot, so the label already names the exact
	// address and there is nothing to add to it. The offset field is not dead weight — it is what
	// a field read (`p.x`) carries, through this same op.
	//
	// ⭐ **A MANAGED GLOBAL'S LOAD IS A BORROW**: the result is the record's ADDRESS, and
	// the `.data` slot keeps owning it, so the value is minted WITHOUT `markValueOwnsHeap` and nothing
	// drops it. That is not an omission — a scope-exit drop of a borrowed global would free the program's
	// only copy while the slot still points at it, and the cleanup after `main` would then double-free.
	//
	// ⚠⚠ **THE SLOT'S DECLARED AND STORAGE TYPES DO *NOT* COINCIDE, AND THIS PAIR ASKS FOR BOTH.** A global
	// holding a boxed union arrives here as `named(<union>)`. `maxonTypeToStdType` panics on a `named` outright, because
	// the tag is the value's IDENTITY and its storage is a machine word. So the ACCESS width is asked of
	// `fieldStorageType` — the split every other slot in the language already makes — while the VALUE stays
	// minted at its declared type, which is what lets a `match` on the loaded global recognize its union.
	// `slotStorageType` answers `declared` for a String, a struct, an instance and every scalar, so the
	// `named` arm is the only one that differs. `ModuleInit`'s synthesized store and the cleanup's load take
	// `declaredAggregateSlotWidth()` directly, which is the same answer reached from a stronger fact: a
	// MANAGED global's slot is a pointer whatever it points at.
	function emitGlobalLoad(label ByteArray, valueType MaxonType, range SourceRange) returns ValueId
		let addr = self.emitGlobalAddr(label, range: range)
		let storageType = self.fieldStorageType(valueType)

		if maxonTypeTag(valueType) == ValueTypeTag.named and tagIsFloat(maxonTypeTag(storageType)) 'aFloatAliasSlot'
			let loaded = self.emitIndirectLoad(storageType, box: addr, offset: GlobalSlotOffset, storageType: storageType, range: range)
			self.wearFloatAlias(loaded, aliasId: typeNameIdOf(valueType))
			return loaded
		end 'aFloatAliasSlot'

		return self.emitIndirectLoad(valueType, box: addr, offset: GlobalSlotOffset, storageType: storageType, range: range)
	end 'emitGlobalLoad'

	// The `globalAddr` half a read opens with. A POINTER, so its value is typed
	// `integer` — the Maxon tier has no pointer type today, and an address is a machine word; the
	// Std tier it lowers into is typeless anyway, and nothing dispatches on this value's tag (it is
	// read only by the load/store that follows).
	//
	// ⭐ **AN ACCESS IS ONE OP, AND NOTHING GUARDS IT.** Every managed global's slot is filled before `main`
	// by `__module_init` (⚖ user ruling: a static initializer runs eagerly, in dependency order), so a read
	// cannot meet an unfilled slot.
	function emitGlobalAddr(label ByteArray, range SourceRange) returns ValueId
		let addr = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.globalAddr(addr, label: label), range: range)
		return addr
	end 'emitGlobalAddr'

	function seatInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray)
		self.pos = decl.initStart
		self.statement.constInitializerEnd = decl.initEnd
		self.statement.initializerBinding = decl.name.clone()
		self.statement.initializerClosureHost = self.signatures.initializerClosureHostOf(decl)
		self.constEvalStack = stack
		self.seatInDeclaringTypeBody(decl)
	end 'seatInitializer'

	function openInitializerBody() returns IrFunction
		return self.openSynthesizedNullaryBody(ConstInitializerFunctionName, returnType: MaxonReturnType.void, anchor: self.current(), visibility: Visibility.unexported)
	end 'openInitializerBody'

	function requireInitializerHoldsNoLinearValue(decl TopLevelDecl, value ValueId) throws ConstEvalError
		if not self.valueIsLinear(value) 'notLinear'
			return
		end 'notLinear'

		let initTok = self.tokenAt(decl.initStart)

		throw ConstEvalError.defective(self.regionRefusal(ErrorCode.semanticLinearRefused, message: "'{String.from(decl.name)}' holds a linear value, and a module-level or `static` `let` lives for the whole program: a linear value {LinearValueResidence}, so it can be consumed exactly once", line: initTok.line, column: initTok.column))
	end 'requireInitializerHoldsNoLinearValue'

	function requireInitializerCallsNothing(decl TopLevelDecl, value ValueId, opFloor ElementIndex) throws ConstEvalError
		if self.valueIsAScalar(value) 'theScalarRulesAnswer'
			return
		end 'theScalarRulesAnswer'

		for i in opFloor upto self.artifact.module.opCount() 'eachOp'
			if self.opIsInAClosureBody(i) 'runsOnlyWhenTheClosureIsCalled'
				continue
			end 'runsOnlyWhenTheClosureIsCalled'

			let op = self.maxonOpAt(i)

			if maxonOpCalleeKind(op) != MaxonCalleeKind.direct 'notADirectCall'
				continue
			end 'notADirectCall'

			match self.initializerCallAt(i, callee: maxonOpCalleeName(op)) 'verdict'
				nothing then continue
				calls(name) then throw self.moduleLetCallRefusal(decl, callee: name)
			end 'verdict'
		end 'eachOp'
	end 'requireInitializerCallsNothing'

	function opIsInAClosureBody(op ElementIndex) returns bool
		for body in self.bodyState.liftedClosureBodies 'eachClosureBody'
			if body.holds(op) 'insideTheBody'
				return true
			end 'insideTheBody'
		end 'eachClosureBody'

		return false
	end 'opIsInAClosureBody'

	function moduleLetCallRefusal(decl TopLevelDecl, callee String) returns ConstEvalError
		let first = self.tokenAt(decl.initStart)

		let written = match decl.scope 'scope'
			fileScope gives bareNameOfMint(decl.name)
			typeBody gives decl.name
		end 'scope'

		return ConstEvalError.defective(SourceParseError.registryRefused(ErrorCode.semanticModuleLetCallsAFunction, explanation: moduleLetCallMessage(String.from(written), callee: callee), line: first.line, column: first.column, note: DiagnosticNote.none))
	end 'moduleLetCallRefusal'

	function initializerCallAt(op ElementIndex, callee ByteArray) returns InitializerCall
		if self.bodyState.literalCallOps.contains(op) 'aLiteralConstruct'
			return InitializerCall.nothing
		end 'aLiteralConstruct'

		if not isCompilerInternalCallee(callee) 'aDeclaredCallee'
			return InitializerCall.calls(self.signatures.declaredFunctionDisplay(genericTemplateName(callee)).bare())
		end 'aDeclaredCallee'

		// A member call the author wrote can lower to a compiler-internal callee (`__clone_<T>` for
		// `Map.clone`) and is still the author's call. Pinned byte-for-byte by specs/top-level-let.md.
		for member in self.bodyState.authoredMemberCalls 'eachMemberCall'
			if member.span.holds(op) 'insideTheMemberCall'
				return InitializerCall.calls(member.spelling)
			end 'insideTheMemberCall'
		end 'eachMemberCall'

		return InitializerCall.nothing
	end 'initializerCallAt'

	function noteAuthoredMemberCall(recv MethodReceiver, memberTok Token, firstOp ElementIndex)
		let pastEnd = self.artifact.module.opCount()

		if self.statement.constInitializerEnd == 0 or firstOp == pastEnd 'nothingToBlame'
			return
		end 'nothingToBlame'

		self.bodyState.authoredMemberCalls.push(AuthoredMemberCall.spanning(firstOp, pastEnd: pastEnd, spelling: "{self.receiverTypeDisplayName(recv.value)}.{String.from(memberTok.value)}"))
	end 'noteAuthoredMemberCall'

	function requireInitializerWhole(decl TopLevelDecl) throws ConstEvalError
		try self.requireInitializerConsumed(decl)
		self.reportBareUnsignedLiterals()
		try self.requireNoRecordedDefect()
	end 'requireInitializerWhole'

	function foldSweepInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray) returns FoldedInitializer throws ConstEvalError
		self.seatInitializer(decl, stack: stack)
		try self.enterConstTypeHead(TypeNameHeadForm.construction)
		try self.enterConstChain()

		if self.initializerIsRecordShaped() 'aRecordShape'
			return FoldedInitializer.runtimeRecord
		end 'aRecordShape'

		return try self.foldInitializerByBody(decl)
	end 'foldSweepInitializer'

	// ⚠ A call is never body-parsed during the sweep: emitting one closes whole-program relations
	// (`programTakesAParamByRef`, `programReturnsAnImmutableGlobalAlias`) before every declaration is
	// recorded, and they stay closed. An initializer with a call is deferred to the record probe.
	function initializerIsRecordShaped() returns bool
		for q in self.pos upto self.statement.constInitializerEnd 'eachToken'
			let kind = self.kindAt(q)

			if kind == TokenKind.leftBracket or kind == TokenKind.leftBrace or kind == TokenKind.from or kind == TokenKind.comma 'aRecordToken'
				return true
			end 'aRecordToken'

			if kind == TokenKind.identifier and self.kindAt(q + 1) == TokenKind.leftParen 'aCall'
				return true
			end 'aCall'
		end 'eachToken'

		return false
	end 'initializerIsRecordShaped'

	function foldInitializerByBody(decl TopLevelDecl) returns FoldedInitializer throws ConstEvalError
		let body = self.openInitializerBody()
		let entry = self.bodyState.currentBlock
		let opFloor = self.artifact.module.opCount()

		let value = try self.parseExpression(body, block: entry) otherwise (err) 'refused'
			if self.statement.constDependsOnARecord 'readsARecord'
				return FoldedInitializer.runtimeRecord
			end 'readsARecord'

			try self.requireNoFailedDependency()
			throw ConstEvalError.defective(err)
		end 'refused'

		try self.requireNoFailedDependency()
		try self.requireInitializerHoldsNoLinearValue(decl, value: value)
		try self.requireInitializerCallsNothing(decl, value: value, opFloor: opFloor)

		if self.statement.constDependsOnARecord 'readsARecord'
			return FoldedInitializer.runtimeRecord
		end 'readsARecord'

		try self.requireInitializerWhole(decl)

		return try self.foldedValueOfBodyResult(decl, value: value)
	end 'foldInitializerByBody'

	function probeRecordInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray) returns RecordInitializerProbe throws ConstEvalError
		self.seatInitializer(decl, stack: stack)

		let body = self.openInitializerBody()
		let entry = self.bodyState.currentBlock
		let opFloor = self.artifact.module.opCount()

		let value = try self.parseExpression(body, block: entry) otherwise (err) 'refused'
			self.recordTypeNamesPastTheCursor()
			try self.requireNoFailedDependency()
			throw ConstEvalError.defective(err)
		end 'refused'

		try self.requireNoFailedDependency()
		try self.requireInitializerWhole(decl)
		try self.requireInitializerHoldsNoLinearValue(decl, value: value)
		try self.requireInitializerCallsNothing(decl, value: value, opFloor: opFloor)
		self.signatures.noteInitializerClosureShapes(self.closureShapes, from: self.artifact.typeNames)

		return try self.probedRecordOf(decl, value: value)
	end 'probeRecordInitializer'

	function probedRecordOf(decl TopLevelDecl, value ValueId) returns RecordInitializerProbe throws ConstEvalError
		if self.constIsKnown(value) or self.floatConstIsKnown(value) 'aKnownScalar'
			return RecordInitializerProbe.scalar(self.constValueOfKnown(value))
		end 'aKnownScalar'

		if self.valueIsAnInlineRecord(value) 'anInlineRecord'
			if let word = try self.probedInlineWordOf(value) 'aFoldedWord'
				return RecordInitializerProbe.scalar(word)
			end 'aFoldedWord'
		end 'anInlineRecord'

		if self.valueIsAScalar(value) 'aNonConstantScalar'
			return RecordInitializerProbe.unvalidated(try self.followUpOfNonConstantScalar(decl))
		end 'aNonConstantScalar'

		if self.valueIsDeferred(value) 'anUnresolvedValue'
			return RecordInitializerProbe.unvalidated(InitializerFollowUp.none)
		end 'anUnresolvedValue'

		try self.requireGlobalIsNotAnExistential(decl, value: value)

		let valueType = self.signatures.adoptTypeFrom(self.typeOf(value), from: self.artifact.typeNames)
		try self.requireGlobalContainerElementsAreNotBuffers(decl, brand: self.brandOf(value))
		let settled = ProbedRecord.create(valueType, brand: self.brandOf(value), runsProgramCode: self.probeRunsProgramCode(), mapColumns: self.probedMapColumns(value), shape: self.probedShape(decl, value: value))

		return RecordInitializerProbe.record(settled)
	end 'probedRecordOf'

	function probedInlineWordOf(value ValueId) returns ConstValue throws AbsentError
		let nodes = ProbedConstructionArray.create(0)
		let slot = try self.probedImageSlotOf(value, nodes: nodes)

		match slot 'slot'
			inlineWord(payload, typeName) then return ConstValue.create(payload, tag: ValueTypeTag.structRef, typeName: typeName)
			scalar or
			emptyContainer or
			helperDefault or
			unionCase or
			box then throw AbsentError.absent
		end 'slot'
	end 'probedInlineWordOf'

	function requireGlobalIsNotAnExistential(decl TopLevelDecl, value ValueId) throws ConstEvalError
		let first = self.tokenAt(decl.initStart)

		try self.requireStorableDeclaredType(self.typeOf(value), position: DeclaredStoragePosition.globalBinding, line: first.line, column: first.column) otherwise (err) 'anExistential'
			throw ConstEvalError.defective(err)
		end 'anExistential'
	end 'requireGlobalIsNotAnExistential'

	function requireGlobalContainerElementsAreNotBuffers(decl TopLevelDecl, brand ByteArray) throws ConstEvalError
		if brand.isEmpty() or not self.signatures.aliasElementIsBufferSurface(brand, readerFilePath: self.job.path) 'notABufferContainer'
			return
		end 'notABufferContainer'

		let first = self.tokenAt(decl.initStart)
		throw ConstEvalError.defective(SourceParseError.unsupported("a top-level `{String.from(brand)}` — its elements are `{String.from(ManagedMemoryTypeName)}` buffers, and a global is re-loaded at every use, so an element read out of it would carry the `{String.from(self.signatures.arrayRecordDeclaredName())}` surface instead. Declare an array of buffers inside a function", line: first.line, column: first.column))
	end 'requireGlobalContainerElementsAreNotBuffers'

	function probeRunsProgramCode() returns bool
		for i in 0 upto self.artifact.module.opCount() 'eachOp'
			let op = self.maxonOpAt(i)

			if maxonOpCalleeKind(op) == MaxonCalleeKind.direct and not isCompilerInternalCallee(maxonOpCalleeName(op)) 'aDeclaredCallee'
				return true
			end 'aDeclaredCallee'

			if maxonOpNamesAGlobalLabel(op) 'aGlobalSlot'
				return true
			end 'aGlobalSlot'
		end 'eachOp'

		return false
	end 'probeRunsProgramCode'

	function probedMapColumns(value ValueId) returns MapLiteralColumns
		if not self.signatures.isMapShapedInstanceAt(self.tagOf(value), nameId: self.valueNameId(value)) 'notAMap'
			return MapLiteralColumns.none
		end 'notAMap'

		let pair = try self.literalColumnsOf(value) otherwise return MapLiteralColumns.none
		return MapLiteralColumns.columns(pair.boundsOf(LiteralColumn.first), values: pair.boundsOf(LiteralColumn.second))
	end 'probedMapColumns'

	function probedShape(decl TopLevelDecl, value ValueId) returns ProbedShape
		let blob = try self.constantBlobShape(value) otherwise 'notABlob'
			return self.shapeOfNotedValue(decl, value: value)
		end 'notABlob'

		return blob
	end 'probedShape'

	function shapeOfNotedValue(decl TopLevelDecl, value ValueId) returns ProbedShape
		if self.initializerIsAStringTable(decl) 'aStringTable'
			return ProbedShape.stringTable(self.stringTableTexts())
		end 'aStringTable'

		let nodes = ProbedConstructionArray.create(0)
		let slot = try self.probedImageSlotOf(value, nodes: nodes) otherwise return ProbedShape.opaque

		return match slot 'slot'
			emptyContainer gives ProbedShape.emptyContainer
			unionCase(typeName, caseName) gives ProbedShape.payloadFreeUnionCase(typeName, caseName: caseName)
			box gives ProbedShape.construction(nodes)
			inlineWord panic("Parser.shapeOfNotedValue: '{String.from(decl.name)}' is an inline record's word, and `probedRecordOf` settles it as a scalar before any shape is read")
			scalar or
			helperDefault gives ProbedShape.opaque
		end 'slot'
	end 'shapeOfNotedValue'

	function adoptedTypeOf(value ValueId) returns MaxonType
		return self.signatures.adoptTypeFrom(self.typeOf(value), from: self.artifact.typeNames)
	end 'adoptedTypeOf'

	function probedImageSlotOf(value ValueId, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		if self.constIsKnown(value) or self.floatConstIsKnown(value) 'aKnownScalar'
			let known = self.constValueOfKnown(value)
			return ProbedSlot.scalar(known.payload, kind: probedScalarKindOfConst(known))
		end 'aKnownScalar'

		let note = try self.imageNotes.get(value) otherwise throw AbsentError.absent

		match note 'note'
			construction(layout, fields) then return try self.probedConstructionSlot(layout, fields: fields, nodes: nodes)
			call(callee, args, labels) then return try self.probedCallSlot(value, callee: callee, args: args, labels: labels, nodes: nodes)
			unionCase(typeName, caseName) then return ProbedSlot.unionCase(typeName, caseName: caseName)
			emptyContainer then return try self.probedEmptyContainerSlot(value)
			inlineWord(payload, typeName) then return ProbedSlot.inlineWord(payload, typeName: typeName)
		end 'note'
	end 'probedImageSlotOf'

	function probedEmptyContainerSlot(container ValueId) returns ProbedSlot throws AbsentError
		if not self.valueIsLeftUntouched(container) 'aPopulatedContainer'
			throw AbsentError.absent
		end 'aPopulatedContainer'

		return ProbedSlot.emptyContainer(self.adoptedTypeOf(container))
	end 'probedEmptyContainerSlot'

	function valueIsLeftUntouched(value ValueId) returns bool
		let operands = ValueIdArray.create(0)

		for i in 0 upto self.artifact.module.opCount() 'eachOp'
			let op = self.maxonOpAt(i)
			maxonOpOperandValues(op, into: operands)

			if operands.contains(value) and not self.opStoresAsAFieldValue(op, value: value) 'aUseBeyondTheFieldStore'
				return false
			end 'aUseBeyondTheFieldStore'
		end 'eachOp'

		return true
	end 'valueIsLeftUntouched'

	function opStoresAsAFieldValue(op MaxonOp, value ValueId) returns bool
		let stored = try storedFieldValueOf(op) otherwise return false
		return stored == value
	end 'opStoresAsAFieldValue'

	function probedCallSlot(value ValueId, callee ByteArray, args ValueIdArray, labels NameRoster, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		if args.count() == 0 and self.calleeIsTheContainersCreate(value, callee: callee) 'anEmptyContainer'
			return try self.probedEmptyContainerSlot(value)
		end 'anEmptyContainer'

		let folded = try self.probedFactoryConstruction(value, callee: callee, args: args, labels: labels, nodes: nodes) otherwise 'notAFoldableFactory'
			if args.count() == 0 'aParameterDefaultHelper'
				return ProbedSlot.helperDefault(callee)
			end 'aParameterDefaultHelper'

			throw AbsentError.absent
		end 'notAFoldableFactory'

		return folded
	end 'probedCallSlot'

	function calleeIsTheContainersCreate(value ValueId, callee ByteArray) returns bool
		let valueType = self.adoptedTypeOf(value)

		if maxonTypeTag(valueType) != ValueTypeTag.genericInstance 'notAContainer'
			return false
		end 'notAContainer'

		return callee.equals(qualifiedMethodName(self.signatures.genericInstanceBaseName(genericInstanceIdOf(valueType)), methodName: CreateMethod))
	end 'calleeIsTheContainersCreate'

	function probedConstructionSlot(layout StructLayout, fields ValueIdArray, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		let slots = ProbedSlotArray.create(fields.count(), zeroed: false)

		for i in 0 upto fields.count() 'eachField'
			slots.push(try self.probedFieldSlot(layout, index: i as FieldIndex, value: try fields.get(i) otherwise throw AbsentError.absent, nodes: nodes))
		end 'eachField'

		return try self.probedSlotOfFilledLayout(layout, slots: slots, nodes: nodes)
	end 'probedConstructionSlot'

	function probedSlotOfFilledLayout(layout StructLayout, slots ProbedSlotArray, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		if self.signatures.layoutPacksInlineIntoAWord(layout) 'theValueIsTheWord'
			return ProbedSlot.inlineWord(try inlineWordOfProbedSlots(layout, slots: slots), typeName: layout.name)
		end 'theValueIsTheWord'

		return ProbedSlot.box(pushProbedConstruction(nodes, construction: ProbedConstruction.create(layout.name, slots: slots)))
	end 'probedSlotOfFilledLayout'

	function probedFieldSlot(layout StructLayout, index FieldIndex, value ValueId, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		let slot = try self.probedImageSlotOf(value, nodes: nodes)

		match slot 'slot'
			scalar then try self.requireValueFitsDeclaredAlias(self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames), value: value)
			emptyContainer or
			helperDefault or
			unionCase or
			inlineWord or
			box then break
		end 'slot'

		return slot
	end 'probedFieldSlot'

	function requireValueFitsDeclaredAlias(declared MaxonType, value ValueId) throws AbsentError
		match self.declaredAliasOfType(declared) 'alias'
			declared(alias) then try self.requireValueFitsAlias(value, alias: alias)
			undeclared then break
		end 'alias'
	end 'requireValueFitsDeclaredAlias'

	function requireValueFitsAlias(value ValueId, alias RangedTypeAlias) throws AbsentError
		let isFloat = self.floatConstIsKnown(value)
		let payload = self.floatConstBitsOf(value) if isFloat else self.constOf(value)

		if not literalInRange(payload, low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: valueIsMarked(self.bodyState.writtenNegativeLiterals, value: value) and not isFloat, writtenAboveSignedMax: valueIsMarked(self.bodyState.unsignedMaxLiterals, value: value) and not isFloat) 'outsideTheRange'
			throw AbsentError.absent
		end 'outsideTheRange'
	end 'requireValueFitsAlias'

	function argIsALiteralCast(arg ValueId) returns bool
		return match self.bodyState.literalCastArguments 'function'
			unwritten gives false
			entries(confirmed) gives confirmed.contains(arg)
		end 'function'
	end 'argIsALiteralCast'

	function requireArgFitsParameter(callee ByteArray, arg ValueId, argIndex ParamCount, label ByteArray) throws AbsentError
		if self.argIsALiteralCast(arg) 'anUnneededCastCandidate'
			throw AbsentError.absent
		end 'anUnneededCastCandidate'

		if not (self.constIsKnown(arg) or self.floatConstIsKnown(arg)) 'notAConstant'
			return
		end 'notAConstant'

		match self.signatures.parameterAliasAt(callee, argIndex: argIndex, label: label) 'alias'
			declared(alias) then try self.requireValueFitsAlias(arg, alias: alias)
			undeclared then break
		end 'alias'
	end 'requireArgFitsParameter'

	function probedFactoryConstruction(value ValueId, callee ByteArray, args ValueIdArray, labels NameRoster, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		if not self.signatures.functionConstructsFromParams(callee) or maxonTypeTag(self.typeOf(value)) == ValueTypeTag.genericInstance 'notAFoldableFactory'
			throw AbsentError.absent
		end 'notAFoldableFactory'

		let decl = try self.declarationNameableBy(callee, callerName: EmptySourceText) otherwise throw AbsentError.absent

		match self.signatures.constFactoryConstructionOf(decl) 'known'
			unfoldable then throw AbsentError.absent
			folds(layout, paramNames) then return try self.probedFactoryFields(callee, layout: layout, paramNames: paramNames, args: args, labels: labels, nodes: nodes)
		end 'known'
	end 'probedFactoryConstruction'

	function probedFactoryFields(callee ByteArray, layout StructLayout, paramNames NameRoster, args ValueIdArray, labels NameRoster, nodes ProbedConstructionArray) returns ProbedSlot throws AbsentError
		let supplied = FixedValueIdArray.create(layout.fieldCount())
		let filled = FixedBoolArray.create(layout.fieldCount())

		for i in 0 upto args.count() 'eachArgument'
			let label = callArgumentLabel(labels, argIndex: i as ParamCount)
			let position = try argSlotPosition(paramNames, argIndex: i as ParamCount, label: label) otherwise throw AbsentError.absent
			let fieldName = try paramNames.get(position) otherwise throw AbsentError.absent
			let index = try layout.indexOfField(fieldName) otherwise throw AbsentError.absent
			let arg = try args.get(i) otherwise throw AbsentError.absent

			try self.requireArgFitsParameter(callee, arg: arg, argIndex: i as ParamCount, label: label)
			try supplied.set(index, value: arg) otherwise throw AbsentError.absent
			try filled.set(index, value: true) otherwise throw AbsentError.absent
		end 'eachArgument'

		let slots = ProbedSlotArray.create(layout.fieldCount(), zeroed: false)

		for i in 0 upto layout.fieldCount() 'eachField'
			let isSupplied = try filled.get(i) otherwise throw AbsentError.absent

			if isSupplied 'fromTheCall'
				slots.push(try self.probedFieldSlot(layout, index: i as FieldIndex, value: try supplied.get(i) otherwise throw AbsentError.absent, nodes: nodes))
				continue
			end 'fromTheCall'

			slots.push(try self.probedFieldDefaultSlot(layout, index: i as FieldIndex))
		end 'eachField'

		return try self.probedSlotOfFilledLayout(layout, slots: slots, nodes: nodes)
	end 'probedFactoryFields'

	function probedFieldDefaultSlot(layout StructLayout, index FieldIndex) returns ProbedSlot throws AbsentError
		match fieldDefaultFill(layout, index: index) 'declared'
			none then throw AbsentError.absent
			literal(given) then return ProbedSlot.scalar(given.payload, kind: probedScalarKindOfConst(given))
			callsHelper(helperName) then return ProbedSlot.helperDefault(helperName)
		end 'declared'
	end 'probedFieldDefaultSlot'

	function constantBlobShape(value ValueId) returns ProbedShape throws AbsentError
		let opCount = self.artifact.module.opCount()

		if opCount == 0 'noOpEmitted'
			throw AbsentError.absent
		end 'noOpEmitted'

		match self.maxonOpAt(opCount - 1) 'defining'
			constArrayLiteral(result, elementSize, elementCount, bytes) then return try self.blobShapeOf(result, value: value, elementSize: elementSize, elementCount: elementCount, bytes: bytes)
			default throws AbsentError.absent
		end 'defining'
	end 'constantBlobShape'

	function blobShapeOf(result ValueId, value ValueId, elementSize ElementStride, elementCount FullRangeInt, bytes ByteArray) returns ProbedShape throws AbsentError
		if result != value or maxonTypeTag(self.typeOf(value)) != ValueTypeTag.genericInstance 'notAnArrayRecord'
			throw AbsentError.absent
		end 'notAnArrayRecord'

		let pair = try self.literalColumnsOf(value) otherwise return ProbedShape.constBlob(elementSize, elementCount: elementCount, bytes: bytes, bounds: ColumnBounds.unknown)

		return ProbedShape.constBlob(elementSize, elementCount: elementCount, bytes: bytes, bounds: pair.boundsOf(LiteralColumn.first))
	end 'blobShapeOf'

	function fixedArrayFromHeadLengthAt(index ElementIndex) returns ElementIndex
		if self.kindAt(index) != TokenKind.identifier or self.kindAt(index + 1) != TokenKind.from 'notAFromHead'
			return 0
		end 'notAFromHead'

		let head = self.signatures.bareWrittenKey(self.tokenAt(index).value, readerFilePath: self.job.path)

		if fromHeadIsTheBareBase(head, container: FromHeadContainer.fixedArray) or self.namesContainerInstanceAlias(head, container: FromHeadContainer.fixedArray) 'aFixedArrayHead'
			return FromHeadTokenCount
		end 'aFixedArrayHead'

		return 0
	end 'fixedArrayFromHeadLengthAt'

	function initializerIsAStringTable(decl TopLevelDecl) returns bool
		let literalStart = decl.initStart + self.fixedArrayFromHeadLengthAt(decl.initStart)

		if self.kindAt(literalStart) != TokenKind.leftBracket or self.kindAt(decl.initEnd - 1) != TokenKind.rightBracket 'notBracketed'
			return false
		end 'notBracketed'

		var strings = 0 as ElementIndex

		for q in literalStart + 1 upto decl.initEnd - 1 'eachToken'
			let kind = self.kindAt(q)

			if kind == TokenKind.stringLiteral 'aText'
				strings = strings + 1
				continue
			end 'aText'

			if kind != TokenKind.comma 'notATable'
				return false
			end 'notATable'
		end 'eachToken'

		return strings > 0
	end 'initializerIsAStringTable'

	function stringTableTexts() returns ByteBlobArray
		let texts = ByteBlobArray.create(0)

		for i in 0 upto self.artifact.module.opCount() 'eachOp'
			if let bytes = try stringLiteralBytesOf(self.maxonOpAt(i)) 'aStringLiteral'
				texts.push(bytes)
			end 'aStringLiteral'
		end 'eachOp'

		return texts
	end 'stringTableTexts'

	function storedFieldValueOf(op MaxonOp) returns ValueId throws AbsentError
		match op 'op'
			storeIndirect(_, _, value, _) then return value
			default throws AbsentError.absent
		end 'op'
	end 'storedFieldValueOf'

	function stringLiteralBytesOf(op MaxonOp) returns immutable ByteArray throws AbsentError
		match op 'op'
			stringLiteral(_, bytes) then return bytes
			default throws AbsentError.absent
		end 'op'
	end 'stringLiteralBytesOf'

	function nonConstantInitializerError(decl TopLevelDecl) returns ConstEvalError
		let first = self.tokenAt(decl.initStart)
		return ConstEvalError.defective(SourceParseError.nonConstantInitializer(String.from(decl.name), leftover: self.tokenTextFrom(decl.initStart, endIndex: decl.initEnd), line: first.line, column: first.column))
	end 'nonConstantInitializerError'

	function followUpOfNonConstantScalar(decl TopLevelDecl) returns InitializerFollowUp throws ConstEvalError
		for q in decl.initStart upto decl.initEnd 'eachToken'
			if self.kindAt(q) == TokenKind.identifier and self.kindAt(q + 1) == TokenKind.leftParen 'theFirstCall'
				let callee = self.tokenAt(q)
				return InitializerFollowUp.nonConstantCall(callee.value, line: callee.line, column: callee.column)
			end 'theFirstCall'
		end 'eachToken'

		throw self.nonConstantInitializerError(decl)
	end 'followUpOfNonConstantScalar'

	function requireNoFailedDependency() throws ConstEvalError
		if self.statement.constDependencyFailed 'aDependencyFailed'
			throw ConstEvalError.dependencyFailed
		end 'aDependencyFailed'
	end 'requireNoFailedDependency'

	function requireNoRecordedDefect() throws ConstEvalError
		try self.requireNoDefectIn(self.artifact.diagnostics)
		try self.requireNoDefectIn(self.artifact.secondaryDiagnostics)
	end 'requireNoRecordedDefect'

	function requireNoDefectIn(recorded DiagnosticArray) throws ConstEvalError
		for diagnostic in recorded 'eachDiagnostic'
			match diagnostic.anchor 'anchor'
				at(_, line, column) then throw ConstEvalError.defective(SourceParseError.registryRefused(diagnostic.code, explanation: diagnostic.message, line: line, column: column, note: DiagnosticNote.none))
				programWide or
				file then panic("Parser.requireNoDefectIn: a diagnostic recorded while folding an initializer carries no source position — `recordArtifactDiagnostic` anchors every one at a range")
			end 'anchor'
		end 'eachDiagnostic'
	end 'requireNoDefectIn'

	function foldedValueOfBodyResult(decl TopLevelDecl, value ValueId) returns FoldedInitializer throws ConstEvalError
		if self.constIsKnown(value) or self.floatConstIsKnown(value) 'aKnownScalar'
			return FoldedInitializer.scalar(self.constValueOfKnown(value))
		end 'aKnownScalar'

		let literal = try self.knownManagedLiteral(value) otherwise 'notALiteral'
			if self.valueIsAScalar(value) 'aNonConstantScalar'
				throw self.nonConstantInitializerError(decl)
			end 'aNonConstantScalar'

			return FoldedInitializer.runtimeRecord
		end 'notALiteral'

		return literal
	end 'foldedValueOfBodyResult'

	function valueIsAScalar(value ValueId) returns bool
		let tag = self.tagOf(value)

		if tag != ValueTypeTag.named 'notANamedValue'
			return tag == ValueTypeTag.integer or tag == ValueTypeTag.boolean or tag == ValueTypeTag.float
		end 'notANamedValue'

		let namedEnum = self.signatures.enumFor(self.valueTypeName(value), readerFilePath: self.job.path)

		if not enumMatchIsDeclared(namedEnum) 'aRangedAlias'
			return true
		end 'aRangedAlias'

		return not requireEnumLayout(namedEnum).carriesPayloads()
	end 'valueIsAScalar'

	function constValueOfKnown(value ValueId) returns ConstValue
		let alias = self.operandAliasName(value)

		if self.floatConstIsKnown(value) 'aFloat'
			return ConstValue.create(self.floatConstBitsOf(value), tag: ValueTypeTag.float, typeName: alias)
		end 'aFloat'

		let payload = self.constOf(value)

		return match self.tagOf(value) 'tag'
			boolean gives ConstValue.create(payload, tag: ValueTypeTag.boolean)
			integer gives ConstValue.create(payload, tag: ValueTypeTag.integer, typeName: alias)
			exitCode gives ConstValue.create(payload, tag: ValueTypeTag.exitCode, typeName: alias)
			named gives self.constValueOfNamed(value, payload: payload, alias: alias)
			default panic("Parser.constValueOfKnown: v{value} is a known constant tagged '{typeTagName(self.tagOf(value))}' — only booleans, integers, exit codes, floats and named integers (an enum case, a ranged alias) are ever known")
		end 'tag'
	end 'constValueOfKnown'

	function constValueOfNamed(value ValueId, payload FullRangeInt, alias immutable ByteArray) returns ConstValue
		if alias.isEmpty() 'anEnumCase'
			let declared = self.signatures.enumFor(self.valueTypeName(value), readerFilePath: self.job.path)
			return ConstValue.create(payload, tag: ValueTypeTag.named, typeName: requireEnumLayout(declared).name)
		end 'anEnumCase'

		return ConstValue.create(payload, tag: ValueTypeTag.integer, typeName: alias)
	end 'constValueOfNamed'

	function knownManagedLiteral(value ValueId) returns FoldedInitializer throws AbsentError
		let opCount = self.artifact.module.opCount()

		if opCount == 0 'noOpEmitted'
			throw AbsentError.absent
		end 'noOpEmitted'

		match self.maxonOpAt(opCount - 1) 'defining'
			stringLiteral(result, bytes) then return try self.managedLiteralOf(result, bytes: bytes, defines: value)
			constArrayLiteral(result, elementSize, _, bytes) then return try self.byteStringLiteralOf(result, elementSize: elementSize, bytes: bytes, defines: value)
			default throws AbsentError.absent
		end 'defining'
	end 'knownManagedLiteral'

	function managedLiteralOf(result ValueId, bytes ByteArray, defines ValueId) returns FoldedInitializer throws AbsentError
		if result != defines 'anotherValue'
			throw AbsentError.absent
		end 'anotherValue'

		let kind = ManagedConstKind.character if self.tagOf(result) == ValueTypeTag.character else ManagedConstKind.string
		return FoldedInitializer.managed(bytes, kind: kind)
	end 'managedLiteralOf'

	function byteStringLiteralOf(result ValueId, elementSize ElementStride, bytes ByteArray, defines ValueId) returns FoldedInitializer throws AbsentError
		if result != defines or elementSize != ByteStringElementSize as ElementStride 'notTheByteString'
			throw AbsentError.absent
		end 'notTheByteString'

		return FoldedInitializer.managed(bytes, kind: ManagedConstKind.byteArray)
	end 'byteStringLiteralOf'

	function enclosingTypeNameOrEmpty() returns immutable ByteArray
		return try self.enclosingType.typeName() otherwise EmptySourceText
	end 'enclosingTypeNameOrEmpty'

	// ⭐⭐ **SEAT THE INITIALIZER IN THE BODY THE DECLARATION WAS WRITTEN IN.** An initializer parser is built
	// per DECL over a token range, so it starts at file scope however the binding was declared — and a
	// `static let origin = Pair{…}` is written INSIDE `type Pair`, which is the whole of why that literal is
	// legal there and E3076 anywhere else. Seating the owning type is what lets the construction door reach
	// `requireConstructible` VERBATIM instead of restating a location rule.
	//
	// The KIND rides with the name because `enterTypeScope` takes both and they are one fact — a `static`
	// inside an `enum` body must reach the enum's own refusal rather than a `structOf` miss (`requireConstructible`).
	function seatInDeclaringTypeBody(decl TopLevelDecl)
		match decl.scope 'declaredIn'
			fileScope then break
			typeBody(typeName) then self.enterTypeScopeOf(typeName)
		end 'declaredIn'
	end 'seatInDeclaringTypeBody'

	function writtenSpellingOfMemberAt(memberIndex ElementIndex) returns String
		let headIndex = self.writtenChainHeadIndex(memberIndex - TokensPerQualifierSegment)
		return String.from(self.assembleDottedChainAt(headIndex, dots: ((memberIndex - headIndex) / TokensPerQualifierSegment)))
	end 'writtenSpellingOfMemberAt'

	function writtenChainHeadIndex(baseIndex ElementIndex) returns ElementIndex
		var head = baseIndex

		if not self.qualifiedTypeBaseIsAt(baseIndex) 'aPlainBase'
			return head
		end 'aPlainBase'

		while head >= TokensPerQualifierSegment and self.kindAt(head - 1) == TokenKind.dot and self.kindAt(head - TokensPerQualifierSegment) == TokenKind.identifier 'eachQualifier'
			head = head - TokensPerQualifierSegment
		end 'eachQualifier'

		return head
	end 'writtenChainHeadIndex'

	function enterConstTypeHead(form TypeNameHeadForm) throws ConstEvalError
		let verdict = try self.enterQualifiedTypeHead(form) otherwise (err) 'unresolvable'
			throw ConstEvalError.defective(err)
		end 'unresolvable'

		try self.refuseHiddenTypeName(verdict)
	end 'enterConstTypeHead'

	function enterConstChain() throws ConstEvalError
		_ = try self.enterQualifiedChainAtCursor(MethodQualifierDots + 1) otherwise (err) 'unresolvable'
			throw ConstEvalError.defective(err)
		end 'unresolvable'
	end 'enterConstChain'

	// `parseExpression` stops at the first token that cannot continue the expression, so without this the
	// rest of the initializer is dropped silently and the binding becomes whatever the prefix came to.
	function requireInitializerConsumed(decl TopLevelDecl) throws ConstEvalError
		try self.requireInitializerEnded(decl) otherwise (err) 'trailingTokens'
			throw ConstEvalError.defective(err)
		end 'trailingTokens'
	end 'requireInitializerConsumed'

	function requireInitializerEnded(decl TopLevelDecl) throws SourceParseError
		if self.pos >= decl.initEnd 'fullyConsumed'
			return
		end 'fullyConsumed'

		let tok = self.current()
		throw SourceParseError.strayToken(tokenDisplayText(tok), line: tok.line, column: tok.column)
	end 'requireInitializerEnded'

	// The source text of a token range, as the diagnostic prints it — **laid out at the COLUMNS the author
	// wrote them at**, so `.toByteArray()` prints as `.toByteArray()` and `1 + 2` prints as `1 + 2`.
	//
	// ⚠ It does not space-join: `. toByteArray ( )` is not text anybody wrote. This parser holds TOKENS and
	// no source buffer, and its punctuation tokens carry no byte offsets (`Token.startByte` is 0 for every
	// punctuator), so the column is the only positional fact available for every token — and it is enough:
	// writing each token's spelling at its own column reproduces the line.
	//
	// ⚠ The cursor advances by the SPELLING's length, and that is the source width for every token —
	// including a quoted literal, whose delimiters `tokenSourceSpelling` restores. Reading `value`
	// directly under-advances a string literal by two and pads the next gap two spaces wider.
	//
	// ⚠ **A TOKEN'S `value` IS ITS LEXEME ONLY WHERE THE KIND DOES NOT ALREADY IMPLY ONE.** The lexer
	// fills it for words and literals — keywords included — and leaves it EMPTY for punctuation, whose
	// spelling is `TokenKind.rawValue` (the same text `consume` puts in a mismatch). Reading `value`
	// alone therefore prints NOTHING for a span made of punctuation — `var xs = [1]]` and
	// `var a = 1)` both report `''`, a diagnostic that promises to name source text and then names
	// nothing at all.
	//
	// ⚠ **EVERY DIAGNOSTIC THAT NAMES A SPAN OF SOURCE ASKS THIS** — a duplicate pattern, a single-value
	// range (`-5`, `'a' upto 'b'`), a cast's target — and a second loop over the same tokens with its own
	// spelling rule is the drift `tokenDisplayText`'s header warns about — it does not fail loudly, it
	// quietly names the offending token something the source never wrote.
	function tokenTextFrom(start ElementIndex, endIndex ElementIndex) returns String
		// Appended in place: a span may be a whole statement, and rebuilding the string per token copies
		// it once per token.
		var text = ""
		var cursor = self.tokenAt(start).column

		for i in start upto endIndex 'each'
			let tok = self.tokenAt(i)

			// A token on a LATER line restarts the layout: one space stands in for the newline, and the
			// cursor is re-seeded from that token so the rest of its line lays out against its own columns.
			if tok.column < cursor 'wrappedToANewLine'
				text.append(" ")
				cursor = tok.column
			end 'wrappedToANewLine'

			while cursor < tok.column 'padToItsColumn'
				text.append(" ")
				cursor = cursor + 1
			end 'padToItsColumn'

			let spelling = tokenSourceSpelling(tok)
			text.append(spelling)
			cursor = cursor + (spelling.count() as ColumnNumber)
		end 'each'

		return text
	end 'tokenTextFrom'

	// A library initializer files no reads, so the library's own `let`s cost the E3010 check nothing on
	// every compile.
	export function recordedLetCastReads() returns LetCastReadArray
		if self.isLibrarySource() 'aLibraryInitializer'
			return LetCastReadArray.create(0)
		end 'aLibraryInitializer'

		return match self.bodyState.letCasts 'tracking'
			none gives LetCastReadArray.create(0)
			tracking(state) gives state.reads
		end 'tracking'
	end 'recordedLetCastReads'

	// A refused initializer parse stops short of the initializer's end, so the names written past it are
	// recorded here; a typealias only they name would otherwise be reported unused (E3062).
	export function recordTypeNamesPastTheCursor()
		for q in self.pos upto self.statement.constInitializerEnd 'eachRemainingToken'
			if self.kindAt(q) == TokenKind.identifier and self.kindAt(q + 1) != TokenKind.colon and self.kindAt(q - 1) != TokenKind.dot 'aWrittenName'
				self.recordTypeNameUse(self.tokenAt(q).value)
			end 'aWrittenName'
		end 'eachRemainingToken'
	end 'recordTypeNamesPastTheCursor'

	// ⭐ **IS `name` A METHOD OF THE ENCLOSING TYPE?** A bare call `name(…)` inside a method body resolves
	// to the sibling method `name` rather than a free function — and the method WINS when a free function of the
	// same name also exists (oracle-verified), which is why the free-call path asks this FIRST. False at file
	// scope, where there is no enclosing type and every call is free.
	//
	// ⭐⭐⭐ **A SIBLING IS ANY METHOD THE ENCLOSING TYPE HAS, AND A TOKEN WALK CANNOT SEE THEM ALL.**
	// `ensureSiblingReceivers` reads ONE declaration's member list, which is the right list only when every
	// method of the type is written in it. An `extension` breaks that in both directions, and each answers
	// `E3004 call to undefined function` for a program whose `self.<name>()` spelling compiles:
	//
	//   • inside an `extension` body the walk starts at the EXTENSION's members, so the CONFORMER's own
	//     methods are invisible — a different declaration, possibly in a different file;
	//   • inside the TYPE's own body the walk sees only what the type wrote, so a method an `extension`
	//     published onto it is invisible the other way round.
	//
	// ⇒ the walk's miss falls through to the whole-program index, which is the only reader that has every
	// declaration under one `<Type>.<method>` key however many declarations contributed them. The walk keeps
	// its PRIORITY: it answers for the declaration the
	// author is looking at, and it is the one that can tell an interface REQUIREMENT (which the index does not file under the conformer at all) from a method.
	//
	// ⚠ **THE PROBE IS ON THE MISS PATH ONLY**, and that is a cost decision rather than a semantic one: this
	// is asked at every bare call in the program, the join `qualifiedMethodName` allocates, and inside a type
	// body the overwhelming majority of bare calls hit the walk. A miss is a call to a free function, which
	// then pays one join and one map probe — linear in call sites, and the answer it buys is the difference
	// between resolving and E3004.
	function isImplicitSelfMethod(name ByteArray) returns bool
		if not self.enclosingType.isType() 'noEnclosingType'
			return false
		end 'noEnclosingType'

		self.ensureSiblingReceivers()

		return self.siblingKindOf(name) != SiblingKind.notASibling
	end 'isImplicitSelfMethod'

	function siblingKindOf(name ByteArray) returns SiblingKind
		return self.signatures.siblingKindFrom(name, enclosingTypeName: self.enclosingTypeNameOrEmpty(), walked: self.walkedSiblingOf(name))
	end 'siblingKindOf'

	function walkedSiblingOf(name ByteArray) returns WalkedSibling
		let takesReceiver = try self.siblingReceiverTakesReceiver(name) otherwise return WalkedSibling.notWalked
		return WalkedSibling.takesReceiver if takesReceiver else WalkedSibling.takesNoReceiver
	end 'walkedSiblingOf'

	// ⭐⭐ **WHICH COMPILER-OWNED ROSTER SERVES MEMBER `name` OF THE ENCLOSING TYPE — the ONE spelling of it.**
	// `parseCall` asks it for an implicit-self call (see its arm for why the roster outranks the declaration) and
	// the fresh-return sweep asks it for the same reason from the other side: a member the roster serves is a
	// synthesized arm, not the declaration a key names. A second spelling would let one door admit a member the
	// other refuses. It resolves nothing, so no receiver is materialized for a name no roster carries.
	//
	// The BYTE RECORD half — `String` and `Character` — is told by the tag their name denotes. The `Array` half
	// is told by the SHAPE that makes a record the compiler's (`declarationIsTheManagedRecord`), never by
	// the name alone: `Array` is not a name the compiler reserves, and a user container of that name declaring
	// anything else has no synthesized roster to win with.
	//
	// `unfoldedTypeIsTheRecord` is the sweep's: it reads a type body before that type's layout is folded, so a
	// type the index does not hold yet may still be the record, and counting it served is a missed claim rather
	// than a wrong one.
	function enclosingRosterServing(name ByteArray, unfoldedTypeIsTheRecord bool) returns EnclosingRoster
		let typeName = try self.enclosingType.typeName() otherwise return EnclosingRoster.none
		let byteRecord = byteRecordTagOfTypeName(typeName)

		if byteRecord != ValueTypeTag.unresolved and self.surfaceMemberNames(byteRecordSurface(byteRecord)).contains(name) 'aByteRecordMember'
			return EnclosingRoster.byteRecord
		end 'aByteRecordMember'

		let mayBeTheRecord = self.signatures.declarationIsTheManagedRecord(typeName) or (unfoldedTypeIsTheRecord and not self.signatures.containsStructInAnyFile(typeName))

		if mayBeTheRecord and self.surfaceMemberNames(MemberSurface.array).contains(name) 'anArrayMember'
			return EnclosingRoster.array
		end 'anArrayMember'

		return EnclosingRoster.none
	end 'enclosingRosterServing'

	// `self`, shaped as the receiver the roster dispatchers take. It carries no immutable name and no
	// borrow subject — `self` is a writable parameter (see `implicitSelfReceiver`) and a bare sibling
	// call names no ONE storage — and the anchor is the callee token, which is what a diagnostic
	// inside the arm points at.
	function implicitSelfRosterReceiver(calleeTok Token, tag ValueTypeTag, nameId TypeNameId) returns MethodReceiver throws SourceParseError
		let value = try self.readReceiverValue(calleeTok)
		return MethodReceiver.create(value, tag: tag, nameId: nameId, anchor: calleeTok, immutableName: EmptySourceText, subjectName: StorageSubject.none, owner: NoParamPositions, selfFieldName: SelfFieldAlias.none)
	end 'implicitSelfRosterReceiver'

	// The receiver a bare call to the sibling `name` carries. An INSTANCE method gets the enclosing `self`
	// prepended at parameter 0 — resolved EXACTLY as an explicit `self.name(…)` resolves it, so the two spellings
	// emit byte-identical calls in every context. A `static` sibling gets none. Two contexts make the self
	// resolution more than a plain scope read:
	//   • inside a CLOSURE, `self` is a CAPTURE — the receiver comes out of the env block, through the very
	//     door `parseSelfPrimary` resolves it through, so `doubled()` and `self.doubled()` still emit the
	//     same call from inside a closure body as they do outside one;
	//   • in a `static` method, a file-scope initializer or a `static let` initializer there is no `self`
	//     at all, so this answers `unavailable` and `parseCallNamed` refuses the call as E3193 before the
	//     arity check, which would count the hidden `self` parameter as the missing argument.
	// The caller (`parseCall`) has already established `name` IS a sibling (`isImplicitSelfMethod`), so the map
	// is built and this `ensureSiblingReceivers` is a memo hit.
	function implicitSelfReceiver(name ByteArray, anchor Token) returns ReceiverArg throws SourceParseError
		self.ensureSiblingReceivers()

		if self.siblingKindOf(name) != SiblingKind.instanceSibling 'staticSibling'
			return ReceiverArg.none
		end 'staticSibling'

		// `self` is a PARAMETER — a borrowed reference to the caller's record — so it is writable and has no
		// blame name, which is exactly what keeps a sibling call inside a mutating method legal.
		// ⚠ DECIDE EXISTENCE WITHOUT THE THROWING RESOLVER. `requireReceiverValue` fails for two structurally
		// different reasons — there is no receiver at all (a static function), and the receiver exists but is
		// only reachable through a NON-IMMEDIATE enclosing frame (the nested-capture refusal, general to
		// every capture). A blanket `otherwise` would catch both, so a sibling call from a doubly-nested
		// closure would be refused as E3193, an instance method with no receiver, instead of the honest
		// "unsupported nested capture".
		if not self.nameBindsOrIsCaptured(SelfParamName) 'noReceiver'
			return ReceiverArg.unavailable
		end 'noReceiver'

		// The anchor IS the callee token here — an implicit-self sibling call writes no receiver, so the
		// only token either half of the call can point at is the name the author wrote.
		return ReceiverArg.value(try self.readReceiverValue(anchor), immutableName: EmptySourceText, anchor: anchor, extent: ReceiverExtent.implicitAt(self.pos))
	end 'implicitSelfReceiver'

	function requireInstanceMethodHasAReceiver(callee ByteArray, anchor Token, firstArgumentMayBeTheReceiver bool) throws SourceParseError
		if firstArgumentMayBeTheReceiver or self.signatures.calleeReceiverOf(callee) != CalleeReceiver.takesReceiver 'hasAReceiverOrNeedsNone'
			return
		end 'hasAReceiverOrNeedsNone'

		match self.signatures.functionDeclaringType(callee) 'declaring'
			method(typeName) then throw instanceMethodCalledWithoutReceiver(String.from(typeName), methodTok: anchor)
			freeFunction or
			undeclared then panic("requireInstanceMethodHasAReceiver: '{String.from(callee)}' takes a receiver, so a type declares it")
		end 'declaring'
	end 'requireInstanceMethodHasAReceiver'

	// Populate `siblingReceivers` (the members of the DECLARATION BEING PARSED, bare name -> takesReceiver)
	// unless it is already built for this type. It is not the whole sibling set — a method declared by another
	// declaration of the same type is reached through the index instead (`isImplicitSelfMethod`) — because a
	// token walk can only read the body it is standing in. LAZY so a type whose methods make no calls — the
	// whole scale corpus — never builds it and allocates nothing (the field stays `unwritten`). A file-local
	// token walk of the type body, so it sees every
	// sibling regardless of declaration order: a forward reference resolves exactly as a backward one, and
	// recursion sees the method itself. It is the ONE source of both "is this a sibling?" (`contains`) and
	// "does it take a receiver?" (the value) FOR THE MEMBERS IT CARRIES, so those two facts cannot drift
	// apart — and the index behind it is asked for
	// both in the same one place (`ProgramSignatures.siblingKindFrom`), for that same reason.
	//
	// ⚠⚠ **AN `enum`/`union` BODY'S MEMBER LIST IS NOT BLOCK STRUCTURE, AND A CASE MAY BE SPELLED WITH A
	// KEYWORD** — the rule `keywordIsANameAt`'s case-list shape applies to the block-extent walk, and the
	// one `opensBlockAt` and `closesBlockAt` apply here through `keywordIsAName`. Without it a case named
	// `end` closes the walk early, so a bare sibling call to a method declared after it reports
	// `E3004 call to undefined function 'inner'`; a case named `while` does the opposite, running PAST the
	// enum's own `end` and adopting a LATER type's `helper` as a sibling. Both are legal programs.
	function ensureSiblingReceivers()
		if not self.enclosingBodyIsWalkable 'noBodyToWalk'
			return
		end 'noBodyToWalk'

		if self.siblingReceiverScanType.names(self.enclosingTypeName()) and self.siblingReceiverScanBody == self.enclosingTypeBodyStart 'memoHit'
			return
		end 'memoHit'

		let map = SiblingReceiverMap.create()
		var depth = 0 as BlockDepth
		var q = self.enclosingTypeBodyStart

		while self.kindAt(q) != TokenKind.eof 'walk'
			// A member method is `function <name>` — a closure is `function(` (no name, and no `end`), and no
			// other construct pairs `function` with a NAME, so this cannot mistake one for a method. It
			// opens the method's own block, which `opensBlockAt` does NOT count (it knows if/while/match, not
			// `function`), so counting it here is the +1 that balances the method's `end`.
			let isMethod = self.functionDeclarationAt(q)

			if isMethod 'method'
				// A method with no `static` modifier takes the hidden `self` receiver — the SAME token-level test
				// the descriptor sweep uses (`functionDeclIsStatic`), so the two scans agree by construction.
				map.upsert(self.tokenAt(q + 1).value, value: not self.functionDeclIsStatic(q))
			end 'method'

			if isMethod or self.opensBlockAt(q) 'opens'
				depth = depth + 1
			end 'opens' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					if depth == 0 'typeEnd'
						break
					end 'typeEnd'

					depth = depth - 1
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'

		// ⭐ **AN EXTENSION BODY'S SIBLINGS ARE ITS INTERFACE'S REQUIREMENTS TOO, and no token walk can find
		// them** — they are declared on the CONFORMER, in another declaration and possibly another file. Added
		// AFTER the walk so an extension method of the same name as a requirement keeps the walk's answer
		// (the extension is what this body is, and it is the declaration the author is looking at). Every
		// requirement takes a receiver: an interface method's `self` is implicit and never declared, and a
		// `static` requirement is not reachable through `self` at all — so a `static` one is skipped rather
		// than filed as receiver-less, which would resolve `make()` to a call with no instance to make it on.
		// The transitive list, so a requirement inherited through `extends` is a sibling exactly as an own one
		// is (`requirementSlotsOf`, memoized, and the SAME list a witness dispatch resolves against).
		if let interfaceName = try self.extensionInterfaceName.declaredName() 'inAnExtensionBody'
			for slot in self.requirementSlotsOf(interfaceName) 'eachRequirement'
				if slot.method.isStatic 'staticRequirement'
					continue
				end 'staticRequirement'

				if map.contains(slot.method.name) 'shadowedByAnExtensionMethod'
					continue
				end 'shadowedByAnExtensionMethod'

				map.upsert(slot.method.name, value: true)
			end 'eachRequirement'
		end 'inAnExtensionBody'

		self.siblingReceivers = SiblingReceiverTable.entries(map)
		self.siblingReceiverScanType = self.enclosingType.clone()
		self.siblingReceiverScanBody = self.enclosingTypeBodyStart
	end 'ensureSiblingReceivers'

	// Parse a call expression `callee(args…)` and return the ValueId its result defines. The
	// callee name is kept as identifier TEXT (a `ByteArray` slice per the MaxonOp value/name
	// split); the arguments are parsed in source order with their `name:` labels. Call-site
	// diagnostics anchor on the callee-through-`)` span.
	//
	// The call op lands in `currentBlock` AFTER the arguments are parsed, because an argument
	// can short-circuit (`f(a or b)`) and move it. Emitting into the block the call STARTED in
	// would put the call on a path its own arguments do not reach.
	// `resultUsed` names the ONE thing the two call positions differ by, and the grammar has exactly
	// two of them: a bare-call STATEMENT (`greet()` on a line of its own — the result is evaluated
	// for effect and discarded) and a call inside an EXPRESSION (`let x = f()`, `f() + 1`,
	// `if ready()`, `g(f())` — the result IS the expression). The parser is therefore the only tier
	// that can tell a legal void call from an illegal use of nothing, which is why the check lives
	// here and not in a later pass.
	function parseCall(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		let calleeTok = self.current()

		// A bare call to a sibling method of the enclosing type resolves to that method under its
		// qualified name, prepending `self` for an instance method. The method takes precedence over a
		// same-named free function; a name that is NOT a sibling stays the free/direct call below (E3004 if it
		// names nothing declared).
		// ⭐⭐⭐ **A BARE SIBLING CALL INSIDE A BYTE RECORD TAKES THE ROSTER, EXACTLY AS `s.<member>()` DOES.**
		// The roster-wins order `dispatchMethodOnReceiver` states is for the EXPLICIT
		// spelling and must cover the implicit-self one too — else inside `type String` a bare
		// `addressableBytes()` resolves to the corpus module function while `s.addressableBytes()` reaches the
		// arm that mints `__str_bytes_view` **and marks the result a buffer surface**.
		//
		// ⚠ **THE MARK IS THE WHOLE POINT, AND ITS ABSENCE IS A WRONG ANSWER RATHER THAN A SLOWER ONE.**
		// `String.replace` writes `let selfBytes = addressableBytes()` and then `selfBytes.slice(pos, matchPos)`;
		// unmarked, `dispatchArrayMethod` read `selfBytes` as an `Array`, and the `Array`-surface `slice` — which
		// DEMANDED the `endIndex:` label the buffer surface makes optional — refused the corpus inside its own
		// file: `E2010 Expected ':' but got ')'` at `String.maxon:556`, 1002 of the 1158 failures listing the
		// module produced. ⚠ The mark decides the SURFACE (`slice` is buffer-only, so an unmarked
		// value is refused outright rather than mis-labelled).
		//
		// ⇒ Asked BEFORE the implicit-self arm and gated to the roster, so it can only ever catch a member the
		// arm below would have sent to a corpus body that duplicates one. A member the roster does NOT serve
		// falls through and reaches the corpus exactly as it should — the same split
		// `memberBelongsToTheCorpus` makes one door over, from the other side.
		//
		// ⚠ **THE RECEIVER TEST IS THIS DOOR'S AND NOT THE ROSTER'S.** A `static` method of `type String` writing
		// a bare `byteLength()` has no instance to dispatch on, and the answer there is the arity error the
		// ordinary resolution words, not a dispatch on nothing.
		let roster = self.enclosingRosterServing(calleeTok.value, unfoldedTypeIsTheRecord: false)
		let rosterTakesTheCall = roster != EnclosingRoster.none and self.nameBindsOrIsCaptured(SelfParamName)

		if rosterTakesTheCall and roster == EnclosingRoster.byteRecord 'byteRecordRosterMember'
			let recv = try self.implicitSelfRosterReceiver(calleeTok, tag: byteRecordTagOfTypeName(self.enclosingTypeName()), nameId: UnnamedTypeId)

			if recv.tag == ValueTypeTag.character 'aCharacter'
				return try self.dispatchCharacterMethod(recv)
			end 'aCharacter'

			return try self.dispatchStringMethod(func, recv: recv)
		end 'byteRecordRosterMember'

		// ⭐⭐⭐ **AND THE SAME RULE FOR AN `Array` WHOSE RECORD THIS COMPILER OWNS.** Everything the
		// header above argues for `String` is true here one genericity up, and it was measured in two places
		// at once. Inside `type Array`'s own body the bare spelling reached the DECLARATION while
		// `self.get(i)` reached the synthesized arm, so one member meant two different bodies depending on
		// how it was written. Inside an `extension Array` body it reached NOTHING — the sibling walk sees
		// only the extension's own methods, so `stdlib/Array.maxon`'s `contains(sequence)` was
		// `E3004 call to undefined function 'get'`, a diagnostic no reader ever saw: the untyped result then
		// raised a THROWN `E3005` about the `!=` two lines later, and a thrown `SourceParseError` discards the
		// file's recorded diagnostics (`abortedParseArtifact`). The visible complaint named the comparison.
		if rosterTakesTheCall 'arrayRosterMember'
			let recv = try self.implicitSelfRosterReceiver(calleeTok, tag: ValueTypeTag.genericInstance, nameId: self.signatures.ownRecordSelfInstance(self.enclosingTypeName()) as TypeNameId)
			return try self.dispatchArrayRosterMethod(func, recv: recv, resultUsed: resultUsed)
		end 'arrayRosterMember'

		// `resolvedTypeQualifier`: the author wrote the bare member and NO qualifier at all — the head is the
		// enclosing declaration's name, which under a stdlib/user shadow is this compile's own mint.
		if self.isImplicitSelfMethod(calleeTok.value) 'implicitSelfMethod'
			let receiver = try self.implicitSelfReceiver(calleeTok.value, anchor: calleeTok)

			let takesReceiver = match receiver 'receiverKind'
				none gives false
				unavailable or
				value gives true
			end 'receiverKind'

			let registered = qualifiedMethodName(self.enclosingTypeName(), methodName: calleeTok.value)

			return try self.parseCallNamed(func, callee: registered, anchor: calleeTok, receiver: receiver, resultUsed: resultUsed, constructorInstance: ConstructorInstance.none, mint: CalleeMint.resolvedTypeQualifier if takesReceiver else CalleeMint.resolvedStaticTypeQualifier)
		end 'implicitSelfMethod'

		// A free call has no receiver and constructs no generic instance: there is no value to its left, and
		// a generic type is instantiated only through a `Type.method` qualified call.
		//
		// ⚠ A contested name is resolved HERE and not inside `parseCallNamed`, because that funnel also carries
		// sibling, static, primitive-static and receiver calls, whose callees are not bare names.
		return try self.parseCallNamed(func, callee: self.signatures.nameABareCallBinds(calleeTok.value, readerFilePath: self.job.path), anchor: calleeTok, receiver: ReceiverArg.none, resultUsed: resultUsed, constructorInstance: ConstructorInstance.none, mint: CalleeMint.notMinted)
	end 'parseCall'

	// `spawnReadLine(cmd)` — the IOCP overlapped-read PROBE: `__gt_io_read` spawns the
	// command with stdout → a fresh overlapped pipe, issues a YIELDING overlapped read and returns the byte
	// count. NON-throwing (a plain integer, not the dual-register error ABI), so a bare call needs no `try`.
	//
	// The seven streaming subprocess builtins. Each is recognized by name after its arguments
	// are parsed, exactly like `spawnReadLine`, and routes to a `__gt_subp_*` runtime entry.
	// `subpSpawn(cmd)` — `__gt_subp_spawn` creates three pipes, spawns the child and returns a
	// non-negative handle (or -1), which the six `subp*` handle doors take as their argument.
	function emitProcessBuiltin(builtin ProcessBuiltin, args ValueIdArray, resultUsed bool, calleeTok Token) returns ValueId throws SourceParseError
		match builtin 'builtin'
			spawnReadLine then return try self.emitCommandLineRuntimeCall(args, runtimeName: IoReadName, builtinName: SpawnReadLineBuiltinName, arity: SpawnReadLineArity, calleeTok: calleeTok)
			subpSpawn then return try self.emitCommandLineRuntimeCall(args, runtimeName: SubpSpawnName, builtinName: SubpSpawnBuiltinName, arity: SubpSpawnArity, calleeTok: calleeTok)
			subpReadLine then return try self.emitSubpReadLine(args, runtimeName: SubpReadLineName, builtinName: SubpReadLineBuiltinName, calleeTok: calleeTok)
			subpReadErrLine then return try self.emitSubpReadLine(args, runtimeName: SubpReadErrLineName, builtinName: SubpReadErrLineBuiltinName, calleeTok: calleeTok)
			subpWriteLine then return try self.emitSubpWriteLine(args, calleeTok: calleeTok)
			subpCloseStdin then return try self.emitSubpHandleOp(args, runtimeName: SubpCloseStdinName, builtinName: SubpCloseStdinBuiltinName, resultTag: ValueTypeTag.void, resultUsed: resultUsed, calleeTok: calleeTok)
			subpWait then return try self.emitSubpHandleOp(args, runtimeName: SubpWaitName, builtinName: SubpWaitBuiltinName, resultTag: ValueTypeTag.integer, resultUsed: resultUsed, calleeTok: calleeTok)
			subpRelease then return try self.emitSubpHandleOp(args, runtimeName: SubpReleaseName, builtinName: SubpReleaseBuiltinName, resultTag: ValueTypeTag.void, resultUsed: resultUsed, calleeTok: calleeTok)
		end 'builtin'
	end 'emitProcessBuiltin'

	// The call parser proper, taking the callee's NAME rather than reading it — because two call
	// syntaxes produce one call, and only the name differs. `greet()` is its own token's text;
	// `Point.create(…)` is `Point.create`, mangled by `parseQualifiedCall` from two tokens plus a
	// dot. Everything after the name — the argument grammar, the `name:` label rules, the builtin
	// check, the result typing, the emit — is identical, so it is written once.
	//
	// The CURSOR is on the callee's final name token (`greet`, `create`) with `(` behind it; the
	// caller has already consumed any qualification. `anchor` is the token diagnostics point at, and it is
	// the callee's FINAL NAME token for every spelling: `greet` for a free call, `bump` for `bx.bump(…)`,
	// and `create` for `Box.create(…)` rather than the `Box` that qualifies it.
	//
	// ⚠ Both spellings of a call anchor at the METHOD token — `parseMethodCall` hands the method token
	// over, and the qualified door must agree or the two spellings disagree about where the call IS.
	// `testing-assertions`' `error.float-has-no-equal` (E3009 at the `equal` of `Expect.equal`) and
	// `error.forgotten-try` (E3057 at the same token) pin it. Both read the CALL OP's range, and this
	// is where that range starts.
	//
	// `spelling` is threaded straight through to `emitCall`'s reserved-space door and read nowhere else:
	// every caller but ONE hands it the author's own bytes, and the exception is the primitive-static mint
	// (`parseQualifiedCall`). See `CalleeMint`.
	function parseCallNamed(func IrFunction, callee ByteArray, anchor Token, receiver ReceiverArg, resultUsed bool, constructorInstance ConstructorInstance, mint CalleeMint, inferInstanceOf FactoryInference = FactoryInference.none, serviceSite ServiceSpawnSite = sharedNotAServiceSpawn) returns ValueId throws SourceParseError
		// The callee's final name token may be a KEYWORD — `FilePath.from(path)`, `c.to()`, `from(41)`.
		// The `callee` bytes the caller passed were read off this very token, so refusing it here would
		// refuse every call to a name the declaration accepts.
		try self.requireCalleeIsNotRawSurface(callee, anchor: anchor)
		try self.consumeNameToken(NamePosition.declaration)
		try self.consume(TokenKind.leftParen)

		// ⭐ **THE TWO UCD TABLE LOADS ARE PARSED, NOT EMITTED FROM PARSED ARGUMENTS** — their first
		// argument is a compile-time LABEL that selects a linked blob, so it must be read off its token
		// rather than resolved as a value. Taken here, before `parseCallArgs`, because that is the only
		// point at which the label's token is still the cursor. See `parseUcdTableLoad`; the label RULE it
		// enforces on the second argument is `consumeArgLabel`'s, not a second copy.
		//
		// A receiver cannot have been prepended: `__Builtins` is a compiler TYPE, so both these callees
		// arrive through `parseQualifiedCall` with `ReceiverArg.none`.
		//
		// ⚠ Each arm states WHICH TABLE and nothing else: the label it must be given, the leaf it lowers to
		// and its second parameter's name are all derived from that one value (`ucdTableStemOf` and its two
		// siblings). Passing the four separately let a call site pair an intrinsic with the other table's
		// stem — a load of the wrong blob at the wrong stride, out of a build with no error in it.
		if callee.equals(BuiltinsUcdByteAtName) 'ucdByteAt'
			return try self.parseUcdTableLoad(func, callee: callee, load: UcdTableStride.byteIndexed, anchor: anchor)
		end 'ucdByteAt'

		if callee.equals(BuiltinsUcdI64AtName) 'ucdI64At'
			return try self.parseUcdTableLoad(func, callee: callee, load: UcdTableStride.packedEntry, anchor: anchor)
		end 'ucdI64At'

		// ⭐ **THE THIRD INTRINSIC WHOSE ARGUMENT IS A NAME RATHER THAN A VALUE**, taken here for the two
		// above's reason and one of its own: the name is not merely known at compile time, it must never
		// become a value, because a `stringLiteral` op would mint the `.rdata` String record and the runtime
		// allocation the zero-alloc trace tier exists to avoid. See `DebugStreamNameIdCallee`.
		if callee.equals(DebugStreamNameIdCallee) 'debugStreamNameId'
			return try self.parseDebugStreamNameId(func, anchor: anchor)
		end 'debugStreamNameId'

		let args = ValueIdArray.create(0)
		let argLabels = NameRoster.create(0)
		let argRanges = SourceRangeArray.create(0)
		let argImmutableNames = NameRoster.create(0)

		// Read by the SEND alone (`emitServiceSend`), which is the one caller whose arguments never reach
		// `SemanticCheck.checkArgTypes` and must therefore be typed here, against a token.
		let argAnchors = TokenIndexArray.create(0)

		// ⭐ **THE RECEIVER GOES IN FIRST, AS AN UNLABELLED ARGUMENT, AND THEN IT IS JUST AN
		// ARGUMENT.** Pushed BEFORE the source's own arguments are parsed, so it occupies index 0
		// and everything downstream slots it there without being told: `slotCallArgs` puts an
		// unlabelled argument at index `i` into parameter position `i`, and parameter 0 is
		// `SelfParamName`. The two ends of the convention never speak to each other.
		//
		// It does NOT disturb the label rules. `parseCallArgs` counts the SOURCE's arguments from
		// zero on its own counter, so `acc.add(10)`'s `10` is still "the first argument", and whether it
		// may be labelled is asked of the first parameter after the receiver — the receiver is not
		// something the user wrote and must not shift what they did.
		//
		// ⚠ **IT DOES DISTURB THE ARITY COUNTS, AND THIS IS THE ONE PLACE THAT CAN SAY SO.** An E3036
		// against a call whose receiver is prepended here counts the receiver on BOTH sides, so both
		// numbers are one higher than anything the source wrote: `a.add()` — zero arguments written —
		// reports *"'Adder.add' expects 2 argument(s) but 1 were provided"*. The count is internally
		// consistent and the program is correctly refused; the numbers are just not the user's. A call
		// with no receiver at all is refused as E3193 before it reaches this count
		// (`requireInstanceMethodHasAReceiver`).
		//
		// Its span is the receiver EXPRESSION's OWN anchor (`acc`, or the `self` keyword), which is the
		// token a diagnostic about the receiver has to point at — and it is the receiver's rather than this
		// function's `anchor` because a method call anchors the CALL at the method name. See `ReceiverArg`.
		match receiver 'prependReceiver'
			none or
			unavailable then break
			value(id, immutableName, receiverTok, _) then pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, value: id, label: EmptySourceText, range: SourceRange.ofToken(receiverTok), immutableName: immutableName, anchorIndex: self.pos)
		end 'prependReceiver'

		// ⭐ THE ONE DOOR WHERE A BUILTIN — BARE OR `__Builtins.`-QUALIFIED — CAN ARRIVE, so it is the one
		// door that asks which label regime the callee takes. The question is asked HERE, from the name
		// alone, because the builtin check below runs only AFTER the arguments are parsed — and the label
		// rule fires during that parse. See `argLabelRuleForCallee`.
		// ⭐⭐ **A BARE-NAME BUILTIN IS THE COMPILER'S ONLY WHILE NO DECLARATION THIS FILE CAN SEE, A GENERIC
		// TEMPLATE'S INCLUDED, HAS THAT NAME.** Asked here, once, because both halves below read it and they
		// must not disagree: the LABEL RULE fires inside `parseCallArgs`, and the EMIT is chosen after the
		// arguments are parsed. `bareNameKindFrom` is the classifier an initializer's call is judged by too.
		let shadowedByADeclaration = self.signatures.bareNameKindFrom(callee, readerFilePath: self.job.path).namesAVisibleFunction()

		let labelRule = argLabelRuleForCallee(callee, shadowedByADeclaration: shadowedByADeclaration)
		let receiverArgs = args.count()
		let places = try self.parseCallArgs(func, target: CallArgTarget.movedInto(callee) if serviceSite.isASpawn() else CallArgTarget.callee(callee), anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, rule: labelRule, constructorInstance: constructorInstance)

		let rparenTok = try self.consume(TokenKind.rightParen)
		let resolvedCallee = try self.genericInstanceCallee(callee, anchor: anchor, args: args, argLabels: argLabels, mint: mint)

		if labelRule == ArgLabelRule.firstNamedIfDefaulted 'firstLabelNeedsADefault'
			try self.requireFirstArgLabelHasDefault(resolvedCallee, firstParam: receiverArgs as ParamCount, argLabels: argLabels, argRanges: argRanges, receiverArgs: receiverArgs)
		end 'firstLabelNeedsADefault'

		let opensAnIsolatedValue = try self.checkCallCapabilities(func, callee: resolvedCallee, args: args, argAnchors: argAnchors, argLabels: argLabels, receiver: receiver, anchor: anchor, spawning: CallSpawning.direct)
		let instantiated = try self.spawnFactoryConstructorInstance(constructorInstance, inferInstanceOf: inferInstanceOf, callee: callee, args: args, argLabels: argLabels, anchor: anchor, serviceSite: serviceSite)
		let storedSlots = self.storedSlotCandidates(func, callee: resolvedCallee, args: args, argAnchors: argAnchors, argLabels: argLabels, receiver: receiver, constructorInstance: instantiated)

		for stored in storedSlots 'eachStoredSlot'
			if stored.slot == ParamCapability.immutable 'anImmutableSlot'
				self.noteStoredIntoImmutableSlot(stored.argValue)
			end 'anImmutableSlot'
		end 'eachStoredSlot'

		match receiver 'receiverless'
			value then break
			none then try self.requireInstanceMethodHasAReceiver(resolvedCallee, anchor: anchor, firstArgumentMayBeTheReceiver: not args.isEmpty())
			unavailable then try self.requireInstanceMethodHasAReceiver(resolvedCallee, anchor: anchor, firstArgumentMayBeTheReceiver: false)
		end 'receiverless'

		// ⭐⭐ **THE BARE-NAME BUILTINS, AND THEY ARE ONLY REACHED WHEN NO VISIBLE DECLARATION HAS THE
		// NAME.** A bare builtin has no declaration, so nothing downstream could ever notice that a user's
		// `function round` was never linked: the call emitted a machine instruction and the declaration sat
		// unreachable, with no diagnostic anywhere. The declaration wins, and the whole run is gated on that
		// one question rather than each arm asking it — nine copies of one rule is how an arm added later
		// would keep the old answer. A QUALIFIED callee reaches none of these anyway (`Point.trunc` is not
		// `trunc`), so a static method of the name was always linked.
		if not shadowedByADeclaration 'noFileOwnsThisName'
			// A BUILTIN is recognized by name, AFTER its arguments are parsed — so it takes the
			// ordinary call syntax and the ordinary argument rules, and only the emit differs. The
			// check sits here rather than in `emitCall` because a builtin emits no `MaxonOp.call` at
			// all: it has no signature to slot arguments against and no symbol to link.
			//
			// ⭐⭐ **THE MATH INTRINSICS ENTER THROUGH THEIR ROSTER, NOT THROUGH SEVEN `equals` OF THEIR OWN.**
			// `calleeTakesPositionalArgsOnly` is the ONE list of that family, and gating the emit on it is what
			// makes the list and the emit impossible to disagree — see `emitPositionalMathBuiltin` for the two
			// directions this closes and for the `max` tick that would otherwise have paid for it.
			if calleeTakesPositionalArgsOnly(callee) 'mathBuiltin'
				// ⭐ **A DISCARDED MATH INTRINSIC IS DEAD CODE THE PARSER CAN PROVE, so it earns E3064 here rather
				// than through the whole-program effect summary.** Every member of this roster IS a machine
				// instruction over its arguments — no memory is read, none is written, nothing is called — so a
				// statement that takes none of the answer has no other reason to run, and no call graph has to be
				// walked to say so. The site still travels as a `PendingDiscardedResult` because the DIAGNOSTIC is
				// `SemanticCheck.checkDiscardedResults`'s and must stay one sentence in one place; what the site
				// carries is that its purity is already settled. (A DECLARED callee discarded the same way is the
				// statement doors' site, and the summary answers for it.)
				if not resultUsed 'nobodyTookTheAnswer'
					self.artifact.recordDiscardedResult(PendingDiscardedResult.createForIntrinsic(callee, line: anchor.line, column: anchor.column, filePath: self.job.path))
				end 'nobodyTookTheAnswer'

				return try self.emitPositionalMathBuiltin(args, callee: callee, calleeTok: anchor)
			end 'mathBuiltin'

			match processBuiltinNamed(callee) 'processBuiltin'
				found(builtin) then return try self.emitProcessBuiltin(builtin, args: args, resultUsed: resultUsed, calleeTok: anchor)
				absent then break
			end 'processBuiltin'
		end 'noFileOwnsThisName'

		// ⚠ **THE MATH INTRINSICS ARE DISPATCHED FROM THE ONE ROSTER READ AT THE TOP OF THIS CHAIN**
		// (`calleeTakesPositionalArgsOnly` ⇒ `emitPositionalMathBuiltin`), never from a run of
		// `if callee.equals(…)` rows here — which is what makes the label rule and the emit unable to
		// disagree, and what keeps a prose copy of the roster from going stale against it.
		//
		// ⚠⚠ A `union MathIntrinsic{notAnIntrinsic, op(MaxonUnaryOp)}` returned by a name→op resolver
		// would read better but MEASURES WORSE: **a payload-FREE
		// union case still heap-allocates**, so returning `notAnIntrinsic` costs ONE allocation per
		// PARSED CALL — +85/+153/+289/+561/+1105/+2193 allocations across the six scale-test ladder steps, a
		// linear constant factor on the hottest path in the parser, for a call that is not an
		// intrinsic 99.99% of the time. A plain `equals` allocates nothing and keeps `scale-test`
		// at bit-for-bit parity with main. (The flat-union rule in docs/internals/names-and-values.md is about NESTING
		// costing a box per level; this is the same accounting one level down.)

		// ⭐ **THE `__Raw.*` FLOOR (see `RawIntrinsics`), AND IT IS GATED ON THE TIER AS WELL AS THE PREFIX.**
		// A call from outside `runtime/` is left to fall through to `emitCall`'s reserved-callee door, which
		// refuses it by name (E3152) — so the privilege is stated at one door and the refusal at one other,
		// never as two copies of one rule. An UNLISTED member falls through the same way from either side and
		// earns the ordinary positioned E3004 that names it.
		if self.job.isRuntimeSource and isRawIntrinsicCallee(callee) and rawIntrinsicIsListed(callee) 'rawIntrinsic'
			return try self.emitRawIntrinsic(func, intrinsic: rawIntrinsicNamed(callee), args: args, calleeTok: anchor, resultUsed: resultUsed)
		end 'rawIntrinsic'

		// The `__Builtins.*` intrinsic table (see `BuiltinsQualifierPrefix`). Gated behind ONE prefix compare
		// so a call to anything else pays two bytes and no allocation; an unrecognized member falls through to
		// `emitCall`'s reserved-callee rejection, which is this table's "unknown intrinsic" arm.
		if isBuiltinsIntrinsicCallee(callee) 'builtinsIntrinsic'
			if callee.equals(BuiltinsCurrentTimeNanosName) 'currentTimeNanos'
				return try self.emitClockIntrinsicCall(args, name: callee, runtimeName: GtNowNsName, resultAlias: InstantNanosAliasName, calleeTok: anchor)
			end 'currentTimeNanos'

			if callee.equals(BuiltinsCurrentTimeMsName) 'currentTimeMs'
				return try self.emitMonotonicMs(func, args: args, calleeTok: anchor)
			end 'currentTimeMs'

			if callee.equals(BuiltinsCurrentUnixTimeSecondsName) 'currentUnixTimeSeconds'
				return try self.emitClockIntrinsicCall(args, name: callee, runtimeName: WallClockNowUnixSecondsName, resultAlias: UnixSecondsAliasName, calleeTok: anchor)
			end 'currentUnixTimeSeconds'

			if callee.equals(BuiltinsCurrentUnixTimeNanosName) 'currentUnixTimeNanos'
				return try self.emitClockIntrinsicCall(args, name: callee, runtimeName: WallClockNowUnixNanosName, resultAlias: UnixNanosAliasName, calleeTok: anchor)
			end 'currentUnixTimeNanos'

			// ⭐ **THE ONLY SPELLING OF `sleep` THE PARSER RECOGNIZES — STDLIB'S OWN FLOOR.** A source
			// `sleep(ms)` is an ordinary call to `stdlib/Sleep.maxon`'s declaration, which the loader
			// brings into every compile and whose one-line body is exactly this intrinsic; there is no
			// bare-name `sleep` builtin and there must never be a second one, or a call and a declaration
			// of the same name would reach the scheduler by two routes that could come to disagree.
			if callee.equals(BuiltinsSleepName) 'sleep'
				return try self.emitSleep(args, calleeTok: anchor, resultUsed: resultUsed)
			end 'sleep'

			// `Scheduler.yield()`'s floor, on the same terms as `sleep` above: the surface is
			// `stdlib/Scheduler.maxon`'s declaration and this is the only spelling the parser knows.
			if callee.equals(BuiltinsYieldName) 'yield'
				return try self.emitVoidZeroArgIntrinsic(args, builtinName: BuiltinsYieldName, runtimeName: GtReschedName, arity: YieldIntrinsicArity, calleeTok: anchor, resultUsed: resultUsed)
			end 'yield'

			// ⭐ **THE CPU-PARALLEL CHECKPOINT — `yield`'s CALL CONTRACT AND THE OPPOSITE RUNTIME.** It marks
			// a hand-written CPU-bound function as a deliberate `async` target (E3073) and hands the
			// processor to nobody; `__parallel_boundary`'s body is a void return. See
			// `BuiltinsParallelBoundaryName` and the runtime name it lowers to beside it.
			if callee.equals(BuiltinsParallelBoundaryName) 'parallelBoundary'
				return try self.emitVoidZeroArgIntrinsic(args, builtinName: BuiltinsParallelBoundaryName, runtimeName: ParallelBoundaryName, arity: ParallelBoundaryArity, calleeTok: anchor, resultUsed: resultUsed)
			end 'parallelBoundary'

			// ⭐ **THE DELIBERATE FAULT — the checkpoint's CALL CONTRACT and the opposite outcome.** It takes
			// nothing, answers nothing, and does not return: the store in `maxon_force_segfault` traps. See
			// `BuiltinsForceSegfaultName`.
			if callee.equals(BuiltinsForceSegfaultName) 'forceSegfault'
				return try self.emitVoidZeroArgIntrinsic(args, builtinName: BuiltinsForceSegfaultName, runtimeName: ForceSegfaultName, arity: ForceSegfaultArity, calleeTok: anchor, resultUsed: resultUsed)
			end 'forceSegfault'

			// ⭐ **THE THIRD ARM THAT HANDS OVER THE PROCESSOR, and the one with no declaration above it.**
			// `sleep` and `yield` are stdlib's floor; this one is the whole surface, because
			// `stdlib/Subprocess.maxon` reaches a child by a different mechanism entirely (see
			// `BuiltinsRunProcessName`).
			// `__gt_process_run` spawns the child with CreateProcessW, parks the GT on the process handle,
			// and — once the netpoll observes the child exit — resumes and returns its scalar exit code. The
			// result is an INTEGER, so unlike `sleep`'s void it is usable in value position and needs no
			// `resultUsed` gate.
			if callee.equals(BuiltinsRunProcessName) 'runProcess'
				return try self.emitCommandLineRuntimeCall(args, runtimeName: GtProcessRunName, builtinName: BuiltinsRunProcessName, arity: RunProcessArity, calleeTok: anchor)
			end 'runProcess'

			// ⭐ **THE SCHEDULER'S ONE READ-ONLY QUESTION**, beside the two arms above that hand it the
			// processor. It drives nothing and retires nothing (see `GtRuntime.GtIsCompleteName`), so unlike
			// `await` it is an ordinary value-producing call with no promise bookkeeping: the argument is a
			// machine word, and the result is the `int` `0`/`1` the runtime entry answers.
			if callee.equals(BuiltinsGtIsCompleteName) 'gtIsComplete'
				try requireBuiltinArity(args, builtinName: callee, arity: GtIsCompleteArity, calleeTok: anchor)

				let gt = try args.get(0) otherwise panic("gtIsComplete: args.count() == GtIsCompleteArity just checked but get(0) failed")
				try self.requireIntrinsicMachineWordArg(gt, callee: callee, calleeTok: anchor)

				return self.emitLibraryAliasedRuntimeCall(GtIsCompleteName, args: argsOf(gt), alias: FullRangeIntAliasName, range: SourceRange.ofToken(anchor))
			end 'gtIsComplete'

			// ⭐ **THE SCHEDULER'S FOURTH ARM THAT HANDS OVER THE PROCESSOR, and the only one that asks a
			// question while it does.** `sleep`, `yield` and `runProcess` park and come back with nothing to
			// say; this drives until ANY of K promises has completed and answers WHICH. See
			// `BuiltinsAwaitAnyName`; the argument rule is `emitAwaitAny`'s, because the element TYPE is what
			// makes reading a slot as a green-thread handle sound.
			if callee.equals(BuiltinsAwaitAnyName) 'awaitAny'
				return try self.emitAwaitAny(args, calleeTok: anchor)
			end 'awaitAny'

			if callee.equals(BuiltinsCommandLineCountName) 'commandLineCount'
				return try self.emitZeroArgIntrinsic(args, builtinName: BuiltinsCommandLineCountName, runtimeName: CommandLineCountName, arity: CommandLineCountArity, resultTag: ValueTypeTag.integer, resultAlias: CountAliasName, calleeTok: anchor)
			end 'commandLineCount'

			// ⭐ The result is an OWNED `__ManagedMemory` — the `Array with Byte` instance `String.init` reads,
			// marked as a BUFFER SURFACE so its members resolve there. `emitOwnedManagedMemoryResult` is what
			// carries all three of those facts at once; `__ManagedDirectory.currentPath`/`filename` are its
			// other two producers, and stating them a fourth time here is exactly what it exists to prevent.
			if callee.equals(BuiltinsCommandLineArgName) 'commandLineArg'
				try requireBuiltinArity(args, builtinName: callee, arity: CommandLineArgArity, calleeTok: anchor)

				let index = try args.get(0) otherwise panic("commandLineArg: args.count() == CommandLineArgArity just checked but get(0) failed")

				// ⚠ `tagIsIntegral`, NOT `tagIsInteger`, and the narrow spelling here is a MEASURED FALSE REFUSAL.
				// A value whose static type is a RANGED ALIAS carries the `named` tag
				// until TypeResolution collapses it, so the narrow test refused every argument spelled with one:
				// `take(i ArgIndex)` calling `__Builtins.commandLineArg(i)` was
				// `E3005 '__Builtins.commandLineArg' requires an argument of type int, but its argument is int` — a refusal naming
				// one type twice — on a program the BOOTSTRAP compiles and runs (MEASURED both ways). It is the
				// same fact `parseBuiltinIntegerArg`'s header measured at the six signature-checked builtin doors
				// and the same one the `readStdin` arm below asks; a third spelling of one question is how a
				// door comes to disagree with its neighbours.
				if not tagIsIntegral(self.numberTagOf(index)) 'notAnIndex'
					throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueKindWord(index), line: anchor.line, column: anchor.column)
				end 'notAnIndex'

				return self.emitOwnedManagedMemoryResult(CommandLineArgName, args: argsOf(index), range: SourceRange.ofToken(anchor))
			end 'commandLineArg'

			// ⭐ Both answer an OWNED `__ManagedMemory` — `emitOwnedManagedMemoryResult` again, which is
			// what carries the instance type, the owned-temp enrolment and the BUFFER SURFACE mark at once.
			// `stdlib/Console.maxon` reads `mm.length()` off the first and `stdlib/Process.maxon` hands the
			// second to `String.init`, and both of those resolve through that surface.
			if callee.equals(BuiltinsReadStdinName) 'readStdin'
				try requireBuiltinArity(args, builtinName: callee, arity: ReadStdinArity, calleeTok: anchor)

				let maxBytes = try args.get(0) otherwise panic("readStdin: args.count() == ReadStdinArity just checked but get(0) failed")

				// ⚠ `tagIsIntegral`, NOT `tagIsInteger`. A value whose static type is a RANGED ALIAS carries the
				// `named` tag until TypeResolution collapses it, so the narrow test refuses every argument
				// spelled with one — the false reject `parseBuiltinIntegerArg`'s header MEASURED
				// (`E3005 … expected 'int', got 'int'`, a refusal that names one type twice). A byte budget is
				// exactly the sort of value a corpus spells with an alias, so the wide predicate is the correct
				// one here rather than the lenient one.
				if not tagIsIntegral(self.numberTagOf(maxBytes)) 'notAByteCount'
					throw SourceParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueKindWord(maxBytes), line: anchor.line, column: anchor.column)
				end 'notAByteCount'

				return self.emitOwnedManagedMemoryResult(ConsoleReadStdinName, args: argsOf(maxBytes), range: SourceRange.ofToken(anchor))
			end 'readStdin'

			if callee.equals(BuiltinsExecutablePathName) 'executablePath'
				return try self.emitZeroArgBufferIntrinsic(args, builtinName: callee, runtimeName: ProcessExecutablePathName, arity: ExecutablePathArity, calleeTok: anchor)
			end 'executablePath'

			if callee.equals(BuiltinsProcessNamespaceName) 'processNamespace'
				return try self.emitZeroArgBufferIntrinsic(args, builtinName: callee, runtimeName: ProcessNamespaceName, arity: ProcessNamespaceArity, calleeTok: anchor)
			end 'processNamespace'

			if callee.equals(BuiltinsFillRandomName) 'fillRandom'
				try requireBuiltinArity(args, builtinName: callee, arity: FillRandomArity, calleeTok: anchor)
				let buffer = try args.get(0) otherwise panic("fillRandom: args.count() == FillRandomArity just checked but get(0) failed")
				try self.requireManagedMemoryValue(buffer, paramName: ManagedFileManagedParamName, anchor: anchor)
				try self.requireRawByteFillFitsItsElement(self.valueInstanceId(buffer), methodTok: anchor)
				self.noteWrittenArgument(func, args: args, argImmutableNames: argImmutableNames, argAnchors: argAnchors, calleeTok: anchor)
				return self.emitLibraryAliasedRuntimeCall(RandomFillName, args: argsOf(buffer), alias: FullRangeIntAliasName, range: SourceRange.ofToken(anchor))
			end 'fillRandom'

			if callee.equals(BuiltinsTrustStoreOpenName) 'trustStoreOpen'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: TrustStoreOpenName, arity: TrustStoreOpenArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor)
			end 'trustStoreOpen'

			if callee.equals(BuiltinsTrustStoreNextName) 'trustStoreNext'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: TrustStoreNextName, arity: TrustStoreCursorArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor)
			end 'trustStoreNext'

			if callee.equals(BuiltinsTrustStoreVerdictName) 'trustStoreVerdict'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: TrustStoreVerdictName, arity: TrustStoreCursorArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor)
			end 'trustStoreVerdict'

			if callee.equals(BuiltinsTrustStoreCertificateName) 'trustStoreCertificate'
				return try self.emitSubprocessManagedResult(args, callee: callee, runtimeName: TrustStoreCertificateName, arity: TrustStoreCursorArity, shape: IntrinsicArgShape.allMachineWords, calleeTok: anchor)
			end 'trustStoreCertificate'

			if callee.equals(BuiltinsTrustStoreCloseName) 'trustStoreClose'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: TrustStoreCloseName, arity: TrustStoreCloseArity, shape: IntrinsicArgShape.allMachineWords, resultTag: ValueTypeTag.void, resultAlias: NoAnswerAlias, resultUsed: resultUsed, calleeTok: anchor)
			end 'trustStoreClose'

			// ⭐ **THE SECOND PROCESS-INTROSPECTION INTRINSIC, AND IT ANSWERS AN `int` RATHER THAN A BUFFER** —
			// so it takes `commandLineCount`'s emit and not `executablePath`'s, one arm up. There is nothing to
			// own, nothing to enrol as a temporary and no buffer surface to mark: a pid is a machine word the
			// caller reads and drops. `emitOwnedManagedMemoryResult` here would enrol a `__ManagedMemory` drop
			// against an integer and free the pid.
			if callee.equals(BuiltinsCurrentProcessIdName) 'currentProcessId'
				return try self.emitZeroArgIntrinsic(args, builtinName: BuiltinsCurrentProcessIdName, runtimeName: ProcessCurrentPidName, arity: CurrentProcessIdArity, resultTag: ValueTypeTag.integer, resultAlias: PidAliasName, calleeTok: anchor)
			end 'currentProcessId'

			if callee.equals(BuiltinsProcessIsAliveName) 'processIsAlive'
				let pid = try self.requireHandleArg(args, builtinName: BuiltinsProcessIsAliveName, arity: ProcessIsAliveArity, calleeTok: anchor)

				// Converted to the alias `__proc_alive` declares its parameter at, which is private to
				// `runtime/Process.maxon`: the index resolved it there, since no caller's file can name it.
				let probeAlias = self.signatures.firstParamAliasOf(ProcessAliveName)

				let probeType = match probeAlias 'probeParam'
					declared(alias) gives alias.underlying
					undeclared panic("processIsAlive: `{String.from(ProcessAliveName)}` declares its pid parameter at a ranged alias in `runtime/Process.maxon`, and the index resolves it in that file")
				end 'probeParam'

				let probed = try self.convertValueToDeclaredType(pid, sourceTag: self.tagOf(pid), targetType: probeType, targetAlias: probeAlias, opTok: anchor, sourceIsBareLocal: true, mustCarryTargetType: true)
				return self.emitRuntimeCall(ProcessAliveName, args: argsOf(probed), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
			end 'processIsAlive'

			if callee.equals(BuiltinsProcessEndDescendantsName) 'processEndDescendants'
				return try self.emitScalarIntrinsicCall(args, callee: callee, runtimeName: ProcessEndDescendantsTextName, arity: ProcessEndDescendantsArity, shape: IntrinsicArgShape.cstringFirst, resultTag: ValueTypeTag.integer, resultAlias: FullRangeIntAliasName, resultUsed: resultUsed, calleeTok: anchor, resultIsMachineWord: true)
			end 'processEndDescendants'

			// ⭐ **THE TWO CPU-PARALLEL QUERIES**, beside the checkpoint they share a family with. Both answer
			// an `int` and take nothing, so both take the argumentless-integer emit above — the same door the
			// pid takes, and the reason that door exists. What differs between them is not visible here and
			// is not this file's: one lowers to an OS read a lane must provide and the other to a `.data`
			// load every lane has. See `CpuParallelRuntime`'s header.
			if callee.equals(BuiltinsCpuCountName) 'cpuCount'
				return try self.emitZeroArgIntrinsic(args, builtinName: BuiltinsCpuCountName, runtimeName: CpuCountName, arity: CpuCountArity, resultTag: ValueTypeTag.integer, resultAlias: CountAliasName, calleeTok: anchor)
			end 'cpuCount'

			if callee.equals(BuiltinsSchedMaxActiveWorkersName) 'schedMaxActiveWorkers'
				return try self.emitZeroArgIntrinsic(args, builtinName: BuiltinsSchedMaxActiveWorkersName, runtimeName: SchedMaxActiveWorkersName, arity: SchedMaxActiveWorkersArity, resultTag: ValueTypeTag.integer, resultAlias: CountAliasName, calleeTok: anchor)
			end 'schedMaxActiveWorkers'

			if callee.equals(BuiltinsCpuHasAesName) 'cpuHasAes'
				return try self.emitZeroArgIntrinsic(args, builtinName: BuiltinsCpuHasAesName, runtimeName: CpuAesUsableName, arity: CpuHasAesArity, resultTag: ValueTypeTag.boolean, resultAlias: NoAnswerAlias, calleeTok: anchor)
			end 'cpuHasAes'

			// ⭐ **THE PRIORITY DOOR**, through the same argumentless-integer emit as the queries above even
			// though it is not a query: its answer is an `int` and it takes nothing, and what differs — that
