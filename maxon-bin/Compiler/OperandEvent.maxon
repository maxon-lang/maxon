enum ConflictingOperand
	plainRead
	byReferenceCell
end 'ConflictingOperand'

union OperandEventKind
	read
	cellRead(lend ElementIndex)
	write(lend ElementIndex)

	function isPlainRead() returns bool
		return match self 'kind'
			read gives true
			cellRead or
			write gives false
		end 'kind'
	end 'isPlainRead'

	function readsStorage() returns bool
		return match self 'kind'
			read or
			cellRead gives true
			write gives false
		end 'kind'
	end 'readsStorage'

	function conflictingOperand() returns ConflictingOperand
		return match self 'kind'
			read gives ConflictingOperand.plainRead
			cellRead gives ConflictingOperand.byReferenceCell
			write panic("conflictingOperand: a write is never an operand that overlaps")
		end 'kind'
	end 'conflictingOperand'

	function writtenLend() returns ElementIndex throws AbsentError
		match self 'kind'
			write(owner) then return owner
			read or
			cellRead then throw AbsentError.absent
		end 'kind'
	end 'writtenLend'
end 'OperandEventKind'

let plainOperandRead = OperandEventKind.read

type OperandEvent
	// Overlaps compare bindings with `is`, so an event shares its binding and is never cloned.
	var binding as VarInfo
	let at as ElementIndex
	let kind as OperandEventKind

	static function create(binding VarInfo, at ElementIndex, kind OperandEventKind) returns OperandEvent
		return Self{binding: binding, at: at, kind: kind}
	end 'create'

	function isPlainReadOf(root VarInfo) returns bool
		return self.binding is root and self.kind.isPlainRead()
	end 'isPlainReadOf'
end 'OperandEvent'

typealias OperandEventArray = Array with OperandEvent
