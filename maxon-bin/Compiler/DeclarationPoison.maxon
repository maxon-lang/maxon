typealias FailedFileSet = Set with FilePath
typealias PoisonedDeclarationArray = Array with PoisonedDeclaration
typealias PoisonedDeclarationsByName = Map with (ByteArray, PoisonedDeclarationArray)
typealias DuplicatedFunctionSet = Set with ByteArray
typealias LostHeadNameSet = Set with ByteArray
export typealias ReportedArityMessageSet = Set with String

export typealias PendingConsequenceArray = Array with PendingConsequence

// A file-scope declaration is found only where its head starts a line at this column; one written
// indented is attributed to the declaration above it.
module let DeclarationHeadColumn = 1

// `provisional` poison comes from a refusal still held as a possible consequence
// (`Queries.holdAsAConsequence`), which may yet be dropped. Only `backed` poison explains a held
// consequence: two held refusals could otherwise explain each other away and leave a failing
// program with no diagnostic. A check that skips poisoned declarations counts both, because a held
// refusal stays reported until it is explained.
export enum PoisonBacking
	backed
	provisional
end 'PoisonBacking'

export enum PoisonEntriesCounted
	everyEntry
	backedEntries
end 'PoisonEntriesCounted'

export union LostDeclaration
	region(site PoisonedAt)
	file
end 'LostDeclaration'

export type PendingConsequence
	export let file as FilePath
	let consequence as ConsequenceOf
	export let lost as LostDeclaration
	export let sinkStart as ElementIndex
	export let sinkEnd as ElementIndex

	export static function create(file FilePath, consequence ConsequenceOf, lost LostDeclaration, sinkStart ElementIndex, sinkEnd ElementIndex) returns PendingConsequence
		return Self{file: file, consequence: consequence, lost: lost, sinkStart: sinkStart, sinkEnd: sinkEnd}
	end 'create'

	export function shiftedBack(removed ElementIndex) returns PendingConsequence
		return Self{file: self.file.clone(), consequence: self.consequence.clone(), lost: self.lost.clone(), sinkStart: self.sinkStart - removed, sinkEnd: self.sinkEnd - removed}
	end 'shiftedBack'

	export function isExplainedBy(poison DeclarationPoison, signatures ProgramSignatures, reports UnknownTypeReports, hiddenReports ReaderNameSet, arityReports ReportedArityMessageSet) returns bool
		return match self.consequence 'consequence'
			unrelated gives false
			hiddenTypeName(name) gives hiddenReports.holds(String.from(name), readerFilePath: self.file)
			unknownType(name) gives poison.refusesAnyPartOfFrom(singleName(name), reader: self.file, signatures: signatures, counting: PoisonEntriesCounted.backedEntries) or reports.reportedUnknownName(name, readerFilePath: self.file)
			subject(names) gives poison.refusesAnyPartOfFrom(names, reader: self.file, signatures: signatures, counting: PoisonEntriesCounted.backedEntries) or poison.refusesAnExtensionQualifying(names, reader: self.file, signatures: signatures)
			handlerBody(message) gives poison.holdsABackedAbandonedBodyNamed(message)
			genericArgumentCount(reported) gives arityReports.contains(reported)
		end 'consequence'
	end 'isExplainedBy'

	function namesRead() returns NameRoster
		var names = NameRoster.create(0)

		match self.consequence 'consequence'
			unrelated or
			hiddenTypeName or
			genericArgumentCount then break
			unknownType(name) then addRefusalKeys(name, into: names)
			subject(subjects) then addEachRefusalKeys(subjects, into: names)
			handlerBody(message) then names.push(message)
		end 'consequence'

		return names
	end 'namesRead'

	function qualifiersRead() returns NameRoster
		var qualifiers = NameRoster.create(0)

		match self.consequence 'consequence'
			subject(subjects) then addExtensionQualifiers(subjects, into: qualifiers)
			unrelated or
			unknownType or
			hiddenTypeName or
			genericArgumentCount or
			handlerBody then break
		end 'consequence'

		return qualifiers
	end 'qualifiersRead'
end 'PendingConsequence'

type PoisonedDeclaration
	export let file as FilePath
	export let reach as Visibility
	export let nominal as bool
	export let backing as PoisonBacking

	static function create(file FilePath, reach Visibility, nominal bool, backing PoisonBacking) returns PoisonedDeclaration
		return Self{file: file, reach: reach, nominal: nominal, backing: backing}
	end 'create'
end 'PoisonedDeclaration'

union DeclaredWithin
	anywhere
	namespace(qualifier immutable ByteArray)
end 'DeclaredWithin'

union EnclosingRegion
	declaration(head DeclarationHead)
	lostHead(name immutable ByteArray)
end 'EnclosingRegion'

type DeclarationHead
	export let name as immutable ByteArray
	export let reach as Visibility
	export let nominal as bool
	export let extendsAType as bool

	static function create(name ByteArray, reach Visibility, nominal bool, extendsAType bool) returns DeclarationHead
		return Self{name: name, reach: reach, nominal: nominal, extendsAType: extendsAType}
	end 'create'
end 'DeclarationHead'

function memberHeadOf(enclosing DeclarationHead, member ByteArray) returns DeclarationHead
	return DeclarationHead.create(qualifiedMethodName(enclosing.name, methodName: member), reach: enclosing.reach, nominal: false, extendsAType: false)
end 'memberHeadOf'

// How much the poison holds, compared by `FoldLedger.withdrawStandingFold` to prove nothing was
// poisoned between a fold standing and its withdrawal, which rolling back would erase.
export type PoisonExtent implements Equatable
	let files as ElementIndex
	let backedFiles as ElementIndex
	let declared as ElementIndex
	let abandonedBodies as ElementIndex
	let duplicated as ElementIndex
	let lostHeads as ElementIndex
	let extended as ElementIndex
	let held as ElementIndex
	let deferred as ElementIndex
	let backedNames as ElementIndex
	let unreadable as bool
	let unreadableTypeUniverse as bool
	let filesWithLostText as ElementIndex

	static function create(files ElementIndex, backedFiles ElementIndex, declared ElementIndex, abandonedBodies ElementIndex, duplicated ElementIndex, lostHeads ElementIndex, extended ElementIndex, held ElementIndex, deferred ElementIndex, backedNames ElementIndex, unreadable bool, unreadableTypeUniverse bool, filesWithLostText ElementIndex) returns PoisonExtent
		return Self{files: files, backedFiles: backedFiles, declared: declared, abandonedBodies: abandonedBodies, duplicated: duplicated, lostHeads: lostHeads, extended: extended, held: held, deferred: deferred, backedNames: backedNames, unreadable: unreadable, unreadableTypeUniverse: unreadableTypeUniverse, filesWithLostText: filesWithLostText}
	end 'create'

	export function equals(other PoisonExtent) returns bool
		return self.files == other.files and self.backedFiles == other.backedFiles and self.declared == other.declared and self.abandonedBodies == other.abandonedBodies and self.duplicated == other.duplicated and self.lostHeads == other.lostHeads and self.extended == other.extended and self.held == other.held and self.deferred == other.deferred and self.backedNames == other.backedNames and self.unreadable == other.unreadable and self.unreadableTypeUniverse == other.unreadableTypeUniverse and self.filesWithLostText == other.filesWithLostText
	end 'equals'
end 'PoisonExtent'

// A field added to `DeclarationPoison` moves its size out of this range and fails the cast in
// `restore`: copy the field there and count it in `extent` before moving the bound to the new size.
typealias DeclarationPoisonLayoutBytes = int(104 to 104)

function entriesIn(byName PoisonedDeclarationsByName) returns ElementIndex
	var total = 0 as ElementIndex

	for (_, declarations) in byName 'eachName'
		total = total + declarations.count()
	end 'eachName'

	return total
end 'entriesIn'

// The declarations a refusal took out of the program, keyed by name. A reader's question is matched
// through the entry's file and visibility (`refusesANamedFrom`), so a poisoned declaration the
// reader cannot name explains nothing that reader writes.
export type DeclarationPoison
	var files as FailedFileSet
	var backedFiles as FailedFileSet
	var declared as PoisonedDeclarationsByName

	// An abandoned body is not a refusal of its declaration: the signature stands and its callers are
	// still checked against it, so it is never filed in `declared`.
	var abandonedBodies as PoisonedDeclarationsByName

	var duplicated as DuplicatedFunctionSet
	var lostHeads as LostHeadNameSet
	var unreadable as bool
	var unreadableTypeUniverse as bool

	// Files whose text the parse did not read, an abandoned region or a failed file: a typealias may be
	// spelled only there (`TypeResolution.aSpellingOfTheAliasMayHaveBeenLost`).
	var filesWithLostText as FailedFileSet

	// Keyed by the extended type's name, because a refused extension's members may be what a call on
	// that type, or on any type implementing it, meant (`refusesAnExtensionReaching`).
	var extended as PoisonedDeclarationsByName
	var heldConsequences as PendingConsequenceArray
	var deferredConsequences as PendingConsequenceArray
	var backedNames as BackedNameArray

	export static function create() returns Self
		return Self{files: FailedFileSet.create(), backedFiles: FailedFileSet.create(), declared: PoisonedDeclarationsByName.create(), abandonedBodies: PoisonedDeclarationsByName.create(), duplicated: DuplicatedFunctionSet.create(), lostHeads: LostHeadNameSet.create(), unreadable: false, unreadableTypeUniverse: false, filesWithLostText: FailedFileSet.create(), extended: PoisonedDeclarationsByName.create(), heldConsequences: PendingConsequenceArray.create(0), deferredConsequences: PendingConsequenceArray.create(0), backedNames: BackedNameArray.create(0)}
	end 'create'

	export function snapshot() returns Self
		var copy = Self.create()
		copy.restore(self)

		return copy
	end 'snapshot'

	export function extent() returns PoisonExtent
		return PoisonExtent.create(self.files.count(), backedFiles: self.backedFiles.count(), declared: entriesIn(self.declared), abandonedBodies: entriesIn(self.abandonedBodies), duplicated: self.duplicated.count(), lostHeads: self.lostHeads.count(), extended: entriesIn(self.extended), held: self.heldConsequences.count(), deferred: self.deferredConsequences.count(), backedNames: self.backedNames.count(), unreadable: self.unreadable, unreadableTypeUniverse: self.unreadableTypeUniverse, filesWithLostText: self.filesWithLostText.count())
	end 'extent'

	// Every field is copied: one left out survives a rolled-back fold (`Queries.FoldCheckpoint`).
	export function restore(source DeclarationPoison)
		let _ = sizeof(DeclarationPoison) as DeclarationPoisonLayoutBytes

		self.files = copiedFailedFiles(source.files)
		self.backedFiles = copiedFailedFiles(source.backedFiles)
		self.declared = copiedPoisonedDeclarations(source.declared)
		self.abandonedBodies = copiedPoisonedDeclarations(source.abandonedBodies)
		self.duplicated = copiedDuplicatedFunctions(source.duplicated)
		self.lostHeads = copiedLostHeads(source.lostHeads)
		self.unreadable = source.unreadable
		self.unreadableTypeUniverse = source.unreadableTypeUniverse
		self.filesWithLostText = copiedFailedFiles(source.filesWithLostText)
		self.extended = copiedPoisonedDeclarations(source.extended)
		self.heldConsequences = copiedPendingConsequences(source.heldConsequences)
		self.deferredConsequences = copiedPendingConsequences(source.deferredConsequences)
		self.backedNames = copiedBackedNames(source.backedNames)
	end 'restore'

	export function holdConsequence(consequence PendingConsequence)
		self.heldConsequences.push(consequence)
	end 'holdConsequence'

	export function forgetHeldConsequences()
		self.heldConsequences.clear()
	end 'forgetHeldConsequences'

	export function releaseHeldConsequences() returns PendingConsequenceArray
		let released = self.heldConsequences.clone()
		self.heldConsequences.clear()

		return released
	end 'releaseHeldConsequences'

	export function deferConsequences(consequences PendingConsequenceArray)
		self.deferredConsequences = consequences.clone()
	end 'deferConsequences'

	export function takeDeferredConsequences() returns PendingConsequenceArray
		let taken = self.deferredConsequences.clone()
		self.deferredConsequences.clear()

		return taken
	end 'takeDeferredConsequences'

	export function holdsAnAbandonedBodyOf(typeName ByteArray, declaredIn FilePath) returns bool
		let held = try self.abandonedBodies.get(typeName) otherwise return false

		for declaration in held 'eachDeclaration'
			if declaration.nominal and declaration.file.equals(declaredIn) 'theTypeItself'
				return true
			end 'theTypeItself'
		end 'eachDeclaration'

		return false
	end 'holdsAnAbandonedBodyOf'

	export function noteTextLostIn(path FilePath)
		self.filesWithLostText.insert(path)
	end 'noteTextLostIn'

	export function lostTextIn(path FilePath) returns bool
		return self.filesWithLostText.contains(path)
	end 'lostTextIn'

	export function holdsLostText() returns bool
		return self.filesWithLostText.count() > 0
	end 'holdsLostText'

	export function refusesTheDeclarationOf(typeName ByteArray, reader FilePath, signatures ProgramSignatures) returns bool
		return self.declaresANominalType(typeName) or self.refusesAnExtensionReaching(typeName, reader: reader, signatures: signatures, counting: PoisonEntriesCounted.everyEntry)
	end 'refusesTheDeclarationOf'

	// Probes `extended` by key: a type's interfaces are a small set, and the refused extension targets
	// are unbounded.
	export function refusesAnExtensionReaching(qualifier ByteArray, reader FilePath, signatures ProgramSignatures, counting PoisonEntriesCounted) returns bool
		if self.extended.count() == 0 'noExtensionIsRefused'
			return false
		end 'noExtensionIsRefused'

		for key in extensionKeysReaching(qualifier, signatures: signatures) 'eachKey'
			if self.refusesAnExtensionOf(key, reader: reader, signatures: signatures, counting: counting) 'anExtensionKeyedByItIsRefused'
				return true
			end 'anExtensionKeyedByItIsRefused'
		end 'eachKey'

		return false
	end 'refusesAnExtensionReaching'

	function refusesAnExtensionOf(target ByteArray, reader FilePath, signatures ProgramSignatures, counting PoisonEntriesCounted) returns bool
		let held = try self.extended.get(target) otherwise return false

		for declaration in held 'eachDeclaration'
			if counting == PoisonEntriesCounted.backedEntries and declaration.backing != PoisonBacking.backed 'notYetExplainedByAReportedError'
				continue
			end 'notYetExplainedByAReportedError'

			if signatures.isVisibleFrom(declaration.reach, declFilePath: declaration.file, readerFilePath: reader) 'theReaderMayNameIt'
				return true
			end 'theReaderMayNameIt'
		end 'eachDeclaration'

		return false
	end 'refusesAnExtensionOf'

	export function refusesAnExtensionQualifying(names NameRoster, reader FilePath, signatures ProgramSignatures) returns bool
		for name in names 'eachName'
			let qualifier = try extensionQualifierOf(name) otherwise continue

			if self.refusesAnExtensionReaching(qualifier, reader: reader, signatures: signatures, counting: PoisonEntriesCounted.backedEntries) 'anExtensionOfTheQualifierIsRefused'
				return true
			end 'anExtensionOfTheQualifierIsRefused'
		end 'eachName'

		return false
	end 'refusesAnExtensionQualifying'

	export function isEmpty() returns bool
		return self.files.count() == 0 and self.declared.count() == 0 and self.duplicated.count() == 0 and self.lostHeads.count() == 0
	end 'isEmpty'

	export function noteDuplicatedFunction(registrationName ByteArray)
		self.duplicated.insert(registrationName)
	end 'noteDuplicatedFunction'

	export function duplicates(registrationName ByteArray) returns bool
		if self.duplicated.count() == 0 'nothingIsDeclaredTwice'
			return false
		end 'nothingIsDeclaredTwice'

		return self.duplicated.contains(registrationName)
	end 'duplicates'

	export function holdsAFailedFile() returns bool
		return self.files.count() > 0
	end 'holdsAFailedFile'

	export function holdsADeclarationNamed(name ByteArray) returns bool
		return self.declared.contains(name)
	end 'holdsADeclarationNamed'

	export function holdsAnUnreadableFile() returns bool
		return self.unreadable
	end 'holdsAnUnreadableFile'

	export function noteUnreadableFile(path FilePath)
		self.noteTextLostIn(path)
		self.files.insert(path)
		self.unreadable = true
	end 'noteUnreadableFile'

	export function noteUnreadableTypeUniverse()
		self.unreadableTypeUniverse = true
	end 'noteUnreadableTypeUniverse'

	export function typeUniverseIsUnreadable() returns bool
		return self.unreadableTypeUniverse
	end 'typeUniverseIsUnreadable'

	export function noteFailedFile(path FilePath, heads DeclarationHeadIndex, backing PoisonBacking)
		self.noteTextLostIn(path)

		if self.backedFiles.contains(path) or (backing == PoisonBacking.provisional and self.files.contains(path)) 'alreadyNoted'
			return
		end 'alreadyNoted'

		self.files.insert(path)

		if backing == PoisonBacking.backed 'aBackedFailure'
			self.backedFiles.insert(path)
		end 'aBackedFailure'

		for position in 0 upto heads.headCount() 'eachHead'
			match heads.readingAt(position) 'reading'
				region(found) then self.noteDeclaredRegion(found, file: path, backing: backing)
				opensNothing then continue
			end 'reading'
		end 'eachHead'
	end 'noteFailedFile'

	function noteDeclaredRegion(region EnclosingRegion, file FilePath, backing PoisonBacking)
		match region 'region'
			declaration(head) then self.noteHead(head, file: file, backing: backing)
			lostHead then return
		end 'region'
	end 'noteDeclaredRegion'

	export function noteRefusedDeclarationAt(path FilePath, line LineNumber, heads DeclarationHeadIndex, backing PoisonBacking)
		let region = try heads.regionAt(line) otherwise return

		match region 'region'
			declaration(enclosing) then self.noteHead(enclosing, file: path, backing: backing)
			lostHead(name) then self.lostHeads.insert(name)
		end 'region'
	end 'noteRefusedDeclarationAt'

	// A head that lost its declaration keyword (`main() returns ExitCode`) declares nothing the merge
	// registers, so only its name is kept. The entry check asks it, so E3001 does not follow the
	// refusal, and `refusesAPartOfFrom` asks it, so a call to the name is a call to a refused callee.
	export function holdsALostHeadNamed(name ByteArray) returns bool
		return self.lostHeads.contains(name)
	end 'holdsALostHeadNamed'

	export function noteAbandonedBodyAt(path FilePath, line LineNumber, heads DeclarationHeadIndex, backing PoisonBacking)
		let region = try heads.regionAt(line) otherwise return

		match region 'region'
			declaration(enclosing) then self.noteAbandonedBodyUnder(enclosing, path: path, line: line, heads: heads, backing: backing)
			lostHead then return
		end 'region'
	end 'noteAbandonedBodyAt'

	function noteAbandonedBodyUnder(enclosing DeclarationHead, path FilePath, line LineNumber, heads DeclarationHeadIndex, backing PoisonBacking)
		self.fileAbandonedBody(enclosing, file: path, backing: backing)

		let member = try heads.memberAt(line) otherwise return
		self.fileAbandonedBody(memberHeadOf(enclosing, member: member), file: path, backing: backing)
	end 'noteAbandonedBodyUnder'

	export function noteRefusedMemberAt(path FilePath, line LineNumber, heads DeclarationHeadIndex, backing PoisonBacking)
		let region = try heads.regionAt(line) otherwise return

		match region 'region'
			declaration(enclosing) then self.noteRefusedMemberUnder(enclosing, path: path, line: line, heads: heads, backing: backing)
			lostHead(name) then self.lostHeads.insert(name)
		end 'region'
	end 'noteRefusedMemberAt'

	function noteRefusedMemberUnder(enclosing DeclarationHead, path FilePath, line LineNumber, heads DeclarationHeadIndex, backing PoisonBacking)
		let member = try heads.memberAt(line) otherwise 'theDeclarationItself'
			self.noteHead(enclosing, file: path, backing: backing)
			return
		end 'theDeclarationItself'

		self.noteHead(memberHeadOf(enclosing, member: member), file: path, backing: backing)
	end 'noteRefusedMemberUnder'

	function fileAbandonedBody(head DeclarationHead, file FilePath, backing PoisonBacking)
		fileHeadUnder(self.abandonedBodies, head: head, file: file, backing: backing)
		self.noteBacked(head, backing: backing)
	end 'fileAbandonedBody'

	function noteBacked(head DeclarationHead, backing PoisonBacking)
		if backing == PoisonBacking.backed 'aNameNowExplainsMore'
			self.backedNames.push(BackedName.create(head.name, extendsAType: head.extendsAType))
		end 'aNameNowExplainsMore'
	end 'noteBacked'

	module function takeBackedNames() returns BackedNameArray
		let taken = self.backedNames
		self.backedNames = BackedNameArray.create(0)

		return taken
	end 'takeBackedNames'

	export function holdsABackedAbandonedBodyNamed(qualifiedName ByteArray) returns bool
		let held = try self.abandonedBodies.get(qualifiedName) otherwise return false

		for declaration in held 'eachDeclaration'
			if declaration.backing == PoisonBacking.backed 'explainedByAReportedError'
				return true
			end 'explainedByAReportedError'
		end 'eachDeclaration'

		return false
	end 'holdsABackedAbandonedBodyNamed'

	function noteHead(head DeclarationHead, file FilePath, backing PoisonBacking)
		if head.extendsAType 'anExtensionReachesItsTarget'
			fileHeadUnder(self.extended, head: head, file: file, backing: backing)
		end 'anExtensionReachesItsTarget'

		fileHeadUnder(self.declared, head: head, file: file, backing: backing)
		self.noteBacked(head, backing: backing)
	end 'noteHead'

	export function fileFailed(path FilePath) returns bool
		return self.files.contains(path)
	end 'fileFailed'

	export function declaresANominalType(name ByteArray) returns bool
		if self.unreadable 'anUnreadableFileMayDeclareAnything'
			return true
		end 'anUnreadableFileMayDeclareAnything'

		let held = try self.declared.get(name) otherwise return false

		for declaration in held 'eachDeclaration'
			if declaration.nominal 'aNominalDeclaration'
				return true
			end 'aNominalDeclaration'
		end 'eachDeclaration'

		return false
	end 'declaresANominalType'

	export function declaresNamedFrom(name ByteArray, reader FilePath, signatures ProgramSignatures) returns bool
		if self.unreadable 'anUnreadableFileMayDeclareAnything'
			return true
		end 'anUnreadableFileMayDeclareAnything'

		return self.refusesANamedFrom(name, reader: reader, signatures: signatures, counting: PoisonEntriesCounted.everyEntry, within: DeclaredWithin.anywhere)
	end 'declaresNamedFrom'

	export function refusesACalleeFrom(callee ByteArray, reader FilePath, signatures ProgramSignatures) returns bool
		if self.isEmpty() 'noDeclarationWasRefused'
			return false
		end 'noDeclarationWasRefused'

		return self.refusesAPartOfFrom(genericTemplateName(callee), reader: reader, signatures: signatures, counting: PoisonEntriesCounted.everyEntry)
	end 'refusesACalleeFrom'

	export function refusesAnyPartOfFrom(callees NameRoster, reader FilePath, signatures ProgramSignatures, counting PoisonEntriesCounted) returns bool
		for callee in callees 'eachCallee'
			if self.refusesAPartOfFrom(callee, reader: reader, signatures: signatures, counting: counting) 'aPartIsRefused'
				return true
			end 'aPartIsRefused'
		end 'eachCallee'

		return false
	end 'refusesAnyPartOfFrom'

	export function refusesAPartOfFrom(callee immutable ByteArray, reader FilePath, signatures ProgramSignatures, counting PoisonEntriesCounted) returns bool
		if self.holdsALostHeadNamed(callee) and not signatures.declaresAFreeFunctionVisibleFrom(callee, readerFilePath: reader) 'theCalleeIsALostHead'
			return true
		end 'theCalleeIsALostHead'

		for key in refusalKeysOf(callee) 'eachKey'
			if self.refusesANamedFrom(key.spelling(), reader: reader, signatures: signatures, counting: counting, within: key.scope()) 'aKeyIsRefused'
				return true
			end 'aKeyIsRefused'
		end 'eachKey'

		return false
	end 'refusesAPartOfFrom'

	function refusesANamedFrom(name ByteArray, reader FilePath, signatures ProgramSignatures, counting PoisonEntriesCounted, within DeclaredWithin) returns bool
		let held = try self.declared.get(name) otherwise return false

		for declaration in held 'eachDeclaration'
			if counting == PoisonEntriesCounted.backedEntries and declaration.backing != PoisonBacking.backed 'notYetExplainedByAReportedError'
				continue
			end 'notYetExplainedByAReportedError'

			if not declarationIsWithin(declaration, within: within, signatures: signatures) 'inAnotherNamespace'
				continue
			end 'inAnotherNamespace'

			if signatures.isVisibleFrom(declaration.reach, declFilePath: declaration.file, readerFilePath: reader) 'theReaderMayNameIt'
				return true
			end 'theReaderMayNameIt'
		end 'eachDeclaration'

		return false
	end 'refusesANamedFrom'
end 'DeclarationPoison'

module type BackedName
	let name as immutable ByteArray
	let extendsAType as bool

	static function create(name immutable ByteArray, extendsAType bool) returns BackedName
		return Self{name: name, extendsAType: extendsAType}
	end 'create'

	function spelling() returns immutable ByteArray
		return self.name
	end 'spelling'

	function isAnExtension() returns bool
		return self.extendsAType
	end 'isAnExtension'
end 'BackedName'

module typealias BackedNameArray = Array with BackedName
typealias ConsequencePositionArray = Array with ElementIndex
typealias ConsequencePositionsByName = Map with (ByteArray, ConsequencePositionArray)

// Files each held consequence under the poison names `isExplainedBy` tests, derived by the same
// `refusalKeysOf`, `extensionQualifierOf` and `extensionKeysReaching` rules. A name a predicate reads
// that is not a key here never wakes its consequence, which then stays held though a backed refusal
// explains it.
module type ConsequenceWorklist
	var byName as ConsequencePositionsByName
	var byQualifier as ConsequencePositionsByName
	var queue as ConsequencePositionArray
	var queued as FixedBoolArray
	var next as ElementIndex

	module static function over(held PendingConsequenceArray) returns ConsequenceWorklist
		var byName = ConsequencePositionsByName.create()
		var byQualifier = ConsequencePositionsByName.create()
		var queue = ConsequencePositionArray.create(held.count(), zeroed: false)
		var queued = FixedBoolArray.create(held.count())

		for position in 0 upto held.count() 'eachHeld'
			view consequence = try held.get(position) otherwise panic("ConsequenceWorklist.over: held.get OOB at {position} below count {held.count()}")

			for name in consequence.namesRead() 'eachNameRead'
				filePositionUnder(byName, name: name, position: position)
			end 'eachNameRead'

			for qualifier in consequence.qualifiersRead() 'eachQualifierRead'
				filePositionUnder(byQualifier, name: qualifier, position: position)
			end 'eachQualifierRead'

			queue.push(position)
			try queued.set(position, value: true) otherwise panic("ConsequenceWorklist.over: queued.set OOB at {position} below count {queued.count()}")
		end 'eachHeld'

		return Self{byName: byName, byQualifier: byQualifier, queue: queue, queued: queued, next: 0}
	end 'over'

	module function hasNext() returns bool
		return self.next < self.queue.count()
	end 'hasNext'

	module function takeNext() returns ElementIndex
		let position = try self.queue.get(self.next) otherwise panic("ConsequenceWorklist.takeNext: queue.get OOB at {self.next} below count {self.queue.count()}")
		self.next = self.next + 1
		try self.queued.set(position, value: false) otherwise panic("ConsequenceWorklist.takeNext: queued.set OOB at {position} below count {self.queued.count()}")

		return position
	end 'takeNext'

	module function wake(backed BackedNameArray, signatures ProgramSignatures, explained FixedBoolArray)
		for name in backed 'eachBackedName'
			if let positions = try self.byName.get(name.spelling()) 'someReadsTheName'
				self.enqueueUnexplained(positions, explained: explained)
			end 'someReadsTheName'

			if name.isAnExtension() 'anExtensionWasBacked'
				self.wakeSubjectsReachedBy(name.spelling(), signatures: signatures, explained: explained)
			end 'anExtensionWasBacked'
		end 'eachBackedName'
	end 'wake'

	function wakeSubjectsReachedBy(target ByteArray, signatures ProgramSignatures, explained FixedBoolArray)
		for (qualifier, positions) in self.byQualifier 'eachQualifier'
			for key in extensionKeysReaching(qualifier, signatures: signatures) 'eachKey'
				if key.equals(target) 'theExtensionReachesIt'
					self.enqueueUnexplained(positions, explained: explained)
					break
				end 'theExtensionReachesIt'
			end 'eachKey'
		end 'eachQualifier'
	end 'wakeSubjectsReachedBy'

	function enqueueUnexplained(positions ConsequencePositionArray, explained FixedBoolArray)
		for position in positions 'eachPosition'
			let settled = try explained.get(position) otherwise panic("ConsequenceWorklist.enqueueUnexplained: explained.get OOB at {position} below count {explained.count()}")
			let waiting = try self.queued.get(position) otherwise panic("ConsequenceWorklist.enqueueUnexplained: queued.get OOB at {position} below count {self.queued.count()}")

			if settled or waiting 'nothingToEvaluate'
				continue
			end 'nothingToEvaluate'

			self.queue.push(position)
			try self.queued.set(position, value: true) otherwise panic("ConsequenceWorklist.enqueueUnexplained: queued.set OOB at {position} below count {self.queued.count()}")
		end 'eachPosition'
	end 'enqueueUnexplained'
end 'ConsequenceWorklist'

function filePositionUnder(table ConsequencePositionsByName, name ByteArray, position ElementIndex)
	var held = try table.get(name) otherwise ConsequencePositionArray.create(0)
	held.push(position)
	table.upsert(name, value: held)
end 'filePositionUnder'

type RefusalKey
	let name as immutable ByteArray
	let within as DeclaredWithin

	static function create(name immutable ByteArray, within DeclaredWithin) returns RefusalKey
		return Self{name: name, within: within}
	end 'create'

	function spelling() returns immutable ByteArray
		return self.name
	end 'spelling'

	function scope() returns DeclaredWithin
		return self.within
	end 'scope'
end 'RefusalKey'

typealias RefusalKeyArray = Array with RefusalKey

function refusalKeysOf(callee immutable ByteArray) returns RefusalKeyArray
	var keys = RefusalKeyArray.create(3, zeroed: false)
	keys.push(RefusalKey.create(callee, within: DeclaredWithin.anywhere))
	keys.push(RefusalKey.create(qualifyingTypeName(callee), within: DeclaredWithin.anywhere))

	match splitQualifiedName(callee) 'shape'
		parts(prefix, member) then keys.push(RefusalKey.create(member, within: DeclaredWithin.namespace(prefix)))
		notQualified then break
	end 'shape'

	return keys
end 'refusalKeysOf'

function extensionQualifierOf(name ByteArray) returns immutable ByteArray throws AbsentError
	let qualifier = qualifyingTypeName(name)

	if qualifier.count() == name.count() 'notQualified'
		throw AbsentError.absent
	end 'notQualified'

	return qualifier
end 'extensionQualifierOf'

function extensionKeysReaching(qualifier ByteArray, signatures ProgramSignatures) returns NameRoster
	var keys = NameRoster.create(0)
	keys.push(qualifier)

	var implemented = InterfaceNameSet.create()
	signatures.collectImplementedInterfaces(qualifier, into: implemented)

	for interfaceName in implemented 'eachImplementedInterface'
		keys.push(interfaceName)
	end 'eachImplementedInterface'

	return keys
end 'extensionKeysReaching'

function addRefusalKeys(callee immutable ByteArray, into NameRoster)
	for key in refusalKeysOf(callee) 'eachKey'
		into.push(key.spelling())
	end 'eachKey'
end 'addRefusalKeys'

function addEachRefusalKeys(callees NameRoster, into NameRoster)
	for callee in callees 'eachCallee'
		addRefusalKeys(callee, into: into)
	end 'eachCallee'
end 'addEachRefusalKeys'

function addExtensionQualifiers(names NameRoster, into NameRoster)
	for name in names 'eachName'
		let qualifier = try extensionQualifierOf(name) otherwise continue
		into.push(qualifier)
	end 'eachName'
end 'addExtensionQualifiers'

union HeadReading
	region(found EnclosingRegion)
	opensNothing
end 'HeadReading'

typealias HeadReadingArray = Array with HeadReading
typealias LineKeyArray = Array with LineKey

type LineKey
	let line as LineNumber
	let ordinal as ElementIndex

	static function create(line LineNumber, ordinal ElementIndex) returns LineKey
		return Self{line: line, ordinal: ordinal}
	end 'create'

	function isAfter(other LineNumber) returns bool
		return self.line > other
	end 'isAfter'

	function position() returns ElementIndex
		return self.ordinal
	end 'position'

	function startsBefore(other LineKey) returns bool
		return self.line < other.line
	end 'startsBefore'

	function compared(other LineKey) returns Ordering
		if self.line != other.line 'differentLines'
			return self.line.compare(other.line)
		end 'differentLines'

		return self.ordinal.compare(other.ordinal)
	end 'compared'
end 'LineKey'

// A stream's lines need not ascend (`MAXON_SOURCE_ORDER=reversed` keeps the original line numbers),
// so `seal` sorts by line. A tie keeps stream order, so of two keys on one line the later one
// answers.
type LineOrder
	var keys as LineKeyArray
	var ascending as bool

	static function create() returns LineOrder
		return Self{keys: LineKeyArray.create(0), ascending: true}
	end 'create'

	function add(line LineNumber)
		if self.ascending and self.keys.count() > 0 'mayBreakTheOrder'
			let last = try self.keys.get(self.keys.count() - 1) otherwise panic("LineOrder.add: keys.get OOB at {self.keys.count() - 1} below count {self.keys.count()}")

			if last.isAfter(line) 'outOfOrder'
				self.ascending = false
			end 'outOfOrder'
		end 'mayBreakTheOrder'

		self.keys.push(LineKey.create(line, ordinal: self.keys.count()))
	end 'add'

	function seal()
		if self.ascending 'alreadyOrdered'
			return
		end 'alreadyOrdered'

		self.keys.sortBy(function(left LineKey, right LineKey) gives left.compared(right))
		self.ascending = true
	end 'seal'

	function lastAtOrBefore(line LineNumber) returns LineKey throws AbsentError
		var low = 0 as Count
		var high = self.keys.count()

		while low < high 'search'
			let middle = low + ((high - low) shr 1)
			let key = try self.keys.get(middle) otherwise panic("LineOrder.lastAtOrBefore: keys.get OOB at {middle} inside the search window")

			if key.isAfter(line) 'outside'
				high = middle
			end 'outside' else 'inside'
				low = middle + 1
			end 'inside'
		end 'search'

		if low == 0 'nothingAtOrBefore'
			throw AbsentError.absent
		end 'nothingAtOrBefore'

		return (try self.keys.get(low - 1) otherwise panic("LineOrder.lastAtOrBefore: keys.get OOB at {low - 1} below the window's end")).clone()
	end 'lastAtOrBefore'
end 'LineOrder'

export type DeclarationHeadIndex
	let readings as HeadReadingArray
	let headOrder as LineOrder
	let memberReadings as MemberReadingArray
	let memberOrder as LineOrder

	// Members are classified by structure, never by column: active tokens keep their `#if` indentation,
	// and the language allows spaces. A method body runs from a line-start method header to its
	// `end '<name>'`; an interface requirement has none (BNF §3.5). Every other line-start line of a type
	// outside a body is type-level, because fields, typealiases and cases interleave with methods.
	export static function build(tokens TokenArray) returns DeclarationHeadIndex
		var readings = HeadReadingArray.create(0)
		var headOrder = LineOrder.create()
		var memberReadings = MemberReadingArray.create(0)
		var memberOrder = LineOrder.create()
		var lineStartColumn = 1 as ColumnNumber
		var previousLine = 0 as LineNumber
		var headHoldsMembers = false
		var headMethodsHaveBodies = false
		var methodBodyOpen = false
		var openMethodName = b""

		for position in 0 upto tokens.count() 'eachToken'
			view token = try tokens.get(position) otherwise panic("DeclarationHeadIndex.build: tokens.get OOB at {position} below count {tokens.count()}")

			if tokenKindIsSkippedLayout(token.kind) 'layout'
				continue
			end 'layout'

			if token.column == DeclarationHeadColumn 'aHead'
				let headKeyword = tokenKindAt(tokens, index: pastVisibilityModifiers(tokens, index: position))

				readings.push(headReadingAt(tokens, position: position))
				headOrder.add(token.line)
				headHoldsMembers = tokenKindDeclaresANamedType(headKeyword)
				headMethodsHaveBodies = headKeyword != TokenKind.interface
				methodBodyOpen = false
			end 'aHead'

			let startsALine = token.line != previousLine

			if startsALine 'aLineStarts'
				previousLine = token.line
				lineStartColumn = token.column
			end 'aLineStarts'

			if methodBodyOpen and methodBodyClosesAt(tokens, index: position, methodName: openMethodName) 'theBodyCloses'
				methodBodyOpen = false
			end 'theBodyCloses'

			if startsALine and headHoldsMembers and not methodBodyOpen and token.column > DeclarationHeadColumn and tokenKindAt(tokens, index: position - 1) == TokenKind.newline and not methodHeaderLineIn(tokens, index: position) 'aTypeLevelMember'
				memberReadings.push(MemberReading.typeLevel)
				memberOrder.add(token.line)
			end 'aTypeLevelMember'

			if token.kind == TokenKind.function and lineStartColumn > DeclarationHeadColumn and functionDeclarationShapeIn(tokens, index: position) 'aNestedFunction'
				view name = try tokens.get(position + 1) otherwise panic("DeclarationHeadIndex.build: the name of the function at {position} is missing, though its shape was just read")
				memberReadings.push(MemberReading.method(name.value))
				memberOrder.add(token.line)
				methodBodyOpen = headMethodsHaveBodies
				openMethodName = name.value
			end 'aNestedFunction'
		end 'eachToken'

		headOrder.seal()
		memberOrder.seal()

		return Self{readings: readings, headOrder: headOrder, memberReadings: memberReadings, memberOrder: memberOrder}
	end 'build'

	function headCount() returns Count
		return self.readings.count()
	end 'headCount'

	function readingAt(position ElementIndex) returns HeadReading
		return try self.readings.get(position) otherwise panic("DeclarationHeadIndex.readingAt: readings.get OOB at {position} below count {self.readings.count()}")
	end 'readingAt'

	function regionAt(line LineNumber) returns EnclosingRegion throws AbsentError
		let head = try self.headOrder.lastAtOrBefore(line)

		match self.readingAt(head.position()) 'reading'
			region(found) then return found.clone()
			opensNothing then throw AbsentError.absent
		end 'reading'
	end 'regionAt'

	function memberAt(line LineNumber) returns immutable ByteArray throws AbsentError
		let head = try self.headOrder.lastAtOrBefore(line)
		let member = try self.memberOrder.lastAtOrBefore(line)

		if member.startsBefore(head) 'outsideTheEnclosingDeclaration'
			throw AbsentError.absent
		end 'outsideTheEnclosingDeclaration'

		match try self.memberReadings.get(member.position()) otherwise panic("DeclarationHeadIndex.memberAt: memberReadings.get OOB at {member.position()} below count {self.memberReadings.count()}") 'reading'
			method(name) then return name
			typeLevel then throw AbsentError.absent
		end 'reading'
	end 'memberAt'
end 'DeclarationHeadIndex'

union MemberReading
	method(name immutable ByteArray)
	typeLevel
end 'MemberReading'

typealias MemberReadingArray = Array with MemberReading

function methodBodyClosesAt(tokens TokenArray, index ElementIndex, methodName ByteArray) returns bool
	if not labelledBlockCloserAt(tokens, index: index) 'notACloser'
		return false
	end 'notACloser'

	view label = try tokens.get(index + 1) otherwise panic("methodBodyClosesAt: the label after the closer at {index} is missing, though its shape was just read")

	return label.value.equals(methodName)
end 'methodBodyClosesAt'

function methodHeaderLineIn(tokens TokenArray, index ElementIndex) returns bool
	return functionDeclarationShapeIn(tokens, index: pastVisibilityModifiers(tokens, index: pastDeclarationModifiers(tokens, index: index)))
end 'methodHeaderLineIn'

function headReadingAt(tokens TokenArray, position ElementIndex) returns HeadReading
	let found = try regionHeadAt(tokens, position: position) otherwise return HeadReading.opensNothing

	return HeadReading.region(found)
end 'headReadingAt'

function declarationIsWithin(declaration PoisonedDeclaration, within DeclaredWithin, signatures ProgramSignatures) returns bool
	return match within 'within'
		anywhere gives true
		namespace(qualifier) gives signatures.namespaceOf(declaration.file).toByteArray().equals(qualifier)
	end 'within'
end 'declarationIsWithin'

module function singleName(name ByteArray) returns NameRoster
	var names = NameRoster.create(0)
	names.push(name)

	return names
end 'singleName'

function copiedFailedFiles(paths FailedFileSet) returns FailedFileSet
	var copied = FailedFileSet.create()

	for path in paths 'eachPath'
		copied.insert(path)
	end 'eachPath'

	return copied
end 'copiedFailedFiles'

function copiedDuplicatedFunctions(names DuplicatedFunctionSet) returns DuplicatedFunctionSet
	var copied = DuplicatedFunctionSet.create()

	for name in names 'eachName'
		copied.insert(name)
	end 'eachName'

	return copied
end 'copiedDuplicatedFunctions'

function copiedLostHeads(names LostHeadNameSet) returns LostHeadNameSet
	var copied = LostHeadNameSet.create()

	for name in names 'eachName'
		copied.insert(name)
	end 'eachName'

	return copied
end 'copiedLostHeads'

function copiedPoisonedDeclarations(table PoisonedDeclarationsByName) returns PoisonedDeclarationsByName
	var copied = PoisonedDeclarationsByName.create()

	for (name, declarations) in table 'eachName'
		copied.upsert(name, value: declarations.clone())
	end 'eachName'

	return copied
end 'copiedPoisonedDeclarations'

function copiedBackedNames(names BackedNameArray) returns BackedNameArray
	var copied = BackedNameArray.create(names.count(), zeroed: false)

	for name in names 'eachName'
		copied.push(name.clone())
	end 'eachName'

	return copied
end 'copiedBackedNames'

function copiedPendingConsequences(held PendingConsequenceArray) returns PendingConsequenceArray
	var copied = PendingConsequenceArray.create(held.count(), zeroed: false)

	for consequence in held 'eachConsequence'
		copied.push(consequence.clone())
	end 'eachConsequence'

	return copied
end 'copiedPendingConsequences'

function fileHeadUnder(table PoisonedDeclarationsByName, head DeclarationHead, file FilePath, backing PoisonBacking)
	var held = try table.get(head.name) otherwise PoisonedDeclarationArray.create(0)
	held.push(PoisonedDeclaration.create(file, reach: head.reach, nominal: head.nominal, backing: backing))
	table.upsert(head.name, value: held)
end 'fileHeadUnder'

function regionHeadAt(tokens TokenArray, position ElementIndex) returns EnclosingRegion throws AbsentError
	if declarationOpensIn(tokens, index: position) 'aDeclaration'
		return EnclosingRegion.declaration(try declarationHeadAt(tokens, position: position))
	end 'aDeclaration'

	return EnclosingRegion.lostHead(try lostFunctionHeadAt(tokens, position: position))
end 'regionHeadAt'

function lostFunctionHeadAt(tokens TokenArray, position ElementIndex) returns immutable ByteArray throws AbsentError
	let nameAt = pastVisibilityModifiers(tokens, index: position)
	view name = try tokens.get(nameAt) otherwise throw AbsentError.absent
	view opener = try tokens.get(nameAt + 1) otherwise throw AbsentError.absent

	if name.kind != TokenKind.identifier or opener.kind != TokenKind.leftParen 'notAFunctionHead'
		throw AbsentError.absent
	end 'notAFunctionHead'

	return name.value
end 'lostFunctionHeadAt'

function declarationHeadAt(tokens TokenArray, position ElementIndex) returns DeclarationHead throws AbsentError
	if not declarationOpensIn(tokens, index: position) 'notADeclaration'
		throw AbsentError.absent
	end 'notADeclaration'

	let keywordAt = pastVisibilityModifiers(tokens, index: position)
	view keyword = try tokens.get(keywordAt) otherwise throw AbsentError.absent
	view name = try tokens.get(keywordAt + 1) otherwise throw AbsentError.absent

	if not tokenCanBeAName(name) 'notNamed'
		throw AbsentError.absent
	end 'notNamed'

	if keyword.kind == TokenKind.extension 'anExtensionReachesEveryReader'
		return DeclarationHead.create(name.value, reach: Visibility.public, nominal: false, extendsAType: true)
	end 'anExtensionReachesEveryReader'

	var reach = Visibility.file

	if keywordAt > position 'aModifierPrecedes'
		reach = reachOfModifier(tokens, position: keywordAt - 1)
	end 'aModifierPrecedes'

	return DeclarationHead.create(name.value, reach: reach, nominal: tokenKindDeclaresANominalType(keyword.kind), extendsAType: false)
end 'declarationHeadAt'

function reachOfModifier(tokens TokenArray, position ElementIndex) returns Visibility
	view token = try tokens.get(position) otherwise panic("reachOfModifier: tokens.get OOB at {position}")

	if token.kind == TokenKind.export 'exported'
		return Visibility.global
	end 'exported'

	if token.kind == TokenKind.public 'publicApi'
		return Visibility.public
	end 'publicApi'

	if not spellsModuleModifier(token.kind, value: token.value) 'notAModifier'
		panic("reachOfModifier: the token at {position} is not a visibility modifier")
	end 'notAModifier'

	return Visibility.module
end 'reachOfModifier'
