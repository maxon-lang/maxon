export type ShadowRespellings
	let entries as ShadowRespellingArray
	let byMinted as RespellingPositionsByMint
	let unanchored as RespellingPositionArray
	let reach as ElementIndex

	static function of(entries ShadowRespellingArray) returns ShadowRespellings
		var byMinted = RespellingPositionsByMint.create()
		var unanchored = RespellingPositionArray.create()
		var reach = 0 as ElementIndex

		for (iter, respelling) in entries.withIterator() 'eachRespelling'
			if not respelling.beginsAtAWordStart() 'noLeadingWordByte'
