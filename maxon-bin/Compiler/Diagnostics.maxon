				continue
			end 'noLeadingWordByte'

			var positions = try byMinted.get(respelling.mintedName()) otherwise RespellingPositionArray.create()
			positions.push(iter.index())
			byMinted.upsert(respelling.mintedName(), value: positions)

			if respelling.mintedLength() > reach 'aLongerMint'
				reach = respelling.mintedLength()
			end 'aLongerMint'
		end 'eachRespelling'

		return Self{entries: entries, byMinted: byMinted, unanchored: unanchored, reach: reach}
	end 'of'

	export static function none() returns ShadowRespellings
		return Self.of(ShadowRespellingArray.create())
	end 'none'

	// One indexed pass over the original text equals respelling every entry in turn: a replacement never
	// contains a mint, so no respelling creates an occurrence another one must then find.
	export function respell(text String) returns String
