// @generated library-cache end

export type ShadowRespellings
	let entries as ShadowRespellingArray
	let byMinted as RespellingPositionsByMint
	let unanchored as RespellingPositionArray
	let reach as ElementIndex

	static function of(entries ShadowRespellingArray) returns ShadowRespellings
		let byMinted = RespellingPositionsByMint.create()
		let unanchored = RespellingPositionArray.create(0)
		var reach = 0 as ElementIndex

		for (iter, respelling) in entries.withIterator() 'eachRespelling'
			if not respelling.beginsAtAWordStart() 'noLeadingWordByte'
				unanchored.push(iter.index())
				continue
			end 'noLeadingWordByte'

			let positions = try byMinted.get(respelling.mintedName()) otherwise RespellingPositionArray.create(0)
			positions.push(iter.index())
			byMinted.upsert(respelling.mintedName(), value: positions)

			if respelling.mintedLength() > reach 'aLongerMint'
				reach = respelling.mintedLength()
			end 'aLongerMint'
		end 'eachRespelling'

		return Self{entries: entries, byMinted: byMinted, unanchored: unanchored, reach: reach}
	end 'of'

	export static function none() returns ShadowRespellings
		return Self.of(ShadowRespellingArray.create(0))
	end 'none'

	// One indexed pass over the original text equals respelling every entry in turn: a replacement never
	// contains a mint, so no respelling creates an occurrence another one must then find.
	export function respell(text String) returns String
		if self.entries.isEmpty() 'nothingToRespell'
			return text
		end 'nothingToRespell'

		var spelled = text

		for position in self.candidatePositionsIn(text.toByteArray()) 'eachCandidate'
			spelled = self.respellingAt(position).respell(spelled)
		end 'eachCandidate'

		return spelled
	end 'respell'

	function respellingAt(position ElementIndex) returns ShadowRespelling
		return try self.entries.get(position) otherwise panic("ShadowRespellings.respellingAt: entries.get OOB at {position}, a position the index recorded over {self.entries.count()} entries")
	end 'respellingAt'

	function candidatePositionsIn(bytes ByteArray) returns RespellingPositionArray
		let seen = RespellingPositionSet.create()
		let found = RespellingPositionArray.create(0)

		for position in self.unanchored 'eachUnanchored'
			seen.insert(position)
			found.push(position)
		end 'eachUnanchored'

		var at = 0 as ElementIndex

		while at < bytes.count() 'eachWord'
			let wordEnd = identifierWordEnd(bytes, from: at)

			if wordEnd == at 'notAWordByte'
				at = at + 1
				continue
			end 'notAWordByte'

			self.noteMintsStandingAt(bytes, at: at, seen: seen, found: found)
			at = wordEnd
		end 'eachWord'

		found.sort()
		return found
	end 'candidatePositionsIn'

	function noteMintsStandingAt(bytes ByteArray, at ElementIndex, seen RespellingPositionSet, found RespellingPositionArray)
		let limit = at + self.reach
		var stop = at + 1

		while stop <= limit and stop <= bytes.count() 'eachStopInReach'
			if stop < bytes.count() and isAlphaNum(try bytes.get(stop) otherwise panic("ShadowRespellings.noteMintsStandingAt: {stop} is below the count the test above bounds")) 'insideAWord'
				stop = stop + 1
				continue
			end 'insideAWord'

			let spelled = try bytes.slice(at, endIndex: stop) otherwise panic("ShadowRespellings.noteMintsStandingAt: slice({at}, {stop}) is inside the text's {bytes.count()} bytes")

			if let positions = try self.byMinted.get(spelled) 'someMintIsSpelledSo'
				for position in positions 'eachRespellingOfIt'
					if not seen.contains(position) and self.respellingAt(position).standsAt(bytes, at: at) 'aMintStandsHere'
						seen.insert(position)
						found.push(position)
					end 'aMintStandsHere'
				end 'eachRespellingOfIt'
			end 'someMintIsSpelledSo'

			stop = stop + 1
		end 'eachStopInReach'
	end 'noteMintsStandingAt'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteShadowRespellingArray(writer, value: self.entries)
		cacheWriteRespellingPositionsByMint(writer, value: self.byMinted)
		cacheWriteRespellingPositionArray(writer, value: self.unanchored)
		writer.unsigned(self.reach as CacheUnsigned)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns ShadowRespellings throws LibraryCacheDamage
		let f_entries = try cacheReadShadowRespellingArray(reader)
		let f_byMinted = try cacheReadRespellingPositionsByMint(reader)
		let f_unanchored = try cacheReadRespellingPositionArray(reader)
		let f_reach = (try reader.unsigned()) as ElementIndex

		return Self{entries: f_entries, byMinted: f_byMinted, unanchored: f_unanchored, reach: f_reach}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize32
		return sizeof(ShadowRespellings) as CacheSize32
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'ShadowRespellings'

function identifierWordEnd(bytes ByteArray, from ElementIndex) returns ElementIndex
	var at = from

	while at < bytes.count() and isAlphaNum(try bytes.get(at) otherwise panic("identifierWordEnd: {at} is below the count the loop is bounded by")) 'eachWordByte'
		at = at + 1
	end 'eachWordByte'

	return at
end 'identifierWordEnd'

export typealias ShadowRespellingsOf = function(FilePath) returns ShadowRespellings mutates captures

