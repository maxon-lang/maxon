			return text
		end 'nothingToRespell'

		var spelled = text

		for position in self.candidatePositionsIn(text.toByteArray()) 'eachCandidate'
			spelled = self.respellingAt(position).respell(spelled)
		end 'eachCandidate'

		return spelled
	end 'respell'

	function respellingAt(position ElementIndex) returns ShadowRespelling
		return try self.entries.get(position) otherwise panic("ShadowRespellings.respellingAt: entries.get OOB at {position}, a position the index recorded over {self.entries.count()} entries")
	end 'respellingAt'

	function candidatePositionsIn(bytes ByteArray) returns RespellingPositionArray
		var seen = RespellingPositionSet.create()
		var found = RespellingPositionArray.create()

		for position in self.unanchored 'eachUnanchored'
			seen.insert(position)
			found.push(position)
		end 'eachUnanchored'

		var at = 0 as ElementIndex

		while at < bytes.count() 'eachWord'
			let wordEnd = identifierWordEnd(bytes, from: at)

			if wordEnd == at 'notAWordByte'
				at = at + 1
				continue
			end 'notAWordByte'

			self.noteMintsStandingAt(bytes, at: at, seen: seen, found: found)
			at = wordEnd
