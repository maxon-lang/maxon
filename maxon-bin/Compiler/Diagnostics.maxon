// Diagnostics — the compiler's user-facing error channel, plus the driver-level
// `CompileError` the query/build pipeline throws.
//
// A `Diagnostic` is a code + message + optional source position, accumulated on
// `Project.diagnostics` by every reporting pass. The driver prints them and bails.
//
// The `ErrorCode` enum itself is NOT here: `ErrorCodeRegistry.maxon` is the single
// source of truth for the 4-digit code space. A number spelled anywhere else is a
// second copy of it, free to name one code here and another there.

// A SECOND source position on one diagnostic — a line the reader has to see beside
// the one the error is anchored at. `none` for the overwhelming majority.
//
// ⭐ **TWO PRODUCERS SINCE SV2, AND THEY DIFFER IN WHETHER THEY SWAP.**
// `Diagnostic.blamedAt` MOVES a library line into the note and promotes the user's
// construct to the primary slot, with fixed text. `reportPositionedWithNote` ADDS
// one: both sites are the author's, neither displaces the other, and the text is
// the caller's — a service rule fires where the method is written and has to name
// the `spawn` that made the type a service, which may be in another file.
export union DiagnosticNote
	none
	at(message String, line LineNumber, column ColumnNumber, filePath FilePath)

	function reportedUnder(origins StagedOriginIndex) returns DiagnosticNote
		return match self 'note'
			none gives DiagnosticNote.none
			at(message, line, column, filePath) gives DiagnosticNote.at(message, line: line, column: column, filePath: origins.authoredPathOf(filePath))
		end 'note'
	end 'reportedUnder'
end 'DiagnosticNote'

// The calls to undeclared functions a diagnostic rests on, when it rests on some. Compiling a
// buffer alone makes a sibling file's call opaque, so the editor drops a diagnostic whose every
// such call a sibling declares (`LspDiagnostics.theProjectDeclaresEveryCallee`). A build never
// reads it.
//
// ⚠ Attached when the diagnostic is created, never after it is reported: the sink rewrites a staged
// path to the author's (`reportedUnder`), and a cause attached later would keep the staged one.
export union DiagnosticCause
	standsAlone
	undeclaredCalls(calls SourceRangeArray, filePath FilePath)

	function reportedUnder(origins StagedOriginIndex) returns DiagnosticCause
		return match self 'cause'
			standsAlone gives DiagnosticCause.standsAlone
			undeclaredCalls(calls, filePath) gives DiagnosticCause.undeclaredCalls(calls, filePath: origins.authoredPathOf(filePath))
		end 'cause'
	end 'reportedUnder'
end 'DiagnosticCause'

// ⭐⭐ **THE USER CONSTRUCT A LIBRARY-BODY DIAGNOSTIC IS REALLY ABOUT (BLAME).**
//
// A `stdlib/` module is ordinary compiled source, so a refusal that a user's own
// program forces is raised at a line in the library — `stdlib/Array.maxon:142`,
// which no user wrote and which names neither the user's type nor the user's
// line. That is not hypothetical drift: every member struck from
// `Parser.arraySurfaceMemberNames` RELOCATES its refusals out of a dispatch arm
// and into the library body that now serves them, and `String` and `Map` retired
// by the same route.
//
// ⚖ **USER RULING:** such a diagnostic reports the USER's construct as its
// primary location and keeps the library line as a NOTE. Losing the library line
// is not the fix — it is what makes a library BUG diagnosable.
//
// The blame is produced by whichever gate consulted the user-supplied fact (only
// `Parser.requireOpaqueArrayCopyable` does today: it reads the INSTANTIATION
// registry, so the construct it is about is the instantiation the user wrote),
// carried out of the parse on `Parser.libraryBlame`, and applied by the single
// diagnostic sink `reportDiagnostic`. One producer per gate, ONE applier.
export union LibraryBlame
	unblamed
	userSite(filePath FilePath, line LineNumber, column ColumnNumber)
end 'LibraryBlame'

// What the retained library location says once the user's site has taken the
// primary slot. Written once, here, so every re-anchored diagnostic says it the
// same way and no gate has to phrase it.
let LibraryBlameNoteText = "raised inside the library, on behalf of the construct above"

// One reported problem. `line` / `column` are 1-based source positions, or 0
// when the diagnostic has no single anchor (E3001 "no main" is whole-program).
// `filePath` is the declaring file, empty when program-wide. The rendered form
// (`error <code>: <message>`) matches the `maxoncstderr` spec blocks exactly.
export type Diagnostic
	export let code as ErrorCode
	export let message as String
	export let line as LineNumber
	export let column as ColumnNumber
	export let filePath as FilePath
	export let note as DiagnosticNote
	export let cause as DiagnosticCause

	export static function create(code ErrorCode, message String, line LineNumber = 0, column ColumnNumber = 0, filePath FilePath = FilePath from "") returns Diagnostic
		return Self{code: code, message: message, line: line, column: column, filePath: filePath, note: DiagnosticNote.none, cause: DiagnosticCause.standsAlone}
	end 'create'

	// ⭐ **THE ONE PRODUCER OF A NOTED DIAGNOSTIC — the blame SWAP, in one place.**
	// The user's site becomes primary and the location this diagnostic was raised
	// at becomes the note, so nothing is lost and the reader meets their own line
	// first. `unblamed` — every diagnostic in a normal compile — returns `self`
	// untouched, so a program that forces nothing out of the library renders
	// byte-for-byte what it always did.
	export function blamedAt(blame LibraryBlame) returns Diagnostic
		match blame 'blame'
			unblamed then return self
			userSite(blamedPath, blamedLine, blamedColumn) then return Self{code: self.code, message: self.message, line: blamedLine, column: blamedColumn, filePath: blamedPath, note: DiagnosticNote.at(LibraryBlameNoteText, line: self.line, column: self.column, filePath: self.filePath), cause: self.cause}
		end 'blame'
	end 'blamedAt'

	// The same diagnostic carrying a second source position. Split from `create` because a note is the
	// exception rather than a parameter every one of the hundreds of `create` calls would have to answer —
	// and split from `blamedAt` because that one SWAPS and this one ADDS (see `reportPositionedWithNote`).
	export function withNote(second DiagnosticNote) returns Diagnostic
		return Self{code: self.code, message: self.message, line: self.line, column: self.column, filePath: self.filePath, note: second, cause: self.cause}
	end 'withNote'

	export function withCause(origin DiagnosticCause) returns Diagnostic
		return Self{code: self.code, message: self.message, line: self.line, column: self.column, filePath: self.filePath, note: self.note, cause: origin}
	end 'withCause'

	// Applied by the sink `reportDiagnostic` after `blamedAt`, so both slots a blame swap produces are
	// rewritten and neither keeps a staged path.
	export function reportedUnder(origins StagedOriginIndex) returns Diagnostic
		if origins.stagesNothing() 'nothingWasStaged'
			return self
		end 'nothingWasStaged'

		return Self{code: self.code, message: self.message, line: self.line, column: self.column, filePath: origins.authoredPathOf(self.filePath), note: self.note.reportedUnder(origins), cause: self.cause.reportedUnder(origins)}
	end 'reportedUnder'

	// Render as `error <code>: <message>` — the exact wire format the spec's
	// `maxoncstderr` blocks compare against. The code's `.rawValue` is the 4-digit
	// string.
	//
	// A POSITIONED diagnostic (one with a real source line — parser/lexer errors,
	// e.g. E2010) renders a `<file>:<line>:<col>:` prefix before the message, which
	// `variables.md`'s type-annotation tests gate on. A whole-program semantic error
	// (E3001/E3002) carries no anchor (`line == 0`), so it renders bare, exactly as
	// `basics.md` expects. `line == 0` is the discriminator because 1-based source
	// lines start at 1 — line 0 is unreachable for a real span.
	export function render() returns String
		if self.line == 0 'wholeProgram'
			return "error {self.code.rawValue}: {self.message}{self.renderedNote()}"
		end 'wholeProgram'

		return "error {self.code.rawValue}: {self.filePath.toString()}:{self.line}:{self.column}: {self.message}{self.renderedNote()}"
	end 'render'

	// A NOTE renders as a SECOND LINE below the error, `note: <file>:<line>:<col>:
	// <message>` — clang's shape, and one a `maxoncstderr` block can carry unchanged,
	// since that comparison is a whole-text equality after trimming
	// (`SpecTestRunner.checkCompilerError`) rather than a per-line match.
	function renderedNote() returns String
		match self.note 'note'
			none then return ""
			at(noteText, noteLine, noteColumn, notePath) then return "\nnote: {notePath.toString()}:{noteLine}:{noteColumn}: {noteText}"
		end 'note'
	end 'renderedNote'
end 'Diagnostic'

export typealias DiagnosticArray = Array with Diagnostic

// Driver / query-pipeline failure modes. Distinct from a `Diagnostic`: a
// `CompileError` is thrown to unwind the build, whereas diagnostics accumulate
// and are rendered. `compileError` is the catch-all raised once one or more
// diagnostics have been reported (the driver has already printed them, so its
// handler stays silent for this arm — see Main.maxon).
export union CompileError implements Error
	fileNotFound(path FilePath)
	directoryNotFound(path FilePath)
	noSourceFiles(root FilePath)
	readError(path FilePath)

	// A `build` naming several paths this compiler cannot root — either they genuinely share no
	// directory (two absolute paths on different Windows drives), or their common directory is a
	// FILESYSTEM ROOT, which `isInside` cannot answer for: it tests the prefix `dir` + separator and a
	// root already ends in one, so the narrowing walk keeps climbing and runs out of parents at the top.
	// `Compiler.commonAncestorOf` derives the project ROOT from that shared directory (and
	// `Queries.namespaceAnchorFor` measures every file's namespace from the root), so both causes leave
	// the build with no anchor it could be given: it is refused rather than rooted. Carries both ends of
	// the disagreement, because naming only one of them leaves the reader to guess which pair failed to meet.
	noCommonRoot(first FilePath, other FilePath)

	twoDriverFiles(first FilePath, second FilePath)

	nestedProjectFile(outer FilePath, nested FilePath)

	// A directory built without `--output=` whose executable has no name to take: the directory is a
	// filesystem root, and an executable is named for the directory it is built from.
	unnamedDirectory(directory FilePath)

	// An `--output=` value no `FilePath` can be made of — a URL whose scheme is not `file`, or on
	// Windows a character no filename may hold. Carries the spelling, because there is no path to name.
	invalidOutputPath(spelling String)

	// The compiler could not locate its `stdlib/` directory by walking up from its own
	// executable (see StdlibSource.locateStdlibDir). Every compile loads stdlib source and every
	// pass tells stdlib from user code by that directory, so a missing stdlib is a loud, hard
	// failure rather than a silent skip.
	stdlibNotFound

	// The compiler located `stdlib/` but not its sibling `runtime/`, or found no Maxon source there.
	// The two tiers are one library and every compile loads both, so a tree holding one without the
	// other compiles nothing — and the sentence a user needs names the directory that is missing, which
	// is why this is not `stdlibNotFound`.
	runtimeNotFound
	runtimeTierIsNotAProgram(root FilePath)
	abandoned
	compileError

	export function failure() returns CompileFailure
		return match self 'failure'
			compileError gives CompileFailure.reportedDiagnostics
			abandoned gives CompileFailure.abandoned
			fileNotFound or
				directoryNotFound or
				noSourceFiles or
				readError or
				noCommonRoot or
				twoDriverFiles or
				nestedProjectFile or
				unnamedDirectory or
				invalidOutputPath or
				stdlibNotFound or
				runtimeNotFound or
				runtimeTierIsNotAProgram gives CompileFailure.driverFailed
		end 'failure'
	end 'failure'
end 'CompileError'

export enum CompileFailure
	reportedDiagnostics
	abandoned
	driverFailed
end 'CompileFailure'

export function reportPositioned(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath, cause DiagnosticCause = DiagnosticCause.standsAlone)
	reportDiagnostic(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath).withCause(cause))
end 'reportPositioned'

export function reportAtFunctionName(project Project, func IrFunction, code ErrorCode, message String)
	reportPositioned(project, code: code, message: message, line: func.nameLine, column: func.nameColumn, filePath: func.sourceFilePath)
end 'reportAtFunctionName'

module function unneededAliasCastMessage(sourceName ByteArray, targetName ByteArray) returns String
	return unneededCastMessage("'{sourceSpelledAliasText(sourceName)}'", targetName: targetName)
end 'unneededAliasCastMessage'

module function unneededLiteralCastMessage(cast LiteralCast) returns String
	return unneededCastMessage("the literal {cast.spelledText()}", targetName: cast.target.name)
end 'unneededLiteralCastMessage'

function unneededCastMessage(repeated String, targetName ByteArray) returns String
	return "unneeded cast: {repeated} already fits in '{sourceSpelledAliasText(targetName)}'"
end 'unneededCastMessage'

// ⭐⭐ **THE SAME FUNNEL FOR A DIAGNOSTIC THAT CARRIES A SECOND SITE — the note producer that is not a BLAME
// SWAP (SV2).** `Diagnostic.blamedAt` was the only `DiagnosticNote.at` there had ever been, and it is a swap
// with FIXED text: it moves a library line into the note and puts the user's construct in the primary slot.
//
// ⭐ **THIS ONE ADDS RATHER THAN SWAPS, AND THE TEXT IS THE CALLER'S.** A service diagnostic is raised where
// the author wrote the offending line and has to name a SECOND line the author also wrote — the `spawn` that
// made the type a service, which may be in a different file entirely — so neither site displaces the other
// and the note says what the second one IS. `E3137` is its first caller; `E3139` renders one hop of a cycle
// per note.
//
// ⚠ It goes through `reportDiagnostic` like everything else, so the capture `spec-test` reads back is the
// bytes a command line would have printed — the property that sink's header rests on.
export function reportPositionedWithNote(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath, note DiagnosticNote)
	reportDiagnostic(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath).withNote(note))
end 'reportPositionedWithNote'

// One entry per diagnostic, exactly as `emit` was handed it and unterminated. An entry can span lines — a
// blamed diagnostic's `note:`, E3016's and E5001's lists — so it is never split: `emitted()` gives a
// caller one item per diagnostic, and `text()` adds the one line ending stderr would have received.
typealias CapturedDiagnosticTextArray = Array with String

enum DiagnosticDestination
	standardError
	captured
	discarded
end 'DiagnosticDestination'

// ⭐⭐ **THE ONE WRITER OF A COMPILER-FACING DIAGNOSTIC LINE — so a caller compiling IN PROCESS can
// READ exactly what a command line would have PRINTED.**
//
// `spec-test` compiles every case inside this process (G20), and a ```maxoncstderr``` block compares
// the exact text a refused compile emits. Re-rendering `project.diagnostics` at that call site would
// be a SECOND SPELLING of what the CLI prints — this tree's signature bug — so the capture is taken
// at the SINK instead, and the bytes are computed ONCE for both destinations: byte identity holds by
// CONSTRUCTION, not by two spellings happening to agree.
//
// ✅ **THE WHOLE SET ROUTES THROUGH IT.** `Project.printDiagnostics` brings every `Diagnostic`;
// `Main.reportCompileError` brings every `CompileError` arm other than `compileError` and `abandoned`,
// none of which reaches `project.diagnostics` at all. A caller that hands `reportCompileError` its
// capturing sink (`SpecTestRunner.compileOneTest`) therefore reads back what a command line would have
// written for the same build, whichever way the build failed.
export type DiagnosticSink
	let destination as DiagnosticDestination
	var capturedLines as CapturedDiagnosticTextArray

	export static function printing() returns DiagnosticSink
		return Self.to(DiagnosticDestination.standardError)
	end 'printing'

	export static function capturing() returns DiagnosticSink
		return Self.to(DiagnosticDestination.captured)
	end 'capturing'

	export static function discarding() returns DiagnosticSink
		return Self.to(DiagnosticDestination.discarded)
	end 'discarding'

	static function to (destination DiagnosticDestination) returns DiagnosticSink
		return Self{destination: destination, capturedLines: CapturedDiagnosticTextArray.create()}
	end 'to'

	export function emit(line String)
		match self.destination 'destination'
			standardError then printError(terminatedDiagnosticLine(line))
			captured then self.capturedLines.push(line)
			discarded then return
		end 'destination'
	end 'emit'

	export function emitted() returns CapturedDiagnosticTextArray
		self.requireCaptured("emitted")
		return self.capturedLines.clone()
	end 'emitted'

	export function text() returns String
		self.requireCaptured("text")

		var joined = StringBuilder.create()

		for line in self.capturedLines 'each'
			joined.append(terminatedDiagnosticLine(line))
		end 'each'

		return joined.build()
	end 'text'

	function requireCaptured(asker String)
		match self.destination 'destination'
			captured then return
			standardError or
				discarded then panic("DiagnosticSink.{asker}: this sink keeps none of what it is handed, so an empty answer here could not be told from a compile that reported nothing")
		end 'destination'
	end 'requireCaptured'
end 'DiagnosticSink'

function terminatedDiagnosticLine(line String) returns String
	return "{line}\n"
end 'terminatedDiagnosticLine'
