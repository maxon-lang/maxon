			continue
		end 'anAuthorsOwnTypeIsNotALibraryName'

		respellings.push(spelling.libraryNameRespelling())
	end 'eachSpelling'

	return ShadowRespellings.of(respellings)
end 'libraryNameRespellings'

function withIdentifierRespelled(text String, identifier ByteArray, spelling ByteArray) returns String
	let bytes = text.toByteArray()
	var respelled = ByteArray.create()
	var at = 0 as ElementIndex

	while at < bytes.count() 'eachByte'
		if identifierStandsAt(bytes, identifier: identifier, at: at) 'theIdentifier'
			respelled.append(spelling)
			at = at + identifier.count()
			continue
		end 'theIdentifier'

		respelled.push(try bytes.get(at) otherwise panic("withIdentifierRespelled: {at} is below the count the loop is bounded by"))
		at = at + 1
	end 'eachByte'

	return String.from(respelled)
end 'withIdentifierRespelled'

module function textMentionsIdentifier(text String, identifier ByteArray) returns bool
	let bytes = text.toByteArray()

	for at in 0 upto bytes.count() 'eachByte'
		if identifierStandsAt(bytes, identifier: identifier, at: at) 'mentioned'
			return true
		end 'mentioned'
	end 'eachByte'

	return false
end 'textMentionsIdentifier'

function identifierStandsAt(bytes ByteArray, identifier ByteArray, at ElementIndex) returns bool
	let past = at + identifier.count()

	if past > bytes.count() 'runsOffTheEnd'
		return false
	end 'runsOffTheEnd'

	for (iter, expected) in identifier.withIterator() 'eachIdentifierByte'
		if (try bytes.get(at + iter.index()) otherwise panic("identifierStandsAt: {at + iter.index()} is below `past`, which is within the text")) != expected 'differs'
			return false
		end 'differs'
	end 'eachIdentifierByte'

	if at > 0 and continuesAName(try bytes.get(at - 1) otherwise panic("identifierStandsAt: {at - 1} precedes an index within the text"), identifier: identifier) 'continuesAnEarlierName'
		return false
	end 'continuesAnEarlierName'

	if past < bytes.count() and isMintNameByte(try bytes.get(past) otherwise panic("identifierStandsAt: {past} is below the text's count")) 'continuesIntoALongerName'
		return false
	end 'continuesIntoALongerName'

	return true
end 'identifierStandsAt'

function continuesAName(before Byte, identifier ByteArray) returns bool
	if before == '.' and identifier.contains(AuthorMintSeparatorByte as Byte) 'aMintShownQualified'
		return false
	end 'aMintShownQualified'

	return isMintNameByte(before) or before == '.'
end 'continuesAName'

// A mint is `~`-joined words, so the separator is a name byte: a shorter mint (`b~Box`) is never a
// standalone word inside a longer one (`a~b~Box`).
function isMintNameByte(b Byte) returns bool
	return isAlphaNum(b) or b == AuthorMintSeparatorByte as Byte
end 'isMintNameByte'

// ⭐⭐ **THE USER CONSTRUCT A LIBRARY-BODY DIAGNOSTIC IS REALLY ABOUT (BLAME).**
//
// A `stdlib/` module is ordinary compiled source, so a refusal that a user's own
// program forces is raised at a line in the library — `stdlib/Array.maxon:142`,
// which no user wrote and which names neither the user's type nor the user's
// line.
//
// ⚖ **USER RULING:** such a diagnostic reports the USER's construct as its
// primary location and keeps the library line as a NOTE. Losing the library line
// is not the fix — it is what makes a library BUG diagnosable.
//
// The blame is produced by whichever gate consulted the user-supplied fact
// (`Parser.blameLibraryRefusalOnInstantiation`: it reads the INSTANTIATION
// registry, so the construct it is about is the instantiation the user wrote),
// carried out of the parse on `Parser.libraryBlame`, and applied by the single
// diagnostic sink `reportDiagnostic`. One producer per gate, ONE applier.
export union LibraryBlame
	unblamed
	userSite(filePath FilePath, line LineNumber, column ColumnNumber)
end 'LibraryBlame'

// What the retained library location says once the user's site has taken the
// primary slot. Written once, here, so every re-anchored diagnostic says it the
// same way and no gate has to phrase it.
let LibraryBlameNoteText = "raised inside the library, on behalf of the construct above"

export typealias DiagnosticLine = int(1 to u64.max) implements LineNumber
export typealias DiagnosticColumn = int(1 to u64.max) implements ColumnNumber

export union DiagnosticAnchor
	programWide
	file(filePath FilePath)
	at(filePath FilePath, line DiagnosticLine, column DiagnosticColumn)

	function reportedUnder(origins StagedOriginIndex) returns DiagnosticAnchor
		return match self 'anchor'
			programWide gives DiagnosticAnchor.programWide
			file(filePath) gives DiagnosticAnchor.file(origins.authoredPathOf(filePath))
			at(filePath, line, column) gives DiagnosticAnchor.at(origins.authoredPathOf(filePath), line: line, column: column)
		end 'anchor'
	end 'reportedUnder'

	function respellings(programWide ShadowRespellings, respellingsOf ShadowRespellingsOf) returns ShadowRespellings
		return match self 'anchor'
			programWide gives programWide
			file(filePath) gives respellingsOf(filePath)
			at(filePath, _, _) gives respellingsOf(filePath)
		end 'anchor'
	end 'respellings'

	export function isProgramWide() returns bool
		return match self 'anchor'
			programWide gives true
			file or
			at gives false
		end 'anchor'
	end 'isProgramWide'

	export function anchoredFile() returns FilePath throws AbsentError
		match self 'anchor'
			programWide then throw AbsentError.absent
			file(filePath) then return filePath
			at(filePath, _, _) then return filePath
		end 'anchor'
	end 'anchoredFile'

	function renderedPosition() returns String
		return match self 'anchor'
			programWide or
			file gives ""
			at(filePath, line, column) gives "{filePath.toString()}:{line}:{column}: "
		end 'anchor'
	end 'renderedPosition'
end 'DiagnosticAnchor'

// @generated library-cache begin
function cacheWriteDiagnosticAnchor(writer LibraryCacheWriter, value DiagnosticAnchor)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		programWide then break
		file(a0) then cacheWriteDiagnosticAnchorFile(writer, a0: a0)
		at(a0, a1, a2) then cacheWriteDiagnosticAnchorAt(writer, a0: a0, a1: a1, a2: a2)
	end 'payload'
end 'cacheWriteDiagnosticAnchor'

function cacheWriteDiagnosticAnchorFile(writer LibraryCacheWriter, a0 FilePath)
	writer.text(a0.toString())
end 'cacheWriteDiagnosticAnchorFile'

function cacheWriteDiagnosticAnchorAt(writer LibraryCacheWriter, a0 FilePath, a1 DiagnosticLine, a2 DiagnosticColumn)
	writer.text(a0.toString())
	writer.unsigned(a1 as CacheUnsigned)
	writer.unsigned(a2 as CacheUnsigned)
end 'cacheWriteDiagnosticAnchorAt'

function cacheReadDiagnosticAnchor(reader LibraryCacheReader) returns DiagnosticAnchor throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives DiagnosticAnchor.programWide
		1 gives try cacheReadDiagnosticAnchorFile(reader)
		2 gives try cacheReadDiagnosticAnchorAt(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadDiagnosticAnchor'

function cacheReadDiagnosticAnchorFile(reader LibraryCacheReader) returns DiagnosticAnchor throws LibraryCacheDamage
	let a0 = try reader.path()

	return DiagnosticAnchor.file(a0)
end 'cacheReadDiagnosticAnchorFile'

function cacheReadDiagnosticAnchorAt(reader LibraryCacheReader) returns DiagnosticAnchor throws LibraryCacheDamage
	let a0 = try reader.path()
	let a1 = (try reader.boundedUnsigned(1, high: u64.max)) as DiagnosticLine
	let a2 = (try reader.boundedUnsigned(1, high: u64.max)) as DiagnosticColumn

	return DiagnosticAnchor.at(a0, line: a1, column: a2)
end 'cacheReadDiagnosticAnchorAt'

// @generated library-cache end

export type Diagnostic
	export let code as ErrorCode
	export let message as String
	export let anchor as DiagnosticAnchor
	export let note as DiagnosticNote

	export static function programWide(code ErrorCode, message String) returns Diagnostic
		return Self.anchored(code, message: message, anchor: DiagnosticAnchor.programWide)
	end 'programWide'

	export static function inFile(code ErrorCode, message String, filePath FilePath) returns Diagnostic
		return Self.anchored(code, message: message, anchor: DiagnosticAnchor.file(filePath))
	end 'inFile'

	export static function create(code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath) returns Diagnostic
		if line == 0 or column == 0 'noSourcePosition'
			panic("Diagnostic.create: {code.rawValue} was handed line {line}, column {column}, which is no source position — a diagnostic with no line is `Diagnostic.programWide` or `Diagnostic.inFile`. The message was: {message}")
		end 'noSourcePosition'

		if filePath.isEmpty() 'noSourceFile'
			panic("Diagnostic.create: {code.rawValue} at {line}:{column} was handed no file — a position is a line in some file")
		end 'noSourceFile'

		return Self.anchored(code, message: message, anchor: DiagnosticAnchor.at(filePath, line: line as DiagnosticLine, column: column as DiagnosticColumn))
	end 'create'

	static function anchored(code ErrorCode, message String, anchor DiagnosticAnchor) returns Diagnostic
		return Self{code: code, message: message, anchor: anchor, note: DiagnosticNote.none}
	end 'anchored'

	// ⭐ **THE ONE PRODUCER OF A NOTED DIAGNOSTIC — the blame SWAP, in one place.**
	// The user's site becomes primary and the location this diagnostic was raised
	// at becomes the note, so nothing is lost and the reader meets their own line
	// first. `unblamed` — every diagnostic in a normal compile — returns `self`
	// untouched, so a program that forces nothing out of the library renders
	// byte-for-byte what it always did.
	export function blamedAt(blame LibraryBlame) returns Diagnostic
		match blame 'blame'
			unblamed then return self
			userSite(blamedPath, blamedLine, blamedColumn) then return Self{code: self.code, message: self.message, anchor: DiagnosticAnchor.at(blamedPath, line: blamedLine as DiagnosticLine, column: blamedColumn as DiagnosticColumn), note: self.libraryBlameNote()}
		end 'blame'
	end 'blamedAt'

	function libraryBlameNote() returns DiagnosticNote
		match self.anchor 'raisedAt'
			at(filePath, line, column) then return DiagnosticNote.at(LibraryBlameNoteText, line: line, column: column, filePath: filePath)
			programWide or
			file then panic("Diagnostic.blamedAt: {self.code.rawValue} was raised at no library line, so there is no library site to keep as the blame note")
		end 'raisedAt'
	end 'libraryBlameNote'

	// The same diagnostic carrying a second source position. Split from `create` because a note is the
	// exception rather than a parameter every one of the hundreds of `create` calls would have to answer —
	// and split from `blamedAt` because that one SWAPS and this one ADDS (see `reportPositionedWithNote`).
	export function withNote(second DiagnosticNote) returns Diagnostic
		return Self{code: self.code, message: self.message, anchor: self.anchor, note: second}
	end 'withNote'

	// Applied by the sink `reportDiagnostic` after `blamedAt`, so both slots a blame swap produces are
	// rewritten and neither keeps a staged path.
	export function reportedUnder(origins StagedOriginIndex) returns Diagnostic
		if origins.stagesNothing() 'nothingWasStaged'
			return self
		end 'nothingWasStaged'

		return Self{code: self.code, message: self.message, anchor: self.anchor.reportedUnder(origins), note: self.note.reportedUnder(origins)}
	end 'reportedUnder'

	export function respelledFor(programWide ShadowRespellings, respellingsOf ShadowRespellingsOf) returns Diagnostic
		return Self{code: self.code, message: self.anchor.respellings(programWide, respellingsOf: respellingsOf).respell(self.message), anchor: self.anchor, note: self.note.respelledFor(respellingsOf)}
	end 'respelledFor'

	// Render as `error <code>: <message>` — the exact wire format the spec's
	// `maxoncstderr` blocks compare against. The code's `.rawValue` is the 4-digit
	// string.
	export function render() returns String
		return "error {self.code.rawValue}: {self.anchor.renderedPosition()}{self.message}{self.renderedNote()}"
	end 'render'

	// A NOTE renders as a SECOND LINE below the error, `note: <file>:<line>:<col>:
	// <message>` — clang's shape, and one a `maxoncstderr` block can carry unchanged,
	// since that comparison is a whole-text equality after trimming
	// (`SpecTestRunner.checkCompilerError`) rather than a per-line match.
	function renderedNote() returns String
		match self.note 'note'
			none then return ""
			at(noteText, noteLine, noteColumn, notePath) then return "\nnote: {notePath.toString()}:{noteLine}:{noteColumn}: {noteText}"
		end 'note'
	end 'renderedNote'

	// @generated library-cache begin
	module function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.code.ordinal as CacheUnsigned)
		writer.text(self.message)
		cacheWriteDiagnosticAnchor(writer, value: self.anchor)
		cacheWriteDiagnosticNote(writer, value: self.note)
	end 'cacheWrite'

	module static function cacheRead(reader LibraryCacheReader) returns Diagnostic throws LibraryCacheDamage
		let f_code = try cacheReadErrorCode(reader)
		let f_message = try reader.text()
		let f_anchor = try cacheReadDiagnosticAnchor(reader)
		let f_note = try cacheReadDiagnosticNote(reader)

		return Self{code: f_code, message: f_message, anchor: f_anchor, note: f_note}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize32
		return sizeof(Diagnostic) as CacheSize32
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'Diagnostic'

export typealias DiagnosticArray = Array with Diagnostic

// @generated library-cache begin
module function cacheWriteDiagnosticArray(writer LibraryCacheWriter, value DiagnosticArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteDiagnosticArray'

module function cacheReadDiagnosticArray(reader LibraryCacheReader) returns DiagnosticArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = DiagnosticArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try Diagnostic.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadDiagnosticArray'

// @generated library-cache end

// Driver / query-pipeline failure modes. Distinct from a `Diagnostic`: a
// `CompileError` is thrown to unwind the build, whereas diagnostics accumulate
// and are rendered. `compileError` is the catch-all raised once one or more
// diagnostics have been reported (the driver has already printed them, so its
// handler stays silent for this arm — see Main.maxon).
export union CompileError implements Error
	fileNotFound(path FilePath)
	directoryNotFound(path FilePath)
	noSourceFiles(root FilePath)
	readError(path FilePath)

	// A `build` naming several paths this compiler cannot root — either they genuinely share no
	// directory (two absolute paths on different Windows drives), or their common directory is a
	// FILESYSTEM ROOT, which `isInside` cannot answer for: it tests the prefix `dir` + separator and a
	// root already ends in one, so the narrowing walk keeps climbing and runs out of parents at the top.
	// `Compiler.commonAncestorOf` derives the project ROOT from that shared directory (and
	// `Queries.namespaceAnchorFor` measures every file's namespace from the root), so both causes leave
	// the build with no anchor it could be given: it is refused rather than rooted. Carries both ends of
	// the disagreement, because naming only one of them leaves the reader to guess which pair failed to meet.
	noCommonRoot(first FilePath, other FilePath)

	twoDriverFiles(first FilePath, second FilePath)

	nestedProjectFile(outer FilePath, nested FilePath)

	// A directory built without `--output=` whose executable has no name to take: the directory is a
	// filesystem root, and an executable is named for the directory it is built from.
	unnamedDirectory(directory FilePath)

	// An `--output=` value no `FilePath` can be made of — a URL whose scheme is not `file`, or on
	// Windows a character no filename may hold. Carries the spelling, because there is no path to name.
	invalidOutputPath(spelling String)

	// The compiler could not locate its `stdlib/` directory by walking up from its own
	// executable (see StdlibSource.locateStdlibDir). Every compile loads stdlib source and every
	// pass tells stdlib from user code by that directory, so a missing stdlib is a loud, hard
	// failure rather than a silent skip.
	stdlibNotFound

	// The compiler located `stdlib/` but not its sibling `runtime/`, or found no Maxon source there.
	// The two tiers are one library and every compile loads both, so a tree holding one without the
	// other compiles nothing — and the sentence a user needs names the directory that is missing, which
	// is why this is not `stdlibNotFound`.
	runtimeNotFound
	runtimeTierIsNotAProgram(root FilePath)
	runtimeIrNameAbsent(name String)
	unidentifiablePath(reason String)
	runtimeIrNameIsProgramFunction(name String, declaredIn FilePath)
	abandoned
	compileError

	export function failure() returns CompileFailure
		return match self 'failure'
			compileError gives CompileFailure.reportedDiagnostics
			abandoned gives CompileFailure.abandoned
			fileNotFound or
			directoryNotFound or
			noSourceFiles or
			readError or
			noCommonRoot or
			twoDriverFiles or
			nestedProjectFile or
			unnamedDirectory or
			invalidOutputPath or
			stdlibNotFound or
			runtimeNotFound or
			runtimeTierIsNotAProgram or
			runtimeIrNameAbsent or
			unidentifiablePath or
			runtimeIrNameIsProgramFunction gives CompileFailure.driverFailed
		end 'failure'
	end 'failure'
end 'CompileError'

export enum CompileFailure
	reportedDiagnostics
	abandoned
	driverFailed
end 'CompileFailure'

export function reportPositioned(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath)
	reportDiagnostic(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath))
end 'reportPositioned'

// A target refusal is about the target, not the program, and a language error is the author's to fix
// first: parked here, it is reported by `SemanticCheck.reportTargetRefusals` only into a program with no
// other diagnostic.
export function deferTargetRefusal(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath)
	project.targetRefusalDiagnostics.push(Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath))
end 'deferTargetRefusal'

// The one rule for every deferred list: stacked on a real complaint, a deferred diagnostic would make one
// mistake read as two.
module function reportDeferredUnlessErrors(project Project, deferred DiagnosticArray) returns bool
	if deferred.count() == 0 or projectHasErrors(project) 'nothingToSayOrSomethingRealerSaidIt'
		return false
	end 'nothingToSayOrSomethingRealerSaidIt'

	for diagnostic in deferred 'each'
		reportDiagnostic(project, diagnostic: diagnostic)
	end 'each'

	return true
end 'reportDeferredUnlessErrors'

export function reportAtFunctionName(project Project, func IrFunction, code ErrorCode, message String)
	reportPositioned(project, code: code, message: message, line: func.nameLine, column: func.nameColumn, filePath: func.sourceFilePath)
end 'reportAtFunctionName'

module function unneededAliasCastMessage(sourceName ByteArray, targetName ByteArray) returns String
	return unneededCastMessage("'{sourceSpelledAliasText(sourceName)}'", fits: unneededCastTarget(targetName))
end 'unneededAliasCastMessage'

module function unneededLiteralCastMessage(cast LiteralCast) returns String
	return unneededCastMessage("the literal {cast.spelledText()}", fits: unneededCastTarget(cast.target.name))
end 'unneededLiteralCastMessage'

module function unneededLetCastMessage(cast LiteralCast, name ByteArray) returns String
	return unneededCastMessage("the literal {cast.spelledText()}", fits: "every use of '{String.from(name)}'")
end 'unneededLetCastMessage'

function unneededCastTarget(targetName ByteArray) returns String
	return "in '{sourceSpelledAliasText(targetName)}'"
end 'unneededCastTarget'

function unneededCastMessage(repeated String, fits String) returns String
	return "unneeded cast: {repeated} already fits {fits}"
end 'unneededCastMessage'

// ⭐⭐ **THE SAME FUNNEL FOR A DIAGNOSTIC THAT CARRIES A SECOND SITE — the note producer that is not a BLAME
// SWAP.** `Diagnostic.blamedAt` is a swap with FIXED text: it moves a library line into the note
// and puts the user's construct in the primary slot.
//
// ⭐ **THIS ONE ADDS RATHER THAN SWAPS, AND THE TEXT IS THE CALLER'S.** A service diagnostic is raised where
// the author wrote the offending line and has to name a SECOND line the author also wrote — the `spawn` that
// made the type a service, which may be in a different file entirely — so neither site displaces the other
// and the note says what the second one IS. `E3137` is its first caller; `E3139` renders one hop of a cycle
// per note.
//
// ⚠ It goes through `reportDiagnostic` like everything else, so the capture `spec-test` reads back is the
// bytes a command line would have printed — the property that sink's header rests on.
export function reportPositionedWithNote(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath, note DiagnosticNote)
	reportDiagnostic(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath).withNote(note))
end 'reportPositionedWithNote'

// One entry per diagnostic, exactly as `emit` was handed it and unterminated. An entry can span lines — a
// blamed diagnostic's `note:`, E3016's and E5001's lists — so it is never split: `emitted()` gives a
// caller one item per diagnostic, and `text()` adds the one line ending stderr would have received.
export typealias CapturedDiagnosticTextArray = Array with String

enum DiagnosticDestination
	standardError
	captured
	discarded
end 'DiagnosticDestination'

// ⭐⭐ **THE ONE WRITER OF A COMPILER-FACING DIAGNOSTIC LINE — so a caller compiling IN PROCESS can
// READ exactly what a command line would have PRINTED.**
//
// `spec-test` compiles every case inside this process, and a ```maxoncstderr``` block compares
// the exact text a refused compile emits. Re-rendering `project.diagnostics` at that call site would
// be a SECOND SPELLING of what the CLI prints — this tree's signature bug — so the capture is taken
// at the SINK instead, and the bytes are computed ONCE for both destinations: byte identity holds by
// CONSTRUCTION, not by two spellings happening to agree.
//
// ✅ **THE WHOLE SET ROUTES THROUGH IT.** `Project.printDiagnostics` brings every `Diagnostic`;
// `Main.reportCompileError` brings every `CompileError` arm other than `compileError` and `abandoned`,
// none of which reaches `project.diagnostics` at all. A caller that hands `reportCompileError` its
// capturing sink (`SpecTestRunner.compileOneTest`) therefore reads back what a command line would have
// written for the same build, whichever way the build failed.
export type DiagnosticSink
	let destination as DiagnosticDestination
	var capturedLines as CapturedDiagnosticTextArray

	export static function printing() returns DiagnosticSink
		return Self.to(DiagnosticDestination.standardError)
	end 'printing'

	export static function capturing() returns DiagnosticSink
		return Self.to(DiagnosticDestination.captured)
	end 'capturing'

	export static function discarding() returns DiagnosticSink
		return Self.to(DiagnosticDestination.discarded)
	end 'discarding'

	static function to(destination DiagnosticDestination) returns DiagnosticSink
		return Self{destination: destination, capturedLines: CapturedDiagnosticTextArray.create()}
	end 'to'

	export function emit(line String)
		match self.destination 'destination'
			standardError then printError(terminatedDiagnosticLine(line))
			captured then self.capturedLines.push(line)
			discarded then return
		end 'destination'
	end 'emit'

	export function emitted() returns CapturedDiagnosticTextArray
		self.requireCaptured("emitted")
		return self.capturedLines.clone()
	end 'emitted'

	export function text() returns String
		self.requireCaptured("text")

		var joined = StringBuilder.create()

		for line in self.capturedLines 'each'
			joined.append(terminatedDiagnosticLine(line))
		end 'each'

		return joined.build()
	end 'text'

	function requireCaptured(asker String)
		match self.destination 'destination'
			captured then return
			standardError or
			discarded then panic("DiagnosticSink.{asker}: this sink keeps none of what it is handed, so an empty answer here could not be told from a compile that reported nothing")
		end 'destination'
	end 'requireCaptured'
end 'DiagnosticSink'

function terminatedDiagnosticLine(line String) returns String
	return "{line}\n"
end 'terminatedDiagnosticLine'
