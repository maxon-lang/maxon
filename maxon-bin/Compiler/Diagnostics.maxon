		let f_shown = freeze try reader.bytes()

		return Self{minted: f_minted, shown: f_shown}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(ShadowRespelling) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'ShadowRespelling'

