export type ShadowSpellingRoster
	export let spellings as StdlibShadowSpellingArray
	export let mints as WrittenMintSet
	let authorRespellings as ShadowRespellings
	let libraryCodeRespellings as ShadowRespellings
	let positionByMint as SpellingPositionByMint

	export static function of(spellings StdlibShadowSpellingArray) returns ShadowSpellingRoster
		let mints = WrittenMintSet.create()
		let positionByMint = SpellingPositionByMint.create()

		for (iter, spelling) in spellings.withIterator() 'eachSpelling'
			mints.insert(spelling.minted)

			if not positionByMint.contains(spelling.minted) 'firstSpellingOfThisMint'
				positionByMint.upsert(spelling.minted, value: iter.index())
			end 'firstSpellingOfThisMint'
		end 'eachSpelling'

		return Self{spellings: spellings, mints: mints, authorRespellings: shadowRespellings(spellings, reader: ShadowSpellingReader.authorCode, written: WrittenMintSet.create()), libraryCodeRespellings: shadowRespellings(spellings, reader: ShadowSpellingReader.libraryCode, written: WrittenMintSet.create()), positionByMint: positionByMint}
	end 'of'

	export function respellingsFor(reader ShadowSpellingReader) returns ShadowRespellings
		return match reader 'reader'
			authorCode gives self.authorRespellings
			libraryCode gives self.libraryCodeRespellings
		end 'reader'
	end 'respellingsFor'

	export static function none() returns ShadowSpellingRoster
		return Self.of(StdlibShadowSpellingArray.create(0))
	end 'none'

	export function bareSpellingOf(name immutable ByteArray) returns immutable ByteArray
		let position = try self.positionByMint.get(name) otherwise return name
		let spelling = try self.spellings.get(position) otherwise panic("ShadowSpellingRoster.bareSpellingOf: spellings.get OOB at {position} of {self.spellings.count()} spellings, a position the roster indexed")

		return spelling.bareName()
	end 'bareSpellingOf'

	export function authorBareSpellingOf(name immutable ByteArray) returns immutable ByteArray
		if not name.contains(AuthorMintSeparatorByte as Byte) 'notMintedByTheAuthorsDirectory'
			return name
		end 'notMintedByTheAuthorsDirectory'

		return self.bareSpellingOf(name)
	end 'authorBareSpellingOf'

	export function authorSpelledName(name ByteArray) returns ByteArray
		if self.spellings.isEmpty() 'nothingIsRenamed'
			return name
		end 'nothingIsRenamed'

		return self.authorSpelledText(String.from(name)).toByteArray()
	end 'authorSpelledName'

	export function authorSpelledText(text String) returns String
		return self.authorRespellings.respell(text)
	end 'authorSpelledText'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteStdlibShadowSpellingArray(writer, value: self.spellings)
		cacheWriteWrittenMintSet(writer, value: self.mints)
		self.authorRespellings.cacheWrite(writer)
		self.libraryCodeRespellings.cacheWrite(writer)
		cacheWriteSpellingPositionByMint(writer, value: self.positionByMint)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns ShadowSpellingRoster throws LibraryCacheDamage
		let f_spellings = try cacheReadStdlibShadowSpellingArray(reader)
		let f_mints = try cacheReadWrittenMintSet(reader)
		let f_authorRespellings = try ShadowRespellings.cacheRead(reader)
		let f_libraryCodeRespellings = try ShadowRespellings.cacheRead(reader)
		let f_positionByMint = try cacheReadSpellingPositionByMint(reader)

		return Self{spellings: f_spellings, mints: f_mints, authorRespellings: f_authorRespellings, libraryCodeRespellings: f_libraryCodeRespellings, positionByMint: f_positionByMint}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize40
		return sizeof(ShadowSpellingRoster) as CacheSize40
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'ShadowSpellingRoster'

function shadowRespellings(spellings StdlibShadowSpellingArray, reader ShadowSpellingReader, written WrittenMintSet) returns ShadowRespellings
	let respellings = ShadowRespellingArray.create(0)

	for spelling in spellings 'eachSpelling'
		if written.contains(spelling.minted) 'theFileSpellsItItself'
			continue
		end 'theFileSpellsItItself'

		respellings.push(ShadowRespelling.create(spelling.minted, shown: spelling.spellingFor(reader)))
	end 'eachSpelling'

	return ShadowRespellings.of(respellings)
end 'shadowRespellings'

function libraryNameRespellings(spellings StdlibShadowSpellingArray) returns ShadowRespellings
	let respellings = ShadowRespellingArray.create(0)

	for spelling in spellings 'eachSpelling'
		if spelling.isAuthorNominal() 'anAuthorsOwnTypeIsNotALibraryName'
			continue
		end 'anAuthorsOwnTypeIsNotALibraryName'

		respellings.push(spelling.libraryNameRespelling())
	end 'eachSpelling'

	return ShadowRespellings.of(respellings)
end 'libraryNameRespellings'

function withIdentifierRespelled(text String, identifier ByteArray, spelling ByteArray) returns String
	let bytes = text.toByteArray()
	let respelled = ByteArray.create(0)
	var at = 0 as ElementIndex

	while at < bytes.count() 'eachByte'
		if identifierStandsAt(bytes, identifier: identifier, at: at) 'theIdentifier'
			respelled.append(spelling)
			at = at + identifier.count()
			continue
		end 'theIdentifier'

		respelled.push(try bytes.get(at) otherwise panic("withIdentifierRespelled: {at} is below the count the loop is bounded by"))
		at = at + 1
	end 'eachByte'

	return String.from(respelled)
end 'withIdentifierRespelled'

function textMentionsIdentifier(text String, identifier ByteArray) returns bool
	let bytes = text.toByteArray()

	for at in 0 upto bytes.count() 'eachByte'
		if identifierStandsAt(bytes, identifier: identifier, at: at) 'mentioned'
			return true
		end 'mentioned'
	end 'eachByte'

	return false
end 'textMentionsIdentifier'

function identifierStandsAt(bytes ByteArray, identifier ByteArray, at ElementIndex) returns bool
	let past = at + identifier.count()

	if past > bytes.count() 'runsOffTheEnd'
		return false
	end 'runsOffTheEnd'

	for (iter, expected) in identifier.withIterator() 'eachIdentifierByte'
		if (try bytes.get(at + iter.index()) otherwise panic("identifierStandsAt: {at + iter.index()} is below `past`, which is within the text")) != expected 'differs'
			return false
		end 'differs'
	end 'eachIdentifierByte'

	if at > 0 and continuesAName(try bytes.get(at - 1) otherwise panic("identifierStandsAt: {at - 1} precedes an index within the text"), identifier: identifier) 'continuesAnEarlierName'
		return false
	end 'continuesAnEarlierName'

	if past < bytes.count() and isMintNameByte(try bytes.get(past) otherwise panic("identifierStandsAt: {past} is below the text's count")) 'continuesIntoALongerName'
		return false
	end 'continuesIntoALongerName'

	return true
end 'identifierStandsAt'

function continuesAName(before Byte, identifier ByteArray) returns bool
	if before == '.' and identifier.contains(AuthorMintSeparatorByte as Byte) 'aMintShownQualified'
		return false
	end 'aMintShownQualified'

	return isMintNameByte(before) or before == '.'
end 'continuesAName'

// A mint is `~`-joined words, so the separator is a name byte: a shorter mint (`b~Box`) is never a
// standalone word inside a longer one (`a~b~Box`).
function isMintNameByte(b Byte) returns bool
	return isAlphaNum(b) or b == AuthorMintSeparatorByte as Byte
end 'isMintNameByte'

// ⭐⭐ **THE USER CONSTRUCT A LIBRARY-BODY DIAGNOSTIC IS REALLY ABOUT (BLAME).**
//
// A `stdlib/` module is ordinary compiled source, so a refusal that a user's own
// program forces is raised at a line in the library — `stdlib/Array.maxon:142`,
// which no user wrote and which names neither the user's type nor the user's
// line.
//
// ⚖ **USER RULING:** such a diagnostic reports the USER's construct as its
// primary location and keeps the library line as a NOTE. Losing the library line
// is not the fix — it is what makes a library BUG diagnosable.
//
// The blame is produced by whichever gate consulted the user-supplied fact
// (`Parser.blameLibraryRefusalOnInstantiation`: it reads the INSTANTIATION
// registry, so the construct it is about is the instantiation the user wrote),
// carried out of the parse on `Parser.libraryBlame`, and applied by the single
// diagnostic sink `reportDiagnostic`. One producer per gate, ONE applier.
export union LibraryBlame
	unblamed
	userSite(filePath FilePath, line LineNumber, column ColumnNumber)
end 'LibraryBlame'

// @generated library-cache begin
function cacheWriteLibraryBlame(writer LibraryCacheWriter, value LibraryBlame)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		unblamed then break
		userSite(a0, a1, a2) then cacheWriteLibraryBlameUserSite(writer, a0: a0, a1: a1, a2: a2)
	end 'payload'
end 'cacheWriteLibraryBlame'

function cacheWriteLibraryBlameUserSite(writer LibraryCacheWriter, a0 FilePath, a1 LineNumber, a2 ColumnNumber)
	writer.text(a0.toString())
	writer.unsigned(a1 as CacheUnsigned)
	writer.unsigned(a2 as CacheUnsigned)
end 'cacheWriteLibraryBlameUserSite'

function cacheReadLibraryBlame(reader LibraryCacheReader) returns LibraryBlame throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives LibraryBlame.unblamed
		1 gives try cacheReadLibraryBlameUserSite(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadLibraryBlame'

function cacheReadLibraryBlameUserSite(reader LibraryCacheReader) returns LibraryBlame throws LibraryCacheDamage
	let a0 = try reader.path()
	let a1 = (try reader.unsigned()) as LineNumber
	let a2 = (try reader.unsigned()) as ColumnNumber

	return LibraryBlame.userSite(a0, line: a1, column: a2)
end 'cacheReadLibraryBlameUserSite'

// @generated library-cache end

// What the retained library location says once the user's site has taken the
// primary slot. Written once, here, so every re-anchored diagnostic says it the
// same way and no gate has to phrase it.
let LibraryBlameNoteText = "raised inside the library, on behalf of the construct above"

export typealias DiagnosticLine = int(1 to u64.max) implements LineNumber
export typealias DiagnosticColumn = int(1 to u64.max) implements ColumnNumber

export union DiagnosticAnchor
	programWide
	file(filePath FilePath)
	at(filePath FilePath, line DiagnosticLine, column DiagnosticColumn)

	function reportedUnder(origins StagedOriginIndex) returns DiagnosticAnchor
		return match self 'anchor'
			programWide gives DiagnosticAnchor.programWide
			file(filePath) gives DiagnosticAnchor.file(origins.authoredPathOf(filePath))
			at(filePath, line, column) gives DiagnosticAnchor.at(origins.authoredPathOf(filePath), line: line, column: column)
		end 'anchor'
	end 'reportedUnder'

	function respellings(programWide ShadowRespellings, respellingsOf ShadowRespellingsOf) returns ShadowRespellings
		return match self 'anchor'
			programWide gives programWide
			file(filePath) gives respellingsOf(filePath)
			at(filePath, _, _) gives respellingsOf(filePath)
		end 'anchor'
	end 'respellings'

	export function isProgramWide() returns bool
		return match self 'anchor'
			programWide gives true
			file or
			at gives false
		end 'anchor'
	end 'isProgramWide'

	export function anchoredFile() returns FilePath throws AbsentError
		match self 'anchor'
			programWide then throw AbsentError.absent
			file(filePath) then return filePath
			at(filePath, _, _) then return filePath
		end 'anchor'
	end 'anchoredFile'

	function renderedPosition() returns String
		return match self 'anchor'
			programWide or
			file gives ""
			at(filePath, line, column) gives "{filePath.toString()}:{line}:{column}: "
		end 'anchor'
	end 'renderedPosition'
