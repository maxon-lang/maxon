	// filesystem root, and an executable is named for the directory it is built from.
	unnamedDirectory(directory FilePath)

	// An `--output=` value no `FilePath` can be made of — a URL whose scheme is not `file`, or on
	// Windows a character no filename may hold. Carries the spelling, because there is no path to name.
	invalidOutputPath(spelling String)

	// The compiler could not locate its `stdlib/` directory by walking up from its own
	// executable (see StdlibSource.locateStdlibDir). Every compile loads stdlib source and every
	// pass tells stdlib from user code by that directory, so a missing stdlib is a loud, hard
	// failure rather than a silent skip.
	stdlibNotFound

	// The compiler located `stdlib/` but not its sibling `runtime/`, or found no Maxon source there.
	// The two tiers are one library and every compile loads both, so a tree holding one without the
	// other compiles nothing — and the sentence a user needs names the directory that is missing, which
	// is why this is not `stdlibNotFound`.
	runtimeNotFound
	sourceOrderUnrecognized(text String)
	sourceNotReorderable(path FilePath, line LineNumber)
	runtimeTierIsNotAProgram(root FilePath)
	runtimeIrNameAbsent(name String)
	unidentifiablePath(reason String)
	runtimeIrNameIsProgramFunction(name String, declaredIn FilePath)
	abandoned
	compileError

	export function refusesTheSourceOrder() returns bool
		return match self 'failure'
			sourceNotReorderable gives true
			compileError or
			abandoned or
			fileNotFound or
			directoryNotFound or
			noSourceFiles or
			readError or
			noCommonRoot or
			twoDriverFiles or
			nestedProjectFile or
			unnamedDirectory or
			invalidOutputPath or
			stdlibNotFound or
			runtimeNotFound or
			sourceOrderUnrecognized or
			runtimeTierIsNotAProgram or
			runtimeIrNameAbsent or
			unidentifiablePath or
			runtimeIrNameIsProgramFunction gives false
		end 'failure'
	end 'refusesTheSourceOrder'

	export function failure() returns CompileFailure
		return match self 'kind'
			compileError gives CompileFailure.reportedDiagnostics
			abandoned gives CompileFailure.abandoned
			fileNotFound or
			directoryNotFound or
			noSourceFiles or
			readError or
			noCommonRoot or
			twoDriverFiles or
			nestedProjectFile or
			unnamedDirectory or
			invalidOutputPath or
			stdlibNotFound or
			runtimeNotFound or
			sourceOrderUnrecognized or
			sourceNotReorderable or
			runtimeTierIsNotAProgram or
			runtimeIrNameAbsent or
			unidentifiablePath or
			runtimeIrNameIsProgramFunction gives CompileFailure.driverFailed
		end 'kind'
	end 'failure'
end 'CompileError'

export enum CompileFailure
	reportedDiagnostics
	abandoned
	driverFailed
end 'CompileFailure'

function reportPositioned(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath, fix DiagnosticFix = DiagnosticFix.none)
	reportDiagnostic(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath).withFix(fix))
end 'reportPositioned'

enum SecondaryFlush
	beforeLowering
	beforeBackend
end 'SecondaryFlush'

union FindingStanding
	primary
	secondary(flush SecondaryFlush)
end 'FindingStanding'

// A secondary finding prints only while no primary error stands: stacked on one it would make one
// mistake read as two, and the primary error alone keeps the program from compiling.
function findingStandingOf(code ErrorCode) returns FindingStanding
	if code == ErrorCode.semanticUnneededCast or isTargetRefusal(code) 'beforeLowering'
		return FindingStanding.secondary(SecondaryFlush.beforeLowering)
	end 'beforeLowering'

	if code == ErrorCode.semanticUnusedVariable or code == ErrorCode.semanticVarShouldBeLet or code == ErrorCode.semanticTiedPromiseRefused or code == ErrorCode.semanticPromiseDropped or code == ErrorCode.semanticLinearValueNotConsumed 'beforeBackend'
		return FindingStanding.secondary(SecondaryFlush.beforeBackend)
	end 'beforeBackend'

	return FindingStanding.primary
end 'findingStandingOf'

function isTargetRefusal(code ErrorCode) returns bool
	return code == ErrorCode.targetUnsupportedConstruct or code == ErrorCode.semanticSubprocessUnsupportedTarget
end 'isTargetRefusal'

function fileSecondary(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath, fix DiagnosticFix = DiagnosticFix.none)
	fileSecondaryFinding(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath).withFix(fix))
end 'fileSecondary'

function fileSecondaryFinding(project Project, diagnostic Diagnostic)
	match secondaryFlushOf(diagnostic.code) 'dueAt'
		beforeLowering or
		beforeBackend then break
	end 'dueAt'

	project.secondaryDiagnostics.push(diagnostic)
end 'fileSecondaryFinding'

function resetSecondaryFindings(project Project)
	project.secondaryDiagnostics = DiagnosticArray.create(0)
end 'resetSecondaryFindings'

function reportSecondaryFindings(project Project, flush SecondaryFlush) returns bool
	if projectHasErrors(project) 'aPrimaryErrorStands'
		return false
	end 'aPrimaryErrorStands'

	return reportFindingsDueAt(project, flush: flush)
end 'reportSecondaryFindings'

function reportFindingsDueAt(project Project, flush SecondaryFlush) returns bool
	var reported = false

	for diagnostic in project.secondaryDiagnostics 'eachFinding'
		if secondaryFlushOf(diagnostic.code) != flush 'dueAtAnotherFlush'
			continue
		end 'dueAtAnotherFlush'

		reportDiagnostic(project, diagnostic: diagnostic)
		reported = true
	end 'eachFinding'

	return reported
end 'reportFindingsDueAt'

function secondaryFlushOf(code ErrorCode) returns SecondaryFlush
	match findingStandingOf(code) 'standing'
		primary then panic("secondaryFlushOf: {code.rawValue} is a primary finding and never sits on the secondary roster")
		secondary(flush) then return flush
	end 'standing'
end 'secondaryFlushOf'

export union FunctionDisplay
	named(name String)
	closure(site String)

	export function quoted() returns String
		return match self 'display'
			named(name) gives "'{name}'"
			closure(site) gives site
		end 'display'
	end 'quoted'

	export function bare() returns String
		return match self 'display'
			named(name) gives name
			closure(site) gives site
		end 'display'
	end 'bare'

	export function memberQuoted() returns String
		return match self 'display'
			named(name) gives "'{String.from(unqualifiedMemberName(name.toByteArray()))}'"
			closure(site) gives site
		end 'display'
	end 'memberQuoted'
end 'FunctionDisplay'

function closureSiteDisplay(authoredPath FilePath, line LineNumber, column ColumnNumber) returns FunctionDisplay
	return FunctionDisplay.closure("the closure at {authoredPath.toString()}:{line}:{column}")
end 'closureSiteDisplay'

function reportAtFunctionName(project Project, func IrFunction, code ErrorCode, message String, fix DiagnosticFix = DiagnosticFix.none)
	reportPositioned(project, code: code, message: message, line: func.nameLine, column: func.nameColumn, filePath: func.sourceFilePath, fix: fix)
end 'reportAtFunctionName'

function letReassignedMessage(name String) returns String
	return "'{name}' is a let and cannot be reassigned"
end 'letReassignedMessage'

function letFieldReassignedMessage(name String) returns String
	return "'{name}' is a let field and cannot be reassigned"
end 'letFieldReassignedMessage'

function unneededAliasCastMessage(sourceName ByteArray, targetName ByteArray) returns String
	return unneededCastMessage("'{sourceSpelledAliasText(sourceName)}'", fits: unneededCastTarget(targetName))
end 'unneededAliasCastMessage'

function unneededLiteralCastMessage(cast LiteralCast) returns String
	return unneededCastMessage("the literal {cast.spelledText()}", fits: unneededCastTarget(cast.target.name))
end 'unneededLiteralCastMessage'

function unneededLetCastMessage(cast LiteralCast, name ByteArray) returns String
	return unneededCastMessage("the literal {cast.spelledText()}", fits: "every use of '{String.from(name)}'")
end 'unneededLetCastMessage'

function unneededCastTarget(targetName ByteArray) returns String
	return "in '{sourceSpelledAliasText(targetName)}'"
end 'unneededCastTarget'

function unneededCastMessage(repeated String, fits String) returns String
	return "unneeded cast: {repeated} already fits {fits}"
end 'unneededCastMessage'

// One entry per diagnostic, exactly as `emit` was handed it and unterminated. An entry can span lines — a
// blamed diagnostic's `note:`, E3016's and E5001's lists — so it is never split: `emitted()` gives a
// caller one item per diagnostic, and `text()` adds the one line ending stderr would have received.
export typealias CapturedDiagnosticTextArray = Array with String

export enum DiagnosticDestination
	standardError
	captured
	discarded
end 'DiagnosticDestination'

// ⭐⭐ **THE ONE WRITER OF A COMPILER-FACING DIAGNOSTIC LINE — so a caller compiling IN PROCESS can
// READ exactly what a command line would have PRINTED.**
//
// `spec-test` compiles every case inside this process, and a ```maxoncstderr``` block compares
// the exact text a refused compile emits. Re-rendering `project.diagnostics` at that call site would
// be a SECOND SPELLING of what the CLI prints — this tree's signature bug — so the capture is taken
// at the SINK instead, and the bytes are computed ONCE for both destinations: byte identity holds by
// CONSTRUCTION, not by two spellings happening to agree.
//
// ✅ **THE WHOLE SET ROUTES THROUGH IT.** `Project.printDiagnostics` brings every `Diagnostic`;
// `Main.reportCompileError` brings every `CompileError` arm other than `compileError` and `abandoned`,
// none of which reaches `project.diagnostics` at all. A caller that hands `reportCompileError` its
// capturing sink (`SpecTestRunner.compileOneTest`) therefore reads back what a command line would have
// written for the same build, whichever way the build failed.
export type DiagnosticSink
	export let destination as DiagnosticDestination
	export var capturedLines as CapturedDiagnosticTextArray

	export static function printing() returns DiagnosticSink
		return Self.to(DiagnosticDestination.standardError)
	end 'printing'

	export static function capturing() returns DiagnosticSink
		return Self.to(DiagnosticDestination.captured)
	end 'capturing'

	export static function discarding() returns DiagnosticSink
		return Self.to(DiagnosticDestination.discarded)
	end 'discarding'

	export static function to(destination DiagnosticDestination) returns DiagnosticSink
		return Self{destination: destination, capturedLines: CapturedDiagnosticTextArray.create(0)}
	end 'to'

	export function emit(line String)
		match self.destination 'destination'
			standardError then printError(terminatedDiagnosticLine(line))
			captured then self.capturedLines.push(line)
			discarded then return
		end 'destination'
	end 'emit'

	export function emitted() returns CapturedDiagnosticTextArray
		self.requireCaptured("emitted")
		return self.capturedLines.clone()
	end 'emitted'

	export function absorb(lines CapturedDiagnosticTextArray)
		for line in lines 'eachLine'
			self.emit(line)
		end 'eachLine'
	end 'absorb'

	export function text() returns String
		self.requireCaptured("text")

		let joined = StringBuilder.create()

		for line in self.capturedLines 'each'
			joined.append(terminatedDiagnosticLine(line))
		end 'each'

		return joined.build()
	end 'text'

	function requireCaptured(asker String)
		match self.destination 'destination'
			captured then return
			standardError or
			discarded then panic("DiagnosticSink.{asker}: this sink keeps none of what it is handed, so an empty answer here could not be told from a compile that reported nothing")
		end 'destination'
	end 'requireCaptured'
end 'DiagnosticSink'

function terminatedDiagnosticLine(line String) returns String
	return "{line}\n"
end 'terminatedDiagnosticLine'

extension Project
	// A whole-program claim is withheld from the buffer, so beside one alone the secondary findings are
	// published. Only the before-lowering flush has run: those claims stop the build before the Std tier.
	function reportSecondaryFindingsBesideClaims()
		if self.onlyWholeProgramClaimsStand() 'noRealErrorStands'
			_ = reportFindingsDueAt(self, flush: SecondaryFlush.beforeLowering)
		end 'noRealErrorStands'
	end 'reportSecondaryFindingsBesideClaims'

	function onlyWholeProgramClaimsStand() returns bool
		if self.diagnostics.isEmpty() 'nothingStands'
			return false
		end 'nothingStands'

		for diagnostic in self.diagnostics 'eachStanding'
			if not claimsAboutTheWholeProgram(diagnostic.code) 'aRealError'
				return false
			end 'aRealError'
		end 'eachStanding'

		return true
	end 'onlyWholeProgramClaimsStand'
end 'Project'

// A single-buffer compile cannot honestly publish a whole-program claim: it holds one file plus the
// library tiers, so each claim here is true of what this server compiled and false of the program the
// author is editing. "This program declares no entry point" would sit on the first line of every
// library file an editor opens. The unused-declaration family (E3092, E3219, E3062) says nothing else in
// the program references a declaration, and none of the program's other files is in this compile. The
// corpus does not rescue either: it is lexed and folded, never checked. The project check compiles
// every file, so it withholds only the missing-`main` claim (`withholdsAsAWholeProgramClaim`).
//
// ⚠ A member is added by measurement, never by guessing. Suppressing a diagnostic that is genuinely
// about this file hides a real error, which is worse than the squiggle it removes; the leading digit
// cannot stand in for the question, because it names the stage that raised a diagnostic rather than
// the scope it claims.
function claimsAboutTheWholeProgram(code ErrorCode) returns bool
	return code == ErrorCode.noMainFunction or code == ErrorCode.semanticUnusedExportedSymbol or code == ErrorCode.semanticUnusedUnexportedDeclaration or code == ErrorCode.semanticUnusedTypeAlias
end 'claimsAboutTheWholeProgram'
