// Diagnostics — the compiler's user-facing error channel, plus the driver-level
// `CompileError` the query/build pipeline throws.
//
// A `Diagnostic` is a code + message + optional source position + optional repair, accumulated on
// `Project.diagnostics` by every reporting pass. The driver prints them and bails.
//
// The `ErrorCode` enum itself is NOT here: `ErrorCodeRegistry.maxon` is the single
// source of truth for the 4-digit code space. A number spelled anywhere else is a
// second copy of it, free to name one code here and another there.

export enum ShadowSpellingReader
	authorCode
	libraryCode
end 'ShadowSpellingReader'

// A name the compiler minted to keep a stdlib declaration apart from another of the same name
// (`SignatureIndex.settleStdlibShadowSpellings`). No reader wrote `minted`, so text shown to a
// reader carries `spellingFor` instead.
export type StdlibShadowSpelling
	export let minted as immutable ByteArray
	let qualified as immutable ByteArray
	export let bare as immutable ByteArray

	export static function create(minted ByteArray, qualified ByteArray, bare ByteArray) returns StdlibShadowSpelling
		return Self{minted: minted, qualified: qualified, bare: bare}
	end 'create'

	export function spellingFor(reader ShadowSpellingReader) returns immutable ByteArray
		return match reader 'reader'
			authorCode gives self.qualified
			libraryCode gives self.bare
		end 'reader'
	end 'spellingFor'

	function libraryNameRespelling() returns ShadowRespelling
		return ShadowRespelling.create(self.bare, shown: self.qualified)
	end 'libraryNameRespelling'

	function isAuthorNominal() returns bool
		return self.minted.contains(AuthorMintSeparatorByte as Byte)
	end 'isAuthorNominal'

	function bareName() returns immutable ByteArray
		return self.bare
	end 'bareName'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.minted)
		writer.bytes(self.qualified)
		writer.bytes(self.bare)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns StdlibShadowSpelling throws LibraryCacheDamage
		let f_minted = freeze try reader.bytes()
		let f_qualified = freeze try reader.bytes()
		let f_bare = freeze try reader.bytes()

		return Self{minted: f_minted, qualified: f_qualified, bare: f_bare}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize24
		return sizeof(StdlibShadowSpelling) as CacheSize24
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'StdlibShadowSpelling'

export typealias StdlibShadowSpellingArray = Array with StdlibShadowSpelling

// @generated library-cache begin
function cacheWriteStdlibShadowSpellingArray(writer LibraryCacheWriter, value StdlibShadowSpellingArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteStdlibShadowSpellingArray'

function cacheReadStdlibShadowSpellingArray(reader LibraryCacheReader) returns StdlibShadowSpellingArray throws LibraryCacheDamage
	let count = try reader.count()
	let result = StdlibShadowSpellingArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try StdlibShadowSpelling.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadStdlibShadowSpellingArray'

// @generated library-cache end

type ShadowRespelling
	let minted as immutable ByteArray
	let shown as immutable ByteArray

	static function create(minted ByteArray, shown ByteArray) returns ShadowRespelling
		return Self{minted: minted, shown: shown}
	end 'create'

	function mintedName() returns immutable ByteArray
		return self.minted
	end 'mintedName'

	function mintedLength() returns ElementIndex
		return self.minted.count()
	end 'mintedLength'

	function beginsAtAWordStart() returns bool
		return identifierWordEnd(self.minted, from: 0) > 0
	end 'beginsAtAWordStart'

	function standsAt(bytes ByteArray, at ElementIndex) returns bool
		return identifierStandsAt(bytes, identifier: self.minted, at: at)
	end 'standsAt'

	function respell(text String) returns String
		return withIdentifierRespelled(text, identifier: self.minted, spelling: self.shown)
	end 'respell'

