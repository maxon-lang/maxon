// Diagnostics — the compiler's user-facing error channel, plus the driver-level
// `CompileError` the query/build pipeline throws.
//
// A `Diagnostic` is a code + message + optional source position, accumulated on
// `Project.diagnostics` by every reporting pass. The driver prints them and bails.
//
// The `ErrorCode` enum itself is NOT here: `ErrorCodeRegistry.maxon` is the single
// source of truth for the 4-digit code space. A number spelled anywhere else is a
// second copy of it, free to name one code here and another there.

// A SECOND source position on one diagnostic — a line the reader has to see beside
// the one the error is anchored at. `none` for the overwhelming majority.
//
// ⭐ **TWO PRODUCERS, AND THEY DIFFER IN WHETHER THEY SWAP.**
// `Diagnostic.blamedAt` MOVES a library line into the note and promotes the user's
// construct to the primary slot, with fixed text. `reportPositionedWithNote` ADDS
// one: both sites are the author's, neither displaces the other, and the text is
// the caller's — a service rule fires where the method is written and has to name
// the `spawn` that made the type a service, which may be in another file.
export union DiagnosticNote
	none
	at(message String, line LineNumber, column ColumnNumber, filePath FilePath)

	function reportedUnder(origins StagedOriginIndex) returns DiagnosticNote
		return match self 'note'
			none gives DiagnosticNote.none
			at(message, line, column, filePath) gives DiagnosticNote.at(message, line: line, column: column, filePath: origins.authoredPathOf(filePath))
		end 'note'
	end 'reportedUnder'

	function respelledFor(respellingsOf ShadowRespellingsOf) returns DiagnosticNote
		return match self 'note'
			none gives DiagnosticNote.none
			at(message, line, column, filePath) gives DiagnosticNote.at(respellingsOf(filePath).respell(message), line: line, column: column, filePath: filePath)
		end 'note'
	end 'respelledFor'
end 'DiagnosticNote'

// @generated library-cache begin
function cacheWriteDiagnosticNote(writer LibraryCacheWriter, value DiagnosticNote)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		none then break
		at(a0, a1, a2, a3) then cacheWriteDiagnosticNoteAt(writer, a0: a0, a1: a1, a2: a2, a3: a3)
	end 'payload'
end 'cacheWriteDiagnosticNote'

function cacheWriteDiagnosticNoteAt(writer LibraryCacheWriter, a0 String, a1 LineNumber, a2 ColumnNumber, a3 FilePath)
	writer.text(a0)
	writer.unsigned(a1 as CacheUnsigned)
	writer.unsigned(a2 as CacheUnsigned)
	writer.text(a3.toString())
end 'cacheWriteDiagnosticNoteAt'

function cacheReadDiagnosticNote(reader LibraryCacheReader) returns DiagnosticNote throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives DiagnosticNote.none
		1 gives try cacheReadDiagnosticNoteAt(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadDiagnosticNote'

function cacheReadDiagnosticNoteAt(reader LibraryCacheReader) returns DiagnosticNote throws LibraryCacheDamage
	let a0 = try reader.text()
	let a1 = (try reader.unsigned()) as LineNumber
	let a2 = (try reader.unsigned()) as ColumnNumber
	let a3 = try reader.path()

	return DiagnosticNote.at(a0, line: a1, column: a2, filePath: a3)
end 'cacheReadDiagnosticNoteAt'

