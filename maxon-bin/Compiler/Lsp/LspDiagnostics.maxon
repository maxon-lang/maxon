// `textDocument/publishDiagnostics` — the compiler's own diagnostics, pushed to the editor. It is a
// server-initiated notification, so it has no `LspMethod` case; `LspMethod.maxon`'s header says
// why.
//
// An empty array is the answer that clears the squiggles. A document with no problems, and a
// document that has just been closed, both publish `[]`; a server that published nothing in those
// cases would leave the last errors it reported standing in the editor.

let PublishDiagnosticsMethod = "textDocument/publishDiagnostics"

// The members LSP defines on `PublishDiagnosticsParams` and on `Diagnostic`. The `range` and the `uri`
// are the protocol's shared structures and are spelled in `LspMessage.maxon` with every other reader of
// them.
let DiagnosticsKey = "diagnostics"
let DiagnosticSeverityKey = "severity"
let DiagnosticCodeKey = "code"
let DiagnosticSourceKey = "source"

// ⚠ NOT `LspMessage.maxon`'s `JsonRpcErrorMessageKey`, which is the JSON-RPC ERROR object's member.
// Two protocol members that agree on a spelling today are still two members.
let DiagnosticMessageKey = "message"

// LSP's `DiagnosticSeverity` — the protocol's own numbers, which an editor draws a colour from.
typealias LspDiagnosticSeverity = int(1 to 4)

// ⭐ **EVERY DIAGNOSTIC THIS COMPILER PRODUCES IS AN ERROR, AND THAT IS A PROPERTY OF `Diagnostic`
// RATHER THAN A CHOICE MADE HERE.** It carries no severity field, and `projectHasErrors` fails a build
// on a non-empty sink — so there is no warning tier for a second case to read.
let LspErrorSeverity = 1 as LspDiagnosticSeverity

// What an editor groups and filters these by.
let DiagnosticSourceName = "maxon"

let DiagnosticNameQuote = "'"
let QuotedNameSegment = 1

// ⚠ A document that could not be checked publishes nothing, and an empty array would be a wrong
// answer. `[]` is a positive claim — "this document has no problems" — while a server that could
// not locate `stdlib/`, or was handed a uri spelling no path, has checked nothing and knows
// nothing. Saying nothing leaves the editor showing what it already had, which is what "not
// checked" looks like.
module function publishBufferDiagnostics(uri String, text String, arrival BufferArrival) returns BufferPublish
	let path = try FilePath.from(uri) otherwise return BufferPublish.unchecked

	match lspDocumentProject(path, content: text) 'buffer'
		loaded(project, reader) then return project.publishDocumentDiagnostics(uri, reader: reader, arrival: arrival, path: path, text: text)
		unavailable then return BufferPublish.unchecked
	end 'buffer'
end 'publishBufferDiagnostics'

module union BufferPublish
	published(reader LspReaderSearch, root WorkspaceRoot, path FilePath, fast DiagnosticArray)
	unchecked
end 'BufferPublish'

module enum BufferArrival
	opened
	edited
end 'BufferArrival'

union BufferParse
	refused(reported DiagnosticArray)
	compilable
end 'BufferParse'

union SweptParse
	parsed(published DiagnosticArray)
	bufferHasBeenTypedInto
	unavailable
end 'SweptParse'

union DiagnosticSubject
	named(name ByteArray, index ElementIndex)
	unattributable
end 'DiagnosticSubject'

union SubjectDeclaration
	declared(declFilePath FilePath)
	undeclared
end 'SubjectDeclaration'

union RefusalRoad
	aCleanParsesCheck
	aModifiedBuffersParse
end 'RefusalRoad'

typealias SiblingVerdictMap = Map with (ByteArray, bool)

// Tell the editor this document has nothing on it — the notification a closed document is owed.
module function clearPublishedDiagnostics(uri String)
	lspOutputWriter().write(diagnosticsNotificationText(uri, items: JsonNodeIdArray.create(), doc: JsonDoc.create()))
end 'clearPublishedDiagnostics'

// ⚖ **THESE STEPS ARE THE PROJECT'S OWN, WHICH IS WHAT LETS A `match` PAYLOAD REACH THEM.** The compile
// writes the project, and a method writing its own receiver is legal on a binding nothing may write from
// outside; the same work spelled `publishCheckedDiagnostics(project: project)` hands that payload to a
// parameter the callee writes, which is E3019.
extension Project
	function publishDocumentDiagnostics(uri String, reader LspReaderSearch, arrival BufferArrival, path FilePath, text String) returns BufferPublish
		// Built before the check: a correction then reuses the held project, and the
		// `maxon/projectLoading` pair reaches the client ahead of this document's diagnostics.
		match arrival 'arrival'
			opened then lspLoadProject(reader)
			edited then break
		end 'arrival'

		let root = workspaceRootOf(reader, purpose: RootPurpose.readsTheDocument)
		let tokens = lspDocumentTokens(text, keywords: self.keywords)

		let fast = self.documentDiagnostics(reader, root: root, path: path, text: text, tokens: tokens)
		lspOutputWriter().write(documentDiagnosticsText(uri, text: text, tokens: tokens, diagnostics: fast, path: path, unbuilt: StringArray.create()))

		return BufferPublish.published(reader, root: root, path: path, fast: fast)
	end 'publishDocumentDiagnostics'

	function documentDiagnostics(reader LspReaderSearch, root WorkspaceRoot, path FilePath, text String, tokens TokenArray) returns DiagnosticArray
		match projectLayoutOf(reader) 'layout'
			nestedIn(outer) then return [nestedProjectFileDiagnostic(outer, nested: path)]
			standsAlone then break
		end 'layout'

		match root 'stating'
			projectDirectory or
				libraryTier then break
			singleFile then return self.checkedDiagnostics()
		end 'stating'

		match self.bufferParse(path) 'parse'
			compilable then return self.correctedCheck(reader, root: root, buffer: path, text: text, tokens: tokens)
			refused(reported) then return self.correctedRefusal(reported, reader: reader, root: root, buffer: path, text: text, tokens: tokens)
		end 'parse'
	end 'documentDiagnostics'

	function checkedDiagnostics() returns DiagnosticArray
		_ = checkWithoutWriting(self)

		return self.diagnostics.clone()
	end 'checkedDiagnostics'

	function correctedCheck(reader LspReaderSearch, root WorkspaceRoot, buffer FilePath, text String, tokens TokenArray) returns DiagnosticArray
		let reported = thisDocumentsOwn(self.checkedDiagnostics(), path: buffer)

		if reported.isEmpty() 'nothingToExplain'
			return reported
		end 'nothingToExplain'

		return self.explainedByTheCorpus(reported, reader: reader, root: root, buffer: buffer, text: text, tokens: tokens)
	end 'correctedCheck'

	function explainedByTheCorpus(reported DiagnosticArray, reader LspReaderSearch, root WorkspaceRoot, buffer FilePath, text String, tokens TokenArray) returns DiagnosticArray
		match lspProjectCorpus(reader, root: root) 'corpus'
			loaded(_, signatures, readerPath) then return self.unsuppressedRefusals(reported, signatures: signatures, reader: readerPath, buffer: buffer, text: text, tokens: tokens, road: RefusalRoad.aCleanParsesCheck)
			unavailable then return reported
		end 'corpus'
	end 'explainedByTheCorpus'

	// ⚠ A parse stops at its FIRST refusal — `FileParseOutcome.failed` carries one error — so an error
	// BELOW a name-dependent one is never raised at all, and no filter downstream can recover it.
	function bufferParse(path FilePath) returns BufferParse
		let before = self.diagnostics.count()

		_ = try queryParseOps(self, path: path) otherwise return BufferParse.compilable

		if self.diagnostics.count() == before 'parsedCleanly'
			return BufferParse.compilable
		end 'parsedCleanly'

		let reported = try self.diagnostics.slice(before, endIndex: self.diagnostics.count()) otherwise panic("bufferParse: `before` is this very array's earlier count, so it bounds a slice of it")

		self.diagnostics.clear()

		return BufferParse.refused(thisDocumentsOwn(reported, path: path))
	end 'bufferParse'

	function correctedRefusal(reported DiagnosticArray, reader LspReaderSearch, root WorkspaceRoot, buffer FilePath, text String, tokens TokenArray) returns DiagnosticArray
		match lspProjectCorpus(reader, root: root) 'corpus'
			loaded(corpus, signatures, readerPath) then return self.refusalCorrectedBy(corpus, signatures: signatures, reader: readerPath, buffer: buffer, reported: reported, text: text, tokens: tokens)
			unavailable then return reported
		end 'corpus'
	end 'correctedRefusal'

	function refusalCorrectedBy(corpus Project, signatures ProgramSignatures, reader FilePath, buffer FilePath, reported DiagnosticArray, text String, tokens TokenArray) returns DiagnosticArray
		let live = try queryActiveTokens(self, path: buffer) otherwise return reported

		match corpus.sweptParseDiagnostics(reader, signatures: signatures, live: live) 'sweptParse'
			parsed(published) then return published
			unavailable then return reported
			bufferHasBeenTypedInto then return self.unsuppressedRefusals(reported, signatures: signatures, reader: reader, buffer: buffer, text: text, tokens: tokens, road: RefusalRoad.aModifiedBuffersParse)
		end 'sweptParse'
	end 'refusalCorrectedBy'

	function sweptParseDiagnostics(reader FilePath, signatures ProgramSignatures, live TokenArray) returns SweptParse
		let swept = try queryActiveTokens(self, path: reader) otherwise return SweptParse.unavailable

		if not tokenStreamsAgree(live, swept: swept) 'theAuthorHasTyped'
			return SweptParse.bufferHasBeenTypedInto
		end 'theAuthorHasTyped'

		let query = try parseQueryOf(self, path: reader) otherwise return SweptParse.unavailable

		return match query 'query'
			memoized(artifact) gives SweptParse.parsed(artifact.diagnostics)
			needed(job, sweptTokens, overrides, stamp) gives self.landedSweptParse(job, tokens: sweptTokens, overrides: overrides, stamp: stamp, signatures: signatures, reader: reader)
		end 'query'
	end 'sweptParseDiagnostics'

	function landedSweptParse(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable, stamp ParseStamp, signatures ProgramSignatures, reader FilePath) returns SweptParse
		self.diagnostics.clear()

		let artifact = landParseOutcome(self, path: reader, outcome: parseFile(job, tokens: tokens, overrides: overrides, signatures: signatures), stamp: stamp)
		var published = self.diagnostics.clone()
		published.append(artifact.diagnostics)

		return SweptParse.parsed(published)
	end 'landedSweptParse'

	function unsuppressedRefusals(reported DiagnosticArray, signatures ProgramSignatures, reader FilePath, buffer FilePath, text String, tokens TokenArray, road RefusalRoad) returns DiagnosticArray
		if reported.isEmpty() 'nothingToAttribute'
			return reported
		end 'nothingToAttribute'

		let own = try queryProgramSignatures(self) otherwise return reported
		let document = HoverDocument.ofTokens(text, tokens: tokens, keywords: self.keywords, corpus: LspCorpus.unavailable)
		var verdicts = SiblingVerdictMap.create()
		var kept = DiagnosticArray.create()

		for diagnostic in reported 'eachRefusal'
			if theProjectDeclaresTheRefusedName(diagnostic, verdicts: verdicts, buffer: buffer, document: document, tokens: tokens, corpus: signatures, reader: reader, own: own) 'blindToASibling'
				continue
			end 'blindToASibling'

			kept.push(diagnostic)
		end 'eachRefusal'

		return refusalsThisRoadMayPublish(kept, road: road, verdicts: verdicts, buffer: buffer, document: document, tokens: tokens, corpus: signatures, reader: reader, own: own)
	end 'unsuppressedRefusals'
end 'Project'

module function documentDiagnosticsText(uri String, text String, tokens TokenArray, diagnostics DiagnosticArray, path FilePath, unbuilt StringArray) returns String
	var doc = JsonDoc.create()
	let index = LspLineIndex.build(text)
	var items = JsonNodeIdArray.create()

	for diagnostic in thisDocumentsOwn(diagnostics, path: path) 'each'
		items.push(diagnosticNode(doc, diagnostic: diagnostic, source: text, index: index, tokens: tokens))
	end 'each'

	for failure in unbuilt 'eachFailure'
		items.push(unbuiltProjectNode(doc, failure: failure, source: text, index: index))
	end 'eachFailure'

	return diagnosticsNotificationText(uri, items: items, doc: doc)
end 'documentDiagnosticsText'

function thisDocumentsOwn(diagnostics DiagnosticArray, path FilePath) returns DiagnosticArray
	var kept = DiagnosticArray.create()

	for diagnostic in diagnostics 'each'
		if claimsAboutTheWholeProgram(diagnostic.code) or not reportsOn(diagnostic, path: path) 'notThisDocuments'
			continue
		end 'notThisDocuments'

		kept.push(diagnostic)
	end 'each'

	return kept
end 'thisDocumentsOwn'

module function attributedTo(diagnostics DiagnosticArray, path FilePath, alone DiagnosticArray) returns DiagnosticArray
	var kept = DiagnosticArray.create()

	for diagnostic in thisDocumentsOwn(diagnostics, path: path) 'each'
		if diagnostic.anchor.isProgramWide() and not raisedAmong(diagnostic, others: alone) 'reportedOverTheWholeProject'
			continue
		end 'reportedOverTheWholeProject'

		kept.push(diagnostic)
	end 'each'

	return kept
end 'attributedTo'

function raisedAmong(diagnostic Diagnostic, others DiagnosticArray) returns bool
	for other in others 'eachOther'
		if other.anchor.isProgramWide() and other.code == diagnostic.code and other.message == diagnostic.message 'theSamePositionlessClaim'
			return true
		end 'theSamePositionlessClaim'
	end 'eachOther'

	return false
end 'raisedAmong'

function tokenStreamsAgree(live TokenArray, swept TokenArray) returns bool
	if live.count() != swept.count() 'differentLengths'
		return false
	end 'differentLengths'

	for (iter, token) in live.withIterator() 'eachToken'
		let sweptToken = try swept.get(iter.index()) otherwise panic("tokenStreamsAgree: the two streams were compared equal in length one line above, so {iter.index()} indexes both")

		if token.kind != sweptToken.kind or token.line != sweptToken.line or token.column != sweptToken.column or not token.value.equals(sweptToken.value) 'differsHere'
			return false
		end 'differsHere'
	end 'eachToken'

	return true
end 'tokenStreamsAgree'

// ⛔⛔ **THE FAMILY FILTER IS THE PRICE OF BLINDNESS, AND IT APPLIES ONLY WHERE THE COMPILE WAS BLIND.**
// A modified buffer is compiled alone, so a name only a sibling declares is a name it could not resolve —
// and once one such name is in the file, every refusal downstream of it is suspect, not just the ones
// `theProjectDeclaresTheRefusedName` could attribute. But a modified buffer that resolved every name it
// used is not blind at all, and filtering there would mute the author's own errors while they type. So the
// scope is asked first, and only then is the answer narrowed to what is true of this file's text alone.
function refusalsThisRoadMayPublish(kept DiagnosticArray, road RefusalRoad, verdicts SiblingVerdictMap, buffer FilePath, document HoverDocument, tokens TokenArray, corpus ProgramSignatures, reader FilePath, own ProgramSignatures) returns DiagnosticArray
	match road 'road'
		aCleanParsesCheck then return kept
		aModifiedBuffersParse then break
	end 'road'

	if kept.isEmpty() 'nothingSurvivedTheOracle'
		return kept
	end 'nothingSurvivedTheOracle'

	if not aNameOnlyTheProjectDeclares(tokens, verdicts: verdicts, buffer: buffer, document: document, corpus: corpus, reader: reader, own: own) 'sawEveryNameItUsed'
		return kept
	end 'sawEveryNameItUsed'

	return refusalsTrueOfTheBuffersOwnText(kept)
end 'refusalsThisRoadMayPublish'

function aNameOnlyTheProjectDeclares(tokens TokenArray, verdicts SiblingVerdictMap, buffer FilePath, document HoverDocument, corpus ProgramSignatures, reader FilePath, own ProgramSignatures) returns bool
	for (iter, token) in tokens.withIterator() 'eachToken'
		let index = iter.index()

		if token.kind != TokenKind.identifier or lspCursorNamesAMember(tokens, cursor: index) 'notANameThisFileHadToResolve'
			continue
		end 'notANameThisFileHadToResolve'

		if settledVerdictFor(token.value, verdicts: verdicts, index: index, buffer: buffer, document: document, corpus: corpus, reader: reader, own: own) 'onlyTheProjectHasIt'
			return true
		end 'onlyTheProjectHasIt'
	end 'eachToken'

	return false
end 'aNameOnlyTheProjectDeclares'

// ⚠ No confident subject means PUBLISH: a diagnostic nothing can be attributed to is shown rather than
// dropped, because a suppression that guesses hides a real error and a squiggle that survives does not.
function theProjectDeclaresTheRefusedName(diagnostic Diagnostic, verdicts SiblingVerdictMap, buffer FilePath, document HoverDocument, tokens TokenArray, corpus ProgramSignatures, reader FilePath, own ProgramSignatures) returns bool
	match diagnostic.cause 'cause'
		standsAlone then return theProjectDeclaresTheSubject(diagnosticSubject(diagnostic, tokens: tokens), verdicts: verdicts, buffer: buffer, document: document, corpus: corpus, reader: reader, own: own)
		undeclaredCalls(calls, filePath) then return theProjectDeclaresEveryCallee(calls, filePath: filePath, verdicts: verdicts, buffer: buffer, document: document, tokens: tokens, corpus: corpus, reader: reader, own: own)
	end 'cause'
end 'theProjectDeclaresTheRefusedName'

// Each undeclared call is judged exactly as the E3004 at that call is, and one that no sibling
// declares keeps the diagnostic.
function theProjectDeclaresEveryCallee(calls SourceRangeArray, filePath FilePath, verdicts SiblingVerdictMap, buffer FilePath, document HoverDocument, tokens TokenArray, corpus ProgramSignatures, reader FilePath, own ProgramSignatures) returns bool
	if not namesTheSameFile(filePath, other: buffer) 'anotherFilesCalls'
		return false
	end 'anotherFilesCalls'

	if calls.isEmpty() 'noCallToAttribute'
		panic("theProjectDeclaresEveryCallee: a diagnostic caused by undeclared calls names none of them — `SemanticCheck.deferralCause` answers `standsAlone` rather than an empty list")
	end 'noCallToAttribute'

	for call in calls 'eachUndeclaredCall'
		if not theProjectDeclaresTheSubject(subjectAnchoredAt(tokens, line: call.line, column: call.column), verdicts: verdicts, buffer: buffer, document: document, corpus: corpus, reader: reader, own: own) 'declaredNowhereElse'
			return false
		end 'declaredNowhereElse'
	end 'eachUndeclaredCall'

	return true
end 'theProjectDeclaresEveryCallee'

function theProjectDeclaresTheSubject(subject DiagnosticSubject, verdicts SiblingVerdictMap, buffer FilePath, document HoverDocument, corpus ProgramSignatures, reader FilePath, own ProgramSignatures) returns bool
	match subject 'subject'
		unattributable then return false
		named(name, index) then return settledVerdictFor(name, verdicts: verdicts, index: index, buffer: buffer, document: document, corpus: corpus, reader: reader, own: own)
	end 'subject'
end 'theProjectDeclaresTheSubject'

function settledVerdictFor(name ByteArray, verdicts SiblingVerdictMap, index ElementIndex, buffer FilePath, document HoverDocument, corpus ProgramSignatures, reader FilePath, own ProgramSignatures) returns bool
	if let settled = try verdicts.get(name) 'askedAlready'
		return settled
	end 'askedAlready'

	let verdict = declaredOutsideTheReader(corpus, name: name, reader: reader) and not theBufferBindsTheName(name, index: index, document: document, own: own, buffer: buffer)
	verdicts.upsert(name, value: verdict)

	return verdict
end 'settledVerdictFor'

// ⛔ **THE READER'S OWN DECLARATION NEVER COUNTS.** The corpus holds the SAVED copy of the file being
// edited, so a declaration it finds in that file is the buffer's business and the buffer is the live
// authority on it. Admit one here and an author renaming a declaration is told nothing about the uses of
// the old name they have left standing, because the corpus's stale copy still declares it.
function declaredOutsideTheReader(corpus ProgramSignatures, name ByteArray, reader FilePath) returns bool
	match declaringFileOfTheSubject(corpus, name: name, reader: reader) 'declaration'
		declared(declFilePath) then return not namesTheSameFile(declFilePath, other: reader)
		undeclared then return false
	end 'declaration'
end 'declaredOutsideTheReader'

function theBufferBindsTheName(name ByteArray, index ElementIndex, document HoverDocument, own ProgramSignatures, buffer FilePath) returns bool
	match declaringFileOfTheSubject(own, name: name, reader: buffer) 'atTopLevel'
		declared then return true
		undeclared then break
	end 'atTopLevel'

	return document.bindsTheName(name, near: index)
end 'theBufferBindsTheName'

// ⚠ Every door here asks the DECLARATION question and none asks for a VALUE. `constantValueOf` is the
// door that would answer for a top-level constant, and it notes a cross-file read into the index's
// `checkUnusedExports` bookkeeping — so asking it would let an editor query decide what a held corpus
// later reports as unused.
function declaringFileOfTheSubject(signatures ProgramSignatures, name ByteArray, reader FilePath) returns SubjectDeclaration
	match signatures.declaredTypeNameIn(name, readerFilePath: reader) 'aType'
		declared(_, _, declFilePath) then return SubjectDeclaration.declared(declFilePath)
		undeclared then break
	end 'aType'

	match calleeDeclaringFile(signatures, name: name, reader: reader) 'aCallee'
		declared(declFilePath) then return SubjectDeclaration.declared(declFilePath)
		undeclared then break
	end 'aCallee'

	match signatures.bindingFor(name, readerFilePath: reader) 'aBinding'
		declared(declFilePath) then return SubjectDeclaration.declared(declFilePath)
		undeclared then return SubjectDeclaration.undeclared
	end 'aBinding'
end 'declaringFileOfTheSubject'

function calleeDeclaringFile(signatures ProgramSignatures, name ByteArray, reader FilePath) returns SubjectDeclaration
	match signatures.resolveFunctionName(name, readerFilePath: reader) 'resolution'
		declaration(resolved) then return visibleCalleeDeclaringFile(signatures, callee: resolved, reader: reader)
		ambiguous or
			undeclared then return SubjectDeclaration.undeclared
	end 'resolution'
end 'calleeDeclaringFile'

function visibleCalleeDeclaringFile(signatures ProgramSignatures, callee ByteArray, reader FilePath) returns SubjectDeclaration
	if not signatures.declaresCallee(callee) 'noDeclarationAtAll'
		return SubjectDeclaration.undeclared
	end 'noDeclarationAtAll'

	match signatures.calleeVisibilityFrom(callee, readerFilePath: reader) 'visibility'
		visible then return SubjectDeclaration.declared(signatures.declaringFileOf(callee))
		hidden then return SubjectDeclaration.undeclared
	end 'visibility'
end 'visibleCalleeDeclaringFile'

function diagnosticSubject(diagnostic Diagnostic, tokens TokenArray) returns DiagnosticSubject
	if diagnostic.code == ErrorCode.unknownType 'anUnknownType'
		return reconstructedUnknownTypeSubject(diagnostic, tokens: tokens)
	end 'anUnknownType'

	return match diagnostic.anchor 'anchor'
		programWide or
			file gives DiagnosticSubject.unattributable
		at(_, line, column) gives subjectAnchoredAt(tokens, line: line, column: column)
	end 'anchor'
end 'diagnosticSubject'

function subjectAnchoredAt(tokens TokenArray, line LineNumber, column ColumnNumber) returns DiagnosticSubject
	for (iter, token) in tokens.withIterator() 'eachToken'
		if token.line > line 'pastTheAnchorsLine'
			break
		end 'pastTheAnchorsLine'

		if token.line != line or token.column != column 'notTheAnchor'
			continue
		end 'notTheAnchor'

		return subjectBesideAnchor(tokens, anchor: iter.index())
	end 'eachToken'

	return DiagnosticSubject.unattributable
end 'subjectAnchoredAt'

function reconstructedUnknownTypeSubject(diagnostic Diagnostic, tokens TokenArray) returns DiagnosticSubject
	match quotedNameIn(diagnostic.message) 'quoted'
		unstated then return DiagnosticSubject.unattributable
		stated(typeName) then return unknownTypeSubjectNamed(diagnostic, tokens: tokens, typeName: typeName)
	end 'quoted'
end 'reconstructedUnknownTypeSubject'

// The sentence is REBUILT through `unknownTypeMessage` and compared whole, never parsed: a quoted name
// appears in many diagnostics, and attributing one of those to a token it is not about silences a real
// error. Rebuilding also leaves the wording with one writer rather than a second copy here.
function unknownTypeSubjectNamed(diagnostic Diagnostic, tokens TokenArray, typeName String) returns DiagnosticSubject
	if unknownTypeMessage(typeName) != diagnostic.message 'anotherSentenceEntirely'
		return DiagnosticSubject.unattributable
	end 'anotherSentenceEntirely'

	let name = typeName.toByteArray()

	for (iter, token) in tokens.withIterator() 'eachToken'
		if token.kind != TokenKind.identifier or not token.value.equals(name) 'notTheName'
			continue
		end 'notTheName'

		return DiagnosticSubject.named(token.value, index: iter.index())
	end 'eachToken'

	return DiagnosticSubject.unattributable
end 'unknownTypeSubjectNamed'

function quotedNameIn(message String) returns StatedText
	let segments = message.split(DiagnosticNameQuote)

	if segments.count() <= QuotedNameSegment 'nothingQuoted'
		return StatedText.unstated
	end 'nothingQuoted'

	return StatedText.stated(try segments.get(QuotedNameSegment) otherwise panic("quotedNameIn: the split produced more than {QuotedNameSegment} segments one line above"))
end 'quotedNameIn'

// ⛔ **THE DOTTED BASE IS ASKED FOR BEFORE THE BARE NAME, AND SWAPPING THE TWO UNDOES THE FEATURE.** The
// anchor of `CompilePhase.load` is `load`, which IS an identifier — so a bare-name rule asked first
// answers `load`, finds no declaration of it anywhere, and publishes the invented refusal the base would
// have explained.
function subjectBesideAnchor(tokens TokenArray, anchor ElementIndex) returns DiagnosticSubject
	let anchored = try tokens.get(anchor) otherwise panic("subjectBesideAnchor: {anchor} is the index the walk above stopped at, inside [0, {tokens.count()})")

	if anchored.kind == TokenKind.as 'aCastTarget'
		return identifierSubjectAt(tokens, index: (anchor + 1) as ElementIndex)
	end 'aCastTarget'

	if not lspCursorNamesAMember(tokens, cursor: anchor) 'aBareName'
		return identifierSubjectAt(tokens, index: anchor)
	end 'aBareName'

	if anchor < TokensBetweenAReceiverAndItsMember 'noRoomForABase'
		return DiagnosticSubject.unattributable
	end 'noRoomForABase'

	return identifierSubjectAt(tokens, index: (anchor - TokensBetweenAReceiverAndItsMember) as ElementIndex)
end 'subjectBesideAnchor'

function identifierSubjectAt(tokens TokenArray, index ElementIndex) returns DiagnosticSubject
	let token = try tokens.get(index) otherwise return DiagnosticSubject.unattributable

	if token.kind != TokenKind.identifier 'notAName'
		return DiagnosticSubject.unattributable
	end 'notAName'

	return DiagnosticSubject.named(token.value, index: index)
end 'identifierSubjectAt'

// A single-buffer compile cannot honestly publish a whole-program claim: it holds one file plus the
// library tiers, so each claim here is true of what this server compiled and false of the program the
// author is editing. "This program declares no entry point" would sit on the first line of every
// library file an editor opens. The unused-export family (E3092/E3093/E3094) says nothing else in the
// program references a declaration, and none of the program's other files is in this compile. The
// corpus does not rescue either: it is lexed and folded, never checked. `attributedTo` reads this same
// filter, so the project check withholds these codes too.
//
// ⚠ A member is added by measurement, never by guessing. Suppressing a diagnostic that is genuinely
// about this file hides a real error, which is worse than the squiggle it removes; the leading digit
// cannot stand in for the question, because it names the stage that raised a diagnostic rather than
// the scope it claims.
function claimsAboutTheWholeProgram(code ErrorCode) returns bool
	return code == ErrorCode.noMainFunction or code == ErrorCode.semanticUnusedExportedSymbol or code == ErrorCode.semanticExportableAsModule or code == ErrorCode.semanticUnusedModuleSymbol
end 'claimsAboutTheWholeProgram'

// Does this diagnostic report on THIS document's text?
//
// A `programWide` diagnostic names no file, and it is taken to be this document's because every
// road that reaches here reported over this document alone — the buffer compile holds one file plus
// the library tiers, and the corpus road parses the reader's file and nothing else — or narrowed
// first: the project check reports over the whole project, and `attributedTo` keeps a program-wide
// diagnostic only where the buffer compile raised it too. ⚠ A program-wide diagnostic carries
// nothing to narrow BY, so a road that ever reports over more than this document owes its own
// narrowing before it gets here. One naming ANOTHER file is a library's, and painting it into the
// author's document would put a squiggle on a line they did not write.
module function reportsOn(diagnostic Diagnostic, path FilePath) returns bool
	return namesTheSameFile(try diagnostic.anchor.anchoredFile() otherwise return true, other: path)
end 'reportsOn'

// Resolved and normalized rather than compared as text: the corpus reports under the spelling it
// registered a file by, which is not always the spelling the request arrived with
// (`registeredSpellingOf` owns that rule). A text compare drops every one of those diagnostics and
// publishes an empty array, which reads as "this document is clean".
module function namesTheSameFile(one FilePath, other FilePath) returns bool
	return one.resolve(Directory.currentPath()).equals(other.resolve(Directory.currentPath()))
end 'namesTheSameFile'

// A line `maxon build` prints for a project it could not load (`Main.reportCompileError`). It is no
// `Diagnostic`, so it carries no code and no position, and sits at the document's start.
function unbuiltProjectNode(doc JsonDoc, failure String, source String, index LspLineIndex) returns JsonNodeId
	return errorItemAt(doc, span: documentStartSpan(), message: failure, source: source, index: index).finish()
end 'unbuiltProjectNode'

function errorItemAt(doc JsonDoc, span LspSpan, message String, source String, index LspLineIndex) returns LspJsonObject
	var item = LspJsonObject.create(doc)
	item.putNode(LspRangeKey, value: lspSpanRangeNode(doc, source: source, index: index, span: span))
	item.put(DiagnosticSeverityKey, value: JsonNode.numberNode(LspErrorSeverity))
	item.put(DiagnosticSourceKey, value: JsonNode.stringNode(DiagnosticSourceName))
	item.put(DiagnosticMessageKey, value: JsonNode.stringNode(message))
	return item
end 'errorItemAt'

function diagnosticNode(doc JsonDoc, diagnostic Diagnostic, source String, index LspLineIndex, tokens TokenArray) returns JsonNodeId
	var item = errorItemAt(doc, span: diagnosticSpan(diagnostic, source: source, index: index, tokens: tokens), message: diagnostic.message, source: source, index: index)

	// The code, because it is the field a Maxon author can act on: `E3005` can be looked up in the
	// error code reference, where the message alone cannot. `rawValue` is the registry's own spelling
	// of it, so no source file writes the number down a second time.
	item.put(DiagnosticCodeKey, value: JsonNode.stringNode(diagnostic.code.rawValue))
	return item.finish()
end 'diagnosticNode'

// ⭐⭐ **THE SPAN A DIAGNOSTIC UNDERLINES, AND `tokenSpanAt` IS WHAT ANSWERS IT.** A `Diagnostic` carries
// a 1-BASED line and column and nothing else, so an editor given one alone would paint a single character
// rather than the token. The token anchored at that position carries the bytes, and `LspPosition.maxon`'s
// header owns the argument
// for recovering them from the token stream rather than threading them through `Diagnostic`.
//
// Two anchors have no token, and both fall back to a ONE-BYTE span converted through the same path:
//
//   * **A diagnostic reported WITHOUT a position** — a `programWide` or `file` anchor. `reportsOn`
//     has already established it is this document's, and there is nowhere better inside it than the
//     start. `E3002` (`main` returning something other than `ExitCode`) is one that reaches the
//     publish.
//   * **A position no token BEGINS at.** The lexer records a span only for tokens whose text it sliced,
//     so every punctuator carries `startByte == endByte == 0` (`LspCursor.maxon` states the same fact
//     from the other side) — `tokenSpanAt` finds one by line and column and hands back a span that is
//     empty, which is exactly the signal to fall back.
module function diagnosticSpan(diagnostic Diagnostic, source String, index LspLineIndex, tokens TokenArray) returns LspSpan
	return match diagnostic.anchor 'anchor'
		programWide or
			file gives documentStartSpan()
		at(_, line, column) gives anchoredSpan(line, column: column, source: source, index: index, tokens: tokens)
	end 'anchor'
end 'diagnosticSpan'

function anchoredSpan(line LineNumber, column ColumnNumber, source String, index LspLineIndex, tokens TokenArray) returns LspSpan
	let anchored = tokenSpanAt(tokens, line: line, column: column)

	if not anchored.isEmpty() 'onAToken'
		return anchored
	end 'onAToken'

	// The column is 1-based BYTES (the lexer counts one per consumed byte).
	let lineStart = index.offsetOf(source, position: LspPosition.create(((line - 1) as LspLineNumber), character: 0))
	let anchor = lineStart + (column as ByteOffset) - 1

	return LspSpan.create(anchor, endByte: (anchor + 1) as ByteOffset)
end 'anchoredSpan'

// The first byte of a document, where a diagnostic with no position of its own in it is placed.
module function documentStartSpan() returns LspSpan
	return LspSpan.create(0, endByte: 1)
end 'documentStartSpan'

// `PublishDiagnosticsParams` for `uri`, as the message's text. The document travels with the items
// because each of them is a node inside it.
function diagnosticsNotificationText(uri String, items JsonNodeIdArray, doc JsonDoc) returns String
	var params = LspJsonObject.create(doc)
	params.put(LspUriKey, value: JsonNode.stringNode(uri))
	params.putNode(DiagnosticsKey, value: doc.add(JsonNode.arrayNode(items)))

	return lspNotificationText(doc, method: PublishDiagnosticsMethod, params: params.finish())
end 'diagnosticsNotificationText'
