// Which FILE declares the name under a cursor, decided through the compiler's own resolution and
// visibility rules — `resolveFunctionName`, `structFor`, `calleeVisibilityFrom`, `fieldReach` — asked of a
// `ProgramSignatures` rather than re-derived from the token stream.
//
// ⚠ `textDocument/definition` and `textDocument/hover` both ask this, and ONE copy keeps them
// answering the same question. A second walk of its own would let one feature send an author to a
// declaration the other holds to be invisible from the file that asked.

// Nothing under the cursor, or nothing that declares what is. ⭐ A THROW rather than a token standing
// for "none", for the reason `TypeNameRegistry.declarationOf` throws: a not-found token would carry a
// real `0:0` position that a synthesized declaration also has. Every lookup below fails the same way, so
// there is one arm and not four spellings of absence.
enum LspDeclarationLookupError implements Error
	nothingThere
end 'LspDeclarationLookupError'

let TokensBetweenAReceiverAndItsMember = 2 as ElementIndex

union LspVisibleField
	declared(layout StructLayout, index FieldIndex)
	hidden
	none
end 'LspVisibleField'

// Three answers and not two. "Nothing declares it" and "declared, but hidden from you" lead to different
// fallbacks — only the first may reach a lookup by filename — so a reader that collapses them renders a
// member the compiler refuses to let this file name.
union LspMemberDeclaration
	declaredIn(path FilePath, owner String)
	hiddenHere
	nothingDeclaresIt
end 'LspMemberDeclaration'

// `owner` is the type the index files the member under (a service, for a handle's message), which is
// the name of the body that declares it.
union LspDeclaringSite
	ofAMember(path FilePath, owner String)
	ofAName(path FilePath)
end 'LspDeclaringSite'

function lspDeclaringSitePath(site LspDeclaringSite) returns FilePath
	return match site 'site'
		ofAMember(path, _) gives path
		ofAName(path) gives path
	end 'site'
end 'lspDeclaringSitePath'

union LspHandleSurface
	messages(serviceName immutable ByteArray, request immutable EnumLayout)
	notAHandle
end 'LspHandleSurface'

// What a `<T>.handle` offers, as one guarded door: `isServiceHandle` is the compiler's own membership
// test and `serviceOfHandle` panics for anything else, so the two are never asked apart.
function lspHandleSurfaceOf(signatures ProgramSignatures, typeName ByteArray) returns LspHandleSurface
	if not signatures.isServiceHandle(typeName) 'notAHandle'
		return LspHandleSurface.notAHandle
	end 'notAHandle'

	let serviceName = signatures.serviceOfHandle(typeName)
	let request = try serviceRequestLayoutOf(signatures, typeName: serviceName) otherwise return LspHandleSurface.notAHandle

	return LspHandleSurface.messages(serviceName, request: request)
end 'lspHandleSurfaceOf'

function lspCursorNamesAMember(tokens TokenArray, cursor ElementIndex) returns bool
	if cursor == 0 'nothingBefore'
		return false
	end 'nothingBefore'

	let before = try tokens.get(cursor - 1) otherwise return false
	return before.kind == TokenKind.dot
end 'lspCursorNamesAMember'

function lspDeclaringSiteOfTheCursor(corpus LspCorpus, text String, tokens TokenArray, keywords KeywordTable, cursor ElementIndex) returns LspDeclaringSite throws LspDeclarationLookupError
	match corpus 'held'
		loaded(_, signatures, readerPath) then return try declaringSiteOfACursorName(signatures, corpus: corpus, text: text, tokens: tokens, keywords: keywords, cursor: cursor, readerPath: readerPath)
		unavailable then throw LspDeclarationLookupError.nothingThere
	end 'held'
end 'lspDeclaringSiteOfTheCursor'

function declaringSiteOfACursorName(signatures ProgramSignatures, corpus LspCorpus, text String, tokens TokenArray, keywords KeywordTable, cursor ElementIndex, readerPath FilePath) returns LspDeclaringSite throws LspDeclarationLookupError
	let name = lspTokenAt(tokens, index: cursor).value

	if lspCursorNamesAMember(tokens, cursor: cursor) 'aMember'
		if let qualified = try nameableQualifiedTypeEndingAt(tokens, index: cursor, signatures: signatures, readerFilePath: readerPath) 'aQualifiedType'
			return LspDeclaringSite.ofAName(qualified.declFilePath)
		end 'aQualifiedType'

		return try declaringSiteOfTheCursorsMember(signatures, corpus: corpus, text: text, tokens: tokens, keywords: keywords, cursor: cursor, member: name, readerPath: readerPath)
	end 'aMember'

	return LspDeclaringSite.ofAName(try declaringFileOfABareName(signatures, name: name, readerPath: readerPath))
end 'declaringSiteOfACursorName'

function lspMemberOwnerOfTheCursor(corpus LspCorpus, text String, tokens TokenArray, keywords KeywordTable, cursor ElementIndex) returns String throws LspDeclarationLookupError
	if cursor < TokensBetweenAReceiverAndItsMember 'nothingBeforeTheDot'
		throw LspDeclarationLookupError.nothingThere
	end 'nothingBeforeTheDot'

	let subject = lspSubjectOfReceiver(text, tokens: tokens, keywords: keywords, receiver: cursor - TokensBetweenAReceiverAndItsMember, corpus: corpus)

	return try lspSubjectTypeName(subject) otherwise throw LspDeclarationLookupError.nothingThere
end 'lspMemberOwnerOfTheCursor'

function declaringSiteOfTheCursorsMember(signatures ProgramSignatures, corpus LspCorpus, text String, tokens TokenArray, keywords KeywordTable, cursor ElementIndex, member ByteArray, readerPath FilePath) returns LspDeclaringSite throws LspDeclarationLookupError
	let typeName = try lspMemberOwnerOfTheCursor(corpus, text: text, tokens: tokens, keywords: keywords, cursor: cursor)

	return try lspDeclaringSiteOfAMember(signatures, owner: typeName.toByteArray(), member: member, readerPath: readerPath)
end 'declaringSiteOfTheCursorsMember'

function lspDeclaringSiteOfAMember(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspDeclaringSite throws LspDeclarationLookupError
	match lspMemberDeclarationOf(signatures, owner: owner, member: member, readerPath: readerPath) 'declared'
		declaredIn(path, declaringOwner) then return LspDeclaringSite.ofAMember(path, owner: declaringOwner)
		hiddenHere or
		nothingDeclaresIt then throw LspDeclarationLookupError.nothingThere
	end 'declared'
end 'lspDeclaringSiteOfAMember'

function lspMemberDeclarationOf(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspMemberDeclaration
	match lspHandleSurfaceOf(signatures, typeName: owner) 'aHandle'
		messages(serviceName, request) then return messageDeclarationOf(signatures, serviceName: serviceName, request: request, member: member, readerPath: readerPath)
		notAHandle then return declaredMemberDeclarationOf(signatures, owner: owner, member: member, readerPath: readerPath)
	end 'aHandle'
end 'lspMemberDeclarationOf'

// A message resolves to the SERVICE's declaration, because that is the callee `emitServiceSend` binds.
function messageDeclarationOf(signatures ProgramSignatures, serviceName ByteArray, request EnumLayout, member ByteArray, readerPath FilePath) returns LspMemberDeclaration
	if not serviceHandleAdmits(request, member: member) 'theCompilerRefusesIt'
		return LspMemberDeclaration.nothingDeclaresIt
	end 'theCompilerRefusesIt'

	return calleeDeclarationOf(signatures, qualified: qualifiedMethodName(serviceName, methodName: member), owner: serviceName, readerPath: readerPath)
end 'messageDeclarationOf'

function declaredMemberDeclarationOf(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspMemberDeclaration
	if not lspTypeMembersReachable(signatures, owner: owner, readerPath: readerPath) 'typeHiddenHere'
		return LspMemberDeclaration.hiddenHere
	end 'typeHiddenHere'

	let asMethod = calleeDeclarationOf(signatures, qualified: qualifiedMethodName(owner, methodName: member), owner: owner, readerPath: readerPath)

	match asMethod 'aMethod'
		declaredIn or
		hiddenHere then return asMethod
		nothingDeclaresIt then return fieldOrCaseDeclarationOf(signatures, owner: owner, member: member, readerPath: readerPath)
	end 'aMethod'
end 'declaredMemberDeclarationOf'

function fieldOrCaseDeclarationOf(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspMemberDeclaration
	let asField = fieldDeclarationOf(signatures, owner: owner, member: member, readerPath: readerPath)

	match asField 'aField'
		declaredIn or
		hiddenHere then return asField
		nothingDeclaresIt then return enumCaseDeclarationOf(signatures, owner: owner, member: member, readerPath: readerPath)
	end 'aField'
end 'fieldOrCaseDeclarationOf'

function calleeDeclarationOf(signatures ProgramSignatures, qualified ByteArray, owner ByteArray, readerPath FilePath) returns LspMemberDeclaration
	if not signatures.declaresCallee(qualified) 'nothingDeclaresIt'
		return LspMemberDeclaration.nothingDeclaresIt
	end 'nothingDeclaresIt'

	match signatures.calleeVisibilityFrom(qualified, readerFilePath: readerPath) 'tier'
		visible then return LspMemberDeclaration.declaredIn(signatures.declaringFileOf(qualified), owner: String.from(owner))
		hidden then return LspMemberDeclaration.hiddenHere
	end 'tier'
end 'calleeDeclarationOf'

function fieldDeclarationOf(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspMemberDeclaration
	match lspVisibleFieldOf(signatures, owner: owner, member: member, readerPath: readerPath) 'aField'
		declared(layout, _) then return LspMemberDeclaration.declaredIn(layout.declFilePath, owner: String.from(owner))
		hidden then return LspMemberDeclaration.hiddenHere
		none then return LspMemberDeclaration.nothingDeclaresIt
	end 'aField'
end 'fieldDeclarationOf'

function enumCaseDeclarationOf(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspMemberDeclaration
	match signatures.enumFor(owner, readerFilePath: readerPath) 'anEnum'
		declared(layout) then return enumCaseDeclarationIn(layout, owner: owner, member: member)
		undeclared then return LspMemberDeclaration.nothingDeclaresIt
	end 'anEnum'
end 'enumCaseDeclarationOf'

function enumCaseDeclarationIn(layout EnumLayout, owner ByteArray, member ByteArray) returns LspMemberDeclaration
	for caseName in layout.caseNames 'eachCase'
		if caseName.equals(member) 'thisCase'
			return LspMemberDeclaration.declaredIn(layout.declFilePath, owner: String.from(owner))
		end 'thisCase'
	end 'eachCase'

	return LspMemberDeclaration.nothingDeclaresIt
end 'enumCaseDeclarationIn'

function declaringFileOfABareName(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	if let declaredFunction = try declaringFileOfAFunction(signatures, name: name, readerPath: readerPath) 'aFunction'
		return declaredFunction
	end 'aFunction'

	if let declaredStruct = try declaringFileOfAStruct(signatures, name: name, readerPath: readerPath) 'aStructType'
		return declaredStruct
	end 'aStructType'

	if let declaredEnum = try declaringFileOfAnEnum(signatures, name: name, readerPath: readerPath) 'anEnumType'
		return declaredEnum
	end 'anEnumType'

	if let declaredAlias = try declaringFileOfAnAlias(signatures, name: name, readerPath: readerPath) 'aRangedAlias'
		return declaredAlias
	end 'aRangedAlias'

	if let declaredInterface = try declaringFileOfAnInterface(signatures, name: name) 'anInterface'
		return declaredInterface
	end 'anInterface'

	return try declaringFileOfABinding(signatures, name: name, readerPath: readerPath)
end 'declaringFileOfABareName'

// ⚠ `ambiguous` answers NOTHING, exactly as `undeclared` does. `resolveFunctionName` is the compiler's
// own resolver, and `ambiguous` is the verdict behind E3095 — an editor that picked one of the
// candidates would send an author to a declaration the compiler refuses to bind the call to.
function declaringFileOfAFunction(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	match signatures.resolveFunctionName(name, readerFilePath: readerPath) 'resolution'
		declaration(resolved) then return try visibleCalleeFile(signatures, qualified: resolved, readerPath: readerPath)
		ambiguous or
		undeclared then throw LspDeclarationLookupError.nothingThere
	end 'resolution'
end 'declaringFileOfAFunction'

function visibleCalleeFile(signatures ProgramSignatures, qualified ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	if not signatures.declaresCallee(qualified) 'nothingDeclaresIt'
		throw LspDeclarationLookupError.nothingThere
	end 'nothingDeclaresIt'

	match signatures.calleeVisibilityFrom(qualified, readerFilePath: readerPath) 'tier'
		visible then return signatures.declaringFileOf(qualified)
		hidden then throw LspDeclarationLookupError.nothingThere
	end 'tier'
end 'visibleCalleeFile'

function declaringFileOfAStruct(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	match signatures.structFor(name, readerFilePath: readerPath) 'aStruct'
		declared(layout) then return try visibleDeclarationFile(signatures, visibility: layout.visibility, declFilePath: layout.declFilePath, readerPath: readerPath)
		undeclared then throw LspDeclarationLookupError.nothingThere
	end 'aStruct'
end 'declaringFileOfAStruct'

function declaringFileOfAnEnum(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	match signatures.enumFor(name, readerFilePath: readerPath) 'anEnum'
		declared(layout) then return try visibleDeclarationFile(signatures, visibility: layout.visibility, declFilePath: layout.declFilePath, readerPath: readerPath)
		undeclared then throw LspDeclarationLookupError.nothingThere
	end 'anEnum'
end 'declaringFileOfAnEnum'

function declaringFileOfAnAlias(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	match signatures.declaredAliasOfSpelling(name, readerFilePath: readerPath) 'anAlias'
		declared(alias) then return try visibleAliasFile(signatures, alias: alias, readerPath: readerPath)
		undeclared then throw LspDeclarationLookupError.nothingThere
	end 'anAlias'
end 'declaringFileOfAnAlias'

function visibleAliasFile(signatures ProgramSignatures, alias RangedTypeAlias, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	if not signatures.aliasVisibleFrom(alias, readerFilePath: readerPath) 'hiddenHere'
		throw LspDeclarationLookupError.nothingThere
	end 'hiddenHere'

	return alias.declFilePath
end 'visibleAliasFile'

function declaringFileOfAnInterface(signatures ProgramSignatures, name ByteArray) returns FilePath throws LspDeclarationLookupError
	if not signatures.nameDeclaresAnInterface(name) 'nothingDeclaresIt'
		throw LspDeclarationLookupError.nothingThere
	end 'nothingDeclaresIt'

	for site in signatures.settledDeclarations().interfaceDeclSites 'eachSite'
		if site.name.names(name) 'thisInterface'
			return site.path
		end 'thisInterface'
	end 'eachSite'

	throw LspDeclarationLookupError.nothingThere
end 'declaringFileOfAnInterface'

function declaringFileOfABinding(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	match signatures.bindingFor(name, readerFilePath: readerPath) 'aBinding'
		declared(declFilePath) then return declFilePath
		undeclared then throw LspDeclarationLookupError.nothingThere
	end 'aBinding'
end 'declaringFileOfABinding'

function lspVisibleFieldOf(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns LspVisibleField
	match signatures.structFor(owner, readerFilePath: readerPath) 'aStruct'
		declared(layout) then return visibleFieldIn(signatures, layout: layout, member: member, readerPath: readerPath)
		undeclared then return LspVisibleField.none
	end 'aStruct'
end 'lspVisibleFieldOf'

function visibleFieldIn(signatures ProgramSignatures, layout StructLayout, member ByteArray, readerPath FilePath) returns LspVisibleField
	let index = try layout.indexOfField(member) otherwise return LspVisibleField.none

	if not LspLayoutReach.of(signatures, layout: layout, readerPath: readerPath).reaches(signatures, layout: layout, index: index) 'hiddenHere'
		return LspVisibleField.hidden
	end 'hiddenHere'

	return LspVisibleField.declared(layout, index: index)
end 'visibleFieldIn'

// The answers `fieldReach` takes that do not vary by field, settled once per layout so a walk over its
// fields does not repeat them.
type LspLayoutReach
	let readerPath as FilePath
	let rawSurfaceRefused as bool
	let typeReachable as bool

	static function of(signatures ProgramSignatures, layout StructLayout, readerPath FilePath) returns LspLayoutReach
		return Self{readerPath: readerPath, rawSurfaceRefused: signatures.rawSurfaceIsRefusedIn(readerPath), typeReachable: signatures.isVisibleFrom(layout.visibility, declFilePath: layout.declFilePath, readerFilePath: readerPath)}
	end 'of'

	function reaches(signatures ProgramSignatures, layout StructLayout, index FieldIndex) returns bool
		return match fieldReach(signatures, layout: layout, index: index, readerFilePath: self.readerPath, rawSurfaceRefused: self.rawSurfaceRefused, typeReachable: self.typeReachable) 'reach'
			reachable gives true
			rawSurface or
			typeHidden or
			tierHidden gives false
		end 'reach'
	end 'reaches'
end 'LspLayoutReach'

function lspTypeMembersReachable(signatures ProgramSignatures, owner ByteArray, readerPath FilePath) returns bool
	match signatures.structFor(owner, readerFilePath: readerPath) 'aStruct'
		declared(layout) then return signatures.isVisibleFrom(layout.visibility, declFilePath: layout.declFilePath, readerFilePath: readerPath)
		undeclared then break
	end 'aStruct'

	match signatures.enumFor(owner, readerFilePath: readerPath) 'anEnumOrUnion'
		declared(layout) then return signatures.isVisibleFrom(layout.visibility, declFilePath: layout.declFilePath, readerFilePath: readerPath)
		undeclared then return true
	end 'anEnumOrUnion'
end 'lspTypeMembersReachable'

function visibleDeclarationFile(signatures ProgramSignatures, visibility Visibility, declFilePath FilePath, readerPath FilePath) returns FilePath throws LspDeclarationLookupError
	if not signatures.isVisibleFrom(visibility, declFilePath: declFilePath, readerFilePath: readerPath) 'hiddenHere'
		throw LspDeclarationLookupError.nothingThere
	end 'hiddenHere'

	return declFilePath
end 'visibleDeclarationFile'
