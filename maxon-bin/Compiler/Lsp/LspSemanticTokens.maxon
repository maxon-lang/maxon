// `textDocument/semanticTokens/full` — what each word of the document MEANS, for an editor that colours
// by meaning rather than by regular expression.
//
// ⭐⭐ **THE FIRST THING A LEXER ALONE GETS WRONG, AND WHY THIS METHOD EARNS ITS KEEP:** inside an
// `enum` body a case may be NAMED with a word this language uses as a keyword everywhere else —
// `enum TokenType / function / returns / identifier` is a legal declaration of three cases. A classifier
// that reads `TokenKind` alone paints all three as keywords, which is exactly the colouring a TextMate
// grammar already gives and exactly the one that is wrong. The `enum` body is `LspSymbols.maxon`'s block
// model, read here rather than re-derived.
//
// The second is which identifiers are types: no token says so. `SemanticTypeNames` decides from the
// buffer's own declarations, the compiler's own names and the held `LspCorpus`, so a document with
// no corpus colours only the first two as types. A local or parameter of the same name stays a
// variable.
//
// ⭐ **ONLY TOKENS THAT CARRY SOURCE BYTES ARE COLOURED.** A punctuator's `startByte`/`endByte` are both
// 0 (`Token`: the kind implies the text, so nothing is sliced for it), so there is no span to convert and
// no honest length to report — and punctuation is what an editor's own grammar colours anyway. That
// exclusion is a fact about the token stream, not a scope decision.

// ⛔⛔ **THE LEGEND IS THE CONTRACT.** A semantic-token type is an INDEX and means nothing except against
// the list a server declares in its `initialize` response, so these numbers and that list are one fact.
// They are written twice below — a constant and a position in an array — and `requireLegendPosition`
// CHECKS the two agree on every `initialize`, because a legend that drifts from the indices does not
// fail: it recolours the whole file, silently, in every editor at once.
typealias LspSemanticTokenType = int(0 to 16) implements ElementIndex

let KeywordTokenType = 0
let TypeTokenType = 1
let FunctionTokenType = 5
let VariableTokenType = 7
let ModifierTokenType = 9
let EnumMemberTokenType = 10
let StringTokenType = 12
let NumberTokenType = 13
let CommentTokenType = 14
let CapabilityTokenType = 16

// A value on the wire. LSP encodes the whole file as one flat run of non-negative integers.
typealias LspSemanticTokenValue = int(0 to u64.max)
typealias LspSemanticTokenValueArray = Array with LspSemanticTokenValue

// LSP's `SemanticTokensOptions` and `SemanticTokens` members.
let LegendKey = "legend"
let TokenTypesKey = "tokenTypes"
let TokenModifiersKey = "tokenModifiers"
let FullKey = "full"
let DataKey = "data"

// Every token this server reports carries no modifiers, so the bitset is always zero and the modifier
// legend is empty. A modifier an editor cannot decode is worse than one it is never sent.
let NoTokenModifiers = 0 as LspSemanticTokenValue

module function semanticTokensServedMethods() returns LspMethodArray
	var served = LspMethodArray.create(0)
	served.push(LspMethod.semanticTokensFull)
	return served
end 'semanticTokensServedMethods'

// This server's `SemanticTokensOptions`. `full` is the only request form it answers; a `range` form would
// be a second classifier over the same document, and this one is a walk of an already-lexed file.
module function semanticTokensCapabilityOptions(doc JsonDoc) returns JsonNodeId
	var legend = LspJsonObject.create(doc)
	legend.putNode(TokenTypesKey, value: stringArrayNode(doc, values: legendTokenTypeNames()))
	legend.putNode(TokenModifiersKey, value: stringArrayNode(doc, values: StringArray.create(0)))

	var options = LspJsonObject.create(doc)
	options.putNode(LegendKey, value: legend.finish())
	options.put(FullKey, value: JsonNode.boolNode(true))
	return options.finish()
end 'semanticTokensCapabilityOptions'

module function semanticTokensAnswer(request LspRequest) returns LspAnswer
	if request.method != LspMethod.semanticTokensFull 'notThisArea'
		panic("semanticTokensAnswer: {lspMethodSpelling(request.method).wireName} is not this area's — `semanticTokensServedMethods` names the one method it answers")
	end 'notThisArea'

	var doc = JsonDoc.create()
	let encoded = encodedTokensOf(request.text, keywords: request.keywords, corpus: lspDocumentCorpus(request.workspace, uri: request.uri))
	var values = JsonNodeIdArray.create(encoded.count(), zeroed: false)

	for value in encoded 'eachValue'
		values.push(doc.add(JsonNode.numberNode(value as JsonFloat)))
	end 'eachValue'

	var result = LspJsonObject.create(doc)
	result.putNode(DataKey, value: doc.add(JsonNode.arrayNode(values)))
	return LspAnswer.of(doc, result: result.finish())
end 'semanticTokensAnswer'

// ⭐ **THE NAMES ARE LSP'S OWN `SemanticTokenTypes`, AND THE ORDER IS THIS SERVER'S.** A client maps each
// name to a theme colour, so a name outside the protocol's set is a token it cannot colour at all; the
// ORDER, by contrast, is free, and this one is chosen so that the indices the suite pins are the indices
// this server sends.
function legendTokenTypeNames() returns StringArray
	let names = ["keyword", "type", "struct", "enum", "interface", "function", "method", "variable", "parameter", "modifier", "enumMember", "property", "string", "number", "comment", "operator", "capability"]

	requireLegendPosition(names, index: KeywordTokenType, name: "keyword")
	requireLegendPosition(names, index: TypeTokenType, name: "type")
	requireLegendPosition(names, index: FunctionTokenType, name: "function")
	requireLegendPosition(names, index: VariableTokenType, name: "variable")
	requireLegendPosition(names, index: ModifierTokenType, name: "modifier")
	requireLegendPosition(names, index: EnumMemberTokenType, name: "enumMember")
	requireLegendPosition(names, index: StringTokenType, name: "string")
	requireLegendPosition(names, index: NumberTokenType, name: "number")
	requireLegendPosition(names, index: CommentTokenType, name: "comment")
	requireLegendPosition(names, index: CapabilityTokenType, name: "capability")

	return names
end 'legendTokenTypeNames'

// ⚠ **EVERY CONSTANT THIS SERVER EMITS IS CHECKED, NOT A SAMPLE OF THEM.** A drift in an unchecked one
// would be invisible: the file would simply come out the wrong colours, and no test that reads a token's
// index through the legend could ever notice.
function requireLegendPosition(names StringArray, index LspSemanticTokenType, name String)
	let declared = try names.get(index) otherwise panic("requireLegendPosition: the legend has {names.count()} entries and this server emits index {index}, which is outside it")

	if declared != name 'drifted'
		panic("requireLegendPosition: index {index} is '{declared}' in the legend and is named '{name}' by the constant this server emits it under — the two are one fact and they have come apart")
	end 'drifted'
end 'requireLegendPosition'

function stringArrayNode(doc JsonDoc, values StringArray) returns JsonNodeId
	var nodes = JsonNodeIdArray.create(values.count(), zeroed: false)

	for value in values 'eachValue'
		nodes.push(doc.add(JsonNode.stringNode(value)))
	end 'eachValue'

	return doc.add(JsonNode.arrayNode(nodes))
end 'stringArrayNode'

// --- The classification -----------------------------------------------------------------------

// ⚠ **LSP ENCODES EACH TOKEN RELATIVE TO THE ONE BEFORE IT**: `[deltaLine, deltaStartChar, length,
// tokenType, tokenModifiers]`, where `deltaStartChar` is relative to the previous token's start ONLY when
// the two share a line and absolute otherwise. The first token's `deltaLine` is relative to nothing, so a
// token on line 0 encodes as a delta of 0 — which is why the origin is (0, 0) rather than "unset".
//
// ⚠ Both the character and the length are counted in UTF-16 code units, which is why they come from
// `LspLineIndex.positionOf` on the two ends of the token's span rather than from its byte width.
function encodedTokensOf(source String, keywords KeywordTable, corpus LspCorpus) returns LspSemanticTokenValueArray
	let tokens = lspDocumentTokens(source, keywords: keywords)
	let lineScopes = LspLineScopes.of(lspDocumentBlocks(tokens))
	let index = LspLineIndex.build(source)
	let typeNames = SemanticTypeNames.of(tokens, corpus: corpus)
	let qualifiers = TypeQualifierPositions.over(tokens)

	var data = LspSemanticTokenValueArray.create(0)
	var previousLine = 0 as LspLineNumber
	var previousCharacter = 0 as LspCharacter
	var lineOfPreviousToken = PreviousTokenLine.none

	for (position, token) in tokens.withIterator() 'eachToken'
		if token.kind == TokenKind.eof or tokenKindIsSkippedLayout(token.kind) and token.kind != TokenKind.docComment 'notCode'
			continue
		end 'notCode'

		let firstOnLine = match lineOfPreviousToken 'previous'
			none gives true
			at(line) gives token.line != line
		end 'previous'

		lineOfPreviousToken = PreviousTokenLine.at(token.line)

		if token.endByte <= token.startByte 'noSpanToColour'
			continue
		end 'noSpanToColour'

		let start = index.positionOf(source, offset: token.startByte)
		let finish = index.positionOf(source, offset: token.endByte)
		let tokenType = tokenTypeOf(tokens, at: position.index(), token: token, firstOnLine: firstOnLine, inCaseList: lineScopes.isInsideACaseList(start.line), typeQualifier: qualifiers.verdictAt(position.index()), typeNames: typeNames)

		let deltaLine = start.line - previousLine
		var deltaCharacter = start.character

		if deltaLine == 0 'sameLine'
			deltaCharacter = start.character - previousCharacter
		end 'sameLine'

		data.push(deltaLine as LspSemanticTokenValue)
		data.push(deltaCharacter as LspSemanticTokenValue)
		data.push((finish.character - start.character) as LspSemanticTokenValue)
		data.push(tokenType as LspSemanticTokenValue)
		data.push(NoTokenModifiers)

		previousLine = start.line
		previousCharacter = start.character
	end 'eachToken'

	return data
end 'encodedTokensOf'

union PreviousTokenLine
	none
	at(line LineNumber)
end 'PreviousTokenLine'

function tokenTypeOf(tokens TokenArray, at ElementIndex, token Token, firstOnLine bool, inCaseList bool, typeQualifier QualifierVerdict, typeNames SemanticTypeNames) returns LspSemanticTokenType
	// A case list is spelled one name per line, so the line's FIRST word is the case and anything after it
	// belongs to its associated values.
	if inCaseList and firstOnLine 'aCaseName'
		return EnumMemberTokenType
	end 'aCaseName'

	if lspIsDeclarationModifier(token) 'modifier'
		return ModifierTokenType
	end 'modifier'

	if token.kind == TokenKind.docComment 'prose'
		return CommentTokenType
	end 'prose'

	if token.kind == TokenKind.intLiteral or token.kind == TokenKind.floatLiteral 'number'
		return NumberTokenType
	end 'number'

	// A block label is lexed as a character literal and is coloured as one: telling a label from a real
	// `'a'` needs the block model, and no editor theme colours the two differently anyway.
	if token.kind == TokenKind.stringLiteral or token.kind == TokenKind.byteStringLiteral or token.kind == TokenKind.charLiteral or token.kind == TokenKind.stringFormatSpec 'text'
		return StringTokenType
	end 'text'

	match typeQualifier 'qualifier'
		readonlyQualifier then return KeywordTokenType
		capabilityQualifier then return CapabilityTokenType
		plainName then break
	end 'qualifier'

	if token.kind == TokenKind.identifier 'aName'
		return identifierTokenType(tokens, at: at, typeNames: typeNames)
	end 'aName'

	if kindNamesAPrimitiveType(token.kind) 'aPrimitive'
		return TypeTokenType
	end 'aPrimitive'

	return KeywordTokenType
end 'tokenTypeOf'

function kindNamesAPrimitiveType(kind TokenKind) returns bool
	return kind == TokenKind.int or kind == TokenKind.float or kind == TokenKind.bool or kind == TokenKind.cstring or kind == TokenKind.selfType
end 'kindNamesAPrimitiveType'

function identifierTokenType(tokens TokenArray, at ElementIndex, typeNames SemanticTypeNames) returns LspSemanticTokenType
	if at > 0 'hasAPredecessor'
		let previous = lspTokenAt(tokens, index: at - 1)

		if declaresAFunctionNamed(tokens, at: at) 'declaresAFunction'
			return FunctionTokenType
		end 'declaresAFunction'

		if kindDeclaresATypeName(previous.kind) 'declaresAType'
			return TypeTokenType
		end 'declaresAType'

		if bindingKeywordSpells(previous.kind) 'declaresABinding'
			return VariableTokenType
		end 'declaresABinding'

		if previous.kind == TokenKind.dot 'aMember'
			return TypeTokenType if typeNames.namesAQualifiedType(tokens, at: at) else VariableTokenType
		end 'aMember'
	end 'hasAPredecessor'

	return TypeTokenType if typeNames.namesAType(tokens, at: at) else VariableTokenType
end 'identifierTokenType'

function declaresAFunctionNamed(tokens TokenArray, at ElementIndex) returns bool
	if tokenKindAt(tokens, index: at - 1) == TokenKind.function 'afterTheKeyword'
		return tokenKindAt(tokens, index: at + 1) != TokenKind.dot
	end 'afterTheKeyword'

	return at > TokensPerQualifierSegment and tokenKindAt(tokens, index: at - 1) == TokenKind.dot and tokenKindAt(tokens, index: at - TokensPerQualifierSegment - 1) == TokenKind.function
end 'declaresAFunctionNamed'

typealias LocalNameSet = Set with ByteArray

type SemanticTypeNames
	let declaredHere as DeclaredTypeNameSet
	let boundHere as LocalNameSet
	let corpus as LspCorpus

	static function of(tokens TokenArray, corpus LspCorpus) returns SemanticTypeNames
		var declared = DeclaredTypeNameSet.create()
		var bound = LocalNameSet.create()

		for (position, token) in tokens.withIterator() 'eachToken'
			let following = position.index() + 1

			if kindDeclaresATypeName(token.kind) 'declaresATypeName'
				declareNameAt(tokens, at: following, into: declared)

				if token.kind == TokenKind.extension 'inheritsTypeParameters'
					declareExtensionParametersFrom(tokens, at: following, corpus: corpus, into: declared)
				end 'inheritsTypeParameters'
			end 'declaresATypeName' else if token.kind == TokenKind.uses 'declaresTypeParameters'
				declareTypeParametersFrom(tokens, at: following, into: declared)
			end 'declaresTypeParameters' else if definitionIntroducesNames(token.kind) 'bindsNames'
				for named in definitionBoundTokensAt(tokens, keyword: token, at: position.index()) 'eachBound'
					bound.insert(named.value)
				end 'eachBound'
			end 'bindsNames'
		end 'eachToken'

		return Self{declaredHere: declared, boundHere: bound, corpus: corpus}
	end 'of'

	function namesAType(tokens TokenArray, at ElementIndex) returns bool
		let name = lspTokenAt(tokens, index: at).value

		if self.shadowedAt(tokens, at: at) 'aLocalOfThatName'
			return false
		end 'aLocalOfThatName'

		if self.declaredHere.contains(name) or compilerOwnsTheTypeNamed(tokens, at: at) 'declaredOrOwned'
			return true
		end 'declaredOrOwned'

		match self.corpus 'held'
			loaded(_, signatures, readerPath) then return signatures.isBuiltinGenericBaseName(name) or signatures.typeHeadKindOf(name, readerFilePath: readerPath) != TypeHeadKind.absent
			unavailable then return false
		end 'held'
	end 'namesAType'

	function namesAQualifiedType(tokens TokenArray, at ElementIndex) returns bool
		match self.corpus 'held'
			loaded(_, signatures, readerPath) then return segmentOfAQualifiedType(tokens, index: at, signatures: signatures, readerFilePath: readerPath) and not self.shadowedAt(tokens, at: chainHeadIndexOf(tokens, index: at))
			unavailable then return false
		end 'held'
	end 'namesAQualifiedType'

	// Asked for every identifier, so the set lookup comes first: the backward walk in
	// `definitionBindsLocally` runs only for a name some binder in the file spells.
	function shadowedAt(tokens TokenArray, at ElementIndex) returns bool
		let name = lspTokenAt(tokens, index: at).value

		return self.boundHere.contains(name) and definitionBindsLocally(tokens, before: at, name: name)
	end 'shadowedAt'
end 'SemanticTypeNames'

function declareNameAt(tokens TokenArray, at ElementIndex, into DeclaredTypeNameSet)
	let named = try tokens.get(at) otherwise return

	if tokenCanBeAName(named) 'aName'
		into.insert(named.value)
	end 'aName'
end 'declareNameAt'

function declareExtensionParametersFrom(tokens TokenArray, at ElementIndex, corpus LspCorpus, into DeclaredTypeNameSet)
	let target = try tokens.get(at) otherwise return

	if not tokenCanBeAName(target) 'noTarget'
		return
	end 'noTarget'

	match corpus 'held'
		loaded(_, signatures, _) then declareEachName(extensionTargetParamNames(signatures.extensionTargetOf(target.value)), into: into)
		unavailable then return
	end 'held'
end 'declareExtensionParametersFrom'

function declareEachName(names NameRoster, into DeclaredTypeNameSet)
	for name in names 'eachName'
		into.insert(name)
	end 'eachName'
end 'declareEachName'

function declareTypeParametersFrom(tokens TokenArray, at ElementIndex, into DeclaredTypeNameSet)
	var parameter = at

	while tokenKindAt(tokens, index: parameter) == TokenKind.identifier 'eachParameter'
		declareNameAt(tokens, at: parameter, into: into)

		if tokenKindAt(tokens, index: parameter + 1) != TokenKind.comma 'lastOne'
			break
		end 'lastOne'

		parameter = parameter + TokensPerQualifierSegment
	end 'eachParameter'
end 'declareTypeParametersFrom'

function compilerOwnsTheTypeNamed(tokens TokenArray, at ElementIndex) returns bool
	let name = lspTokenAt(tokens, index: at).value

	if isBuiltinManagedTypeName(name) or isSizedTypeName(name) or namesAPrimitiveType(name) 'aBuiltinType'
		return true
	end 'aBuiltinType'

	if not isCompilerReservedName(name) or tokenKindAt(tokens, index: at + 1) != TokenKind.dot 'notAQualifier'
		return false
	end 'notAQualifier'

	let member = try tokens.get(at + TokensPerQualifierSegment) otherwise return false

	if not tokenCanBeAName(member) 'noMember'
		return false
	end 'noMember'

	let callee = joinQualifiedName(name, member: member.value)

	return isCompilerQualifierCallee(callee)
end 'compilerOwnsTheTypeNamed'
