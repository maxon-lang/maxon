// `textDocument/definition` — the declaration the name under a cursor refers to.
//
// ⭐⭐ **THE BUFFER'S OWN TOKEN STREAM ANSWERS FIRST, AND THAT IS THE DESIGN RATHER THAN A SHORTCUT.**
// An editor asks for a definition while the buffer is mid-edit, so the text a server holds usually does
// not compile — and every fixture in `tests/lsp/definition-*.maxtest` is such a buffer (`returns
// int`, `var x int`: E3005 and E2010 respectively). A resolver built on `loadProject` +
// `queryAllModule` would answer nothing for exactly the buffers an editor asks about. `tokenize`
// succeeds on all of them, so the names, the keywords and the block labels are all there.
//
// ⇒ **A NAME THE BUFFER DOES NOT DECLARE IS THEN LOOKED UP IN THE PROJECT**, through `LspWorkspace`'s
// corpus — which is a lex and a signature fold and is likewise not a compile. `definitionInTheCorpus`
// states what that half may and may not decide.
//
// ⇒ **A NAME NOBODY DECLARES THROWS RATHER THAN RESOLVING TO A POSITION**, because an answer carrying
// `0:0` is indistinguishable from a real declaration at `0:0` — and the same rule holds one layer up,
// where LSP's own spelling for "nothing here" is a `null` result. `definition on keyword returns nothing`
// in `tests/lsp/definition-scope.maxtest` is what says so from the client's side.

module function definitionServedMethods() returns LspMethodArray
	var served = LspMethodArray.create(0)
	served.push(LspMethod.definition)
	return served
end 'definitionServedMethods'

module function definitionAnswer(request LspRequest) returns LspAnswer throws LspParamsError
	let position = try lspPositionMember(request.incoming, of: request.params, key: LspPositionKey)

	// A buffer that does not LEX has no name under the cursor to resolve — an answer, not a refusal.
	let tokens = try tokenize(request.text, keywords: request.keywords) otherwise return LspAnswer.nothing()
	let lines = LspLineIndex.build(request.text)
	let offset = lines.offsetOf(request.text, position: position)

	// ⚠ The in-buffer walk answers FIRST and the corpus is only its miss path. A local must shadow
	// every declaration the project holds, and the buffer is the only thing that can answer at all for
	// a name the author is in the middle of typing.
	let target = try definitionTarget(request.text, keywords: request.keywords, tokens: tokens, at: offset) otherwise return definitionAcrossFiles(request, tokens: tokens, offset: offset)

	return definitionLocationAnswer(request.uri, source: request.text, lines: lines, name: target)
end 'definitionAnswer'

// The token that DECLARES whatever the cursor is on.
function definitionTarget(text String, keywords KeywordTable, tokens TokenArray, at ByteOffset) returns Token throws LspDeclarationLookupError
	// Which token the cursor is on is `lspTokenAtCursor`'s answer and not one taken here: `textDocument/hover`
	// renders the same one, and an editor that jumped to a name that hover described as something else would
	// be reading two different rules.
	let cursor = try lspTokenAtCursor(tokens, offset: at) otherwise throw LspDeclarationLookupError.nothingThere
	let cursorToken = lspTokenAt(tokens, index: cursor)

	// ⚠ `tokenCanBeAName`, not `kind == identifier`. A keyword may be a declared name here — `from` is
	// one, and `stdlib/FilePath.maxon` declares `public static function from` with it
	// (`specs/keyword-as-a-declared-name.md`) — so demanding an identifier answers nothing for a large
	// part of the standard library's own surface. A literal or a punctuator still declares nothing, and
	// jumping from one takes an editor somewhere arbitrary.
	if not tokenCanBeAName(cursorToken) 'notAName'
		throw LspDeclarationLookupError.nothingThere
	end 'notAName'

	let name = cursorToken.value

	// `p.x` names a MEMBER: the enclosing function's locals are the wrong place to look, and a local of
	// the same name would be a confident wrong line rather than a miss.
	if lspCursorNamesAMember(tokens, cursor: cursor) 'aMember'
		return try definitionMemberOfTheReceiver(text, keywords: keywords, tokens: tokens, cursor: cursor)
	end 'aMember'

	// A binding in scope shadows any declaration of the same name elsewhere in the document, so the
	// local walk answers first and the whole-document search is what it falls through to.
	return try definitionLocalBinding(tokens, before: cursor, name: name) otherwise try definitionBareNameDeclaration(tokens, cursor: cursor, name: name)
end 'definitionTarget'

// A bare name inside a type's body binds to the type's own member before any free declaration of that
// name, as a bare call does in the compiler.
function definitionBareNameDeclaration(tokens TokenArray, cursor ElementIndex, name ByteArray) returns Token throws LspDeclarationLookupError
	let enclosing = lspEnclosingTypeAtToken(tokens, index: cursor)

	match enclosing 'enclosing'
		inside(typeName) then return try definitionMemberOfOwner(tokens, owner: String.from(typeName), member: name, enclosing: enclosing) otherwise try definitionDeclarationOf(tokens, name: name)
		atFileScope then return try definitionDeclarationOf(tokens, name: name)
	end 'enclosing'
end 'definitionBareNameDeclaration'

module function definitionBindsLocally(tokens TokenArray, before ElementIndex, name ByteArray) returns bool
	return (try definitionLocalBinding(tokens, before: before, name: name) otherwise return false).value.equals(name)
end 'definitionBindsLocally'

module function nameableQualifiedTypeEndingAt(tokens TokenArray, index ElementIndex, signatures ProgramSignatures, readerFilePath FilePath) returns ChainType throws AbsentError
	let head = chainHeadIndexOf(tokens, index: index)

	if head == index 'noQualifier'
		throw AbsentError.absent
	end 'noQualifier'

	let headIsALocal = definitionBindsLocally(tokens, before: head, name: lspTokenAt(tokens, index: head).value)

	match qualifiedTypeSpanning(tokens, head: head, index: index, signatures: signatures, readerFilePath: readerFilePath, headIsAValue: headIsALocal) 'span'
		within(declaration, endIndex) then return try nameableTypeEndingAt(declaration, endIndex: endIndex, index: index)
		outside then throw AbsentError.absent
	end 'span'
end 'nameableQualifiedTypeEndingAt'

function nameableTypeEndingAt(declaration ChainType, endIndex ElementIndex, index ElementIndex) returns ChainType throws AbsentError
	if endIndex != index or not declaration.isNameable() 'aQualifierSegmentOrHidden'
		throw AbsentError.absent
	end 'aQualifierSegmentOrHidden'

	return declaration
end 'nameableTypeEndingAt'

// ⭐⭐ **THE SCOPE WALK. Backwards from the cursor, and what makes it a SCOPE walk rather than a
// nearest-name search is that it steps OVER blocks that had already closed.** Without that, a use
// after an inner block resolves to the inner block's shadowing declaration instead of the enclosing
// one — the same wrong line a resolver that merely matched names would give.
//
// A `function` or `type` opener is not counted and does not need to be: any EARLIER function body is
// enclosed by an `end` the walk has already stepped over, while a genuinely enclosing one (a closure's,
// whose body does capture the outer locals) has none.
function definitionLocalBinding(tokens TokenArray, before ElementIndex, name ByteArray) returns Token throws LspDeclarationLookupError
	var closedLabels = TokenIndexArray.create(0)
	var i = before

	while i > 0 'walkBack'
		i = i - 1
		let token = try tokens.get(i) otherwise throw LspDeclarationLookupError.nothingThere

		if token.kind == TokenKind.charLiteral 'blockLabel'
			definitionTrackBlockNesting(closedLabels, tokens: tokens, at: i)
			continue
		end 'blockLabel'

		if not closedLabels.isEmpty() 'insideABlockThatAlreadyClosed'
			continue
		end 'insideABlockThatAlreadyClosed'

		let bound = try definitionBoundName(tokens, keyword: token, at: i, name: name) otherwise continue
		return bound
	end 'walkBack'

	throw LspDeclarationLookupError.nothingThere
end 'definitionLocalBinding'

// ⭐ A `'label'` is either a block's OPENER or the `end` that closes it, told apart by the token before
// it — and matching the two BY NAME is precisely what Maxon's `end 'label'` rule is for. Walking
// backward the closer is met first, so its label is pushed and its own opener pops it. Matching by
// name is also what keeps an ordinary character literal (`let c = 'a'`) from being read as a block.
function definitionTrackBlockNesting(closedLabels TokenIndexArray, tokens TokenArray, at ElementIndex)
	if definitionClosesABlock(tokens, at: at) 'aCloser'
		closedLabels.push(at)
		return
	end 'aCloser'

	if closedLabels.isEmpty() 'nothingHadClosed'
		return
	end 'nothingHadClosed'

	let pending = try closedLabels.get(closedLabels.count() - 1) otherwise panic("definitionTrackBlockNesting: the stack was tested non-empty one line above")
	let closer = try tokens.get(pending) otherwise panic("definitionTrackBlockNesting: {pending} was pushed from this same token array")
	let opener = try tokens.get(at) otherwise panic("definitionTrackBlockNesting: the caller read the token at {at} before calling")

	if not closer.value.equals(opener.value) 'notTheBlockThatClosed'
		return
	end 'notTheBlockThatClosed'

	_ = try closedLabels.pop() otherwise panic("definitionTrackBlockNesting: the stack was tested non-empty above")
end 'definitionTrackBlockNesting'

function definitionClosesABlock(tokens TokenArray, at ElementIndex) returns bool
	if at == 0 'nothingBefore'
		return false
	end 'nothingBefore'

	let before = try tokens.get(at - 1) otherwise return false
	return before.kind == TokenKind.end
end 'definitionClosesABlock'

// The local binding forms this resolver knows: the four a KEYWORD introduces, plus a function's
// parameter list.
//
// ⚠ **A PATTERN binding is deliberately absent** — a union arm's `success(value)`, a handler's
// `otherwise (e)`. Those are introduced by punctuation rather than by a keyword, and reading a `(` as a
// declaration would be answering from shape. They resolve to nothing, which is a miss rather than a
// confident wrong line.
module function definitionIntroducesNames(kind TokenKind) returns bool
	return bindingKeywordSpells(kind) or kind == TokenKind.for or kind == TokenKind.function
end 'definitionIntroducesNames'

function definitionBoundName(tokens TokenArray, keyword Token, at ElementIndex, name ByteArray) returns Token throws LspDeclarationLookupError
	if not definitionIntroducesNames(keyword.kind) 'bindsNothing'
		throw LspDeclarationLookupError.nothingThere
	end 'bindsNothing'

	for bound in definitionBoundTokensAt(tokens, keyword: keyword, at: at) 'eachBound'
		if bound.value.equals(name) 'thisOne'
			return bound
		end 'thisOne'
	end 'eachBound'

	throw LspDeclarationLookupError.nothingThere
end 'definitionBoundName'

module function definitionBoundTokensAt(tokens TokenArray, keyword Token, at ElementIndex) returns TokenArray
	if bindingKeywordSpells(keyword.kind) 'oneBinding'
		return definitionBindingTokensAt(tokens, at: at + 1)
	end 'oneBinding'

	if keyword.kind == TokenKind.for 'loopVariables'
		return definitionLoopVariableTokens(tokens, from: at + 1)
	end 'loopVariables'

	if keyword.kind == TokenKind.function and definitionFunctionKeywordWritesAType(tokens, at: at) 'aFunctionType'
		return TokenArray.create(0)
	end 'aFunctionType'

	if keyword.kind == TokenKind.function 'parameters'
		return definitionParameterTokens(tokens, from: at)
	end 'parameters'

	panic("definitionBoundTokensAt: '{keyword.kind.rawValue}' introduces no names — `definitionIntroducesNames` is the gate, and every caller asks it first")
end 'definitionBoundTokensAt'

// A `function(` whose `)` is not followed by `gives` is a function TYPE: its list holds types and
// binds no names, and read as a parameter list it would shadow the types it writes.
function definitionFunctionKeywordWritesAType(tokens TokenArray, at ElementIndex) returns bool
	let open = at + 1

	if tokenKindAt(tokens, index: open) != TokenKind.leftParen 'aDeclaration'
		return false
	end 'aDeclaration'

	let close = ParenGroups.create().closeOf(tokens, open: open)
	return tokenKindAt(tokens, index: close + 1) != TokenKind.gives
end 'definitionFunctionKeywordWritesAType'

function definitionBindingTokensAt(tokens TokenArray, at ElementIndex) returns TokenArray
	var bound = TokenArray.create(0)
	let token = try tokens.get(at) otherwise return bound

	if tokenCanBeAName(token) 'aName'
		bound.push(token)
	end 'aName'

	return bound
end 'definitionBindingTokensAt'

// A loop's variables are every name between `for` and its `in` — one for `for item in items`, two for
// `for (key, value) in map`. A line break ends the search as well: an `in` that never arrives means the
// buffer is mid-edit, not that the rest of the file is the binding list.
function definitionLoopVariableTokens(tokens TokenArray, from ElementIndex) returns TokenArray
	var bound = TokenArray.create(0)
	var i = from

	while i < tokens.count() 'scan'
		let token = lspTokenAt(tokens, index: i)

		if token.kind == TokenKind.in or token.kind == TokenKind.newline 'theBindingsEnd'
			break
		end 'theBindingsEnd'

		if token.kind == TokenKind.identifier 'aVariable'
			bound.push(token)
		end 'aVariable'

		i = i + 1
	end 'scan'

	return bound
end 'definitionLoopVariableTokens'

// A parameter name is the first token inside the parentheses and the one after each top-level comma;
// everything else between them is a type, a default value, or a nested list.
function definitionParameterTokens(tokens TokenArray, from ElementIndex) returns TokenArray
	var bound = TokenArray.create(0)
	var i = from
	var depth = 0 as NestingDepth
	var sawTheList = false
	var expectingAName = false

	while i < tokens.count() 'scanList'
		let token = lspTokenAt(tokens, index: i)
		i = i + 1

		if token.kind == TokenKind.leftParen 'opensAList'
			depth = depth + 1
			sawTheList = true
			expectingAName = depth == 1
			continue
		end 'opensAList'

		if token.kind == TokenKind.rightParen 'closesAList'
			depth = depth - 1

			if depth == 0 'theListEnds'
				break
			end 'theListEnds'

			continue
		end 'closesAList'

		// A declaration's parameters open on the keyword's own line, so a line break before any `(` is a
		// truncated buffer rather than a list to walk.
		if not sawTheList and token.kind == TokenKind.newline 'noListAtAll'
			break
		end 'noListAtAll'

		if depth == 1 and token.kind == TokenKind.comma 'nextParameter'
			expectingAName = true
			continue
		end 'nextParameter'

		if not expectingAName 'notANamePosition'
			continue
		end 'notANamePosition'

		expectingAName = false

		if token.kind == TokenKind.identifier 'aParameter'
			bound.push(token)
		end 'aParameter'
	end 'scanList'

	return bound
end 'definitionParameterTokens'

function definitionIdentifierNamed(tokens TokenArray, at ElementIndex, name ByteArray) returns Token throws LspDeclarationLookupError
	let token = try tokens.get(at) otherwise throw LspDeclarationLookupError.nothingThere

	if not tokenCanBeAName(token) or not token.value.equals(name) 'notThatName'
		throw LspDeclarationLookupError.nothingThere
	end 'notThatName'

	return token
end 'definitionIdentifierNamed'

// Where the document declares `name`, in the order the file states it. A bare name only: a member name
// is declared by every type that has one, so a member is located on its owner's body by
// `lspMemberDeclaredBy`. A `function` a terminated body holds is a method and is skipped likewise.
function definitionDeclarationOf(tokens TokenArray, name ByteArray) returns Token throws LspDeclarationLookupError
	let blocks = lspDocumentBlocks(tokens)

	for (iter, keyword) in tokens.withIterator() 'eachToken'
		let declared = try definitionDeclaredName(tokens, blocks: blocks, keyword: keyword, at: iter.index(), name: name) otherwise continue

		if keyword.kind == TokenKind.function and lspLineIsAMemberLine(blocks, line: lspLineOf(keyword.line)) 'aMethod'
			continue
		end 'aMethod'

		return declared
	end 'eachToken'

	throw LspDeclarationLookupError.nothingThere
end 'definitionDeclarationOf'

// Only a type the buffer declares answers here; any other receiver type throws and the project's index
// takes the request.
function definitionMemberOfTheReceiver(text String, keywords KeywordTable, tokens TokenArray, cursor ElementIndex) returns Token throws LspDeclarationLookupError
	let owner = try lspMemberOwnerOfTheCursor(LspCorpus.unavailable, text: text, tokens: tokens, keywords: keywords, cursor: cursor)

	return try definitionMemberOfOwner(tokens, owner: owner, member: lspTokenAt(tokens, index: cursor).value, enclosing: lspEnclosingTypeAtToken(tokens, index: cursor))
end 'definitionMemberOfTheReceiver'

function definitionMemberOfOwner(tokens TokenArray, owner String, member ByteArray, enclosing LspEnclosingType) returns Token throws LspDeclarationLookupError
	let found = try lspMemberDeclaredBy(tokens, blocks: lspDocumentBlocks(tokens), owner: owner, member: member) otherwise throw LspDeclarationLookupError.nothingThere

	if not lspMemberReachable(found, site: lspReaderSite(enclosing, typeName: found.bodyName, sharesTheTypesFile: true)) 'hiddenHere'
		throw LspDeclarationLookupError.nothingThere
	end 'hiddenHere'

	return lspTokenAt(tokens, index: found.nameIndex)
end 'definitionMemberOfOwner'

// No tier test: the project's index has already filtered the declaring file for this reader, and its
// bodies are the project's copy, not the open buffer.
function definitionPublishedMember(tokens TokenArray, owner String, member ByteArray) returns Token throws LspDeclarationLookupError
	let found = try lspMemberDeclaredOrPublished(tokens, blocks: lspDocumentBlocks(tokens), owner: owner, member: member) otherwise throw LspDeclarationLookupError.nothingThere

	return lspTokenAt(tokens, index: found.nameIndex)
end 'definitionPublishedMember'

function definitionDeclaredName(tokens TokenArray, blocks LspDocumentBlockArray, keyword Token, at ElementIndex, name ByteArray) returns Token throws LspDeclarationLookupError
	if definitionDeclaresAType(keyword.kind) 'aType'
		return try definitionIdentifierNamed(tokens, at: at + 1, name: name)
	end 'aType'

	if keyword.kind == TokenKind.function 'aFunction'
		return try definitionIdentifierNamed(tokens, at: try lspFunctionNameIndex(tokens, at: at) otherwise throw LspDeclarationLookupError.nothingThere, name: name)
	end 'aFunction'

	if keyword.kind == TokenKind.let or keyword.kind == TokenKind.var 'aBinding'
		return try definitionModuleBindingNamed(tokens, blocks: blocks, at: at + 1, name: name)
	end 'aBinding'

	throw LspDeclarationLookupError.nothingThere
end 'definitionDeclaredName'

// ⚠ `extension` is NOT here: it names a type declared elsewhere rather than declaring one.
function definitionDeclaresAType(kind TokenKind) returns bool
	return kind == TokenKind.type or kind == TokenKind.enum or kind == TokenKind.union or kind == TokenKind.interface or kind == TokenKind.typealias
end 'definitionDeclaresAType'

// A `let` or `var` inside a block is a local or a member, reached by the local walk or the owner's
// body. Matching one here by name would land a bare name on an unrelated function's local or another
// type's field.
function definitionModuleBindingNamed(tokens TokenArray, blocks LspDocumentBlockArray, at ElementIndex, name ByteArray) returns Token throws LspDeclarationLookupError
	let named = try definitionIdentifierNamed(tokens, at: at, name: name)

	match lspInnermostBlockKindAt(blocks, line: lspLineOf(named.line)) 'scope'
		absent then return named
		found then throw LspDeclarationLookupError.nothingThere
	end 'scope'
end 'definitionModuleBindingNamed'

function definitionDeclarationAt(tokens TokenArray, site LspDeclaringSite, name ByteArray) returns Token throws LspDeclarationLookupError
	match site 'site'
		ofAMember(_, owner) then return try definitionPublishedMember(tokens, owner: owner, member: name)
		ofAName then return try definitionDeclarationOf(tokens, name: name)
	end 'site'
end 'definitionDeclarationAt'

function definitionLocationAnswer(uri String, source String, lines LspLineIndex, name Token) returns LspAnswer
	var doc = JsonDoc.create()

	// The range an editor highlights on arrival is the declared NAME, not its line and not the whole
	// declaration.
	var location = LspJsonObject.create(doc)
	location.put(LspUriKey, value: JsonNode.stringNode(uri))
	location.putNode(LspRangeKey, value: lspSpanRangeNode(doc, source: source, index: lines, span: LspSpan.create(name.startByte, endByte: name.endByte)))

	return LspAnswer.of(doc, result: location.finish())
end 'definitionLocationAnswer'

function definitionAcrossFiles(request LspRequest, tokens TokenArray, offset ByteOffset) returns LspAnswer
	let cursor = try lspTokenAtCursor(tokens, offset: offset) otherwise return LspAnswer.nothing()

	if not tokenCanBeAName(lspTokenAt(tokens, index: cursor)) 'notAName'
		return LspAnswer.nothing()
	end 'notAName'

	var corpus = lspDocumentCorpus(request.workspace, uri: request.uri)

	match corpus 'held'
		loaded(project, _, _) then return project.definitionInTheCorpus(corpus, text: request.text, tokens: tokens, cursor: cursor)
		unavailable then return LspAnswer.nothing()
	end 'held'
end 'definitionAcrossFiles'

extension Project
	// The index answers WHICH FILE; the token walk above answers WHERE IN IT. `StructLayout`,
	// `EnumLayout`, `FunctionDeclSite` and `SweptDeclaration` carry a `declFilePath` and no name position,
	// but the split holds even where a record does carry one, for two reasons:
	//
	// Running the same walk for both halves is what keeps an in-buffer answer and a cross-file answer
	// from drifting — a member is located through `lspMemberDeclaredBy` in both.
	//
	// ⚠ And an index position is not in the unit an answer is spelled in. `lspSpanRangeNode` converts a
	// byte span to LSP's UTF-16 coordinates, while the index holds 1-based compiler coordinates; a second
	// converter here is the defect `tests/lsp/position-characters.maxtest` exists to catch.
	module function definitionInTheCorpus(corpus LspCorpus, text String, tokens TokenArray, cursor ElementIndex) returns LspAnswer
		let site = try lspDeclaringSiteOfTheCursor(corpus, text: text, tokens: tokens, keywords: self.keywords, cursor: cursor) otherwise return LspAnswer.nothing()
		return self.definitionInAnotherFile(site, name: lspTokenAt(tokens, index: cursor).value)
	end 'definitionInTheCorpus'

	function definitionInAnotherFile(site LspDeclaringSite, name ByteArray) returns LspAnswer
		let declFile = lspDeclaringSitePath(site)

		view declTokens = try queryActiveTokens(self, path: declFile) otherwise return LspAnswer.nothing()
		let declared = try definitionDeclarationAt(declTokens, site: site, name: name) otherwise return LspAnswer.nothing()
		view entry = try sourceEntryOf(self, path: declFile) otherwise return LspAnswer.nothing()
		let text = entry.content

		return definitionLocationAnswer(lspFileUri(declFile), source: text, lines: LspLineIndex.build(text), name: declared)
	end 'definitionInAnotherFile'
end 'Project'
