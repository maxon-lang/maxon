// `textDocument/definition` — the declaration the name under a cursor refers to.
//
// ⭐⭐ **THE BUFFER'S OWN TOKEN STREAM ANSWERS FIRST, AND THAT IS THE DESIGN RATHER THAN A SHORTCUT.**
// An editor asks for a definition while the buffer is mid-edit, so the text a server holds usually does
// not compile — and every fixture in `tests/lsp/definition-*.test.maxon` is such a buffer (`returns
// int`, `var x int`: E3005 and E2010 respectively). A resolver built on `loadProject` +
// `queryAllModule` would answer nothing for exactly the buffers an editor asks about. `tokenize`
// succeeds on all of them, so the names, the keywords and the block labels are all there.
//
// ⇒ **A NAME THE BUFFER DOES NOT DECLARE IS THEN LOOKED UP IN THE PROJECT**, through `LspWorkspace`'s
// corpus — which is a lex and a signature fold and is likewise not a compile. `definitionInTheCorpus`
// states what that half may and may not decide.
//
// ⇒ **A NAME NOBODY DECLARES THROWS RATHER THAN RESOLVING TO A POSITION**, because an answer carrying
// `0:0` is indistinguishable from a real declaration at `0:0` — and the same rule holds one layer up,
// where LSP's own spelling for "nothing here" is a `null` result. `definition on keyword returns nothing`
// in `tests/lsp/definition-scope.test.maxon` is what says so from the client's side.

// Nothing under the cursor, or nothing that declares what is. ⭐ A THROW rather than a token standing
// for "none", for the reason `TypeNameRegistry.declarationOf` throws: a not-found token would carry a
// real `0:0` position that a synthesized declaration also has. Every lookup below fails the same way, so
// there is one arm and not four spellings of absence.
enum DefinitionLookupError implements Error
	nothingThere
end 'DefinitionLookupError'

module function definitionServedMethods() returns LspMethodArray
	var served = LspMethodArray.create()
	served.push(LspMethod.definition)
	return served
end 'definitionServedMethods'

module function definitionAnswer(request LspRequest) returns LspAnswer throws LspParamsError
	let position = try lspPositionMember(request.incoming, of: request.params, key: LspPositionKey)

	// A buffer that does not LEX has no name under the cursor to resolve — an answer, not a refusal.
	let tokens = try tokenize(request.text, keywords: request.keywords) otherwise return LspAnswer.nothing()
	let lines = LspLineIndex.build(request.text)
	let offset = lines.offsetOf(request.text, position: position)

	// ⚠ The in-buffer walk answers FIRST and the corpus is only its miss path. A local must shadow
	// every declaration the project holds, and the buffer is the only thing that can answer at all for
	// a name the author is in the middle of typing.
	let target = try definitionTarget(tokens, at: offset) otherwise return definitionAcrossFiles(request, tokens: tokens, offset: offset)

	return definitionLocationAnswer(request.uri, source: request.text, lines: lines, name: target)
end 'definitionAnswer'

// The token that DECLARES whatever the cursor is on.
function definitionTarget(tokens TokenArray, at ByteOffset) returns Token throws DefinitionLookupError
	// Which token the cursor is on is `lspTokenAtCursor`'s answer and not one taken here: `textDocument/hover`
	// renders the same one, and an editor that jumped to a name that hover described as something else would
	// be reading two different rules.
	let cursor = try lspTokenAtCursor(tokens, offset: at) otherwise throw DefinitionLookupError.nothingThere
	let cursorToken = lspTokenAt(tokens, index: cursor)

	// ⚠ `tokenCanBeAName`, not `kind == identifier`. A keyword may be a declared name here — `from` is
	// one, and `stdlib/FilePath.maxon` declares `public static function from` with it
	// (`specs/keyword-as-a-declared-name.md`) — so demanding an identifier answers nothing for a large
	// part of the standard library's own surface. A literal or a punctuator still declares nothing, and
	// jumping from one takes an editor somewhere arbitrary.
	if not tokenCanBeAName(cursorToken) 'notAName'
		throw DefinitionLookupError.nothingThere
	end 'notAName'

	let name = cursorToken.value

	// `p.x` names a MEMBER: the enclosing function's locals are the wrong place to look, and a local of
	// the same name would be a confident wrong line rather than a miss.
	if definitionNamesAMember(tokens, cursor: cursor) 'aMember'
		return try definitionDeclarationOf(tokens, name: name)
	end 'aMember'

	// A binding in scope shadows any declaration of the same name elsewhere in the document, so the
	// local walk answers first and the whole-document search is what it falls through to.
	return try definitionLocalBinding(tokens, before: cursor, name: name) otherwise try definitionDeclarationOf(tokens, name: name)
end 'definitionTarget'

function definitionNamesAMember(tokens TokenArray, cursor TokenIndex) returns bool
	if cursor == 0 'nothingBefore'
		return false
	end 'nothingBefore'

	let before = try tokens.get(cursor - 1) otherwise return false
	return before.kind == TokenKind.dot
end 'definitionNamesAMember'

// ⭐⭐ **THE SCOPE WALK. Backwards from the cursor, and what makes it a SCOPE walk rather than a
// nearest-name search is that it steps OVER blocks that had already closed.** Without that, a use
// after an inner block resolves to the inner block's shadowing declaration instead of the enclosing
// one — the same wrong line a resolver that merely matched names would give.
//
// A `function` or `type` opener is not counted and does not need to be: any EARLIER function body is
// enclosed by an `end` the walk has already stepped over, while a genuinely enclosing one (a closure's,
// whose body does capture the outer locals) has none.
function definitionLocalBinding(tokens TokenArray, before TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	var closedLabels = TokenIndexArray.create()
	var i = before

	while i > 0 'walkBack'
		i = i - 1
		let token = try tokens.get(i) otherwise throw DefinitionLookupError.nothingThere

		if token.kind == TokenKind.charLiteral 'blockLabel'
			definitionTrackBlockNesting(closedLabels, tokens: tokens, at: i)
			continue
		end 'blockLabel'

		if not closedLabels.isEmpty() 'insideABlockThatAlreadyClosed'
			continue
		end 'insideABlockThatAlreadyClosed'

		let bound = try definitionBoundName(tokens, keyword: token, at: i, name: name) otherwise continue
		return bound
	end 'walkBack'

	throw DefinitionLookupError.nothingThere
end 'definitionLocalBinding'

// ⭐ A `'label'` is either a block's OPENER or the `end` that closes it, told apart by the token before
// it — and matching the two BY NAME is precisely what Maxon's `end 'label'` rule is for. Walking
// backward the closer is met first, so its label is pushed and its own opener pops it. Matching by
// name is also what keeps an ordinary character literal (`let c = 'a'`) from being read as a block.
function definitionTrackBlockNesting(closedLabels TokenIndexArray, tokens TokenArray, at TokenIndex)
	if definitionClosesABlock(tokens, at: at) 'aCloser'
		closedLabels.push(at)
		return
	end 'aCloser'

	if closedLabels.isEmpty() 'nothingHadClosed'
		return
	end 'nothingHadClosed'

	let pending = try closedLabels.get(closedLabels.count() - 1) otherwise panic("definitionTrackBlockNesting: the stack was tested non-empty one line above")
	let closer = try tokens.get(pending) otherwise panic("definitionTrackBlockNesting: {pending} was pushed from this same token array")
	let opener = try tokens.get(at) otherwise panic("definitionTrackBlockNesting: the caller read the token at {at} before calling")

	if not closer.value.equals(opener.value) 'notTheBlockThatClosed'
		return
	end 'notTheBlockThatClosed'

	_ = try closedLabels.pop() otherwise panic("definitionTrackBlockNesting: the stack was tested non-empty above")
end 'definitionTrackBlockNesting'

function definitionClosesABlock(tokens TokenArray, at TokenIndex) returns bool
	if at == 0 'nothingBefore'
		return false
	end 'nothingBefore'

	let before = try tokens.get(at - 1) otherwise return false
	return before.kind == TokenKind.end
end 'definitionClosesABlock'

// The local binding forms this resolver knows: the three a KEYWORD introduces, plus a function's
// parameter list.
//
// ⚠ **A PATTERN binding is deliberately absent** — a union arm's `success(value)`, a handler's
// `otherwise (e)`. Those are introduced by punctuation rather than by a keyword, and reading a `(` as a
// declaration would be answering from shape. They resolve to nothing, which is a miss rather than a
// confident wrong line.
function definitionBoundName(tokens TokenArray, keyword Token, at TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	if keyword.kind == TokenKind.let or keyword.kind == TokenKind.var 'oneBinding'
		return try definitionIdentifierNamed(tokens, at: at + 1, name: name)
	end 'oneBinding'

	if keyword.kind == TokenKind.for 'loopVariables'
		return try definitionLoopVariableNamed(tokens, from: at + 1, name: name)
	end 'loopVariables'

	if keyword.kind == TokenKind.function 'parameters'
		return try definitionParameterNamed(tokens, from: at, name: name)
	end 'parameters'

	throw DefinitionLookupError.nothingThere
end 'definitionBoundName'

function definitionIdentifierNamed(tokens TokenArray, at TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	let token = try tokens.get(at) otherwise throw DefinitionLookupError.nothingThere

	if not tokenCanBeAName(token) or not token.value.equals(name) 'notThatName'
		throw DefinitionLookupError.nothingThere
	end 'notThatName'

	return token
end 'definitionIdentifierNamed'

// A loop's variables are every name between `for` and its `in` — one for `for item in items`, two for
// `for (key, value) in map`. A line break ends the search as well: an `in` that never arrives means the
// buffer is mid-edit, not that the rest of the file is the binding list.
function definitionLoopVariableNamed(tokens TokenArray, from TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	var i = from

	while i < tokens.count() 'scan'
		let token = try tokens.get(i) otherwise throw DefinitionLookupError.nothingThere
		i = i + 1

		if token.kind == TokenKind.in or token.kind == TokenKind.newline 'theBindingsEnd'
			throw DefinitionLookupError.nothingThere
		end 'theBindingsEnd'

		if token.kind == TokenKind.identifier and token.value.equals(name) 'thisOne'
			return token
		end 'thisOne'
	end 'scan'

	throw DefinitionLookupError.nothingThere
end 'definitionLoopVariableNamed'

// A parameter name is the first token inside the parentheses and the one after each top-level comma;
// everything else between them is a type, a default value, or a nested list.
function definitionParameterNamed(tokens TokenArray, from TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	var i = from
	var depth = 0
	var sawTheList = false
	var expectingAName = false

	while i < tokens.count() 'scanList'
		let token = try tokens.get(i) otherwise throw DefinitionLookupError.nothingThere
		i = i + 1

		if token.kind == TokenKind.leftParen 'opensAList'
			depth = depth + 1
			sawTheList = true
			expectingAName = depth == 1
			continue
		end 'opensAList'

		if token.kind == TokenKind.rightParen 'closesAList'
			depth = depth - 1

			if depth == 0 'theListEnds'
				throw DefinitionLookupError.nothingThere
			end 'theListEnds'

			continue
		end 'closesAList'

		// A declaration's parameters open on the keyword's own line, so a line break before any `(` is a
		// truncated buffer rather than a list to walk.
		if not sawTheList and token.kind == TokenKind.newline 'noListAtAll'
			throw DefinitionLookupError.nothingThere
		end 'noListAtAll'

		if depth == 1 and token.kind == TokenKind.comma 'nextParameter'
			expectingAName = true
			continue
		end 'nextParameter'

		if not expectingAName 'notANamePosition'
			continue
		end 'notANamePosition'

		expectingAName = false

		if token.kind == TokenKind.identifier and token.value.equals(name) 'thisParameter'
			return token
		end 'thisParameter'
	end 'scanList'

	throw DefinitionLookupError.nothingThere
end 'definitionParameterNamed'

// Where the document declares `name`, in the order the file states it.
function definitionDeclarationOf(tokens TokenArray, name ByteArray) returns Token throws DefinitionLookupError
	for (iter, keyword) in tokens.withIterator() 'eachToken'
		let declared = try definitionDeclaredName(tokens, keyword: keyword, at: iter.index() as TokenIndex, name: name) otherwise continue
		return declared
	end 'eachToken'

	throw DefinitionLookupError.nothingThere
end 'definitionDeclarationOf'

function definitionDeclaredName(tokens TokenArray, keyword Token, at TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	if definitionDeclaresAType(keyword.kind) 'aType'
		return try definitionIdentifierNamed(tokens, at: at + 1, name: name)
	end 'aType'

	if keyword.kind == TokenKind.function 'aFunction'
		return try definitionIdentifierNamed(tokens, at: try definitionFunctionNameIndex(tokens, at: at), name: name)
	end 'aFunction'

	if keyword.kind == TokenKind.let or keyword.kind == TokenKind.var 'aBinding'
		return try definitionFieldNamed(tokens, at: at + 1, name: name)
	end 'aBinding'

	throw DefinitionLookupError.nothingThere
end 'definitionDeclaredName'

// ⚠ `extension` is NOT here: it names a type declared elsewhere rather than declaring one.
function definitionDeclaresAType(kind TokenKind) returns bool
	return kind == TokenKind.type or kind == TokenKind.enum or kind == TokenKind.union or kind == TokenKind.interface or kind == TokenKind.typealias
end 'definitionDeclaresAType'

// `function Printable.print()` declares `print`; the name before the dot is the interface's, and it is
// declared where the interface is.
function definitionFunctionNameIndex(tokens TokenArray, at TokenIndex) returns TokenIndex throws DefinitionLookupError
	let afterTheFirstName = try tokens.get(at + 2) otherwise throw DefinitionLookupError.nothingThere
	return at + 3 if afterTheFirstName.kind == TokenKind.dot else at + 1
end 'definitionFunctionNameIndex'

// ⭐ **A `var`/`let` reaches the whole-document search only as a type's MEMBER, and the LANGUAGE tells a
// member from a local: a local binding never carries a type (E2010), so a name followed by anything
// other than `=` is a field.** Without that rule `p.x` resolves to an unrelated function's `var x = …` —
// a confident wrong line where nothing is the honest answer. A field carrying a declaration DEFAULT
// (`var value = 0`) falls on the far side of it and resolves to nothing; the reference server draws the
// same boundary, from indentation rather than from the annotation.
function definitionFieldNamed(tokens TokenArray, at TokenIndex, name ByteArray) returns Token throws DefinitionLookupError
	let named = try definitionIdentifierNamed(tokens, at: at, name: name)
	let afterTheName = try tokens.get(at + 1) otherwise throw DefinitionLookupError.nothingThere

	if afterTheName.kind == TokenKind.equals 'aLocalBinding'
		throw DefinitionLookupError.nothingThere
	end 'aLocalBinding'

	return named
end 'definitionFieldNamed'

function definitionLocationAnswer(uri String, source String, lines LspLineIndex, name Token) returns LspAnswer
	var doc = JsonDoc.create()

	// The range an editor highlights on arrival is the declared NAME, not its line and not the whole
	// declaration.
	var location = LspJsonObject.create(doc)
	location.put(LspUriKey, value: JsonNode.stringNode(uri))
	location.putNode(LspRangeKey, value: lspSpanRangeNode(doc, source: source, index: lines, span: LspSpan.create(name.startByte, endByte: name.endByte)))

	return LspAnswer.of(doc, result: location.finish())
end 'definitionLocationAnswer'

let TokensBetweenAReceiverAndItsMember = 2 as TokenIndex

function definitionAcrossFiles(request LspRequest, tokens TokenArray, offset ByteOffset) returns LspAnswer
	let cursor = try lspTokenAtCursor(tokens, offset: offset) otherwise return LspAnswer.nothing()

	if not tokenCanBeAName(lspTokenAt(tokens, index: cursor)) 'notAName'
		return LspAnswer.nothing()
	end 'notAName'

	match lspWorkspaceCorpus(lspDocumentPath(request.uri)) 'corpus'
		loaded(project, signatures, readerPath) then return project.definitionInTheCorpus(signatures, tokens: tokens, cursor: cursor, readerPath: readerPath)
		unavailable then return LspAnswer.nothing()
	end 'corpus'
end 'definitionAcrossFiles'

extension Project
	// The index answers WHICH FILE; the token walk above answers WHERE IN IT. `StructLayout`,
	// `EnumLayout`, `FunctionDeclSite` and `OverloadedDecl` carry a `declFilePath` and no name position,
	// but the split holds even where a record does carry one, for two reasons:
	//
	// Running the same walk for both halves is what keeps an in-buffer answer and a cross-file answer
	// from drifting — the rule that a `var` is a field only when it carries no `=` lives in
	// `definitionFieldNamed` and nowhere else.
	//
	// ⚠ And an index position is not in the unit an answer is spelled in. `lspSpanRangeNode` converts a
	// byte span to LSP's UTF-16 coordinates, while the index holds 1-based compiler coordinates; a second
	// converter here is the defect `tests/lsp/position-characters.test.maxon` exists to catch.
	module function definitionInTheCorpus(signatures ProgramSignatures, tokens TokenArray, cursor TokenIndex, readerPath FilePath) returns LspAnswer
		let declFile = try declaringFileOfTheCursor(signatures, tokens: tokens, cursor: cursor, readerPath: readerPath) otherwise return LspAnswer.nothing()
		return self.definitionInAnotherFile(declFile, name: lspTokenAt(tokens, index: cursor).value)
	end 'definitionInTheCorpus'

	function definitionInAnotherFile(declFile FilePath, name ByteArray) returns LspAnswer
		let declTokens = try queryActiveTokens(self, path: declFile) otherwise return LspAnswer.nothing()
		let declared = try definitionDeclarationOf(declTokens, name: name) otherwise return LspAnswer.nothing()
		let entry = try sourceEntryOf(self, path: declFile) otherwise return LspAnswer.nothing()
		let text = entry.content

		return definitionLocationAnswer(lspFileUri(declFile), source: text, lines: LspLineIndex.build(text), name: declared)
	end 'definitionInAnotherFile'
end 'Project'

function declaringFileOfTheCursor(signatures ProgramSignatures, tokens TokenArray, cursor TokenIndex, readerPath FilePath) returns FilePath throws DefinitionLookupError
	let name = lspTokenAt(tokens, index: cursor).value

	if definitionNamesAMember(tokens, cursor: cursor) 'aMember'
		return try declaringFileOfAMember(signatures, tokens: tokens, cursor: cursor, member: name, readerPath: readerPath)
	end 'aMember'

	return try declaringFileOfABareName(signatures, name: name, readerPath: readerPath)
end 'declaringFileOfTheCursor'

function declaringFileOfAMember(signatures ProgramSignatures, tokens TokenArray, cursor TokenIndex, member ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	if cursor < TokensBetweenAReceiverAndItsMember 'nothingBeforeTheDot'
		throw DefinitionLookupError.nothingThere
	end 'nothingBeforeTheDot'

	let subject = lspSubjectOfReceiver(tokens, blocks: lspDocumentBlocks(tokens), receiver: cursor - TokensBetweenAReceiverAndItsMember)
	let typeName = lspSubjectTypeName(subject)

	if typeName.isEmpty() 'noReceiverType'
		throw DefinitionLookupError.nothingThere
	end 'noReceiverType'

	let owner = typeName.toByteArray()

	if let declaredMethod = try visibleCalleeFile(signatures, qualified: qualifiedMethodName(owner, methodName: member), readerPath: readerPath) 'aMethod'
		return declaredMethod
	end 'aMethod'

	if let declaredField = try declaringFileOfAField(signatures, owner: owner, member: member, readerPath: readerPath) 'aField'
		return declaredField
	end 'aField'

	return try declaringFileOfAnEnumCase(signatures, owner: owner, member: member, readerPath: readerPath)
end 'declaringFileOfAMember'

function declaringFileOfABareName(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	if let declaredFunction = try declaringFileOfAFunction(signatures, name: name, readerPath: readerPath) 'aFunction'
		return declaredFunction
	end 'aFunction'

	if let declaredStruct = try declaringFileOfAStruct(signatures, name: name, readerPath: readerPath) 'aStructType'
		return declaredStruct
	end 'aStructType'

	if let declaredEnum = try declaringFileOfAnEnum(signatures, name: name, readerPath: readerPath) 'anEnumType'
		return declaredEnum
	end 'anEnumType'

	if let declaredAlias = try declaringFileOfAnAlias(signatures, name: name, readerPath: readerPath) 'aRangedAlias'
		return declaredAlias
	end 'aRangedAlias'

	if let declaredInterface = try declaringFileOfAnInterface(signatures, name: name) 'anInterface'
		return declaredInterface
	end 'anInterface'

	return try declaringFileOfABinding(signatures, name: name, readerPath: readerPath)
end 'declaringFileOfABareName'

// ⚠ `ambiguous` answers NOTHING, exactly as `undeclared` does. `resolveFunctionName` is the compiler's
// own resolver, and `ambiguous` is the verdict behind E3095 — an editor that picked one of the
// candidates would send an author to a declaration the compiler refuses to bind the call to.
function declaringFileOfAFunction(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.resolveFunctionName(name, readerFilePath: readerPath) 'resolution'
		declaration(resolved) then return try visibleCalleeFile(signatures, qualified: resolved, readerPath: readerPath)
		ambiguous or
			undeclared then throw DefinitionLookupError.nothingThere
	end 'resolution'
end 'declaringFileOfAFunction'

function visibleCalleeFile(signatures ProgramSignatures, qualified ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	if not signatures.declaresCallee(qualified) 'nothingDeclaresIt'
		throw DefinitionLookupError.nothingThere
	end 'nothingDeclaresIt'

	match signatures.calleeVisibilityFrom(qualified, readerFilePath: readerPath) 'tier'
		visible then return signatures.declaringFileOf(qualified)
		hidden then throw DefinitionLookupError.nothingThere
	end 'tier'
end 'visibleCalleeFile'

function declaringFileOfAStruct(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.structFor(name, readerFilePath: readerPath) 'aStruct'
		declared(layout) then return try visibleDeclarationFile(signatures, visibility: layout.visibility, declFilePath: layout.declFilePath, readerPath: readerPath)
		undeclared then throw DefinitionLookupError.nothingThere
	end 'aStruct'
end 'declaringFileOfAStruct'

function declaringFileOfAnEnum(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.enumFor(name, readerFilePath: readerPath) 'anEnum'
		declared(layout) then return try visibleDeclarationFile(signatures, visibility: layout.visibility, declFilePath: layout.declFilePath, readerPath: readerPath)
		undeclared then throw DefinitionLookupError.nothingThere
	end 'anEnum'
end 'declaringFileOfAnEnum'

function declaringFileOfAnAlias(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.aliasOf(name, readerFilePath: readerPath) 'anAlias'
		declared(alias) then return try visibleAliasFile(signatures, alias: alias, readerPath: readerPath)
		undeclared then throw DefinitionLookupError.nothingThere
	end 'anAlias'
end 'declaringFileOfAnAlias'

function visibleAliasFile(signatures ProgramSignatures, alias RangedTypeAlias, readerPath FilePath) returns FilePath throws DefinitionLookupError
	if not signatures.aliasVisibleFrom(alias, readerFilePath: readerPath) 'hiddenHere'
		throw DefinitionLookupError.nothingThere
	end 'hiddenHere'

	return alias.declFilePath
end 'visibleAliasFile'

function declaringFileOfAnInterface(signatures ProgramSignatures, name ByteArray) returns FilePath throws DefinitionLookupError
	if not signatures.nameDeclaresAnInterface(name) 'nothingDeclaresIt'
		throw DefinitionLookupError.nothingThere
	end 'nothingDeclaresIt'

	for site in signatures.interfaceDeclSites 'eachSite'
		if site.name.equals(name) 'thisInterface'
			return site.path
		end 'thisInterface'
	end 'eachSite'

	throw DefinitionLookupError.nothingThere
end 'declaringFileOfAnInterface'

function declaringFileOfABinding(signatures ProgramSignatures, name ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.bindingFor(name, readerFilePath: readerPath) 'aBinding'
		declared(declFilePath) then return declFilePath
		undeclared then throw DefinitionLookupError.nothingThere
	end 'aBinding'
end 'declaringFileOfABinding'

function declaringFileOfAField(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.structFor(owner, readerFilePath: readerPath) 'aStruct'
		declared(layout) then return try visibleFieldFile(signatures, layout: layout, member: member, readerPath: readerPath)
		undeclared then throw DefinitionLookupError.nothingThere
	end 'aStruct'
end 'declaringFileOfAField'

function visibleFieldFile(signatures ProgramSignatures, layout StructLayout, member ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	for index in 0 upto layout.fieldCount() 'eachField'
		if not layout.fieldNameAt(index).equals(member) 'anotherField'
			continue
		end 'anotherField'

		return try visibleDeclarationFile(signatures, visibility: layout.fieldTier(index), declFilePath: layout.declFilePath, readerPath: readerPath)
	end 'eachField'

	throw DefinitionLookupError.nothingThere
end 'visibleFieldFile'

function declaringFileOfAnEnumCase(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	match signatures.enumFor(owner, readerFilePath: readerPath) 'anEnum'
		declared(layout) then return try visibleEnumCaseFile(signatures, layout: layout, member: member, readerPath: readerPath)
		undeclared then throw DefinitionLookupError.nothingThere
	end 'anEnum'
end 'declaringFileOfAnEnumCase'

function visibleEnumCaseFile(signatures ProgramSignatures, layout EnumLayout, member ByteArray, readerPath FilePath) returns FilePath throws DefinitionLookupError
	for caseName in layout.caseNames 'eachCase'
		if caseName.equals(member) 'thisCase'
			return try visibleDeclarationFile(signatures, visibility: layout.visibility, declFilePath: layout.declFilePath, readerPath: readerPath)
		end 'thisCase'
	end 'eachCase'

	throw DefinitionLookupError.nothingThere
end 'visibleEnumCaseFile'

function visibleDeclarationFile(signatures ProgramSignatures, visibility Visibility, declFilePath FilePath, readerPath FilePath) returns FilePath throws DefinitionLookupError
	if not signatures.isVisibleFrom(visibility, declFilePath: declFilePath, readerFilePath: readerPath) 'hiddenHere'
		throw DefinitionLookupError.nothingThere
	end 'hiddenHere'

	return declFilePath
end 'visibleDeclarationFile'
