enum RecordKind
	unlocatable
	absent
	unreadable
	present
end 'RecordKind'

module union RecordWatch
	unlocatable
	absent(record FilePath)
	unreadable(record FilePath)
	present(record FilePath, stamp SourceFileStamp)

	function kind() returns RecordKind
		return match self 'watch'
			unlocatable gives RecordKind.unlocatable
			absent gives RecordKind.absent
			unreadable gives RecordKind.unreadable
			present gives RecordKind.present
		end 'watch'
	end 'kind'
end 'RecordWatch'

module typealias RecordWatchMap = Map with (String, RecordWatch)

module function observeRecord(dir FilePath) returns RecordWatch
	let observedAt = WallClock.nowUnixSeconds() as Timestamp
	let record = try versionRecordPathOf(dir) otherwise return RecordWatch.unlocatable

	return match fileStateOf(record) 'state'
		absent gives RecordWatch.absent(record)
		unreadable gives RecordWatch.unreadable(record)
		present(size, modifiedTime, _) gives RecordWatch.present(record, stamp: SourceFileStamp.create(size, modifiedTime: modifiedTime, observedAt: observedAt))
	end 'state'
end 'observeRecord'

module function recordWatchHolds(held RecordWatch) returns bool
	return match held 'held'
		unlocatable gives true
		absent(record) gives recordKindHolds(held, record: record)
		unreadable(record) gives recordKindHolds(held, record: record)
		present(record, stamp) gives stamp.describes(fileStateOf(record))
	end 'held'
end 'recordWatchHolds'

function recordKindHolds(held RecordWatch, record FilePath) returns bool
	return held.kind() == recordKindOf(fileStateOf(record))
end 'recordKindHolds'

function recordKindOf(state FileState) returns RecordKind
	return match state 'state'
		absent gives RecordKind.absent
		unreadable gives RecordKind.unreadable
		present gives RecordKind.present
	end 'state'
end 'recordKindOf'
