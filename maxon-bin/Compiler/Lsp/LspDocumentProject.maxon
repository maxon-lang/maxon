// ⭐⭐ **THE COMPILER'S VIEW OF ONE OPEN BUFFER — the `Project` a document being edited makes, and the
// path that document is known by.**
//
// Two features ask for it and they must get the same one: `textDocument/completion` asks the corpus
// whether a member is VISIBLE from this file, and `textDocument/publishDiagnostics` asks the pipeline
// what is WRONG with it. Two constructions would be two projects free to disagree about which file the
// buffer even is, and a visibility answer is asked ON BEHALF OF a file.
//
// ⛔ **NOTHING IS READ FROM DISK, AND THAT IS FORCED RATHER THAN CHOSEN.** The document's text arrived
// over the wire, and in general the file does not exist on disk at all — an unsaved buffer, a uri a
// client invented. `loadProject` walks the filesystem for its sources, so it cannot serve here;
// `fileChanged` registers content directly with the query database, which is the same door
// `verify-recheck` edits a buffer through when it measures the editor scenario.
//
// ⚠ **ONE BUFFER, NOT A PROJECT ON DISK.** The server holds the open documents and nothing else, so the
// compile sees this file plus both library tiers, `stdlib/` and `runtime/` — never the user's other
// sources. A CHECK run here is therefore about a program the author did not write — which is why what it
// reports is corrected against `LspWorkspace`'s project corpus before anything is published, and why a
// diagnostic only the merged program could raise is out of reach from here altogether.
//
// ⛔ **BOTH TIERS OR NOTHING.** Every compile the driver runs loads them together, so a project built
// here from one of them would answer a diagnostic about a program no build ever sees — the editor
// would then disagree with the build, which is the one thing this file exists to prevent.

let LspFileUriScheme = "file://"

let LspUriRootSlash = "/"

let WindowsDirectorySeparator = "\\"

let HexRadix = 16
let LastSingleHexDigit = 9

let AsciiDigitZero = 48 as Byte
let AsciiDigitNine = 57 as Byte
let AsciiUpperA = 65 as Byte
let AsciiUpperZ = 90 as Byte
let AsciiLowerA = 97 as Byte
let AsciiLowerZ = 122 as Byte
let AsciiHyphen = 45 as Byte
let AsciiPeriod = 46 as Byte
let AsciiSlash = 47 as Byte
let AsciiUnderscore = 95 as Byte
let AsciiTilde = 126 as Byte

// The inverse of `FilePath.from`'s decode of a `file:` uri, and the two must stay one: an answer's
// uri that does not re-encode what a request decoded names a document the client cannot match to
// the one it asked about.
module function lspFileUri(path FilePath) returns String
	let slashed = path.toString().replace(WindowsDirectorySeparator, with: LspUriRootSlash)
	let encoded = percentEncodedUriPath(slashed)

	return "{LspFileUriScheme}{encoded}" if encoded.startsWith(LspUriRootSlash) else "{LspFileUriScheme}{LspUriRootSlash}{encoded}"
end 'lspFileUri'

function percentEncodedUriPath(text String) returns String
	var encoded = ByteArray.create()

	for pathByte in text.bytes() 'eachByte'
		if literalInAUriPath(pathByte) 'needsNoEscape'
			encoded.push(pathByte)
			continue
		end 'needsNoEscape'

		encoded.push(UrlPercentByte)
		encoded.push(hexDigitByteOf((pathByte / HexRadix) as UrlHexDigitValue))
		encoded.push(hexDigitByteOf((pathByte mod HexRadix) as UrlHexDigitValue))
	end 'eachByte'

	return String.from(encoded)
end 'percentEncodedUriPath'

function literalInAUriPath(pathByte Byte) returns bool
	if pathByte >= AsciiDigitZero and pathByte <= AsciiDigitNine 'digit'
		return true
	end 'digit'

	if pathByte >= AsciiUpperA and pathByte <= AsciiUpperZ 'upperCaseLetter'
		return true
	end 'upperCaseLetter'

	if pathByte >= AsciiLowerA and pathByte <= AsciiLowerZ 'lowerCaseLetter'
		return true
	end 'lowerCaseLetter'

	return pathByte == AsciiHyphen or pathByte == AsciiPeriod or pathByte == AsciiUnderscore or pathByte == AsciiTilde or pathByte == AsciiSlash
end 'literalInAUriPath'

function hexDigitByteOf(amount UrlHexDigitValue) returns Byte
	if amount <= LastSingleHexDigit 'decimalDigit'
		return (amount + AsciiDigitZero) as Byte
	end 'decimalDigit'

	return (amount - LastSingleHexDigit - 1 + AsciiUpperA) as Byte
end 'hexDigitByteOf'

// The project an open buffer makes, or nothing when this compiler cannot assemble one. A failure is a
// broken installation — a library tier missing beside the binary, or one that will not load — and each
// caller says what it does with the absence; there is no half-built project to hand back.
module union LspDocumentProject
	loaded(project Project, reader LspReaderSearch)
	unavailable
end 'LspDocumentProject'

module type LibraryTiers
	module let stdlibDir as FilePath
	module let runtimeDir as FilePath
	module let normalizedStdlibDir as FilePath
	module let normalizedRuntimeDir as FilePath

	module static function locate() returns LibraryTiers throws CompileError
		let stdlibDir = try locateStdlibDir()
		let runtimeDir = try runtimeDirBeside(stdlibDir)

		return Self{stdlibDir: stdlibDir, runtimeDir: runtimeDir, normalizedStdlibDir: stdlibDir.normalize(), normalizedRuntimeDir: runtimeDir.normalize()}
	end 'locate'
end 'LibraryTiers'

module union OpenBuffer
	held(path FilePath, content String)
	none
end 'OpenBuffer'

module function libraryTierProject(root FilePath, tiers LibraryTiers, buffer OpenBuffer) returns Project throws CompileError
	var project = createProject(root, target: detectHostTarget(), stdlibDir: tiers.stdlibDir, runtimeDir: tiers.runtimeDir, debugStream: false)

	registerTheOpenBuffer(project, buffer: buffer)

	try loadLibrarySources(project)
	return project
end 'libraryTierProject'

function registerTheOpenBuffer(project Project, buffer OpenBuffer)
	match buffer 'buffer'
		held(path, content) then fileChanged(project, path: path, content: content)
		none then return
	end 'buffer'
end 'registerTheOpenBuffer'

// ⚠ Rooted by `lspBufferRootOf`: a document outside the tiers at the file itself, which is what
// `maxon build <file>` roots at (`Compiler.commonAncestorOf` hands one path straight back), and a
// tier document at the tier's parent (`buildRootOf` says why). Every namespace this compile derives
// is measured from the root, so a different one would give the buffer a different namespace under
// the editor than under a build.
//
// The buffer is registered before the library load, so a tier document's buffer is what
// `setAsideTheUsersOwnLibraryFiles` files as library source, and its copy on disk is never loaded.
module function lspDocumentProject(path FilePath, content String) returns LspDocumentProject
	let tiers = try LibraryTiers.locate() otherwise return LspDocumentProject.unavailable
	let reader = LspReaderSearch.of(path, tiers: tiers)
	let project = try libraryTierProject(lspBufferRootOf(reader), tiers: tiers, buffer: OpenBuffer.held(path, content: content)) otherwise return LspDocumentProject.unavailable

	return LspDocumentProject.loaded(project, reader: reader)
end 'lspDocumentProject'

// The spelling the project registered this file under, which is not always the spelling the request
// arrived with. ⚠ `FilePath` compares case-insensitively on Windows, so `db.sourceFiles` holds one
// entry for two spellings, while `ProgramSignatures.moduleDirectoryOfPathText` is keyed by exact
// path text and panics on a miss: a visibility question asked on behalf of the other spelling would
// take the server down.
module function registeredSpellingOf(project Project, path FilePath) returns FilePath
	let wanted = path.normalize()

	for registered in project.db.sourcePaths 'eachRegistered'
		if registered.normalize().equals(wanted) 'theSameFile'
			return registered
		end 'theSameFile'
	end 'eachRegistered'

	return path
end 'registeredSpellingOf'
