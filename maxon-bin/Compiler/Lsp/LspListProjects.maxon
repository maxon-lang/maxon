// `maxon/listProjects` — the VS Code status bar's request: the projects the open documents sit in,
// one entry per distinct root `LspWorkspace.maxon`'s ladder resolves a document to.
//
// ⚠ A file count is read off a HELD corpus and this request sweeps for none: the status bar asks
// again on every editor switch, so a sweep here would put a directory walk and a lex of every
// source behind a keystroke. A root no held corpus answers for is counted `0` until an open or a
// request builds it; `lspLoadProject` owns which roots an open builds.

let ProjectsKey = "projects"
let IsSingleFileKey = "isSingleFile"
let FileCountKey = "fileCount"

// The buffer itself; the library tiers are not the author's files.
let SingleFileProjectFileCount = 1
let UnsweptProjectFileCount = 0

enum ListedProjectError implements Error
	theDocumentSitsInNoDirectory
end 'ListedProjectError'

type ListedProject
	module let root as RootName
	module let isSingleFile as bool
	module let fileCount as LspProjectFileCount

	static function create(root RootName, isSingleFile bool, fileCount LspProjectFileCount) returns ListedProject
		return Self{root: root, isSingleFile: isSingleFile, fileCount: fileCount}
	end 'create'
end 'ListedProject'

typealias ListedProjectArray = Array with ListedProject

module function listProjectsAnswer(workspace LspWorkspaceState, documents LspDocumentTextMap) returns LspExtensionOutcome
	var listed = ListedProjectArray.create()
	let search = lspRootSearch(workspace)

	for (uri, _) in documents 'eachDocument'
		match lspDocumentOf(workspace, uri: uri) 'document'
			resolved(document) then addListedProjectOf(workspace, document: document, search: search, into: listed)
			notAPath or
			unidentifiable then continue
		end 'document'
	end 'eachDocument'

	// The map's order is its hashing's; the answer's is the roots'.
	listed.sort(function(a ListedProject, b ListedProject) gives comparePathSpelling(a.root.spelled, right: b.root.spelled))

	var doc = JsonDoc.create()
	var projects = JsonNodeIdArray.create()

	for entry in listed 'eachProject'
		var project = LspJsonObject.create(doc)
		project.put(LspRootPathKey, value: JsonNode.stringNode(entry.root.spelled.toString()))
		project.put(IsSingleFileKey, value: JsonNode.boolNode(entry.isSingleFile))
		project.put(FileCountKey, value: JsonNode.numberNode(entry.fileCount as JsonFloat))
		projects.push(project.finish())
	end 'eachProject'

	var result = LspJsonObject.create(doc)
	result.putNode(ProjectsKey, value: doc.add(JsonNode.arrayNode(projects)))
	return LspExtensionOutcome.answered(LspAnswer.of(doc, result: result.finish()))
end 'listProjectsAnswer'

function addListedProjectOf(workspace LspWorkspaceState, document ReaderDocument, search LspRootSearch, into ListedProjectArray)
	let entry = try listedProjectOf(workspace, document: document, search: search) otherwise return

	addListedProject(entry, into: into)
end 'addListedProjectOf'

function listedProjectOf(workspace LspWorkspaceState, document ReaderDocument, search LspRootSearch) returns ListedProject throws ListedProjectError
	match lspProjectFactsOf(workspace, document: document, search: search) 'facts'
		swept(root, fileCount) then return ListedProject.create(root, isSingleFile: false, fileCount: fileCount)
		unswept(root) then return ListedProject.create(root, isSingleFile: false, fileCount: UnsweptProjectFileCount)
		singleFile(root) then return ListedProject.create(root, isSingleFile: true, fileCount: SingleFileProjectFileCount)
		unlocated then throw ListedProjectError.theDocumentSitsInNoDirectory
	end 'facts'

	panic("listedProjectOf: every case of the facts answers or throws")
end 'listedProjectOf'

function addListedProject(entry ListedProject, into ListedProjectArray)
	for existing in into 'eachListed'
		if existing.root.identity.equals(entry.root.identity) 'oneProjectAlready'
			return
		end 'oneProjectAlready'
	end 'eachListed'

	into.push(entry)
end 'addListedProject'
