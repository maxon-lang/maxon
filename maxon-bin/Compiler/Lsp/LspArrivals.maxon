module union LspArrival
	framed(body String)
	endOfStream
	framingError(detail String)
	projectResolved(dir FilePath, answer ProjectInputsAnswer, ticket ResolutionTicket)
	childFramed(generation LspChildGeneration, body String)
	childEnded(generation LspChildGeneration, reason String)
	childStderr(generation LspChildGeneration, line String)
	childStderrEnded(generation LspChildGeneration)
	childStderrFailed(generation LspChildGeneration, reason String)
	slotTick
end 'LspArrival'

module typealias LspArrivalPromise = Promise with LspArrival

module typealias LspArrivalPromiseArray = Array with LspArrivalPromise

module typealias ResolutionTicket = int(0 to u64.max)

module let LspFrameSlot = 0 as ElementIndex

module type LspStdinReader
	var stdin as Stdin

	module static function create() returns LspStdinReader
		return Self{stdin: Console.stdin()}
	end 'create'

	export function next() returns isolated LspArrival
		return match readLspMessage(self.stdin) 'incoming'
			message(body) gives LspArrival.framed(body)
			endOfStream gives LspArrival.endOfStream
			framingError(detail) gives LspArrival.framingError(detail)
		end 'incoming'
	end 'next'
end 'LspStdinReader'

module function nextChildArrival(reader StdoutReader, generation LspChildGeneration) returns LspArrival
	return match readChildMessage(reader) 'incoming'
		message(body) gives LspArrival.childFramed(generation, body: body)
		endOfStream gives LspArrival.childEnded(generation, reason: "its output ended")
		framingError(detail) gives LspArrival.childEnded(generation, reason: detail)
	end 'incoming'
end 'nextChildArrival'

module function nextChildStderrArrival(reader StderrReader, generation LspChildGeneration) returns LspArrival
	let line = try reader.readLine() otherwise (e) 'unread'
		return LspArrival.childStderrEnded(generation) if e.endedTheStream() else LspArrival.childStderrFailed(generation, reason: e.displayReason())
	end 'unread'

	return LspArrival.childStderr(generation, line: line)
end 'nextChildStderrArrival'

module function slotTickAfter(pauseMs Milliseconds) returns LspArrival
	sleep(pauseMs)

	return LspArrival.slotTick
end 'slotTickAfter'

// Runs a `.maxproj` off the session loop, which answers every other request while a manifest
// compiles and runs. ⚠ Each held project has its own (`HeldRoot.resolver`), which serves that
// project's resolutions in turn, so a slow `.maxproj` delays only its own project's later answers.
module type LspProjectResolver
	module static function create() returns LspProjectResolver
		return Self{}
	end 'create'

	export function resolve(dirPath String, ticket ResolutionTicket, previous immutable DeclaredInputStamps) returns isolated LspArrival
		return LspArrival.projectResolved(projectDirectoryAt(dirPath), answer: resolvedProjectInputs(dirPath, previous: previous), ticket: ticket)
	end 'resolve'
end 'LspProjectResolver'
