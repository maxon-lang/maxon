union LspArrival
	framed(body String)
	endOfStream
	framingError(detail String)
	projectResolved(dir FilePath, answer ProjectInputsAnswer, ticket ResolutionTicket)
	projectCheckSettled(request immutable LspProjectCheckRequest, interest CompileInterest)
	childFramed(generation LspChildGeneration, body String)
	childEnded(generation LspChildGeneration, reason String)
	childStderr(generation LspChildGeneration, line String)
	childStderrEnded(generation LspChildGeneration)
	childStderrFailed(generation LspChildGeneration, reason String)
	reapDeadline
end 'LspArrival'

typealias LspArrivalPromise = Promise with LspArrival

typealias LspArrivalPromiseArray = Array with LspArrivalPromise

typealias ResolutionTicket = int(0 to u64.max)

let LspFrameSlot = 0 as ElementIndex

type LspStdinReader
	var stdin as StdinReader

	static function create() returns LspStdinReader
		return Self{stdin: Console.stdin()}
	end 'create'

	export function next() returns isolated LspArrival
		return match self.stdin.readLspMessage() 'incoming'
			message(body) gives LspArrival.framed(body)
			endOfStream gives LspArrival.endOfStream
			framingError(detail) gives LspArrival.framingError(detail)
		end 'incoming'
	end 'next'
end 'LspStdinReader'

type LspChildStdoutReader
	let generation as LspChildGeneration
	var reader as ChildOutputReader

	static function create(reader isolated ChildOutputReader, generation LspChildGeneration) returns LspChildStdoutReader
		return Self{generation: generation, reader: merge reader}
	end 'create'

	export function next() returns isolated LspArrival
		return match self.reader.readLspMessage() 'incoming'
			message(body) gives LspArrival.childFramed(self.generation, body: body)
			endOfStream gives LspArrival.childEnded(self.generation, reason: "its output ended")
			framingError(detail) gives LspArrival.childEnded(self.generation, reason: detail)
		end 'incoming'
	end 'next'
end 'LspChildStdoutReader'

function nextChildArrival(reader LspChildStdoutReader.handle) returns LspArrival
	let arrival = try await reader.next() otherwise panic("a child's output reader stopped while the relay still held its handle")

	return merge arrival
end 'nextChildArrival'

function nextChildStderrArrival(reader ChildLineReader.handle, generation LspChildGeneration) returns LspArrival
	let event = try await reader.next() otherwise panic("a child's error reader stopped while the relay still held its handle")

	return match event 'event'
		said(_, text) gives LspArrival.childStderr(generation, line: text)
		closed gives LspArrival.childStderrEnded(generation)
		broke(_, reason) gives LspArrival.childStderrFailed(generation, reason: reason)
		silent or
		exhausted panic("nextChildStderrArrival: a stream's reader answered {event.name}")
	end 'event'
end 'nextChildStderrArrival'

function reapDeadlineAfter(deadlineMs Milliseconds) returns LspArrival
	sleep(deadlineMs)

	return LspArrival.reapDeadline
end 'reapDeadlineAfter'

// Runs a `.maxproj` off the session loop, which answers every other request while a manifest
// compiles and runs. ⚠ Each held project runs one at a time (`HeldRoot.resolution`), so a slow
// `.maxproj` delays only its own project's later answers.
function resolvedProjectArrival(dirPath String, ticket ResolutionTicket, previous immutable DeclaredInputStamps) returns LspArrival
	return LspArrival.projectResolved(projectDirectoryAt(dirPath), answer: resolvedProjectInputs(dirPath, previous: previous), ticket: ticket)
end 'resolvedProjectArrival'
