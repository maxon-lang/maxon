// `textDocument/hover` — what the symbol under the cursor IS, rendered as markdown.
//
// ⭐⭐ **IT READS THE TOKEN STREAM, NOT THE COMPILER'S IR, AND THAT IS THE DESIGN DECISION THIS FILE
// EXISTS TO STATE.** An editor asks for a hover on the buffer the user is HALFWAY THROUGH TYPING, and
// the compiler's frontend parses straight to typed IR — it needs every type resolved to mint a value, so a
// buffer with one unresolved name produces no IR at all. A hover built on `loadProject` would therefore
// answer nothing exactly when a user most wants it, which is not a hover feature. So the question every
// answer here is derived from is the one a broken buffer can still answer: **what does the LEXER see?**
//
// ⭐ **WHAT THAT BUYS, BEYOND WORKING AT ALL.** The three comment cases fall out of it rather than being
// special-cased: `//` and `/* … */` emit NO token, so a cursor inside one lands on nothing and hover says
// so — while code on the same line after a `*/` is an ordinary token and hovers normally. A scanner that
// re-derived comments from the text would own that boundary; this one asks the component that already
// decides it.
//
// ⚠ **AND WHAT IT COSTS, SO NOBODY READS MORE INTO AN ANSWER THAN IS THERE.** There is no scope
// analysis, because there is no parse to take one from. A name resolves to the NEAREST DECLARATION OF
// THAT NAME above the cursor, then to the first one below it — lexical order standing in for lexical
// scope. Two locals of one name in two functions are therefore distinguished by distance and not by
// block, and a `column 1` token is taken to be top-level, which is this tree's layout convention rather
// than a rule of the language. Every heuristic is named at its own site.

// The `Hover` this area answers with. Its `HoverParams` are read through `lspPositionMember`, which every
// area's cursor comes through.
let ContentsKey = "contents"
let ValueKey = "value"
let MarkdownKind = "markdown"

// The markdown scaffolding an editor renders a hover through.
let MaxonFenceOpen = "```maxon\n"
let MaxonFenceClose = "\n```"
let ParagraphBreak = "\n\n"
let DocCommentLineBreak = "\n"

// What a hover says about a token the language reserves. ⛔ **IT DOES NOT DESCRIBE THE KEYWORD**, and
// that is deliberate: no keyword-documentation registry exists anywhere in this tree, and writing fifty
// glosses here would be a specification invented by a hover handler and ruled on by nobody.
let KeywordNote = "Maxon language keyword."

// A declaration at source column 1 is top-level. ⚠ **A LAYOUT CONVENTION, NOT A LANGUAGE RULE** — Maxon
// does not require it — but it is what every file in this tree does, and a declaration's own indentation
// is the one thing that separates a module-level binding from a member without asking what encloses it.
// Where the enclosure is the question, `lspDocumentBlocks` answers it off the `end '<label>'` pairs.
let TopLevelColumn = 1 as ColumnNumber

module function hoverServedMethods() returns LspMethodArray
	var served = LspMethodArray.create()
	served.push(LspMethod.hover)
	return served
end 'hoverServedMethods'

module function hoverAnswer(request LspRequest) returns LspAnswer throws LspParamsError
	let position = try lspPositionMember(request.incoming, of: request.params, key: LspPositionKey)

	// A buffer mid-edit routinely does not even LEX — an unterminated string is enough. That is LSP's
	// "nothing here" and not a refusal: the client asked a well-formed question about a place with
	// nothing to say.
	let document = try HoverDocument.of(request.text, keywords: request.keywords, corpus: LspCorpus.unavailable) otherwise return LspAnswer.nothing()
	let cursor = try document.cursorTokenIndex(position) otherwise return LspAnswer.nothing()

	match hoverRenderingOf(request, document: document, cursor: cursor) 'answer'
		present(markdown) then return markdownAnswer(markdown)
		untyped(markdown) then return markdownAnswer(markdown)
		absent then return LspAnswer.nothing()
	end 'answer'
end 'hoverAnswer'

function hoverRenderingOf(request LspRequest, document HoverDocument, cursor TokenIndex) returns HoverRendering
	let inTheBuffer = document.renderingForToken(cursor)

	match inTheBuffer 'buffer'
		present then return inTheBuffer
		untyped or
			absent then return hoverBeyondTheBuffer(request, document: document, cursor: cursor)
	end 'buffer'
end 'hoverRenderingOf'

// ⚠ The reserved-word rung comes BEFORE the project one, and the order is a cost bound.
// `tokenCanBeAName` is true of every keyword, so `return`, `end` and `if` would otherwise reach a
// corpus build — a directory sweep, a lex of every file and a signature fold — to be told nothing,
// on a request an editor fires on every pointer movement. It loses no answer:
// `specs/keyword-as-a-declared-name.md` admits a keyword as a name in a function's declared name
// and a parameter's name and nowhere else, so a keyword spelled across a file boundary names a
// FUNCTION, written as a call or as a member — both of which `reservedWordOutOfNamePosition` lets
// past — while a parameter is local and the buffer rung has already answered it.
function hoverBeyondTheBuffer(request LspRequest, document HoverDocument, cursor TokenIndex) returns HoverRendering
	if document.reservedWordOutOfNamePosition(cursor) 'theLanguagesOwnWord'
		return reservedWordRendering(document.tokenAt(cursor))
	end 'theLanguagesOwnWord'

	let inTheProject = hoverAcrossFiles(request, document: document, cursor: cursor)

	match inTheProject 'project'
		present or
			untyped then return inTheProject
		absent then return reservedWordRendering(document.tokenAt(cursor))
	end 'project'
end 'hoverBeyondTheBuffer'

function hoverAcrossFiles(request LspRequest, document HoverDocument, cursor TokenIndex) returns HoverRendering
	if not tokenCanBeAName(document.tokenAt(cursor)) 'notAName'
		return HoverRendering.absent
	end 'notAName'

	let readByTheProject = document.withCorpus(lspDocumentCorpus(request.uri))
	let inTheBuffer = readByTheProject.renderingForToken(cursor)

	match inTheBuffer 'buffer'
		present or
			untyped then return inTheBuffer
		absent then return readByTheProject.declarationInTheCorpus(cursor)
	end 'buffer'
end 'hoverAcrossFiles'

function reservedWordRendering(tok Token) returns HoverRendering
	if not tokenIsAReservedWord(tok) 'anAuthoredToken'
		return HoverRendering.absent
	end 'anAuthoredToken'

	var prose = StringArray.create()
	prose.push(KeywordNote)

	return HoverRendering.present(hoverMarkdown(String.from(tok.value), prose: prose))
end 'reservedWordRendering'

function markdownAnswer(markdown String) returns LspAnswer
	var doc = JsonDoc.create()

	var contents = LspJsonObject.create(doc)
	contents.put(LspKindKey, value: JsonNode.stringNode(MarkdownKind))
	contents.put(ValueKey, value: JsonNode.stringNode(markdown))

	var result = LspJsonObject.create(doc)
	result.putNode(ContentsKey, value: contents.finish())

	return LspAnswer.of(doc, result: result.finish())
end 'markdownAnswer'

// What an editor displays, or the honest absence of it. ⛔ NOT an empty string: a rendering that
// genuinely came out empty and a position with nothing to say are different answers, and an editor
// opening a blank popup is the first one going wrong.
//
// `untyped` is a rendering the buffer can show but whose type it could not infer. It is the one answer
// worth asking again with the project's declarations attached, and what decides whether a binding hover
// pays for a corpus at all.
union HoverRendering
	present(markdown String)
	untyped(markdown String)
	absent
end 'HoverRendering'

// What a name resolved to. Each case carries where to READ the declaration from, never a rendering —
// the rendering is the same act for a function and for a type, and doing it once is what keeps them from
// drifting apart.
union HoverDeclaration
	// A `let`/`var`, at its keyword.
	binding(index TokenIndex)

	// A parameter: the `function` token whose list it is in, and the name token itself.
	parameter(functionIndex TokenIndex, nameIndex TokenIndex)

	// A `function`, at its keyword.
	routine(index TokenIndex)

	// A `type`/`enum`/`union`/`interface`/`typealias`/`extension`, at its keyword.
	typeName(index TokenIndex)
	none
end 'HoverDeclaration'

enum HoverDeclarationKind
	binding
	routine
end 'HoverDeclarationKind'

union HoverDeclarationSite
	at(index TokenIndex)
	none
end 'HoverDeclarationSite'

// ⚠ `visibleToAnotherFile` narrows the WALK and never its answer: `declarationOf` stops at the
// first declaration of the name, so discarding that answer afterwards would report absence for a
// file whose next match is the visible declaration being looked for.
enum HoverDeclarationScope
	everyDeclaration
	visibleToAnotherFile
end 'HoverDeclarationScope'

union HoverMemberOwner
	declaredIn(name ByteArray)
	notAMemberLine
end 'HoverMemberOwner'

// What a declaration sits inside, decided by the nearest declaration keyword above it.
union HoverEnclosure
	routine(index TokenIndex)
	container(index TokenIndex)
	none
end 'HoverEnclosure'

// A value expression as hover reads it: what it IS, and where it STOPS. The two are one answer because
// the second is what makes the first trustworthy — see `inferredTypeAt`. A bracket group the buffer has
// not closed yet is no value at all, which is why absence is a case.
union HoverValue
	spans(inferred HoverType, after TokenIndex)
	none
end 'HoverValue'

union HoverDeclaringDocument
	at(document HoverDocument)
	none
end 'HoverDeclaringDocument'

// The declaration hops a receiver walk may still take. Two separate bounds make that walk finite, and an
// unbounded one here is an editor hanging on a pointer movement.
//
// Within one expression the token index strictly decreases — `memberTypeEndingAt` steps back past the
// `.`, `callResultEndingAt` past the whole bracket group — so nothing there needs counting. The one edge
// that can revisit a declaration is LEAVING the expression: following a name to its declaration and
// reading its initializer. `var a = b.m()` beside `var b = a.m()` is a buffer a user can type, and
// resolving either receiver asks for the other's type. That edge is what this counts, so the budget is
// named where a walk begins (`bindingRendering`, `memberRendering`, `receiverSubject`) and stepped down
// at every site that follows a name.
//
// ⚠ It counts declaration hops and not calls: a call on a receiver is not the loop edge, and
// `FilePath.empty()` recurses into nothing, so refusing one costs `p.toString().count()` an answer and
// buys no termination.
//
// The budget cannot be spelled into the range — a range takes literals — but one outside it earns E3005
// at the cast below, so the two cannot disagree at run time.
typealias HoverReceiverReach = int(0 to 3)

let HoverDeclarationHopBudget = 3 as HoverReceiverReach
let NoDeclarationHopsLeft = 0 as HoverReceiverReach

// A type as hover knows it, in three spellings. `base` is the name a member is looked up on; `rendered`
// is what the reader sees, and the two differ for a container — `[1, 2, 3]` looks up on `Array` and
// reads as `Array with int`. `written` is the name the source used before an alias was resolved through
// it — `CrateArray` where `base` is `Array` — and it is what names the instance when a member turns out
// to be declared as one of the base's type parameters.
//
// ⚠ `rendered` is Maxon's own spelling, because a hover shows a reader their own language. The
// compiler's diagnostic renderer cannot supply it: a generic instance renders there as the bare word
// `struct` (`IrInterface.maxon` says so), which would tell an editor user nothing.
union HoverType
	named(base ByteArray, rendered String, written ByteArray)
	unknown
end 'HoverType'

// A member's declared type, or the fact that it is one of the OWNER's type parameters and which one. The
// two halves are known in different places — only the declaring document knows that `get` answers
// `Element`, and only the receiver knows what `Element` was bound to — so collapsing this into a
// `HoverType` hands a reader a type parameter's name as though it were an inferred type.
union HoverMemberType
	bound(inferred HoverType)
	ownersTypeParameter(position TypeParamPosition)
	none
end 'HoverMemberType'

union HoverTypeParamSite
	at(position TypeParamPosition)
	none
end 'HoverTypeParamSite'

union HoverDeclaringType
	at(owner ByteArray)
	none
end 'HoverDeclaringType'

union HoverReceiver
	value(inferred HoverType)
	typeSurface(inferred HoverType)
	nothing
end 'HoverReceiver'

// The ways a walk over this buffer finds no token. Each is routine while an editor is mid-edit rather
// than a defect, and each is thrown rather than answered with an index: index 0 is a real token, so a
// position standing for absence is indistinguishable from a hit at the start of the buffer.
enum HoverLookupError implements Error
	// A closure literal (`function(x) gives …`) declares no name.
	declaresNoName

	// A head that runs to the end of the buffer has no `(` yet.
	declaresNoParameterList

	// A bracket group the buffer never closes has no token past it.
	unclosedBracketGroup

	noTokenAtTheCursor
end 'HoverLookupError'

// One buffer, prepared for the questions a hover asks of it: its bytes (to slice source text out of),
// its tokens, and the line index that turns an LSP position into a byte offset.
//
// ⭐ It is a TYPE and not a bag of free functions because a second instance is exactly how a stdlib doc
// comment is reached: the same walks run over `stdlib/Array.maxon` as over the open document, with no
// second spelling of any of them.
module type HoverDocument
	let text as String
	let bytes as ByteArray
	let tokens as TokenArray
	let lines as LspLineIndex
	let keywords as KeywordTable
	let corpus as LspCorpus

	static function of(text String, keywords KeywordTable, corpus LspCorpus) returns HoverDocument throws LexerError
		return Self.ofTokens(text, tokens: try tokenize(text, keywords: keywords), keywords: keywords, corpus: corpus)
	end 'of'

	// Tokens the caller already holds, so a declaring file is rendered out of `queryActiveTokens`'
	// memo rather than lexed again on every hover.
	module static function ofTokens(text String, tokens TokenArray, keywords KeywordTable, corpus LspCorpus) returns HoverDocument
		return Self{text: text, bytes: text.toByteArray(), tokens: tokens, lines: LspLineIndex.build(text), keywords: keywords, corpus: corpus}
	end 'ofTokens'

	module function withCorpus(swept LspCorpus) returns HoverDocument
		return Self{text: self.text, bytes: self.bytes, tokens: self.tokens, lines: self.lines, keywords: self.keywords, corpus: swept}
	end 'withCorpus'

	// --- The stream, and the cursor in it -----------------------------------------------------

	// The token at `index`, or the stream's own EOF token past the end. Every walk here looks ahead,
	// and "the stream is over" is the exact answer at the end of one — `eof` carries no text and no
	// span, so it matches nothing any reader tests for and needs no bounds guard at each site.
	function tokenAt(index TokenIndex) returns Token
		return try tokens.get(index) otherwise Token.eof()
	end 'tokenAt'

	// Which token the cursor names is `lspTokenAtCursor`'s answer and not one taken here:
	// `textDocument/definition` resolves the same position, and an editor that jumped to a name this
	// hover described as something else would be reading two different rules.
	function cursorTokenIndex(position LspPosition) returns TokenIndex throws HoverLookupError
		let offset = lines.offsetOf(text, position: position)

		return try lspTokenAtCursor(tokens, offset: offset) otherwise throw HoverLookupError.noTokenAtTheCursor
	end 'cursorTokenIndex'

	function reservedWordOutOfNamePosition(cursor TokenIndex) returns bool
		if not tokenIsAReservedWord(tokenAt(cursor)) 'anAuthoredToken'
			return false
		end 'anAuthoredToken'

		if lspCursorNamesAMember(tokens, cursor: cursor) 'aMember'
			return false
		end 'aMember'

		return tokenAt(cursor + 1).kind != TokenKind.leftParen
	end 'reservedWordOutOfNamePosition'

	function renderingForToken(index TokenIndex) returns HoverRendering
		let tok = tokenAt(index)

		// A `///` line is prose the author wrote ABOUT a declaration; the cursor is in the writing, not
		// on a symbol.
		if tok.kind == TokenKind.docComment 'prose'
			return HoverRendering.absent
		end 'prose'

		if not tokenCanBeAName(tok) 'neitherANameNorAWord'
			return HoverRendering.absent
		end 'neitherANameNorAWord'

		if lspCursorNamesAMember(tokens, cursor: index) 'memberAccess'
			return memberRendering(index)
		end 'memberAccess'

		return calleeRendering(index)
	end 'renderingForToken'

	// ⭐⭐ **A MATH INTRINSIC IS THE ANSWER AT A CALL SITE WHATEVER THE BUFFER DECLARES, and that is the
	// LANGUAGE's rule rather than a preference taken here.** `Parser.calleeTakesPositionalArgsOnly` reserves
	// these eight names wherever a call is parsed: a user `function sqrt` is shadowed by the intrinsic and
	// never linked. A hover that resolved the declaration instead would describe the function the compiler
	// is not going to call, which is worse than saying nothing.
	//
	// ⚠ The test is the `(` and not the name alone, for the same reason the parser's is: `sqrt` used as an
	// ordinary identifier — a field, a variable — is not a call, and the reservation does not reach it.
	function calleeRendering(index TokenIndex) returns HoverRendering
		if tokenAt(index + 1).kind != TokenKind.leftParen 'notACallee'
			return nameRendering(index)
		end 'notACallee'

		match mathBuiltinNamed(tokenAt(index).value) 'reserved'
			found(builtin) then return HoverRendering.present(mathBuiltinMarkdown(builtin))
			absent then return nameRendering(index)
		end 'reserved'
	end 'calleeRendering'

	// --- Resolving a name ---------------------------------------------------------------------

	function nameRendering(index TokenIndex) returns HoverRendering
		return renderingOfDeclaration(declarationOf(tokenAt(index).value, near: index, scope: HoverDeclarationScope.everyDeclaration))
	end 'nameRendering'

	function declarationInTheCorpus(cursor TokenIndex) returns HoverRendering
		let declFile = try lspDeclaringFileOfTheCursor(corpus, text: text, tokens: tokens, keywords: keywords, cursor: cursor) otherwise return HoverRendering.absent

		match documentOfCorpusFile(declFile) 'declaring'
			at(declaring) then return declaring.crossFileRendering(tokenAt(cursor).value)
			none then return HoverRendering.absent
		end 'declaring'
	end 'declarationInTheCorpus'

	function documentOfCorpusFile(path FilePath) returns HoverDeclaringDocument
		match corpus 'held'
			loaded(project, _, _) then return project.hoverDocumentOf(path, reading: keywords, corpus: corpus)
			unavailable then return HoverDeclaringDocument.none
		end 'held'
	end 'documentOfCorpusFile'

	function crossFileRendering(name ByteArray) returns HoverRendering
		return renderingOfDeclaration(declarationOf(name, near: FirstToken, scope: HoverDeclarationScope.visibleToAnotherFile))
	end 'crossFileRendering'

	function renderingOfDeclaration(declaration HoverDeclaration) returns HoverRendering
		match declaration 'resolved'
			binding(head) then return bindingRendering(head)
			parameter(functionIndex, nameIndex) then return parameterRendering(functionIndex, nameIndex: nameIndex)
			routine(head) then return declarationHeadRendering(head)
			typeName(head) then return declarationHeadRendering(head)
			none then return HoverRendering.absent
		end 'resolved'
	end 'renderingOfDeclaration'

	// The declaration a name at `near` stands for.
	//
	// ⚠ **NEAREST-ABOVE-FIRST IS LEXICAL ORDER STANDING IN FOR LEXICAL SCOPE**, for the reason the file
	// header gives: there is no parse to take a scope from. Below the cursor is searched second because
	// a call legitimately precedes the function it names.
	function declarationOf(name ByteArray, near TokenIndex, scope HoverDeclarationScope) returns HoverDeclaration
		let total = tokens.count()
		var step = 0

		while step < total 'eachCandidate'
			let found = declarationHeadAt(candidateIndex(step, near: near), name: name, scope: scope)

			match found 'hit'
				none then step = step + 1
				binding or
					parameter or
					routine or
					typeName then return found
			end 'hit'
		end 'eachCandidate'

		return HoverDeclaration.none
	end 'declarationOf'

	// Whether the token at `index` declares `name`, and as what.
	function declarationHeadAt(index TokenIndex, name ByteArray, scope HoverDeclarationScope) returns HoverDeclaration
		let kind = tokenAt(index).kind

		if kind == TokenKind.function 'routineOrItsParameters'
			return functionDeclaring(index, name: name, scope: scope)
		end 'routineOrItsParameters'

		if not namesFollowing(index, name: name) 'declaresSomethingElse'
			return HoverDeclaration.none
		end 'declaresSomethingElse'

		if kind == TokenKind.let or kind == TokenKind.var or kind == TokenKind.for 'bindingHead'
			return bindingDeclaredAt(index, scope: scope)
		end 'bindingHead'

		if kindDeclaresATypeName(kind) 'typeHead'
			return HoverDeclaration.typeName(index)
		end 'typeHead'

		return HoverDeclaration.none
	end 'declarationHeadAt'

	function bindingDeclaredAt(index TokenIndex, scope HoverDeclarationScope) returns HoverDeclaration
		match scope 'reach'
			everyDeclaration then return HoverDeclaration.binding(index)
			visibleToAnotherFile then return moduleLevelBindingAt(index)
		end 'reach'
	end 'bindingDeclaredAt'

	function moduleLevelBindingAt(index TokenIndex) returns HoverDeclaration
		if tokenAt(declarationStart(index)).column != TopLevelColumn 'aLocalOrAField'
			return HoverDeclaration.none
		end 'aLocalOrAField'

		return HoverDeclaration.binding(index)
	end 'moduleLevelBindingAt'

	function namesFollowing(index TokenIndex, name ByteArray) returns bool
		let next = tokenAt(index + 1)
		return tokenCanBeAName(next) and next.value.equals(name)
	end 'namesFollowing'

	// Whether the `function` at `functionIndex` declares `name` — as the function itself, or as one of
	// its parameters.
	function functionDeclaring(functionIndex TokenIndex, name ByteArray, scope HoverDeclarationScope) returns HoverDeclaration
		if signatureDeclares(functionIndex, name: name) 'thisFunction'
			return HoverDeclaration.routine(functionIndex)
		end 'thisFunction'

		match scope 'reach'
			everyDeclaration then return parameterDeclaring(functionIndex, name: name)
			visibleToAnotherFile then return HoverDeclaration.none
		end 'reach'
	end 'functionDeclaring'

	function parameterDeclaring(functionIndex TokenIndex, name ByteArray) returns HoverDeclaration
		let openIndex = try signatureListIndex(functionIndex) otherwise return HoverDeclaration.none

		return parameterNamed(functionIndex, openIndex: openIndex, name: name)
	end 'parameterDeclaring'

	// Whether a signature's declared name is `name`. A closure literal (`function(x) gives …`) declares
	// none, so it is never the answer to a name.
	function signatureDeclares(functionIndex TokenIndex, name ByteArray) returns bool
		let nameIndex = try signatureNameIndex(functionIndex) otherwise return false

		return tokenAt(nameIndex).value.equals(name)
	end 'signatureDeclares'

	// The name a `function` declares — `f`, or the LAST segment of `Interface.f`, which is why this
	// walks back from the end of the head rather than forward from the keyword.
	function signatureNameIndex(functionIndex TokenIndex) returns TokenIndex throws HoverLookupError
		var index = signatureHeadEnd(functionIndex)

		while index > functionIndex + 1 'backToTheName'
			index = index - 1

			if tokenCanBeAName(tokenAt(index)) 'theName'
				return index
			end 'theName'
		end 'backToTheName'

		throw HoverLookupError.declaresNoName
	end 'signatureNameIndex'

	// The `(` that opens a `function`'s parameter list.
	function signatureListIndex(functionIndex TokenIndex) returns TokenIndex throws HoverLookupError
		let after = signatureHeadEnd(functionIndex)

		if tokenAt(after).kind != TokenKind.leftParen 'noList'
			throw HoverLookupError.declaresNoParameterList
		end 'noList'

		return after
	end 'signatureListIndex'

	// Where a `function` head stops: past the dotted name path it declares, at the `(` when there is one.
	function signatureHeadEnd(functionIndex TokenIndex) returns TokenIndex
		let total = tokens.count()
		var index = functionIndex + 1

		while index < total and tokenCanBeAName(tokenAt(index)) 'head'
			index = index + 1

			if tokenAt(index).kind != TokenKind.dot 'thePathEnds'
				break
			end 'thePathEnds'

			index = index + 1
		end 'head'

		return index
	end 'signatureHeadEnd'

	// A parameter NAME is the identifier that OPENS a parameter — the one right after the `(`, or after
	// the comma that ended the previous one, at the list's own bracket depth. Everything else in the
	// list belongs to that parameter's type or its default.
	function parameterNamed(functionIndex TokenIndex, openIndex TokenIndex, name ByteArray) returns HoverDeclaration
		let total = tokens.count()
		var depth = 0
		var index = openIndex
		var atParameterStart = false

		while index < total 'scan'
			let tok = tokenAt(index)

			if tokenKindOpensABracket(tok.kind) 'opens'
				depth = depth + 1
				atParameterStart = depth == 1
			end 'opens' else if tokenKindClosesABracket(tok.kind) 'closes'
				depth = depth - 1

				if depth == 0 'listEnds'
					break
				end 'listEnds'
			end 'closes' else if tok.kind == TokenKind.comma and depth == 1 'nextParameter'
				atParameterStart = true
			end 'nextParameter' else if atParameterStart and tokenCanBeAName(tok) 'parameterName'
				atParameterStart = false

				if tok.value.equals(name) 'thisOne'
					return HoverDeclaration.parameter(functionIndex, nameIndex: index)
				end 'thisOne'
			end 'parameterName'

			index = index + 1
		end 'scan'

		return HoverDeclaration.none
	end 'parameterNamed'

	// --- Rendering a declaration --------------------------------------------------------------

	// A function, a type, an interface: the head as the author wrote it, plus whatever `///` lines sit
	// above it. ONE function for all of them, because there is one answer — the source is the best
	// description of a declaration there is.
	function declarationHeadRendering(keyword TokenIndex) returns HoverRendering
		let start = declarationStart(keyword)
		var prose = StringArray.create()
		appendDocComment(prose, above: start)
		return HoverRendering.present(hoverMarkdown(headText(start), prose: prose))
	end 'declarationHeadRendering'

	// `bindingNote` is handed the type rather than asked for it again: this rendering needs the same
	// answer to choose `present` over `untyped`, and computing it twice lets the prose and that choice
	// disagree.
	function bindingRendering(keyword TokenIndex) returns HoverRendering
		let start = declarationStart(keyword)
		let inferred = bindingType(keyword, reach: HoverDeclarationHopBudget)
		var prose = StringArray.create()
		appendDocComment(prose, above: start)
		prose.push(bindingNote(keyword, inferred: inferred))

		let markdown = hoverMarkdown(headText(start), prose: prose)

		match inferred 'typed'
			named then return HoverRendering.present(markdown)
			unknown then return HoverRendering.untyped(markdown)
		end 'typed'
	end 'bindingRendering'

	function parameterRendering(functionIndex TokenIndex, nameIndex TokenIndex) returns HoverRendering
		var prose = StringArray.create()
		prose.push("Parameter of {routineNamePhrase(functionIndex)}.")
		return HoverRendering.present(hoverMarkdown(parameterText(nameIndex), prose: prose))
	end 'parameterRendering'

	// What a binding IS, in words: where it lives, whether it can change, and its type.
	function bindingNote(keyword TokenIndex, inferred HoverType) returns String
		var note = bindingSubject(keyword)

		match inferred 'typed'
			named(_, rendered, _) then note.append(", of type `{rendered}`")
			unknown then note.append(UninferredTypePhrase)
		end 'typed'

		note.append(SentenceEnd)
		return note
	end 'bindingNote'

	// Where a binding lives, which is what its hover calls it.
	//
	// ⚠ **COLUMN 1 DECIDES TOP-LEVEL; THE DOCUMENT'S BLOCK STRUCTURE DECIDES THE REST.** The first is the
	// layout heuristic the file header names. The second is not: a field is a line its container holds
	// DIRECTLY, so a `var count = 0` carrying a default reads as a field among the members and as a local
	// inside a method — which is the one thing telling the two apart by spelling cannot do.
	function bindingSubject(keyword TokenIndex) returns String
		if tokenAt(keyword).kind == TokenKind.for 'walksACollection'
			return LoopVariableSubject
		end 'walksACollection'

		let mutability = "constant" if tokenAt(keyword).kind == TokenKind.let else "variable"

		if tokenAt(declarationStart(keyword)).column == TopLevelColumn 'moduleScope'
			return "Module-level {mutability}"
		end 'moduleScope'

		match containerDeclaring(keyword) 'inside'
			declaredIn(name) then return "Field of `{String.from(name)}`"
			notAMemberLine then return "Local {mutability}"
		end 'inside'
	end 'bindingSubject'

	function containerDeclaring(keyword TokenIndex) returns HoverMemberOwner
		let blocks = lspDocumentBlocks(tokens)
		let line = lspLineOf(tokenAt(declarationStart(keyword)).line)

		for block in blocks 'eachBlock'
			if not lspBlockDeclaresMembers(block.kind) 'holdsNoMembers'
				continue
			end 'holdsNoMembers'

			if lspBlockDirectlyHoldsLine(blocks, block: block, line: line) 'itsOwnMemberLine'
				return HoverMemberOwner.declaredIn(block.name)
			end 'itsOwnMemberLine'
		end 'eachBlock'

		return HoverMemberOwner.notAMemberLine
	end 'containerDeclaring'

	// What a declaration at `index` sits inside: the nearest `function` or container keyword above it.
	function enclosureOf(index TokenIndex) returns HoverEnclosure
		var back = 0

		while back < index 'backward'
			let at = index - back - 1
			let kind = tokenAt(at).kind

			if kind == TokenKind.function 'insideARoutine'
				return HoverEnclosure.routine(at)
			end 'insideARoutine'

			if kindDeclaresAContainer(kind) 'insideAContainer'
				return HoverEnclosure.container(at)
			end 'insideAContainer'

			back = back + 1
		end 'backward'

		return HoverEnclosure.none
	end 'enclosureOf'

	// --- Types --------------------------------------------------------------------------------

	function bindingType(keyword TokenIndex, reach HoverReceiverReach) returns HoverType
		let afterName = keyword + TokensInABindingHead

		if tokenAt(keyword).kind == TokenKind.for 'walksACollection'
			return loopElementType(afterName, reach: reach)
		end 'walksACollection'

		if tokenAt(afterName).kind == TokenKind.equals 'initialized'
			return inferredTypeAt(afterName + 1, reach: reach)
		end 'initialized'

		// `var x as Coord` — the `as` is the language's own field spelling, and the type follows it.
		if tokenAt(afterName).kind == TokenKind.as 'spelledWithAs'
			return declaredTypeAt(afterName + 1)
		end 'spelledWithAs'

		return declaredTypeAt(afterName)
	end 'bindingType'

	function followedBindingType(head TokenIndex, reach HoverReceiverReach) returns HoverType
		if reach == NoDeclarationHopsLeft 'theWalkStopsHere'
			return HoverType.unknown
		end 'theWalkStopsHere'

		return bindingType(head, reach: reach - 1)
	end 'followedBindingType'

	function loopElementType(inIndex TokenIndex, reach HoverReceiverReach) returns HoverType
		if tokenAt(inIndex).kind != TokenKind.in 'noCollectionClause'
			return HoverType.unknown
		end 'noCollectionClause'

		return elementTypeAt(inIndex + 1, reach: reach)
	end 'loopElementType'

	// A parameter's type is what follows its name, up to the comma or parenthesis that ends it.
	function parameterType(nameIndex TokenIndex) returns HoverType
		return declaredTypeAt(nameIndex + 1)
	end 'parameterType'

	// A type written out, from `index` to the end of what is being declared. Rendered as the author
	// spelled it, and looked up under the whole dotted path: the registries are keyed that way, so
	// `Counter.handle` is a type this program has and its first segment is a different one sharing a
	// prefix.
	function declaredTypeAt(index TokenIndex) returns HoverType
		let opening = tokenAt(index)

		if opening.endByte == opening.startByte 'noTypeHere'
			return HoverType.unknown
		end 'noTypeHere'

		let base = sourceBetween(opening.startByte, endByte: tokenAt(dottedNameEnd(index)).endByte).toByteArray()

		return HoverType.named(base, rendered: sourceBetween(opening.startByte, endByte: typeEndByte(index)), written: base)
	end 'declaredTypeAt'

	function dottedNameEnd(index TokenIndex) returns TokenIndex
		var last = index

		while tokenAt(last + 1).kind == TokenKind.dot and tokenCanBeAName(tokenAt(last + TokensPerDottedSegment)) 'eachSegment'
			last = last + TokensPerDottedSegment
		end 'eachSegment'

		return last
	end 'dottedNameEnd'

	// Where a written-out type stops: at the `=` of a default, at the `throws` clause of a signature, or
	// at the end of its own line.
	function typeEndByte(index TokenIndex) returns ByteOffset
		let total = tokens.count()
		var last = tokenAt(index).endByte
		var at = index

		while at < total 'scan'
			let tok = tokenAt(at)

			if tok.kind == TokenKind.newline or tok.kind == TokenKind.equals or tok.kind == TokenKind.comma or tok.kind == TokenKind.rightParen or tok.kind == TokenKind.throws 'typeEnds'
				break
			end 'typeEnds'

			if tok.endByte > last 'spans'
				last = tok.endByte
			end 'spans'

			at = at + 1
		end 'scan'

		return last
	end 'typeEndByte'

	// A function's DECLARED return type: what follows `returns` on the signature's own line.
	//
	// ⭐ **READING A DECLARATION IS NOT THE GUESSING `inferredTypeAt` REFUSES.** `returns cstring` is
	// written down in the token stream by the author, and nothing here is derived from how the function is
	// used. It is one clause of the head `declarationHeadRendering` already shows a reader, asked for alone.
	function returnTypeOf(functionIndex TokenIndex) returns HoverType
		let total = tokens.count()
		var depth = 0
		var index = functionIndex

		while index < total 'signature'
			let kind = tokenAt(index).kind

			if kind == TokenKind.newline and depth == 0 'signatureEnds'
				break
			end 'signatureEnds'

			if kind == TokenKind.returns and depth == 0 'returnClause'
				return declaredTypeAt(index + 1)
			end 'returnClause'

			if tokenKindOpensABracket(kind) 'opens'
				depth = depth + 1
			end 'opens' else if tokenKindClosesABracket(kind) and depth > 0 'closes'
				depth = depth - 1
			end 'closes'

			index = index + 1
		end 'signature'

		return HoverType.unknown
	end 'returnTypeOf'

	// The type an initializer expression implies.
	//
	// ⛔⛔ **A LITERAL DESCRIBES THE VALUE ONLY WHEN IT IS THE WHOLE EXPRESSION.**
	// `"out.bin".toByteArray().managed` opens with a string literal and is not a `String`; reading the head
	// token alone put that wrong type in front of a reader who had no way to tell it from a right one. So
	// `valueAt` reports where the leading value ENDS, and anything applied to it after that — a `.`, a `(`,
	// a `[`, an operator, an `as` — leaves the answer `unknown`, which a rendering says out loud.
	//
	// ⚠ **STILL NO ARITHMETIC AND NO TYPECHECKING.** A call is answered from its callee's DECLARED
	// return type, which is a fact sitting in the token stream; nothing here infers a type from how a value
	// is used.
	function inferredTypeAt(index TokenIndex, reach HoverReceiverReach) returns HoverType
		match valueAt(index, reach: reach) 'value'
			spans(inferred, after) then return typeOfWholeExpression(inferred, after: after)
			none then return HoverType.unknown
		end 'value'
	end 'inferredTypeAt'

	function typeOfWholeExpression(inferred HoverType, after TokenIndex) returns HoverType
		if kindEndsAnExpression(tokenAt(after).kind) 'nothingAppliedToIt'
			return inferred
		end 'nothingAppliedToIt'

		return HoverType.unknown
	end 'typeOfWholeExpression'

	// What the expression starting at `index` is, and where it stops.
	function valueAt(index TokenIndex, reach HoverReceiverReach) returns HoverValue
		let tok = tokenAt(index)

		if tok.kind == TokenKind.intLiteral 'wholeNumber'
			return HoverValue.spans(nominalType(IntTypeName), after: index + 1)
		end 'wholeNumber'

		if tok.kind == TokenKind.floatLiteral 'realNumber'
			return HoverValue.spans(nominalType(FloatTypeName), after: index + 1)
		end 'realNumber'

		if tok.kind == TokenKind.stringLiteral 'text'
			return HoverValue.spans(nominalType(StringTypeName), after: afterStringValue(index))
		end 'text'

		if tok.kind == TokenKind.true or tok.kind == TokenKind.false 'truth'
			return HoverValue.spans(nominalType(BoolTypeName), after: index + 1)
		end 'truth'

		if tok.kind == TokenKind.try 'aFallibleValue'
			return valueAt(index + 1, reach: reach)
		end 'aFallibleValue'

		if tok.kind == TokenKind.leftBracket 'arrayLiteral'
			return bracketedValue(index, inferred: arrayTypeOfElementAt(index, reach: reach))
		end 'arrayLiteral'

		// `Point{x: 1, y: 2}` — a struct literal names its own type.
		if tok.kind == TokenKind.identifier and tokenAt(index + 1).kind == TokenKind.leftBrace 'structLiteral'
			return bracketedValue(index + 1, inferred: nominalType(tok.value))
		end 'structLiteral'

		return callValueAt(index, reach: reach)
	end 'valueAt'

	function afterStringValue(index TokenIndex) returns TokenIndex
		let total = tokens.count()
		var depth = 0
		var at = index

		while at < total 'scan'
			let kind = tokenAt(at).kind

			if kind == TokenKind.stringInterpStart 'opensAHole'
				depth = depth + 1
			end 'opensAHole' else if kind == TokenKind.stringInterpEnd 'closesOne'
				depth = depth - 1
			end 'closesOne' else if depth == 0 and kind != TokenKind.stringLiteral 'pastTheLastFragment'
				break
			end 'pastTheLastFragment'

			at = at + 1
		end 'scan'

		return at
	end 'afterStringValue'

	// A value whose extent is a bracket group. One the buffer never closes is no value at all — mid-edit
	// that is routine — so `none` says so rather than a position past the end standing in for it.
	function bracketedValue(openIndex TokenIndex, inferred HoverType) returns HoverValue
		let after = try afterBracketedGroup(openIndex) otherwise return HoverValue.none

		return HoverValue.spans(inferred, after: after)
	end 'bracketedValue'

	// The token just past the bracket group opened at `openIndex`.
	function afterBracketedGroup(openIndex TokenIndex) returns TokenIndex throws HoverLookupError
		let total = tokens.count()
		var depth = 0
		var index = openIndex

		while index < total 'scan'
			let kind = tokenAt(index).kind

			if tokenKindOpensABracket(kind) 'opens'
				depth = depth + 1
			end 'opens' else if tokenKindClosesABracket(kind) 'closes'
				depth = depth - 1

				if depth == 0 'groupEnds'
					return index + 1
				end 'groupEnds'
			end 'closes'

			index = index + 1
		end 'scan'

		throw HoverLookupError.unclosedBracketGroup
	end 'afterBracketedGroup'

	// `f(…)`, `String.from(…)`, `path.cstr(…)` — a call, and the type its callee is DECLARED to answer.
	function callValueAt(index TokenIndex, reach HoverReceiverReach) returns HoverValue
		if not tokenCanBeAName(tokenAt(index)) 'notACalleeName'
			return HoverValue.none
		end 'notACalleeName'

		var lastSegment = index

		while tokenAt(lastSegment + 1).kind == TokenKind.dot and tokenCanBeAName(tokenAt(lastSegment + 2)) 'pathSegment'
			lastSegment = lastSegment + 2
		end 'pathSegment'

		if tokenAt(lastSegment + 1).kind != TokenKind.leftParen 'notACall'
			return HoverValue.none
		end 'notACall'

		let after = try afterBracketedGroup(lastSegment + 1) otherwise return HoverValue.none

		return HoverValue.spans(calleeResultType(lastSegment, reach: reach), after: after)
	end 'callValueAt'

	function calleeResultType(nameIndex TokenIndex, reach HoverReceiverReach) returns HoverType
		if not memberAccessAt(nameIndex) 'bareName'
			return bareCalleeReturnType(nameIndex)
		end 'bareName'

		match typeOfReceiverEndingAt(nameIndex - TokensBetweenAReceiverAndItsMember, reach: reach) 'receiver'
			named(base, _, written) then return boundMemberType(methodReturnType(base, method: tokenAt(nameIndex).value), written: written)
			unknown then return HoverType.unknown
		end 'receiver'
	end 'calleeResultType'

	// The math-intrinsic roster first and a declaration second, in `calleeRendering`'s order and for its
	// reason: the intrinsic shadows any declaration wearing the same name, so answering from the
	// declaration would describe the function the compiler is not going to call.
	function bareCalleeReturnType(nameIndex TokenIndex) returns HoverType
		let name = tokenAt(nameIndex).value

		match mathBuiltinNamed(name) 'reserved'
			found(builtin) then return mathBuiltinReturnType(builtin)
			absent then return returnTypeOfDeclaration(declarationOf(name, near: nameIndex, scope: HoverDeclarationScope.everyDeclaration))
		end 'reserved'
	end 'bareCalleeReturnType'

	// A math intrinsic's return type, read from the SIGNATURE the roster already carries. That signature is
	// Maxon source, so it is asked the question a declaration in a document is asked; a second table of the
	// eight return types would be the same fact written twice.
	function mathBuiltinReturnType(builtin MathBuiltin) returns HoverType
		let signature = try Self.of(mathBuiltinSignature(builtin), keywords: keywords, corpus: LspCorpus.unavailable) otherwise return HoverType.unknown
		return signature.returnTypeOf(FirstToken)
	end 'mathBuiltinReturnType'

	// ⚠ **`Array with int` IS MAXON'S OWN SPELLING OF THIS TYPE**, and it is what a reader would have to
	// TYPE to declare one. See `HoverType` for why the compiler's own renderer cannot supply it.
	function arrayTypeOfElementAt(index TokenIndex, reach HoverReceiverReach) returns HoverType
		match elementTypeAt(index, reach: reach) 'element'
			named(_, rendered, _) then return HoverType.named(ArrayTypeName, rendered: "{ArrayTypeSpelling}{rendered}", written: ArrayTypeName)
			unknown then return nominalType(ArrayTypeName)
		end 'element'
	end 'arrayTypeOfElementAt'

	function elementTypeAt(index TokenIndex, reach HoverReceiverReach) returns HoverType
		if tokenAt(index).kind == TokenKind.leftBracket 'anArrayLiteral'
			return inferredTypeAt(index + 1, reach: reach)
		end 'anArrayLiteral'

		if not tokenCanBeAName(tokenAt(index)) 'notACollectionThisWalkCanFollow'
			return HoverType.unknown
		end 'notACollectionThisWalkCanFollow'

		return elementTypeOfNamed(tokenAt(index).value, near: index, reach: reach)
	end 'elementTypeAt'

	function elementTypeOfNamed(name ByteArray, near TokenIndex, reach HoverReceiverReach) returns HoverType
		if reach == NoDeclarationHopsLeft 'theWalkStopsHere'
			return HoverType.unknown
		end 'theWalkStopsHere'

		match declarationSite(declarationOf(name, near: near, scope: HoverDeclarationScope.everyDeclaration), kind: HoverDeclarationKind.binding) 'aBinding'
			at(head) then return elementTypeOfInitializer(head, reach: reach - 1)
			none then return HoverType.unknown
		end 'aBinding'
	end 'elementTypeOfNamed'

	function elementTypeOfInitializer(keyword TokenIndex, reach HoverReceiverReach) returns HoverType
		let afterName = keyword + TokensInABindingHead

		if tokenAt(afterName).kind != TokenKind.equals 'nothingInitializesIt'
			return HoverType.unknown
		end 'nothingInitializesIt'

		let initializer = afterName + 1

		if tokenAt(initializer).kind != TokenKind.leftBracket 'notAnArrayLiteral'
			return HoverType.unknown
		end 'notAnArrayLiteral'

		return inferredTypeAt(initializer + 1, reach: reach)
	end 'elementTypeOfInitializer'

	// --- Members ------------------------------------------------------------------------------

	// `receiver.member` — the member is resolved through what the RECEIVER is, which is the only way a
	// method call can be told from a field access or a name that merely repeats one.
	function memberRendering(index TokenIndex) returns HoverRendering
		if index < TokensBetweenAReceiverAndItsMember 'noReceiver'
			return HoverRendering.absent
		end 'noReceiver'

		match typeOfReceiverEndingAt(index - TokensBetweenAReceiverAndItsMember, reach: HoverDeclarationHopBudget) 'ofType'
			named(base, _, _) then return methodRendering(base, method: tokenAt(index).value)
			unknown then return HoverRendering.absent
		end 'ofType'
	end 'memberRendering'

	module function receiverSubject(receiver TokenIndex) returns LspSubject
		return match receiverEndingAt(receiver, reach: HoverDeclarationHopBudget) 'receiver'
			value(inferred) gives surfaceSubject(inferred, ofAValue: true)
			typeSurface(inferred) gives surfaceSubject(inferred, ofAValue: false)
			nothing gives LspSubject.nothingNamed
		end 'receiver'
	end 'receiverSubject'

	function typeOfReceiverEndingAt(last TokenIndex, reach HoverReceiverReach) returns HoverType
		return match receiverEndingAt(last, reach: reach) 'receiver'
			value(inferred) or
				typeSurface gives inferred
			nothing gives HoverType.unknown
		end 'receiver'
	end 'typeOfReceiverEndingAt'

	function receiverEndingAt(last TokenIndex, reach HoverReceiverReach) returns HoverReceiver
		return resolvedReceiver(bareReceiverEndingAt(last, reach: reach))
	end 'receiverEndingAt'

	function bareReceiverEndingAt(last TokenIndex, reach HoverReceiverReach) returns HoverReceiver
		let tok = tokenAt(last)

		if tokenKindClosesABracket(tok.kind) 'aCallOrAGroup'
			return HoverReceiver.value(callResultEndingAt(last, reach: reach))
		end 'aCallOrAGroup'

		if not tokenCanBeAName(tok) 'notANameToResolveOn'
			return HoverReceiver.nothing
		end 'notANameToResolveOn'

		if memberAccessAt(last) 'aMemberOfSomethingElse'
			return HoverReceiver.value(memberTypeEndingAt(last, reach: reach))
		end 'aMemberOfSomethingElse'

		return receiverOf(tok.value, near: last, reach: reach)
	end 'bareReceiverEndingAt'

	function memberAccessAt(index TokenIndex) returns bool
		if index < TokensBetweenAReceiverAndItsMember 'noReceiverCouldPrecedeIt'
			return false
		end 'noReceiverCouldPrecedeIt'

		return lspCursorNamesAMember(tokens, cursor: index)
	end 'memberAccessAt'

	function memberTypeEndingAt(last TokenIndex, reach HoverReceiverReach) returns HoverType
		match typeOfReceiverEndingAt(last - TokensBetweenAReceiverAndItsMember, reach: reach) 'ofType'
			named(base, _, written) then return boundMemberType(memberType(base, member: tokenAt(last).value, reach: reach), written: written)
			unknown then return HoverType.unknown
		end 'ofType'
	end 'memberTypeEndingAt'

	function boundMemberType(member HoverMemberType, written ByteArray) returns HoverType
		match member 'ofType'
			bound(inferred) then return inferred
			ownersTypeParameter(position) then return typeArgumentAt(position, written: written)
			none then return HoverType.unknown
		end 'ofType'
	end 'boundMemberType'

	function typeArgumentAt(position TypeParamPosition, written ByteArray) returns HoverType
		match aliasArgumentHere(written, position: position) 'inThisDocument'
			at(argument) then return nominalType(tokenAt(argument).value)
			none then return corpusTypeArgument(written, position: position)
		end 'inThisDocument'
	end 'typeArgumentAt'

	function aliasArgumentHere(name ByteArray, position TypeParamPosition) returns HoverDeclarationSite
		match aliasTargetHere(name) 'anAlias'
			at(target) then return typeArgumentAfter(target, position: position)
			none then return HoverDeclarationSite.none
		end 'anAlias'
	end 'aliasArgumentHere'

	// A dotted argument is refused rather than answered: this walk sees single name tokens, so
	// `Array with FrontEndWorker.handle` would come back as `FrontEndWorker`, a different type. The corpus
	// road below spells the qualified name instead.
	function typeArgumentAfter(base TokenIndex, position TypeParamPosition) returns HoverDeclarationSite
		let withClause = base + 1

		if tokenAt(withClause).kind != TokenKind.with 'bindsNoArguments'
			return HoverDeclarationSite.none
		end 'bindsNoArguments'

		let opening = withClause + 1
		var index = opening + 1 if tokenAt(opening).kind == TokenKind.leftParen else opening
		var bound = 0 as TypeParamPosition

		while tokenCanBeAName(tokenAt(index)) 'eachArgument'
			if bound == position 'thisOne'
				return HoverDeclarationSite.none if tokenAt(index + 1).kind == TokenKind.dot else HoverDeclarationSite.at(index)
			end 'thisOne'

			if tokenAt(index + 1).kind != TokenKind.comma 'theListEnds'
				break
			end 'theListEnds'

			bound = bound + 1
			index = index + TokensPerListedName
		end 'eachArgument'

		return HoverDeclarationSite.none
	end 'typeArgumentAfter'

	function corpusTypeArgument(written ByteArray, position TypeParamPosition) returns HoverType
		match corpus 'held'
			loaded(_, signatures, readerPath) then return declaredTypeArgument(signatures, written: written, position: position, readerPath: readerPath)
			unavailable then return HoverType.unknown
		end 'held'
	end 'corpusTypeArgument'

	// ⚠ `instanceArgsAreFullyConcrete` is what keeps this from reopening the leak one level down:
	// `instanceArgDisplayName` hands back a type parameter's own name for an argument that is still one.
	function declaredTypeArgument(signatures ProgramSignatures, written ByteArray, position TypeParamPosition, readerPath FilePath) returns HoverType
		if not signatures.isGenericAliasInAnyFile(written) 'namesNoInstance'
			return HoverType.unknown
		end 'namesNoInstance'

		let instance = signatures.genericAliasInstanceFrom(written, readerFilePath: readerPath)

		if not signatures.instanceArgsAreFullyConcrete(instance) 'stillParametric'
			return HoverType.unknown
		end 'stillParametric'

		if position >= signatures.genericInstanceArgCount(instance) 'boundByNothing'
			return HoverType.unknown
		end 'boundByNothing'

		return nominalType(signatures.instanceArgDisplayName(instance, position: position))
	end 'declaredTypeArgument'

	// Asked of the document that DECLARES the member, which is the same document that declares the
	// parameter list — so the position cannot disagree with the signature the rendering shows.
	function typeParamSiteIn(owner ByteArray, name ByteArray) returns HoverTypeParamSite
		match declarationOf(owner, near: FirstToken, scope: HoverDeclarationScope.everyDeclaration) 'declared'
			typeName(head) then return typeParamPositionAt(head, name: name)
			binding or
				parameter or
				routine or
				none then return HoverTypeParamSite.none
		end 'declared'
	end 'typeParamSiteIn'

	function typeParamPositionAt(head TokenIndex, name ByteArray) returns HoverTypeParamSite
		if tokenAt(head + TokensInADeclarationHead).kind != TokenKind.uses 'declaresNoTypeParameters'
			return HoverTypeParamSite.none
		end 'declaresNoTypeParameters'

		var index = head + TokensInADeclarationHead + 1
		var position = 0 as TypeParamPosition

		while tokenCanBeAName(tokenAt(index)) 'eachParameter'
			if tokenAt(index).value.equals(name) 'thisOne'
				return HoverTypeParamSite.at(position)
			end 'thisOne'

			if tokenAt(index + 1).kind != TokenKind.comma 'theListEnds'
				break
			end 'theListEnds'

			position = position + 1
			index = index + TokensPerListedName
		end 'eachParameter'

		return HoverTypeParamSite.none
	end 'typeParamPositionAt'

	function memberTypeOrParameter(inferred HoverType, owner ByteArray) returns HoverMemberType
		match inferred 'ofType'
			named(base, _, _) then return parameterOrBound(inferred, base: base, owner: owner)
			unknown then return HoverMemberType.none
		end 'ofType'
	end 'memberTypeOrParameter'

	function parameterOrBound(inferred HoverType, base ByteArray, owner ByteArray) returns HoverMemberType
		match typeParamSiteIn(owner, name: base) 'aParameter'
			at(position) then return HoverMemberType.ownersTypeParameter(position)
			none then return HoverMemberType.bound(inferred)
		end 'aParameter'
	end 'parameterOrBound'

	function callResultEndingAt(closeIndex TokenIndex, reach HoverReceiverReach) returns HoverType
		if tokenAt(closeIndex).kind != TokenKind.rightParen 'notACallsClosingBracket'
			return HoverType.unknown
		end 'notACallsClosingBracket'

		let openIndex = try beforeBracketedGroup(closeIndex) otherwise return HoverType.unknown

		if openIndex == 0 'nothingIsBeingCalled'
			return HoverType.unknown
		end 'nothingIsBeingCalled'

		if not tokenCanBeAName(tokenAt(openIndex - 1)) 'aParenthesisedExpression'
			return HoverType.unknown
		end 'aParenthesisedExpression'

		return calleeResultType(openIndex - 1, reach: reach)
	end 'callResultEndingAt'

	function beforeBracketedGroup(closeIndex TokenIndex) returns TokenIndex throws HoverLookupError
		var depth = 0
		var index = closeIndex

		while true 'scan'
			let kind = tokenAt(index).kind

			if tokenKindClosesABracket(kind) 'closes'
				depth = depth + 1
			end 'closes' else if tokenKindOpensABracket(kind) 'opens'
				depth = depth - 1

				if depth == 0 'groupBegins'
					return index
				end 'groupBegins'
			end 'opens'

			if index == 0 'theStreamBegins'
				break
			end 'theStreamBegins'

			index = index - 1
		end 'scan'

		throw HoverLookupError.unclosedBracketGroup
	end 'beforeBracketedGroup'

	function memberType(owner ByteArray, member ByteArray, reach HoverReceiverReach) returns HoverMemberType
		match declarationSite(memberDeclaredHere(owner, member: member), kind: HoverDeclarationKind.binding) 'aFieldHere'
			at(head) then return memberTypeOrParameter(followedBindingType(head, reach: reach), owner: owner)
			none then return corpusFieldType(owner, member: member)
		end 'aFieldHere'
	end 'memberType'

	function corpusFieldType(owner ByteArray, member ByteArray) returns HoverMemberType
		match corpus 'held'
			loaded(_, signatures, readerPath) then return declaredFieldType(signatures, owner: owner, member: member, readerPath: readerPath)
			unavailable then return HoverMemberType.none
		end 'held'
	end 'corpusFieldType'

	function declaredFieldType(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns HoverMemberType
		match lspVisibleFieldOf(signatures, owner: owner, member: member, readerPath: readerPath) 'aField'
			declared(layout, index) then return brandedMemberType(signatures, brand: layout.fieldDeclaredBrand(index), owner: owner, declFilePath: layout.declFilePath)
			hidden or
				none then return HoverMemberType.none
		end 'aField'
	end 'declaredFieldType'

	// The brand is read in the scope that WROTE it. A plain `typealias` is file-local, so two files may
	// mean different containers by one word.
	function brandedMemberType(signatures ProgramSignatures, brand ByteArray, owner ByteArray, declFilePath FilePath) returns HoverMemberType
		if brand.isEmpty() 'noDeclaredSpelling'
			return HoverMemberType.none
		end 'noDeclaredSpelling'

		if let owning = try signatures.typeParamOwnerOf(typeParamTokenFor(owner, paramName: brand)) 'aParameterOfTheOwner'
			return HoverMemberType.ownersTypeParameter(owning.position)
		end 'aParameterOfTheOwner'

		return HoverMemberType.bound(nominalType(signatures.denotedGenericBaseName(brand, readerFilePath: declFilePath)))
	end 'brandedMemberType'

	function resolvedReceiver(receiver HoverReceiver) returns HoverReceiver
		match receiver 'resolved'
			value(inferred) then return HoverReceiver.value(resolvedTypeName(inferred))
			typeSurface(inferred) then return HoverReceiver.typeSurface(resolvedTypeName(inferred))
			nothing then return HoverReceiver.nothing
		end 'resolved'
	end 'resolvedReceiver'

	function resolvedTypeName(inferred HoverType) returns HoverType
		match inferred 'ofType'
			named(base, rendered, written) then return HoverType.named(resolvedBaseName(base), rendered: rendered, written: written)
			unknown then return HoverType.unknown
		end 'ofType'
	end 'resolvedTypeName'

	function resolvedBaseName(base ByteArray) returns ByteArray
		match aliasTargetHere(base) 'inThisDocument'
			at(target) then return tokenAt(target).value
			none then return corpusBaseName(base)
		end 'inThisDocument'
	end 'resolvedBaseName'

	function aliasTargetHere(name ByteArray) returns HoverDeclarationSite
		match declarationOf(name, near: FirstToken, scope: HoverDeclarationScope.everyDeclaration) 'declared'
			typeName(head) then return aliasTargetAt(head)
			binding or
				parameter or
				routine or
				none then return HoverDeclarationSite.none
		end 'declared'
	end 'aliasTargetHere'

	function aliasTargetAt(head TokenIndex) returns HoverDeclarationSite
		if tokenAt(head).kind != TokenKind.typealias 'declaresATypeOfItsOwn'
			return HoverDeclarationSite.none
		end 'declaresATypeOfItsOwn'

		if tokenAt(declarationStart(head)).column != TopLevelColumn 'anInnerAlias'
			return HoverDeclarationSite.none
		end 'anInnerAlias'

		if tokenAt(head + TokensInADeclarationHead).kind != TokenKind.equals 'namesNothing'
			return HoverDeclarationSite.none
		end 'namesNothing'

		let target = head + TokensInADeclarationHead + 1

		if not tokenCanBeAName(tokenAt(target)) 'notANominalType'
			return HoverDeclarationSite.none
		end 'notANominalType'

		return HoverDeclarationSite.at(target)
	end 'aliasTargetAt'

	function corpusBaseName(base ByteArray) returns ByteArray
		match corpus 'held'
			loaded(_, signatures, readerPath) then return signatures.denotedGenericBaseName(base, readerFilePath: readerPath)
			unavailable then return base
		end 'held'
	end 'corpusBaseName'

	function surfaceSubject(inferred HoverType, ofAValue bool) returns LspSubject
		match inferred 'ofType'
			named(base, _, _) then return LspSubject.instanceSurfaceOf(String.from(base)) if ofAValue else LspSubject.staticSurfaceOf(String.from(base))
			unknown then return LspSubject.nothingNamed
		end 'ofType'
	end 'surfaceSubject'

	// What a receiver stands for, and whether it names a VALUE or the type itself — a distinction
	// completion needs and hover does not, decided once here because both come through this door.
	// `self` and `Self` carry no declaration to read a type off, so the enclosing container is the only
	// thing that can name them. A name no declaration in this document claims is taken to be a type,
	// which is what carries a static call like `String.fromCString` into `stdlib/`.
	function receiverOf(name ByteArray, near TokenIndex, reach HoverReceiverReach) returns HoverReceiver
		let kind = tokenAt(near).kind

		if kind == TokenKind.self 'theEnclosingInstance'
			return HoverReceiver.value(enclosingTypeName(near))
		end 'theEnclosingInstance'

		if kind == TokenKind.selfType 'theEnclosingTypeItself'
			return HoverReceiver.typeSurface(enclosingTypeName(near))
		end 'theEnclosingTypeItself'

		match declarationOf(name, near: near, scope: HoverDeclarationScope.everyDeclaration) 'resolved'
			binding(head) then return HoverReceiver.value(followedBindingType(head, reach: reach))
			parameter(_, nameIndex) then return HoverReceiver.value(parameterType(nameIndex))
			typeName(head) then return HoverReceiver.typeSurface(declaredTypeNameAt(head))
			routine then return HoverReceiver.nothing
			none then return HoverReceiver.typeSurface(nominalType(name))
		end 'resolved'
	end 'receiverOf'

	function enclosingTypeName(index TokenIndex) returns HoverType
		match enclosingContainerOf(index) 'inside'
			container(at) then return declaredTypeNameAt(at)
			routine or
				none then return HoverType.unknown
		end 'inside'
	end 'enclosingTypeName'

	function enclosingContainerOf(index TokenIndex) returns HoverEnclosure
		var at = index

		while at > 0 'outward'
			let nearest = enclosureOf(at)

			match nearest 'kind'
				container then return nearest
				routine(head) then at = head
				none then return HoverEnclosure.none
			end 'kind'
		end 'outward'

		return HoverEnclosure.none
	end 'enclosingContainerOf'

	function declaredTypeNameAt(keyword TokenIndex) returns HoverType
		let named = tokenAt(keyword + 1)

		if not tokenCanBeAName(named) 'unnamed'
			return HoverType.unknown
		end 'unnamed'

		return nominalType(named.value)
	end 'declaredTypeNameAt'

	function methodRendering(receiver ByteArray, method ByteArray) returns HoverRendering
		match lookupOwnerOf(receiver, member: method) 'declaringType'
			at(owner) then return declaredMemberRendering(owner, method: method)
			none then return HoverRendering.absent
		end 'declaringType'
	end 'methodRendering'

	function declaredMemberRendering(owner ByteArray, method ByteArray) returns HoverRendering
		if declarationWasFound(memberDeclaredHere(owner, member: method)) 'declaredInThisDocument'
			return declaredMethodRendering(owner, method: method)
		end 'declaredInThisDocument'

		match memberDeclaringDocument(owner, member: method) 'elsewhere'
			at(declaring) then return declaring.declaredMethodRendering(owner, method: method)
			none then return HoverRendering.absent
		end 'elsewhere'
	end 'declaredMemberRendering'

	function declaredMethodRendering(owner ByteArray, method ByteArray) returns HoverRendering
		return renderingOfDeclaration(memberDeclaredHere(owner, member: method))
	end 'declaredMethodRendering'

	// A service handle's members are its service's. The mapping is applied HERE, at the member lookup, and
	// never to the type name: hovering the receiver itself must still say `Counter.handle`, and a mapped
	// type name would offer the service's own private fields.
	function lookupOwnerOf(receiver ByteArray, member ByteArray) returns HoverDeclaringType
		match corpus 'held'
			loaded(_, signatures, _) then return handleLookupOwner(signatures, receiver: receiver, member: member)
			unavailable then return HoverDeclaringType.at(receiver)
		end 'held'
	end 'lookupOwnerOf'

	function handleLookupOwner(signatures ProgramSignatures, receiver ByteArray, member ByteArray) returns HoverDeclaringType
		match lspHandleSurfaceOf(signatures, typeName: receiver) 'aHandle'
			messages(serviceName, request) then return HoverDeclaringType.at(serviceName) if serviceHandleAdmits(request, member: member) else HoverDeclaringType.none
			notAHandle then return HoverDeclaringType.at(receiver)
		end 'aHandle'
	end 'handleLookupOwner'

	module function bindsTheName(name ByteArray, near TokenIndex) returns bool
		return declarationWasFound(declarationOf(name, near: near, scope: HoverDeclarationScope.everyDeclaration))
	end 'bindsTheName'

	function declarationWasFound(declaration HoverDeclaration) returns bool
		return match declaration 'resolved'
			binding or
				parameter or
				routine or
				typeName gives true
			none gives false
		end 'resolved'
	end 'declarationWasFound'

	function memberDeclaredHere(owner ByteArray, member ByteArray) returns HoverDeclaration
		let blocks = lspDocumentBlocks(tokens)
		let declaring = lspBlocksDeclaring(blocks, typeName: String.from(owner))

		if declaring.isEmpty() 'noBodyOfThatName'
			return HoverDeclaration.none
		end 'noBodyOfThatName'

		let tokenLines = lspTokenLines(tokens)

		// A name can open more than one body — a `type` and an `extension` over it — so a body that does
		// not declare the member is stepped over rather than ending the walk.
		for block in declaring 'eachBody'
			let found = memberNamedIn(member, blocks: blocks, block: block, tokenLines: tokenLines)

			if declarationWasFound(found) 'thisBodyDeclaresIt'
				return found
			end 'thisBodyDeclaresIt'
		end 'eachBody'

		return HoverDeclaration.none
	end 'memberDeclaredHere'

	function memberNamedIn(member ByteArray, blocks LspDocumentBlockArray, block LspDocumentBlock, tokenLines LspTokenLineArray) returns HoverDeclaration
		for tokenLine in tokenLines 'eachLine'
			let line = lspLineOf(tokenLine.line)
			let found = memberDeclaredOnLine(member, tokenLine: tokenLine)

			if declarationWasFound(found) and lspBlockDirectlyHoldsLine(blocks, block: block, line: line) 'aMemberOfThisBody'
				return found
			end 'aMemberOfThisBody'
		end 'eachLine'

		return HoverDeclaration.none
	end 'memberNamedIn'

	function memberDeclaredOnLine(member ByteArray, tokenLine LspTokenLine) returns HoverDeclaration
		var index = tokenLine.firstIndex

		while index <= tokenLine.lastIndex 'eachToken'
			let kind = tokenAt(index).kind

			if kind == TokenKind.function and signatureDeclares(index, name: member) 'aDeclarationOfIt'
				return HoverDeclaration.routine(index)
			end 'aDeclarationOfIt'

			if (kind == TokenKind.let or kind == TokenKind.var) and namesFollowing(index, name: member) 'aField'
				return HoverDeclaration.binding(index)
			end 'aField'

			index = index + 1
		end 'eachToken'

		return HoverDeclaration.none
	end 'memberDeclaredOnLine'

	// The declared return type of `receiver`'s `method`, resolved through the same owner and the same
	// declaring document its rendering is. Splitting the two lookups gives an editor a signature from one
	// declaration and a type from another the day they disagree.
	function methodReturnType(receiver ByteArray, method ByteArray) returns HoverMemberType
		match lookupOwnerOf(receiver, member: method) 'declaringType'
			at(owner) then return declaredMemberReturnType(owner, method: method)
			none then return HoverMemberType.none
		end 'declaringType'
	end 'methodReturnType'

	function declaredMemberReturnType(owner ByteArray, method ByteArray) returns HoverMemberType
		if declarationWasFound(memberDeclaredHere(owner, member: method)) 'declaredInThisDocument'
			return declaredMethodReturnType(owner, method: method)
		end 'declaredInThisDocument'

		match memberDeclaringDocument(owner, member: method) 'elsewhere'
			at(declaring) then return declaring.declaredMethodReturnType(owner, method: method)
			none then return HoverMemberType.none
		end 'elsewhere'
	end 'declaredMemberReturnType'

	function declaredMethodReturnType(owner ByteArray, method ByteArray) returns HoverMemberType
		return memberTypeOrParameter(returnTypeOfDeclaration(memberDeclaredHere(owner, member: method)), owner: owner)
	end 'declaredMethodReturnType'

	function returnTypeOfDeclaration(declared HoverDeclaration) returns HoverType
		match declarationSite(declared, kind: HoverDeclarationKind.routine) 'aRoutine'
			at(head) then return returnTypeOf(head)
			none then return HoverType.unknown
		end 'aRoutine'
	end 'returnTypeOfDeclaration'

	function memberDeclaringDocument(owner ByteArray, member ByteArray) returns HoverDeclaringDocument
		match corpus 'held'
			loaded(_, signatures, readerPath) then return declaringDocumentOfAMember(signatures, owner: owner, member: member, readerPath: readerPath)
			unavailable then return HoverDeclaringDocument.none
		end 'held'
	end 'memberDeclaringDocument'

	// ⚠ The `stdlib/<Owner>.maxon` guess is the last arm and is reachable only from `nothingDeclaresIt`. A
	// member the corpus holds to be hidden from this file answers `none`, so that unfiltered road can
	// never render what the visibility filter refused. With no corpus attached this answers `none` too,
	// and the corpus pass asks again.
	function declaringDocumentOfAMember(signatures ProgramSignatures, owner ByteArray, member ByteArray, readerPath FilePath) returns HoverDeclaringDocument
		match lspMemberDeclarationOf(signatures, owner: owner, member: member, readerPath: readerPath) 'declared'
			declaredIn(path) then return documentOfCorpusFile(path)
			hiddenHere then return HoverDeclaringDocument.none
			nothingDeclaresIt then return stdlibDocumentFor(owner)
		end 'declared'
	end 'declaringDocumentOfAMember'

	function stdlibDocumentFor(owner ByteArray) returns HoverDeclaringDocument
		let directory = try locateStdlibDir() otherwise return HoverDeclaringDocument.none
		let path = directory.join("{String.from(owner)}{MaxonSourceExtension}")

		if not File.exists(path) 'notALibraryType'
			return HoverDeclaringDocument.none
		end 'notALibraryType'

		let source = try File.readText(path) otherwise return HoverDeclaringDocument.none
		let module = try Self.of(source, keywords: keywords, corpus: corpus) otherwise return HoverDeclaringDocument.none

		return HoverDeclaringDocument.at(module)
	end 'stdlibDocumentFor'

	// --- Source text --------------------------------------------------------------------------

	// A declaration's head begins at its first MODIFIER, not at its keyword: `public function push` and
	// `module function push` are what an editor should show. `module` is CONTEXTUAL — an identifier the
	// parser matches by its bytes — which is why the test takes a whole token and not a `TokenKind`.
	function declarationStart(keyword TokenIndex) returns TokenIndex
		var start = keyword

		while start > 0 and lspIsDeclarationModifier(tokenAt(start - 1)) 'walkBack'
			start = start - 1
		end 'walkBack'

		return start
	end 'declarationStart'

	function headText(start TokenIndex) returns String
		return sourceBetween(tokenAt(start).startByte, endByte: headEndByte(start))
	end 'headText'

	// Where a declaration's head stops: at the first line break that is not inside brackets, so a
	// signature broken across lines comes out whole.
	function headEndByte(start TokenIndex) returns ByteOffset
		let total = tokens.count()
		var depth = 0
		var index = start

		while index < total 'scan'
			let tok = tokenAt(index)

			if tok.kind == TokenKind.newline and depth == 0 'headEnds'
				return lineContentEnd(tok.line)
			end 'headEnds'

			if tokenKindOpensABracket(tok.kind) 'opens'
				depth = depth + 1
			end 'opens' else if tokenKindClosesABracket(tok.kind) and depth > 0 'closes'
				depth = depth - 1
			end 'closes'

			index = index + 1
		end 'scan'

		return text.byteLength()
	end 'headEndByte'

	// One parameter as the author wrote it — its name, its type, and any default — up to the comma or
	// the parenthesis that ends it.
	function parameterText(nameIndex TokenIndex) returns String
		let total = tokens.count()
		var depth = 0
		var last = tokenAt(nameIndex).endByte
		var index = nameIndex

		while index < total 'scan'
			let tok = tokenAt(index)

			if depth == 0 and (tok.kind == TokenKind.comma or tok.kind == TokenKind.rightParen or tok.kind == TokenKind.newline) 'parameterEnds'
				break
			end 'parameterEnds'

			if tokenKindOpensABracket(tok.kind) 'opens'
				depth = depth + 1
			end 'opens' else if tokenKindClosesABracket(tok.kind) and depth > 0 'closes'
				depth = depth - 1
			end 'closes'

			if tok.endByte > last 'spans'
				last = tok.endByte
			end 'spans'

			index = index + 1
		end 'scan'

		return sourceBetween(tokenAt(nameIndex).startByte, endByte: last)
	end 'parameterText'

	// Where a source line's text stops.
	//
	// ⭐ `LspLineIndex` clamps a `character` past the end of a line to exactly that point, and it is the
	// ONLY reader of it `Compiler/` has: `String.byteAt` is `module`-visible inside `stdlib/`, so
	// nothing here can walk a line's bytes itself. That clamp is therefore asked the question rather
	// than a second scan being written for it.
	function lineContentEnd(line LineNumber) returns ByteOffset
		let lspLine = 0 if line == 0 else line - 1
		return lines.offsetOf(text, position: LspPosition.create(lspLine as LspLineNumber, character: PastEveryLine))
	end 'lineContentEnd'

	function sourceBetween(startByte ByteOffset, endByte ByteOffset) returns String
		let piece = try bytes.slice(startByte as ElementIndex, endIndex: endByte as ElementIndex) otherwise panic("HoverDocument.sourceBetween: [{startByte}, {endByte}) is outside the {bytes.count()}-byte buffer the tokens were lexed from")
		return String.from(piece)
	end 'sourceBetween'

	// --- Prose --------------------------------------------------------------------------------

	// The `///` lines directly above a declaration, joined in source order, with their `/// ` prefix
	// already stripped — the lexer keeps a doc comment as a TOKEN carrying the prose, so this is a walk
	// over the stream and never a re-scan of the text.
	function appendDocComment(prose StringArray, above TokenIndex)
		var first = above

		while first > 0 and kindIsDocOrLayout(tokenAt(first - 1).kind) 'walkUp'
			first = first - 1
		end 'walkUp'

		var documentation = ""
		var separator = ""
		var index = first

		while index < above 'collect'
			let tok = tokenAt(index)

			if tok.kind == TokenKind.docComment 'docLine'
				documentation.append("{separator}{String.from(tok.value)}")
				separator = DocCommentLineBreak
			end 'docLine'

			index = index + 1
		end 'collect'

		if not documentation.isEmpty() 'documented'
			prose.push(documentation)
		end 'documented'
	end 'appendDocComment'

	function routineNamePhrase(functionIndex TokenIndex) returns String
		let nameIndex = try signatureNameIndex(functionIndex) otherwise return AnonymousFunctionPhrase

		return "`{String.from(tokenAt(nameIndex).value)}`"
	end 'routineNamePhrase'

	// The nearest-first candidate order `declarationOf` walks: `near`, `near - 1`, … 0, then `near + 1`
	// to the end. One counter rather than two loops, so "above first, then below" is written once.
	function candidateIndex(step TokenIndex, near TokenIndex) returns TokenIndex
		if step > near 'belowTheCursor'
			return step
		end 'belowTheCursor'

		return near - step
	end 'candidateIndex'
end 'HoverDocument'

extension Project
	module function hoverDocumentOf(path FilePath, reading KeywordTable, corpus LspCorpus) returns HoverDeclaringDocument
		let declTokens = try queryActiveTokens(self, path: path) otherwise return HoverDeclaringDocument.none
		let entry = try sourceEntryOf(self, path: path) otherwise return HoverDeclaringDocument.none

		return HoverDeclaringDocument.at(HoverDocument.ofTokens(entry.content, tokens: declTokens, keywords: reading, corpus: corpus))
	end 'hoverDocumentOf'
end 'Project'

function declarationSite(declaration HoverDeclaration, kind HoverDeclarationKind) returns HoverDeclarationSite
	match declaration 'resolved'
		binding(head) then return HoverDeclarationSite.at(head) if kind == HoverDeclarationKind.binding else HoverDeclarationSite.none
		routine(head) then return HoverDeclarationSite.at(head) if kind == HoverDeclarationKind.routine else HoverDeclarationSite.none
		parameter or
			typeName or
			none then return HoverDeclarationSite.none
	end 'resolved'
end 'declarationSite'

// --- Token classification ---------------------------------------------------------------------

// Whether a token is a word the LANGUAGE reserves rather than one the author chose.
//
// ⭐ It asks the lexer's own invariant instead of listing ninety keywords: a token whose kind implies
// its text — every punctuator, `newline`, EOF — carries `EmptySourceText`, while KEYWORDS are lexed as
// identifiers and reach the stream carrying their own bytes exactly like any other word. So a token with
// bytes that is not one of the kinds an AUTHOR names is, by construction, reserved.
function tokenIsAReservedWord(tok Token) returns bool
	if tok.value.count() == 0 'itsKindIsItsText'
		return false
	end 'itsKindIsItsText'

	return not kindCarriesAuthoredText(tok.kind)
end 'tokenIsAReservedWord'

function kindCarriesAuthoredText(kind TokenKind) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.charLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.stringFormatSpec or kind == TokenKind.docComment
end 'kindCarriesAuthoredText'

// Keywords that introduce a NAME for a type. `extension` is here because hovering the name in
// `extension Array where …` should reach that block, even though it declares nothing new.
function kindDeclaresATypeName(kind TokenKind) returns bool
	return kind == TokenKind.type or kind == TokenKind.enum or kind == TokenKind.union or kind == TokenKind.interface or kind == TokenKind.typealias or kind == TokenKind.extension
end 'kindDeclaresATypeName'

// Keywords that open a BODY holding members. `typealias` is absent for that reason: it names a type and
// holds nothing.
function kindDeclaresAContainer(kind TokenKind) returns bool
	return kind == TokenKind.type or kind == TokenKind.enum or kind == TokenKind.union or kind == TokenKind.interface or kind == TokenKind.extension
end 'kindDeclaresAContainer'

// Where an expression STOPS — the property `inferredTypeAt` tests before it believes a literal.
//
// ⛔ **IT NAMES THE ENDINGS, NOT THE CONTINUATIONS, SO IT FAILS CLOSED.** The ways to apply something to
// a value — a `.`, a `(`, a `[`, an operator, an `as` — are open-ended and grow with the language, and an
// enumeration of THOSE would admit every one it had not been taught yet. Enumerating what ends an
// expression instead leaves every unfamiliar token meaning `unknown`.
function kindEndsAnExpression(kind TokenKind) returns bool
	return kind == TokenKind.newline or kind == TokenKind.comma or kind == TokenKind.eof or kind == TokenKind.otherwise or tokenKindClosesABracket(kind)
end 'kindEndsAnExpression'

// What may sit between a declaration and the `///` lines written for it: blank lines, and the doc lines
// themselves.
function kindIsDocOrLayout(kind TokenKind) returns bool
	return kind == TokenKind.newline or kind == TokenKind.docComment
end 'kindIsDocOrLayout'

// --- Rendering ----------------------------------------------------------------------------------

// The markdown an editor renders: the declaration as source, then any prose that belongs under it.
function hoverMarkdown(code String, prose StringArray) returns String
	var rendered = "{MaxonFenceOpen}{code}{MaxonFenceClose}"

	for paragraph in prose 'eachParagraph'
		rendered.append("{ParagraphBreak}{paragraph}")
	end 'eachParagraph'

	return rendered
end 'hoverMarkdown'

// A compiler builtin's hover: the signature a reader would need to call it, and the one line saying what
// it does. Both come from `Parser`'s roster — the same enum the emit dispatches on — so an intrinsic
// cannot be described here as something other than what it compiles to.
//
// ⚠ **THE HELP LINE IS THE HALF THAT MAKES HOVERING ONE WORTH DOING.** A signature alone tells an editor
// user what they can already see from the call they are looking at; `Truncates \`value\` toward zero` is
// the part they came for. `tests/lsp/hover-values.test.maxon` pins both halves for `sqrt` and `trunc`.
function mathBuiltinMarkdown(builtin MathBuiltin) returns String
	var prose = StringArray.create()
	prose.push(mathBuiltinHelp(builtin))
	return hoverMarkdown(mathBuiltinSignature(builtin), prose: prose)
end 'mathBuiltinMarkdown'

function nominalType(name ByteArray) returns HoverType
	return HoverType.named(name, rendered: String.from(name), written: name)
end 'nominalType'

let FirstToken = 0

let TokensInABindingHead = 2 as TokenIndex

let TokensInADeclarationHead = 2 as TokenIndex

let TokensPerListedName = 2 as TokenIndex

let TokensPerDottedSegment = 2 as TokenIndex

let UninferredTypePhrase = ", of a type this hover could not infer"
let SentenceEnd = "."
let AnonymousFunctionPhrase = "an anonymous function"
let LoopVariableSubject = "Loop variable"

// `LspLineIndex.offsetOf` clamps a character past a line's content to exactly where that content stops,
// which is how the end of a line is asked for without walking its bytes.
let PastEveryLine = i64.max as LspCharacter

// The primitive and container names a hover infers from a literal. Byte slices because that is what a
// token's text is, and what a method lookup compares against.
let IntTypeName = b"int"
let FloatTypeName = b"float"
let StringTypeName = b"String"
let BoolTypeName = b"bool"
let ArrayTypeName = b"Array"
let ArrayTypeSpelling = "Array with "
