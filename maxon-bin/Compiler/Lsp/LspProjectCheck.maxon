// Longer than the gap between keystrokes in a burst, so a burst is checked once, at its last version.
let LspProjectCheckSettleMs = 300

module type LspEditorFacts
	module let version as LspDocumentVersion
	module let facts as EditorFacts

	module static function checked(version LspDocumentVersion, facts EditorFacts) returns LspEditorFacts
		return Self{version: version, facts: facts}
	end 'checked'

	module static function unchecked() returns LspEditorFacts
		return Self{version: LspNoDocumentVersion, facts: EditorFacts.empty()}
	end 'unchecked'
end 'LspEditorFacts'

module typealias LspEditorFactsCell = SharedValue with LspEditorFacts

module union LspEditorFactsAnswer
	fresh(held immutable LspEditorFacts)
	stale
end 'LspEditorFactsAnswer'

module type LspProjectCheckRequest
	export let uri as String
	export let path as FilePath
	export let text as String
	export let version as LspDocumentVersion
	export let clientVersion as ClientDocumentVersion
	export let alone as DiagnosticArray
	module let inputs as ProjectInputsAnswer
	module let root as FilePath
	module let stdlibDir as FilePath
	module let runtimeDir as FilePath

	module static function create(uri String, path FilePath, text String, version LspDocumentVersion, clientVersion ClientDocumentVersion, alone DiagnosticArray, inputs ProjectInputsAnswer, root FilePath, stdlibDir FilePath, runtimeDir FilePath) returns LspProjectCheckRequest
		return Self{uri: uri, path: path, text: text, version: version, clientVersion: clientVersion, alone: alone, inputs: inputs, root: root, stdlibDir: stdlibDir, runtimeDir: runtimeDir}
	end 'create'
end 'LspProjectCheckRequest'

module type LspQueuedCheck
	module let request as immutable LspProjectCheckRequest
	module let interest as CompileInterest
	module let facts as LspEditorFactsCell

	module static function create(request immutable LspProjectCheckRequest, interest CompileInterest, facts LspEditorFactsCell) returns LspQueuedCheck
		return Self{request: request, interest: interest, facts: facts}
	end 'create'
end 'LspQueuedCheck'

typealias LspQueuedCheckArray = Array with immutable LspQueuedCheck

union WarmProject
	notBuilt
	held(project Project)
end 'WarmProject'

typealias LspCheckerMap = Map with (String, LspProjectChecker.handle)

union CheckPreparation
	answered(check ProjectCheck)
	ready(project Project)
end 'CheckPreparation'

type LspProjectChecker implements CompileReceiver
	var warm as WarmProject
	let current as RunningCheckSlot
	var pending as LspQueuedCheckArray
	let bases as GenerationBases
	let memos as SharedFileMemoMap
	let writer as LspStdoutWriter.handle

	static function create(writer LspStdoutWriter.handle) returns LspProjectChecker
		return Self{warm: WarmProject.notBuilt, current: RunningCheckSlot.create("LspProjectChecker.current"), pending: LspQueuedCheckArray.create(0), bases: GenerationBases.create(), memos: SharedFileMemoMap.create(), writer: writer}
	end 'create'

	export function forget()
		self.warm = WarmProject.notBuilt

		for waiting in self.pending 'eachWaiting'
			reportProjectCheck(self.writer, request: waiting.request, outcome: ProjectCheckOutcome.superseded)
		end 'eachWaiting'

		self.pending = LspQueuedCheckArray.create(0)
	end 'forget'

	export function check(work immutable LspQueuedCheck, receiver CompileReceiver.handle)
		if self.current.isFull() 'busy'
			self.queue(work)
			return
		end 'busy'

		self.begin(work, receiver: receiver)
	end 'check'

	export function frontEndAnswered(generation DrainGeneration, job ElementIndex, answered isolated FrontEndJob, receiver CompileReceiver.handle)
		if self.current.isEmpty() 'nothingRunning'
			return
		end 'nothingRunning'

		let running = self.current.held()

		let step = try running.run.frontEndAnswered(generation, job: job, answered: answered, receiver: receiver.clone()) otherwise (failure) 'refused'
			self.finish(running.work, check: projectCheckFailedWith(failure), receiver: receiver)
			return
		end 'refused'

		self.settle(running, step: step, receiver: receiver)
	end 'frontEndAnswered'

	export function stdPassAnswered(job ElementIndex, answered isolated StdUnit, receiver CompileReceiver.handle)
		panic("LspProjectChecker.stdPassAnswered: a check stops after the front end and the lowering to Std, so it starts no Std fan-out")
	end 'stdPassAnswered'

	export function backendAnswered(job ElementIndex, answered isolated BackendUnit, refused bool, receiver CompileReceiver.handle)
		panic("LspProjectChecker.backendAnswered: a check stops after the front end and the lowering to Std, so it starts no backend pool")
	end 'backendAnswered'

	export function logFlushed(receiver CompileReceiver.handle)
		panic("LspProjectChecker.logFlushed: a check asks the log for no flush")
	end 'logFlushed'

	function queue(work immutable LspQueuedCheck)
		let kept = LspQueuedCheckArray.create(0)

		for waiting in self.pending 'eachWaiting'
			if waiting.request.uri == work.request.uri 'sameDocument'
				reportProjectCheck(self.writer, request: waiting.request, outcome: ProjectCheckOutcome.superseded)
				continue
			end 'sameDocument'

			kept.push(waiting)
		end 'eachWaiting'

		kept.push(work)
		self.pending = kept
	end 'queue'

	function begin(work immutable LspQueuedCheck, receiver CompileReceiver.handle)
		if not work.interest.stillWanted() 'superseded'
			self.finish(work, check: ProjectCheck.superseded, receiver: receiver)
			return
		end 'superseded'

		match self.prepared(work) 'prepared'
			answered(check) then self.finish(work, check: check, receiver: receiver)
			ready(project) then self.startFrontEnd(work, project: project, receiver: receiver)
		end 'prepared'
	end 'begin'

	function startFrontEnd(work immutable LspQueuedCheck, project Project, receiver CompileReceiver.handle)
		let check = CompileRun.create(project, goal: CompileGoal.checked, generationBase: self.bases.take())
		let running = RunningCheck.create(work, project: project, run: check)
		self.current.fill(running)

		let step = try check.begin(receiver.clone()) otherwise (failure) 'refused'
			self.finish(work, check: projectCheckFailedWith(failure), receiver: receiver)
			return
		end 'refused'

		self.settle(running, step: step, receiver: receiver)
	end 'startFrontEnd'

	function settle(running RunningCheck, step CompileStep, receiver CompileReceiver.handle)
		match step 'step'
			awaiting then return
			finished then self.finish(running.work, check: running.project.checkedAfterFrontEnd(running.work.request, facts: running.work.facts), receiver: receiver)
		end 'step'
	end 'settle'

	function finish(work immutable LspQueuedCheck, check ProjectCheck, receiver CompileReceiver.handle)
		self.current.clear()
		publishProjectCheck(self.writer, request: work.request, check: check)

		if self.pending.count() > 0 'aCheckIsWaiting'
			self.begin(try self.pending.remove(0) otherwise panic("LspProjectChecker.finish: a check is taken only while one waits"), receiver: receiver)
		end 'aCheckIsWaiting'
	end 'finish'

	function prepared(work immutable LspQueuedCheck) returns CheckPreparation
		match self.warm 'warm'
			notBuilt then return self.preparedCold(work)
			held(project) then return self.preparedWarm(work, project: project)
		end 'warm'
	end 'prepared'

	function preparedWarm(work immutable LspQueuedCheck, project Project) returns CheckPreparation
		let preparation = project.preparedAgainst(work.request, interest: work.interest, sources: self.sourcesFor(work.request))

		match preparation 'preparation'
			answered(check) then return self.afterAnswer(work, check: check)
			ready then return preparation
		end 'preparation'
	end 'preparedWarm'

	function afterAnswer(work immutable LspQueuedCheck, check ProjectCheck) returns CheckPreparation
		if check.movedTheRoot() 'rerooted'
			return self.preparedCold(work)
		end 'rerooted'

		return CheckPreparation.answered(check)
	end 'afterAnswer'

	function sourcesFor(request LspProjectCheckRequest) returns EditorSources
		return projectSourcesIn(request.root, selection: SourceSelection.productionOnly, answer: request.inputs)
	end 'sourcesFor'

	function preparedCold(work immutable LspQueuedCheck) returns CheckPreparation
		let request = work.request
		let sources = self.sourcesFor(request)
		let project = try createProject(sources.root, target: detectHostTarget(), stdlibDir: request.stdlibDir, runtimeDir: request.runtimeDir, scriptlib: ScriptlibTier.absent, debugStream: false, session: CompileSession.over(DriverSession.discarding(), fileMemos: self.memos)) otherwise (e) 'noProject'
			return CheckPreparation.answered(projectCheckFailedWith(e))
		end 'noProject'

		project.session.wantedBy(work.interest)

		try loadLibrarySources(project) otherwise (e) 'noLibrary'
			return CheckPreparation.answered(projectCheckFailedWith(e))
		end 'noLibrary'

		let preparation = project.preparedAgainst(request, interest: work.interest, sources: sources)
		self.warm = WarmProject.held(project)

		return preparation
	end 'preparedCold'
end 'LspProjectChecker'

module type LspCheckerPool
	let writer as LspStdoutWriter.handle
	var checkers as LspCheckerMap

	module static function create(writer LspStdoutWriter.handle) returns LspCheckerPool
		return Self{writer: writer, checkers: LspCheckerMap.create()}
	end 'create'

	module function submit(work immutable LspQueuedCheck)
		let checker = self.checkerFor(work.request.root.path)

		try checker.check(work, receiver: checker.clone() as CompileReceiver.handle, sendTimeout: ForeverMs) otherwise (e) 'refused'
			match e 'why'
				mailboxFull then return
				serviceStopped then panic("LspCheckerPool.submit: the project checker stopped while the session still held its handle")
			end 'why'
		end 'refused'
	end 'submit'

	module function forget(root String)
		let checker = try self.checkers.get(root) otherwise return

		try checker.forget(sendTimeout: ForeverMs) otherwise (e) 'refused'
			match e 'why'
				mailboxFull then return
				serviceStopped then panic("LspCheckerPool.forget: the project checker stopped while the session still held its handle")
			end 'why'
		end 'refused'
	end 'forget'

	module function shutdown()
		for (_, checker) in self.checkers 'eachChecker'
			checker.shutdown()
		end 'eachChecker'

		self.checkers = LspCheckerMap.create()
	end 'shutdown'

	function checkerFor(root String) returns LspProjectChecker.handle
		if let held = try self.checkers.get(root) 'known'
			return held.clone()
		end 'known'

		let spawned = spawn(capacity: AnswerMailboxCapacity) LspProjectChecker.create(self.writer.clone())
		self.checkers.upsert(root.clone(), value: spawned.clone())

		return spawned
	end 'checkerFor'
end 'LspCheckerPool'

module function settledProjectCheck(request immutable LspProjectCheckRequest, interest CompileInterest) returns LspArrival
	if interest.stillWanted() 'worthSettling'
		sleep(LspProjectCheckSettleMs)
	end 'worthSettling'

	return LspArrival.projectCheckSettled(request, interest: interest)
end 'settledProjectCheck'

function publishProjectCheck(writer LspStdoutWriter.handle, request LspProjectCheckRequest, check ProjectCheck)
	match check 'check'
		checked(diagnostics) then publishProjectDiagnostics(writer, request: request, diagnostics: diagnostics, unbuilt: StringArray.create(0), outcome: ProjectCheckOutcome.published)
		unbuilt(failures) then publishProjectDiagnostics(writer, request: request, diagnostics: request.alone, unbuilt: failures, outcome: ProjectCheckOutcome.unloadable)
		unlisted then publishProjectDiagnostics(writer, request: request, diagnostics: request.alone, unbuilt: StringArray.create(0), outcome: ProjectCheckOutcome.unlisted)
		abandoned then reportProjectCheck(writer, request: request, outcome: ProjectCheckOutcome.abandoned)
		superseded then reportProjectCheck(writer, request: request, outcome: ProjectCheckOutcome.superseded)
		rerooted then panic("publishProjectCheck: a cold build roots its project at the sources it checks against, and a warm check that moved the root rebuilds cold before it answers")
	end 'check'
end 'publishProjectCheck'

function publishProjectDiagnostics(writer LspStdoutWriter.handle, request LspProjectCheckRequest, diagnostics DiagnosticArray, unbuilt StringArray, outcome ProjectCheckOutcome)
	let tokens = lspDocumentTokens(request.text, keywords: KeywordTable.create())
	let body = documentDiagnosticsText(request.uri, text: request.text, tokens: tokens, diagnostics: diagnostics, path: request.path, unbuilt: unbuilt, notices: StringArray.create(0))

	postToLspWriter(writer, command: LspWriterCommand.publishIfCurrent(request.uri.clone(), version: request.version, clientVersion: request.clientVersion.clone(), outcome: outcome, body: body))
end 'publishProjectDiagnostics'

module function reportProjectCheck(writer LspStdoutWriter.handle, request LspProjectCheckRequest, outcome ProjectCheckOutcome)
	postToLspWriter(writer, command: LspWriterCommand.report(request.uri.clone(), clientVersion: request.clientVersion.clone(), outcome: outcome))
end 'reportProjectCheck'

union ProjectCheck
	checked(diagnostics DiagnosticArray)
	unbuilt(failures StringArray)
	unlisted
	abandoned
	superseded
	rerooted

	function movedTheRoot() returns bool
		return match self 'check'
			rerooted gives true
			checked or
			unbuilt or
			unlisted or
			abandoned or
			superseded gives false
		end 'check'
	end 'movedTheRoot'
end 'ProjectCheck'

extension Project
	function preparedAgainst(request LspProjectCheckRequest, interest CompileInterest, sources EditorSources) returns CheckPreparation
		self.session.wantedBy(interest)

		let refresh = try self.refreshFromDisk(sources, readerPath: request.path) otherwise (e) 'unreadable'
			return CheckPreparation.answered(projectCheckFailedWith(e))
		end 'unreadable'

		match refresh 'refresh'
			listed(reader) then return self.preparedWithTheBuffer(request, reader: reader)
			unlisted then return CheckPreparation.answered(ProjectCheck.unlisted)
			unresolved(lines) then return CheckPreparation.answered(ProjectCheck.unbuilt(lines.clone()))
			rerooted then return CheckPreparation.answered(ProjectCheck.rerooted)
		end 'refresh'
	end 'preparedAgainst'

	function preparedWithTheBuffer(request LspProjectCheckRequest, reader FilePath) returns CheckPreparation
		self.editorFacts = EditorFactsSubject.document(reader.clone())
		overlayUnsavedText(self, path: reader, content: request.text)

		return CheckPreparation.ready(self)
	end 'preparedWithTheBuffer'

	function checkedAfterFrontEnd(request LspProjectCheckRequest, facts LspEditorFactsCell) returns ProjectCheck
		self.reportSecondaryFindingsBesideClaims()

		// Published before the check's diagnostics, so a hover that follows them finds these facts.
		facts.publish(LspEditorFacts.checked(request.version, facts: editorFactsOfTheCheck(self)))

		let attributed = attributedTo(diagnosticsInSourceOrder(self), path: request.path, alone: request.alone)

		return ProjectCheck.checked(attributed.clone())
	end 'checkedAfterFrontEnd'
end 'Project'

function editorFactsOfTheCheck(project Project) returns EditorFacts
	return EditorFacts.create(editorReadsOf(project), functions: project.editorFunctions.clone(), finalizers: project.editorFinalizers.clone())
end 'editorFactsOfTheCheck'

function editorReadsOf(project Project) returns EditorReadMap
	match project.editorReads 'reads'
		unwritten then return EditorReadMap.create()
		entries(held) then return held.clone()
	end 'reads'
end 'editorReadsOf'

function projectCheckFailedWith(failure CompileError) returns ProjectCheck
	match failure.failure() 'failure'
		abandoned then return ProjectCheck.abandoned
		driverFailed then return ProjectCheck.unbuilt(projectFailureLines(failure))
		reportedDiagnostics then panic("projectCheckFailedWith: a refused check is an answer the front-end check returns, and neither a library load nor a disk refresh reports a diagnostic")
	end 'failure'
end 'projectCheckFailedWith'

module function projectFailureLines(failure CompileError) returns StringArray
	let sink = DiagnosticSink.capturing()
	reportCompileError(failure, sink: sink)

	return sink.emitted()
end 'projectFailureLines'
