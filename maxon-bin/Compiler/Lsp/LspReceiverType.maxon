// What a `<receiver>.<member>` access names, and which lines of a document declare a type's members —
// the two questions `textDocument/completion` and `textDocument/definition` share, plus the block model
// both answers rest on.
//
// The receiver rule itself lives in `HoverDocument.receiverSubject`, which owns it; these are the doors
// into it, and hover reaches the same walk from its own side. Two doors because the two features hold
// different things when they ask: completion has a cursor sitting AFTER the `.` and must find the
// receiver from it (`lspSubjectAt`), while definition already has the member token and steps back two
// (`lspSubjectOfReceiver`). A second walk would be free to answer them differently about one line.
//
// ⚠ It is LEXICAL, like everything else the LSP reads from a buffer: a document being edited is
// mid-edit and in general does not compile, so a receiver whose type only `resolveTypes` could supply is
// a receiver nothing here answers for. `LspCompletion`'s header argues that split in full.

// `Color.` names a TYPE, so its STATIC surface is what may be written next; `arr.` names a VALUE, so its
// INSTANCE surface is. Swapping the two offers a list of the wrong half with nothing reporting it.
module union LspSubject
	staticSurfaceOf(typeName String)
	instanceSurfaceOf(typeName String)
	nothingNamed
end 'LspSubject'

module function lspCursorFollowsAMemberAccess(tokens TokenArray, offset ByteOffset) returns bool
	try receiverIndexBefore(tokens, offset: offset) otherwise return false

	return true
end 'lspCursorFollowsAMemberAccess'

module function lspSubjectAt(text String, tokens TokenArray, keywords KeywordTable, offset ByteOffset, corpus LspCorpus) returns LspSubject
	let receiver = try receiverIndexBefore(tokens, offset: offset) otherwise return LspSubject.nothingNamed

	return lspSubjectOfReceiver(text, tokens: tokens, keywords: keywords, receiver: receiver, corpus: corpus)
end 'lspSubjectAt'

module function lspSubjectOfReceiver(text String, tokens TokenArray, keywords KeywordTable, receiver ElementIndex, corpus LspCorpus) returns LspSubject
	if receiver >= tokens.count() 'noSuchToken'
		return LspSubject.nothingNamed
	end 'noSuchToken'

	return HoverDocument.ofTokens(text, tokens: tokens, keywords: keywords, corpus: corpus).receiverSubject(receiver)
end 'lspSubjectOfReceiver'

module function lspSubjectTypeName(subject LspSubject) returns String throws AbsentError
	match subject 'subject'
		staticSurfaceOf(typeName) then return typeName
		instanceSurfaceOf(typeName) then return typeName
		nothingNamed then throw AbsentError.absent
	end 'subject'
end 'lspSubjectTypeName'

module function lspSubjectIsStatic(subject LspSubject) returns bool
	return match subject 'subject'
		staticSurfaceOf gives true
		instanceSurfaceOf gives false
		nothingNamed gives false
	end 'subject'
end 'lspSubjectIsStatic'

module union LspEnclosingType
	inside(typeName immutable ByteArray)
	atFileScope
end 'LspEnclosingType'

module function lspEnclosingTypeAtToken(tokens TokenArray, index ElementIndex) returns LspEnclosingType
	return LspLineScopes.of(lspDocumentBlocks(tokens)).enclosingTypeAt(lspLineOf(lspTokenAt(tokens, index: index).line))
end 'lspEnclosingTypeAtToken'

module function lspEnclosingTypeAtCursor(tokens TokenArray, scopes LspLineScopes, offset ByteOffset) returns LspEnclosingType
	let receiver = try receiverIndexBefore(tokens, offset: offset) otherwise return LspEnclosingType.atFileScope

	return scopes.enclosingTypeAt(lspLineOf(lspTokenAt(tokens, index: receiver).line))
end 'lspEnclosingTypeAtCursor'

module function lspBlockDeclaresMembers(kind LspBlockKind) returns bool
	return kind == LspBlockKind.structBody or kind == LspBlockKind.enumBody or kind == LspBlockKind.unionBody or kind == LspBlockKind.interfaceBody or kind == LspBlockKind.extensionBody
end 'lspBlockDeclaresMembers'

module function lspBlocksDeclaring(blocks LspDocumentBlockArray, typeName String) returns LspDocumentBlockArray
	var declaring = LspDocumentBlockArray.create(0)

	for block in blocks 'eachBlock'
		if not lspBlockDeclaresMembers(block.kind) 'declaresNoType'
			continue
		end 'declaresNoType'

		if String.from(block.name) != typeName 'anotherType'
			continue
		end 'anotherType'

		declaring.push(block)
	end 'eachBlock'

	return declaring
end 'lspBlocksDeclaring'

function lspExtensionBlocks(blocks LspDocumentBlockArray) returns LspDocumentBlockArray
	var extensions = LspDocumentBlockArray.create(0)

	for block in blocks 'eachBlock'
		if block.kind == LspBlockKind.extensionBody 'anExtension'
			extensions.push(block)
		end 'anExtension'
	end 'eachBlock'

	return extensions
end 'lspExtensionBlocks'

// An `extension` body adds members to a type declared elsewhere, so a buffer holding only extensions of
// a type does not hold the type's own members.
module function lspBlocksDeclareTheType(declaring LspDocumentBlockArray) returns bool
	for block in declaring 'eachBody'
		if block.kind != LspBlockKind.extensionBody 'theDeclaration'
			return true
		end 'theDeclaration'
	end 'eachBody'

	return false
end 'lspBlocksDeclareTheType'

module enum LspMemberForm
	method
	field
	enumCase
end 'LspMemberForm'

// A member declaration line of a body: a field (`var`/`let`) or a method (`function`), each possibly
// behind a tier keyword, or a case name in an `enum` or `union` body.
module type LspMember
	module let form as LspMemberForm
	module let keywordIndex as ElementIndex
	module let nameIndex as ElementIndex
	module let isStatic as bool
	module let tier as Visibility
	module let bodyName as immutable ByteArray

	module static function create(form LspMemberForm, keywordIndex ElementIndex, nameIndex ElementIndex, isStatic bool, tier Visibility, bodyName ByteArray) returns LspMember
		return Self{form: form, keywordIndex: keywordIndex, nameIndex: nameIndex, isStatic: isStatic, tier: tier, bodyName: bodyName}
	end 'create'
end 'LspMember'

module typealias LspMemberArray = Array with LspMember

module function lspBodyMembers(tokens TokenArray, scopes LspLineScopes, body LspDocumentBlock, tokenLines LspTokenLineArray) returns LspMemberArray
	var members = LspMemberArray.create(0)

	for tokenLine in tokenLines 'eachLine'
		let member = try lspMemberOnLine(tokens, tokenLine: tokenLine, body: body) otherwise continue

		if scopes.directlyHolds(body, line: lspLineOf(tokenLine.line)) 'itsOwnMemberLine'
			members.push(member)
		end 'itsOwnMemberLine'
	end 'eachLine'

	return members
end 'lspBodyMembers'

module function lspMemberDeclaredBy(tokens TokenArray, scopes LspLineScopes, owner String, member ByteArray) returns LspMember throws AbsentError
	return try lspMemberNamedIn(tokens, scopes: scopes, bodies: lspBlocksDeclaring(scopes.blocks, typeName: owner), member: member)
end 'lspMemberDeclaredBy'

// An `extension` over an interface publishes its methods onto each conformer, so the index files such a
// member under the conformer while the declaring body is named for the interface.
module function lspMemberDeclaredOrPublished(tokens TokenArray, scopes LspLineScopes, owner String, member ByteArray) returns LspMember throws AbsentError
	return try lspMemberDeclaredBy(tokens, scopes: scopes, owner: owner, member: member) otherwise try lspMemberNamedIn(tokens, scopes: scopes, bodies: lspExtensionBlocks(scopes.blocks), member: member)
end 'lspMemberDeclaredOrPublished'

function lspMemberNamedIn(tokens TokenArray, scopes LspLineScopes, bodies LspDocumentBlockArray, member ByteArray) returns LspMember throws AbsentError
	let tokenLines = lspTokenLines(tokens)

	for body in bodies 'eachBody'
		for found in lspBodyMembers(tokens, scopes: scopes, body: body, tokenLines: tokenLines) 'eachMember'
			if lspTokenAt(tokens, index: found.nameIndex).value.equals(member) 'thisMember'
				return found
			end 'thisMember'
		end 'eachMember'
	end 'eachBody'

	throw AbsentError.absent
end 'lspMemberNamedIn'

function lspMemberOnLine(tokens TokenArray, tokenLine LspTokenLine, body LspDocumentBlock) returns LspMember throws AbsentError
	return try lspDeclaredMemberOnLine(tokens, tokenLine: tokenLine, body: body) otherwise try lspCaseOnLine(tokens, tokenLine: tokenLine, body: body)
end 'lspMemberOnLine'

function lspCaseOnLine(tokens TokenArray, tokenLine LspTokenLine, body LspDocumentBlock) returns LspMember throws AbsentError
	if body.kind != LspBlockKind.enumBody and body.kind != LspBlockKind.unionBody 'notACaseList'
		throw AbsentError.absent
	end 'notACaseList'

	if not tokenCanBeAName(lspTokenAt(tokens, index: tokenLine.firstIndex)) 'notACaseName'
		throw AbsentError.absent
	end 'notACaseName'

	return LspMember.create(LspMemberForm.enumCase, keywordIndex: tokenLine.firstIndex, nameIndex: tokenLine.firstIndex, isStatic: true, tier: Visibility.public, bodyName: body.name)
end 'lspCaseOnLine'

function lspDeclaredMemberOnLine(tokens TokenArray, tokenLine LspTokenLine, body LspDocumentBlock) returns LspMember throws AbsentError
	var index = tokenLine.firstIndex
	var isStatic = false
	var tier = Visibility.file

	while index <= tokenLine.lastIndex 'skipModifiers'
		let token = lspTokenAt(tokens, index: index)

		if token.kind == TokenKind.static 'staticMember'
			isStatic = true
		end 'staticMember'

		tier = lspTierSpelledBy(token, current: tier)

		if not lspIsDeclarationModifier(token) 'theDeclarationKeyword'
			break
		end 'theDeclarationKeyword'

		index = index + 1
	end 'skipModifiers'

	if index >= tokenLine.lastIndex 'nothingNamed'
		throw AbsentError.absent
	end 'nothingNamed'

	let keyword = lspTokenAt(tokens, index: index)

	if keyword.kind != TokenKind.function and keyword.kind != TokenKind.var and keyword.kind != TokenKind.let 'notAMember'
		throw AbsentError.absent
	end 'notAMember'

	var nameIndex = index + 1

	if keyword.kind == TokenKind.function 'aMethod'
		nameIndex = try lspFunctionNameIndex(tokens, at: index)
	end 'aMethod'

	if nameIndex > tokenLine.lastIndex or not tokenCanBeAName(lspTokenAt(tokens, index: nameIndex)) 'unnamed'
		throw AbsentError.absent
	end 'unnamed'

	let form = LspMemberForm.method if keyword.kind == TokenKind.function else LspMemberForm.field

	return LspMember.create(form, keywordIndex: index, nameIndex: nameIndex, isStatic: isStatic, tier: tier, bodyName: body.name)
end 'lspDeclaredMemberOnLine'

// `function Printable.print()` declares `print`; the name before the dot is the interface's, and it is
// declared where the interface is.
module function lspFunctionNameIndex(tokens TokenArray, at ElementIndex) returns ElementIndex throws AbsentError
	let afterTheFirstName = try tokens.get(at + 2) otherwise throw AbsentError.absent
	return at + 3 if afterTheFirstName.kind == TokenKind.dot else at + 1
end 'lspFunctionNameIndex'

function lspTierSpelledBy(token Token, current Visibility) returns Visibility
	if token.kind == TokenKind.export 'exported'
		return Visibility.global
	end 'exported'

	if token.kind == TokenKind.public 'published'
		return Visibility.public
	end 'published'

	if spellsModuleModifier(token.kind, value: token.value) 'moduleScoped'
		return Visibility.module
	end 'moduleScoped'

	return current
end 'lspTierSpelledBy'

// Every body asked about here is in the open buffer, so the reader shares the declaring file: a method
// is always reachable, and `moduleTierVisible` is true for a field.
module function lspMemberReachable(member LspMember, site MemberReaderSite) returns bool
	if member.form != LspMemberForm.field 'neverTiered'
		return true
	end 'neverTiered'

	return memberTierReachable(member.tier, site: site, moduleTierVisible: true)
end 'lspMemberReachable'

// The receiver of the member access the cursor sits in, found by TOKEN ORDER rather than by byte range:
// a punctuator and a newline carry no bytes — a `Token` of either kind has `startByte` and `endByte` 0 —
// so a `.` cannot be located by offset at all. What can be is the last token carrying source bytes that
// ends at or before the cursor, and the two branches read that token differently. A byte-less run after
// it holding a `.` means the access was just opened, and the receiver is the token before that `.`,
// which for `p.toString().` is the `)` rather than a name. Otherwise the cursor must sit at the END of
// that name, the partial member of `arr.pu`; a cursor anywhere else has left the name behind, and
// answering there offers a member list on a blank line or at an argument position.
function receiverIndexBefore(tokens TokenArray, offset ByteOffset) returns ElementIndex throws AbsentError
	var candidate = 0 as ElementIndex
	var anyTokenBefore = false

	for (position, token) in tokens.withIterator() 'eachToken'
		if token.endByte <= token.startByte or token.endByte > offset 'notBeforeTheCursor'
			continue
		end 'notBeforeTheCursor'

		candidate = position.index()
		anyTokenBefore = true
	end 'eachToken'

	if not anyTokenBefore 'nothingBefore'
		throw AbsentError.absent
	end 'nothingBefore'

	if let opened = try openingDotAfter(tokens, candidate: candidate) 'aMemberAccessJustOpened'
		return opened - 1
	end 'aMemberAccessJustOpened'

	if candidate < TokensBetweenAReceiverAndItsMember 'noReceiverCouldPrecedeIt'
		throw AbsentError.absent
	end 'noReceiverCouldPrecedeIt'

	let partial = lspTokenAt(tokens, index: candidate)

	if partial.endByte != offset 'theCursorLeftThatNameBehind'
		throw AbsentError.absent
	end 'theCursorLeftThatNameBehind'

	if not tokenCanBeAName(partial) 'notAPartialMemberName'
		throw AbsentError.absent
	end 'notAPartialMemberName'

	if lspTokenAt(tokens, index: candidate - 1).kind != TokenKind.dot 'notAMemberAccess'
		throw AbsentError.absent
	end 'notAMemberAccess'

	return candidate - TokensBetweenAReceiverAndItsMember
end 'receiverIndexBefore'

function openingDotAfter(tokens TokenArray, candidate ElementIndex) returns ElementIndex throws AbsentError
	let total = tokens.count()
	var found = 0 as ElementIndex
	var dotSeen = false
	var index = candidate + 1

	while index < total 'eachToken'
		let token = lspTokenAt(tokens, index: index)

		if token.endByte > token.startByte or token.kind == TokenKind.newline 'theRunEnds'
			break
		end 'theRunEnds'

		if token.kind == TokenKind.dot 'aMemberAccess'
			found = index
			dotSeen = true
		end 'aMemberAccess'

		index = index + 1
	end 'eachToken'

	if not dotSeen 'noDot'
		throw AbsentError.absent
	end 'noDot'

	return found
end 'openingDotAfter'
