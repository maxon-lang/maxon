// What a `<receiver>.<member>` access names, and which lines of a document declare a type's members —
// the two questions `textDocument/completion` and `textDocument/definition` share, plus the block model
// both answers rest on.
//
// The receiver rule itself lives in `HoverDocument.receiverSubject`, which owns it; these are the doors
// into it, and hover reaches the same walk from its own side. Two doors because the two features hold
// different things when they ask: completion has a cursor sitting AFTER the `.` and must find the
// receiver from it (`lspSubjectAt`), while definition already has the member token and steps back two
// (`lspSubjectOfReceiver`). A second walk would be free to answer them differently about one line.
//
// ⚠ It is LEXICAL, like everything else the LSP reads from a buffer: a document being edited is
// mid-edit and in general does not compile, so a receiver whose type only `resolveTypes` could supply is
// a receiver nothing here answers for. `LspCompletion`'s header argues that split in full.

// `Color.` names a TYPE, so its STATIC surface is what may be written next; `arr.` names a VALUE, so its
// INSTANCE surface is. Swapping the two offers a list of the wrong half with nothing reporting it.
module union LspSubject
	staticSurfaceOf(typeName String)
	instanceSurfaceOf(typeName String)
	nothingNamed
end 'LspSubject'

module function lspCursorFollowsAMemberAccess(tokens TokenArray, offset ByteOffset) returns bool
	return receiverIndexBefore(tokens, offset: offset) < tokens.count()
end 'lspCursorFollowsAMemberAccess'

module function lspSubjectAt(text String, tokens TokenArray, keywords KeywordTable, offset ByteOffset, corpus LspCorpus) returns LspSubject
	let receiver = receiverIndexBefore(tokens, offset: offset)

	if receiver >= tokens.count() 'noReceiver'
		return LspSubject.nothingNamed
	end 'noReceiver'

	return lspSubjectOfReceiver(text, tokens: tokens, keywords: keywords, receiver: receiver, corpus: corpus)
end 'lspSubjectAt'

module function lspSubjectOfReceiver(text String, tokens TokenArray, keywords KeywordTable, receiver TokenIndex, corpus LspCorpus) returns LspSubject
	if receiver >= tokens.count() 'noSuchToken'
		return LspSubject.nothingNamed
	end 'noSuchToken'

	return HoverDocument.ofTokens(text, tokens: tokens, keywords: keywords, corpus: corpus).receiverSubject(receiver)
end 'lspSubjectOfReceiver'

module function lspSubjectTypeName(subject LspSubject) returns String
	return match subject 'subject'
		staticSurfaceOf(typeName) gives typeName
		instanceSurfaceOf(typeName) gives typeName
		nothingNamed gives ""
	end 'subject'
end 'lspSubjectTypeName'

module function lspSubjectIsStatic(subject LspSubject) returns bool
	return match subject 'subject'
		staticSurfaceOf gives true
		instanceSurfaceOf gives false
		nothingNamed gives false
	end 'subject'
end 'lspSubjectIsStatic'

module function lspBlockDeclaresMembers(kind LspBlockKind) returns bool
	return kind == LspBlockKind.structBody or kind == LspBlockKind.enumBody or kind == LspBlockKind.unionBody or kind == LspBlockKind.interfaceBody or kind == LspBlockKind.extensionBody
end 'lspBlockDeclaresMembers'

module function lspBlocksDeclaring(blocks LspDocumentBlockArray, typeName String) returns LspDocumentBlockArray
	var declaring = LspDocumentBlockArray.create()

	for block in blocks 'eachBlock'
		if not lspBlockDeclaresMembers(block.kind) 'declaresNoType'
			continue
		end 'declaresNoType'

		if String.from(block.name) != typeName 'anotherType'
			continue
		end 'anotherType'

		declaring.push(block)
	end 'eachBlock'

	return declaring
end 'lspBlocksDeclaring'

// Is `line` a direct member line of `block` — inside it, and inside nothing that is itself inside it?
module function lspBlockDirectlyHoldsLine(blocks LspDocumentBlockArray, block LspDocumentBlock, line LspLineNumber) returns bool
	if not lspBlockHoldsLine(block, line: line) 'outsideTheBody'
		return false
	end 'outsideTheBody'

	for other in blocks 'eachBlock'
		if other.startLine < block.startLine or other.endLine > block.endLine 'notWithinTheType'
			continue
		end 'notWithinTheType'

		if other.startLine == block.startLine and other.endLine == block.endLine 'theTypeItself'
			continue
		end 'theTypeItself'

		if lspBlockHoldsLine(other, line: line) 'insideAMember'
			return false
		end 'insideAMember'
	end 'eachBlock'

	return true
end 'lspBlockDirectlyHoldsLine'

// The receiver of the member access the cursor sits in, found by TOKEN ORDER rather than by byte range:
// a punctuator and a newline carry no bytes — a `Token` of either kind has `startByte` and `endByte` 0 —
// so a `.` cannot be located by offset at all. What can be is the last token carrying source bytes that
// ends at or before the cursor, and the two branches read that token differently. A byte-less run after
// it holding a `.` means the access was just opened, and the receiver is the token before that `.`,
// which for `p.toString().` is the `)` rather than a name. Otherwise the cursor must sit at the END of
// that name, the partial member of `arr.pu`; a cursor anywhere else has left the name behind, and
// answering there offers a member list on a blank line or at an argument position.
//
// `tokens.count()` is the answer for "no receiver". It is not a sentinel inside the index domain: it is
// one past the last index, which no token has.
function receiverIndexBefore(tokens TokenArray, offset ByteOffset) returns TokenIndex
	let total = tokens.count()
	var candidate = total

	for (position, token) in tokens.withIterator() 'eachToken'
		if token.endByte <= token.startByte or token.endByte > offset 'notBeforeTheCursor'
			continue
		end 'notBeforeTheCursor'

		candidate = position.index() as TokenIndex
	end 'eachToken'

	if candidate >= total 'nothingBefore'
		return total
	end 'nothingBefore'

	let opened = openingDotAfter(tokens, candidate: candidate)

	if opened < total 'aMemberAccessJustOpened'
		return opened - 1
	end 'aMemberAccessJustOpened'

	if candidate < TokensBetweenAReceiverAndItsMember 'noReceiverCouldPrecedeIt'
		return total
	end 'noReceiverCouldPrecedeIt'

	let partial = lspTokenAt(tokens, index: candidate)

	if partial.endByte != offset 'theCursorLeftThatNameBehind'
		return total
	end 'theCursorLeftThatNameBehind'

	if not tokenCanBeAName(partial) 'notAPartialMemberName'
		return total
	end 'notAPartialMemberName'

	if lspTokenAt(tokens, index: candidate - 1).kind != TokenKind.dot 'notAMemberAccess'
		return total
	end 'notAMemberAccess'

	return candidate - TokensBetweenAReceiverAndItsMember
end 'receiverIndexBefore'

function openingDotAfter(tokens TokenArray, candidate TokenIndex) returns TokenIndex
	let total = tokens.count()
	var found = total
	var index = candidate + 1

	while index < total 'eachToken'
		let token = lspTokenAt(tokens, index: index)

		if token.endByte > token.startByte or token.kind == TokenKind.newline 'theRunEnds'
			break
		end 'theRunEnds'

		if token.kind == TokenKind.dot 'aMemberAccess'
			found = index
		end 'aMemberAccess'

		index = index + 1
	end 'eachToken'

	return found
end 'openingDotAfter'
