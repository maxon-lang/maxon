// The declarations of a whole PROJECT, for the editor features that have to look outside the buffer in
// front of the author: which file declares a name (`LspDefinition`) and which members a type publishes
// (`LspCompletion`), and which names `textDocument/publishDiagnostics` may not call undeclared.
// `LspDocumentProject` is the other half of the pair and answers about the buffer ALONE. A diagnostic is
// CHECKED there, or by the project check (`LspProjectChecker`, which holds a `Project` of its own), and
// never here: this corpus is lexed and its declarations folded, never compiled, so it can say what a
// name means and never what is wrong with a program.
//
// A document's project root is a ladder, and the order of its rungs is the design.
// `workspaceRootOf` holds it: a document under `stdlib/` or `runtime/` is held as one project
// rooted at that tier directory; a `.maxproj` or `.maxtasks` document is read as a single file,
// because the driver compiles a driver file alone, while a `.maxproj` loaded for
// `RootPurpose.loadsTheProject` takes the rungs below as a source beside it would: a saved one is
// found by the climb's first step, and an unsaved one marks nothing on disk; otherwise the
// nearest ancestor holding a `.maxproj`, climbed no higher than the nearest client-named root that
// holds this document; otherwise the document is a single file, checked against the library tiers
// and never swept. Only a `.maxproj` or a library tier states a project. A named root is a ceiling and never a rung: a directory above the one the client
// opened may hold a `.maxproj` of its own, and rooting a document with no `.maxproj` at the named
// root would load everything under it for a program `maxon build <file>` compiles from its own
// directory. A client that names no root leaves the climb uncapped.
//
// The ladder names a project's directory and nothing more. Which files the project holds, and the
// root its namespaces are measured from, is `projectSourcesIn`'s answer: the `sources` its
// `.maxproj` lists, as `maxon build` reads them, or the directory's walk. The `.maxproj` is run
// only in a trusted workspace, and off the session loop by that project's own resolver
// (`HeldRoot.resolver`).
//
// The named roots change mid-session: `workspace/didChangeWorkspaceFolders` adds and removes them, and
// a removed root takes every project held under it. The sweep under a root prunes a directory holding
// a `.maxproj`: projects do not nest, and a nested one must not change the outer project's index.
//
// ⚠ Answering `unavailable` costs a feature its cross-file half and leaves the in-buffer half standing,
// which is what an editor should see: fewer answers, never a refused request.
module union LspCorpus
	loaded(project Project, signatures ProgramSignatures, readerPath FilePath)
	unavailable
end 'LspCorpus'

module typealias LspClientRootArray = Array with FilePath

module typealias LspProjectFileCount = int(0 to u64.max)

module union LspProjectFacts
	swept(root FilePath, fileCount LspProjectFileCount)
	unswept(root FilePath)
	singleFile(path FilePath)
	unlocated
end 'LspProjectFacts'

module union LspRootSearch
	ready(tiers LibraryTiers, workingDirectory FilePath)
	unavailable
end 'LspRootSearch'

union DocumentDirectory
	at(dir FilePath)
	none
end 'DocumentDirectory'

type ReaderDocument
	module let path as FilePath
	module let normalized as FilePath
	module let climbCeiling as ProjectClimbCeiling
	module let directory as DocumentDirectory

	static function of(readerPath FilePath, namedRoots LspClientRootArray) returns ReaderDocument
		let normalized = readerPath.normalize()

		return Self{path: readerPath, normalized: normalized, climbCeiling: nearestNamedRootOver(normalized, namedRoots: namedRoots), directory: directoryHolding(readerPath)}
	end 'of'
end 'ReaderDocument'

// Made once per request and handed down: the tier probe and the tier directories' normalisation
// would otherwise be repeated by every step of one diagnostics publish.
module type LspReaderSearch
	module let document as ReaderDocument
	module let tiers as LibraryTiers
	module let workingDirectory as FilePath
	module var workspace as LspWorkspaceState
	module let tier as TierMembership

	static function create(document ReaderDocument, tiers LibraryTiers, workingDirectory FilePath, workspace LspWorkspaceState) returns LspReaderSearch
		return Self{document: document, tiers: tiers, workingDirectory: workingDirectory, workspace: workspace, tier: tierHolding(document, tiers: tiers)}
	end 'create'

	module static function of(readerPath FilePath, tiers LibraryTiers, workspace LspWorkspaceState) returns LspReaderSearch
		return LspReaderSearch.create(ReaderDocument.of(readerPath, namedRoots: workspace.namedRoots), tiers: tiers, workingDirectory: Directory.currentPath(), workspace: workspace)
	end 'of'
end 'LspReaderSearch'

// A uri that carries no `://` is kept verbatim, so `untitled:Untitled-1` arrives here as a path. A
// path with no directory above it is not a place: the document gets no project rather than one
// rooted at the uri's own text. The test is the parent and not the uri's scheme, because a library
// file has a real directory and keeps its project while an unsaved buffer keeps the library tiers.
function directoryHolding(path FilePath) returns DocumentDirectory
	let dir = try path.parent() otherwise return DocumentDirectory.none

	return DocumentDirectory.at(dir)
end 'directoryHolding'

module enum RootPurpose
	loadsTheProject
	readsTheDocument
end 'RootPurpose'

module union WorkspaceRoot
	projectDirectory(dir FilePath)
	libraryTier(dir FilePath)
	singleFile
end 'WorkspaceRoot'

union TierMembership
	inTier(dir FilePath)
	outside
end 'TierMembership'

// A walk that could not list a directory answers `walkFailed`, never an empty list: the sweep's
// result is what decides which files are unregistered, and one folder that cannot be listed — a
// branch switch, a build in the same tree, a denied ACL — would otherwise unregister every file
// of the project.
module union SourceSweep
	swept(sources MaxonSourcePathArray)
	walkFailed
end 'SourceSweep'

// A held project and the source list it was built over. ⚠ The directory walk that takes that list
// runs only on a miss, or once `WorkspaceResweepIntervalMs` has passed: hover, definition and
// completion each ask for a corpus as fast as an editor can send, and a walk hoisted ahead of the
// held-project probe costs one per request with nothing failing to say so.
//
// A file created on disk and a file deleted from it are both noticed at that walk and not before,
// while a file's content is re-read every request.
//
// A walk whose source set roots elsewhere answers `rerooted` and the corpus is rebuilt: a
// `Project`'s root fixes every file's namespace for its whole life.
//
// `tests/lsp/definition-notices-a-file-created-on-disk.maxtest` holds the re-walk in place.
type HeldCorpus
	var project as Project
	let selection as SourceSelection
	let buildRoot as FilePath
	module var sweep as SourceSweep
	var sweptAtMs as InstantMs

	static function create(project Project, selection SourceSelection, sources EditorSources, sweptAtMs InstantMs) returns HeldCorpus
		return Self{project: project, selection: selection, buildRoot: sources.root.clone(), sweep: sources.sweep.clone(), sweptAtMs: sweptAtMs}
	end 'create'

	function sweptFor(root WorkspaceRoot, request SweepRequest, workspace LspWorkspaceState) returns SweptProject
		if self.resweepMovesTheRoot(root, readerPath: documentOf(request), workspace: workspace) 'rerooted'
			return SweptProject.rerooted
		end 'rerooted'

		return self.project.sweptOver(self.sweep, request: request)
	end 'sweptFor'

	function resweepMovesTheRoot(root WorkspaceRoot, readerPath FilePath, workspace LspWorkspaceState) returns bool
		if self.sweepIsFresh() 'sweptRecently'
			return false
		end 'sweptRecently'

		let sources = sourcesUnder(root, selection: self.selection, readerPath: readerPath, workspace: workspace)

		if not sources.root.equals(self.buildRoot) 'rootMoved'
			return true
		end 'rootMoved'

		match sources.sweep 'walk'
			swept then self.holdCompletedWalk(sources)
			walkFailed then break
		end 'walk'

		return false
	end 'resweepMovesTheRoot'

	function sweepIsFresh() returns bool
		return match self.sweep 'sweep'
			swept gives Clock.elapsedMs(self.sweptAtMs) < WorkspaceResweepIntervalMs
			walkFailed gives false
		end 'sweep'
	end 'sweepIsFresh'

	function holdCompletedWalk(sources EditorSources)
		self.sweep = sources.sweep.clone()
		self.sweptAtMs = Clock.nowMs()
	end 'holdCompletedWalk'

	function facts(root FilePath) returns LspProjectFacts
		return match self.sweep 'sweep'
			swept(sources) gives LspProjectFacts.swept(root, fileCount: productionSourceCount(sources))
			walkFailed gives LspProjectFacts.unswept(root)
		end 'sweep'
	end 'facts'
end 'HeldCorpus'

// The production sources only, whichever corpus is held, so a project's count does not depend on
// the kind of document that loaded it first.
function productionSourceCount(sources MaxonSourcePathArray) returns LspProjectFileCount
	var count = 0 as LspProjectFileCount

	for path in sources 'eachSource'
		if selectionAdmits(SourceSelection.productionOnly, name: path.filename()) 'aProductionSource'
			count = count + 1
		end 'aProductionSource'
	end 'eachSource'

	return count
end 'productionSourceCount'

typealias HeldCorpusMap = Map with (SourceSelection, HeldCorpus)

// One corpus per `SourceSelection`, chosen by the reader (`readerSelectionOf`): a `.maxtest` reader
// sees the project's test files, as `maxon test` compiles them, and a production reader never sees
// a name only a test file declares.
type HeldWorkspace
	var corpora as HeldCorpusMap

	static function create() returns HeldWorkspace
		return Self{corpora: HeldCorpusMap.create()}
	end 'create'

	function sweptFor(root WorkspaceRoot, key String, tiers LibraryTiers, request SweepRequest, workspace LspWorkspaceState) returns SweptProject
		let selection = readerSelectionOf(documentOf(request))

		if self.corpora.contains(selection) 'heldAlready'
			var held = try self.corpora.get(selection) otherwise panic("HeldWorkspace.sweptFor: the corpus for this selection was found one line above")

			var swept = held.sweptFor(root, request: request, workspace: workspace)

			match swept 'outcome'
				rerooted then _ = self.corpora.remove(selection)
				read or
				loaded or
				unavailable then return swept
			end 'outcome'
		end 'heldAlready'

		match root 'root'
			projectDirectory or
			libraryTier then return self.announcedSwept(root, key: key, selection: selection, tiers: tiers, request: request, workspace: workspace)
			singleFile then return self.builtSwept(root, selection: selection, tiers: tiers, request: request, workspace: workspace)
		end 'root'
	end 'sweptFor'

	function announcedSwept(root WorkspaceRoot, key String, selection SourceSelection, tiers LibraryTiers, request SweepRequest, workspace LspWorkspaceState) returns SweptProject
		writeProjectLoadingNotification(workspace.writer, rootPath: key, loading: true)
		var swept = self.builtSwept(root, selection: selection, tiers: tiers, request: request, workspace: workspace)
		writeProjectLoadingNotification(workspace.writer, rootPath: key, loading: false)

		return swept
	end 'announcedSwept'

	// Every return here reaches the `loading: false` in `announcedSwept`; one that skipped it would leave
	// the client showing this project as loading for the rest of the session.
	function builtSwept(root WorkspaceRoot, selection SourceSelection, tiers LibraryTiers, request SweepRequest, workspace LspWorkspaceState) returns SweptProject
		let sources = sourcesUnder(root, selection: selection, readerPath: documentOf(request), workspace: workspace)
		var project = try libraryTierProject(sources.root, tiers: tiers, buffer: OpenBuffer.none, fileMemos: workspace.fileMemos) otherwise return SweptProject.unavailable
		var fresh = HeldCorpus.create(project, selection: selection, sources: sources, sweptAtMs: Clock.nowMs())

		var swept = fresh.sweptFor(root, request: request, workspace: workspace)

		match swept 'outcome'
			read or
			loaded then self.corpora.upsert(selection, value: fresh)
			unavailable then return SweptProject.unavailable
			rerooted then panic("HeldWorkspace.builtSwept: a corpus built a moment ago holds the root its own sweep named")
		end 'outcome'

		return swept
	end 'builtSwept'

	function facts(root FilePath) returns LspProjectFacts
		for selection in SourceSelection.allCases 'eachSelection'
			if let held = try self.corpora.get(selection) 'heldForThisSelection'
				return held.facts(root)
			end 'heldForThisSelection'
		end 'eachSelection'

		panic("HeldWorkspace.facts: '{root.toString()}' is held, and a workspace is held only once one of its corpora has loaded")
	end 'facts'
end 'HeldWorkspace'

union SweepRequest
	reading(path FilePath)
	loadingFor(path FilePath)
end 'SweepRequest'

function documentOf(request SweepRequest) returns FilePath
	return match request 'request'
		reading(path) gives path
		loadingFor(path) gives path
	end 'request'
end 'documentOf'

union SweptProject
	read(project Project, signatures ProgramSignatures, readerPath FilePath)
	loaded
	unavailable
	rerooted
end 'SweptProject'

typealias HeldProjectKeyArray = Array with String

// Projects are held across requests because building one costs a sweep, a lex of every file and a
// signature fold. Eight rather than one: a jump from a user file into `stdlib/` and back crosses
// two roots, so a cache of one turns every round trip into two cold rebuilds. Least recently used
// out, so a session that wanders cannot grow the process without bound and the root the author is
// working in is not evicted by a detour through the library. Overflowing this costs a re-fold
// rather than a re-read: a rebuilt `Project` still hits the shared file memos
// (`LspWorkspaceState.fileMemos`). A held root carries its project checker and its resolver too
// (`HeldRoot`), so an evicted root's next check builds cold.
let HeldProjectCapacity = 8

let WorkspaceResweepIntervalMs = 1000

// How long an unbuilt or refused answer holds while its stamp holds and the trust is unchanged. Any
// other answer holds until its stamp or the trust changes (`ProjectInputsAnswer.stillAnswers`).
let UnresolvedProjectRetryMs = 10000

let ProjectLoadingMethod = "maxon/projectLoading"
let ProjectLoadingKey = "loading"

module type LspWorkspaceState
	module var held as RecentHeldRoots
	module var trusted as bool
	module var namedRoots as LspClientRootArray
	module var fileMemos as SharedFileMemoMap
	module let writer as LspStdoutWriter.handle
	module var arrivals as LspArrivalPromiseArray
	module var recordWatches as RecordWatchMap
	var nextResolutionTicket as ResolutionTicket

	module static function create(writer LspStdoutWriter.handle) returns LspWorkspaceState
		return Self{held: RecentHeldRoots.create(), trusted: true, namedRoots: LspClientRootArray.create(), fileMemos: SharedFileMemoMap.create(), writer: writer, arrivals: LspArrivalPromiseArray.create(), recordWatches: RecordWatchMap.create(), nextResolutionTicket: 0}
	end 'create'

	module function projectInputsOf(dir FilePath) returns ProjectInputsAnswer
		var root = self.held.rootAt(dir.toString())

		return root.inputs.answerFor(dir, workspace: self)
	end 'projectInputsOf'

	module function projectResolved(dir FilePath, answer ProjectInputsAnswer, ticket ResolutionTicket) returns bool
		var root = try self.held.peek(dir.toString()) otherwise return false

		return root.inputs.hold(answer, ticket: ticket)
	end 'projectResolved'

	module function nextArrival() returns LspArrival
		let ready = self.arrivals.awaitAny()
		let frame = try self.arrivals.get(LspFrameSlot) otherwise panic("LspWorkspaceState.nextArrival: a session that is still serving awaits a frame in its first slot")
		let taken = LspFrameSlot if frame.isComplete() else ready
		let arrival = try self.arrivals.remove(taken) otherwise panic("LspWorkspaceState.nextArrival: awaitAny named a slot of the array it was asked about")

		return await arrival
	end 'nextArrival'

	function requestResolution(dir FilePath) returns ResolutionTicket
		self.nextResolutionTicket = self.nextResolutionTicket + 1
		let ticket = self.nextResolutionTicket
		var root = self.held.rootAt(dir.toString())
		var resolver = root.resolver.obtained(function() gives spawn LspProjectResolver.create())
		self.arrivals.push(try resolver.resolve(dir.clone(), ticket: ticket, previous: root.inputs.previousInputStamps().clone(), sendTimeout: ForeverMs) otherwise panic("LspWorkspaceState.requestResolution: a send that waits forever for room, to a resolver this workspace holds, was refused"))

		return ticket
	end 'requestResolution'
end 'LspWorkspaceState'

module function lspRememberClientRoots(workspace LspWorkspaceState, roots LspClientRootArray)
	workspace.namedRoots = LspClientRootArray.create()

	for root in roots 'eachRoot'
		rememberOneClientRoot(workspace, root: root)
	end 'eachRoot'
end 'lspRememberClientRoots'

module function lspChangeClientRoots(workspace LspWorkspaceState, added LspClientRootArray, removed LspClientRootArray)
	for root in removed 'eachRemoved'
		forgetClientRoot(workspace, root: root)
	end 'eachRemoved'

	for root in added 'eachAdded'
		rememberOneClientRoot(workspace, root: root)
	end 'eachAdded'
end 'lspChangeClientRoots'

function rememberOneClientRoot(workspace LspWorkspaceState, root FilePath)
	let dir = root.normalize()

	if namedRootsHold(workspace.namedRoots, dir: dir) 'alreadyNamed'
		return
	end 'alreadyNamed'

	workspace.namedRoots.push(dir)
end 'rememberOneClientRoot'

function namedRootsHold(namedRoots LspClientRootArray, dir FilePath) returns bool
	for existing in namedRoots 'eachRoot'
		if existing.equals(dir) 'theSameRoot'
			return true
		end 'theSameRoot'
	end 'eachRoot'

	return false
end 'namedRootsHold'

function forgetClientRoot(workspace LspWorkspaceState, root FilePath)
	let dir = root.normalize()
	var kept = LspClientRootArray.create()

	for existing in workspace.namedRoots 'eachRoot'
		if not existing.equals(dir) 'staysNamed'
			kept.push(existing)
		end 'staysNamed'
	end 'eachRoot'

	workspace.namedRoots = kept

	// A root is dropped in two places or not at all: the named-root list, and the projects already built
	// under it. Nothing but capacity expires a held project, so one left behind outlives the folder the
	// author closed.
	workspace.held.dropUnder(dir)
end 'forgetClientRoot'

function heldProjectIsUnder(key String, dir FilePath) returns bool
	let held = try FilePath.from(key) otherwise return false

	return held.normalize().isInside(dir)
end 'heldProjectIsUnder'

// Both halves are a filesystem probe and neither varies with the document, so it is made once per
// answer and handed down: `listProjectsAnswer`'s walk over the open documents would otherwise pay
// for both once per document.
module function lspRootSearch() returns LspRootSearch
	let tiers = try LibraryTiers.locate() otherwise return LspRootSearch.unavailable

	return LspRootSearch.ready(tiers, workingDirectory: Directory.currentPath())
end 'lspRootSearch'

// The directory test comes before the search, which answers `singleFile` with no ladder when the
// filesystem could not be probed and would file a path-less document under its own uri text.
module function lspProjectFactsOf(workspace LspWorkspaceState, readerPath FilePath, search LspRootSearch) returns LspProjectFacts
	let document = ReaderDocument.of(readerPath, namedRoots: workspace.namedRoots)

	return match document.directory 'directory'
		at gives locatedFacts(document, search: search, workspace: workspace)
		none gives LspProjectFacts.unlocated
	end 'directory'
end 'lspProjectFactsOf'

function locatedFacts(document ReaderDocument, search LspRootSearch, workspace LspWorkspaceState) returns LspProjectFacts
	return match search 'search'
		ready(tiers, workingDirectory) gives factsUnderTheRootOf(LspReaderSearch.create(document, tiers: tiers, workingDirectory: workingDirectory, workspace: workspace))
		unavailable gives LspProjectFacts.singleFile(document.path)
	end 'search'
end 'locatedFacts'

function factsUnderTheRootOf(reader LspReaderSearch) returns LspProjectFacts
	let root = workspaceRootOf(reader, purpose: RootPurpose.loadsTheProject)

	return match root 'root'
		projectDirectory or
		libraryTier gives heldProjectFacts(reader.workspace, root: root, readerPath: reader.document.path)
		singleFile gives LspProjectFacts.singleFile(reader.document.path)
	end 'root'
end 'factsUnderTheRootOf'

// The key is `heldRootOf`'s answer, which is the derivation `heldProjectSwept` files a project under. A
// second spelling of it here reads a miss for every root and reports every project unswept, with nothing
// failing to say so.
function heldProjectFacts(workspace LspWorkspaceState, root WorkspaceRoot, readerPath FilePath) returns LspProjectFacts
	let heldRoot = heldRootOf(root, readerPath: readerPath)
	let held = try workspace.held.peek(heldRoot.toString()) otherwise return LspProjectFacts.unswept(heldRoot)

	return match held.workspace 'workspace'
		built(heldWorkspace) gives heldWorkspace.facts(heldRoot)
		notBuilt gives LspProjectFacts.unswept(heldRoot)
	end 'workspace'
end 'heldProjectFacts'

module function lspDocumentCorpus(workspace LspWorkspaceState, uri String) returns LspCorpus
	let readerPath = try FilePath.from(uri) otherwise return LspCorpus.unavailable
	let document = ReaderDocument.of(readerPath, namedRoots: workspace.namedRoots)

	return match lspRootSearch() 'search'
		ready(tiers, workingDirectory) gives sweptWorkspace(workspace, root: workspaceRootOf(LspReaderSearch.create(document, tiers: tiers, workingDirectory: workingDirectory, workspace: workspace), purpose: RootPurpose.readsTheDocument), tiers: tiers, readerPath: readerPath)
		unavailable gives LspCorpus.unavailable
	end 'search'
end 'lspDocumentCorpus'

module function lspProjectCorpus(reader LspReaderSearch, root WorkspaceRoot) returns LspCorpus
	return match root 'root'
		projectDirectory or
		libraryTier gives sweptWorkspace(reader.workspace, root: root, tiers: reader.tiers, readerPath: reader.document.path)
		singleFile gives LspCorpus.unavailable
	end 'root'
end 'lspProjectCorpus'

module function lspLoadProject(reader LspReaderSearch)
	let root = workspaceRootOf(reader, purpose: RootPurpose.loadsTheProject)

	match root 'root'
		projectDirectory or
		libraryTier then _ = heldProjectSwept(reader.workspace, root: root, tiers: reader.tiers, request: SweepRequest.loadingFor(reader.document.path))
		singleFile then return
	end 'root'
end 'lspLoadProject'

module union ProjectCheckRoot
	at(dir FilePath)
	none
end 'ProjectCheckRoot'

module function lspProjectCheckRoot(reader LspReaderSearch, root WorkspaceRoot) returns ProjectCheckRoot
	if not selectionAdmits(SourceSelection.productionOnly, name: reader.document.path.filename()) 'notAProgramABuildChecks'
		return ProjectCheckRoot.none
	end 'notAProgramABuildChecks'

	return match root 'root'
		projectDirectory(dir) gives ProjectCheckRoot.at(dir)
		libraryTier or
		singleFile gives ProjectCheckRoot.none
	end 'root'
end 'lspProjectCheckRoot'

function nearestNamedRootOver(document FilePath, namedRoots LspClientRootArray) returns ProjectClimbCeiling
	var nearest = ProjectClimbCeiling.none

	for root in namedRoots 'eachRoot'
		nearest = nearerNamedRoot(nearest, candidate: root, document: document)
	end 'eachRoot'

	return nearest
end 'nearestNamedRootOver'

// A root that does not hold this document is never selected, not even as the only candidate: the climb
// never meets it, so it caps nothing, and holding it would refuse a later root that does hold the
// document.
function nearerNamedRoot(nearest ProjectClimbCeiling, candidate FilePath, document FilePath) returns ProjectClimbCeiling
	if not document.isInside(candidate) 'holdsNothingOfThisDocument'
		return nearest
	end 'holdsNothingOfThisDocument'

	if not candidateIsNearer(nearest, dir: candidate) 'noNearerThanTheOneHeld'
		return nearest
	end 'noNearerThanTheOneHeld'

	return ProjectClimbCeiling.at(candidate)
end 'nearerNamedRoot'

function candidateIsNearer(nearest ProjectClimbCeiling, dir FilePath) returns bool
	return match nearest 'nearest'
		at(held) gives dir.isInside(held)
		none gives true
	end 'nearest'
end 'candidateIsNearer'

function sweptWorkspace(workspace LspWorkspaceState, root WorkspaceRoot, tiers LibraryTiers, readerPath FilePath) returns LspCorpus
	match heldProjectSwept(workspace, root: root, tiers: tiers, request: SweepRequest.reading(readerPath)) 'swept'
		read(project, signatures, reader) then return LspCorpus.loaded(project, signatures: signatures, readerPath: reader)
		unavailable then return LspCorpus.unavailable
		loaded then panic("sweptWorkspace: a request that reads is answered with the reader's corpus or not at all")
		rerooted then panic("sweptWorkspace: a held workspace rebuilds a corpus whose root moved before it answers")
	end 'swept'
end 'sweptWorkspace'

function heldProjectSwept(workspace LspWorkspaceState, root WorkspaceRoot, tiers LibraryTiers, request SweepRequest) returns SweptProject
	let key = heldRootOf(root, readerPath: documentOf(request)).toString()

	if var held = try workspace.held.recentAt(key) 'heldAlready'
		var slot = held.workspace

		match slot 'workspace'
			built(heldWorkspace) then return heldWorkspace.sweptFor(root, key: key, tiers: tiers, request: request, workspace: workspace)
			notBuilt then break
		end 'workspace'
	end 'heldAlready'

	var fresh = HeldWorkspace.create()
	var swept = fresh.sweptFor(root, key: key, tiers: tiers, request: request, workspace: workspace)

	match swept 'outcome'
		read or
		loaded then workspace.held.holdWorkspace(key, workspace: fresh)
		unavailable then break
		rerooted then panic("heldProjectSwept: a held workspace rebuilds a corpus whose root moved before it answers")
	end 'outcome'

	return swept
end 'heldProjectSwept'

function readerSelectionOf(readerPath FilePath) returns SourceSelection
	return SourceSelection.productionAndTests if isTestSourceName(readerPath.filename()) else SourceSelection.productionOnly
end 'readerSelectionOf'

function writeProjectLoadingNotification(writer LspStdoutWriter.handle, rootPath String, loading bool)
	var doc = JsonDoc.create()
	var params = LspJsonObject.create(doc)
	params.put(LspRootPathKey, value: JsonNode.stringNode(rootPath))
	params.put(ProjectLoadingKey, value: JsonNode.boolNode(loading))

	writeLspNotification(writer, doc: doc, method: ProjectLoadingMethod, params: params.finish())
end 'writeProjectLoadingNotification'

module function lspProjectCheckerFor(workspace LspWorkspaceState, dir FilePath, tiers LibraryTiers) returns LspProjectChecker.handle
	var root = workspace.held.rootAt(dir.toString())

	return root.checker.obtained(function() gives spawn LspProjectChecker.create(dir.clone(), stdlibDir: tiers.stdlibDir.clone(), runtimeDir: tiers.runtimeDir.clone(), writer: workspace.writer.clone()))
end 'lspProjectCheckerFor'

union HeldWorkspaceSlot
	notBuilt
	built(workspace HeldWorkspace)
end 'HeldWorkspaceSlot'

type HeldService uses Handle
	typealias Spawner = function() returns Handle
	typealias HandleColumn = Array with Handle

	var held as HandleColumn

	static function create() returns Self
		return Self{held: HandleColumn.create()}
	end 'create'

	function obtained(spawner Spawner) returns Handle
		if self.held.isEmpty() 'notSpawned'
			self.held.push(spawner())
		end 'notSpawned'

		return try self.held.get(0) otherwise panic("HeldService.obtained: a service was held or spawned a line above")
	end 'obtained'
end 'HeldService'

typealias HeldChecker = HeldService with LspProjectChecker.handle

typealias HeldResolver = HeldService with LspProjectResolver.handle

type HeldRoot
	module var workspace as HeldWorkspaceSlot
	module var checker as HeldChecker
	module var resolver as HeldResolver
	module var inputs as ProjectInputsMemo

	static function create() returns HeldRoot
		return Self{workspace: HeldWorkspaceSlot.notBuilt, checker: HeldChecker.create(), resolver: HeldResolver.create(), inputs: ProjectInputsMemo.create()}
	end 'create'

	function demote()
		self.workspace = HeldWorkspaceSlot.notBuilt
		self.checker = HeldChecker.create()
	end 'demote'
end 'HeldRoot'

module union InputsChange
	everyProject
	oneProject(key String)
end 'InputsChange'

module function inputsChangeReachesDocument(change InputsChange, workspace LspWorkspaceState, uri String, search LspRootSearch) returns bool
	match change 'change'
		everyProject then return true
		oneProject(key) then return documentIsInProject(workspace, uri: uri, key: key, search: search)
	end 'change'
end 'inputsChangeReachesDocument'

function documentIsInProject(workspace LspWorkspaceState, uri String, key String, search LspRootSearch) returns bool
	let readerPath = try FilePath.from(uri) otherwise return false

	return match lspProjectFactsOf(workspace, readerPath: readerPath, search: search) 'facts'
		swept(root, _) gives root.toString() == key
		unswept(root) gives root.toString() == key
		singleFile or
		unlocated gives false
	end 'facts'
end 'documentIsInProject'

typealias HeldRootMap = Map with (String, HeldRoot)

module type RecentHeldRoots
	var roots as HeldRootMap
	var order as HeldProjectKeyArray

	static function create() returns RecentHeldRoots
		return Self{roots: HeldRootMap.create(), order: HeldProjectKeyArray.create()}
	end 'create'

	function rootAt(key String) returns HeldRoot
		if not self.roots.contains(key) 'firstUse'
			self.roots.upsert(key, value: HeldRoot.create())
		end 'firstUse'

		return try self.recentAt(key) otherwise panic("RecentHeldRoots.rootAt: '{key}' is filed above when absent")
	end 'rootAt'

	function recentAt(key String) returns HeldRoot throws MapError
		var held = try self.roots.get(key)
		self.use(key)

		return held
	end 'recentAt'

	module function forgetCorpora(change InputsChange)
		match change 'change'
			everyProject then self.forgetEveryCorpus()
			oneProject(key) then self.forgetCorpusAt(key)
		end 'change'
	end 'forgetCorpora'

	function forgetEveryCorpus()
		for key in self.order 'eachKey'
			self.forgetCorpusAt(key)
		end 'eachKey'
	end 'forgetEveryCorpus'

	function forgetCorpusAt(key String)
		var held = try self.roots.get(key) otherwise return
		held.workspace = HeldWorkspaceSlot.notBuilt
	end 'forgetCorpusAt'

	function holdWorkspace(key String, workspace HeldWorkspace)
		var held = self.rootAt(key)
		held.workspace = HeldWorkspaceSlot.built(workspace)
	end 'holdWorkspace'

	function peek(key String) returns HeldRoot throws MapError
		return try self.roots.get(key)
	end 'peek'

	function use(key String)
		var kept = HeldProjectKeyArray.create()

		for existing in self.order 'eachKey'
			if existing != key 'staysInOrder'
				kept.push(existing)
			end 'staysInOrder'
		end 'eachKey'

		kept.push(key)

		while kept.count() > HeldProjectCapacity 'overCapacity'
			let evicted = try kept.remove(0) otherwise panic("RecentHeldRoots.use: the order is over capacity, so it holds a first element")
			self.evict(evicted)
		end 'overCapacity'

		self.order = kept
	end 'use'

	// A root awaiting its resolution keeps its memo until the answer lands (`releaseIfDemoted`):
	// `projectResolved` drops an answer for a root this map no longer holds, and the documents that
	// asked would never be checked against it.
	function evict(key String)
		var held = try self.roots.get(key) otherwise panic("RecentHeldRoots.evict: '{key}' is in the order, so it is in the map")

		if held.inputs.isAwaitingResolution() 'awaitsItsResolver'
			held.demote()
			return
		end 'awaitsItsResolver'

		_ = self.roots.remove(key)
	end 'evict'

	module function releaseIfDemoted(key String)
		if self.order.contains(key) 'stillHeld'
			return
		end 'stillHeld'

		_ = self.roots.remove(key)
	end 'releaseIfDemoted'

	// Walks the map, not the order: a demoted root is in the map alone, and goes with its folder too.
	function dropUnder(dir FilePath)
		var gone = HeldProjectKeyArray.create()

		for (key, _) in self.roots 'eachRoot'
			if heldProjectIsUnder(key, dir: dir) 'goesWithTheFolder'
				gone.push(key.clone())
			end 'goesWithTheFolder'
		end 'eachRoot'

		for key in gone 'eachGone'
			_ = self.roots.remove(key)
		end 'eachGone'

		var kept = HeldProjectKeyArray.create()

		for key in self.order 'eachKey'
			if self.roots.contains(key) 'staysHeld'
				kept.push(key)
			end 'staysHeld'
		end 'eachKey'

		self.order = kept
	end 'dropUnder'
end 'RecentHeldRoots'

function heldRootOf(root WorkspaceRoot, readerPath FilePath) returns FilePath
	return match root 'root'
		projectDirectory(dir) gives dir
		libraryTier(dir) gives dir
		singleFile gives readerPath
	end 'root'
end 'heldRootOf'

// A tier corpus is built rooted at the tier's parent. Rooted at the tier itself, `rootIsUnder`
// would hold and the tier's files would be the project's own rather than library source, which they
// are in every whole-program compile. It is still held and listed under the tier directory
// (`heldRootOf`).
function buildRootOf(root WorkspaceRoot, readerPath FilePath) returns FilePath
	return match root 'root'
		libraryTier(dir) gives try dir.parent() otherwise panic("buildRootOf: '{dir.toString()}' is a library tier, a directory `LibraryTiers.locate` found by name inside another")
		projectDirectory or
		singleFile gives heldRootOf(root, readerPath: readerPath)
	end 'root'
end 'buildRootOf'

module function lspBufferRootOf(reader LspReaderSearch) returns FilePath
	return match reader.tier 'tier'
		inTier(dir) gives buildRootOf(WorkspaceRoot.libraryTier(dir), readerPath: reader.document.path)
		outside gives reader.document.path
	end 'tier'
end 'lspBufferRootOf'

module type EditorSources
	module let sweep as SourceSweep
	module let root as FilePath
	module let refusal as StringArray

	module static function walked(sweep SourceSweep, root FilePath) returns EditorSources
		return Self{sweep: sweep, root: root, refusal: StringArray.create()}
	end 'walked'

	module static function refused(root FilePath, lines StringArray) returns EditorSources
		return Self{sweep: SourceSweep.walkFailed, root: root, refusal: lines}
	end 'refused'
end 'EditorSources'

function sourcesUnder(root WorkspaceRoot, selection SourceSelection, readerPath FilePath, workspace LspWorkspaceState) returns EditorSources
	return match root 'root'
		projectDirectory(dir) gives projectSourcesIn(dir, selection: selection, answer: workspace.projectInputsOf(dir))
		libraryTier(dir) gives EditorSources.walked(maxonSourcesIn(dir, selection: selection), root: buildRootOf(root, readerPath: readerPath))
		singleFile gives EditorSources.walked(SourceSweep.swept(MaxonSourcePathArray.create()), root: buildRootOf(root, readerPath: readerPath))
	end 'root'
end 'sourcesUnder'

module function projectSourcesIn(dir FilePath, selection SourceSelection, answer ProjectInputsAnswer) returns EditorSources
	match answer.inputs 'inputs'
		walked or
		ambiguous or
		unbuilt then return EditorSources.walked(maxonSourcesIn(dir, selection: selection), root: dir)
		listed(paths, _) then return listedSources(paths, selection: selection, projectDir: dir)
		refused then return EditorSources.refused(dir, lines: answer.refusal.clone())
	end 'inputs'
end 'projectSourcesIn'

function listedSources(paths MaxonSourcePathArray, selection SourceSelection, projectDir FilePath) returns EditorSources
	let root = try commonAncestorOf(paths) otherwise (e) 'noCommonRoot'
		return EditorSources.refused(projectDir, lines: projectFailureLines(e))
	end 'noCommonRoot'

	let sources = try namedSourceFiles(paths, selection: selection, nestedProjects: NestedProjectRule.pruned) otherwise (e) 'unlistable'
		return EditorSources.refused(projectDir, lines: projectFailureLines(e))
	end 'unlistable'

	return EditorSources.walked(SourceSweep.swept(sources), root: root)
end 'listedSources'

// What an answer was resolved from: the `.maxproj` text and the state of each input it declared. A
// file the project file reads without declaring it is not covered, and an edit to it leaves the
// answer stale. `unknown` equals no stamp, itself included; its inputs are the baseline the next run
// is compared against.
export union ProjectFileStamp
	absent
	present(file FilePath, content String, inputs DeclaredInputStamps)
	unknown(inputs DeclaredInputStamps)
end 'ProjectFileStamp'

module union StampCurrency
	outdated
	vouched
	refreshed(stamp ProjectFileStamp)
end 'StampCurrency'

function projectFileStampIn(dir FilePath) returns ProjectFileStamp
	let search = try driverFileIn(dir, extension: ProjectFileExtension) otherwise return ProjectFileStamp.unknown(DeclaredInputStamps.create())

	return match search 'search'
		found(file) gives stampOfFile(file)
		none gives ProjectFileStamp.absent
	end 'search'
end 'projectFileStampIn'

function stampOfFile(file FilePath) returns ProjectFileStamp
	let content = try File.readText(file) otherwise return ProjectFileStamp.unknown(DeclaredInputStamps.create())

	return ProjectFileStamp.present(file, content: content, inputs: DeclaredInputStamps.create())
end 'stampOfFile'

function stampWithInputs(stamp ProjectFileStamp, inputs DeclaredInputStamps) returns ProjectFileStamp
	return match stamp 'stamp'
		present(file, content, _) gives ProjectFileStamp.present(file.clone(), content: content.clone(), inputs: inputs)
		unknown gives ProjectFileStamp.unknown(inputs)
		absent gives stamp.clone()
	end 'stamp'
end 'stampWithInputs'

function inputStampsOfStamp(stamp ProjectFileStamp) returns DeclaredInputStamps
	return match stamp 'stamp'
		present(_, _, held) gives held
		unknown(baseline) gives baseline
		absent gives DeclaredInputStamps.create()
	end 'stamp'
end 'inputStampsOfStamp'

function stampHolds(stamp ProjectFileStamp, current ProjectFileStamp) returns bool
	return match stampCurrency(stamp, current: current) 'currency'
		outdated gives false
		vouched or
		refreshed gives true
	end 'currency'
end 'stampHolds'

function stampCurrency(stamp ProjectFileStamp, current ProjectFileStamp) returns StampCurrency
	return match current 'current'
		absent gives currencyWithNoProjectFile(stamp)
		present(file, content, _) gives currencyOfProjectFile(stamp, file: file, content: content)
		unknown gives StampCurrency.outdated
	end 'current'
end 'stampCurrency'

function currencyWithNoProjectFile(stamp ProjectFileStamp) returns StampCurrency
	return match stamp 'stamp'
		absent gives StampCurrency.vouched
		present or
		unknown gives StampCurrency.outdated
	end 'stamp'
end 'currencyWithNoProjectFile'

function currencyOfProjectFile(stamp ProjectFileStamp, file FilePath, content String) returns StampCurrency
	return match stamp 'stamp'
		present(heldFile, heldContent, heldInputs) gives currencyOfHeldInputs(heldFile, heldContent: heldContent, heldInputs: heldInputs, file: file, content: content)
		absent or
		unknown gives StampCurrency.outdated
	end 'stamp'
end 'currencyOfProjectFile'

function currencyOfHeldInputs(heldFile FilePath, heldContent String, heldInputs DeclaredInputStamps, file FilePath, content String) returns StampCurrency
	if not heldFile.equals(file) or heldContent != content 'anotherProjectFile'
		return StampCurrency.outdated
	end 'anotherProjectFile'

	return match checkDeclaredInputs(heldInputs) 'check'
		vouched gives StampCurrency.vouched
		refreshed(renewed) gives StampCurrency.refreshed(ProjectFileStamp.present(heldFile.clone(), content: heldContent.clone(), inputs: renewed))
		changed gives StampCurrency.outdated
	end 'check'
end 'currencyOfHeldInputs'

export type ProjectInputsAnswer
	module let inputs as ProjectInputs
	module let refusal as StringArray
	module let notice as StringArray
	module let trusted as bool
	module let resolved as bool
	module let stamp as ProjectFileStamp
	module let askedAtMs as InstantMs

	module static function create(inputs ProjectInputs, refusal StringArray, notice StringArray, trusted bool, resolved bool, stamp ProjectFileStamp, askedAtMs InstantMs) returns ProjectInputsAnswer
		return Self{inputs: inputs, refusal: refusal, notice: notice, trusted: trusted, resolved: resolved, stamp: stamp, askedAtMs: askedAtMs}
	end 'create'

	module function whilePending() returns ProjectInputsAnswer
		return Self{inputs: self.inputs.clone(), refusal: self.refusal.clone(), notice: self.notice.clone(), trusted: self.trusted, resolved: false, stamp: self.stamp.clone(), askedAtMs: self.askedAtMs}
	end 'whilePending'

	module function isSettled() returns bool
		return match self.inputs 'inputs'
			walked or
			listed or
			ambiguous gives true
			unbuilt or
			refused gives false
		end 'inputs'
	end 'isSettled'

	module function withStamp(renewed ProjectFileStamp) returns ProjectInputsAnswer
		return Self{inputs: self.inputs.clone(), refusal: self.refusal.clone(), notice: self.notice.clone(), trusted: self.trusted, resolved: self.resolved, stamp: renewed, askedAtMs: self.askedAtMs}
	end 'withStamp'

	module function stillAnswers(current ProjectFileStamp, askerTrusts bool) returns StampCurrency
		if self.trusted != askerTrusts 'trustChanged'
			return StampCurrency.outdated
		end 'trustChanged'

		if not self.isSettled() and Clock.elapsedMs(self.askedAtMs) >= UnresolvedProjectRetryMs 'unsettledAndExpired'
			return StampCurrency.outdated
		end 'unsettledAndExpired'

		return stampCurrency(self.stamp, current: current)
	end 'stillAnswers'

	module function answersTheRequestFor(current ProjectFileStamp, askerTrusts bool) returns bool
		return self.trusted == askerTrusts and stampHolds(self.stamp, current: current)
	end 'answersTheRequestFor'
end 'ProjectInputsAnswer'

union HeldProjectInputs
	nothingAsked
	asked(answer ProjectInputsAnswer)
end 'HeldProjectInputs'

union RequestedInputs
	noRequest
	requested(provisional ProjectInputsAnswer, ticket ResolutionTicket)
end 'RequestedInputs'

union InputsDecision
	settled(answer ProjectInputsAnswer)
	needsARun(provisional ProjectInputsAnswer)
end 'InputsDecision'

type ProjectInputsMemo
	var held as HeldProjectInputs
	var requested as RequestedInputs

	static function create() returns ProjectInputsMemo
		return Self{held: HeldProjectInputs.nothingAsked, requested: RequestedInputs.noRequest}
	end 'create'

	function answerFor(dir FilePath, workspace LspWorkspaceState) returns ProjectInputsAnswer
		let current = projectFileStampIn(dir)

		match self.reusable(current, trusted: workspace.trusted) 'reusable'
			asked(answer) then return answer
			nothingAsked then break
		end 'reusable'

		match self.outstanding(current, trusted: workspace.trusted) 'outstanding'
			requested(provisional, _) then return self.shownMeanwhile(provisional)
			noRequest then break
		end 'outstanding'

		return self.decided(dir, current: current, workspace: workspace)
	end 'answerFor'

	function previousInputStamps() returns DeclaredInputStamps
		return match self.held 'held'
			nothingAsked gives DeclaredInputStamps.create()
			asked(answer) gives inputStampsOfStamp(answer.stamp)
		end 'held'
	end 'previousInputStamps'

	function reusable(current ProjectFileStamp, trusted bool) returns HeldProjectInputs
		return match self.held 'held'
			nothingAsked gives HeldProjectInputs.nothingAsked
			asked(answer) gives self.reused(answer, current: current, trusted: trusted)
		end 'held'
	end 'reusable'

	function reused(answer ProjectInputsAnswer, current ProjectFileStamp, trusted bool) returns HeldProjectInputs
		return match answer.stillAnswers(current, askerTrusts: trusted) 'currency'
			outdated gives HeldProjectInputs.nothingAsked
			vouched gives HeldProjectInputs.asked(answer)
			refreshed(stamp) gives self.renewed(answer.withStamp(stamp.clone()))
		end 'currency'
	end 'reused'

	function renewed(answer ProjectInputsAnswer) returns HeldProjectInputs
		self.held = HeldProjectInputs.asked(answer.clone())

		return HeldProjectInputs.asked(answer)
	end 'renewed'

	function outstanding(current ProjectFileStamp, trusted bool) returns RequestedInputs
		return match self.requested 'requested'
			noRequest gives RequestedInputs.noRequest
			requested(provisional, ticket) gives requestWhileCurrent(provisional, ticket: ticket, current: current, trusted: trusted)
		end 'requested'
	end 'outstanding'

	function shownMeanwhile(provisional ProjectInputsAnswer) returns ProjectInputsAnswer
		return match self.held 'held'
			nothingAsked gives provisional
			asked(answer) gives answer.whilePending()
		end 'held'
	end 'shownMeanwhile'

	function decided(dir FilePath, current ProjectFileStamp, workspace LspWorkspaceState) returns ProjectInputsAnswer
		match decisionFor(dir, stamp: current, trusted: workspace.trusted) 'decision'
			settled(answer) then return self.settle(answer)
			needsARun(provisional) then return self.request(dir, provisional: provisional, workspace: workspace)
		end 'decision'
	end 'decided'

	function settle(answer ProjectInputsAnswer) returns ProjectInputsAnswer
		self.held = HeldProjectInputs.asked(answer.clone())
		self.requested = RequestedInputs.noRequest

		return answer
	end 'settle'

	function request(dir FilePath, provisional ProjectInputsAnswer, workspace LspWorkspaceState) returns ProjectInputsAnswer
		let ticket = workspace.requestResolution(dir)
		self.requested = RequestedInputs.requested(provisional.clone(), ticket: ticket)

		return self.shownMeanwhile(provisional)
	end 'request'

	// A reply carrying any ticket but the awaited one answers a request made before the stamp or the
	// trust last changed, or before this root was released and held afresh, and is dropped.
	function hold(answer ProjectInputsAnswer, ticket ResolutionTicket) returns bool
		if not self.awaits(ticket) 'superseded'
			return false
		end 'superseded'

		self.held = HeldProjectInputs.asked(answer)
		self.requested = RequestedInputs.noRequest

		return true
	end 'hold'

	function isAwaitingResolution() returns bool
		return match self.requested 'requested'
			noRequest gives false
			requested gives true
		end 'requested'
	end 'isAwaitingResolution'

	function awaits(ticket ResolutionTicket) returns bool
		return match self.requested 'requested'
			noRequest gives false
			requested(_, awaited) gives awaited == ticket
		end 'requested'
	end 'awaits'
end 'ProjectInputsMemo'

function requestWhileCurrent(provisional ProjectInputsAnswer, ticket ResolutionTicket, current ProjectFileStamp, trusted bool) returns RequestedInputs
	if not provisional.answersTheRequestFor(current, askerTrusts: trusted) 'outdated'
		return RequestedInputs.noRequest
	end 'outdated'

	return RequestedInputs.requested(provisional, ticket: ticket)
end 'requestWhileCurrent'

let UntrustedProjectNotice = "this project's source list applies once the workspace is trusted; until then the project is its directory"

function decisionFor(dir FilePath, stamp ProjectFileStamp, trusted bool) returns InputsDecision
	var voice = ManifestVoice.forEditor(LspServerCommandName)
	let need = projectNeedsARun(dir, voice: voice)

	if not trusted 'neverRunsTheProjectFile'
		return InputsDecision.settled(ProjectInputsAnswer.create(ProjectInputs.walked, refusal: StringArray.create(), notice: untrustedNoticeFor(need), trusted: false, resolved: true, stamp: stamp, askedAtMs: Clock.nowMs()))
	end 'neverRunsTheProjectFile'

	match need 'need'
		settled(inputs) then return InputsDecision.settled(answerFrom(inputs.clone(), voice: voice, stamp: stamp))
		needsARun then return InputsDecision.needsARun(ProjectInputsAnswer.create(ProjectInputs.walked, refusal: StringArray.create(), notice: StringArray.create(), trusted: true, resolved: false, stamp: stamp, askedAtMs: Clock.nowMs()))
	end 'need'
end 'decisionFor'

// The `.maxproj` and the previous run's inputs are stamped before the run and checked after it: a
// file edited during the run leaves the answer `unknown`, so the next ask runs it again rather than
// holding an answer about text that is gone. This run's inputs are known only once it ends, so they
// are digested after it. One the previous run did not declare has no digest from before, so a write
// to it during the run shows only as a modification time not settled before `started`.
module function resolvedProjectInputs(dir FilePath, previous DeclaredInputStamps) returns ProjectInputsAnswer
	let started = WallClock.nowUnixSeconds() as Timestamp
	let inputsBefore = declaredInputStampsOf(declaredPathsOf(previous), since: previous)
	let before = projectFileStampIn(dir)
	var voice = ManifestVoice.forEditor(LspServerCommandName)
	let inputs = projectInputs(dir, word: StatedText.unstated, severalTargets: SeveralTargets.holdEvery, voice: voice)
	let inputsAfter = declaredInputStampsOf(declaredInputsOf(inputs), since: DeclaredInputStamps.create())
	let settled = stampHolds(before, current: projectFileStampIn(dir)) and not inputsMovedBetween(inputsBefore, after: inputsAfter) and not unseenInputsModifiedSince(started, stamps: inputsAfter, seen: previous)

	return answerFrom(inputs, voice: voice, stamp: stampWithInputs(before, inputs: inputsAfter) if settled else ProjectFileStamp.unknown(inputsAfter))
end 'resolvedProjectInputs'

function answerFrom(inputs ProjectInputs, voice ManifestVoice, stamp ProjectFileStamp) returns ProjectInputsAnswer
	return ProjectInputsAnswer.create(inputs, refusal: refusalOf(inputs, voice: voice), notice: StringArray.create(), trusted: true, resolved: true, stamp: stamp, askedAtMs: Clock.nowMs())
end 'answerFrom'

function untrustedNoticeFor(need RunNeed) returns StringArray
	var notice = StringArray.create()

	match need 'need'
		needsARun then notice.push(UntrustedProjectNotice)
		settled then break
	end 'need'

	return notice
end 'untrustedNoticeFor'

function refusalOf(inputs ProjectInputs, voice ManifestVoice) returns StringArray
	return match inputs 'inputs'
		refused gives voice.asOneMessage()
		walked or
		listed or
		ambiguous or
		unbuilt gives StringArray.create()
	end 'inputs'
end 'refusalOf'

function maxonSourcesIn(dir FilePath, selection SourceSelection) returns SourceSweep
	var sources = MaxonSourcePathArray.create()

	_ = try collectMaxonSources(dir, into: sources, selection: selection, nestedProjects: NestedProjectRule.pruned) otherwise return SourceSweep.walkFailed

	return SourceSweep.swept(sources)
end 'maxonSourcesIn'

// ⚠ The tier test comes first, and a library file must never reach the project-file climb: a `stdlib/`
// file climbing for a `.maxproj` would root its project at whatever tree the tier sits in and sweep
// every source in it to answer one jump.
//
// This function only finds the `.maxproj` that marks a project; which files the project holds is
// `projectSourcesIn`'s answer. A `.maxtasks` beside it marks nothing.
module function workspaceRootOf(reader LspReaderSearch, purpose RootPurpose) returns WorkspaceRoot
	match reader.tier 'tier'
		inTier(dir) then return WorkspaceRoot.libraryTier(dir)
		outside then break
	end 'tier'

	if isAProgramOfItsOwn(reader.document.path.filename(), purpose: purpose) 'aProgramOfItsOwn'
		return WorkspaceRoot.singleFile
	end 'aProgramOfItsOwn'

	return match reader.document.directory 'directory'
		at(dir) gives rootAround(reader.document, directory: dir, workingDirectory: reader.workingDirectory)
		none gives WorkspaceRoot.singleFile
	end 'directory'
end 'workspaceRootOf'

function isAProgramOfItsOwn(name String, purpose RootPurpose) returns bool
	return match purpose 'purpose'
		readsTheDocument gives isDriverFileName(name)
		loadsTheProject gives isTaskFileName(name)
	end 'purpose'
end 'isAProgramOfItsOwn'

function tierHolding(document ReaderDocument, tiers LibraryTiers) returns TierMembership
	if document.normalized.isInside(tiers.normalizedStdlibDir) 'aStdlibFile'
		return TierMembership.inTier(tiers.stdlibDir)
	end 'aStdlibFile'

	if document.normalized.isInside(tiers.normalizedRuntimeDir) 'aRuntimeFile'
		return TierMembership.inTier(tiers.runtimeDir)
	end 'aRuntimeFile'

	return TierMembership.outside
end 'tierHolding'

function rootAround(document ReaderDocument, directory FilePath, workingDirectory FilePath) returns WorkspaceRoot
	return match nearestProjectFile(directory.resolve(workingDirectory), ceiling: document.climbCeiling) 'manifest'
		found(projectFile) gives projectRootAt(directoryHoldingProjectFile(projectFile))
		none gives WorkspaceRoot.singleFile
	end 'manifest'
end 'rootAround'

function directoryHoldingProjectFile(projectFile FilePath) returns FilePath
	return try projectFile.parent() otherwise panic("directoryHoldingProjectFile: '{projectFile.toString()}' was found by listing a directory, so that directory holds it")
end 'directoryHoldingProjectFile'

module union ProjectLayout
	nestedIn(outer FilePath)
	standsAlone
end 'ProjectLayout'

module function projectLayoutOf(reader LspReaderSearch) returns ProjectLayout
	let document = reader.document.path.resolve(reader.workingDirectory)

	if not isProjectFileName(document.filename()) 'notAProjectFile'
		return ProjectLayout.standsAlone
	end 'notAProjectFile'

	return match projectFileEnclosing(document) 'enclosing'
		found(outer) gives ProjectLayout.nestedIn(outer)
		none gives ProjectLayout.standsAlone
	end 'enclosing'
end 'projectLayoutOf'

// A `.maxproj` at a volume root — `/`, `C:\`, or a `\\server\share` — would sweep the whole volume
// to answer one request on a single-threaded server, so a document under it is a single file.
function projectRootAt(dir FilePath) returns WorkspaceRoot
	return WorkspaceRoot.singleFile if isAVolumeRoot(dir) else WorkspaceRoot.projectDirectory(dir)
end 'projectRootAt'

function isAVolumeRoot(dir FilePath) returns bool
	_ = try dir.parent() otherwise return true

	return false
end 'isAVolumeRoot'

extension Project
	// ⛔ The pipeline stops at LEX plus SIGNATURES, and `queryAllModule` is never called here. Lexing and
	// folding signatures is what a name-to-file question actually needs; parse and merge cost more than
	// the two of them together and answer nothing asked here.
	function sweptOver(walk SourceSweep, request SweepRequest) returns SweptProject
		return match request 'request'
			reading(readerPath) gives self.sweptForReader(walk, readerPath: readerPath)
			loadingFor gives self.sweptForLoad(walk, request: request)
		end 'request'
	end 'sweptOver'

	function sweptForReader(walk SourceSweep, readerPath FilePath) returns SweptProject
		let reader = try self.refreshFromWalk(walk, readerPath: readerPath, unreadable: UnreadableSource.skipped) otherwise panic("sweptForReader: a corpus skips a source it cannot read, so its refresh refuses nothing")

		view signatures = try self.foldedSignatures() otherwise return SweptProject.unavailable

		return SweptProject.read(self, signatures: signatures, readerPath: reader)
	end 'sweptForReader'

	// Registers no reader: the document asking may be the `.maxproj` that marks this project, and as a
	// reader its declarations would fold into the project's signatures and its text could fail the fold.
	function sweptForLoad(walk SourceSweep, request SweepRequest) returns SweptProject
		try self.refreshWithoutReader(walk, request: request, unreadable: UnreadableSource.skipped) otherwise panic("sweptForLoad: a load skips a source it cannot read, so its refresh refuses nothing")

		_ = try self.foldedSignatures() otherwise return SweptProject.unavailable

		return SweptProject.loaded
	end 'sweptForLoad'

	function foldedSignatures() returns ProgramSignatures throws CompileError
		try lexEveryFileOnAPool(self)

		return try queryProgramSignatures(self)
	end 'foldedSignatures'

	module function refreshFromDisk(sources EditorSources, readerPath FilePath) returns DiskRefresh throws CompileError
		if not sources.root.equals(self.rootPath) 'rootMoved'
			return DiskRefresh.rerooted
		end 'rootMoved'

		if not sources.refusal.isEmpty() 'unresolved'
			return DiskRefresh.unresolved(sources.refusal)
		end 'unresolved'

		let walk = sources.sweep

		if not walkLists(walk, path: readerPath) 'notInTheBuild'
			return DiskRefresh.unlisted
		end 'notInTheBuild'

		return DiskRefresh.listed(try self.refreshFromWalk(walk, readerPath: readerPath, unreadable: UnreadableSource.refused))
	end 'refreshFromDisk'

	function refreshFromWalk(walk SourceSweep, readerPath FilePath, unreadable UnreadableSource) returns FilePath throws CompileError
		var kept = MaxonSourcePathSet.create()

		try self.keepWhatTheWalkLists(walk, kept: kept, unreadable: unreadable, request: SweepRequest.reading(readerPath))

		let reader = registeredSpellingOf(self, path: readerPath.resolve(Directory.currentPath()))
		kept.insert(reader)

		unregisterWhatTheWalkNoLongerLists(self, walk: walk, kept: kept)

		registerTheReader(self, readerPath: reader)

		return reader
	end 'refreshFromWalk'

	function refreshWithoutReader(walk SourceSweep, request SweepRequest, unreadable UnreadableSource) throws CompileError
		var kept = MaxonSourcePathSet.create()

		try self.keepWhatTheWalkLists(walk, kept: kept, unreadable: unreadable, request: request)

		unregisterWhatTheWalkNoLongerLists(self, walk: walk, kept: kept)
	end 'refreshWithoutReader'

	function keepWhatTheWalkLists(walk SourceSweep, kept MaxonSourcePathSet, unreadable UnreadableSource, request SweepRequest) throws CompileError
		// Seeded from the array the library loops index (`StdlibSource.growStdlibBodyDemand` and its two
		// siblings), so the keep-set and their domain cannot drift apart. `registerTheReader` names what
		// a library file missing from the corpus costs.
		for path in self.librarySourcePaths.clone() 'eachLibraryFile'
			try self.keptAndRefreshed(path, kept: kept, unreadable: unreadable)
		end 'eachLibraryFile'

		match walk 'walk'
			swept then break
			walkFailed then try refuseWhen(unreadable, failure: CompileError.directoryNotFound(self.rootPath))
		end 'walk'

		for path in sweptSourcesOf(walk) 'eachSource'
			// Kept because the walk listed it, not because it could be read: a file that will not open is
			// as often held by a save or a scanner as deleted. Only a path the walk no longer lists is
			// unregistered. Under `skipped` one file that will not open leaves the rest answering; a
			// project check refuses instead, as `maxon build` does. The reader is always `skipped`, because
			// the buffer's text stands in for it (`overlayUnsavedText`).
			try self.keptAndRefreshed(path, kept: kept, unreadable: UnreadableSource.skipped if isTheRequestsReader(request, path: path) else unreadable)
		end 'eachSource'
	end 'keepWhatTheWalkLists'

	function keptAndRefreshed(path FilePath, kept MaxonSourcePathSet, unreadable UnreadableSource) throws CompileError
		kept.insert(path)

		try loadOneSourceFileIfChanged(self, path: path) otherwise 'unread'
			try refuseWhen(unreadable, failure: CompileError.readError(path))
		end 'unread'
	end 'keptAndRefreshed'
end 'Project'

function isTheRequestsReader(request SweepRequest, path FilePath) returns bool
	return match request 'request'
		reading(readerPath) gives namesTheSameFile(path, other: readerPath)
		loadingFor gives false
	end 'request'
end 'isTheRequestsReader'

module union DiskRefresh
	listed(reader FilePath)
	unlisted
	unresolved(lines StringArray)
	rerooted
end 'DiskRefresh'

function walkLists(walk SourceSweep, path FilePath) returns bool
	match walk 'walk'
		swept(sources) then return pathIsAmong(sources, path: path)
		walkFailed then return true
	end 'walk'
end 'walkLists'

function pathIsAmong(sources MaxonSourcePathArray, path FilePath) returns bool
	for source in sources 'eachSource'
		if namesTheSameFile(source, other: path) 'theSameFile'
			return true
		end 'theSameFile'
	end 'eachSource'

	return false
end 'pathIsAmong'

enum UnreadableSource
	skipped
	refused
end 'UnreadableSource'

function refuseWhen(unreadable UnreadableSource, failure CompileError) throws CompileError
	match unreadable 'unreadable'
		skipped then return
		refused then throw failure
	end 'unreadable'
end 'refuseWhen'

function sweptSourcesOf(walk SourceSweep) returns MaxonSourcePathArray
	return match walk 'walk'
		swept(sources) gives sources
		walkFailed gives MaxonSourcePathArray.create()
	end 'walk'
end 'sweptSourcesOf'

function unregisterWhatTheWalkNoLongerLists(project Project, walk SourceSweep, kept MaxonSourcePathSet)
	match walk 'walk'
		swept then filesRemoved(project, paths: pathsTheSweepDropped(project, kept: kept))
		walkFailed then return
	end 'walk'
end 'unregisterWhatTheWalkNoLongerLists'

function pathsTheSweepDropped(project Project, kept MaxonSourcePathSet) returns MaxonSourcePathSet
	var dropped = MaxonSourcePathSet.create()

	for path in project.db.sourcePaths 'eachRegistered'
		if not kept.contains(path) 'noLongerSwept'
			dropped.insert(path)
		end 'noLongerSwept'
	end 'eachRegistered'

	return dropped
end 'pathsTheSweepDropped'

// Every visibility question is asked ON BEHALF OF a file, and a file the sweep never saw has no module
// directory, so the reader has to be in the corpus before the fold runs.
//
// ⛔ The corpus is asked first and the disk second. `fileChanged(…, "")` overwrites whatever is
// registered, and a library file blanked out of the corpus surfaces as a panic in another file
// entirely (see `loadLibrarySources`). The empty registration is for the one case that has no other
// answer: a path in no corpus entry that also cannot be read, which is an unsaved buffer or a uri a
// client invented.
function registerTheReader(project Project, readerPath FilePath)
	if project.db.sourceFiles.contains(readerPath) 'theCorpusAlreadyHoldsIt'
		return
	end 'theCorpusAlreadyHoldsIt'

	try loadOneSourceFileIfChanged(project, path: readerPath) otherwise 'noSuchFile'
		fileChanged(project, path: readerPath, content: "")
	end 'noSuchFile'
end 'registerTheReader'
