// The declarations of a whole PROJECT, for the editor features that have to look outside the buffer in
// front of the author: which file declares a name (`LspDefinition`) and which members a type publishes
// (`LspCompletion`), and which names `textDocument/publishDiagnostics` may not call undeclared.
// `LspDocumentProject` is the other half of the pair and answers about the buffer ALONE. A diagnostic is
// still CHECKED there and never here: this corpus is lexed and its declarations folded, never compiled,
// so it can say what a name means and never what is wrong with a program.
//
// ⚠ A document's project root is a ladder, and the ORDER of its rungs is the design.
// `workspaceRootOf` holds it: a library tier's file gets the tiers alone; otherwise the nearest
// ancestor holding a `build.maxon`, climbed no higher than the root the client named in
// `initialize`; then that client root, for a document inside it; then the document's own directory.
// The manifest climb is unbounded and this checkout carries a `build.maxon` at its own root, so a
// client root consulted after an uncapped climb would never decide anything — while one consulted
// before the climb would root a document under `<root>/sub/build.maxon` at `<root>`. A client that
// names no root leaves the climb and the document's own directory.
//
// ⚠ Answering `unavailable` costs a feature its cross-file half and leaves the in-buffer half standing,
// which is what an editor should see: fewer answers, never a refused request.
module union LspCorpus
	loaded(project Project, signatures ProgramSignatures, readerPath FilePath)
	unavailable
end 'LspCorpus'

module union LspClientRoot
	named(dir FilePath)
	unset
end 'LspClientRoot'

union WorkspaceRoot
	userDirectory(dir FilePath)
	libraryTierOnly
end 'WorkspaceRoot'

union ManifestDirectory
	found(dir FilePath)
	none
end 'ManifestDirectory'

// A held project and the source list it was built over. ⚠ The directory walk that takes that list
// runs only on a miss, or once `WorkspaceResweepIntervalMs` has passed: hover, definition and
// completion each ask for a corpus as fast as an editor can send, and a walk hoisted ahead of the
// held-project probe costs one per request with nothing failing to say so.
//
// The LIST is what goes stale — a file created on disk is invisible until the next walk, which is
// what the interval bounds, while a file's CONTENT is re-read every request.
// `tests/lsp/definition-notices-a-file-created-on-disk.test.maxon` holds the re-walk in place.
type HeldWorkspace
	let project as Project
	var sources as MaxonSourcePathArray
	var sweptAtMs as InstantMs

	static function create(project Project, sources MaxonSourcePathArray, sweptAtMs InstantMs) returns HeldWorkspace
		return Self{project: project, sources: sources, sweptAtMs: sweptAtMs}
	end 'create'

	function corpusFor(root WorkspaceRoot, readerPath FilePath) returns LspCorpus
		resweep(root)

		return self.project.sweptOver(self.sources, readerPath: readerPath)
	end 'corpusFor'

	function resweep(root WorkspaceRoot)
		if Clock.elapsedMs(self.sweptAtMs) < WorkspaceResweepIntervalMs 'sweptRecently'
			return
		end 'sweptRecently'

		self.sources = sourcesUnder(root)
		self.sweptAtMs = Clock.nowMs()
	end 'resweep'
end 'HeldWorkspace'

typealias HeldProjectMap = Map with (String, HeldWorkspace)
typealias HeldProjectKeyArray = Array with String

// Projects are held across requests because building one costs a sweep, a lex of every file and a
// signature fold. Eight rather than one: a jump from a user file into `stdlib/` and back crosses two
// roots, and a library file is keyed by its OWN path, so a cache of one turns every round trip into two
// cold rebuilds. Oldest out, so a session that wanders cannot grow the process without bound.
let HeldProjectCapacity = 8

let WorkspaceResweepIntervalMs = 1000 as DurationMs

var heldProjects = HeldProjectMap.create()
var heldProjectKeys = HeldProjectKeyArray.create()

var namedClientRoot = LspClientRoot.unset

module function lspRememberClientRoot(root LspClientRoot)
	namedClientRoot = root
end 'lspRememberClientRoot'

module function lspWorkspaceCorpus(readerPath FilePath) returns LspCorpus
	let tiers = try LibraryTiers.locate() otherwise return LspCorpus.unavailable

	return capturedCorpus(workspaceRootOf(readerPath, tiers: tiers), tiers: tiers, readerPath: readerPath)
end 'lspWorkspaceCorpus'

// The corpus a diagnostic may be corrected against, admitted only where the author has STATED the
// project: a root the client named in `initialize`, holding this document. Without one the ladder roots a
// document at its OWN DIRECTORY, so an unrelated neighbouring file would count as a sibling and could
// silence a real error about a name no part of the author's project declares. A library-tier document
// answers `unavailable` because its corpus is the two tiers the buffer compile already holds.
module function lspProjectCorpus(readerPath FilePath) returns LspCorpus
	if not clientNamedARootOver(readerPath) 'noStatedWorkspace'
		return LspCorpus.unavailable
	end 'noStatedWorkspace'

	let tiers = try LibraryTiers.locate() otherwise return LspCorpus.unavailable
	let root = workspaceRootOf(readerPath, tiers: tiers)

	return match root 'root'
		userDirectory gives capturedCorpus(root, tiers: tiers, readerPath: readerPath)
		libraryTierOnly gives LspCorpus.unavailable
	end 'root'
end 'lspProjectCorpus'

module function clientNamedARootOver(readerPath FilePath) returns bool
	return match namedClientRoot 'client'
		named(dir) gives readerPath.normalize().isInside(dir.normalize())
		unset gives false
	end 'client'
end 'clientNamedARootOver'

function capturedCorpus(root WorkspaceRoot, tiers LibraryTiers, readerPath FilePath) returns LspCorpus
	beginDiagnosticCapture()
	let corpus = sweptWorkspace(root, tiers: tiers, readerPath: readerPath)
	discardDiagnosticCapture()

	return corpus
end 'capturedCorpus'

function sweptWorkspace(root WorkspaceRoot, tiers LibraryTiers, readerPath FilePath) returns LspCorpus
	let compileRoot = compileRootOf(root, readerPath: readerPath)
	let key = compileRoot.toString()

	if heldProjects.contains(key) 'alreadySeenThisRoot'
		var held = try heldProjects.get(key) otherwise panic("sweptWorkspace: '{key}' was found among the held projects one line above")

		return held.corpusFor(root, readerPath: readerPath)
	end 'alreadySeenThisRoot'

	let project = try libraryTierProject(compileRoot, tiers: tiers, buffer: OpenBuffer.none) otherwise return LspCorpus.unavailable
	var fresh = HeldWorkspace.create(project, sources: sourcesUnder(root), sweptAtMs: Clock.nowMs())

	let corpus = fresh.corpusFor(root, readerPath: readerPath)

	match corpus 'outcome'
		loaded then rememberProject(key, held: fresh)
		unavailable then return LspCorpus.unavailable
	end 'outcome'

	return corpus
end 'sweptWorkspace'

function rememberProject(key String, held HeldWorkspace)
	heldProjects.upsert(key, value: held)
	heldProjectKeys.push(key)

	if heldProjectKeys.count() <= HeldProjectCapacity 'roomRemains'
		return
	end 'roomRemains'

	let oldest = try heldProjectKeys.remove(0) otherwise panic("rememberProject: the key list is over capacity, so it holds a first element")
	_ = heldProjects.remove(oldest)
end 'rememberProject'

function compileRootOf(root WorkspaceRoot, readerPath FilePath) returns FilePath
	return match root 'root'
		userDirectory(dir) gives dir
		libraryTierOnly gives readerPath
	end 'root'
end 'compileRootOf'

function sourcesUnder(root WorkspaceRoot) returns MaxonSourcePathArray
	return match root 'root'
		userDirectory(dir) gives maxonSourcesIn(dir)
		libraryTierOnly gives MaxonSourcePathArray.create()
	end 'root'
end 'sourcesUnder'

function maxonSourcesIn(dir FilePath) returns MaxonSourcePathArray
	var sources = MaxonSourcePathArray.create()

	_ = try collectMaxonSources(dir, into: sources, selection: SourceSelection.productionOnly) otherwise return MaxonSourcePathArray.create()

	return sources
end 'maxonSourcesIn'

// ⚠ The tier test comes FIRST, and a library file must never reach the manifest climb. The checkout
// this compiler is built from holds a `build.maxon` at its root, so a `stdlib/` file climbing for one
// would root its project at the whole checkout and sweep every source in the tree to answer one jump.
//
// `build.maxon` is used purely as a MARKER of where a project begins — it is never read and never run.
function workspaceRootOf(readerPath FilePath, tiers LibraryTiers) returns WorkspaceRoot
	let document = readerPath.normalize()

	if document.isInside(tiers.stdlibDir.normalize()) or document.isInside(tiers.runtimeDir.normalize()) 'aLibraryFile'
		return WorkspaceRoot.libraryTierOnly
	end 'aLibraryFile'

	let directory = try readerPath.parent() otherwise return WorkspaceRoot.libraryTierOnly

	return match nearestManifestDirectory(directory) 'manifest'
		found(dir) gives sweepableRoot(dir)
		none gives rootWithoutAManifest(document, directory: directory)
	end 'manifest'
end 'workspaceRootOf'

function rootWithoutAManifest(document FilePath, directory FilePath) returns WorkspaceRoot
	return match namedClientRoot 'client'
		named(dir) gives clientRootOver(document, dir: dir, directory: directory)
		unset gives sweepableRoot(directory)
	end 'client'
end 'rootWithoutAManifest'

// A document outside the root the client named is no part of that project. Rooting it there would
// build a corpus over an unrelated tree and answer confidently out of it, which is worse than the
// miss the document's own directory gives.
function clientRootOver(document FilePath, dir FilePath, directory FilePath) returns WorkspaceRoot
	if not document.isInside(dir.normalize()) 'outsideTheClientRoot'
		return sweepableRoot(directory)
	end 'outsideTheClientRoot'

	return sweepableRoot(dir)
end 'clientRootOver'

// A directory with no parent is a volume root — `/`, `C:\`, or a `\\server\share`. Rooting a
// project there sweeps the whole volume to answer one request, so a document sitting at one gets
// the library tiers instead.
function sweepableRoot(dir FilePath) returns WorkspaceRoot
	_ = try dir.parent() otherwise return WorkspaceRoot.libraryTierOnly

	return WorkspaceRoot.userDirectory(dir)
end 'sweepableRoot'

function nearestManifestDirectory(directory FilePath) returns ManifestDirectory
	var current = directory.resolve(Directory.currentPath()).clone()

	while true 'upwards'
		if File.exists(current.join("{BuildManifestFileName}")) 'holdsAManifest'
			return ManifestDirectory.found(current)
		end 'holdsAManifest'

		if climbReachedTheClientRoot(current) 'noHigher'
			break
		end 'noHigher'

		let above = try current.parent() otherwise 'atTheRoot'
			break
		end 'atTheRoot'

		current = above
	end 'upwards'

	return ManifestDirectory.none
end 'nearestManifestDirectory'

function climbReachedTheClientRoot(current FilePath) returns bool
	return match namedClientRoot 'client'
		named(dir) gives current.normalize().equals(dir.normalize())
		unset gives false
	end 'client'
end 'climbReachedTheClientRoot'

extension Project
	// ⛔ The pipeline stops at LEX plus SIGNATURES, and `queryAllModule` is never called here. Two
	// reasons, and either alone would be enough.
	//
	// It is WRONG to call: `QueryEngine`'s merged-module memo hands back a module the last compile's
	// passes rewrote in place, and re-serving one invented diagnostics against a program that had none
	// and then crashed. That memo's own header owns the rule; a long-lived `Project` answering many
	// requests is exactly the shape that trips it.
	//
	// It is also the expensive half. Lexing and folding signatures is what a name-to-file question
	// actually needs; parse and merge cost more than the two of them together and answer nothing asked
	// here.
	module function sweptOver(sources MaxonSourcePathArray, readerPath FilePath) returns LspCorpus
		for path in sources 'eachSource'
			try loadOneSourceFileIfChanged(self, path: path) otherwise return LspCorpus.unavailable
		end 'eachSource'

		let reader = corpusSpellingOf(self, reader: readerPath.resolve(Directory.currentPath()).normalize())
		registerTheReader(self, readerPath: reader)

		var pool = FrontEndPool.create()

		try pool.lexEveryFile(self) otherwise 'lexingFailed'
			pool.close(self)
			return LspCorpus.unavailable
		end 'lexingFailed'

		pool.close(self)

		let signatures = try queryProgramSignatures(self) otherwise return LspCorpus.unavailable
		return LspCorpus.loaded(self, signatures: signatures, readerPath: reader)
	end 'sweptOver'
end 'Project'

// The spelling this corpus already registered the reader's file under, which is not always the spelling
// the request arrived with. ⚠ `FilePath` compares case-insensitively on Windows, so `db.sourceFiles`
// holds ONE entry for two spellings — while `ProgramSignatures.moduleDirectoryOfPathText` is keyed by
// exact path TEXT and PANICS on a miss. A visibility question asked on behalf of the other spelling
// would take the server down.
function corpusSpellingOf(project Project, reader FilePath) returns FilePath
	for registered in project.db.sourcePaths 'eachRegistered'
		if registered.equals(reader) 'theSameFile'
			return registered
		end 'theSameFile'
	end 'eachRegistered'

	return reader
end 'corpusSpellingOf'

// Every visibility question is asked ON BEHALF OF a file, and a file the sweep never saw has no module
// directory, so the reader has to be in the corpus before the fold runs.
//
// ⛔ The CORPUS is asked first and the disk second. `fileChanged(…, "")` overwrites whatever is
// registered, and a tier sweep contributes no sources of its own — so keying this off sweep membership
// blanks a `stdlib/` reader's own file out of the corpus it is reading from, and a library file missing
// from the corpus surfaces as a panic in another file entirely (see `loadLibrarySources`). The empty
// registration is for the one case that has no other answer: a path in no corpus entry that also cannot
// be read, which is an unsaved buffer or a uri a client invented.
function registerTheReader(project Project, readerPath FilePath)
	if project.db.sourceFiles.contains(readerPath) 'theCorpusAlreadyHoldsIt'
		return
	end 'theCorpusAlreadyHoldsIt'

	try loadOneSourceFileIfChanged(project, path: readerPath) otherwise 'noSuchFile'
		fileChanged(project, path: readerPath, content: "")
	end 'noSuchFile'
end 'registerTheReader'
