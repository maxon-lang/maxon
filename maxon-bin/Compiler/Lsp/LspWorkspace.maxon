// The declarations of a whole PROJECT, for the editor features that have to look outside the buffer in
// front of the author: which file declares a name (`LspDefinition`) and which members a type publishes
// (`LspCompletion`), and which names `textDocument/publishDiagnostics` may not call undeclared.
// `LspDocumentProject` is the other half of the pair and answers about the buffer ALONE. A diagnostic is
// still CHECKED there and never here: this corpus is lexed and its declarations folded, never compiled,
// so it can say what a name means and never what is wrong with a program.
//
// A document's project root is a ladder, and the ORDER of its rungs is the design. `workspaceRootOf`
// holds it: a library tier's file gets the tiers alone; otherwise the nearest ancestor holding a
// `project.maxon`, climbed no higher than the nearest client-named root that holds this document; then
// that named root, for a document inside it; then the document's own directory. The manifest climb is
// unbounded, and a directory ABOVE the one the client opened may hold a `project.maxon` of its own, so a
// named root consulted after an uncapped climb would decide nothing, while one consulted before the
// climb would root a document under `<root>/sub/project.maxon` at `<root>`. Capping the climb is what
// leaves both rungs right. A client that names no root leaves the climb and the document's own directory.
//
// The named roots change mid-session: `workspace/didChangeWorkspaceFolders` adds and removes them, and
// a removed root takes every project held under it. The sweep under a root is never pruned at a nested
// `project.maxon` — the build system has no nested projects, so two projects are siblings.
//
// ⚠ Answering `unavailable` costs a feature its cross-file half and leaves the in-buffer half standing,
// which is what an editor should see: fewer answers, never a refused request.
module union LspCorpus
	loaded(project Project, signatures ProgramSignatures, readerPath FilePath)
	unavailable
end 'LspCorpus'

module typealias LspClientRootArray = Array with FilePath

module typealias LspProjectFileCount = int(0 to u64.max)

module union LspProjectFacts
	swept(root FilePath, fileCount LspProjectFileCount)
	unswept(root FilePath)
	singleFile(path FilePath)
	unlocated
end 'LspProjectFacts'

union StatedRoot
	named(dir FilePath)
	unnamed
end 'StatedRoot'

module union LspRootSearch
	ready(tiers LibraryTiers, workingDirectory FilePath)
	unavailable
end 'LspRootSearch'

union DocumentDirectory
	at(dir FilePath)
	none
end 'DocumentDirectory'

type ReaderDocument
	module let path as FilePath
	module let normalized as FilePath
	module let stated as StatedRoot
	module let directory as DocumentDirectory

	static function of(readerPath FilePath) returns ReaderDocument
		let normalized = readerPath.normalize()

		return Self{path: readerPath, normalized: normalized, stated: nearestNamedRootOver(normalized), directory: directoryHolding(readerPath)}
	end 'of'
end 'ReaderDocument'

// A uri that carries no `://` is kept verbatim, so `untitled:Untitled-1` arrives here as a path. A
// path with no directory above it is not a place: the document gets no project rather than one
// rooted at the uri's own text. The test is the parent and not the uri's scheme, because a library
// file has a real directory and keeps its project while an unsaved buffer keeps the library tiers.
function directoryHolding(path FilePath) returns DocumentDirectory
	let dir = try path.parent() otherwise return DocumentDirectory.none

	return DocumentDirectory.at(dir)
end 'directoryHolding'

union WorkspaceRoot
	userDirectory(dir FilePath)
	libraryTierOnly
end 'WorkspaceRoot'

union ManifestDirectory
	found(dir FilePath)
	none
end 'ManifestDirectory'

// A walk that could not list a directory answers `walkFailed`, never an empty list: the sweep's
// result is what decides which files are unregistered, and one folder that cannot be listed — a
// branch switch, a build in the same tree, a denied ACL — would otherwise unregister every file
// of the project.
union SourceSweep
	swept(sources MaxonSourcePathArray)
	walkFailed
end 'SourceSweep'

// A held project and the source list it was built over. ⚠ The directory walk that takes that list
// runs only on a miss, or once `WorkspaceResweepIntervalMs` has passed: hover, definition and
// completion each ask for a corpus as fast as an editor can send, and a walk hoisted ahead of the
// held-project probe costs one per request with nothing failing to say so.
//
// A file created on disk and a file deleted from it are both noticed at that walk and not before,
// while a file's content is re-read every request.
//
// `tests/lsp/definition-notices-a-file-created-on-disk.test.maxon` holds the re-walk in place.
type HeldWorkspace
	let project as Project
	module var sweep as SourceSweep
	var sweptAtMs as InstantMs

	static function create(project Project, sweep SourceSweep, sweptAtMs InstantMs) returns HeldWorkspace
		return Self{project: project, sweep: sweep, sweptAtMs: sweptAtMs}
	end 'create'

	function corpusFor(root WorkspaceRoot, readerPath FilePath) returns LspCorpus
		resweep(root)

		return self.project.sweptOver(self.sweep, readerPath: readerPath)
	end 'corpusFor'

	function resweep(root WorkspaceRoot)
		if sweepIsFresh() 'sweptRecently'
			return
		end 'sweptRecently'

		let walk = sourcesUnder(root)

		match walk 'walk'
			swept then holdCompletedWalk(walk)
			walkFailed then return
		end 'walk'
	end 'resweep'

	function sweepIsFresh() returns bool
		return match self.sweep 'sweep'
			swept gives Clock.elapsedMs(self.sweptAtMs) < WorkspaceResweepIntervalMs
			walkFailed gives false
		end 'sweep'
	end 'sweepIsFresh'

	function holdCompletedWalk(walk SourceSweep)
		self.sweep = walk
		self.sweptAtMs = Clock.nowMs()
	end 'holdCompletedWalk'
end 'HeldWorkspace'

typealias HeldProjectMap = Map with (String, HeldWorkspace)
typealias HeldProjectKeyArray = Array with String

// Projects are held across requests because building one costs a sweep, a lex of every file and a
// signature fold. Eight rather than one: a jump from a user file into `stdlib/` and back crosses two
// roots, and a library file is keyed by its OWN path, so a cache of one turns every round trip into two
// cold rebuilds. Least recently used out, so a session that wanders cannot grow the process without
// bound and the root the author is working in is not evicted by a detour through the library.
// Overflowing this costs a re-fold rather than a re-read: a rebuilt `Project` still hits `QueryEngine`'s
// process-wide file memos.
let HeldProjectCapacity = 8

let WorkspaceResweepIntervalMs = 1000 as DurationMs

let ProjectLoadingMethod = "maxon/projectLoading"
let ProjectLoadingKey = "loading"

var heldProjects = HeldProjectMap.create()
var heldProjectKeys = HeldProjectKeyArray.create()

var namedClientRoots = LspClientRootArray.create()

module function lspRememberClientRoots(roots LspClientRootArray)
	namedClientRoots = LspClientRootArray.create()

	for root in roots 'eachRoot'
		rememberOneClientRoot(root)
	end 'eachRoot'
end 'lspRememberClientRoots'

module function lspChangeClientRoots(added LspClientRootArray, removed LspClientRootArray)
	for root in removed 'eachRemoved'
		forgetClientRoot(root)
	end 'eachRemoved'

	for root in added 'eachAdded'
		rememberOneClientRoot(root)
	end 'eachAdded'
end 'lspChangeClientRoots'

function rememberOneClientRoot(root FilePath)
	let dir = root.normalize()

	if namedRootsHold(dir) 'alreadyNamed'
		return
	end 'alreadyNamed'

	namedClientRoots.push(dir)
end 'rememberOneClientRoot'

function namedRootsHold(dir FilePath) returns bool
	for existing in namedClientRoots 'eachRoot'
		if existing.equals(dir) 'theSameRoot'
			return true
		end 'theSameRoot'
	end 'eachRoot'

	return false
end 'namedRootsHold'

function forgetClientRoot(root FilePath)
	let dir = root.normalize()
	var kept = LspClientRootArray.create()

	for existing in namedClientRoots 'eachRoot'
		if not existing.equals(dir) 'staysNamed'
			kept.push(existing)
		end 'staysNamed'
	end 'eachRoot'

	namedClientRoots = kept

	dropHeldProjectsUnder(dir)
end 'forgetClientRoot'

// A root is dropped in two places or not at all: the named-root list, and the projects already built
// under it. Nothing but capacity expires a held project, so one left behind outlives the folder the
// author closed.
function dropHeldProjectsUnder(dir FilePath)
	var kept = HeldProjectKeyArray.create()

	for key in heldProjectKeys 'eachKey'
		if heldProjectIsUnder(key, dir: dir) 'goesWithTheFolder'
			_ = heldProjects.remove(key)
		end 'goesWithTheFolder' else 'staysHeld'
			kept.push(key)
		end 'staysHeld'
	end 'eachKey'

	heldProjectKeys = kept
end 'dropHeldProjectsUnder'

function heldProjectIsUnder(key String, dir FilePath) returns bool
	let held = try FilePath.from(key) otherwise return false

	return held.normalize().isInside(dir)
end 'heldProjectIsUnder'

// Both halves are a filesystem probe and neither varies with the document, so it is made once per
// answer and handed down: `listProjectsAnswer`'s walk over the open documents would otherwise pay
// for both once per document.
module function lspRootSearch() returns LspRootSearch
	let tiers = try LibraryTiers.locate() otherwise return LspRootSearch.unavailable

	return LspRootSearch.ready(tiers, workingDirectory: Directory.currentPath())
end 'lspRootSearch'

// The directory test comes before the search, which answers `singleFile` with no ladder when the
// filesystem could not be probed and would file a path-less document under its own uri text.
module function lspProjectFactsOf(readerPath FilePath, search LspRootSearch) returns LspProjectFacts
	let document = ReaderDocument.of(readerPath)

	return match document.directory 'directory'
		at gives locatedFacts(document, search: search)
		none gives LspProjectFacts.unlocated
	end 'directory'
end 'lspProjectFactsOf'

function locatedFacts(document ReaderDocument, search LspRootSearch) returns LspProjectFacts
	return match search 'search'
		ready(tiers, workingDirectory) gives factsUnderTheRootOf(document, tiers: tiers, workingDirectory: workingDirectory)
		unavailable gives LspProjectFacts.singleFile(document.path)
	end 'search'
end 'locatedFacts'

function factsUnderTheRootOf(document ReaderDocument, tiers LibraryTiers, workingDirectory FilePath) returns LspProjectFacts
	let root = workspaceRootOf(document, tiers: tiers, workingDirectory: workingDirectory)

	return match root 'root'
		userDirectory gives heldProjectFacts(root, readerPath: document.path)
		libraryTierOnly gives LspProjectFacts.singleFile(document.path)
	end 'root'
end 'factsUnderTheRootOf'

// The key is `compileRootOf`'s answer, which is the derivation `sweptWorkspace` files a project under. A
// second spelling of it here reads a miss for every root and reports every project unswept, with nothing
// failing to say so.
function heldProjectFacts(root WorkspaceRoot, readerPath FilePath) returns LspProjectFacts
	let compileRoot = compileRootOf(root, readerPath: readerPath)
	let held = try heldProjects.get(compileRoot.toString()) otherwise return LspProjectFacts.unswept(compileRoot)

	return match held.sweep 'sweep'
		swept(sources) gives LspProjectFacts.swept(compileRoot, fileCount: sources.count() as LspProjectFileCount)
		walkFailed gives LspProjectFacts.unswept(compileRoot)
	end 'sweep'
end 'heldProjectFacts'

module function lspDocumentCorpus(uri String) returns LspCorpus
	let readerPath = try lspDocumentPathOrThrow(uri) otherwise return LspCorpus.unavailable
	let document = ReaderDocument.of(readerPath)

	return match lspRootSearch() 'search'
		ready(tiers, workingDirectory) gives capturedCorpus(workspaceRootOf(document, tiers: tiers, workingDirectory: workingDirectory), tiers: tiers, readerPath: readerPath)
		unavailable gives LspCorpus.unavailable
	end 'search'
end 'lspDocumentCorpus'

// The corpus a diagnostic may be corrected against, admitted only where the author has STATED the
// project: a root the client named, holding this document. Without one the ladder roots a document at
// its OWN DIRECTORY, so an unrelated neighbouring file would count as a sibling and could silence a real
// error about a name no part of the author's project declares. A library-tier document answers
// `unavailable` because its corpus is the two tiers the buffer compile already holds.
module function lspProjectCorpus(readerPath FilePath) returns LspCorpus
	let document = ReaderDocument.of(readerPath)

	return match document.stated 'stated'
		named gives statedProjectCorpus(document)
		unnamed gives LspCorpus.unavailable
	end 'stated'
end 'lspProjectCorpus'

function statedProjectCorpus(document ReaderDocument) returns LspCorpus
	return match lspRootSearch() 'search'
		ready(tiers, workingDirectory) gives statedRootCorpus(document, tiers: tiers, workingDirectory: workingDirectory)
		unavailable gives LspCorpus.unavailable
	end 'search'
end 'statedProjectCorpus'

function statedRootCorpus(document ReaderDocument, tiers LibraryTiers, workingDirectory FilePath) returns LspCorpus
	let root = workspaceRootOf(document, tiers: tiers, workingDirectory: workingDirectory)

	return match root 'root'
		userDirectory gives capturedCorpus(root, tiers: tiers, readerPath: document.path)
		libraryTierOnly gives LspCorpus.unavailable
	end 'root'
end 'statedRootCorpus'

module function clientNamedARootOver(readerPath FilePath) returns bool
	return match nearestNamedRootOver(readerPath.normalize()) 'stated'
		named gives true
		unnamed gives false
	end 'stated'
end 'clientNamedARootOver'

function nearestNamedRootOver(document FilePath) returns StatedRoot
	var nearest = StatedRoot.unnamed

	for root in namedClientRoots 'eachRoot'
		nearest = nearerNamedRoot(nearest, candidate: root, document: document)
	end 'eachRoot'

	return nearest
end 'nearestNamedRootOver'

// A root that does not hold this document is never selected, not even as the only candidate. Rooting a
// document under a folder it sits outside builds a corpus over an unrelated tree and answers confidently
// out of it, which is worse than the miss the document's own directory gives.
function nearerNamedRoot(nearest StatedRoot, candidate FilePath, document FilePath) returns StatedRoot
	if not document.isInside(candidate) 'holdsNothingOfThisDocument'
		return nearest
	end 'holdsNothingOfThisDocument'

	if not candidateIsNearer(nearest, dir: candidate) 'noNearerThanTheOneHeld'
		return nearest
	end 'noNearerThanTheOneHeld'

	return StatedRoot.named(candidate)
end 'nearerNamedRoot'

function candidateIsNearer(nearest StatedRoot, dir FilePath) returns bool
	return match nearest 'nearest'
		named(held) gives dir.isInside(held)
		unnamed gives true
	end 'nearest'
end 'candidateIsNearer'

function capturedCorpus(root WorkspaceRoot, tiers LibraryTiers, readerPath FilePath) returns LspCorpus
	beginDiagnosticCapture()
	let corpus = sweptWorkspace(root, tiers: tiers, readerPath: readerPath)
	discardDiagnosticCapture()

	return corpus
end 'capturedCorpus'

function sweptWorkspace(root WorkspaceRoot, tiers LibraryTiers, readerPath FilePath) returns LspCorpus
	let compileRoot = compileRootOf(root, readerPath: readerPath)
	let key = compileRoot.toString()

	if heldProjects.contains(key) 'alreadySeenThisRoot'
		touchHeldProject(key)

		var held = try heldProjects.get(key) otherwise panic("sweptWorkspace: '{key}' was found among the held projects two lines above")

		return held.corpusFor(root, readerPath: readerPath)
	end 'alreadySeenThisRoot'

	writeProjectLoadingNotification(key, loading: true)
	let corpus = builtWorkspace(root, compileRoot: compileRoot, key: key, tiers: tiers, readerPath: readerPath)
	writeProjectLoadingNotification(key, loading: false)

	return corpus
end 'sweptWorkspace'

// Every return here passes through the one `loading: false` in `sweptWorkspace`; a return that
// skipped it would leave the client showing this project as loading for the rest of the session.
function builtWorkspace(root WorkspaceRoot, compileRoot FilePath, key String, tiers LibraryTiers, readerPath FilePath) returns LspCorpus
	let project = try libraryTierProject(compileRoot, tiers: tiers, buffer: OpenBuffer.none) otherwise return LspCorpus.unavailable
	var fresh = HeldWorkspace.create(project, sweep: sourcesUnder(root), sweptAtMs: Clock.nowMs())

	let corpus = fresh.corpusFor(root, readerPath: readerPath)

	match corpus 'outcome'
		loaded then rememberProject(key, held: fresh)
		unavailable then return LspCorpus.unavailable
	end 'outcome'

	return corpus
end 'builtWorkspace'

function writeProjectLoadingNotification(rootPath String, loading bool)
	var doc = JsonDoc.create()
	var params = LspJsonObject.create(doc)
	params.put(LspRootPathKey, value: JsonNode.stringNode(rootPath))
	params.put(ProjectLoadingKey, value: JsonNode.boolNode(loading))

	writeLspNotification(doc, method: ProjectLoadingMethod, params: params.finish())
end 'writeProjectLoadingNotification'

function rememberProject(key String, held HeldWorkspace)
	heldProjects.upsert(key, value: held)
	heldProjectKeys.push(key)

	if heldProjectKeys.count() <= HeldProjectCapacity 'roomRemains'
		return
	end 'roomRemains'

	let coldest = try heldProjectKeys.remove(0) otherwise panic("rememberProject: the key list is over capacity, so it holds a first element")
	_ = heldProjects.remove(coldest)
end 'rememberProject'

function touchHeldProject(key String)
	var kept = HeldProjectKeyArray.create()

	for existing in heldProjectKeys 'eachKey'
		if existing != key 'staysInOrder'
			kept.push(existing)
		end 'staysInOrder'
	end 'eachKey'

	kept.push(key)

	heldProjectKeys = kept
end 'touchHeldProject'

function compileRootOf(root WorkspaceRoot, readerPath FilePath) returns FilePath
	return match root 'root'
		userDirectory(dir) gives dir
		libraryTierOnly gives readerPath
	end 'root'
end 'compileRootOf'

function sourcesUnder(root WorkspaceRoot) returns SourceSweep
	return match root 'root'
		userDirectory(dir) gives maxonSourcesIn(dir)
		libraryTierOnly gives SourceSweep.swept(MaxonSourcePathArray.create())
	end 'root'
end 'sourcesUnder'

function maxonSourcesIn(dir FilePath) returns SourceSweep
	var sources = MaxonSourcePathArray.create()

	_ = try collectMaxonSources(dir, into: sources, selection: SourceSelection.productionOnly) otherwise return SourceSweep.walkFailed

	return SourceSweep.swept(sources)
end 'maxonSourcesIn'

// ⚠ The tier test comes FIRST, and a library file must never reach the manifest climb: a `stdlib/` file
// climbing for a manifest would root its project at whatever tree the tier sits in and sweep every source
// in it to answer one jump.
//
// `project.maxon` is used purely as a MARKER of where a project begins — it is never read and never run,
// and a `tasks.maxon` beside it marks nothing at all.
function workspaceRootOf(document ReaderDocument, tiers LibraryTiers, workingDirectory FilePath) returns WorkspaceRoot
	if document.normalized.isInside(tiers.stdlibDir.normalize()) or document.normalized.isInside(tiers.runtimeDir.normalize()) 'aLibraryFile'
		return WorkspaceRoot.libraryTierOnly
	end 'aLibraryFile'

	return match document.directory 'directory'
		at(dir) gives rootAround(document, directory: dir, workingDirectory: workingDirectory)
		none gives WorkspaceRoot.libraryTierOnly
	end 'directory'
end 'workspaceRootOf'

function rootAround(document ReaderDocument, directory FilePath, workingDirectory FilePath) returns WorkspaceRoot
	return match nearestManifestDirectory(directory, noHigherThan: document.stated, workingDirectory: workingDirectory) 'manifest'
		found(dir) gives sweepableRoot(dir)
		none gives rootWithoutAManifest(document.stated, directory: directory)
	end 'manifest'
end 'rootAround'

function rootWithoutAManifest(stated StatedRoot, directory FilePath) returns WorkspaceRoot
	return match stated 'stated'
		named(dir) gives sweepableRoot(dir)
		unnamed gives sweepableRoot(directory)
	end 'stated'
end 'rootWithoutAManifest'

// A directory with no parent is a volume root — `/`, `C:\`, or a `\\server\share`. Rooting a
// project there sweeps the whole volume to answer one request, so a document sitting at one gets
// the library tiers instead.
function sweepableRoot(dir FilePath) returns WorkspaceRoot
	_ = try dir.parent() otherwise return WorkspaceRoot.libraryTierOnly

	return WorkspaceRoot.userDirectory(dir)
end 'sweepableRoot'

function nearestManifestDirectory(directory FilePath, noHigherThan StatedRoot, workingDirectory FilePath) returns ManifestDirectory
	var current = directory.resolve(workingDirectory).clone()

	while true 'upwards'
		if File.exists(current.join("{ProjectManifestFileName}")) 'holdsAManifest'
			return ManifestDirectory.found(current)
		end 'holdsAManifest'

		if climbReachedTheStatedRoot(current, stated: noHigherThan) 'noHigher'
			break
		end 'noHigher'

		let above = try current.parent() otherwise 'atTheRoot'
			break
		end 'atTheRoot'

		current = above
	end 'upwards'

	return ManifestDirectory.none
end 'nearestManifestDirectory'

function climbReachedTheStatedRoot(current FilePath, stated StatedRoot) returns bool
	return match stated 'stated'
		named(dir) gives current.equals(dir)
		unnamed gives false
	end 'stated'
end 'climbReachedTheStatedRoot'

extension Project
	// ⛔ The pipeline stops at LEX plus SIGNATURES, and `queryAllModule` is never called here. Two
	// reasons, and either alone would be enough.
	//
	// It is WRONG to call: `QueryEngine`'s merged-module memo hands back a module the last compile's
	// passes rewrote in place, and re-serving one invented diagnostics against a program that had none
	// and then crashed. That memo's own header owns the rule; a long-lived `Project` answering many
	// requests is exactly the shape that trips it.
	//
	// It is also the expensive half. Lexing and folding signatures is what a name-to-file question
	// actually needs; parse and merge cost more than the two of them together and answer nothing asked
	// here.
	function sweptOver(walk SourceSweep, readerPath FilePath) returns LspCorpus
		var kept = MaxonSourcePathSet.create()

		// Seeded from the array the library loops index (`StdlibSource.growStdlibBodyDemand` and its two
		// siblings), so the keep-set and their domain cannot drift apart. `registerTheReader` names what
		// a library file missing from the corpus costs.
		for path in self.librarySourcePaths 'eachLibraryFile'
			kept.insert(path)
		end 'eachLibraryFile'

		for path in sweptSourcesOf(walk) 'eachSource'
			// Kept because the walk listed it, not because it could be read: a file that will not open is
			// as often held by a save or a scanner as deleted. Only a path the walk no longer lists is
			// unregistered, and one file that will not open leaves the rest of the corpus answering.
			kept.insert(path)

			try loadOneSourceFileIfChanged(self, path: path) otherwise ignore
		end 'eachSource'

		let reader = corpusSpellingOf(self, reader: readerPath.resolve(Directory.currentPath()))
		kept.insert(reader)

		unregisterWhatTheWalkNoLongerLists(self, walk: walk, kept: kept)

		registerTheReader(self, readerPath: reader)

		var pool = FrontEndPool.create()

		try pool.lexEveryFile(self) otherwise 'lexingFailed'
			pool.close(self)
			return LspCorpus.unavailable
		end 'lexingFailed'

		pool.close(self)

		let signatures = try queryProgramSignatures(self) otherwise return LspCorpus.unavailable
		return LspCorpus.loaded(self, signatures: signatures, readerPath: reader)
	end 'sweptOver'
end 'Project'

function sweptSourcesOf(walk SourceSweep) returns MaxonSourcePathArray
	return match walk 'walk'
		swept(sources) gives sources
		walkFailed gives MaxonSourcePathArray.create()
	end 'walk'
end 'sweptSourcesOf'

function unregisterWhatTheWalkNoLongerLists(project Project, walk SourceSweep, kept MaxonSourcePathSet)
	match walk 'walk'
		swept then filesRemoved(project, paths: pathsTheSweepDropped(project, kept: kept))
		walkFailed then return
	end 'walk'
end 'unregisterWhatTheWalkNoLongerLists'

function pathsTheSweepDropped(project Project, kept MaxonSourcePathSet) returns MaxonSourcePathSet
	var dropped = MaxonSourcePathSet.create()

	for path in project.db.sourcePaths 'eachRegistered'
		if not kept.contains(path) 'noLongerSwept'
			dropped.insert(path)
		end 'noLongerSwept'
	end 'eachRegistered'

	return dropped
end 'pathsTheSweepDropped'

// The spelling this corpus already registered the reader's file under, which is not always the spelling
// the request arrived with. ⚠ `FilePath` compares case-insensitively on Windows, so `db.sourceFiles`
// holds ONE entry for two spellings — while `ProgramSignatures.moduleDirectoryOfPathText` is keyed by
// exact path TEXT and PANICS on a miss. A visibility question asked on behalf of the other spelling
// would take the server down.
function corpusSpellingOf(project Project, reader FilePath) returns FilePath
	for registered in project.db.sourcePaths 'eachRegistered'
		if registered.equals(reader) 'theSameFile'
			return registered
		end 'theSameFile'
	end 'eachRegistered'

	return reader
end 'corpusSpellingOf'

// Every visibility question is asked ON BEHALF OF a file, and a file the sweep never saw has no module
// directory, so the reader has to be in the corpus before the fold runs.
//
// ⛔ The CORPUS is asked first and the disk second. `fileChanged(…, "")` overwrites whatever is
// registered, and a tier sweep contributes no sources of its own — so keying this off sweep membership
// blanks a `stdlib/` reader's own file out of the corpus it is reading from, and a library file missing
// from the corpus surfaces as a panic in another file entirely (see `loadLibrarySources`). The empty
// registration is for the one case that has no other answer: a path in no corpus entry that also cannot
// be read, which is an unsaved buffer or a uri a client invented.
function registerTheReader(project Project, readerPath FilePath)
	if project.db.sourceFiles.contains(readerPath) 'theCorpusAlreadyHoldsIt'
		return
	end 'theCorpusAlreadyHoldsIt'

	try loadOneSourceFileIfChanged(project, path: readerPath) otherwise 'noSuchFile'
		fileChanged(project, path: readerPath, content: "")
	end 'noSuchFile'
end 'registerTheReader'
