// `maxon/generateIR` — the Compiler Explorer panel's request: the Target IR a source text compiles to, or
// the errors that stopped it.
//
// ⭐ **THE COMPILE IS THE ONE DIAGNOSTICS RUNS, AND IT WRITES NOTHING TO DISK.** `lspDocumentProject`
// registers the text in memory and `CompileRun` stops at a `CodeResult`, so no executable and no
// `.ir` file lands in the author's workspace; the text is `renderTargetIr`'s, which is what `--emit-ir`
// writes.

let SourceKey = "source"
let FilenameKey = "filename"
let IrKey = "ir"
let ErrorsKey = "errors"
let IrErrorMessageKey = "message"
let IrErrorLineKey = "line"
let IrErrorColumnKey = "column"

// The panel shows positions to a reader, counting from 1; LSP's coordinates count from 0.
let ExplorerPositionBase = 1

module function generateIrAnswer(workspace LspWorkspaceState, incoming JsonDoc, params JsonNodeId) returns LspExtensionOutcome throws LspParamsError
	let source = try lspMemberText(incoming, of: params, key: SourceKey)
	let filename = try lspMemberText(incoming, of: params, key: FilenameKey)

	match lspDocumentOf(workspace, uri: filename) 'document'
		resolved(document) then return exploredOutcome(workspace, document: document, source: source)
		notAPath then throw LspParamsError.malformed
		unidentifiable(_, reason) then return LspExtensionOutcome.unidentifiable(reason)
	end 'document'
end 'generateIrAnswer'

function exploredOutcome(workspace LspWorkspaceState, document ReaderDocument, source String) returns LspExtensionOutcome
	return match lspDocumentReader(workspace, document: document) 'explorer'
		found(reader) gives generatedIr(workspace, reader: reader, source: source)
		unavailable gives LspExtensionOutcome.compilerUnavailable
	end 'explorer'
end 'exploredOutcome'

// ⭐ **EVERY DIAGNOSTIC IS REPORTED, INCLUDING A WHOLE-PROGRAM CLAIM.** Unlike an open document, the
// explorer's source IS the whole program, so "no `main`" is true of what the author wrote.
function generatedIr(workspace LspWorkspaceState, reader LspReaderSearch, source String) returns LspExtensionOutcome
	let path = lspBufferPathOf(reader)

	match checkOnDriver(workspace.driver, origin: lspDocumentOrigin(reader, text: source), inputPaths: MaxonSourcePathArray.create(0), target: detectHostTarget(), rendersTargetIr: true, reading: CheckedDiagnostics.asReported, session: DriverSession.discarding()) 'compile'
		checked(_, standing, irText) then return LspExtensionOutcome.answered(irAnswer(irText, diagnostics: standing, path: path, source: source))
		failed then return LspExtensionOutcome.compilerUnavailable
	end 'compile'
end 'generatedIr'

function irAnswer(ir String, diagnostics DiagnosticArray, path FilePath, source String) returns LspAnswer
	let doc = JsonDoc.create()
	let index = LspLineIndex.build(source)
	let tokens = lspDocumentTokens(source, keywords: KeywordTable.create())
	let errors = JsonNodeIdArray.create(diagnostics.count(), zeroed: false)

	for diagnostic in diagnostics 'each'
		errors.push(irErrorNode(doc, diagnostic: diagnostic, path: path, source: source, index: index, tokens: tokens))
	end 'each'

	let result = LspJsonObject.create(doc)
	result.put(IrKey, value: JsonNode.stringNode(ir))
	result.putNode(ErrorsKey, value: doc.add(JsonNode.arrayNode(errors)))
	return LspAnswer.of(doc, result: result.finish())
end 'irAnswer'

// A diagnostic located in another file has no position in the source the panel shows, so it is placed at
// the source's start and its message names where it really is.
function irErrorNode(doc JsonDoc, diagnostic Diagnostic, path FilePath, source String, index LspLineIndex, tokens TokenArray) returns JsonNodeId
	let inTheSource = reportsOn(diagnostic, path: path)
	let span = diagnosticSpan(diagnostic, source: source, index: index, tokens: tokens) if inTheSource else documentStartSpan()
	let message = diagnostic.message if inTheSource else elsewhereMessage(diagnostic)
	let start = index.positionOf(source, offset: span.startByte)

	let item = LspJsonObject.create(doc)
	item.put(IrErrorMessageKey, value: JsonNode.stringNode(message))
	item.put(IrErrorLineKey, value: JsonNode.numberNode((start.line + ExplorerPositionBase) as JsonFloat))
	item.put(IrErrorColumnKey, value: JsonNode.numberNode((start.character + ExplorerPositionBase) as JsonFloat))
	return item.finish()
end 'irErrorNode'

function elsewhereMessage(diagnostic Diagnostic) returns String
	return match diagnostic.anchor 'anchor'
		at(filePath, line, column) gives "{filePath}:{line}:{column}: {diagnostic.message}"
		file(filePath) gives "{filePath}: {diagnostic.message}"
		programWide panic("irErrorNode: a program-wide diagnostic reports on every document, so it is never placed as another file's")
	end 'anchor'
end 'elsewhereMessage'
