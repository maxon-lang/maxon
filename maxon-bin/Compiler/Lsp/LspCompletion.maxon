// `textDocument/completion` — what an editor offers after a `.`.
//
// ⭐⭐ **TWO SOURCES, AND WHICH ONE ANSWERS IS DECIDED BY WHERE THE TYPE IS DECLARED.** That split is the
// whole design of this file, and both halves are forced:
//
//   * **The OPEN BUFFER is read LEXICALLY.** A document being completed is mid-edit and in general does
//     not compile — every recovered fixture here is refused by `resolveTypes` before it has a type at all
//     (`returns int` is E3005, `var x int` is E2010) — so a receiver's type, and the members of a type the
//     buffer itself declares, are read off the token stream. A completion list that appears only for files
//     that already compile is a completion list that never appears.
//   * **EVERY OTHER TYPE IS READ FROM THE PROJECT'S OWN DECLARATIONS**, because the question that half
//     answers is not answerable by reading: *may this file NAME this member?* `stdlib/Array.maxon` declares `fillPublished`
//     without `public`, and offering it teaches an author to write a call that will not compile. The tier
//     and the declaring file are `ProgramSignatures`' own facts, asked through the one function that turns
//     a `Visibility` into an answer (`calleeVisibilityFrom`). ⛔ Re-deriving visibility by looking for the
//     word `public` in front of a declaration would be a second, shallower copy of the language's own
//     rule — the exact shape this project keeps paying for.
//
// ⚠ **THAT HALF IS A LEX AND A SIGNATURE FOLD, NEVER A MERGE.** `LspWorkspace` builds and holds it, and
// owns the rule that nothing on this path may reach `queryAllModule`. What the corpus holds for the open
// document is the file as it is ON DISK — it is a source like any other there — so an unsaved
// declaration is offered by the buffer half above and by nothing else.
//
// ⚠ The corpus is asked for the buffer's PATH as well as its members: a visibility question is asked on
// behalf of a file, and `ProgramSignatures.moduleDirectoryOf` panics for a path the sweep never saw.

let LabelKey = "label"
let TriggerCharactersKey = "triggerCharacters"

// The one character that raises this completion. It is also what makes the answer well-defined: this
// server completes a MEMBER of something, never an identifier prefix in open code.
let MemberAccessTrigger = "."

// LSP's `CompletionItemKind`. The protocol's own numbers; an editor draws an icon from them.
typealias LspCompletionKind = int(1 to 25)

let MethodCompletionKind = 2 as LspCompletionKind
let StaticFunctionCompletionKind = 3 as LspCompletionKind
let FieldCompletionKind = 5
let EnumMemberCompletionKind = 20

// `<Type>.<member>` — how every method is registered, and the only shape this file reads a roster by.
let CompletionMemberSeparator = "."

module function completionServedMethods() returns LspMethodArray
	var served = LspMethodArray.create(0)
	served.push(LspMethod.completion)
	return served
end 'completionServedMethods'

// This server's `CompletionOptions`. Declaring the trigger character is what makes an editor ask the
// moment a `.` is typed rather than only when the user asks for the list by hand.
module function completionCapabilityOptions(doc JsonDoc) returns JsonNodeId
	var triggers = JsonNodeIdArray.create(0)
	triggers.push(doc.add(JsonNode.stringNode(MemberAccessTrigger)))

	var options = LspJsonObject.create(doc)
	options.putNode(TriggerCharactersKey, value: doc.add(JsonNode.arrayNode(triggers)))
	return options.finish()
end 'completionCapabilityOptions'

module function completionAnswer(request LspRequest) returns LspAnswer throws LspParamsError
	if request.method != LspMethod.completion 'notThisArea'
		panic("completionAnswer: {lspMethodSpelling(request.method).wireName} is not this area's — `completionServedMethods` names the one method it answers")
	end 'notThisArea'

	let tokens = lspDocumentTokens(request.text, keywords: request.keywords)
	let index = LspLineIndex.build(request.text)
	let offset = index.offsetOf(request.text, position: try lspPositionMember(request.incoming, of: request.params, key: LspPositionKey))

	var doc = JsonDoc.create()
	let offers = offersAt(request.text, tokens: tokens, keywords: request.keywords, blocks: lspDocumentBlocks(tokens), offset: offset, uri: request.uri, workspace: request.workspace)
	var items = JsonNodeIdArray.create(offers.count(), zeroed: false)

	for offer in offers 'eachOffer'
		var item = LspJsonObject.create(doc)
		item.put(LabelKey, value: JsonNode.stringNode(offer.label))
		item.put(LspKindKey, value: JsonNode.numberNode(offer.kind as JsonFloat))
		items.push(item.finish())
	end 'eachOffer'

	return LspAnswer.of(doc, result: doc.add(JsonNode.arrayNode(items)))
end 'completionAnswer'

// One thing an editor may insert.
type CompletionOffer
	export let label as String
	export let kind as LspCompletionKind

	static function create(label String, kind LspCompletionKind) returns CompletionOffer
		return Self{label: label, kind: kind}
	end 'create'
end 'CompletionOffer'

typealias CompletionOfferArray = Array with CompletionOffer

// Which labels have already been offered. One member may be registered under several keys — an interface
// extension publishes a method the conformer also declares — and an editor showing a name twice is a list
// the author has to read twice.
typealias OfferedLabelSet = Set with String

// ⚠ The no-receiver rung comes first, and the order is a cost bound. A cursor following no `.` has
// nothing to offer whatever the project declares, and an editor fires completion on ordinary typing, so
// reaching a corpus build to answer an empty list puts a project sweep on every keystroke.
function offersAt(text String, tokens TokenArray, keywords KeywordTable, blocks LspDocumentBlockArray, offset ByteOffset, uri String, workspace LspWorkspaceState) returns CompletionOfferArray
	if not lspCursorFollowsAMemberAccess(tokens, offset: offset) 'nothingToComplete'
		return CompletionOfferArray.create(0)
	end 'nothingToComplete'

	let enclosing = lspEnclosingTypeAtCursor(tokens, blocks: blocks, offset: offset)
	let inTheBuffer = lspSubjectAt(text, tokens: tokens, keywords: keywords, offset: offset, corpus: LspCorpus.unavailable)

	if let bufferTypeName = try lspSubjectTypeName(inTheBuffer) 'aNamedSubject'
		if lspBlocksDeclareTheType(lspBlocksDeclaring(blocks, typeName: bufferTypeName)) 'aTypeThisBufferDeclares'
			return offersFor(inTheBuffer, tokens: tokens, blocks: blocks, corpus: LspCorpus.unavailable, enclosing: enclosing)
		end 'aTypeThisBufferDeclares'
	end 'aNamedSubject'

	var corpus = lspDocumentCorpus(workspace, uri: uri)

	return offersFor(lspSubjectAt(text, tokens: tokens, keywords: keywords, offset: offset, corpus: corpus), tokens: tokens, blocks: blocks, corpus: corpus, enclosing: enclosing)
end 'offersAt'

// A type the buffer declares is answered from the buffer, whatever a compiled `stdlib/` says about a
// type of the same name: the author is looking at the declaration in front of them.
function offersFor(subject LspSubject, tokens TokenArray, blocks LspDocumentBlockArray, corpus LspCorpus, enclosing LspEnclosingType) returns CompletionOfferArray
	let typeName = try lspSubjectTypeName(subject) otherwise return CompletionOfferArray.create(0)

	let declaring = lspBlocksDeclaring(blocks, typeName: typeName)
	var offers = CompletionOfferArray.create(0)
	var offered = OfferedLabelSet.create()

	for block in declaring 'eachDeclaringBody'
		addBufferMembers(offers, offered: offered, tokens: tokens, blocks: blocks, block: block, subject: subject, site: lspReaderSite(enclosing, typeName: block.name, sharesTheTypesFile: true))
	end 'eachDeclaringBody'

	if lspBlocksDeclareTheType(declaring) 'theBufferHoldsTheType'
		return offers
	end 'theBufferHoldsTheType'

	addCorpusMembers(offers, offered: offered, typeName: typeName, corpus: corpus, subject: subject, enclosing: enclosing)

	return offers
end 'offersFor'

// --- Members of a type the BUFFER declares ----------------------------------------------------

// ⚠ **ONLY THE BLOCK'S OWN LINES, NOT EVERY LINE BETWEEN ITS ENDS.** A `var` written inside a method body
// is a local and not a field, and `lspBlockDirectlyHoldsLine` is what tells the two apart — without it a
// type's completion list would carry every temporary its methods declare.
function addBufferMembers(offers CompletionOfferArray, offered OfferedLabelSet, tokens TokenArray, blocks LspDocumentBlockArray, block LspDocumentBlock, subject LspSubject, site MemberReaderSite)
	let wantsStatics = lspSubjectIsStatic(subject)

	for member in lspBodyMembers(tokens, blocks: blocks, body: block, tokenLines: lspTokenLines(tokens)) 'eachMember'
		addBodyMember(offers, offered: offered, tokens: tokens, member: member, wantsStatics: wantsStatics, site: site)
	end 'eachMember'
end 'addBufferMembers'

// A STATIC member is reached through the type and an instance one through a value, which decides
// whether a member belongs in this list; a field also needs its spelled tier to reach `site`. A case
// is static, so it is reached through the TYPE (`Color.red`), never through a value of it.
function addBodyMember(offers CompletionOfferArray, offered OfferedLabelSet, tokens TokenArray, member LspMember, wantsStatics bool, site MemberReaderSite)
	if member.isStatic != wantsStatics or not lspMemberReachable(member, site: site) 'notOffered'
		return
	end 'notOffered'

	let label = String.from(lspTokenAt(tokens, index: member.nameIndex).value)

	match member.form 'form'
		method then addOffer(offers, offered: offered, label: label, kind: StaticFunctionCompletionKind if member.isStatic else MethodCompletionKind)
		field then addOffer(offers, offered: offered, label: label, kind: FieldCompletionKind)
		enumCase then addOffer(offers, offered: offered, label: label, kind: EnumMemberCompletionKind)
	end 'form'
end 'addBodyMember'

// --- Members of a type the CORPUS declares ----------------------------------------------------

// ⭐⭐ **THE VISIBILITY FILTER IS THE POINT OF THIS HALF.** A method is asked about through
// `ProgramSignatures.calleeVisibilityFrom` and a field through `LspLayoutReach`, which are the
// compiler's own tier decisions, so a member the open document may not name is a member it is not
// offered.
function addCorpusMembers(offers CompletionOfferArray, offered OfferedLabelSet, typeName String, corpus LspCorpus, subject LspSubject, enclosing LspEnclosingType)
	match corpus 'held'
		loaded(_, signatures, corpusReaderPath) then addDeclaredMembers(offers, offered: offered, signatures: signatures, typeName: typeName, readerPath: corpusReaderPath, subject: subject, enclosing: enclosing)
		unavailable then return
	end 'held'
end 'addCorpusMembers'

// A handle forks rather than filters. Its surface has nothing to do with the synthesized companion's
// declarations — none of the messages are declared on it, and its one field is refused — so it is a
// different roster and not a narrowing of one.
function addDeclaredMembers(offers CompletionOfferArray, offered OfferedLabelSet, signatures ProgramSignatures, typeName String, readerPath FilePath, subject LspSubject, enclosing LspEnclosingType)
	match lspHandleSurfaceOf(signatures, typeName: typeName.toByteArray()) 'aHandle'
		messages(_, request) then addHandleMessages(offers, offered: offered, request: request, subject: subject)
		notAHandle then addOwnDeclaredMembers(offers, offered: offered, signatures: signatures, typeName: typeName, readerPath: readerPath, subject: subject, enclosing: enclosing)
	end 'aHandle'
end 'addDeclaredMembers'

function addHandleMessages(offers CompletionOfferArray, offered OfferedLabelSet, request EnumLayout, subject LspSubject)
	if lspSubjectIsStatic(subject) 'aHandleHasNoStaticSurface'
		return
	end 'aHandleHasNoStaticSurface'

	for message in serviceHandleSurface(request) 'eachAccepted'
		addOffer(offers, offered: offered, label: String.from(message), kind: MethodCompletionKind)
	end 'eachAccepted'
end 'addHandleMessages'

function addOwnDeclaredMembers(offers CompletionOfferArray, offered OfferedLabelSet, signatures ProgramSignatures, typeName String, readerPath FilePath, subject LspSubject, enclosing LspEnclosingType)
	let wantsStatics = lspSubjectIsStatic(subject)
	let owner = typeName.toByteArray()
	let prefix = "{typeName}{CompletionMemberSeparator}"

	if not lspTypeMembersReachable(signatures, owner: owner, readerPath: readerPath, enclosing: enclosing) 'typeHiddenHere'
		return
	end 'typeHiddenHere'

	for registered in signatures.declaredMemberKeysOf(owner) 'eachMember'
		// A receiverless declaration is reached through the type and a receiver-taking one through a
		// value. `takesReceiver` is the compiler's own bit for that, so the two lists cannot drift.
		if signatures.declaredMethodTakesReceiver(registered) == wantsStatics 'wrongAccessForm'
			continue
		end 'wrongAccessForm'

		if not nameableFrom(signatures, registered: registered, readerPath: readerPath) 'hiddenFromThisFile'
			continue
		end 'hiddenFromThisFile'

		addOffer(offers, offered: offered, label: memberNameIn(String.from(registered), prefix: prefix), kind: StaticFunctionCompletionKind if wantsStatics else MethodCompletionKind)
	end 'eachMember'

	if wantsStatics 'casesAndStaticsOnly'
		addDeclaredCases(offers, offered: offered, signatures: signatures, owner: owner, readerPath: readerPath)
		return
	end 'casesAndStaticsOnly'

	addDeclaredFields(offers, offered: offered, signatures: signatures, owner: owner, readerPath: readerPath, enclosing: enclosing)
end 'addOwnDeclaredMembers'

// ⭐ **THE ONE VISIBILITY DECISION, ASKED OF THE COMPILER.** `calleeVisibilityFrom` reads the tier and
// the declaring file the declaration sweep recorded and runs the same `isVisibleFrom` every other reader
// of a `Visibility` runs — so a member this document may not call is a member it is not offered, without
// this file knowing what the tiers are.
function nameableFrom(signatures ProgramSignatures, registered ByteArray, readerPath FilePath) returns bool
	return match signatures.calleeVisibilityFrom(registered, readerFilePath: readerPath) 'tier'
		visible gives true
		hidden gives false
	end 'tier'
end 'nameableFrom'

function addDeclaredFields(offers CompletionOfferArray, offered OfferedLabelSet, signatures ProgramSignatures, owner ByteArray, readerPath FilePath, enclosing LspEnclosingType)
	match signatures.structFor(owner, readerFilePath: readerPath) 'aStruct'
		declared(layout) then addVisibleFields(offers, offered: offered, signatures: signatures, layout: layout, readerPath: readerPath, enclosing: enclosing)
		undeclared then return
	end 'aStruct'
end 'addDeclaredFields'

function addVisibleFields(offers CompletionOfferArray, offered OfferedLabelSet, signatures ProgramSignatures, layout StructLayout, readerPath FilePath, enclosing LspEnclosingType)
	let reach = LspLayoutReach.of(signatures, layout: layout, readerPath: readerPath, enclosing: enclosing)

	for index in 0 upto layout.fieldCount() 'eachField'
		if not reach.reaches(signatures, layout: layout, index: index) 'hiddenHere'
			continue
		end 'hiddenHere'

		addOffer(offers, offered: offered, label: String.from(layout.fieldNameAt(index)), kind: FieldCompletionKind)
	end 'eachField'
end 'addVisibleFields'

function addDeclaredCases(offers CompletionOfferArray, offered OfferedLabelSet, signatures ProgramSignatures, owner ByteArray, readerPath FilePath)
	match signatures.enumFor(owner, readerFilePath: readerPath) 'anEnum'
		declared(layout) then addCaseNames(offers, offered: offered, layout: layout)
		undeclared then return
	end 'anEnum'
end 'addDeclaredCases'

function addCaseNames(offers CompletionOfferArray, offered OfferedLabelSet, layout EnumLayout)
	for caseName in layout.caseNames 'eachCase'
		addOffer(offers, offered: offered, label: String.from(caseName), kind: EnumMemberCompletionKind)
	end 'eachCase'
end 'addCaseNames'

// The member half of a `<Type>.<member>` registration name.
function memberNameIn(qualified String, prefix String) returns String
	let afterType = qualified.split(prefix)
	let member = try afterType.get(1) otherwise panic("memberNameIn: '{qualified}' was admitted by `startsWith('{prefix}')`, so splitting on it yields a second part")
	let unmangled = member.split(mintedNameSeparator())
	return try unmangled.get(0) otherwise panic("memberNameIn: a split on a non-empty separator always yields at least one part")
end 'memberNameIn'

// --- Offering ---------------------------------------------------------------------------------

function addOffer(offers CompletionOfferArray, offered OfferedLabelSet, label String, kind LspCompletionKind)
	if label.isEmpty() or offered.contains(label) 'nothingNewToShow'
		return
	end 'nothingNewToShow'

	// A nested member (`Map.Entry.get`) is not a member of the type the cursor is on, and a reserved name
	// is one an author may not write at all.
	if label.contains(CompletionMemberSeparator) or isCompilerReservedName(label.toByteArray()) 'notWritableHere'
		return
	end 'notWritableHere'

	offered.insert(label)
	offers.push(CompletionOffer.create(label, kind: kind))
end 'addOffer'
