// LSP and DAP stdio framing: `Content-Length: <n>\r\n\r\n<body>` in both directions.
//
// The count is the body's BYTES and the body carries no trailing newline. An editor frames the next
// message from exactly that count, so one byte either way desynchronizes the stream permanently — which
// is why a message this file cannot frame is reported as `framingError` and ends the session rather than
// being skipped.

// What one turn of the read loop produced. A union rather than a throwing read because the three
// outcomes lead to three different ends of the session — one is handled, one is a clean close, and one
// is fatal — and a caller that has to name all three cannot silently drop one.
export union LspIncoming
	message(body String)
	endOfStream
	framingError(detail String)
end 'LspIncoming'

extension StreamReader where Source is ByteSource
	export function readLspMessage() returns isolated LspIncoming
		// EOF anywhere before a complete message is the same event however far in it lands: the client is
		// gone and there is nothing left to frame.
		let body = try self.readContentLengthFrame() otherwise (e) 'unframed'
			match e 'error'
				ended then return LspIncoming.endOfStream
				malformed(detail) then return LspIncoming.framingError(detail)
			end 'error'
		end 'unframed'

		return LspIncoming.message(body)
	end 'readLspMessage'
end 'StreamReader'

// Frame `body` and write it to standard output.
export function writeLspMessage(body String)
	print(contentLengthFrame(body))
end 'writeLspMessage'
