type RunningCheck
	let work as immutable LspQueuedCheck
	let project as Project
	let run as CompileRun

	static function create(work immutable LspQueuedCheck, project Project, run CompileRun) returns RunningCheck
		return Self{work: work, project: project, run: run}
	end 'create'
end 'RunningCheck'

typealias RunningCheckSlot = Slot with RunningCheck
