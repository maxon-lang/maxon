module type RunningCheck
	module let work as immutable LspQueuedCheck
	module let project as Project
	module let run as CompileRun

	module static function create(work immutable LspQueuedCheck, project Project, run CompileRun) returns RunningCheck
		return Self{work: work, project: project, run: run}
	end 'create'
end 'RunningCheck'

module typealias RunningCheckSlot = Slot with RunningCheck
