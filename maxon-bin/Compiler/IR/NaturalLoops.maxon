// NaturalLoops — back-edge detection and natural-loop membership over a `CsrGraph`, for ANY tier.
//
// ⭐⭐ **IT IS ONE FINDER, NOT TWO, AND THAT IS THE WHOLE REASON THIS FILE EXISTS.** The Target tier
// needs the loop nest to weight a spill (`TargetLiveness.computeLoopDepth`), to name the region an
// `E5001` overflowed in (`enclosingLoopBlocks`) and to rotate a loop's layout (`BranchCleanup`); the Std
// tier's LICM and unswitching need exactly the same answers about the Std CFG. A second copy would be
// this project's signature bug — one fact written down twice — in the one place where a disagreement is
// invisible: two finders that classify a back edge differently do not fail to compile, they optimize
// different loops. So every consumer builds ONE `NaturalLoops` and asks it.
//
// ⚠ **NOTHING HERE KNOWS WHAT A BLOCK IS.** The input is a `CsrGraph` over a dense 0-based key space
// and its reverse; the outputs are a `NaturalLoops` record and a `LoopMembership`, both keyed by that
// same space. That is what makes it tier-free:
// the Target tier keys on `FuncTopology`'s block LOCALS and the Std tier on a block's position in
// `func.blockRefs`, and both are `CsrIndex` — the same non-negative integer `buildCsr` is built over.
//
// ⚠ **THE DFS ROOT IS NODE 0, and both tiers owe that invariant** rather than passing it: `FuncTopology`
// is built in reverse postorder from the entry, and `StdEntryBlockPosition` is `func.blockRefs`'s first
// entry. A root that were not the entry would report a back edge for every edge into an unvisited
// region, which is not a wrong classification so much as a meaningless one.
//
// ⚠ **REDUCIBILITY IS THE PREMISE.** The CFG a structured parser emits is reducible, so every DFS
// RETREATING edge is a genuine back edge (its head dominates its tail) and "natural loop" is the whole
// truth about the loop structure. An irreducible CFG — which nothing in this language can spell, there
// being no `goto` — would have retreating edges whose heads do not dominate their tails, and the member
// sets below would be neither wrong nor complete. `StdDominatorTree` is what a consumer needing the
// dominance half asks; this file does not re-derive it.

// The loop structure of one function: its distinct headers and, per header, the latches — the tails
// of the back edges into it. Empty for the loopless function, which is MOST functions, so a consumer
// asks `headers.count() == 0` before building anything a loop would need.
//
// ⭐ **THE LATCHES ARE BUCKETED BY HEADER ONCE, when the DFS finishes**, so every per-loop question —
// seeding a loop's member walk, choosing its layout latch, climbing from its latches — costs the loop's
// OWN back-edge count. A flat edge list costs Θ(headers × back edges) per function, and the corpus
// contains exactly the function that makes that bite (`ScaleCorpus`'s pressure-loop knob is ONE
// function with N loops, and N grows with the rung).
export type NaturalLoops
	// The distinct headers, in back-edge DISCOVERY order — the first back edge into each header decides
	// its place. Back edges sharing a header (a loop with `continue`, whose every `continue` is one)
	// name ONE loop, so a header is listed once: a consumer would otherwise count that loop's nesting
	// twice, re-walk its member set once per back edge, or analyse one loop several times over.
	//
	// ⭐ **THE ORDER IS INNERMOST-FIRST FOR A NEST, and `hoistLoopInvariants` reads it that way — but it
	// is a property of the DFS PLUS THE SUCCESSOR ORDER, not of the DFS alone.** The walk reaches the
	// inner latch on its way down and the outer latch only on the way back, which puts the inner
	// retreating edge first; that holds because the Std tier's `pushBothTargets` emits a `condBranch`'s
	// THEN target first, so a loop's body is explored before its exit. Reverse that and a nest yields
	// outermost-first. ⚠ Nothing's CORRECTNESS depends on it — a consumer that walked the other order
	// would hoist less, never wrongly. Discovery order is kept here rather than the buckets' node order
	// for exactly this reader: a nest's inner header has the LARGER key in a reverse-postorder layout.
	export var headers as CsrColumn

	// Header -> the latches of its back edges, in discovery order. A node is a header exactly when its
	// degree here is non-zero, which is how a consumer asks that question.
	export var latches as CsrGraph

	// The one finder: a DFS from node 0 recording every retreating edge, then the buckets.
	export static function find(succ CsrGraph, nodeCount CsrIndex) returns NaturalLoops
		var tails = CsrColumn.create()
		var heads = CsrColumn.create()
		findRetreatingEdges(succ, nodeCount: nodeCount, tails: tails, heads: heads)

		var headers = CsrColumn.create()
		var seen = BoolArray.create()
		seen.resize(nodeCount)

		for h in heads 'eachBackEdge'
			let already = try seen.get(h) otherwise panic("NaturalLoops.find: seen.get OOB at {h}")

			if already 'sameLoop'
				continue
			end 'sameLoop'

			try seen.set(h, value: true) otherwise panic("NaturalLoops.find: seen.set OOB at {h}")
			headers.push(h)
		end 'eachBackEdge'

		return Self{headers: headers, latches: buildCsr(heads, to: tails, nodeCount: nodeCount)}
	end 'find'

	// Fill `into` with the natural loop of `header` (the union over all back edges targeting `header`):
	// the header, plus everything reaching a latch through predecessors without passing back through
	// the header.
	export function collect(pred CsrGraph, header CsrIndex, into LoopMembership)
		into.reset(self.latches.nodeCount())
		_ = into.admit(header)

		for k in 0 upto self.latches.degree(header) 'seedLatches'
			into.admitToWorklist(self.latches.neighbour(header, k: k))
		end 'seedLatches'

		while into.worklist.count() > 0 'bfs'
			let n = try into.worklist.pop() otherwise panic("NaturalLoops.collect: worklist.pop on non-empty failed")

			for k in 0 upto pred.degree(n) 'eachPred'
				into.admitToWorklist(pred.neighbour(n, k: k))
			end 'eachPred'
		end 'bfs'
	end 'collect'
end 'NaturalLoops'

// Depth-first search from node 0, recording every RETREATING edge (an edge to a GRAY — still-open —
// node), which in a reducible CFG is exactly a back edge, as parallel `tails[k] -> heads[k]` columns.
//
// ITERATIVE, with an explicit stack, because the recursive form recursed once per block and SEGFAULTED
// the compiler on a large function: a 19,200-block function overflowed the native stack before it could
// be allocated. Depth here is bounded by the node count, and a generated or heavily-branching function
// reaches thousands of blocks easily, so recursion is simply not available. (`NaturalLoops.collect`,
// `StdDominatorTree.buildReversePostorder` and the SSA liveness walk are all worklist-driven for the
// same reason.)
//
// The stack holds a (node, next-successor-index) pair per open node — the explicit form of a recursive
// call's resume point — so a node turns BLACK only once every successor has been visited, which is what
// makes the GRAY test mean "still on the current DFS path".
function findRetreatingEdges(succ CsrGraph, nodeCount CsrIndex, tails CsrColumn, heads CsrColumn)
	// A graph with no nodes has no root to start from. Answered rather than refused: a Std function
	// with no blocks is a declaration, and every consumer is then vacuous.
	if nodeCount == 0 'noNodes'
		return
	end 'noNodes'

	var colors = DfsColorArray.create()
	colors.resize(nodeCount)
	var stackNode = CsrColumn.create()
	var stackNextSucc = CsrColumn.create()

	let root = 0 as CsrIndex
	try colors.set(root, value: DfsGray) otherwise panic("findRetreatingEdges: colors.set(root) OOB")
	stackNode.push(root)
	stackNextSucc.push(0)

	while stackNode.count() > 0 'dfs'
		let top = stackNode.count() - 1
		let u = try stackNode.get(top) otherwise panic("findRetreatingEdges: stackNode.get OOB")
		let k = try stackNextSucc.get(top) otherwise panic("findRetreatingEdges: stackNextSucc.get OOB")

		if k >= succ.degree(u) 'exhausted'
			// Every successor visited — close the node and resume its parent.
			try colors.set(u, value: DfsBlack) otherwise panic("findRetreatingEdges: colors.set black OOB")
			_ = try stackNode.pop() otherwise panic("findRetreatingEdges: stackNode.pop on non-empty failed")
			_ = try stackNextSucc.pop() otherwise panic("findRetreatingEdges: stackNextSucc.pop on non-empty failed")
			continue
		end 'exhausted'

		try stackNextSucc.set(top, value: k + 1) otherwise panic("findRetreatingEdges: stackNextSucc.set OOB")

		let v = succ.neighbour(u, k: k)
		let c = try colors.get(v) otherwise panic("findRetreatingEdges: colors.get OOB")

		if c == DfsWhite 'unvisited'
			try colors.set(v, value: DfsGray) otherwise panic("findRetreatingEdges: colors.set gray OOB")
			stackNode.push(v)
			stackNextSucc.push(0)
		end 'unvisited' else if c == DfsGray 'retreating'
			tails.push(u)
			heads.push(v)
		end 'retreating'
	end 'dfs'
end 'findRetreatingEdges'

// ONE natural loop's block set, in BOTH the forms its consumers need: a dense membership test and a
// LIST of the members — plus the scratch the member walk runs on.
//
// ⭐⭐ **THE LIST IS WHY THIS IS A RECORD AND NOT A `BoolArray`.** A consumer holding membership alone
// answers "which blocks are in the loop?" by sweeping ALL of them, once per loop — Θ(loops × blocks) per
// function — and a membership column allocated per loop costs the same again; the corpus contains
// exactly the function that makes that bite (`ScaleCorpus`'s pressure-loop knob is ONE function with N
// loops, and N grows with the rung). One caller-owned record, iterated through `blocks`, keeps every
// per-loop cost proportional to the LOOP rather than to the function; the ladder that measured the
// alternative is in `docs/emitted-code-roadmap.md`.
//
// The reset clears only the entries the previous loop set, which is what keeps that promise: a
// `resize`/`growFilled` of the whole node space per loop would put the Θ(loops × blocks) straight back.
export type LoopMembership
	// Dense over the node space, and only ever true for a member of the CURRENT loop.
	var inLoop as BoolArray

	// The members, in the order the walk discovers them: the header first, then the latches, then
	// their predecessors. ⚠ NOT an order any dataflow may rely on — a consumer that needs defs before
	// uses walks the DOMINATOR TREE (see `LoopFacts.recordLoopPreorder`).
	export var blocks as CsrColumn

	// The member walk's frontier. Owned here so a function with N loops runs N walks on one column;
	// always empty between walks, so `reset` need not touch it. Exported because a bare field is private
	// to the TYPE (E3014), and the walk that drives it is `NaturalLoops.collect`.
	export var worklist as CsrColumn

	export static function create() returns LoopMembership
		return Self{inLoop: BoolArray.create(), blocks: CsrColumn.create(), worklist: CsrColumn.create()}
	end 'create'

	export function contains(node CsrIndex) returns bool
		if node >= self.inLoop.count() 'beyondTheColumn'
			return false
		end 'beyondTheColumn'

		return try self.inLoop.get(node) otherwise panic("LoopMembership.contains: inLoop.get OOB at {node}")
	end 'contains'

	// Empty the set for the next loop, in time proportional to what the LAST loop held rather than to
	// the node space. `growFilled` only zeroes the tail it ADDS, which is sound here precisely because
	// every entry below that tail was cleared by the walk above it.
	//
	// Exported with `admit` so a consumer holding a loop's member LIST can reload the set from it in
	// O(the loop) — `unswitchInvariantGuards` rewrites every admitted loop after analysing them all.
	export function reset(nodeCount CsrIndex)
		for node in self.blocks 'eachMember'
			try self.inLoop.set(node, value: false) otherwise panic("LoopMembership.reset: inLoop.set OOB at {node}")
		end 'eachMember'

		self.blocks.clear()
		self.inLoop.growFilled(nodeCount as ElementIndex, value: false)
	end 'reset'

	// Add one member, answering whether it was NEW — which is the whole of what the walk's worklist test
	// needs, and keeps membership and the list from ever disagreeing.
	export function admit(node CsrIndex) returns bool
		if self.contains(node) 'alreadyAMember'
			return false
		end 'alreadyAMember'

		try self.inLoop.set(node, value: true) otherwise panic("LoopMembership.admit: inLoop.set OOB at {node}")
		self.blocks.push(node)
		return true
	end 'admit'

	// Admit `node` and, when it is new, queue it so its predecessors are walked.
	export function admitToWorklist(node CsrIndex)
		if self.admit(node) 'newMember'
			self.worklist.push(node)
		end 'newMember'
	end 'admitToWorklist'
end 'LoopMembership'

// DFS coloring for back-edge detection: WHITE = not yet reached, GRAY = still on the current DFS
// path (an edge to one is a retreating edge, i.e. a back edge in a reducible CFG), BLACK = closed.
// Three states and no more, which is the whole bound.
typealias DfsColor = int(0 to 2)
typealias DfsColorArray = Array with DfsColor

let DfsWhite = 0 as DfsColor
let DfsGray = 1 as DfsColor
let DfsBlack = 2 as DfsColor
