// IrBlock: a basic block shared across all IR phases (Maxon, Std, Target).
//
// Stores op indices into the owning module's flat ops array, exactly one
// terminator, block arguments (phi nodes), and outgoing branch edges.
//
// THE PHI MODEL AND ITS LIFECYCLE. `blockArgs` (the phis) and `branchEdges` (each
// predecessor's per-phi incoming values) are one positional pair: `blockArgs[k]` of a
// block is fed by slot `k` of every incoming edge's `argIds`. `PhiEdgeView.resolve`
// is the one place that arity is checked.
//
//   Maxon phase — BORN HERE. The parser's on-the-fly SSA mints them (`Parser.mintPhi`
//     / `recordBranchEdge`), so they are NOT empty at this phase. A block whose
//     successor carries no phis gets no edge recorded at all, so `branchEdges` is not
//     a successor list — the CFG is derived from the ops (see `TargetLiveness`).
//   Std phase — `lowerMaxonToStd` carries them across, then `pruneDeadBlockArgs` DROPS
//     the phis nothing reads, rebuilding both lists in lockstep.
//   Target phase — `StdToX64Conversion.prepareSkeleton` carries them across, and the
//     register allocator consumes them DIRECTLY, doing SSA destruction after coloring —
//     nothing clears them beforehand.
//     They ARE rewritten here: the live-range splitter repoints edge args at reloads
//     (`rewriteEdgeArgsIn`), critical-edge splitting moves edges onto new blocks, and
//     `clearPhiModel` finally empties the model once the edge moves are committed.
//
// WHO OWNS WHAT — the rule every pass must respect.
//
// The phi model is tier-independent data, so the three tiers SHARE ONE COPY of it
// rather than deep-copying it at each boundary. Concretely: a Std block's `blockArgs`
// and `branchEdges` are the Maxon block's arrays; a Target block gets its own
// `BranchEdgeArray` and `BranchEdge` objects (it replaces those) but SHARES the
// `ValueIdArray` inside each edge and the `blockArgs` list.
//
// That sharing reaches all the way back into the PARSE MEMO: `queryAllModule` hands
// out the same MaxonModule object on every cache hit, and `relocateIrBlock` aliases
// its phi arrays into the merged module. So a pass that mutates one of these arrays
// IN PLACE corrupts the memo for every later compile of the project — and nothing
// downstream re-reads the Maxon or Std phi model, so no test would catch it.
//
// Hence the rule:
//
//   A pass MUST NOT mutate `blockArgs`, `branchEdges`, or an edge's `argIds` in place.
//   To change the phi model, BUILD A FRESH ARRAY AND ASSIGN THE FIELD.
//
// Every pass already obeys it. `pruneDeadBlockArgs` (Std) rebuilds both lists and
// field-assigns them onto the Std block. `extractPredEdge` / `clearPhiModel` (Target)
// field-assign a rebuilt `BranchEdgeArray`. The ONE in-place writer in the whole
// compiler is `rewriteEdgeArgsIn` (Target), and it de-aliases — it clones an edge's
// `argIds` before its first write to it. A pass that CREATES phis must follow the
// same discipline.

// Role tag for an IrBlockArg: that a continuation-block arg stands in for what would
// otherwise be a value captured from a multi-value-return register, so a coalescer
// could seed a physical-register hint on it in place of the hint anchor the post-call
// capture mov provided before the callee was inlined.
//
// ⛔ **NOTHING PRODUCES A NON-`none` VALUE AND NOTHING READS THE FIELD.** Both splicing
// passes leave it at `none` — `inlineManagedPrimitives` and `inlineLeaves` alike — and no
// backend consults it, so the hint it describes is one the allocator arrives at on its own
// or not at all. Wiring a producer before there is a consumer would be a producer with no
// consumer, which is why neither pass does.
//
//   none           — normal phi (the parser's SSA, a branch arg). The only value in use.
//   primaryReturn  — primary return value: R8 (x64) / X0 (arm64).
//   errorFlag      — multi-value-return error flag: RDX / X1.
export enum BlockArgReturnRole
	none
	primaryReturn
	errorFlag
end 'BlockArgReturnRole'

// @generated library-cache begin
let CacheCasesBlockArgReturnRole = [BlockArgReturnRole.none, BlockArgReturnRole.primaryReturn, BlockArgReturnRole.errorFlag]

function cacheReadBlockArgReturnRole(reader LibraryCacheReader) returns BlockArgReturnRole throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesBlockArgReturnRole.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadBlockArgReturnRole'

function cacheTableAgreesBlockArgReturnRole() returns bool
	let declared = BlockArgReturnRole.allCases

	if CacheCasesBlockArgReturnRole.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesBlockArgReturnRole.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesBlockArgReturnRole'

export function cacheEnumTablesAgreeInCompilerIRIrBlock() returns bool
	if not cacheTableAgreesBlockHeat() 'disagreesCacheTableAgreesBlockHeat'
		return false
	end 'disagreesCacheTableAgreesBlockHeat'

	if not cacheTableAgreesBlockRole() 'disagreesCacheTableAgreesBlockRole'
		return false
	end 'disagreesCacheTableAgreesBlockRole'

	if not cacheTableAgreesBlockArgReturnRole() 'disagreesCacheTableAgreesBlockArgReturnRole'
		return false
	end 'disagreesCacheTableAgreesBlockArgReturnRole'

	return true
end 'cacheEnumTablesAgreeInCompilerIRIrBlock'

