		}
	end 'create'

	// An empty block carrying `src`'s identity — id, label, heat and inline site — for every tier boundary
	// and copier that rebuilds a block's body but keeps what the block IS.
	export static function createLike(src IrBlock) returns IrBlock
		return IrBlock.create(src.id, label: src.label, heat: src.heat, inlineSite: src.inlineSite, role: src.role)
	end 'createLike'

	// Shift everything that names an op by index — `opRefs`, the terminator, the cond-branch — by
	// `shift`: the block's ops were appended after `shift` others in the module it now belongs to
	// (`IrModule.merge`, the backend unit splice). The two unions are re-minted whole, so the block shares
	// no box with whatever it was relocated from.
	export function shiftOpIndices(shift ElementIndex)
		let delta = shift

		for pos in 0 upto self.opRefs.count() 'eachOp'
			let opIdx = try self.opRefs.get(pos) otherwise panic("IrBlock.shiftOpIndices: opRefs.get OOB at {pos}")
			try self.opRefs.set(pos, value: opIdx + delta) otherwise panic("IrBlock.shiftOpIndices: opRefs.set OOB at {pos}")
		end 'eachOp'

		self.terminator = match self.terminator 'relocate'
			unset gives Terminator.unset
			dead gives Terminator.dead
			fallthrough gives Terminator.fallthrough
			opIndex(index) gives Terminator.opIndex(index + delta)
		end 'relocate'

		self.condBranch = match self.condBranch 'relocateCond'
			none gives CondBranch.none
			opIndex(index) gives CondBranch.opIndex(index + delta)
		end 'relocateCond'
	end 'shiftOpIndices'

	// True when the block has a real terminator op (returns / branches).
	// Dead and fallthrough blocks return false — they have no op to
	// reference even though they are effectively terminated.
	export function hasTerminatorOp() returns bool
		return terminatorNamesAnOp(self.terminator)
	end 'hasTerminatorOp'

	// True when control cannot flow off the end of this block — it has a
	// terminator op, is dead (unreachable), or intentionally falls through
	// to the next block in layout order. Passes that only care whether to
	// append an implicit branch/return use this.
	export function isTerminated() returns bool
		return match self.terminator 'check'
			unset gives false
			dead or
			fallthrough or
			opIndex gives true
		end 'check'
	end 'isTerminated'

	// ⭐ **HOW MANY OPS THE BLOCK RUNS, AND WHICH ONE RUNS AT EACH POSITION** — its body ops, then the terminator,
	// which lives in a slot of its own (`Terminator`) and so is NOT in `opRefs`. A caller ordering two program
	// points within a block asks these rather than `opRefs`, whose last position is one op short of the block's end.
	export function opCountInRunOrder() returns ElementIndex
		return self.opRefs.count() + 1 if terminatorNamesAnOp(self.terminator) else self.opRefs.count()
	end 'opCountInRunOrder'

	export function opInRunOrderAt(position ElementIndex) returns ElementIndex
		if position < self.opRefs.count() 'aBodyOp'
			return try self.opRefs.get(position) otherwise panic("opInRunOrderAt: opRefs.get OOB at {position}")
		end 'aBodyOp'

		if position >= self.opCountInRunOrder() 'pastTheBlock'
			panic("opInRunOrderAt: position {position} is past block '{String.from(self.label)}', which runs {self.opCountInRunOrder()} ops")
		end 'pastTheBlock'

		return self.terminatorIndex()
	end 'opInRunOrderAt'

	// Returns the op index of the block's terminator. Panics if the
	// terminator is not opIndex(_); callers must guard with hasTerminatorOp.
	export function terminatorIndex() returns ElementIndex
		if not terminatorNamesAnOp(self.terminator) 'noTerminatorOp'
			panic("terminatorIndex: block '{String.from(self.label)}' has no terminator op")
		end 'noTerminatorOp'

		return terminatorOpIndexOf(self.terminator)
	end 'terminatorIndex'

	// True when the block has a conditional-branch body op (a second successor named by
	// something other than the terminator). See `CondBranch`.
	export function hasCondBranchOp() returns bool
		return match self.condBranch 'check'
			none gives false
			opIndex gives true
		end 'check'
	end 'hasCondBranchOp'

	// The op index of the block's conditional branch. Panics when it has none; callers
	// must guard with `hasCondBranchOp` or match on `condBranch` directly.
	export function condBranchIndex() returns ElementIndex
		match self.condBranch 'unwrap'
			opIndex(index) then return index
			none then panic("condBranchIndex: block '{String.from(self.label)}' has no conditional-branch op")
		end 'unwrap'
	end 'condBranchIndex'

	export function carriesOnAnEdge(value ValueId) returns bool
		for edge in self.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachArg'
				if argId == value 'carriesIt'
					return true
				end 'carriesIt'
			end 'eachArg'
		end 'eachEdge'

		return false
	end 'carriesOnAnEdge'

	// Panic if the block was never given a terminator. Called at the end
	// of the parsing phase to enforce the invariant that every IR block
	// commits to one of: dead (unreachable), fallthrough (target phase
	// only), or a concrete terminator op.
	export function assertTerminated()
		match self.terminator 'check'
			unset then panic("IrBlock '{String.from(self.label)}' (id={self.id}) has no terminator — parser left it in Terminator.unset")
			dead or
			fallthrough or
			opIndex then break
		end 'check'
	end 'assertTerminated'

	// @generated library-cache begin
	export function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.id as CacheUnsigned)
		writer.bytes(self.label)
		writer.unsigned(self.heat.ordinal as CacheUnsigned)
		writer.unsigned(self.role.ordinal as CacheUnsigned)
		cacheWriteInlineSiteRef(writer, value: self.inlineSite)
		cacheWriteOpIndexArray(writer, value: self.opRefs)
		cacheWriteTerminator(writer, value: self.terminator)
		cacheWriteCondBranch(writer, value: self.condBranch)
		cacheWriteIrBlockArgArray(writer, value: self.blockArgs)
		cacheWriteBranchEdgeArray(writer, value: self.branchEdges)
	end 'cacheWrite'

	export static function cacheRead(reader LibraryCacheReader) returns IrBlock throws LibraryCacheDamage
		let f_id = (try reader.unsigned()) as BlockId
		let f_label = try reader.bytes()
		let f_heat = try cacheReadBlockHeat(reader)
		let f_role = try cacheReadBlockRole(reader)
		let f_inlineSite = try cacheReadInlineSiteRef(reader)
		let f_opRefs = try cacheReadOpIndexArray(reader)
		let f_terminator = try cacheReadTerminator(reader)
		let f_condBranch = try cacheReadCondBranch(reader)
		let f_blockArgs = try cacheReadIrBlockArgArray(reader)
		let f_branchEdges = try cacheReadBranchEdgeArray(reader)

		return Self{id: f_id, label: f_label, heat: f_heat, role: f_role, inlineSite: f_inlineSite, opRefs: f_opRefs, terminator: f_terminator, condBranch: f_condBranch, blockArgs: f_blockArgs, branchEdges: f_branchEdges}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize80
		return sizeof(IrBlock) as CacheSize80
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'IrBlock'

export typealias IrBlockArray = Array with IrBlock

// @generated library-cache begin
export function cacheWriteIrBlockArray(writer LibraryCacheWriter, value IrBlockArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteIrBlockArray'

export function cacheReadIrBlockArray(reader LibraryCacheReader) returns IrBlockArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = IrBlockArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try IrBlock.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadIrBlockArray'

// @generated library-cache end

// ⛔ There is deliberately NO `resolveBlockLabel(blockId, blocks)` here any more.
//
// It answered a branch target with the target block's `label`, which is NOT a block's identity: a
// label is minted per CONSTRUCT (`ifcont`, `tryerr`, `__rc_panic`), so one function holds several
// blocks of one name and the answer could not name which. Naming a block for PRINTING is the
// printer's own concern and needs the whole function in view to disambiguate — it lives in
// `TargetPrinter.buildBlockPrintNames`, which builds one injective table per function and is read by
// the block header and every branch operand alike. That also retired this scan, which ran once per
// branch operand and made printing a function quadratic in its own block count.

// Insert ONE op reference at `at`, which must name a position INSIDE the block or one
// past its end.
//
// This exists because `Array.insert` CLAMPS an out-of-range index to the tail, and every
// caller here computes `at` from a live-range position or an op's index within the block
// — so a position past the end is a bug in the caller, not a request to append. Clamping
// would put a spill store or a reload at the wrong place and miscompile silently, so an
// out-of-range `at` panics here rather than reaching `Array.insert`.
//
// ⚠ IT SHIFTS A SUFFIX OF `opRefs`, SO IT IS FOR ONE OP AND NOT FOR K OF THEM. A caller
// placing several ops into one block must use `spliceOpRefs` below — a loop here costs
// Θ(K × block) and it also forces each iteration to re-derive its position in coordinates
// the previous iteration has already moved. That is not a style preference: it is the
// quadratic the register allocator's splitter is MEASURED paying, and the reason its
// positions are read out of an index instead of searched for.
export function insertOpRef(block IrBlock, at ElementIndex, opIdx ElementIndex)
	if at > block.opRefs.count() 'oob'
		panic("insertOpRef: position {at} is past the end of block '{String.from(block.label)}' (opRefs count={block.opRefs.count()})")
	end 'oob'

	block.opRefs.insert(at, value: opIdx)
end 'insertOpRef'

// Insert a whole BATCH of op references in ONE pass — `opIdxs[k]` at position `positions[k]`, for k in
// `[from, to)`.
//
// EVERY POSITION IS STATED IN THE BLOCK'S PRE-BATCH COORDINATES, and they must be ASCENDING. Entry `k`
// lands immediately before whatever sat at `positions[k]` before any of this batch went in, and after
// every earlier entry of the batch — which is exactly the layout `to - from` separate `insertOpRef`
// calls produce when each one re-derives its own position from the anchor op it must follow.
//
// WHY IT EXISTS. `insertOpRef` shifts a suffix of `opRefs` on every call, so a caller placing K ops
// into a block of M paid Θ(K × M) — and the register allocator's splitter is exactly that caller: two
// f64 locals read after each of N calls put ~2N reloads into one straight-line block of ~10N ops. This
// pays Θ(M + K) instead, and it allocates nothing beyond the one growth. The insertions being held back
// until the batch is complete is also what keeps every position in one coordinate system, which is what
// lets the splitter read a position out of its use index rather than search for it.
export function spliceOpRefs(block IrBlock, positions BlockOpPosArray, opIdxs OpIndexArray, from ElementIndex, to ElementIndex)
	let pending = to - from

	if pending == 0 'nothingToSplice'
		return
	end 'nothingToSplice'

	let oldCount = block.opRefs.count()

	// Grow FIRST and fill BACKWARD: every slot written is either one already copied out or one the
	// growth just added, so no original op ref is clobbered before it has been moved.
	//
	// `growFilled`, not `resize`, and the difference is asymptotic rather than cosmetic: `resize` grows
	// capacity to EXACTLY the length asked for, so a block spliced into by several splits in turn is
	// reallocated and copied in full every time — Θ(splits × block) bytes (see `Array.growFilled`, which
	// documents that trap). Geometric growth makes the same sequence amortized linear. The zeros it
	// writes into the added tail are all overwritten by the pass below; that fill is the price of using
	// the one extension operation rather than a second one.
	block.opRefs.growFilled(((oldCount + pending) as ElementIndex), value: 0)

	var write = oldCount + pending
	var read = oldCount
	var k = to

	while k > from 'eachPendingSplice'
		let at = try positions.get(k - 1) otherwise panic("spliceOpRefs: positions.get OOB at {k - 1}")

		if at > oldCount 'pastTheEnd'
			panic("spliceOpRefs: position {at} is past the end of block '{String.from(block.label)}' (opRefs count={oldCount})")
		end 'pastTheEnd'

		if at > read 'outOfOrder'
			panic("spliceOpRefs: entry {k - 1} of this batch asks for position {at} of block '{String.from(block.label)}', but the entry after it already claimed position {read} or lower — a batch must be ASCENDING by position, because it is materialized in ONE backward pass")
		end 'outOfOrder'

		while read > at 'shiftTail'
			write = write - 1
			read = read - 1
			let moved = try block.opRefs.get(read) otherwise panic("spliceOpRefs: opRefs.get OOB at {read}")
			try block.opRefs.set(write, value: moved) otherwise panic("spliceOpRefs: opRefs.set OOB at {write}")
		end 'shiftTail'

		let spliced = try opIdxs.get(k - 1) otherwise panic("spliceOpRefs: opIdxs.get OOB at {k - 1}")
		write = write - 1
		try block.opRefs.set(write, value: spliced) otherwise panic("spliceOpRefs: opRefs.set OOB at {write}")
		k = k - 1
	end 'eachPendingSplice'
end 'spliceOpRefs'

// Collect the IrBlocks referenced by a function's blockRefs list.
// Used by IR printers across all phases to iterate a function's blocks.
module function resolveFuncBlocks(blocks IrBlockArray, blockRefs BlockRefArray) returns IrBlockArray
	var result = IrBlockArray.create()

	for blockRef in blockRefs 'each'
		let block = try blocks.get(blockRef) otherwise panic("invariant: blockRef from blockRefs not in blocks")
		result.push(block)
	end 'each'

	return result
end 'resolveFuncBlocks'

export type ExitWebBlock
	export let block as IrBlock
	export let slot as ElementIndex
	export let phi as ValueId

	export static function create(block IrBlock, slot ElementIndex, phi ValueId) returns Self
		return Self{block: block, slot: slot, phi: phi}
	end 'create'
end 'ExitWebBlock'

export typealias ExitWebBlockArray = Array with ExitWebBlock

export type ExitArrival
	export let source as IrBlock
	export let value as ValueId

	export static function create(source IrBlock, value ValueId) returns Self
		return Self{source: source, value: value}
	end 'create'
end 'ExitArrival'

export typealias ExitArrivalArray = Array with ExitArrival

export type ExitChain
	export let web as ExitWebBlockArray
	export let leaves as ExitArrivalArray
	export let joins as ExitArrivalArray

	export static function create(web ExitWebBlockArray, leaves ExitArrivalArray, joins ExitArrivalArray) returns Self
		return Self{web: web, leaves: leaves, joins: joins}
	end 'create'
end 'ExitChain'

export typealias ExitChainsByReturn = Map with (ValueId, ExitChain)

module type ExitIncoming
	export let source as IrBlock
	export let args as ValueIdArray

	module static function create(source IrBlock, args ValueIdArray) returns Self
		return Self{source: source, args: args}
	end 'create'
end 'ExitIncoming'

module typealias ExitIncomingArray = Array with ExitIncoming
module typealias ExitIncomingByTarget = Map with (BlockId, ExitIncomingArray)
module typealias ExitWebByPhi = Map with (ValueId, ExitWebBlock)
