// ModuleInit — the two synthesized functions a program with MANAGED top-level `var`s carries, and
// nothing else does: `__module_init`, which fills EVERY managed global's `.data` pointer slot BEFORE
// `main`, and `__maxon_global_cleanup`, which releases each managed global AFTER `main` returns.
//
// ⭐⭐ **EVERY SLOT IS FILLED BEFORE `main`, WITHOUT EXCEPTION, AND THAT IS WHAT MAKES BOTH FUNCTIONS
// BRANCH-FREE** (⚖ user ruling: a `static let`/`static var` initializer runs eagerly, before `main`, in
// DEPENDENCY order). Where the binding was declared decides nothing — a `static` member and a file-scope
// `var` are one population here. So `__module_init` has no slot to skip and `__maxon_global_cleanup` has no
// null to test: the only value a slot can hold when the cleanup reads it is the record the init put there.
// The ORDER the globals arrive in is `GlobalInitOrder`'s answer, and a cycle is refused there (E2012) rather
// than settled to some value at run time.
//
// ⭐ **A MANAGED GLOBAL'S SLOT IS AN 8-BYTE POINTER, AND ITS VALUE IS A REAL OWNED HEAP RECORD.** Both
// halves are load-bearing and neither is negotiable:
//
//   • **A pointer, because a record cannot be baked.** A `.data` slot holding the ADDRESS of another
//     section's bytes would need a compile-time VA, and there is none under ASLR
//     (`specs/static-variables.md:729-730`). So the image holds zero and this function writes the address.
//
//     ⚠⚠ **SO EVERY SLOT ACCESS IS ONE WIDTH — `declaredAggregateSlotWidth()` — AND IT IS STATED RATHER
//     THAN DERIVED FROM THE VALUE'S TYPE.** The store that fills a slot and the load that drains it pass
//     that accessor and not `global.valueType`, which is a fact about the value's IDENTITY and not about
//     the slot. Deriving it happened to give the machine word for every arm that existed — every managed
//     `MaxonType` collapses to `i64` — and a boxed union is where the two part company, loudly:
//     `maxonTypeToStdType` panics on a `named` outright (*"must be resolved to a primitive before
//     lowering"*), that tag being the value's identity and never its storage. It is the same
//     identity-vs-storage split `payloadStorageOf` states for a union PAYLOAD slot, reached through the
//     same shared accessor so the two widths cannot come apart.
//   • **OWNED, not the immortal `.rdata` record a `let` shares.** A `var` is MUTATED — `msg.append("!")`
//     rewrites `buffer@0`/`length@8` in place — and mutating the one shared record would make every `let`
//     of the same literal observe the change, while dropping it would free read-only data. The spec
//     leak-gates exactly this (`static-variables.md`'s `top-level-var-string-mutate-cross-function`: "must
//     NOT be shared as an immortal static record: it mutates correctly and frees cleanly").
//
// ⭐⭐ **THEY ARE BUILT AT THE MAXON TIER, NOT THE STD TIER — the one design choice worth stating.** Every
// other compiler-synthesized function in the compiler (`installMmRuntime`, `installStringRuntime`, the destructor
// cascades) is built as already-lowered `StdOp`s and appended AFTER the pipeline. These two are not,
// because what they have to build is a LITERAL'S RECORD, and `LowerMaxonToStd` already knows how to build
// one from a single op: `stringLiteral` becomes the rdata blob + record + fixup, and `constArrayLiteral`
// becomes the ten-op owned-`Array`-over-immortal-blob sequence. Emitting Maxon ops costs six op
// constructions and reuses both; emitting Std ops would be a SECOND copy of `lowerConstArrayLiteral`,
// which is the duplication this compiler pays for hardest. So the price is the one thing a Maxon-tier
// function has to carry that a Std-tier one does not — its dense per-value type columns — and
// `SynthesizedFunction` below is that price, paid once.
//
// ⚠ **THE ENTRY STUB CALLS THEM, AND THE ENTRY STUB IS BUILT AFTER DEAD-FUNCTION ELIMINATION.** So they
// are ROOTED unconditionally in `DeadFunctionElimination.seedRoots` — the same treatment, for the same
// reason, as `__mm_leak_check`: nothing in the module calls them, and a pruned root leaves the stub's
// `call`/`bl`/`call $n` fixup with no target (loud on every backend, never silent).

// ⭐ **WHICH TAGS CARRY A NAME THAT WAS INTERNED SOMEWHERE — the question `projectScopedNameId` crosses on.**
// A primitive names nothing, and a `genericInstance` carries a whole-program `GenericInstanceId` rather than
// a name id (there is exactly ONE `GenericInstanceRegistry` in the compiler), so neither needs a crossing;
// these four are the tags whose id is an index into a TYPE-NAME table, and therefore table-relative.
function tagNamesAnIndexInternedType(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.named or tagNamesADeclaredType(tag) or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.function
end 'tagNamesAnIndexInternedType'

// The synthesized names. `__`-prefixed, so `isCompilerInternalCallee` treats them as the compiler's
// own (no E3004, no signature slotting) and `TargetPrinter.isRuntimeFunction` keeps them out of the
// rendered Target IR — a program with no managed global and no live `default` emits none.
export let ModuleInitName = b"__module_init"
export let GlobalCleanupName = b"__maxon_global_cleanup"
export let RegistryReleaseName = b"__maxon_registry_release"

// `__maxon_global_cleanup`'s single parameter — `main`'s ExitCode — occupying the ValueId the parameter
// numbering reserves for argument 0. See `buildGlobalCleanup` for why the function takes and returns it.
let ExitCodeParam = 0 as ValueId

// ⭐ **BUILD THE FUNCTIONS INTO `module`, AND ANSWER WHETHER THE PROGRAM HAS ANY.** The single bit every
// entry stub reads (`RuntimeUsage.usesManagedGlobals`), decided HERE — where the arena is walked — rather
// than re-derived downstream by probing the module for a function name. That is the same discipline
// `BackendDispatch`'s header states for the GT/leak gates, and for the reason it states: dead-function
// elimination can take an installed function back out, so "is it still there?" is not the same question as
// "was it installed?".
//
// A program with no managed global and no live `default` builds NOTHING — no functions, no ops, no `.data`
// — which is what keeps the entire existing corpus byte-neutral.
export function installManagedGlobalInit(module MaxonModule, project Project, globals ManagedGlobalArray, sharedLets SharedLetArray, defaults DefaultSlotArray) returns bool
	if globals.count() == 0 and defaults.count() == 0 'noManagedGlobals'
		return false
	end 'noManagedGlobals'

	let site = anchorSite(globals, defaults: defaults)
	buildModuleInit(module, project: project, globals: globals, sharedLets: sharedLets, defaults: defaults, site: site)
	buildGlobalCleanup(module, project: project, globals: globals, site: site)

	if defaults.count() > 0 'aRegistry'
		buildRegistryRelease(module, project: project, defaults: defaults, site: site)
	end 'aRegistry'

	return true
end 'installManagedGlobalInit'

// A `let` `__module_init` marks shared, and the walk that marks it.
export type SharedLet
	export let global as ManagedGlobal
	export let walk as ByteArray

	static function create(global ManagedGlobal, walk ByteArray) returns SharedLet
		return Self{global: global, walk: walk}
	end 'create'
end 'SharedLet'

export typealias SharedLetArray = Array with SharedLet

// The `let`s of a program that spawns a service, split by whether a share walk can mark them.
export type LetShareWalks
	export let marked as SharedLetArray

	// The `let`s no share walk can mark; what each holds that none can is its `threadReach`.
	export let unmarkable as ManagedGlobalArray

	static function create(marked SharedLetArray, unmarkable ManagedGlobalArray) returns LetShareWalks
		return Self{marked: marked, unmarkable: unmarkable}
	end 'create'
end 'LetShareWalks'

// ⭐ **ONLY A PROGRAM THAT SPAWNS A SERVICE HAS A SECOND GREEN THREAD THAT COUNTS A GLOBAL**, so a program that
// spawns none marks nothing. An unmarkable `let` stays a plain count: `ServiceGlobalAccessCheck` refuses it where a
// message can read it.
export function letShareWalksOf(globals ManagedGlobalArray, spawnsAService bool) returns LetShareWalks
	var marked = SharedLetArray.create()
	var unmarkable = ManagedGlobalArray.create()

	if spawnsAService 'aSecondGreenThreadMayCount'
		for global in globals 'eachGlobal'
			match global.threadReach 'reach'
				mainOnly or
				packedInItsSlot then continue
				everyThreadThrough(callee) then marked.push(SharedLet.create(global, walk: callee))
				everyThreadUnwalkable then unmarkable.push(global)
			end 'reach'
		end 'eachGlobal'
	end 'aSecondGreenThreadMayCount'

	return LetShareWalks.create(marked, unmarkable: unmarkable)
end 'letShareWalksOf'

// `__module_init()` — for each managed global, in the order it was handed: build its initial owned record
// and store the record's address into its `.data` slot.
//
// ⚠ **THE STORE IS BARE — NO LOAD OF THE OLD VALUE AND NO DECREF.** The slot is guaranteed zero here: the
// `.data` image put it there, and the only code that could have overwritten it is an EARLIER initializer's
// — which would be a write to this slot, and a write is a `globalAddr` `GlobalInitOrder` reads as a
// dependency, so that initializer runs after this store rather than before it. A decref would therefore be
// reading a null pointer. The user-visible re-assignment lives in `Parser.emitCheckedGlobalStore` and this
// initialization lives here, so the fact ("this store is the first one") is expressed by WHICH CODE EMITS
// IT rather than by a test in the middle of a lowering.
//
// ⭐⭐ **THE ORDER IS DEPENDENCY ORDER, AND CORRECTNESS DOES DEPEND ON IT.** An initializer's body may call,
// and a callee may read another global's slot — so a global must be built after every global it reads.
// `GlobalInitOrder.dependencyOrderedGlobals` is what settles that, over the merged module's call graph, and
// it is the caller's to apply: this function emits the array it is handed, in the order it is handed. A
// cycle has no such order and is refused there rather than reaching this loop.
function buildModuleInit(module MaxonModule, project Project, globals ManagedGlobalArray, sharedLets SharedLetArray, defaults DefaultSlotArray, site SynthesizedSite)
	var fn = SynthesizedFunction.open(module, project: project, name: ModuleInitName, returnType: MaxonReturnType.void, paramTypes: MaxonTypeArray.create())

	for global in globals 'eachGlobal'
		let record = initialRecordOf(fn, global: global)
		fn.emit(MaxonOp.storeIndirect(fn.emitSlotAddr(global), offset: GlobalSlotOffset, value: record, valueType: declaredAggregateSlotWidth()), site: globalSite(global))
	end 'eachGlobal'

	if sharedLets.count() > 0 'messagesReadTheLets'
		markLetsShared(fn, sharedLets: sharedLets, site: site)
	end 'messagesReadTheLets'

	// After the marks: a `default` may spawn, and a service started before them could step a plain
	// count concurrently with the mark — E3164's reason. The order among the defaults is
	// `GlobalInitOrder.dependencyOrderedDefaults`'.
	for slot in defaults 'eachDefault'
		buildDefault(fn, slot: slot)
	end 'eachDefault'

	fn.terminate(MaxonOp.retVoid, site: site)
end 'buildModuleInit'

function buildDefault(fn SynthesizedFunction, slot DefaultSlot)
	let site = defaultSite(slot)
	let value = fn.emitPositionalCall(slot.initializer, args: ValueIdArray.create(), resultTag: maxonTypeTag(slot.valueType), resultNameId: typeNameIdOf(slot.valueType), site: site)
	let slotAddr = fn.emitLabelAddr(slot.label, site: site)

	match slot.kind 'kind'
		service then fn.emitPositionalCallDiscarding(RegistryServiceInstallName, args: pairArgs(slotAddr, second: value), site: site)
		value(dropCallee, retainCallee, shareWalk) then buildDefaultValue(fn, value: value, slotAddr: slotAddr, dropCallee: dropCallee, retainCallee: retainCallee, shareWalk: shareWalk, site: site)
	end 'kind'
end 'buildDefault'

function buildDefaultValue(fn SynthesizedFunction, value ValueId, slotAddr ValueId, dropCallee OwnershipCallee, retainCallee OwnershipCallee, shareWalk TransferWalk, site SynthesizedSite)
	// Marked before the install publishes it: from then on any thread may retain it.
	emitDefaultShareWalk(fn, value: value, shareWalk: shareWalk, site: site)

	var installArgs = ValueIdArray.create()
	installArgs.push(slotAddr)
	installArgs.push(value)
	installArgs.push(runtimeFunctionOrNone(fn, callee: dropCallee, site: site))
	installArgs.push(runtimeFunctionOrNone(fn, callee: retainCallee, site: site))
	fn.emitPositionalCallDiscarding(SharedValueInstallName, args: installArgs, site: site)
end 'buildDefaultValue'

function emitDefaultShareWalk(fn SynthesizedFunction, value ValueId, shareWalk TransferWalk, site SynthesizedSite)
	match shareWalk 'walk'
		closed then return
		walkedBy(callee) then emitSettledWalk(fn, value: value, walk: callee, site: site)
		walkedAlone(callee) then fn.emitPositionalCallDiscarding(callee, args: singletonArgs(value), site: site)
		walkedThroughWitness then panic("emitDefaultShareWalk: a registry value is a declared struct, and a declared struct's graph is walked by its own per-type walk rather than through a witness")
		refused then panic("emitDefaultShareWalk: `Parser.requireShareableRegistryValue` refuses a key no share walk can mark (E3171)")
	end 'walk'
end 'emitDefaultShareWalk'

function emitSettledWalk(fn SynthesizedFunction, value ValueId, walk ByteArray, site SynthesizedSite)
	let visits = fn.emitPositionalCall(walk, args: pairArgs(value, second: fn.emitTypedLiteral(NoVisitTable, valueType: MaxonType.integer, site: site)), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, site: site)
	fn.emitPositionalCallDiscarding(WalkSettleName, args: singletonArgs(visits), site: site)
end 'emitSettledWalk'

function runtimeFunctionOrNone(fn SynthesizedFunction, callee OwnershipCallee, site SynthesizedSite) returns ValueId
	return match callee 'callee'
		inert gives fn.emitTypedLiteral(NoRuntimeFunction, valueType: MaxonType.integer, site: site)
		named(name) gives fn.emitCodeAddress(name, site: site)
	end 'callee'
end 'runtimeFunctionOrNone'

// ⭐⭐ **EVERY MARKABLE `let` RECORD IS MARKED SHARED BEFORE `main` RUNS**, so the count every message steps on it
// is atomic; no other green thread exists yet, because a `spawn` a global initializer can reach is refused
// (`ServiceGlobalAccessCheck`). One visit table serves every `let`, because a record two of them reach has both
// slots as owners; `__mm_walk_settle` aborts on an owner no `let` holds, which is a record a `var` could still
// write. It runs after the LAST store, when no initializer temporary holds a record any more. A program with no
// walked `let` opens no table: `__mm_walk_settle` is installed only beside a walk.
function markLetsShared(fn SynthesizedFunction, sharedLets SharedLetArray, site SynthesizedSite)
	var visits = fn.emitTypedLiteral(NoVisitTable, valueType: MaxonType.integer, site: site)

	for shared in sharedLets 'eachLet'
		let record = fn.mintOfType(shared.global.valueType)
		fn.emit(MaxonOp.loadIndirect(record, addr: fn.emitSlotAddr(shared.global), offset: GlobalSlotOffset, valueType: declaredAggregateSlotWidth()), site: globalSite(shared.global))
		visits = fn.emitPositionalCall(shared.walk, args: pairArgs(record, second: visits), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, site: globalSite(shared.global))
	end 'eachLet'

	fn.emitPositionalCallDiscarding(WalkSettleName, args: singletonArgs(visits), site: site)
end 'markLetsShared'

// The OWNED value a managed global's slot starts life holding — either a record this function MATERIALIZES,
// or whatever its `__global_init.<label>` function RETURNS.
//
// ⭐ **THE INITIALIZER FUNCTION RUNS THE PROGRAM'S OWN CODE**, so dropping a dead slot must not drop it
// (`DeadGlobalElimination`'s header).
//
// ⭐ **THE PROGRAM'S OWN global whose initializer calls is kept alive by `contributesStorage` whatever
// reads its slot, so this run is never spliced out from under its side effects. A CORPUS global's is** —
// stdlib is loaded into every compile, so its slots are kept on liveness alone and an unread one is dropped
// with its call (`TopLevelDecl.declaredByTheCorpus`).
function initialRecordOf(fn SynthesizedFunction, global ManagedGlobal) returns ValueId
	return match global.initializer 'initializer'
		literal(build) gives builtRecord(fn, build: build, valueType: global.valueType, site: globalSite(global))
		initializerFunction(callee) gives fn.emitPositionalCall(callee, args: ValueIdArray.create(), resultTag: maxonTypeTag(global.valueType), resultNameId: typeNameIdOf(global.valueType), site: globalSite(global))
	end 'initializer'
end 'initialRecordOf'

// ⭐ **ONE RECORD, MATERIALIZED.** The two kinds differ in exactly one thing — how much of the record the literal's own materialization
// already is — and that difference is a fact about the record formats, not a choice made here:
//
//   • a **String** literal is a WHOLLY immortal `.rdata` record (`lowerStringLiteral`), shared by every
//     read of that literal in the program, so it is CLONED into a fresh owned heap String. `__str_clone`
//     is the `(box) -> newBox` dual of the `__str_decref` the cleanup drops it with, so the pair balances
//     by construction.
//   • a **constant array** literal — a `b"…"` byte string, or any all-constant `[…]` whose element stores
//     its own bytes — ALREADY materializes as an owned heap 48-byte `Array` record over an immortal
//     `.rdata` blob (`lowerConstArrayLiteral`), which is precisely what the slot must hold — so there is
//     nothing to clone. Its first receiver-writing method detaches the buffer off `.rdata`
//     (`byte-string-literal.push-grows-off-rdata`), which is what makes a MUTABLE one work.
function builtRecord(fn SynthesizedFunction, build ManagedGlobalRecord, valueType MaxonType, site SynthesizedSite) returns ValueId
	return match build 'build'
		stringRecord(bytes) gives clonedStringRecord(fn, bytes: bytes, valueType: valueType, site: site)
		constArrayRecord(elementSize, elementCount, bytes) gives ownedConstArrayRecord(fn, elementSize: elementSize, elementCount: elementCount, bytes: bytes, valueType: valueType, site: site)
	end 'build'
end 'builtRecord'

// The String arm: materialize the immortal `.rdata` literal, then CLONE it into a fresh owned heap
// String the slot can own, mutate and eventually free. Shared with the array build, whose STRING ELEMENTS
// need the identical promotion for the identical reason — the array's `element_destroy@40` walk drops every
// live slot, so an element must be a record its owner may free — which is why it takes the type and bytes
// rather than reading them off a global.
function clonedStringRecord(fn SynthesizedFunction, bytes ByteArray, valueType MaxonType, site SynthesizedSite) returns ValueId
	let literal = fn.mintOfType(valueType)
	fn.emit(MaxonOp.stringLiteral(literal, bytes: bytes), site: site)
	return fn.emitPositionalCall(StrCloneName, args: singletonArgs(literal), resultTag: maxonTypeTag(valueType), resultNameId: typeNameIdOf(valueType), site: site)
end 'clonedStringRecord'

// The constant-array arm: ONE op, because the literal's own materialization is already the owned heap
// record the slot must hold. The stride and the element count ride the description rather than being
// re-derived here — a `b"…"` fixes them from its bytes, an `[…]` from the instance it was typed by, and
// neither is a fact this function could re-ask without picking one of the two to be authoritative.
function ownedConstArrayRecord(fn SynthesizedFunction, elementSize ElementStride, elementCount FullRangeInt, bytes ByteArray, valueType MaxonType, site SynthesizedSite) returns ValueId
	let record = fn.mintOfType(valueType)
	fn.emit(MaxonOp.constArrayLiteral(record, elementSize: elementSize, elementCount: elementCount, bytes: bytes), site: site)
	return record
end 'ownedConstArrayRecord'

// ⭐ **THE TYPE A SCALAR LITERAL'S OP CARRIES — ITS STORAGE, WHICH IS NOT ITS IDENTITY.** Every scalar type
// is its own storage except a `named` one: a payload-free enum case and a ranged alias are both an i64, and
// the tier below has no `named` to lower. See `emitTypedLiteral` for the two ways the missing distinction
// bites.
function literalStorageType(valueType MaxonType) returns MaxonType
	return MaxonType.integer if maxonTypeTag(valueType) == ValueTypeTag.named else valueType
end 'literalStorageType'

// `__maxon_global_cleanup(exitCode) returns exitCode` — one decref per managed global that OWES a drop,
// after `main`. A global whose slot holds a VALUE rather than a pointer owes none and is skipped; it stays
// in the list because `__module_init` builds from the same list and does still have to fill its slot.
//
// ⭐ **IT TAKES AND RETURNS `main`'s EXIT CODE, AND THAT IS WHY IT IS SHAPED LIKE `__mm_leak_check`.** The
// call sits on the entry stub's exit path, between `main` and the leak gate, where the ONE live value is
// the exit code — in R8 on x64, x0 on arm64, on the operand stack on wasm. A void function would clobber
// it on x64 (a Maxon function returns in R8) and force each stub to invent a save/restore; a pass-through
// is what `__mm_leak_check` already does, so the stubs gain one call in an existing shape rather than a
// new one. The code is not read here — it flows through untouched.
//
// Every decref is unconditional and nothing here tests a slot for null: `__module_init` fills every slot in
// this list before `main`, so a null guard would test a condition the program cannot be in.
function buildGlobalCleanup(module MaxonModule, project Project, globals ManagedGlobalArray, site SynthesizedSite)
	var fn = openExitCodePassThrough(module, project: project, name: GlobalCleanupName)

	for global in globals 'eachGlobal'
		match global.cleanupDrop 'drop'
			inert then continue
			named(dropCallee) then emitGlobalCleanupDrop(fn, global: global, dropCallee: dropCallee)
		end 'drop'
	end 'eachGlobal'

	fn.terminate(MaxonOp.ret(ExitCodeParam), site: site)
end 'buildGlobalCleanup'

function emitGlobalCleanupDrop(fn SynthesizedFunction, global ManagedGlobal, dropCallee ByteArray)
	let record = fn.mintOfType(global.valueType)
	fn.emit(MaxonOp.loadIndirect(record, addr: fn.emitSlotAddr(global), offset: GlobalSlotOffset, valueType: declaredAggregateSlotWidth()), site: globalSite(global))
	fn.emitPositionalCallDiscarding(dropCallee, args: singletonArgs(record), site: globalSite(global))
end 'emitGlobalCleanupDrop'

function openExitCodePassThrough(module MaxonModule, project Project, name ByteArray) returns SynthesizedFunction
	var paramTypes = MaxonTypeArray.create()
	paramTypes.push(MaxonType.integer)
	return SynthesizedFunction.open(module, project: project, name: name, returnType: MaxonReturnType.value(MaxonType.integer), paramTypes: paramTypes)
end 'openExitCodePassThrough'

function buildRegistryRelease(module MaxonModule, project Project, defaults DefaultSlotArray, site SynthesizedSite)
	var fn = openExitCodePassThrough(module, project: project, name: RegistryReleaseName)

	for slot in defaults 'eachDefault'
		let slotAddr = fn.emitLabelAddr(slot.label, site: defaultSite(slot))
		let release = match slot.kind 'kind'
			service gives RegistryServiceReleaseName
			value gives SharedValueRegistryReleaseName
		end 'kind'

		fn.emitPositionalCallDiscarding(release, args: singletonArgs(slotAddr), site: defaultSite(slot))
	end 'eachDefault'

	fn.terminate(MaxonOp.ret(ExitCodeParam), site: site)
end 'buildRegistryRelease'

// The span a synthesized function's TERMINATOR carries. No source token spawns a `return` that the user
// did not write, so it rides the FIRST global's initializer — or, with none, the first `default`'s
// key — the declaration that caused the whole function to exist. The caller has already established
// the lists are not both empty (`installManagedGlobalInit` builds nothing then), so the miss is an
// invariant break rather than a case.
function anchorSite(globals ManagedGlobalArray, defaults DefaultSlotArray) returns SynthesizedSite
	if let global = try globals.get(0) 'aManagedGlobal'
		return globalSite(global)
	end 'aManagedGlobal'

	return defaultSite(try defaults.get(0) otherwise panic("anchorSite: no managed global and no default — `installManagedGlobalInit` returns before building a function when both lists are empty"))
end 'anchorSite'

function globalSite(global ManagedGlobal) returns SynthesizedSite
	return SynthesizedSite.declaredAt(global.declFilePath, range: global.range)
end 'globalSite'

function defaultSite(slot DefaultSlot) returns SynthesizedSite
	return SynthesizedSite.declaredAt(slot.declaration.declFilePath, range: slot.declaration.keyRange)
end 'defaultSite'

// `declaredAt` files a synthesized op under the declaration that caused it
// (`Project.synthesizedOpFiles`), so a diagnostic on the op names the author's file; an op with no
// such declaration is the compiler's own.
export union SynthesizedSite
	compilersOwn
	declaredAt(filePath FilePath, range SourceRange)

	export function range() returns SourceRange
		return match self 'site'
			compilersOwn gives SourceRange.none()
			declaredAt(_, range) gives range
		end 'site'
	end 'range'
end 'SynthesizedSite'

// ⭐ **A MAXON FUNCTION BUILT BY THE COMPILER RATHER THAN PARSED** — the emit + value-minting discipline
// `FileParseArtifact` gives the parser, for the one caller that has no artifact.
//
// **IT EXISTS FOR THE DENSE TYPE COLUMNS.** `LowerMaxonToStd` reads a value's tag out of
// `IrFunction.valueTags` for every op it lowers (`valueTagOf` PANICS on a value with no entry) and its
// name id out of `valueNameIds`, and it seeds `nextValueId` from `valueTags.count()` — so a ValueId
// allocated without an entry in all four columns would shift every later value's type by one. Minting
// through one door is what makes that impossible, exactly as `Parser.mintValue` does for parsed code.
//
// It records into `project.opRanges` and `project.valueOrigins` in the same lockstep
// `FileParseArtifact.emitOp` uses — the span table is keyed by op index and asserts it is appended in
// step, so a synthesized op that skipped it would misattribute every later span by one.
// ⭐ EXPORTED for `Runtime/ServiceLoop.maxon`, the second producer of Maxon-tier functions the compiler
// builds and the only one outside this file. Everything the carrier's header says is why
// it exists holds for that producer word for word: a `<T>.__loop` needs the dense per-value type columns
// `LowerMaxonToStd` reads, and a second carrier would be a second place they could fall out of lockstep.
export type SynthesizedFunction
	var module as MaxonModule
	var project as Project

	// This function's position in `module.functions` — the key `ValueOriginTable` files an origin under.
	var funcIndex as ElementIndex

	// The function itself, so a second block can be minted into it. Held BESIDE the index rather than looked
	// up from it because `MaxonModule` exposes no by-index accessor, and adding one to serve a single caller
	// would be a wider API than the need.
	var func as IrFunction
	var block as IrBlock
	var valueTags as ValueTypeTagArray
	var valueNameIds as TypeNameIdArray
	var valueBrandIds as TypeNameIdArray
	var valueMintedSole as BoolArray

	// Create the function, register it and its single `entry` block on `module`, and seed the value
	// columns with the parameters — whose ids (`0..paramCount-1`) the value numbering RESERVES rather than
	// mints, exactly as `Parser.recordValueType` does for a parsed function's parameters.
	export static function open(module MaxonModule, project Project, name ByteArray, returnType MaxonReturnType, paramTypes MaxonTypeArray) returns SynthesizedFunction
		var valueTags = ValueTypeTagArray.create()
		var valueNameIds = TypeNameIdArray.create()
		var valueBrandIds = TypeNameIdArray.create()
		var valueMintedSole = BoolArray.create()

		for paramType in paramTypes 'eachParam'
			valueTags.push(maxonTypeTag(paramType))
			valueNameIds.push(typeNameIdOf(paramType))
			valueBrandIds.push(UnnamedTypeId)
			valueMintedSole.push(false)
		end 'eachParam'

		// ⚠ `synthesized()` is a POSITIVE claim, not a default: it is what makes `__module_init` /
		// `__maxon_global_cleanup` read as the compiler's own at `FunctionNameIndex.refuseDuplicateFunctionName`
		// (so a `Builtins.maxon` declaration of one is E4015 against them, and a doubled install is a panic), at
		// `DeadFunctionElimination.markCompilerOwnedRoot` (E4015 again, for a program that installs neither and
		// so has no pair to count) and at `TargetPrinter.isRuntimeFunction`. Both functions run on `main`'s green
		// thread in a program with green threads, so both carry its stack guard (`IrFunction.needsGreenThreadStackGuard`).
		var func = IrFunction.create(name, maxonReturnType: returnType, paramCount: paramTypes.count() as ParamCount, maxonParamTypes: paramTypes, typeSites: project.readerAnchors.functions.noTypeSites, valueTags: valueTags, valueNameIds: valueNameIds, valueBrandIds: valueBrandIds, valueMintedSole: valueMintedSole, valueWitnessIds: ValueIdArray.create(), declaredAt: SourcePosition.synthesized(), placeholders: project.readerAnchors.functions, needsGreenThreadStackGuard: true)
		let funcIndex = module.funcCount()
		module.pushFunc(func)

		return Self{module: module, project: project, funcIndex: funcIndex, func: func, block: module.addBlock(func, label: b"entry", heat: BlockHeat.normal), valueTags: valueTags, valueNameIds: valueNameIds, valueBrandIds: valueBrandIds, valueMintedSole: valueMintedSole}
	end 'open'

	// Allocate a fresh ValueId AND record its type, in lockstep — `Parser.mintValue`'s twin over the
	// columns this function owns. The id IS the column height before the push, which is the same dense
	// numbering `LowerMaxonToStd` resumes from.
	//
	// It takes a TAG rather than a `MaxonType` for `Parser.mintValue`'s reason and one of its own: a
	// runtime drop's result is `void`, which is a `ValueTypeTag` and deliberately NOT a `MaxonType` (see
	// MaxonDialect — void names no value).
	export function mint(tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let id = self.valueTags.count()
		self.valueTags.push(tag)
		self.valueNameIds.push(self.projectScopedNameId(tag, nameId: nameId))
		self.valueBrandIds.push(UnnamedTypeId)
		self.valueMintedSole.push(false)
		return id
	end 'mint'

	// Mint a value whose type is already in hand — decomposing the union rather than constructing one,
	// exactly as `Parser.mintValueOfType` does.
	export function mintOfType(valueType MaxonType) returns ValueId
		return self.mint(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType))
	end 'mintOfType'

	// ⭐⭐ **EVERY NAME ID THIS CARRIER MINTS CROSSES FROM THE SIGNATURE INDEX'S TABLE INTO THE PROJECT'S,
	// HERE, AND ONCE.** These two functions are built from types the INDEX resolved
	// (`ProgramSignatures.managedGlobals`), and their ops are appended to the MERGED module, whose readers
	// speak `project.typeNames`. `ProgramSignatures`' own rule says what that costs: *"names travel between
	// interners; ids never do"* — an id means whatever name happens to sit at that number in the other table.
	//
	// It sits in `mint` rather than at the five emit sites because that is the ONE place a value of this
	// carrier gets its type columns, and a door list is what rots.
	//
	// ⛔⛔ **SO A `mint` TAKES AN INDEX-SPACE ID AND `open` TAKES A PROJECT-SPACE ONE, AND THE TWO HALVES OF
	// THIS CARRIER GENUINELY DISAGREE.** `open` pushes `typeNameIdOf(paramType)` RAW, because the
	// same `paramTypes` array is stored on the `IrFunction` for the merged module to read, and the module
	// speaks the project's table. There is no crossing that could satisfy both, so the contract is:
	//
	//   • **`paramTypes` handed to `open` are PROJECT-space.**
	//   • **`nameId` handed to `mint` / `mintOfType` / `emitPositionalCall(resultNameId:)` is INDEX-space**,
	//     and is crossed here.
	//
	// ⚠ The split is INVISIBLE from inside this file: `__module_init` and `__maxon_global_cleanup` take one
	// `int` parameter between them, so `open`'s half is never exercised with a NAMED type. A producer that
	// resolves its types through `project.typeNames` and then mints from them crosses twice, and a double
	// crossing REFUSES a correct program — `Runtime/ServiceLoop.maxon`'s header carries that reading. A third
	// producer should read this box before it writes a `mint`.
	function projectScopedNameId(tag ValueTypeTag, nameId TypeNameId) returns TypeNameId
		if not tagNamesAnIndexInternedType(tag) 'carriesNoNameToCross'
			return nameId
		end 'carriesNoNameToCross'

		var signatures = try queryProgramSignatures(self.project) otherwise panic("ModuleInit.projectScopedNameId: queryProgramSignatures failed while synthesizing a module initializer — it is computed and memoized before the pipeline runs, so it cannot fail fresh here")
		return self.project.typeNames.intern(signatures.indexSpaceTypeName(maxonTypeOfTag(tag, nameId: nameId)))
	end 'projectScopedNameId'

	// ⭐ **THE ADDRESS OF A MANAGED GLOBAL'S `.data` SLOT** — `globalAddr <label>`, minted as a pointer
	// (`Parser.emitGlobalAddr`'s twin on this carrier). BOTH synthesized functions open every global with
	// it, so it is one method rather than two identical pairs of lines: `__module_init` writes the slot and
	// `__maxon_global_cleanup` reads it, and if those two ever derived the address differently the init
	// would fill one slot while the cleanup dropped another — a wrong answer at run time, on a program the
	// compiler accepted. The OFFSET is not repeated for the same reason: `GlobalSlotOffset` is the one
	// constant both stores and loads spell.
	function emitSlotAddr(global ManagedGlobal) returns ValueId
		return self.emitLabelAddr(global.label, site: globalSite(global))
	end 'emitSlotAddr'

	function emitLabelAddr(label ByteArray, site SynthesizedSite) returns ValueId
		let addr = self.mintOfType(MaxonType.integer)
		self.emit(MaxonOp.globalAddr(addr, label: label), site: site)
		return addr
	end 'emitLabelAddr'

	// Pair a value held at an interface type with the value holding its witness half —
	// `Parser.pairInterfaceWitness`'s twin over this carrier's function, whose column the lowering reads
	// (`LowerMaxonToStd.pairedWitnessOf`).
	export function pairWitness(value ValueId, witness ValueId)
		while self.func.valueWitnessIds.count() as ValueId <= value 'growToReachIt'
			self.func.valueWitnessIds.push(0)
		end 'growToReachIt'

		try self.func.valueWitnessIds.set(value, value: witness) otherwise panic("SynthesizedFunction.pairWitness: value v{value} has no witness slot after the column was grown to reach it")
	end 'pairWitness'

	// The witness half paired with `value`. Unpaired is a synthesis invariant break, for
	// `Parser.witnessOfValue`'s reason.
	export function witnessOf(value ValueId) returns ValueId
		let witness = try self.func.valueWitnessIds.get(value) otherwise 0 as ValueId

		if witness == 0 'unpaired'
			panic("SynthesizedFunction.witnessOf: v{value} in '{String.from(self.func.name)}' is held at an interface type with no witness half paired — every producer of one pairs it where it mints it")
		end 'unpaired'

		return witness
	end 'witnessOf'

	// Append a body op, recording its span and the origin of the value it defines — the choke point
	// `FileParseArtifact.emitOp` is for parsed code, and it keeps the identical two invariants.
	export function emit(op MaxonOp, site SynthesizedSite)
		let opIndex = self.module.opCount()
		self.module.appendOp(self.block, op: op)
		self.recordOpTables(op, opIndex: opIndex, site: site)
	end 'emit'

	// ⭐ **OPEN A FRESH BLOCK AND CONTINUE EMITTING INTO IT.**
	//
	// ⚠ **IT DOES NOT TERMINATE THE BLOCK IT LEAVES.** A block's terminator is the caller's statement about
	// control flow and there is no default that is right for both a fall-through and a two-way branch;
	// leaving it unset makes a forgotten terminator a loud IR failure rather than a silently invented edge.
	export function openBlock(label ByteArray) returns IrBlock
		var opened = self.module.addBlock(self.func, label: label, heat: BlockHeat.normal)
		self.block = opened
		return opened
	end 'openBlock'

	// The block ops are currently landing in — the half `openBlock` cannot give a caller that needs to
	// terminate the block it was ALREADY in (a diamond's head, minted before either successor existed).
	export function currentBlock() returns IrBlock
		return self.block
	end 'currentBlock'

	// Continue emitting into a block already opened — the half `openBlock` cannot express, since a routine
	// with a diamond has to come back to a block it minted earlier.
	export function resumeBlock(target IrBlock)
		self.block = target
	end 'resumeBlock'

	// Set the terminator of a block that is not the current one — the two-way branch a diamond's head needs,
	// written after both successors exist.
	export function terminateBlock(target IrBlock, op MaxonOp, site SynthesizedSite)
		let opIndex = self.module.opCount()
		self.module.setTerminator(target, op: op)
		self.recordOpTables(op, opIndex: opIndex, site: site)
	end 'terminateBlock'

	// Terminate the block ops are CURRENTLY landing in. It is `terminateBlock` over `self.block` and nothing
	// else, because how a terminator joins the op tables must not be written twice.
	export function terminate(op MaxonOp, site SynthesizedSite)
		self.terminateBlock(self.block, op: op, site: site)
	end 'terminate'

	// The span + value-origin recording both emitters share, so a body op and a terminator cannot come to
	// disagree about which tables an op joins.
	function recordOpTables(op MaxonOp, opIndex ElementIndex, site SynthesizedSite)
		self.project.opRanges.record(opIndex, range: site.range())

		match site 'site'
			compilersOwn then break
			declaredAt(filePath, _) then self.project.synthesizedOpFiles.upsert(opIndex, value: filePath)
		end 'site'

		let id = try maxonOpDefinedValue(op) otherwise return
		self.project.valueOrigins.record(self.funcIndex, valueId: id, opIndex: opIndex)
	end 'recordOpTables'

	// ⭐ **A `literal`** — a visit table, a null runtime function, an allocation size, a sentinel. Every
	// caller passes `MaxonType.integer`, because the Maxon tier has no pointer or size type: a machine word
	// is an integer here, the same reading `emitSlotAddr` above gives an ADDRESS.
	//
	// It does NOT record the value in a constant column, and `Parser.emitLiteralIn` does: that column is the
	// PARSER's constant view, feeding the shift-count rule and `foldConstOperands` over source the user
	// wrote. Nothing here is folded against anything, so there is no view to keep.
	// ⭐⭐ **THE VALUE'S IDENTITY AND THE OP'S STORAGE ARE TWO ANSWERS, AND AN ENUM CASE IS WHERE THEY PART.**
	// `Parser.emitEnumTagLiteral` makes the same split for a body's `Color.red`: the VALUE is `named(Color)`
	// — which is what an argument check compares against a `Color` parameter — while the OP carries
	// `integer`, because a payload-free enum's value IS its i64 tag and `maxonTypeToStdType` panics outright
	// on a `named` (*"must be resolved to a primitive before lowering"*).
	export function emitTypedLiteral(value FullRangeInt, valueType MaxonType, site SynthesizedSite) returns ValueId
		let result = self.mintOfType(valueType)
		self.emit(MaxonOp.literal(result, value: value, valueType: literalStorageType(valueType)), site: site)
		return result
	end 'emitTypedLiteral'

	// ⭐ **THE HEAP RECORD A STRUCT-SHAPED LITERAL LIVES IN** — `Parser.emitBoxAlloc`'s twin on this
	// carrier, and the ONE genuinely new emit primitive this file needed: the size, the trivial destructor and
	// the `__mm_alloc` are one sequence, so a change to what a record COSTS — a header, an alignment, another
	// allocator door — reaches both producers or neither.
	//
	// ⚠ **THE PARSER'S DOOR ALSO ENROLS THE BOX AS AN OWNED TEMPORARY (`trackOwnedTemp`), AND THIS ONE MUST
	// NOT.** That enrolment is a STATEMENT's drop obligation, and `__module_init` has no statement: the box
	// this returns is stored straight into a `.data` slot (or into an enclosing box), whose owner then drops it
	// through `__maxon_global_cleanup` or through a destructor cascade. That difference is why the two are
	// twins rather than one function on a shared carrier.
	function emitBoxAlloc(sizeBytes FullRangeInt, resultTag ValueTypeTag, resultNameId TypeNameId, site SynthesizedSite) returns ValueId
		var allocArgs = ValueIdArray.create()
		allocArgs.push(self.emitTypedLiteral(sizeBytes, valueType: MaxonType.integer, site: site))
		allocArgs.push(self.emitTypedLiteral(TrivialDestructor, valueType: MaxonType.integer, site: site))
		return self.emitPositionalCall(MmAllocName, args: allocArgs, resultTag: resultTag, resultNameId: resultNameId, site: site)
	end 'emitBoxAlloc'

	// A two-operand comparison yielding an i1 — `Parser.emitCompareAgainstLiteral`'s twin on this carrier,
	// minted at the `boolean` tag its `condBranch` consumer expects.
	//
	// ⭐ **SIGNED, AND THE CALLER HAS NO RANGED TYPE TO SAY OTHERWISE.** Every comparison this carrier
	// builds is an equality or inequality against a word the compiler mints itself, whose two readings are
	// the same instruction. There is no source operand here whose declared range could ask for anything
	// else, so the answer is stated rather than threaded.
	export function emitCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, site SynthesizedSite) returns ValueId
		let result = self.mint(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.emit(MaxonOp.compare(result, lhs: lhs, rhs: rhs, op: op, signedness: IntegerSignedness.signed), site: site)
		return result
	end 'emitCompare'

	// The raw `.text` ADDRESS of a compiler-internal runtime function, as a value —
	// `Parser.emitCodeAddress`'s twin on this carrier, for the array element destructor
	// `__managed_create` stamps into `element_destroy@40`.
	//
	// The value is typed `integer` for `emitSlotAddr`'s reason (an address is a machine word, and the Maxon
	// tier has no pointer type) rather than a `function` type: a function VALUE
	// may be BOUND by user code, whose type then has to name the function, while this one is an
	// argument and nothing else.
	function emitCodeAddress(callee ByteArray, site SynthesizedSite) returns ValueId
		let result = self.mintOfType(MaxonType.integer)
		self.emit(MaxonOp.functionRef(result, funcName: callee, form: FunctionRefForm.codeAddress), site: site)
		return result
	end 'emitCodeAddress'

	// ⭐ **A CALL WHOSE ARGUMENTS ARE ALL POSITIONAL** — every runtime entry point (`__str_clone`,
	// `__str_decref`, `__managed_create`, `__managed_push`), because the runtime has no parameter names for a label to
	// match, AND a global's initializer function, which takes no arguments at all.
	export function emitPositionalCall(callee ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultNameId TypeNameId, site SynthesizedSite) returns ValueId
		let result = self.mint(resultTag, nameId: resultNameId)
		self.emit(MaxonOp.call(result, callee: callee, args: args, argLabels: emptyArgLabels(args), argRanges: uniformArgRanges(args, range: site.range()), argImmutableNames: NoImmutableArgNames, defaultedArgs: NoDefaultedArgs, mint: CalleeMint.notMinted), site: site)
		return result
	end 'emitPositionalCall'

	// ⭐ **A POSITIONAL CALL WHOSE RESULT NOBODY READS** — a drop, a runtime step, a mailbox close. It is
	// `emitPositionalCall` with `void`/`UnnamedTypeId` and the result discarded, which keeps a three-part
	// incantation in ONE spelling: the `_ =`, the `ValueTypeTag.void` and the `UnnamedTypeId` are one fact —
	// *this call answers nothing* — and `Runtime/ServiceLoop.maxon` makes eight more of them.
	export function emitPositionalCallDiscarding(callee ByteArray, args ValueIdArray, site SynthesizedSite)
		_ = self.emitPositionalCall(callee, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, site: site)
	end 'emitPositionalCallDiscarding'
end 'SynthesizedFunction'
