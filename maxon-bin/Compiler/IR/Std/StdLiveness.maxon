// StdLiveness — the live ranges of one Std function's values, walked one value at a time and
// handed to a `LiveRangeVisitor`, which counts only the nodes it asks about. No live-in list is
// built per block: one per block for every value would be the blocks times the values.
//
// ⭐ **SOLVED PER VALUE, NOT BY A FIXPOINT SWEEP.** SSA gives every value one definition, so its live
// range is exactly the blocks a backward walk reaches from its uses before meeting that definition — and
// marking those costs the size of the range and nothing else. An iterative sweep over the blocks costs the
// blocks times the number of rounds, and a backward flow needs a round per level of loop nesting, which
// the register allocator's own solver (`TargetLiveness.solveLivenessSsa`) declines to pay for the same
// reason: a nest as deep as the program is long makes the sweep quadratic.
//
// ⭐ **ONE WORKSPACE, RECOMPUTED PER FUNCTION.** Asked by the inliner's register-pressure estimate
// thousands of times per compile, so the workspace's columns are kept and refilled.

// One stamp per node, so a value's walk marks each node once without a set per value. The stamp
// counts up across every function the workspace serves, so a column that keeps stale entries from a
// larger function never reads one as marked.
typealias WalkStamp = int(0 to u64.max)
typealias WalkStampColumn = Array with WalkStamp

// A cost gate, not a correctness bound: the prune never changes an answer, and below this many
// nodes its own walks cost more than they save.
let ReachMinNodes = 64

interface LiveRangeVisitor
	function isSatisfied(mutable self) returns bool
	function wantsValue(valueId ValueId) returns bool
	function visitLiveNode(mutable self, valueId ValueId, node ElementIndex)
end 'LiveRangeVisitor'

type PeakCounter implements LiveRangeVisitor
	var heldParams as FixedBoolArray
	var queried as BoolArray
	var counts as RegCountColumn
	let cap as RegCount
	var peak as RegCount

	static function create(heldParams FixedBoolArray, queried BoolArray, counts RegCountColumn, cap RegCount) returns PeakCounter
		return Self{heldParams: heldParams, queried: queried, counts: counts, cap: cap, peak: 0}
	end 'create'

	function capped() returns RegCount
		return (self.cap + 1) if self.peak > self.cap else self.peak
	end 'capped'

	function isSatisfied() returns bool
		return self.peak > self.cap
	end 'isSatisfied'

	function wantsValue(valueId ValueId) returns bool
		if not valueIsAParameter(valueId, paramCount: self.heldParams.count() as ParamCount) 'aBodyValue'
			return true
		end 'aBodyValue'

		return not (try self.heldParams.get(paramPositionOfValueId(valueId)) otherwise panic("PeakCounter.wantsValue: heldParams.get OOB at {valueId}"))
	end 'wantsValue'

	function visitLiveNode(_ ValueId, node ElementIndex)
		if not (try self.queried.get(node) otherwise panic("PeakCounter.visitLiveNode: queried.get OOB at {node}")) 'notAsked'
			return
		end 'notAsked'

		let count = (try self.counts.get(node) otherwise panic("PeakCounter.visitLiveNode: counts.get OOB at {node}")) + 1
		try self.counts.set(node, value: count) otherwise panic("PeakCounter.visitLiveNode: counts.set OOB at {node}")

		if count > self.peak 'aNewPeak'
			self.peak = count
		end 'aNewPeak'
	end 'visitLiveNode'
end 'PeakCounter'

type StdLiveness
	// Nodes are the blocks, then one continuation per cut: node `blockCount + k` is the rest of its
	// block after cut `k`.
	var blockCount as ElementIndex
	var nodeCount as ElementIndex

	var blockSucc as CsrGraph

	var succ as CsrGraph
	var pred as CsrGraph

	// Value id -> the node defining it; `nodeCount` for a value no node defines, such as a
	// parameter, which `QueriedReach.restrictsAt` reads as unpruned.
	var definedIn as BlockPositionColumn

	var useValue as CsrColumn
	var useBlock as CsrColumn
	var useGraph as CsrGraph

	var noCuts as BlockPositionColumn
	var reach as QueriedReach
	var queried as BoolArray
	var counts as RegCountColumn

	var liveNodes as BlockPositionColumn
	var liveNodeCount as ElementIndex

	var reads as StdValueUseSet
	var def as StdDefinedValues
	var marked as WalkStampColumn
	var stamp as WalkStamp
	var stack as BlockPositionColumn

	static function create() returns StdLiveness
		let empty = CsrGraph.create(CsrColumn.create(0), list: CsrColumn.create(0))
		return Self{blockCount: 0, nodeCount: 0, blockSucc: empty, succ: empty, pred: empty, definedIn: BlockPositionColumn.create(0), useValue: CsrColumn.create(0), useBlock: CsrColumn.create(0), useGraph: empty, noCuts: BlockPositionColumn.create(0), reach: QueriedReach.create(), queried: BoolArray.create(0), counts: RegCountColumn.create(0), liveNodes: BlockPositionColumn.create(0), liveNodeCount: 0, reads: StdValueUseSet.createRecordingIds(), def: StdDefinedValues.create(), marked: WalkStampColumn.create(0), stamp: 0, stack: BlockPositionColumn.create(0)}
	end 'create'

	function recomputeBlocks(module StdModule, func IrFunction, valueBound ValueId)
		self.recomputeSegmented(module, func: func, valueBound: valueBound, cutBlock: self.noCuts, cutOp: self.noCuts)
	end 'recomputeBlocks'

	// Cut `k` ends its block's segment after the op at (`cutBlock[k]`, `cutOp[k]`), so the values
	// live across that op are exactly node `blockCount + k`'s live-in. The op's reads stay in the
	// segment it ends and its defs open the continuation, so a value the op defines is never live
	// into it.
	function recomputeSegmented(module StdModule, func IrFunction, valueBound ValueId, cutBlock BlockPositionColumn, cutOp BlockPositionColumn)
		self.blockCount = func.blockRefs.count()
		self.nodeCount = self.blockCount + cutBlock.count()
		self.definedIn.resize(valueBound)

		for v in 0 upto valueBound 'eachValue'
			try self.definedIn.set(v, value: self.nodeCount) otherwise panic("StdLiveness.recomputeSegmented: definedIn.set OOB at {v}")
		end 'eachValue'

		self.blockSucc = buildStdSuccessorGraph(module, func: func, blockCount: self.blockCount)

		if cutBlock.count() == 0 'noSegments'
			self.succ = self.blockSucc
		end 'noSegments' else 'segmented'
			self.succ = self.segmentedSuccessors(cutBlock)
		end 'segmented'

		self.pred = reversedGraph(self.succ)

		self.useGraph = self.collectDefsAndUses(module, func: func, cutBlock: cutBlock, cutOp: cutOp)
		self.marked.resize(self.nodeCount)
	end 'recomputeSegmented'

	// Answers min(peak, `cap + 1`). A caller compares only its sum against a budget, and every
	// peak past `cap` fails it alike, so the walk stops at the first count past `cap`.
	function peakLiveIn(module StdModule, func IrFunction, valueBound ValueId, heldParams FixedBoolArray, cap RegCount) returns RegCount
		self.recomputeBlocks(module, func: func, valueBound: valueBound)
		let loops = NaturalLoops.find(self.succ, nodeCount: self.blockCount as CsrIndex)
		let loopless = loops.headers.count() == 0
		self.queried.refill(self.blockCount, value: loopless)

		for header in loops.headers 'eachHeader'
			try self.queried.set(header, value: true) otherwise panic("StdLiveness.peakLiveIn: queried.set OOB at {header}")
		end 'eachHeader'

		if loopless 'everyBlockIsAsked'
			self.reach.disable()
		end 'everyBlockIsAsked' else 'onlyHeadersAreAsked'
			self.reach.build(self.succ, queried: self.queried)
		end 'onlyHeadersAreAsked'

		self.counts.refill(self.blockCount, value: 0)
		let counter = PeakCounter.create(heldParams, queried: self.queried, counts: self.counts, cap: cap)
		self.walkLiveRanges(valueBound, visitor: counter)

		return counter.capped()
	end 'peakLiveIn'

	function walkLiveRanges(valueBound ValueId, visitor LiveRangeVisitor)
		for valueId in 0 upto valueBound 'eachValue'
			if visitor.isSatisfied() 'nothingMoreToLearn'
				return
			end 'nothingMoreToLearn'

			if not visitor.wantsValue(valueId) 'notAsked'
				continue
			end 'notAsked'

			self.rangeOf(valueId)

			for i in 0 upto self.liveNodeCount 'eachLiveNode'
				visitor.visitLiveNode(valueId, node: self.nodeAt(i))
			end 'eachLiveNode'
		end 'eachValue'
	end 'walkLiveRanges'

	function askAboutContinuations()
		self.queried.refill(self.nodeCount, value: false)

		for node in self.blockCount upto self.nodeCount 'eachContinuation'
			try self.queried.set(node, value: true) otherwise panic("StdLiveness.askAboutContinuations: queried.set OOB at {node}")
		end 'eachContinuation'

		self.reach.build(self.succ, queried: self.queried)
	end 'askAboutContinuations'

	function continuationsByDescendingRank() returns BlockPositionColumn
		let cuts = BlockPositionColumn.create(0)
		let cutCount = self.nodeCount - self.blockCount

		if not self.reach.isEnabled() 'ranksAreUnknown'
			for cut in 0 upto cutCount 'eachCut'
				cuts.push(cut)
			end 'eachCut'

			return cuts
		end 'ranksAreUnknown'

		let rankColumn = CsrColumn.create(cutCount, zeroed: false)
		let cutColumn = CsrColumn.create(cutCount, zeroed: false)

		for cut in 0 upto cutCount 'eachCutRank'
			rankColumn.push(self.reach.rankOfNode(self.blockCount + cut))
			cutColumn.push(cut as CsrIndex)
		end 'eachCutRank'

		let byRank = buildCsr(rankColumn, to: cutColumn, nodeCount: self.nodeCount as CsrIndex)
		var rank = self.nodeCount

		while rank > 0 'fromTheHighestRank'
			rank = rank - 1

			for k in 0 upto byRank.degree(rank as CsrIndex) 'eachCutOfTheRank'
				cuts.push(byRank.neighbour(rank as CsrIndex, k: k))
			end 'eachCutOfTheRank'
		end 'fromTheHighestRank'

		return cuts
	end 'continuationsByDescendingRank'

	function mayBeLiveAt(valueId ValueId, askedRank CsrIndex) returns bool
		return self.reach.definedBelow(self.definingBlockOf(valueId), rank: askedRank)
	end 'mayBeLiveAt'

	function nodeAt(i ElementIndex) returns ElementIndex
		return try self.liveNodes.get(i) otherwise panic("StdLiveness.nodeAt: liveNodes.get OOB at {i}")
	end 'nodeAt'

	function segmentedSuccessors(cutBlock BlockPositionColumn) returns CsrGraph
		let tail = IndexColumn.create(self.blockCount)

		for block in 0 upto self.blockCount 'eachBlock'
			try tail.set(block, value: block) otherwise panic("StdLiveness.segmentedSuccessors: tail.set OOB at {block}")
		end 'eachBlock'

		let edgeFrom = CsrColumn.create(cutBlock.count() + self.blockSucc.list.count(), zeroed: false)
		let edgeTo = CsrColumn.create(cutBlock.count() + self.blockSucc.list.count(), zeroed: false)

		for cut in 0 upto cutBlock.count() 'eachCut'
			let block = try cutBlock.get(cut) otherwise panic("StdLiveness.segmentedSuccessors: cutBlock.get OOB at {cut}")
			let continuation = self.blockCount + cut
			edgeFrom.push((try tail.get(block) otherwise panic("StdLiveness.segmentedSuccessors: tail.get OOB at {block}")) as CsrIndex)
			edgeTo.push(continuation as CsrIndex)
			try tail.set(block, value: continuation) otherwise panic("StdLiveness.segmentedSuccessors: tail.set OOB at {block}")
		end 'eachCut'

		for block in 0 upto self.blockCount 'eachBlockExit'
			let last = try tail.get(block) otherwise panic("StdLiveness.segmentedSuccessors: tail.get OOB at {block}")

			for k in 0 upto self.blockSucc.degree(block as CsrIndex) 'eachSuccessor'
				edgeFrom.push(last as CsrIndex)
				edgeTo.push(self.blockSucc.neighbour(block as CsrIndex, k: k))
			end 'eachSuccessor'
		end 'eachBlockExit'

		return buildCsr(edgeFrom, to: edgeTo, nodeCount: self.nodeCount as CsrIndex)
	end 'segmentedSuccessors'

	function opRefAt(block IrBlock, pos ElementIndex) returns ElementIndex
		return try block.bodyOpAt(pos) otherwise panic("StdLiveness: block '{String.from(block.label)}' has no op at position {pos}")
	end 'opRefAt'

	function definingBlockOf(valueId ValueId) returns ElementIndex
		return try self.definedIn.get(valueId) otherwise panic("StdLiveness: value {valueId} is outside the {self.definedIn.count()}-value space this liveness was computed over")
	end 'definingBlockOf'

	function recordOpDefs(op StdOp, position ElementIndex)
		stdOpDefinedValue(op, def: self.def)

		if self.def.definesNothing() 'noDef'
			return
		end 'noDef'

		self.recordDef(self.def.first, position: position)

		if self.def.definesPair() 'twoDefs'
			self.recordDef(self.def.second, position: position)
		end 'twoDefs'
	end 'recordOpDefs'

	function recordDef(valueId ValueId, position ElementIndex)
		try self.definedIn.set(valueId, value: position) otherwise panic("StdLiveness.recordDef: value {valueId} is outside the {self.definedIn.count()}-value space this liveness was computed over")
	end 'recordDef'

	function collectDefsAndUses(module StdModule, func IrFunction, cutBlock BlockPositionColumn, cutOp BlockPositionColumn) returns CsrGraph
		self.useValue.clear()
		self.useBlock.clear()
		var cut = 0 as ElementIndex

		for position in 0 upto self.blockCount 'eachBlock'
			let block = module.blockAtPosition(func, position: position)
			var segment = position
			var cutsHere = self.cutIsIn(cut, cutBlock: cutBlock, block: position)
			self.reads.clear()

			for arg in block.blockArgs 'eachPhi'
				self.recordDef(arg.valueId, position: segment)
			end 'eachPhi'

			for opPosition in 0 upto block.bodyOpCount() 'eachOp'
				let op = module.getOp(self.opRefAt(block, pos: opPosition))

				if cutsHere and (try cutOp.get(cut) otherwise panic("StdLiveness.collectDefsAndUses: cutOp.get OOB at {cut}")) == opPosition 'segmentEnds'
					collectStdOpUses(op, referenced: self.reads)
					self.flushReads(segment)
					segment = self.blockCount + cut
					cut = cut + 1
					cutsHere = self.cutIsIn(cut, cutBlock: cutBlock, block: position)
					self.recordOpDefs(op, position: segment)
				end 'segmentEnds' else 'sameSegment'
					self.recordOpDefsAndUses(op, position: segment)
				end 'sameSegment'
			end 'eachOp'

			if block.hasTerminatorOp() 'terminated'
				self.recordOpDefsAndUses(module.getOp(block.terminatorIndex()), position: segment)
			end 'terminated'

			for edge in block.branchEdges 'eachEdge'
				for argId in edge.argIds 'eachArg'
					self.reads.insert(argId)
				end 'eachArg'
			end 'eachEdge'

			self.flushReads(segment)
		end 'eachBlock'

		if cut != cutBlock.count() 'aCutWasNotReached'
			panic("StdLiveness.collectDefsAndUses: {cutBlock.count() - cut} of {cutBlock.count()} cut(s) were never reached — the cuts must name ops of '{String.from(func.name)}' in ascending (block, op) order")
		end 'aCutWasNotReached'

		return buildCsr(self.useValue, to: self.useBlock, nodeCount: self.definedIn.count() as CsrIndex)
	end 'collectDefsAndUses'

	function cutIsIn(cut ElementIndex, cutBlock BlockPositionColumn, block ElementIndex) returns bool
		return cut < cutBlock.count() and (try cutBlock.get(cut) otherwise panic("StdLiveness.cutIsIn: cutBlock.get OOB at {cut}")) == block
	end 'cutIsIn'

	// In SSA a read of a value the segment defines follows that def, which is recorded by the time the
	// segment's reads are flushed, so "defined elsewhere" is the whole test.
	function flushReads(segment ElementIndex)
		for i in 0 upto self.reads.insertedIdCount() 'eachRead'
			let valueId = self.reads.insertedIdAt(i)

			if self.definingBlockOf(valueId) != segment 'definedElsewhere'
				self.useValue.push(valueId as CsrIndex)
				self.useBlock.push(segment as CsrIndex)
			end 'definedElsewhere'
		end 'eachRead'

		self.reads.clear()
	end 'flushReads'

	function recordOpDefsAndUses(op StdOp, position ElementIndex)
		self.recordOpDefs(op, position: position)
		collectStdOpUses(op, referenced: self.reads)
	end 'recordOpDefsAndUses'

	function rangeOf(valueId ValueId)
		self.liveNodeCount = 0

		if self.useGraph.degree(valueId as CsrIndex) == 0 'neverRead'
			return
		end 'neverRead'

		self.stamp = self.stamp + 1
		let defBlock = self.definingBlockOf(valueId)

		for k in 0 upto self.useGraph.degree(valueId as CsrIndex) 'eachReadingBlock'
			self.stack.push(self.useGraph.neighbour(valueId as CsrIndex, k: k))
		end 'eachReadingBlock'

		while self.stack.count() != 0 'walk'
			let position = try self.stack.pop() otherwise panic("StdLiveness.rangeOf: pop from a non-empty stack")
			let markedAt = try self.marked.get(position) otherwise panic("StdLiveness.rangeOf: marked.get OOB at {position}")

			if markedAt == self.stamp or not self.reach.admits(position, defBlock: defBlock) 'notLiveHere'
				continue
			end 'notLiveHere'

			try self.marked.set(position, value: self.stamp) otherwise panic("StdLiveness.rangeOf: marked.set OOB at {position}")
			self.noteLiveNode(position)

			for k in 0 upto self.pred.degree(position as CsrIndex) 'eachPredecessor'
				let predecessor = self.pred.neighbour(position as CsrIndex, k: k)

				if predecessor != defBlock 'notTheDefiningBlock'
					self.stack.push(predecessor)
				end 'notTheDefiningBlock'
			end 'eachPredecessor'
		end 'walk'
	end 'rangeOf'

	function noteLiveNode(position ElementIndex)
		if self.liveNodeCount == self.liveNodes.count() 'growing'
			self.liveNodes.push(position)
		end 'growing' else 'overwriting'
			try self.liveNodes.set(self.liveNodeCount, value: position) otherwise panic("StdLiveness.noteLiveNode: liveNodes.set OOB at {self.liveNodeCount}")
		end 'overwriting'

		self.liveNodeCount = self.liveNodeCount + 1
	end 'noteLiveNode'
end 'StdLiveness'

// The predecessor relation of `succ`: the same edges, read the other way round.
function reversedGraph(succ CsrGraph) returns CsrGraph
	let edgeFrom = CsrColumn.create(succ.list.count(), zeroed: false)
	let edgeTo = CsrColumn.create(succ.list.count(), zeroed: false)

	for node in 0 upto succ.nodeCount() 'eachNode'
		for k in 0 upto succ.degree(node) 'eachSuccessor'
			edgeFrom.push(succ.neighbour(node, k: k))
			edgeTo.push(node)
		end 'eachSuccessor'
	end 'eachNode'

	return buildCsr(edgeFrom, to: edgeTo, nodeCount: succ.nodeCount())
end 'reversedGraph'

// Prunes a value's backward walk to the nodes that can lead it to a queried node. Under strict SSA
// a value live into a queried node is defined in a node that strictly dominates it, so at a lower
// RPO rank; the walk need enter a node only if a queried node of higher rank than the def reaches
// it. `topRank` is one past the highest rank of a queried node reaching each node, 0 for none.
//
// An unreachable node has no rank and no dominator, so with one present `build` leaves the prune
// off.
type QueriedReach
	var enabled as bool
	var rankOf as CsrColumn
	var topRank as CsrColumn
	var stack as BlockPositionColumn

	static function create() returns QueriedReach
		return Self{enabled: false, rankOf: CsrColumn.create(0), topRank: CsrColumn.create(0), stack: BlockPositionColumn.create(0)}
	end 'create'

	function disable()
		self.enabled = false
	end 'disable'

	function isEnabled() returns bool
		return self.enabled
	end 'isEnabled'

	function rankOfNode(node ElementIndex) returns CsrIndex
		return try self.rankOf.get(node) otherwise panic("QueriedReach.rankOfNode: rankOf.get OOB at {node}")
	end 'rankOfNode'

	function restrictsAt(defBlock ElementIndex) returns bool
		return self.enabled and defBlock < self.rankOf.count()
	end 'restrictsAt'

	function definedBelow(defBlock ElementIndex, rank CsrIndex) returns bool
		if not self.restrictsAt(defBlock) 'unrestricted'
			return true
		end 'unrestricted'

		return self.rankOfNode(defBlock) < rank
	end 'definedBelow'

	function build(succ CsrGraph, queried BoolArray)
		let blockCount = succ.nodeCount()

		if blockCount < ReachMinNodes 'tooSmallToPay'
			self.enabled = false
			return
		end 'tooSmallToPay'

		let order = StdDominatorTree.reversePostorder(succ, blockCount: blockCount)

		if order.count() != blockCount 'someBlockIsUnreachable'
			self.enabled = false
			return
		end 'someBlockIsUnreachable'

		self.enabled = true
		self.rankOf.refill(blockCount, value: 0)
		self.topRank.refill(blockCount, value: 0)

		for rank in 0 upto blockCount 'eachRank'
			let position = try order.get(rank) otherwise panic("QueriedReach.build: order.get OOB at {rank}")
			try self.rankOf.set(position, value: rank) otherwise panic("QueriedReach.build: rankOf.set OOB at {position}")
		end 'eachRank'

		var rank = blockCount

		while rank > 0 'fromTheHighestRank'
			rank = rank - 1
			let position = try order.get(rank) otherwise panic("QueriedReach.build: order.get OOB at {rank}")

			if (try queried.get(position) otherwise panic("QueriedReach.build: queried.get OOB at {position}")) and self.topRankOf(position) == 0 'anUnclaimedQueriedBlock'
				self.claimReachableFrom(position, succ: succ, claimRank: rank + 1)
			end 'anUnclaimedQueriedBlock'
		end 'fromTheHighestRank'
	end 'build'

	function claimReachableFrom(root ElementIndex, succ CsrGraph, claimRank CsrIndex)
		try self.topRank.set(root, value: claimRank) otherwise panic("QueriedReach.claimReachableFrom: topRank.set OOB at {root}")
		self.stack.push(root)

		while self.stack.count() != 0 'walk'
			let position = try self.stack.pop() otherwise panic("QueriedReach.claimReachableFrom: pop from a non-empty stack")

			for k in 0 upto succ.degree(position as CsrIndex) 'eachSuccessor'
				let successor = succ.neighbour(position as CsrIndex, k: k)

				if self.topRankOf(successor) == 0 'unclaimed'
					try self.topRank.set(successor, value: claimRank) otherwise panic("QueriedReach.claimReachableFrom: topRank.set OOB at {successor}")
					self.stack.push(successor)
				end 'unclaimed'
			end 'eachSuccessor'
		end 'walk'
	end 'claimReachableFrom'

	function topRankOf(position ElementIndex) returns CsrIndex
		return try self.topRank.get(position) otherwise panic("QueriedReach.topRankOf: topRank.get OOB at {position}")
	end 'topRankOf'

	function admits(position ElementIndex, defBlock ElementIndex) returns bool
		if not self.restrictsAt(defBlock) 'unrestricted'
			return true
		end 'unrestricted'

		return self.topRankOf(position) > self.rankOfNode(defBlock) + 1
	end 'admits'
end 'QueriedReach'
