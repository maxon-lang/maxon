// StdLiveness — the live-in value sets of every block of one Std function, as SPARSE lists: a block's
// list holds the values simultaneously live at its entry (tens), never the value space.
//
// ⭐ **SOLVED PER VALUE, NOT BY A FIXPOINT SWEEP.** SSA gives every value one definition, so its live
// range is exactly the blocks a backward walk reaches from its uses before meeting that definition — and
// marking those costs the size of the range and nothing else. An iterative sweep over the blocks costs the
// blocks times the number of rounds, and a backward flow needs a round per level of loop nesting, which
// the register allocator's own solver (`TargetLiveness.solveLivenessSsa`) declines to pay for the same
// reason: a nest as deep as the program is long makes the sweep quadratic.
//
// ⭐ **ONE WORKSPACE, RECOMPUTED PER FUNCTION.** Asked by the inliner's register-pressure estimate of
// every called-once callee and of every caller, thousands of times per compile, so the columns are kept
// and refilled: `recompute` allocates only the CSR graphs of the function in hand, never a column per
// value or a list per block.

// One stamp per block, so a value's walk marks each block once without a set per value. The stamp
// counts up across every function the workspace serves, so a column that keeps stale entries from a
// larger function never reads one as marked.
typealias WalkStamp = int(0 to u64.max)
typealias WalkStampColumn = Array with WalkStamp

module type StdLiveness
	var blockCount as BlockRefIndex

	// The CFG of the function last computed, in both directions — kept readable so the loop nest and
	// the natural-loop finder are built over the same graph rather than a second copy of it.
	module var succ as CsrGraph
	module var pred as CsrGraph

	// Value id -> the block position defining it; `blockCount` — one past every position, so it collides
	// with none — for a value no block of the function defines.
	var definedIn as BlockPositionColumn

	// Block position -> the values live on entry, ascending by id. Built from the (block, value) pairs
	// the range walk pushes, so a block costs no list of its own.
	var liveIn as CsrGraph
	var liveInBlock as CsrColumn
	var liveInValue as CsrColumn

	// The (value, block) pairs of every cross-block read, the use graph's edge list.
	var useValue as CsrColumn
	var useBlock as CsrColumn

	// A membership stamp over the value space, for the sets the readers build.
	var seen as LoopValueStamps
	var reads as StdValueUseSet
	var def as StdDefinedValues
	var marked as WalkStampColumn
	var stamp as WalkStamp
	var stack as BlockPositionColumn

	module static function create() returns StdLiveness
		let empty = CsrGraph.create(CsrColumn.create(), list: CsrColumn.create())
		return Self{blockCount: 0, succ: empty, pred: empty, definedIn: BlockPositionColumn.create(), liveIn: empty, liveInBlock: CsrColumn.create(), liveInValue: CsrColumn.create(), useValue: CsrColumn.create(), useBlock: CsrColumn.create(), seen: LoopValueStamps.create(), reads: StdValueUseSet.createRecordingIds(), def: StdDefinedValues.create(), marked: WalkStampColumn.create(), stamp: 0, stack: BlockPositionColumn.create()}
	end 'create'

	// The liveness of `func`, over a value space of `valueBound`, replacing whatever the workspace held.
	module function recompute(module StdModule, func IrFunction, valueBound ValueId)
		self.blockCount = func.blockRefs.count()
		self.definedIn.resize(valueBound)

		for v in 0 upto valueBound 'eachValue'
			try self.definedIn.set(v, value: self.blockCount) otherwise panic("StdLiveness.recompute: definedIn.set OOB at {v}")
		end 'eachValue'

		self.succ = buildStdSuccessorGraph(module, func: func, blockCount: self.blockCount)
		self.pred = reversedGraph(self.succ)
		self.markLiveRanges(self.collectDefsAndUses(module, func: func), valueBound: valueBound)
	end 'recompute'

	// The values live on entry to the block at `position`, into `out`.
	module function collectLiveIn(position BlockRefIndex, out ValueIdArray)
		out.clear()

		for k in 0 upto self.liveIn.degree(position as CsrIndex) 'eachLive'
			out.push(self.liveInAt(position, k: k))
		end 'eachLive'
	end 'collectLiveIn'

	// The values live immediately AFTER the op at `opPos` of the block at `position`, less the values that
	// op itself defines — what its successors need plus what the ops after it read, less what those ops
	// and the op itself define — inserted into `into`.
	module function collectLiveAcrossOp(module StdModule, func IrFunction, position BlockRefIndex, opPos BlockOpPos, into StdValueUseSet)
		let block = module.blockAtPosition(func, position: position)

		// The stamp marks what the ops from `opPos` on define; a value they define is not live across.
		self.seen.beginLoop()

		for pos in opPos upto block.opRefs.count() 'eachOpFromTheSite'
			self.markDefs(module.getOp(self.opRefAt(block, pos: pos)))
		end 'eachOpFromTheSite'

		for pos in opPos + 1 upto block.opRefs.count() 'eachLaterOp'
			self.insertReadsUnlessMarked(module.getOp(self.opRefAt(block, pos: pos)), into: into)
		end 'eachLaterOp'

		if block.hasTerminatorOp() 'terminated'
			self.insertReadsUnlessMarked(module.getOp(block.terminatorIndex()), into: into)
		end 'terminated'

		for edge in block.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachArg'
				self.insertUnlessMarked(argId, into: into)
			end 'eachArg'
		end 'eachEdge'

		for k in 0 upto self.succ.degree(position as CsrIndex) 'eachSuccessor'
			let successor = self.succ.neighbour(position as CsrIndex, k: k) as BlockRefIndex

			for j in 0 upto self.liveIn.degree(successor as CsrIndex) 'eachLive'
				self.insertUnlessMarked(self.liveInAt(successor, k: j), into: into)
			end 'eachLive'
		end 'eachSuccessor'
	end 'collectLiveAcrossOp'

	function liveInAt(position BlockRefIndex, k CsrIndex) returns ValueId
		return self.liveIn.neighbour(position as CsrIndex, k: k) as ValueId
	end 'liveInAt'

	function opRefAt(block IrBlock, pos BlockOpPos) returns OpIndex
		return try block.opRefs.get(pos) otherwise panic("StdLiveness: block '{String.from(block.label)}' has no op at position {pos}")
	end 'opRefAt'

	function definingBlockOf(valueId ValueId) returns BlockRefIndex
		return try self.definedIn.get(valueId) otherwise panic("StdLiveness: value {valueId} is outside the {self.definedIn.count()}-value space this liveness was computed over")
	end 'definingBlockOf'

	function recordOpDefs(op StdOp, position BlockRefIndex)
		stdOpDefinedValue(op, def: self.def)

		if self.def.definesNothing() 'noDef'
			return
		end 'noDef'

		self.recordDef(self.def.first, position: position)

		if self.def.definesPair() 'twoDefs'
			self.recordDef(self.def.second, position: position)
		end 'twoDefs'
	end 'recordOpDefs'

	function recordDef(valueId ValueId, position BlockRefIndex)
		try self.definedIn.set(valueId, value: position) otherwise panic("StdLiveness.recordDef: value {valueId} is outside the {self.definedIn.count()}-value space this liveness was computed over")
	end 'recordDef'

	// Every def's block — a block's phis, then its ops and terminator — and value id -> the blocks reading
	// it without defining it, as a CSR over the value space, from ONE walk of the ops. A read of a value
	// defined in the block itself follows its def in SSA, so "defined elsewhere" is the whole test, and the
	// block's own defs are all recorded by the time its reads are filtered; a def in another block is
	// "elsewhere" whether or not the walk has reached it yet. An edge's args are reads at the block's
	// end. The recording set gathers one block's reads whole, so a value read several times by one block
	// is listed once and the set is emptied once per block.
	function collectDefsAndUses(module StdModule, func IrFunction) returns CsrGraph
		self.useValue.clear()
		self.useBlock.clear()

		for position in 0 upto self.blockCount 'eachBlock'
			let block = module.blockAtPosition(func, position: position)
			self.reads.clear()

			for arg in block.blockArgs 'eachPhi'
				self.recordDef(arg.valueId, position: position)
			end 'eachPhi'

			for opIdx in block.opRefs 'eachOp'
				self.recordOpDefsAndUses(module.getOp(opIdx), position: position)
			end 'eachOp'

			if block.hasTerminatorOp() 'terminated'
				self.recordOpDefsAndUses(module.getOp(block.terminatorIndex()), position: position)
			end 'terminated'

			for edge in block.branchEdges 'eachEdge'
				for argId in edge.argIds 'eachArg'
					self.reads.insert(argId)
				end 'eachArg'
			end 'eachEdge'

			for i in 0 upto self.reads.insertedIdCount() 'eachRead'
				let valueId = self.reads.insertedIdAt(i)

				if self.definingBlockOf(valueId) != position 'definedElsewhere'
					self.useValue.push(valueId)
					self.useBlock.push(position)
				end 'definedElsewhere'
			end 'eachRead'
		end 'eachBlock'

		return buildCsr(self.useValue, to: self.useBlock, nodeCount: self.definedIn.count() as CsrIndex)
	end 'collectDefsAndUses'

	function recordOpDefsAndUses(op StdOp, position BlockRefIndex)
		self.recordOpDefs(op, position: position)
		collectStdOpUses(op, referenced: self.reads)
	end 'recordOpDefsAndUses'

	// Each value's live range: from every block reading it, backwards through the predecessors, stopping
	// at the block that defines it (the value is live OUT of that block, never IN) and at a block the
	// value's own walk already marked. Values are walked in id order, so every block's list comes out
	// ascending.
	function markLiveRanges(uses CsrGraph, valueBound ValueId)
		self.marked.resize(self.blockCount)
		self.liveInBlock.clear()
		self.liveInValue.clear()

		for valueId in 0 upto valueBound 'eachValue'
			if uses.degree(valueId as CsrIndex) == 0 'neverRead'
				continue
			end 'neverRead'

			self.stamp = self.stamp + 1
			let defBlock = self.definingBlockOf(valueId)

			for k in 0 upto uses.degree(valueId as CsrIndex) 'eachReadingBlock'
				self.stack.push(uses.neighbour(valueId as CsrIndex, k: k) as BlockRefIndex)
			end 'eachReadingBlock'

			while self.stack.count() != 0 'walk'
				let position = try self.stack.pop() otherwise panic("StdLiveness.markLiveRanges: pop from a non-empty stack")
				let markedAt = try self.marked.get(position) otherwise panic("StdLiveness.markLiveRanges: marked.get OOB at {position}")

				if markedAt == self.stamp 'alreadyLiveHere'
					continue
				end 'alreadyLiveHere'

				try self.marked.set(position, value: self.stamp) otherwise panic("StdLiveness.markLiveRanges: marked.set OOB at {position}")
				self.liveInBlock.push(position)
				self.liveInValue.push(valueId)

				for k in 0 upto self.pred.degree(position as CsrIndex) 'eachPredecessor'
					let predecessor = self.pred.neighbour(position as CsrIndex, k: k) as BlockRefIndex

					if predecessor != defBlock 'notTheDefiningBlock'
						self.stack.push(predecessor)
					end 'notTheDefiningBlock'
				end 'eachPredecessor'
			end 'walk'
		end 'eachValue'

		self.liveIn = buildCsr(self.liveInBlock, to: self.liveInValue, nodeCount: self.blockCount as CsrIndex)
	end 'markLiveRanges'

	function markDefs(op StdOp)
		stdOpDefinedValue(op, def: self.def)

		if self.def.definesNothing() 'noDef'
			return
		end 'noDef'

		self.seen.insert(self.def.first)

		if self.def.definesPair() 'twoDefs'
			self.seen.insert(self.def.second)
		end 'twoDefs'
	end 'markDefs'

	function insertReadsUnlessMarked(op StdOp, into StdValueUseSet)
		self.reads.clear()
		collectStdOpUses(op, referenced: self.reads)

		for i in 0 upto self.reads.insertedIdCount() 'eachRead'
			self.insertUnlessMarked(self.reads.insertedIdAt(i), into: into)
		end 'eachRead'
	end 'insertReadsUnlessMarked'

	function insertUnlessMarked(valueId ValueId, into StdValueUseSet)
		if not self.seen.contains(valueId) 'liveAcross'
			into.insert(valueId)
		end 'liveAcross'
	end 'insertUnlessMarked'
end 'StdLiveness'

// The predecessor relation of `succ`: the same edges, read the other way round.
function reversedGraph(succ CsrGraph) returns CsrGraph
	var edgeFrom = CsrColumn.create()
	var edgeTo = CsrColumn.create()

	for node in 0 upto succ.nodeCount() 'eachNode'
		for k in 0 upto succ.degree(node) 'eachSuccessor'
			edgeFrom.push(succ.neighbour(node, k: k))
			edgeTo.push(node)
		end 'eachSuccessor'
	end 'eachNode'

	return buildCsr(edgeFrom, to: edgeTo, nodeCount: succ.nodeCount())
end 'reversedGraph'
