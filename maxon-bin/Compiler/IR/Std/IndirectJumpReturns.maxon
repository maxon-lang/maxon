// A function whose frame can resume after a green-thread switch returns by indirect jump. Its `ret`
// would pop a return-stack entry pushed by the context that ran before the switch, so it mispredicts on
// nearly every resume, where an indirect jump is predicted from its own history. Those frames are the
// direct-call (`call`/`tryCall`) closure of `__gt_context_switch`, user functions included.
//
// Indirect and witness calls add no edge: marking through them flags hot callees whose returns predict
// well and slows every program. Correctness never depends on the flag, so a frame missed here still
// returns correctly.
export type ResumptionCalls
	let gathers as bool
	let calleeIndices as CsrColumn
	let callerIndices as CsrColumn
	let switchSeeds as BoolArray

	export static function collecting(functionCount ElementIndex) returns ResumptionCalls
		return Self{gathers: true, calleeIndices: CsrColumn.create(0), callerIndices: CsrColumn.create(0), switchSeeds: BoolArray.create(functionCount)}
	end 'collecting'

	export static function ignoring() returns ResumptionCalls
		return Self{gathers: false, calleeIndices: CsrColumn.create(0), callerIndices: CsrColumn.create(0), switchSeeds: BoolArray.create(0)}
	end 'ignoring'

	export function noteFunctionCall(callerIndex ElementIndex, calleeIndex ElementIndex)
		if not self.gathers 'nothingIsAsked'
			return
		end 'nothingIsAsked'

		self.calleeIndices.push(calleeIndex as CsrIndex)
		self.callerIndices.push(callerIndex as CsrIndex)
	end 'noteFunctionCall'

	export function noteChunkCall(callerIndex ElementIndex, callee ByteArray)
		if not self.gathers or not callee.equals(GtContextSwitchName) 'notTheSwitch'
			return
		end 'notTheSwitch'

		try self.switchSeeds.set(callerIndex, value: true) otherwise panic("ResumptionCalls.noteChunkCall: function {callerIndex} is past the {self.switchSeeds.count()} the seed column spans")
	end 'noteChunkCall'

	export function markIndirectJumpReturns(module StdModule)
		if not self.gathers 'nothingWasCollected'
			panic("ResumptionCalls.markIndirectJumpReturns: the calls were ignored, so there is no closure to mark")
		end 'nothingWasCollected'

		let functionCount = module.funcCount()
		let resumedAfterASwitch = reverseReachabilityMark(buildCsr(self.calleeIndices, to: self.callerIndices, nodeCount: functionCount as CsrIndex), seeds: self.switchSeeds)

		for funcIndex in 0 upto functionCount 'eachMarked'
			if not (try resumedAfterASwitch.get(funcIndex) otherwise panic("ResumptionCalls.markIndirectJumpReturns: function {funcIndex} is past the {functionCount} the closure spans")) 'staysAMatchedReturn'
				continue
			end 'staysAMatchedReturn'

			let func = module.getFunc(funcIndex)
			func.returnsByIndirectJump = true
		end 'eachMarked'
	end 'markIndirectJumpReturns'
end 'ResumptionCalls'
