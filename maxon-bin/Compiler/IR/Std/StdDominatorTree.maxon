// StdDominatorTree — the DOMINANCE facts about ONE Std function: which blocks the entry can reach, in
// what order, and which block is each one's immediate dominator.
//
// ⭐⭐ **WHY IT HAD TO EXIST BEFORE `EC13` COULD LEAVE ONE BLOCK.** "Is this value available here?" is
// the question every code-motion pass asks, and at the Std tier nothing could answer it: `func.blockRefs`
// is neither dominance order nor even layout order — it records WHEN A BLOCK WAS MINTED, which is why a
// range check emitted before inlining is walked before the constant the inlining created
// (`foldConstants`' header measures that). Answering the question wrong is not a missed optimization: a
// use that no longer follows its def is exactly the shape the register allocator panics on
// (`seedInUse: value N is live-in to block M but was never colored`).
//
// ⚠ **IT IS THE Std TIER'S, AND THE TARGET TIER'S `FuncTopology` IS NOT INTERCHANGEABLE WITH IT.** The
// two differ in the one place a CFG is read: a Target block's second successor is a `jcc` BODY op
// (`block.condBranch`), while a Std block's whole exit is its single terminator — which is why
// `collectStdBlockSuccessorIds` and `TargetLiveness.collectBlockSuccessorIds` are two rosters and say so
// at each other. What IS shared is the adjacency machinery: `buildCsr` builds all three of the graphs
// below, exactly as it builds `FuncTopology.succ`/`.pred`, because a new adjacency belongs in
// `CsrGraph.maxon` rather than hand-rolled at its call site.
//
// ⚠ **EVERY COLUMN HERE IS KEYED BY A BLOCK'S POSITION IN `func.blockRefs`, NEVER BY ITS `BlockId`.** A
// position is dense and 0-based, which is what `buildCsr` requires and what every dense column in this
// compiler is; a `BlockId` is neither (blocks are deleted). Position 0 is the ENTRY — the invariant
// `foldConstants.dropUnreachableBlocks` also rests on, and the one thing about `blockRefs` order that IS
// guaranteed.

// A dense column of block POSITIONS — the same non-negative integer as `BlockRefIndex` (the scalar,
// declared beside `IrModule.blockIndexById`) and as `CsrGraph`'s own key space, so a column of them is
// the `CsrColumn` `buildCsr` takes with no conversion at any call site.
export typealias BlockPositionColumn = Array with BlockRefIndex

export type StdDominatorTree
	// `func.blockRefs.count()` — the node count every column below spans.
	export var blockCount as BlockRefIndex

	// Whether the ENTRY can reach this block. An unreachable block has no dominator (nothing on the way
	// to it is on a path from the entry, because there is no such path), so `idom` is meaningless for it
	// and `children` never names it. The parser mints unreachable blocks routinely (`Terminator.dead`
	// for code after a fully-terminated `if`/`else`), and `reorderFuncBlocksRpo` still EMITS them, so
	// this is an ordinary state rather than a defect to report.
	var reachable as BoolArray

	// Block position -> the position of its immediate dominator. The entry is its OWN, which is the
	// standard encoding and what terminates `intersect`'s walk. Meaningless where `reachable` is false.
	var idom as BlockPositionColumn

	// The dominator tree as an adjacency: `children.neighbour(p, k)` is the k-th block whose immediate
	// dominator is `p`. The entry's self-edge is deliberately NOT in it — a tree walk that re-entered
	// the entry would not terminate.
	//
	// The member `EC13`'s dominator WALK reads: a consumer walks the tree from `StdEntryBlockPosition`
	// down this adjacency, which visits exactly the reachable blocks in dominator order.
	export var children as CsrGraph

	// ⭐ **THE CFG ITSELF, KEPT RATHER THAN REBUILT — the two adjacencies the dominator solve already
	// needed.** `EC14`'s LICM asks the SAME function three more graph questions (where the back edges
	// are, which blocks a natural loop holds, which of a header's predecessors is the preheader), and
	// every one of them is a walk of these. Handing them back costs nothing — they are built above
	// either way, and this record is per-function scratch that dies with the pass — where rebuilding
	// them would have been a second `buildStdSuccessorGraph` per function, which is a second walk of
	// every op of every block.
	export var succ as CsrGraph
	export var pred as CsrGraph

	// The reachable blocks in reverse postorder. Kept for the same reason: `EC14` analyses a loop's
	// blocks in an order where every value's DEF is visited before its uses, which is exactly this one
	// (dominance implies reverse-postorder precedence), and the solve above has already computed it.
	export var reverseOrder as BlockPositionColumn

	// Build the tree for one function. `blockCount` 0 is answered with an empty tree rather than
	// refused: a function with no blocks is a declaration, and every accessor below is then vacuous.
	export static function build(module StdModule, func IrFunction) returns StdDominatorTree
		let blockCount = func.blockRefs.count()
		return Self.buildFromSuccessors(buildStdSuccessorGraph(module, func: func, blockCount: blockCount), blockCount: blockCount)
	end 'build'

	// The same tree, from a successor graph the CALLER already has.
	//
	// ⭐ **IT EXISTS BECAUSE THE SUCCESSOR GRAPH ANSWERS A QUESTION THAT COMES FIRST.** `EC14` asks "does
	// this function contain a back edge at all?", which is a DFS of the successors and nothing else, and
	// the answer is NO for most functions. Building the tree first would pay for the predecessor graph,
	// the reverse postorder, the Cooper–Harvey–Kennedy solve and the child adjacency of every loopless
	// function in the module before discovering there was nothing to do with them.
	export static function buildFromSuccessors(succ CsrGraph, blockCount BlockRefIndex) returns StdDominatorTree
		// The PREDECESSOR graph is the same edge list with its two columns swapped — `buildCsr`'s
		// counting sort does not care which way round the relation is read.
		let pred = buildCsr(succ.list, to: startsRepeatedPerNode(succ), nodeCount: blockCount as CsrIndex)

		var tree = Self{blockCount: blockCount, reachable: BoolArray.create(), idom: BlockPositionColumn.create(), children: CsrGraph.create(CsrColumn.create(), list: CsrColumn.create()), succ: succ, pred: pred, reverseOrder: BlockPositionColumn.create()}
		tree.reachable.growFilled(blockCount as ElementIndex, value: false)
		tree.idom.resize(blockCount)

		let rpo = tree.buildReversePostorder(succ)
		tree.solveImmediateDominators(pred, rpo: rpo)
		tree.children = buildCsr(tree.idomOfEachNonEntryReachableBlock(rpo), to: rpo.copyOfReachableNonEntryBlocks(), nodeCount: blockCount as CsrIndex)
		tree.reverseOrder = rpo.order

		return tree
	end 'buildFromSuccessors'

	// Whether the ENTRY can reach `position` — the one question `reachable` answers for a consumer, and
	// the guard every walk over `func.blockRefs` owes. An unreachable block has no dominator, so every
	// other query below is meaningless for one.
	export function canReach(position BlockRefIndex) returns bool
		return try self.reachable.get(position) otherwise panic("StdDominatorTree.canReach: reachable.get OOB at {position}")
	end 'canReach'

	// The block that immediately dominates `position` — the one step of the dominator chain, which is
	// what a consumer WALKING that chain needs. The entry is its own, which is the standard encoding and
	// what terminates such a walk.
	//
	// ⭐ **THE PRIMITIVE, NOT A `dominates(a, b)` PREDICATE, and the difference is asymptotic.** A
	// predicate answers ONE pair in O(the dominator depth), so a caller asking it of every block of a
	// loop against every exit of that loop is cubic in the worst case. `EC14`'s question is not one pair:
	// it is "which blocks dominate ALL of these", which one climb per named block answers in
	// O(named × depth) by counting how many climbs visited each block. Handing back the step is what lets
	// the caller phrase it that way; a predicate would have hidden the shape and cost more.
	export function immediateDominatorOf(position BlockRefIndex) returns BlockRefIndex
		if not self.canReach(position) 'unreachable'
			panic("StdDominatorTree.immediateDominatorOf: block position {position} is not reachable from the entry, so it has no dominator — ask `canReach` first")
		end 'unreachable'

		return try self.idom.get(position) otherwise panic("StdDominatorTree.immediateDominatorOf: idom.get OOB at {position}")
	end 'immediateDominatorOf'

	// The DFS postorder of the blocks the entry reaches, REVERSED — the order the dominator solve
	// iterates in, which is what makes it converge in a couple of rounds instead of in tree-depth ones.
	//
	// An EXPLICIT STACK, not recursion: a function's block chain can be tens of thousands long (the
	// register allocator's own liveness note measures a 19,200-block function), and a recursive DFS over
	// one is a host stack overflow rather than a compiler diagnostic.
	function buildReversePostorder(graph CsrGraph) returns RpoOrder
		var postorder = BlockPositionColumn.create()

		if self.blockCount == 0 'noBlocks'
			return RpoOrder.create(postorder, rpoIndex: BlockPositionColumn.create())
		end 'noBlocks'

		var stackNode = BlockPositionColumn.create()
		var stackNextChild = CsrColumn.create()

		try self.reachable.set(StdEntryBlockPosition, value: true) otherwise panic("StdDominatorTree.buildReversePostorder: reachable.set OOB at the entry")
		stackNode.push(StdEntryBlockPosition)
		stackNextChild.push(0)

		while stackNode.count() > 0 'depthFirst'
			let top = stackNode.count() - 1
			let position = try stackNode.get(top) otherwise panic("StdDominatorTree.buildReversePostorder: stackNode.get OOB at {top}")
			let nextChild = try stackNextChild.get(top) otherwise panic("StdDominatorTree.buildReversePostorder: stackNextChild.get OOB at {top}")

			if nextChild >= graph.degree(position as CsrIndex) 'everySuccessorVisited'
				postorder.push(position)
				_ = try stackNode.pop() otherwise panic("StdDominatorTree.buildReversePostorder: stackNode.pop on a non-empty stack failed")
				_ = try stackNextChild.pop() otherwise panic("StdDominatorTree.buildReversePostorder: stackNextChild.pop on a non-empty stack failed")
				continue
			end 'everySuccessorVisited'

			try stackNextChild.set(top, value: nextChild + 1) otherwise panic("StdDominatorTree.buildReversePostorder: stackNextChild.set OOB at {top}")

			let successor = graph.neighbour(position as CsrIndex, k: nextChild) as BlockRefIndex
			let seenBefore = try self.reachable.get(successor) otherwise panic("StdDominatorTree.buildReversePostorder: reachable.get OOB at {successor}")

			if not seenBefore 'firstVisit'
				try self.reachable.set(successor, value: true) otherwise panic("StdDominatorTree.buildReversePostorder: reachable.set OOB at {successor}")
				stackNode.push(successor)
				stackNextChild.push(0)
			end 'firstVisit'
		end 'depthFirst'

		return RpoOrder.fromPostorder(postorder, blockCount: self.blockCount)
	end 'buildReversePostorder'

	// ⭐ **THE COOPER–HARVEY–KENNEDY ITERATIVE SOLVE.** Each block's immediate dominator is the meet of
	// its already-solved predecessors', computed by walking both candidates up the partially-built tree
	// until they meet; iterating in reverse postorder means a block's predecessors are almost always
	// solved before it, so the fixpoint converges in two rounds on a reducible CFG (the third round is
	// the one that reads no change and stops).
	//
	// A predecessor with no dominator yet is SKIPPED — on the first round that is a back edge whose
	// source has not been visited, and at the fixpoint it is an UNREACHABLE predecessor, which can
	// genuinely exist here (the parser's `dead` blocks still carry their branch edges). A reachable
	// block always has at least one solved predecessor by the time reverse postorder gets to it, which
	// is what makes the "no candidate" case impossible rather than merely unlikely.
	function solveImmediateDominators(predecessors CsrGraph, rpo RpoOrder)
		if self.blockCount == 0 'noBlocks'
			return
		end 'noBlocks'

		try self.idom.set(StdEntryBlockPosition, value: StdEntryBlockPosition) otherwise panic("StdDominatorTree.solveImmediateDominators: idom.set OOB at the entry")
		var solved = BoolArray.create()
		solved.growFilled(self.blockCount as ElementIndex, value: false)
		try solved.set(StdEntryBlockPosition, value: true) otherwise panic("StdDominatorTree.solveImmediateDominators: solved.set OOB at the entry")

		var changed = true

		while changed 'untilStable'
			changed = false

			for orderIndex in 0 upto rpo.order.count() 'eachBlockInRpo'
				let position = try rpo.order.get(orderIndex) otherwise panic("StdDominatorTree.solveImmediateDominators: rpo.order.get OOB at {orderIndex}")

				if position == StdEntryBlockPosition 'theEntryDominatesItself'
					continue
				end 'theEntryDominatesItself'

				if self.meetSolvedPredecessorsOf(position, predecessors: predecessors, rpo: rpo, solved: solved) 'moved'
					changed = true
				end 'moved'
			end 'eachBlockInRpo'
		end 'untilStable'
	end 'solveImmediateDominators'

	// Recompute one block's immediate dominator from its solved predecessors, answering whether it
	// MOVED — which is the whole of what the fixpoint loop above needs to know.
	function meetSolvedPredecessorsOf(position BlockRefIndex, predecessors CsrGraph, rpo RpoOrder, solved BoolArray) returns bool
		var candidate = StdEntryBlockPosition
		var haveCandidate = false

		for k in 0 upto predecessors.degree(position as CsrIndex) 'eachPredecessor'
			let predecessor = predecessors.neighbour(position as CsrIndex, k: k) as BlockRefIndex

			if not (try solved.get(predecessor) otherwise panic("StdDominatorTree.meetSolvedPredecessorsOf: solved.get OOB at {predecessor}")) 'notSolvedYet'
				continue
			end 'notSolvedYet'

			candidate = predecessor if not haveCandidate else self.commonDominatorOf(predecessor, other: candidate, rpo: rpo)
			haveCandidate = true
		end 'eachPredecessor'

		if not haveCandidate 'noSolvedPredecessor'
			return false
		end 'noSolvedPredecessor'

		let wasSolved = try solved.get(position) otherwise panic("StdDominatorTree.meetSolvedPredecessorsOf: solved.get OOB at {position}")

		if wasSolved and (try self.idom.get(position) otherwise panic("StdDominatorTree.meetSolvedPredecessorsOf: idom.get OOB at {position}")) == candidate 'unchanged'
			return false
		end 'unchanged'

		try self.idom.set(position, value: candidate) otherwise panic("StdDominatorTree.meetSolvedPredecessorsOf: idom.set OOB at {position}")
		try solved.set(position, value: true) otherwise panic("StdDominatorTree.meetSolvedPredecessorsOf: solved.set OOB at {position}")

		return true
	end 'meetSolvedPredecessorsOf'

	// The nearest block that dominates both — walk whichever candidate is DEEPER in reverse postorder
	// (the larger index) up the partial tree until the two meet. Terminates because the entry is its own
	// dominator and is the shallowest node, so both walks converge on it at worst.
	function commonDominatorOf(a BlockRefIndex, other BlockRefIndex, rpo RpoOrder) returns BlockRefIndex
		var left = a
		var right = other

		while left != right 'climb'
			while rpo.indexOf(left) > rpo.indexOf(right) 'climbLeft'
				left = try self.idom.get(left) otherwise panic("StdDominatorTree.commonDominatorOf: idom.get OOB at {left}")
			end 'climbLeft'

			while rpo.indexOf(right) > rpo.indexOf(left) 'climbRight'
				right = try self.idom.get(right) otherwise panic("StdDominatorTree.commonDominatorOf: idom.get OOB at {right}")
			end 'climbRight'
		end 'climb'

		return left
	end 'commonDominatorOf'

	// The `from` column of the dominator tree's edge list: one entry per reachable non-entry block,
	// holding that block's immediate dominator. Paired with `RpoOrder.copyOfReachableNonEntryBlocks`,
	// which walks the same order and so produces the matching `to` column.
	function idomOfEachNonEntryReachableBlock(rpo RpoOrder) returns CsrColumn
		var parents = CsrColumn.create()

		for position in rpo.order 'eachReachableBlock'
			if position == StdEntryBlockPosition 'theEntryHasNoParent'
				continue
			end 'theEntryHasNoParent'

			parents.push(try self.idom.get(position) otherwise panic("StdDominatorTree.idomOfEachNonEntryReachableBlock: idom.get OOB at {position}"))
		end 'eachReachableBlock'

		return parents
	end 'idomOfEachNonEntryReachableBlock'
end 'StdDominatorTree'

// Dominance as an O(1) query: a preorder and a postorder stamp per block over the dominator tree's
// child adjacency, so `a` dominates `b` iff `a`'s interval contains `b`'s. The tree hands back one STEP
// of the chain and says why; a pass that asks "does X dominate this block" once per VALUE READ
// (`threadConstantBranches`) would pay O(reads × depth) climbing — quadratic in a function whose `try`
// sites nest one continuation under the last — where one walk of `children` stamps every block.
export type DominatorStamps
	var enterAt as BlockPositionColumn
	var leaveAt as BlockPositionColumn

	export static function build(tree StdDominatorTree) returns DominatorStamps
		var stamps = Self{enterAt: BlockPositionColumn.create(), leaveAt: BlockPositionColumn.create()}
		stamps.enterAt.resize(tree.blockCount)
		stamps.leaveAt.resize(tree.blockCount)

		var walk = StdDominatorWalk.create()
		walk.begin(tree)
		var clock = 0 as BlockRefIndex

		while walk.advance(tree) 'depthFirst'
			match walk.step 'step'
				enter then clock = stamps.stampEntry(walk.position, clock: clock)
				leave then clock = stamps.stampExit(walk.position, clock: clock)
			end 'step'
		end 'depthFirst'

		return stamps
	end 'build'

	function stampEntry(position BlockRefIndex, clock BlockRefIndex) returns BlockRefIndex
		try self.enterAt.set(position, value: clock) otherwise panic("DominatorStamps: enterAt.set OOB at {position}")
		return clock + 1
	end 'stampEntry'

	function stampExit(position BlockRefIndex, clock BlockRefIndex) returns BlockRefIndex
		try self.leaveAt.set(position, value: clock) otherwise panic("DominatorStamps: leaveAt.set OOB at {position}")
		return clock + 1
	end 'stampExit'

	// Whether `a` dominates `b`. Both must be reachable — an unreachable block was never stamped, and
	// its zero interval would read as the entry's; callers ask `StdDominatorTree.canReach` first.
	export function dominates(a BlockRefIndex, b BlockRefIndex) returns bool
		let aEnter = try self.enterAt.get(a) otherwise panic("DominatorStamps.dominates: enterAt.get OOB at {a}")
		let bEnter = try self.enterAt.get(b) otherwise panic("DominatorStamps.dominates: enterAt.get OOB at {b}")
		let aLeave = try self.leaveAt.get(a) otherwise panic("DominatorStamps.dominates: leaveAt.get OOB at {a}")
		let bLeave = try self.leaveAt.get(b) otherwise panic("DominatorStamps.dominates: leaveAt.get OOB at {b}")
		return aEnter <= bEnter and bLeave <= aLeave
	end 'dominates'
end 'DominatorStamps'

// One step of a dominator-tree walk: a block is ENTERED before any block it dominates and LEFT after
// every one of them.
export enum StdDominatorStep
	enter
	leave
end 'StdDominatorStep'

// The dominator-tree DFS every scoped analysis shares — `DominatorStamps`, CSE's expression table and
// `refineValueRanges`' refinement trail each push on `enter` and restore on `leave`. It visits the
// reachable blocks in dominator preorder with a block's children in REVERSE POSTORDER:
// `buildFromSuccessors` pushes them in that order and `buildCsr` keeps it, which is what puts every
// forward-edge predecessor of a block before the block itself. `advance` CHECKS that premise at every
// sibling rather than resting on it, because a consumer that reads a predecessor's value before the
// predecessor is visited gets a stale one silently.
//
// An EXPLICIT STACK rather than recursion, for `buildReversePostorder`'s reason: a dominator chain can
// be as long as the function has blocks.
export type StdDominatorWalk
	var open as BlockPositionColumn
	var nextChild as CsrColumn
	// Block position -> its reverse-postorder index, for the sibling-order check.
	var rpoIndex as BlockPositionColumn
	var entryPending as bool
	// The step `advance` last yielded, and the block it concerns.
	export var step as StdDominatorStep
	export var position as BlockRefIndex

	export static function create() returns StdDominatorWalk
		return Self{open: BlockPositionColumn.create(), nextChild: CsrColumn.create(), rpoIndex: BlockPositionColumn.create(), entryPending: false, step: StdDominatorStep.enter, position: StdEntryBlockPosition}
	end 'create'

	// Start over `tree`, keeping the columns' capacity; the first `advance` enters the entry block. An
	// empty tree yields nothing.
	export function begin(tree StdDominatorTree)
		self.open.clear()
		self.nextChild.clear()
		self.rpoIndex.clear()
		self.rpoIndex.resize(tree.blockCount)

		for orderIndex in 0 upto tree.reverseOrder.count() 'eachReachable'
			let reachable = try tree.reverseOrder.get(orderIndex) otherwise panic("StdDominatorWalk.begin: reverseOrder.get OOB at {orderIndex}")
			try self.rpoIndex.set(reachable, value: orderIndex) otherwise panic("StdDominatorWalk.begin: rpoIndex.set OOB at {reachable}")
		end 'eachReachable'

		self.entryPending = tree.blockCount > 0
	end 'begin'

	// Yield the next step into `step`/`position`; false once every reachable block has been left.
	export function advance(tree StdDominatorTree) returns bool
		if self.entryPending 'enterTheEntry'
			self.entryPending = false
			self.openBlock(StdEntryBlockPosition)
			return true
		end 'enterTheEntry'

		if self.open.count() == 0 'finished'
			return false
		end 'finished'

		let top = self.open.count() - 1
		let parent = try self.open.get(top) otherwise panic("StdDominatorWalk.advance: open.get OOB at {top}")
		let slot = try self.nextChild.get(top) otherwise panic("StdDominatorWalk.advance: nextChild.get OOB at {top}")

		if slot >= tree.children.degree(parent as CsrIndex) 'everyChildVisited'
			_ = try self.open.pop() otherwise panic("StdDominatorWalk.advance: open.pop on a non-empty walk failed")
			_ = try self.nextChild.pop() otherwise panic("StdDominatorWalk.advance: nextChild.pop on a non-empty walk failed")
			self.step = StdDominatorStep.leave
			self.position = parent
			return true
		end 'everyChildVisited'

		try self.nextChild.set(top, value: slot + 1) otherwise panic("StdDominatorWalk.advance: nextChild.set OOB at {top}")
		let child = tree.children.neighbour(parent as CsrIndex, k: slot) as BlockRefIndex

		if slot > 0 'hasAnElderSibling'
			let sibling = tree.children.neighbour(parent as CsrIndex, k: slot - 1) as BlockRefIndex
			if self.rpoIndexOf(sibling) >= self.rpoIndexOf(child) 'outOfOrder'
				panic("StdDominatorWalk.advance: the dominator tree lists block position {child} after {sibling} under {parent}, which is not reverse postorder")
			end 'outOfOrder'
		end 'hasAnElderSibling'

		self.openBlock(child)
		return true
	end 'advance'

	function openBlock(block BlockRefIndex)
		self.open.push(block)
		self.nextChild.push(0)
		self.step = StdDominatorStep.enter
		self.position = block
	end 'openBlock'

	function rpoIndexOf(block BlockRefIndex) returns BlockRefIndex
		return try self.rpoIndex.get(block) otherwise panic("StdDominatorWalk.rpoIndexOf: rpoIndex.get OOB at {block}")
	end 'rpoIndexOf'
end 'StdDominatorWalk'

// The entry block is `func.blockRefs` position 0. Named because it is an INVARIANT of that array
// (`IrModule.addBlock` appends, and the entry is the first block a function gets) rather than a number
// that happens to appear here.
export let StdEntryBlockPosition = 0 as BlockRefIndex

// A reverse postorder plus its inverse: `order` lists the reachable blocks, and `indexOf` answers where
// a block sits in it. Both halves are needed together — the solve iterates the list and the meet
// compares depths — so they are one value rather than two the caller has to keep in step.
type RpoOrder
	export var order as BlockPositionColumn

	// Block position -> its index in `order`. Meaningless for an unreachable block, which `indexOf` is
	// never asked about: the solve only ever compares two blocks that already have a dominator.
	var rpoIndex as BlockPositionColumn

	static function create(order BlockPositionColumn, rpoIndex BlockPositionColumn) returns RpoOrder
		return Self{order: order, rpoIndex: rpoIndex}
	end 'create'

	// Reverse a DFS postorder into a reverse postorder, recording each block's place as it goes.
	static function fromPostorder(postorder BlockPositionColumn, blockCount BlockRefIndex) returns RpoOrder
		var order = BlockPositionColumn.create()
		var rpoIndex = BlockPositionColumn.create()
		rpoIndex.resize(blockCount)

		var remaining = postorder.count()

		while remaining > 0 'reverse'
			remaining = remaining - 1
			let position = try postorder.get(remaining) otherwise panic("RpoOrder.fromPostorder: postorder.get OOB at {remaining}")
			try rpoIndex.set(position, value: order.count()) otherwise panic("RpoOrder.fromPostorder: rpoIndex.set OOB at {position}")
			order.push(position)
		end 'reverse'

		return Self.create(order, rpoIndex: rpoIndex)
	end 'fromPostorder'

	export function indexOf(position BlockRefIndex) returns BlockRefIndex
		return try self.rpoIndex.get(position) otherwise panic("RpoOrder.indexOf: rpoIndex.get OOB at {position}")
	end 'indexOf'

	// Every reachable block except the entry, in reverse postorder — the `to` column of the dominator
	// tree's edge list.
	export function copyOfReachableNonEntryBlocks() returns CsrColumn
		var blocks = CsrColumn.create()

		for position in self.order 'eachReachableBlock'
			if position == StdEntryBlockPosition 'theEntryIsNobodysChild'
				continue
			end 'theEntryIsNobodysChild'

			blocks.push(position)
		end 'eachReachableBlock'

		return blocks
	end 'copyOfReachableNonEntryBlocks'
end 'RpoOrder'

// The CFG of one Std function as a CSR adjacency over block POSITIONS.
//
// ⚠ **A BLOCK WITH NO TERMINATOR OP FALLS THROUGH PHYSICALLY, AND THE OPS-DERIVED CFG CANNOT SEE THAT
// EDGE** — `EC11`'s finding, which `foldConstants.dropUnreachableBlocks` states and takes the same cure
// for. Here the consequence of missing it would be worse than a stale reachability bit: an edge left out
// makes dominance STRONGER than it is, and a pass would then treat a value as available on a path that
// does not carry it. An edge added that does not exist only makes dominance weaker, which costs a missed
// optimization and nothing else — so the fall-through is added unconditionally where a block has no
// terminator op and a physical successor.
module function buildStdSuccessorGraph(module StdModule, func IrFunction, blockCount BlockRefIndex) returns CsrGraph
	var edgeFrom = CsrColumn.create()
	var edgeTo = CsrColumn.create()
	let byId = module.blockIndexById(func)
	var successorIds = BlockIdArray.create()

	for position in 0 upto blockCount 'eachBlock'
		let block = module.blockAtPosition(func, position: position)

		successorIds.clear()
		collectStdBlockSuccessorIds(module, block: block, out: successorIds)

		for successorId in successorIds 'eachSuccessor'
			let successor = try byId.get(successorId) otherwise panic("buildStdSuccessorGraph: in '{String.from(func.name)}', block_{block.id} at position {position} branches to block_{successorId}, which is not in the function's blockRefs")

			if successor >= blockCount 'pastTheFunction'
				panic("buildStdSuccessorGraph: in '{String.from(func.name)}', block_{block.id} at position {position} branches to block_{successorId}, indexed at position {successor} of a {blockCount}-block function — the block index and blockRefs disagree")
			end 'pastTheFunction'

			edgeFrom.push(position)
			edgeTo.push(successor)
		end 'eachSuccessor'

		if not block.hasTerminatorOp() and position + 1 < blockCount 'fallsThroughPhysically'
			edgeFrom.push(position)
			edgeTo.push(position + 1)
		end 'fallsThroughPhysically'
	end 'eachBlock'

	return buildCsr(edgeFrom, to: edgeTo, nodeCount: blockCount as CsrIndex)
end 'buildStdSuccessorGraph'

// The `from` column that turns a successor CSR back into a flat edge list — node `n` repeated once per
// neighbour it has. Paired with `graph.list` (already the `to` column, in the same order), it is the
// edge list `buildCsr` needs to build the REVERSED relation, with no second walk of the IR.
function startsRepeatedPerNode(graph CsrGraph) returns CsrColumn
	var sources = CsrColumn.create()

	for node in 0 upto graph.nodeCount() 'eachNode'
		for _ in 0 upto graph.degree(node) 'eachNeighbour'
			sources.push(node)
		end 'eachNeighbour'
	end 'eachNode'

	return sources
end 'startsRepeatedPerNode'
