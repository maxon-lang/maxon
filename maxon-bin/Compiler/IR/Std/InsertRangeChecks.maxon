// InsertRangeChecks — the ranged-typealias guard pass. A Std→Std pass that turns the parser's
// recorded range-check sites (`project.rangeChecks`) into the compile-time E3005s and runtime panics a
// ranged typealias promises at EVERY position a value meets one: a narrowing `as` cast, a ranged
// `return`, a struct-literal field, a field store, a field's declared default, an array element and a
// call argument. It runs right after `lowerMaxonToStd`, before the other Std passes.
//
// ⚠ **WHICH HALVES A POSITION OWES IS `RangeCheckGuard`'S TO SAY, NOT THIS PASS'S.** The compile-time
// E3005 is owed EVERYWHERE and is raised by the one decision function (`needsRuntimeGuard`); the runtime
// cascade is skipped at exactly ONE position, the CALL ARGUMENT AT A CONCRETE PARAMETER, whose alias is not
// known where the argument is written and whose runtime half is therefore enforced at the callee's entry
// instead. An argument at an OPAQUE `T` parameter has no such entry to be enforced at — the body is
// compiled once and knows no range — so it records an ordinary alias-named site and takes both halves here
// (`Parser.recordOpaqueArgRangeChecks`).
//
// ⭐ **A CALL ARGUMENT IS OFF THAT LIST BECAUSE THE GUARD SITS ELSEWHERE, NOT BECAUSE THE OBSTACLE WAS
// DEFEATED.** The obstacle is real: a check is a BRANCH, so a guard emitted where the argument is
// WRITTEN lands past the call with the callee already run. The cure is that the argument door's runtime
// half belongs to the CALLEE'S ENTRY — one guard per narrowed parameter per function, in front of every
// caller including the indirect ones — so the argument site owes only the compile-time half and the
// premise is enforced all the same. See `guardRangedParams`, which also names the one exception, a
// full-unsigned parameter checked at its call sites.
//
// The guard is emitted at the Std tier because it needs a primitive the Maxon dialect lacks —
// "abort with a symbolized backtrace and exit 1" — and adding one there is a new `MaxonOp` variant,
// which forces an arm into every exhaustive `MaxonOp` match, the escape analysis in
// `SemanticCheck.maxon` / `FnRefThunk.maxon` included. Here the panic is a plain `StdOp.call` to
// the `mrt_panic` runtime chunk and the cascade is the tier's ordinary `cmp`/`condBranch`. The
// alias name and the site's position ride the parser's `project.rangeChecks` side table, and
// `emitGuardAt` stamps the guard's ops with the site's span.
//
// ⭐ ONE GUARD EMITTER, one unsigned strategy, one panic-message builder, serving BOTH the cast sites and
// the return sites (`emitGuardAt`). Two emitters drift on unsigned handling; here there is one.
//
// ⚠ SIGNED COMPARES (but one shape), in a CASCADE — and the CASCADE's reason and the SIGNED's
// reason are two different facts. The cascade is because the Std tier has no `setcc`: a bound's
// verdict can only be a `cmp` fused into a `condBranch`, one block per bound, never a
// `cmp`+`cmp`+`or` over materialized bools.
//
// ⛔ **THE STD TIER DOES HAVE AN UNSIGNED INTEGER COMPARE — "`StdCmpPred` is signed only" IS
// FALSE.** `StdCmpPred` carries no signedness either way; the compare's `operandType` does
// (`StdDialect.stdTypeIsUnsigned` / `unsignedStdTypeOf`), and all three backends read it. What is
// true is that the checks below CHOOSE signed, and the choice is deliberate — see the paragraph
// after next for the `int(N>0 to u64.max)` shape that depends on it. The one shape that chooses
// unsigned is an unsigned-topped range below `u64.max` (`boundChecks`), whose stored upper is a
// negative pattern no signed compare can test against.
//
// ⚠ **AND THAT MAKES A ONE-COMPARE FORM POSSIBLE FOR THE ORDINARY SHAPE, WHICH THIS PASS DOES NOT TAKE
// AND WHICH IS FILED RATHER THAN ASSUMED.** For a range whose bounds are both representable,
// `(value - lo) >u (hi - lo)` is the whole two-bound test in one unsigned compare — the same idiom
// `ManagedMemoryRuntime.BoundsCompareOperandType` uses for the array guard, which measured
// 7 x64 instructions down to 2 there. It is NOT a comment-only change here: the subtraction is an extra
// op, the `u64` relabelling has a precondition of its own (`hi - lo` must not wrap, which needs the
// bound ARITHMETIC checked and not just the bounds), and the unsigned-max-upper shape below must be
// exempted by name. Measure it before building it.
//
// A check usually branches to the shared panic on violation; the one exception is the unsigned-max-upper
// shape's sign check, whose TRUE edge is IN RANGE (see `RangeCheckEdge`). Signed compares give the
// correct in/out verdict for every ordinary range, and for the `int(N>0 to u64.max)` shape they give the
// correct UNSIGNED verdict — see `TypeRules.rangeIsUnsignedTopped` / `boundChecks`.

// Where a cascade check's TRUE edge (the predicate SATISFIED) goes. Almost every check means
// "out of range past this bound", so its true edge is the shared `panic`. The one exception is
// the unsigned-max-upper shape's FIRST check (`value < 0`), whose satisfied predicate proves the
// value is a huge unsigned that the range ADMITS — its true edge is `inRange`, jumping past the
// remaining checks to the ok block.
enum RangeCheckEdge
	panic
	inRange
end 'RangeCheckEdge'

// One bound of a range check: the predicate that means "the check FIRED past this bound", the bound
// itself, and where a fired check leads. `lt`/`lo` for the lower bound (panic when `value < lo`),
// `gt`/`hi` for the upper — both leading to `panic`. `create` builds the common panic-edge check;
// `createInRange` the one check whose satisfied predicate means IN range (see `RangeCheckEdge`).
type RangeBoundCheck
	export var pred as StdCmpPred
	export var bound as ParsedInt
	export var onTrue as RangeCheckEdge
	export var unsigned as bool

	static function create(pred StdCmpPred, bound ParsedInt) returns RangeBoundCheck
		return Self{pred: pred, bound: bound, onTrue: RangeCheckEdge.panic, unsigned: false}
	end 'create'

	static function createUnsigned(pred StdCmpPred, bound ParsedInt) returns RangeBoundCheck
		return Self{pred: pred, bound: bound, onTrue: RangeCheckEdge.panic, unsigned: true}
	end 'createUnsigned'

	static function createInRange(pred StdCmpPred, bound ParsedInt) returns RangeBoundCheck
		return Self{pred: pred, bound: bound, onTrue: RangeCheckEdge.inRange, unsigned: false}
	end 'createInRange'
end 'RangeBoundCheck'

typealias RangeBoundCheckArray = Array with RangeBoundCheck

// The op list each guarded block held BEFORE its first guard split it, one entry per block id — see
// `RangeCheckEmitter.guardChainSource`. A row is filled the moment a split takes that block's list
// away from it; every other row stays the empty list the column was created with.
typealias PreSplitOpsByBlock = Array with OpIndexArray

// A guard's insertion point: the block to split and the `opRefs` position to split it at (ops before
// stay in the head, ops from here on move to the continuation). The position is what makes the guard
// fire AT its site rather than at the end of its block — see `guardSiteAt`.
type GuardSite
	export var block as IrBlock
	export var position as ElementIndex

	static function create(block IrBlock, position ElementIndex) returns GuardSite
		return Self{block: block, position: position}
	end 'create'
end 'GuardSite'

// ⭐ WHICH CHAIN THE EMITTED GUARD EXTENDS — the one thing an alias-named site owes after its split
// that a `return` site does not. Every guard in ONE source block splits that block, so the k-th guard
// must anchor inside the (k-1)-th's continuation; anchoring them all in the ORIGINAL head instead
// threads the cascades in REVERSE (see `guardSiteAt`). An alias-named site therefore moves its block's
// chain end — and its chain BASE, the offset that continuation begins at — to its own continuation. A
// `return` site records neither, and the reason is that IT HAS NO CHAIN TO RECORD: a block carries
// exactly ONE terminator, so a block holds at most one live `ret` and therefore owes at most one return
// guard. A return site READS the chain (`retBlockOf` resolves its recorded block to the chain end an
// alias-named guard may have moved its `ret` onto) and does not extend it — and that asymmetry is what
// makes "this block's `ret` is already guarded" derivable rather than tracked: the split leaves a
// CONDITIONAL BRANCH where the `ret` was, so a second site naming the same block finds no `ret` of its
// own — a program E3071 refuses at the parse (see `RetBlockLookup`).
union GuardChain
	blockChain(blockId BlockId)
	retChain
end 'GuardChain'

// What the shared site rule answers (`guardVerdict`): whether the RUNTIME half is owed, and against
// WHICH range. A union rather than a bool beside an alias, because "no guard" has no range to hand back
// — the two `noGuard` reasons are a full-range alias and a value settled at compile time, and neither
// leaves an alias for a caller to misread.
union RangeGuardVerdict
	noGuard
	guard(alias RangedTypeAlias)
end 'RangeGuardVerdict'

// ⭐⭐ **WHAT THE CASCADE COMPARES: THE VALUE ITSELF, OR WHAT A BY-REFERENCE PARAMETER'S CELL HOLDS.**
//
// A parameter its callee REASSIGNS arrives as the ADDRESS of a caller-owned cell
// (`IrFunction.reassignedParamMask`, and `LowerMaxonToStd`'s `stdTypeOf` types that slot `i64` for
// exactly this reason). Its `param` op's ValueId therefore holds a POINTER, so comparing THAT
// against the declared bounds is the wrong question: `function bump(n Int)` over
// `typealias Int = int(0 to 1000000)` would panic *"value outside typealias 'Int'"* on every call,
// because a heap address is not in `0 to 1000000`. The bounds describe what the CALLER passed,
// which lives one dereference away.
//
// ⚠ **A FULL-RANGE ALIAS HIDES THAT, WHICH IS WHY IT READS AS A TYPE PROBLEM RATHER THAN AN ABI ONE.** An
// `int(i64.min to i64.max)` parameter is `noGuard` (`rangeIsFull`), so the identical program with a wide
// alias runs correctly — the split is not between two types, it is between guarded and unguarded.
//
// It is a union rather than a bool beside a ValueId because the two carry different things: `asIs` names
// the value to compare, while `pointeeOf` names an address whose loaded contents do not exist yet and are
// minted by the guard itself.
union GuardedOperand
	asIs(value ValueId)
	pointeeOf(cell ValueId)
end 'GuardedOperand'

// The block whose terminator is this site's own exit (`retMatchesValue`) — the site to guard.
//
// ⭐⭐ **TWO OF `notFound`'s CAUSES ARE SHUT AT THE PARSE, AND A FOURTH IS STILL OPEN.** `notFound`
// means "this site's `ret` is not there any more". Two of its causes are one program shape — a
// second `return` in ONE block, which reaches here only where E3071 is not raised, a block holding ONE
// terminator in a slot `setTerminator` overwrites:
//
//   * `return n` twice ⇒ the second `setTerminator` overwrites the first with an identical `ret(n)`, the
//     FIRST site guards it, and that guard leaves a conditional branch where the `ret` stood — so the
//     second site finds no `ret`.
//   * `return a` then `return b` ⇒ the block's terminator is `ret(b)`, so site `a` finds a `ret` naming
//     a value that is not its own.
//
// **Both are refused at the parse** (`SourceParseError.unreachableCode`, plus the structural backstop in
// `ParseStaging.emitTerminator`). Neither can reach here.
//
// ⛔⛔ **THE SKIP STAYS, BECAUSE A PANIC IN ITS PLACE FIRES ON ORDINARY SOURCE — A RETURN WHOSE VALUE IS
// *PROMOTED* AT THE HAND-OFF.** MEASURED: with a panic in place the
// whole `specs` suite raises it exactly once, on
// `array-declared-record/the-self-spelling-of-a-corpus-served-member-reaches-the-same-body`, in a
// corpus-declared `Array.at` whose `returns Num` body hands back an opaque `Element`.
// `parseCheckedValueReturn` records the site's ValueId BEFORE calling `emitOwnedValueReturn`, which
// SHADOWS the name: `coOwnBorrowedOpaque` (and `promoteBorrowedToOwned`) replaces the value, and it is
// the REPLACEMENT the `ret` terminator carries. So `retMatchesValue` correctly answers `false` about a
// perfectly ordinary program, and the guard the pass had already decided it needed is dropped in
// silence. The surrounding comment at that push site states the opposite premise — *"a ranged int return
// is never an owned value, so `emitOwnedValueReturn` passes it through unwrapped"* — which a corpus
// GENERIC body falsifies, its declared return being a ranged alias while its value's tag is
// `typeParameter`.
//
// ⛔ **AND IT IS A LIVE WRONG ANSWER, not merely a dead cascade dropped.** In the corpus case the element
// type IS the declared alias, so the lost guard could not have fired; widen the instance and it can.
// MEASURED: a `Holder uses Element` whose `narrowedAt(i) returns Num` reads `try managed.get(i)`, held as
// `Holder with Wide` (`Num = int(0 to 1000)`, `Wide = int(0 to 100000)`), pushed `5000` and PRINTED
// `5000` — where every non-promoted spelling of the same narrowing panics *"Range check failed: value
// outside typealias 'Num'"*. **Its fix is its own change**, because it is not one line: recording what the
// `ret` actually carries is the mechanical half, and the other half is a design question with a cost —
// whether an opaque `T`'s range is provable from the enclosing instance, or whether every corpus generic
// body gains a cascade that can never fire. Not fixed here.
//
// The skip also hides a misfiled terminator: a value-returning variant filed with the non-returns
// in `retMatchesValue` drops every guard it carries in silence (`errorReturn` there would drop
// every ranged return of every throwing function). The set of Std terminators that return a value
// is also written in `StdOpMeta.role` (`OpRole.errorReturn` has no reader), and the two agree only
// by hand. The match is exhaustive, so a new variant is a compile error; an existing variant filed
// in the wrong arm is not. The panic is the right end state, and the promoted return above is what
// stands between here and it.
union RetBlockLookup
	notFound
	found(block IrBlock)
end 'RetBlockLookup'

// Run the pass over every function that has recorded range-check sites. Functions with none are skipped
// without touching their blocks.
export function insertRangeChecks(project Project, module StdModule)
	if compilerLogEnabled(CompilerLogGroup.ir, level: LogLevel.debug) 'debugging'
		compilerLogger(CompilerLogGroup.ir).debug("insertRangeChecks: {module.funcCount()} function(s)")
	end 'debugging'

	let waivers = EntryGuardWaivers.derive(project, module: module)
	var spellings = DeclarationQualifierMemo.create()

	// An INDEX loop: the function's position is the key its minted ids are filed under
	// (`ValueOriginTable.recordDerived`).
	for funcIndex in 0 upto module.functions.count() 'eachFunc'
		let func = try module.functions.get(funcIndex) otherwise panic("insertRangeChecks: functions.get OOB at {funcIndex}")

		// ⭐⭐ **A LIBRARY FUNCTION THE BACK END NEVER RECEIVES IS SKIPPED, AND THE REASON IS NOT MERELY
		// WASTED WORK — IT IS THE LOADER'S BYTE-NEUTRALITY INVARIANT.** Dead-function elimination drops such a
		// function before the back end, so its guard blocks never reach isel; but this pass registers the
		// guard's PANIC MESSAGE as an `.rdata` constant (`emitPanicBlock` → `registerStringBlob`), and DFE
		// prunes FUNCTIONS, never `.rdata`. The blob therefore survives its own function — and
		// `GlobalDataTable.nextStringId` is ONE counter shared by every rdata prefix, so a surviving blob
		// RENUMBERS every later `__str_blob_`/jump-table label in the program.
		//
		// It is the SAME fact `lowerMaxonToStd`'s two doors skip on, stated the same way — never "is this
		// whitelisted". A REACHABLE library function is not in it, so its guards and its compile-time E3005 are
		// emitted exactly as before, and no user function is ever in it.
		//
		// ⚠ **THE CLASS IS NOT CLOSED — only the three PRE-ELIMINATION doors are.** A dead `.rdata` payload
		// registered by a REACHABLE function is untouched, and so is the debt `DeadFunctionElimination`'s
		// header files — it prunes FUNCTIONS, never `.rdata`. What holds is narrower and exact: no pass
		// that runs before elimination lets a function the program cannot reach register anything.
		if project.libraryFacts.bodyIsSwept(func.name) 'notInTheProgram'
			continue
		end 'notInTheProgram'

		if not project.rangeChecks.contains(func.name) 'noChecks'
			continue
		end 'noChecks'

		let checks = try project.rangeChecks.get(func.name) otherwise panic("insertRangeChecks: rangeChecks.contains said yes but get failed for '{String.from(func.name)}'")
		var emitter = RangeCheckEmitter.create(project, module: module, func: func, funcIndex: funcIndex, waivers: waivers, spellings: spellings)
		emitter.run(checks)
	end 'eachFunc'
end 'insertRangeChecks'

// The `guardChainTail` an emitter starts with, SHARED and never mutated — `guardSiteAt` REPLACES
// the field with a freshly built index rather than filling this one.
//
// ⚠ It is shared for the reason `Parser`'s `sharedEmptyInstanceAliasNames` is: an emitter is built for
// every function carrying ANY range-check side data, which includes every function that merely passes a
// constant argument or constructs a generic instance, so an unconditional `ValueIdArray.create()` in
// `create` is one allocation per such function across the whole program. MEASURED on the scale ladder:
// as a per-emitter `create()` it cost +45 / +66 / +108 / +192 / +360 / +696 allocations across the six
// rungs — a linear cost, but a real one, paid entirely by functions that never emit a guard. Only ONE
// function in the whole generated corpus ever builds a real index (`scaleCoverCast`).
let sharedEmptyGuardChainTail = ValueIdArray.create()

// The `guardChainBase` companion to it, shared for the identical reason and replaced in the identical
// place — the three chain columns are built together and are empty together, so
// `guardChainTail.isEmpty()` is the one test that decides for all of them.
let sharedEmptyGuardChainBase = BlockOpPosArray.create()

// One pre-split op list per block id — see `RangeCheckEmitter.guardChainSource`. Shared and replaced
// exactly as the two columns above are.
let sharedEmptyGuardChainSource = PreSplitOpsByBlock.create()

// Per-function emitter: owns the module + function it rewrites and the fresh-ValueId counter its guard
// ops draw from (seeded past every id the function already uses).
type RangeCheckEmitter
	var project as Project
	var module as StdModule
	var func as IrFunction
	var funcIndex as ElementIndex
	var ids as ValueMinter

	// The function's compile-time constants, PARTITIONED BY DOMAIN: an integer `const`'s payload is a
	// number, a float `const`'s is an IEEE-754 bit pattern, and the two must never be read as each
	// other. Filled by `collectConsts` at the top of `run`; a site consults the map that matches its
	// alias's domain, so a domain mismatch simply is not a literal and falls through to the runtime
	// guard — see `needsRuntimeGuard`.
	var intConsts as ConstValueMap
	var floatConsts as ConstValueMap

	// ⭐ **WHICH OF THIS FUNCTION'S CONSTANTS THE SOURCE WROTE AS NEGATIVE NUMBERS** — the one fact about a
	// constant that this tier cannot recover from the constant, because `-1`, `u64.max` and
	// `0xFFFFFFFFFFFFFFFE` are the same 64 bits. Handed over by the parser on `FunctionRangeChecks` and
	// stashed in `run` beside `collectConsts`, for the same reason: `needsRuntimeGuard` asks it per value
	// and does not otherwise hold the function's checks. See `Parser.writtenNegativeLiterals`.
	var writtenNegativeLiterals as ValueMarkColumn
	var unsignedMaxLiterals as ValueMarkColumn

	var borrowOperands as BorrowOperandsColumn

	// Where each of this function's blocks currently ENDS — a blockRef index (+1, `buildBlockIdIndex`'s
	// sentinel encoding) per block id. It starts as the plain block-id => blockRef index (every block is
	// its own chain end), and each guard MOVES its site block's entry to the continuation the split
	// minted, so the next guard in that source block lands after it rather than before it. Starts as the
	// SHARED empty one and is REPLACED by a real index on first use — see `sharedEmptyGuardChainTail`
	// and `guardSiteAt`.
	var guardChainTail as ValueIdArray

	// ⭐ **WHERE EACH CHAIN-END BLOCK BEGINS, IN ITS ORIGINAL BLOCK'S COORDINATES** — one position per
	// block id, and the other half of what makes site positions and the guard CHAIN compose. A site's
	// recorded position (`RangeCheckSite.stdOpPos`) is an offset into the block as the
	// LOWERING left it; but the k-th guard SPLITS that block, so the (k+1)-th site's op now sits in the
	// continuation at `position - base`, where `base` is where the last split cut. Zero until a block's
	// first guard splits it, and moved to the split point by every split after that. Built and shared
	// exactly as `guardChainTail` is — the three chain columns are one index in three columns, so one
	// `isEmpty` decides all of them.
	var guardChainBase as BlockOpPosArray

	// ⭐⭐ **THE OP LIST EACH GUARDED BLOCK HELD BEFORE ITS FIRST GUARD SPLIT IT — THE ONE LIST EVERY
	// SEGMENT OF ITS CHAIN IS CARVED OUT OF, AND THE REASON THIS PASS IS LINEAR IN ITS BYTES.** A
	// chain-end block is carved by copying out the ops between the previous split point and this one; the
	// ops PAST this split point are not touched at all, and the continuation is left EMPTY until
	// `materializeChainTails` places them, once, when no further split can move them. Over k guards in a
	// block of B ops that copies B op refs in total rather than Θ(k × B) — see `splitChainEnd`.
	//
	// It is also the coordinate space a site's recorded `stdOpPos` is written in, which is why
	// `guardSiteAt` bounds-checks against it and not against a block whose front the splits have carved
	// away. Built and shared exactly as the two columns above are.
	var guardChainSource as PreSplitOpsByBlock

	var waivers as EntryGuardWaivers
	var spellings as DeclarationQualifierMemo

	static function create(project Project, module StdModule, func IrFunction, funcIndex ElementIndex, waivers EntryGuardWaivers, spellings DeclarationQualifierMemo) returns RangeCheckEmitter
		return Self{project: project, module: module, func: func, funcIndex: funcIndex, waivers: waivers, ids: ValueMinter.resuming(nextFreeValueId(module, func: func)), intConsts: ConstValueMap.create(), floatConsts: ConstValueMap.create(), writtenNegativeLiterals: noValueMarks, unsignedMaxLiterals: noValueMarks, borrowOperands: noBorrowOperands, guardChainTail: sharedEmptyGuardChainTail, guardChainBase: sharedEmptyGuardChainBase, guardChainSource: sharedEmptyGuardChainSource, spellings: spellings}
	end 'create'

	// A fresh ValueId for a guard op. The colored register file / dense value columns downstream grow to
	// fit the highest id, so a monotonically increasing id past the function's current maximum is all
	// that is required.
	function mintId() returns ValueId
		return self.ids.mint()
	end 'mintId'

	// A fresh id that stands in for `source` — a guard's bound or compare for the value it checks, a cell
	// load for its cell — filed so an E5001 naming it names the value the author wrote
	// (`ValueOriginTable.recordDerived`).
	function mintDerived(source ValueId) returns ValueId
		let id = self.mintId()
		self.project.valueOrigins.recordDerived(self.funcIndex, valueId: id, sourceId: source)
		return id
	end 'mintDerived'

	// Process one function's sites. The alias-named sites FIRST (they split blocks and move terminators
	// onto new continuation blocks), then the call-argument sites — which emit nothing, so their order is
	// free — then returns, which therefore read the chain index those splits have already advanced
	// (`retBlockOf`). The literal/const map is built ONCE over the original ops — the values a site checks
	// are original, never the guard consts this pass appends afterward.
	export function run(checks FunctionRangeChecks)
		// The parser's answers to what a constant's 64 bits cannot say — stashed beside the const maps
		// because `needsRuntimeGuard` asks both per value and holds neither otherwise. See
		// `writtenNegativeLiterals`. Loaded BEFORE `collectConsts`, which reads `unsignedMaxLiterals` to
		// record the folds the parser marked; loaded after, those folds reach their sites as runtime
		// values rather than literals.
		self.writtenNegativeLiterals = checks.writtenNegativeLiterals
		self.unsignedMaxLiterals = checks.unsignedMaxLiterals
		self.borrowOperands = checks.borrowOperands
		self.collectConsts()

		// A site's `stdOpPos` is `lowerMaxonToStd`'s answer rather than the parser's (see `RangeSiteWalk`),
		// and 0 is a legitimate one — so the promise is checked HERE, once per function, rather than
		// per site: a function that reached this pass unlowered would otherwise anchor every one of its
		// guards at the top of its block, silently.
		if not checks.sites.isEmpty() and not checks.positionsResolved 'unlowered'
			panic("run: '{String.from(self.func.name)}' has {checks.sites.count()} range-check site(s) whose Std positions `lowerMaxonToStd` never filled — this pass runs over the module that lowering just produced, so every function it walks was walked there first")
		end 'unlowered'

		// ⚠ **BEFORE EVERY OTHER SITE IN THE FUNCTION, AND THAT IS AN ORDERING REQUIREMENT RATHER THAN A
		// preference.** An entry guard splits the entry block at the end of its `param` ops, which is a
		// position at or before every body site's — and `guardSiteAt` refuses a position that has fallen
		// BEHIND its block's chain base, because sites are consumed in source order.
		self.guardRangedParams(checks)

		for site in checks.sites 'eachSite'
			self.processSite(site, filePath: checks.filePath)
		end 'eachSite'

		// ⚠ **AFTER THE LAST ALIAS-NAMED SITE AND BEFORE THE RETURN SITES, AND BOTH HALVES ARE
		// LOAD-BEARING.** A chained split leaves its continuation's ops PENDING (`splitChainEnd`), so
		// until this runs the last continuation of every guarded block is empty — and `guardReturns`
		// splits the block it finds AT ITS END, an end that is not where that block ends yet. Running it
		// after the loop is what makes the pending tail cost one placement per block instead of one per
		// guard.
		self.materializeChainTails()

		for argSite in checks.argSites 'eachArgSite'
			self.processArgSite(argSite, filePath: checks.filePath)
		end 'eachArgSite'

		self.processReturnSites(checks)
	end 'run'

	// ---- alias-named sites (cast, struct-literal field, field store, field default, array element) ----

	// The site rule for a position that holds an alias NAME: it resolves the declaration and asks
	// `runtimeHalfOf`, which an `alias` site holding its resolved declaration asks directly. It raises the compile-time E3005 on its way to its answer and says
	// whether the RUNTIME half is owed too.
	//
	// ⚠ **`needsRuntimeGuard` IS ASKED FIRST AND UNCONDITIONALLY, INCLUDING FOR A POSITION THAT WILL NEVER
	// EMIT ONE**, because raising that E3005 for a folded literal is what it does on the way to its answer.
	// Both halves of the rule are one decision (`range-check-panic.md` says so outright), and splitting
	// them so a `compileTimeOnly` position could skip the call would be two deciders that can drift.
	//
	// ⭐ **TWO FILES, AND THEY ARE NOT THE SAME QUESTION.** `alias` is the declaration the door
	// resolved — at a call argument the CALLEE's, whose parameter range it is. `filePath` is where the
	// DIAGNOSTIC and the runtime panic message point, and at a call argument that is the line that
	// wrote the argument. Conflated, `utf16LeadSurrogate(1000000000)` reports the caller's line and
	// column against the STDLIB's path — a position that names a `typealias` declaration, in a file
	// the program never wrote a call in.
	//
	// It takes the position's parts rather than a `RangeCheckSite` because the constant call-argument
	// door (`RangeCheckArgSite`) has no such site to hand it: synthesizing one there would have to
	// invent a `maxonOpPos` the position does not have and no reader would ever spend — a magic value
	// one refactor away from being believed.
	function guardVerdict(value ValueId, alias RangedTypeAlias, guard RangeCheckGuard, line LineNumber, column ColumnNumber, filePath FilePath) returns RangeGuardVerdict
		if not self.needsRuntimeGuard(value, alias: alias, line: line, column: column, filePath: filePath) 'settledAtCompileTime'
			return RangeGuardVerdict.noGuard
		end 'settledAtCompileTime'

		if guard == RangeCheckGuard.compileTimeOnly 'compileTimeHalfOnly'
			return RangeGuardVerdict.noGuard
		end 'compileTimeHalfOnly'

		return RangeGuardVerdict.guard(alias)
	end 'guardVerdict'

	// A range site: the site's own `stdOpPos` is where in its block the guard goes. An `alias` site is
	// guarded against its alias; a `callArgument` site is a full-unsigned parameter's call-site check
	// (`guardCallArgument`). Every one of them owes the runtime half, so no site carries a
	// `RangeCheckGuard` to be asked for.
	//
	// The two files are not always one here. The cast and the array element resolve their alias in
	// this function's own file, a field in its declaring file, and the arm-served index in the
	// callee's (`Parser.requireArmServedIndexArgument`), so the site carries the declaration it
	// resolved (`RangeCheckSiteTarget.alias`).
	function processSite(site RangeCheckSite, filePath FilePath)
		match site.target 'target'
			alias(alias) then self.guardSiteAgainst(site, alias: alias, filePath: filePath)
			callArgument(callResult, argIndex, label, sourceMayBeNegative) then self.guardCallArgument(site, callResult: callResult, argIndex: argIndex, label: label, sourceMayBeNegative: sourceMayBeNegative, filePath: filePath)
		end 'target'
	end 'processSite'

	function guardSiteAgainst(site RangeCheckSite, alias RangedTypeAlias, filePath FilePath)
		match self.guardVerdict(site.value, alias: alias, guard: RangeCheckGuard.runtime, line: site.line, column: site.column, filePath: filePath) 'verdict'
			noGuard then return
			guard(guarded) then _ = self.emitGuardAt(self.guardSiteAt(site.block, stdOpPos: site.stdOpPos), operand: GuardedOperand.asIs(site.value), alias: guarded, chain: GuardChain.blockChain(site.block), filePath: filePath, line: site.line, column: site.column)
		end 'verdict'
	end 'guardSiteAgainst'

	function guardCallArgument(site RangeCheckSite, callResult ValueId, argIndex ParamCount, label ByteArray, sourceMayBeNegative bool, filePath FilePath)
		if not sourceMayBeNegative or self.intConsts.contains(site.value) 'nothingToTestAtRunTime'
			return
		end 'nothingToTestAtRunTime'

		match self.waivers.waivedParamOfCall(self.funcIndex, callResult: callResult, argIndex: argIndex, label: label, project: self.project) 'param'
			none then return
			found(param) then self.guardSiteAgainst(site, alias: param.alias, filePath: filePath)
		end 'param'
	end 'guardCallArgument'

	// ---- narrowed PARAMETERS: the runtime half of the call-argument door ----

	// ⭐⭐ **THE GUARD GOES AT THE CALLEE'S ENTRY, NOT AT THE CALL.** A call argument is the one door whose
	// check cannot be emitted where it is written: a check is a BRANCH, and an argument is evaluated
	// part-way through building an argument list, so the guard would land PAST the call with the callee
	// already run (`RangeCheckGuard` states the obstacle in full). The callee's entry block splits cleanly,
	// needs no argument-list restructuring, and costs ONE guard per narrowed parameter per FUNCTION rather
	// than one per CALL.
	//
	// ⭐ **IT ALSO COVERS EVERY CALLER WITH NOTHING TO ENUMERATE.** A call through a function value has
	// no callee name at the call site to look a parameter's range up by
	// (`callIndirect`/`witnessCall`); one guard behind the entry covers direct calls, indirect calls
	// and witness dispatch alike. A full-unsigned parameter is the exception: its argument is checked
	// at every kind of call site, and its entry guard is waived only when every path reaching the
	// callee is checked (`EntryGuardWaivers`).
	//
	// ⚠ **WHY THIS IS NOT COSMETIC.** `specs/safety.md` promises that `/` and `mod` are THROWING
	// operations, and that a divisor "proven non-zero — a non-zero literal, or a ranged type whose range
	// excludes 0 — compiles to a bare divide with no check". A `NonZero` PARAMETER is treated as proven, so
	// the guard is elided; with the premise unenforced the proof was false, and a catchable `DivisionByZero`
	// became an uncatchable hardware fault that `recover()` cannot see. Enforcing the premise is what makes
	// the elision legitimate.
	//
	// The panic names the PARAMETER's own declaration line, not the caller's: one guard stands in front of
	// every call, so the caller's line is not a fact it holds — and the parameter list is where the premise
	// is declared, which is the honest thing for it to name.
	//
	// ⚠ **THE COST IS NOT THE COMPARE — IT IS THAT A GUARDED LEAF STOPS BEING A LEAF.** `emitPanicBlock`
	// emits a `call mrt_panic`, so a function that had no call at all acquires one, and
	// `prologueEpilogue` gives it a real frame: `division/ranged-divisor-is-a-bare-idiv`'s `divide` gained
	// `x64.prologue 32` / `x64.epilogue 32` around a body that still ends in the same bare `idiv`. That is
	// a per-FUNCTION cost paid on the in-range path, not an instruction count on the failing one, and it
	// is the honest price of the elision the guard makes legitimate.
	function guardRangedParams(checks FunctionRangeChecks)
		if checks.paramSites.isEmpty() 'noRangedParam'
			return
		end 'noRangedParam'

		let entryRef = try self.func.blockRefs.get(0) otherwise panic("guardRangedParams: '{String.from(self.func.name)}' declares a ranged parameter but has no entry block")
		let entryId = self.module.getBlock(entryRef).id

		for site in checks.paramSites 'eachRangedParam'
			self.guardRangedParam(site, entryId: entryId, filePath: checks.filePath)
		end 'eachRangedParam'
	end 'guardRangedParams'

	// ⚠ **THE POSITION IS `paramCount`, WHICH IS EXACTLY PAST THE `param` OPS AND NOWHERE ELSE.**
	// `LowerMaxonToStd.emitParams` appends one `StdOp.param` per parameter to `blockRefs[0]` before a single
	// body op is lowered, so the first `paramCount` ops of the entry block ARE the incoming-register
	// captures. Guarding before them would compare a value no `mov` has produced yet; guarding after any
	// body op would let that op run on the value the range forbids. Both the ALIAS reader and the
	// DIAGNOSTIC file are the callee's own — a parameter's range is the one visible where the function was
	// written, and the panic points at the parameter itself.
	//
	// ⚠ **"THE ONE VISIBLE WHERE THE FUNCTION WAS WRITTEN" IS ONLY AS GOOD AS
	// `RangedAliasRegistry.lookup`,** which the parser asks with the callee's own path. **A name the
	// callee's file does not itself declare resolves to a declaration that file MAY NAME**, so this
	// site gets the callee's own exported/stdlib alias — LAST-WINS there lets a user `typealias
	// Codepoint = int(0 to 100)` make `stdlib/helpers/string/utf16.maxon`'s
	// `utf16LeadSurrogate(codepoint Codepoint)` panic on a legal `70000` against a range from a file
	// it has never seen. What remains open, and is E3063's, is a contest between two declarations the
	// reader may BOTH name.
	//
	// ⚠ A parameter is never a folded constant (its ValueId is defined by a `param` op, not a `const`), so
	// `guardVerdict`'s compile-time half never fires here; what it decides for a parameter is the one thing
	// that matters, `rangeIsFull` — a full-range parameter promises nothing and gets nothing.
	//
	// ⭐ **INT AND FLOAT ALIKE, AND THE SYMMETRY IS THE POINT RATHER THAN A CONVENIENCE.** `emitGuardAt`
	// already forks the entire cascade on `aliasIsFloat` for the `as` and `return` doors, so a float
	// parameter needs nothing of its own — and guarding only the integer half would replace *five doors of
	// which four guard* with *parameters of which only the int ones guard*, which is a fresh instance of
	// the very defect this pass exists to delete. `rangedParamSites` records a float alias for the same
	// reason `rangedReturnAlias` excludes none: the domain is decided where
	// the BOUNDS are read, never where the site is recorded.
	//
	// ⭐ **A `function f(x T) returns T … return x` GUARDS THE VALUE ONCE — HERE.** The `return` site's
	// own guard is elided against this one, and the argument for that lives at `entryGuardAlreadyCovers`,
	// which is where the two facts it needs are both in hand. This site emits exactly as it always did.
	//
	// ⭐⭐ **AND IT IS THE ONE DOOR THAT MAY BE HANDED AN ADDRESS RATHER THAN A VALUE** — see
	// `GuardedOperand`. `rangedParamValue(site)` is the parameter's own `param` op, which for a
	// by-reference parameter defines a CELL POINTER; the range describes what the cell holds. The other two
	// doors cannot reach this shape: a cast and a `return` both name a value the body computed, and a cell
	// binding's read is already a `loadIndirect` by the time either sees it.
	function guardRangedParam(site RangeCheckParamSite, entryId BlockId, filePath FilePath)
		if self.waivers.isWaived(self.func.name, index: site.index) 'everyCallerGuardsIt'
			return
		end 'everyCallerGuardsIt'

		let paramValue = rangedParamValue(site)

		match self.guardVerdict(paramValue, alias: site.alias, guard: RangeCheckGuard.runtime, line: site.line, column: site.column, filePath: filePath) 'verdict'
			noGuard then return
			guard(alias) then self.emitParamGuard(site, alias: alias, entryId: entryId, filePath: filePath)
		end 'verdict'
	end 'guardRangedParam'

	// A parameter guard is the one guard this pass emits that a later pass can prove dead, because its
	// premise belongs to the caller: `InlineLeaves` splices this body into a frame that may already
	// know the argument is in range — from its own entry guard, or from a counted loop's interval —
	// and declines to copy a cascade it can identify. Identifying one needs this record, because an
	// emitted guard is a compare, a branch and a panicking block, which is also what a hand-written
	// `if x < 0 'bad' panic(…) end` is.
	//
	// The head is read before the emit and the ok block after it, and neither is `entryId`. A second
	// ranged parameter's cascade splits the first one's `__rc_ok` (`guardSiteAt` resolves a site to
	// its block's current chain end), so the k-th guard's head is the (k-1)-th's ok block and only the
	// first one's head is the entry. Recording `entryId` for all of them would make the inliner skip
	// the first guard's compare while jumping into the second's.
	//
	// A guard whose bounds both elide splits nothing and is not a cascade to record: `emitGuardAt`
	// hands back the head it was given.
	function emitParamGuard(site RangeCheckParamSite, alias RangedTypeAlias, entryId BlockId, filePath FilePath)
		let guardSite = self.guardSiteAt(entryId, stdOpPos: self.func.paramCount)
		let headId = guardSite.block.id
		self.requireGuardHeadHoldsOnlyParams(guardSite)

		// Everything `emitGuardAt` mints — the `__rc_ok` continuation, the `__rc_panic`, one `__rc_chk`
		// per extra bound — goes through `IrModule.addBlock`, which hands out `func.nextBlockId` and
		// bumps it, so `[firstMintedId, nextBlockId)` is exactly this guard's blocks with no second list
		// to keep in step.
		let firstMintedId = self.func.nextBlockId
		let ok = self.emitGuardAt(guardSite, operand: self.paramOperand(site), alias: alias, chain: GuardChain.blockChain(entryId), filePath: filePath, line: site.line, column: site.column)

		if ok.id == headId 'bothBoundsElided'
			return
		end 'bothBoundsElided'

		var owned = BlockIdArray.create()
		owned.push(headId)

		for mintedId in firstMintedId upto self.func.nextBlockId 'eachMintedBlock'
			if mintedId != ok.id 'notTheContinuation'
				owned.push(mintedId)
			end 'notTheContinuation'
		end 'eachMintedBlock'

		self.func.recordParamGuard(site.index, alias: alias, headBlockId: headId, okBlockId: ok.id, ownedBlockIds: owned)
	end 'emitParamGuard'

	// ⛔⛔ **THE OPS THE CASCADE'S HEAD KEEPS MUST BE `param` OPS AND NOTHING ELSE, AND A BREACH IS A
	// DELETION RATHER THAN A MISPLACEMENT.** `guardSiteAt` anchors at `paramCount`, which is exactly
	// past the incoming-register captures `LowerMaxonToStd.emitParams` appends before any body op, so the
	// head this split leaves holds precisely those. `InlineLeaves` DECLINES to copy that head when it can
	// prove the cascade dead, and a `param` op is the one op a splice does not need copied (it becomes the
	// call's argument). Anything ELSE that ends up in front of the guard is an op the splice silently
	// drops. This says so where the assumption is made instead of leaving it to the shape of another pass.
	//
	// ⚠ It walks only the guard's OWN prefix (`site.position`), which is `paramCount` for the first cascade
	// in a block and 0 for every chained one — the k-th guard splits the (k-1)-th's continuation, which is
	// minted empty. So the cost is one arity-bounded walk per guarded function, not per op.
	function requireGuardHeadHoldsOnlyParams(site GuardSite)
		for pos in 0 upto site.position 'eachPrefixOp'
			let opIdx = try site.block.opRefs.get(pos) otherwise panic("requireGuardHeadHoldsOnlyParams: block {site.block.id} of '{String.from(self.func.name)}' has no op at position {pos}, inside the prefix `guardSiteAt` resolved")

			match self.module.getOp(opIdx) 'op'
				const or
				binOp or
				unaryOp or
				cmp or
				binOpImm or
				cmpImm or
				div or
				mod or
				condBranch or
				branch or
				ret or
				call or
				retVoid or
				globalAddr or
				loadIndirect or
				storeIndirect or
				osAllocPages or
				osWriteStdout or
				rdataAddr or
				tryCall or
				errorReturn or
				osExit or
				funcAddr or
				callIndirect or
				osPanic or
				osReadClock or
				osProcessSpawn or
				osProcessExitCode or
				osCloseHandle or
				osWaitHandle or
				osWaitChild or
				osFreePages or
				switch or
				witnessCall or
				osPipeCreate or
				osEventCreate or
				osThreadCreate or
				osLockInit or
				osLockEnter or
				osLockLeave or
				osReadOverlapped or
				osLastError or
				osProcessSpawnInherit or
				osCancelIo or
				osGetPid or
				osPipeCreateOutbound or
				osWriteFile or
				osReadWallClock or
				witnessTryCall or
				osFileOpenRead or
				osFileClose or
				osReadFile or
				osFileOpenWrite or
				osFileSize or
				osFileDelete or
				osFileRename or
				osFileFindFirst or
				osFileFindClose or
				osFileFindNext or
				osDirCreate or
				osDirRemove or
				osDirCurrentPath or
				osFileAttributes or
				osPanicValue or
				osCommandLine or
				osStdHandle or
				osExecutablePath or
				osProcessNamespace or
				osRandomFill or
				osWriteStderr or
				stackRecordAddr or
				osOpenNamedSegment or
				osMapNamedSegment or
				osTickCountMs or
				osHandleSetInherit or
				osPipePeek or
				osEnvRead or
				osProcessTerminate or
				osSocketStartup or
				osSocketResolve or
				osSocketFreeAddrInfo or
				osSocketCreate or
				osSocketConnect or
				osSocketSend or
				osSocketError or
				osSocketRecv or
				osSocketClose or
				osCpuCount or
				osThreadCpuTicks or
				osDecommitPages or
				memFill or
				osCommitPages or
				osReservePages or
				atomicCas or
				atomicRmw or
				currentThreadToken or
				tlsAlloc or
				tlsSetValue or
				tlsSlotLoad or
				osSetEvent or
				osEnterBackgroundPriority or
				osFileOpenWriteExecutable or
				osFileOpenCreateNew or
				osEnvBlock or
				osEnvBlockFree or
				loadAcquire or
				storeRelease or
				osHandleFileType or
				osProcessProbe or
				osProcessExitSignal or
				osCreateNamedSegment or
				osAdoptNamedSegment or
				osUnmapNamedSegment or
				osUnpublishNamedSegment or
				covPoint or
				osHostProcess or
				osNetpoll or
				osPathQuery or
				osSocketOverlapped or
				osSocketServe then self.refuseNonParamAheadOfAGuard(pos)
				param then break
			end 'op'
		end 'eachPrefixOp'
	end 'requireGuardHeadHoldsOnlyParams'

	// The refusal both non-`param` arms share — ONE message, because they say one thing.
	function refuseNonParamAheadOfAGuard(pos ElementIndex)
		panic("requireGuardHeadHoldsOnlyParams: op {pos} of '{String.from(self.func.name)}'s entry block stands AHEAD of its parameter guard and is not a `param` op — the guard is anchored at `paramCount` on the premise that the first `paramCount` ops are the incoming-register captures, and `InlineLeaves` drops that whole block when it declines the cascade")
	end 'refuseNonParamAheadOfAGuard'

	// Is this parameter an address or a value? `reassignedParamMask` is the ABI's own answer — the same bit
	// `LowerMaxonToStd` types the slot from and `transferFuncs` shapes the callee's signature with — so this
	// door and the representation cannot come to disagree.
	//
	// It takes the SITE and re-derives both halves through `rangedParamValue`, because the value and the
	// parameter position are ONE number (see that function): passing them side by side would be two spellings
	// of one identity, free to be handed different sites on the day someone splits the call.
	function paramOperand(site RangeCheckParamSite) returns GuardedOperand
		if maskHasParam(self.func.reassignedParamMask, param: site.index) 'arrivesAsACellAddress'
			return GuardedOperand.pointeeOf(rangedParamValue(site))
		end 'arrivesAsACellAddress'

		return GuardedOperand.asIs(rangedParamValue(site))
	end 'paramOperand'

	// ---- call-argument sites ----

	// ⭐ **A CALL ARGUMENT'S ALIAS IS FOUND HERE RATHER THAN AT THE PARSE** — this constant-argument
	// site's and the `callArgument` range site's alike (`guardCallArgument`). A direct call argument's
	// declared type belongs to the callee, which the caller's file may never have seen (see
	// `RangeCheckArgSite`); this pass runs once, after every file has merged, so the callee's own
	// record is in hand. Found, it asks the SAME `guardVerdict` every other position asks — there is
	// no second decision anywhere for a call argument.
	//
	// ⚠ The alias is the CALLEE's declaration, never one this function's file resolves: the range a
	// parameter was declared with is the one visible where the FUNCTION was written. The diagnostic's
	// file stays this function's — see `guardVerdict`.
	function processArgSite(site RangeCheckArgSite, filePath FilePath)
		let alias = try self.paramAliasOf(site) otherwise return
		self.checkArgAgainstParamRange(site, alias: alias, filePath: filePath)
	end 'processArgSite'

	// A call argument owes the COMPILE-TIME half and NOTHING ELSE (`RangeCheckGuard`), so it asks the
	// shared decider purely for the E3005 that decider raises on its way to an answer. The `guard` arm is
	// unreachable by construction — the argument is asked as `compileTimeOnly` — and says so, rather than
	// quietly anchoring a guard at a position a call argument has no way to name.
	function checkArgAgainstParamRange(site RangeCheckArgSite, alias RangedTypeAlias, filePath FilePath)
		match self.guardVerdict(site.value, alias: alias, guard: RangeCheckGuard.compileTimeOnly, line: site.line, column: site.column, filePath: filePath) 'verdict'
			noGuard then return
			guard then panic("checkArgAgainstParamRange: a call argument was asked as `compileTimeOnly` and came back owing a RUNTIME guard — `guardVerdict` must never answer `guard` for a compile-time-only position")
		end 'verdict'
	end 'checkArgAgainstParamRange'

	function paramAliasOf(site RangeCheckArgSite) returns RangedTypeAlias throws MapError
		match site.parameter 'parameter'
			ofCallee(_, callee, argIndex, label) then return try self.calleeParamAliasOf(callee, argIndex: argIndex, label: label)
			slotAlias(alias) then return alias
		end 'parameter'
	end 'paramAliasOf'

	// The ranged alias the argument's PARAMETER was declared with. A miss covers every ordinary call:
	// a callee with no ranged parameter at all files no `paramSites`, and an argument landing on an
	// unranged position matches no site. A malformed call (bad arity, unknown label) is SemanticCheck's to
	// report and does not reach lowering — `calleeParamSlot` panics on one.
	//
	// ⚠ The scan is over the callee's RANGED parameters only — usually one, never more than its arity — so
	// it is bounded by the same `arity` the label lookup it sits beside already walks (`argSlotPosition`
	// scans `paramNames`), and it adds no growth shape this call did not already have.
	function calleeParamAliasOf(callee ByteArray, argIndex ParamCount, label ByteArray) returns RangedTypeAlias throws MapError
		let calleeChecks = try self.project.rangeChecks.get(callee)

		if calleeChecks.paramSites.isEmpty() 'noRangedParam'
			throw MapError.keyNotFound
		end 'noRangedParam'

		let slot = calleeParamSlot(self.project, callee: callee, argIndex: argIndex, label: label)
		return try calleeChecks.paramAliasAt(slot)
	end 'calleeParamAliasOf'

	// ---- return sites ----

	// A ranged `return` is checked against the range declared where the FUNCTION was written, which
	// the parser resolved into `checks.returnAlias`. It takes the whole `FunctionRangeChecks` because
	// `guardReturns` needs the PARAMETER sites too (see `entryGuardAlreadyCovers`), and threading a
	// fifth field through would leave the two halves of one question arriving separately.
	function processReturnSites(checks FunctionRangeChecks)
		match checks.returnAlias 'bounds'
			undeclared then return
			declared(alias) then self.guardReturns(alias, checks: checks)
		end 'bounds'
	end 'processReturnSites'

	function guardReturns(alias RangedTypeAlias, checks FunctionRangeChecks)
		for site in checks.returnSites 'eachSite'
			// Asked first and unconditionally: it raises the compile-time E3005 on its way to an answer
			// (`guardVerdict` keeps the same discipline), and it is what makes the elision below legitimate.
			// Clause 4 is that the parameter is guarded, and only this function answering `false` for the
			// same value against the same alias could have stopped its entry guard existing.
			if not self.needsRuntimeGuard(site.value, alias: alias, line: site.line, column: site.column, filePath: checks.filePath) 'noGuard'
				continue
			end 'noGuard'

			if self.entryGuardAlreadyCovers(site.value, alias: alias, checks: checks) 'guardedAtTheEntry'
				continue
			end 'guardedAtTheEntry'

			match self.retBlockOf(site) 'ret'
				notFound then break
				found(retBlock) then _ = self.emitGuardAt(GuardSite.create(retBlock, position: retBlock.opRefs.count()), operand: GuardedOperand.asIs(site.value), alias: alias, chain: GuardChain.retChain, filePath: checks.filePath, line: site.line, column: site.column)
			end 'ret'
		end 'eachSite'
	end 'guardReturns'

	// ⭐⭐ **IS THIS `return`'S VALUE ALREADY STANDING BEHIND THIS FUNCTION'S OWN ENTRY GUARD?**
	// `function f(x T) returns T … return x` would otherwise emit the entry cascade and an identical return
	// cascade over the same `ValueId` against the same alias. The second is elided — and a guard elided on a
	// premise nothing enforces is how a range check goes missing, so the premise is spelled out and pinned
	// rather than asserted. **Four clauses, and `specs/range-check-panic.md` has a case for each:**
	//
	//   1. **THE SAME VALUE.** Dense SSA numbers a value once, and a parameter's `ValueId` is defined by its
	//      `param` op — so `site.value == rangedParamValue(paramSite)` is an IDENTITY, not an inference. A
	//      `var` shadow reassigned before the `return` carries a different id (`Scope.setValue` rebinds),
	//      and a parameter cannot be mutated at all (E2013). ⇒ `return-of-a-reassigned-shadow-is-still-guarded`,
	//      `return-of-a-computed-value-is-still-guarded`.
	//   2. **THE SAME ALIAS.** `isTheSameDeclarationAs` compares DECLARATIONS, so a match is one pair of
	//      bounds. A narrower return alias over the same parameter is a different declaration and gets its
	//      guard. ⇒ `return-through-a-narrower-alias-is-still-guarded`.
	//   3. **DOMINANCE.** `guardRangedParams` splits the ENTRY block at `func.paramCount`, which is exactly
	//      past `emitParams` and before a single body op, so every path to every `return` runs the cascade
	//      first. This is the one clause no program can break — there is no `return` reachable without
	//      passing the entry. ⇒ `entry-guard-covers-a-return-inside-a-branch`.
	//   4. **THE PARAMETER IS GUARDED.** Both sites route through the same `needsRuntimeGuard` with
	//      the same value and the same alias, and `guardReturns` asks it BEFORE this — so this is
	//      reached only on the answer that made the entry guard fire. A full-unsigned parameter whose
	//      entry guard is waived (`EntryGuardWaivers`) is in range on entry all the same: every path
	//      reaching it checked its argument or passed an unsigned source. The one remaining way a
	//      guard can be skipped is shared too: `emitGuardAt`'s both-bounds-elided return is a function
	//      of the alias alone, so it fires at neither site or both.
	//
	// ⚠ **A LINEAR SCAN, AND BOUNDED BY THE ARITY** — `paramSites` is SPARSE (one entry per RANGED
	// parameter, never per parameter), so this walks at most the function's ranged parameters, which
	// is usually one and never more than `MaxAbiArgs`. It is the same bound `paramAliasAt`'s scan
	// already has and adds no growth shape a call did not have.
	function entryGuardAlreadyCovers(value ValueId, alias RangedTypeAlias, checks FunctionRangeChecks) returns bool
		for paramSite in checks.paramSites 'eachRangedParam'
			if rangedParamValue(paramSite) == value and paramSite.alias.isTheSameDeclarationAs(alias) 'sameValueSameAlias'
				return true
			end 'sameValueSameAlias'
		end 'eachRangedParam'

		return false
	end 'entryGuardAlreadyCovers'

	// ---- the shared decision ----

	// Whether a site needs a RUNTIME guard. A literal of the alias's OWN domain never does (its
	// out-of-range use is reported here as a compile-time E3005, its in-range use needs no code); a
	// full-range alias never does; everything else does.
	//
	// ⚠ THE DOMAIN TEST IS PART OF THE LITERAL TEST, not decoration. `collectConsts` records every
	// `const`'s payload with no regard for its type, and a FLOAT const's payload is an IEEE-754 bit
	// pattern — so a float const reaching an integer alias (or the reverse) would be compared as a
	// number it is not. A domain mismatch therefore falls through to the runtime guard.
	//
	// ⚠⚠ **THE LITERAL IS ASKED BEFORE `rangeIsFull`, AND THE OTHER ORDER WAS A SILENT WRONG ANSWER.** A
	// full range admits every 64-bit PATTERN, which is the whole of what a RUNTIME guard could test — so
	// eliding the guard is right. It is not the whole of what the COMPILE-TIME check tests: `int(0 to
	// u64.max)` still declares a lower bound of 0, and a written `-1` is below it. With the full-range arm
	// first this function returned before it could look at the constant at all, and `take(-1)` compiled
	// clean into such a parameter and printed 18446744073709551615. Reordered, the
	// signed-full `int(i64.min to i64.max)` is unaffected (every integer satisfies it, so the literal arm
	// answers in-range for it and always will) and only the unsigned-full range gains a verdict.
	function needsRuntimeGuard(value ValueId, alias RangedTypeAlias, line LineNumber, column ColumnNumber, filePath FilePath) returns bool
		let isFloat = aliasIsFloat(alias)

		let literals = self.floatConsts if isFloat else self.intConsts

		if literals.contains(value) 'literal'
			let v = literals.constantOf(value)
			let writtenNegative = valueIsMarked(self.writtenNegativeLiterals, value: value)

			if not literalInRange(v, low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: writtenNegative, writtenAboveSignedMax: valueIsMarked(self.unsignedMaxLiterals, value: value)) 'outOfRange'
				reportPositioned(self.project, code: ErrorCode.typeMismatch, message: literalOutOfRangeMessage(v, aliasName: aliasSpelledForReader(self.project, alias: alias, readerFilePath: filePath, memo: self.spellings), low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: writtenNegative, domain: alias.domain), line: line, column: column, filePath: filePath)
			end 'outOfRange'

			return false
		end 'literal'

		// ⭐⭐ **`int(0 to u64.max)` DOES NOT LAND HERE.** It spans every
		// 64-bit pattern as a SET, which is all `rangeIsFull` sees — but it is a
		// QUANTITY, and a quantity's door refuses a value that arrived from a SIGNED domain. What
		// tests nothing is `bits(64)` (every pattern IS one of its values), the signed-full range, and a
		// full-range float; `aliasAdmitsEveryValue` is the three of them and nothing else.
		if aliasAdmitsEveryValue(alias) 'admitsEveryValue'
			return false
		end 'admitsEveryValue'

		return true
	end 'needsRuntimeGuard'

	// Hands back the block the in-range path continues in: the guard's `__rc_ok` when one was emitted,
	// and the site's own head block when both bounds elided. `emitParamGuard` reads it, because where
	// the cascade ends is half of the record `InlineLeaves` needs to skip it.
	//
	// The guard's ops carry the checked site's span, so a line whose only code is a guard still has a
	// line row; the span is cleared after, so nothing this pass emits next inherits it.
	function emitGuardAt(site GuardSite, operand GuardedOperand, alias RangedTypeAlias, chain GuardChain, filePath FilePath, line LineNumber, column ColumnNumber) returns IrBlock
		let isFloat = aliasIsFloat(alias)
		let checks = boundChecks(alias.low, high: alias.high, isFloat: isFloat)

		if checks.isEmpty() 'noBoundNeeded'
			// Both bounds elide (a signed range whose only stored bound is a negative upper) — nothing to
			// guard, and nothing was split, so the chain end is where it was.
			return site.block
		end 'noBoundNeeded'

		self.module.spans.current = sourceSpanOf(self.project, filePath: filePath, line: line, column: column)
		let ok = self.emitCheckedGuard(site, operand: operand, checks: checks, message: self.rangeCheckMessage(filePath, line: line, alias: alias), chain: chain, isFloat: isFloat, checksBorrow: not isFloat and aliasIsUnsignedFullQuantity(alias))
		self.module.spans.current = NoSpanId

		return ok
	end 'emitGuardAt'

	function emitCheckedGuard(site GuardSite, operand GuardedOperand, checks RangeBoundCheckArray, message ByteArray, chain GuardChain, isFloat bool, checksBorrow bool) returns IrBlock
		// The split advances the chain inside itself, before `emitPanicBlock`, and that order is
		// load-bearing — see `extendGuardChain`.
		let ok = self.splitFor(site, chain: chain)

		// The dereference goes between the split and the cascade: after the split `site.block` holds
		// exactly the ops that stood before the site, so the load lands past the `param` ops and
		// immediately ahead of the cascade that reads it. It appends an op, never a block, so
		// `extendGuardChain`'s "the last block registered is the continuation" invariant holds.
		let compared = self.comparedValue(operand, head: site.block, isFloat: isFloat)
		let tested = self.borrowWitnessOf(compared, head: site.block) if checksBorrow else compared
		let panicBlock = self.emitPanicBlock(message)
		self.emitCascade(site.block, value: tested, checks: checks, panicId: panicBlock.id, okId: ok.id, isFloat: isFloat)
		return ok
	end 'emitCheckedGuard'

	// A full-unsigned difference is refused only on a real borrow (lhs < rhs unsigned). Bit 63 of
	// `(~lhs & rhs) | (~(lhs ^ rhs) & difference)` is that borrow, so the cascade's sign test reads it;
	// `TypeRules.unsignedSubtractionBorrows` folds the same identity and the two must agree.
	function borrowWitnessOf(difference ValueId, head IrBlock) returns ValueId
		let recorded = match self.borrowOperands 'column'
			unwritten gives sharedNoBorrowOperands
			entries(byDifference) gives byDifference
		end 'column'

		let operands = try recorded.get(difference) otherwise return difference
		let allOnes = self.mintDerived(difference)
		self.module.appendOp(head, op: StdOp.const(allOnes, value: UnsignedFullUpperPattern, valueType: StdType.i64))
		let notLhs = self.appendWordOp(head, lhs: operands.lhs, rhs: allOnes, opcode: StdBinOpcode.bitXor, source: difference)
		let borrowedByRhs = self.appendWordOp(head, lhs: notLhs, rhs: operands.rhs, opcode: StdBinOpcode.bitAnd, source: difference)
		let operandsDiffer = self.appendWordOp(head, lhs: operands.lhs, rhs: operands.rhs, opcode: StdBinOpcode.bitXor, source: difference)
		let operandsAgree = self.appendWordOp(head, lhs: operandsDiffer, rhs: allOnes, opcode: StdBinOpcode.bitXor, source: difference)
		let borrowedThrough = self.appendWordOp(head, lhs: operandsAgree, rhs: difference, opcode: StdBinOpcode.bitAnd, source: difference)
		return self.appendWordOp(head, lhs: borrowedByRhs, rhs: borrowedThrough, opcode: StdBinOpcode.bitOr, source: difference)
	end 'borrowWitnessOf'

	function appendWordOp(head IrBlock, lhs ValueId, rhs ValueId, opcode StdBinOpcode, source ValueId) returns ValueId
		let result = self.mintDerived(source)
		self.module.appendOp(head, op: StdOp.binOp(result, lhs: lhs, rhs: rhs, opcode: opcode, operandType: StdType.i64))
		return result
	end 'appendWordOp'

	// ⭐⭐ **THE VALUE THE CASCADE ACTUALLY COMPARES — see `GuardedOperand` for why a parameter can be a
	// cell.** The load's type is the CASCADE's operand type rather than the parameter's declared Std type,
	// and the two cannot disagree: a cell's value is one full machine word (at
	// `ParameterCellValueOffset`), and `emitCascade` materializes its bounds in the very same
	// `f64`/`i64` the domain of the alias picks — so the load, the bounds and the compare are one
	// width by construction.
	function comparedValue(operand GuardedOperand, head IrBlock, isFloat bool) returns ValueId
		return match operand 'o'
			asIs(value) gives value
			pointeeOf(cell) gives self.emitCellLoad(head, cell: cell, isFloat: isFloat)
		end 'o'
	end 'comparedValue'

	// Load what a by-reference parameter's cell holds, appended to `head`. The one place this pass reads
	// through a pointer, for `emitZeroConstOf`'s reason: a second spelling of the offset or the width would
	// be a second answer to "what does a cell hold". The offset is `ParameterCellValueOffset`, the
	// same named constant the parser's own cell load and store address through.
	function emitCellLoad(head IrBlock, cell ValueId, isFloat bool) returns ValueId
		let loaded = self.mintDerived(cell)
		self.module.appendOp(head, op: StdOp.loadIndirect(loaded, addrId: cell, offset: ParameterCellValueOffset, valueType: StdType.f64 if isFloat else StdType.i64))
		return loaded
	end 'emitCellLoad'

	// Move `siteBlockId`'s chain end onto the continuation `splitChainEnd` just made, so the next guard in
	// that source block lands after this one instead of before it.
	//
	// ⚠ **THIS MUST RUN BEFORE ANYTHING ELSE APPENDS A BLOCK.** The continuation's own blockRef is
	// recoverable only as "the last entry `addBlock` registered", and `emitPanicBlock` plus the cascade's
	// `__rc_chk` blocks append more the moment they run. So it is read here — and CHECKED against the
	// block the split actually returned, not assumed: a later reordering that slipped an append in
	// between would chain the NEXT guard onto the panic block, and no test would show that as anything
	// but wrong code at some unrelated site.
	//
	// ⚠ **THE BASE MOVES WITH THE TAIL, AND `splitAt` IS WHY.** The continuation is where the source
	// block's ops from `splitAt` on will stand, so an op that stood at position p of the chain-end block
	// now stands at `p - splitAt` of the new one. `guardChainBase` accumulates those shifts in the
	// ORIGINAL block's coordinates, which is the space a site's recorded position is written in — advance
	// one column without the other and the (k+1)-th guard lands at an offset measured against a block it
	// is no longer in. It is also where the pending tail STARTS, which is what `materializeChainTails`
	// reads it as.
	function extendGuardChain(siteBlockId BlockId, continuation IrBlock, splitAt ElementIndex)
		let okRef = try self.func.blockRefs.get(self.func.blockRefs.count() - 1) otherwise panic("extendGuardChain: `addBlock` made the continuation of '{String.from(self.func.name)}' but registered no blockRef for it")

		if self.module.getBlock(okRef).id != continuation.id 'notTheContinuation'
			panic("extendGuardChain: the last block registered in '{String.from(self.func.name)}' is not the continuation `splitBlock` returned — a block was appended between the split and this record, so the chain would advance onto the wrong block")
		end 'notTheContinuation'

		try self.guardChainTail.set(siteBlockId, value: okRef + 1) otherwise panic("extendGuardChain: guard site block id {siteBlockId} is outside the function's block-id space, which `guardSiteAt` already resolved it within")
		let base = try self.guardChainBase.get(siteBlockId) otherwise panic("extendGuardChain: guardChainBase has no entry for block id {siteBlockId}, which guardChainTail just answered for")
		try self.guardChainBase.set(siteBlockId, value: base + splitAt) otherwise panic("extendGuardChain: guardChainBase.set OOB at block {siteBlockId}, which was just read in range")
	end 'extendGuardChain'

	// Which split the site gets, and the chain advance that belongs to the chained one. Both leave `head`
	// un-terminated for the cascade to finish and return the continuation the guard's in-range edge goes
	// to.
	function splitFor(site GuardSite, chain GuardChain) returns IrBlock
		return match chain 'chain'
			blockChain(siteBlockId) gives self.splitChainEnd(site, sourceBlockId: siteBlockId)
			retChain gives splitBlockInPlace(self.module, func: self.func, head: site.block, position: site.position, label: RangeCheckOkLabel)
		end 'chain'
	end 'splitFor'

	// ⭐⭐ **CARVE THE NEXT SEGMENT OF `sourceBlockId`'S CHAIN OUT OF ITS PRE-SPLIT OP LIST — WITHOUT
	// EVER MOVING THE OPS PAST THE CUT.** The chain-end block ends up holding the source block's ops from
	// the previous split point up to this one; the continuation is left EMPTY, because the next guard on
	// this chain would only carve a prefix off it again, and `materializeChainTails` places what remains
	// once the loop is over.
	//
	// ⚠ **THIS IS THE DIFFERENCE BETWEEN LINEAR AND QUADRATIC BYTES, MEASURED.** Partitioning the
	// chain-end block's own list into two FRESH arrays moves everything after the
	// cut on every guard: k guards in a source block of B ops copy Σ(B − pₖ) ≈ k·B/2 op refs, and the
	// generated `scaleDivide` — 1,024 `as ScaleDivisor` casts in ONE straight-line block, doubling per
	// scale rung — reads `phase:insertRangeChecks` at ×2.83 ×2.82 ×3.73 ×4.11 ×4.32 bytes per DOUBLING
	// ladder rung, 13.0% of everything the compiler allocates at rung 5, with the ratio still climbing.
	// Allocations stay dead flat at ×2.00 throughout: a fixed number of arrays per site, each one bigger
	// — which is the whole signature of that bug and is why the byte column, not the allocation column,
	// is the one that finds it.
	//
	// The asymmetry that makes it work: an array can give up its BACK for free but not its FRONT, and a
	// chain cuts left to right. Carving forward out of one stable list makes every copy a segment nobody
	// copies again, so the whole chain moves B op refs in total.
	function splitChainEnd(site GuardSite, sourceBlockId BlockId) returns IrBlock
		let source = self.chainSourceOps(sourceBlockId, chainEnd: site.block)

		// The block is about to hand its list over to the segment carved below, so park the pre-split list
		// where the rest of the chain can still read it. Idempotent after the first split: `chainSourceOps`
		// hands back the row this wrote.
		try self.guardChainSource.set(sourceBlockId, value: source) otherwise panic("splitChainEnd: guardChainSource has no row for block id {sourceBlockId}, which `guardSiteAt` already resolved within the function's block-id space")
		let base = try self.guardChainBase.get(sourceBlockId) otherwise panic("splitChainEnd: guardChainBase has no entry for block id {sourceBlockId}, which `guardSiteAt` just read in range")

		// A mutable alias to the head block (a parameter binding is immutable; field writes need a `var`).
		// It is the SAME heap object — IrBlock is a reference type — so these writes land on the real block.
		var headBlock = site.block
		var segment = OpIndexArray.create()

		for i in base upto base + site.position 'carveSegment'
			let opIdx = try source.get(i) otherwise panic("splitChainEnd: block {sourceBlockId} of '{String.from(self.func.name)}' holds {source.count()} pre-split ops but its chain begins at {base} and the guard splits {site.position} ops into it")
			segment.push(opIdx)
		end 'carveSegment'

		headBlock.opRefs = segment

		let ok = splitBlockExit(self.module, func: self.func, head: headBlock, label: RangeCheckOkLabel)
		self.extendGuardChain(sourceBlockId, continuation: ok, splitAt: site.position)
		return ok
	end 'splitChainEnd'

	// The op list the site block held BEFORE any guard split it — the coordinate space a site's recorded
	// `stdOpPos` is written in, and the one list every segment of that block's chain is carved out of.
	//
	// ⚠ **"HAS A SPLIT MOVED PAST THIS BLOCK YET" IS DERIVED, NOT A FOURTH COLUMN.** `guardChainTail`
	// starts every block as its own chain end and a split is exactly what moves it off itself, so a chain
	// end that still IS the source block is a block whose `opRefs` is still its pre-split list. Recording
	// that list any earlier than the split would be wrong rather than merely eager: a site `guardSiteAt`
	// has already resolved can still turn out to owe no cascade at all (`emitGuardAt`'s both-bounds-elided
	// return), and a block nothing split must keep its own list.
	function chainSourceOps(sourceBlockId BlockId, chainEnd IrBlock) returns OpIndexArray
		if chainEnd.id == sourceBlockId 'stillItsOwnChainEnd'
			return chainEnd.opRefs
		end 'stillItsOwnChainEnd'

		return try self.guardChainSource.get(sourceBlockId) otherwise panic("chainSourceOps: guardChainSource has no row for block id {sourceBlockId} of '{String.from(self.func.name)}', whose chain end `guardChainTail` has already been moved off it")
	end 'chainSourceOps'

	// ⭐⭐ **PLACE THE OPS EVERY GUARDED BLOCK STILL OWES ITS LAST CONTINUATION.** A chained split leaves
	// the continuation empty (`splitChainEnd`), so the ops from the last split point to the end of the
	// source list are placed here — once, when no further guard can move them. Without this every guarded
	// block loses everything that followed its last guard.
	//
	// It walks the chain-tail column rather than a list of split blocks because that column already
	// records the answer: a row whose chain end is a block OTHER than itself was split. The column is as
	// wide as the block-id space was at the FIRST guard, which is the only part of it that can hold a
	// site's block (`guardSiteAt`) — `func.nextBlockId` has since grown by every block this pass appended.
	function materializeChainTails()
		if self.guardChainTail.isEmpty() 'noRuntimeGuardEmitted'
			return
		end 'noRuntimeGuardEmitted'

		for blockId in 0 upto self.guardChainTail.count() 'eachBlockId'
			let tailRef = try self.guardChainTail.get(blockId) otherwise panic("materializeChainTails: guardChainTail has no row for block id {blockId}, which is inside the column's own width")

			if tailRef == 0 'notInThisFunction'
				continue
			end 'notInThisFunction'

			var chainEnd = self.module.getBlock((tailRef - 1) as ElementIndex)

			if chainEnd.id == blockId 'neverSplit'
				continue
			end 'neverSplit'

			if not chainEnd.opRefs.isEmpty() 'alreadyHoldsOps'
				panic("materializeChainTails: the chain end of block {blockId} in '{String.from(self.func.name)}' already holds {chainEnd.opRefs.count()} op(s) — a continuation is minted empty and receives its ops only here, so something appended to one before its tail was placed")
			end 'alreadyHoldsOps'

			let base = try self.guardChainBase.get(blockId) otherwise panic("materializeChainTails: guardChainBase has no entry for block id {blockId}, which guardChainTail just answered for")
			let source = self.chainSourceOps(blockId, chainEnd: chainEnd)

			for i in base upto source.count() 'eachPendingOp'
				let opIdx = try source.get(i) otherwise panic("materializeChainTails: pre-split list of block {blockId} holds {source.count()} ops but its last split cut at {base}")
				chainEnd.opRefs.push(opIdx)
			end 'eachPendingOp'
		end 'eachBlockId'
	end 'materializeChainTails'

	// The panic block: `osPanic <message-label>`, then a dead return (the panic never returns, but
	// every block must terminate). The message is interned as a NUL-terminated `.rdata` cstr blob — the
	// same immortal-rdata path a String literal's blob uses, deduped by bytes — and `osPanic`
	// carries its label to the backend, which loads the address into the ABI's first-arg register and
	// calls `mrt_panic`.
	function emitPanicBlock(message ByteArray) returns IrBlock
		// Reached only when the range check refuses.
		var panicBlock = self.module.addBlock(self.func, label: b"__rc_panic", heat: BlockHeat.cold)
		let blobLabel = registerStringBlob(self.project.globalData, bytes: message)
		self.module.appendOp(panicBlock, op: StdOp.osPanic(blobLabel.toByteArray()))
		appendDeadReturn(self.module, func: self.func, block: panicBlock, ids: self.ids)
		return panicBlock
	end 'emitPanicBlock'

	// The unreachable terminator after `mrt_panic`. `mrt_panic` never returns, so none of these bits is
	// ever read — but the block still has to LEAVE the function the way the function's ABI says, because a
	// verifying backend reads the shape whether or not the path runs.
	//
	// ⛔⛔ **WRITING ONE REGISTER IN A FUNCTION WHOSE ABI RETURNS TWO MAKES wasm REFUSE THE MODULE.**
	// A function that uses the SECONDARY RETURN SLOT leaves through `errorReturn` — the primary value AND
	// the second word — which `LowerMaxonToStd.emitRetOrErrorReturn` calls *"the ONE place the ABI decides
	// ret-vs-errorReturn"*. It is not the only one: this pass appends its blocks AFTER lowering has run, so
	// it is a second decider. On x64 the missing second register is invisible (the path aborts); on wasm the
	// functype is multi-value and `wasm-tools component new` rejects the whole component with
	// `type mismatch: expected i64, found i32`.
	//
	// ⚠ **THE QUESTION IS `functionUsesSecondaryReturnSlot`'S, NOT `throwsClauseIsThrowing`'S**, and asking
	// the narrow one leaves the INTERFACE-RETURNING disjunct — whose second word is the witness half of the
	// fat pointer — writing one register under a two-register type. One predicate, so a third writer of
	// that slot cannot reach here without this door already knowing about it.
	//
	// ⭐ The zero's TYPE is `stdDefaultPrimaryReturnType`'s, which is also lowering's THROW-edge answer —
	// one rule for one fact, in the dialect both passes already read.
	// Emit the compare cascade, `head` first: each check is `const bound; cmp value <pred> bound;
	// condBranch (predicate TRUE) -> trueTarget, (FALSE) -> next`. The TRUE target is `panicId` for an
	// out-of-range check and `okId` for an in-range one (see `RangeCheckEdge`); the FALSE edge falls
	// through to the next check, or to `okId` for the last one. The `const` is left as a register
	// operand — `foldConstOperands`, which runs after this pass, folds it into the `cmp`'s immediate.
	function emitCascade(head IrBlock, value ValueId, checks RangeBoundCheckArray, panicId BlockId, okId BlockId, isFloat bool)
		// A float alias's bounds are f64 bit patterns and its guarded value lives in an XMM register, so
		// BOTH the materialized bound and the compare carry the f64 type. `foldConstOperands` refuses to
		// fold a float compare's operand into an immediate (there is no SSE immediate form), so the
		// `const` correctly stays a register operand here where an integer one would be folded away.
		let operandType = StdType.f64 if isFloat else StdType.i64
		var current = head
		let lastIndex = checks.count() - 1

		for i in 0 upto checks.count() 'eachCheck'
			let check = try checks.get(i) otherwise panic("emitCascade: checks.get OOB at {i}")
			let boundId = self.mintDerived(value)
			self.module.appendOp(current, op: StdOp.const(boundId, value: check.bound, valueType: operandType))
			let condId = self.mintDerived(value)
			let compareType = unsignedStdTypeOf(operandType) if check.unsigned else operandType
			self.module.appendOp(current, op: StdOp.cmp(condId, lhs: value, rhs: boundId, pred: check.pred, operandType: compareType))

			let trueTarget = okId if check.onTrue == RangeCheckEdge.inRange else panicId

			if i == lastIndex 'lastCheck'
				self.module.setTerminator(current, op: StdOp.condBranch(condId, thenBlockId: trueTarget, elseBlockId: okId))
			end 'lastCheck' else 'moreChecks'
				var next = self.module.addBlock(self.func, label: b"__rc_chk", heat: BlockHeat.normal)
				self.module.setTerminator(current, op: StdOp.condBranch(condId, thenBlockId: trueTarget, elseBlockId: next.id))
				current = next
			end 'moreChecks'
		end 'eachCheck'
	end 'emitCascade'

	// Where a guard goes: in the block the value was CHECKED in — so the guard runs on the path the site is
	// on and NOWHERE else, and a cast in an unselected ternary arm / if-branch does not fire it — AT the
	// position the value comes to rest at, so nothing between the site and the panic executes. An int->int
	// cast emits no Std op to anchor to, so both halves are the parser's to record (`site.block` is its
	// on-the-fly-SSA current block at the `as`, `site.maxonOpPos` the ordinal that block stood at), and the
	// checked value is available there (a parameter, a value from a dominating block, or one defined earlier
	// in this block — the site reads it, so it is already defined).
	//
	// ⚠ THE POSITION IS THE WHOLE POINT. A guard anchored at the END of its block runs after the whole
	// straight-line body — after every print, call, store and division the out-of-range value reached, so
	// the language's own check never fires first. No Maxon-tier op position survives `lowerMaxonToStd`'s
	// 1:N desugaring, so the lowering RECORDS one per site out of the `opRefs.count()` its own walk
	// already stands at (`RangeSiteWalk`), and this pass spends it into `GuardSite.position`.
	//
	// ⭐⭐ **"THE END OF THE BLOCK" MOVES AS SOON AS THE FIRST GUARD SPLITS IT, AND RESOLVING EVERY SITE
	// TO THE ORIGINAL HEAD IS TWO BUGS AT ONCE.** N sites in one source block all name that block's id.
	// Each split moves the head's terminator onto a fresh continuation and leaves the new cascade in the
	// head — so resolving the (k+1)-th site to the head again puts its cascade BEFORE the k-th's branch
	// and pushes that branch one block further down. Chained that way the guards RUN IN REVERSE SOURCE
	// ORDER (measured: two out-of-range casts on consecutive lines panicked on the SECOND), and — the
	// costlier half — all N `cmp` results are DEFINED in the head while each is READ by the terminator of
	// a different block k levels down. `recordFusableCompare` fuses a compare only when it is the last
	// flag-clobbering op of the branch's OWN block, so N-1 of them lose their fusion, materialize through
	// `setcc`, and sit in a register across the whole chain: N-1 compiler-introduced values live at one
	// point, which is what RULE 3 (RegisterPressureDiagnostic) forbids outright. At N=16 that overflowed
	// the 14-GPR file and the RULE 3 backstop panicked, on a program with nothing wrong with it.
	//
	// So the index is a CHAIN END, not a block identity: a guard moves its site block's entry to its own
	// continuation, the (k+1)-th cascade lands in the k-th's `__rc_ok`, and every `cmp` is
	// again the last op before the branch that reads it — fused, holding no register, invisible to the
	// allocator. Guards then also fire in source order, which is the order a reader expects the FIRST
	// out-of-range value to be reported in.
	//
	// ⭐ **AND THE CHAIN COMPOSES WITH THE POSITION THROUGH `guardChainBase`, WHICH IS THE OTHER HALF OF
	// THE SAME FACT.** The chain end says WHICH block the (k+1)-th guard splits; the base says where that
	// block BEGINS in the coordinates the site's position is written in. A site's position is an offset
	// into the block as the LOWERING left it, and every split shortens the front of that block by exactly
	// its own split point — so the position to split at is `stdOpPos - base`, and the base advances by the
	// split point each time. Tracking one without the other measures the (k+1)-th offset against a block
	// it is no longer in.
	//
	// ⚠ **THIS RESOLVES THROUGH AN INDEX, NOT `IrModule.getBlockByIdIn`, AND THE DIFFERENCE IS A GROWTH
	// CURVE.** `getBlockByIdIn` is a LINEAR SCAN of `func.blockRefs`; called once per guard site it made
	// this pass **O(sites × blocks)** — and worse than the plain product, because every guard this pass
	// emits APPENDS TWO BLOCKS to the very set the next site's scan walks (`__rc_ok`, `__rc_panic`), so the
	// k-th site scanned a set the previous k-1 had grown. `buildBlockIdIndex`/`blockById` are the cure that
	// already existed for exactly this shape one pass over: `pruneDeadBlockArgs` introduced them because
	// resolving an edge per call "would be O(edges × blocks), the shape the allocator's data-representation
	// contract exists to forbid", and `elimTrivialBlockArgs` shares them rather than keeping a second copy.
	// This is the third user of the same index over the same id space, not a fourth mechanism — and within
	// this pass BOTH site kinds read the one column (`retBlockOf` is the other), built once by
	// `ensureChainIndex`.
	//
	// The index is safe to hold across the splits and block appends that follow: it stores blockRef
	// INDICES, not `IrBlock` aliases (`blockById` re-fetches from `module.blocks` on every call, so no
	// alias goes stale), a split MUTATES its head block in place and never moves it, and every id a site
	// names was recorded by the parser and therefore predates the pass. Its ROWS are only ever the
	// parser's block ids — a continuation is written as a VALUE at its site block's row and never gets a
	// row of its own — so it stays exactly `func.nextBlockId` wide however many blocks the pass appends.
	function guardSiteAt(blockId BlockId, stdOpPos ElementIndex) returns GuardSite
		self.ensureChainIndex()

		let block = blockById(self.module, refByBlockId: self.guardChainTail, id: blockId, from: self.func.name)
		let base = try self.guardChainBase.get(blockId) otherwise panic("guardSiteAt: guardChainBase has no entry for block id {blockId}, which blockById just resolved within the function")

		if stdOpPos < base 'behindTheChain'
			panic("guardSiteAt: '{String.from(self.func.name)}' records a guard at position {stdOpPos} of block {blockId}, but that block's chain end already begins at {base} — sites are consumed in source order, so a position can never fall behind the last split")
		end 'behindTheChain'

		// ⚠ THE BOUND IS CHECKED IN THE SITE'S OWN COORDINATES — against the block's PRE-SPLIT op count,
		// not the chain-end block's current one. Those were the same number while a split moved the ops
		// past the cut onto the continuation; they are not, now that a continuation is minted empty and
		// filled only by `materializeChainTails` (see `guardChainSource`). Checked against the block as it
		// stands, every guard after the first in a block would read a count of zero and this would fire on
		// a program with nothing wrong with it.
		let sourceOps = self.chainSourceOps(blockId, chainEnd: block)

		if stdOpPos > sourceOps.count() 'pastTheBlock'
			panic("guardSiteAt: '{String.from(self.func.name)}' records a guard at position {stdOpPos} of block {blockId}, which held only {sourceOps.count()} ops before this pass split it — `splitChainEnd` would silently carve the whole block into the head and anchor the guard at the end")
		end 'pastTheBlock'

		return GuardSite.create(block, position: stdOpPos - base)
	end 'guardSiteAt'

	// ⭐⭐ **THE BLOCK HOLDING *THIS* SITE'S `ret` — ONE INDEX SERVES BOTH SITE KINDS, AND THE ANSWER IS
	// AN IDENTITY RATHER THAN AN ORDINAL.** A return site records its own block
	// (`RangeCheckReturnSite.block`), so the question is the same one `guardSiteAt` asks — "where is
	// block B's exit NOW?" — and it is answered out of the same `guardChainTail`: a block nothing split
	// is its own chain end, and a block an alias-named guard split has had its `ret` MOVED onto the
	// continuation its chain-end entry was moved onto in the same breath (`extendGuardChain`).
	//
	// ⚠ PAIRING BY ORDINAL IS WRONG HERE. Anything that walks `func.blockRefs` for the k-th live
	// `ret(value)` pairs a value returned from N places by BLOCK ORDER, and block order is not site
	// order: a `return` inside a `while` body sorts after the loop's exit block, and a block a guard
	// split gets an appended `__rc_ok` that sorts LAST however early its source is. Each such site then
	// raises its panic with the line of a DIFFERENT `return` than the one the value left through.
	//
	// The `ret` a site owns is not the k-th of anything: it is the one in the site's own block, and a
	// block has exactly one. Recording the block is what turns the pairing from an ordering assumption
	// into an identity — the same cure `RangeCheckSite.block` already is for the alias-named sites.
	//
	// ⚠ **THE GROWTH CURVE IS LINEAR IN SITES.** A scan for the owning `ret` would be
	// **O(sites × blocks)** and worse than that product, because every guard APPENDS `__rc_ok` +
	// `__rc_panic` (+ a `__rc_chk` per extra bound) to the very set the next site's scan walked: MEASURED
	// on a function of N guarded `return` sites (`tests/ladders/genretsites.sh`, N = 50/100/200/400) at
	// **×2.21 ×2.53 ×3.20 CPU per DOUBLING** — a RISING ratio — while allocations and bytes read a
	// dead-flat ×1.99 / ×2.03, because a scan allocates NOTHING and was therefore invisible to the memory
	// columns. This resolves in O(1) out of a column built once per function, and only for a function
	// that emits a guard at all.
	function retBlockOf(site RangeCheckReturnSite) returns RetBlockLookup
		self.ensureChainIndex()

		let block = blockById(self.module, refByBlockId: self.guardChainTail, id: site.block, from: self.func.name)

		if not block.hasTerminatorOp() 'noRetLeft'
			return RetBlockLookup.notFound
		end 'noRetLeft'

		let term = try self.module.ops.get(block.terminatorIndex()) otherwise panic("retBlockOf: terminatorIndex of block {block.id} in '{String.from(self.func.name)}' not in module.ops")

		if not retMatchesValue(term, block: block, target: site.value) 'notThisSitesRet'
			return RetBlockLookup.notFound
		end 'notThisSitesRet'

		return RetBlockLookup.found(block)
	end 'retBlockOf'

	// ⚠ **THE THREE CHAIN COLUMNS ARE ONE INDEX, SO THEY ARE BUILT IN ONE PLACE AND TESTED BY ONE
	// `isEmpty`** — see `guardChainTail`. Both site kinds ask for it (`guardSiteAt` for an alias-named
	// site's position, `retBlockOf` for a `return` site's `ret`), and whichever asks first pays for it;
	// a function with a `rangeChecks` entry but no runtime guard never does.
	//
	// ⚠ **LAZY, AND THAT IS LOAD-BEARING RATHER THAN THRIFT.** A `rangeChecks` entry is filed for a
	// function that merely passes a CONSTANT ARGUMENT to any declared callee, or constructs a generic
	// instance (`Parser.commitRangeChecks`) — so the overwhelming majority of entries reach this pass
	// with no RUNTIME site at all, and a call-argument site is `compileTimeOnly` and never asks. Building
	// this in `create` would hand every one of those functions three fresh `func.nextBlockId`-sized
	// arrays it never reads, turning a cost this pass does not currently pay into one it pays
	// program-wide — and allocations are the trend log's exact column, so it would read as a regression
	// on every future row.
	function ensureChainIndex()
		if not self.guardChainTail.isEmpty() 'alreadyBuilt'
			return
		end 'alreadyBuilt'

		self.guardChainTail = buildBlockIdIndex(self.module, func: self.func)
		self.guardChainBase = BlockOpPosArray.create()
		self.guardChainBase.growFilled(self.func.nextBlockId, value: 0)
		self.guardChainSource = PreSplitOpsByBlock.create()
		self.guardChainSource.growFilled(self.func.nextBlockId, value: OpIndexArray.create())
	end 'ensureChainIndex'

	// ---- the panic message ----

	// The runtime panic string, baked at compile time. THIS pass owns only the TEXT a range violation
	// says; the `panic at <file>:<line>: ` prefix and the trailing newline are `panicMessageLine`'s, so
	// this message and a user `panic("…")`'s cannot drift into two formats. `mrt_panic` prints the
	// result verbatim, then the `Stack trace:` block, then exits `PanicExitCode`.
	//
	// ⚠ **THE ALIAS IS QUOTED AS THE READING FILE SPELLS IT** — the same `aliasSpelledForReader` the
	// compile-time twin (`literalOutOfRangeMessage`'s caller) applies, so a range-contested program
	// cannot panic naming a typealias no file declares, and one alias reads the same whether it guards
	// an array ELEMENT or a plain PARAMETER.
	function rangeCheckMessage(filePath FilePath, line LineNumber, alias RangedTypeAlias) returns ByteArray
		return panicMessageLine(filePath, line: line, text: textAsItsReaderSpellsIt(self.project, path: filePath, text: "Range check failed: value outside typealias '{aliasSpelledForReader(self.project, alias: alias, readerFilePath: filePath, memo: self.spellings)}'"))
	end 'rangeCheckMessage'

	// Map each `const` result value id to its constant, and each integer `binOp` of two constants that
	// the parser marked in `unsignedMaxLiterals` to its fold — the literals whose out-of-range use is
	// the compile-time E3005 and whose in-range use needs no runtime code. Built once per function
	// over the pre-guard ops, and PARTITIONED BY THE CONST'S OWN TYPE (see the
	// `intConsts`/`floatConsts` fields): the payloads are numbers on one side and IEEE-754 bit
	// patterns on the other, and nothing downstream could tell them apart from the payload alone.
	function collectConsts()
		for opIdx in self.module.liveOpIndices(self.func) 'eachOp'
			let op = try self.module.ops.get(opIdx) otherwise panic("collectConsts: live op index {opIdx} not in module.ops")

			match op 'c'
				const(resultId, value, valueType) then self.recordConst(resultId, value: value, valueType: valueType)
				binOp(resultId, lhs, rhs, opcode, operandType) then self.recordUnsignedFold(resultId, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType)
				cmp or
				binOpImm or
				cmpImm or
				div or
				mod or
				condBranch or
				branch or
				ret or
				param or
				call or
				retVoid or
				globalAddr or
				loadIndirect or
				storeIndirect or
				osAllocPages or
				osWriteStdout or
				rdataAddr or
				tryCall or
				errorReturn or
				osExit or
				funcAddr or
				callIndirect or
				osPanic or
				osReadClock or
				osProcessSpawn or
				osProcessExitCode or
				osCloseHandle or
				osWaitHandle or
				osWaitChild or
				osFreePages or
				switch or
				witnessCall or
				witnessTryCall or
				osPipeCreate or
				osEventCreate or
				osThreadCreate or
				osLockInit or
				osLockEnter or
				osLockLeave or
				osReadOverlapped or
				osLastError or
				osProcessSpawnInherit or
				osCancelIo or
				osGetPid or
				osPipeCreateOutbound or
				osWriteFile or
				osReadWallClock or
				osFileOpenRead or
				osFileClose or
				osReadFile or
				osFileOpenWrite or
				osFileSize or
				osFileDelete or
				osFileRename or
				osFileFindFirst or
				osFileFindClose or
				osFileFindNext or
				osDirCreate or
				osDirRemove or
				osDirCurrentPath or
				osFileAttributes or
				osPanicValue or
				osCommandLine or
				osStdHandle or
				osExecutablePath or
				osProcessNamespace or
				osRandomFill or
				osWriteStderr or
				stackRecordAddr or
				osOpenNamedSegment or
				osMapNamedSegment or
				osTickCountMs or
				osHandleSetInherit or
				osPipePeek or
				osEnvRead or
				osProcessTerminate or
				osSocketStartup or
				osSocketResolve or
				osSocketFreeAddrInfo or
				osSocketCreate or
				osSocketConnect or
				osSocketSend or
				osSocketError or
				osSocketRecv or
				osSocketClose or
				osCpuCount or
				osThreadCpuTicks or
				osDecommitPages or
				memFill or
				osCommitPages or
				osReservePages or
				atomicCas or
				atomicRmw or
				currentThreadToken or
				tlsAlloc or
				tlsSetValue or
				tlsSlotLoad or
				osSetEvent or
				osEnterBackgroundPriority or
				osFileOpenWriteExecutable or
				osFileOpenCreateNew or
				osEnvBlock or
				osEnvBlockFree or
				loadAcquire or
				storeRelease or
				osHandleFileType or
				osProcessProbe or
				osProcessExitSignal or
				osCreateNamedSegment or
				osAdoptNamedSegment or
				osUnmapNamedSegment or
				osUnpublishNamedSegment or
				covPoint or
				osHostProcess or
				osNetpoll or
				osPathQuery or
				osSocketOverlapped or
				osSocketServe then break

				// A negated integer literal (`-5 as Positive`) survives lowering as `unaryOp neg` over a
				// `const`, not a folded `const`, so the E3005 literal check would miss it and emit a runtime
				// guard where the spec expects a compile error. The `const` operand is already recorded: it is
				// emitted before the `neg`, and ops are walked in order. A negated float literal needs nothing
				// here: the parser folds it into one literal carrying the sign-flipped bits
				// (`parseNegatedNumericLiteral`), and `neg` is the integer negate.
				unaryOp(resultId, operand, opcode, _) then recordConstNeg(self.intConsts, resultId: resultId, operand: operand, opcode: opcode)
			end 'c'
		end 'eachOp'
	end 'collectConsts'

	function recordUnsignedFold(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType)
		if stdTypeIsFloat(operandType) or not valueIsMarked(self.unsignedMaxLiterals, value: resultId) or not self.intConsts.contains(lhs) or not self.intConsts.contains(rhs) 'notAnUnsignedFold'
			return
		end 'notAnUnsignedFold'

		match evaluateIntBinOp(opcode, lhs: self.intConsts.constantOf(lhs), rhs: self.intConsts.constantOf(rhs)) 'fold'
			folded(value) then self.intConsts.upsert(resultId, value: value)
			notFoldable then break
		end 'fold'
	end 'recordUnsignedFold'

	function recordConst(resultId ValueId, value ParsedInt, valueType StdType)
		if stdTypeIsFloat(valueType) 'float'
			self.floatConsts.upsert(resultId, value: value)
			return
		end 'float'

		self.intConsts.upsert(resultId, value: value)
	end 'recordConst'
end 'RangeCheckEmitter'

// The return after an aborting op: never executed, present so the block leaves `func` with the arity its
// type declares. Shared with the inliner, which ends a copied aborting block the same way in the CALLER
// (`SiteSplicer.copyBodies`), so the two cannot disagree about how a dead return is made.
module function appendDeadReturn(module StdModule, func IrFunction, block IrBlock, ids ValueMinter)
	if functionUsesSecondaryReturnSlot(func.maxonReturnType, throws: func.throwsTypeName) 'aSecondReturnWord'
		let dead = appendZeroConst(module, block: block, valueType: stdDefaultPrimaryReturnType(func.returnType), ids: ids)
		let second = appendZeroConst(module, block: block, valueType: StdType.i64, ids: ids)
		module.setTerminator(block, op: StdOp.errorReturn(dead, errorFlagId: second))
		return
	end 'aSecondReturnWord'

	match func.returnType 'rt'
		void then module.setTerminator(block, op: StdOp.retVoid)
		value(inner) then module.setTerminator(block, op: StdOp.ret(appendZeroConst(module, block: block, valueType: inner, ids: ids)))
	end 'rt'
end 'appendDeadReturn'

// A zero `const` of an EXPLICIT type, appended to `block` — the one place a dead return mints one, so the
// throwing and non-throwing shapes cannot come to disagree about how a zero is made.
function appendZeroConst(module StdModule, block IrBlock, valueType StdType, ids ValueMinter) returns ValueId
	let zero = ids.mint()
	module.appendOp(block, op: StdOp.const(zero, value: 0, valueType: valueType))
	return zero
end 'appendZeroConst'

// The label this pass's continuations carry. `InlineManagedPrimitives` passes its own — the two passes
// share the splitter below and nothing else, and rendered Target IR that named every continuation
// `__rc_ok` would say a range check produced blocks a range check knows nothing about.
let RangeCheckOkLabel = b"__rc_ok"

// ⭐⭐ **THE BLOCK SPLIT, SHARED — AND SHARED BECAUSE THERE IS EXACTLY ONE RULE TO GET RIGHT.** Split
// `head` at `position`: ops before it stay in `head`, ops from it on move to the continuation — and the
// continuation takes the head block's whole EXIT with them, the terminator, the conditional branch AND
// the outgoing edge arguments, leaving the head un-terminated for the caller to finish. Miss any one of
// those three and the result is a block with two exits or a successor whose phis lose their incoming
// values, neither of which any gate reads back. `InsertRangeChecks` needed it first and
// `InlineManagedPrimitives` needs the identical thing, so it is a free function over `(module,
// func)` rather than a method: a second copy would be that one rule written twice, in two passes that
// split for different reasons and would learn about a change to it separately.
//
// The LABEL is the caller's, because a continuation belongs to the pass that minted it and the label
// reaches the rendered Target IR.
//
// ⚠ **WHY `InsertRangeChecks`' RETURN SITES DO NOT USE `splitChainEnd`, AND WHY NEITHER SPLIT CAN BE THE
// OTHER.** A return site has no chain to extend (see `GuardChain`), and the block it splits can be a
// continuation an alias site minted — `retBlockOf` resolves its recorded block to that block's current
// chain END — so it is a block no site's coordinates describe and no pre-split list covers. It is also
// split at its very END (`guardReturns` passes `opRefs.count()`), which is why splitting in place costs
// nothing there: the loop moves no op and the truncate drops none. `splitChainEnd` cannot work this way
// because it repeats on the SAME source block, and that is exactly where moving the ops past the cut
// becomes Θ(guards × block).
//
// ⛔⛔ **`InlineManagedPrimitives` TAKES THIS HALF, AND THE OBVIOUS ARGUMENT FOR WHY THAT IS SAFE DOES
// NOT FOLLOW.** That pass splits at ONE position per call site and never repeats on a block it has
// already split — its continuation is what it scans next — but the quadratic does NOT follow from that
// premise: the continuation IS the rest of that block, so K carve sites in a block of B ops copy the
// tail K times,
// Σ(B − pₖ) ≈ K·B/2 — the very shape `splitChainEnd` above exists to avoid, arrived at by a different
// route. **A rationale that does not hold is worse than none: it is what a sixth primitive's author
// would read as a licence.**
//
// ✅ **THE LINEARITY IS MEASURED** — `tests/ladders/genmanagedsites.sh onefunc` puts the sites in ONE
// straight-line block and reads ×1.99 ×1.99 ×2.00 allocations and ×2.07 ×2.10 ×2.06 bytes at
// n = 32/64/128/256, where Σ(B − pₖ) would read ×4; its `spread` control holds the same site count one
// per function and sits on the same curve. **What follows is the READING of the emission sites that
// explains that, and it is a reading.** The three THROWING entries arrive as a `tryCall` whose error
// flag is tested immediately, so the call is the LAST op in its block and this function copies ZERO ops;
// the one
// non-throwing carve (`__managed_get_unchecked`) is emitted once per `for`-in header, so its block holds
// exactly one and its tail is copied exactly once; and `__managed_count` is rewritten in place and
// carves nothing. ⇒ The product term is MEASURED-LINEAR-IN-PRACTICE, not absent. A primitive that
// carves MID-block, or a pass that merges a throwing call's blocks, reinstates it with nothing in the
// way — re-run that ladder then, and take `splitChainEnd` if it bends.
export function splitBlockInPlace(module StdModule, func IrFunction, head IrBlock, position ElementIndex, label ByteArray) returns IrBlock
	var headBlock = head
	var tailOps = OpIndexArray.create()

	for i in position upto headBlock.opRefs.count() 'moveTail'
		let opIdx = try headBlock.opRefs.get(i) otherwise panic("splitBlockInPlace: opRefs.get OOB at {i}")
		tailOps.push(opIdx)
	end 'moveTail'

	headBlock.opRefs.truncate(position)

	var ok = splitBlockExit(module, func: func, head: headBlock, label: label)
	ok.opRefs = tailOps
	return ok
end 'splitBlockInPlace'

// The half of a split that is the same whichever way the ops are placed: mint the continuation and move
// `head`'s EXIT onto it — the terminator, the conditional branch and the outgoing edge arguments —
// leaving `head` un-terminated for the caller to finish.
//
// ⚠ NOT exported, and that is a fact the SELF-COMPILE enforces rather than a preference: the compiler's own
// `checkUnusedExports` reports **E3092** on an `export` no other file names, and this half has exactly one
// caller outside its own two — there isn't one. `splitBlockInPlace` above is the shared entry;
// `splitChainEnd` reaches this directly because it places the ops itself.
function splitBlockExit(module StdModule, func IrFunction, head IrBlock, label ByteArray) returns IrBlock
	var headBlock = head

	// The tail runs exactly when the head does, and it is the same text.
	var ok = module.addBlock(func, label: label, heat: headBlock.heat, inlineSite: headBlock.inlineSite, role: headBlock.role)

	ok.terminator = headBlock.terminator
	ok.condBranch = headBlock.condBranch
	ok.branchEdges = headBlock.branchEdges

	headBlock.terminator = Terminator.unset
	headBlock.condBranch = CondBranch.none
	headBlock.branchEdges = BranchEdgeArray.create()
	return ok
end 'splitBlockExit'

// ⭐ **THE `ValueId` A NARROWED PARAMETER'S GUARD CHECKS — its DECLARED POSITION, and the two readers of
// that fact must be one function.** `parseFunction` reserves ids `0..paramCount-1` for parameters, user
// parameters first, and `rangedParamSites` walks that same declared list (see its header), so a site's
// `index` IS its value. `guardRangedParam` spends it to emit the guard and `entryGuardAlreadyCovers`
// spends it to decide a `return` is already behind one — and an elision that computed the id differently
// from the guard it claims to stand behind would elide against a guard that is not there.
function rangedParamValue(site RangeCheckParamSite) returns ValueId
	return valueIdAtParamPosition(site.index)
end 'rangedParamValue'

// The i64 the sign check compares against: a value `< 0` (signed) has bit 63 set, which for the
// unsigned-max upper shape proves it is a huge unsigned the range ADMITS. Named so the sign
// boundary is not a bare `0` sitting beside the range's own bounds.
let SignBoundary = 0 as ParsedInt

// The bound checks a `[low, high]` range needs, in cascade order. See TypeRules'
// `rangeNeedsLowerCheck` / `rangeNeedsUpperCheck`.
//
// ⚠ **IT IS EMPTY ONLY FOR A RANGE UNBOUNDED ON BOTH SIDES, WHICH IS `rangeIsFull`'s CASE AND IS ELIDED
// BEFORE THIS.** A WHOLLY NEGATIVE range's upper is a real bound and is not elided — see
// `rangeNeedsUpperCheck`'s header for the two uncatchable `#DE`s eliding it reaches.
function boundChecks(low ParsedInt, high ParsedInt, isFloat bool) returns RangeBoundCheckArray
	var checks = RangeBoundCheckArray.create()

	// ⭐ THE UNSIGNED-MAX UPPER SHAPE — `int(N to u64.max)` over a non-negative low bound. Signed
	// compares cannot express its upper (it rides as `-1`), so out-of-range is `value >= 0 AND
	// value < low`: a negative (bit-63-set) value is a huge unsigned IN range, a non-negative value
	// below `low` is out. The cascade is `value < 0 → in range` then `value < low → panic`, which the
	// backend fuses to `cmp value,0; jl ok; cmp value,low; jl panic; jmp ok`.
	//
	// ⚠⚠ **GATED ON A POSITIVE LOW, AND WITHOUT THAT GATE THE CASCADE IS UNREACHABLE CODE.** The
	// full-unsigned `int(0 to u64.max)` reaches `boundChecks` as a guarded QUANTITY, and its
	// `low` IS the sign boundary — so this arm would emit `value < 0 → in range` followed by
	// `value < 0 → panic`, whose second compare is only reached when the first was false and can
	// therefore never fire. Falling through to the ordinary path gives it the one check it wants:
	// `rangeNeedsLowerCheck` is true (`0 > i64.min`) and `rangeNeedsUpperCheck` is false (the unsigned
	// upper is unbounded), which is exactly `value < 0 → panic`. It is reached only for a value whose
	// source may be negative, and a recorded unsigned difference is tested through `borrowWitnessOf`.
	//
	// ⚠ A FLOAT IS NEVER ELIGIBLE. The shape reinterprets a signed bound as an unsigned one; IEEE-754
	// ordering is sign-and-magnitude and matches neither, so a float bound whose pattern happens to
	// equal -1 (which is a NaN, not `u64.max`) must take the ordinary two-bound path.
	if not isFloat and low > SignBoundary and high == UnsignedFullUpperPattern 'unsignedMaxUpper'
		checks.push(RangeBoundCheck.createInRange(StdCmpPred.lt, bound: SignBoundary))
		checks.push(RangeBoundCheck.create(StdCmpPred.lt, bound: low))
		return checks
	end 'unsignedMaxUpper'

	if not isFloat and rangeIsUnsignedTopped(low, high: high) and high != UnsignedFullUpperPattern 'unsignedCapped'
		if low > SignBoundary 'aFloorAboveZero'
			checks.push(RangeBoundCheck.createUnsigned(StdCmpPred.lt, bound: low))
		end 'aFloorAboveZero'

		checks.push(RangeBoundCheck.createUnsigned(StdCmpPred.gt, bound: high))
		return checks
	end 'unsignedCapped'

	// ⚠ A NaN PASSES a float guard, deliberately rather than by oversight. `lt`/`gt` lower to the
	// NaN-correct SWAPPED `ucomisd`+`ja` form, which answers FALSE for an unordered compare — so neither
	// bound fires and the value is admitted. Rejecting a NaN would need a check whose FALSE edge is the
	// panic (`value >= low` failing on unordered), which the cascade deliberately does not have.
	if rangeNeedsLowerCheck(low, isFloat: isFloat) 'lower'
		checks.push(RangeBoundCheck.create(StdCmpPred.lt, bound: low))
	end 'lower'

	if rangeNeedsUpperCheck(low, high: high, isFloat: isFloat) 'upper'
		checks.push(RangeBoundCheck.create(StdCmpPred.gt, bound: high))
	end 'upper'

	return checks
end 'boundChecks'

// Record a negated-constant result: `neg` of a recorded constant `operand` is `-operand`. Any other
// unary opcode is not an integer constant this check reads, so nothing is recorded.
function recordConstNeg(constMap ConstValueMap, resultId ValueId, operand ValueId, opcode StdUnaryOpcode)
	if opcode != StdUnaryOpcode.neg 'notNeg'
		return
	end 'notNeg'

	if not constMap.contains(operand) 'operandNotConst'
		return
	end 'operandNotConst'

	constMap.upsert(resultId, value: -constMap.constantOf(operand))
end 'recordConstNeg'

// Is `term` the exit of exactly `target` — its `ret`, or the `branch` carrying it into the
// function's shared exit chain? Asked ONCE PER RETURN SITE, of the one block that site's `return`
// put its terminator in — so a `false` says the site's own exit is gone (or carries a value the
// hand-off promoted out from under the site), which is the whole of `RetBlockLookup.notFound`.
//
// It answers a `bool` rather than a union: a payload-carrying union case is a heap box, and this is
// asked in a loop over every ret-bearing block. One exhaustive `StdOp` match, so a new variant is a
// compile error here rather than a `ret` this silently stops recognizing.
function retMatchesValue(term StdOp, block IrBlock, target ValueId) returns bool
	return match term 'term'
		const or
		binOp or
		unaryOp or
		cmp or
		binOpImm or
		cmpImm or
		div or
		mod or
		condBranch or
		param or
		call or
		retVoid or
		globalAddr or
		loadIndirect or
		storeIndirect or
		osAllocPages or
		osWriteStdout or
		rdataAddr or
		tryCall or
		osExit or
		funcAddr or
		callIndirect or
		osPanic or
		osReadClock or
		osProcessSpawn or
		osProcessExitCode or
		osCloseHandle or
		osWaitHandle or
		osWaitChild or
		osFreePages or
		switch or
		witnessCall or
		witnessTryCall or
		osPipeCreate or
		osEventCreate or
		osThreadCreate or
		osLockInit or
		osLockEnter or
		osLockLeave or
		osReadOverlapped or
		osLastError or
		osProcessSpawnInherit or
		osCancelIo or
		osGetPid or
		osPipeCreateOutbound or
		osWriteFile or
		osReadWallClock or
		osFileOpenRead or
		osFileClose or
		osReadFile or
		osFileOpenWrite or
		osFileSize or
		osFileDelete or
		osFileRename or
		osFileFindFirst or
		osFileFindClose or
		osFileFindNext or
		osDirCreate or
		osDirRemove or
		osDirCurrentPath or
		osFileAttributes or
		osPanicValue or
		osCommandLine or
		osStdHandle or
		osExecutablePath or
		osProcessNamespace or
		osRandomFill or
		osWriteStderr or
		stackRecordAddr or
		osOpenNamedSegment or
		osMapNamedSegment or
		osTickCountMs or
		osHandleSetInherit or
		osPipePeek or
		osEnvRead or
		osProcessTerminate or
		osSocketStartup or
		osSocketResolve or
		osSocketFreeAddrInfo or
		osSocketCreate or
		osSocketConnect or
		osSocketSend or
		osSocketError or
		osSocketRecv or
		osSocketClose or
		osCpuCount or
		osThreadCpuTicks or
		osDecommitPages or
		memFill or
		osCommitPages or
		osReservePages or
		atomicCas or
		atomicRmw or
		currentThreadToken or
		tlsAlloc or
		tlsSetValue or
		tlsSlotLoad or
		osSetEvent or
		osEnterBackgroundPriority or
		osFileOpenWriteExecutable or
		osFileOpenCreateNew or
		osEnvBlock or
		osEnvBlockFree or
		loadAcquire or
		storeRelease or
		osHandleFileType or
		osProcessProbe or
		osProcessExitSignal or
		osCreateNamedSegment or
		osAdoptNamedSegment or
		osUnmapNamedSegment or
		osUnpublishNamedSegment or
		covPoint or
		osHostProcess or
		osNetpoll or
		osPathQuery or
		osSocketOverlapped or
		osSocketServe gives false
		branch gives block.carriesOnAnEdge(target)
		ret(retValId) gives retValId == target

		// ⚠ A throwing function leaves through `errorReturn`, not `ret`
		// (`LowerMaxonToStd.emitRetOrErrorReturn` picks the terminator off the `throws` clause). Read
		// as "not a `ret`", its site gets `notFound` from `retBlockOf` and is dropped silently, leaving
		// the ranged return unguarded. The primary value is what a return site names — no range-check
		// site is recorded against the error flag — so the comparison is `retValId`'s alone.
		// `emitDeadReturn` emits the matching `errorReturn` shape for the panic block it splits in
		// front of, so the guard terminates a throwing function correctly on both edges.
		errorReturn(retValId, _) gives retValId == target
	end 'term'
end 'retMatchesValue'

// The literal-const map this pass reads is `ConstValueMap` (FoldConstOperands) — each `const` result id
// to the literal it materializes, so a cast/return of a literal is a compile-time decision (E3005 or
// nothing) rather than a runtime guard. ONE exported container, shared by both Std passes rather than
// copied privately here. Only the POPULATE walk stays this pass's
// own — `collectConsts`, which keeps ONE MAP PER DOMAIN (a float payload is a bit pattern) and
// additionally folds a `neg` of a `const` (`recordConstNeg`) that FoldConstOperands has no reason to.

// A `rangeChecks` entry and a `funcSignatures` entry are written by the SAME `parseFunction`, one
// statement apart and under the same name, so a callee present in one and absent from the other is
// a broken invariant rather than a program the user could write.
function calleeParamSlot(project Project, callee ByteArray, argIndex ParamCount, label ByteArray) returns ParamCount
	let signature = try project.funcSignatures.get(callee) otherwise panic("calleeParamSlot: '{String.from(callee)}' has range-check data but no FuncSignature — parseFunction records both, keyed by the same name")
	return try argSlotPosition(signature.paramNames, argIndex: argIndex, label: label) otherwise panic("calleeParamSlot: argument {argIndex} of a call to '{String.from(callee)}' fills no parameter — SemanticCheck.validateCall slotted every call that reaches lowering against this signature, and lowering refuses one it could not slot")
end 'calleeParamSlot'

type WaivableParam
	export let index as ParamCount
	export let alias as RangedTypeAlias
	export var waived as bool

	static function create(index ParamCount, alias RangedTypeAlias) returns WaivableParam
		return Self{index: index, alias: alias, waived: true}
	end 'create'
end 'WaivableParam'

typealias WaivableParamArray = Array with WaivableParam
typealias WaivableParamsByCallee = Map with (ByteArray, WaivableParamArray)
typealias CallTargetMap = Map with (ValueId, ByteArray)
typealias CallTargetsByFunction = Map with (ElementIndex, CallTargetMap)
typealias RecordedCallArguments = Map with (ValueId, RangeCheckSiteArray)

union WaivableParamLookup
	none
	found(param WaivableParam)
end 'WaivableParamLookup'

// A full-unsigned parameter's entry guard is waived only when every path reaching the callee checks
// the argument, because that call-site guard is then the one check. A direct call checks by
// recording its argument site; an indirect call, async spawn, witness dispatch or service send
// checks when the parser marked it (`checkedCallMarksOf`), and `project.uncheckedCallPaths` answers
// whether an unmarked one may reach a callee taken as a value, referenced from data or forwarded by
// a service loop. It fails closed: a direct call that recorded no site keeps the entry guard.
type EntryGuardWaivers
	var candidates as WaivableParamsByCallee
	var callTargets as CallTargetsByFunction

	static function derive(project Project, module StdModule) returns EntryGuardWaivers
		var waivers = Self{candidates: WaivableParamsByCallee.create(), callTargets: CallTargetsByFunction.create()}

		for func in module.functions 'eachFunc'
			waivers.collectCandidates(project, func: func)
		end 'eachFunc'

		if waivers.candidates.count() == 0 'nothingToWaive'
			return waivers
		end 'nothingToWaive'

		for reloc in project.globalData.pendingRdataRelocs 'eachDataReference'
			waivers.denyIfAnUncheckedPathReaches(project, callee: reloc.funcName)
		end 'eachDataReference'

		for target in project.functionValueTargets 'eachFunctionValue'
			waivers.denyIfAnUncheckedPathReaches(project, callee: target)
		end 'eachFunctionValue'

		waivers.denyCallsThatDidNotRecord(project, module: module)
		return waivers
	end 'derive'

	function collectCandidates(project Project, func IrFunction)
		if project.libraryFacts.bodyIsSwept(func.name) 'notInTheProgram'
			return
		end 'notInTheProgram'

		let checks = try project.rangeChecks.get(func.name) otherwise return

		for paramSite in checks.paramSites 'eachRangedParam'
			self.addCandidateIfUnsignedFull(func.name, param: WaivableParam.create(paramSite.index, alias: paramSite.alias))
		end 'eachRangedParam'
	end 'collectCandidates'

	function addCandidateIfUnsignedFull(callee ByteArray, param WaivableParam)
		if not aliasIsUnsignedFullQuantity(param.alias) 'hasAnotherFloor'
			return
		end 'hasAnotherFloor'

		var params = try self.candidates.get(callee) otherwise WaivableParamArray.create()
		params.push(param)
		self.candidates.upsert(callee, value: params)
	end 'addCandidateIfUnsignedFull'

	function denyIfAnUncheckedPathReaches(project Project, callee ByteArray)
		if project.uncheckedCallPaths.mayReach(callee) 'anUncheckedPathReachesIt'
			self.denyAll(callee)
		end 'anUncheckedPathReachesIt'
	end 'denyIfAnUncheckedPathReaches'

	function denyAll(callee ByteArray)
		let params = try self.candidates.get(callee) otherwise return

		for i in 0 upto params.count() 'eachParam'
			denyParamAt(params, at: i)
		end 'eachParam'
	end 'denyAll'

	function denyCallsThatDidNotRecord(project Project, module StdModule)
		var byName = FuncIndexByName.create()

		for (position, func) in module.functions.withIterator() 'eachFunc'
			byName.upsert(func.name, value: position.index())
		end 'eachFunc'

		var reference = StdFunctionReference.create()
		var call = StdCallOperands.create()

		for (position, func) in module.functions.withIterator() 'eachCaller'
			if project.libraryFacts.bodyIsSwept(func.name) 'notInTheProgram'
				continue
			end 'notInTheProgram'

			var recorded = RecordedCallArguments.create()
			let checkedMarks = checkedCallMarksOf(project, name: func.name)

			if let checks = try project.rangeChecks.get(func.name) 'recordsSites'
				for site in checks.sites 'eachSite'
					indexCallArgumentSite(recorded, site: site)
				end 'eachSite'
			end 'recordsSites'

			for opIdx in module.liveOpIndices(func) 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("EntryGuardWaivers: live op index {opIdx} not in module.ops")
				stdFunctionReferenceOf(op, byName: byName, into: reference)

				if reference.kind == StdFunctionReferenceKind.none 'namesNoFunction'
					continue
				end 'namesNoFunction'

				let callee = module.getFunc(reference.funcIndex).name

				if not self.candidates.contains(callee) 'noWaivableParam'
					continue
				end 'noWaivableParam'

				if functionIsAServiceLoop(func.name) and project.uncheckedCallPaths.namesAServiceHandler(callee) 'theLoopForwardsCheckedMessages'
					self.denyIfAnUncheckedPathReaches(project, callee: callee)
					continue
				end 'theLoopForwardsCheckedMessages'

				classifyCallOperands(op, call: call)

				if not call.namesACallee() 'takenAsAValue'
					self.denyIfAnUncheckedPathReaches(project, callee: callee)

					continue
				end 'takenAsAValue'

				self.recordCallTarget(position.index(), callResult: call.resultId, callee: callee)

				if valueIsMarked(checkedMarks, value: call.resultId) 'anIndirectCallTheParserChecked'
					continue
				end 'anIndirectCallTheParserChecked'

				self.denyParamsTheCallDidNotRecord(project, callee: callee, sites: try recorded.get(call.resultId) otherwise sharedNoCallArgumentSites)
			end 'eachOp'
		end 'eachCaller'
	end 'denyCallsThatDidNotRecord'

	function recordCallTarget(caller ElementIndex, callResult ValueId, callee ByteArray)
		var targets = try self.callTargets.get(caller) otherwise CallTargetMap.create()
		targets.upsert(callResult, value: callee)
		self.callTargets.upsert(caller, value: targets)
	end 'recordCallTarget'

	function denyParamsTheCallDidNotRecord(project Project, callee ByteArray, sites RangeCheckSiteArray)
		let params = try self.candidates.get(callee) otherwise panic("EntryGuardWaivers.denyParamsTheCallDidNotRecord: '{String.from(callee)}' was just found among the candidates")

		for i in 0 upto params.count() 'eachParam'
			let param = try params.get(i) otherwise panic("EntryGuardWaivers.denyParamsTheCallDidNotRecord: params.get OOB at {i}")

			if not callRecordedSlot(project, callee: callee, sites: sites, slot: param.index) 'unrecorded'
				denyParamAt(params, at: i)
			end 'unrecorded'
		end 'eachParam'
	end 'denyParamsTheCallDidNotRecord'

	function isWaived(callee ByteArray, index ParamCount) returns bool
		return match self.waivableParamAt(callee, index: index) 'param'
			none gives false
			found(param) gives param.waived
		end 'param'
	end 'isWaived'

	function waivedParamOfCall(caller ElementIndex, callResult ValueId, argIndex ParamCount, label ByteArray, project Project) returns WaivableParamLookup
		let targets = try self.callTargets.get(caller) otherwise return WaivableParamLookup.none
		let callee = try targets.get(callResult) otherwise return WaivableParamLookup.none
		let lookup = self.waivableParamAt(callee, index: calleeParamSlot(project, callee: callee, argIndex: argIndex, label: label))

		return match lookup 'param'
			none gives lookup
			found(param) gives lookup if param.waived else WaivableParamLookup.none
		end 'param'
	end 'waivedParamOfCall'

	function waivableParamAt(callee ByteArray, index ParamCount) returns WaivableParamLookup
		let params = try self.candidates.get(callee) otherwise return WaivableParamLookup.none

		for param in params 'eachParam'
			if param.index == index 'thisOne'
				return WaivableParamLookup.found(param)
			end 'thisOne'
		end 'eachParam'

		return WaivableParamLookup.none
	end 'waivableParamAt'
end 'EntryGuardWaivers'

let sharedNoCallArgumentSites = RangeCheckSiteArray.create()

function indexCallArgumentSite(recorded RecordedCallArguments, site RangeCheckSite)
	match site.target 'target'
		alias then return
		callArgument(callResult, _, _, _) then appendCallArgumentSite(recorded, callResult: callResult, site: site)
	end 'target'
end 'indexCallArgumentSite'

function appendCallArgumentSite(recorded RecordedCallArguments, callResult ValueId, site RangeCheckSite)
	var sites = try recorded.get(callResult) otherwise RangeCheckSiteArray.create()
	sites.push(site)
	recorded.upsert(callResult, value: sites)
end 'appendCallArgumentSite'

function callRecordedSlot(project Project, callee ByteArray, sites RangeCheckSiteArray, slot ParamCount) returns bool
	for site in sites 'eachSite'
		if siteRecordsSlot(project, callee: callee, site: site, slot: slot) 'recorded'
			return true
		end 'recorded'
	end 'eachSite'

	return false
end 'callRecordedSlot'

function siteRecordsSlot(project Project, callee ByteArray, site RangeCheckSite, slot ParamCount) returns bool
	return match site.target 'target'
		alias gives false
		callArgument(_, argIndex, label, _) gives calleeParamSlot(project, callee: callee, argIndex: argIndex, label: label) == slot
	end 'target'
end 'siteRecordsSlot'

function denyParamAt(params WaivableParamArray, at ElementIndex)
	var denied = try params.get(at) otherwise panic("denyParamAt: params.get OOB at {at}")
	denied.waived = false
end 'denyParamAt'

function functionIsAServiceLoop(name ByteArray) returns bool
	return match splitQualifiedName(name) 'split'
		notQualified gives false
		parts(_, member) gives member.equals(ServiceLoopMemberName)
	end 'split'
end 'functionIsAServiceLoop'

let sharedNoBorrowOperands = BorrowOperandsMap.create()
