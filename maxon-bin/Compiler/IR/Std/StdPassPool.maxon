// StdPassPool — THE PER-FUNCTION Std PASSES ON A POOL OF WORKER SERVICES, one per processor.
//
// ⚠ A run under `MAXON_MAX_PROCS=1` is THIS pool with one processor in it, not a serial fallback — which
// is what makes the pinned and the default lane the same code path and their outputs comparable at all.
//
// ⭐⭐ **WHY THESE PASSES.** The contiguous run from `pruneDeadBlockArgs` to the block-arg cleanup after
// `refineVersionedRanges` — every pass `classifyPass` answers `perFunction` for — is intra-function by
// construction: each reads one function's CFG, values and ops and nothing about another's. It is also
// FUNCTION-MAJOR here where the pipeline is pass-major: a worker takes one function through every step of
// the schedule before the next, so a function crosses to a worker ONCE and comes home ONCE, rather than
// once per pass.
//
// ⭐⭐ **WHAT MAKES IT SAFE IS THE UNIT, NOT LOCKING — there is none.** A message MOVES, so a worker
// is handed a `StdUnit` nobody else can reach and hands back the same unit with its `StdUnitAnswer`
// filed in it. `StdUnit`'s header owns that argument, and `BackendPool`'s owns the pool's.
//
// ⭐⭐ **AND THE OUTPUT DOES NOT DEPEND ON THE POOL.** Splicing is order-independent — a result writes
// this function's own block and op slots and the TAIL of the two module arrays, and an index into either
// reaches no emitted byte (`StdUnit`'s header) — and everything that is NOT order-independent is done in
// FUNCTION-INDEX ORDER on this thread after the drain: the derived-origin rows are folded. Each
// pass's banner, headline and summary are printed there too, once per step, the summary from the
// tallies summed over every worker.
//
// ⚠ **WHAT A WORKER STRUCTURALLY CANNOT DO** shaped every seam here, and each is a rule with teeth. It
// holds no `Project`, which rules out every
// `Project` table (`DerivedOrigins` buffers its rows, the target facts come in as two enums and the cost
// tables as a `PoolPhaseCosts` the driver folds) and the trace-span stack (`PhaseProbe.beginCounters`
// opens none). It may not await, and it never sends.
//
// ⛔ **THE MESSAGE'S ERROR SET IS EMPTY, AND THAT IS A PREMISE OF THE PIPELINE'S ERROR GATE.** None of
// the fanned-out passes raises a diagnostic; `specs/pass-fan-out-order.md` pins the nearest pass that
// does, `insertRangeChecks`, which stays serial. A diagnostic added to one of these passes needs a
// `Project`, which no worker has: it fails to compile the worker rather than being lost on a pool thread.

// A reply cell carrying one function back. The message throws nothing, so the promise names no
// error type.
typealias StdArrivedUnits = ArrivedUnits with StdModule
typealias StdPassWorkerHandleArray = Array with StdPassWorker.handle

export typealias StdPassRetirees = WorkerRetirees with StdPassWorker.handle

// The per-function landing slots the drain fills in ARRIVAL order, and the fold reads in index order
// through `LandingSlots.slotOf`.
typealias DerivedOriginsArray = Array with DerivedOrigins

// The pool runs every member from the first function of the module; `runStdPassesOverTheBand` runs the
// same members from the index the appended band begins at.
let WholeModuleFirstFunction = 0

// ⭐ **THE SCHEDULE'S STEPS — the fan-out's members as the pipeline schedules them and a worker receives
// them.** A `PassKind` is a union, which may neither hold its own kind as a payload nor cross to a
// worker (a union value is a box the transfer walk must find sole), so a member is spelled as a scalar
// and `PassPipeline.passKindOfFanOutStep` is the one map to the pass it stands for — what the driver
// announces, bills and summarizes it as.
export enum StdFanOutStep
	pruneDeadBlockArgs
	elimTrivialBlockArgs
	foldConstants
	strengthReduceDivision
	foldConstOperands
	threadConstantBranches
	refineValueRanges
	commonSubexpressionElimination
	loopInvariantCodeMotion
	unswitchInvariantGuards
	foldEstablishedGuards
	refineVersionedRanges
end 'StdFanOutStep'

export typealias StdFanOutStepArray = Array with StdFanOutStep

// What one step of the schedule runs with: the pass's scratch. A step with no scratch carries
// nothing; its tally is the step's own, which a scratch that counts also holds a reference to.
union StepWorkspace
	blockArgPrune
	blockArgFold
	constants(branch StdBranchOperands)
	division(reduction DivisionReduction, magic DivisionMagic, def StdFoldableDef)
	constOperands
	threading(scratch ThreadScratch)
	ranges(scratch RangeScratch)
	subexpressions(scratch CseScratch)
	invariants(scratch LicmScratch)
	unswitching(scratch UnswitchScratch)
	guards(scratch EstablishedScratch)
	versionedRanges(scratch RangeScratch)
end 'StepWorkspace'

typealias StepWorkspaceArray = Array with StepWorkspace

function workspaceFor(step StdFanOutStep, tally StdPassTally) returns StepWorkspace
	return match step 'step'
		pruneDeadBlockArgs gives StepWorkspace.blockArgPrune
		elimTrivialBlockArgs gives StepWorkspace.blockArgFold
		foldConstants gives StepWorkspace.constants(StdBranchOperands.create())
		strengthReduceDivision gives StepWorkspace.division(DivisionReduction.create(), magic: DivisionMagic.create(), def: StdFoldableDef.create())
		foldConstOperands gives StepWorkspace.constOperands
		threadConstantBranches gives StepWorkspace.threading(ThreadScratch.create(tally))
		refineValueRanges gives StepWorkspace.ranges(RangeScratch.create(tally))
		commonSubexpressionElimination gives StepWorkspace.subexpressions(CseScratch.create())
		loopInvariantCodeMotion gives StepWorkspace.invariants(LicmScratch.create())
		unswitchInvariantGuards gives StepWorkspace.unswitching(UnswitchScratch.create(tally))
		foldEstablishedGuards gives StepWorkspace.guards(EstablishedScratch.create(tally))
		refineVersionedRanges gives StepWorkspace.versionedRanges(RangeScratch.create(tally))
	end 'step'
end 'workspaceFor'

// Whether `unswitchInFunc` has answered for the function a worker is running, and what it said — the
// one fact one step hands the next: `refineVersionedRanges` visits exactly the functions it rewrote.
enum VersioningAnswer
	unasked
	leftAlone
	rewrote
end 'VersioningAnswer'

// ⭐⭐ **THE WORKER. Its state is the two target facts the passes read, the schedule, and the unit it
// is running.** The scratch for each schedule step, the tallies those scratches write into and the
// per-step costs are built per unit, in `runSteps`.
//
// ⚠ **IT IS HANDED `cpu` AND `os`, NOT A `Target`, AND THE SCHEDULE AS SCALARS**, for `BackendWorker`'s
// reason: a `spawn`'s factory arguments are MOVED, and a record or a union box the driver still holds
// would be a second owner.
export type StdPassWorker
	let reducesDivision as bool
	let budget as HoistPressureBudget
	let schedule as immutable StdFanOutStepArray
	var slot as isolated StdUnit

	static function create(cpu CpuArch, os Os, steps immutable StdFanOutStepArray) returns Self
		return Self{reducesDivision: targetLowersMulHigh(cpu), budget: hoistPressureBudgetFor(Target.create(cpu, os: os)), schedule: steps, slot: StdUnit.empty(0)}
	end 'create'

	export function runThen(unit isolated StdUnit, job ElementIndex, receiver CompileReceiver.handle)
		let finished = self.worked(unit)

		try receiver.stdPassAnswered(job, answered: finished, receiver: receiver.clone()) otherwise (e) 'refused'
			match e 'why'
				mailboxFull then panicOnRefusedAnswer("StdPassWorker.runThen")
				serviceStopped then return
			end 'why'
		end 'refused'
	end 'runThen'

	function worked(unit isolated StdUnit) returns isolated StdUnit
		let idle = swap self.slot with unit

		modify self.slot 'work'
			let body = self.slot.holder.take()
			let answer = self.runSteps(body)
			self.slot.answers.fill(answer)
		end 'work'

		return swap self.slot with idle
	end 'worked'

	// Every step of the schedule over the unit's one function, each bracketed on this thread's counters.
	// The workspaces, the tallies the scratches write into and the costs are this function's own.
	module function runSteps(body StdUnitBody) returns StdUnitAnswer
		let tallies = StdPassTallyArray.create(self.schedule.count(), zeroed: false)
		let workspaces = StepWorkspaceArray.create(self.schedule.count(), zeroed: false)

		for step in self.schedule 'eachStep'
			let tally = StdPassTally.create()
			tallies.push(tally)
			workspaces.push(workspaceFor(step, tally: tally))
		end 'eachStep'

		let costs = PoolPhaseCosts.create(self.schedule.count())
		let probe = PhaseProbe.beginCounters()
		var answer = VersioningAnswer.unasked

		for k in 0 upto workspaces.count() 'eachStep'
			probe.reopenCounters()
			answer = runFanOutStep(try workspaces.get(k) otherwise panic("StdPassWorker.runSteps: workspaces.get OOB at {k}"), module: body.unitModule, funcIndex: UnitFunctionIndex, tally: try tallies.get(k) otherwise panic("StdPassWorker.runSteps: tallies.get OOB at {k} — one tally per step, pushed together"), origins: body.origins, reducesDivision: self.reducesDivision, budget: self.budget, answer: answer)
			costs.record(k, probe: probe)
		end 'eachStep'

		// ⛔ **THE ORPHANS GO BEFORE THE REPLY.** A rewrite that leaves an op behind in the flat array leaves
		// its managed payloads shared between the orphan and the op that replaced it — and a reply moves, so
		// every record reachable from it must have one owner. Compacting drops the orphans, which is also
		// what makes the reply carry the function's live ops and nothing else.
		body.unitModule.compactOps()
		return StdUnitAnswer.of(body, costs: costs, tallies: tallies)
	end 'runSteps'
end 'StdPassWorker'

// ⭐⭐ **ONE STEP OF THE SCHEDULE OVER ONE FUNCTION — THE ONE PLACE A STEP IS TIED TO THE PASS IT RUNS.**
// Both drivers reach the passes through here: the pool's worker over a `StdUnit`'s single function, and
// `runStdPassesOverTheBand` over a real index of the whole module. A second spelling of this match would be
// two schedules free to drift.
//
// It RETURNS the versioning answer because that is the one fact one step hands the next —
// `refineVersionedRanges` visits exactly the functions `unswitchInvariantGuards` rewrote. A driver that
// cannot carry the answer between two steps of one function hands `unasked` and earns the panic naming the
// pairing, which is what keeps the band schedule from holding the pair.
function runFanOutStep(workspace StepWorkspace, module StdModule, funcIndex ElementIndex, tally StdPassTally, origins DerivedOrigins, reducesDivision bool, budget HoistPressureBudget, answer VersioningAnswer) returns VersioningAnswer
	match workspace 'step'
		blockArgPrune then tally.removedBlockArgs = tally.removedBlockArgs + (pruneDeadBlockArgsInFunc(module, func: module.getFunc(funcIndex)) as TallyCount)
		blockArgFold then tally.removedBlockArgs = tally.removedBlockArgs + (elimTrivialBlockArgsInFunc(module, func: module.getFunc(funcIndex)) as TallyCount)
		constants(branch) then foldConstantsInFunc(module, func: module.getFunc(funcIndex), branch: branch)
		division(reduction, magic, def) then reduceDivisionsIfLowered(module, funcIndex: funcIndex, reduces: reducesDivision, reduction: reduction, magic: magic, def: def)
		constOperands then foldConstOperandsInFunc(module, func: module.getFunc(funcIndex))
		threading(scratch) then threadConstantBranchesInFunc(module, func: module.getFunc(funcIndex), origins: origins, scratch: scratch)
		ranges(scratch) then refineValueRangesInFunc(module, func: module.getFunc(funcIndex), scratch: scratch)
		subexpressions(scratch) then eliminateInFunc(module, func: module.getFunc(funcIndex), scratch: scratch)
		invariants(scratch) then hoistInFunc(module, func: module.getFunc(funcIndex), scratch: scratch)
		unswitching(scratch) then return versioningAnswerOf(unswitchInFunc(module, func: module.getFunc(funcIndex), origins: origins, budget: budget, scratch: scratch))
		guards(scratch) then foldEstablishedGuardsInFunc(module, func: module.getFunc(funcIndex), scratch: scratch)
		versionedRanges(scratch) then refineVersionedRangesInFunc(module, funcIndex: funcIndex, scratch: scratch, answer: answer)
	end 'step'

	return answer
end 'runFanOutStep'

// The division reduction is a no-op on a target with no high-multiply lowering — the same gate the
// serial entry asks of the compile's target, asked once at `spawn`.
function reduceDivisionsIfLowered(module StdModule, funcIndex ElementIndex, reduces bool, reduction DivisionReduction, magic DivisionMagic, def StdFoldableDef)
	if not reduces 'targetCannotSpellTheMultiply'
		return
	end 'targetCannotSpellTheMultiply'

	reduceDivisionsInFunc(module, func: module.getFunc(funcIndex), reduction: reduction, magic: magic, def: def)
end 'reduceDivisionsIfLowered'

function versioningAnswerOf(rewrote bool) returns VersioningAnswer
	return VersioningAnswer.rewrote if rewrote else VersioningAnswer.leftAlone
end 'versioningAnswerOf'

// The second range refinement, over the shape the versioning made — for exactly the functions
// `unswitchInFunc` answered it rewrote. A schedule that reaches this step before that one has no answer
// to read, and says so rather than visiting nothing.
function refineVersionedRangesInFunc(module StdModule, funcIndex ElementIndex, scratch RangeScratch, answer VersioningAnswer)
	match answer 'answer'
		unasked then panic("refineVersionedRanges: the schedule reached the second range refinement before `unswitchInvariantGuards` answered which functions it rewrote — that pass scopes this one and must precede it")
		leftAlone then return
		rewrote then refineValueRangesInFunc(module, func: module.getFunc(funcIndex), scratch: scratch)
	end 'answer'
end 'refineVersionedRangesInFunc'

// Run the schedule's per-function passes over every function on a worker pool; `PoolSizing` owns how the
// pool is sized. `members` is the schedule, every one a pass `classifyPass` answers `perFunction` for
// (`PassPipeline.requireFanOutMembership`).
typealias StdPoolStateSlot = Slot with StdPoolState

type StdPoolState
	module let workers as StdPassWorkerHandleArray
	module let dispatch as PoolDispatch
	module let arrivedUnits as StdArrivedUnits
	module let scratch as SpliceScratch
	module let stealsBefore as SchedulerEventCount

	static function of(workers StdPassWorkerHandleArray, dispatch PoolDispatch, arrivedUnits StdArrivedUnits, scratch SpliceScratch, stealsBefore SchedulerEventCount) returns StdPoolState
		return Self{workers: workers, dispatch: dispatch, arrivedUnits: arrivedUnits, scratch: scratch, stealsBefore: stealsBefore}
	end 'of'
end 'StdPoolState'

export type StdPassRun
	let project as Project
	let std as StdModule
	let members as StdFanOutStepArray
	let funcCount as ElementIndex
	let reducesDivision as bool
	let tallies as StdPassTallyArray
	let landedOrigins as DerivedOriginsArray
	let slots as LandingSlots
	let pool as StdPoolStateSlot

	export static function create(project Project, std StdModule, members StdFanOutStepArray) returns StdPassRun
		let funcCount = std.funcCount()
		let tallies = StdPassTallyArray.create(members.count(), zeroed: false)

		for _ in members 'eachStep'
			tallies.push(StdPassTally.create())
		end 'eachStep'

		return Self{project: project, std: std, members: members, funcCount: funcCount, reducesDivision: targetLowersMulHigh(project.target.cpu), tallies: tallies, landedOrigins: DerivedOriginsArray.create(0), slots: LandingSlots.create(funcCount), pool: StdPoolStateSlot.create("StdPassRun.pool")}
	end 'create'

	export function begin(receiver CompileReceiver.handle) returns bool
		let sizing = PoolSizing.forJobs(self.funcCount)

		if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'debugging'
			compilerLogger(CompilerLogGroup.codegen).debug(sizing.line(PoolKind.stdFanOut))
		end 'debugging'

		if self.funcCount == 0 'nothingToRun'
			return false
		end 'nothingToRun'

		let workers = StdPassWorkerHandleArray.create(sizing.workerCount, zeroed: false)

		for _ in 0 upto sizing.workerCount 'eachWorker'
			workers.push(spawn StdPassWorker.create(self.project.target.cpu, os: self.project.target.os, steps: freeze self.members.clone()))
		end 'eachWorker'

		let dispatch = PoolDispatch.create(functionOpTallies(self.std.functions, blocks: self.std.blocks), workerCount: sizing.workerCount as PoolSize, assignment: PoolAssignment.staticShare)
		let arrivedUnits = StdArrivedUnits.create(self.funcCount, spent: StdModule.create())
		self.pool.fill(StdPoolState.of(workers, dispatch: dispatch, arrivedUnits: arrivedUnits, scratch: SpliceScratch.create(), stealsBefore: Scheduler.counters().steals))

		for _ in 0 upto dispatch.initialInFlight() 'fillThePipeline'
			self.dispatchOne(dispatch.fillWorker(), receiver: receiver)
		end 'fillThePipeline'

		return true
	end 'begin'

	export function answered(job ElementIndex, answered isolated StdUnit, receiver CompileReceiver.handle) returns bool
		let state = self.pool.held()
		let freedWorker = state.dispatch.landJob(job)
		let unit = merge answered
		let answer = unit.answers.take()
		self.slots.record(job, slot: self.landedOrigins.count())
		state.arrivedUnits.arrive(answer.body.unitModule)
		self.landedOrigins.push(answer.body.origins)
		foldUnitAnswer(self.project, answer: answer, members: self.members, tallies: self.tallies)

		if state.dispatch.hasUndispatchedFor(freedWorker) 'handTheFreedWorkerTheNextJob'
			self.dispatchOne(freedWorker, receiver: receiver)
		end 'handTheFreedWorkerTheNextJob'

		spliceSettledStdUnits(self.std, dispatch: state.dispatch, slots: self.slots, arrivedUnits: state.arrivedUnits, scratch: state.scratch)

		return state.dispatch.inFlightCount() == 0
	end 'answered'

	export function finish()
		if self.pool.isFull() 'aPoolRan'
			let state = self.pool.held()
			state.dispatch.requireEveryJobSettled()

			if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'debugging'
				compilerLogger(CompilerLogGroup.codegen).debug("stdFanOut pool: {Scheduler.counters().steals - state.stealsBefore} work-steal(s) while the pool drained")
			end 'debugging'

			self.project.retiredWorkers.stdPass.keep(state.workers)
		end 'aPoolRan'

		for funcIndex in 0 upto self.funcCount 'foldOriginsInIndexOrder'
			let origins = try self.landedOrigins.get(self.slots.slotOf(funcIndex)) otherwise panic("StdPassRun.finish: landedOrigins.get OOB for function {funcIndex}")
			origins.foldInto(self.project.valueOrigins, funcIndex: funcIndex)
		end 'foldOriginsInIndexOrder'

		announceAndSummarizeSteps(self.members, tallies: self.tallies, funcCount: self.funcCount, reducesDivision: self.reducesDivision)
	end 'finish'

	function dispatchOne(workerSlot ElementIndex, receiver CompileReceiver.handle)
		let state = self.pool.held()
		let worker = try state.workers.get(workerSlot) otherwise panic("StdPassRun.dispatchOne: workers.get OOB at {workerSlot} below count {state.workers.count()}")
		let funcIndex = state.dispatch.nextJob(workerSlot)
		try worker.runThen(StdUnit.extract(self.std, func: self.std.getFunc(funcIndex), funcIndex: funcIndex), job: funcIndex, receiver: receiver.clone()) otherwise panic("{workerRefusedSendMessage("StdPassRun.dispatchOne", subject: "the worker running function {funcIndex}")}")
	end 'dispatchOne'
end 'StdPassRun'

// ⭐⭐ **THE SAME PER-FUNCTION PASSES OVER THE APPENDED RUNTIME BAND — `module.functions[firstFuncIndex …]`.**
// `afterPipeline`'s install block is where the two-run arrangement is stated and owned; this
// is the driver it names.
//
// ⭐ **PASS-MAJOR AND SERIAL, WHERE THE PIPELINE'S RUN IS FUNCTION-MAJOR ON A POOL, AND THAT IS A COST
// ARGUMENT RATHER THAN A DIFFERENT SEMANTICS.** A per-function pass reads one function's CFG and nothing
// else, so the two orders produce the same module. The band is the runtime floor rather than the program —
// hundreds of functions against the program's thousands — so a second pool would spend a service spawn per
// processor, a mailbox and a unit round trip apiece to save a walk that is already short.
//
// ⛔ **IT CANNOT CARRY THE VERSIONING ANSWER, AND THE SCHEDULE THAT NEEDS IT SAYS SO ITSELF.** Pass-major
// means step k finishes every function before step k+1 begins, so what `unswitchInvariantGuards` answered
// about a function cannot reach `refineVersionedRanges` on it; that pass panics on `unasked` rather than
// visiting nothing, which is what keeps the pair out of a band schedule instead of a comment doing it.
export function runStdPassesOverTheBand(project Project, module StdModule, members StdFanOutStepArray, firstFuncIndex ElementIndex)
	let funcCount = module.funcCount()

	for step in members 'eachScheduledStep'
		requireBandStepIsSound(step)
	end 'eachScheduledStep'

	let reducesDivision = targetLowersMulHigh(project.target.cpu)
	let budget = hoistPressureBudgetFor(project.target)

	let irLog = compilerLogger(CompilerLogGroup.ir)

	for k in 0 upto members.count() 'eachStep'
		let step = try members.get(k) otherwise panic("runStdPassesOverTheBand: members.get OOB at {k}")
		let probe = PhaseProbe.beginPhase(project, phase: bandPhaseOfStep(step))
		let tally = StdPassTally.create()
		let workspace = workspaceFor(step, tally: tally)
		announceStep(step, into: irLog, firstFuncIndex: firstFuncIndex, funcCount: funcCount, reducesDivision: reducesDivision)

		for funcIndex in firstFuncIndex upto funcCount 'eachFunc'
			let origins = DerivedOrigins.create()
			var answer = VersioningAnswer.unasked
			answer = runFanOutStep(workspace, module: module, funcIndex: funcIndex, tally: tally, origins: origins, reducesDivision: reducesDivision, budget: budget, answer: answer)
			origins.foldInto(project.valueOrigins, funcIndex: funcIndex)
		end 'eachFunc'

		summarizeStep(step, into: irLog, tally: tally, funcCount: funcCount)
		recordPhase(project, phase: bandPhaseOfStep(step), probe: probe)
	end 'eachStep'
end 'runStdPassesOverTheBand'

// ⛔⛔ **THE THREE MEMBERS THAT MAY NOT RUN OVER THE BAND — REFUSED HERE RATHER THAN REMEMBERED IN A LIST
// SOMEBODY MAINTAINS.** Checked before the first function, so a schedule that holds one never runs at all.
//
// ⛔ `loopInvariantCodeMotion` HOISTS LOADS out of a loop whose blocks hold no store and no call, and its
// own header states the premise that licences that: *"another OS THREAD writing the location while this
// loop spins … a spin-wait with no call in it would be hoisted into an infinite loop. Nothing in this
// compiler's own sources or the stdlib spells one … and the runtime band is not run through this pipeline
// at all."* The band IS that counterexample: a builder spells a poll on a word another thread writes as a
// bare `loadIndirect` in a loop holding neither, so the premise's last clause is the whole of it. MEASURED
// — with this member in the band schedule the compiler's own self-compile went from **40 s to over 900 s**,
// one core saturated where twelve had been busy, because the scheduler's waits stopped observing the words
// they wait on. ⇒ **A LOAD-MOVING PASS OWES AN ATOMIC/VOLATILE DISTINCTION IN THE DIALECT BEFORE IT MAY
// SEE THIS BAND.** `commonSubexpressionElimination` is NOT in this class and runs: it replaces only what
// the dialect calls PURE, and `loadIndirect` is `isPure: false`.
//
// ⛔ `unswitchInvariantGuards` is the one member that is not idempotent — it VERSIONS a loop — and
// `refineVersionedRanges` visits exactly the functions it rewrote. `runStdPassesOverTheBand` is pass-major,
// so it cannot carry that answer from one step to the next; the pair is refused as a pair.
function requireBandStepIsSound(step StdFanOutStep)
	match step 'sound'
		loopInvariantCodeMotion then panic("runStdPassesOverTheBand: `loopInvariantCodeMotion` may not run over the appended runtime band — it hoists a load out of a loop that writes no memory, and a builder spells a wait on a word another thread writes as exactly that loop")
		unswitchInvariantGuards or
		refineVersionedRanges then panic("runStdPassesOverTheBand: a versioning step may not run over the appended runtime band — the versioning pass and the refinement that reads its answer are one step apart per FUNCTION, and this driver is pass-major")
		pruneDeadBlockArgs or
		elimTrivialBlockArgs or
		foldConstants or
		strengthReduceDivision or
		foldConstOperands or
		threadConstantBranches or
		refineValueRanges or
		commonSubexpressionElimination or
		foldEstablishedGuards then break
	end 'sound'
end 'requireBandStepIsSound'

// ⭐ **WHAT A BAND STEP IS BILLED TO.** The two steps that ran over this band before the rest joined them
// keep the rows they have always been read off — the `.metrics.tsv` ordinals are a wire format
// (`CompilePhase`'s header) and a trend line over the runtime's divisions must stay the same trend line.
// Everything else the band's schedule runs shares one row, because the question a reader has is what
// OPTIMIZING the appended band cost, not which of ten walks did it.
function bandPhaseOfStep(step StdFanOutStep) returns CompilePhase
	return match step 'phase'
		strengthReduceDivision gives CompilePhase.strengthReduceEmittedDivision
		foldConstOperands gives CompilePhase.foldEmittedConstOperands
		pruneDeadBlockArgs or
		elimTrivialBlockArgs or
		foldConstants or
		threadConstantBranches or
		refineValueRanges or
		commonSubexpressionElimination or
		loopInvariantCodeMotion or
		unswitchInvariantGuards or
		foldEstablishedGuards or
		refineVersionedRanges gives CompilePhase.optimizeEmittedBand
	end 'phase'
end 'bandPhaseOfStep'

// Fold one function's per-step costs into the passes' own phase rows, and its tallies into the driver's.
function foldUnitAnswer(project Project, answer StdUnitAnswer, members StdFanOutStepArray, tallies StdPassTallyArray)
	if answer.costs.width() != members.count() or answer.tallies.count() != members.count() 'notTheSchedule'
		panic("foldUnitAnswer: a unit answered {answer.costs.width()} cost row(s) and {answer.tallies.count()} tally(s) against a schedule of {members.count()} step(s) — every worker is spawned with this schedule")
	end 'notTheSchedule'

	for k in 0 upto members.count() 'eachStep'
		let step = try members.get(k) otherwise panic("foldUnitAnswer: members.get OOB at {k}")
		foldPoolPhaseDelta(project, phase: compilePhaseOfPass(passKindOfFanOutStep(step)), driver: CompilePhase.stdFanOut, delta: answer.costs.accumulated(k))
		let tally = try tallies.get(k) otherwise panic("foldUnitAnswer: tallies.get OOB at {k}")
		tally.absorb(try answer.tallies.get(k) otherwise panic("foldUnitAnswer: answer.tallies.get OOB at {k} after the count check"))
	end 'eachStep'
end 'foldUnitAnswer'

function spliceSettledStdUnits(module StdModule, dispatch PoolDispatch, slots LandingSlots, arrivedUnits StdArrivedUnits, scratch SpliceScratch)
	while dispatch.hasNextToSettle() 'eachSettledJob'
		let job = dispatch.takeNextToSettle()
		let slot = slots.slotOf(job)
		spliceStdUnit(module, func: module.getFunc(job), unitModule: arrivedUnits.unitAt(slot), scratch: scratch)
		arrivedUnits.spend(slot)
	end 'eachSettledJob'
end 'spliceSettledStdUnits'

function announceAndSummarizeSteps(members StdFanOutStepArray, tallies StdPassTallyArray, funcCount ElementIndex, reducesDivision bool)
	if not compilerLogEnabled(CompilerLogGroup.ir, level: LogLevel.debug) 'quiet'
		return
	end 'quiet'

	let irLog = compilerLogger(CompilerLogGroup.ir)

	for k in 0 upto members.count() 'eachStep'
		let step = try members.get(k) otherwise panic("announceAndSummarizeSteps: members.get OOB at {k}")
		announceStep(step, into: irLog, firstFuncIndex: WholeModuleFirstFunction, funcCount: funcCount, reducesDivision: reducesDivision)
		summarizeStep(step, into: irLog, tally: try tallies.get(k) otherwise panic("announceAndSummarizeSteps: tallies.get OOB at {k}"), funcCount: funcCount)
	end 'eachStep'
end 'announceAndSummarizeSteps'

function announceStep(step StdFanOutStep, into Logger, firstFuncIndex ElementIndex, funcCount ElementIndex, reducesDivision bool)
	if not into.enabled(LogLevel.debug) 'quiet'
		return
	end 'quiet'

	into.debug(passBanner(passKindOfFanOutStep(step)))

	match step 'headline'
		foldConstants then into.debug(foldConstantsHeadline(funcCount))
		strengthReduceDivision then into.debug(strengthReduceDivisionHeadline(reducesDivision, firstFuncIndex: firstFuncIndex, funcCount: funcCount))
		foldConstOperands then into.debug(foldConstOperandsHeadline(firstFuncIndex, funcCount: funcCount))
		commonSubexpressionElimination then into.debug(commonSubexpressionEliminationHeadline(funcCount))
		loopInvariantCodeMotion then into.debug(hoistLoopInvariantsHeadline(funcCount))
		pruneDeadBlockArgs or
		elimTrivialBlockArgs or
		threadConstantBranches or
		refineValueRanges or
		unswitchInvariantGuards or
		foldEstablishedGuards or
		refineVersionedRanges then break
	end 'headline'
end 'announceStep'

function summarizeStep(step StdFanOutStep, into Logger, tally StdPassTally, funcCount ElementIndex)
	if not into.enabled(LogLevel.debug) 'quiet'
		return
	end 'quiet'

	match step 'summary'
		pruneDeadBlockArgs then into.debug(pruneDeadBlockArgsSummary(tally, funcCount: funcCount))
		elimTrivialBlockArgs then into.debug(elimTrivialBlockArgsSummary(tally, funcCount: funcCount))
		threadConstantBranches then into.debug(threadConstantBranchesSummary(tally, funcCount: funcCount))
		refineValueRanges or
		refineVersionedRanges then into.debug(refineValueRangesSummary(tally, funcCount: funcCount))
		unswitchInvariantGuards then into.debug(unswitchInvariantGuardsSummary(tally, funcCount: funcCount))
		foldEstablishedGuards then into.debug(foldEstablishedGuardsSummary(tally))
		foldConstants or
		strengthReduceDivision or
		foldConstOperands or
		commonSubexpressionElimination or
		loopInvariantCodeMotion then break
	end 'summary'
end 'summarizeStep'
