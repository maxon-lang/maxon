// StdPassPool — THE PER-FUNCTION Std PASSES ON A POOL OF WORKER SERVICES, one per processor.
//
// ⚠ A run under `MAXON_MAX_PROCS=1` is THIS pool with one processor in it, not a serial fallback — which
// is what makes the pinned and the default lane the same code path and their outputs comparable at all.
//
// ⭐⭐ **WHY THESE PASSES.** The contiguous run from `pruneDeadBlockArgs` to the block-arg cleanup after
// `refineVersionedRanges` — every pass `classifyPass` answers `perFunction` for — is intra-function by
// construction: each reads one function's CFG, values and ops and nothing about another's. It is also
// FUNCTION-MAJOR here where the pipeline is pass-major: a worker takes one function through every step of
// the schedule before the next, so a function crosses to a worker ONCE and comes home ONCE, rather than
// once per pass.
//
// ⭐⭐ **WHAT MAKES IT SAFE IS THE UNIT, NOT LOCKING — there is none.** A message MOVES, so a worker is
// handed a `StdUnit` nobody else can reach and hands back a `StdUnitBody` nobody else can reach.
// `StdUnit`'s header owns that argument, and `BackendPool`'s owns the pool's.
//
// ⭐⭐ **AND THE OUTPUT DOES NOT DEPEND ON THE POOL.** Splicing is order-independent — a result writes
// this function's own block and op slots and the TAIL of the two module arrays, and an index into either
// reaches no emitted byte (`StdUnit`'s header) — and everything that is NOT order-independent is done in
// FUNCTION-INDEX ORDER on this thread after the drain: the derived-origin rows are folded, and the passes'
// log lines are replayed PASS-MAJOR, each pass's banner and headline, then every function's lines for
// that pass in index order, then the pass's summary from the tallies summed over every worker — so
// `--log=ir:trace` reads as a serial run of the same passes would, whichever worker ran a function and
// in whatever order the pool finished (`tests/parallel-compile/log-order`).
//
// ⚠ **WHAT A WORKER STRUCTURALLY CANNOT DO** shaped every seam here, and each is a rule with teeth. It may
// not touch a module `var` — E3143 — which rules out the logger (`PassLog` buffers its lines), every
// `Project` table (`DerivedOrigins` buffers its rows, the target facts come in as two enums and the cost
// tables as a `PoolPhaseCosts` the driver folds) and the trace-span stack (`PhaseProbe.beginCounters`
// opens none). It may not call a closure — an indirect dispatch marks every address-taken function in
// the program message-reachable, which reaches the logger — so a log site builds its text past a guard
// rather than handing over a thunk. It may not await, and it never sends.
//
// ⛔ **THE MESSAGE'S ERROR SET IS EMPTY, AND THAT IS A PREMISE OF THE PIPELINE'S ERROR GATE.** None of
// the fanned-out passes raises a diagnostic; `specs/pass-fan-out-order.md` pins the nearest pass that
// does, `insertRangeChecks`, which stays serial. A diagnostic added to one of these passes needs a
// `Project`, which no worker has: it fails to compile the worker rather than being lost on a pool thread.

// A reply cell carrying one function back. The message throws nothing, so its error set is the bare
// `ServiceError` — the service can be gone.
typealias StdPassReply = Promise with (StdUnitBody, ServiceError)
typealias StdPassReplyArray = Array with StdPassReply
typealias StdPassReportReply = Promise with (StdPassWorkerReport, ServiceError)
typealias StdPassWorkerHandleArray = Array with StdPassWorker.handle

// The per-function landing slots the drain fills in ARRIVAL order, and the fold reads in index order
// through `LandingSlots.slotOf`.
typealias DerivedOriginsArray = Array with DerivedOrigins
typealias CapturedLogArray = Array with PassLogArray

// A position in the schedule the fan-out runs.
typealias StepIndex = int(0 to u64.max)

// The fan-out runs every member over the WHOLE module — the runtime band is appended below the pipeline
// — where the two passes with a serial re-run over that band take a start index.
let WholeModuleFirstFunction = 0 as FuncIndex

// ⭐ **THE SCHEDULE'S STEPS — the fan-out's members as the pipeline schedules them and a worker receives
// them.** A `PassKind` is a union, which may neither hold its own kind as a payload nor cross to a
// worker (a union value is a box the transfer walk must find sole), so a member is spelled as a scalar
// and `PassPipeline.passKindOfFanOutStep` is the one map to the pass it stands for — what the driver
// announces, bills and summarizes it as.
export enum StdFanOutStep
	pruneDeadBlockArgs
	elimTrivialBlockArgs
	foldConstants
	strengthReduceDivision
	foldConstOperands
	threadConstantBranches
	refineValueRanges
	commonSubexpressionElimination
	loopInvariantCodeMotion
	unswitchInvariantGuards
	foldEstablishedGuards
	refineVersionedRanges
end 'StdFanOutStep'

export typealias StdFanOutStepArray = Array with StdFanOutStep

// What one step of the schedule reuses across every function a worker runs: the pass's scratch, whose
// tallies and log are the worker's own. A step with no scratch carries nothing; its tally is the
// worker's per-step tally, which every scratch also holds a reference to.
union StepWorkspace
	blockArgPrune
	blockArgFold
	constants(branch StdBranchOperands)
	division(reduction DivisionReduction, magic SignedMagic, def StdFoldableDef)
	constOperands
	threading(scratch ThreadScratch)
	ranges(scratch RangeScratch)
	subexpressions(scratch CseScratch)
	invariants(scratch LicmScratch)
	unswitching(scratch UnswitchScratch)
	guards(scratch EstablishedScratch)
	versionedRanges(scratch RangeScratch)
end 'StepWorkspace'

typealias StepWorkspaceArray = Array with StepWorkspace

function workspaceFor(step StdFanOutStep, tally StdPassTally, log PassLog) returns StepWorkspace
	return match step 'step'
		pruneDeadBlockArgs gives StepWorkspace.blockArgPrune
		elimTrivialBlockArgs gives StepWorkspace.blockArgFold
		foldConstants gives StepWorkspace.constants(StdBranchOperands.create())
		strengthReduceDivision gives StepWorkspace.division(DivisionReduction.create(), magic: SignedMagic.create(), def: StdFoldableDef.create())
		foldConstOperands gives StepWorkspace.constOperands
		threadConstantBranches gives StepWorkspace.threading(ThreadScratch.create(tally, log: log))
		refineValueRanges gives StepWorkspace.ranges(RangeScratch.create(tally, log: log))
		commonSubexpressionElimination gives StepWorkspace.subexpressions(CseScratch.create(log))
		loopInvariantCodeMotion gives StepWorkspace.invariants(LicmScratch.create(log))
		unswitchInvariantGuards gives StepWorkspace.unswitching(UnswitchScratch.create(tally, log: log))
		foldEstablishedGuards gives StepWorkspace.guards(EstablishedScratch.create(tally, log: log))
		refineVersionedRanges gives StepWorkspace.versionedRanges(RangeScratch.create(tally, log: log))
	end 'step'
end 'workspaceFor'

// Whether `unswitchInFunc` has answered for the function a worker is running, and what it said — the
// one fact one step hands the next: `refineVersionedRanges` visits exactly the functions it rewrote.
enum VersioningAnswer
	unasked
	leftAlone
	rewrote
end 'VersioningAnswer'

// ⭐⭐ **THE WORKER. Its state is the two target facts the passes read, one scratch per schedule step, the
// tallies and log those scratches write into, and the per-step costs** — built ONCE and reused for every
// function the pool hands it, exactly as the pipeline reuses one scratch per pass across the module.
//
// ⚠ **IT IS HANDED `cpu` AND `os`, NOT A `Target`, AND THE SCHEDULE AS SCALARS**, for `BackendWorker`'s
// reason: a `spawn`'s factory arguments are MOVED, and a record or a union box the driver still holds
// would be a second owner.
//
// ⛔ **THE SCRATCHES ARE BUILT ON THE FIRST MESSAGE, NOT AT `spawn`.** The factory's result is MOVED to
// the service exactly as an argument is (`Parser.emitServiceSpawn`), and the transfer walk requires one
// owner per record — while the log every scratch writes to, and the tally a scratch and the report both
// read, are each reachable twice by design. Built on the worker's own green thread, past every walk,
// that sharing is what it should be: one record, read by the two things that need it.
module type StdPassWorker
	var reducesDivision as bool
	var budget as HoistPressureBudget
	var log as PassLog
	var schedule as StdFanOutStepArray

	// Empty until the first message (`prepareWorkspaces`), then one entry per schedule step.
	var steps as StepWorkspaceArray
	var tallies as StdPassTallyArray
	var costs as PoolPhaseCosts

	// The one bracket every step of every function is measured with, reopened per step
	// (`PhaseProbe.reopenCounters`): a probe minted per step would be an allocation inside every row.
	var probe as PhaseProbe

	static function create(cpu CpuArch, os Os, steps StdFanOutStepArray, irLevel LogLevel) returns Self
		return Self{reducesDivision: targetLowersMulHighSigned(cpu), budget: hoistPressureBudgetFor(Target.create(cpu, os: os)), log: PassLog.create(irLevel), schedule: steps, steps: StepWorkspaceArray.create(), tallies: StdPassTallyArray.create(), costs: PoolPhaseCosts.create(steps.count()), probe: PhaseProbe.beginCounters()}
	end 'create'

	function prepareWorkspaces()
		if self.steps.count() == self.schedule.count() 'alreadyBuilt'
			return
		end 'alreadyBuilt'

		for step in self.schedule 'eachStep'
			let tally = StdPassTally.create()
			self.tallies.push(tally)
			self.steps.push(workspaceFor(step, tally: tally, log: self.log))
		end 'eachStep'
	end 'prepareWorkspaces'

	// The message. It never awaits and never sends, which is what makes the blocking graph E3139 checks
	// trivially acyclic: a pool worker is a leaf. Its error set is empty — see this file's header.
	export function run(unit StdUnit) returns StdUnitBody
		return StdUnitBody.afterRunning(unit, worker: self)
	end 'run'

	// What this worker counted and spent over every function it ran, as fresh records the reply may carry.
	export function report() returns StdPassWorkerReport
		return StdPassWorkerReport.of(self.costs, tallies: self.tallies)
	end 'report'

	// Every step of the schedule over the unit's one function, each bracketed on this thread's counters
	// and its lines grouped under its step (`PassLog.beginStep`).
	module function runSteps(body StdUnitBody)
		self.prepareWorkspaces()
		self.log.beginFunction()
		var answer = VersioningAnswer.unasked

		for k in 0 upto self.steps.count() 'eachStep'
			self.probe.reopenCounters()
			self.log.beginStep()
			self.runStep(k, unitModule: body.unitModule, origins: body.origins, answer: answer)
			self.costs.record(k, probe: self.probe)
		end 'eachStep'

		// ⛔ **THE ORPHANS GO BEFORE THE REPLY.** A rewrite that leaves an op behind in the flat array leaves
		// its managed payloads shared between the orphan and the op that replaced it — and a reply moves, so
		// every record reachable from it must have one owner. Compacting drops the orphans, which is also
		// what makes the reply carry the function's live ops and nothing else.
		body.unitModule.compactOps()

		if not self.log.isEmpty() 'somethingLogged'
			body.capturedLog.push(PassLog.taking(self.log))
		end 'somethingLogged'
	end 'runSteps'

	// One step. The function is read through `getFunc` at every call rather than held across them, for
	// the borrow rule `elimTrivialBlockArgs`' canonical note states: each pass writes the module it reads
	// the function out of.
	function runStep(k StepIndex, unitModule StdModule, origins DerivedOrigins, answer VersioningAnswer)
		var tally = try self.tallies.get(k) otherwise panic("StdPassWorker.runStep: tallies.get OOB at {k} — one tally per step, pushed together at create")

		match try self.steps.get(k) otherwise panic("StdPassWorker.runStep: steps.get OOB at {k}") 'step'
			blockArgPrune then tally.removedBlockArgs = tally.removedBlockArgs + (pruneDeadBlockArgsInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex)) as TallyCount)
			blockArgFold then tally.removedBlockArgs = tally.removedBlockArgs + (elimTrivialBlockArgsInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex)) as TallyCount)
			constants(branch) then foldConstantsInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), branch: branch, log: self.log)
			division(reduction, magic, def) then reduceDivisionsIfLowered(unitModule, reduces: self.reducesDivision, reduction: reduction, magic: magic, def: def)
			constOperands then foldConstOperandsInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex))
			threading(scratch) then threadConstantBranchesInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), origins: origins, scratch: scratch)
			ranges(scratch) then refineValueRangesInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), scratch: scratch)
			subexpressions(scratch) then eliminateInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), scratch: scratch)
			invariants(scratch) then hoistInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), scratch: scratch)
			unswitching(scratch) then answer = versioningAnswerOf(unswitchInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), origins: origins, budget: self.budget, scratch: scratch))
			guards(scratch) then foldEstablishedGuardsInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), scratch: scratch)
			versionedRanges(scratch) then refineVersionedRangesInFunc(unitModule, scratch: scratch, answer: answer)
		end 'step'
	end 'runStep'
end 'StdPassWorker'

// The division reduction is a no-op on a target with no `mulHighSigned` lowering — the same gate the
// serial entry asks of the compile's target, asked once at `spawn`.
function reduceDivisionsIfLowered(unitModule StdModule, reduces bool, reduction DivisionReduction, magic SignedMagic, def StdFoldableDef)
	if not reduces 'targetCannotSpellTheMultiply'
		return
	end 'targetCannotSpellTheMultiply'

	reduceDivisionsInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), reduction: reduction, magic: magic, def: def)
end 'reduceDivisionsIfLowered'

function versioningAnswerOf(rewrote bool) returns VersioningAnswer
	return VersioningAnswer.rewrote if rewrote else VersioningAnswer.leftAlone
end 'versioningAnswerOf'

// The second range refinement, over the shape the versioning made — for exactly the functions
// `unswitchInFunc` answered it rewrote. A schedule that reaches this step before that one has no answer
// to read, and says so rather than visiting nothing.
function refineVersionedRangesInFunc(unitModule StdModule, scratch RangeScratch, answer VersioningAnswer)
	match answer 'answer'
		unasked then panic("refineVersionedRanges: the schedule reached the second range refinement before `unswitchInvariantGuards` answered which functions it rewrote — that pass scopes this one and must precede it")
		leftAlone then return
		rewrote then refineValueRangesInFunc(unitModule, func: unitModule.getFunc(UnitFunctionIndex), scratch: scratch)
	end 'answer'
end 'refineVersionedRangesInFunc'

// EVERYTHING ONE WORKER HANDS BACK AT THE END: its per-step costs and tallies, as records nothing else
// holds (a reply moves).
type StdPassWorkerReport
	export var costs as PoolPhaseCosts
	export var tallies as StdPassTallyArray

	module static function of(costs PoolPhaseCosts, tallies StdPassTallyArray) returns StdPassWorkerReport
		var copies = StdPassTallyArray.create()

		for tally in tallies 'eachStep'
			copies.push(StdPassTally.copyOf(tally))
		end 'eachStep'

		return Self{costs: PoolPhaseCosts.copyOf(costs), tallies: copies}
	end 'of'
end 'StdPassWorkerReport'

// ⭐⭐ **RUN THE SCHEDULE'S PER-FUNCTION PASSES OVER EVERY FUNCTION ON A POOL OF `min(P, F)` WORKERS.**
//
// P is the SCHEDULER's resolved processor count, not the machine's: `MAXON_MAX_PROCS=1` resolves it to
// one and the pool is then one worker. F is the function count, because a worker with no function to
// run is a mailbox and a green thread bought for nothing. `members` is the schedule, every one a pass
// `classifyPass` answers `perFunction` for (`PassPipeline.requireFanOutMembership`).
export function runStdPassesOnAWorkerPool(project Project, module StdModule, members StdFanOutStepArray)
	let funcCount = module.funcCount()
	let processors = __Builtins.schedProcessorCount()
	let workerCount = processors if processors < funcCount else funcCount
	let reducesDivision = targetLowersMulHighSigned(project.target.cpu)

	// The only evidence that the passes ran in PARALLEL rather than merely correctly: the byte-identity
	// gates pass on a pool of one. Under `codegen`, beside the allocator's line, so that `--log=ir:trace`
	// — whose per-function lines `tests/parallel-compile/log-order` compares pinned against default —
	// does not carry a worker count that differs between the two.
	logDebug(LogCategory.codegen, message: function() gives "stdFanOut: {workerCount} worker(s) over {processors} processor(s), {funcCount} function(s)")

	var tallies = StdPassTallyArray.create()

	for _ in members 'eachStep'
		tallies.push(StdPassTally.create())
	end 'eachStep'

	var landedOrigins = DerivedOriginsArray.create()
	var landedLogs = CapturedLogArray.create()
	var slots = LandingSlots.create(funcCount)

	if funcCount > 0 'somethingToRun'
		// ⛔ **THE FLOOR IS ASKED, NOT ASSUMED.** `min(P, F)` is the pool size, so a resolved P of zero
		// would make an EMPTY pool that runs no pass over any function — a program emitted unoptimized
		// rather than a diagnostic. The scheduler clamps to one; this is where that promise is held to.
		if processors < 1 'theSchedulerResolvedNoProcessor'
			panic("runStdPassesOnAWorkerPool: the scheduler resolved {processors} processor(s), so the pool would be empty and no pass would run over any function at all")
		end 'theSchedulerResolvedNoProcessor'

		let poolSize = workerCount as PoolSize
		let irLevel = effectiveLogLevelOf(LogCategory.ir)

		var workers = StdPassWorkerHandleArray.create()

		for _ in 0 upto workerCount 'eachWorker'
			workers.push(spawn StdPassWorker.create(project.target.cpu, os: project.target.os, steps: members.clone(), irLevel: irLevel))
		end 'eachWorker'

		let stealsBefore = __Builtins.schedStealCount()
		drainTheStdPool(module, workers: workers, workerCount: poolSize, landedOrigins: landedOrigins, landedLogs: landedLogs, slots: slots)
		let stealsAfter = __Builtins.schedStealCount()
		logDebug(LogCategory.codegen, message: function() gives "stdFanOut pool: {stealsAfter - stealsBefore} work-steal(s) while the pool drained")

		// Each worker's costs and tallies come home once, after its last function. Both are SUMS, so the
		// worker order cannot reach a row or a line.
		for slot in 0 upto workerCount 'eachReport'
			var worker = try workers.get(slot) otherwise panic("runStdPassesOnAWorkerPool: workers.get OOB at {slot} below count {workers.count()}")
			foldWorkerReport(project, report: awaitedReport(worker.report(), slot: slot), members: members, tallies: tallies)
		end 'eachReport'

		// ⛔ **EVERY HANDLE GOES BEFORE THIS FRAME DOES.** Dropping the last handle to a service closes its
		// mailbox, which is what lets the worker's green thread finish; a handle still held at process
		// exit is a service that never ends and an exit that never comes.
		workers.clear()
	end 'somethingToRun'

	for funcIndex in 0 upto funcCount 'foldOriginsInIndexOrder'
		let origins = try landedOrigins.get(slots.slotOf(funcIndex)) otherwise panic("runStdPassesOnAWorkerPool: landedOrigins.get OOB for function {funcIndex}")
		origins.foldInto(project.valueOrigins, funcIndex: funcIndex)
	end 'foldOriginsInIndexOrder'

	replayFanOutLog(members, tallies: tallies, landedLogs: landedLogs, slots: slots, funcCount: funcCount, reducesDivision: reducesDivision)
end 'runStdPassesOnAWorkerPool'

function awaitedReport(reply StdPassReportReply, slot LandingSlot) returns StdPassWorkerReport
	if let report = try await reply 'reported'
		return report
	end 'reported' else (e) 'notReported'
		match e 'why'
			// Nothing here drops a handle before every report has landed, so the worker's green thread
			// DIED — a panic inside a pass, whose message is already on stderr.
			stopped then panic("runStdPassesOnAWorkerPool: worker {slot} is gone before reporting. This driver drops no handle until every reply has landed, so its green thread ended on its own — look above for the panic it printed.")
		end 'why'
	end 'notReported'
end 'awaitedReport'

// Fold one worker's per-step costs into the passes' own phase rows, and its tallies into the driver's.
function foldWorkerReport(project Project, report StdPassWorkerReport, members StdFanOutStepArray, tallies StdPassTallyArray)
	if report.costs.width() != members.count() or report.tallies.count() != members.count() 'notTheSchedule'
		panic("runStdPassesOnAWorkerPool: a worker reported {report.costs.width()} cost row(s) and {report.tallies.count()} tally(s) against a schedule of {members.count()} step(s) — every worker is spawned with this schedule")
	end 'notTheSchedule'

	for k in 0 upto members.count() 'eachStep'
		let step = try members.get(k) otherwise panic("foldWorkerReport: members.get OOB at {k}")
		foldPoolPhaseDelta(project, phase: compilePhaseOfPass(passKindOfFanOutStep(step)), driver: CompilePhase.stdFanOut, delta: report.costs.accumulated(k))
		let tally = try tallies.get(k) otherwise panic("foldWorkerReport: tallies.get OOB at {k}")
		tally.absorb(try report.tallies.get(k) otherwise panic("foldWorkerReport: report.tallies.get OOB at {k} after the count check"))
	end 'eachStep'
end 'foldWorkerReport'

// ⭐⭐ **THE DISPATCH LOOP: fill the pipeline, then serve whoever finished first.** The protocol is
// `PoolDispatch`'s, shared with `BackendPool.drainTheBackendPool`; what is this pool's own is the reply
// type and the landing. Every promise is awaited (an un-awaited one is the green-thread exit gate's own
// error, exit 75), `awaitAny` keeps the pool busy, and the dispatch order is longest-first
// (`functionsLongestFirst`, which says why that order cannot reach the output).
function drainTheStdPool(module StdModule, workers StdPassWorkerHandleArray, workerCount PoolSize, landedOrigins DerivedOriginsArray, landedLogs CapturedLogArray, slots LandingSlots)
	var scratch = SpliceScratch.create()
	var dispatch = PoolDispatch.create(module.functions, blocks: module.blocks, funcCount: module.funcCount() as PoolSize, workerCount: workerCount)
	var replies = StdPassReplyArray.create()

	for _ in 0 upto dispatch.initialInFlight() 'fillThePipeline'
		dispatchOneStdJob(module, workers: workers, workerSlot: dispatch.fillWorker(), dispatch: dispatch, replies: replies)
	end 'fillThePipeline'

	while replies.count() > 0 'serveWhoeverFinishedFirst'
		let ready = __Builtins.awaitAny(replies)
		let freedWorker = dispatch.workerAt(ready)
		let funcIndex = dispatch.land(ready, outstanding: replies.count())
		let reply = try replies.remove(ready) otherwise panic("drainTheStdPool: replies.remove({ready}) — `awaitAny` answered a slot of this very array")

		if let body = try await reply 'ran'
			spliceStdUnit(module, func: module.getFunc(funcIndex), body: body, scratch: scratch)
			slots.record(funcIndex, slot: landedOrigins.count())
			landedOrigins.push(body.origins)
			landedLogs.push(body.capturedLog)
		end 'ran' else (e) 'notRun'
			match e 'why'
				// The worker's mailbox closed under a job in flight. Nothing here drops a handle before the
				// drain has finished, so it means the worker's green thread DIED — a panic inside a pass,
				// whose message is already on stderr.
				stopped then panic("drainTheStdPool: the worker running function {funcIndex} is gone. This driver drops no handle until every reply has landed, so its green thread ended on its own — look above for the panic it printed.")
			end 'why'
		end 'notRun'

		if dispatch.hasUndispatched() 'handTheFreedWorkerTheNextJob'
			dispatchOneStdJob(module, workers: workers, workerSlot: freedWorker, dispatch: dispatch, replies: replies)
		end 'handTheFreedWorkerTheNextJob'
	end 'serveWhoeverFinishedFirst'
end 'drainTheStdPool'

// Send the next job in dispatch order to ONE worker, and push its reply at the slot `PoolDispatch` just
// recorded the job in. The unit is built INSIDE the argument and stored nowhere, which is E3138's rule
// and not a style: the one shape the check admits is a call whose every `return` is a record literal
// (`StdUnit.extract`).
function dispatchOneStdJob(module StdModule, workers StdPassWorkerHandleArray, workerSlot PoolSlot, dispatch PoolDispatch, replies StdPassReplyArray)
	var worker = try workers.get(workerSlot) otherwise panic("dispatchOneStdJob: workers.get OOB at {workerSlot} below count {workers.count()}")
	let funcIndex = dispatch.nextJob(workerSlot)
	replies.push(worker.run(StdUnit.extract(module, func: module.getFunc(funcIndex), funcIndex: funcIndex)))
end 'dispatchOneStdJob'

// ══════════════════════════════════════════════════════════════════════════
// The replay: the log of a serial run, pass-major, from what the workers captured
// ══════════════════════════════════════════════════════════════════════════

function replayFanOutLog(members StdFanOutStepArray, tallies StdPassTallyArray, landedLogs CapturedLogArray, slots LandingSlots, funcCount FuncCount, reducesDivision bool)
	for k in 0 upto members.count() 'eachStep'
		let step = try members.get(k) otherwise panic("replayFanOutLog: members.get OOB at {k}")
		logIr(passBanner(passKindOfFanOutStep(step)))
		announceStep(step, funcCount: funcCount, reducesDivision: reducesDivision)

		for funcIndex in 0 upto funcCount 'eachFunctionInIndexOrder'
			let captured = try landedLogs.get(slots.slotOf(funcIndex)) otherwise panic("replayFanOutLog: landedLogs.get OOB for function {funcIndex}")

			for log in captured 'theFunctionsLog'
				log.replayStep(k as LogLineIndex, category: LogCategory.ir)
			end 'theFunctionsLog'
		end 'eachFunctionInIndexOrder'

		summarizeStep(step, tally: try tallies.get(k) otherwise panic("replayFanOutLog: tallies.get OOB at {k}"), funcCount: funcCount)
	end 'eachStep'
end 'replayFanOutLog'

function logIr(text String)
	logDebug(LogCategory.ir, message: function() gives text)
end 'logIr'

// The headline a pass prints before its per-function lines, where it prints one.
function announceStep(step StdFanOutStep, funcCount FuncCount, reducesDivision bool)
	match step 'headline'
		foldConstants then logIr(foldConstantsHeadline(funcCount))
		strengthReduceDivision then logIr(strengthReduceDivisionHeadline(reducesDivision, firstFuncIndex: WholeModuleFirstFunction, funcCount: funcCount))
		foldConstOperands then logIr(foldConstOperandsHeadline(WholeModuleFirstFunction, funcCount: funcCount))
		commonSubexpressionElimination then logIr(commonSubexpressionEliminationHeadline(funcCount))
		loopInvariantCodeMotion then logIr(hoistLoopInvariantsHeadline(funcCount))
		pruneDeadBlockArgs or
			elimTrivialBlockArgs or
			threadConstantBranches or
			refineValueRanges or
			unswitchInvariantGuards or
			foldEstablishedGuards or
			refineVersionedRanges then break 'headline'
	end 'headline'
end 'announceStep'

// The summary a pass prints after its per-function lines, where it prints one.
function summarizeStep(step StdFanOutStep, tally StdPassTally, funcCount FuncCount)
	match step 'summary'
		pruneDeadBlockArgs then logIr(pruneDeadBlockArgsSummary(tally, funcCount: funcCount))
		elimTrivialBlockArgs then logIr(elimTrivialBlockArgsSummary(tally, funcCount: funcCount))
		threadConstantBranches then logIr(threadConstantBranchesSummary(tally, funcCount: funcCount))
		refineValueRanges or
			refineVersionedRanges then logIr(refineValueRangesSummary(tally, funcCount: funcCount))
		unswitchInvariantGuards then logIr(unswitchInvariantGuardsSummary(tally, funcCount: funcCount))
		foldEstablishedGuards then logIr(foldEstablishedGuardsSummary(tally))
		foldConstants or
			strengthReduceDivision or
			foldConstOperands or
			commonSubexpressionElimination or
			loopInvariantCodeMotion then break 'summary'
	end 'summary'
end 'summarizeStep'
