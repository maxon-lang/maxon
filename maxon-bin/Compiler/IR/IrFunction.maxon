end 'cacheWriteThrowsClause'

function cacheWriteThrowsClauseThrowing(writer LibraryCacheWriter, a0 String)
	writer.text(a0)
end 'cacheWriteThrowsClauseThrowing'

export function cacheReadThrowsClause(reader LibraryCacheReader) returns ThrowsClause throws LibraryCacheDamage
