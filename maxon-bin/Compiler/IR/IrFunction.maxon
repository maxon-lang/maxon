typealias OwnedColumnBits = int(0 to 63)

let EveryColumnOwnedBits = 63

type ColumnOwnership
	let bits as OwnedColumnBits

	static function nothing() returns ColumnOwnership
		return Self{bits: 0}
	end 'nothing'

	static function everything() returns ColumnOwnership
		return Self{bits: EveryColumnOwnedBits}
	end 'everything'

	function owns(column SharedColumn) returns bool
		return (self.bits and Self.bitOf(column)) != 0
	end 'owns'

	function claiming(column SharedColumn) returns ColumnOwnership
		return Self{bits: (self.bits or Self.bitOf(column)) as OwnedColumnBits}
	end 'claiming'

	static function bitOf(column SharedColumn) returns OwnedColumnBits
		return (1 shl column.ordinal) as OwnedColumnBits
	end 'bitOf'
end 'ColumnOwnership'

