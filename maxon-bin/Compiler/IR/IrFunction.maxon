	// witness to a callee is done at LOWERING (`LowerMaxonToStd.appendExistentialWitnessArgs`), the first tier
	// holding the callee's resolved parameter types — the parser cannot know there which arguments land at
	// interface-typed parameters, so it publishes each value's witness here and the lowering reads it.
	// Empty on a Std-phase function (`createFromStd`).
	export var valueWitnessIds as ValueIdArray

	// ⭐⭐ **THE PER-VALUE EXISTENTIAL-INSTANCE COLUMN, SPARSE by ValueId** — see
	// `ValueExistentialInstanceMap` above for what a `Base with Args` instance is doing beside a value whose
	// type says only `interfaceRef(Base)`.
	//
	// PUBLISHED for `valueWitnessIds`' reason, one fact over. It is minted at PARSE time for the parser's own
	// associated-RESULT typing. The associated FORMAL of that
	// same dispatch is decided at LOWERING (`LowerMaxonToStd.witnessFormalType`), and the refusal that
	// makes the formal decidable whole-program is decided at `ConformanceCheck` — two later tiers asking the
	// SAME question about the SAME receiver, and neither can re-derive the answer: the `with` arguments live
	// on no type and in no signature the callee's own body can reach. So the parser hands the column on
	// instead of dropping it, exactly as it hands on the witness pairing.
	//
	// ⚠⚠ **`create` DOES NOT TAKE THIS VALUE COLUMN, BECAUSE IT CANNOT BE HANDED OVER BY REFERENCE.**
	// Its siblings are ARRAYS the parser grows in place, so a function created before its body is parsed sees
	// every later write through the reference it was built with. This one is a MAP with a copy-on-write
	// anchor: `Parser.recordValueExistentialInstance` REPLACES the field with a fresh map on the first write
	// (the shared empty is never mutated), so the reference `create` was handed is the EMPTY one for exactly
	// the functions that have something to say. `Parser.publishExistentialInstances` fills it once the body is
	// complete instead. MEASURED: without that, `stdlib/Array.maxon`'s `from` publishes nothing, every reader
	// below falls back to the whole-program fold, and E3119 refuses the corpus.
	//
	// Empty on a Std-phase function (`createFromStd`) and on a function that declared no parameterized
	// existential, which is very nearly all of them.
	export var valueExistentialInstances as ValueExistentialInstanceMap

	// The generic instance a receiverless static was called through, keyed by the call's RESULT, whether or
	// not the result is that instance (`Parser.retypeGenericAliasConstructorResult`). Published as
	// `valueExistentialInstances` is, and for its reason.
	export var valueCallInstances as ValueCallInstanceMap

	export var literalCastArguments as LiteralCastMap
	export var deferredArgumentBindings as DeferredArgumentBindingArray

	// Every store this function makes into an interface-typed field — see `ExistentialFieldStore`.
	// Handed over at the function's end by the parser (`Parser.publishExistentialInstances`) and
	// appended to by `ModuleInit`.
	export var existentialFieldStores as ExistentialFieldStoreArray

	// `throws E` clause from the declaration; `ThrowsClause.none` for non-throwing.
	export var throwsTypeName as ThrowsClause

	// Persistent per-function symbol table, handed off by the parser. Std-phase
	// functions leave this empty.
	export var scope as Scope

	// --- Std/Target-phase types (populated by LowerMaxonToStd) ---
	export var returnType as StdReturnType
	export var paramTypes as StdTypeArray

	// --- Backend frame-size scalars (zero until the relevant pass runs) ---
	// Total number of slot-addressed variables used by ISel; spill slots sit
	// below the variable area.
	export let varSlotCount as VarSlot

	// Running tally of bytes the function needs on the stack (locals + spills +
	// callee-save area); the cold-spill splitter sets it to its spill-slot bytes,
	// and the prologue/epilogue pass aligns and emits `sub rsp, N`.
	export var stackSize as StackSize

	// Bytes reserved at the bottom of the frame for outgoing call args that
	// overflow the register file.
	export var outgoingArgSize as StackSize

	// ⭐ **THE PER-FUNCTION CLOSURE COUNTER.** The k-th closure literal in this
	// function's body lifts to a top-level function named `<name>$closure_<k>`; `parseClosureExpression`
	// reads this value for `k` and post-increments it. Source-deterministic — the same source mints the
	// same closure names regardless of how many sibling functions parsed before it. Zero for a function
	// with no closures. A closure body threads its OWN lifted `IrFunction` as the enclosing function, so a
	// closure nested inside a closure uses THAT function's counter (`<outer>$closure_0$closure_0`).
	export var closureSubCounter as ClosureSubIndex

	// The parameters this body writes through a receiver-writing method or rebinds by reference
	// (`Parser.noteReceiverWrite`, `Parser.bindParameters`). A field write through the parameter is
	// not one (`Parser.receiverOwnerMask`), so whether the record is written at all is
	// `writesThroughParamMask`'s question. Closed under the call graph by
	// `SemanticCheck.buildParamMutationSummary`. Zero for a Std-phase function.
	export var writtenParamMask as ParamPositionMask

	// The parameters whose record this body writes by any means, a field write included. Seeded at
	// every door that writes through a binding and closed under the record relation by
	// `SemanticCheck.buildParamMutationSummary`. Zero for a Std-phase function.
	export var writesThroughParamMask as ParamPositionMask

	export var needsMutableParamMask as ParamPositionMask
	export var needsFrozenParamMask as ParamPositionMask
	export var resultFromParamMask as ParamPositionMask
	export var resultHasOtherPath as bool
	export var resultMayBeFrozen as bool
	export var resultMayBeUnknown as bool
	export var mayWaitSeed as bool
	export var mayYieldSeed as bool

	export var brandOriginValues as ValueIdArray
	export var brandOriginKeys as NameRoster

	// ⛔⛔ **ANYTHING BUT `parsed`: THE PARSER WALKED PAST THIS BODY WITHOUT BUILDING IT — so NOTHING may be
	// concluded from its ops, and an analysis that reads them is reading an empty function that is not what
	// the source says.** `Parser.skipUnreachedFunctionBody` and `Parser.skipAbandonedBody` leave ONE block
	// holding a bare `retVoid` and no ops at all, which is indistinguishable from a body that genuinely does
	// nothing. An unreached body is opaque to summaries and an abandoned one is unknown
	// (`bodyIsOpaqueToSummaries`).
	//
	// ⛔ MEASURED: read as ops, `Map.remove` — which sets a slot state and decrements a count — classifies
	// EFFECT-FREE whenever the walk has not demanded its body, which refuses `stdlib/Subprocess.maxon`'s own
	// `_ = pending.remove(name)` with E3064. The verdict would then turn on nothing but whether some other
	// call site happened to make the body reachable, which is exactly the kind of answer an analysis must not
	// give.
	export var bodyStatus as BodyStatus

	// The body MOVED into its one call site (`InlineLeaves.spliceWave`) and the original was emptied. Nothing
	// may reach it afterwards: dead-function elimination panics on one it still reaches, because laid out
	// it would be a zero-byte chunk, and an empty `blockRefs` alone reads as an extern.
	export var bodySplicedAway as bool

	// ⭐⭐ **THIS FUNCTION HANDS ITS TUPLE BACK IN THE TWO RETURN REGISTERS** — the THIRD writer of the
	// secondary return slot, beside a throwing function's error flag and an interface-returning one's
	// witness half (`functionUsesSecondaryReturnSlot`).
	//
	// ⚠ **IT IS A FIELD BECAUSE THE DECLARATION CANNOT ANSWER IT.** The other two disjuncts are pure
	// functions of the return type and the `throws` clause; this one is a WHOLE-MODULE verdict — it depends
	// on the body's return shapes, on every call site, and on whether anything takes the address. So it is
	// decided once, by `applyValueTupleReturn`, and recorded here for the readers below the Std tier: wasm's
	// `funcSignatureResultValTypes`, whose functype must declare the second result the body writes or the
	// module does not validate.
	export var usesValueTupleReturn as bool
	export var allocatesParameterCells as bool

	// ⭐⭐ **THE PARAMETERS THIS FUNCTION TAKES BY REFERENCE — an ABI fact.**
	//
	// Bit `i` set iff parameter `i` arrives as the address of a cell rather than as a value: the
	// callee's reads of it are `loadIndirect`s and its `x = 99` a `storeIndirect`, so the write lands
	// in the caller's frame. Every caller of this function must agree, which is why — unlike
	// `writtenParamMask` and `writesThroughParamMask` — it is NOT closed over the call graph here and
	// NOT derived from this body's ops at all.
	//
	// ⚠ **IT IS COPIED DOWN FROM `ProgramSignatures.paramIsByRef`, WHICH IS THE AUTHORITY, AND THAT IS THE
	// WHOLE POINT.** The ABI has to be settled before ANY body is parsed — a caller in another file emits its
	// argument long before this function's own body is read — so the fact is decided by the whole-program
	// declaration sweep and merely RECORDED here, by `Parser.bindParameters`, for the tiers below the parser
	// that cannot reach the sweep. `LowerMaxonToStd` is the reader that needs it: a by-reference `float`
	// parameter carries an ADDRESS, so its machine type is the integer word and not `f64`, and nothing in the
	// declared type says so.
	//
	// ⚠ **DO NOT FEED IT INTO THE `writtenParamMask` FIXPOINT, AND DO NOT DERIVE IT FROM ONE.**
	// Whether a `let` argument is refused is `writtenParamMask`'s question and is deliberately WIDER
	// (it is closed over the call graph from a body's own writes); this is narrower and is not a
	// closure of anything. The two agree on most functions and are different facts.
	//
	// Zero for a Std-phase function and for the overwhelming majority of Maxon ones — on a program that
	// reassigns no parameter it is zero everywhere, which is what makes the feature free.
	export var reassignedParamMask as ParamPositionMask
	export var storedParamMask as ParamPositionMask

	export var letCastReads as LetCastReadArray

	// The parser's shared `FunctionPlaceholders.noPendingOverlaps` until this function files its first
	// E3186 site; a push into the placeholder would file that site on every function sharing it.
	export var pendingOverlaps as PendingOverlapArray

	// ⭐⭐ **THE ENTRY CASCADES `InsertRangeChecks` EMITTED FOR THIS FUNCTION'S NARROWED PARAMETERS** —
	// see `RangeCheckParamGuard`. EMPTY until that pass runs, and empty afterwards for every function with no
	// narrowed parameter; it therefore survives `shallowCopy`/`relocateFunction` as the shared empty by
	// construction, since every relocation happens at or before the lowering and this column is filled after
	// it. Read by `InlineLeaves`, which is the only pass that can prove a cascade dead from OUTSIDE the
	// function it stands in.
	export var paramGuards as RangeCheckParamGuardArray

	// Every body the inliner spliced into this function, indexed by `IrBlock.inlineSite`. Filled by
	// `InlineLeaves` and read by the backends, which emit one code range per run of blocks under a site so
	// a frame printer can name the callee a return address or a faulting instruction sits in.
	export var inlineSites as InlineSiteArray

	// The source bindings the debug-info sidecar describes (see `DebugLocalDecl`), empty unless the
	// build writes one. ⚠ Their ValueIds are this function's own all the way to the register
	// allocator: ids pass through Maxon → Std → Target verbatim, and a spliced callee's are renamed
	// through the splice's value column (`DebugLocalDecl.splicedCopy`). A pass that renumbers values
	// without them leaves a name on another value's location.
	export var debugLocals as DebugLocalDeclArray

	// ⭐ **WHERE EACH OF THOSE BINDINGS' VALUES ENDED UP** — flat, in `debugLocals` order and within each
	// record in its `valueIds` order, spliced home from the backend pool (`spliceBackendUnit`). Kept
	// beside the roster it answers rather than inside it, because the two are filled by tiers a worker-pool
	// boundary apart and only their ORDER can cross it.
	export var debugLocalLocations as DebugValueLocationArray

	// The code each of those values is live over, one row per run. A location is only that value's while
	// the value is live: read past its last use, a register holds whatever was put there next, so a name
	// scoped to the whole function renders another value's bits as confidently as its own.
	export var debugLocalRanges as DebugValueRangeArray

	export var debugLocalSpans as DebugSpanRows

	// Create an IrFunction at the Maxon phase. Maxon-phase type fields are
	// populated; Std-phase fields default. Visibility defaults to `file` so the
	// parser must positively widen it — synthesized functions stay file-private.
	//
	// `valueTags` and `valueNameIds` are taken, not created: the parser has already seeded both with
	// the parameter types before it gets here, and it goes on pushing into them — BY REFERENCE, in
	// lockstep — as the body's values are minted. Constructing empty ones here and having the parser
	// overwrite them at the end of the body would leave dead arrays per function on the heap
	// (`scale-test` charged that exactly: +48 allocations on the smallest rung, doubling with the corpus).
	//
	// ⭐⭐ **`declaredAt` IS REQUIRED, AND THAT IS WHAT MAKES PROVENANCE A CONSTRUCTED FACT RATHER THAN A
	// CONVENTION.** FOUR readers decide behaviour on whether `sourceFilePath` is empty:
	//
	//   * `TargetPrinter.isRuntimeFunction` withholds the green-thread stack guard from the runtime's own
	//     scaffolding.
	//   * `FunctionNameIndex.refuseDuplicateFunctionName` tells an author's declaration (E4015) apart from
	//     an installer that ran twice (a panic).
	//   * `DeadFunctionElimination.markCompilerOwnedRoot` tells those same two apart for a name the
	//     compiler ROOTS rather than emits — the half of that rule with no pair to count.
	//   * `SplitLiveRanges.relievePressure` relieves a full-pool register overflow here instead of REFUSING
	//     it (E5001), because that refusal is an instruction to an author and this function has none — and
	//     the diagnostic cannot even be built for one, every route it chases ending in a parser table.
	//     ⚠ It is the ONE reader that wants the WIDE set rather than `isRuntimeFunction`'s conjunction: a
	//     synthesized builtin body wearing no `__` prefix has no author either.
	//
	// None of the four can be satisfied by a caller's good intentions: hardcoding an empty path here and
	// leaving every caller to overwrite it a few lines later lets a caller that forgets make a
	// PARSED function read as synthesized at ALL FOUR — silently, as a wrong answer rather than a compile
	// error, and the stack-guard one is a MEASURED SIGSEGV. Passing the position in means a
	// caller cannot forget it; it can only decide it, and `SourcePosition.synthesized` is how a synthesizing
	// caller says so out loud.
	//
	// The name and the signature types are the function's own copies: a function rides its file's artifact, and both
	// are often records the signature index holds (`ParseStaging.artifactOwnedOp`).
	export static function create(name ByteArray, maxonReturnType MaxonReturnType, paramCount ParamCount, maxonParamTypes MaxonTypeArray, typeSites DeclaredTypeSites, valueTags ValueTypeTagArray, valueNameIds TypeNameIdArray, valueBrandIds TypeNameIdArray, valueCapabilities ValueCapabilityArray, valueMintedSole BoolArray, valueWitnessIds ValueIdArray, declaredAt SourcePosition, placeholders FunctionPlaceholders, throwsTypeName ThrowsClause = ThrowsClause.none, needsGreenThreadStackGuard bool = false) returns IrFunction
		return Self{
			name: name,
			visibility: Visibility.file,
			needsGreenThreadStackGuard: needsGreenThreadStackGuard,
			layoutReserve: 0,
			closureLayout: ClosureCaptureSource.none,
			closureFixedElementCount: ClosureCaptureSource.none,
			closureEnvFields: ClosureEnvFieldArray.create(0),
			closureStoreSites: ClosureStoreSiteArray.create(0),
			keepsItsOwnFrame: false,
			pinsItsThread: false,
			returnsByIndirectJump: false,
			mustBeSplicedAtEverySite: false,
			sourceFilePath: declaredAt.filePath,
			paramCount: paramCount,
			blockRefs: BlockRefArray.create(0),
			nextBlockId: 0,
			nameLine: declaredAt.line,
			nameColumn: declaredAt.column,
			closeLine: declaredAt.line,
			closeColumn: declaredAt.column,
			maxonReturnType: maxonReturnType.clone(),
			maxonParamTypes: maxonParamTypes.clone(),
			typeSites: typeSites,
			valueTags: valueTags,
			valueNameIds: valueNameIds,
			valueBrandIds: valueBrandIds,
			valueCapabilities: valueCapabilities,
			capabilityNotes: placeholders.noCapabilityNotes,
			valueMintedSole: valueMintedSole,
			valueWitnessIds: valueWitnessIds,
			valueExistentialInstances: ValueExistentialInstanceMap.create(),
			valueCallInstances: ValueCallInstanceMap.create(),
			literalCastArguments: placeholders.noLiteralCastArguments,
			deferredArgumentBindings: DeferredArgumentBindingArray.create(0),
			existentialFieldStores: ExistentialFieldStoreArray.create(0),
			throwsTypeName: throwsTypeName,
			scope: Scope.create(),
			returnType: StdReturnType.void,
			paramTypes: StdTypeArray.create(0),
			varSlotCount: 0,
			stackSize: 0,
			outgoingArgSize: 0,
			closureSubCounter: 0,
			writtenParamMask: 0,
			reassignedParamMask: 0,
			storedParamMask: 0,
			writesThroughParamMask: 0,
			needsMutableParamMask: 0,
			needsFrozenParamMask: 0,
			resultFromParamMask: 0,
			resultHasOtherPath: false,
			resultMayBeFrozen: false,
			resultMayBeUnknown: false,
			mayWaitSeed: false,
			mayYieldSeed: false,
			brandOriginValues: ValueIdArray.create(0),
			brandOriginKeys: NameRoster.create(0),
			bodyStatus: BodyStatus.parsed,
			bodySplicedAway: false,
			usesValueTupleReturn: false,
			allocatesParameterCells: false,
			letCastReads: placeholders.noLetCastReads,
			pendingOverlaps: placeholders.noPendingOverlaps,
			ownership: ColumnOwnership.nothing(),
			paramGuards: placeholders.paramGuards,
			inlineSites: placeholders.inlineSites,
			debugLocals: DebugLocalDeclArray.create(0),
			debugLocalLocations: DebugValueLocationArray.create(0),
			debugLocalRanges: DebugValueRangeArray.create(0),
			debugLocalSpans: DebugSpanRows.create()
		}
	end 'create'

	// Create an IrFunction at the Std phase or later. Std-phase type fields are
	// populated; Maxon-phase fields default. Used by the runtime installers and the entry stubs — every
	// caller synthesizes a helper and wants it callable from anywhere, so visibility defaults to `global`.
	//
	// ⚠ **NO PARSED FUNCTION COMES THROUGH THIS DOOR, and that is load-bearing rather than incidental**:
	// the position is `SourcePosition.synthesized()`, and `FunctionNameIndex.refuseDuplicateFunctionName` reads exactly
	// that to tell an author's declaration apart from a symbol the compiler emitted (as `TargetPrinter.
	// isRuntimeFunction` reads it for the GT stack-guard exemption). Unlike `create`, this door takes no
	// position argument, because there is no caller it could come from: every one of them synthesizes.
	//
	// `needsGreenThreadStackGuard` defaults to false because most callers here install a runtime primitive
	// whose frame and nesting the runtime itself bounds. The per-type CASCADES come through this same door and
	// do not — see the field.
	//
	// ⛔⛔ **ITS MANAGED PLACEHOLDERS ARE FRESH, WHERE `create`'s ARE ITS CALLER'S SHARED ONES — AND THAT IS A
	// CONCURRENCY FACT, NOT AN OVERSIGHT.** This door is on the POOL WORKER path: `extractUnitModule` builds one
	// function per message, and a worker runs on whichever green thread the scheduler picked. Storing a
	// module-level record into a fresh one RETAINS it, and a counted record's reference count is a plain
	// load/add/store precisely because one green thread owns it — so sixteen workers retaining and releasing ONE
	// singleton is a lost update. Small empties per call, on a door the parser never takes (`create` is the
	// parser's, and it shares its own `FunctionPlaceholders` across its thousands of functions).
	export static function createFromStd(name ByteArray, returnType StdReturnType, paramCount ParamCount, paramTypes StdTypeArray, throwsTypeName ThrowsClause = ThrowsClause.none, needsGreenThreadStackGuard bool = false, pinsItsThread bool = false) returns IrFunction
		let declaredAt = SourcePosition.synthesized()
		return Self{
			name: name,
			visibility: Visibility.global,
			needsGreenThreadStackGuard: needsGreenThreadStackGuard,
			layoutReserve: 0,
			closureLayout: ClosureCaptureSource.none,
			closureFixedElementCount: ClosureCaptureSource.none,
			closureEnvFields: ClosureEnvFieldArray.create(0),
			closureStoreSites: ClosureStoreSiteArray.create(0),
			keepsItsOwnFrame: false,
			pinsItsThread: pinsItsThread,
			returnsByIndirectJump: false,
			mustBeSplicedAtEverySite: false,
			sourceFilePath: declaredAt.filePath,
			paramCount: paramCount,
			blockRefs: BlockRefArray.create(0),
			nextBlockId: 0,
			nameLine: declaredAt.line,
			nameColumn: declaredAt.column,
			closeLine: declaredAt.line,
			closeColumn: declaredAt.column,
			maxonReturnType: MaxonReturnType.void,
			maxonParamTypes: MaxonTypeArray.create(0),
			typeSites: DeclaredTypeSites.create(),
			valueTags: ValueTypeTagArray.create(0),
			valueNameIds: TypeNameIdArray.create(0),
			valueBrandIds: TypeNameIdArray.create(0),
			valueCapabilities: ValueCapabilityArray.create(0),
			capabilityNotes: CapabilityNotes.create(),
			valueMintedSole: BoolArray.create(0),
			valueWitnessIds: ValueIdArray.create(0),
			valueExistentialInstances: ValueExistentialInstanceMap.create(),
			valueCallInstances: ValueCallInstanceMap.create(),
			literalCastArguments: LiteralCastMap.create(),
			deferredArgumentBindings: DeferredArgumentBindingArray.create(0),
			existentialFieldStores: ExistentialFieldStoreArray.create(0),
			throwsTypeName: throwsTypeName,
			scope: Scope.create(),
			returnType: returnType,
			paramTypes: paramTypes,
			varSlotCount: 0,
			stackSize: 0,
			outgoingArgSize: 0,
			closureSubCounter: 0,
			writtenParamMask: 0,
			reassignedParamMask: 0,
			storedParamMask: 0,
			writesThroughParamMask: 0,
			needsMutableParamMask: 0,
			needsFrozenParamMask: 0,
			resultFromParamMask: 0,
			resultHasOtherPath: false,
			resultMayBeFrozen: false,
			resultMayBeUnknown: false,
			mayWaitSeed: false,
			mayYieldSeed: false,
			brandOriginValues: ValueIdArray.create(0),
			brandOriginKeys: NameRoster.create(0),
			bodyStatus: BodyStatus.parsed,
			bodySplicedAway: false,
			usesValueTupleReturn: false,
			allocatesParameterCells: false,
			letCastReads: LetCastReadArray.create(0),
			pendingOverlaps: PendingOverlapArray.create(0),
			paramGuards: RangeCheckParamGuardArray.create(0),
			inlineSites: InlineSiteArray.create(0),
			debugLocals: DebugLocalDeclArray.create(0),
			debugLocalLocations: DebugValueLocationArray.create(0),
			debugLocalRanges: DebugValueRangeArray.create(0),
			debugLocalSpans: DebugSpanRows.create()
		}
	end 'createFromStd'

	// A SHALLOW copy of the signature + type info, with a fresh-empty `blockRefs`.
	// Deliberately NOT a clone: `maxonParamTypes`, `paramTypes` and `scope` are
	// SHARED with `src` by reference, because no consumer mutates them in place.
	// Only `blockRefs` is fresh — callers that need the source's block references
	// must carry them over explicitly, and that empty-list contract is what
	// `relocateFunction` (and the backends that rebuild `blockRefs` themselves)
	// rely on. See `relocateFunction` for the variant that preserves them, shifted
	// by a block offset.
	export static function shallowCopy(src IrFunction) returns IrFunction
		return Self{
			name: src.name,
			visibility: src.visibility,
			// A copy is the same code with the same stack behaviour, so the claim TRAVELS rather than being
			// re-decided here — exactly as `sourceFilePath` does one line down, and for the same reason.
			needsGreenThreadStackGuard: src.needsGreenThreadStackGuard,
			layoutReserve: src.layoutReserve,
			closureLayout: src.closureLayout,
			closureFixedElementCount: src.closureFixedElementCount,
			closureEnvFields: src.closureEnvFields,
			closureStoreSites: src.closureStoreSites,
			keepsItsOwnFrame: src.keepsItsOwnFrame,
			pinsItsThread: src.pinsItsThread,
			returnsByIndirectJump: src.returnsByIndirectJump,
			mustBeSplicedAtEverySite: src.mustBeSplicedAtEverySite,
			sourceFilePath: src.sourceFilePath,
			paramCount: src.paramCount,
			blockRefs: BlockRefArray.create(0),
			nextBlockId: src.nextBlockId,
			nameLine: src.nameLine,
			nameColumn: src.nameColumn,
			closeLine: src.closeLine,
			closeColumn: src.closeColumn,
			maxonReturnType: src.maxonReturnType,
			maxonParamTypes: src.maxonParamTypes,
			typeSites: src.typeSites,
			valueTags: src.valueTags,
			debugLocals: src.debugLocals,
			debugLocalLocations: src.debugLocalLocations,
			debugLocalRanges: src.debugLocalRanges,
			debugLocalSpans: src.debugLocalSpans,
			valueNameIds: src.valueNameIds,
			valueBrandIds: src.valueBrandIds,
			valueCapabilities: src.valueCapabilities,
			capabilityNotes: src.capabilityNotes,
			valueMintedSole: src.valueMintedSole,
			valueWitnessIds: src.valueWitnessIds,
			valueExistentialInstances: src.valueExistentialInstances,
			valueCallInstances: src.valueCallInstances,
			literalCastArguments: src.literalCastArguments,
			deferredArgumentBindings: src.deferredArgumentBindings,
			existentialFieldStores: src.existentialFieldStores,
			throwsTypeName: src.throwsTypeName,
			scope: src.scope,
			returnType: src.returnType,
			paramTypes: src.paramTypes,
			varSlotCount: src.varSlotCount,
			stackSize: src.stackSize,
			outgoingArgSize: src.outgoingArgSize,
			closureSubCounter: src.closureSubCounter,
			writtenParamMask: src.writtenParamMask,
			reassignedParamMask: src.reassignedParamMask,
			storedParamMask: src.storedParamMask,
			writesThroughParamMask: src.writesThroughParamMask,
			needsMutableParamMask: src.needsMutableParamMask,
			needsFrozenParamMask: src.needsFrozenParamMask,
			resultFromParamMask: src.resultFromParamMask,
			resultHasOtherPath: src.resultHasOtherPath,
			resultMayBeFrozen: src.resultMayBeFrozen,
			resultMayBeUnknown: src.resultMayBeUnknown,
			mayWaitSeed: src.mayWaitSeed,
			mayYieldSeed: src.mayYieldSeed,
			brandOriginValues: src.brandOriginValues,
			brandOriginKeys: src.brandOriginKeys,
			bodyStatus: src.bodyStatus,
			bodySplicedAway: src.bodySplicedAway,
			usesValueTupleReturn: src.usesValueTupleReturn,
			allocatesParameterCells: src.allocatesParameterCells,
			letCastReads: src.letCastReads,
			pendingOverlaps: src.pendingOverlaps,
			ownership: ColumnOwnership.nothing(),
			// NOT carried, and it cannot need to be: every copy of a function is made at or before the
			// lowering (`relocateFunction` is `IrModule.merge`'s), and this column is filled by
			// `InsertRangeChecks`, which runs after the last of them. A copy that carried it would carry
			// BLOCK IDS into a function whose blocks the copy has yet to be given.
			paramGuards: src.paramGuards if src.paramGuards.isEmpty() else RangeCheckParamGuardArray.create(0),

			// Not carried either: the table is filled by the inliner, which also runs after the last copy, and
			// its entries are meaningful only against the blocks that name them.
			inlineSites: src.inlineSites if src.inlineSites.isEmpty() else InlineSiteArray.create(0)
		}
	end 'shallowCopy'

	export function mayCarryADescriptor() returns bool
		return self.layoutReserve != 0
	end 'mayCarryADescriptor'

	export function reservesConditionalWitnesses() returns bool
		return self.layoutReserve > LayoutSlotWidth
	end 'reservesConditionalWitnesses'

	export function resultIsUnknown() returns bool
		return self.bodyStatus == BodyStatus.abandoned or self.resultMayBeUnknown
	end 'resultIsUnknown'

	export function surrenderColumns()
		self.ownership = ColumnOwnership.nothing()
	end 'surrenderColumns'

	// The one door a post-parse write of a shared column goes through. A function shares its
	// columns with the parse artifact it was copied from (`shallowCopy`) or with its parser's
	// placeholders, and a write into either would outlive this compile, so the first writer takes a
	// private copy. `valueColumns` are copied together because they are read in lockstep.
	export function makePrivate(column SharedColumn)
		if self.ownership.owns(column) 'alreadyPrivate'
			return
		end 'alreadyPrivate'

		match column 'column'
			valueColumns then self.cloneValueColumns()
			literalCasts then self.literalCastArguments = self.literalCastArguments.clone()
			debugLocals then self.debugLocals = heldDebugLocalsCopy(self.debugLocals)
			paramGuards then self.paramGuards = self.paramGuards.clone()
			inlineSites then self.inlineSites = self.inlineSites.clone()
			closureStoreSites then self.closureStoreSites = self.closureStoreSites.clone()
		end 'column'

		self.ownership = self.ownership.claiming(column)
	end 'makePrivate'

	function cloneValueColumns()
		self.valueTags = self.valueTags.clone()
		self.valueNameIds = self.valueNameIds.clone()
		self.valueBrandIds = self.valueBrandIds.clone()
		self.valueCapabilities = self.valueCapabilities.clone()
		self.valueMintedSole = self.valueMintedSole.clone()
	end 'cloneValueColumns'

	export function moveLiteralCast(from ValueId, to ValueId)
		if not self.literalCastArguments.contains(from) 'noCastToMove'
			return
		end 'noCastToMove'

		self.makePrivate(SharedColumn.literalCasts)
		moveLiteralCastEntry(self.literalCastArguments, from: from, to: to)
	end 'moveLiteralCast'

	export function replaceDebugLocal(position ElementIndex, local DebugLocalDecl)
		self.makePrivate(SharedColumn.debugLocals)
		try self.debugLocals.set(position, value: local) otherwise panic("IrFunction.replaceDebugLocal: debugLocals.set OOB at {position} of {self.debugLocals.count()} in '{String.from(self.name)}'")
	end 'replaceDebugLocal'

	// Renumber every type id this function holds (`ParseStaging.rewriteTypeIds`): its signature, its
	// per-value columns, the existential instances its values carry, and the declared types its debug
	// locals were recorded under. The columns are rebuilt
	// rather than written into, because the merged module's copy of this function shares them.
	export function renumberTypeIds(remap TypeIdRemap)
		self.maxonReturnType = remapMaxonReturnType(self.maxonReturnType, remap: remap)
		self.maxonParamTypes = remapMaxonTypes(self.maxonParamTypes, remap: remap)

		// Tag-aware, in lockstep with `valueTags`, which no renumbering moves: a scalar slot keeps its
		// `UnnamedTypeId` filler (see `remapValueNameId`).
		let nameIds = TypeNameIdArray.create(self.valueNameIds.count(), zeroed: false)

		for position in 0 upto self.valueNameIds.count() 'eachValue'
			let tag = try self.valueTags.get(position) otherwise panic("IrFunction.renumberTypeIds: valueTags.get OOB at {position} — the two type columns fell out of lockstep")
			let nameId = try self.valueNameIds.get(position) otherwise panic("IrFunction.renumberTypeIds: valueNameIds.get OOB at {position}")
			nameIds.push(remapValueNameId(tag, nameId: nameId, remap: remap))
		end 'eachValue'

		self.valueNameIds = nameIds

		// Interner ids throughout — `UnnamedTypeId` included, the empty name in every interner — so no tag is asked.
		let brandIds = TypeNameIdArray.create(self.valueBrandIds.count(), zeroed: false)

		for brandId in self.valueBrandIds 'eachBrand'
			brandIds.push(remap.applyName(brandId))
		end 'eachBrand'

		self.valueBrandIds = brandIds

		let existentials = ValueExistentialInstanceMap.create()

		for (value, instance) in self.valueExistentialInstances 'eachExistential'
			existentials.upsert(value, value: remap.applyInstance(instance))
		end 'eachExistential'

		self.valueExistentialInstances = existentials

		if self.valueCallInstances.count() > 0 'callsThroughAnInstance'
			let callInstances = ValueCallInstanceMap.create()

			for (value, instance) in self.valueCallInstances 'eachCallInstance'
				callInstances.upsert(value, value: remap.applyInstance(instance))
			end 'eachCallInstance'

			self.valueCallInstances = callInstances
		end 'callsThroughAnInstance'

		if self.existentialFieldStores.count() > 0 'storesIntoAnInterfaceField'
			let stores = ExistentialFieldStoreArray.create(self.existentialFieldStores.count(), zeroed: false)

			for store in self.existentialFieldStores 'eachStore'
				stores.push(store.withClaimsRenumbered(remap))
			end 'eachStore'

			self.existentialFieldStores = stores
		end 'storesIntoAnInterfaceField'

		for local in self.debugLocals 'eachDebugLocal'
			local.renumberTypeIds(remap)
		end 'eachDebugLocal'

		let captures = ClosureEnvFieldArray.create(self.closureEnvFields.count(), zeroed: false)

		for capture in self.closureEnvFields 'eachCapture'
			captures.push(capture.withTypeRenumbered(remap))
		end 'eachCapture'

		self.closureEnvFields = captures
	end 'renumberTypeIds'

	// RELOCATION, not copying: a shallow copy that also carries the source's
	// `blockRefs` across, shifting each by `blockOffset` (0 = verbatim). The shift is
	// the whole point — `IrModule.merge` appends a source module's blocks after the
	// destination's, so every ref into them moves by the destination's prior block
	// count. Offset 0 serves a backend that needs the function to keep pointing at the
	// source's body blocks in place.
	export static function relocateFunction(src IrFunction, blockOffset ElementIndex = 0) returns IrFunction
		let relocated = IrFunction.shallowCopy(src)

		for blockRef in src.blockRefs 'eachBlock'
			relocated.blockRefs.push(blockRef + blockOffset)
		end 'eachBlock'

		return relocated
	end 'relocateFunction'

	export function declarationSite() returns immutable ByteArray
		return declarationSiteKey(self.sourceFilePath, line: self.nameLine, column: self.nameColumn)
	end 'declarationSite'

	export function recordParamGuard(index ParamCount, alias RangedTypeAlias, headBlockId BlockId, okBlockId BlockId, ownedBlockIds BlockIdArray)
		self.makePrivate(SharedColumn.paramGuards)
		self.paramGuards.push(RangeCheckParamGuard.create(index, alias: alias, headBlockId: headBlockId, okBlockId: okBlockId, ownedBlockIds: ownedBlockIds))
	end 'recordParamGuard'

	// Record one splice into this function and answer the site its copied blocks carry.
	export function recordInlineSite(site InlineSite) returns InlineSiteRef
		self.makePrivate(SharedColumn.inlineSites)

		let index = self.inlineSites.count()
		self.inlineSites.push(site)
		return InlineSiteRef.site(index)
	end 'recordInlineSite'

	export function recordSplicedLocal(local DebugLocalDecl)
		self.makePrivate(SharedColumn.debugLocals)
		self.debugLocals.push(local)
	end 'recordSplicedLocal'

	export function keepsSoleOwnerMarks() returns bool
		return self.valueMintedSole.count() == self.valueTags.count()
	end 'keepsSoleOwnerMarks'

	export function noteClosureStoreSite(site ClosureStoreSite)
		self.makePrivate(SharedColumn.closureStoreSites)
		self.closureStoreSites.push(site)
	end 'noteClosureStoreSite'

	export function releaseMaxonTierData(emptyScope Scope)
		// ⛔ `maxonReturnType` is NOT released, and it is the one field here that may not be.
		// `irFunctionUsesSecondaryReturnSlot` reads it for wasm's `funcSignatureResultValTypes`, which runs in
		// the BACKEND — so a released reading of `void` declares a functype with one result for a body that
		// writes two, and the module fails validation. It answers `void` rather than failing, so nothing
		// catches it on a target whose ABI never asks: x64 passes the pair in registers and stays green.
		self.maxonParamTypes = MaxonTypeArray.create(0)
		self.valueTags = ValueTypeTagArray.create(0)
		self.valueNameIds = TypeNameIdArray.create(0)
		self.valueBrandIds = TypeNameIdArray.create(0)
		self.valueCapabilities = ValueCapabilityArray.create(0)
		self.capabilityNotes = CapabilityNotes.create()
		self.valueMintedSole = BoolArray.create(0)
		self.valueWitnessIds = ValueIdArray.create(0)
		self.valueExistentialInstances = ValueExistentialInstanceMap.create()
		self.valueCallInstances = ValueCallInstanceMap.create()
		self.literalCastArguments = LiteralCastMap.create()
		self.letCastReads = LetCastReadArray.create(0)
		self.pendingOverlaps = PendingOverlapArray.create(0)
		self.deferredArgumentBindings = DeferredArgumentBindingArray.create(0)
		self.existentialFieldStores = ExistentialFieldStoreArray.create(0)
		self.ownership = ColumnOwnership.nothing()

		// No Std or backend pass reads `scope`. It is replaced rather than reset because `shallowCopy`
		// shares it with the parse artifact.
		self.scope = emptyScope
	end 'releaseMaxonTierData'

	export function isCompilerBuilt() returns bool
		return self.sourceFilePath.isEmpty()
	end 'isCompilerBuilt'

