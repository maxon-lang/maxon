export typealias IrFunctionArray = Array with IrFunction

// @generated library-cache begin
export function cacheWriteIrFunctionArray(writer LibraryCacheWriter, value IrFunctionArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteIrFunctionArray'

export function cacheReadIrFunctionArray(reader LibraryCacheReader) returns IrFunctionArray throws LibraryCacheDamage
	let count = try reader.count()
	let result = IrFunctionArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try IrFunction.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadIrFunctionArray'

