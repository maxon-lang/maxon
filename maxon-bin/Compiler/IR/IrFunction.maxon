	// A zero-copy slice of the source, straight off the declaring token. It stays bytes all
	// the way to the COFF symbol table, which writes it as bytes anyway.
	export let name as immutable ByteArray

	// ⛔ **AN `IrFunction` CARRIES NO NAMESPACE, AND MUST NOT GROW ONE.** A `dir.fn()` reference is resolved
	// at PARSE time, against `ProgramSignatures.namespaceQualifiedFunctions`, and it resolves to the
	// function's registered name (its `<dir>~` mint where a second directory declares the name) — so by
	// the time an `IrFunction` exists there is no namespace left to consult. The authoritative copy of a file's directory
	// is `ProgramSignatures.fileModuleDirectories`, keyed by the path every asker already holds, and unlike
	// a per-function mirror it is the INVERTIBLE `/`-joined form a visibility question may actually be
	// asked of.
	// ⭐ **THE VISIBILITY TIER THE DECLARATION WROTE — READ by the call door**
	// (`SemanticCheck.calleeVisibleFrom` ⇒ E3008 / E3088).
	export var visibility as Visibility

	// Absolute / virtual path of the declaring file — the visibility anchor for
	// cross-file callers. Empty for synthesized functions.
	export var sourceFilePath as FilePath
	export var paramCount as ParamCount
	export var blockRefs as BlockRefArray
	export var nextBlockId as BlockId

	// Line and column of the function-name token; zero for synthesized functions.
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export var closeLine as LineNumber
	export var closeColumn as ColumnNumber

