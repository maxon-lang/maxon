	let result = ValueExistentialInstanceMap.create()

	for _ in 0 upto count 'eachEntry'
		let key = (try reader.unsigned()) as ValueId
		let entry = (try reader.unsigned()) as GenericInstanceId
		result.upsert(key, value: entry)
	end 'eachEntry'

	return result
end 'cacheReadValueExistentialInstanceMap'

// @generated library-cache end

