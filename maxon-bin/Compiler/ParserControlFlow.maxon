extension Parser
	// ⭐ **THE ERROR EDGE OF `if try …` / `if let x = try …`, WHICH IS ALSO ITS `else` BRANCH.** It owns the
	// caught error end to end, exactly as `parseOtherwiseBlock` owns an `otherwise` handler's: the error is
	// enrolled as an owned binding — NAMED by an `else (e)` binder, ANONYMOUS otherwise — and released on
	// whichever edge leaves the branch (`dropArmScopedOwned`: a decref on a live fall-through, the
	// terminating statement's own scope drops on a `return`/`throw`).
	//
	// ⭐ **IT RUNS EVEN WHEN NO `else` IS WRITTEN**, because the error edge exists either way and a caught box
	// has to die on it. With nothing written the branch is empty: the release is all it holds and it falls
	// straight through to the merge, carrying the entry values the caller already restored.
	function parseCatchingElseBody(func IrFunction, elseBlock IrBlock, flag ValueId, errorType MaxonType, form CaughtErrorForm, join SentLegJoin, ifTok Token, ifEnd ElementIndex) returns IrBlock throws SourceParseError
		let elseWritten = self.at(TokenKind.else)
		let ownedFloor = self.bodyState.ownedBindings.count()
		let handlerDebugFloor = self.bodyState.debugOpenSlots.count()
		self.bodyState.scope.pushScope()

		// With no `else` written there is no token on this branch to anchor its release to, so the `if` that
		// caught the error is what the drop is attributed to — the construct a reader would look at to ask
		// where the error went. With an `else` but no binder it is the token after `else`.
		var binder = CaughtErrorBinder.anonymous(ifTok)

		if elseWritten 'openElse'
			try self.consume(TokenKind.else)

			// `else (e) 'err'` — the caught error, named. The same OPTIONAL binder a divergent `otherwise`
			// spells, parsed by the same routine, because it is the same grammar over the same caught flag.
			binder = try self.parseOptionalCaughtErrorBinder(self.current())
		end 'openElse'

		// The decode (and, for a boxed error, the enrolment) belongs at the TOP of the error edge — before a
		// nested `else if`'s own condition, and before the written body's first statement.
		self.joinSentLeg(join, errBlock: elseBlock)
		self.bodyState.currentBlock = elseBlock
		try self.declareCaughtError(flag, errorType: errorType, binder: binder, form: form)
		self.settleCaughtCombinedError(func, binder: binder, form: form, flag: flag)

		var elseEnd = self.bodyState.currentBlock

		if elseWritten 'writtenBody'
			elseEnd = try self.parseElseBranchBody(func, elseBlock: elseEnd, ifEnd: ifEnd)
		end 'writtenBody'

		self.bodyState.scope.popScope()
		self.closeDebugScopesAbove(handlerDebugFloor, endsIn: elseEnd)
		self.dropArmScopedOwned(ownedFloor, exitBlock: elseEnd, anchor: binder.anchor)

		if errorUnionIsSynthesized(caughtErrorUnionMatch(form)) 'aCombinedError'
			try self.requireNoHeldErrorMatchRefusal()
		end 'aCombinedError'

		return elseEnd
	end 'parseCatchingElseBody'

	// `if let x = try …` / `if var x = try …` — the optional success binder in front of the condition.
	// `let`/`var` here declares exactly what it declares at statement level, and goes through the same
	// `declareInitializedBinding`; only the initializer differs, and it is not optional. The binding names
	// the value a `try` PRODUCED, so `parseIfCondition` requires `try` after the `=` — and a
	// `if let x = 5 'l'` is refused there by the ordinary "expected `try`" mismatch rather than by a rule of
	// its own.
	function parseIfBinder() returns IfBinder throws SourceParseError
		if not bindingKeywordSpells(self.current().kind) 'noBinder'
			return IfBinder.none
		end 'noBinder'

		let keywordTok = self.current()
		try self.consume(keywordTok.kind)
		let nameIndex = self.pos
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.consume(TokenKind.equals)
		return IfBinder.binding(nameIndex, kind: bindingKindOfKeyword(keywordTok.kind))
	end 'parseIfBinder'

	// ⭐⭐ **THE `if`'s CONDITION SLOT HAS TWO SHAPES, AND THE TOKEN AFTER `if` DECIDES WHICH:**
	//   • `if <expr>`                  — an ordinary bool condition; the then branch runs when it is true.
	//   • `if try <call>`              — a CATCHING try; the then branch runs when the call did NOT throw.
	//   • `if let/var x = try <call>`  — the same, with the success value bound in the then branch.
	//
	// ⭐ **THE CATCHING FORM IS RECOGNIZED LEXICALLY, HERE — NOT BY A PARSER MODE THREADED THROUGH THE
	// WHOLE EXPRESSION GRAMMAR.** Such a mode would be an `inIfCondition` field around the condition
	// parse, handing back a `tryCondition` from wherever inside the expression the `try` happened to
	// sit, saved and restored so a nested `if` in the body could not leak it back out. No mode is
	// needed, because the language admits the catching `try` in exactly ONE position — first in the
	// condition slot — and a mode that can fire anywhere is answerable for every position it can
	// reach: `if a and try f()` would have silently become "a, and f did not throw", a meaning no spec
	// grants it. Asked at the one position it is legal, the grammar states its own boundary, and the
	// propagating `try` keeps every other position it had.
	function parseIfCondition(func IrFunction, block IrBlock, ifTok Token, binder IfBinder) returns IfCondition throws SourceParseError
		self.bodyState.operandOrder.restart()

		match binder 'b'
			none then break
			binding then return try self.parseCatchingCondition(func, block: block, binder: binder)
		end 'b'

		if self.at(TokenKind.try) 'bareCatch'
			return try self.parseCatchingCondition(func, block: block, binder: binder)
		end 'bareCatch'

		return IfCondition.plain(try self.parseBoolCondition(func, block: block, kwTok: ifTok))
	end 'parseIfCondition'

	// **E3124 — THE BARE `if try <call>` MAY ONLY TEST A CALL THAT RETURNS NOTHING.** The form is a
	// THROW test: the then branch runs whenever the call did not throw, whatever it produced. So a
	// callee with a result has that result dropped here, while the source reads as though the result
	// were the thing being tested — `if try json.getBool(node, key: "enabled")` reads as *"if
	// enabled"* and means *"if the key exists and is a bool"*, which is TRUE when the stored value is
	// `false`. Without the refusal, `answer(succeed bool) returns bool throws MyError` returning
	// `false` on its SUCCESS path still takes the branch.
	//
	// ⭐ **ONE LAW, NOT A TYPE-KEYED ONE.** The refusal is on "the call produces a value", not on "the value
	// is a bool": a `bool` is only where the misreading is loudest, and a rule keyed to it would leave every
	// other type silently dropping its result. What survives is the form's honest use — a void-returning
	// throwing call, "run this, branch on whether it worked".
	//
	// The `_` binding needs no arm on THAT side: `if let _ = try f()` has SAID what happens to the result,
	// which is all this rule asks. Whether a PURE callee may be discarded that way is E3064's question, and
	// THIS DOOR does not ask it. ⚠ The classification exists (`buildEffectFreeSummary`) and
	// exactly one door consults it (the all-discard tuple assignment); wiring this one is a scope decision,
	// not a missing mechanism (see specs/discarded-results.md).
	//
	// ⭐⭐ **AND THE DUAL, WHICH IS THE SAME QUESTION FROM THE OTHER SIDE: `if let x = try voidF()`
	// BINDS A VALUE THE CALL DOES NOT PRODUCE (E3059).** A binding is a VALUE POSITION, so this is
	// precisely the fault `parseTry`'s `voidInValue` guard already refuses — same code, same sentence,
	// same anchor. It is asked here because `parseCatchingCondition` shares the try-call REWRITE with
	// the expression form but not the question about the rewrite's RESULT. Unasked, this PANICS in
	// `maxonTypeOfTag` (*"a `void` tag names no value"*) by way of `parseBoundThenBody` →
	// `declareInitializedBinding` → `typeOf`. `_` is not exempt from this half: it discards a result,
	// and here there is no result to discard.
	//
	// Both halves are one question about what the call produces, so they are asked in one place.
	// ⚠ The noun is built INSIDE each throw and not once above them, because this routine runs on every
	// `if try` parsed and `tryTargetNoun` + `String.from` allocate: the two refusals are cold, and a
	// diagnostic's words must not be paid for by the programs that have nothing wrong with them.
	function requireCaughtResultIsSpokenFor(result ValueId, target TryTarget, binder IfBinder, tryTok Token) throws SourceParseError
		match target 'kind'
			deferred then return
			named or
			witness or
			promise or
			send or
			serviceReply or
			serviceStart or
			sentReply then break
		end 'kind'

		let producesNothing = self.tagOf(result) == ValueTypeTag.void
		let bound = match binder 'b'
			none gives false
			binding gives true
		end 'b'

		if bound and producesNothing 'boundNothing'
			throw tryTargetProducesNoValueError(target, signatures: self.signatures, tryTok: tryTok)
		end 'boundNothing'

		if not bound and not producesNothing 'droppedSomething'
			throw SourceParseError.ifTryDiscardsResult(String.from(tryTargetNoun(target, signatures: self.signatures)), line: tryTok.line, column: tryTok.column)
		end 'droppedSomething'
	end 'requireCaughtResultIsSpokenFor'

	// ⭐ **`try <call>` IN A CONDITION: THE CALL IS REWRITTEN EXACTLY AS AN EXPRESSION `try` REWRITES IT, AND
	// THEN THE `if` — NOT `desugarTry` — OWNS THE FORK.** `parseTryCallTarget` + `rewriteLastCallToTryCall` +
	// `requireThrowingTryTarget` are the SAME three steps `parseTry` runs, so every try target shape (a free
	// call, a method, a field chain, a witness dispatch, `try await p`, a literal receiver) and every refusal
	// (E3055 on a non-throwing callee, E2015 on a non-call) reaches a condition unchanged and cannot drift
	// from the expression form. What is NOT run is `desugarTry`: its `flag != 0` split, error block, handler
	// and merge are precisely what the `if` already is, and building both would fork twice.
	//
	// What IS this form's own is `requireCaughtResultIsSpokenFor` above — the binder/result agreement, in
	// both directions. Only a CONDITION can drop the call's result without saying so (E3124), and only a
	// condition reaches a binding through a path the expression form's void guard never ran on (E3059).
	//
	// The test is `flag == 0` — TRUE on the success path — so the then branch is the ok edge and the else
	// branch the error edge, with no swapping anywhere downstream.
	function parseCatchingCondition(func IrFunction, block IrBlock, binder IfBinder) returns IfCondition throws SourceParseError
		self.bodyState.currentBlock = block
		let tryTok = try self.consume(TokenKind.try)

		let targetOpFloor = self.artifact.module.ops.count()
		let targetDeferralFloor = self.artifact.deferredChains.count()
		self.statement.lastBareBindingImmutableName = EmptySourceText
		let result = try self.parseTryCallTarget(func)
		let (target, flag) = try self.rewriteLastCallToTryCall(result, tryTok: tryTok, targetDeferralFloor: targetDeferralFloor, targetOpFloor: targetOpFloor)
		let leg = self.statement.takeSentLeg()
		try self.requireThrowingTryTarget(target, tryTok: tryTok)
		try self.requireCaughtResultIsSpokenFor(result, target: target, binder: binder, tryTok: tryTok)
		self.recordCatchingDiscard(binder, opFloor: targetOpFloor)

		// The success value is owned on the then edge alone, so it leaves the pending list here, as it
		// does at `openTryFork`: on the error edge its register is NULL, and `parseIfStatement` drains
		// the condition's temporaries into the entry block both edges flow from. Whenever it was pending
		// (see `takeOffPendingTemps`), `parseIfThenBody` re-homes it onto the binding, or onto a drop of
		// its own when the boolean form discards it.
		let resultWasPending = self.takeOffPendingTemps(result)
		let test = self.emitErrorFlagTest(flag, op: MaxonCmpOp.eq, anchor: tryTok)
		let handlerFused = self.handlerFusedOrdinal(leg, handlerFlag: flag, anchor: tryTok)
		let joined = self.mintJoinedError(leg, handlerFlag: flag)
		let join = SentLegJoin.create(leg, entryBlockId: self.bodyState.currentBlock.id, handlerFlag: flag, handlerFused: handlerFused, joined: joined)
		return IfCondition.tryCatch(test, result: result, resultWasPending: resultWasPending, flag: joined.flag, errorType: self.tryErrorEnumType(self.tryTargetThrows(target)), form: self.caughtErrorFormFor(target, fused: joined.fused), join: join)
	end 'parseCatchingCondition'

	// ⭐⭐ **`if let _ = try f()` IS AN EXPLICIT DISCARD, AND A PURE CALLEE'S RESULT MAY NOT BE ONE (E3064).**
	// The binder says the author saw the result and chose to drop it — precisely what `_ = f()` says one
	// statement shape over — so it files the SAME site through the SAME door, and
	// `SemanticCheck.checkDiscardedResults` reaches the same verdict off the same effect summary rather than
	// this door deciding purity for itself.
	//
	// A NAMED binding is a use and files nothing; a bare `if try f()` has no result to discard at all, which
	// is E3124's own refusal one function up.
	function recordCatchingDiscard(binder IfBinder, opFloor ElementIndex)
		match binder 'b'
			none then return
			binding(nameIndex, _) then self.recordDiscardedBinderResult(nameIndex, opFloor: opFloor)
		end 'b'
	end 'recordCatchingDiscard'

	// The arm body above, as a routine because a `match` arm is one statement and this is three. The anchor
	// is the `_` itself — where the author decided to take nothing — exactly as `_ = f()` anchors at its `_`.
	//
	// The producer is found by the `tryCall` walk (`tryChannelCallAbove`), not by the last-op probe:
	// the target has already been rewritten (`rewriteLastCallToTryCall`) by the time this runs, and
	// `directCallDefining` answers only for a plain `call`.
	function recordDiscardedBinderResult(nameIndex ElementIndex, opFloor ElementIndex)
		let nameTok = self.tokenAt(nameIndex)

		if not nameTok.value.equals(DiscardBindingName) 'aNamedBinding'
			return
		end 'aNamedBinding'

		self.recordDiscardOf(self.tryChannelCallAbove(opFloor, wanted: TryChannelResult.anyValue), anchor: nameTok, door: DiscardDoor.explicitDiscard)
	end 'recordDiscardedBinderResult'

	// Parse the then branch's body, giving a catching `if`'s success value the home its condition could not.
	function parseIfThenBody(func IrFunction, thenBlock IrBlock, label ByteArray, cond IfCondition, binder IfBinder, anchor Token) returns IrBlock throws SourceParseError
		match cond 'shape'
			plain then break
			tryCatch(_, result, resultWasPending, _, _, _, _) then return try self.parseCaughtThenBody(func, thenBlock: thenBlock, label: label, result: result, resultWasPending: resultWasPending, binder: binder, anchor: anchor)
		end 'shape'

		return try self.parseBlockBody(func, block: thenBlock, label: label)
	end 'parseIfThenBody'

	// ⭐ **THE OK EDGE OF A CATCHING `if`, WHERE ITS SUCCESS VALUE FINDS AN OWNER.** Two shapes, and they are
	// the two ways the value can be owned:
	//   • BOUND (`if let x = …` / `if var x = …`) — the ordinary binding machinery takes it, in a scope frame
	//     one level outside the body's own.
	//   • DISCARDED (`if try …`) — nothing names it, and this edge is the only one it is live on, so a
	//     result that owes a drop (`takeOffPendingTemps`) is dropped at the TOP of the then block.
	//     Never in the continuation: the error edge reaches that too, with a NULL register a decref
	//     would fault on.
	function parseCaughtThenBody(func IrFunction, thenBlock IrBlock, label ByteArray, result ValueId, resultWasPending bool, binder IfBinder, anchor Token) returns IrBlock throws SourceParseError
		// ⚠ **THE SUBSTITUTED `T` CO-OWN IS ALREADY AT THE HEAD OF `thenBlock`, PUT THERE BY
		// `openCatchingOkEdge` BEFORE THIS RUNS** — and it has to be, because the fork's temporary releases go
		// in behind it and this routine is entered after them. What is left here is the binding or the discard
		// drop, both of which name the promoted value and both of which must follow it.
		match binder 'b'
			none then break
			binding(nameIndex, kind) then return try self.parseBoundThenBody(func, thenBlock: thenBlock, label: label, result: result, nameIndex: nameIndex, kind: kind)
		end 'b'

		if resultWasPending 'dropDiscardedResult'
			self.bodyState.currentBlock = thenBlock
			self.emitDecref(result, range: SourceRange.ofToken(anchor))
		end 'dropDiscardedResult'

		return try self.parseBlockBody(func, block: thenBlock, label: label)
	end 'parseCaughtThenBody'

	// The bound half of the above. The binding lives in a frame ONE LEVEL OUTSIDE the body's own, which is
	// what makes it visible to every statement of the body and — just as importantly — makes it leave
	// `mutableVars` and `ownedBindings` before `parseIfStatement` snapshots this branch's exit values (those
	// snapshots are positional over the carried set computed at the `if`, which cannot contain a `var` the
	// branch itself declared).
	function parseBoundThenBody(func IrFunction, thenBlock IrBlock, label ByteArray, result ValueId, nameIndex ElementIndex, kind BindingKind) returns IrBlock throws SourceParseError
		let nameTok = self.tokenAt(nameIndex)
		let mark = self.openBlock()
		self.bodyState.currentBlock = thenBlock

		// ⭐ **THE SAME DECLARATION A STATEMENT-LEVEL `let`/`var` MAKES, THROUGH THE SAME DOOR.** That is what
		// carries the success value's FULL type across — a function-typed result keeps its signature, so
		// `if let g = try pick(true) 'ok' … g(4)` calls through a properly typed value — and it is the whole
		// reason this is not a second, shorter binding path. No source name: the success value is a call
		// result held by no binding, so there is nothing to poison; it is a CONSUME, exactly as `let x = f()`
		// is, and asked of its value exactly as `var x = f()` is.
		try self.requireVarNotBornFromABareNumber(result, kind: kind, anchor: nameTok)
		try self.requireLetNotBornFromAnUnboundedNumber(result, kind: kind, anchor: nameTok)
		try self.declareInitializedBinding(nameTok, value: result, sourceName: SourceBinding.none, sourceReadsAField: false, kind: kind)

		let boundHere = self.bodyState.scope.getInfo(nameTok.value)

		boundHere.elementWritable = kind == BindingKind.let

		let thenEnd = try self.parseBlockBody(func, block: thenBlock, label: label)
		self.dropArmScopedOwned(mark.ownedCount, exitBlock: thenEnd, anchor: nameTok)
		self.closeBlock(mark, endsIn: thenEnd)
		return thenEnd
	end 'parseBoundThenBody'

	// Finalize an `if` with no `else`: the false path flows straight to the
	// continuation, so the continuation is always reachable. Wire the entry's
	// condBranch (then vs continuation). When the then branch falls through, the
	// continuation merges the false-edge values (`entryVals`) with the then-branch's
	// exit values (`thenVals`) — a differing var gets a continuation phi. When the then
	// branch returns, the continuation is reached only from the false edge, whose values
	// are already the restored `entryVals` (and whose move state is the restored `entryMoveMark`).
	//
	// ⭐ **A CONDITIONAL MOVE IS RECONCILED HERE.** An owned binding the then branch MOVED but the false
	// path left LIVE must be dropped on the false path so it does not leak. When the then branch FALLS
	// THROUGH, both edges reach the continuation: `reconcileMovesAtMerge` drops the binding on the false
	// edge (routed through a fresh block, since the direct entry->cont edge has none) and marks it moved.
	// When the then branch RETURNS, the continuation is reached only from the false edge — the move state
	// is already the caller's restored `entryMoveMark`, so the binding stays live and its scope exit drops it.
	function finalizeIfNoElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, bindings VarInfoArray, entryVals ValueIdArray, thenVals ValueIdArray, entryMoveMark MoveMark, thenMoveMark MoveMark) returns IrBlock
		let cont = self.artifact.module.addBlock(func, label: b"ifcont", heat: BlockHeat.normal)

		if thenEnd.isTerminated() 'thenTerminated'
			self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: cont.id, ifTok: ifTok)

			// The then branch cannot fall through, so the continuation is reached on the FALSE edge alone and IS
			// the unwritten arm's block. Nothing has to be interposed to tell the two edges apart.
			self.mintElseArmPoint(cont, funcName: func.name, ifTok: ifTok, elseTok: ifTok, written: false)
			return cont
		end 'thenTerminated'

		// Both the false edge (entry state) and the then edge (then state) reach the continuation. A binding
		// the then branch MOVED but the entry left LIVE must be dropped on the false path — but the direct
		// entry->cont false edge is `entry`, which already ends in the two-way condBranch and cannot take an
		// appended decref. Only then is a fresh `iffalse` block minted on that edge to hold the drop; an `if`
		// with no such conditional move takes the direct edge and its codegen is byte-identical to before.
		// ⭐ **`--coverage` TAKES THE SAME EDGE BLOCK, AND THAT IS WHY IT IS AN `or` RATHER THAN A SECOND
		// SHAPE.** An unwritten `else` still takes a false edge, and the direct `entry -> cont` edge cannot
		// hold its counter: `cont` is reached from the then branch too, so a counter there would count both.
		// The block this branch already mints for a conditional move is exactly the block the counter needs,
		// and `reconcileMovesAtMerge` emits nothing when no binding is mixed — so an instrumented `if` with no
		// conditional move pays one block, one branch and the counter, and nothing else.
		if self.movesALiveBinding(entryMoveMark, after: thenMoveMark) or self.coverageActive() 'falseEdgeDrop'
			let falseBlock = self.artifact.module.addBlock(func, label: b"iffalse", heat: BlockHeat.normal)
			self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: falseBlock.id, ifTok: ifTok)
			self.mintElseArmPoint(falseBlock, funcName: func.name, ifTok: ifTok, elseTok: ifTok, written: false)

			self.reconcileMovesAtTwoEdgeMerge(falseBlock, markA: entryMoveMark, b: thenEnd, markB: thenMoveMark, anchor: ifTok)

			self.mergeAtContinuation(falseBlock, predB: thenEnd, cont: cont, bindings: bindings, valsA: entryVals, valsB: thenVals)
			self.emitBranch(falseBlock, targetId: cont.id)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'falseEdgeDrop' else 'directFalseEdge'
			self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: cont.id, ifTok: ifTok)

			// The false edge is the direct entry->cont edge; the post-merge move state is the then state (a
			// binding moved before the `if` stays moved on both edges, and nothing new was moved to drop).
			self.restoreMoveMark(thenMoveMark)
			self.mergeAtContinuation(entry, predB: thenEnd, cont: cont, bindings: bindings, valsA: entryVals, valsB: thenVals)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'directFalseEdge'

		return cont
	end 'finalizeIfNoElse'

	// The false arm's counter, for both shapes of it. An UNWRITTEN arm carries
	// `MxdbgCovFlagArmImplicit` and the `if`'s own position: there is no `else` token to point at, and
	// the line listing must not claim a line the program does not have.
	function mintElseArmPoint(block IrBlock, funcName ByteArray, ifTok Token, elseTok Token, written bool)
		if not self.coverageActive() 'notInstrumenting'
			return
		end 'notInstrumenting'

		if written 'authored'
			self.mintCovPoint(block, funcName: funcName, flags: MxdbgCovFlagArmElse, line: elseTok.line, col: elseTok.column, branchLine: ifTok.line, branchCol: ifTok.column)
			return
		end 'authored'

		self.mintCovPoint(block, funcName: funcName, flags: MxdbgCovFlagArmElse or MxdbgCovFlagArmImplicit, line: ifTok.line, col: ifTok.column, branchLine: ifTok.line, branchCol: ifTok.column)
	end 'mintElseArmPoint'

	// Was the owned binding at `index` live in `before` and moved in `after`? The move flag is monotonic within a
	// path, so such a binding was moved BY the code parsed between the two marks.
	function movedBetweenMarks(before MoveMark, after MoveMark, index ElementIndex) returns bool
		let wasMoved = before.movedAt(index)
		let isMoved = after.movedAt(index)
		return isMoved and not wasMoved
	end 'movedBetweenMarks'

	// Did the code between two marks move an owned binding live at the first — the shape a merge must place a
	// drop on its other edge for (`finalizeIfNoElse`, `emitShortCircuit`)? A binding already moved at the first
	// mark is moved on both edges, and one nothing touched is live on both.
	function movesALiveBinding(before MoveMark, after MoveMark) returns bool
		for i in positionsThatMayDiffer(before, b: after) 'scan'
			if self.movedBetweenMarks(before, after: after, index: i) or self.cellStoredBetweenMarks(before, after: after, index: i) 'movedBetween'
				return true
			end 'movedBetween'
		end 'scan'

		return false
	end 'movesALiveBinding'

	// Finalize an `if`/`else`: the entry's condBranch targets the then and else blocks.
	// The continuation is reachable only when a branch falls through; when BOTH return
	// it is unreachable and marked `dead`. When BOTH fall through, the continuation
	// merges their exit values (`thenVals`/`elseVals`) with phis for the vars that
	// differ. When only ONE falls through, the continuation simply carries that branch's
	// values (no phi — a single predecessor).
	function finalizeIfElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, elseBlock IrBlock, elseEnd IrBlock, bindings VarInfoArray, thenVals ValueIdArray, elseVals ValueIdArray, thenMoveMark MoveMark, elseMoveMark MoveMark) returns IrBlock
		self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: elseBlock.id, ifTok: ifTok)
		let thenTerminated = thenEnd.isTerminated()
		let elseTerminated = elseEnd.isTerminated()

		if thenTerminated and elseTerminated 'bothReturn'
			// Nothing reaches the continuation — see `newDeadBlock` for why it is marked rather than left
			// unterminated, and why the unreachable tail may still be parsed into it.
			return self.newDeadBlock(func, label: b"ifcont")
		end 'bothReturn'

		let cont = self.artifact.module.addBlock(func, label: b"ifcont", heat: BlockHeat.normal)

		if not thenTerminated and not elseTerminated 'bothFallThrough'
			// ⭐ **CONDITIONAL MOVE RECONCILED across the two live edges** — a binding moved in one branch and
			// left live in the other is dropped on the live edge (both are real, unterminated blocks) and
			// marked uniformly moved past the merge. Emitted BEFORE `mergeAtContinuation` records the phi
			// edges and before the branches, so the decref lands in the branch's own body.
			self.reconcileMovesAtTwoEdgeMerge(thenEnd, markA: thenMoveMark, b: elseEnd, markB: elseMoveMark, anchor: ifTok)

			self.mergeAtContinuation(thenEnd, predB: elseEnd, cont: cont, bindings: bindings, valsA: thenVals, valsB: elseVals)
			self.emitBranch(thenEnd, targetId: cont.id)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'bothFallThrough' else if not thenTerminated 'onlyThen'
			// Only the then branch reaches the continuation — its values AND its move state carry through
			// (the else branch terminated, having dropped its own live values on the way out).
			self.restoreBindings(bindings, snapshot: thenVals)
			self.restoreMoveMark(thenMoveMark)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'onlyThen' else 'onlyElse'
			// Only the else branch reaches the continuation — its values and move state ARE the current
			// state (else was parsed last and nothing has mutated either since), so both restores are
			// no-ops today. They are written explicitly anyway, symmetric with `onlyThen` above: "the
			// surviving branch's state prevails at the merge" is then stated once per axis rather than
			// left as an unstated dependence on branch-parse order — which, if ever reordered, would keep
			// values correct (explicit restore) while silently diverging the drop-gating move state into a
			// leak or double-free (a wrong answer, not a compile error).
			self.restoreBindings(bindings, snapshot: elseVals)
			self.restoreMoveMark(elseMoveMark)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'onlyElse'

		return cont
	end 'finalizeIfElse'

	// Merge two incoming value snapshots at a continuation block. A carried binding whose
	// value differs across the paths gets a continuation PHI (a block-arg) and each
	// predecessor records the value it carries on its edge; a binding with the same value
	// on both paths keeps that value with no phi. Each merged binding's current value is
	// set to the phi (or the common value) so code after the `if` reads the merged value.
	//
	// `bindings` is the statement's carried set (`assignedBindings`) in `mutableVars`
	// declaration order, and both snapshots are positional over it. Phis are therefore
	// minted in that same order — which is what makes the emitted code identical to the
	// whole-`mutableVars` merge: a var no branch assigned had a == b there and got no
	// phi, so leaving it out of `bindings` changes no decision, only the work done to
	// reach it. Both snapshots and `bindings` are the SAME length (asserted): every branch
	// body is a lexical block, so a `var` declared inside one is off `mutableVars` — and so
	// never entered `bindings` — before its exit values are snapshotted.
	function mergeAtContinuation(predA IrBlock, predB IrBlock, cont IrBlock, bindings VarInfoArray, valsA ValueIdArray, valsB ValueIdArray)
		self.assertSnapshotAligned(bindings, snapshot: valsA, site: "mergeAtContinuation/valsA")
		self.assertSnapshotAligned(bindings, snapshot: valsB, site: "mergeAtContinuation/valsB")

		let edgeArgsA = ValueIdArray.create(0)
		let edgeArgsB = ValueIdArray.create(0)

		for k in 0 upto bindings.count() 'eachVar'
			let binding = try bindings.get(k) otherwise panic("mergeAtContinuation: bindings.get OOB at {k}")
			let a = try valsA.get(k) otherwise panic("mergeAtContinuation: valsA.get OOB at {k}")
			let b = try valsB.get(k) otherwise panic("mergeAtContinuation: valsB.get OOB at {k}")

			if a == b 'same'
				self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: a, def: DebugVersionDef.merged)
				binding.setBoundValue(a, ledger: self.bodyState.moveLedger)
			end 'same' else 'differ'
				let phiId = self.mintPhiForBinding(cont, binding: binding)
				self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: phiId, def: DebugVersionDef.definedIn(cont.id))
				binding.setBoundValue(phiId, ledger: self.bodyState.moveLedger)
				self.pushMergedEdgeValue(edgeArgsA, binding: binding, value: a)
				self.pushMergedEdgeValue(edgeArgsB, binding: binding, value: b)
				self.markPhiImmortalIfEveryEdgeIs(phiId, edges: twoArgs(a, second: b))
				self.admitUnsignedLiteralsAcross(twoArgs(a, second: b))
			end 'differ'
		end 'eachVar'

		self.recordBranchEdge(predA, targetId: cont.id, argIds: edgeArgsA)
		self.recordBranchEdge(predB, targetId: cont.id, argIds: edgeArgsB)
	end 'mergeAtContinuation'

	// Rebind each carried binding to a previously-captured snapshot value (from
	// `snapshotBindings` over the SAME `bindings` list). Used to rewind to the pre-branch
	// state before parsing an `if`'s false path, and to select a single surviving branch's
	// values at a continuation. Written THROUGH the binding, not by name, so a value is
	// never routed to a shadow (see LoopPhiVar). A var not in `bindings` is assigned by no
	// branch, so its value is already the one every path agrees on — nothing to restore.
	function restoreBindings(bindings VarInfoArray, snapshot ValueIdArray)
		self.assertSnapshotAligned(bindings, snapshot: snapshot, site: "restoreBindings")

		for k in 0 upto bindings.count() 'each'
			let binding = try bindings.get(k) otherwise panic("restoreBindings: bindings.get OOB at {k}")
			let saved = try snapshot.get(k) otherwise panic("restoreBindings: snapshot.get OOB at {k}")
			self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: saved, def: DebugVersionDef.merged)
			binding.setBoundValue(saved, ledger: self.bodyState.moveLedger)
		end 'each'
	end 'restoreBindings'

	// Every value snapshot is positional over the carried `bindings` list and must
	// therefore have exactly its length — block scoping is what guarantees that (a
	// branch-local `var` is drained at the block's `end`, so it never entered `bindings`
	// and can never lengthen a snapshot taken outside the block). A mismatch means the two
	// fell out of step, which would misattribute every later binding's value by one, so it
	// fails loudly here rather than silently.
	function assertSnapshotAligned(bindings VarInfoArray, snapshot ValueIdArray, site String)
		let expected = bindings.count()

		if snapshot.count() != expected 'drifted'
			panic("{site}: value snapshot holds {snapshot.count()} entries but the if carries {expected} assigned bindings — the snapshot drifted out of lockstep with the carried-bindings list")
		end 'drifted'
	end 'assertSnapshotAligned'

	// Parse a `while` loop:
	//   while <cond> 'label'
	//       <body>
	//   end 'label'
	//
	// Lowering shape (the first BACKWARD-branching CFG): the current block becomes the
	// PREHEADER, which branches unconditionally into a fresh HEADER. The header re-
	// evaluates the condition each iteration (a comparison, fused into `cmp`+`jcc` by
	// the Std→x64 pass, exactly as an `if`) and takes a two-way branch to the BODY or
	// the EXIT. The body ends with a BACK-EDGE branch to the header; `break` branches
	// to the exit, `continue` to the header. `resolveBlockJumps` already patches
	// backward rel32, so no new encoder work is needed.
	//
	// On-the-fly SSA: the header carries one PHI (block-arg) per mutable var the loop
	// ASSIGNS, minted eagerly BEFORE the body is parsed. Each phi becomes the var's current
	// value, so the condition and body read the loop-carried value; the preheader and every
	// back-edge feed the phis via the predecessor's `branchEdges`. Returns the EXIT block.
	//
	// **THE CARRIED SET IS THE VARS THE LOOP ASSIGNS — AND EAGER MINTING IS WHAT MAKES THAT
	// THE RIGHT QUESTION.** A var the loop never assigns holds the same value on every
	// iteration, so its pre-loop definition DOMINATES the header and a read inside the body
	// binds it correctly with no phi at all. A var the loop DOES assign needs one, and it
	// must exist before the body is parsed — because every read in the body, and every value
	// SNAPSHOT taken inside it (`parseIfStatement`'s entry/then/else snapshots, a nested
	// loop's preheader), captures whatever the binding holds AT THAT MOMENT. Mint the phi
	// later — on the var's first mention, say — and every snapshot already taken inside the
	// loop is holding the stale PRE-LOOP value, and an `if` merge in the body would carry it
	// onto the not-taken path. That is a silent miscompile on iteration 2, and it is why the
	// carried set is decided UP FRONT rather than discovered as the body is parsed:
	//
	//     var x = 1
	//     while c 'l'
	//         if d 'b'      // entry snapshot of x taken HERE
	//             x = 2     // a phi minted only now is invisible to that snapshot
	//         end 'b'       // ⇒ the false edge would carry 1, resetting x every iteration
	//     end 'l'
	//
	// So the set is read off the TOKENS, before a single op is emitted: `assignedBindingsIn`
	// over the loop's token extent. It is an over-approximation on purpose (a shadowed inner
	// declaration of the same name counts, and so does a `let`), and over-approximating is
	// FREE while under-approximating is a miscompile — a surplus phi costs nothing:
	//   • a var the loop never READS gets a phi nothing reads — but the back edge passes
	//     that phi to ITSELF, so it is self-sustaining and liveness holds it live around
	//     the whole loop. `pruneDeadBlockArgs` (a Std pass) deletes those; without it, two
	//     sequential loops inflate maxlive by one per dead var and can FALSE-E5001.
	//   • a var the loop reads but never WRITES gets a phi that copies a value which never
	//     changes. Biased coloring coalesces it with its incoming value into one register
	//     and the edge copy self-elides (see RegisterAllocator.copyGroupBlocked).
	//
	// What this REPLACES is a phi for every mutable var IN SCOPE, which was quadratic in the
	// program: a function's `var`s accumulate as it goes, so the Nth loop minted phis for all
	// ~N of them and assigned a ValueId to each — including every one `pruneDeadBlockArgs`
	// then deleted. `blockArgIdBound`, and every dense column sized by it, is O(ValueIds), so
	// the phis nobody kept were still being paid for in bytes at every later pass.
	function parseWhileStatement(func IrFunction, block IrBlock) returns IrBlock throws SourceParseError
		let whileIndex = self.pos
		let whileTok = try self.consume(TokenKind.while)

		// Decided from the tokens, before anything is emitted — see the header.
		let bodyEndIndex = self.blockStatementEndIndex(whileIndex, continuesAtElse: false)
		let carried = self.assignedBindingsIn(whileIndex, endIndex: bodyEndIndex)

		let header = self.artifact.module.addBlock(func, label: b"whilehdr", heat: BlockHeat.normal)

		let phiVars = self.mintLoopHeaderPhis(header, carried: carried)

		self.recordBranchEdge(block, targetId: header.id, argIds: self.edgeArgsFor(phiVars, preLoop: true))
		self.emitBranch(block, targetId: header.id)
		let scanIndex = self.openLoopScan(header, preheader: block, phiVars: phiVars)

		// Condition, evaluated in the header — so `continue` and the back edge, which both
		// target the header, re-evaluate it. A short-circuit `and`/`or` in the condition
		// (`while check() and more()`) spreads that evaluation over blocks BETWEEN the
		// header and the two-way branch; `condExit` is the block it ends in, and that is
		// where the branch — and the exit's incoming edge — belong. The header stays the
		// loop's entry, so nothing about `continue` or the back edge changes.
		let condTempFloor = self.bodyState.pendingTempDrops.count()
		let condOwnedFloor = self.bodyState.ownedBindings.count()
		let condWindowFloor = self.statementWindowFloor()
		let cond = try self.parseBoolCondition(func, block: header, kwTok: whileTok)
		try self.requireNoDeferredRefusal()
		self.closeWindowsTo(condWindowFloor)
		let orders = self.conditionOrdersOf(cond)
		let condExit = self.bodyState.currentBlock

		// ⭐ **PER ITERATION, NOT PER LOOP** — and that is why the release goes HERE rather than in the exit
		// block. The condition is re-evaluated on every trip (the back edge and `continue` both target the
		// header), so it builds a FRESH temporary each time; `condExit` is inside the loop, so the release
		// rides round with it and the live count stays flat. Hoisted to `exit` it would run once for N
		// allocations — a leak that grows with the trip count. The `if` reasoning applies unchanged for the
		// two edges: `condExit` dominates both the body and the exit.
		self.drainPendingTemps(condTempFloor, anchor: whileTok)

		// ⭐⭐ **AND A SCOPE-LIFETIME TEMPORARY THE CONDITION HELD COMES BACK PER ITERATION TOO — the one
		// place the `if` reasoning does NOT carry over.** An `if` condition runs ONCE and dominates everything
		// after it, so a container `giveTemporaryScopeLifetime` held for a borrow may legitimately live to the
		// frame's exit. A `while` condition runs on every trip and rebuilds that container each time, while the
		// enrolment records ONE `ValueId` and drops it ONCE — so the frame's exit would free the LAST trip's
		// record and leak all the others. MEASURED as exit **101** on
		// `while n < (try make().get(0) otherwise …).count()`, which is the leak gate catching exactly the
		// direction the risk inverts to. The borrow cannot escape the condition (it is a `bool`), so
		// releasing here is sound as well as necessary — the short-circuit rhs's argument, one construct out.
		self.dropArmScopedOwned(condOwnedFloor, exitBlock: condExit, anchor: whileTok)
		self.noteLoopConditionExit()

		let loopLabelTok = try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		let body = self.artifact.module.addBlock(func, label: loopLabelTok.value, heat: BlockHeat.normal)
		let exit = self.artifact.module.addBlock(func, label: b"whileexit", heat: BlockHeat.normal)
		self.emitCondBranch(condExit, cond: cond, thenId: body.id, elseId: exit.id, ifTok: whileTok)

		// `ownedFloor` is the owned-binding height NOW, before the body opens its block — so a
		// `break`/`continue` releases exactly what the body declares (see LoopContext.ownedFloor).
		// A `while`'s continue target IS its header: the condition is re-evaluated on the back edge,
		// so there is no increment to run first and no step block to run it in.
		self.bodyState.loops.push(LoopContext.create(loopLabelTok.value, continueTargetId: header.id, exitId: exit.id, phiVars: phiVars, ownedFloor: self.bodyState.ownedBindings.count(), scanIndex: scanIndex, debugOpenFloor: self.bodyState.debugOpenSlots.count(), windowFloor: self.openWindowCount()))

		// The body is a lexical BLOCK: its declarations are gone — and its `var`s off
		// `mutableVars` — before the back-edge args below are read, so those args name the
		// loop's own phi bindings and never a body-local shadow.
		let bodyOrderFloor = self.assumeOrders(orders.whenTrue)
		let bodyEnd = try self.parseBlockBody(func, block: body, label: loopLabelTok.value)
		self.bodyState.orderFacts.forgetAbove(bodyOrderFloor)

		// Guard the token scan against the parse it predicted — see `assertScanAligned`.
		self.assertScanAligned("parseWhileStatement", predictedEnd: bodyEndIndex)

		let ctx = try self.bodyState.loops.pop() otherwise panic("parseWhileStatement: loop stack empty after body of '{String.from(loopLabelTok.value)}'")

		// Normal back-edge: a body that falls through goes wherever a COMPLETED iteration goes, with
		// its (possibly reassigned) current values. A body that always returns/breaks/continues on
		// every path leaves `bodyEnd` terminated — no fall-through edge.
		//
		// ⭐ **THE TARGET IS `ctx.continueTargetId`, DERIVED, NOT THE HEADER SPELLED AGAIN.** "Where a
		// normally-completing iteration lands" is ONE fact, and `continue` already reads it off the
		// context (`parseContinueStatement`); writing `header.id` here too made it a fact stated twice
		// per construct, agreeing only by coincidence. For a `while` the two ARE the header — which is
		// exactly why the duplicate stayed invisible — and for a `for` the fall-through must reach the
		// STEP block or the counter never advances.
		if not bodyEnd.isTerminated() 'fallsBack'
			self.noteLoopBackEdge(bodyEnd, height: ctx.ownedFloor)
			self.recordBranchEdge(bodyEnd, targetId: ctx.continueTargetId, argIds: self.edgeArgsFor(phiVars, preLoop: false))
			self.emitBranch(bodyEnd, targetId: ctx.continueTargetId)
		end 'fallsBack'

		let finished = try self.finishLoopMoves(func, falseSource: condExit, exit: exit, anchor: whileTok)
		self.wireLoopExit(finished.falseEdge, exit: exit, ctx: ctx)

		if self.loopHasNoExit(cond, ctx: ctx) 'nothingLeavesTheLoop'
			exit.terminator = Terminator.dead
		end 'nothingLeavesTheLoop'

		return exit
	end 'parseWhileStatement'

	// The false edge of a constant-true condition never runs, so only a `break` can reach the exit; a
	// `return` or `throw` inside the loop does not give it one.
	function loopHasNoExit(cond ValueId, ctx LoopContext) returns bool
		return self.constIsKnown(cond) and self.constOf(cond) == BoolTrueValue and not ctx.hasBreak
	end 'loopHasNoExit'

	// ⭐ **MINT ONE HEADER PHI PER CARRIED BINDING** — the front half BOTH loop statements run, and the
	// only place a loop-carried phi is created. `carried` is the construct's carried set, read off the
	// tokens by its caller (see `parseWhileStatement`'s header for why it must be known up front) and
	// already in `mutableVars` DECLARATION ORDER, which is what makes a merge inside the body mint its
	// own phis in the same order — both come from `assignedBindingsIn`, so it is one ordering rather
	// than two that agree.
	//
	// Each binding's PRE-LOOP value is captured into the `LoopPhiVar` as it goes, because installing the
	// phi overwrites `boundValue` — that snapshot is what `edgeArgsFor(preLoop: true)` reads to build the preheader
	// edge, and reading it here, inside the single forward pass, is what keeps the two positional.
	//
	// Index-based so each binding is a MUTABLE reference — a `for x in …` loop variable is immutable,
	// and installing the phi writes through the binding.
	function mintLoopHeaderPhis(header IrBlock, carried VarInfoArray) returns LoopPhiVarArray
		let phiVars = self.mintCarriedPhis(header, carried: carried)
		self.installCarriedPhis(phiVars, phiBlock: header.id)
		self.noteLoopHeaderPhisCarried(phiVars)
		return phiVars
	end 'mintLoopHeaderPhis'

	// The MINT half, without the install — one phi per carried binding, in `carried`'s order, each
	// remembering the value the binding held BEFORE the phi existed.
	//
	// ⭐ **IT IS SPLIT FROM THE INSTALL BECAUSE THE TWO CONSTRUCTS THAT MINT THESE PHIS INSTALL THEM AT
	// DIFFERENT MOMENTS.** A loop header DOMINATES its body, so its phis are the values the body itself must
	// read and the install belongs here. A block-form `try`'s error block does NOT dominate the try body —
	// it is a SIBLING the body branches to — so its phis must not be visible while the body parses (the body
	// reads and reassigns the ordinary values, and each routed edge carries whatever they hold at that point);
	// they are installed only for the HANDLER, which is the block those phis dominate. One mint, two install
	// points, and the positional contract `edgeArgsFor` depends on is written down once.
	function mintCarriedPhis(block IrBlock, carried VarInfoArray) returns LoopPhiVarArray
		let phiVars = LoopPhiVarArray.create(carried.count(), zeroed: false)

		for k in 0 upto carried.count() 'mkPhi'
			let binding = try carried.get(k) otherwise panic("mintCarriedPhis: carried.get OOB at {k}")

			// Read BEFORE the mint, and in its own statement: the value a binding held before its phi
			// existed is what every pre-merge edge carries, and folding it into the `create` call below
			// would make that ordering an argument-evaluation accident.
			let entryValue = binding.boundValue
			let phiId = self.mintPhiForBinding(block, binding: binding)
			phiVars.push(LoopPhiVar.create(binding, phiId: phiId, entryValue: entryValue))
		end 'mkPhi'

		return phiVars
	end 'mintCarriedPhis'

	// Make each carried binding READ its phi from here on — the install half above. Index-based for
	// `mintCarriedPhis`' reason: a `for x in …` loop variable is immutable, and this writes through the
	// binding.
	function installCarriedPhis(phiVars LoopPhiVarArray, phiBlock BlockId)
		for k in 0 upto phiVars.count() 'install'
			let phiVar = try phiVars.get(k) otherwise panic("installCarriedPhis: phiVars.get OOB at {k}")
			self.recordDebugRebind(phiVar.binding.debugLocalSlot, recorded: phiVar.binding.debugLocalRecorded, current: phiVar.binding.boundValue, value: phiVar.phiId, def: DebugVersionDef.definedIn(phiBlock))
			phiVar.binding.setBoundValue(phiVar.phiId, ledger: self.bodyState.moveLedger)
		end 'install'
	end 'installCarriedPhis'

	// The destructuring loop (`for (k, v) in m` binds one name per tuple element) lives in a frame of
	// its own, which is E5001's cure applied at the function boundary: `parseForStatement` holds two
	// dozen locals it still needs afterwards, and inline every one of them would be live across this
	// loop and owed a register for its whole body. Behind a call they spill around it at no cost.
	function declareDestructuredLoopVariables(nameToks TokenArray, loopValue ValueId, claimsWithIteratorPromise bool, patternTok Token, forTok Token, writable bool, elementQualifier GenericArgQualifier, firstStoredKey StoredKeyCursor) throws SourceParseError
		let source = try self.requireDestructurableTuple(loopValue, nameToks: nameToks, keywordTok: forTok, patternSubject: ForPatternSubject, sourceNoun: ForPatternSourceNoun, needsClause: ForPatternNeedsClause)

		for i in 0 upto nameToks.count() 'eachName'
			let nameTok = try nameToks.get(i) otherwise panic("declareDestructuredLoopVariables: nameToks.get OOB at {i} below count {nameToks.count()}")
			let range = SourceRange.between(patternTok, last: nameTok)
			let value = self.destructuredElement(loopValue, source: source, index: i as FieldIndex, range: range)

			if claimsWithIteratorPromise and i == WithIteratorElementPosition 'thePairsPromise'
				match source 'source'
					tuple(layout) then self.claimWithIteratorPromiseSlot(value, pair: loopValue, layout: layout, range: range)
					deferred then panic("declareDestructuredLoopVariables: a pair that claims a `WithIterIterator` promise is a tuple — `pairsAnArrayIteratorWithAPromise` answers false for an unresolved cursor")
				end 'source'
			end 'thePairsPromise'

			try self.declareLoopVariable(nameTok, value: value, writable: writable, elementQualifier: elementQualifier if i == WithIteratorElementPosition else GenericArgQualifier.plain, storedKey: firstStoredKey if i == 0 else StoredKeyCursor.neither)
		end 'eachName'
	end 'declareDestructuredLoopVariables'

	// ⭐⭐ **A `WithIterIterator` PAIR'S PROMISE IS THE ARRAY'S, SO THE DESTRUCTURE MOVES IT BACK THERE.**
	// `WithIterIterator.current()` builds `(source, source.current())`, which puts the element in the pair
	// while the array still holds it — two holders of a thread that admits one. The pair's field is emptied
	// here, so the pair's destructor reclaims nothing, and the bound value names the array slot the iterator
	// stands on, so it is exactly the borrow `for p in promises` binds: an await empties the array's slot, and
	// a promise never consumed is reclaimed once, when the array drops.
	function claimWithIteratorPromiseSlot(promise ValueId, pair ValueId, layout StructLayout, range SourceRange)
		let iterator = self.emitFieldLoad(pair, layout: layout, index: WithIteratorSourcePosition, range: range)
		self.emitEmptyPromiseField(pair, offset: layout.offsetOfField(WithIteratorElementPosition), range: range)
		let slot = try self.emitIteratorCursorSlot(iterator, args: argsOf(iterator), range: range) otherwise panic("claimWithIteratorPromiseSlot: `pairsAnArrayIteratorWithAPromise` admitted this pair because its iterator holds a cursor")
		self.recordConsumablePromiseSlot(promise, container: slot.container, index: slot.index, isField: false)
	end 'claimWithIteratorPromiseSlot'

	// Is `cursor` the library `WithIterIterator` pairing an ARRAY iterator with a promise element?
	function pairsAnArrayIteratorWithAPromise(cursor ValueId) returns bool
		if self.tagOf(cursor) != ValueTypeTag.genericInstance 'notAnInstance'
			return false
		end 'notAnInstance'

		let gid = self.valueInstanceId(cursor)

		if not self.signatures.genericInstanceBaseName(gid).equals(WithIterIteratorTypeName) or not self.signatures.genericInstanceHasBaseLayout(gid) 'notThePairing'
			return false
		end 'notThePairing'

		// An author's own `WithIterIterator` shadows the library's under this name and promises nothing about
		// what its pair holds.
		if not self.signatures.declaredByTheCorpus(self.signatures.baseLayoutOf(gid).declFilePath) 'notTheLibrarys'
			return false
		end 'notTheLibrarys'

		let source = self.signatures.substitutedInstanceArg(gid, position: WithIteratorSourcePosition)
		return self.signatures.instanceArgIsAGreenThreadHandle(gid, position: WithIteratorElementPosition) and maxonTypeTag(source) == ValueTypeTag.genericInstance and not self.signatures.managedCursorFieldsOf(genericInstanceIdOf(source)).isEmpty()
	end 'pairsAnArrayIteratorWithAPromise'

	// ⭐⭐ **PARSE A `for` LOOP.** Three source spellings, ONE lowering:
	//
	//     for <name> in <lo> to   <hi> 'label'    — a counted range, INCLUSIVE of `hi`
	//     for <name> in <lo> upto <hi> 'label'    — the same, EXCLUSIVE of `hi`
	//     for <name> in <collection>   'label'    — walked by whichever of the four collection forks fits it
	//
	// FOUR blocks, and the fourth is the one `while` does not have:
	//
	//     preheader → evaluate the source ONCE → br header(idx0, …carried)
	//     header    → idx <= hi ? body : exit          (`<` for `upto`; for a counted record, `idx < count`)
	//     body      → bind the loop variable; <user statements>; br step
	//     step      → br header(idx + 1, …carried)     ← `continue` targets THIS, not the header
	//     exit
	//
	// ⭐ **THE STEP BLOCK IS MANDATORY.** Every path that continues the loop — the body's tail and
	// every `continue` — lands there, so the counter advances exactly once per iteration however the
	// body was left. Without it a `continue` re-enters the header with the counter unchanged and the
	// loop spins forever.
	//
	// ⭐ **THE COUNTER FORM IS WHAT AN `Array` AND A SOURCE WITH NO `createIterator` GET.**
	// `stdlib/` is loaded whole (`StdlibLoader`), so `materializeIterableIterationSource` rewrites a
	// source whose container declares `createIterator()` to the cursor it returns BEFORE the fork
	// below is reached — except an `Array`, which it keeps on the counter (`valueIsAnArray`).
	// `for x in [10, 20, 30]` emits `__managed_count` / `__managed_get_unchecked`.
	//
	// ⚠⚠ **`stdlib/FixedArray.maxon` TAKES THE REWRITE.** The corpus declares `createIterator`, so a
	// fixed array source runs the declaration's cursor — a fact that turns on VISIBILITY alone, which
	// is why a `FixedArray`, whose record IS an array's, is not the counter source it looks like. The
	// trade is not free — a counted read against a per-loop iterator struct and a call per step;
	// `materializeIterableIterationSource` states why its exemption is the `Array`'s alone.
	//
	// What arrives here as a counter is a corpus `Array` and every source that supplies no cursor of
	// its own: a program's OWN `type Array … implements BuiltinArrayLiteral` that declares none (see
	// `requireIterableSource`'s array arm, which is the door that admits exactly those). The counted
	// ranges share the shape.
	//
	// ⭐ **WHAT THE COUNTER IS STILL THE RIGHT SHAPE FOR, AND WHY THE COMPILER NEVER SYNTHESIZES A
	// CURSOR.** A counter is taken over a compiler-BUILT heap cursor for three reasons: such a cursor
	// snapshots `source.buffer` and dangles when the source is freed at its last use, it
	// double-retains and leaks the backing of every scope-local collection, and it costs two heap
	// allocations per loop. None of that is an argument against the cursor a source DECLARES: that one
	// is an ordinary struct whose lifetime and refcounting are its own declaration's business and the
	// ordinary call machinery's, which is precisely why the rewrite above is a rewrite and not a sixth
	// loop form.
	//
	// ⭐ **THE LENGTH IS RE-READ LIVE IN THE HEADER**, never snapshotted into the preheader. The header
	// comparison against the real length IS the bounds check, which is what lets the element read below
	// be the UNCHECKED one; a stale snapshot would let that read run off the end of the buffer.
	//
	// ⭐ **THE ELEMENT IS A BORROW** (`emitContainerElementAccessor`, `borrowed`) — the array keeps
	// ownership and its own `__managed_decref` walk destroys it, exactly as `get`/`first`/`last`
	// already yield (`dispatchArrayMethod`). The loop variable is therefore enrolled in NEITHER
	// `ownedBindings` NOR `pendingTempDrops`, and the loop costs zero refcount traffic per iteration.
	// There is exactly ONE door for reading an array element and it borrows, so retaining here would
	// be a second ownership rule for the same read.
	function parseForStatement(func IrFunction) returns IrBlock throws SourceParseError
		let forIndex = self.pos
		let forTok = try self.consume(TokenKind.for)

		// Decided from the tokens, before anything is emitted — see `parseWhileStatement`'s header.
		let bodyEndIndex = self.blockStatementEndIndex(forIndex, continuesAtElse: false)

		// ⭐⭐ **THE LOOP VARIABLE IS A PATTERN, NOT A NAME — `for (key, value) in m` (TUPLES + `Map`).** A
		// `Map`'s element IS a `(Key, Value)` tuple (`MapIterator.current()`), so the destructuring spelling is
		// how `/specs/map.md` and `/specs/tuples.md` both write a map loop; the single-name form is the same
		// pattern with one position and no parens. Read as a LIST of names either way, so every question below
		// — the anchor, the discard, the E3012 candidate, the borrow — is asked once per position rather than
		// once per spelling.
		//
		// ⚠ **THE ANCHOR IS THE PATTERN'S FIRST TOKEN AND NOT A NAME**, because a destructuring header has no
		// single name to blame and `_` may occupy the position that would otherwise be it.
		let patternTok = self.current()
		let nameToks = try self.parseLoopVariablePattern(forTok)
		try self.consume(TokenKind.in)

		// ⭐ **THE `for` STATEMENT'S OWN LEXICAL FRAME.** Two things live in it and must be gone at the
		// loop's `end`: the loop VARIABLE (`block-scoping.md`'s `for-iterator-not-accessible-after` pins
		// that reading it after the loop is E2004) and, when the source is a fresh OWNED array, the
		// internal binding that owns it. It is opened BEFORE the source is parsed so the owned mark sits
		// below anything the source enrols.
		let forMark = self.openBlock()

		// ⭐ **THE SOURCE IS EVALUATED ONCE, IN THE PREHEADER** — both range bounds, or the array record.
		// The end bound is stored ahead of the header rather than re-evaluated per trip, so a bound that
		// calls a side-effecting function is called exactly once.
		let sourceTempFloor = self.bodyState.pendingTempDrops.count()
		let sourceStart = self.pos

		// The op index the source expression's own ops start at: neither the absorb rewrite
		// (`absorbThrowingCursorSource`) nor a release of the claimed op (`releaseHeldThrowingOp`) may
		// reach below it, so neither touches a call the previous statement emitted.
		let sourceOpFloor = self.artifact.module.ops.count()
		let sourceDeferralFloor = self.artifact.deferredChains.count()

		// `var` for the ONE rewrite a collection source can undergo: a `Map` is replaced by its materialized
		// entries below, which is what makes every question after this point an ARRAY's question.
		let sourceClaim = self.openClaim(IterationSourceClaim)
		self.statement.lastBareBindingImmutableName = EmptySourceText
		var source = try self.parseClaimedValueExpression(func, rangeIsAValue: false)
		let sourceIsRebindable = self.expressionImmutableBlame(self.tokenAt(sourceStart), valueStart: sourceStart).isEmpty()
		let elementsAreWritable = sourceIsRebindable and self.sourceElementQualifier(source) == GenericArgQualifier.plain and self.sourceReceiverElementQualifier(source, sourceOpFloor: sourceOpFloor) == GenericArgQualifier.plain
		try self.closeClaim(sourceClaim, keepsTheCoveredAwait: true)

		// `to` / `upto` after the first expression is what makes this a RANGE. The operator's token INDEX
		// is carried (not the `Token` itself) so the loop test below can anchor its type diagnostic on the operator the user wrote;
		// an array form has no such operator and anchors on the `for`.
		// ⭐⭐ **THE TEN FACTS THE SOURCE EXPRESSION SETTLES, IN ONE RECORD — E5001's OTHER CURE, AND THE ONE
		// THIS FUNCTION NEEDED.** Each as a `var` of its own would be live from the header analysis
		// down to the merge at the end — so the allocator would owe ten registers across a function that also
		// needs its five blocks, its phis and its carried-var columns. That is the shape the allocator refuses:
		// *"the code at <file>:<line> needs N more register(s) than are available — M values must be
		// held in registers at once at this point"*, with the note that everything spillable already had
		// been. A RECORD's fields live in memory and are never promoted, which is exactly what the
		// diagnostic asks for — and the bundle is not arbitrary: these ten ARE one answer, *what kind of
		// thing is being iterated*, settled once by the header and read by every phase after it.
		let src = ForSourceFacts.create(source, testAnchorIndex: forIndex, sourceEnd: self.pos)
		src.elementQualifier = self.sourceReceiverElementQualifier(source, sourceOpFloor: sourceOpFloor)

		// A source `mintCallResult` deferred has no iterable shape to read, and this parser cannot abandon a
		// construct it has begun emitting — so the header becomes a zero-trip `0 upto 0` that routes past
		// `requireIterableSource`. Nothing ever runs it: `SemanticCheck.validateCall` refuses the program
		// with E3004 at the call, and a refusal here would land in front of that one, at the `for`.
		// Earlier and `src` does not exist; later and `requireIterableSource` has already spoken.
		if self.valueIsDeferred(source) 'deferredCallSource'
			src.sourceIsDeferred = true
			source = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
			src.isRange = true
			src.limit = source
		end 'deferredCallSource'

		// ⭐⭐ **A RANGE WHOSE BOUNDS ARE BOTH CHARACTER LITERALS IS A RANGE OF `Character`S**, and
		// this is the one place that is decided. Every character literal is a `Character`
		// (`parseCharLiteral`), so `for c in 'a' to 'e'` arrives here with two RECORDS where the loop needs two
		// COUNTERS — and the body needs a Character per trip, which no record in memory holds.
		//
		// Both halves fall out of coercing the bounds to their CODEPOINTS through the ordinary
		// `integerizedOperand` door: the loop below is then the counted integer range it always was, stepping
		// codepoint by codepoint, and the ELEMENT is minted from the counter by `__char_from_cp`. Nothing about
		// the range machinery changes, and no `.rdata` record is registered for a bound that became a number.
		//
		// ⚠ **BOTH, OR NEITHER.** `for i in 'a' to n` is an INTEGER range from 97 — one bound is a number, so
		// the range is over numbers, exactly as `cp == '-'` is a comparison of numbers. The element type
		// follows the PAIR and not either half, which is why the two tags are read BEFORE the coercion.
		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeHeader'
			self.releaseHeldThrowingOp(sourceOpFloor, heldBy: IterationSourceClaim)
			src.isRange = true
			src.rangeInclusive = self.at(TokenKind.to)
			src.testAnchorIndex = self.pos
			self.advance()
			let limitStart = self.pos
			src.limit = try self.parseExpression(func, block: self.bodyState.currentBlock, rangeIsAValue: false)

			// The two lines below read `src.limit`'s tag and then coerce it, so the stand-in has to be in
			// place before them or `integerizedOperand` refuses the deferral in front of E3004.
			if self.valueIsDeferred(src.limit) 'deferredCallLimit'
				src.limit = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
			end 'deferredCallLimit'

			let bothWereCharacters = self.tagOf(source) == ValueTypeTag.character and self.tagOf(src.limit) == ValueTypeTag.character
			source = try self.integerizedOperand(source, expected: ValueTypeTag.integer, start: sourceStart, pastEnd: src.testAnchorIndex)
			src.limit = try self.integerizedOperand(src.limit, expected: ValueTypeTag.integer, start: limitStart, pastEnd: self.pos)

			// A pair of Characters that did NOT both coerce is a pair of bounds the counter cannot step — a
			// binding rather than a literal, or a multi-codepoint cluster — and `requireCountableRangeBound`
			// below refuses it in its own words rather than this flag promising an element it cannot mint.
			src.isCharacterRange = bothWereCharacters and tagIsIntegral(self.tagOf(source)) and tagIsIntegral(self.tagOf(src.limit))
			src.skipsSurrogateBlock = src.isCharacterRange and self.constIsKnown(source) and self.constIsKnown(src.limit) and self.constOf(source) < SurrogateFloor and self.constOf(src.limit) >= SurrogateFloor
		end 'rangeHeader'

		// ⭐ **A COUNTED RANGE'S BOUNDS MUST BE INTEGERS**, asked here — the moment both are in hand and
		// before a single block of the loop exists, so a refused program emits no op. See
		// `requireCountableRangeBound`: without it a `float` range PANICKED in the x64 emitter and a
		// `bool` range was silently accepted.
		if src.isRange 'countedRange'
			try self.requireCountableRangeBound(source, anchor: self.tokenAt(sourceStart))
			try self.requireCountableRangeBound(src.limit, anchor: self.tokenAt(src.testAnchorIndex))
		end 'countedRange'

		// ⭐ **ONLY A COLLECTION SOURCE IS HELD** (`noteLoopHeldBinding` below). A RANGE's bounds are
		// snapshotted into the preheader above and the loop variable is the header phi, so a write to a
		// bound's variable inside the body cannot reach the loop (`specs/for-range-bound-mutation.md`).
		// ⭐ **A STRING SOURCE IS ITS OWN THIRD FORM** — neither a counted range nor an array.
		// It hands the body a value it MINTS rather than one the source stores (see the ownership note on the
		// element read below). What it does share with the array form is that its source is a heap record
		// evaluated once into the preheader.
		// ⭐⭐ **A LIST SOURCE IS NOT A FORM OF ITS OWN — IT TAKES THE CURSOR FORM BELOW.**
		// A corpus `List` declares `Iterable with (Element, ListIter)`, so it is rewritten to its own `ListIterator` by
		// `materializeIterableIterationSource` before this fork is reached and takes the CURSOR form below,
		// exactly as a corpus `Array` and a corpus `Map` already do.
		//
		// ⭐ **THE COMPLEXITY THE OLD FORM EXISTED TO GUARANTEE IS UNCHANGED, WHICH IS WHY THIS IS NOT A
		// REGRESSION DRESSED AS A SIMPLIFICATION.** `/specs/list.md`'s *"a cached cursor … O(1) per element"* is
		// a statement about the traversal holding a NODE between trips, and `ListIterator` holds exactly that
		// (`var node as ENode`, advanced through `next()`). The shape this must never take — a counter over
		// `get(i)`, O(n²) — is not what a declared cursor does either.
		// ⭐⭐ **A CURSOR-PROTOCOL USER TYPE IS THE FIFTH FORM, AND IT IS THE ONLY ONE THE SOURCE WALKS ITSELF**
		// (conditional extensions). The other four are compiler-owned records whose traversal this function
		// BUILDS — an ordinal, a byte position, a node pointer. Here the source supplies it: the body reads
		// `current()` and the step calls `advance()`, and the header's block-arg carries `advance`'s ERROR FLAG
		// rather than a position at all. `none` when the source is not one; the SURFACE is carried (not a bool)
		// because the two calls need it — a struct source emits direct calls and an EXISTENTIAL dispatches
		// through the table it carries. See `cursorIterationSurface`.
		//
		// ⭐⭐ **IT IS A DO-WHILE AND THE OTHER FOUR ARE WHILE LOOPS, AND THAT IS THE PROTOCOL'S OWN CONTRACT.**
		// `stdlib/Interfaces.maxon:130-142`: a live cursor is ALREADY POSITIONED on an element — its constructor
		// throws `exhausted` for an empty collection rather than producing an empty cursor — and `advance()`
		// throws when called while positioned on the LAST element, leaving the position unchanged. So the first
		// element must be yielded BEFORE the first advance, which falls out of seeding the flag to 0 in the
		// preheader and computing the next flag in the STEP: a while-shaped loop would advance first and drop
		// element 0. `partial-availability` counting exactly 2 over a 2-element sequence is the arity check on it.
		// What the header's error-flag block-arg starts at for a CURSOR source. `atTheFirstElement` is the
		// bare cursor form's literal 0 — "no throw yet", which is what makes the first trip unconditional — and
		// `fromFactory` is a throwing `createIterator()`'s own flag, so an empty collection reports itself
		// through the loop's ordinary exit test. See `materializeIterableIterationSource`.

		// ⭐⭐ **THE CURSOR GETS A SCOPE OF ITS OWN, AND THE SOURCE EXPRESSION'S TEMPORARIES STAY OUTSIDE IT.**
		// `forMark` above holds everything the SOURCE EXPRESSION enrolled — a record `keepFieldSourceAliveForItsRead`
		// held alive so a field could be read out of it, which is what `for pair in makeBox().entries` produces — and
		// those exist on EVERY path out of this statement. The cursor, when there is one, exists only on the path
		// that got one: a throwing `createIterator()` reports an empty collection by throwing, and that edge
		// (`emitEmptyIterableEntry`) must not reach a `__destruct_<Cursor>`.
		//
		// ⛔⛔ **THE TWO USED TO SHARE ONE FRAME, AND THE EMPTY EDGE THEREFORE SKIPPED BOTH — A LEAK.** MEASURED on
		// thirty lines of user code with no stdlib container type in it: `for (k, v) in h.boxed().m` over an EMPTY
		// `Map` exits **101**, where the same loop over a one-entry map exits 0 and the same empty map through a
		// `let b = h.boxed()` binding exits 0. The record `h.boxed()` returned was released in `forexit` and nowhere
		// else, so a zero-trip loop never released it. `stdlib/helpers/http/httpHelpers.maxon`'s
		// `for (hdrName, hdrValue) in request.headers().headers` is exactly that shape over a request with no
		// user headers, so every `HttpClient.get` leaked one `HttpHeaders`.
		//
		// ⚠ It is a nested BLOCK rather than a recorded height because the two batches must be emitted into two
		// DIFFERENT blocks off one list: `closeBlock` is what takes the cursor off `ownedBindings` between them, so
		// the second emission cannot name it. A range opens an empty one and pays nothing — it enrols no cursor and
		// has no empty edge — and the exit's drops come out in the order they always did (cursor first, then the
		// source's temporaries in reverse), because that is the order one call over the shared list produced.
		let cursorMark = self.openBlock()
		let loopHeldMark = self.bodyState.loopHeldBindings.count()
		let walkedSource = source

		if not src.isRange 'collectionSource'
			self.noteLoopHeldBinding(sourceStart)

			// ⚠ **A `Map` NEEDS NO REWRITE OF ITS OWN.** A corpus `Map` declares `Iterable` and its
			// `MapIterator` hands out the pair itself, so it takes the cursor rewrite below like every other
			// declared iterable.
			//
			// ⭐⭐ **AN `Iterable` SOURCE BECOMES ITS CURSOR, AND THEN IT IS A CURSOR LIKE ANY OTHER.** See
			// `materializeIterableIterationSource` for why the ENTRY SEED travels with the cursor.
			let iterable = try self.materializeIterableIterationSource(source, sourceDeferralFloor: sourceDeferralFloor, sourceOpFloor: sourceOpFloor, forTok: forTok)
			source = match iterable 'walkedValue'
				notIterable gives source
				cursor(iterator, _) gives iterator
			end 'walkedValue'

			src.cursorEntrySeed = match iterable 'walkedSeed'
				notIterable gives src.cursorEntrySeed
				cursor(_, seed) gives CursorEntrySeed.fromFactory(seed)
			end 'walkedSeed'

			// ⭐ **RESOLVED HERE AND HANDED TO THE ADMISSION TEST, so the door that REFUSES and the fork that
			// EMITS read one answer.** Resolving it separately at each is two chances to admit on one reading and
			// emit on another.
			//
			// ⚠ It is NOT the only resolution in this statement, and saying so would be false:
			// `materializeIterableIterationSource` above resolves a surface of its own, necessarily — it runs on
			// the source BEFORE the rewrite and this one describes the cursor AFTER it, so they are surfaces of
			// two different values. What is shared is the FUNCTION, so they cannot disagree; what is not shared
			// is the cost, and for a witness-dispatched source each ask walks the slot list per protocol name.
			src.cursorSurface = try self.cursorIterationSurface(source, forTok: forTok)
			try self.requireIterableSource(source, cursorSurface: src.cursorSurface, forTok: forTok)
			src.isString = tagIsText(self.tagOf(source))

			if not methodSurfaceExists(src.cursorSurface) and not self.pendingTempsContain(source) and self.valueIsManagedHeap(source) and not self.forSourceIsHeldByItsName(sourceStart) 'theLoopHoldsTheSource'
				self.holdLoopSource(source, range: SourceRange.ofToken(forTok))
			end 'theLoopHoldsTheSource'

			// ⭐ **AN OWNED ARRAY TEMPORARY BECOMES AN OWNED BINDING OF THIS FRAME.** `for x in [1,2,3]`
			// / `for x in build()` produces a record the statement owns; left in `pendingTempDrops` it
			// would be dropped by the FIRST `return` inside the body (which drains the WHOLE list,
			// `emitHandoffExit`) and then LEAK on the fall-through path, because the list is empty
			// by the time the exit block drains it. As a binding it is dropped exactly once on every
			// exit: the loop's own `end` (`emitScopeDrops` below), a `return`/`throw` out of the body
			// (the whole binding stack, with the list restored afterwards so this path still drops it),
			// and never by a `break` (whose floor is the BODY's height, above this one).
			//
			// ⚠ The gate is `pendingTempsContain`, NOT `valueIsOwnedHeap`, and the difference is a
			// DOUBLE FREE: `var arr = IntArray.create()` is an owned VALUE whose drop a binding already
			// owes, so adopting it here too emitted two `__managed_decref`s into the exit block (measured —
			// `for-in-iteration` segfaulted). The pending list is exactly the owned values NO binding
			// owns (see `pendingTempsContain`), which is the question being asked — and it is asked
			// inside `giveTemporaryScopeLifetime`, the ONE door this promotion has.
			self.giveTemporaryScopeLifetime(source, name: IterationSourceBindingName)
		end 'collectionSource'

		self.heldAwaits.truncate(sourceClaim.heldAwaitMark)

		// Every OTHER temporary the source expression built — an interpolation handed to a factory call
		// — belongs to this statement and dies here, in the preheader, exactly as a `while` condition's
		// does. It is released BEFORE the loop rather than at the exit for the reason above: a `return`
		// inside the body would otherwise take the whole list with it.
		self.drainPendingTemps(sourceTempFloor, anchor: forTok)

		let header = self.artifact.module.addBlock(func, label: b"forhdr", heat: BlockHeat.normal)

		// ⭐ **THE INDEX PHI IS A HEADER BLOCK-ARG, NOT A CARRIED BINDING**, and it is minted FIRST so
		// `header.blockArgs` reads [index, …carried]. It is DEFINED in the header, which dominates the
		// body, the step and the exit, so no other edge has to carry it: only the preheader's entry edge
		// and the step's back edge name it, and both are built right here. That is what lets
		// `break`/`continue` and `wireLoopExit` go on using `edgeArgsFor` unchanged.
		//
		// A RANGE's index IS the user's loop variable, so it takes the START bound's type (a ranged
		// alias stays one). An ARRAY's index is a compiler-owned counter and is a plain integer.
		let counterBound = self.counterTypeBound(source, limit: src.limit) if src.isRange else source
		let indexTag = self.tagOf(counterBound) if src.isRange else ValueTypeTag.integer
		let indexNameId = self.valueNameId(counterBound) if src.isRange else UnnamedTypeId
		let indexPhi = self.mintPhi(header, tag: indexTag, nameId: indexNameId)

		if src.isRange and counterBound != source and not src.isCharacterRange 'startAdoptsTheLimitsAlias'
			self.recordRangeCheckSite(source, destination: self.typeOf(counterBound), line: self.tokenAt(sourceStart).line, column: self.tokenAt(sourceStart).column)
		end 'startAdoptsTheLimitsAlias'

		if src.isRange and not src.isCharacterRange and not src.rangeInclusive 'aHalfOpenRange'
			self.markCounterBoundedByItsAlias(indexPhi, start: source, limit: src.limit, startAdopted: counterBound != source)
		end 'aHalfOpenRange'

		// The carried set is selected against `mutableVars` HERE, not at the extent scan above. Nothing between
		// the two pushes a `var` (the source expression declares no binding, and the loop variable is bound in
		// the body), so the two points agree — reading it here is what keeps them agreeing.
		let phiVars = self.mintLoopHeaderPhis(header, carried: self.assignedBindingsIn(forIndex, endIndex: bodyEndIndex))

		// The preheader is `currentBlock`, not `block`: a short-circuit `and`/`or` inside a bound leaves
		// control in a fresh merge block, and the entry edge belongs on the block control is actually in.
		// ⭐ **THE HEADER'S CARRIED POSITION, WHICH IS NOT THE SAME KIND OF THING IN ALL FOUR FORMS.** A RANGE
		// carries the user's own loop variable, an ARRAY and a STRING a compiler-owned index starting at 0, and
		// a USER CURSOR the last `advance()`'s ERROR FLAG, seeded 0 (no throw yet) so its first test always
		// enters the body. The cursor takes the zero-literal arm the counted forms take, and that coincidence of
		// value is not a coincidence of meaning: 0 is "index 0" for one and "no error" for the other, and both
		// are what the preheader owes its header.
		var firstIndex = source

		if not src.isRange 'counterStartsAtZero'
			firstIndex = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
		end 'counterStartsAtZero'

		// The carried bindings' PRE-loop values, captured here because the empty-`Iterable` edge below needs
		// them again at the join and the bindings themselves are rebound as the body is parsed.
		let entryCarried = self.edgeArgsFor(phiVars, preLoop: true)
		self.recordBranchEdge(self.bodyState.currentBlock, targetId: header.id, argIds: self.loopHeaderArgs(firstIndex, carried: entryCarried))
		let scanIndex = self.openLoopScan(header, preheader: self.bodyState.currentBlock, phiVars: phiVars)

		// ⭐⭐ **AN EMPTY `Iterable` SKIPS THE LOOP *AND ITS CURSOR'S DROP***, which is why this is a BRANCH
		// and not a seeded flag. A throwing `createIterator()` reports emptiness by throwing
		// (`stdlib/Interfaces.maxon:132-134`), and on that path it returned NO cursor — so the exit block's
		// drop of the cursor must not run.
		//
		// ⚠ **IT SKIPS THE CURSOR'S DROP AND NOT "THE EXIT DROPS", AND A LEAK IS WHAT THE DIFFERENCE COSTS.**
		// The exit releases TWO batches and only one of them is conditional on
		// having got a cursor; the other is the SOURCE EXPRESSION's temporaries, built in this preheader above
		// the branch and live on both edges. `cursorMark` is what separates them and
		// `joinAfterEmptyIterable` is where this edge pays its half.
		//
		// ⚠ **MEASURED, seeding the header's error flag with the factory's instead:**
		// the loop correctly ran zero trips and then `__destruct_<Cursor>` was called on the throw path's
		// leftover return register — **SIGSEGV**, on `for v in <an empty Iterable>`. Seeding gets the CONTROL
		// FLOW right and says nothing about OWNERSHIP, and the compiler's ownership is static: one owner, dropped at
		// one point, with no conditional-drop form to express "only if it was created". So the path that owns
		// nothing must not reach the point that drops.
		var emptyExit = EmptyIterableExit.none

		match src.cursorEntrySeed 'entry'
			atTheFirstElement then self.emitBranch(self.bodyState.currentBlock, targetId: header.id)
			fromFactory(flag) then emptyExit = EmptyIterableExit.entered(self.emitEmptyIterableEntry(func, flag: flag, header: header, forTok: forTok))
		end 'entry'

		// The loop test, in the header. For a range it is the user's own comparison against the upper
		// bound and goes through `emitCompare`, so `for i in 1 to "x"` is the ordinary comparison type
		// error; for an array it is `idx < __managed_count(arr)`, both operands compiler-minted integers.
		//
		self.bodyState.currentBlock = header
		var bound = src.limit
		var testOp = MaxonCmpOp.le if src.rangeInclusive else MaxonCmpOp.lt

		// ⭐ **A USER CURSOR'S TEST IS `flag == 0`** — "the last `advance()` did not throw" — and it is the one
		// form that needs no length read, because the value the header carries already IS the end condition.
		// The preheader seeds it 0 (see `firstIndex` above), which is what makes the FIRST trip unconditional —
		// the do-while this form's header argues for.
		if methodSurfaceExists(src.cursorSurface) 'cursorStillPositioned'
			bound = self.emitLiteral(NoErrorFlag, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
			testOp = MaxonCmpOp.eq
		end 'cursorStillPositioned'

		if not src.isRange and not methodSurfaceExists(src.cursorSurface) 'lengthReadLive'
			// ⭐ **THE LENGTH IS RE-READ LIVE IN THE HEADER for a String too** — `length@8` off the record,
			// the same discipline the array form's live `__managed_count` follows and for the same reason: the
			// header comparison IS the bounds check that licenses the unchecked read below it.
			//
			// ⚠ The String's index is a BYTE position, not a cluster ordinal, so the header asks "is there a
			// byte left?", the same condition `countGraphemes` loops on (`while pos < len`). A cluster
			// ordinal would need the count, which costs a whole extra scan.
			bound = self.emitLoadStringField(source, offset: StringLengthOffset, range: SourceRange.ofToken(forTok)) if src.isString else self.emitRuntimeCall(ManagedCountName, args: argsOf(source), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(forTok))
		end 'lengthReadLive'

		let cond = try self.emitCompare(indexPhi, rhs: bound, op: testOp, opTok: self.tokenAt(src.testAnchorIndex))

		let loopLabelTok = try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		let body = self.artifact.module.addBlock(func, label: loopLabelTok.value, heat: BlockHeat.normal)
		let step = self.artifact.module.addBlock(func, label: b"forstep", heat: BlockHeat.normal)
		let exit = self.artifact.module.addBlock(func, label: b"forexit", heat: BlockHeat.normal)

		// ⭐ **THE COUNTER THE BODY SEES** — the header phi itself for every form but one; a block-arg of its
		// own for a counted range over constant bounds, which is what lets that loop's interval be recorded
		// against a value rather than against a program point. See `mintCountedBodyCounter`.
		var bodyCounter = indexPhi

		if src.isRange and not src.isCharacterRange 'aCountedIntegerRange'
			bodyCounter = self.mintCountedBodyCounter(body, header: header, start: source, limit: src.limit, inclusive: src.rangeInclusive, indexPhi: indexPhi, tag: indexTag, nameId: indexNameId)

			if bodyCounter != indexPhi and valueIsMarked(self.bodyState.boundedCounters, value: indexPhi) 'aBoundedCounterOfItsOwn'
				self.bodyState.boundedCounters = withValueMarked(self.bodyState.boundedCounters, value: bodyCounter)
			end 'aBoundedCounterOfItsOwn'
		end 'aCountedIntegerRange'

		self.emitCondBranch(header, cond: cond, thenId: body.id, elseId: exit.id, ifTok: forTok)

		// ⭐⭐ **THE PER-TRIP FRAME, AND IT EXISTS FOR THE STRING FORM ALONE.** A range's loop variable is the
		// header phi and an array's is a BORROW the array still owns — neither owns anything, so for those
		// two this frame opens and closes empty and emits not one op. A STRING's element is different in
		// kind: it is MINTED fresh every trip (`__char_at` allocates a record), so exactly one owner exists
		// and this loop is it, once per iteration.
		//
		// ⚠ **IT IS A FRAME AND NOT A LIST OF DROP SITES, AND THAT IS THE WHOLE POINT.** Four paths leave a
		// trip — the body's fall-through, `continue`, `break`, and a `return`/`throw` out of the body — and
		// every one of them already drains owned bindings down to a MARK. Enrolling the element as an
		// ordinary owned binding of its own frame therefore makes all four correct by construction, where a
		// per-site drop would be a hand-maintained door list of exactly the kind that has already been
		// wrong twice.
		//
		// The ORDER of the three lines below is load-bearing and each is a different exit path:
		//   • the frame opens BEFORE the element is minted, so `closeBlock` below pops it and the loop's
		//     own `end` (which drains `forMark`) does NOT drop a value that is dead by then — and could
		//     not name it anyway, since the element is defined in the body and does not dominate the exit;
		//   • `ownedFloor` is captured from THIS mark rather than after the enrolment, so `break`/`continue`
		//     (`dropTargetBodyOwned`) drain THROUGH the element rather than stopping above it;
		//   • the fall-through drain below uses the same mark, which is the one path with no drop of its own.
		let tripMark = self.openBlock()

		// `ownedFloor` is the per-trip frame's height — so a `break`/`continue` releases the body's
		// declarations AND the trip's minted element, and leaves the iteration source (enrolled below this
		// mark) for the exit.
		self.bodyState.loops.push(LoopContext.create(loopLabelTok.value, continueTargetId: step.id, exitId: exit.id, phiVars: phiVars, ownedFloor: tripMark.ownedCount, scanIndex: scanIndex, debugOpenFloor: self.bodyState.debugOpenSlots.count(), windowFloor: self.openWindowCount()))

		// The loop variable: the index itself for a range, a BORROWED element read for an array, a MINTED
		// grapheme cluster for a String. `_` is the discard (`DiscardBindingName`) and binds nothing at all
		// — declaring it would make an ordinary `_ = f()` discard statement inside the body a write to a
		// `let`.
		self.bodyState.currentBlock = body
		var loopValue = bodyCounter
		var graphemeEnd = indexPhi

		// The element is not the counter the stand-in range steps: every body consumer already has an arm for
		// `unresolved`, where an `int` element earns a refusal of its own — a destructuring pattern rejects
		// "a 'int' element", a method call "'int' has no method" — in front of E3004.
		if src.sourceIsDeferred 'deferredCallElement'
			loopValue = self.mintDeferredValue()
		end 'deferredCallElement'

		// ⭐ **A CHARACTER RANGE MINTS ITS ELEMENT FROM THE COUNTER**, where a String mints it from a byte
		// range — two producers of the SAME owned per-trip Character, which is why the ownership below is
		// asked once for both rather than beside each. See `GraphemeRuntime.buildCharFromCodepoint`.
		if src.isCharacterRange 'mintFromCodepoint'
			loopValue = self.emitRuntimeCall(CharFromCodepointName, args: argsOf(indexPhi), resultTag: ValueTypeTag.character, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(patternTok))
		end 'mintFromCodepoint'

		if src.isString 'readCluster'
			graphemeEnd = self.emitLabelledRuntimeCall(CorpusFindGraphemeEnd, args: twoArgs(source, second: indexPhi), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(patternTok), argLabels: corpusFindGraphemeEndLabels())
			loopValue = self.emitRuntimeCall(CharAtName, args: threeArgs(source, second: indexPhi, third: graphemeEnd), resultTag: ValueTypeTag.character, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(patternTok))
		end 'readCluster'

		if src.isString or src.isCharacterRange 'ownsTheTripsCharacter'
			// ⭐⭐ **THE OWNERSHIP RULING: A MINTED CHARACTER IS OWNED, WHERE AN ARRAY'S ELEMENT IS BORROWED — and
			// the difference is not a preference, it is a fact about where the value lives.** An array's element can be
			// borrowed because the ARRAY KEEPS the element and its own `__managed_decref` walk destroys it, so
			// there is an owner to borrow from. A String's grapheme clusters are stored NOWHERE (the record
			// holds bytes, and a Character is a record) and a character RANGE stores nothing at all — it has
			// only a counter — so in both the value the body sees did not exist until `__char_at` /
			// `__char_from_cp` built it. A minted value has exactly one owner and it is this trip.
			//
			// Enrolled even when the name is `_`, and that is not an oversight: the discard binds no NAME
			// but the record was still allocated, so the drop is owed regardless of whether anything could
			// read it. (`for _ in s` is exactly `grapheme-clusters/grapheme-boundary-combining-iteration`,
			// and `for _ in 'a' to 'e'` is `ranges/ranges.character-range` — both count without looking at one,
			// and both would leak every character they counted.)
			//
			// ⚠ **THE PROVENANCE BIT AND THE BINDING ARE BOTH REQUIRED, AND THE BINDING ALONE IS NOT ENOUGH.**
			// `ownedBindings` is what DROPS the value; `markValueOwnsHeap` is what makes every other owner-
			// aware rule recognize it as owned — above all `reassignBindingValue`, which asks
			// `valueIsOwnedHeap` to decide MOVE-vs-COPY. Without the bit, `found = c` promoted a COPY of the
			// cluster (a second `__mm_alloc` per trip) and left the original with no owner, which the leak
			// gate caught as exit 101. `markValueOwnsHeap` rather than `trackOwnedTemp` for the reason a
			// consumed parameter uses it: this value already drops through `ownedBindings`, and enrolling it
			// in `pendingTempDrops` as well would drop it a SECOND time at the statement's end.
			//
			// A DESTRUCTURING header owns the cluster under the loop's own element name, because no name the
			// source wrote holds the whole element. That program is refused a few lines below anyway (a
			// Character is not a tuple), and the enrolment runs first — so the label has to be a name, and
			// the honest one is the one the element already has where nothing spells it.
			// `sole` — the record did not exist until `__char_at`/`__char_from_cp` built it one line up, which is
			// the paragraph above's whole argument ("a minted value has exactly one owner and it is this trip").
			self.markValueOwnsHeap(loopValue, exclusivity: OwnedHeapExclusivity.sole)
			self.enrolOwnedBinding(VarInfo.createValueBinding(self.loopVariableOwnerName(nameToks), varType: self.typeOf(loopValue), kind: BindingKind.let, boundValue: loopValue))
		end 'ownsTheTripsCharacter'

		// ⭐ **THE INDEXED-CONTAINER FORM READS ITS ELEMENT THROUGH THE SHARED ACCESSOR**: the carried header
		// value is an ordinal into the record's buffer, the read hands back a BORROW the container still owns,
		// and it is the UNCHECKED read the header's own test licenses — ownership and type are
		// `emitContainerElementAccessor`'s one answer.
		//
		// ⚠ **A `List` DOES NOT SHARE THIS DOOR.** A corpus `List` is a declared `Iterable`, so it reads its element
		// through `current()` like every other cursor, where this door reads `__managed_get_unchecked` off an
		// ordinal.
		if not src.isRange and not src.isString and not methodSurfaceExists(src.cursorSurface) 'readElement'
			loopValue = try self.emitContainerElementAccessor(ManagedGetUncheckedName, container: source, args: twoArgs(source, second: indexPhi), giid: self.valueInstanceId(source), reference: ContainerElementReference.borrowed, range: SourceRange.ofToken(patternTok))
			self.emitEmptySlotElementGuard(func, source: source, element: loopValue, index: indexPhi, forTok: forTok)
			self.adaptBorrowedElement(loopValue, receiver: source)
			self.noteElementReadFromAPart(loopValue, source: source, startIndex: sourceStart, endIndex: src.sourceEnd)
			let borrowedElement = loopValue
			loopValue = self.holdLoopElement(borrowedElement, nameToks: nameToks, range: SourceRange.ofToken(patternTok))
			self.carryIsolatedPartRead(loopValue, arm: borrowedElement)
		end 'readElement'

		// ⭐⭐ **A CURSOR'S ELEMENT IS WHATEVER `current()` RETURNS, AND ITS OWNERSHIP IS THAT CALL'S ANSWER —
		// NOT A THIRD RULE HERE.** The other four forms each needed one: an array/list element is a BORROW the
		// container keeps, a String's cluster is MINTED and owned by the trip. This one is an ordinary user
		// call, so `emitCall` has already decided — a scalar owns nothing, a managed return is tracked as
		// an owned pending temporary. All this arm adds is the LIFETIME: a pending temp is dropped at the
		// STATEMENT's tail, which for a value the body may hold across the whole trip is too early on one path
		// and (once a `return` inside the body drains the list) a leak on another. `giveTemporaryScopeLifetime`
		// re-scopes it to the per-trip frame, where all four trip exits already drop to a mark — and it is a
		// silent no-op on the scalar case, which is why the call is unconditional rather than gated on a
		// managed-return test that would be a second opinion about what the call minted.
		if methodSurfaceExists(src.cursorSurface) 'readCursorElement'
			src.claimsWithIteratorPromise = not self.patternNamesOneWholeElement(nameToks) and self.pairsAnArrayIteratorWithAPromise(source)
			let savedClaim = self.bodyState.loopClaimsWithIteratorPromise
			self.bodyState.loopClaimsWithIteratorPromise = src.claimsWithIteratorPromise
			loopValue = try self.emitReceiverProtocolCall(src.cursorSurface, methodName: CurrentMethodName, anchor: patternTok, resultUsed: true, origin: src.cursorEntrySeed.receiverOrigin())
			self.bodyState.loopClaimsWithIteratorPromise = savedClaim
			self.giveTemporaryScopeLifetime(loopValue, name: IterationElementBindingName)

			if self.valueIsACorpusList(src.iterated) 'aListElementIsABorrowFromTheList'
				self.adaptBorrowedElement(loopValue, receiver: src.iterated)
			end 'aListElementIsABorrowFromTheList'

			self.noteElementReadFromAPart(loopValue, source: src.iterated, startIndex: sourceStart, endIndex: src.sourceEnd)

			if self.tagOf(loopValue) == ValueTypeTag.typeParameter and src.cursorSurface.dispatchesThroughAWitness() 'aWitnessTableCarriesNoDescriptor'
				self.bodyState.witnessCursorElements = withValueMarked(self.bodyState.witnessCursorElements, value: loopValue)
			end 'aWitnessTableCarriesNoDescriptor'
		end 'readCursorElement'

		// Unconditional: the loop is the handed-back source's consumer, and each element it hands out carries
		// its own part-read mark (`noteElementReadFromAPart`).
		self.withdrawHandedBack(argsOf(src.iterated))

		// ⭐⭐ **ONE PATTERN POSITION IS BOUND TO ONE VALUE, AND A DESTRUCTURING HEADER SIMPLY HAS MORE OF
		// THEM.** A single name takes the element WHOLE; `for (key, value) in m` takes one tuple FIELD
		// each, which is the desugaring `parseDestructuringBinding` already writes for `let (x, y) = t` —
		// a field load per name, and nothing else.
		//
		// ⭐ **AND IT NEEDS NO HIDDEN BINDING, WHERE `let (x, y) = t` DOES.** That one binds the box to an
		// unspellable name because the RHS is a freshly built tuple SOME binding has to drop. A loop element is
		// a BORROW the container still owns (`emitContainerElementAccessor`, `borrowed`) — its `__managed_decref`
		// walk destroys every pair — so there is no ownership obligation here to give a name to.
		if self.patternNamesOneWholeElement(nameToks) 'bindTheWholeElement'
			try self.declareLoopVariable(self.soleLoopVariableName(nameToks), value: loopValue, writable: elementsAreWritable, elementQualifier: src.elementQualifier, storedKey: storedKeyOnly(storedKeyCursorOf(src.cursorSurface), wanted: StoredKeyCursor.setElements))
		end 'bindTheWholeElement' else 'bindEachDestructuredName'
			try self.declareDestructuredLoopVariables(nameToks, loopValue: loopValue, claimsWithIteratorPromise: src.claimsWithIteratorPromise, patternTok: patternTok, forTok: forTok, writable: elementsAreWritable, elementQualifier: src.elementQualifier, firstStoredKey: storedKeyOnly(storedKeyCursorOf(src.cursorSurface), wanted: StoredKeyCursor.mapEntries))
		end 'bindEachDestructuredName'

		let heldBodyStart = self.bodyState.currentBlock
		let drainsItsSource = self.loopDrainsItsSource(loopValue, isRange: src.isRange)
		let drainedValue = self.drainedSourceValue(sourceStart, walked: walkedSource)
		let sourceGiven = self.capabilityOfValue(drainedValue)

		let outerDrainingLabel = self.statement.drainingLabel

		if drainsItsSource 'readOnlyInTheBody'
			self.setValueCapability(drainedValue, capability: ValueCapability.paused)
			self.statement.drainingLoops = self.statement.drainingLoops + 1
			self.statement.drainingLabel = loopLabelTok.value
		end 'readOnlyInTheBody'

		let bodyEnd = try self.parseBlockBody(func, block: heldBodyStart, label: loopLabelTok.value)

		if drainsItsSource 'writableAgain'
			self.setValueCapability(drainedValue, capability: sourceGiven)
			self.statement.drainingLoops = self.statement.drainingLoops - 1
			self.statement.drainingLabel = outerDrainingLabel
		end 'writableAgain'

		// Guard the token scan against the parse it predicted — see `assertScanAligned`.
		self.assertScanAligned("parseForStatement", predictedEnd: bodyEndIndex)

		// A `var`: the step block rebinds its carried bindings through `ctx.phiVars`.
		let ctx = try self.bodyState.loops.pop() otherwise panic("parseForStatement: loop stack empty after body of '{String.from(loopLabelTok.value)}'")

		// The step block, read off the context rather than spelled again — see `parseWhileStatement`'s
		// fall-through for why the two loop parsers share that derivation.
		//
		// ⚠ **THE FALL-THROUGH IS THE ONE TRIP EXIT WITH NO DROP OF ITS OWN**, so it takes the per-trip
		// frame's drain here — `break`/`continue` already emitted theirs down to `ctx.ownedFloor` (which IS
		// this mark), and a `return`/`throw` drained the whole binding stack. It is skipped on a TERMINATED
		// `bodyEnd` for `parseBlockBody`'s reason: one of those three has already run, and dropping again
		// would double-free.
		if not bodyEnd.isTerminated() 'fallsToStep'
			self.bodyState.currentBlock = bodyEnd
			self.emitScopeDrops(bodyEnd, floor: tripMark.ownedCount, anchor: forTok)
			self.noteLoopBackEdge(bodyEnd, height: tripMark.ownedCount)
			self.recordBranchEdge(bodyEnd, targetId: ctx.continueTargetId, argIds: self.edgeArgsFor(phiVars, preLoop: false))
			self.emitBranch(bodyEnd, targetId: ctx.continueTargetId)
		end 'fallsToStep'

		// The per-trip frame closes BEFORE the step/exit wiring: its element is dead past the body, and
		// leaving it enrolled would let the exit block's own drain (`forMark`) name a value that the exit
		// does not dominate.
		self.closeBlock(tripMark, endsIn: bodyEnd)

		// ⭐ **THE STEP BLOCK IS A MERGE, so it carries phis of its own.** Its predecessors are the
		// body's fall-through AND every `continue`, and a carried `var` assigned before a `continue`
		// holds a different value on each — the same shape the exit has for `break` (`wireLoopExit`).
		// The INDEX needs none: it is defined in the header, which dominates the step.
		self.bodyState.currentBlock = step

		for k in 0 upto ctx.phiVars.count() 'mkStepPhi'
			let pv = try ctx.phiVars.get(k) otherwise panic("parseForStatement: phiVars.get OOB at {k}")
			let stepPhiId = self.mintPhiForBinding(step, binding: pv.binding)
			self.recordDebugRebind(pv.binding.debugLocalSlot, recorded: pv.binding.debugLocalRecorded, current: pv.binding.boundValue, value: stepPhiId, def: DebugVersionDef.definedIn(step.id))
			pv.binding.setBoundValue(stepPhiId, ledger: self.bodyState.moveLedger)
		end 'mkStepPhi'

		// ⭐ **WHAT ONE STEP IS.** A range and an array advance by ONE (an ordinal); a String advances to the
		// END OF THE CLUSTER the body just saw, because its index is a BYTE position and a cluster is
		// 1..18 bytes wide. `graphemeEnd` is computed in the body's first block, which dominates the step
		// (every predecessor of the step — the fall-through and every `continue` — is inside the body), so
		// it is read straight rather than carried on a phi. Computing it again here would run the whole
		// UAX #29 scan a second time per trip.
		//
		// ⭐⭐ **A USER CURSOR ADVANCES BY CALLING `advance()`, AND ITS ERROR FLAG *IS* THE NEXT CARRIED
		// VALUE.** The step is exactly where that call belongs: every path that continues the loop — the
		// body's fall-through and every `continue` — lands here, so the cursor moves exactly once per
		// trip however the body was left, which is the same argument the step block itself rests on. A
		// throw therefore ends the loop NORMALLY (the header's next test fails) rather than escaping it,
		// so `has()` need not declare `throws` to iterate — the contract `stdlib/Interfaces.maxon`
		// states.
		var nextIndex = graphemeEnd

		if methodSurfaceExists(src.cursorSurface) 'cursorAdvanceStep'
			(_, nextIndex) = try self.emitProtocolTryCall(src.cursorSurface, methodName: AdvanceMethodName, anchor: forTok, resultUsed: false, origin: src.cursorEntrySeed.receiverOrigin())
		end 'cursorAdvanceStep' else 'builtinSourceStep'
			if not src.isString 'ordinalStep'
				let one = self.emitLiteral(1, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
				nextIndex = self.emitMachineWordBinOp(indexPhi, rhs: one, op: MaxonBinOp.add, resultType: MaxonType.integer, range: SourceRange.ofToken(forTok))

				if src.skipsSurrogateBlock 'skipSurrogateBlock'
					nextIndex = self.emitSurrogateBlockSkip(nextIndex, range: SourceRange.ofToken(forTok))
				end 'skipSurrogateBlock'
			end 'ordinalStep'
		end 'builtinSourceStep'

		self.recordBranchEdge(step, targetId: header.id, argIds: self.loopHeaderArgs(nextIndex, carried: self.edgeArgsFor(phiVars, preLoop: false)))
		self.emitBranch(step, targetId: header.id)

		// The header carries the two-way branch, so it is the exit's false-edge source. Run AFTER the
		// step wiring: `wireLoopExit` settles each carried binding's POST-loop value, and the step loop
		// above sets those same fields to its own phis on the way through.
		let finished = try self.finishLoopMoves(func, falseSource: header, exit: exit, anchor: forTok)
		self.wireLoopExit(finished.falseEdge, exit: exit, ctx: ctx)

		// The loop variable and the iteration source's binding both leave scope here — the drops for the
		// latter land in the exit block, which every non-terminating path through the loop reaches.
		//
		// ⭐ TWO EMISSIONS, AND THEY GO TO TWO DIFFERENT BLOCKS. The CURSOR is the loop's own and dies in the
		// exit, which only a path that got one can reach; the SOURCE EXPRESSION's temporaries die at the
		// statement's single CONTINUATION, which is that same exit when the loop is the only way out and the
		// JOIN when an empty `Iterable` supplies a second entry edge. Splitting them is the whole point —
		// see `cursorMark` for the leak one shared frame cost.
		//
		// The cursor's frame is closed BETWEEN the two so the second emission cannot name it again, and the
		// decrefs come out in the order one call over the shared list produced (that call walked in reverse
		// and the cursor was its top entry). A loop whose source enrolled nothing emits nothing here, which
		// is every loop in the corpus that does not read a field out of a call result.
		self.bodyState.currentBlock = exit
		self.emitScopeDrops(exit, floor: cursorMark.ownedCount, anchor: forTok)
		self.closeBlock(cursorMark, endsIn: self.bodyState.currentBlock)

		// The empty-`Iterable` path rejoins at a JOIN, PAST the cursor's drop — see `emitEmptyIterableEntry`.
		// EACH ARM LEAVES THE PARSER IN THE STATEMENT'S CONTINUATION and releases the source expression's
		// temporaries INTO it, which is why the two are one decision rather than a block computed here and a
		// drop emitted after: the block that drops is the block control is in.
		match emptyExit 'emptied'
			none then self.emitScopeDrops(exit, floor: forMark.ownedCount, anchor: forTok)
			entered(empty) then self.joinAfterEmptyIterable(func, empty: empty, exit: exit, entryCarried: entryCarried, phiVars: phiVars, sourceFloor: forMark.ownedCount, forTok: forTok, skippedMark: self.markOfASkippedLoop(finished.scan, height: cursorMark.ownedCount))
		end 'emptied'

		self.bodyState.loopHeldBindings.truncate(loopHeldMark)
		self.closeBlock(forMark, endsIn: self.bodyState.currentBlock)
		return self.bodyState.currentBlock
	end 'parseForStatement'

	// ⭐⭐ **THE COUNTER THE BODY OF A COUNTED RANGE LOOP SEES — A VALUE OF ITS OWN, SO THAT THE INTERVAL THE
	// LOOP PROVES IS A FACT ABOUT A VALUE AND NOT ABOUT A PROGRAM POINT.**
	//
	// ⚠⚠ **THE HEADER PHI IS THE WRONG VALUE TO RECORD AN INTERVAL AGAINST, AND BY EXACTLY ONE.** The phi
	// takes every value the test is APPLIED to, which includes the one that FAILS it: `for r in 0 upto 64`
	// steps the phi to 64 and exits there, so the phi is in `[0, 64]` while every trip of the body runs on a
	// value in `[0, 63]`. Recording `[0, 63]` against the phi would be a claim that is false in the one block
	// the phi is also live in, and the readers of the column (`valueIsProvablyInRange` at the parse,
	// `InlineLeaves` at the Std tier) ask about a VALUE with no program point in hand. A block-arg on the
	// BODY is the same number reached only through the edge the test PASSED on, so its interval is true
	// wherever it is live — which is what a per-value column is entitled to assume.
	//
	// ⭐ **AND IT COSTS NOTHING EMITTED.** A block-arg whose every incoming edge carries one value IS that
	// value, and `elimTrivialBlockArgs` folds it back into `indexPhi` — at pass 9, two passes AFTER
	// `inlineLeaves` has spent the fact and long before any register is chosen.
	//
	// ⚠ **THE START MUST BE IN THE PARSER'S CONST VIEW, WHICH IS NOT THE SAME AS BEING A LITERAL** — a
	// module-level immutable `let` folds too (`for r in 0 upto RegisterFileSize`). A start that does not fold
	// states no floor, and nothing below can be recovered without one.
	//
	// ⭐⭐ **A RUNTIME LIMIT STILL STATES THE FLOOR, AND THE FLOOR IS WHERE THE GUARDS ARE.** `for i in 0 upto
	// xs.count()` cannot fold its top, but `i >= 0` is the whole of what a non-negative element index needs,
	// so a half-open loop over such a limit records the interval ONE-SIDED as `[start, i64.max]`. It is most
	// of what this rule retires across a self-compile, against the seventeen the whole `RegNum` population
	// comes to; `docs/optimization-log.md` holds the counts.
	// `limitKeepsTheCounterNonNegative` carries what the limit must prove for that floor to be true, and why an
	// inclusive loop is refused there rather than joined.
	//
	// ⚠ **THREE REFUSALS ON THE CONSTANT-BOUND PATH, EACH A DIFFERENT WAY THE INTERVAL WOULD BE A LIE — none
	// of them a rounding:**
	//   • an EMPTY range runs no trip, so there is no interval to state. Refusing it is also what keeps the
	//     arithmetic below in range: an exclusive range is non-empty exactly when `low < limit`, which puts
	//     `limit` strictly above `i64.min` and so makes `limit - 1` a subtraction that cannot wrap.
	//   • an INCLUSIVE range ending at the TOP OF A DOMAIN never fails its test: the step WRAPS to that
	//     domain's bottom and the loop runs on for ever, so the interval would be false from the trip after
	//     the wrap. `TypeRules.inclusiveTopBoundWraps` owns which bounds those are, and there are TWO of
	//     them because the test has two readings — its header carries the wrong answer that measured it.
	//   • a CHARACTER range's body value is a MINTED `Character` and not the counter (`__char_from_cp`), so
	//     the counter would carry an interval nothing in the body can spend — declined at the call site,
	//     where the two range kinds are already told apart.
	//
	// ⚠ **SIGNEDNESS IS NOT A CASE FOR THE ARITHMETIC, WHICH IS SIGNED THROUGHOUT — BUT IT IS ONE FOR THE
	// TOP BOUND, AND THE TWO MUST NOT BE ANSWERED TOGETHER.** The loop test runs at a
	// signedness valid for both operands, so it may be UNSIGNED. For ENTERING and for the SET OF VALUES the
	// arithmetic below is safe under either reading: where the two orderings disagree about a bound one of
	// them makes the loop EMPTY (a vacuous interval over-approximates, the safe direction), and where they
	// agree the counter steps through the identical pattern sequence and both stop at the identical pattern.
	// For LEAVING they do not agree, and that is the third refusal's job: each reading has its own top, past
	// which the step wraps rather than the test failing. A RUNTIME limit has no constant to hand that
	// refusal, which is why its own gate asks the limit's declared TYPE instead.
	// ⚠ `tag`/`nameId` are the HEADER PHI's, handed in rather than re-derived from `start`: the body counter
	// IS the header phi one edge later, so a second derivation of its type would be one fact written twice —
	// and the one that could drift is the one nothing compares.
	function mintCountedBodyCounter(body IrBlock, header IrBlock, start ValueId, limit ValueId, inclusive bool, indexPhi ValueId, tag ValueTypeTag, nameId TypeNameId) returns ValueId
		if not self.constIsKnown(start) 'startIsNotConstant'
			return indexPhi
		end 'startIsNotConstant'

		let low = self.constOf(start)

		if not self.constIsKnown(limit) 'aRuntimeLimit'
			if inclusive or not self.limitKeepsTheCounterNonNegative(limit) 'statesNoFloor'
				return indexPhi
			end 'statesNoFloor'

			return self.mintCounterOverRange(body, header: header, indexPhi: indexPhi, tag: tag, nameId: nameId, low: low, high: i64.max)
		end 'aRuntimeLimit'

		let bound = self.constOf(limit)

		if inclusive 'closedRange'
			if low > bound or inclusiveTopBoundWraps(bound) 'statesNoInterval'
				return indexPhi
			end 'statesNoInterval'
		end 'closedRange' else 'halfOpenRange'
			if low >= bound 'runsNoTrip'
				return indexPhi
			end 'runsNoTrip'
		end 'halfOpenRange'

		let counter = self.mintCounterOverRange(body, header: header, indexPhi: indexPhi, tag: tag, nameId: nameId, low: low, high: bound if inclusive else bound - 1)

		if tag == ValueTypeTag.integer and nameId == UnnamedTypeId 'aLiteralCounter'
			self.bodyState.literalCounters = withValueMarked(self.bodyState.literalCounters, value: counter)
		end 'aLiteralCounter'

		return counter
	end 'mintCountedBodyCounter'

	function markCounterBoundedByItsAlias(counter ValueId, start ValueId, limit ValueId, startAdopted bool)
		match self.declaredAliasOfValue(counter) 'alias'
			undeclared then break
			declared(alias) then self.markCounterIfItsBoundsLieInside(counter, alias: alias, start: start, limit: limit, startAdopted: startAdopted)
		end 'alias'
	end 'markCounterBoundedByItsAlias'

	function markCounterIfItsBoundsLieInside(counter ValueId, alias RangedTypeAlias, start ValueId, limit ValueId, startAdopted bool)
		if aliasIsFloat(alias) or not (startAdopted or self.edgeProvesAlias(start, alias: alias)) or not self.edgeProvesAlias(limit, alias: alias) 'theBoundsLeaveTheAlias'
			return
		end 'theBoundsLeaveTheAlias'

		self.bodyState.boundedCounters = withValueMarked(self.bodyState.boundedCounters, value: counter)
	end 'markCounterIfItsBoundsLieInside'

	function counterTypeBound(start ValueId, limit ValueId) returns ValueId
		if self.tagOf(start) == ValueTypeTag.integer and self.valueNameId(start) == UnnamedTypeId and self.tagOf(limit) == ValueTypeTag.named 'startAdoptsTheLimitsAlias'
			return limit
		end 'startAdoptsTheLimitsAlias'

		return start
	end 'counterTypeBound'

	function recordLiteralCounterUse(value ValueId, target RangedTypeAlias, line LineNumber, column ColumnNumber)
		let known = self.valueHasFloatRange(value) if aliasIsFloat(target) else valueIsMarked(self.bodyState.literalCounters, value: value)

		if not known 'notALiteralCounter'
			return
		end 'notALiteralCounter'

		self.recordResolvedRangeCheckSite(value, target: RangeCheckSiteTarget.literalUse(target.clone()), line: line, column: column)
	end 'recordLiteralCounterUse'

	function recordResolvedRangeCheckSite(value ValueId, target RangeCheckSiteTarget, line LineNumber, column ColumnNumber)
		self.bodyState.rangeCheckSites.push(RangeCheckSite.create(value, target: target, block: self.bodyState.currentBlock.id, maxonOpPos: self.bodyState.currentBlock.bodyOpCount(), line: line, column: column))
	end 'recordResolvedRangeCheckSite'

	// The body counter and the edge that feeds it, shared by the two bound shapes above so the interval
	// is recorded against the body's own value in one place rather than each shape minting its own.
	function mintCounterOverRange(body IrBlock, header IrBlock, indexPhi ValueId, tag ValueTypeTag, nameId TypeNameId, low FullRangeInt, high FullRangeInt) returns ValueId
		let counter = self.mintPhi(body, tag: tag, nameId: nameId)
		self.recordBranchEdge(header, targetId: body.id, argIds: argsOf(indexPhi))
		self.recordProvenIntRange(counter, low: low, high: high)
		return counter
	end 'mintCounterOverRange'

	// ⭐ **DOES A RUNTIME LIMIT KEEP THE COUNTER NON-NEGATIVE?** — asked only for a HALF-OPEN loop, where
	// the counter stops at `limit - 1`, so the floor that gets recorded rests on where `limit` can reach.
	//
	// ⚠ **A LIMIT ABOVE `i64.max` MAKES THE TEST UNSIGNED, AND THEN THE FLOOR IS THE LIE.** The loop test
	// runs at a signedness valid for both operands, so `i < xs` over an `int(0 to u64.max)` limit compares
	// PATTERNS: the counter climbs through `i64.max` into the negative patterns with the test still
	// holding, and a recorded `low` of 0 would vouch for a value that is signed-negative. A limit every one
	// of whose values sits in `0 … i64.max` settles it — both readings of the test agree there, and the
	// counter cannot pass `i64.max - 1`.
	//
	// A limit that names no alias proves nothing and keeps the guard, which is the direction that is safe.
	function limitKeepsTheCounterNonNegative(limit ValueId) returns bool
		let declaresIt = match self.valueDenotedAlias(limit) 'limitAlias'
			undeclared gives false
			declared(alias) gives not aliasIsFloat(alias) and rangeIsWithinSignedNonNegative(alias.low, high: alias.high)
		end 'limitAlias'

		if declaresIt 'aDeclaredCeiling'
			return true
		end 'aDeclaredCeiling'

		// A recorded interval answers where no type does, and that is the case that carries the corpus: a
		// `count()` result is minted UNNAMED, so its ceiling can only ever come from here.
		let proven = try provenIntRangeOf(self.bodyState.countedValueRanges, value: limit) otherwise return false
		return rangeIsWithinSignedNonNegative(proven.low, high: proven.high)
	end 'limitKeepsTheCounterNonNegative'

	// ⭐ **THE PREHEADER'S "DID THE FACTORY GIVE US A CURSOR?" BRANCH** — the taken edge is the ordinary
	// loop entry recorded by the caller, the other lands in a fresh block that carries NOTHING and rejoins past
	// the loop's exit drops (`joinAfterEmptyIterable`). The test is `flag == 0`, the SAME sense the header's own
	// exit test uses on `advance()`'s flag, and it is emitted through the same `emitCompareAgainstLiteral` an
	// enum `match` arm uses — so "did it throw?" is one comparison in this file, not two.
	function emitEmptyIterableEntry(func IrFunction, flag ValueId, header IrBlock, forTok Token) returns IrBlock
		let empty = self.artifact.module.addBlock(func, label: b"forempty", heat: BlockHeat.normal)
		let gotCursor = self.emitErrorFlagTest(flag, op: MaxonCmpOp.eq, anchor: forTok)

		// The empty block carries no binding: every carried value it needs is supplied on ITS edge into the
		// join, straight from the pre-loop set, because nothing between here and there can have assigned one.
		self.recordBranchEdge(self.bodyState.currentBlock, targetId: empty.id, argIds: ValueIdArray.create(0))
		self.emitCondBranch(self.bodyState.currentBlock, cond: gotCursor, thenId: header.id, elseId: empty.id, ifTok: forTok)
		return empty
	end 'emitEmptyIterableEntry'

	// ⭐⭐ **THE MERGE THE SECOND ENTRY EDGE FORCES.** With an empty-`Iterable` path the loop statement has
	// TWO successors to reconcile — the exit, where the carried bindings hold whatever the body last assigned,
	// and the empty block, where they still hold their pre-loop values — so the statement's continuation is a
	// JOIN with a phi per carried binding. It is `wireLoopExit`'s shape (`mintPhiForBinding` +
	// `pushMergedEdgeValue`, in that pairing order) applied one block later, and it exists for the same reason:
	// a `var` assigned inside the loop must read correctly after it on BOTH paths.
	//
	// The pre-loop args are the caller's own entry-edge args, reused rather than re-derived: `edgeArgsFor`
	// answers off `pv.entryValue`, and asking it twice would be one fact computed twice.
	//
	// ⭐⭐ **AND IT IS WHERE THE SOURCE EXPRESSION'S TEMPORARIES COME TO DIE, because the join is the ONE block
	// both entry edges reach.** The empty edge got no cursor, so it must not reach a `__destruct_<Cursor>` —
	// but everything the source expression itself enrolled was built in the preheader, ABOVE the branch, and
	// is live on this edge exactly as it is on the loop's. `sourceFloor` is the `for` statement's own owned
	// mark, and the caller has already closed the cursor's frame, so this releases precisely the outer batch.
	//
	// It hands nothing back: the join IS `currentBlock` when it returns, which is what the caller's other arm
	// leaves too, so the statement's continuation is read from one place.
	function joinAfterEmptyIterable(func IrFunction, empty IrBlock, exit IrBlock, entryCarried ValueIdArray, phiVars LoopPhiVarArray, sourceFloor ElementIndex, forTok Token, skippedMark MoveMark)
		let join = self.artifact.module.addBlock(func, label: b"forjoin", heat: BlockHeat.normal)
		self.reconcileMovesAtTwoEdgeMerge(exit, markA: moveMarkPrefix(self.captureMoveMark(), height: skippedMark.height()), b: empty, markB: skippedMark, anchor: forTok)

		// Collected BEFORE the phis are minted, because minting rebinds each binding to its phi and the exit
		// edge must carry what the binding held on the way OUT of the loop.
		let loopVals = ValueIdArray.create(0)

		for k in 0 upto phiVars.count() 'exitEdge'
			let pv = try phiVars.get(k) otherwise panic("joinAfterEmptyIterable: phiVars.get OOB at {k}")
			self.pushMergedEdgeValue(loopVals, binding: pv.binding, value: pv.binding.boundValue)
		end 'exitEdge'

		for k in 0 upto phiVars.count() 'mkJoinPhi'
			let pv = try phiVars.get(k) otherwise panic("joinAfterEmptyIterable: phiVars.get OOB at {k}")
			let joinPhiId = self.mintPhiForBinding(join, binding: pv.binding)
			self.recordDebugRebind(pv.binding.debugLocalSlot, recorded: pv.binding.debugLocalRecorded, current: pv.binding.boundValue, value: joinPhiId, def: DebugVersionDef.definedIn(join.id))
			pv.binding.setBoundValue(joinPhiId, ledger: self.bodyState.moveLedger)
		end 'mkJoinPhi'

		self.recordBranchEdge(exit, targetId: join.id, argIds: loopVals)
		self.emitBranch(exit, targetId: join.id)
		self.recordBranchEdge(empty, targetId: join.id, argIds: entryCarried)
		self.emitBranch(empty, targetId: join.id)

		self.emitScopeDrops(join, floor: sourceFloor, anchor: forTok)
		self.bodyState.currentBlock = join
	end 'joinAfterEmptyIterable'

	// ⭐ **THE `for` HEADER'S LOOP-VARIABLE PATTERN, as the LIST OF NAMES it always was.** `for (key, value) in`
	// is `parseDestructuringNames`' pattern — the same one `let (x, y) = …` reads, so `_` discards a position
	// and a one-name pattern is refused by one sentence rather than two — and a bare `for item in` is that
	// pattern with a single position and no parens, which is why it comes back as a list too. Everything
	// downstream then asks its questions per POSITION and needs to know nothing about the spelling.
	function parseLoopVariablePattern(forTok Token) returns TokenArray throws SourceParseError
		if self.at(TokenKind.leftParen) 'destructuringPattern'
			return try self.parseDestructuringNames(forTok)
		end 'destructuringPattern'

		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		let names = TokenArray.create(1, zeroed: false)
		names.push(nameTok)
		return names
	end 'parseLoopVariablePattern'

	// ⭐ **DOES THE HEADER'S PATTERN NAME THE ELEMENT WHOLE?** — one position, which is what a bare
	// `for item in` comes back as. Its two readers FORK on it, and asking it in two spellings (`== 1` at the
	// binding, `!= 1` at the owner name below) is one fact written down twice: a pattern rule changed at one
	// would go on binding at the other. It is also the PROOF the `get(0)` beneath each
	// answer rests on, which is why the accessor sits beside it rather than at either site.
	function patternNamesOneWholeElement(nameToks TokenArray) returns bool
		return nameToks.count() == 1
	end 'patternNamesOneWholeElement'

	// The sole name of such a pattern. Both readers guard it with the predicate above, so the panic names ONE
	// impossible state rather than two sites each describing it in their own words.
	function soleLoopVariableName(nameToks TokenArray) returns Token
		return try nameToks.get(0) otherwise panic("soleLoopVariableName: `patternNamesOneWholeElement` answered true for a pattern holding no name at 0")
	end 'soleLoopVariableName'

	// The name the OWNED loop element is enrolled under when the loop mints one (a String's grapheme cluster).
	// A single-name header owns it under the name the author wrote; a destructuring header has no name for the
	// whole element, so it takes the one the compiler already uses where nothing spells it.
	function loopVariableOwnerName(nameToks TokenArray) returns immutable ByteArray
		if not self.patternNamesOneWholeElement(nameToks) 'destructuredElementHasNoName'
			return IterationElementBindingName
		end 'destructuredElementHasNoName'

		return self.soleLoopVariableName(nameToks).value
	end 'loopVariableOwnerName'

	function forSourceBareBinding(sourceStart ElementIndex) returns VarInfo throws AbsentError
		let nameTok = self.tokenAt(sourceStart)

		if not tokenCanBeAName(nameTok) or self.kindAt(sourceStart + 1) != TokenKind.charLiteral 'notJustAName'
			throw AbsentError.absent
		end 'notJustAName'

		if not self.bodyState.scope.contains(nameTok.value) 'notABinding'
			throw AbsentError.absent
		end 'notABinding'

		return self.bodyState.scope.getInfo(nameTok.value)
	end 'forSourceBareBinding'

	function forSourceIsHeldByItsName(sourceStart ElementIndex) returns bool
		let info = try self.forSourceBareBinding(sourceStart) otherwise return false
		return not info.isMutable() and not info.isCellBinding and not info.isSelfField
	end 'forSourceIsHeldByItsName'

	function noteLoopHeldBinding(sourceStart ElementIndex)
		let info = try self.forSourceBareBinding(sourceStart) otherwise return
		self.bodyState.loopHeldBindings.push(info.name)
	end 'noteLoopHeldBinding'

	function valueIsHeldByAnEnclosingLoop(value ValueId) returns bool
		if self.bodyState.loopHeldBindings.isEmpty() 'noLoopHoldsABinding'
			return false
		end 'noLoopHoldsABinding'

		for binding in self.bodyState.ownedBindings 'eachBinding'
			if binding.boundValue == value and self.bodyState.loopHeldBindings.contains(binding.name) 'itsLoopHoldsIt'
				return true
			end 'itsLoopHoldsIt'
		end 'eachBinding'

		return false
	end 'valueIsHeldByAnEnclosingLoop'

	function drainedSourceValue(sourceStart ElementIndex, walked ValueId) returns ValueId
		let info = try self.forSourceBareBinding(sourceStart) otherwise return walked
		return info.boundValue
	end 'drainedSourceValue'

	function loopDrainsItsSource(element ValueId, isRange bool) returns bool
		return not isRange and (self.valueIsPromise(element) or self.valueHoldsAUniqueRecord(element))
	end 'loopDrainsItsSource'

	function holdLoopSource(source ValueId, range SourceRange)
		self.enrolHeldRead(source, held: self.emitHoldMarker(source, kind: HoldKind.loopSource, range: range), name: IterationSourceBindingName)
	end 'holdLoopSource'

	function sourceElementQualifier(source ValueId) returns GenericArgQualifier
		if self.tagOf(source) != ValueTypeTag.genericInstance 'notAnInstance'
			return GenericArgQualifier.plain
		end 'notAnInstance'

		return self.signatures.iteratedElementQualifier(self.valueInstanceId(source))
	end 'sourceElementQualifier'

	function sourceReceiverElementQualifier(source ValueId, sourceOpFloor ElementIndex) returns GenericArgQualifier
		match self.opProducingTheValue(sourceOpFloor) 'producer'
			noOwnOp then return GenericArgQualifier.plain
			at(opIdx) then return self.callReceiverElementQualifier(opIdx, value: source)
		end 'producer'
	end 'sourceReceiverElementQualifier'

	function callReceiverElementQualifier(opIdx ElementIndex, value ValueId) returns GenericArgQualifier
		let op = try self.artifact.module.ops.get(opIdx) otherwise panic("callReceiverElementQualifier: ops.get OOB at {opIdx}")
		let defined = try maxonOpDefinedValue(op) otherwise return GenericArgQualifier.plain

		if defined != value 'anotherValue'
			return GenericArgQualifier.plain
		end 'anotherValue'

		let operands = ValueIdArray.create(0)
		maxonOpOperandValues(op, into: operands)
		let receiver = try operands.get(0) otherwise return GenericArgQualifier.plain

		return self.sourceElementQualifier(receiver)
	end 'callReceiverElementQualifier'

	function holdLoopElement(element ValueId, nameToks TokenArray, range SourceRange) returns ValueId
		if not self.holdIsOwed(element) 'nothingToHold'
			return element
		end 'nothingToHold'

		let held = self.emitHoldMarker(element, kind: HoldKind.loopElement, range: range)
		self.enrolHeldRead(element, held: held, name: self.loopVariableOwnerName(nameToks))
		return held if self.holdReplacesItsSource(element) else element
	end 'holdLoopElement'

	function emitEmptySlotElementGuard(func IrFunction, source ValueId, element ValueId, index ValueId, forTok Token)
		if self.valueIsManagedHeap(element) 'aRecordElement'
			self.emitEmptySlotPanicBranch(func, isEmpty: self.emitCompareAgainstLiteral(element, literal: EmptySlotWord, op: MaxonCmpOp.eq, opTok: forTok), index: index, forTok: forTok)
			return
		end 'aRecordElement'

		if self.tagOf(element) == ValueTypeTag.typeParameter 'anOpaqueElement'
			let unfilled = self.emitRuntimeCall(ManagedSlotUnfilledName, args: twoArgs(source, second: element), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(forTok))
			self.emitEmptySlotPanicBranch(func, isEmpty: unfilled, index: index, forTok: forTok)
		end 'anOpaqueElement'
	end 'emitEmptySlotElementGuard'

	function emitEmptySlotPanicBranch(func IrFunction, isEmpty ValueId, index ValueId, forTok Token)
		let range = SourceRange.ofToken(forTok)
		let panicBlock = self.artifact.module.addBlock(func, label: EmptySlotPanicBlockLabel, heat: BlockHeat.normal)
		let continueBlock = self.artifact.module.addBlock(func, label: FilledSlotBlockLabel, heat: BlockHeat.normal)
		self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.condBranch(isEmpty, thenBlockId: panicBlock.id, elseBlockId: continueBlock.id), range: range)

		self.bodyState.currentBlock = panicBlock
		self.bodyState.currentBlock.heat = BlockHeat.cold

		let site = self.emitStringLiteral(panicMessageLinePrefix(self.job.path, line: forTok.line), range: range)
		let record = self.emitLabelledRuntimeCall(EmptySlotMessageName, args: twoArgs(site, second: index), resultTag: ValueTypeTag.string, resultNameId: UnnamedTypeId, range: range, argLabels: emptySlotMessageLabels())
		self.removeFromPendingTemps(record)
		let messagePointer = self.emitLoadStringField(record, offset: StringBufferOffset, range: range)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.panicAbortValue(messagePointer), range: range)
		self.emitDeadReturn(func, anchor: forTok)

		self.bodyState.currentBlock = continueBlock
	end 'emitEmptySlotPanicBranch'

	// ⭐ **DECLARE ONE POSITION OF A `for` HEADER'S PATTERN.** `_` is the discard (`DiscardBindingName`) and
	// binds nothing at all — declaring it would make an ordinary `_ = f()` discard statement inside the body a
	// write to a `let`. Everything else is declared in the per-trip frame, so it is in scope for the whole body
	// and gone at the loop's `end`; immutable, which `for-iterator-immutable` pins as E2013 for a write.
	//
	// ⭐ **E3012 CANDIDATE: A DECLARED LOOP VARIABLE MUST BE MENTIONED** (`reportUnusedBindings`). Recorded
	// past the discard guard, so `for _ in` — and a destructured `for (_, v) in` — is exempt by the same fact
	// that makes the refusal fair: `_` binds no name, and it is already the legal spelling in BOTH compilers
	// for a loop that wants the iteration and not that part of the element.
	function declareLoopVariable(nameTok Token, value ValueId, writable bool, elementQualifier GenericArgQualifier, storedKey StoredKeyCursor) throws SourceParseError
		if nameTok.value.equals(DiscardBindingName) 'discardsThisPosition'
			return
		end 'discardsThisPosition'

		if (elementQualifier == GenericArgQualifier.frozen or storedKey != StoredKeyCursor.neither) and not self.valueIsAValueType(value) 'anImmutableSlot'
			self.setValueCapability(value, capability: ValueCapability.immutable)
		end 'anImmutableSlot'

		let loopBinding = try self.bodyState.scope.declareValueBinding(nameTok.value, varType: self.typeOf(value), kind: BindingKind.let, value: value, brandId: self.brandIdOf(value)) otherwise throw SourceParseError.localShadowsSelfField(String.from(nameTok.value), typeName: String.from(self.enclosingTypeName()), line: nameTok.line, column: nameTok.column)
		self.bodyState.unusedCandidates.push(UnusedBindingCandidate.create(loopBinding, nameRange: SourceRange.ofToken(nameTok), kind: UnusedBindingKind.loopVariable, declToken: self.pos))
		let elementsMayBeWritten = writable and storedKey == StoredKeyCursor.neither
		loopBinding.elementWritable = elementsMayBeWritten

		if not elementsMayBeWritten 'aViewOfReadOnlyElements'
			self.regionFactsForWrite().cellRefusedRoots.insert(value)
		end 'aViewOfReadOnlyElements'

		if self.valueHoldsAUniqueRecord(value) 'aLentUnique'
			self.regionFactsForWrite().lentUniques.insert(value)
		end 'aLentUnique'
	end 'declareLoopVariable'

	// ⭐ **ONE ZERO-ARGUMENT METHOD CALL ON A RECEIVER VALUE — the whole of the `for … in` protocol surface.**
	// `<T>.createIterator(source)`, `<T>.current(source)` and `<T>.advance(source)` are the same call three
	// times over: an ordinary direct call on the source as receiver, differing only in the method name and in
	// whether the result is used. They share the argument construction rather than each spelling it, because a
	// second copy is how they would come to disagree about the receiver's position — the one thing a direct
	// method call gets from its caller and cannot re-derive.
	//
	// ⚠ **THE FACTORY USED TO BE A SECOND FUNCTION, ON THE ARGUMENT THAT IT "TAKES ITS RECEIVER FROM THE
	// ITERABLE"** — a difference in what the CALLER does with the result, never in what is emitted. Generic substitution made
	// that visible by giving both bodies two more obligations they must discharge identically (below), which is
	// exactly the moment two copies of one call become two places for one rule to rot.
	//
	// ⭐⭐ **THE RECEIVER'S CONCRETE INSTANCE IS THREADED, AND THE RESULT IS READ THROUGH IT** — the same
	// two things `dispatchMethodOnBase` does for a written `b.next()`, and for the same reasons. Without the
	// first, a protocol method whose parameter FEEDS an opaque field cannot tell whether its argument owns
	// managed heap for this instance; without the second, `Box.createIterator() returns BoxIter` hands back the
	// SHARED body's `BoxIter with Box.T` and every later call on that cursor is typed against an opaque `T`
	// the call site had already fixed. A plain-struct receiver supplies `none` and substitutes nothing, so
	// every non-generic iterable emits exactly what it emitted before.
	//
	// `CalleeMint.resolvedTypeQualifier` because the HEAD is the surface's declaring type — resolved from the
	// receiver, not read from this call site — while the member is the protocol's. The method half is joined
	// the way `declaredMethodName` already joined it when the signature was published; what the mint records
	// is that no token here spells the type, so a moved stdlib declaration's protocol call is the compiler's
	// own name and not an author reaching into the reserved space.
	//
	// ⭐⭐ **AN EXISTENTIAL SOURCE TAKES THE OTHER FORK, AND IT IS A DIFFERENT OP RATHER THAN A DIFFERENT
	// NAME.** There is no callee to name: the conformer is unknown in this body, so the protocol call is a
	// `witnessDispatch` through the table the value carries — the same op, through the same door, that a
	// `s.current()` on that value emits. Everything the loop then does to the result is shared: the
	// try-channel rewrite treats a `witnessDispatch` as routable (`routableOpAt`), so
	// `emitProtocolTryCall` needs no arm of its own for the throwing half.
	function emitReceiverProtocolCall(surface MethodSurface, methodName ByteArray, anchor Token, resultUsed bool, origin ProtocolReceiverOrigin) returns ValueId throws SourceParseError
		match surface 'how'
			none then panic("emitReceiverProtocolCall: a `{String.from(methodName)}` protocol call on a value with no method surface — every caller emits only after `surfaceDeclaresCursorProtocol` or `surfaceIterableFactory` answered off this same surface")
			witnessDispatched(receiver) then return try self.emitWitnessProtocolCall(receiver, methodName: methodName, anchor: anchor, resultUsed: resultUsed)
			declared(declaringType, receiver) then return try self.emitDeclaredProtocolCall(declaringType, methodName: methodName, source: receiver, anchor: anchor, resultUsed: resultUsed, origin: origin)
		end 'how'
	end 'emitReceiverProtocolCall'

	// The DIRECT-CALL fork of the router above — the body this function had before the second receiver kind
	// arrived, unchanged, and a fork of its own so the `declared` arm binds both of its payloads in the one
	// statement a `match` arm is.
	function emitDeclaredProtocolCall(typeName ByteArray, methodName ByteArray, source ValueId, anchor Token, resultUsed bool, origin ProtocolReceiverOrigin) returns ValueId throws SourceParseError
		match origin 'judgement'
			authored then try self.requireImplicitMethodReachable(typeName, methodName: methodName, anchor: anchor)
			factoryMinted then break
		end 'judgement'

		// `var` on all three: `emitCall` supplies omitted defaults by PUSHING onto the argument columns
		// (`fillOmittedArgDefaults`), so they are its output as well as its input. No protocol method declares
		// a parameter, so nothing is ever appended — but the mutability is the signature's, not the callee's,
		// and E3207 asks about the signature.
		let args = argsOf(source)
		let argLabels = emptyArgLabels(args)
		let argRanges = uniformArgRanges(args, range: SourceRange.ofToken(anchor))
		let callee = qualifiedMethodName(typeName, methodName: methodName)
		let result = try self.emitCall(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: anchor, resultUsed: resultUsed, constructorInstance: self.receiverConstructorInstance(source), mint: CalleeMint.resolvedTypeQualifier)
		self.retypeInstanceMethodResult(result, receiver: source)
		return result
	end 'emitDeclaredProtocolCall'

	// ⭐⭐ **THE EXISTENTIAL FORK OF THE CALL ABOVE: one zero-argument requirement, dispatched through the
	// table the receiver carries.** Every step is the one `dispatchWitnessMethod` takes for a written
	// `s.current()` — the same target resolution, the same result mint, the same single emit door — with the
	// argument list built rather than parsed, because the loop has no source text to read one from.
	//
	// ⚠ **NO `typeCallResultThroughInstance`, and that is not an omission.** That retype exists to reopen a
	// SHARED generic body's opaque return against the receiver's concrete instance; an interface's declared
	// return type is already concrete, and the one that is not — `Self` — is answered by the receiver inside
	// `mintWitnessDispatchResult` rather than substituted afterwards. `mintWitnessDispatchResult`'s own header
	// states the same thing for the written form.
	function emitWitnessProtocolCall(receiver ValueId, methodName ByteArray, anchor Token, resultUsed bool) returns ValueId throws SourceParseError
		match try self.witnessProtocolTarget(receiver, methodName: methodName, anchor: anchor) 'resolved'
			notRequired then panic("emitWitnessProtocolCall: what this receiver dispatches through requires no zero-argument `{String.from(methodName)}` — the admission test and this emit both go through `witnessProtocolTarget`, so a miss here means one of them was not asked")
			required(requirement) then return try self.emitProtocolWitnessDispatch(requirement, receiver: receiver, anchor: anchor, resultUsed: resultUsed)
		end 'resolved'
	end 'emitWitnessProtocolCall'

	// The emit half of the fork above, taking the already-resolved requirement. `argsOf` is
	// `withWitnessReceiver`'s answer for a call with no user arguments — the receiver alone at `args[0]`,
	// which is the convention `emitWitnessDispatch` and every reader below it index by.
	function emitProtocolWitnessDispatch(requirement WitnessDispatchTarget, receiver ValueId, anchor Token, resultUsed bool) returns ValueId throws SourceParseError
		let result = try self.mintWitnessDispatchResult(requirement, receiver: receiver, methodTok: anchor, resultUsed: resultUsed)
		_ = self.emitWitnessDispatch(result, args: argsOf(receiver), blames: NameRoster.create(0), target: requirement, range: SourceRange.ofToken(anchor), siteTok: anchor)
		return result
	end 'emitProtocolWitnessDispatch'

	// Call a traversal protocol method — `advance()`, or a throwing `createIterator()` — and hand back
	// its result and its error flag: for `advance()` the whole of a cursor loop's termination
	// condition, for the factory the loop's entry seed.
	//
	// It goes through `rewriteLastCallToTryCall`, the rewrite a source-written `try` uses, rather than
	// emitting a `tryCall` directly: a second site building the op would be a second answer to which
	// results a `tryCall` defines and in what order. An existential receiver's `witnessDispatch` takes
	// the same route. What it does not reuse is `desugarTry`: this flag's split is the loop header,
	// not a handler around one statement.
	//
	// The thrown value is discarded, which is sound only because `surfaceDeclaresCursorProtocol` and
	// `surfaceIterableFactory` admit only `IterationError`, compiler-owned and payload-free, so there
	// is nothing to release; both receiver kinds read the clause through
	// `throwsClauseIsIterationError`.
	function emitProtocolTryCall(surface MethodSurface, methodName ByteArray, anchor Token, resultUsed bool, origin ProtocolReceiverOrigin) returns (ValueId, ValueId) throws SourceParseError
		// The floor `rewriteLastCallToTryCall` measures "the target's own op" against — see `parseTry`, which
		// captures it at the same point and for the same reason.
		let targetOpFloor = self.artifact.module.ops.count()
		let targetDeferralFloor = self.artifact.deferredChains.count()

		// Claimed for every destination: this function rewrites the call into the try channel itself, so
		// no router may rewrite it first, or `rewriteLastCallToTryCall` would meet a `tryCall` it must
		// refuse.
		let savedRouteClaim = self.swapClaim(ThrowRouteClaim.everyDestination)
		let value = try self.emitReceiverProtocolCall(surface, methodName: methodName, anchor: anchor, resultUsed: resultUsed, origin: origin)
		self.restoreClaim(savedRouteClaim)
		let (_, flag) = try self.rewriteLastCallToTryCall(value, tryTok: anchor, targetDeferralFloor: targetDeferralFloor, targetOpFloor: targetOpFloor)
		return (value, flag)
	end 'emitProtocolTryCall'

	// The block-arg list an edge into a `for` HEADER carries: the index value FIRST (the header's own
	// block-arg 0 — see `parseForStatement`), then one slot per carried binding. Both edges that name
	// the header go through here, so the index can never end up in a different slot on one of them.
	function loopHeaderArgs(indexValue ValueId, carried ValueIdArray) returns ValueIdArray
		let vals = ValueIdArray.create(carried.count() + 1, zeroed: false)
		vals.push(indexValue)

		for v in carried 'each'
			vals.push(v)
		end 'each'

		return vals
	end 'loopHeaderArgs'

	// ⭐⭐ **AN `Iterable` SOURCE IS REPLACED BY THE CURSOR ITS `createIterator()` RETURNS** — the
	// rewrite `parseForStatement`'s collection fork performs:
	// what comes back is a cursor, and the cursor form already knows
	// everything about walking one.
	// It is what makes `for item in self` inside `stdlib/Interfaces.maxon`'s `extension Iterable` mean what that
	// file's own documentation says it means (*"types that can be iterated over (used by for-in loops)"*), and
	// it is how `stdlib/Range.maxon` and `stdlib/helpers/string/views.maxon` become iterable.
	//
	// ⭐ **A SOURCE THAT IS ALREADY A CURSOR IS LEFT ALONE, AND THAT PRECEDENCE IS THE PROTOCOL'S.** An
	// iterator may itself declare `createIterator` (an identity passthrough), and `for x in iter` over
	// a HALF-CONSUMED iterator must resume from where it stands rather than restarting — so the cursor
	// protocol is tested first and wins.
	//
	// ⚠ **THE ENTRY SEED IS THE OTHER HALF OF THE ANSWER, AND WITHOUT IT AN EMPTY COLLECTION RUNS ONE TRIP.**
	// The cursor form is a DO-WHILE (see `parseForStatement`'s header): its first test is licensed by the
	// protocol's invariant that a live cursor is already positioned on an element. A throwing factory is
	// exactly the case where that invariant does not hold — `stdlib/Interfaces.maxon:132-134` has the
	// constructor throw `exhausted` for an empty collection — so the factory's own error flag becomes the
	// value the header starts from, and the loop's ordinary exit test does the rest. An INFALLIBLE factory
	// cannot report emptiness at all, so its seed is the literal 0 the bare cursor form uses.
	function materializeIterableIterationSource(source ValueId, sourceDeferralFloor ElementIndex, sourceOpFloor ElementIndex, forTok Token) returns IterableIterationSource throws SourceParseError
		// The surface gate is `methodSurfaceOf`'s and is there for its reason: a source with no
		// method surface has no `createIterator` to find, and no store to ask for one.
		let surface = self.methodSurfaceOf(source)
		let alreadyACursor = try self.surfaceDeclaresCursorProtocol(surface, anchor: forTok)

		if not alreadyACursor or not self.sourceCameFromAnIterationThrowingCall(source, sourceOpFloor: sourceOpFloor) 'theLoopAbsorbsNothing'
			self.releaseHeldThrowingOp(sourceOpFloor, heldBy: IterationSourceClaim)
		end 'theLoopAbsorbsNothing'

		if alreadyACursor 'walksItself'
			return try self.absorbThrowingCursorSource(source, sourceDeferralFloor: sourceDeferralFloor, sourceOpFloor: sourceOpFloor, forTok: forTok)
		end 'walksItself'

		// ⭐⭐ **AN `Array` INSTANCE IS NOT REWRITTEN — THE LOOP WALKS ITS BUFFER WITH A COUNTER.** The
		// rewrite above is what an `Iterable` needs because the loop cannot otherwise reach its elements; an
		// `Array` is the one declared `Iterable` whose traversal the loop ALREADY BUILDS BETTER:
		// `__managed_count` in the header, `__managed_get_unchecked` on an ordinal in the body,
		// `idx + 1` in the step, all of it inline after `inlineManagedPrimitives`.
		// A corpus `Array` (`stdlib/Array.maxon`) declares a `createIterator()` like every other container, so without
		// this arm it would take the rewrite above.
		//
		// ⚠ **THE COST OF THAT REWRITE IS TWO HEAP RECORDS PER LOOP ENTRY AND THREE CALLS PER TRIP:
		// `Array.createIterator` → an `ArrayIterator{raw}` box (`__mm_alloc`) plus
		// `__managed_cursor_create` (a 16-byte record and an `__mm_incref` of the source), then
		// `current()` + `__retain_type_param` + `advance()` per trip and two frees at the exit. — about
		// half of this compiler's own allocation samples, for a traversal whose whole content is an
		// integer the header already carries.
		//
		// ⚠ **IT IS THE `Array`'s ALONE AND DELIBERATELY NOT `FixedArray`'s, `List`'s or `Map`'s.** The claim being
		// made is that the loop's own form is EQUIVALENT to what the declared cursor would have done, and that
		// rests on `Array with T` and `__ManagedMemory with T` being ONE `GenericInstanceId`: the array
		// record IS the buffer the two runtime entries take, so no field is read and no value is minted. A
		// `List`'s cursor holds a NODE between trips (its `get(i)` is O(n)) and a `Map`'s hands out a PAIR its
		// record does not store — for those the declared cursor is not an overhead, it is the traversal.
		//
		// ⚠ **A SOURCE THAT DECLARES THE CURSOR PROTOCOL ITSELF STILL WINS**, because that test is above this
		// one: `for x in arr.cursor()` / `arr.withIterator()` iterate an `ArrayIterator`, which is a different
		// instance and resumes from where it stands (`array-cursor`, `with-iterator`).
		//
		// ⭐ **THE TWO FORMS COUNT THE ELEMENT DIFFERENTLY AND AGREE ON THE ANSWER.** The cursor's
		// `ArrayIterator.current()` hands back a `+1` (`coOwnBorrowedOpaque` on its opaque return); the counter
		// form reads the accessor's in-place element and holds it (`holdLoopElement`). Either way a write to the
		// source inside the body leaves the element readable (`specs/borrow-liveness.md`).
		if self.valueIsAnArray(source) 'theLoopBuildsItsOwn'
			return IterableIterationSource.notIterable
		end 'theLoopBuildsItsOwn'

		match try self.surfaceIterableFactory(surface, anchor: forTok) 'factory'
			notDeclared then return IterableIterationSource.notIterable
			infallible then return IterableIterationSource.cursor(try self.emitReceiverProtocolCall(surface, methodName: CreateIteratorMethodName, anchor: forTok, resultUsed: true, origin: ProtocolReceiverOrigin.authored), entrySeed: self.emitLiteral(NoErrorFlag, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok)))
			throwsIterationError then break
			throwsSomethingElse(errorName) then throw SourceParseError.unsupported("`for … in` over a `{String.from(self.methodSurfaceTypeName(surface))}`, whose `{String.from(CreateIteratorMethodName)}()` throws `{errorName}` — the loop absorbs what the traversal protocol throws without binding it, which is sound only for the payload-free `{String.from(IterationErrorTypeName)}`; a factory throwing anything else must be called with an explicit `try` and its result iterated", line: forTok.line, column: forTok.column)
		end 'factory'

		let (cursor, flag) = try self.emitProtocolTryCall(surface, methodName: CreateIteratorMethodName, anchor: forTok, resultUsed: true, origin: ProtocolReceiverOrigin.authored)
		return IterableIterationSource.cursor(cursor, entrySeed: flag)
	end 'materializeIterableIterationSource'

	// A source that is already a cursor may have been produced by a throwing call, and the loop
	// absorbs that throw as it absorbs a factory's. `for (iter, item) in arr.withIterator()` is
	// `specs/with-iterator.md`'s own spelling: the call hands back a `WithIterIterator`, which
	// declares the cursor protocol, so the factory rewrite never sees it. `withIterator()` throws
	// `IterationError` for the reason `createIterator()` does — an empty collection has no first
	// element — so the call's own error flag becomes the header's entry seed and the loop runs zero
	// times.
	//
	// It absorbs only `IterationError`, `surfaceIterableFactory`'s bound: the loop takes the error
	// without binding it, which is sound only for a payload-free error the protocol defines. A source
	// call throwing anything else goes to the enclosing handler, or keeps its E3057 and needs an
	// explicit `try`.
	//
	// In a test body the source's claim (`IterationSourceClaim`) is what leaves the call a plain
	// `call` for this rewrite. A call an enclosing `try` block routed at emission is no longer a
	// `call`, so `sourceCameFromAnIterationThrowingCall` does not match it and it is left alone: the
	// author asked for that handler by writing the block.
	function absorbThrowingCursorSource(source ValueId, sourceDeferralFloor ElementIndex, sourceOpFloor ElementIndex, forTok Token) returns IterableIterationSource throws SourceParseError
		if not self.sourceCameFromAnIterationThrowingCall(source, sourceOpFloor: sourceOpFloor) 'nothingToAbsorb'
			return IterableIterationSource.notIterable
		end 'nothingToAbsorb'

		let (_, flag) = try self.rewriteLastCallToTryCall(source, tryTok: forTok, targetDeferralFloor: sourceDeferralFloor, targetOpFloor: sourceOpFloor)
		return IterableIterationSource.cursor(source, entrySeed: flag)
	end 'absorbThrowingCursorSource'

	// Was this cursor produced by a direct call declaring `throws IterationError`? The op must be one
	// the source emitted (`sourceOpFloor`; see `opProducingTheValue`), it must define the value being
	// iterated (so `for x in f().cursor` does not rewrite `f`), and its callee's clause must be the
	// one the loop can absorb.
	function sourceCameFromAnIterationThrowingCall(source ValueId, sourceOpFloor ElementIndex) returns bool
		match self.opProducingTheValue(sourceOpFloor) 'producer'
			noOwnOp then return false
			at(opIdx) then return self.opIsAnIterationThrowingCallDefining(source, opIdx: opIdx)
		end 'producer'
	end 'sourceCameFromAnIterationThrowingCall'

	function opIsAnIterationThrowingCallDefining(source ValueId, opIdx ElementIndex) returns bool
		return match self.directCallDefining(opIdx, value: source) 'call'
			named(callee, _, _) gives throwsClauseIsIterationError(self.signatures.throwsOf(callee))
			notACall gives false
		end 'call'
	end 'opIsAnIterationThrowingCallDefining'

	// ⭐ **WHAT A `for … in` MAY ITERATE.** An `Array` instance whose element read is a random-access index,
	// which is what the counter lowering requires — plus the `FixedArray` whose record IS an array's, a
	// `String`'s grapheme clusters, and any source supplying the cursor protocol,
	// whether by DECLARING it or by REQUIRING it of what the value dispatches through. A corpus `Map` reaches
	// here as the CURSOR its own `createIterator()` returned and is admitted by the cursor arm rather than by
	// a container arm at all; a corpus `Array` is the one declared iterable that does NOT (see
	// `materializeIterableIterationSource`) and is admitted by the `Array` arm below. Everything else is a
	// clean E2015 naming the gap rather than a silent acceptance.
	//
	// ⚠ **`cursorSurface` ARRIVES RESOLVED, and is the same one `parseForStatement` will emit through.** This
	// door and that fork must not resolve it twice: an existential's resolution is a walk of the interface's
	// slot list per protocol name, and two walks are two chances to admit on one answer and emit on another.
	//
	// TWO sentences come out of here, and the split is which one is TRUE of the source. The shared one
	// enumerates what the compiler iterates and ends "any type declaring the cursor protocol", which misdescribes a
	// witness-dispatched receiver; that one refuses in its own words.
	function requireIterableSource(source ValueId, cursorSurface MethodSurface, forTok Token) throws SourceParseError
		// ⭐⭐ **THIS ARM IS THE CORPUS `Array`'S, AND IT IS THE SAME TEST THE EXEMPTION UPSTREAM
		// IS SPELLED WITH.** `stdlib/Array.maxon` declares `createIterator()`, so
		// `materializeIterableIterationSource` would rewrite a corpus array to its `ArrayIterator`, admitted by
		// the cursor arm; it declines that rewrite, because the counter
		// lowering this arm licenses is strictly cheaper than the cursor it would have built. It also still
		// admits a program's own `type Array … implements BuiltinArrayLiteral` that declares no cursor and no
		// factory — the name is served by the compiler either way (`isArrayBaseName` — an `Array`'s record IS
		// its buffer), which is exactly what lets `count`/`get` be read straight off the value.
		// MEASURED: both spellings emit `__managed_count` / `__managed_get_unchecked` and neither emits
		// `Array.createIterator` / `ArrayIterator.current`.
		if self.valueIsAnArray(source) 'array'
			return
		end 'array'

		// A STRING iterates its GRAPHEME CLUSTERS — see `parseForStatement`'s String arm.
		if tagIsText(self.tagOf(source)) 'string'
			return
		end 'string'

		// ⚠ A LIST needs no arm of its own. A corpus `List` declares `Iterable with (Element, ListIter)`, so it arrives
		// as the `ListIterator` its own `createIterator()` returned and is admitted by the cursor arm below —
		// the same route the corpus `Map` takes.
		// A FIXED ARRAY iterates exactly as an `Array` does — its record IS an array's, its length is its fixed
		// size, and `parseForStatement`'s counted form reads both off the record and the element through the
		// shared accessor, so the loop needed no arm of its own: only this admission.
		if self.signatures.isFixedArrayInstanceAt(self.tagOf(source), nameId: self.valueNameId(source)) 'fixedArray'
			return
		end 'fixedArray'

		// A USER TYPE walks its own CURSOR (conditional extensions) — the one source here that supplies its
		// own traversal instead of having one built for it, and the reason this function answers for more than
		// compiler-owned containers. See `parseForStatement`'s cursor arm and
		// `surfaceDeclaresCursorProtocol`, which is where the two method names live. The surface arrives
		// RESOLVED from `parseForStatement`, which is the party that also emits through it.
		if methodSurfaceExists(cursorSurface) 'cursor'
			return
		end 'cursor'

		// ⭐⭐ **THE ONE SURFACE THE SHARED SENTENCE IS WRONG ABOUT REFUSES IN ITS OWN WORDS**, read off the
		// source's OWN surface rather than off a tag — "how are this value's methods reached?" is a question
		// `methodSurfaceOf` answers, and asking it a second way here is exactly the duplication the
		// `MethodSurface` union exists to remove.
		// (An instance over an interface base is the SAME `witnessDispatched` receiver a bare
		// one is, and it reaches this refusal by the same route and in the same words.)
		//
		// ⚠ **IT MAY NOT READ `cursorSurface`, and reading it is wrong — measured: both refusals silently revert
		// to the shared sentence.** That parameter is the CURSOR surface: `cursorIterationSurface` collapses it
		// to `none` for any source that does not supply the protocol, which is precisely every source that
		// reaches this refusal. The two are different questions — "how are this value's methods reached" against
		// "does it walk its own cursor" — and only the first can say what is wrong.
		//
		// Re-deriving it here is one tag test plus, for a generic instance, one registry lookup, on the THROW
		// path only. It cannot disagree with the admission test's reading because it is the same function on the
		// same value; the expensive half — walking the slot list per protocol name — is not repeated.
		match self.methodSurfaceOf(source) 'sharedSentenceIsWrong'
			declared or
			none then break

			// ⭐ **A DISPATCHED RECEIVER: the shared sentence ends *"any type DECLARING the cursor protocol"*,
			// which is true of a struct source and false here.** A conformer may declare both methods and still
			// be unwalkable through this value, because the table the dispatch jumps through has a slot only for
			// what the INTERFACE requires. Naming the provider is what turns "the compiler cannot iterate this" into "add
			// the requirement", and `witnessDispatchProviderPhrase` words it for an existential and for a
			// constrained type parameter alike.
			//
			// ⚠ It says the requirements are not the protocol rather than that they are ABSENT, because the two
			// near misses reach here too: an `{String.from(AdvanceMethodName)}()` naming the wrong error type, and
			// one half of the pair supplied without the other.
			witnessDispatched(receiver) then throw SourceParseError.unsupported("`for … in` over a value dispatched through {self.witnessDispatchProviderPhrase(receiver)}, which supplies neither the cursor protocol `{String.from(CurrentMethodName)}()` + `{String.from(AdvanceMethodName)}() throws {String.from(IterationErrorTypeName)}` nor a `{String.from(CreateIteratorMethodName)}()` factory as a zero-argument REQUIREMENT — the traversal is a jump through the witness table the value carries, so it has to be something the interface requires; a conformer declaring it supplies no slot to dispatch through", line: forTok.line, column: forTok.column)
		end 'sharedSentenceIsWrong'

		try self.requireDeclaredBaseTypeName(self.tagOf(source), nameId: self.valueNameId(source), tok: forTok)

		throw SourceParseError.unsupported("`for … in` over a `{self.valueKindWord(source)}` value — the compiler iterates an `Array`, a `{String.from(FixedArrayBuiltinBaseName)}`, a `List`, a `{String.from(MapBuiltinBaseName)}`'s `(key, value)` entries, a `String`'s grapheme clusters, the counted ranges `<lo> to <hi>` / `<lo> upto <hi>`, and any type declaring the cursor protocol `{String.from(CurrentMethodName)}()` + `{String.from(AdvanceMethodName)}() throws {String.from(IterationErrorTypeName)}`", line: forTok.line, column: forTok.column)
	end 'requireIterableSource'

	// ⭐ **THE SURFACE THIS SOURCE WALKS ITS OWN CURSOR THROUGH, or `none` when it is not a cursor**
	// (conditional extensions). A surface and not a `bool`, because every caller that needs the answer also
	// needs the surface: it is what decides whether `current`/`advance` are emitted as direct calls or as
	// witness dispatches, so a separate lookup would be a second chance to resolve the receiver differently
	// from the admission test.
	function cursorIterationSurface(source ValueId, forTok Token) returns MethodSurface throws SourceParseError
		let surface = self.methodSurfaceOf(source)
		let suppliesTheProtocol = try self.surfaceDeclaresCursorProtocol(surface, anchor: forTok)

		if not suppliesTheProtocol 'noProtocol'
			return MethodSurface.none
		end 'noProtocol'

		return surface
	end 'cursorIterationSurface'

	// ⭐⭐ **HOW A VALUE'S TRAVERSAL-PROTOCOL METHODS ARE REACHED** — the ONE answer both `for … in` doors
	// above ask, and the reason neither says `structRef`. See `MethodSurface`.
	//
	// A plain struct answers its own name. A GENERIC INSTANCE answers its BASE, because the compiler compiles ONE body
	// per generic type: `Box with Integer`'s `createIterator` IS `Box.createIterator`, the same symbol
	// a `Box with String` reaches, and it is the name every other method door already mangles onto
	// (`denotedGenericBaseName`, `dispatchMethodOnBase`). An EXISTENTIAL answers `existential`: it has a name,
	// but its name is an INTERFACE, whose requirements no callee registry holds and whose conformers' bodies
	// are not what a dispatch binds against. Everything else — an int, a `String`, a closure — answers `none`.
	//
	// ⛔ **THE TWO DOORS ASKED `tagOf(source) != structRef` AND THAT GATE WAS THE BUG, NOT THE DESIGN.** A
	// `genericInstance` carries its base name AND its concrete type arguments, which is strictly MORE than a
	// `structRef` has — so `for x in b` over a `Box with Integer` that declares the whole cursor protocol was
	// **`E2015: for … in over a 'struct' value`**, a refusal whose own sentence names the protocol the value
	// supplies. (The word "struct" in it came from `typeTagName` of a tag that was not `structRef` at all.)
	//
	// ⛔ **AND ANSWERING A BARE NAME KEPT THE EXISTENTIAL OUT FOR THE SAME REASON ONE STEP LATER.** An
	// interface value's methods are not `declaresCallee` facts at all, so the only honest answer under a
	// `ByteArray` return was the empty one — and `for item in source` over an `Iterator`-shaped interface would be
	// **`E2015: for … in over a 'interface' value`**, again enumerating a protocol the value's own interface
	// requires. The kind is therefore part of the answer.
	function methodSurfaceOf(value ValueId) returns MethodSurface
		if self.tagOf(value) == ValueTypeTag.structRef 'plainStruct'
			return MethodSurface.declared(self.valueTypeName(value), receiver: value)
		end 'plainStruct'

		if self.tagOf(value) == ValueTypeTag.genericInstance 'instance'
			let base = self.signatures.genericInstanceBaseName(self.valueInstanceId(value))

			// ⭐⭐ **AN INSTANCE OVER AN `interface` BASE IS NOT A VALUE SHAPE AT ALL — IT IS AN EXISTENTIAL THAT
			// SOMETHING FAILED TO RESOLVE.** `ProgramSignatures.instanceDenotedType` makes `Seq with Integer` the
			// fat pointer `Seq` at every door that turns a written type into a `MaxonType`, so a VALUE carrying
			// this shape means a type reached the parser from a store none of those doors repaired. The `with`
			// arguments need no recording of their own: they are the conformances', folded by
			// `associatedAbiBindingOf`, and E3125 verifies what a use site claims they are.
			//
			// ⚠ **IT ASKS THE SAME PREDICATE `instanceDenotedType` ASKS, ON THE SAME MAP**, which is exactly what
			// makes this a compiler invariant rather than a program error: if that door saw this type it answered
			// `interfaceRef`, so the only way here is a type that never crossed it.
			if isInterfaceName(self.signatures.interfaceMap(), name: base) 'interfaceBase'
				panic("methodSurfaceOf: a value is typed `{String.from(base)} with …`, an instance over an INTERFACE base — `ProgramSignatures.instanceDenotedType` resolves every such instance to the existential `interfaceRef({String.from(base)})`, so this value's type reached the parser without crossing a type-resolution door. Whichever store handed it over needs the same repair `normalizeSweptInterfaceTypes` gives a swept field")
			end 'interfaceBase'

			return MethodSurface.declared(base, receiver: value)
		end 'instance'

		// Both witness receiver kinds, one arm — see `MethodSurface.witnessDispatched`.
		if self.tagOf(value) == ValueTypeTag.interfaceRef or self.tagOf(value) == ValueTypeTag.typeParameter 'dispatched'
			return MethodSurface.witnessDispatched(value)
		end 'dispatched'

		return MethodSurface.none
	end 'methodSurfaceOf'

	// ⭐⭐ **DOES THIS SURFACE SUPPLY THE CURSOR PROTOCOL?** — `ProgramSignatures.declaresCursorProtocol`'s
	// question, asked of whichever store holds the declarations. The two stores are genuinely different (a
	// whole-program callee index against an interface's transitive requirement list) and the RULE is one: both
	// want `current()` beside an `advance()` whose clause names `IterationError`, which is why the clause test
	// is `throwsClauseIsIterationError` on both sides rather than a callee lookup on one and a slot walk on
	// the other.
	function surfaceDeclaresCursorProtocol(surface MethodSurface, anchor Token) returns bool throws SourceParseError
		var receiver = 0 as ValueId

		match surface 'k'
			none then return false
			declared(typeName, _) then return self.signatures.declaresCursorProtocol(typeName)
			witnessDispatched(dispatchedOn) then receiver = dispatchedOn
		end 'k'

		match try self.witnessProtocolTarget(receiver, methodName: CurrentMethodName, anchor: anchor) 'current'
			notRequired then return false
			required then break
		end 'current'

		return match try self.witnessProtocolTarget(receiver, methodName: AdvanceMethodName, anchor: anchor) 'advance'
			notRequired gives false
			required(advance) gives throwsClauseIsIterationError(advance.throwsClause)
		end 'advance'
	end 'surfaceDeclaresCursorProtocol'

	// `ProgramSignatures.iterableFactory`'s question, asked of whichever store holds the declaration —
	// `surfaceDeclaresCursorProtocol`'s twin, split the same way and for the same reason. The EXISTENCE half
	// differs per store; `iterableFactoryFromClause` classifies what was found, once, for both.
	function surfaceIterableFactory(surface MethodSurface, anchor Token) returns IterableFactory throws SourceParseError
		var receiver = 0 as ValueId

		match surface 'k'
			none then return IterableFactory.notDeclared
			declared(typeName, _) then return self.signatures.iterableFactory(typeName)
			witnessDispatched(dispatchedOn) then receiver = dispatchedOn
		end 'k'

		return match try self.witnessProtocolTarget(receiver, methodName: CreateIteratorMethodName, anchor: anchor) 'factory'
			notRequired gives IterableFactory.notDeclared
			required(create) gives iterableFactoryFromClause(create.throwsClause)
		end 'factory'
	end 'surfaceIterableFactory'

	// What a diagnostic calls the traversal surface: the DECLARING TYPE for a direct-call source, and for an
	// existential the INTERFACE the value is held at — which is the name that answers "why can this not be
	// walked?", because the requirement list is what the loop was refused by.
	function methodSurfaceTypeName(surface MethodSurface) returns immutable ByteArray
		match surface 'k'
			declared(typeName, _) then return typeName
			witnessDispatched(receiver) then return self.internedName(self.valueNameId(receiver))
			none then panic("methodSurfaceTypeName: a value with no method surface has no declaration to name — every caller asks after the surface answered something else")
		end 'k'
	end 'methodSurfaceTypeName'

	// ⭐⭐ **THE REQUIREMENT AN EXISTENTIAL'S INTERFACE SUPPLIES UNDER A PROTOCOL NAME, resolved through the
	// SAME door a written `s.current()` resolves through.** `findWitnessDispatchCandidates` reads the
	// interface off the receiver's name id and the table off its witness pairing, walks the TRANSITIVE slot
	// list (so a protocol inherited through `extends` is found), and hands back targets already carrying the
	// slot index, the declaring interface and the declared `throws`. Re-deriving any of that here would be a
	// second answer to which slot a dispatch jumps through — the one thing that must not have two.
	//
	// ⚠ **THE FILTER IS "TAKES A RECEIVER, AND TAKES NOTHING ELSE", and both halves matter.** A `static`
	// requirement of the name declares no receiver slot, so prepending the source to it puts an argument in
	// front of a callee with no parameter for it — `requireWitnessDispatchCandidates` documents the wasm
	// `indirect call type mismatch` that produced. And the loop supplies no arguments at all, so a
	// `current(at Index)` requirement is not the protocol however plausibly it is named; taking it would slot
	// an actual the loop never had. Those two ARE the filter `dispatchWitnessMethod` applies — the receiver
	// test verbatim, and `pickWitnessDispatchByArity`'s at the arity the loop always calls with.
	//
	// ⛔⛔ **AND THE SURVIVORS GO THROUGH `pickSoleWitnessCandidate`, BECAUSE RETURNING ON THE
	// FIRST HIT AND THAT IS THE EXACT BUG `WitnessCandidatePick` EXISTS FOR.** `interface Derived extends Base`
	// with a zero-argument `current()` on EACH supplies two DISTINCT slots of that name — the shape
	// `pickWitnessDispatchByArity`'s header calls the ordinary spelling — and `witnessCandidateAlreadyCollected`
	// does not merge them, because they are two requirements and not two routes to one. MEASURED without the pick:
	// `source.current()` was **E3114** while `for item in source` COMPILED and
	// printed 10, silently binding whichever slot the transitive walk emitted first. That is a wrong function
	// pointer rather than a diagnostic, and it broke the rule `dispatchMethodOnBase` states in full — the door
	// a receiver came through may not change what the answer IS.
	function witnessProtocolTarget(receiver ValueId, methodName ByteArray, anchor Token) returns WitnessProtocolTarget throws SourceParseError
		let candidates = try self.findWitnessDispatchCandidates(receiver, methodName: methodName, errorTok: anchor)
		let protocolShaped = WitnessDispatchTargetArray.create(0)

		for i in 0 upto candidates.count() 'eachCandidate'
			let candidate = try candidates.get(i) otherwise panic("witnessProtocolTarget: candidates.get OOB at {i} below count {candidates.count()}")

			if witnessRequirementTakesReceiver(candidate) and candidate.paramTypes.count() == ProtocolMethodArity 'theProtocolShape'
				protocolShaped.push(candidate)
			end 'theProtocolShape'
		end 'eachCandidate'

		match pickSoleWitnessCandidate(protocolShaped) 'pick'
			none then return WitnessProtocolTarget.notRequired
			one(target) then return WitnessProtocolTarget.required(target)

			// The SAME sentence the written call gets, from the same door, at the one arity this filter selected
			// on — which is also the arity the loop calls with, so the two are `ProtocolMethodArity` and not two
			// literals that could drift apart.
			ambiguous(first, second) then throw SourceParseError.ambiguousWitnessDispatch(String.from(methodName), provider: self.witnessDispatchProviderPhrase(receiver), argCount: ProtocolMethodArity, first: renderWitnessRequirement(first, signatures: self.signatures), second: renderWitnessRequirement(second, signatures: self.signatures), line: anchor.line, column: anchor.column)
		end 'pick'
	end 'witnessProtocolTarget'

	// ⭐⭐ **WHAT A COUNTED RANGE'S BOUNDS MAY BE — the RANGE form's twin of `requireIterableSource`.**
	// A counted range is an INDEX PHI stepped by `emitMachineWordBinOp`, a
	// raw i64 add; a bound of any other domain hands that add something it cannot step, and the failure
	// was never a diagnostic:
	//   • `for x in 1.0 to 3.0` reached the x64 emitter and PANICKED — *"rax is in the gpr register file
	//     where the xmm file is required"* (`X64Backend.maxon:1377`), an internal error against a program
	//     the runnable oracle refuses cleanly (`E3005: Range expressions require int or Character, got
	//     'Float'`);
	//   • `for b in false to true` was silently ACCEPTED and ran two trips, incrementing a BOOL.
	// Everything else happened to land on a comparison type error (`"a" to "c"`, `1 to 3.5`) — which is
	// luck, not a rule: it is `emitCompare` refusing two operands, and it says nothing about the STEP.
	//
	// ⚠ **The test is `tagIsIntegral`, NOT `== ValueTypeTag.integer`** — see `columnValueTagMatches`'s
	// header for the measured false refusal the narrow spelling caused. A ranged alias (`typealias Row =
	// int(0 to 63)`) carries `named` until TypeResolution collapses it, and `for r in 0 to lastRow` where
	// `lastRow` is such a parameter must stay legal.
	//
	// ⚠ **A CHARACTER BOUND HAS ALREADY BEEN CONVERTED BY THE TIME THIS IS ASKED.** `'a' to 'e'` is a
	// pair of `Character` RECORDS as written, and `parseForStatement` runs BOTH bounds through
	// `integerizedOperand` before this rule sees them — so what arrives is two codepoints and this passes for
	// the reason a counted range does. It is NOT that a char literal "is an integer codepoint here": the
	// ELEMENT is a `Character` minted per trip from the counter (`ranges.character-range` prints `abcde`), and
	// a bound this rule still refuses is one the conversion could not express (a Character BINDING, a
	// multi-codepoint cluster) — which is exactly why the refusal is left to say so in its own words.
	//
	// Both bounds are asked, each anchored on its own half — the START on the source's first token, the
	// END on the `to`/`upto`, so a mixed range names the side that is wrong.
	function requireCountableRangeBound(bound ValueId, anchor Token) throws SourceParseError
		if tagIsIntegral(self.numberTagOf(bound)) 'countable'
			return
		end 'countable'

		throw SourceParseError.unsupported("a counted `for … in <lo> to|upto <hi>` range needs INTEGER bounds — got a '{self.valueKindWord(bound)}'. The loop variable is a counter stepped by 1, which no other domain has a meaning for; iterate a `float`/`String` by indexing an `Array` over it", line: anchor.line, column: anchor.column)
	end 'requireCountableRangeBound'

	// ⭐⭐ **THE SCOPE NAME OF THE STORAGE A CHAIN AT `baseIndex` IS WRITTEN THROUGH — THE ONE
	// DERIVATION** (`storageSubjectNameAt` asks it).
	//
	// ⚠ **`self.items` RESOLVES TO THE FIELD, NOT TO THE RECEIVER**, and that is the whole reason this
	// is not `baseBindingName`. A self-field's storage has TWO source spellings (`items`, `self.items`),
	// and `baseBindingName` answers `SelfParamName` for one of them — so one write would be keyed on two
	// different storages depending on how it was spelled.
	//
	// Nothing is lost by not naming the receiver: `self` is a PARAMETER and no write can go through it
	// (`requireMutableBinding`), so it was never the subject. And the field's name resolves to the one
	// alias `VarInfo` every spelling reaches, because a local may NOT shadow a self-field name inside a
	// method (`Scope.declareBinding`, E3006) — the name is unambiguous by construction, not by luck.
	function iterationSubjectNameAt(baseIndex ElementIndex) returns immutable ByteArray
		let baseTok = self.tokenAt(baseIndex)

		if baseTok.kind != TokenKind.self 'namesItself'
			return baseTok.value
		end 'namesItself'

		if self.kindAt(baseIndex + 1) == TokenKind.dot and self.kindAt(baseIndex + 2) == TokenKind.identifier 'selfRootedChain'
			return self.tokenAt(baseIndex + 2).value
		end 'selfRootedChain'

		// A bare `self` with no hop denotes the receiver itself, which is what `baseBindingName` says.
		return SelfParamName
	end 'iterationSubjectNameAt'

	// ⭐⭐⭐ **THE E3207 BLAME FOR A WRITE REACHED THROUGH A FIELD CHAIN** — the chain's base, when it is an
	// IMMUTABLE TOP-LEVEL BINDING, a record read out of one or out of a `let` field, or a binding a write may
	// not go through.
	//
	// ⛔⛔ **THE TOP-LEVEL HALF IS NOT ONLY A LANGUAGE RULE: THE RECORD MAY BE `.rdata`.** A module-level
	// `let` whose fields are image data reserves no storage at all, so `SharedFacts.counts.push(1)` reaches
	// `__mm_cow_detach`, which writes a page mapped READ-ONLY on x64; on wasm32-wasi, which has no read-only
	// section, the same write rewrites the constant. `storageSubjectNameAt` mints no subject for a
	// module-level name, so this door is where a chain's write to one is refused.
	//
	// ⚠ **THE BLAME IS THE BASE'S NAME AND NOT THE STORAGE SUBJECT'S, and the two differ exactly where it
	// matters.** The subject for `self.items.clear()` is `items`; what decides whether the WRITE is legal is
	// what the base PROMISED.
	function fieldChainImmutableNameAt(baseIndex ElementIndex) returns immutable ByteArray
		return self.chainBaseBindingBlame(baseIndex)
	end 'fieldChainImmutableNameAt'

	function chainBaseBindingBlame(baseIndex ElementIndex) returns immutable ByteArray
		let baseTok = self.tokenAt(baseIndex)

		match self.valueBaseAt(baseIndex) 'base'
			thisFrame then return self.boundBaseBlame(self.thisFrameBindingOf(baseTok), baseTok: baseTok)
			captured(frame) then return self.boundBaseBlame(self.capturedBindingOf(baseTok, frame: frame), baseTok: baseTok)
			unbound or
			alwaysAType then return EmptySourceText
		end 'base'
	end 'chainBaseBindingBlame'

	function boundBaseBlame(binding VarInfo, baseTok Token) returns immutable ByteArray
		if binding.isSelfField 'aFieldOfTheReceiver'
			return EmptySourceText
		end 'aFieldOfTheReceiver'

		return self.immutableReceiverNameOf(binding, baseTok: baseTok)
	end 'boundBaseBlame'

	// ⭐⭐ **THE STORAGE A CHAIN AT `baseIndex` NAMES, or empty when it names none** — `iterationSubjectNameAt`
	// (THE one derivation of *which binding a write goes through*) plus the one test that says the name denotes
	// storage this function body can reason about at all.
	//
	// ⚠ **LOCAL FIRST, which is what keeps a shadowing local a DIFFERENT subject** — the same order
	// `parseAssignment` resolves an assignment target in, and the reason `shadowed-source-is-writable`
	// compiles. A module-level name is asked through `baseNamesModuleLevelAt`, so a head a type claims names
	// no subject.
	function storageSubjectNameAt(baseIndex ElementIndex) returns StorageSubject
		match self.valueBaseAt(baseIndex) 'base'
			thisFrame then break
			unbound or
			captured or
			alwaysAType then return StorageSubject.none
		end 'base'

		let baseName = self.iterationSubjectNameAt(baseIndex)
		return StorageSubject.storage(baseName) if self.bodyState.scope.contains(baseName) else StorageSubject.none
	end 'storageSubjectNameAt'

	// The index of the `end` token that closes the block statement opening at `startIndex`,
	// found by counting block openers against `end`s — the same depth-counted token walk
	// `skipBalancedParens` does for `(`/`)`, and run for the same reason: the answer is needed
	// BEFORE the real parse reaches it. The cursor is not moved.
	//
	// `continuesAtElse` is the ONE difference between the two constructs that call this, and it
	// is exactly the fact that a loop's extent ends at its first depth-0 `end` while an `if`
	// chain's does not:
	//   • `while` passes FALSE — the first depth-0 `end` closes the loop.
	//   • `if` passes TRUE — at each depth-0 `end` the scan PEEKS past the optional block label
	//     (`elseFollowsEnd`); a following `else` opens the next branch (a plain `else`, or the
	//     `if` of an `else if`), re-opens the depth, and the scan carries on, so the extent
	//     spans the then body AND every `else`/`else if` branch through the final `end`.
	//
	// Deliberately TOLERANT of a malformed tail, like `recordScannedSignature`: an unterminated
	// construct yields the end of the token stream rather than a diagnostic. That
	// over-approximates the extent, which is the SAFE direction (a carried set is never too
	// SMALL — see `parseWhileStatement` / `assignedBindingsIn`), and the real parse runs next
	// and reports the unexpected EOF with a position.
	//
	// ⭐ **A NESTED CONSTRUCT IS STEPPED OVER, NOT WALKED INTO, AND THAT IS WHAT MAKES THIS LINEAR.** The
	// depth counting, the `elseFollowsEnd` continuation and the tolerant
	// tail all decide the answer — but a construct opening at depth ≥ 1 has its whole extent skipped
	// in ONE array read (`matchingEndOf`). That cannot change the answer: inside a nested pair the depth
	// never returns to 0, so neither the `depth == 0` test nor `elseFollowsEnd` could have fired there, and
	// the pair contributes net zero to the depth on the way through.
	//
	// Walking IN would cost `O(depth × tokens)`: a construct nested D deep would have its tokens
	// re-walked by all D scans enclosing it. `tests/ladders/gennest.sh` holds `depth × stmtsPerLevel`
	// fixed so the program barely changes size while the nesting doubles, which isolates that term.
	function blockStatementEndIndex(startIndex ElementIndex, continuesAtElse bool) returns ElementIndex
		self.buildBlockExtentIndex()

		let count = self.tokens.count()
		var depth = 0 as NestingDepth
		var i = startIndex

		while i < count 'scan'
			if self.opensBlockAt(i) 'open'
				if depth > 0 'nested'
					// `i` lands on the nested construct's own `end`; the step below moves past it, so this
					// scan never sees the pair at all. An UNTERMINATED nested construct answers `count`,
					// which ends the walk exactly where walking into it would have.
					i = self.matchingEndOf(i)
				end 'nested' else 'ownOpener'
					depth = depth + 1
				end 'ownOpener'
			end 'open' else if self.closesBlockAt(i) 'close'
				depth = depth - 1

				if depth == 0 and (not continuesAtElse or not self.elseFollowsEnd(i)) 'matched'
					return i
				end 'matched'
			end 'close'

			i = i + 1
		end 'scan'

		return count
	end 'blockStatementEndIndex'

	// Does an `else` follow the `end` at `endIndex` — i.e. does an `if` chain continue past
	// it? Skips the ONE optional block label (`end 'x' else …`) that may sit between them; a
	// bare `end else …` has none. Peeking exactly one charLiteral is enough because an `end`
	// carries at most a single label, and the token after it is either `else` or the next
	// statement. This is the one place `blockStatementEndIndex` decides an `if` chain
	// continues, so a missed `else` under-approximates the extent — which the drift guard
	// converts to a loud panic rather than a silent lost phi.
	//
	// ⚠ **AND THE `else` IT FINDS MUST NOT BE A NAME**, the same care `elseFollowsBlockEnd` — its BACKWARD
	// twin — takes by asking `closesBlockAt` rather than testing `TokenKind.end`. `else` is a legal case name
	// and a legal declared name, so `end 'x' else gives …` spells a labelled closer followed by a match
	// ARM named `else`. Left raw, one of the two twins knew the exclusion and the other did not — and the
	// failure is a MIS-PREDICTED EXTENT, which is a panic rather than a compile error. I could not construct a
	// reaching program (an arm is newline-separated from the `end` above it, and a newline breaks the
	// adjacency this needs), so this is the asymmetry closed, not a repro fixed.
	function elseFollowsEnd(endIndex ElementIndex) returns bool
		var next = endIndex + 1

		if self.kindAt(next) == TokenKind.charLiteral 'skipLabel'
			next = next + 1
		end 'skipLabel'

		return self.kindAt(next) == TokenKind.else and not self.keywordIsAName(next)
	end 'elseFollowsEnd'

	// Does the token at `index` open a block that a matching `end` closes?
	//
	// THIS IS MAXON'S BLOCK STRUCTURE, WRITTEN DOWN A SECOND TIME — `parseStatement` and
	// `parseBlockBody` own the first copy. It is kept honest by the drift panic in
	// `parseWhileStatement` rather than by hope: get this wrong and that panic fires, loudly,
	// on the first program that nests the missing construct in a loop.
	//
	// ⭐ `if`/`else` ARE THE SUBTLE PAIR, because the inline conditional `<t> if <c> else <f>`
	// spells BOTH keywords in EXPRESSION position with NO closing `end`. Counting a
	// ternary `if`/`else` as a block opener over-counts the depth and runs the extent past the real
	// `end`, so the drift guard fires (`let x = a if c else b` inside a loop body is enough). A block
	// `if`/`else` is told from a ternary one by POSITION:
	//   • a block `if` is at STATEMENT START — the previous token is a `newline` (a fresh statement)
	//     or an `else` (an `else if` chain); a ternary `if` follows an operand (`ifBeginsStatementIn`).
	//   • a block `else` closes a then-branch — it follows that branch's `end` and its one optional
	//     label (`elseFollowsBlockEnd`); a ternary `else` follows the condition operand.
	// `while` and `for` (statement-only) and `match` (statement OR expression) always close with their
	// own `end`, so all three unconditionally open a block.
	//
	// `else`'s pre-ternary subtlety is still live: a plain `else 'label'` opens a block body of its
	// own, but an `else if` does NOT — the else branch simply IS a nested `if` statement
	// (parseElseBody), and that `if` is the opener whose `end` closes it.
	//
	// `otherwise` is the other subtle one: only the BLOCK forms of a `try … otherwise` open a
	// block (`otherwiseOpensBlockIn`). The rest (`ignore`, a fallback value, a single-statement
	// return/break/continue/throw/panic) open nothing, so counting a bare `otherwise` would
	// leave an `end` unaccounted for.
	//
	// ⚠ A construct added here almost certainly has a CONDITION or SCRUTINEE, and an expression can build an
	// owned temporary — so it owes that temporary a release too. See `drainPendingTemps`, which keeps the
	// list of regions that settle their own.
	function opensBlockAt(index ElementIndex) returns bool
		let kind = self.kindAt(index)

		// Asked through the SHARED set rather than left to the chain below to answer by exhaustion, so that
		// set is a real dependency of this routine and not a comment about it — see
		// `kindSpellsBlockStructure`.
		if not kindSpellsBlockStructure(kind) 'notBlockStructure'
			return false
		end 'notBlockStructure'

		// `end` only ever CLOSES — `closesBlockAt` owns it — so it opens nothing, whatever it names. Answered
		// HERE rather than by falling off the end of the chain below, which is what lets that tail be a loud
		// drift panic instead of a silent `false`.
		if kind == TokenKind.end 'closerOnly'
			return false
		end 'closerOnly'

		// ⭐⭐ **THE KEYWORD-AS-A-NAME EXCLUSION, ONCE, AHEAD OF EVERY ARM — and it is one check rather than
		// one per arm because the arm that FORGOT it was a reachable compiler PANIC.** Three arms spelled
		// `not self.keywordIsAName(index)` for themselves and the fourth, `otherwise`, answered purely from
		// its position test. But `otherwiseOpensBlockIn`'s caught-error binding form is `otherwise ( <ident> )
		// <label>` — which a keyword-named METHOD CALL at the end of a block header spells character for
		// character. `while Ops.otherwise(i) 'loop'` (`.otherwise` is a legal member name) and
		// `while k == Kw.otherwise 'loop'` (a keyword-named enum CASE member, legal since
		// `keyword-named-case-members.md`) both opened a block nothing closed, and `assertScanAligned` took
		// the compiler down on a correct program. It is the same shape that spec already pins for `end`
		// (`match Kw.end 'm'` — a member plus a block label spelling a labelled closer); `otherwise` has a
		// labelled form too, and the exclusion must reach it.
		//
		// ⚠ So the exclusion is NOT an arm's business. An arm decides whether this POSITION opens a block;
		// whether the token is block structure AT ALL is one question, asked once, that a new arm cannot
		// fail to inherit. `closesBlockAt` is the same single check for the closing half.
		if self.keywordIsAName(index) 'aName'
			return false
		end 'aName'

		if kind == TokenKind.while or kind == TokenKind.match or kind == TokenKind.for or kind == TokenKind.modify or kind == TokenKind.acquire 'alwaysOpens'
			return true
		end 'alwaysOpens'

		if kind == TokenKind.if 'ifKw'
			return ifBeginsStatementIn(self.tokens, index: index)
		end 'ifKw'

		if kind == TokenKind.otherwise 'tryBlock'
			return otherwiseOpensBlockIn(self.tokens, index: index)
		end 'tryBlock'

		// `try` is the third position-sensitive one: only the BLOCK form spells a LABEL after the keyword, and
		// a label is told from a character-literal RECEIVER (`try 'A'.asciiValue()`) by the `.` behind it — see
		// `charLiteralOpensTryBlockIn`, which owns that rule. It is the same discriminator `parseStatement` routes on,
		// asked once there rather than restated here.
		if kind == TokenKind.try 'tryKw'
			return charLiteralOpensTryBlockIn(self.tokens, index: index + 1)
		end 'tryKw'

		if kind == TokenKind.else 'elseKw'
			// An `else if` opens NOTHING of its own: the else branch simply IS a nested `if` statement, and
			// that `if` is the opener whose `end` closes it.
			if self.kindAt(index + 1) == TokenKind.if 'elseIf'
				return false
			end 'elseIf'

			return self.elseFollowsBlockEnd(index)
		end 'elseKw'

		// ⚠ **THE DRIFT GUARD `kindSpellsBlockStructure`'s HEADER PROMISES.** Every kind that set admits has
		// an arm above, so this is unreachable — and a kind ADDED to that set without an arm here lands
		// loudly, on the first program that spells it, rather than silently opening no block at all.
		panic("opensBlockAt: '{kind.rawValue}' spells block structure but no arm here answers for it — a kind added to `kindSpellsBlockStructure` needs an arm here too")
	end 'opensBlockAt'

	// Does the token at `index` CLOSE a block — `opensBlockAt`'s counterpart, and its own predicate for the
	// same reason `assignsAt` is one. Every token scan in this file that counts block depth has to make the
	// keyword-as-a-NAME exclusion (`end` is a legal enum case name, so `end then …` is an arm and `Kw.end`
	// is a member read — neither is a closer). Spelled once, a scan cannot be taught the opener rule and
	// miss the closer rule — which would leave a depth counter that never comes back down.
	//
	// ⚠ **A SCAN THAT TESTS `TokenKind.end` ITSELF IS THIS BUG WAITING**, which is why the sweep's
	// `blockDepthAfter` and the match arm loop's end-of-arms test ask here.
	function closesBlockAt(index ElementIndex) returns bool
		if labelledBlockCloserAt(self.tokens, index: index) 'labelledCloser'
			return true
		end 'labelledCloser'

		return self.kindAt(index) == TokenKind.end and not self.keywordIsAName(index)
	end 'closesBlockAt'

	// Does the `else` at `index` close an if/else then-branch (a block `else`) rather than tail an
	// inline conditional? A block `else` follows the then-branch's `end` and its ONE optional block
	// label — the backward twin of `elseFollowsEnd` (`end 'x' else` or bare `end else`). A ternary
	// `else` follows the condition operand, so the token before it (past an optional label) is not a
	// block-closing `end`. Index 0 cannot be an `else`, so it is never a block `else`.
	//
	// ⚠ **IT ASKS `closesBlockAt`, NOT "is the previous token an `end`"**, and the difference is a
	// reachable PANIC: a ternary whose CONDITION ends in a keyword-named case member puts a literal
	// `end` immediately before the `else` (`let x = 1 if i == 0 or Kw.end == Kw.end else 2`). Read as
	// a block `else`, that ternary opens a block nothing closes and the enclosing loop's extent scan
	// runs past its `end` — `assertScanAligned` fires. `keyword-named-case-members.md` pins it.
	// (`elseFollowsEnd`, the forward twin, needs no such care: it is only ever asked at a token
	// `closesBlockAt` has already accepted.)
	function elseFollowsBlockEnd(index ElementIndex) returns bool
		if index == 0 'atStart'
			return false
		end 'atStart'

		var prev = index - 1

		if self.kindAt(prev) == TokenKind.charLiteral 'skipLabel'
			if prev == 0 'noRoom'
				return false
			end 'noRoom'

			prev = prev - 1
		end 'skipLabel'

		return self.closesBlockAt(prev)
	end 'elseFollowsBlockEnd'

	// Is the keyword at `index` being used as a NAME rather than as block structure? Read off the memo
	// `buildBlockExtentIndex`'s walk recorded — see `blockKeywordNames` and `keywordIsANameAt`, which is
	// where the question is actually decided and why it cannot be decided here.
	//
	// ⚡ A BISECT of the ascending memo, and the `count()` read is the whole cost for very nearly every
	// file: only a file that spells a keyword where its own construct could stand has any entry at all.
	function keywordIsAName(index ElementIndex) returns bool
		// A TRIPWIRE, not a path: every caller pre-checks the kind. Without it a reader asking about a kind
		// the walk never offers would get a silent `false` off a memo that can hold no entry for it.
		let kind = self.kindAt(index)

		if not kindAsksKeywordIsAName(kind) 'neverOffered'
			panic("keywordIsAName: '{kind.rawValue}' is never offered to the block-extent walk's name verdict, so this memo can hold no entry for it — a reader that needs an answer here belongs in `kindAsksKeywordIsAName`")
		end 'neverOffered'

		self.buildBlockExtentIndex()

		if self.adoptedExtents is self.anchors.noBlockExtents 'builtHere'
			return ascendingTokenIndexHolds(self.blockKeywordNames, index: index)
		end 'builtHere'

		return ascendingTokenIndexHolds(self.adoptedExtents.keywordNames, index: index)
	end 'keywordIsAName'

	// ⭐⭐ **THE DERIVATION BEHIND `keywordIsAName`, ASKED ONCE PER TOKEN BY THE BLOCK-EXTENT WALK.** It is
	// separate from the reader above for one reason: **three of the shapes below are rules about the
	// CONSTRUCT the token stands directly inside, and no bounded lookaround can see that.** The walk can —
	// its opener stack holds exactly the blocks still open BEHIND the cursor — so it supplies the
	// `NameContext` and records the verdict, and every later scan reads that one answer instead of guessing.
	//
	// ⚠⚠ **THE SCOPING IS NOT TIDINESS — AN UNSCOPED ARM LOOKAHEAD MISREAD A CONDITION AS A MATCH ARM
	// AND TOOK THE COMPILER DOWN.** Unscoped, the rule would be that a control keyword is *never*
	// followed by an arm separator — *"`if` takes a condition, `while` a condition"* — and that is
	// false: a condition may BEGIN with a keyword-named binding, so `function
	// twosComplementDistance(to ByteOffset, from ByteOffset)` makes `if to >= from 'forward'`
	// (`Targets/Shared/GlobalDataTable.maxon`) an `if` whose next token is `to`. Read as an arm
	// separator, that `if` opened no block, its `end` closed one that never opened, and
	// `assertScanAligned` fired on a legal program. `while`, `match` and `for` take the same shape,
	// and `then`/`gives`/ `upto`/`or` are equally declarable. Scoped to a match body the premise is
	// TRUE again, because a case name can stand nowhere else.
	//
	// ⚠ **AN ENUM CASE MAY BE SPELLED WITH A KEYWORD** (`enum TokenType { function if else end … }`,
	// keyword-as-case-name.md), so `if`/`else`/`end`/`while`/`match`/`for` can appear in a program as
	// an ordinary NAME. The block-extent token scans (`opensBlockAt`/`closesBlockAt`, and every scan
	// that counts depth through them) read those keywords as block STRUCTURE, so each place a keyword
	// is a name has to be excluded here or a scan miscounts — the construct's `end` is mispredicted
	// and `assertScanAligned` fires (or the arm loop stops early, or the declaration sweep records a
	// local as a top-level binding).
	//
	// **ONE FACT, so ONE predicate** — a divergence would leave the opener rule taught and the closer rule
	// not, or one shape taught and the next not. The CASE-LIST shape claims a whole level; the two ARM
	// shapes run only under `NameContext.matchBody`; the last two hold wherever the keyword stands:
	//
	//   • **AN ENUM/UNION BODY'S OWN LEVEL IS A CASE LIST, NOT BLOCK STRUCTURE.** `enum Kw { while match
	//     for omega }` declares four cases, and a case may be spelled with ANY keyword. Everything at that
	//     level is case material — a name, its `= raw`, its payload parens — with exactly two exceptions:
	//     the body's terminating `end` (told from a case NAMED `end` by `enumBodyEndsAt`, the one shared
	//     rule the real parse and the sweep read too) and a METHOD declaration, whose own block the walk
	//     pushes so its body is not read at member level. ⚠ MEASURED without it: `while`/`match`/`for`
	//     cases leaked openers past the enum's `end`, so for the rest of the file the walk believed it
	//     stood inside a match body — and `if to >= from 'forward'`, the keyword-named-binding condition
	//     that is legal, was read as an arm. The `if` opened nothing and `assertScanAligned` fired.
	//     `ensureSiblingReceivers` applies the identical rule in its own walk.
	//   • **A MATCH-ARM CASE NAME — the LOOKAHEAD.** `if gives …`, `end then …`, `else to critical then
	//     …`. Inside a match body a keyword immediately followed by `gives`/`then`/`to`/`upto`/`or` is a
	//     case name: an arm is the only thing that stands at that level, and a `match` header's own
	//     scrutinee sits BEFORE the body rather than in it.
	//     ⭐ **`to`/`upto` STAY IN THAT SET EVEN THOUGH A CASE RANGE IS NO LONGER A PATTERN** (E3146). The
	//     shape must still read as a NAME here or the extent scan closes the match AT the arm: `end to
	//     omega then …` would take `end` for the block terminator, and the author would get a mispredicted
	//     extent — a bogus E2026, or the `assertScanAligned` panic — in place of the diagnostic.
	//     ⛔ **OUTSIDE a match body this lookahead is WRONG, and the header above records the panic it
	//     cost.** Its premise — *"a control keyword is never followed by an arm separator in real
	//     control flow"* — reads `if`/`while`/`match`/`for` as taking a condition or a scrutinee, and a
	//     condition may BEGIN with a keyword-named binding. `if to >= from 'forward'` is the shape.
	//   • **A MATCH-ARM CASE NAME CARRYING A PAYLOAD BINDING LIST — the SAME LOOKAHEAD, PAST THE LIST.**
	//     `end(m) then …`, `while(a, b) gives …`. The separator sits after the list, not next to the
	//     keyword, so a lookahead of ONE token misses it entirely. ⚠ Both directions were REACHABLE and
	//     both refused a program the oracle compiles and runs: `end(m) then …` ended the arm loop, so the
	//     match reported `E2026 … not exhaustive, missing: end, omega`; `while(m) then …` opened a block
	//     nothing closed and took the compiler down in `assertScanAligned`.
	//     ⚠⚠ **THE SEPARATOR SET HERE IS DELIBERATELY NARROWER — `then`/`gives` ONLY — AND WIDENING IT
	//     BREAKS THE STDLIB.** A PARENTHESIZED condition is legal Maxon and is followed by whatever the
	//     expression around it needs: `if (driveByte >= 65 and driveByte <= 90) or (driveByte >= 97 …)
	//     'isDrive'` (`stdlib/FilePath.maxon`) puts `or` right past the group, and `while (try …
	//     otherwise 0) > 0 'loop'` puts an operator there. `then` and `gives` are the only two
	//     separators a payload-carrying arm can take AND the only two no real `if`/`while`/`match`/`for`
	//     header can be followed by. `to`/`upto` belong to scalar RANGE patterns, which carry no
	//     payload. ⚠ **`or` REMAINS THE ONE GENUINE GAP, and it is a gap rather than a moot point**:
	//     `end(m) or omega then …` reads as a closer, and since payload bindings on an or-arm are
	//     legal (`requireOrArmPayloadSlotsAgree`) nothing else refuses that program. Widening the set to
	//     admit it is what the stdlib line above forbids, so a KEYWORD-named case binding a payload as
	//     the first alternative of an `or`-chain is still not spellable — the narrow shape that remains
	//     unserved, and one no spec reaches today. ⚠ **AND IT FAILS AS A MISCOUNT, NOT AS A DIAGNOSTIC**: the
	//     scan misreads the arm before any binding check runs, so it surfaces as the two faults this list
	//     already records — a bogus `E2026 … not exhaustive` when the arm loop ends early, or the
	//     `assertScanAligned` compiler PANIC when a block is opened that nothing closes.
	//     `keyword-named-case-members.md` pins the payload arms AND the parenthesized-condition shapes
	//     that forbid the wider set.
	//   • **A LABEL — the `:` LOOKAHEAD.** `weigh(i, for: 3)`. See the arm below.
	//   • **A MEMBER NAME — the LOOKBEHIND.** `Kw.end`, `Kw.while`, `obj.end()`. A `.` is followed by a
	//     member name and by nothing else in this grammar (Maxon has no `..` range and a float literal
	//     is one token), so a keyword whose PREVIOUS token is a `.` is a name, whatever follows it.
	//     ⚠ This half is what a reachable compiler PANIC was made of, in BOTH directions:
	//     `keyword-named-case-members.md` pins them. `Kw.end` read as a CLOSER predicted a construct's
	//     `end` too early; `Kw.while`/`Kw.match`/`Kw.for` read as OPENERS predicted it too late. Worst
	//     of all is `match Kw.end 'm'`, whose scrutinee plus the match's own block label spell `end 'm'`
	//     — character for character a labelled closing `end`, and only the preceding `.` says otherwise.
	//     (`Kw.if`/`Kw.else`/`Kw.otherwise` never panicked, because those three are not unconditional
	//     block markers and their POSITION tests already refused a member — an unrelated reason, which
	//     is why they are pinned too.)
	//   • **A DECLARED NAME — an INDEX, not a lookaround.** `function while(n Integer)` names a function
	//     `while`, and `function f(end Integer)` names a parameter `end`; both are legal
	//     (`keyword-as-a-declared-name.md`), and both are exactly as dangerous here as a case member was.
	//     Unexcluded, the first opens a block nothing closes and the second closes one that never opened —
	//     so the file's whole extent index shifts and the declaration sweep's depth never returns to zero.
	//     ⚠ **THIS ONE CANNOT BE A LOOKAROUND, WHICH IS WHY IT COSTS AN INDEX.** The function NAME could be
	//     (`functionDeclarationAt(index - 1)`), but the PARAMETER cannot: `( match x` is a parenthesized
	//     match EXPRESSION and `( match X` is a parameter named `match`, and those are the same token shape
	//     — only the enclosing list's OWNER separates them, which no bounded lookaround can reach. See
	//     `recordDeclaredNamesAt`, which the same walk runs at the same cursor: every entry it makes is for
	//     a token strictly AHEAD of the one it stood on, so it is present before the cursor arrives there.
	function keywordIsANameAt(index ElementIndex, context NameContext) returns bool
		let kind = self.kindAt(index)
		let next = self.kindAt(index + 1)

		// The CASE-LIST level FIRST, because it claims every token at it and the shapes below are about
		// positions a case list has none of.
		if context == NameContext.caseList 'caseListLevel'
			if kind == TokenKind.end 'terminatorOrCaseNamedEnd'
				return not self.enumBodyEndsAt(index)
			end 'terminatorOrCaseNamedEnd'

			// The SHAPE, not `functionDeclarationAt`: this IS the memo entry that predicate reads. The
			// modifiers a method may carry are `declarationBeginsStatementIn`'s to step over.
			if kind == TokenKind.function 'methodOrCaseNamedFunction'
				return not functionDeclarationShapeIn(self.tokens, index: index)
			end 'methodOrCaseNamedFunction'

			return true
		end 'caseListLevel'

		// The two MATCH-ARM shapes, and they are asked only where an arm can stand. Everything below is
		// position-independent and stays unscoped.
		// ⚠ **A POSITIVE ANSWER ONLY — it must FALL THROUGH to the lookbehind, never answer `false` for
		// it.** A keyword followed by `(` can equally be a member READ of a keyword-named case that
		// carries a payload (`Kw.end(20, b: 22)`), which has the `.` before it AND the `(` after it.
		// Returning the separator test's verdict outright hid the lookbehind from exactly those reads —
		// measured, mid-review: `if tagOf(Kw.end(20, b: 22)) == 42 'ok'` took `assertScanAligned` down.
		if context == NameContext.matchBody and keywordSpellsAMatchArmCaseIn(self.tokens, groups: self.parenGroups, index: index) 'armShapes'
			return true
		end 'armShapes'

		// ⭐ **A LABEL — the OTHER lookahead, and it is a `:`.** `weigh(i, for: 3, match: 4)` labels a
		// keyword-named PARAMETER. (An ARGUMENT label is the only reader: a struct literal's `Self{x: 3}` keys
		// on a FIELD name, and a field DECLARATION admits no keyword — `var end as Integer` is
		// `E2010 Expected identifier but got 'end'` — so there is no keyword-named field to label.) A `:`
		// follows a NAME and nothing else in this grammar — no `if`/`while`/`match`/`for` header may be followed by one,
		// and Maxon has no `?:` and no label syntax that puts a colon after a keyword — so a keyword whose next
		// token is `:` is a name, whatever precedes it. Unexcluded, `for: 3` opened a block nothing closes and
		// `assertScanAligned` took the compiler down on the program `keyword-as-a-declared-name.md` pins.
		if next == TokenKind.colon 'argumentOrFieldLabel'
			return true
		end 'argumentOrFieldLabel'

		// Index 0 has no previous token, so it cannot be a member name — and no declaration spells a name
		// there either, since every one of them is introduced by a keyword that sits before it.
		if index == 0 'atFileStart'
			return false
		end 'atFileStart'

		if tokenFollowsAMemberDot(self.tokens, index: index) 'memberName'
			return true
		end 'memberName'

		// LAST, because it is the only shape that reads a MEMO rather than the token stream, and a real
		// closing `end` — the overwhelmingly common token this is asked about — reaches here.
		return self.namesADeclaration(index)
	end 'keywordIsANameAt'

	// Does a DECLARATION spell its NAME at `index` — a function's own name, or one of its parameters'?
	//
	// ⚡ A BISECT of the ascending `declaredNameKeywords`, and the `count()` read is the whole cost for very
	// nearly every file: only a file that actually declares a keyword-named function or parameter has any
	// entry at all (see the field).
	function namesADeclaration(index ElementIndex) returns bool
		self.buildBlockExtentIndex()

		if self.adoptedExtents is self.anchors.noBlockExtents 'builtHere'
			return ascendingTokenIndexHolds(self.declaredNameKeywords, index: index)
		end 'builtHere'

		return ascendingTokenIndexHolds(self.adoptedExtents.declaredNameKeywords, index: index)
	end 'namesADeclaration'

	// ⭐ **RECORD THE DECLARED NAMES THE `function` KEYWORD AT `index` INTRODUCES** — its own name where the
	// spelling has one, and every name position in the parameter list that follows. Returns the watermark
	// the block-extent walk carries forward: the token past the list this consumed, or `recordedThrough`
	// unchanged.
	//
	// ⚠ **THE WATERMARK IS WHAT KEEPS `declaredNameKeywords` ASCENDING**, which `namesADeclaration`'s bisect
	// rests on. A `function(` inside a parameter TYPE (`cb function(Integer) returns Integer`) is recorded
	// by its ENCLOSING list, so reaching it again from behind would push a lower index after a higher one
	// and duplicate it.
	//
	// **BOTH SPELLINGS OF `function` ARE COVERED, and deliberately.** A DECLARATION (`function <name> (`)
	// records its name and its parameters; a CLOSURE LITERAL (`function (`) has no name but records its
	// parameters just the same — a closure's parameters go through the very same `parseFunctionParameters`,
	// so they may be keyword-named too, and a closure body sits INSIDE a statement whose extent scan reads
	// those tokens.
	//
	// ⚠ **THE KEYWORD'S OWN NAME-NESS IS NOT CONSULTED, AND MUST NOT BE.** A closure literal inside a match
	// arm spells `function (…) gives`, which IS a payload-carrying arm's shape, so the walk calls that
	// keyword a name — and `while` in `function(while Idx) gives 40` is still a PARAMETER, which unrecorded
	// opens a block nothing closes. The arm `function gives (…)` needs no exclusion of its own: its `gives`
	// stands where the `(` would, so there is no list to descend into.
	function recordDeclaredNamesAt(index ElementIndex, recordedThrough ElementIndex) returns ElementIndex
		if self.kindAt(index) != TokenKind.function or index < recordedThrough 'nothingToRecord'
			return recordedThrough
		end 'nothingToRecord'

		// A named declaration's list starts one token later than a closure literal's, because the name sits
		// between the keyword and the `(`.
		var listAt = index + 1

		if self.functionDeclarationAt(index) 'named'
			self.recordNameKeyword(index + 1)
			listAt = index + 2
		end 'named'

		return self.recordParamNameKeywords(listAt)
	end 'recordDeclaredNamesAt'

	// Append `index` to `declaredNameKeywords` if the token there is a KEYWORD rather than a plain
	// identifier. Identifiers are dropped because no scan ever asks about one: `keywordIsAName` is consulted
	// only about `kindAsksKeywordIsAName`'s set, so an identifier entry would be one nothing can ever match.
	function recordNameKeyword(index ElementIndex)
		if self.kindAt(index) == TokenKind.identifier 'plainIdentifier'
			return
		end 'plainIdentifier'

		self.declaredNameKeywords.push(index)
	end 'recordNameKeyword'

	// ⭐ Record the parameter NAMES of the list at `parenPos` — by offering EVERY word-shaped token inside its
	// parentheses, which is deliberately COARSER than the parameter grammar and is what makes this walk both
	// exact enough and free. Returns the index the outer walk resumes at: past the list, or `parenPos` itself
	// when there is no list to descend into.
	//
	// **THE ARGUMENT: NO BLOCK STRUCTURE MAY APPEAR INSIDE A PARAMETER LIST.** A list holds names and TYPES —
	// `int(0 to 100)`, `function(X) returns Y`, `Array with T` — and not one statement, so there is no real
	// `while`/`match`/`for`/`end`/`if`/`else`/`otherwise` in there for an over-record to HIDE. The only reader
	// asks solely about those seven (`opensBlockAt`/`closesBlockAt`), so recording a type's `to` or `with`
	// costs nothing: no scan ever asks about them. UNDER-recording is the failure mode that matters, and
	// recording everything cannot under-record.
	//
	// ⚡ **AND IT IS WHY THIS DOES NOT SHARE `paramNamesIn`'s WALK.** That walk cannot answer without producing
	// per-parameter INDEXES, and the shared-index-columns version of this measured **+7,794 allocations at
	// rung 0 of the scale ladder, doubling per rung** — linear, but three heap objects on a path taken once
	// per `function` keyword in every file. This loop allocates nothing and duplicates no grammar: it does not
	// use the parameter grammar at all.
	//
	// TOLERANT at both ends, like every sweep helper: a bare `function` keyword (a legal enum CASE name)
	// reaches here with whatever token follows it, and an UNTERMINATED list records nothing rather than
	// swallowing the rest of the file. Both are the real parse's to report, with a position.
	//
	// ⚠ **AND THE "NO BLOCK STRUCTURE IN HERE" PREMISE IS CHECKED, NOT ASSUMED** — see
	// `parenGroupCanBeAParameterList`. It has to be, because the caller reaches this off a pure TOKEN SHAPE.
	function recordParamNameKeywords(parenPos ElementIndex) returns ElementIndex
		if self.kindAt(parenPos) != TokenKind.leftParen 'noParamList'
			return parenPos
		end 'noParamList'

		let listEnd = self.parenGroups.closeOf(self.tokens, open: parenPos)

		if self.kindAt(listEnd) != TokenKind.rightParen 'unterminated'
			return parenPos
		end 'unterminated'

		if not self.parenGroupCanBeAParameterList(parenPos, listEnd: listEnd) 'notAParameterList'
			return parenPos
		end 'notAParameterList'

		var q = parameterListStartIn(self.tokens, open: parenPos)

		while q < listEnd 'eachToken'
			if tokenCanBeAName(self.tokenAt(q)) 'wordShaped'
				self.recordNameKeyword(q)
			end 'wordShaped'

			q = q + 1
		end 'eachToken'

		return listEnd
	end 'recordParamNameKeywords'

	// ⭐⭐ **IS THE `( … )` SPANNING `[parenPos, listEnd]` REALLY A PARAMETER LIST?** The CHECK that
	// `recordParamNameKeywords`' safety argument rests on: that
	// routine offers EVERY word-shaped token inside the parentheses, which hides nothing only while nothing
	// in there is REAL block structure — true of a parameter list, which holds names and TYPES and not one
	// statement, and NOT true of an arbitrary expression.
	//
	// ⚠ **AND AN ARBITRARY EXPRESSION DOES REACH IT.** `recordDeclaredNamesAt` offers the group that
	// follows a `function` keyword the walk called a NAME, which is how a closure's parameters get
	// recorded — and a keyword-named case READ carrying arguments (`Kw.function(match x 'n' one gives
	// 1 end 'n')`) is the same two tokens with an expression in the parentheses. Without this check,
	// such a group's inner `match` AND its `end` are recorded as declared names, so `closesBlockAt`
	// stops seeing that `end`, the inner match's arm loop reads it as one more case name, and the
	// program is refused `E3034 unknown enum case: 'end'`, on a legal program.
	//
	// **THE TEST IS WHERE A BLOCK KEYWORD STANDS, because that is the entire difference.** In a parameter list
	// one may stand only as a NAME — immediately after the `(`, or after a top-level `,` — and a parameter's
	// TYPE (`Integer`, `int(0 to 100)`, `function(X) returns Y`, `Array with T`) can never contain one. So a
	// block keyword anywhere else says this group is an expression: nothing in it is recorded, and the caller
	// resumes at the `(` rather than past it, so the outer walk still descends and still finds a closure
	// literal nested inside.
	function parenGroupCanBeAParameterList(parenPos ElementIndex, listEnd ElementIndex) returns bool
		var depth = 0 as NestingDepth
		var namePosition = true
		var q = parameterListStartIn(self.tokens, open: parenPos)

		while q < listEnd 'eachToken'
			let kind = self.kindAt(q)

			if not namePosition and kindSpellsBlockStructure(kind) 'blockStructureOutsideANamePosition'
				return false
			end 'blockStructureOutsideANamePosition'

			if kind == TokenKind.leftParen 'nestedOpen'
				depth = depth + 1
			end 'nestedOpen'

			if kind == TokenKind.rightParen 'nestedClose'
				depth = depth - 1
			end 'nestedClose'

			// The token AFTER a top-level `,` is the next parameter's name; every other token is inside a type.
			namePosition = depth == 0 and kind == TokenKind.comma

			q = q + 1
		end 'eachToken'

		return true
	end 'parenGroupCanBeAParameterList'

	function takeBlockExtents() returns BlockExtents
		self.buildBlockExtentIndex()
		let movedExtentEnds = self.blockExtentEnds
		self.blockExtentEnds = TokenIndexArray.create(0)
		let movedKeywordNames = self.blockKeywordNames
		self.blockKeywordNames = TokenIndexArray.create(0)
		let movedDeclaredNames = self.declaredNameKeywords
		self.declaredNameKeywords = TokenIndexArray.create(0)
		return BlockExtents.create(self.tokens, extentEnds: movedExtentEnds, keywordNames: movedKeywordNames, declaredNameKeywords: movedDeclaredNames)
	end 'takeBlockExtents'

	function adoptBlockExtents(extents BlockExtents)
		if not (extents.tokens is self.tokens) or self.blockExtentsBuilt 'builtFromOtherTokensOrAlreadyBuilt'
			return
		end 'builtFromOtherTokensOrAlreadyBuilt'

		self.adoptedExtents = extents
		self.blockExtentsBuilt = true
	end 'adoptBlockExtents'

	// ⭐ **THE FILE'S BLOCK-EXTENT INDEX: per token, the `end` that closes the block opened there** — one
	// linear bracket-matching pass over the token array, run on the first construct that asks and shared
	// by every `if`/`while`/`match` after it. It is what lets `blockStatementEndIndex` step OVER a nested
	// construct in one array read instead of walking through its tokens.
	//
	// ⭐⭐ **IT DECIDES THE TWO KEYWORD MEMOS IN THE SAME PASS, AND THAT IS NOT A CONVENIENCE.** Whether a
	// keyword is block structure, a match-arm case NAME or an enum case depends on the construct open
	// around it (`keywordIsANameAt`), and the only thing that knows is this walk's own opener stack. So the
	// walk asks the question at each token, from the left context it already holds, and RECORDS the verdict
	// into `blockKeywordNames` — which is what lets `keywordIsAName`'s other readers share one answer
	// instead of re-deriving it from a context none of them has. `declaredNameKeywords` rides the same walk
	// (`recordDeclaredNamesAt`) because that memo is one of the inputs to the verdict.
	//
	// ⚠ **THE WALK IS RE-ENTRANT AND THAT IS SOUND, for one reason: every name-ness read it makes is of a
	// token AT or BEHIND the cursor.** `keywordIsAName` is asked only at the cursor, after
	// `recordBlockKeywordName` has already decided that token; and every declared-name entry is for a token
	// strictly AFTER the `function` keyword that declares it, pushed while the walk stands on that keyword,
	// so it is present before the cursor reaches it. Nothing the walk reaches reads an EXTENT
	// (`matchingEndOf` has no caller here), which is why the gate may be shut before the first of those calls.
	//
	// Idempotent, and the shared-empty `is`-identity of the extent column is the "have I run?" gate for all
	// three outputs (see the field): the fresh column installed below is what says it has run, whether or
	// not the file opens a single block.
	function buildBlockExtentIndex()
		if not self.blockExtentsBuilt 'notBuiltYet'
			self.blockExtentsBuilt = true
			let tokenCount = self.tokens.count()

			// One entry per token, and ZERO wherever no block opens — a value no real answer can take, since
			// a matched opener's `end` sits after it and an unmatched one is seeded below with the end of the
			// token stream. `matchingEndOf` panics on a zero rather than inventing an extent.
			// ALL THREE OUTPUTS ARE INSTALLED BEFORE THE WALK, AND THE WALK WRITES THROUGH `self` — see the
			// re-entrancy paragraph above.
			self.blockExtentEnds = TokenIndexArray.create(tokenCount)
			self.blockKeywordNames = TokenIndexArray.create(0)
			self.declaredNameKeywords = TokenIndexArray.create(0)

			// The openers not yet closed, innermost last — the bracket-matching stack.
			let openers = TokenIndexArray.create(0)

			// The token past the last parameter list already recorded, which is what keeps
			// `declaredNameKeywords` ascending (see `recordDeclaredNamesAt`).
			var declaredThrough = 0 as ElementIndex

			// ⚠ **A MEMBER LIST CANNOT OPEN INSIDE A `( … )`.** The lexer drops a newline there except
			// in a `match` or block-form `otherwise` (`Lexer.dropBracketedLayout`), so only MALFORMED
			// source puts `enum Idx` at a statement start inside parentheses — and an opener pushed for
			// it is never closed, which would turn a clean diagnostic into an extent-scan panic.
			// `opensBlockAt`'s own kinds need no such guard: none of them is a legal parameter name.
			var parenDepth = 0 as NestingDepth

			var i = 0 as ElementIndex

			while i < tokenCount 'scan'
				let kind = self.kindAt(i)

				if kind == TokenKind.leftParen 'groupOpens'
					parenDepth = parenDepth + 1
				end 'groupOpens'

				let context = self.innermostOpenerContext(openers)

				// BEFORE the predicates below, because every one of them reads it back through
				// `keywordIsAName` for this very token.
				self.recordBlockKeywordName(i, context: context)
				declaredThrough = self.recordDeclaredNamesAt(i, recordedThrough: declaredThrough)

				// ⭐ **A MEMBER LIST'S OPENER — an `enum`/`union` declaration, and inside one, a METHOD.**
				// Neither is block structure `opensBlockAt` counts, and both have to be on the stack anyway:
				// the enum so its body reads as a case list, the method so ITS body does not, and so that its
				// own `end 'name'` pops the method rather than the enum. Each is pushed ONLY where it can stand:
				// an interface requirement is a bodiless `function name(` line with no `end` at all, and two
				// cases may share a line, so a case NAMED `enum` followed by the next case spells
				// `enumDeclarationAt`'s lookaround exactly. Pushed anywhere else, either leaks an opener for
				// the rest of the file.
				let opensMemberList = parenDepth == 0 and ((context == NameContext.statementLevel and self.enumDeclarationAt(i)) or (context == NameContext.caseList and self.functionDeclarationAt(i)))

				if opensMemberList or self.opensBlockAt(i) 'opensBlock'
					openers.push(i)

					// UNTERMINATED until a closer says otherwise — the end of the token stream, which is the
					// tolerant answer `blockStatementEndIndex`'s header states for a construct with no `end`.
					// Seeded at the PUSH so there is no post-scan drain to keep in step with this loop.
					try self.blockExtentEnds.set(i, value: tokenCount) otherwise panic("buildBlockExtentIndex: opener {i} is outside this file's token space")
				end 'opensBlock' else if self.closesBlockAt(i) 'closesBlock'
					// A closer with nothing open closes nothing — the same malformed input the walk in
					// `blockStatementEndIndex` carries straight past on a negative depth.
					if openers.count() > 0 'hasOpener'
						let opener = try openers.pop() otherwise panic("buildBlockExtentIndex: pop from an opener stack just checked non-empty")
						try self.blockExtentEnds.set(opener, value: i) otherwise panic("buildBlockExtentIndex: opener {opener} is outside this file's token space")
					end 'hasOpener'
				end 'closesBlock'

				// Floored, because a stray `)` closes no group and a negative depth would disable the member-
				// list arm for the whole rest of the file. Malformed source is the real parse's to report.
				if kind == TokenKind.rightParen and parenDepth > 0 'groupCloses'
					parenDepth = parenDepth - 1
				end 'groupCloses'

				i = i + 1
			end 'scan'
		end 'notBuiltYet'
	end 'buildBlockExtentIndex'

	// What the innermost block still open makes of a keyword standing at the cursor. Read off the walk's
	// opener stack, which holds only openers BEHIND the cursor, so the answer is a fact about the left
	// context and cannot be circular with the extent this same walk is computing.
	//
	// A construct nested inside an arm or a member pushes its own opener and becomes the innermost, so "the
	// innermost is a `match`" is exactly "at the match's own level", and likewise for a case list: a body
	// cannot re-enter its own level without opening a block of its own first.
	function innermostOpenerContext(openers TokenIndexArray) returns NameContext
		if openers.isEmpty() 'noneOpen'
			return NameContext.statementLevel
		end 'noneOpen'

		let innermost = try openers.last() otherwise panic("innermostOpenerContext: the opener stack is non-empty by the guard above and has no last")
		let kind = self.kindAt(innermost)

		if kind == TokenKind.match 'matchBody'
			return NameContext.matchBody
		end 'matchBody'

		if kind == TokenKind.enum or kind == TokenKind.union 'caseList'
			return NameContext.caseList
		end 'caseList'

		return NameContext.statementLevel
	end 'innermostOpenerContext'

	// Decide whether the token at `index` is a keyword spelling a NAME rather than the construct its kind
	// names, and append it to the ascending memo if it is — the one caller of `keywordIsANameAt`.
	//
	// Only the kinds `kindAsksKeywordIsAName` admits are offered, because those are the only ones any reader
	// asks about: an entry for anything else would be one the bisect can never be asked to match, and
	// `keywordIsAName` panics on such a question rather than answering `false` off an empty memo. That gate
	// stands FIRST, so the work below runs at the few tokens that can answer anything and not at every one.
	function recordBlockKeywordName(index ElementIndex, context NameContext)
		if not kindAsksKeywordIsAName(self.kindAt(index)) 'neverAsked'
			return
		end 'neverAsked'

		if not self.keywordIsANameAt(index, context: context) 'isBlockStructure'
			return
		end 'isBlockStructure'

		self.blockKeywordNames.push(index)
	end 'recordBlockKeywordName'

	// The index of the `end` that closes the block opened at `index`, or the end of the token stream when
	// nothing does — O(1) off `buildBlockExtentIndex`'s column.
	//
	// ⚠ ONLY MEANINGFUL AT AN OPENER THE WALK PUSHED — block structure, an `enum`/`union` declaration, or
	// a method inside a case list — which is why a zero entry PANICS rather than answering: nothing opens
	// at that token, and any extent returned for it would be invented. Every caller asks under
	// `opensBlockAt`, so the panic is a tripwire and not a path.
	function matchingEndOf(index ElementIndex) returns ElementIndex
		let closer = self.extentEndAt(index)

		if closer == 0 'notAnOpener'
			panic("matchingEndOf: nothing opens at token {index} — the extent column holds an extent only for an opener `buildBlockExtentIndex` pushed")
		end 'notAnOpener'

		return closer
	end 'matchingEndOf'

	function extentEndAt(index ElementIndex) returns ElementIndex
		if self.adoptedExtents is self.anchors.noBlockExtents 'builtHere'
			return try self.blockExtentEnds.get(index) otherwise panic("matchingEndOf: token {index} is outside this file's token space")
		end 'builtHere'

		return try self.adoptedExtents.extentEnds.get(index) otherwise panic("matchingEndOf: token {index} is outside this file's token space")
	end 'extentEndAt'

	// THE GUARD ON A TOKEN-EXTENT SCAN, shared by `parseWhileStatement` and `parseIfStatement`.
	// `blockStatementEndIndex` re-derives Maxon's block structure at the token
	// level to fix a construct's carried-variable set BEFORE its body is parsed — a SECOND copy
	// of a fact the recursive-descent parser owns. If the two disagree the scan's extent is too
	// SHORT, the carried set is a SUBSET, and a carried var silently loses its merge phi: a wrong
	// answer with no diagnostic. This converts it into a loud one — the `end` the parser actually
	// consumed to close the last body (`lastBlockBodyEnd`) must be the one the scan predicted.
	//
	// It is what makes the duplication safe to keep. A future block statement (`for`, `match`)
	// added to `parseStatement` without teaching `opensBlockAt` about it trips this panic on the
	// first spec that nests it in a loop or an `if`, instead of miscompiling it. (Over-shooting
	// the extent cannot hide here: it never under-counts the carried set, and it would make the
	// prediction miss the actual `end` and panic too — so the scan is pinned from both sides.)
	function assertScanAligned(construct String, predictedEnd ElementIndex)
		if self.statement.lastBlockBodyEnd != predictedEnd 'scanDrifted'
			panic("{construct}: the token scan predicted the closing `end` at token {predictedEnd} but the parser closed the last body at token {self.statement.lastBlockBodyEnd} — `opensBlockAt` does not know every statement that opens a block, so the carried-variable set it computed may be missing a carried var")
		end 'scanDrifted'
	end 'assertScanAligned'

	// Set up the exit block's post-loop variable values. With no `break`, the exit is
	// reached only from the condition's false edge, so each var's value there IS its
	// header phi (no exit phi needed). With ≥1 `break`, the exit MERGES the condition-
	// false value with each break's value, so it gets its own phis and the false edge
	// passes the header phi values into them (the break edges were recorded as the breaks
	// were parsed).
	//
	// `condExit` — the block the condition ENDED in, which carries the two-way branch — is
	// the false edge's source, and it is only the header when the condition short-circuited
	// nowhere. Recording the edge on the header instead would attach the exit's phi operands
	// to a block that does not branch to the exit at all.
	//
	// Index-based in both loops so each phi var is a MUTABLE binding — a `for x in …`
	// loop variable is immutable, and installing the post-loop value writes through the
	// binding it carries.
	function wireLoopExit(condExit IrBlock, exit IrBlock, ctx LoopContext)
		if not ctx.hasBreak 'noBreak'
			for k in 0 upto ctx.phiVars.count() 'inherit'
				let pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
				self.recordDebugRebind(pv.binding.debugLocalSlot, recorded: pv.binding.debugLocalRecorded, current: pv.binding.boundValue, value: pv.phiId, def: DebugVersionDef.merged)
				pv.binding.setBoundValue(pv.phiId, ledger: self.bodyState.moveLedger)
			end 'inherit'

			return
		end 'noBreak'

		let headerVals = ValueIdArray.create(0)

		for k in 0 upto ctx.phiVars.count() 'mkExitPhi'
			let pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
			let exitPhiId = self.mintPhiForBinding(exit, binding: pv.binding)
			self.recordDebugRebind(pv.binding.debugLocalSlot, recorded: pv.binding.debugLocalRecorded, current: pv.binding.boundValue, value: exitPhiId, def: DebugVersionDef.definedIn(exit.id))
			pv.binding.setBoundValue(exitPhiId, ledger: self.bodyState.moveLedger)
			self.pushMergedEdgeValue(headerVals, binding: pv.binding, value: pv.phiId)
		end 'mkExitPhi'

		self.recordBranchEdge(condExit, targetId: exit.id, argIds: headerVals)
	end 'wireLoopExit'

	function openLoopScan(header IrBlock, preheader IrBlock, phiVars LoopPhiVarArray) returns ElementIndex
		self.mintCellHeaderEpochs()
		self.bodyState.loopScans.push(LoopMoveScan.create(self.bodyState.valueTags.count() as ValueId, blockFloor: header.id, preheader: preheader, phiVars: phiVars, entryMark: self.captureMoveMark()))
		return (self.bodyState.loopScans.count() - 1) as ElementIndex
	end 'openLoopScan'

	function innermostLoopScan() returns LoopMoveScan
		return try self.bodyState.loopScans.last() otherwise panic("innermostLoopScan: no loop scan is open")
	end 'innermostLoopScan'

	function noteLoopConditionExit()
		let scan = self.innermostLoopScan()
		scan.exitMark = self.captureMoveMark()
	end 'noteLoopConditionExit'

	function noteLoopBackEdge(block IrBlock, height ElementIndex)
		let scan = self.innermostLoopScan()
		scan.backEdges.push(ReachingMoveEdge.create(block, mark: moveMarkPrefix(self.captureMoveMark(), height: height)))
	end 'noteLoopBackEdge'

	function finishLoopMoves(func IrFunction, falseSource IrBlock, exit IrBlock, anchor Token) returns FinishedLoop throws SourceParseError
		let scan = try self.bodyState.loopScans.pop() otherwise panic("finishLoopMoves: the loop scan stack is empty at the end of a loop that opened one")

		try self.settleCarriedCapabilities()

		self.discardLoopReleaseChains(scan.blockFloor)
		let movedAtTheHeader = ValueMarkSet.create()
		let touched = self.loopTouchedPositions(scan)

		for position in touched 'eachTouchedBinding'
			try self.settleBackEdgesOf(func, scan: scan, position: position, movedAtTheHeader: movedAtTheHeader, anchor: anchor)
		end 'eachTouchedBinding'

		try self.settleBackEdgeConsumes(scan)

		let falseMark = self.loopExitEdgeMark(scan.exitMark, scan: scan, movedAtTheHeader: movedAtTheHeader, touched: touched)

		if scan.breakEdges.isEmpty() 'onlyTheConditionLeaves'
			self.restoreMoveMark(falseMark)
			return FinishedLoop.create(falseSource, scan: scan)
		end 'onlyTheConditionLeaves'

		let edges = ReachingMoveEdgeArray.create(scan.breakEdges.count() + 1, zeroed: false)

		for breakEdge in scan.breakEdges 'eachBreak'
			edges.push(ReachingMoveEdge.create(breakEdge.block, mark: self.loopExitEdgeMark(breakEdge.mark, scan: scan, movedAtTheHeader: movedAtTheHeader, touched: touched)))
		end 'eachBreak'

		let falseEdge = self.loopFalseEdgeBlock(func, falseSource: falseSource, exit: exit, falseMark: falseMark, breaks: edges)
		edges.push(ReachingMoveEdge.create(falseEdge, mark: falseMark))
		self.reconcileMovesAtMerge(edges, anchor: anchor)
		return FinishedLoop.create(falseEdge, scan: scan)
	end 'finishLoopMoves'

	function loopTouchedPositions(scan LoopMoveScan) returns MoveSlotIndexColumn
		let entry = scan.entryMark
		let edges = MoveSlotsColumn.create(scan.backEdges.count() + 1 + scan.breakEdges.count(), zeroed: false)

		for back in scan.backEdges 'eachBackEdge'
			edges.push(back.mark.slots)
		end 'eachBackEdge'

		edges.push(scan.exitMark.slots)

		for breakEdge in scan.breakEdges 'eachBreakEdge'
			edges.push(breakEdge.mark.slots)
		end 'eachBreakEdge'

		let enclosing = MoveSlotsColumn.create(self.bodyState.loopScans.count(), zeroed: false)

		for outer in self.bodyState.loopScans 'eachEnclosingLoop'
			enclosing.push(outer.entryMark.slots)
		end 'eachEnclosingLoop'

		let positions = entry.slots.unsettledPositions(edges, enclosing: enclosing)

		// A cell binding is settled even where its slots agree: its settlement reads occupant exclusivity
		// and cell takes, which the slots do not hold.
		for cell in self.bodyState.moveLedger.refreshedOwners(self.bodyState.ownedBindings).cellPositions() 'eachCell'
			if cell < entry.height() 'declaredBeforeTheLoop'
				positions.push(cell)
			end 'declaredBeforeTheLoop'
		end 'eachCell'

		return sortedUniquePositions(positions)
	end 'loopTouchedPositions'

	function settleBackEdgesOf(func IrFunction, scan LoopMoveScan, position ElementIndex, movedAtTheHeader ValueMarkSet, anchor Token) throws SourceParseError
		let headerValue = scan.entryMark.valueAt(position)
		let owned = try self.bodyState.ownedBindings.get(position) otherwise panic("settleBackEdgesOf: ownedBindings.get OOB at {position} below the loop's owned floor")
		let ownedIsCell = owned.isCellBinding
		let ownedIsObligation = owned.isErrorMatchObligation
		let ownedName = owned.name

		if ownedIsCell 'aCellBinding'
			try self.settleCellBackEdges(scan, position: position, headerEpoch: headerValue, movedAtTheHeader: movedAtTheHeader)
			return
		end 'aCellBinding'

		if not scan.settlesAtEntry(position) 'movedBeforeTheLoop'
			self.dropOnLiveBackEdges(scan, position: position, dependents: HeaderDependents.create(headerValue), anchor: anchor)
			self.settleTheLoopForEnclosingLoops(scan, position: position)
			return
		end 'movedBeforeTheLoop'

		let movedOnABackEdge = scan.movedOnABackEdge(position)

		if ownedIsObligation and (movedOnABackEdge or scan.exitMark.movedAt(position)) 'anObligation'
			throw errorMatchInsideALoopRefusal(ownedName, at: SourceRange.ofToken(anchor))
		end 'anObligation'

		if reclaimedOnABackEdge(scan, headerValue: headerValue) 'linearAwaitDecidesIt'
			return
		end 'linearAwaitDecidesIt'

		if not movedOnABackEdge 'liveOnEveryBackEdge'
			return
		end 'liveOnEveryBackEdge'

		let movedValues = try self.settleTheHeaderAsMoved(func, scan: scan, position: position, headerValue: headerValue, anchor: anchor)

		for value in movedValues 'eachMovedValue'
			movedAtTheHeader.insert(value)
		end 'eachMovedValue'
	end 'settleBackEdgesOf'

	function settleCellBackEdges(scan LoopMoveScan, position ElementIndex, headerEpoch ValueId, movedAtTheHeader ValueMarkSet) throws SourceParseError
		self.settleCellOccupantAcrossTheLoop(scan, position: position, headerEpoch: headerEpoch)

		if not scan.settlesAtEntry(position) or not scan.movedOnABackEdge(position) 'liveOnEveryBackEdge'
			return
		end 'liveOnEveryBackEdge'

		let dependents = scan.cellEpochsRootedAt(headerEpoch)

		match scan.firstReadAmong(dependents) 'read'
			none then break
			read(at) then throw at.movedInAnEarlierIteration()
		end 'read'

		for epoch in dependents.values 'eachMovedEpoch'
			movedAtTheHeader.insert(epoch)
		end 'eachMovedEpoch'
	end 'settleCellBackEdges'

	function settleCellOccupantAcrossTheLoop(scan LoopMoveScan, position ElementIndex, headerEpoch ValueId)
		var carried = CellOccupantExclusivity.sole

		for back in scan.backEdges 'eachBackEdge'
			carried = joinedOccupantExclusivity(carried, b: self.cellEpochExclusivityOf(back.mark.valueAt(position)))
		end 'eachBackEdge'

		for epoch in scan.cellEpochsRootedAt(headerEpoch).values 'eachEpochOfTheHeader'
			self.raiseCellEpochExclusivity(epoch, to: carried)
		end 'eachEpochOfTheHeader'
	end 'settleCellOccupantAcrossTheLoop'

	// An epoch is a fresh `void` ValueId no op defines, so it rides the move marks' per-binding value
	// columns through branches and merges exactly as a binding's value does
	// (`settleCellEpochAtMerge`).
	function mintCellEpoch(exclusivity CellOccupantExclusivity) returns ValueId
		let epoch = self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
		self.bodyState.cellEpochExclusivity = withCellEpochExclusivity(self.bodyState.cellEpochExclusivity, epoch: epoch, exclusivity: exclusivity)
		return epoch
	end 'mintCellEpoch'

	function cellEpochExclusivityOf(epoch ValueId) returns CellOccupantExclusivity
		match self.bodyState.cellEpochExclusivity 'column'
			unwritten then panic("cellEpochExclusivityOf: v{epoch} is asked of a body that minted no cell epoch")
			entries(byEpoch) then return try byEpoch.get(epoch) otherwise panic("cellEpochExclusivityOf: v{epoch} is no cell epoch — every epoch is minted with the exclusivity of what it holds")
		end 'column'
	end 'cellEpochExclusivityOf'

	function raiseCellEpochExclusivity(epoch ValueId, to CellOccupantExclusivity)
		self.bodyState.cellEpochExclusivity = withCellEpochExclusivity(self.bodyState.cellEpochExclusivity, epoch: epoch, exclusivity: joinedOccupantExclusivity(self.cellEpochExclusivityOf(epoch), b: to))
	end 'raiseCellEpochExclusivity'

	function mintCellHeaderEpochs()
		for i in self.bodyState.moveLedger.refreshedOwners(self.bodyState.ownedBindings).cellPositions() 'eachCell'
			let binding = try self.bodyState.ownedBindings.get(i) otherwise panic("mintCellHeaderEpochs: ownedBindings.get OOB at {i} below its own count")
			let entering = binding.cellEpoch.epochValue()
			let headerEpoch = self.mintCellEpoch(joinedOccupantExclusivity(self.cellEpochExclusivityOf(entering), b: CellOccupantExclusivity.unproven))
			binding.cellEpoch = CellEpoch.current(headerEpoch)
			binding.noteWritten(self.bodyState.moveLedger)
			self.noteDerivedCellEpoch(headerEpoch, from: entering)
		end 'eachCell'
	end 'mintCellHeaderEpochs'

	function noteDerivedCellEpoch(epoch ValueId, from ValueId)
		for scan in self.bodyState.loopScans 'eachLoop'
			let root = try scan.cellEpochRootOf(from) otherwise continue
			scan.noteCellEpochRoot(epoch, root: root)
		end 'eachLoop'
	end 'noteDerivedCellEpoch'

	function noteCellHandedByReference(binding VarInfo, anchor Token)
		let entering = binding.cellEpoch.epochValue()
		let handed = self.mintCellEpoch(CellOccupantExclusivity.unproven)
		let handedOver = binding
		handedOver.cellEpoch = CellEpoch.current(handed)
		handedOver.noteWritten(self.bodyState.moveLedger)
		self.noteDerivedCellEpoch(handed, from: entering)
		self.openByRefHandOffs.push(OpenByRefHandOff.create(self.artifact.currentFuncIndex, epoch: handed, anchor: anchor))
		self.noteHandedStorageType(binding.boundValue, varType: binding.varType)

		if not binding.brandKey.isEmpty() 'anAdoptableVar'
			self.noteHandedBrand(binding.boundValue, key: binding.brandKey, phrase: assignedPlacePhrase(FunctionTypeDoor.variable, name: binding.name, owner: SlotOwner.unowned))
		end 'anAdoptableVar'
	end 'noteCellHandedByReference'

	function noteHandedStorageType(storage ValueId, varType MaxonType)
		self.bodyState.handedCellTypes = withHandedCellType(self.bodyState.handedCellTypes, box: storage, varType: varType)
	end 'noteHandedStorageType'

	function handedStorageOf(storage PlaceStorage) returns ValueId throws MapError
		match storage 'storage'
			handed(box) then return box
			notHanded or
			unreachable then throw MapError.keyNotFound
		end 'storage'
	end 'handedStorageOf'

	function handedBrandOf(box ValueId) returns HandedBrand throws MapError
		match self.bodyState.handedBrands 'column'
			unwritten then throw MapError.keyNotFound
			entries(byBox) then return try byBox.get(box)
		end 'column'
	end 'handedBrandOf'

	function noteHandedBrand(box ValueId, key ByteArray, phrase String)
		self.bodyState.handedBrands = withHandedBrand(self.bodyState.handedBrands, box: box, handed: HandedBrand.create(key, phrase: phrase))
	end 'noteHandedBrand'

	function recordBrandHandOver(box ValueId, kind BrandRecordKind, opIndex ElementIndex, argIndex ParamCount, label ByteArray, range SourceRange)
		let handed = try self.handedBrandOf(box) otherwise return
		self.artifact.recordBrandRecord(PendingBrandRecord.create(handed.key, kind: kind, brand: EmptySourceText, opIndex: opIndex, argIndex: argIndex, label: label, phrase: freeze handed.phrase.toByteArray(), line: range.line, column: range.column, filePath: self.job.path))
	end 'recordBrandHandOver'

	function handedCellTypeOf(box ValueId) returns MaxonType throws MapError
		match self.bodyState.handedCellTypes 'column'
			unwritten then throw MapError.keyNotFound
			entries(byBox) then return try byBox.get(box)
		end 'column'
	end 'handedCellTypeOf'

	function recordBrandHandOvers(args ValueIdArray, kind BrandRecordKind, first ParamCount, argLabels NameRoster, opIndex ElementIndex, range SourceRange)
		for position in first upto args.count() 'eachArg'
			let argIndex = position as ParamCount
			let box = try args.get(position) otherwise panic("recordBrandHandOvers: args.get OOB at {position}")
			self.recordBrandHandOver(box, kind: kind, opIndex: opIndex, argIndex: argIndex, label: callArgumentLabel(argLabels, argIndex: argIndex), range: range)
		end 'eachArg'
	end 'recordBrandHandOvers'

	function recordBrandHandOversToFunctionValue(places PlaceArgumentArray, opIndex ElementIndex, range SourceRange)
		for place in places 'eachPlace'
			let box = try self.handedStorageOf(place.storage) otherwise continue
			self.recordBrandHandOver(box, kind: BrandRecordKind.handOverIndirect, opIndex: opIndex, argIndex: place.column, label: EmptySourceText, range: range)
		end 'eachPlace'
	end 'recordBrandHandOversToFunctionValue'

	function settleCellEpochAtMerge(edges ReachingMoveEdgeArray, position ElementIndex)
		let binding = try self.bodyState.ownedBindings.get(position) otherwise panic("settleCellEpochAtMerge: ownedBindings.get OOB at {position}")

		if edgesCarryOneValue(edges, position: position) 'oneEpoch'
			let first = try edges.get(0) otherwise panic("settleCellEpochAtMerge: a merge is settled only with a reaching edge")
			binding.cellEpoch = CellEpoch.current(first.mark.valueAt(position))
			binding.noteWritten(self.bodyState.moveLedger)
			return
		end 'oneEpoch'

		var joined = CellOccupantExclusivity.sole

		for edge in edges 'eachJoinedEdge'
			joined = joinedOccupantExclusivity(joined, b: self.cellEpochExclusivityOf(edge.mark.valueAt(position)))
		end 'eachJoinedEdge'

		let merged = self.mintCellEpoch(joined)
		binding.cellEpoch = CellEpoch.current(merged)
		binding.noteWritten(self.bodyState.moveLedger)

		for edge in edges 'eachEdge'
			self.noteDerivedCellEpoch(merged, from: edge.mark.valueAt(position))
		end 'eachEdge'
	end 'settleCellEpochAtMerge'

	function cellStoredBetweenMarks(before MoveMark, after MoveMark, index ElementIndex) returns bool
		if not (try self.bodyState.ownedBindings.get(index) otherwise panic("cellStoredBetweenMarks: ownedBindings.get OOB at {index}")).isCellBinding 'notACell'
			return false
		end 'notACell'

		return before.valueAt(index) != after.valueAt(index)
	end 'cellStoredBetweenMarks'

	function settleTheHeaderAsMoved(func IrFunction, scan LoopMoveScan, position ElementIndex, headerValue ValueId, anchor Token) returns ValueIdArray throws SourceParseError
		let dependents = self.headerDependents(func, scan: scan, headerValue: headerValue)

		match scan.firstReadAmong(dependents) 'read'
			none then break
			read(at) then throw at.movedInAnEarlierIteration()
		end 'read'

		self.withdrawDropsOf(func, scan: scan, dependents: dependents)
		self.dropOnLiveBackEdges(scan, position: position, dependents: dependents, anchor: anchor)
		self.dropFreshOperandsOfDependentPhis(func, scan: scan, position: position, dependents: dependents, anchor: anchor)
		self.releaseTheEntryValueBeforeTheLoop(scan, headerValue: headerValue, anchor: anchor)
		self.settleTheLoopForEnclosingLoops(scan, position: position)
		return dependents.values
	end 'settleTheHeaderAsMoved'

	function headerDependents(func IrFunction, scan LoopMoveScan, headerValue ValueId) returns HeaderDependents
		let index = self.loopEdgeIndexOf(func, scan: scan)
		let dependents = HeaderDependents.create(headerValue)
		var next = 0 as ElementIndex

		while next < dependents.values.count() 'untilClosed'
			let value = try dependents.values.get(next) otherwise panic("headerDependents: values.get OOB at {next} below its own count")
			next = next + 1

			let recorded = try index.usesByValue.get(value) otherwise continue

			for use in recorded.slotUses 'eachUse'
				let phi = (try self.loopBlockAt(func, id: use.block).blockArgs.get(use.slot) otherwise panic("headerDependents: block {use.block} holds fewer phis than the slot {use.slot} an edge into it carries")).valueId

				if not dependents.holds(phi) 'aNewDependent'
					dependents.addPhi(phi, block: use.block, slot: use.slot)
				end 'aNewDependent'
			end 'eachUse'
		end 'untilClosed'

		return dependents
	end 'headerDependents'

	function loopEdgeIndexOf(func IrFunction, scan LoopMoveScan) returns LoopEdgeIndex
		match scan.edgeIndex 'state'
			unbuilt then break
			built(index) then return index
		end 'state'

		let index = LoopEdgeIndex.create()

		for blockId in scan.blockFloor upto func.nextBlockId 'eachLoopBlock'
			let block = self.loopBlockAt(func, id: blockId)

			for edge in block.branchEdges 'eachEdge'
				if edge.targetBlockId >= scan.blockFloor 'staysInTheLoop'
					index.noteEdge(block, edge: edge)
				end 'staysInTheLoop'
			end 'eachEdge'
		end 'eachLoopBlock'

		let indexed = scan
		indexed.edgeIndex = LoopEdgeIndexState.built(index)
		return index
	end 'loopEdgeIndexOf'

	function loopBlockAt(func IrFunction, id BlockId) returns IrBlock
		let block = self.artifact.module.blockAtPosition(func, position: id)

		if block.id != id 'notInIdOrder'
			panic("loopBlockAt: the block at position {id} of '{String.from(func.name)}' carries id {block.id} — the parser registers every block of a function in id order")
		end 'notInIdOrder'

		return block
	end 'loopBlockAt'

	function withdrawDropsOf(func IrFunction, scan LoopMoveScan, dependents HeaderDependents)
		let results = ValueIdArray.create(0)

		for drop in scan.headerDrops 'eachDrop'
			if dependents.holds(drop.value) 'dropsADependent'
				results.append(drop.results)
			end 'dropsADependent'
		end 'eachDrop'

		if results.isEmpty() 'nothingDropped'
			return
		end 'nothingDropped'

		withdrawOpsDefining(self.artifact.module, func: func, fromBlock: scan.blockFloor, results: valueMarksOf(results))
	end 'withdrawDropsOf'

	function dropOnLiveBackEdges(scan LoopMoveScan, position ElementIndex, dependents HeaderDependents, anchor Token)
		for back in scan.backEdges 'eachBackEdge'
			let movedHere = back.mark.movedAt(position)

			if movedHere 'movedOnThisEdge'
				continue
			end 'movedOnThisEdge'

			let value = back.mark.valueAt(position)

			if dependents.holds(value) 'stillTheHeaderValue'
				continue
			end 'stillTheHeaderValue'

			self.dropAtTheEndOf(back.block, value: value, anchor: anchor)
		end 'eachBackEdge'
	end 'dropOnLiveBackEdges'

	function dropFreshOperandsOfDependentPhis(func IrFunction, scan LoopMoveScan, position ElementIndex, dependents HeaderDependents, anchor Token)
		if dependents.phis.isEmpty() 'onlyTheHeaderValue'
			return
		end 'onlyTheHeaderValue'

		let settled = self.settlementsAt(scan, position: position)

		for phi in dependents.phis 'eachDependentPhi'
			let incoming = try self.loopEdgeIndexOf(func, scan: scan).incomingByBlock.get(phi.block) otherwise continue

			if anIncomingEdgeIsSettled(incoming.edges, settled: settled) 'movedOnAnEdge'
				continue
			end 'movedOnAnEdge'

			self.dropFreshOperandsOf(func, phi: phi, incoming: incoming, dependents: dependents, anchor: anchor)
		end 'eachDependentPhi'
	end 'dropFreshOperandsOfDependentPhis'

	function dropFreshOperandsOf(func IrFunction, phi HeaderDependentPhi, incoming IncomingPhiEdges, dependents HeaderDependents, anchor Token)
		for k in 0 upto incoming.edges.count() 'eachIncomingEdge'
			let edge = try incoming.edges.get(k) otherwise panic("dropFreshOperandsOf: edges.get OOB at {k} below its own count")
			let operand = try edge.args.get(phi.slot) otherwise panic("dropFreshOperandsOf: an edge into block {phi.block} carries fewer values than the phi's slot {phi.slot}")

			if dependents.holds(operand) 'carriesTheHeaderValue'
				continue
			end 'carriesTheHeaderValue'

			let source = self.loopBlockAt(func, id: edge.source.id)
			let args = edge.args
			let dropSite = self.edgeSourceFor(func, from: source, to: phi.block)

			if dropSite.id != source.id 'theEdgeWasSplit'
				try incoming.edges.set(k, value: PhiEdge.create(dropSite, args: args)) otherwise panic("dropFreshOperandsOf: edges.set OOB at {k}")
			end 'theEdgeWasSplit'

			self.dropAtTheEndOf(dropSite, value: operand, anchor: anchor)
		end 'eachIncomingEdge'
	end 'dropFreshOperandsOf'

	function settlementsAt(scan LoopMoveScan, position ElementIndex) returns BlockIdSet
		let settled = BlockIdSet.create()

		if let settledHere = try scan.settledEdgesByPosition.get(position) 'settledInsideTheLoop'
			for edge in settledHere.edges 'eachSettledEdge'
				settled.insert(edge.block)
			end 'eachSettledEdge'
		end 'settledInsideTheLoop'

		settled.insert(scan.preheader.id)

		for back in scan.backEdges 'eachBackEdge'
			settled.insert(back.block.id)
		end 'eachBackEdge'

		return settled
	end 'settlementsAt'

	function settleTheLoopForEnclosingLoops(scan LoopMoveScan, position ElementIndex)
		for enclosing in self.bodyState.loopScans 'eachEnclosingLoop'
			if enclosing.settlesAtEntry(position) 'liveWhenTheEnclosingLoopWasEntered'
				enclosing.noteSettledEdge(scan.preheader.id, position: position)

				for back in scan.backEdges 'eachBackEdge'
					enclosing.noteSettledEdge(back.block.id, position: position)
				end 'eachBackEdge'
			end 'liveWhenTheEnclosingLoopWasEntered'
		end 'eachEnclosingLoop'
	end 'settleTheLoopForEnclosingLoops'

	function releaseTheEntryValueBeforeTheLoop(scan LoopMoveScan, headerValue ValueId, anchor Token)
		let entryValue = scan.entryValueOfPhi(headerValue)
		self.dropAtTheEndOf(scan.preheader, value: entryValue, anchor: anchor)
		scan.droppedBeforeTheLoop.push(entryValue)
	end 'releaseTheEntryValueBeforeTheLoop'

	function dropAtTheEndOf(block IrBlock, value ValueId, anchor Token)
		let saved = self.bodyState.currentBlock
		self.bodyState.currentBlock = block
		self.emitDecref(value, range: SourceRange.ofToken(anchor))
		self.bodyState.currentBlock = saved
	end 'dropAtTheEndOf'

	function edgeSourceFor(func IrFunction, from IrBlock, to BlockId) returns IrBlock
		match try self.artifact.module.ops.get(from.terminatorIndex()) otherwise panic("edgeSourceFor: ops.get OOB at the terminator of '{String.from(from.label)}'") 'terminator'
			branch then return from
			condBranch or
			switch then return self.splitEdge(func, from: from, to: to, label: b"loopedge")
			default panic("edgeSourceFor: block '{String.from(from.label)}' carries phi arguments to block {to} but ends in no branch")
		end 'terminator'
	end 'edgeSourceFor'

	function splitEdge(func IrFunction, from IrBlock, to BlockId, label ByteArray) returns IrBlock
		let edgeBlock = self.artifact.module.addBlock(func, label: label, heat: BlockHeat.normal)
		self.retargetBranch(from, from: to, to: edgeBlock.id)

		for position in 0 upto from.branchEdges.count() 'eachEdge'
			let edge = try from.branchEdges.get(position) otherwise panic("splitEdge: branchEdges.get OOB at {position} below its own count")

			if edge.targetBlockId == to 'theSplitEdge'
				let moved = try from.branchEdges.remove(position) otherwise panic("splitEdge: branchEdges.remove OOB at {position}")
				edgeBlock.branchEdges.push(moved)
				break
			end 'theSplitEdge'
		end 'eachEdge'

		self.emitBranch(edgeBlock, targetId: to)
		return edgeBlock
	end 'splitEdge'

	function retargetBranch(block IrBlock, from BlockId, to BlockId)
		let index = block.terminatorIndex()

		match try self.artifact.module.ops.get(index) otherwise panic("retargetBranch: ops.get OOB at {index}") 'terminator'
			condBranch(cond, thenBlockId, elseBlockId) then self.replaceTerminator(index, op: MaxonOp.condBranch(cond, thenBlockId: retargeted(thenBlockId, from: from, to: to), elseBlockId: retargeted(elseBlockId, from: from, to: to)))
			switch(scrutinee, denseTargetBlockIds, defaultBlockId) then self.replaceTerminator(index, op: MaxonOp.switch(scrutinee, denseTargetBlockIds: retargetedAll(denseTargetBlockIds, from: from, to: to), defaultBlockId: retargeted(defaultBlockId, from: from, to: to)))
			default panic("retargetBranch: block '{String.from(block.label)}' is split only where it ends in a conditional branch or a switch")
		end 'terminator'
	end 'retargetBranch'

	function replaceTerminator(index ElementIndex, op MaxonOp)
		try self.artifact.module.ops.set(index, value: op) otherwise panic("replaceTerminator: ops.set OOB at {index}")
	end 'replaceTerminator'

	function settleBackEdgeConsumes(scan LoopMoveScan) throws SourceParseError
		for back in scan.backEdges 'eachBackEdge'
			for record in back.mark.consumes.recordsBeyond(scan.entryMark.consumes) 'eachConsume'
				let read = try scan.headerReadOf(record.promise) otherwise continue

				if promiseConsumeMovedItToAnotherOwner(record.kind) 'givenAway'
					throw read.movedInAnEarlierIteration()
				end 'givenAway'
			end 'eachConsume'
		end 'eachBackEdge'
	end 'settleBackEdgeConsumes'

	function loopExitEdgeMark(mark MoveMark, scan LoopMoveScan, movedAtTheHeader ValueMarkSet, touched MoveSlotIndexColumn) returns MoveMark
		let positions = MoveSlotIndexColumn.create(0)
		var consumes = mark.consumes

		for back in scan.backEdges 'eachBackEdge'
			for record in back.mark.consumes.recordsBeyond(mark.consumes) 'eachBackEdgeConsume'
				if consumeReachesTheNextHeader(scan, back: back, promise: record.promise) 'carriedAround'
					consumes = consumes.recorded(record.promise, kind: record.kind)
				end 'carriedAround'
			end 'eachBackEdgeConsume'
		end 'eachBackEdge'

		// An untouched outer position keeps the edge's own slot: no back edge moved it or left it awaiting,
		// and under `OwnedBindingIndex`'s single-owner invariant no value moved at the header is its value.
		for position in touched 'eachTouchedBinding'
			if position < mark.height() 'withinTheMark'
				positions.push(position)
			end 'withinTheMark'
		end 'eachTouchedBinding'

		for position in scan.entryMark.height() upto mark.height() 'eachBindingOfTheLoop'
			positions.push(position)
		end 'eachBindingOfTheLoop'

		let moved = BoolArray.create(positions.count(), zeroed: false)
		let values = ValueIdArray.create(positions.count(), zeroed: false)

		for position in positions 'eachBinding'
			let value = mark.valueAt(position)
			values.push(value)
			moved.push(mark.movedAt(position) or movedAtTheHeader.contains(value))
		end 'eachBinding'

		return MoveMark.create(self.bodyState.moveLedger.overlay(mark.slots, height: mark.height(), positions: positions, moved: moved, values: values), consumes: consumes)
	end 'loopExitEdgeMark'

	function loopFalseEdgeBlock(func IrFunction, falseSource IrBlock, exit IrBlock, falseMark MoveMark, breaks ReachingMoveEdgeArray) returns IrBlock
		if not exitEdgesDisagree(falseMark, breaks: breaks) 'nothingToPlaceOnTheFalseEdge'
			return falseSource
		end 'nothingToPlaceOnTheFalseEdge'

		return self.splitEdge(func, from: falseSource, to: exit.id, label: b"loopexit")
	end 'loopFalseEdgeBlock'

	function markOfASkippedLoop(scan LoopMoveScan, height ElementIndex) returns MoveMark
		let prefix = moveMarkPrefix(scan.entryMark, height: height)
		let carried = MoveSlotIndexColumn.create(0)

		// Only a header phi's value differs from its entry value, and `droppedBeforeTheLoop` holds only phi
		// entry values, so every binding no phi carries keeps its entry slot (`OwnedBindingIndex`'s
		// single-owner invariant rules out a second binding on a carried value).
		for phiVar in scan.phiVars 'eachCarriedBinding'
			if phiVar.binding.isEnrolled and phiVar.binding.enrolledAt < height 'anOwnedBinding'
				carried.push(phiVar.binding.enrolledAt)
			end 'anOwnedBinding'
		end 'eachCarriedBinding'

		let positions = sortedUniquePositions(carried)
		let moved = BoolArray.create(positions.count(), zeroed: false)
		let values = ValueIdArray.create(positions.count(), zeroed: false)

		for position in positions 'eachBinding'
			let headerValue = prefix.valueAt(position)
			let value = self.entryValueOrItself(scan, headerValue: headerValue)
			values.push(value)
			moved.push(prefix.movedAt(position) or valueIdArrayContains(scan.droppedBeforeTheLoop, value: value))
		end 'eachBinding'

		return MoveMark.create(self.bodyState.moveLedger.overlay(prefix.slots, height: height, positions: positions, moved: moved, values: values), consumes: prefix.consumes)
	end 'markOfASkippedLoop'

	function entryValueOrItself(scan LoopMoveScan, headerValue ValueId) returns ValueId
		for phiVar in scan.phiVars 'eachPhi'
			if phiVar.phiId == headerValue 'aCarriedBinding'
				return phiVar.entryValue
			end 'aCarriedBinding'
		end 'eachPhi'

		return headerValue
	end 'entryValueOrItself'

	// Drop the owned bindings a `break`/`continue` skips past — everything declared since the TARGET's
	// body was entered (a `LoopContext.ownedFloor`, or a `MatchContext.ownedFloor`), in reverse order,
	// into `block` BEFORE the branch that terminates it. A `break`/`continue` leaves its block ALIVE (it
	// jumps forward/back rather than falling through the `end`), so `parseBlockBody`'s fall-through drop
	// and `dropArmScopedOwned`'s live-exit drop never run on this path — this is the only place that
	// iteration's, or that arm's, body-local Strings/structs are released. For a labelled control to an
	// OUTER target, `floor` is that outer target's, so it releases every binding down to it. The decrefs
	// land in `block` because `emitScopeDrops` emits into `currentBlock` and a `break`/`continue` moves
	// control nowhere until its branch, so `currentBlock` is `block`.
	//
	// It takes the FLOOR rather than a context, because the two context types record the same fact and a
	// second copy of these two lines is exactly how their drop rules would drift apart.
	function dropTargetBodyOwned(block IrBlock, floor ElementIndex, anchor Token)
		self.bodyState.currentBlock = block
		self.emitScopeDrops(block, floor: floor, anchor: anchor)
	end 'dropTargetBodyOwned'

	// Parse `break ['label']`: leave the innermost enclosing break TARGET — the match statement if
	// one is open, else the loop (`resolveControlTarget`). The two destinations are wired differently
	// enough to be their own functions: a loop's exit block exists and takes its phi args now, while a
	// match's merge does not exist yet.
	function parseBreakStatement(func IrFunction, block IrBlock) throws SourceParseError
		let breakTok = try self.consume(TokenKind.break)
		let target = try self.resolveControlTarget(breakTok)

		match target 'target'
			loopExit(ctx) then self.jumpToLoopBlock(block, ctx: ctx, targetId: ctx.exitId, anchor: breakTok)
			matchMerge(ctx) then self.breakToMatchMerge(func, block: block, ctx: ctx, breakTok: breakTok)
		end 'target'
	end 'parseBreakStatement'

	// Parse `continue ['label']`: branch to the target loop's CONTINUE TARGET, carrying the
	// current phi-let values so that block's phis see this path. For a `while` the target is the
	// header (the condition is re-evaluated on the back edge); for a `for` it is the STEP block, whose
	// increment must run before the header or the counter never advances — see `LoopContext`.
	function parseContinueStatement(block IrBlock) throws SourceParseError
		let continueTok = try self.consume(TokenKind.continue)
		let target = try self.resolveControlTarget(continueTok)

		match target 'target'
			loopExit(ctx) then self.jumpToLoopBlock(block, ctx: ctx, targetId: ctx.continueTargetId, anchor: continueTok)
			matchMerge then panic("parseContinueStatement: `continue` resolved to a match — only `break` searches the match stack, and `resolveControlTarget` keys that on the keyword's own token kind")
		end 'target'
	end 'parseContinueStatement'

	// Wire a `break`/`continue` that leaves a LOOP: release what the loop body declared, then branch,
	// carrying the loop's phi values so the destination's phis see this path. `targetId` is the ONLY
	// thing that differs between the two keywords here — the exit for a `break`, the continue target for
	// a `continue` — which is why they share this rather than each spelling the same three lines.
	function jumpToLoopBlock(block IrBlock, ctx LoopContext, targetId BlockId, anchor Token)
		self.emitWindowExitsInto(block, floor: ctx.windowFloor, anchor: anchor)
		self.noteDebugScopeExits(ctx.debugOpenFloor, leavingFrom: block)
		self.dropTargetBodyOwned(block, floor: ctx.ownedFloor, anchor: anchor)
		let mark = moveMarkPrefix(self.captureMoveMark(), height: ctx.ownedFloor)
		let scan = try self.bodyState.loopScans.get(ctx.scanIndex) otherwise panic("jumpToLoopBlock: loop scan {ctx.scanIndex} is not on the stack while its loop's body is parsed")

		if targetId == ctx.exitId 'aBreak'
			scan.breakEdges.push(ReachingMoveEdge.create(block, mark: mark))
		end 'aBreak' else 'aContinue'
			scan.backEdges.push(ReachingMoveEdge.create(block, mark: mark))
		end 'aContinue'

		self.recordBranchEdge(block, targetId: targetId, argIds: self.edgeArgsFor(ctx.phiVars, preLoop: false))
		self.emitBranch(block, targetId: targetId)
	end 'jumpToLoopBlock'

	// ⭐⭐ **A `break` THAT LEAVES A MATCH STATEMENT ENROLS ITS BLOCK AS A REACHING ARM EXIT.**
	//
	// There is nothing to branch to: `finalizeMatchMerge` mints the merge block LAST, deliberately, so it
	// lays out after every arm body. So instead of a branch this contributes the very record a
	// fall-through arm contributes — exit block, carried-var snapshot, no `gives` value, move state — and
	// the merge then emits the branch and the phi args through the ONE join every arm already uses. No
	// new block in the merge's path, no early block, and no existing match's layout moves.
	//
	// ⚠ Branches are by `BlockId`, so a branch to a merge block that does not exist yet has no name to
	// forward-reference. Creating the merge EAGERLY in `parseMatchCommon` instead would reorder every
	// existing match's blocks and move every `TargetIr` pin that renders one, for a program that has
	// no `break` in it at all.
	function breakToMatchMerge(func IrFunction, block IrBlock, ctx MatchContext, breakTok Token)
		// Release what the arm declared, exactly as a live arm exit's `dropArmScopedOwned` would — the
		// break skips the arm's end, so this is the only drop its payload/`let` bindings get.
		self.emitWindowExitsInto(block, floor: ctx.windowFloor, anchor: breakTok)
		self.dropTargetBodyOwned(block, floor: ctx.ownedFloor, anchor: breakTok)
		self.noteDebugScopeExits(ctx.debugOpenFloor, leavingFrom: block)

		// A local `var` alias, not `ctx.breakExits.push(…)`: the mutating-parameter analysis reads a write
		// through a parameter's FIELD as a write to the parameter itself, and a `match` arm's payload
		// binding is immutable, so `parseBreakStatement` could not then pass `ctx` at all (E3207). The
		// alias is the same array the live stack entry holds, so the push lands where it must.
		let breakExits = ctx.breakExits
		breakExits.push(MatchArmExit.create(block, exitVals: self.snapshotBindings(ctx.carried), give: MatchGiveValue.none, moveMark: moveMarkPrefix(self.captureMoveMark(), height: ctx.ownedFloor), blame: EmptySourceText))

		// ⭐ **CONTROL LEAVES, YET `block` MUST STAY UNTERMINATED** — terminating a reaching arm's exit is
		// `finalizeMatchMerge`'s job, and it has not run. So the statement continues in a fresh DEAD block,
		// the same shape `parseIfStatement` gives the continuation of a fully-terminated `if`. THAT is what
		// keeps every `isTerminated()` reader downstream right by construction rather than by a flag each
		// would have to remember to consult: `parseArmBody` must not enrol this arm a SECOND time,
		// `dropArmScopedOwned` must not re-drop what was just dropped, and `parseOtherwiseHandler`'s
		// caught-box drop must not double-free after an `otherwise break`.
		self.bodyState.currentBlock = self.newDeadBlock(func, label: b"afterbreak")
	end 'breakToMatchMerge'

	// ⭐⭐ **BREAK TARGETS ARE MATCHES ∪ LOOPS; CONTINUE TARGETS ARE LOOPS ONLY.**
	//
	// No label → the innermost break target (the match, if one is open; else the innermost loop). A label
	// → the enclosing match, else the enclosing loop, with that label. Naming the innermost target is
	// redundant (E2048): the innermost match, or the innermost loop when no match is open. A label matching no enclosing target,
	// or a keyword with no target at all, is E2047. Returns the live stack entry (a reference), so a
	// `break` reaches the same `LoopContext`/`MatchContext` the stack still holds.
	function resolveControlTarget(kwTok Token) returns ControlTarget throws SourceParseError
		// ⭐ **THE ONE BIT THE TWO KEYWORDS DIFFER BY.** `break` leaves an enclosing construct, and a match
		// statement is one; `continue` starts the next ITERATION, which only a loop has. All THREE places
		// they diverge read this — which stacks are searched, whether the innermost loop's label is
		// redundant, and the noun the E2047 texts use — so they cannot come to disagree.
		let isBreak = kwTok.kind == TokenKind.break
		let matchDepth = self.bodyState.matches.count() if isBreak else 0
		let loopDepth = self.bodyState.loops.count()

		if loopDepth == 0 and matchDepth == 0 'noTarget'
			throw SourceParseError.controlOutsideLoop(String.from(kwTok.value), targets: controlTargetNoun(isBreak), line: kwTok.line, column: kwTok.column)
		end 'noTarget'

		if not self.at(TokenKind.charLiteral) 'unlabelled'
			// ⚠ **THE MATCH WINS UNCONDITIONALLY, AND THAT IS CORRECT ONLY BECAUSE OF E2049.** "Innermost
			// break target" is what the rule says, and preferring the top of `matches` over the top of
			// `loops` computes it only because a match arm body may not OPEN a loop
			// (`parseArmBody` → `statementFormRole` → E2049) and a closure resets both stacks — so no
			// loop can ever be nested INSIDE an open match, and a match on the stack always IS the innermost
			// target. Both references depend on this and neither records it. A push-depth counter would
			// remove the dependency and was deliberately not built: it is speculative generality for a
			// nesting the language forbids. **If E2049 is ever relaxed, this preference must become an
			// interleaved depth comparison.**
			if matchDepth > 0 'innermostMatch'
				return ControlTarget.matchMerge(try self.bodyState.matches.get(matchDepth - 1) otherwise panic("resolveControlTarget: matches.get({matchDepth - 1}) failed after the count check"))
			end 'innermostMatch'

			return self.loopTargetAt(loopDepth - 1, isBreak: isBreak)
		end 'unlabelled'

		let labelTok = try self.consume(TokenKind.charLiteral)

		// Matches first, innermost out — a labelled break names its target directly. `break 'check'` inside
		// `match … 'check'` says exactly what the bare `break` says, so it is E2048.
		for i in 0 upto matchDepth 'matchSearch'
			let ctx = try self.bodyState.matches.get(matchDepth - 1 - i) otherwise panic("resolveControlTarget: matches.get OOB during the label search")

			if ctx.label.equals(labelTok.value) 'foundMatch'
				if i == 0 'ownMatch'
					throw SourceParseError.labelTargetsOwnMatch(String.from(kwTok.value), label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
				end 'ownMatch'

				return ControlTarget.matchMerge(ctx)
			end 'foundMatch'
		end 'matchSearch'

		for i in 0 upto loopDepth 'loopSearch'
			let ctx = try self.bodyState.loops.get(loopDepth - 1 - i) otherwise panic("resolveControlTarget: loops.get OOB during the label search")

			if ctx.label.equals(labelTok.value) 'foundLoop'
				// E2048 — the label says nothing the bare keyword would not. ⚠ The `matchDepth == 0` conjunct
				// is load-bearing and not a refinement: with a match open, a bare `break` targets the MATCH,
				// so naming the enclosing loop is the ONLY way to say "the loop" and is required rather than
				// redundant. For `continue` the conjunct is `0 == 0` by construction, so its rule is
				// unchanged — `specs/break.md:49` pins that text byte for byte.
				if i == 0 and matchDepth == 0 'ownLabel'
					throw SourceParseError.labelTargetsOwnLoop(String.from(kwTok.value), label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
				end 'ownLabel'

				return self.loopTargetAt(loopDepth - 1 - i, isBreak: isBreak)
			end 'foundLoop'
		end 'loopSearch'

		throw SourceParseError.unknownLoopLabel(String.from(kwTok.value), targets: controlTargetNoun(isBreak), label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
	end 'resolveControlTarget'

	// The `loopExit` target for the loop at `index`, flagging its exit as a `break` destination when the
	// keyword is one — the exit then merges the condition's false edge with each break's values, so
	// `wireLoopExit` gives it phis. The flag is written HERE, at the one place a loop becomes a target,
	// rather than by the caller: it must land on the live stack entry, and a caller that unpacked
	// `ControlTarget` could not write it — a `match` arm's payload binding is immutable.
	function loopTargetAt(index ElementIndex, isBreak bool) returns ControlTarget
		let ctx = try self.bodyState.loops.get(index) otherwise panic("loopTargetAt: loops.get({index}) OOB — the index was found by searching the live stack")

		if isBreak 'exitIsAMergePoint'
			ctx.hasBreak = true
		end 'exitIsAMergePoint'

		return ControlTarget.loopExit(ctx)
	end 'loopTargetAt'

	// The current SSA value of each binding in `bindings`, in the list's order — one of an
	// `if`'s three merge snapshots (entry / then-exit / else-exit), positional over the
	// statement's carried set (`assignedBindings`).
	function snapshotBindings(bindings VarInfoArray) returns ValueIdArray
		let vals = ValueIdArray.create(bindings.count(), zeroed: false)

		for binding in bindings 'each'
			vals.push(binding.boundValue)
		end 'each'

		return vals
	end 'snapshotBindings'

	// The mutable bindings an `if` statement's token extent ASSIGNS — its carried set, the
	// SUBSET of `mutableVars` a continuation phi can be minted for, returned in `mutableVars`
	// DECLARATION ORDER. That order is load-bearing: the phis a merge mints follow it (see
	// `mergeAtContinuation`). Token/assignment order would permute
	// two phis of one `if` and move codegen — the scale corpus's rotating write set proves it
	// (`w5 = …; w0 = …` assigns in the order 5, 0 but must merge in the order 0, 5).
	//
	// THE ONE INDEX OF WRITES (`writeSiteIndex`), shared by `if`, `match`, `while`, `for` and `try`. A
	// reassignment is the ONLY way a `var` already in scope changes value, and `buildWriteSiteIndex`
	// lists its spellings: `identifier =` (parseStatement's two-token lookahead), a deferred
	// `self.<field> =`, and a tuple assignment's bare targets. `==` is a single `equalsEquals` token,
	// so a comparison cannot be mistaken for one.
	//
	// It OVER-approximates, and every case where it does is harmless because a surplus carried
	// binding is harmless while a missing one is a miscompile:
	//   • `let r = …` / `var t = …` inside the extent match the shape too. Those names are not
	//     mutable bindings in scope at the construct, so they select nothing — unless an outer var
	//     of the same name is being SHADOWED, in which case the outer one is carried when it need
	//     not be. Costs one snapshot slot (an `if`: a == b, so no phi) or one coalesced copy (a
	//     loop); the alternative is tracking shadowing at token level, which is the block structure
	//     written down a THIRD time.
	//   • a name assigned only PAST the extent, when `blockStatementEndIndex` runs wide.
	// UNDER-approximating would drop a real phi — a silent miscompile — so the extent errs wide and
	// the drift guard (`assertScanAligned`) refuses a too-short one. A name in scope but NOT
	// mutable, or not bound at entry (a branch-local `var`), is in no `mutableVars` entry and is
	// correctly absent.
	//
	// ⚠ THIS SCAN IS EXHAUSTIVE ONLY BECAUSE PARAMETERS ARE IMMUTABLE. The index is built from
	// TOKENS, so it can only ever hold a write that IS tokens — `identifier =`. A `var` parameter is
	// written by `mutate(p)` at the call site, leaving no `=` in this loop at all: the index would
	// hold no write of `p`, a loop header would mint no phi, and `p` would reset to its entry value
	// every iteration. Silent, and invisible to the drift panic that guards this scan's OTHER
	// assumption (the construct's extent), because the extent would be right.
	//
	// The tripwire for it is in `bindParameters`, on the binding kind itself at the moment it is
	// passed — not here. This scan cannot enumerate parameters to check them, and a guard here
	// reading the `ParameterBindingKind` constant would be defeated by the very change it guards
	// against: a per-parameter feature stops reading that constant, and the guard goes quiet
	// exactly when it is needed.
	//
	// ⭐ **TWO ROUTES TO THE SAME ANSWER, AND THE CHEAPER ONE IS TAKEN.** With fewer writes in the
	// extent than mutable bindings in scope, the writes are enumerated and each name is chased to its
	// bindings (`collectCarriedPositions`); otherwise each binding's own writes are bisected against
	// the extent. So a construct costs min(writes in the extent, bindings × log writes). Either route
	// alone is quadratic in some program: probing every binding at every construct is Θ(bindings ×
	// constructs), and enumerating the extent at every construct re-reads the nested ones. A probe
	// allocates nothing, so the first never shows in the memory columns.
	//
	// With no mutable binding in scope the answer is empty at once, which is every top-level
	// initializer. Both routes return ascending position, which is the declaration order above: the
	// enumerating route sorts what it collected, and the probing route walks `mutableVars` in order.
	function assignedBindingsIn(startIndex ElementIndex, endIndex ElementIndex) returns VarInfoArray
		if endIndex < startIndex 'invertedExtent'
			panic("assignedBindingsIn: the extent ends at token {endIndex}, before it starts at token {startIndex}")
		end 'invertedExtent'

		let mutableCount = self.bodyState.mutableVars.count()

		if mutableCount == 0 'nothingToCarry'
			return VarInfoArray.create(0)
		end 'nothingToCarry'

		let index = self.writeSiteIndex()
		let firstSite = index.firstSiteAtOrAfter(startIndex)
		let pastSite = index.firstSiteAtOrAfter(endIndex)
		var positions = MoveSlotIndexColumn.create(0)

		if pastSite - firstSite <= mutableCount 'fewerWritesThanBindings'
			for site in firstSite upto pastSite 'eachWrite'
				self.collectCarriedPositions(positions, name: index.nameAt(site))
			end 'eachWrite'

			positions = sortedUniquePositions(positions)
		end 'fewerWritesThanBindings' else 'fewerBindingsThanWrites'
			for position in 0 upto mutableCount 'eachBinding'
				let binding = try self.bodyState.mutableVars.get(position) otherwise panic("assignedBindingsIn: mutableVars.get OOB at {position}")

				if index.writesNameWithin(binding.name, start: startIndex, endIndex: endIndex) 'writtenInTheExtent'
					positions.push(position)
				end 'writtenInTheExtent'
			end 'eachBinding'
		end 'fewerBindingsThanWrites'

		let bindings = VarInfoArray.create(positions.count(), zeroed: false)

		for k in 0 upto positions.count() 'each'
			let position = try positions.get(k) otherwise panic("assignedBindingsIn: positions.get OOB at {k}")
			bindings.push(try self.bodyState.mutableVars.get(position) otherwise panic("assignedBindingsIn: carried position {position} is off the end of a {self.bodyState.mutableVars.count()}-deep mutable-binding stack"))
		end 'each'

		return bindings
	end 'assignedBindingsIn'

	function writeSiteIndex() returns WriteSiteIndex
		match self.writeSites 'state'
			unbuilt then break
			built(index) then return index
		end 'state'

		let fresh = self.buildWriteSiteIndex()
		self.writeSites = WriteSites.built(fresh)
		return fresh
	end 'writeSiteIndex'

	// Every write in the file, one site per written name, tested independently at each token. Beside
	// `identifier =` there are two writes that spelling does not match: a deferred field's
	// `self.<name> =`, which reassigns the hidden slot `parseNascentSelfAssignment` holds the field
	// in, and the bare targets of a tuple assignment, `(a, b) = step(a)`, where no target is followed
	// by `=`. ⚠ Leaving either out drops a loop header phi or a merge phi without a diagnostic: the
	// loop resets the name to its entry value every trip, or the merge reads a value neither arm
	// defines.
	//
	// The tuple span comes from `tupleAssignEqualsIn` and its targets from `tupleAssignTargetIndices`,
	// the readers the parse itself uses, so a new target shape is taught to both at once. Only
	// rebinding targets are writes: a declaring target names a binding no construct can carry, and `_`
	// writes nothing. The `!= i` test keeps `tupleAssignTargetIndices`, which allocates, off every
	// token that opens no tuple assignment.
	function buildWriteSiteIndex() returns WriteSiteIndex
		let sites = TokenIndexArray.create(0)
		let names = NameRoster.create(0)
		let count = self.tokens.count()
		var i = 0 as ElementIndex

		while i < count 'scan'
			if self.assignsAt(i) 'assignment'
				sites.push(i)
				names.push(self.tokenAt(i).value)
			end 'assignment'

			if self.nascentSelfAssignmentAt(i) 'aDeferredFieldWrite'
				sites.push(i)
				names.push(nascentSelfSlotName(self.tokenAt(i + 2).value))
			end 'aDeferredFieldWrite'

			let equalsIndex = tupleAssignEqualsIn(self.tokens, open: i)

			if equalsIndex != i 'aTupleAssignmentOpensHere'
				for nameIndex in self.tupleAssignTargetIndices(i, equalsIndex: equalsIndex) 'eachTarget'
					if tupleAssignTargetRebinds(self.tupleAssignTargetAt(nameIndex)) 'rebindingTarget'
						sites.push(i)
						names.push(self.tokenAt(nameIndex).value)
					end 'rebindingTarget'
				end 'eachTarget'
			end 'aTupleAssignmentOpensHere'

			i = i + 1
		end 'scan'

		return WriteSiteIndex.build(sites, names: names)
	end 'buildWriteSiteIndex'

	function collectCarriedPositions(positions MoveSlotIndexColumn, name ByteArray)
		var link = self.innermostMutableVar(name)
		var walking = true

		while walking 'chain'
			match link 'which'
				none then walking = false
				at(position) then link = self.carryAndFollowShadow(positions, position: position)
			end 'which'
		end 'chain'
	end 'collectCarriedPositions'

	function carryAndFollowShadow(positions MoveSlotIndexColumn, position ElementIndex) returns InnermostMutableVar
		positions.push(position)

		return try self.bodyState.mutableVarShadowed.get(position) otherwise panic("collectCarriedPositions: position {position} is off the end of a {self.bodyState.mutableVarShadowed.count()}-deep shadow column")
	end 'carryAndFollowShadow'

	// One slot per carried binding, in phi order — the block-arg list of EVERY edge in a loop's phi
	// model. `preLoop` picks which value each slot carries, and that is the only thing the two kinds of
	// edge disagree about:
	//   • the PREHEADER edge (`preLoop: true`) carries the value captured OUTSIDE the loop, which
	//     `LoopPhiVar.entryValue` holds because installing the phi overwrote `boundValue`;
	//   • every edge from INSIDE (a back-edge, a `continue` to the step block, a `break` to the exit)
	//     carries the binding's value right now — read off the BINDING, so a `break` out of a block that
	//     SHADOWS a loop-carried `var` still carries the loop's own binding, not the shadow's value.
	//
	// ONE walk, because what must never drift is the POSITIONAL contract (in `phiVars` order, exactly one
	// entry per element, no filtering): a second copy that grew a filter would misalign one edge against
	// the header's block-args, which is a silent miscompile rather than a compile error.
	function edgeArgsFor(phiVars LoopPhiVarArray, preLoop bool) returns ValueIdArray
		let vals = ValueIdArray.create(0)

		for pv in phiVars 'each'
			let carried = pv.entryValue if preLoop else pv.binding.boundValue
			self.pushMergedEdgeValue(vals, binding: pv.binding, value: carried)

			// ⭐⭐ **A LOOP NAMES ITS PHI SEPARATELY FROM THE BINDING, WHICH IS WHY THE IMMUTABLE-GLOBAL-READ MARK IS CARRIED HERE
			// AS WELL.** On a BACK edge the binding's own value IS what is being pushed, so the carry
			// `pushMergedEdgeValue` makes is a self-carry and the HEADER phi — the value every later read of the
			// name sees — inherits nothing. `pv.phiId` is that phi, and it is the loop's own to name.
			//
			// ⛔ MEASURED without this line: `var b = ["q"]` + `for _ in 0 upto 2  b = expose()  end` +
			// `grow(b)` compiled and grew a `let`-declared global (exit 6), while the same rebind under an `if`
			// was already refused. The `if` half and this one are the same defect at two merge shapes.
			self.joinCapabilityInto(pv.phiId, incoming: carried)
		end 'each'

		return vals
	end 'edgeArgsFor'

	// ============================================================================================
	// `match` on SCALAR scrutinees (int/bool/float). No enums.
	//
	// A match lowers to a CHAIN of two-way `condBranch` test blocks and a block-arg join — the
	// exact primitives `if`/`else`/`while` already use. There is NO new IR op:
	//
	//   test0:  <pattern0 → bool cond0> ; condBranch(cond0, then: body0, else: test1)
	//   test1:  <pattern1 → bool cond1> ; condBranch(cond1, then: body1, else: test2)
	//   ...
	//   testN:  <the default body — the last real arm's `else` target>
	//   body0:  <arm 0's body> ; branch merge   (or → next body on `and fallthrough`)
	//   ...
	//   merge:  phi(s) ; <the result, for a `gives` match>
	//
	// A pattern is OR-folded into ONE boolean: a single value is `scrut == v`, a range `lo to hi` is
	// `(scrut >= lo) and (scrut <= hi)` (a bitwise `and` over the two `bool`s — eager, since a pattern
	// has no side effects), an `or` is a bitwise `or` of the alternatives, `upto` uses `<` for the
	// upper bound, and `min`/`max` drop the corresponding compare.
	//
	// ⭐ The `gives` result and every cross-arm `var` mutation join through BLOCK-ARGS, not a mutable
	// result SLOT — see MatchArmExit's header. There are no slots and no mem2reg, so the parser
	// threads each reaching arm's value to the merge as a block-arg, the same on-the-fly SSA
	// `if`/`while` use.
	// ============================================================================================

	// The STATEMENT form: `match <expr> 'l' <arms> end 'l'`. Returns the continuation control
	// resumes in — reachable when an arm falls through to it, `dead` when every arm terminates.
	function parseMatchStatement(func IrFunction, block IrBlock) returns IrBlock throws SourceParseError
		let outcome = try self.parseMatchCommon(func, block: block, isExpression: false, destination: ArmDestination.merged)
		return outcome.cont
	end 'parseMatchStatement'

	// The EXPRESSION form: `let r = match …`, `match … * 2`. Yields the merge's result phi and
	// leaves control in the merge, exactly as `emitShortCircuit` does — so the climber continues
	// from `currentBlock` after it.
	function parseMatchExpression(func IrFunction) returns ValueId throws SourceParseError
		let outcome = try self.parseMatchCommon(func, block: self.bodyState.currentBlock, isExpression: true, destination: ArmDestination.merged)

		match outcome.result 'r'
			value(id) then return id

			// ⚠ **THE GUARANTEE IS `finalizeMatchMerge`'s REFUSAL, NOT "every arm gives".** An arm may
			// diverge (`match-expr-arm-divergent`), so `reachingArms` can legitimately be short — and when it
			// is EMPTY, that routine throws E2015 rather than returning a valueless outcome, which is what
			// makes this arm unreachable. Any non-empty reaching set yields a result phi.
			none then panic("parseMatchExpression: an expression match produced no value — an empty reaching set is refused E2015 by `finalizeMatchMerge`, so a `none` here means a reaching arm carried no give")
		end 'r'
	end 'parseMatchExpression'

	// The shared core, driving both forms off `isExpression` (which decides `then` vs `gives` and
	// whether the merge carries a result phi). The single owner of the scrutinee, the block label,
	// the arm loop, exhaustiveness, and the merge join.
	function parseMatchCommon(func IrFunction, block IrBlock, isExpression bool, destination ArmDestination) returns MatchOutcome throws SourceParseError
		let matchIndex = self.pos
		let armTarget = self.pendingArrayLiteralTargetAt(matchIndex)
		let tupleArmTarget = self.pendingTupleLiteralTargetAt(matchIndex)
		let matchTok = try self.consume(TokenKind.match)

		// The carried-variable set — the mutable bindings the WHOLE match assigns, read off the
		// tokens before anything is emitted, exactly as `if`/`while` read theirs. `matchEnd` feeds
		// the drift guard below.
		let matchEnd = self.blockStatementEndIndex(matchIndex, continuesAtElse: false)
		let carried = self.assignedBindingsIn(matchIndex, endIndex: matchEnd)

		// The scrutinee. It may itself short-circuit and move `currentBlock`, so the first arm's
		// test goes into wherever the scrutinee left control — its exit block, not `block`.
		let scrutTempFloor = self.bodyState.pendingTempDrops.count()
		let scrutStart = self.pos

		// ⭐ **READ OFF THE TOKEN, BEFORE THE EXPRESSION IS PARSED AWAY.** A block-form `try`'s `(e)` binding
		// evaluates to the error block's flag phi — an integer indistinguishable from any other — so the two
		// questions its handler poses are asked of the NAME: has the handler discriminated at all (E3084), and
		// is this scrutinee the synthesized error union (in which case the whole dispatch below reads a fused
		// ordinal and a synthesized layout rather than the scrutinee's own type).
		if let scrutName = try self.matchScrutineeBareName(scrutStart) 'aBareScrutinee'
			self.noteTryBlockBindingMatched(scrutName)
		end 'aBareScrutinee'

		let errorUnion = self.errorUnionForScrutinee(scrutStart)
		let isErrorUnionMatch = errorUnionIsSynthesized(errorUnion)
		let parsedScrut = try self.parseExpression(func, block: block)

		// Inside an open boxed arm `e` names that arm's retagged box, while the dispatch and the match
		// obligation are keyed on the shared flag.
		let scrut = self.errorUnionFlagOf(parsedScrut) if isErrorUnionMatch else parsedScrut

		// Consumed before the arms and their entry move mark, so every arm's path carries the match.
		if isErrorUnionMatch 'consumesTheMatchObligation'
			try self.consumeErrorMatchObligation(scrut, matchTok: matchTok)
		end 'consumesTheMatchObligation'

		let scrutTag = self.tagOf(scrut)

		if not self.at(TokenKind.charLiteral) 'noLabel'
			let missing = self.current()
			throw SourceParseError.matchMissingBlockId(missing.line, column: missing.column)
		end 'noLabel'

		let labelTok = try self.consume(TokenKind.charLiteral)
		let matchLabel = labelTok.value
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		let entryVals = self.snapshotBindings(carried)

		// Arm-loop state. The first arm's test goes into the block the scrutinee left control in
		// (`self.bodyState.currentBlock`); `prevTestBlockId`/`prevExitBlock` are seeded with it too and read only
		// under the flag that makes them meaningful (`hasRealArm` / `prevFallthrough`) — a block has
		// no empty value, and a sentinel would be a lie a later read could believe.
		//
		// ⭐ `prevTestBlockId` is an ID, not a second NAME for `currentTestBlock`: the advance below is
		// `prevTestBlockId = currentTestBlock.id`, and copying the BINDING there would move the block out
		// of `currentTestBlock` (single ownership — E3102 on the next arm's read of it). The one reader
		// re-fetches by id, as any block read across block-minting calls must.
		var currentTestBlock = self.bodyState.currentBlock
		var prevTestBlockId = self.bodyState.currentBlock.id
		var hasRealArm = false
		var sawDefault = false
		var prevFallthrough = false
		var prevExitBlock = self.bodyState.currentBlock
		var prevExitVals = ValueIdArray.create(0)
		let seenValues = SeenPatternValues.create()
		let reachingArms = MatchArmExitArray.create(0)

		// ⭐ ENUM vs SCALAR is decided ONCE, from the scrutinee's type. A `named(X)` scrutinee whose
		// name is a declared enum/union takes the enum path — case-name patterns,
		// coverage over the case set; every other scrutinee is a scalar match. The two
		// share this whole dispatch engine (the `condBranch` chain, the arm bodies, the merge); only
		// the PATTERN emission, the `default` rule, and the exhaustiveness check branch on it.
		// ⭐ **A SYNTHESIZED ERROR UNION TAKES THE ENUM PATH WITH A LAYOUT THAT IS NOT THE SCRUTINEE'S
		// TYPE.** The value `e` holds is a bare flag; what an arm dispatches on is the `(member, case)`
		// pair the routed edges fused into one ordinal, and the layout below is the table over those
		// pairs. Everything after this point — coverage, the interval plan, the dispatch, the arm bodies,
		// the merge — is the ordinary enum machinery, which is why no second match engine is needed.
		var enumMatch = self.enumMatchFor(scrut)

		if isErrorUnionMatch 'synthesizedLayout'
			enumMatch = DeclaredEnum.declared(requireErrorUnionInfo(errorUnion).layout)
		end 'synthesizedLayout'

		let isEnumMatch = enumMatchIsDeclared(enumMatch)

		// A deferred scrutinee has no type to be exhaustive over: its case patterns bind deferred values
		// (`deferredCasePattern`), its miss is dead, and the E3004 at its call is the program's
		// diagnostic.
		let deferredScrutinee = self.valueIsDeferred(scrut)

		// One coverage bit per case, in declaration order — the enum twin of `seenValues`. Populated
		// only for an enum match; a bare case marks its bit, a range marks the slice it covers, and a
		// second mark on one bit is E2027. Its all-true state IS exhaustiveness.
		let enumCovered = BoolArray.create(0)

		if isEnumMatch 'initEnumCoverage'
			let layout = requireEnumLayout(enumMatch)

			for _ in 0 upto layout.caseCount() 'eachCase'
				enumCovered.push(false)
			end 'eachCase'
		end 'initEnumCoverage'

		// The DISPATCH SUBJECT — what each arm's tag compare reads — through `emitEnumDispatchKey`, the one
		// place that answers where an enum value's tag lives (`.ordinal` reads the same door through
		// `emitEnumTagOf`; see there for the wrong answer their separate copies of this decision produced).
		// For a boxed union that is a load emitted ONCE here, into the first test block, which dominates
		// every arm; for a word union it is the word key (`emitUnboxedWordKey`); for a scalar enum it is the
		// scrutinee itself and nothing is emitted. The scrutinee `scrut` stays the BOX (or word) either
		// way, which is what a payload binding reads its payload out of.
		//
		// The `isEnumMatch` guard stays HERE and is not the helper's: it is a question about the SCRUTINEE
		// (does this value belong to a declared enum at all?), where the helper's is about the LAYOUT. A
		// scalar match has no layout to ask.
		var dispatchSubject = scrut

		if isErrorUnionMatch 'fusedOrdinalIsTheSubject'
			// Already merged through the error block's last phi — every routed edge computed it where the
			// member was statically known, which is the only place a boxed member's tag COULD be read.
			dispatchSubject = requireErrorUnionInfo(errorUnion).fusedOrdinal
		end 'fusedOrdinalIsTheSubject' else if isEnumMatch 'enumDispatchSubject'
			dispatchSubject = try self.emitEnumDispatchKey(scrut, layout: requireEnumLayout(enumMatch), anchor: matchTok, range: SourceRange.ofToken(matchTok), reach: EnumTagReach.written)
		end 'enumDispatchSubject'

		// ⭐ **MATCH-CONSUME BOOKKEEPING.** A managed payload BINDING takes its field out of
		// the box, and the `ScrutineeStanding` decides HOW: an IMMUTABLE box this frame is the ONLY
		// owner of is MOVED out of; anything else — a `var` scrutinee, whose slot the arms may still write; a
		// BORROWED scrutinee (a param/receiver/field read, whose owner is the caller's local); and equally a
		// CO-OWNED one (a box this frame holds a SECOND reference to) — is RETAINED from instead
		// (`moveOutManagedPayload` vs `retainBorrowedPayload`, or a hold for a binding nothing can
		// write). If ANY arm MOVES a managed payload out, the whole scrutinee is consumed: its binding
		// is marked `partiallyMoved` — a re-read is E3102, but the box is still dropped, its cascade
		// null-guarding the moved slots. A match that retains or holds, or binds nothing managed,
		// BORROWS — the union survives.
		//
		// ⛔⛔ **TWO QUESTIONS, TWO PREDICATES, AND MERGING THEM IS A SEGFAULT.** `scrutOwned` below is
		// *"does this value owe a drop?"* and is what the temporary-scrutinee enrolment needs — a co-owned
		// temporary owes exactly the same drop a fresh box does. `standing.solelyOwned` is *"will anything else ever
		// read this box's slots?"* and is what the destructive move-out needs. One predicate serving both
		// faulted six programs; see `OwnedHeapExclusivity`.
		//
		// ⚠ **THE MARK IS PATH-SENSITIVE, AND IT LANDS AT THE ARM THAT MOVED — not after the loop.** The
		// scrutinee is dead for the REST OF THAT ARM the instant its payload leaves the box: the slot is
		// nulled, so a re-read inside the same arm (`text(s) gives grab(m)`, or a nested `match m`) hands
		// a null payload to whoever reads it next. Marked only after the loop, that read parsed against a
		// LIVE scrutinee and compiled to a SIGSEGV — measured both ways, and it covers any callee that binds the payload, not only a nested
		// match in the same arm.
		// A FRESH sibling arm rewinds it (`beginFreshArm` — the arms are
		// mutually exclusive, so an arm that did not run moved nothing), while an `and fallthrough`
		// successor INHERITS it, exactly as it inherits `movedFrom`.
		let scrutOwned = self.valueIsOwnedHeap(scrut)

		// Read BEFORE the temporary-scrutinee enrolment below, so it is asked of the author's own bindings.
		let standing = self.scrutineeStandingOf(scrut, scrutStart: scrutStart, isAParameter: valueIsAParameter(scrut, paramCount: func.paramCount))

		// "Some reaching path left the scrutinee consumed" — the merge-level union of the per-arm bit, which
		// is NOT the same as "some arm of THIS match moved a payload out": a nested `match m` in an arm body
		// consumes the same binding, and `beginFreshArm` carries that out of the arm it happened in.
		var scrutConsumed = false

		// ⭐ **A TEMPORARY OWNED SCRUTINEE IS ENROLLED AS A MATCH-SCOPED OWNED BINDING.** A
		// constructed union box used directly — `match U.case(x) …` — is an owned heap TEMPORARY: it sits
		// in the pending-drop list, which is drained per STATEMENT, so whichever arm parses first and
		// terminates (`return`/`break`/`continue`) would drain it into that arm's block ALONE, leaking it
		// on every other arm's runtime path (exit 101, arm-order-dependent). Enrolling it as an owned
		// binding at the enclosing scope BEFORE the arm loop makes it drop EXACTLY ONCE on all four exits —
		// a `return` arm and an implicit end through `emitFunctionExit`, a `break`/`continue` arm through the
		// loop-floor drop, a fall-through arm through the enclosing scope's own exit drop — the same
		// machinery a `let m = U.case(x)` scrutinee already rides. A managed box still drops through its
		// `__destruct_<U>` cascade, null-guarding any slot a binding arm moved out. An ALREADY-BOUND
		// scrutinee (`let m = …; match m`) is already in `ownedBindings` (never in the pending list), so it
		// is left alone — a second enrolment would double-drop the one box.
		// The `scrutOwned` half stays HERE rather than moving into the shared door: the pending list also
		// carries an `async` spawn's PROMISE (`emitAsyncCall` enrols one directly), which owns a green thread
		// rather than heap and must not be re-homed as an owned heap binding by a `match` on it.
		if scrutOwned 'enrollTempScrutinee'
			self.giveTemporaryScopeLifetime(scrut, name: ScrutineeSourceBindingName)
		end 'enrollTempScrutinee'

		// ⭐ **AND THE SCRUTINEE EXPRESSION'S OTHER TEMPORARIES DIE HERE, BEFORE THE FIRST CASE TEST.** The
		// enrolment above rescues the scrutinee VALUE when it is itself an owned box; it says nothing about
		// what the expression built on the way to producing it — `match [1,2,3].count()` yields a plain
		// integer and abandons an array. Left in the list, that array is released by whichever arm's body
		// drains first, on that arm's path alone (the same arm-order-dependent leak the enrolment comment
		// above describes, one level down). `currentBlock` is the scrutinee's exit block, which dominates
		// every arm test, every arm body and the merge — so one release here covers all of them.
		self.drainPendingTemps(scrutTempFloor, anchor: matchTok)

		// The move state entering the arms — captured after the temp-scrutinee enrolment so the scrutinee
		// binding is included. Each FRESH arm is parsed from it (`restoreMoveMark` at the arm-restore sites,
		// the twin of `restoreBindings`), and each reaching arm captures its own exit move state for the
		// merge reconciliation. A `and fallthrough` arm does NOT restore — it inherits the prior arm's
		// state, and the fallen-into arm's dispatch edge pays for it (`enterDispatchEdgeDrops`).
		let entryMoveMark = self.captureMoveMark()

		// ⭐ **THE MATCH BECOMES A `break` TARGET FOR ITS ARMS** (see `MatchContext`). A match STATEMENT
		// only: every arm of an EXPRESSION feeds the one result phi, and a `break` that skipped an arm would
		// leave that phi an operand short. Pushed AFTER the temporary-scrutinee enrolment so `ownedFloor`
		// sits ABOVE that box — the box outlives the match, and a break must not drop it.
		if not isExpression 'pushBreakTarget'
			self.bodyState.matches.push(MatchContext.create(matchLabel, carried: carried, ownedFloor: self.bodyState.ownedBindings.count(), debugOpenFloor: self.bodyState.debugOpenSlots.count(), windowFloor: self.openWindowCount()))
		end 'pushBreakTarget'

		// ⭐ **DISPATCH STRATEGY.** An integer-like scrutinee builds a normalized
		// interval PLAN and dispatches by a balanced binary search (or a chain when small); a `String`/
		// `float` scrutinee keeps the per-arm compare chain (`emitPatternCondition`). Under the plan the arm
		// loop emits NO test blocks or branches — it only collects `DispatchInterval`s and parses bodies —
		// and the whole dispatch is emitted after the loop, into `dispatchEntryId` (the block holding
		// `dispatchSubject`, which every compare then reads). `planMissBlockId`/`planMissArgs` name where
		// a value in no interval goes: the `default` body (set when the default arm is parsed) or a
		// `dead` block for an exhaustive enum (created after the loop). `planMissIsUnreachable` is set
		// for the dead block only, and the three travel to the dispatch as one `DispatchMiss`.
		let usePlan = self.matchUsesIntervalPlan(isEnumMatch, scrut: scrut)

		// ⭐ **THE ENTRY BLOCK IS HELD BY ITS `BlockId`, NOT AS A SECOND NAME FOR `currentTestBlock`** —
		// an IrBlock alias held across block-creating or block-mutating calls goes stale, and the arm loop
		// below is exactly such a span: it
		// mints a block per arm. Aliasing it here would also be a second mutable name for one owned value,
		// which single ownership refuses (E3102 on the next read of `currentTestBlock`) — the block is
		// re-fetched at the one place the dispatch is emitted.
		let dispatchEntryId = currentTestBlock.id
		let dispatchIntervals = DispatchIntervalArray.create(0)

		// The block a value in no interval branches to. Seeded to the entry only as a placeholder — it is
		// always overwritten before the dispatch is emitted (a `default` body, or an exhaustive enum's dead
		// block), and a scalar match with no default throws E2026 before then.
		var planMissBlockId = dispatchEntryId
		var planMissArgs = ValueIdArray.create(0)
		var planMissIsUnreachable = false

		// ⭐ **`--coverage`: THIS CONSTRUCT BECOMES THE BRANCH THE ARMS BELOW GROUP UNDER.** Entered after the
		// scrutinee so a `match` nested inside one groups its own arms; popped once the loop is done.
		self.enterMatch(matchTok)
		var armSharesItsLine = false

		while true 'arms'
			self.skipNewlines()

			// The closing `end` — unless the keyword is a NAME here (an `end then …` arm on an enum whose
			// case is spelled `end`, or a member read `Kw.end`). Asked of `closesBlockAt` rather than
			// spelled out, so this loop and the block-extent scans cannot drift on what an `end` is.
			let closes = self.closesBlockAt(self.pos)

			if armSharesItsLine 'afterAnArmOnItsLine'
				if not closes 'anArmSharesIt'
					try self.refuseStrayOtherwise()
					try self.refuseArmAfterDefault(sawDefault)
				end 'anArmSharesIt'

				throw lineSharedRefusal(LineEndingConstruct.matchArm, got: self.current())
			end 'afterAnArmOnItsLine'

			if closes 'endOfArms'
				break
			end 'endOfArms'

			// A second `default`, or any `default` that is not last, is E2029 — reported when a
			// pattern arm FOLLOWS a default; a default following a default is the same rule.
			try self.refuseArmAfterDefault(sawDefault)

			if self.at(TokenKind.default) 'defaultArm'
				let defTok = self.current()
				try self.consume(TokenKind.default)

				var defaultArrivedMoveMark = self.emptyMoveMark
				var defaultNeedsADispatchEdge = false

				if prevFallthrough 'defaultIsFtArrival'
					defaultArrivedMoveMark = self.captureMoveMark()
					defaultNeedsADispatchEdge = self.movesALiveBinding(entryMoveMark, after: defaultArrivedMoveMark)
				end 'defaultIsFtArrival'

				// `var` because `parseArmBody` mutates it, and seated from an ID because `currentTestBlock`
				// is carried by the arm loop: binding it to a second name here would move it out of the loop
				// (a bare-local read is a move), which is E2015. `.id` is a field read off a borrowed
				// receiver, and the block is re-fetched — the id-threading the arm loop uses for
				// `prevTestBlockId`.
				var defaultBodyId = currentTestBlock.id

				// In the linear chain the default's body is `currentTestBlock` itself. A dispatch-edge drop
				// needs a block only the fail edge reaches, so the body moves out to its own block and
				// `currentTestBlock` becomes that edge.
				if usePlan or defaultNeedsADispatchEdge 'planDefaultBlock'
					defaultBodyId = self.artifact.module.addBlock(func, label: b"matchdefault", heat: BlockHeat.normal).id
				end 'planDefaultBlock'

				var defaultBody = try self.blockById(func, id: defaultBodyId) otherwise panic("parseMatchCommon: the default body block {defaultBodyId} is not in its own function")

				if prevFallthrough 'defaultIsFtTarget'
					var matchEdgeArgs = self.setupFallthroughTargetPhis(defaultBody, carried: carried, entryVals: entryVals, prevExitBlock: prevExitBlock, prevExitVals: prevExitVals)

					if usePlan 'planDefaultArgs'
						// The default's match-edge phi args; the dispatch emits the edges that carry them
						// after the loop, not here.
						planMissArgs = matchEdgeArgs
					end 'planDefaultArgs' else if defaultNeedsADispatchEdge 'defaultFailEdgeDrops'
						self.reconcileMovesAtTwoEdgeMerge(currentTestBlock, markA: entryMoveMark, b: prevExitBlock, markB: defaultArrivedMoveMark, anchor: defTok)
						self.recordBranchEdge(currentTestBlock, targetId: defaultBody.id, argIds: matchEdgeArgs)
						self.emitBranch(currentTestBlock, targetId: defaultBody.id)
					end 'defaultFailEdgeDrops' else if hasRealArm 'defaultFailEdge'
						// The fail edge into the default body — the last real arm's `condBranch` else, already
						// emitted; only its phi args are recorded now.
						let prevTestBlock = try self.blockById(func, id: prevTestBlockId) otherwise panic("parseMatchCommon: the previous test block {prevTestBlockId} is not in its own function")
						self.recordBranchEdge(prevTestBlock, targetId: defaultBody.id, argIds: matchEdgeArgs)
					end 'defaultFailEdge'
				end 'defaultIsFtTarget' else 'defaultFresh'
					if self.beginFreshArm(carried, entryVals: entryVals, entryMoveMark: entryMoveMark, scrut: scrut) 'priorArmConsumed'
						scrutConsumed = true
					end 'priorArmConsumed'
				end 'defaultFresh'

				// ⭐ **A `default` ON AN ERROR UNION MAY BE HOLDING A BOX NOTHING ELSE WILL RELEASE.** Every
				// PATTERN arm releases the box of a member it names; a `default` names none, so it releases whichever
				// boxed member is in flight (`enterErrorUnionArm`), after the fallthrough phis, which belong to the
				// block the edges actually branch to.
				if isErrorUnionMatch 'errorUnionDefaultEntry'
					let info = requireErrorUnionInfo(errorUnion)
					let entry = self.enterErrorUnionArm(func, members: info.members, fused: info.fusedOrdinal, fallenInto: prevFallthrough, body: defaultBody, edgeArgs: planMissArgs, flag: scrut, anchor: defTok)
					planMissBlockId = entry.targetId
					planMissArgs = entry.args.clone()
					defaultBody = try self.blockById(func, id: entry.bodyId) otherwise panic("parseMatchCommon: the default body block {entry.bodyId} is not in its own function")
				end 'errorUnionDefaultEntry' else if usePlan 'planMissTarget'
					planMissBlockId = defaultBody.id
				end 'planMissTarget'

				if usePlan and defaultNeedsADispatchEdge 'defaultDropsOnTheDispatchEdge'
					planMissBlockId = self.enterDispatchEdgeDrops(func, entryMoveMark: entryMoveMark, arrived: defaultArrivedMoveMark, prevExit: prevExitBlock, targetId: planMissBlockId, edgeArgs: planMissArgs, anchor: defTok)
					planMissArgs = ValueIdArray.create(0)
				end 'defaultDropsOnTheDispatchEdge'

				// ⭐ **A `default` IS AN ARM THE USER WROTE**, including the `default throws` / `default panic`
				// spellings, and its count answers "was the default ever reached". Minted after the reseat above,
				// into the block the body is actually parsed into.
				self.mintMatchArmPoint(defaultBody, funcName: func.name, armLine: defTok.line, armCol: defTok.column)

				// ⛔⛔ **THE FLOORS ARE TAKEN ONCE, ABOVE THE FORK, BECAUSE BOTH DEFAULT SHAPES OWE THE SAME EXIT
				// — and the DIVERGING one did not pay it (measured: a compiler panic).** `default throws
				// E.p(Box.make().name)` takes a member borrow off a temporary, so `dispatchMethodOnBase` calls
				// `giveTemporaryScopeLifetime`, which moves the box from `pendingTempDrops` into
				// `ownedBindings`; `emitHandoffExit` leaves `ownedBindings` intact, so the record survives
				// the arm with nothing draining it. With no floor to drain to, the mark and the owned-binding
				// stack fell out of lockstep and `reconcileMovesAtMerge` panicked *"a reaching edge's mark
				// holds 0 entries but 1 owned bindings are in scope"*, on a legal program.
				//
				// ⚠ **THE FLOORS ARE TAKEN HERE, ABOVE THE DIVERGING BRANCH**, rather than a second pair being taken
				// inside the diverging branch: one arm, one exit
				// obligation, taken in one place. Of the three positions sharing `parseDivergingTerminalForm`,
				// the other two already bracketed it — a block-form `try`'s divergent `otherwise` through
				// `dropArmScopedOwned`, a diverging EXPRESSION arm through `finishArmExit` — so this is the
				// odd one out rather than a new rule.
				let defaultTempFloor = self.bodyState.pendingTempDrops.count()

				// ⚠ The catch-all arm needs an owned floor: without one, a scope-lifetime record it
				// enrolled — today a `giveTemporaryScopeLifetime` temporary, and a managed payload binding
				// the day a `default` can bind one — accumulates into the enclosing scope and is decref'd
				// in the continuation, on every OTHER arm's path too. It settles exactly as a pattern arm
				// does, through the one door.
				let defaultOwnedFloor = self.bodyState.ownedBindings.count()

				// ⭐ **`default throws E.case` / `default panic("…")`** — a DIVERGING catch-all that
				// covers every unmatched case (so the match is exhaustive). It is the ONLY legal enum
				// default; a scalar match may use it too. A PLAIN `default` (then/gives) stays E2046 on an
				// enum match (a catch-all would silently mask a case added later) and a real body on a
				// scalar match. A diverging default terminates its body and so reaches no merge.
				if divergentHandlerOpensAt(self.kindAt(self.pos)) 'divergingDefault'
					if isEnumMatch and not deferredScrutinee and self.valueIsLinear(scrut) 'aLinearScrutineeInTheDefault'
						self.bodyState.currentBlock = defaultBody
						try self.endLinearScrutineeInArm(scrut, anchor: defTok)
					end 'aLinearScrutineeInTheDefault'

					try self.parseDivergingTerminalForm(func, block: defaultBody)

					// The exit is `currentBlock`, not `defaultBody`: the diverging form's own expression may
					// have moved control (a `try` inside a thrown value's arguments), exactly as
					// `parseDivergentOtherwise` reads it. It carries no give — the discard says so, where a
					// `MatchGiveValue` variable would only be read back as the `none` it went in as.
					_ = try self.finishArmExit(MatchGiveValue.none, tempFloor: defaultTempFloor, ownedFloor: defaultOwnedFloor, exitBlock: self.bodyState.currentBlock, anchor: defTok)
				end 'divergingDefault' else 'plainDefault'
					if isErrorUnionMatch 'errorUnionPlainDefault'
						throw SourceParseError.errorUnionMatchDefaultMustThrow(defTok.line, column: defTok.column)
					end 'errorUnionPlainDefault'

					if isEnumMatch 'enumPlainDefault'
						let layout = requireEnumLayout(enumMatch)
						throw SourceParseError.matchDefaultEnumMustThrow(layout.kindWord(), typeName: String.from(layout.name), line: defTok.line, column: defTok.column)
					end 'enumPlainDefault'

					let defaultArmBody = try self.parseArmBody(func, bodyBlock: defaultBody, isExpression: isExpression, destination: destination, carried: carried, armTarget: armTarget, tupleArmTarget: tupleArmTarget)
					defaultArmBody.give = try self.finishArmExit(defaultArmBody.give, tempFloor: defaultTempFloor, ownedFloor: defaultOwnedFloor, exitBlock: defaultArmBody.exitBlock, anchor: matchTok)

					// `default` is the last arm, so a fall-through has no next arm to reach — it simply
					// continues to the merge. So the test is "did control leave?", not `reachesMerge`.
					if not defaultArmBody.exitBlock.isTerminated() 'defaultReaches'
						reachingArms.push(MatchArmExit.create(defaultArmBody.exitBlock, exitVals: defaultArmBody.exitVals, give: defaultArmBody.give, moveMark: self.captureMoveMark(), blame: defaultArmBody.blame))
					end 'defaultReaches'
				end 'plainDefault'

				sawDefault = true
				prevFallthrough = false
			end 'defaultArm' else 'patternArm'
				let patternTok = self.current()

				// `var` because the body block is forwarded to functions that fill it (payload phis, the arm
				// body) — a `let` cannot back a mutating parameter.
				var bodyBlock = self.artifact.module.addBlock(func, label: b"matcharm", heat: BlockHeat.normal)
				self.mintMatchArmPoint(bodyBlock, funcName: func.name, armLine: patternTok.line, armCol: patternTok.column)

				// The linear chain's next test block, held by ID rather than as a second NAME for
				// `bodyBlock` — one block, one owner, so aliasing it would poison `bodyBlock` for the
				// pattern collectors below (E3102). A planned match emits its dispatch after the loop and
				// mints its own test blocks there, so it creates none here (an unused block would be dead).
				var nextTestId = bodyBlock.id

				if not usePlan 'chainNextTest'
					nextTestId = self.artifact.module.addBlock(func, label: b"matchnext", heat: BlockHeat.normal).id
				end 'chainNextTest'

				// The pattern's facts: an interval PLAN (enum tags, or ordered-scalar values — collected, no
				// compare emitted) or an emitted per-arm CONDITION (a `String`/`float` chain). A pattern never
				// short-circuits, so `currentBlock` does not move; it matters only for the emitted-cond path.
				self.bodyState.currentBlock = currentTestBlock
				var cond = 0 as ValueId

				// ⭐ **WHOSE LAYOUT THIS ARM'S PAYLOAD PLAYS BY** is `arm.payloadEnum`. For an ordinary enum match it
				// is the scrutinee's own. For an ERROR UNION it is the arm's MEMBER: the synthesized table carries no
				// payload slots (it is a dispatch table — see `ErrorUnionInfo`), and a payload diagnostic must name
				// the enum the author actually wrote rather than `__ErrorUnion`. A scalar arm binds nothing.
				var arm = EnumPatternArm.bindingNothing()

				// Does this arm keep its ONE member's heap BOX for its length? `armMemberBoxType` is read only under
				// this flag. An arm naming SEVERAL members cannot keep a box — which member is in flight is known
				// only per dispatch edge — so it releases whichever boxed one is in flight as it is entered
				// (`enterErrorUnionArm`), as does an arm an `and fallthrough` reaches.
				var armOwnsMemberBox = false
				var armMemberBoxType = MaxonType.integer
				let intervalMark = dispatchIntervals.count()

				if isEnumMatch 'enumPattern'
					arm = try self.collectEnumPatternIntervals(self.enumArmTable(enumMatch, errorUnion: errorUnion), covered: enumCovered, bodyBlockId: bodyBlock.id, into: dispatchIntervals, intervalMark: intervalMark)

					// An `and fallthrough` edge reaches this arm's BODY from a different case, and this arm's
					// bindings sit at the head of that body — so they would destructure a case the value does
					// not hold. Checked here, where the pattern's bindings are first in hand and before any
					// phi or edge is wired for the fallthrough. Only an enum pattern produces bindings, so a
					// scalar match cannot reach it.
					if prevFallthrough 'ftTargetBinds'
						try self.rejectFallthroughIntoBindingArm(arm, patternTok: patternTok)
					end 'ftTargetBinds'

					if arm.members.count() == 1 and not prevFallthrough 'oneMemberDispatchedOnly'
						let member = try arm.members.get(0) otherwise panic("parseMatchCommon: an arm naming one member holds no member at index 0")
						armOwnsMemberBox = member.isBoxed
						armMemberBoxType = self.tryErrorEnumType(member.clause)
					end 'oneMemberDispatchedOnly'
				end 'enumPattern' else if usePlan 'scalarPlanPattern'
					try self.collectScalarPatternIntervals(scrut, seenValues: seenValues, bodyBlockId: bodyBlock.id, into: dispatchIntervals)
				end 'scalarPlanPattern' else 'scalarChainPattern'
					cond = try self.emitPatternCondition(scrut, scrutTag: scrutTag, seenValues: seenValues)
				end 'scalarChainPattern'

				var armArrivedMoveMark = self.emptyMoveMark
				var matchEdgeArgs = ValueIdArray.create(0)

				if prevFallthrough 'armIsFtTarget'
					armArrivedMoveMark = self.captureMoveMark()
					matchEdgeArgs = self.setupFallthroughTargetPhis(bodyBlock, carried: carried, entryVals: entryVals, prevExitBlock: prevExitBlock, prevExitVals: prevExitVals)
				end 'armIsFtTarget' else 'armFresh'
					if self.beginFreshArm(carried, entryVals: entryVals, entryMoveMark: entryMoveMark, scrut: scrut) 'priorArmConsumed'
						scrutConsumed = true
					end 'priorArmConsumed'
				end 'armFresh'

				// The short-circuit is load-bearing: a fresh arm leaves `armArrivedMoveMark` the shared
				// empty mark, which `movesALiveBinding` would index out of bounds against the entry mark.
				let armDropsOnItsDispatchEdge = prevFallthrough and self.movesALiveBinding(entryMoveMark, after: armArrivedMoveMark)

				if usePlan 'planEdgeArgs'
					// The dispatch records each test→arm edge from the stamped intervals. No `condBranch` here — the
					// dispatch emits all of them later.
					if isErrorUnionMatch and not armOwnsMemberBox 'errorUnionArmEntry'
						let entry = self.enterErrorUnionArm(func, members: arm.members, fused: requireErrorUnionInfo(errorUnion).fusedOrdinal, fallenInto: prevFallthrough, body: bodyBlock, edgeArgs: matchEdgeArgs, flag: scrut, anchor: patternTok)

						if armDropsOnItsDispatchEdge 'unionArmDropsOnItsDispatchEdge'
							let edgeId = self.enterDispatchEdgeDrops(func, entryMoveMark: entryMoveMark, arrived: armArrivedMoveMark, prevExit: prevExitBlock, targetId: entry.targetId, edgeArgs: entry.args, anchor: patternTok)
							retargetArmIntervals(dispatchIntervals, from: intervalMark, targetId: edgeId, args: ValueIdArray.create(0))
						end 'unionArmDropsOnItsDispatchEdge' else 'unionArmDispatchedDirectly'
							retargetArmIntervals(dispatchIntervals, from: intervalMark, targetId: entry.targetId, args: entry.args)
						end 'unionArmDispatchedDirectly'

						bodyBlock = try self.blockById(func, id: entry.bodyId) otherwise panic("parseMatchCommon: the arm body block {entry.bodyId} is not in its own function")
					end 'errorUnionArmEntry' else 'dispatchIntoBody'
						if armDropsOnItsDispatchEdge 'armDropsOnItsDispatchEdge'
							let edgeId = self.enterDispatchEdgeDrops(func, entryMoveMark: entryMoveMark, arrived: armArrivedMoveMark, prevExit: prevExitBlock, targetId: bodyBlock.id, edgeArgs: matchEdgeArgs, anchor: patternTok)
							retargetArmIntervals(dispatchIntervals, from: intervalMark, targetId: edgeId, args: ValueIdArray.create(0))
						end 'armDropsOnItsDispatchEdge' else 'armDispatchedDirectly'
							retargetArmIntervals(dispatchIntervals, from: intervalMark, targetId: bodyBlock.id, args: matchEdgeArgs)
						end 'armDispatchedDirectly'
					end 'dispatchIntoBody'
				end 'planEdgeArgs' else 'chainEdge'
					var armTargetId = bodyBlock.id

					if armDropsOnItsDispatchEdge 'chainArmDropsOnItsDispatchEdge'
						armTargetId = self.enterDispatchEdgeDrops(func, entryMoveMark: entryMoveMark, arrived: armArrivedMoveMark, prevExit: prevExitBlock, targetId: bodyBlock.id, edgeArgs: matchEdgeArgs, anchor: patternTok)
					end 'chainArmDropsOnItsDispatchEdge' else 'chainArmDispatchedDirectly'
						self.recordBranchEdge(currentTestBlock, targetId: bodyBlock.id, argIds: matchEdgeArgs)
					end 'chainArmDispatchedDirectly'

					self.emitCondBranch(currentTestBlock, cond: cond, thenId: armTargetId, elseId: nextTestId, ifTok: patternTok)
				end 'chainEdge'

				// A `walk(dir)` arm's payload bindings are declared at the HEAD of the arm body, in a
				// scope frame that closes at the arm's `end` so they cannot leak into the next arm. Each
				// reads a slot out of the scrutinee box (`payloadBox`), not the loaded tag `dispatchSubject`.
				// Only an enum pattern produces slot bindings, so `requireEnumLayout` is guarded.
				// The owned-binding height BEFORE the arm's payload bindings — an arm-local drop FLOOR, the
				// enum twin of `openBlock`'s `ownedCount`. A managed payload binding is enrolled in
				// `ownedBindings` above this floor, and must be dropped on the edge that leaves the arm (see
				// `dropArmScopedOwned`) rather than accumulating there to be decref'd in the continuation,
				// where a value defined in only one arm's block is garbage on every other arm's path.
				let armOwnedFloor = self.bodyState.ownedBindings.count()
				let deferredBindings = self.takeDeferredPatternBindings()
				let hasPayloadBindings = arm.bindings.count() > 0 or deferredBindings.count() > 0
				let opensArmScope = armOwnsMemberBox or hasPayloadBindings
				var payloadBox = scrut

				let armDebugFloor = self.bodyState.debugOpenSlots.count()

				if opensArmScope 'openArmScope'
					self.bodyState.currentBlock = bodyBlock
					self.bodyState.scope.pushScope()
				end 'openArmScope'

				// An error-union arm on a boxed member owns the box for the length of the arm. The `(e)`
				// binding owns nothing (see `declareErrorUnionBinding`): the flag is a pointer on some incoming
				// edges and an ordinal on others, so only an arm that names its member knows. The enrolment is
				// a single-type boxed catch's, binding `e` in the arm's own frame to the retagged box, which
				// `boxedMemberArms` maps back to the flag. Enrolled below the payload bindings, so the
				// reverse-order arm drop releases the payload's own reference first and the box last.
				if armOwnsMemberBox 'boxedMemberArm'
					payloadBox = try self.enrollCaughtBox(scrut, eType: armMemberBoxType, binder: CaughtErrorBinder.named(try self.matchScrutineeBareName(scrutStart) otherwise panic("parseMatch: an arm owning an error member's box belongs to an error-union match, and only a bare-name scrutinee is one"), anchor: patternTok))
					self.bodyState.boxedMemberArms.push(BoxedMemberArm.create(payloadBox, flag: scrut))
				end 'boxedMemberArm'

				if hasPayloadBindings 'openArmBindings'
					if deferredScrutinee 'deferredScrutineeBindings'
						try self.declareDeferredPatternBindings(deferredBindings)
					end 'deferredScrutineeBindings' else 'payloadSlotBindings'
						let armMovedManaged = try self.declarePayloadBindings(arm.bindings, scrutBox: payloadBox, standing: standing, layout: requireEnumLayout(arm.payloadEnum))

						if armMovedManaged 'consumed'
							// The scrutinee is dead for the rest of this arm from here: its slot is nulled, so the arm
							// body's own re-read must be E3102 rather than a null deref.
							//
							// The merge-level bit is read off the arm's exit state — by the next arm's
							// `beginFreshArm`, and for the last arm by the single read after the loop.
							self.consumeScrutinee(scrut)
						end 'consumed'
					end 'payloadSlotBindings'
				end 'openArmBindings'

				if isEnumMatch and not deferredScrutinee and not armOwnsMemberBox and self.valueIsLinear(scrut) 'aLinearScrutinee'
					self.bodyState.currentBlock = bodyBlock
					try self.endLinearScrutineeInArm(scrut, anchor: patternTok)
				end 'aLinearScrutinee'

				let armTempFloor = self.bodyState.pendingTempDrops.count()
				let armBody = try self.parseArmBody(func, bodyBlock: bodyBlock, isExpression: isExpression, destination: destination, carried: carried, armTarget: armTarget, tupleArmTarget: tupleArmTarget)

				if opensArmScope 'closeArmScope'
					self.bodyState.scope.popScope()
					self.closeDebugScopesAbove(armDebugFloor, endsIn: armBody.exitBlock)
				end 'closeArmScope'

				if armOwnsMemberBox 'closeBoxedMemberArm'
					_ = try self.bodyState.boxedMemberArms.pop() otherwise panic("parseMatchCommon: a boxed member arm closed with no open arm of its own on `boxedMemberArms`")
				end 'closeBoxedMemberArm'

				// An expression arm's OWNED give value escapes to the result phi, so move it out of its owner
				// BEFORE the arm's records are released — else a `text(s) gives s` arm would drop the payload
				// it is handing back (a use-after-free), and an owned-interpolation give would be double-freed
				// by the post-match drain. A BORROWED give out of one of those records is laundered instead,
				// and a give may therefore come back as a different SSA name — see `finishArmExit`, which is
				// the one door all three of an arm's exit obligations go through.
				armBody.give = try self.finishArmExit(armBody.give, tempFloor: armTempFloor, ownedFloor: armOwnedFloor, exitBlock: armBody.exitBlock, anchor: patternTok)

				if armBody.fellThrough 'fellThrough'
					prevFallthrough = true
					prevExitBlock = armBody.exitBlock

					// A copy: what the arm body hands back may lie within `entryMoveMark`, which every later arm reads.
					prevExitVals = armBody.exitVals.clone()
				end 'fellThrough' else 'notFallThrough'
					prevFallthrough = false

					if armBody.reachesMerge 'armReaches'
						reachingArms.push(MatchArmExit.create(armBody.exitBlock, exitVals: armBody.exitVals, give: armBody.give, moveMark: self.captureMoveMark(), blame: armBody.blame))
					end 'armReaches'
				end 'notFallThrough'

				prevTestBlockId = currentTestBlock.id
				hasRealArm = true

				if not usePlan 'chainAdvance'
					currentTestBlock = try self.blockById(func, id: nextTestId) otherwise panic("parseMatchCommon: the chain's next test block {nextTestId} is not in its own function")
				end 'chainAdvance'
			end 'patternArm'

			armSharesItsLine = not tokenKindEndsALine(self.kindAt(self.pos))
		end 'arms'

		self.leaveMatch()

		// ⚠ An exhaustive enum match's FINAL `else` target — the last arm's fail edge — is UNREACHABLE
		// (every value matches some arm), but the last arm's `condBranch` named it, so the CFG edge
		// exists and the block needs a terminator. `dead` marks it unreachable, the same terminator the
		// parser gives code after a fully-terminated `if`/`else`. A scalar match cannot reach here with
		// a dangling block: it is exhaustive only through a `default`, whose BODY consumes this block.
		// ⚠ Skipped when `sawDefault` (a `default throws`/`panic`): the final-else block IS that diverging
		// default's body, already given a real terminator above — overwriting it with `dead` would orphan
		// the throw/panic and silently drop it.
		if (isEnumMatch or deferredScrutinee) and not sawDefault 'enumFallOffUnreachable'
			// The dispatch's miss target. A planned match routes misses to a fresh `dead` block; the linear
			// chain's final `else` target IS that block (`currentTestBlock`). Either way the miss is
			// unreachable (every value matches some arm).
			if usePlan 'planDeadMiss'
				planMissBlockId = self.newDeadBlock(func, label: b"matchdead").id
				planMissIsUnreachable = true
			end 'planDeadMiss' else 'chainDeadMiss'
				currentTestBlock.terminator = Terminator.dead
			end 'chainDeadMiss'

			// A trailing `and fallthrough` on the LAST arm has no following arm or `default` to fall INTO (a
			// pattern arm cannot follow a default, and an enum match has no legal default), so
			// it falls OUT of the match to the continuation — exactly as an arm that reaches the merge does.
			// Without this the arm body is left unterminated and `assertAllBlocksTerminated` panics. It is a
			// no-op tail. Statement form only: `and fallthrough` after a `gives` arm is already rejected, so
			// the give is `none`. A SCALAR match cannot reach this with `prevFallthrough`: a trailing
			// fallthrough with no `default` is rejected by the `notExhaustive` throw below.
			if prevFallthrough 'trailingFallthrough'
				reachingArms.push(MatchArmExit.create(prevExitBlock, exitVals: prevExitVals, give: MatchGiveValue.none, moveMark: self.captureMoveMark(), blame: EmptySourceText))
			end 'trailingFallthrough'
		end 'enumFallOffUnreachable'

		// EXHAUSTIVENESS. An enum match must cover every case (E2026 listing the missing ones); a scalar
		// match is exhaustive only through a `default` (without one it would silently do nothing for an
		// unmatched value). Both are anchored at the closing `end`.
		if isEnumMatch and not sawDefault 'enumExhaustive'
			// A `default throws`/`panic` covers every unmatched case, so the case-set need not be complete.
			try self.checkEnumExhaustive(requireEnumLayout(enumMatch), covered: enumCovered, union: errorUnion)
		end 'enumExhaustive' else if isEnumMatch and sawDefault 'aDefaultCoversTheRest'
			try self.requireDefaultCoversNoLinearPayload(requireEnumLayout(enumMatch), covered: enumCovered, anchor: self.current())
		end 'aDefaultCoversTheRest' else if not isEnumMatch and not deferredScrutinee and not sawDefault 'notExhaustive'
			var subject = "match"

			if isExpression 'exprSubject'
				subject = "match expression"
			end 'exprSubject'

			let endMissing = self.current()
			throw SourceParseError.matchNotExhaustive(subject, line: endMissing.line, column: endMissing.column)
		end 'notExhaustive'

		// Drift guard, mirroring the `if`/`while` token-extent scans: the `end` the parser reached
		// must be the one `blockStatementEndIndex` predicted, or `opensBlockAt` misclassified a
		// construct nested in the arms and the carried set may be short.
		self.statement.lastBlockBodyEnd = self.pos
		try self.consumeBlockEnd(matchLabel, labelIsRequired: false, rule: EndLabelRule.matchArm)
		self.assertScanAligned("parseMatch", predictedEnd: matchEnd)

		// A binding-match that moved a managed payload out CONSUMES the scrutinee: mark its binding
		// `partiallyMoved` so a later read is E3102 (a re-match would deref a nulled slot). The box is
		// still dropped at scope exit — its cascade null-guards the moved slots. A TEMPORARY scrutinee's
		// SYNTHETIC binding (enrolled above) is marked too, which is harmless — it has no name to re-read,
		// and `partiallyMoved` skips no drop, so the box still drops through the cascade.
		//
		// ⚠ Re-asserted here rather than left to the in-arm mark, because the LAST arm parsed may have been
		// a fresh non-consuming one, which rewound it (`beginFreshArm`). The consuming arm's mark governs
		// its OWN body; this one governs the code after the whole match, where any arm may have run.
		//
		// ⭐ **THE LAST ARM'S OWN EXIT STATE IS READ HERE, and it is the same read every EARLIER arm gets
		// from the `beginFreshArm` that follows it.** No arm follows the last one, so without this line its
		// consume would be lost.
		scrutConsumed = scrutConsumed or self.bindingIsPartiallyMoved(scrut)

		if scrutConsumed 'consumeScrut'
			self.setBindingPartiallyMoved(scrut, value: true)
		end 'consumeScrut'

		// ⭐ **EMIT THE PLANNED DISPATCH** — after every arm body and the default/dead miss target are in
		// hand, and after exhaustiveness has run (so a non-exhaustive scalar match threw before this).
		// `planMissBlockId` is always set for a planned match by here: a `default` set it, an exhaustive
		// enum's dead block set it, and a scalar match with no default cannot reach here. The chain path
		// already wired its dispatch inline, so this runs only for a planned match.
		if usePlan 'emitPlan'
			let normalized = self.normalizeDispatchIntervals(dispatchIntervals)
			try self.emitMatchDispatch(func, entryId: dispatchEntryId, subject: dispatchSubject, intervals: normalized, miss: DispatchMiss.create(planMissBlockId, edgeArgs: planMissArgs, isUnreachable: planMissIsUnreachable), opTok: matchTok)
		end 'emitPlan'

		// ⭐⭐ **DRAIN THE BREAK EXITS INTO THE REACHING SET — BEFORE `finalizeMatchMerge` COUNTS IT.**
		// That ordering is what keeps an all-break match from sealing a dead merge: the merge is sealed
		// `dead` on `reachingArms.count() == 0`, and a match whose every arm breaks has an empty reaching
		// set until this line runs. Appended at the end rather than interleaved in arm order — the edges
		// are recorded on each arm's OWN block, so the merge's predecessor order is not a property of
		// this list, and `finalizeMatchMerge`'s only order-sensitive read is "arm 0 is the type
		// reference", which a statement match does not use.
		//
		// ⛔⛔ **PUSHED ONE AT A TIME, AND `append` WOULD BE A WRONG ANSWER.** `Array.append` DEEP-CLONES a
		// managed element in the compiler, deliberately and by its own runtime's design: The compiler is move-only, so
		// two arrays holding one element record would double-destroy it
		// (`ManagedMemoryRuntime.ManagedCloneManagedName` states the rule). A `MatchArmExit` cloned that
		// way carries a CLONE of its `exitBlock` — so `finalizeMatchMerge` terminated a copy and the
		// module's real block was left `Terminator.unset`. `push` co-owns the record, which is what this
		// drain needs.
		if not isExpression 'drainBreakExits'
			let matchCtx = try self.bodyState.matches.pop() otherwise panic("parseMatchCommon: the match stack is empty at the end of a statement match — one is pushed before the arm loop")

			for i in 0 upto matchCtx.breakExits.count() 'eachBreakExit'
				reachingArms.push(try matchCtx.breakExits.get(i) otherwise panic("parseMatchCommon: breakExits.get OOB at {i} inside its own count()"))
			end 'eachBreakExit'
		end 'drainBreakExits'

		let outcome = try self.finalizeMatchMerge(func, matchTok: matchTok, carried: carried, reachingArms: reachingArms, construct: mergeConstructOf(isExpression, destination: destination))
		self.bodyState.currentBlock = outcome.cont
		return outcome
	end 'parseMatchCommon'

	// ⭐ **DROP A MATCH ARM'S OWNED (managed) PAYLOAD BINDINGS**, the enum twin of `closeBlock` +
	// `parseBlockBody`'s fall-through drop. The arm's managed bindings own heap that must be released when
	// the arm exits, and the release is keyed on HOW it exits (the block rule, exactly):
	//   • a LIVE exit — a fall-through to the merge, or `and fallthrough` to the next arm — still owns the
	//     bindings here, so drop them into the exit block before it merges (a decref left for the
	//     continuation would run in a block where a one-arm value is garbage on every other arm's path — a
	//     use-after-free, exit 0xC0000005);
	//   • a TERMINATED exit — a `return`/`break`/`continue` — already dropped them down to its own floor
	//     (`emitFunctionExit`, `emitScopeDrops`), so drop nothing.
	// The tracking is drained to `floor` EITHER way, so the next arm starts clean and the function-end
	// drop never sees an arm binding. `patternTok` anchors the drop, as the arm's pattern is where a
	// reader looks for what became of its bindings.
	function dropArmScopedOwned(floor ElementIndex, exitBlock IrBlock, anchor Token)
		if not exitBlock.isTerminated() 'leavesAlive'
			// `emitScopeDrops` saves and restores `currentBlock` itself, so the arm does not.
			self.emitScopeDrops(exitBlock, floor: floor, anchor: anchor)
		end 'leavesAlive'

		self.truncateOwnedBindings(floor)
	end 'dropArmScopedOwned'

	// ⭐ **BEGIN A FRESH (non-fallthrough) MATCH ARM** — rewind every piece of per-path state the preceding
	// arm advanced, back to what the match was entered with. THE one door, so the "what does a fresh arm
	// inherit?" question is answered in a single place for the `default` arm and the pattern arm alike; a
	// fact rewound at one site and not the other is exactly the drift that leaks one arm's moves onto its
	// sibling. An `and fallthrough` target deliberately calls NONE of this — control really did arrive from
	// the previous arm, so it inherits that arm's bindings, its moves, and its consumed scrutinee.
	//
	// The scrutinee's `partiallyMoved` is rewound because the arms are MUTUALLY EXCLUSIVE: an arm that did
	// not run moved nothing out of the box, so a sibling arm reads a whole union. It cannot have been set
	// BEFORE the match — `match m` reads `m`, and `requireBindingLive` refuses a partially-moved read — so
	// `false` is the entry state rather than a captured one.
	//
	// ⚠ **RETURNS WHETHER THE PRECEDING PATH LEFT THE SCRUTINEE CONSUMED, and the caller MUST carry that to
	// the merge** — this rewind is per-PATH, but the code AFTER the match runs on every path, so a consume
	// on any one of them must survive. Returned rather than left to the caller's own bookkeeping because
	// the arm need not have consumed the scrutinee ITSELF: a NESTED `match m` inside the arm body sets the
	// same bit, and only the value read here can see it. (Without the carry, `text then match m …` followed
	// by a payload-free arm would leave `m` reading LIVE after the outer match, and a later bind would load
	// the nulled slot — the same SIGSEGV this rewind exists to close, one construct out.)
	function beginFreshArm(carried VarInfoArray, entryVals ValueIdArray, entryMoveMark MoveMark, scrut ValueId) returns bool
		let consumedOnThePrecedingPath = self.bindingIsPartiallyMoved(scrut)

		self.restoreBindings(carried, snapshot: entryVals)
		self.restoreMoveMark(entryMoveMark)
		self.setBindingPartiallyMoved(scrut, value: false)

		return consumedOnThePrecedingPath
	end 'beginFreshArm'

	// Set the `partiallyMoved` bit of the binding a match scrutinee denotes — `true` where a binding arm
	// moved a managed payload out (a re-read is then E3102, but the box is still dropped: see
	// `VarInfo.partiallyMoved`), `false` where a fresh sibling arm rewinds that.
	//
	// ⭐ **THE THREE QUESTIONS BELOW ARE ALL "WHAT DOES THE BINDING BEHIND THIS SCRUTINEE SAY?", AND THEY ALL
	// GO THROUGH `liveOwnerIndexOf`** — THE one owner scan (see its header). Walking `ownedBindings` at each
	// is three more spellings of a predicate whose whole point is being single-homed: a refinement of what
	// "the live owner" means, taught to the scan and not to a copy, leaves one of these answering about a
	// `movedFrom` ghost while the move machinery answers about the real owner — a disagreement invisible at
	// either site read alone. A temporary scrutinee is owned by no
	// binding, so all three are correctly inert on it: it has no name to re-read, write through or ask.

	// Set the `partiallyMoved` bit of the binding `owner` denotes — `true` where something moved a managed
	// payload OUT of a box this binding still owns (a re-read is then E3102, but the box is still dropped:
	// see `VarInfo.partiallyMoved`), `false` where a fresh sibling `match` arm rewinds that.
	//
	// ⭐⭐ **TWO PRODUCERS, ONE FACT — AND THE SECOND IS WHY THIS IS NO LONGER NAMED FOR SCRUTINEES.** A
	// binding-match nulls a union's payload slot; `__ManagedList.remove` nulls a NODE's `value@16` when it
	// hands the element to the caller (`ListRuntime.buildListUnlinkNode`). Both leave a binding owning a box
	// whose payload is gone, and both want the identical answer: refuse the re-read, keep the drop.
	//
	// ⚠ **IT IS INERT ON A VALUE NO BINDING OWNS**, which is exactly right for both: a temporary scrutinee
	// has no name to re-read, and so does `ml.remove(ml.insertLast(x))`.
	function setBindingPartiallyMoved(owner ValueId, value bool)
		let index = try self.liveOwnerIndexOf(owner) otherwise return

		// A `var` bound from `.get(index)`: the flag is written THROUGH the shared `VarInfo` reference (the
		// `Scope.setValue` idiom `poisonOwningBinding` uses), so every holder observes it.
		let owned = try self.bodyState.ownedBindings.get(index) otherwise panic("setBindingPartiallyMoved: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")

		if value 'movedOutHere'
			owned.markPartiallyMovedAt(self.lineJustRead())
			return
		end 'movedOutHere'

		owned.partiallyMoved = false
	end 'setBindingPartiallyMoved'

	// Has the binding `owner` denotes had a managed payload moved out of it on the path parsed so far? The
	// reader half of the pair above. Only the `match` machinery asks — `remove` sets and never re-reads.
	function bindingIsPartiallyMoved(owner ValueId) returns bool
		let index = try self.liveOwnerIndexOf(owner) otherwise return false

		let owned = try self.bodyState.ownedBindings.get(index) otherwise panic("bindingIsPartiallyMoved: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")
		return owned.partiallyMoved
	end 'bindingIsPartiallyMoved'

	// May a later read of this scrutinee find its slots again, so that no arm may empty one by a move-out?
	// A binding that OWNS the box decides it — `var b = Box.full(10)` yes, `let b` no — and where no binding
	// owns it, the two shapes below do.
	//
	// It asks ownership, not the tokens: probing for `identifier` + the match label before the scrutinee is
	// parsed would answer the same for a bare local only, and would need a second grammar for "what shapes
	// may appear before a match label".
	//
	// A union-typed parameter answers `true`, and it is the only shape that owns no binding and still does:
	// a parameter is a borrowed reference to the caller's union, so no arm may empty its slot.
	//
	// A temporary answers `false`, though its frame owns it: admitting one would move
	// `match <a constructed union>` off the destructive move-out and onto the retain, a refcount change on a
	// common path.
	//
	// ⚠ This is membership, and `ScrutineeStanding.solelyOwned` is provenance; they disagree on the loop-carried phi. A
	// `var` union matched inside the loop that reassigns it answers `true` here, so `declarePayloadBindings`
	// retains its payloads and the box keeps its own reference.
	function scrutineeBindingIsMutable(scrut ValueId, isAParameter bool) returns bool
		let index = try self.liveOwnerIndexOf(scrut) otherwise return isAParameter

		let owner = try self.bodyState.ownedBindings.get(index) otherwise panic("scrutineeBindingIsMutable: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")
		return owner.isMutable()
	end 'scrutineeBindingIsMutable'

	function matchScrutineeIsAMutableParameter(index ElementIndex) returns bool
		let name = try self.matchScrutineeBareName(index) otherwise return false

		if not self.bodyState.scope.contains(name) 'notInScope'
			return false
		end 'notInScope'

		let info = self.bodyState.scope.getInfo(name)
		return info.isParameter and info.cellCrossesByReference
	end 'matchScrutineeIsAMutableParameter'

	function scrutineeStandingOf(scrut ValueId, scrutStart ElementIndex, isAParameter bool) returns ScrutineeStanding
		let slotsMayBeReadAgain = self.scrutineeBindingIsMutable(scrut, isAParameter: isAParameter) or self.valueIsASlotRead(scrut) or self.matchScrutineeIsAMutableParameter(scrutStart)
		let unaliased = self.valueIsSolelyOwnedHere(scrut) or self.valueIsAnOwnedIsolatedLocal(scrut)

		return ScrutineeStanding.create(self.valueIsSoleHeapOwner(scrut), slotsMayBeReadAgain: slotsMayBeReadAgain, unaliased: unaliased)
	end 'scrutineeStandingOf'

	function consumeScrutinee(scrut ValueId)
		self.setBindingPartiallyMoved(scrut, value: true)

		if self.moveOfValueEscapesLoop(scrut) 'laterLapsReadIt'
			self.recordPromiseConsume(scrut, kind: PromiseConsume.consumedByMatch)
		end 'laterLapsReadIt'
	end 'consumeScrutinee'

	// Parse ONE arm's body, in one of THREE shapes. An EXPRESSION arm is either a `gives` — a single
	// expression, whose value feeds the merge phi — or a DIVERGING terminal form (`panic("…")` /
	// `throws E.case`), which yields no value and reaches no merge; which one is decided by
	// `divergentHandlerOpensAt`, the roster the whole file shares, at the `'divergingArm'` block below.
	// A `then` arm is a single statement, and `and fallthrough` may follow it. Reports E2049 for a
	// block-opening statement body, E2025 for `return … and fallthrough`, and E2001 for a stray
	// `and` after either shape of expression arm.
	function parseArmBody(func IrFunction, bodyBlock IrBlock, isExpression bool, destination ArmDestination, carried VarInfoArray, armTarget DeclaredArrayInstance, tupleArmTarget DeclaredTupleTarget) returns MatchArmBody throws SourceParseError
		self.bodyState.currentBlock = bodyBlock

		if isExpression 'givesArm'
			// ⭐⭐ **`<pattern> panic("…")` / `<pattern> throws E.case` — A DIVERGING ARM OF A MATCH EXPRESSION**
			// (`specs/match-expr-arm-divergent.md`), admitted through `divergentHandlerOpensAt` and read by
			// `parseDivergingTerminalForm`, exactly as the `default` arm one line of grammar away already is.
			// The keyword REPLACES `gives`: the arm yields no value, so it feeds no merge phi and the result
			// type is inferred from the `gives` arms alone. Its pattern still marks its coverage bit — that is
			// stamped by `collectEnumPatternIntervals` from the PATTERN, before this routine is entered — so a
			// diverging arm counts toward exhaustiveness just as the spec says, with nothing to add here.
			//
			// ⚠ **EXPRESSION FORM ONLY, WHICH IS THE SPEC'S OWN LINE.** A match STATEMENT arm already spells
			// both through its ordinary single-statement body (`red then panic("…")`, `red then throw E.case`),
			// so admitting the bare form there would be a second grammar for a thing the language already has.
			// A statement arm reaching a `panic` here therefore still gets `Expected 'then'`.
			if divergentHandlerOpensAt(self.kindAt(self.pos)) 'divergingArm'
				try self.parseDivergingTerminalForm(func, block: self.bodyState.currentBlock)
				let divergedBlock = self.bodyState.currentBlock
				try self.rejectStrayAndOnExpressionArm()

				// ⛔ **THE TERMINATOR IS CHECKED HERE, WHERE THE FAILURE CAN STILL BE NAMED.** Both routes
				// guarantee one — `parsePanicStatement` ends in `emitDeadReturn`, `emitThrowError` sets one —
				// and everything below depends on it: `reachesMerge` is stated `false` on the strength of it,
				// and `exitVals` is EMPTY because a block control never leaves has no values to carry out.
				// Left to be discovered downstream, a break here surfaces as `giveValueOf`'s generic "an
				// expression-match arm carries no `gives` value" twenty frames away, or as a short read inside
				// the merge's carried-var phi loop — neither of which names this arm or this form.
				if not divergedBlock.isTerminated() 'divergentArmLeftControlLive'
					panic("parseArmBody: a `panic`/`throws` arm of a match expression left its block UNTERMINATED — `parseDivergingTerminalForm` terminates on both of its routes, and the merge below relies on it: an arm that reached the result phi carrying no `gives` value would leave the phi an operand short")
				end 'divergentArmLeftControlLive'

				return MatchArmBody.create(false, reachesMerge: false, exitBlock: divergedBlock, exitVals: ValueIdArray.create(0), give: MatchGiveValue.none, blame: EmptySourceText)
			end 'divergingArm'

			try self.consume(TokenKind.gives)
			let valueTok = self.current()
			let valueStart = self.pos
			self.stateArrayLiteralTargetAt(armTarget, tokenIndex: valueStart)
			self.stateTupleLiteralTargetAt(tupleArmTarget, tokenIndex: valueStart)
			let value = try self.parseExpression(func, block: self.bodyState.currentBlock)

			match destination 'destination'
				returned(returnAnchor) then return try self.returnedArmBody(func, give: value, valueStart: valueStart, anchor: returnAnchor)
				merged then self.noteIsolatedPartOrigin(value, startIndex: valueStart, endIndex: self.pos)
			end 'destination'

			let exitBlock = self.bodyState.currentBlock
			try self.rejectStrayAndOnExpressionArm()
			return MatchArmBody.create(false, reachesMerge: not exitBlock.isTerminated(), exitBlock: exitBlock, exitVals: self.snapshotBindings(carried), give: MatchGiveValue.value(value), blame: self.expressionImmutableBlame(valueTok, valueStart: valueStart))
		end 'givesArm'

		try self.consume(TokenKind.then)

		// Each arm body is a single statement — a block-opening one (`if`/`while`/`for`/`match`)
		// has no place for its nested scope on a single-line arm.
		let head = try self.readStatementOpening(PrecedingTerminator.none, entersItsChain: true)
		let firstTok = head.opening

		if statementFormRole(head.form) == StatementRole.blockOpener 'blockOpener'
			throw SourceParseError.matchBlockStatement(firstTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
		end 'blockOpener'

		// Whether the body is a `return` is read BEFORE it is parsed — `and fallthrough` after a
		// `return` cannot combine (the `return` has already left the arm).
		let isReturn = head.form == StatementForm.ret

		// ⭐ A match arm body is a single statement, so a `try` used here may take only a single-statement
		// form — the block forms are E2049. `parseTry` reads this flag; saved/restored so a nested
		// construct unwinds it. On a throw the parse aborts, so restoring on the error path is moot.
		let savedInMatchArm = self.bodyState.inMatchArmBody
		self.bodyState.inMatchArmBody = true
		let exitBlock = try self.parseStatement(func, block: self.bodyState.currentBlock, head: head)
		self.bodyState.inMatchArmBody = savedInMatchArm

		var fellThrough = false

		if self.at(TokenKind.and) and self.peekKind() == TokenKind.fallthrough 'fallthroughSuffix'
			let andTok = self.current()

			if isReturn 'ftReturn'
				throw SourceParseError.matchFallthroughWithReturn(andTok.line, column: andTok.column)
			end 'ftReturn'

			try self.consume(TokenKind.and)
			try self.consume(TokenKind.fallthrough)
			fellThrough = true
		end 'fallthroughSuffix'

		let reachesMerge = not exitBlock.isTerminated() and not fellThrough
		return MatchArmBody.create(fellThrough, reachesMerge: reachesMerge, exitBlock: exitBlock, exitVals: self.snapshotBindings(carried), give: MatchGiveValue.none, blame: EmptySourceText)
	end 'parseArmBody'

	function returnedArmBody(func IrFunction, give ValueId, valueStart ElementIndex, anchor Token) returns MatchArmBody throws SourceParseError
		try self.returnCheckedValue(func, expression: give, retStart: valueStart, anchor: anchor)
		let returnedBlock = self.bodyState.currentBlock
		try self.rejectStrayAndOnExpressionArm()
		return MatchArmBody.create(false, reachesMerge: false, exitBlock: returnedBlock, exitVals: ValueIdArray.create(0), give: MatchGiveValue.none, blame: EmptySourceText)
	end 'returnedArmBody'

	// ⭐ **`and fallthrough` IS MEANINGLESS ON EITHER SHAPE OF MATCH-EXPRESSION ARM, so the refusal is one
	// thing.** A `gives` arm yields a value and a DIVERGING arm leaves the function; neither has a successor
	// to fall into, and an `and` after either is a leftover rather than an operator — the Pratt climber has
	// already stopped at it (see `parseBinary`), so it sits at the cursor and would otherwise be read by the
	// arm loop as the next arm's PATTERN, blaming a token two lines further on. Shared because the two arm
	// shapes are positioned to see the identical token and must not come to disagree about whether it is
	// legal: a shape without the refusal is exactly that drift.
	function rejectStrayAndOnExpressionArm() throws SourceParseError
		if not self.at(TokenKind.and) 'noStrayAnd'
			return
		end 'noStrayAnd'

		let andTok = self.current()
		throw SourceParseError.strayToken(tokenDisplayText(andTok), line: andTok.line, column: andTok.column)
	end 'rejectStrayAndOnExpressionArm'

	// Set up the phis of a FALLTHROUGH-TARGET body block — one reached both by its match edge(s)
	// (carrying the pre-match `entryVals`) and by the previous arm's fallthrough edge (carrying
	// that arm's exit values). A carried var gets a merge phi exactly where the two disagree; the
	// fallthrough edge is recorded and emitted here, and the differing `entryVals` are RETURNED for
	// the caller to record on the match edge (a regular arm's `condBranch` then-edge, or the
	// default's fail edge).
	function setupFallthroughTargetPhis(bodyBlock IrBlock, carried VarInfoArray, entryVals ValueIdArray, prevExitBlock IrBlock, prevExitVals ValueIdArray) returns ValueIdArray
		let matchEdgeArgs = ValueIdArray.create(0)
		let fallthroughEdgeArgs = ValueIdArray.create(0)

		for k in 0 upto carried.count() 'each'
			let binding = try carried.get(k) otherwise panic("setupFallthroughTargetPhis: carried.get OOB at {k}")
			let entryV = try entryVals.get(k) otherwise panic("setupFallthroughTargetPhis: entryVals.get OOB at {k}")
			let prevV = try prevExitVals.get(k) otherwise panic("setupFallthroughTargetPhis: prevExitVals.get OOB at {k}")

			if entryV == prevV 'same'
				self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: entryV, def: DebugVersionDef.merged)
				binding.setBoundValue(entryV, ledger: self.bodyState.moveLedger)
			end 'same' else 'differ'
				let phiId = self.mintPhiForBinding(bodyBlock, binding: binding)
				self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: phiId, def: DebugVersionDef.definedIn(bodyBlock.id))
				binding.setBoundValue(phiId, ledger: self.bodyState.moveLedger)
				self.pushMergedEdgeValue(matchEdgeArgs, binding: binding, value: entryV)
				self.pushMergedEdgeValue(fallthroughEdgeArgs, binding: binding, value: prevV)
			end 'differ'
		end 'each'

		self.recordBranchEdge(prevExitBlock, targetId: bodyBlock.id, argIds: fallthroughEdgeArgs)
		self.emitBranch(prevExitBlock, targetId: bodyBlock.id)
		return matchEdgeArgs
	end 'setupFallthroughTargetPhis'

	// The body of an arm a `and fallthrough` reaches is a two-edge join: the dispatch enters it in
	// the match's entry move state, the fallthrough edge in the state the prior arm left. A binding
	// the prior arm moved is still live on the dispatch edge, and only a static bit says otherwise —
	// so its scope drop is skipped and it leaks. Reconciled like any other two-edge merge, on a block
	// only the dispatch edge reaches: a drop at the body's head would free the fallthrough path's
	// value twice.
	function enterDispatchEdgeDrops(func IrFunction, entryMoveMark MoveMark, arrived MoveMark, prevExit IrBlock, targetId BlockId, edgeArgs ValueIdArray, anchor Token) returns BlockId
		let edge = self.artifact.module.addBlock(func, label: b"ftdispatch", heat: BlockHeat.normal)
		let edgeId = edge.id
		self.reconcileMovesAtTwoEdgeMerge(edge, markA: entryMoveMark, b: prevExit, markB: arrived, anchor: anchor)
		self.recordBranchEdge(edge, targetId: targetId, argIds: edgeArgs)
		self.emitBranch(edge, targetId: targetId)
		return edgeId
	end 'enterDispatchEdgeDrops'

	// Create the merge block LAST (so it lays out after every arm body) and join the reaching arms
	// into it. An empty set means every arm terminated — the merge is `dead`. Otherwise mint the
	// block-args in order — the result phi (expression form) first, then one phi per carried var
	// that differs across the reaching arms — and record each arm's edge in the SAME order.
	function finalizeMatchMerge(func IrFunction, matchTok Token, carried VarInfoArray, reachingArms MatchArmExitArray, construct MergeConstruct) returns MatchOutcome throws SourceParseError
		// Every value-producing construct (a match EXPRESSION and a ternary) runs the give-agreement,
		// promotion and ownership rules below; a match STATEMENT gives no value and skips them. So the one
		// value/statement bit is DERIVED from the construct rather than passed beside it — the two cannot
		// then disagree — and `construct` itself only ever matters where the DIAGNOSTIC NOUN differs (#80).
		let isExpression = construct != MergeConstruct.matchStatement

		let merge = self.artifact.module.addBlock(func, label: b"matchcont", heat: BlockHeat.normal)

		if reachingArms.count() == 0 'allTerminate'
			merge.terminator = Terminator.dead

			// ⛔⛔ **A MATCH EXPRESSION EVERY ARM OF WHICH DIVERGES — REFUSED E2015, AND WITHOUT THE REFUSAL IT IS A COMPILER
			// PANIC.** Two doors reach it: a `default panic(…)`/`default throws` as the only arm,
			// and every PATTERN arm diverging
			// (`match-expr-arm-divergent`). Nothing feeds the result phi, so there is no
			// value to hand the enclosing expression, and the compiler has no `never`-typed expression result to stand in
			// for one — `parseExpression` returns a `ValueId` the whole Pratt climber then reads and types.
			//
			// ⭐ **E2015 IS THE HONEST CODE, and the registry's own words are the test**: "the source uses a
			// language construct this compiler does not implement YET". That is exactly this. The refusal is
			// a BOUNDED GAP and not a language rule — the construct is well formed and only its continuation
			// is unreachable — which is why it is not `strayToken`/E2001 and not a semantic E3xxx, both of
			// which would file a pending feature as a permanent illegality (the mistake
			// `expectedDeclaration` and `selfOutsideInstanceMethod` each record having made in the other
			// direction). Pinned by `specs/match-expr-all-arms-diverge.md`, whose prose carries the
			// divergence so the case documents the gap rather than freezing it as intended behaviour.
			//
			// ⚠ **A TERNARY CANNOT REACH THIS**, so the message names the match form without asking `construct`
			// for a noun: `a if c else b` has two arms that are both EXPRESSIONS, and there is no divergent
			// spelling for either — every ternary arm produces a value or fails to parse.
			if isExpression 'exprNoValue'
				throw SourceParseError.unsupported("a match EXPRESSION whose every arm diverges — each arm ends in `panic(…)` or `throws`, so no arm reaches the merge and there is no value to give the binding or expression around it. Write it as a match STATEMENT (`then panic(…)` arms need no value), or give at least one arm a `gives`", line: matchTok.line, column: matchTok.column)
			end 'exprNoValue'

			return MatchOutcome.create(merge, result: MatchGiveValue.none)
		end 'allTerminate'

		// The count check above proves a first arm exists. The give-type questions below are asked
		// against the baseline instead — the first arm whose give is known — because a deferred give
		// agrees with anything and cannot type the phi; a ternary's diagnostic still names its arms by
		// position through `firstArm`.
		let firstArm = try reachingArms.get(0) otherwise panic("finalizeMatchMerge: reachingArms.get(0) failed after count check")
		let baselineIndex = self.baselineGiveIndex(reachingArms) if isExpression else 0

		// Cross-register-class arms are unified to float, not refused. Every arm's `gives` value feeds
		// one result phi and a value's register file (GP vs XMM) is fixed by its type at birth, so an
		// integer give and a float give would hand the phi values from two files, which the allocator
		// cannot color. The integer arms are promoted (`promoteToFloat`) in each arm's own exit block —
		// the branch to the merge is not emitted until below — so the conversion stays on the conditional
		// path. A deferred give is left as it is. A float arm meeting a non-numeric give
		// (bool/String/struct/union/type parameter) is a genuine mismatch, reported here before any phi
		// is built: `checkGiveTypes` below cannot be its backstop, because a `typeParameter` give agrees
		// with the float. The report names the float arm as the baseline for a match, and the first arm
		// for a ternary, which reads its arms by position.
		if isExpression 'unifyRegisterClass'
			if let floatIndex = try self.firstArmGiving(reachingArms, sought: SoughtGive.float) 'promoteIntegerArms'
				for i in 0 upto reachingArms.count() 'eachArm'
					let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
					let give = self.giveValueOf(arm.give)

					if not tagIsFloat(self.tagOf(give)) and not self.valueIsDeferred(give) 'notYetFloat'
						if not self.giveIsPromotableToFloat(give) 'nonNumericArm'
							let floatArm = try reachingArms.get(floatIndex) otherwise panic("finalizeMatchMerge: reachingArms.get({floatIndex}) — the scan above found a float arm there")
							throw self.valueMergeGiveMismatch(construct, reachingArms: reachingArms, firstArm: firstArm if construct == MergeConstruct.ternary else floatArm, gotArm: arm, matchTok: matchTok)
						end 'nonNumericArm'

						let saved = self.bodyState.currentBlock
						self.bodyState.currentBlock = arm.exitBlock
						let promoted = self.promoteToFloat(give, opTok: matchTok)
						self.bodyState.currentBlock = saved
						arm.give = MatchGiveValue.value(promoted)
					end 'notYetFloat'
				end 'eachArm'
			end 'promoteIntegerArms'
		end 'unifyRegisterClass'

		// Every reaching `gives` arm must yield the baseline arm's type: the result phi takes that type
		// (`mintPhi` below), and a value's type is fixed at birth, so an arm giving another type hands
		// the phi a value its type is a lie about. After the float unification a surviving mismatch is
		// same-register-class and takes one of two shapes, each a memory-safety defect:
		//   • a scalar-class disagreement — a `String` give and an `int` give — whose phi derefs the
		//     wrong-domain value as the baseline's type. Caught by `typesAgree`, the symmetric form of
		//     `checkDeclaredType`, and not a raw tag compare, so a ranged-int alias or `ExitCode` give
		//     and a plain `int` give stay valid: the numeric subtypes share a register file.
		//   • an aggregate-identity disagreement — two different structs/unions, or a boxed give and a
		//     scalar give (`match c { 0 gives Holder.holds(box); default gives 7 }`). `named` is
		//     overloaded (a boxed union value and a ranged-int alias both carry it), so `typesAgree`
		//     agrees there; `aggregatesConflict` compares the aggregate names, which are empty for every
		//     scalar, String and ranged-int alias.
		// A deferred give agrees with anything and is skipped. Read off the scalar tag/name columns, so a
		// scalar match allocates nothing, and placed before `resolveGivesOwnership` so an ill-typed match
		// is refused before any phi is built.
		var joinedAlias = ArmAliasJoin.create(EmptySourceText)

		if isExpression 'checkGiveTypes'
			let baselineArm = try reachingArms.get(baselineIndex) otherwise panic("finalizeMatchMerge: reachingArms.get({baselineIndex}) — `baselineGiveIndex` answers an index below the count")
			let firstGive = self.giveValueOf(baselineArm.give)
			let firstTag = self.tagOf(firstGive)
			let firstNameId = self.valueNameId(firstGive)
			let firstAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: firstTag, nameId: firstNameId, readerFilePath: self.job.path)

			for i in 0 upto reachingArms.count() 'scanGiveType'
				let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				let giveVal = self.giveValueOf(arm.give)

				if i == baselineIndex or self.valueIsDeferred(giveVal) 'theBaselineOrADeferredGive'
					continue
				end 'theBaselineOrADeferredGive'

				let giveTag = self.tagOf(giveVal)
				let giveNameId = self.valueNameId(giveVal)
				let giveAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: giveTag, nameId: giveNameId, readerFilePath: self.job.path)

				let classDisagrees = not typesAgree(giveTag, right: firstTag)
				let nameDisagrees = self.signatures.aggregatesConflict(firstAggregate, expectedTag: firstTag, expectedNameId: firstNameId, expectedBrand: self.brandOf(firstGive), got: giveAggregate, gotTag: giveTag, gotNameId: giveNameId, gotBrand: self.brandOf(giveVal), readerFilePath: self.job.path)

				if classDisagrees 'giveClassMismatch'
					throw self.valueMergeGiveMismatch(construct, reachingArms: reachingArms, firstArm: baselineArm, gotArm: arm, matchTok: matchTok)
				end 'giveClassMismatch'

				if nameDisagrees 'giveNameMismatch'
					joinedAlias = self.armAliasJoin(joinedAlias, baseline: firstAggregate, give: giveAggregate)

					if joinedAlias.alias.isEmpty() 'noCommonAncestor'
						throw self.valueMergeGiveMismatch(construct, reachingArms: reachingArms, firstArm: baselineArm, gotArm: arm, matchTok: matchTok)
					end 'noCommonAncestor'
				end 'giveNameMismatch'
			end 'scanGiveType'
		end 'checkGiveTypes'

		// Function-value arms must agree in signature, recorded here and checked whole-program. With no
		// deferred give, `checkGiveTypes` proves every arm shares the first arm's class, so if the first
		// give is a `function` every arm is — but a `function` tag carries no arity or parameter types,
		// so `unary if c else binary` would silently adopt the first arm's signature for the phi, and a
		// call through it would read a garbage second argument. The signatures cannot be compared here: a
		// forward-referenced or cross-file arm's parameter types are in no registry the parser has
		// (`project.funcSignatures` is not assembled until merge). So the arms' governing names, the
		// anchor and the noun are recorded and drained in `checkValueMergeSignatures`, before
		// `resolveTypes` erases the alias names the diagnostic prints. A merge with a deferred give
		// records nothing: its signature is unknown, and E3004 at its call explains the program.
		if isExpression and not self.anArmGives(reachingArms, sought: SoughtGive.deferred) 'recordFnMergeCheck'
			if self.tagOf(self.giveValueOf(firstArm.give)) == ValueTypeTag.function 'firstArmIsFunction'
				let armNames = NameRoster.create(reachingArms.count(), zeroed: false)

				for i in 0 upto reachingArms.count() 'collectArmNames'
					let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
					armNames.push(self.internedName(self.functionValueGoverningId(self.giveValueOf(arm.give))))
				end 'collectArmNames'

				self.artifact.pendingFnMergeChecks.push(PendingFnMergeCheck.create(armNames, line: matchTok.line, column: matchTok.column, filePath: self.job.path, isTernary: construct == MergeConstruct.ternary))
			end 'firstArmIsFunction'
		end 'recordFnMergeCheck'

		// Owned-give ownership transfer. If any reaching arm gives an OWNED value the result phi takes
		// over ownership (`resultOwned` → the phi is marked owned below): each arm's give value has
		// already left its own owner (`transferGiveToPhi` in the arm loop), so neither
		// `dropArmScopedOwned` nor the post-match statement drain frees it, and a borrowed give (a String
		// literal) is promoted to an owned copy so the phi is uniformly owned and its consumer drops it
		// unconditionally. When no arm gives an owned value the phi stays borrowed. `finalGives` carries
		// each reaching arm's post-promotion give value (empty for a statement match), used below for the
		// phi and the edges.
		let finalGives = ValueIdArray.create(0)
		let resultOwned = try self.resolveGivesOwnership(reachingArms, isExpression: isExpression, matchTok: matchTok, finalGives: finalGives)

		// ⭐ **CONDITIONAL MOVE RECONCILED across the reaching arms** — an owned binding moved in one arm and
		// left live in another is dropped on the live arms' exit blocks (all reaching arms are unterminated)
		// and marked uniformly moved past the merge. Emitted BEFORE the branches so the decref lands in the
		// arm's own body. A returning/breaking arm contributed no reaching entry, so it is not reconciled —
		// it dropped its own live values on the way out.
		let moveEdges = ReachingMoveEdgeArray.create(reachingArms.count(), zeroed: false)

		for i in 0 upto reachingArms.count() 'collectMoveEdges'
			let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			moveEdges.push(ReachingMoveEdge.create(arm.exitBlock, mark: arm.moveMark))
		end 'collectMoveEdges'

		self.reconcileMovesAtMerge(moveEdges, anchor: matchTok)

		// Every reaching arm branches to the merge (its exit block is, by definition, unterminated).
		for i in 0 upto reachingArms.count() 'branchToMerge'
			let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			self.emitBranch(arm.exitBlock, targetId: merge.id)
		end 'branchToMerge'

		// A carried var needs a merge phi iff its value is not identical across every reaching arm.
		let differs = BoolArray.create(carried.count(), zeroed: false)

		for k in 0 upto carried.count() 'eachVar'
			let v0 = try firstArm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
			var anyDiff = false

			for i in 1 upto reachingArms.count() 'eachArm'
				let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				let vi = try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")

				if vi != v0 'diff'
					anyDiff = true
				end 'diff'
			end 'eachArm'

			differs.push(anyDiff)
		end 'eachVar'

		// Mint the merge block-args. The result phi (if any) leads, so it is block-arg 0 and every
		// edge lists its `gives` value first.
		var result = MatchGiveValue.none

		if isExpression 'resultPhi'
			let firstGive = try finalGives.get(baselineIndex) otherwise panic("finalizeMatchMerge: finalGives.get({baselineIndex}) — resolveGivesOwnership fills one per reaching arm")
			let giveType = self.typeOf(firstGive) if joinedAlias.alias.isEmpty() else MaxonType.named(self.artifact.typeNames.intern(joinedAlias.alias))
			try self.refuseExistentialValueMerge(maxonTypeTag(giveType), what: "the value a `match` expression / ternary gives", tok: matchTok)

			let phiId = self.mintPhi(merge, tag: maxonTypeTag(giveType), nameId: typeNameIdOf(giveType))
			self.wearAliasOf(phiId, source: firstGive)

			// The merge wears the FIRST arm's brand, which every other arm was checked against; a merge of
			// unbranded arms wears none and fits any brand.
			self.brandValue(phiId, brand: self.brandOf(firstGive) if joinedAlias.alias.isEmpty() else EmptySourceText)
			self.carryMergeOrigin(phiId, arms: finalGives, anchor: matchTok)

			for give in finalGives 'eachGive'
				try self.requireNoUniqueAlias(give, action: "give", anchor: matchTok)
			end 'eachGive'

			try self.joinMergeCapability(phiId, arms: finalGives, func: func, anchor: matchTok)

			// The phi owns the transferred give value (see the ownership-transfer block above), so it is an
			// owned temp: `parseBinding`/the statement drain drops it once.
			//
			// ⚠ **"THE NEW SOLE OWNER" IS WHAT THIS COMMENT USED TO SAY, AND IT IS TRUE OF THE DROP AND FALSE OF
			// THE ALLOCATION.** The phi is the only thing that will DROP the value, which is what the transfer
			// block establishes; whether anything ELSE still owns the allocation is a question about the ARMS —
			// `promoteBorrowedGive` promotes a borrowed give by `__mm_incref`, so `pick if c else h.ty` reaches
			// here holding a box the struct field also holds. So the claim is asked of the edges
			// (`mergedHeapExclusivity`), which is also the direction `joinMergeCapability` takes.
			if resultOwned 'ownedResultPhi'
				self.enrolOwnedPhi(phiId, edges: finalGives)
			end 'ownedResultPhi'

			self.markPhiImmortalIfEveryEdgeIs(phiId, edges: finalGives)

			// ⭐⭐ **AN IMMUTABLE-GLOBAL READ SURVIVES THE MERGE.** The mark that refuses a write through
			// `var b = <a `let` array>` rides the VALUE — deliberately, so it needs no second encoding of the
			// name-resolution order — and a merge MINTS A NEW VALUE, so without this the mark simply stops at
			// the join and the refusal is bypassed by writing the same thing one keyword longer:
			// `var pick = A if c else M`, or a `match … gives A` arm, then `pick.push(9)` grows a `let` array,
			// through the ternary AND the match-expression door, including the degenerate `A if c else A`.
			//
			// ANY marked arm marks the phi: the phi is one value standing for every arm's, so it is laundered
			// if even one path can reach it holding an immutable global's record. That is the conservative
			// direction, and it is the only sound one here — the alternative refuses nothing on the path that
			// actually aliases.
			// ⭐ **AND THE BUFFER-SURFACE FAMILY, at this merge and at `finishValueTry`'s** — the same rule for
			// the same reason, with its own two measurements in its header.
			self.propagateBufferSurfaceToPhi(phiId, gives: finalGives)

			if not resultOwned 'aBorrowedResultPhi'
				self.propagateSlotReadMarkToPhi(phiId, gives: finalGives)
			end 'aBorrowedResultPhi'

			// ⭐ **THE RESULT PHI'S ALIAS CLAIM, ASKED OF EVERY ARM RATHER THAN INHERITED FROM ARM 0.**
			// The phi is named off `giveType` — the FIRST arm's type — and `checkGiveTypes` above deliberately
			// lets a ranged-alias give and a plain `int` give merge (*"the numeric subtypes share a register
			// file and a phi holds either"*), so arm 0's ALIAS is not a fact about arm 1's VALUE. MEASURED:
			// `alpha(n) gives n` / `end(a, b) gives a + b` over `Num = int(0 to 1000)` denoted `Num`, returned
			// **1800** through a `returns Num`, and reported `<join> as Num` as an unneeded cast. `finalGives`
			// is the complete reaching set — a returning/breaking arm contributes no entry and no edge — so
			// this merge is one of the two that may ask at all.
			self.recordMergeAliasProof(phiId, incoming: finalGives)
			self.recordLiteralRangeOfMerge(phiId, incoming: finalGives)
			self.recordFloatRangeOfMerge(phiId, incoming: finalGives)
			self.settleFloatResult(phiId)
			self.joinLiteralColumns(phiId, incoming: finalGives)

			if self.anArmGives(reachingArms, sought: SoughtGive.deferred) 'anArmOfUnknownType'
				self.bodyState.undecidedMerges = withValueMarked(self.bodyState.undecidedMerges, value: phiId)
			end 'anArmOfUnknownType'

			// ⭐⭐ **AN E3207 BLAME SURVIVES THE MERGE, on the same reasoning `joinMergeCapability`
			// above rests on and for the same construct pair.** `grow(g)` on a `let` is refused, so
			// `grow(g if flag else g)` must be too — the merge copies nothing, so the record a callee writes
			// through the phi IS the record the binding names. ANY blamed arm blames the phi, exactly as any
			// marked arm marks it: the phi stands for every arm's value, so one path reaching it holding an
			// immutable binding's record is enough.
			//
			// ⚠ **IT IS NOT GATED ON THE PHI BEING BORROWED.** The argument for a gate is that an OWNED phi
			// copies a borrowed byte-record arm (`promoteBorrowedToOwned`), so a write through it could not
			// reach the binding — which is true of the RECORD and false of the RULE. Both shapes it would
			// exempt — `grow(makeStr() if c else <a `let` String>)` and `grow(make() if c else <a `let`
			// Array>)` — are **E3207**, and the second aliases outright (a `let` array binding is OWNED, so
			// nothing promotes or copies it and the push lands in the binding). A gate here would have kept
			// that second one accepted, which is the hole this rule exists to close.
			self.notePhiParamSources(func, phi: phiId, gives: finalGives)

			result = MatchGiveValue.value(phiId)
		end 'resultPhi'

		for k in 0 upto carried.count() 'setBindings'
			let binding = try carried.get(k) otherwise panic("finalizeMatchMerge: carried.get OOB at {k}")
			let isDifferent = try differs.get(k) otherwise panic("finalizeMatchMerge: differs.get OOB at {k}")

			if isDifferent 'phiVar'
				let phiId = self.mintPhiForBinding(merge, binding: binding)
				self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: phiId, def: DebugVersionDef.definedIn(merge.id))
				binding.setBoundValue(phiId, ledger: self.bodyState.moveLedger)
				let incoming = ValueIdArray.create(reachingArms.count(), zeroed: false)

				for i in 0 upto reachingArms.count() 'eachArm'
					let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
					incoming.push(try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}"))
				end 'eachArm'

				self.admitUnsignedLiteralsAcross(incoming)
			end 'phiVar' else 'common'
				let commonValue = try firstArm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
				self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: commonValue, def: DebugVersionDef.merged)
				binding.setBoundValue(commonValue, ledger: self.bodyState.moveLedger)
			end 'common'
		end 'setBindings'

		// Record each reaching arm's edge args, in the block-arg order minted above.
		for i in 0 upto reachingArms.count() 'recordEdges'
			let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			let argIds = ValueIdArray.create(0)

			if isExpression 'giveArg'
				argIds.push(try finalGives.get(i) otherwise panic("finalizeMatchMerge: finalGives.get OOB at {i} — one entry per reaching arm"))
			end 'giveArg'

			for k in 0 upto carried.count() 'eachVarArg'
				let isDifferent = try differs.get(k) otherwise panic("finalizeMatchMerge: differs.get OOB at {k}")

				if isDifferent 'diffArg'
					self.pushMergedEdgeValue(argIds, binding: try carried.get(k) otherwise panic("finalizeMatchMerge: carried.get OOB at {k}"), value: try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}"))
				end 'diffArg'
			end 'eachVarArg'

			// The edge is pushed onto the arm's exit block DIRECTLY here, not through `recordBranchEdge`,
			// and that is a deliberate bootstrap-fixpoint workaround, not a style slip: the whole-program
			// mutating-parameter analysis that decides whether `recordBranchEdge`'s `block` is mutated does
			// not converge once the give-ownership helpers enter this function's call graph, so it
			// alternately demands `let` (E3207) and `var` (E3077) for the loop's arm. Mutating `arm`'s own
			// block here is analysed locally and is stable. `argIds.count() == 0` means no phi rides this
			// edge — the same guard `recordBranchEdge` applies — so nothing is recorded for a zero-arg edge.
			if argIds.count() > 0 'hasEdgeArgs'
				arm.exitBlock.branchEdges.push(BranchEdge.create(merge.id, argIds: argIds))
			end 'hasEdgeArgs'
		end 'recordEdges'

		return MatchOutcome.create(merge, result: result)
	end 'finalizeMatchMerge'

	// ⭐ **IS THIS MERGE ARM'S GIVE VALUE AN INTEGER-DOMAIN NUMBER a float arm promotes to float?**
	// True for a plain `int`, an `ExitCode`, or a ranged-INT alias — everything `cvtsi2sd` reads soundly.
	// False for a `float` or ranged-float alias (ALREADY in the float domain — no promotion), for a
	// bool/String/function/type-parameter (NON-numeric — a genuine type mismatch), and for a `named`
	// AGGREGATE, which is numeric-CLASSED (`typeClassOf(named) == numeric`) but is a POINTER to a box that
	// `cvtsi2sd` would corrupt — told apart from a numeric alias by `aggregateNameIn`, exactly as
	// `checkGiveTypes` tells them apart. Reads the tag/name columns only, materialising no `MaxonType`.
	function giveIsPromotableToFloat(give ValueId) returns bool
		let tag = self.tagOf(give)
		let nameId = self.valueNameId(give)

		// A plain `int` or an `ExitCode` is an integer-domain number — always promotable.
		if tagIsPlainInteger(tag) 'plainInteger'
			return true
		end 'plainInteger'

		// A `named` value is a ranged alias OR a declared aggregate. A ranged-FLOAT alias is already
		// float-domain (no promotion); a declared aggregate (union/enum/per-instance alias) is a POINTER,
		// not a number, that `cvtsi2sd` would corrupt (`aggregateNameIn` names it); only a plain ranged-INT
		// alias — numeric, no aggregate name — promotes.
		if tag == ValueTypeTag.named 'namedType'
			if self.namedIsFloatAlias(nameId) 'floatAlias'
				return false
			end 'floatAlias'

			return aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: tag, nameId: nameId, readerFilePath: self.job.path).isEmpty()
		end 'namedType'

		// A `float` (already float-domain), bool, String, function, struct, type parameter, generic
		// instance, unresolved or void give is not an integer-domain number and does not promote.
		return false
	end 'giveIsPromotableToFloat'

	function firstArmGiving(reachingArms MatchArmExitArray, sought SoughtGive) returns ElementIndex throws GivingArmSearchError
		for (iter, arm) in reachingArms.withIterator() 'eachArm'
			if self.armGives(arm, sought: sought) 'aSoughtGive'
				return iter.index()
			end 'aSoughtGive'
		end 'eachArm'

		throw GivingArmSearchError.noArmGivesIt
	end 'firstArmGiving'

	function anArmGives(reachingArms MatchArmExitArray, sought SoughtGive) returns bool
		for arm in reachingArms 'eachArm'
			if self.armGives(arm, sought: sought) 'aSoughtGive'
				return true
			end 'aSoughtGive'
		end 'eachArm'

		return false
	end 'anArmGives'

	function armGives(arm MatchArmExit, sought SoughtGive) returns bool
		return self.giveIs(self.giveValueOf(arm.give), sought: sought)
	end 'armGives'

	function giveIs(give ValueId, sought SoughtGive) returns bool
		return match sought 'kind'
			known gives not self.valueIsDeferred(give)
			aliasedNumber gives self.valueIsAnAliasedNumber(give)
			runtimeSizedFixedArray gives self.signatures.isRuntimeSizedFixedArrayAt(self.tagOf(give), nameId: self.valueNameId(give))
			float gives tagIsFloat(self.tagOf(give))
			deferred gives self.valueIsDeferred(give)
		end 'kind'
	end 'giveIs'

	function baselineGiveIndex(reachingArms MatchArmExitArray) returns ElementIndex
		let firstKnown = try self.firstArmGiving(reachingArms, sought: SoughtGive.known) otherwise 0

		if let runtimeSized = try self.firstArmGiving(reachingArms, sought: SoughtGive.runtimeSizedFixedArray) 'theJoinOfSizedAndRuntimeSized'
			return runtimeSized
		end 'theJoinOfSizedAndRuntimeSized'

		let firstArm = try reachingArms.get(firstKnown) otherwise panic("baselineGiveIndex: reachingArms.get OOB at {firstKnown}")

		if not self.valueIsAPlainNumber(self.giveValueOf(firstArm.give)) 'theFirstArmNamesItsType'
			return firstKnown
		end 'theFirstArmNamesItsType'

		return try self.firstArmGiving(reachingArms, sought: SoughtGive.aliasedNumber) otherwise firstKnown
	end 'baselineGiveIndex'

	// Two different aliases join to their nearest common ancestor, or to nothing when they have none.
	// Arms that differ only by brand answer nothing too, so the merge still refuses them.
	function armAliasJoin(joined ArmAliasJoin, baseline immutable ByteArray, give ByteArray) returns ArmAliasJoin
		if not self.signatures.identitiesConflict(baseline, got: give, readerFilePath: self.job.path) 'onlyTheBrandsDisagree'
			return ArmAliasJoin.create(EmptySourceText)
		end 'onlyTheBrandsDisagree'

		return ArmAliasJoin.create(self.signatures.nearestCommonAliasAncestor(operandAliasSetUnion(baseline if joined.alias.isEmpty() else joined.alias, right: give), readerFilePath: self.job.path))
	end 'armAliasJoin'

	// A give-type mismatch between the baseline arm (`firstArm`) and `gotArm`, phrased for `construct`
	// through the shared `valueMergeMismatchError` mapping. A ternary always names its FALSE (second)
	// branch whichever arm actually mismatched — it has exactly two arms and the message reads them in
	// source order — so the displayed "got" arm is arm 1 for a ternary and the mismatching arm itself
	// for a match.
	//
	// ⚠ Both arms print through `valueDisplayTypeName`, the one value-display door, and not through
	// `aggregateNameIn`, the identity `checkGiveTypes` compares on: for a generic instance that
	// identity is a canonical mint no source line holds.
	function valueMergeGiveMismatch(construct MergeConstruct, reachingArms MatchArmExitArray, firstArm MatchArmExit, gotArm MatchArmExit, matchTok Token) returns SourceParseError
		var displayArm = gotArm

		if construct == MergeConstruct.ternary 'ternaryFalseArm'
			displayArm = try reachingArms.get(1) otherwise panic("valueMergeGiveMismatch: a ternary merge has no second (false) arm")
		end 'ternaryFalseArm'

		let firstGive = self.giveValueOf(firstArm.give)
		let gotGive = self.giveValueOf(displayArm.give)
		let paired = self.pairedDisplays(gotGive, declaredTag: self.tagOf(firstGive), declaredNameId: self.valueNameId(firstGive), declaredBrand: self.brandOf(firstGive), declaredIdentity: aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: self.tagOf(firstGive), nameId: self.valueNameId(firstGive), readerFilePath: self.job.path), declaredShown: self.valueDisplayTypeName(firstGive))
		return valueMergeMismatchError(construct == MergeConstruct.ternary, expectedDisplay: self.valueDisplayTypeName(firstGive), gotDisplay: self.valueDisplayTypeName(gotGive), line: matchTok.line, column: matchTok.column, expectedNote: paired.declaredNote, gotNote: paired.gotNote)
	end 'valueMergeGiveMismatch'

	// The `gives` value an expression arm carries. Only ever asked of an expression-match arm that REACHES
	// THE MERGE, so a `none` is a parser invariant break, not a program error. Takes the `MatchGiveValue`
	// itself so both `MatchArmExit` and the arm loop's `MatchArmBody` reach it through the one extractor.
	//
	// ⚠ **A VALUELESS ARM IS NOT ITSELF THE BREAK — REACHING THE MERGE WITH ONE IS.** Two arm shapes carry
	// no give: a STATEMENT arm (which never meets this routine, because a statement match runs no give
	// rule), and a DIVERGING expression arm (`panic`/`throws`), which is legal and simply terminates —
	// `parseArmBody` checks its terminator on the spot and keeps it out of `reachingArms`. So the message
	// names the collection this value came out of rather than the arm's spelling: whichever produced it,
	// the defect is that a non-giving arm was admitted to the merge.
	function giveValueOf(give MatchGiveValue) returns ValueId
		match give 'g'
			value(id) then return id
			none then panic("giveValueOf: an arm in a match expression's REACHING set carries no `gives` value — a statement arm never reaches this rule and a diverging `panic`/`throws` arm is kept out of `reachingArms` by its terminator check, so an arm reached the merge that should not have")
		end 'g'
	end 'giveValueOf'

	// The union an arm hands back: the one it ARRIVED with, unless the settlement really produced a different
	// SSA name.
	//
	// ⚠ **NOT TIDINESS — A MEASURED ALLOCATION.** `MatchGiveValue` carries a payload and is therefore a heap
	// box, so rebuilding one per arm unconditionally cost **+1,060 allocations at rung 5 of the scale ladder**
	// against a like-for-like base build — one box per `match`/ternary arm in the program, and the whole of the
	// movement in that column. Reusing keeps it at Δ0. Almost no arm launders, so almost every arm
	// hands back the union it arrived with.
	function armGiveUnion(arrived MatchGiveValue, settled ValueId) returns MatchGiveValue
		return arrived if settled == self.giveValueOf(arrived) else MatchGiveValue.value(settled)
	end 'armGiveUnion'

	// ⭐⭐ **EVERYTHING A FORK ARM OWES AS CONTROL LEAVES IT, IN THE ONE ORDER THAT IS SOUND** — shared by a
	// `match` arm and a ternary arm. Three steps, and the order is the whole content:
	//
	//   1. SETTLE THE GIVE — the value escaping to the result phi leaves its owner, or, when it is a BORROW
	//      into something this arm is about to release, is given a reference of its own (`settleArmGive`).
	//   2. RELEASE THE ARM'S ABANDONED TEMPORARIES, in the arm's OWN exit block — the only block their
	//      definitions dominate. An arm runs on one edge, so a release after the merge would free a value the
	//      other arms never built.
	//   3. RELEASE THE ARM'S SCOPE-LIFETIME RECORDS — its managed payload bindings, and any temporary
	//      `giveTemporaryScopeLifetime` held for a borrow taken out of it — by the same rule and into the same
	//      block.
	//
	// Step 1 MUST precede steps 2 and 3: an escaping value released by either sweep is a use-after-free
	// (`text(s) gives s` would drop the payload it is handing back), and a borrow laundered AFTER its source
	// is released increfs freed memory.
	//
	// Step 2 is inert for a `then` arm: its body is a STATEMENT, and the statement tail already released the
	// whole pending list on its own edge, leaving nothing above the floor. It is the `gives` arm of a match
	// EXPRESSION — which parses an expression and so has no statement tail — that step 2 exists for. Step 1 is
	// inert there too, and structurally so: `parseArmBody` mints `value(…)` only on the `isExpression` path,
	// so a `then` arm's give is `none` and the match below skips it.
	//
	// It takes and returns a `MatchGiveValue` rather than a `ValueId` plus a flag, because a STATEMENT arm
	// genuinely carries no value and the union is what says so — and the caller must take the answer BACK: a
	// laundered give is a FRESH SSA name, and the merge (`resolveGivesOwnership`) has to join the value the
	// arm really hands over rather than the borrow it started from.
	function finishArmExit(give MatchGiveValue, tempFloor ElementIndex, ownedFloor ElementIndex, exitBlock IrBlock, anchor Token) returns MatchGiveValue throws SourceParseError
		var settled = give

		match give 'g'
			// A STATEMENT arm carries no value, so there is nothing to settle — not "settle it to itself".
			none then break
			value(v) then settled = self.armGiveUnion(give, settled: try self.settleArmGive(v, ownedFloor: ownedFloor, exitBlock: exitBlock, anchor: anchor))
		end 'g'

		let resumeBlock = self.bodyState.currentBlock
		self.bodyState.currentBlock = exitBlock
		self.drainPendingTemps(tempFloor, anchor: anchor)
		self.bodyState.currentBlock = resumeBlock

		self.dropArmScopedOwned(ownedFloor, exitBlock: exitBlock, anchor: anchor)
		return settled
	end 'finishArmExit'

	// ⭐⭐ **A BORROW MAY NOT LEAVE AN ARM THAT IS ABOUT TO FREE WHAT IT POINTS INTO.** Everything in
	// `ownedBindings` above this arm's floor dies at the arm's exit — its managed payload bindings, and the
	// temporaries `giveTemporaryScopeLifetime` held for borrows taken inside the arm — so a give that is
	// still a BORROW when the arm holds any of them may point into one of them, and the merge would read
	// freed memory. It is given a reference of its own instead, through the SAME `promoteBorrowedMergeEdge`
	// the merge's own uniform-ownership promotion uses (`promoteBorrowedGive`); the phi then owns on this
	// edge, `resolveGivesOwnership` sees an owned arm and promotes the others to match, and the count
	// balances exactly as it does when an arm gives a fresh box.
	//
	// **MEASURED, both constructs, both reading `0x3F3F3F3F3F3F3F3F`:** `match p 'k' first gives
	// makeA().name second gives makeB().name end 'k'` and its ternary twin `makeA().name if t else
	// makeB().name` — two BORROW arms, so nothing else made the phi owned and nothing laundered them. The
	// oracle answers 5 and 2.
	//
	// ⚠ **THE HEIGHT TEST IS THE SET ITSELF, WHICH IS WHY THIS NEEDS NO PROVENANCE COLUMN.** The question is
	// *"can this borrow point into anything this arm is about to release?"*, and the arm's own owned-binding
	// tail IS that set. A borrow out of an OUTER binding is laundered too, and that is balanced rather than
	// wasteful: the incref is released by the phi's single drop.
	//
	// ⛔ **EXCEPT FOR A READ OF AN IMMUTABLE GLOBAL, AND THE CLAUSE IS THE PREDICATE STATED CORRECTLY RATHER
	// THAN AN EXEMPTION**: a give read out of MODULE storage borrows from a record that outlives every scope,
	// so it demonstrably cannot point into anything an arm releases and there is nothing here to launder.
	// ⚠ **THAT — AND ONLY THAT — IS WHY THE CLAUSE EXISTS.** The aggregate arm does not refuse an immutable global's record
	// (the rule is enforced at the write), so nothing else depends on the clause.
	// Skipping the promotion does not lose the mark: the
	// give reaches the phi unchanged, and `joinMergeCapability` reads the marks off the gives.
	//
	// An arm holding NOTHING (the overwhelming majority) reaches the two doors below: an outliving
	// IMMUTABLE binding's value is co-owned (`giveAliasesAnOutlivingImmutableBinding`), and everything
	// else settles through `transferGiveToPhi` — a no-op for a borrowed or scalar give.
	function settleArmGive(give ValueId, ownedFloor ElementIndex, exitBlock IrBlock, anchor Token) returns ValueId throws SourceParseError
		if self.giveBorrowsIntoDyingRecords(give, ownedFloor: ownedFloor) 'borrowIntoDyingRecords'
			return try self.promoteBorrowedMergeEdge(give, edgeBlock: exitBlock, anchor: anchor)
		end 'borrowIntoDyingRecords'

		// ⭐⭐ **AN ARM READING AN IMMUTABLE BINDING CO-OWNS IT — IT DOES NOT MOVE IT (⚖ 2026-08-04).**
		// The arm's own edge takes a SECOND reference and the binding keeps the one it already owed, so both
		// stay live and the box is released once by each. `emitIncref` in place rather than `__mm_retain` for
		// the reason its header gives: the phi mints its own id, so no two BINDINGS come to share one — which
		// is the whole of `coOwnImmutableRebindSource`'s fresh-name argument and does not apply here.
		if self.giveAliasesAnOutlivingImmutableBinding(give, ownedFloor: ownedFloor) and not self.valueIsAnOwnedIsolatedLocal(give) 'coOwnedImmutableSource'
			// The incref belongs on the ARM's edge, not on `currentBlock`: the arm runs on one path, and a
			// reference taken on the unconditional path would be owed by the phi on an edge that never took it.
			// The same placement `promoteBorrowedMergeEdge` makes, for the same reason.
			let saved = self.bodyState.currentBlock
			self.bodyState.currentBlock = exitBlock
			self.emitIncref(give, range: SourceRange.ofToken(anchor))
			self.bodyState.currentBlock = saved
			return give
		end 'coOwnedImmutableSource'

		self.transferGiveToPhi(give)
		return give
	end 'settleArmGive'

	function valueIsAnOwnedIsolatedLocal(value ValueId) returns bool
		return self.valueIsAnOwnedIsolatedRegion(value) and self.valueIsOwnedHeap(value)
	end 'valueIsAnOwnedIsolatedLocal'

	// The four clauses of `settleArmGive`'s question, named so the sentence above is the code: the arm holds
	// records that die at its exit, the give is a MANAGED pointer (a scalar borrows nothing), it does not
	// already own a reference of its own, and it is not a read of module storage that outlives every scope.
	function giveBorrowsIntoDyingRecords(give ValueId, ownedFloor ElementIndex) returns bool
		if self.bodyState.ownedBindings.count() == ownedFloor 'armHoldsNothing'
			return false
		end 'armHoldsNothing'

		return self.valueIsManagedHeap(give) and not self.valueIsOwnedHeap(give) and not self.valueNeedsNoHold(give)
	end 'giveBorrowsIntoDyingRecords'

	// ⭐⭐ **DOES THIS GIVE NAME A VALUE AN IMMUTABLE BINDING GOES ON OWNING PAST THE MERGE?** The three
	// clauses, and each excludes a give the merge already answers correctly:
	//
	//   • a BORROWED give owns nothing to co-own — `giveBorrowsIntoDyingRecords` above and
	//     `resolveGivesOwnership`'s promotion decide it, and they are the doors that hold the borrow rules;
	//   • an owned TEMPORARY (`gives build(1)`) has no other owner at all, so the phi ADOPTS the one
	//     reference it was handed — increfing it would leak, which is `transferFallbackToPhi`'s measurement;
	//   • a binding this ARM declared (`text(s) gives s`) dies at the arm's exit, so a move is both correct
	//     and free: `dropArmScopedOwned` skips a poisoned binding, where co-ownership would incref and
	//     immediately decref. `ownedFloor` is the arm's own height, so the index test IS that question.
	//
	// What is left is a binding declared OUTSIDE the arm and declared `let`, which is exactly the shape the
	// alias ruling blesses (`rebindSourceIsAnImmutableAlias` — this is the same question keyed by VALUE, since
	// a give arrives as an SSA id and not as a name).
	//
	// ⚠ **ANYWHERE ELSE A MUTABLE SOURCE STILL MOVES, and that is the ruling's rationale read the other way**:
	// a `var` can be written through after the merge, so a second name for its value could watch it change.
	// That is `specs/moves.md`'s boundary, and `error.gives-mutable-binding-still-moves` is its pin here.
	function giveAliasesAnOutlivingImmutableBinding(give ValueId, ownedFloor ElementIndex) returns bool
		if not self.valueIsOwnedHeap(give) 'borrowed'
			return false
		end 'borrowed'

		let index = try self.liveOwnerIndexOf(give) otherwise return false

		if index >= ownedFloor 'declaredByThisArm'
			return false
		end 'declaredByThisArm'

		let owner = try self.bodyState.ownedBindings.get(index) otherwise panic("giveAliasesAnOutlivingImmutableBinding: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")
		return not owner.isMutable()
	end 'giveAliasesAnOutlivingImmutableBinding'

	// ⭐ **TRANSFER AN OWNED `gives` VALUE OUT OF ITS OWNER.** An expression arm whose yielded value
	// is OWNED — an owned interpolation/heap `String`, a struct box, or a managed payload a binding arm
	// moved out (`text(s) gives s`) — hands that value to the merge's result phi, which becomes its sole
	// owner (`finalizeMatchMerge` marks the phi owned so its consumer drops it once). So the value must
	// leave its current owner HERE, before `dropArmScopedOwned` releases the arm's bindings and before the
	// post-match statement drain runs: an owned temporary leaves the pending list, and a bare-local owner
	// (the payload binding of `text(s) gives s`, or an outer MUTABLE binding) is poisoned so `scopeReleasesAbove`
	// skips its drop and a later read of it is use-after-move. A borrowed/scalar give owns nothing, so both
	// calls are no-ops — a borrowed String is promoted at the merge instead, where phi ownership is decided.
	//
	// ⚠ **AN OUTER binding declared `let` NEVER REACHES HERE (⚖ 2026-08-04).** `settleArmGive` co-owns it
	// instead, so the phi takes a second reference and the source stays live — the same answer
	// `transferFallbackToPhi` gives the `try … otherwise <binding>` edge. This door is left with exactly the
	// two owners a move is right for: an arm-scoped binding, and a mutable one.
	function transferGiveToPhi(give ValueId)
		if not self.valueIsOwnedHeap(give) 'borrowed'
			return
		end 'borrowed'

		self.moveOwnedValueOut(give)
	end 'transferGiveToPhi'

	// ⭐⭐ **THE BUFFER-SURFACE FAMILY SURVIVES A MERGE TOO.**
	// The sibling above's twin, at the same two merges and for the identical structural reason: these facts
	// ride the VALUE, a merge MINTS A NEW VALUE, and a fact that stops at the join is bypassed by writing the
	// same program one keyword longer.
	//
	// ⛔⛔ **WITHOUT IT THERE ARE TWO WRONG ANSWERS AT ONCE, BOTH MEASURED.** With the mark stopping here:
	//   • a `__ManagedMemory` value through a merge came out on the **`Array` ROSTER, EXACTLY INVERTED** —
	//     `var m = a.managed if flag else a.managed` then `m.length()` was refused as an unknown `Array`
	//     member while `m.count()` compiled, on a growable array, with no `FixedArray` in sight. That is the roster inversion
	//     at the merge position, and it is what the first two arms below repair.
	//   • a SIZED container's record laundered its identity through the join: inside an `extension FixedArray`,
	//     `var m = managed if flag else managed` and `var m = try managed.slice(0, 99) otherwise managed`
	//     each cleared the fixed array's own record and printed `len=0 count=3` — the reproducer,
	//     reached by a ternary and by a `try` fallback with every other door already shut.
	//
	// ⚠ **ANY MARKED EDGE MARKS THE PHI, which is the conservative direction and the only sound one** —
	// `joinMergeCapability`'s argument word for word: the phi is one value standing for every
	// edge's, so it must answer for the strongest claim any path can reach it holding. The arms do not chain:
	// one arm per carrier, so no column's carry is conditional on another's. (`markSizedContainerBuffer` takes
	// the buffer mark as well — that is its door invariant, not this loop's business.)
	//
	// ⚠ **THE TUPLE-SLOT COLUMN IS DELIBERATELY ABSENT.** It holds a `DeclaredSurface` TREE rather than a
	// bit, so "any edge" is not a rule for it — joining two edges' trees needs the COMBINE rule the
	// `bufferSurfaceValues` field header records as unwritten, and inventing one here on the parser's merge
	// path is not this routine's to do. What that leaves open is a TUPLE OF BUFFERS through a merge, which is
	// the roster inversion above one container out; it is reported rather than papered over.
	function propagateBufferSurfaceToPhi(phi ValueId, gives ValueIdArray)
		for give in gives 'eachGive'
			if self.valueIsASizedContainersBuffer(give) 'aSizedContainersOwnRecord'
				self.markSizedContainerBuffer(phi, origin: self.brandOf(phi))
			end 'aSizedContainersOwnRecord'

			if self.valueIsBufferSurface(give) 'aBuffer'
				self.markBufferSurface(phi, origin: self.brandOf(phi))
			end 'aBuffer'

			if self.valueElementIsBufferSurface(give) 'holdsBuffers'
				self.markBufferSurfaceElements(phi)
			end 'holdsBuffers'
		end 'eachGive'
	end 'propagateBufferSurfaceToPhi'

	// Decide whether an expression match's result phi OWNS its value, and make every arm's give owned so it
	// does. The phi is owned iff any reaching arm gives an owned value (`finalizeMatchMerge` then marks it an
	// owned temp); when it is, each arm that gives a BORROWED value is made owned by `promoteBorrowedGive`
	// (a borrowed String is copied; a borrowed non-text aggregate has no cheap copy and is E2015-refused)
	// so the phi is uniformly owned across all edges. A statement match, or an expression match whose arms
	// all give scalars / immortal rdata, keeps a borrowed phi (returns false).
	//
	// The per-arm give value the merge should use — after any promotion — is collected into `finalGives`
	// (one entry per reaching arm, in order) rather than written back onto the `MatchArmExit`, so nothing
	// here mutates the arm records the caller still reads. `finalGives` is empty for a statement match.
	function resolveGivesOwnership(reachingArms MatchArmExitArray, isExpression bool, matchTok Token, finalGives ValueIdArray) returns bool throws SourceParseError
		if not isExpression 'statementMatch'
			return false
		end 'statementMatch'

		var resultOwned = false

		for i in 0 upto reachingArms.count() 'anyOwned'
			let a = try reachingArms.get(i) otherwise panic("resolveGivesOwnership: reachingArms.get OOB at {i}")
			let give = self.giveValueOf(a.give)

			if self.valueIsOwnedHeap(give) 'owned'
				resultOwned = true
			end 'owned'
		end 'anyOwned'

		for i in 0 upto reachingArms.count() 'collectGives'
			let a = try reachingArms.get(i) otherwise panic("resolveGivesOwnership: reachingArms.get OOB at {i}")
			let give = self.giveValueOf(a.give)

			if resultOwned and not self.valueIsOwnedHeap(give) 'promoteBorrowed'
				finalGives.push(try self.promoteBorrowedGive(give, arm: a, matchTok: matchTok))
			end 'promoteBorrowed' else 'keepGive'
				finalGives.push(give)
			end 'keepGive'
		end 'collectGives'

		return resultOwned
	end 'resolveGivesOwnership'

	// Make a BORROWED `gives` value owned so a match/conditional whose OTHER arms give owned values has a
	// uniformly-owned result phi its consumer can drop unconditionally. It reaches the shared
	// `promoteBorrowedToOwned` through `promoteBorrowedMergeEdge`, as the `return`'s twin: a borrowed STRING is copied (the fused-record
	// blit), a borrowed TRIVIAL TUPLE gets its own record, a borrowed non-text AGGREGATE is INCREF'd, and either
	// way the arm hands the phi a value it really owns. Which block it lands in and what else the edge owes the
	// phi are `promoteBorrowedMergeEdge`'s, shared with the `try … otherwise` fallback that asks the same thing.
	//
	// ⚠ **THE AGGREGATE ARM PROMOTES BY INCREF, BECAUSE A BORROWED GIVE LEFT UNPROMOTED HANDS THE OWNED PHI A BOX IT DOES NOT OWN.**
	// The compiler has `__mm_retain` (wired to the `var q = p` door one screen up) and the `__clone_<T>` cascade. A
	// borrowed give left unpromoted would hand the owned phi a box it does not own (a leak/UAF reachable
	// through a `match … gives` arm AND a ternary arm alike); the incref is what makes it owned, so the phi's
	// single drop balances against a real second reference instead of the borrow's owner's one.
	//
	// Which gives this door answers for is asked through the predicate the `return` uses
	// (`borrowedValueOwesAHandoffReference`), not a test of its own: a narrower test would drop a
	// shared generic body's borrowed opaque `T` (a `typeParameter` tag, neither byte record nor
	// aggregate) into the panic below, while the `if`/`return` spelling of the same function compiles.
	//
	// A deferred give reaches here too and is left unpromoted: `checkGiveTypes` skips it, and
	// SemanticCheck refuses the undeclared call (E3004) before any codegen, so the phi's ownership
	// never matters. A resolved scalar give cannot reach here: `checkGiveTypes` rejects a resolved
	// scalar arm mixed with an owned aggregate/String give, so it is a parser invariant break.
	function promoteBorrowedGive(give ValueId, arm MatchArmExit, matchTok Token) returns ValueId throws SourceParseError
		if self.borrowedValueOwesAHandoffReference(give) 'owesAReference'
			return try self.promoteBorrowedMergeEdge(give, edgeBlock: arm.exitBlock, anchor: matchTok)
		end 'owesAReference'

		if self.valueIsDeferred(give) 'deferredCallError'
			return give
		end 'deferredCallError'

		panic("promoteBorrowedGive: a RESOLVED borrowed scalar give reached an OWNED result phi — checkGiveTypes rejects a resolved scalar mixed with an owned aggregate/String give, and an unresolved give is deferred above, so this is unreachable")
	end 'promoteBorrowedGive'

	// Emit one arm's pattern as a single boolean condition, OR-folding the alternatives (`1 or 2 or
	// 3`). Records single-value patterns for the duplicate check and rejects a pattern whose type
	// cannot be compared to the scrutinee (E2028). Emits into `currentBlock`.
	function emitPatternCondition(scrut ValueId, scrutTag ValueTypeTag, seenValues SeenPatternValues) returns ValueId throws SourceParseError
		var cond = try self.emitPatternAtom(scrut, scrutTag: scrutTag, seenValues: seenValues)

		while self.at(TokenKind.or) 'orChain'
			let orTok = try self.consumeOrChainSeparator()
			let rhs = try self.emitPatternAtom(scrut, scrutTag: scrutTag, seenValues: seenValues)
			cond = try self.emitBinOp(cond, rhs: rhs, op: MaxonBinOp.bitOr, opTok: orTok)
		end 'orChain'

		return cond
	end 'emitPatternCondition'

	// ⭐ **THE SEPARATOR BETWEEN TWO ALTERNATIVES OF A PATTERN CHAIN — AN `or` AND THE NEWLINE THAT MUST
	// FOLLOW IT.** One rule is both halves of the shape: it lets a chain continue onto the next line at all,
	// and it forbids packing two alternatives onto one. Naming cases rather than ranging over them makes an
	// arm twenty alternatives wide, and one per line is what keeps that readable and makes adding or
	// removing a case a one-line diff.
	//
	// ⚠ **THE CALLERS' `at(or)` TEST MUST NOT SKIP LAYOUT.** A newline is admitted only AFTER an `or` this
	// has already consumed, which is what keeps the continuation trailing-only. A LEADING `or` would be
	// ambiguous: `or` is a legal case name (`keywordIsANameAt` reads a keyword followed by `then`/`gives`
	// as one), so a line starting with `or` reads equally as this chain continuing and as a fresh arm whose
	// first alternative is the case named `or`. No lookahead separates them — both are complete arms.
	//
	// Shared by all three chain loops so they cannot drift on what a legal arm is.
	function consumeOrChainSeparator() returns Token throws SourceParseError
		let orTok = try self.consume(TokenKind.or)

		if not self.at(TokenKind.newline) 'packed'
			let packedTok = self.current()
			throw SourceParseError.matchOrChainNeedsOwnLine(packedTok.line, column: packedTok.column)
		end 'packed'

		self.skipNewlines()
		return orTok
	end 'consumeOrChainSeparator'

	// One alternative of a pattern: an open-lower range (`min to/upto hi`), a closed/open-upper
	// range (`lo to/upto hi`, `lo to max`), or a single value.
	function emitPatternAtom(scrut ValueId, scrutTag ValueTypeTag, seenValues SeenPatternValues) returns ValueId throws SourceParseError
		let startTok = self.current()
		let loStart = self.pos

		if self.isOpenBoundIdentifier(startTok, marker: MinBoundField) 'openLower'
			self.advance()
			return try self.emitOpenLowerRange(scrut)
		end 'openLower'

		let lo = try self.emitPatternValue(scrut)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			return try self.emitClosedRange(scrut, scrutTag: scrutTag, loValue: lo, loStart: loStart)
		end 'rangeArm'

		// A single value: `scrut == lo`.
		try self.checkAndRecordDuplicate(lo, seenValues: seenValues, start: loStart, pastEnd: self.pos)
		return try self.emitCompare(scrut, rhs: lo, op: MaxonCmpOp.eq, opTok: startTok)
	end 'emitPatternAtom'

	// `min to/upto <hi>` — the lower bound is open, so the condition is just the upper compare. A
	// `min to max` covers every value: a constant `true`.
	function emitOpenLowerRange(scrut ValueId) returns ValueId throws SourceParseError
		if not (self.at(TokenKind.to) or self.at(TokenKind.upto)) 'notRange'
			let notRangeTok = self.current()
			throw SourceParseError.unexpectedToken(TokenKind.to.rawValue, got: tokenDisplayText(notRangeTok), line: notRangeTok.line, column: notRangeTok.column)
		end 'notRange'

		let isUpto = self.at(TokenKind.upto)
		let rangeTok = self.current()
		self.advance()

		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openBoth'
			self.advance()
			return self.emitLiteral(BoolTrueValue, valueType: MaxonType.boolean, range: SourceRange.ofToken(rangeTok))
		end 'openBoth'

		let hi = try self.emitPatternValue(scrut)
		return try self.emitCompare(scrut, rhs: hi, op: self.rangeUpperCmpOp(isUpto), opTok: rangeTok)
	end 'emitOpenLowerRange'

	// `lo to/upto <hi>` where `lo` is already emitted — a two-compare AND, or (`lo to max`) just the
	// lower compare. Entered with the cursor ON the range keyword, so `loStart` plus the cursor bracket
	// the lower bound and the arm's whole source span is available to the single-value diagnostic.
	function emitClosedRange(scrut ValueId, scrutTag ValueTypeTag, loValue ValueId, loStart ElementIndex) returns ValueId throws SourceParseError
		let rangeTok = self.current()
		let isUpto = rangeTok.kind == TokenKind.upto
		self.advance()

		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openUpper'
			self.advance()
			return try self.emitCompare(scrut, rhs: loValue, op: MaxonCmpOp.ge, opTok: rangeTok)
		end 'openUpper'

		let hiStart = self.pos
		let hi = try self.emitPatternValue(scrut)
		try self.checkChainRangeIsMultiValued(scrutTag, isUpto: isUpto, loStart: loStart, hiStart: hiStart)

		let loCmp = try self.emitCompare(scrut, rhs: loValue, op: MaxonCmpOp.ge, opTok: rangeTok)
		let hiCmp = try self.emitCompare(scrut, rhs: hi, op: self.rangeUpperCmpOp(isUpto), opTok: rangeTok)
		return try self.emitBinOp(loCmp, rhs: hiCmp, op: MaxonBinOp.bitAnd, opTok: rangeTok)
	end 'emitClosedRange'

	// The upper-bound comparison: `<` for `upto` (exclusive), `<=` for `to` (inclusive).
	function rangeUpperCmpOp(isUpto bool) returns MaxonCmpOp
		if isUpto 'exclusive'
			return MaxonCmpOp.lt
		end 'exclusive'

		return MaxonCmpOp.le
	end 'rangeUpperCmpOp'

	// Parse a pattern LITERAL (a value or a range bound): an optional `-`, then an int/float/bool/
	// character literal. Emits it and checks it is comparable to the scrutinee (E2028). A string
	// literal is E2028 (`"one"` on an `int` scrutinee); `min`/`max` are the caller's, not a value.
	function emitPatternValue(scrut ValueId) returns ValueId throws SourceParseError
		let firstTok = self.current()
		let scrutTag = self.tagOf(scrut)

		// A STRING LITERAL pattern — legal only against a `string` scrutinee. Its
		// condition is `__str_eq(scrut, "literal")`: `emitPatternAtom`'s single-value path emits the
		// literal here and then `emitCompare(scrut, lo, eq)`, which — both operands `string` — routes to
		// the `__str_eq` runtime call, feeding the SAME bool the scalar `or`/`default`/expression-merge
		// machinery consumes for an integer pattern. So `match name { "alice" then … }` reuses the whole
		// scalar dispatch unchanged; only "what a pattern atom IS" differs. Against a NON-string
		// scrutinee it stays the E2028 mismatch (`"one"` on an `int`).
		if self.at(TokenKind.stringLiteral) 'stringPattern'
			if tagIsText(scrutTag) 'stringScrutinee'
				// A pattern is a COMPILE-TIME literal — an interpolation there has no meaning (there is
				// nothing to match a runtime-built string against), so it is rejected rather than built.
				if self.peekKind() == TokenKind.stringInterpStart 'interpolatedPattern'
					throw SourceParseError.unsupported("an interpolated string as a match pattern — a `match` pattern must be a compile-time string literal", line: firstTok.line, column: firstTok.column)
				end 'interpolatedPattern'

				return try self.consumeStringLiteralValue()
			end 'stringScrutinee'

			throw SourceParseError.matchPatternTypeMismatch("String", scrutineeType: self.valueKindWord(scrut), line: firstTok.line, column: firstTok.column)
		end 'stringPattern'

		if self.at(TokenKind.minus) 'negated'
			try self.consume(TokenKind.minus)
			let negValue = try self.emitNegatedPatternValue(firstTok)
			return try self.checkPatternType(negValue, scrut: scrut, patternTok: firstTok)
		end 'negated'

		if self.at(TokenKind.intLiteral) 'intPattern'
			let intValue = try self.parseIntLiteral()
			self.admitUnsignedLiteralBeside(intValue, partner: scrut)
			return try self.checkPatternType(intValue, scrut: scrut, patternTok: firstTok)
		end 'intPattern'

		if self.at(TokenKind.floatLiteral) 'floatPattern'
			let floatValue = try self.parseFloatLiteral()
			return try self.checkPatternType(floatValue, scrut: scrut, patternTok: firstTok)
		end 'floatPattern'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolPattern'
			let boolValue = try self.parseBoolLiteral()
			return try self.checkPatternType(boolValue, scrut: scrut, patternTok: firstTok)
		end 'boolPattern'

		// ⭐ A PATTERN IS AN INTEGER-EXPECTING POSITION when the scrutinee is integral, so `match cp 'm' '-'
		// then …` compares codepoints while `match c 'm' 'a' then …` over a `Character` compares records —
		// through the same `integerizedOperand` every operand and declared slot goes through.
		if self.at(TokenKind.charLiteral) 'charPattern'
			let charStart = self.pos
			let charValue = try self.integerizedOperand(try self.parseCharLiteral(), expected: scrutTag, start: charStart, pastEnd: self.pos)
			return try self.checkPatternType(charValue, scrut: scrut, patternTok: firstTok)
		end 'charPattern'

		// A bare identifier (that is not `min`/`max`, handled by the caller) is an enum-case pattern.
		if self.at(TokenKind.identifier) 'enumCasePattern'
			if self.valueIsDeferred(scrut) 'aDeferredScrutinee'
				return try self.deferredCasePattern()
			end 'aDeferredScrutinee'

			try self.refuseCasePatternOverAScalar(scrut, patternTok: firstTok)
		end 'enumCasePattern'

		throw SourceParseError.expectedExpression(expressionOperandDisplayText(firstTok), line: firstTok.line, column: firstTok.column)
	end 'emitPatternValue'

	// The value after a pattern's `-`: a negated int, or a negated float LITERAL — the same sign-bit
	// fold the expression path applies (`parseNegatedFloatLiteral`), so a `-0.0` pattern carries the
	// sign bit rather than the `+0.0` that `0.0 - 0.0` computes. Any other token after `-` has no
	// numeric meaning to negate.
	function emitNegatedPatternValue(minusTok Token) returns ValueId throws SourceParseError
		if self.at(TokenKind.intLiteral) 'negInt'
			let tok = try self.consume(TokenKind.intLiteral)
			let v = try self.intLiteralValue(tok, negated: true)
			return self.emitLiteral(v, valueType: MaxonType.integer, range: SourceRange.ofToken(minusTok))
		end 'negInt'

		if self.at(TokenKind.floatLiteral) 'negFloat'
			return try self.parseNegatedFloatLiteral(minusTok)
		end 'negFloat'

		let operandTok = self.current()
		throw SourceParseError.nonNumericNegation(operandTok.kind.rawValue, line: minusTok.line, column: minusTok.column)
	end 'emitNegatedPatternValue'

	// A pattern value must be comparable to the scrutinee — the same DOMAIN rule `emitCompare`
	// applies, asked HERE so the failure is the match-specific E2028 rather than the comparison's
	// E3005. `emitCompare` therefore never rejects a pattern it is handed.
	function checkPatternType(value ValueId, scrut ValueId, patternTok Token) returns ValueId throws SourceParseError
		let valTag = self.tagOf(value)

		if not comparableOperands(self.tagOf(scrut), right: valTag) 'mismatch'
			throw SourceParseError.matchPatternTypeMismatch(typeTagName(valTag), scrutineeType: self.valueKindWord(scrut), line: patternTok.line, column: patternTok.column)
		end 'mismatch'

		return value
	end 'checkPatternType'

	// Record a single-value pattern for duplicate detection, or raise E2027 if it repeats one. Only
	// INTEGER-domain constants participate (`constIsKnown`). A float literal's bits ARE tracked, but
	// in the float domain, which this deliberately does not read: two patterns that differ can still be the
	// same VALUE (`+0.0` and `-0.0` compare equal), so a bit-set membership test would report the arms
	// distinct while the second is dead. Deciding a duplicate float needs `floatOrderKey`, and no corpus case
	// tests one — so a duplicate float pattern is deliberately not detected.
	//
	// ⭐⭐ **ENUM-CASE ARMS COME THROUGH THIS DOOR TOO.** `emitEnumTagLiteral` records a case's tag as a
	// known integer constant (a constant enum literal has to be recognisable as constant, for the `.rdata`
	// blob), so a repeated arm is caught here: `match c` with `red` twice is
	// **`E2027: overlapping pattern in match: 'red' is already covered`** rather than a silently dead
	// second arm.
	//
	// ⚠ **IT IS SOUND AND IT WIDENS NOTHING, and both halves are worth stating.** Two DISTINCT cases can
	// never collide, because `EnumCaseLedger.rawValueIsClaimed` refuses two cases sharing a raw value at the
	// DECLARATION (E3031) — so the only pattern pair this can reject is literally the same case written
	// twice, which has no reading under which the second arm is live. There is no false-reject surface to
	// look for.
	function checkAndRecordDuplicate(value ValueId, seenValues SeenPatternValues, start ElementIndex, pastEnd ElementIndex) throws SourceParseError
		if not self.constIsKnown(value) 'notConst'
			return
		end 'notConst'

		try self.recordDuplicateInt(self.constOf(value), seenValues: seenValues, start: start, pastEnd: pastEnd)
	end 'checkAndRecordDuplicate'

	// The integer core of duplicate detection, shared by the compare-emitting scalar path (`value` read
	// off a known constant) and the interval-plan path (`value` decoded straight from the pattern token).
	// The set membership test throws on the FIRST repeat in arm order — the same value, the same arm, the
	// linear scan reported — in O(1) rather than O(seen).
	function recordDuplicateInt(value FullRangeInt, seenValues SeenPatternValues, start ElementIndex, pastEnd ElementIndex) throws SourceParseError
		if seenValues.contains(value) 'duplicate'
			let patternTok = self.tokenAt(start)
			throw SourceParseError.matchDuplicatePattern(self.tokenTextFrom(start, endIndex: pastEnd), line: patternTok.line, column: patternTok.column)
		end 'duplicate'

		seenValues.insert(value)
	end 'recordDuplicateInt'

	// ⭐ **IS A RANGE PATTERN EMPTY?** — `upto` whose upper is at or below its lower, or an inclusive `to`
	// whose upper is below it. Written ONCE for both range paths: the scalar one lets an empty arm
	// contribute no interval, the enum one refuses it outright (E2027), and they disagreed about nothing
	// while spelling the same predicate with their operands mirrored.
	//
	// ⚠ **IT IS THE OTHER HALF OF "IS THIS RANGE DEGENERATE", AND `requireRangeIsMultiValued` LEANS ON
	// IT.** The two verdicts are disjoint — a range covering NO value cannot also cover exactly one — and
	// that is what lets each caller ask them in either order. Disjointness is a property of these two
	// expressions together, so they belong together: moving a boundary in one while the other keeps its
	// own copy would silently make one of the two rules unreachable, with no compile error anywhere.
	function rangeIsEmpty(lo FullRangeInt, hi FullRangeInt, isUpto bool) returns bool
		return (hi <= lo) if isUpto else (hi < lo)
	end 'rangeIsEmpty'

	// ⭐⭐ **THE SINGLE-VALUE RANGE RULE — ONE PREDICATE, EVERY OPERAND SHAPE.** A range pattern covering
	// exactly one value is always a mistake: the author meant the bare value or got the bounds wrong. So
	// `5 to 5`, `red to red`, `'a' to 'a'` and their exclusive twins `5 upto 6`, `red upto green`,
	// `'a' upto 'b'` are refused (`specs/match-range-single-value.md`).
	//
	// ⚠ **THE OPERAND SHAPES DIFFER IN THEIR DOMAIN, NOT IN THE RULE.** An int compares values, a char
	// compares CODEPOINTS, an enum compares DECLARATION INDICES (what a range pattern means — never
	// the tags, which an explicit `= N` may reorder), a float compares `floatOrderKey`s. Each caller
	// projects its bounds into its own ordered domain and asks HERE. A separate emit site per shape
	// would be copies of one refusal, free to disagree about what is legal.
	//
	// ⚠ **`hasAdjacentValues` IS WHY FLOAT IS NOT ANOTHER COPY.** `upto` excludes its upper bound, so
	// it covers exactly one value only where the domain has an immediate SUCCESSOR. Between two f64s
	// there is always another f64, so no float `upto` is ever single-valued and only the equal-bound
	// `to` form is.
	//
	// ⚠ **AN OPEN BOUND NEVER ARRIVES HERE.** `min to X` and `X to max` span more than one value by
	// construction and the spec exempts them outright, so each caller returns before asking.
	//
	// ⚠ **CALLED WITH THE CURSOR JUST PAST THE UPPER BOUND**, which is what makes the message ONE span —
	// `[loStart, self.pos)` covers both bounds AND the keyword between them, so the range is quoted back
	// exactly as the file lays it out and nothing here re-spells `to`/`upto`. Every caller asks the moment
	// it has decoded its upper bound. The span is rendered only on the failing path: the callers hand over
	// a token INDEX, not a string, so a legal range arm allocates nothing for a diagnostic it will not raise.
	function requireRangeIsMultiValued(lo FullRangeInt, hi FullRangeInt, isUpto bool, hasAdjacentValues bool, loStart ElementIndex) throws SourceParseError
		let coversOneValue = (hasAdjacentValues and hi == lo + 1) if isUpto else hi == lo

		if not coversOneValue 'multiValued'
			return
		end 'multiValued'

		let loTok = self.tokenAt(loStart)
		throw SourceParseError.matchSingleValueRange(self.tokenTextFrom(loStart, endIndex: self.pos), line: loTok.line, column: loTok.column)
	end 'requireRangeIsMultiValued'

	// The single-value rule for the COMPARE-CHAIN match — the scrutinee kinds `matchUsesIntervalPlan`
	// leaves out. The interval paths project their bounds where they DECODE them (an integer already, an
	// enum case index already); these two must project theirs from their BOUND TOKENS, because neither a
	// `Character` nor a `float` bound is an integer-domain constant a pattern value can be read as.
	//
	// ⚠ **THE REMAINING CHAIN SCRUTINEES HAVE NO ORDERED DOMAIN, AND THE LIST IS EXHAUSTIVE.** A `String`
	// (`"a" to "b"` has no notion of how many values it covers) and an `unresolved` scrutinee (a call to a
	// function no file declares, which `comparableOperands` DEFERS rather than rejecting) fall through
	// deliberately. Every other tag `matchUsesIntervalPlan` excludes — a struct, an interface, a generic
	// instance — cannot reach here at all: `checkPatternType` asks `comparableOperands`, so a literal bound
	// against any of them is E2028 at the LOWER bound, one call before this. A ranged-FLOAT typealias is
	// not a fourth case either: MEASURED, its scrutinee carries the `float` tag (both as `x as Ratio` and
	// as a declared `r Ratio` parameter), so it lands in the float arm below and is refused there.
	function checkChainRangeIsMultiValued(scrutTag ValueTypeTag, isUpto bool, loStart ElementIndex, hiStart ElementIndex) throws SourceParseError
		// A `Character` scrutinee compares grapheme-cluster RECORDS, but its bounds are char literals
		// whose CODEPOINTS are the ordered domain the rule needs (`'a' upto 'b'` is adjacent). A
		// multi-codepoint cluster has no codepoint and therefore no successor, so no single-value question
		// can be asked of it — the rule does not apply rather than guessing an answer.
		if scrutTag == ValueTypeTag.character 'characterDomain'
			let hiDecoded = try self.charLiteralCodepoint(self.tokenAt(hiStart))

			match try self.charLiteralCodepoint(self.tokenAt(loStart)) 'lowerBound'
				cluster then return
				codepoint(low) then try self.requireCharRangeIsMultiValued(low, hiDecoded: hiDecoded, isUpto: isUpto, loStart: loStart)
			end 'lowerBound'

			return
		end 'characterDomain'

		// ⚠ **`floatOrderKey`, NOT THE RAW BITS.** `-0.0` and `+0.0` are two bit patterns for one VALUE, so
		// a bit compare would call `-0.0 to 0.0` a two-value range while the compare the arm emits matches
		// exactly one. Both references compare float VALUES for the same reason.
		if tagIsFloat(scrutTag) 'floatDomain'
			try self.requireRangeIsMultiValued(floatOrderKey(try self.floatBoundBits(loStart)), hi: floatOrderKey(try self.floatBoundBits(hiStart)), isUpto: isUpto, hasAdjacentValues: false, loStart: loStart)
		end 'floatDomain'
	end 'checkChainRangeIsMultiValued'

	// ⭐ **THE f64 BITS OF A FLOAT PATTERN BOUND, READ FROM ITS TOKENS** — `[-]? floatLiteral`, decoded by
	// the one float decoder every other bound uses and sign-flipped by the one `negatedFloatBits`.
	//
	// ⚠ **IT IS NOT `floatConstIsKnown` ON THE EMITTED VALUE, AND THAT DISTINCTION IS A LIVE HOLE.**
	// `recordBinOpFold` folds only INTEGER results, so a negated float bound emitted as `0.0 - x` through
	// `emitBinOp` is never a known float constant, and a check written against the value silently passes
	// `-1.0 to -1.0` while refusing `1.0 to 1.0`. The pattern is ONE literal (`parseNegatedFloatLiteral`),
	// and the tokens say what the author wrote whether or not the emitter folded it — so this reader has no
	// reason to go back to the value.
	//
	// ⚠ **ANY OTHER SHAPE IS AN INVARIANT BREAK, NOT A CASE TO SKIP.** `comparableOperands` ends
	// `tagIsFloat(left) == tagIsFloat(right)` (`IR/Maxon/TypeRules.maxon`), so an int, char, bool or string
	// bound against a float scrutinee is E2028 at `checkPatternType` before this is asked, and `min`/`max`
	// are consumed by the open-bound paths that never reach a closed range's check.
	function floatBoundBits(start ElementIndex) returns FullRangeInt throws SourceParseError
		let isNegated = self.kindAt(start) == TokenKind.minus
		let literalIndex = (start + 1) if isNegated else start
		let literalTok = self.tokenAt(literalIndex)

		if literalTok.kind != TokenKind.floatLiteral 'notAFloatLiteral'
			panic("Parser.floatBoundBits: a float scrutinee's range bound at token {literalIndex} is '{tokenDisplayText(literalTok)}', not a float literal — every other spelling is E2028 at `checkPatternType` before this is asked")
		end 'notAFloatLiteral'

		let bits = try self.floatLiteralBits(literalTok)
		return negatedFloatBits(bits) if isNegated else bits
	end 'floatBoundBits'

	// The upper half of the character domain's projection. Split out only because a `match` arm may not
	// open another block (E2049): with the lower bound's codepoint in hand, the upper bound decides by
	// exactly the same rule, and a cluster upper bound withdraws the question for the same reason.
	function requireCharRangeIsMultiValued(low FullRangeInt, hiDecoded CharLiteralCodepoint, isUpto bool, loStart ElementIndex) throws SourceParseError
		match hiDecoded 'upperBound'
			cluster then return
			codepoint(high) then try self.requireRangeIsMultiValued(low, hi: high, isUpto: isUpto, hasAdjacentValues: true, loStart: loStart)
		end 'upperBound'
	end 'requireCharRangeIsMultiValued'

	// Does `tok` name an open range bound (`min` / `max`) — an identifier whose text is the marker?
	// `min`/`max` lex as identifiers (they are not keywords), and appear only in a range, so their
	// text alone decides it. The bound-field constants spell the same two words the ranged-typealias
	// `.min` / `.max` do, deliberately: it is one lexical fact, not two.
	function isOpenBoundIdentifier(tok Token, marker ByteArray) returns bool
		return tok.kind == TokenKind.identifier and tok.value.equals(marker)
	end 'isOpenBoundIdentifier'

	// ============================================================================================
	// The match DISPATCH PLAN — normalized `[lo, hi]` intervals + strategy (chain vs binary search).
	//
	// A `match` over an integer-like scrutinee reduces every arm to `DispatchInterval`s here rather than
	// emitting a per-arm compare chain inline: the arm loop collects the intervals, `normalizeDispatchIntervals`
	// sorts and clips them, and `emitMatchDispatch` chooses the strategy and emits ALL the compares in one
	// place. A `String`/`float` match keeps `emitPatternCondition` (the linear chain), which is why that
	// path is untouched. NO new IR op — every compare is the same `compare`/`condBranch` the chain used.
	// ============================================================================================

	// Does this `match` build a binary-search DISPATCH PLAN, or keep the linear compare chain? An
	// enum/union tag is always an i64, so every enum match plans. A scalar match plans only when the
	// scrutinee is orderable as one signed i64 — `int`, `char` (a byte value), `bool`, `ExitCode`, or a
	// ranged-INT alias (`named`, told from a ranged-FLOAT alias by its declared backing, exactly as
	// `valueIsUnsigned` reads the alias registry). A `String` (no interval — its only comparison is a
	// runtime byte `==`) and a `float` (whose IEEE bits are not monotonic in value) keep the chain.
	function matchUsesIntervalPlan(isEnumMatch bool, scrut ValueId) returns bool
		if isEnumMatch 'enum'
			return true
		end 'enum'

		let scrutTag = self.tagOf(scrut)

		if tagIsInteger(scrutTag) or scrutTag == ValueTypeTag.boolean or scrutTag == ValueTypeTag.exitCode 'plainInteger'
			return true
		end 'plainInteger'

		if scrutTag == ValueTypeTag.named 'aliasScrutinee'
			let name = self.internedName(self.valueNameId(scrut))
			return match self.signatures.aliasOrInnerAliasOf(name, readerFilePath: self.job.path) 'a'
				declared(alias) gives not aliasIsFloat(alias)
				undeclared gives false
			end 'a'
		end 'aliasScrutinee'

		return false
	end 'matchUsesIntervalPlan'

	// One arm's SCALAR pattern (an integer-like scrutinee), reduced to DISPATCH INTERVALS. Mirrors
	// `emitPatternCondition`'s grammar — `or`-separated alternatives, each a value, a range, or an
	// open-ended range — but yields intervals over the pattern CONSTANTS rather than an emitted `or`-fold
	// of compares. The float/String path keeps `emitPatternCondition`, so this handles only what
	// `matchUsesIntervalPlan` gates in.
	function collectScalarPatternIntervals(scrut ValueId, seenValues SeenPatternValues, bodyBlockId BlockId, into DispatchIntervalArray) throws SourceParseError
		try self.collectScalarPatternAtom(scrut, seenValues: seenValues, bodyBlockId: bodyBlockId, into: into)

		while self.at(TokenKind.or) 'orChain'
			try self.consumeOrChainSeparator()
			try self.collectScalarPatternAtom(scrut, seenValues: seenValues, bodyBlockId: bodyBlockId, into: into)
		end 'orChain'
	end 'collectScalarPatternIntervals'

	// One alternative: an open-lower range (`min to/upto hi`), a closed/open-upper range (`lo to/upto hi`,
	// `lo to max`), or a single value. Appends exactly one interval.
	function collectScalarPatternAtom(scrut ValueId, seenValues SeenPatternValues, bodyBlockId BlockId, into DispatchIntervalArray) throws SourceParseError
		let startTok = self.current()
		let loStart = self.pos

		if self.isOpenBoundIdentifier(startTok, marker: MinBoundField) 'openLower'
			self.advance()
			try self.collectScalarRangeInterval(I64MinBound, loStart: loStart, scrut: scrut, bodyBlockId: bodyBlockId, into: into)
			return
		end 'openLower'

		let lo = try self.decodeScalarPatternBound(scrut)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			try self.collectScalarRangeInterval(lo, loStart: loStart, scrut: scrut, bodyBlockId: bodyBlockId, into: into)
			return
		end 'rangeArm'

		try self.recordDuplicateInt(lo, seenValues: seenValues, start: loStart, pastEnd: self.pos)
		into.push(DispatchInterval.create(lo, hi: lo, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create(0)))
	end 'collectScalarPatternAtom'

	// Consume a range upper (`to`/`upto <literal|max>`) with the cursor at the keyword, and push the arm's
	// interval `[lo, hi]` — UNLESS the range is empty, in which case the arm matches nothing and NO interval
	// is pushed, matching the always-false compare a chain would emit. `upto` is exclusive, so
	// its inclusive upper is `hi - 1` — computed ONLY once the range is known non-empty, because `upto
	// i64.min` is ALWAYS empty (nothing is below `i64.min`) and `i64.min - 1` would wrap to `i64.max`,
	// turning the empty range into a near-universal one. That underflow was a real miscompile: `0 upto
	// i64.min` matched every value ≥ 0 instead of nothing.
	function collectScalarRangeInterval(lo FullRangeInt, loStart ElementIndex, scrut ValueId, bodyBlockId BlockId, into DispatchIntervalArray) throws SourceParseError
		let isUpto = self.at(TokenKind.upto)
		self.advance()

		// `max` reads as `i64.max` inclusive under EITHER keyword (as `emitClosedRange`'s open-upper arm drops
		// the keyword), so `lo to/upto max` covers `[lo, i64.max]` and is never empty.
		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openUpper'
			self.advance()
			into.push(DispatchInterval.create(lo, hi: I64MaxBound, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create(0)))
			return
		end 'openUpper'

		let rawHi = try self.decodeScalarPatternBound(scrut)

		// An empty range contributes no interval — the arm body is left unreachable.
		if self.rangeIsEmpty(lo, hi: rawHi, isUpto: isUpto) 'emptyRange'
			return
		end 'emptyRange'

		// An OPEN lower bound (`min to X`) spans more than one value by construction, and the spec exempts
		// the open forms outright — asked through the same predicate the caller used to recognise it, so
		// "is this bound open?" is one question with one answer. (`X to max` already returned above.)
		// Reached only past the empty test, so `lo < rawHi` under `upto` and the successor cannot wrap.
		if not self.isOpenBoundIdentifier(self.tokenAt(loStart), marker: MinBoundField) 'closedLowerBound'
			try self.requireRangeIsMultiValued(lo, hi: rawHi, isUpto: isUpto, hasAdjacentValues: true, loStart: loStart)
		end 'closedLowerBound'

		let hi = (rawHi - 1) if isUpto else rawHi
		into.push(DispatchInterval.create(lo, hi: hi, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create(0)))
	end 'collectScalarRangeInterval'

	// Decode a single scalar pattern LITERAL — an int (optionally negated), a character, or a bool — to
	// its integer value, validating it is comparable to the scrutinee (E2028), WITHOUT emitting a
	// `literal` op: the dispatch materialises the constant later, once, as an immediate compare. The
	// float/String literal cases stay E2028 exactly as `emitPatternValue`'s do (only an integer-like
	// scrutinee reaches here); a `min`/`max` bound is the caller's, and any other identifier is
	// `refuseCasePatternOverAScalar`'s, as in `emitPatternValue`.
	function decodeScalarPatternBound(scrut ValueId) returns FullRangeInt throws SourceParseError
		let firstTok = self.current()

		if self.at(TokenKind.stringLiteral) 'stringPattern'
			throw SourceParseError.matchPatternTypeMismatch("String", scrutineeType: self.valueKindWord(scrut), line: firstTok.line, column: firstTok.column)
		end 'stringPattern'

		if self.at(TokenKind.floatLiteral) 'floatPattern'
			throw SourceParseError.matchPatternTypeMismatch(typeTagName(ValueTypeTag.float), scrutineeType: self.valueKindWord(scrut), line: firstTok.line, column: firstTok.column)
		end 'floatPattern'

		if self.at(TokenKind.minus) 'negated'
			try self.consume(TokenKind.minus)

			if self.at(TokenKind.floatLiteral) 'negFloat'
				throw SourceParseError.matchPatternTypeMismatch(typeTagName(ValueTypeTag.float), scrutineeType: self.valueKindWord(scrut), line: firstTok.line, column: firstTok.column)
			end 'negFloat'

			if not self.at(TokenKind.intLiteral) 'nonNumeric'
				let operandTok = self.current()
				throw SourceParseError.nonNumericNegation(operandTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
			end 'nonNumeric'

			let intTok = try self.consume(TokenKind.intLiteral)
			let value = try self.intLiteralValue(intTok, negated: true)
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.integer, scrut: scrut, patternTok: firstTok)
		end 'negated'

		if self.at(TokenKind.intLiteral) 'intPattern'
			let intTok = try self.consume(TokenKind.intLiteral)
			let value = try self.intLiteralValue(intTok, negated: false)
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.integer, scrut: scrut, patternTok: firstTok)
		end 'intPattern'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolPattern'
			let value = 1 as FullRangeInt if self.at(TokenKind.true) else 0 as FullRangeInt
			self.advance()
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.boolean, scrut: scrut, patternTok: firstTok)
		end 'boolPattern'

		if self.at(TokenKind.charLiteral) 'charPattern'
			let charTok = try self.consume(TokenKind.charLiteral)
			let value = try self.decodeCharPatternValue(charTok, scrut: scrut)
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.integer, scrut: scrut, patternTok: firstTok)
		end 'charPattern'

		if self.at(TokenKind.identifier) 'enumCasePattern'
			try self.refuseCasePatternOverAScalar(scrut, patternTok: firstTok)
		end 'enumCasePattern'

		throw SourceParseError.expectedExpression(expressionOperandDisplayText(firstTok), line: firstTok.line, column: firstTok.column)
	end 'decodeScalarPatternBound'

	function deferredCasePattern() returns ValueId throws SourceParseError
		try self.consume(TokenKind.identifier)

		while self.at(TokenKind.dot) 'qualifiedCase'
			try self.consume(TokenKind.dot)
			try self.consume(TokenKind.identifier)
		end 'qualifiedCase'

		if self.at(TokenKind.leftParen) 'payloadBindings'
			for nameTok in try self.parseBindingNameList(CheckedBindingNames.every) 'eachBinding'
				if not nameTok.value.equals(DiscardBindingName) 'aRealBinding'
					self.deferredPatternBindings.push(nameTok)
				end 'aRealBinding'
			end 'eachBinding'
		end 'payloadBindings'

		return self.mintDeferredValue()
	end 'deferredCasePattern'

	function takeDeferredPatternBindings() returns TokenArray
		let taken = self.deferredPatternBindings
		self.deferredPatternBindings = TokenArray.create(0)

		return taken
	end 'takeDeferredPatternBindings'

	function declareDeferredPatternBindings(names TokenArray) throws SourceParseError
		for nameTok in names 'eachBinding'
			try self.declareInitializedBinding(nameTok, value: self.mintDeferredValue(), sourceName: SourceBinding.none, sourceReadsAField: false, kind: BindingKind.let)
		end 'eachBinding'
	end 'declareDeferredPatternBindings'

	function refuseCasePatternOverAScalar(scrut ValueId, patternTok Token) throws SourceParseError
		try self.requireDeclaredBaseTypeName(self.tagOf(scrut), nameId: self.valueNameId(scrut), tok: patternTok)

		throw SourceParseError.unsupported("a match pattern naming '{String.from(patternTok.value)}' (a match over a scalar takes only literal, range, and 'or' patterns)", line: patternTok.line, column: patternTok.column)
	end 'refuseCasePatternOverAScalar'

	// A pattern bound must be comparable to the scrutinee — the interval twin of `checkPatternType`,
	// asked over a decoded value + its tag rather than an emitted ValueId, so the failure is the same
	// match-specific E2028.
	function checkScalarPatternBound(value FullRangeInt, valTag ValueTypeTag, scrut ValueId, patternTok Token) returns FullRangeInt throws SourceParseError
		if not comparableOperands(self.tagOf(scrut), right: valTag) 'mismatch'
			throw SourceParseError.matchPatternTypeMismatch(typeTagName(valTag), scrutineeType: self.valueKindWord(scrut), line: patternTok.line, column: patternTok.column)
		end 'mismatch'

		return value
	end 'checkScalarPatternBound'

	// ============================================================================================
	// ENUM `match` — case-name patterns and coverage.
	//
	// Everything here feeds the SAME dispatch engine the scalar match uses (`parseMatchCommon`'s arm
	// loop, `condBranch` chain and merge): the only difference is that a pattern is a case NAME
	// resolved to a tag rather than a literal, and that coverage is a bitmap over the case set rather
	// than a default arm. NO new IR op — a case compare is the same `compare`/`condBranch` a scalar
	// arm emits.
	// ============================================================================================

	// The enum/union a match scrutinee belongs to, or `undeclared` for a scalar scrutinee. Read from
	// the scrutinee's TYPE — a `named(X)` value whose name is in the enum registry — so it works
	// uniformly for a parameter (`c Code`), a local (`let c = Color.red`) and a returned enum. The
	// enum's own name is on the value even after TypeResolution collapses the SIGNATURE type to
	// `integer`, because a value's tag is set by the parser and never rewritten.
	//
	// ⚠ The value→NAME projection is `valueNameId` + `internedName`, the two named helpers, and NOT a
	// second hand-inlined copy of the same two column reads. `valueIsUnion`
	// below and `valueIsFloatBackedEnum` ask the SAME projection of the same value; a fallback
	// added to one spelling and not the other would answer "not an enum" at one door and "enum" at the
	// next, which is a wrong answer at a use site rather than an error anywhere.
	function enumMatchFor(scrut ValueId) returns DeclaredEnum
		return self.declaredEnumOfType(self.tagOf(scrut), nameId: self.valueNameId(scrut))
	end 'enumMatchFor'

	function declaredEnumOfType(tag ValueTypeTag, nameId TypeNameId) returns DeclaredEnum
		if tag != ValueTypeTag.named 'notNamed'
			return DeclaredEnum.undeclared
		end 'notNamed'

		return self.signatures.enumFor(self.internedName(nameId), readerFilePath: self.job.path)
	end 'declaredEnumOfType'

	// Is `value` a `union` value — a `named(X)` whose type is a declared `union`? The E3066 gate
	// (`emitCompare`). A payload-free ENUM is `false` (its value is a plain tag that `==` may compare);
	// only `isUnion` is a union. The `named` test is what tells a union from a struct, which
	// `numberTagOf` also answers `structRef` for.
	//
	// ⚠ **ANSWERED THROUGH `numberTagOf`, NEVER THROUGH `enumMatchFor`, AS A HOT-PATH ALLOCATION GUARD.**
	// This runs for BOTH operands of EVERY comparison in the program, and `enumMatchFor` returns a
	// `DeclaredEnum` — a Maxon union VALUE, which is a heap object for its `undeclared` case as much as
	// any other. So asking it of an `int`/`bool` operand (the overwhelming majority) would allocate two
	// throwaway `DeclaredEnum.undeclared` boxes per compare, scaling with the program: scale-test
	// charged exactly that (+1,257 allocs on rung 0, doubling per rung). A value can only be a union if
	// its tag is `named`, and that test is a scalar column read that allocates nothing. `numberTagOf`
	// then reads the registry's layout through `enumOperandTagFor`, which boxes no `DeclaredEnum`.
	function valueIsUnion(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.named and self.numberTagOf(value) == ValueTypeTag.structRef
	end 'valueIsUnion'

	// Is `value` a payload-bearing enum/union (a box or a tagged word) — a `named(X)` whose layout
	// `carriesPayloads`? `valueIsUnion`'s twin, differing only in the layout bit it reads:
	// `carriesPayloads` (a record exists), not `isUnion` (a union vs a bare enum). It is what tells a
	// call RESULT that owns a heap record (a payload-bearing union `make()`, adopted by the caller)
	// from a payload-free enum value (a bare i64 tag, dropped by no one) — a distinction the tag alone
	// cannot make, since both are `named`. The same `named` tag pre-check is the hot-path allocation
	// guard `valueIsUnion` documents.
	function valueIsBoxedUnion(value ValueId) returns bool
		if self.tagOf(value) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		let nameId = self.valueNameId(value)

		match self.memos.boxedUnionAnswers.answerFor(nameId) 'answer'
			boxed then return true
			notBoxed then return false
			unasked then break
		end 'answer'

		let decl = self.enumMatchFor(value)
		let boxed = enumMatchIsDeclared(decl) and requireEnumLayout(decl).carriesPayloads()

		self.memos.boxedUnionAnswers.file(nameId, boxed: boxed)
		return boxed
	end 'valueIsBoxedUnion'

	// One arm's enum pattern, reduced to DISPATCH INTERVALS over the case tags.
	// Alternatives (`red or blue`) each contribute their interval(s); an enum/union tag is an i64, so an
	// enum arm ALWAYS feeds the interval plan, and the per-case `== tag` compare is emitted later — once —
	// by the dispatch itself.
	//
	// ⚠ **THE BINDINGS ARE ONE LIST FOR THE WHOLE ARM BECAUSE THEY LOAD AT ONE PLACE** — the head of the
	// single body block every alternative branches to (`parseMatchCommon` → `declarePayloadBindings`) —
	// so they are read on EVERY covered case's path, not just the one whose alternative declared them.
	// `requireArmBindingsAreDistinct` and `requireOrArmPayloadSlotsAgree` together make an arm that binds
	// a payload cover exactly one case.
	//
	// `intervalMark` is the arm's own slice of the interval plan — `into` accumulates across ALL arms, so it
	// is what says which intervals, i.e. which cases, belong to THIS arm. It is PASSED IN rather than
	// recomputed here: the caller already holds the identical value for its own edge-arg stamp, and two
	// derivations agreeing only because nothing pushes between them is not an invariant. If they diverged,
	// E3129 would check cases the arm does not cover (or miss ones it does) while phi args landed on the
	// wrong edges.
	//
	// ⭐ **A SYNTHESIZED ERROR UNION'S ARM IS PARSED HERE TOO** — only an alternative's resolution differs
	// (`collectEnumPatternAlternative`), so the chain, the binding rules and the fold are one grammar for both.
	function collectEnumPatternIntervals(table EnumArmTable, covered BoolArray, bodyBlockId BlockId, into DispatchIntervalArray, intervalMark ElementIndex) returns EnumPatternArm throws SourceParseError
		let bindings = PayloadBindingArray.create(0)
		let members = TryBlockErrorMemberArray.create(0)
		try self.collectEnumPatternAlternative(table, covered: covered, bodyBlockId: bodyBlockId, into: into, bindings: bindings, members: members)

		while self.at(TokenKind.or) 'orChain'
			try self.consumeOrChainSeparator()
			try self.collectEnumPatternAlternative(table, covered: covered, bodyBlockId: bodyBlockId, into: into, bindings: bindings, members: members)
		end 'orChain'

		let payloadEnum = armPayloadEnumOf(table, members: members)
		let arm = EnumPatternArm.create(bindings, members: members, payloadEnum: payloadEnum)

		// Both halves of E3129, in the order their answers depend on: whether the arm's bindings are a
		// bijection is a fact about the arm ALONE, and settling it first means the agreement walk below never
		// has to reason about which of two bindings of one slot it is talking about.
		try self.requireArmBindingsAreDistinct(arm.bindings)
		try self.requireOrArmPayloadSlotsAgree(arm, into: into, intervalMark: intervalMark)
		self.foldEnumCaseRun(enumArmDispatchLayout(table), into: into, intervalMark: intervalMark, bindings: arm.bindings, bodyBlockId: bodyBlockId)
		return arm
	end 'collectEnumPatternIntervals'

	// One alternative of an enum arm, resolved against its table.
	function collectEnumPatternAlternative(table EnumArmTable, covered BoolArray, bodyBlockId BlockId, into DispatchIntervalArray, bindings PayloadBindingArray, members TryBlockErrorMemberArray) throws SourceParseError
		match table 't'
			declared(layout) then try self.collectEnumPatternAtomIntervals(layout, covered: covered, bodyBlockId: bodyBlockId, into: into, bindings: bindings)
			errorUnion(info) then try self.collectErrorUnionPatternAtom(info, covered: covered, bodyBlockId: bodyBlockId, into: into, bindings: bindings, members: members)
		end 't'
	end 'collectEnumPatternAlternative'

	// The table an arm of this match resolves against. Asked only of an enum match.
	function enumArmTable(enumMatch DeclaredEnum, errorUnion ErrorUnionMatch) returns EnumArmTable
		if errorUnionIsSynthesized(errorUnion) 'anErrorUnion'
			return EnumArmTable.errorUnion(requireErrorUnionInfo(errorUnion))
		end 'anErrorUnion'

		return EnumArmTable.declared(requireEnumLayout(enumMatch))
	end 'enumArmTable'

	// ⭐⭐ **AN ARM'S ALTERNATIVES BECOME ONE RANGE COMPARE WHERE THAT MEANS THE SAME SET.** Each
	// alternative arrives as its own point interval, so a twenty-case arm would otherwise be twenty
	// compares (or twenty leaves) where two say the same thing.
	//
	// ⭐ The whole condition is that NO CASE THE ARM DOES NOT NAME has a tag inside the span of the tags
	// it does — the proof the emitted compare needs, since a range tests the VALUE and cannot know which
	// values are declared. `low = 10  medium = 20` folds because `high = 30` is outside; `ok = 500
	// notFound = 200` does not, because an uncovered `serverError = 404` sits inside the span.
	// Declaration CONTIGUITY is not a separate question: an arm that skips a case leaves that case's tag
	// inside its own span, so the span test already refuses it.
	//
	// ⚠ **A LOWERING CHOICE, NOT A MEANING.** Coverage and overlap were settled from the NAMES as the
	// chain was parsed, before this runs — which is exactly what a case RANGE could not say. A case added
	// to the enum is not in this arm's list, so E2026 still fires; the fold cannot absorb it. An arm that
	// binds a payload never folds, because a range binds nothing.
	function foldEnumCaseRun(layout EnumLayout, into DispatchIntervalArray, intervalMark ElementIndex, bindings PayloadBindingArray, bodyBlockId BlockId)
		if bindings.count() > 0 or into.count() - intervalMark < 2 'nothingToFold'
			return
		end 'nothingToFold'

		let firstSeg = try into.get(intervalMark) otherwise panic("foldEnumCaseRun: into.get OOB at the arm's own mark")
		var loTag = firstSeg.lo
		var hiTag = loTag
		var i = intervalMark

		while i < into.count() 'eachInterval'
			let seg = try into.get(i) otherwise panic("foldEnumCaseRun: into.get OOB at {i} below its own count")

			// Only an untouched run of POINT intervals folds; anything wider is already a range.
			if seg.lo != seg.hi or seg.targetBlockId != bodyBlockId 'notAPointOfThisArm'
				return
			end 'notAPointOfThisArm'

			if seg.lo < loTag 'newLo'
				loTag = seg.lo
			end 'newLo'

			if seg.lo > hiTag 'newHi'
				hiTag = seg.lo
			end 'newHi'

			i = i + 1
		end 'eachInterval'

		for j in 0 upto layout.caseCount() 'eachCase'
			let tag = self.dispatchTagOfIndex(layout, index: j)

			if tag < loTag or tag > hiTag 'outsideTheSpan'
				continue
			end 'outsideTheSpan'

			if not self.armNamesTag(into, intervalMark: intervalMark, tag: tag) 'foreignTagInside'
				return
			end 'foreignTagInside'
		end 'eachCase'

		while into.count() > intervalMark 'dropPoints'
			_ = try into.pop() otherwise panic("foldEnumCaseRun: into.pop on a list whose count exceeds the mark")
		end 'dropPoints'

		into.push(DispatchInterval.create(loTag, hi: hiTag, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create(0)))
	end 'foldEnumCaseRun'

	// Does one of the arm's own point intervals stand at `tag`? Asked only of tags inside the arm's span,
	// so the scan is over that arm's alternatives rather than the whole match.
	function armNamesTag(into DispatchIntervalArray, intervalMark ElementIndex, tag FullRangeInt) returns bool
		var i = intervalMark

		while i < into.count() 'eachInterval'
			let seg = try into.get(i) otherwise panic("armNamesTag: into.get OOB at {i} below its own count")

			if seg.lo == tag 'named'
				return true
			end 'named'

			i = i + 1
		end 'eachInterval'

		return false
	end 'armNamesTag'

	// ⛔⛔ **AN ARM'S PAYLOAD BINDINGS MUST BE A BIJECTION — ONE NAME PER SLOT, ONE SLOT PER NAME.** The two
	// halves are one rule because they are one mechanism read from its two ends: `declarePayloadBindings`
	// walks this list emitting a LOAD, a scope DECLARATION and an ACQUISITION per entry. The list is indexed
	// by SLOT and the scope is keyed by NAME (`Scope.install` overwrites), so a repeat on EITHER axis makes
	// the arm body see something no alternative asked for — and each axis was MEASURED wrong:
	//
	//   • **TWO BINDINGS, ONE SLOT** (`shout(msg) or speak(msg)`) — two loads and two acquisitions against
	//     one slot. On a sole-owned scrutinee the acquisition is `moveOutManagedPayload`: the first entry
	//     takes the String and NULLS slot 0, the second reads the slot it just emptied and takes ownership
	//     of null, and the second declaration is the one in scope. **0xC0000005, no output**, against a
	//     CONTROL (same union, same sole-owned scrutinee, same payload, one case per arm) that exits 0.
	//   • **ONE NAME, TWO SLOTS** (`walk(dir) or run(_, dir)`) — passes every SLOT test (the slots differ,
	//     and the discard makes `run(_, dir)` spellable), so only the name axis can catch it. The second
	//     `install` silently wins: MEASURED `walk=0` where 7 was stored, and its managed twin
	//     (`shout(_, msg) or speak(msg, _)`) yielded the wrong FIELD with refcounts balanced — a wrong
	//     answer with no crash and no leak, the worst shape here.
	//
	// ⚠ **NEITHER IS ONLY A CRASH, WHICH IS WHY BOTH ARE REFUSED FOR EVERY PAYLOAD TYPE.** The scalar
	// spelling `walk(a) or run(b) gives a + b` does not fault — it quietly answers `10` for `walk(5)`,
	// because both names read the one slot — and a rule that admitted what merely misleads while refusing
	// what faults would be two rules for one mistake.
	//
	// ⭐ **IT IS CHECKED OVER THE ARM'S FINISHED LIST, WHICH IS WHY ONE CHECK SERVES TWO DOORS.** The name
	// axis is not an or-arm property at all: a SINGLE case's own list had the identical hole
	// (`walk(x, x)` — `parseCasePayloadBindings` never compared its names either), and an arm's list is the
	// only place both are visible. So the error-union arm asks through here too, and neither door needs its
	// own copy. Discards are skipped on both axes: `_` emits no load and installs no name, so it can
	// contest nothing.
	function requireArmBindingsAreDistinct(bindings PayloadBindingArray) throws SourceParseError
		for i in 0 upto bindings.count() 'eachBinding'
			let binding = try bindings.get(i) otherwise panic("requireArmBindingsAreDistinct: bindings.get OOB at {i} on a range walked to the array's own count")

			if binding.isDiscard 'readsNothing'
				continue
			end 'readsNothing'

			// Positioned at the SECOND binding throughout — the token the author must rename or delete.
			for j in 0 upto i 'eachEarlier'
				let earlier = try bindings.get(j) otherwise panic("requireArmBindingsAreDistinct: bindings.get OOB at {j}, below the outer index")

				if earlier.isDiscard 'installsNothing'
					continue
				end 'installsNothing'

				if earlier.slot == binding.slot 'oneSlotBoundTwice'
					throw SourceParseError.matchArmPayloadBindingConflict(String.from(binding.nameTok.value), reason: "payload slot {binding.slot} is already bound by '{String.from(earlier.nameTok.value)}' in this arm. An arm's alternatives share one slot region and one arm body, so binding a slot twice loads the same value twice — and for a managed payload out of a scrutinee this frame owns, moves it out of the box twice and leaves the arm holding null. Give each case an arm of its own", line: binding.nameTok.line, column: binding.nameTok.column)
				end 'oneSlotBoundTwice'

				if earlier.nameTok.value.equals(binding.nameTok.value) 'oneNameBoundTwice'
					throw SourceParseError.matchArmPayloadBindingConflict(String.from(binding.nameTok.value), reason: "this arm already binds the name '{String.from(earlier.nameTok.value)}', at payload slot {earlier.slot} rather than slot {binding.slot}. The arm body has ONE binding of that name — the later one silently wins — so on the path of the case that fills slot {earlier.slot} the body would read slot {binding.slot} instead. Give the two payloads different names", line: binding.nameTok.line, column: binding.nameTok.column)
				end 'oneNameBoundTwice'
			end 'eachEarlier'
		end 'eachBinding'
	end 'requireArmBindingsAreDistinct'

	// ⭐⭐ **EVERY CASE AN ARM COVERS MUST BIND WHAT THE ARM'S BINDINGS READ (E3129).** The bindings are
	// loaded once, unconditionally, at the head of the arm BODY, and every alternative of an `or`-chain
	// branches to that one body — so the load runs on the path of every covered case. A case that binds
	// nothing at the slot, payload-less or named bare, would hand the body a value no pattern bound, so
	// each binding is admitted only on its own case's path.
	//
	// The arm body is compiled ONCE and its binding has ONE type, so no per-alternative edge can make one
	// name mean a String on one incoming edge and an integer on another; the honest answer is a refusal,
	// as it is for the related hazard one construct over (`rejectFallthroughIntoBindingArm`).
	//
	// Vacuous for a single-case arm — `walk(dir)` covers only `walk`, which declares the slot it binds — so
	// the rule is stated once for every enum arm rather than behind an "is this an or-chain" test.
	//
	// ⛔ **AN ERROR-UNION ARM NAMING SEVERAL MEMBERS BINDS NOTHING.** Each member lays out its own value — a
	// union's is a box with its own slots, an enum's an ordinal with none — so a slot of one is no slot of
	// another.
	function requireOrArmPayloadSlotsAgree(arm EnumPatternArm, into DispatchIntervalArray, intervalMark ElementIndex) throws SourceParseError
		if arm.bindings.count() == 0 'bindsNothing'
			return
		end 'bindsNothing'

		if arm.members.count() > 1 'severalMembers'
			// Anchored at a binding that reads: a `_` reads no slot, and every alternative that binds names at
			// least one that does (E3081).
			for binding in arm.bindings 'firstReading'
				if not binding.isDiscard 'reads'
					throw SourceParseError.matchArmPayloadBindingConflict(String.from(binding.nameTok.value), reason: "this arm names cases of more than one error type, and its bindings read slots of one type's value, which a case of another type does not hold. Give each error type an arm of its own", line: binding.nameTok.line, column: binding.nameTok.column)
				end 'reads'
			end 'firstReading'

			panic("requireOrArmPayloadSlotsAgree: an arm with bindings holds no binding that reads — parseCasePayloadBindings refuses an all-discard list")
		end 'severalMembers'

		let layout = requireEnumLayout(arm.payloadEnum)

		for ci in 0 upto layout.caseCount() 'eachCase'
			if not self.armCoversTag(self.armDispatchTagOf(arm, payloadLayout: layout, index: ci), into: into, intervalMark: intervalMark) 'anotherArmsCase'
				continue
			end 'anotherArmsCase'

			for binding in arm.bindings 'eachBinding'
				// A `_` reads nothing, so no case has to hold anything for it.
				if binding.isDiscard 'discarded'
					continue
				end 'discarded'

				try self.requireCaseHoldsBoundSlot(layout, caseIndex: ci, binding: binding)
			end 'eachBinding'
		end 'eachCase'
	end 'requireOrArmPayloadSlotsAgree'

	// The tag the dispatch plan holds for case `index` of the arm's payload layout: the case's own tag for a
	// declared enum, shifted onto the fused line for an error union's one member.
	function armDispatchTagOf(arm EnumPatternArm, payloadLayout EnumLayout, index CaseIndex) returns FullRangeInt
		if arm.members.count() == 0 'aDeclaredEnum'
			return self.dispatchTagOfIndex(payloadLayout, index: index)
		end 'aDeclaredEnum'

		let member = try arm.members.get(0) otherwise panic("armDispatchTagOf: members.get OOB at 0 after the count guard")
		return fusedCaseTag(payloadLayout.tagOfIndex(index), offset: member.fusedTagOffset)
	end 'armDispatchTagOf'

	// Does this tag route to THIS arm — i.e. does it fall in one of the intervals the arm just contributed?
	// Read off the interval plan rather than collected a second time as the atoms are parsed, because the
	// plan IS the arm's coverage, and a parallel case list would be that fact recorded twice. Tags are unique
	// per case, so tag membership and case membership are the same question.
	function armCoversTag(tag FullRangeInt, into DispatchIntervalArray, intervalMark ElementIndex) returns bool
		for k in intervalMark upto into.count() 'eachInterval'
			let interval = try into.get(k) otherwise panic("armCoversTag: intervals.get OOB at {k} on a range walked to the array's own count")

			if tag >= interval.lo and tag <= interval.hi 'covered'
				return true
			end 'covered'
		end 'eachInterval'

		return false
	end 'armCoversTag'

	function requireCaseHoldsBoundSlot(layout EnumLayout, caseIndex CaseIndex, binding PayloadBinding) throws SourceParseError
		if binding.caseIndex == caseIndex 'thisCaseBindsIt'
			return
		end 'thisCaseBindsIt'

		let caseName = String.from(layout.caseNameAt(caseIndex))
		throw SourceParseError.matchArmPayloadBindingConflict(String.from(binding.nameTok.value), reason: "case '{caseName}' of `{layout.kindWord()} {String.from(layout.name)}` binds nothing at payload slot {binding.slot}, so on that case's path the arm body would read a value no pattern bound. Give '{caseName}' an arm of its own", line: binding.nameTok.line, column: binding.nameTok.column)
	end 'requireCaseHoldsBoundSlot'

	// One alternative: a single case (`red`, or `walk(dir)` binding its payload) or a case-name range
	// (`low to high`, `low upto high`). Only the single-case form may carry payload bindings — a range
	// names no one case whose payload fields a binding list could resolve against. Appends the covered case
	// tag(s) as point/range intervals into `into`, and any bindings onto the ARM's list (see the caller:
	// the alternatives share one list because they share one body block).
	function collectEnumPatternAtomIntervals(layout EnumLayout, covered BoolArray, bodyBlockId BlockId, into DispatchIntervalArray, bindings PayloadBindingArray) throws SourceParseError
		let patternTok = self.current()
		let loStart = self.pos
		let lowIndex = try self.resolveEnumArmCase(layout)

		// ⭐ **A RANGE OF CASES IS NOT A PATTERN — an arm names every case it covers.** A range meant the
		// cases whose DECLARATION POSITION fell in its span, so a case appended inside that span was
		// absorbed silently and `checkEnumExhaustive` never fired: the arm handled a case nobody had
		// decided about. Naming each case is what makes E2026 point at every match site when an enum grows.
		//
		// ⚠ **REFUSED BEFORE THE UPPER BOUND IS RESOLVED**, so `red to nope` is this and not
		// `enumUnknownCase` — the range is the mistake whichever name follows it. The upper token is
		// stepped over only to put it inside the quoted span, never to look it up.
		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			self.advance()

			if tokenCanBeAName(self.current()) 'upperName'
				self.advance()
			end 'upperName'

			throw SourceParseError.matchEnumCaseRange(self.tokenTextFrom(loStart, endIndex: self.pos), line: patternTok.line, column: patternTok.column)
		end 'rangeArm'

		if self.at(TokenKind.leftParen) 'payloadBind'
			let atomBindings = try self.parseCasePayloadBindings(layout, caseIndex: lowIndex, caseTok: patternTok)

			for binding in atomBindings 'appendEach'
				bindings.push(binding)
			end 'appendEach'
		end 'payloadBind'

		try self.requireLinearPayloadsAreBound(layout, caseIndex: lowIndex, bindings: bindings, patternTok: patternTok)
		try self.markEnumCovered(covered, index: lowIndex, layout: layout, patternTok: patternTok)
		let tag = self.dispatchTagOfIndex(layout, index: lowIndex)
		into.push(DispatchInterval.create(tag, hi: tag, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create(0)))
	end 'collectEnumPatternAtomIntervals'

	// ⭐⭐ **ONE ALTERNATIVE OF AN ARM OF A MATCH ON A SYNTHESIZED ERROR UNION.** The union path's twin of
	// `collectEnumPatternAtomIntervals`: one `(member, case)` pair, its payload bindings parsed against that
	// member's layout, and the member recorded once on the arm's list. It has no case RANGE — a range over the
	// fused line would span two enums' cases, which is not a thing an author can mean.
	//
	// ⭐ **BOTH SPELLINGS OF THE PATTERN, and the qualified one is why `resolveEnumArmCase` could not serve.**
	// That routine REFUSES `Enum.case` (E3075: the scrutinee's enum is already known, so the bare name
	// suffices) — which is exactly backwards here, where the qualifier is the only way to say which member's
	// `notFound` is meant. So: `Member.case` resolves against that member, a bare `case` resolves across all
	// members and is E3085 when two of them share the name.
	function collectErrorUnionPatternAtom(info ErrorUnionInfo, covered BoolArray, bodyBlockId BlockId, into DispatchIntervalArray, bindings PayloadBindingArray, members TryBlockErrorMemberArray) throws SourceParseError
		let firstTok = self.current()
		let armStart = self.pos

		if not tokenCanBeAName(firstTok) 'notACaseName'
			throw SourceParseError.expectedExpression(expressionOperandDisplayText(firstTok), line: firstTok.line, column: firstTok.column)
		end 'notACaseName'

		// The CASE-name token — the qualified spelling's second half, and the anchor every diagnostic below
		// uses. It is resolved before anything is consumed so the two spellings differ in one place only.
		let qualified = self.kindAt(self.pos + 1) == TokenKind.dot
		let caseTok = self.tokenAt(self.pos + 2) if qualified else firstTok

		if not tokenCanBeAName(caseTok) 'notACaseNameAfterTheDot'
			throw SourceParseError.expectedExpression(expressionOperandDisplayText(caseTok), line: caseTok.line, column: caseTok.column)
		end 'notACaseNameAfterTheDot'

		var index = 0 as CaseIndex

		if qualified 'qualified'
			self.advance()
			try self.consume(TokenKind.dot)
			self.advance()
			index = try self.errorUnionQualifiedCaseIndex(info, memberTok: firstTok, caseTok: caseTok)
		end 'qualified' else 'bare'
			self.advance()
			index = try self.errorUnionBareCaseIndex(info, caseTok: caseTok)
		end 'bare'

		// Asked HERE rather than left to the arm separator, so the diagnostic names the range and not a missing
		// `then`.
		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'caseRange'
			self.advance()

			if tokenCanBeAName(self.current()) 'upperName'
				self.advance()
			end 'upperName'

			throw SourceParseError.matchEnumCaseRange(self.tokenTextFrom(armStart, endIndex: self.pos), line: firstTok.line, column: firstTok.column)
		end 'caseRange'

		let member = try info.caseMembers.get(index) otherwise panic("collectErrorUnionPatternAtom: caseMembers.get OOB at {index} — every resolver above returns an index into this column")
		let memberCaseIndex = try member.layout.indexOfCase(info.layout.caseNameAt(index)) otherwise panic("collectErrorUnionPatternAtom: `{String.from(member.layout.name)}` declares no case '{String.from(info.layout.caseNameAt(index))}' — an error union's cases are its members' own cases, so every case it lists belongs to the member it lists it under")

		if self.at(TokenKind.leftParen) 'payloadBind'
			// ⚠ **THE ARITY IS CHECKED BEFORE THE LIST IS PARSED, because E3035's ANCHOR is the case name
			// and the generic parse has already walked past it** — and because the message names the member
			// (`'ErrA.bad' expects 2`), which only this path can spell. Everything the check passes then
			// goes through the SHARED parse, so the discard rule (E3081) and the binding records are the
			// ordinary ones.
			try self.requireErrorUnionBindingCount(member, caseIndex: memberCaseIndex, caseTok: caseTok)
			let atomBindings = try self.parseCasePayloadBindings(member.layout, caseIndex: memberCaseIndex, caseTok: caseTok)

			for binding in atomBindings 'appendEach'
				bindings.push(binding)
			end 'appendEach'
		end 'payloadBind'

		noteArmMember(members, member: member)
		try self.markEnumCovered(covered, index: index, layout: info.layout, patternTok: caseTok)
		let tag = info.layout.tagOfIndex(index)
		into.push(DispatchInterval.create(tag, hi: tag, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create(0)))
	end 'collectErrorUnionPatternAtom'

	// `Member.case` — the fused index of that pair. Both halves are E3034 with their own sentences: a
	// qualifier naming no member of THIS union, and a member that has no such case.
	function errorUnionQualifiedCaseIndex(info ErrorUnionInfo, memberTok Token, caseTok Token) returns CaseIndex throws SourceParseError
		var namesTheMember = false
		var memberKindWord = ""

		for i in 0 upto info.layout.caseCount() 'eachCase'
			let member = try info.caseMembers.get(i) otherwise panic("errorUnionQualifiedCaseIndex: caseMembers.get OOB at {i} — the column is built case for case beside the layout's own")

			if not member.name.equals(memberTok.value) 'anotherMember'
				continue
			end 'anotherMember'

			namesTheMember = true
			memberKindWord = member.layout.kindWord()

			if info.layout.caseNameAt(i).equals(caseTok.value) 'found'
				return i
			end 'found'
		end 'eachCase'

		if not namesTheMember 'notAMember'
			throw SourceParseError.errorUnionUnknownMember(String.from(memberTok.value), line: memberTok.line, column: memberTok.column)
		end 'notAMember'

		// The KIND WORD is the MEMBER's own — `ErrA.nope` on a scalar `enum ErrA` must not read "unknown union
		// case". `memberKindWord` is set beside `namesTheMember` above, on the same pass, so the two cannot
		// disagree about which member was found.
		throw SourceParseError.enumUnknownCase(memberKindWord, caseName: "{String.from(memberTok.value)}.{String.from(caseTok.value)}", line: caseTok.line, column: caseTok.column)
	end 'errorUnionQualifiedCaseIndex'

	// A BARE `case` — the fused index of the one member that declares it, **E3085 when two do**. The
	// ambiguity is the whole reason the qualified spelling exists, and it is scanned rather than precomputed
	// into a map for `EnumLayout.indexOfCase`'s reason: a union's case count is tiny, and a map would be a
	// second index of the one column above it.
	function errorUnionBareCaseIndex(info ErrorUnionInfo, caseTok Token) returns CaseIndex throws SourceParseError
		var found = info.layout.caseCount()

		for i in 0 upto info.layout.caseCount() 'eachCase'
			if not info.layout.caseNameAt(i).equals(caseTok.value) 'anotherCase'
				continue
			end 'anotherCase'

			if found < info.layout.caseCount() 'sharedByTwoMembers'
				throw SourceParseError.errorUnionAmbiguousBareCase(String.from(caseTok.value), line: caseTok.line, column: caseTok.column)
			end 'sharedByTwoMembers'

			found = i
		end 'eachCase'

		if found >= info.layout.caseCount() 'noSuchCase'
			throw SourceParseError.errorUnionUnknownCase(String.from(caseTok.value), line: caseTok.line, column: caseTok.column)
		end 'noSuchCase'

		return found
	end 'errorUnionBareCaseIndex'

	// **E3035 — the binding count an error-union pattern supplies against the case's declared arity**, read
	// off the TOKENS because the anchor is the case name and the shared parse consumes past it. The count is
	// exact: a binding list is `( name [, name]* )` and every element is a single identifier (or `_`), so the
	// identifiers between the parens ARE the bindings.
	function requireErrorUnionBindingCount(member TryBlockErrorMember, caseIndex CaseIndex, caseTok Token) throws SourceParseError
		let declaredPayloads = member.layout.payloadsAt(caseIndex)
		let declared = serviceParamIndexOfPayload(declaredPayloads, slot: declaredPayloads.count()) as PayloadSlotIndex
		var supplied = 0 as ElementIndex
		var scan = self.pos + 1

		while self.kindAt(scan) != TokenKind.rightParen and self.kindAt(scan) != TokenKind.eof 'countNames'
			if self.kindAt(scan) == TokenKind.identifier 'oneBinding'
				supplied = supplied + 1
			end 'oneBinding'

			scan = scan + 1
		end 'countNames'

		if supplied == (declared) 'agrees'
			return
		end 'agrees'

		throw SourceParseError.enumWrongBindingCount("{String.from(member.name)}.{String.from(member.layout.caseNameAt(caseIndex))}", expected: declared, got: supplied, line: caseTok.line, column: caseTok.column)
	end 'requireErrorUnionBindingCount'

	// Release the box of whichever of `members` is in flight, for a handler that cannot know which one is — a
	// `default`, a pattern arm naming several members, or a divergent `otherwise`. Returns the block control
	// continues in.
	//
	// The test is a RANGE over the fused line — a member owns a contiguous slice of it by construction
	// (`recordRoutedErrorType`) — so one boxed member costs two compares and a `__destruct_` call on the
	// path where it is really in flight.
	function emitErrorUnionBoxReleases(func IrFunction, members TryBlockErrorMemberArray, fused ValueId, entry IrBlock, flag ValueId, anchor Token) returns IrBlock
		var current = entry

		for member in members 'eachMember'
			if not member.isBoxed 'nothingToRelease'
				continue
			end 'nothingToRelease'

			match self.fusedSpanOfMember(member) 'span'
				// A member with no cases is never the error in flight.
				noCases then continue
				spanning(low, high) then current = self.emitErrorUnionMemberRelease(func, member: member, low: low, high: high, entry: current, fused: fused, flag: flag, anchor: anchor)
			end 'span'
		end 'eachMember'

		return current
	end 'emitErrorUnionBoxReleases'

	// ⭐⭐ **WHERE THE DISPATCH ENTERS AN ERROR-UNION ARM THAT DOES NOT KEEP A BOX, AND WHERE IT RELEASES ONE.**
	// The one rule for a `default` and for a pattern arm: release whichever of `members` is in flight as the arm
	// is entered. An arm reached by DISPATCH alone releases at the head of its body.
	//
	// ⚠ **AN `and fallthrough` ARRIVAL CARRIES NO BOX.** The arm the dispatch entered first has already released
	// its own — at its head, or at its exit when it kept the box for its bindings — so an arm fallen into must
	// neither release it again nor release a member it names when control came from another. Its releases sit in
	// a block only the dispatch reaches, which continues into the shared body carrying the dispatch edge's phi
	// args.
	function enterErrorUnionArm(func IrFunction, members TryBlockErrorMemberArray, fused ValueId, fallenInto bool, body IrBlock, edgeArgs ValueIdArray, flag ValueId, anchor Token) returns ErrorUnionArmEntry
		if not fallenInto 'dispatchedOnly'
			let releasedBody = self.emitErrorUnionBoxReleases(func, members: members, fused: fused, entry: body, flag: flag, anchor: anchor)
			return ErrorUnionArmEntry.create(body.id, args: edgeArgs, bodyId: releasedBody.id)
		end 'dispatchedOnly'

		if not membersHoldABox(members) 'nothingToRelease'
			return ErrorUnionArmEntry.create(body.id, args: edgeArgs, bodyId: body.id)
		end 'nothingToRelease'

		let entry = self.artifact.module.addBlock(func, label: b"errunionentry", heat: BlockHeat.normal)
		let entryId = entry.id
		let exit = self.emitErrorUnionBoxReleases(func, members: members, fused: fused, entry: entry, flag: flag, anchor: anchor)
		self.recordBranchEdge(exit, targetId: body.id, argIds: edgeArgs)
		self.emitBranch(exit, targetId: body.id)
		return ErrorUnionArmEntry.create(entryId, args: ValueIdArray.create(0), bodyId: body.id)
	end 'enterErrorUnionArm'

	// The slice of the fused dispatch line this member owns — its own tag span, shifted by its offset, which
	// is the interval `recordRoutedErrorType` placed it in. Recomputed from the same two facts rather than
	// stored a second time; the shift cannot overflow because the placement checked exactly these two sums
	// before it accepted the member.
	function fusedSpanOfMember(member TryBlockErrorMember) returns EnumTagSpan
		match enumTagSpan(member.layout) 'span'
			noCases then return EnumTagSpan.noCases
			spanning(low, high) then return EnumTagSpan.spanning(low + member.fusedTagOffset, high: high + member.fusedTagOffset)
		end 'span'
	end 'fusedSpanOfMember'

	// `if fused in [low, high] then <release the box as `member`>` — three blocks, and the block
	// control continues in is returned so the caller can chain the next member onto it.
	function emitErrorUnionMemberRelease(func IrFunction, member TryBlockErrorMember, low FullRangeInt, high FullRangeInt, entry IrBlock, fused ValueId, flag ValueId, anchor Token) returns IrBlock
		let atOrAbove = self.artifact.module.addBlock(func, label: b"errunionclean", heat: BlockHeat.normal)
		let release = self.artifact.module.addBlock(func, label: b"errunionfree", heat: BlockHeat.normal)
		let after = self.artifact.module.addBlock(func, label: b"errunionnext", heat: BlockHeat.normal)

		self.bodyState.currentBlock = entry
		let notBelow = self.emitCompareAgainstLiteral(fused, literal: low, op: MaxonCmpOp.ge, opTok: anchor)
		self.emitCondBranch(entry, cond: notBelow, thenId: atOrAbove.id, elseId: after.id, ifTok: anchor)

		self.bodyState.currentBlock = atOrAbove
		let notAbove = self.emitCompareAgainstLiteral(fused, literal: high, op: MaxonCmpOp.le, opTok: anchor)
		self.emitCondBranch(atOrAbove, cond: notAbove, thenId: release.id, elseId: after.id, ifTok: anchor)

		self.bodyState.currentBlock = release
		let range = SourceRange.ofToken(anchor)
		self.emitDecref(self.emitRetaggedCastValue(flag, targetType: self.tryErrorEnumType(member.clause), range: range), range: range)
		self.emitBranch(release, targetId: after.id)

		self.bodyState.currentBlock = after
		return after
	end 'emitErrorUnionMemberRelease'

	// ⭐ **A FALLTHROUGH TARGET MAY NOT BIND A PAYLOAD** — an arrival from a case the arm never named, so the
	// bindings at its head would destructure a case the value does not hold.
	//
	// ⚠⚠ **AN `or`-ARM MAY BIND ACROSS SEVERAL CASES AND THIS REFUSAL IS STILL UNCONDITIONAL.** An or-arm's
	// cases are its own alternatives, which `requireOrArmPayloadSlotsAgree` checks. A fallthrough SOURCE is
	// not one of them, and that check cannot be pointed at it either: the predecessor's arm may already have
	// MOVED its payload out and NULLED the slot, a fact about EMITTED CODE on one incoming edge rather than
	// about the layout both cases share. Accepted, the arm reads a null (a SIGSEGV), another case's String
	// pointer as an `int`, or the predecessor's scalar — whichever slot it happens to read.
	//
	// Positioned at the arm being fallen INTO, which is the arm that cannot bind. Falling OUT of a binding
	// arm stays legal: those bindings were established by the case that actually matched, and they drop on
	// the fallthrough edge like any other live exit.
	function rejectFallthroughIntoBindingArm(arm EnumPatternArm, patternTok Token) throws SourceParseError
		if arm.bindings.count() == 0 'bindsNothing'
			return
		end 'bindsNothing'

		let layout = requireEnumLayout(arm.payloadEnum)

		throw SourceParseError.unsupported("`and fallthrough` into the payload-binding arm '{String.from(patternTok.value)}' of `{layout.kindWord()} {String.from(layout.name)}` — the preceding arm matched a DIFFERENT case, so on that edge these bindings would destructure a case the value does not hold (reading another case's slots, or a slot that arm already moved out and nulled). Fall through into a payload-free arm, or give this arm its own body", line: patternTok.line, column: patternTok.column)
	end 'rejectFallthroughIntoBindingArm'

	// Parse a `(dir)` / `(_)` / `(a, b)` binding list on a single-case pattern, resolving each binding
	// against the case's declared payload fields in SLOT order. A `_` is the discard — it consumes a
	// slot but binds nothing. The binding count must equal the case's declared arity.
	//
	// `caseTok` is the ARM's case-name token, carried in for one reason: it is E3081's anchor (below).
	function parseCasePayloadBindings(layout EnumLayout, caseIndex CaseIndex, caseTok Token) returns PayloadBindingArray throws SourceParseError
		let payloads = layout.payloadsAt(caseIndex)
		let bindings = PayloadBindingArray.create(0)

		// Tracked as the list is read rather than re-walked afterwards — the loop already knows which arm
		// each binding took.
		var allDiscard = true

		// ⚠ A surplus name has no slot to occupy: the bindings are bounded by the declared arity
		// (`payloads.get` has nothing past it) while the arity diagnostic names how many the author
		// wrote, so a name past the end is counted but neither bound nor reserved-name checked. Judged
		// once, below, so both directions carry one code.
		let bindable = serviceParamIndexOfPayload(payloads, slot: payloads.count()) as PayloadSlotIndex
		let declaredArity = CheckedBindingNames.leading(bindable)
		let names = try self.parseBindingNameList(declaredArity)

		for nameTok in names 'bindLoop'
			if declaredArity.covers(bindings.count()) 'withinTheDeclaredArity'
				let slot = serviceParamPayloadSlot(payloads, paramIndex: bindings.count() as ParamCount)
				let field = try payloads.get(slot) otherwise panic("parseCasePayloadBindings: payloads.get OOB below the declared arity")

				if nameTok.value.equals(DiscardBindingName) 'discard'
					bindings.push(PayloadBinding.discard(nameTok, field: field, slot: slot, caseIndex: caseIndex))
				end 'discard' else 'realBinding'
					bindings.push(PayloadBinding.bound(nameTok, field: field, slot: slot, caseIndex: caseIndex))
					allDiscard = false
				end 'realBinding'
			end 'withinTheDeclaredArity'
		end 'bindLoop'

		if names.count() != bindable 'arityDisagrees'
			throw SourceParseError.enumWrongBindingCount(String.from(layout.caseNameAt(caseIndex)), expected: bindable, got: names.count(), line: caseTok.line, column: caseTok.column)
		end 'arityDisagrees'

		// ⭐ **AN ALL-DISCARD LIST IS EXACTLY THE BARE CASE NAME, so the language admits only the one
		// spelling** (E3081). The rule is about the LIST and nothing else: a PARTIAL discard (`two(_,
		// b)`) binds something and is legal, and a bare `value` on a payload-carrying case is legal — it
		// is the spelling this message recommends.
		//
		// ⚠ The references also test `count > 0`; here that condition CANNOT fail, so it is deliberately
		// absent rather than written as a check that always passes. `parseBindingNameList` consumes an
		// identifier before it can add anything, so `value()` is `E2010` at the missing name and an empty
		// list never reaches this line.
		if allDiscard 'everyBindingDiscarded'
			throw SourceParseError.matchDiscardedBindings(String.from(layout.caseNameAt(caseIndex)), discardList: discardBindingList(bindings.count()), line: caseTok.line, column: caseTok.column)
		end 'everyBindingDiscarded'

		return bindings
	end 'parseCasePayloadBindings'

	function requireLinearPayloadsAreBound(layout EnumLayout, caseIndex CaseIndex, bindings PayloadBindingArray, patternTok Token) throws SourceParseError
		for field in layout.payloadsAt(caseIndex) 'eachPayload'
			if not self.signatures.typeIsLinear(field.declaredType) 'notLinear'
				continue
			end 'notLinear'

			var bound = false

			for binding in bindings 'eachBinding'
				if binding.caseIndex == caseIndex and not binding.isDiscard and binding.field.name.equals(field.name) 'itBindsThisPayload'
					bound = true
				end 'itBindsThisPayload'
			end 'eachBinding'

			if not bound 'leftBehind'
				throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "the case '{String.from(layout.caseNameAt(caseIndex))}' carries the linear value '{String.from(field.name)}', and this arm must bind it to a name and consume it: a pattern that leaves it behind drops it", line: patternTok.line, column: patternTok.column)
			end 'leftBehind'
		end 'eachPayload'
	end 'requireLinearPayloadsAreBound'

	function requireDefaultCoversNoLinearPayload(layout EnumLayout, covered BoolArray, anchor Token) throws SourceParseError
		for i in 0 upto layout.caseCount() 'eachCase'
			let isCovered = try covered.get(i) otherwise panic("requireDefaultCoversNoLinearPayload: covered.get OOB at {i} — the bitmap is sized to the enum's case count")

			if isCovered 'anArmHasIt'
				continue
			end 'anArmHasIt'

			for field in layout.payloadsAt(i) 'eachPayload'
				if self.signatures.typeIsLinear(field.declaredType) 'aLinearPayload'
					throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "`default` covers the case '{String.from(layout.caseNameAt(i))}', which carries the linear value '{String.from(field.name)}': give the case an arm that binds it and consumes it", line: anchor.line, column: anchor.column)
				end 'aLinearPayload'
			end 'eachPayload'
		end 'eachCase'
	end 'requireDefaultCoversNoLinearPayload'

	function endLinearScrutineeInArm(scrut ValueId, anchor Token) throws SourceParseError
		if not self.valueIsAPayloadFreeWord(scrut) 'aRecordThisCodeMustOwn'
			try self.requireLinearArgumentIsOwned(scrut, anchor: anchor)
		end 'aRecordThisCodeMustOwn'

		self.emitDecrefOps(scrut, range: SourceRange.ofToken(anchor))
		self.poisonOwningBinding(scrut)
		self.removeFromPendingTemps(scrut)
	end 'endLinearScrutineeInArm'

	function parseBindingNameList(checked CheckedBindingNames) returns TokenArray throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let names = TokenArray.create(0)

		while true 'eachName'
			let nameTok = try self.consume(TokenKind.identifier)

			if checked.covers(names.count()) and not nameTok.value.equals(DiscardBindingName) 'aCheckedName'
				try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
			end 'aCheckedName'

			names.push(nameTok)

			if not self.at(TokenKind.comma) 'lastName'
				break
			end 'lastName'

			try self.consume(TokenKind.comma)
		end 'eachName'

		try self.consume(TokenKind.rightParen)
		return names
	end 'parseBindingNameList'

	// Declare a single-case pattern's payload bindings at the head of the arm body — each a
	// `loadIndirect` from the SCRUTINEE BOX (`scrutBox`). Called inside a scope frame the arm loop opens,
	// so the bindings leave scope at the arm's `end` and cannot leak into the next arm. A discard `_`
	// binds nothing (its managed payload is left in the box and dropped by the scope-exit cascade).
	//
	// ⭐ **A SCALAR binding is a COPY** (not a borrow into the box), so dropping the box does not
	// invalidate it. A MANAGED binding (String/struct/boxed union) OWNS its payload either way — it drops at its
	// own scope exit — but HOW it acquires that ownership depends on WHO ELSE CAN READ THE BOX'S SLOTS:
	//   • a scrutinee this frame is the SOLE owner of and that is read no more — an immutable binding, or a
	//     temporary ⇒ a MOVE-OUT, and the box slot is nulled so the box's cascade skips it
	//     (`moveOutManagedPayload`);
	//   • a scrutinee this frame is the SOLE owner of and may match again — a `var` binding ⇒ a RETAIN, because
	//     its later `match` reads the slot;
	//   • a BORROWED scrutinee (a parameter, a receiver, a bare field read) ⇒ the same RETAIN, and the slot is
	//     left INTACT because the box's real owner is the caller's local (`retainBorrowedPayload`);
	//   • a CO-OWNED scrutinee — one this frame owns a reference to WHILE SOMETHING ELSE HOLDS THE SAME BOX ⇒
	//     the SAME RETAIN, for the same reason read one step out. `let borrowed = h.ty` (a read out of a mutable
	//     field, promoted by `__mm_retain`), a payload retained out of a borrowed union and then matched again, a
	//     call's owned result, a caught error box and a consumed parameter are all in this state, and every one
	//     of them SEGFAULTED while the move-out's gate asked `valueIsOwnedHeap` — a predicate that answers
	//     *"this value owns a reference"* where the null store needs *"nobody else will read these slots"*. The
	//     gate is `valueIsSoleHeapOwner`; see `OwnedHeapExclusivity` for the six measured programs.
	// Each RETAIN above is a hold (`holdBindingRead`) when its payload is not a `typeParameter` or an
	// `interfaceRef`. `HoldResolution.maxon` lowers the hold
	// to the same incref only where an op in the window may release or displace what the binding
	// reads.
	// Returns whether ANY managed field was MOVED out — the whole match then consumes the scrutinee
	// (`setBindingPartiallyMoved`). A RETAIN consumes nothing, so it must not set it: nothing left the
	// box, and marking it moved would make the other owner's later re-read a false E3102.
	function declarePayloadBindings(bindings PayloadBindingArray, scrutBox ValueId, standing ScrutineeStanding, layout EnumLayout) returns bool throws SourceParseError
		var movedManaged = false
		let unboxed = self.signatures.unionRepresentation(layout) == UnionRepresentation.word

		for binding in bindings 'each'
			if binding.isDiscard 'discard'
				continue
			end 'discard'

			let range = SourceRange.ofToken(binding.nameTok)

			// Through `payloadTypeOf` — the payload's own slot door — which adopts the signatures-layout id
			// into this file's interner AND resolves what the declaration sweep could not name.
			// A bare `adoptType` here, at the construct check or at the payload LOAD, would let a generic-alias payload
			// arrive `named`, i.e. an int.
			let declared = self.signatures.payloadTypeOf(binding.field, layout: layout, into: self.artifact.typeNames)
			let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: declared, slotScopeFilePath: layout.declFilePath)

			// The slot's address and width are derived once and handed to both halves — the load and the
			// move-out's null store — which must agree on them exactly.
			let offset = layout.payloadSlotOffset(binding.slot)
			let storage = payloadStorageOf(class)
			let loaded = self.emitUnionPayloadLoad(scrutBox, field: binding.field, valueType: payloadValueTypeOf(class, declared: declared), source: PayloadSource.word(layout.wordKeyOfIndex(binding.caseIndex)) if unboxed else PayloadSource.slot(offset, storage: storage), range: range)
			self.wearIndexSpaceAlias(loaded, declared: binding.field.declaredType, scopeFilePath: layout.declFilePath)
			self.carryWindowBirthFrom(loaded, source: scrutBox)
			self.brandValue(loaded, brand: self.payloadPlaceBrand(binding.field, layout: layout, resolved: declared))

			// Whatever the payload's own mutability: a read-only scrutinee is read-only all the way down.
			if self.valueMayNameARecord(loaded) or self.valueIsPromise(loaded) 'payloadOwnsARecord'
				self.carryImageRecordMark(loaded, from: scrutBox, source: self.bodyState, path: ValueCarryPath.part)
			end 'payloadOwnsARecord'

			let bindingInfo = try self.bodyState.scope.declarePayloadValueBinding(binding.nameTok.value, varType: self.typeOf(loaded), value: loaded, scrutBox: scrutBox) otherwise throw SourceParseError.localShadowsSelfField(String.from(binding.nameTok.value), typeName: String.from(self.enclosingTypeName()), line: binding.nameTok.line, column: binding.nameTok.column)

			if self.valueHoldsAUniqueRecord(loaded) 'aUniquePayloadIsAnAlias'
				self.bodyState.functionMintedValueAliases = true
			end 'aUniquePayloadIsAnAlias'

			// ⭐ **E3012 — AN ARM THAT NAMES A PAYLOAD IT NEVER READS MEANT `_`.** The discard is the spelling
			// for a payload the arm does not want, and it is already skipped above, so a NAME here is a claim
			// the arm makes about needing the value.
			self.bodyState.unusedCandidates.push(UnusedBindingCandidate.create(bindingInfo, nameRange: range, kind: UnusedBindingKind.payloadBinding, declToken: self.pos))

			// ⭐⭐ **A GREEN-THREAD PAYLOAD IS MOVED OUT AT THE BIND, AND THERE IS NO BORROWED TWIN.** The
			// managed arm below has two shapes — move out of a box this frame owns, or RETAIN out of one it
			// only borrows — and the second cannot exist for a promise: a retain needs a second reference and
			// a green thread admits exactly one owner. So an owned scrutinee hands the thread to the binding
			// and NULLS the slot, and a borrowed one is refused rather than silently aliased.
			//
			// ⛔ **THE NULL STORE IS WHAT STOPS THE UNION RECLAIMING A THREAD THE `await` ALREADY DID.** With
			// the payload merely loaded, `Slot.held(async plain())` matched and awaited exited **75**: the
			// await reclaimed the thread and the union's own destructor cascade reclaimed it again. It is the
			// payload twin of `__managed_vacate`, and the union's slot is nulled by the same store the managed
			// move-out uses.
			if payloadClassIsManaged(class) and (self.valueIsLinear(loaded) or self.valueIsLinear(scrutBox)) 'aLinearPayload'
				self.retainBorrowedPayload(bindingInfo, loaded: loaded, range: range)
				movedManaged = true
			end 'aLinearPayload' else if payloadClassIsAGreenThread(class) 'aGreenThreadPayload'
				if not standing.solelyOwned 'borrowedScrutinee'
					throw SourceParseError.promiseCannotBeBorrowed(String.from(binding.field.name), cure: "A promise payload is MOVED out of the union when it is bound, and this scrutinee is only borrowed — there is nothing to move out of. `match` on the binding that owns the union", line: binding.nameTok.line, column: binding.nameTok.column)
				end 'borrowedScrutinee'

				self.markValuePromise(loaded)
				self.moveOutManagedPayload(bindingInfo, loaded: loaded, scrutBox: scrutBox, offset: offset, storage: storage, exclusivity: OwnedHeapExclusivity.coOwned, range: range)
				movedManaged = true
			end 'aGreenThreadPayload' else if payloadClassIsManaged(class) and unboxed 'aWordPayload'
				// A word's payload is never emptied out of it, but the match still consumes a solely-owned
				// immutable scrutinee on the condition the box's move-out uses, so a later read is E3102 in
				// either representation.
				let take = self.payloadTakeOf(standing, loaded: loaded, slot: binding.field.capability, slotIsEmptiable: true)
				self.borrowPayload(bindingInfo, loaded: loaded, name: binding.nameTok.value, range: range)
				movedManaged = self.settlePayloadTake(take, loaded: loaded) or movedManaged
			end 'aWordPayload' else if payloadClassIsManaged(class) 'managedPayload'
				// A `var` union's slot is read again by its next `match`, so the bind borrows it rather than
				// emptying it: a move-out would hand the record to a binding that frees it at the arm's exit,
				// leaving the box holding a null the author never emptied. A `let` union is never read after
				// the match consumes it, so an arm may take its payload for good.
				let take = self.payloadTakeOf(standing, loaded: loaded, slot: binding.field.capability, slotIsEmptiable: not self.sendErrorSlotIsCoOwnedByType(layout, slotType: declared))

				if take == PayloadTake.movedOut 'ownedMoveOut'
					self.moveOutManagedPayload(bindingInfo, loaded: loaded, scrutBox: scrutBox, offset: offset, storage: storage, exclusivity: serviceSendErrorExclusivity(self.signatures, unionName: layout.name), range: range)
					movedManaged = true
				end 'ownedMoveOut' else 'borrowed'
					self.borrowPayload(bindingInfo, loaded: loaded, name: binding.nameTok.value, range: range)
					movedManaged = self.settlePayloadTake(take, loaded: loaded) or movedManaged
				end 'borrowed'
			end 'managedPayload'
		end 'each'

		return movedManaged
	end 'declarePayloadBindings'

	// ⭐ **MOVE A MANAGED PAYLOAD OUT OF THE SCRUTINEE BOX** into its binding — the match half of static
	// single-owner ownership. The binding OWNS the payload (enrolled in `ownedBindings`, so it drops at
	// its own scope exit through `emitDecref`'s tag routing), and the box SLOT is NULLED so the box's own
	// `__destruct_<U>` cascade — which null-guards every field — does not decref it a second time.
	//
	// ⚠⚠ **REACHED ONLY WHERE THIS FRAME IS THE BOX'S SOLE OWNER (`valueIsSoleHeapOwner`), WHICH IS STRICTLY
	// NARROWER THAN "OWNED", AND ONLY WHERE IT CANNOT WRITE THE SLOT AGAIN.** The null store below is
	// destructive and this function never re-reads the slot, so every OTHER owner of the box is a reader it
	// cannot account for: a BORROWED union's owner is the caller's local, and a CO-OWNED one's is a struct
	// field, an array slot, a caller's payload slot or a caller's own local that the retain gave this frame a
	// second reference to. A `var` scrutinee is a reader too — its own later `match` — which is why it
	// is not moved out of either. All three leave the slot alone, through `retainBorrowedPayload` or a
	// hold; `declarePayloadBindings` is the one place that picks between them, and
	// `OwnedHeapExclusivity` records the six programs the wider gate segfaulted.
	function moveOutManagedPayload(bindingInfo VarInfo, loaded ValueId, scrutBox ValueId, offset ByteOffset, storage MaxonType, exclusivity OwnedHeapExclusivity, range SourceRange)
		// The caller passes `coOwned` for every union but a send error, whose payloads are sole by its
		// type (`serviceSendErrorExclusivity`).
		//
		// ⛔⛔ **CO-OWNED, AND THE ARGUMENT FOR `sole` HERE WAS THIS RUNG'S OWN BUG ONE LEVEL DOWN.** It read
		// *"the box was this frame's alone and the store below empties the slot, so the binding now holds the
		// allocation's only reference"* — and the second clause does not follow from the first. The box's
		// soleness is a fact about the BOX; the reference its slot HOLDS is a separate fact, because
		// `moveManagedValueInto`'s borrowed arm stores a borrowed aggregate by `__mm_incref`
		// (`coOwnBorrowedForConsume`) rather than by move. **So a genuinely-sole box can hold a co-owned
		// payload**, and stamping that payload `sole` re-arms the very destructive write this column exists to
		// disarm. MEASURED two ways, both 0xC0000005: `let w = Wrap.held(<a borrowed union>)` then an INLINE
		// nested `match i` nulls the CALLER's box slot
		// (`union-managed-payload/a-co-owned-payload-moved-out-of-a-sole-box-is-still-co-owned`), and
		// `held(b) then throw b.e` nulls the caller's struct field
		// (`throw-transfers-ownership/boxed-union-field-thrown-out-of-a-co-owned-in-payload`).
		// Both have CONTROLS that pass: the same programs with a helper call, and with the
		// payload CONSTRUCTED at the construct site — so the discriminator is move-in versus co-own-in and
		// nothing else.
		//
		// ⚖ **THE CURE IS THE UNDERSTATEMENT, BY DECISION.** Tracking "every managed
		// payload in this box was MOVED in" per box would keep the nested move-out, and it would add a THIRD
		// ownership state and a new invariant to a predicate that has already paid six segfaults for answering
		// two facts. The cost of understating is one refcount pair per nested move-out; the cost of
		// overstating is a stolen slot. `OwnedHeapExclusivity`'s own safety argument decides it.
		self.ownPayloadBinding(bindingInfo, loaded: loaded, exclusivity: exclusivity)

		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: range)
		self.emitIndirectStore(scrutBox, offset: offset, value: zero, storageType: storage, range: range)
	end 'moveOutManagedPayload'

	// ⭐ **RETAIN A MANAGED PAYLOAD BOUND OUT OF A UNION THIS BIND MUST LEAVE WHOLE.** The load borrowed
	// the payload — the box's owner is the CALLER's local (a parameter, or a method's receiver), or it is this
	// frame's own `var`, and either way it outlives the arm — so ownership cannot be MOVED: that owner may
	// re-read the field, or match the union again, and its own cascade will release every slot it still holds.
	// So instead of a move this RETAINS:
	// `__mm_incref` raises the payload's refcount, the binding owns that SECOND reference and drops it at
	// the arm's own exit (`dropArmScopedOwned`), and the slot is left INTACT for the owner. The refcount
	// balances at exactly one free. Nothing left the box, so the match does NOT consume the scrutinee.
	//
	// ⚠ **THE INCREF MUST PRECEDE ANY RELEASE OF THE BASE**, and it does because it is emitted at the bind
	// point — the op immediately after `emitUnionPayloadLoad`, before the arm body can drop anything. The
	// hazard in full is `specs/refcount-accessor-borrow-order.md`: release the base first and its
	// destructor drives the field to zero, so the following incref resurrects freed memory.
	//
	// The RETAIN twin of `moveOutManagedPayload`, and an application of the retain-promotion rule
	// `retainBorrowedAggregate` applies, which a thrown borrowed box takes too. The release side is
	// structural: the binding is in `ownedBindings` and drops at its scope exit whatever an analysis
	// would have said, so the acquire is balanced without one.
	//
	// A binding that can be written takes this retain unconditionally. Any other binding takes a hold
	// (`holdBindingRead`) in `declarePayloadBindings`, and `HoldResolution.maxon` decides per site
	// whether the incref is emitted; the payloads `holdReplacesItsSource` names keep this retain.
	//
	// ⭐⭐ **AND THE BINDING IS A CO-OWNER, WHICH IS WHAT MAKES A NESTED `match` ON IT SAFE.** The reference this
	// took is a SECOND one; the box still holds the first. So `direct(ty) gives match ty …` — a nested match on a
	// retained payload — must retain in turn, and it does because the acquisition is recorded on the value rather
	// than re-derived from its owned bit. Claiming sole here is exactly how an inline nested match came to null a
	// caller's `Ty` box slot (MEASURED; the same program with a HELPER CALL in place of the inline match was fine,
	// because the callee's parameter is borrowed and retains).
	function retainBorrowedPayload(bindingInfo VarInfo, loaded ValueId, range SourceRange)
		self.emitIncref(loaded, range: range)
		self.ownPayloadBinding(bindingInfo, loaded: loaded, exclusivity: OwnedHeapExclusivity.coOwned)
	end 'retainBorrowedPayload'

	function payloadTakeOf(standing ScrutineeStanding, loaded ValueId, slot ParamCapability, slotIsEmptiable bool) returns PayloadTake
		if standing.ownsTheBoxAlone() and slotIsEmptiable and not self.valueHoldsAUniqueRecord(loaded) 'theOnlyOwnerTakesIt'
			return PayloadTake.movedOut
		end 'theOnlyOwnerTakesIt'

		if slot != ParamCapability.isolated 'notAnIsolatedPayload'
			return PayloadTake.borrowed
		end 'notAnIsolatedPayload'

		return PayloadTake.consumed if standing.ownsItsIsolatedPayloads() else PayloadTake.partRead
	end 'payloadTakeOf'

	function settlePayloadTake(take PayloadTake, loaded ValueId) returns bool
		if take == PayloadTake.partRead 'theSlotStaysReachable'
			self.noteIsolatedPartRead(loaded)
		end 'theSlotStaysReachable'

		return take == PayloadTake.movedOut or take == PayloadTake.consumed
	end 'settlePayloadTake'

	function borrowPayload(bindingInfo VarInfo, loaded ValueId, name ByteArray, range SourceRange)
		if not self.holdReplacesItsSource(loaded) 'heldRead'
			_ = self.holdBindingRead(loaded, name: name, range: range)
			return
		end 'heldRead'

		self.retainBorrowedPayload(bindingInfo, loaded: loaded, range: range)
	end 'borrowPayload'

	// The half both managed-payload bind paths share: the binding OWNS the payload's reference, however it
	// was acquired (moved out of a solely-owned box, or retained out of a box with another owner). The
	// provenance bit is what `valueIsOwnedHeap` reads — a later `let q = <it>` re-moves it correctly, and a
	// struct payload is not mistaken for a borrow — and `ownedBindings` is what DROPS it, at the arm's own exit.
	//
	// ⚠ **`exclusivity` IS THE CALLER'S BECAUSE IT IS THE ONE THING THE TWO PATHS DO NOT SHARE, and folding it
	// in here would re-derive the move-vs-retain decision at a second site**.
	//
	// `markValueOwnsHeap` rather than `trackOwnedTemp`, for the reason a consumed parameter needs the same
	// half: the BINDING owns the drop, not the statement, so enrolling a statement-scoped pending temp
	// would drop the payload a second time at the enclosing statement's end.
	function ownPayloadBinding(bindingInfo VarInfo, loaded ValueId, exclusivity OwnedHeapExclusivity)
		self.markValueOwnsHeap(loaded, exclusivity: exclusivity)
		self.enrolOwnedBinding(bindingInfo)
	end 'ownPayloadBinding'

	// The declaration index of the case named by `nameTok`, or E3034 (unknown case) positioned at
	// `posTok`. THE one emitter of "this name is not a case of this enum" — a `Color.red` literal
	// anchors it at the TYPE name and a match arm at the CASE name, so the POSITION is the caller's to
	// pass, but the lookup and the diagnostic are shared so the two sites cannot drift on either.
	function enumCaseIndexOrThrow(layout EnumLayout, nameTok Token, posTok Token) returns CaseIndex throws SourceParseError
		return try layout.indexOfCase(nameTok.value) otherwise throw SourceParseError.enumUnknownCase(layout.kindWord(), caseName: String.from(nameTok.value), line: posTok.line, column: posTok.column)
	end 'enumCaseIndexOrThrow'

	// Resolve a case NAME in a match arm to its declaration index. A QUALIFIED name (`Color.red`) is
	// E3075 — the scrutinee's enum is already known, so the bare name suffices — positioned at the
	// type name. An unknown case is E3034, at the case name.
	function resolveEnumArmCase(layout EnumLayout) returns CaseIndex throws SourceParseError
		let caseTok = self.current()

		if not tokenCanBeAName(caseTok) 'notACaseName'
			throw SourceParseError.expectedExpression(expressionOperandDisplayText(caseTok), line: caseTok.line, column: caseTok.column)
		end 'notACaseName'

		if self.kindAt(self.pos + 1) == TokenKind.dot 'qualified'
			self.advance()
			try self.consume(TokenKind.dot)
			let realCaseTok = self.current()
			throw SourceParseError.matchQualifiedCaseName(String.from(realCaseTok.value), qualified: "{String.from(caseTok.value)}.{String.from(realCaseTok.value)}", line: caseTok.line, column: caseTok.column)
		end 'qualified'

		self.advance()
		return try self.enumCaseIndexOrThrow(layout, nameTok: caseTok, posTok: caseTok)
	end 'resolveEnumArmCase'

	// Mark case `index` covered, or raise E2027 if a prior arm already covered it. The overlap is
	// positioned at the CURRENT arm's pattern token (`patternTok`), naming the case that collides.
	function markEnumCovered(covered BoolArray, index CaseIndex, layout EnumLayout, patternTok Token) throws SourceParseError
		let already = try covered.get(index) otherwise panic("markEnumCovered: covered.get OOB at {index} — the bitmap is sized to the enum's case count")

		if already 'overlap'
			throw SourceParseError.matchOverlappingCase(String.from(layout.caseNameAt(index)), line: patternTok.line, column: patternTok.column)
		end 'overlap'

		try covered.set(index, value: true) otherwise panic("markEnumCovered: covered.set OOB at {index}")
	end 'markEnumCovered'

	// ⭐ **COMPARE A SCALAR AGAINST AN INTEGER LITERAL** — `subject <op> literal`, emitting `MaxonOp.compare`
	// DIRECTLY rather than through `emitCompare`. The bypass is load-bearing at every one of its callers, and
	// for one of two reasons each: `emitCompare` REFUSES a `union` operand (E3066), and `emitCompare` THROWS.
	//
	// ⚠⚠ **THIS LIST IS A CENSUS AND IT HAS ROTTED TWICE.** It said "four times over" while SIX families
	// called it (the cursor-protocol test and the error-union cleanup were both absent), which is the
	// enumerated-doors shape: a list that a new caller does not have to join in order to compile. Nothing
	// checks it — so when you add a caller, add its bullet, and when you read it, read `grep` first.
	//
	//   • **The MATCH DISPATCH** — a point leaf's `==`, a range leaf's `>=`/`<=`, an internal node's `<`
	//     pivot. A PAYLOAD-FREE union match dispatches on the scrutinee itself (a `named(union)` value), so
	//     routing through `emitCompare` would reject `match u` outright.
	//   • **A BLOCK-FORM `try`'s ERROR-FLAG TEST** (`flag != NoErrorFlag`), whose router is NON-THROWING by
	//     construction — one of its two emit doors, `emitRuntimeCall`, is not a throwing function — and
	//     `emitCompare` throws.
	//   • **A `for … in <cursor>` LOOP'S ADVANCE TEST** (`emitProtocolTryCall`'s `flag == 0`), the
	//     same
	//     already-encoded error flag one construct over, in a routine that likewise cannot throw a compare's
	//     diagnostic at a value the author never wrote.
	//   • **A SYNTHESIZED ERROR UNION'S DEFAULT CLEANUP** (`emitErrorUnionMemberRelease`'s `>=`/`<=` pair) —
	//     the range test that decides whether a BOXED member's box is the error in flight. Its subject is the
	//     fused ordinal, a compiler-minted i64 that no source expression names.
	//   • **AN `Ordering` VERDICT** (`emitOrderingVerdict`) — the tag test that turns a `compare` result into
	//     an ordering operator's bool. Its subject is a `named(Ordering)` value, which `emitCompare` would
	//     hand to the same `valueIsUnion` gate the match dispatch dodges.
	//   • **AN ENUM ACCESSOR'S CASE SELECT** (`emitEnumCaseConstantSelect`) — one `tag == tagᵢ` term of the
	//     branchless tag→index sum. Its subject is the same `named(<Enum>)` (or loaded i64) tag the match
	//     dispatch tests, for the same E3066 reason, which is why the two read this one door.
	//
	// ⚠ **THE ACCESSOR'S CASE SELECT IS THE ONLY CALLER WHOSE 0/1 IS NOT CONSUMED BY A BRANCH, AND THAT IS A
	// REAL DIFFERENCE.** Every other one feeds the result to a `condBranch`, where a `boolean` mint is exactly
	// right and the backends need never materialize it at all (x64 fuses the `cmp` into the `jcc`). The
	// ordinal sum feeds it to a MULTIPLY, as a number — so it materializes, and its mint type becomes an
	// arithmetic operand type. That caller re-records the result `integer` at its own site rather than
	// changing this door's mint, which would move all the others (see `retypeValue`'s header, where the
	// safety of that re-record is argued).
	//
	// ⚠ **THE PARAMETER IS `literal`, NOT `tag`.** It was `tag` while the match dispatch was its only caller,
	// which named that caller's USE of the operand rather than the operand — and a flag test passing
	// `NoErrorFlag` is what made the mis-naming visible.
	//
	// Every caller hands it operands whose types are settled by construction: the subject is a scalar enum's
	// `named` value, a boxed union's loaded i64 tag, a scalar int/char/bool, an `Ordering` case tag, or a
	// minted error flag, and the literal is an i64. There is no operand type left to check, which is exactly
	// what makes the bypass a narrowing of `emitCompare` rather than an evasion of it.
	// ⭐ **SIGNED, AND THAT IS A STATEMENT ABOUT THE SUBJECTS RATHER THAN A DEFAULT.** Every operand this
	// bypass compares is a COMPILER-MINTED SMALL NON-NEGATIVE NUMBER against an i64 literal — an enum's
	// declaration-order tag, a boxed union's loaded tag, an `Ordering` case, a minted error flag, a
	// binary-search pivot over those same tags. None is a value whose DECLARED RANGE reaches the top bit,
	// so the two readings agree on every value any caller can produce, and `signed` is the answer rather
	// than the absence of one. (A SOURCE comparison — the one place a declared range can say otherwise —
	// goes through `emitCompare`, which asks `TypeRules`' ordering rule.)
	function emitCompareAgainstLiteral(subject ValueId, literal FullRangeInt, op MaxonCmpOp, opTok Token) returns ValueId
		let rhs = self.emitLiteral(literal, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.compare(result, lhs: subject, rhs: rhs, op: op, signedness: IntegerSignedness.signed), range: SourceRange.ofToken(opTok))
		return result
	end 'emitCompareAgainstLiteral'

	// An enum match must cover EVERY case. The uncovered ones (in declaration order) become E2026's
	// `missing:` list, positioned at the closing `end` — the enum twin of the scalar exhaustiveness
	// gate, and the mechanism that makes adding a case force every match site to handle it.
	function checkEnumExhaustive(layout EnumLayout, covered BoolArray, union ErrorUnionMatch) throws SourceParseError
		var missing = ""

		for i in 0 upto layout.caseCount() 'eachCase'
			let isCovered = try covered.get(i) otherwise panic("checkEnumExhaustive: covered.get OOB at {i} — the bitmap is sized to the enum's case count")

			if not isCovered 'uncovered'
				missing = appendCommaSeparated(missing, item: self.matchCaseDisplayName(layout, index: i, union: union))
			end 'uncovered'
		end 'eachCase'

		// The list IS the flag — a case name is never empty, so an exhaustive match leaves it empty and
		// there is no parallel `hasMissing` bool to keep in step with it.
		if missing.isEmpty() 'complete'
			return
		end 'complete'

		// ⚠ ONE loop, TWO sentences: the case names and the subject both change for a synthesized error
		// union, and nothing else does. Written as one walk with a per-case display name rather than a
		// second copy of the walk to keep in step.
		let endTok = self.current()

		if errorUnionIsSynthesized(union) 'anErrorUnion'
			throw SourceParseError.errorUnionMatchNotExhaustive(missing, line: endTok.line, column: endTok.column)
		end 'anErrorUnion'

		throw SourceParseError.enumMatchNotExhaustive(layout.kindWord(), typeName: String.from(layout.name), missing: missing, line: endTok.line, column: endTok.column)
	end 'checkEnumExhaustive'

	// How case `index` is SPELLED in a diagnostic: its bare name, or `Member.case` when the layout is a
	// synthesized error union — where the bare name alone would be ambiguous and, for `missing:`, unusable
	// (an author cannot act on `bang, splat` without knowing whose they are). Both references print the
	// qualified form for exactly that reason.
	function matchCaseDisplayName(layout EnumLayout, index CaseIndex, union ErrorUnionMatch) returns String
		if not errorUnionIsSynthesized(union) 'anOrdinaryEnum'
			return String.from(layout.caseNameAt(index))
		end 'anOrdinaryEnum'

		let info = requireErrorUnionInfo(union)
		let member = try info.caseMembers.get(index) otherwise panic("matchCaseDisplayName: caseMembers.get OOB at {index} — the column is built case for case beside the layout's own")
		return "{String.from(member.name)}.{String.from(layout.caseNameAt(index))}"
	end 'matchCaseDisplayName'

	// ⭐ **CLIP the raw arm intervals into a SORTED, DISJOINT set where EARLIER ARMS WIN.** Overlaps are
	// legal on a scalar match (two ranges may overlap, or a later single value fall inside an earlier
	// range) and the FIRST arm claims the overlap — exactly the order the linear chain gave by testing
	// arms top to bottom. A binary search cannot rely on arm order, so the overlap is resolved HERE. The
	// result is the partition of the value line into maximal runs each OWNED by one arm, where a point's
	// owner is the EARLIEST (lowest-index) raw interval covering it — the "earlier wins" a top-to-bottom
	// chain gave for free. It is sorted by `lo`, which is what makes the median-split search correct.
	// (Enum/union intervals are already disjoint — `markEnumCovered` rejects overlap — so for them this is
	// only the sort.)
	//
	// ⚠ THIS IS O(n log n) IN THE ARM COUNT, AND IT USED TO BE Θ(n²) — a subtract-and-insert that, per raw
	// interval, scanned the whole claimed set and inserted into the middle of a sorted array. MEASURED at
	// 256→2048 distinct scalar arms, the parse phase read x2.3→x2.7→x3.0 per doubling (linear reads x2.0):
	// a 2048-arm dispatch table — a bytecode/keyword switch, the very shape a `match` is FOR — spent ~47 ms
	// of a 70 ms parse in this one function. The scale-test corpus has no `match`, so it never saw it.
	//
	// The replacement is an offline left-to-right sweep: sort the interval indices by `lo` once, then walk
	// the value line, keeping the started-but-not-ended intervals in a min-heap KEYED BY ARM PRIORITY so
	// the current owner is the heap minimum. A segment closes and a new one opens exactly when that owner
	// changes — an earlier-arm interval activating (at its `lo`) or the current owner ending (at its `hi`),
	// the only two coordinates where ownership can change — which coalesces same-owner runs.
	function normalizeDispatchIntervals(raw DispatchIntervalArray) returns DispatchIntervalArray
		let result = DispatchIntervalArray.create(0)
		let n = raw.count()

		if n == 0 'empty'
			return result
		end 'empty'

		let order = self.dispatchIntervalsSortedByLo(raw)
		let heap = DispatchIndexArray.create(0)

		// `si` is the next not-yet-activated interval in `lo` order; `sweepPos` the coordinate whose owner we
		// are currently deciding. A segment for `segOwner` is open over `[segStart, sweepPos-1]` while
		// `segOpen`. (`sweepPos`, not `pos` — that name is the Parser's token cursor.)
		var si = 0 as ElementIndex
		var sweepPos = (try raw.get(try order.get(0) otherwise panic("normalizeDispatchIntervals: order.get(0) on n>0")) otherwise panic("normalizeDispatchIntervals: raw.get(order[0]) OOB")).lo
		var segOpen = false
		var segStart = sweepPos
		var segOwner = 0 as ElementIndex

		while true 'sweep'
			// Activate every interval that has started by `sweepPos` (its `lo <= sweepPos`); they are
			// contiguous in `order`, so this consumes a prefix. All same-`lo` intervals activate together, so
			// the heap minimum is the earliest arm among them regardless of their order within the run.
			while si < n and self.dispatchLoOf(raw, index: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}")) <= sweepPos 'activate'
				self.dispatchHeapPush(heap, value: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}"))
				si = si + 1
			end 'activate'

			// Drop intervals that ended before `sweepPos` (their `hi < sweepPos`); they no longer cover it.
			// Lazy: only the heap minima are checked, so each interval is discarded once, when it surfaces.
			while heap.count() > 0 and self.dispatchHiOf(raw, index: try heap.get(0) otherwise panic("normalizeDispatchIntervals: heap.get(0) on non-empty")) < sweepPos 'expire'
				_ = self.dispatchHeapPopMin(heap)
			end 'expire'

			if heap.count() == 0 'gap'
				// No interval covers `sweepPos`. A segment can only have closed at an owner change (below), so
				// none is open here; the next covered region begins at the next interval's `lo`.
				if segOpen 'lostSegment'
					panic("normalizeDispatchIntervals: a segment was left open crossing an uncovered gap")
				end 'lostSegment'

				if si >= n 'done'
					break
				end 'done'

				sweepPos = self.dispatchLoOf(raw, index: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}"))
				continue
			end 'gap'

			let owner = try heap.get(0) otherwise panic("normalizeDispatchIntervals: heap.get(0) on non-empty")

			if not segOpen 'openSegment'
				segOpen = true
				segStart = sweepPos
				segOwner = owner
			end 'openSegment' else if owner != segOwner 'ownerChanged'
				// A new interval activated at `sweepPos` outranks the running owner, which therefore owned only
				// up to `sweepPos - 1` (no underflow: `sweepPos > segStart >= i64.min` since it opened earlier).
				self.pushNormalizedSegment(result, raw: raw, owner: segOwner, lo: segStart, hi: sweepPos - 1)
				segStart = sweepPos
				segOwner = owner
			end 'ownerChanged'

			// The owner holds `sweepPos` until either a new interval starts inside its span (re-decide there)
			// or it ends at its own `hi`.
			let ownerHi = self.dispatchHiOf(raw, index: owner)
			var ownerEnds = true

			if si < n 'hasNextStart'
				let nextLo = self.dispatchLoOf(raw, index: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}"))

				if nextLo <= ownerHi 'startsInsideOwner'
					sweepPos = nextLo
					ownerEnds = false
				end 'startsInsideOwner'
			end 'hasNextStart'

			if ownerEnds 'closeSegment'
				self.pushNormalizedSegment(result, raw: raw, owner: segOwner, lo: segStart, hi: ownerHi)
				segOpen = false

				if ownerHi == I64MaxBound 'atCeiling'
					// Nothing lies past i64.max, and no interval's `lo` can either, so the sweep is done —
					// and `ownerHi + 1` would overflow, so it is never computed.
					break
				end 'atCeiling'

				sweepPos = ownerHi + 1
			end 'closeSegment'
		end 'sweep'

		return result
	end 'normalizeDispatchIntervals'

	// `raw[index].lo` / `raw[index].hi` — the sweep reads these coordinates far more often than it needs
	// the whole interval, and going through one accessor keeps the `try … otherwise panic` off the sweep.
	function dispatchLoOf(raw DispatchIntervalArray, index ElementIndex) returns FullRangeInt
		return (try raw.get(index) otherwise panic("dispatchLoOf: raw.get OOB at {index}")).lo
	end 'dispatchLoOf'

	function dispatchHiOf(raw DispatchIntervalArray, index ElementIndex) returns FullRangeInt
		return (try raw.get(index) otherwise panic("dispatchHiOf: raw.get OOB at {index}")).hi
	end 'dispatchHiOf'

	// Append the segment `[lo, hi]` owned by raw interval `owner`, carrying that arm's body and edge args.
	// A single owner can yield several segments (an interior higher-priority arm splits it), each sharing
	// the same `edgeArgs`, reused rather than copied.
	function pushNormalizedSegment(result DispatchIntervalArray, raw DispatchIntervalArray, owner ElementIndex, lo FullRangeInt, hi FullRangeInt)
		let src = try raw.get(owner) otherwise panic("pushNormalizedSegment: raw.get OOB at owner {owner}")

		// ⭐⭐ **FUSE ONTO THE PRECEDING SEGMENT WHEN THE TWO TOUCH AND SELECT THE SAME ARM.** An arm
		// contributes ONE POINT INTERVAL PER ALTERNATIVE, so a twenty-case `or`-chain arrives as twenty
		// segments and would leave the search twenty leaves to walk where two compares say the same thing.
		// The sweep has already established that nothing lies between these two and that no other arm owns
		// the join, so "touching, and the same target block" IS the whole condition.
		//
		// ⚠ **`edgeArgs` IS DELIBERATELY NOT COMPARED.** The arm loop stamps one array across every interval
		// an arm contributes, so a shared target block already means the same arm and therefore the same
		// edge args. Comparing the arrays would be asking the same question twice, in the one place where a
		// second opinion could disagree.
		let n = result.count()

		if n > 0 'tryFuse'
			let previous = try result.get(n - 1) otherwise panic("pushNormalizedSegment: result.get OOB at {n - 1} — the index is its own count minus one")

			// `hi + 1` is computed only below the ceiling, where it cannot wrap around into the very
			// interval it would then appear to touch. An arm whose alternatives mean one RANGE has already
			// been folded to a single interval by `foldEnumCaseRun`; this is the plain touching-merge.
			if previous.targetBlockId == src.targetBlockId and previous.hi < I64MaxBound and previous.hi + 1 == lo 'contiguous'
				try result.set(n - 1, value: DispatchInterval.create(previous.lo, hi: hi, targetBlockId: previous.targetBlockId, edgeArgs: previous.edgeArgs)) otherwise panic("pushNormalizedSegment: result.set OOB at {n - 1} — the slot was just read")
				return
			end 'contiguous'
		end 'tryFuse'

		result.push(DispatchInterval.create(lo, hi: hi, targetBlockId: src.targetBlockId, edgeArgs: src.edgeArgs))
	end 'pushNormalizedSegment'

	// The interval positions `[0, n)` sorted ascending by `raw[i].lo`. A stable merge sort — O(n log n) in
	// the arm count, the property this whole path exists to hold — over an index permutation, so the raw
	// intervals never move. Ties (equal `lo`) keep ascending index order; the sweep does not depend on that
	// (it activates a whole equal-`lo` run before picking an owner), but it costs nothing and is tidy.
	function dispatchIntervalsSortedByLo(raw DispatchIntervalArray) returns DispatchIndexArray
		let n = raw.count()
		let order = DispatchIndexArray.create(n, zeroed: false)

		for i in 0 upto n 'seed'
			order.push(i)
		end 'seed'

		let scratch = FixedDispatchIndexArray.create(n)
		self.mergeSortDispatchIndices(raw, order: order, scratch: scratch, lo: 0, hi: n)
		return order
	end 'dispatchIntervalsSortedByLo'

	// Merge-sort `order[lo, hi)` by `raw[·].lo`, using `scratch` as the merge buffer. Recursion depth is
	// log n and each level touches each slot once, so O(n log n).
	function mergeSortDispatchIndices(raw DispatchIntervalArray, order DispatchIndexArray, scratch FixedDispatchIndexArray, lo ElementIndex, hi ElementIndex)
		if hi - lo <= 1 'base'
			return
		end 'base'

		let mid = lo + (hi - lo) / 2
		self.mergeSortDispatchIndices(raw, order: order, scratch: scratch, lo: lo, hi: mid)
		self.mergeSortDispatchIndices(raw, order: order, scratch: scratch, lo: mid, hi: hi)

		var i = lo
		var j = mid
		var k = lo

		while i < mid and j < hi 'merge'
			let leftIdx = try order.get(i) otherwise panic("mergeSortDispatchIndices: order.get OOB at {i}")
			let rightIdx = try order.get(j) otherwise panic("mergeSortDispatchIndices: order.get OOB at {j}")

			// `<=` takes the left (lower-index) element on a tie, which is what makes the sort stable.
			if self.dispatchLoOf(raw, index: leftIdx) <= self.dispatchLoOf(raw, index: rightIdx) 'takeLeft'
				try scratch.set(k, value: leftIdx) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
				i = i + 1
			end 'takeLeft' else 'takeRight'
				try scratch.set(k, value: rightIdx) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
				j = j + 1
			end 'takeRight'

			k = k + 1
		end 'merge'

		while i < mid 'drainLeft'
			try scratch.set(k, value: try order.get(i) otherwise panic("mergeSortDispatchIndices: order.get OOB at {i}")) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
			i = i + 1
			k = k + 1
		end 'drainLeft'

		while j < hi 'drainRight'
			try scratch.set(k, value: try order.get(j) otherwise panic("mergeSortDispatchIndices: order.get OOB at {j}")) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
			j = j + 1
			k = k + 1
		end 'drainRight'

		for t in lo upto hi 'copyBack'
			try order.set(t, value: try scratch.get(t) otherwise panic("mergeSortDispatchIndices: scratch.get OOB at {t}")) otherwise panic("mergeSortDispatchIndices: order.set OOB at {t}")
		end 'copyBack'
	end 'mergeSortDispatchIndices'

	// Push `value` (an interval index, and thereby its arm priority) onto the min-heap, sifting it up until
	// its parent is no larger. O(log heap).
	function dispatchHeapPush(heap DispatchIndexArray, value ElementIndex)
		heap.push(value)
		var child = heap.count() - 1

		while child > 0 'siftUp'
			let parent = (child - 1) / 2
			let parentVal = try heap.get(parent) otherwise panic("dispatchHeapPush: heap.get OOB at parent {parent}")
			let childVal = try heap.get(child) otherwise panic("dispatchHeapPush: heap.get OOB at child {child}")

			if parentVal <= childVal 'ordered'
				break
			end 'ordered'

			try heap.set(parent, value: childVal) otherwise panic("dispatchHeapPush: heap.set OOB at parent {parent}")
			try heap.set(child, value: parentVal) otherwise panic("dispatchHeapPush: heap.set OOB at child {child}")
			child = parent
		end 'siftUp'
	end 'dispatchHeapPush'

	// Remove and return the smallest interval index (earliest arm) on the heap, re-heaping the tail. O(log
	// heap). The caller guarantees the heap is non-empty.
	function dispatchHeapPopMin(heap DispatchIndexArray) returns ElementIndex
		let top = try heap.get(0) otherwise panic("dispatchHeapPopMin: heap.get(0) on empty heap")
		let tail = try heap.pop() otherwise panic("dispatchHeapPopMin: pop on empty heap")
		let count = heap.count()

		if count == 0 'wasLast'
			return top
		end 'wasLast'

		try heap.set(0, value: tail) otherwise panic("dispatchHeapPopMin: heap.set(0) after refill")
		var parent = 0 as ElementIndex

		while true 'siftDown'
			let left = parent * 2 + 1

			if left >= count 'leaf'
				break
			end 'leaf'

			var smaller = left
			let right = left + 1

			if right < count 'hasRight'
				let leftVal = try heap.get(left) otherwise panic("dispatchHeapPopMin: heap.get OOB at left {left}")
				let rightVal = try heap.get(right) otherwise panic("dispatchHeapPopMin: heap.get OOB at right {right}")

				if rightVal < leftVal 'rightSmaller'
					smaller = right
				end 'rightSmaller'
			end 'hasRight'

			let parentVal = try heap.get(parent) otherwise panic("dispatchHeapPopMin: heap.get OOB at parent {parent}")
			let smallerVal = try heap.get(smaller) otherwise panic("dispatchHeapPopMin: heap.get OOB at smaller {smaller}")

			if parentVal <= smallerVal 'ordered'
				break
			end 'ordered'

			try heap.set(parent, value: smallerVal) otherwise panic("dispatchHeapPopMin: heap.set OOB at parent {parent}")
			try heap.set(smaller, value: parentVal) otherwise panic("dispatchHeapPopMin: heap.set OOB at smaller {smaller}")
			parent = smaller
		end 'siftDown'

		return top
	end 'dispatchHeapPopMin'

	// ⭐ **EMIT A `match`'s DISPATCH from its normalized interval plan** — the ONE place the strategy is
	// chosen. Below `MinIntervalsForDispatch` intervals it is a linear compare chain; at or above it a
	// balanced binary search over the sorted disjoint intervals. Every compare reads `subject` (loaded
	// once, in `entry`, and left in a register across the whole tree); a value in NO interval reaches
	// `miss.targetBlockId` (the `default` body, or a `dead` block for an exhaustive enum). NO new IR op — internal
	// nodes compare `subject < pivot` and leaves test their interval, all with the same `compare`/
	// `condBranch` the chain used, so the backend and every later pass are untouched.
	function emitMatchDispatch(func IrFunction, entryId BlockId, subject ValueId, intervals DispatchIntervalArray, miss DispatchMiss, opTok Token) throws SourceParseError
		let entry = try self.blockById(func, id: entryId) otherwise panic("emitMatchDispatch: the dispatch entry block {entryId} is not in its own function")
		try self.emitDispatchRange(func, from: 0, to: intervals.count(), block: entry, subject: subject, intervals: intervals, miss: miss, opTok: opTok)
	end 'emitMatchDispatch'

	// The recursion. `[from, to)` is a contiguous slice of the sorted disjoint intervals. A short slice is
	// a chain; a long one splits on the median interval's lower bound — every interval below the pivot lies
	// in the left half and every one at or above it in the right (sorted + disjoint), so both halves are
	// non-empty (the count is at least `MinIntervalsForDispatch`) and the recursion terminates.
	function emitDispatchRange(func IrFunction, from ElementIndex, to ElementIndex, block IrBlock, subject ValueId, intervals DispatchIntervalArray, miss DispatchMiss, opTok Token) throws SourceParseError
		let count = to - from

		if count < MinIntervalsForDispatch 'chain'
			try self.emitDispatchChain(func, from: from, to: to, block: block, subject: subject, intervals: intervals, miss: miss, opTok: opTok)
			return
		end 'chain'

		// A DENSE run — the covered value span is tight enough (see the three density caps) — becomes an
		// O(1) indexed jump TABLE rather than a compare tree. Tried at EVERY level, so a dense sub-range at a
		// binary-search leaf tabulates itself too (the recursion below only reaches sparse regions).
		let table = self.planDispatchTable(from, to: to, intervals: intervals)

		if table.isTable 'dense'
			self.emitDispatchTable(from, to: to, block: block, subject: subject, intervals: intervals, plan: table, miss: miss, opTok: opTok)
			return
		end 'dense'

		let mid = from + count / 2
		let pivot = (try intervals.get(mid) otherwise panic("emitDispatchRange: intervals.get OOB at pivot {mid}")).lo
		self.bodyState.currentBlock = block
		let cond = self.emitCompareAgainstLiteral(subject, literal: pivot, op: MaxonCmpOp.lt, opTok: opTok)

		// `var` because each half is emitted INTO its block by the recursive call, which mutates it — the
		// same mutating-parameter sensitivity `emitMatchDispatch`'s `entry` carries.
		let lowerBlock = self.artifact.module.addBlock(func, label: b"matchlo", heat: BlockHeat.normal)
		let upperBlock = self.artifact.module.addBlock(func, label: b"matchhi", heat: BlockHeat.normal)

		// The internal branch routes between two sub-TESTS, not to an arm body — neither target carries a
		// carried-var phi (both are dominated by `entry`, where the pre-match values still hold), so the
		// branch records no edge args.
		self.emitCondBranch(block, cond: cond, thenId: lowerBlock.id, elseId: upperBlock.id, ifTok: opTok)
		try self.emitDispatchRange(func, from: from, to: mid, block: lowerBlock, subject: subject, intervals: intervals, miss: miss, opTok: opTok)
		try self.emitDispatchRange(func, from: mid, to: to, block: upperBlock, subject: subject, intervals: intervals, miss: miss, opTok: opTok)
	end 'emitDispatchRange'

	// ⭐ **DECIDE WHETHER A DENSE RUN IS WORTH A JUMP TABLE**, reporting the bias (its minimum) and the
	// slot count (the span). Reject on the covered WIDTH exceeding the span cap, on the span
	// outrunning the per-interval slot budget, then on the density falling below 2/5. `intervals` is
	// sorted disjoint, so `intervals[from].lo` is the minimum and `intervals[to-1].hi` the maximum.
	// Everything is measured MODULO 2^64 (a span crossing zero, or one reaching an open bound, is a
	// real span, not an overflow), so the width is compared without ever forming a difference that
	// would overflow `i64` — see `spanWithinCap`.
	function planDispatchTable(from ElementIndex, to ElementIndex, intervals DispatchIntervalArray) returns DispatchTablePlan
		let bias = (try intervals.get(from) otherwise panic("planDispatchTable: intervals.get OOB at from {from}")).lo
		let maxHi = (try intervals.get(to - 1) otherwise panic("planDispatchTable: intervals.get OOB at to-1 {to - 1}")).hi

		// Reject on the covered WIDTH exceeding the cap WITHOUT forming `maxHi - bias`, which overflows i64
		// when the span crosses far into both halves (e.g. `i64.min`..`i64.max`). `maxHi >= bias` always
		// (sorted, disjoint), so the modular width is a mathematical value in `[0, 2^64)`; it is `< cap` iff
		// `maxHi` sits within the `cap`-wide window above `bias`, which `spanWithinCap` tests overflow-safely.
		if not spanWithinCap(bias, maxHi: maxHi) 'tooWide'
			return DispatchTablePlan.notTable()
		end 'tooWide'

		// Both operands are now within `MaxTableSpanSlots` of each other, so `maxHi - bias` fits i64.
		let span = maxHi - bias + 1

		// The table must earn its slots against the compares it removes, not merely against the values it
		// covers (`MaxTableSlotsPerInterval`). `to - from` is the interval count; the product fits i64
		// (span <= 4096, the count is bounded by the arm count).
		if span > ((to - from) as FullRangeInt) * MaxTableSlotsPerInterval 'sparse'
			return DispatchTablePlan.notTable()
		end 'sparse'

		var coveredSlots = 0 as FullRangeInt

		for i in from upto to 'each'
			let interval = try intervals.get(i) otherwise panic("planDispatchTable: intervals.get OOB at {i}")
			coveredSlots = coveredSlots + (interval.hi - interval.lo + 1)
		end 'each'

		// Dense iff covered/span >= 2/5, kept as a cross-multiply so no division rounds. Both products fit
		// i64 (each factor <= 4096 * 5).
		if coveredSlots * MinTableDensityDenominator < span * MinTableDensityNumerator 'sparse'
			return DispatchTablePlan.notTable()
		end 'sparse'

		return DispatchTablePlan.tableWith(bias, span: span)
	end 'planDispatchTable'

	// Is the modular width `maxHi - bias` (unsigned) strictly below `MaxTableSpanSlots`? Answered WITHOUT
	// forming the difference, which overflows i64 for a span straddling both halves. `maxHi >= bias`
	// (signed) is the caller's invariant, so the width is `maxHi - bias` as a true mathematical integer in
	// `[0, 2^64)`. It is below the cap iff `maxHi` is at most `bias + (cap - 1)`:
	//   • when `bias + (cap - 1)` does NOT overflow i64 (`bias <= i64.max - (cap - 1)`), that is a plain
	//     signed compare;
	//   • when it WOULD overflow, `bias` is within `cap` of `i64.max`, so `maxHi` (<= i64.max) is
	//     necessarily within the window — accept.
	function spanWithinCap(bias FullRangeInt, maxHi FullRangeInt) returns bool
		let lastSlot = MaxTableSpanSlots - 1

		if bias > I64MaxBound - lastSlot 'windowReachesTop'
			return true
		end 'windowReachesTop'

		return maxHi <= bias + lastSlot
	end 'spanWithinCap'

	// ⭐ **EMIT A DENSE RUN AS A JUMP TABLE.** Bias the subject to a zero-based index (`subject − min`, a
	// modular subtract, so an out-of-range subject wraps to a large unsigned value the target op's UNSIGNED
	// bounds check sends to the default), build the dense block-id table (each interval fills its several
	// slots; holes are the default), record the phi edges for the distinct arm bodies and the default, then
	// emit the `switch` terminator. The bias subtract is elided when the minimum is 0 (a zero-based enum or
	// scalar match), so `match Color` over `red=0…` biases nothing.
	function emitDispatchTable(from ElementIndex, to ElementIndex, block IrBlock, subject ValueId, intervals DispatchIntervalArray, plan DispatchTablePlan, miss DispatchMiss, opTok Token)
		self.bodyState.currentBlock = block

		var index = subject

		if plan.bias != 0 'bias'
			index = self.emitBiasIndex(subject, bias: plan.bias, opTok: opTok)
		end 'bias'

		// Every slot in `[min, max]` needs a target; the ones no interval covers are the default. An
		// `or`-list simply fills several slots. `growFilled` from an empty array fills every one of `span`
		// slots with the default.
		let targets = BlockIdArray.create(plan.span as ElementIndex, zeroed: false)
		targets.growFilled(plan.span as ElementIndex, value: miss.targetBlockId)

		for i in from upto to 'eachInterval'
			let interval = try intervals.get(i) otherwise panic("emitDispatchTable: intervals.get OOB at {i}")

			// Walk SLOT indices (`lo - bias` … `hi - bias`), never VALUES: a value-driven loop over an
			// interval ending at `i64.max` would never terminate. Both offsets are in `[0, span)` (the
			// interval lies within the covered span), so the subtraction cannot overflow.
			let firstSlot = (interval.lo - plan.bias) as ElementIndex
			let lastSlot = (interval.hi - plan.bias) as ElementIndex

			for slot in firstSlot upto (lastSlot + 1) 'fill'
				try targets.set(slot, value: interval.targetBlockId) otherwise panic("emitDispatchTable: targets.set OOB at slot {slot} (span {plan.span})")
			end 'fill'
		end 'eachInterval'

		// The phi args each dispatch edge carries. An arm body is a phi target only when it is a fall-through
		// target (`setupFallthroughTargetPhis` stamped its intervals' `edgeArgs`); the default carries
		// `miss.edgeArgs`. `recordBranchEdge` is a no-op for an empty arg list, so a phi-less table costs nothing
		// here. Recorded ONCE per distinct target — an or-arm or a split range reaches one body through
		// several intervals, all carrying the SAME snapshot, so a second edge to it would double-apply the
		// copy at SSA destruction.
		self.recordBranchEdge(block, targetId: miss.targetBlockId, argIds: miss.edgeArgs)
		let seen = BlockIdSet.create()

		for i in from upto to 'eachEdge'
			let interval = try intervals.get(i) otherwise panic("emitDispatchTable: intervals.get OOB at {i}")

			if not seen.contains(interval.targetBlockId) 'firstEdge'
				seen.insert(interval.targetBlockId)
				self.recordBranchEdge(block, targetId: interval.targetBlockId, argIds: interval.edgeArgs)
			end 'firstEdge'
		end 'eachEdge'

		self.emitBodyTerminator(block, op: MaxonOp.switch(index, denseTargetBlockIds: targets, defaultBlockId: miss.targetBlockId), range: SourceRange.ofToken(opTok))
	end 'emitDispatchTable'

	// The zero-based table index `subject − bias`, emitted as a RAW `binOp(sub)` that MINTS an `integer`
	// result and bypasses `emitBinOp`'s operand type check — exactly as `emitCompareAgainstLiteral` emits a raw
	// `compare`. The bypass is the point: a SCALAR enum's dispatch subject is a `named(<Enum>)` value, and
	// arithmetic on an enum is a user-level type error — but this is not user arithmetic, it is the compiler
	// REINTERPRETING the tag bits as the integer index the jump table needs. The subtraction is MODULAR
	// (i64 wraparound), so a subject outside the covered span wraps to a large unsigned value the target op's
	// UNSIGNED bounds check routes to the default. The Std tier collapses the `named` operand to i64
	// (`stdTypeOf`), so the lowered `sub` is an ordinary i64 subtract.
	function emitBiasIndex(subject ValueId, bias FullRangeInt, opTok Token) returns ValueId
		let biasLit = self.emitLiteral(bias, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(result, lhs: subject, rhs: biasLit, op: MaxonBinOp.sub), range: SourceRange.ofToken(opTok))
		return result
	end 'emitBiasIndex'

	// A leaf region: test each interval in turn, branching to its arm body on a hit and to the next test
	// (or `miss.targetBlockId` after the last) on a miss. When `miss.isUnreachable` the last interval
	// is not tested: its arm is entered unconditionally. `recordBranchEdge` is a no-op for an empty arg list, so
	// the internal chain edges (no phis) and a phi-less body/miss cost nothing.
	function emitDispatchChain(func IrFunction, from ElementIndex, to ElementIndex, block IrBlock, subject ValueId, intervals DispatchIntervalArray, miss DispatchMiss, opTok Token) throws SourceParseError
		// A default-only planned match (`match x 'c' default gives … end`) collects NO intervals — every
		// value is a miss — so the entry unconditionally branches to the default, with no compare. The
		// tree recursion never reaches here empty (it splits only at count >= 4 into two non-empty halves),
		// so this is the top-level empty plan alone, but handling it here keeps the terminator obligation in
		// one place.
		if from == to 'noIntervals'
			self.recordBranchEdge(block, targetId: miss.targetBlockId, argIds: miss.edgeArgs)
			self.emitBranch(block, targetId: miss.targetBlockId)
			return
		end 'noIntervals'

		var current = block

		for i in from upto to 'each'
			let interval = try intervals.get(i) otherwise panic("emitDispatchChain: intervals.get OOB at {i}")
			let isLast = i == to - 1

			if isLast and miss.isUnreachable 'lastTestIsImplied'
				self.recordBranchEdge(current, targetId: interval.targetBlockId, argIds: interval.edgeArgs)
				self.emitBranch(current, targetId: interval.targetBlockId)
				return
			end 'lastTestIsImplied'

			self.bodyState.currentBlock = current
			let cond = try self.emitIntervalHitTest(subject, lo: interval.lo, hi: interval.hi, opTok: opTok)

			var elseTarget = miss.targetBlockId
			var elseArgs = miss.edgeArgs

			// ⚠ **THE CURSOR ADVANCES BY ID, NOT BY A SECOND NAME FOR `current`.** `var nextBlock = current`
			// would MOVE the loop-carried block out of the loop (E2015); a `BlockId` is a scalar and carries
			// no ownership, so the fetch below is what re-seats the cursor — and on the last test it re-seats
			// it to the block it already names, which is what the chain's final `else` edge wants.
			var nextId = current.id

			if not isLast 'moreTests'
				nextId = self.artifact.module.addBlock(func, label: b"matchnext", heat: BlockHeat.normal).id
				elseTarget = nextId
				elseArgs = ValueIdArray.create(0)
			end 'moreTests'

			self.recordBranchEdge(current, targetId: interval.targetBlockId, argIds: interval.edgeArgs)
			self.recordBranchEdge(current, targetId: elseTarget, argIds: elseArgs)
			self.emitCondBranch(current, cond: cond, thenId: interval.targetBlockId, elseId: elseTarget, ifTok: opTok)
			current = try self.blockById(func, id: nextId) otherwise panic("emitDispatchChain: the chain's next test block {nextId} is not in its own function")
		end 'each'
	end 'emitDispatchChain'

	// The boolean "does `subject` fall in `[lo, hi]`?": an `==` for a point, a two-sided `>=`/`<=` `and`
	// for a range, one open compare when a bound is `i64.min`/`i64.max` (the redundant side elided, exactly
	// as `emitOpenLowerRange`/`emitClosedRange` treat an open bound), and a constant `true` for a
	// min-to-max interval that covers everything (a sole all-covering arm — after clipping it can only be
	// the whole plan, since it would subsume any later arm).
	function emitIntervalHitTest(subject ValueId, lo FullRangeInt, hi FullRangeInt, opTok Token) returns ValueId throws SourceParseError
		if lo == hi 'point'
			return self.emitCompareAgainstLiteral(subject, literal: lo, op: MaxonCmpOp.eq, opTok: opTok)
		end 'point'

		let needLo = lo > I64MinBound
		let needHi = hi < I64MaxBound

		if needLo and needHi 'closed'
			let loCmp = self.emitCompareAgainstLiteral(subject, literal: lo, op: MaxonCmpOp.ge, opTok: opTok)
			let hiCmp = self.emitCompareAgainstLiteral(subject, literal: hi, op: MaxonCmpOp.le, opTok: opTok)
			return try self.emitBinOp(loCmp, rhs: hiCmp, op: MaxonBinOp.bitAnd, opTok: opTok)
		end 'closed'

		if needLo 'openUpper'
			return self.emitCompareAgainstLiteral(subject, literal: lo, op: MaxonCmpOp.ge, opTok: opTok)
		end 'openUpper'

		if needHi 'openLower'
			return self.emitCompareAgainstLiteral(subject, literal: hi, op: MaxonCmpOp.le, opTok: opTok)
		end 'openLower'

		return self.emitLiteral(BoolTrueValue, valueType: MaxonType.boolean, range: SourceRange.ofToken(opTok))
	end 'emitIntervalHitTest'

	// Mint a phi (block-arg) on `block` and return its fresh ValueId. The ONE mint site for
	// every merge phi the parser makes — if-continuation, loop header, loop exit, and
	// the short-circuit merge — so a phi's Maxon-tier type is recorded in
	// lockstep with its id at all four.
	//
	// The `argType` passed here is a PLACEHOLDER, overwritten before anything reads it:
	// `LowerMaxonToStd.retypeBlockArgs` is the authority and sets every phi's Std type from the tag
	// column (it explains why the parser is the wrong tier to decide it). A phi's Maxon-tier type is
	// the `tag` recorded below, and that is the only type this function knows.
	//
	// ⚠ IT MUST BE OVERWRITTEN, AND SKIPPING THAT IS A COMPILER CRASH: a hardcoded `i64` is
	// harmless only while every value lives in a GPR; once `argType` chooses a phi's REGISTER
	// FILE, a float phi is coloured into a GPR and the SSA-destruction copy panics the x64
	// emitter. See `float-phi-*` in specs/float-type.md.
	//
	// ⚠ **EVERY PHI IS MINTED WITH ITS RANGED-ALIAS CLAIM WITHHELD.** The `nameId` above comes from ONE
	// incoming edge, so it is the type the merge was DECLARED with and not a statement about the values that
	// will reach it — see `aliasUnprovenMarks` for the three wrong answers reading it as a proof produced.
	// Withholding it HERE rather than at each of the eight call sites is what makes the safe answer the
	// DEFAULT: a future merge inherits it, and only a site holding the complete incoming set can lift it
	// (`recordMergeAliasProof`).
	function mintPhi(block IrBlock, tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let phiId = self.mintDetachedPhi(tag, nameId: nameId)
		self.attachDetachedPhi(block, phi: phiId)
		return phiId
	end 'mintPhi'

	function mintDetachedPhi(tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let phiId = self.mintValue(tag, nameId: nameId)
		try self.bodyState.aliasUnprovenMarks.set(phiId, value: true) otherwise panic("mintDetachedPhi: v{phiId} has no merge-alias slot — every SSA value must be minted through mintValue, which seeds the column")
		return phiId
	end 'mintDetachedPhi'

	function attachDetachedPhi(block IrBlock, phi ValueId)
		block.blockArgs.push(IrBlockArg.create(phi, argType: StdType.i64))
	end 'attachDetachedPhi'

	// ⭐⭐ **LIFT A MERGE'S WITHHELD ALIAS CLAIM — the ONE place `mintPhi`'s blanket withholding is undone,
	// and it is undone only against the COMPLETE incoming set.** A merge denotes alias `A` exactly when every
	// value that can reach it already denoted a range inside `A`; each such value carries its own proof by the
	// induction `rangeCoversDenotedRange`'s header states, so the meet over the edges is the honest claim and
	// the range-check elision stays legitimate wherever it is legitimate.
	//
	// ⚠ **THE TEST IS WHETHER THE EDGES ARE ALL KNOWN AT THE MINT, AND IT IS THE ONLY TEST** — four merges
	// pass it: a `try … otherwise <expr>` continuation, a `match`/ternary RESULT, an `if` CONTINUATION's
	// carried binding (`mergeAtContinuation`) and a `match`'s carried binding (`finalizeMatchMerge`'s
	// `setBindings`). What keeps the claim withheld is a merge that CANNOT answer, never one whose edges
	// merely came from an assignment: an ASSIGNMENT is a door on no tier, which is precisely why every edge
	// is asked to prove itself rather than trusted for its shape.
	//
	// ⚠ **WHAT STILL CANNOT ASK IS A BACK EDGE.** A loop HEADER (`mintPhiForBinding` from the
	// while/for header, the `for` index, the step phi) is minted before its back edge is parsed, and a
	// loop EXIT phi merges that header phi — so its claim is withheld transitively, which is the same
	// answer reached for free rather than a second rule. ⛔ **THE FOUR `mintPhiForBinding` SITES ARE
	// NOT ONE CASE, AND LUMPING THEM COSTS TWO WRONG ANSWERS**: an `if`-merged `Num` var returned
	// through a `returns Num` grows a cascade two entry guards have already proved, and `t as Num` on
	// it loses its E3010. A merge that CAN answer and is not asked is not the safe direction — it is a
	// second defect pointing the other way.
	//
	// ⭐ **THIS IS WHY `try/otherwise` LOOKED IMMUNE AND IS NOT.** `otherwise 0` keeps its elision here — the
	// ok edge is the callee's own guarded `return` and the fallback is a literal `requireOtherwiseInRangedReturn`
	// already refused out of range — which is exactly the shape the defect was probed with. MEASURED: swap the
	// literal for a variable (`otherwise w`, `w == 5000`) and the fallback is NOT checked (that function's
	// header says so outright), so the merge claimed `Num` over `5000` and `return`ed it unguarded. One rule
	// covers both: the literal edge proves, the variable edge does not.
	//
	// ⚠ It runs AFTER the edge values are final, not at the mint, so an ownership promotion
	// (`promoteBorrowedMergeEdge`) cannot leave it judging a value the edge no longer carries.
	//
	// ⚠ **IT ASKS THE PHI'S OWN TYPE COLUMNS — `declaredAliasOfValue`, WHICH IS TAG-GATED, AND THE GATE IS NOT
	// OPTIONAL.** A name id is only a real interner entry when the tag is `named`; a merge of any other class
	// carries `UnnamedTypeId`, and handing that to `declaredAliasOfNameId` reads whatever name the interner
	// gave id 0 — which is the FIRST name the file mentioned, since the table starts empty. Both existing
	// readers (`declaredAliasOfValue`, `declaredAliasOfType`) gate on the tag first, so this asks through one
	// of them rather than spelling a third copy of the gate — and reading the PHI rather than the values it
	// was named from is what stops the claim being judged against a type the phi does not actually carry.
	//
	// ⛔ **THE GATE IS NECESSARY AND NOT SUFFICIENT, AND THAT COST A WRONG ANSWER.** The filler id
	// is INDISTINGUISHABLE from the first real name, so a `named`-tagged value carrying it resolves to a
	// stranger rather than to nothing — there is no guard `declaredAliasOfNameId` could add. The obligation
	// is therefore on every MINT: a value tagged `named` must carry a real name id. See `emitUnaryOp`, which
	// did not, and what that printed.
	//
	// ⚠ `declaredAliasOfValue`, NOT `provenAliasOfValue`: this is deciding whether to LICENSE the declared
	// claim, so it must read the claim. The proof-aware reader answers `undeclared` for every phi by
	// construction at this point, which would make the lift unreachable.
	function recordMergeAliasProof(phiId ValueId, incoming ValueIdArray)
		self.admitUnsignedLiteralsAcross(incoming)
		self.liftMergeAliasClaim(phiId, incoming: incoming)
	end 'recordMergeAliasProof'

	function liftMergeAliasClaim(phiId ValueId, incoming ValueIdArray)
		match self.declaredAliasOfValue(phiId) 'dest'
			// The merge names no ranged alias, so there is no claim to lift and nothing downstream reads one.
			undeclared then break
			declared(alias) then self.recordMergeAliasProofAgainst(phiId, alias: alias, incoming: incoming)
		end 'dest'
	end 'liftMergeAliasClaim'

	// The half above that has the destination range in hand: resolved ONCE and reused across the edges,
	// because `declaredAliasOfNameId` CONSTRUCTS its `DeclaredAlias` (a probe per edge would be a probe per arm).
	function recordMergeAliasProofAgainst(phiId ValueId, alias RangedTypeAlias, incoming ValueIdArray)
		for value in incoming 'eachEdge'
			if not self.edgeProvesAlias(value, alias: alias) 'edgeProvesNothing'
				return
			end 'edgeProvesNothing'
		end 'eachEdge'

		try self.bodyState.aliasUnprovenMarks.set(phiId, value: false) otherwise panic("recordMergeAliasProofAgainst: v{phiId} has no merge-alias slot — a phi is minted through mintPhi, which sets it")
	end 'recordMergeAliasProofAgainst'

	// ⭐ **DOES ONE INCOMING EDGE PROVABLY LIE INSIDE `alias`? — THE SAME PAIR OF TESTS A DOOR APPLIES,
	// AND THE PAIR IS SPLIT ACROSS TWO TIERS RATHER THAN HELD BY ONE FUNCTION.** A door reaches "no
	// guard" two ways and only two: the value already denotes a range the destination covers — asked
	// HERE, at the parse, by `recordRangedTargetSite`/`recordRangedReturnSite` through the shared
	// `rangeCoversDenotedRange` — or it is a compile-time constant of the destination's own domain
	// that lands inside it, which `InsertRangeChecks.needsRuntimeGuard` asks of the recorded site. A
	// merge is not a door, but *"is this value in range"* is the door's question, so it is answered
	// out of the same two rules rather than a third way; the containment arithmetic itself
	// (`rangeCoversDenotedRange`, `literalInRange`) is `TypeRules`', spelled once for every asker.
	//
	// ⚠ The CONSTANT half reads the PARSER's const columns while `needsRuntimeGuard` reads the Std pass's
	// `intConsts`/`floatConsts`, and the two need not agree. Neither disagreement is a wrong answer, and the
	// direction is what says so: the parser knowing a constant the pass does not still proves the value is
	// in range (a folded literal is one at run time whatever a later tier knows), and the pass knowing one
	// the parser does not merely leaves the claim withheld — a guard the pass then elides itself.
	//
	// ⚠ **THE CONSTANT ARM IS WHAT KEEPS `try f() otherwise 0` ELIDING.** A folded literal denotes NO alias —
	// `rangeCoversDenotedRange`'s header calls that out as the direction that keeps the guard — so the first
	// test alone would withhold the claim from the corpus's most common fallback and re-emit a cascade over a
	// value that cannot fail it, which is the defect the elision exists to delete.
	//
	// ⚠ **THE DOMAIN IS PART OF THE TEST, not decoration** — a float `const`'s payload is an IEEE-754 bit
	// pattern and an integer's is a number, so reading one as the other would compare two things that were
	// never the same kind of number. Same split, same reason, as `needsRuntimeGuard`'s two const maps.
	function edgeProvesAlias(value ValueId, alias RangedTypeAlias) returns bool
		if rangeCoversDenotedRange(alias, source: self.valueDenotedAlias(value)) 'denotesACoveredRange'
			return true
		end 'denotesACoveredRange'

		if aliasIsFloat(alias) 'floatAlias'
			return self.floatConstIsKnown(value) and literalInRange(self.floatConstBitsOf(value), low: alias.low, high: alias.high, isFloat: true, writtenNegative: false, writtenAboveSignedMax: false)
		end 'floatAlias'

		// ⚠ **THE WRITTEN-NEGATIVE MARK BELONGS HERE FOR THE SAME REASON IT BELONGS AT THE DOOR.** This arm
		// PROVES an edge in range, and a proof made from the pattern alone would prove `-1` is in
		// `int(0 to u64.max)` — the very claim `literalInRange`'s `writtenNegative` exists to refuse — and
		// would then withhold the site whose E3005 says so. The float arm passes `false` because a float
		// alias's bounds are IEEE-754 patterns that `floatOrderKey` already orders by VALUE, so there is no
		// signed/unsigned ambiguity for a mark to resolve.
		return self.constIsKnown(value) and literalInRange(self.constOf(value), low: alias.low, high: alias.high, isFloat: false, writtenNegative: valueIsMarked(self.bodyState.writtenNegativeLiterals, value: value), writtenAboveSignedMax: self.valueIsAboveSignedMax(value))
	end 'edgeProvesAlias'

	// The phi a MERGED BINDING carries: its type is the binding's declared one, which the
	// binding already holds as a `MaxonType`, so decomposing it constructs nothing.
	//
	// ⭐ **PROPAGATE THE PROMISE MARK ACROSS THE MERGE.** `valueOwnsGreenThread` is a
	// per-SSA-value mark that a merge phi does not otherwise carry, so a re-armed `var p` (whose value after a
	// loop / branch IS this phi) would lose its promise identity — its scope-exit drop would misroute to
	// `__mm_decref` on a GT pointer, and `await p` on the phi would be rejected as "not a promise". A promise
	// var's phi merges promises on EVERY reaching edge (each value it holds is a spawn handle), so the mark is
	// read off the value flowing IN here (`binding.boundValue`) and stamped on the phi. The ONE choke point
	// for loop-header, loop-exit, if-continuation and match phis, so all four inherit it at once.
	function mintPhiForBinding(block IrBlock, binding VarInfo) returns ValueId
		let phiId = self.mintPhi(block, tag: maxonTypeTag(binding.varType), nameId: typeNameIdOf(binding.varType))
		try self.bodyState.aliasUnprovenMarks.set(phiId, value: false) otherwise panic("mintPhiForBinding: v{phiId} has no merge-alias slot — mintPhi mints through mintValue, which seeds the column")
		self.wearAliasOf(phiId, source: binding.boundValue)

		// The merge of a binding's values wears the binding's own brand, which every rebind was checked against.
		try self.bodyState.valueBrandIds.set(phiId, value: binding.brandId) otherwise panic("mintPhiForBinding: v{phiId} has no brand slot — mintPhi mints through mintValue, which seeds the column")
		self.carryCapability(binding.boundValue, target: phiId)

		if self.capabilityOfValue(phiId) == ProvisionalForAUse and self.valueSettlesAfterParsing(binding.boundValue) 'startsAsAPendingResult'
			self.addSettlingArms(phiId, incoming: binding.boundValue)
		end 'startsAsAPendingResult'

		self.bodyState.mergedBindingValues = withValueMarked(self.bodyState.mergedBindingValues, value: phiId)

		if self.valueOwnsGreenThread(binding.boundValue) 'promisePhi'
			self.markValuePromise(phiId)
		end 'promisePhi'

		// ⭐⭐ **A MERGED BINDING STILL OWNS ITS HEAP, AND THE PHI IS WHERE THAT FACT CAN GO MISSING.** A phi is
		// minted through `mintPhi`, which seeds `valueOwnsHeap` FALSE like every fresh value — but this phi is
		// not a fresh value, it is the same allocation the binding already owned, renamed at a join. Left false,
		// the merged name reads as BORROWED to every door that asks, and the next thing done with it mints a
		// reference nothing owns.
		//
		// ⛔⛔ **LEFT FALSE, IT IS EXIT 101 IN THE COMPILER'S OWN SELF-COMPILE.** `emitDispatchChain`'s
		// `var nextBlock = current` / `if not isLast  nextBlock = self.artifact.module.addBlock(…)  end` / `current = nextBlock`
		// leaks one `IrBlock` — eight allocations — per `matchnext` block, so every `match` of 2 or 3 intervals
		// (below `MinIntervalsForDispatch`, hence a compare chain) leaks and every larger one does not (a jump
		// table mints no chain block). The rebind door reads `valueIsOwnedHeap(phi)` as false and does BOTH
		// halves of two different answers: `poisonMoveSource` marks the source moved-from (a MOVE, so nothing
		// drops it) and `promoteBorrowed` then emits an `__mm_retain` (a CO-OWN, so something must). One
		// reference, no owner. The `if` alone does not leak and the assignment alone does not leak; it takes the
		// join between them, which is why nothing smaller than a self-compile finds it.
		//
		// ⚠ The bit is read off the incoming the mint can see — `binding.boundValue`, the path parsed last —
		// and `pushMergedEdgeValue` checks every OTHER incoming against it, because a phi that owns on one edge
		// and borrows on another is an ownership question with no answer, not a mark to join. That holds
		// for resolved incomings only: an unresolved one (`unresolvedMergeValues`) leaves the phi owning
		// nothing.
		if self.valueIsDeferred(binding.boundValue) 'anUnresolvedIncoming'
			self.bodyState.unresolvedMergeValues = withValueMarked(self.bodyState.unresolvedMergeValues, value: phiId)
		end 'anUnresolvedIncoming' else if self.valueIsOwnedHeap(binding.boundValue) 'ownedBinding'
			self.markValueOwnsHeap(phiId, exclusivity: OwnedHeapExclusivity.sole if self.valueIsSoleHeapOwner(binding.boundValue) else OwnedHeapExclusivity.coOwned)

			if self.valueIsSolelyOwnedHere(binding.boundValue) 'aHandOffSource'
				self.markValueFromFreshReturn(phiId)
			end 'aHandOffSource'
		end 'ownedBinding'

		// ⭐⭐ **THE IMMUTABLE-GLOBAL-READ MARK CROSSES A BINDING MERGE, and this half alone is not enough — see
		// `pushMergedEdgeValue`.** The value flowing IN here is only ONE of the phi's incomings (the path parsed
		// last); the others arrive as edge args, which is why the twin below carries from each of them. Both are
		// needed and neither is redundant: this one covers a phi whose edges are pushed BEFORE it exists (the
		// loop join), the other covers a phi minted before its edges are known (the `if` continuation).
		// ⭐⭐ **AN EXISTENTIAL BINDING MERGES AS TWO PHIS, BECAUSE IT IS TWO VALUES.**
		// The witness half is not derivable at the merge — two arms may carry
		// two DIFFERENT conformers, and which one arrives is exactly what the branch decided — so it has to be
		// carried on the edges like any other loop- or branch-varying value.
		//
		// ⚠ **THIS IS THE ONE THING THE CORPUS'S MERGE CASE CANNOT TELL YOU IS MISSING.**
		// `cross-block-method-receiver`'s `interface-method-statement-after-if-merge` branches on a CONSTANT
		// and hands the SAME implementor to both parameters, so an implementation that carried only the value
		// half and re-used the receiver's original witness still prints the right answer. The compiler-authored
		// `interface-dispatch/dispatch-discriminating-merge` is the case that discriminates: two implementors
		// and a runtime-varying condition, asserting the branch-NOT-taken answer.
		//
		// ⚠ **THE WITNESS PHI IS MINTED IMMEDIATELY AFTER ITS DATA PHI, and every edge pushes the pair in the
		// same order (`pushMergedEdgeValue`).** Block-args and edge args are POSITIONAL, so that ordering IS
		// the pairing; the two are written as one mint and one push so a site cannot honour half of it.
		if bindingCarriesWitness(binding) 'existentialBinding'
			self.pairInterfaceWitness(phiId, witness: self.mintPhi(block, tag: ValueTypeTag.integer, nameId: UnnamedTypeId))
		end 'existentialBinding'

		return phiId
	end 'mintPhiForBinding'

	// ⭐ **PUSH WHAT ONE BINDING CONTRIBUTES TO AN EDGE — the twin of `mintPhiForBinding`.**
	// Every merge in the parser builds its edge args by pushing one value per
	// carried binding, and an existential contributes TWO in the order its phis were minted. Routed through
	// one helper so a merge that grows later cannot push the halves in the other order, or push only one.
	//
	// A non-existential value pushes exactly what it always did, so no existing edge moves.
	// ⭐ **A VALUE-PRODUCING MERGE MAY NOT YIELD AN EXISTENTIAL — REFUSED, NOT MISCOMPILED.**
	// A BINDING merged across a branch carries both halves of its fat pointer
	// (`mintPhiForBinding` + `pushMergedEdgeValue`); the two merges that produce a VALUE rather than rebinding
	// a name — a `match`/ternary's `gives`, and a `try … otherwise <expr>` — build their result phi and their
	// edge args through their own code, which pushes exactly one value per edge. Letting an existential
	// through there would mint a phi for the value half and NOTHING for the witness, and the first dispatch on
	// the result would read whatever the next block-arg slot happened to hold: a wrong function pointer, with
	// no diagnostic anywhere.
	//
	// It is a positioned refusal rather than a panic because a user can write it, and it names the mechanism
	// rather than the symptom. No case in the canonical corpus needs it — every existential merge there is a
	// `var` rebound across an `if` — so the door stays shut until a case asks for it.
	function refuseExistentialValueMerge(tag ValueTypeTag, what String, tok Token) throws SourceParseError
		if tag != ValueTypeTag.interfaceRef 'notAnExistential'
			return
		end 'notAnExistential'

		throw SourceParseError.unsupported("{what} is a value held at an interface type — {ExistentialIsFatPointerReason}, and a value-producing merge carries one word per branch. Bind the arms to a `var` of the interface type and merge THAT (a rebound binding carries both halves), or give a concrete type", line: tok.line, column: tok.column)
	end 'refuseExistentialValueMerge'

	function pushMergedEdgeValue(args ValueIdArray, binding VarInfo, value ValueId)
		args.push(value)

		if bindingCarriesWitness(binding) 'existentialBinding'
			args.push(self.witnessOfValue(value))
		end 'existentialBinding'

		// ⭐⭐ **AN INCOMING EDGE HANDS THE IMMUTABLE-GLOBAL-READ MARK TO THE PHI** — placed here because this is the ONE
		// routine every merge in the parser pushes every carried binding's incoming value through, which is the
		// same census argument its header already makes about the witness half. `binding.boundValue` is the
		// merged name's settled value at each of these call sites (the continuation phi at an `if`/`match`, the
		// exit phi at a loop), so a marked incoming makes the merged name marked.
		self.joinCapabilityInto(binding.boundValue, incoming: value)

		// One unresolved incoming (`unresolvedMergeValues`) makes the whole merge unresolved, and an
		// unresolved merge has no ownership to check below.
		if self.valueIsDeferred(value) 'anUnresolvedEdge'
			self.bodyState.unresolvedMergeValues = withValueMarked(self.bodyState.unresolvedMergeValues, value: binding.boundValue)
		end 'anUnresolvedEdge'

		if valueIsMarked(self.bodyState.unresolvedMergeValues, value: binding.boundValue) 'anUnresolvedMerge'
			return
		end 'anUnresolvedMerge'

		// ⭐⭐ **THE OWNERSHIP HALF OF THE SAME TWINNING** (see `mintPhiForBinding`). The mint stamped the phi
		// from ONE incoming; these are the others, and they must answer the same. They do, and the reason is
		// structural rather than lucky: only an ASSIGNED binding is ever carried into a merge, every such
		// binding is a `var`, and a `var`'s managed initializer is promoted to owned at its declaration
		// (`promoteBorrowedBinding`) — so no path can hand a carried binding a borrowed managed value. A
		// disagreement therefore means that promotion has a hole, which would leak or double-free with no
		// diagnostic anywhere; it fails loudly here instead.
		let phiOwns = self.valueIsOwnedHeap(binding.boundValue)

		if phiOwns != self.valueIsOwnedHeap(value) 'edgeDisagrees'
			panic("pushMergedEdgeValue: the merged binding's phi v{binding.boundValue} {"owns" if phiOwns else "does not own"} its heap but the incoming edge value v{value} {"does not" if phiOwns else "does"} — a carried binding is a `var` whose managed initializer is promoted to owned at declaration, so every incoming to its phi must agree; one edge minting a reference the merged name does not own is a leak, and the reverse is a double free")
		end 'edgeDisagrees'

		// A phi is the sole owner only if EVERY path made it one — one co-owning edge is enough to make the
		// merged name share the box, and a stale `sole` there is a destructive-move licence on an allocation
		// somebody else still holds.
		if phiOwns and not self.valueIsSoleHeapOwner(value) 'edgeCoOwns'
			let everyEdgeSolelyOwned = self.valueIsSolelyOwnedHere(binding.boundValue) and self.valueIsSolelyOwnedHere(value)
			self.markValueCoOwnsHeap(binding.boundValue)

			if everyEdgeSolelyOwned 'stillAHandOffSource'
				self.markValueFromFreshReturn(binding.boundValue)
			end 'stillAHandOffSource'
		end 'edgeCoOwns'
	end 'pushMergedEdgeValue'

	// ⭐⭐ **DOES THIS CARRIED BINDING CONTRIBUTE A WITNESS TO A MERGE? — THE ONE FACT BOTH HALVES READ.**
	// Block-args and edge args are POSITIONAL, so the mint
	// (`mintPhiForBinding`) and the push (`pushMergedEdgeValue`) must agree for EVERY carried binding or
	// every later binding in that merge lands in the wrong slot — silently, with no compile error and no
	// diagnostic at run time.
	//
	// ⚠ **THE MINT AND THE PUSH MUST BE KEYED OFF THE SAME FACT**: keying the mint off `binding.varType`'s tag and the push off
	// `tagOf(value)` agrees only because a carried binding's value always carries the binding's tag —
	// which is an invariant nothing states and nothing checks, and exactly the shape that stops being true
	// the first time a merge carries a value the binding did not produce. Both read the DECLARED type,
	// which is the fact the phi is minted from and the one every merge site holds (all six pass the binding
	// they are merging).
	function bindingCarriesWitness(binding VarInfo) returns bool
		return maxonTypeTag(binding.varType) == ValueTypeTag.interfaceRef
	end 'bindingCarriesWitness'

	// Allocate a fresh ValueId AND record its source-level type, in lockstep. THE only way
	// the parser mints a value: the type columns are dense by ValueId, so an id allocated
	// without a type would shift every later value's type by one — a silent misclassification
	// of every operator that dispatches on type. Splitting the two would make that possible;
	// this makes it impossible.
	//
	// Takes a TAG (plus the name id a `named` type carries), never a `MaxonType`: constructing
	// a union ALLOCATES, and this is the per-VALUE path. `mintValueOfType` is the door for a
	// caller that already holds a `MaxonType` and so constructs nothing new.
	function mintValue(tag ValueTypeTag, nameId TypeNameId) returns ValueId
		if self.namesARefusedInstance(tag, nameId: nameId) 'aRefusedInstance'
			return self.mintDeferredValue()
		end 'aRefusedInstance'

		let id = allocValueId(self.bodyState.valueIds)
		self.bodyState.valueTags.push(tag)
		self.bodyState.valueNameIds.push(nameId)

		// A fresh value wears no brand until a door stamps one (`brandValue`).
		self.bodyState.valueBrandIds.push(UnnamedTypeId)
		self.bodyState.valueCapabilities.push(ValueCapability.mutable)

		// The constant columns move in the same lockstep, seeded UNKNOWN. A value's constant is
		// discovered by the op that DEFINES it, which is emitted after its id is minted — so the
		// slot must exist first, and the emitter overwrites it (`recordConst`).
		self.bodyState.valueConsts.push(0)
		self.bodyState.valueConstDomains.push(ConstPayloadDomain.unknown)

		// Owned-heap provenance rides the same lockstep: seeded NOT owned, set true by `trackOwnedTemp`
		// on the one value an interpolation allocates. The slot must exist before that call, exactly as
		// the constant slot must exist before `recordConst`.
		self.bodyState.valueOwnsHeap.push(false)

		// And its exclusivity, seeded CO-OWNED — the safe direction, because an unclaimed value takes the
		// retain path rather than a destructive move-out (see `OwnedHeapExclusivity`).
		self.bodyState.valueOwnsHeapAlone.push(false)
		self.bodyState.valueMintedSole.push(false)

		// The fresh-return mark rides the same lockstep, seeded NOT-FRESH — the safe direction, because an
		// unclaimed value is one a send refuses rather than one it moves (see the field header).
		self.bodyState.valueFromFreshReturn.push(false)

		// The promise mark rides the same lockstep, seeded NOT-a-promise; set by `markValuePromise` on the
		// one value an `async` spawn produces.
		self.bodyState.valuePromiseMarks.push(false)

		// The node-handle mint rides the same lockstep, seeded NOT-A-MINT — which is the value's OWN id, a
		// list it can never have been minted off (see the field header).
		self.bodyState.nodeHandleMintedFrom.push(id)

		// Seeded NOT-SET (its own id): a freshly minted value has been read out of no slot. The one door that
		// sets these is `recordConsumablePromiseSlot`, at the container-read site.
		self.bodyState.promiseSlotContainer.push(id)
		self.bodyState.promiseSlotIndex.push(id)
		self.bodyState.promiseSlotIsAField.push(false)

		// The merge-alias mark rides the same lockstep, seeded PROVEN — an ordinary value's declared alias is
		// one it passed a door to acquire. Only `mintPhi` sets it, because only a merge can name an alias no
		// door stood in front of (see the field header).
		self.bodyState.aliasUnprovenMarks.push(false)

		// The capturing-closure mark + its env ride the same lockstep, seeded NOT-a-capture / no-env; set by
		// `parseClosureExpression` on the one value a capturing closure produces (see the field header).

		// ⚠ **THE WITNESS COLUMN DELIBERATELY DOES *NOT* RIDE THIS LOCKSTEP** — it is grown ON DEMAND by
		// `pairInterfaceWitness`, so a function that builds no existential never grows it at all. See the
		// field header for the measurement that put it there.

		// After every column is seeded, because the predicate reads them.
		self.noteManagedValueInRuntimeSource(id)

		return id
	end 'mintValue'

	// ⭐ **THE TYPE A COMPILER-ROUTED BUILTIN METHOD HANDS BACK, READ OFF THE CORPUS DECLARATION.** A method
	// the compiler serves with a RUNTIME CALL is still one `stdlib/` declares, and the declaration is
	// the only place a ranged alias's NAME survives: minting the result from a bare tag drops it, and
	// every rule stated over the alias then has nothing to look up.
	function declaredRuntimeMethodResult(typeName ByteArray, methodName ByteArray) returns MaxonType
		let returnType = try self.signatures.declaredReturnTypeOf(qualifiedMethodName(typeName, methodName: methodName), into: self.artifact.typeNames) otherwise panic("declaredRuntimeMethodResult: `{String.from(typeName)}.{String.from(methodName)}` is routed to a runtime call but no file declares it — every member the surface roster admits is one the corpus declares")
		return requireDeclaredResultValue(returnType, typeName: typeName, methodName: methodName)
	end 'declaredRuntimeMethodResult'

	// Mint a value whose type is already in hand as a `MaxonType` — a `literal` op's type (the
	// op stores one anyway), a call's declared return type. It DECOMPOSES an existing union
	// rather than constructing a new one, so it allocates nothing either.
	function mintValueOfType(valueType MaxonType) returns ValueId
		return self.mintValue(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType))
	end 'mintValueOfType'

	function wearFloatAlias(value ValueId, aliasId TypeNameId)
		if self.tagOf(value) != ValueTypeTag.float 'notAFloat'
			panic("wearFloatAlias: v{value} is not a float, so it cannot wear the ranged float alias '{String.from(self.internedName(aliasId))}'")
		end 'notAFloat'

		try self.bodyState.valueNameIds.set(value, value: aliasId) otherwise panic("wearFloatAlias: v{value} has no type-name slot — the two type columns are filled in lockstep")
	end 'wearFloatAlias'

	function wearFullRangeFloat(value ValueId)
		self.wearFloatAlias(value, aliasId: typeNameIdOf(self.signatures.libraryAliasType(FullRangeFloatAliasName, into: self.artifact.typeNames)))
	end 'wearFullRangeFloat'

	function settleFloatResult(value ValueId)
		if self.tagOf(value) != ValueTypeTag.float or self.valueNameId(value) != UnnamedTypeId or self.floatConstIsKnown(value) or self.valueHasFloatRange(value) 'nothingToWear'
			return
		end 'nothingToWear'

		self.wearFullRangeFloat(value)
	end 'settleFloatResult'

	function settleFloatBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp)
		if self.tagOf(result) == ValueTypeTag.float and self.valueNameId(result) == UnnamedTypeId 'anUnnamedFloat'
			self.knowFloatBinOp(result, lhs: lhs, rhs: rhs, op: op)
		end 'anUnnamedFloat'

		self.settleFloatResult(result)
	end 'settleFloatBinOp'

	function knowFloatBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp)
		if self.floatConstIsKnown(lhs) and self.floatConstIsKnown(rhs) 'bothOperandsFold'
			self.recordFloatFold(result, fold: foldFloatBinOp(op, lhs: self.floatConstBitsOf(lhs), rhs: self.floatConstBitsOf(rhs)))
			return
		end 'bothOperandsFold'

		let left = try self.floatRangeOf(lhs) otherwise return
		let right = try self.floatRangeOf(rhs) otherwise return
		let range = try floatRangeOfBinOp(op, left: left, right: right) otherwise return
		self.recordFloatRange(result, range: range)
	end 'knowFloatBinOp'

	function settleFloatUnaryOp(result ValueId, operand ValueId, op MaxonUnaryOp)
		if self.tagOf(result) == ValueTypeTag.float and self.valueNameId(result) == UnnamedTypeId 'anUnnamedFloat'
			self.knowFloatUnaryOp(result, operand: operand, op: op)
		end 'anUnnamedFloat'

		self.settleFloatResult(result)
	end 'settleFloatUnaryOp'

	function knowFloatUnaryOp(result ValueId, operand ValueId, op MaxonUnaryOp)
		if self.floatConstIsKnown(operand) 'theOperandFolds'
			self.recordFloatFold(result, fold: foldFloatUnaryOp(op, operand: self.floatConstBitsOf(operand)))
			return
		end 'theOperandFolds'

		let source = try self.floatRangeOf(operand) otherwise return
		let range = try floatRangeOfUnaryOp(op, operand: source) otherwise return
		self.recordFloatRange(result, range: range)
	end 'knowFloatUnaryOp'

	function recordFloatFold(id ValueId, fold FoldedInt)
		match fold 'f'
			folded(bits) then self.recordFoldedFloat(id, bits: bits)
			notFoldable then return
		end 'f'
	end 'recordFloatFold'

	function recordFoldedFloat(id ValueId, bits FullRangeInt)
		self.recordFloatConst(id, bits: bits)
		let range = try floatRangeOfPoint(bits) otherwise return
		self.recordFloatRange(id, range: range)
	end 'recordFoldedFloat'

	function wearDeclaredFloatAlias(value ValueId, declared MaxonType, scopeFilePath FilePath)
		if maxonTypeTag(declared) != ValueTypeTag.named or self.tagOf(value) != ValueTypeTag.float or not self.namedIsFloatAliasFor(typeNameIdOf(declared), scopeFilePath: scopeFilePath) 'notAFloatAliasSlot'
			return
		end 'notAFloatAliasSlot'

		self.wearFloatAlias(value, aliasId: typeNameIdOf(declared))
	end 'wearDeclaredFloatAlias'

	function wearAliasOf(value ValueId, source ValueId)
		if self.tagOf(source) == ValueTypeTag.float and self.tagOf(value) == ValueTypeTag.float and self.valueNameId(source) != UnnamedTypeId 'theSourceWearsOne'
			self.wearFloatAlias(value, aliasId: self.valueNameId(source))
		end 'theSourceWearsOne'
	end 'wearAliasOf'

	function wearIndexSpaceAlias(value ValueId, declared MaxonType, scopeFilePath FilePath)
		if tagIsFloat(self.tagOf(value)) 'aFloatElement'
			self.wearDeclaredFloatAlias(value, declared: self.signatures.adoptType(declared, into: self.artifact.typeNames), scopeFilePath: scopeFilePath)
		end 'aFloatElement'
	end 'wearIndexSpaceAlias'

	function floatAliasThroughInstance(declared MaxonType, gid GenericInstanceId) returns TypeNameId
		let substituted = self.signatures.adoptType(self.signatures.substituteThroughInstanceInterned(declared, id: gid, interner: self.artifact.typeNames), into: self.artifact.typeNames)

		if maxonTypeTag(substituted) == ValueTypeTag.named and self.namedIsFloatAlias(typeNameIdOf(substituted)) 'aFloatAliasArgument'
			return typeNameIdOf(substituted)
		end 'aFloatAliasArgument'

		return UnnamedTypeId
	end 'floatAliasThroughInstance'

	function recordParamValueType(paramType MaxonType)
		self.recordValueType(self.resolveFloatAliasType(self.deferredWhenRefused(paramType), scopeFilePath: self.job.path))

		self.wearDeclaredFloatAlias((self.bodyState.valueTags.count() - 1) as ValueId, declared: paramType, scopeFilePath: self.job.path)
	end 'recordParamValueType'

	function valueSlotType(value ValueId) returns MaxonType
		if self.tagOf(value) == ValueTypeTag.float and self.valueNameId(value) != UnnamedTypeId 'aWornFloatAlias'
			return MaxonType.named(self.valueNameId(value))
		end 'aWornFloatAlias'

		return self.typeOf(value)
	end 'valueSlotType'

	// Re-record an EXISTING value's type columns in place. The caught error flag is a box POINTER that the
	// try fork minted as `integer` for its zero test; a boxed `(e)` binding re-records it as
	// its UNION type so `match e` dispatches through the box (`enumMatchFor`) and its scope-exit drop routes
	// to `__destruct_<U>` (`decrefCalleeFor`), both of which read the value TAG. Only the two type columns
	// move.
	//
	// ⚠⚠ **AND THE Std WIDTH MOVES WITH THEM: "it cannot" is a claim about the CALLERS rather than about
	// this door.** Every caller but one stays inside the i64 family
	// (`valueTagToStdType` collapses `integer`, `named`, `structRef`, `string` alike), so for those the
	// already-emitted ops are provably unaffected — the `flag != 0` compare and the `tryCall`'s flag
	// register above are the worked example. That is a property of WHERE it is called, not of what it does:
	// the columns it writes are exactly the columns `valueTagToStdType` reads, so a re-record ACROSS width
	// families is a width change, and a caller may not assume otherwise.
	//
	// ⭐ **THE ONE CALLER THAT CROSSES A WIDTH FAMILY IS `emitEnumCaseConstantSelect`, `boolean` → `integer`
	// (i1 → i64), and it is safe for two reasons that belong here rather than only at the call site.** It
	// re-records a `compare` result so the multiply that consumes it reads an i64 operand type:
	//
	//   • **NO EMITTED OP DEPENDS ON THAT VALUE'S OWN WIDTH.** `lowerCompare` takes the Std `cmp`'s
	//     `operandType` from its `lhs` — the two things being compared — never from its result, and the
	//     result is re-recorded one line after it is minted, before anything else can read it.
	//   • **THE BACKENDS TYPE A COMPARE'S RESULT FROM THE OP, NOT FROM THIS COLUMN.** wasm's valtype table
	//     records `cmp` as i32 whatever the Std type says, and widens at the consuming op
	//     (`coerceOnStack`); x64 materializes with `setcc` + a REX.W `movzx` and arm64 with `cset`, both
	//     full-width. So the widened claim is one all three already satisfy.
	//
	// ⇒ A NEW caller crossing a width family owes those same two questions about ITS value. Crossing into or
	// out of `float` (f64) or `boolean` (i1) is the case to think hardest about; within the i64 family there
	// is nothing to ask.
	function retypeValue(value ValueId, valueType MaxonType)
		try self.bodyState.valueTags.set(value, value: maxonTypeTag(valueType)) otherwise panic("retypeValue: v{value} has no type slot — every SSA value is minted through mintValue")
		try self.bodyState.valueNameIds.set(value, value: typeNameIdOf(valueType)) otherwise panic("retypeValue: v{value} has no type-name slot — the two type columns are filled in lockstep")

		// A value minted unmanaged can BECOME managed here — a caught error's box pointer is the worked
		// example — so `noteManagedValueInRuntimeSource` is asked at both writers or the `try` door escapes it.
		self.noteManagedValueInRuntimeSource(value)
	end 'retypeValue'

	// ⭐ **PAIR AN EXISTENTIAL WITH ITS WITNESS HALF** — the one writer of
	// `valueWitnessIds`, so every producer of an interface-typed value (a parameter, a merge phi, a field
	// load, an interface-returning call's result) says so through one door and cannot half-record it.
	//
	// ⭐ **AND THE ONE PLACE THE COLUMN GROWS.** It is extended to reach `value` here rather than pushed a
	// slot per mint, which is what makes an interface-free function pay NOTHING for it — see the field header.
	// The zeroes it lays down on the way are the same UNPAIRED filler a per-mint push wrote, so a read below
	// `value` is unchanged; a read ABOVE the grown prefix is the identical "unpaired" answer by a second
	// route, which `witnessOfValue` states once for both.
	function pairInterfaceWitness(value ValueId, witness ValueId)
		while self.bodyState.valueWitnessIds.count() as ValueId <= value 'growToReachIt'
			self.bodyState.valueWitnessIds.push(0)
		end 'growToReachIt'

		try self.bodyState.valueWitnessIds.set(value, value: witness) otherwise panic("Parser.pairInterfaceWitness: value v{value} has no witness slot after the column was grown to reach it — `growToReachIt` above pushes up to and including it")
	end 'pairInterfaceWitness'

	// ⭐ **THE WITNESS HALF OF AN EXISTENTIAL — the one reader**, and it PANICS on an unpaired value rather
	// than handing back the 0 filler. A fat pointer whose second half is absent is not a value that can be
	// dispatched, stored or returned: 0 would be a null table address, i.e. a wild jump at the first method
	// call instead of a diagnostic. Every producer of an `interfaceRef`-tagged value pairs it at the moment it
	// mints it, so a miss here is a compiler invariant break and not user input.
	//
	// A value ABOVE the grown prefix and a 0 WITHIN it are the same fact — nobody paired it — so they raise
	// the same panic rather than two that would have to be kept saying the same thing.
	// ⚠ Its LOWERING twin is `LowerMaxonToStd.pairedWitnessOf` — the same rule, read on the other side of the
	// tier boundary over the same column, and it cannot share a home: this one reads the PARSER's live column
	// and that one the `IrFunction` it was published into, and neither type can reach the other's. What they
	// must never do is disagree about what an unpaired slot MEANS, so each states the whole rule and names
	// the other.
	function witnessOfValue(value ValueId) returns ValueId
		let witness = try self.bodyState.valueWitnessIds.get(value) otherwise 0 as ValueId

		if witness == 0 'unpaired'
			panic("Parser.witnessOfValue: value v{value} is typed as an interface but no witness half is paired with it — every producer of an existential (a parameter, a merge phi, a field load, an interface-returning call result) must call `pairInterfaceWitness` when it mints the value")
		end 'unpaired'

		return witness
	end 'witnessOfValue'

	// Append a value's type to the columns WITHOUT allocating an id — for the parameters,
	// whose ids (0..paramCount-1) the value numbering RESERVED rather than minted.
	function recordValueType(valueType MaxonType)
		self.bodyState.valueTags.push(maxonTypeTag(valueType))
		self.bodyState.valueNameIds.push(typeNameIdOf(valueType))

		// A parameter's brand is stamped by `bindParameters` off the spelled declaration.
		self.bodyState.valueBrandIds.push(UnnamedTypeId)
		self.bodyState.valueCapabilities.push(ValueCapability.mutable)

		// A parameter's value is the one thing the compiler provably cannot see.
		self.bodyState.valueConsts.push(0)
		self.bodyState.valueConstDomains.push(ConstPayloadDomain.unknown)

		// A parameter is never a fresh interpolation result, so it starts NOT owned — but its slot must
		// exist so the column stays indexable by every ValueId, params included.
		self.bodyState.valueOwnsHeap.push(false)

		// A CONSUMED parameter is enrolled owned a few lines on (`bindParameters`), and it is enrolled
		// CO-OWNED: the caller may have transferred it by `__mm_incref` rather than by a move
		// (`coOwnBorrowedForConsume`), and which of the two it chose is not a fact this frame can read. So the
		// seed here is also the final answer for every parameter.
		self.bodyState.valueOwnsHeapAlone.push(false)
		self.bodyState.valueMintedSole.push(false)

		// A PARAMETER is the one arrival this fact is about the absence of: it crossed a frame boundary whose
		// far side this compiler cannot read, which is exactly what `returnsFreshValue` answers for a RESULT and
		// nothing answers for an argument. So the seed is also the final answer, and a send of a parameter is
		// not proven sole (`unprovenOwnerTakeOf` decides what it takes) — `specs/services.md`'s transferability rule,
		// stated in a column.
		self.bodyState.valueFromFreshReturn.push(false)

		// A parameter is never an async spawn's handle; the slot must exist so the column stays indexable.
		self.bodyState.valuePromiseMarks.push(false)

		// A parameter is never an insertion's fresh mint either — a handle ARRIVES here, it is not made here —
		// so it takes the NOT-A-MINT seed, its own id, which is the index this push is about to land at.
		// `remove` therefore refuses a bare parameter handle only if no binding owns it, and `bindParameters`
		// gives every parameter one.
		self.bodyState.nodeHandleMintedFrom.push(self.bodyState.nodeHandleMintedFrom.count() as ValueId)

		// A parameter was read out of no slot in THIS frame — whatever the caller moved it out of, the move
		// finished at the call. NOT-SET is the final answer for every parameter.
		self.bodyState.promiseSlotContainer.push(self.bodyState.promiseSlotContainer.count() as ValueId)
		self.bodyState.promiseSlotIndex.push(self.bodyState.promiseSlotIndex.count() as ValueId)
		self.bodyState.promiseSlotIsAField.push(false)

		// A parameter is never a merge, and its declared range IS proved — by the entry guard `guardRangedParams`
		// stands in front of every caller. The slot must exist so the column stays indexable.
		self.bodyState.aliasUnprovenMarks.push(false)

		// A parameter is never a capturing closure; the slots must exist so the columns stay indexable by
		// every ValueId, params (including a lifted closure's trailing `__env`) included.

		// ⚠ The witness column is NOT seeded here either — `bindExistentialWitnessParams` grows it to exactly
		// the interface-typed parameters it pairs, and it runs after the whole parameter block is seeded
		// because the companion it pairs each one with is itself a parameter further along.
	end 'recordValueType'

	// Remember the integer behind a value the parser has just DEFINED. Called by the emitters, on
	// the id they minted a moment ago, so the slot is always there.
	function recordConst(id ValueId, folded FullRangeInt)
		self.recordConstPayload(id, payload: folded, domain: ConstPayloadDomain.integer)
	end 'recordConst'

	// The FLOAT twin: remember the f64 BIT PATTERN behind a value. Its only writer is `emitLiteralIn`'s float
	// arm (a float literal, including the `-0.0` `parseNegatedNumericLiteral` folds into ONE literal), and its
	// only reader is the division-by-zero proof — see `ConstPayloadDomain` for why the two domains share one
	// payload column and why the DOMAIN, not the value's tag, is what says how to read it.
	function recordFloatConst(id ValueId, bits FullRangeInt)
		self.recordConstPayload(id, payload: bits, domain: ConstPayloadDomain.float)
	end 'recordFloatConst'

	// The one write. Both halves move together by construction — a payload cannot be stored without the domain
	// that says how to read it, which is the whole reason the domain is a column and not a convention.
	function recordConstPayload(id ValueId, payload FullRangeInt, domain ConstPayloadDomain)
		try self.bodyState.valueConsts.set(id, value: payload) otherwise panic("Parser.recordConstPayload: value v{id} has no constant slot — every SSA value must be minted through mintValue")
		try self.bodyState.valueConstDomains.set(id, value: domain) otherwise panic("Parser.recordConstPayload: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'recordConstPayload'

	// The DOMAIN of the constant payload the compiler holds for `id`, or `unknown` when it holds none.
	function constPayloadDomain(id ValueId) returns ConstPayloadDomain
		return try self.bodyState.valueConstDomains.get(id) otherwise panic("Parser.constPayloadDomain: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'constPayloadDomain'

	// True iff the compiler holds `id`'s integer. STILL ONE ARRAY PROBE, and still the INTEGER view: a float
	// literal's slot says `float`, so every reader of this — the shift rule's count, `emitBinOp`'s fold, the
	// duplicate-pattern check — sees exactly what it saw before the float half existed.
	function constIsKnown(id ValueId) returns bool
		return self.constPayloadDomain(id) == ConstPayloadDomain.integer
	end 'constIsKnown'

	// True iff the compiler holds `id`'s f64 BIT PATTERN.
	function floatConstIsKnown(id ValueId) returns bool
		return self.constPayloadDomain(id) == ConstPayloadDomain.float
	end 'floatConstIsKnown'

	// The integer behind `id`. Only meaningful when `constIsKnown(id)` — asking otherwise is a
	// caller bug, and handing back the unseeded 0 as if it were a real constant is exactly the
	// wrong answer a sentinel would give, so it panics instead.
	function constOf(id ValueId) returns FullRangeInt
		if not self.constIsKnown(id) 'unknown'
			panic("Parser.constOf: value v{id} is not a known constant — guard the call with constIsKnown")
		end 'unknown'

		return self.constPayloadOf(id)
	end 'constOf'

	// The f64 BIT PATTERN behind `id`. Guarded on `floatConstIsKnown` for `constOf`'s exact reason, and with
	// a sharper edge: the unseeded 0 IS the pattern for `+0.0`, so a sentinel here would not merely be wrong,
	// it would read as a provably-ZERO divisor and turn a legal program into an E3103.
	function floatConstBitsOf(id ValueId) returns FullRangeInt
		if not self.floatConstIsKnown(id) 'unknown'
			panic("Parser.floatConstBitsOf: value v{id} is not a known float constant — guard the call with floatConstIsKnown")
		end 'unknown'

		return self.constPayloadOf(id)
	end 'floatConstBitsOf'

	// ⭐ **THE BYTES BEHIND `id`, WHEN THE COMPILER MINTED THEM AS A STRING LITERAL IN THIS FUNCTION.** The
	// receiver test the constant-slice fold is built on, and it is deliberately the SAME criterion
	// `LiteralArgPromotion.ArgProvenance.isImmortal` applies for the same reason: a String's immortality is a
	// RUNTIME property of the record it happens to hold, so a parameter, a field, a value arriving through a
	// merge and the result of a runtime slice are all `unknown` here — only a value THIS parse minted is
	// known. A value minted by a fold is one of those, so a slice of a folded slice folds too.
	function knownLiteralBytes(id ValueId) returns KnownLiteralBytes
		if self.constPayloadDomain(id) != ConstPayloadDomain.stringLiteralOp 'notAMintedLiteral'
			return KnownLiteralBytes.unknown
		end 'notAMintedLiteral'

		let literalOp = self.constPayloadOf(id) as ElementIndex
		return KnownLiteralBytes.payload(literalOp, bytes: stringLiteralOpBytes(self.maxonOpAt(literalOp)))
	end 'knownLiteralBytes'

	// ⭐ **DOES `id` NAME A BYTE POSITION THIS PARSE MINTED?** — the predicate half of `knownStringBytePos`,
	// separate because it is asked on the hottest path there is (once per emitted call, to decide whether the
	// call is one a later fold may drop) and the union answer is a HEAP BOX: every case of a boxed union is
	// one here, payload-free ones included. Asking the domain column costs one array read and nothing else.
	function valueIsKnownStringBytePos(id ValueId) returns bool
		return self.constPayloadDomain(id) == ConstPayloadDomain.stringBytePos
	end 'valueIsKnownStringBytePos'

	// The byte position behind `id`, when it is a `StringIndex` this parse minted from a known-bytes
	// receiver — see `recordConstStringIndexResult` for the two accessors that answer one.
	function knownStringBytePos(id ValueId) returns KnownStringBytePos
		if not self.valueIsKnownStringBytePos(id) 'notAMintedPosition'
			return KnownStringBytePos.unknown
		end 'notAMintedPosition'

		return KnownStringBytePos.position(self.constPayloadOf(id))
	end 'knownStringBytePos'

	// The op at `index` of the artifact under construction. ONE reader today (`knownLiteralBytes`), and it is
	// a function rather than an inline `ops.get` so that the panic — a miss here is a broken invariant, never
	// a case to answer — is worded once for every index this parse files off `module.opCount()` as it appends.
	function maxonOpAt(index ElementIndex) returns MaxonOp
		return try self.artifact.module.ops.get(index) otherwise panic("Parser.maxonOpAt: op {index} is outside the {self.artifact.module.opCount()} ops this file has emitted — every index read here was filed off `module.opCount()` as the op was appended")
	end 'maxonOpAt'

	// The raw payload, whichever domain it is in. Private to the FOUR typed readers above — `constOf`,
	// `floatConstBitsOf`, `knownLiteralBytes` and `knownStringBytePos`, one per `ConstPayloadDomain` case that
	// carries a payload — which is what keeps the domain check in front of every read of it. Anything that
	// reads this column WITHOUT first asking `constPayloadDomain` is a fifth reader and is the bug this
	// privacy exists to make impossible: 64 bits are 64 bits, and an op index read as an integer
	// constant is a silent wrong answer at compile time.
	function constPayloadOf(id ValueId) returns FullRangeInt
		return try self.bodyState.valueConsts.get(id) otherwise panic("Parser.constPayloadOf: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'constPayloadOf'

	// Record a fold's result, if it produced one. `notFoldable` is a DECISION and not a gap — the
	// folder declined an operator whose answer is a diagnostic rather than a number — so the value
	// simply stays unknown, and the guard downstream handles it.
	function recordFold(id ValueId, fold FoldedInt)
		match fold 'f'
			folded(value) then self.recordConst(id, folded: value)
			notFoldable then return
		end 'f'
	end 'recordFold'

	// The TAG of an SSA value's type — the hot read, and the only thing the operator rules
	// need. Every value the parser mints has one (the parameters are seeded from their
	// declarations, `mintValue` records the rest), so a miss is a parser invariant break.
	function tagOf(value ValueId) returns ValueTypeTag
		return try self.bodyState.valueTags.get(value) otherwise panic("Parser.tagOf: value v{value} has no recorded type — every SSA value must be minted through mintValue")
	end 'tagOf'

	// **IS THIS VALUE'S TYPE UNSIGNED?** The question THE SHIFT RULE asks of a shift's LEFT operand,
	// and the only thing that decides whether `shr` fills with the sign or with zeros. Exhaustive
	// over `ValueTypeTag`, so a new type cannot be added without being placed on one side of it.
	//
	//   • `named`    — a ranged typealias, and unsigned exactly when its LOW BOUND is 0 or above
	//                  (`rangeIsUnsigned`). The alias is looked up in the WHOLE-PROGRAM declaration
	//                  index, never in this file's artifact: an alias declared in another file is
	//                  still an unsigned type here, and a file-local table would answer "signed" and
	//                  emit the wrong instruction. It is order-independent within a file too, which
	//                  the artifact table — filled as declarations are parsed — would not be.
	//   • `exitCode` — the builtin `ExitCode`, whose range is PLATFORM-SHAPED: `int(0 to u32.max)` on
	//                  Windows and `int(0 to 255)` on Linux, macOS and WASI (`Project.exitCodeAliasHigh`,
	//                  which mirrors `stdlib/Process.maxon`). Unsigned on EVERY target, by the same
	//                  low-bound rule `named` above applies — and it is worth saying WHICH bound carries
	//                  it, because only the high one moves: the verdict rests on the LOW bound, which is
	//                  0 on all four targets, so the platform range cannot endanger it.
	//   • `integer`  — a bare `int` is `i64.min to i64.max`. SIGNED, and it is the default every
	//                  shift in the language sign-fills under.
	//   • the rest   — not a number, so not a shift operand at all: `requireBinOpOperands` has
	//                  already rejected the program, and `emitShift` asks it BEFORE this is reached.
	//                  Answering "signed" costs nothing, because no code is kept.
	function valueIsUnsigned(value ValueId) returns bool
		if self.tagOf(value) == ValueTypeTag.exitCode 'exitCode'
			return true
		end 'exitCode'

		// ⚠⚠ **`domainDeclaringAlias` — THE SAME DOOR THE DIVIDE AND THE DECIMAL RENDERER ASK, AND NOT
		// A SECOND ONE.** `domainDeclaringAlias`
		// is `declaredAliasOfValue` PLUS the alias a cast recorded, and the shift is the other half of the very
		// question its header names — *"signedness ... selects an INSTRUCTION from the type the program WROTE"*.
		// Reading the narrower door here made ONE value have two signednesses: MEASURED on this tree, over two
		// `int(0 to u64.max)` parameters, `let m = a and b` then `m shr 60` filled with the SIGN (18446744073709551608)
		// while `"{m}"` and `m / 3` on the same `m` both read it UNSIGNED — one value, one declared type, two answers.
		//
		// ⚠ **`declaredAliasOfValue`, NOT A SECOND SPELLING OF IT.** A private walk — tag-guard on `named`, then
		// `signatures.aliasOf(internedName(valueNameId(v)))` — would be the file's THIRD copy of that lookup:
		// `declaredAliasOfValue` is already it, statement for statement. Two spellings of one lookup let the shift
		// rule and the division rule come to disagree about which alias a value has.
		return match self.domainDeclaringAlias(value) 'a'
			declared(alias) gives rangeIsUnsigned(alias.low)
			undeclared gives false
		end 'a'
	end 'valueIsUnsigned'

	// The full `MaxonType` of an SSA value, REBUILT from the two columns. It CONSTRUCTS a
	// union, so it allocates.
	function typeOf(value ValueId) returns MaxonType
		return maxonTypeOfTag(self.tagOf(value), nameId: self.valueNameId(value))
	end 'typeOf'

	// Record the block-arg values `block` passes to `targetId` for the Std-tier
	// phi-elim pass. A branch op carries only the target BlockId, so the per-edge phi
	// operands live on the predecessor's `branchEdges` (see IrBlock). An empty list
	// means the target has no phis — nothing to record.
	function recordBranchEdge(block IrBlock, targetId BlockId, argIds ValueIdArray)
		if argIds.count() == 0 'noArgs'
			return
		end 'noArgs'

		if self.bodyState.lateReads.count() > 0 'someReadIsLate'
			self.attachLateReadsFor(block, values: argIds)
		end 'someReadIsLate'

		block.branchEdges.push(BranchEdge.create(targetId, argIds: argIds))
	end 'recordBranchEdge'

	// The one predicate every coverage mint site asks. Both library tiers are out: coverage measures
	// the program under test, and every compile links `runtime/`, so instrumenting it puts a file the
	// program never named into its report. That is `Queries.isLibrarySourceFile`'s question, spelled
	// from this parser's provenance bits because it holds no project to ask.
	//
	// The bits are the provenance ones, not `livesUnderStdlibDirectory`: `isStdlibSource` hands a
	// project rooted inside `stdlib/` its own files back, so `maxon build stdlib/URL.maxon --coverage`
	// measures the module named. `isRuntimeSource` is containment alone, so a `runtime/` file is never
	// instrumented.
	function coverageActive() returns bool
		return self.job.instrumentsCoverage and not self.job.isStdlibSource and not self.job.isRuntimeSource
	end 'coverageActive'

	// Mint one counter slot for a source position and emit its increment at the END of `block` — which is
	// its HEAD at every arm site, because an arm's block is fresh when its point is minted.
	//
	// The point is filed into THIS FILE's artifact and the op carries the FILE-LOCAL id; `mergeArtifact`
	// records where the file's block landed and the lowering adds that base. The `CovPoint` record holds
	// everything else a report needs, so the op is one number.
	//
	// ⚠ The op carries the positionless `SourceRange.none()`: a counter is the compiler's own instruction and
	// belongs to no statement of the program, so a line table must not attribute one to a source line. The
	// point's OWN position rides the `CovPoint` record.
	function mintCovPoint(block IrBlock, funcName ByteArray, flags CovPointFlags, line LineNumber, col ColumnNumber, branchLine LineNumber, branchCol ColumnNumber)
		let id = self.artifact.recordCovPoint(CovPoint.create(String.from(funcName), filePath: self.job.path.toString(), line: line, col: col, branchLine: branchLine, branchCol: branchCol, flags: flags))
		self.emitBodyOp(block, op: MaxonOp.covPoint(id), range: SourceRange.none())
	end 'mintCovPoint'

	// Make `matchTok`'s position the enclosing branch construct for the arms parsed until the matching
	// `leaveMatch`. A no-op unless this parse instruments, so the columns stay the shared empties.
	function enterMatch(matchTok Token)
		if not self.coverageActive() 'notInstrumenting'
			return
		end 'notInstrumenting'

		if self.covMatchLines.count() == 0 'firstConstruct'
			self.covMatchLines = LineNumberArray.create(0)
			self.covMatchCols = ColumnNumberArray.create(0)
		end 'firstConstruct'

		self.covMatchLines.push(matchTok.line)
		self.covMatchCols.push(matchTok.column)
	end 'enterMatch'

	// ⚠ There is no unwinding guard, and none is owed: the only way out of the arm loop between the pair is
	// a `SourceParseError`, which throws this parser away (`ParseStaging.parseFile` parses the file
	// again with a new one, or not at all) — so an unbalanced stack cannot be observed by anything.
	function leaveMatch()
		if not self.coverageActive() 'notInstrumenting'
			return
		end 'notInstrumenting'

		_ = try self.covMatchLines.pop() otherwise panic("leaveMatch: the match-position stack is empty — every `enterMatch` is paired with exactly one `leaveMatch` on the same construct")
		_ = try self.covMatchCols.pop() otherwise panic("leaveMatch: the match-position column stack is empty — the two columns are pushed and popped together")
	end 'leaveMatch'

	// Mint the coverage point for one `match` arm, at the head of the fresh block its body will be parsed
	// into. Called from EVERY site that makes an arm body current — the statement `match`, the union `match`,
	// the match expression's `gives`, and the `default throws` / `default panic` helpers, whose arms the user
	// wrote too and whose counts answer "was the default ever reached".
	//
	// ⛔ **AN ARM IS A BRANCH ARM, NOT A PLAIN STATEMENT.** Reporting arms as ordinary lines leaves a two-way
	// `match` summarised as `0/0 arms taken` beside a green line count — a whole `match` with an untested arm
	// reported as fully covered.
	function mintMatchArmPoint(block IrBlock, funcName ByteArray, armLine LineNumber, armCol ColumnNumber)
		if not self.coverageActive() 'notInstrumenting'
			return
		end 'notInstrumenting'

		let depth = self.covMatchLines.count()

		if depth == 0 'noEnclosingConstruct'
			panic("mintMatchArmPoint: an arm point was minted outside any `match` construct — every arm site runs inside an `enterMatch`/`leaveMatch` pair, and without one the arm has no branch to group under")
		end 'noEnclosingConstruct'

		self.mintCovPoint(block, funcName: funcName, flags: MxdbgCovFlagArmCase, line: armLine, col: armCol, branchLine: try self.covMatchLines.get(depth - 1) otherwise panic("mintMatchArmPoint: covMatchLines.get OOB at the innermost construct"), branchCol: try self.covMatchCols.get(depth - 1) otherwise panic("mintMatchArmPoint: covMatchCols.get OOB at the innermost construct"))
	end 'mintMatchArmPoint'

	// A fresh block nothing reaches: the continuation of an `if` or a block-form `try` whose paths all
	// leave, the miss target of an exhaustive planned `match`, the tail after a `break` that left its
	// match, and the tail after a call that never returns. `assertAllBlocksTerminated` forbids a block
	// leaving the parse with `Terminator.unset`, and a block control cannot arrive at has no
	// terminator to give it; `dead` says so. It is deliberately not an op: `emitTerminator` refuses a
	// second op on a block that has one, so an unreachable tail's `return`/`throw` may still be parsed
	// into this block for its syntax.
	function newDeadBlock(func IrFunction, label ByteArray) returns IrBlock
		let block = self.artifact.module.addBlock(func, label: label, heat: BlockHeat.normal)
		block.terminator = Terminator.dead
		return block
	end 'newDeadBlock'

	// Set `block`'s terminator to a two-way conditional branch, anchored on the `if`
	// keyword's span.
	function emitCondBranch(block IrBlock, cond ValueId, thenId BlockId, elseId BlockId, ifTok Token)
		self.emitBodyTerminator(block, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: SourceRange.ofToken(ifTok))
	end 'emitCondBranch'

	// Set `block`'s terminator to an unconditional branch. The branch is synthetic (no
	// source token spawned it — it is the compiler wiring a fall-through), so it carries
	// the positionless `SourceRange.none()`.
	function emitBranch(block IrBlock, targetId BlockId)
		self.emitBodyTerminator(block, op: MaxonOp.branch(targetId), range: SourceRange.none())
	end 'emitBranch'

	// Expression entry — EVERY value context: a `let`/`var` initializer, an assignment's
	// right-hand side, a `return` value, a call argument, an `if`/`while` CONDITION, the
	// inside of a parenthesis. There is ONE GRAMMAR for all of them.
	//
	// A condition once had its own, FLATTER grammar (`operand [cmpOp operand]`, operands parsed
	// at additive precedence), for exactly one reason — a comparison could only be consumed by
	// a branch, because the backend had no way to write a boolean into a register. Two things
	// ended that. `setcc` gives it one (`let r = 5 > 3` compiles), and `and`/`or` bind LOOSER
	// than comparison, so `if a > 0 and b > 0` cannot even be expressed by a grammar whose top
	// level is a single comparison. One climber, one set of precedences, and a condition is
	// simply an expression that happens to feed a branch — plus a TYPE rule, which is
	// `parseBoolCondition` below, not a second grammar.
	//
	// Seeds `currentBlock`, which every emit below targets — see the field.
	//
	// ⭐ **THE INLINE CONDITIONAL `<t> if <c> else <f>` IS HOOKED HERE** — a value-position ternary
	// that binds LOOSER than every binary operator, so it wraps the WHOLE `parseBinary` result and is
	// checked only after the climber has run. `parseBinary`'s RHS recursion never reaches this point,
	// so `a + b if c else d` is `(a + b) if c else (a + b's sibling)`; the `else` arm is a full
	// `parseExpression` again, so `1 if a else 2 if b else 3` right-associates. The block-form `if`
	// cannot collide: it is a STATEMENT keyword `parseStatement` catches at statement start, whereas a
	// ternary `if` only follows an operand.
	//
	// ⚠ **THE PRECEDENCE OF THE TERNARY AGAINST A BINARY OPERATOR IS NOT PINNED.** `return 1 + 20 if
	// false else 40` answers **40** under this reading (`(1 + 20) if false else 40`) and **41** under
	// the tighter one (`1 + (20 if false else 40)`). The one corpus case that exercises the
	// combination, `specs/ternary-expression.md`'s `complex-expressions` (`let x = a + b if cond else
	// a * b`, a=3 b=2 cond=true), evaluates to **5 under BOTH readings**, so it has never
	// distinguished them — a coverage hole, not agreement.
	//
	// The true arm parses before the `if` announces the form, so two facts about the block ARE captured up
	// front, allocation-free: the IR-detach mark (the start block plus its op/block-ref counts, so
	// `parseTernaryExpression` can lift the arm's ops off the unconditional path into the true branch — only
	// the SELECTED arm may run) and the pre-arm MOVE state (rewound onto the false arm). `captureMoveMark`
	// runs only when an owned binding is in scope; scalar code shares the empty mark and pays nothing.
	function parseExpression(func IrFunction, block IrBlock, rangeIsAValue bool = true) returns ValueId throws SourceParseError
		self.bodyState.currentBlock = block
		return try self.parseValueExpression(func, rangeIsAValue: rangeIsAValue)
	end 'parseExpression'

	// A nested value — a call argument, a field or payload value, a literal element, an interpolation
	// hole — is parsed unclaimed: it is never the op a `try` target or a `for` source claims, so its
	// throwing ops route at emission (see `ThrowRouteClaim`). A parenthesised group calls
	// `parseClaimedValueExpression` directly, so a group is transparent to the claim around it.
	function parseValueExpression(func IrFunction, rangeIsAValue bool = true) returns ValueId throws SourceParseError
		let enclosing = self.swapClaim(ThrowRouteClaim.unclaimed)
		let value = try self.parseClaimedValueExpression(func, rangeIsAValue: rangeIsAValue)
		self.restoreClaim(enclosing)
		return value
	end 'parseValueExpression'

	// The climber plus the trailing inline conditional, over `self.bodyState.currentBlock` as it already stands
	// — the entry every value context that must not re-seed `currentBlock` reaches in place of the
	// bare `parseBinary`. A call argument, a struct-field value, a union-payload value and a
	// parenthesised group are each parsed inside an expression that may already have moved
	// `currentBlock` (an earlier sibling short-circuited), so seeding it afresh, as `parseExpression`
	// does, would discard that move; they still need the ternary (`f(a if c else b)`, `(a if c else
	// b)`), so the hook lives below the seed. The mark is recorded off the current block so
	// `parseTernaryExpression` detaches the true arm from wherever control actually is.
	function parseClaimedValueExpression(func IrFunction, rangeIsAValue bool) returns ValueId throws SourceParseError
		let block = self.bodyState.currentBlock

		// ⭐ **THE E3207 BLAME NAME IS CLEARED HERE, at the one door every value expression enters through.**
		// A bare name that resolved via a primary path publishing nothing must read "writable"
		// rather than inherit a NEIGHBOURING expression's answer. Clearing at the call ARGUMENT site alone is
		// correct for arguments and leaves a ternary ARM, one construct over, reading whatever the last
		// argument published. The arm token and cursor are captured for the
		// same question, allocation-free, exactly as an argument's are.
		self.statement.lastBareBindingImmutableName = EmptySourceText
		let armTok = self.current()
		let armStart = self.pos

		let markOpRefCount = block.bodyOpCount()
		let markBlockRefCount = func.blockRefs.count()
		let markOperandCount = self.bodyState.operandOrder.eventCount()

		// ⭐ **AND THE RANGE-CHECK SITE HEIGHT AT THE SAME INSTANT (`rehomeArmRangeSites`).** A site records
		// the block and ordinal a value is checked AT, and the relocation moves the arm's ops to a block that
		// does not exist yet — so the arm's sites have to travel with them. The height is what separates the
		// arm's sites from the CONDITION's: the condition parses into `startBlock` after the detach has
		// truncated it, so it records sites at the very same ordinals, and a position test alone could not
		// tell the two apart.
		let markRangeSiteCount = self.bodyState.rangeCheckSites.count()

		// The pending-temporary height at the same instant as the op/block marks — everything enrolled above
		// it while the value below parses belongs to what may turn out to be a ternary's TRUE ARM, and is
		// released inside that arm rather than on the unconditional path (see `parseTernaryExpression`).
		let markTempCount = self.bodyState.pendingTempDrops.count()

		// ⭐ **AND THE OWNED-BINDING HEIGHT AT THE SAME INSTANT.** An expression declares no `let`, but it
		// can ENROL an owned binding: `giveTemporaryScopeLifetime` holds a temporary a borrow was taken out
		// of, so `(try make().get(0) otherwise d) if t else d` leaves one behind. It belongs to what may turn
		// out to be the TRUE ARM and must be dropped inside that arm — the mirror of `markTempCount`, for the
		// list whose entries drop at a SCOPE exit rather than a statement's.
		let markOwnedCount = self.bodyState.ownedBindings.count()
		var preMoveMark = self.emptyMoveMark

		// ⚠ **THE SHARED EMPTY MARK STANDS IN ONLY WHEN THERE IS NOTHING TO REWIND, AND "NOTHING" HAS TWO
		// HALVES.** An owned-binding height of 0 is not the whole of it: a mark also carries the CONSUMED
		// THREADS, and restoring the shared empty one onto a path that has already awaited something wipes
		// that record — the arm's rewind un-spending a thread the statement before it consumed. The scale
		// corpus is all scalar and spawns nothing, so it still allocates none.
		if markOwnedCount > 0 or not self.bodyState.promiseConsumes.isEmpty() 'moveStateToRewind'
			preMoveMark = self.captureMoveMark()
		end 'moveStateToRewind'

		// ⭐⭐ **A TERNARY'S TWO ARMS ARE ONE VALUE IN ONE SLOT, SO THE SLOT'S ANSWER HAS TO REACH BOTH.** Read
		// here — before the true arm parses and TAKES it — because the form is not revealed until the `if`
		// below, by which point the answer is already spent. `pick([1, 2] if c else [3, 4])` otherwise builds
		// its true arm at the parameter's element type and its false arm at the literal's own, and the two
		// merge as *"true branch is 'CountArray' but false branch is 'Array_int'"* — a refusal saying that two
		// textually identical literals are different types.
		let armSlot = self.pendingArrayLiteralTargetAt(armStart)
		let tupleArmSlot = self.pendingTupleLiteralTargetAt(armStart)

		var value = try self.parseBinary(func, minPrec: OrPrecedence)

		// ⭐⭐ **`a to b` / `a upto b` IS A RANGE VALUE EVERYWHERE BUT A `for … in` HEADER.** The keyword is
		// the counted loop's there and only there — that form allocates nothing and has no per-iteration
		// error path — so the header asks for an expression that stops short of it (`rangeIsAValue: false`)
		// and reads the operator itself. Every other position gets the stdlib `Range`/`OpenRange` the two
		// compilers share, which is why `(1 upto 4).createIterator()` needs nothing here beyond the
		// construction: the iterator protocol, the empty-range throw and the inclusive/exclusive difference
		// are all stated in `stdlib/Range.maxon`.
		//
		// It binds LOOSER than the climber and TIGHTER than the inline conditional, so `1 upto n + 1` is one
		// range over a computed bound and `r if c else s` selects between two ranges.
		if rangeIsAValue and (self.at(TokenKind.to) or self.at(TokenKind.upto)) 'rangeValue'
			self.releaseCompletedOperand()
			value = try self.emitRangeValue(func, lo: value)
		end 'rangeValue'

		if self.at(TokenKind.if) 'ternary'
			self.releaseCompletedOperand()
			self.bodyState.operandOrder.stashSince(markOperandCount)

			self.noteIsolatedPartOrigin(value, startIndex: armStart, endIndex: self.pos)

			// The TRUE arm's blame, taken while its own tokens are still the ones the cursor last moved over
			// — the condition and the false arm both clobber that answer, and both parse below.
			let ternary = try self.parseTernaryExpression(func, trueValue: value, trueBlame: self.expressionImmutableBlame(armTok, valueStart: armStart), startBlock: block, markOpRefCount: markOpRefCount, markBlockRefCount: markBlockRefCount, markRangeSiteCount: markRangeSiteCount, markTempCount: markTempCount, markOwnedCount: markOwnedCount, preMoveMark: preMoveMark, armSlot: armSlot, tupleArmSlot: tupleArmSlot)
			return ternary
		end 'ternary'

		return value
	end 'parseClaimedValueExpression'

	// ⭐⭐ **BUILD THE `Range` / `OpenRange` A RANGE OPERATOR DENOTES.** Entered with the cursor ON the
	// keyword and the lower bound already emitted.
	//
	// It goes through the stdlib type's own `create` rather than building the record here, so what a range
	// IS lives in Maxon in one place: the two types differ only in which endpoint they store, and only
	// `stdlib/Range.maxon` knows that. The bounds are checked by that signature — a `RangeBound` is an
	// integer — so no bound rule is restated at this door.
	//
	// ⚠ **THE TYPE NAME IS THE SHADOW-RENAMED ONE.** A user program declaring its own `type Range` moves
	// the stdlib's into the reserved space, and `a upto b` must still mean the stdlib's — the author named
	// no type here, so nothing they wrote can be shadowed by what they declared.
	function emitRangeValue(func IrFunction, lo ValueId) returns ValueId throws SourceParseError
		let rangeTok = self.current()
		let exclusive = rangeTok.kind == TokenKind.upto
		self.advance()
		let hi = try self.parseUnclaimedBinary(func, minPrec: OrPrecedence)

		let typeName = OpenRangeTypeName if exclusive else RangeTypeName
		let range = SourceRange.ofToken(rangeTok)

		// `var` on all three: `emitCall` grows the argument columns in lockstep when the callee defaults an
		// argument the call omits, so they are its output as well as its input.
		let args = twoArgs(lo, second: hi)
		let argLabels = emptyArgLabels(args)
		let argRanges = uniformArgRanges(args, range: range)
		return try self.emitCall(qualifiedMethodName(self.signatures.interfaceMap().libraryNameOf(typeName), methodName: CreateMethod), anchor: rangeTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: rangeTok, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: CalleeMint.rangeOperator, places: self.placesOfArguments(args, anchor: rangeTok))
	end 'emitRangeValue'

	// ⭐ **THE INLINE CONDITIONAL `<t> if <c> else <f>`.** Called with the TRUE arm already
	// parsed (into `startBlock` since the mark) and the current token at `if`. Two obligations shape it:
	//
	//   **ONLY THE SELECTED ARM IS EVALUATED.** `0 if d == 0 else n / d` must not divide when d is 0, so
	//   neither arm may sit on the unconditional path. The false arm is easy — parsed straight into its own
	//   block. The true arm is not: nothing announced the ternary until the `if` that follows it, so it was
	//   emitted into the fall-through path and is DETACHED here and re-attached inside the true branch. The
	//   IR moves (its `module.ops` indices are unchanged; only the block referencing them changes); nothing
	//   is re-parsed, so no value id is minted twice and no closure is lifted twice.
	//
	//   **THE TWO ARMS MERGE THROUGH ONE PHI**, exactly as a `match` expression's `gives` arms do — so the
	//   merge is `finalizeMatchMerge` over a two-arm reaching set with no carried vars. That reuse is the
	//   whole point: the give-type agreement (E3005), the cross-register-class refusal,
	//   the owned-give normalisation, and the conditional-move reconciliation are ONE implementation for both
	//   forms, so a ternary cannot drift from a match on any of them.
	// `armSlot` is the receiving slot's answer for the whole conditional, read by `parseValueExpression` before
	// the true arm could spend it and re-issued below at the false arm's own first token — see there.
	function parseTernaryExpression(func IrFunction, trueValue ValueId, trueBlame immutable ByteArray, startBlock IrBlock, markOpRefCount ElementIndex, markBlockRefCount ElementIndex, markRangeSiteCount ElementIndex, markTempCount ElementIndex, markOwnedCount ElementIndex, preMoveMark MoveMark, armSlot DeclaredArrayInstance, tupleArmSlot DeclaredTupleTarget) returns ValueId throws SourceParseError
		let ifTok = try self.consume(TokenKind.if)

		// Where the true arm's VALUE lives: `startBlock` when the arm emitted only straight-line ops, or the
		// arm's own exit block when it grew control flow (a short-circuit, a nested ternary, a match).
		let armExit = self.bodyState.currentBlock

		// ⭐ **THE TRUE ARM SETTLES EVERYTHING WHILE IT IS STILL DETACHABLE, AND ITS DROPS TRAVEL WITH IT.**
		// The arm was parsed onto the unconditional path before the `if` revealed the form, so its temporaries
		// (`[1,2].count() if c else …` builds one) are enrolled as though they were the enclosing statement's —
		// and after the relocation below the arm runs on ONE edge, where a release on the unconditional path
		// would free a value the false path never built. Settling HERE, before the ops are collected, puts the
		// releases in the tail of `startBlock` that `relocatedOpRefs` sweeps into `trueBranch` (or, for an arm
		// that grew control flow, into the arm's own inner exit block, which is relocated too). So they ride
		// the SAME relocation the arm does and need no second mechanism to follow them. It is also before
		// `captureMoveMark` below, so the give transfer's own poison is captured into the true arm's move state.
		//
		// ⭐⭐ **THE OWNED-BINDING RELEASE IS PART OF EVERY FORK REGION, THE TERNARY ARM'S INCLUDED.**
		// Every fork region has `dropArmScopedOwned`: an `if`/`else` branch, a `try`'s `otherwise` handler, a `catch`
		// handler and every `match` arm. `giveTemporaryScopeLifetime` can enrol an owned binding in a ternary arm: a
		// temporary a BORROW
		// was taken out of inside this arm is enrolled here, and left to the enclosing scope it would be
		// decref'd on the path that never built it (MEASURED as the `restoreMoveMark` height panic one screen
		// down, which is the same fact caught by the bookkeeping instead of by the register allocator).
		let settledTrue = try self.finishArmExit(MatchGiveValue.value(trueValue), tempFloor: markTempCount, ownedFloor: markOwnedCount, exitBlock: armExit, anchor: ifTok)

		// Which block the arm ended in, read before `startBlock` — which it may be — is rewritten below.
		let armExitId = armExit.id

		// ⭐ **THE CONDITION RUNS FIRST AT RUNTIME, THOUGH IT PARSES SECOND.** The true arm was parsed before
		// the `if` revealed the form, so any binding it MOVED (an owned value into a struct field, say) is
		// poisoned now — but the condition, which runs BEFORE the true arm, must see that binding LIVE
		// (`Box.create(k) if isSet(k) else …` reads a live `k`). So the true arm's move state is snapshotted
		// and REWOUND to the pre-ternary state; the condition then parses from there, and the true path's mark
		// is re-formed below as the union of the two.
		let afterTrueArm = self.captureMoveMark()
		self.restoreMoveMark(preMoveMark)

		// ⭐ **DETACH THE TRUE ARM off the unconditional path.** Its ops are the tail of `startBlock`'s
		// `opRefs` since the mark; its terminator and outgoing edges (present only when the arm grew control
		// flow — unset/empty for a straight-line arm, since `startBlock` was unterminated at the mark) and its
		// inner blocks (the `func.blockRefs` tail since the mark) go with them. The ops keep their
		// `module.ops` indices; only the block that references them changes.
		let relocatedOpRefs = self.detachOpRefsAbove(startBlock, mark: markOpRefCount)

		// The arm's range-check sites are exactly the ones recorded since the mark, and that is true only
		// HERE — the condition parses into `startBlock` a few lines down and records sites of its own, which
		// stay put. Read the upper bound before it can move (`rehomeArmRangeSites`).
		let armRangeSiteEnd = self.bodyState.rangeCheckSites.count()

		let savedTerminator = startBlock.terminator
		let savedEdges = startBlock.branchEdges
		startBlock.terminator = Terminator.unset
		startBlock.branchEdges = BranchEdgeArray.create(0)

		let armInnerBlockRefs = BlockRefArray.create(func.blockRefs.count() - markBlockRefCount, zeroed: false)

		for i in markBlockRefCount upto func.blockRefs.count() 'collectBlocks'
			armInnerBlockRefs.push(try func.blockRefs.get(i) otherwise panic("parseTernaryExpression: func.blockRefs.get OOB at {i}"))
		end 'collectBlocks'

		while func.blockRefs.count() > markBlockRefCount 'truncBlocks'
			_ = try func.blockRefs.pop() otherwise panic("parseTernaryExpression: func.blockRefs.pop above the mark {markBlockRefCount} failed")
		end 'truncBlocks'

		if self.bodyState.blockPositionsCovered > markBlockRefCount 'rewindBlockIndex'
			self.bodyState.blockPositionsCovered = markBlockRefCount
		end 'rewindBlockIndex'

		// ⭐ **THE CONDITION IS THE ONE THING THAT IS UNCONDITIONAL** — it lands where the true arm was and
		// runs before the branch. It may short-circuit and move `currentBlock`, so the two-way branch belongs
		// at the end of whichever block it left (`condExit`), exactly as `parseIfStatement` re-reads its entry
		// after the condition.
		self.bodyState.currentBlock = startBlock

		// The condition is an ordinary expression that must be a bool — NOT `parseBoolCondition`, whose
		// E3005 "'if' requires a bool condition" is shared with the `if`/`while` STATEMENTS. A ternary's
		// non-bool condition is E2028 "ternary expression requires a bool condition" (#80), anchored at
		// the `if` (where `parseBoolCondition` anchors at the condition token).
		let cond = try self.parseExpression(func, block: startBlock)
		let condTag = self.tagOf(cond)

		if not typeClassAdmits(TypeClass.boolean, tag: condTag) 'nonBoolCondition'
			throw SourceParseError.ternaryNonBoolCondition(self.valueKindWord(cond), line: ifTok.line, column: ifTok.column)
		end 'nonBoolCondition'

		let condExit = self.bodyState.currentBlock
		let orders = self.conditionOrdersOf(cond)

		self.restoreStashedOperands()

		// The CONDITION is unconditional, so its own temporaries die on the single path, in the block the
		// condition left control in — the `if`-statement rule, applied to the ternary's condition.
		self.drainPendingTemps(markTempCount, anchor: ifTok)

		// The move state after the (unconditional) condition — the base BOTH arms build on. The TRUE path is
		// that base PLUS the true arm's own moves (rewound above); the FALSE path is that base plus the false
		// arm's, and it inherits `condBase` as the live state directly, since the false arm parses next.
		let condBase = self.captureMoveMark()
		let trueMoveMark = orMoveMarks(afterTrueArm, b: condBase, ledger: self.bodyState.moveLedger)

		try self.consume(TokenKind.else)

		// Reattach the true arm inside a fresh branch, physically after the condition's blocks. `trueExit` is
		// where its value lives now: the true branch itself when the arm was straight-line, else the arm's own
		// (relocated) exit block.
		let trueBranch = self.artifact.module.addBlock(func, label: b"ternarytrue", heat: BlockHeat.normal)
		trueBranch.replaceBodyOps(relocatedOpRefs)
		trueBranch.terminator = savedTerminator
		trueBranch.branchEdges = savedEdges

		// The ops have moved; so must every position recorded against them. Done here rather than at the
		// detach because the destination block is what the arm's sites have to name, and it could not be
		// minted any earlier — it has to sort after the condition's own blocks.
		self.rehomeArmRangeSites(startBlock.id, toBlock: trueBranch.id, opShift: markOpRefCount, firstSite: markRangeSiteCount, endSite: armRangeSiteEnd)

		for br in armInnerBlockRefs 'reattach'
			func.blockRefs.push(br)
		end 'reattach'

		// Held by ID: a second owning NAME for `trueBranch` would move the block out of it (single
		// ownership), and the branch is still read below for the condition's `then` target. The one
		// consumer re-fetches by id, as any block read across block-minting calls must — and the false arm's `parseExpression` between here and there mints plenty.
		var trueExitId = trueBranch.id

		if armExitId != startBlock.id 'multiBlockArm'
			trueExitId = armExitId
		end 'multiBlockArm'

		// The false arm parses straight into its own block, so it never runs on the true path — from the
		// post-condition move state (`condBase`, the current live state), never the true arm's moves. A full
		// `parseExpression` — a chained `… else b if c2 else d` right-associates here.
		let falseBranch = self.artifact.module.addBlock(func, label: b"ternaryfalse", heat: BlockHeat.normal)

		// The FALSE arm's owned floor is the height AFTER the condition, not `markOwnedCount`: the condition
		// runs unconditionally, so a temporary IT holds for a borrow belongs to the enclosing scope and must
		// survive both arms. The true arm's floor is the pre-condition height for exactly the same reason read
		// the other way — it parsed before the condition existed.
		let falseArmOwnedCount = self.bodyState.ownedBindings.count()
		let falseArmTok = self.current()
		let falseArmStart = self.pos

		// ⭐ **THE SLOT ANSWERS THIS ARM TOO.** The request is keyed on a token and the true arm consumed the
		// one keyed on the conditional's own first token, so the false arm gets it re-issued against its own —
		// which is also how a chained `… else b if c else d` passes it down, since the inner conditional's
		// first token IS this one.
		self.stateArrayLiteralTargetAt(armSlot, tokenIndex: falseArmStart)
		self.stateTupleLiteralTargetAt(tupleArmSlot, tokenIndex: falseArmStart)
		let falseOrderFloor = self.assumeOrders(orders.whenFalse)
		let falseValue = try self.parseExpression(func, block: falseBranch)
		self.bodyState.orderFacts.forgetAbove(falseOrderFloor)
		self.noteIsolatedPartOrigin(falseValue, startIndex: falseArmStart, endIndex: self.pos)
		let falseBlame = self.expressionImmutableBlame(falseArmTok, valueStart: falseArmStart)
		let falseExit = self.bodyState.currentBlock

		// The false arm settles in ITS exit block — the mirror of the true arm's, through the same door and
		// for the same reason: the arm runs on one edge only.
		let settledFalse = try self.finishArmExit(MatchGiveValue.value(falseValue), tempFloor: markTempCount, ownedFloor: falseArmOwnedCount, exitBlock: falseExit, anchor: ifTok)

		let falseMoveMark = self.captureMoveMark()

		// The merge is the SAME block-arg join a `match` expression uses (see the header). Two reaching arms,
		// no carried vars; `finalizeMatchMerge` runs every give-agreement/ownership rule and mints the result
		// phi and both edges. The ternary supplies only the branch out of the condition, emitted after so
		// `condExit` is still open when the merge's per-arm reconciliation runs.
		let carried = VarInfoArray.create(0)
		let reachingArms = MatchArmExitArray.create(2, zeroed: false)
		let trueExit = try self.blockById(func, id: trueExitId) otherwise panic("parseTernaryExpression: the true arm's exit block {trueExitId} is not in its own function")
		reachingArms.push(MatchArmExit.create(trueExit, exitVals: ValueIdArray.create(0), give: settledTrue, moveMark: trueMoveMark, blame: trueBlame))
		reachingArms.push(MatchArmExit.create(falseExit, exitVals: ValueIdArray.create(0), give: settledFalse, moveMark: falseMoveMark, blame: falseBlame))
		let outcome = try self.finalizeMatchMerge(func, matchTok: ifTok, carried: carried, reachingArms: reachingArms, construct: MergeConstruct.ternary)

		self.emitCondBranch(condExit, cond: cond, thenId: trueBranch.id, elseId: falseBranch.id, ifTok: ifTok)

		self.bodyState.currentBlock = outcome.cont

		match outcome.result 'r'
			value(id) then return id
			none then panic("parseTernaryExpression: the merge produced no value — both arms give a value, so the result phi is always present")
		end 'r'
	end 'parseTernaryExpression'

	// An `if` / `while` condition: an ordinary expression that must have type `bool`.
	//
	// **MAXON HAS NO C-STYLE TRUTHINESS.** `if 4` is not "if 4 is nonzero" — it is a type
	// error, and the ONLY tier that can say so is this one, because it is the only one holding
	// the expression's source type. The x64 lowering tests a non-fused condition with
	// `cmp reg, 0` + `jne`, which is exactly right for a bool (a bool IS 0 or 1, and a call
	// result, a parameter or a merge phi has no flags to fuse) — and is precisely why an `int`
	// condition silently "worked", branching on `n != 0`. The instruction cannot tell the two
	// apart. The type can.
	//
	// An `unresolved` condition is ADMITTED, not rejected: a cross-file callee's return type is
	// not known here, and `if isReady()` must compile. `typeClassAdmits` defers on `unknown`.
	//
	// The diagnostic anchors on the CONDITION's first token, not on the keyword: the message is
	// about the expression's type, and that is where the reader has to look — an `if` whose
	// condition spans three lines should not point at the `if`.
	function parseBoolCondition(func IrFunction, block IrBlock, kwTok Token) returns ValueId throws SourceParseError
		let condTok = self.current()
		let cond = try self.parseExpression(func, block: block)

		let condTag = self.tagOf(cond)

		if not typeClassAdmits(TypeClass.boolean, tag: condTag) 'notABool'
			throw SourceParseError.nonBoolCondition(kwTok.kind.rawValue, got: self.valueKindWord(cond), line: condTok.line, column: condTok.column)
		end 'notABool'

		return cond
	end 'parseBoolCondition'

	// The precedence-climbing core. Parse a unary/primary operand, then while the next token
	// is a binary operator whose precedence is >= `minPrec`, consume it and recurse for the
	// right operand at `precedence + 1` (which makes the operator LEFT-associative). A
	// supported operator below `minPrec`, a non-operator, or the end of the expression stops
	// the climb.
	//
	// FOUR dispatches:
	//
	//   1. a SHORT-CIRCUIT `and`/`or` over a bool left operand ⇒ not an op at all. It becomes
	//      blocks and a merge phi (or, over a known left operand, the deciding operand), and it
	//      MOVES `currentBlock` (see emitShortCircuit), which is why `left`'s block is re-read
	//      from the field after every recursive call.
	//   2. a comparison ⇒ `MaxonOp.compare`, typed `boolean`.
	//   3. REFERENCE IDENTITY `is` / `is not` ⇒ also a `MaxonOp.compare`, but over the two operands'
	//      POINTERS and with nothing dispatched. It takes its own arm because `is not` is two tokens and
	//      because neither operand may be `integerizedOperand`ed — see there.
	//   4. everything else ⇒ `MaxonOp.binOp`. This is where a bitwise `and`/`or`/`xor` lands:
	//      the short-circuit test above did not fire, so the operands are not bools, and on
	//      integers the word operators ARE the bit operators.
	//
	// No arm rejects anything.
	function parseBinary(func IrFunction, minPrec InfixPrecedence) returns ValueId throws SourceParseError
		// The LEFT operand's first token, remembered before it is parsed — the twin of `rhsStart` below,
		// and read for the same kind of question: `integerizedOperand` needs to know whether an operand
		// was written as a lone character LITERAL, which is a fact about its tokens, not about its value.
		let leftStart = self.pos
		var left = try self.parseCast(func)

		while true 'climb'
			let opIndex = self.pos
			let opTok = self.current()

			let prec = try infixPrecedence(opTok.kind) otherwise break

			if prec < minPrec 'stop'
				break
			end 'stop'

			// `and fallthrough` ends a match arm's body — it is the fallthrough SUFFIX, not a
			// bitwise `and`. `fallthrough` is a keyword and can never be a variable, so `and
			// fallthrough` has no reading as an expression ANYWHERE in the language; stopping the
			// climb here hands the suffix intact to the match arm parser, which either
			// consumes it or — in a match EXPRESSION arm — rejects the stray `and` (E2001). No mode
			// flag is needed precisely because the pairing is unambiguous everywhere.
			if opTok.kind == TokenKind.and and self.peekKind() == TokenKind.fallthrough 'fallthroughSuffix'
				break
			end 'fallthroughSuffix'

			self.releaseCompletedOperand()

			// The short-circuit test reads the LEFT operand's type only, and reads it BEFORE the right
			// operand is parsed — it has to, because whether the right operand is evaluated AT ALL is the
			// thing being decided.
			if shortCircuitOperator(opTok.kind) and tagIsBool(self.tagOf(left)) 'shortCircuit'
				self.advance()
				left = try self.emitShortCircuit(func, leftValue: left, opTok: opTok, rhsMinPrec: prec + 1)
				continue
			end 'shortCircuit'

			// ⭐ **REFERENCE IDENTITY `a is b` / `a is not b`** (`specs/reference-identity.md`) — a FOURTH
			// dispatch, and it takes the operator's own arm rather than the shared tail below for two reasons,
			// both of which would be silent wrong answers if it did not:
			//
			//   • **`is not` is TWO TOKENS.** The `not` is consumed HERE, before the right operand is parsed, so
			//     it never reaches `parseUnary` as a prefix `not` over a struct.
			//   • **NEITHER OPERAND MAY BE `integerizedOperand`ed.** That door turns a lone CHARACTER LITERAL
			//     into an `int` when the other side is integral — right for `cp - '0'`, and for `is` it would
			//     replace one of the two records whose ADDRESSES are the whole question with a codepoint.
			if identityOperator(opTok.kind) 'referenceIdentity'
				self.advance()
				let negate = self.at(TokenKind.not)

				if negate 'isNot'
					self.advance()
				end 'isNot'

				_ = self.holdStorageReadForStatement(left, kind: HoldKind.identityOperand, range: SourceRange.ofToken(opTok), position: OperandSuccession.alwaysFollowed)
				let other = try self.parseUnclaimedBinary(func, minPrec: prec + 1)
				left = try self.emitReferenceIdentity(left, rhs: other, negate: negate, opTok: opTok)
				continue
			end 'referenceIdentity'

			self.advance()
			left = self.holdStorageReadForStatement(left, kind: HoldKind.binaryOperand, range: SourceRange.ofToken(opTok), position: OperandSuccession.alwaysFollowed)

			// The right operand's token span, remembered BEFORE it is parsed and read back after.
			// It is not what the shift rule ASKS — that is the constant folder's job — but it is
			// where E2054 POINTS, and the climber has already decided how far the operand reaches.
			let rhsStart = self.pos
			let right = try self.parseUnclaimedBinary(func, minPrec: prec + 1)
			let rhsEnd = self.pos

			// ⭐⭐ **A BINARY OPERATOR IS AN INTEGER-EXPECTING POSITION FOR WHICHEVER SIDE IS A CHARACTER
			// LITERAL WHEN THE OTHER SIDE IS INTEGRAL** — `cp == '-'`, `'-' == cp` and `cp - '0'` alike. Asked
			// of both operands, each against what the OTHER is, and asked HERE rather than inside the
			// comparison arm because `specs/char-literal-to-int.md` documents the rule over "a binary
			// operation", not over a comparison: its own `char-literal-arithmetic` case subtracts.
			//
			// ⚠ The second call reads `leftValue`'s tag rather than `left`'s, because the first may have
			// turned a Character into an `int` and the right operand must be judged against what the left
			// now IS. Two character literals settle each other by staying Characters, which is what makes
			// `'A' == 'A'` a Character comparison (`char-literal-to-int.md`'s own case name says so).
			let leftValue = try self.integerizedOperand(left, expected: self.tagOf(right), start: leftStart, pastEnd: opIndex)
			let rightValue = try self.integerizedOperand(right, expected: self.tagOf(leftValue), start: rhsStart, pastEnd: rhsEnd)
			self.admitUnsignedLiteralBeside(leftValue, partner: rightValue)
			self.admitUnsignedLiteralBeside(rightValue, partner: leftValue)

			if comparisonOperator(opTok.kind) 'comparison'
				left = try self.emitCompare(leftValue, rhs: rightValue, op: infixCmpOp(opTok.kind), opTok: opTok)

				if self.trackedLetCasts() 'someLetIsACast'
					self.settleLetCastComparison(leftValue, lhsFirst: leftStart, lhsPast: opIndex, rhs: rightValue, rhsFirst: rhsStart, rhsPast: rhsEnd)
				end 'someLetIsACast'

				continue
			end 'comparison'

			self.nameUnaliasedCharacterOperandsAsCodepoints(leftValue, rhs: rightValue)

			let op = infixMaxonOp(opTok.kind)

			// A shift's right operand is not an ordinary number but a DISTANCE, and Maxon's rule
			// for it (Go's) is deliberately not the hardware's. It gets its own emitter, which
			// owns the rule, the diagnostic, AND the runtime guard. See `emitShift`.
			if shiftOperator(op) 'isShift'
				left = try self.emitShift(func, lhs: leftValue, count: rightValue, op: op, opTok: opTok, countStart: rhsStart, countEnd: rhsEnd)
				continue
			end 'isShift'

			// A division's right operand is not an ordinary number either: it is the one operand in the
			// language whose VALUE decides whether the operation can fail. It gets its own emitter, which owns
			// the rule, both diagnostics AND the throwing desugar — the same split, for the same reason, as the
			// shift above. See `emitDivOrMod`.
			if divisionOperator(op) 'isDivision'
				left = try self.emitDivOrMod(func, dividend: leftValue, divisor: rightValue, op: op, opTok: opTok)
				continue
			end 'isDivision'

			left = try self.emitBinOp(leftValue, rhs: rightValue, op: op, opTok: opTok)

			if self.trackedLetCasts() 'someLetIsACast'
				self.settleLetCastArithmetic(left, op: op, lhs: leftValue, lhsFirst: leftStart, lhsPast: opIndex, rhs: rightValue, rhsFirst: rhsStart, rhsPast: rhsEnd)
			end 'someLetIsACast'
		end 'climb'

		return left
	end 'parseBinary'

	// ⭐ Emit `lhs <op> count` under TypeRules' ⭐ THE SHIFT RULE — THE one place a source-level
	// shift is built. Two jobs, separate on purpose:
	//
	//   **LEGALITY.** A count the parser can FOLD is decided here: a negative one is E2054. A count
	//   of 64 or more is LEGAL and is NOT an error — it shifts every bit out — which is the whole
	//   narrowing of this diagnostic. A count the parser CANNOT fold is Go's runtime panic, which
	//   The compiler cannot raise yet; see `emitGuardedShift`.
	//
	//   **VALUE.** A folded count is rewritten into the shift its semantics define, so no count
	//   above `MaxUnguardedShiftCount` ever reaches codegen and the hardware's masking is never
	//   consulted. A count that could neither be folded NOR PROVEN gets the GUARD, which saturates
	//   it at run time — to the SAME answer. That the two agree is not a coincidence: both are
	//   readings of `evalShift`.
	//
	//   ⭐ **PROVEN is the third answer, from a type or a recorded interval** — see
	//   `shiftCountIsProvenUnguarded`. A count the parser cannot see the VALUE of, it may still see the
	//   BOUNDS of; when those bounds
	//   lie inside the counts the instruction takes as written, the saturation is dead code and the
	//   shift is emitted bare. It is the same instruction a folded in-range count gets below, because
	//   it is the same fact — only who established it differs.
	function emitShift(func IrFunction, lhs ValueId, count ValueId, op MaxonBinOp, opTok Token, countStart ElementIndex, countEnd ElementIndex) returns ValueId throws SourceParseError
		// The SHIFT's OWN operand rule, asked BEFORE anything is emitted. `emitBinOp` would ask it
		// too, but by then the guard's ops are already in the IR — and the FIRST of them is an
		// `and`, so `4 shr flag` would be rejected as a bad `and` rather than as a bad `shr`
		// (E3005 for the wrong operator instead of E2004 for the right one). A rejected program
		// must also leave no ops behind.
		//
		// ⭐ Asked through `numberTagOf` for `emitBinOp`'s reason: a float-backed enum's bits are a
		// sign/exponent/mantissa triple, so `Weight.light shl 1` has no shift reading and is refused HERE,
		// in the shift's own words, rather than shifting a mantissa.
		try self.requireBinOpOperands(op, left: self.numberTagOf(lhs), leftValue: lhs, right: self.numberTagOf(count), rightValue: count, opTok: opTok)

		// ⭐ THE SHIFT RULE's one question, asked ONCE, of the LEFT operand — and then CARRIED: to
		// the opcode, to the fold, and to the guard. Never re-derived, because the whole class of
		// bug this file has already paid for is two readers of one rule reaching two answers.
		let signFills = shiftFillsWithSign(op, leftOperandIsUnsigned: self.valueIsUnsigned(lhs))
		let shiftOp = shiftOpcodeFor(op, signFills: signFills)

		if not self.constIsKnown(count) 'dynamic'
			// A count nobody can FOLD may still be one nobody can put OUT OF RANGE. Then the guard
			// below would compute a saturation that provably never fires, so the operand goes to the
			// instruction exactly as a folded in-range count does at the end of this function — one
			// unguarded shift, reached by two routes to the same bound.
			//
			// ⚠ Spelled out here rather than merged with that tail, and the merge was measured: folding
			// the two would put `folded` inside a block, so `recordConst` would owe a SECOND
			// `constOf(count)` read — one repeated call traded for another, in the half of this function
			// where the legality diagnostics live.
			//
			// ⚠ **AND THE TWO CALLS CANNOT COME TO DISAGREE, WHICH IS THE HALF THAT DECIDES IT.** What a
			// duplicated emission risks is one site quietly gaining a clause the other never does; there is
			// no clause here to gain. `signFills` and `shiftOp` are derived ONCE above and CARRIED to every
			// arm — the discipline this function's header states — so both calls hand the instruction the
			// same opcode from the same derivation, and the same two operands this function was given. The
			// THIRD `emitBinOp` below is not a copy of either: it shifts by `clamped`, not by `count`.
			if self.shiftCountIsProvenUnguarded(count) 'proven'
				return try self.emitBinOp(lhs, rhs: count, op: shiftOp, opTok: opTok)
			end 'proven'

			return try self.emitGuardedShift(func, lhs: lhs, count: count, op: shiftOp, opTok: opTok)
		end 'dynamic'

		let folded = self.constOf(count)

		if shiftCountIsNegative(folded) 'negative'
			// Constructed and thrown in ONE expression. A `throw self.someHelper(…)` — building the error in
			// a helper and throwing what it returns — LEAKS the boxed union, which the suite's leak check
			// catches as an extra stderr line.
			let anchor = self.shiftCountAnchor(countStart, countEnd: countEnd)
			throw SourceParseError.shiftCountNegative(folded, line: anchor.line, column: anchor.column)
		end 'negative'

		if not shiftCountIsUnguarded(folded) 'shiftedOut'
			// A count that shifts every bit out. There is no instruction for it — the hardware
			// would mask it straight back into range — so the compiler writes down what it MEANS.
			// A shift that fills with ZEROS (`shl`, and an unsigned `shrLogical`) leaves the constant
			// 0. One that fills with the SIGN leaves the sign, and `x shr 63` already IS the sign, so
			// it becomes a shift by `MaxUnguardedShiftCount`. Neither is the masked shift the
			// hardware would have performed (`x shl 64` == `x`, `x shl 100` == `x shl 36`).
			//
			// `lhs` keeps its ops either way: they may have side effects, and Go evaluates the
			// left operand of a shift whatever the count turns out to be.
			if not signFills 'zeroFill'
				return self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
			end 'zeroFill'

			let clamped = self.emitLiteral(MaxUnguardedShiftCount, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
			return try self.emitBinOp(lhs, rhs: clamped, op: shiftOp, opTok: opTok)
		end 'shiftedOut'

		// A count the instruction takes as written; the hardware's mask is a no-op on it. The
		// operand is emitted UNCHANGED — this compiler folds no constant expression INTO the IR
		// (`1 + 2` still emits an `add`; see FoldConstOperands' header), and a shift count that
		// folds to 3 is a shift by 3 whether it arrives as a literal or as an `add`.
		let result = try self.emitBinOp(lhs, rhs: count, op: shiftOp, opTok: opTok)

		// The shift's own value, when the parser holds both sides — RECORDED, not rewritten. It is
		// what makes `let A = 1 shl 4` a count that `x shl A` can see. It folds under the OPCODE the
		// rule already chose, so the constant recorded here and the instruction that opcode emits
		// cannot answer differently — there is one fact, not two.
		if self.constIsKnown(lhs) 'bothKnown'
			self.recordConst(result, folded: evalShift(self.constOf(lhs), count: folded, op: shiftOp))
		end 'bothKnown'

		return result
	end 'emitShift'

	// ⭐⭐ **DO THIS COUNT'S BOUNDS ALREADY PROVE THE GUARD DEAD?** — the one question that lets a count
	// the parser cannot FOLD reach the instruction unguarded. The bounds are its declared alias's or,
	// failing that, an interval recorded for it, such as a counted loop's counter's or that of a sum,
	// difference or product of ranged operands. `provenIntervalOf` withholds an unsigned-topped interval, whose upper bound is
	// not a signed number.
	//
	// `emitGuardedShift`'s ops exist to fold a count OUTSIDE `MinShiftCount..MaxUnguardedShiftCount` back
	// to the answer `evalShift` defines — that function's header states what they cost, and this one does
	// not restate it. A count whose bounds cannot HOLD such a value is already inside, so every one of
	// them is dead: computed, and then thrown away by a mask that is always zero. `RegBits.RegNum`
	// (`int(0 to 63)`) is the shape that pays for it — `regMaskContains` is one `shr` carrying the whole
	// of that cost, at fourteen inlined call sites.
	//
	// ⚠ **IT COMPOSES `TypeRules.shiftCountIsUnguarded`, ONCE PER BOUND, AND SPELLS NO NUMBER.** That
	// predicate IS "a count the instruction takes as written"; `foldConstOperands` asks it of a count's
	// VALUE and this asks it of a count's BOUNDS, so the fold and the elision cannot come to disagree
	// about where the span ends. Restating `0..63` here would be another copy of the operand width,
	// which `MaxUnguardedShiftCount`'s header already records the cost of.
	//
	// ⚠ **A FLOAT ALIAS IS REFUSED BEFORE ITS BOUNDS ARE READ, BECAUSE THEY ARE NOT NUMBERS.** They are
	// IEEE-754 bit patterns — the fork `aliasIsFloat` exists for — and `float(0.0 to 0.0)` rides as
	// `low == 0, high == 0`, a pair that reads as two perfectly good shift counts and is neither.
	//
	// ⚠⚠ **AND THAT ARM IS UNREACHABLE TODAY — DELIBERATELY KEPT, NOT AN OVERSIGHT.** `emitShift` asks
	// `requireBinOpOperands` first, and a float count is E3005 there (MEASURED: both `float(0.0 to 1.0)`
	// and the `float(0.0 to 0.0)` above are refused *"operator 'shl' requires integer operands, but this
	// one is float"*). It stays because it is a PRECONDITION on reading these two fields as numbers, not a
	// second opinion about which operands a shift takes: without it this function's correctness would rest
	// on a refusal in another function, and the safe answer if that refusal ever moved is the one it gives.
	//
	// ⚠ **WHAT THE `true` ANSWER RESTS ON** is the induction `TypeRules.rangeCoversDenotedRange`'s header
	// states: a value denoting alias `A` is IN `A`'s range, because a cast site guards its result, a
	// parameter is guarded at the callee's entry and a `return` before its `ret`.
	//
	// ⛔⛔ **`valueDenotedAlias`, NOT `declaredAliasOfValue` — A MERGE'S DECLARED ALIAS IS NOT A PROOF,
	// AND SPENDING IT AS ONE HERE COSTS THE ANSWER.** A phi crosses no door: an ASSIGNMENT is a door on
	// no tier, so a `var`
	// of a ranged alias reassigned around a loop carries whatever the body computed while its header
	// phi keeps the alias's NAME. This function is a PROOF reader by its own name, so it takes the
	// proof-aware spelling every other proof reader takes (`divisorProof`, `recordRangedReturnSite`,
	// E3010): a recorded cast target first — an `as` emits the guard, which is what makes `i as Bits`
	// inside a loop a genuine proof — then `provenAliasOfValue`, which withholds a merge nothing
	// lifted (`recordMergeAliasProof`).
	//
	// With `declaredAliasOfValue` here, where the answer must be `0`, `var n = 1 as Bits` stepped to
	// 71 around a `while` prints `1 shl n` as **128** (the hardware's masked `1 shl 7`), and `try f()
	// otherwise w` with `w == 100` prints **68719476736** (`1 shl 36`). Both are pinned by
	// `bitwise-operators.md`'s `a-merged-count-is-not-proven-*` cases, which go RED on this line alone
	// (sabotage-proved: restoring `declaredAliasOfValue` fails exactly those two, at their `'shl'`
	// assertion, and nothing else in the suite).
	//
	// The interval arm is pinned by `specs/bitwise-operators.md`'s `a-counted-loop-count-is-proven`.
	function shiftCountIsProvenUnguarded(count ValueId) returns bool
		let declaredProves = match self.valueDenotedAlias(count) 'count'
			undeclared gives false
			declared(alias) gives not aliasIsFloat(alias) and shiftCountIsUnguarded(alias.low) and shiftCountIsUnguarded(alias.high)
		end 'count'

		if declaredProves 'aDeclaredRange'
			return true
		end 'aDeclaredRange'

		let bounds = try self.provenIntervalOf(count) otherwise return false
		return shiftCountIsUnguarded(bounds.lo) and shiftCountIsUnguarded(bounds.hi)
	end 'shiftCountIsProvenUnguarded'
end 'Parser'
