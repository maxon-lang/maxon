// VerifyWarmRebuild — the warm-rebuild gate. `verify-warm-rebuild <file>`
// asserts five independent properties of the incremental query spine and prints a
// clear PASS/FAIL per property, so the driver exits 0 iff ALL hold.
//
//   1. Determinism (byte-identity): two independent COLD compiles of the same
//      input must emit byte-identical CodeResults.
//   2. Cache-hit (incrementality): a re-query over unchanged input must land as a
//      cache HIT, not recompute.
//   3. Invalidation (soundness): a re-query over CHANGED input must land as a MISS —
//      and only the memos that actually read that input may miss.
//   4. Warm equals cold: a compile that reuses the memos of files an edit did not touch must emit
//      exactly what a cold compile of the edited program emits, and leave every parse artifact it
//      reuses as the first merge left it.
//   5. Library reuse: a second program (the input plus a probe declaring its own interface) and a
//      third declaring none of the input's type names, compiled in one session after a sibling of
//      the third, are served every library parse with no footprint drift and emit what a cold
//      compile of each emits. A program that shadows a library name parses the library cold and
//      never consults the store.
//
// ⚠ **(3) IS THE ONE WITH TEETH.** (1) and (2) both prove a memo is STABLE; neither can catch the
// opposite failure — a memo that stays valid after an input it read has CHANGED — and that is the
// failure a cache actually kills you with, because it is a WRONG ANSWER served silently out of a
// hit. A parse reads every OTHER file's declarations through the whole-program signature index, so
// that failure is reachable. See `verifyInvalidation`.
//
// THE MUTATE-THE-MEMO TRAP (why the two checks are structured the way they are):
// `resolveTypes` mutates the merged `MaxonModule` IN PLACE (named -> concrete),
// and a `WarmGoal.merged` compile returns the SAME module object out of its memo. So one must
// NOT run the full pipeline twice over a single shared merged module and
// expect a clean second run — the second pipeline would see an already-resolved,
// mutated module. Both checks sidestep this:
//   - Determinism runs each compile on its OWN fresh Project/QueryDatabase, so the
//     two runs share no module object at all.
//   - Cache-hit compiles only to `WarmGoal.merged` between its two probes and never runs
//     resolveTypes/the backend, so the memoized module is never mutated.

// The emitted byte arrays compared for byte-identity. `data` is the `dataPrelude`
// (initial `.data` image); the rest map 1:1 to CodeResult fields.
enum EmittedSection
	code
	rdata
	symdata
	data
end 'EmittedSection'

// A query moves its hit-or-miss counter by exactly one; a query that does no work
// leaves it put. Named so the counter assertions read as intent, not magic 0/1.
let NoCounterMove = 0
let OneQuery = 1

// The result of comparing one section across the two compiles: either byte-
// identical (carrying the common byte count for the running total) or a rendered
// mismatch detail (first differing offset, or a trailing length difference).
union SectionComparison
	identical(byteCount BytePos)
	mismatch(detail String)
end 'SectionComparison'

// The determinism verdict over ALL sections: every section identical (with the
// summed byte count) or the FIRST section that differed (with its detail).
union DeterminismOutcome
	allIdentical(totalBytes BytePos)
	sectionDiffers(detail String)
end 'DeterminismOutcome'

// Run every property, printing a PASS/FAIL line for each and a final verdict. Returns whether ALL
// held (the driver maps that to the process exit code). Each runs on its OWN fresh Project, so no
// property can be contaminated by another's mutations. A file/IO CompileError from the initial cold
// compile (fileNotFound/noSourceFiles/readError) propagates to the caller, which prints a specific
// message. A CompileError from a property's probes is caught by `checkProperty`, which prints that
// property's FAIL line and lets the remaining properties run.
//
// A program that does not compile runs only the properties that need no compile and prints NOT RUN
// for the rest, and the gate fails: a property that did not run has not held.
export function verifyWarmRebuild(inputPath FilePath, target Target) returns bool throws CompileError
	print("verify-warm-rebuild {inputPath}\n")

	match try compileColdOnce(inputPath, target: target) 'cold'
		compiled(first) then return verifyEveryProperty(inputPath, target: target, first: first)
		refused then return verifyWhatNeedsNoCompile(inputPath, target: target)
	end 'cold'
end 'verifyWarmRebuild'

let NotRunReason = "the program does not compile"
let DeterminismLabel = "determinism"
let CacheLabel = "cache"
let InvalidationLabel = "invalidation"
let WarmLabel = "warm"
let LibraryReuseLabel = "library reuse"
let PropertiesNeedingACompile = [DeterminismLabel, WarmLabel, LibraryReuseLabel]

let WarmClause = "warm equals cold"
let ClauseSeparator = " + "

union WarmRebuildProperty
	determinism(first WarmImage)
	cache
	invalidation
	warm
	libraryReuse

	function label() returns String
		return match self 'which'
			determinism gives DeterminismLabel
			cache gives CacheLabel
			invalidation gives InvalidationLabel
			warm gives WarmLabel
			libraryReuse gives LibraryReuseLabel
		end 'which'
	end 'label'
end 'WarmRebuildProperty'

union PropertyVerdict
	held(clause String)
	failed
end 'PropertyVerdict'

typealias PropertyVerdictArray = Array with PropertyVerdict
typealias ClauseArray = Array with String

function verifyProperty(property WarmRebuildProperty, inputPath FilePath, target Target) returns PropertyVerdict throws CompileError
	match property 'which'
		determinism(first) then return verdictOf(try verifyDeterminism(inputPath, target: target, first: first), clause: DeterminismLabel)
		cache then return verdictOf(try verifyCacheHit(inputPath, target: target), clause: CacheLabel)
		invalidation then return verdictOf(try verifyInvalidation(inputPath, target: target), clause: InvalidationLabel)
		warm then return verdictOf(try verifyWarmCompileMatchesCold(inputPath, target: target), clause: WarmClause)
		libraryReuse then return (try verifyLibraryParseReuse(inputPath, target: target)).verdict()
	end 'which'
end 'verifyProperty'

function verdictOf(held bool, clause String) returns PropertyVerdict
	if held 'holds'
		return PropertyVerdict.held(clause)
	end 'holds'

	return PropertyVerdict.failed
end 'verdictOf'

function checkProperty(property WarmRebuildProperty, inputPath FilePath, target Target) returns PropertyVerdict
	let verdict = try verifyProperty(property, inputPath: inputPath, target: target) otherwise (cause) 'unchecked'
		printError("FAIL {property.label()}: could not be checked, {unavailabilityReason(cause)}\n")
		return PropertyVerdict.failed
	end 'unchecked'

	return verdict
end 'checkProperty'

function unavailabilityReason(cause CompileError) returns String
	return match cause.failure() 'failure'
		reportedDiagnostics gives "a program it compiles was refused (the diagnostics are above)"
		abandoned gives "the compile it needed was abandoned"
		driverFailed gives driverErrorSentence(cause)
	end 'failure'
end 'unavailabilityReason'

function verifyWhatNeedsNoCompile(inputPath FilePath, target Target) returns bool
	_ = checkProperty(WarmRebuildProperty.cache, inputPath: inputPath, target: target)
	_ = checkProperty(WarmRebuildProperty.invalidation, inputPath: inputPath, target: target)

	for property in PropertiesNeedingACompile 'eachProperty'
		print("NOT RUN {property}: {NotRunReason}\n")
	end 'eachProperty'

	printError("verify-warm-rebuild: FAIL ({PropertiesNeedingACompile.count()} properties did not run: {NotRunReason})\n")
	return false
end 'verifyWhatNeedsNoCompile'

function verifyEveryProperty(inputPath FilePath, target Target, first WarmImage) returns bool
	let verdicts = PropertyVerdictArray.create(0)
	verdicts.push(checkProperty(WarmRebuildProperty.determinism(first), inputPath: inputPath, target: target))
	verdicts.push(checkProperty(WarmRebuildProperty.cache, inputPath: inputPath, target: target))
	verdicts.push(checkProperty(WarmRebuildProperty.invalidation, inputPath: inputPath, target: target))
	verdicts.push(checkProperty(WarmRebuildProperty.warm, inputPath: inputPath, target: target))
	verdicts.push(checkProperty(WarmRebuildProperty.libraryReuse, inputPath: inputPath, target: target))

	let clauses = ClauseArray.create(0)
	var allOk = true

	for verdict in verdicts 'eachVerdict'
		match verdict 'outcome'
			held(clause) then clauses.push(clause)
			failed then allOk = false
		end 'outcome'
	end 'eachVerdict'

	if allOk 'passed'
		print("verify-warm-rebuild: PASS ({joinedClauses(clauses)})\n")
		return true
	end 'passed'

	printError("verify-warm-rebuild: FAIL\n")
	return false
end 'verifyEveryProperty'

function joinedClauses(clauses ClauseArray) returns String
	var joined = ""

	for clause in clauses 'eachClause'
		if not joined.isEmpty() 'aClauseBefore'
			joined.append(ClauseSeparator)
		end 'aClauseBefore'

		joined.append(clause)
	end 'eachClause'

	return joined
end 'joinedClauses'

// --- Property 1: determinism (byte-identity across two independent cold compiles) ---

// One independent COLD compile: a fresh Project/QueryDatabase loaded from
// `inputPath`, driven through the shared compile path to an emitted CodeResult and
// then discarded. Determinism compares two of these; each MUST own its Project so
// the two share no mutable module object (the mutate-the-memo trap in the header).
function compileColdOnce(inputPath FilePath, target Target) returns ColdCompile throws CompileError
	let warm = freshWarmSession()
	_ = try warm.load(OnlySlot, input: inputPath, target: target)
	let reading = try warm.tryCompile(OnlySlot, goal: WarmGoal.codeResult(true))

	if reading.refused 'aRefusedProgram'
		return ColdCompile.refused
	end 'aRefusedProgram'

	return ColdCompile.compiled(reading.image)
end 'compileColdOnce'

union ColdCompile
	compiled(image WarmImage)
	refused
end 'ColdCompile'

let OnlySlot = "only"

function freshWarmSession() returns WarmSession
	return WarmSession.over(memoryOnlyCompileDriver(), sink: DiagnosticSink.printing())
end 'freshWarmSession'

function verifyDeterminism(inputPath FilePath, target Target, first WarmImage) returns bool throws CompileError
	// Two INDEPENDENT cold compiles, each with its OWN Project/QueryDatabase (see the
	// mutate-the-memo trap in this file's header). Two fresh projects share no module
	// object, so each is a genuine cold compile and the byte comparison is meaningful.
	match try compileColdOnce(inputPath, target: target) 'second'
		compiled(second) then return determinismVerdict(first, second: second)
		refused then return reportDeterminismFail("the second cold compile of the program was refused, though the first compiled")
	end 'second'
end 'verifyDeterminism'

function determinismVerdict(first WarmImage, second WarmImage) returns bool
	return match compareImages(first, right: second) 'outcome'
		allIdentical(totalBytes) gives reportDeterminismPass(totalBytes)
		sectionDiffers(detail) gives reportDeterminismFail(detail)
	end 'outcome'
end 'determinismVerdict'

// Compare every emitted section of two compiles, summing identical bytes; stop at the
// FIRST section that differs and report it (that is the actionable failure).
function compareImages(left WarmImage, right WarmImage) returns DeterminismOutcome
	var totalBytes = 0 as BytePos

	for section in EmittedSection.allCases 'each'
		match compareSection(section.name, left: emittedSectionOf(left, section: section), right: emittedSectionOf(right, section: section)) 'result'
			identical(byteCount) then totalBytes = totalBytes + byteCount
			mismatch(detail) then return DeterminismOutcome.sectionDiffers(detail)
		end 'result'
	end 'each'

	return DeterminismOutcome.allIdentical(totalBytes)
end 'compareImages'

function emittedSectionOf(result WarmImage, section EmittedSection) returns ByteArray
	return match section 'which'
		code gives result.code
		rdata gives result.rdata
		symdata gives result.symdata
		data gives result.data
	end 'which'
end 'emittedSectionOf'

function reportDeterminismPass(totalBytes BytePos) returns bool
	print("PASS determinism: {totalBytes} bytes identical across 2 cold compiles\n")
	return true
end 'reportDeterminismPass'

function reportDeterminismFail(detail String) returns bool
	printError("FAIL determinism: {detail}\n")
	return false
end 'reportDeterminismFail'

// Byte-compare one section. Reports the first differing offset (with both byte
// values), or a trailing length difference; otherwise identical with the count.
function compareSection(name String, left ByteArray, right ByteArray) returns SectionComparison
	let leftCount = left.count()
	let rightCount = right.count()

	var common = leftCount

	if rightCount < common 'rightShorter'
		common = rightCount
	end 'rightShorter'

	for i in 0 upto common 'scan'
		let l = try left.get(i) otherwise panic("compareSection: left.get({i}) OOB (common={common})")
		let r = try right.get(i) otherwise panic("compareSection: right.get({i}) OOB (common={common})")

		if l != r 'diff'
			return SectionComparison.mismatch("section '{name}' differs at byte {i}: left={l}, right={r}")
		end 'diff'
	end 'scan'

	if leftCount != rightCount 'lengthDiff'
		return SectionComparison.mismatch("section '{name}' length differs: {leftCount} vs {rightCount} bytes (first {common} match)")
	end 'lengthDiff'

	return SectionComparison.identical(leftCount as BytePos)
end 'compareSection'

// --- Property 2: cache-hit (incrementality over unchanged input) ---

function verifyCacheHit(inputPath FilePath, target Target) returns bool throws CompileError
	// ONE Project shared across both `WarmGoal.merged` compiles, running ONLY the front end
	// between them (never resolveTypes/the backend) so the memoized module is never
	// mutated (see the mutate-the-memo trap in this file's header). This check therefore
	// never reaches the allocator at all.
	let warm = freshWarmSession()
	let loaded = try warm.load(OnlySlot, input: inputPath, target: target)
	let fileCount = loaded.sources.count()

	// Whole-program memo: the first call is a cold MISS, the second a cache HIT.
	let amMissBefore = loaded.counters.allModuleMisses
	let amHitBefore = loaded.counters.allModuleHits

	let first = (try warm.compile(OnlySlot, goal: WarmGoal.merged)).counters
	let amMissAfterFirst = first.allModuleMisses
	let amHitAfterFirst = first.allModuleHits

	let second = (try warm.compile(OnlySlot, goal: WarmGoal.merged)).counters
	let amMissAfterSecond = second.allModuleMisses
	let amHitAfterSecond = second.allModuleHits

	// Per-file memos survived the whole-program rebuild. The cold pass populated the
	// token/parse caches; the second (whole-program HIT) returned early and never
	// revisited them. Re-query each file directly: a content-hash-valid memo lands as
	// a HIT (no recompute), so token/parse HITS rise by fileCount while MISSES hold.
	//
	// The SIGNATURE index is re-validated on the same probe, and it is the one that had to be
	// added here: a parse memo is now keyed on the file's bytes AND on that index's hash
	// (QueryEngine.parseMemoKey), so `parseHits` rising is only meaningful if the index it was
	// keyed against is the one still in force. Every `queryParseOps` reads the index (that is why
	// the expected delta is `fileCount`), and if it ever RECOMPUTED it on unchanged input, the
	// rebuilt index would be a second object whose hash the parse memos were never stamped with —
	// the exact silent-staleness this key exists to prevent, caught as a miss instead of a wrong
	// answer.
	let tokHitBefore = second.tokenHits
	let actHitBefore = second.activeTokenHits
	let parHitBefore = second.parseHits
	let sigHitBefore = second.signatureHits
	let tokMissBefore = second.tokenMisses
	let actMissBefore = second.activeTokenMisses
	let sigMissBefore = second.signatureMisses

	let probed = try warm.probe(OnlySlot)
	let tokHitAfter = probed.counters.tokenHits
	let actHitAfter = probed.counters.activeTokenHits
	let parHitAfter = probed.counters.parseHits
	let sigHitAfter = probed.counters.signatureHits
	let tokMissAfter = probed.counters.tokenMisses
	let actMissAfter = probed.counters.activeTokenMisses
	let parMissAfter = probed.counters.parseMisses
	let sigMissAfter = probed.counters.signatureMisses

	// Evaluate every assertion (each prints its own failure detail) before combining,
	// so a broken gate reports ALL violated properties, not just the first.
	let firstIsMiss = assertCounterMove("first FrontEndRun is a miss (allModuleMisses)", before: amMissBefore, after: amMissAfterFirst, expectedDelta: OneQuery)
	let firstNoHit = assertCounterMove("first FrontEndRun records no hit (allModuleHits)", before: amHitBefore, after: amHitAfterFirst, expectedDelta: NoCounterMove)
	let secondIsHit = assertCounterMove("second FrontEndRun is a hit (allModuleHits)", before: amHitAfterFirst, after: amHitAfterSecond, expectedDelta: OneQuery)
	let secondNoMiss = assertCounterMove("second FrontEndRun records no new miss (allModuleMisses)", before: amMissAfterFirst, after: amMissAfterSecond, expectedDelta: NoCounterMove)
	let tokensHitOnRebuild = assertCounterMove("rebuild token re-query hits (tokenHits)", before: tokHitBefore, after: tokHitAfter, expectedDelta: fileCount as QueryCount)
	let parseHitOnRebuild = assertCounterMove("rebuild parse re-query hits (parseHits)", before: parHitBefore, after: parHitAfter, expectedDelta: fileCount as QueryCount)

	// One signature read per parse re-query — every `queryParseOps` reads the index before it can
	// even decide whether its own memo is valid.
	let signaturesHitOnRebuild = assertCounterMove("rebuild signature re-query hits (signatureHits)", before: sigHitBefore, after: sigHitAfter, expectedDelta: fileCount as QueryCount)

	// The ACTIVE (directive-filtered) stream is memoized separately and gets the same pair of
	// assertions, for the reason every other memo here has them: a cache nothing verifies is a cache
	// whose staleness bugs are simply unpaid (this file's own QueryDatabase header names that
	// failure). It matters more than most — this one memo feeds BOTH the declaration sweep and the
	// parse, so a stale entry IS the two disagreeing about what a file declares (see
	// ConditionalCompilation.maxon).
	let activeTokensHitOnRebuild = assertCounterMove("rebuild active-token re-query hits (activeTokenHits)", before: actHitBefore, after: actHitAfter, expectedDelta: fileCount as QueryCount)
	let activeTokensNotRecomputed = assertCounterMove("rebuild does not re-filter directives (activeTokenMisses)", before: actMissBefore, after: actMissAfter, expectedDelta: NoCounterMove)
	let tokensNotRecomputed = assertCounterMove("rebuild does not recompute tokens (tokenMisses)", before: tokMissBefore, after: tokMissAfter, expectedDelta: NoCounterMove)
	let parseNotRecomputed = assertParseMisses("rebuild does not recompute parse (parseMisses)", probe: probed.probe, expectedDelta: NoCounterMove)
	let signaturesNotRecomputed = assertCounterMove("rebuild does not recompute signatures (signatureMisses)", before: sigMissBefore, after: sigMissAfter, expectedDelta: NoCounterMove)

	let allOk = firstIsMiss and firstNoHit and secondIsHit and secondNoMiss and tokensHitOnRebuild and activeTokensHitOnRebuild and parseHitOnRebuild and signaturesHitOnRebuild and tokensNotRecomputed and activeTokensNotRecomputed and parseNotRecomputed and signaturesNotRecomputed

	if allOk 'passed'
		print("PASS cache: allModule miss->hit, tokens/directives/signatures/parse hit on rebuild (hits={tokHitAfter}/{actHitAfter}/{sigHitAfter}/{parHitAfter}, misses={tokMissAfter}/{actMissAfter}/{sigMissAfter}/{parMissAfter})\n")
		return true
	end 'passed'

	printError("FAIL cache: incrementality assertion(s) failed (see above)\n")
	return false
end 'verifyCacheHit'

// --- Property 3: invalidation (a parse memo tracks BOTH of its inputs) ---

// The synthetic edits property 3 makes. Each is APPENDED to a real source file that has
// already been shown to parse, so all of them leave it a valid Maxon file — and they differ in
// exactly the ways the parse memo's key has to be able to tell apart:
//
//   • a COMMENT changes the file's BYTES and nothing it DECLARES;
//   • a FUNCTION changes both.
//
// The probe function is named for what it is, and it is `bool`-returning and trivial so that no
// program it is appended to can fail to parse because of it. ⚠ Its name must NOT begin with `__`:
// that prefix is reserved for compiler internals and a source-level declaration using it is E2051 —
// a diagnostic the invalidation check reads as "the probe broke the program" (`stop parsing`). The
// name is distinctive enough that a collision with a real declaration in the edited file is not a
// practical concern, which is what the reserved prefix was reaching for the wrong way.
let BytesOnlyEditText = "// verify-warm-rebuild: bytes moved, declarations did not."
let DeclarationEditText = "function warmRebuildProbe() returns bool\n\treturn true\nend 'warmRebuildProbe'"

// ⭐ **THE CONSTANT-VALUE PROBE: the same declaration twice, differing ONLY in the NUMBER.**
//
// The two edits above move a declaration's IDENTITY — a name appears that did not exist before —
// so they are satisfied by a signature hash that mixes only NAMES. A top-level constant is the one
// declaration for which that is not enough: a use INLINES its value as a literal
// (`Parser.topLevelBindingReference`), so `let X = 7` becoming `let X = 8` changes what every
// OTHER file COMPILES TO while moving neither those files' bytes nor any name in the program.
// `ProgramSignatures.mixConstant` is what carries the value into the key; NOTHING ABOVE CAN SEE
// WHETHER IT STILL DOES.
//
// Measured, not argued (2026-07-15): with `mixConstant`'s value arm deleted — the whole regression
// — the two probes above still reported `PASS invalidation: … declaration edit re-parsed all 2`
// and the spec suite still reported 295/0. Both gates were blind, because both edits ADD A NAME
// and a name-only key moves on that. Only an edit that holds the name FIXED and moves the number
// can tell the two keys apart, which is what these two are for.
let ConstantValueEditBefore = "let warmRebuildProbeConstant = 7"
let ConstantValueEditAfter = "let warmRebuildProbeConstant = 8"

// ⭐ **THE IMAGED-RECORD PROBE: the same declaration twice, differing only in the BYTES A READER BAKES.**
//
// The constant probe above holds a scalar, whose value reaches its readers through `mixConstant`'s value
// arm. A constant ARRAY does not: it is IMAGE DATA, so `assignDataLabels` gives it no `dataLabel` — that
// walk labels only decls with storage — and a key built from shape-level facts plus that empty label carries
// nothing of the elements at all. Meanwhile every reader bakes the ELEMENT BYTES into its own ops
// (`Parser.emitImagedConstArrayLiteral` carries `bytes:`). So the number a reader compiles to moves while
// the key does not.
//
// Measured, not argued (2026-09-06): against a key carrying only the element kind and the label, this probe
// reported **1** re-parse (the edited file's own bytes) where the property demands `fileCount`, measured at
// **54**, while every other probe here passed. None of them can see it: every other probe in this file moves
// a NAME, a SCALAR or a KEYWORD, and a key that mixes those moves on all of them. Only an edit that holds
// the name and the element kind FIXED and moves the elements can tell a key that carries an imaged record's
// CONTENT from one that carries only its SHAPE.
let ArrayValueEditBefore = "let warmRebuildProbeArray = [1, 2]"
let ArrayValueEditAfter = "let warmRebuildProbeArray = [9, 9, 9]"

let ArraySignEditBefore = "let warmRebuildProbeSignArray = [1, -1]"
let ArraySignEditAfter = "let warmRebuildProbeSignArray = [1, u64.max]"

// ⭐⭐ **THE DECLARATION THE BOX PROBE IS BUILT OVER — BOUND ONCE, so "the type is held byte-identical
// across the pair" is STRUCTURAL rather than asserted.** A second copy could drift by one byte — a renamed
// case, an added `export` — and the probe would silently become a DECLARATION edit, which the probes above
// already gate; it would then report `fileCount` forever for the wrong reason and never fail again.
//
// The slot's range is the probe's own domain, one decimal digit, and the pair below fixes it at 1 and 2.
let WarmRebuildProbeBoxDecl = "typealias WarmRebuildProbeSlot = int(0 to 9)\nunion WarmRebuildProbeChoice\n\tfirst(value WarmRebuildProbeSlot)\n\tsecond\nend 'WarmRebuildProbeChoice'"

// ⭐ **THE STORED-BOX PROBE, ASSERTING THE OPPOSITE OF THE ARRAY PROBE ABOVE.**
//
// A module-level `let` initializer calls nothing (E3220), so a boxed union is the one record a constant can
// still be: it is built by `__module_init` into a `.data` slot, and every reader loads from the slot and
// bakes nothing of the construction. `first(1)` becoming `first(2)` therefore moves no reader's bytes, and
// the key carries the slot's type, brand and label and nothing of the construction (`mixRecordStorage`).
// Mix the construction in and every other probe here stays green while a keystroke inside any stored
// global's initializer re-parses the whole program.
let UnionPayloadEditBefore = "let warmRebuildProbeUnion = WarmRebuildProbeChoice.first(1)"
let UnionPayloadEditAfter = "let warmRebuildProbeUnion = WarmRebuildProbeChoice.first(2)"

// ⭐ **THE `static`-FLAG PROBE: the same interface requirement twice, differing ONLY in the KEYWORD.**
//
// Every probe above moves a NAME or a VALUE. An interface requirement's RECEIVER KIND is neither, and
// it is a fact a PARSE reads: a witness dispatch on a constrained type parameter
// REFUSES a `static` requirement (E3116) and the comparison operators refuse one as `Equatable`
// (E3005). So `function origin()` becoming `static function origin()` in one file changes whether
// ANOTHER file compiles at all, while moving neither that file's bytes nor any name in the program —
// which is exactly the rule `recordInterfaceDeclaration` states and exactly what its hash must carry.
//
// With `recordInterfaceDeclaration`'s `receiverShapeAbsent`/`receiverShapePresent` mix absent,
// this probe re-parses only the edited file where the property demands `fileCount`, while the
// spec suite and every other probe here pass. None of them can see it: every edit above moves a
// NAME or a VALUE, and a key that mixes those moves on all of them. Only an edit that holds the
// name, the formals and the result FIXED and moves the receiver kind can tell a key that carries
// the flag from one that does not.
let ReceiverKindEditBefore = "interface WarmRebuildProbeInterface\n\tfunction warmRebuildProbeRequirement() returns bool\nend 'WarmRebuildProbeInterface'"
let ReceiverKindEditAfter = "interface WarmRebuildProbeInterface\n\tstatic function warmRebuildProbeRequirement() returns bool\nend 'WarmRebuildProbeInterface'"

// ⭐ **AND THE SAME FLAG ON AN ORDINARY METHOD, WHICH IS A DIFFERENT POSITION IN THE HASH.** The probe above
// moves an interface REQUIREMENT's keyword, which rides through `recordInterfaceDeclaration`; a `type`'s or an
// `extension`'s method rides through `ProgramSignatures.mixDeclaration`, and a probe over one says nothing
// about the other — the pair of discriminators is shared, the two mix sites are not.
//
// It became a fact a PARSE reads when a bare sibling call learned to resolve against the whole-program index
// (`Parser.isImplicitSelfMethod`): `function of()` becoming `static function of()` decides whether ANOTHER
// file's `extension` body prepends the enclosing `self` to its bare `of()`, or calls it with none — a wrong
// answer or a wrong refusal, while that file's own bytes and every name in the program stay put.
//
// ⚠ **THE BODY AND THE SIGNATURE ARE HELD FIXED ON PURPOSE, INCLUDING THE ABSENCE OF PARAMETERS.** A method
// that takes one moves this hash anyway through its CALL-ALIGNED consume and default facts, which prepend
// `SelfParamName` and would make the probe pass on a key that carries nothing of the flag itself.
let MethodReceiverKindEditBefore = "type WarmRebuildProbeHost\n\texport function warmRebuildProbeMethod() returns bool\n\t\treturn true\n\tend 'warmRebuildProbeMethod'\nend 'WarmRebuildProbeHost'"
let MethodReceiverKindEditAfter = "type WarmRebuildProbeHost\n\texport static function warmRebuildProbeMethod() returns bool\n\t\treturn true\n\tend 'warmRebuildProbeMethod'\nend 'WarmRebuildProbeHost'"

// The extension's body is the same on both sides, so only the `implements` clause moves.
let ExtensionConformanceHostDecl = "interface WarmRebuildProbeMarker\n\tfunction warmRebuildProbeMark() returns bool\nend 'WarmRebuildProbeMarker'\nenum WarmRebuildProbeMarked\n\tfirst\nend 'WarmRebuildProbeMarked'"
let ExtensionConformanceEditBefore = "extension WarmRebuildProbeMarked\n\tfunction warmRebuildProbeMark() returns bool\n\t\treturn true\n\tend 'warmRebuildProbeMark'\nend 'WarmRebuildProbeMarked'"
let ExtensionConformanceEditAfter = "extension WarmRebuildProbeMarked implements WarmRebuildProbeMarker\n\tfunction warmRebuildProbeMark() returns bool\n\t\treturn true\n\tend 'warmRebuildProbeMark'\nend 'WarmRebuildProbeMarked'"

let ExportModifierText = "export "
let PublicModifierText = "public "
let NoModifierText = ""
let TopLevelDeclarationLead = ""
let WarmRebuildProbeStaticsLead = "type WarmRebuildProbeStatics\n\t"

let MovedDeclarationText = "export typealias WarmRebuildProbeMoved = int(0 to 9)"
let MethodHostDeclarationText = "export type WarmRebuildProbeVessel\n\texport let first as bool\n\tstatic function create(first bool) returns WarmRebuildProbeVessel\n\t\treturn Self\{first: first\}\n\tend 'create'\nend 'WarmRebuildProbeVessel'"
let MovedMethodText = "extension WarmRebuildProbeVessel\n\tstatic function warmRebuildProbeCarried() returns bool\n\t\treturn true\n\tend 'warmRebuildProbeCarried'\nend 'WarmRebuildProbeVessel'"

type VisibilityFlipProbe
	export let kind as String
	export let lead as String
	export let declaration as String

	static function create(kind String, lead String, declaration String) returns VisibilityFlipProbe
		return Self{kind: kind, lead: lead, declaration: declaration}
	end 'create'

	function spelledAt(modifier String) returns String
		return "{self.lead}{modifier}{self.declaration}"
	end 'spelledAt'
end 'VisibilityFlipProbe'

typealias VisibilityFlipProbeArray = Array with VisibilityFlipProbe

type InvalidationMeasurement
	export let kind as String
	export let probe as WarmProbe

	static function create(kind String, probe WarmProbe) returns InvalidationMeasurement
		return Self{kind: kind, probe: probe}
	end 'create'
end 'InvalidationMeasurement'

typealias InvalidationMeasurementArray = Array with InvalidationMeasurement

function visibilityFlipProbes() returns VisibilityFlipProbeArray
	let probes = VisibilityFlipProbeArray.create(0)
	probes.push(VisibilityFlipProbe.create("a ranged typealias", lead: TopLevelDeclarationLead, declaration: "typealias WarmRebuildProbeRange = int(0 to 9)"))
	probes.push(VisibilityFlipProbe.create("a function typealias", lead: TopLevelDeclarationLead, declaration: "typealias WarmRebuildProbeCallback = function() returns bool"))
	probes.push(VisibilityFlipProbe.create("a generic-instance typealias", lead: TopLevelDeclarationLead, declaration: "typealias WarmRebuildProbeFlags = Array with bool"))
	probes.push(VisibilityFlipProbe.create("a tuple typealias", lead: TopLevelDeclarationLead, declaration: "typealias WarmRebuildProbeTuple = (bool, bool)"))
	probes.push(VisibilityFlipProbe.create("a type", lead: TopLevelDeclarationLead, declaration: "type WarmRebuildProbeRecord\n\texport let flag as bool\n\tstatic function create(flag bool) returns WarmRebuildProbeRecord\n\t\treturn Self\{flag: flag\}\n\tend 'create'\nend 'WarmRebuildProbeRecord'"))
	probes.push(VisibilityFlipProbe.create("an enum", lead: TopLevelDeclarationLead, declaration: "enum WarmRebuildProbeChoice\n\tfirst\n\tsecond\nend 'WarmRebuildProbeChoice'"))
	probes.push(VisibilityFlipProbe.create("an interface", lead: TopLevelDeclarationLead, declaration: "interface WarmRebuildProbeContract\n\tfunction warmRebuildProbeAsk() returns bool\nend 'WarmRebuildProbeContract'"))
	probes.push(VisibilityFlipProbe.create("a top-level constant", lead: TopLevelDeclarationLead, declaration: "let warmRebuildProbeFlipConstant = 5"))
	probes.push(VisibilityFlipProbe.create("a static constant", lead: WarmRebuildProbeStaticsLead, declaration: "static let warmRebuildProbeLimit = 5\nend 'WarmRebuildProbeStatics'"))
	return probes
end 'visibilityFlipProbes'

function measureVisibilityFlips(warm WarmSession, editedPath FilePath, original String) returns InvalidationMeasurementArray throws CompileError
	let measurements = InvalidationMeasurementArray.create(0)

	for flip in visibilityFlipProbes() 'eachFlip'
		// Discarded: adding the declaration moves a name, so only the steps after it isolate a modifier.
		_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{flip.spelledAt(NoModifierText)}\n")
		_ = try probedMisses(warm)

		_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{flip.spelledAt(ExportModifierText)}\n")
		measurements.push(InvalidationMeasurement.create("{flip.kind}'s `export`", probe: try probedMisses(warm)))

		_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{flip.spelledAt(PublicModifierText)}\n")
		measurements.push(InvalidationMeasurement.create("{flip.kind}'s `export` to `public`", probe: try probedMisses(warm)))
	end 'eachFlip'

	return measurements
end 'measureVisibilityFlips'

function measureDeclarationMoves(warm WarmSession, editedPath FilePath, original String, receiver WarmSource) returns InvalidationMeasurementArray throws CompileError
	let measurements = InvalidationMeasurementArray.create(0)
	measurements.push(InvalidationMeasurement.create("a typealias MOVED to another file", probe: try measureDeclarationMove(warm, editedPath: editedPath, editedBase: original, receiverPath: receiver.path, receiverBase: receiver.content, moving: MovedDeclarationText)))
	measurements.push(InvalidationMeasurement.create("a method MOVED to another file", probe: try measureDeclarationMove(warm, editedPath: editedPath, editedBase: "{original}\n{MethodHostDeclarationText}", receiverPath: receiver.path, receiverBase: receiver.content, moving: MovedMethodText)))

	_ = try warm.edit(OnlySlot, path: editedPath, content: original)
	_ = try warm.edit(OnlySlot, path: receiver.path, content: receiver.content)
	_ = try probedMisses(warm)
	return measurements
end 'measureDeclarationMoves'

function measureDeclarationMove(warm WarmSession, editedPath FilePath, editedBase String, receiverPath FilePath, receiverBase String, moving String) returns WarmProbe throws CompileError
	// Discarded: seating the declaration in the edited file adds a name, so only the move after it
	// holds every name in the program fixed.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{editedBase}\n{moving}\n")
	_ = try warm.edit(OnlySlot, path: receiverPath, content: receiverBase)
	_ = try probedMisses(warm)

	_ = try warm.edit(OnlySlot, path: editedPath, content: editedBase)
	_ = try warm.edit(OnlySlot, path: receiverPath, content: "{moving}\n{receiverBase}")
	return try probedMisses(warm)
end 'measureDeclarationMove'

function measurementsInvalidateEveryFile(measurements InvalidationMeasurementArray, fileCount QueryCount) returns bool
	var allHeld = true

	for measurement in measurements 'eachMeasurement'
		if not assertParseMisses("{measurement.kind} edit re-parses EVERY file (parseMisses)", probe: measurement.probe, expectedDelta: fileCount) 'missed'
			allHeld = false
		end 'missed'
	end 'eachMeasurement'

	return allHeld
end 'measurementsInvalidateEveryFile'

typealias DiagnosticCensus = Map with (String, Count)

let CensusKeySeparator = "\t"
let CensusKeyDisplaySeparator = " | "

function censusKeyOf(diagnostic Diagnostic, filePath FilePath) returns String
	return "{filePath.toString()}{CensusKeySeparator}{diagnostic.code.rawValue}{CensusKeySeparator}{diagnostic.message}"
end 'censusKeyOf'

function diagnosticCensusOf(diagnostics DiagnosticArray, watched FilePathArray) returns DiagnosticCensus
	let census = DiagnosticCensus.create()

	for diagnostic in diagnostics 'eachDiagnostic'
		let anchored = try diagnostic.anchor.anchoredFile() otherwise continue

		if not pathIsAmong(watched, path: anchored) 'notAWatchedFile'
			continue
		end 'notAWatchedFile'

		let key = censusKeyOf(diagnostic, filePath: anchored)
		census.upsert(key, value: (try census.get(key) otherwise 0) + 1)
	end 'eachDiagnostic'

	return census
end 'diagnosticCensusOf'

function pathIsAmong(paths FilePathArray, path FilePath) returns bool
	for candidate in paths 'eachCandidate'
		if candidate.equals(path) 'found'
			return true
		end 'found'
	end 'eachCandidate'

	return false
end 'pathIsAmong'

function describeCensusDeparture(key String, expected Count, observed Count) returns String
	return "{key.replace(CensusKeySeparator, with: CensusKeyDisplaySeparator)} {observed} time(s) where the unedited program reports it {expected}"
end 'describeCensusDeparture'

function firstCensusDeparture(baseline DiagnosticCensus, current DiagnosticCensus) returns String throws AbsentError
	for (key, observed) in current 'eachCurrent'
		let expected = try baseline.get(key) otherwise 0

		if observed != expected 'moved'
			return describeCensusDeparture(key, expected: expected, observed: observed)
		end 'moved'
	end 'eachCurrent'

	for (key, expected) in baseline 'eachBaseline'
		if not current.contains(key) 'vanished'
			return describeCensusDeparture(key, expected: expected, observed: 0)
		end 'vanished'
	end 'eachBaseline'

	throw AbsentError.absent
end 'firstCensusDeparture'

// The fewest source files on which the INVALIDATION property says anything at all. TWO, and the
// reason is arithmetic rather than taste: the property's halves assert "a declaration edit
// re-parses `fileCount` files" (and likewise a constant-value edit) and "a bytes-only edit
// re-parses 1 file", and at `fileCount == 1` those are the same assertion — so the file's-own-bytes
// key that this property exists to REJECT satisfies them all. Named, so the refusal below and the
// reason for it are one fact.
let MinFilesForInvalidation = 2 as Count

// **THE PROPERTY THE SIGNATURE INDEX'S PARSE KEY EXISTS FOR** — and the two halves of it pull in
// opposite directions, so a key that satisfies one and not the other is simply wrong:
//
//   (a) EDIT A DECLARATION IN ONE FILE ⇒ EVERY file's parse must be invalidated. `b.maxon`'s bytes
//       did not move, but what `isReady()` MEANS inside it did. Keying a parse on the file's OWN
//       content hash alone serves `b.maxon` from cache with a parse built against the OLD return
//       type. Property 2 cannot see it: on unchanged input, that key is right.
//   (b) EDIT ONLY BYTES (a comment, a body) ⇒ ONLY that file's parse may be invalidated. This is
//       the half a lazy fix throws away: keying the parse on the COMPOSITE SOURCE hash would pass
//       (a) and re-parse the entire program on every keystroke — sound, and useless.
//   (c) EDIT A TOP-LEVEL CONSTANT'S **VALUE** ⇒ EVERY file's parse must be invalidated. Not a
//       special case of (a): (a) moves a NAME, and a key mixing only names passes it. A constant
//       is the one declaration whose VALUE is copied into its readers, so `let X = 7` → `8` must
//       move the key while no name in the program moves at all. See `ConstantValueEditBefore`.
//   (d) EDIT AN INTERFACE REQUIREMENT'S `static` FLAG ⇒ EVERY file's parse must be invalidated. Not a
//       special case of (a) or (c): no name moves and no value moves — a KEYWORD does, and a
//       parse in another file accepts or REFUSES on it. See `ReceiverKindEditBefore`.
//   (e) EDIT AN **IMAGED** RECORD CONSTANT'S CONTENT ⇒ EVERY file's parse must be invalidated, AND the
//       same edit on a STORED one may invalidate only the edited file. (c)'s pair at the shapes whose
//       value is a record rather than a number: an imaged `let` is `.rdata` and every read bakes its
//       bytes, while a stored `let`'s record is a slot every read loads from. The two pull opposite ways for one
//       spelling, so a key that mixed content unconditionally satisfies half of this and throws (b) away.
//       ⚠ **AND EACH RECORD ARM NEEDS ITS OWN PAIR**: an ARRAY and a BOX hash through different functions,
//       so a guard deleted in one is invisible to the other's probes. See `ArrayValueEditBefore`,
//       and `UnionPayloadEditBefore`.
//   (f) EDIT A DECLARATION'S VISIBILITY ⇒ EVERY file's parse must be invalidated, at each step
//       from no modifier to `export`, and `export` to `public`, for every
//       declaration kind in `visibilityFlipProbes`. No name and no value moves; another file's
//       parse admits or refuses the name on it.
//   (g) MOVE A DECLARATION TO ANOTHER FILE ⇒ EVERY file's parse must be invalidated. The program
//       declares the same names before and after; only the declaring file moves, and which files
//       may name a declaration is decided against it. See `measureDeclarationMoves`.
//   (h) EDIT AN `extension`'S `implements` CLAUSE ⇒ EVERY file's parse must be invalidated. No name,
//       value or keyword moves; the clause alone changes which types conform. See
//       `ExtensionConformanceEditBefore`.
//
// All of these are asserted here, on ONE fresh project, by editing real files in the query database
// and re-querying.
//
// ⚠ AND ON A SINGLE-FILE INPUT THIS PROPERTY PROVES NOTHING, SO IT REFUSES TO CLAIM IT DID.
// With `fileCount == 1` the assertions above collapse into the SAME assertion — (a), (c), (d),
// (e), (f), (g), (h) expect `fileCount` re-parses while (b) expects 1, and those are the same number —
// so a key that tracks only the file's own bytes, which is EXACTLY the bug this property exists to
// catch, sails through every one of them.
// **A gate you cannot see fail is not a gate**, so this one FAILS on a single-file input rather than
// reporting green, and says what to point it at.
function verifyInvalidation(inputPath FilePath, target Target) returns bool throws CompileError
	let warm = freshWarmSession()
	let loaded = try warm.load(OnlySlot, input: inputPath, target: target)
	let fileCount = loaded.sources.count()

	if fileCount < MinFilesForInvalidation 'cannotProve'
		printError("FAIL invalidation: this project has {fileCount} source file, and the property is VACUOUS on one — 'a declaration edit re-parses every file' and 'a bytes-only edit re-parses one file' are the same assertion when every file IS the one file, so the single-file-hash key this property exists to reject would PASS. Point the gate at a project with at least {MinFilesForInvalidation} files (a cross-file callee is the whole point: `a.maxon` declares it, `b.maxon` calls it)\n")
		return false
	end 'cannotProve'

	let first = try loaded.sources.get(0) otherwise panic("verifyInvalidation: the project has no source files — loadSourceFiles must throw noSourceFiles before this")
	let editedPath = first.path
	let original = first.content

	// Warm every per-file memo (and the signature index) against the UNEDITED program. Only the
	// front end runs (`WarmGoal.merged`), so nothing mutates the memoized module (the trap in this
	// file's header).
	let warmed = try warm.compile(OnlySlot, goal: WarmGoal.merged)
	let receiver = try lastAuthoredOf(loaded.sources, inputPath: inputPath)
	let edited = [editedPath, receiver.path]
	let censusBefore = diagnosticCensusOf(warmed.diagnostics, watched: edited)

	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{BytesOnlyEditText}\n")
	let bytesEditMisses = try probedMisses(warm)

	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{DeclarationEditText}\n")
	let declarationEditMisses = try probedMisses(warm)

	// Seat the constant probe at its BEFORE value. This transition adds a declaration, so it is an
	// ordinary declaration edit and its miss count asserts nothing new — it exists only to make the
	// NEXT transition a change of the number ALONE. Discarded for that reason.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ConstantValueEditBefore}\n")
	_ = try probedMisses(warm)

	// The measurement: same file, same declaration, same NAME — only the value moved.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ConstantValueEditAfter}\n")
	let constantValueEditMisses = try probedMisses(warm)

	// Seat the ARRAY probe at its BEFORE value — a declaration edit, discarded for the same reason its
	// scalar twin's is.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ArrayValueEditBefore}\n")
	_ = try probedMisses(warm)

	// The measurement: same name, same element kind — only the BYTES a reader bakes moved.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ArrayValueEditAfter}\n")
	let arrayValueEditMisses = try probedMisses(warm)

	// Seat the SIGN probe, then measure it: the elements' payload bits are identical, and only whether the
	// source wrote `-1` or `u64.max` moved, which is what decides how every reader renders and compares a read.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ArraySignEditBefore}\n")
	_ = try probedMisses(warm)

	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ArraySignEditAfter}\n")
	let arraySignEditMisses = try probedMisses(warm)

	// Seat the stored-BOX probe, then measure it: same type declaration, same case — only the payload
	// moved. The declaration is interpolated rather than carried in each pair, so the two spellings cannot
	// drift into a declaration edit (`WarmRebuildProbeBoxDecl`).
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{WarmRebuildProbeBoxDecl}\n{UnionPayloadEditBefore}\n")
	_ = try probedMisses(warm)

	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{WarmRebuildProbeBoxDecl}\n{UnionPayloadEditAfter}\n")
	let unionPayloadEditMisses = try probedMisses(warm)

	// Seat the receiver-kind probe at its BEFORE value — a declaration edit, discarded for the same
	// reason the two above are.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ReceiverKindEditBefore}\n")
	_ = try probedMisses(warm)

	// The measurement: same interface, same requirement, same formals and result — only `static` moved.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ReceiverKindEditAfter}\n")
	let receiverKindEditMisses = try probedMisses(warm)

	// Seat the METHOD receiver-kind probe at its BEFORE value — a declaration edit, discarded for the same
	// reason the three above are.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{MethodReceiverKindEditBefore}\n")
	_ = try probedMisses(warm)

	// The measurement: same type, same method, same result, no parameters — only `static` moved.
	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{MethodReceiverKindEditAfter}\n")
	let methodReceiverKindEditMisses = try probedMisses(warm)

	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ExtensionConformanceHostDecl}\n{ExtensionConformanceEditBefore}\n")
	_ = try probedMisses(warm)

	_ = try warm.edit(OnlySlot, path: editedPath, content: "{original}\n{ExtensionConformanceHostDecl}\n{ExtensionConformanceEditAfter}\n")
	let extensionConformanceEditMisses = try probedMisses(warm)

	let visibilityFlips = try measureVisibilityFlips(warm, editedPath: editedPath, original: original)

	if receiver.path.equals(editedPath) 'noSecondFileToMoveInto'
		printError("FAIL invalidation: {editedPath} is the only file of the project's own, so no declaration can be moved to another file — point the gate at a project with at least {MinFilesForInvalidation} files of its own\n")
		return false
	end 'noSecondFileToMoveInto'

	_ = try warm.edit(OnlySlot, path: editedPath, content: original)
	let declarationMoves = try measureDeclarationMoves(warm, editedPath: editedPath, original: original, receiver: receiver)

	// A synthetic edit that stopped an edited file reading would make BOTH assertions pass for the
	// wrong reason: the file contributes no declarations, so a declaration edit moves no other file's
	// key. Refuse to report on a probe whose premise broke.
	if let departure = try firstCensusDeparture(censusBefore, current: diagnosticCensusOf((try warm.read(OnlySlot)).diagnostics, watched: edited)) 'probeBrokeTheProgram'
		printError("FAIL invalidation: a synthetic probe edit made {editedPath} report {departure}, so the miss counts mean nothing (a file that cannot be read declares nothing, so an edit to it moves no other file's parse key)\n")
		return false
	end 'probeBrokeTheProgram'

	// `before: NoCounterMove` because each value above is already a DELTA — the misses that one edit
	// caused. Routed through the same reporter as property 2 so a failure prints the same way.
	let bytesEditIsLocal = assertParseMisses("a BYTES-ONLY edit re-parses only the edited file (parseMisses)", probe: bytesEditMisses, expectedDelta: OneQuery)
	let declarationEditInvalidatesEveryFile = assertParseMisses("a DECLARATION edit re-parses EVERY file (parseMisses)", probe: declarationEditMisses, expectedDelta: fileCount as QueryCount)
	let constantValueEditInvalidatesEveryFile = assertParseMisses("a top-level constant's VALUE edit re-parses EVERY file (parseMisses)", probe: constantValueEditMisses, expectedDelta: fileCount as QueryCount)

	let arrayValueEditInvalidatesEveryFile = assertParseMisses("a top-level constant ARRAY's value edit re-parses EVERY file (parseMisses)", probe: arrayValueEditMisses, expectedDelta: fileCount as QueryCount)
	let arraySignEditInvalidatesEveryFile = assertParseMisses("a top-level constant ARRAY's element SIGN edit re-parses EVERY file (parseMisses)", probe: arraySignEditMisses, expectedDelta: fileCount as QueryCount)
	let storedUnionEditIsLocal = assertParseMisses("a STORED boxed-union `let`'s payload edit re-parses only the edited file (parseMisses)", probe: unionPayloadEditMisses, expectedDelta: OneQuery)

	let receiverKindEditInvalidatesEveryFile = assertParseMisses("an interface requirement's `static` FLAG edit re-parses EVERY file (parseMisses)", probe: receiverKindEditMisses, expectedDelta: fileCount as QueryCount)
	let methodReceiverKindEditInvalidatesEveryFile = assertParseMisses("a method's `static` FLAG edit re-parses EVERY file (parseMisses)", probe: methodReceiverKindEditMisses, expectedDelta: fileCount as QueryCount)

	let extensionConformanceEditInvalidatesEveryFile = assertParseMisses("an `extension`'s `implements` clause edit re-parses EVERY file (parseMisses)", probe: extensionConformanceEditMisses, expectedDelta: fileCount as QueryCount)

	let visibilityFlipsInvalidate = measurementsInvalidateEveryFile(visibilityFlips, fileCount: fileCount as QueryCount)
	let declarationMovesInvalidate = measurementsInvalidateEveryFile(declarationMoves, fileCount: fileCount as QueryCount)

	let allOk = bytesEditIsLocal and declarationEditInvalidatesEveryFile and constantValueEditInvalidatesEveryFile and arrayValueEditInvalidatesEveryFile and arraySignEditInvalidatesEveryFile and storedUnionEditIsLocal and receiverKindEditInvalidatesEveryFile and methodReceiverKindEditInvalidatesEveryFile and extensionConformanceEditInvalidatesEveryFile and visibilityFlipsInvalidate and declarationMovesInvalidate

	if allOk 'passed'
		print("PASS invalidation: bytes-only edit re-parsed 1 file; declaration edit re-parsed all {fileCount}; constant-value, constant-array and constant-array-sign edits each re-parsed all {fileCount}; a stored boxed-union edit re-parsed 1 file; a requirement's and a method's `static`-flag edits and an extension's `implements` edit each re-parsed all {fileCount}; {visibilityFlips.count()} visibility edits each re-parsed all {fileCount}; {declarationMoves.count()} declarations moved to another file each re-parsed all {fileCount}\n")
		return true
	end 'passed'

	printError("FAIL invalidation: a parse memo does not track both of its inputs (see above)\n")
	return false
end 'verifyInvalidation'

// --- Property 4: warm equals cold (a reused parse means what it meant) ---

// ⭐ **THE EDIT IS BYTES-ONLY AND LANDS ON THE LAST FILE THE AUTHOR WROTE, AND BOTH CHOICES ARE THE
// MEASUREMENT.** A bytes-only edit keeps every other file's parse memo valid while the signature index is
// rebuilt from scratch, so the warm compile folds artifacts parsed against the OLD index into a NEW one. The
// last file is the one re-parsed after every reused artifact in fold order, which is where a parse could claim
// an instance id a reused artifact still holds for another instance. Properties 2 and 3 count memo hits and
// misses and cannot see that; only comparing what the two compiles EMIT can.
function verifyWarmCompileMatchesCold(inputPath FilePath, target Target) returns bool throws CompileError
	let warm = freshWarmSession()
	let loaded = try warm.load(OnlySlot, input: inputPath, target: target, debugInfo: true)
	let edited = try lastAuthoredOf(loaded.sources, inputPath: inputPath)

	if authoredCountOf(loaded.sources) < MinFilesForInvalidation 'cannotProve'
		printError("FAIL warm: this project has fewer than {MinFilesForInvalidation} source files of its own, so no file's parse is reused across the edit and a warm compile IS a cold one. Point the gate at a project with at least {MinFilesForInvalidation} files\n")
		return false
	end 'cannotProve'

	_ = try warm.compile(OnlySlot, goal: WarmGoal.merged)
	_ = try warm.snapshot(OnlySlot, tag: MergedSnapshot)

	_ = try warm.compile(OnlySlot, goal: WarmGoal.codeResult(false))
	_ = try warm.snapshot(OnlySlot, tag: PipedSnapshot)

	let editedContent = "{edited.content}\n{BytesOnlyEditText}\n"
	_ = try warm.edit(OnlySlot, path: edited.path, content: editedContent)
	_ = try warm.compile(OnlySlot, goal: WarmGoal.merged)
	_ = try warm.snapshot(OnlySlot, tag: RemergedSnapshot)

	let warmResult = (try warm.compile(OnlySlot, goal: WarmGoal.codeResult(true))).image
	_ = try warm.snapshot(OnlySlot, tag: RepipedSnapshot)

	let cold = freshWarmSession()
	_ = try cold.load(OnlySlot, input: inputPath, target: target, debugInfo: true)
	_ = try cold.edit(OnlySlot, path: edited.path, content: editedContent)
	let coldResult = (try cold.compile(OnlySlot, goal: WarmGoal.codeResult(true))).image

	let compared = try warm.compareParses(OnlySlot, merged: MergedSnapshot, piped: PipedSnapshot, remerged: RemergedSnapshot, repiped: RepipedSnapshot, edited: edited.path)
	let parsesUnchanged = reportImmutability(compared.immutability)

	return match compareImages(warmResult, right: coldResult) 'outcome'
		allIdentical(totalBytes) gives reportWarmPass(totalBytes) and parsesUnchanged
		sectionDiffers(detail) gives reportWarmFail(detail) and parsesUnchanged
	end 'outcome'
end 'verifyWarmCompileMatchesCold'

let MergedSnapshot = "merged"
let PipedSnapshot = "piped"
let RemergedSnapshot = "remerged"
let RepipedSnapshot = "repiped"

function authoredCountOf(sources WarmSourceArray) returns Count
	var authored = 0 as Count

	for source in sources 'eachSource'
		if not source.library 'authored'
			authored = authored + 1
		end 'authored'
	end 'eachSource'

	return authored
end 'authoredCountOf'

function reportImmutability(verdict WarmImmutability) returns bool
	if not verdict.changes.isEmpty() 'someChanged'
		for change in verdict.changes 'eachChange'
			printError("FAIL immutable: {change}\n")
		end 'eachChange'

		printError("FAIL immutable: {verdict.changes.count()} changes across {verdict.compared} reused parse artifacts, so a pass wrote into an object the parse cache owns\n")
		return false
	end 'someChanged'

	print("PASS immutable: {verdict.compared} reused parse artifacts, {verdict.digested} digested parts, the same objects before and after the edit and unchanged by both pipelines and by the second merge\n")
	return true
end 'reportImmutability'

function reportWarmPass(totalBytes BytePos) returns bool
	print("PASS warm: {totalBytes} bytes identical between a warm compile after a bytes-only edit and a cold compile of the edited program\n")
	return true
end 'reportWarmPass'

function reportWarmFail(detail String) returns bool
	printError("FAIL warm: a warm compile after a bytes-only edit emitted different bytes from a cold compile of the edited program — {detail}\n")
	return false
end 'reportWarmFail'

// --- Property 5: library parses reused across programs ---

// The probe's function is `public` because nothing in the program it is appended to calls it, and a
// unexported function nothing live names is E3219.
let LibraryReuseProbeText = "enum LibraryReuseProbeKind\n\tfirst\n\tsecond\nend 'LibraryReuseProbeKind'\n\ninterface LibraryReuseProbeShape\n\tfunction isFirst() returns bool\nend 'LibraryReuseProbeShape'\n\ntype LibraryReuseProbeRecord implements LibraryReuseProbeShape\n\tlet kind as LibraryReuseProbeKind\n\n\tstatic function create(kind LibraryReuseProbeKind) returns LibraryReuseProbeRecord\n\t\treturn Self\{kind: kind\}\n\tend 'create'\n\n\tfunction isFirst() returns bool\n\t\treturn self.kind == LibraryReuseProbeKind.first\n\tend 'isFirst'\nend 'LibraryReuseProbeRecord'\n\ntypealias LibraryReuseProbeRecords = Array with LibraryReuseProbeRecord\n\npublic function libraryReuseProbe() returns bool\n\tlet records = LibraryReuseProbeRecords.create(0)\n\trecords.push(LibraryReuseProbeRecord.create(LibraryReuseProbeKind.first))\n\tlet held = try records.get(0) otherwise return false\n\treturn held.isFirst()\nend 'libraryReuseProbe'"
let LibraryReusedClause = "library parses reused across programs"

union LibraryReuseOutcome
	failed
	reused
	parsedCold(verdict LibraryParseSharing)

	function verdict() returns PropertyVerdict
		return match self 'outcome'
			failed gives PropertyVerdict.failed
			reused or
			parsedCold gives PropertyVerdict.held(clause())
		end 'outcome'
	end 'verdict'

	function clause() returns String
		return match self 'outcome'
			reused gives LibraryReusedClause
			parsedCold(verdict) gives "library parsed cold ({verdict.name})"
			failed panic("LibraryReuseOutcome.clause: a failed property has no clause — the verdict line is printed only when every property held")
		end 'outcome'
	end 'clause'
end 'LibraryReuseOutcome'

function verifyLibraryParseReuse(inputPath FilePath, target Target) returns LibraryReuseOutcome throws CompileError
	emptySharedLibrary()
	let shared = freshWarmSession()
	_ = try shared.load(PrimerSlot, input: inputPath, target: target, edit: replacedBy(PrimerMainText))
	let primer = try shared.compile(PrimerSlot, goal: WarmGoal.codeResult(false))

	_ = try shared.load(FirstSlot, input: inputPath, target: target)
	let first = try compiledWithImage(shared, slot: FirstSlot)
	let verdict = (try shared.read(FirstSlot, sharing: true)).sharing

	let coldFirst = try compiledImageOfColdLoad(inputPath, target: target, edit: WarmLoadEdit.none)

	_ = try shared.load(SecondSlot, input: inputPath, target: target, edit: WarmLoadEdit.appendToLastAuthored(LibraryReuseProbeText))
	let second = try compiledWithImage(shared, slot: SecondSlot)

	let cold = try compiledImageOfColdLoad(inputPath, target: target, edit: WarmLoadEdit.appendToLastAuthored(LibraryReuseProbeText))
	let storeIsBounded = sharedStoreIsBounded(primer, second: second)

	if verdict == LibraryParseSharing.shareable 'aSiblingPublishes'
		_ = try shared.load(SiblingSlot, input: inputPath, target: target, edit: replacedBy(siblingProgramText()))
		_ = try shared.compile(SiblingSlot, goal: WarmGoal.codeResult(false))
	end 'aSiblingPublishes'

	_ = try shared.load(ThirdSlot, input: inputPath, target: target, edit: replacedBy(RenamedProgramText))
	let third = try compiledWithImage(shared, slot: ThirdSlot)

	let coldThird = try compiledImageOfColdLoad(inputPath, target: target, edit: replacedBy(RenamedProgramText))

	let firstMatchesCold = reusedMatchesCold(first.image, cold: coldFirst, subject: "the program compiled after a primer of another shape")
	let secondMatchesCold = reusedMatchesCold(second.image, cold: cold, subject: "a second program")
	let thirdMatchesCold = reusedMatchesCold(third.image, cold: coldThird, subject: "a third program declaring none of the first's type names")

	if not (firstMatchesCold and secondMatchesCold and thirdMatchesCold and storeIsBounded) 'aPropertyFailed'
		return LibraryReuseOutcome.failed
	end 'aPropertyFailed'

	if verdict == LibraryParseSharing.shareable 'theStoreIsOpen'
		return libraryReuseOutcome(primer, second: second, third: third)
	end 'theStoreIsOpen'

	return libraryColdOutcome(first, secondReading: second, verdict: verdict)
end 'verifyLibraryParseReuse'

function reusedMatchesCold(reused WarmImage, cold WarmImage, subject String) returns bool
	return match compareImages(reused, right: cold) 'outcome'
		allIdentical gives true
		sectionDiffers(detail) gives reportLibraryReuseDiffers(subject, detail: detail)
	end 'outcome'
end 'reusedMatchesCold'

let PrimerMainText = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let PrimerBlankText = "// verify-warm-rebuild: the primer program declares nothing here.\n"
let RenamedProgramText = "enum RenamedProbeDirection\n\tnorth\n\teast\nend 'RenamedProbeDirection'\n\nenum RenamedProbeSurface\n\tpaved\n\tgravel\nend 'RenamedProbeSurface'\n\ntypealias RenamedProbeMeters = int(0 to 1000)\n\ninterface RenamedProbeMeasured\n\tfunction metres() returns RenamedProbeMeters\nend 'RenamedProbeMeasured'\n\ntype RenamedProbeLeg implements RenamedProbeMeasured\n\tlet heading as RenamedProbeDirection\n\tlet surface as RenamedProbeSurface\n\tlet length as RenamedProbeMeters\n\n\tstatic function create(heading RenamedProbeDirection, surface RenamedProbeSurface, length RenamedProbeMeters) returns RenamedProbeLeg\n\t\treturn Self\{heading: heading, surface: surface, length: length\}\n\tend 'create'\n\n\tfunction metres() returns RenamedProbeMeters\n\t\treturn self.length\n\tend 'metres'\nend 'RenamedProbeLeg'\n\nunion RenamedProbeStep\n\tleg(value RenamedProbeLeg)\n\trest\nend 'RenamedProbeStep'\n\nunion RenamedProbeWeather\n\tclear\n\train(millimetres RenamedProbeMeters)\nend 'RenamedProbeWeather'\n\ntypealias RenamedProbeLegs = Array with RenamedProbeLeg\ntypealias RenamedProbeRoutes = Array with RenamedProbeLegs\ntypealias RenamedProbeNames = Map with (String, RenamedProbeMeters)\n\nfunction main() returns ExitCode\n\tlet legs = RenamedProbeLegs.create(0)\n\tlegs.push(RenamedProbeLeg.create(RenamedProbeDirection.north, surface: RenamedProbeSurface.paved, length: 5))\n\n\tlet routes = RenamedProbeRoutes.create(0)\n\troutes.push(legs)\n\n\tlet names = RenamedProbeNames.create()\n\tnames.upsert(\"first\", value: 5)\n\n\tlet step = RenamedProbeStep.leg(try legs.get(0) otherwise return 1)\n\tlet weather = RenamedProbeWeather.rain(2)\n\tvar travelled = 0 as RenamedProbeMeters\n\n\tmatch step 'inspect'\n\t\tleg(value) then travelled = value.metres()\n\t\trest then travelled = 0\n\tend 'inspect'\n\n\tmatch weather 'sky'\n\t\tclear then travelled = travelled + 1\n\t\train(millimetres) then travelled = travelled + millimetres\n\tend 'sky'\n\n\tlet wanted = try names.get(\"first\") otherwise 0\n\n\tif routes.count() == 1 and travelled > wanted 'aRoute'\n\t\treturn 0\n\tend 'aRoute'\n\n\treturn 1\nend 'main'"

// The store holds one parse per library file and variant, keyed on the library hash, which an input
// whose own typealiases implement a library interface moves. The third's key then equals no earlier
// program's, so a sibling with the third's declarations under other names publishes it first.
let RenamedProbeNamePrefix = "RenamedProbe"
let SiblingProbeNamePrefix = "SiblingProbe"

function siblingProgramText() returns String
	return RenamedProgramText.replace(RenamedProbeNamePrefix, with: SiblingProbeNamePrefix)
end 'siblingProgramText'

function replacedBy(firstFileText String) returns WarmLoadEdit
	return WarmLoadEdit.replaceAuthored(firstFileText, others: PrimerBlankText)
end 'replacedBy'

function compiledWithImage(warm WarmSession, slot String) returns WarmReading throws CompileError
	return try warm.compile(slot, goal: WarmGoal.codeResult(true))
end 'compiledWithImage'

function compiledImageOfColdLoad(inputPath FilePath, target Target, edit WarmLoadEdit) returns WarmImage throws CompileError
	let cold = freshWarmSession()
	_ = try cold.load(OnlySlot, input: inputPath, target: target, edit: edit)

	return (try compiledWithImage(cold, slot: OnlySlot)).image
end 'compiledImageOfColdLoad'

let PrimerSlot = "primer"
let FirstSlot = "first"
let SecondSlot = "second"
let SiblingSlot = "sibling"
let ThirdSlot = "third"

let LibraryParseVariantsPerFile = 2 as QueryCount

function sharedStoreIsBounded(primerReading WarmReading, second WarmReading) returns bool
	let primer = primerReading.counters
	let admitted = second.counters.admittedLibraryFiles
	let held = second.counters.storeEntries
	let parsesHeld = second.counters.storeParses
	let firstReadNothing = assertCounterMove("the first program of a session reads no token stream out of the empty store (sharedTokenHits)", before: NoCounterMove, after: primer.sharedTokenHits, expectedDelta: NoCounterMove)
	let holdsWhatWasAdmitted = assertCounterMove("the store holds exactly the byte-contents admitted — {held} held, {admitted} admitted", before: NoCounterMove, after: held, expectedDelta: admitted)
	var secondReadTokens = true
	var parsesAreBounded = true

	if second.counters.sharedTokenHits == NoCounterMove 'neverFired'
		printError("FAIL: the second program of a session read no token stream out of the store (sharedTokenHits), so every other property here passed over a mechanism that never fired\n")
		secondReadTokens = false
	end 'neverFired'

	if parsesHeld > admitted * LibraryParseVariantsPerFile 'outgrewItsVariants'
		printError("FAIL: the store holds {parsesHeld} library parse artifacts for {admitted} admitted files, past the {LibraryParseVariantsPerFile} (bodies built, bodies skipped) a file can have — the store grows with the programs compiled rather than with the library\n")
		parsesAreBounded = false
	end 'outgrewItsVariants'

	return firstReadNothing and holdsWhatWasAdmitted and secondReadTokens and parsesAreBounded
end 'sharedStoreIsBounded'

function reportLibraryReuseDiffers(which String, detail String) returns bool
	printError("FAIL library reuse: {which}, compiled in a session whose store holds other programs' library parses, emitted different bytes from a cold compile of it — {detail}\n")
	return false
end 'reportLibraryReuseDiffers'

function libraryReuseOutcome(primerReading WarmReading, second WarmReading, third WarmReading) returns LibraryReuseOutcome
	let primer = primerReading.counters
	let secondCounters = second.counters
	let thirdCounters = third.counters
	let admitted = secondCounters.admittedLibraryFiles
	let firstReadNothing = assertCounterMove("the primer program of a session reads no library parse out of the empty store (sharedParseHits)", before: NoCounterMove, after: primer.sharedParseHits, expectedDelta: NoCounterMove)
	let secondReusedEveryFile = everyLibraryParseServed("the second program", program: secondCounters)
	let thirdReusedEveryFile = everyLibraryParseServed("the third program, which declares none of the first's type names", program: thirdCounters)

	if not (firstReadNothing and secondReusedEveryFile and thirdReusedEveryFile) 'aPropertyFailed'
		printError("FAIL library reuse: the store did not serve every library parse to the second and third programs (see above)\n")
		return LibraryReuseOutcome.failed
	end 'aPropertyFailed'

	print("PASS library reuse: {secondCounters.sharedParseReusedFiles} of {admitted} library parse artifacts, published by the primer and the programs after it ({primer.sharedParsePublishes} publishes, {secondCounters.sharedParseDrifts} drifted), served to a second program that differs by an enum, a type, an array of it and a function ({secondCounters.sharedParseHits} hits, {secondCounters.sharedParseMisses} misses) and to a third that shares none of the first's type names ({thirdCounters.sharedParseHits} hits, {thirdCounters.sharedParseMisses} misses, {thirdCounters.sharedParseDrifts} drifted), each compiling to what a cold compile of it emits\n")
	return LibraryReuseOutcome.reused
end 'libraryReuseOutcome'

function everyLibraryParseServed(who String, program WarmCounters) returns bool
	let admitted = program.admittedLibraryFiles
	let reusedFiles = program.sharedParseReusedFiles
	let served = assertCounterMove("every library file's parse is served to {who} ({reusedFiles} of {admitted} files)", before: NoCounterMove, after: reusedFiles, expectedDelta: admitted)
	let neverDrifted = assertCounterMove("no held library parse has its footprint move under {who} (sharedParseDrifts)", before: NoCounterMove, after: program.sharedParseDrifts, expectedDelta: NoCounterMove)
	return served and neverDrifted
end 'everyLibraryParseServed'

function libraryColdOutcome(firstReading WarmReading, secondReading WarmReading, verdict LibraryParseSharing) returns LibraryReuseOutcome
	let first = firstReading.counters
	let second = secondReading.counters
	let neverPublished = assertCounterMove("a program that shares no library parse publishes none (sharedParsePublishes)", before: NoCounterMove, after: first.sharedParsePublishes + second.sharedParsePublishes, expectedDelta: NoCounterMove)
	let neverServed = assertCounterMove("a program that shares no library parse reads none out of the store (sharedParseHits)", before: NoCounterMove, after: first.sharedParseHits + second.sharedParseHits, expectedDelta: NoCounterMove)
	let neverAsked = assertCounterMove("a program that shares no library parse never consults the store (sharedParseMisses)", before: NoCounterMove, after: first.sharedParseMisses + second.sharedParseMisses, expectedDelta: NoCounterMove)

	if not (neverPublished and neverServed and neverAsked) 'aPropertyFailed'
		printError("FAIL library reuse: the store was consulted for a program whose library parse is refused ({verdict.name}) (see above)\n")
		return LibraryReuseOutcome.failed
	end 'aPropertyFailed'

	print("PASS library reuse: library parsed cold ({verdict.name}); the store was never consulted and a second program compiles to what a cold compile of it emits\n")
	return LibraryReuseOutcome.parsedCold(verdict)
end 'libraryColdOutcome'

function lastAuthoredOf(sources WarmSourceArray, inputPath FilePath) returns WarmSource throws CompileError
	var index = sources.count()

	while index > 0 'fromTheEnd'
		index = index - 1
		let source = try sources.get(index) otherwise panic("lastAuthoredOf: index {index} is below the {sources.count()} sources")

		if not source.library 'authored'
			return source
		end 'authored'
	end 'fromTheEnd'

	throw CompileError.noSourceFiles(inputPath)
end 'lastAuthoredOf'

// Re-query every file's parse and report how many RECOMPUTED, naming them. The miss DELTA is the whole
// measurement: it names exactly which memos the preceding edit invalidated.
function probedMisses(warm WarmSession) returns WarmProbe throws CompileError
	return (try warm.probe(OnlySlot)).probe
end 'probedMisses'

// `assertCounterMove` over a parse-miss probe, naming the missed files on failure: a stale parse memo
// is located by its path, which the count cannot carry.
function assertParseMisses(label String, probe WarmProbe, expectedDelta QueryCount) returns bool
	if assertCounterMove(label, before: NoCounterMove, after: probe.misses, expectedDelta: expectedDelta) 'held'
		return true
	end 'held'

	for missed in probe.missed 'eachMiss'
		printError("  parse miss: {missed}\n")
	end 'eachMiss'

	return false
end 'assertParseMisses'

// Assert a counter moved by exactly `expectedDelta`, printing the offending values
// (before, delta, after) on failure so a violated assertion is self-describing.
// Returns whether it held; callers combine several without short-circuiting so
// every violation is reported.
//
// The prefix is property-neutral because BOTH the cache and the invalidation properties report
// through here — each is a statement about a query counter, and each prints its own summary line.
function assertCounterMove(label String, before QueryCount, after QueryCount, expectedDelta QueryCount) returns bool
	let expected = before + expectedDelta

	if after == expected 'ok'
		return true
	end 'ok'

	printError("FAIL: {label}: expected {before}+{expectedDelta}={expected}, got {after}\n")
	return false
end 'assertCounterMove'
