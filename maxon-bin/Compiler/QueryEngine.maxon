// QueryEngine — input registration, dependency tracking, and content-hash
// cache validity. The mechanical layer under the typed queries in Queries.maxon.
//
// Validity is a direct content-hash compare: a memo stamped `keyHash` is valid
// iff the input it summarizes still hashes to `keyHash`. No dependency graph is
// walked, which is what makes the per-file caches trivially parallel-safe.
//
// **So the compiler records no dependency graph at all** — a memo's inputs are named by the one
// function that computes its key, DERIVED rather than observed. One was recorded here
// anyway, for a future that arrived and did not use it; see QueryDatabase.maxon's header.

// --- Source input registration ---

// Register or update a file's content. Computes the content hash once; if the
// file is already present with the SAME hash, this is a no-op (an unrelated
// file's edit never disturbs this file's TOKEN cache key — its PARSE key also
// carries the signature index's hash, which an unrelated file's edit moves only
// if it changed a DECLARATION; see `parseMemoKey`). A new or changed file is
// upserted with its fresh hash — no shared revision counter is touched.
export function fileChanged(project Project, path FilePath, content String)
	let hash = mixBytes(Hasher.empty(), bytes: content.toByteArray())

	if let existing = try project.db.sourceFiles.get(path) 'exists'
		if existing.contentHash == hash 'unchanged'
			return
		end 'unchanged'
	end 'exists' else 'newFile'
		project.db.sourcePaths.push(path)
	end 'newFile'

	project.db.sourceFiles.upsert(path, value: SourceFileEntry.create(content, contentHash: hash))

	project.db.compositeHashValid = false
end 'fileChanged'

// ⚠ The flag clear at the end is not bookkeeping. `ProgramSignatures` is keyed on the composite
// hash and `moduleDirectoryOfPathText` panics on a path it does not hold, so an index left standing
// over a path set that has moved takes the server down on the next visibility question.
module function filesRemoved(project Project, paths MaxonSourcePathSet)
	if paths.count() == 0 'nothingWentAway'
		return
	end 'nothingWentAway'

	var kept = FilePathArray.create()

	// `path` is a borrow of an element of the array being walked, so nothing here may write
	// `project.db.sourcePaths` — the kept list replaces it only once the walk is over.
	for path in project.db.sourcePaths 'eachRegistered'
		if not paths.contains(path) 'stillRegistered'
			kept.push(path)
			continue
		end 'stillRegistered'

		forgetOneSourceFile(project, path: path)
	end 'eachRegistered'

	project.db.sourcePaths = kept
	project.db.compositeHashValid = false
end 'filesRemoved'

function forgetOneSourceFile(project Project, path FilePath)
	_ = project.db.sourceFiles.remove(path)
	_ = project.db.sourceStamps.remove(path)
	_ = project.db.tokenCache.remove(path)
	_ = project.db.activeTokenCache.remove(path)
	_ = project.db.parseCache.remove(path)
	_ = project.db.fileProvenance.remove(path)

	project.db.rowSetOverrides.forget(path)
end 'forgetOneSourceFile'

// --- The memo that outlives a `Project` ---
//
// ⭐⭐ **ONE STORE PER `CompileSession.fileMemos` OWNER.** A spec worker process, the language
// server's document projects and each MCP session compile many programs, and every one of them
// would otherwise re-lex the same `stdlib/` files from scratch. Its disk tier (`LibraryCacheStore`)
// carries the views, the held parses and the library baseline from one process to the next.
//
// ⚠ **THIS IS NOT A SECOND CACHE BESIDE THE QUERY SPINE'S — IT IS THE SAME MEMO WITH A LONGER
// LIFE.** `StdlibLoader`'s header argues against storing the stdlib twice, and that argument
// stands: nothing here is derived a second way. The per-`Project` caches remain the only thing any
// query reads directly — a shared hit is served THROUGH them (see `Queries.queryTokens`).
//
// ⛔⛔ A library file's parse is held here, but a `FileParseArtifact` embeds index-numbered facts —
// type-name ids, generic-instance ids, interface declaration indexes in witness ops — that the
// asking program's own declarations shift. So each held parse carries a footprint of those facts
// (`ParseFootprint`), and a hit is rebased onto the current program, or misses when a row or a told
// answer moved (`sharedParseDrifts`). A store that retains what it loads
// (`SharedFileMemoMap.create`) deep-clones it at the stash and at every hit: the merge renumbers an
// artifact in place, so nothing a `Project` can reach may be the stored one. A one-compile store
// (`forOneCompile`) hands the held parse over and drops it, since no later compile asks.
//
// Its key is the library-only signature hash (`ProgramSignatures.libraryHash`), because the
// whole-program hash moves with every user declaration. A program that shadows or overlaps a
// library name, or declares a runtime name, parses the library cold (`LibraryParseSharing`).
//
// ⛔⛔ **A SWEPT DECLARATION IS NOT HELD: THE DECLARATION SCAN IS NOT A FUNCTION OF THE BYTES.**
// `Parser.foldDeclaredSignaturesInto` READS the whole-program index while it walks (whatever the
// files folded before it put there, in the order `Queries.foldedProgramDeclarations` chose), WRITES
// it (`recordTupleAlias` / `internTupleType`), and its output records are mutated in place by the
// whole-program tail. Serving it from here needs a dependency key over what the walk can see and a
// deep clone on every serve, and the clone costs more than the walk it replaces: it duplicates the
// file's `TokenArray` and the interner's source slices, which a swept declaration shares. That
// changes only once the language can mark a value deeply immutable, so a clone may share it. What
// is held instead is the whole library's sweep, one index a program starts from
// (`LibraryBaseline`).
//
// A TOKEN needs neither a footprint nor a clone. `Token`'s every field is a `let`, no consumer
// mutates a token array (`filterConditionalTokens` returns its input or builds a fresh array, and
// `Parser.shadowRenamedTokens` likewise), and a token carries no id of any kind. It is a VALUE, and
// that is the whole safety argument.
//
// ⚠ **THE KEY IS THE CONTENT HASH AND NOT THE PATH.** `tokenize` reads the bytes and nothing else,
// so two files with the same bytes have the same tokens whatever they are called — and a
// `// --- stdlib-overlay:` case, which stages a private stdlib under a temp directory, therefore SHARES
// an entry for exactly the files it did not change and gets its own for the one it did.
//
// ⚠ **IT EXTENDS THE TRUST ALREADY PLACED IN THE CONTENT HASH FROM ONE FILE TO ALL OF THEM.** Every
// per-file memo in `QueryDatabase` treats a 64-bit FNV-1a match as "these are the same bytes",
// under a PATH key; here a collision could be between any two admitted files. The admission list is
// `stdlib/`'s files (see `HashDigestSet`), which bounds the exposure to a set that is small, fixed
// and not chosen by user input.
//
// ⚠ Nothing locks a store, so two compiles must never reach one map at once.

// How many distinct byte-contents this store is holding. Reported beside the per-compile hit
// counts (see `Queries.queryProgramSignatures`) because it is the one number that says the store is
// BOUNDED: a store that grows with the corpus rather than with `stdlib/` is a worker leaking one
// token array per spec fragment, and no hit count can see that.
export function sharedMemoEntryCount(project Project) returns QueryCount
	return project.session.fileMemos.entries.count()
end 'sharedMemoEntryCount'

export function sharedParseEntryCount(project Project) returns QueryCount
	var held = 0 as QueryCount

	for (_, memo) in project.session.fileMemos.entries 'eachMemo'
		held = held + (memo.parseCount() as QueryCount)
	end 'eachMemo'

	return held
end 'sharedParseEntryCount'

// The two cases a bool has, as the innermost digit's radix.
let FlagRadix = 2

// The project's `ConditionFacts` as one integer — every input the `#if` filter reads, packed by
// mixed radix. `Os` is the middle digit and its own case count is the radix, so the packing stays
// correct when either enum gains a case; the `debugStream` flag is the innermost digit. A fact the
// filter can read that is NOT folded in here would let a shared view answer for a build it was not
// filtered for — see `SharedBuildView`.
export function buildKeyOf(project Project) returns BuildKey
	let flagDigit = 1 if project.debugStream else 0
	return ((((project.target.cpu.ordinal * Os.allCases.count()) + project.target.os.ordinal) * FlagRadix) + flagDigit) as BuildKey
end 'buildKeyOf'

// What the `#if` filter is evaluated against for this project — the same facts `buildKeyOf` packs.
export function conditionFactsOf(project Project) returns ConditionFacts
	return ConditionFacts.create(project.target, debugStream: project.debugStream)
end 'conditionFactsOf'

// ⭐ **MARK THIS FILE'S BYTES AS WORTH KEEPING FOR EVERY COMPILE THAT SHARES THIS STORE.** Called by
// `StdlibLoader.loadLibrarySources` for each file it registered, because that loop is the one place
// that knows a path came out of an enumeration of `stdlib/` without asking `isStdlibSourceFile` at all.
export function markSharedTokenSource(project Project, path FilePath) throws CompileError
	project.db.shareableTokenHashes.insert((try sourceEntryOf(project, path: path)).contentHash)
end 'markSharedTokenSource'

// The store's entry for these bytes. The ONE place a `MapError` becomes a `SharedMemoMiss`, so the
// doors below cannot come to disagree about what "not held" is.
function heldMemoFor(project Project, contentHash HashDigest) returns SharedFileMemo throws SharedMemoMiss
	return try project.session.fileMemos.entries.get(contentHash) otherwise throw SharedMemoMiss.notHeld
end 'heldMemoFor'

function memoOrNew(project Project, contentHash HashDigest) returns SharedFileMemo
	if let memo = try project.session.fileMemos.entries.get(contentHash) 'alreadyHeld'
		return memo
	end 'alreadyHeld'

	let created = SharedFileMemo.holdingNothingYet()
	project.session.fileMemos.entries.upsert(contentHash, value: created)

	return created
end 'memoOrNew'

module function rawTokensAreHeldInMemory(project Project, contentHash HashDigest) returns bool
	let memo = try heldMemoFor(project, contentHash: contentHash) otherwise return false

	return memo.holdsRawTokens()
end 'rawTokensAreHeldInMemory'

function viewsPackName(project Project) returns String throws CompileError
	let state = try libraryStateKeyOf(project)

	return libraryEntryName(LibraryEntryKind.views, parts: [state])
end 'viewsPackName'

type OpenViewsPack
	export let name as String
	export let pack as LibraryPack

	static function create(name String, pack LibraryPack) returns OpenViewsPack
		return Self{name: name, pack: pack}
	end 'create'
end 'OpenViewsPack'

function viewsPackFor(project Project, contentHash HashDigest) returns OpenViewsPack throws SharedMemoMiss
	if not project.db.shareableTokenHashes.contains(contentHash) 'neverAdmitted'
		throw SharedMemoMiss.notHeld
	end 'neverAdmitted'

	let name = try viewsPackName(project) otherwise throw SharedMemoMiss.notHeld
	let pack = try project.session.fileMemos.library.openPack(project.target, name: name, tally: project.db.libraryTally) otherwise throw SharedMemoMiss.notHeld

	return OpenViewsPack.create(name, pack: pack)
end 'viewsPackFor'

function loadedView(project Project, contentHash HashDigest, buildKey BuildKey) returns ViewEntry throws SharedMemoMiss
	let opened = try viewsPackFor(project, contentHash: contentHash)
	let reader = try opened.pack.section(contentHash, second: NoRowQualifier, third: NoRowQualifier) otherwise throw SharedMemoMiss.notHeld

	return try decodedViewSection(reader, buildKey: buildKey) otherwise (damage) 'damaged'
		project.session.fileMemos.library.rejectDecoded(project.target, name: opened.name, damage: damage, tally: project.db.libraryTally)
		throw SharedMemoMiss.notHeld
	end 'damaged'
end 'loadedView'

export function sharedRawStreamFactsOf(project Project, contentHash HashDigest) returns RawStreamFacts throws SharedMemoMiss
	return try (try heldMemoFor(project, contentHash: contentHash)).rawStreamFactsHeld()
end 'sharedRawStreamFactsOf'

// The store's view for these bytes AND this build — `heldMemoFor` composed with `viewOf`, once,
// because all three doors below want exactly that pair and a composition spelled three times is
// three places for the two halves to come apart.
function memoViewOf(project Project, contentHash HashDigest, buildKey BuildKey) returns SharedBuildView throws SharedMemoMiss
	return try (try heldMemoFor(project, contentHash: contentHash)).viewOf(buildKey)
end 'memoViewOf'

function heldViewFor(project Project, contentHash HashDigest, buildKey BuildKey) returns SharedBuildView throws SharedMemoMiss
	if let view = try memoViewOf(project, contentHash: contentHash, buildKey: buildKey) 'inMemory'
		return view
	end 'inMemory'

	let entry = try loadedView(project, contentHash: contentHash, buildKey: buildKey)
	var memo = memoOrNew(project, contentHash: contentHash)
	memo.learnRawStreamFacts(entry.facts)
	memo.addView(entry.view)

	return entry.view
end 'heldViewFor'

// The tokens some earlier compile sharing this store already lexed from these exact bytes. Throws on a
// miss, `TypeNameInterner.idOf`'s shape — "nothing has lexed these bytes yet" is an answer.
//
// It does NOT re-ask the admission list, and that is deliberate rather than an omission: admission
// decides what is worth KEEPING, and a file whose bytes are already held is worth reading whoever
// asks. A user fragment byte-identical to an admitted file gets the same tokens because it has the
// same bytes, which is the only claim this store ever makes.
export function sharedTokensOf(project Project, contentHash HashDigest) returns TokenArray throws SharedMemoMiss
	let tokens = try (try heldMemoFor(project, contentHash: contentHash)).rawTokensHeld()
	project.db.sharedTokenHits = project.db.sharedTokenHits + 1

	return tokens
end 'sharedTokensOf'

export function shareTokens(project Project, contentHash HashDigest, tokens TokenArray)
	if not project.db.shareableTokenHashes.contains(contentHash) 'notAdmitted'
		return
	end 'notAdmitted'

	var memo = memoOrNew(project, contentHash: contentHash)
	memo.holdRawTokens(tokens)
end 'shareTokens'

// The `#if`-resolved stream for these bytes AND this build, if this store has one.
export function sharedActiveTokensOf(project Project, contentHash HashDigest, buildKey BuildKey) returns TokenArray throws SharedMemoMiss
	let view = try heldViewFor(project, contentHash: contentHash, buildKey: buildKey)
	project.db.sharedActiveTokenHits = project.db.sharedActiveTokenHits + 1
	return view.activeTokens
end 'sharedActiveTokensOf'

// Whether `sharedActiveTokensOf` would answer, without counting a hit — the front end's pool asks
// it of every file before deciding which to lex, and the query that later serves the file is the
// one that counts. A view on disk is decoded to answer, so a row that does not decode is lexed on
// the pool.
export function holdsSharedActiveTokens(project Project, contentHash HashDigest, buildKey BuildKey) returns bool
	_ = try heldViewFor(project, contentHash: contentHash, buildKey: buildKey) otherwise return false
	return true
end 'holdsSharedActiveTokens'

// Publish a SUCCEEDING filter's stream.
//
// ⛔ **ONLY A SUCCEEDING FILTER REACHES HERE, AND THE ASYMMETRY WITH THE PER-`Project` MEMO IS
// DELIBERATE.** `queryActiveTokens` caches a FAILED filter as an empty stream on purpose — that is
// what makes its diagnostic appear once instead of twice — and it is sound there because the
// diagnostic is already on THAT compile's `project.diagnostics` and that build is already failing.
// A later compile of a program that merely shares the bytes has neither, so serving it the empty
// stream would be a file silently compiling as though it were blank.
export function shareActiveTokens(project Project, contentHash HashDigest, buildKey BuildKey, activeTokens TokenArray)
	// A view is published only beside a raw stream this process lexed. `heldViewFor` and
	// `heldParseFor` create entries holding none, and a file that failed to lex arrives with an empty
	// stream that a later compile would read as a blank file, with no diagnostic. A view is only ever
	// ADDED here, never replaced: `queryActiveTokens` reaches this line only after
	// `sharedActiveTokensOf` answered no for this build.
	var memo = try heldMemoFor(project, contentHash: contentHash) otherwise return

	if not memo.holdsRawTokens() 'theRawStreamDidNotLex'
		return
	end 'theRawStreamDidNotLex'

	memo.addView(SharedBuildView.create(buildKey, activeTokens: activeTokens))
end 'shareActiveTokens'

// The producer mask an earlier compile derived from this file's active stream, if any. Its own pair
// of doors rather than a field the two above fill, because it is derived on FIRST DEMAND: only the
// declaration sweep asks for it, and a compile that never reaches the sweep must not pay a token
// walk for it.
export function sharedProducerMaskOf(project Project, contentHash HashDigest, buildKey BuildKey) returns ProducerMask throws SharedMemoMiss
	let view = try heldViewFor(project, contentHash: contentHash, buildKey: buildKey)

	if not view.producerMaskComputed 'notYetDerived'
		throw SharedMemoMiss.notHeld
	end 'notYetDerived'

	project.db.sharedProducerMaskHits = project.db.sharedProducerMaskHits + 1
	return view.producerMask
end 'sharedProducerMaskOf'

export function shareProducerMask(project Project, contentHash HashDigest, buildKey BuildKey, mask ProducerMask)
	// Two ways there is nothing to write to, and both are ordinary: the bytes were never admitted, or
	// this build has no view because the file failed to lex or its `#if` filter FAILED and a failure is
	// deliberately not published (see `shareActiveTokens`). The sweep still walks the empty stream that
	// failure produced, so it still arrives here with a mask.
	var view = try heldViewFor(project, contentHash: contentHash, buildKey: buildKey) otherwise return
	view.rememberProducerMask(mask)
end 'shareProducerMask'

// --- Source entries and content-hash memo keys ---

// The registered source entry for `path` — its bytes AND the hash of those bytes, which is the key
// every per-file memo is stamped with.
//
// ⚠ **THE QUERIES FETCH IT ONCE AND USE IT FOR BOTH HALVES OF THE MEMO PATTERN — the validity
// compare AND the stamp — and that is not merely a saved lookup.** A `Map with (FilePath, _)` probe
// is not free on Windows: `FilePath.hash` CLONES AND LOWER-CASES the path (`stdlib/FilePath.maxon`
// `canonicalForCompare`) and `FilePath.equals` clones twice more, so every probe allocates several
// Strings — the cost `Project.maxon`'s `RangedAliasByDeclaringFile` is keyed by a plain `String` to
// avoid. Fetching once also removes the "entry vanished between the two lookups" panic that a second
// probe has to carry, and makes it structurally impossible to validate against one hash and stamp
// with another.
export function sourceEntryOf(project Project, path FilePath) returns SourceFileEntry throws CompileError
	return try project.db.sourceFiles.get(path) otherwise throw CompileError.fileNotFound(path)
end 'sourceEntryOf'

// **A PARSE MEMO IS KEYED ON FIVE FACTS, BECAUSE A PARSE READS FIVE INPUTS.**
//
//   1. the file's OWN bytes — its tokens;
//   2. the WHOLE-PROGRAM SIGNATURE INDEX — every OTHER file's declarations, which the parser
//      needs to type a call's result (SignatureIndex.maxon);
//   3. whether this parse BUILDS FUNCTION BODIES at all (`BuildsBodies`).
//      Keying on (1) and (2) alone serves a round that has just discovered it needs `Math.pow`'s body the
//      artifact built when nothing needed it, and the program then calls a function whose only op is the
//      `retVoid` `skipUnreachedFunctionBody` left. It is the same failure as (2)'s, one tier down: the
//      file did not change, and what the COMPILE wants from it did.
//   4. whether this build INSTRUMENTS FOR COVERAGE (`--coverage`). A coverage point is minted by the
//      parse, so an instrumented parse and a plain one produce different ops out of identical bytes.
//      Without this half, toggling the flag on a warm tree serves the STALE UNINSTRUMENTED parse: exit
//      0, an empty `.mxcov`, and no error anywhere — a measurement that silently measured nothing.
//   5. the whole program's ANSWERS this file is parsed with (`RowSetOverrideTable.digest`) — questions
//      its own parse answered otherwise, which the parse's output depends on.
//
// Keying on (1) alone would be correct only if a parse read nothing but its own file, and it
// SERVES A STALE PARSE the moment a signature moves: change `isReady`'s
// return type in `a.maxon` and `b.maxon`'s bytes have not moved, so `b.maxon` is a cache HIT
// and keeps a parse built against the OLD type. The file did not change; what the file MEANS
// did. That is the load-bearing half of the signature index, and the easy half to get silently
// wrong — a wrong answer served out of a cache, visible only on an incremental rebuild.
//
// The two halves are mixed rather than compared separately so validity stays what it has always
// been: ONE stamped hash, ONE equality test (see this file's header). `Hasher.combined` is FNV's
// own step, so the composite is as collision-resistant as either half.
// The third half's two values. Arbitrary DISTINCT constants rather than 0 and 1 because
// `Hasher.combined` is FNV's own step and feeding it 0 is feeding it nothing: two files whose other halves differ by exactly one
// would then collide across the split.
let BodiesBuiltKeySalt = 0x9E3779B97F4A7C15 as HashDigest
let BodiesSkippedKeySalt = 0xC2B2AE3D27D4EB4F as HashDigest

// The fourth half's two values, distinct from each other and from the pair above for that same reason.
let CoverageInstrumentedKeySalt = 0xD6E8FEB86659FD93 as HashDigest
let CoveragePlainKeySalt = 0xA0761D6478BD642F as HashDigest

function parseMemoKey(contentHash HashDigest, signatureHash HashDigest, buildsBodies bool, coverage bool, overridesDigest HashDigest) returns HashDigest
	let inputs = Hasher.combined(Hasher.combined(contentHash, value: signatureHash), value: BodiesBuiltKeySalt if buildsBodies else BodiesSkippedKeySalt)

	return Hasher.combined(Hasher.combined(inputs, value: CoverageInstrumentedKeySalt if coverage else CoveragePlainKeySalt), value: overridesDigest)
end 'parseMemoKey'

// The key a parse memo for `path` must carry to be valid right now. `signatureHash` is
// `ProgramSignatures.hash` — the hash of the DECLARATIONS, not of the sources they were read from,
// which is what keeps an edit to one file's function BODY from invalidating every other file's parse
// (see ProgramSignatures.hash).
//
// `queryParseOps` computes it ONCE and uses that one value to both validate its memo and stamp the
// new one, for `sourceEntryOf`'s reason: the two must be the same key, and each computation of it is
// another `FilePath` map probe.
export function currentParseMemoKey(project Project, contentHash HashDigest, signatureHash HashDigest, buildsBodies bool, overrides RowSetOverrideTable) returns HashDigest
	return parseMemoKey(contentHash, signatureHash: signatureHash, buildsBodies: buildsBodies, coverage: project.coverage, overridesDigest: overrides.digest)
end 'currentParseMemoKey'

let FlagSetKeySalt = 0xE7037ED1A0B428DB as HashDigest
let FlagClearKeySalt = 0x8EBC6AF09C88C6E3 as HashDigest

function mixFlag(state HashDigest, set bool) returns HashDigest
	return Hasher.combined(state, value: FlagSetKeySalt if set else FlagClearKeySalt)
end 'mixFlag'

function sharedParseVariant(project Project, job ParseJob) returns HashDigest
	var variant = mixBytes(buildKeyOf(project) as HashDigest, bytes: job.path.toString().toByteArray())
	variant = mixBytes(variant, bytes: job.namespace.toByteArray())
	variant = mixFlag(variant, set: job.buildsBodies)
	variant = mixFlag(variant, set: job.instrumentsCoverage)
	variant = mixFlag(variant, set: job.capturesDebugLocals)
	variant = mixFlag(variant, set: job.isStdlibSource)
	variant = mixFlag(variant, set: job.isRuntimeSource)
	variant = mixFlag(variant, set: job.declaresCompilerInternalNames)

	return mixFlag(variant, set: job.livesUnderStdlibDirectory)
end 'sharedParseVariant'

export function sharedParsePlanOf(project Project, job ParseJob, contentHash HashDigest, signatures ProgramSignatures, overrides RowSetOverrideTable, liveness HashDigest) returns SharedParsePlan
	if signatures.libraryParseSharing != LibraryParseSharing.shareable or not (job.isStdlibSource or job.isRuntimeSource) or not job.compilerMintedNames.isEmpty() or not project.db.shareableTokenHashes.contains(contentHash) 'notShareable'
		return SharedParsePlan.unshared
	end 'notShareable'

	let key = Hasher.combined(Hasher.combined(signatures.libraryHash, value: overrides.digest), value: liveness)

	return SharedParsePlan.shareable(contentHash, variant: sharedParseVariant(project, job: job), key: key)
end 'sharedParsePlanOf'

export function sharedParseOf(project Project, plan SharedParsePlan, signatures ProgramSignatures, overrides RowSetOverrideTable) returns FileParseArtifact throws SharedMemoMiss
	match plan 'plan'
		unshared then throw SharedMemoMiss.notHeld
		shareable(contentHash, variant, key) then return try heldParseFor(project, contentHash: contentHash, variant: variant, key: key, signatures: signatures, overrides: overrides)
	end 'plan'
end 'sharedParseOf'

// The baseline is restored after every lookup, hit or miss: checking a held parse's told row-set
// answers re-asks them, which writes journaled memos onto this program's index.
function heldParseFor(project Project, contentHash HashDigest, variant HashDigest, key HashDigest, signatures ProgramSignatures, overrides RowSetOverrideTable) returns FileParseArtifact throws SharedMemoMiss
	var memo = memoOrNew(project, contentHash: contentHash)
	loadParseIfAbsent(project, memo: memo, contentHash: contentHash, variant: variant, key: key, libraryHash: signatures.libraryHash)

	let consuming = not project.session.fileMemos.library.retainsWhatItLoads()
	let rebased = try memo.parseOf(variant, key: key, signatures: signatures, overrides: overrides, consuming: consuming) otherwise (miss) 'notHeld'
		signatures.restoreBaseline()
		project.db.sharedParseMisses = project.db.sharedParseMisses + 1

		match miss 'miss'
			footprintMoved then project.db.sharedParseDrifts = project.db.sharedParseDrifts + 1
			notHeld then break 'miss'
		end 'miss'

		throw miss
	end 'notHeld'

	signatures.restoreBaseline()
	project.db.sharedParseHits = project.db.sharedParseHits + 1
	project.db.sharedParseReusedFiles.insert(contentHash)
	rebaseArtifact(project, artifact: rebased.artifact, rebase: rebased.rebase)

	return rebased.artifact
end 'heldParseFor'

let MostKeysPerLibraryParse = 6 as ElementIndex

function parsesPackName(project Project, libraryHash HashDigest) returns String throws CompileError
	let state = try libraryStateKeyOf(project)

	return libraryEntryName(LibraryEntryKind.parses, parts: [state, libraryHash])
end 'parsesPackName'

function loadParseIfAbsent(project Project, memo SharedFileMemo, contentHash HashDigest, variant HashDigest, key HashDigest, libraryHash HashDigest)
	if memo.holdsParseAnswering(variant, key: key) 'inMemory'
		return
	end 'inMemory'

	let library = project.session.fileMemos.library
	let name = try parsesPackName(project, libraryHash: libraryHash) otherwise return
	let pack = try library.openPack(project.target, name: name, tally: project.db.libraryTally) otherwise return
	let reader = try pack.section(contentHash, second: variant, third: key) otherwise return

	let parse = try decodedParseSection(reader, variant: variant, key: key) otherwise (damage) 'damaged'
		library.rejectDecoded(project.target, name: name, damage: damage, tally: project.db.libraryTally)
		return
	end 'damaged'

	memo.holdParse(parse)
end 'loadParseIfAbsent'

export function persistSharedEntries(project Project)
	let library = project.session.fileMemos.library

	if not library.isAvailable(project.target) 'noDiskTier'
		return
	end 'noDiskTier'

	let name = try viewsPackName(project) otherwise return
	let buildKey = buildKeyOf(project)
	var views = LibraryPackBuilder.create()
	var fresh = false

	for contentHash in project.db.shareableTokenHashes 'eachAdmitted'
		let view = try memoViewOf(project, contentHash: contentHash, buildKey: buildKey) otherwise continue

		if not view.persisted 'newToTheDisk'
			fresh = true
		end 'newToTheDisk'
	end 'eachAdmitted'

	if not fresh 'nothingNew'
		return
	end 'nothingNew'

	for contentHash in project.db.shareableTokenHashes 'eachToWrite'
		let memo = try heldMemoFor(project, contentHash: contentHash) otherwise continue
		let view = try memo.viewOf(buildKey) otherwise continue
		let facts = try memo.rawStreamFactsHeld() otherwise panic("persistSharedEntries: a memo holds a view but not its raw stream's facts, and every view is added beside them")
		views.add(contentHash, second: NoRowQualifier, third: NoRowQualifier, payload: encodedViewSection(facts, view: view))
	end 'eachToWrite'

	if not library.write(project.target, name: name, image: views.sealed(), tally: project.db.libraryTally) 'notWritten'
		return
	end 'notWritten'

	library.trimEntries(project.target, kind: LibraryEntryKind.views, kept: name, most: MostEntriesOfAKind)

	for contentHash in project.db.shareableTokenHashes 'eachWritten'
		var view = try memoViewOf(project, contentHash: contentHash, buildKey: buildKey) otherwise continue
		view.markPersisted()
	end 'eachWritten'
end 'persistSharedEntries'

export function persistStashedParses(project Project)
	var stashed = project.db.stashedParsePacks
	project.db.stashedParsePacks = StashedParsePackMap.create()
	let library = project.session.fileMemos.library

	for (libraryHash, _) in stashed 'eachLibraryState'
		var pack = try stashed.get(libraryHash) otherwise panic("persistStashedParses: the map iterated {libraryHash} and does not hold it")
		let name = try parsesPackName(project, libraryHash: libraryHash) otherwise continue

		// Re-read from disk, not from the pack this process opened, so rows another process wrote since
		// are carried. A row lost to two writers racing costs a later miss, never a wrong answer.
		library.forgetPack(name)

		if let earlier = try library.openPack(project.target, name: name, tally: project.db.libraryTally) 'anEarlierPack'
			earlier.copiedInto(pack, mostPerGroup: MostKeysPerLibraryParse)
		end 'anEarlierPack'

		if library.write(project.target, name: name, image: pack.sealed(), tally: project.db.libraryTally) 'written'
			library.trimEntries(project.target, kind: LibraryEntryKind.parses, kept: name, most: MostParsePacks)
		end 'written'
	end 'eachLibraryState'
end 'persistStashedParses'

export function stashParse(project Project, plan SharedParsePlan, artifact FileParseArtifact) returns FileParseArtifact
	return match plan 'plan'
		unshared gives artifact
		shareable(contentHash, variant, key) gives stashShareableParse(project, contentHash: contentHash, variant: variant, key: key, artifact: artifact)
	end 'plan'
end 'stashParse'

function stashShareableParse(project Project, contentHash HashDigest, variant HashDigest, key HashDigest, artifact FileParseArtifact) returns FileParseArtifact
	if artifact.diagnostics.count() != 0 or artifact.deferredParseErrors.count() != 0 'carriesFaults'
		return artifact
	end 'carriesFaults'

	let signatures = programSignaturesIn(project, asker: "stashShareableParse")
	let footprint = footprintOf(project, artifact: artifact, signatures: signatures)
	let held = SharedLibraryParse.create(variant, key: key, footprint: footprint, artifact: artifact)

	let retains = project.session.fileMemos.library.retainsWhatItLoads()

	let canonical = try persistedCanonicalParse(project, held: held, contentHash: contentHash, libraryHash: signatures.libraryHash) otherwise 'notPersistable'
		if retains 'aLaterCompileMayAsk'
			project.db.pendingSharedParses.upsert(contentHash, value: held.cloned())
		end 'aLaterCompileMayAsk'

		return artifact
	end 'notPersistable'

	if retains 'aLaterCompileMayAsk'
		project.db.pendingSharedParses.upsert(contentHash, value: canonical)
	end 'aLaterCompileMayAsk'

	return canonical.workingArtifact(not retains)
end 'stashShareableParse'

// The compile goes on with the decoded copy, not the parse it built, so a compile that writes the
// cache and one that reads it work from the same canonical objects and emit the same bytes
// (`tests/cli/library-cache-warm-build-is-byte-identical`). `LibraryBaseline.persistedBaseline`
// does the same for the baseline.
function persistedCanonicalParse(project Project, held SharedLibraryParse, contentHash HashDigest, libraryHash HashDigest) returns SharedLibraryParse throws LibraryEntryMiss
	let library = project.session.fileMemos.library

	if not library.isAvailable(project.target) 'noDiskTier'
		throw LibraryEntryMiss.unavailable
	end 'noDiskTier'

	let payload = try encodedParseSection(held) otherwise throw LibraryEntryMiss.unavailable
	var pack = try project.db.stashedParsePacks.get(libraryHash) otherwise LibraryPackBuilder.create()
	pack.add(contentHash, second: held.variantOf(), third: held.keyOf(), payload: payload)
	project.db.stashedParsePacks.upsert(libraryHash, value: pack)

	return try decodedParseSection(LibraryCacheReader.over(payload, start: 0, endIndex: payload.count()), variant: held.variantOf(), key: held.keyOf()) otherwise (damage) 'undecodable'
		panic("persistedCanonicalParse: the section just encoded for {contentHash} does not decode: {damage.displayReason()}")
	end 'undecodable'
end 'persistedCanonicalParse'

export function publishStandingParses(project Project)
	let pending = project.db.pendingSharedParses
	var published = 0 as QueryCount

	project.db.pendingSharedParses = PendingSharedParseMap.create()

	for (contentHash, standing) in pending 'eachPending'
		var memo = try heldMemoFor(project, contentHash: contentHash) otherwise panic("publishStandingParses: a parse was stashed for bytes no shared file memo holds — a shareable plan requires admitted bytes, and admitted bytes that lexed are held")
		memo.holdParse(standing)
		published = published + 1
	end 'eachPending'

	project.db.sharedParsePublishes = project.db.sharedParsePublishes + published
end 'publishStandingParses'

// Memoized, and it has to be. The fold is O(files) and it is asked once per file — every
// `queryParseOps` validates the signature index before it can validate itself, and that validation
// is this hash — so recomputing it per call makes the query spine O(files²). That is the
// standing hazard of putting a whole-program query underneath a per-file one.
//
// Every mutation of the registered path set or of a file's content clears the flag; an unchanged
// re-register does not, or a held `Project` rebuilds the whole-program memos on every request.
export function compositeSourceHash(project Project) returns HashDigest
	if project.db.compositeHashValid 'memoized'
		return project.db.compositeHash
	end 'memoized'

	var h = Hasher.empty()

	for path in project.db.sourcePaths 'each'
		let entry = try project.db.sourceFiles.get(path) otherwise panic("compositeSourceHash: sourcePaths lists {path} but sourceFiles has no entry")

		// The path is folded beside the content hash: the digest is a function of the (path, content)
		// sequence, not of the contents alone. A rename moves no content, so a fold over contents alone
		// recomputes to the same value, the signature-index memo reads valid, and the index keeps
		// answering out of the file that is gone.
		h = Hasher.combined(h, bytes: path.toString().toByteArray())
		h = Hasher.combined(h, value: entry.contentHash)
	end 'each'

	project.db.compositeHash = h
	project.db.compositeHashValid = true
	return h
end 'compositeSourceHash'

// True iff the signature-index memo is present and still keyed on the current composite
// source hash. The index is read off EVERY file's tokens, so any file's edit can move it —
// which is exactly what the composite hash tracks.
//
// It is keyed on the SOURCE, and it KEYS the parse on the DECLARATIONS. That asymmetry is
// deliberate and it is what preserves incrementality in the common case: a body edit rebuilds the
// index (cheap: a token sweep, and every unchanged file's tokens are a memo hit) and the rebuilt
// index usually hashes identically, so not one other file re-parses.
//
// ⚠ **USUALLY, AND NOT ALWAYS: THE INDEX CARRIES BODY-DERIVED FACTS THAT A BODY EDIT CAN MOVE.**
// `ProgramSignatures.settleBaseline` mixes `descriptorNeeds`, `fixedElementCountNeeds` and
// `instantiatedByAParse` into the hash, and each is decided by scanning bodies. So "a body edit cannot
// have moved the index" is not a premise anything may rest on — a parse run against an index the
// current sources did not produce ends in a panic, which
// `tests/lsp/diagnostics-project-an-unsaved-declaration-still-falls-back.maxtest` records verbatim.
export function signaturesCacheValid(project Project) returns bool
	if not project.db.signatureCache.computed 'never'
		return false
	end 'never'

	return project.db.signatureCache.keyHash == signatureMemoKey(project)
end 'signaturesCacheValid'

// The sources, and the generic types a fold of them found a parse instantiating — the index's two inputs.
export function signatureMemoKey(project Project) returns HashDigest
	return Hasher.combined(Hasher.combined(compositeSourceHash(project), value: project.db.instantiatedByAParse.digest), value: project.db.genericInstances.filed.digest)
end 'signatureMemoKey'

// True iff the merged-module memo is present and still keyed on the current
// composite source hash.
export function allModuleCacheValid(project Project) returns bool
	if not project.db.allModuleCache.computed 'never'
		return false
	end 'never'

	return project.db.allModuleCache.keyHash == compositeSourceHash(project)
end 'allModuleCacheValid'

// ⭐⭐ **THE PIPELINE MUTATES THE MODULE THIS MEMO HANDS OUT, SO THE PIPELINE MUST DROP IT.**
//
// Every other memo here is valid exactly while its input's content hash is unchanged, and that test is
// sound because nothing downstream writes to a memoized value. `queryAllModule`'s is the ONE exception:
// `TypeResolution.resolveTypes` rewrites `maxonParamTypes`/`maxonReturnType` on the module's functions
// IN PLACE, and `installManagedGlobalInit` appends to it. The bytes did not move, so the hash still
// matches, so the memo still says VALID — and hands back a module the last compile edited.
//
// ⛔ **MEASURED, and it is not a drift — it is a WRONG ANSWER and then a CRASH.** A second
// `compileToCodeResult` over one `Project`:
//   • on a 3-line program invented **5 diagnostics** where the first reported none — all E3016
//     "partial interface implementation" against `stdlib/` (`compare(other Character) returns int`
//     against `expected compare(other Self) returns Ordering`). `checkConformance` runs BEFORE
//     `resolveTypes` precisely so it can print the source spellings resolution erases; on a re-check
//     it reads the ERASED ones and reports a mismatch that does not exist.
//   • on `maxon-dev-mcp/mcp` **panicked** — `dispatchedRequirementSlots: blockRef 5618 not in
//     module.blocks`.
// `verify-recheck` is the gate; `VerifyRecheck.maxon` holds the argument.
//
// ⚠ **WHY INVALIDATE RATHER THAN CLONE, OR STOP MUTATING.** Cloning on every serve costs more than it
// saves, under the rule that a memo needing a deep copy per use cannot save more than producing it costs.
// Making resolution non-destructive is the structurally cleaner answer and touches every reader of
// those two fields; it stays available and this does not block it. Dropping the memo costs ONE re-fold
// (`Queries.foldTheFrontEnd`), and every file's TOKENS and PARSE stay hits, because those memos are
// untouched by any of this.
// ⇒ **The expensive caches survive; only the fold that assembles them re-runs.**
//
// Called by `Compiler.lowerTheProgram` as it takes the module, not after it finishes: a compile that throws
// half way through has mutated just as much as one that completes, and the memo must not survive
// either. ⚖ User ruling, 2026-09-01.
export function invalidateAllModuleCache(project Project)
	project.db.allModuleCache = ModuleMemo.empty()
end 'invalidateAllModuleCache'
