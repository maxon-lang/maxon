		call or
		tryCall or
		asyncCall or
		serviceSpawn then return artifactOwnedCall(op)
		literal or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		panicAbort or
		functionRef or
		sizeofType or
		constArrayLiteral or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable then return op.clone()
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		throwError or
		propagateError or
		indirectCall or
		await or
		tryAwait or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		covPoint or
		rawIntrinsic then return op

		// The interface name is read off the artifact's own interner, which holds its own copy.
		existentialWitness then return op
		holdValue or
		holdEnd then return artifactOwnedHold(op)
	end 'op'
end 'artifactOwnedOp'

function artifactOwnedHold(op MaxonOp) returns MaxonOp
