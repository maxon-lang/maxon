	// `Parser.requireFieldAccessible` (a struct's field) and `Parser.emitEnumDispatchKey` (an enum's or union's tag)
	// record at the lines the compile already had to reach to emit the access.
	// `checkUnusedExports` reads it beside `usedTypeNames` above, so its "is this reached from outside?" IS
	// the resolver's answer: without it E3092 would advise dropping an `export` that E4006 then requires, and
	// the program would have no legal spelling. Two sets and not one because they hold two facts — see
	// `ParseMemos.memberAccessedTypeNames`.
	export var memberAccessedTypeNames as UsedTypeNameRoster

	// The token ranges `[first, limit)` of this file's active stream whose bodies the parse skipped: a
	// stdlib body no path from `main` reaches, and a generic function nothing instantiates.
	// `checkUnusedExports` reads the names spelled there, because no op exists for them.
	export var unbuiltBodies as UnbuiltBodyArray

	// This file's `type X implements …` conformance declarations. Each carries the
	// type-name token position so the whole-program `checkConformance` can anchor an E3015/E3016 on it.
	// Remap-free (all names are plain ByteArrays). Folded into `project.conformances` by `mergeArtifact`.
	export var conformances as ConformanceDeclArray

	// This file's `<Type> from "…"` construction sites (see LiteralInitSite). Appended to
	// `project.literalInitSites` by `commitLiteralInitSites`; the conformance they require is decided
	// after the merge, by `checkLiteralInitConformance`.
	export var literalInitSites as LiteralInitSiteArray

	// ⭐⭐ **THIS FILE'S INSTANTIATIONS THAT NO `typealias` WROTE.** A `[k: v]` literal interns a
	// `Map with (K, V)` from its first pair, so it is a genuine instantiation with a genuine source
	// position and no declaration to anchor on — which is exactly what `ProgramSignatures.instantiationSites`
	// (built by the token SWEEP, from `typealias` entries) structurally cannot hold. Appended to
	// `project.inferredInstantiationSites` by `commitInferredInstantiationSites`; the `where` constraints
	// they must satisfy are decided after the merge, by `checkWhereConstraints`, for the reason
	// `literalInitSites` above is decided there.
	export var inferredInstantiationSites as GenericInstantiationSiteArray

	// This file's LOCAL type-name interner. Its ids are file-local; `mergeArtifact`
	// folds them into the project interner and remaps this artifact's ids.
	export var typeNames as TypeNameInterner

	// ⭐ **THE LOCAL INDEX OF THE FUNCTION CURRENTLY BEING PARSED** — the key `recordValueOrigin` /
	// `recordParamOrigin` file each value's origin under. `module.funcCount()` cannot serve: a closure
	// literal's lifted top-level function is parsed and pushed in the MIDDLE of its enclosing function's
	// body, so with two functions in flight the count names neither one's final index, and the two would
	// collide on it (the enclosing function's early values and the closure's values both keyed to the same
	// index — a corrupted origin table, an E5001 pointing at the wrong source). `parseFunction` pushes each
	// function up front and stamps this field with the index it landed at, and `parseClosureExpression`
	// saves/sets/restores it around the lifted body — so every value is filed under the index its function
	// actually occupies. Zero for the tolerant declaration sweep, which parses no bodies and records no
	// origins.
	export var currentFuncIndex as ElementIndex

	// ⭐ DIAGNOSTICS THE PARSER RAISES WITHOUT UNWINDING. The parser reports a malformed
	// construct by THROWING a `SourceParseError` (which abandons its region), but a WHOLE-PROGRAM
	// SEMANTIC error a pure per-file parser detects — a generic instantiation whose base is not
	// generic, whose arity is wrong, or whose argument is managed — is not a reason to abort the
	// parse: it is a diagnostic that gates the build, exactly like `SemanticCheck`'s do. The parser
	// records it here rather than in `project.diagnostics` (which it must not touch — the pure-parser
	// invariant), and `mergeArtifact` folds this list into `project.diagnostics`, the single writer.
	// The tolerant declaration SWEEP uses a DIFFERENT artifact that is never merged, so a spurious
	// diagnostic it records against the still-building signature index is discarded for free.
	export var diagnostics as DiagnosticArray

	// What the parse refused, here and in `refusal`, carried so a memo hit reports it:
	// `Queries.reportOwnRefusals` reports it wherever `diagnostics` is reported.
	export var abandonedRegions as AbandonedRegionArray

	// The refusal that stopped the parse, when one did; the rest of the artifact is then what the
	// aborted parse still knew (`Parser.abortedParseArtifact`).
	export var refusal as ParseRefusal

	export var refusedInstanceDeferrals as ElementIndex

	// ⭐ THE TWO DEFERRED NAME DIAGNOSTICS — an unused typealias, and a type name this file cannot
	// see. They are kept OUT of `diagnostics` above and reported later, in a
	// fixed order, by `TypeResolution.reportDeferredNameDiagnostics`; `DeferredNameDiagnostic`'s header
	// carries the whole argument for why per-file reporting cannot give the order the corpus pins.
	//
	// Two lists rather than one with a kind tag, because the ORDER BETWEEN THEM is the entire reason
	// they are deferred: every unused-alias diagnostic in the program precedes every hidden-name one,
	// and a single list would have to re-derive that split at the drain.
	export var unusedTypeAliases as DeferredNameDiagnosticRoster
	export var hiddenTypeNames as DeferredDiagnosticRoster
	export var hiddenTypeDeclarations as NameRoster

	// ⭐ THE SECONDARY FINDINGS this file's parse recorded (`findingStandingOf` classifies them), kept OUT
	// of `diagnostics` above so they cannot gate the pipeline ahead of the checks that could explain the
	// body instead. `commitDiagnostics` files them on `project.secondaryDiagnostics`. Kept in the memo, so
	// a warm rebuild or an LSP re-check replays them.
	//
	// They are finished `Diagnostic`s and not `DeferredNameDiagnostic`s because nothing about them needs
	// re-deciding later — only the REPORTING is deferred, never the verdict, which is a fact about one
	// function body and is settled at its `end`.
	export var secondaryDiagnostics as DiagnosticArray

	// ⭐⭐ **WHAT THIS FILE'S PARSE WROTE INTO THE SIGNATURE INDEX.** The parse's writes are undone when it
	// ends, so a parse reads only the settled index and its own mints; every merge folds these back in
	// (`ProgramSignatures.adoptParseMints`), whether this artifact is a fresh parse or a memo reused against a
	// rebuilt index.
	export var parseMints as ParseMints

	// The id each of `parseMints`' instance rows is known by in this artifact's ids right now: the parse's band
	// ids until a merge renumbers them, then the ids the latest merge adopted the rows under.
	export var instanceIdsInUse as GenericInstanceIdArray

	export static function create(filePath FilePath, livesUnderStdlibDirectory bool, sourceBytes SourceByteCount) returns FileParseArtifact
		return Self{
			filePath: filePath,
			livesUnderStdlibDirectory: livesUnderStdlibDirectory,
			typeIdsAreProjectGlobal: false,
			module: MaxonModule.create(),
			opRanges: SourceRangeTable.create(),
			covPoints: CovPointArray.create(0),
			asyncSpawnSites: AsyncSpawnSiteMap.create(),
			serviceAwaitSites: ServiceAwaitSiteMap.create(),
			registryUseSites: noRegistryUseSites,
			allocTagSites: AllocTagSiteMap.create(),
			closureRecordSites: ClosureRecordSiteSet.create(),
			debugStreamNameSites: DebugStreamNameSiteMap.create(),
			immortalConstArraySites: ImmortalConstArraySiteMap.create(),
			provenFixedArrayAccesses: ProvenFixedArrayAccessMap.create(),
			valueOrigins: ValueOriginTable.create(),
			deferredChains: DeferredChainTable.create(),
			funcSignatures: FuncSignatureEntryArray.create(0),
			pendingFnMergeChecks: PendingFnMergeCheckArray.create(0),
			pendingFunctionTypeDoors: PendingFunctionTypeDoorArray.create(0),
			pendingBrandRecords: PendingBrandRecordArray.create(0),
			pendingDiscardedResults: PendingDiscardedResultArray.create(0),
			rangeChecks: FunctionRangeCheckEntryArray.create(0),
			typeAliases: RangedTypeAliasArray.create(0),
			functionTypeAliases: FunctionTypeAliasArray.create(0),
			structTypes: StructLayoutArray.create(0),
			writtenTupleTypes: WrittenTupleTypeArray.create(0),
			enumTypes: EnumLayoutArray.create(0),
			interfaces: IrInterfaceArray.create(0),
			typeNameDecls: TypeNameDeclArray.create(0),
			usedTypeNames: noUsedTypeNames,
			memberAccessedTypeNames: noUsedTypeNames,
			unbuiltBodies: UnbuiltBodyArray.create(0),
			conformances: ConformanceDeclArray.create(0),
			literalInitSites: LiteralInitSiteArray.create(0),
			inferredInstantiationSites: GenericInstantiationSiteArray.create(0),
			typeNames: TypeNameInterner.createForSource(sourceBytes),
			currentFuncIndex: 0,
			diagnostics: DiagnosticArray.create(0),
			abandonedRegions: AbandonedRegionArray.create(0),
			refusal: ParseRefusal.none,
			refusedInstanceDeferrals: 0,
			unusedTypeAliases: noDeferredNameDiagnostics,
			hiddenTypeNames: noDeferredDiagnostics,
			hiddenTypeDeclarations: NameRoster.create(0),
			secondaryDiagnostics: DiagnosticArray.create(0),
			parseMints: ParseMints.none,
			instanceIdsInUse: GenericInstanceIdArray.create(0)
		}
	end 'create'

	export function refusesAnything() returns bool
		return match self.refusal 'refusal'
			none gives self.diagnostics.count() != 0 or not self.abandonedRegions.isEmpty()
			refused gives true
		end 'refusal'
	end 'refusesAnything'

	// File what the parse that built this artifact wrote into the signature index, with each instance row known
	// by the band id the parse handed it.
	export function recordParseMints(mints LocalInstanceMints)
		var bandIds = GenericInstanceIdArray.create(mints.rows.count(), zeroed: false)

		for position in 0 upto mints.rows.count() 'eachRow'
			bandIds.push(BandInstanceIdBase + position)
		end 'eachRow'

		self.parseMints = ParseMints.minted(mints)
		self.instanceIdsInUse = bandIds
	end 'recordParseMints'

	// Inclusive of `limit`, for the reason `scripts/library-cache/codec_rewind.py`'s `record_lines`
	// gives.
	function forgetRegistryUseSitesFrom(first ElementIndex, limit ElementIndex)
		match self.registryUseSites 'state'
			unwritten then return
			entries then break
		end 'state'

		var byOp = self.registryUseSitesForWrite()

		for opIndex in first to limit 'eachOpWithAUse'
			_ = byOp.remove(opIndex)
		end 'eachOpWithAUse'
	end 'forgetRegistryUseSitesFrom'

	// Record an alias this file declared and never named, and a type name this file cannot see. Each
	// installs its own list on the first entry (`DeferredNameDiagnosticRoster`, `DeferredDiagnosticRoster`).
	export function recordUnusedTypeAlias(entry DeferredNameDiagnostic)
		var recorded = self.unusedTypeAliasesForWrite()
		recorded.push(entry)
	end 'recordUnusedTypeAlias'

	export function recordHiddenTypeName(entry Diagnostic)
		var recorded = self.hiddenTypeNamesForWrite()
		recorded.push(entry)
	end 'recordHiddenTypeName'

	export function adoptHiddenTypeNames(source FileParseArtifact)
		for declared in source.hiddenTypeDeclarations 'eachDeclared'
			self.hiddenTypeDeclarations.push(declared)
		end 'eachDeclared'

		match source.hiddenTypeNames 'source'
			unwritten then return
			entries(recorded) then self.recordHiddenTypeNames(recorded)
		end 'source'
	end 'adoptHiddenTypeNames'

	function recordHiddenTypeNames(entries DiagnosticArray)
		var rendered = RenderedDiagnosticSet.create()

		for entry in entries 'eachEntry'
			let text = entry.render()

			if rendered.contains(text) 'alreadyHeld'
				continue
			end 'alreadyHeld'

			rendered.insert(text)
			self.recordHiddenTypeName(entry)
		end 'eachEntry'
	end 'recordHiddenTypeNames'

	// THE emit choke point for a Maxon body op — the only way the parser creates
	// one. Appending the op and recording its span happen together here, so
	// `module.ops` and `opRanges` cannot drift apart: there is no path that adds a
	// Maxon op without a span. (Calling `module.appendOp` directly would be that
	// path, which is why nothing in the Maxon tier does.)
	//
	// `appendOp` assigns the op the index `opCount()` holds right now, so capture it
	// BEFORE the append. `record` then asserts that index equals the span table's
	// own count — which is exactly the parallelism invariant, checked on every
	// single op: if anything ever appended a Maxon op behind this function's back,
	// the two counts diverge and the NEXT emit panics rather than silently shifting
	// every later span by one.
	export function emitOp(block IrBlock, op MaxonOp, range SourceRange)
		let opIndex = self.module.opCount()
		self.module.appendOp(block, op: artifactOwnedOp(op))
		self.opRanges.record(opIndex, range: range)
		self.recordValueOrigin(op, opIndex: opIndex)
	end 'emitOp'

	// Record an `async <call>` spawn's SOURCE TEXT against the op `emitOp` is about to append. The caller reads
	// `self.module.opCount()` through this rather than being handed an index, so the text lands on the same op
	// the very next `emitOp` creates and the two cannot be wired to different ops by a later edit.
	export function recordAsyncSpawnSite(site AsyncSpawnSite)
		self.asyncSpawnSites.upsert(self.module.opCount(), value: site)
	end 'recordAsyncSpawnSite'

	// The service twin, on the same read-it-through-here contract and for its reason: the site lands on the op
	// the parser is ABOUT to append, so the key is the current count.
	export function recordServiceAwaitSite(site ServiceAwaitSite)
		self.serviceAwaitSites.upsert(self.module.opCount(), value: site.clone())
	end 'recordServiceAwaitSite'

	export function recordRegistryUseSite(site RegistryUseSite)
		var byOp = self.registryUseSitesForWrite()
		byOp.upsert(self.module.opCount(), value: site)
	end 'recordRegistryUseSite'

	function registryUseSitesForWrite() returns RegistryUseSiteMap
		match self.registryUseSites 'state'
			unwritten then break
			entries(byOp) then return byOp
		end 'state'

		let fresh = RegistryUseSiteMap.create()
		self.registryUseSites = RegistryUseSiteTable.entries(fresh)
		return fresh
	end 'registryUseSitesForWrite'

	// Record the mm-trace TAG of the box the op `emitOp` is about to append allocates — the same
	// read-it-through-here contract `recordAsyncSpawnSite` states, and for its reason: the tag lands on the
	// op the very next append creates, so the two cannot be wired to different ops by a later edit.
	export function recordAllocTagSite(tag MmTag)
		self.allocTagSites.upsert(self.module.opCount(), value: tag)
	end 'recordAllocTagSite'

	export function recordClosureRecordSite()
		self.closureRecordSites.insert(self.module.opCount())
	end 'recordClosureRecordSite'

	// Record the compile-time NAME the `__ds_name_id` marker `emitOp` is about to append interns — the same
	// read-it-through-here contract its two neighbours state, and for their reason.
	export function recordDebugStreamNameSite(name ByteArray)
		self.debugStreamNameSites.upsert(self.module.opCount(), value: name)
	end 'recordDebugStreamNameSite'

	// Record that the `constArrayLiteral` `emitOp` is about to append materializes an IMMORTAL `.rdata`
	// record of `kind` — the same read-it-through-here contract its two neighbours state, and for their
	// reason.
	export function recordImmortalConstArraySite(kind ImmortalRecordKind)
		self.immortalConstArraySites.upsert(self.module.opCount(), value: kind)
	end 'recordImmortalConstArraySite'

	export function recordProvenFixedArrayAccess(opIndex ElementIndex, accessor SizedAccessor)
		self.provenFixedArrayAccesses.upsert(opIndex, value: accessor)
	end 'recordProvenFixedArrayAccess'

	// THE emit choke point for a Maxon block terminator. Same op/span lockstep as
	// `emitOp`; separate only because a terminator is stored on the block rather
	// than appended to its op list.
	//
	// ⭐⭐ **A SECOND TERMINATOR ON ONE BLOCK IS A MISCOMPILE, AND WITHOUT THIS GUARD IT IS SILENT.**
	// A block's terminator is a SLOT, not the last op of its list, so `setTerminator` on a block that
	// already has one simply REPLACES it and the first is gone — no diagnostic, no orphan the backend
	// trips over, just a `ret` or a `br` that never happens.
	//
	// The SOURCE-level cure is E3071 (`parseStatements` refuses the statement after a terminator); this
	// is the structural one behind it, so a construct added to the grammar without that guard fails
	// LOUDLY here instead of quietly answering wrong. Every legitimate site already asks first —
	// `finalizeIfNoElse`/`finalizeIfElse` on `thenEnd.isTerminated()`, `closeFunctionBody` and
	// `parseBlockBody` on `bodyEnd.isTerminated()`.
	//
	// ⚠ **`hasTerminatorOp` AND NOT `isTerminated`** — a `dead` block (the continuation of an `if` whose
	// branches all return) holds no terminator op, and giving it one is the ordinary way its unreachable
	// tail is parsed for syntax. Only a block with a REAL terminator op may not be given a second.
	export function emitTerminator(block IrBlock, op MaxonOp, range SourceRange)
		if block.hasTerminatorOp() 'alreadyTerminated'
			panic("emitTerminator: block '{String.from(block.label)}' already has a terminator at op {block.terminatorIndex()} — a second one would silently replace it (see E3071)")
		end 'alreadyTerminated'

		let opIndex = self.module.opCount()
		self.module.setTerminator(block, op: artifactOwnedOp(op))
		self.opRanges.record(opIndex, range: range)
		self.recordValueOrigin(op, opIndex: opIndex)
	end 'emitTerminator'

	// Record the origin of the value `op` defines (if any) as this file's contribution
	// to the whole-program `ValueOrigin` table. The current function's LOCAL index is
	// `self.currentFuncIndex`, stamped by `parseFunction` (and re-stamped by
	// `parseClosureExpression` around a lifted closure body): the function is pushed to
	// `module.functions` UP FRONT and this field records the index it landed at, so a closure
	// parsed in the middle of its enclosing function's body does not make `funcCount()` name
	// the wrong function. A `none`-result op (`ret`/`retVoid`/`condBranch`/`branch`) defines no
	// value and records nothing.
	function recordValueOrigin(op MaxonOp, opIndex ElementIndex)
		let id = try maxonOpDefinedValue(op) otherwise return
		self.valueOrigins.record(self.currentFuncIndex, valueId: id, opIndex: opIndex)
	end 'recordValueOrigin'

	// Record a PARAMETER's declaration span as this file's contribution to the whole-program
	// origin table. Called by the parser as it binds each parameter (a param is minted by no
	// op, so it has no `recordValueOrigin` entry — it needs this separate site). Keyed by the
	// current function's LOCAL index — `self.currentFuncIndex` — for `recordValueOrigin`'s reason.
	export function recordParamOrigin(valueId ValueId, range SourceRange)
		self.valueOrigins.recordParam(self.currentFuncIndex, valueId: valueId, range: range)
	end 'recordParamOrigin'

	export function recordDeferredChain(valueId ValueId, chainCalls DeferredChainCalls)
		self.deferredChains.record(self.currentFuncIndex, valueId: valueId, chainCalls: chainCalls)
	end 'recordDeferredChain'

	// Record a function's parameter signature and return type as this file's contribution to
	// the project-wide `funcSignatures` and `funcReturnTypes` registries. Called by the parser
	// after it builds a function — NEVER touching `Project`. The name's source position
	// travels with the entry so a merge-time duplicate can be positioned on the blamed
	// declaration.
	export function recordFuncSignature(name immutable ByteArray, signature FuncSignature, returnType MaxonReturnType, nameLine LineNumber, nameColumn ColumnNumber, sourceFilePath FilePath, synthesized bool)
		self.funcSignatures.push(FuncSignatureEntry.create(name, signature: signature.clone(), returnType: returnType.clone(), nameLine: nameLine, nameColumn: nameColumn, sourceFilePath: sourceFilePath, synthesized: synthesized))
	end 'recordFuncSignature'

	// ⭐ **THE INSTALL DOORS.** A `match` arm binds its payload IMMUTABLY and is ONE statement (E3159), so a
	// list cannot be written in the arm that reads it: each door below installs the
	// list on the first entry and ANSWERS it, and the caller writes through a `var` alias of that answer.

	// The unused-alias list this file defers into.
	function unusedTypeAliasesForWrite() returns DeferredNameDiagnosticArray
		match self.unusedTypeAliases 'state'
			unwritten then break
			entries(recorded) then return recorded
		end 'state'

		let fresh = DeferredNameDiagnosticArray.create(0)
		self.unusedTypeAliases = DeferredNameDiagnosticRoster.entries(fresh)
		return fresh
	end 'unusedTypeAliasesForWrite'

	// The hidden-name list, its twin.
	function hiddenTypeNamesForWrite() returns DiagnosticArray
		match self.hiddenTypeNames 'state'
			unwritten then break
			entries(recorded) then return recorded
		end 'state'

		let fresh = DiagnosticArray.create(0)
		self.hiddenTypeNames = DeferredDiagnosticRoster.entries(fresh)
		return fresh
	end 'hiddenTypeNamesForWrite'

	// Record a function's range-check sites as this file's contribution to `project.rangeChecks`.
	// Called by the parser at function completion, and ONLY when the function actually has
	// a cast into a ranged alias or a ranged `return` — a function with neither files nothing, so
	// the registry stays proportional to the range checks a program contains, not its function count.
	export function recordFunctionRangeChecks(name immutable ByteArray, checks FunctionRangeChecks)
		self.rangeChecks.push(FunctionRangeCheckEntry.create(name, checks: checks))
	end 'recordFunctionRangeChecks'

	// Record a ranged-typealias declaration as this file's contribution to the
	// project-wide `typeAliases` registry — the same NEVER-touch-Project discipline
	// `recordFuncSignature` follows.
	// The typealias arrays (`typeAliases` / `functionTypeAliases`) are PUSHED INTO DIRECTLY by
	// `Parser.readTypeAliasDeclaration`, which is handed the target array — the real parse passes the
	// artifact's, the declaration sweep passes its own — so one reader files a ranged alias in one array
	// and a function alias in the other with no boxed-union hop. `mergeArtifact` folds both into `Project`.

	// Record a declared struct type as this file's contribution to the project-wide `structTypes`
	// registry — the same NEVER-touch-Project discipline every `record*` above follows.
	export function recordStructType(layout StructLayout)
		self.structTypes.push(layout.clone())
	end 'recordStructType'

	// Record a declared enum/union type as this file's contribution to the project-wide `enumTypes`
	// registry — the same NEVER-touch-Project discipline every `record*` above follows.
	//
	// ⭐ **A PAYLOAD-BEARING UNION CONTRIBUTES ITS `unionCases` COMPANION TOO**, through the same door and
	// the same builder the declaration SWEEP appends it with (`Project.appendUnionCasesCompanion`, whose
	// header says why both registries need it). Here rather than at `parseEnumDeclaration`'s tail so the
	// artifact's enum list and the sweep's are filled by one rule.
	export function recordEnumType(layout EnumLayout)
		var owned = layout.clone()
		self.enumTypes.push(owned)
		appendUnionCasesCompanion(self.enumTypes, layout: owned)
	end 'recordEnumType'

	// Record a declared `interface` as this file's contribution to `project.interfaces`
	// — the same NEVER-touch-Project discipline every `record*` above follows.
	export function recordInterface(iface IrInterface)
		self.interfaces.push(iface.clone())
	end 'recordInterface'

	// Record a `type X implements …` conformance as this file's contribution to `project.conformances`.
	// The type-name position travels with it so `checkConformance` anchors on the name.
	export function recordConformance(conformance ConformanceDecl)
		self.conformances.push(conformance.clone())
	end 'recordConformance'

	// Record a function VALUE meeting a function-typed PLACE (see PendingFunctionTypeDoor).
	export function recordFunctionTypeDoor(door PendingFunctionTypeDoor)
		self.pendingFunctionTypeDoors.push(door.clone())
	end 'recordFunctionTypeDoor'

	export function recordBrandRecord(record PendingBrandRecord)
		self.pendingBrandRecords.push(record.clone())
	end 'recordBrandRecord'

	// Record a statement that used none of a call's result (see PendingDiscardedResult).
	export function recordDiscardedResult(site PendingDiscardedResult)
		self.pendingDiscardedResults.push(site.clone())
	end 'recordDiscardedResult'

	// Allocate this file's next counter slot and return its FILE-LOCAL id, which is what the op carries.
	// Read before the push, so the id is the position this point takes.
	export function recordCovPoint(point CovPoint) returns CovPointId
		let id = self.covPoints.count() as CovPointId
		self.covPoints.push(point)

		return id
	end 'recordCovPoint'

	// @generated library-cache begin
	module function cacheWrite(writer LibraryCacheWriter)
		writer.text(self.filePath.toString())
		writer.flag(self.livesUnderStdlibDirectory)
		writer.flag(self.typeIdsAreProjectGlobal)
		cacheWriteMaxonModule(writer, value: self.module)
		self.opRanges.cacheWrite(writer)
		cacheWriteCovPointArray(writer, value: self.covPoints)
		cacheWriteAsyncSpawnSiteMap(writer, value: self.asyncSpawnSites)
		cacheWriteServiceAwaitSiteMap(writer, value: self.serviceAwaitSites)
		cacheWriteRegistryUseSiteTable(writer, value: self.registryUseSites)
		cacheWriteAllocTagSiteMap(writer, value: self.allocTagSites)
		cacheWriteClosureRecordSiteSet(writer, value: self.closureRecordSites)
		cacheWriteDebugStreamNameSiteMap(writer, value: self.debugStreamNameSites)
		cacheWriteImmortalConstArraySiteMap(writer, value: self.immortalConstArraySites)
		cacheWriteProvenFixedArrayAccessMap(writer, value: self.provenFixedArrayAccesses)
		self.valueOrigins.cacheWrite(writer)
		self.deferredChains.cacheWrite(writer)
		cacheWriteFuncSignatureEntryArray(writer, value: self.funcSignatures)
		cacheWritePendingFnMergeCheckArray(writer, value: self.pendingFnMergeChecks)
		cacheWritePendingFunctionTypeDoorArray(writer, value: self.pendingFunctionTypeDoors)
		cacheWritePendingBrandRecordArray(writer, value: self.pendingBrandRecords)
		cacheWritePendingDiscardedResultArray(writer, value: self.pendingDiscardedResults)
		cacheWriteFunctionRangeCheckEntryArray(writer, value: self.rangeChecks)
		cacheWriteRangedTypeAliasArray(writer, value: self.typeAliases)
		cacheWriteFunctionTypeAliasArray(writer, value: self.functionTypeAliases)
		cacheWriteStructLayoutArray(writer, value: self.structTypes)
		cacheWriteWrittenTupleTypeArray(writer, value: self.writtenTupleTypes)
		cacheWriteEnumLayoutArray(writer, value: self.enumTypes)
		cacheWriteIrInterfaceArray(writer, value: self.interfaces)
		cacheWriteTypeNameDeclArray(writer, value: self.typeNameDecls)
		cacheWriteGenericFunctionInstanceArray(writer, value: self.genericInstanceRequests)
		cacheWriteUsedTypeNameRoster(writer, value: self.usedTypeNames)
		cacheWriteUsedTypeNameRoster(writer, value: self.memberAccessedTypeNames)
