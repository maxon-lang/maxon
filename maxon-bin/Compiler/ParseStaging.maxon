		serviceSpawn(result, typeName, state, capacity, callee, args, argLabels, argRanges, argImmutableNames, defaultedArgs, mint, startReplies) then return MaxonOp.serviceSpawn(result, typeName: typeName, state: state, capacity: capacity, callee: callee, args: args, argLabels: ownedNames(argLabels), argRanges: argRanges, argImmutableNames: ownedBlames(argImmutableNames), defaultedArgs: defaultedArgs, mint: mint, startReplies: startReplies)
