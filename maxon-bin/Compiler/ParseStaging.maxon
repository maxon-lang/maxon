	// spawn sites appear. `mergeArtifact` folds it into `project.asyncSpawnSites` with the merge's op offset,
	// exactly as `opRanges` and `valueOrigins` are folded. See `Project.asyncSpawnSites` for why the text has
	// to be captured here rather than recovered downstream.
	export var asyncSpawnSites as AsyncSpawnSiteMap

	export var overloadAnswers as OverloadAnswerMap

	// The twin of `asyncSpawnSites` for services: every `await` of a service reply this file holds, keyed by the op
	// index in THIS artifact's module and folded with the merge's offset. See `Project.serviceAwaitSites`.
	export var serviceAwaitSites as ServiceAwaitSiteMap

	export var registryUseSites as RegistryUseSiteTable

	// The mm-trace tag of each compiler-minted box this file allocates that is not any declared type's.
	// `mergeArtifact` folds it into `project.allocTagSites` with the merge's op offset, exactly as
	// `asyncSpawnSites` is. See `Project.allocTagSites` for why it is a side channel and not a type.
	export var allocTagSites as AllocTagSiteMap

