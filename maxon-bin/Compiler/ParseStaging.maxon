	commitPendingFnMergeChecks(project, artifact: artifact)
	commitPendingFunctionTypeDoors(project, artifact: artifact)
	commitPendingBrandRecords(project, artifact: artifact, opOffset: opOffset)
	commitPendingDiscardedResults(project, artifact: artifact, opOffset: opOffset)
	commitRangeChecks(project, artifact: artifact)
	commitTypeAliases(project, artifact: artifact)
	commitFunctionTypeAliases(project, artifact: artifact, signatures: signatures)
	commitStructTypes(project, artifact: artifact, signatures: signatures)
	commitWrittenTupleTypes(project, artifact: artifact)
	commitEnumTypes(project, artifact: artifact)
	commitInterfaces(project, artifact: artifact)
	commitConformances(project, artifact: artifact)
	commitLiteralInitSites(project, artifact: artifact)
	commitInferredInstantiationSites(project, artifact: artifact)
	commitDiagnostics(project, artifact: artifact)
	commitDeferredNameDiagnostics(project, artifact: artifact)
	commitWrittenGenericAliasNames(project, artifact: artifact, signatures: signatures)
