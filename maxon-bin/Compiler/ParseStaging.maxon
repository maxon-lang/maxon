// ParseStaging — `FileParseArtifact` and the deterministic `mergeArtifact` fold.
//
// This is the load-bearing parallel-ready seam of the frontend. The parser writes
// ONLY into a per-file `FileParseArtifact` — its own MaxonModule fragment, its own
// local type-name interner, and a recorded key+value bundle for every registry it
// would touch — so a file's parse is a pure function of its tokens with no shared
// state. `mergeArtifact` is then the SINGLE writer of the shared `Project`,
// folding artifacts in fixed source-path order so the result is deterministic
// regardless of the order files were parsed.
//
// A registry contribution is an ordered entry ARRAY rather than a map, which keeps
// it insertion-ordered so the merge is byte-deterministic.

export typealias FileParseArtifactArray = Array with FileParseArtifact

export typealias SourceByteCount = int(0 to u32.max)

// Calibrated so no file of this tree regrows its table;
// `tests/cli/interner-presize-never-regrows.maxtest` fails when one does.
let MinimumInternedTypeNames = 128 as NameId
let SourceBytesPerTypeName = 512
let ArenaBytesPerTypeName = 20

// The table is sized once, from the only figure available before a name is interned. A miss costs a
// regrowth and never a refusal, so the bias is high.
export function internedNameHintFor(sourceBytes SourceByteCount) returns NameId
	let estimate = (sourceBytes / SourceBytesPerTypeName) as NameId
	return MinimumInternedTypeNames if estimate < MinimumInternedTypeNames else estimate
end 'internedNameHintFor'

export function internedArenaHintFor(nameHint NameId) returns NameByteCount
	return nameHint * ArenaBytesPerTypeName
end 'internedArenaHintFor'

// ⭐ **WHAT A `Parser` IS BUILT FROM, AS VALUES RATHER THAN A `Project`** — every per-file fact the caller derived from
// the project (`Queries.parseJobFor`), so a parse on a pool worker needs nothing the main thread owns.
export type ParseJob
	export let path as FilePath
	export let namespace as String

	// ⭐ **IS THE FILE BEING PARSED `stdlib/` OR `scriptlib/` SOURCE?** One bit, decided once per file
	// by the query that builds this job (`Queries`), because that is the only tier holding the
	// project. It is the LAYER a declaration belongs to, never a tier: it travels on every
	// `TypeNameClaim` so a user's declaration of a library name shadows it rather than meeting it, and it
	// keeps the library out of the E3062 candidate list (see `recordTypeName`).
	export let isStdlibSource as bool

	// ⭐⭐ **IS THE FILE BEING PARSED A `runtime/` SOURCE FILE?** The tier's own bit, decided once per file
	// by `Queries` — the only tier holding the project — and read by the three rules that hold nowhere
	// else: the `__Raw.*` call privilege (E3152 outside it), the managed-value refusal (E3153) and the
	// `public` refusal (E3154). `coverageActive` reads it beside `isStdlibSource` for a fourth reason —
	// not a tier privilege, but the library/author split both tiers sit on the same side of.
	//
	// ⚠ **IT IS NOT `declaresCompilerInternalNames`, THOUGH THAT ONE IS TRUE OF EVERY RUNTIME FILE TOO.**
	// That bit answers "may this file DECLARE into the reserved space", which `stdlib/Builtins.maxon` and
	// `stdlib/Testing.maxon` also may; these three rules are about being the RUNTIME, which neither of
	// those is. One slot carrying both claims is a semantic slot shared by two facts.
	export let isRuntimeSource as bool

	// Set together with `isStdlibSource`, whose library privileges a scriptlib file shares. It marks the
	// one place such a file is still the user's: a `__` name is the compiler's only where the shadow rename
	// wrote it (`everySpellingIsTheCompilers`).
	export let isScriptlibSource as bool

	// ⭐ **MAY THIS FILE DECLARE `__`-PREFIXED NAMES?** True for the
	// modules that DECLARE the reserved space rather than merely using it — `stdlib/Builtins.maxon`
	// (`__ManagedFileError`, `__int_fromString`) and `stdlib/Testing.maxon` (`__TestReport`) — which is what
	// each of their own headers calls itself. Decided once per file by `Queries`, the only tier holding the
	// project, and read by the one choke point every new declaration goes through (`requireUnreservedName`).
	// See `Queries.TestReportDeclaringModule` for why the set is a LIST of named modules and not the
	// set of modules the loader takes, nor "any `__` name no intrinsic claims".
	//
	// ⚠ **IT IS DELIBERATELY NOT `isStdlibSource`, AND THE TWO ANSWER DIFFERENT QUESTIONS.**
	// `isStdlibSource` decides VISIBILITY, and its root-inside-`stdlib/` arm hands a project rooted under
	// `stdlib/` its own files back as the USER's — correctly, for visibility. Reused here it would make
	// `maxon build stdlib/Builtins.maxon` — the command `StdlibLoader`'s collision rule prescribes for
	// compiling one stdlib module on its own — refuse the very module the loader is about to load.
	// Being the compiler's internal bridge is a property of the FILE, not of how a command line spelled it.
	export let declaresCompilerInternalNames as bool

	// ⭐⭐ **THE RESERVED NAMES THIS COMPILE MINTED INTO THIS FILE — the THIRD provenance the reserved-name
	// doors read (`Queries.compilerMintedNamesIn`).** Non-empty only for the generated Maxon source a
	// `maxon test` build stages; empty for every file of every other compile, which is what says the author
	// wrote every byte of it.
	//
	// ⚠ **THE TWO DOORS READ IT AT DIFFERENT GRAIN, AND THAT IS THE WHOLE POINT.** The CALL door asks
	// only whether the list is non-empty (`fileMayUseReservedNames`), because a generated fragment has
	// to reach names OTHER files declare and that door already conjoins `declaresCallee`. The
	// DECLARATION door asks whether the name being declared is IN the list (`requireUnreservedName`),
	// because a staged `.maxtest` file is the author's own bytes with a dispatcher appended — so a
	// per-file answer there would hand the author the reserved space.
	//
	// ⚠ **IT IS SEPARATE FROM `declaresCompilerInternalNames` EVEN THOUGH THE CALL DOOR TAKES THEIR
	// DISJUNCTION.** The two are different FACTS — "this is one of the two stdlib modules that declare the
	// reserved space" and "this compile wrote these names" — and folding them into one slot would be a
	// semantic slot shared by two claims, which is the shape this project's defect log keeps naming.
	export let compilerMintedNames as NameRoster

	// ⭐ **IS THIS FILE PHYSICALLY INSIDE `stdlib/`?** True for every module the loader
	// takes AND for a module named directly on the command line (`maxon build stdlib/URL.maxon`),
	// because being under `stdlib/` is a property of the FILE. Read by `rawSurfaceIsRefusedHere` (the library
	// tier, E3185) and by the compiler-owned-name contest (`declarationContestsACompilerOwnedName`).
	//
	// ⭐ It is DERIVED, not probed: `isStdlibSource` already answers it except when the project ROOT is
	// itself under `stdlib/`, and that is a fact about the COMPILE, asked once
	// (`Queries.livesUnderStdlibDirectory`, which carries the proof and the ladder measurement).
	//
	// ⚠ **IT IS DELIBERATELY NOT `isStdlibSource`, FOR `declaresCompilerInternalNames`' REASON.**
	// Gated on the visibility bit, the refusal would tell
	// `maxon build stdlib/URL.maxon` that the file "is not stdlib source" — false about that path, and
	// it would break the one command that finds a module's blockers before it is listed. See
	// `Queries.livesUnderStdlibDirectory`.
	export let livesUnderStdlibDirectory as bool

	// Whether this parse builds ops for the file's function bodies. A user file always does; a stdlib
	// file does once a path from `main` reaches it (see `StdlibSource.growStdlibBodyDemand`). It prunes
	// ops and nothing else: every declaration is still read, because a declaration can move the emitted
	// code of a program that never names its module (`StdlibLoader`'s header), while an unreached body
	// is dropped by `lowerMaxonToStd` and `DeadFunctionElimination` regardless.
	export let buildsBodies as bool

	// Whether this build writes a `.mxdbg` sidecar (`Project.debugInfo`). A build that records no binding
	// pays nothing for the debug-locals roster, which is half of what keeps the emitted image
	// byte-identical with the sidecar and without it.
	export let capturesDebugLocals as bool

	// Whether this build instruments for code coverage (`Project.coverage`). The parse memo carries a salt
	// for it, so a warm tree cannot serve an uninstrumented parse to an instrumented build.
	export let instrumentsCoverage as bool
	export let initializerRole as InitializerRole

	export static function create(path FilePath, namespace String, isStdlibSource bool, isRuntimeSource bool, isScriptlibSource bool, declaresCompilerInternalNames bool, compilerMintedNames NameRoster, livesUnderStdlibDirectory bool, buildsBodies bool, capturesDebugLocals bool, instrumentsCoverage bool) returns ParseJob
		return Self{path: path, namespace: namespace, isStdlibSource: isStdlibSource, isRuntimeSource: isRuntimeSource, isScriptlibSource: isScriptlibSource, declaresCompilerInternalNames: declaresCompilerInternalNames, compilerMintedNames: compilerMintedNames, livesUnderStdlibDirectory: livesUnderStdlibDirectory, buildsBodies: buildsBodies, capturesDebugLocals: capturesDebugLocals, instrumentsCoverage: instrumentsCoverage, initializerRole: InitializerRole.ordinary}
	end 'create'

	// The job `ProgramSignatures` parses an initializer under, in the role it names: the declaring file's
	// own, so the initializer is judged by that file's privileges. Coverage and debug locals are cleared
	// because the fold's ops reach no emitted image. Derived from the stored job rather than from the
	// project, which would put a `Directory.currentPath()` probe on the per-declaration path.
	export function forInitializerRole(role InitializerRole) returns ParseJob
		return Self{path: self.path, namespace: self.namespace, isStdlibSource: self.isStdlibSource, isRuntimeSource: self.isRuntimeSource, isScriptlibSource: self.isScriptlibSource, declaresCompilerInternalNames: self.declaresCompilerInternalNames, compilerMintedNames: self.compilerMintedNames, livesUnderStdlibDirectory: self.livesUnderStdlibDirectory, buildsBodies: true, capturesDebugLocals: false, instrumentsCoverage: false, initializerRole: role}
	end 'forInitializerRole'

	export function readsAuthorSource() returns bool
		return not self.isStdlibSource and not self.isRuntimeSource
	end 'readsAuthorSource'
end 'ParseJob'

export enum InitializerRole
	ordinary
	sweepFold
	recordProbe
end 'InitializerRole'

// What one file's parse answers: its artifact, or the refusal with the blame it carries and what an aborted parse
// still knows (`Parser.abortedParseArtifact`). Either way it carries the regions the parse
// abandoned, whose refusals no artifact holds, so the caller reports them from here.
export union FileParseOutcome
	parsed(artifact FileParseArtifact, abandoned AbandonedRegionArray)
	failed(error SourceParseError, blame LibraryBlame, salvaged FileParseArtifact, consequence ConsequenceOf, abandoned AbandonedRegionArray)
end 'FileParseOutcome'

// What a parse refusal may be the consequence of. Anything but `unrelated` is held, and dropped
// once a backed refusal of what it names explains it (`PendingConsequence.isExplainedBy`).
export union ConsequenceOf
	unrelated
	subject(names NameRoster)
	handlerBody(message ByteArray)
	unknownType(name ByteArray)
end 'ConsequenceOf'

export type AbandonedRegion
	export let error as SourceParseError
	export let blame as LibraryBlame
	export let key as PositionKey
	export let poisoned as PoisonedAt
	export let consequence as ConsequenceOf

	export static function create(error SourceParseError, blame LibraryBlame, part RefusedPart, consequence ConsequenceOf) returns AbandonedRegion
		return Self{error: error, blame: blame, key: part.key, poisoned: part.poisoned, consequence: consequence}
	end 'create'
end 'AbandonedRegion'

export typealias AbandonedRegionArray = Array with AbandonedRegion

union ParseAttempt
	parsed(artifact FileParseArtifact)
	failed(error SourceParseError, blame LibraryBlame, salvaged FileParseArtifact, consequence ConsequenceOf)
	retry(region AbandonedRegion, salvaged FileParseArtifact)
end 'ParseAttempt'

// ⭐⭐ **ONE FILE'S PARSE, AS A FUNCTION OF WHAT IT IS HANDED** — the job, the file's tokens, the row-set answers it
// is told and the settled index, which it leaves as it found them. It reaches no `Project` and no module `var`, so
// a pool worker holding a private index may run it (E3143); the caller reports the outcome. Its parser's anchors
// are its own, so the artifact holds no record from outside itself.
//
// A refusal confined to one region (`Parser.openRegion`) is recovered by parsing the file again
// with that region skipped. The loop ends because a refusal in a region an earlier attempt already
// abandoned fails the file (`recoverableRegionOf`), so every retry abandons a region none before it
// did.
export function parseFile(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable, signatures ProgramSignatures) returns FileParseOutcome
	var recovered = AbandonedRegionArray.create()
	var salvages = FileParseArtifactArray.create()

	while true 'eachAttempt'
		let attempt = parseAttempt(job, tokens: tokens, overrides: overrides, signatures: signatures, recovered: recovered, salvages: salvages)

		match attempt 'attempt'
			parsed(artifact) then return FileParseOutcome.parsed(artifact, abandoned: recovered)
			failed(error, blame, salvaged, consequence) then return FileParseOutcome.failed(error, blame: blame, salvaged: salvaged, consequence: consequence, abandoned: recovered)
			retry(region, salvaged) then keepRecovery(region, salvaged: salvaged, recovered: recovered, salvages: salvages)
		end 'attempt'
	end 'eachAttempt'
end 'parseFile'

function keepRecovery(region AbandonedRegion, salvaged FileParseArtifact, recovered AbandonedRegionArray, salvages FileParseArtifactArray)
	recovered.push(region)
	salvages.push(salvaged)
end 'keepRecovery'

function parseAttempt(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable, signatures ProgramSignatures, recovered AbandonedRegionArray, salvages FileParseArtifactArray) returns ParseAttempt
	var parser = Parser.create(tokens, job: job, signatures: signatures, anchors: ParserAnchors.create())
	parser.abandonRegions(recovered)
	parser.adoptRetryStatesOf(salvages)
	signatures.openParseBand(overrides)

	// A refusal and its blame may hold records the index owns (a `throws` clause's name, a recorded constant's
	// error, an instantiation's file), and the outcome crosses back from a pool worker, so it carries copies.
	var artifact = try parser.parseModule() otherwise (parseErr) 'parseFail'
		_ = signatures.closeParseBand(job.path)

		if let region = try recoverableRegionOf(parseErr, parser: parser, job: job, signatures: signatures, recovered: recovered) 'aRecoverableRefusal'
			return ParseAttempt.retry(region, salvaged: parser.abortedParseArtifact())
		end 'aRecoverableRefusal'

		return ParseAttempt.failed(parseErr.clone(), blame: parser.libraryBlame.clone(), salvaged: parser.abortedParseArtifact(), consequence: consequenceOfRefusal(parseErr, parser: parser, job: job, signatures: signatures))
	end 'parseFail'

	artifact.recordParseMints(signatures.closeParseBand(job.path))
	return ParseAttempt.parsed(artifact)
end 'parseAttempt'

function recoverableRegionOf(error SourceParseError, parser Parser, job ParseJob, signatures ProgramSignatures, recovered AbandonedRegionArray) returns AbandonedRegion throws AbsentError
	if not refusalIsLocal(parser, job: job, signatures: signatures) 'theFileCannotBeReadPastIt'
		throw AbsentError.absent
	end 'theFileCannotBeReadPastIt'

	let part = try parser.openRegion.partRefusedAt(try refusalPositionOf(error, path: job.path))

	for region in recovered 'eachRecovered'
		if region.key == part.key 'alreadyAbandoned'
			throw AbsentError.absent
		end 'alreadyAbandoned'
	end 'eachRecovered'

	return AbandonedRegion.create(error.clone(), blame: parser.libraryBlame.clone(), part: part, consequence: consequenceOfRefusal(error, parser: parser, job: job, signatures: signatures))
end 'recoverableRegionOf'

function refusalIsLocal(parser Parser, job ParseJob, signatures ProgramSignatures) returns bool
	return job.readsAuthorSource() and not parser.blockStructureMisread and not signatures.hasMisclosedBlocks()
end 'refusalIsLocal'

function consequenceOfRefusal(error SourceParseError, parser Parser, job ParseJob, signatures ProgramSignatures) returns ConsequenceOf
	if not refusalIsLocal(parser, job: job, signatures: signatures) 'nothingMayBeDropped'
		return ConsequenceOf.unrelated
	end 'nothingMayBeDropped'

	return consequenceNamedBy(error)
end 'consequenceOfRefusal'

function consequenceOfReceiverOrigin(origin ReceiverOrigin) returns ConsequenceOf
	return match origin 'origin'
		derivedFrom(names) gives ConsequenceOf.subject(names.clone())
		unattributed gives ConsequenceOf.unrelated
	end 'origin'
end 'consequenceOfReceiverOrigin'

function namedConsequence(name ByteArray) returns ConsequenceOf
	return ConsequenceOf.subject(singleName(name))
end 'namedConsequence'

// ⚠ A refusal given a subject is dropped whenever that subject was refused, so only a refusal that
// cannot be independent of the declaration it names may have one; an independent error routed here
// would go unreported.
function consequenceNamedBy(error SourceParseError) returns ConsequenceOf
	return match error 'kind'
		unknownTypeName(typeName, _, _) gives ConsequenceOf.unknownType(typeName.toByteArray())
		unknownField(typeName, _, _, _) gives namedConsequence(typeName.toByteArray())
		undefinedVariable(name, _, _) gives namedConsequence(name.toByteArray())
		uninferrableClosureParam(_, aliasName, _, _) gives namedConsequence(aliasName.toByteArray())
		unknownCompilerIntrinsic(callee, _, _, _) gives namedConsequence(callee.toByteArray())
		undefinedQualifiedFunction(callee, _, _, _) gives namedConsequence(callee.toByteArray())
		enumMatchNotExhaustive(_, typeName, _, _, _) gives namedConsequence(typeName.toByteArray())
		serviceTypeNotASpawnTarget(_, typeName, _, _) gives namedConsequence(typeName.toByteArray())
		serviceReplyGraphNotWalkable(_, message, _, _) gives ConsequenceOf.handlerBody(message.toByteArray())
		spawnStartRequiresTry(_, factory, _, _) gives namedConsequence(overloadRegistrationBaseName(factory))
		memberAccessOnNonStruct(_, _, _, origin) gives consequenceOfReceiverOrigin(origin)
		returnTypeMismatch(_, _, _, _, _, _, origin) gives consequenceOfReceiverOrigin(origin)
		unexpectedToken or
		expectedExpression or
		uninferrableFieldDefault or
		varStartsFromBareNumber or
		letStartsFromUnboundedNumber or
		callerLocationOutsideDefault or
		unexpectedEof or
		integerOverflow or
		floatLiteralOverflow or
		malformedNumericLiteral or
		formatFieldOverflow or
		nonIntegralOperands or
		implicitNarrowing or
		builtinArity or
		builtinOperandType or
		builtinOperandPhrase or
		builtinArgumentType or
		unsupported or
		tupleElementRejected or
		droppedSignature or
		declarationTheSweepMissed or
		duplicateParameter or
		ambiguousBareFunctionName or
		assignToImmutable or
		useAfterMove or
		useAfterMoveInto or
		useAfterMoveInAnEarlierIteration or
		useAfterMovePassedTwice or
		staleCellOccupantRead or
		promiseCannotBeBorrowed or
		promiseAlreadyConsumed or
		deepLet or
		controlOutsideLoop or
		labelTargetsOwnLoop or
		labelTargetsOwnMatch or
		unknownLoopLabel or
		firstArgNamed or
		argMissingLabel or
		builtinArgNamed or
		witnessArgCountMismatch or
		witnessUnknownArgLabel or
		witnessDuplicateArg or
		ambiguousWitnessDispatch or
		noWitnessRequirementOfArity or
		staticRequirementNotDispatchable or
		missingReturn or
		returnValueFromVoid or
		returnInInitializer or
		returnWithoutValue or
		operandTypeMismatch or
		operandAliasMismatch or
		nonNumericOperands or
		enumAccessorComparison or
		enumNoSuchRawValue or
		fieldsNotInitialized or
		fieldsNotDefinitelyAssigned or
		undefinedOperatorForType or
		nonNumericNegation or
		shiftCountNegative or
		comparisonTypeMismatch or
		operatorRequiresConformance or
		structEqualsResultNotBool or
		witnessSelfArgNotTypeParam or
		nonBoolCondition or
		assignTypeMismatch or
		typeMismatchExpectedGot or
		tupleAssignArityMismatch or
		functionValueIntoNonFunction or
		functionValueReturned or
		invalidCast or
		castTargetIsAContainer or
		castFormsAValue or
		throwingFunctionAsValue or
		giveTypeMismatch or
		ternaryValueTypeMismatch or
		ternaryNonBoolCondition or
		notOnUnknownType or
		voidCallResultUsed or
		invalidCharacterLiteral or
		invalidDigitEscape or
		byteStringCodepointRange or
		duplicateTopLevelDeclaration or
		circularConstants or
		nonConstantInitializer or
		divisionByProvableZero or
		constantCastOutOfRange or
		byteStringByteOutOfRange or
		rawByteFillNarrowElement or
		rawByteWriteSlotDomain or
		constructorRestricted or
		builtinTypeConstruction or
		conditionalExtensionWithheld or
		fieldNotInitialized or
		duplicateFieldInitializer or
		assignToImmutableField or
		localShadowsSelfField or
		unexportedFieldAccess or
		strayToken or
		expectedDeclaration or
		expectedNewlineAfter or
		bareTryInAClosure or
		mismatchedEndLabel or
		testOutsideTestFile or
		testEmptyName or
		duplicateTestName or
		selfOutsideInstanceMethod or
		unknownAnnotation or
		heapAnnotationWithoutBinding or
		heapAnnotationOnNonRecord or
		matchFallthroughWithReturn or
		matchNotExhaustive or
		matchDuplicatePattern or
		matchPatternTypeMismatch or
		matchDefaultNotLast or
		matchMissingBlockId or
		matchMismatchedBlockId or
		matchBlockStatement or
		enumDuplicateCase or
		enumDuplicateRawValue or
		enumRawValueTypeMismatch or
		enumUnknownCase or
		enumNoCaseNamed or
		enumFromNamePayloadArity or
		allCasesOnUnion or
		matchQualifiedCaseName or
		matchDiscardedBindings or
		matchDefaultEnumMustThrow or
		errorUnionMatchNotExhaustive or
		errorUnionMatchDefaultMustThrow or
		errorUnionAmbiguousBareCase or
		errorUnionUnknownCase or
		errorUnionUnknownMember or
		unknownPayloadName or
		enumWrongBindingCount or
		matchArmPayloadBindingConflict or
		tryBlockBindingNotMatched or
		errorMatchNotExactlyOnce or
		matchOverlappingCase or
		matchEnumCaseRange or
		matchOrChainNeedsOwnLine or
		matchSingleValueRange or
		unionNotComparable or
		existentialNotComparable or
		genericInstanceNotComparable or
		refIdentityOnPrimitive or
		refIdentityTypeMismatch or
		reservedIdentifier or
		reservedFaultProbeName or
		reservedReceiverName or
		declarationTakesCompilerOwnedTypeName or
		otherwiseWithoutTry or
		errorTypeMismatch or
		tryBlockFormInMatchArm or
		tryBlockNoThrows or
		tryBlockMissingOtherwise or
		tryOnNonThrowing or
		ifTryDiscardsResult or
		redundantContainsGet or
		tryOnNonThrowingBuiltin or
		tryOnTotalDivision or
		tryOnProvenFixedArrayAccess or
		fixedArrayIndexPastTheSize or
		awaitThrowingPromiseNeedsTry or
		awaitNonPromise or
		promiseStorageMismatch or
		propagateTypeMismatch or
		thrownValueNotAnErrorEnum or
		reservedNameAsFunctionValue or
		rawIntrinsicOutsideRuntimeTier or
		rawSurfaceOutsideLibraryTier or
		contradictoryFrameDirectives or
		bareGenericSubjectUnbound or
		managedValueInRuntimeSource or
		wideVisibilityInRuntimeSource or
		managedTypeInRuntimeSource or
		managedValueBuiltInRuntimeSource or
		arrayResizeManagedElement or
		arrayResizeZeroOutsideElement or
		fixedArrayCreateZeroOutsideElement or
		bufferSetLengthZeroOutsideElement or
		literalsShareNoIntegerType or
		bufferSetManagedElement or
		bufferByteAccessManagedElement or
		emptyBlock or
		unreachableCode or
		bareSizedTypeAlias or
		typealiasCycle or
		typealiasOverANonRangedName or
		implementsRangeDoesNotFit or
		implementsPrimitiveDiffers or
		genericTypeParameterNotInferable or
		genericArgumentsHaveNoCommonType or
		genericConstraintNotSatisfied or
		genericCallAmbiguous or
		genericArgumentKindUnsupported or
		genericTypeGrowsWithoutBound or
		illegalBitWidth or
		barePrimitiveType or
		barePrimitiveCastTarget or
		mismatchedRangeBoundTypes or
		unrepresentableIntegerRange or
		integerRangeLowerBoundAboveSignedMax or
		emptyIntegerRange or
		otherwiseOutsideRangedReturn or
		visibilityModifiersCombined or
		ambiguousTypeAlias or
		symbolNotVisible or
		selfAssignmentHasNoEffect or
		discardExpectsACall or
		ucdTableLabelUnknown or
		builtinUnknownArgLabel or
		serviceNotASpawnTarget or
		serviceValueNotTransferable or
		serviceArgumentNotUnique or
		serviceNotAMessage or
		serviceReplyNotCarriable or
		serviceReplyAliasesState or
		serviceReplyInstanceUnknown or
		registryRefused or
		extensionMemberHidesOwnMember gives ConsequenceOf.unrelated
	end 'kind'
end 'consequenceNamedBy'

function refusalPositionOf(error SourceParseError, path FilePath) returns PositionKey throws AbsentError
	match parseErrorDiagnostic(error, path: path, keywords: KeywordTable.create()).anchor 'anchor'
		at(_, line, column) then return positionKey(line, column: column)
		programWide or
		file then throw AbsentError.absent
	end 'anchor'
end 'refusalPositionOf'

// What a real parse wrote into the signature index — `none` for an artifact no real parse produced: the
// declaration sweep's, a top-level constant's, and an aborted parse's.
export union ParseMints
	none
	minted(mints LocalInstanceMints)
end 'ParseMints'

// @generated library-cache begin
function cacheWriteParseMints(writer LibraryCacheWriter, value ParseMints)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		none then break
		minted(a0) then cacheWriteParseMintsMinted(writer, a0: a0)
	end 'payload'
end 'cacheWriteParseMints'

function cacheWriteParseMintsMinted(writer LibraryCacheWriter, a0 LocalInstanceMints)
	a0.cacheWrite(writer)
end 'cacheWriteParseMintsMinted'

function cacheReadParseMints(reader LibraryCacheReader) returns ParseMints throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives ParseMints.none
		1 gives try cacheReadParseMintsMinted(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadParseMints'

function cacheReadParseMintsMinted(reader LibraryCacheReader) returns ParseMints throws LibraryCacheDamage
	let a0 = try LocalInstanceMints.cacheRead(reader)

	return ParseMints.minted(a0)
end 'cacheReadParseMintsMinted'

// @generated library-cache end

// One function's name and declared return type, recorded by the declaration sweep and applied by
// `ProgramSignatures.record`.
//
// ⭐ **`declaredSurface` IS THE PRE-ERASURE `__ManagedMemory` SPELLING OF THAT RETURN TYPE** —
// where the source named the alias, which `parseTypeReference` folds into `genericInstance(Array with Byte)`
// before a `MaxonReturnType` exists. It rides THIS record rather than a column of its own for one reason:
// the two facts must never disagree about the same declaration, and they cannot when they are written,
// remapped and folded as one entry. `ProgramSignatures.record` applies them together, with identical
// last-wins semantics, so the surface is exactly as accurate as the return type it accompanies —
// including for an overload set, where the sweep publishes ONE answer per bare name for both.
// ⭐⭐ **`visibility` IS THE DECLARATION'S OWN TIER, AND IT RIDES HERE FOR `declaredSurface`'S REASON** — it
// is a second fact about the SAME declaration, applied by `ProgramSignatures.record` beside the declaring
// file it already receives, so the tier and the file a visibility question needs are written together and
// cannot come to describe two declarations.
//
// ⭐⭐ **`takesReceiver` IS WHETHER THE DECLARATION CARRIES A HIDDEN `self`, AND IT RIDES HERE FOR
// `visibility`'S REASON** — a third fact about the SAME declaration, applied by `ProgramSignatures.record`
// in the same act. It is what makes a bare sibling call inside an `extension` body resolvable at all: the
// conformer's own methods are declared in another declaration and possibly another file, so no token walk
// can reach them, and knowing one EXISTS is not enough to call it — a `static` handed a receiver fails an
// arity check on a parameter nobody wrote, and an instance method denied one is called on nothing.
//
// The two SYNTHESIZED helpers the sweep publishes (a parameter default's, a field default's) take the
// receiverless default and mean it: each is a plain function the emitter calls with no instance.
// ⭐⭐ **`opaqueParams` IS WHICH OF THE DECLARATION'S PARAMETERS TAKE A BARE TYPE PARAMETER, AND IT RIDES
// HERE FOR `takesReceiver`'S REASON** — a fourth fact about the SAME declaration, applied by
// `ProgramSignatures.record` in the same act. It is what lets a CALL SITE build the range guard a shared
// generic body cannot hold for itself (`OpaqueParamInfo`), and it can only come from the sweep: the callee
// may be declared in another file, and `resolveTypes` has erased the parameter's alias long before any
// caller asks. It DEFAULTS to `sharedNoOpaqueParams` for the synthesized helpers named above and for every
// declaration outside a generic type, which is the overwhelming majority.
// ⭐⭐ **`paramNames`/`paramTypes` ARE THE DECLARATION'S OWN SOURCE PARAMETER LIST — THE RECEIVER EXCLUDED —
// AND THEY RIDE HERE FOR `opaqueParams`' REASON: a fifth fact about the SAME declaration, applied by
// `ProgramSignatures.record` in the same act.** They are what lets a CALL SITE tell one member of an overload
// set from another while its own file is being parsed, which is the one moment a call's result type is
// decided and a whole pass before `SemanticCheck.resolveOverloadedCalls` picks a member. See
// `ProgramSignatures.overloadedDeclsOf`. Both default EMPTY for the synthesized helpers named above — a
// synthesized helper is never overloaded, so there is nothing to tell apart.
export type FuncReturnTypeEntry
	export let name as ByteArray
	export let returnType as MaxonReturnType
	export let declaredSurface as DeclaredSurface
	export var visibility as Visibility
	export let takesReceiver as bool
	export let opaqueParams as OpaqueParamInfo
	export let paramNames as NameRoster
	export let paramTypes as MaxonTypeArray
	export let paramSpellings as NameRoster
	export let paramDefaults as ParamPositionMask

	// The bare NAME the `returns` clause wrote, when it wrote one — `DenseColumn` for
	// `returns DenseColumn`, and `none` for `returns Array with Integer`, for a primitive, or for no
	// return clause at all. It is the CALL RESULT's BRAND: two generic aliases over one instance share the
	// gid a call hands back, so only this can say which alias the callee's signature named.
	//
	// ⚠ **IT IS THE TOKEN'S TEXT AND NOTHING IS ASKED ABOUT IT HERE.** Whether the name IS a generic
	// alias is a whole-program question, and this entry is built during the declaration SWEEP that
	// answers it. The consumer asks, at parse time, with the index complete.
	export var returnAliasName as ReturnAliasSpelling
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export let enclosingTypeName as ByteArray

	// ⚠ **THE THREE EMPTY DEFAULTS ARE FRESH, NOT SHARED ANCHORS.** A default naming a module-level `let`
	// makes that anchor an export nothing calls, which `checkUnusedExports` reports as E3092. An empty
	// container costs a record; the anchor costs a build.
	export static function create(name ByteArray, returnType MaxonReturnType, declaredSurface DeclaredSurface, visibility Visibility, takesReceiver bool = false, opaqueParams OpaqueParamInfo = sharedNoOpaqueParams, paramNames NameRoster = NameRoster.create(), paramTypes MaxonTypeArray = MaxonTypeArray.create(), paramSpellings NameRoster = NameRoster.create(), paramDefaults ParamPositionMask = NoParamPositions, returnAliasName ReturnAliasSpelling = ReturnAliasSpelling.none, nameLine LineNumber = 0, nameColumn ColumnNumber = 0, enclosingTypeName ByteArray = EmptySourceText) returns FuncReturnTypeEntry
		return Self{name: name, returnType: returnType, declaredSurface: declaredSurface, visibility: visibility, takesReceiver: takesReceiver, opaqueParams: opaqueParams, paramNames: paramNames, paramTypes: paramTypes, paramSpellings: paramSpellings, paramDefaults: paramDefaults, returnAliasName: returnAliasName, nameLine: nameLine, nameColumn: nameColumn, enclosingTypeName: enclosingTypeName}
	end 'create'
end 'FuncReturnTypeEntry'

export typealias FuncReturnTypeEntryArray = Array with FuncReturnTypeEntry

// One `funcSignatures` registry contribution: a function's name paired with its
// parameter signature (names + types) and its return type, which travel together so the
// declaration kept for a name supplies both. Recorded by the parser. Ordered in an array (not
// a map) so the merge order is the declaration order. Carries the NAME's source position so
// `commitFuncSignatures` can anchor a duplicate-definition diagnostic (E3006) on the blamed
// declaration.
export type FuncSignatureEntry
	export let name as ByteArray
	export var signature as FuncSignature
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export var sourceFilePath as FilePath

	// ⭐⭐ **DID THE COMPILER MINT THIS FUNCTION, OR DID THE AUTHOR WRITE IT? — the bit
	// `commitFuncSignatures` needs to keep a duplicate diagnostic on a name the author can grep for.**
	// A default value is compiled as a synthesized nullary function named after the declaration that owns it
	// (`Project.paramDefaultHelperName`), so two of THEM colliding is never a fact of its own: the join is
	// injective, so one helper name means one owner registration name and one parameter position — and two
	// declarations claiming one registration name is the duplicate `commitFuncSignatures` reports, in the same
	// run, at a position the author wrote. The FIELD door's mint is injective for the same reason over
	// `(type name, field name)`, so two of ITS helpers colliding means two `type` declarations of one name,
	// and the duplicate `type` and its duplicate factory are both reported. STATED here rather than decoded
	// from the name's `__` prefix at the
	// merge, for the reason this file keeps: a minted name is a thing to be RECORDED, never a thing to be
	// read back apart.
	export let synthesized as bool
	export var role as FunctionDeclarationRole
	export var returnType as MaxonReturnType

	export static function create(name ByteArray, signature FuncSignature, returnType MaxonReturnType, nameLine LineNumber, nameColumn ColumnNumber, sourceFilePath FilePath, synthesized bool, role FunctionDeclarationRole) returns FuncSignatureEntry
		return Self{name: name, signature: signature, nameLine: nameLine, nameColumn: nameColumn, sourceFilePath: sourceFilePath, synthesized: synthesized, role: role, returnType: returnType}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.name)
		self.signature.cacheWrite(writer)
		writer.unsigned(self.nameLine as CacheUnsigned)
		writer.unsigned(self.nameColumn as CacheUnsigned)
		writer.text(self.sourceFilePath.toString())
		writer.flag(self.synthesized)
		writer.unsigned(self.role.ordinal as CacheUnsigned)
		cacheWriteMaxonReturnType(writer, value: self.returnType)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FuncSignatureEntry throws LibraryCacheDamage
		let f_name = try reader.bytes()
		let f_signature = try FuncSignature.cacheRead(reader)
		let f_nameLine = (try reader.unsigned()) as LineNumber
		let f_nameColumn = (try reader.unsigned()) as ColumnNumber
		let f_sourceFilePath = try reader.path()
		let f_synthesized = try reader.flag()
		let f_role = try cacheReadFunctionDeclarationRole(reader)
		let f_returnType = try cacheReadMaxonReturnType(reader)

		return Self{name: f_name, signature: f_signature, nameLine: f_nameLine, nameColumn: f_nameColumn, sourceFilePath: f_sourceFilePath, synthesized: f_synthesized, role: f_role, returnType: f_returnType}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize64
		return sizeof(FuncSignatureEntry) as CacheSize64
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FuncSignatureEntry'

export typealias FuncSignatureEntryArray = Array with FuncSignatureEntry

// @generated library-cache begin
function cacheWriteFuncSignatureEntryArray(writer LibraryCacheWriter, value FuncSignatureEntryArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteFuncSignatureEntryArray'

function cacheReadFuncSignatureEntryArray(reader LibraryCacheReader) returns FuncSignatureEntryArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = FuncSignatureEntryArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try FuncSignatureEntry.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadFuncSignatureEntryArray'

// @generated library-cache end

export enum FunctionDeclarationRole
	ordinary
	contestedFreeFunction
end 'FunctionDeclarationRole'

// @generated library-cache begin
let CacheCasesFunctionDeclarationRole = [FunctionDeclarationRole.ordinary, FunctionDeclarationRole.contestedFreeFunction]

function cacheReadFunctionDeclarationRole(reader LibraryCacheReader) returns FunctionDeclarationRole throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesFunctionDeclarationRole.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadFunctionDeclarationRole'

function cacheTableAgreesFunctionDeclarationRole() returns bool
	let declared = FunctionDeclarationRole.allCases

	if CacheCasesFunctionDeclarationRole.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesFunctionDeclarationRole.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesFunctionDeclarationRole'

module function cacheEnumTablesAgreeInCompilerParseStaging() returns bool
	if not cacheTableAgreesFunctionDeclarationRole() 'disagreesCacheTableAgreesFunctionDeclarationRole'
		return false
	end 'disagreesCacheTableAgreesFunctionDeclarationRole'

	return true
end 'cacheEnumTablesAgreeInCompilerParseStaging'

