// ParseStaging — `FileParseArtifact` and the deterministic `mergeArtifact` fold.
//
// This is the load-bearing parallel-ready seam of the frontend. The parser writes
// ONLY into a per-file `FileParseArtifact` — its own MaxonModule fragment, its own
// local type-name interner, and a recorded key+value bundle for every registry it
// would touch — so a file's parse is a pure function of its tokens with no shared
// state. `mergeArtifact` is then the SINGLE writer of the shared `Project`,
// folding artifacts in fixed source-path order so the result is deterministic
// regardless of the order files were parsed.
//
// A registry contribution is an ordered entry ARRAY rather than a map, which keeps
// it insertion-ordered so the merge is byte-deterministic.

// ⭐ **THE SHARED EMPTY contribution arrays.** An artifact that records NONE of a family — a file with
// no `interface`/`implements` declaration, and (see below) any artifact that never records a type name
// at all — points its field at one of these shared, never-mutated singletons rather than allocating an
// empty array it will never push into. The matching `record*` copies on write at the first push
// (`count() == 0` uniquely identifies "still the shared empty", since each of those functions is its
// array's only writer). This is the same pay-for-use discipline `sharedEmptyWhereConstraints`/`emptyTypeParams`
// follow, and it keeps the artifact allocation-neutral for a program that declares none.
//
// ⚠ **`typeNameDecls` IS HERE FOR A STRONGER REASON THAN "OFTEN EMPTY" — TWO OF THE THREE `Parser`
// CONSTRUCTION SITES CAN NEVER FILL IT.** Only `recordTypeName`, reached from `dispatchTopLevel`, ever
// pushes one, and `dispatchTopLevel` runs on the REAL parse alone: the tolerant declaration sweep
// (`foldDeclaredSignaturesInto`, one `Parser` per file) walks tokens on its own and `walkConstInitializer`
// (one `Parser` per top-level constant) evaluates an expression. Eagerly creating the array in
// `FileParseArtifact.create` would bill one allocation to EVERY sweep and EVERY constant for a structure
// with no writer.
let sharedEmptyInterfaces = IrInterfaceArray.create()
let sharedEmptyConformances = ConformanceDeclArray.create()

// A `<Type> from "…"` construction is rare — and, like `typeNameDecls`, it has the stronger reason:
// only the REAL parse can build one, so the tolerant declaration sweep and every top-level constant's
// transient `Parser` would otherwise each pay for an array with no writer.
let sharedEmptyLiteralInitSites = LiteralInitSiteArray.create()

// An instantiation the compiler INFERRED from a bracketed literal is rarer still, and shares both
// reasons above: only the REAL parse reaches a literal body, and the overwhelming file writes none.
let sharedEmptyInferredInstantiationSites = GenericInstantiationSiteArray.create()
let sharedEmptyTypeNameDecls = TypeNameDeclArray.create()
let sharedEmptyFunctionTypeDoors = PendingFunctionTypeDoorArray.create()

// A statement that uses NONE of a call's result is rarer than either — one spelling opens the door
// (`(_, _) = f()`) and almost no file writes it — so the empty column is shared for the reason above it.
let sharedEmptyDiscardedResults = PendingDiscardedResultArray.create()

// A coverage point is minted only under `--coverage`, so EVERY artifact of an ordinary build shares this
// one — the strongest form of the reason above, since the writer is gated on a build flag rather than on
// a rare spelling.
let sharedEmptyCovPoints = CovPointArray.create()

// Only a real parse mints instance rows, so every other artifact shares this, and a merge replaces it rather
// than writing into it.
let sharedNoInstanceIds = GenericInstanceIdArray.create()

export typealias FileParseArtifactArray = Array with FileParseArtifact

export typealias SourceByteCount = int(0 to u32.max)

// Calibrated so no file of this tree regrows its table;
// `tests/cli/interner-presize-never-regrows.maxtest` fails when one does.
let MinimumInternedTypeNames = 128 as NameId
let SourceBytesPerTypeName = 512
let ArenaBytesPerTypeName = 20

// The table is sized once, from the only figure available before a name is interned. A miss costs a
// regrowth and never a refusal, so the bias is high.
export function internedNameHintFor(sourceBytes SourceByteCount) returns NameId
	let estimate = sourceBytes / SourceBytesPerTypeName
	return MinimumInternedTypeNames if estimate < MinimumInternedTypeNames else estimate
end 'internedNameHintFor'

export function internedArenaHintFor(nameHint NameId) returns NameByteCount
	return nameHint * ArenaBytesPerTypeName
end 'internedArenaHintFor'

// ⭐ **WHAT A `Parser` IS BUILT FROM, AS VALUES RATHER THAN A `Project`** — every per-file fact the caller derived from
// the project (`Queries.parseJobFor`), so a parse on a pool worker needs nothing the main thread owns.
export type ParseJob
	export let path as FilePath
	export let namespace as String
	export let isStdlibSource as bool
	export let isRuntimeSource as bool
	export let declaresCompilerInternalNames as bool
	export let compilerMintedNames as ByteArrayArray
	export let livesUnderStdlibDirectory as bool
	export let buildsBodies as bool
	export let capturesDebugLocals as bool
	export let instrumentsCoverage as bool
	export let foldsAConstantInitializer as bool

	export static function create(path FilePath, namespace String, isStdlibSource bool, isRuntimeSource bool, declaresCompilerInternalNames bool, compilerMintedNames ByteArrayArray, livesUnderStdlibDirectory bool, buildsBodies bool, capturesDebugLocals bool, instrumentsCoverage bool) returns ParseJob
		return Self{path: path, namespace: namespace, isStdlibSource: isStdlibSource, isRuntimeSource: isRuntimeSource, declaresCompilerInternalNames: declaresCompilerInternalNames, compilerMintedNames: compilerMintedNames, livesUnderStdlibDirectory: livesUnderStdlibDirectory, buildsBodies: buildsBodies, capturesDebugLocals: capturesDebugLocals, instrumentsCoverage: instrumentsCoverage, foldsAConstantInitializer: false}
	end 'create'

	// ⭐ **THE JOB OF A TOP-LEVEL CONSTANT'S INITIALIZER** (`ProgramSignatures.walkConstInitializer`), and every flag in it
	// is exact rather than a default, because an initializer is const-FOLDED and declares no name:
	//   • `isStdlibSource` governs only a `typealias` declaration, which an initializer cannot contain;
	//   • `declaresCompilerInternalNames` and `compilerMintedNames` admit a reserved DECLARATION or call, and the
	//     declaration whose initializer this is has been through the real parse's check — generated source declares
	//     no top-level binding at all;
	//   • `livesUnderStdlibDirectory` gates two `module`-visible `String` METHODS, and a fold reaches no method dispatch;
	//   • `instrumentsCoverage` would mint a counter in ops no emitted image holds.
	// So the walk never asks the project for a path, which would put a `Directory.currentPath()` probe on the
	// per-declaration path.
	export static function forConstantInitializer(path FilePath, namespace String) returns ParseJob
		return Self{path: path, namespace: namespace, isStdlibSource: false, isRuntimeSource: false, declaresCompilerInternalNames: false, compilerMintedNames: ByteArrayArray.create(), livesUnderStdlibDirectory: false, buildsBodies: true, capturesDebugLocals: false, instrumentsCoverage: false, foldsAConstantInitializer: true}
	end 'forConstantInitializer'
end 'ParseJob'

// What one file's parse answers: its artifact, or the refusal with the blame it carries and what an aborted parse
// still knows (`Parser.abortedParseArtifact`).
export union FileParseOutcome
	parsed(artifact FileParseArtifact)
	failed(error SourceParseError, blame LibraryBlame, salvaged FileParseArtifact)
end 'FileParseOutcome'

// ⭐⭐ **ONE FILE'S PARSE, AS A FUNCTION OF WHAT IT IS HANDED** — the job, the file's tokens, the row-set answers it
// is told and the settled index, which it leaves as it found them. It reaches no `Project` and no module `var`, so
// a pool worker holding a private index may run it (E3143); the caller reports the outcome. Its parser's anchors
// are its own, so the artifact holds no record from outside itself.
export function parseFile(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable, signatures ProgramSignatures) returns FileParseOutcome
	var parser = Parser.create(tokens, job: job, signatures: signatures, anchors: ParserAnchors.create())
	signatures.openParseBand(overrides)

	// A refusal and its blame may hold records the index owns (a `throws` clause's name, a recorded constant's
	// error, an instantiation's file), and the outcome crosses back from a pool worker, so it carries copies.
	let artifact = try parser.parseModule() otherwise (parseErr) 'parseFail'
		_ = signatures.closeParseBand(job.path)
		return FileParseOutcome.failed(parseErr.clone(), blame: parser.libraryBlame.clone(), salvaged: parser.abortedParseArtifact())
	end 'parseFail'

	artifact.recordParseMints(signatures.closeParseBand(job.path))
	return FileParseOutcome.parsed(artifact)
end 'parseFile'

// What a real parse wrote into the signature index — `none` for an artifact no real parse produced: the
// declaration sweep's, a top-level constant's, and an aborted parse's.
export union ParseMints
	none
	minted(mints LocalInstanceMints)
end 'ParseMints'

// @generated library-cache begin
function cacheWriteParseMints(writer LibraryCacheWriter, value ParseMints)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		none then break 'payload'
		minted(a0) then cacheWriteParseMintsMinted(writer, a0: a0)
	end 'payload'
end 'cacheWriteParseMints'

function cacheWriteParseMintsMinted(writer LibraryCacheWriter, a0 LocalInstanceMints)
	a0.cacheWrite(writer)
end 'cacheWriteParseMintsMinted'

function cacheReadParseMints(reader LibraryCacheReader) returns ParseMints throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives ParseMints.none
		1 gives try cacheReadParseMintsMinted(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadParseMints'

function cacheReadParseMintsMinted(reader LibraryCacheReader) returns ParseMints throws LibraryCacheDamage
	let a0 = try LocalInstanceMints.cacheRead(reader)

	return ParseMints.minted(a0)
end 'cacheReadParseMintsMinted'

// @generated library-cache end

// One function's name and declared return type, recorded by the declaration sweep and applied by
// `ProgramSignatures.record`.
//
// ⭐ **`declaredSurface` IS THE PRE-ERASURE `__ManagedMemory` SPELLING OF THAT RETURN TYPE** —
// where the source named the alias, which `parseTypeReference` folds into `genericInstance(Array with Byte)`
// before a `MaxonReturnType` exists. It rides THIS record rather than a column of its own for one reason:
// the two facts must never disagree about the same declaration, and they cannot when they are written,
// remapped and folded as one entry. `ProgramSignatures.record` applies them together, with identical
// last-wins semantics, so the surface is exactly as accurate as the return type it accompanies —
// including for an overload set, where the sweep publishes ONE answer per bare name for both.
// ⭐⭐ **`visibility` IS THE DECLARATION'S OWN TIER, AND IT RIDES HERE FOR `declaredSurface`'S REASON** — it
// is a second fact about the SAME declaration, applied by `ProgramSignatures.record` beside the declaring
// file it already receives, so the tier and the file a visibility question needs are written together and
// cannot come to describe two declarations.
//
// ⭐⭐ **`takesReceiver` IS WHETHER THE DECLARATION CARRIES A HIDDEN `self`, AND IT RIDES HERE FOR
// `visibility`'S REASON** — a third fact about the SAME declaration, applied by `ProgramSignatures.record`
// in the same act. It is what makes a bare sibling call inside an `extension` body resolvable at all: the
// conformer's own methods are declared in another declaration and possibly another file, so no token walk
// can reach them, and knowing one EXISTS is not enough to call it — a `static` handed a receiver fails an
// arity check on a parameter nobody wrote, and an instance method denied one is called on nothing.
//
// The two SYNTHESIZED helpers the sweep publishes (a parameter default's, a field default's) take the
// receiverless default and mean it: each is a plain function the emitter calls with no instance.
// ⭐⭐ **`opaqueParams` IS WHICH OF THE DECLARATION'S PARAMETERS TAKE A BARE TYPE PARAMETER, AND IT RIDES
// HERE FOR `takesReceiver`'S REASON** — a fourth fact about the SAME declaration, applied by
// `ProgramSignatures.record` in the same act. It is what lets a CALL SITE build the range guard a shared
// generic body cannot hold for itself (`OpaqueParamInfo`), and it can only come from the sweep: the callee
// may be declared in another file, and `resolveTypes` has erased the parameter's alias long before any
// caller asks. It DEFAULTS to `sharedNoOpaqueParams` for the synthesized helpers named above and for every
// declaration outside a generic type, which is the overwhelming majority.
// ⭐⭐ **`paramNames`/`paramTypes` ARE THE DECLARATION'S OWN SOURCE PARAMETER LIST — THE RECEIVER EXCLUDED —
// AND THEY RIDE HERE FOR `opaqueParams`' REASON: a fifth fact about the SAME declaration, applied by
// `ProgramSignatures.record` in the same act.** They are what lets a CALL SITE tell one member of an overload
// set from another while its own file is being parsed, which is the one moment a call's result type is
// decided and a whole pass before `SemanticCheck.resolveOverloadedCalls` picks a member. See
// `ProgramSignatures.overloadedDeclsOf`. Both default EMPTY for the synthesized helpers named above — a
// synthesized helper is never overloaded, so there is nothing to tell apart.
export type FuncReturnTypeEntry
	export var name as ByteArray
	export var returnType as MaxonReturnType
	export var declaredSurface as DeclaredSurface
	export var visibility as Visibility
	export var takesReceiver as bool
	export var opaqueParams as OpaqueParamInfo
	export var paramNames as ByteArrayArray
	export var paramTypes as MaxonTypeArray

	// The bare NAME the `returns` clause wrote, when it wrote one — `DenseColumn` for
	// `returns DenseColumn`, and `none` for `returns Array with Integer`, for a primitive, or for no
	// return clause at all. It is the CALL RESULT's BRAND: two generic aliases over one instance share the
	// gid a call hands back, so only this can say which alias the callee's signature named.
	//
	// ⚠ **IT IS THE TOKEN'S TEXT AND NOTHING IS ASKED ABOUT IT HERE.** Whether the name IS a generic
	// alias is a whole-program question, and this entry is built during the declaration SWEEP that
	// answers it. The consumer asks, at parse time, with the index complete.
	export var returnAliasName as ReturnAliasSpelling
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber

	// ⚠ **THE THREE EMPTY DEFAULTS ARE FRESH, NOT SHARED ANCHORS.** A default naming a module-level `let`
	// makes that anchor an export nothing calls, which `checkUnusedExports` reports as E3092. An empty
	// container costs a record; the anchor costs a build.
	export static function create(name ByteArray, returnType MaxonReturnType, declaredSurface DeclaredSurface, visibility Visibility, takesReceiver bool = false, opaqueParams OpaqueParamInfo = sharedNoOpaqueParams, paramNames ByteArrayArray = ByteArrayArray.create(), paramTypes MaxonTypeArray = MaxonTypeArray.create(), returnAliasName ReturnAliasSpelling = ReturnAliasSpelling.none, nameLine LineNumber = 0, nameColumn ColumnNumber = 0) returns FuncReturnTypeEntry
		return Self{name: name, returnType: returnType, declaredSurface: declaredSurface, visibility: visibility, takesReceiver: takesReceiver, opaqueParams: opaqueParams, paramNames: paramNames, paramTypes: paramTypes, returnAliasName: returnAliasName, nameLine: nameLine, nameColumn: nameColumn}
	end 'create'
end 'FuncReturnTypeEntry'

export typealias FuncReturnTypeEntryArray = Array with FuncReturnTypeEntry

// One `funcSignatures` registry contribution: a function's name paired with its
// parameter signature (names + types) and its return type, which travel together so the
// declaration kept for a name supplies both. Recorded by the parser. Ordered in an array (not
// a map) so the merge order is the declaration order. Carries the NAME's source position so
// `commitFuncSignatures` can anchor a duplicate-definition diagnostic (E3006) on the blamed
// declaration.
export type FuncSignatureEntry
	export var name as ByteArray
	export var signature as FuncSignature
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber
	export var sourceFilePath as FilePath

	// ⭐⭐ **DID THE COMPILER MINT THIS FUNCTION, OR DID THE AUTHOR WRITE IT? — the bit
	// `commitFuncSignatures` needs to keep a duplicate diagnostic on a name the author can grep for.**
	// A default value is compiled as a synthesized nullary function named after the declaration that owns it
	// (`Project.paramDefaultHelperName`), so two of THEM colliding is never a fact of its own: the join is
	// injective, so one helper name means one owner registration name and one parameter position — and two
	// declarations claiming one registration name is the duplicate `commitFuncSignatures` reports, in the same
	// run, at a position the author wrote. The FIELD door's mint is injective for the same reason over
	// `(type name, field name)`, so two of ITS helpers colliding means two `type` declarations of one name,
	// and the duplicate `type` and its duplicate factory are both reported. STATED here rather than decoded
	// from the name's `__` prefix at the
	// merge, for the reason this file keeps: a minted name is a thing to be RECORDED, never a thing to be
	// read back apart.
	export var synthesized as bool
	export var role as FunctionDeclarationRole
	export var returnType as MaxonReturnType

	export static function create(name ByteArray, signature FuncSignature, returnType MaxonReturnType, nameLine LineNumber, nameColumn ColumnNumber, sourceFilePath FilePath, synthesized bool, role FunctionDeclarationRole) returns FuncSignatureEntry
		return Self{name: name, signature: signature, nameLine: nameLine, nameColumn: nameColumn, sourceFilePath: sourceFilePath, synthesized: synthesized, role: role, returnType: returnType}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.name)
		self.signature.cacheWrite(writer)
		writer.unsigned(self.nameLine as CacheUnsigned)
		writer.unsigned(self.nameColumn as CacheUnsigned)
		writer.text(self.sourceFilePath.toString())
		writer.flag(self.synthesized)
		writer.unsigned(self.role.ordinal as CacheUnsigned)
		cacheWriteMaxonReturnType(writer, value: self.returnType)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FuncSignatureEntry throws LibraryCacheDamage
		let f_name = try reader.bytes()
		let f_signature = try FuncSignature.cacheRead(reader)
		let f_nameLine = (try reader.unsigned()) as LineNumber
		let f_nameColumn = (try reader.unsigned()) as ColumnNumber
		let f_sourceFilePath = try reader.path()
		let f_synthesized = try reader.flag()
		let f_role = try cacheReadFunctionDeclarationRole(reader)
		let f_returnType = try cacheReadMaxonReturnType(reader)

		return Self{name: f_name, signature: f_signature, nameLine: f_nameLine, nameColumn: f_nameColumn, sourceFilePath: f_sourceFilePath, synthesized: f_synthesized, role: f_role, returnType: f_returnType}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize64
		return sizeof(FuncSignatureEntry) as CacheSize64
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FuncSignatureEntry'

export typealias FuncSignatureEntryArray = Array with FuncSignatureEntry

// @generated library-cache begin
function cacheWriteFuncSignatureEntryArray(writer LibraryCacheWriter, value FuncSignatureEntryArray)
