		holdEnd(result, held, callee, args, kind) then return MaxonOp.holdEnd(result, held: held, callee: callee, args: args, kind: kind)
		default panic("artifactOwnedHold: reached with an op that is not a hold marker — `artifactOwnedOp` routes only `holdValue` and `holdEnd` here")
	end 'hold'
end 'artifactOwnedHold'

