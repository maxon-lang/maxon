// ⭐⭐ **COUNT AT MERGE, INDEX AT LOWERING** — the two halves of a coverage point's identity, split here
// because neither end can hold both. The parse is per-file and memoized, so it can only number within its
// own file; `GlobalDataTable.layOut` sizes the counter image before the lowering runs, so the whole-program
// COUNT has to be final by the end of this fold. Appending the file's points and recording where they
// landed is that count, and the base is what `lowerMaxonToStd` adds to each op's file-local id.
//
// ⛔ **NO OP PAYLOAD IS REWRITTEN HERE**, which is what keeps the per-file parse memo valid across a build
// whose file set or file order changed.
//
// A file with no points still records its base, so a lookup miss is an invariant break rather than an
// ordinary "this file was not instrumented".
function commitCovPoints(project Project, artifact FileParseArtifact)
	project.covPointBases.upsert(artifact.filePath.toString(), value: project.covPoints.count())

	for point in artifact.covPoints 'each'
		_ = project.covPoints.append(point)
	end 'each'
end 'commitCovPoints'

// Fold this file's two DEFERRED name diagnostics into the project's own lists. They are appended
// rather than reported, because their whole point is to be reported LATER and in a fixed order — see
// `DeferredNameDiagnostic` for why, and `TypeResolution.reportDeferredNameDiagnostics` for the drain.
function commitDeferredNameDiagnostics(project Project, artifact FileParseArtifact)
	match artifact.unusedTypeAliases 'unused'
		unwritten then break
		entries(recorded) then pushEachDeferredDiagnostic(project.unusedTypeAliasDiagnostics, recorded: recorded)
	end 'unused'

	match artifact.hiddenTypeNames 'hidden'
		unwritten then break
		entries(recorded) then project.hiddenTypeNameDiagnostics.append(recorded)
	end 'hidden'

	for declared in artifact.hiddenTypeDeclarations 'eachDeclared'
		project.hiddenTypeNameReports.note(String.from(declared), readerFilePath: artifact.filePath)
	end 'eachDeclared'
end 'commitDeferredNameDiagnostics'

// The cross-file half of E3062: a generic-instance alias may be written only in files other than the
// one declaring it, which the per-file check cannot see.
// `ProgramSignatures.fileMeansTheSoleGenericAliasDeclaration` owns when a spelling credits a
// declaration.
function commitWrittenGenericAliasNames(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	match artifact.usedTypeNames 'written'
		unwritten then break
		entries(names) then noteWrittenGenericAliasNames(project, names: names, signatures: signatures, spellingFilePath: artifact.filePath)
	end 'written'
end 'commitWrittenGenericAliasNames'

function noteWrittenGenericAliasNames(project Project, names UsedTypeNameSet, signatures ProgramSignatures, spellingFilePath FilePath)
	for name in names 'eachName'
		if not signatures.fileMeansTheSoleGenericAliasDeclaration(name, readerFilePath: spellingFilePath) 'creditsNoOneDeclaration'
			continue
		end 'creditsNoOneDeclaration'

		insertOwnedName(project.genericAliasNamesWrittenByAFile, name: name)
	end 'eachName'
end 'noteWrittenGenericAliasNames'

// Append one recorded list to a whole-program one — its own function because a `match` arm may not open a
// `for`, and a walk that deferred nothing never reaches it.
function pushEachDeferredDiagnostic(into DeferredNameDiagnosticArray, recorded DeferredNameDiagnosticArray)
	var target = into

	for entry in recorded 'each'
		target.push(entry)
	end 'each'
end 'pushEachDeferredDiagnostic'

// Fold this file's parser-raised diagnostics into `project.diagnostics` — the last
// contribution, and the one that carries no ids to remap (a `Diagnostic` is a finished
// (code, message, position) record). `reportDiagnostic` is the single project sink, so a
// parser-recorded diagnostic and a `SemanticCheck`-recorded one are indistinguishable downstream. Its
// secondary findings go onto the secondary roster instead.
function commitDiagnostics(project Project, artifact FileParseArtifact)
	reportOwnRefusals(project, artifact: artifact)
	reportRecordedDiagnostics(project, artifact: artifact)

	for diagnostic in artifact.secondaryDiagnostics 'eachSecondary'
		fileSecondaryFinding(project, diagnostic: diagnostic)
	end 'eachSecondary'
end 'commitDiagnostics'

// A recorded diagnostic of any other kind leaves its declaration's facts standing, so it poisons
// nothing: a poisoned declaration would hide the independent errors on it.
function diagnosticLosesDeclarationFacts(code ErrorCode) returns bool
	return code == ErrorCode.unknownType or code == ErrorCode.genericFloatTypeArg or code == ErrorCode.genericBarePrimitiveArg or code == ErrorCode.genericArityMismatch or code == ErrorCode.genericBaseNotGeneric or code == ErrorCode.fixedArraySizeMalformed or code == ErrorCode.duplicateDefinition or code == ErrorCode.parserUnsupportedFeature or code == ErrorCode.conformanceWithArgSurplus
end 'diagnosticLosesDeclarationFacts'

module function noteFactsLostTo(project Project, diagnostic Diagnostic)
	if not diagnosticLosesDeclarationFacts(diagnostic.code) 'nothingIsLost'
		return
	end 'nothingIsLost'

	match diagnostic.anchor 'anchor'
		at(filePath, line, _) then noteMemberRefusedAt(project, filePath: filePath, line: line, backing: PoisonBacking.backed)
		programWide or
		file then break
	end 'anchor'
end 'noteFactsLostTo'

function noteMemberRefusedAt(project Project, filePath FilePath, line LineNumber, backing PoisonBacking)
	view heads = try queryDeclarationHeads(project, path: filePath) otherwise return
	project.poison.noteRefusedMemberAt(filePath, line: line, heads: heads, backing: backing)
end 'noteMemberRefusedAt'

module function noteDeclarationLostTo(project Project, filePath FilePath, poisoned PoisonedAt, backing PoisonBacking)
	match poisoned 'site'
		abandonedBody(number) then noteBodyAbandonedAt(project, filePath: filePath, line: number, backing: backing)
		line(number) then noteDeclarationRefusedAt(project, filePath: filePath, line: number, backing: backing)
	end 'site'
end 'noteDeclarationLostTo'

function noteDeclarationRefusedAt(project Project, filePath FilePath, line LineNumber, backing PoisonBacking)
	view heads = try queryDeclarationHeads(project, path: filePath) otherwise return
	project.poison.noteRefusedDeclarationAt(filePath, line: line, heads: heads, backing: backing)
end 'noteDeclarationRefusedAt'

function noteBodyAbandonedAt(project Project, filePath FilePath, line LineNumber, backing PoisonBacking)
	view heads = try queryDeclarationHeads(project, path: filePath) otherwise return
	project.poison.noteAbandonedBodyAt(filePath, line: line, heads: heads, backing: backing)
end 'noteBodyAbandonedAt'

// ⭐ **COMMIT EVERY TYPE-NAME DECLARATION, AND REPORT A NAME DECLARED TWICE.** The whole-program
// duplicate check for the TYPE namespace, exactly as `commitFuncSignatures` is for functions and for
// the same reason it lives at the merge rather than in the parser: a file-local check cannot see a
// second file, and the parser must stay pure. The rule itself is stated on `TypeNameRegistry`; this
// function only chooses the CODE and writes the text.
//
// ⚠ **WHICH CODE IS A PROPERTY OF THE PAIR, NOT OF THIS SITE.** E3061 says "two typealiases in scope
// declare the same name", so it is right exactly when BOTH declarations are typealiases.
// Everything else is E3006, the code a name declared twice already carries for a function and for a
// top-level `let`/`var` (`specs/static-variables.md`, where the kind of keyword is likewise
// irrelevant).
//
// Both arms blame the newcomer — its own file, its own name token — and name the incumbent's KEYWORD,
// which is the half that is invisible from the line being reported. The
// incumbent's PATH is deliberately not in the text: a second absolute path inside a message is
// machine-dependent and unmatchable in a `maxoncstderr` block.
function commitTypeNameDecls(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	reportTypeNameCollisions(project, collisions: project.typeNameDecls.recordAll(artifact.typeNameDecls, roster: project.shadowRoster, directories: signatures.settledDeclarations().fileModuleDirectories))
end 'commitTypeNameDecls'

// Type-name collision is not transitive — d1's `enum Box` collides with d2's, d2's collides with an alias
// `Box` in d2, yet d1's enum and d2's alias coexist — so which declarations are admitted depends on the
// order they are committed. Committing the file whose path identity sorts earliest first makes that order,
// and so the blame, the same on every host and for every spelling of the invocation. `entry.position`
// indexes `artifacts` because `parseEveryFile` returns one artifact per source path, in source-path order.
module function commitTypeNameDeclsInPathOrder(project Project, artifacts FileParseArtifactArray, pathOrder SourceFileInPathOrderArray, signatures ProgramSignatures)
	for entry in pathOrder 'eachInPathOrder'
		let artifact = try artifacts.get(entry.position) otherwise panic("commitTypeNameDeclsInPathOrder: artifacts.get OOB at {entry.position} below count {artifacts.count()}")
		commitTypeNameDecls(project, artifact: artifact, signatures: signatures)
	end 'eachInPathOrder'
end 'commitTypeNameDeclsInPathOrder'

typealias TypeNameDeclsByFile = Map with (String, TypeNameDeclArray)

module function nominalNameCollisionsOf(decls TypeNameDeclArray, paths FilePathArray, directories ModuleDirectoryByFile) returns TypeNameCollisionArray
	var collisions = TypeNameCollisionArray.create(0)

	if decls.isEmpty() 'nothingDeclared'
		return collisions
	end 'nothingDeclared'

	var byFile = TypeNameDeclsByFile.create()

	for decl in decls 'eachDecl'
		let file = decl.claim.declFilePath.toString()
		var declared = try byFile.get(file) otherwise TypeNameDeclArray.create(0)
		declared.push(decl)
		byFile.upsert(file, value: declared)
	end 'eachDecl'

	var registry = TypeNameRegistry.create()

	for entry in sourceFilesInPathOrder(paths) 'eachInPathOrder'
		let path = try paths.get(entry.position) otherwise panic("nominalNameCollisionsOf: paths.get OOB at {entry.position} below count {paths.count()}")
		var declared = (try byFile.get(path.toString()) otherwise continue).clone()
		declared.sortBy(function(left TypeNameDecl, right TypeNameDecl) gives compareTypeNameDecls(left, right: right))

		for collision in registry.recordAll(declared, roster: ShadowSpellingRoster.none(), directories: directories) 'eachCollisionHere'
			if isTypeAliasDecl(collision.decl.claim.kind) or isTypeAliasDecl(collision.winner.claim.kind) 'anAliasIsInvolved'
				continue
			end 'anAliasIsInvolved'

			collisions.push(collision)
		end 'eachCollisionHere'
	end 'eachInPathOrder'

	return collisions
end 'nominalNameCollisionsOf'

module function reportTypeNameCollisions(project Project, collisions TypeNameCollisionArray)
	for collision in collisions 'eachCollision'
		reportTypeNameCollision(project, decl: collision.decl, winner: collision.winner)
	end 'eachCollision'
end 'reportTypeNameCollisions'

module function sourceFilesInPathOrder(paths FilePathArray) returns SourceFileInPathOrderArray
	var ordered = SourceFileInPathOrderArray.create(paths.count(), zeroed: false)
	let workingDirectory = Directory.currentPath()

	for (iter, path) in paths.withIterator() 'eachSourcePath'
		ordered.push(SourceFileInPathOrder.create(pathIdentity(path, workingDirectory: workingDirectory), position: iter.index()))
	end 'eachSourcePath'

	ordered.sortBy(function(left SourceFileInPathOrder, right SourceFileInPathOrder) gives compareBytesOrdinally(left.identity, right: right.identity))
	return ordered
end 'sourceFilesInPathOrder'

module type SourceFileInPathOrder
	export let identity as ByteArray
	export let position as ElementIndex

	static function create(identity ByteArray, position ElementIndex) returns SourceFileInPathOrder
		return Self{identity: identity, position: position}
	end 'create'
end 'SourceFileInPathOrder'

module typealias SourceFileInPathOrderArray = Array with SourceFileInPathOrder

// The two texts a collision can have, kept together because the CHOICE between them is the thing
// worth reading in one place.
function reportTypeNameCollision(project Project, decl TypeNameDecl, winner TypeNameDecl)
	// ⭐ **A NAME REPORTED HERE IS NOT ALSO REPORTED AS UNUSED.** Both declarations of a
	// `typealias Score` declared twice in one file are genuinely unused, so the drain would add two
	// E3062s on top of the one E3061 that actually explains the file — three diagnostics for one
	// mistake, and the two extra pointing at the wrong thing. An explicit set is what suppresses them: the
	// unused check runs at the parse and this one at the merge, so nothing structural separates the two.
	//
	// ⚠ **KEYED PER DECLARING FILE, and that is not caution — a bare name would suppress the wrong
	// file's diagnostic.** Two files of different directories may each legally declare a `typealias Byte`
	// (see `TypeNameRegistry`), so one file declaring it twice would poison the name project-wide and
	// silently swallow another file's genuinely-unused `Byte`.
	project.collidedTypeNames.insert(fileScopedDeclKey(decl.name, declFilePath: decl.claim.declFilePath))

	if isTypeAliasDecl(decl.claim.kind) and isTypeAliasDecl(winner.claim.kind) 'bothAreTypeAliases'
		reportPositioned(project, code: ErrorCode.semanticDuplicateTypeAlias, message: "Duplicate typealias '{String.from(decl.name)}'", line: decl.nameLine, column: decl.nameColumn, filePath: decl.claim.declFilePath)
		return
	end 'bothAreTypeAliases'

	reportPositioned(project, code: ErrorCode.duplicateDefinition, message: duplicateDefinitionMessage(String.from(project.shadowRoster.authorBareSpellingOf(decl.name)), incumbentKeyword: typeDeclKeyword(winner.claim.kind)), line: decl.nameLine, column: decl.nameColumn, filePath: decl.claim.declFilePath)
end 'reportTypeNameCollision'

// --- The COMPILED half of the same namespace: one emitted type name, one INSTANTIATION ---

// The compiled type names claimed so far by the instantiation walk, each holding the instance that
// claimed it FIRST — the incumbent a later instantiation of the same compiled name is reported
// against. Built only by `checkTypeSymbolNamespace`, and only for a program that instantiates a generic.
typealias CompiledTypeNameClaimMap = Map with (ByteArray, GenericInstanceId)

// Where a colliding instantiation was WRITTEN. A top-level `typealias X = Base with Args` records one
// (`ProgramSignatures.instantiationSites`); a NESTED instantiation and the compiler-synthesized array
// instances are interned without one.
union InstantiationAnchor
	anchored(site GenericInstantiationSite)
	unanchored
end 'InstantiationAnchor'

// ⭐⭐ **THE COMPILED TYPE-NAME NAMESPACE — one emitted name, one instantiation.** A generic
// instantiation has no source name, so the compiler builds one (`mangleGenericInstance` joins the base
// name to each argument's — `Box with String` ⇒ `Box_String`), and EVERY per-type symbol the backend
// emits is derived from that string — `__destruct_<name>`, `__layout_<name>`. Two instantiations that
// build the SAME string mint one symbol twice and the later install wins, silently, because `_` is a
// legal name character and the join is therefore NOT injective — `Pair with (Box_Int, Str)` and
// `Pair with (Box, Int_Str)` both compile to `Pair_Box_Int_Str`.
//
// ⚠ **THE OTHER HALF OF THAT COLLISION — a DECLARED `type Box_String` claiming the same string — IS NOT
// CHECKED HERE, BECAUSE IT CANNOT HAPPEN.** `mangleGenericInstance` mints a contested name behind the
// reserved `__` prefix instead, which no declaration may take (E2051), so the declared and compiled
// halves are disjoint by construction. Reporting it would reject a legal `type Array_Foo` in a program
// that merely writes an `[Foo…]` array literal — which interns `Array with Foo` — naming an
// instantiation that appears nowhere in its source. This pair check is the half a prefix cannot cure —
// there is no declaration to move out of the way.
//
// ⚠ **DECIDED HERE, IN THE FRONT END, AND NOT WHERE THE SYMBOL IS MINTED.** The mangling is consumed by
// the backend, but the NAMESPACE is a source-level fact and a collision must land on the `typealias` the
// author wrote. A diagnostic raised at symbol-emission time has no user span to land on and would blame
// a file the author never opened.
//
// Called once per compile from `compileToCodeResult`, after `queryProgramSignatures` has interned every
// instantiation — the same placement, and for the same reason, as `checkWhereConstraints`.
export function checkTypeSymbolNamespace(project Project, signatures ProgramSignatures)
	if project.poison.typeUniverseIsUnreadable() 'theUniverseIsUnreadable'
		return
	end 'theUniverseIsUnreadable'

	let instantiationCount = signatures.genericInstanceCount()

	// A program that instantiates no generic claims no compiled name and can contest nothing. That is
	// the whole generics-free corpus, and it leaves here having allocated nothing whatever.
	if instantiationCount == 0 'noInstantiations'
		return
	end 'noInstantiations'

	// Walked in gid order, which is intern order and therefore source-path order over the sweep — so
	// which instantiation of a colliding pair is the NEWCOMER is a property of the program rather than
	// of a map's iteration.
	var claimed = CompiledTypeNameClaimMap.create()
	var contested = ContestedTypeNameMap.create()

	for gid in 0 upto instantiationCount 'eachInstantiation'
		if instanceNamesATypeFromAFailedFile(project, signatures: signatures, gid: gid) 'aTypeOfAFileThatFailedToParse'
			continue
		end 'aTypeOfAFileThatFailedToParse'

		view compiled = signatures.mangleGenericInstance(gid)

		// A rejected newcomer is deliberately NOT recorded: the incumbent stays the one every later
		// instantiation is measured against, which is `TypeNameRegistry`'s own rule (a rejected
		// declaration never displaces) applied to the compiled half.
		if let first = try claimed.get(compiled) 'earlierInstantiation'
			var members = try contested.get(compiled) otherwise GenericInstanceIdArray.create(0)

			if members.isEmpty() 'firstCollision'
				members.push(first)
			end 'firstCollision'

			members.push(gid)
			contested.upsert(compiled, value: members)
			continue
		end 'earlierInstantiation'

		claimed.upsert(compiled, value: gid)
	end 'eachInstantiation'

	reportContestedTypeNames(project, signatures: signatures, contested: contested)
end 'checkTypeSymbolNamespace'

typealias ContestedTypeNameMap = Map with (ByteArray, GenericInstanceIdArray)

typealias InstantiationClaimArray = Array with InstantiationClaim

union InstantiationPlace
	written(position DeclarationPosition)
	unwritten

	function isWritten() returns bool
		return match self 'place'
			written gives true
			unwritten gives false
		end 'place'
	end 'isWritten'

	function writtenPosition() returns DeclarationPosition throws AbsentError
		match self 'place'
			written(position) then return position
			unwritten then throw AbsentError.absent
		end 'place'
	end 'writtenPosition'
end 'InstantiationPlace'

type InstantiationClaim
	export let gid as GenericInstanceId
	let place as InstantiationPlace
	let rendered as ByteArray

	static function of(project Project, signatures ProgramSignatures, gid GenericInstanceId) returns InstantiationClaim
		let rendered = renderInstantiation(signatures, gid: gid).toByteArray()

		match earliestInstantiationSite(project, signatures: signatures, gid: gid) 'anchor'
			anchored(site) then return Self{gid: gid, place: InstantiationPlace.written(DeclarationPosition.of(project.emissionRanks, path: site.filePath, line: site.nameLine, column: site.nameColumn, kind: "the instantiation", name: rendered)), rendered: rendered}
			unanchored then return Self{gid: gid, place: InstantiationPlace.unwritten, rendered: rendered}
		end 'anchor'
	end 'of'

	function compare(other InstantiationClaim) returns Ordering
		let mine = try self.place.writtenPosition() otherwise 'mineIsUnwritten'
			return Ordering.greaterThan if other.place.isWritten() else compareBytesOrdinally(other.rendered, right: self.rendered)
		end 'mineIsUnwritten'

		let theirs = try other.place.writtenPosition() otherwise 'theirsIsUnwritten'
			return Ordering.lessThan
		end 'theirsIsUnwritten'

		let byPosition = mine.compare(theirs)

		if byPosition != Ordering.equalTo 'positionsDiffer'
			return byPosition
		end 'positionsDiffer'

		return compareBytesOrdinally(other.rendered, right: self.rendered)
	end 'compare'
end 'InstantiationClaim'

function reportContestedTypeNames(project Project, signatures ProgramSignatures, contested ContestedTypeNameMap)
	var names = NameRoster.create(contested.count(), zeroed: false)

	for (compiled, _) in contested 'eachContestedName'
		names.push(compiled)
	end 'eachContestedName'

	names.sortBy(function(left ByteArray, right ByteArray) gives compareBytesOrdinally(left, right: right))

	for compiled in names 'eachInOrder'
		let members = try contested.get(compiled) otherwise panic("reportContestedTypeNames: '{String.from(compiled)}' was filed contested by the walk that built this map")
		var claims = InstantiationClaimArray.create(members.count(), zeroed: false)

		for gid in members 'eachMember'
			claims.push(InstantiationClaim.of(project, signatures: signatures, gid: gid))
		end 'eachMember'

		claims.sortBy(function(left InstantiationClaim, right InstantiationClaim) gives left.compare(right))
		let incumbent = try claims.get(0) otherwise panic("reportContestedTypeNames: '{String.from(compiled)}' is contested by fewer than two instantiations")

		for position in 1 upto claims.count() 'eachNewcomer'
			let newcomer = try claims.get(position) otherwise panic("reportContestedTypeNames: claims.get OOB at {position}")
			reportInstantiationPairCollision(project, signatures: signatures, compiled: compiled, incumbent: incumbent.gid, newcomer: newcomer.gid)
		end 'eachNewcomer'
	end 'eachInOrder'
end 'reportContestedTypeNames'

// ⭐ **A GENERIC ALIAS WHOSE TYPE ARGUMENTS LEAD BACK TO IT IS REFUSED (E2012, or E3091 when no path is
// provable).** `typealias A = Box with A`, and the mutual `A = Box with B` / `B = Box with A`, describe
// INFINITE types: no finite layout and no finite compiled name.
//
// Blamed at the DECLARATION rather than at a use, because the declaration is the ill-formed thing and a
// cycle is ill-formed whether or not anyone instantiates it. Run BEFORE the pipeline (so before
// `semanticCheck`), which is also what guarantees no later reader has to survive a cycle.
export function checkGenericAliasCycles(project Project, signatures ProgramSignatures)
	if project.poison.typeUniverseIsUnreadable() 'theUniverseIsUnreadable'
		return
	end 'theUniverseIsUnreadable'

	match signatures.firstCyclicAliasDecl() 'cycle'
		none then return
		at(index) then reportGenericAliasCycle(project, entry: signatures.genericAliasDeclAt(index), path: signatures.aliasCyclePath(index))
	end 'cycle'
end 'checkGenericAliasCycles'

// ⭐⭐ **REPORT THE CYCLE — E2012 WITH THE DEPENDENCY PATH, WHICH IS `specs/type-checking.md`'s OWN SENTENCE.**
// `Circular typealias dependency: A -> B -> A` names every alias the loop passes through, and that path is
// the whole reason the canonical corpus carries two cases: a message naming only the alias it was reported
// against says identical words for `typealias A = Array with A` and for the mutual pair, so the mutual case
// would stop testing mutuality.
//
// ⚠ **A SELF-CYCLE IS BLAMED AT THE OCCURRENCE AND A LONGER ONE AT THE DECLARATION, and that is a difference
// in what is at fault rather than an inconsistency.** When an alias names ITSELF, one word in one RHS is the
// defect and the author can point at it — the canonical spec pins column 26 of `typealias A = Array with A`,
// the second `A` (`GenericAliasEntry.selfRefLine` is how that position survives the parse). When the loop
// runs through OTHER aliases, no single occurrence is wrong: each RHS is individually well-formed and what
// is ill-formed is the SET, so the blame lands on the declaration the cycle is reported against — column 11,
// the alias name — and the PATH is what names the rest.
//
// ⚠ **AN EMPTY PATH IS THE OTHER DOOR, NOT A MISSING PATH.** `firstCyclicAliasDecl` also answers for a
// CROSS-FILE cycle the instance graph structurally cannot see, caught instead by the contest fixpoint failing
// to converge. Nothing there proves a cycle or names its members, so it keeps E3091 and the sentence that
// says what IS known — which `typealias-file-scope.md`'s own prose ratifies (*"the non-convergence IS the
// detection"*). The code and the words follow from what the compiler can prove.
//
// A SYNTHESIZED alias carries no anchor (`unanchored`), so it falls back to the whole-program form
// `reportInstantiationPairCollision` uses for the same reason — pointing into a file the user never wrote
// would be worse than not pointing at all.
function reportGenericAliasCycle(project Project, entry GenericAliasEntry, path NameRoster)
	if path.isEmpty() 'noCycleTheGraphCanProve'
		reportUnsettledAliasResolution(project, entry: entry)
		return
	end 'noCycleTheGraphCanProve'

	let namesOnlyItself = path.count() == 1
	let message = "Circular typealias dependency: {renderAliasCyclePath(path)}"

	match entry.anchor 'anchor'
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.programWide(ErrorCode.parserCircularDependency, message: message))
		declaredAt(nameLine, nameColumn, selfRefLine, selfRefColumn) then reportPositioned(project, code: ErrorCode.parserCircularDependency, message: message, line: selfRefLine if namesOnlyItself else nameLine, column: selfRefColumn if namesOnlyItself else nameColumn, filePath: entry.filePath)
	end 'anchor'
end 'reportGenericAliasCycle'

// `A` for a one-node cycle, `A -> B -> A` for a longer one. The single name is not a TRUNCATED path: an alias
// that names itself has no intermediate to show, and `A -> A` would repeat the one fact the name already
// carries. `specs/type-checking.md` pins both spellings, one case each.
function renderAliasCyclePath(path NameRoster) returns String
	let first = String.from(try path.get(0) otherwise panic("renderAliasCyclePath: an empty path is the other door and is filtered by the caller"))

	if path.count() == 1 'namesOnlyItself'
		return first
	end 'namesOnlyItself'

	var rendered = "{first}"

	for i in 1 upto path.count() 'eachFurtherAlias'
		rendered = "{rendered} -> {String.from(try path.get(i) otherwise panic("renderAliasCyclePath: path.get({i}) below its own count()"))}"
	end 'eachFurtherAlias'

	return "{rendered} -> {first}"
end 'renderAliasCyclePath'

// The CROSS-FILE door's diagnostic (E3091): resolution of this alias never settled, and the walk that would
// name the loop cannot see it. It says what is known and no more — there is no path to quote, which is the
// difference the caller's header states.
function reportUnsettledAliasResolution(project Project, entry GenericAliasEntry)
	let message = "typealias '{String.from(entry.aliasName)}' forms a type cycle: its type arguments refer back to '{String.from(entry.aliasName)}'"

	match entry.anchor 'anchor'
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.programWide(ErrorCode.semanticTypeResolutionCycle, message: message))
		declaredAt(nameLine, nameColumn, _, _) then reportPositioned(project, code: ErrorCode.semanticTypeResolutionCycle, message: message, line: nameLine, column: nameColumn, filePath: entry.filePath)
	end 'anchor'
end 'reportUnsettledAliasResolution'

// Two instantiations that compile to one name — the shape no declaration takes part in, which the
// join's non-injectivity makes possible on its own.
function reportInstantiationPairCollision(project Project, signatures ProgramSignatures, compiled ByteArray, incumbent GenericInstanceId, newcomer GenericInstanceId)
	let message = "duplicate definition of '{String.from(compiled)}' — the generic instantiations `{renderInstantiation(signatures, gid: incumbent)}` and `{renderInstantiation(signatures, gid: newcomer)}` compile to that same name"

	match instantiationAnchor(project, signatures: signatures, newcomer: newcomer, incumbent: incumbent) 'anchor'
		anchored(site) then reportPositioned(project, code: ErrorCode.duplicateDefinition, message: message, line: site.nameLine, column: site.nameColumn, filePath: site.filePath)

		// No `typealias` names EITHER instantiation, so both are nested (`Box with (Pair with …)`) and
		// neither was interned with an anchor. Whole-program then — the anchorless form E3001 uses —
		// rather than pointing at an enclosing alias whose own instantiation is fine.
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.programWide(ErrorCode.duplicateDefinition, message: message))
	end 'anchor'
end 'reportInstantiationPairCollision'

// The site a pair collision is reported at: the NEWCOMER's `typealias` if one names it, else the
// INCUMBENT's, else none.
//
// ⚠ **A LINEAR SCAN OF THE SITE LIST, DELIBERATELY.** It is asked only once a collision has already
// been found — never on a program that compiles — so a gid⇒site index would cost every build to serve
// none. One pass answers both halves: a newcomer hit returns at once, and an incumbent hit is retained
// as the fallback.
function instantiationAnchor(project Project, signatures ProgramSignatures, newcomer GenericInstanceId, incumbent GenericInstanceId) returns InstantiationAnchor
	match earliestInstantiationSite(project, signatures: signatures, gid: newcomer) 'newcomerSite'
		anchored(site) then return InstantiationAnchor.anchored(site)
		unanchored then return earliestInstantiationSite(project, signatures: signatures, gid: incumbent)
	end 'newcomerSite'
end 'instantiationAnchor'

function earliestInstantiationSite(project Project, signatures ProgramSignatures, gid GenericInstanceId) returns InstantiationAnchor
	var earliest = InstantiationAnchor.unanchored
	var earliestPlace = InstantiationPlace.unwritten

	for site in signatures.instantiationSites() 'eachSite'
		if site.gid != gid 'namesAnother'
			continue
		end 'namesAnother'

		let position = DeclarationPosition.of(project.emissionRanks, path: site.filePath, line: site.nameLine, column: site.nameColumn, kind: "the instantiation", name: renderInstantiation(signatures, gid: gid).toByteArray())

		if let held = try earliestPlace.writtenPosition() 'aSiteIsHeld'
			if position.compare(held) != Ordering.lessThan 'notEarlier'
				continue
			end 'notEarlier'
		end 'aSiteIsHeld'

		earliest = InstantiationAnchor.anchored(site)
		earliestPlace = InstantiationPlace.written(position)
	end 'eachSite'

	return earliest
end 'earliestInstantiationSite'

// A colliding instantiation spelled back out the way its author wrote it — `Box with String`,
// `Pair with (Box_Int, Str)`. A single argument takes no parentheses and a list does, matching the
// source form (`specs/generic-types.md`).
//
// The arguments come through `instanceArgCompiledName` — the IDENTITY renderer and deliberately not the
// display one — so a NESTED instantiation appears in its own
// COMPILED spelling (`Box with Pair_Int_Bool`) rather than as `Box with (Pair with (Int, Bool))`. That
// is the right rendering and not a shortcut: the compiled spelling is what collided, and the source
// form would hide the very join the message is about.
function renderInstantiation(signatures ProgramSignatures, gid GenericInstanceId) returns String
	let argCount = signatures.genericInstanceArgCount(gid)
	var rendered = "{String.from(signatures.genericInstanceBaseName(gid))} with "

	if argCount > 1 'openArgumentList'
		rendered.append("(")
	end 'openArgumentList'

	for position in 0 upto argCount 'eachArgument'
		if position > 0 'afterFirst'
			rendered.append(", ")
		end 'afterFirst'

		rendered.append(signatures.genericInstanceArgWrittenMarker(gid, position: position))
		rendered.append(String.from(signatures.instanceArgCompiledName(gid, position: position)))
	end 'eachArgument'

	if argCount > 1 'closeArgumentList'
		rendered.append(")")
	end 'closeArgumentList'

	return rendered
end 'renderInstantiation'

// Commit the artifact's declared struct types into the project registry — the registry
// `TypeResolution.resolveNamedType` turns a `MaxonType.named` for a declared `type` into a
// `structRef` against.
//
// A plain upsert, and it stays one: a second `type` of the same name is refused by
// `commitTypeNameDecls`, which fails the build, so the overwrite is never observed.
//
// ⚠ **AND IT DOES NOT ASK `Project.declarationContestsACompilerOwnedName` WHILE `commitEnumTypes`
// DIRECTLY BELOW DOES — THE ASYMMETRY IS PROVED, NOT OVERLOOKED.** That rule drops a
// declaration of a compiler-owned type name from anyone but the corpus, and it belongs at a write a
// TOLERANT walk can reach: `ProgramSignatures.recordStruct` is fed by the declaration SWEEP, which folds
// a user's `type String` in before the real parse refuses it. This write is not that. Its two feeders are
// `Parser.parseTypeDeclaration`, which calls `requireTypeNameNotCompilerOwned` (E2015) BEFORE it mints
// the layout, and `Parser.internTupleLayout`, whose names are synthesized `__Tuple…` spellings that are
// compiler-owned under no reading — and an aborted parse contributes `typeNameDecls` alone
// (`Parser.abortedParseArtifact`), so a refused declaration cannot arrive here by the error path either.
// ⇒ **a contested layout cannot reach this loop**, and a drop written here would be unreachable rather
// than defensive. The enum twin's call is not the same shape: `upsertDeclaredEnum` is the ONE upsert both
// enum registries share, so the rule rides it once for the sweep's sake and this site inherits it.
function commitStructTypes(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	for layout in artifact.structTypes 'each'
		project.structTypes.upsert(layout.name, value: committedStructLayout(layout, signatures: signatures))
	end 'each'
end 'commitStructTypes'

// An inline record's packing is settled from this compile's widths onto a clone, because the
// layout is the parse artifact's. `MmRuntime.installStructRuntimeEntries` stamps the runtime's
// entries off `project.structTypes`, and left unsettled it answers a box's `sizeBytes()` for a
// type whose value is a word.
function committedStructLayout(layout StructLayout, signatures ProgramSignatures) returns StructLayout
	if not signatures.nameIsInlineRecord(layout.name) 'aHeapRecord'
		return layout
	end 'aHeapRecord'

	var settled = layout.clone()
	settled.settleInlinePacking(signatures.inlineBitWidthsOf(layout.name))
	return settled
end 'committedStructLayout'

function commitWrittenTupleTypes(project Project, artifact FileParseArtifact)
	for written in artifact.writtenTupleTypes 'each'
		project.writtenTupleTypes.push(written)
	end 'each'
end 'commitWrittenTupleTypes'

// Commit the artifact's declared enum/union types into the project registry — the registry
// `TypeResolution.resolveNamedType` reads to resolve a `MaxonType.named` naming a declared
// `enum`/`union` to `integer`. A plain upsert, matching `commitStructTypes` and unobservable on a
// collision for its reason.
function commitEnumTypes(project Project, artifact FileParseArtifact)
	for layout in artifact.enumTypes 'each'
		upsertDeclaredEnum(project.enumTypes, layout: layout, declaredByTheCorpus: artifact.livesUnderStdlibDirectory)
	end 'each'
end 'commitEnumTypes'

// Commit the artifact's declared `interface`s into the project registry — a plain
// upsert keyed by name, matching `commitEnumTypes` and unobservable on a collision for its reason.
function commitInterfaces(project Project, artifact FileParseArtifact)
	for iface in artifact.interfaces 'each'
		project.interfaces.entries.upsert(iface.name, value: iface)
	end 'each'
end 'commitInterfaces'

// Commit the artifact's `implements` conformance declarations into `project.conformances`. A PUSH,
// not an upsert: each is a distinct declaration site (its own type-name position),
// and `checkConformance` drains them all. `resetMergeTargets` clears the array so a warm rebuild does
// not double it (the same discipline `commitPendingFnMergeChecks` follows).
function commitConformances(project Project, artifact FileParseArtifact)
	for conformance in artifact.conformances 'each'
		project.conformances.push(conformance)
	end 'each'
end 'commitConformances'

// Commit the artifact's `<Type> from "…"` construction sites into `project.literalInitSites` — a PUSH,
// for `commitConformances`' reason: each is a distinct source position and
// `checkLiteralInitConformance` drains them all.
function commitLiteralInitSites(project Project, artifact FileParseArtifact)
	for site in artifact.literalInitSites 'each'
		project.literalInitSites.push(site)
	end 'each'
end 'commitLiteralInitSites'

// Commit the artifact's literal-inferred instantiation sites into `project.inferredInstantiationSites`
// — a PUSH, for `commitLiteralInitSites`' reason: two literals over one instance are two
// positions to report, and `checkWhereConstraints` drains them all.
//
// ⚠ **THE gid NEEDS NO FILE SCOPING, unlike the alias sites `rekeyScopedGenericAliases` rebuilds.** That
// re-keying exists because two files may declare the same alias NAME over different instances, so a site
// recorded during the sweep may name the wrong one. A literal has no alias name at all: its instance is
// interned from the column types the parser itself resolved in the reading file, so the gid it carries is
// already the one that file means.
function commitInferredInstantiationSites(project Project, artifact FileParseArtifact)
	for site in artifact.inferredInstantiationSites 'each'
		project.inferredInstantiationSites.push(site)
	end 'each'
end 'commitInferredInstantiationSites'

// Commit the artifact's range-check contributions into `project.rangeChecks` — a plain
// upsert keyed by function name, which is UNIQUE per program (the whole-program E3006 check runs
// in `commitFuncSignatures`), so no collision handling is needed. Read by `InsertRangeChecks`.
function commitRangeChecks(project Project, artifact FileParseArtifact)
	for entry in artifact.rangeChecks 'each'
		project.rangeChecks.upsert(entry.name, value: entry.checks)
	end 'each'
end 'commitRangeChecks'

function commitTypeAliases(project Project, artifact FileParseArtifact)
	for alias in artifact.typeAliases 'each'
		project.typeAliases.record(alias)
	end 'each'
end 'commitTypeAliases'

// Commit the artifact's FUNCTION typealiases into the project registry — the twin of
// `commitTypeAliases`, remap-free (a function alias carries no interner ids).
//
// A declaration of a SHAPE-CONTESTED name is committed under this file's mint alone — the key every scoped
// door hands on — and every other declaration under its bare name.
function commitFunctionTypeAliases(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	for alias in artifact.functionTypeAliases 'each'
		let scoped = signatures.functionAliasScopedName(alias.name, readerFilePath: alias.declFilePath)

		if scoped.equals(alias.name) 'noShapeContestHoldsTheName'
			project.functionTypeAliases.upsert(alias.name, value: alias)
		end 'noShapeContestHoldsTheName' else 'thisFilesOwnShapeAnswersUnderItsOwnKey'
			project.functionTypeAliases.upsert(scoped, value: alias.underName(scoped))
		end 'thisFilesOwnShapeAnswersUnderItsOwnKey'
	end 'each'
end 'commitFunctionTypeAliases'

// ⭐⭐ **MAKE EVERY TYPE ID THIS ARTIFACT HOLDS THE MERGED PROGRAM'S — NAMES ONCE, INSTANCES ON EVERY FOLD.**
//
// NAMES are this file's own interner's, folded into `project.typeNames` the first time the artifact is merged:
// `typeIdsAreProjectGlobal` says it happened, and it stays true because `Queries.resetMergeTargets` never resets
// that interner.
//
// INSTANCES are the rows this file's parse minted, re-adopted by every fold: the index is restored to its
// baseline before each fold, and after an edit elsewhere it is a different index altogether, so a row's id is
// whatever THIS merge's file order gives it. A file a fold keeps is re-adopted by
// `replayMergedArtifact`, which must land on the ids its merged ops already carry.
//
// ⚠ **A RENUMBERING IS APPLIED IN PLACE, AND ONE RECORD CAN BE REACHED TWICE** (a binding filed in several
// places), so a renumbering must not move an id it already moved. An instance renumbering is safe when no id it
// moves FROM is one it moves TO — true of the parse's band ids, which no merge assigns — and otherwise it is
// taken through the band in two walks. A name renumbering is applied once, and per binding at most once
// (`VarInfo.renumberedIn`).
function renumberArtifact(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	let adopted = adoptedInstanceIds(artifact, signatures: signatures)
	let names = TypeIdRemap.unmoved() if artifact.typeIdsAreProjectGlobal else project.typeNames.foldInto(artifact.typeNames)
	artifact.typeIdsAreProjectGlobal = true

	var moves = InstanceMoves.create()

	for position in 0 upto artifact.instanceIdsInUse.count() 'eachRow'
		let inUse = try artifact.instanceIdsInUse.get(position) otherwise panic("renumberArtifact: instanceIdsInUse.get OOB at {position}")
		let target = try adopted.get(position) otherwise panic("renumberArtifact: the merge adopted {adopted.count()} rows of an artifact holding {artifact.instanceIdsInUse.count()}")
		moves.add(inUse, target: target, scratch: BandInstanceIdBase + position)
	end 'eachRow'

	moves.applyTo(project, artifact: artifact, names: names)
	artifact.instanceIdsInUse = adopted
end 'renumberArtifact'

type InstanceMoves
	var direct as GenericInstanceIdMap
	var intoTheBand as GenericInstanceIdMap
	var outOfTheBand as GenericInstanceIdMap
	var targets as GenericInstanceIdSet

	static function create() returns InstanceMoves
		return Self{direct: GenericInstanceIdMap.create(), intoTheBand: GenericInstanceIdMap.create(), outOfTheBand: GenericInstanceIdMap.create(), targets: GenericInstanceIdSet.create()}
	end 'create'

	function add(inUse GenericInstanceId, target GenericInstanceId, scratch GenericInstanceId)
		if inUse != target 'moves'
			self.direct.upsert(inUse, value: target)
			self.intoTheBand.upsert(inUse, value: scratch)
			self.outOfTheBand.upsert(scratch, value: target)
			self.targets.insert(target)
		end 'moves'
	end 'add'

	function movesOntoAMovedId() returns bool
		for (source, _) in self.direct 'eachMove'
			if self.targets.contains(source) 'aSourceIsATarget'
				return true
			end 'aSourceIsATarget'
		end 'eachMove'

		return false
	end 'movesOntoAMovedId'

	function applyTo(project Project, artifact FileParseArtifact, names TypeIdRemap)
		if self.movesOntoAMovedId() 'throughTheBand'
			rewriteTypeIds(project, artifact: artifact, remap: TypeIdRemap.unmoved().movingInstances(self.intoTheBand))
			rewriteTypeIds(project, artifact: artifact, remap: names.movingInstances(self.outOfTheBand))
		end 'throughTheBand' else 'direct'
			rewriteTypeIds(project, artifact: artifact, remap: names.movingInstances(self.direct))
		end 'direct'
	end 'applyTo'
end 'InstanceMoves'

export function rebaseArtifact(project Project, artifact FileParseArtifact, rebase ParseRebase)
	var moves = InstanceMoves.create()
	var scratch = BandInstanceIdBase + (artifact.instanceIdsInUse.count() as GenericInstanceId)

	for (original, current) in rebase.instances 'eachBaselineRow'
		moves.add(original, target: current, scratch: scratch)
		scratch = scratch + 1
	end 'eachBaselineRow'

	moves.applyTo(project, artifact: artifact, names: TypeIdRemap.unmoved().movingInterfaces(rebase.interfaces.clone()))
end 'rebaseArtifact'

// The id each of the artifact's parse rows is adopted under by this merge — every artifact no real parse built
// has none.
function adoptedInstanceIds(artifact FileParseArtifact, signatures ProgramSignatures) returns GenericInstanceIdArray
	return match artifact.parseMints 'mints'
		none gives GenericInstanceIdArray.create(0)
		minted(mints) gives signatures.adoptParseMints(mints)
	end 'mints'
end 'adoptedInstanceIds'

// Rewrite every type id the artifact holds through `remap`. The list is every id-bearing place a parse fills,
// whether or not a pass after the merge reads it today: an id left stale is a wrong answer waiting for its first
// reader.
function rewriteTypeIds(project Project, artifact FileParseArtifact, remap TypeIdRemap)
	if not remap.movesAnything() 'nothingMoves'
		return
	end 'nothingMoves'

	project.lastRenumbering = project.lastRenumbering + 1
	let epoch = project.lastRenumbering

	for i in 0 upto artifact.module.functions.count() 'eachFunc'
		var func = try artifact.module.functions.get(i) otherwise panic("rewriteTypeIds: functions.get OOB at {i}")
		func.renumberTypeIds(remap, epoch: epoch)
	end 'eachFunc'

	for position in 0 upto artifact.module.ops.count() 'eachOp'
		var op = try artifact.module.ops.get(position) otherwise panic("rewriteTypeIds: ops.get OOB at {position}")
		try artifact.module.ops.set(position, value: renumberedOp(op, remap: remap)) otherwise panic("rewriteTypeIds: ops.set OOB at {position}")
	end 'eachOp'

	for j in 0 upto artifact.funcSignatures.count() 'eachSignatureEntry'
		var entry = try artifact.funcSignatures.get(j) otherwise panic("rewriteTypeIds: funcSignatures.get OOB at {j}")
		entry.signature.renumberTypeIds(remap)
		entry.returnType = remapMaxonReturnType(entry.returnType, remap: remap)
	end 'eachSignatureEntry'

	var aliases = FunctionTypeAliasArray.create(artifact.functionTypeAliases.count(), zeroed: false)

	for alias in artifact.functionTypeAliases 'eachFunctionAlias'
		aliases.push(alias.withInstancesRenumbered(remap))
	end 'eachFunctionAlias'

	artifact.functionTypeAliases = aliases

	var renumberedInterfaces = IrInterfaceArray.create(artifact.interfaces.count(), zeroed: false)

	for iface in artifact.interfaces 'eachInterface'
		renumberedInterfaces.push(iface.withInstancesRenumbered(remap))
	end 'eachInterface'

	artifact.interfaces = renumberedInterfaces

	var renumberedConformances = ConformanceDeclArray.create(artifact.conformances.count(), zeroed: false)

	for decl in artifact.conformances 'eachConformance'
		renumberedConformances.push(decl.withInstancesRenumbered(remap))
	end 'eachConformance'

	artifact.conformances = renumberedConformances

	for layout in artifact.structTypes 'eachStruct'
		remapStructLayoutFieldTypes(layout, remap: remap)
	end 'eachStruct'

	for layout in artifact.enumTypes 'eachEnum'
		remapEnumLayoutPayloadTypes(layout, remap: remap)
	end 'eachEnum'

	var sites = GenericInstantiationSiteArray.create(artifact.inferredInstantiationSites.count(), zeroed: false)

	for site in artifact.inferredInstantiationSites 'eachInferredSite'
		sites.push(GenericInstantiationSite.create(remap.applyInstance(site.gid), nameLine: site.nameLine, nameColumn: site.nameColumn, filePath: site.filePath))
	end 'eachInferredSite'

	artifact.inferredInstantiationSites = sites
end 'rewriteTypeIds'

export function footprintOf(project Project, artifact FileParseArtifact, signatures ProgramSignatures) returns ParseFootprint
	if artifact.typeIdsAreProjectGlobal 'alreadyMerged'
		panic("footprintOf: a stashed artifact already carries program-wide name ids — a parse is stashed before its merge, while every name id it holds is its own file's")
	end 'alreadyMerged'

	var moduleWatcher = TypeIdRemap.watching(FileLocalNamesBase)
	rewriteTypeIds(project, artifact: artifact, remap: moduleWatcher)

	var instances = GenericInstanceIdSet.create()
	var names = ObservedNameSet.create()
	var interfaces = ObservedInterfaceSet.create()
	absorbWatched(moduleWatcher, instances: instances, names: names, interfaces: interfaces)

	match artifact.parseMints 'mints'
		none then break
		minted(mints) then watchMints(mints, instances: instances, names: names, interfaces: interfaces)
	end 'mints'

	return signatures.footprintOf(instances, names: names, dispatchedInterfaces: interfaces)
end 'footprintOf'

function watchMints(mints LocalInstanceMints, instances GenericInstanceIdSet, names ObservedNameSet, interfaces ObservedInterfaceSet)
	var watcher = TypeIdRemap.watching(mints.typeNameBaseline)
	mints.watchedBy(watcher)
	absorbWatched(watcher, instances: instances, names: names, interfaces: interfaces)
end 'watchMints'

function absorbWatched(watcher TypeIdRemap, instances GenericInstanceIdSet, names ObservedNameSet, interfaces ObservedInterfaceSet)
	for id in watcher.seenInstances 'eachInstance'
		instances.insert(id)
	end 'eachInstance'

	for id in watcher.seenNames 'eachName'
		names.insert(id)
	end 'eachName'

	for index in watcher.seenInterfaces 'eachInterface'
		interfaces.insert(index)
	end 'eachInterface'
end 'absorbWatched'

// The op with the type it carries renumbered. Four variants carry a type and the two witness
// dispatches an interface declaration index; every other carries none.
function renumberedOp(op MaxonOp, remap TypeIdRemap) returns MaxonOp
	return match op 'op'
		literal(result, value, valueType) gives MaxonOp.literal(result, value: value, valueType: remapMaxonType(valueType, remap: remap))
		loadIndirect(result, addr, offset, valueType) gives MaxonOp.loadIndirect(result, addr: addr, offset: offset, valueType: remapMaxonType(valueType, remap: remap))
		storeIndirect(addr, offset, value, valueType) gives MaxonOp.storeIndirect(addr, offset: offset, value: value, valueType: remapMaxonType(valueType, remap: remap))
		sizeofType(result, targetType) gives MaxonOp.sizeofType(result, targetType: remapMaxonType(targetType, remap: remap))
		witnessDispatch(result, args, argImmutableNames, witness, methodIndex, interfaceDeclIndex, isVoid, isThrowing) gives MaxonOp.witnessDispatch(result, args: args, argImmutableNames: argImmutableNames, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: remap.applyInterface(interfaceDeclIndex), isVoid: isVoid, isThrowing: isThrowing)
		witnessTryDispatch(result, errorFlag, args, argImmutableNames, witness, methodIndex, interfaceDeclIndex, isVoid) gives MaxonOp.witnessTryDispatch(result, errorFlag: errorFlag, args: args, argImmutableNames: argImmutableNames, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: remap.applyInterface(interfaceDeclIndex), isVoid: isVoid)
		call or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		constArrayLiteral or
		switch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives op
	end 'op'
end 'renumberedOp'

// Commit the artifact's `funcSignatures` contributions into the project registry,
// detecting DUPLICATE FUNCTION DEFINITIONS. A name already in the registry — from an
// earlier file, or an earlier declaration in THIS file (both entries sit in this array in
// declaration order) — is a duplicate: a plain `upsert` would SILENTLY overwrite the first
// entry, and a call would then validate against (and lower to) the WRONG signature. So one
// declaration is kept and each other is reported at its own name (E3006);
// `newcomerDisplacesTheFloor` decides which. A name two directories declare is registered under each
// directory's own mint, so only a same-directory duplicate meets here; every function the parser builds
// records exactly one signature entry. `checkTopLevelNameScopes` is the cross-kind judge beside it.
function commitFuncSignatures(project Project, artifact FileParseArtifact)
	for entry in artifact.funcSignatures 'each'
		if project.funcSignatures.contains(entry.name) 'duplicate'
			project.poison.noteDuplicatedFunction(entry.name)

			// ⚠ **A SYNTHESIZED FUNCTION'S DUPLICATE IS THE SHADOW OF ONE THE AUTHOR CAN SEE, AND IS NOT
			// REPORTED TWICE.** See `FuncSignatureEntry.synthesized` for why the two always arrive
			// together. Reporting it would add, beside the correct duplicate, a second E3006 naming
			// `__fieldDefault#Bag#items` — a symbol absent from the source. The kept entry is still chosen
			// exactly as for a reported duplicate: the two paths differ in what they SAY, never in what the
			// registry holds.
			view blamed = blamedFunctionDeclaration(project, newcomer: entry)

			if not blamed.synthesized 'theAuthorWroteThisName'
				reportPositioned(project, code: ErrorCode.duplicateDefinition, message: duplicateFunctionMessage(blamed), line: blamed.nameLine, column: blamed.nameColumn, filePath: blamed.sourceFilePath)
			end 'theAuthorWroteThisName'

			continue
		end 'duplicate'

		holdFunctionFloor(project, entry: entry)
	end 'each'
end 'commitFuncSignatures'

// The merge's one writer of these three registries, so the kept declaration's signature and return type
// always come from the same declaration.
function holdFunctionFloor(project Project, entry FuncSignatureEntry)
	project.funcSignatures.upsert(entry.name, value: entry.signature)
	project.funcReturnTypes.upsert(entry.name, value: entry.returnType)
	project.funcSignatureFloors.upsert(entry.name, value: entry)
end 'holdFunctionFloor'

function blamedFunctionDeclaration(project Project, newcomer FuncSignatureEntry) returns FuncSignatureEntry
	var floor = try project.funcSignatureFloors.get(newcomer.name) otherwise panic("blamedFunctionDeclaration: '{String.from(newcomer.name)}' is in funcSignatures, and every name committed there has its floor committed beside it")

	if newcomerDisplacesTheFloor(project, newcomer: newcomer, floor: floor) 'theFloorIsBlamed'
		holdFunctionFloor(project, entry: newcomer)
		return floor
	end 'theFloorIsBlamed'

	return newcomer
end 'blamedFunctionDeclaration'

function newcomerDisplacesTheFloor(project Project, newcomer FuncSignatureEntry, floor FuncSignatureEntry) returns bool
	let newcomerIsTheLibrarys = isStdlibSourceFile(project, path: newcomer.sourceFilePath)

	if newcomerIsTheLibrarys != isStdlibSourceFile(project, path: floor.sourceFilePath) 'oneIsTheLibrarys'
		return newcomerIsTheLibrarys
	end 'oneIsTheLibrarys'

	return precedesInPathOrder(newcomer.sourceFilePath, other: floor.sourceFilePath)
end 'newcomerDisplacesTheFloor'

function duplicateFunctionMessage(blamed FuncSignatureEntry) returns String
	return duplicateDeclarationMessage(blamed.name)
end 'duplicateFunctionMessage'

// Append this file's recorded function-value merge checks to the whole-program list. Unlike
// the signature commit above there is NO dedup: each entry is a DISTINCT merge SITE (its own position),
// so every one is drained. Kept an array (not a map) for the same reason the `*Entry` families are —
// the drain order is the file/declaration order, deterministic and reviewable.
function commitPendingFnMergeChecks(project Project, artifact FileParseArtifact)
	for check in artifact.pendingFnMergeChecks 'each'
		project.pendingFnMergeChecks.push(check)
	end 'each'
end 'commitPendingFnMergeChecks'

// Append this file's recorded function-type doors to the whole-program list — the twin of the merge-check
// commit above, dedup-free for the same reason: each entry is a distinct SITE with its own position.
function commitPendingFunctionTypeDoors(project Project, artifact FileParseArtifact)
	for door in artifact.pendingFunctionTypeDoors 'each'
		project.pendingFunctionTypeDoors.push(door)
	end 'each'
end 'commitPendingFunctionTypeDoors'

function commitPendingBrandRecords(project Project, artifact FileParseArtifact, opOffset ElementIndex)
	for record in artifact.pendingBrandRecords 'each'
		project.pendingBrandRecords.push(record.relocated(opOffset))
	end 'each'
end 'commitPendingBrandRecords'

// ⚠ The debug-stream names are NOT interned here. The order names take their INDICES in must be the
// LOWERING's, which walks the merged module once; interning here would give them the merge's file order
// instead, and the two are the same only while every file is merged before any is lowered — a property of
// today's pipeline, not a rule.
function commitOpKeyedSites(project Project, artifact FileParseArtifact, opOffset ElementIndex)
	project.serviceAwaitSites.upsertRelocated(artifact.serviceAwaitSites, offset: opOffset)

	match artifact.registryUseSites 'registryUses'
		unwritten then break
		entries(byOp) then project.registryUseSites.upsertRelocated(byOp, offset: opOffset)
	end 'registryUses'

	project.asyncSpawnSites.upsertRelocated(artifact.asyncSpawnSites, offset: opOffset)
	project.allocTagSites.upsertRelocated(artifact.allocTagSites, offset: opOffset)
	project.closureRecordSites.insertRelocated(artifact.closureRecordSites, offset: opOffset)
	project.debugStreamNameSites.upsertRelocated(artifact.debugStreamNameSites, offset: opOffset)
	project.immortalConstArraySites.upsertRelocated(artifact.immortalConstArraySites, offset: opOffset)
	project.provenFixedArrayAccesses.upsertRelocated(artifact.provenFixedArrayAccesses, offset: opOffset)
end 'commitOpKeyedSites'

extension Map
	function upsertRelocated(source Self, offset Key)
		for (key, value) in source 'eachSite'
			self.upsert(key + offset, value: value)
		end 'eachSite'
	end 'upsertRelocated'
end 'Map'

extension Set
	function insertRelocated(source Self, offset Element)
		for site in source 'eachSite'
			self.insert(site + offset)
		end 'eachSite'
	end 'insertRelocated'
end 'Set'

// Append this file's recorded discarded-result sites to the whole-program list — the twin of the door and
// transform commits above, and dedup-free for their reason: each entry is a distinct SITE with its own position.
function commitPendingDiscardedResults(project Project, artifact FileParseArtifact, opOffset ElementIndex)
	for site in artifact.pendingDiscardedResults 'each'
		project.pendingDiscardedResults.push(site.relocated(opOffset))
	end 'each'
end 'commitPendingDiscardedResults'
