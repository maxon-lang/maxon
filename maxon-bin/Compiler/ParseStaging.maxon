// ParseStaging — `FileParseArtifact` and the deterministic `mergeArtifact` fold.
//
// This is the load-bearing parallel-ready seam of the frontend. The parser writes
// ONLY into a per-file `FileParseArtifact` — its own MaxonModule fragment, its own
// local type-name interner, and a recorded key+value bundle for every registry it
// would touch — so a file's parse is a pure function of its tokens with no shared
// state. `mergeArtifact` is then the SINGLE writer of the shared `Project`,
// folding artifacts in fixed source-path order so the result is deterministic
// regardless of the order files were parsed.
//
// A registry contribution is an ordered entry ARRAY rather than a map, which keeps
// it insertion-ordered so the merge is byte-deterministic.

export typealias FileParseArtifactArray = Array with FileParseArtifact

typealias RenderedDiagnosticSet = Set with String

export typealias SourceByteCount = int(0 to u32.max)

// Calibrated so no file of this tree regrows its table;
// `tests/cli/interner-presize-never-regrows.maxtest` fails when one does.
let MinimumInternedTypeNames = 128 as NameId
let SourceBytesPerTypeName = 512
let ArenaBytesPerTypeName = 20

// The table is sized once, from the only figure available before a name is interned. A miss costs a
// regrowth and never a refusal, so the bias is high.
export function internedNameHintFor(sourceBytes SourceByteCount) returns NameId
	let estimate = (sourceBytes / SourceBytesPerTypeName) as NameId
	return MinimumInternedTypeNames if estimate < MinimumInternedTypeNames else estimate
end 'internedNameHintFor'

export function internedArenaHintFor(nameHint NameId) returns NameByteCount
	return nameHint * ArenaBytesPerTypeName
end 'internedArenaHintFor'

// ⭐ **WHAT A `Parser` IS BUILT FROM, AS VALUES RATHER THAN A `Project`** — every per-file fact the caller derived from
// the project (`Queries.parseJobFor`), so a parse on a pool worker needs nothing the main thread owns.
export type ParseJob
	export let path as FilePath
	export let authoredPath as FilePath
	export let namespace as String

	// ⭐ **IS THE FILE BEING PARSED `stdlib/` OR `scriptlib/` SOURCE?** One bit, decided once per file
	// by the query that builds this job (`Queries`), because that is the only tier holding the
	// project. It is the LAYER a declaration belongs to, never a tier: it travels on every
	// `TypeNameClaim` so a user's declaration of a library name shadows it rather than meeting it, and it
	// keeps the library out of the E3062 candidate list (see `recordTypeName`).
	export let isStdlibSource as bool

	// ⭐⭐ **IS THE FILE BEING PARSED A `runtime/` SOURCE FILE?** The tier's own bit, decided once per file
	// by `Queries` — the only tier holding the project — and read by the three rules that hold nowhere
	// else: the `__Raw.*` call privilege (E3152 outside it), the managed-value refusal (E3153) and the
	// `public` refusal (E3154). `coverageActive` reads it beside `isStdlibSource` for a fourth reason —
	// not a tier privilege, but the library/author split both tiers sit on the same side of.
	//
	// ⚠ **IT IS NOT `declaresCompilerInternalNames`, THOUGH THAT ONE IS TRUE OF EVERY RUNTIME FILE TOO.**
	// That bit answers "may this file DECLARE into the reserved space", which `stdlib/Builtins.maxon` and
	// `stdlib/Testing.maxon` also may; these three rules are about being the RUNTIME, which neither of
	// those is. One slot carrying both claims is a semantic slot shared by two facts.
	export let isRuntimeSource as bool

	// Set together with `isStdlibSource`, whose library privileges a scriptlib file shares. It marks the
	// one place such a file is still the user's: a `__` name is the compiler's only where the shadow rename
	// wrote it (`everySpellingIsTheCompilers`).
	export let isScriptlibSource as bool

	// ⭐ **MAY THIS FILE DECLARE `__`-PREFIXED NAMES?** True for the
	// modules that DECLARE the reserved space rather than merely using it — `stdlib/Builtins.maxon`
	// (`__ManagedFileError`, `__int_fromString`) and `stdlib/Testing.maxon` (`__TestReport`) — which is what
	// each of their own headers calls itself. Decided once per file by `Queries`, the only tier holding the
	// project, and read by the one choke point every new declaration goes through (`requireUnreservedName`).
	// See `Queries.TestReportDeclaringModule` for why the set is a LIST of named modules and not the
	// set of modules the loader takes, nor "any `__` name no intrinsic claims".
	//
	// ⚠ **IT IS DELIBERATELY NOT `isStdlibSource`, AND THE TWO ANSWER DIFFERENT QUESTIONS.**
	// `isStdlibSource` decides VISIBILITY, and its root-inside-`stdlib/` arm hands a project rooted under
	// `stdlib/` its own files back as the USER's — correctly, for visibility. Reused here it would make
	// `maxon build stdlib/Builtins.maxon` — the command `StdlibLoader`'s collision rule prescribes for
	// compiling one stdlib module on its own — refuse the very module the loader is about to load.
	// Being the compiler's internal bridge is a property of the FILE, not of how a command line spelled it.
	export let declaresCompilerInternalNames as bool

	// ⭐⭐ **THE RESERVED NAMES THIS COMPILE MINTED INTO THIS FILE — the THIRD provenance the reserved-name
	// doors read (`Queries.compilerMintedNamesIn`).** Non-empty only for the generated Maxon source a
	// `maxon test` build stages; empty for every file of every other compile, which is what says the author
	// wrote every byte of it.
	//
	// ⚠ **THE TWO DOORS READ IT AT DIFFERENT GRAIN, AND THAT IS THE WHOLE POINT.** The CALL door asks
	// only whether the list is non-empty (`fileMayUseReservedNames`), because a generated fragment has
	// to reach names OTHER files declare and that door already conjoins `declaresCallee`. The
	// DECLARATION door asks whether the name being declared is IN the list (`requireUnreservedName`),
	// because a staged `.maxtest` file is the author's own bytes with a dispatcher appended — so a
	// per-file answer there would hand the author the reserved space.
	//
	// ⚠ **IT IS SEPARATE FROM `declaresCompilerInternalNames` EVEN THOUGH THE CALL DOOR TAKES THEIR
	// DISJUNCTION.** The two are different FACTS — "this is one of the two stdlib modules that declare the
	// reserved space" and "this compile wrote these names" — and folding them into one slot would be a
	// semantic slot shared by two claims, which is the shape this project's defect log keeps naming.
	export let compilerMintedNames as immutable NameRoster

	// ⭐ **IS THIS FILE PHYSICALLY INSIDE `stdlib/`?** True for every module the loader
	// takes AND for a module named directly on the command line (`maxon build stdlib/URL.maxon`),
	// because being under `stdlib/` is a property of the FILE. Read by `rawSurfaceIsRefusedHere` (the library
	// tier, E3185) and by the compiler-owned-name contest (`declarationContestsACompilerOwnedName`).
	//
	// ⭐ It is DERIVED, not probed: `isStdlibSource` already answers it except when the project ROOT is
	// itself under `stdlib/`, and that is a fact about the COMPILE, asked once
	// (`Queries.livesUnderStdlibDirectory`, which carries the proof and the ladder measurement).
	//
	// ⚠ **IT IS DELIBERATELY NOT `isStdlibSource`, FOR `declaresCompilerInternalNames`' REASON.**
	// Gated on the visibility bit, the refusal would tell
	// `maxon build stdlib/URL.maxon` that the file "is not stdlib source" — false about that path, and
	// it would break the one command that finds a module's blockers before it is listed. See
	// `Queries.livesUnderStdlibDirectory`.
	export let livesUnderStdlibDirectory as bool

	// Whether this parse builds ops for the file's function bodies. A user file always does; a stdlib
	// file does once a path from `main` reaches it (see `StdlibSource.growStdlibBodyDemand`). It prunes
	// ops and nothing else: every declaration is still read, because a declaration can move the emitted
	// code of a program that never names its module (`StdlibLoader`'s header), while an unreached body
	// is dropped by `lowerMaxonToStd` and `DeadFunctionElimination` regardless.
	export let buildsBodies as bool

	// Whether this build writes a `.mxdbg` sidecar (`Project.debugInfo`). A build that records no binding
	// pays nothing for the debug-locals roster, which is half of what keeps the emitted image
	// byte-identical with the sidecar and without it.
	export let capturesDebugLocals as bool

	// Whether this build instruments for code coverage (`Project.coverage`). The parse memo carries a salt
	// for it, so a warm tree cannot serve an uninstrumented parse to an instrumented build.
	export let instrumentsCoverage as bool
	export let initializerRole as InitializerRole

	export static function create(path FilePath, authoredPath FilePath, namespace String, isStdlibSource bool, isRuntimeSource bool, isScriptlibSource bool, declaresCompilerInternalNames bool, compilerMintedNames NameRoster, livesUnderStdlibDirectory bool, buildsBodies bool, capturesDebugLocals bool, instrumentsCoverage bool) returns ParseJob
		return Self{path: path, authoredPath: authoredPath, namespace: namespace, isStdlibSource: isStdlibSource, isRuntimeSource: isRuntimeSource, isScriptlibSource: isScriptlibSource, declaresCompilerInternalNames: declaresCompilerInternalNames, compilerMintedNames: compilerMintedNames, livesUnderStdlibDirectory: livesUnderStdlibDirectory, buildsBodies: buildsBodies, capturesDebugLocals: capturesDebugLocals, instrumentsCoverage: instrumentsCoverage, initializerRole: InitializerRole.ordinary}
	end 'create'

	// The job `ProgramSignatures` parses an initializer under, in the role it names: the declaring file's
	// own, so the initializer is judged by that file's privileges. Coverage and debug locals are cleared
	// because the fold's ops reach no emitted image. Derived from the stored job rather than from the
	// project, which would put a `Directory.currentPath()` probe on the per-declaration path.
	export function forInitializerRole(role InitializerRole) returns ParseJob
		return Self{path: self.path, authoredPath: self.authoredPath, namespace: self.namespace, isStdlibSource: self.isStdlibSource, isRuntimeSource: self.isRuntimeSource, isScriptlibSource: self.isScriptlibSource, declaresCompilerInternalNames: self.declaresCompilerInternalNames, compilerMintedNames: self.compilerMintedNames, livesUnderStdlibDirectory: self.livesUnderStdlibDirectory, buildsBodies: true, capturesDebugLocals: false, instrumentsCoverage: false, initializerRole: role}
	end 'forInitializerRole'

	export function readsAuthorSource() returns bool
		return not self.isStdlibSource and not self.isRuntimeSource
	end 'readsAuthorSource'
end 'ParseJob'

export enum InitializerRole
	ordinary
	sweepFold
	recordProbe
end 'InitializerRole'

export union ParseRefusal
	none
	refused(error SourceParseError, blame LibraryBlame, consequence ConsequenceOf)
end 'ParseRefusal'

// @generated library-cache begin
function cacheWriteParseRefusal(writer LibraryCacheWriter, value ParseRefusal)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		none then break
		refused(a0, a1, a2) then cacheWriteParseRefusalRefused(writer, a0: a0, a1: a1, a2: a2)
	end 'payload'
end 'cacheWriteParseRefusal'

function cacheWriteParseRefusalRefused(writer LibraryCacheWriter, a0 SourceParseError, a1 LibraryBlame, a2 ConsequenceOf)
	cacheWriteSourceParseError(writer, value: a0)
	cacheWriteLibraryBlame(writer, value: a1)
	cacheWriteConsequenceOf(writer, value: a2)
end 'cacheWriteParseRefusalRefused'

function cacheReadParseRefusal(reader LibraryCacheReader) returns ParseRefusal throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives ParseRefusal.none
		1 gives try cacheReadParseRefusalRefused(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadParseRefusal'

function cacheReadParseRefusalRefused(reader LibraryCacheReader) returns ParseRefusal throws LibraryCacheDamage
	let a0 = try cacheReadSourceParseError(reader)
	let a1 = try cacheReadLibraryBlame(reader)
	let a2 = try cacheReadConsequenceOf(reader)

	return ParseRefusal.refused(a0, blame: a1, consequence: a2)
end 'cacheReadParseRefusalRefused'

// @generated library-cache end

// What a parse refusal may be the consequence of. Anything but `unrelated` is held, and dropped
// once what it names explains it (`PendingConsequence.isExplainedBy`): a backed refusal of the name,
// or, for `genericArgumentCount`, a declared base that refuses the count.
export union ConsequenceOf
	unrelated
	subject(names NameRoster)
	handlerBody(message immutable ByteArray)
	unknownType(name immutable ByteArray)
	hiddenTypeName(name immutable ByteArray)
	genericArgumentCount(reported String)
end 'ConsequenceOf'

// @generated library-cache begin
function cacheWriteConsequenceOf(writer LibraryCacheWriter, value ConsequenceOf)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		unrelated then break
		subject(a0) then cacheWriteConsequenceOfSubject(writer, a0: a0)
		handlerBody(a0) then cacheWriteConsequenceOfHandlerBody(writer, a0: a0)
		unknownType(a0) then cacheWriteConsequenceOfUnknownType(writer, a0: a0)
		hiddenTypeName(a0) then cacheWriteConsequenceOfHiddenTypeName(writer, a0: a0)
		genericArgumentCount(a0) then cacheWriteConsequenceOfGenericArgumentCount(writer, a0: a0)
	end 'payload'
end 'cacheWriteConsequenceOf'

function cacheWriteConsequenceOfSubject(writer LibraryCacheWriter, a0 NameRoster)
	cacheWriteNameRoster(writer, value: a0)
end 'cacheWriteConsequenceOfSubject'

function cacheWriteConsequenceOfHandlerBody(writer LibraryCacheWriter, a0 immutable ByteArray)
	writer.bytes(a0)
end 'cacheWriteConsequenceOfHandlerBody'

function cacheWriteConsequenceOfUnknownType(writer LibraryCacheWriter, a0 immutable ByteArray)
	writer.bytes(a0)
end 'cacheWriteConsequenceOfUnknownType'

function cacheWriteConsequenceOfHiddenTypeName(writer LibraryCacheWriter, a0 immutable ByteArray)
	writer.bytes(a0)
end 'cacheWriteConsequenceOfHiddenTypeName'

function cacheWriteConsequenceOfGenericArgumentCount(writer LibraryCacheWriter, a0 String)
	writer.text(a0)
end 'cacheWriteConsequenceOfGenericArgumentCount'

function cacheReadConsequenceOf(reader LibraryCacheReader) returns ConsequenceOf throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives ConsequenceOf.unrelated
		1 gives try cacheReadConsequenceOfSubject(reader)
		2 gives try cacheReadConsequenceOfHandlerBody(reader)
		3 gives try cacheReadConsequenceOfUnknownType(reader)
		4 gives try cacheReadConsequenceOfHiddenTypeName(reader)
		5 gives try cacheReadConsequenceOfGenericArgumentCount(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadConsequenceOf'

function cacheReadConsequenceOfSubject(reader LibraryCacheReader) returns ConsequenceOf throws LibraryCacheDamage
	let a0 = try cacheReadNameRoster(reader)

	return ConsequenceOf.subject(a0)
end 'cacheReadConsequenceOfSubject'

function cacheReadConsequenceOfHandlerBody(reader LibraryCacheReader) returns ConsequenceOf throws LibraryCacheDamage
	let a0 = freeze try reader.bytes()

	return ConsequenceOf.handlerBody(a0)
end 'cacheReadConsequenceOfHandlerBody'

function cacheReadConsequenceOfUnknownType(reader LibraryCacheReader) returns ConsequenceOf throws LibraryCacheDamage
	let a0 = freeze try reader.bytes()

	return ConsequenceOf.unknownType(a0)
end 'cacheReadConsequenceOfUnknownType'

function cacheReadConsequenceOfHiddenTypeName(reader LibraryCacheReader) returns ConsequenceOf throws LibraryCacheDamage
	let a0 = freeze try reader.bytes()

	return ConsequenceOf.hiddenTypeName(a0)
end 'cacheReadConsequenceOfHiddenTypeName'

function cacheReadConsequenceOfGenericArgumentCount(reader LibraryCacheReader) returns ConsequenceOf throws LibraryCacheDamage
	let a0 = try reader.text()

	return ConsequenceOf.genericArgumentCount(a0)
end 'cacheReadConsequenceOfGenericArgumentCount'

// @generated library-cache end

export type AbandonedRegion
	export let error as SourceParseError
	export let blame as LibraryBlame
	export let key as PositionKey
	export let poisoned as PoisonedAt
	export let consequence as ConsequenceOf

	export static function create(error SourceParseError, blame LibraryBlame, part RefusedPart, consequence ConsequenceOf) returns AbandonedRegion
		return Self{error: error, blame: blame, key: part.key, poisoned: part.poisoned, consequence: consequence}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteSourceParseError(writer, value: self.error)
		cacheWriteLibraryBlame(writer, value: self.blame)
		writer.unsigned(self.key as CacheUnsigned)
		cacheWritePoisonedAt(writer, value: self.poisoned)
		cacheWriteConsequenceOf(writer, value: self.consequence)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns AbandonedRegion throws LibraryCacheDamage
		let f_error = try cacheReadSourceParseError(reader)
		let f_blame = try cacheReadLibraryBlame(reader)
		let f_key = (try reader.unsigned()) as PositionKey
		let f_poisoned = try cacheReadPoisonedAt(reader)
		let f_consequence = try cacheReadConsequenceOf(reader)

		return Self{error: f_error, blame: f_blame, key: f_key, poisoned: f_poisoned, consequence: f_consequence}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize40
		return sizeof(AbandonedRegion) as CacheSize40
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'AbandonedRegion'

export typealias AbandonedRegionArray = Array with AbandonedRegion

// @generated library-cache begin
function cacheWriteAbandonedRegionArray(writer LibraryCacheWriter, value AbandonedRegionArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteAbandonedRegionArray'

function cacheReadAbandonedRegionArray(reader LibraryCacheReader) returns AbandonedRegionArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = AbandonedRegionArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try AbandonedRegion.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadAbandonedRegionArray'

// @generated library-cache end

// ⭐⭐ **ONE FILE'S PARSE, AS A FUNCTION OF WHAT IT IS HANDED** — the job, the file's tokens, the
// row-set answers it is told and the settled index, which it leaves as it found them. It reaches no
// `Project`, so a pool worker may run it; the caller reports what the artifact refused. Its
// parser's anchors are its own, so the artifact holds no record from outside itself.
export function parseFile(job ParseJob, tokens TokenArray, overrides RowSetOverrideTable, signatures ProgramSignatures) returns FileParseArtifact
	var parser = Parser.create(tokens, job: job, signatures: signatures, anchors: ParserAnchors.create())
	signatures.openParseBand(overrides)

	// A refusal and its blame may hold records the index owns (a `throws` clause's name, a recorded constant's
	// error, an instantiation's file), and the artifact crosses back from a pool worker, so it carries copies.
	var artifact = try parser.parseModule() otherwise (parseErr) 'parseFail'
		_ = signatures.closeParseBand(job.path)
		parser.forgetKindVerdicts()
		return parser.abortedParseArtifact(ParseRefusal.refused(parseErr.clone(), blame: parser.libraryBlame.clone(), consequence: consequenceOfRefusal(parseErr, parser: parser, job: job, signatures: signatures)))
	end 'parseFail'

	artifact.recordParseMints(signatures.closeParseBand(job.path))
	parser.forgetKindVerdicts()
	return artifact
end 'parseFile'

module function abandonedRegionFor(error SourceParseError, blame LibraryBlame, openRegion AbandonableRegion, isLocal bool, path FilePath) returns AbandonedRegion throws AbsentError
	if not isLocal 'theFileCannotBeReadPastIt'
		throw AbsentError.absent
	end 'theFileCannotBeReadPastIt'

	let part = try openRegion.partRefusedAt(try refusalPositionOf(error, path: path))
	return AbandonedRegion.create(error.clone(), blame: blame.clone(), part: part, consequence: consequenceNamedBy(error))
end 'abandonedRegionFor'

module function refusalIsLocal(parser Parser, job ParseJob, signatures ProgramSignatures) returns bool
	return job.readsAuthorSource() and not parser.blockStructureMisread and not signatures.hasMisclosedBlocks()
end 'refusalIsLocal'

function consequenceOfRefusal(error SourceParseError, parser Parser, job ParseJob, signatures ProgramSignatures) returns ConsequenceOf
	if not refusalIsLocal(parser, job: job, signatures: signatures) 'nothingMayBeDropped'
		return ConsequenceOf.unrelated
	end 'nothingMayBeDropped'

	return consequenceNamedBy(error)
end 'consequenceOfRefusal'

function consequenceOfReceiverOrigin(origin ReceiverOrigin) returns ConsequenceOf
	return match origin 'origin'
		derivedFrom(names) gives ConsequenceOf.subject(names.clone())
		unattributed gives ConsequenceOf.unrelated
	end 'origin'
end 'consequenceOfReceiverOrigin'

module function isGenericArgumentCountCode(code ErrorCode) returns bool
	return code == ErrorCode.genericArityMismatch or code == ErrorCode.genericBaseNotGeneric
end 'isGenericArgumentCountCode'

function namedConsequence(name immutable ByteArray) returns ConsequenceOf
	return ConsequenceOf.subject(singleName(name))
end 'namedConsequence'

// ⚠ A refusal given a subject is dropped whenever that subject was refused, so only a refusal that
// cannot be independent of the declaration it names may have one; an independent error routed here
// would go unreported.
function consequenceNamedBy(error SourceParseError) returns ConsequenceOf
	return match error 'kind'
		unknownTypeName(typeName, _, _) gives ConsequenceOf.unknownType(freeze typeName.toByteArray())
		hiddenTypeMembers(typeName, _, _, _) gives ConsequenceOf.hiddenTypeName(freeze typeName.toByteArray())
		unknownField(typeName, _, _, _) gives namedConsequence(freeze typeName.toByteArray())
		undefinedVariable(name, _, _) gives namedConsequence(freeze name.toByteArray())
		uninferrableClosureParam(_, aliasName, _, _) gives namedConsequence(freeze aliasName.toByteArray())
		unknownCompilerIntrinsic(callee, _, _, _) gives namedConsequence(freeze callee.toByteArray())
		undefinedQualifiedFunction(callee, _, _, _) gives namedConsequence(freeze callee.toByteArray())
		enumMatchNotExhaustive(_, typeName, _, _, _) gives namedConsequence(freeze typeName.toByteArray())
		serviceTypeNotASpawnTarget(_, typeName, _, _) gives namedConsequence(freeze typeName.toByteArray())
		serviceReplyGraphNotWalkable(_, message, _, _) gives ConsequenceOf.handlerBody(freeze message.toByteArray())
		spawnStartRequiresTry(_, factory, _, _) gives namedConsequence(genericTemplateName(factory))
		genericArgumentCountRefused(_, explanation, _, _) gives ConsequenceOf.genericArgumentCount(explanation)
		memberAccessOnNonStruct(_, _, _, origin) gives consequenceOfReceiverOrigin(origin)
		returnTypeMismatch(_, _, _, _, _, _, origin) gives consequenceOfReceiverOrigin(origin)
		unexpectedToken or
		expectedExpression or
		uninferrableFieldDefault or
		varStartsFromBareNumber or
		letStartsFromUnboundedNumber or
		callerLocationOutsideDefault or
		unexpectedEof or
		integerOverflow or
		floatLiteralOverflow or
		malformedNumericLiteral or
		formatFieldOverflow or
		nonIntegralOperands or
		implicitNarrowing or
		builtinArity or
		builtinOperandType or
		builtinOperandPhrase or
		builtinArgumentType or
		unsupported or
		tupleElementRejected or
		droppedSignature or
		declarationTheSweepMissed or
		duplicateParameter or
		ambiguousBareName or
		assignToImmutable or
		useAfterMove or
		useAfterMoveInto or
		useAfterMoveInAnEarlierIteration or
		useAfterMovePassedTwice or
		promiseCannotBeBorrowed or
		promiseAlreadyConsumed or
		deepLet or
		controlOutsideLoop or
		labelTargetsOwnLoop or
		labelTargetsOwnMatch or
		unknownLoopLabel or
		firstArgNamed or
		argMissingLabel or
		builtinArgNamed or
		witnessArgCountMismatch or
		witnessUnknownArgLabel or
		witnessDuplicateArg or
		ambiguousWitnessDispatch or
		noWitnessRequirementOfArity or
		staticRequirementNotDispatchable or
		missingReturn or
		returnValueFromVoid or
		returnInInitializer or
		returnWithoutValue or
		operandTypeMismatch or
		operandAliasMismatch or
		nonNumericOperands or
		enumAccessorComparison or
		enumNoSuchRawValue or
		fieldsNotInitialized or
		fieldsNotDefinitelyAssigned or
		undefinedOperatorForType or
		nonNumericNegation or
		shiftCountNegative or
		comparisonTypeMismatch or
		operatorRequiresConformance or
		structEqualsResultNotBool or
		witnessSelfArgNotTypeParam or
		nonBoolCondition or
		assignTypeMismatch or
		typeMismatchExpectedGot or
		tupleAssignArityMismatch or
		functionValueIntoNonFunction or
		functionValueReturned or
		invalidCast or
		castTargetIsAContainer or
		castFormsAValue or
		throwingFunctionAsValue or
		giveTypeMismatch or
		ternaryValueTypeMismatch or
		ternaryNonBoolCondition or
		notOnUnknownType or
		voidCallResultUsed or
		invalidCharacterLiteral or
		invalidDigitEscape or
		byteStringCodepointRange or
		malformedLiteralText or
		duplicateTopLevelDeclaration or
		circularConstants or
		nonConstantInitializer or
		divisionByProvableZero or
		constantCastOutOfRange or
		byteStringByteOutOfRange or
		rawByteFillNarrowElement or
		rawByteWriteSlotDomain or
		constructorRestricted or
		builtinTypeConstruction or
		conditionalExtensionWithheld or
		fieldNotInitialized or
		duplicateFieldInitializer or
		assignToImmutableField or
		localShadowsSelfField or
		unexportedFieldAccess or
		strayToken or
		expectedDeclaration or
		expectedNewlineAfter or
		bareTryInAClosure or
		mismatchedEndLabel or
		testOutsideTestFile or
		testEmptyName or
		duplicateTestName or
		selfOutsideInstanceMethod or
		unknownAnnotation or
		heapAnnotationWithoutBinding or
		heapAnnotationOnNonRecord or
		matchFallthroughWithReturn or
		matchNotExhaustive or
		matchDuplicatePattern or
		matchPatternTypeMismatch or
		matchDefaultNotLast or
		matchMissingBlockId or
		matchMismatchedBlockId or
		matchBlockStatement or
		enumDuplicateCase or
		enumDuplicateRawValue or
