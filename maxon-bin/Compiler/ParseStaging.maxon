	export var debugStreamNameSites as DebugStreamNameSiteMap

	// Every `constArrayLiteral` this file emits whose record is IMAGE DATA, and which shape of one, keyed by
	// the op index in THIS artifact's module and folded with the merge's offset, exactly as
	// `debugStreamNameSites` is. See `Project.immortalConstArraySites`.
	export var immortalConstArraySites as ImmortalConstArraySiteMap

	export var provenFixedArrayAccesses as ProvenFixedArrayAccessMap

