		matchDiscardedBindings or
		matchDefaultEnumMustThrow or
		errorUnionMatchNotExhaustive or
		errorUnionMatchDefaultMustThrow or
		errorUnionAmbiguousBareCase or
		errorUnionUnknownCase or
		errorUnionUnknownMember or
		unknownPayloadName or
		enumWrongBindingCount or
		matchArmPayloadBindingConflict or
		tryBlockBindingNotMatched or
		errorMatchNotExactlyOnce or
		matchOverlappingCase or
		matchEnumCaseRange or
		matchOrChainNeedsOwnLine or
		matchSingleValueRange or
		unionNotComparable or
		existentialNotComparable or
		genericInstanceNotComparable or
		refIdentityOnPrimitive or
		refIdentityTypeMismatch or
		reservedIdentifier or
		reservedFaultProbeName or
		reservedReceiverName or
		declarationTakesCompilerOwnedTypeName or
		otherwiseWithoutTry or
		errorTypeMismatch or
