	// body, so with two functions in flight the count names neither one's final index, and the two would
	// collide on it (the enclosing function's early values and the closure's values both keyed to the same
	// index — a corrupted origin table, an E5001 pointing at the wrong source). `parseFunction` pushes each
	// function up front and stamps this field with the index it landed at, and `parseClosureExpression`
	// saves/sets/restores it around the lifted body — so every value is filed under the index its function
	// actually occupies. Zero for the tolerant declaration sweep, which parses no bodies and records no
	// origins.
	export var currentFuncIndex as ElementIndex

	// ⭐ DIAGNOSTICS THE PARSER RAISES WITHOUT UNWINDING. The parser reports a malformed
	// construct by THROWING a `SourceParseError` (which abandons its region), but a WHOLE-PROGRAM
	// SEMANTIC error a pure per-file parser detects — a generic instantiation whose base is not
	// generic, whose arity is wrong, or whose argument is managed — is not a reason to abort the
	// parse: it is a diagnostic that gates the build, exactly like `SemanticCheck`'s do. The parser
	// records it here rather than in `project.diagnostics` (which it must not touch — the pure-parser
	// invariant), and `mergeArtifact` folds this list into `project.diagnostics`, the single writer.
	// The tolerant declaration SWEEP uses a DIFFERENT artifact that is never merged, so a spurious
	// diagnostic it records against the still-building signature index is discarded for free.
	export var diagnostics as DiagnosticArray

	// ⭐ THE TWO DEFERRED NAME DIAGNOSTICS — an unused typealias, and a type name this file cannot
	// see. They are kept OUT of `diagnostics` above and reported later, in a
	// fixed order, by `TypeResolution.reportDeferredNameDiagnostics`; `DeferredNameDiagnostic`'s header
	// carries the whole argument for why per-file reporting cannot give the order the corpus pins.
	//
	// Two lists rather than one with a kind tag, because the ORDER BETWEEN THEM is the entire reason
	// they are deferred: every unused-alias diagnostic in the program precedes every hidden-name one,
	// and a single list would have to re-derive that split at the drain.
	export var unusedTypeAliases as DeferredNameDiagnosticRoster
	export var hiddenTypeNames as DeferredDiagnosticRoster

	// ⭐ THE DECLARATION-HYGIENE DIAGNOSTICS this file's function bodies earned (E3012 unused, E3077
	// var-should-be-let), kept OUT of `diagnostics` above so they cannot gate the pipeline ahead of the
	// checks that could explain the body instead. `mergeArtifact` folds them into
	// `project.bindingHygieneDiagnostics`, which carries the measured cascade this deferral cures.
	//
	// They are finished `Diagnostic`s and not `DeferredNameDiagnostic`s because nothing about them needs
	// re-deciding later — only the REPORTING is deferred, never the verdict, which is a fact about one
	// function body and is settled at its `end`.
	export var bindingHygieneDiagnostics as DiagnosticArray

	// ⭐⭐ **WHAT THIS FILE'S PARSE WROTE INTO THE SIGNATURE INDEX.** The parse's writes are undone when it
	// ends, so a parse reads only the settled index and its own mints; every merge folds these back in
	// (`ProgramSignatures.adoptParseMints`), whether this artifact is a fresh parse or a memo reused against a
	// rebuilt index.
	export var parseMints as ParseMints

	// The id each of `parseMints`' instance rows is known by in this artifact's ids right now: the parse's band
	// ids until a merge renumbers them, then the ids the latest merge adopted the rows under.
	export var instanceIdsInUse as GenericInstanceIdArray

	export static function create(filePath FilePath, livesUnderStdlibDirectory bool, sourceBytes SourceByteCount) returns FileParseArtifact
		return Self{
			filePath: filePath,
			livesUnderStdlibDirectory: livesUnderStdlibDirectory,
			typeIdsAreProjectGlobal: false,
			module: MaxonModule.create(),
			opRanges: SourceRangeTable.create(),
			covPoints: CovPointArray.create(),
			asyncSpawnSites: AsyncSpawnSiteMap.create(),
			overloadAnswers: OverloadAnswerMap.create(),
			serviceAwaitSites: ServiceAwaitSiteMap.create(),
			registryUseSites: noRegistryUseSites,
			allocTagSites: AllocTagSiteMap.create(),
			debugStreamNameSites: DebugStreamNameSiteMap.create(),
			immortalConstArraySites: ImmortalConstArraySiteMap.create(),
			provenFixedArrayAccesses: ProvenFixedArrayAccessMap.create(),
			valueOrigins: ValueOriginTable.create(),
			deferredChains: DeferredChainTable.create(),
			funcSignatures: FuncSignatureEntryArray.create(),
			overloadSets: noOverloadSets,
			pendingFnMergeChecks: PendingFnMergeCheckArray.create(),
			pendingFunctionTypeDoors: PendingFunctionTypeDoorArray.create(),
			pendingBrandRecords: PendingBrandRecordArray.create(),
			pendingDiscardedResults: PendingDiscardedResultArray.create(),
			rangeChecks: FunctionRangeCheckEntryArray.create(),
			typeAliases: RangedTypeAliasArray.create(),
			functionTypeAliases: FunctionTypeAliasArray.create(),
			structTypes: StructLayoutArray.create(),
			writtenTupleTypes: WrittenTupleTypeArray.create(),
			enumTypes: EnumLayoutArray.create(),
			interfaces: IrInterfaceArray.create(),
			typeNameDecls: TypeNameDeclArray.create(),
			usedTypeNames: noUsedTypeNames,
			memberAccessedTypeNames: noUsedTypeNames,
			unbuiltBodies: UnbuiltBodyArray.create(),
			conformances: ConformanceDeclArray.create(),
			literalInitSites: LiteralInitSiteArray.create(),
			inferredInstantiationSites: GenericInstantiationSiteArray.create(),
			typeNames: TypeNameInterner.createForSource(sourceBytes),
			currentFuncIndex: 0,
			diagnostics: DiagnosticArray.create(),
			unusedTypeAliases: noDeferredNameDiagnostics,
			hiddenTypeNames: noDeferredDiagnostics,
			bindingHygieneDiagnostics: DiagnosticArray.create(),
			parseMints: ParseMints.none,
			instanceIdsInUse: GenericInstanceIdArray.create()
		}
	end 'create'

	// File what the parse that built this artifact wrote into the signature index, with each instance row known
	// by the band id the parse handed it.
	export function recordParseMints(mints LocalInstanceMints)
		var bandIds = GenericInstanceIdArray.create()

		for position in 0 upto mints.rows.count() 'eachRow'
			bandIds.push(BandInstanceIdBase + position)
		end 'eachRow'

		self.parseMints = ParseMints.minted(mints)
		self.instanceIdsInUse = bandIds
	end 'recordParseMints'

	// Record an alias this file declared and never named, and a type name this file cannot see. Each
	// installs its own list on the first entry (`DeferredNameDiagnosticRoster`, `DeferredDiagnosticRoster`).
	export function recordUnusedTypeAlias(entry DeferredNameDiagnostic)
		var recorded = self.unusedTypeAliasesForWrite()
		recorded.push(entry)
	end 'recordUnusedTypeAlias'

	export function recordHiddenTypeName(entry Diagnostic)
		var recorded = self.hiddenTypeNamesForWrite()
		recorded.push(entry)
	end 'recordHiddenTypeName'

	export function adoptHiddenTypeNames(source FileParseArtifact)
		match source.hiddenTypeNames 'source'
			unwritten then return
			entries(recorded) then self.recordHiddenTypeNames(recorded)
		end 'source'
	end 'adoptHiddenTypeNames'

	function recordHiddenTypeNames(entries DiagnosticArray)
		for entry in entries 'eachEntry'
			if self.holdsHiddenTypeName(entry) 'alreadyHeld'
				continue
			end 'alreadyHeld'

			self.recordHiddenTypeName(entry)
		end 'eachEntry'
	end 'recordHiddenTypeNames'

	function holdsHiddenTypeName(entry Diagnostic) returns bool
		match self.hiddenTypeNames 'held'
			unwritten then return false
			entries(recorded) then return hiddenTypeNameIsAmong(recorded, entry: entry)
		end 'held'
	end 'holdsHiddenTypeName'

	export function adoptRetryState(source FileParseArtifact)
		for instance in source.genericInstanceRequests 'eachRequest'
			self.recordGenericInstanceRequest(instance)
		end 'eachRequest'

		self.adoptHiddenTypeNames(source)
	end 'adoptRetryState'

	// THE emit choke point for a Maxon body op — the only way the parser creates
	// one. Appending the op and recording its span happen together here, so
	// `module.ops` and `opRanges` cannot drift apart: there is no path that adds a
	// Maxon op without a span. (Calling `module.appendOp` directly would be that
	// path, which is why nothing in the Maxon tier does.)
	//
	// `appendOp` assigns the op the index `opCount()` holds right now, so capture it
	// BEFORE the append. `record` then asserts that index equals the span table's
	// own count — which is exactly the parallelism invariant, checked on every
	// single op: if anything ever appended a Maxon op behind this function's back,
	// the two counts diverge and the NEXT emit panics rather than silently shifting
	// every later span by one.
	export function emitOp(block IrBlock, op MaxonOp, range SourceRange)
		let opIndex = self.module.opCount()
		self.module.appendOp(block, op: artifactOwnedOp(op))
		self.opRanges.record(opIndex, range: range)
		self.recordValueOrigin(op, opIndex: opIndex)
	end 'emitOp'

	// Record an `async <call>` spawn's SOURCE TEXT against the op `emitOp` is about to append. The caller reads
	// `self.module.opCount()` through this rather than being handed an index, so the text lands on the same op
	// the very next `emitOp` creates and the two cannot be wired to different ops by a later edit.
	export function recordAsyncSpawnSite(site AsyncSpawnSite)
		self.asyncSpawnSites.upsert(self.module.opCount(), value: site)
	end 'recordAsyncSpawnSite'

	export function recordOverloadAnswer(opIndex ElementIndex, answer OverloadAnswer)
		self.overloadAnswers.upsert(opIndex, value: answer)
	end 'recordOverloadAnswer'

	// The service twin, on the same read-it-through-here contract and for its reason: the site lands on the op
	// the parser is ABOUT to append, so the key is the current count.
	export function recordServiceAwaitSite(site ServiceAwaitSite)
		self.serviceAwaitSites.upsert(self.module.opCount(), value: site.clone())
	end 'recordServiceAwaitSite'

	export function recordRegistryUseSite(site RegistryUseSite)
		var byOp = self.registryUseSitesForWrite()
		byOp.upsert(self.module.opCount(), value: site)
	end 'recordRegistryUseSite'

	function registryUseSitesForWrite() returns RegistryUseSiteMap
		match self.registryUseSites 'state'
			unwritten then break
			entries(byOp) then return byOp
		end 'state'

		let fresh = RegistryUseSiteMap.create()
		self.registryUseSites = RegistryUseSiteTable.entries(fresh)
		return fresh
	end 'registryUseSitesForWrite'

	// Record the mm-trace TAG of the box the op `emitOp` is about to append allocates — the same
	// read-it-through-here contract `recordAsyncSpawnSite` states, and for its reason: the tag lands on the
	// op the very next append creates, so the two cannot be wired to different ops by a later edit.
	export function recordAllocTagSite(tag MmTag)
		self.allocTagSites.upsert(self.module.opCount(), value: tag)
	end 'recordAllocTagSite'

	// Record the compile-time NAME the `__ds_name_id` marker `emitOp` is about to append interns — the same
	// read-it-through-here contract its two neighbours state, and for their reason.
	export function recordDebugStreamNameSite(name ByteArray)
		self.debugStreamNameSites.upsert(self.module.opCount(), value: name.clone())
	end 'recordDebugStreamNameSite'

	// Record that the `constArrayLiteral` `emitOp` is about to append materializes an IMMORTAL `.rdata`
	// record of `kind` — the same read-it-through-here contract its two neighbours state, and for their
	// reason.
	export function recordImmortalConstArraySite(kind ImmortalRecordKind)
		self.immortalConstArraySites.upsert(self.module.opCount(), value: kind)
	end 'recordImmortalConstArraySite'

	export function recordProvenFixedArrayAccess(opIndex ElementIndex, accessor SizedAccessor)
		self.provenFixedArrayAccesses.upsert(opIndex, value: accessor)
	end 'recordProvenFixedArrayAccess'

	// THE emit choke point for a Maxon block terminator. Same op/span lockstep as
	// `emitOp`; separate only because a terminator is stored on the block rather
	// than appended to its op list.
	//
	// ⭐⭐ **A SECOND TERMINATOR ON ONE BLOCK IS A MISCOMPILE, AND WITHOUT THIS GUARD IT IS SILENT.**
	// A block's terminator is a SLOT, not the last op of its list, so `setTerminator` on a block that
	// already has one simply REPLACES it and the first is gone — no diagnostic, no orphan the backend
	// trips over, just a `ret` or a `br` that never happens.
	//
	// The SOURCE-level cure is E3071 (`parseStatements` refuses the statement after a terminator); this
	// is the structural one behind it, so a construct added to the grammar without that guard fails
	// LOUDLY here instead of quietly answering wrong. Every legitimate site already asks first —
	// `finalizeIfNoElse`/`finalizeIfElse` on `thenEnd.isTerminated()`, `closeFunctionBody` and
	// `parseBlockBody` on `bodyEnd.isTerminated()`.
	//
	// ⚠ **`hasTerminatorOp` AND NOT `isTerminated`** — a `dead` block (the continuation of an `if` whose
	// branches all return) holds no terminator op, and giving it one is the ordinary way its unreachable
	// tail is parsed for syntax. Only a block with a REAL terminator op may not be given a second.
	export function emitTerminator(block IrBlock, op MaxonOp, range SourceRange)
		if block.hasTerminatorOp() 'alreadyTerminated'
			panic("emitTerminator: block '{String.from(block.label)}' already has a terminator at op {block.terminatorIndex()} — a second one would silently replace it (see E3071)")
		end 'alreadyTerminated'

		let opIndex = self.module.opCount()
		self.module.setTerminator(block, op: artifactOwnedOp(op))
		self.opRanges.record(opIndex, range: range)
		self.recordValueOrigin(op, opIndex: opIndex)
	end 'emitTerminator'

	// Record the origin of the value `op` defines (if any) as this file's contribution
	// to the whole-program `ValueOrigin` table. The current function's LOCAL index is
	// `self.currentFuncIndex`, stamped by `parseFunction` (and re-stamped by
	// `parseClosureExpression` around a lifted closure body): the function is pushed to
	// `module.functions` UP FRONT and this field records the index it landed at, so a closure
	// parsed in the middle of its enclosing function's body does not make `funcCount()` name
	// the wrong function. A `none`-result op (`ret`/`retVoid`/`condBranch`/`branch`) defines no
	// value and records nothing.
	function recordValueOrigin(op MaxonOp, opIndex ElementIndex)
		let id = try maxonOpDefinedValue(op) otherwise return
		self.valueOrigins.record(self.currentFuncIndex, valueId: id, opIndex: opIndex)
	end 'recordValueOrigin'

	// Record a PARAMETER's declaration span as this file's contribution to the whole-program
	// origin table. Called by the parser as it binds each parameter (a param is minted by no
	// op, so it has no `recordValueOrigin` entry — it needs this separate site). Keyed by the
	// current function's LOCAL index — `self.currentFuncIndex` — for `recordValueOrigin`'s reason.
	export function recordParamOrigin(valueId ValueId, range SourceRange)
		self.valueOrigins.recordParam(self.currentFuncIndex, valueId: valueId, range: range)
	end 'recordParamOrigin'

	export function recordDeferredChain(valueId ValueId, chainCalls DeferredChainCalls)
		self.deferredChains.record(self.currentFuncIndex, valueId: valueId, chainCalls: chainCalls)
	end 'recordDeferredChain'

	// Record a function's parameter signature and return type as this file's contribution to
	// the project-wide `funcSignatures` and `funcReturnTypes` registries. Called by the parser
	// after it builds a function — NEVER touching `Project`. The name's source position
	// travels with the entry so a merge-time duplicate can be positioned on the blamed
	// declaration.
	export function recordFuncSignature(name ByteArray, signature FuncSignature, returnType MaxonReturnType, nameLine LineNumber, nameColumn ColumnNumber, sourceFilePath FilePath, synthesized bool, role FunctionDeclarationRole)
		self.funcSignatures.push(FuncSignatureEntry.create(name.clone(), signature: signature.clone(), returnType: returnType.clone(), nameLine: nameLine, nameColumn: nameColumn, sourceFilePath: sourceFilePath, synthesized: synthesized, role: role))
	end 'recordFuncSignature'

	// Record the whole current member list of one overloaded bare name. REPLACES rather than appends:
	// the parser hands back the complete list every time a member joins, which is what keeps this table a
	// projection of the parser's own records rather than a second accumulation to keep in step.
	export function recordOverloadSet(base ByteArray, members NameRoster)
		var byBase = self.overloadSetsForWrite()
		byBase.upsert(base.clone(), value: members.clone())
	end 'recordOverloadSet'

	// ⭐ **THE INSTALL DOORS.** A `match` arm binds its payload IMMUTABLY and is ONE statement (E3159), so a
	// list cannot be written in the arm that reads it: each door below installs the
	// list on the first entry and ANSWERS it, and the caller writes through a `var` alias of that answer.

	// The unused-alias list this file defers into.
	function unusedTypeAliasesForWrite() returns DeferredNameDiagnosticArray
		match self.unusedTypeAliases 'state'
			unwritten then break
			entries(recorded) then return recorded
		end 'state'

		let fresh = DeferredNameDiagnosticArray.create()
		self.unusedTypeAliases = DeferredNameDiagnosticRoster.entries(fresh)
		return fresh
	end 'unusedTypeAliasesForWrite'

	// The hidden-name list, its twin.
	function hiddenTypeNamesForWrite() returns DiagnosticArray
		match self.hiddenTypeNames 'state'
			unwritten then break
			entries(recorded) then return recorded
		end 'state'

		let fresh = DiagnosticArray.create()
		self.hiddenTypeNames = DeferredDiagnosticRoster.entries(fresh)
		return fresh
	end 'hiddenTypeNamesForWrite'

	function overloadSetsForWrite() returns OverloadSetMap
		match self.overloadSets 'state'
			unwritten then break
			entries(byBase) then return byBase
		end 'state'

		let fresh = OverloadSetMap.create()
		self.overloadSets = OverloadSetTable.entries(fresh)
		return fresh
	end 'overloadSetsForWrite'

	// Record a function's range-check sites as this file's contribution to `project.rangeChecks`.
	// Called by the parser at function completion, and ONLY when the function actually has
	// a cast into a ranged alias or a ranged `return` — a function with neither files nothing, so
	// the registry stays proportional to the range checks a program contains, not its function count.
	export function recordFunctionRangeChecks(name ByteArray, checks FunctionRangeChecks)
		self.rangeChecks.push(FunctionRangeCheckEntry.create(name.clone(), checks: checks))
	end 'recordFunctionRangeChecks'

	// Record a ranged-typealias declaration as this file's contribution to the
	// project-wide `typeAliases` registry — the same NEVER-touch-Project discipline
	// `recordFuncSignature` follows.
	// The typealias arrays (`typeAliases` / `functionTypeAliases`) are PUSHED INTO DIRECTLY by
	// `Parser.readTypeAliasDeclaration`, which is handed the target array — the real parse passes the
	// artifact's, the declaration sweep passes its own — so one reader files a ranged alias in one array
	// and a function alias in the other with no boxed-union hop. `mergeArtifact` folds both into `Project`.

	// Record a declared struct type as this file's contribution to the project-wide `structTypes`
	// registry — the same NEVER-touch-Project discipline every `record*` above follows.
	export function recordStructType(layout StructLayout)
		self.structTypes.push(layout.clone())
	end 'recordStructType'

	// Record a declared enum/union type as this file's contribution to the project-wide `enumTypes`
	// registry — the same NEVER-touch-Project discipline every `record*` above follows.
	//
	// ⭐ **A PAYLOAD-BEARING UNION CONTRIBUTES ITS `unionCases` COMPANION TOO**, through the same door and
	// the same builder the declaration SWEEP appends it with (`Project.appendUnionCasesCompanion`, whose
	// header says why both registries need it). Here rather than at `parseEnumDeclaration`'s tail so the
	// artifact's enum list and the sweep's are filled by one rule.
	export function recordEnumType(layout EnumLayout)
		var owned = layout.clone()
		self.enumTypes.push(owned)
		appendUnionCasesCompanion(self.enumTypes, layout: owned)
	end 'recordEnumType'

	// Record a declared `interface` as this file's contribution to `project.interfaces`
	// — the same NEVER-touch-Project discipline every `record*` above follows.
	export function recordInterface(iface IrInterface)
		self.interfaces.push(iface.clone())
	end 'recordInterface'

	export function recordGenericInstanceRequest(instance GenericFunctionInstance)
		for requested in self.genericInstanceRequests 'eachRequested'
			if requested.instanceName.equals(instance.instanceName) 'requestedAlready'
				return
			end 'requestedAlready'
		end 'eachRequested'

		self.genericInstanceRequests.push(instance)
	end 'recordGenericInstanceRequest'

	export function requestedGenericInstanceSiteKey(instanceName ByteArray) returns ByteArray throws AbsentError
		for requested in self.genericInstanceRequests 'eachRequested'
			if requested.instanceName.equals(instanceName) 'thisInstance'
				return requested.siteKey.clone()
			end 'thisInstance'
		end 'eachRequested'

		throw AbsentError.absent
	end 'requestedGenericInstanceSiteKey'

	// Record a `type X implements …` conformance as this file's contribution to `project.conformances`.
	// The type-name position travels with it so `checkConformance` anchors on the name.
	export function recordConformance(conformance ConformanceDecl)
		self.conformances.push(conformance.clone())
	end 'recordConformance'

	// Record a function VALUE meeting a function-typed PLACE (see PendingFunctionTypeDoor).
	export function recordFunctionTypeDoor(door PendingFunctionTypeDoor)
		self.pendingFunctionTypeDoors.push(door.clone())
	end 'recordFunctionTypeDoor'

	export function recordBrandRecord(record PendingBrandRecord)
		self.pendingBrandRecords.push(record.clone())
	end 'recordBrandRecord'

	// Record a statement that used none of a call's result (see PendingDiscardedResult).
	export function recordDiscardedResult(site PendingDiscardedResult)
		self.pendingDiscardedResults.push(site.clone())
	end 'recordDiscardedResult'

	// Allocate this file's next counter slot and return its FILE-LOCAL id, which is what the op carries.
	// Read before the push, so the id is the position this point takes.
	export function recordCovPoint(point CovPoint) returns CovPointId
		let id = self.covPoints.count() as CovPointId
		self.covPoints.push(point)

		return id
	end 'recordCovPoint'

	// @generated library-cache begin
	module function cacheWrite(writer LibraryCacheWriter)
		writer.text(self.filePath.toString())
		writer.flag(self.livesUnderStdlibDirectory)
		writer.flag(self.typeIdsAreProjectGlobal)
		cacheWriteMaxonModule(writer, value: self.module)
		self.opRanges.cacheWrite(writer)
		cacheWriteCovPointArray(writer, value: self.covPoints)
		cacheWriteAsyncSpawnSiteMap(writer, value: self.asyncSpawnSites)
		cacheWriteOverloadAnswerMap(writer, value: self.overloadAnswers)
		cacheWriteServiceAwaitSiteMap(writer, value: self.serviceAwaitSites)
		cacheWriteRegistryUseSiteTable(writer, value: self.registryUseSites)
		cacheWriteAllocTagSiteMap(writer, value: self.allocTagSites)
		cacheWriteDebugStreamNameSiteMap(writer, value: self.debugStreamNameSites)
		cacheWriteImmortalConstArraySiteMap(writer, value: self.immortalConstArraySites)
		cacheWriteProvenFixedArrayAccessMap(writer, value: self.provenFixedArrayAccesses)
		self.valueOrigins.cacheWrite(writer)
		self.deferredChains.cacheWrite(writer)
		cacheWriteFuncSignatureEntryArray(writer, value: self.funcSignatures)
		cacheWriteOverloadSetTable(writer, value: self.overloadSets)
		cacheWritePendingFnMergeCheckArray(writer, value: self.pendingFnMergeChecks)
		cacheWritePendingFunctionTypeDoorArray(writer, value: self.pendingFunctionTypeDoors)
		cacheWritePendingBrandRecordArray(writer, value: self.pendingBrandRecords)
		cacheWritePendingDiscardedResultArray(writer, value: self.pendingDiscardedResults)
		cacheWriteFunctionRangeCheckEntryArray(writer, value: self.rangeChecks)
		cacheWriteRangedTypeAliasArray(writer, value: self.typeAliases)
		cacheWriteFunctionTypeAliasArray(writer, value: self.functionTypeAliases)
		cacheWriteStructLayoutArray(writer, value: self.structTypes)
		cacheWriteWrittenTupleTypeArray(writer, value: self.writtenTupleTypes)
		cacheWriteEnumLayoutArray(writer, value: self.enumTypes)
		cacheWriteIrInterfaceArray(writer, value: self.interfaces)
		cacheWriteTypeNameDeclArray(writer, value: self.typeNameDecls)
		cacheWriteGenericFunctionInstanceArray(writer, value: self.genericInstanceRequests)
		cacheWriteUsedTypeNameRoster(writer, value: self.usedTypeNames)
		cacheWriteUsedTypeNameRoster(writer, value: self.memberAccessedTypeNames)
		cacheWriteUnbuiltBodyArray(writer, value: self.unbuiltBodies)
		cacheWriteConformanceDeclArray(writer, value: self.conformances)
		cacheWriteLiteralInitSiteArray(writer, value: self.literalInitSites)
		cacheWriteGenericInstantiationSiteArray(writer, value: self.inferredInstantiationSites)
		cacheWriteTypeNameInterner(writer, value: self.typeNames)
		writer.unsigned(self.currentFuncIndex as CacheUnsigned)
		cacheWriteDiagnosticArray(writer, value: self.diagnostics)
		cacheWriteDeferredNameDiagnosticRoster(writer, value: self.unusedTypeAliases)
		cacheWriteDeferredDiagnosticRoster(writer, value: self.hiddenTypeNames)
		cacheWriteDiagnosticArray(writer, value: self.bindingHygieneDiagnostics)
		cacheWriteParseMints(writer, value: self.parseMints)
		cacheWriteGenericInstanceIdArray(writer, value: self.instanceIdsInUse)
	end 'cacheWrite'

	module static function cacheRead(reader LibraryCacheReader) returns FileParseArtifact throws LibraryCacheDamage
		let f_filePath = try reader.path()
		let f_livesUnderStdlibDirectory = try reader.flag()
		let f_typeIdsAreProjectGlobal = try reader.flag()
		let f_module = try cacheReadMaxonModule(reader)
		let f_opRanges = try SourceRangeTable.cacheRead(reader)
		let f_covPoints = try cacheReadCovPointArray(reader)
		let f_asyncSpawnSites = try cacheReadAsyncSpawnSiteMap(reader)
		let f_overloadAnswers = try cacheReadOverloadAnswerMap(reader)
		let f_serviceAwaitSites = try cacheReadServiceAwaitSiteMap(reader)
		let f_registryUseSites = try cacheReadRegistryUseSiteTable(reader)
		let f_allocTagSites = try cacheReadAllocTagSiteMap(reader)
		let f_debugStreamNameSites = try cacheReadDebugStreamNameSiteMap(reader)
		let f_immortalConstArraySites = try cacheReadImmortalConstArraySiteMap(reader)
		let f_provenFixedArrayAccesses = try cacheReadProvenFixedArrayAccessMap(reader)
		let f_valueOrigins = try ValueOriginTable.cacheRead(reader)
		let f_deferredChains = try DeferredChainTable.cacheRead(reader)
		let f_funcSignatures = try cacheReadFuncSignatureEntryArray(reader)
		let f_overloadSets = try cacheReadOverloadSetTable(reader)
		let f_pendingFnMergeChecks = try cacheReadPendingFnMergeCheckArray(reader)
		let f_pendingFunctionTypeDoors = try cacheReadPendingFunctionTypeDoorArray(reader)
		let f_pendingBrandRecords = try cacheReadPendingBrandRecordArray(reader)
		let f_pendingDiscardedResults = try cacheReadPendingDiscardedResultArray(reader)
		let f_rangeChecks = try cacheReadFunctionRangeCheckEntryArray(reader)
		let f_typeAliases = try cacheReadRangedTypeAliasArray(reader)
		let f_functionTypeAliases = try cacheReadFunctionTypeAliasArray(reader)
		let f_structTypes = try cacheReadStructLayoutArray(reader)
		let f_writtenTupleTypes = try cacheReadWrittenTupleTypeArray(reader)
		let f_enumTypes = try cacheReadEnumLayoutArray(reader)
		let f_interfaces = try cacheReadIrInterfaceArray(reader)
		let f_typeNameDecls = try cacheReadTypeNameDeclArray(reader)
		let f_genericInstanceRequests = try cacheReadGenericFunctionInstanceArray(reader)
		let f_usedTypeNames = try cacheReadUsedTypeNameRoster(reader)
		let f_memberAccessedTypeNames = try cacheReadUsedTypeNameRoster(reader)
		let f_unbuiltBodies = try cacheReadUnbuiltBodyArray(reader)
		let f_conformances = try cacheReadConformanceDeclArray(reader)
		let f_literalInitSites = try cacheReadLiteralInitSiteArray(reader)
		let f_inferredInstantiationSites = try cacheReadGenericInstantiationSiteArray(reader)
		let f_typeNames = try cacheReadTypeNameInterner(reader)
		let f_currentFuncIndex = (try reader.unsigned()) as ElementIndex
		let f_diagnostics = try cacheReadDiagnosticArray(reader)
		let f_unusedTypeAliases = try cacheReadDeferredNameDiagnosticRoster(reader)
		let f_hiddenTypeNames = try cacheReadDeferredDiagnosticRoster(reader)
		let f_bindingHygieneDiagnostics = try cacheReadDiagnosticArray(reader)
		let f_parseMints = try cacheReadParseMints(reader)
		let f_instanceIdsInUse = try cacheReadGenericInstanceIdArray(reader)

		return Self{filePath: f_filePath, livesUnderStdlibDirectory: f_livesUnderStdlibDirectory, typeIdsAreProjectGlobal: f_typeIdsAreProjectGlobal, module: f_module, opRanges: f_opRanges, covPoints: f_covPoints, asyncSpawnSites: f_asyncSpawnSites, overloadAnswers: f_overloadAnswers, serviceAwaitSites: f_serviceAwaitSites, registryUseSites: f_registryUseSites, allocTagSites: f_allocTagSites, debugStreamNameSites: f_debugStreamNameSites, immortalConstArraySites: f_immortalConstArraySites, provenFixedArrayAccesses: f_provenFixedArrayAccesses, valueOrigins: f_valueOrigins, deferredChains: f_deferredChains, funcSignatures: f_funcSignatures, overloadSets: f_overloadSets, pendingFnMergeChecks: f_pendingFnMergeChecks, pendingFunctionTypeDoors: f_pendingFunctionTypeDoors, pendingBrandRecords: f_pendingBrandRecords, pendingDiscardedResults: f_pendingDiscardedResults, rangeChecks: f_rangeChecks, typeAliases: f_typeAliases, functionTypeAliases: f_functionTypeAliases, structTypes: f_structTypes, writtenTupleTypes: f_writtenTupleTypes, enumTypes: f_enumTypes, interfaces: f_interfaces, typeNameDecls: f_typeNameDecls, genericInstanceRequests: f_genericInstanceRequests, usedTypeNames: f_usedTypeNames, memberAccessedTypeNames: f_memberAccessedTypeNames, unbuiltBodies: f_unbuiltBodies, conformances: f_conformances, literalInitSites: f_literalInitSites, inferredInstantiationSites: f_inferredInstantiationSites, typeNames: f_typeNames, currentFuncIndex: f_currentFuncIndex, diagnostics: f_diagnostics, unusedTypeAliases: f_unusedTypeAliases, hiddenTypeNames: f_hiddenTypeNames, bindingHygieneDiagnostics: f_bindingHygieneDiagnostics, parseMints: f_parseMints, instanceIdsInUse: f_instanceIdsInUse}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize360
		return sizeof(FileParseArtifact) as CacheSize360
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FileParseArtifact'

function hiddenTypeNameIsAmong(recorded DiagnosticArray, entry Diagnostic) returns bool
	let rendered = entry.render()

	for held in recorded 'eachHeld'
		if held.render() == rendered 'sameDiagnostic'
			return true
		end 'sameDiagnostic'
	end 'eachHeld'

	return false
end 'hiddenTypeNameIsAmong'

// ⭐⭐ **THE OP AS THE ARTIFACT KEEPS IT: every record in its payload the artifact's own.** A name, a label, a
// constant's bytes or a type in a payload is often a record the signature index holds, and an artifact built on a
// pool worker crosses back to the main thread while the worker keeps that index. So the artifact's doors copy what
// they store — this one for ops, the `record…` doors above, `IrFunction.create` and `VarInfo.make` — and a door of
// the index that hands a record out never does. An arm whose payload is scalars and value ids the parser built for
// this op holds nothing of the index's and is kept as it is.
function artifactOwnedOp(op MaxonOp) returns MaxonOp
	match op 'op'
		call or
		tryCall or
		asyncCall or
		serviceSpawn then return artifactOwnedCall(op)
		literal or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		panicAbort or
		functionRef or
		sizeofType or
		constArrayLiteral or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable then return op.clone()
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		throwError or
		propagateError or
		indirectCall or
		await or
		tryAwait or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		covPoint or
		rawIntrinsic then return op

		// The interface name is read off the artifact's own interner, which holds its own copy.
		existentialWitness then return op
		holdValue or
		holdEnd then return artifactOwnedHold(op)
	end 'op'
end 'artifactOwnedOp'

function artifactOwnedHold(op MaxonOp) returns MaxonOp
	match op 'hold'
		holdValue(result, held, callee, args, kind) then return MaxonOp.holdValue(result, held: held, callee: callee.clone(), args: args, kind: kind)
		holdEnd(result, held, callee, args, kind) then return MaxonOp.holdEnd(result, held: held, callee: callee.clone(), args: args, kind: kind)
		default panic("artifactOwnedHold: reached with an op that is not a hold marker — `artifactOwnedOp` routes only `holdValue` and `holdEnd` here")
	end 'hold'
end 'artifactOwnedHold'

// A call's names are copied and its value-id columns kept: the parser builds `args`, `argRanges` and
// `defaultedArgs` for this op, while a label or a blamed name may be a parameter name the index holds. Bound in a
// match of its own, for `LowerMaxonToStd.lowerIndirectCall`'s reason.
function artifactOwnedCall(op MaxonOp) returns MaxonOp
	match op 'call'
		call(result, callee, args, argLabels, argRanges, argImmutableNames, defaultedArgs, mint) then return MaxonOp.call(result, callee: callee.clone(), args: args, argLabels: ownedNames(argLabels), argRanges: argRanges, argImmutableNames: ownedBlames(argImmutableNames), defaultedArgs: defaultedArgs, mint: mint)
		tryCall(result, errorFlag, callee, args, argLabels, argRanges, argImmutableNames, defaultedArgs, mint) then return MaxonOp.tryCall(result, errorFlag: errorFlag, callee: callee.clone(), args: args, argLabels: ownedNames(argLabels), argRanges: argRanges, argImmutableNames: ownedBlames(argImmutableNames), defaultedArgs: defaultedArgs, mint: mint)
		asyncCall(result, callee, args, argLabels, argRanges, argImmutableNames, defaultedArgs, mint) then return MaxonOp.asyncCall(result, callee: callee.clone(), args: args, argLabels: ownedNames(argLabels), argRanges: argRanges, argImmutableNames: ownedBlames(argImmutableNames), defaultedArgs: defaultedArgs, mint: mint)
		serviceSpawn(result, typeName, state, capacity, callee, args, argLabels, argRanges, argImmutableNames, defaultedArgs, mint, startReplies) then return MaxonOp.serviceSpawn(result, typeName: typeName.clone(), state: state, capacity: capacity, callee: callee.clone(), args: args, argLabels: ownedNames(argLabels), argRanges: argRanges, argImmutableNames: ownedBlames(argImmutableNames), defaultedArgs: defaultedArgs, mint: mint, startReplies: startReplies)
		default panic("artifactOwnedCall: reached with an op that is not a named call — `artifactOwnedOp` routes only `call`, `tryCall`, `asyncCall` and `serviceSpawn` here")
	end 'call'
end 'artifactOwnedCall'

// An empty column is kept: most calls share the parser's one empty `NoImmutableArgNames`, which is image data.
function ownedNames(names NameRoster) returns NameRoster
	return names if names.isEmpty() else names.clone()
end 'ownedNames'

function ownedBlames(blames WriteBlameArray) returns WriteBlameArray
	return blames if blames.isEmpty() else blames.clone()
end 'ownedBlames'

// Fold `artifact` into the whole-program build in source-path order:
//   1. reconcile the artifact's local type-name ids into the project interner,
//   2. offset-merge the artifact's MaxonModule fragment into `target`,
//   3. fold its op source spans onto `project.opRanges`, in lockstep with (2),
//   4. commit the artifact's registry contributions into `Project` — all but its type-name
//      declarations, which `commitTypeNameDeclsInPathOrder` commits once every file has merged.
// `target` is the accumulator module `queryAllModule` builds (and caches); the
// registries land on `Project`.
export function mergeArtifact(project Project, target MaxonModule, artifact FileParseArtifact, signatures ProgramSignatures)
	signatures.beginMerge()
	renumberArtifact(project, artifact: artifact, signatures: signatures)

	let opOffset = target.ops.count()

	// A drift here misattributes every later op's diagnostics by a constant, silently.
	if project.opRanges.count() != opOffset 'spansOutOfStep'
		panic("mergeArtifact: project.opRanges holds {project.opRanges.count()} spans but the merged module holds {opOffset} ops — the span table drifted out of lockstep with the op array")
	end 'spansOutOfStep'

	let funcOffset = target.funcCount()

	target.merge(artifact.module)
	project.opRanges.appendFrom(artifact.opRanges)
	project.valueOrigins.appendFrom(artifact.valueOrigins, funcOffset: funcOffset, opOffset: opOffset)
	project.deferredChains.appendFrom(artifact.deferredChains, funcOffset: funcOffset)
	commitArtifactRegistries(project, artifact: artifact, opOffset: opOffset, signatures: signatures)
end 'mergeArtifact'

// The registries are rebuilt by running a kept file's commits again rather than restored from a
// checkpoint: a parse needs the index at its baseline (`ProgramSignatures.openParseBand`), so the
// index cannot be held mid-merge, and the same commits over the same files keep first-wins and push
// order exactly a full merge's.
module function replayMergedArtifact(project Project, artifact FileParseArtifact, before MergeMark, signatures ProgramSignatures)
	signatures.beginMerge()

	if not adoptedInstanceIds(artifact, signatures: signatures).equals(artifact.instanceIdsInUse) 'adoptionMoved'
		panic("replayMergedArtifact: the index adopted the mints of {artifact.filePath.toString()} under other ids than the merge that placed its ops gave them — the kept ops would name instances the index no longer holds")
	end 'adoptionMoved'

	commitArtifactRegistries(project, artifact: artifact, opOffset: before.opCount, signatures: signatures)
end 'replayMergedArtifact'

function commitArtifactRegistries(project Project, artifact FileParseArtifact, opOffset ElementIndex, signatures ProgramSignatures)
	commitCovPoints(project, artifact: artifact)
	commitOpKeyedSites(project, artifact: artifact, opOffset: opOffset)
	commitFuncSignatures(project, artifact: artifact)
	commitOverloadSets(project, artifact: artifact)
	commitPendingFnMergeChecks(project, artifact: artifact)
	commitPendingFunctionTypeDoors(project, artifact: artifact)
	commitPendingBrandRecords(project, artifact: artifact, opOffset: opOffset)
	commitPendingDiscardedResults(project, artifact: artifact, opOffset: opOffset)
	commitRangeChecks(project, artifact: artifact)
	commitTypeAliases(project, artifact: artifact)
	commitFunctionTypeAliases(project, artifact: artifact, signatures: signatures)
	commitStructTypes(project, artifact: artifact, signatures: signatures)
	commitWrittenTupleTypes(project, artifact: artifact)
	commitEnumTypes(project, artifact: artifact)
	commitInterfaces(project, artifact: artifact)
	commitConformances(project, artifact: artifact)
	commitLiteralInitSites(project, artifact: artifact)
	commitInferredInstantiationSites(project, artifact: artifact)
	commitDiagnostics(project, artifact: artifact)
	commitDeferredNameDiagnostics(project, artifact: artifact)
	commitWrittenGenericAliasNames(project, artifact: artifact, signatures: signatures)
end 'commitArtifactRegistries'

// Every `Project` table keyed by an op index into the merged module, or holding one, or running parallel
// to the ops. One missing here escapes `FoldLedger.requireTablesHeld`, and a stale key in it names a
// different op with nothing to notice.
module enum OpKeyedTable
	synthesizedOpFiles
	registryUseSites
	serviceAwaitSites
	asyncSpawnSites
	overloadAnswers
	allocTagSites
	debugStreamNameSites
	immortalConstArraySites
	provenFixedArrayAccesses
	valueOrigins
	deferredChains
	refusedOverloadCalls
	undecidedOverloadCalls
	pendingDiscardedResults
	opRanges
end 'OpKeyedTable'

module typealias OpKeyedTableArray = Array with OpKeyedTable

module function heldBy(table OpKeyedTable, project Project) returns ElementIndex
	return match table 'whichTable'
		synthesizedOpFiles gives project.synthesizedOpFiles.count()
		registryUseSites gives project.registryUseSites.count()
		serviceAwaitSites gives project.serviceAwaitSites.count()
		asyncSpawnSites gives project.asyncSpawnSites.count()
		overloadAnswers gives project.overloadAnswers.count()
		allocTagSites gives project.allocTagSites.count()
		debugStreamNameSites gives project.debugStreamNameSites.count()
		immortalConstArraySites gives project.immortalConstArraySites.count()
		provenFixedArrayAccesses gives project.provenFixedArrayAccesses.count()
		valueOrigins gives project.valueOrigins.count()
		deferredChains gives project.deferredChains.count()
		refusedOverloadCalls gives project.refusedOverloadCalls.count()
		undecidedOverloadCalls gives project.undecidedOverloadCalls.count()
		pendingDiscardedResults gives project.pendingDiscardedResults.count()
		opRanges gives project.opRanges.count()
	end 'whichTable'
end 'heldBy'

module type MergeMark
	module let opCount as ElementIndex
	let blockCount as ElementIndex
	module let funcCount as ElementIndex
	let valueOrigins as ValueOriginMark
	let deferredChains as ElementIndex

	module static function empty() returns MergeMark
		return Self{opCount: 0, blockCount: 0, funcCount: 0, valueOrigins: ValueOriginMark.create(0, params: 0, derived: 0), deferredChains: 0}
	end 'empty'

	module static function of(project Project, target MaxonModule) returns MergeMark
		return Self{opCount: target.ops.count(), blockCount: target.blocks.count(), funcCount: target.funcCount(), valueOrigins: project.valueOrigins.mark(), deferredChains: project.deferredChains.count()}
	end 'of'

	module function rollBack(project Project, target MaxonModule)
		target.truncateTo(self.opCount, blockCount: self.blockCount, functionCount: self.funcCount)
		project.opRanges.truncate(self.opCount)
		project.valueOrigins.truncate(self.valueOrigins)
		project.deferredChains.truncate(self.deferredChains)
	end 'rollBack'
end 'MergeMark'

// ⭐⭐ **COUNT AT MERGE, INDEX AT LOWERING** — the two halves of a coverage point's identity, split here
// because neither end can hold both. The parse is per-file and memoized, so it can only number within its
// own file; `GlobalDataTable.layOut` sizes the counter image before the lowering runs, so the whole-program
// COUNT has to be final by the end of this fold. Appending the file's points and recording where they
// landed is that count, and the base is what `lowerMaxonToStd` adds to each op's file-local id.
//
// ⛔ **NO OP PAYLOAD IS REWRITTEN HERE**, which is what keeps the per-file parse memo valid across a build
// whose file set or file order changed.
//
// A file with no points still records its base, so a lookup miss is an invariant break rather than an
// ordinary "this file was not instrumented".
function commitCovPoints(project Project, artifact FileParseArtifact)
	project.covPointBases.upsert(artifact.filePath.toString(), value: project.covPoints.count())

	for point in artifact.covPoints 'each'
		_ = project.covPoints.append(point)
	end 'each'
end 'commitCovPoints'

// Fold this file's two DEFERRED name diagnostics into the project's own lists. They are appended
// rather than reported, because their whole point is to be reported LATER and in a fixed order — see
// `DeferredNameDiagnostic` for why, and `TypeResolution.reportDeferredNameDiagnostics` for the drain.
function commitDeferredNameDiagnostics(project Project, artifact FileParseArtifact)
	match artifact.unusedTypeAliases 'unused'
		unwritten then break
		entries(recorded) then pushEachDeferredDiagnostic(project.unusedTypeAliasDiagnostics, recorded: recorded)
	end 'unused'

	match artifact.hiddenTypeNames 'hidden'
		unwritten then break
		entries(recorded) then project.hiddenTypeNameDiagnostics.append(recorded)
	end 'hidden'
end 'commitDeferredNameDiagnostics'

// The cross-file half of E3062: a generic-instance alias may be written only in files other than the
// one declaring it, which the per-file check cannot see.
// `ProgramSignatures.fileMeansTheSoleGenericAliasDeclaration` owns when a spelling credits a
// declaration.
function commitWrittenGenericAliasNames(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	match artifact.usedTypeNames 'written'
		unwritten then break
		entries(names) then noteWrittenGenericAliasNames(project, names: names, signatures: signatures, spellingFilePath: artifact.filePath)
	end 'written'
end 'commitWrittenGenericAliasNames'

function noteWrittenGenericAliasNames(project Project, names UsedTypeNameSet, signatures ProgramSignatures, spellingFilePath FilePath)
	for name in names 'eachName'
		if not signatures.fileMeansTheSoleGenericAliasDeclaration(name, readerFilePath: spellingFilePath) 'creditsNoOneDeclaration'
			continue
		end 'creditsNoOneDeclaration'

		insertOwnedName(project.genericAliasNamesWrittenByAFile, name: name)
	end 'eachName'
end 'noteWrittenGenericAliasNames'

// Append one recorded list to a whole-program one — its own function because a `match` arm may not open a
// `for`, and a walk that deferred nothing never reaches it.
function pushEachDeferredDiagnostic(into DeferredNameDiagnosticArray, recorded DeferredNameDiagnosticArray)
	var target = into

	for entry in recorded 'each'
		target.push(entry)
	end 'each'
end 'pushEachDeferredDiagnostic'

// Fold this file's parser-raised diagnostics into `project.diagnostics` — the last
// contribution, and the one that carries no ids to remap (a `Diagnostic` is a finished
// (code, message, position) record). `reportDiagnostic` is the single project sink, so a
// parser-recorded diagnostic and a `SemanticCheck`-recorded one are indistinguishable downstream.
function commitDiagnostics(project Project, artifact FileParseArtifact)
	for diagnostic in artifact.diagnostics 'each'
		reportDiagnostic(project, diagnostic: diagnostic)
		noteDeclarationRefusedBy(project, diagnostic: diagnostic)
	end 'each'

	// ⭐ The hygiene half does NOT go through `reportDiagnostic`: reaching the project's sink is exactly
	// what would gate the pipeline before the checks that might explain the body — see
	// `Project.bindingHygieneDiagnostics`. It is appended, and drained past the Std-tier passes by
	// `Compiler.reportBindingHygieneDiagnostics`, which is the only place that position is argued for.
	for diagnostic in artifact.bindingHygieneDiagnostics 'eachHygiene'
		project.bindingHygieneDiagnostics.push(diagnostic)
	end 'eachHygiene'
end 'commitDiagnostics'

function noteDeclarationRefusedBy(project Project, diagnostic Diagnostic)
	match diagnostic.anchor 'anchor'
		at(filePath, line, _) then noteDeclarationRefusedAt(project, filePath: filePath, line: line, backing: PoisonBacking.backed)
		programWide or
		file then break
	end 'anchor'
end 'noteDeclarationRefusedBy'

module function noteDeclarationLostTo(project Project, filePath FilePath, poisoned PoisonedAt, backing PoisonBacking)
	match poisoned 'site'
		abandonedBody(number) then noteBodyAbandonedAt(project, filePath: filePath, line: number, backing: backing)
		line(number) then noteDeclarationRefusedAt(project, filePath: filePath, line: number, backing: backing)
	end 'site'
end 'noteDeclarationLostTo'

function noteDeclarationRefusedAt(project Project, filePath FilePath, line LineNumber, backing PoisonBacking)
	view tokens = try queryActiveTokens(project, path: filePath) otherwise return
	project.poison.noteRefusedDeclarationAt(filePath, line: line, tokens: tokens, backing: backing)
end 'noteDeclarationRefusedAt'

function noteBodyAbandonedAt(project Project, filePath FilePath, line LineNumber, backing PoisonBacking)
	view tokens = try queryActiveTokens(project, path: filePath) otherwise return
	project.poison.noteAbandonedBodyAt(filePath, line: line, tokens: tokens, backing: backing)
end 'noteBodyAbandonedAt'

// ⭐ **COMMIT EVERY TYPE-NAME DECLARATION, AND REPORT A NAME DECLARED TWICE.** The whole-program
// duplicate check for the TYPE namespace, exactly as `commitFuncSignatures` is for functions and for
// the same reason it lives at the merge rather than in the parser: a file-local check cannot see a
// second file, and the parser must stay pure. The rule itself is stated on `TypeNameRegistry`; this
// function only chooses the CODE and writes the text.
//
// ⚠ **WHICH CODE IS A PROPERTY OF THE PAIR, NOT OF THIS SITE.** E3061 says "two typealiases in scope
// declare the same name", so it is right exactly when BOTH declarations are typealiases.
// Everything else is E3006, the code a name declared twice already carries for a function and for a
// top-level `let`/`var` (`specs/static-variables.md`, where the kind of keyword is likewise
// irrelevant).
//
// Both arms blame the newcomer — its own file, its own name token — and name the incumbent's KEYWORD,
// which is the half that is invisible from the line being reported. The
// incumbent's PATH is deliberately not in the text: a second absolute path inside a message is
// machine-dependent and unmatchable in a `maxoncstderr` block.
function commitTypeNameDecls(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	reportTypeNameCollisions(project, collisions: project.typeNameDecls.recordAll(artifact.typeNameDecls, directories: signatures.settledDeclarations().fileModuleDirectories))
end 'commitTypeNameDecls'

// Type-name collision is not transitive — d1's `enum Box` collides with d2's, d2's collides with an alias
// `Box` in d2, yet d1's enum and d2's alias coexist — so which declarations are admitted depends on the
// order they are committed. Committing the file whose path identity sorts earliest first makes that order,
// and so the blame, the same on every host and for every spelling of the invocation. `entry.position`
// indexes `artifacts` because `parseEveryFile` returns one artifact per source path, in source-path order.
module function commitTypeNameDeclsInPathOrder(project Project, artifacts FileParseArtifactArray, pathOrder SourceFileInPathOrderArray, signatures ProgramSignatures)
	for entry in pathOrder 'eachInPathOrder'
		let artifact = try artifacts.get(entry.position) otherwise panic("commitTypeNameDeclsInPathOrder: artifacts.get OOB at {entry.position} below count {artifacts.count()}")
		commitTypeNameDecls(project, artifact: artifact, signatures: signatures)
	end 'eachInPathOrder'
end 'commitTypeNameDeclsInPathOrder'

typealias TypeNameDeclsByFile = Map with (String, TypeNameDeclArray)

module function nominalNameCollisionsOf(decls TypeNameDeclArray, paths FilePathArray, directories ModuleDirectoryByFile) returns TypeNameCollisionArray
	var collisions = TypeNameCollisionArray.create()

	if decls.isEmpty() 'nothingDeclared'
		return collisions
	end 'nothingDeclared'

	var byFile = TypeNameDeclsByFile.create()

	for decl in decls 'eachDecl'
		let file = decl.claim.declFilePath.toString()
		var declared = try byFile.get(file) otherwise TypeNameDeclArray.create()
		declared.push(decl)
		byFile.upsert(file, value: declared)
	end 'eachDecl'

	var registry = TypeNameRegistry.create()

	for entry in sourceFilesInPathOrder(paths) 'eachInPathOrder'
		let path = try paths.get(entry.position) otherwise panic("nominalNameCollisionsOf: paths.get OOB at {entry.position} below count {paths.count()}")
		view declared = try byFile.get(path.toString()) otherwise continue

		for collision in registry.recordAll(declared, directories: directories) 'eachCollisionHere'
			if isTypeAliasDecl(collision.decl.claim.kind) or isTypeAliasDecl(collision.winner.claim.kind) 'anAliasIsInvolved'
				continue
			end 'anAliasIsInvolved'

			collisions.push(collision)
		end 'eachCollisionHere'
	end 'eachInPathOrder'

	return collisions
end 'nominalNameCollisionsOf'

module function reportTypeNameCollisions(project Project, collisions TypeNameCollisionArray)
	for collision in collisions 'eachCollision'
		reportTypeNameCollision(project, decl: collision.decl, winner: collision.winner)
	end 'eachCollision'
end 'reportTypeNameCollisions'

module function sourceFilesInPathOrder(paths FilePathArray) returns SourceFileInPathOrderArray
	var ordered = SourceFileInPathOrderArray.create()
	let workingDirectory = Directory.currentPath()

	for (iter, path) in paths.withIterator() 'eachSourcePath'
		ordered.push(SourceFileInPathOrder.create(pathIdentity(path, workingDirectory: workingDirectory), position: iter.index()))
	end 'eachSourcePath'

	ordered.sort(function(left SourceFileInPathOrder, right SourceFileInPathOrder) gives compareBytesOrdinally(left.identity, right: right.identity))
	return ordered
end 'sourceFilesInPathOrder'

module type SourceFileInPathOrder
	export let identity as ByteArray
	export let position as ElementIndex

	static function create(identity ByteArray, position ElementIndex) returns SourceFileInPathOrder
		return Self{identity: identity, position: position}
	end 'create'
end 'SourceFileInPathOrder'

module typealias SourceFileInPathOrderArray = Array with SourceFileInPathOrder

// The two texts a collision can have, kept together because the CHOICE between them is the thing
// worth reading in one place.
function reportTypeNameCollision(project Project, decl TypeNameDecl, winner TypeNameDecl)
	// ⭐ **A NAME REPORTED HERE IS NOT ALSO REPORTED AS UNUSED.** Both declarations of a
	// `typealias Score` declared twice in one file are genuinely unused, so the drain would add two
	// E3062s on top of the one E3061 that actually explains the file — three diagnostics for one
	// mistake, and the two extra pointing at the wrong thing. An explicit set is what suppresses them: the
	// unused check runs at the parse and this one at the merge, so nothing structural separates the two.
	//
	// ⚠ **KEYED PER DECLARING FILE, and that is not caution — a bare name would suppress the wrong
	// file's diagnostic.** Two files may each legally declare a file-private `typealias Byte` (see
	// `TypeNameRegistry`), so one file declaring it twice would poison the name project-wide and
	// silently swallow another file's genuinely-unused `Byte`.
	project.collidedTypeNames.insert(fileScopedDeclKey(decl.name, declFilePath: decl.claim.declFilePath))

	if isTypeAliasDecl(decl.claim.kind) and isTypeAliasDecl(winner.claim.kind) 'bothAreTypeAliases'
		reportPositioned(project, code: ErrorCode.semanticDuplicateTypeAlias, message: "Duplicate typealias '{String.from(decl.name)}'", line: decl.nameLine, column: decl.nameColumn, filePath: decl.claim.declFilePath)
		return
	end 'bothAreTypeAliases'

	reportPositioned(project, code: ErrorCode.duplicateDefinition, message: "duplicate definition of '{String.from(decl.name)}' — already declared as `{typeDeclKeyword(winner.claim.kind)} {String.from(winner.name)}`", line: decl.nameLine, column: decl.nameColumn, filePath: decl.claim.declFilePath)
end 'reportTypeNameCollision'

// --- The COMPILED half of the same namespace: one emitted type name, one INSTANTIATION ---

// The compiled type names claimed so far by the instantiation walk, each holding the instance that
// claimed it FIRST — the incumbent a later instantiation of the same compiled name is reported
// against. Built only by `checkTypeSymbolNamespace`, and only for a program that instantiates a generic.
typealias CompiledTypeNameClaimMap = Map with (ByteArray, GenericInstanceId)

// Where a colliding instantiation was WRITTEN. A top-level `typealias X = Base with Args` records one
// (`ProgramSignatures.instantiationSites`); a NESTED instantiation and the compiler-synthesized array
// instances are interned without one.
union InstantiationAnchor
	anchored(site GenericInstantiationSite)
	unanchored
end 'InstantiationAnchor'

// ⭐⭐ **THE COMPILED TYPE-NAME NAMESPACE — one emitted name, one instantiation.** A generic
// instantiation has no source name, so the compiler builds one (`mangleGenericInstance` joins the base
// name to each argument's — `Box with String` ⇒ `Box_String`), and EVERY per-type symbol the backend
// emits is derived from that string — `__destruct_<name>`, `__layout_<name>`. Two instantiations that
// build the SAME string mint one symbol twice and the later install wins, silently, because `_` is a
// legal name character and the join is therefore NOT injective — `Pair with (Box_Int, Str)` and
// `Pair with (Box, Int_Str)` both compile to `Pair_Box_Int_Str`.
//
// ⚠ **THE OTHER HALF OF THAT COLLISION — a DECLARED `type Box_String` claiming the same string — IS NOT
// CHECKED HERE, BECAUSE IT CANNOT HAPPEN.** `mangleGenericInstance` mints a contested name behind the
// reserved `__` prefix instead, which no declaration may take (E2051), so the declared and compiled
// halves are disjoint by construction. Reporting it would reject a legal `type Array_Foo` in a program
// that merely writes an `[Foo…]` array literal — which interns `Array with Foo` — naming an
// instantiation that appears nowhere in its source. This pair check is the half a prefix cannot cure —
// there is no declaration to move out of the way.
//
// ⚠ **DECIDED HERE, IN THE FRONT END, AND NOT WHERE THE SYMBOL IS MINTED.** The mangling is consumed by
// the backend, but the NAMESPACE is a source-level fact and a collision must land on the `typealias` the
// author wrote. A diagnostic raised at symbol-emission time has no user span to land on and would blame
// a file the author never opened.
//
// Called once per compile from `compileToCodeResult`, after `queryProgramSignatures` has interned every
// instantiation — the same placement, and for the same reason, as `checkWhereConstraints`.
export function checkTypeSymbolNamespace(project Project, signatures ProgramSignatures)
	if project.poison.typeUniverseIsUnreadable() 'theUniverseIsUnreadable'
		return
	end 'theUniverseIsUnreadable'

	let instantiationCount = signatures.genericInstanceCount()

	// A program that instantiates no generic claims no compiled name and can contest nothing. That is
	// the whole generics-free corpus, and it leaves here having allocated nothing whatever.
	if instantiationCount == 0 'noInstantiations'
		return
	end 'noInstantiations'

	// Walked in gid order, which is intern order and therefore source-path order over the sweep — so
	// which instantiation of a colliding pair is the NEWCOMER is a property of the program rather than
	// of a map's iteration.
	var claimed = CompiledTypeNameClaimMap.create()

	for gid in 0 upto instantiationCount 'eachInstantiation'
		if instanceNamesATypeFromAFailedFile(project, signatures: signatures, gid: gid) 'aTypeOfAFileThatFailedToParse'
			continue
		end 'aTypeOfAFileThatFailedToParse'

		view compiled = signatures.mangleGenericInstance(gid)

		// A rejected newcomer is deliberately NOT recorded: the incumbent stays the one every later
		// instantiation is measured against, which is `TypeNameRegistry`'s own rule (a rejected
		// declaration never displaces) applied to the compiled half.
		if let incumbent = try claimed.get(compiled) 'earlierInstantiation'
			reportInstantiationPairCollision(project, signatures: signatures, compiled: compiled, incumbent: incumbent, newcomer: gid)
			continue
		end 'earlierInstantiation'

		claimed.upsert(compiled, value: gid)
	end 'eachInstantiation'
end 'checkTypeSymbolNamespace'

// ⭐ **A GENERIC ALIAS WHOSE TYPE ARGUMENTS LEAD BACK TO IT IS REFUSED (E2012, or E3091 when no path is
// provable).** `typealias A = Box with A`, and the mutual `A = Box with B` / `B = Box with A`, describe
// INFINITE types: no finite layout and no finite compiled name.
//
// Blamed at the DECLARATION rather than at a use, because the declaration is the ill-formed thing and a
// cycle is ill-formed whether or not anyone instantiates it. Run BEFORE the pipeline (so before
// `semanticCheck`), which is also what guarantees no later reader has to survive a cycle.
export function checkGenericAliasCycles(project Project, signatures ProgramSignatures)
	if project.poison.typeUniverseIsUnreadable() 'theUniverseIsUnreadable'
		return
	end 'theUniverseIsUnreadable'

	match signatures.firstCyclicAliasDecl() 'cycle'
		none then return
		at(index) then reportGenericAliasCycle(project, entry: signatures.genericAliasDeclAt(index), path: signatures.aliasCyclePath(index))
	end 'cycle'
end 'checkGenericAliasCycles'

// ⭐⭐ **REPORT THE CYCLE — E2012 WITH THE DEPENDENCY PATH, WHICH IS `specs/type-checking.md`'s OWN SENTENCE.**
// `Circular typealias dependency: A -> B -> A` names every alias the loop passes through, and that path is
// the whole reason the canonical corpus carries two cases: a message naming only the alias it was reported
// against says identical words for `typealias A = Array with A` and for the mutual pair, so the mutual case
// would stop testing mutuality.
//
// ⚠ **A SELF-CYCLE IS BLAMED AT THE OCCURRENCE AND A LONGER ONE AT THE DECLARATION, and that is a difference
// in what is at fault rather than an inconsistency.** When an alias names ITSELF, one word in one RHS is the
// defect and the author can point at it — the canonical spec pins column 26 of `typealias A = Array with A`,
// the second `A` (`GenericAliasEntry.selfRefLine` is how that position survives the parse). When the loop
// runs through OTHER aliases, no single occurrence is wrong: each RHS is individually well-formed and what
// is ill-formed is the SET, so the blame lands on the declaration the cycle is reported against — column 11,
// the alias name — and the PATH is what names the rest.
//
// ⚠ **AN EMPTY PATH IS THE OTHER DOOR, NOT A MISSING PATH.** `firstCyclicAliasDecl` also answers for a
// CROSS-FILE cycle the instance graph structurally cannot see, caught instead by the contest fixpoint failing
// to converge. Nothing there proves a cycle or names its members, so it keeps E3091 and the sentence that
// says what IS known — which `typealias-file-scope.md`'s own prose ratifies (*"the non-convergence IS the
// detection"*). The code and the words follow from what the compiler can prove.
//
// A SYNTHESIZED alias carries no anchor (`unanchored`), so it falls back to the whole-program form
// `reportInstantiationPairCollision` uses for the same reason — pointing into a file the user never wrote
// would be worse than not pointing at all.
function reportGenericAliasCycle(project Project, entry GenericAliasEntry, path NameRoster)
	if path.isEmpty() 'noCycleTheGraphCanProve'
		reportUnsettledAliasResolution(project, entry: entry)
		return
	end 'noCycleTheGraphCanProve'

	let namesOnlyItself = path.count() == 1
	let message = "Circular typealias dependency: {renderAliasCyclePath(path)}"

	match entry.anchor 'anchor'
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.programWide(ErrorCode.parserCircularDependency, message: message))
		declaredAt(nameLine, nameColumn, selfRefLine, selfRefColumn) then reportPositioned(project, code: ErrorCode.parserCircularDependency, message: message, line: selfRefLine if namesOnlyItself else nameLine, column: selfRefColumn if namesOnlyItself else nameColumn, filePath: entry.filePath)
	end 'anchor'
end 'reportGenericAliasCycle'

// `A` for a one-node cycle, `A -> B -> A` for a longer one. The single name is not a TRUNCATED path: an alias
// that names itself has no intermediate to show, and `A -> A` would repeat the one fact the name already
// carries. `specs/type-checking.md` pins both spellings, one case each.
function renderAliasCyclePath(path NameRoster) returns String
	let first = String.from(try path.get(0) otherwise panic("renderAliasCyclePath: an empty path is the other door and is filtered by the caller"))

	if path.count() == 1 'namesOnlyItself'
		return first
	end 'namesOnlyItself'

	var rendered = "{first}"

	for i in 1 upto path.count() 'eachFurtherAlias'
		rendered = "{rendered} -> {String.from(try path.get(i) otherwise panic("renderAliasCyclePath: path.get({i}) below its own count()"))}"
	end 'eachFurtherAlias'

	return "{rendered} -> {first}"
end 'renderAliasCyclePath'

// The CROSS-FILE door's diagnostic (E3091): resolution of this alias never settled, and the walk that would
// name the loop cannot see it. It says what is known and no more — there is no path to quote, which is the
// difference the caller's header states.
function reportUnsettledAliasResolution(project Project, entry GenericAliasEntry)
	let message = "typealias '{String.from(entry.aliasName)}' forms a type cycle: its type arguments refer back to '{String.from(entry.aliasName)}'"

	match entry.anchor 'anchor'
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.programWide(ErrorCode.semanticTypeResolutionCycle, message: message))
		declaredAt(nameLine, nameColumn, _, _) then reportPositioned(project, code: ErrorCode.semanticTypeResolutionCycle, message: message, line: nameLine, column: nameColumn, filePath: entry.filePath)
	end 'anchor'
end 'reportUnsettledAliasResolution'

// Two instantiations that compile to one name — the shape no declaration takes part in, which the
// join's non-injectivity makes possible on its own.
function reportInstantiationPairCollision(project Project, signatures ProgramSignatures, compiled ByteArray, incumbent GenericInstanceId, newcomer GenericInstanceId)
	let message = "duplicate definition of '{String.from(compiled)}' — the generic instantiations `{renderInstantiation(signatures, gid: incumbent)}` and `{renderInstantiation(signatures, gid: newcomer)}` compile to that same name"

	match instantiationAnchor(signatures, newcomer: newcomer, incumbent: incumbent) 'anchor'
		anchored(site) then reportPositioned(project, code: ErrorCode.duplicateDefinition, message: message, line: site.nameLine, column: site.nameColumn, filePath: site.filePath)

		// No `typealias` names EITHER instantiation, so both are nested (`Box with (Pair with …)`) and
		// neither was interned with an anchor. Whole-program then — the anchorless form E3001 uses —
		// rather than pointing at an enclosing alias whose own instantiation is fine.
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.programWide(ErrorCode.duplicateDefinition, message: message))
	end 'anchor'
end 'reportInstantiationPairCollision'

// The site a pair collision is reported at: the NEWCOMER's `typealias` if one names it, else the
// INCUMBENT's, else none.
//
// ⚠ **A LINEAR SCAN OF THE SITE LIST, DELIBERATELY.** It is asked only once a collision has already
// been found — never on a program that compiles — so a gid⇒site index would cost every build to serve
// none. One pass answers both halves: a newcomer hit returns at once, and an incumbent hit is retained
// as the fallback.
function instantiationAnchor(signatures ProgramSignatures, newcomer GenericInstanceId, incumbent GenericInstanceId) returns InstantiationAnchor
	var fallback = InstantiationAnchor.unanchored

	for site in signatures.instantiationSites() 'eachSite'
		if site.gid == newcomer 'namesTheNewcomer'
			return InstantiationAnchor.anchored(site)
		end 'namesTheNewcomer'

		if site.gid == incumbent 'namesTheIncumbent'
			fallback = InstantiationAnchor.anchored(site)
		end 'namesTheIncumbent'
	end 'eachSite'

	return fallback
end 'instantiationAnchor'

// A colliding instantiation spelled back out the way its author wrote it — `Box with String`,
// `Pair with (Box_Int, Str)`. A single argument takes no parentheses and a list does, matching the
// source form (`specs/generic-types.md`).
//
// The arguments come through `instanceArgCompiledName` — the IDENTITY renderer and deliberately not the
// display one — so a NESTED instantiation appears in its own
// COMPILED spelling (`Box with Pair_Int_Bool`) rather than as `Box with (Pair with (Int, Bool))`. That
// is the right rendering and not a shortcut: the compiled spelling is what collided, and the source
// form would hide the very join the message is about.
function renderInstantiation(signatures ProgramSignatures, gid GenericInstanceId) returns String
	let argCount = signatures.genericInstanceArgCount(gid)
	var rendered = "{String.from(signatures.genericInstanceBaseName(gid))} with "

	if argCount > 1 'openArgumentList'
		rendered.append("(")
	end 'openArgumentList'

	for position in 0 upto argCount 'eachArgument'
		if position > 0 'afterFirst'
			rendered.append(", ")
		end 'afterFirst'

		if signatures.genericInstanceArgIsReadOnly(gid, position: position) 'readOnlyArgument'
			rendered.append("{String.from(ReadonlyModifierWord)} ")
		end 'readOnlyArgument'

		rendered.append(String.from(signatures.instanceArgCompiledName(gid, position: position)))
	end 'eachArgument'

	if argCount > 1 'closeArgumentList'
		rendered.append(")")
	end 'closeArgumentList'

	return rendered
end 'renderInstantiation'

// Commit the artifact's declared struct types into the project registry — the registry
// `TypeResolution.resolveNamedType` turns a `MaxonType.named` for a declared `type` into a
// `structRef` against.
//
// A plain upsert, and it stays one: a second `type` of the same name is refused by
// `commitTypeNameDecls`, which fails the build, so the overwrite is never observed.
//
// ⚠ **AND IT DOES NOT ASK `Project.declarationContestsACompilerOwnedName` WHILE `commitEnumTypes`
// DIRECTLY BELOW DOES — THE ASYMMETRY IS PROVED, NOT OVERLOOKED.** That rule drops a
// declaration of a compiler-owned type name from anyone but the corpus, and it belongs at a write a
// TOLERANT walk can reach: `ProgramSignatures.recordStruct` is fed by the declaration SWEEP, which folds
// a user's `type String` in before the real parse refuses it. This write is not that. Its two feeders are
// `Parser.parseTypeDeclaration`, which calls `requireTypeNameNotCompilerOwned` (E2015) BEFORE it mints
// the layout, and `Parser.internTupleLayout`, whose names are synthesized `__Tuple…` spellings that are
// compiler-owned under no reading — and an aborted parse contributes `typeNameDecls` alone
// (`Parser.abortedParseArtifact`), so a refused declaration cannot arrive here by the error path either.
// ⇒ **a contested layout cannot reach this loop**, and a drop written here would be unreachable rather
// than defensive. The enum twin's call is not the same shape: `upsertDeclaredEnum` is the ONE upsert both
// enum registries share, so the rule rides it once for the sweep's sake and this site inherits it.
function commitStructTypes(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	for layout in artifact.structTypes 'each'
		project.structTypes.upsert(layout.name, value: committedStructLayout(layout, signatures: signatures))
	end 'each'
end 'commitStructTypes'

// An inline record's packing is settled from this compile's widths onto a clone, because the
// layout is the parse artifact's. `MmRuntime.installStructRuntimeEntries` stamps the runtime's
// entries off `project.structTypes`, and left unsettled it answers a box's `sizeBytes()` for a
// type whose value is a word.
function committedStructLayout(layout StructLayout, signatures ProgramSignatures) returns StructLayout
	if not signatures.nameIsInlineRecord(layout.name) 'aHeapRecord'
		return layout
	end 'aHeapRecord'

	var settled = layout.clone()
	settled.settleInlinePacking(signatures.inlineBitWidthsOf(layout.name))
	return settled
end 'committedStructLayout'

function commitWrittenTupleTypes(project Project, artifact FileParseArtifact)
	for written in artifact.writtenTupleTypes 'each'
		project.writtenTupleTypes.push(written)
	end 'each'
end 'commitWrittenTupleTypes'

// Commit the artifact's declared enum/union types into the project registry — the registry
// `TypeResolution.resolveNamedType` reads to resolve a `MaxonType.named` naming a declared
// `enum`/`union` to `integer`. A plain upsert, matching `commitStructTypes` and unobservable on a
// collision for its reason.
function commitEnumTypes(project Project, artifact FileParseArtifact)
	for layout in artifact.enumTypes 'each'
		upsertDeclaredEnum(project.enumTypes, layout: layout, declaredByTheCorpus: artifact.livesUnderStdlibDirectory)
	end 'each'
end 'commitEnumTypes'

// Commit the artifact's declared `interface`s into the project registry — a plain
// upsert keyed by name, matching `commitEnumTypes` and unobservable on a collision for its reason.
function commitInterfaces(project Project, artifact FileParseArtifact)
	for iface in artifact.interfaces 'each'
		project.interfaces.entries.upsert(iface.name, value: iface)
	end 'each'
end 'commitInterfaces'

// Commit the artifact's `implements` conformance declarations into `project.conformances`. A PUSH,
// not an upsert: each is a distinct declaration site (its own type-name position),
// and `checkConformance` drains them all. `resetMergeTargets` clears the array so a warm rebuild does
// not double it (the same discipline `commitPendingFnMergeChecks` follows).
function commitConformances(project Project, artifact FileParseArtifact)
	for conformance in artifact.conformances 'each'
		project.conformances.push(conformance)
	end 'each'
end 'commitConformances'

// Commit the artifact's `<Type> from "…"` construction sites into `project.literalInitSites` — a PUSH,
// for `commitConformances`' reason: each is a distinct source position and
// `checkLiteralInitConformance` drains them all.
function commitLiteralInitSites(project Project, artifact FileParseArtifact)
	for site in artifact.literalInitSites 'each'
		project.literalInitSites.push(site)
	end 'each'
end 'commitLiteralInitSites'

// Commit the artifact's literal-inferred instantiation sites into `project.inferredInstantiationSites`
// — a PUSH, for `commitLiteralInitSites`' reason: two literals over one instance are two
// positions to report, and `checkWhereConstraints` drains them all.
//
// ⚠ **THE gid NEEDS NO FILE SCOPING, unlike the alias sites `rekeyScopedGenericAliases` rebuilds.** That
// re-keying exists because two files may declare the same alias NAME over different instances, so a site
// recorded during the sweep may name the wrong one. A literal has no alias name at all: its instance is
// interned from the column types the parser itself resolved in the reading file, so the gid it carries is
// already the one that file means.
function commitInferredInstantiationSites(project Project, artifact FileParseArtifact)
	for site in artifact.inferredInstantiationSites 'each'
		project.inferredInstantiationSites.push(site)
	end 'each'
end 'commitInferredInstantiationSites'

// Commit the artifact's range-check contributions into `project.rangeChecks` — a plain
// upsert keyed by function name, which is UNIQUE per program (the whole-program E3006 check runs
// in `commitFuncSignatures`), so no collision handling is needed. Read by `InsertRangeChecks`.
function commitRangeChecks(project Project, artifact FileParseArtifact)
	for entry in artifact.rangeChecks 'each'
		project.rangeChecks.upsert(entry.name, value: entry.checks)
	end 'each'
end 'commitRangeChecks'

function commitTypeAliases(project Project, artifact FileParseArtifact)
	for alias in artifact.typeAliases 'each'
		project.typeAliases.record(alias)
	end 'each'
end 'commitTypeAliases'

// Commit the artifact's FUNCTION typealiases into the project registry — the twin of
// `commitTypeAliases`, remap-free (a function alias carries no interner ids).
//
// A declaration of a SHAPE-CONTESTED name is committed under this file's mint alone — the key every scoped
// door hands on — and every other declaration under its bare name.
function commitFunctionTypeAliases(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	for alias in artifact.functionTypeAliases 'each'
		let scoped = signatures.functionAliasScopedName(alias.name, readerFilePath: alias.declFilePath)

		if scoped.equals(alias.name) 'noShapeContestHoldsTheName'
			project.functionTypeAliases.upsert(alias.name, value: alias)
		end 'noShapeContestHoldsTheName' else 'thisFilesOwnShapeAnswersUnderItsOwnKey'
			project.functionTypeAliases.upsert(scoped, value: alias.underName(scoped))
		end 'thisFilesOwnShapeAnswersUnderItsOwnKey'
	end 'each'
end 'commitFunctionTypeAliases'

// ⭐⭐ **MAKE EVERY TYPE ID THIS ARTIFACT HOLDS THE MERGED PROGRAM'S — NAMES ONCE, INSTANCES ON EVERY FOLD.**
//
// NAMES are this file's own interner's, folded into `project.typeNames` the first time the artifact is merged:
// `typeIdsAreProjectGlobal` says it happened, and it stays true because `Queries.resetMergeTargets` never resets
// that interner.
//
// INSTANCES are the rows this file's parse minted, re-adopted by every fold: the index is restored to its
// baseline before each fold, and after an edit elsewhere it is a different index altogether, so a row's id is
// whatever THIS merge's file order gives it. A file a fold keeps is re-adopted by
// `replayMergedArtifact`, which must land on the ids its merged ops already carry.
//
// ⚠ **A RENUMBERING IS APPLIED IN PLACE, AND ONE RECORD CAN BE REACHED TWICE** (a binding filed in several
// places), so a renumbering must not move an id it already moved. An instance renumbering is safe when no id it
// moves FROM is one it moves TO — true of the parse's band ids, which no merge assigns — and otherwise it is
// taken through the band in two walks. A name renumbering is applied once, and per binding at most once
// (`VarInfo.renumberedIn`).
function renumberArtifact(project Project, artifact FileParseArtifact, signatures ProgramSignatures)
	let adopted = adoptedInstanceIds(artifact, signatures: signatures)
	let names = TypeIdRemap.unmoved() if artifact.typeIdsAreProjectGlobal else project.typeNames.foldInto(artifact.typeNames)
	artifact.typeIdsAreProjectGlobal = true

	var moves = InstanceMoves.create()

	for position in 0 upto artifact.instanceIdsInUse.count() 'eachRow'
		let inUse = try artifact.instanceIdsInUse.get(position) otherwise panic("renumberArtifact: instanceIdsInUse.get OOB at {position}")
		let target = try adopted.get(position) otherwise panic("renumberArtifact: the merge adopted {adopted.count()} rows of an artifact holding {artifact.instanceIdsInUse.count()}")
		moves.add(inUse, target: target, scratch: BandInstanceIdBase + position)
	end 'eachRow'

	moves.applyTo(project, artifact: artifact, names: names)
	artifact.instanceIdsInUse = adopted
end 'renumberArtifact'

type InstanceMoves
	var direct as GenericInstanceIdMap
	var intoTheBand as GenericInstanceIdMap
	var outOfTheBand as GenericInstanceIdMap
	var targets as GenericInstanceIdSet

	static function create() returns InstanceMoves
		return Self{direct: GenericInstanceIdMap.create(), intoTheBand: GenericInstanceIdMap.create(), outOfTheBand: GenericInstanceIdMap.create(), targets: GenericInstanceIdSet.create()}
	end 'create'

	function add(inUse GenericInstanceId, target GenericInstanceId, scratch GenericInstanceId)
		if inUse != target 'moves'
			self.direct.upsert(inUse, value: target)
			self.intoTheBand.upsert(inUse, value: scratch)
			self.outOfTheBand.upsert(scratch, value: target)
			self.targets.insert(target)
		end 'moves'
	end 'add'

	function movesOntoAMovedId() returns bool
		for (source, _) in self.direct 'eachMove'
			if self.targets.contains(source) 'aSourceIsATarget'
				return true
			end 'aSourceIsATarget'
		end 'eachMove'

		return false
	end 'movesOntoAMovedId'

	function applyTo(project Project, artifact FileParseArtifact, names TypeIdRemap)
		if self.movesOntoAMovedId() 'throughTheBand'
			rewriteTypeIds(project, artifact: artifact, remap: TypeIdRemap.unmoved().movingInstances(self.intoTheBand))
			rewriteTypeIds(project, artifact: artifact, remap: names.movingInstances(self.outOfTheBand))
		end 'throughTheBand' else 'direct'
			rewriteTypeIds(project, artifact: artifact, remap: names.movingInstances(self.direct))
		end 'direct'
	end 'applyTo'
end 'InstanceMoves'

export function rebaseArtifact(project Project, artifact FileParseArtifact, rebase ParseRebase)
	var moves = InstanceMoves.create()
	var scratch = BandInstanceIdBase + (artifact.instanceIdsInUse.count() as GenericInstanceId)

	for (original, current) in rebase.instances 'eachBaselineRow'
		moves.add(original, target: current, scratch: scratch)
		scratch = scratch + 1
	end 'eachBaselineRow'

	moves.applyTo(project, artifact: artifact, names: TypeIdRemap.unmoved().movingInterfaces(rebase.interfaces.clone()))
end 'rebaseArtifact'

// The id each of the artifact's parse rows is adopted under by this merge — every artifact no real parse built
// has none.
function adoptedInstanceIds(artifact FileParseArtifact, signatures ProgramSignatures) returns GenericInstanceIdArray
	return match artifact.parseMints 'mints'
		none gives GenericInstanceIdArray.create()
		minted(mints) gives signatures.adoptParseMints(mints)
	end 'mints'
end 'adoptedInstanceIds'

// Rewrite every type id the artifact holds through `remap`. The list is every id-bearing place a parse fills,
// whether or not a pass after the merge reads it today: an id left stale is a wrong answer waiting for its first
// reader.
function rewriteTypeIds(project Project, artifact FileParseArtifact, remap TypeIdRemap)
	if not remap.movesAnything() 'nothingMoves'
		return
	end 'nothingMoves'

	project.lastRenumbering = project.lastRenumbering + 1
	let epoch = project.lastRenumbering

	for i in 0 upto artifact.module.functions.count() 'eachFunc'
		var func = try artifact.module.functions.get(i) otherwise panic("rewriteTypeIds: functions.get OOB at {i}")
		func.renumberTypeIds(remap, epoch: epoch)
	end 'eachFunc'

	for position in 0 upto artifact.module.ops.count() 'eachOp'
		var op = try artifact.module.ops.get(position) otherwise panic("rewriteTypeIds: ops.get OOB at {position}")
		try artifact.module.ops.set(position, value: renumberedOp(op, remap: remap)) otherwise panic("rewriteTypeIds: ops.set OOB at {position}")
	end 'eachOp'

	for j in 0 upto artifact.funcSignatures.count() 'eachSignatureEntry'
		var entry = try artifact.funcSignatures.get(j) otherwise panic("rewriteTypeIds: funcSignatures.get OOB at {j}")
		entry.signature.renumberTypeIds(remap)
		entry.returnType = remapMaxonReturnType(entry.returnType, remap: remap)
	end 'eachSignatureEntry'

	var aliases = FunctionTypeAliasArray.create()

	for alias in artifact.functionTypeAliases 'eachFunctionAlias'
		aliases.push(alias.withInstancesRenumbered(remap))
	end 'eachFunctionAlias'

	artifact.functionTypeAliases = aliases

	var renumberedInterfaces = IrInterfaceArray.create()

	for iface in artifact.interfaces 'eachInterface'
		renumberedInterfaces.push(iface.withInstancesRenumbered(remap))
	end 'eachInterface'

	artifact.interfaces = renumberedInterfaces

	var renumberedConformances = ConformanceDeclArray.create()

	for decl in artifact.conformances 'eachConformance'
		renumberedConformances.push(decl.withInstancesRenumbered(remap))
	end 'eachConformance'

	artifact.conformances = renumberedConformances

	for layout in artifact.structTypes 'eachStruct'
		remapStructLayoutFieldTypes(layout, remap: remap)
	end 'eachStruct'

	for layout in artifact.enumTypes 'eachEnum'
		remapEnumLayoutPayloadTypes(layout, remap: remap)
	end 'eachEnum'

	var sites = GenericInstantiationSiteArray.create()

	for site in artifact.inferredInstantiationSites 'eachInferredSite'
		sites.push(GenericInstantiationSite.create(remap.applyInstance(site.gid), nameLine: site.nameLine, nameColumn: site.nameColumn, filePath: site.filePath))
	end 'eachInferredSite'

	artifact.inferredInstantiationSites = sites
end 'rewriteTypeIds'

export function footprintOf(project Project, artifact FileParseArtifact, signatures ProgramSignatures) returns ParseFootprint
	if artifact.typeIdsAreProjectGlobal 'alreadyMerged'
		panic("footprintOf: a stashed artifact already carries program-wide name ids — a parse is stashed before its merge, while every name id it holds is its own file's")
	end 'alreadyMerged'

	var moduleWatcher = TypeIdRemap.watching(FileLocalNamesBase)
	rewriteTypeIds(project, artifact: artifact, remap: moduleWatcher)

	var instances = GenericInstanceIdSet.create()
	var names = ObservedNameSet.create()
	var interfaces = ObservedInterfaceSet.create()
	absorbWatched(moduleWatcher, instances: instances, names: names, interfaces: interfaces)

	match artifact.parseMints 'mints'
		none then break
		minted(mints) then watchMints(mints, instances: instances, names: names, interfaces: interfaces)
	end 'mints'

	return signatures.footprintOf(instances, names: names, dispatchedInterfaces: interfaces)
end 'footprintOf'

function watchMints(mints LocalInstanceMints, instances GenericInstanceIdSet, names ObservedNameSet, interfaces ObservedInterfaceSet)
	var watcher = TypeIdRemap.watching(mints.typeNameBaseline)
	mints.watchedBy(watcher)
	absorbWatched(watcher, instances: instances, names: names, interfaces: interfaces)
end 'watchMints'

function absorbWatched(watcher TypeIdRemap, instances GenericInstanceIdSet, names ObservedNameSet, interfaces ObservedInterfaceSet)
	for id in watcher.seenInstances 'eachInstance'
		instances.insert(id)
	end 'eachInstance'

	for id in watcher.seenNames 'eachName'
		names.insert(id)
	end 'eachName'

	for index in watcher.seenInterfaces 'eachInterface'
		interfaces.insert(index)
	end 'eachInterface'
end 'absorbWatched'

// The op with the type it carries renumbered. Four variants carry a type and the two witness
// dispatches an interface declaration index; every other carries none.
function renumberedOp(op MaxonOp, remap TypeIdRemap) returns MaxonOp
	return match op 'op'
		literal(result, value, valueType) gives MaxonOp.literal(result, value: value, valueType: remapMaxonType(valueType, remap: remap))
		loadIndirect(result, addr, offset, valueType) gives MaxonOp.loadIndirect(result, addr: addr, offset: offset, valueType: remapMaxonType(valueType, remap: remap))
		storeIndirect(addr, offset, value, valueType) gives MaxonOp.storeIndirect(addr, offset: offset, value: value, valueType: remapMaxonType(valueType, remap: remap))
		sizeofType(result, targetType) gives MaxonOp.sizeofType(result, targetType: remapMaxonType(targetType, remap: remap))
		witnessDispatch(result, args, argImmutableNames, witness, methodIndex, interfaceDeclIndex, isVoid, isThrowing) gives MaxonOp.witnessDispatch(result, args: args, argImmutableNames: argImmutableNames, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: remap.applyInterface(interfaceDeclIndex), isVoid: isVoid, isThrowing: isThrowing)
		witnessTryDispatch(result, errorFlag, args, argImmutableNames, witness, methodIndex, interfaceDeclIndex, isVoid) gives MaxonOp.witnessTryDispatch(result, errorFlag: errorFlag, args: args, argImmutableNames: argImmutableNames, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: remap.applyInterface(interfaceDeclIndex), isVoid: isVoid)
		call or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		constArrayLiteral or
		switch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives op
	end 'op'
end 'renumberedOp'

// Commit the artifact's `funcSignatures` contributions into the project registry,
// detecting DUPLICATE FUNCTION DEFINITIONS. A name already in the registry — from an
// earlier file, or an earlier declaration in THIS file (both entries sit in this array in
// declaration order) — is a duplicate: a plain `upsert` would SILENTLY overwrite the first
// entry, and a call would then validate against (and lower to) the WRONG signature. So one
// declaration is kept and each other is reported at its own name (E3006);
// `newcomerDisplacesTheFloor` decides which. This is the single whole-program duplicate check: every
// function the parser builds records exactly one signature entry here.
function commitFuncSignatures(project Project, artifact FileParseArtifact)
	for entry in artifact.funcSignatures 'each'
		if project.funcSignatures.contains(entry.name) 'duplicate'
			project.poison.noteDuplicatedFunction(entry.name)

			// ⚠ **A SYNTHESIZED FUNCTION'S DUPLICATE IS THE SHADOW OF ONE THE AUTHOR CAN SEE, AND IS NOT
			// REPORTED TWICE.** See `FuncSignatureEntry.synthesized` for why the two always arrive
			// together. Reporting it would add, beside the correct `Duplicate function 'f'`, a second E3006
			// naming `__paramDefault#f#0` — a symbol absent from the source. The kept entry is still chosen
			// exactly as for a reported duplicate: the two paths differ in what they SAY, never in what the
			// registry holds.
			view blamed = blamedFunctionDeclaration(project, newcomer: entry)

			if not blamed.synthesized 'theAuthorWroteThisName'
				reportPositioned(project, code: ErrorCode.duplicateDefinition, message: duplicateFunctionMessage(project, name: blamed.name, declFilePath: blamed.sourceFilePath), line: blamed.nameLine, column: blamed.nameColumn, filePath: blamed.sourceFilePath)
			end 'theAuthorWroteThisName'

			continue
		end 'duplicate'

		holdFunctionFloor(project, entry: entry)
	end 'each'
end 'commitFuncSignatures'

// The merge's one writer of these three registries, so the kept declaration's signature and return type
// always come from the same declaration.
function holdFunctionFloor(project Project, entry FuncSignatureEntry)
	project.funcSignatures.upsert(entry.name, value: entry.signature)
	project.funcReturnTypes.upsert(entry.name, value: entry.returnType)
	project.funcSignatureFloors.upsert(entry.name, value: entry)
end 'holdFunctionFloor'

function blamedFunctionDeclaration(project Project, newcomer FuncSignatureEntry) returns FuncSignatureEntry
	var floor = try project.funcSignatureFloors.get(newcomer.name) otherwise panic("blamedFunctionDeclaration: '{String.from(newcomer.name)}' is in funcSignatures, and every name committed there has its floor committed beside it")

	if newcomerDisplacesTheFloor(newcomer, floor: floor) 'theFloorIsBlamed'
		holdFunctionFloor(project, entry: newcomer)
		return floor
	end 'theFloorIsBlamed'

	return newcomer
end 'blamedFunctionDeclaration'

// Role decides before path: a contested free function's `<directory>.<name>` key colliding with a
// method's always blames the free function, because that E3006 text tells its author to rename the
// directory or the function. Otherwise the file whose path identity sorts earliest keeps the name, so the
// blame is the same on every host and for every spelling of the invocation.
function newcomerDisplacesTheFloor(newcomer FuncSignatureEntry, floor FuncSignatureEntry) returns bool
	if newcomer.role != floor.role 'twoRoles'
		return floor.role == FunctionDeclarationRole.contestedFreeFunction
	end 'twoRoles'

	return precedesInPathOrder(newcomer.sourceFilePath, other: floor.sourceFilePath)
end 'newcomerDisplacesTheFloor'

// ⭐⭐ **WHY ONE NAME HAS TWO DECLARATIONS — and the CONTESTED case earns its own sentence because the name
// the message quotes is one NEITHER declaration wrote.**
//
// E3006 already carries a sentence per KIND of duplicate, each at the site that owns that kind; this is the
// same discipline applied to the one kind whose name is SYNTHESIZED. A free function contested across
// directories is filed as `<directory>.<name>` — the same construction, and the same flat key space, a
// method is filed under — so a `create` in a directory called `Point/` collides with `type Point`'s own
// `create`. Told only "Duplicate function 'Point.create'", the author searches for a string that appears
// nowhere in their source and finds two declarations that do not look like duplicates of each other. The
// fix is a rename on either side, and it has to be said, because it is not inferable from the name.
//
// ⭐⭐ **THE SECOND SYNTHESIZED-NAME KIND IS A CONTESTED `extension` METHOD**, and it earns its
// own sentence for the identical reason one kind up. A `<Conformer>.<method>` declared by extensions in more
// than one FILE is registered by every one of them under its parameter-type spelling — nobody keeps the bare
// name — so two declarations of one signature claim `Array.contains#Element` and collide there. That is the
// refusal working exactly as designed (`Parser.overloadRegistrationNameFor`), but the name it names is one
// no declaration wrote, and the fix — change the PARAMETERS, or the name — is not inferable from it.
//
// ⭐ **AND THE THIRD IS A `static` MEMBER BESIDE AN INSTANCE MEMBER OF ONE NAME** (`same-name-methods.md`),
// whose static side is filed as `<name>#__static`. Same reason again; see its arm below.
//
// ⛔ **THE PLAIN SENTENCE'S WORDING IS THE CANONICAL ONE AND IS NOT OURS TO CHOOSE** — `Duplicate function
// 'X'` is what `/specs/duplicate-functions.md` states the language emits for a plain redefinition.
//
// ⚠ **THE MANGLED SENTENCES ARE COMPILER-SPECIFIC SITUATIONS CANONICAL DOES NOT COVER, and the citation below is
// to the REGISTER, not to a spelling.** `/specs` does carry a `duplicate definition of 'X' - <why they
// collide>` register for a name collision after mangling (`function-overloads.md:821`,
// `generic-instance-names.md:238`) — but that is its own sentence for its own situation, and no canonical
// text spells any of the three below. Nothing here may be described as "matching canonical": these say
// `duplicate definition of function 'X' — …`, which is a fourth spelling, and the compiler's generic-instance
// sentence (`reportInstantiationPairCollision`) is a fifth. Reconciling the wordings is a decision about ALL
// of them at once, never about one member alone.
//
// ⛔ **WHAT MUST NOT CHANGE IS THE SPLIT, whatever the wordings settle on.** A plain redefinition tells the
// author to DELETE a definition; a mangled collision tells them to RENAME a spelling. Folding these into one
// sentence would erase the only thing that distinguishes those two fixes.
//
// ⚠ The index is taken through the memo `compileToCodeResult` fills before the pipeline runs — merge is
// downstream of it, so this can only ever be the hit, exactly as `SemanticCheck.programSignaturesIn` argues
// for its own three askers.
//
// ⭐⭐ **THE SORT IS ON A PROPERTY, NOT ON AN ENUMERATION OF KINDS, and that is the correctness of it.** The
// plain sentence is earned by `name` BEING the name a declaration wrote — never by failing to match the
// mangled kinds this function happens to know about. The set of names the parser MINTS is larger than any
// list kept here: an ordinary same-file overload set whose member is redeclared with identical parameters is
// handed the incumbent's minted name (`Parser.overloadMemberHoldingSignature`), which matches neither
// contested test. An enumeration would give two declarations of `pick(x bool)` beside a `pick(x Integer)`
// the canonical `Duplicate function 'pick#bool'`, quoting a symbol that appears nowhere in the program.
// Pinned by `function-overloads/error.overload-redeclared-with-the-same-parameters`.
//
// ⇒ A new mint nobody classifies lands on a mangled sentence and says what the author WROTE, which is
// imprecise rather than wrong.
function duplicateFunctionMessage(project Project, name ByteArray, declFilePath FilePath) returns String
	var signatures = try queryProgramSignatures(project) otherwise panic("duplicateFunctionMessage:queryProgramSignatures failed during merge — the whole-program index is computed and memoized before the pipeline runs, so a merge-time ask cannot fail fresh")

	if signatures.isContestedRegistrationName(name) 'aFreeFunctionContestedAcrossDirectories'
		return mangledDuplicateFunctionMessage(name, signatures: signatures, why: "a free function of that bare name is declared in more than one DIRECTORY, so each is registered under its directory-qualified spelling, and that spelling is already the mangled name of a method. Rename the directory, or rename the function")
	end 'aFreeFunctionContestedAcrossDirectories'

	let base = overloadRegistrationBaseName(name)

	if signatures.isContestedExtensionMethod(base) 'anExtensionMethodContestedAcrossFiles'
		return parameterSpellingCollisionMessage(name, base: base, signatures: signatures, whyThereAreSeveral: "is declared by an `extension` in more than one FILE")
	end 'anExtensionMethodContestedAcrossFiles'

	// ⭐⭐ **THE FOURTH SYNTHESIZED-NAME KIND: A FREE FUNCTION MORE THAN ONE FILE OF ITS DIRECTORY DECLARES**,
	// and it is the `extension` kind above one declaration kind over — same construction, same reason for a
	// sentence of its own. Its own `whyThereAreSeveral` rather than the fall-through's "has more than one
	// declaration in this program", because a file boundary is the fact the author has to see: the two
	// declarations are in two files, and nothing in either one of them looks like a duplicate.
	if signatures.isCrossFileOverloadedFreeFunctionAt(base, declFilePath: declFilePath) 'aFreeFunctionDeclaredByTwoFilesOfOneDirectory'
		return parameterSpellingCollisionMessage(name, base: base, signatures: signatures, whyThereAreSeveral: "is declared as a free function in more than one FILE of its directory")
	end 'aFreeFunctionDeclaredByTwoFilesOfOneDirectory'

	// ⛔⛔ **THE MINTED-NAME SENTENCES ARE GATED ON THE PROPERTY — `name` IS NOT WHAT A DECLARATION WROTE — AND
	// NOT ON WHICH CONTEST EXISTS. A CONTEST FLAG READ OUTSIDE THIS BAND IS A WRONG SENTENCE.** Asked above
	// this gate, `isStaticInstanceContest(base)` would tell a `type Box` declaring `static getValue()` plus TWO
	// instance `getValue()` that *"more than one `static` declaration of it claims that spelling"* — about a
	// program whose statics are fine, quoting `Box.getValue`, which is exactly what the author wrote. The two
	// instance members take the redeclaration path (`Parser.overloadMemberHoldingSignature`) and collide on the
	// SOURCE name, where the canonical wording is the whole point of the header's sort rule.
	//
	// ⇒ Every sentence that names a synthesized spelling lives inside this band, so it cannot fire on a name
	// the author can grep for, and the plain sentence is earned by the property rather than by exhausting a
	// list of kinds.
	if not base.equals(name) 'aMintedNameNoDeclarationWrote'
		// ⭐⭐ **THE THIRD SYNTHESIZED-NAME KIND: A `static` MEMBER BESIDE AN INSTANCE MEMBER OF THE SAME NAME**
		// (`same-name-methods.md`), and it earns its own sentence for the two kinds above's reason plus one of
		// its own. The `#__static` spelling is minted by `staticMemberRegistrationName` and no declaration wrote
		// it — but unlike those two, the reason the name has several declarations is NOT the parameter spelling:
		// two `static getValue()` declarations collide on it because they are two STATICS. The advice is still
		// about parameters, because that IS the remaining way two statics of one type may differ — and it is
		// correct for the further-suffixed spelling too (`Box.getValue#__static#Integer` collides when two
		// statics spell `Integer`), which is why the arm keys on the base rather than on an exact suffix.
		if signatures.isStaticInstanceContest(base) 'aStaticBesideAnInstanceOfOneName'
			return mangledDuplicateFunctionMessage(name, signatures: signatures, why: "'{String.from(base)}' names both a `static` member and an instance member, so the static is registered under a spelling of its own — and more than one `static` declaration of it claims that spelling. Give the statics distinct parameter types, or distinct names")
		end 'aStaticBesideAnInstanceOfOneName'

		return parameterSpellingCollisionMessage(name, base: base, signatures: signatures, whyThereAreSeveral: "has more than one declaration in this program")
	end 'aMintedNameNoDeclarationWrote'

	return "Duplicate function '{String.from(name)}'"
end 'duplicateFunctionMessage'

// THE one speller of the mangled register's opening. Three call sites above, identical up to the tail; it is
// written once so that a future reconciliation of the wordings (see the header) is one edit and cannot leave
// a sibling behind.
function mangledDuplicateFunctionMessage(name ByteArray, why String, signatures ProgramSignatures) returns String
	return "duplicate definition of function '{registrationNameDisplay(name, signatures: signatures)}' — {why}"
end 'mangledDuplicateFunctionMessage'

// The two PARAMETER-SPELLING kinds — a contested `extension` method, and an ordinary overload set's member
// redeclared — differ only in why the name has several declarations. What follows from that is one fact: every
// declaration is filed under its parameter spelling, two spelled the same, and the fix is the parameters or
// the name. It is stated once.
function parameterSpellingCollisionMessage(name ByteArray, base ByteArray, whyThereAreSeveral String, signatures ProgramSignatures) returns String
	let spelling = "parameter types and labels" if registrationNameCarriesLabels(name) else "parameter-type spelling"
	return mangledDuplicateFunctionMessage(name, signatures: signatures, why: "'{String.from(base)}' {whyThereAreSeveral}, so every one of those declarations is registered under its {spelling}, and two of them spell the same parameters. Give the overloads distinct parameter types, or distinct names")
end 'parameterSpellingCollisionMessage'

// Commit this file's overload sets. A file that overloads nothing carries the shared empty table and
// this loop does not run.
//
// ⭐⭐ **THE MEMBERS ACCUMULATE ACROSS FILES RATHER THAN REPLACING.** An `extension` method
// declared by two files' extensions onto one conformer is ONE overload set whose members are minted in two
// different parses, and neither parser can see the other's — so this is where they meet, and a plain upsert
// would leave whichever file merged last as the whole set. The dedup is by registration NAME and not by
// position, because the same file is re-merged on a warm rebuild; `OverloadSetMap` carries why that makes
// the reset mandatory.
//
// ⚠ The resulting ORDER is file-merge order, then declaration order within a file — the order E3007 lists
// tied candidates in. It is deterministic (the merge walks the project's sources in one fixed order), but it
// is not "declaration order" in any sense the author of a single file can see, which is why the
// diagnostic says which candidates rather than which came first.
function commitOverloadSets(project Project, artifact FileParseArtifact)
	match artifact.overloadSets 'file'
		unwritten then break
		entries(byBase) then commitEachOverloadSet(project, byBase: byBase)
	end 'file'
end 'commitOverloadSets'

// The walk behind the door above — its own function because a `match` arm may not open a `for`, and a file
// that overloads nothing never reaches it.
function commitEachOverloadSet(project Project, byBase OverloadSetMap)
	for (base, members) in byBase 'each'
		var accumulated = try project.overloadSets.get(base) otherwise NameRoster.create()

		for member in members 'eachMember'
			if not accumulated.contains(member) 'notYetCommitted'
				accumulated.push(member)
			end 'notYetCommitted'
		end 'eachMember'

		project.overloadSets.upsert(base, value: accumulated)
	end 'each'
end 'commitEachOverloadSet'

// Append this file's recorded function-value merge checks to the whole-program list. Unlike
// the signature commit above there is NO dedup: each entry is a DISTINCT merge SITE (its own position),
// so every one is drained. Kept an array (not a map) for the same reason the `*Entry` families are —
// the drain order is the file/declaration order, deterministic and reviewable.
function commitPendingFnMergeChecks(project Project, artifact FileParseArtifact)
	for check in artifact.pendingFnMergeChecks 'each'
		project.pendingFnMergeChecks.push(check)
	end 'each'
end 'commitPendingFnMergeChecks'

// Append this file's recorded function-type doors to the whole-program list — the twin of the merge-check
// commit above, dedup-free for the same reason: each entry is a distinct SITE with its own position.
function commitPendingFunctionTypeDoors(project Project, artifact FileParseArtifact)
	for door in artifact.pendingFunctionTypeDoors 'each'
		project.pendingFunctionTypeDoors.push(door)
	end 'each'
end 'commitPendingFunctionTypeDoors'

function commitPendingBrandRecords(project Project, artifact FileParseArtifact, opOffset ElementIndex)
	for record in artifact.pendingBrandRecords 'each'
		project.pendingBrandRecords.push(record.relocated(opOffset))
	end 'each'
end 'commitPendingBrandRecords'

// ⚠ The debug-stream names are NOT interned here. The order names take their INDICES in must be the
// LOWERING's, which walks the merged module once; interning here would give them the merge's file order
// instead, and the two are the same only while every file is merged before any is lowered — a property of
// today's pipeline, not a rule.
function commitOpKeyedSites(project Project, artifact FileParseArtifact, opOffset ElementIndex)
	project.serviceAwaitSites.upsertRelocated(artifact.serviceAwaitSites, offset: opOffset)

	match artifact.registryUseSites 'registryUses'
		unwritten then break
		entries(byOp) then project.registryUseSites.upsertRelocated(byOp, offset: opOffset)
	end 'registryUses'

	project.asyncSpawnSites.upsertRelocated(artifact.asyncSpawnSites, offset: opOffset)
	project.overloadAnswers.upsertRelocated(artifact.overloadAnswers, offset: opOffset)
	project.allocTagSites.upsertRelocated(artifact.allocTagSites, offset: opOffset)
	project.debugStreamNameSites.upsertRelocated(artifact.debugStreamNameSites, offset: opOffset)
	project.immortalConstArraySites.upsertRelocated(artifact.immortalConstArraySites, offset: opOffset)
	project.provenFixedArrayAccesses.upsertRelocated(artifact.provenFixedArrayAccesses, offset: opOffset)
end 'commitOpKeyedSites'

extension Map
	function upsertRelocated(source Self, offset Key)
		for (key, value) in source 'eachSite'
			self.upsert(key + offset, value: value)
		end 'eachSite'
	end 'upsertRelocated'
end 'Map'

// Append this file's recorded discarded-result sites to the whole-program list — the twin of the door and
// transform commits above, and dedup-free for their reason: each entry is a distinct SITE with its own position.
function commitPendingDiscardedResults(project Project, artifact FileParseArtifact, opOffset ElementIndex)
	for site in artifact.pendingDiscardedResults 'each'
		project.pendingDiscardedResults.push(site.relocated(opOffset))
	end 'each'
end 'commitPendingDiscardedResults'
