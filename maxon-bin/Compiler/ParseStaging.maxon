export enum FunctionDeclarationRole
	ordinary
	contestedFreeFunction
end 'FunctionDeclarationRole'

// @generated library-cache begin
let CacheCasesFunctionDeclarationRole = [FunctionDeclarationRole.ordinary, FunctionDeclarationRole.contestedFreeFunction]

function cacheReadFunctionDeclarationRole(reader LibraryCacheReader) returns FunctionDeclarationRole throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesFunctionDeclarationRole.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadFunctionDeclarationRole'

function cacheTableAgreesFunctionDeclarationRole() returns bool
	let declared = FunctionDeclarationRole.allCases

	if CacheCasesFunctionDeclarationRole.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesFunctionDeclarationRole.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesFunctionDeclarationRole'

module function cacheEnumTablesAgreeInCompilerParseStaging() returns bool
	if not cacheTableAgreesFunctionDeclarationRole() 'disagreesCacheTableAgreesFunctionDeclarationRole'
		return false
	end 'disagreesCacheTableAgreesFunctionDeclarationRole'

	return true
end 'cacheEnumTablesAgreeInCompilerParseStaging'

