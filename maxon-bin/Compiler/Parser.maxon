	var position = 1 as ParamCount if takesReceiver else 0 as ParamCount

	for declared in types 'eachParameter'
		if declaredTypeMayCarryAPromise(declared) 'aPossibleCarrier'
			carriers = maskWithParam(carriers, param: position)
		end 'aPossibleCarrier'

		position = position + 1
	end 'eachParameter'

	return carriers
end 'promiseCarrierPositions'

