// A bare call `foo(…)` inside a method of the type resolves to the sibling method `foo`; the flag decides
// whether the enclosing `self` is prepended (an instance method) or not (a `static` one). See
// `Parser.ensureSiblingReceivers`.
typealias SiblingReceiverMap = Map with (ByteArray, bool)

