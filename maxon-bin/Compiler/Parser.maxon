// ⭐⭐ **WHAT THE `for` HEADER'S SOURCE EXPRESSION TURNS OUT TO BE — ten facts settled once and read by
// every phase after.** `parseForStatement` held them as ten separate `var`s and could not: they are live
// from the header analysis to the merge, and the allocator refused the function outright (E5001, 25
// values against 14 registers). A record's fields are memory, so they cost the loop nothing — see the
// declaration inside the function for the measurement.
//
// ⚠ Every field is a `var`: the header settles them in stages (a range is recognised before a character
// range is, a cursor surface after a String is ruled out), which is why this is a mutable working record
// and not a value some analysis returns whole.
type ForSourceFacts
	// A counted `a to b` / `a upto b` header rather than a collection.
	export var isRange as bool

	// `to` (inclusive) rather than `upto`.
	export var rangeInclusive as bool

	// The value the index is tested against — the range's end, or the collection's length.
	export var limit as ValueId

	// The token the comparison is anchored on, for the diagnostic a bad bound earns.
	export var testAnchorIndex as ElementIndex

	// A `'a' to 'z'` header, whose element is a Character rather than an integer.
	export var isCharacterRange as bool

	export var skipsSurrogateBlock as bool

	// A String source, iterated by grapheme.
	export var isString as bool

	// Set when the source is a call to no declared function: the body's element is then an
	// `unresolved` value derived from it.
	export var sourceIsDeferred as bool

	// The cursor protocol this source is walked through, when it is walked by one.
	export var cursorSurface as MethodSurface

	// Where the cursor starts — see `CursorEntrySeed`.
	export var cursorEntrySeed as CursorEntrySeed

	// Does the destructure move a `WithIterIterator` pair's promise into its array slot? See
	// `claimWithIteratorPromiseSlot`.
	export var claimsWithIteratorPromise as bool

	export var elementQualifier as GenericArgQualifier

	export var iterated as ValueId

	export let sourceEnd as ElementIndex

	static function create(limit ValueId, testAnchorIndex ElementIndex, sourceEnd ElementIndex) returns ForSourceFacts
		return Self{iterated: limit, sourceEnd: sourceEnd, isRange: false, rangeInclusive: false, limit: limit, testAnchorIndex: testAnchorIndex, isCharacterRange: false, skipsSurrogateBlock: false, isString: false, sourceIsDeferred: false, cursorSurface: MethodSurface.none, cursorEntrySeed: CursorEntrySeed.atTheFirstElement, claimsWithIteratorPromise: false, elementQualifier: GenericArgQualifier.plain}
	end 'create'
end 'ForSourceFacts'

