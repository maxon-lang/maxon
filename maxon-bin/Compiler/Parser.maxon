// are LEVELS — what the heap holds at the instant they are asked. `SlabRuntime.SlabLiveBytesName` owns what
// each answers; this file only routes the names.
let BuiltinsSlabLiveBytesName = b"__Builtins.slabLiveBytes"
let BuiltinsSlabFreeBytesName = b"__Builtins.slabFreeBytes"
let BuiltinsSlabCachedFreeBytesName = b"__Builtins.slabCachedFreeBytes"
let BuiltinsSlabParkedBytesName = b"__Builtins.slabParkedBytes"
let BuiltinsSlabCommittedBytesName = b"__Builtins.slabCommittedBytes"

// One constant for the five, for `MmCounterArity`'s reason: the shape is the fact.
let SlabCensusArity = 0

let BuiltinsSlabCensusTallyName = b"__Builtins.slabCensusTally"
let BuiltinsSlabCensusBucketCountName = b"__Builtins.slabCensusBucketCount"
let BuiltinsSlabCensusBucketBytesName = b"__Builtins.slabCensusBucketBytes"

let SlabCensusTallyArity = 1

// ⭐⭐ **`__Builtins.schedProcessorCount()` — THE FOURTH SCHEDULER QUERY, AND THE ONLY ONE WHOSE ANSWER IS
// NOT AN OUTCOME.** It reports how many Ps `MAXON_MAX_PROCS` resolved to — `min(requested, cpuCount())`,
// settled once in `__sched_init_procs` before any green thread runs. Its two SCHEDULER band-mates both
// report what the scheduler DID (how many Ms it built, how much it stole), which a short program can finish
// before making true; this reports what it was CONFIGURED to do, which no workload can move. (`cpuCount`
// is the third of the family and asks a different party altogether — the MACHINE.)
//
// ⇒ **IT IS WHAT A CASE ABOUT THE `procs:` MARKER MUST ASSERT.** The marker promises processors, not
// workers, and the worker-M mark moves with the workload and the suite's load.
//
// ⚠ **NEITHER REFERENCE DECLARES IT**, like `schedStealCount` and unlike the two above it: the surface is
// invented here on the argumentless-integer shape the family already has. `stdlib/Scheduler.maxon`'s
// `Scheduler.processorCount()` is its public spelling. `CpuParallelRuntime.SchedProcessorCountName` owns what
// it costs; this file only routes the name.
let BuiltinsSchedProcessorCountName = b"__Builtins.schedProcessorCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedProcessorCountArity = 0

// ⭐⭐ **THE SIX MEMORY-TRAFFIC COUNTERS — the allocator's figures PER LAYER.** All six take no arguments and
// answer an `int`: TWO LAYERS × (cumulative, live) PLUS TWO BYTE VOLUMES. The layers NEST in the allocator —
// every box is also a slab request — and the raw three are reported disjoint by subtracting the tracked
// three at READ time (`MmRuntime.buildMmCounterAccessors`), so the six can be summed across layers.
//
// ⚠ They are refused NOWHERE: each sums a column of the allocator's own state region, which reaches no OS and
// which every target the compiler emits can do. That is the acceptance half of the target pair whose refusal
// half is `threadCpuTicks` just below — without it, a compiler that had stopped serving this whole family on
// wasm would look exactly like a live gate.
let BuiltinsMmAllocTotalName = b"__Builtins.mmAllocTotal"
let BuiltinsMmAllocLiveName = b"__Builtins.mmAllocLive"
let BuiltinsMmAllocBytesName = b"__Builtins.mmAllocBytes"
let BuiltinsMmRawAllocTotalName = b"__Builtins.mmRawAllocTotal"
let BuiltinsMmRawAllocLiveName = b"__Builtins.mmRawAllocLive"
let BuiltinsMmRawAllocBytesName = b"__Builtins.mmRawAllocBytes"

let BuiltinsMmAllocTotalByTagName = b"__Builtins.mmAllocTotalByTag"
let BuiltinsMmAllocBytesByTagName = b"__Builtins.mmAllocBytesByTag"

let MmAllocByTagArity = 1

// ⭐⭐ **THE THREE PER-THREAD COLUMNS — allocations, frees and bytes of ONE GREEN THREAD**, both layers
// summed. A process-wide figure counts every thread's traffic, so a bracket opened inside a pool worker
// reads these. `MmRuntime.MmCounterThreadAllocsName` owns what each answers and what a single-threaded
// program gets; this file only routes the names.
let BuiltinsThreadAllocTotalName = b"__Builtins.threadAllocTotal"
let BuiltinsThreadFreeTotalName = b"__Builtins.threadFreeTotal"
let BuiltinsThreadAllocBytesName = b"__Builtins.threadAllocBytes"

// ⭐⭐ **THE THREE PROCESS-WIDE TOTALS — the per-thread three asked of the whole process.** Each only ever
// rises whatever other threads are doing, which the six above cannot promise
// (`MmRuntime.MmCounterProcessAllocsName` owns why), so these and the per-thread three are what `PhaseProbe`
// brackets a phase with and what `scale-test` bottoms out on. This file only routes the names.
let BuiltinsProcessAllocTotalName = b"__Builtins.processAllocTotal"
let BuiltinsProcessFreeTotalName = b"__Builtins.processFreeTotal"
let BuiltinsProcessAllocBytesName = b"__Builtins.processAllocBytes"

// ⭐⭐ **`__Builtins.scavengeMemory()` — THE ALLOCATOR'S RECLAMATION DOOR.** It hands every idle
// span's pages back to the operating system and ANSWERS THE BYTE COUNT, which is why it takes the
// argumentless-INTEGER door beside the counters rather than the void one: the number is the only
// thing a Maxon program can observe of the whole mechanism, and a `void` here would leave the
// scavenger with no consequence any spec could name.
//
// ⚠ **TWO CALLS ARE NEEDED BEFORE ANY BYTE MOVES, AND THAT IS THE MECHANISM RATHER THAN A QUIRK** — a span
// must stay idle across one whole pass before it is released, so the working set of a program that keeps
// allocating is never decommitted. `specs/slab-scavenger.md` states it; `SlabRuntime.buildSlabScavenge`
// implements it.
let BuiltinsScavengeMemoryName = b"__Builtins.scavengeMemory"

// It takes NOTHING. Its own constant rather than the counters' shared one for `CurrentProcessIdArity`'s
// rule: the number is a fact about this intrinsic's contract, which is unrelated to theirs.
let ScavengeMemoryArity = 0

// ⭐⭐ **`__Builtins.threadCpuTicks()` — THE FOURTH CLOCK, AND THE ONLY ONE THAT IS NOT A CLOCK.**
// The three in `builtins-clock.md` measure WALL time, so a phase timed with any of them reports the
// machine it ran on; this one advances only while the CALLING THREAD is scheduled. `PhaseProbe`
// brackets it beside the wall clock for exactly that reason.
//
// ⚠ **ITS UNIT IS PLATFORM-DEFINED AND NOTHING CONVERTS IT** — TSC ticks on Windows, nanoseconds under
// POSIX. See `ClockRuntime`'s header, which owns that fact; this file only routes the name.
let BuiltinsThreadCpuTicksName = b"__Builtins.threadCpuTicks"

// None of them takes anything. ONE constant for the twelve counters, because there the shape IS the fact —
// they are twelve spellings of one question asked of twelve figures, exactly as `SubprocessOneArgArity`'s
// family is one shape shared by many names — and its own for the clock, whose contract is unrelated to
// theirs (`CurrentProcessIdArity`'s rule, which is why these are two constants and not one).
let MmCounterArity = 0
let ThreadCpuTicksArity = 0

// ⭐⭐ **`__Builtins.tickCountMs()` — MILLISECONDS SINCE THE MACHINE BOOTED, AND IT EXISTS FOR ONE
// CONSUMER: THE DEBUGSTREAM WIRE FORMAT.** The producer stamps every ring entry with
// `osTickCountMs() - start_timestamp`, so `maxon monitor` must seed that header field with the SAME
// counter — and no other clock this language exposes is it. `__Builtins.currentTimeMs` is QPC-ms scaled
// (see `emitMonotonicMs`) and LEADS the tick, which makes the producer's subtraction underflow;
// `currentUnixTimeSeconds` is the calendar and is not monotonic at all.
//
// ⚠ **NOT A `Clock` SURFACE, AND DELIBERATELY SO.** `maxon-bin/Debug/` is compiler source and
// reaches this name directly. See `ClockRuntime.UptimeMsName` for the band and the import it costs.
let BuiltinsTickCountMsName = b"__Builtins.tickCountMs"

// It takes NOTHING. Its own constant rather than either clock's above, on `CurrentProcessIdArity`'s rule:
// the number is a fact about THIS intrinsic's contract, which is unrelated to theirs.
let TickCountMsArity = 0

// **THE `spawnReadLine` BUILTIN** (the IOCP overlapped-read PROBE). A TEMPORARY probe
// surface (not the final async-subprocess-stdio API): like
// `__Builtins.runProcess`,
// ordinary call syntax routing to a scheduler runtime entry — `__gt_io_read(strPtr)` — which spawns the command with
// its stdout redirected to a fresh overlapped pipe, issues a YIELDING overlapped ReadFile, and returns the byte count
// once the read completes. Non-throwing (returns an INTEGER, not the dual-register error ABI), so a bare
// `spawnReadLine(cmd)` needs no `try`.
let SpawnReadLineBuiltinName = b"spawnReadLine"

// `spawnReadLine` takes exactly one STRING argument (the command line) and returns an INTEGER (the bytes read).
let SpawnReadLineArity = 1

// **THE STREAMING SUBPROCESS BUILTINS** — the real long-lived-child API `StreamingSubprocess`
// wants, exposed as bare-name compiler builtins (like `spawnReadLine`) because the compiler cannot yet compile the stdlib
// cone the stdlib method bodies need (Map/FilePath/`__ManagedMemory`/`cstr`/the union cone).
// Each routes to a `__gt_subp_*` runtime entry: `subpSpawn(cmd)` spawns a child with three pipes and returns a
// handle (or -1); `subpReadLine(h)`/`subpReadErrLine(h)` yield a stdout/stderr line as an OWNED String; `subpWriteLine
// (h, line: s)` writes `s\n` to stdin (0 ok, nonzero fail); `subpCloseStdin(h)` / `subpWait(h)` / `subpRelease(h)`
// close stdin / block for exit code / free the handle. x64-windows only, like the whole subprocess substrate.
let SubpSpawnBuiltinName = b"subpSpawn"
let SubpReadLineBuiltinName = b"subpReadLine"
let SubpReadErrLineBuiltinName = b"subpReadErrLine"
let SubpWriteLineBuiltinName = b"subpWriteLine"
let SubpCloseStdinBuiltinName = b"subpCloseStdin"
let SubpWaitBuiltinName = b"subpWait"
let SubpReleaseBuiltinName = b"subpRelease"

// Arities: spawn/read/close/wait/release take one argument; writeLine takes two (handle, line).
let SubpSpawnArity = 1
let SubpReadArity = 1
let SubpWriteArity = 2
let SubpHandleArity = 1

// **THE ARITY-1 FLOAT MATH INTRINSICS** — `specs/{floor,ceil,round,sqrt,abs}.md`. Builtins for the
// same reason `trunc` is: each lowers to ONE instruction on every target — `abs` to a
// two-instruction sign-bit clear on x64 only, see `TargetOp.absF64RegReg` — so a stdlib function
// would be a call/ret wrapped around a single `sqrtsd`/`roundsd`/`fsqrt`/`frint`/`f64.sqrt`.
//
// ⚠ Like `trunc`, each name is the compiler's ONLY while no file declares one: a user `function
// sqrt` takes the name back and its call is linked (`parseCallNamed`'s `shadowedByADeclaration`).
// An unconditional reservation would make the declaration unreachable with no diagnostic anywhere,
// and a shadowed declaration has no other symptom.
let FloorBuiltinName = b"floor"
let CeilBuiltinName = b"ceil"
let RoundBuiltinName = b"round"
let SqrtBuiltinName = b"sqrt"
let AbsBuiltinName = b"abs"

// ⭐ **THE ARITY-2 FLOAT MATH INTRINSICS** (`specs/min.md`, `specs/max.md`) — builtins for the same
// reason their five arity-1 siblings above are: each is ONE instruction on x64 (`minsd`/`maxsd`)
// and a two-instruction compare-and-select on arm64 and wasm, so a stdlib function would be a
// call/ret around almost nothing.
//
// ⭐ **THEY ARE ONE DECISION, NOT TWO.** `max` took the MIRROR of the NaN definition `min` landed
// with — `a` when `a > b`, else `b`, against `min`'s `a` when `a < b`, else `b` — because a STRICT
// comparison is false on unordered whichever direction it points, so both settle NaN and signed zero
// by the same clause. The reasoning is stated ONCE, in `StdBinOpcode`'s `min`/`max` header.
//
// ⚠ Like every bare builtin, each name is the compiler's only while no file declares one — see the
// arity-1 siblings above for the rule. `stdlib/`, `specs/` and `specs/` declare no `min` or `max`,
// so nothing in the tree exercises it here.
let MinBuiltinName = b"min"
let MaxBuiltinName = b"max"

// ⭐⭐⭐ **THE MATH-INTRINSIC ROSTER AS AN ENUM — the one place the family's MEMBERSHIP is written down,
// and the thing that makes every other question about a member a compile error to leave unanswered.**
//
// The family has four facts per member — its NAME, the OP it emits, the SIGNATURE a reader sees and the
// HELP LINE under it — and until this enum existed the first two were two independent `equals` chains
// (`calleeTakesPositionalArgsOnly` and `emitPositionalMathBuiltin`) kept in step by a runtime `panic`.
// Now the chain from bytes to a case is written ONCE (`mathBuiltinNamed`) and everything downstream is an
// EXHAUSTIVE match over this enum: adding a case fails to compile until the emit, the signature and the
// help all name it. That is the same closure the panic bought, moved from the first program that calls a
// half-added builtin to the build that adds it.
//
// ⚠ **`trunc` LEADS BECAUSE IT IS THE ODD ONE — it LEAVES the float domain** (it answers an int, so an
// integer argument is the identity rather than being promoted). The other seven stay inside it. That split
// is the family's real content and it is `emitPositionalMathBuiltin`'s three emitters.
enum MathBuiltin
	trunc
	floor
	ceil
	round
	sqrt
	abs
	min
	max
end 'MathBuiltin'

// Whether a callee names a math intrinsic. A case rather than a bool-plus-out-param, so the ANSWER is the
// member and no caller has to re-derive it from the name it just matched.
union MathBuiltinLookup
	found(builtin MathBuiltin)
	absent
end 'MathBuiltinLookup'

// ⭐ **BYTES → MEMBER: the family's ONE recognizer.** Every asker — the label rule, the emit, and the
// editor hover — comes through here, so none of them can hold a different idea of who is in the family.
//
// The arms are the `*BuiltinName` constants above rather than fresh `b"…"` literals: the SPELLING stays
// one fact, and this function says only which member wears it.
function mathBuiltinNamed(callee ByteArray) returns MathBuiltinLookup
	if callee.equals(TruncBuiltinName) 'truncName'
		return MathBuiltinLookup.found(MathBuiltin.trunc)
	end 'truncName'

	if callee.equals(FloorBuiltinName) 'floorName'
		return MathBuiltinLookup.found(MathBuiltin.floor)
	end 'floorName'

	if callee.equals(CeilBuiltinName) 'ceilName'
		return MathBuiltinLookup.found(MathBuiltin.ceil)
	end 'ceilName'

	if callee.equals(RoundBuiltinName) 'roundName'
		return MathBuiltinLookup.found(MathBuiltin.round)
	end 'roundName'

	if callee.equals(SqrtBuiltinName) 'sqrtName'
		return MathBuiltinLookup.found(MathBuiltin.sqrt)
	end 'sqrtName'

	if callee.equals(AbsBuiltinName) 'absName'
		return MathBuiltinLookup.found(MathBuiltin.abs)
	end 'absName'

	if callee.equals(MinBuiltinName) 'minName'
		return MathBuiltinLookup.found(MathBuiltin.min)
	end 'minName'

	if callee.equals(MaxBuiltinName) 'maxName'
		return MathBuiltinLookup.found(MathBuiltin.max)
	end 'maxName'

	return MathBuiltinLookup.absent
end 'mathBuiltinNamed'

// ⭐⭐ **THE SIGNATURE AN EDITOR SHOWS — and it is DOCUMENTATION OF AN INTRINSIC, not a declaration.**
//
// ⚠⚠ **NO SUCH DECLARATION EXISTS, AND THE PARAMETER NAMES HERE CANNOT BE USED AS `name:` LABELS.** Every
// member of this family is refused a label outright (E2067, via `argLabelRuleForCallee`) precisely because
// it has no declaration to slot one against — so `sqrt(value: 16.0)` is an error, not the spelling this
// text invites. The names are here for the ONE thing a reader wants from a signature and a bare `float`
// cannot give: which operand is which. `min`'s two are `value` and `other` for that reason.
//
// ⚠ It renders bare `float` and bare `int` because that is what the language's own documentation writes
// for these (`docs/LANGUAGE_REFERENCE.md`'s builtin table) and what the operand rule actually is — the
// typealias requirement is a rule about DECLARATIONS, and there is no declaration here to hold to it.
function mathBuiltinSignature(builtin MathBuiltin) returns String
	return match builtin 'signature'
		trunc gives "function trunc(value float) returns int"
		floor gives "function floor(value float) returns float"
		ceil gives "function ceil(value float) returns float"
		round gives "function round(value float) returns float"
		sqrt gives "function sqrt(value float) returns float"
		abs gives "function abs(value float) returns float"
		min gives "function min(value float, other float) returns float"
		max gives "function max(value float, other float) returns float"
	end 'signature'
end 'mathBuiltinSignature'

// One line saying what the intrinsic DOES — the half of a hover a signature cannot carry.
//
// ⚠ **NEITHER `min` NOR `max` CLAIMS A NaN ANSWER, DELIBERATELY.** `StdBinOpcode`'s header records that
// the three backends disagree there — x64's `minsd` answers with its second operand, arm64's `fmin` and
// wasm's `f64.min` propagate the NaN — so a help line stating one would be true on one target and false
// on two. What IS the same everywhere is the ORDERED definition, and that is what these say.
function mathBuiltinHelp(builtin MathBuiltin) returns String
	return match builtin 'help'
		trunc gives "Truncates `value` toward zero, dropping the fractional part."
		floor gives "Rounds `value` toward negative infinity."
		ceil gives "Rounds `value` toward positive infinity."
		round gives "Rounds `value` to the nearest whole number, halves to even."
		sqrt gives "The square root of `value`."
		abs gives "The absolute value of `value`."
		min gives "The lesser of the two: `value` when `value < other`, and `other` otherwise."
		max gives "The greater of the two: `value` when `value > other`, and `other` otherwise."
	end 'help'
end 'mathBuiltinHelp'

// ⭐⭐ **THE CALLEES WHOSE ARGUMENTS ARE ALL POSITIONAL — THE ONE PLACE THE `name:` LABEL RULE IS
// SWITCHED OFF, AND THE REASON IT CAN BE.** A label names a PARAMETER OF A DECLARATION, and it is
// checked against that declaration's parameter names downstream (`SemanticCheck.validateCall` for a
// direct call, `slottedWitnessArgs` for a witness dispatch). A bare compiler builtin has no
// declaration: it emits no `MaxonOp.call`, so there is no signature to slot against and no name a
// label could match or fail to match. The ordinary rule — *the second and later arguments must be
// named* — therefore has nothing to name, and `min(3.0, 5.0)` is the spelling every spec file and
// the documentation use.
//
// ⭐⭐ **THE SET IS THE WHOLE MATH-BUILTIN FAMILY, NOT JUST THE ARITY-2 PAIR, AND THAT IS THE POINT.**
// `min` is what FORCED the question — it was the first bare builtin with a second argument, so E2053
// ("the second and later arguments must be named") had never had a builtin to fire on before. But the
// ANSWER was always true of the arity-1 siblings as well: none of them has a declaration either, so
// none of them has a parameter a label could name.
//
// ⚠⚠ **RESTRICTING THIS TO `min` WOULD HAVE LEFT THE DEFECT CLASS ALIVE INSIDE ITS OWN FIX** — this
// repo's recorded scar (a wrong noun corrected for one family and left standing one door over). The
// arity-1 builtins would reach E2052, whose registered sentence (*"the first argument cannot be
// named because its parameter has no default"*) blames a default on a parameter that a callee with
// no declaration does not have. E2067 says the true thing for every member.
//
// ⭐ **AND THE WIDENING IS WHAT LET `max` COST NOTHING HERE.** When `max` landed at its own whitelist
// position it needed one more `equals` on this line and nothing else — no new rule, no second
// diagnostic, and no chance of the wrong-noun answer, because the family had already been named as a
// family rather than as `min` plus an exception.
//
// ⚠ Widening moves NO WORKING PROGRAM: a program that labels one of these arguments is already
// refused today (E2052), so only the code and the wording change. Every live `maxoncstderr` pin of
// E2052 is a USER function or method call — never a builtin — so no committed expectation moves
// either. `min.md` and `abs.md` pin the new answer on both arities; `max.md` deliberately adds no
// fourth pin of the same rule, since removing `max` from this line already turns its fourteen value
// cases red.
//
// ⚠⚠ **THE SUBPROCESS BUILTINS ARE ARITY-2 AND ARE DELIBERATELY *NOT* HERE**, which is what stops
// this predicate from collapsing into "is it a builtin". `subpWriteLine(h, line: s)` LABELS its second
// argument on purpose: it is a stand-in for a stdlib method that will one day have a real declaration
// with a real `line` parameter, and it is written the way that call will eventually be written. Ditto
// `spawnReadLine` and `__Builtins.runProcess`, whose one argument is a String rather than a number. So
// the set is neither 'the builtins' nor 'the arity-2
// builtins' — it is the MATH intrinsics, the builtins that are permanently compiler-owned because each
// IS a machine instruction and will never acquire a declaration to take labels from.
//
// Keyed on the callee NAME and tested BEFORE the argument list is parsed — the label rule fires during
// `parseCallArgs` and a builtin is not recognized until after, so the question cannot be deferred to
// the emit site.
//
// ⭐ It is also the GATE the math-intrinsic emit hangs off, so the roster and the dispatch cannot come
// to disagree about who is in the family — `parseCallNamed` enters `emitPositionalMathBuiltin` only
// through this predicate, and both read the SAME recognizer, `mathBuiltinNamed`. The several questions
// ('does this name take labels', 'which op does it emit', 'what does an editor show for it') stay
// distinct; what is shared is the one thing that must not be written twice, the SET.
//
// A builtin can still be a bare builtin without being here: the rest are `ProcessBuiltin`'s. Every one of
// them is a stand-in for a declaration that does not exist yet, which is exactly why they keep the
// ordinary label rule. (`runProcess` is `__Builtins.runProcess`; a `__Builtins.`-qualified name is not a
// bare builtin and takes the `isBuiltinsIntrinsicCallee` half of the rule above instead.)
function calleeTakesPositionalArgsOnly(callee ByteArray) returns bool
	match mathBuiltinNamed(callee) 'roster'
		found then return true
		absent then return false
	end 'roster'
end 'calleeTakesPositionalArgsOnly'

enum ProcessBuiltin
	spawnReadLine
	subpSpawn
	subpReadLine
	subpReadErrLine
	subpWriteLine
	subpCloseStdin
	subpWait
	subpRelease
end 'ProcessBuiltin'

union ProcessBuiltinLookup
	found(builtin ProcessBuiltin)
	absent
end 'ProcessBuiltinLookup'

function processBuiltinNamed(callee ByteArray) returns ProcessBuiltinLookup
	if callee.equals(SpawnReadLineBuiltinName) 'spawnReadLineName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.spawnReadLine)
	end 'spawnReadLineName'

	if callee.equals(SubpSpawnBuiltinName) 'subpSpawnName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpSpawn)
	end 'subpSpawnName'

	if callee.equals(SubpReadLineBuiltinName) 'subpReadLineName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpReadLine)
	end 'subpReadLineName'

	if callee.equals(SubpReadErrLineBuiltinName) 'subpReadErrLineName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpReadErrLine)
	end 'subpReadErrLineName'

	if callee.equals(SubpWriteLineBuiltinName) 'subpWriteLineName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpWriteLine)
	end 'subpWriteLineName'

	if callee.equals(SubpCloseStdinBuiltinName) 'subpCloseStdinName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpCloseStdin)
	end 'subpCloseStdinName'

	if callee.equals(SubpWaitBuiltinName) 'subpWaitName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpWait)
	end 'subpWaitName'

	if callee.equals(SubpReleaseBuiltinName) 'subpReleaseName'
		return ProcessBuiltinLookup.found(ProcessBuiltin.subpRelease)
	end 'subpReleaseName'

	return ProcessBuiltinLookup.absent
end 'processBuiltinNamed'

// Must hold every bare builtin `parseCallNamed` emits: one it omits classifies as undeclared, so an
// initializer calling it is refused as E3004 rather than E2045.
function isBareBuiltinCallee(callee ByteArray) returns bool
	if calleeTakesPositionalArgsOnly(callee) 'aMathIntrinsic'
		return true
	end 'aMathIntrinsic'

	return match processBuiltinNamed(callee) 'process'
		found gives true
		absent gives false
	end 'process'
end 'isBareBuiltinCallee'

// ⭐ **THE `__Builtins` INTRINSIC TABLE — THE ONE PLACE THE RECOGNIZED SET IS STATED.**
//
// `__Builtins` is the compiler's builtin TYPE, and every leaf of the stdlib bottoms out in a static call on
// it (`stdlib/Clock.maxon`'s `nowMs`/`nowNanos`/`nowUnixSeconds` are three one-line wrappers around the
// first three names below; `stdlib/Sleep.maxon`'s `sleep` is a fourth, around the fourth). It reaches
// `parseCallNamed` as an ORDINARY QUALIFIED CALLEE — the mangled bytes `__Builtins.currentTimeMs` —
// which is exactly why the bare-name builtin table above can never match one,
// and why this table is a separate arm rather than three more rows in it.
//
// Every row is a NAME plus its lowering, so "which intrinsics exist" and "what each one becomes" are one
// fact in one place. A name NOT here is not silently a link error: it falls through to `emitCall`, whose
// reserved-callee rejection refuses every unrecognized `__` callee with a positioned E3004 (see
// `requireCalleeIsNotReservedName` — the "unknown intrinsic" arm of this table, homed there because it
// answers for `__whatever()` too).
//
// The whole arm is gated behind ONE prefix compare, so a program with no `__Builtins` call pays a
// two-byte `bytesStartWith` per parsed call and nothing else — the same allocation-free `equals`
// discipline the math-intrinsic rows document.
let BuiltinsQualifierPrefix = b"__Builtins."
let BuiltinsCurrentTimeNanosName = b"__Builtins.currentTimeNanos"
let BuiltinsCurrentTimeMsName = b"__Builtins.currentTimeMs"
let BuiltinsCurrentUnixTimeSecondsName = b"__Builtins.currentUnixTimeSeconds"
let BuiltinsCurrentUnixTimeNanosName = b"__Builtins.currentUnixTimeNanos"
let BuiltinsSleepName = b"__Builtins.sleep"

// `stdlib/Scheduler.maxon`'s floor — the intrinsic `Scheduler.yield()`'s one-line body calls. It routes to
// `__gt_resched`, the cooperative reschedule, exactly as `__Builtins.sleep` routes to `__gt_sleep`. Same
// discipline as `sleep`: the SURFACE is the stdlib declaration and this is the only spelling the parser
// knows, so a yield can never reach the scheduler by two routes that could come to disagree.
let BuiltinsYieldName = b"__Builtins.yield"

// ⭐ **THE TWO COMMAND-LINE INTRINSICS**, `stdlib/CommandLine.maxon`'s only floor. A count takes
// nothing and answers an `int`; an accessor takes one index and answers an OWNED `__ManagedMemory`
// the caller frees. See `CommandLineRuntime` for the split they sit on.
let BuiltinsCommandLineCountName = b"__Builtins.commandLineCount"
let BuiltinsCommandLineArgName = b"__Builtins.commandLineArg"

// ⭐ **THE TWO HOST-PROCESS INTRINSICS**, `stdlib/Console.maxon`'s and `stdlib/Process.maxon`'s only
// floors. A read takes a byte budget and answers an OWNED `__ManagedMemory` the caller frees; a
// path read takes nothing and answers the same. See `ConsoleRuntime` and `ProcessRuntime` for the
// entry points they lower to.
let BuiltinsReadStdinName = b"__Builtins.readStdin"
let BuiltinsExecutablePathName = b"__Builtins.executablePath"
let BuiltinsProcessNamespaceName = b"__Builtins.processNamespace"
let BuiltinsFillRandomName = b"__Builtins.fillRandom"
let BuiltinsTrustStoreOpenName = b"__Builtins.trustStoreOpen"
let BuiltinsTrustStoreNextName = b"__Builtins.trustStoreNext"
let BuiltinsTrustStoreVerdictName = b"__Builtins.trustStoreVerdict"
let BuiltinsTrustStoreCertificateName = b"__Builtins.trustStoreCertificate"
let BuiltinsTrustStoreCloseName = b"__Builtins.trustStoreClose"

// ⭐ **`__Builtins.currentProcessId()` — THE RUNNING PROCESS'S OWN ID, AND THE ONE `__Builtins`
// INTRINSIC WITH NO `stdlib/` WRAPPER OVER IT.** `/specs/builtins-type.md:37` declares it (*"Pid of
// the current process"*) with exactly this shape — no arguments, an `int` answer —. Its one caller
// in this tree is `Compiler/TreeLock.maxon`, which stamps the id into the lock file so a later
// reader can tell a live holder from an abandoned one; that is why the intrinsic IS the surface
// here — a `Process.currentProcessId()` wrapper would be a stdlib declaration whose whole body is
// this call, i.e. the thin wrapper the house rules forbid, and `stdlib/Process.maxon` declares no
// such function.
//
// ⚠ **THE ROSTER HAS NAMED IT SINCE BEFORE ANYTHING PROVIDED IT.** `specs/builtins-type.md:37` is a
// byte-identical port of the canonical spec, so the compiler shipped a documented intrinsic that answered E3004 —
// which is exactly the SURFACE-WITHOUT-A-FLOOR shape the socket slice paid for: declaring a name with no
// runtime behind it turns a clean `E3004` into a backend panic (MEASURED — see
// `TargetFacilities`'s `panic at StdToWasm.maxon:1624` note, which is that rule made real). This case was
// one step less harmful, a clean refusal rather than a panic. See `ProcessRuntime.ProcessCurrentPidName`.
let BuiltinsCurrentProcessIdName = b"__Builtins.currentProcessId"
let BuiltinsProcessIsAliveName = b"__Builtins.processIsAlive"
let BuiltinsProcessEndDescendantsName = b"__Builtins.processEndDescendants"

// ⭐⭐ **`__Builtins.gtIsComplete(gt)` — THE NON-BLOCKING PEEK AT A GREEN THREAD'S STATUS.** `await`
// drives the scheduler until ONE named promise finishes, so a dispatcher holding N of them cannot
// use it without head-of-line blocking; this answers "has this one finished?" without driving
// anything. The calling convention is *"pass `promise.inner` from a `Promise with X`"*.
// It is library-tier raw surface (E3185); a program asks `promise.isComplete()` (`emitPromiseIsComplete`),
// which reaches the same runtime.
//
// ⚠ **THE ARGUMENT IS A RAW GT POINTER AND THE INTRINSIC ASKS NOTHING ELSE OF IT** — not that it came from
// a promise, not that the promise is live. `promise.inner` is how library-tier code obtains one (see
// `PromiseType.fieldReadIsThePromiseHandle`, which is what keeps that read from DEREFERENCING the handle),
// and the operand rule here is the ordinary machine-word one every handle-taking intrinsic uses.
let BuiltinsGtIsCompleteName = b"__Builtins.gtIsComplete"

// ⭐⭐ **`__Builtins.awaitAny(promises)` — THE SELECT, THE WAITING COUNTERPART OF THE PEEK ABOVE.**
// `__Builtins.gtIsComplete` answers *"has this one finished?"* and leaves the WAITING to a caller that has
// nothing to wait with except a spin; this drives the shared scheduler loop until SOME element of an
// `Array with Promise with …` has completed and answers WHICH — one waiting primitive over service replies,
// file IO and subprocess drains alike, because a reply is an ordinary `Promise`.
//
// ⭐ **IT RETURNS AN INDEX AND CONSUMES NOTHING**, which is why it is a function and not a `select`
// statement: an `any` arm would consume an array SLOT, and slot-level linearity is the documented gap in
// `await`'s ownership rule, so the statement form would replace a hand-rolled poll with a construct whose
// misuse is a runtime double free. The caller then `await`s exactly one promise, under the ordinary rules.
// See `GtRuntime.GtAwaitAnyName` for the runtime side and `specs/await-any.md` for the cases.
//
// ⚠ **THE SURFACE IS THE `__Builtins.` SPELLING AND NOT A BARE `awaitAny`.** The nicer spelling is
// `stdlib`'s own declaration over this intrinsic, exactly as `sleep(ms)` is — but its parameter would be
// `Array with Promise with T` for a type PARAMETER `T`, and this intrinsic's argument rule is *"the element
// type is a `Promise with …`"*, which no type parameter can be shown to be. That is a stdlib-generics
// question rather than this primitive's; a BARE-name builtin instead would be the wart `print`, `sleep` and
// `runProcess` were moved into this reserved space to remove.
let BuiltinsAwaitAnyName = b"__Builtins.awaitAny"
let ArrayAwaitAnyMethodName = b"awaitAny"

// ⭐ **THE TWO STREAM-WRITE INTRINSICS**, `stdlib/Print.maxon`'s and `stdlib/PrintError.maxon`'s
// only floors, and the pair that let the bare-name `print` builtin be retired.
// `/specs/builtins-type.md:24-25` declares exactly these two names with exactly this shape — one
// `__ManagedMemory` in, the byte count written out — See `StringRuntime.StreamWriteStdoutName` for
// the entry points they lower to.
let BuiltinsWriteStdoutName = b"__Builtins.writeStdout"
let BuiltinsWriteStderrName = b"__Builtins.writeStderr"

// ⭐ **`__Builtins.floatToBits(x)` — AN f64's IEEE-754 ENCODING AS AN i64, THE ONLY WAY TO TAKE A
// FLOAT APART IN MAXON.** `stdlib/Builtins.maxon`'s `__float_toString` needs the sign, the exponent
// field and the significand of the value it is printing, and no arithmetic operator can produce
// them; the same is true of `stdlib/PrimitiveExtensions.maxon`'s `float.hash`.
//
// ⭐ **THE INSTRUCTION IS NOT NEW — this is only the DOOR.** `StdUnaryOpcode.bitcastF64ToI64`
// is what `float.hash` uses (`Runtime/BuiltinConformanceRuntime.maxon` builds it as a Std graph) and has
// an isel on all three targets: x64 `movq r64, xmm`, arm64 `fmov x, d`, wasm `i64.reinterpret_f64`. This
// name and its enum arm are the way to REACH it from Maxon source, rather than a backend change.
//
// ⭐ **`__Builtins.bitsToFloat(bits)` — THE SAME REINTERPRETATION READ BACK, WHICH IS WHAT LETS THE TREE
// HAVE ONE DECIMAL READER.** `stdlib/Builtins.maxon` has the exact, correctly-rounded
// `__float_bitsFromText` (which answers BITS), and turning bits back into an f64 is what makes
// `float.fromString("0.1")` and the literal `0.1` the same number.
let BuiltinsBitsToFloatName = b"__Builtins.bitsToFloat"

let OrderedWordArity = 3
let OrderedWordAliasName = b"OrderedWord"
let OrderedWordWidthRequirement = "a constant width of 2, 4 or 8"
let OrderedWordSourceRequirement = "ByteArray"
let NotACompileTimeConstant = "a value not known at compile time"

let BuiltinsFloatToBitsName = b"__Builtins.floatToBits"

// ⭐⭐ **`__Builtins.ucdByteAt("__ucd_bmp", offset: cp)` / `ucdI64At("__ucd_supp", index: i)` — THE
// TWO RAW READS OF THE CHECKED-IN UNICODE TABLES.**
// `stdlib/helpers/string/unicodeCategory.maxon:53-75` is written against exactly this pair, and it
// is the only corpus caller. Their lowering is `UnicodeCategoryRuntime`'s
// `__ucd_bmp_at`/`__ucd_supp_at`, the same two table reads `__ucd_cat` is built from.
//
// ⭐ **THEY ARE `__Builtins` INTRINSICS WITH A REAL DECLARATION.** A `name:` label names a PARAMETER
// OF A DECLARATION, so a hand-written parse hook with no parameter names leaves nothing for
// `offset: cp` to name — `E2004 Undefined variable 'offset'`. The answer is neither an exemption
// from the named-argument rule nor a re-spelling of the call: each has two parameters, `label` and
// `offset`/`index`, and the universal label rule binds with nothing added to it.
//
// ⇒ **They are emphatically NOT in `calleeTakesPositionalArgsOnly`** — that roster is the MATH intrinsics,
// the builtins that are permanently compiler-owned because each IS a machine instruction and will never
// acquire a declaration to take labels from. These two acquired one.
//
// ⚠ **THE LABEL IS REQUIRED**: `ucdByteAt("__ucd_bmp", 65)` answers E2053.
let BuiltinsUcdByteAtName = b"__Builtins.ucdByteAt"
let BuiltinsUcdI64AtName = b"__Builtins.ucdI64At"

// ⭐⭐ **`__DebugStream.nameId("regalloc.functionAllocated")` — A COMPILE-TIME NAME, NOT A VALUE.**
// `__DebugStream` is the compiler's second builtin TYPE, static-only like `__Builtins`; `nameId` is
// the member that turns a NAME into the u16 a structured trace event carries. Its argument is read off its
// own token and interned, so the text exists only in the executable's `MXDS_STRS` blob and **no String is
// ever built at run time** — which is the whole reason a pass may emit a trace event from inside the
// register allocator without allocating into the very `mm` stream the trace exists to read.
//
// ⇒ It is the one member intercepted BEFORE the arguments are parsed, and the only one whose argument is
// not a value. The five that reach the RING (`enabled`, `phaseBegin`, `phaseEnd`, `event`, `text`) take
// ordinary Maxon values and are recognized AFTER their arguments are parsed, exactly as the `__Builtins`
// table's members are — see `DebugStreamQualifierPrefix`.
//
// ⚠ It is NOT in `isBuiltinsIntrinsicCallee`'s table: that arm is gated on the `__Builtins.` prefix and this
// is a different type. It is intercepted at `parseCallNamed`, BEFORE the arguments are parsed, beside the
// two UCD table loads and for their exact reason — the literal's token is only the cursor there.
let DebugStreamNameIdCallee = b"__DebugStream.nameId"

// ⭐⭐ **THE FIVE `__DebugStream` MEMBERS THAT REACH THE RING.** `nameId` above turns a NAME
// into a number; these are what a program does with it — open and close a PHASE span, put a structured
// EVENT on the wire, put a human message there, and ask whether anything is listening at all. They are the
// only events in the whole wire schema a compiled program AUTHORS; every other family is the runtime
// talking about itself.
//
// ⚠ **THE FOUR EMITTING MEMBERS RETURN NOTHING, WHICH IS WHY THE STATEMENT DOOR HAS TO CLAIM THEM**
// (`qualifiedStaticCallsAt`). A bare statement is the only position a void call can be written in, and
// `TraceEvents.logEvent` / `PhaseProbe.begin` — the compiler's own emitters — write exactly that.
//
// ⚠⚠ **THE QUALIFIER IS THE TEST, NOT A ROSTER OF THE FIVE, AND THAT IS `isBuiltinsIntrinsicCallee`'s
// RULE ONE TYPE OVER.** A member this compiler does not recognize must reach the reserved-callee rejection
// that names it (`E3004: call to undefined function '__DebugStream.nope'`) rather than a complaint about
// SHAPE — in STATEMENT position exactly as in expression position, as for
// the user half of the same question.
let DebugStreamQualifierPrefix = b"__DebugStream."
let DebugStreamEnabledCallee = b"__DebugStream.enabled"
let DebugStreamPhaseBeginCallee = b"__DebugStream.phaseBegin"
let DebugStreamPhaseEndCallee = b"__DebugStream.phaseEnd"
let DebugStreamEventCallee = b"__DebugStream.event"
let DebugStreamTextCallee = b"__DebugStream.text"

// Each member's arity, named for `SleepIntrinsicArity`'s reason: an intrinsic has no signature for
// SemanticCheck's ordinary arity check to read, so the count IS the declaration and it belongs beside the
// name it declares.
let DebugStreamEnabledArity = 0

// `phaseBegin(nameId, unitId)` / `phaseEnd(nameId, unitId)` — the same two, which is why they share a
// constant as they share an entry point.
let DebugStreamPhaseArity = 2

// `event(nameId, category, level, unitId, arg0, arg1)`.
let DebugStreamEventArity = 6

// `text(category, level, unitId, message)`.
let DebugStreamTextArity = 4

// ⭐ **IS THIS CALLEE A MEMBER OF THE `__DebugStream` TYPE?** THE one test, with the same two askers
// `isBuiltinsIntrinsicCallee` has and the same obligation not to disagree: the member table in
// `parseCallNamed` and the STATEMENT door's `qualifiedStaticCallsAt`.
function isDebugStreamCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: DebugStreamQualifierPrefix)
end 'isDebugStreamCallee'

function isCompilerQualifierCallee(callee ByteArray) returns bool
	return isBuiltinsIntrinsicCallee(callee) or isRawIntrinsicCallee(callee) or isDebugStreamCallee(callee)
end 'isCompilerQualifierCallee'

// ⭐⭐ **THE `__Builtins` INTRINSICS `stdlib/Subprocess.maxon` BOTTOMS OUT IN — THE `subprocess*`
// NAMES PLUS `managedIsNull`, WHICH IS NOT ONE OF THEM.** That module is
// the whole child-process surface — `Subprocess.run(...)`, `Configuration.run()`, `runDetached()`
// and `StreamingSubprocess` — and every one of its leaves is a static call on one of these names.
// See `SubprocessRuntime.maxon` for the entry points each lowers to.
//
// ⚠ **`subprocessKill` AND `subprocessSendSignal` ARE DELIBERATELY ABSENT.** NOTHING in the corpus
// calls either — `stdlib/Subprocess.maxon` has no `kill()` and no `sendSignal()` surface at all. An
// intrinsic no program can reach is an entry point no spec can exercise, which is exactly the shape
// a backend panic hides in; they arrive with the stdlib method that needs them, not before.
//
// THE THREE FAMILIES, which is why the emits below are a handful of shared functions rather than one per name:
//   • the ATTACHED run — `subprocessSpawn` / `subprocessDetach` (the fifteen-argument contract),
//     `subprocessGetPid`, `subprocessQueueStdin`, `subprocessWaitCollect`, the five
//     `subprocessResult*` readers of the struct it answers, `subprocessResultRelease` and
//     `subprocessReleaseHandle`;
//   • the STREAMING child — `subprocessSpawnStreaming`, `subprocessWriteStdinAll` /
//     `subprocessWriteStdinBytes`, `subprocessPushStdin` / `subprocessAwaitStdinWritable` (the owner
//     thread's push of a queued payload), `subprocessReadAvailable` (what a stream has buffered, up to a count,
//     refilling once when it holds nothing), `subprocessCloseStdin`,
//     `subprocessWaitExit` and `subprocessEndTree`, which sit on the `__gt_subp_*` handle table rather than on a second
//     CreateProcess path;
//   • the HELPERS a caller needs around either — `subprocessResolveOnPath` (PATH + PATHEXT) and
//     `subprocessLastErrorMessage`, plus `managedIsNull`, which is not a subprocess entry at all (it is a
//     `__ManagedMemory` predicate lowering to `__mm_is_null`) and is here because this is its only caller.
let BuiltinsSubprocessSpawnName = b"__Builtins.subprocessSpawn"
let BuiltinsSubprocessDetachName = b"__Builtins.subprocessDetach"
let BuiltinsSubprocessGetPidName = b"__Builtins.subprocessGetPid"
let BuiltinsSubprocessWaitCollectName = b"__Builtins.subprocessWaitCollect"
let BuiltinsSubprocessReleaseHandleName = b"__Builtins.subprocessReleaseHandle"
let BuiltinsSubprocessResultStatusKindName = b"__Builtins.subprocessResultStatusKind"
let BuiltinsSubprocessResultStatusCodeName = b"__Builtins.subprocessResultStatusCode"
let BuiltinsSubprocessResultStdoutName = b"__Builtins.subprocessResultStdout"
let BuiltinsSubprocessResultStderrName = b"__Builtins.subprocessResultStderr"
let BuiltinsSubprocessResultDurationMsName = b"__Builtins.subprocessResultDurationMs"
let BuiltinsSubprocessResultReleaseName = b"__Builtins.subprocessResultRelease"
let BuiltinsSubprocessResolveOnPathName = b"__Builtins.subprocessResolveOnPath"
let BuiltinsSubprocessLastErrorMessageName = b"__Builtins.subprocessLastErrorMessage"
let BuiltinsSubprocessLastErrorCodeName = b"__Builtins.subprocessLastErrorCode"
let BuiltinsSubprocessSpawnStreamingName = b"__Builtins.subprocessSpawnStreaming"
let BuiltinsSubprocessWriteStdinAllName = b"__Builtins.subprocessWriteStdinAll"
let BuiltinsSubprocessWriteStdinBytesName = b"__Builtins.subprocessWriteStdinBytes"
let BuiltinsSubprocessQueueStdinName = b"__Builtins.subprocessQueueStdin"
let BuiltinsSubprocessPushStdinName = b"__Builtins.subprocessPushStdin"
let BuiltinsSubprocessAwaitStdinWritableName = b"__Builtins.subprocessAwaitStdinWritable"
let BuiltinsSubprocessReadAvailableName = b"__Builtins.subprocessReadAvailable"
let BuiltinsSubprocessCloseStdinName = b"__Builtins.subprocessCloseStdin"
let BuiltinsSubprocessWaitExitName = b"__Builtins.subprocessWaitExit"
let BuiltinsSubprocessEndTreeName = b"__Builtins.subprocessEndTree"

// ⭐ **THE NON-BLOCKING STREAMING MEMBERS.** A parent that drives a child AND stays responsive cannot
// use `subprocessWaitExit`: with a zero timeout it waits FOR EVER (the corpus's own convention for the
// whole family) and a non-zero one TERMINATES the child when it fires. These ask instead of committing —
// an exit poll that neither blocks nor kills.
let BuiltinsSubprocessPollExitName = b"__Builtins.subprocessPollExit"

// The signal that ended an exited child, 0 for none, or -1 while it runs — the exit poll's shape.
let BuiltinsSubprocessExitSignalName = b"__Builtins.subprocessExitSignal"

// ⭐ **THE TWO PER-STREAM STATE QUERIES, AND THEY ARE THE ONLY MEMBERS OF THIS FAMILY THAT ANSWER AN ENUM.**
// Every other subprocess intrinsic answers a machine word or an owned `__ManagedMemory`; these answer
// `__SubprocessStreamState` itself, so `stdlib/Subprocess.maxon` discriminates them with an exhaustive
// `match` and holds no ordinal of its own. That is what the arms below buy with `resultNameId`.
let BuiltinsSubprocessStdoutStateName = b"__Builtins.subprocessStdoutState"
let BuiltinsSubprocessStderrStateName = b"__Builtins.subprocessStderrState"
let BuiltinsManagedIsNullName = b"__Builtins.managedIsNull"

// The environment reader. It shares this band's managed-result emission, but it lowers to
// `__env_entry` and is gated by `HostFacility.environment`, not the subprocess facility: reading
// the environment needs no spawn. See `EnvironmentRuntime.EnvironmentEntryName`.
let BuiltinsOsEnvironmentEntryName = b"__Builtins.osEnvironmentEntry"

// ⭐ **THE EIGHT MEMBERS OF `stdlib/SharedMemory.maxon`'s FLOOR — A NAMED SECTION TWO PROCESSES BOTH MAP.**
// They are their own family rather than members of the subprocess band above: a section is not a child, and
// the E3104 gate reads the `__shm_` prefix their entries carry (`SharedMemoryRuntime`), so a lane can serve
// one without the other. `SharedMemoryRuntime` lists the entry points.
let BuiltinsSharedMemoryCreateName = b"__Builtins.sharedMemoryCreate"
let BuiltinsSharedMemoryMapName = b"__Builtins.sharedMemoryMap"
let BuiltinsSharedMemoryReadWordName = b"__Builtins.sharedMemoryReadWord"
let BuiltinsSharedMemoryWriteWordName = b"__Builtins.sharedMemoryWriteWord"
let BuiltinsSharedMemoryCopyOutName = b"__Builtins.sharedMemoryCopyOut"
let BuiltinsSharedMemoryCloseName = b"__Builtins.sharedMemoryClose"
let BuiltinsSharedMemoryAdoptName = b"__Builtins.sharedMemoryAdopt"
let BuiltinsSharedMemoryReleaseName = b"__Builtins.sharedMemoryRelease"

// ⭐⭐ **THE SIXTEEN MEMBERS OF `maxon-bin/Profile/`'s FLOOR — SAMPLING ANOTHER PROCESS'S THREADS.** Their
// own family rather than members of any band above, for the shared-memory family's reason: the E3104 gate
// reads the `__prof_` prefix their entries carry (`ProfileRuntime`), so a lane can serve one family without
// the other.
//
// ⛔ **THEY HAVE NO `stdlib/` WRAPPER AND MUST NOT GET ONE.** Nothing in the language wants to
// suspend a thread; the ONE caller is the profiler in this compiler.
let BuiltinsProfileOpenTargetName = b"__Builtins.profileOpenTarget"
let BuiltinsProfileNextThreadName = b"__Builtins.profileNextThread"
let BuiltinsProfileThreadIdName = b"__Builtins.profileThreadId"
let BuiltinsProfileThreadCyclesName = b"__Builtins.profileThreadCycles"
let BuiltinsProfileSampleName = b"__Builtins.profileSample"
let BuiltinsProfileTimerWaitName = b"__Builtins.profileTimerWait"
let BuiltinsProfileModuleSnapshotName = b"__Builtins.profileModuleSnapshot"
let BuiltinsProfileModuleFirstName = b"__Builtins.profileModuleFirst"
let BuiltinsProfileModuleNextName = b"__Builtins.profileModuleNext"
let BuiltinsProfileQueryProcessName = b"__Builtins.profileQueryProcess"
let BuiltinsProfileReadRemoteName = b"__Builtins.profileReadRemote"
let BuiltinsProfileCloseName = b"__Builtins.profileClose"
let BuiltinsProfileSleepName = b"__Builtins.profileSleepMicros"
let BuiltinsProfileMachSampleName = b"__Builtins.profileMachSample"
let BuiltinsProfileSeizedOpenName = b"__Builtins.profileSeizedOpen"
let BuiltinsProfileSeizedKillName = b"__Builtins.profileSeizedKill"
let BuiltinsProfileReadWordName = b"__Builtins.profileReadWord"
let BuiltinsProfileWriteWordName = b"__Builtins.profileWriteWord"
let BuiltinsProfileNowFileTimeName = b"__Builtins.profileNowFileTime"

let BuiltinsDebugReadMemoryName = b"__Builtins.debugReadMemory"
let BuiltinsDebugWriteMemoryName = b"__Builtins.debugWriteMemory"
let BuiltinsDebugReadContextName = b"__Builtins.debugReadContext"
let BuiltinsDebugWriteContextName = b"__Builtins.debugWriteContext"
let BuiltinsDebugWaitEventName = b"__Builtins.debugWaitEvent"
let BuiltinsDebugContinueEventName = b"__Builtins.debugContinueEvent"
let BuiltinsDebugBreakProcessName = b"__Builtins.debugBreakProcess"
let BuiltinsDebugAttachProcessName = b"__Builtins.debugAttachProcess"
let BuiltinsDebugDetachProcessName = b"__Builtins.debugDetachProcess"
let BuiltinsDebugProtectRegionName = b"__Builtins.debugProtectRegion"
let BuiltinsDebugFlushCodeName = b"__Builtins.debugFlushCode"
let BuiltinsDebugCloseHandleName = b"__Builtins.debugCloseHandle"
let BuiltinsDebugSuspendThreadName = b"__Builtins.debugSuspendThread"
let BuiltinsDebugResumeThreadName = b"__Builtins.debugResumeThread"
let BuiltinsDebugTraceRequestName = b"__Builtins.debugTraceRequest"
let BuiltinsDebugTraceeReadName = b"__Builtins.debugTraceeRead"
let BuiltinsDebugAwaitTraceeName = b"__Builtins.debugAwaitTracee"
let BuiltinsDebugThreadSignalName = b"__Builtins.debugThreadSignal"
let BuiltinsDebugProcessSignalName = b"__Builtins.debugProcessSignal"

let BuiltinsPinToMachineName = b"__Builtins.pinToMachine"
let BuiltinsUnpinFromMachineName = b"__Builtins.unpinFromMachine"
let BuiltinsCurrentMachineName = b"__Builtins.currentMachine"
let BuiltinsPinDepthName = b"__Builtins.pinDepth"

// The two positions the POSITIONAL shapes below name. Their own constants rather than the spawn contract's
// `SubprocessSpawnArgvSlot`, which is also 0 but says something else: these mean "the first/second argument
// of whatever contract this is", and that one means where a fifteen-wide contract puts its argv blob.
let IntrinsicFirstSlot = 0
let IntrinsicSecondSlot = 1

// ⭐ **WHAT EACH POSITION OF AN INTRINSIC'S ARGUMENT LIST CARRIES.** A closed shape rather than a list of
// indices passed around, because the map is a property of the CONTRACT and not of a call: the fifteen-
// argument spawn takes buffers at 0 and 3 and a `cstring` at four more positions, the streaming spawn takes
// buffers at 0 and 4 and one `cstring`, and most of the band takes machine words only. A `ParamCountArray`
// would express the same thing while allocating an array per parsed call to say "none". Count the cases off
// the enum rather than off this sentence.
enum IntrinsicArgShape
	// Every argument is a machine word — a handle, a result-struct pointer, a byte budget, a timeout, a
	// kind discriminator, a flags bitfield, a name id, a category or a unit.
	allMachineWords

	// Argument 0 is the buffer under test (`managedIsNull`).
	bufferFirst

	// The LAST argument is the String — `__DebugStream.text`'s message, whose three leading arguments are
	// the category, the level and the unit. It is named by POSITION-FROM-THE-END rather than by index
	// because that is what the member's shape actually says, and an index would be a fourth constant to
	// keep in step with its arity.
	stringLast

	// Argument 0 is a `cstring` — `subprocessResolveOnPath`'s executable name and `sharedMemoryCreate`'s
	// section name, each the only non-scalar its contract has.
	cstringFirst

	// Argument 1 is a `cstring` — the stdin payload of `subprocessWriteStdinAll`,
	// `subprocessWriteStdinBytes` and `subprocessQueueStdin`, whose argument 0 is the handle.
	cstringSecond

	// The LAST argument is a `cstring` — `sharedMemoryClose`'s published section NAME, whose three leading
	// arguments are the handle, the view base and the mapping's length. Named by POSITION-FROM-THE-END for
	// `stringLast`'s reason, which is the same shape one class over: an index would be a constant to keep in
	// step with an arity that has already moved once.
	cstringLast

	// The fifteen-argument spawn contract: the argv blob and the environment block, plus the working
	// directory and the three stdio payloads.
	spawn

	// The SIX-argument streaming contract. Its own case rather than a widening of `spawn`: the streaming
	// spawn carries no stdio triples, so its environment lands at a different index, and one case answering
	// both would have to tell the two contracts apart at every position rather than at one.
	streamingSpawn
end 'IntrinsicArgShape'

// ⭐ **THE THREE THINGS A `__Builtins` ARGUMENT CAN BE, AND THE REASON A SLOT ANSWERS A CLASS RATHER THAN A
// BOOLEAN.** A `cstring` and a machine word are the same WIDTH and were the same answer until
// `ValueTypeTag.cstring` existed. Two predicates over one shape could come to disagree about a slot — call
// it both a buffer and a pointer, or neither — and one exhaustive decoder cannot.
enum IntrinsicSlotClass
	machineWord
	buffer
	string
	cstring
end 'IntrinsicSlotClass'

// What does position `index` of a call under `shape` carry? The one place the shape above is decoded, so
// every `*Slot` constant has exactly one reader.
//
// ⚠ `arity` is taken because `stringLast` is the only case that cannot be answered from the index alone.
// The caller has already fixed `args.count()` at the arity, so the two agree by construction.
function intrinsicSlotClass(shape IntrinsicArgShape, index ParamCount, arity ParamCount) returns IntrinsicSlotClass
	return match shape 's'
		allMachineWords gives IntrinsicSlotClass.machineWord
		bufferFirst gives IntrinsicSlotClass.buffer if index == IntrinsicFirstSlot else IntrinsicSlotClass.machineWord
		stringLast gives IntrinsicSlotClass.string if index == arity - 1 else IntrinsicSlotClass.machineWord
		cstringFirst gives IntrinsicSlotClass.cstring if index == IntrinsicFirstSlot else IntrinsicSlotClass.machineWord
		cstringSecond gives IntrinsicSlotClass.cstring if index == IntrinsicSecondSlot else IntrinsicSlotClass.machineWord
		cstringLast gives IntrinsicSlotClass.cstring if index == arity - 1 else IntrinsicSlotClass.machineWord
		spawn gives spawnSlotClass(index)
		streamingSpawn gives streamingSpawnSlotClass(index)
	end 's'
end 'intrinsicSlotClass'

// The fifteen-argument contract's slot map. Its own function because it is the only shape with more than
// one named position of each class, and six comparisons written into a `gives` arm read as a wall.
function spawnSlotClass(index ParamCount) returns IntrinsicSlotClass
	if index == SubprocessSpawnArgvSlot or index == SubprocessSpawnEnvSlot 'aBuffer'
		return IntrinsicSlotClass.buffer
	end 'aBuffer'

	if index == SubprocessSpawnCwdSlot or index == SubprocessSpawnStdinDataSlot or index == SubprocessSpawnStdoutDataSlot or index == SubprocessSpawnStderrDataSlot 'aCString'
		return IntrinsicSlotClass.cstring
	end 'aCString'

	return IntrinsicSlotClass.machineWord
end 'spawnSlotClass'

// The streaming contract's slot map. The working directory sits where the attached contract puts it — both
// spell `argv, argc, cwd` and diverge only past that — and the environment block does not.
function streamingSpawnSlotClass(index ParamCount) returns IntrinsicSlotClass
	if index == SubprocessSpawnArgvSlot or index == SubprocessStreamingSpawnEnvSlot 'aBuffer'
		return IntrinsicSlotClass.buffer
	end 'aBuffer'

	if index == SubprocessSpawnCwdSlot 'aCString'
		return IntrinsicSlotClass.cstring
	end 'aCString'

	return IntrinsicSlotClass.machineWord
end 'streamingSpawnSlotClass'

// `floatToBits(x)` takes exactly one FLOAT and `bitsToFloat(b)` exactly one INTEGER. Stated here beside
// the intrinsics for `CommandLineArgArity`'s reason — an intrinsic has no signature for SemanticCheck's
// ordinary arity check to read.
let FloatToBitsArity = 1
let BitsToFloatArity = 1

// `commandLineCount()` takes nothing; `commandLineArg(index)` takes exactly one INTEGER. Stated here beside
// the intrinsics for `SleepIntrinsicArity`'s reason — an intrinsic has no signature for SemanticCheck's
// ordinary arity check to read, because no file declares it.
let CommandLineCountArity = 0
let CommandLineArgArity = 1

// `readStdin(maxBytes)` takes exactly one INTEGER byte budget; `executablePath()` takes nothing. Stated here
// beside the intrinsics for `CommandLineArgArity`'s reason — an intrinsic has no signature for SemanticCheck's
// ordinary arity check to read, because no file declares it.
let ReadStdinArity = 1
let ExecutablePathArity = 0
let ProcessNamespaceArity = 0
let FillRandomArity = 1
let TrustStoreOpenArity = 0
let TrustStoreCloseArity = 1
let TrustStoreCursorArity = 2

// `currentProcessId()` takes nothing. Stated here beside the two above for `CommandLineArgArity`'s reason —
// an intrinsic has no signature for SemanticCheck's ordinary arity check to read, because no file declares
// it.
//
// ⚠ **A THIRD ZERO, AND DELIBERATELY NOT A SHARED ONE.** `CommandLineCountArity` and `ExecutablePathArity`
// are already both `0`, which is the idiom this band follows: one constant per INTRINSIC, because the
// number is a fact about that intrinsic's contract and not about the band. (The `SubprocessOneArgArity`
// family's *"a sixth constant equal to an existing one would be a second name for one fact"* is the
// opposite case and does not reach here: there, a few SHAPES are shared across the whole band by contract, so
// the shape is the fact.)
let CurrentProcessIdArity = 0
let ProcessIsAliveArity = 1
let ProcessEndDescendantsArity = 2

// `gtIsComplete(gt)` takes exactly one machine word — the green-thread handle. Stated here for
// `CommandLineArgArity`'s reason, and as its own constant for `CurrentProcessIdArity`'s.
let GtIsCompleteArity = 1

// `awaitAny(promises)` takes exactly one array of promises. Its own constant beside its sibling's for
// `CurrentProcessIdArity`'s reason: the number is a fact about THIS intrinsic's contract.
let AwaitAnyArity = 1

// What `__Builtins.awaitAny` will accept, as the `builtinOperandPhrase` sentence renders it — *"'…' requires
// {required}, but its argument is {got}"*. Named rather than written at the throw for
// `StringLiteralRequirement`'s reason: it is a phrase a spec pins, not an incidental string.
let PromiseArrayRequirement = "a promise array — an `Array` whose element type is a `Promise with …`"

// `writeStdout(mm)`/`writeStderr(mm)` each take exactly one `__ManagedMemory`. ONE constant for both, not
// two: it is a single fact about a single shape, and the two names are the same intrinsic on two streams.
// Stated here for `CommandLineArgArity`'s reason — an intrinsic has no signature for SemanticCheck's
// ordinary arity check to read, because no file declares it.
let StreamWriteArity = 1

// ⭐ **THE ARGUMENT SHAPES THE SUBPROCESS INTRINSICS FALL INTO.** Stated here for `CommandLineArgArity`'s
// reason — an intrinsic has no signature for SemanticCheck's ordinary arity check to read, because no file
// declares it — and stated as SHAPES rather than one constant per name because a shape is what a caller can
// get wrong: the handle ops take one, the timed ops two, the counted stdin ops three, the
// last-error read none, a spawn fifteen and a streaming spawn six. A further constant equal to an
// existing one would be a second name for one fact.
let SubprocessOneArgArity = 1
let SubprocessTwoArgArity = 2
let SubprocessThreeArgArity = 3
let SubprocessNoArgArity = 0

// The fifteen-argument spawn contract, in order: `argv_mm, argc, cwd_cstr, env_mm, envInherit,
// stdinKind, stdinData_cstr, stdoutKind, stdoutData_cstr, stdoutLimit, stderrKind, stderrData_cstr,
// stderrLimit, flags, stdinLength`. `subprocessDetach` takes the identical fifteen and differs only in what
// it answers (a pid rather than a handle); the runtime gates the detached path on `flags` bit 2.
let SubprocessSpawnArity = 15

// `subprocessSpawnStreaming(argv_mm, argc, cwd_cstr, flags, env_mm, envInherit)` — the streaming spawn
// takes no stdio triples because all three of its streams are pipes by definition, and it takes the
// environment pair the attached contract carries at 3/4 because a monitor has to TELL its child something
// before the child's first instruction runs.
let SubprocessStreamingSpawnArity = 6

// The two POSITIONS in the spawn contract that carry a `__ManagedMemory` rather than a scalar — the argv
// blob and the environment block. Named because `spawnSlotClass` reads them as indices, and an index into a
// fifteen-wide contract is exactly the sort of bare number that goes wrong silently.
let SubprocessSpawnArgvSlot = 0
let SubprocessSpawnEnvSlot = 3

// The streaming contract's own environment position. It differs from `SubprocessSpawnEnvSlot` because the
// two contracts differ rather than by oversight: the streaming spawn has no stdio triples between the
// working directory and the environment, so the block lands past the flags rather than before them.
let SubprocessStreamingSpawnEnvSlot = 4

// The working directory, which BOTH spawn contracts put here — one constant because it is one fact: the
// attached and streaming lists agree on `argv, argc, cwd` and diverge only past it.
let SubprocessSpawnCwdSlot = 2

// The `data` half of each of the fifteen-argument contract's three (kind, data, limit) stdio triples. A
// `cstring` at every one of them even for a kind that carries no payload: `stdlib/Subprocess.maxon` passes
// an EMPTY one there rather than a null, and the runtime reads the leading NUL as "no payload".
let SubprocessSpawnStdinDataSlot = 6
let SubprocessSpawnStdoutDataSlot = 8
let SubprocessSpawnStderrDataSlot = 11

// ⭐ **THE THREE ARGUMENT SHAPES THE SIX SHARED-MEMORY INTRINSICS FALL INTO.** Stated here for
// `CommandLineArgArity`'s reason — an intrinsic has no signature for SemanticCheck's ordinary arity check
// to read. They are the shared-memory family's own numbers rather than the subprocess band's above: the
// two contracts are independent, and sharing a constant would let a change to one silently move the other.
let SharedMemoryTwoArgArity = 2
let SharedMemoryThreeArgArity = 3

// The teardown takes the handle, the view base, the mapping's length and the published name — three
// steps on a POSIX lane where Win32 needs two (`SharedMemoryRuntime.buildSharedMemoryClose`).
let SharedMemoryFourArgArity = 4

// ⭐ **THE FIVE ARGUMENT COUNTS THE SIXTEEN SAMPLING INTRINSICS FALL INTO.** Stated here for
// `SharedMemoryTwoArgArity`'s reason — an intrinsic has no signature for SemanticCheck's ordinary arity
// check to read — and as this family's OWN numbers, so a change to one contract cannot silently move
// another's. Every argument of every one of them is a machine word: a handle, a pid, a scratch address, a
// byte offset or a byte count.
let ProfileNoArgArity = 0
let ProfileOneArgArity = 1
let ProfileTwoArgArity = 2
let ProfileThreeArgArity = 3
let ProfileFourArgArity = 4

// The suspended window's whole contract: the process, the thread, the three caller-owned scratch records
// and the window's capacity (`ProfileRuntime.buildProfileSample`).
let ProfileSampleArity = 6

let DebugHostNoArgArity = 0
let DebugHostOneArgArity = 1
let DebugHostTwoArgArity = 2
let DebugHostThreeArgArity = 3
let DebugHostFourArgArity = 4
let DebugHostFiveArgArity = 5

// ⭐ **IS THIS CALLEE A MEMBER OF THE `__Builtins` TYPE?** THE one test, and it has two askers that
// must never disagree: the intrinsic table in `parseCallNamed` (which dispatches on it) and the
// STATEMENT door's `qualifiedStaticCallsAt` (which decides that `__Builtins.sleep(ms)` on a line of
// its own is a statement at all). Written once for the reason `isClockRuntimeCallee` is — a band's
// membership question belongs with the band's names, not restated at each site.
function isBuiltinsIntrinsicCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: BuiltinsQualifierPrefix)
end 'isBuiltinsIntrinsicCallee'

// ⭐⭐ **WHICH `name:` LABEL REGIME A CALLEE'S ARGUMENT LIST IS PARSED UNDER — the one place the
// question is answered, read by `parseCallNamed` and by nothing else.**
//
// The rule it states is not "is it a builtin" but the thing a label actually needs: **a `name:` label
// names a PARAMETER OF A DECLARATION, so a callee with no parameter names has no position at which a
// label could be right or wrong.** Two disjoint families answer that way, for two different reasons, and
// keeping them separate is what stops this from collapsing into a prefix test:
//
//   • the MATH intrinsics (`calleeTakesPositionalArgsOnly`) — permanently compiler-owned because each IS
//     a machine instruction, and therefore will never acquire a declaration to take labels from;
//   • the `__Builtins.*` INTRINSICS — the stdlib's floor. `stdlib/Print.maxon`'s `print` is the
//     declaration; `__Builtins.writeStdout` is what its body calls, permanently. The stdlib WRAPS these,
//     it never declares them, so no parameter name will ever exist here either.
//
// ⚠⚠ **THE TEST IS THE `__Builtins.` QUALIFIER AND NOT THE COMPILER'S ROSTER OF IMPLEMENTED INTRINSICS**, which
// is deliberate: a label regime is chosen while the argument list is still being PARSED, long before
// anything can know whether the name resolves at all. So a `__Builtins.*` name the compiler does NOT implement —
// and there are such names, `__Builtins.subprocessSpawn` among them — parses positionally and then meets
// the diagnostic that is actually true of it, `E3004: call to undefined function`, instead of a label
// complaint standing in front of it.
//
// ⚠⚠ **THAT `__Builtins` HALF WAS A LIVE DEFECT THAT LEFT NO LEGAL SPELLING, AND IT WAS MEASURED.**
// `stdlib/Subprocess.maxon` calls `__Builtins.subprocessSpawn` with fifteen positional arguments;
// The compiler answered E2053 (*"the second and later arguments must be named"*) — while the BOOTSTRAP, which
// reads the identical file, has no labelled spelling of an intrinsic call AT ALL: measured on
// `__Builtins.subprocessWaitCollect(-1, timeoutMs: 0)` it answers
// `E2004: Undefined variable 'timeoutMs'`, because it parses the would-be label as a value expression,
// and it compiles the positional form clean. So the label the compiler demanded was one no spelling of that file
// could carry — the corpus is shared, and `/specs/builtins-type.md:36-53` documents every one of these
// intrinsics POSITIONALLY, which is the language's own answer.
//
// ⚠ **THE TWO UCD INTRINSICS ARE NOT AN EXCEPTION TO THIS — THEY NEVER REACH IT** (they have real
// parameter names in BOTH compilers, so their label is checked rather than ignored). They are recognized
// in `parseCallNamed` BEFORE the argument list is opened and parse their own arguments in
// `parseUcdTableLoad`, so the split is structural rather than a roster to keep in step: an intrinsic with
// parameter names parses its own arguments; one without comes through here.
//
// ⚠ **WIDENING MOVES NO WORKING PROGRAM — BUT IT DOES MOVE A DIAGNOSTIC, AND BOTH HALVES ARE MEASURED.**
// The two directions have different reasons and the roster is NOT one of them, so state them apart:
//
//   • **RECOGNIZED** intrinsics — every arm of `parseCallNamed`'s `__Builtins` chain — take 0 or 1
//     argument, so a label on one is refused either way. Under the declared-callee rule it would be
//     E2052, whose sentence blames a default on a parameter `__Builtins.readStdin(n: 8)` does not
//     have. E2067 says the true thing, which is the same wrong-noun correction
//     `calleeTakesPositionalArgsOnly`'s header records for the arity-1 math intrinsics.
//   • **UNRECOGNIZED** ones can carry any arity — `stdlib/Subprocess.maxon`'s fifteen is the case
//     that opened this — and they were never a working program either: the labelled spelling parsed
//     under the declared-callee rule and died at E3004 one pass later. What moves is WHICH refusal
//     speaks first. MEASURED both ways on `__Builtins.subprocessWaitCollect(1, timeoutMs: 0)`:
//     E3004 before, E2067 now. That is the correct direction — the label really is wrong, and
//     saying so at the label is nearer the mistake than a resolution failure reported after the
//     whole list is parsed.
//
// No committed expectation moves: the only `maxoncstderr` pin of E2052 against a `__Builtins` callee is
// `specs/builtins-ucd.md`'s, and that one is on the ucd path above.
//
// ⚠ **THE `__DebugStream` MEMBERS ARE THE THIRD FAMILY.** No parameter names are registered for
// them: the five members are recognized by name and their arguments are read by POSITION
// (`emitScalarIntrinsicCall`), so there is nothing here for a label to be checked against.
//
// ⇒ An unchecked label on a SIX-ARGUMENT call is not a convenience, it is a silent mis-slot:
// `event(n, level: 1, category: 2, …)` would be accepted and the two fields swapped, and no later pass can
// notice — no signature exists for one to read. Refusing the label is what makes the positional order the
// only order. The positional spelling is the one BOTH compilers accept, it is what `Logger`/`PhaseProbe`
// write, and `specs/debugstream-log-events.md` pins the refusal so the divergence stays deliberate.
//
// ⭐ **A DECLARATION TAKES THE NAME BACK, WHICH IS WHY THIS ASKS `shadowedByADeclaration`.** A bare-name
// builtin owns its spelling only while no file declares one; once a file does, the call binds to that
// declaration and must meet the declared-callee label rule (`firstNamedIfDefaulted`), because the
// declaration has real parameters for a label to name. The two other families can never be
// shadowed — a `__Builtins.` / `__DebugStream.` callee is qualified, and no file can declare that
// name — so the term costs them nothing. It is one question asked once in `parseCallNamed` and
// threaded to both halves: the label rule fires while the arguments are parsed and the emit is
// chosen after, and a builtin that answered one way here and the other way there would slot a
// user's arguments under the compiler's rule.
function argLabelRuleForCallee(callee ByteArray, shadowedByADeclaration bool) returns ArgLabelRule
	if shadowedByADeclaration 'aFileOwnsThisName'
		return ArgLabelRule.firstNamedIfDefaulted
	end 'aFileOwnsThisName'

	return ArgLabelRule.allPositional if calleeTakesPositionalArgsOnly(callee) or isBuiltinsIntrinsicCallee(callee) or isDebugStreamCallee(callee) else ArgLabelRule.firstNamedIfDefaulted
end 'argLabelRuleForCallee'

// Every clock intrinsic reads a clock and takes nothing.
let ClockIntrinsicArity = 0

// `__Builtins.sleep` takes exactly one INTEGER argument — the duration in milliseconds (per
// `specs/sleep.md`) — and returns void.
//
// ⚠ **THIS IS THE INTRINSIC'S ARITY, NOT `sleep`'s.** A source `sleep(ms)` is an ordinary call to
// `stdlib/Sleep.maxon`'s declaration, and the arity it meets is that declaration's, checked by
// SemanticCheck against its signature exactly like every other call's. An intrinsic has no signature for
// that check to read — no file declares it — which is the whole reason this constant exists, and why it
// belongs here beside the intrinsic table rather than up with the bare-name builtins.
let SleepIntrinsicArity = 1

// `__Builtins.yield` takes NOTHING and returns void — `Scheduler.yield()` has no knob to turn. Stated here for
// `SleepIntrinsicArity`'s reason: an intrinsic has no signature for SemanticCheck's ordinary arity check to
// read, because no file declares it.
let YieldIntrinsicArity = 0

// The scale between the two MONOTONIC readings — `currentTimeMs()` IS `currentTimeNanos() / 1e6`. Named
// here because this is the only place it is applied; the wall clock's own two scale constants live with
// the runtime function that uses them (`ClockRuntime.maxon`).
let NanosPerMillisecond = 1000000

// ⭐ **DID THE COMPILER SPELL THE CALLEE'S HEAD?** — the provenance question the shadow-mint exemption
// asks, over the two mints that join a RESOLVED type name to something: a method dispatch's receiver type
// (`p.join(…)` ⇒ `__FilePath.join`, or a scriptlib head the rename respelled) and a range operator's
// stdlib type (`a upto b` ⇒ `__OpenRange.create`).
// A roster rather than `!= notMinted` for `mintSpellsTheWholeCallee`'s reason: the arms that mint a `__`
// HELPER name are a different fact and must not be swept in by a negation.
function mintHeadIsTheCompilers(mint CalleeMint) returns bool
	return match mint 'm'
		notMinted or
		primitiveStatic or
		paramDefaultHelper or
		fromConstructionInit or
		fieldDefaultHelper gives false
		resolvedTypeQualifier or
		resolvedStaticTypeQualifier or
		rangeOperator gives true
	end 'm'
end 'mintHeadIsTheCompilers'

// Is this call site's callee a DEFAULT VALUE's synthesized helper — a parameter's or a field's? The two
// mints are separate because the diagnostic noun each decodes to is different
// (`SemanticCheck.callDiagnosticNoun`), and every OTHER question about them has one answer, so it is
// asked once here rather than as two clauses at each door.
// The value tag a `__Raw` row's result carries. Every operand and result of the raw floor is a machine
// word, so the map is the two-case one the table's `RawResultKind` states; it is HERE because
// `ValueTypeTag` is this tier's vocabulary and the table is deliberately free of it.
function rawIntrinsicResultTag(intrinsic RawIntrinsic) returns ValueTypeTag
	return match rawResultKindOf(intrinsic) 'kind'
		machineWord gives ValueTypeTag.integer
		nothing gives ValueTypeTag.void
	end 'kind'
end 'rawIntrinsicResultTag'

let MaxDeclaredMembers = 65535
let MaxEnumBackingEntries = 65536

function calleeMintIsDefaultHelper(mint CalleeMint) returns bool
	return mint == CalleeMint.paramDefaultHelper or mint == CalleeMint.fieldDefaultHelper
end 'calleeMintIsDefaultHelper'

function requireMemberCount(count ElementIndex, limit ElementIndex, members String, anchor Token) throws SourceParseError
	if count <= limit 'withinTheLimit'
		return
	end 'withinTheLimit'

	throw SourceParseError.unsupported("a declaration with more than {limit} {members} — the layout numbers them in sixteen bits, so a declaration past that has no layout to number them in", line: anchor.line, column: anchor.column)
end 'requireMemberCount'

// ⭐⭐ **THE ONE PLACE A SIGNATURE'S ARGUMENT COUNT IS JUDGED**, asked of the ABI count and of nothing
// else. `paramCount` is the part of the calling convention the parse fixes: the parameters the source
// writes, PLUS a witness per interface-typed parameter, PLUS the fixed element count, PLUS one witness per
// `where` constraint. Every one of those occupies an argument slot and a mask bit, so every one counts. The
// layout slot, and the witnesses a static carries only beside it, are counted at lowering
// (`reserveLayoutParameters`), for the functions that turn out to carry them.
//
// The ceiling itself is `MaxAbiArgs` — the width of the per-argument float mask both ends of every call
// route through (`StdDialect.ArgFloatMask`), which is where the reason lives. It is NOT a register count:
// arguments past the register files travel in stack slots, and a target's register depth is a property of
// that target's ABI (six per file on x64, eight on arm64), not of the language.
function requireAbiParamCount(paramCount ParamCount, anchor Token) throws SourceParseError
	if paramCount <= MaxAbiArgs 'withinCeiling'
		return
	end 'withinCeiling'

	throw SourceParseError.unsupported(abiSlotCeilingSentence(paramCount), line: anchor.line, column: anchor.column)
end 'requireAbiParamCount'

function abiSlotCeilingSentence(paramCount ParamCount) returns String
	return "a function with {paramCount} argument slots — more than the {MaxAbiArgs} a call can carry. A signature's slots are its declared parameters plus the hidden ones the ABI adds (a witness per interface-typed parameter, a layout descriptor for a generic that reads one or calls a function that does, one witness per `where` constraint), and the limit is the width of the per-argument float mask that routes each one to its register file"
end 'abiSlotCeilingSentence'

type WitnessReserve
	export let unconditional as ParamCount
	export let conditional as ParamCount

	static function create(unconditional ParamCount, conditional ParamCount) returns WitnessReserve
		return Self{unconditional: unconditional, conditional: conditional}
	end 'create'

	static function none() returns WitnessReserve
		return Self{unconditional: 0, conditional: 0}
	end 'none'
end 'WitnessReserve'

function layoutReserveFor(mayCarryADescriptor bool, conditionalWitnesses ParamCount) returns ParamCount
	return conditionalWitnesses + LayoutSlotWidth if mayCarryADescriptor else 0
end 'layoutReserveFor'

function requireCallArgumentFitsTheAbi(column ParamCount, anchor Token) throws SourceParseError
	if column < MaxAbiArgs 'withinCeiling'
		return
	end 'withinCeiling'

	throw SourceParseError.unsupported("a call with more than {MaxAbiArgs} arguments — no signature has more than {MaxAbiArgs} argument slots, so no callee can take this call", line: anchor.line, column: anchor.column)
end 'requireCallArgumentFitsTheAbi'

// ⭐ **`byteLength` — THE `Character` SURFACE'S BYTE COUNT, AND ONLY THAT.** Its two consumers are
// `characterSurfaceMemberNames` and `dispatchCharacterMethod`'s arm, which reads `length@8` off the fused
// record inline. `String.byteLength` is `stdlib/String.maxon:269`'s, so the name is surface-neutral like
// its siblings `ByteAtMethod` / `ClearMethod` / `CloneMethodName` — one spelling shared by whichever
// surfaces still serve it, the same arrangement `ByteViewMethod` below records for `bytes`.
let ByteLengthMethod = b"byteLength"

// ⭐ **THE `bytes` METHOD NAME.** It is `characterSurfaceMemberNames`' alone — `String.bytes` is
// `stdlib/String.maxon:495`'s. One constant because a String's bytes and a Character's are the same
// question about the same record, so the day `Character.bytes` retires too, one line goes.
//
// ⚠ `asciiValue` is NOT here: it is `SignatureIndex.CharacterAsciiValueMethod`, because its runtime callee
// is throwing and `GtRuntime.runtimeCalleeSourceMethod` reads the same constant to answer E3057.
let ByteViewMethod = b"bytes"

function markerMaskOf(markers BoolArray, firstPosition ParamCount = 0) returns ParamPositionMask
	var mask = NoParamPositions
	var position = firstPosition

	for marked in markers 'eachParam'
		if marked 'aMutableParameter'
			mask = maskWithParam(mask, param: position)
		end 'aMutableParameter'

		position = position + 1
	end 'eachParam'

	return mask
end 'markerMaskOf'

type ParamMarkerFacts
	export let written as ParamPositionMask
	export let heads as NameRoster

	static function create(written ParamPositionMask, heads NameRoster) returns ParamMarkerFacts
		return Self{written: written, heads: heads}
	end 'create'
end 'ParamMarkerFacts'

function typeStartsWith(kind TokenKind) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.int or kind == TokenKind.bool or kind == TokenKind.float or kind == TokenKind.selfType
end 'typeStartsWith'

function qualifierOperandStartsWith(kind TokenKind) returns bool
	return typeStartsWith(kind) or kind == TokenKind.leftParen
end 'qualifierOperandStartsWith'

// ⭐⭐ **`spawn`'s SPELLING — AN IDENTIFIER, NEVER A KEYWORD, WITH ITS OWN
// MEASUREMENT.** Two live declarations own the word and neither may be retokenized:
// `specs/associated-types.md:3493,3500` declares `static function spawn() returns Self` — a
// byte-identical port of `/specs/associated-types.md`, which the port rule forbids editing — and
// `stdlib/Subprocess.maxon` declares `StreamingSubprocess.spawn` / `spawnWithCwd` in a module the
// loader takes into EVERY compile. A `KeywordTable` row would break both on the day it landed, so
// `filter=associated-types` and `filter=subprocess` staying green IS this decision's gate.
//
// The recognition is EXACT rather than heuristic: the word is
// the prefix operator iff the next token past an optional `(capacity: …)` group
// (`spawnTargetIndexIn`) is an identifier or `Self`. Two adjacent NAME tokens open no expression
// the grammar has, and `newline` is a real token — so `return spawn` followed by a line break reads
// the local named `spawn`, and `Subprocess.spawn(cmd)` (whose `(` opens no `capacity:` group) is
// untouched.
let SpawnKeywordName = b"spawn"

// Is `tok` the WORD `spawn`? A free function over a TOKEN because the two askers hold different things: the
// PARSER asks it at a cursor, and the whole-program discovery walk (`Queries.discoveredTokenFactsOf`)
// asks it of a raw `TokenArray` with no `Parser` in scope at all. Two spellings of "is this the keyword" is
// the shape where the walk and the arm come to disagree about which programs contain a `spawn`.
function tokenIsTheSpawnKeyword(tok Token) returns bool
	return tok.kind == TokenKind.identifier and tok.value.equals(SpawnKeywordName)
end 'tokenIsTheSpawnKeyword'

let SpawnCapacityLabel = b"capacity"
let ArrayCreateCapacityName = b"capacity"
let ArrayCreateZeroedLabel = b"zeroed"

function spawnTargetIndexIn(tokens TokenArray, spawnIndex ElementIndex) returns ElementIndex
	let groupStart = spawnIndex + 1

	if tokenKindIn(tokens, index: groupStart) != TokenKind.leftParen or tokenKindIn(tokens, index: groupStart + 2) != TokenKind.colon 'noCapacityGroup'
		return groupStart
	end 'noCapacityGroup'

	let labelTok = try tokens.get(groupStart + 1) otherwise return groupStart

	if labelTok.kind != TokenKind.identifier or not labelTok.value.equals(SpawnCapacityLabel) 'notTheCapacityLabel'
		return groupStart
	end 'notTheCapacityLabel'

	var i = groupStart
	var depth = 0 as BracketDepth

	while true 'scan'
		let kind = tokenKindIn(tokens, index: i)

		if kind == TokenKind.eof 'fileEnd'
			return groupStart
		end 'fileEnd'

		if kind == TokenKind.leftParen 'openParen'
			depth = depth + 1
		end 'openParen'

		if kind == TokenKind.rightParen 'closeParen'
			depth = depth - 1
		end 'closeParen'

		i = i + 1

		if depth == 0 'groupClosed'
			break
		end 'groupClosed'
	end 'scan'

	return i
end 'spawnTargetIndexIn'

type SpawnTargetCall
	export let typeName as immutable ByteArray
	export let member as immutable ByteArray

	static function create(typeName ByteArray, member ByteArray) returns SpawnTargetCall
		return Self{typeName: typeName, member: member}
	end 'create'
end 'SpawnTargetCall'

// `<head>(.<name>)+ (`, read off raw tokens: the type is every segment but the last, as written
// (`stdlib.Range`), and `ServiceCompanions.spawnedTypeNameOf` resolves it. It is discovery's reader
// (`Queries.serviceSpawnFollowing`); which type a spawn starts is `Parser.parseSpawn`'s resolution of the
// site.
//
// Every name position asks `tokenCanBeAName`, not "is it an identifier": a keyword may be a declared
// name (a factory spelled `static function from(...)`).
//
// ⚠ It reads no scope, so a chain whose head is a binding still reads as a qualified type and mints that
// type's companions; `Parser.parseSpawn`, which reads the scope, refuses the site.
function spawnTargetCallIn(tokens TokenArray, targetIndex ElementIndex) returns SpawnTargetCall throws NoServiceSpawn
	let typeTok = try tokens.get(targetIndex) otherwise throw NoServiceSpawn.notOne

	if not tokenCanBeAName(typeTok) 'notATypeName'
		throw NoServiceSpawn.notOne
	end 'notATypeName'

	let memberSegment = chainSegmentsAt(tokens, at: targetIndex)

	if memberSegment == 0 'notQualified'
		throw NoServiceSpawn.notOne
	end 'notQualified'

	let openTok = try tokens.get(targetIndex + memberSegment * TokensPerQualifierSegment + 1) otherwise throw NoServiceSpawn.notOne

	if openTok.kind != TokenKind.leftParen 'notACall'
		throw NoServiceSpawn.notOne
	end 'notACall'

	return SpawnTargetCall.create(chainSpellingAt(tokens, at: targetIndex, segments: memberSegment - 1), member: chainMemberAt(tokens, at: targetIndex, segment: memberSegment))
end 'spawnTargetCallIn'

function tokenIsTheNameIn(tokens TokenArray, index ElementIndex, wanted ByteArray) returns bool
	if tokenKindIn(tokens, index: index) != TokenKind.identifier 'notAnIdentifier'
		return false
	end 'notAnIdentifier'

	return (try tokens.get(index) otherwise panic("tokenIsTheNameIn: index below count just checked but tokens.get({index}) failed")).value.equals(wanted)
end 'tokenIsTheNameIn'

function tokenIsTheZeroLiteralIn(tokens TokenArray, index ElementIndex) returns bool
	if tokenKindIn(tokens, index: index) != TokenKind.intLiteral 'notAnIntegerLiteral'
		return false
	end 'notAnIntegerLiteral'

	return (try tokens.get(index) otherwise panic("tokenIsTheZeroLiteralIn: index below count just checked but tokens.get({index}) failed")).value.equals(ZeroCapacityText)
end 'tokenIsTheZeroLiteralIn'

// The token count of the empty-array construction at `start` (`X.create()`, `X.create(0)` or
// `X.create(0, zeroed: true|false)`, which build the same array, so image folding reads them as one), or
// absent for any other tokens. The declaration sweep and the parse both read this one walk.
//
// ⚠ It is token-only because the sweep cannot resolve an alias, so each consumer gates by the declared type:
// a user type's `Foo.create(0)` stays a helper call. `SignatureIndex` also requires an Array instance for the
// argument forms, as the other containers' `create` is nullary (`parseBuiltinContainerStaticCall`).
function emptyCreateTokenCount(tokens TokenArray, start ElementIndex) returns ElementIndex throws AbsentError
	if tokenKindIn(tokens, index: start) != TokenKind.identifier or tokenKindIn(tokens, index: start + EmptyCreateDotOffset) != TokenKind.dot 'notADottedName'
		throw AbsentError.absent
	end 'notADottedName'

	if not tokenIsTheNameIn(tokens, index: start + EmptyCreateNameOffset, wanted: CreateMethod) or tokenKindIn(tokens, index: start + EmptyCreateOpenParenOffset) != TokenKind.leftParen 'notACreateCall'
		throw AbsentError.absent
	end 'notACreateCall'

	if tokenKindIn(tokens, index: start + EmptyCreateCloseParenOffset) == TokenKind.rightParen 'nullary'
		return EmptyCreateTokenCount
	end 'nullary'

	if not tokenIsTheZeroLiteralIn(tokens, index: start + EmptyCreateZeroOffset) 'notZeroCapacity'
		throw AbsentError.absent
	end 'notZeroCapacity'

	if tokenKindIn(tokens, index: start + EmptyCreateAfterZeroOffset) == TokenKind.rightParen 'zeroOnly'
		return EmptyCreateZeroTokenCount
	end 'zeroOnly'

	let zeroedValue = tokenKindIn(tokens, index: start + EmptyCreateZeroedValueOffset)

	if tokenKindIn(tokens, index: start + EmptyCreateAfterZeroOffset) == TokenKind.comma and tokenIsTheNameIn(tokens, index: start + EmptyCreateZeroedLabelOffset, wanted: ArrayCreateZeroedLabel) and tokenKindIn(tokens, index: start + EmptyCreateZeroedColonOffset) == TokenKind.colon and (zeroedValue == TokenKind.true or zeroedValue == TokenKind.false) and tokenKindIn(tokens, index: start + EmptyCreateZeroedCloseParenOffset) == TokenKind.rightParen 'zeroedForm'
		return EmptyCreateZeroedTokenCount
	end 'zeroedForm'

	throw AbsentError.absent
end 'emptyCreateTokenCount'

function tokenKindIn(tokens TokenArray, index ElementIndex) returns TokenKind
	if index >= tokens.count() 'pastEnd'
		return TokenKind.eof
	end 'pastEnd'

	return (try tokens.get(index) otherwise panic("tokenKindIn: index below count just checked but tokens.get({index}) failed")).kind
end 'tokenKindIn'

enum BlockShift
	none
	opens
	closes
end 'BlockShift'

typealias BlockShiftAt = function(ElementIndex) returns BlockShift mutates captures

function ignoreBlocks(_ ElementIndex) returns BlockShift
	return BlockShift.none
end 'ignoreBlocks'

// One past the last token of the statement starting at `start`: it runs to the END OF ITS LINE, or
// to the `end` that closes the block it sits in. Maxon has no statement terminator, so the newline
// IS the boundary.
//
// ⚠ **EXCEPT INSIDE A BRACKET, OR A BLOCK THE STATEMENT OPENS.** The lexer drops the layout inside
// `(`, `[` and `{` but keeps the newlines of a `match` or block-form `otherwise` written there
// (`Lexer.dropBracketedLayout`), so such a block reaches this scan with newlines in it; the depth
// counters keep them inside the statement. Only the blocks `blockShiftAt` reports are counted.
//
// It cannot run away: `tokenKindIn` answers `eof` past the end of the token array, so
// an unterminated last line — or an unclosed bracket — stops at the file's end rather than walking off it.
function statementEndIndexIn(tokens TokenArray, start ElementIndex, blockShiftAt BlockShiftAt) returns ElementIndex
	var i = start
	var brackets = 0 as BracketDepth
	var blocks = 0 as BlockDepth

	while true 'scan'
		let kind = tokenKindIn(tokens, index: i)

		if kind == TokenKind.eof 'fileEnd'
			break
		end 'fileEnd'

		let shift = blockShiftAt(i)

		if brackets == 0 and blocks == 0 and (tokenKindEndsALine(kind) or shift == BlockShift.closes) 'statementEnd'
			break
		end 'statementEnd'

		if tokenKindOpensABracket(kind) 'openBracket'
			brackets = brackets + 1
		end 'openBracket'

		// Guarded, because both depths are unsigned: a stray closer with no opener before it would wrap
		// the counter to its maximum and the scan would swallow the rest of the FILE.
		if tokenKindClosesABracket(kind) and brackets > 0 'closeBracket'
			brackets = brackets - 1
		end 'closeBracket'

		if shift == BlockShift.opens 'openBlock'
			blocks = blocks + 1
		end 'openBlock'

		if shift == BlockShift.closes and blocks > 0 'closeBlock'
			blocks = blocks - 1
		end 'closeBlock'

		i = i + 1
	end 'scan'

	return i
end 'statementEndIndexIn'

function defaultDeclarationAt(tokens TokenArray, index ElementIndex) returns bool
	if tokenKindIn(tokens, index: index) != TokenKind.default 'notTheKeyword'
		return false
	end 'notTheKeyword'

	if index > 0 and tokenKindIn(tokens, index: index - 1) != TokenKind.newline 'notAtAStatementStart'
		return false
	end 'notAtAStatementStart'

	return tokenKindIn(tokens, index: index + 1) == TokenKind.identifier and tokenKindIn(tokens, index: index + 2) == TokenKind.equals
end 'defaultDeclarationAt'

function defaultDeclarationFrom(tokens TokenArray, index ElementIndex, path FilePath, isStdlibSource bool) returns DefaultDeclaration
	let keyTok = try tokens.get(index + 1) otherwise panic("defaultDeclarationFrom: `defaultDeclarationAt` saw the key at {index + 1}")
	let exprStart = index + 3

	return DefaultDeclaration.create(keyTok.value, declFilePath: path, keyRange: SourceRange.ofToken(keyTok), isStdlibSource: isStdlibSource, exprStart: exprStart, exprEnd: statementEndIndexIn(tokens, start: exprStart, blockShiftAt: ignoreBlocks))
end 'defaultDeclarationFrom'

// ⭐⭐ **`test`'s SPELLING — AN IDENTIFIER, NEVER A KEYWORD, FOR `spawn`'s REASON AND WITH
// ITS OWN MEASUREMENT.** `test` stands as an ORDINARY IDENTIFIER in a declaration position **34 times** in
// `maxon-bin/` + `stdlib/` today — `plain(test ValueId)` (`Parser.maxon:8906`), `let test = try
// self.emitCompare` (`:38475`), `function selectableThisRun(test SpecTest, …)`
// (`Testing/SpecTestRunner.maxon:1152`) — so a
// `KeywordTable` row would break this compiler's own source on the day it landed, exactly as `spawn`'s would
// have. **The self-compile IS that measurement's gate**, for free: an over-greedy recognizer turns it red.
//
// The recognition is EXACT rather than heuristic: the word opens a
// declaration iff the very next token is a CHARACTER LITERAL — the test's quoted prose name — AND the
// cursor stands where a declaration may start. Both halves are needed and neither suffices:
// `match test 'check'` is also an identifier followed by a character literal, and only the position tells
// the two apart, which is `test-declaration/test-stays-an-ordinary-identifier`'s whole content.
//
// ✅ **NO LEXER CHANGE.** `'adds two numbers'` already lexes as `TokenKind.charLiteral` (`Lexer.maxon:215`),
// which is the same token every block label is.
let TestKeywordName = b"test"

// ⭐ **THE ERROR TYPE EVERY `test` IMPLICITLY THROWS** (`stdlib/Testing.maxon`'s `public enum TestFailure`).
// A String because that is what a `ThrowsClause` carries; it is the corpus's own spelling read back, and
// the one place this compiler names it, so a rename in the library is a compile error here rather than a
// clause silently naming nothing.
let TestImpliedThrowsTypeName = "TestFailure"

// The case a failing test raises — `stdlib/Testing.maxon`'s `public enum TestFailure  assertion`. Its TAG
// is read off that declaration rather than assumed (`EnumLayout.tagOfCase`); this is only the name.
let TestFailureAssertionCaseName = b"assertion"

// ⭐ **THE ONE CALL THE COMPILER WRITES INTO A TEST BINARY** — `stdlib/Testing.maxon`'s
// `__TestReport.threw`, whose own doc comment says so from the other side (*"The compiler emits this call;
// no program writes it"*). The registration name of a `static` member is its qualified spelling, and this
// one is uncontested, so the bytes here are the bytes the declaration registered under.
//
// ⚠ It is spelled ONCE, here, because a callee name that disagrees with a declaration is not a compile
// error — it is a backend `call to unknown function` with no source position at all.
let TestReportThrewCallee = b"__TestReport.threw"

// The one annotation the language has, and its spelling — matched as an IDENTIFIER after the `@`, never as a
// keyword, so `heap` stays a perfectly good name for a variable or a function. See `parseAnnotatedBinding`.
let HeapAnnotationName = b"heap"

function methodAsFunctionValueAt(explanation String, memberTok Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.methodAsFunctionValue, explanation: explanation, line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
end 'methodAsFunctionValueAt'

function castOfACast(asTok Token, targetName String) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.castOperandIsACast, explanation: "a cast cannot take another cast as its operand — cast directly to '{targetName}'", line: asTok.line, column: asTok.column, note: DiagnosticNote.none)
end 'castOfACast'

function methodAsFunctionValue(spelled String, memberTok Token) returns SourceParseError
	return methodAsFunctionValueAt("'{spelled}' is a method, and a method is not a function value: wrap the call in a closure, such as 'function(...) gives {spelled}(...)'", memberTok: memberTok)
end 'methodAsFunctionValue'

function methodAssigned(spelled String, memberTok Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: "'{spelled}' is a method, and a method cannot be assigned", line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
end 'methodAssigned'

union MethodKind
	callable
	ofAValue
	requirementOf(interfaceName ByteArray)
end 'MethodKind'

function methodReadRefusal(kind MethodKind, written String, memberTok Token) returns SourceParseError
	return match kind 'kind'
		callable gives methodAsFunctionValue(written, memberTok: memberTok)
		ofAValue gives methodAsFunctionValueAt("'{written}' is an instance method, and a method is not a function value: call it on a value, or wrap that call in a closure, such as 'function(value) gives value.{String.from(memberTok.value)}(...)'", memberTok: memberTok)
		requirementOf(interfaceName) gives methodAsFunctionValueAt("'{written}' is a requirement of '{String.from(interfaceName)}', and a requirement is not a function value: it is reached on a concrete type that implements '{String.from(interfaceName)}'", memberTok: memberTok)
	end 'kind'
end 'methodReadRefusal'

function missingStaticMember(explanation String, anchor Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.unknownStaticMember, explanation: explanation, line: anchor.line, column: anchor.column, note: DiagnosticNote.none)
end 'missingStaticMember'

function undeclaredStaticMember(typeTok Token, memberTok Token) returns SourceParseError
	return missingStaticMember("type '{String.from(typeTok.value)}' has no static member named '{String.from(memberTok.value)}'", anchor: memberTok)
end 'undeclaredStaticMember'

function primitiveMemberRefusal(typeTok Token, memberTok Token) returns SourceParseError
	return noSuchOwnedStatic(typeTok, memberTok: memberTok, surfaceClause: "a primitive type's statics are the free functions `stdlib/Builtins.maxon` declares, and it declares none of that name")
end 'primitiveMemberRefusal'

function memberOfABaseWithNoSuchMember(base String, noun String, memberTok Token) returns SourceParseError
	return missingStaticMember("'{base}' is {noun} and has no member '{String.from(memberTok.value)}'", anchor: memberTok)
end 'memberOfABaseWithNoSuchMember'

function memberThroughABaseThatNamesNoValue(base String, noun String, memberTok Token) returns SourceParseError
	return missingStaticMember("'{base}' is {noun}, so '{base}.{String.from(memberTok.value)}' names no value: a static member is read through a concrete type", anchor: memberTok)
end 'memberThroughABaseThatNamesNoValue'

function instanceRequirementThroughTypeParameter(written String, interfaceName ByteArray, typeTok Token, memberTok Token) returns SourceParseError
	return missingStaticMember("'{String.from(typeTok.value)}' is a type parameter and '{String.from(memberTok.value)}' is an instance requirement of '{String.from(interfaceName)}', so '{written}' names no static: call it on a value of type '{String.from(typeTok.value)}'", anchor: memberTok)
end 'instanceRequirementThroughTypeParameter'

union StaticRequirementReach
	valueOf(receiver String)
	typeParameter(name String)
end 'StaticRequirementReach'

function staticRequirementMessage(requirement String, reach StaticRequirementReach) returns String
	let reacher = match reach 'reach'
		valueOf(receiver) gives "a value of {receiver}"
		typeParameter(name) gives "the type parameter '{name}'"
	end 'reach'

	return "'{requirement}' is a `static` requirement, and a `static` member has no receiver to dispatch on — so {reacher} cannot reach it. Call a `static` member on a concrete type"
end 'staticRequirementMessage'

function staticRequirementCalled(written String, typeTok Token, memberTok Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.semanticStaticRequirementNotDispatchable, explanation: staticRequirementMessage(written, reach: StaticRequirementReach.typeParameter(String.from(typeTok.value))), line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
end 'staticRequirementCalled'

function instanceMethodCalledWithoutReceiver(typeName String, methodTok Token) returns SourceParseError
	let method = String.from(methodTok.value)

	return SourceParseError.registryRefused(ErrorCode.semanticInstanceMethodCalledWithoutReceiver, explanation: "'{method}' is an instance method of '{typeName}' and needs a receiver: call it on a value, such as 'value.{method}(...)', or make it `static`", line: methodTok.line, column: methodTok.column, note: DiagnosticNote.none)
end 'instanceMethodCalledWithoutReceiver'

let FixedArrayCreateLengthName = b"length"

function typeSizedCreateTakesALength(alias String, sized String, memberTok Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.fixedArrayCreateLengthForm, explanation: "'{alias}' states its length in its type ({sized}), so '{String.from(CreateMethod)}' takes no length: write '{alias}.{String.from(CreateMethod)}()' or '{alias}.{String.from(CreateMethod)}({String.from(ManagedMemoryValueParamName)}: v)'", line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
end 'typeSizedCreateTakesALength'

function runtimeSizedCreateNeedsALength(alias String, memberTok Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.fixedArrayCreateLengthForm, explanation: "'{alias}' states no length in its type, so '{String.from(CreateMethod)}' needs one: write '{alias}.{String.from(CreateMethod)}(n)'", line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
end 'runtimeSizedCreateNeedsALength'

function runtimeSizedCreateTakesALengthAndAValue(alias String, memberTok Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.fixedArrayCreateLengthForm, explanation: "'{alias}.{String.from(CreateMethod)}' takes a length and an optional '{String.from(ManagedMemoryValueParamName)}:': a fixed array never grows. Use 'Array.{String.from(CreateMethod)}(n, {String.from(ArrayCreateZeroedLabel)}: false)' for a growable buffer", line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
end 'runtimeSizedCreateTakesALengthAndAValue'

union CreateFill
	unfilled
	filled(word ValueId)
end 'CreateFill'

function bindingKeywordSpells(kind TokenKind) returns bool
	return kind == TokenKind.let or kind == TokenKind.var
end 'bindingKeywordSpells'

function bindingKindOfKeyword(keyword TokenKind) returns BindingKind
	if keyword == TokenKind.let 'aLet'
		return BindingKind.let
	end 'aLet'

	if keyword == TokenKind.var 'aVar'
		return BindingKind.var
	end 'aVar'

	panic("bindingKindOfKeyword: '{keyword.rawValue}' is not a binding keyword")
end 'bindingKindOfKeyword'

// ⭐ **THE CORPUS'S NAME FOR SLOT@40, READ BACK RATHER THAN INVENTED** (`stdlib/String.maxon:86`). It is
// what `emitFusedWrapperLiteral` finds the flag's VALUE by, so it is the corpus's spelling or the flag is
// silently classified instead of used. `type Character` declares no such field, which is not an error but
// the very thing this lookup distinguishes — see that function.
//
// ⚠ Exported for `Project.checkFusedWrapperRecordLayouts`, which is the SECOND reader and exists precisely
// because this lookup's failure mode is silent: a corpus rename would make `emitFusedWrapperLiteral` take
// the classifying producer for every literal, with no diagnostic anywhere. One spelling, two readers, and
// a panic between them.
let SingleByteGraphemesFieldName = b"singleByteGraphemesFlag"

// ⚠ **THE `String` VIEW MEMBERS AND `toByteArray` ARE THE CORPUS'S, NOT THIS FILE'S**: nothing in this
// compiler names `codepoints`, `utf16` or `toByteArray`, and `stdlib/String.maxon:156,503,507` is the only
// statement of what those members are called.

// The `Character` BUILTIN's type name is `CharacterConformerName` — the `String` twin
// (`StringConformerName`), recognized syntactically in a type position, and also the name a `for c in s`
// element binds under in a diagnostic. It has no `Character` builtin-name constant of its own, for the
// reason recorded over `String`'s: one fact, one constant.

// ⚠ **THE RUNTIME BODIES `__gr_gbp` / `__gr_ext_pict` STAY, AND NEITHER HAS A BARE-NAME PARSER DOOR.**
// The synthesized segmenter behind `String.count()` and grapheme iteration calls both from inside its own
// Std bodies, where `StringRuntime.closeGraphemeNeeds` declares the two bits; a user's
// `graphemeBreakProperty(cp)` reaches the corpus declaration in `stdlib/helpers/string/grapheme.maxon`
// instead. Two implementations of one table, which
// `stdlib-loading.the-corpus-segmenter-agrees-with-the-synthesized-one` is the differential over.
//
// ⛔ A bare-name builtin for either would make a user's own `function graphemeBreakProperty` compile and be
// silently unreachable — it would print `p=0 e=false` where the source's own function answers
// `p=164 e=true`, both compiled and neither run.

// ⭐⭐ **THE CORPUS SEGMENTER ENTRY POINT `for c in s` NAMES.** It is an ordinary declaration in
// `stdlib/helpers/string/grapheme.maxon`, reached by an ordinary Maxon-tier call — the SAME call a user's
// own `findGraphemeEnd(s, pos: i)` emits — so reachability, ownership and dead-function elimination are the
// ordinary rules and this door needs no mechanism of its own. The differential named above measures it: the
// two sides of it are one body.
//
// ⚠ **THE SPELLING IS THE CORPUS'S AND MUST STAY THAT WAY.** A call whose callee names no declaration is an
// ordinary `E3004`, so a renamed corpus function fails loudly here rather than silently routing nowhere.
//
// ⚠ The edge is an ordinary one: `parseForStatement` emits this call from USER code, so the reachability
// walk finds it the way it finds any other Maxon-tier call.
let CorpusFindGraphemeEnd = b"findGraphemeEnd"

// ⭐⭐ **`addressableBytes()` — THE ONE CORPUS MEMBER THE STREAM-WRITE FOLD MATCHES BY NAME.**
// `stdlib/Print.maxon:10` is `__Builtins.writeStdout(value.addressableBytes())`, and that member is
// `stdlib/String.maxon:181`'s — so the byte-view record the write does not need is produced by a CORPUS
// CALL rather than by a synthesized arm, and the fold that removes it has to recognize the call.
//
// ⚠ **NAMING A CORPUS FUNCTION IS WHAT THE FOUR CONSTANTS ABOVE ALREADY DO, and this one FAILS SOFTER than
// any of them.** A rename breaks those loudly (`E3004`, a call to a declaration that is not there); this one
// is only ever ASKED as *"is the op I am about to rewrite this call?"*, so a rename makes the fold decline
// and a `print` costs one allocation again. Slower, never wrong — which is the only direction a
// peephole's name-match may fail in.
//
// ⚠ It is the MEMBER's spelling, not the mangled `String.addressableBytes`: the qualified form is joined
// where it is compared (`qualifiedMethodName`), so the type half is `StringConformerName`'s one spelling and
// this constant stays the member's.
let CorpusAddressableBytes = b"addressableBytes"

type Parser
	let tokens as TokenArray
	let qualifiers as TypeQualifierPositions
	var pos as ElementIndex

	// The sole output. Every emit/registry write lands here, never on `Project`.
	var artifact as FileParseArtifact

	var genericParameterNames = NameRoster.create(0)

	var bodyState as FunctionBodyState

	var statement as StatementSlots
	var heldAwaits as HeldAwaitArray
	let respelledStarts as RespelledTokenStartSet
	var parenGroups as ParenGroups
	var settledTypeNames as SettledTypeNameMap
	var refusedHiddenSites as PositionKeySet

	// Keyed by name or instance alone: sound because a `Parser` parses one file, and `ProgramSignatures`
	// is not written while it does.
	var memos as ParseMemos

	// ⭐ **THE FILE'S BLOCK-EXTENT INDEX: per token, the `end` that closes the block opened there.** Filled
	// in ONE bracket-matching pass by `buildBlockExtentIndex` on the first construct that asks, and read by
	// `matchingEndOf` so `blockStatementEndIndex` can step OVER a nested construct instead of through it.
	//
	// FILE-scoped, not per function, and correct because it is keyed by an ABSOLUTE token index: a construct
	// only ever asks about a token inside its own extent, so an entry belonging to another function can never
	// be reached. That is also why `reset` (per function) leaves it alone — the tokens it indexes do not
	// change for the parser's whole life, and a Parser is built per file and never re-aimed at a second token
	// stream.
	//
	// It points at the shared empty until the first query, and that `is`-identity is what says "not built
	// yet": a file that opens no block at all still gets a FRESH column, so an empty index and an absent one
	// are never confused.
	var blockExtentEnds as TokenIndexArray

	var fileNonCallNames as NonCallNameIndex
	var bodyNonCallNames as NonCallNameIndex
	var fileVarNames = BareNameSet.create()
	var fileVarNamesCollected = false

	// ⭐ **THE FILE'S KEYWORD TOKENS THAT ARE DECLARED NAMES, ASCENDING** — a function's own name and each of
	// its parameters' names, kept only where the source spelled a KEYWORD there. It exists for exactly
	// one reader, `namesADeclaration`: a keyword written in one of those positions is a NAME, so the
	// block-extent scans must not read `function while(…)` as a block that never closes nor
	// `function f(end Integer)` as a close that never opened.
	//
	// It is an INDEX and not an O(1) lookbehind because no bounded lookaround can answer the parameter case:
	// `(` `match` `x` is a parenthesized match EXPRESSION inside a call, and `(` `match` `X` is a parameter
	// named `match`, and the two are the same token shape — only the enclosing list's OWNER tells them apart.
	// It is filled by the block-extent walk itself (`recordDeclaredNamesAt`), which is what lets a declared
	// name be decided from the same left context every other verdict in that pass is decided from.
	//
	// ⚡ **SPARSE, NOT A PER-TOKEN COLUMN, and that is a MEASURED choice.** A keyword-named declaration is
	// rare — `stdlib/FilePath.maxon` is the ONLY `stdlib/` file with one — so this list is EMPTY for very
	// nearly every file, and `namesADeclaration` answers off its `count()`. The dense `BoolArray` of
	// tokenCount this started as cost **+5,487 allocations and +268 KB at rung 0 of the scale ladder, doubling
	// per rung** (a same-path A/B against the parent commit); sparse, the same A/B reads a per-file empty
	// array. `blockExtentEnds` next door is dense because its answer is DENSE — a block opens at a great many
	// tokens — and this one's is not.
	//
	// FILE-scoped and keyed by an ABSOLUTE token index, `blockExtentEnds`'s discipline for its reason, and
	// that column's `is`-identity is the "have I run?" gate for this one too.
	var declaredNameKeywords as TokenIndexArray

	// ⭐⭐ **THE FILE'S BLOCK-STRUCTURE KEYWORD TOKENS THAT ARE NAMES, ASCENDING** — the memo
	// `keywordIsAName` answers from, decided ONCE by `buildBlockExtentIndex`'s walk and read by every scan
	// after it.
	//
	// ⚠ **IT IS A MEMO BECAUSE THE ANSWER NEEDS THE WALK'S OWN LEFT CONTEXT, WHICH NO CALLER HAS.** The
	// match-arm shapes (`end gives 0`, `while(a, b) then …`) are rules about a token at the top level of a
	// `match` BODY, and the case-list shape is a rule about one at the top level of an `enum`/`union` body;
	// that is what the walk's opener stack knows and a bounded lookaround does not — see `keywordIsANameAt`.
	// Recording the verdict per token is what lets the eight scans that count block depth
	// (`blockStatementEndIndex`, `methodBodyEndFrom`, `skipUnreachedFunctionBody`, …) share ONE answer
	// instead of each re-deriving it from a context it cannot see.
	//
	// ⚡ **SPARSE, NOT A PER-TOKEN COLUMN**, for the reason `declaredNameKeywords` above records with a
	// measurement: a keyword standing where its own construct could stand is rare, so this list is EMPTY for
	// very nearly every file and `keywordIsAName` answers off its `count()`. Only the kinds
	// `kindAsksKeywordIsAName` admits are ever offered to it, because those are the only ones any caller
	// asks about — an entry for anything else would be one nothing can match.
	//
	// FILE-scoped and keyed by an ABSOLUTE token index, `blockExtentEnds`'s discipline for its reason.
	var blockKeywordNames as TokenIndexArray
	var adoptedExtents as BlockExtents
	var blockExtentsBuilt as bool

	// Built from `tokens` on the first `assignedBindingsIn`. It stays valid because `tokens` is a
	// `let` that nothing writes into after the parser is created.
	var writeSites as WriteSites

	let job as ParseJob

	var constEvalStack = TopLevelDeclIndexArray.create(0)

	// ⭐⭐ **THE `match` CONSTRUCTS CURRENTLY BEING PARSED, INNERMOST LAST — two scalar columns, pushed in
	// lockstep.** An arm's coverage point needs TWO positions: its OWN, so the line listing counts the arm's
	// line, and its CONSTRUCT's, so N arms group into one branch. The sites where an arm body becomes current
	// are spread across the statement `match`, the union `match`, the match EXPRESSION and the
	// `default throws`/`default panic` helpers; a stack carries the construct's position to all of them
	// without a parameter on each, and nests correctly for a `match` inside a `match` arm.
	//
	// Pushed only while `coverageActive`, so an ordinary build never grows either column.
	var covMatchLines as LineNumberArray
	var covMatchCols as ColumnNumberArray

	// ⭐ Parameter AND field defaults captured by this FILE's declarations, awaiting their helpers' parse.
	// It is per-FILE and not per-function — deliberately: the helpers are
	// drained once, at end-of-file, when no declaration is open (see `captureParamDefault`), so it is one of
	// the few parser lists that must NOT be re-created per function.
	var pendingDefaultHelpers as PendingDefaultHelperArray

	// Every function declared ANYWHERE IN THE PROGRAM, with its return type — the whole-program
	// signature index (SignatureIndex.maxon), built from every file's TOKENS before any file is
	// parsed and handed to every Parser.
	//
	// A call's result type has to be exact HERE, and it cannot wait: `f() and g()` short-circuits
	// iff `f`'s return type is statically `bool` — a CONTROL-FLOW decision no later pass can
	// retrofit — and `not` picks its opcode from its operand's type. A file-local scan made that
	// exact within one file (so declaration ORDER stops deciding what a program means), and left it
	// WRONG across files: a callee the file could not see was typed `unresolved`, which agrees with
	// everything, so `let x = isReady()` + `x + 41` compiled and returned 42. The index is the same
	// sweep, over every file.
	var signatures as ProgramSignatures
	var kindWritability as RecordKindWritability

	// ⭐ THE TYPE whose body is being read — EMPTY at file scope. It is the parser's whole knowledge
	// of "am I inside a `type`?", and three things read it:
	//
	//   • `declaredMethodName` — a `function create` inside `type Point` is declared `Point.create`;
	//   • `parseTypeReference` — `Self` (and `Point`) in a type position inside `type Point` is a
	//     `structRef` to it;
	//   • `requireConstructible` — `Self{…}` is legal HERE and nowhere else (E3076).
	//
	// ⭐ **THE TOKEN SWEEP SETS IT TOO, AND THAT IS WHAT KEEPS THE TWO PASSES HONEST.** The first two
	// readers above run in BOTH the tolerant declaration sweep (`recordScannedType`) and the real
	// parse (`parseTypeDeclaration`), and they must not disagree: had the sweep recorded a factory as
	// `create` while the parse declared it `Point.create`, every call would be E3004 against a name
	// nothing declared. The mapping is purely SYNTACTIC — it needs the enclosing declaration and no
	// registry — which is exactly why both passes can make it, and why `Self` need not wait for the
	// index to be complete (mid-sweep, it is not).
	//
	// Empty is not a sentinel: a type's name cannot be empty, and "no enclosing type" is the literal
	// truth at file scope. It is NOT reset per function — a method's parse runs INSIDE the type body
	// that set it (`enterTypeScope` is the one writer, and `closeTypeParamScope` clears it at the
	// declaration's `end`).
	var enclosingType as EnclosingTypeScope

	// ⭐ **IS THE ENCLOSING DECLARATION AN `enum`/`union` RATHER THAN A `type`?** — the KIND half of
	// the fact `enclosingType` names, written and cleared by the very same two doors, because a receiver's
	// TYPE cannot be derived from the name alone.
	//
	// A struct's `Self` is a `structRef` and an enum's is a `named` — an enum value IS its i64 tag (or a
	// pointer to its box), which is why `TypeResolution` erases a declared enum to `integer` while it keeps
	// a struct's nominal id. `enclosingSelfType` is the one reader that has to choose, and it cannot ask
	// `signatures.containsEnum`: this field's whole point is that it answers DURING THE TOLERANT SWEEP,
	// where the enum being declared has not been folded into the index yet — the identical argument that
	// makes `Self` syntactic (see `parseTypeReference`).
	var enclosingTypeIsEnum as bool

	// The field types `declareSelfFieldAliases` resolved, and the one layout (`selfFieldTypesLayout`, at most one entry)
	// they are the fields of. Every instance method of a type installs the same aliases, and resolving one field's type
	// probes several registries — resolved per method, a type's parse would cost its field count times its method count.
	var selfFieldTypes as MaxonTypeArray
	var selfFieldTypesLayout as StructLayoutArray

	// The GENERIC TYPE PARAMETERS of the type currently being declared — `[T]` while parsing
	// `type Box uses T`, empty otherwise. It is how `parseTypeReference` recognizes a bare `T` as a
	// type parameter (by NAME, so the sweep and the real parse agree without a registry).
	//
	// ⛔⛔ **IT IS READ AS A PAIR WITH `enclosingType`, AND EVERY WRITER OWES BOTH.** The mint is
	// `typeParameter(typeParamTokenFor(self.enclosingType, paramName: name))` — a digest of the DECLARING
	// TYPE's name and the parameter's — and `ProgramSignatures.recordStruct` /
	// `recordInterfaceDeclaration` file an owner for exactly the pairs a DECLARATION makes. A writer that
	// publishes names here under an `enclosingType` that did not declare them therefore mints a token no
	// fold owns, which is a silently-accepted undeclared type name and, one call deeper, a panic at
	// `ProgramSignatures.opaqueTypeParamPosition`. The writers, all five:
	//   • `enterTypeScope` / `closeTypeParamScope` — the shared empty, in lockstep with `enclosingType`;
	//   • `openTypeParamScope(layout)` — a `type`'s own `uses`, under the name `enterTypeScope` just set;
	//   • `readInterfaceDeclaration` — an `interface`'s associated types, likewise;
	//   • `openTypeExtensionBodyScope` — a TYPE extension's target list, under `enterTypeScope(conformer)`
	//     where a `typeExtension`'s sole conformer IS that target (`extensionTargetOf`);
	//   • `readExtensionHeader` — the ONE writer with no `enclosingType` of its own, which is why its
	//     window is opened and closed around the `where` clause read alone. See there.
	var enclosingTypeParams as immutable NameRoster

	// The `where T is <Interface> …` CONSTRAINTS of the type currently being declared —
	// in source order (the witness-slot order), empty otherwise. It is how the body parse recognizes
	// `self.item.digest()` as a witness DISPATCH (the receiver's type parameter has a constraint whose
	// interface declares `digest`) and how `parseFunction` decides an instance method needs witness
	// parameters. Written and cleared in lockstep with `enclosingTypeParams` (`parseTypeDeclaration`/
	// `recordScannedType` are the writers).
	var enclosingWhereConstraints as WhereConstraintArray

	// ⭐⭐ **THE EXTRA CLAUSE OF THE CONDITIONAL TYPE EXTENSION whose body is being parsed** — the
	// half of `enclosingWhereConstraints` that came from the `extension … where …` header rather than from
	// the target type's own declaration, empty everywhere else. Written and cleared in lockstep with
	// `enclosingWhereConstraints`, whose value is exactly
	// `typeExtensionWitnessConstraints(<enclosing type>, extensionConstraints: this)`.
	//
	// It exists so that `parseFunction` can record the clause under the REGISTRATION NAME it has just minted:
	// the fold files a conditional extension's clause under the DECLARED `<Conformer>.<method>` name, which a
	// member of a contested type does not wear. See `FuncSignature.extensionConstraints` for the two
	// measured ABI mismatches that bare key caused.
	var enclosingExtensionConstraints as WhereConstraintArray

	// ⭐ **WHERE THE DECLARING FUNCTION'S HIDDEN WITNESS PARAMETERS START, AND HOW MANY.** `parseFunction`
	// reserves them — one per `where` constraint of the enclosing type, trailing after the layout slot — and
	// a witness dispatch in the body has to name the one its constraint uses. The parser is what reserved
	// them, so the parser is what resolves them (`witnessParamValueId`). Both are 0 in a function that
	// reserves none (every free function, every static, every default helper).
	//
	// ⭐⭐ **"DECLARING", NOT "CURRENT" — A LIFTED CLOSURE DOES NOT DISPLACE THEM, AND THAT IS THE ONE PLACE
	// THIS PAIR DEPARTS FROM EVERY SIBLING PER-FUNCTION COLUMN.** Resetting the pair to 0 for a closure body
	// is true of that body's ABI and useless to the body itself: `function(x Element) gives x.compare(y)`
	// written inside `extension Array where Element is Comparable` has to reach the enclosing extension's
	// table, and a zeroed pair leaves `witnessParamValueId` with nothing to name and a PANIC as the whole
	// answer (`stdlib/Array.maxon`'s `sort()` is the program). A closure body does not change WHICH FUNCTION
	// DECLARED the witnesses,
	// so the pair keeps describing that function and `witnessValueForConstraint` — the one door — decides
	// whether the body may name the parameter directly (it is that function's own body) or must inherit the
	// table through its environment (it is a lifted closure's).
	//
	// ⇒ **They are deliberately absent from `parseClosureExpression`'s save/reset/restore triple.** Nothing
	// inside a closure body writes them (only `parseFunction` and `parseDefaultHelperBody` do, and neither is
	// reachable from an expression), so there is nothing to save and a reset is the defect. See the note at
	// that reset block.
	var declaringWitnessParamBase as ValueId
	var declaringWitnessParamCount as ParamCount

	// ⭐ The transitive witness SLOT LIST of each interface this file dispatches through — see
	// `WitnessSlotTable` for the quadratic that put it here.
	var witnessSlotsByInterface as WitnessSlotTable

	// ⭐ The BARE MEMBER NAMES of the INNER ranged typealiases declared in the type currently being parsed —
	// `{Idx}` inside `type Wrapper` with `typealias Idx = int(0 to u64.max)`, empty otherwise. It
	// is how `parseTypeReference` resolves a bare `Idx` in a field/return/parameter position to the
	// base-qualified `named("Wrapper.Idx")` — recognized by NAME against this set, so the SWEEP and the real
	// parse agree WITHOUT the whole-program `innerAliases` (which the sweep has not folded yet while it is
	// still walking this very type). Written by the `typealias` member arm and cleared in lockstep with
	// `enclosingType` (`parseTypeDeclaration`/`recordScannedType` are the writers).
	var enclosingInnerAliases as InnerAliasRoster

	// Every nested typealias member the enclosing body has declared so far, function form included, which
	// `enclosingInnerAliases` leaves out. Read only by the real parse's redeclaration check.
	var declaredNestedAliases as InnerAliasRoster

	var scannedPerInstanceAliases as ScannedAliasNames

	var scannedFunctionAliases as ScannedAliasNames

	var bodyAliasesScanned as bool

	// ⭐⭐ **THE GENERIC-INSTANCE TYPEALIASES OF THE `interface` CURRENTLY BEING READ** —
	// `typealias ElementArray = Array with Element` inside `interface Holder uses Element`. It is the RHS,
	// and only the RHS, that says what a requirement written `absorb(value ElementArray)` actually requires;
	// without it the conformance check compares an unresolved name against the conformer's resolved instance
	// and refuses every conformer (see `ProgramSignatures.interfaceAliases`).
	//
	// ⚠ **IT IS DRAINED BY THE FOLD AND IGNORED BY THE REAL PARSE.** `foldInterfaceDeclarationInto` is the
	// one caller that hands it to the index — the same split every other whole-program registry keeps, and
	// the reason the real parse may stay a pure function of its own file. `readInterfaceDeclaration` resets it
	// per declaration, so a real parse simply fills it and lets the next declaration drop it.
	var interfaceAliasScratch as GenericAliasEntryArray

	let readGenericWithSites as GenericWithSiteArray

	var collectsWithSites as bool

	// ⭐ **ARE THE ENCLOSING TYPE'S NESTED TYPEALIASES IN SCOPE THROUGH THE WHOLE-PROGRAM INDEX RATHER THAN
	// THROUGH THE SET ABOVE?** True in exactly one place — inside a captured DEFAULT expression being
	// drained (`restoreDeclaringTypeScope`), where the body walk that built that set finished long ago and
	// the registries it folded into are complete. The FIFTH per-declaration scope, reset with the other four
	// by `enterTypeScope`/`closeTypeParamScope` so it cannot outlive the one declaration that sets it.
	var innerAliasesFromIndex as bool

	// ⭐ Where each SIZED CONTAINER declared in THIS file begins its member list — the sites
	// `Queries.foldFixedElementCountNeeds` re-walks once the whole-program index is complete. A field rather
	// than an out-parameter for one reason: a callee cannot swap a caller's local for a real array, and the
	// point is that a file declaring no sized container never allocates one. Points at
	// empty until `recordScannedType` meets the first sized container in the file.
	var descriptorScanSites as DescriptorScanSiteArray

	// ⭐ **THE ENCLOSING TYPE'S MEMBER METHODS, bare name -> takesReceiver** — the map that resolves a
	// bare call `foo(…)` inside a method body to the sibling method `foo`, prepending `self` for an
	// instance method and nothing for a `static` one. Built LAZILY (`ensureSiblingReceivers`) the
	// first time a call inside a type body needs it and memoized on `siblingReceiverScanType` and
	// `siblingReceiverScanBody`, so a type whose methods make no calls — all of the scale corpus —
	// allocates NOTHING. It is the
	// method set (static and instance) of the DECLARATION being parsed, so `contains` answers "is this
	// a sibling?" and the value answers "does it take a receiver?" from one source for the members it
	// carries; a method another declaration of the
	// same type declares is reached through the index (`isImplicitSelfMethod`).
	var siblingReceivers as SiblingReceiverTable

	// The type `siblingReceivers` was built for — the memo key. Empty until the first lazy build, and compared
	// against `enclosingType` so a sibling type reuses nothing stale.
	//
	// ⚠⚠ **THE NAME ALONE STOPPED BEING A KEY WHEN AN INTERFACE EXTENSION COULD ENTER A TYPE'S SCOPE FROM
	// OUTSIDE ITS BODY**, which is why `siblingReceiverScanBody` rides beside it. `extension Pointlike` enters
	// the scope of `Coord` and walks the EXTENSION's member list; `type Coord` further down the same file
	// enters the same name and must walk its OWN. Keyed by name alone the second walk is a memo hit on the
	// first, and a bare sibling call inside `type Coord` would resolve against the extension's method list.
	var siblingReceiverScanType as EnclosingTypeScope

	// The body `siblingReceivers` was built from — the other half of the memo key. A declaration body is
	// uniquely identified within a file by where it STARTS, which is the fact the name cannot supply.
	var siblingReceiverScanBody as ElementIndex

	// The token index at which the enclosing type's body begins (past the header and any `uses` clause) — set by
	// `parseTypeDeclaration`, and where the lazy `ensureSiblingReceivers` walk starts. The cursor has
	// long since moved on by the time a method body's call needs it, so the start must be remembered
	// rather than re-derived.
	var enclosingTypeBodyStart as ElementIndex

	var enclosingBodyIsWalkable as bool

	// ⭐ **THE INTERFACE WHOSE EXTENSION BODY IS BEING PARSED** — empty everywhere else. An extension body may
	// call the interface's own REQUIREMENTS as bare sibling calls (`return inc(tag())`), and those methods are
	// declared on the CONFORMER, in another declaration and possibly another file, so no token walk of this
	// body can find them. `ensureSiblingReceivers` reads this to add them. It is the interface's requirements
	// and NOT the conformer's whole method set, deliberately: an extension body may rely on exactly what the
	// interface guarantees, and nothing a particular conformer happens to also declare.
	var extensionInterfaceName as InterfaceName

	// ⭐ **THE ASSOCIATED-TYPE SUBSTITUTION AN INTERFACE-EXTENSION BODY IS PARSED UNDER (conditional
	// extensions)** — the extended interface's `uses` names, and what the CONFORMER this pass is monomorphizing
	// for binds each of them to. Parallel, positional, and empty everywhere else. `parseTypeReference` reads
	// them to resolve a written `Element` as the conformer's binding; see the ⚠ there for why they are
	// deliberately NOT `enclosingTypeParams`. Written by `openExtensionBodyScope`, cleared in lockstep with the other
	// per-declaration scopes (`enterTypeScope`/`closeTypeParamScope`).
	var extensionAssociated as ExtensionAssociatedScope

	var genericBindings = GenericBindingScope.empty()
	var genericInstanceName = GenericInstanceBody.none
	var pendingBareAliases = ConformerBareAliasArray.create(0)

	var sweptImplementsClauses as AliasImplementsClauseArray
	var refusedInstances as RefusedInstanceMap

	// The SHARED empty type-parameter-POSITION array the consume scan passes for every
	// receiver-less function OUTSIDE a generic type — which is all of them on the generics-free corpus. It is
	// never mutated (`paramNamesIn` skips the position work when `collectTypeParamFlags` is false, and
	// `TypeParamSlots` reads a missing index as a concrete slot), so one allocation per parser
	// serves every non-generic function's consume scan, keeping that hot path allocation-free.
	var emptyTypeParamPositions as TypeParamSlots

	// ⚡ The shared, NEVER-WRITTEN sink the two walks that want NAMES but no types hand `paramNamesIn`, so a
	// declaration whose types nobody reads allocates no array for them. `collectTypes: false` is what keeps it
	// unwritten; it is `emptyTypeParamPositions`' twin, one fact over.
	var emptySweptParamTypes as MaxonTypeArray
	var emptyParamSpellings as NameRoster

	// The SHARED empty type-parameter-name list that `enclosingTypeParams` holds outside a
	// generic type — which is every type on the generics-free corpus. `openTypeParamScope` points at it
	// (rather than allocating an empty `uses` list) for a type with no `uses`, and `closeTypeParamScope`
	// restores it, so a non-generic type declaration allocates nothing here. Never mutated.
	var emptyTypeParams as immutable NameRoster

	// The shared empties this parser's columns start from and its copy-on-write tests compare against.
	var anchors as ParserAnchors

	// ⭐ **THE PERMANENTLY EMPTY TEMPORARY LIST every NON-catching `if` is answered with, allocated ONCE per
	// file instead of once per `if`.** `takeCatchingForkTemps` has to hand its caller a list on both of its
	// paths, and only the catching path has anything to put in one — a fresh `ValueIdArray` on the other
	// path is a heap record per `if` statement in the program, MEASURED at +3,424 allocations / +136,960
	// bytes of `phase:parse` over a 3,000-`if` corpus, on a construct whose own parse is the parser's
	// hottest. ⚠ **IT IS SHARED, SO IT IS READ-ONLY, AND ITS ONE READER MUST STAY ONE**: `emitTempDropsInto`
	// returns at `count() == 0` without touching it. Anything that would PUSH to a fork-temp list has to be
	// handed a list of its own — `takeCatchingForkTemps`' catching arm mints one.
	var noForkTemps as ValueIdArray

	// ⭐ **EVERY `test` THIS FILE HAS ALREADY MINTED A SYMBOL FOR (E3107).** The collision is between two
	// PROSE names that sanitize alike, so the record has to carry both spellings — the symbol to compare and
	// the prose to name in the message, which is invisible in the symbol alone. Per FILE because that is what
	// the rule is about, and a `Parser` is per file.
	var mintedTests as MintedTestArray

	// The payload names a case pattern over a deferred scrutinee wrote, held from the pattern's parse
	// until the arm has opened its own scope frame (`takeDeferredPatternBindings`), so they cannot
	// leak into the next arm.
	var deferredPatternBindings as TokenArray

	// ⭐ **THE PARAMETER AND RETURN TYPES OF EVERY NON-CAPTURING CLOSURE LIFTED IN THIS FILE,
	// keyed by its synthetic name.** A lifted closure's signature is FILE-LOCAL: it never
	// reaches the whole-program `SignatureIndex` (built from tokens before any body is parsed, and a
	// closure is an EXPRESSION inside a body, not a top-level declaration the token sweep can see). So
	// an indirect call through a closure bound to a local (`let f = function(x) gives x*2; f(8)`)
	// cannot recover its shape the way `functionValueShape` recovers a top-level function's — from the
	// index. This map is that recovery: `parseClosureExpression` files each lift's shape under its
	// `$`-suffixed name (unwritable in source, so it can never collide with a real function or alias),
	// and `functionValueShape` consults it first. File-scoped, never reset: names are unique per file
	// and a closure value is only ever CALLED within its own defining function (returning one out hands
	// the caller a function-ALIAS-typed value, whose return comes from the alias, not from here).
	var closureShapes as FunctionValueShapeMap
	var frozenResultClosures as NameRoster
	var imageNotes as ImageNoteMap

	// ⭐ **THE ENCLOSING-FUNCTION SCOPES A CLOSURE BODY MUST NOT REACH INTO — the capture
	// detector's input.** Empty outside a closure. `parseClosureExpression` pushes the enclosing `Scope` on
	// entry and pops it on exit, so while a closure body parses this holds the chain of scopes whose
	// bindings would be CAPTURES. `parseVariableReference` checks it before falling through to the top-level
	// registries: a name resolving to one of these scopes (an enclosing local, parameter, or self-field
	// alias) is a capture. A STACK, not a single scope, so a
	// closure nested inside a closure detects a capture of any enclosing frame, not just its immediate
	// parent — which is what stops an outer local silently resolving to a same-named global.
	var closureEnclosingFrames as ClosureEnclosingFrameArray
	var openByRefHandOffs as OpenByRefHandOffArray

	// ⭐ **THE PRE-TERNARY MOVE BASE FOR A CODE PATH WITH NO OWNED BINDINGS.** An inline
	// conditional `<t> if <c> else <f>` parses its TRUE arm before the `if` reveals the form, so the
	// pre-arm move state must be snapshotted at the top of EVERY full expression to rewind the FALSE
	// arm to it (`parseTernaryExpression`). When no owned binding is in scope a ternary arm cannot move
	// one, so the snapshot is this shared empty mark — read-only (`restoreMoveMark`/`reconcileMovesAtMerge`
	// no-op at height 0) and allocated ONCE, so the scale corpus (all scalar, no owned bindings) pays
	// nothing per expression.
	let emptyMoveMark as MoveMark

	// ⭐⭐ **THE FIRST MANAGED VALUE THIS RUNTIME FILE BUILDS, HELD UNTIL THE END OF ITS PARSE.**
	// `mintValue` and `retypeValue` are the only writers of the value type columns, so a
	// managed value arriving through ANY door — a `for` element, a closure cell, a caught error, a `match`
	// payload, an unnamed temporary — passes one of them; a list of binding sites can promise no such thing.
	//
	// ⚠ **IT IS RECORDED THERE AND REFUSED HERE BECAUSE NEITHER WRITER MAY THROW.** Both are called from
	// every expression emitter in the parser, most of which are not `throws`, so a throw at the mint would
	// put a `try` on the whole expression tier to serve a rule only `runtime/` can break. The record costs a
	// runtime file one predicate per value and every other file one bool test.
	//
	// `none` while the file is clean. The TYPE is rendered at the record rather than kept as a
	// `ValueId`, because the columns a display reads are the CURRENT function's and the refusal runs after
	// the last one closed.
	//
	// ⚠ **THE POSITION IS THE DEFINING OP'S SPAN AND IS RESOLVED AT THE REFUSAL, NOT AT THE RECORD.** A
	// value is minted BEFORE the op that defines it is emitted, so at the record the span does not exist
	// yet; by the end of the file it does, and `valueOrigins`/`opRanges` already hold it exactly. The token
	// index kept alongside is the cursor at the mint, which serves the values no op defines — a merge phi.
	var runtimeSourceOffence as RuntimeSourceOffence
	var misclosedBlock as MisclosedBlock
	export var openRegion as AbandonableRegion
	export var blockStructureMisread as bool
	var abandonedRegions as PositionKeySet
	var readsALaterConformer as bool
	var extensionReplayOwed as bool

	// The index of `artifact.genericInstanceRequests`, and like it never rewound: a request outlives
	// the region that made it, so the instance is still built.
	var requestedInstanceSiteKeys as RequestedInstanceSiteKeyMap

	// ⭐ **IS THIS THE WALK THAT REPORTS?** Set by `parseModule` and false everywhere else, because
	// `parseModule` is the only entry point whose diagnostics reach the user: the declaration sweep and the
	// interface/extension passes absorb a throw with `try … otherwise return`, so a rule stated in a walk they
	// share is a rule that silently DROPS a declaration instead of naming it.
	//
	// It also gates the use COLLECTION E3062 reads. The sweep runs the same `parseTypeReference` over every
	// signature, field and payload type in the program and would hash all of them into a set it then discards
	// — one allocation and N hashes per file, inside an O(files) loop, for an answer nobody reads.
	var isTheReportingWalk as bool

	// ⭐ **THIS FILE'S NON-EXPORTED TOP-LEVEL TYPEALIASES, in declaration order** — the E3062 check's
	// candidates. An EXPORTED alias never enters (E3062 never reports one), which is why the filter is at
	// the RECORDING site and not at the report: a candidate that could never be reported should not be
	// built.
	var declaredTypeAliases as DeferredNameDiagnosticRoster

	// ⭐ The MEMBER ROSTERS the builtin dispatchers gate on, each built on this file's first call into its surface
	// (`surfaceMemberNames`) because building one allocates and most files call into few surfaces.
	// `MemberSurface` says which dispatch reads which.
	var arraySurfaceRoster as NameRoster
	var bufferSurfaceRoster as NameRoster
	var stringSurfaceRoster as NameRoster
	var characterSurfaceRoster as NameRoster
	var stringIndexSurfaceRoster as NameRoster
	var cursorSurfaceRoster as NameRoster

	// ⭐ **THE `Array` DECLARATION NAMES, built lazily off the same anchor for the same reason** —
	// `ProgramSignatures.arrayDeclarationNames` mints an array, and it is asked only on
	// `refuseArrayMemberTheOtherDeclarationCarries`'s path. It is a roster in every sense the six above are:
	// a small whole-program list a file reads and never writes.
	var arrayDeclarationRoster as NameRoster

	// ⭐⭐ **THE USER CONSTRUCT THIS FILE'S REFUSAL IS REALLY ABOUT (BLAME)** — see `LibraryBlame`, and
	// `blameLibraryRefusalOnInstantiation`, its one writer today. It is read by `Queries.queryParseOps` on
	// the parse-failure path, which is why it lives on the parser and not on the `FileParseArtifact`: a
	// blame exists only for a parse that THREW, and a throw abandons the artifact.
	//
	// The parser stays PURE. This is derived from `self.signatures` — the whole-program declaration index
	// the parse memo's key already covers — and never from `Project`, so the same file parsed twice records
	// the same blame.
	export var libraryBlame as LibraryBlame

	// ⭐⭐ **THE STDLIB/USER SHADOW RENAME IS APPLIED HERE, TO THE TOKENS, AND THAT PLACEMENT IS THE WHOLE
	// DESIGN.**
	//
	// A contested stdlib declaration is moved into the reserved space (`StdlibShadowRenameMap`), and the
	// hard half is not moving the DECLARATION — it is reaching every other spelling of the name. The compiler
	// identifies types by NAME all the way down: `structRef(name)`, `aggregateNameIn`, `__destruct_<name>`,
	// `__layout_<name>`, both enum registries, the interface registry, a `throws` clause, a qualified case
	// value, a `Type.method` callee, a struct-literal head. **A rename that reached the declaration and
	// missed one of those would be a silent wrong answer rather than a compile error** — so it is applied
	// ONCE, to the identifier tokens the file is parsed from, and every one of those spellings follows by
	// construction. There is no roster of doors to keep complete, and no door to forget.
	//
	// ⚠ **IT IS SOUND BECAUSE IT IS UNIFORM OVER STDLIB SOURCE.** Every stdlib and scriptlib file is
	// rewritten with the same table, so a name renamed at its declaration is renamed at every library
	// use of it — including a method's `Type.` head and a cross-module reference — and everything
	// library-internal is therefore unchanged. What DOES change is exactly the rule: user code, whose
	// tokens this rewrite never touches (`authorMintedTokens` rewrites an author file for the contests
	// among author names), cannot reach the library's declaration by the bare name, which means
	// the author's own declaration there — a synthesized protocol included
	// (`IrInterfaceMap.protocolKind`). The one shape that argument does not cover — a library MEMBER
	// spelled like a contested type name, which user code can name — is refused before this runs
	// (`Queries.refuseContestedNamesUsedAsMembers`, E3112).
	//
	// ⚠ **NOT IN `queryActiveTokens`, AND THAT IS NOT A PREFERENCE.** That query is memoized on the file's
	// CONTENT HASH alone and is what the declaration SWEEP reads — so a rewrite there would key a
	// whole-program fact under a per-file hash, and worse, would need the contest before the sweep that
	// decides it. Here there is no memo and no circularity: a `Parser` is built per pass, after the contest.
	//
	// A compile that contests nothing gets its own array back, so it allocates nothing and parses the very
	// tokens it would parse without the rename — which is what keeps its emitted code byte-identical.
	static function shadowRenamesTokens(signatures ProgramSignatures, isStdlibSource bool) returns bool
		return isStdlibSource and signatures.interfaceMap().hasLibraryRenames()
	end 'shadowRenamesTokens'

	static function shadowRenamedTokens(tokens TokenArray, signatures ProgramSignatures, recordsRespelledStarts bool) returns ShadowRenamedTokens
		let renamed = TokenArray.create(tokens.count(), zeroed: false)
		let respelled = RespelledTokenStartSet.create()

		for (iter, tok) in tokens.withIterator() 'eachToken'
			if tok.kind != TokenKind.identifier 'notAName'
				renamed.push(tok)
				continue
			end 'notAName'

			let name = signatures.interfaceMap().libraryNameOf(tok.value)

			// A name after a `.` stays as written: E3112 has refused every contested member spelling, and a
			// qualified type segment reaches the moved name through `ProgramSignatures.claimedNominalName`.
			if name.equals(tok.value) or followsADot(tokens, index: iter.index()) 'uncontestedOrAMemberName'
				renamed.push(tok)
				continue
			end 'uncontestedOrAMemberName'

			// The name is the token's own copy of the index's rename, which a parse's artifact goes on to hold.
			// The POSITION is carried over unchanged: a diagnostic raised on this token must still point at
			// the source the author can read, and the rename is a fact about the name space rather than
			// about the file's text.
			renamed.push(Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: name, startByte: tok.startByte, endByte: tok.endByte))

			if recordsRespelledStarts 'aFileWhoseMintsAreCheckedPerToken'
				respelled.insert(tok.startByte)
			end 'aFileWhoseMintsAreCheckedPerToken'
		end 'eachToken'

		return ShadowRenamedTokens.create(renamed, respelledStarts: respelled)
	end 'shadowRenamedTokens'

	static function mintsRenameTokens(signatures ProgramSignatures, job ParseJob) returns bool
		if job.isStdlibSource or job.isRuntimeSource 'aLibraryFile'
			return signatures.hasLibraryMints() or (job.isRuntimeSource and signatures.hasAuthorMints())
		end 'aLibraryFile'

		return signatures.hasAuthorMints()
	end 'mintsRenameTokens'

	static function authorMintedTokens(tokens TokenArray, job ParseJob, signatures ProgramSignatures, anchors ParserAnchors) returns TokenArray
		let positions = TokenIndexArray.create(0)
		let minted = NameRoster.create(0)
		let watched = DeclaredTypeNameSet.create()

		for (iter, tok) in tokens.withIterator() 'eachToken'
			if tok.kind != TokenKind.identifier or followsADot(tokens, index: iter.index()) 'notATypeSpelling'
				continue
			end 'notATypeSpelling'

			let nominal = signatures.authorMintOf(job.path, name: tok.value) if namesItsOwnNominalDeclaration(tokens, index: iter.index()) else signatures.authorNominalNameMeantBy(tok.value, readerFilePath: job.path)
			let name = nominal if not nominal.equals(tok.value) else signatures.bareBindingIdentity(tok.value, readerFilePath: job.path)

			if name.equals(tok.value) 'uncontestedHere'
				continue
			end 'uncontestedHere'

			positions.push(iter.index())
			minted.push(name)
			watched.insert(tok.value)
		end 'eachToken'

		if positions.isEmpty() 'nothingIsRespelled'
			return tokens
		end 'nothingIsRespelled'

		let reader = structuralReader(tokens, job: job, signatures: signatures, anchors: anchors)
		let walk = AuthorNameScopeWalk.over(tokens, extents: reader.takeBlockExtents(), watched: watched)
		walk.run()
		let renamed = tokens.clone()

		for (iter, at) in positions.withIterator() 'eachRespelling'
			if walk.isNonReference(at) 'notAReferenceToATopLevelName'
				continue
			end 'notAReferenceToATopLevelName'

			let tok = try tokens.get(at) otherwise panic("Parser.authorMintedTokens: tokens.get OOB at {at}, a position the walk over these tokens just recorded")
			let name = try minted.get(iter.index()) otherwise panic("Parser.authorMintedTokens: minted.get OOB at {iter.index()}, pushed beside the positions")
			try renamed.set(at, value: Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: name, startByte: tok.startByte, endByte: tok.endByte)) otherwise panic("Parser.authorMintedTokens: renamed.set OOB at {at}, a copy of the tokens it indexes")
		end 'eachRespelling'

		return renamed
	end 'authorMintedTokens'

	static function namesItsOwnNominalDeclaration(tokens TokenArray, index ElementIndex) returns bool
		if index == 0 'noKeywordBefore'
			return false
		end 'noKeywordBefore'

		let keyword = try tokens.get(index - 1) otherwise panic("Parser.namesItsOwnNominalDeclaration: tokens.get OOB at {index - 1}, below the {tokens.count()} tokens it indexes")

		if not declaresANominalTypeName(keyword.kind) 'notADeclarationKeyword'
			return false
		end 'notADeclarationKeyword'

		if index == 1 'theFirstDeclaration'
			return true
		end 'theFirstDeclaration'

		let before = try tokens.get(index - 2) otherwise panic("Parser.namesItsOwnNominalDeclaration: tokens.get OOB at {index - 2}, below the {tokens.count()} tokens it indexes")
		return before.line != keyword.line or before.kind == TokenKind.export or before.kind == TokenKind.public
	end 'namesItsOwnNominalDeclaration'

	// The last spanned token's end offset is the file's byte count. EOF and every synthetic token carry 0
	// for both offsets, so the walk is from the end rather than off `last()` — which would answer 0 for
	// every file and leave every table at its floor, silently.
	static function sourceByteCountOf(tokens TokenArray) returns SourceByteCount
		var position = tokens.count()

		while position > 0 'backFromTheEnd'
			position = position - 1
			let tok = try tokens.get(position) otherwise panic("Parser.sourceByteCountOf: tokens.get OOB at {position} below the {tokens.count()} just read")

			if tok.endByte != 0 'aSpannedToken'
				return tok.endByte as SourceByteCount
			end 'aSpannedToken'
		end 'backFromTheEnd'

		return 0
	end 'sourceByteCountOf'

	static function create(tokens TokenArray, job ParseJob, signatures ProgramSignatures, anchors ParserAnchors) returns Parser
		let spelled = spelledTokens(tokens, job: job, signatures: signatures, anchors: anchors)

		return createOverPreparedTokens(PreparedTokens.create(spelled.tokens, respelledStarts: spelled.respelledStarts), sourceBytes: sourceByteCountOf(tokens), job: job, signatures: signatures, anchors: anchors)
	end 'create'

	static function spelledTokens(tokens TokenArray, job ParseJob, signatures ProgramSignatures, anchors ParserAnchors) returns ShadowRenamedTokens
		var spelled = ShadowRenamedTokens.create(tokens, respelledStarts: RespelledTokenStartSet.create())

		if shadowRenamesTokens(signatures, isStdlibSource: job.isStdlibSource) 'aLibraryFileBesideContestedLibraryNames'
			spelled = shadowRenamedTokens(tokens, signatures: signatures, recordsRespelledStarts: job.isScriptlibSource)
		end 'aLibraryFileBesideContestedLibraryNames'

		if mintsRenameTokens(signatures, job: job) 'aFileBesideContestedDeclarations'
			spelled = ShadowRenamedTokens.create(authorMintedTokens(spelled.tokens, job: job, signatures: signatures, anchors: anchors), respelledStarts: spelled.respelledStarts)
		end 'aFileBesideContestedDeclarations'

		return spelled
	end 'spelledTokens'

	static function structuralReader(tokens TokenArray, job ParseJob, signatures ProgramSignatures, anchors ParserAnchors) returns Parser
		return createOverPreparedTokens(PreparedTokens.create(tokens, respelledStarts: RespelledTokenStartSet.create()), sourceBytes: sourceByteCountOf(tokens), job: job, signatures: signatures, anchors: anchors)
	end 'structuralReader'

	static function createOverPreparedTokens(prepared PreparedTokens, sourceBytes SourceByteCount, job ParseJob, signatures ProgramSignatures, anchors ParserAnchors) returns Parser
		return Self{
			tokens: prepared.tokens,
			qualifiers: prepared.qualifiers,
			respelledStarts: prepared.respelledStarts,
			parenGroups: ParenGroups.create(),
			settledTypeNames: SettledTypeNameMap.create(),
			refusedHiddenSites: PositionKeySet.create(),
			memos: ParseMemos.create(),
			fileNonCallNames: NonCallNameIndex.from(0),
			bodyNonCallNames: NonCallNameIndex.from(0),
			pos: 0,
			artifact: FileParseArtifact.create(job.path, livesUnderStdlibDirectory: job.livesUnderStdlibDirectory, sourceBytes: sourceBytes),
			libraryBlame: LibraryBlame.unblamed,
			bodyState: FunctionBodyState.fresh(anchors, firstValueId: 0, returnSpelling: EmptySourceText, returnBrand: EmptySourceText, closureEnv: ClosureEnvParam.none, returnAlias: anchors.undeclaredAlias, paramSites: RangeCheckParamSiteArray.create(0), layoutParam: HiddenWordParam.none, countParam: HiddenWordParam.none, nascentSelfFactory: false, kind: EnclosingBodyKind.declaredFunction),
			statement: StatementSlots.quiescent(),
			heldAwaits: HeldAwaitArray.create(0),
			blockExtentEnds: TokenIndexArray.create(0),
			adoptedExtents: anchors.noBlockExtents,
			blockExtentsBuilt: false,
			writeSites: noWriteSites,
			declaredNameKeywords: TokenIndexArray.create(0),
			blockKeywordNames: TokenIndexArray.create(0),
			job: job,
			covMatchLines: LineNumberArray.create(0),
			covMatchCols: ColumnNumberArray.create(0),
			pendingDefaultHelpers: anchors.pendingDefaultHelpers,
			signatures: signatures,
			kindWritability: RecordKindWritability.of(signatures),
			enclosingType: EnclosingTypeScope.fileScope,
			enclosingTypeIsEnum: false,
			enclosingTypeParams: freeze NameRoster.create(0),
			selfFieldTypes: MaxonTypeArray.create(0),
			selfFieldTypesLayout: StructLayoutArray.create(0),
			enclosingWhereConstraints: WhereConstraintArray.create(0),
			enclosingExtensionConstraints: WhereConstraintArray.create(0),
			declaringWitnessParamBase: 0,
			declaringWitnessParamCount: 0,
			witnessSlotsByInterface: noWitnessSlots,
			enclosingInnerAliases: noInnerAliases,
			declaredNestedAliases: noInnerAliases,
			scannedPerInstanceAliases: noScannedAliasNames,
			scannedFunctionAliases: noScannedAliasNames,
			bodyAliasesScanned: false,
			interfaceAliasScratch: anchors.interfaceAliases,
			readGenericWithSites: GenericWithSiteArray.create(0),
			collectsWithSites: false,
			innerAliasesFromIndex: false,
			descriptorScanSites: DescriptorScanSiteArray.create(0),
			siblingReceivers: noSiblingReceivers,
			siblingReceiverScanType: EnclosingTypeScope.fileScope,
			siblingReceiverScanBody: 0,
			enclosingTypeBodyStart: 0,
			enclosingBodyIsWalkable: false,
			extensionInterfaceName: InterfaceName.none,
			extensionAssociated: ExtensionAssociatedScope.empty(),
			sweptImplementsClauses: AliasImplementsClauseArray.create(0),
			refusedInstances: RefusedInstanceMap.create(),
			emptyTypeParamPositions: TypeParamSlots.create(),
			emptySweptParamTypes: MaxonTypeArray.create(0),
			emptyParamSpellings: NameRoster.create(0),
			emptyTypeParams: freeze NameRoster.create(0),
			noForkTemps: ValueIdArray.create(0),
			mintedTests: MintedTestArray.create(0),
			deferredPatternBindings: TokenArray.create(0),
			closureShapes: FunctionValueShapeMap.create(),
			frozenResultClosures: NameRoster.create(0),
			imageNotes: ImageNoteMap.create(),
			closureEnclosingFrames: ClosureEnclosingFrameArray.create(0),
			openByRefHandOffs: OpenByRefHandOffArray.create(0),
			emptyMoveMark: MoveMark.create(MoveSlots.empty(), consumes: PromiseConsumes.none()),
			runtimeSourceOffence: RuntimeSourceOffence.none,
			misclosedBlock: MisclosedBlock.none,
			openRegion: AbandonableRegion.none,
			blockStructureMisread: false,
			abandonedRegions: PositionKeySet.create(),
			readsALaterConformer: false,
			extensionReplayOwed: false,
			requestedInstanceSiteKeys: RequestedInstanceSiteKeyMap.create(),
			isTheReportingWalk: false,
			declaredTypeAliases: noDeferredNameDiagnostics,
			arraySurfaceRoster: anchors.surfaceRoster,
			bufferSurfaceRoster: anchors.surfaceRoster,
			stringSurfaceRoster: anchors.surfaceRoster,
			characterSurfaceRoster: anchors.surfaceRoster,
			stringIndexSurfaceRoster: anchors.surfaceRoster,
			cursorSurfaceRoster: anchors.surfaceRoster,
			arrayDeclarationRoster: anchors.declarationRoster,
			anchors: anchors
		}
	end 'createOverPreparedTokens'
end 'Parser'

type ShadowRenamedTokens
	export let tokens as TokenArray
	export let respelledStarts as RespelledTokenStartSet

	static function create(tokens TokenArray, respelledStarts RespelledTokenStartSet) returns ShadowRenamedTokens
		return Self{tokens: tokens, respelledStarts: respelledStarts}
	end 'create'
end 'ShadowRenamedTokens'

function conformanceInterfaceNames(interfaces InterfaceConformanceArray) returns NameRoster
	if interfaces.isEmpty() 'declaresNothing'
		return NameRoster.create(0)
	end 'declaresNothing'

	let names = NameRoster.create(interfaces.count(), zeroed: false)

	for conformance in interfaces 'eachInterface'
		names.push(conformance.interfaceName)
	end 'eachInterface'

	return names
end 'conformanceInterfaceNames'

// A roster keeps a view of its own: the name may be a record the signature index holds, and the roster rides the
// artifact, which crosses back from a pool worker whose index is that index.
function insertOwnedName(names UsedTypeNameSet, name ByteArray)
	if names.contains(name) 'alreadyListed'
		return
	end 'alreadyListed'

	names.insert(name)
end 'insertOwnedName'

function requireImplementsClauseHolds(verdict AliasImplementsVerdict, nameTok Token, parentName ByteArray, parentTok Token) throws SourceParseError
	match verdict 'verdict'
		resolved then return
		cycle then throw SourceParseError.typealiasCycle(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		notARangedAlias then throw SourceParseError.typealiasOverANonRangedName(String.from(parentName), line: parentTok.line, column: parentTok.column)
		rangeDoesNotFit then throw SourceParseError.implementsRangeDoesNotFit(String.from(nameTok.value), parentName: String.from(parentName), line: parentTok.line, column: parentTok.column)
		primitiveDiffers(own, parents) then throw SourceParseError.implementsPrimitiveDiffers(String.from(nameTok.value), parentName: String.from(parentName), own: own, parents: parents, line: parentTok.line, column: parentTok.column)
	end 'verdict'
end 'requireImplementsClauseHolds'

function unsupportedTypeAliasRhs(tok Token) returns SourceParseError
	return SourceParseError.unsupported("a typealias over '{tok.kind.rawValue}' (a typealias names `int(low to high)`, `float(low to high)`, `bits(n)`, `function(...)`, a tuple `(A, B)` or a generic instance `Base with …`)", line: tok.line, column: tok.column)
end 'unsupportedTypeAliasRhs'

function callArgumentLabel(argLabels NameRoster, argIndex ParamCount) returns immutable ByteArray
	if argLabels.isEmpty() 'anUnlabelledCall'
		return EmptySourceText
	end 'anUnlabelledCall'

	return try argLabels.get(argIndex) otherwise panic("callArgumentLabel: argLabels.get OOB at {argIndex} of {argLabels.count()} — a call's label list is empty or one per argument")
end 'callArgumentLabel'

typealias TokenPositionSet = Set with ElementIndex

function kindIntroducesAType(kind TokenKind) returns bool
	return kind == TokenKind.as or kind == TokenKind.returns or kind == TokenKind.throws or kind == TokenKind.with or kind == TokenKind.uses or kind == TokenKind.implements or kind == TokenKind.extends or kind == TokenKind.where or kind == TokenKind.is
end 'kindIntroducesAType'

function lastTokenIndexOf(column TokenIndexArray) returns ElementIndex
	return try column.last() otherwise panic("lastTokenIndexOf: asked of an empty column — every caller checks first")
end 'lastTokenIndexOf'

// Marks the tokens spelling a contested top-level name that are not references to it (`isNonReference`), so
// `authorMintedTokens` respells only references: a local, parameter, field, loop or caught name, a case, a
// label and a function's own name keep their spelling. Only references take a mint, because spelled
// positions must agree across files. The frame columns keep the block scopes a local or parameter shadows
// the name over; a type position is never shadowed, because it names the top-level type whatever local
// shares the spelling. Built only when a file spells a contested name, because it visits every token.
type AuthorNameScopeWalk
	let tokens as TokenArray
	let extentEnds as TokenIndexArray
	let keywordNames as TokenIndexArray
	let watched as DeclaredTypeNameSet
	var stops as TokenPositionSet
	var typeSlots as TokenPositionSet
	var frameNames as NameRoster
	var frameStarts as TokenIndexArray
	var frameEnds as TokenIndexArray
	var bodyEnds as TokenIndexArray
	var blockEnds as TokenIndexArray
	var blockOpeners as TokenIndexArray
	var labelBrackets as BoolArray
	var interfaceEnd as ElementIndex

	static function over(tokens TokenArray, extents BlockExtents, watched DeclaredTypeNameSet) returns AuthorNameScopeWalk
		return Self{tokens: tokens, extentEnds: extents.extentEnds, keywordNames: extents.keywordNames, watched: watched, stops: TokenPositionSet.create(), typeSlots: TokenPositionSet.create(), frameNames: NameRoster.create(0), frameStarts: TokenIndexArray.create(0), frameEnds: TokenIndexArray.create(0), bodyEnds: TokenIndexArray.create(0), blockEnds: TokenIndexArray.create(0), blockOpeners: TokenIndexArray.create(0), labelBrackets: BoolArray.create(0), interfaceEnd: 0}
	end 'over'

	function isNonReference(at ElementIndex) returns bool
		return self.stops.contains(at)
	end 'isNonReference'

	function run()
		var at = 0 as ElementIndex

		while at < self.tokens.count() 'eachToken'
			self.retireScopesBefore(at)
			self.trackBlocksAt(at)
			self.enterConstructAt(at)
			self.classifyIdentifierAt(at)
			self.trackBracketsAt(at)
			at = at + 1
		end 'eachToken'
	end 'run'

	function retireScopesBefore(at ElementIndex)
		while not self.frameEnds.isEmpty() and lastTokenIndexOf(self.frameEnds) < at 'eachExpiredFrame'
			_ = try self.frameEnds.pop() otherwise panic("AuthorNameScopeWalk.retireScopesBefore: pop from a frame stack just checked non-empty")
			_ = try self.frameStarts.pop() otherwise panic("AuthorNameScopeWalk.retireScopesBefore: the frame columns are pushed together")
			_ = try self.frameNames.pop() otherwise panic("AuthorNameScopeWalk.retireScopesBefore: the frame columns are pushed together")
		end 'eachExpiredFrame'

		while not self.bodyEnds.isEmpty() and lastTokenIndexOf(self.bodyEnds) < at 'eachExpiredBody'
			_ = try self.bodyEnds.pop() otherwise panic("AuthorNameScopeWalk.retireScopesBefore: pop from a body stack just checked non-empty")
		end 'eachExpiredBody'

		while not self.blockEnds.isEmpty() and lastTokenIndexOf(self.blockEnds) < at 'eachExpiredBlock'
			_ = try self.blockEnds.pop() otherwise panic("AuthorNameScopeWalk.retireScopesBefore: pop from a block stack just checked non-empty")
			_ = try self.blockOpeners.pop() otherwise panic("AuthorNameScopeWalk.retireScopesBefore: the block columns are pushed together")
		end 'eachExpiredBlock'
	end 'retireScopesBefore'

	function trackBlocksAt(at ElementIndex)
		let kind = tokenKindIn(self.tokens, index: at)

		if not kindSpellsBlockStructure(kind) or kind == TokenKind.end 'notABlockOpener'
			return
		end 'notABlockOpener'

		let closer = self.extentEndAt(at)

		if closer == 0 'opensNothing'
			return
		end 'opensNothing'

		self.blockEnds.push(closer)
		self.blockOpeners.push(at)
	end 'trackBlocksAt'

	function trackBracketsAt(at ElementIndex)
		let kind = tokenKindIn(self.tokens, index: at)

		if kind == TokenKind.leftParen or kind == TokenKind.leftBrace 'aCallOrLiteralOpens'
			self.labelBrackets.push(true)
		end 'aCallOrLiteralOpens' else if kind == TokenKind.leftBracket or kind == TokenKind.stringInterpStart 'aListOrInterpolationOpens'
			self.labelBrackets.push(false)
		end 'aListOrInterpolationOpens' else if kind == TokenKind.rightParen or kind == TokenKind.rightBrace or kind == TokenKind.rightBracket or kind == TokenKind.stringInterpEnd 'aGroupCloses'
			if not self.labelBrackets.isEmpty() 'aGroupIsOpen'
				_ = try self.labelBrackets.pop() otherwise panic("AuthorNameScopeWalk.trackBracketsAt: pop from a bracket stack just checked non-empty")
			end 'aGroupIsOpen'
		end 'aGroupCloses'
	end 'trackBracketsAt'

	// `extentEnds` is dense over the token space, 0 where nothing opens, so an index it holds no entry for is
	// a defect and panics rather than answering "no extent".
	function extentEndAt(at ElementIndex) returns ElementIndex
		return try self.extentEnds.get(at) otherwise panic("AuthorNameScopeWalk.extentEndAt: extentEnds.get OOB at {at}, outside the {self.extentEnds.count()}-token space the walk reads")
	end 'extentEndAt'

	function insideMatchBody() returns bool
		if self.blockOpeners.isEmpty() 'noBlockIsOpen'
			return false
		end 'noBlockIsOpen'

		return tokenKindIn(self.tokens, index: lastTokenIndexOf(self.blockOpeners)) == TokenKind.match
	end 'insideMatchBody'

	function enterConstructAt(at ElementIndex)
		let kind = tokenKindIn(self.tokens, index: at)

		if kind == TokenKind.function 'aFunctionOrClosure'
			self.enterFunctionAt(at)
		end 'aFunctionOrClosure' else if kind == TokenKind.for 'aLoop'
			self.declareLoopNamesAt(at)
		end 'aLoop' else if kind == TokenKind.let or kind == TokenKind.var 'aBinding'
			self.declareLocalAt(at)
		end 'aBinding' else if kind == TokenKind.else or kind == TokenKind.otherwise 'aHandler'
			self.declareCaughtNameAt(at)
		end 'aHandler' else if kind == TokenKind.identifier 'aContextualWord'
			self.enterContextualConstructAt(at)
		end 'aContextualWord' else if typeDeclarationHeaderIn(self.tokens, index: at) 'aTypeHeader'
			self.enterContainerAt(at)
		end 'aTypeHeader'
	end 'enterConstructAt'

	function enterContextualConstructAt(at ElementIndex)
		if self.bodyEnds.isEmpty() and self.blockOpeners.isEmpty() and testDeclarationAt(self.tokens, index: at) 'aTestBody'
			self.bodyEnds.push(self.bodyEndAfter(at + 1))
		end 'aTestBody'
	end 'enterContextualConstructAt'

	function enterFunctionAt(at ElementIndex)
		if self.insideMatchBody() or self.functionTypeAt(at) 'notAFunctionDeclarationOrClosure'
			return
		end 'notAFunctionDeclarationOrClosure'

		let named = functionDeclarationShapeIn(self.tokens, index: at)
		let listAt = at + 2 if named else at + 1

		if tokenKindIn(self.tokens, index: listAt) != TokenKind.leftParen 'noParameterList'
			return
		end 'noParameterList'

		let listEnd = self.closeOfParenAt(listAt)

		if not named 'aClosure'
			self.declareParams(listAt, listEnd: listEnd, start: at, scopeEnd: self.closureEndAfter(listEnd))

			return
		end 'aClosure'

		self.stops.insert(at + 1)

		let bodiless = self.interfaceEnd != 0 and at <= self.interfaceEnd
		let scopeEnd = listEnd if bodiless else self.bodyEndOfFunctionAt(at, listEnd: listEnd)

		if not bodiless 'aBodyOpens'
			self.bodyEnds.push(scopeEnd)
		end 'aBodyOpens'

		self.declareParams(listAt, listEnd: listEnd, start: at, scopeEnd: scopeEnd)
	end 'enterFunctionAt'

	function functionTypeAt(at ElementIndex) returns bool
		if self.typeSlots.contains(at) 'aParameterTypeSlot'
			return true
		end 'aParameterTypeSlot'

		if at == 0 'atTheFileStart'
			return false
		end 'atTheFileStart'

		let previous = tokenKindIn(self.tokens, index: at - 1)

		if kindIntroducesAType(previous) 'afterATypeIntroducer'
			return true
		end 'afterATypeIntroducer'

		if previous != TokenKind.equals 'notAnAssignedFunction'
			return false
		end 'notAnAssignedFunction'

		var q = at

		while q > 0 and tokenKindIn(self.tokens, index: q - 1) != TokenKind.newline 'backToTheLineStart'
			q = q - 1
		end 'backToTheLineStart'

		return tokenKindIn(self.tokens, index: pastVisibilityModifiers(self.tokens, index: q)) == TokenKind.typealias
	end 'functionTypeAt'

	function closeOfParenAt(open ElementIndex) returns ElementIndex
		var depth = 0 as NestingDepth
		var at = open

		while at < self.tokens.count() 'eachToken'
			let kind = tokenKindIn(self.tokens, index: at)

			if kind == TokenKind.leftParen 'opens'
				depth = depth + 1
			end 'opens'

			if kind == TokenKind.rightParen 'closes'
				depth = depth - 1

				if depth == 0 'theMatchingParen'
					return at
				end 'theMatchingParen'
			end 'closes'

			at = at + 1
		end 'eachToken'

		return self.tokens.count()
	end 'closeOfParenAt'

	function closesBlockAt(at ElementIndex) returns bool
		if labelledBlockCloserAt(self.tokens, index: at) 'aLabelledCloser'
			return true
		end 'aLabelledCloser'

		return tokenKindIn(self.tokens, index: at) == TokenKind.end and not followsADot(self.tokens, index: at) and not ascendingTokenIndexHolds(self.keywordNames, index: at)
	end 'closesBlockAt'

	function bodyEndOfFunctionAt(at ElementIndex, listEnd ElementIndex) returns ElementIndex
		let opened = self.extentEndAt(at)

		if opened != 0 'anOpenerTheWalkPushed'
			return opened
		end 'anOpenerTheWalkPushed'

		return self.bodyEndAfter(listEnd)
	end 'bodyEndOfFunctionAt'

	function bodyEndAfter(from ElementIndex) returns ElementIndex
		var at = from + 1

		while at < self.tokens.count() 'eachToken'
			let closer = self.extentEndAt(at)

			if closer != 0 and kindSpellsBlockStructure(tokenKindIn(self.tokens, index: at)) 'aNestedBlockOpens'
				at = closer + 1
				continue
			end 'aNestedBlockOpens'

			if self.closesBlockAt(at) 'theBodyCloses'
				return at
			end 'theBodyCloses'

			at = at + 1
		end 'eachToken'

		return self.tokens.count()
	end 'bodyEndAfter'

	function closureEndAfter(listEnd ElementIndex) returns ElementIndex
		var depth = 0 as NestingDepth
		var at = listEnd + 1

		while at <= self.tokens.count() 'eachToken'
			let kind = tokenKindIn(self.tokens, index: at)
			let ends = kind == TokenKind.eof or kind == TokenKind.newline or kind == TokenKind.comma or tokenKindClosesAGroup(kind)

			if depth == 0 and ends 'theClosureEnds'
				return at - 1
			end 'theClosureEnds'

			if tokenKindOpensAGroup(kind) 'aGroupOpens'
				depth = depth + 1
			end 'aGroupOpens' else if tokenKindClosesAGroup(kind) 'aGroupCloses'
				depth = depth - 1
			end 'aGroupCloses'

			at = at + 1
		end 'eachToken'

		return self.tokens.count()
	end 'closureEndAfter'

	function statementEndAfter(at ElementIndex) returns ElementIndex
		var q = at + 1

		while tokenKindIn(self.tokens, index: q) != TokenKind.newline and tokenKindIn(self.tokens, index: q) != TokenKind.eof 'toTheLineEnd'
			q = q + 1
		end 'toTheLineEnd'

		return q
	end 'statementEndAfter'

	function innermostScopeEnd() returns ElementIndex
		if not self.blockEnds.isEmpty() 'insideABlock'
			return lastTokenIndexOf(self.blockEnds)
		end 'insideABlock'

		return lastTokenIndexOf(self.bodyEnds)
	end 'innermostScopeEnd'

	function spellingAt(at ElementIndex) returns immutable ByteArray
		return (try self.tokens.get(at) otherwise panic("AuthorNameScopeWalk.spellingAt: tokens.get OOB at {at}, an index the walk read")).value
	end 'spellingAt'

	function declareNameAt(at ElementIndex, start ElementIndex, scopeEnd ElementIndex)
		self.stops.insert(at)
		let spelled = self.spellingAt(at)

		if not self.watched.contains(spelled) 'nothingToShadow'
			return
		end 'nothingToShadow'

		self.frameNames.push(spelled)
		self.frameStarts.push(start)
		self.frameEnds.push(scopeEnd)
	end 'declareNameAt'

	function segmentNameIndexes(open ElementIndex, close ElementIndex, markTypes bool) returns TokenIndexArray
		let names = TokenIndexArray.create(0)
		var depth = 0 as NestingDepth
		var atSegmentStart = true
		var at = parameterListStartIn(self.tokens, open: open)

		while at < close 'eachToken'
			let kind = tokenKindIn(self.tokens, index: at)

			if atSegmentStart and depth == 0 and kind == TokenKind.let 'aLetMarker'
				at = at + 1
				continue
			end 'aLetMarker'

			if atSegmentStart and depth == 0 and kind == TokenKind.identifier 'aName'
				names.push(at)
			end 'aName' else if markTypes and not atSegmentStart 'aTypeSlot'
				self.typeSlots.insert(at)
			end 'aTypeSlot'

			if kind == TokenKind.leftParen 'nestedOpens'
				depth = depth + 1
			end 'nestedOpens' else if kind == TokenKind.rightParen 'nestedCloses'
				depth = depth - 1
			end 'nestedCloses'

			atSegmentStart = depth == 0 and kind == TokenKind.comma
			at = at + 1
		end 'eachToken'

		return names
	end 'segmentNameIndexes'

	function declareParams(listAt ElementIndex, listEnd ElementIndex, start ElementIndex, scopeEnd ElementIndex)
		for name in self.segmentNameIndexes(listAt, close: listEnd, markTypes: true) 'eachParameter'
			self.declareNameAt(name, start: start, scopeEnd: scopeEnd)
		end 'eachParameter'
	end 'declareParams'

	function declareLocalAt(at ElementIndex)
		if self.bodyEnds.isEmpty() 'notInABody'
			return
		end 'notInABody'

		let previous = tokenKindIn(self.tokens, index: at - 1) if at > 0 else TokenKind.newline
		let conditionBinding = previous == TokenKind.if or previous == TokenKind.while
		let start = at if conditionBinding else self.statementEndAfter(at)
		let scopeEnd = self.extentEndAt(at - 1) if conditionBinding else self.innermostScopeEnd()
		let nextKind = tokenKindIn(self.tokens, index: at + 1)

		if nextKind == TokenKind.identifier 'aSingleName'
			self.declareNameAt(at + 1, start: start, scopeEnd: scopeEnd)
		end 'aSingleName' else if nextKind == TokenKind.leftParen 'aTuple'
			for name in self.segmentNameIndexes(at + 1, close: self.closeOfParenAt(at + 1), markTypes: false) 'eachName'
				self.declareNameAt(name, start: start, scopeEnd: scopeEnd)
			end 'eachName'
		end 'aTuple'
	end 'declareLocalAt'

	function declareLoopNamesAt(at ElementIndex)
		let scopeEnd = self.extentEndAt(at)
		var q = at + 1

		while scopeEnd != 0 and q < scopeEnd and tokenKindIn(self.tokens, index: q) != TokenKind.in 'toTheIn'
			if tokenKindIn(self.tokens, index: q) == TokenKind.identifier 'aLoopName'
				self.declareNameAt(q, start: at, scopeEnd: scopeEnd)
			end 'aLoopName'

			q = q + 1
		end 'toTheIn'
	end 'declareLoopNamesAt'

	function declareCaughtNameAt(at ElementIndex)
		let scopeEnd = self.extentEndAt(at)

		if scopeEnd == 0 or tokenKindIn(self.tokens, index: at + 1) != TokenKind.leftParen or tokenKindIn(self.tokens, index: at + 2) != TokenKind.identifier or tokenKindIn(self.tokens, index: at + 3) != TokenKind.rightParen 'noCaughtName'
			return
		end 'noCaughtName'

		self.declareNameAt(at + 2, start: at, scopeEnd: scopeEnd)
	end 'declareCaughtNameAt'

	function enterContainerAt(at ElementIndex)
		let kind = tokenKindIn(self.tokens, index: at)

		if kind == TokenKind.typealias 'aBodilessDeclaration'
			return
		end 'aBodilessDeclaration'

		let scopeEnd = self.containerEndAfter(at)

		if kind == TokenKind.interface 'itsMethodsHaveNoBodies'
			self.interfaceEnd = scopeEnd
		end 'itsMethodsHaveNoBodies'

		self.collectMembers(at, scopeEnd: scopeEnd, caseList: kind == TokenKind.enum or kind == TokenKind.union)
	end 'enterContainerAt'

	function containerEndAfter(at ElementIndex) returns ElementIndex
		let kind = tokenKindIn(self.tokens, index: at)

		if kind == TokenKind.enum or kind == TokenKind.union 'aMemberListTheWalkPushed'
			let opened = self.extentEndAt(at)

			if opened != 0 'anExtentIsKnown'
				return opened
			end 'anExtentIsKnown'
		end 'aMemberListTheWalkPushed'

		var q = at + 2

		while q < self.tokens.count() 'eachMemberToken'
			if functionDeclarationShapeIn(self.tokens, index: q) 'aMethod'
				q = self.afterMethodAt(q, bodiless: kind == TokenKind.interface)
				continue
			end 'aMethod'

			if self.closesBlockAt(q) 'theBodyCloses'
				return q
			end 'theBodyCloses'

			q = q + 1
		end 'eachMemberToken'

		return self.tokens.count()
	end 'containerEndAfter'

	function afterMethodAt(at ElementIndex, bodiless bool) returns ElementIndex
		let listEnd = self.closeOfParenAt(at + 2)

		if bodiless 'anInterfaceRequirement'
			return listEnd + 1
		end 'anInterfaceRequirement'

		return self.bodyEndOfFunctionAt(at, listEnd: listEnd) + 1
	end 'afterMethodAt'

	function collectMembers(header ElementIndex, scopeEnd ElementIndex, caseList bool)
		var q = header + 2

		while q < scopeEnd 'eachMemberToken'
			if functionDeclarationShapeIn(self.tokens, index: q) 'aMethod'
				q = self.afterMethodAt(q, bodiless: self.interfaceEnd == scopeEnd)
				continue
			end 'aMethod'

			let kind = tokenKindIn(self.tokens, index: q)

			if (kind == TokenKind.let or kind == TokenKind.var) and tokenKindIn(self.tokens, index: q + 1) == TokenKind.identifier 'aFieldOrStatic'
				self.declareNameAt(q + 1, start: header, scopeEnd: scopeEnd)
			end 'aFieldOrStatic' else if kind == TokenKind.typealias and tokenKindIn(self.tokens, index: q + 1) == TokenKind.identifier 'aNestedAlias'
				self.stops.insert(q + 1)
			end 'aNestedAlias' else if caseList and kind == TokenKind.identifier and tokenKindIn(self.tokens, index: q - 1) == TokenKind.newline 'aCaseDeclaration'
				self.declareCaseAt(q)
			end 'aCaseDeclaration'

			q = q + 1
		end 'eachMemberToken'
	end 'collectMembers'

	function declareCaseAt(at ElementIndex)
		self.stops.insert(at)

		if tokenKindIn(self.tokens, index: at + 1) != TokenKind.leftParen 'noPayload'
			return
		end 'noPayload'

		for name in self.segmentNameIndexes(at + 1, close: self.closeOfParenAt(at + 1), markTypes: false) 'eachPayloadName'
			self.stops.insert(name)
		end 'eachPayloadName'
	end 'declareCaseAt'

	function classifyIdentifierAt(at ElementIndex)
		if tokenKindIn(self.tokens, index: at) != TokenKind.identifier 'notAName'
			return
		end 'notAName'

		let spelled = self.spellingAt(at)

		if not self.watched.contains(spelled) or self.stops.contains(at) 'nothingToDecide'
			return
		end 'nothingToDecide'

		if self.armPatternAt(at) 'aCasePattern'
			return
		end 'aCasePattern'

		if tokenKindIn(self.tokens, index: at + 1) == TokenKind.colon and self.labelsAreAllowed() 'aLabel'
			self.stops.insert(at)

			return
		end 'aLabel'

		if self.typeIsWrittenAt(at) 'aTypeReference'
			return
		end 'aTypeReference'

		if self.isShadowed(spelled, at: at) 'aBlockScopeName'
			self.stops.insert(at)
		end 'aBlockScopeName'
	end 'classifyIdentifierAt'

	function labelsAreAllowed() returns bool
		if self.labelBrackets.isEmpty() 'noGroupIsOpen'
			return false
		end 'noGroupIsOpen'

		return try self.labelBrackets.last() otherwise panic("AuthorNameScopeWalk.labelsAreAllowed: last() of a bracket stack just checked non-empty")
	end 'labelsAreAllowed'

	function typeIsWrittenAt(at ElementIndex) returns bool
		if self.typeSlots.contains(at) 'aParameterTypeSlot'
			return true
		end 'aParameterTypeSlot'

		if at == 0 'atTheFileStart'
			return false
		end 'atTheFileStart'

		return kindIntroducesAType(tokenKindIn(self.tokens, index: at - 1))
	end 'typeIsWrittenAt'

	function isShadowed(spelled ByteArray, at ElementIndex) returns bool
		for frame in 0 upto self.frameNames.count() 'eachFrame'
			if (try self.frameStarts.get(frame) otherwise panic("AuthorNameScopeWalk.isShadowed: frameStarts.get OOB at {frame}")) <= at and (try self.frameNames.get(frame) otherwise panic("AuthorNameScopeWalk.isShadowed: frameNames.get OOB at {frame}")).equals(spelled) 'aFrameNamesIt'
				return true
			end 'aFrameNamesIt'
		end 'eachFrame'

		return false
	end 'isShadowed'

	function armPatternAt(at ElementIndex) returns bool
		if not self.insideMatchBody() 'notInAMatch'
			return false
		end 'notInAMatch'

		let previous = tokenKindIn(self.tokens, index: at - 1) if at > 0 else TokenKind.newline
		let next = tokenKindIn(self.tokens, index: at + 1)

		if previous != TokenKind.newline and previous != TokenKind.or 'notWhereAnArmStarts'
			return false
		end 'notWhereAnArmStarts'

		if next != TokenKind.then and next != TokenKind.gives and next != TokenKind.or and next != TokenKind.leftParen 'notAnArmSeparator'
			return false
		end 'notAnArmSeparator'

		self.stops.insert(at)

		if next == TokenKind.leftParen 'aPayloadList'
			let close = self.closeOfParenAt(at + 1)
			let scopeEnd = self.statementEndAfter(close)

			for name in self.segmentNameIndexes(at + 1, close: close, markTypes: false) 'eachPayloadName'
				self.declareNameAt(name, start: close, scopeEnd: scopeEnd)
			end 'eachPayloadName'
		end 'aPayloadList'

		return true
	end 'armPatternAt'
end 'AuthorNameScopeWalk'

function ambiguousTypeNameRefusal(name ByteArray, candidates StringArray, anchor Token) returns SourceParseError
	return SourceParseError.ambiguousTypeAlias(String.from(name), candidates: joinedWith(candidates, separator: CandidateListSeparator), line: anchor.line, column: anchor.column)
end 'ambiguousTypeNameRefusal'

function requireBuiltinArity(args ValueIdArray, builtinName ByteArray, arity ParamCount, calleeTok Token) throws SourceParseError
	if args.count() as ParamCount != arity 'arity'
		throw SourceParseError.builtinArity(String.from(builtinName), expected: arity, got: args.count() as ParamCount, line: calleeTok.line, column: calleeTok.column)
	end 'arity'
end 'requireBuiltinArity'

type PairedDisplays
	let got as String
	let gotNote as String
	let declared as String
	let declaredNote as String

	static function create(got String, gotNote String, declared String, declaredNote String) returns PairedDisplays
		return Self{got: got, gotNote: gotNote, declared: declared, declaredNote: declaredNote}
	end 'create'
end 'PairedDisplays'
