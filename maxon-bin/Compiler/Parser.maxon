function withHandedBrand(column HandedBrandColumn, box ValueId, handed HandedBrand) returns HandedBrandColumn
	match column 'state'
		unwritten then return HandedBrandColumn.entries(singleHandedBrand(box, handed: handed))
		entries(byBox) then byBox.upsert(box, value: handed)
	end 'state'

	return column
end 'withHandedBrand'

