// has; `SchedRuntime.SchedParkWakeCountName` owns what it counts.
let BuiltinsSchedParkWakeCountName = b"__Builtins.schedParkWakeCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedParkWakeCountArity = 0

// ⭐⭐ **`__Builtins.gtStackBytes()` — the calling green thread's current stack size in bytes.** It is how a
// program observes that a stack grew, was given back at a park, and what a new thread starts with. The surface is
