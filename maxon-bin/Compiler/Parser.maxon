// Parser — the recursive-descent parser.
//
// The parser emits Maxon-dialect IR ops directly onto blocks; there is no AST. Two structural
// consequences:
//
//   1. It writes exclusively into a per-file `FileParseArtifact` — its own
//      MaxonModule fragment, its own local type-name interner, and its own
//      registry contributions — and takes NO `Project`. Per-file parse
//      is therefore a pure function of `(tokens, filePath, namespace)` with no
//      shared state; `mergeArtifact` folds the result into `Project` later.
//   2. Value numbering is born HERE. Each op's result gets a dense, function-local
//      `ValueId` from `self.valueIds` at emit time. See MaxonDialect's MaxonOp header.
//
// Anything outside the parsed slice is rejected with a positioned diagnostic. What
// the slice covers: free functions (parameters, calls with `name:` labels, an
// optional `returns` clause), ranged `typealias` declarations, `let`/`var` bindings
// and reassignment, `if`/`else`/`while` with `break`/`continue`, integer and bool
// literals, parenthesized grouping, arithmetic, comparison, and type-qualified numeric
// bounds. What it does NOT: user types, generics, strings, floats, logical operators.
//
// THREE THINGS THIS FILE OWNS THAT ARE NOT OBVIOUS FROM ITS SHAPE:
//
//   1. NAME RESOLUTION, INCLUDING LEXICAL BLOCK SCOPING. `Scope` is threaded through
//      the parse, and each `if`/`else`/`while` body is a scope FRAME (parseBlockBody),
//      so a binding declared in a block is gone at its `end` and may legally shadow an
//      outer one while it lives. An unbound name is a parse-time diagnostic.
//   2. ON-THE-FLY SSA. There is no AST and no `mem2reg`: a `let`/`var` binds a name
//      straight to the SSA value its initializer produced, and the block-args (phis)
//      that merge those values across branches and loops are minted HERE, as the
//      control flow is parsed. Mutable bindings are tracked BY REFERENCE for it — see
//      LoopPhiVar for the shadowing hazard that forces that.
//   3. THE IMPLICIT RETURN. A void function's body carries no `return`, so the parser
//      supplies its terminator (closeFunctionBody) — and reports E3013 when a
//      value-returning body can fall off its end instead.

// A column of token POSITIONS, kept where a diagnostic must be anchored at a token the parse has
// already walked past. It carries the INDEX and never the `Token`: a `Token` owns its `value`
// `ByteArray`, so a per-slot column of them would clone one managed record per argument on a path
// that raises nothing almost every time, where an index is a scalar `self.tokenAt` recovers for free.
export typealias TokenIndexArray = Array with ElementIndex

// How many blocks are open around a token. 0 is FILE SCOPE — the depth at which a `let` is a
// top-level constant rather than a body-local binding (see `foldDeclaredSignaturesInto`). Wide
// range: nesting is unbounded.
typealias BlockDepth = int(0 to u64.max)

// ⭐ **WHERE A PARAMETER'S NAME STOPPED DENOTING THE PARAMETER — the `BlockDepth` of the local that rebound
// it, PLUS ONE.** Zero is "still the parameter", which is what a column grown at the fact starts every slot
// at, so the offset is what tells a rebinding at the body's own depth 0 from no rebinding at all.
typealias ParamShadowDepth = int(0 to u64.max)

// One `ParamShadowDepth` per parameter of the body `Parser.scanBodyFacts` is walking.
typealias ParamShadowColumn = Array with ParamShadowDepth

// How many brackets are open around a token — inside one, a NEWLINE belongs to the statement
// rather than ending it (see `statementEndIndexIn`). A separate alias from `BlockDepth`
// because it counts a different thing: an array literal opens no block, and a block keyword opens no
// bracket.
typealias BracketDepth = int(0 to u64.max)
typealias BracketDepthArray = Array with BracketDepth

type ClosureEnclosingFrame
	export var scope as Scope
	export let funcIndex as ElementIndex
	export var body as FunctionBodyState

	static function create(scope Scope, funcIndex ElementIndex, body FunctionBodyState) returns Self
		return Self{scope: scope, funcIndex: funcIndex, body: body}
	end 'create'
end 'ClosureEnclosingFrame'

typealias ClosureEnclosingFrameArray = Array with ClosureEnclosingFrame

enum ValueCarryPath
	value
	capture
	cellStore
	cellLoad
	part
	copy
end 'ValueCarryPath'

function pathKeepsTheRecord(path ValueCarryPath) returns bool
	return match path 'path'
		value or
		capture gives true
		cellStore or
		cellLoad or
		copy or
		part gives false
	end 'path'
end 'pathKeepsTheRecord'

enum IntervalProvenance
	operandRanges
	literalCounters
end 'IntervalProvenance'

enum ValueFact
	unprovenAlias
	aboveSignedMax
	bufferSurface
	sizedContainerBuffer
	bufferElements
end 'ValueFact'

function factCrossesPath(fact ValueFact, path ValueCarryPath) returns bool
	return match fact 'fact'
		unprovenAlias or
		bufferSurface or
		sizedContainerBuffer or
		bufferElements gives true
		aboveSignedMax gives path == ValueCarryPath.capture
	end 'fact'
end 'factCrossesPath'

function bodyHoldsFact(body FunctionBodyState, fact ValueFact, value ValueId) returns bool
	return match fact 'fact'
		unprovenAlias gives try body.aliasUnprovenMarks.get(value) otherwise panic("bodyHoldsFact: v{value} has no alias-proof slot — every SSA value is minted through mintValue, which seeds the column")
		aboveSignedMax gives valueIsMarked(body.unsignedMaxLiterals, value: value)
		bufferSurface gives valueIsMarked(body.bufferSurfaceValues, value: value)
		sizedContainerBuffer gives valueIsMarked(body.sizedContainerBufferValues, value: value)
		bufferElements gives valueIsMarked(body.bufferSurfaceElements, value: value)
	end 'fact'
end 'bodyHoldsFact'

function bodySlotSurface(body FunctionBodyState, value ValueId) returns immutable DeclaredSurface
	match body.bufferSurfaceSlots 'function'
		unwritten then return plainDeclaredSurface()
		entries(bySlot) then return try bySlot.get(value) otherwise plainDeclaredSurface()
	end 'function'
end 'bodySlotSurface'

type OpenByRefHandOff
	export let funcIndex as ElementIndex
	export let epoch as ValueId
	export let anchor as Token

	static function create(funcIndex ElementIndex, epoch ValueId, anchor Token) returns Self
		return Self{funcIndex: funcIndex, epoch: epoch, anchor: anchor}
	end 'create'
end 'OpenByRefHandOff'

typealias OpenByRefHandOffArray = Array with OpenByRefHandOff

union ElementStoreDestination
	none
	rootedAt(root VarInfo, anchor Token)
end 'ElementStoreDestination'

let SoleHandedOffPosition = 0

function captureCarriesAWitnessSlot(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.interfaceRef
end 'captureCarriesAWitnessSlot'

function handOffIsAClosureCapture(door ThreadHandOffDoor) returns bool
	return match door 'door'
		closureCapture gives true
		message or
		spawnFactory or
		publish or
		coroutine gives false
	end 'door'
end 'handOffIsAClosureCapture'

// The displacement from a module global's `globalAddr` to the value itself: ZERO, because every
// global is its OWN labelled `.data` slot and the label already names the exact address.
//
// Named rather than written `0` at the three emit sites, because the zero is a CLAIM ("this label
// names this value, with nothing in front of it") and not an arithmetic accident — a struct's `point.x`
// goes through the very same `loadIndirect`/`storeIndirect` ops with a real field offset, and at
// that point the two must be told apart by a reader.
let GlobalSlotOffset = 0 as ByteOffset

// The index of a capture within a closure's environment — a slot number, and a count of slots.
typealias EnvSlotIndex = int(0 to u64.max) implements ElementIndex

typealias TypeSpellingDepth = int(0 to u32.max)

function typeSpellingSeparates(previous TokenKind, next TokenKind, previousIsWord bool, nextIsWord bool) returns bool
	if previous == TokenKind.comma or (previousIsWord and nextIsWord) or (previous == TokenKind.rightParen and nextIsWord) 'wordsAndListItemsStandApart'
		return true
	end 'wordsAndListItemsStandApart'

	return next == TokenKind.leftParen and (previous == TokenKind.with or previous == TokenKind.returns)
end 'typeSpellingSeparates'

typealias EnvSlotIndexArray = Array with EnvSlotIndex

let ClosureEnvDropParamCount = 1
let ClosureEnvDropParamName = b"__env"
let ClosureEnvDropSuffix = "$drop"

function closureEnvDropName(closureName ByteArray) returns immutable ByteArray
	return freeze "{String.from(closureName)}{ClosureEnvDropSuffix}".toByteArray()
end 'closureEnvDropName'

function isClosureEnvDropName(name ByteArray) returns bool
	return String.from(name).endsWith(ClosureEnvDropSuffix)
end 'isClosureEnvDropName'

function closureEnvDropLayoutParam(closureLayout ClosureCaptureSource) returns HiddenWordParam
	return match closureLayout 'source'
		none gives HiddenWordParam.none
		envSlot gives HiddenWordParam.enclosingThroughEnv
	end 'source'
end 'closureEnvDropLayoutParam'

// ⭐⭐ **ONE INHERITED WITNESS: env slot `slot` of the closure now being lifted carries the ENCLOSING
// context's witness table for `where` constraint `constraintIndex`.** The pair exists because the two halves
// of a witness capture are learned in DIFFERENT parse contexts and cannot be recorded in one act: the slot is
// claimed while the CLOSURE's body is being parsed, and the value that fills it is one only the ENCLOSING
// function can produce — a hidden parameter it already holds, or, one level out, a load it must emit into its
// OWN block, which is current again only after `parseClosureExpression`'s restore. So the claim is recorded
// here and closed by `fillInheritedWitnessCaptures`, its one reader.
type InheritedWitnessCapture
	export let constraintIndex as WitnessSlotIndex
	export let slot as EnvSlotIndex

	static function create(constraintIndex WitnessSlotIndex, slot EnvSlotIndex) returns InheritedWitnessCapture
		return Self{constraintIndex: constraintIndex, slot: slot}
	end 'create'
end 'InheritedWitnessCapture'

typealias InheritedWitnessCaptureArray = Array with InheritedWitnessCapture

type OperandAlias
	export let brand as immutable ByteArray
	export let identity as immutable ByteArray

	static function named(identity ByteArray) returns OperandAlias
		return Self{brand: EmptySourceText, identity: identity}
	end 'named'

	static function mixed(brand ByteArray, ancestor ByteArray) returns OperandAlias
		return Self{brand: brand, identity: ancestor}
	end 'mixed'
end 'OperandAlias'

union OperandAliasAgreement
	leftDecides
	rightAdopted
	common(members NameRoster, ancestor immutable ByteArray)
	disjoint
end 'OperandAliasAgreement'

// The synthetic capture NAME an inherited witness occupies its env slot under. `$` is unwritable in a Maxon
// identifier — the same property `parseClosureExpression` mints its lifted names on — so this can collide
// with no user binding the body captures, and the constraint index makes one name per constraint. It is a
// name only because the capture columns are keyed by one; nothing resolves it.
function witnessCaptureName(constraintIndex WitnessSlotIndex) returns immutable ByteArray
	return freeze "$witness_{constraintIndex}".toByteArray()
end 'witnessCaptureName'

function existentialWitnessCaptureName(name ByteArray) returns immutable ByteArray
	return freeze "{String.from(name)}$witness".toByteArray()
end 'existentialWitnessCaptureName'

union CapturedValue
	unfilled
	filled(value ValueId)
end 'CapturedValue'

typealias CapturedValueArray = Array with CapturedValue

let DescriptorCaptureName = b"$descriptor"

let FixedElementCountCaptureName = b"$count"

enum ClosureHiddenWord
	descriptor
	fixedElementCount
end 'ClosureHiddenWord'

function hiddenWordCaptureName(word ClosureHiddenWord) returns immutable ByteArray
	return match word 'word'
		descriptor gives DescriptorCaptureName
		fixedElementCount gives FixedElementCountCaptureName
	end 'word'
end 'hiddenWordCaptureName'

function captureSlotNamed(captureNames NameRoster, name ByteArray) returns EnvSlotIndex throws MapError
	for slot in 0 upto captureNames.count() 'eachCapture'
		if (try captureNames.get(slot) otherwise panic("captureSlotNamed: captureNames.get({slot}) below count")).equals(name) 'found'
			return slot
		end 'found'
	end 'eachCapture'

	throw MapError.keyNotFound
end 'captureSlotNamed'

function existentialWitnessSlotIn(captureNames NameRoster, name ByteArray) returns EnvSlotIndex
	return try captureSlotNamed(captureNames, name: existentialWitnessCaptureName(name)) otherwise panic("existentialWitnessSlotIn: the captured existential `{String.from(name)}` has no witness slot — `captureSlotFor` claims one beside every interface-typed capture")
end 'existentialWitnessSlotIn'

function closureCaptureSourceOf(captureNames NameRoster, word ClosureHiddenWord) returns ClosureCaptureSource
	let slot = try captureSlotNamed(captureNames, name: hiddenWordCaptureName(word)) otherwise return ClosureCaptureSource.none
	return ClosureCaptureSource.envSlot(envSlotOffset(slot))
end 'closureCaptureSourceOf'

// The raw values are spliced into E2001's message, which `specs/if-statements.md`,
// `specs/match-statements.md` and `specs/test-declaration.md` pin byte-for-byte.
export enum LineEndingConstruct
	blockLabel = "block label"
	statement = "statement"
	matchArm = "match arm"
end 'LineEndingConstruct'

// The parser's failure modes. Distinct from NumberParsing's `ParserError` (which
// `intLiteralValue` / `floatLiteralBits` catch and re-raise, positioned, as
// `integerOverflow` / `floatLiteralOverflow`). queryParseOps turns a thrown
// `SourceParseError` into a project diagnostic — the parser itself never touches `Project`.
export union SourceParseError implements Error
	// ⭐⭐ **`got` IS `tokenDisplayText`'s AT EVERY RAISER — THE TOKEN'S TEXT, NOT ITS KIND.** The
	// reader has to FIND the token this refuses, and `identifier` is not in the file where `zzz` is; a
	// message naming a spelling the program does not contain is a defect for a token exactly as it is for a callee.
	// `tokenDisplayText` is the one door that answers it,
	// falling back to the kind's own spelling for exactly the tokens that carry no text (every punctuator,
	// `newline`, EOF) — which is why those pins do not move and read correctly either way.
	//
	// ⚠ `got` comes from the ONE helper, never from `tok.kind.rawValue` and never from
	// `String.from(tok.value)`, which renders EMPTY for a punctuator. `specs/string-interpolation.md`
	// pins the reported text, line and column.
	//
	// ⚠ `expected` is deliberately NOT the same question and does NOT go through that helper: it names a
	// GRAMMATICAL CATEGORY the source has yet to supply (`'identifier'`, `'a type'`, `'end of default
	// value'`), which no token in the file spells. See `consumeNameToken`'s `NamePosition`.
	unexpectedToken(expected String, got String, line LineNumber, column ColumnNumber)

	// A primary expression was required but the token stream had something else
	// (e.g. an operator where an operand belongs). Distinct from `unexpectedToken`:
	// it renders as E2004 `Expected expression but got '<got>'` (no quotes around
	// `expression`), the exact text `unary-operators.md`'s double-negation gates on
	// — `- -x` fails at the second `-`, since a unary operand is a PRIMARY.
	//
	// ⚠ `got` is `expressionOperandDisplayText`'s at EVERY raiser, never `kind.rawValue` inlined: this
	// path names a MISSING operand as `(empty)` where the general renderer would name the layout token,
	// and a rendering read off the token at each of the five raisers is one fact written five times.
	expectedExpression(got String, line LineNumber, column ColumnNumber)

	// ⭐ **A FIELD DEFAULT (`var name = <expr>`) WHOSE TYPE ITS TOKENS DO NOT NAME** — not a bool or
	// string literal, not a whole-expression cast `e as T`, and not a `TypeName.member` /
	// `TypeName.member(...)` head (`Parser.inferredFieldTypeAt`). It carries NO payload because the
	// sentence names no part of the program: what the author wrote is wrong in KIND, and the cure is
	// the same words whatever they wrote. The message is pinned byte-for-byte by
	// `specs/field-defaults.md`'s E2004 cases.
	uninferrableFieldDefault(line LineNumber, column ColumnNumber)

	varStartsFromBareNumber(line LineNumber, column ColumnNumber)

	letStartsFromUnboundedNumber(line LineNumber, column ColumnNumber)

	// ⭐ **`__line__` / `__file__` WRITTEN ANYWHERE BUT A FUNCTION PARAMETER'S DEFAULT** — E2060,
	// `specs/source-location-defaults.md`'s "Nowhere else". `name` is the keyword the author wrote, so one
	// variant serves both and the sentence quotes the one in front of the reader.
	//
	// Two grammar positions raise it, from `requireNotACallerLocationDefault` so that they cannot come to
	// say different things: an ordinary EXPRESSION evaluating the name, and a struct FIELD default
	// CAPTURING it. The capture-side raise is not merely a better position — a field default no literal
	// ever omits is never expanded, so an expansion-only check would let the misuse through undiagnosed.
	callerLocationOutsideDefault(name String, line LineNumber, column ColumnNumber)
	unexpectedEof(line LineNumber, column ColumnNumber)

	// An integer literal whose magnitude does not fit an i64. `literal` is the token's RAW TEXT —
	// radix prefix and `_` separators intact — because the diagnostic quotes what the source WROTE
	// (`0x1ff_ffffffffffffff`), which the decoded value can no longer say.
	integerOverflow(literal String, line LineNumber, column ColumnNumber)

	// A float literal whose magnitude exceeds what an f64 can represent (`1e400`). A SEPARATE
	// variant from `integerOverflow` rather than a reuse of it: they share an error CODE (the
	// literal is out of its type's range either way), and they must not share a MESSAGE, because
	// the limit each names is a DIFFERENT limit — an integer's is the i64 span, spelled out; a
	// float's is `f64.max`, which no i64 span describes. Same raw-text rule as its integer twin.
	floatLiteralOverflow(literal String, line LineNumber, column ColumnNumber)

	// A numeric literal whose TEXT is not a number — `1.5.3`, or any byte the number grammar refuses.
	// Distinct from the two overflow variants because the fault is different in kind: an overflow is a
	// real value that will not fit, this is text that names no value at all. Carries the raw token text
	// for the same reason they do.
	malformedNumericLiteral(literal String, line LineNumber, column ColumnNumber)

	// A field width or a decimal precision in a string interpolation's format specifier that is past
	// `stdlib/Builtins.maxon`'s `PadWidth` / `DecimalPrecision` (`int(0 to u32.max)`). It shares the
	// overflow variants' error CODE — a number outside the range of its type — and carries the whole
	// SPECIFIER rather than the offending digit run, because `"{a:200.99999999999}"` has two places a
	// number can sit and the author is looking for the one they wrote.
	//
	// ⚠ Unbounded, `"{n:200}"` writes 200 bytes into a 72-byte scratch, silently, with the next
	// interpolation part's block carved inside the overrun (`specs/string-interpolation.md`'s
	// `int-format-wide-field`). stdlib's field is a String that grows, so what is bounded here is only
	// the type of its width.
	formatFieldOverflow(spec String, line LineNumber, column ColumnNumber)

	// An INTEGRAL-ONLY operator (`mod`, the bit band, or a prefix `not`) applied to a float. Both
	// the binary and the unary raiser reach it, because it is one rule — see
	// `TypeRules.operatorIsIntegral`, which is where the operator set is decided, and
	// `notOperatorFor`'s float arm.
	nonIntegralOperands(op String, operand String, line LineNumber, column ColumnNumber)

	// ⭐ A float meeting a declared INTEGER — at a `return`, an assignment, or a global store.
	// ONE variant for every coercion site the parser owns, because they are one rule
	// (`TypeRules.checkDeclaredType`) and one fact, and the message must not vary with the site
	// that noticed. The call-argument site is SemanticCheck's — the callee's signature is not the
	// parser's to see — and it reports the same code with the same words.
	implicitNarrowing(sourceType String, targetType String, line LineNumber, column ColumnNumber)

	// A compiler BUILTIN called with the wrong number of arguments. It is the parser's to report
	// and not SemanticCheck's, because a builtin has no entry in the signature registry that
	// SemanticCheck's arity check reads — there is nothing there to disagree with.
	builtinArity(name String, expected ParamCount, got ParamCount, line LineNumber, column ColumnNumber)

	// A compiler builtin whose argument is not the TYPE it requires (`readStdin` wants an `int`). Same
	// reason as `builtinArity`: no signature exists for the ordinary argument check to consult. `required`
	// is a type name, rendered "requires an argument of type {required}". What separates this from
	// `builtinArgumentType` below is that a builtin whose argument position DOES have a named parameter and
	// a declared type says so in the ordinary argument sentence instead.
	builtinOperandType(name String, required String, got String, line LineNumber, column ColumnNumber)

	// A compiler builtin whose argument fails a REQUIREMENT THAT IS NOT A TYPE NAME (`trunc(flag)` wants a
	// number, `Builtins.sleep` an integer, `panic` a string literal). `required` is a phrase that carries
	// its own article, rendered "requires {required}", so the sentence is grammatical for every phrase
	// without the renderer guessing an article from its spelling.
	builtinOperandPhrase(name String, required String, got String, line LineNumber, column ColumnNumber)

	// ⭐ A builtin's NAMED, TYPED argument meeting the wrong type — the `__ManagedFile`, `__ManagedMemory`
	// and `String.init` family, and `print` (user ruling, 2026-08-04). A SECOND variant beside
	// `builtinOperandType` rather than a reuse of it, because the two are asked different questions: this one
	// can name the PARAMETER the author must change and the TYPE it declares, so its mismatch reads as the
	// argument mismatch it is, and `specs/type-checking.md` — the canonical definition — pins exactly that
	// for `print(42)`. Rendered through `SemanticCheck.argTypeMismatchSentence`, so the sentence has ONE
	// producer across the two tiers.
	//
	// ⚠ `print` RAISES THIS AND NOT `builtinOperandType`, which is right only for an ad-hoc builtin that has
	// no signature. Having no `FuncSignature` entry is
	// a fact about where the compiler checks the call, not about what the author did wrong. `print` takes one
	// parameter, that parameter is called `value` and it is declared `String` — every part of the ordinary
	// sentence is available, so writing a private one would only make one rejection read two ways.
	builtinArgumentType(paramName String, expected String, got String, line LineNumber, column ColumnNumber, expectedNote String, crossesRange bool)
	unsupported(feature String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **A TUPLE ELEMENT THE WHOLE-PROGRAM INDEX REFUSED — `unsupported`'s payload, under a case of
	// its own, and the ONE thing that distinguishes them is WHO CAN RAISE IT.** It renders
	// byte-identically (`Queries.parseErrorDiagnostic` routes both arms through one sentence, so no
	// message and no code moves); what it adds is that `recordScannedSignature` can tell this failure
	// apart from a token-level one.
	//
	// ⚠⚠ **THAT DISTINCTION IS LOAD-BEARING AND IT WAS BEING ERASED.** A malformed return type is the REAL
	// PARSE's to report, with a position, and the sweep's tolerance exists for exactly that. A tuple-element
	// rejection raised inside a DEFERRED fold is the one failure the real parse does NOT re-raise — by then
	// the registries are whole and the element canonicalizes — so the declaration silently stops existing.
	// `tupleElementError` converted both into one `unsupported`, after which the two were indistinguishable
	// at the tolerance, and E9002 called a user's syntax error a compiler bug (MEASURED: `returns 42` in an
	// `extension Array` reported the correct **E2010** and, on the same run, an **E9002** asserting that
	// malformed source could not be the cause — a self-falsifying pair).
	//
	// ⚠ It is minted in exactly one place (`tupleElementError`) and read in exactly one place
	// (`recordAttributableDrop`). A second minter would be a second thing claiming the sweep may blame it.
	tupleElementRejected(feature String, line LineNumber, column ColumnNumber)

	// E9002: the declaration sweep read this declaration's head, could not read its return type, and
	// dropped the signature — see `SignatureIndex.DroppedSignature` for that tolerance. The position
	// is the use, where the compile stops; `declaredIn`/`declLine`/`declColumn` name the declaration,
	// which is what has to be read to fix it. A compiler bug wherever it fires.
	droppedSignature(name String, declaredIn String, declLine LineNumber, declColumn ColumnNumber, line LineNumber, column ColumnNumber)

	declarationTheSweepMissed(name String, line LineNumber, column ColumnNumber)

	// A parameter list that repeats a name (`function f(x int, x int)`). The second
	// binding would be a dead, uncallable parameter, so it is rejected at parse time.
	// Renders as E2014, positioned at the repeated name.
	duplicateParameter(name String, line LineNumber, column ColumnNumber)

	// A reference to a name with no binding in scope. Distinct from
	// `unexpectedToken` (a syntactic mismatch): this is a name-resolution failure,
	// which the parser can detect because `Scope` is threaded through it.
	undefinedVariable(name String, line LineNumber, column ColumnNumber)

	// A bare function name taken as a value or backing an enum case where two or more declarations the file may
	// name answer to it. Renders as E3095, the refusal a bare call to the same name earns, worded for `use`;
	// `candidates` is already rendered.
	ambiguousBareName(name String, candidates String, use BareNameUse, line LineNumber, column ColumnNumber)

	// A reassignment (`x = expr`) whose target was declared `let` (immutable): only
	// `var` bindings accept it. Renders as E2013.
	assignToImmutable(name String, line LineNumber, column ColumnNumber)

	// A READ of a binding that has been MOVED FROM — its owned heap value was transferred to another
	// binding by an earlier `let u = t` / `s = t` (Wave C, static single-owner). Renders as E3102,
	// positioned on the use. A WRITE to a moved-from `var` is legal (it revives the binding) and does
	// NOT come through here — only reads reach `parseVariableReference`.
	useAfterMove(name String, line LineNumber, column ColumnNumber)
	useAfterMoveInto(name String, into String, line LineNumber, column ColumnNumber)
	useAfterMoveInAnEarlierIteration(name String, line LineNumber, column ColumnNumber)
	useAfterMovePassedTwice(name String, line LineNumber, column ColumnNumber)

	// A promise read out of a holder through a door that cannot NAME the slot it came from — a list node's
	// `value()`, a library member such as `last()` that keeps the element, a pair carrying a borrowed promise.
	// A promise is move-only (it owns a green thread, and a green thread has one owner), so the read is a move
	// whose source must be emptied when it is consumed; a door that hands back an element without its slot
	// gives the move nowhere to finish. Renders as E3141.
	// `door` names what was used and `cure` says what to do instead. ⚠ **THE CURE IS CARRIED, NOT ASSUMED.**
	// The throw sites are about different things — a container read that names no slot, a corpus member that
	// hands an element back without giving it up, a consume of a promise no frame owns, a `return` that would
	// carry a borrow out of its frame, a `clone` of a record holding one, and a `match` on a union this frame
	// does not own. One baked-in cure meant a union payload was told to *"use `get(i)` … or move it out with
	// `pop`"*, advice for a container it is not.
	promiseCannotBeBorrowed(door String, cure String, line LineNumber, column ColumnNumber)

	// A NAME still spelling a green thread that `await` or `.cancel()` already handed back to the runtime —
	// the parser-time, value-keyed half of promise linearity. `door` is how the source spelled the FIRST
	// consume (`await` / `cancel`), because "already consumed by an earlier ..." is a claim about that one
	// and naming the wrong keyword would describe a line the author did not write. It carries no NAME: the
	// caret is on the offending name already, and the sentence is about the THREAD, which an alias spells
	// just as truly as the binding that spawned it. Renders as E3142.
	promiseAlreadyConsumed(door String, line LineNumber, column ColumnNumber)

	// A `break`/`continue` with no enclosing target. `keyword` is "break"/"continue" for the
	// message; `targets` names the constructs that keyword may leave, and it is NOT the same for
	// the two — a `break` also leaves a match statement (`controlTargetNoun`). Renders as E2047.
	controlOutsideLoop(keyword String, targets String, line LineNumber, column ColumnNumber)

	// A labelled `break 'l'`/`continue 'l'` whose label names the INNERMOST loop —
	// redundant (a plain `break`/`continue` already targets it). Renders as E2048.
	// ⚠ For `break` this fires only when NO match is open: with one, the bare keyword would target
	// the MATCH, so naming the loop is the only way to say "the loop" (see `resolveControlTarget`).
	// The text is therefore true for both keywords and stays verbatim.
	labelTargetsOwnLoop(keyword String, label String, line LineNumber, column ColumnNumber)
	labelTargetsOwnMatch(keyword String, label String, line LineNumber, column ColumnNumber)

	// A labelled `break 'l'`/`continue 'l'` whose label matches no enclosing target.
	// `targets` as above. Renders as E2047.
	unknownLoopLabel(keyword String, targets String, label String, line LineNumber, column ColumnNumber)

	// A call whose FIRST argument carries a `name:` label while the callee's first parameter has no
	// default. Renders as E2052.
	firstArgNamed(line LineNumber, column ColumnNumber)

	// A call whose 2nd-or-later argument has NO `name:` label. Renders as E2053.
	argMissingLabel(line LineNumber, column ColumnNumber)

	// A call that labels an argument of a callee with NO DECLARATION, at ANY index — a bare compiler
	// BUILTIN or a `__Builtins.`-qualified intrinsic. Renders as E2067. The THIRD reading of the same
	// question, and it needs its own code because the two above both speak of a callee whose
	// parameters take labels, which is false for a callee that has no parameters at all.
	// See `argLabelRuleForCallee` for which callees answer that way, and why it is two families.
	builtinArgNamed(line LineNumber, column ColumnNumber)

	// ⭐ **THE THREE SLOTTING FAILURES OF A WITNESS DISPATCH** — arity, an unknown
	// `name:` label, and two actuals targeting one formal. They render as E3036/E3037/E3038, the SAME
	// three codes `SemanticCheck.validateCall` reports for a direct call, with the SAME words (built by
	// `Project`'s `argArityMismatchMessage`/`argUnknownLabelMessage`/`argDuplicateMessage`, which is why
	// there is one copy of them) — because it is one rule met at a second kind of call site.
	//
	// They are raised HERE rather than in SemanticCheck because a witness dispatch is in no signature
	// registry: there is no callee NAME to look up, so the only pass holding both the interface method's
	// `paramNames` and the call's arguments is the parser. (The stage is derived from a code's leading
	// digit, not from which pass raises it; `requireGenuineSelfArgs` already raises an E3005 from here.)
	// `callee` is `<Interface>.<method>` — what the call actually binds against.
	witnessArgCountMismatch(callee String, expected ParamCount, got ParamCount, line LineNumber, column ColumnNumber)
	witnessUnknownArgLabel(callee String, label String, line LineNumber, column ColumnNumber)
	witnessDuplicateArg(callee String, paramName String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **THE TWO WAYS A DISPATCH FAILS TO NAME EXACTLY ONE REQUIREMENT.** A type parameter's
	// constraints can supply several requirements under one name — `interface Derived extends Base` where
	// both declare `label` is the ordinary spelling of it, and two unrelated constraints declaring one name is
	// the other — so "which requirement?" is a real question with three possible answers. `ambiguous`
	// names both claimants because a witness dispatch binds ONE table slot and there is nothing to choose by;
	// `noWitnessRequirementOfArity` lists them all because no single one of them is what the author
	// meant, so naming one would be a true sentence about the wrong requirement. Both render off
	// `renderWitnessRequirement`, so the two messages describe a requirement the same way.
	// `provider` DESCRIBES the receiver rather than naming a type parameter — "the constraints on type
	// parameter 'T'" for a constrained-generic receiver, "interface 'Backend'" for an EXISTENTIAL.
	// Both dispatch forms raise these, and only the receiver differs; a field
	// spelled `typeParamName` would make the existential form's message say something false. Built on the
	// FAILURE path only (`Parser.witnessDispatchProviderPhrase`), so the success path allocates no phrase.
	ambiguousWitnessDispatch(method String, provider String, argCount ParamCount, first String, second String, line LineNumber, column ColumnNumber)
	noWitnessRequirementOfArity(method String, provider String, argCount ParamCount, available String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **THE THIRD WAY, AND IT IS A REFUSAL RATHER THAN A CHOICE:** every requirement of the name
	// is `static`, so none of them takes a receiver and the call supplies one. It is an ARM and not a
	// recorded `Diagnostic` because the two are not interchangeable HERE, whatever they are at a
	// declaration: a recorded diagnostic leaves the parse running, and the only thing left to run is the
	// arity/ambiguity selection over the very requirements this refusal just rejected. MEASURED, all three
	// with the diagnostic recorded and the candidates handed back: a wrong-arity call printed E3036's
	// argument COUNT **alone**, two same-named statics printed E3114's "Rename one requirement, or drop one
	// of the constraints" **alone**, and an unrelated later error in the same region printed **alone** —
	// because a `SourceParseError` thrown later drops the `artifact.diagnostics` its region recorded,
	// or all of them when no region confines it (`abortedParseArtifact`), so it ERASES a recorded one.
	// Each of those is the sentence E3116's own registry entry says must not be the answer. Throwing
	// stops the selection before it can speak, and a reported parse error cannot be erased by a later
	// one.
	// `receiver` DESCRIBES what cannot reach the requirement — "type parameter 'T'" or "interface 'Backend'".
	// A different phrase from `provider` above because the grammatical slot is different (a value OF it, not
	// requirements provided BY it), which is `IrInterface.separatorFreedomSubjectOf`'s arrangement exactly.
	staticRequirementNotDispatchable(requirement String, receiver String, line LineNumber, column ColumnNumber)

	// A VALUE-returning function whose body can fall off its end without returning.
	// Renders as E3013, positioned at the function's name. Detected here, not in a
	// later pass, because the parser is what knows the block its last statement left
	// control in — and whether that block ever got a terminator.
	missingReturn(name String, line LineNumber, column ColumnNumber)

	// A `return <expr>` inside a function that declares NO return type. Renders as
	// E3005 (a type mismatch: the function's declared result is nothing, and `<expr>`
	// is not nothing), positioned at the `return`.
	returnValueFromVoid(name String, line LineNumber, column ColumnNumber)

	// A `return` inside a file-scope or `static` initializer, which has no function of the author's
	// to leave. Renders as E2080, naming `binding` as the source declares it, positioned at the
	// `return`.
	returnInInitializer(binding String, line LineNumber, column ColumnNumber)

	// A BARE `return` inside a function that DOES declare a return type — a path that
	// leaves the function with no value to return. Renders as E3013, the same code as
	// falling off the end, because it is the same defect wearing a `return` keyword.
	// Positioned at the `return`, which is where the missing value belongs.
	returnWithoutValue(name String, line LineNumber, column ColumnNumber)

	// A WORD operator (`and`/`or`/`xor`) whose operands are one `bool` and one `int` — in either
	// order, and on either of the two paths such an operator can take (a `binOp`, or the short-circuit
	// lowering). Renders as E3005 (a type mismatch), positioned at the operator. See TypeRules'
	// `BinOpOperands.mixedWordOperands` for why a mixture has no reading at all.
	operandTypeMismatch(op String, line LineNumber, column ColumnNumber)

	// Two operands carrying two different typealiases. A `typealias` names its own type, so `as` is the one
	// door between them, and the operator is not it.
	operandAliasMismatch(op String, left String, right String, line LineNumber, column ColumnNumber)

	// An ARITHMETIC / DIVISION / SHIFT operator with a non-numeric operand — `4 + flag`, `flag shl 4`,
	// `true + false`. Renders as E2004 (`Cannot operate on int and bool`), positioned at the operator.
	// Both operand type names ride along because the message names both.
	nonNumericOperands(left String, right String, line LineNumber, column ColumnNumber)

	// **E3097** — `==`/`!=` against an enum or union value's `.name`/`.ordinal`/`.rawValue`. See
	// `Parser.requireNotAnEnumAccessorComparison` for why the accessor is the wrong thing to compare.
	enumAccessorComparison(member String, op String, line LineNumber, column ColumnNumber)

	// **E3034** — a `fromRawValue` whose CONSTANT argument matches no case's raw value. Folded at the
	// call site rather than left to the helper's run-time throw.
	enumNoSuchRawValue(value String, enumName String, line LineNumber, column ColumnNumber)

	// **E3086** — a struct literal left one or more fields with no value from any of the THREE sources the
	// language offers (`/specs/field-initialization.md`): the literal itself, a declared default, or a
	// `self.<field> = …` in a static factory. The message names all three, because which one an author
	// reaches for is theirs to choose.
	fieldsNotInitialized(typeName String, fields String, plural bool, line LineNumber, column ColumnNumber)

	// **E3086** — a factory's `Self{…}` took a field from a deferred assignment that does NOT reach it on
	// every path. A different fault from the one above with a different cure, so a different sentence: the
	// assignment exists and the author has to make it unconditional.
	fieldsNotDefinitelyAssigned(typeName String, fields String, firstField String, plural bool, line LineNumber, column ColumnNumber)

	// ⭐ **TWO OPERANDS OF ONE NON-NUMERIC TYPE, which is a different mistake from a MIXED pair.** The
	// commonest of them is `a + b` over two `String`s reaching for concatenation, and "cannot operate on
	// String and String" is true while saying nothing: what the author needs told is that the OPERATOR is
	// not defined for the TYPE, which is the sentence that sends them to interpolation. Renders as
	// **E3005** — it is a rule about a type, not a malformed expression.
	undefinedOperatorForType(op String, typeName String, line LineNumber, column ColumnNumber)

	// A prefix `-` applied to a non-numeric operand (`-flag`). The same rule as `nonNumericOperands`,
	// asked of the one operand a unary has. Renders as E2004, positioned at the `-`.
	nonNumericNegation(operand String, line LineNumber, column ColumnNumber)

	// A `shl`/`shr` whose count the compiler FOLDED and found NEGATIVE — `a shl -1`, `a shl -(1)`,
	// `let SHIFT = -1` … `a shl SHIFT`. Renders as E2054, positioned at the count as written. The
	// count rides along because the message names it.
	//
	// A negative count is not a shift the other way: masked, `a shl -1` silently became
	// `a shl 63` — the MAXIMUM left shift, a wrong answer with the opposite sign.
	//
	// ⚠ A count of 64 OR MORE IS NOT THIS ERROR. It is a legal, well-defined shift that moves
	// every bit out (`x shl 64` == 0), and `Parser.emitShift` folds it to that. Rejecting it —
	// which this diagnostic did before the rule was narrowed to Go's — OVER-rejects a correct
	// program, which in this codebase is the worse failure.
	shiftCountNegative(count FullRangeInt, line LineNumber, column ColumnNumber)

	// A comparison whose operands are in different type classes (`4 < flag`). Renders as E3005 — `type
	// mismatch: 'cannot compare int with bool'` — positioned at the comparison operator. A comparison
	// over two bools is LEGAL (`a == b`); it is the MIXTURE that is meaningless, because the compare
	// would be over the bool's 0/1 payload rather than over anything the source wrote.
	comparisonTypeMismatch(left String, right String, line LineNumber, column ColumnNumber)

	// A COMPARISON OPERATOR on an UNCONSTRAINED type parameter — `item == other` with no `where T is
	// Equatable`, or `item < other` with no `where T is Comparable`. Renders as **E3005**, positioned at the
	// operator. Both families dispatch through a witness (equality through `Equatable.equals`, ordering
	// through `Comparable.compare`); without the constraint there is no witness, and a scalar `compare` would
	// silently compare two opaque words (a POINTER compare for a struct `T`). `op` is the operator spelling,
	// `typeParamName` the parameter's declared name, `interfaceName` the interface whose constraint the
	// operator needs — ONE variant and ONE message for both families, because the sentence is identical but
	// for that name, and two copies of it would be free to drift.
	operatorRequiresConformance(op String, typeParamName String, interfaceName String, line LineNumber, column ColumnNumber)

	// A struct `==`/`!=` whose dispatch target does not return `Equatable`'s own `bool` — `type Box` with
	// `function equals(other Box) returns String`. Renders as **E3005**, positioned at the operator.
	//
	// ⚠ **IT IS THE DIRECT-DISPATCH TWIN OF THE CHECK `witnessTargetIsProtocol` ALREADY MAKES.** That site
	// records the measurement in full: matching a dispatch
	// target by METHOD NAME admits a method that merely shares the name, and *"the twin with `equals` made
	// `a == b` evaluate to the raw `7` that `equals` returned"*. `structComparisonOperands` matches by
	// name for the same reason, so without this check the same wrong answer is reachable through the
	// direct door: MEASURED on this tree, `a == b` evaluated to the `String` the author's `equals`
	// returned, and `a != b` applied `logicalNot` to that heap POINTER while stamping the result
	// `boolean` — a fabricated truth value, silent, and always `true`.
	//
	// `structName` is the struct, `got` its `equals`'s actual result, `op` the operator the author wrote.
	structEqualsResultNotBool(structName String, got String, op String, line LineNumber, column ColumnNumber)

	// A value that is NOT of the receiver's own type parameter supplied for a `Self`-typed witness-method
	// argument (`item == 42` / `item.equals(42)` inside `type Box uses T where T is Equatable`, T a struct).
	// Renders as **E3005**, positioned at the operator / method. The `where` constraint only proves
	// `equals(Self)` — against another value of the SAME type parameter T — so anything else is not a `Self`;
	// marshalling it into the `Self` pointer/slot faults (a struct `equals` dereferences an int literal as its
	// `other` pointer). `what` is the operator or method spelling, `typeParamName` the constrained parameter's
	// name, and `got` describes what was supplied instead — the TWO ways an actual can fail (a concrete value,
	// and a value of a DIFFERENT type parameter of the same generic type) share one variant and one sentence,
	// differing only in that phrase, because they are one rule with one cure.
	witnessSelfArgNotTypeParam(what String, typeParamName String, got String, line LineNumber, column ColumnNumber)

	// An `if` / `while` condition that is not a `bool` (`if 4`). Renders as E3005, positioned
	// at the CONDITION's first token — the expression the message is about, not the keyword
	// that introduced it. `keyword` is "if"/"while", so one message template serves both.
	//
	// The condition is refused here, in the parser, where its type is known. Reaching the Maxon→Std
	// lowering instead produces an internal error (E9001), which names no source position and
	// describes no defect in the program.
	nonBoolCondition(keyword String, got String, line LineNumber, column ColumnNumber)

	// A reassignment whose value does not agree with the target binding's DECLARED type
	// (`var x = 5` then `x = true`). Renders as E3005, positioned at the variable name — the
	// same anchor `assignToImmutable` uses, because it is the same statement failing for the
	// other reason a binding can refuse a value. See `parseAssignment` for why this one check
	// is what makes every merge phi's type honest.
	assignTypeMismatch(place String, got String, gotNote String, expected String, expectedNote String, line LineNumber, column ColumnNumber, crossesRange bool)

	// ⭐ **THE SENTENCE A DECLARED SLOT REACHED THROUGH AN ARGUMENT LIST REFUSES A VALUE IN** — a union
	// case's payload slot (`Paint.tint(Shade.light)`). It names NEITHER a variable nor a parameter,
	// and that is the canonical corpus's choice rather than a compiler one: `specs/union-cases.md` and
	// `specs/enum-full.md` both pin `type mismatch: 'expected <declared>, got <arriving>'` for exactly
	// this position. A payload slot has no parameter an author could rename and is not a place they
	// assign to — what they must change is the ARGUMENT — so the sentence states the two types and, when
	// `crossesRange`, the cast hint. Renders as E3005; see `SlotMismatchVoice.payloadArgument`.
	typeMismatchExpectedGot(expected String, got String, line LineNumber, column ColumnNumber, expectedNote String, crossesRange bool)

	// ⭐ A statement-level TUPLE ASSIGNMENT whose target count does not match the tuple's element count
	// (`(x) = makePair(…)`). Renders as E3005, positioned on the `(` — where the author decided how many
	// targets to write. Both the code and the wording are `specs/tuple-assign.md`'s, pinned by
	// `tuple-assign-error-count-mismatch`, and BOTH differ from the E2015 the two DECLARING patterns raise
	// for the same shape of mistake — see `requireTupleLayout` for why the two are not merged.
	tupleAssignArityMismatch(elements FieldIndex, targets ElementIndex, line LineNumber, column ColumnNumber)

	// A `return <expr>` whose value's type class differs from the function's declared return type
	// (`return flag` from a function declared `returns Integer`). Renders as E3005 — `Cannot return
	// 'bool' from function declared to return 'int'` — positioned at the `return`. The declared type
	// prints as its RESOLVED primitive (see TypeRules' typeTagName).
	//
	// `origin` names the callee a closure's declared result was offered by, so the refusal is dropped
	// when that callee's declaration was refused (`ParseStaging.consequenceNamedBy`).
	returnTypeMismatch(got String, gotNote String, expected String, expectedNote String, line LineNumber, column ColumnNumber, origin ReceiverOrigin)

	// A FUNCTION VALUE stored into a NON-function place (`slot = dbl` where `slot` holds an
	// int). Renders as E3005 with the spec's exact text — "cannot assign a value of type 'function' to
	// {noun} '{name}', which holds '{heldType}': …" — positioned at the target. `noun` is "variable" for
	// a local and "global" for a top-level one (the two spellings the spec distinguishes). Its own
	// variant, not `assignTypeMismatch`, because the wording and the noun both differ.
	functionValueIntoNonFunction(place String, heldType String, line LineNumber, column ColumnNumber)

	// A FUNCTION VALUE RETURNED where a NON-function return type is declared (`return dbl` from
	// a `returns Integer` function). Renders as E3005 with the spec's exact text — "Cannot return
	// 'function' from function declared to return '{returnType}': …" — positioned at the `return`.
	functionValueReturned(returnType String, line LineNumber, column ColumnNumber)

	// An `as` cast between FUNDAMENTALLY-INCOMPATIBLE KINDS, where no conversion exists: a managed
	// aggregate (a String, a struct, a function value) cast to or from a scalar number (`"x" as Age`,
	// `p as Age`, `f as Age`, `n as SomeStructAlias`). Renders as E3009 — the SAME code the lossy `5.0
	// as int` gets, because it is the same fact (a cast that is not a legal conversion). The text is
	// `Cannot cast from {src} to {tgt}`, positioned at the `as`. `src`/`tgt` are the two types'
	// `typeTagName`s (`String`/`struct`/`function`/`int`). Without the refusal `applyCast` lets the
	// cast through as a representational no-op and the aggregate's POINTER flows on typed as the
	// numeric target, either miscompiling (a range check on a struct pointer) or surfacing only
	// downstream at the next type-checked position.
	invalidCast(sourceType String, targetType String, line LineNumber, column ColumnNumber)

	// E3131. An `as` whose target is a GENERIC INSTANCE. Its own arm rather than `invalidCast`'s because the
	// reason is not that two KINDS do not convert — a container's elements have a layout of their own, and
	// the two layouts need not agree — and because the message must name the two containers as the source
	// SPELLS them, where `invalidCast` names tag words (`int`, `float`, `struct`).
	castTargetIsAContainer(sourceType String, targetType String, line LineNumber, column ColumnNumber)

	castFormsAValue(sourceType String, targetType String, remedy String, line LineNumber, column ColumnNumber)

	// ⭐ **A TYPE NAME, MET WHERE THERE IS A TOKEN TO POINT AT, THAT DENOTES NO TYPE AT ALL** — a typo
	// (`Scor` for `Score`), a bare sized name (`u8` is not a type in Maxon; a ranged alias over it is), or
	// a type the compiler does not have. Renders as **E3011** with `unknownTypeMessage`, the SAME code and
	// the SAME wording `TypeResolution` gives the identical fact met at a parameter, a return type or a
	// field, and from the SAME authority (`denotedNamedType`) — so a name cannot be a type in one position
	// and not in another. Only the ANCHOR is this arm's contribution: the declaration sites report at the
	// type name the declaration wrote, while every raiser here holds a token of its own.
	//
	// ⚠ **IT IS NOT THE CAST'S.** The payload is not cast-specific (a type name and a position), and a
	// second kind of site besides the two `as` sites raises it: the three MEMBER-ACCESS doors, whose base's
	// declared type names nothing (`undeclaredBaseTypeNameOf`). Cast-named, that would be a
	// misnamed arm or — worse, and the alternative actually weighed — the same fact reported under E2015
	// with a second wording, which is exactly the two-homes-for-one-fact defect `unknownTypeMessage`
	// exists to prevent.
	//
	// ⚠ **WHY A PARSE-TIME DOOR RAISES A CODE THE AUTHORITY ALSO RAISES, AND WHY THAT IS NOT A SECOND
	// PRODUCER.** The predicate and the words are the authority's — this arm supplies neither. What it
	// supplies is a REPORT ON A ROUTE THE AUTHORITY CANNOT REACH: both an `as` cast and a member
	// access on such a base make the parse THROW, and a thrown `SourceParseError` abandons the region
	// that holds it, so `resolveTypes` never sees the cast or the access and on these routes E3011 is
	// never reported by anything else.
	// Measured without the member-access doors wired here: they report the base as *"declared
	// 'int'"* — `typeTagName`'s reading of a `named` tag — and the authority's E3011 never appears.
	//
	// Raised by: the cast site (`castTargetTag`, positioned at the `as` — the only token certainly part
	// of a cast when the name denotes nothing anywhere), and the three member-access doors (positioned
	// at the base or the member).
	// Without the cast half the cast silently evaporates and the program runs
	// (`5 as CompletelyMadeUpNameXyz` returns 5).
	unknownTypeName(typeName String, line LineNumber, column ColumnNumber)

	// A THROWING function referenced as a VALUE (`let f = risky`). A function type has no throws
	// clause, so the binding would drop it and there is no indirect try-call to carry it back. Renders as
	// E3101, positioned at the function name. `errorType` is the thrown enum's name (the callee's `throws
	// E` clause), named in the message.
	throwingFunctionAsValue(name String, errorType String, line LineNumber, column ColumnNumber)

	// A match EXPRESSION whose `gives` arms produce values of different types
	// (`match c { 0 gives "s"; default gives 5 }`, or two different structs/unions). The result phi
	// takes the FIRST arm's type, so a later arm's value is wrong-typed through it — a String pointer
	// read off an integer (segfault), or a wild free when the phi is dropped under the first type's
	// destructor. Renders as E3005, positioned at the `match`. `got`/`expected` are the mismatching
	// arm's type and the first arm's, each already the printable name (`typeTagName` for a scalar
	// class, the interned aggregate name for two structs/unions) — the same shape `returnTypeMismatch`
	// carries, so the three coercion-site messages phrase one rule one way.
	giveTypeMismatch(got String, gotNote String, expected String, expectedNote String, line LineNumber, column ColumnNumber)

	// A TERNARY (`a if c else b`) whose two branches produce different types — the
	// ternary twin of `giveTypeMismatch`, split off because its E2028 wording names the TRUE and FALSE
	// branches by position where a match names the offending arm. Renders as E2028, positioned at the
	// `if`. `trueType`/`falseType` are each already the printable name: a scalar class, an aggregate
	// name, or (the function-arm case) a `fn(…) returns …` signature string.
	ternaryValueTypeMismatch(trueType String, trueNote String, falseType String, falseNote String, line LineNumber, column ColumnNumber)

	// A TERNARY whose CONDITION is not a bool (`x if 42 else y`). The ternary twin of
	// `nonBoolCondition`, split off because it renders as E2028 (not E3005) and anchors at the `if`.
	// `got` is the condition's printable type.
	ternaryNonBoolCondition(got String, line LineNumber, column ColumnNumber)

	// A `not` whose operand's type the parser cannot determine. Since the whole-program signature
	// index landed, that is reachable only for a call to a function NO FILE DECLARES — a program
	// already doomed (E3004). Renders as E3005, positioned at the `not`. It is a REJECTION rather
	// than a guess because `not`'s two readings disagree about the VALUE: the bitwise complement
	// of a bool is -1 or -2, and both read as TRUE (see `notOperatorFor`).
	notOnUnknownType(line LineNumber, column ColumnNumber)

	// A call to a VOID function used where a VALUE belongs — `let x = noop()`, `return noop()`, `if
	// noop()`, `noop() + 4`. Renders as E2004 ("Function 'noop' does not return a value"), positioned
	// at the callee name.
	//
	// The parser is the right tier and the CALL SITE is the right anchor, because the parser is the
	// only place that knows which of the two call positions this is: the grammar has exactly two
	// (a bare-call STATEMENT, whose whole purpose is to discard the result, and a call inside an
	// EXPRESSION, which needs one), and `parseCall`'s `resultUsed` is that distinction.
	//
	// A void callee's result is tagged `ValueTypeTag.void`, apart from the deferred `unresolved`
	// value a call to an undeclared callee gets: TypeRules defers on `unresolved`, so a void result
	// carrying it would pass every rule.
	voidCallResultUsed(name String, line LineNumber, column ColumnNumber)

	// A character literal whose body is not one character: `''`, or a `\` escape the
	// decoder does not know. Renders as E2016, positioned at the literal. (A literal that
	// is a valid but MULTI-BYTE character — `'é'`, an emoji — is not this: it is a
	// legitimate program the compiler cannot yet compile, so it reports as `unsupported`.)
	invalidCharacterLiteral(reason String, line LineNumber, column ColumnNumber)

	// A `\xNN`/`\uNNNN` escape with the wrong number of hex digits, in any of the three literal forms
	// that admit one — a character literal, a string literal/interpolation, or a `b"…"` byte string.
	// Renders as E1004, `lexerInvalidEscape` — NOT the E2016 an unrecognized `\q` gets, because `\x`
	// and `\u` ARE recognized escapes and only their digit count is wrong. It carries the FULLY-BUILT
	// message (`invalidDigitEscapeError`, the one place the three variables meet).
	invalidDigitEscape(message String, line LineNumber, column ColumnNumber)

	// A `b"…"` byte-string literal names a codepoint above 0xFF — a literal character or a `\uNNNN`
	// escape with no single-byte Latin-1 encoding (`b"Ā"`, `b"Ā"`, an emoji). Renders as E1004,
	// `lexerInvalidEscape`. It carries the FULLY-BUILT message (`byteStringCodepointRangeMessage`,
	// with the codepoint hex-formatted at the decode site).
	byteStringCodepointRange(message String, line LineNumber, column ColumnNumber)

	malformedLiteralText(message String, line LineNumber, column ColumnNumber)

	// A top-level binding name DECLARED more than once in one DIRECTORY — `let A = 1` then `let A = 2` in one
	// file, a `let`/`var` collision on one name, or two files of one directory that each `export let LIMIT`.
	// A binding another directory declares under the same name is a different binding (a contested name is
	// minted `<dir>~NAME`), so it never reaches this error. Unlike the top-level constant arms below (raised during the
	// sweep, recorded on the decl, re-thrown), this is raised DIRECTLY by the real parse when it reaches
	// a declaration its storage key does not hold (`raiseBindingFailure` via
	// `ProgramSignatures.isRedeclaredBinding`). Renders as E3006, positioned at that declaration's name — the
	// top-level twin of the duplicate-FUNCTION check `commitFuncSignatures` makes. `recordDecl` holds the
	// declaration from the file whose path identity sorts earliest, and the first within one file, so this
	// names every other one.
	duplicateTopLevelDeclaration(name String, incumbentKeyword String, line LineNumber, column ColumnNumber)

	// --- The top-level constant arms ---
	//
	// Both are raised while the whole-program declaration sweep folds initializers, and the sweep has
	// no business reporting anything itself (`foldDeclaredSignaturesInto` is deliberately tolerant). They are recorded on the declaration and re-thrown here, by the real
	// parse, when it reaches the `let` that owns them — see `TopLevelConstant.failed`. That they are
	// ParseErrors and not a private error space is the point: `parseErrorDiagnostic` is already the
	// one place a parse-time diagnostic becomes a project diagnostic, and a second mapper would be a
	// second opinion about which code means what.
	//
	// A set of top-level constants that reference each other in a closed chain, so none of them can
	// be evaluated. `names` lists the cycle's members in the order the sweep met them. Renders as
	// E2012, positioned at the LAST-DECLARED member's name — see `ProgramSignatures.recordCycle`.
	circularConstants(names String, line LineNumber, column ColumnNumber)

	// A scalar top-level binding whose initializer has no compile-time value and names no call.
	// Renders as E2045, positioned at the initializer's first token, `leftover` being its whole text.
	nonConstantInitializer(name String, leftover String, line LineNumber, column ColumnNumber)

	// ⭐ **E3103 — A DIVISOR THE COMPILER HOLDS AS 0.** `a / 0`, `a mod 0`, `a / zero` where
	// `zero` folded to 0, and the float `a / 0.0` / `a / -0.0` (both of which give an infinity).
	// Positioned at the operator.
	//
	// ⚠ **IT IS NOT ROUTED TO THE THROWING PATH, AND THAT IS THE RULE RATHER THAN A SHORTCUT.** A
	// possibly-zero divisor throws `DivisionByZero` and is handled with `try`; a PROVABLY-zero one is a divide
	// that can only ever fail, so offering the program a catchable error would be offering it a recovery from
	// a bug. `op` carries the operator's own spelling so `mod` is not reported as `/`.
	divisionByProvableZero(op String, line LineNumber, column ColumnNumber)

	// A top-level constant cast whose LITERAL value is outside the ranged alias it is cast into
	// (`let BAD = 300 as Byte`). Renders as E3005 with the SAME words and format `InsertRangeChecks`
	// gives a body cast — `literalOutOfRangeMessage` — positioned at the `as` token. It is a distinct
	// arm rather than a runtime guard because a top-level `let` is CONST-ONLY (folded before any code
	// exists), so its only failure is the compile-time one; the runtime cascade a body cast can also
	// emit has no place to live here. The body-cast check happens in the Std pass off the recorded
	// site; an initializer's parse is never lowered, so `requireConstantCastInRange` makes the same
	// call itself. `low`/`high` ride along so the message renders through the one
	// `formatRangeDisplay`, and `isFloat` with them — `value`, `low` and `high` are IEEE-754 BIT
	// PATTERNS for a float alias and numbers for an integer one, and the renderer cannot tell from the
	// payloads which it has been handed.
	constantCastOutOfRange(value FullRangeInt, aliasName String, low FullRangeInt, high FullRangeInt, isFloat bool, writtenNegative bool, domain RangedAliasDomain, line LineNumber, column ColumnNumber)

	// ⭐ **A BYTE OF A `b"…"` LITERAL THAT ITS ELEMENT'S DECLARED RANGE DOES NOT ADMIT.** Renders as
	// E3005 through `byteStringByteOutOfRangeMessage`, positioned at the literal token.
	//
	// It is a DISTINCT arm from `constantCastOutOfRange` above even though both are E3005 over a ranged
	// alias, and for the reason that variant's own header gives about its message: the subject differs. A
	// cast narrows ONE value the author wrote; a blob is a RUN of values the source never spelled out, so
	// this arm carries the OFFSET, which is the only way to say which of them is wrong. `low`/`high` and
	// `isFloat` ride along for the same reason they do above — the renderer cannot tell a float alias's bit
	// patterns from an integer alias's numbers by looking at them.
	byteStringByteOutOfRange(value FullRangeInt, offset FullRangeInt, aliasName String, low FullRangeInt, high FullRangeInt, isFloat bool, domain RangedAliasDomain, line LineNumber, column ColumnNumber)

	// ⭐ **A RAW-BYTE FILL OF AN ELEMENT THAT CANNOT HOLD EVERY BYTE.** Renders as **E3117** through
	// `rawByteFillNarrowElementMessage`, positioned at the method token and naming the CONSTRUCT that fills.
	//
	// It is the PER-TYPE twin of `byteStringByteOutOfRange` above and carries no `value` or `offset`,
	// because there is nothing to carry: the bytes are a runtime blit. `member` takes their place — three
	// constructs reach this rule, so it must say which one was written. The remaining payload is the arm
	// above's, and rides for the same reasons.
	rawByteFillNarrowElement(member String, aliasName String, low FullRangeInt, high FullRangeInt, isFloat bool, line LineNumber, column ColumnNumber)

	// ⭐ **A RAW-BYTE WRITE INTO A SLOT ITS ELEMENT DOES NOT FILL.** Renders as **E3118** through
	// `rawByteWriteSlotDomainMessage`, positioned at the method token like its `rawByteFillNarrowElement`
	// sibling above.
	//
	// ⚠ **THE ELEMENT ARRIVES PRE-RENDERED WHERE THE SIBLING CARRIES BOUNDS, AND THAT IS THE PAYLOAD THE
	// SUBJECT ALLOWS.** This rule refuses `bool`, an enum's ordinal and an opaque `T` as readily as a ranged
	// alias, so there is no `low`/`high` pair every subject has — only a NAME, which for a ranged element
	// carries its declared range beside it. The renderer cannot choose between those two shapes, because the
	// choice needs the signatures; `builtinArgumentType`'s `got:` is the same split for the same reason.
	rawByteWriteSlotDomain(member String, elementDisplay String, slotBytes ElementStride, line LineNumber, column ColumnNumber)

	// --- The struct arms ---
	//
	// A struct literal (`Point{…}`) written outside the type's OWN methods. Renders as E3076,
	// positioned INSIDE THE BRACE — see `structLiteralBraceInteriorToken`, which is where both this
	// and the E3072 below take their position from and why. Construction is restricted to the type's
	// own methods and static factories so a type's invariants have a SINGLE enforcement point — an
	// external caller goes through `Point.create(…)`. See the render arm in `Queries.maxon` for the
	// sentence.
	constructorRestricted(typeName String, line LineNumber, column ColumnNumber)

	// A struct literal naming a COMPILER BUILTIN managed type (`__ManagedFile`, …). Renders as E3072,
	// positioned inside the brace like the arm above — the two SHARE the oracle's anchor and differ in what
	// they say. Distinct from `constructorRestricted` above, and it must be: that one says "not HERE" and
	// prescribes a static factory THE USER COULD WRITE, whereas this type has no source body for a literal
	// to be legal in and no user-writable static at all — its handle comes from the OS. E3076's cure is
	// unwritable for it, so E3076 would be advice its reader cannot take.
	builtinTypeConstruction(typeName String, line LineNumber, column ColumnNumber)

	// A field access (`p.x`) naming a field the struct does not declare. Renders as E3018,
	// positioned at the FIELD name — the token that is wrong, not the value it is read from.
	unknownField(typeName String, fieldName String, line LineNumber, column ColumnNumber)

	// ⭐ A call to a method a CONDITIONAL extension WITHHELD from this type — `h.isGreater(…)` where
	// `extension Holder where Item is Comparable` exists but `MyHolder` binds `Item` to a type that does not
	// implement `Comparable`. Renders as E4006, positioned at the METHOD name.
	//
	// ⚠ **IT IS A DIFFERENT DEFECT FROM "no such method", WHICH IS WHY IT IS NOT E3004.** The ordinary
	// missing-method answer (`SemanticCheck.validateCall`, one pass later) is right about a TYPO and useless
	// here: the method IS written, in a file the author can open, and what they need is the condition it was
	// written under and which of their bindings fails it. Nothing but the front end holds that pairing —
	// `ProgramSignatures.conditionalExtensionSkipOf` is filed by the fold that took the decision — so the
	// refusal is raised where the pairing is, one stage before the general one it pre-empts.
	conditionalExtensionWithheld(typeName String, methodName String, clause String, unmetInterfaceName String, bindingName String, line LineNumber, column ColumnNumber)

	// A struct literal that omits a field the declaration gives no DEFAULT for. Renders as E3086,
	// positioned at the type name.
	//
	// ⚠ It is NOT tolerated by the allocator's zeroing guarantee, and that is worth saying because
	// the guarantee makes it look safe: an omitted slot would read back as 0, which is a plausible
	// number and therefore a WRONG ANSWER rather than a crash. `Point{x: 1}` would have `y == 0`
	// and nothing would say so.
	//
	// Field DEFAULTS are what make an omission legal, and they NARROW this arm
	// rather than removing it: `applyFieldDefaults` fills every omitted slot that declares one
	// BEFORE `requireAllFieldsInitialized` looks, so what reaches here is a slot with no value from
	// either source. The message's "and it has no default value" is a statement of fact.
	fieldNotInitialized(typeName String, fieldName String, line LineNumber, column ColumnNumber)

	// A struct literal that names one field twice (`Point{x: 1, x: 2}`). Renders as E3018 — the
	// same code an unknown field reports, because it is the same defect from the other side: the
	// literal's field list does not correspond to the type's. Positioned at the repeated name.
	duplicateFieldInitializer(typeName String, fieldName String, line LineNumber, column ColumnNumber)

	// --- The field-mutability arm ---
	//
	// A write to a field declared `let` — `c.version = 2` where `version` is `export let`. Renders
	// as **E2013, the SAME code as `assignToImmutable`**, because it is the same defect reached
	// from the other side: a write to something declared not to accept one. A second code would
	// split one rule across two numbers, and a reader hitting either wants the identical advice.
	// (Precedent for many-variants-one-code: `unknownLoopLabel` reports `ErrorCode.controlOutsideLoop`.)
	//
	// It is a DISTINCT arm rather than a reuse of `assignToImmutable` because the two must say
	// different words — that one names a VARIABLE ("'x' is a let and cannot be reassigned"), and that
	// wording for `version` would name something the source did not write, and would not tell the reader
	// it is a field ("'version' is a let field and cannot be reassigned").
	//
	// ⚠ Positioned at the ROOT VARIABLE token, NOT the field — pinned at `:16:2` by `structs.md`'s
	// `error.let-field-assign`.
	assignToImmutableField(fieldName String, line LineNumber, column ColumnNumber)

	// --- The instance-method arms ---
	//
	// A local or a parameter inside an instance method taking the name of a field of the enclosing
	// type — `let count = 5`, or `function bump(count Integer)`, inside a `type Counter` that
	// declares `count`. Renders as **E3006**, whose registry entry already covers this shape ("a
	// local declaration inside an instance method whose name collides with a `self.field`") beside
	// the duplicate-function one; the two are one fact — a name declared twice where exactly one
	// binding is legal.
	//
	// It is a REJECTION rather than a shadow, and the message says why: the field and the local would
	// share one name-keyed entry, so every later read and write in the method would silently resolve
	// to whichever won. Positioned at the COLLIDING declaration, never at the field — the local is
	// what has to be renamed.
	localShadowsSelfField(name String, typeName String, line LineNumber, column ColumnNumber)

	// A read or a write of a field not declared `export`, from outside the type that declares it.
	// Renders as **E3014**. Positioned at the FIELD token — the name that is not accessible — the
	// anchor for the read (`:15:11`) and the write (`:15:4`) alike, and is deliberately NOT
	// `assignToImmutableField`'s root-variable anchor: that one is advice about the BINDING (`var p`),
	// this one is about the field itself.
	unexportedFieldAccess(typeName String, fieldName String, line LineNumber, column ColumnNumber)

	// A token left over where a construct has FINISHED — it opens nothing, continues nothing, and the
	// grammar has no position for it here. Renders as **E2001** `unexpected token: '<got>'`,
	// positioned at the stray token; `got` is always `tokenDisplayText`'s, so the message quotes what
	// the source wrote. It is reached from more than one place, so it is ONE variant with several
	// raisers rather than one variant per raiser — a second variant would be the same code and the
	// same sentence written down twice. Its raisers:
	//
	//   • the `and` of an `and fallthrough` after a match EXPRESSION's `gives` arm — fallthrough is
	//     meaningless where every arm must yield a value, and the Pratt climber has already stopped
	//     at the `and` (see `parseBinary`), so the arm parser meets it as a leftover, not an operator;
	//   • a token past the end of a function SIGNATURE — `function foo() int`, the `returns` keyword
	//     missing — or of an `enum`/`union` HEADER — `enum Colour int` (see `requireDeclarationHeaderLineEnd`);
	//   • a token in STATEMENT position that begins no statement — a bare `foo`, a `retur x` typo, a
	//     `test` that meant `test()` (see `parseStatement`'s fall-through, and the arm above it for the
	//     one shape there that is `unsupported` instead).
	strayToken(got String, line LineNumber, column ColumnNumber)

	// A token at FILE SCOPE where a declaration has to begin — a bare `42`, an `==`, a lone identifier.
	// Renders as **E2001** `Expected function declaration, got '<got>'`, positioned at the token, and
	// `got` is `tokenDisplayText`'s so the message quotes the text the SOURCE wrote rather than the
	// token's category (`identifier`, `integer literal`) which no reader can search the file for.
	//
	// It shares E2001 with `strayToken` and is deliberately NOT the same variant: the code means "the
	// parser met a token that cannot appear at this point in the grammar", which is true of both, but
	// only at file scope is there ONE construct that was legal, so only here can the message name it.
	//
	// ⚠ It is not `unsupported` (E2015) either: that code means "a construct this compiler does not
	// implement YET", and a stray `42` at file scope is malformed syntax that no future feature makes
	// legal — a permanent refusal filed as a pending one.
	expectedDeclaration(got String, line LineNumber, column ColumnNumber)

	// ⭐ **A BLOCK LABEL, A STATEMENT AND A MATCH ARM EACH END THEIR LINE** — `if true 'x' return 1 end 'x'`
	// is refused, which `specs/if-statements.md`'s `single-line-block-rejected` pins. It rides the SAME E2001 as
	// `expectedDeclaration` beside it, for the same reason: a token stood where the layout admits
	// exactly one thing.
	expectedNewlineAfter(construct LineEndingConstruct, got String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **A BARE `try` INSIDE A CLOSURE, WHOSE ENCLOSING FUNCTION IS THE LIFTED CLOSURE ITSELF.** Renders
	// as **E2001** `try without otherwise requires the enclosing function to have 'throws'`, positioned at
	// the `try`.
	//
	// ⚠ **IT IS A SEPARATE VARIANT FROM THE `errorTypeMismatch` SENTENCE THE SAME SITUATION EARNS IN A
	// DECLARED FUNCTION, AND THE DIFFERENCE IS THAT THE OTHER SENTENCE'S REMEDY IS UNWRITABLE HERE.** That
	// one offers *"add 'otherwise' to handle it, or declare 'throws {E}'"* — and a closure CANNOT declare
	// one: a function type is `function(T) returns U` with no throws clause, which is the whole content of
	// **E3101**. Telling an author to write a clause the grammar has no place for is a wrong answer wearing
	// a diagnostic's clothes, so the closure gets the sentence that names the only move it has.
	// `test-uncaught-throw/error.closure-in-a-test-is-not-a-test` pins it byte for byte — that case is what
	// makes the distinction observable, because a closure inside a `test` is the one place where the
	// enclosing body DOES relax and the closure still must not.
	bareTryInAClosure(line LineNumber, column ColumnNumber)

	// ⭐ **A BLOCK'S `end` LABEL DOES NOT REPEAT THE LABEL ITS HEADER OPENED.** Renders as **E2008**,
	// positioned at the `end` — where `match`'s own mismatch is anchored, and for its reason.
	//
	// ⚠ **IT IS NOT `matchMismatchedBlockId`, WHICH IS E2043, AND THE REGISTRY DISTINGUISHES THE TWO IN SO
	// MANY WORDS**: E2008 is *"a block's 'end' label"*, E2043 is *"a match arm's block label"*. Both are raised by
	// `consumeBlockEnd`, which the `EndLabelRule` picks between.
	mismatchedEndLabel(expected String, got String, line LineNumber, column ColumnNumber)

	// A `test` declaration outside a `.maxtest` file. Renders as E2058, positioned at the `test` keyword.
	// It carries both spellings of the file's name because the message names the fix rather than the
	// rule: rename `regular.maxon` to `regular.maxtest`.
	testOutsideTestFile(fileName String, testFileName String, line LineNumber, column ColumnNumber)

	// ⭐ **`test ''`.** Renders as **E2059**, positioned at the empty name literal. The name is the test's
	// whole identity — it is what the reporter prints and what `end ''` must match — so an empty one names
	// nothing, and it is refused at the declaration rather than at the report.
	testEmptyName(line LineNumber, column ColumnNumber)

	// ⭐ **TWO `test` DECLARATIONS IN ONE FILE WHOSE PROSE NAMES SANITIZE ALIKE.** Renders as **E3107**,
	// positioned at the SECOND declaration's name. It names BOTH prose names and the symbol they share,
	// because the collision is invisible in either name alone.
	duplicateTestName(first String, second String, symbol String, line LineNumber, column ColumnNumber)

	// ⭐ **`self` WHERE THERE IS NO INSTANCE — a `static function`, a free function, or a closure inside
	// either.** Renders as **E2001** `'self' can only be used inside instance methods`, positioned at the
	// `self` token (or at the bare self-field name that needs the receiver).
	//
	// ⚠ **IT IS NOT `unsupported`, and that is the whole reason the variant exists.** E2015 means "a
	// construct this compiler does not implement YET" — but `self` outside an instance method is
	// PERMANENTLY illegal: no future change makes it legal, so filing it as pending misdescribes it.
	// `expectedDeclaration` above rests on the same argument.
	//
	// `closure-self/error-self-in-free-function-closure` gates the message byte for byte, for the
	// free-function and the `static function` spellings alike. ONE variant for every context that
	// lacks a receiver, because it is one rule: there is no instance here. The message names no
	// context of its own — a rule that holds in three contexts must not be worded as though it were
	// about one of them.
	selfOutsideInstanceMethod(line LineNumber, column ColumnNumber)

	// --- The `@heap` annotation's own three refusals (see `parseAnnotatedBinding`) ---
	//
	// An `@` followed by any word other than `heap`. Renders as **E2001** `Unknown annotation '@<got>'
	// (expected '@heap')`, positioned at the `@` — the annotation is one construct and the `@` is
	// where it starts. `heap` is the ONLY annotation the language has, so the message can name the
	// whole set; the day a second one lands, this sentence is derived from the roster rather than
	// listing it.
	//
	// `got` is `tokenDisplayText`'s for `strayToken`'s reason — the source's own spelling, so `@1` and `@let`
	// quote what was written rather than a token category no reader can search for.
	unknownAnnotation(got String, line LineNumber, column ColumnNumber)

	// `@heap` on anything that is not a `var`/`let` declaration. Renders as **E2001**, positioned at
	// the `@`. It is the same code as `strayToken` and deliberately not that variant: the grammar HAS
	// a position for whatever follows, it is just not a position `@heap` can decorate — so the message
	// can name the one thing that was legal.
	heapAnnotationWithoutBinding(line LineNumber, column ColumnNumber)

	// ⭐ `@heap` on a binding whose value owns NO heap — `@heap let x = 5`. Renders as **E2001**,
	// positioned at the binding's NAME (anchored `:2:12` on `\t@heap let x = 5`), because the name is
	// what identifies the binding whose initializer has to change.
	//
	// The message names the initializer's TAG (`typeTagName`) rather than asserting what it is not: the refused
	// set is everything `valueIsManagedHeap` declines — an `int`, a `bool`, a `float`, an enum ordinal, a
	// function value — and a single adjective covering all of them would be an overclaim about at least one.
	//
	// ⚠ **THE ADMISSIBLE SET IS `valueIsManagedHeap`'s, NOT "struct literals".** A `String` and a
	// boxed union are heap records exactly as a struct box is, and `@heap let p = Point.create(1, y:
	// 2)` and `@heap let t = (10, 32)` are neither of them literals. The question that can be answered
	// honestly is the one `valueIsManagedHeap` already asks — does this value own a heap record — so
	// this refuses ONLY the values for which no box exists to force. Dropping the check entirely on
	// the ground that `@heap` is a no-op covers the shapes it CAN honour and not the ones it cannot,
	// and silently ignoring an annotation the compiler will never act on is the silent-unhandled-case
	// this codebase refuses everywhere else.
	heapAnnotationOnNonRecord(name String, tag String, line LineNumber, column ColumnNumber)

	// --- The scalar-match arms ---
	//
	// An arm body that both `return`s and falls through (`1 then return 10 and fallthrough`).
	// Renders as **E2025**, positioned at the `and`. The two cannot combine: a `return` has already
	// left the arm, so there is nothing for the fallthrough to carry control out of.
	matchFallthroughWithReturn(line LineNumber, column ColumnNumber)

	// A non-enum match with no `default` arm. Renders as **E2026**, positioned at the closing `end`.
	// `subject` is "match" or "match expression" so one rule phrases the statement and expression
	// forms alike. A scalar match is exhaustive only through a default: the language will not silently
	// do nothing for an unmatched value.
	matchNotExhaustive(subject String, line LineNumber, column ColumnNumber)

	// Two arms test the same single value (`1 then … 1 then …`). Renders as **E2027**, positioned at
	// the duplicate pattern. `pattern` is the pattern AS THE SOURCE SPELLS IT — which for a `bool` arm is
	// not the folded value it compares as (`tokenTextFrom` carries that measurement).
	matchDuplicatePattern(pattern String, line LineNumber, column ColumnNumber)

	// A pattern whose type cannot be compared to the scrutinee's — a `"string"` pattern on an `int`
	// scrutinee, say. Renders as **E2028**, positioned at the pattern. Both type names ride along
	// because the message names both.
	matchPatternTypeMismatch(patternType String, scrutineeType String, line LineNumber, column ColumnNumber)

	// A pattern arm that follows the `default` arm. Renders as **E2029**, positioned at the stray
	// arm's pattern — `default` must be the last case so its catch-all cannot mask a later one.
	matchDefaultNotLast(line LineNumber, column ColumnNumber)

	// A `match <expr>` with no block label after the scrutinee. Renders as **E2042**, positioned at
	// the token where the label belongs (the one just past the scrutinee).
	matchMissingBlockId(line LineNumber, column ColumnNumber)

	// A `match … 'a' … end 'b'` whose closing label does not match the one it opened. Renders as
	// **E2043**, positioned at the `end` (not the wrong label).
	matchMismatchedBlockId(expected String, got String, line LineNumber, column ColumnNumber)

	// A `then` arm body that is a block-opening statement (`if`/`while`/`for`/`match`). Renders as
	// **E2049**, positioned at the opening keyword. Each arm body is a single statement; a
	// block-opener would need a nested scope a single-line arm has no place for.
	matchBlockStatement(keyword String, line LineNumber, column ColumnNumber)

	// --- The enum/union arms ---
	//
	// An enum/union declares one case name twice. Renders as **E3030**, positioned at the second
	// declaration.
	enumDuplicateCase(caseName String, line LineNumber, column ColumnNumber)

	// Two enum/union cases declare the same raw value (`ok = 200 success = 200`). Renders as
	// **E3031**, positioned at the second case. `rawValue` is the value as printed.
	enumDuplicateRawValue(rawValue String, line LineNumber, column ColumnNumber)

	// An enum/union case's raw value has a type other than the enum's declared backing (`ok = 100 fail
	// = 5.0`). Renders as **E3032**, positioned at the offending case. `detail` is the `expected <x>,
	// got <y>` phrasing.
	enumRawValueTypeMismatch(detail String, line LineNumber, column ColumnNumber)

	// A `Color.red` literal, or a match arm, names a case the enum/union does not have. Renders as
	// **E3034**, positioned at the case name. `kindWord` ("enum"/"union") names the CONSTRUCT: a bad
	// case of a `union` reads "unknown union case", matching E2026/E2046 rather than hardcoding
	// "enum".
	enumUnknownCase(kindWord String, caseName String, line LineNumber, column ColumnNumber)

	// ⭐ **`<Enum>.fromName("nope")` — A LITERAL NAME NAMING NO CASE, decided at COMPILE TIME.** Renders as
	// **E3034**, the same code the arm above renders, positioned at the MEMBER token — but with its own
	// sentence, and the difference is not cosmetic: `unknown enum case: 'nope'` describes a place in the
	// program where a case NAME was written, and here what was written is a String ARGUMENT to a lookup. The
	// two are worded apart for that reason and `/specs/constants.md`'s `error.fromName-invalid-case` pins
	// this wording to the character, `typeName` included (the other arm names no type, because a bare case
	// reference is already qualified by one the reader can see).
	//
	// ⚠ **NO SPEC EXERCISES A UNION WITH AN UNKNOWN LITERAL NAME, so nothing pins `kindWord` here.** It says
	// `union` for a union because every OTHER E3034 this compiler emits does (`unknown union case:
	// 'fromRawValue'` is itself pinned by `specs/enum-full.md`), and one compiler contradicting itself about
	// what a union is called is the worse answer.
	enumNoCaseNamed(kindWord String, caseName String, typeName String, line LineNumber, column ColumnNumber)

	// ⭐ **`<Union>.fromName("value")` — a literal name naming a case whose PAYLOAD ARITY the call does not
	// supply.** Renders as **E3036** at the MEMBER token, with the sentence
	// `/specs/enum-full.md`'s `error.fromName-wrong-arg-count` pins.
	//
	// ⚠ **IT COVERS TOO MANY ARGUMENTS AS WELL AS TOO FEW.** One rule, stated once: the arity a case declares
	// is what the call must supply, and `requires 0 associated value(s)` is exactly true of the program in
	// front of the reader. Nothing in `/specs` pins the over-supplied spelling.
	enumFromNamePayloadArity(caseName String, expected PayloadSlotIndex, line LineNumber, column ColumnNumber)

	// ⭐ **`<Union>.allCases` — THE ENUM-ONLY STATIC THAT A UNION IS REFUSED BY NAME, NOT BY THE CASE
	// LOOKUP.** Renders as **E4006**, positioned at the TYPE name. It reads nothing like a mistyped case name
	// because it is a fact about the MEMBER, and it carries NO payload because the sentence names no part of
	// the program.
	//
	// ⚠ **THE TEST IS THE DECLARATION KEYWORD, AND IT IS PAYLOAD-BLIND** — `layout.isUnion`, which does not
	// consult a payload. So a payload-free SCALAR-BACKED union is refused too, and for that one the array
	// could plainly exist — its cases are bare values already.
	// ⇒ **The payload argument** — a union with payloads has no ordinal sequence to enumerate — **is the
	// MOTIVATION for the language's rule and NOT the predicate**, and the two must not be written as one:
	// stating that motivation as though it were the test is exactly how `Project.appendUnionCasesCompanion`'s
	// comment came to claim a route for payload-free unions that does not exist.
	//
	// ⚠ Its sibling `fromRawValue` is deliberately disposed DIFFERENTLY on a union. WHICH disposition, and
	// which pin holds it, is stated once at `parseEnumLiteral` — deliberately not restated here, because a
	// verdict written at three sites is the drift surface this very member's header was repaired for.
	allCasesOnUnion(line LineNumber, column ColumnNumber)

	// A match arm names a case in QUALIFIED form (`Color.red`). Renders as **E3075**, positioned at
	// the type name — the scrutinee's enum is already known, so the bare name suffices.
	matchQualifiedCaseName(bare String, qualified String, line LineNumber, column ColumnNumber)

	// A payload binding list in which EVERY binding is the discard `_` (`value(_)`, `two(_, _)`).
	// Renders as **E3081**, positioned at the ARM's case name. Such a list is exactly equivalent to
	// omitting it, so the bare case name says the same thing and says it once; a PARTIAL discard
	// (`two(_, b)`) binds something and stays legal. `discardList` is the list spelled back as written
	// (one `_` per slot, `, `-joined), built at the throw site exactly as `enumMatchNotExhaustive`'s
	// `missing` is.
	matchDiscardedBindings(caseName String, discardList String, line LineNumber, column ColumnNumber)

	// A `default` arm on an ENUM match that is not `default throws`/`default panic`. Renders as
	// **E2046**, positioned at the `default` — an enum match is exhaustive by listing every case, so
	// a plain catch-all is forbidden (it would silently mask a case added later). `kindWord` is
	// "enum" or "union"; `typeName` the enum's name.
	matchDefaultEnumMustThrow(kindWord String, typeName String, line LineNumber, column ColumnNumber)

	// An enum/union match does not cover every case and has no `default throws`. Renders as **E2026**,
	// positioned at the closing `end`. `missing` is the comma-joined names of the uncovered cases, in
	// declaration order — the enum twin of `matchNotExhaustive`.
	enumMatchNotExhaustive(kindWord String, typeName String, missing String, line LineNumber, column ColumnNumber)

	// --- The SYNTHESIZED ERROR UNION's five diagnostics (a block-form `try` whose body routes two or more
	// distinct error enums). Every one of them names the MEMBER the author wrote rather than the synthesized
	// layout, which is why each is its own arm and not a `typeName` handed to its enum-match sibling above.
	//
	// The union's `match` does not cover every `(member, case)` pair and has no `default throws`/`panic`.
	// Renders as **E2026**, positioned at the closing `end`, with `missing` the qualified `Enum.case` names in
	// member-then-declaration order. Both references emit this code with this sentence.
	errorUnionMatchNotExhaustive(missing String, line LineNumber, column ColumnNumber)

	// A PLAIN `default then …` in a union's match. Renders as **E2046** at the `default`, the same code its
	// enum sibling uses: a catch-all would silently swallow an error variant added to any member later, so
	// only `default throws` / `default panic` opt out.
	errorUnionMatchDefaultMustThrow(line LineNumber, column ColumnNumber)

	// A BARE case name declared by two or more members of the union. Renders as **E3085** at the case name;
	// the fix is the qualified spelling, which the message states.
	errorUnionAmbiguousBareCase(caseName String, line LineNumber, column ColumnNumber)

	// A BARE case name no member of the union declares. Renders as **E3034** at the case name — the same code
	// `enumUnknownCase` renders, with the sentence the union can spell (there is no ONE enum to name).
	//
	// ⚠ **E3034 HAS THREE RENDERINGS IN AN ERROR-UNION MATCH AND ONLY TWO OF THEM ARE ARMS HERE.** The third
	// is a QUALIFIER that names a real member which has no such case (`ErrA.nope`): that one goes through the
	// GENERIC `enumUnknownCase` arm, carrying the member's own kind word and a hand-built `"Member.case"`
	// name, because at that point there IS one enum to name and its own sentence is the right one.
	errorUnionUnknownCase(caseName String, line LineNumber, column ColumnNumber)

	// A QUALIFIER naming a type that is not a member of this union at all — `ErrC.x` where the body
	// routed only `ErrA` and `ErrB`. Renders as **E3034** at the qualifier, distinct from the
	// case-name arm above because the author's mistake is a different one.
	errorUnionUnknownMember(memberName String, line LineNumber, column ColumnNumber)

	// A payload ARGUMENT's `name:` label naming no payload of the case it constructs. Renders as **E3144**
	// at the label. It is not `unknownField`: a payload is a positional slot of ONE CASE, so a message
	// calling it a field of the union names a thing the program does not have and points the fix at the
	// wrong declaration.
	unknownPayloadName(unionName String, caseName String, payloadName String, line LineNumber, column ColumnNumber)

	// A payload pattern supplying the wrong number of bindings for a case. Renders as **E3035**, positioned
	// at the CASE name (past any qualifier). `caseName` is `Enum.case` for a synthesized error union's member,
	// where the qualifier is what tells two members' identically-named cases apart, and the bare case name for
	// an ordinary `union`, where the arm names nothing else.
	//
	// ⚠ **BOTH ARITY DIRECTIONS COME HERE rather than the too-many one being `unsupported` (E2015).**
	// That band says the COMPILER cannot do this; a pattern that binds two payloads out of a one-payload
	// case is simply a wrong program, and one code is what a reader greps for it by in either direction.
	enumWrongBindingCount(caseName String, expected PayloadSlotIndex, got ElementIndex, line LineNumber, column ColumnNumber)

	// **E3129** — a match arm whose payload binding cannot be honoured. `reason` carries the whole
	// explanation and that shape's cure, because the shapes refused share only their SUBJECT (this arm's
	// bindings) and not their argument: two are about the arm's own binding list being a bijection (one name
	// per slot, one slot per name), two are about what a covered case holds in a bound slot, and one is an
	// error-union arm naming several error types. A single lead-in general enough to cover them all would say
	// nothing, so `Queries` renders the name and defers. Positioned at the binding the author must rename, move
	// or drop. See
	// `requireArmBindingsAreDistinct` and `requireOrArmPayloadSlotsAgree`.
	matchArmPayloadBindingConflict(bindingName String, reason String, line LineNumber, column ColumnNumber)

	// **E3084** — a block-form `try`'s `otherwise (e) 'h' … end` handler that never `match`es on its
	// binding. Positioned at the handler's block LABEL. The handler is reached by EVERY routed edge,
	// so one that never discriminates has silently swallowed every error the body can raise; the
	// single-call `otherwise` forms catch one call's error and owe no such proof.
	tryBlockBindingNotMatched(bindingName String, line LineNumber, column ColumnNumber)

	// **E3161** — a handler over a combined error with a boxed member whose `(e)` is not matched exactly once on
	// every path: matched twice, matched inside a loop the handler opened, matched on some paths into a join and
	// not others, or left unmatched by a path out of the handler. `reason` names which. Positioned at the second
	// match, the looping match, the join or the exit.
	errorMatchNotExactlyOnce(bindingName String, reason String, line LineNumber, column ColumnNumber)

	// Two arms cover the same enum case — a bare name repeated, or a case covered by both a range and
	// a later arm. Renders as **E2027**, positioned at the second (overlapping) arm.
	matchOverlappingCase(caseName String, line LineNumber, column ColumnNumber)

	// A match arm over an enum, union or error union writes a RANGE of cases. Renders as **E3146**,
	// positioned at the arm's first token. `pattern` is the range AS THE SOURCE SPELLS IT — one
	// `tokenTextFrom` span, which is what keeps the two compilers from drifting on the words.
	//
	// Thrown the moment `to`/`upto` is seen, BEFORE the upper bound resolves, so `red to nope` is this
	// rather than `enumUnknownCase`: the range is the mistake whichever name follows it.
	matchEnumCaseRange(pattern String, line LineNumber, column ColumnNumber)

	// A match arm's `or`-chain packs two alternatives onto one line. Renders as **E3147**, positioned at
	// the token standing where the newline belongs. One alternative per line is what keeps an arm
	// readable now that it names its cases rather than ranging over them — an arm may cover twenty.
	matchOrChainNeedsOwnLine(line LineNumber, column ColumnNumber)

	// A SCALAR range covering exactly ONE value — `5 to 5`, `5 upto 6`, `'a' to 'a'`, `'a' upto 'b'`.
	// Renders as **E2027**, positioned at the range's LOWER bound.
	// `pattern` is the whole range AS THE SOURCE SPELLS IT, bounds and keyword alike — one
	// `tokenTextFrom` span (`requireRangeIsMultiValued` carries the rule).
	matchSingleValueRange(pattern String, line LineNumber, column ColumnNumber)

	// A `union` value is compared with `==`/`!=`. Renders as **E3066**, positioned at the operator.
	// A union carries no synthesized equality — `Container.value(1) == Container.value(1)` would
	// compare two BOX ADDRESSES, reference equality answering a question about values, the exact
	// hazard `comparableOperands` already refuses for two structs. An ENUM is unaffected (its value
	// IS its i64 tag, so `==` is a real tag compare); only `isUnion` triggers this. `op` is the
	// operator's spelling (`==`/`!=`) for the message.
	unionNotComparable(op String, line LineNumber, column ColumnNumber)

	// Two values held at an INTERFACE type are compared. Renders as **E3005**, positioned at the operator.
	// An existential erases the dynamic type, so `c == other` carried no way to compare the VALUES and
	// lowered to a compare of the two fat pointers' value halves — measured answering `7 == 7` FALSE, and
	// flipping `a > b` when the two allocations were reordered. `op` is the operator's spelling, from the
	// same `comparisonOpSpelling` the union arm reads, so every form is named rather than only the two the
	// corpus happens to exercise.
	existentialNotComparable(op String, line LineNumber, column ColumnNumber)

	genericInstanceNotComparable(op String, typeName String, orderingOp bool, line LineNumber, column ColumnNumber)

	// ORDERING (`<`/`>`/`<=`/`>=`) is applied to two `String`s. Renders as **E3005**, positioned at the
	// operator. `op` is the operator's spelling, from the same `comparisonOpSpelling` the two arms above read.
	//
	// ⭐ **IT HAS ITS OWN REASON RATHER THAN A MISMATCH MESSAGE, FOR `existentialNotComparable`'s REASON**
	// — this pair AGREES perfectly and the OPERATION is what has no meaning, so *"cannot compare String
	// with String"* would tell the author their two types disagreed with themselves.
	// `stdlib/String.maxon:49` declares no `Comparable` where
	// `stdlib/Character.maxon:19` does, and that is the fact the message states.

	// An operand of `is` / `is not` has no OBJECT IDENTITY — an `int`, a `float`, a `bool`, a `byte`, an enum
	// case, an opaque type parameter, an existential. Renders as **E3068**, positioned at the `is`. `op` is the
	// operator's spelling (`referenceIdentityOpSpelling`), so the negated form names itself.
	//
	// ⭐ It is a REFUSAL and not a fallback to `==`, and that is the point of the operator: identity
	// and equality are the same answer for a primitive and different answers for everything else, so
	// silently giving one where the other was asked for would make `is` mean two things.
	// `specs/reference-identity.md`'s `primitive-error` pins the sentence.
	refIdentityOnPrimitive(op String, line LineNumber, column ColumnNumber)

	// The two operands of `is` / `is not` have object identities of DIFFERENT types — `p is s`, or one `Array`
	// instance against another. Renders as **E3005**, positioned at the operator, naming both types the way the
	// author wrote them (`displayTypeNameOf`).
	//
	// ⚠ **IT IS A SEPARATE ARM FROM `refIdentityOnPrimitive` BECAUSE THE TWO SAY DIFFERENT THINGS, and
	// it is not a redundant one: without it the pair would reach the pointer compare and answer
	// `false` for a question that has no answer.** `specs/reference-identity.md` states it as its own
	// rule ("Both operands must be the same type").
	refIdentityTypeMismatch(op String, left String, right String, line LineNumber, column ColumnNumber)

	// --- The reserved-name arm ---
	//
	// A user DECLARATION whose name starts with `__` — the prefix Maxon reserves for compiler
	// internals (`__mm_alloc`, `__print_string`, `__destruct_String`, the `__discard_*` temporaries).
	// Renders as **E2051**, positioned at the declared name. Raised by `requireUnreservedName` at every
	// binding site — see there for why one call cannot be traded for eight copies of the check, and for
	// what this reservation does and does not buy the readers that ask "is this callee the compiler's own?"
	// (`MmRuntime.isSignaturelessCompilerCallee`). `name` is the offending identifier, for the message.
	reservedIdentifier(name String, line LineNumber, column ColumnNumber)

	// A user declaration BINDING THE FAULT PROBE'S NAME — `maxon_force_segfault`, the entry point
	// `__Builtins.forceSegfault()` lowers to and the frame name its backtrace prints. Renders as **E2051**
	// too, positioned at the declared name, and raised by `requireFreeFunctionNameIsNotTheFaultProbe` — a
	// SIBLING door rather than an arm of `requireUnreservedName`, because it governs ONE name space where that
	// one governs every binding site there is.
	//
	// ⭐ It is `reservedIdentifier`'s SIBLING for `reservedReceiverName`'s reason — one CODE, because a user
	// declaration may not take the name; separate MESSAGES, because what is reserved and why differs. This
	// one is the only compiler-owned FUNCTION symbol wearing no reserved prefix, so the shape rule cannot
	// reach it (`MmRuntime.ReservedCalleeReason.faultProbeEntry` is the call door's half of the same fact).
	//
	// ⛔ **WITHOUT IT THE COMPILER'S OWN SYMBOL IS RENAMED OUT FROM UNDER ITS CALL, SILENTLY.** A second
	// FREE FUNCTION of the bare name makes it CONTESTED across directories, and `declaredMethodName` then files
	// the runtime tier's declaration as `runtime.maxon_force_segfault` — leaving the bare call the compiler
	// emits bound to the program's own function, which does not fault. `specs/safety.md`'s
	// `error.force-segfault-name-is-reserved` is the case.
	//
	// It carries NO payload for `reservedReceiverName`'s reason: there is exactly one word this refuses.
	reservedFaultProbeName(line LineNumber, column ColumnNumber)

	// A user declaration BINDING THE NAME `self` — a parameter, a local, a field, a function, a type.
	// Renders as **E2051** too, positioned at the declared name, and raised by the same
	// `requireUnreservedName` at the same binding sites.
	//
	// ⭐ It is `reservedIdentifier`'s SIBLING rather than an arm of it, and the split is the same one
	// `integerOverflow`/`floatLiteralOverflow` make: the two share a CODE because a user declaration may
	// not take either name, and they must not share a MESSAGE, because what is reserved and WHY differs —
	// `__` is the space the compiler emits its own symbols into, `self` is the implicit instance receiver
	// a binding of the name would shadow.
	//
	// It carries NO payload because the sentence names no part of the program: there is exactly one
	// word this refuses, and the message spells it. `specs/reserved-self.md` pins the text.
	reservedReceiverName(line LineNumber, column ColumnNumber)

	// A user declaration giving a NOMINAL type identity to a name the COMPILER owns — `type Ordering`,
	// `enum HashValue`, a `function`/`Base with Args` typealias over either (`Ordering`, `HashValue`,
	// `ExitCode`; see `TypeResolution.isCompilerOwnedTypeName` for the coupling and the measured fault it
	// closes, and `requireTypeNameNotCompilerOwned` for why a RANGED typealias is legal). Renders as
	// **E2015**, positioned at the declared name. It is `reservedIdentifier`'s sibling: the same "a user
	// declaration may not take this name" rule over a different name set. `name` is the offending type
	// name, for the message.
	declarationTakesCompilerOwnedTypeName(name String, line LineNumber, column ColumnNumber)

	// --- The scalar-error arms ---
	//
	// An `otherwise` handler with no `try` expression to attach to — `let v = mayFail() otherwise 0`.
	// Renders as **E3058**, positioned at the stray `otherwise`. It is a PARSE error and not a
	// SemanticCheck one because a bare `otherwise` builds no IR to inspect: the parser reaches it as an
	// unexpected token after a complete expression, and only the parser knows there was no `try`.
	otherwiseWithoutTry(line LineNumber, column ColumnNumber)

	// An error-handling TYPE MISMATCH at a `try … otherwise …`. Renders as **E3059**, ONE code with
	// three message variants (all built by `parseErrorDiagnostic` as `type mismatch: '<detail>'`): an
	// `otherwise` value whose type differs from the try's success type; an `otherwise ignore` used in
	// value position; or a value-position `try` on a VOID callee. `detail` is the inner message.
	// Parse-time because each is a fact about the `otherwise` syntax and the assignment context, which
	// only the parser sees.
	errorTypeMismatch(detail String, line LineNumber, column ColumnNumber)

	// A BLOCK-FORM `try` inside a `match` arm — a `try 'label' … end` (grouping multiple calls) or a
	// block-handler `otherwise 'label' … end` — where an arm body must be a single statement. Renders as
	// **E2049** (the same code `matchBlockStatement` reports for `if`/`while`/… arm bodies), positioned at
	// the block label. `isOtherwiseForm` picks the message: the grouped-`try` form or the block-`otherwise`
	// form (both name the single-statement alternatives the arm can use instead).
	tryBlockFormInMatchArm(isOtherwiseForm bool, line LineNumber, column ColumnNumber)

	// A block-form `try 'label' … end 'label'` whose body holds no throwing call. Renders as
	// **E3083**, positioned at the `try`. The construct exists to funnel several throwing calls into
	// ONE handler, so a body that can never fail leaves that handler unreachable — and the author has
	// either mis-spelled the call or does not need the construct. `label` names the block.
	tryBlockNoThrows(label String, line LineNumber, column ColumnNumber)

	// A block-form `try` with no `otherwise (e) 'label' … end` handler after its `end`. Renders as
	// **E2050**, ONE code with two messages — `missingBinding` picks them: the handler is ABSENT
	// (positioned at the `try`), or it is present but declares no `(e)` binding (positioned where the
	// binding should have been). A block form with no handler has nothing for a routed error to reach;
	// one with no binding has no name to `match` on, which is the handler's whole job.
	tryBlockMissingOtherwise(missingBinding bool, line LineNumber, column ColumnNumber)

	// A `try` applied to a call that cannot throw — `try noFail()`. Renders as **E3055**, positioned
	// at the `try` token. It is a PARSE error (not SemanticCheck's, where its throws-band siblings
	// E3054/E3057 live) for a positional reason: it is gated byte-for-byte at the `try` keyword, and
	// only the parser holds that token — the emitted `tryCall` op's span anchors on the callee, and
	// the append-only span table cannot be retargeted after the fact. `callee` names the non-throwing
	// function.
	tryOnNonThrowing(callee String, line LineNumber, column ColumnNumber)

	// **E3124** — `if try f()` on a call that PRODUCES a value. The bare form is a THROW test, not a value
	// test, so a result it produces is dropped while the source reads as though it were what is being tested:
	// `if try json.getBool(node, key: "enabled")` reads as *"if enabled"* and means *"if the key exists and is
	// a bool"*, which is true when the value is `false`. MEASURED before this refusal existed — a throwing
	// `answer(succeed bool) returns bool` whose SUCCESS path returned `false` still took the branch.
	// Positioned at the `try` token, beside its E3055 sibling, and raised only AFTER it: a callee that cannot
	// throw at all is that mistake, not this one, whatever it returns. `callee` is `tryTargetNoun`'s answer,
	// so a witness dispatch and a builtin each blame the spelling the author actually wrote.
	ifTryDiscardsResult(callee String, line LineNumber, column ColumnNumber)

	// **E3087** — an `if x.contains(k)` whose then-block reads `try x.get(k)` on the same receiver and key.
	// It carries the whole sentence rather than its parts because the sentence quotes SOURCE SPELLINGS (the
	// receiver's access path, the key's, the receiver type's name) that only the parser holds; see
	// `Parser.requireNoRedundantContainsGet` for why the check lives there at all.
	redundantContainsGet(message String, line LineNumber, column ColumnNumber)

	// A `try` applied to a BUILTIN call that cannot throw — `try arr.count()`, `try print("x")`,
	// `try s.append(t)`, `try arr.push(1)`. Renders as **E3055** at the `try` token, exactly as its
	// user-function sibling above does; it is a second MESSAGE on one code, the same way `errorTypeMismatch`
	// carries three. It names NO callee on purpose: what the parser holds here is the emitted runtime symbol
	// (`__managed_count`), which the user never wrote and which the `__` reservation exists to keep out of user
	// space — the same reason `SemanticCheck`'s mirror E3057 for a bare throwing accessor describes the CLASS
	// instead of naming the symbol.
	tryOnNonThrowingBuiltin(line LineNumber, column ColumnNumber)

	// A `try` applied to a division the compiler made TOTAL — today only a `mod` over a divisor proven
	// non-zero but possibly `-1`, which is expanded into an overflow guard that answers `0` and raises
	// nothing. Renders as **E3055** at the `try` token, a THIRD message on that code beside the two above.
	//
	// ⚠ **IT EXISTS BECAUSE THAT `mod` IS A CALL, AND THE BUILTIN SENTENCE WOULD BE A DOWNGRADE.**
	// `try (a mod -1)` reaches the check above as a `__guarded_mod` call and would be told *"this builtin
	// call cannot fail"* about an operator the author wrote themselves. Naming the DIVISION rather than
	// the symbol keeps the emitted name out (`tryOnNonThrowingBuiltin`'s whole reason) while still
	// answering the question actually asked.
	tryOnTotalDivision(operator String, line LineNumber, column ColumnNumber)
	tryOnProvenFixedArrayAccess(accessor String, count FixedElementCount, line LineNumber, column ColumnNumber)
	fixedArrayIndexPastTheSize(value FullRangeInt, count FixedElementCount, line LineNumber, column ColumnNumber)

	// A plain `await p` of a promise whose thunk THROWS — `await` lowers to `__gt_await`, which drops the
	// error flag. Renders as **E3057** (the throwing-call-needs-`try` code SemanticCheck reports
	// for an ordinary throwing call), positioned at the `await` token. It is a PARSE error because only the
	// parser holds the promise → awaited-callee mapping (the promise mark and the defining `asyncCall` are
	// per-function parse state).
	//
	// ⚠ **`errorType` NAMES THE ERROR, NOT THE CALLEE, AND THE DIFFERENCE IS THE POINT.** What the author has
	// to act on is the type they must now catch — an `otherwise (e)` binds an `e` of exactly this type — and
	// the callee's name is already visible on the line the diagnostic points at. `specs/async-await.md`'s
	// `error.await-without-try` states it: the error is OWNED and an associated-value payload is released by
	// nobody, so the message says which type leaks rather than which function produced it.
	awaitThrowingPromiseNeedsTry(errorType String, line LineNumber, column ColumnNumber)

	// `await x` where `x` is not a promise from an `async` spawn. Renders as **E3005** (the type-mismatch
	// code), positioned at the `await` token: this is an operand of the wrong TYPE at a position that states
	// exactly which type it requires, which is what E3005 is for. E2015 ("a construct this compiler
	// does not implement yet") would be the wrong sentence — awaiting a non-promise is not a feature
	// awaiting implementation, it is permanently meaningless. `got` is the operand's display type name.
	awaitNonPromise(got String, line LineNumber, column ColumnNumber)

	// ⭐ A SPAWN STORED IN A `Promise` TYPE THAT DESCRIBES A DIFFERENT PROMISE. Renders as
	// **E3098**, positioned at the storing method's token. It carries a FULL SENTENCE rather than the three
	// facts, because the family's four members share only their code: the erased-error one has to name the
	// two-parameter type that fixes it, the wrong-error and non-throwing ones compare two error types, and
	// the wrong-result one compares two result types. Composed by `promiseStorageMismatch`, which is the one
	// place that holds all four wordings and so the one place they can be read against each other.
	promiseStorageMismatch(detail String, line LineNumber, column ColumnNumber)

	// A bare `try f()` / `try await p` (PROPAGATE form) whose propagated error type differs from the
	// enclosing function's `throws` type. Renders as **E3059**,
	// positioned at the `try` token. Without `otherwise`, the caught flag is re-published verbatim into the
	// enclosing function's error register, so the caller would decode one enum's ordinals as another's tags —
	// a silent miscompile a boxed union turns into a wild free. `propagated` is the callee's error type,
	// `enclosing` the function's.
	propagateTypeMismatch(propagated String, enclosing String, line LineNumber, column ColumnNumber)

	// A `throw <e>` (or a match `default throws <e>`) whose value is not an error enum or union at all —
	// `throw 1`. Renders as **E3005**, positioned at the `throw`/`throws` keyword,
	// carrying the runnable oracle's sentence VERBATIM (`2-Parser.ParseThrow`'s "throw requires an error enum
	// value", which has always refused this while the compiler compiled it into a flag nothing could decode). E3005 and
	// not E3059 because the mistake is not that one error type does not fit another — it is that the value is
	// not an error at all, which is the plain type mismatch its sibling `throwsClause` is the arm for.
	thrownValueNotAnErrorEnum(line LineNumber, column ColumnNumber)

	// ⭐ A COMPILER-OWNED CALLEE written in source that names no function the program has.
	// Renders as **E3004** — the SAME code `SemanticCheck.validateCall` gives `undeclaredThing()` — because it
	// is the same fact: the call names a function that does not exist. `__whatever()` and `whatever()` are one
	// mistake and must not answer with two codes.
	//
	// ⚠ **IT CARRIES THE `reason` BECAUSE THE FAMILY HAS TWO CLAUSES AND THE SENTENCE MUST SAY WHICH.**
	// `MmRuntime.reservedCalleeReasonOf` says which — the reserved `__` prefix, or a synthesized
	// builtin-conformance impl, which wears no prefix at all. The name still says `Intrinsic` because that is
	// what both clauses mean to the author: a symbol the compiler owns and no file may declare.
	//
	// It is a PARSE error, and that is the one thing about it that needs a reason, because the compiler deliberately
	// moved "undefined function" OUT of the parser: a plain callee may be declared in another FILE, and only
	// the whole-program registry can see that. The parser HAS that registry — `ProgramSignatures`, swept from
	// every file's tokens before any file is parsed — so for this family it decides completely, and it is also
	// the only tier that knows the name came from SOURCE rather than from the compiler's own
	// `emitRuntimeCall`. SemanticCheck cannot tell those two apart, which is precisely why its early return
	// let this class of program through to the backend (see `requireCalleeIsNotReservedName`).
	unknownCompilerIntrinsic(callee String, reason ReservedCalleeReason, line LineNumber, column ColumnNumber)
	undefinedQualifiedFunction(callee String, qualifier String, line LineNumber, column ColumnNumber)

	// ⭐ A RESERVED NAME IN *VALUE* POSITION — `let f = __parallel_boundary`. Renders as **E3155**, the
	// value-position half of the rule `unknownCompilerIntrinsic` states for a CALL, and it carries the same
	// `reason` so both halves explain a refusal from the one classifier. A separate code rather than its
	// sibling's E3004 because E3004's subject is a CALL and there is none here; the registry entry argues it.
	reservedNameAsFunctionValue(name String, reason ReservedCalleeReason, line LineNumber, column ColumnNumber)

	// ⭐ A `__Raw.*` INTRINSIC CALLED FROM OUTSIDE `runtime/`. Renders as **E3152**, positioned at the same
	// anchor its E3004 sibling above uses — the MEMBER name, which is where a qualified call's anchor token
	// stands.
	//
	// ⚠ It is deliberately NOT the "undefined function" sentence: `__Raw.osTickCountMs` IS defined, and
	// telling this author no such function exists would send them looking for a typo instead of for the
	// rule. An UNLISTED `__Raw` member is the other fact and keeps the sibling arm, whichever file calls it.
	rawIntrinsicOutsideRuntimeTier(callee String, line LineNumber, column ColumnNumber)

	rawSurfaceOutsideLibraryTier(door RawSurfaceDoor, line LineNumber, column ColumnNumber)

	// ⭐ A runtime body spelling BOTH frame directives — `__Raw.ownFrame()` and
	// `__Raw.splicedAtEverySite()`. Renders as **E3157**, positioned at the second of the two, which is the
	// one that has to go.
	contradictoryFrameDirectives(line LineNumber, column ColumnNumber)

	// A call on a bare generic base the enclosing scope does not bind. Renders as **E3162**, positioned at the
	// callee's name; the sentence is `bareGenericSubjectRefusal`'s.
	bareGenericSubjectUnbound(message String, line LineNumber, column ColumnNumber)

	// ⭐ A MANAGED value NAMED in a `runtime/` source file. Renders as **E3153**, positioned at the binding's
	// own name: the reference-counting pass would emit `__mm_incref`/`__mm_decref` into the very tier that
	// DEFINES them. At the name, so the legality of a runtime file never turns on which optimizations
	// happened to elide its retains.
	managedValueInRuntimeSource(name String, typeName String, line LineNumber, column ColumnNumber)

	// ⭐ A `runtime/` declaration marked `export` (global) or
	// `public`. Renders as **E3154**, positioned at the keyword, which the payload names.
	wideVisibilityInRuntimeSource(keyword VisibilityModifierWord, line LineNumber, column ColumnNumber)

	// ⭐ A MANAGED type SPELLED in a `runtime/` source file — a field, a return, a parameter, a cast target.
	// Renders as **E3153**, positioned at the type name. Its `managedValueInRuntimeSource` sibling answers for
	// a value whose type the author never wrote.
	managedTypeInRuntimeSource(typeName String, line LineNumber, column ColumnNumber)

	// ⭐⭐ A MANAGED value BUILT in a `runtime/` source file, whatever bound it. Renders as **E3153**,
	// positioned at the construct that produced the value. This is the arm that answers for every door its
	// two siblings above cannot see — a `for` binding, a closure cell, a caught error, a `match` payload, an
	// unnamed temporary — because it is raised off the value columns rather than off a binding form.
	managedValueBuiltInRuntimeSource(typeName String, line LineNumber, column ColumnNumber)

	// ⭐ `resize` on an array whose element is MANAGED. Renders as **E3106**, positioned at the method
	// name. `__managed_resize` grows by publishing a longer length over slots `__managed_grow` left zeroed, and
	// a zero is an ELEMENT only while the element lives inline in the buffer; a managed element lives
	// there as a POINTER, so those slots are NULL. Maxon has no default constructor, so there is nothing
	// correct to put in them — the array that comes back answers `count()` = N while `get(0)` reports
	// the slot empty. `elementType` names the element, which is the whole point of refusing HERE: the
	// runtime cannot name it and the caller cannot see it.
	arrayResizeManagedElement(elementType String, line LineNumber, column ColumnNumber)
	zeroOutsideElement(refusal ZeroElementRefusal, subject ZeroElementSubject, line LineNumber, column ColumnNumber)
	literalsShareNoIntegerType(negativeValue FullRangeInt, unsignedPattern FullRangeInt, line LineNumber, column ColumnNumber)

	// ⭐ THE BUFFER SURFACE'S `set` ON A MANAGED ELEMENT — `arr.managed.set(i, value: x)` where the element
	// is a `String`/struct/container/boxed union. Renders as **E3109**, positioned at the method token and
	// naming the element. The sibling of the arm above, and refused for the MIRROR of its reason: `resize`
	// exposes a slot with NOTHING in it, while this one puts something in a slot NOTHING OWNS. The buffer
	// `set` is bounded by CAPACITY (the 2026-07-30 ruling), so it reaches `[length, capacity)` — which is
	// the stage-then-publish region, and which carries no ownership. See the registry entry for why this is
	// a refusal rather than a fix, and `ManagedMemoryRuntime.ManagedMemSetName` for the five operations whose reliance
	// on `[length, capacity)` reading ZERO is what makes the alternative expensive.
	bufferSetManagedElement(elementType String, line LineNumber, column ColumnNumber)

	// ⭐ RAW BYTE ACCESS — `arr.managed.setByte(o, value:)` / `arr.managed.byteAt(o)` — on a MANAGED element.
	// Renders as **E3110**, positioned at the method token, naming both the MEMBER (the two share a message,
	// so it must say which one was written) and the element. ⚠ **A DIFFERENT REASON FROM THE ARM ABOVE, AND
	// THE TWO MUST NOT BE COLLAPSED even though one predicate answers both**: `set`'s is about OWNERSHIP of a
	// staged element and therefore has a harmless half; this one is about the element's REPRESENTATION — a
	// managed element is a POINTER, so these members address the bytes of an ADDRESS at EVERY offset,
	// published or not. There is no bound that rescues it and no other spelling that does the same thing.
	bufferByteAccessManagedElement(member String, elementType String, line LineNumber, column ColumnNumber)

	// ⭐ A LABELLED CONTROL-FLOW BLOCK WITH NO STATEMENTS IN IT — `if c 'x' end 'x'`, and the same for
	// `else`, `while`, `for` and a block-form `otherwise` handler. Renders as **E3082**, positioned at
	// the closing `end` (which is where the missing statements would have gone) and naming the block's
	// LABEL. A function body is deliberately exempt — `function doNothing() end 'doNothing'` is legal —
	// which falls out of where the check lives: `parseBlockBody` parses every NESTED block and nothing
	// else. `label` is the block's own label, taken from its opening token rather than from the `end`'s
	// optional one, so a block closed by a bare `end` still names itself.
	emptyBlock(label String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **A STATEMENT WRITTEN AFTER A TERMINATOR IN THE SAME STRAIGHT-LINE BLOCK** — `return`, `throw`,
	// `panic(…)`, `break` or `continue`, and then another statement before the block's `end`. Renders as
	// **E3071**, positioned at the FIRST unreachable statement and naming the keyword control left through.
	// `terminator` is that keyword's own source bytes, so the sentence quotes what the author wrote rather
	// than a spelling chosen at the report site.
	//
	// ⭐ **IN the compiler THIS IS A CORRECTNESS REFUSAL AND NOT ONLY A LINT**, which is why it unwinds the
	// parse rather than being a lint anything could choose to ignore. A block's terminator lives in a SLOT
	// (`IrBlock.terminator`) that `IrModule.setTerminator` overwrites; an accepted statement that terminates
	// the block ITSELF — an `if`, a `while`, a `for`, a `match` — therefore REPLACES the `ret`/`br` already
	// standing there, and the earlier one is gone. MEASURED without this arm: `return false` followed
	// by an `if` answered `true`, and a `break` followed by an `if` ran its loop to completion, both emitting
	// a binary byte-identical to the same program with the terminator deleted.
	unreachableCode(terminator String, line LineNumber, column ColumnNumber)

	// --- The DECLARATION-SITE typealias arms ---
	//
	// ⭐ A BARE SIZED TYPE AS A TYPEALIAS RHS — `typealias Integer = i64`. Renders as **E2003**,
	// positioned at the RHS name. It is refused rather than accepted because a sized name carries a
	// WIDTH and no RANGE, and every reader the compiler has asks a ranged alias for its bounds — so the
	// shorthand would mint a type whose narrowing check has nothing to check against. The message
	// carries its own remedy, which is why this is not the generic `unsupported`: the fix is one
	// rewrite of the same line, and naming it is the whole value of the diagnostic.
	//
	// ⚠ The suggested form says `int(...)` for a FLOAT name too (`f64` suggests `int(f64.min to
	// f64.max)`). That reads oddly, and the specs compare stderr exactly, so it is transcribed and not
	// improved.
	bareSizedTypeAlias(typeName String, line LineNumber, column ColumnNumber)

	typealiasCycle(aliasName String, line LineNumber, column ColumnNumber)

	typealiasOverANonRangedName(parentName String, line LineNumber, column ColumnNumber)

	implementsRangeDoesNotFit(aliasName String, parentName String, line LineNumber, column ColumnNumber)

	implementsPrimitiveDiffers(aliasName String, parentName String, own String, parents String, line LineNumber, column ColumnNumber)

	genericTypeParameterNotInferable(paramName String, functionName String, line LineNumber, column ColumnNumber)

	genericArgumentsHaveNoCommonType(functionName String, paramName String, first String, firstNote String, second String, secondNote String, line LineNumber, column ColumnNumber)

	genericConstraintNotSatisfied(typeName String, interfaceName String, paramName String, functionName String, line LineNumber, column ColumnNumber)

	genericArgumentKindUnsupported(functionName String, paramName String, typeName String, line LineNumber, column ColumnNumber)

	genericTypeGrowsWithoutBound(ownerName String, fieldName String, typeName String, line LineNumber, column ColumnNumber)

	// ⭐ **`bits(n)` WITH A WIDTH THE LANGUAGE DOES NOT HAVE.** Renders as **E3146**, positioned at the
	// width. The legal set is `isLegalBitWidth`'s, and the message names it, because the rule is not
	// guessable from the refusal alone.
	illegalBitWidth(width FullRangeInt, line LineNumber, column ColumnNumber)

	// ⭐⭐ **A BARE `int`/`float` IN A TYPE POSITION — `function f(x int)`, `returns float`, `var v as int`.**
	// Renders as **E3005**, positioned at the keyword. The rule is the ranged-typealias rule reaching every
	// type position instead of only the one (`Base with Args`, E2061) that already had it: a numeric domain
	// must be DECLARED, so the keyword is legal only as the RHS of a `typealias`.
	//
	// ⚠ **THE TEXT IS TRANSCRIBED RATHER THAN IMPROVED**, because the specs compare stderr byte for
	// byte. `docs/LANGUAGE_REFERENCE.md:438` states the rule.
	//
	// ⚠ **`bool` AND `cstring` ARE DELIBERATELY ADMITTED, and it is the same reason E2061 admits `bool`:**
	// they are already constrained types with no range to name. `String` and `Character` never reach here.
	//
	// the compiler's set is `{int, float}` where the oracle's is `{int, float, byte}` — the compiler has no `byte` keyword.
	barePrimitiveType(typeName String, line LineNumber, column ColumnNumber)

	// ⭐ THE SAME RULE AT A CAST TARGET — `x as int`. A SEPARATE arm because it takes a SEPARATE
	// SENTENCE (`barePrimitiveCastMessage`), naming the rewrite in the cast's own shape (`value as
	// MyInt`) rather than a declaration's. One rule, two readers, two texts, each pinned byte for
	// byte.
	barePrimitiveCastTarget(typeName String, line LineNumber, column ColumnNumber)

	// ⭐ TWO TYPE-QUALIFIED RANGE BOUNDS NAMING DIFFERENT TYPES — `int(i8.min to i32.max)`. Renders as
	// **E3005**, positioned at the `int`/`float` keyword. A bound written as `<sized>.<min|max>` says
	// which type's extreme it means, and a range whose two ends mean two different types is a mistake
	// about the type, not a range to normalize. A bound written as a plain LITERAL names no type and is
	// compatible with any qualifier, so this fires only when BOTH ends are qualified.
	//
	// `low`/`high` are the bounds AS WRITTEN (`i8.min`, `i32.max`). ⚠ Hardcoding `.min` on the low and
	// `.max` on the high reports `'i8.min'` for a source that wrote `i8.max`; the field the source
	// actually named is printed instead. Every case the corpus pins writes `.min` low and `.max` high,
	// so the two agree everywhere a `maxoncstderr` block compares them.
	mismatchedRangeBoundTypes(low String, high String, line LineNumber, column ColumnNumber)

	// ⭐ AN INTEGER RANGE SPANNING BOTH NEGATIVE VALUES AND ABOVE `i64.max` — `int(-1 to u64.max)`.
	// Renders as **E3005**, positioned at the `int` keyword. An upper bound above `i64.max` is stored
	// as its wrapped negative pattern — `u64.max` as -1 — (`RangedTypeAlias` keeps raw 64-bit
	// patterns), so without this the range would silently collapse to `-1 to -1` and every check
	// against it would be answering about a range nobody wrote. No 64-bit type holds both ends, so it
	// is refused rather than widened.
	unrepresentableIntegerRange(low FullRangeInt, high String, line LineNumber, column ColumnNumber)

	integerRangeLowerBoundAboveSignedMax(low String, line LineNumber, column ColumnNumber)

	emptyIntegerRange(low FullRangeInt, high FullRangeInt, line LineNumber, column ColumnNumber)

	// ⭐ A `try … otherwise <literal>` DEFAULT OUTSIDE THE CALLEE'S RANGED RETURN TYPE. Renders as
	// **E3005**, positioned at the `try`. The default is bound to the callee's return type, so on the
	// error path it produces a value wearing a type whose declared range excludes it — the one
	// invariant a ranged type exists to carry. Refused at compile time exactly as an out-of-range
	// literal is at a cast (E3005 from `InsertRangeChecks`) or at a ranged `return`.
	otherwiseOutsideRangedReturn(value FullRangeInt, aliasName String, low FullRangeInt, high FullRangeInt, writtenNegative bool, domain RangedAliasDomain, line LineNumber, column ColumnNumber)

	// ⭐ TWO VISIBILITY MODIFIERS ON ONE DECLARATION (`export public function f()`). Renders as **E2001**,
	// positioned at the SECOND modifier — the one that cannot be there is the one the message is about, and
	// it is the oracle's anchor. The two are mutually exclusive by `specs/public-keyword.md`: `export` is
	// program-wide and `public` is program-wide API surface, so a declaration wearing both states two
	// different answers to one question.
	//
	// ⚠ **THE PAIR IS CARRIED, NOT THE SENTENCE, AND THE RENDER ORDERS IT CANONICALLY**, so writing
	// `public export` renders the same sentence as writing `export public`. See
	// `VisibilityModifierWord`, whose DECLARATION ORDER is that canonical order.
	visibilityModifiersCombined(earlier VisibilityModifierWord, later VisibilityModifierWord, line LineNumber, column ColumnNumber)

	// ⭐⭐ A BARE TYPE NAME THAT MORE THAN ONE VISIBLE DECLARATION COULD MEAN. Renders as **E3063**,
	// positioned at the NAME — the token the user has to rewrite. Two files in different directories may
	// both `export typealias Score`; that is accepted at declaration time and is an error only HERE, where
	// the reader's own directory and the root declare none and a reference could mean either. The candidate
	// list is the fix, spelled out.
	//
	// ⚠ It carries the RENDERED list rather than the declarations, because the whole set is decided in one
	// place (`ProgramSignatures.ambiguousAliasCandidates`) and this variant's only job is to carry the
	// verdict to the position. Both raise sites — a type reference and an `as` cast target — hand it the
	// same two strings.
	ambiguousTypeAlias(name String, candidates String, line LineNumber, column ColumnNumber)

	// ⭐ A CLOSURE PARAMETER PAST THE ARITY OF THE FUNCTION TYPE ITS ARGUMENT OFFERS, LEFT UNTYPED — the
	// second `b` of `nums.map(function(a, b) gives a + b)`. Renders as **E2003**, positioned at the
	// parameter's NAME. There is no declared slot to type it from, and typing it anyway lifts a closure with
	// more ABI slots than its caller passes — see `ClosureParamOffer`.
	uninferrableClosureParam(paramName String, aliasName String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **A NAME ITS FILE MAY NOT SEE, REFUSED WHILE THE FILE IS PARSED** — a hidden type, a hidden static
	// member, a `spawn` of a factory no visible declaration provides. Renders as **E3008**,
	// with the wording `SemanticCheck.reportCalleeNotVisible` gives a hidden callee in a function BODY,
	// through the one producer both call (`hiddenSymbolDiagnostic`).
	//
	// ⭐ **THE `kind` IS THE SENTENCE'S NOUN, AND IT IS WHY THIS IS ONE ARM RATHER THAN TWO.** A hidden
	// STATIC MEMBER (`Parser.parseDottedPrimary`, `parseStatement`) is the same refusal
	// as a hidden CALLEE and differs only in the word it opens with — so it rides the same variant to the
	// same producer, which is what keeps a static and a function from drifting on what a tier means.
	symbolNotVisible(kind HiddenSymbolKind, symbol String, tier Visibility, line LineNumber, column ColumnNumber)

	hiddenTypeMembers(typeName String, tier Visibility, line LineNumber, column ColumnNumber)

	// ⭐ **A PLACE ASSIGNED TO ITSELF, TEXTUALLY** — `x = x`, `p.x = p.x`, `self.n = self.n`. Renders
	// as **E3067**, positioned at the statement's FIRST token. `place` is the chain as written, which
	// the message prints on BOTH sides of the `=`. Raised by `Parser.rejectDegenerateAssignment`,
	// which is where the rule and its false-reject surface are stated.
	selfAssignmentHasNoEffect(place String, line LineNumber, column ColumnNumber)

	// ⭐ **A DISCARD WHOSE RIGHT-HAND SIDE CALLED NOTHING** — `_ = 42`, `_ = c.name`, `_ = round(1.5)`.
	// Renders as **E3067** too: one code, a second message, exactly as `tryOnNonThrowingBuiltin` is a second
	// message on E3055. The two shapes share the code because they are one mistake — a statement that
	// computes nothing — and NOT a raiser, because a place chain compared against itself and a call-free
	// right-hand side have no shape in common to share. Raised by `Parser.parseAssignment`'s discard arm.
	discardExpectsACall(line LineNumber, column ColumnNumber)

	// ⭐⭐ **A `__Builtins.ucd*` LOAD WHOSE LABEL NAMES NO TABLE ITS INTRINSIC READS.** Renders as
	// **E2070**, positioned at the label LITERAL. `table` is the one that intrinsic does read, so the
	// message names the fix rather than only the fault. APPENDED AT THE END OF THE UNION.
	//
	// ⚠ **A SECURITY GUARD, NOT A TYPO CHECK.** The label becomes a FILE NAME under the stdlib
	// directory, so an unrostered one is a PATH TRAVERSAL: `ucdByteAt("__ucd_../../../evil", 0)`
	// reaches for `stdlib/helpers/string/ucd_../../../evil.bin`. Checking the `__ucd_` PREFIX only is
	// not enough — that label carries it. See `parseUcdTableLoad`.
	ucdTableLabelUnknown(intrinsic String, table String, label String, line LineNumber, column ColumnNumber)

	// ⭐ **A `name:` LABEL THAT NAMES NO PARAMETER OF AN INTRINSIC THAT HAS SOME.** Renders as **E3037**
	// through `argUnknownLabelMessage` — the SAME code and the same words a user-declared call's unknown
	// label gets, and the same producer its witness-dispatch twin uses, because it is one mistake met at a
	// third kind of call site. APPENDED AT THE END OF THE UNION.
	//
	// It is a SEPARATE arm from `witnessUnknownArgLabel` only because that arm's noun is a witness
	// dispatch; sharing the message rather than the variant is what keeps the three sites' wording one
	// fact. Raised by `parseUcdTableLoad`, the one intrinsic family with parameter names — a builtin
	// WITHOUT a declaration answers E2067 instead, and that difference is the whole rule.
	builtinUnknownArgLabel(intrinsic String, label String, line LineNumber, column ColumnNumber)

	// ⭐⭐ **THE TWO SERVICE REFUSALS, APPENDED AT THE END OF THE UNION.** Both carry a rendered
	// SENTENCE rather than the facts, because the words belong beside the rule that decides them
	// (`ServiceCompanions.serviceTargetRefusalMessage` / `serviceRosterRefusalMessage`) and not at the
	// diagnostic mapper — the same shape `otherwiseOutsideRangedReturn` uses two arms up in that mapper, and
	// for the same reason it gives.
	//
	// ⚠ **A 3xxx CODE RAISED BY THE PARSER, DELIBERATELY.** Whether a type is a SERVICE is a whole-program
	// property (the sweep decides it), but the only place it can be REPORTED is the `spawn` the author wrote:
	// the sweep is memoized and reports nothing, and the design requires the diagnostic to name the site that
	// made the type a service. The parser already raises E3005 and E3011 the same way.
	serviceNotASpawnTarget(explanation String, line LineNumber, column ColumnNumber)

	// ⭐ **THE FOURTH, AND IT IS ABOUT THE HANDLE'S SURFACE RATHER THAN ABOUT A VALUE.** A member
	// that is not on `<T>.handle` is not a missing FIELD and not an undefined FUNCTION — it is a method the
	// export boundary deliberately left off the handle. The sentence has to say that or it reads as a typo.
	serviceNotAMessage(explanation String, line LineNumber, column ColumnNumber)

	// ⭐ **THE FIFTH, AND IT IS ABOUT WHAT COMES BACK RATHER THAN ABOUT WHAT GOES OUT.** Every arm above
	// refuses a value CROSSING TO the service; this one refuses a message whose REPLY will not fit the two
	// words a cell carries. It fires at the same `spawn` for the same reason — `<T>.__behave` is synthesized
	// from the declaration, so a message the cell cannot carry would put a wrong-width store in a body the
	// service really runs, whether or not the program ever sends one.
	serviceReplyNotCarriable(explanation String, line LineNumber, column ColumnNumber)

	// ⭐ **THE SEVENTH, AND IT IS THE ONLY ONE ABOUT THE HANDLE'S OWN TYPE RATHER THAN ABOUT A DECLARATION.**
	// Every arm above is decided from what the source declares; this one is decided from what the VALUE at a
	// send still knows — a generic service's instantiation, which rides the handle because one `<T>.handle`
	// serves them all and no slot can spell one. It fires at the SEND and not at the `spawn`, because the
	// `spawn` is exactly the site where the fact is still present.
	serviceReplyInstanceUnknown(explanation String, line LineNumber, column ColumnNumber)

	registryRefused(code ErrorCode, explanation String, line LineNumber, column ColumnNumber, note DiagnosticNote)
	duplicateDeclaration(explanation String, line LineNumber, column ColumnNumber)

	// These four render exactly as `unsupported`, `serviceNotASpawnTarget`, `serviceArgumentNotUnique`
	// and `registryRefused(throwingFunctionRequiresTry)`. Each is its own arm to carry the declaration it
	// is about, which `ParseStaging.consequenceNamedBy` reads to drop the refusal when that declaration
	// was itself refused: the parser cannot reach `Project.poison`, so a throwing spawn's E3057 gets the
	// verdict `refusesACalleeFrom` gives a plain call only by carrying its factory to the drop.
	memberAccessOnNonStruct(feature String, line LineNumber, column ColumnNumber, origin ReceiverOrigin)
	serviceTypeNotASpawnTarget(explanation String, typeName String, line LineNumber, column ColumnNumber)
	spawnStartRequiresTry(explanation String, factory immutable ByteArray, line LineNumber, column ColumnNumber)
	genericArgumentCountRefused(code ErrorCode, explanation String, line LineNumber, column ColumnNumber)
end 'SourceParseError'

// The declarations a receiver was derived from (its brand, the calls that produced it followed
// through their own receivers, the union a `match` payload was bound out of), so a member access on
// it is dropped when one of them was refused.
export union ReceiverOrigin
	derivedFrom(names NameRoster)
	unattributed
end 'ReceiverOrigin'

// Which refusal an `end` whose label does not repeat its header's is: a block's (E2008) or a match's (E2043).
enum EndLabelRule
	block
	matchArm
end 'EndLabelRule'

// ⭐⭐ **ONE PARSER-DETECTED NAME DIAGNOSTIC WHOSE REPORT IS HELD BACK UNTIL EVERY FILE IS PARSED.**
//
// Two diagnostics are about a NAME rather than about syntax — E3062 (an alias no position in its directory
// subtree names) and E3008 (a type name the reading file cannot see) — and the corpus pins them in a program where
// each comes from a DIFFERENT file, E3062 first (`export-keyword/error.non-exported-typealias-cross-file`).
//
// ⚠ **THAT ORDER CANNOT BE HAD FROM PER-FILE REPORTING.** A file's diagnostics are reported as that file is
// parsed, so their order
// is the order the SOURCE WALK found the files — and `Compiler.collectMaxonSources` pushes whatever
// `Directory.list` hands it, **which is the FILESYSTEM's order and not any order at all**. The pinned
// program declares the alias in `types.maxon` and misuses it in `main.maxon`, so per-file reporting
// emits them in whichever order the OS enumerated two FILENAMES in, which is not a property of the
// program and is not the same answer on two machines.
//
// ⛔ **THE ORDER IS NOT ALPHABETICAL AND IS NOT A CONTRACT.** NTFS keeps its directory index sorted;
// APFS returns hash order, where any such claim is false. **The walk is deliberately NOT sorted** —
// a canonical input order does not remove an order dependence, it makes one reliably hidden (user
// ruling 2026-07-24, in `StdlibLoader.maxon`'s header) — so the correct reading is that this order
// was never available to depend on, which is exactly why the deferral below exists.
//
// ⇒ Both are recorded here instead and reported by `TypeResolution.reportDeferredNameDiagnostics`,
// which drains the unused list and then the hidden list — so the order is a property of WHAT the
// diagnostics are, which is the only thing that can be relied upon. The deferral is what makes the
// E3008 non-fatal to the parse as well: a file that misuses a hidden type name goes on parsing, so its
// other diagnostics are still reported.
//
// It carries the NAME as a field rather than only inside a rendered message because the drain must be
// able to SUPPRESS by name: an alias whose declaration already collided with another is reported once,
// as the collision (`Project.collidedTypeNames`).
export type DeferredNameDiagnostic
	export let name as immutable ByteArray
	export let filePath as FilePath
	export let line as LineNumber
	export let column as ColumnNumber

	export static function create(name ByteArray, filePath FilePath, line LineNumber, column ColumnNumber) returns DeferredNameDiagnostic
		return Self{name: name, filePath: filePath, line: line, column: column}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.name)
		writer.text(self.filePath.toString())
		writer.unsigned(self.line as CacheUnsigned)
		writer.unsigned(self.column as CacheUnsigned)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns DeferredNameDiagnostic throws LibraryCacheDamage
		let f_name = freeze try reader.bytes()
		let f_filePath = try reader.path()
		let f_line = (try reader.unsigned()) as LineNumber
		let f_column = (try reader.unsigned()) as ColumnNumber

		return Self{name: f_name, filePath: f_filePath, line: f_line, column: f_column}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize32
		return sizeof(DeferredNameDiagnostic) as CacheSize32
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'DeferredNameDiagnostic'

export typealias DeferredNameDiagnosticArray = Array with DeferredNameDiagnostic

// @generated library-cache begin
function cacheWriteDeferredNameDiagnosticArray(writer LibraryCacheWriter, value DeferredNameDiagnosticArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteDeferredNameDiagnosticArray'

function cacheReadDeferredNameDiagnosticArray(reader LibraryCacheReader) returns DeferredNameDiagnosticArray throws LibraryCacheDamage
	let count = try reader.count()
	let result = DeferredNameDiagnosticArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try DeferredNameDiagnostic.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadDeferredNameDiagnosticArray'

// @generated library-cache end

// The result of recovering a promise handle's AWAITED callee name from its defining `asyncCall`
// — `found` for a real async spawn's result, `none` for a value that is not one.
// ⭐⭐ **WHAT AN AWAITABLE SEND HANDS BACK — a reply CELL, or nothing at all.** A union rather than a
// bare `ValueId` plus a flag: a fire-and-forget message has NO cell, and a zero ValueId is a real SSA value
// (`v0` is a function's first parameter), so a sentinel here would name one.
union ServiceReplyValue
	fireAndForget
	cell(promise ValueId)
end 'ServiceReplyValue'

union MessageRoute
	mailbox
	sendTable(slot CaseIndex, interfaceName immutable ByteArray)
end 'MessageRoute'

function payloadsAgree(payloads PayloadFieldArray, other PayloadFieldArray) returns bool
	if payloads.count() != other.count() 'differentArity'
		return false
	end 'differentArity'

	for (position, field) in payloads.withIterator() 'eachSlot'
		let theirs = try other.get(position.index()) otherwise panic("payloadsAgree: other.get OOB at {position.index()} below the equal count just compared")

		if not maxonTypesDenoteSame(field.declaredType, b: theirs.declaredType) or field.capability != theirs.capability 'differentSlot'
			return false
		end 'differentSlot'
	end 'eachSlot'

	return true
end 'payloadsAgree'

function awaitedServiceOf(route MessageRoute, typeName immutable ByteArray) returns immutable ByteArray
	return match route 'route'
		mailbox gives typeName
		sendTable(_, interfaceName) gives interfaceName
	end 'route'
end 'awaitedServiceOf'

union RegistryReplacement
	unconditional
	replacing(old ValueId)
end 'RegistryReplacement'

union DestructuredSource
	tuple(layout StructLayout)
	deferred
end 'DestructuredSource'

union CheckedBindingNames
	every
	leading(count ElementIndex)

	function covers(position ElementIndex) returns bool
		return match self 'checked'
			every gives true
			leading(count) gives position < count
		end 'checked'
	end 'covers'
end 'CheckedBindingNames'

export enum ZeroElementRefusal
	fixedArrayCreate
	arrayResize
	arrayCreateZeroed
	bufferSetLength
end 'ZeroElementRefusal'

export union ZeroElementSubject
	named(elementType String)
	instantiatedAs(instance String)
	instantiated
end 'ZeroElementSubject'

function zeroElementRefusalTrustsSparseColumns(refusal ZeroElementRefusal) returns bool
	return match refusal 'refusal'
		arrayResize or
		bufferSetLength gives true
		fixedArrayCreate or
		arrayCreateZeroed gives false
	end 'refusal'
end 'zeroElementRefusalTrustsSparseColumns'

enum LiteralEntryShape
	element
	pair
	tupleElement
end 'LiteralEntryShape'

function literalEntryCloser(entry LiteralEntryShape) returns TokenKind
	return match entry 'entry'
		element or
		pair gives TokenKind.rightBracket
		tupleElement gives TokenKind.rightParen
	end 'entry'
end 'literalEntryCloser'

enum SoughtGive
	known
	aliasedNumber
	runtimeSizedFixedArray
	float
	deferred
end 'SoughtGive'

enum GivingArmSearchError implements Error
	noArmGivesIt
end 'GivingArmSearchError'

union AsyncCalleeLookup
	found(callee immutable ByteArray)

	// ⭐ **A SERVICE REPLY CELL** — a promise whose defining op is a `serviceReplyCell`, naming the
	// MESSAGE whose reply it will carry. It is a distinct arm rather than a second `found` because the two
	// roads describe the promise differently at every door: an `async` spawn's facts come off the callee's
	// own signature, a reply's off the message's.
	serviceReply(messageName immutable ByteArray, awaitedService immutable ByteArray)
	none
end 'AsyncCalleeLookup'

// The set of promise values already visited while tracing a re-armed `var`'s merge phi back to a defining
// `asyncCall` — breaks the loop back-edge cycle in `resolveAsyncCallee`.
typealias AsyncCalleeVisited = Set with ValueId

function asyncCalleeIfMatch(op MaxonOp, promise ValueId) returns AsyncCalleeLookup
	return match op 'op'
		call or
		literal or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives AsyncCalleeLookup.none
		asyncCall(result, callee, _, _, _, _, _) gives foundCalleeIfEqual(result, callee: callee, promise: promise)

		// A reply cell mints a promise too; this arm is how `awaitedPromiseFacts` finds one.
		serviceReplyCell(result, messageName, awaitedService) gives serviceReplyIfEqual(result, messageName: messageName, awaitedService: awaitedService, promise: promise)
	end 'op'
end 'asyncCalleeIfMatch'

// `serviceReply(messageName)` when `result` IS the tracked promise (this `serviceReplyCell` minted it),
// else `none` — `foundCalleeIfEqual`'s twin one road over, split for its reason: a match arm cannot host the
// equality test inline.
function serviceReplyIfEqual(result ValueId, messageName ByteArray, awaitedService ByteArray, promise ValueId) returns AsyncCalleeLookup
	if result == promise 'eq'
		return AsyncCalleeLookup.serviceReply(messageName, awaitedService: awaitedService)
	end 'eq'

	return AsyncCalleeLookup.none
end 'serviceReplyIfEqual'

// `found(callee)` when `result` IS the tracked promise (this `asyncCall` minted it), else `none`.
function foundCalleeIfEqual(result ValueId, callee ByteArray, promise ValueId) returns AsyncCalleeLookup
	if result == promise 'eq'
		return AsyncCalleeLookup.found(callee)
	end 'eq'

	return AsyncCalleeLookup.none
end 'foundCalleeIfEqual'

// A `MaxonReturnType` as a value tag, VOID included — the void-tolerant twin of `maxonReturnTypeTag` (which
// PANICS on void). Delegates the value case rather than re-matching it.
//
// ⚠ **IT IS NOT NAMED FOR ONE CALLER.**
// An async result may legitimately be void (a void throwing async carries only an error flag) and so
// may a declared answer `returnAnswersAreInterchangeable` compares; a name that describes the CALLER rather than the
// fact is what invites a second caller to write its own copy — which would SHADOW the panicking
// `maxonReturnTypeTag` for every other reader in this file.
function returnTypeTagOrVoid(returnType MaxonReturnType) returns ValueTypeTag
	if maxonReturnTypeIsVoid(returnType) 'void'
		return ValueTypeTag.void
	end 'void'

	return maxonReturnTypeTag(returnType)
end 'returnTypeTagOrVoid'

// **THE NAME OF THE RECEIVER PARAMETER.** An instance method's parameter 0, pushed by
// `parseFunction` and bound by `bindParameters` exactly like every other parameter — so the
// receiver's SSA value, its register, and its slot in a call's argument list are all decided by
// machinery that does not know what a method is.
//
// ⚠ It is an ORDINARY IDENTIFIER, so a body that writes `__self` resolves it and gets the receiver
// — an internal name reachable from source. It is not exploited by anything and no corpus case
// names it; the alternative — binding the receiver under the `self` KEYWORD's own text, which no
// parameter can ever be called — closes it for free but departs from convention, so it is recorded
// here rather than taken unilaterally.
let SelfParamName = b"__self"

// ⭐ **THE RECEIVER'S SOURCE SPELLING, WHICH IS NOT ITS KEY.** Resolving the receiver out of `Scope` takes
// `__self`, and no source ever writes that — so a diagnostic that blamed the key would point the reader
// at a name absent from their file. `self` is the spelling they wrote, or (for the BARE call that wrote no receiver at all) the one they would.
//
// ⚠ **IT HAS TWO READERS, WHICH IS WHY IT IS NAMED FOR THE RECEIVER RATHER THAN FOR BLAME** —
// `displayParamName` (every diagnostic that names a parameter, the by-reference overlap message's
// included), and `requireUnreservedName`, which refuses a user declaration of this same spelling (E2051,
// `reserved-self.md`). Both ask one question — which word in the source means the implicit receiver
// — so a second `b"self"` or `"self"` beside either of them is that fact written twice, and a drift between
// them shows as a WRONG NOUN in a message rather than a compile error.
let ReceiverSourceSpelling = b"self"

// The name the HIDDEN binding of a destructuring `let (x, y) = …` takes, ahead of its source
// position — `__destructure_12_3`. The position is what makes it unique per declaration; the `__`
// prefix is what keeps it out of the source's reach, since `requireUnreservedName` refuses (E2051)
// every declaration of a `__`-prefixed name and the binding is declared by the compiler rather than
// through that door.
let DestructureTempPrefix = "__destructure_"

function deriveTableHolder(liftedClosure bool, carriedTables ParamCount) returns TableHolder
	if liftedClosure 'inAClosure'
		return TableHolder.liftedClosure
	end 'inAClosure'

	return TableHolder.carriesTables if carriedTables != 0 else TableHolder.declaredWithoutTables
end 'deriveTableHolder'

enum TableHolder
	carriesTables
	declaredWithoutTables
	liftedClosure
end 'TableHolder'

function arrivalWhenWithoutTables(holder TableHolder, outsideAClosure NoWitnessTablesArrival) returns NoWitnessTablesArrival
	return match holder 'holder'
		carriesTables panic("arrivalWhenWithoutTables: asked of a holder that carries witness tables")
		declaredWithoutTables gives outsideAClosure
		liftedClosure gives NoWitnessTablesArrival.forwardedFromAClosure
	end 'holder'
end 'arrivalWhenWithoutTables'

enum NoWitnessTablesArrival
	forwardedToACallee
	dispatchedOnATypeParameter
	dispatchedOnAnInstanceOverATypeParameter
	dispatchedInAClosure
	forwardedFromAClosure
end 'NoWitnessTablesArrival'

let StaticTakesItsDictionaryFromItsCall = "from the instance its call names (a typealias, or an instance its arguments fix), or from the function that calls it"

let ReachThroughSelfClause = "through `self`, through a local bound to a `Self\{…}`"

let NoWitnessTablesDispatchRemedy = ". Make it an instance method, or take the operation as a function parameter"

function noWitnessTablesSentence(methodName ByteArray, arrival NoWitnessTablesArrival) returns String
	return match arrival 'arrival'
		forwardedToACallee gives noWitnessTablesCallSentence(methodName, receiver: "the enclosing type", verb: "forward", remedy: ". Make it an instance method, or return `Self` and call the method on the result")
		dispatchedOnATypeParameter gives noWitnessTablesCallSentence(methodName, receiver: "a type parameter", verb: "dispatch through", remedy: NoWitnessTablesDispatchRemedy)
		dispatchedOnAnInstanceOverATypeParameter gives noWitnessTablesCallSentence(methodName, receiver: "a generic type over a type parameter", verb: "dispatch through", remedy: NoWitnessTablesDispatchRemedy)
		dispatchedInAClosure gives NoWitnessTablesClosureSentence
		forwardedFromAClosure gives "a closure that calls '{String.from(methodName)}' (which dispatches through the type's `where` constraints) on a value of a generic type over a type parameter — a closure inherits a witness table through its environment only for a direct dispatch on a type-parameter value, so it has none to hand on to a callee. Make the call in the method that builds the closure and let the closure use the result, or take the operation as a function parameter"
	end 'arrival'
end 'noWitnessTablesSentence'

function noWitnessTablesCallSentence(methodName ByteArray, receiver String, verb String, remedy String) returns String
	return "calling '{String.from(methodName)}' (which dispatches through the type's `where` constraints) on a value of {receiver}, from a `static function` that carries no witness tables of its own to {verb} — a static takes its witness tables {StaticTakesItsDictionaryFromItsCall}, and only when its body is seen to dispatch on a value typed at a type parameter (a parameter, a field read, a call result, or a local bound from one); this dispatch is not seen as one{remedy}"
end 'noWitnessTablesCallSentence'

let NoWitnessTablesClosureSentence = "a closure that dispatches through the type's `where` constraints, written inside a `static function` (or a field-default helper) that carries no witness tables of its own — the closure inherits its table through its environment from the function that built it, and this static reserved none, because nothing in its body was seen to dispatch on a value typed at a type parameter (a static takes its witness tables from the instance its call names). Write the closure in an instance method, or take the operation as a function parameter"

// The empty `ParamPositionMask` — this function writes none of its parameters, which is the overwhelmingly
// common answer and the initial value of every function's mask.
let NoParamPositions = 0 as ParamPositionMask

// **THE SOURCE SPELLING OF THE RECEIVER PARAMETER, AS A DIAGNOSTIC PRINTS IT.** `__self` is the
// IR's name for it; `self` is the KEYWORD the user actually wrote, and the only one a diagnostic
// may quote back at them — a message naming `__self` would name an identifier that appears nowhere
// in their program (and one the language reserves).
//
// ⚠ **THE SPELLING ITSELF IS `ReceiverSourceSpelling`'s** — see there for the two readers of that one
// fact. Only the `String` CONVERSION is written at each diagnostic
// site, and it is free: every path through one is already building a message.
//
// A parameter's name AS A DIAGNOSTIC PRINTS IT. Only the receiver differs from its IR name; every other
// parameter is spelled exactly as it was declared.
function displayParamName(name ByteArray) returns String
	return String.from(ReceiverSourceSpelling) if name.equals(SelfParamName) else String.from(name)
end 'displayParamName'

function capturedCopyMutatingCallMessage(blamed String, parameter WrittenParameter, functionName String) returns String
	let written = match parameter 'parameter'
		named(name) gives "'{displayParamName(name)}'"
		positional gives "it"
	end 'parameter'

	return "cannot pass '{blamed}' to a function that writes {parameter.display()} (in {functionName}): the closure holds its own copy of '{blamed}', so a write through {written} cannot reach the original; pass a clone()"
end 'capturedCopyMutatingCallMessage'

// ⭐ **WHAT SEPARATES AN UNNUMBERED ENUM'S TAG FROM ITS ORDINAL — nothing, and this constant IS that
// claim.** `Parser.enumTagAsANumber` adds this offset only past `EnumLayout.tagsAreDeclarationIndices`,
// which proves `caseTags[i] == i` for every case; the offset is therefore zero by PROOF rather than by
// luck. It is named so the `+ 0` in the emit reads as the identity it was shown to be, instead of as a
// literal a reader has to re-derive.
//
// ⚠ It is the offset from a TAG to an ordinal, and says nothing about where that tag was found — the
// accessor answers that first, and a BOXED union's tag is a load rather than the value (see there).
let EnumOrdinalTagOffset = 0

// ⭐ **THE ORDINAL OF THE FIRST DECLARED CASE, AND THE SEED OF THE TAG→CONSTANT SUM** — a DIFFERENT fact
// from the offset above, which is why it is a second constant and not a second use of the first. The sum
// `Σᵢ constantᵢ × (tag == tagᵢ)` (`Parser.emitEnumCaseConstantSelect`) accumulates onto a zero, and for the
// `declarationIndex` column that zero doubles as case 0's own term (see `firstSummedCaseIndex`), which is
// what this constant names rather than leaving a bare `0` a reader has to reconstruct.
let FirstCaseOrdinal = 0

// The first case the tag→constant sum emits a TERM for, for the ONE column whose first term is provably
// zero — the same quantity as `FirstCaseOrdinal + 1`, and spelled separately rather than computed because
// the two live in different domains: the seed is the `FullRangeInt` a `literal` op carries, this is the
// `CaseIndex` the loop counts and `EnumLayout.tagOfIndex` is indexed by.
let FirstSummedCaseIndex = 1 as CaseIndex

// The declaration index of an enum's FIRST case — where a column whose case-0 term is not provably zero
// starts summing. Named rather than written `0` beside `FirstSummedCaseIndex`, so the two bounds read as
// the pair of answers to one question.
let FirstCaseIndex = 0 as CaseIndex

// ⭐⭐ **WHICH PER-CASE COLUMN AN ENUM ACCESSOR SELECTS OUT OF ITS LAYOUT.** The three instance accessors
// differ in exactly this and in nothing else — same tag, same compare chain, same sum — so it is one enum
// read by one emitter (`Parser.emitEnumCaseConstantSelect`) rather than three near-copies of a loop.
// ⚠ **IT IS A UNION AND NOT AN ENUM, BECAUSE ONE COLUMN IS NOT A SINGLE COLUMN.** A STRUCT backing has one
// per-case constant PER FIELD, so "which column" and "which field" are one question and travel as one value —
// which is what lets the sum below stay a single emitter parameterized by a column. Written as an enum
// beside a separate `field` argument, four of the five columns would carry an index nothing reads and the
// fifth would depend on two parameters agreeing; here the field cannot be absent from the one column that
// needs it, nor present on the four that do not.
union EnumCaseConstant
	// `.ordinal` — the case's position in the declaration. Read only where the tags are NOT already those
	// positions (`EnumLayout.tagsAreDeclarationIndices`); where they are, the tag is the answer and no sum
	// is emitted at all.
	declarationIndex

	// `.name` — `EnumLayout.caseNames[i]`, the case's spelling, as an immortal `.rdata` String.
	caseName

	// `.rawValue` of a STRING-backed enum — `EnumLayout.caseRawValues[i]`, the declared string, as an
	// immortal `.rdata` String. The three NUMERIC backings never reach the sum: their tag IS the raw value.
	declaredRawValue

	// ⭐ `.rawValue` of a FUNCTION-backed enum — `EnumLayout.caseRawValues[i]` read as the NAME of a declared
	// function, materialized as that function's `__fnref_` thunk address (`Parser.emitFunctionRef`). It is
	// a machine word that is constant per case, exactly as the two `.rdata` addresses above are, which is
	// the whole reason a function backing needed a COLUMN here and not a mechanism of its own.
	caseFunctionRef

	// ⭐⭐ `.rawValue.<field>` of a STRUCT-backed enum — `EnumLayout.caseBackingFields[i]`'s entry for
	// the struct field at `field`, as the number the declaration folded it to (an int, a bool's 0/1, a
	// float's IEEE bits, or the referenced enum case's TAG). **A struct is not one machine word, so
	// this column is PER FIELD** — one sum per field read, which is exactly the "select-chain over the
	// per-case constants" `/specs/enum-struct-backing.md` describes — one chain per LEAF field.
	//
	// ⚠ **IT CARRIES A PATH AND NOT ONE FIELD, BECAUSE A BACKING FIELD MAY ITSELF BE A STRUCT**
	// (`/specs/enum-nested-struct-backing.md`: `op.rawValue.meta.latency`). One STEP per hop, and the leaf
	// the last step names is what this column selects — which is still one machine word per case, so nothing
	// about the sum changes. See `EnumBackingFieldStep` for why a step carries three facts.
	structBackingField(path EnumBackingFieldStepArray, domain EnumBackingFieldDomain)
end 'EnumCaseConstant'

// ⭐⭐ **ONE HOP OF A BACKING-FIELD READ, RESOLVED AGAINST THE STRUCT THAT DECLARES IT** — `meta` then
// `latency` out of `op.rawValue.meta.latency`. Minted once per read by `Parser.resolveEnumBackingLeaf`,
// which walks the declared types, and consumed once PER CASE by `Parser.enumBackingFieldConstant`, which
// walks that case's written entries.
//
// ⚠ **ALL THREE FACTS ARE THE WALK'S, AND RE-DERIVING ANY OF THEM IS A `structOf` PROBE PER CASE.** The
// INDEX is what an unlabelled entry (`OpMeta.create(1)`) is matched by, the NAME is what a labelled one
// (`setsFlags: true`) is matched by — a case may write both spellings, so neither alone answers — and the
// OWNER is the struct that declares this hop, which the "case writes no value for it" diagnostic names and
// which is not `EnumLayout.backingStruct` past the first hop.
type EnumBackingFieldStep
	export let field as FieldIndex
	export let fieldName as immutable ByteArray
	export let ownerName as immutable ByteArray

	static function create(field FieldIndex, fieldName ByteArray, ownerName ByteArray) returns EnumBackingFieldStep
		return Self{field: field, fieldName: fieldName, ownerName: ownerName}
	end 'create'
end 'EnumBackingFieldStep'

typealias EnumBackingFieldStepArray = Array with EnumBackingFieldStep

// ⭐⭐ **WHAT A `.rawValue.<field>[.<field>…]` CHAIN RESOLVED TO — the ONE scalar leaf it names, plus the
// path that reaches it.** Minted by `Parser.resolveEnumBackingLeaf`, which is the only thing that may build
// one: the `domain` here is by construction NOT `nestedRecord`, because that walk keeps descending while it
// is (see `Parser.requireEnumBackingFieldDomainIsAWord`'s assertion, which rests on exactly that).
type EnumBackingLeaf
	export let path as EnumBackingFieldStepArray

	// The leaf's DECLARED type, which is what the selected word is finally claimed to be — a ranged alias
	// included, so `op.rawValue.meta.latency` types as `Latency` exactly as `s.latency` on a record does.
	export let fieldType as MaxonType
	export let domain as EnumBackingFieldDomain

	static function create(path EnumBackingFieldStepArray, fieldType MaxonType, domain EnumBackingFieldDomain) returns EnumBackingLeaf
		return Self{path: path, fieldType: fieldType, domain: domain}
	end 'create'

	// The hop that named the leaf itself — whose two names every diagnostic about the leaf renders. The
	// panic's guard is the producer's own loop, which pushes a step before it can return.
	function lastStep() returns EnumBackingFieldStep
		return try self.path.get(self.path.count() - 1) otherwise panic("EnumBackingLeaf.lastStep: the path is EMPTY — `Parser.resolveEnumBackingLeaf` pushes one step per hop BEFORE any exit, so a leaf with no step means that walk returned without resolving anything")
	end 'lastStep'
end 'EnumBackingLeaf'

// One entry of a case's flat backing tree, with the OOB panic written once — `EnumLayout.backingFieldsAt`'s
// twin one level in, and here because both walks over that array (the door's and the read's) index it.
function enumBackingEntryAt(entries EnumBackingFieldArray, entry EnumBackingEntryIndex) returns EnumBackingField
	return try entries.get(entry) otherwise panic("enumBackingEntryAt: backing entry {entry} is past the {entries.count()} this case wrote — every index handed out is either a loop bound over this same array or an owner recorded by `Parser.readEnumBackingEntryInto` as it pushed")
end 'enumBackingEntryAt'

// ⭐⭐ **DOES THIS ENTRY FILL FIELD `field` OF THE STRUCT AT `group`? — THE MATCHING RULE, ONCE.** A LABELLED
// entry fills the field its label names; an UNLABELLED one fills the field at its own position; and neither
// counts unless the entry belongs to the group being filled. All three clauses are one rule, and both
// spellings can appear in one group (`OpMeta.create(4, isMemory: true, isCall: false)`), so no clause of it
// can be dropped.
//
// ⚠ **IT IS HERE BECAUSE THE RULE HAS TWO DIRECTIONS AND ONLY THIS ONE IS SHARED.** The door asks
// ENTRY→FIELD (`Parser.requireEnumBackingFieldPosition`, which must name the field an entry claims in order
// to diagnose a surplus positional argument) and the read asks FIELD→ENTRY
// (`Parser.requireEnumBackingEntryFilling`). They cannot be one function, so the PREDICATE is one function
// and the door's inverse points at it — a clause added to only one of them would not fail to compile
// anywhere, it would select a different case's constant.
// How many entries one group holds — the ARGUMENT COUNT the arity diagnostic reports, which is a property
// of the group and not of whichever entry happened to overflow it first. A scan, walked only when that
// diagnostic is being built.
function enumBackingGroupEntryCount(entries EnumBackingFieldArray, group EnumBackingGroupId) returns FieldIndex
	var written = 0 as FieldIndex

	for entry in 0 upto entries.count() 'eachEntry'
		if enumBackingEntryAt(entries, entry: entry as EnumBackingEntryIndex).group == group 'thisGroup'
			written = written + 1
		end 'thisGroup'
	end 'eachEntry'

	return written
end 'enumBackingGroupEntryCount'

function enumBackingEntryFills(recorded EnumBackingField, group EnumBackingGroupId, field FieldIndex, fieldName ByteArray) returns bool
	if recorded.group != group 'fillsAnotherStruct'
		return false
	end 'fillsAnotherStruct'

	return recorded.name.equals(fieldName) if not recorded.name.isEmpty() else recorded.position == field
end 'enumBackingEntryFills'

// Where the sum starts is a property of the column, not of the enum. A declaration index's first
// term is `0 × (tag == tag₀)`, identically zero, so it is folded into the seed and the chain begins
// at case 1. The string columns select a `.rdata` address and the function column a `.text` one,
// never zero, and a struct-backed field's constant is whatever the author wrote, so each of those
// sums its case 0.
//
// A full match rather than a `default`: a column appended to `EnumCaseConstant` would otherwise
// inherit the skip and silently answer the second case's constant for the first.
function firstSummedCaseIndex(column EnumCaseConstant) returns CaseIndex
	return match column 'c'
		declarationIndex gives FirstSummedCaseIndex
		caseName or
		declaredRawValue or
		caseFunctionRef or
		structBackingField gives FirstCaseIndex
	end 'c'
end 'firstSummedCaseIndex'

enum EnumSelectDomain
	caseTag
	wordKey
end 'EnumSelectDomain'

// Whose file judges a tag read: `written` (a `match`, accessor or `.rawValue` an author spelled) for the
// file the code is in, `languageMade` for the caller that supplied a bound type argument. See
// `reachedOnTheInstantiatorsBehalf`.
enum EnumTagReach
	written
	languageMade
end 'EnumTagReach'

// ⭐ **WHAT AN INTERPOLATED ENUM VALUE RENDERS AS.** Three answers rather than a bool, because the two that
// produce TEXT select from different columns (`caseNames` vs `caseRawValues`) and the third produces no text
// at all — it hands the tag to the ordinary decimal renderer. See `enumInterpRendering`.
enum EnumInterpRendering
	caseName
	declaredText
	rawNumber
end 'EnumInterpRendering'

// The language's enum-rendering rule, pinned by `/specs/string-interpolation.md` and, for the
// caught-error spelling, `/specs/test-uncaught-throw.md`: the live case name for a union and for a
// plain enum, and the declared raw value for an enum that has one. The questions narrow in order:
//
//   1. A payload-bearing union renders case names whatever its cases wrote: its tag is a
//      declaration index in a box, so `union { a = 1001, b(s String) }` prints `a`, not `1001`.
//   2. A character- or string-backed case renders the text it wrote, kept in `caseRawValues`:
//      `dot = '.'` prints the glyph, never the codepoint.
//   3. A struct-backed case renders its case name, because a whole struct is not one word of text.
//   4. Otherwise the raw i64 renders iff the declaration wrote a raw value
//      (`EnumLayout.declaresRawValues`), since `backing` is `integer` either way.
//
// A `functionRef` backing renders the i64 the value carries. `unresolved` is a declaration with no
// cases (`requireEnumBacking` is its only door), so no value of it exists to interpolate and it
// takes clause 4.
function enumInterpRendering(layout EnumLayout) returns EnumInterpRendering
	if layout.carriesPayloads() 'aPayloadBearingUnion'
		return EnumInterpRendering.caseName
	end 'aPayloadBearingUnion'

	// Every backing is named, so one added later fails to compile here rather than inheriting a
	// rendering nobody re-reads.
	match layout.backing 'backing'
		unresolved or
		integer or
		functionRef then break
		float then panic("enumInterpRendering: a float-backed enum reached the interpolation dispatch — `materializeInterpExpr` decodes one to a `float`-tagged value through `floatBehindEnumValue` before asking whether the hole is an enum, so its tag cannot still be `named` here. Rendering it as a number would print the IEEE bit pattern as a decimal integer")
		character or
		string then return EnumInterpRendering.declaredText
		structRecord then return EnumInterpRendering.caseName
	end 'backing'

	return EnumInterpRendering.rawNumber if layout.declaresRawValues else EnumInterpRendering.caseName
end 'enumInterpRendering'

// A set of type NAMES one file's parse recorded. Two fields hold one: the names it WROTE in a type
// position (`ParseMemos.usedTypeNames`) and the types it reached INTO without writing anything
// (`ParseMemos.memberAccessedTypeNames`). They are two facts and are deliberately not merged — see
// there.
