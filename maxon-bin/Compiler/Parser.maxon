		return Self{cell: cell, epoch: epoch}
	end 'create'
end 'FilledCell'

type CellOccupantRead
	export var binding as VarInfo
	export let epoch as ValueId

	static function create(binding VarInfo, epoch ValueId) returns Self
		return Self{binding: binding, epoch: epoch}
	end 'create'
end 'CellOccupantRead'

typealias CellOccupantReadMap = Map with (ValueId, CellOccupantRead)

union CellOccupantTake
	notACellOccupant
	takeable(read CellOccupantRead)
end 'CellOccupantTake'

union HandOffTake
	copied
	cellOccupant(read CellOccupantRead, exclusivity CellOccupantExclusivity)
	movedOut(soleOwner bool)
	promiseMovedIn
	promotedLiteral
	aReferenceOfItsOwn
	aLentReference
	aCopyOfItsOwn
	anOpaqueReference
	sharedReadOnly
end 'HandOffTake'

type HandOffPlan
	export let argument as HandedOffArgument
	export var take as HandOffTake

	static function create(argument HandedOffArgument, take HandOffTake) returns Self
		return Self{argument: argument, take: take}
	end 'create'
end 'HandOffPlan'

typealias HandOffPlanArray = Array with HandOffPlan

union SharedSlotHandBack
	moved
	copied(clone ManagedCascadeStrategy, release immutable ByteArray)
end 'SharedSlotHandBack'

typealias SharedSlotHandBackArray = Array with SharedSlotHandBack

function handOffTakeEndsTheWriteBlame(take HandOffTake) returns bool
	return match take 'take'
		cellOccupant(_, exclusivity) gives exclusivity == CellOccupantExclusivity.sole
		movedOut(soleOwner) gives soleOwner
		copied or
		promiseMovedIn or
		promotedLiteral or
		aReferenceOfItsOwn or
		aLentReference or
		aCopyOfItsOwn or
		anOpaqueReference or
		sharedReadOnly gives false
	end 'take'
end 'handOffTakeEndsTheWriteBlame'

function handOffTakeMovesTheRecord(take HandOffTake) returns bool
	return match take 'take'
		cellOccupant or
		movedOut or
		promiseMovedIn gives true
		copied or
		promotedLiteral or
		aReferenceOfItsOwn or
		aLentReference or
		aCopyOfItsOwn or
		anOpaqueReference or
		sharedReadOnly gives false
	end 'take'
end 'handOffTakeMovesTheRecord'

type HandedOffArgument
	export let position as ElementIndex
	export let value as ValueId
	export let anchor as Token
	export let door as ThreadHandOffDoor

	static function create(position ElementIndex, value ValueId, anchor Token, door ThreadHandOffDoor) returns Self
		return Self{position: position, value: value, anchor: anchor, door: door}
	end 'create'
end 'HandedOffArgument'

typealias HandedOffArgumentArray = Array with HandedOffArgument

type InterfaceParam
	export let name as immutable ByteArray
	export var interfaceType as MaxonType

	static function create(name ByteArray, interfaceType MaxonType) returns Self
		return Self{name: name, interfaceType: interfaceType}
	end 'create'
end 'InterfaceParam'

function asyncArgumentMayRideInACell(passing ArgumentPassing, argTag ValueTypeTag) returns bool
	return match passing 'passing'
		byValue gives false
		byReference or
		undecided gives parameterCellCrossesASpawn(argTag)
	end 'passing'
end 'asyncArgumentMayRideInACell'

function subscriptDepthAfter(kind TokenKind, depth BracketDepth) returns BracketDepth
	if kind == TokenKind.leftBracket 'opens'
		return depth + 1
	end 'opens'

	if kind == TokenKind.rightBracket and depth > 0 'closes'
		return depth - 1
	end 'closes'

	return depth
end 'subscriptDepthAfter'

union CellOccupantReadColumn
	unwritten
	entries(reads CellOccupantReadMap)
end 'CellOccupantReadColumn'

function withCellOccupantRead(column CellOccupantReadColumn, occupant ValueId, read CellOccupantRead) returns CellOccupantReadColumn
	match column 'state'
		unwritten then return CellOccupantReadColumn.entries(singleCellOccupantRead(occupant, read: read))
		entries(reads) then reads.upsert(occupant, value: read)
	end 'state'

	return column
end 'withCellOccupantRead'

function singleCellOccupantRead(occupant ValueId, read CellOccupantRead) returns CellOccupantReadMap
	let reads = CellOccupantReadMap.create()
	reads.upsert(occupant, value: read)
	return reads
end 'singleCellOccupantRead'

function cellOccupantReadOf(column CellOccupantReadColumn, occupant ValueId) returns CellOccupantRead throws AbsentError
	match column 'state'
		unwritten then throw AbsentError.absent
		entries(reads) then return try reads.get(occupant) otherwise throw AbsentError.absent
	end 'state'
end 'cellOccupantReadOf'

function forgetCellOccupantRead(column CellOccupantReadColumn, occupant ValueId)
	match column 'state'
		unwritten then panic("forgetCellOccupantRead: v{occupant} is forgotten from a body that read no cell")
		entries(reads) then _ = reads.remove(occupant)
	end 'state'
end 'forgetCellOccupantRead'

enum CellOccupantExclusivity
	sole
	unproven
	coOwned
end 'CellOccupantExclusivity'

function joinedOccupantExclusivity(a CellOccupantExclusivity, b CellOccupantExclusivity) returns CellOccupantExclusivity
	if a == CellOccupantExclusivity.coOwned or b == CellOccupantExclusivity.coOwned 'eitherHasASecondOwner'
		return CellOccupantExclusivity.coOwned
	end 'eitherHasASecondOwner'

	if a == CellOccupantExclusivity.unproven or b == CellOccupantExclusivity.unproven 'eitherIsUnproven'
		return CellOccupantExclusivity.unproven
	end 'eitherIsUnproven'

	return CellOccupantExclusivity.sole
end 'joinedOccupantExclusivity'

