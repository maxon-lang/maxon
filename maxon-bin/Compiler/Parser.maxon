let EntryKeyFieldIndex = 0

function typeIsABareNumber(t MaxonType) returns bool
	let tag = maxonTypeTag(t)
	return tag == ValueTypeTag.integer or tag == ValueTypeTag.float
end 'typeIsABareNumber'

typealias FrozenTupleMap = Map with (ValueId, ValueIdArray)

