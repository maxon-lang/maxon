			return right
		end 'onlyTheRight'

		if rosterIsEmpty(right) 'onlyTheLeft'
			return left
		end 'onlyTheLeft'

		let ranges = RangedTypeAliasArray.create(0)
		ranges.append(self.rangesOf(left))

		for alias in self.rangesOf(right) 'eachRightRange'
			if not rangesInclude(ranges, alias: alias) 'aNewRange'
				ranges.push(alias.clone())
			end 'aNewRange'
		end 'eachRightRange'

		self.joins.push(LetCastJoin.create(left, right: right, ranges: ranges))
		return LetCastRoster.joined(self.joins.count() - 1)
	end 'join'

	function readsIn(roster LetCastRoster) returns LetCastReadIndexArray
		let found = LetCastReadIndexArray.create(0)
		let pendingJoins = LetCastReadIndexArray.create(0)
		self.fileRoster(roster, found: found, pendingJoins: pendingJoins)

		while not pendingJoins.isEmpty() 'eachJoin'
			let next = try pendingJoins.pop() otherwise panic("LetCastState.readsIn: pop on the join stack the loop condition found non-empty")
			let join = self.joinAt(next)
			self.fileRoster(join.right, found: found, pendingJoins: pendingJoins)
			self.fileRoster(join.left, found: found, pendingJoins: pendingJoins)
		end 'eachJoin'

		return found
	end 'readsIn'

	function fileRoster(roster LetCastRoster, found LetCastReadIndexArray, pendingJoins LetCastReadIndexArray)
		match roster 'kind'
			none then break
			single(index) then found.push(index)
			joined(index) then pendingJoins.push(index)
		end 'kind'
	end 'fileRoster'
end 'LetCastState'

union LetCastTracking
	none
	tracking(state LetCastState)
end 'LetCastTracking'

let noLetCasts = LetCastTracking.none

union RecordedCast
	nothingRecorded
	recorded(first ElementIndex, pastEnd ElementIndex)
end 'RecordedCast'

union LetCastClaimRule
	everyRead
	readsRepeating(destination RangedTypeAlias)
	readsNamingAnotherThan(target RangedTypeAlias)

	function claims(cast LiteralCast) returns bool
		return match self 'rule'
			everyRead gives true
			readsRepeating(destination) gives cast.repeats(destination)
			readsNamingAnotherThan(target) gives not cast.repeats(target)
		end 'rule'
	end 'claims'
end 'LetCastClaimRule'

function letCastTracksAConstant(cast LiteralCast, constant LetCastConstant) returns bool
	if tagIsFloat(cast.literalTag) != aliasIsFloat(cast.target) 'aDomainConversion'
		return false
	end 'aDomainConversion'

	return match constant 'kind'
		unknown gives false
		integer or
		real gives true
	end 'kind'
end 'letCastTracksAConstant'

// Operands within ±(2^31 - 1) keep `+`, `-` and `*` from wrapping, so a folded value is exact.
let LetCastIntegerOperandLimit = 2147483647

function integerWithinOperandLimit(value FullRangeInt) returns bool
	return value >= 0 - LetCastIntegerOperandLimit and value <= LetCastIntegerOperandLimit
end 'integerWithinOperandLimit'

function foldLetCastConstants(op MaxonBinOp, lhs LetCastConstant, rhs LetCastConstant) returns LetCastConstant
	match lhs 'left'
		integer(a) then return foldIntegerWithConstant(op, a: a, rhs: rhs)
		real(a) then return foldRealWithConstant(op, a: a, rhs: rhs)
		unknown then return LetCastConstant.unknown
	end 'left'
end 'foldLetCastConstants'

function foldIntegerWithConstant(op MaxonBinOp, a FullRangeInt, rhs LetCastConstant) returns LetCastConstant
	match rhs 'right'
		integer(b) then return foldIntegerConstants(op, a: a, b: b)
		real or
		unknown then return LetCastConstant.unknown
	end 'right'
end 'foldIntegerWithConstant'

function foldIntegerConstants(op MaxonBinOp, a FullRangeInt, b FullRangeInt) returns LetCastConstant
	if not integerWithinOperandLimit(a) or not integerWithinOperandLimit(b) 'couldWrap'
		return LetCastConstant.unknown
	end 'couldWrap'

	match foldIntBinOp(op, lhs: a, rhs: b) 'folded'
		folded(value) then return LetCastConstant.integer(value)
		notFoldable then return LetCastConstant.unknown
	end 'folded'
end 'foldIntegerConstants'

function foldRealWithConstant(op MaxonBinOp, a FullRangeInt, rhs LetCastConstant) returns LetCastConstant
	match rhs 'right'
		real(b) then return foldRealConstants(op, a: a, b: b)
		integer or
		unknown then return LetCastConstant.unknown
	end 'right'
end 'foldRealWithConstant'

function foldRealConstants(op MaxonBinOp, a FullRangeInt, b FullRangeInt) returns LetCastConstant
	match foldFloatBinOp(op, lhs: a, rhs: b) 'folded'
		folded(bits) then return LetCastConstant.real(bits)
		notFoldable then return LetCastConstant.unknown
	end 'folded'
end 'foldRealConstants'

function letCastConstantFits(constant LetCastConstant, alias RangedTypeAlias) returns bool
	return match constant 'kind'
		integer(value) gives not aliasIsFloat(alias) and literalInRange(value, low: alias.low, high: alias.high, isFloat: false, writtenNegative: value < 0, writtenAboveSignedMax: false)
		real(bits) gives aliasIsFloat(alias) and literalInRange(bits, low: alias.low, high: alias.high, isFloat: true, writtenNegative: false, writtenAboveSignedMax: false)
		unknown gives false
	end 'kind'
end 'letCastConstantFits'

function constantFitsEveryRange(constant LetCastConstant, ranges RangedTypeAliasArray) returns bool
	for alias in ranges 'eachRange'
		if not letCastConstantFits(constant, alias: alias) 'outgrowsItsOwnAlias'
			return false
		end 'outgrowsItsOwnAlias'
	end 'eachRange'

	return true
end 'constantFitsEveryRange'

// The op index of each character literal's `stringLiteral`, filed as it is emitted so the retype to a
// codepoint is an O(1) read rather than `ValueOriginTable`'s linear scan.
union CharLiteralOpTable
	unwritten
	entries(filed CharLiteralOpMap)
end 'CharLiteralOpTable'

let noCharLiteralOps = CharLiteralOpTable.unwritten

typealias PlainConstantArrayMap = Map with (ValueId, FullRangeIntArray)

union PlainConstantArrayTable
