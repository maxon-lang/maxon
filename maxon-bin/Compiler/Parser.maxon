	static function create() returns LetCastState
		return Self{bindings: LetCastSubjectMap.create(), reads: LetCastReadArray.create(0), sites: LetCastSiteMap.create(), derived: LetCastDerivationMap.create(), joins: LetCastJoinArray.create(0)}
	end 'create'

