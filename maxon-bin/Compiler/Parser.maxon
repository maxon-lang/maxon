// Where the innermost mutable binding of each name sits in `mutableVars`.
union MutableVarNameIndex
	unwritten
	entries(byName MutableVarPositionByName)
end 'MutableVarNameIndex'

let noMutableVarInnermost = MutableVarNameIndex.unwritten

// Drop `value`'s mark through the set's own `var` alias — a `match` arm binds its payload IMMUTABLY, so a
// mutation may not be written in the arm (E3207).
function removeMark(marked ValueMarkSet, value ValueId)
	let target = marked
	_ = target.remove(value)
end 'removeMark'

function withMarkCarried(destination ValueMarkColumn, to ValueId, source ValueMarkColumn, from ValueId) returns ValueMarkColumn
	if not valueIsMarked(source, value: from) 'nothingToCarry'
		return destination
	end 'nothingToCarry'

	return withValueMarked(destination, value: to)
end 'withMarkCarried'

// Drop `value`'s mark. A column nothing has written holds no mark to drop, so the answer needs no
// installation and the caller needs no column back.
function unmarkValue(column ValueMarkColumn, value ValueId)
	match column 'state'
		unwritten then break
		entries(marked) then removeMark(marked, value: value)
	end 'state'
end 'unmarkValue'

// ⭐ **WHICH DECLARATION A PARAMETER LIST BELONGS TO, asked for exactly one purpose: may a parameter here
// carry a DEFAULT?** Three declaration forms share `parseFunctionParameters`, and only
// one of them has what a default needs — a NAME a call site can look the declaration up by:
//
//   • a declared FUNCTION (free, static or instance method) is registered in `funcSignatures` under
//     `name`, which is exactly what a call site slots its arguments against and what the whole-program
//     sweep publishes the defaults under. This is the arm that captures.
//   • a CLOSURE LITERAL is called INDIRECTLY, through a function value: the call site has no callee name
//     at all, so nothing there can ever discover that an argument may be omitted.
//   • an INTERFACE REQUIREMENT is in no signature registry — a witness dispatch slots against the
//     interface's formals (`slottedWitnessArgs`) and has no declaration to read a default from.
//
// So the two refusing arms are not "not yet implemented for this form"; each names the thing that is
// missing. Carrying the name in the union rather than beside a `bool` is what makes "allowed" and "the
// name it is allowed under" one fact instead of two that can disagree.
union ParamDefaultOwner
	declaredFunction(name immutable ByteArray, declaredAt Token)
	closureLiteral
	interfaceRequirement
end 'ParamDefaultOwner'

// The parameter types a call argument offers an untyped closure literal written at it:
// `scores.sortBy(function(left, right) gives right.compare(left))`.
//
// They are read off the callee's declaration, not inferred: the parser is single-pass, so a
// closure's parameter types must be known before its body is read. `Array.sortBy(cmp SortComparator)`
// names `function(Element, Element) returns Ordering`, and `closureParamOfferAt` hands those down.
//
// ⚠ The offer is positional and its arity is the declared one. Parameter k takes type k, and a
// parameter past the end is E2003, even when an earlier parameter declared its own. Typing it from
// another slot would lift a closure with more ABI slots than its caller passes:
// `nums.map(function(a, b) gives a + b)` would read the function record as `b` and print a
// plausible number.
union ClosureParamOffer
	// One type per parameter of the function type the argument's parameter is declared with, in order.
	offered(paramTypes MaxonTypeArray, result ClosureResult, aliasName immutable ByteArray)

	// No position is offering a type, so an omitted parameter type is a parse error.
	none

	// An argument of a member called on an undeclared call's result: the member, and so its parameter
	// types, cannot be known, and each omitted type is `unresolved`. Sound only because E3004 at that
	// call rejects the program before lowering.
	deferred
end 'ClosureParamOffer'

// The one `none`, shared: a payload-free union case is still a heap object, and this is the answer for nearly
// every argument that opens with `function`.
let noClosureParamOffer = ClosureParamOffer.none
let noResultOrigin = ReceiverOrigin.unattributed

union PendingClosureParamOffer
	none
	at(tokenIndex ElementIndex, offer ClosureParamOffer)
end 'PendingClosureParamOffer'

union ClosureResult
	declared(returnType MaxonType, offeredAlias immutable ByteArray, origin ReceiverOrigin)
	inferred
end 'ClosureResult'

function closureResultOf(offer ClosureParamOffer) returns ClosureResult
	return match offer 'offer'
		offered(_, result, _) gives result.clone()
		deferred or
		none gives ClosureResult.inferred
	end 'offer'
end 'closureResultOf'

function resultOriginOf(result ClosureResult) returns ReceiverOrigin
	return match result 'result'
		declared(_, _, origin) gives origin.clone()
		inferred gives ReceiverOrigin.unattributed
	end 'result'
end 'resultOriginOf'

function offeredAliasOf(result ClosureResult) returns immutable ByteArray
	return match result 'result'
		declared(_, offeredAlias, _) gives offeredAlias
		inferred gives EmptySourceText
	end 'result'
end 'offeredAliasOf'

function inferredClosureResultType(bodyType MaxonType) returns MaxonType
	return MaxonType.integer if tagIsUnresolved(maxonTypeTag(bodyType)) else bodyType
end 'inferredClosureResultType'

// ⭐⭐ **WHOSE DEFAULT A CAPTURED HELPER PRODUCES — AND IT IS ALSO HOW THE HELPER'S NAME IS KNOWN**, which
// is the one thing the language's two default doors do differently.
//
//   • A PARAMETER's helper is named by the parameter's CALL-ALIGNED POSITION, which the declaration sweep
//     and the real parse compute from different starting points (an instance method's receiver shifts
//     every parameter by one). So exactly ONE of them may derive it — the sweep, which must publish it
//     whole-program anyway — and the drain READS it back (`sweptParamDefaultHelperName`). This arm
//     therefore carries the inputs of that lookup and no name.
//   • A FIELD's helper is named by `(type name, field name)` and neither is positional, so the ONE shared
//     field reader mints the identical name on both walks by construction. It is minted at the
//     declaration, because the LAYOUT has to carry it too (`FieldDefault.helper`), and the same bytes ride
//     here rather than being derived a second time.
//
// `sourceName` is `declaredMethodName`'s answer, so it is the key the sweep registered the declaration
// under — a contested free function's mint included — and what a call site in any file looks the default
// up by.
export union DefaultHelperOwner
	parameter(sourceName immutable ByteArray, paramIndex ParamCount)
	field(helperName immutable ByteArray, place String, capability ParamCapability)
end 'DefaultHelperOwner'

union FieldDefaultSlot
	notADefault
	writable(place String)
	frozen
end 'FieldDefaultSlot'

// One captured default awaiting its helper's parse (a parameter's or a field's): whose
// default it is, the declared type — which is the helper's declared RETURN type — and the token region the
// default expression occupies, whose first index is where the drain sets the cursor.
//
// ⭐ **ONE LIST FOR BOTH DOORS, because a default value is ONE mechanism.** The drain, the per-function
// column reset, the `IrFunction` and the end-of-default check are the same for a parameter and a field;
// only the name and the tier differ, and `DefaultHelperOwner` is exactly those two.
export type PendingDefaultHelper
	export let owner as DefaultHelperOwner
	export let declaredType as MaxonType
	export let exprStart as ElementIndex

	// The token the CAPTURE skipped to — the `,`/`)` that ends a parameter default (`expressionEndFrom`),
	// the line end that ends a field one (`statementEndIndexIn`). The drain parses one expression from
	// `exprStart` and must arrive exactly here: the capture already decided where the author's default
	// ends, so any gap between the two is text the author wrote and the compiler was about to ignore.
	// Recorded rather than recomputed at the drain — a second walk is a second answer, and this file has
	// paid for that twice already (see `sweptParamDefaultHelperName`).
	export let exprEnd as ElementIndex

	// ⭐⭐ **THE DECLARATION THE DEFAULT WAS WRITTEN INSIDE, `fileScope` for one written at file
	// scope.** The drain runs at the END of `parseModule`, where no declaration scope is open — so
	// without this a default expression is re-parsed as if it had been written at top level, and
	// every name that is only meaningful INSIDE the declaration stops meaning it. **MEASURED, both
	// doors, on a non-generic type:** `var items = Items.create()` and `function fill(seed
	// Items = Items.create())` inside a `type Box` declaring `typealias Items = Array with Integer`
	// both gave `E3005 Cannot return 'unknown' from function declared to return 'Box.Items'` — `Items`
	// denoted nothing, so the call had no return type at all. The same line is `stdlib/Map.maxon:24`.
	//
	// It is the type's NAME and nothing more: every other part of the scope is a property of the type that
	// the whole-program index already holds (`restoreDeclaringTypeScope` reads them off its `StructLayout`),
	// and a captured copy of a fact the index owns is the second copy this file keeps paying for.
	export var enclosingType as EnclosingTypeScope

	static function create(owner DefaultHelperOwner, declaredType MaxonType, exprStart ElementIndex, exprEnd ElementIndex, enclosingType EnclosingTypeScope) returns PendingDefaultHelper
		return Self{owner: owner, declaredType: declaredType, exprStart: exprStart, exprEnd: exprEnd, enclosingType: enclosingType}
	end 'create'
end 'PendingDefaultHelper'

export typealias PendingDefaultHelperArray = Array with PendingDefaultHelper

// ⚠ **IT IS A FREE FUNCTION, NOT TWO LINES INSIDE THE WALK, AND THE REASON IS A COMPILER SHAPE RATHER
// THAN ANYTHING ABOUT DEFAULTS.** Reassigning the walk's own enclosing binding from INSIDE a branch
// leaves that binding undefined on the merge path — `E9001 … does not dominate` — so the fresh array has
// to be produced by something the branch merely CALLS. The reason lives here because this is the last place
// that obeys it. (A loop the helper happens to contain is incidental; the reassignment-in-a-branch is the
// shape.)
function materializedPendingDefaultHelpers(pending PendingDefaultHelperArray, anchor PendingDefaultHelperArray) returns PendingDefaultHelperArray
	if pending is anchor 'firstDefault'
		return PendingDefaultHelperArray.create(0)
	end 'firstDefault'

	return pending
end 'materializedPendingDefaultHelpers'

// ⭐⭐ **"THIS FUNCTION DECLARES NO RANGED-ALIAS PARAMETER" — the answer `rangedParamSites` gives INSTEAD
// OF AN EMPTY ARRAY, and the reason it is an error rather than a value.**
//
// An empty list here would be a SENTINEL: it would say *"there is nothing to report"* in the one
// spelling that is also a perfectly good list, so every caller would be free to take it, bind it,
// and carry it on. **A thrown error has no such spelling.** The caller must NAME the empty case, at
// the call site, in the one place that knows what the absence means — and the producer never
// fabricates a list it has nothing to put in.
//
// ⛔ **IT IS DELIBERATELY NOT A `SourceParseError`.** That union is the parser's DIAGNOSTIC channel —
// `queryParseOps` turns anything thrown there into a project diagnostic — and a function with no ranged
// parameter is not a defect in the program, it is most functions. Routing it through `SourceParseError` would
// either surface a compile error on valid source or require a caller to swallow a diagnostic, and a
// discarded diagnostic is worse than the sentinel this replaces. `ScopeError` is the shape copied: a
// small `implements Error` union beside its raiser, carrying no code because it never reaches a reader.
union RangedParamError implements Error
	noRangedParameters
end 'RangedParamError'

// `FieldDefault.helper` and `emptyCreateHelper` differ only in the layout hash and the `let`
// image-data fold in `SignatureIndex`; every Parser reader that only calls the helper treats them
// alike, and an or-pattern cannot bind their shared payload (E3129).
union FieldDefaultFill
	none
	literal(value ConstValue)
	callsHelper(name immutable ByteArray)
end 'FieldDefaultFill'

function fieldDefaultFill(layout StructLayout, index FieldIndex) returns FieldDefaultFill
	return match layout.fieldDefault(index) 'declared'
		none gives FieldDefaultFill.none
		literal(given) gives FieldDefaultFill.literal(given)
		helper(name) gives FieldDefaultFill.callsHelper(name)
		emptyCreateHelper(name) gives FieldDefaultFill.callsHelper(name)
	end 'declared'
end 'fieldDefaultFill'

type FixedElementCountScan
	export let readsFixedElementCount as bool
	export let callees as NameRoster
	export let sizedContainerSelfCallees as NameRoster
	export let endPos as ElementIndex

	static function create(readsFixedElementCount bool, callees NameRoster, sizedContainerSelfCallees NameRoster, endPos ElementIndex) returns FixedElementCountScan
		return Self{readsFixedElementCount: readsFixedElementCount, callees: callees, sizedContainerSelfCallees: sizedContainerSelfCallees, endPos: endPos}
	end 'create'
end 'FixedElementCountScan'

enum ByRefHandOff
	none
	value
	typeParameterValue
end 'ByRefHandOff'

union CallOpening
	notACall
	callResult
	throughReceiver(name immutable ByteArray)
	bare(name immutable ByteArray)
end 'CallOpening'

type BodyWalk
	export var braceStack as BoolArray
	export var openBrackets as TokenIndexArray
	export var argumentIndexes as TokenIndexArray
	export var openSubscripts as BracketDepthArray
	export var blockDepth as BlockDepth

	static function create() returns BodyWalk
		return Self{braceStack: BoolArray.create(0), openBrackets: TokenIndexArray.create(0), argumentIndexes: TokenIndexArray.create(0), openSubscripts: BracketDepthArray.create(0), blockDepth: 0}
	end 'create'

	export function insideASubscript() returns bool
		return self.openSubscripts.count() > 0 and (try self.openSubscripts.last() otherwise panic("BodyWalk.insideASubscript: openSubscripts is non-empty by the guard")) > 0
	end 'insideASubscript'

	export function argumentIndex() returns ElementIndex
		return try self.argumentIndexes.last() otherwise panic("BodyWalk.argumentIndex: asked outside every open bracket")
	end 'argumentIndex'
end 'BodyWalk'

enum BodyExtent
	block
	expression
end 'BodyExtent'

typealias NonCallNameSites = Map with ByteArray, ElementIndex

type NonCallNameIndex
	export let start as ElementIndex
	export var scannedTo as ElementIndex
	export var firstSites as NonCallNameSites

	static function from(start ElementIndex) returns NonCallNameIndex
		return Self{start: start, scannedTo: start, firstSites: NonCallNameSites.create()}
	end 'from'
end 'NonCallNameIndex'

type IndirectCallScan
	export var boundNames as CellLocalNameSet
	export var nonCallNames as NonCallNameIndex

	static function over(nonCallNames NonCallNameIndex, params NameRoster, enclosing CellLocalNameRoster) returns IndirectCallScan
		let names = CellLocalNameSet.create()

		for param in params 'eachParameter'
			if bodyCanReadName(param) 'aReadableParameter'
				names.insert(param)
			end 'aReadableParameter'
		end 'eachParameter'

		match enclosing 'chain'
			unwritten then break
			entries(outer) then insertAllNames(names, source: outer)
		end 'chain'

		return Self{boundNames: names, nonCallNames: nonCallNames}
	end 'over'
end 'IndirectCallScan'

function insertAllNames(names CellLocalNameSet, source CellLocalNameSet)
	for name in source 'eachName'
		names.insert(name)
	end 'eachName'
end 'insertAllNames'

union DurableOpaqueSlot
	inRecord(box ValueId)
	inCell
end 'DurableOpaqueSlot'

// ⭐ **ONE SELF-CALL FORWARD EDGE for the transitive array-feed fixpoint** — the caller's
// CALL-ALIGNED parameter `callerParamPos` is passed to the sibling method `calleeName` as an argument: its FIRST
// positional argument when `argLabel` is empty, or the labelled argument `argLabel:` otherwise. The callee's own
// parameter position is resolved once every sibling's parameter list is known
// (`Parser.solveAndPublishTransitiveFeeds`), exactly as a call site slots a labelled argument against the
// callee's `paramNames` and the first positional argument against slot 1 (the receiver being slot 0).
type ForwardFeedEdge
	export let callerParamPos as ParamCount
	export let calleeName as immutable ByteArray
	export let argLabel as immutable ByteArray

	static function create(callerParamPos ParamCount, calleeName ByteArray, argLabel ByteArray) returns ForwardFeedEdge
		return Self{callerParamPos: callerParamPos, calleeName: calleeName, argLabel: argLabel}
	end 'create'
end 'ForwardFeedEdge'

typealias ForwardFeedEdgeArray = Array with ForwardFeedEdge

// ⭐ **ONE BARE TYPE-PARAMETER ARGUMENT found in a call's argument list** — the CALL-ALIGNED parameter position
// it references, and the token it sits at (which `argLabelBefore` reads its label from). The two feed scans
// (`markOpaqueContainerMutatorFeeds`, an array move-in; `collectForwardFeedEdges`, a self-call forward)
// ask the same question of an argument list and share this one answer (`bareTypeParamArgsIn`), so a
// refinement to what counts as a bare type-parameter argument cannot land on only one of the two — and a
// disagreement there is not a diagnostic, it is a feed marked at one door and missed at the other.
type BareTypeParamArg
	export let paramIndex as ParamCount
	export let typeParamPosition as ElementIndex
	export let valuePos as ElementIndex

	static function create(paramIndex ParamCount, typeParamPosition ElementIndex, valuePos ElementIndex) returns BareTypeParamArg
		return Self{paramIndex: paramIndex, typeParamPosition: typeParamPosition, valuePos: valuePos}
	end 'create'
end 'BareTypeParamArg'

typealias BareTypeParamArgArray = Array with BareTypeParamArg

type BareParamArg
	export let paramIndex as ParamCount
	export let valuePos as ElementIndex

	static function create(paramIndex ParamCount, valuePos ElementIndex) returns BareParamArg
		return Self{paramIndex: paramIndex, valuePos: valuePos}
	end 'create'
end 'BareParamArg'

typealias BareParamArgArray = Array with BareParamArg

// ⭐ **ONE GENERIC METHOD's FEED SIGNALS for the transitive array-feed fixpoint** — its
// parameter names and type-parameter positions, the DIRECT array-mutator feeds its body performs
// (`items.push(param)`), and the self-call forward edges out of it (`self.N(param)` / bare-sibling `N(param)`).
// `endPos` is the token just past the method's `end`, so the type-body walk resumes there. Returned per method
// by `Parser.scanOneMethodFeedSignals`.
//
// ⚠ `takesReceiver` is what `paramNames` is ALIGNED to (`SelfParamName` at slot 0 when true), carried rather
// than re-derived from the names: the fixpoint slots a POSITIONAL forward argument to the callee's first user
// parameter, which is slot 1 with a receiver and slot 0 without (a static can be a feed callee).
type MethodFeedScan
	export let funcName as immutable ByteArray
	export let site as immutable ByteArray
	export let paramNames as NameRoster
	export let typeParamPositions as TypeParamSlots
	export let directFeeds as TypeParamFeedArray
	export let edges as ForwardFeedEdgeArray
	export let takesReceiver as bool
	export let endPos as ElementIndex

	static function create(funcName ByteArray, site ByteArray, paramNames NameRoster, typeParamPositions TypeParamSlots, directFeeds TypeParamFeedArray, edges ForwardFeedEdgeArray, takesReceiver bool, endPos ElementIndex) returns MethodFeedScan
		return Self{funcName: funcName, site: site, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: directFeeds, edges: edges, takesReceiver: takesReceiver, endPos: endPos}
	end 'create'
end 'MethodFeedScan'

typealias MethodFeedScanArray = Array with MethodFeedScan

// ⭐ **WHICH KEYWORD OPENED THE DECLARATION `parseFunction` IS READING.** The two share their whole BODY —
// the per-function reset block, the parameter binding, the body parse, the close, the registration — and
// differ only in their HEAD (what is consumed before the body) and in whether the closing `end` label is
// checked. So they are one routine with a stated form rather than two, which is what keeps a `test` from
// growing its own copy of ~120 lines of per-function column resets that must never fall out of step.
enum DeclaredHeadForm
	// `function <name> (…) [returns T] [throws E]`.
	declaredFunction

	// `test '<prose name>'` — no parameters, no `returns`, and an IMPLIED `throws TestFailure` nobody writes.
	testDeclaration
end 'DeclaredHeadForm'

// One `test` declaration a file has already minted a symbol for — the pair E3107 compares and names. Its
// own type rather than two parallel arrays for the reason `EnumLayout.addCase` states about its columns: a
// pusher that recorded a symbol and forgot the prose would name the WRONG earlier test in the message.
type MintedTest
	export let symbol as immutable ByteArray
	export let prose as immutable ByteArray
	export let line as LineNumber
	export let column as ColumnNumber

	static function create(symbol immutable ByteArray, prose ByteArray, line LineNumber, column ColumnNumber) returns MintedTest
		return Self{symbol: symbol, prose: prose, line: line, column: column}
	end 'create'
end 'MintedTest'

typealias MintedTestArray = Array with MintedTest

// What kind of body the parser is inside, which decides where a throw goes:
//
//   • a `test` body gives every throwing call, witness dispatch and `await` no enclosing `try`
//     claims an implied handler, and admits a bare `try` on any error type; a foreign error is
//     reported (`emitUncaughtTestThrow`, `specs/test-uncaught-throw.md`);
//   • a closure body cannot declare `throws` (E3101), so its refusal of a bare `try` is
//     `SourceParseError.bareTryInAClosure`.
//
// One field with three states rather than two bools, because the states are exclusive: a closure
// written inside a test body is a closure, and its throwing calls still need a `try`
// (`test-uncaught-throw/error.closure-in-a-test-is-not-a-test`).
enum EnclosingBodyKind
	// An ordinary `function`, a method, or a synthesized parameter-default helper.
	declaredFunction

	// A `test` declaration's body.
	testBody

	// A lifted closure literal's body, whatever kind of body it was written inside.
	closureBody
end 'EnclosingBodyKind'

enum ThrowRouteDestination
	nowhere
	enclosingTryBlock
	impliedTestHandler
end 'ThrowRouteDestination'

// A `try` target or a `for` source claims only the op that produces its value, which its owner
// rewrites into the try channel itself. Every other throwing op inside is released to the enclosing
// handler at the moment the parser learns its value is an operand, while it is still the current
// block's last op (`releaseCompletedOperand`). A construct that forms an operand without releasing
// leaves such an op plain, and it is then refused with E3057.
enum ThrowRouteClaim
	unclaimed
	everyDestination
	impliedTestHandlerOnly
end 'ThrowRouteClaim'

// A `for` source's claim covers only a test body's implied handler, so there a cursor-producing
// call that throws `IterationError` is absorbed as the loop's entry seed rather than routed: an
// empty collection runs zero trips instead of failing the test.
let IterationSourceClaim = ThrowRouteClaim.impliedTestHandlerOnly

function claimCovers(claim ThrowRouteClaim, destination ThrowRouteDestination) returns bool
	return match claim 'claim'
		unclaimed gives false
		everyDestination gives true
		impliedTestHandlerOnly gives destination == ThrowRouteDestination.impliedTestHandler
	end 'claim'
end 'claimCovers'

union RecordedTryTarget
	nothingRecorded
	recorded(opIdx ElementIndex, target TryTarget)
end 'RecordedTryTarget'

union SpawnStartReply
	noReply
	viaCell(callee immutable ByteArray)
end 'SpawnStartReply'

// How a `spawn` of a throwing factory awaits its start. `caught` is the target of a `try`, which
// awaits with a plain await op; `routed` awaits through the throw route a bare throwing call takes,
// so a failure nothing catches is E3057.
enum SpawnStartHandling
	routed
	caught
end 'SpawnStartHandling'

function recordedTryTargetOf(record RecordedTryTarget, opIdx ElementIndex) returns TryTarget
	return match record 'record'
		recorded(recordedIdx, target) gives target if recordedIdx == opIdx else unrecordedTryTarget(opIdx)
		nothingRecorded gives unrecordedTryTarget(opIdx)
	end 'record'
end 'recordedTryTargetOf'

function unrecordedTryTarget(opIdx ElementIndex) returns TryTarget
	panic("recordedTryTargetOf: the op at {opIdx} is not the one its door recorded — `emitAwaitOp` and `emitWitnessDispatch` record the target of the op they emit, and whoever reads it back does so before either emits another")
end 'unrecordedTryTarget'

union RecordedSend
	nothingRecorded
	recorded(opIdx ElementIndex, funcIndex ElementIndex, send SentMessage)
end 'RecordedSend'

union SendTimeoutArgument
	absent
	given(value ValueId)
end 'SendTimeoutArgument'

union UnsettledSend
	settled
	pending(opIdx ElementIndex, range SourceRange)
end 'UnsettledSend'

type SentLeg
	export let refusedId as BlockId
	export let flag as ValueId
	export let fused as ValueId
	export let members as TryBlockErrorMemberArray

	static function create(refusedId BlockId, flag ValueId, fused ValueId, members TryBlockErrorMemberArray) returns SentLeg
		return Self{refusedId: refusedId, flag: flag, fused: fused, members: members}
	end 'create'

	export function holdsAUnion() returns bool
		return self.members.count() > 1
	end 'holdsAUnion'
end 'SentLeg'

union SentLegSlot
	none
	held(leg SentLeg)
end 'SentLegSlot'

type JoinedError
	export let flag as ValueId
	export let fused as ValueId

	static function create(flag ValueId, fused ValueId) returns JoinedError
		return Self{flag: flag, fused: fused}
	end 'create'
end 'JoinedError'

type SentLegJoin
	export let slot as SentLegSlot
	export let entryBlockId as BlockId
	export let handlerFlag as ValueId
	export let handlerFused as ValueId
	export let joined as JoinedError

	static function create(slot SentLegSlot, entryBlockId BlockId, handlerFlag ValueId, handlerFused ValueId, joined JoinedError) returns SentLegJoin
		return Self{slot: slot, entryBlockId: entryBlockId, handlerFlag: handlerFlag, handlerFused: handlerFused, joined: joined}
	end 'create'
end 'SentLegJoin'

type SentMessage
	export let messageName as immutable ByteArray
	export let spelling as immutable ByteArray
	export let handle as ValueId
	export let staging as ValueId
	export let reply as ServiceReplyValue
	export let request as immutable EnumLayout
	export let caseIndex as CaseIndex
	let handBack as SharedSlotHandBackArray

	static function create(messageName immutable ByteArray, spelling immutable ByteArray, handle ValueId, staging ValueId, reply ServiceReplyValue, request immutable EnumLayout, caseIndex CaseIndex, handBack SharedSlotHandBackArray) returns SentMessage
		return Self{messageName: messageName, spelling: spelling, handle: handle, staging: staging, reply: reply, request: request, caseIndex: caseIndex, handBack: handBack}
	end 'create'

	function handBackOf(slot PayloadSlotIndex) returns SharedSlotHandBack
		return try self.handBack.get(slot) otherwise panic("SentMessage.handBackOf: handBack.get OOB at {slot} — the column is sized to the request variant's payload count, and a send-error union's slots map onto it slot for slot")
	end 'handBackOf'

	function requestPayloadAt(slot PayloadSlotIndex) returns PayloadField
		return try self.request.payloadsAt(self.caseIndex).get(slot) otherwise panic("SentMessage.requestPayloadAt: payloadsAt.get OOB at {slot} — the request variant of `{String.from(self.messageName)}` has fewer payload slots than the send-error union claims")
	end 'requestPayloadAt'

	export function sendErrorName() returns immutable ByteArray
		return serviceSendErrorCompanionName(self.spelling)
	end 'sendErrorName'

	export function throwsClause() returns ThrowsClause
		return ThrowsClause.throwing(String.from(self.sendErrorName()))
	end 'throwsClause'

	export function resultValue(sent ValueId) returns ValueId
		return match self.reply 'reply'
			fireAndForget gives sent
			cell(promise) gives promise
		end 'reply'
	end 'resultValue'

	export function awaitsCell(promise ValueId) returns bool
		return match self.reply 'reply'
			fireAndForget gives false
			cell(held) gives held == promise
		end 'reply'
	end 'awaitsCell'
end 'SentMessage'

function recordedSendOf(record RecordedSend, opIdx ElementIndex) returns SentMessage
	return match record 'record'
		recorded(recordedIdx, _, send) gives send if recordedIdx == opIdx else unrecordedSend(opIdx)
		nothingRecorded gives unrecordedSend(opIdx)
	end 'record'
end 'recordedSendOf'

function unrecordedSend(opIdx ElementIndex) returns SentMessage
	panic("recordedSendOf: the op at {opIdx} is not the send `emitServiceSendOp` recorded — whoever rewrites a send into the try channel does so before another send is emitted")
end 'unrecordedSend'

union DroppedReplyAnchor
	atTry(tryTok Token)
	atTheSend
end 'DroppedReplyAnchor'

let StagedWitnessSlotDistance = 1

function stagedWordAt(staged ValueIdArray, slot ElementIndex) returns ValueId
	return try staged.get(slot) otherwise panic("stagedWordAt: staged.get OOB at {slot} — a word was loaded for every payload slot of the send-error union, and an interface value's witness is the slot after it")
end 'stagedWordAt'

function stagedWitnessAt(staged ValueIdArray, slot ElementIndex) returns ValueId
	return stagedWordAt(staged, slot: slot + StagedWitnessSlotDistance)
end 'stagedWitnessAt'

union ReceiverArgument
	passed(value ValueId)
	none
end 'ReceiverArgument'

function receiverArgumentOf(args ValueIdArray) returns ReceiverArgument
	let first = try args.get(0) otherwise return ReceiverArgument.none

	return ReceiverArgument.passed(first)
end 'receiverArgumentOf'

union ReceiverSource
	producedByCall(callee immutable ByteArray, receiver ReceiverArgument)
	boundOutOf(unionName immutable ByteArray)
	unknown
end 'ReceiverSource'

function receiverSourceOfCall(result ValueId, value ValueId, callee ByteArray, receiver ReceiverArgument) returns ReceiverSource
	if result != value 'someOtherValue'
		return ReceiverSource.unknown
	end 'someOtherValue'

	return ReceiverSource.producedByCall(callee, receiver: receiver)
end 'receiverSourceOfCall'

union ValueProducer
	noOwnOp
	at(opIdx ElementIndex)
end 'ValueProducer'

union RoutableOp
	notRoutable
	division(op MaxonBinOp)
	call(result ValueId, callee immutable ByteArray, receiver ReceiverArgument)
	tryChannelCall(result ValueId, callee immutable ByteArray, receiver ReceiverArgument)
	witness(result ValueId)
	await(result ValueId, promise ValueId)
	send(result ValueId)
end 'RoutableOp'

union TryChannelResult
	anyValue
	definedValue(value ValueId)
end 'TryChannelResult'

function tryChannelCallOf(op RoutableOp, opIndex ElementIndex, wanted TryChannelResult) returns DiscardedCallee
	return match op 'op'
		tryChannelCall(result, callee, _) gives DiscardedCallee.named(callee, result: result, opIndex: opIndex) if tryChannelWants(wanted, result: result) else DiscardedCallee.notACall
		notRoutable or
		division or
		call or
		witness or
		send or
		await gives DiscardedCallee.notACall
	end 'op'
end 'tryChannelCallOf'

function tryChannelWants(wanted TryChannelResult, result ValueId) returns bool
	return match wanted 'wanted'
		anyValue gives true
		definedValue(value) gives result == value
	end 'wanted'
end 'tryChannelWants'

function valueProducerIs(producer ValueProducer, opIdx ElementIndex) returns bool
	return match producer 'producer'
		noOwnOp gives false
		at(producerIdx) gives producerIdx == opIdx
	end 'producer'
end 'valueProducerIs'

function routableOpIsAwait(op RoutableOp) returns bool
	return match op 'op'
		await gives true
		notRoutable or
		division or
		call or
		tryChannelCall or
		send or
		witness gives false
	end 'op'
end 'routableOpIsAwait'

function anchorTokenSpanning(range SourceRange) returns Token
	return Token.create(TokenKind.identifier, line: range.line, column: range.column, startByte: range.startByte, endByte: range.endByte)
end 'anchorTokenSpanning'

// ⭐ **WHICH NAMESPACE A DECLARED NAME ENTERS — the one thing `requireUnreservedName`'s two reservations
// answer differently.** The `__` prefix is refused in both; the RECEIVER's name is refused in one only,
// because shadowing is the whole reason that reservation exists and only one of these namespaces can
// shadow anything. It is a scalar and not a bool for the reason `NamePosition` is one: the caller states
// what its declaration IS, and the rule over that is this door's alone.
enum DeclaredNameNamespace
	// A local, a parameter, a field, a function, a type — everything reached by writing the bare name,
	// which is exactly how an instance method's implicit `self` is reached. A binding here would shadow it.
	shadowsTheReceiver

	// An enum or union CASE, reachable only as `TypeName.case`, which shadows nothing — so `enum
	// Marker` may declare a case `self`, and `specs/reserved-self.md` says it may. The compiler's own
	// `TokenKind` is an enum with a case spelled `self`.
	qualifiedByItsType
end 'DeclaredNameNamespace'

// ⛔ **THE EXHAUSTIVE READER, AND IT IS THE WHOLE POINT OF THE ENUM.** An `==` compare against
// `shadowsTheReceiver` at the one call site would make a THIRD case join the non-refusing side silently —
// no compile error, a reservation that quietly stops applying to a namespace nobody decided about. The
// `match` refuses to compile until the new case answers, which is the property a bool never had and the
// reason this is not one. (`enumMatchIsDeclared` and `nameExpectationOf` are the same shape, for the same
// reason.)
function namespaceShadowsTheReceiver(bindsInto DeclaredNameNamespace) returns bool
	return match bindsInto 'which'
		shadowsTheReceiver gives true
		qualifiedByItsType gives false
	end 'which'
end 'namespaceShadowsTheReceiver'

// How many arguments an unparenthesized `implements I with …` clause takes when THIS FILE cannot
// see `I`'s declaration — see `interfaceUsesArity`, which is where the choice is argued. Named
// because it is a deliberate default, not an incidental literal.
let UnresolvableInterfaceUsesArity = 1

// The one `uses` arity at which a parenthesized `with (…)` list is read as a single TUPLE argument rather
// than as a list of bindings — see `parenthesizedWithBindsOneTuple`, which is where the choice is
// argued. Named because it is the arity the rule TURNS ON, not an incidental comparison against one.
let SingleAssociatedType = 1

// ⭐ **HOW MANY ASSOCIATED TYPES A CONFORMANCE `with` CLAUSE BINDS FOR ONE INTERFACE — WHEN THE PROGRAM
// SAYS.** A union rather than a count carrying a default, because the two readers of that number
// need OPPOSITE answers to the unresolvable case and a shared default can only serve one of them:
//
//   • The unparenthesized arm must still decide how many commas to eat, and eats
//     `UnresolvableInterfaceUsesArity` of them (see `interfaceUsesArity`).
//   • The parenthesized arm's SURPLUS REFUSAL must not fire at all. A misspelled interface resolves to
//     nothing, so a default of one would turn every `implements Onee with (A, B)` into an arity
//     complaint about an interface the compiler never found — a false reject whose real error, the
//     whole-program `E3015 … implements unknown interface`, already names the fault precisely.
//
// Folding both into one count is exactly the shape that hides a false reject one level below where the
// rule is tested, so the distinction is carried in the type instead of in a constant.
union ConformanceUsesArity
	declared(count ElementIndex)
	unresolvable
end 'ConformanceUsesArity'

// ⭐⭐ **WHAT A BARE `int`/`float` MEANS AT THE TYPE POSITION BEING READ** — the argument every
// `parseTypeReference` caller must answer, and the roster of the rule's exemptions.
//
// **THREE ARMS AND NOT A `bool` PLUS A SECOND FLAG.** *"The rule does not reach this position"* is a third
// ANSWER to one question, not the absence of an answer to another; a pair would make
// `(admitted, asACastTarget)` representable and meaningless.
//
// ⚠ **IT IS A PARAMETER RATHER THAN A PARSER FIELD, AND THAT IS THE WHOLE DESIGN.** The oracle spells the
// same exemption as a mutable `_parsingTypeAliasRhs` set across the entire RHS — and that field leaking one
// position too far is exactly what opens holes (a const-cast door, and
// generic arguments, which need `RejectBarePrimitiveTypeArgs` bolted on to plug what the field opens).
// A parameter cannot leak past its callee.
//
// **THE EXEMPT POSITIONS, each with the reason it is exempt:**
//   • a GENERIC TYPE ARGUMENT (`parseGenericArgNode`) — `checkGenericArgType` owns this position with TWO
//     rules whose ORDER is load-bearing (E2062 before E2061). Refusing here would preempt both and hand a
//     bare `float` type argument the "declare a ranged typealias" advice, which routes the reader into the
//     very x64 cross-register-file panic E2062 exists to prevent.
//   • a CONFORMANCE `with` ARGUMENT (`readConformanceWithArg`) — a conformance binding is monomorphized per
//     conformer and gets a genuine f64 slot, so E2062's dictionary-passing reason does not apply;
//     `specs/associated-types.md` binds an associated type to bare `float` in six live cases.
//   • `sizeof` / `countof` (`parseSizeof`, `parseCountof`) — they ask about a REPRESENTATION, not about a
//     value's domain, so there is no range for an alias to carry. The oracle admits them too
//     (`ParseTypeQueryArg`), and `specs/sizeof.md` writes `sizeof(int)` and `sizeof(float)`.
//   • ANYWHERE INSIDE A `typealias` RHS — the ranged form parses `int(`/`float(` itself and never reaches
//     here, but a FUNCTION alias's parameters and return and a TUPLE alias's elements do. ⭐ MEASURED
//     against the oracle, all four spellings: `typealias IntOp = function(n int) returns int` and
//     `typealias Pair = (int, int)` COMPILE, while `var t as (int, int)` in a field position is REFUSED
//     — so the exemption is the RHS, not the tuple. `typealias IntBox = Box with int` is refused too, by
//     E2061, which is why the generic arm above is a separate exemption rather than a consequence of this
//     one.
//
// `extension int` needs no arm: `typeBaseTokenAt` re-mints the keyword as an identifier-kinded token, so it
// never reaches `parseTypeReference` at all, and the body names the primitive as `Self`.
enum BarePrimitiveVoice
	asAType
	asACastTarget
	admitted
end 'BarePrimitiveVoice'

// The receiver a call carries, if any. A union rather than a `ValueId` plus a bool, and rather
// than a reserved id: `ValueId` has no empty value and a sentinel would be READ as a real argument
// by everything downstream (`retVoid` exists in the Maxon dialect for precisely this reason).
// `none`: the call writes no receiver, so an instance method's receiver can only be its first written
// argument (`Type.method(value)`), and E3193 refuses it only with no arguments. `unavailable`: an
// instance sibling called bare where no `self` exists, refused as E3193 whatever its arguments, since
// a first argument there is never the receiver. `value` is an instance method's receiver.
union ReceiverArg
	none

	unavailable

	// `immutableName` is the E3207 blame name for the receiver AS AN ARGUMENT — `unblamed` when it may
	// be written through. It rides the receiver because `parseCallNamed` prepends the receiver at
	// argument 0 and the fourth argument column needs one entry per argument (`pushCallArg`).
	//
	// ⭐ **`anchor` IS THE RECEIVER'S OWN TOKEN, AND IT RIDES HERE BECAUSE THE CALL'S ANCHOR IS NOT THE
	// SAME TOKEN.** `parseCallNamed` takes the call op's span and this argument's span from different
	// anchors; a method call needs two, because the call is anchored at the METHOD
	// NAME (`SourceRange.between`'s stated convention — *"the construct's leading keyword or callee name"*)
	// while a diagnostic about the RECEIVER argument still has to point at the receiver. One token cannot
	// be both.
	value(id ValueId, immutableName immutable ByteArray, anchor Token, extent ReceiverExtent)
end 'ReceiverArg'

union ReceiverExtent
	writtenBefore(dotIndex ElementIndex)
	implicitAt(nameIndex ElementIndex)
end 'ReceiverExtent'

union SourceBinding
	none
	local(name immutable ByteArray)

	function isLocal() returns bool
		return match self 'source'
			none gives false
			local gives true
		end 'source'
	end 'isLocal'

	function localName() returns immutable ByteArray throws AbsentError
		match self 'source'
			none then throw AbsentError.absent
			local(name) then return name
		end 'source'
	end 'localName'
end 'SourceBinding'

union FactoryInference
	none
	of(base immutable ByteArray)

	function isOf() returns bool
		return match self 'inference'
			none gives false
			of gives true
		end 'inference'
	end 'isOf'

	function baseName() returns immutable ByteArray throws AbsentError
		match self 'inference'
			none then throw AbsentError.absent
			of(base) then return base
		end 'inference'
	end 'baseName'
end 'FactoryInference'

let ReceiverDotBeforeArgumentList = 3

let OperandRootSearchWidth = 4

function overlapCureFor(operand ConflictingOperand, spelled String) returns String
	return match operand 'operand'
		plainRead gives "Copy '{spelled}' into a `let` in an earlier statement (`.clone()` a record, array or string) and use the copy for the other operand"
		byReferenceCell gives "Copy '{spelled}' into a `var` in an earlier statement (`.clone()` a record, array or string), pass the copy for that operand and store it back into '{spelled}' after the call"
	end 'operand'
end 'overlapCureFor'

let WitnessDispatchDestination = b"<witness dispatch>"

enum OperandSuccession
	beforeComma
	receiverBeforeArguments
	memberReceiverBeforeArguments
	alwaysFollowed
end 'OperandSuccession'

enum OperandPassing
	asValue
	intoPlace
	converted
end 'OperandPassing'

function operandHoldKindOf(passing OperandPassing, valueKind HoldKind) returns HoldKind
	return match passing 'passing'
		asValue gives valueKind
		intoPlace gives HoldKind.placeOperand
		converted gives HoldKind.convertedOperand
	end 'passing'
end 'operandHoldKindOf'

union CallArgTarget
	witnessDispatch(declarations DeclarationFactsArray, requirement immutable ByteArray)
	callee(name immutable ByteArray)
	movedInto(name immutable ByteArray)
	coroutine(name immutable ByteArray)

	function dispatchedName() returns immutable ByteArray
		return match self 'target'
			witnessDispatch gives WitnessDispatchDestination
			callee(name) gives name
			coroutine(name) gives name
			movedInto(name) gives name
		end 'target'
	end 'dispatchedName'

	function calleeName() returns immutable ByteArray throws AbsentError
		match self 'target'
			witnessDispatch or
			movedInto then throw AbsentError.absent
			callee(name) then return name
			coroutine(name) then return name
		end 'target'
	end 'calleeName'

	function runsUserCode() returns bool
		return match self 'target'
			witnessDispatch or
			callee gives true
			coroutine or
			movedInto gives false
		end 'target'
	end 'runsUserCode'

	function namesACallee() returns bool
		return match self 'target'
			witnessDispatch or
			movedInto gives false
			coroutine or
			callee gives true
		end 'target'
	end 'namesACallee'

	function writesAfterTheStatement() returns bool
		return match self 'target'
			witnessDispatch or
			movedInto or
			callee gives false
			coroutine gives true
		end 'target'
	end 'writesAfterTheStatement'

	function operandHoldKind(permanentlyReadOnly bool) returns HoldKind
		return match self 'target'
			witnessDispatch or
			callee gives HoldKind.callOperand
			coroutine or
			movedInto gives HoldKind.sharedOperand if permanentlyReadOnly else HoldKind.handedOffOperand
		end 'target'
	end 'operandHoldKind'

	function declaredName() returns immutable ByteArray throws AbsentError
		match self 'target'
			witnessDispatch then throw AbsentError.absent
			callee(name) then return name
			coroutine(name) then return name
			movedInto(name) then return name
		end 'target'
	end 'declaredName'

	function lendedName() returns immutable ByteArray
		return match self 'target'
			witnessDispatch(_, requirement) gives requirement
			callee(name) gives name
			coroutine(name) gives name
			movedInto(name) gives name
		end 'target'
	end 'lendedName'
end 'CallArgTarget'

union ByRefFormal
	unranged
	ranged(identity immutable ByteArray)
	associated(name String)

	function verdictFor(variableAlias ByteArray, signatures ProgramSignatures, readerFilePath FilePath) returns FormalVerdict
		return match self 'formal'
			unranged gives FormalVerdict.holds
			ranged(identity) gives FormalVerdict.refused(FormalRefusalWords.forRangedAlias(signatures.aliasIdentityDisplay(identity))) if signatures.aliasWidensTo(variableAlias, ancestor: identity, readerFilePath: readerFilePath) else FormalVerdict.holds
			associated(name) gives FormalVerdict.refused(FormalRefusalWords.create(name, cure: "Each conformer binds '{name}' itself, so hand the call a variable whose type is '{name}', such as one read back through the interface"))
		end 'formal'
	end 'verdictFor'
end 'ByRefFormal'

union FormalVerdict
	holds
	refused(words FormalRefusalWords)
end 'FormalVerdict'

type FormalRefusalWords
	export let expected as String
	export let cure as String

	static function create(expected String, cure String) returns Self
		return Self{expected: expected, cure: cure}
	end 'create'

	static function forRangedAlias(shown String) returns Self
		return Self{expected: shown, cure: "Declare the variable or field it names as {shown}, or pass a {shown} local"}
	end 'forRangedAlias'
end 'FormalRefusalWords'

function byRefFormalOfIdentity(identity ByteArray) returns ByRefFormal
	if identity.isEmpty() 'namesNoRangedAlias'
		return ByRefFormal.unranged
	end 'namesNoRangedAlias'

	return ByRefFormal.ranged(identity)
end 'byRefFormalOfIdentity'

type LandedParam
	export let name as immutable ByteArray
	export let position as ParamCount
	export let declaredType as MaxonType
	export let declFilePath as FilePath

	static function create(name ByteArray, position ParamCount, declaredType MaxonType, declFilePath FilePath) returns Self
		return Self{name: name, position: position, declaredType: declaredType, declFilePath: declFilePath}
	end 'create'
end 'LandedParam'

function declaredParamAtColumn(declaration SweptDeclaration, column ParamCount, label ByteArray) returns LandedParam
	let slot = try argSlotPosition(declaration.paramNames, argIndex: column, label: label) otherwise panic("declaredParamAtColumn: an argument at column {column} handed to a by-reference position lands on a declared parameter")
	let name = try declaration.paramNames.get(slot) otherwise panic("declaredParamAtColumn: paramNames.get OOB at {slot} — a declaration's parameter columns are built in lockstep")
	let declaredType = try declaration.paramTypes.get(slot) otherwise panic("declaredParamAtColumn: paramTypes.get OOB at {slot} — a declaration's parameter columns are built in lockstep")
	return LandedParam.create(name, position: slot + firstUserParamIndex(declaration.takesReceiver), declaredType: declaredType, declFilePath: declaration.declFilePath)
end 'declaredParamAtColumn'

union SiblingMethod
	none
	named(qualified immutable ByteArray)

	function qualifiedName() returns immutable ByteArray throws AbsentError
		match self 'sibling'
			none then throw AbsentError.absent
			named(qualified) then return qualified
		end 'sibling'
	end 'qualifiedName'
end 'SiblingMethod'

union GenericInstanceBody
	none
	named(instanceName immutable ByteArray)

	function isInstance() returns bool
		return match self 'body'
			none gives false
			named gives true
		end 'body'
	end 'isInstance'

	function instanceName() returns immutable ByteArray throws AbsentError
		match self 'body'
			none then throw AbsentError.absent
			named(name) then return name
		end 'body'
	end 'instanceName'
end 'GenericInstanceBody'

type TypeHeader
	export let nameTok as Token
	export let isUnique as bool

	static function create(nameTok Token, isUnique bool) returns Self
		return Self{nameTok: nameTok, isUnique: isUnique}
	end 'create'
end 'TypeHeader'

type FunctionHead
	export let nameTok as Token
	export let sourceName as immutable ByteArray
	export let parameterListStart as ElementIndex
	export let ownTypeParams as immutable NameRoster
	export let paramCapabilities as ParamCapabilityArray
	export let selfCapability as ParamCapability
	export let markedParams as ParamPositionMask
	export let markerTokens as TokenIndexArray

	static function create(nameTok Token, sourceName ByteArray, parameterListStart ElementIndex, ownTypeParams immutable NameRoster, paramCapabilities ParamCapabilityArray, selfCapability ParamCapability, markedParams ParamPositionMask, markerTokens TokenIndexArray) returns Self
		return Self{nameTok: nameTok, sourceName: sourceName, parameterListStart: parameterListStart, ownTypeParams: ownTypeParams, paramCapabilities: paramCapabilities, selfCapability: selfCapability, markedParams: markedParams, markerTokens: markerTokens}
	end 'create'
end 'FunctionHead'

type ArmAliasJoin
	export let alias as immutable ByteArray

	static function create(alias immutable ByteArray) returns Self
		return Self{alias: alias}
	end 'create'
end 'ArmAliasJoin'

union PendingUnstorableRequirement
	none
	noted(interfaceName immutable ByteArray, position DeclaredStoragePosition, line LineNumber, column ColumnNumber)

	function isNoted() returns bool
		return match self 'pending'
			none gives false
			noted gives true
		end 'pending'
	end 'isNoted'

	function refusal() returns PendingUnstorableRequirement
		return self.clone()
	end 'refusal'
end 'PendingUnstorableRequirement'

// ⭐⭐ **THE BASE OF A GENERIC INSTANTIATION — the NAME the registry is keyed by, and the TOKEN a diagnostic
// blames.** The two differ for a QUALIFIED base (`Box.handle with String`, a service's handle companion),
// where no single token spells the whole name and the first one is still the word an author would change.
type GenericBaseName
	export let anchor as Token
	export let written as immutable ByteArray
	export let denoted as immutable ByteArray

	static function create(anchor Token, written ByteArray, denoted ByteArray) returns GenericBaseName
		return Self{anchor: anchor, written: written, denoted: denoted}
	end 'create'
end 'GenericBaseName'

enum LiteralOperand
	byteString
	closure
end 'LiteralOperand'

function literalOperandOf(first Token, alone bool) returns LiteralOperand throws AbsentError
	if first.kind == TokenKind.function 'aClosureLiteral'
		return LiteralOperand.closure
	end 'aClosureLiteral'

	if first.kind == TokenKind.byteStringLiteral and alone 'aBareByteLiteral'
		return LiteralOperand.byteString
	end 'aBareByteLiteral'

	throw AbsentError.absent
end 'literalOperandOf'

// ⭐ **WHAT A FACTORY'S ARGUMENTS FIX ONE TYPE PARAMETER TO, or nothing.** A verdict rather than a throw
// because the two roads that read it disagree about what a miss MEANS: a `spawn` has no other source for
// the instantiation and refuses, while an ordinary static call keeps the base `structRef` it always had.
union InferredTypeArgument
	found(argument MaxonType)
	absent
end 'InferredTypeArgument'

// A type the sweep could not read may be anything, so it never provably differs: a column whose type is
// unread may be the parameter a body returns, and answering otherwise would let a borrow through as moved.
function typesProvablyDiffer(a MaxonType, other MaxonType) returns bool
	if maxonTypeTag(a) == ValueTypeTag.unresolved or maxonTypeTag(other) == ValueTypeTag.unresolved 'unreadByTheSweep'
		return false
	end 'unreadByTheSweep'

	return not maxonTypesDenoteSame(a, b: other)
end 'typesProvablyDiffer'

// ⭐ **WHY AN INFERENCE FIXED NOTHING** — the two shapes, carried to the one door that decides between a
// refusal and the base `structRef`. A verdict and not a sentence, so the road that discards it renders
// nothing.
union UninferredFactoryReason
	// No factory parameter is declared at this type parameter, so no argument can carry it.
	noParameterFixesIt(paramName immutable ByteArray)

	// Every parameter was found and an argument still names a type parameter — a `spawn` written inside
	// another generic body, whose enclosing parameters name no layout.
	theArgumentsAreStillOpaque
end 'UninferredFactoryReason'

// The two calls E3162 refuses on a bare generic base the enclosing scope does not bind.
enum BareGenericSubjectUse
	fedAnEnclosingParameter
	needsALayoutDescriptor
	resultTypedAtAnUnboundParameter
end 'BareGenericSubjectUse'

function bareGenericSubjectSentence(signatures ProgramSignatures, base ByteArray, callee ByteArray, use BareGenericSubjectUse, scopeTypeName ByteArray, scopeParams NameRoster) returns String
	let inAGenericTypeBody = not scopeParams.isEmpty()
	let baseName = String.from(base)
	let baseParams = signatures.structTypeParamsOf(base)
	let quotedBaseParams = nameList(baseParams, quote: DiagnosticNameQuote)
	let scopeParamList = nameList(scopeParams, quote: UnquotedName)
	let paramsNoun = "its parameter {quotedBaseParams}" if baseParams.count() == 1 else "its parameters {quotedBaseParams}"
	let bindVerb = "binds" if baseParams.count() == 1 else "bind"
	let unbound = "inside 'type {String.from(scopeTypeName)} uses {scopeParamList}', where {paramsNoun} {bindVerb} to nothing" if inAGenericTypeBody else "and nothing binds {paramsNoun}"
	let frameDescriptor = "this frame's describes the parameters of '{String.from(scopeTypeName)}'" if inAGenericTypeBody else "neither does this function"

	let consequence = match use 'why'
		fedAnEnclosingParameter gives "may not be handed a value typed at a parameter of '{String.from(scopeTypeName)}': no instance of '{baseName}' describes what it would hold"
		needsALayoutDescriptor gives "has no layout descriptor to be handed: the base has none, and {frameDescriptor}"
		resultTypedAtAnUnboundParameter gives "has no type: its result is written over a parameter of '{baseName}' that no argument fixes"
	end 'why'

	let typeArguments = scopeParamList if scopeParams.count() == 1 else "({scopeParamList})"
	let remedy = "e.g. 'typealias {baseName}Instance = {baseName} with {typeArguments}'" if inAGenericTypeBody and baseParams.count() == scopeParams.count() else "giving each of its parameters a type argument"

	return "'{baseName}' is named without type arguments {unbound}, so '{String.from(genericTemplateName(callee))}' {consequence}. Name the instance with a typealias, {remedy}"
end 'bareGenericSubjectSentence'

// What one declaration makes of a call on a bare generic base: the call's arity or labels do not fit it, or they
// do and a slot written over the base's parameters is or is not handed a value typed at the enclosing scope's.
enum MemberFeed
	unfilled
	notFed
	fed
end 'MemberFeed'

// ⭐ **THE CONCRETE GENERIC INSTANCE A STATIC CONSTRUCTOR CALL BUILDS**, or `none`. Only a
// generic-alias constructor (`StrBox.create(…)`) carries one — it is what tells the caller-side consume
// which argument OWNS its box's managed content and must be MOVED in. Every other call (a plain free call,
// an instance method) borrows its arguments exactly as before.
union ConstructorInstance
	instance(id GenericInstanceId)
	none
end 'ConstructorInstance'

union TypeParameterScope
	ofTheEnclosingType(position ElementIndex)
	ofTheGenericFunction(position ElementIndex)
	notAParameter
end 'TypeParameterScope'

union SurfaceReach
	reachable
	refused(refusal SourceParseError)
end 'SurfaceReach'

enum HandleSurface
	file
	directory
	socket
	pages
	osHandle
	pin
	memory
end 'HandleSurface'

// ⭐⭐ **THE COMPILER-OWNED SURFACE A `<Type>.` BASE DENOTES, OR `none`** — the statics that lower to a
// runtime entry of the compiler's own rather than to a function the program declares. Decided from the base
// alone, so it is asked BEFORE the `.` is consumed and each arm's sub-reader still receives the cursor it
// expects.
//
// ⭐⭐ **IT IS A VALUE BECAUSE TWO DOORS ASK IT.** `Parser.parseQualifiedCall` ROUTES on it; the `async`
// spawn reader REFUSES on it, because a spawn hands `__gt_spawn` the ADDRESS of a function the program
// links and none of these is one. A second roster in the async reader would silently admit whichever
// surface is added next — an `asyncCall` naming a callee no file declares, which is a link failure rather
// than a diagnostic.
//
// `none` is LAST so the refusable arms are one contiguous range in a match.
union CompilerOwnedStaticSurface
	handle(surface HandleSurface)
	containerAlias(giid GenericInstanceId)
	sharedValue(giid GenericInstanceId)
	none
end 'CompilerOwnedStaticSurface'

// ⭐⭐ **WHAT A `<Type>.<member>` NAMES** — the one answer the call, `async`, read, store, statement and
// constant doors and `staticCallClaimsBase` all read, so no spelling is accepted at one door and refused
// at another. For the callee arms the `CalleeMint` the call carries is `primitiveStatic` for a MINTED
// name and the head's own mint otherwise.
union StaticMemberResolution
	surface(surface CompilerOwnedStaticSurface)

	// `int.fromString` → `__int_fromString` (`CalleeMint.primitiveStatic`).
	minted(callee immutable ByteArray)

	// `File.readText` at its registration key — the ordinary static. `declaredByAFile` is false for a key
	// nothing declares, which a call carries on to `SemanticCheck`'s E3004.
	named(callee immutable ByteArray, declaredByAFile bool)

	directory(callee immutable ByteArray)

	requirement(interfaceName ByteArray)

	refused(refusal SourceParseError, readsAsAMethod bool)

	function calleeToCall() returns immutable ByteArray
		return match self 'resolution'
			minted(callee) gives callee
			named(callee, _) gives callee
			directory(callee) gives callee
			surface or
			requirement or
			refused panic("StaticMemberResolution.calleeToCall: a compiler-owned surface, a requirement and a refusal name no callee to call")
		end 'resolution'
	end 'calleeToCall'
end 'StaticMemberResolution'

// The resolution `qualifiedStaticCallsAt` reached, handed to the `parseQualifiedCall` that parses the same
// base index so a statement is parsed by the answer that claimed it. It is taken once and cleared.
union HandedResolution
	empty
	handed(at ElementIndex, resolution StaticMemberResolution)

	function handsOverAt(index ElementIndex) returns bool
		return match self 'handed'
			empty gives false
			handed(at, _) gives at == index
		end 'handed'
	end 'handsOverAt'

	function held() returns StaticMemberResolution
		return match self 'handed'
			handed(_, resolution) gives resolution.clone()
			empty panic("HandedResolution.held: nothing is handed — every caller asks `handsOverAt` first")
		end 'handed'
	end 'held'
end 'HandedResolution'

let NothingHanded = HandedResolution.empty

enum StaticBaseKind
	typeParameter
	primitive
	declaredName
end 'StaticBaseKind'

enum SurfaceStatic
	absent
	emitted
	corpus
end 'SurfaceStatic'

type ConstraintOnParameter
	export let constraintIndex as ElementIndex
	export let interfaceName as immutable ByteArray
	export let iface as IrInterface
	export let declaresStatic as bool
	export let declaresInstance as bool

	static function create(constraintIndex ElementIndex, interfaceName ByteArray, iface IrInterface, declaresStatic bool, declaresInstance bool) returns ConstraintOnParameter
		return Self{constraintIndex: constraintIndex, interfaceName: interfaceName, iface: iface, declaresStatic: declaresStatic, declaresInstance: declaresInstance}
	end 'create'
end 'ConstraintOnParameter'

typealias ConstraintOnParameterArray = Array with ConstraintOnParameter

union ConstraintRequirement
	staticDeclaredBy(interfaceName ByteArray)
	instanceDeclaredBy(interfaceName ByteArray)
	unresolved(refusal SourceParseError)
	notDeclared
end 'ConstraintRequirement'

// The callee an `async` spawn names, with the token its diagnostics anchor on — the MEMBER for a qualified
// spawn, which is `parseQualifiedCall`'s anchor too, so `async File.frobnicate(…)` reports at the member the
// author got wrong rather than at the type that is fine.
type AsyncSpawnCallee
	export let name as immutable ByteArray
	export let anchor as Token
	export let mint as CalleeMint

	static function create(name ByteArray, anchor Token, mint CalleeMint) returns AsyncSpawnCallee
		return AsyncSpawnCallee{name: name, anchor: anchor, mint: mint}
	end 'create'
end 'AsyncSpawnCallee'

typealias RefusedInstanceMap = Map with (GenericInstanceId, bool)

union GenericAliasSink
	discard
	collect(out GenericAliasEntryArray)
end 'GenericAliasSink'

// ⭐ **THE THREE SHAPES A NESTED (inner) TYPEALIAS TAKES.** A `typealias Idx =
// int(0 to N)` is a RANGED per-instance alias; a `typealias ElementArray = Array with T` is a
// GENERIC-INSTANCE alias whose instance (`Array with typeParameter(token)`) is partially opaque; a
// `typealias FnTypeAlias1 = function(Integer) returns Integer` is a FUNCTION alias. They fold into
// DIFFERENT whole-program registries — the ranged one into `innerAliases`, the generic one into
// `genericAliases` under its base-qualified name, the function one into the FILE's own
// `functionTypeAliases` — so `readNestedTypeAlias` hands the caller the shape it read and the caller
// routes it to the right collection.
//
// ⭐ **AND ONLY THE FIRST TWO ARE MEMBERS OF THE ENCLOSING TYPE.** The ranged and generic-instance forms
// record their bare member into `enclosingInnerAliases` (so a later bare reference inside the body
// resolves) and are keyed whole-program under the enclosing type's name, because both are PER-INSTANCE:
// `Container.Idx` is nominally distinct per instantiation (`specs/per-instance-typealias.md`) and
// `Container.ElementArray` names an instance over the enclosing type's parameters — and their bare names
// genuinely collide (`stdlib/Array.maxon` declares `ElementMemory` in two different types of one file).
// ⭐⭐ **A FUNCTION alias is BOTH, and it is the only form that is.** Its identity IS its name
// whole-program (`resolveNamedAlias` re-tags a `named` reference to `MaxonType.function(<name>)`), so one
// written inside a body really is nameable from outside it: `specs/ownership.md`'s `closure-captures-borrow`
// names the alias from a FREE function below the type, and `specs/type-name-collision.md`'s form table calls
// the registry "bare, whole-program". That reading is kept. But it is ALSO per-declaring-type, because the
// same written words denote a different signature in each fold of an `extension <Interface>` body — so it is
// published under `<Type>.<member>` as well, and THAT is the name its own body resolves. It records no
// `enclosingInnerAliases` membership even so: that set means "a member of this type", which drives the
// literal door and the per-instance parameter machinery, and a function alias is neither constructible nor
// per-instance. See `Parser.publishNestedFunctionAlias`, the one home of both halves.
union NestedAliasResult
	ranged(alias RangedTypeAlias)
	genericInstance(entry GenericAliasEntry)

	// ⭐ **A TUPLE inner alias** — `typealias Entry = (Key, Value)` inside `type Map uses Key, Value`,
	// the shape `stdlib/Map.maxon:20` opens with. It carries NO payload where the three above carry one,
	// because a tuple alias mints no declaration of its own to hand back: its whole effect is the
	// `tupleAliases` entry `readTypeAliasDeclaration` has already written under the name `TupleAliasOwner`
	// decided, plus the `enclosingInnerAliases` membership every per-instance form records. A `Map.Entry`
	// reference resolves STRAIGHT THROUGH to the interned tuple's `structRef` — the file-scope form's rule,
	// one nesting level down — so there is nothing per-declaration left for a caller to file.
	tupleAlias
	functionAlias(alias FunctionTypeAlias)
end 'NestedAliasResult'

// ⭐⭐ **WHICH WHOLE-PROGRAM NAME A TUPLE TYPEALIAS IS PUBLISHED UNDER — OR THAT THIS READ PUBLISHES NONE.**
// The other three alias forms are routed by their OUT-ARRAY and the caller keys what it takes; a
// tuple alias has no such array, because `recordTupleAlias` must write DURING the walk rather than at
// `foldFile` (see `parseTypeReference`'s tuple arm for the measurement that pins that). So the KEY travels
// down instead of the entry travelling up, and the three cases are the three answers its readers need:
//
//   • `fileScope` — a top-level `typealias Pair = (Num, Num)`, published under its bare name.
//   • `enclosingType` — a nested one, published as `<Type>.<member>` exactly as a ranged or
//     generic-instance inner alias is keyed, because the bare member genuinely collides (two types in one
//     file may each declare an `Entry`) and because the tuple it names is over THAT type's parameters.
//   • `unpublished` — read, validated and entered into `enclosingInnerAliases`, but keyed nowhere. Two
//     callers need it and neither is an optimization: an `interface` BODY, whose members the declaration
//     sweep never reads (so a name published from the real parse alone would resolve or not depending on
//     file order — the very reason a FUNCTION alias is refused there); and an extension body being read for
//     a conformer the extension is WITHHELD from, where publishing would make the extension's private
//     vocabulary nameable on a type that receives none of its methods.
//
// A union rather than a name-that-may-be-empty, because "no owner" and "the file" are different answers and
// a shared empty string can only carry one of them.
union TupleAliasOwner
	fileScope
	enclosingType(name immutable ByteArray)
	unpublished

	function isFileScope() returns bool
		return match self 'owner'
			fileScope gives true
			enclosingType or
			unpublished gives false
		end 'owner'
	end 'isFileScope'
end 'TupleAliasOwner'

// A body token reaches a parameter only through these and `bodyCanReadName`: `_` is never bound, so a
// token spelling it denotes no parameter, and a body scan asking `paramNames` directly would find one.
function bodyNamesAParam(paramNames NameRoster, name ByteArray) returns bool
	return bodyCanReadName(name) and paramNames.contains(name)
end 'bodyNamesAParam'

function bodyParamPosition(paramNames NameRoster, name ByteArray) returns ElementIndex throws MapError
	if not bodyNamesAParam(paramNames, name: name) 'namesNoParameter'
		throw MapError.keyNotFound
	end 'namesNoParameter'

	return try paramNames.positionOfName(name)
end 'bodyParamPosition'

// ⭐ **WHAT ONE POSITION OF A TUPLE-ASSIGNMENT TARGET LIST DOES WITH ITS ELEMENT** (`specs/tuple-assign.md`).
// Three answers and only three: rebind a binding already in scope, declare a fresh one, or throw the element
// away. `tupleAssignTargetAt` is the single reader that decides which, off the tokens.
union TupleAssignTarget
	// A bare name — `(x, y) = f()`. The binding must already exist and be writable (E2013).
	rebinds

	// `let y` / `var y` — this element DECLARES the name, with the author's mutability.
	declares(kind BindingKind)

	// `_` — the element is produced and never assigned. It costs nothing to drop: an element read is a
	// BORROW of the hidden temp's box, so a discarded position simply emits no read at all.
	discards
end 'TupleAssignTarget'

// Does this target throw its element away? Asked ahead of the field read, because a discard is the one target
// that wants no read at all. A FREE function beside the union rather than a `Parser` member: it reads the
// union and never the parser, and a classifier wearing an instance signature invites a reader to look for
// parser state it does not touch.
function tupleAssignTargetDiscards(target TupleAssignTarget) returns bool
	return match target 'kind'
		rebinds or
		declares gives false
		discards gives true
	end 'kind'
end 'tupleAssignTargetDiscards'

// Does this target WRITE a binding that already exists? The question the three "does this statement write a
// name" readers ask — a declaring target introduces a name no enclosing loop can be carrying and no caller
// can have passed by reference, and a discard writes nothing.
function tupleAssignTargetRebinds(target TupleAssignTarget) returns bool
	return match target 'kind'
		rebinds gives true
		declares or
		discards gives false
	end 'kind'
end 'tupleAssignTargetRebinds'

// Does this target DECLARE the name it holds? The question the reserved-name refusal asks, and the one a
// rebinding target must not be asked — its name was checked at its own declaration.
function tupleAssignTargetDeclares(target TupleAssignTarget) returns bool
	return match target 'kind'
		rebinds or
		discards gives false
		declares gives true
	end 'kind'
end 'tupleAssignTargetDeclares'

// Which DIRECT call, if any, produced a value — the answer `directCallDefining` gives. A union rather than
// "the callee bytes, empty for none", because an empty `ByteArray` is a perfectly good callee key as far as
// every reader downstream is concerned, and the two answers differ in KIND. (`tupleAssignEqualsIn` answers
// the same shape of question with a sentinel index instead, and its header says why the two differ.)
union DiscardedCallee
	notACall
	named(callee immutable ByteArray, result ValueId, opIndex ElementIndex)
end 'DiscardedCallee'

// Did a call produce the value at all? The `try` rewrite's half of `directCallDefining` — it needs the fact,
// not the name.
function discardedCalleeIsACall(producer DiscardedCallee) returns bool
	return match producer 'p'
		notACall gives false
		named gives true
	end 'p'
end 'discardedCalleeIsACall'

// What `materializeIterableIterationSource` made of a `for … in` source. BOTH halves or neither: the
// cursor the loop walks and the value its header starts from are decided by the same `createIterator`
// declaration, and a caller holding one without the other would have to re-derive whether the factory could
// throw. See that function for what the seed means.
union IterableIterationSource
	notIterable
	cursor(value ValueId, entrySeed ValueId)
end 'IterableIterationSource'

// Where a CURSOR loop's header error flag starts — see `parseForStatement`'s `cursorEntrySeed`. A case
// rather than a pre-emitted literal, because the literal belongs in the preheader beside the other four
// forms' seeds and emitting one here for the arm that never uses it would put a dead `const` in every
// cursor loop.
union CursorEntrySeed
	atTheFirstElement
	fromFactory(flag ValueId)

	function receiverOrigin() returns ProtocolReceiverOrigin
		return match self 'seed'
			atTheFirstElement gives ProtocolReceiverOrigin.authored
			fromFactory gives ProtocolReceiverOrigin.factoryMinted
		end 'seed'
	end 'receiverOrigin'
end 'CursorEntrySeed'

enum ProtocolReceiverOrigin
	authored
	factoryMinted
end 'ProtocolReceiverOrigin'

// ⭐ **WHERE A `[…]`'s ELEMENT TYPE COMES FROM.** Every bare array literal INFERS it from its own first
// element; an `<alias> from […]` head STATES it, and stating it is the whole of what that spelling adds —
// `typealias ByteArray = Array with Byte` then `ByteArray from [10, 20, 30]` writes three bare `int`
// constants, and only the head says they are `Byte`s stored one byte apart.
//
// A union rather than an "instance id, or zero for none": zero IS an instance id, so the two answers have
// to differ in KIND and not in a number the registry could legitimately hand back.
union ArrayLiteralElementSource
	inferred
	stated(giid GenericInstanceId)
end 'ArrayLiteralElementSource'

// ⭐ **WHY AN EMPTY `[…]` IS REFUSED, WHICH IS NOT THE SAME SENTENCE UNDER THE TWO HEADS.** A bare `[]` has
// no element to infer a type FROM; `ByteArray from []` states the type perfectly well and is refused for a
// different reason — an empty literal builds no record this path knows how to make, and the container's own
// `.create()` is the spelling for it. Blaming inference under a stated head named a fault the author had
// already avoided.
function emptyArrayLiteralMessage(element ArrayLiteralElementSource) returns String
	if elementSourceIsInferred(element) 'nothingToInferFrom'
		return "an empty array literal `[]` — its element type cannot be inferred; use `Array with T` + `.create()` for an empty typed array"
	end 'nothingToInferFrom'

	return "an empty array literal `[]` under a `from` head — the element type is stated, but an empty literal builds no record; use the container's own `.create()` for an empty typed array"
end 'emptyArrayLiteralMessage'

// The `List from []` refusal. Under the bare base name nothing states the element type; under an alias the type
// is stated and the empty literal still builds nothing, so the two heads earn two sentences for
// `emptyArrayLiteralMessage`'s reason.
function emptyListFromMessage(head ByteArray, statedByAlias bool) returns String
	if statedByAlias 'stated'
		return "`{String.from(head)} from []` — an empty literal builds no list; an empty one is `{String.from(head)}.{String.from(CreateMethod)}()`"
	end 'stated'

	return "`{String.from(ListBuiltinBaseName)} from []` states no {ContainerElementColumnNoun} type — an empty list is `<alias>.{String.from(CreateMethod)}()` over a `{String.from(ListBuiltinBaseName)} with <{ContainerElementColumnNoun}>` alias"
end 'emptyListFromMessage'

// Is the literal's element type still open — the question the MAP-literal fork asks, which is the one place
// the two arms differ before the instance is in hand. A `match` arm may not open a block, so the fork reads
// it as the predicate it is.
function elementSourceIsInferred(element ArrayLiteralElementSource) returns bool
	return match element 'e'
		inferred gives true
		stated gives false
	end 'e'
end 'elementSourceIsInferred'

// ⭐⭐ **HOW A VALUE'S METHODS ARE REACHED — the one fact the `for … in` ADMISSION tests, its two EMITS and
// the generic-result promotion all need, and they must not answer it separately.** A value either declares
// its methods on a type whose bodies exist (a direct call), or carries a witness table it dispatches through,
// or names an interface INSTANCE that the compiler cannot hold at all, or has no method surface.
//
// ⛔ **IT IS A UNION RATHER THAN A TYPE NAME THAT IS EMPTY-MEANS-NONE, AND THE WITNESS RECEIVERS ARE
// WHY.** One `ByteArray` per value would key the whole traversal protocol on a struct name — and a
// dispatched receiver HAS a name (its interface, or its type parameter) whose methods live in a
// store that name cannot reach: an interface's requirements are in no callee registry, and its
// conformers' bodies are not what a dispatch binds against. Answering `EmptySourceText` for them
// makes `for x in source` an E2015 whose sentence enumerates a protocol the value's own interface
// requires.
//
// ⭐ **THE RECEIVER TRAVELS ON THE ARM, so no reader takes both a surface and the value it came from.** Two
// such parameters must agree and nothing could enforce it; carrying the value makes a disagreement
// unrepresentable, which is the same reason `InterfaceConformance` keeps its interface name beside its
// `withArgs`.
union MethodSurface
	// Methods DECLARED on a struct or a generic base — the loop emits `<typeName>.current` /
	// `<typeName>.advance` as direct calls, and `ProgramSignatures.declaresCallee` is what says they exist.
	declared(typeName immutable ByteArray, receiver ValueId)

	// ⭐⭐ **A RECEIVER THAT DISPATCHES THROUGH A WITNESS TABLE — BOTH of the kinds the language has**, an
	// EXISTENTIAL (the fat pointer's own witness half) and a CONSTRAINED TYPE PARAMETER (the enclosing body's
	// hidden witness parameter). They share an arm because everything under it is shared:
	// `findWitnessDispatchCandidates` serves both from the receiver alone, and `witnessDispatchProviderPhrase`
	// already words a refusal for both. Splitting them would be a second place for one dispatch rule to live.
	witnessDispatched(receiver ValueId)

	// No method surface at all: an int, a float, a closure.
	none

	function declaredTypeName() returns immutable ByteArray throws AbsentError
		match self 'surface'
			declared(typeName, _) then return typeName
			witnessDispatched or
			none then throw AbsentError.absent
		end 'surface'
	end 'declaredTypeName'

	function dispatchesThroughAWitness() returns bool
		return match self 'surface'
			witnessDispatched gives true
			declared or
			none gives false
		end 'surface'
	end 'dispatchesThroughAWitness'
end 'MethodSurface'

let SetCursorTypePrefix = "SetIterator"
let MapCursorTypePrefix = "MapIterator"

enum StoredKeyCursor
	setElements
	mapEntries
	neither
end 'StoredKeyCursor'

function storedKeyCursorOf(surface MethodSurface) returns StoredKeyCursor
	let typeName = String.from(try surface.declaredTypeName() otherwise return StoredKeyCursor.neither)

	if typeName.startsWith(SetCursorTypePrefix) 'aSetCursor'
		return StoredKeyCursor.setElements
	end 'aSetCursor'

	if typeName.startsWith(MapCursorTypePrefix) 'aMapCursor'
		return StoredKeyCursor.mapEntries
	end 'aMapCursor'

	return StoredKeyCursor.neither
end 'storedKeyCursorOf'

function storedKeyOnly(cursor StoredKeyCursor, wanted StoredKeyCursor) returns StoredKeyCursor
	return cursor if cursor == wanted else StoredKeyCursor.neither
end 'storedKeyOnly'

function methodSurfaceExists(surface MethodSurface) returns bool
	return match surface 'k'
		declared or
		witnessDispatched gives true
		none gives false
	end 'k'
end 'methodSurfaceExists'

// ⭐ **THE ARITY OF EVERY TRAVERSAL-PROTOCOL METHOD.** `current()`, `advance()` and `createIterator()` each
// take a receiver and nothing else, so the loop calls with no arguments and the requirement it binds must
// declare none. It is named because it is read TWICE about one call — once to filter the candidates and once
// to word the ambiguity — and two literal `0`s about one fact is how they come to disagree.
let ProtocolMethodArity = 0 as ParamCount

// The zero-argument, receiver-taking requirement a witness-dispatched receiver supplies under a protocol
// name — or `notRequired`. See `Parser.witnessProtocolTarget`.
union WitnessProtocolTarget
	required(target WitnessDispatchTarget)
	notRequired
end 'WitnessProtocolTarget'

// ⭐⭐ **HOW A VALUE HANDED BACK IN THE OPAQUE WORD HAS TO BE READ, once the call's instance says what it
// really is** — `Parser.typeCallResultThroughInstance`'s answer, and what `emitCall` spends. A shared generic body
// is compiled ONCE against an opaque `T` and returns a bare 64-bit word, so two kinds of value arrive needing
// work the callee could not do: an f64's BITS sitting in a general-purpose register, and a narrow SIGNED
// value the zero-extending element load truncated the sign off.
//
// `asItStands` is by far the common case (every call in a program with no generic receiver).
union OpaqueWordReading
	asItStands
	aFloatsBits(alias TypeNameId)
	aNarrowSignedSlot(slotBytes ByteOffset)
end 'OpaqueWordReading'

union CallInstanceSource
	receiver(value ValueId)
	qualifier(gid GenericInstanceId)
	scopeOnly(typeName immutable ByteArray)
	nowhere
end 'CallInstanceSource'

type ServiceSpawnLaunch
	export let typeName as immutable ByteArray
	export let capacity as ValueId
	export let cown as ValueId
	export let tempFloor as ElementIndex
	export let ownedFloor as ElementIndex

	static function create(typeName ByteArray, capacity ValueId, cown ValueId, tempFloor ElementIndex, ownedFloor ElementIndex) returns Self
		return Self{typeName: typeName, capacity: capacity, cown: cown, tempFloor: tempFloor, ownedFloor: ownedFloor}
	end 'create'
end 'ServiceSpawnLaunch'

typealias SpawnArgumentBlameArray = Array with String

union SpawnFactoryParams
	unbound
	declared(names NameRoster)
end 'SpawnFactoryParams'

union ThreadArgumentDoors
	coroutine
	factory(blames SpawnArgumentBlameArray)

	function doorAt(callee immutable ByteArray, column ElementIndex) returns ThreadHandOffDoor
		return match self 'doors'
			coroutine gives ThreadHandOffDoor.coroutine(callee)
			factory(blames) gives ThreadHandOffDoor.spawnFactory(try blames.get(column) otherwise panic("ThreadArgumentDoors.doorAt: blames.get OOB at {column} — one blame is pushed per spawn argument"), argumentOf: serviceFactoryArgumentOf(callee))
		end 'doors'
	end 'doorAt'
end 'ThreadArgumentDoors'

union ServiceSpawnSite
	notASpawn
	at(spawnTok Token, launch ServiceSpawnLaunch)

	function isASpawn() returns bool
		return match self 'site'
			notASpawn gives false
			at gives true
		end 'site'
	end 'isASpawn'

	function token() returns Token throws AbsentError
		match self 'site'
			notASpawn then throw AbsentError.absent
			at(spawnTok, _) then return spawnTok
		end 'site'
	end 'token'

	function launch() returns ServiceSpawnLaunch throws AbsentError
		match self 'site'
			notASpawn then throw AbsentError.absent
			at(_, launch) then return launch
		end 'site'
	end 'launch'
end 'ServiceSpawnSite'

// Shared: a payload-free union case is still a heap object, and these two are the answers at nearly every
// call in the program.
let sharedNotAServiceSpawn = ServiceSpawnSite.notASpawn

let sharedNoCallInstanceSource = CallInstanceSource.nowhere

union HolderArgument
	holds(argument ValueId)
	none

	function value() returns ValueId throws AbsentError
		match self 'holder'
			holds(argument) then return argument
			none then throw AbsentError.absent
		end 'holder'
	end 'value'
end 'HolderArgument'

let sharedNoHolderArgument = HolderArgument.none

// Whether this `for` statement grew the second entry edge a throwing `createIterator()` needs — and, if
// so, the block that edge lands in, which is the one the statement's continuation has to merge with. See
// `Parser.emitEmptyIterableEntry`.
union EmptyIterableExit
	none
	entered(empty IrBlock)
end 'EmptyIterableExit'

union MemberAccess
	fieldRead(index FieldIndex)
	missingField
	methodCall
end 'MemberAccess'

// The BOX a field access goes through, paired with the LAYOUT that says what is inside it.
//
// ⭐ **ONE ANSWER, BECAUSE IT IS ONE QUESTION** — and because the two halves drifting apart is a
// wrong answer rather than a compile error. `requireStructBase` proves a binding is a struct and
// hands back the value holding its pointer, together; a caller cannot end up with a layout it
// PROVED beside a box it merely ASSUMED. They were two separate reads off one `VarInfo` at three
// call sites, and one of the two reads was wrong at all three — see `requireStructBase`.
type StructBase
	export var layout as StructLayout
	export let box as ValueId

	// The name an E3207 would blame for a write through this base, `unblamed` when it may be written
	// through (`immutableReceiverNameOf`). It travels with the box for the same reason the layout
	// does: a method dispatched on this base prepends the box as ARGUMENT 0, and the argument's blame
	// name is a fact about the BINDING the base came from — which is exactly what a caller holding
	// only the box has lost.
	export var immutableName as immutable ByteArray

	// The STORAGE this base denotes, `none` when it denotes none — the parameter a write through it
	// records (`subjectStorageMask`). Travels with the box for the identical reason `immutableName`
	// does, and is a DIFFERENT fact from it.
	export var subjectName as StorageSubject

	static function create(layout StructLayout, box ValueId, immutableName immutable ByteArray, subjectName StorageSubject) returns StructBase
		return Self{layout: layout, box: box, immutableName: immutableName, subjectName: subjectName}
	end 'create'
end 'StructBase'

union SelfFieldAlias
	none
	field(name immutable ByteArray)

	function fieldName() returns immutable ByteArray throws AbsentError
		match self 'alias'
			none then throw AbsentError.absent
			field(name) then return name
		end 'alias'
	end 'fieldName'
end 'SelfFieldAlias'

// ⭐⭐ **THE RECEIVER OF A `.method(…)`, IN THE FORM THE ONE DISPATCHER READS** — everything
// `dispatchMethodOnReceiver` needs and nothing about where the receiver came from. Two doors build one:
// a BINDING receiver (`dispatchMethodOnBinding`, off a `VarInfo`) and a VALUE receiver (`parsePostfix`,
// off a literal, a call result, a parenthesised expression or a field read).
//
// ⚠ **IT CARRIES THE TAG AND THE NAME ID, NOT A `MaxonType`.** The two are the columns a VALUE's type
// lives in (`tagOf` / `valueNameId`), and every predicate the dispatcher routes on already takes exactly
// that pair (`isStringIndexType`, `isManagedFileType`, `builtinConformerOfType`). Rebuilding a
// `MaxonType` from them to hand it over would box a union per member access for nothing.
//
// The three provenance fields are facts about the BINDING a receiver came from, and a temporary has none
// of them — see `valueReceiver` for why each empty answer is the right one rather than a gap.
type MethodReceiver
	export let value as ValueId
	export let tag as ValueTypeTag
	export let nameId as TypeNameId

	// The token a diagnostic blames and the range a dispatched call spans from — the base token for a
	// binding receiver, the `.` for a temporary that has no token of its own.
	export let anchor as Token

	// The name an E3207 would blame for a write through this receiver, `unblamed` when it may be
	// written through (`immutableReceiverNameOf`).
	export var immutableName as immutable ByteArray

	// The STORAGE this receiver denotes, `none` when it denotes none. A DIFFERENT fact from
	// `immutableName`; see `StructBase`, which carries the same pair on to the call.
	export var subjectName as StorageSubject

	// Which PARAMETER's storage this receiver is, for the call-site half of E3207. `NoParamPositions` for
	// anything that is not a parameter's record.
	export let owner as ParamPositionMask

	// The FIELD NAME when this receiver was materialized out of a SELF-FIELD ALIAS, empty otherwise — the
	// fact the struct fallthrough names in its refusal (`structBaseOfReceiver`, and
	// `specs/self-field-struct-typed.md` for why). Every builtin arm serves such a receiver happily
	// (`items.push(v)`, `name.append("!")`), so it cannot be a gate in front of the switch; it is the tag
	// the fallthrough reads, exactly where `requireStructBase` reads `isSelfField`.
	//
	// ⚠ It is the BLAME NAME and half of the test, never the whole verdict: the fallthrough refuses only when
	// no value of the receiver's type could exist (`ProgramSignatures.structTypeIsConstructible`). A
	// constructible one — `type Outer`'s `var inner as Inner` — is dispatched on.
	export let selfFieldName as SelfFieldAlias

	static function create(value ValueId, tag ValueTypeTag, nameId TypeNameId, anchor Token, immutableName immutable ByteArray, subjectName StorageSubject, owner ParamPositionMask, selfFieldName SelfFieldAlias) returns MethodReceiver
		return Self{value: value, tag: tag, nameId: nameId, anchor: anchor, immutableName: immutableName, subjectName: subjectName, owner: owner, selfFieldName: selfFieldName}
	end 'create'

	function withValue(replacement ValueId) returns MethodReceiver
		return Self{value: replacement, tag: self.tag, nameId: self.nameId, anchor: self.anchor, immutableName: self.immutableName, subjectName: self.subjectName, owner: self.owner, selfFieldName: self.selfFieldName}
	end 'withValue'
end 'MethodReceiver'

// **THE ONE SENTENCE THAT REFUSES AN AGGREGATE-TYPED SELF-FIELD ALIAS AS A BASE**, asked by the two doors
// that can reach one: `requireStructBase` (a chained READ or WRITE — `next.a`, `next.a = 99`) and
// `structBaseOfReceiver` (a METHOD call — `next.readA()`). `specs/self-field-struct-typed.md` pins all
// three cases against the identical text, so a second spelling would go red at whichever door it was not
// updated at, and the two doors would then be free to disagree about a refusal whose wrong answer is SILENT.
//
// ⭐⭐ **THE TWO DOORS SHARE THE PREDICATE AS WELL AS THE SENTENCE, AND THE PREDICATE IS
// CONSTRUCTIBILITY** — `requireConstructibleSelfFieldBase`, which both ask. Both materialize the base
// (`baseBoxOf`) rather than addressing the alias's `boundValue`, which is 0, which is the RECEIVER. A door
// that skipped the materialization would narrow to nothing and refuse EVERY struct-typed self-field alias:
// `inner.a` in a perfectly constructible `Outer` told something untrue of it, one function away from an
// `inner.get()` that compiles and answers 41.
//
// ⚠ **THE SENTENCE ASSERTS ONLY THE HALF THAT IS TRUE AT BOTH DOORS.** "Its box has to be loaded out of the
// receiver before it can be addressed" is a true statement of what reaching the field requires at either
// door; what makes it a REFUSAL rather than a description is the type on a cycle, where no value could ever
// be put there for the load to find. A second SPELLING is still refused here.
//
// It returns the STRING and each caller throws `SourceParseError.unsupported(…)` INLINE — never `throw
// self.helperReturningAParseError(…)`, which leaks two allocations.
function structTypedSelfFieldBaseMessage(fieldName ByteArray) returns String
	return "a field access through '{String.from(fieldName)}', which is a struct-typed FIELD of the enclosing type (its box has to be loaded out of the receiver before it can be addressed)"
end 'structTypedSelfFieldBaseMessage'

// **CAN A VALUE OF THIS TAG CARRY A `StructLayout`?** — a plain struct box, or a generic INSTANCE (whose
// base struct's layout its methods were compiled once against). It is exactly `structLayoutOfType`'s
// stated precondition, and it is asked by BOTH gates standing in front of that one resolver: a BINDING
// base (`requireStructBase`) and a VALUE receiver (`structBaseOfReceiver`). The two differ only in what
// their diagnostic can name — a binding has a name, a temporary has only the member — never in which
// tags they admit, so the admitted SET is written once. Written twice, a third aggregate tag taught to
// one door would be accepted at one spelling of a member access and refused at the other: a wrong
// answer at whichever spelling was not updated, and no compile error at either.
function tagCarriesStructLayout(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.structRef or tag == ValueTypeTag.genericInstance
end 'tagCarriesStructLayout'

// Cell-ness is decided at declaration, before any read, so a read of a binding this refuses is never
// logged for the overlap check.
function bindingMayRootACell(binding VarInfo) returns bool
	let tag = maxonTypeTag(binding.varType)
	return binding.isCellBinding or tagCarriesStructLayout(tag) or tagIsByteRecord(tag)
end 'bindingMayRootACell'

// The resolved END of a field-access chain `base.f1.…fN`: the `box` its LAST field lives in
// (the base's box for a single field, an intermediate struct field's loaded box for a chain), the `layout`
// that box has, the `lastFieldTok` naming the field still to read or write, and the `baseTok`/`baseBinding`
// the chain started from. Both paths need the base binding for its mutability: the write to refuse a store
// through an immutable instance, the read to refuse handing that instance's field address to a callee.
// `resolveFieldChain` is the one producer; a chained read and a chained write are its two consumers.
type FieldChainStep
	export let box as ValueId
	export var layout as StructLayout
	export let lastFieldTok as Token
	export let baseTok as Token
	export var baseBinding as VarInfo
	export var cell as ArgumentRoot

	static function create(box ValueId, layout StructLayout, lastFieldTok Token, baseTok Token, baseBinding VarInfo, cell ArgumentRoot) returns FieldChainStep
		return Self{box: box, layout: layout, lastFieldTok: lastFieldTok, baseTok: baseTok, baseBinding: baseBinding, cell: cell}
	end 'create'
end 'FieldChainStep'

// --- Ranged-typealias range bounds ---
//
// The inclusive bounds each sized numeric type's `.min` / `.max` denotes in a range
// declaration (`typealias Handle = int(0 to u32.max)` — specs/ranged-typealias.md).
// Spelled with the very range identifiers they define, so the table cannot drift from
// the language it implements.
//
// `u64.max` does NOT fit a signed 64-bit field, and it rides as
// `TypeRules.UnsignedFullUpperPattern`, the SAME BIT PATTERN `FullRangeInt` holds for it (Maxon stores
// it as the signed -1). That is not a lossy stand-in: it is exactly the representation a value in
// an unsigned-domain alias has at runtime, so a future range check compares against it directly.
let U8MaxBound = u8.max as FullRangeInt
let U16MaxBound = u16.max as FullRangeInt

// EXPORTED: `Project`'s BUILTIN `ExitCode` alias is
// `int(0 to u32.max)` (X6), and its upper bound must be the very number a PARSED `u32.max` bound
// gives, so that a program spelling `typealias Handle = int(0 to u32.max)` and the builtin agree by
// construction rather than by two literals that happen to match.
let U32MaxBound = u32.max as FullRangeInt

// ⭐⭐ **THE SEPARATOR `FunctionTypeAlias.paramSpelling` FOLDS BETWEEN PARAMETERS, because the tokens alone do
// not carry one.** `mixWrittenTokens` folds a VARIABLE number of token texts and a punctuator's text is
// empty, so without an explicit mark the digest cannot tell `function(A, B)` from `function(A B)` — two
// arities, one hash. Its VALUE is arbitrary and its identity is not: it must simply be a byte pattern the
// fold cannot otherwise produce at that position, and naming it is what keeps it from being re-spelled as a
// bare literal at a second folding site.
//
// ⚠ It is NOT one of `SignatureIndex`'s `DeclShape*`/`TypeShape*` discriminators and must not be
// given a number out of that space: those tag WHAT KIND of declaration is being folded into the
// whole-program hash, and this marks a position INSIDE one declaration's own sub-digest, which is
// built before any of them is reached.
let FunctionAliasParamBoundary = 1

// Every unsigned type's lower bound. One constant, not four: `u8.min` and `u64.min`
// are the same zero, and a per-type spelling would only invite them to drift apart.
let UnsignedMinBound = 0
let I8MinBound = i8.min as FullRangeInt
let I8MaxBound = i8.max as FullRangeInt
let I16MinBound = i16.min as FullRangeInt
let I16MaxBound = i16.max as FullRangeInt
let I32MinBound = i32.min as FullRangeInt
let I32MaxBound = i32.max as FullRangeInt

// Exported because the integer-literal overflow diagnostic names `I64MinBound` as the lowest
// literal (the bound `parseNegatedInt` enforces) and `Project.rangeSpansEveryInt` recognizes a bare
// `int` by the pair; a second spelling of the i64 extremes could drift from either.
let I64MinBound = i64.min as FullRangeInt
let I64MaxBound = i64.max as FullRangeInt

// The finite extremes `f32`/`f64`'s `.min` / `.max` denote in a `float(...)` range declaration live
// in TypeRules (`F64MaxBound` and friends), beside the range predicates that COMPARE against them —
// `rangeIsFull` has to recognize the full f64 span, and the parser has to resolve `f64.max` to it.

// The `.min` / `.max` field names a type-qualified bound may carry.
let MinBoundField = b"min"
let MaxBoundField = b"max"

// Is a PARAMETER bound as a mutable binding? No — reassigning an unmarked one is E2013, and a `mutable`
// one is bound cell-resident instead.
//
// **It is NAMED because a second, distant thing depends on the answer and does not look like it
// does**: `assignedBindingsIn`, the loop-phi token scan, is exhaustive only while every write to a
// mutable binding is spelled `identifier =` — which a `var` parameter's call-site write is not.
// Written as a bare `BindingKind.let` at the binding site, that coupling would be invisible from
// both ends. The tripwire that enforces it lives in `bindParameters`, on the kind itself; this
// constant is what it currently reads.
let ParameterBindingKind = BindingKind.let

// The discard binding name — `walk(_)` matches the case but binds no payload. It is an ordinary
// identifier to the lexer (`_` is a legal identifier), so every door that binds a name — a match
// payload, a parameter, a destructured element — recognizes it by TEXT and declares nothing for that
// slot. A constant because it is a language fact
// (`_` means discard), spelled once.
let DiscardBindingName = b"_"

// ⭐⭐ **THE TWO CALLER-LOCATION KEYWORDS** — `specs/source-location-defaults.md`. They are ORDINARY
// IDENTIFIER tokens, not a lexer keyword pair, and that is deliberate: `__`-prefixed names are already
// reserved from every user declaration (`requireUnreservedName`), so the bytes can only ever mean this, and
// a new `TokenKind` would put a third spelling of "reserved" beside the prefix rule and the callee rule.
//
// They are NOT lexed as a token KIND. A token kind is needed only where a default's TOKENS are
// replayed at each call site, so the expansion happens in the middle of an expression parse and
// only a token can carry the fact. The default's tokens are classified ONCE, at the declaration,
// and the answer is published — so the fact travels as a `ParamDefaultProducer`, and the tokens
// need say nothing.
let CallerLineDefaultName = b"__line__"
let CallerFileDefaultName = b"__file__"

// Which of the two, if either, the identifier `name` spells — the ONE byte comparison behind every reader
// of this feature (the default classifier, the two E2060 doors, and the declaration refusal that keeps an
// exempt stdlib module from taking either name). Written once so "is this a caller-location keyword" cannot
// be answered two ways.
// ⭐ **E2060, WORDED ONCE.** Three positions raise it and all three raise it from here, because they
// are one rule seen from three sides: an ordinary EXPRESSION evaluating the name (`emitFunctionRef`), a
// struct FIELD default capturing it (`readStructFieldInto`), and a DECLARATION in the one kind of file that
// may otherwise take a `__` name (`requireUnreservedName`) — the spec's "Both names are reserved words, so
// no program can declare or shadow them", which that kind of file's declaration door would otherwise open a
// hole in.
//
// ⚠⚠ **THESE THREE ARE THE POSITIONS THAT RAISE *E2060*, AND NOT THE WHOLE OF "NOWHERE ELSE".**
// `emitFunctionRef` is the last-resort door
// for a bare name READ, so it is reached by the identifier forms that resolve to a value and by no other:
// the CALL form (`__line__()`), the DOTTED form (`__file__.length()`) and the STRUCT-LITERAL form
// (`__file__{}`) each split off in `parsePrimary` one token earlier and are refused by the door they land
// in instead — E3004 `unknownCompilerIntrinsic` for the first two, E3076 for the third; a bare statement
// call is E3004 and a TOP-LEVEL `let here = __line__` is E2004. **Every one of them IS refused** (swept
// 2026-08-13: no position outside a parameter default compiles), so the LANGUAGE rule holds; what varies is
// which code the refusal wears.
//
// ⇒ **That is a consequence of the deliberate choice above not to lex these as a token KIND**.
// Bringing the codes into line means asking this question where `parsePrimary` splits the four
// identifier forms, which is the path every identifier in every program takes — a hot-path cost,
// and its own decision, so the codes stay as they are; the three spec-pinned positions
// (`error.line-outside-default`, `error.file-outside-default`, `error.field-default`) are pinned
// byte for byte.
//
// `name` is passed rather than read off `at` for `requireUnreservedName`'s reason, which applies here
// unchanged: an IMPLICITLY BACKED enum case DECLARES the DECODED content while its token's text is the
// escape sequence, so `enum E { "\x5f\x5fline\x5f\x5f" }` declares `__line__` behind a token that spells
// nothing of the sort. The token is here for the POSITION.
function requireNotACallerLocationDefault(name ByteArray, at Token) throws SourceParseError
	match callerLocationNamed(name) 'keyword'
		none then break
		line or
		file then throw SourceParseError.callerLocationOutsideDefault(String.from(name), line: at.line, column: at.column)
	end 'keyword'
end 'requireNotACallerLocationDefault'

// ⭐⭐ **WHICH OF THE TWO CALLER-LOCATION KEYWORDS A DEFAULT IS, OR NEITHER** — the answer
// `callerLocationDefaultAt` reads off a default's TOKENS, and the one BOTH walks of a parameter list ask:
// the declaration sweep, which publishes the slot, and the real parse, which must mint no helper for it.
// One classifier, so the two cannot come to disagree about what a slot is — the failure
// `sweptParamDefaultHelperName`'s panic exists to name.
//
// ⚠ It lives HERE and not beside `SignatureIndex.ParamDefaultProducer`, which the sweep PROJECTS it onto,
// because the two answer different questions and only one of them travels: this is a fact about a region of
// TOKENS, read by this file alone; that is a fact about a CALL SITE, published whole-program. A projection
// is not a duplicate, and putting the syntactic half in the index would have made the index depend on the
// grammar it is fed by.
//
// `none` is the overwhelming common answer, and is the ordinary default the helper mechanism owns.
union CallerLocationDefault
	none
	line
	file
end 'CallerLocationDefault'

// Does this slot declare no default at all? The one gate `fillArgsFromParamDefaults` needs before it
// commits a slot — `emitDefaultArgValue` covers the other three arms and panics on this one, so the two
// together are exhaustive over the union with no arm answered in two places.
function producerIsRequired(producer ParamDefaultProducer) returns bool
	return match producer 'produces'
		required gives true
		callerLine or
		callerFile or
		helper gives false
	end 'produces'
end 'producerIsRequired'

// Does a classified default region name one of the two? The `match` both the sweep and the real parse
// branch on, written once rather than as two `is`-chains that could come to cover different arms.
function isCallerLocationDefault(kind CallerLocationDefault) returns bool
	return match kind 'kind'
		none gives false
		line or
		file gives true
	end 'kind'
end 'isCallerLocationDefault'

// The whole-program slot a caller-location default publishes. It panics on `none` because the sweep asks it
// only inside the branch `isCallerLocationDefault` has already claimed — the alternative, an arm answering
// `required` for it, would publish "this parameter has no default" for a parameter that plainly has one.
function paramDefaultProducerOf(kind CallerLocationDefault) returns ParamDefaultProducer
	return match kind 'kind'
		none panic("paramDefaultProducerOf: `none` is not a caller-location default — the only caller asks this inside the branch `isCallerLocationDefault` already answered true for")
		line gives ParamDefaultProducer.callerLine
		file gives ParamDefaultProducer.callerFile
	end 'kind'
end 'paramDefaultProducerOf'

function callerLocationNamed(name ByteArray) returns CallerLocationDefault
	if name.equals(CallerLineDefaultName) 'line'
		return CallerLocationDefault.line
	end 'line'

	if name.equals(CallerFileDefaultName) 'file'
		return CallerLocationDefault.file
	end 'file'

	return CallerLocationDefault.none
end 'callerLocationNamed'

let MethodNameOffset = 2

function textMemberRewritesItsReceiver(member ByteArray) returns bool
	return member.equals(AppendMethod) or member.equals(ManagedMemorySetByteMethod)
end 'textMemberRewritesItsReceiver'

// The hidden slot a deferred field is held in. Spelled once, because three readers ask for it — the
// declaration, the write, and the `if`/loop carried-variable scan that must see the write as a write.
function nascentSelfSlotName(fieldName ByteArray) returns immutable ByteArray
	return freeze "{NascentSelfSlotPrefix}{String.from(fieldName)}".toByteArray()
end 'nascentSelfSlotName'

// `Parser.nascentWriteReaches` asks about a whole block rather than a prefix of one. A position no write can
// hold, so the two questions need no second parameter to tell them apart.
let NascentWholeBlock = 0

// `'x', 'y'` (or `x, y` with an empty `quote`) — one renderer, so every diagnostic spells a list of names
// the same way.
function nameList(names NameRoster, quote String) returns String
	var list = ""

	for name in names 'each'
		list = appendCommaSeparated(list, item: "{quote}{String.from(name)}{quote}")
	end 'each'

	return list
end 'nameList'

let DiagnosticNameQuote = "'"
let UnquotedName = ""

// Does this op transfer control to `target`? EXHAUSTIVE over `MaxonOp`, so a terminator appended to the
// dialect is classified here rather than silently reading as "no successor" — which in a dataflow meeting by
// intersection is not a missed edge but a WRONG proof.
function nascentOpBranchesTo(op MaxonOp, target BlockId) returns bool
	return match op 'k'
		branch(targetBlockId) gives targetBlockId == target
		condBranch(_, thenBlockId, elseBlockId) gives thenBlockId == target or elseBlockId == target
		switch(_, denseTargetBlockIds, defaultBlockId) gives defaultBlockId == target or blockIdsInclude(denseTargetBlockIds, target: target)
		call or
		literal or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives false
	end 'k'
end 'nascentOpBranchesTo'

// Is `target` one of a `switch`'s dense arm targets? A `match` names its arms this way, so a dispatch's
// edges are as real as an `if`'s and a walk that missed them would prove a field assigned in one arm was
// assigned in all of them.
function blockIdsInclude(ids BlockIdArray, target BlockId) returns bool
	for id in ids 'each'
		if id == target 'thisOne'
			return true
		end 'thisOne'
	end 'each'

	return false
end 'blockIdsInclude'

// Add `item` to a `", "`-separated list — the separator every list a diagnostic spells out uses (E2026's
// uncovered-case list, E3081's discard list, the witness-candidate and conformance signature lists),
// spelled ONCE so two messages rendering a list of the same kind cannot come to punctuate it differently.
//
// ⚠ It accumulates a string rather than joining an array: `checkEnumExhaustive` calls this from the loop
// it walks on EVERY enum match, not only a rejected one, so a `StringArray` to join would cost one
// allocation per enum match in the program, for a list only a refused program ever renders.
//
// An empty `list` means "nothing appended yet" exactly: every item any site passes is non-empty (an enum
// case name is an identifier, the discard is `_`, a rendered signature carries at least `name() returns T`),
// so no `isFirst` flag is needed.
function appendCommaSeparated(list String, item String) returns String
	if list.isEmpty() 'firstItem'
		return item
	end 'firstItem'

	return "{list}, {item}"
end 'appendCommaSeparated'

// An all-discard binding list spelled back as the user wrote it — `_`, `_, _`, … — for E3081's message
// ("use 'two' instead of 'two(_, _)'"). Built from the COUNT rather than from the bindings themselves
// because every one of them is the same token by definition of the diagnostic, and it reads the
// discard's own spelling so a language that renamed `_` renames the message with it.
function discardBindingList(count ElementIndex) returns String
	var list = ""

	// The index is not read — every slot renders the same token — so the loop variable is the discard.
	for _ in 0 upto count 'eachSlot'
		list = appendCommaSeparated(list, item: String.from(DiscardBindingName))
	end 'eachSlot'

	return list
end 'discardBindingList'

// How many `.field` HOPS a token-level field-chain walk must find (`Parser.fieldChainEndAfter`). A
// chain-METHOD call needs at least two (`b.ops.push(1)`) — the ONE-hop `b.push(1)` is the binding-
// receiver path's, which `methodCallsAt` takes — while a call statement's callee name or an assignment's
// target accepts any chain at all, a bare name (zero hops) included.
typealias FieldHopCount = int(0 to u64.max)

let ChainMethodMinHops = 2

// A field STORE needs one hop and no more (`p.x = 1`, `o.inner.x = 1`) — the zero-hop `x = 1` is a
// BINDING assignment, which `assignsAt` owns and `fieldAssignsAt` must not claim.
let FieldStoreMinHops = 1

// Counted from the static member's token, so the one hop a static member call needs is the method
// itself (`Names.items.push(9)`) and any field hops of a longer chain come before it.
let StaticMemberCallMinHops = 1

let AnyFieldHops = 0

// The label of the placeholder block a Parser holds before it has parsed a function. It
// belongs to no function and is registered in no module; `parseFunction` replaces it
// before any op is emitted. Named so that if one ever DID reach the IR, the printed block
// label would say exactly what went wrong.
let DetachedBlockLabel = b"detached"

// ⭐ What joins a type's name to a method's in the name a method is DECLARED and CALLED under:
// `Point.create`. A dot, VERBATIM — the mangled name carries the separator the source wrote, which
// is what the rendered Target IR shows.
//
// It is a constant because two very distant places must spell it identically: `declaredMethodName`
// (which names the `IrFunction` and its `funcSignatures` key) and `parseQualifiedCall` (which
// builds the callee of `Point.create(3, y: 4)`). Written twice, a change to the mangling would
// leave every method declared under one name and called under another — and the failure would be
// E3004 "call to undefined function 'Point.create'", pointing at a call that is perfectly correct.
//
// ⚠ **IT MUST ALSO SPELL THE SAME BYTE AS `SignatureIndex.QualifiedAliasSeparator`.**
// `resolvesAsNamespaceQualifiedFunction` vetoes a chain through `declaresCallee`, whose `Type.method`
// keys are mangled through THIS constant, while the chain `ChainResolution.resolveChain` hands it is
// joined by `joinQualifiedName`, which spells the OTHER one. The two remain separate facts — this one is the
// byte an emitted SYMBOL carries; that one is the byte the SOURCE writes between two name segments
// — but they are no longer free to move independently. What keeps them from drifting silently is
// not this note: it is that every one-dot `dir.fn()` case in `specs/namespaces.md` goes RED the
// moment they disagree, with an E3004 naming a callee that is perfectly correct. The check exists;
// this says which one it is.
let MethodNameSeparator = "."

// The same separator as bytes — what `qualifiedMethodName` joins through and what the byte probes around
// `isQualifiedUnderTypeName` compare against. Both run once per method declaration, once per method call
// site and again in the declaration pre-scan, so a cost here is linear in the program: rendering one
// spelling into the other per ask is what the second constant buys off, and the String above stays for
// `bareMethodName`, which splits a String.
//
// What makes the duplication safe is not this comment: it is that the two copies have a test between them.
// Every direct builtin-conformance dispatch resolves through `isCompilerInternalCallee` →
// `isBuiltinConformanceImplName` → `SignatureIndex.nameIsQualifiedBy`, so a byte here that
// disagrees with the join above makes every direct builtin-conformance call fail to be recognized
// as compiler-owned, and every
// `primitive-comparable`/`primitive-hashable`/`method-call-on-call-result` case goes red with
// E3004. The copies cannot drift silently.
//
// ⚠ It deliberately quotes neither the impl roster nor a case count. What the check is worth does not
// depend on the number, and a number nothing verifies is just a second place to be wrong.
let MethodNameSeparatorBytes = b"."

// ⭐ **ONE FIELD OF A `call` REPLACED — ITS CALLEE — AND EVERY OTHER CARRIED THROUGH.** The whole edit
// `Parser.foldByteViewIntoStreamWrite` makes is this substitution: the byte view's producer becomes the
// consumer that was going to read it, on the same result value, the same argument, the same labels, ranges
// and mint. Written as one function so a rewrite cannot silently drop a field the op grows later — a
// `MaxonOp.call` respelled at the rewrite site would have to be revisited every time the variant does.
//
// ⚠ The op it rewrites, `String.addressableBytes(s)`, carries exactly one argument and that argument is the
// String, so the substitution depends on nothing but the callee: re-aiming the fold at another producer of
// the same shape needs no change here.
//
// The `default` panics because the only caller reads an op INDEX its own filing site recorded, and re-checks
// the callee before rewriting; anything else is that pairing broken, which is a compiler bug and not a
// program's.
function callWithCallee(op MaxonOp, callee ByteArray) returns MaxonOp
	return match op 'c'
		call(result, _, args, argLabels, argRanges, argImmutableNames, mint) gives MaxonOp.call(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, mint: mint)
		default panic("callWithCallee: the op is not a `call`, so it has no callee to replace — every caller reads an index filed by the site that appended a call at it")
	end 'c'
end 'callWithCallee'

// ⭐ **IS THE OP AT THIS INDEX THE DIRECT CALL TO `callee`?** The stream-write fold's re-match. Its filing
// site does not itself append the op: `dispatchMethodOnBase` reads `opCount()` before handing the cursor to
// `parseCallNamed`, so the index is a FLOOR rather than a certainty. Checked rather than trusted, a
// `parseCallNamed` that one day appends a setup op ahead of the call makes the fold DECLINE — one allocation
// back — instead of rewriting an unrelated op, which is the only failure direction a peephole may have.
//
// ⚠ It classifies through `maxonOpCalleeKind` rather than matching `MaxonOp` here, because a bare `default`
// is exactly what this project forbids and a 28-arm restatement is what it forbids it FOR: that classifier
// is the one place the variants are enumerated, and it already answers `noCallee` for everything that binds
// no name. The VALUE identity needs no check — `stringBytesViewOps` is keyed by it, so a hit already proves
// the map filed this index for this value.
function opIsDirectCallTo(op MaxonOp, callee ByteArray) returns bool
	return match maxonOpCalleeKind(op) 'kind'
		direct gives maxonOpCalleeName(op).equals(callee)
		functionValue or
		noCallee gives false
	end 'kind'
end 'opIsDirectCallTo'

// The DECODED payload of a `stringLiteral` op. Its one caller reached this op through
// `ConstPayloadDomain.stringLiteralOp`, which `emitStringLiteral` is the sole writer of — so any other
// variant here is that column pointing at the wrong op, which is a broken invariant and not a case to answer.
function stringLiteralOpBytes(op MaxonOp) returns immutable ByteArray
	return match op 'op'
		stringLiteral(_, bytes) gives bytes
		default panic("stringLiteralOpBytes: the op `ConstPayloadDomain.stringLiteralOp` names is not a `stringLiteral` — `emitStringLiteral` files that index off `module.opCount()` as it appends the op, so the two cannot disagree")
	end 'op'
end 'stringLiteralOpBytes'

// `Point.create` — the name a type's method is declared and called under. ONE spelling, read by
// `Parser.declaredMethodName` (the declaration) and `Parser.parseQualifiedCall` (the use). See
// `MethodNameSeparatorBytes` for why the separator is written twice.
function qualifiedMethodName(typeName ByteArray, methodName ByteArray) returns immutable ByteArray
	let joined = ByteArray.create(typeName.count() + MethodNameSeparatorBytes.count() + methodName.count(), zeroed: false) as isolated ByteArray

	modify joined 'fill'
		joined.append(typeName)
		joined.append(MethodNameSeparatorBytes)
		joined.append(methodName)
	end 'fill'

	return freeze joined
end 'qualifiedMethodName'

// ⭐ **HOW MANY DOTS A `Type.method` NAME CARRIES — EXACTLY ONE.** It is the fewest a dotted chain
// needs before its head can name a TYPE (`resolveQualifiedChainAtCursor`'s minimum), and a chain of
// exactly one is a bare type name and its member (`spawnedTypeAt`), because `declaredMethodName`
// joins one type name to one method name and neither may hold a "."; a longer chain qualifies the
// type with its directories (`sub.Calc.ping()`). Named rather than written as a bare `1` beside
// `TokensPerQualifierSegment`'s `2`, where it would read as arithmetic instead of as a rule.
let MethodQualifierDots = 1

// ⭐⭐ **`int.fromString(s)` IS `__int_fromString(s)` — THE ONE STATIC-CALL BASE THAT NAMES NO DECLARED
// TYPE.** A primitive has no `type` declaration to hang a `static function` on, so its statics live in the
// reserved space as free functions and the PARSER is what joins the two spellings. `stdlib/Builtins.maxon`
// declares all four bodies (`__int_fromString` `:213`, `__float_fromString` `:250`, `__bool_fromString`
// `:309`, `__byte_fromString` `:321`), and this rewrite is what makes them reachable from an ordinary
// program as `int.fromString`.
//
// ⭐ **THE FOUR ARE NOT ONE TOKEN KIND, AND THAT IS WHY THIS IS A NAME TEST RATHER THAN A KIND
// TEST.** `int`/`float`/`bool` are KEYWORDS (`KeywordTable`) and reach a dotted expression
// only through `typeBaseTokenAt`'s primitive arm; `byte` is a PLAIN IDENTIFIER — there is no
// `TokenKind.byte` at all — so `byte.fromString(…)` already flows through `parsePrimary`'s
// `namedPrimary` arm and arrives with nothing to rewrite. A test over TOKEN KINDS answers
// `byte.fromString` with a callee no file declares the moment `byte` loses its keyword. Asking
// about the primitive TYPE NAME covers both doors with one rule, and a fifth primitive would need
// no second place taught.
let ByteTypeName = b"byte"

let CountAliasName = b"Count"

let MailboxCapacityAliasName = b"MailboxCapacity"

let MillisecondsAliasName = b"Milliseconds"

let NoSendTimeoutMs = 0

let DefaultMailboxCapacityName = b"DefaultMailboxCapacity"

let FileSizeAliasName = b"FileSize"

let BytePosAliasName = b"BytePos"

let NetworkPortAliasName = b"NetworkPort"

let ByteAliasName = b"Byte"

let InstantMsAliasName = b"InstantMs"

let InstantNanosAliasName = b"InstantNanos"

let UnixSecondsAliasName = b"UnixSeconds"

let UnixNanosAliasName = b"UnixNanos"

let DurationMsAliasName = b"DurationMs"

let PidAliasName = b"Pid"

let NoAnswerAlias = b""

let ReportedCapacityAliasName = b"ReportedCapacity"

let ConstBlobWordBytes = 8

function wordsOfConstBlob(bytes ByteArray, count ElementIndex) returns FullRangeIntArray
	let words = FullRangeIntArray.create(count, zeroed: false)

	for word in 0 upto count 'eachWord'
		var assembled = 0 as FullRangeInt

		for position in 0 upto ConstBlobWordBytes 'eachByte'
			let byte = try bytes.get(word * ConstBlobWordBytes + position) otherwise panic("wordsOfConstBlob: byte {position} of word {word} is past a blob of {bytes.count()} bytes — an image record's length is its element count times its stride")
			assembled = assembled or ((byte as FullRangeInt) shl (position * 8))
		end 'eachByte'

		words.push(assembled)
	end 'eachWord'

	return words
end 'wordsOfConstBlob'

let ElementIndexAliasName = b"ElementIndex"

// The `bits(n)` spelling. An ORDINARY IDENTIFIER like `byte`, never a keyword — `bits` and `word`
// are live variable names throughout this compiler, and reserving either would refuse its own source.
let BitsTypeName = b"bits"

// The join `stdlib/Builtins.maxon` ALREADY SPELLS — `__`, the primitive's name, `_`, the method's.
//
// ⚠ It is DICTATED, not chosen: the target is an existing declaration in that module and both reference
// compilers emit the identical name, so this is a spelling to MATCH rather than a mangling to design. That
// is also why the `_` here is not the injective-join rule docs/internals/names-and-values.md states for
// `IrInterface.witnessTableLabel` — the left component is drawn from the closed, `_`-free vocabulary
// `namesAPrimitiveType` states, so no two `(primitive, method)` pairs can spell one name.
let PrimitiveStaticNameSeparator = "_"

// The same separator as BYTES, for the join's INVERSE (`primitiveStaticSourceSpelling`), which scans a
// callee for it. Written twice for `MethodNameSeparatorBytes`' reason and with a stronger protection than
// that one has: the two copies have a TEST between them at every use — the inverse re-mints the halves it
// split through the FORWARD join and panics unless they spell the name back.
let PrimitiveStaticSeparatorBytes = b"_"

// The reserved-space free function a `<primitive>.<method>(…)` call links to. ONE speller, for
// `MethodNameSeparator`'s reason: the mint and the "is it declared?" probe that gates it must ask about the
// same bytes, or the parser would rewrite to a name it never checked for.
function primitiveStaticCallee(typeName ByteArray, methodName ByteArray) returns immutable ByteArray
	return freeze "{String.from(ReservedTypeNamePrefix)}{String.from(typeName)}{PrimitiveStaticNameSeparator}{String.from(methodName)}".toByteArray()
end 'primitiveStaticCallee'

// ⭐⭐ **THE INVERSE OF THE MINT — `__int_fromString` → `int.fromString`, which is the NOUN every diagnostic
// about such a call must use.** It lives HERE, one line under the forward join, because the two are one
// fact read in two directions: a decoder written where it is CONSUMED (`SemanticCheck`) could drift from
// the join and nothing would fail to compile — the message would just start naming a function nobody wrote,
// which is the very defect this exists to remove.
//
// ⚠ **IT IS ASKED ONLY OF A CALL SITE THE OP MARKS `CalleeMint.primitiveStatic`** — never keyed on the name.
// `stdlib/Builtins.maxon` calls `__int_fromString` having written those bytes, and renaming ITS diagnostics
// would be a lossy name key with the arrow reversed. The op carries the site's answer; this only spells it.
//
// ⭐ **AND IT CHECKS ITSELF AGAINST THE FORWARD JOIN RATHER THAN TRUSTING ITS OWN SPLIT.** The decode is a
// split at the first `_` past the reserved prefix, which is exact only while every primitive's name is
// `_`-free — true of the closed four, and a premise a future primitive could break silently. Re-minting the
// halves and comparing turns that premise into a check the forward join owns: if the two ever disagree the
// compiler panics here, naming both, instead of quoting a plausible wrong name at an author.
function primitiveStaticSourceSpelling(callee ByteArray) returns immutable ByteArray
	let separator = try PrimitiveStaticSeparatorBytes.get(0) otherwise panic("primitiveStaticSourceSpelling: PrimitiveStaticSeparatorBytes is a one-byte literal")
	let head = try callee.slice(ReservedTypeNamePrefix.count(), endIndex: callee.count()) otherwise panic("primitiveStaticSourceSpelling: '{String.from(callee)}' is shorter than the reserved prefix, so `primitiveStaticCallee` cannot have minted it")

	var split = head.count()

	for i in 0 upto head.count() 'scan'
		if (try head.get(i) otherwise panic("primitiveStaticSourceSpelling: head.get OOB at {i} inside its own count()")) == separator 'separatorHere'
			split = i
			break
		end 'separatorHere'
	end 'scan'

	if split == head.count() 'noSeparator'
		panic("primitiveStaticSourceSpelling: '{String.from(callee)}' holds no '{PrimitiveStaticNameSeparator}' past the reserved prefix, so `primitiveStaticCallee` cannot have minted it — only a call site the op marks `CalleeMint.primitiveStatic` may be asked")
	end 'noSeparator'

	let typeName = try head.slice(0, endIndex: split) otherwise panic("primitiveStaticSourceSpelling: slice [0, {split}) of a {head.count()}-byte name is in range by the index just found")
	let methodName = try head.slice(split + 1, endIndex: head.count()) otherwise panic("primitiveStaticSourceSpelling: slice [{split + 1}, {head.count()}) is in range by the index just found")

	if not primitiveStaticCallee(typeName, methodName: methodName).equals(callee) 'decodeDisagreesWithTheMint'
		panic("primitiveStaticSourceSpelling: '{String.from(callee)}' splits as ('{String.from(typeName)}', '{String.from(methodName)}'), which `primitiveStaticCallee` re-mints as '{String.from(primitiveStaticCallee(typeName, methodName: methodName))}' — the join and its inverse have come apart, which is what happens the moment a primitive's own name holds the separator")
	end 'decodeDisagreesWithTheMint'

	return qualifiedMethodName(typeName, methodName: methodName)
end 'primitiveStaticSourceSpelling'

// ⭐ **DOES THIS BASE NAME ONE OF THE FOUR PRIMITIVE TYPES?** Allocation-free, because it is asked of EVERY
// qualified call's base — the same `equals`-chain discipline the math-intrinsic table documents, and for
// the same measured reason. The three keyword names are `IrInterface`'s canonical constants rather than
// fresh literals: those are what a resolved `integer`/`float`/`boolean` tag is called everywhere in the
// compiler, and a second spelling of `int` is exactly what `BoolConformerName`'s header forbids.
function namesAPrimitiveType(name ByteArray) returns bool
	return name.equals(IntConformerName) or name.equals(FloatConformerName) or name.equals(BoolConformerName) or name.equals(ByteTypeName)
end 'namesAPrimitiveType'

// ⭐ **IS THIS TOKEN A KEYWORD THAT NAMES A PRIMITIVE TYPE?** — the door-1 half, DERIVED from the
// name list above rather than listed a second time as three `TokenKind`s. A keyword's `value` IS
// its spelling (the lexer keys `KeywordTable` on those very bytes), so "which kinds need the
// rewrite" falls out of "which names have statics", and a fifth primitive is added in ONE place. A
// written-out kind list drops a primitive out of the feature silently the moment it loses its
// keyword.
//
// The identifier exclusion is what makes it the door-1 half specifically: `byte` reaches every type-named
// form as a plain identifier already, so it needs no rewriting and must not be claimed here. `tokenCanBeAName`
// excludes the literal kinds, so a `"int"` STRING literal cannot answer yes on its content.
function keywordNamesAPrimitiveType(tok Token) returns bool
	return tok.kind != TokenKind.identifier and tokenCanBeAName(tok) and namesAPrimitiveType(tok.value)
end 'keywordNamesAPrimitiveType'

// ⭐⭐ **A PRIMITIVE THAT HAS A RANGE TO NAME** — `int` and `float`, and NOT `bool`. This is the set the
// ranged-typealias rule reaches (`Parser.parseTypeReference`'s bare arm), and it is
// DERIVED from the name list above for the reason `keywordNamesAPrimitiveType`'s header gives: a keyword's
// `value` IS its spelling, so a new primitive joins in one place instead of in a hand-copied `TokenKind` list.
//
// ⚠ **`bool` IS EXCLUDED BY THE RULE'S OWN REASON, not by taste** — it is already a constrained type with
// nothing to range, which is the identical sentence E2061 uses to admit it as a type argument. `byte` is
// excluded structurally: The compiler has no `TokenKind.byte` (see `ByteTypeName`), so it arrives as a plain
// identifier and `keywordNamesAPrimitiveType`'s identifier exclusion has already dropped it.
//
// ⛔⛔ **IT ASKS THE TOKEN AND MUST NEVER BE RESTATED ON THE TAG.** `cstring` mints `MaxonType.integer` —
// the SAME tag a bare `int` does (`parseTypeReference`'s `cstringPointer` arm says why) — so a tag-side
// spelling of this rule (`tagIsBareNumericKeyword`, or a guard at `parseTypeReference`'s CALLERS) would
// refuse `stdlib/String.maxon`'s `returns cstring`. The stdlib is in every build, so that compiler would
// refuse to compile anything at all. The token is the only place the two are still distinguishable.
function nameIsARangedPrimitive(name ByteArray) returns bool
	return name.equals(IntConformerName) or name.equals(FloatConformerName)
end 'nameIsARangedPrimitive'

function keywordIsARangedPrimitive(tok Token) returns bool
	return tok.kind != TokenKind.identifier and tokenCanBeAName(tok) and nameIsARangedPrimitive(tok.value)
end 'keywordIsARangedPrimitive'

// ⚠ **THE ANCHOR IS THE KEYWORD, NOT THE `as`** — a deliberate difference from its neighbours.
// E3009, E3010, E3011 and E3131 anchor on the `as`, because that is *"the only token certainly part
// of a cast when the name denotes nothing anywhere"*. Here the offending token exists, is a
// keyword, and is the one the author has to rewrite. It is the anchor for BOTH messages (column 15
// of `\tlet n = s as int`, which is the `int`).
function requireNotABarePrimitive(tok Token, voice BarePrimitiveVoice) throws SourceParseError
	match voice 'position'
		admitted then return
		asAType then throw SourceParseError.barePrimitiveType(String.from(tok.value), line: tok.line, column: tok.column)
		asACastTarget then throw SourceParseError.barePrimitiveCastTarget(String.from(tok.value), line: tok.line, column: tok.column)
	end 'position'
end 'requireNotABarePrimitive'

// ⭐ **THE ONE SENTENCE BOTH COMPILER-OWNED-STATIC REFUSALS SAY.** The FACT is one — the base names a type
// whose surface the compiler owns, and nothing declares the member written after it — and the only thing
// that differs between the two doors is WHERE such a member would have had to be declared. Written once so
// the two cannot come to describe one mistake in two voices.
function noSuchOwnedStatic(typeTok Token, memberTok Token, surfaceClause String) returns SourceParseError
	return missingStaticMember("'{String.from(typeTok.value)}' has no static method named '{String.from(memberTok.value)}' — {surfaceClause}", anchor: memberTok)
end 'noSuchOwnedStatic'

// An unknown static on any other base is left to mangle, and `SemanticCheck.validateCall` reports
// E3004 — pinned by `method-calls`, `self-type-member-expression` and `static-method-statement`.
// That works only while the call's result is unused: an undeclared callee types its result
// `unknown`, so a use of it is refused first (E2015 on a member access, naming neither type nor
// member) and the parse error ends the file before SemanticCheck runs. A compiler-owned type name
// cannot be declared, so `String.<member>` cannot mean a type not yet written, and an unknown
// static on it is refused here, at the call.
//
// The program can still declare members on such a type (an `extension String`;
// `stdlib/String.maxon` declares thirty), so the question is only whether the program has this
// function. A synthesized conformance impl (`String.hash`) is `requireCalleeIsNotReservedName`'s to
// refuse.
function requireCompilerOwnedStaticIsResolvable(typeTok Token, memberTok Token, declaredCallee ByteArray, signatures ProgramSignatures) throws SourceParseError
	if not isCompilerOwnedTypeName(typeTok.value) 'ordinaryQualifier'
		return
	end 'ordinaryQualifier'

	if signatures.definesCallee(declaredCallee) 'theCompilersOwnSymbolOrTheProgramsOwnDeclaration'
		return
	end 'theCompilersOwnSymbolOrTheProgramsOwnDeclaration'

	throw noSuchOwnedStatic(typeTok, memberTok: memberTok, surfaceClause: "the compiler owns that type name, so a static of its own can only come from the module that declares it or from an `extension` of it, and no declaration of that name exists")
end 'requireCompilerOwnedStaticIsResolvable'

type QualifiedReturn
	export let returnType as MaxonReturnType
	export let capability as ResultCapability

	static function create(returnType MaxonReturnType, capability ResultCapability) returns QualifiedReturn
		return Self{returnType: returnType, capability: capability}
	end 'create'
end 'QualifiedReturn'

type FunctionTypeReturn
	export let tag as ValueTypeTag
	export let typeName as immutable ByteArray
	export let identity as AliasSlotIdentity
	export let aggregateName as immutable ByteArray
	export let capability as ResultCapability

	static function create(tag ValueTypeTag, typeName ByteArray, identity AliasSlotIdentity, aggregateName ByteArray, capability ResultCapability) returns FunctionTypeReturn
		return Self{tag: tag, typeName: typeName, identity: identity, aggregateName: aggregateName, capability: capability}
	end 'create'

	static function absent() returns FunctionTypeReturn
		return Self{tag: ValueTypeTag.void, typeName: EmptySourceText, identity: AliasSlotIdentity.nameOnly, aggregateName: EmptySourceText, capability: ResultCapability.unmarked}
	end 'absent'
end 'FunctionTypeReturn'

// ⭐ `Point.create` ⇒ `create` — `qualifiedMethodName`'s INVERSE, and here beside it for that
// reason. A free function's name has no qualifier and comes back unchanged. Read by the diagnostics
// that name a function the way the AUTHOR wrote it (`c.convert(21)` mentions `convert`, not
// `Converter.convert`).
// It answers a `String` because splitting on the separator this file already spells as a `String` keeps the
// join and its inverse reading the same constant, and its first reader is a diagnostic, which needs one.
//
// ⚠ **IT IS NOT A COLD PATH.** `SemanticCheck.WitnessDispatchTargets.splitBareNames` runs it once per
// declared function of the whole program — which is why that column is built on demand rather than at
// construction — so a `String.from` and a `split` here are paid per function by any program that dispatches
// through a witness slot.
function bareMethodName(name ByteArray) returns String
	let segments = String.from(name).split(MethodNameSeparator)
	return try segments.get(segments.count() - 1) otherwise String.from(name)
end 'bareMethodName'

function duplicateDeclarationMessage(registered ByteArray) returns String
	if not registersAFreeFunction(registered) 'aMethod'
		return "Duplicate method '{bareMethodName(registered)}' in type '{String.from(qualifyingTypeName(registered))}'"
	end 'aMethod'

	return duplicateDefinitionMessage(String.from(bareNameOfMint(registered)), incumbentKeyword: FunctionKeyword)
end 'duplicateDeclarationMessage'

function fieldAndMethodMessage(member ByteArray, typeName ByteArray) returns String
	return "'{String.from(member)}' names both a field and a method of type '{String.from(typeName)}'"
end 'fieldAndMethodMessage'

function layoutReceivingField(declared StructLayout, repeatsAField bool) returns StructLayout
	if not repeatsAField 'aNewName'
		return declared
	end 'aNewName'

	return StructLayout.create(declared.name, visibility: declared.visibility, declFilePath: declared.declFilePath)
end 'layoutReceivingField'

function baseNotGenericMessage(base ByteArray) returns String
	return "Type '{sourceSpelledAliasText(base)}' has no associated types"
end 'baseNotGenericMessage'

function genericArgumentCountCode(layout StructLayout) returns ErrorCode
	return ErrorCode.genericBaseNotGeneric if layout.typeParamCount() == 0 else ErrorCode.genericArityMismatch
end 'genericArgumentCountCode'

function genericArityMismatchMessage(typeName ByteArray, expected String, supplied FieldIndex) returns String
	return "generic type '{String.from(typeName)}' expects {expected} type argument(s), but {supplied} were supplied"
end 'genericArityMismatchMessage'

function genericArityPhrase(least FieldIndex, most FieldIndex) returns String
	return "{most}" if least == most else "{least} or {most}"
end 'genericArityPhrase'

function genericArgumentCountMessage(layout StructLayout, supplied FieldIndex) returns String
	if layout.typeParamCount() == 0 'notGeneric'
		return baseNotGenericMessage(layout.name)
	end 'notGeneric'

	return genericArityMismatchMessage(layout.name, expected: genericArityPhrase(layoutLeastTypeArguments(layout), most: layout.typeParamCount()), supplied: supplied)
end 'genericArgumentCountMessage'

function duplicateFieldMessage(member ByteArray, typeName ByteArray) returns String
	return "Duplicate field '{String.from(member)}' in type '{String.from(typeName)}'"
end 'duplicateFieldMessage'

enum TypeMemberKind
	field
	method
end 'TypeMemberKind'

typealias TypeMemberNames = Map with (ByteArray, TypeMemberKind)

// Where a signature's USER parameters begin — past the receiver an instance method carries at slot 0.
function firstUserParamIndex(takesReceiver bool) returns ParamCount
	return 1 if takesReceiver else 0
end 'firstUserParamIndex'

function callPositionOfColumn(takesReceiver bool, column ParamCount) returns ParamCount
	return column + firstUserParamIndex(takesReceiver)
end 'callPositionOfColumn'

function columnOfCallPosition(takesReceiver bool, position ParamCount) returns ParamCount throws AbsentError
	let receiverSlots = firstUserParamIndex(takesReceiver)

	if position < receiverSlots 'theReceiver'
		throw AbsentError.absent
	end 'theReceiver'

	return position - receiverSlots
end 'columnOfCallPosition'

// ⭐⭐ **ONE `interface` MAY NOT DECLARE TWO REQUIREMENTS OF ONE NAME — because `witnessSlotImplKey`
// CARRIES NO ARITY, so two such requirements are two SLOTS under ONE key.** `ConformanceCheck` files the
// member it accepted for a requirement under `(conformer, declaring interface, method NAME)`
// (`recordWitnessSlotImpl`) and `LowerMaxonToStd.ensureWitnessTable` stamps each slot's relocation from that
// filing. Two same-named requirements of one interface collide there: the first selection is filed, the
// second leaves BOTH slots stamped from one member. This refusal is what
// keeps that key injective over slots.
//
// Only the NAME is compared, never the formals — because the NAME is the whole of what the impl key holds.
function requireUnclaimedInterfaceRequirementName(nameTok Token, interfaceName ByteArray, claimed RequirementNameSet) throws SourceParseError
	if claimed.contains(nameTok.value) 'duplicate'
		throw SourceParseError.duplicateDeclaration("Duplicate requirement '{String.from(nameTok.value)}' in interface '{String.from(interfaceName)}'", line: nameTok.line, column: nameTok.column)
	end 'duplicate'

	claimed.insert(nameTok.value)
end 'requireUnclaimedInterfaceRequirementName'

// The MEMBER half of a qualified corpus callee — `Array.last` → `last`. A diagnostic must name what the
// AUTHOR wrote; `calleeMemberNoun` states the same rule for the compiler-emitted doors, and this is it for
// the corpus ones. Returns the whole name when it carries no separator, which is not reachable from the one
// caller (it is past `isQualifiedUnderTypeName`) but is the only honest answer if it ever were.
function unqualifiedMemberName(callee ByteArray) returns ByteArray
	let separator = try MethodNameSeparatorBytes.get(0) otherwise panic("unqualifiedMemberName: MethodNameSeparatorBytes is a one-byte literal")
	var start = 0 as ElementIndex

	for i in 0 upto callee.count() 'eachByte'
		if (try callee.get(i) otherwise panic("unqualifiedMemberName: index {i} is below count {callee.count()}")) == separator 'separatorHere'
			start = i + 1
		end 'separatorHere'
	end 'eachByte'

	let out = ByteArray.create(callee.count() - start, zeroed: false)

	for i in start upto callee.count() 'eachMemberByte'
		out.push(try callee.get(i) otherwise panic("unqualifiedMemberName: index {i} is below count {callee.count()}"))
	end 'eachMemberByte'

	return out
end 'unqualifiedMemberName'

// ⭐ **THE QUALIFIER HALF — `Array.last` → `Array`.** The mirror of the member split above, homed beside it
// and beside the JOIN the two undo (`qualifiedMethodName`), so a change to how a qualified callee is spelled
// moves all three together. Split at the LAST separator, which is what makes a namespace-qualified head
// (`util.Bag.pop`) answer `util.Bag` rather than `util`.
function qualifyingTypeName(callee ByteArray) returns immutable ByteArray
	let separator = try MethodNameSeparatorBytes.get(0) otherwise panic("qualifyingTypeName: MethodNameSeparatorBytes is a one-byte literal")
	var headBytes = callee.count()

	for i in 0 upto callee.count() 'eachByte'
		if (try callee.get(i) otherwise panic("qualifyingTypeName: index {i} is below count {callee.count()}")) == separator 'separatorHere'
			headBytes = i
		end 'separatorHere'
	end 'eachByte'

	let out = ByteArray.create(headBytes, zeroed: false) as isolated ByteArray

	for i in 0 upto headBytes 'eachHeadByte'
		out.push(try callee.get(i) otherwise panic("qualifyingTypeName: index {i} is below count {callee.count()}"))
	end 'eachHeadByte'

	return freeze out
end 'qualifyingTypeName'

// Is the MEMBER half of a qualified callee (`Array.pop`) exactly `member`? Anchored at the separator, so
// `Bag.pop` matches and a member merely ENDING in those letters (`Array.reshapePop`) does not.
function qualifiedMemberIs(callee ByteArray, member ByteArray) returns bool
	if callee.count() <= member.count() 'noRoomForATypeAndItsSeparator'
		return false
	end 'noRoomForATypeAndItsSeparator'

	let start = callee.count() - member.count()
	let separator = try MethodNameSeparatorBytes.get(0) otherwise panic("qualifiedMemberIs: MethodNameSeparatorBytes is a one-byte literal")

	if (try callee.get(start - 1) otherwise panic("qualifiedMemberIs: index {start - 1} is in range by the guard above")) != separator 'notAtAMemberBoundary'
		return false
	end 'notAtAMemberBoundary'

	for i in 0 upto member.count() 'eachByte'
		let calleeByte = try callee.get(start + i) otherwise panic("qualifiedMemberIs: index {start + i} is below count {callee.count()}")

		if calleeByte != (try member.get(i) otherwise panic("qualifiedMemberIs: index {i} is below count {member.count()}")) 'differs'
			return false
		end 'differs'
	end 'eachByte'

	return true
end 'qualifiedMemberIs'

function qualifiedNameIs(callee ByteArray, typeName ByteArray, member ByteArray) returns bool
	if callee.count() != typeName.count() + MethodNameSeparatorBytes.count() + member.count() 'notThisLength'
		return false
	end 'notThisLength'

	return isQualifiedUnderTypeName(callee, typeName: typeName) and qualifiedMemberIs(callee, member: member)
end 'qualifiedNameIs'

// ⭐ **DOES `name` WEAR `typeName`'S QUALIFIER — i.e. is it `qualifiedMethodName(typeName, <anything>)`?**
// The join's INVERSE, and deliberately allocation-free: the parser asks it at call sites
// (`instanceSourceOfCall`, `recordSubstitutedArgRangeChecks`), so materializing a joined name
// here would allocate once per call site in every compile.
//
// ⚠ **THE SEPARATOR TEST IS LOAD-BEARING, NOT TIDINESS.** Without it this is a bare `bytesStartWith`, and
// a user function called `internNames` begins with `int` — it would be classified compiler-internal and
// so skip arity validation and signature slotting. A miscompile, from a missing byte compare.
function isQualifiedUnderTypeName(name ByteArray, typeName ByteArray) returns bool
	if name.count() <= typeName.count() 'noRoomForAMethod'
		return false
	end 'noRoomForAMethod'

	if not bytesStartWith(name, prefix: typeName) 'differentType'
		return false
	end 'differentType'

	let separator = try MethodNameSeparatorBytes.get(0) otherwise panic("isQualifiedUnderTypeName: MethodNameSeparatorBytes is a one-byte literal")
	return (try name.get(typeName.count()) otherwise panic("isQualifiedUnderTypeName: index {typeName.count()} is below count {name.count()} by the guard above, but get failed")) == separator
end 'isQualifiedUnderTypeName'

// ⭐ THE TRIVIAL DESTRUCTOR — the `destructor` argument an `__mm_alloc` passes for a box whose contents
// cascade to nothing.
//
// **NULL IS THE ANSWER, NOT A PLACEHOLDER.** A struct with scalar fields only has
// nothing to run when its box dies: there is no function to point at, and synthesizing an
// empty `__destruct_Point` to have a non-null pointer would be a function with no reason to exist.
// A Point emits `xor edx, edx`; a real `lea_func [__destruct_Outer]` is reached for only once a
// field is itself heap-allocated.
//
// It is what keeps `funcAddr`/`callIndirect` out of the trivial case: the op pair that TAKES a function's
// address and CALLS one through a register has no consumer while this is 0, and is reached with
// `__destruct_String` — a caller that is a real reason to be right, because a String that
// does not free its buffer leaks and the leak gate says so. See `MmRuntime.buildMmFree`.
//
// EXPORTED because a top-level array global's record is stamped by `ModuleInit` rather than
// by this file, and "no destructor" must be the same number in both — a second spelling of 0 is a second
// thing to get wrong on the day it stops being 0.
let TrivialDestructor = 0 as FullRangeInt

// An accessor whose whole argument list is the container names no index — `first()`, a cursor's `current()`.
let OneArgumentIsJustTheContainer = 1

// The slot `first()` reads. It names no index ARGUMENT, but it names a slot as surely as `get(0)` does, so
// a promise read through it is a nameable move rather than a refusal — see `notePromiseElementRead`.
let FirstElementIndex = 0

// The slot a promise element was read out of: the record `__managed_vacate` empties and the index into it.
type PromiseSlot
	export let container as ValueId
	export let index as ValueId

	static function create(container ValueId, index ValueId) returns Self
		return Self{container: container, index: index}
	end 'create'
end 'PromiseSlot'

// Which slot a promise element read names, if any.
union PromiseSlotResolution
	noSlot
	slot(at PromiseSlot)
end 'PromiseSlotResolution'

// E3141's cures for a promise read that names no slot: one for an element handed back alone, one for an element
// handed back inside a pair. Between them sit the cures for a promise, and for a value holding one, at a
// parameter an `async` callee only reads.
let PromiseSlotReadCure = "Read it through a door that names its slot (`get(i)`, `first()`, `for … in`, or an array's cursor), or move it out with `pop`/`remove`"
let AsyncPromiseBorrowCure = "A coroutine can still be running after the frame that started it has ended, and by then that frame has reclaimed the thread, so a coroutine that only reads this promise would read a reclaimed thread. Pass the promise to a parameter the callee takes (`await`, `.cancel()`, a store or a `return` of it), or pass the result instead"
let AsyncPromiseHolderBorrowCure = "This argument holds a promise, and a coroutine can still be running after the frame that started it has ended — by then the promise may have been awaited out of what holds it, or its thread reclaimed, and a coroutine that only reads it would read a thread that is gone. Pass the promise itself to a parameter the callee takes (`await`, `.cancel()`, a store or a `return` of it), or pass the result instead"
let PromisePairReadCure = "A pair keeps no slot for the promise it carries: destructure an array's `withIterator()` pair in the loop header (`for (it, p) in a.withIterator()`), read the array with `get(i)`, or move the promise out with `pop`/`remove`"

// `WithIterIterator.current()`'s `(Source, Element)` — the iterator, and the element it stands on.
let WithIteratorSourcePosition = 0 as FieldIndex
let WithIteratorElementPosition = 1 as FieldIndex

// The library cursor whose `current()` pairs an iterator with its element (`stdlib/helpers/itertools/withIterator.maxon`).
let WithIterIteratorTypeName = b"WithIterIterator"

// The local NAMES of one function body that must live in a cell — see
// `Parser.cellLocalNamesIn`. Keyed by name and not by binding, because it is decided from TOKENS
// before a single binding exists.
typealias CellLocalNameSet = Set with ByteArray

// ⭐ **THE TOKEN INDEX AT WHICH A CALL ARGUMENT HAS ASKED FOR A BINDING'S CELL RATHER THAN ITS CONTENTS**
// — see `Parser.cellArgumentToken`.
union CellArgumentToken
	none
	at(index ElementIndex)

	function isAt(index ElementIndex) returns bool
		return match self 'token'
			none gives false
			at(requested) gives requested == index
		end 'token'
	end 'isAt'

	function isPending() returns bool
		return match self 'token'
			none gives false
			at gives true
		end 'token'
	end 'isPending'

	function matches(site CellArgumentToken) returns bool
		return match site 'site'
			none gives false
			at(index) gives self.isAt(index)
		end 'site'
	end 'matches'

	function liesBeyond(index ElementIndex) returns bool
		return match self 'token'
			none gives false
			at(requested) gives requested > index
		end 'token'
	end 'liesBeyond'
end 'CellArgumentToken'

// The root binding a read door names for a by-reference request, recorded whenever the request matches the
// door's site, whether or not a cell is handed over, so the operand log and the lend share one root.
// `unreachable` is storage a closure cannot reach: no lend is made.
union ArgumentRoot
	none
	rooted(root VarInfo)
	unreachable

	function isNone() returns bool
		return match self 'handed'
			none gives true
			rooted or
			unreachable gives false
		end 'handed'
	end 'isNone'

	function rootOfTheLend() returns VarInfo throws AbsentError
		match self 'handed'
			rooted(root) then return root
			none or
			unreachable then throw AbsentError.absent
		end 'handed'
	end 'rootOfTheLend'
end 'ArgumentRoot'

union PlaceStorage
	notHanded
	handed(storage ValueId)
	unreachable(blame immutable ByteArray)
end 'PlaceStorage'

let noHandedPlaceStorage = PlaceStorage.notHanded

typealias ScratchCellFillMap = Map with (ValueId, ValueId)

union ScratchCellFillTable
	unwritten
	entries(fills ScratchCellFillMap)
end 'ScratchCellFillTable'

let noScratchCellFills = ScratchCellFillTable.unwritten

function withScratchCellFill(table ScratchCellFillTable, cell ValueId, value ValueId) returns ScratchCellFillTable
	match table 'state'
		unwritten then return ScratchCellFillTable.entries(singleScratchCellFill(cell, value: value))
		entries(fills) then fills.upsert(cell, value: value)
	end 'state'

	return table
end 'withScratchCellFill'

function singleScratchCellFill(cell ValueId, value ValueId) returns ScratchCellFillMap
	let fills = ScratchCellFillMap.create()
	fills.upsert(cell, value: value)
	return fills
end 'singleScratchCellFill'

// A place the compiler made for a call it synthesized is never refused for what it hands over; a written
// one carries the source position the refusal is judged at.
union PlaceSource
	compilerMade
	written(valueStart ElementIndex, position ParamCount)
end 'PlaceSource'

type PlaceArgument
	export let column as ParamCount
	export let value as ValueId
	export let storage as PlaceStorage
	export let anchor as Token
	export let source as PlaceSource

	static function create(column ParamCount, value ValueId, storage PlaceStorage, anchor Token, source PlaceSource) returns Self
		return Self{column: column, value: value, storage: storage, anchor: anchor, source: source}
	end 'create'
end 'PlaceArgument'

typealias PlaceArgumentArray = Array with PlaceArgument

union PlaceArgumentColumn
	unwritten
	entries(places PlaceArgumentArray)
end 'PlaceArgumentColumn'

function withPlaceArgument(column PlaceArgumentColumn, place PlaceArgument) returns PlaceArgumentColumn
	match column 'state'
		unwritten then return PlaceArgumentColumn.entries(singlePlaceArgument(place))
		entries(places) then places.push(place)
	end 'state'

	return column
end 'withPlaceArgument'

function singlePlaceArgument(place PlaceArgument) returns PlaceArgumentArray
	let places = PlaceArgumentArray.create(1, zeroed: false)
	places.push(place)
	return places
end 'singlePlaceArgument'

function placeArgumentsOf(column PlaceArgumentColumn) returns PlaceArgumentArray
	return match column 'state'
		unwritten gives PlaceArgumentArray.create(0)
		entries(places) gives places
	end 'state'
end 'placeArgumentsOf'

enum ArgumentPassing
	byValue
	byReference
	undecided
end 'ArgumentPassing'

function argumentPassingAt(conventions ByRefConventionArray, argIndex ParamCount, label ByteArray) returns ArgumentPassing
	var sawByValue = false
	var sawByReference = false

	for convention in conventions 'eachDeclaration'
		if convention.takesArgumentByRef(argIndex, label: label) 'byReferenceHere'
			sawByReference = true
		end 'byReferenceHere' else 'byValueHere'
			sawByValue = true
		end 'byValueHere'
	end 'eachDeclaration'

	if sawByValue and sawByReference 'theDeclarationsDisagree'
		return ArgumentPassing.undecided
	end 'theDeclarationsDisagree'

	return ArgumentPassing.byReference if sawByReference else ArgumentPassing.byValue
end 'argumentPassingAt'

type DeclarationFacts
	export let byRef as ByRefConvention
	export var consume as CalleeConsume

	static function create(byRef ByRefConvention, consume CalleeConsume) returns Self
		return Self{byRef: byRef, consume: consume}
	end 'create'
end 'DeclarationFacts'

typealias DeclarationFactsArray = Array with DeclarationFacts

function conventionsOf(declarations DeclarationFactsArray) returns ByRefConventionArray
	let conventions = ByRefConventionArray.create(declarations.count(), zeroed: false)

	for declaration in declarations 'eachDeclaration'
		conventions.push(declaration.byRef)
	end 'eachDeclaration'

	return conventions
end 'conventionsOf'

type PendingArgumentBinding
	export let column as ParamCount
	export let cell as ValueId

	static function create(column ParamCount, cell ValueId) returns Self
		return Self{column: column, cell: cell}
	end 'create'
end 'PendingArgumentBinding'

typealias PendingArgumentBindingArray = Array with PendingArgumentBinding

function tokenStartsAt(token Token, range SourceRange) returns bool
	return token.line == range.line and token.column == range.column
end 'tokenStartsAt'

union DeferredArgumentBindingColumn
	unwritten
	entries(bindings DeferredArgumentBindingArray)
end 'DeferredArgumentBindingColumn'

function withDeferredArgumentBinding(column DeferredArgumentBindingColumn, binding DeferredArgumentBinding) returns DeferredArgumentBindingColumn
	match column 'state'
		unwritten then return DeferredArgumentBindingColumn.entries(singleDeferredArgumentBinding(binding))
		entries(bindings) then bindings.push(binding)
	end 'state'

	return column
end 'withDeferredArgumentBinding'

function singleDeferredArgumentBinding(binding DeferredArgumentBinding) returns DeferredArgumentBindingArray
	let bindings = DeferredArgumentBindingArray.create(1, zeroed: false)
	bindings.push(binding)
	return bindings
end 'singleDeferredArgumentBinding'

union PendingOverlapColumn
	unwritten
	entries(overlaps PendingOverlapArray)
end 'PendingOverlapColumn'

function withPendingOverlap(column PendingOverlapColumn, overlap PendingOverlap) returns PendingOverlapColumn
	match column 'state'
		unwritten then return PendingOverlapColumn.entries(singlePendingOverlap(overlap))
		entries(overlaps) then overlaps.push(overlap)
	end 'state'

	return column
end 'withPendingOverlap'

function singlePendingOverlap(overlap PendingOverlap) returns PendingOverlapArray
	let overlaps = PendingOverlapArray.create(1, zeroed: false)
	overlaps.push(overlap)
	return overlaps
end 'singlePendingOverlap'

// ⭐ **THE NOUNS A BRACKETED LITERAL'S REFUSALS ARE COMPOSED FROM.** `[…]` spells TWO containers — an array,
// whose one column is its ELEMENT, and a map, whose two are its KEY and its VALUE — and `literalColumnTypeFor`
// serves all three, so the sentence is assembled from the construct plus the column rather than written out
// three times.
//
// ⚠⚠ **`ArrayLiteralSubject` + `ContainerElementColumnNoun` REPRODUCE A PINNED SENTENCE BYTE-FOR-BYTE** —
// `specs/character-ownership.md`'s `an-array-literal-element-is-not-a-character` quotes the composed
// message in a `maxoncstderr` block. Changing either constant rewrites a committed expectation.
//
// The three column nouns are the ones the container-column doors (`parseMapColumnValue`,
// `parseSetMemberList`, `requireListElementType`) were each spelling as their own bare `"key"` /
// `"value"` / `"element"` literal — one fact, several writings, which is what naming them here retires.
// `ContainerElementColumnNoun` serves the array LITERAL's column and a chain's declared ELEMENT alike: it is
// one word for one slot, and a second constant holding the same string is how the two would drift apart.
let ArrayLiteralSubject = "an array literal"
let ArrayLiteralElementPlace = "an element of the array literal"

let MapLiteralValuePlace = "a value of the map literal"

let TupleItemPlace = "an item of the tuple"
let ContainerElementColumnNoun = "element"
let MapLiteralSubject = "a map literal"

// The `Set from […]` member list's subject. It is a THIRD construct spelling a bracketed literal, and it
// reaches `literalColumnTypeFor` for the same one question the other two put — which `MaxonType` does this
// parsed value name? — so it takes a noun here rather than a sentence of its own.
let SetLiteralSubject = "a set literal"

// The `List from […]` member list's subject — the FOURTH construct spelling a bracketed literal, one that
// reads its own members. It pairs with
// `ContainerElementColumnNoun` above, because a list's one column is its element exactly as an array's is.
let ListLiteralSubject = "a list literal"
let HashTableKeyColumnNoun = "key"
let HashTableValueColumnNoun = "value"

// ⭐⭐ **THE NOUNS A DESTRUCTURING REFUSAL IS COMPOSED FROM — one TRIPLE PER CONSTRUCT, because TWO constructs
// spell one pattern.** `let (x, y) = t` has a binding, an initializer and a right-hand side; `for (k, v) in m`
// has none of those three — it has a loop pattern and a source ELEMENT. `requireDestructurableTuple` serves
// both, so its two sentences are ASSEMBLED from the construct rather than written out per construct — and the
// `let` spelling was hard-coded there, which described a binding to a reader who had written a `for`, on the
// very sentence a `for` header reaches first (`for (a, b) in xs` over an int array).
//
// ⚠⚠ **THE `Binding` TRIPLE REPRODUCES TWO PINNED SENTENCES BYTE-FOR-BYTE** — `specs/tuples.md`'s
// `error.destructure-of-a-non-tuple` and `error.destructure-arity-mismatch` quote the composed messages in
// `maxoncstderr` blocks. Changing any of those three constants rewrites a committed expectation.
let BindingPatternSubject = "a destructuring binding"
let BindingPatternSourceNoun = "initializer"
let BindingPatternNeedsClause = "`let (x, y) = …` needs a right-hand side that is a tuple"
let ForPatternSubject = "a destructuring `for` pattern"
let ForPatternSourceNoun = "element"
let ForPatternNeedsClause = "`for (k, v) in …` needs a source whose element is a tuple"

// The third construct spelling the pattern — a statement-level tuple ASSIGNMENT. It has no binding and no
// initializer either: what it has is a right-hand side, and targets rather than names. Only the non-tuple
// sentence is assembled from these; its arity mismatch is E3005 and worded by the spec (see
// `requireTupleLayout`).
let AssignPatternSubject = "a tuple assignment"
let AssignPatternSourceNoun = "right-hand side"
let AssignPatternNeedsClause = "`(x, y) = …` needs a right-hand side that is a tuple"

// ⭐ **ONE `, e` STEP OF AN ARRAY LITERAL — the parsed element and where its FIRST TOKEN was.** The pair
// travels together because its two consumers each need both and for the same reason: the value is what gets
// pushed (or collected), and the start index is what `moveElementIntoContainer` reads to decide whether the
// element was a bare local to poison. Returned as one value rather than left at the two call sites, so the
// element rule has ONE home — see `parseArrayLiteralTailElement`.
type ArrayLiteralElement
	export var value as ValueId
	export let start as ElementIndex

	static function create(value ValueId, start ElementIndex) returns ArrayLiteralElement
		return Self{value: value, start: start}
	end 'create'
end 'ArrayLiteralElement'

union ElementFit
	opaque
	checked(payload PayloadClass)
end 'ElementFit'

type ElementSlot
	export let indexSpaceType as MaxonType
	export let declared as MaxonType
	export let declaredKeepingAlias as MaxonType
	export let alias as DeclaredAlias
	export let fit as ElementFit

	static function create(indexSpaceType MaxonType, declared MaxonType, declaredKeepingAlias MaxonType, alias DeclaredAlias, fit ElementFit) returns ElementSlot
		return Self{indexSpaceType: indexSpaceType, declared: declared, declaredKeepingAlias: declaredKeepingAlias, alias: alias, fit: fit}
	end 'create'
end 'ElementSlot'

union ElementLiteralTargets
	none
	typed(adopted MaxonType, arrayTarget DeclaredArrayInstance, tupleTarget DeclaredTupleTarget)
end 'ElementLiteralTargets'

union DirectoryFunction
	declared(callee immutable ByteArray)
	notADirectoryFunction
end 'DirectoryFunction'

enum ArrayStaticKind
	builtinCreate
	builtinInit
	corpus
	none
end 'ArrayStaticKind'

union ImageNote
	construction(layout StructLayout, fields ValueIdArray)
	call(callee immutable ByteArray, args ValueIdArray, labels NameRoster)
	unionCase(typeName immutable ByteArray, caseName immutable ByteArray)
	emptyContainer
	inlineWord(payload FullRangeInt, typeName immutable ByteArray)
end 'ImageNote'

typealias ImageNoteMap = Map with (ValueId, ImageNote)

// The result of resolving a `<sized>.min` / `<sized>.max` bound. A union, so the
// caller can tell the two REJECTIONS apart and name the actual gap in its diagnostic
// (a float bound is a missing FEATURE; an unknown name is a typo).
union SizedTypeBound
	value(bound FullRangeInt)

	// `f32` / `f64` — the bound is a FLOAT extreme, carried as the IEEE-754 f64 bit pattern
	// `FullRangeInt` holds (a float alias resolves to `MaxonType.float` = f64). Legal only inside a
	// `float(...)` typealias; the int-alias and expression callers reject it (`floatBoundInFloatAlias`).
	floatBound(bits FullRangeInt)
	notASizedType
end 'SizedTypeBound'

// The bound `<typeName>.<min|max>` denotes, for the eight sized INTEGER types plus `f32`/`f64`
// (whose bounds ride as f64 bit patterns — see `floatBound`). Shared by the range-declaration
// parser (`typealias Port = int(0 to u16.max)`, `typealias Pct = float(f64.min to f64.max)`) and
// the expression parser (`let x = u16.max`), which are the same three tokens in two positions — so
// they resolve through one table rather than two that can disagree. Whether a float bound is LEGAL
// in a given position is the caller's decision, not this table's: it only says what the tokens name.
function sizedTypeBound(typeName ByteArray, wantMax bool) returns SizedTypeBound
	if typeName.equals(b"u8") 'u8'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U8MaxBound, wantMax: wantMax))
	end 'u8'

	if typeName.equals(b"u16") 'u16'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U16MaxBound, wantMax: wantMax))
	end 'u16'

	if typeName.equals(b"u32") 'u32'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U32MaxBound, wantMax: wantMax))
	end 'u32'

	if typeName.equals(b"u64") 'u64'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: UnsignedFullUpperPattern, wantMax: wantMax))
	end 'u64'

	if typeName.equals(b"i8") 'i8'
		return SizedTypeBound.value(pickBound(I8MinBound, high: I8MaxBound, wantMax: wantMax))
	end 'i8'

	if typeName.equals(b"i16") 'i16'
		return SizedTypeBound.value(pickBound(I16MinBound, high: I16MaxBound, wantMax: wantMax))
	end 'i16'

	if typeName.equals(b"i32") 'i32'
		return SizedTypeBound.value(pickBound(I32MinBound, high: I32MaxBound, wantMax: wantMax))
	end 'i32'

	if typeName.equals(b"i64") 'i64'
		return SizedTypeBound.value(pickBound(I64MinBound, high: I64MaxBound, wantMax: wantMax))
	end 'i64'

	if typeName.equals(b"f32") 'f32'
		return SizedTypeBound.floatBound(pickBound(F32MinBound, high: F32MaxBound, wantMax: wantMax))
	end 'f32'

	if typeName.equals(b"f64") 'f64'
		return SizedTypeBound.floatBound(pickBound(F64MinBound, high: F64MaxBound, wantMax: wantMax))
	end 'f64'

	return SizedTypeBound.notASizedType
end 'sizedTypeBound'

function pickBound(low FullRangeInt, high FullRangeInt, wantMax bool) returns FullRangeInt
	if wantMax 'max'
		return high
	end 'max'

	return low
end 'pickBound'

// Is `name` one of the ten SIZED type names? Derived from `sizedTypeBound` — the one table that says
// what those names are — rather than from a second list beside it, so a name cannot be sized enough to
// have a bound and not sized enough to be refused as a bare alias RHS. `wantMax` is immaterial: a name
// either has both extremes or neither.
//
// ⚠ It answers TRUE for `f32`/`f64` as well as the eight integers: `typealias Real = f64` is E2003.
// The narrower eight-integer roster is not what the corpus pins.
function isSizedTypeName(name ByteArray) returns bool
	return match sizedTypeBound(name, wantMax: true) 'kind'
		value or
		floatBound gives true
		notASizedType gives false
	end 'kind'
end 'isSizedTypeName'

function namesASizedBound(typeName ByteArray, member ByteArray) returns bool
	return isSizedTypeName(typeName) and (member.equals(MinBoundField) or member.equals(MaxBoundField))
end 'namesASizedBound'

function builtinArrayStaticKind(member ByteArray) returns ArrayStaticKind
	if member.equals(CreateMethod) 'create'
		return ArrayStaticKind.builtinCreate
	end 'create'

	if member.equals(InitMethod) 'init'
		return ArrayStaticKind.builtinInit
	end 'init'

	return ArrayStaticKind.none
end 'builtinArrayStaticKind'

// The one roster of the handle surfaces' statics. Admission (`surfaceStaticOf`), the refusal's list and
// count word, and the dispatch (`emitCompilerOwnedStatic`) all read it, so the three cannot disagree.
enum CompilerOwnedStatic
	fileOpenRead
	fileOpenWrite
	fileOpenWriteExecutable
	fileOpenCreateNew
	fileExists
	fileDelete
	fileRename
	fileStat
	fileStatField
	fileStatFree
	directoryOpenSearch
	directoryExists
	directoryCreate
	directoryDelete
	directoryCurrentPath
	directoryResolve
	socketTcpConnect
	socketBindListener
	pagesReserve
	handleTimer
	handleAdopting
	pinAcquire
	memoryCreate
	memoryFromCString
end 'CompilerOwnedStatic'

union CompilerOwnedStaticLookup
	found(kind CompilerOwnedStatic)
	notAStatic
end 'CompilerOwnedStaticLookup'

typealias CompilerOwnedStaticArray = Array with CompilerOwnedStatic

let CountWords = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]

function compilerOwnedStaticSpelling(kind CompilerOwnedStatic) returns immutable ByteArray
	return match kind 'kind'
		fileOpenRead gives ManagedFileOpenReadMethod
		fileOpenWrite gives ManagedFileOpenWriteMethod
		fileOpenWriteExecutable gives ManagedFileOpenWriteExecutableMethod
		fileOpenCreateNew gives ManagedFileOpenCreateNewMethod
		fileExists gives ManagedFileExistsMethod
		fileDelete gives ManagedFileDeleteMethod
		fileRename gives ManagedFileRenameMethod
		fileStat gives ManagedFileStatMethod
		fileStatField gives ManagedFileStatFieldMethod
		fileStatFree gives ManagedFileStatFreeMethod
		directoryOpenSearch gives ManagedDirectoryOpenSearchMethod
		directoryExists gives ManagedDirectoryExistsMethod
		directoryCreate gives ManagedDirectoryCreateMethod
		directoryDelete gives ManagedDirectoryDeleteMethod
		directoryCurrentPath gives ManagedDirectoryCurrentPathMethod
		directoryResolve gives ManagedDirectoryResolveMethod
		socketTcpConnect gives ManagedSocketTcpConnectMethod
		socketBindListener gives ManagedSocketBindListenerMethod
		pagesReserve gives ManagedPagesReserveMethod
		handleTimer gives ManagedHandleTimerMethod
		handleAdopting gives ManagedHandleAdoptMethod
		pinAcquire gives ManagedPinAcquireMethod
		memoryCreate gives ManagedMemoryCreateMethod
		memoryFromCString gives ManagedMemoryFromCStringMethod
	end 'kind'
end 'compilerOwnedStaticSpelling'

function compilerOwnedStaticsOf(surface HandleSurface) returns CompilerOwnedStaticArray
	return match surface 'surface'
		file gives [CompilerOwnedStatic.fileOpenRead, CompilerOwnedStatic.fileOpenWrite, CompilerOwnedStatic.fileOpenWriteExecutable, CompilerOwnedStatic.fileOpenCreateNew, CompilerOwnedStatic.fileExists, CompilerOwnedStatic.fileDelete, CompilerOwnedStatic.fileRename, CompilerOwnedStatic.fileStat, CompilerOwnedStatic.fileStatField, CompilerOwnedStatic.fileStatFree]
		directory gives [CompilerOwnedStatic.directoryOpenSearch, CompilerOwnedStatic.directoryExists, CompilerOwnedStatic.directoryCreate, CompilerOwnedStatic.directoryDelete, CompilerOwnedStatic.directoryCurrentPath, CompilerOwnedStatic.directoryResolve]
		socket gives [CompilerOwnedStatic.socketTcpConnect, CompilerOwnedStatic.socketBindListener]
		pages gives [CompilerOwnedStatic.pagesReserve]
		osHandle gives [CompilerOwnedStatic.handleTimer, CompilerOwnedStatic.handleAdopting]
		pin gives [CompilerOwnedStatic.pinAcquire]
		memory gives [CompilerOwnedStatic.memoryCreate, CompilerOwnedStatic.memoryFromCString]
	end 'surface'
end 'compilerOwnedStaticsOf'

function compilerOwnedSurfaceTypeName(surface HandleSurface) returns immutable ByteArray
	return match surface 'surface'
		file gives ManagedFileTypeName
		directory gives ManagedDirectoryTypeName
		socket gives ManagedSocketTypeName
		pages gives ManagedPagesTypeName
		osHandle gives ManagedHandleTypeName
		pin gives ManagedPinTypeName
		memory gives ManagedMemoryTypeName
	end 'surface'
end 'compilerOwnedSurfaceTypeName'

function compilerOwnedStaticNamed(surface HandleSurface, member ByteArray) returns CompilerOwnedStaticLookup
	for kind in compilerOwnedStaticsOf(surface) 'eachStatic'
		if member.equals(compilerOwnedStaticSpelling(kind)) 'named'
			return CompilerOwnedStaticLookup.found(kind)
		end 'named'
	end 'eachStatic'

	return CompilerOwnedStaticLookup.notAStatic
end 'compilerOwnedStaticNamed'

function compilerOwnedStaticRoster(surface HandleSurface) returns String
	let statics = compilerOwnedStaticsOf(surface)
	var list = ""

	for i in 0 upto statics.count() 'eachStatic'
		let item = "`{String.from(compilerOwnedStaticSpelling(try statics.get(i) otherwise panic("compilerOwnedStaticRoster: statics.get OOB at {i} below count {statics.count()}")))}`"

		if i == 0 'first'
			list = item.clone()
		end 'first' else if i + 1 == statics.count() 'last'
			list = "{list} and {item}"
		end 'last' else 'middle'
			list = "{list}, {item}"
		end 'middle'
	end 'eachStatic'

	let word = try CountWords.get(statics.count()) otherwise "{statics.count()}"
	let lead = "exactly {word}" if statics.count() == 1 else "exactly these {word}"

	return "the type has {lead}: {list}"
end 'compilerOwnedStaticRoster'

// ⭐ **ONE ENDPOINT OF A DECLARED RANGE, WITH THE PROVENANCE THE DECLARATION CHECK NEEDS.**
//
// The VALUE alone cannot answer the two questions `requireRepresentableRange` asks, and the reason
// is that a bound's value is lossy about where it came from: a bound above `i64.max` is stored as
// its wrapped negative pattern — `u64.max` as **-1** — (`RangedTypeAlias` keeps raw 64-bit
// patterns), so `int(-1 to u64.max)` and `int(-1 to -1)` are the same pair of numbers and only one
// of them is a mistake. What the source wrote is what tells them apart.
//
// It exists ONLY between `parseRangeBound` and that check — `RangedTypeAlias` still stores two plain
// numbers, because nothing downstream of the declaration has any use for how the author spelled a
// bound, and a field there would be paid for by every alias in the program.
//
// A `(value, qualifier)` pair, `literal` for a plain literal, is the shape of the problem. `isMax`
// is carried alongside so the diagnostic can print the field the SOURCE named rather than assuming
// `.min` on the low end and `.max` on the high (see `mismatchedRangeBoundTypes`).
type ParsedRangeBound
	export let value as FullRangeInt

	// The sized type a `<sized>.<min|max>` bound named, or `literal` for a plain literal. A literal
	// names no type, so it is compatible with any qualifier — which is why `literal` is the whole test
	// the mismatch check makes before comparing.
	export let qualifier as BoundQualifier
	export let isMax as bool

	// ⭐ **IS THE BOUND AS WRITTEN ABOVE `i64.max`** — `u64.max`, or a plain literal past the signed
	// top — and so stored as a negative pattern no signed lower bound can share a range with?
	//
	// ⚠ **DECIDED AT CONSTRUCTION, AND THAT IS THE WHOLE REASON IT IS A FIELD.** `upto` normalizes the
	// bound to an inclusive `high - 1` (`withValue`), so after normalization the record holds a value
	// the author never wrote; a test derived from the value at READ time answers about that number,
	// and would accept `int(-1 upto u64.max)` as a range no value can satisfy while refusing
	// `int(-1 to u64.max)`.
	//
	// For a qualified bound it is derived from the VALUE rather than by comparing the qualifier
	// against a second `b"u64"` written here: `sizedTypeBound` is where the ten names live, and
	// `u64.max` is the only `.max` in that table above `i64.max`. The `isMax` half is load-bearing too
	// — `u64.min` is 0 and pairs with a negative lower perfectly well (`int(-1 to u64.min)` is
	// `int(-1 to 0)`). Testing only the qualifier REFUSES that legal range, with a message quoting a
	// `u64.max` the source never wrote.
	export let exceedsSignedMax as bool

	static function literal(bound FullRangeInt, exceedsSignedMax bool) returns ParsedRangeBound
		return Self{value: bound, qualifier: BoundQualifier.literal, isMax: false, exceedsSignedMax: exceedsSignedMax}
	end 'literal'

	static function qualified(bound FullRangeInt, qualifier ByteArray, isMax bool) returns ParsedRangeBound
		return Self{value: bound, qualifier: BoundQualifier.typed(qualifier), isMax: isMax, exceedsSignedMax: isMax and bound == UnsignedFullUpperPattern}
	end 'qualified'

	// The same bound with a different VALUE — `upto`'s normalization to an inclusive `high - 1`. The
	// qualifier and `isMax` ride through unaltered: they describe what the source WROTE.
	// `aboveSignedMax` is the caller's, because `upto 9223372036854775808` normalizes to `i64.max`,
	// which is not above it.
	function withValue(bound FullRangeInt, aboveSignedMax bool) returns ParsedRangeBound
		return Self{value: bound, qualifier: self.qualifier.clone(), isMax: self.isMax, exceedsSignedMax: aboveSignedMax}
	end 'withValue'

	function writtenText() returns String
		if let typeName = try self.qualifier.typeName() 'aTypedBound'
			return self.spellingUnder(typeName)
		end 'aTypedBound'

		return unsignedScalarText(self.value)
	end 'writtenText'

	// How the bound was WRITTEN — `i8.min`, `u64.max` — for the mismatch diagnostic. Only ever asked of
	// a qualified bound (the check that asks has already established both ends carry a qualifier).
	function spellingUnder(typeName ByteArray) returns String
		let field = MaxBoundField if self.isMax else MinBoundField
		return "{String.from(typeName)}.{String.from(field)}"
	end 'spellingUnder'
end 'ParsedRangeBound'

// The empty qualifier a LITERAL bound carries. Named rather than spelled `b""` at its construction
// sites, and shared, so the "no type was named" marker is one object rather than one per bound parsed.
union BoundQualifier
	literal
	typed(typeName immutable ByteArray)

	function typeName() returns immutable ByteArray throws AbsentError
		match self 'qualifier'
			literal then throw AbsentError.absent
			typed(typeName) then return typeName
		end 'qualifier'
	end 'typeName'
end 'BoundQualifier'

// The bits of an `f32`/`f64` `.min`/`.max` bound, but ONLY where a float bound is legal — inside a
// `float(...)` typealias (`isFloat`). In an int alias (`int(0 to f64.max)`) or in expression position
// (`let x = f64.max`) there is no integer value that carries an f64 bit pattern, so it is a positioned
// error rather than a silently reinterpreted number — the same rejection the old `floatBound` arm
// made, now that a float alias is the ONE place the bound belongs. A free function because the match
// arm that needs it cannot host the labelled `if`.
function floatBoundInFloatAlias(bits FullRangeInt, isFloat bool, typeTok Token, fieldTok Token) returns FullRangeInt throws SourceParseError
	if not isFloat 'notFloatAlias'
		throw SourceParseError.unsupported("the float bound '{String.from(typeTok.value)}.{String.from(fieldTok.value)}' outside a `float(...)` typealias — only a float range can carry an f64 bound", line: typeTok.line, column: typeTok.column)
	end 'notFloatAlias'

	return bits
end 'floatBoundInFloatAlias'

// --- Pratt expression parser: precedence table + operator classifiers ---
//
// Expressions parse with a precedence climber (`Parser.parseBinary`).
// Binary precedence levels — HIGHER binds tighter. Left-associativity falls out of
// recursing the right operand at `precedence + 1`. Unary `-` and `not` are NOT in this
// table — they are prefix operators handled by `parseUnary` (the leaf of the climber), so
// they bind tighter than every binary operator here.
//
// The LADDER, loosest to tightest:
//
//     or  <  xor  <  and  <  comparison  <  shl/shr  <  + -  <  * / mod
//
// Every one of those relationships is pinned by a spec case, and they are not obvious:
// `12 and 10 or 1` is 9 (`and` binds tighter than `or`), `12 and 10 xor 3` is 11, and
// `1 shl 3 > 5` is `(1 shl 3) > 5` — a shift binds TIGHTER than a comparison, unlike C,
// where it is the reverse (specs/bitwise-operators.md).
typealias InfixPrecedence = int(1 to 100)

// A sentinel-free "not a binary operator": a real level is >= OrPrecedence, so
// `infixPrecedence` returning this makes the climber's loop stop (the expression ends).
// It is a meaningful classification result, not an error sentinel.
enum InfixPrecedenceError implements Error
	notAnInfixOperator
end 'InfixPrecedenceError'

// The three WORD operators, loosest first. Each is CONTEXT-DEPENDENT — bitwise on
// integers, logical on bools — and `and`/`or` are additionally SHORT-CIRCUIT when their
// left operand is a bool, which makes them control flow rather than ops (see
// Parser.emitShortCircuit). Their precedence does not depend on which reading applies.
let OrPrecedence = 1
let XorPrecedence = 2
let AndPrecedence = 3

// Comparison `==`/`!=`/`<`/`>`/`<=`/`>=`. Binds tighter than the word operators, so
// `a > 0 and b > 0` groups as `(a > 0) and (b > 0)` — the reading that makes a
// short-circuit `and` mean anything at all.
//
// ⭐ **AND REFERENCE IDENTITY `is` / `is not` SHARES THIS LEVEL** (`specs/reference-identity.md`). It is
// the level the operator's RESULT wants: `is` yields a bool, so it must bind tighter than `and`/`or`/`xor`
// for `a is b and c is d` to group as `(a is b) and (c is d)`, and it has no reading at all against an
// operand a `+` or a `*` could produce. It is NOT a `comparisonOperator`, though — see `identityOperator`.
let ComparisonPrecedence = 4

// Shift `shl`/`shr`. Binds TIGHTER than comparison (`1 shl 3 > 5` is `(1 shl 3) > 5`)
// and LOOSER than additive (`a shl 1 + 2` is `a shl (1 + 2)`).
let ShiftPrecedence = 5

// Additive `+`/`-`.
let AdditivePrecedence = 6

// Multiplicative `*`/`/`/`mod` — the tightest binary level, so `10 + 5 * 2` groups as
// `10 + (5 * 2)` = 20.
let MultiplicativePrecedence = 7

// The precedence of a binary-operator token. It throws `notAnInfixOperator` for any token
// that does not begin a binary operation in the grammar.
function infixPrecedence(kind TokenKind) returns InfixPrecedence throws InfixPrecedenceError
	if kind == TokenKind.or 'or'
		return OrPrecedence
	end 'or'

	if kind == TokenKind.xor 'xor'
		return XorPrecedence
	end 'xor'

	if kind == TokenKind.and 'and'
		return AndPrecedence
	end 'and'

	if comparisonOperator(kind) or identityOperator(kind) 'comparison'
		return ComparisonPrecedence
	end 'comparison'

	if kind == TokenKind.shl or kind == TokenKind.shr 'shift'
		return ShiftPrecedence
	end 'shift'

	if kind == TokenKind.plus or kind == TokenKind.minus 'additive'
		return AdditivePrecedence
	end 'additive'

	if kind == TokenKind.star or kind == TokenKind.slash or kind == TokenKind.mod 'multiplicative'
		return MultiplicativePrecedence
	end 'multiplicative'

	throw InfixPrecedenceError.notAnInfixOperator
end 'infixPrecedence'

// The Maxon binary operator a supported infix token maps to. Only called for tokens
// `infixPrecedence` classified as operators and NOT
// consumed by a more specific path first (a comparison goes to `infixCmpOp`; a bool
// `and`/`or` never reaches an op at all — it is short-circuit control flow). Anything
// else is a climber bug, so it panics rather than guessing an operator.
//
// `and`/`or`/`xor` map to the BIT ops here because that is the only reading left by the
// time this is called: the parser has already established that the operands are not
// bools (see `parseBinary`), and on integers the word operators ARE the bit operators.
function infixMaxonOp(kind TokenKind) returns MaxonBinOp
	if kind == TokenKind.plus 'add'
		return MaxonBinOp.add
	end 'add'

	if kind == TokenKind.minus 'sub'
		return MaxonBinOp.sub
	end 'sub'

	if kind == TokenKind.star 'mul'
		return MaxonBinOp.mul
	end 'mul'

	if kind == TokenKind.slash 'div'
		return MaxonBinOp.div
	end 'div'

	if kind == TokenKind.mod 'mod'
		return MaxonBinOp.mod
	end 'mod'

	if kind == TokenKind.and 'bitAnd'
		return MaxonBinOp.bitAnd
	end 'bitAnd'

	if kind == TokenKind.or 'bitOr'
		return MaxonBinOp.bitOr
	end 'bitOr'

	if kind == TokenKind.xor 'bitXor'
		return MaxonBinOp.bitXor
	end 'bitXor'

	if kind == TokenKind.shl 'shl'
		return MaxonBinOp.shl
	end 'shl'

	if kind == TokenKind.shr 'shr'
		return MaxonBinOp.shr
	end 'shr'

	panic("infixMaxonOp: token '{kind.rawValue}' is not a supported binary operator — infixPrecedence must gate this call")
end 'infixMaxonOp'

// The two operators that SHORT-CIRCUIT when their operands are bools: `and` (skips the
// right operand when the left is false) and `or` (skips it when the left is true). `xor`
// is deliberately absent — no value of one operand makes the other redundant, so there is
// nothing to skip, and on the 0/1 bool domain the bitwise xor already IS the logical one.
function shortCircuitOperator(kind TokenKind) returns bool
	return kind == TokenKind.and or kind == TokenKind.or
end 'shortCircuitOperator'

// ⭐ **WHAT A DEFERRED FIELD'S SLOT OPENS HOLDING — or that the field owns heap and gets no slot.** The
// placeholder is a value on the paths that do not assign, so it must be one the scope exit can leave alone:
// every trivial scalar is, and nothing else is. A `named` field is a ranged INT alias and its placeholder is
// the plain integer the alias is one of — the same join a `var i = 0` and a later `as Round` value make.
union NascentSlotPlaceholder
	value(valueType MaxonType)
	ownsHeap
end 'NascentSlotPlaceholder'

function nascentSlotPlaceholderType(tag ValueTypeTag) returns NascentSlotPlaceholder
	return match tag 'kind'
		boolean gives NascentSlotPlaceholder.value(MaxonType.boolean)
		float gives NascentSlotPlaceholder.value(MaxonType.float)
		integer or
		named or
		exitCode gives NascentSlotPlaceholder.value(MaxonType.integer)
		structRef or
		string or
		function or
		typeParameter or
		genericInstance or
		character or
		interfaceRef or
		unresolved or
		void gives NascentSlotPlaceholder.ownsHeap

		// A `cstring` owns nothing — it is a borrowed address — so a null placeholder is a value the scope
		// exit leaves alone, exactly as a zero int is.
		cstring gives NascentSlotPlaceholder.value(MaxonType.cstring)
	end 'kind'
end 'nascentSlotPlaceholderType'

// ⭐ **THE TYPE `fromRawValue` TAKES, PER BACKING.** The argument is the raw value the author wrote, so its
// domain is the declaration's — and the diagnostic that refuses a wrong one names this rather than a fixed
// `int`. A `functionRef` backing never reaches here: `requireFromRawValueBacking` refuses it first.
function enumRawValueArgumentTag(backing EnumBacking) returns ValueTypeTag
	return match backing 'b'
		integer or
		unresolved gives ValueTypeTag.integer
		float gives ValueTypeTag.float
		character gives ValueTypeTag.character
		string gives ValueTypeTag.string
		functionRef gives ValueTypeTag.function
		structRecord gives ValueTypeTag.structRef
	end 'b'
end 'enumRawValueArgumentTag'

// Does an enum's declared backing produce values of `tag`? Only the two BYTE-RECORD backings answer true,
// and that is the whole of the question `enumCaseAtItsBacking` asks: an `integer` backing needs no coercion
// (the tag IS the raw value), and the rest name domains a comparison never reaches with a byte record on
// the other side.
function enumBackingProduces(backing EnumBacking, tag ValueTypeTag) returns bool
	return match backing 'b'
		character gives tag == ValueTypeTag.character
		string gives tag == ValueTypeTag.string
		unresolved or
		integer or
		float or
		functionRef or
		structRecord gives false
	end 'b'
end 'enumBackingProduces'

// ⭐ **THE `MaxonType` A FOLDED CONSTANT'S TAG DENOTES.** It takes an ID rather than the bytes the
// constant carries because interning is the CALLER's: there is one table per Parser and one on
// `ProgramSignatures`, and which one a type belongs to is a fact only the caller has.
// `constantValueTypeIn` below is the one door that does that interning, and it names the table in
// its signature so no caller can mint into a table its reader cannot read.
function constantValueType(tag ValueTypeTag, typeNameId TypeNameId) returns MaxonType
	if tag == ValueTypeTag.named 'anEnumCase'
		return MaxonType.named(typeNameId)
	end 'anEnumCase'

	if tagNamesADeclaredType(tag) 'anInlinePackedWord'
		return MaxonType.structRef(typeNameId)
	end 'anInlinePackedWord'

	if tag == ValueTypeTag.boolean 'bool'
		return MaxonType.boolean
	end 'bool'

	if tag == ValueTypeTag.integer 'int'
		return MaxonType.integer
	end 'int'

	if tag == ValueTypeTag.exitCode 'exitCode'
		return MaxonType.exitCode
	end 'exitCode'

	if tag == ValueTypeTag.float 'float'
		return MaxonType.float
	end 'float'

	panic("constantValueType: a top-level constant is tagged '{typeTagName(tag)}' — only booleans, integers, exit codes, floats, enum cases and inline records are ever folded")
end 'constantValueType'

// ⭐ **THE `MaxonType` A FOLDED CONSTANT DENOTES, MINTED IN THE TABLE `into` NAMES.** A folded enum
// or union case carries its type's BYTES rather than an id precisely so that the party holding the
// reader can choose the table — a `named` id minted in `ProgramSignatures`' table is meaningless in
// a file's parse and panics the first door that resolves it (`slotStorageType`, `foreignNameOf`).
// Only a constant that carries a name — a `named` enum case, an inline packed record's `structRef`,
// or a number cast to an alias — interns anything, so every other constant read pays nothing, which
// matters because this is on the path of every top-level constant reference in the program.
function constantValueTypeIn(tag ValueTypeTag, typeName ByteArray, into TypeNameInterner) returns MaxonType
	if (tag == ValueTypeTag.integer or tag == ValueTypeTag.float) and not typeName.isEmpty() 'anAliasValue'
		return MaxonType.named(into.intern(typeName))
	end 'anAliasValue'

	if tag != ValueTypeTag.named and not tagNamesADeclaredType(tag) 'namesNoType'
		return constantValueType(tag, typeNameId: 0)
	end 'namesNoType'

	return constantValueType(tag, typeNameId: into.intern(typeName))
end 'constantValueTypeIn'

// The VALUE half of a declared return type, for a callee the caller already knows produces one. A `void`
// here is a routing bug — a member routed to a runtime call for its RESULT was declared to return nothing —
// so it panics rather than inventing a width.
function requireDeclaredResultValue(ref MaxonReturnType, typeName ByteArray, methodName ByteArray) returns MaxonType
	return try valueTypeOfReturn(ref) otherwise panic("requireDeclaredResultValue: `{String.from(typeName)}.{String.from(methodName)}` is declared to return nothing, but its dispatch uses the call for a value")
end 'requireDeclaredResultValue'

// The interned-NAME id of a function's declared return type, for a function KNOWN to return a value —
// the id half of `maxonReturnTypeTag` (MaxonDialect), read where the aggregate-identity check needs a
// return type's NAME and a scalar tag carries none. Void is a caller bug: every caller is gated on
// `maxonReturnTypeIsVoid`, and a void `return <expr>` is its own diagnostic.
function maxonReturnTypeNameId(ref MaxonReturnType) returns TypeNameId
	let inner = try valueTypeOfReturn(ref) otherwise panic("maxonReturnTypeNameId: a void return type has no value — the caller must gate on maxonReturnTypeIsVoid first")
	return typeNameIdOf(inner)
end 'maxonReturnTypeNameId'

// The comparison operators. Each maps to a `MaxonOp.compare`. Classifier shared by
// the precedence table (`infixPrecedence`) and the climber's op-dispatch (`parseBinary`).
function comparisonOperator(kind TokenKind) returns bool
	return kind == TokenKind.equalsEquals or kind == TokenKind.bangEquals or kind == TokenKind.lessThan or kind == TokenKind.lessEquals or kind == TokenKind.greaterThan or kind == TokenKind.greaterEquals
end 'comparisonOperator'

// ⭐⭐ **REFERENCE IDENTITY `is` — AND WHY IT IS ITS OWN CLASSIFIER RATHER THAN A SEVENTH
// `comparisonOperator`** (`specs/reference-identity.md`). The two share a PRECEDENCE and nothing else:
// `comparisonOperator`'s six tokens each map to a `MaxonCmpOp` through `infixCmpOp` and are then handed to
// `emitCompare`, which for a struct pair dispatches the type's own `equals` — the exact CONTENTS answer
// `is` exists to be the opposite of. Widening that predicate would therefore not add an operator; it would
// silently make `a is b` mean `a == b`.
//
// ⚠ **`is not` IS TWO TOKENS, AND ONLY THIS TOKEN IS CLASSIFIED.** The climber fuses the `not` into the
// operator itself (see `parseBinary`), which it may do without ambiguity because the alternative reading —
// `a is (not b)` — cannot exist: `not` yields a bool, and a bool has no object identity, so every program
// that parses one way is refused under the other.
//
// ⚠ **IT DOES NOT COLLIDE WITH THE `where <T> is <Interface>` CLAUSE**, and that is structural rather than
// lucky: a `where` clause is read by `readWhereClause`, a dedicated recursive descent over
// `<identifier> is <identifier>` that the expression grammar is never entered from. The clause sits in a
// declaration HEAD, which has no operand for an infix operator to follow.
function identityOperator(kind TokenKind) returns bool
	return kind == TokenKind.is
end 'identityOperator'

// The `name:` label regimes a call site can be parsed under, read only by `consumeArgLabel`. One
// enum rather than booleans, so no combination of flags can mean nothing; an `enum` rather than a
// `union` because a payload-free union case still heap-allocates, once per parsed argument.
enum ArgLabelRule
	// A list whose parameters declare no defaults — an enum payload, a UCD load,
	// `__DebugStream.nameId`: the first argument is positional (a label there is E2052) and every
	// later one must be labelled (a bare value there is E2053).
	ordinary

	// A witness dispatch through an interface / type-parameter receiver, where the first argument may
	// also carry a label: the concrete receiver whose declaration would forbid it is what the shared
	// body does not know. Later arguments follow `ordinary`.
	firstMayBeNamed

	// A callee with no declaration — a bare compiler builtin or a `__Builtins.` intrinsic — whose
	// arguments are all positional and none of which may be labelled (E2067): there are no parameter
	// names for a label to name. See `argLabelRuleForCallee`, which decides the families.
	allPositional

	// A member called on an undeclared call's result. It may be an ordinary method, a witness dispatch
	// or a builtin-style member with positional later arguments, so no label and no absence of one is
	// refused; E3004 at the call rejects the program.
	unknownMember

	// A message call through a service handle: `firstNamedIfDefaulted`, judged at the message's first
	// parameter after `self`, except that the reserved `sendTimeout:` may label the first argument
	// whatever the defaults. `parseCallArgs` takes it off the argument list, so it never reaches the
	// request, and refuses an argument after it (E3192).
	messageSend

	// Every other call to a declared callee: the first argument may be labelled only when the callee's
	// first parameter after any receiver has a default (E2052 otherwise), and every later one must be
	// labelled (E2053). `consumeArgLabel` accepts the first label; `requireFirstArgLabelHasDefault`
	// judges it once the list is parsed.
	firstNamedIfDefaulted
end 'ArgLabelRule'

// **THE `trunc` BUILTIN'S NAME**, and the whole of what makes it one. A `b""` literal, matched
// against the callee token's bytes — the same shape `TypeResolution`'s `ExitCodeBuiltinName` and
// `SemanticCheck`'s `MainFunctionName` use for the same job, which is the compiler recognizing one
// of its own names in user source.
let TruncBuiltinName = b"trunc"

// Every ARITY-1 NUMERIC builtin — `trunc` and the five arity-1 math intrinsics — takes exactly one
// argument. ONE constant, because `numericBuiltinOperand` is the one function that states it (as both
// the check and the message's `expected`), and a bare `1` there would be a magic value in the more
// literal sense: the number that says what these builtins ARE. (`print`/`__Builtins.sleep`/`__Builtins.runProcess`
// keep their own, because each has its own emit and its own operand rule.)
let NumericBuiltinArity = 1

// The ARITY-2 twin, for `min` (`specs/min.md`) — a second constant rather than a second literal, for
// the identical reason. `requireBuiltinArity` states both, so the two arities differ by their
// argument and by nothing else.
let BinaryNumericBuiltinArity = 2

// **THE `String` BUILTIN TYPE'S NAME IS `StringConformerName`**. Recognized SYNTACTICALLY in
// `parseTypeReference` — like `Self`, a pure token test with no registry — so `function f(s String)` tags
// `s`'s value `string` at PARSE time, which is what `s == t` / `print(s)` read. Recognizing it here (not only
// in `TypeResolution`, the way `ExitCode` is) is load-bearing: `resolveTypes` rewrites SIGNATURES, never the
// parser's `valueTags` column, so a String tagged `named` at parse time would stay `named` on the value and
// the String operators would never see it.

// ⭐ **THERE IS NO BARE-NAME `print` BUILTIN, AND ITS ABSENCE IS THE POINT.** Recognizing `print`
// here by name, the way `trunc` is, and routing it to a `__print_string` runtime entry would take
// it out of ordinary function resolution; every `print(...)` resolves to `stdlib/Print.maxon`
// instead.
//
// It also made `stdlib/Print.maxon` UNLISTABLE, by this file's own rule
// (`StdlibLoader`'s "do not put a module whose function name a bare builtin claims under `stdlib/`"): with the builtin
// live, a `print` call never reached a declaration, so listing the module would have loaded code no call
// site could get to — MEASURED, and the third time that rule has been applied (after `sleep` and the two
// UAX #29 classifiers). `print` is now an ordinary call to that module's declaration, `printError` arrives
// with its twin, and the floor under both is `__Builtins.writeStdout`/`writeStderr` below.

// **THE `__Builtins.runProcess` INTRINSIC** — the YIELDING child-process wait. It emits
// no `MaxonOp.call` to a user function: it routes to the `__gt_process_run(strPtr)` scheduler runtime entry,
// which spawns a Windows child, parks the current green thread on the process handle, and returns the child's
// scalar exit code once the netpoll observes it exit. Its arm is in the `__Builtins.*` table below.
//
// ⭐⭐ **IT IS NOT A BARE-NAME BUILTIN, BECAUSE A BARE NAME IS A LIVE DEFECT, NOT A COST OF BEING UNFINISHED.**
// A bare name is tested in `parseCallNamed` before any registry is consulted, so a program declaring its own
// `runProcess` would find that declaration silently unreachable and its calls checked against the one-argument
// stand-in. `maxon-bin/Testing/SpecTestRunner.maxon:637` declares exactly such a function — four parameters,
// three of them labelled — and the compiler would answer `E3036: 'runProcess' takes exactly 1 argument, but 3 were given`
// at its call sites. The reserved `__Builtins.` space cures it by CONSTRUCTION rather than by a check:
// `E2051` bars every declaration from that space, so no user name can contest this one.
//
// ⚠⚠ **IT IS AN INTRINSIC RATHER THAN A STDLIB DECLARATION, AND THE DIFFERENCE IS A
// MECHANISM AND NOT A SPELLING.** `sleep` and `print` are declarations — `stdlib/Sleep.maxon`,
// `stdlib/Print.maxon` — whose bodies bottom out in an intrinsic. `stdlib/Subprocess.maxon` is listed too, but
// it declares NO free `runProcess` and its `Subprocess.run` is a DIFFERENT mechanism: a poll-and-`__gt_sleep`
// drain over the `__Builtins.subprocess*` intrinsics below, not a park on the process handle. So there
// is no declaration to move this entry to; reconciling the two is the deferred
// full-Subprocess-API work, and until it lands the intrinsic spelling IS the surface — the shape
// `__Builtins.gtIsComplete` already has.
//
// ⚠ **THAT IS ALSO WHY THE TARGET ANSWER IS WHAT IT IS.** A bare-name builtin retired ONTO STDLIB SOURCE
// has its calls carried across `SemanticCheck.requireTargetSupportsCallee`'s asymmetry — reachability-BLIND for
// user code, reachability-AWARE for stdlib — so a program that never names the entry's wrapper starts
// compiling for targets that cannot lower it (`async-sleep.unnamed-sleep-compiles-on-wasm`). This entry is
// in USER code, so it stays blind, and `async-subprocess.rejected-on-wasm-when-unreached` pins that — the same half
// `builtins-clock.thread-cpu-ticks-rejected-on-wasm-when-unreached` keeps for `__Builtins.threadCpuTicks`.
let BuiltinsRunProcessName = b"__Builtins.runProcess"

// `__Builtins.runProcess` takes exactly one STRING argument — the command line — and returns an INTEGER (the
// child's exit code), so unlike `__Builtins.sleep` its result IS usable in value position.
let RunProcessArity = 1

// ⭐⭐ **`__Builtins.parallelBoundary()` — THE CPU-PARALLEL CHECKPOINT, AND THE ONE INTRINSIC HERE
// WHOSE RUNTIME ENTRY DOES NOTHING.** It marks a hand-written CPU-BOUND function as a deliberate
// `async` target, satisfying E3073's *"this function legitimately yields"* contract without
// claiming I/O it does not do — the alternative being a `sleep(0)` bought purely to pass a check.
// It performs no work.
//
// It is `sleep`'s SHAPE — void, so it needs the statement door and refuses a value position — and
// NOT its semantics: `sleep` and `yield` hand over the processor, this hands over nothing.
let BuiltinsParallelBoundaryName = b"__Builtins.parallelBoundary"

// ⭐ **THE RUNTIME ENTRY THE SPELLING ABOVE LOWERS TO, AND THE PAIR IS THE FACT** — the two are read
// together or not at all. Its BODY is Maxon source the compiler reads out of
// `runtime/ParallelBoundary.maxon`; `__Raw.ownFrame()` is what keeps it a real (empty) function rather
// than a lowering that vanishes, because a profile, a backtrace and a future hook all attach to the frame.
//
// ⭐ **IT WEARS NO EXISTING FAMILY'S `__` BAND, AND THAT IS DELIBERATE.** The obvious home is `__gt_`, since
// the thing the marker is ABOUT is the scheduler — but `isGtRuntimeCallee` is a PREFIX test that sets
// `usesGt`, so a name under that band would install the entire green-thread scheduler, the timer store and
// the netpoll for a program whose only concession to concurrency is a marker in a function nobody spawns
// (`specs/builtins-parallel-boundary.statement-position` is exactly that program). A checkpoint that costs a
// scheduler is not a checkpoint. `__proc_` is wrong for the opposite reason:
// `TargetFacilities.calleeHostFacility` maps that band onto `HostFacility.processInfo`, so a lane without
// one would refuse the marker with E3104 — and an empty function lowers on every target the compiler
// emits.
let ParallelBoundaryName = b"__parallel_boundary"

// `__Builtins.parallelBoundary` takes NOTHING and returns void — there is no knob on a checkpoint. Stated
// here beside the intrinsic for `SleepIntrinsicArity`'s reason, and as its own constant rather than a
// borrowed `YieldIntrinsicArity` for `CurrentProcessIdArity`'s: the number is a fact about THIS intrinsic's
// contract, and the two only happen to agree.
let ParallelBoundaryArity = 0

// ⭐⭐ **`__Builtins.forceSegfault()` — THE DELIBERATE ACCESS VIOLATION, AND THE ONLY INTRINSIC WHOSE
// POINT IS TO CRASH.** The emitted runtime carries a fault handler that turns a hardware trap into
// `panic: nil pointer or invalid memory access`, a symbolized backtrace and exit 1; every other
// route to that handler is a compiler BUG, so without this door the handler is code no test can
// reach. Its body is Maxon source the compiler reads out of `runtime/FaultProbe.maxon`, where
// `__Raw.ownFrame()` is what keeps it a real function rather than a store inlined here — the case asserts
// the FRAME LIST. The runtime name it lowers to is `MmRuntime.ForceSegfaultName`, which is also the
// classifier's.
let BuiltinsForceSegfaultName = b"__Builtins.forceSegfault"

// `__Builtins.forceSegfault` takes NOTHING and returns void — there is no knob on a crash. Its own constant
// rather than a borrowed `ParallelBoundaryArity` for `CurrentProcessIdArity`'s reason: the number is a fact
// about THIS intrinsic's contract, and the two only happen to agree.
let ForceSegfaultArity = 0

// ⭐⭐ **THE OTHER TWO MEMBERS OF THE CPU-PARALLEL FAMILY — THE QUERIES, WHERE THE MARKER ABOVE IS A
// STATEMENT.** Both take no arguments and answer an `int`. Their one caller in this tree is
// `scripts/multicore-stress/alloc-torture.maxon`, which prints both so its driver can sweep the core-count
// clamp and see that more than one core actually ran the work.
//
// ⚠ **THEY ANSWER TWO DIFFERENT KINDS OF QUESTION, AND THE DIFFERENCE DECIDES THEIR TARGETS.**
// `cpuCount` asks the OS about the MACHINE, so it lowers only on a lane that provides the read and is
// refused elsewhere with E3104; `schedMaxActiveWorkers` asks THE RUNNING PROGRAM's own scheduler about
// itself and lowers everywhere, because the answer is a `.data` word that scheduler maintains — a
// `globalAddr` and a load, which every backend has. See `CpuParallelRuntime`'s header, which owns that
// split — this file only routes the names.
let BuiltinsCpuCountName = b"__Builtins.cpuCount"
let BuiltinsSchedMaxActiveWorkersName = b"__Builtins.schedMaxActiveWorkers"

// Both take NOTHING. Stated here beside the intrinsics for `SleepIntrinsicArity`'s reason, and as two
// constants rather than one shared zero for `CurrentProcessIdArity`'s: the number is a fact about each
// intrinsic's own contract, and these two only happen to agree.
let CpuCountArity = 0
let SchedMaxActiveWorkersArity = 0

let BuiltinsCpuHasAesName = b"__Builtins.cpuHasAes"
let CpuHasAesArity = 0

// ⭐⭐ **`__Builtins.enterBackgroundPriority()` — THE ONLY INTRINSIC THAT CHANGES THE PROCESS RATHER THAN
// REPORTING ON IT.** Everything in the band above asks a question; this one answers a question it first
// made true. It lowers to `__proc_bg_priority`, which is why it is refused off x64-windows by the `__proc_`
// prefix rather than by anything written here — this file only routes the name.
//
// ⚠ **ITS ANSWER'S UNIT IS PLATFORM-DEFINED AND NOTHING CONVERTS IT** (a Windows priority CLASS against a
// POSIX NICE value, running in opposite directions). `StdOp.osEnterBackgroundPriority` owns that fact.
let BuiltinsEnterBackgroundPriorityName = b"__Builtins.enterBackgroundPriority"

// ⭐⭐ **`__Builtins.stdoutWantsAnsiColor()` — MAY THIS PROGRAM'S REPORT CARRY ESCAPE SEQUENCES?** It
// lowers to `__tty_stdout_wants_color`, and this file only routes the name.
//
// ⚠ **UNLIKE ITS NEIGHBOURS IT IS REFUSED ON NO LANE AT ALL.** `__tty_stdout_wants_color` is emitted for
// every target: `TerminalRuntime.installTerminalRuntime` reads `HostFacility.terminalDetection` and gives
// a lane that cannot ask the host a body answering "not a terminal". The absence of the facility is an
// ANSWER here where the absence of a file surface is not, which is the whole argument — written out at
// that enum case, and paid for by a day in which the E3104 form made the compiler unbuildable for arm64-macOS.
//
// ⚠ **IT ANSWERS A `bool`, WHICH IS WHAT SPLITS IT FROM THE ARGUMENTLESS-INTEGER BAND ABOVE.** A pid, a
// core count and a priority class are numbers a caller reads; this is a PREDICATE, and tagged `integer`
// it would need `!= 0` at every call site — the sentinel-shaped spelling the house rules refuse.
// `__ManagedDirectory.exists` has the same arrangement for the same reason: the runtime answers 0/1
// because this tier has no `setcc`, and the PARSER is what tags the result `boolean`.
//
// ⚠ **IT HAS NO `stdlib/` WRAPPER, exactly as `enterBackgroundPriority` has none**: a declaration whose
// whole body is one intrinsic call is the thin wrapper the house rules forbid. The intrinsic IS the
// surface, and `TestRender.reportColorEnabled` is its one caller in this tree.
let BuiltinsStdoutWantsAnsiColorName = b"__Builtins.stdoutWantsAnsiColor"

// It takes NOTHING. Its own constant rather than sharing one, for `CurrentProcessIdArity`'s rule: the
// number is a fact about THIS intrinsic's contract, not about its neighbours'.
let StdoutWantsAnsiColorArity = 0

// It takes NOTHING. Its own constant rather than sharing one, for `CurrentProcessIdArity`'s rule: the
// number is a fact about THIS intrinsic's contract, not about its neighbours'.
let EnterBackgroundPriorityArity = 0

// ⭐⭐ **`__Builtins.schedStealCount()` — THE THIRD SCHEDULER QUERY, and the only way a program can
// observe that WORK STEALING happened.** It answers the sum of every processor's steal counter, which is 0
// on the one-processor default and rises the moment a second M takes work off a busy peer's ring. Its one
// caller in this tree is `scripts/multicore-stress/steal-torture.maxon`, whose whole assertion is that the number
// is not zero when the harness gives the scheduler more than one processor.
//
// ⚠ The stealing is this compiler's own, so the surface is invented here, on the
// argumentless-integer shape the family already has. `SchedRuntime.SchedStealCountName` owns what
// it costs; this file only routes the name.
let BuiltinsSchedStealCountName = b"__Builtins.schedStealCount"

// It takes NOTHING. Its own constant rather than `SchedMaxActiveWorkersArity` for `CurrentProcessIdArity`'s
// rule: the number is a fact about THIS intrinsic's contract, and the two only happen to agree.
let SchedStealCountArity = 0

// ⭐⭐ **`__Builtins.schedRetakeCount()` — THE FIFTH SCHEDULER QUERY, and the only way a program can
// observe that a PROCESSOR HANDOFF happened.** It answers the sum of every processor's retake counter, which
// rises exactly when `__sysmon` takes a processor away from a machine stuck in a blocking kernel call.
//
// ⛔⛔ **IT EXISTS BECAUSE THE ORDERING CASE IT SERVES CAN BE GREENED BY THE WRONG CURE.** Routing a blocking
// read through the existing IOCP park road would reorder `sched-syscall-handoff`'s two lines without a
// processor ever being retaken — a real improvement, and a different change. This number is what makes
// `retaken=yes` a claim about the MECHANISM rather than about the output.
//
// ⚠ **NEITHER REFERENCE DECLARES IT**, exactly as neither declares `schedStealCount`: the compiler's handoff is
// the compiler's own. `SchedRuntime.SchedRetakeCountName` owns what it costs; this file only routes the name.
let BuiltinsSchedRetakeCountName = b"__Builtins.schedRetakeCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedRetakeCountArity = 0

// ⭐⭐ **`__Builtins.schedGtRecycleCount()` — how many green-thread records a free list served instead of the
// record arena.** It answers the sum of every processor's recycle counter, so a program can observe that a
// reclaimed GT record really came back to a later spawn rather than a fresh one being carved. The surface is
// invented here on the argumentless-integer shape the family already has; `SchedRuntime.GtFreePutName`
// owns why the records are recycled and `SchedRuntime.SchedGtRecycleCountName` what the count costs.
let BuiltinsSchedGtRecycleCountName = b"__Builtins.schedGtRecycleCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedGtRecycleCountArity = 0

// ⭐⭐ **`__Builtins.schedPreemptCount()` — how many preemption requests green threads have honoured.** It answers
// the sum of every processor's preemption counter, so a program can observe that a thread which ran too long
// really gave its processor up rather than that its output merely came out in a better order. The surface is
// invented here on the argumentless-integer shape the family already has; `SchedRuntime.SchedPreemptCountName`
// owns what the count costs.
let BuiltinsSchedPreemptCountName = b"__Builtins.schedPreemptCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedPreemptCountArity = 0

// ⭐⭐ **`__Builtins.schedSliceCount()` — how many TIME SLICES the scheduler has started.** It answers the sum
// of every processor's schedule counter, which steps once per schedule that did NOT inherit the running slice
// out of the `runnext` slot. It is the quantity the 61-schedule global-queue check and `__sysmon`'s overdue
// test are both phrased in, so it is what a fairness assertion has to be written against: a thread's POSITION
// in a run order moves on a slot hand-off that spent no slice at all. The surface is invented here on the
// argumentless-integer shape the family already has; `SchedRuntime.SchedSliceCountName` owns what the count
// costs.
let BuiltinsSchedSliceCountName = b"__Builtins.schedSliceCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedSliceCountArity = 0

// `__Builtins.gtQuiesce()` — see `GtRuntime.buildGtQuiesce`. Only the spec harness's generated
// batch entry and the specs spell it.
let BuiltinsGtQuiesceName = b"__Builtins.gtQuiesce"
let GtQuiesceArity = 0

let BuiltinsCownTestMultiName = b"__Builtins.cownTestMulti"
let CownTestMultiArity = 3

// ⭐⭐ **`__Builtins.schedNetpollBlockCount()` — how many times a green thread has suspended on the NETWORK
// POLLER waiting for a socket to become ready.** It is the witness that a socket wait really left the
// processor rather than merely finishing fast: a reader busy-waiting on a non-blocking descriptor provokes no
// monitor rescue either, and only this count separates the two. The surface is invented here on the
// argumentless-integer shape the family already has; `SchedRuntime.SchedNetpollBlockCountName` owns what the
// count costs.
let BuiltinsSchedNetpollBlockCountName = b"__Builtins.schedNetpollBlockCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedNetpollBlockCountArity = 0

// ⭐⭐ **`__Builtins.schedSyscallCount()` — how many BRACKETED kernel calls have been entered by a machine holding
// a processor.** A bracketed call is one `__sysmon` may retake the processor out of, so a window asserting that
// no retake can happen is a window this count must not move in; a retake count reads 0 whenever the monitor
// happened not to look, and only this separates *"nothing could be retaken"* from *"nothing was"*. The surface is
// invented here on the argumentless-integer shape the family already has; `SchedRuntime.SchedSyscallCountName`
// owns what the count costs.
let BuiltinsSchedSyscallCountName = b"__Builtins.schedSyscallCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedSyscallCountArity = 0

// ⭐⭐ **`__Builtins.schedGlobalPushCount()` — how many green threads have ever been pushed onto the GLOBAL
// run queue.** Every producer counts: a full ring's overflow batch, a yield, a preemption, and a publish by a
// thread holding no processor. It is the WITNESS that a global-queue property was really under test — the
// queue's population can read empty because nothing was ever put there, which is a program whose setup never
// came about rather than one whose scheduler behaved. The surface is invented here on the argumentless-integer
// shape the family already has; `SchedRuntime.SchedGlobalPushesLabel` owns what it counts.
let BuiltinsSchedGlobalPushCountName = b"__Builtins.schedGlobalPushCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedGlobalPushCountArity = 0

// ⭐⭐ **`__Builtins.schedTimerScanStepCount()` — how many timer-heap entries the cancel scan has INSPECTED.**
// It reports a COST rather than an event, which is what no other member of this family can do: disarming a
// deadline is a linear walk of the heap, so a cancel that armed nothing and walks anyway is quadratic in a
// program with many sleepers and much I/O, and every event-shaped counter reads identically either way. The
// surface is invented here on the argumentless-integer shape the family already has;
// `SchedRuntime.SchedTimerScanStepsLabel` owns what it counts.
let BuiltinsSchedTimerScanStepCountName = b"__Builtins.schedTimerScanStepCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedTimerScanStepCountArity = 0

// ⭐⭐ **`__Builtins.schedTimerStartCount()` — how many machines the system monitor has started for an overdue
// timer.** With `schedPreemptCount()` and `schedRetakeCount()` it is everything the monitor does that can put a
// machine to work, which is what an `async`-only program's one-worker reading is conditional on. The surface is
// invented here on the argumentless-integer shape the family already has; `SchedRuntime.SchedTimerStartsLabel`
// owns what it counts.
let BuiltinsSchedTimerStartCountName = b"__Builtins.schedTimerStartCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedTimerStartCountArity = 0

// ⭐⭐ **`__Builtins.schedIdleProcessorCount()` — how many processors sit idle with no machine, Go's
// `sched.npidle`.** A live count rather than an outcome: it is what the spinner cap reads, and a program reads
// it to observe that its workers really gave their processors back. The surface is invented here on the
// argumentless-integer shape the family already has; `SchedRuntime.SchedIdleProcessorCountName` owns what it
// answers and why it brings the scheduler up.
let BuiltinsSchedIdleProcessorCountName = b"__Builtins.schedIdleProcessorCount"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedIdleProcessorCountArity = 0

// ⭐⭐ **`__Builtins.schedGtRecordsCarved()` — how many green-thread records the scheduler's record arena has
// ever carved.** A program that reclaims every thread it finishes with keeps it bounded however many rounds it
