let BuiltinsSchedGtRecordsCarvedName = b"__Builtins.schedGtRecordsCarved"

// It takes NOTHING. Its own constant, for `CurrentProcessIdArity`'s rule.
let SchedGtRecordsCarvedArity = 0

// ⭐⭐ **`__Builtins.schedParkWakeCount()` — how many times a machine's blocking wait has returned, for any
// reason.** An idle program keeps it near zero: a machine with nothing to do blocks until there is something,
