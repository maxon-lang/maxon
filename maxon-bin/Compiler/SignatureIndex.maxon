		// clone at `character` rather than at `string`.
		character then return ManagedGlobalRecord.stringRecord(bytes)
		byteArray then return ManagedGlobalRecord.constArrayRecord(ByteStringElementSize as ElementStride, elementCount: bytes.count() as FullRangeInt, bytes: bytes)
	end 'k'
end 'managedLiteralRecord'

// The value a managed global's `.data` slot holds BEFORE `__module_init` runs: a null pointer. Named
// rather than a bare 0 because it is a CLAIM — "no record exists yet" — and it is the one state the
// cleanup's unconditional decref relies on never being observed (see `ModuleInit`).
let ManagedGlobalInitialSlot = 0

// A top-level `let`, as the declaration sweep found it: WHAT it is called, WHERE it was written, and the
// TOKEN RANGE of its initializer — read, never evaluated on the spot.
//
// **THE RANGE, AND NOT A TREE.** The sweep and the evaluation are two halves of ONE query
// (`Queries.queryProgramSignatures`) and the token memo is live throughout, so the range is enough —
// and a node union would be a second representation of an expression the body parser already reads.
//
// ⭐ **THE RANGE INDEXES ITS FILE'S TOKEN STREAM, WHICH THE INDEX HOLDS ONCE PER FILE AND ONLY UNTIL THE EVALUATION
// SETTLES** (`ProgramSignatures.declTokensOf`), so a reference FROM ANOTHER FILE resolves without the query layer. What
// outlives the evaluation is `initRange`, not the stream.
export type TopLevelDecl
	// The key this declaration is filed under: its name as the sweep recorded it, which for a name two
	// directories declare is the `<directory>~name` mint (`settleBindingMints`). A stored declaration's
	// `.data` LABEL is derived from this key (`assignDataLabels`), so it carries no file path into the
	// rendered Target IR and the emitted binary.
	export let storageKey as immutable ByteArray

	// The BARE name, kept for the diagnostics that must print what the user wrote rather than the
	// path-qualified key the compiler files it under. Carrying it costs one pointer and saves stripping
	// the prefix back off at E2012 time.
	export let name as immutable ByteArray

	// ⭐⭐ **DOES THIS DECLARATION HAVE A `.data` SLOT?** — the ONE criterion deciding which of the two doors
	// a USE goes through (`constantValueOf` materializes a value, `globalDeclFor` loads a slot), which decls
	// the layout reserves storage for, and which ones `assignDataLabels` labels. Read from all four, so it is
	// ONE fact rather than four re-derivations that could give a binding a slot the layout never laid down.
	//
	// ⚠ **A RECORD `let` THE COMPILER CANNOT LAY DOWN AS BYTES IS STORED**: a managed-element array
	// literal, a container holding members, a factory's result, a boxed case. Their value is a heap record
	// `__module_init` builds and no READ can re-materialize one, so the binding gets a slot while `let`
	// keeps refusing the write (E2013 at an assignment, E3207 at a receiver-writing method).
	//
	// ⭐⭐ **AN IMAGED `let` HAS NO SLOT** (⚖ user ruling: a `let` is image data). A constant
	// array literal and an empty `Array with T` ARE bytes the compiler can lay down, so each read is one
	// `.rdata` address and there is no slot, no `__module_init` construction and no cleanup drop.
	// `settleStoredRecord` and `settleImagedOutcome` are the ONLY writers of this bit, and they are where
	// `outcome` becomes a record — so the storage model and the value cannot disagree.
	//
	// ⚠ **A FIELD RATHER THAN A FUNCTION THAT RE-READS `outcome`.** The obvious spelling is a test over
	// the outcome, asked afresh at each of the four readers. A bool written where the
	// outcome is written says the same thing once, is O(1) at every ask, and — the part that matters — makes
	// the answer available in the window where the outcome is not yet settled, which the four readers
	// straddle (see below).
	//
	// ⚠ It is FALSE for an unevaluated decl, and that is the right answer rather than a placeholder: the
	// only reader in that window is the sweep's own name resolution (`constantValueDuringSweep` →
	// `constantDeclFor`), mid-DFS, and answering "inlined" merely lets the reference through to `evaluateDecl`,
	// which settles the decl first. That is what keeps the forward reference `let TOTAL = FIRST + SECOND`
	// above `let FIRST = 30` working.
	export var hasStorage as bool

	// ⭐ **THE TIER THE DECLARATION WROTE** — kept ALONGSIDE `storageKey`: the key answers "which
	// declaration is this?", and an unexported declaration shares its key's shape with an exported one and
	// is told apart only by asking the READER's file. `declFor` needs both.
	export var visibility as Visibility
	export let declFilePath as FilePath
	export let initStart as ElementIndex
	export let initEnd as ElementIndex

	// The initializer's first token's span, which every op the declaration's module-init and cleanup synthesis emits
	// carries.
	export var initRange as SourceRange

	// The NAME's position — where a diagnostic about this declaration points.
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber

	// The initializer's answer, mutated in place as the DFS reaches and leaves this decl.
	export var outcome as TopLevelConstant

	// ⭐ **WHAT A DEFINE PUT HERE INSTEAD OF THE INITIALIZER** (`ProgramSignatures.resolveDefines`).
	export var defined as DefinedInitializer

	// ⭐ THE `.data` LABEL — this binding's IR IDENTITY, and `unlabelled` for every binding with no
	// slot.
	//
	// ⚠ **WHICH BINDINGS THOSE ARE IS `hasStorage`.** A `let` takes either storage model (see that field),
	// so an imaged record `let` and a scalar `let` are unlabelled while a record `let` the compiler cannot
	// image is labelled.
	//
	// DERIVED FROM THE KEY, not a second spelling of it: `assignDataLabels` walks the arena in
	// declaration order and hands each STORED decl its bare name, disambiguated ONLY where an
	// earlier decl already took that label. So the common program gets `__data_counter` and the
	// pathological one gets `__data_counter` + `__data_counter$1` — and NEITHER carries a file path,
	// which is what keeps the Target IR free of the temp directory the spec runner compiled in.
	export var dataLabel as DataSlotLabel

	// ⭐⭐ **WAS THIS BINDING DECLARED BY THE STDLIB CORPUS?** Stdlib is loaded into EVERY compile whether the
	// program names it or not, so a corpus declaration is not the program's: `contributesStorage` keeps a
	// corpus slot only where something READS it, and `globalInitCallees` leaves its initializer's callees to
	// be credited at that read (`initCalleesOfCorpusSlot`). A declaration the author wrote gets the
	// unconditional treatment on both counts — its initializer runs before `main` whatever reads the slot.
	//
	// ⛔ **THE ASYMMETRY IS A COST, NOT A SEMANTICS.** `stdlib/CharacterSet.maxon` declares eleven presets,
	// each building a `Set with Character`; rooting them unconditionally reaches `Set.create`/`Set.insert` and
	// the `Array` cone behind them in EVERY program, and turns the heap on for `return 7`.
	//
	// ⚠⚠ **WHAT THE CODE ENFORCES IS NARROWER THAN "UNOBSERVABLE", AND SAYING SO IS THE POINT.** A dropped
	// corpus initializer's effect on ITS OWN SLOT is unobservable — nothing reads the slot, or it would be
	// live. An effect ELSEWHERE is not: `static let x = Registry.register()` whose `register()` appends to a
	// live `Registry.all` is visible to a program that never names `x`. Every corpus initializer in the tree
	// today constructs and returns, so nothing bites; a library that wants a registration effect must state it
	// where the program can reach it.
	//
	// ⭐ **THE BASIS IS THE DECLARING FILE (`ParseJob.isStdlibSource`), NEVER THIS COMPILE'S ROOT.** The other
	// bit, `livesUnderStdlibDirectory`, is `isStdlibSource or rootIsUnderStdlibDirectory` — so a project
	// ROOTED under `stdlib/` would mark the author's own declarations corpus and silently liveness-gate their
	// eager init. The question here is who supplied the file, which is exactly the loader's own partition.
	export let declaredByTheCorpus as bool

	// ⭐ **WHICH BODY DECLARED THIS BINDING — file scope, or a `type` body's `static let`.**
	// It decides nothing about WHEN the initializer runs (both run before `main`, in dependency order —
	// `ModuleInit`); it says where the initializer's tokens are SEATED, which is what makes `Self`-shaped
	// construction legal inside a type body and nowhere else (`Parser.seatInDeclaringTypeBody`).
	//
	// Recorded by the reader rather than re-derived downstream from whether the name carries a `Type.`
	// qualifier, which would be a lossy key used as an identity.
	export var scope as EnclosingTypeScope

	export var letCast as LetCastDeclaration
	export var letCastReads as LetCastReadArray

	export static function create(name immutable ByteArray, visibility Visibility, declFilePath FilePath, initStart ElementIndex, initEnd ElementIndex, initRange SourceRange, nameLine LineNumber, nameColumn ColumnNumber, scope EnclosingTypeScope, declaredByTheCorpus bool) returns TopLevelDecl
		return Self{
			storageKey: name,
			name: name,
			visibility: visibility,
			hasStorage: false,
			declFilePath: declFilePath,
			initStart: initStart,
			initEnd: initEnd,
			initRange: initRange,
			nameLine: nameLine,
			nameColumn: nameColumn,
			declaredByTheCorpus: declaredByTheCorpus,
			outcome: TopLevelConstant.pending,
			defined: DefinedInitializer.written,
			dataLabel: DataSlotLabel.unlabelled,
			scope: scope,
			letCast: LetCastDeclaration.none,
			letCastReads: LetCastReadArray.create(0)
		}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.storageKey)
		writer.bytes(self.name)
		writer.flag(self.hasStorage)
		writer.unsigned(self.visibility.ordinal as CacheUnsigned)
		writer.text(self.declFilePath.toString())
		writer.unsigned(self.initStart as CacheUnsigned)
		writer.unsigned(self.initEnd as CacheUnsigned)
		self.initRange.cacheWrite(writer)
		writer.unsigned(self.nameLine as CacheUnsigned)
		writer.unsigned(self.nameColumn as CacheUnsigned)
		cacheWriteTopLevelConstant(writer, value: self.outcome)
		cacheWriteDefinedInitializer(writer, value: self.defined)
		cacheWriteDataSlotLabel(writer, value: self.dataLabel)
		writer.flag(self.declaredByTheCorpus)
		cacheWriteEnclosingTypeScope(writer, value: self.scope)
		cacheWriteLetCastDeclaration(writer, value: self.letCast)
		cacheWriteLetCastReadArray(writer, value: self.letCastReads)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns TopLevelDecl throws LibraryCacheDamage
		let f_storageKey = freeze try reader.bytes()
		let f_name = freeze try reader.bytes()
		let f_hasStorage = try reader.flag()
		let f_visibility = try cacheReadVisibility(reader)
		let f_declFilePath = try reader.path()
		let f_initStart = (try reader.unsigned()) as ElementIndex
		let f_initEnd = (try reader.unsigned()) as ElementIndex
		let f_initRange = try SourceRange.cacheRead(reader)
		let f_nameLine = (try reader.unsigned()) as LineNumber
		let f_nameColumn = (try reader.unsigned()) as ColumnNumber
		let f_outcome = try cacheReadTopLevelConstant(reader)
		let f_defined = try cacheReadDefinedInitializer(reader)
		let f_dataLabel = try cacheReadDataSlotLabel(reader)
		let f_declaredByTheCorpus = try reader.flag()
		let f_scope = try cacheReadEnclosingTypeScope(reader)
		let f_letCast = try cacheReadLetCastDeclaration(reader)
		let f_letCastReads = try cacheReadLetCastReadArray(reader)

		return Self{storageKey: f_storageKey, name: f_name, hasStorage: f_hasStorage, visibility: f_visibility, declFilePath: f_declFilePath, initStart: f_initStart, initEnd: f_initEnd, initRange: f_initRange, nameLine: f_nameLine, nameColumn: f_nameColumn, outcome: f_outcome, defined: f_defined, dataLabel: f_dataLabel, declaredByTheCorpus: f_declaredByTheCorpus, scope: f_scope, letCast: f_letCast, letCastReads: f_letCastReads}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize136
		return sizeof(TopLevelDecl) as CacheSize136
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'TopLevelDecl'

export union DataSlotLabel
	unlabelled
	labelled(label immutable ByteArray)

	export function label() returns immutable ByteArray throws AbsentError
		match self 'slot'
			unlabelled then throw AbsentError.absent
			labelled(label) then return label
		end 'slot'
	end 'label'
end 'DataSlotLabel'

// @generated library-cache begin
function cacheWriteDataSlotLabel(writer LibraryCacheWriter, value DataSlotLabel)
