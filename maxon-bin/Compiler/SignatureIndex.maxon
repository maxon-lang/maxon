// ⭐⭐ **EVERYTHING ONE PARSE WROTE INTO THE SIGNATURE INDEX, AS THE ARTIFACT CARRIES IT.** The parse's writes
// are undone when it ends, so these are what the merge folds back in, in source-path order, on every fold —
// whether the artifact is a fresh parse or a memo reused against a rebuilt index.
export type LocalInstanceMints
	export let typeNames as NameRoster
	export let typeNameBaseline as TypeNameId
	export let rows as LocalInstanceRowArray
	export let namedRows as GenericInstanceIdArray
	export let copyDemandedRows as GenericInstanceIdArray
	export let tupleLayouts as StructLayoutArray
	export let substitutionOrigins as SubstitutionOriginArray
	export let constantReads as NameInFileArray
	export let tupleAliases as TupleAliasRecordArray

	// What every row-set question the parse asked was answered — checked against the whole program's rows at
	// every merge (`ProgramSignatures.rowSetAnswersThatMoved`).
	export let rowSetAnswers as RowSetAnswerLog

	static function create(typeNames NameRoster, typeNameBaseline TypeNameId, rows LocalInstanceRowArray, namedRows GenericInstanceIdArray, copyDemandedRows GenericInstanceIdArray, tupleLayouts StructLayoutArray, substitutionOrigins SubstitutionOriginArray, constantReads NameInFileArray, tupleAliases TupleAliasRecordArray, rowSetAnswers RowSetAnswerLog) returns LocalInstanceMints
		return Self{typeNames: typeNames, typeNameBaseline: typeNameBaseline, rows: rows, namedRows: namedRows, copyDemandedRows: copyDemandedRows, tupleLayouts: tupleLayouts, substitutionOrigins: substitutionOrigins, constantReads: constantReads, tupleAliases: tupleAliases, rowSetAnswers: rowSetAnswers}
	end 'create'

	export function watchedBy(watcher TypeIdRemap)
		_ = self.remappedThrough(watcher, baseline: self.typeNameBaseline)
	end 'watchedBy'

	export function rebased(rebase ParseRebase) returns LocalInstanceMints
		let newBaseline = rebase.nameBaseline
		let bandCount = self.typeNames.count() as TypeNameId
		let names = TypeNameIdArray.create(self.typeNameBaseline + bandCount, zeroed: false)

		for id in 0 upto self.typeNameBaseline + bandCount 'eachName'
			if id < self.typeNameBaseline 'aBaselineName'
				names.push(try rebase.names.get(id) otherwise id)
				continue
			end 'aBaselineName'

			names.push(id - self.typeNameBaseline + newBaseline)
		end 'eachName'

		return self.remappedThrough(TypeIdRemap.create(names, namesBase: 0, instances: rebase.instances.clone()), baseline: newBaseline)
	end 'rebased'

	function remappedThrough(remap TypeIdRemap, baseline TypeNameId) returns LocalInstanceMints
		let rebasedRows = LocalInstanceRowArray.create(self.rows.count(), zeroed: false)

		for row in self.rows 'eachRow'
			rebasedRows.push(LocalInstanceRow.create(remap.applyName(row.baseId), args: remapMaxonTypes(row.args, remap: remap), shape: row.shape, speculative: row.speculative))
		end 'eachRow'

		let named = GenericInstanceIdArray.create(self.namedRows.count(), zeroed: false)

		for id in self.namedRows 'eachNamedRow'
			named.push(remap.applyInstance(id))
		end 'eachNamedRow'

		let demanded = GenericInstanceIdArray.create(self.copyDemandedRows.count(), zeroed: false)

		for id in self.copyDemandedRows 'eachCopyDemandedRow'
			demanded.push(remap.applyInstance(id))
		end 'eachCopyDemandedRow'

		let layouts = StructLayoutArray.create(self.tupleLayouts.count(), zeroed: false)

		for layout in self.tupleLayouts 'eachTuple'
			let copy = layout.clone()
			remapStructLayoutFieldTypes(copy, remap: remap)
			layouts.push(copy)
		end 'eachTuple'

		let origins = SubstitutionOriginArray.create(self.substitutionOrigins.count(), zeroed: false)

		for origin in self.substitutionOrigins 'eachOrigin'
			origins.push(SubstitutionOrigin.create(remap.applyInstance(origin.instance), through: remap.applyInstance(origin.through)))
		end 'eachOrigin'

		return Self.create(self.typeNames, typeNameBaseline: baseline, rows: rebasedRows, namedRows: named, copyDemandedRows: demanded, tupleLayouts: layouts, substitutionOrigins: origins, constantReads: self.constantReads, tupleAliases: self.tupleAliases, rowSetAnswers: self.rowSetAnswers)
	end 'remappedThrough'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteNameRoster(writer, value: self.typeNames)
		writer.unsigned(self.typeNameBaseline as CacheUnsigned)
		cacheWriteLocalInstanceRowArray(writer, value: self.rows)
		cacheWriteGenericInstanceIdArray(writer, value: self.namedRows)
		cacheWriteGenericInstanceIdArray(writer, value: self.copyDemandedRows)
		cacheWriteStructLayoutArray(writer, value: self.tupleLayouts)
		cacheWriteSubstitutionOriginArray(writer, value: self.substitutionOrigins)
		cacheWriteNameInFileArray(writer, value: self.constantReads)
		cacheWriteTupleAliasRecordArray(writer, value: self.tupleAliases)
		self.rowSetAnswers.cacheWrite(writer)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns LocalInstanceMints throws LibraryCacheDamage
		let f_typeNames = try cacheReadNameRoster(reader)
		let f_typeNameBaseline = (try reader.unsigned()) as TypeNameId
		let f_rows = try cacheReadLocalInstanceRowArray(reader)
		let f_namedRows = try cacheReadGenericInstanceIdArray(reader)
		let f_copyDemandedRows = try cacheReadGenericInstanceIdArray(reader)
		let f_tupleLayouts = try cacheReadStructLayoutArray(reader)
		let f_substitutionOrigins = try cacheReadSubstitutionOriginArray(reader)
		let f_constantReads = try cacheReadNameInFileArray(reader)
		let f_tupleAliases = try cacheReadTupleAliasRecordArray(reader)
		let f_rowSetAnswers = try RowSetAnswerLog.cacheRead(reader)

		return Self{typeNames: f_typeNames, typeNameBaseline: f_typeNameBaseline, rows: f_rows, namedRows: f_namedRows, copyDemandedRows: f_copyDemandedRows, tupleLayouts: f_tupleLayouts, substitutionOrigins: f_substitutionOrigins, constantReads: f_constantReads, tupleAliases: f_tupleAliases, rowSetAnswers: f_rowSetAnswers}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize80
		return sizeof(LocalInstanceMints) as CacheSize80
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'LocalInstanceMints'

typealias FingerprintValueArray = Array with EntryCount
typealias FingerprintDigestArray = Array with HashDigest

// Whether a fingerprint records each field's name beside its value.
enum FingerprintDetail
	valuesOnly
	withLabels
end 'FingerprintDetail'

let FingerprintFlagSet = 1 as EntryCount
let FingerprintFlagClear = 0 as EntryCount

// A field whose value differs between two fingerprints of one index, by its position among the values or among
// the digests.
union FingerprintMove
	none
	value(position ElementIndex, was EntryCount, now EntryCount)
	digest(position ElementIndex)
end 'FingerprintMove'

// ⭐ **VALUES ONLY, UNLESS A FIELD MOVED.** A fingerprint is taken at every parse's open and close and at every
// fold, and a label is a string built per field — so the labels are recorded only by a second walk
// (`FingerprintDetail.withLabels`), taken once a field has already moved, which then reads the name at the moved
// position.
export type IndexFingerprint
	let detail as FingerprintDetail
	var group as String
	var labels as StringArray
	var values as FingerprintValueArray
	var digestLabels as StringArray
	var digests as FingerprintDigestArray

	static function create(detail FingerprintDetail) returns IndexFingerprint
		return Self{detail: detail, group: "", labels: StringArray.create(0), values: FingerprintValueArray.create(0), digestLabels: StringArray.create(0), digests: FingerprintDigestArray.create(0)}
	end 'create'

	// Name every field noted until `closeGroup` as a field of `group`.
	//
	// ⚠ Both doors are inert outside `withLabels`, and that guard is a cost one, not a tidying. `fingerprint()`
	// runs once per FOLD in `valuesOnly` mode, where `self.group` is never read — so without it each group
	// stored a label String per fold, which is a term that grows with the corpus.
	export function openGroup(name String)
		if self.detail != FingerprintDetail.withLabels 'noLabelIsBuilt'
			return
		end 'noLabelIsBuilt'

		self.group = name
	end 'openGroup'

	export function closeGroup()
		if self.detail != FingerprintDetail.withLabels 'noLabelIsBuilt'
			return
		end 'noLabelIsBuilt'

		self.group = ""
	end 'closeGroup'

	export function note(field String, value EntryCount)
		self.values.push(value)

		if self.detail == FingerprintDetail.withLabels 'recordTheName'
			self.labels.push(self.labelOf(field))
		end 'recordTheName'
	end 'note'

	function noteFlag(field String, flag bool)
		self.note(field, value: FingerprintFlagSet if flag else FingerprintFlagClear)
	end 'noteFlag'

	function noteDigest(field String, digest HashDigest)
		self.digests.push(digest)

		if self.detail == FingerprintDetail.withLabels 'recordTheName'
			self.digestLabels.push(self.labelOf(field))
		end 'recordTheName'
	end 'noteDigest'

	function labelOf(field String) returns String
		if self.group.isEmpty() 'topLevel'
			return field
		end 'topLevel'

		return "{self.group}.{field}"
	end 'labelOf'

	function firstMove(now IndexFingerprint) returns FingerprintMove
		if self.values.count() != now.values.count() or self.digests.count() != now.digests.count() 'differentFields'
			panic("IndexFingerprint: two fingerprints of one index noted {self.values.count()} and {now.values.count()} values, {self.digests.count()} and {now.digests.count()} digests")
		end 'differentFields'

		for (position, was) in self.values.withIterator() 'eachValue'
			let current = try now.values.get(position.index()) otherwise panic("IndexFingerprint: values.get OOB at {position.index()} after the count check")

			if was != current 'moved'
				return FingerprintMove.value(position.index(), was: was, now: current)
			end 'moved'
		end 'eachValue'

		for (position, was) in self.digests.withIterator() 'eachDigest'
			let current = try now.digests.get(position.index()) otherwise panic("IndexFingerprint: digests.get OOB at {position.index()} after the count check")

			if was != current 'moved'
				return FingerprintMove.digest(position.index())
			end 'moved'
		end 'eachDigest'

		return FingerprintMove.none
	end 'firstMove'

	function valueLabel(position ElementIndex) returns String
		return try self.labels.get(position) otherwise panic("IndexFingerprint.valueLabel: no label at {position} — only a fingerprint taken `withLabels` names its fields")
	end 'valueLabel'

	function digestLabel(position ElementIndex) returns String
		return try self.digestLabels.get(position) otherwise panic("IndexFingerprint.digestLabel: no label at {position} — only a fingerprint taken `withLabels` names its fields")
	end 'digestLabel'
end 'IndexFingerprint'

function typeNameClaimIndexCount(index TypeNameClaimIndex) returns EntryCount
	return match index 'index'
		unsettled gives 0
		settled(byName) gives byName.count()
	end 'index'
end 'typeNameClaimIndexCount'

function crossKindContestCount(table CrossKindContestTable) returns EntryCount
	return match table 'table'
		unwritten gives 0
		entries(byName) gives byName.count()
	end 'table'
end 'crossKindContestCount'

function genericAliasContestCount(table GenericAliasContestTable) returns EntryCount
	return match table 'table'
		unwritten gives 0
		entries(byName) gives byName.count()
	end 'table'
end 'genericAliasContestCount'

function disagreeingAliasNameCount(roster DisagreeingAliasNameRoster) returns EntryCount
	return match roster 'roster'
		unwritten gives 0
		entries(names) gives names.count()
	end 'roster'
end 'disagreeingAliasNameCount'

// An unset cycle result notes one past every index a set one can hold.
function aliasCycleValue(result AliasCycleResult) returns EntryCount
	return match result 'result'
		none gives 0
		at(index) gives (index + 1) as EntryCount
	end 'result'
end 'aliasCycleValue'

// The two field counts the fused record has slots for, named rather than written as a bare `2`/`1` so each
// reads as the thing it counts: `managed` plus the grapheme flag, and `managed` alone.
let StringDeclaredFieldCount = 2 as FieldIndex
let CharacterDeclaredFieldCount = 1 as FieldIndex

// `managed` FIRST and embedded whole — the clause both fused wrappers share, and the one every offset in
// the record rests on: `buffer@0` and `length@8` ARE that field's first two slots, and every runtime
// function that reads a String or a Character reads them there. A free function rather than a third arm
// inside the check, because the two wrappers agree on exactly this much and differ below it.
function requireInlineManagedFieldFirst(layout StructLayout)
	let managedIndex = try layout.inlineManagedFieldIndex() otherwise panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(layout.name)}` declares no inline `managed` field — the record's `buffer@0`/`length@8` ARE that field's first two slots, so every runtime read of this type would read a record it does not have")

	if managedIndex != 0 'notFirst'
		panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(layout.name)}` declares its inline `managed` field at index {managedIndex} rather than first — the record's `buffer@0`/`length@8` ARE that field's first two slots, so every runtime read of this type would be off by whatever is declared ahead of it")
	end 'notFirst'

	if layout.offsetOfField(0) != ManagedRecordBufferOffset 'notAtZero'
		panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(layout.name)}` puts its first field at {layout.offsetOfField(0)} rather than {ManagedRecordBufferOffset} — the record's own `buffer@0`")
	end 'notAtZero'
end 'requireInlineManagedFieldFirst'

