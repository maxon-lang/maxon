end 'ManagedOpaqueArrayElement'

// What a constant expression evaluates to: the PAYLOAD, and the TAG that says what the payload
// means. A bool's payload is its 0/1 (TypeRules' `BoolTrueValue`), which is why one integer field
// serves both — and why the tag is not optional: a `boolean` 1 and an `integer` 1 are the same
// number and different values.
//
// A `type` (so, one heap object per value), which the per-VALUE rules in TypeRules go to
// real lengths to avoid — and the trade is the other way here. Those run on every operator of every
// expression of every function; this runs once per top-level constant DECLARATION, of which a
// program has a handful. A tagged pair is what the code wants to say, and there is no hot path to
// pay for it.
export type ConstValue
	export let payload as FullRangeInt
	export let tag as ValueTypeTag

	// ⭐⭐ **THE TYPE'S NAME WHEN THE TAG IS `named` — AND IT IS THE NAME'S BYTES, NOT AN INTERNED ID.**
	// A payload-free enum CASE folds to its tag, an ordinary number, and `integer` would be a wrong answer
	// about it: `X64Register.rcx` is an `X64Register`, and a use site handed a bare int refuses to pass it
	// where the enum is declared (`argument type mismatch for 'r': expected 'Reg', got 'int'`).
	//
	// ⚠ **A `TypeNameId` COULD NOT BE CARRIED HERE, and that is a fact about the interner rather than a
	// preference.** Ids are minted per PARSER (`Parser.internedName`'s panic says so), an initializer parse is a
	// throwaway parser built per declaration, and the USE site is a third one — so an id minted during the
	// fold means nothing where it is read. Bytes cross that boundary; the reader interns them into its own
	// table, exactly as `fieldTypeOf(…, into:)` re-interns a field's type for its caller.
	//
	// For an `integer` or `float` constant it is the typealias the value carries (`let A = 5 as Tally`,
	// and `A + A` after it), so the constant keeps that nominal identity at its use sites. EMPTY otherwise,
	// which is the truth rather than a sentinel: an unaliased number and a `boolean` name no type.
	export let typeName as immutable ByteArray

	// ⭐⭐ **DID THE SOURCE WRITE THIS PAYLOAD AS A NEGATIVE NUMBER?** — `Parser.writtenNegativeLiterals`
	// for a literal read straight off its tokens (`ofIntLiteral`), and a mark rather than a test for the same
	// reason: `-1`, `u64.max` and `0xFFFFFFFFFFFFFFFE` are the same 64 bits, and only the source tells the
	// negative one from the two largest non-negative ones.
	export let writtenNegative as bool

	// `writtenNegative`'s mirror: the source wrote a literal (or a `u64.max` bound) above
	// `i64.max`, so the negative payload is an unsigned number. Without it the range check reads
	// the value as negative and the int-to-float conversion signs it. Set where that literal or
	// bound is read and, likewise, rides no fold.
	export let aboveSignedMax as bool

	export static function create(payload FullRangeInt, tag ValueTypeTag, typeName immutable ByteArray = EmptySourceText, writtenNegative bool = false, aboveSignedMax bool = false) returns ConstValue
		return Self{payload: payload, tag: tag, typeName: typeName, writtenNegative: writtenNegative, aboveSignedMax: aboveSignedMax}
	end 'create'

	export static function ofIntLiteral(value FullRangeInt, negated bool) returns ConstValue
		return ConstValue.create(value, tag: ValueTypeTag.integer, writtenNegative: negated and value < 0, aboveSignedMax: not negated and value < 0)
	end 'ofIntLiteral'

	function fitsAlias(alias RangedTypeAlias, isFloat bool) returns bool
		return literalInRange(self.payload, low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: self.writtenNegative, writtenAboveSignedMax: self.aboveSignedMax)
	end 'fitsAlias'

	export static function ofBool(value bool) returns ConstValue
		return ConstValue.create(BoolTrueValue if value else BoolFalseValue, tag: ValueTypeTag.boolean)
	end 'ofBool'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.signed(self.payload as CacheSigned)
		writer.unsigned(self.tag.ordinal as CacheUnsigned)
		writer.bytes(self.typeName)
		writer.flag(self.writtenNegative)
		writer.flag(self.aboveSignedMax)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns ConstValue throws LibraryCacheDamage
		let f_payload = (try reader.signed()) as FullRangeInt
		let f_tag = try cacheReadValueTypeTag(reader)
		let f_typeName = freeze try reader.bytes()
		let f_writtenNegative = try reader.flag()
		let f_aboveSignedMax = try reader.flag()

		return Self{payload: f_payload, tag: f_tag, typeName: f_typeName, writtenNegative: f_writtenNegative, aboveSignedMax: f_aboveSignedMax}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize40
		return sizeof(ConstValue) as CacheSize40
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'ConstValue'

