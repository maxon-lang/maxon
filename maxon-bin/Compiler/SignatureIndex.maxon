// A bare name -> its dense node in the forwarding graph `closeGlobalAliasReturns` closes. The CSR key space must
// be dense and 0-based (see `CsrGraph`), and a bare name is neither, so it is interned into one.
typealias DeclNodeIndex = Map with (ByteArray, CsrIndex)

// A bare name -> every METHOD node wearing it. A method's node is keyed by its QUALIFIED spelling, so a
// call that knows only the final segment (`x.swap(…)`) needs this to reach them; a `self.swap(…)` does not,
// because it knows the type. Built by `DeclNodeSpace.internMethod` as it mints each method node.
typealias MethodNodesByName = Map with (ByteArray, CsrColumn)

// ⭐⭐ **THE NODE SPACE `closeGlobalAliasReturns` CLOSES OVER — ONE NODE PER DECLARATION, THREE WAYS TO
// FIND IT.** A declaration gets exactly one node (that is what makes a mark on it mean one thing); which
// INDEX it is filed in is `GlobalAliasReturnInfo.callability`, and which indexes an EDGE consults is
// `ForwardCall`'s shape. The two meet in `targetsOf`, which is the ONLY place the shape→node rule
// is written.
//
// ⚠ **ONE NODE PER DECLARATION IS A CORRECTNESS PROPERTY, NOT A TIDINESS ONE.** Filing a method under both
// its bare name and its qualified one would give it two nodes, and `reverseReachabilityMark` marks NODES —
// so a mark arriving through the bare node would be invisible to a `self.`-qualified edge asking the
// qualified one, which is a MISSED mark and therefore the original E2015 refusal. The bare-name reach is
// served by `methodNodesByName` (an index onto the same node) rather than by a second node.
type DeclNodeSpace
	// Per node, in mint order: the declaration's BARE name (what the published set is keyed by) and whether
	// any declaration on that node returns an immutable global's record directly (the closure's seed).
	export var bareNames as NameRoster
	export var seeds as BoolArray

	// A free function at the compile ANCHOR, keyed by its bare name. Only a bare call reaches these.
	export var rootFreeFunctions as DeclNodeIndex

	// A free function with a directory route, keyed by its bare name. A bare call or any dotted call.
	export var routableFreeFunctions as DeclNodeIndex

	// A method, keyed by its QUALIFIED `Type.name` spelling — which is what makes `Array.swap` and
	// `Holder.swap` two nodes rather than one.
	export var methods as DeclNodeIndex
	export var methodNodesByName as MethodNodesByName

	static function create() returns DeclNodeSpace
		return Self{bareNames: NameRoster.create(0), seeds: BoolArray.create(0), rootFreeFunctions: DeclNodeIndex.create(), routableFreeFunctions: DeclNodeIndex.create(), methods: DeclNodeIndex.create(), methodNodesByName: MethodNodesByName.create()}
	end 'create'

	// ⭐ **THE NODE A DECLARATION OWNS** — minted on first sight, and the one place a `callability` is turned
	// into an index. The METHOD arm also files the node under its bare name, because that is how a call that
	// wrote only the final segment finds it.
	function nodeFor(bareName ByteArray, callability DeclCallability) returns CsrIndex
		return match callability 'c'
			bareCallOnly gives self.intern(self.rootFreeFunctions, key: bareName, bareName: bareName)
			bareCallOrDirectoryRoute gives self.intern(self.routableFreeFunctions, key: bareName, bareName: bareName)
			methodOf(typeName) gives self.internMethod(typeName, bareName: bareName)
		end 'c'
	end 'nodeFor'

	function internMethod(typeName ByteArray, bareName ByteArray) returns CsrIndex
		let node = self.intern(self.methods, key: qualifiedMethodName(typeName, methodName: bareName), bareName: bareName)
		let wearers = try self.methodNodesByName.get(bareName) otherwise CsrColumn.create(0)

		for existing in wearers 'alreadyListed'
			if existing == node 'sameNode'
				return node
			end 'sameNode'
		end 'alreadyListed'

		wearers.push(node)
		self.methodNodesByName.upsert(bareName, value: wearers)
		return node
	end 'internMethod'

	// `key`'s dense node in `index`, minting one on first sight. The three columns move together — the name,
	// its node and its seed bit — because a node with no seed slot would read a bit belonging to a different
	// declaration, which is the one way a counting-sorted key space can be corrupted silently.
	function intern(index DeclNodeIndex, key ByteArray, bareName ByteArray) returns CsrIndex
		if let existing = try index.get(key) 'alreadyANode'
			return existing
		end 'alreadyANode'

		let node = self.bareNames.count()
		self.bareNames.push(bareName)
		self.seeds.push(false)
		index.upsert(key, value: node as CsrIndex)
		return node
	end 'intern'

	// ⭐⭐ **THE NODES A CALL CAN NAME — THE ONE HOME OF THE SHAPE→FAMILY RULE.** `closeGlobalAliasReturns`
	// builds an edge per target.
	//
	// A name no recorded declaration wears yields NO targets, and that is the answer: nothing can ever mark
	// it.
	function targetsOf(call ForwardCall) returns CsrColumn
		let targets = CsrColumn.create(0)
		let name = forwardCallName(call)

		match call 'c'
			// `self.f(…)` / `Self.f(…)`: the receiver's type IS the enclosing type, so exactly one node.
			throughSelf(typeName, _) then self.pushIfPresent(targets, index: self.methods, key: qualifiedMethodName(typeName, methodName: name))

			// `x.f(…)`: a method wearing the name, or a free function with a directory route.
			throughAReceiver then self.pushDottedTargets(targets, name: name)

			// `f(…)`: everything a dotted call reaches, plus a root-level free function.
			bare then self.pushBareTargets(targets, name: name)
		end 'c'

		return targets
	end 'targetsOf'

	// The targets EVERY dotted shape shares: the methods wearing the name, and the free function a
	// directory route could reach. `throughSelf` deliberately does not come through here — it names one
	// method and no free function at all.
	function pushDottedTargets(targets CsrColumn, name ByteArray)
		for node in try self.methodNodesByName.get(name) otherwise CsrColumn.create(0) 'eachMethodWearingIt'
			targets.push(node)
		end 'eachMethodWearingIt'

		self.pushIfPresent(targets, index: self.routableFreeFunctions, key: name)
	end 'pushDottedTargets'

	// A bare call reaches everything a dotted one does — implicit `self` makes it name a sibling METHOD, and
	// a free function is nameable bare whether or not it also has a directory route — PLUS the root-level
	// free function no dotted spelling can reach. Stated as "the dotted set plus one" rather than as its own
	// list, because that containment IS the rule and a second list could stop expressing it.
	function pushBareTargets(targets CsrColumn, name ByteArray)
		self.pushDottedTargets(targets, name: name)
		self.pushIfPresent(targets, index: self.rootFreeFunctions, key: name)
	end 'pushBareTargets'

	function pushIfPresent(targets CsrColumn, index DeclNodeIndex, key ByteArray)
		if let node = try index.get(key) 'namesARecordedDeclaration'
			targets.push(node)
		end 'namesARecordedDeclaration'
	end 'pushIfPresent'
end 'DeclNodeSpace'

// ⭐⭐ **A DEFAULT VALUE IS A SYNTHESIZED NULLARY FUNCTION, AND THIS IS ITS NAME.**
// `function greet(name String = "World")` declares a second function, `__paramDefault#greet#0`, whose whole
// body is `return "World"`; a call site that omits the argument emits an ordinary call to it and passes the
// result. That is the ENTIRE mechanism, and everything it buys follows from "it is an ordinary call":
//
//   • **Ownership needs no new rule.** The compiler decides drops in the PARSER — a value materialized in a later
//     tier has no scope to be dropped from — so the default's value has to be born at the call site, and a
//     call RESULT is a shape the parser already owns and drops (`enrolOwnedCallTemp`). There is no late
//     refcount inserter, so a lowering-minted `String` would leak.
//   • **The default's EXPRESSION is parsed exactly once, in the file that declares it**, by the ordinary
//     expression parser, against the ordinary scope rules. A call site in ANOTHER FILE could not re-parse
//     it in any case: a compiler parse is a pure function of one file's `(tokens, filePath, namespace)`, which
//     is precisely what makes the per-file fan-out possible.
//   • **Dead-function elimination, the linker and the type checker all see it for free**, because they see
//     a `MaxonOp.call`.
//
// ⚠ **A HELPER IS COMPILED ONCE, AT THE DECLARATION, SO IT CANNOT SEE THE CALL SITE — WHICH IS WHY
// CALLER-LOCATION DEFAULTS ARE A SECOND MECHANISM BESIDE IT AND NOT AN ARM OF IT.** `__line__` /
// `__file__` (`specs/source-location-defaults.md`) need the default materialized AT THE CALLER from
// caller-side facts, which is not the same as being inexpressible: they are expressed by NOT minting a
// helper. The sweep publishes
// `ParamDefaultProducer.callerLine` / `.callerFile` at that slot and the fill emits a `literal` /
// `stringLiteral` op at the call — the very ops the caller would have emitted had it written the value
// out. So the two doors meet at `ParamDefaultProducer` and share everything downstream of it (the
// call-aligned slotting, the label, the arity gate), and differ only in what produces
// the value.
//
// ⚠ There is no constant fast path. One mechanism means one place a default's value is produced: a
// constant arm would have to re-derive literal emission — String interning, array construction, enum
// tagging, ranged and float alias widening — at the CALL SITE, in a second writer, for a value the
// declaring file's own parser already types correctly against the parameter's declared type. The cost is
// one `call`/`ret` per OMITTED argument, which no hot path in a real program pays.
//
// The name is minted by `Project.paramDefaultHelperName` (there, so the `#` join keeps its one speller).
//
// ⭐⭐ **WHAT PRODUCES ONE PARAMETER'S DEFAULT VALUE AT A CALL SITE — the per-slot fact the whole-program
// index publishes, and the meeting point of the language's two default doors.**
//
//   • `required` — the parameter declares no default; a call that omits it is E3036.
//   • `helper(name)` — the synthesized nullary function above. The call emits a `call` to it.
//   • `callerLine` / `callerFile` — a CALLER-LOCATION default. Nothing is synthesized and nothing is
//     called: the fill emits the constant the caller's own position names.
//
// ⚠ **IT IS A UNION AND NOT A NAME-OR-EMPTY.** A `ByteArray` column can say "helper" and "no
// default" but has no third thing to say, and the two candidate encodings for a third are a
// sentinel name (a tag hidden inside a value) or a second parallel column (one fact written twice,
// free to disagree with the first about whether a slot defaults at all). The union makes the three
// answers exhaustive, so every reader must `match` and none can fall through to reading a
// caller-location slot as "no default".
// ⚠ **THE THREE ARMS THAT SYNTHESIZE NOTHING ARE DECLARED FIRST AND CONTIGUOUSLY**, so the readers that
// care only whether a slot OWNS A FUNCTION — `renameContestedParamDefaultHelpers`, and any future
// walk of the synthesized set — say `required to callerFile` in one arm rather than listing the
// three and being free to forget the one added next.
export union ParamDefaultProducer
	required
	callerLine
	callerFile
	helper(name immutable ByteArray)
end 'ParamDefaultProducer'

