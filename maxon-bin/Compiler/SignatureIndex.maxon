// ⭐ **WHICH RUNTIME ENTRY DROPS A MANAGED FIELD OF DECLARED TYPE `fieldType`** — the ONE router shared by
// the parser's value-keyed `decrefCalleeFor` (a top-level owned value's drop) and the struct/union
// destructor cascade (each managed field's drop), so a field moved IN through one classifier is dropped
// through the matching callee and cannot leak (missed drop) or double-free (wrong drop). It generalises the
// union cascade's `StrDecrefName if isString else MmDecrefName` line, which could not reach a nested managed
// struct/union: a `String` drops via `__str_decref`; a struct or boxed union that itself owns managed heap
// drops via ITS `__destruct_<T>` cascade; a scalar-only struct or scalar-only union box takes the trivial
// `__mm_decref` (its box is all it owns).
//
// `typeNames` resolves a `named`/`structRef` field id to a NAME; pass the interner the field type's ids live
// in (the file artifact interner at a construct/extract site, `project.typeNames` at the synthesis site).
// The field is a precondition MANAGED one — every caller asks `structFieldIsManaged`/`payloadClassIsManaged`
// first, so a scalar reaching here is a classification drift and panics rather than mis-routing.
function managedFieldDropCallee(signatures ProgramSignatures, typeNames TypeNameInterner, fieldType MaxonType) returns immutable ByteArray
	// ⭐⭐ **ASKED FIRST, AND ASKED OF THE TYPE RATHER THAN THE TAG, BECAUSE A PROMISE FIELD IS USUALLY
	// SPELLED BY AN ALIAS.** `var p as IntPromise` reaches here tagged `named`, not `genericInstance`, so the
	// instance arm below cannot see it and the cascade would resolve it as an aggregate name and hand back a
	// `__destruct_<T>` for a record that does not exist. `typeIsAGreenThreadHandle` resolves both spellings —
	// the same two-spellings trap `typeIsManaged`'s `genericAlias` arm carries in prose.
	if signatures.typeIsAGreenThreadHandle(fieldType, from: typeNames) 'aGreenThread'
		return GtPromiseDropName
	end 'aGreenThread'

	let tag = maxonTypeTag(fieldType)

	// ⚠ `tagIsByteRecord`: WHICH DROP a field takes is a question about its record, and a Character's record
	// is a String's. Spelled `tagIsText` a Character field falls through to the named/struct arm and drops
	// through the wrong callee.
	if tagIsByteRecord(tag) 'byteRecord'
		return StrDecrefName
	end 'byteRecord'

	// A nested generic-INSTANCE field (`Box with (Box with String)`) is an owned base-struct box:
	// it drops through ITS OWN `__destruct_<instance>` cascade when the instance owns managed heap, else the
	// trivial `__mm_decref` — resolved inside `signatures` over its own registry/interner (a gid is not an
	// interner id), exactly as a struct/union field name is resolved through `managedNameDropCallee`.
	if tag == ValueTypeTag.genericInstance 'instance'
		return signatures.genericInstanceBoxDropCallee(genericInstanceIdOf(fieldType))
	end 'instance'

	if tag == ValueTypeTag.function 'aFunctionValue'
		return MmDecrefName
	end 'aFunctionValue'

	// ⛔ **AN EXISTENTIAL FIELD HAS NO STATIC DROP CALLEE, AND THAT IS THE WHOLE POINT OF IT.** Its
	// conformer — and so its destructor — is a run-time fact read out of the
	// witness table, so it is released by the 2-argument `__drop_existential(witness, value)` and never by a
	// name this 1-argument router could hand back. The cascades ask `structFieldIsExistential` /
	// `genericInstanceFieldIsExistential` BEFORE this (`FieldDropKind`), so reaching here means a drop site was
	// added that classifies the field managed and does not ask which KIND of managed it is — which would emit
	// `<callee>(valueHalf)` and dispatch the wrong conformer's destructor.
	if tag == ValueTypeTag.interfaceRef 'existential'
		panic("managedFieldDropCallee: a field declared at an interface type has no statically named drop callee — an existential is released through `__drop_existential(witness, value)` off the witness table's `destroyFunc@8`, so its drop site must route on `FieldDropKind` rather than ask this")
	end 'existential'

	if not (tagNamesADeclaredType(tag) or tag == ValueTypeTag.named) 'notManagedRef'
		panic("managedFieldDropCallee: a field of tag '{typeTagName(tag)}' is not a managed heap reference — every caller classifies the field managed first")
	end 'notManagedRef'

	// Resolved through `denotedAggregateName` HERE — the same tier its structural dual
	// `managedFieldCascadeStrategy` resolves at, and for the reason that door states. ⚠ Resolving it one
	// frame DOWN, at `managedNameDropCallee`'s head, makes the two duals structurally different
	// about one fact: the name-keyed clone helper panics on an alias spelling its drop twin accepts, and
	// the `isGenericAlias` test below reads the RAW name on one side and the RESOLVED one on the other —
	// agreeing only because a tuple alias is never also a generic alias, which nothing enforces. A value
	// cloned by one strategy is dropped by the callee the other returns, so the two must resolve at ONE tier.
	let name = signatures.denotedAggregateName(try typeNames.nameOf(typeNameIdOf(fieldType)) otherwise panic("managedFieldDropCallee: a managed field's type id is not in the interner it was resolved against — pass the interner the field type's ids live in"))
	return managedNameDropCallee(signatures, declaredName: name)
end 'managedFieldDropCallee'

// ⭐⭐⭐ **HOW A VALUE OF THIS DECLARED TYPE IS RETAINED — THE DUAL OF `managedNameDropCallee`.** A
// retain must acquire exactly what the matching drop releases. A `<T>.handle` box owns its cown
// share and gives it back from its own destructor (`CownRuntime.CownHandleDestructName`), so its
// retain is the plain box incref.
//
// ⭐⭐ **THE FIVE OS-RESOURCE AGGREGATES TAKE THE PLAIN BOX INCREF, AND THAT IS SYMMETRIC.** They are
// co-owned in ordinary programs (`file-io`, `managed-file`, `managed-directory`, `tcp-client`,
// `http-client`, `async-tcp`, `file-info` and more route here), so this arm may not refuse them.
//
// ⚠ **THE RETAIN AND THE DROP ARE ALREADY BALANCED, AND THE DROP IS WHERE TO CHECK IT.**
// `managedNameDropCallee` answers `__mf_destruct` / `__md_destruct` / `__ms_destruct` /
// `__prof_pages_destruct` / `__prof_handle_destruct` — each the **refcount-CHECKED** teardown (see its own
// bullet: *"the refcount-checked teardown that does both"*). It steps the count down and closes the handle
// only at zero, so one `__mm_incref` per co-owner is exactly its dual. Closing twice needs a drop that
// closes UNCONDITIONALLY, which none of these five has.
//
// A future aggregate whose drop releases more than the box owes an arm here, and it earns one by having that
// shape — not by owning an OS handle.
function managedNameRetainCallee(signatures ProgramSignatures, declaredName ByteArray, result RetainResult) returns immutable ByteArray
	return match compilerOwnedAggregateOf(signatures, name: declaredName) 'compilerOwned'
		// Kept apart from `userDeclared` below though the callee is the same: the five OS-resource arms answer
		// it because their destruct is refcount-checked, `serviceHandle` because its box's own destructor steps
		// the cown shares, `userDeclared` because a plain box is a plain box. Same answer, three different
		// reasons, and the day any of them changes only one arm should move.
		managedFile or
		managedDirectory or
		managedSocket or
		managedPages or
		managedHandle or
		managedPin or
		serviceHandle or
		userDeclared gives plainBoxRetainCallee(result)
	end 'compilerOwned'
end 'managedNameRetainCallee'

// ⭐⭐ **THE SHAPES A RETAIN IS ASKED FOR, AND WHY THE SHAPE IS AN ARGUMENT RATHER THAN A SECOND
// SELECTOR.** A retain is needed either for EFFECT — the caller already holds the box's ValueId — or for a
// FRESH SSA NAME of the same box, which is what a borrow promoted to an owned binding needs
// (`Parser.retainBorrowedAggregate`), or for a SHARED READ, whose caller uses the result as its own
// reference to a value that may be an immortal record. Which FAMILY of entries a value takes is one
// decision; which shape it is wanted in is another.
export enum RetainResult
	discarded
	freshName
	sharedRead
end 'RetainResult'

// A plain managed box has one entry per shape, because `__mm_incref` returns nothing.
function plainBoxRetainCallee(result RetainResult) returns immutable ByteArray
	return match result 'shape'
		discarded gives ownershipDoorName(OwnershipDoor.boxIncref)
		freshName or
		sharedRead gives ownershipDoorName(OwnershipDoor.boxRetain)
	end 'shape'
end 'plainBoxRetainCallee'

function stickyBoxRetainCallee(result RetainResult) returns immutable ByteArray
	return match result 'shape'
		discarded gives ownershipDoorName(OwnershipDoor.boxIncrefSticky)
		freshName or
		sharedRead gives ownershipDoorName(OwnershipDoor.boxRetainSticky)
	end 'shape'
end 'stickyBoxRetainCallee'

// The drop callee for a managed field NAMED `declaredName` — a declared struct or boxed union.
// Split from `managedFieldDropCallee` so a `structRef` (which is always a struct) and a `named`
// (struct or union) reach the same struct/union lookup once the name is in hand.
//
// ⚠ **IT TAKES NO INTERNER, AND MUST NOT.** Every question below is keyed by the NAME, and the two
// that need a layout (`structHasManagedField`, `unionHasManagedPayload`) fetch the index's OWN and
// read it over the index's OWN interner. Threading the caller's `typeNames` through to the union
// arm is how a `signatures` layout comes to be resolved against `project.typeNames` — see
// `unionHasManagedPayload`.
//
// ⚠ **THE NAME IS ALREADY DENOTED** — `managedFieldDropCallee` put it through
// `denotedAggregateName`, exactly as `managedFieldCascadeStrategy` does for
// `managedNameCascadeStrategy`, so a tuple typealias (which names the tuple's own struct and
// nothing else) is a canonical tuple name by the time it arrives. The two duals resolve at ONE tier
// so a name cannot be a struct on the drop side and an undeclared panic on the clone side.
function managedNameDropCallee(signatures ProgramSignatures, declaredName ByteArray) returns immutable ByteArray
	// ⭐⭐ **A COMPILER-OWNED AGGREGATE TAKES A COMPILER-OWNED DROP, AND IS ASKED BEFORE THE DECLARED-STRUCT
	// LOOKUP.** Each has a REGISTERED layout — they need a nominal identity — so the generic route below
	// would answer `__destruct_<T>`, a symbol `installStructDestructors` never builds, because it walks
	// `project.structTypes` and a synthesized type is in no file's declarations. A link failure rather than a
	// wrong answer, but the honest fix is to say which drop each type takes:
	//
	//   • **`__ManagedFile` OWNS AN OS HANDLE, WHICH IS NOT MEMORY — SO ITS DROP MUST CLOSE, NOT JUST FREE**
	//     (this arm IS the RAII destructor). It could not be the cascade, and that was measured
	//     rather than assumed: `_handle` is a scalar `int` field, so `structFieldIsManaged` is false and
	//     `installStructDestructors` skips the type outright. Widening "managed field" to cover it would be a
	//     lie every other reader of that predicate would act on, and `emitNullGuardedDrop`'s shape is wrong for
	//     it anyway — it loads the FIELD and calls `callee(field)`, while a close needs the BOX (it zeroes
	//     `_handle` to stay idempotent). `__mf_destruct(box)` is the refcount-checked teardown that does both.
	//     ⇒ Answering `MmDecrefName` frees the eight bytes and leaks the OS handle
	//     for the process lifetime, invisibly to the exit-101 gate, because a handle is not memory. ONE arm
	//     covers both doors: a `var f as __ManagedFile` FIELD through the struct cascade, and a top-level
	//     `let f = __ManagedFile.openRead(…)` through `Parser.decrefCalleeFor`'s `structRef` arm.
	//   • **`__ManagedDirectory` OWNS A SEARCH HANDLE *AND* A SECOND ALLOCATION**, so its drop must
	//     close the search and free the find block. Every argument the file bullet makes applies unchanged, and
	//     `MmDecrefName` here would free eight bytes and leak BOTH the 336-byte block and the OS search handle
	//     — the second of which the exit-101 gate cannot see at all.
	//
	// ⚠ **THE NAMES ARE `compilerOwnedAggregateOf`'s, NOT THIS FUNCTION'S.** Spelled here and nowhere else,
	// they are missing from the CLONE twin, which owes the identical question: it answers
	// `__clone___ManagedFile`, a symbol nothing builds, and the backend panics on a
	// compilable program. One list, three doors.
	match compilerOwnedAggregateOf(signatures, name: declaredName) 'compilerOwned'
		managedFile then return ManagedFileDestructName
		managedDirectory then return ManagedDirectoryDestructName

		//   • **`__ManagedSocket` OWNS AN OS SOCKET, WHICH IS NOT MEMORY** — the file bullet's argument
		//     unchanged, one type over. `MmDecrefName` here would free eight bytes and leak the socket for the
		//     process lifetime, which the exit-101 gate cannot see at all.
		managedSocket then return ManagedSocketDestructName

		//   • **`__ManagedPages`, `__ManagedHandle` AND `__ManagedPin` OWN A PAGE RESERVATION, AN OS HANDLE AND A
		//     MACHINE PIN, NONE OF WHICH IS MEMORY THE BOX FREE RETURNS** — the file bullet's argument, one type
		//     over each.
		managedPages then return ProfilePagesDestructName
		managedHandle then return ProfileHandleDestructName
		managedPin then return GtPinDestructName

		//   • A `<T>.handle` takes the plain decref: its box is minted with `__cown_handle_destruct` as its
		//     destructor, which steps the cown's `handles` and `refs` shares when the box's own count reaches
		//     zero.
		serviceHandle then return MmDecrefName
		userDeclared then break
	end 'compilerOwned'

	// ⭐⭐ **AN INSTANCE ALSO ARRIVES AS ITS OWN CANONICAL RENDERING, AND `declaredNameIsManaged` ALREADY SAID
	// SO — THIS IS THE ROUTER THAT HAD TO AGREE.** That door answers `true` for `UpCursor_Integer` by
	// asking `isCanonicalInstanceName` FIRST, precisely because no registry is keyed by a canonical mint; the
	// drop it thereby promises was never routed, so the walk below fell through to the `otherwise panic` on a
	// program the classification had already accepted. MEASURED: a conformer widened into a held existential
	// whose binding is a generic instance took the compile down at
	// `existentialDestroyCallee` → here, on `stdlib/Array.maxon`'s own conformance shape. The answer is the
	// `genericAlias` arm's, on the same gid — an instance box drops the same way whichever spelling named it.
	//
	// ⚠ It reads AHEAD of `declaredFormOf` and still cannot outrank a declaration, because the precedence is
	// in the DOOR: `renderedInstanceOfUnclaimedName` refuses a spelling any declaration claims. Asked the
	// other way round it routed `type Box_String`'s cascade through `Box with String`'s — see there.
	if let rendered = try signatures.renderedInstanceOfUnclaimedName(declaredName) 'aRenderedInstance'
		return signatures.genericInstanceBoxDropCallee(rendered)
	end 'aRenderedInstance'

	let form = try signatures.declaredFormInAnyFile(declaredName) otherwise panic("managedNameDropCallee: managed field '{String.from(declaredName)}' is declared by no registry — the caller classified it managed, and every managed non-String form is a declared struct, a boxed union or a generic-alias instance")

	match form 'form'
		structType then return structBoxDropCallee(signatures, structName: declaredName)

		// ⭐ **BY NAME, exactly as the struct arm is** — and through the SAME `unionBoxDropCallee` a boxed
		// union's scope-exit drop takes, so a union FIELD and a union BINDING cannot be dropped through
		// different callees. See `unionHasManagedPayload` for the reachable compiler panic the
		// layout-and-foreign-interner spelling this replaces produced.
		enumType or
		unionType then return signatures.unionBoxDropCallee(declaredName)

		// An INTERFACE NAME reaching a 1-argument drop router is the `managedFieldDropCallee` guard's case one
		// resolution further down: an existential is released through `__drop_existential(witness, value)`,
		// which this cannot express. Both type registries tag an interface annotation `interfaceRef` (the real
		// parse mints it; `normalizeSweptInterfaceTypes` re-tags the sweep's), so a bare `named` interface here
		// means a THIRD producer of slot types exists that neither does.
		interfaceType then panic("managedNameDropCallee: '{String.from(declaredName)}' is an interface, and an existential is released through `__drop_existential(witness, value)` rather than by any name this router can return — a slot reaching here carries a bare `named` that neither type registry re-tagged `interfaceRef`")

		// A ranged alias IS its primitive and owns no record, so it cannot have been classified managed.
		rangedAlias then panic("managedNameDropCallee: '{String.from(declaredName)}' is a ranged typealias — a scalar, which `typeIsManaged` never classifies managed")
		functionAlias then return MmDecrefName

		// ⭐ A GENERIC-INSTANCE-alias field (an `Array`, a `Box`) arrives as a `named` — the sweep recorded
		// the layout before the alias interned — and takes the instance box drop callee (`__managed_decref` for
		// an `Array`, `__mm_decref`/`__destruct_<T>` for a struct box), exactly as a re-tagged
		// `genericInstance` field does. The gid is `signatures`' own, needing no interner.
		genericAlias then return signatures.genericInstanceBoxDropCallee(signatures.genericAliasInstanceInAnyFile(declaredName))

		// A tuple alias names the tuple's own struct and nothing else, and `denotedAggregateName` has already
		// resolved it to that name upstream — so this arm is reached only if that resolution is narrowed, and
		// a tuple box drops exactly as any other struct box does.
		tupleAlias then return structBoxDropCallee(signatures, structName: signatures.tupleAliasTargetInAnyFile(declaredName))
	end 'form'
end 'managedNameDropCallee'

// Which entry drops an owned box of the declared STRUCT `structName`: its `__destruct_<T>` cascade when it
// owns managed heap, the trivial `__mm_decref` when its box is all it owns. Split out so the struct arm and
// the tuple arm of the cascade above cannot come to answer it differently — a tuple IS a struct box.
function structBoxDropCallee(signatures ProgramSignatures, structName ByteArray) returns immutable ByteArray
	// ⛔ **`structHasFieldOwingDrop`, NOT `structHasManagedField`** — the ownership question
	// `installOneStructDestructor` asks. Asked the managed question, a `type Holder { let p as
	// IntPromise }` routes its box drop to the trivial `__mm_decref`, `__destruct_Holder` is never
	// entered into `needed`, and the promise is never dropped.
	if signatures.structHasFieldOwingDrop(structName) 'owesADestructor'
		return destructorSymbol(structName)
	end 'owesADestructor'

	return MmDecrefName
end 'structBoxDropCallee'

// Which cascade a full-graph gate is asked about.
enum GraphCascadePurpose
	deepClone

	// The graph a send moves: it admits an OS socket, whose box count is the proof of its one owner.
	send

	// The graph a share walk marks: an OS socket is refused, because one owner closes it.
	shareWalk

	// Lets a function value through, which no transfer may do: asked only to word a refused transfer —
	// would the graph cross if not for its function values?
	sendPastFunctionValues
	shareWalkPastFunctionValues

	// `deepClone` that also refuses any green thread it reaches: asked only of a source-level copy.
	// Kept apart because `deepClone` also gates cloner synthesis program-wide, and refusing a promise
	// there would refuse unrelated types that merely reach the same classifier.
	sourceClone
end 'GraphCascadePurpose'

function cascadeAnswerMapFor(purpose GraphCascadePurpose, deepClone DeepCloneAnswerMap, shareWalk DeepCloneAnswerMap) returns DeepCloneAnswerMap
	return match purpose 'purpose'
		deepClone gives deepClone
		shareWalk gives shareWalk
		send or
		sendPastFunctionValues or
		shareWalkPastFunctionValues or
		sourceClone panic("cascadeAnswerMapFor: this walk's answer is never memoized")
	end 'purpose'
end 'cascadeAnswerMapFor'

function purposeCrossesAFunctionValue(purpose GraphCascadePurpose) returns bool
	return match purpose 'purpose'
		deepClone or
		sendPastFunctionValues or
		shareWalkPastFunctionValues or
		sourceClone gives true
		send or
		shareWalk gives false
	end 'purpose'
end 'purposeCrossesAFunctionValue'

enum ExistentialGate
	walkedThroughTheWitness
	everyConformerSendable
	everyConformerCloneable
end 'ExistentialGate'

function purposeGatesAnExistential(purpose GraphCascadePurpose) returns ExistentialGate
	return match purpose 'purpose'
		shareWalk or
		shareWalkPastFunctionValues gives ExistentialGate.walkedThroughTheWitness
		send or
		sendPastFunctionValues gives ExistentialGate.everyConformerSendable
		deepClone or
		sourceClone gives ExistentialGate.everyConformerCloneable
	end 'purpose'
end 'purposeGatesAnExistential'

function purposeRefusesAGreenThread(purpose GraphCascadePurpose) returns bool
	return match purpose 'purpose'
		sourceClone gives true
		deepClone or
		send or
		shareWalk or
		sendPastFunctionValues or
		shareWalkPastFunctionValues gives false
	end 'purpose'
end 'purposeRefusesAGreenThread'

function purposeAdmitsAnOsSocket(purpose GraphCascadePurpose) returns bool
	return match purpose 'purpose'
		send or
		sendPastFunctionValues gives true
		deepClone or
		shareWalk or
		shareWalkPastFunctionValues or
		sourceClone gives false
	end 'purpose'
end 'purposeAdmitsAnOsSocket'

export enum TransferKind
	send
	share
end 'TransferKind'

function transferPurposeOf(kind TransferKind, pastFunctionValues bool) returns GraphCascadePurpose
	return match kind 'kind'
		send gives GraphCascadePurpose.sendPastFunctionValues if pastFunctionValues else GraphCascadePurpose.send
		share gives GraphCascadePurpose.shareWalkPastFunctionValues if pastFunctionValues else GraphCascadePurpose.shareWalk
	end 'kind'
end 'transferPurposeOf'

enum SourceCloneVerdict
	cloneable
	holdsAGreenThread
	holdsAnUncloneable
end 'SourceCloneVerdict'

// Asked only once the `sourceClone` walk has refused: the two walks differ only in refusing a green
// thread, so a type `deepClone` accepts was refused for one.
function refusedSourceCloneVerdict(deepCloneable bool) returns SourceCloneVerdict
	return SourceCloneVerdict.holdsAGreenThread if deepCloneable else SourceCloneVerdict.holdsAnUncloneable
end 'refusedSourceCloneVerdict'

// A conformer's strategy as the word a witness table holds for `action`. `asElement: true` upstream means a
// type the action serves always answers `direct`, so an entry taking an element walk is an invariant break;
// `unsupported` is a conformer the action cannot be built for, which the table answers with the abort entry.
function witnessCascadeCalleeOf(strategy ManagedCascadeStrategy, action CascadeAction) returns immutable ByteArray
	match strategy 'strategy'
		direct(callee) then return callee
		unsupported then return cascadeUnsupportedEntry(action)
		managedElements then panic("witnessCascadeCalleeOf: a conformer's cascade resolved to a `managedElements` strategy, where `asElement: true` resolves to the thunk")
		throughWitness then panic("witnessCascadeCalleeOf: a conformer's cascade resolved to a witness-read entry — a conformer is a concrete type, never a value held at an interface")
	end 'strategy'
end 'witnessCascadeCalleeOf'

function cascadeUnsupportedEntry(action CascadeAction) returns immutable ByteArray
	return match action 'action'
		clone gives MmCloneUncloneableName
		shareWalk gives MmWalkUnwalkableName
	end 'action'
end 'cascadeUnsupportedEntry'

// ⭐⭐ **WHICH PER-TYPE CASCADE IS BEING ROUTED — the ONE parameter that turns this classification into one
// per action.** The tree below answers *"what KIND of managed thing is this, and which entry serves it?"*; the
// kind half is identical for every action and the entry half is not, so an action is threaded through rather
// than the tree being written once per action. A second copy of it would be free to disagree about which types
// it can route at all — and the `unsupported` arms are exactly what the front-end gate reads.
//
// A gate and a strategy that disagree is a symbol nobody builds (see `managedNameCascadeStrategy`).
export enum CascadeAction
	// The `(box) -> newBox` deep copy.
	clone

	// The `(box)` share walk — mark every reachable record shared, so the graph may be LENT to another green
	// thread and counted atomically from then on.
	shareWalk
end 'CascadeAction'

// The BYTE-RECORD entry for `action`. A String and a Character are the same fused record, so both clone
// through `__str_clone` and both walk through the container walks that own that record format.
function byteRecordCascadeCallee(action CascadeAction) returns immutable ByteArray
	return match action 'action'
		clone gives StrCloneName
		shareWalk gives ManagedShareName
	end 'action'
end 'byteRecordCascadeCallee'

// The per-TYPE entry for `action` — `__clone_<T>` or `__share_<T>`, the symbols `MmRuntime`
// mints and the installers synthesize.
function perTypeCascadeSymbol(action CascadeAction, typeName ByteArray) returns immutable ByteArray
	return match action 'action'
		clone gives clonerSymbol(typeName)
		shareWalk gives shareWalkSymbol(typeName)
	end 'action'
end 'perTypeCascadeSymbol'

// The SERVICE HANDLE entry for `action`. A handle CLONES into a second handle to the same service; its walks
// are nothing but its box's count, because the box holds one machine word and no managed field — so it takes
// the shared leaf rather than a synthesized walk no installer would build for it.
function serviceHandleCascadeCallee(action CascadeAction, clone immutable ByteArray) returns immutable ByteArray
	return match action 'action'
		clone gives clone
		shareWalk gives MmShareBoxName
	end 'action'
end 'serviceHandleCascadeCallee'

function serviceHandleClonerOf(signatures ProgramSignatures, handleName ByteArray) returns immutable ByteArray
	return CownInterfaceCloneBoxName if signatures.isInterfaceHandle(handleName) else CownHandleCloneBoxName
end 'serviceHandleClonerOf'

export union UncloneableExistentialSlot
	none
	slot(structName immutable ByteArray, fieldName immutable ByteArray, interfaceName immutable ByteArray, conformerName immutable ByteArray)
end 'UncloneableExistentialSlot'

union ConformerCloneBlame
	none
	conformer(name immutable ByteArray)
end 'ConformerCloneBlame'

union UnsendableConformer
	none
	conformer(name immutable ByteArray)
end 'UnsendableConformer'

export type CascadeWalkBreak
	export let reached as bool
	export let depth as ElementIndex

	static function nothingBroke() returns Self
		return Self{reached: false, depth: 0}
	end 'nothingBroke'

	static function atDepth(value ElementIndex) returns Self
		return Self{reached: true, depth: value}
	end 'atDepth'

	function shallowerOf(other CascadeWalkBreak) returns CascadeWalkBreak
		if not self.reached 'nothingBrokeHere'
			return other
		end 'nothingBrokeHere'

		if not other.reached 'nothingBrokeThere'
			return self
		end 'nothingBrokeThere'

		if self.depth < other.depth 'thisIsShallower'
			return self
		end 'thisIsShallower'

		return other
	end 'shallowerOf'

	function restsWithin(walkDepth ElementIndex) returns bool
		return not self.reached or self.depth >= walkDepth
	end 'restsWithin'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.flag(self.reached)
		writer.unsigned(self.depth as CacheUnsigned)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns CascadeWalkBreak throws LibraryCacheDamage
		let f_reached = try reader.flag()
		let f_depth = (try reader.unsigned()) as ElementIndex

		return Self{reached: f_reached, depth: f_depth}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(CascadeWalkBreak) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'CascadeWalkBreak'

type GrowthStep
	export let base as immutable ByteArray
	export let args as MaxonTypeArray

	static function create(base ByteArray, args MaxonTypeArray) returns Self
		return Self{base: base, args: args}
	end 'create'
end 'GrowthStep'

typealias GrowthPath = Array with GrowthStep

export type CascadeWalkFrame
	export let depth as ElementIndex
	export let enclosingRead as bool
	export let enclosingBreak as CascadeWalkBreak

	static function create(depth ElementIndex, enclosingRead bool, enclosingBreak CascadeWalkBreak) returns Self
		return Self{depth: depth, enclosingRead: enclosingRead, enclosingBreak: enclosingBreak}
	end 'create'
end 'CascadeWalkFrame'

union OwnedOsHandle
	none
	handle(name immutable ByteArray)
	pin(name immutable ByteArray)
end 'OwnedOsHandle'

// ⭐ **HOW A MANAGED FIELD OF DECLARED TYPE `fieldType` IS CLONED OR PROVED SOLE.** The exact STRUCTURAL DUAL
// of `managedFieldDropCallee`: a value cloned through the strategy this returns is dropped through the callee
// `managedFieldDropCallee` returns for the SAME type, so the cloned set and the dropped set agree by
// construction (a clone leaks if it is not dropped, double-frees if it is dropped twice — one classifier
// decides both). The compiler is move-only, so an independent copy is a per-element DEEP CLONE, never an incref — and
// a MOVE across a green thread is that same graph walked for owners rather than copied.
export union ManagedCascadeStrategy
	// A `(box) -> newBox` clone callee invocable by a plain 1-arg call OR through `callIndirect(fn, box)` (a
	// `funcAddr`): a String → `__str_clone`; a struct / boxed union → its `__clone_<T>` (managed OR scalar-only
	// — a fresh box is needed either way, where the drop side takes `__mm_decref` for a scalar-only box); a
	// TRIVIAL-element Array → `__managed_clone`, TRIVIAL-element chain → `__list_clone` (each duplicates the
	// record's words, and the result is independently droppable). This is the ONLY strategy an ARRAY ELEMENT may
	// carry, because an element cloner is invoked through `callIndirect(fn, elem)`.
	direct(callee immutable ByteArray)

	// ⭐ A MANAGED-element CONTAINER FIELD: `containerClone(field, funcAddr(elementClone))`, where `containerClone`
	// is the container's own per-element copy entry (`__managed_clone_managed` for the record,
	// `__list_clone_managed` for the chain) and `elementClone` is the element's own `direct` clone callee.
	// A 2-arg call, so it is carried only in a struct/union/instance FIELD, where the synthesized cascade body
	// emits the funcAddr and makes the call inline. An ARRAY ELEMENT is invoked through `callIndirect(fn, elem)`
	// and so must be `direct` — it reaches this same call through the container instance's own
	// one-argument thunk, whose entire body IS it (`managedElementRecordCopy`).
	//
	// ⚠ **THE CONTAINER'S ENTRY IS A PAYLOAD RATHER THAN A SECOND CASE**, and that is what keeps the chain from
	// duplicating the record's arm: `emitCloneCall`, `emitWalkCall` and `noteFieldCascadeNeeds` each carry ONE arm for this shape,
	// and a third element-bearing container would add a caller here rather than a case, three emitters and a
	// usage-closure arm.
	managedElements(containerEntry immutable ByteArray, elementEntry immutable ByteArray)

	// Not deep-cloneable by any strategy above — a compiler-owned aggregate (`__ManagedFile`), a
	// base-layout-less generic instance with no runtime copy of its own (a cursor), a container ELEMENT held at
	// an interface type, or a container whose element is not itself `direct` (an array of OS handles). The front end
	// rejects such an element with a positioned E2015.
	unsupported

	// ⭐ An INTERFACE-TYPED field's cascade: `entry(witness, value, …)`, the witness read from the field's
	// second slot (`IrInterface.InterfaceWitnessHalfOffset`) — `__mm_share_existential`
	// / `__mm_clone_existential`, each calling what the conformer's witness table names for that action. It
	// needs the witness beside the value, so a FIELD position only.
	throughWitness(entry immutable ByteArray)
end 'ManagedCascadeStrategy'

// What a graph handed to another green thread is, as far as walking it goes.
export union TransferSubject
	// A String or a Character: its bytes can be viewed, and a view is an owner no compile-time fact sees.
	byteRecord
	instance(id GenericInstanceId)
	existential(interfaceName immutable ByteArray)
	opaqueParameter

	// A managed value whose record carries no name to read its layout by.
	nameless
	functionValue
	aggregate(name immutable ByteArray)
end 'TransferSubject'

// How a graph is made safe to hand to another green thread (`ProgramSignatures.transferWalkOf`).
export union TransferWalk
	// A move of a record holding no reference to a second counted record: its one owner is a compile-time fact.
	closed

	// `callee(value)` marks the graph shared.
	walkedBy(callee immutable ByteArray)

	// `entry(witness, value)` walks a value held at an interface type through the walk its witness table
	// names for the conformer it holds.
	walkedThroughWitness(entry immutable ByteArray)

	// No walk can be built for this shape, and `noun` says what the shape is.
	refused(noun String)
end 'TransferWalk'

// The subject a value of `tag` is walked as. `typeNames` is the interner `nameId` was minted from.
function transferSubjectOf(tag ValueTypeTag, nameId TypeNameId, typeNames TypeNameInterner) returns TransferSubject
	if tagIsByteRecord(tag) 'aByteRecord'
		return TransferSubject.byteRecord
	end 'aByteRecord'

	if tag == ValueTypeTag.genericInstance 'aContainer'
		return TransferSubject.instance(nameId as GenericInstanceId)
	end 'aContainer'

	if tag == ValueTypeTag.interfaceRef 'anExistential'
		return TransferSubject.existential(try typeNames.nameOf(nameId) otherwise panic("transferSubjectOf: type-name id {nameId} is not in the interner it was minted from"))
	end 'anExistential'

	if tag == ValueTypeTag.typeParameter 'opaque'
		return TransferSubject.opaqueParameter
	end 'opaque'

	if tag == ValueTypeTag.function 'aFunctionValue'
		return TransferSubject.functionValue
	end 'aFunctionValue'

	if not tagNamesADeclaredType(tag) and tag != ValueTypeTag.named 'namesNoRecord'
		return TransferSubject.nameless
	end 'namesNoRecord'

	return TransferSubject.aggregate(try typeNames.nameOf(nameId) otherwise panic("transferSubjectOf: type-name id {nameId} is not in the interner it was minted from"))
end 'transferSubjectOf'

// The per-type walk a gate admitted, read as a transfer. `asElement: true` resolves a managed-element container to
// its one-argument thunk, so a two-argument strategy is an invariant break rather than a program.
function transferWalkFrom(strategy ManagedCascadeStrategy, display String) returns TransferWalk
	return match strategy 'strategy'
		direct(callee) gives TransferWalk.walkedBy(callee)
		managedElements panic("transferWalkFrom: `{display}` resolved to a two-argument `managedElements` strategy, where `asElement: true` resolves to the one-argument thunk")
		throughWitness panic("transferWalkFrom: `{display}` resolved to a witness-read walk, which only a FIELD held at an interface type takes")
		unsupported gives unwalkableTransfer(display, kind: TransferKind.share, onlyFunctionValuesBlockIt: false)
	end 'strategy'
end 'transferWalkFrom'

// `__mm_clone_existential` / `__mm_share_existential`: the entry that reads a witness table's word for `action`.
function existentialCascadeEntry(action CascadeAction) returns immutable ByteArray
	return match action 'action'
		clone gives MmCloneExistentialName
		shareWalk gives MmShareExistentialName
	end 'action'
end 'existentialCascadeEntry'

// A byte record is walked on both hand-offs: a view counts the record its inline bytes live in, or the grown buffer
// it owns, and neither count is visible to a compile-time question.
function byteRecordTransferWalk(kind TransferKind) returns TransferWalk
	return match kind 'kind'
		send gives TransferWalk.closed
		share gives TransferWalk.walkedBy(byteRecordCascadeCallee(CascadeAction.shareWalk))
	end 'kind'
end 'byteRecordTransferWalk'

function unwalkableTransfer(display String, kind TransferKind, onlyFunctionValuesBlockIt bool) returns TransferWalk
	if onlyFunctionValuesBlockIt 'aFunctionValueBlocksIt'
		return TransferWalk.refused("a `{display}` whose graph reaches {FunctionValueCrossingNoun}")
	end 'aFunctionValueBlocksIt'

	return TransferWalk.refused("a `{display}` whose graph reaches {unsendableShapes(kind)}")
end 'unwalkableTransfer'

function unsendableShapes(kind TransferKind) returns String
	return match kind 'kind'
		send gives "an OS handle other than a socket, or a base-struct-less generic instance, which cannot cross to another green thread"
		share gives "a type this compiler synthesizes no per-type walk for — an OS handle or a base-struct-less generic instance"
	end 'kind'
end 'unsendableShapes'

// The clone strategy for a managed field of declared type `fieldType`. Mirrors `managedFieldDropCallee`'s
// dispatch exactly: `typeNames` resolves a `named`/`structRef` id to a NAME; pass the interner the field
// type's ids live in (the file artifact interner at a call site, `project.typeNames` at the synthesis site).
// The field is a precondition MANAGED one, so a scalar reaching here is a classification drift and panics.
function managedFieldCascadeStrategy(signatures ProgramSignatures, typeNames TypeNameInterner, fieldType MaxonType, asElement bool, action CascadeAction) returns ManagedCascadeStrategy
	let tag = maxonTypeTag(fieldType)

	// `tagIsByteRecord`, mirroring `managedFieldDropCallee`: a Character clones by the same fused-record
	// deep copy a String does, because it IS one.
	if tagIsByteRecord(tag) 'byteRecord'
		return ManagedCascadeStrategy.direct(byteRecordCascadeCallee(action))
	end 'byteRecord'

	if tag == ValueTypeTag.genericInstance 'instance'
		return instanceCascadeStrategy(signatures, id: genericInstanceIdOf(fieldType), asElement: asElement, action: action)
	end 'instance'

	if tag == ValueTypeTag.interfaceRef 'existential'
		return ManagedCascadeStrategy.throughWitness(existentialCascadeEntry(action))
	end 'existential'

	if tag == ValueTypeTag.function 'aFunctionValue'
		return functionValueCascadeStrategy(action)
	end 'aFunctionValue'

	if not (tagNamesADeclaredType(tag) or tag == ValueTypeTag.named) 'notManagedRef'
		panic("managedFieldCascadeStrategy: a field of tag '{typeTagName(tag)}' is not a managed heap reference — every caller classifies the field managed first")
	end 'notManagedRef'

	// Resolved through `denotedAggregateName` for `managedFieldDropCallee`'s reason, and it must be the SAME
	// resolution: a value cloned by this strategy is dropped by the callee that one returns, so a name the two
	// resolved differently would clone one type and drop another.
	let name = signatures.denotedAggregateName(try typeNames.nameOf(typeNameIdOf(fieldType)) otherwise panic("managedFieldCascadeStrategy: a managed field's type id is not in the interner it was resolved against — pass the interner the field type's ids live in"))
	return managedNameCascadeStrategy(signatures, declaredName: name, asElement: asElement, action: action)
end 'managedFieldCascadeStrategy'

function slotCascadeStrategy(signatures ProgramSignatures, typeNames TypeNameInterner, fieldType MaxonType, capability ParamCapability, action CascadeAction) returns ManagedCascadeStrategy
	if action == CascadeAction.clone and capability == ParamCapability.immutable and frozenRecordIsSharedNotCopied(signatures, typeNames: typeNames, type: fieldType) 'immutableDataIsShared'
		return ManagedCascadeStrategy.direct(MmRetainName)
	end 'immutableDataIsShared'

	return managedFieldCascadeStrategy(signatures, typeNames: typeNames, fieldType: fieldType, asElement: false, action: action)
end 'slotCascadeStrategy'

function frozenRecordIsSharedNotCopied(signatures ProgramSignatures, typeNames TypeNameInterner, type MaxonType) returns bool
	let tag = maxonTypeTag(type)

	if tag == ValueTypeTag.genericInstance 'anInstance'
		let id = genericInstanceIdOf(type)
		return not signatures.instanceBaseIsServiceHandle(id) and not signatures.genericInstanceIsImmutable(id)
	end 'anInstance'

	if not (tagNamesADeclaredType(tag) or tag == ValueTypeTag.named) 'textOrScalarOrWitnessOrFunction'
		return false
	end 'textOrScalarOrWitnessOrFunction'

	let name = signatures.denotedAggregateName(try typeNames.nameOf(typeNameIdOf(type)) otherwise panic("frozenRecordIsSharedNotCopied: a managed slot's type id is not in the interner it was resolved against"))
	return not signatures.isAnyServiceHandle(name) and not signatures.aggregateTypeIsImmutable(name)
end 'frozenRecordIsSharedNotCopied'

function functionValueCascadeStrategy(action CascadeAction) returns ManagedCascadeStrategy
	return match action 'action'
		clone gives ManagedCascadeStrategy.direct(MmRetainName)
		shareWalk gives ManagedCascadeStrategy.unsupported
	end 'action'
end 'functionValueCascadeStrategy'

// The clone strategy for a managed field NAMED `declaredName` — a declared struct or boxed union clones
// through its per-type `__clone_<T>`. A scalar-only box still takes `__clone_<T>` (not the drop side's
// `__mm_decref`): the clone MUST allocate a fresh independent box, which only a synthesized cloner does.
//
// ⚠ **THE NAME IS ALREADY DENOTED**, exactly as `managedNameDropCallee`'s is — the two duals resolve a tuple
// typealias at ONE tier, in the `-Field` function above each of them.
// ⛔⛔ **AND IT MUST ASK THE COMPILER-OWNED QUESTION ITS DROP TWIN ASKS, OR A COMPILABLE PROGRAM PANICS THE
// COMPILER.** `managedNameDropCallee` opens with the same name tests; without them a
// `__ManagedFile` / `__ManagedDirectory` field falls to the struct arm — their
// layouts ARE registered, they need a nominal identity — and the answer is `__clone___ManagedFile`, a symbol
// `installStructCascades` never builds, because that pass walks the PROJECT's declarations and a synthesized
// type is in no file's. MEASURED: `type Holder { export var f as
// __ManagedFile }` + `Array with Holder` + `a.clone()` dies with
// `panic at X64Backend.maxon:1892: resolveCallFixups: call to unknown function '__clone___ManagedFile'`.
//
// ⇒ Both answer `unsupported`, which is the honest verdict and not a placeholder: an OS HANDLE cannot be
// deep-copied at all — duplicating one would hand two owners a descriptor whose `__mf_destruct` closes it
// once. `typeSupportsDeepClone` refuses the same names at the same tier, so the GATE and the STRATEGY
// agree by construction and the front end reports a positioned E2015 rather than leaving the backend to
// panic — which is what that gate's own header says it exists for: *"a name the gate and the strategy
// disagreed about would admit a clone nobody can emit."*
function managedNameCascadeStrategy(signatures ProgramSignatures, declaredName ByteArray, asElement bool, action CascadeAction) returns ManagedCascadeStrategy
	match compilerOwnedAggregateOf(signatures, name: declaredName) 'compilerOwned'
		managedFile or
		managedDirectory or
		managedPages or
		managedHandle or
		managedPin then return ManagedCascadeStrategy.unsupported

		managedSocket then return ManagedCascadeStrategy.unsupported

		// ⭐ **A HANDLE IS THE ONE COMPILER-OWNED AGGREGATE THAT CLONES**, and its clone is the design's own
		// `handle.clone()`: a SECOND HANDLE to the same service, which steps both mailbox counts and mints a
		// fresh box. `direct` because that is one entry point taking one record, exactly as a `__clone_<T>` is.
		serviceHandle then return ManagedCascadeStrategy.direct(serviceHandleCascadeCallee(action, clone: serviceHandleClonerOf(signatures, handleName: declaredName)))
		userDeclared then break
	end 'compilerOwned'

	// The drop twin's canonical-rendering arm, at the same tier and on the same gid — see it for the measured
	// panic. It is spelled here even though no corpus program is known to reach the CLONE side with a rendered
	// instance name, because these two duals resolve at one tier by contract (`managedFieldDropCallee`
	// states the rule): a value the drop side routes must be a
	// value the clone side can route, and a divergence between them is a panic on one walk order and a
	// compiling program on the other.
	if let rendered = try signatures.renderedInstanceOfUnclaimedName(declaredName) 'aRenderedInstance'
		return instanceCascadeStrategy(signatures, id: rendered, asElement: asElement, action: action)
	end 'aRenderedInstance'

	let form = try signatures.declaredFormInAnyFile(declaredName) otherwise panic("managedNameCascadeStrategy: managed field '{String.from(declaredName)}' is declared by no registry — the caller classified it managed, and every managed non-String form is a declared struct, a boxed union or a generic-alias instance")

	match form 'form'
		// A scalar-only box still takes `__clone_<T>` (not the drop side's `__mm_decref`): the clone MUST
		// allocate a fresh independent box, which only a synthesized cloner does.
		structType or
		enumType or
		unionType then return ManagedCascadeStrategy.direct(perTypeCascadeSymbol(action, typeName: declaredName))

		// The three arms below mirror `managedNameDropCallee`'s exactly.
		interfaceType then panic("managedNameCascadeStrategy: '{String.from(declaredName)}' is an interface, which no slot can be declared with (E3011), so no cascade strategy clones one")
		rangedAlias then panic("managedNameCascadeStrategy: '{String.from(declaredName)}' is a ranged typealias — a scalar, which `typeIsManaged` never classifies managed")
		functionAlias then return functionValueCascadeStrategy(action)
		genericAlias then return instanceCascadeStrategy(signatures, id: signatures.genericAliasInstanceInAnyFile(declaredName), asElement: asElement, action: action)

		// The drop twin's tuple arm, one register over: `denotedAggregateName` has already resolved a tuple
		// alias to the tuple's own struct name upstream, and a tuple box clones exactly as any struct box does.
		tupleAlias then return ManagedCascadeStrategy.direct(perTypeCascadeSymbol(action, typeName: signatures.tupleAliasTargetInAnyFile(declaredName)))
	end 'form'
end 'managedNameCascadeStrategy'

// ⭐⭐ **WHICH COMPILER-OWNED AGGREGATE `name` IS — the ONE home of a fact three doors need and none may
// spell for itself.** These types have a REGISTERED layout (they need a nominal identity, so
// `containsStruct` says yes and `declaredFormOf` answers `structType`) but they are declared in no FILE, so
// `installStructDestructors` / `installStructCascades` — which walk the project's own declarations —
// synthesize neither a `__destruct_<T>` nor a `__clone_<T>` for them. Every question of the shape *"what does
// the generic per-type machinery do with this?"* therefore has to answer for them FIRST, before the form.
//
// It is asked by `managedNameDropCallee` (each takes its own compiler-owned entry), by
// `managedNameCascadeStrategy` (none is deep-cloneable) and by `ProgramSignatures.typeSupportsDeepClone` (the
// gate in front of that strategy).
enum CompilerOwnedAggregate
	managedFile
	managedDirectory

	// ⚠ **KEPT ADJACENT TO ITS SIBLINGS ON PURPOSE.** Every reader below but the walk strategy answers the
	// same way for all of them, so they are matched as ONE RANGE — which is also what makes a further
	// compiler-owned aggregate that needs a different answer fail to compile at each of those arms rather
	// than inherit theirs. The walk readers (`managedNameCascadeStrategy`, `aggregateNameSupportsDeepClone`)
	// split the socket off: its box count proves its one owner, so a move walks it.
	managedSocket
	managedPages
	managedHandle
	managedPin

	// ⭐⭐ **ONE THAT NEEDS A DIFFERENT ANSWER.** A `<T>.handle`
	// box holds one machine word — the cown pointer — and its DROP is what shuts a service down: the last
	// handle to go closes the cown, and the last reference to go frees it. Its CLONE is a second handle to
	// the SAME service, never a second service. Neither is expressible as a synthesized per-type entry, and
	// neither is the plain `__mm_decref` a scalar-fielded struct box would otherwise take — which would free
	// eight bytes and leave a cown nobody can ever close.
	//
	// ⚠ It is DELIBERATELY OUTSIDE the `managedFile to managedPin` range: it is the one compiler-owned
	// aggregate that IS deep-clonable, so a reader answering "not clonable" for the rest must not answer it
	// for this one. That is the sentence above, spent.
	serviceHandle

	// An ordinary declaration, whose drop and clone are the synthesized per-type entries.
	userDeclared
end 'CompilerOwnedAggregate'

union RawHandleLookup
	named(kind CompilerOwnedAggregate)
	notOne
end 'RawHandleLookup'

// The one roster of raw handle types. The raw-surface refusal (E3185), the host-resource producer test and
// `compilerOwnedAggregateOf` all read it, so a type added here is refused, routed and dropped everywhere.
function rawHandleNamed(name ByteArray) returns RawHandleLookup
	if name.equals(ManagedFileTypeName) 'managedFile'
		return RawHandleLookup.named(CompilerOwnedAggregate.managedFile)
	end 'managedFile'

	if name.equals(ManagedDirectoryTypeName) 'managedDirectory'
		return RawHandleLookup.named(CompilerOwnedAggregate.managedDirectory)
	end 'managedDirectory'

	if name.equals(ManagedSocketTypeName) 'managedSocket'
		return RawHandleLookup.named(CompilerOwnedAggregate.managedSocket)
	end 'managedSocket'

	if name.equals(ManagedPagesTypeName) 'managedPages'
		return RawHandleLookup.named(CompilerOwnedAggregate.managedPages)
	end 'managedPages'

	if name.equals(ManagedHandleTypeName) 'managedHandle'
		return RawHandleLookup.named(CompilerOwnedAggregate.managedHandle)
	end 'managedHandle'

	if name.equals(ManagedPinTypeName) 'managedPin'
		return RawHandleLookup.named(CompilerOwnedAggregate.managedPin)
	end 'managedPin'

	return RawHandleLookup.notOne
end 'rawHandleNamed'

function isRawHandleName(name ByteArray) returns bool
	return match rawHandleNamed(name) 'lookup'
		named gives true
		notOne gives false
	end 'lookup'
end 'isRawHandleName'

function isHostResourceHandleName(name ByteArray) returns bool
	return match rawHandleNamed(name) 'lookup'
		named(kind) gives isHostResourceAggregate(kind)
		notOne gives false
	end 'lookup'
end 'isHostResourceHandleName'

function isHostResourceAggregate(kind CompilerOwnedAggregate) returns bool
	return match kind 'kind'
		managedPages or
		managedHandle or
		managedPin gives true

		managedFile or
		managedDirectory or
		managedSocket gives false

		serviceHandle or
		userDeclared panic("isHostResourceAggregate: `{kind.name}` is not a raw handle type, and `rawHandleNamed` answers only the six that are")
	end 'kind'
end 'isHostResourceAggregate'

function compilerOwnedAggregateOf(signatures ProgramSignatures, name ByteArray) returns CompilerOwnedAggregate
	match rawHandleNamed(name) 'rawHandle'
		named(kind) then return kind
		notOne then break
	end 'rawHandle'

	// ⚠ **ASKED OF THE REGISTRY AND NOT OF THE SPELLING, WHICH IS WHY THIS FUNCTION TAKES THE INDEX.** The
	// raw handle names `rawHandleNamed` answers are compiler constants; a handle's is `<T>.handle`, one per
	// service, minted by `ServiceCompanions` from a type the program spawns. A suffix test would be a second
	// statement of what a companion is named — and would answer `true` for a name no `spawn` ever produced.
	if signatures.isAnyServiceHandle(name) 'serviceHandle'
		return CompilerOwnedAggregate.serviceHandle
	end 'serviceHandle'

	return CompilerOwnedAggregate.userDeclared
end 'compilerOwnedAggregateOf'

// The clone strategy for a generic-INSTANCE field — one of the two ELEMENT-BEARING RECORDS this compiler owns
// (the managed buffer and the chain, each with its own per-element copy entry) or, for any other instance
// (`Box with String`), the PER-INSTANCE cloner `__clone_<mangled>`, which is the clone twin of the
// `__destruct_<mangled>` cascade `genericInstanceBoxDropCallee` hands back for the same instance. The managed
// element's own strategy comes back through the METHOD `containerElementCascadeStrategy` (which resolves the
// element in the index's own interner), so this free function never has to reach the index's private `typeNames`.
function instanceCascadeStrategy(signatures ProgramSignatures, id GenericInstanceId, asElement bool, action CascadeAction) returns ManagedCascadeStrategy
	if signatures.isManagedBufferRecordInstance(id) 'theManagedRecord'
		return elementRecordCascadeStrategy(signatures, id: id, entries: managedRecordCascadeEntries(action), asElement: asElement, action: action)
	end 'theManagedRecord'

	// ⭐ **A CHAIN IS THE SECOND ELEMENT-BEARING RECORD.** Its copy is `ListRuntime`'s walk for
	// `genericInstanceBoxDropCallee`'s reason one door along: a chain's record, its nodes and its elements are
	// reachable only from a walk that file writes, so the entry that knows how to duplicate them is the one that
	// already knows how to tear them down.
	//
	// ⚠ **THE PREDICATE IS `isManagedListInstance`.** A `List with T` is a DECLARED struct whose
	// single field is a `__ManagedList with T`, so admitting it here would hand `__list_clone` a
	// struct box to read `element_drop@24` out of. The box clones through the ordinary per-instance
	// `__clone_<mangled>` below, which walks that one field and reaches the chain by recursion — one
	// structure, cloned once, through the surface that owns it.
	if signatures.isManagedListInstance(id) 'theChain'
		return elementRecordCascadeStrategy(signatures, id: id, entries: chainCascadeEntries(action), asElement: asElement, action: action)
	end 'theChain'

	// A handle's clone is a SECOND HANDLE to the same service, never a duplicated box: `__clone_<mangled>`
	// would copy the cown pointer while stepping neither count. It sits with the other compiler-owned
	// records rather than at the top, so the containers above pay nothing.
	if signatures.instanceBaseIsServiceHandle(id) 'serviceHandle'
		return ManagedCascadeStrategy.direct(serviceHandleCascadeCallee(action, clone: CownHandleCloneBoxName))
	end 'serviceHandle'

	if signatures.instanceBaseIsSharedValue(id) 'sharedValue'
		return ManagedCascadeStrategy.direct(serviceHandleCascadeCallee(action, clone: SharedValueBoxCloneName))
	end 'sharedValue'

	// ⛔ A base-layout-less instance with no runtime copy of its own (a cursor) has no field list to cascade over
	// either, so nothing synthesizes its cloner — `declaredInstanceSupportsDeepClone` refuses it at the SAME tier,
	// which is what keeps this strategy from naming a symbol `installGenericInstanceCascades` never builds.
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCloner'
		return ManagedCascadeStrategy.unsupported
	end 'noSynthesizedCloner'

	return ManagedCascadeStrategy.direct(perTypeCascadeSymbol(action, typeName: signatures.mangleGenericInstance(id)))
end 'instanceCascadeStrategy'

// An element-bearing record's two entries for ONE action: the whole-record one a TRIVIAL element takes, and
// the per-element one a MANAGED element takes. A pair rather than two loose arguments, so a caller cannot hand
// one container the other's entry, and one producer per container so the buffer and the chain answer the same
// question the same way.
type ElementRecordCascadeEntries
	export let trivial as immutable ByteArray
	export let perElement as immutable ByteArray

	static function create(trivial ByteArray, perElement ByteArray) returns ElementRecordCascadeEntries
		return Self{trivial: trivial, perElement: perElement}
	end 'create'
end 'ElementRecordCascadeEntries'

function managedRecordCascadeEntries(action CascadeAction) returns ElementRecordCascadeEntries
	return match action 'action'
		clone gives ElementRecordCascadeEntries.create(ManagedCloneName, perElement: ManagedCloneManagedName)
		shareWalk gives ElementRecordCascadeEntries.create(ManagedShareName, perElement: ManagedShareManagedName)
	end 'action'
end 'managedRecordCascadeEntries'

function chainCascadeEntries(action CascadeAction) returns ElementRecordCascadeEntries
	return match action 'action'
		clone gives ElementRecordCascadeEntries.create(ListCloneName, perElement: ListCloneManagedName)
		shareWalk gives ElementRecordCascadeEntries.create(ListShareName, perElement: ListShareManagedName)
	end 'action'
end 'chainCascadeEntries'

// ⭐⭐ **AN ELEMENT-BEARING RECORD'S COPY, ROUTED BY ELEMENT KIND — the shape the managed buffer and the chain
// SHARE.** A TRIVIAL element needs no cloner at all (the record's own walk duplicates the words),
// so the whole record is a ONE-argument `direct` copy and may therefore stand as an ARRAY ELEMENT's
// own cloner. A MANAGED element must be deep-cloned one at a time through its own `(box) -> newBox`
// — appending or blitting the source's pointer would give two records one element and drop it twice
// — which makes the record's entry TWO-argument and confines it to a FIELD. An element that is not
// itself `direct` (a record of managed-element records) has no such callee at all and the whole
// field is unsupported.
//
// It takes the two entries rather than the container's identity because that is the ONLY thing that differs
// between the two containers: written per-container, this routing would be one decision with two homes, free
// to answer the chain and the buffer differently about what "managed element" costs.
function elementRecordCascadeStrategy(signatures ProgramSignatures, id GenericInstanceId, entries ElementRecordCascadeEntries, asElement bool, action CascadeAction) returns ManagedCascadeStrategy
	if not signatures.containerElementIsManaged(id) 'trivialElement'
		// ⛔⛔ **AN OPAQUE ELEMENT REACHES THIS ARM ON A `false` THAT MEANS "CANNOT SAY", NOT "OWNS
		// NOTHING".** `containerOpaqueElementCanBeManaged` carries the measurement; the record's copy is
		// the word-for-word one and the instance's `element_drop@24` is live, so the copy and the source
		// free the same elements. It is refused HERE and in `instanceGraphSupportsDeepClone` **together**
		// — one alone makes the gate and the strategy disagree, which is `emitCloneCall`'s panic in one
		// direction and a spurious E2015 in the other, the standing rule this file states at
		// `managedNameCascadeStrategy`.
		if signatures.containerOpaqueElementCanBeManaged(id) 'someInstantiationOwnsTheElement'
			return ManagedCascadeStrategy.unsupported
		end 'someInstantiationOwnsTheElement'

		return ManagedCascadeStrategy.direct(entries.trivial)
	end 'trivialElement'

	match signatures.containerElementCascadeStrategy(id, action: action) 'element'
		direct(elementEntry) then return managedElementRecordCopy(signatures, id: id, perElementEntry: entries.perElement, elementEntry: elementEntry, asElement: asElement, action: action)

		// ⛔ UNREACHABLE BY CONSTRUCTION, AND SAID RATHER THAN DEFAULTED: the ELEMENT door
		// (`containerElementCascadeStrategy`) asks with `asElement: true`, and at that position a managed-element
		// record answers with its one-argument thunk. An answer here means the element door stopped passing the
		// position, which would silently refuse every nested container again.
		managedElements then panic("elementRecordCascadeStrategy: instance {id}'s element resolved to a 2-argument `managedElements` strategy at the ELEMENT position, where `asElement: true` mints the one-argument thunk")
		throughWitness or
		unsupported then return ManagedCascadeStrategy.unsupported
	end 'element'
end 'elementRecordCascadeStrategy'

// ⭐⭐ **THE ELEMENT POSITION TAKES A THUNK, THE FIELD POSITION TAKES THE CALL.** A managed-element
// record's copy is one operation — `<containerClone>(box, funcAddr(elementClone))` — with two entry points,
// because the two positions can pass different numbers of arguments. A struct / union / instance FIELD is
// cloned by a synthesized cascade body, which emits the `funcAddr` itself and makes the 2-argument call
// inline. An ARRAY ELEMENT is reached through `callIndirect(fn, elem)`, which has room for exactly one — so it
// takes the per-instance `__clone_<mangled>` whose ENTIRE body is that same call
// (`MmRuntime.synthesizeElementRecordCloner`), reached through the shared `emitCloneCall` so the two entry
// points cannot come to copy differently.
//
// ⚠ **THIS IS WHY THE POSITION IS A PARAMETER HERE AND IS NOT ONE ON THE GATE THAT ADMITS IT.** The position
// decides only WHICH ENTRY, which is a fact about emission and belongs on this side alone.
function managedElementRecordCopy(signatures ProgramSignatures, id GenericInstanceId, perElementEntry ByteArray, elementEntry ByteArray, asElement bool, action CascadeAction) returns ManagedCascadeStrategy
	if asElement 'reachedThroughCallIndirect'
		return ManagedCascadeStrategy.direct(perTypeCascadeSymbol(action, typeName: signatures.mangleGenericInstance(id)))
	end 'reachedThroughCallIndirect'

	return ManagedCascadeStrategy.managedElements(perElementEntry, elementEntry: elementEntry)
end 'managedElementRecordCopy'

// The single `(box) -> newBox` clone callee of a `direct` strategy. Precondition: the caller has classified the
// element deep-cloneable through the FULL-GRAPH `typeSupportsDeepClone` (via
// `genericInstanceOpaqueArrayElementIsCopyable` or the concrete copy gate `sourceCloneVerdictOfType`), which
// is `direct` at the TOP LEVEL for every deep-cloneable element — so a `managedElements`/`unsupported` strategy
// reaching here is an invariant break and panics. (The full-graph gate is the RIGHT precondition, not a mere
// top-level `direct` check: a struct/union that is `direct` at the top but owns a non-clonable field must NOT
// reach a stamp — see `genericInstanceOpaqueArrayElementIsCopyable`.)
function directCascadeCalleeOf(strategy ManagedCascadeStrategy) returns immutable ByteArray
	match strategy 'strategy'
		direct(callee) then return callee
		managedElements then panic("directCascadeCalleeOf: a `managedElements` strategy has no single-function clone callee — the caller must gate on typeSupportsDeepClone")
		unsupported then panic("directCascadeCalleeOf: an `unsupported` strategy has no clone callee — the caller must gate on typeSupportsDeepClone")
		throughWitness then panic("directCascadeCalleeOf: a witness-read walk has no single-argument callee — an existential is refused as an element and as a clone")
	end 'strategy'
end 'directCascadeCalleeOf'

// --- Generic instances ---

// The prefix a compiled instance name is minted behind when a declaration already claims the bare one
// (`reservedIfDeclared`). It is the SAME `__` the language reserves — `E2051` refuses to declare a name
// starting with it.
//
// ⚠ **BE PRECISE ABOUT WHAT THAT RESERVATION BUYS, BECAUSE IT IS NOT THE OBVIOUS HALF.** Disjointness
// from the DECLARED names is bought by `reservedIfDeclared`'s loop, which re-probes until the candidate
// is unclaimed and would hold for any prefix at all. What only `__` buys is disjointness from every
// OTHER INSTANCE's compiled name — the half nothing probes — and it buys it because a compiled name
// always BEGINS with its base name and E2051 bars a `__` base: no bare compiled name can start with the
// prefix, so a minted one is never some other instantiation's bare one. Pick a prefix the language does
// NOT reserve and that fails silently: `XBox_String` is a name `XBox with String` compiles to on its
// own, and the pair check would report E3006 against a legal program. (E2051 also bounds the loop at one
// re-mint on anything that compiles, which is a cost property, not a safety one.)
//
// The parser's E2051 refusal tests this same constant through `isCompilerReservedName`, so FORBIDDING and
// MINTING share one symbol. `MmRuntime.CompilerInternalPrefix` RECOGNIZES an emitted callee by the same
// value at another tier: it skips a `__`-named callee's user-function checks on the promise that no user
// `__` name exists, a promise only this reservation keeps. A drift between the two is LOUD rather than
// silent: this value reaches every emitted per-type symbol of a contested instance, so changing it alone
// renames those symbols, and emptying it hangs the loop.
let ReservedTypeNamePrefix = b"__"

// ⭐⭐ **THE NAME the compiler SYNTHESIZES THE ARRAY RECORD UNDER WHEN NO LISTED MODULE DECLARES ONE
// — AND THAT IS ALL IT IS.** Which base is an `Array` is DISCOVERED from the `BuiltinArrayLiteral`
// conformance (`Queries.discoverWholeProgramTokenFacts` ⇒
// `ProgramSignatures.arrayRecordDeclaredName`), which is the
// user's own stated exception to *"nothing array specific in the compiler"*. Compare against that,
// never against this seed.
//
// ⚠ **IT IS A SEED, NOT A FALLBACK CONSTANT, AND THE DIFFERENCE IS THAT IT DESCRIBES A REAL
// COMPILE.** A corpus that declares no conformer still has to file the values the compiler mints
// under some base. `noteArrayLiteralConformer` REPLACES the seed the moment a listed module
// declares one, which every real compile does.
//
// ⛔ **THE SEED ITSELF IS NOT RETIRABLE.** With no listed module declaring the record, `Array` is a
// SYNTHESIZED builtin container in exactly the sense `SetBuiltinBaseName`, `ListBuiltinBaseName`,
// `MapBuiltinBaseName` and `FixedArrayBuiltinBaseName` are — the compiler owns the record, so the
// compiler owns the name, and there is nothing left to discover it FROM. A reserved spelling
// (`__ManagedMemory`) would rename every emitted per-type symbol of a compile no corpus program
// performs.
//
// ⚠⚠ **AND ITS VALUE IS UNOBSERVABLE IN EVERY COMPILE THAT HAS A CORPUS.**
// `StdlibLoader.loadLibrarySources` loads every module under `stdlib/`, `Array.maxon` among them,
// so the seed is replaced before anything reads it. It may not therefore be replaced by a
// discovered-or-panic: the compile it describes is the one with no corpus, the only compile in
// which it is read at all. It is an INITIALIZER for a state that exists, not a fallback for a state
// that does not.
let SynthesizedArrayRecordSeed = b"Array"

// The name `stdlib/Array.maxon` gives the `Array`'s sole type parameter — `export type Array uses Element`.
// The compiler declares no such type (the container is compiler-owned and synthesized, which is why
// `SynthesizedArrayRecordSeed` exists at all), so a diagnostic that has to SPELL the parameter — the
// `where Element is Equatable` clause `contains` is withheld under — has nowhere to read it from and writes
// it here, once.
let ArrayElementTypeParamName = b"Element"

// The position of that parameter in the (one-entry) `uses` list — what a `WhereConstraint` about the element
// indexes, and the same 0 `containerElementType` reads. Named where the parameter it points at is named,
// rather than as a bare literal at the one refusal that builds a constraint.
let ArrayElementTypeParamIndex = 0 as FieldIndex

// The element type name of a `b"…"` byte-string literal's `Array with Byte` instance — the same `Byte`
// spelling a user's `typealias Byte = int(0 to u8.max)` uses, so a byte-string's gid matches a
// `ByteArray`-typed value's gid (type identity). A bare `named` reference: the element's own resolution
// is never needed (a byte-string stamps `element_size = 1` directly and never reads `arrayElementSize`).
let ByteElementTypeName = b"Byte"

// The single type parameter `Array` declares (`Array with Element`) — the arity `checkGenericSpellings`
// validates a `Array with …` against.
let ArrayTypeParamCount = 1 as FieldIndex

// The name of the builtin `Set` generic type (`Set with Element`). `stdlib/Set.maxon` declares the
// type, so a `Set with T` is an ordinary declared generic instance and this constant is only a
// SPELLING: the base name a desugared `Set.create` / `Set.insert` / `Set.contains` call is composed
// from, and the one a `CharSet from […]` member set is interned at (`setInstanceForCharacter`).
let SetBuiltinBaseName = b"Set"

// ⭐⭐ **WHAT A GENERIC INSTANCE REDUCES TO FOR A CONFORMANCE QUESTION** — the answer
// `ProgramSignatures.instanceConformerReduction` gives its two doors, as a CASE rather than a name.
//
// `unreduced` is a real state of the world and not a sentinel: it means "no conformer name claims this
// instance", which is precisely how a non-conforming `Array with <element>` goes on being refused by E3017
// with no second predicate to keep in step. What each door then ANSWERS with differs — the mangled instance
// name where there is no source spelling, the typealias's own name where there is — and folding those two
// into one `String` return is what put a mangled `Array_Opaque` into a diagnostic that pins `OpaqueArr`.
export union GenericInstanceConformer
	// A conforming `Array with E`: every one of them reduces to the ONE `Array` conformer, whose impls walk
	// raw bytes and are element-independent.
	arrayBuiltin

	// A DECLARED generic (`type Wrapper uses T implements Named`): its conformance is a property of the
	// declaration and its impls are one shared body, so the base name is the conformer for every instance.
	declaredBase(name immutable ByteArray)

	// Neither — a non-conforming array, or an instance of a BUILTIN base that declares nothing.
	unreduced
end 'GenericInstanceConformer'

// The name of the builtin `Map` generic type (`Map with (Key, Value)`). `stdlib/Map.maxon` declares
// the type, so this is only the SPELLING a desugared `Map.create` / `Map.upsert` call and a `[k:
// v]` literal's instance are composed from.
let MapBuiltinBaseName = b"Map"

// ⭐ **WHICH TYPE ARGUMENT IS THE KEY — A FACT ABOUT EVERY HASH TABLE, NOT ABOUT `Map`.** A `Set with Key`
// and a `Map with (Key, Value)` both put the key first, and three doors depend on it being the same 0:
// `Parser.requireContainerColumnTypes`' gates (the `List` arm's and, through
// `Parser.parseMapColumnValue`'s key half and `mapKeyType`. So it is ONE
// exported constant those read.
//
// The VALUE position stays `Map`-only, because only a `Map` has a second column.
let HashTableKeyArgPosition = 0 as ElementIndex
let MapValueArgPosition = 1 as ElementIndex
let ContainerElementArgPosition = 0 as ElementIndex

// ⭐⭐ **THE SPELLING `List` IS COMPOSED FROM — NOT A SYNTHESIZED CONTAINER.** `stdlib/List.maxon`
// declares `type List uses Element`, so a `List with T` is an ordinary declared generic instance: its box is
// its own `StructLayout`, its `create()` is the module's own static, and it drops through its own
// `__destruct_<mangled>` cascade. This constant is the base name a `List from […]` head is
// recognized by and the qualified `List.create` / `List.append` callees that construction desugars
// to are composed from.
let ListBuiltinBaseName = b"List"

// ⭐⭐ **`__ManagedList with Element` — THE `List`'s OWN CHAIN, UNDER THE NAME THAT EXPOSES ITS NODES**
// (`/specs/managed-list.md`, `/specs/internal-types.md`). `/specs/list.md` writes
// `List` as a USER type whose sole field is `var chain as __ManagedList with Element`, so the two are one
// structure in the canonical language too — and in the compiler they are literally one: the same
// `ListRecordBytes` header, the same 24-byte nodes, the same `__list_*` entries, the same `__list_decref`.
// This is `FixedArray`'s relationship to `Array` (see `FixedArrayBuiltinBaseName`) at a second pair: two TYPES whose
// layouts coincide, kept as separate base names because what may be DONE to them differs — a `List` is
// indexed and iterated, a `__ManagedList` hands out NODE HANDLES.
//
// ⚠ **IT IS `__`-PREFIXED IN THE CANONICAL LANGUAGE, WHICH IS WHY THE NAME IS SPELLED WITH THE PREFIX
// HERE AND NOT RESERVED-RENAMED.** `/specs/internal-types.md` lists it among the types a program may NAME
// but whose representation is the compiler's; `stdlib/List.maxon` names it in its own field declaration.
let ManagedListBuiltinBaseName = b"__ManagedList"

// The single type parameter `__ManagedList` declares — the `List` twin, and the same one-word element slot.
let ManagedListTypeParamCount = 1

// ⭐⭐ **`__ManagedListNode with Element` — A HANDLE ON ONE NODE, AND THE ONE TYPE IN the compiler NO SOURCE CAN
// CONSTRUCT.** Only an insertion mints a value of it (`__ManagedList.insertFirst`/`insertLast`).
//
// ⭐⭐ **IT IS AN OWNED HANDLE ON A REFCOUNTED NODE — A SECOND OWNER OF THE NODE ITSELF.** The nodes are
// refcounted, in `/specs/managed-list.md`'s own words — *"__ManagedList owns its nodes via reference
// counting … handles with refcount-based lifetime"*. A handle IS the node
// pointer; it is enrolled as a sole-owned temp and released through `__list_node_decref`, which frees the
// node only when the LAST owner goes — which may be a handle long after the chain is gone.
//
// ⛔⛔ **TWO EARLIER RULINGS ARE RECORDED HERE BECAUSE BOTH WERE MEASURED WRONG AND THE SECOND FAILURE IS
// THE INSTRUCTIVE ONE.** This first said a handle was *"emitted as a BORROW, never as an owned temp, and no
// binding of it is ever dropped"*, with `genericInstanceBoxDropCallee` panicking rather than answering —
// which `stdlib/List.maxon` cannot live with, since it needs a handle in a RETURN (`walkTo`, `:60-70`), a
// FIELD (`ListIterator.node`, `:161`, reassigned at `:173`) and a PARAMETER (`ListIterator.create`,
// `:163`). It then said a handle was an owned box RETAINING ITS LIST — and that was worse than incomplete,
// it was a WRONG ANSWER: `clear` frees nodes, so retaining the chain kept nothing alive, and a handle in a
// struct field read a freed box's `0x3F` poison at exit 0 with no diagnostic anywhere.
//
// ⭐ **THE LESSON THE SECOND FAILURE CARRIES: A PRECEDENT IS A WHOLE MECHANISM, NOT ITS MOST QUOTABLE
// HALF.** That box was argued from `__ManagedMemoryCursor`, which survives the same escapes — but a cursor
// pays with the retain AND a LIVE RE-READ of its source on every use. Only the retain was ported, and a
// node has nothing live to re-read.
//
// ⚠ **IT IS PARAMETERIZED BY THE ELEMENT, and that is what makes `node.value()` typed at all.** A node's
// value slot is one machine word whatever the element is (see the node-format block below), so the WIDTH
// needs no parameter — but the TYPE a `value()` reads back does, and there is nowhere else to carry it: a
// value's type in the compiler is a `(tag, nameId)` pair, so an un-parameterized node would have to look its
// element up in a side table keyed by `ValueId`, which no phi or merge would survive.
let ManagedListNodeBuiltinBaseName = b"__ManagedListNode"

// The single type parameter `__ManagedListNode` carries. Same arity as every one-element container, so
// every one-argument door (`containerElementType`, `containerElementIsManaged`, `elementAccessorResultType`)
// serves a node handle unchanged — which is exactly how `value()` is emitted through the SAME element
// accessor a `get` is.
let ManagedListNodeTypeParamCount = 1

// ⭐⭐ **`__ManagedMemoryCursor with Element` — A NAVIGABLE POSITION INSIDE A BUFFER, AND THE SECOND TYPE NO
// SOURCE CAN CONSTRUCT.** Only `__ManagedMemory.createCursor()` mints one. `stdlib/Array.maxon:485-531`'s
// `ArrayIterator` is its whole consumer: it stores one in a field and forwards six members, which is why the
// type must be NAMEABLE in an annotation (`typealias RawCursor = __ManagedMemoryCursor with Element`) where a
// node handle need not be.
//
// ⚠ **IT IS `__`-PREFIXED IN THE CANONICAL LANGUAGE, so the name is spelled with the prefix here and not
// reserved-renamed** — the `__ManagedList` rule, for that entry's reason: `/specs/internal-types.md` lists it
// among the types a program may NAME while their representation stays the compiler's.
//
// ⚠ **IT IS PARAMETERIZED BY THE ELEMENT FOR `ManagedListNodeBuiltinBaseName`'s REASON, VERBATIM.** A
// cursor's `current()`/`peek()` read one machine word whatever the element is, so the WIDTH needs no
// parameter — but the TYPE they hand back does, and a value's type in the compiler is a `(tag, nameId)` pair with
// nowhere else to carry it.
//
// ⭐ **UNLIKE A NODE HANDLE, IT IS OWNED AND IT IS DROPPED.** A node is a borrow into a chain the list frees;
// a cursor is its own 16-byte `__mm_alloc` box holding a RETAINED source, so it has a real box size and a
// real drop callee — see `ManagedMemoryRuntime.ManagedCursorCreateName` for why the retain exists and why the record
// holds the source rather than a snapshot of its fields.
let ManagedMemoryCursorBuiltinBaseName = b"__ManagedMemoryCursor"

// The single type parameter a cursor carries — the same one-element arity every other one-argument door
// (`containerElementType`, `containerElementIsManaged`, `elementAccessorResultType`) already serves, which is
// how `current()` is emitted through the SAME element accessor an `Array`'s `get` is.
let ManagedMemoryCursorTypeParamCount = 1

// ⭐⭐ **THE FIFTH COMPILER-OWNED CONTAINER: `FixedArray with <N> <Element>`, A FIXED-SIZE ARRAY.** The
// compiler owns its record; `stdlib/FixedArray.maxon` declares the type and supplies every member body.
//
// ⭐ **ONE CORPUS BODY SERVES EVERY SIZE.** `Self` inside `type FixedArray uses Element` is the
// declaration's own instance over its own parameters (`ownRecordSelfInstance`) — a fixed array with NO
// count — while every value a program holds states one, because the count is part of the intern KEY
// (`fixedSizes`, below). `substitutedShape` gives a declaration's own countless `Self` the SIZE of
// the receiver it is viewed through, so a sized receiver matches a corpus method's `self`. The rule
// is confined to a declaration's own `Self`, which is why `/specs/fixed-array.md`'s
// `error.wrong-size-fixed-array-argument` stays refused.
//
// ⭐ **`create()` NEEDS THE COUNT AND ITS BODY CANNOT NAME IT.** `return Self{}` means *"N
// zero-initialized elements"*, so the count travels in a hidden parameter of its own
// (`fixedElementCountNeeds`, which says why the layout descriptor is the wrong carrier), and
// `Parser.emitSizedContainerRecord` publishes the slots for the corpus's `return Self{}`.
//
// ⚠ **`for … in` OVER A FIXED ARRAY RUNS THE CORPUS `createIterator`**, on the module's VISIBILITY
// alone; `Parser.parseForStatement`'s header states the trade.
//
// ⭐ **ITS RUNTIME REPRESENTATION IS AN `Array`'s, EXACTLY — the 48-byte `ManagedRecordBytes` fused record, the
// `__managed_*` helpers, `__managed_decref`.** A fixed-size buffer and a growable one differ in what may be DONE to
// them, not in how the bytes sit, so a second record would have been the same six slots under a second
// name: `genericInstanceBoxSize` and `genericInstanceBoxDropCallee` answer a FixedArray with the `Array` row.
//
// ⛔ **HOW A FIXED ARRAY'S RECORD IS BUILT IS `Parser.emitSizedContainerRecord`'s TO STATE**, and it is
// stated only there.
//
// ⭐⭐ **WHAT IS `FixedArray`'s ALONE IS THE SIZE, AND IT LIVES IN THE INSTANCE'S IDENTITY** —
// `GenericInstanceRegistry.fixedSizes`, part of the intern KEY, so `FixedArray with 3 Int` and
// `FixedArray with 4 Int` are different gids by construction (`/specs/fixed-array.md`: *"The size is part of the
// type"*). ⚠ **AND IT IS A COLUMN RATHER THAN A `MaxonType` ARM.** A `MaxonType` is read through a DENSE
// PER-VALUE COLUMN (`ValueTypeTag` + `TypeNameId`, see MaxonDialect), so a `constInt` arm — a VALUE
// wearing a type's clothes — would owe an answer to every rule
// that reads a tag — `typeClassOf`, `tagIsIntegral`, `valueTagToStdType`, `notOperatorFor` — about "the type
// that is the number 3", and there is no honest one. A number is not a type; it is a second coordinate of
// the instance, and it is stored as one.
let FixedArrayBuiltinBaseName = b"FixedArray"

// The single TYPE parameter `FixedArray` declares. Its SIZE is not a type argument (see above), so a
// `FixedArray with 3 Int` has arity ONE here exactly as `Array with Int` does, and every one-argument container
// door (`containerElementType`, `arrayElementSize`, `containerElementIsManaged`) serves it unchanged.
let FixedArrayTypeParamCount = 1 as FieldIndex

// ⚠ **NO `MapError` CONSTANT STANDS HERE, AND THE COMPILER NAMES THAT ENUM NOWHERE.** `stdlib/Map.maxon:6-9`
// declares it; nothing transcribes its ordinals (`__map_get`/`__map_insert` went with the synthesized hash
// table, so a corpus `throw MapError.keyNotFound` resolves its tag from the declaration and there is no second
// half to drift from); and it is not compiler-owned, so a user file declaring its own meets
// `contestStdlibTypeName` like any other library nominal name rather than a reservation.

// ⭐⭐ **`IterationError` — WHAT A CURSOR'S `advance()` THROWS (conditional extensions).** Unlike the four
// error enums above it, the COMPILER never throws this one: it is thrown and caught entirely by USER code
// (`throw IterationError.exhausted` in an `advance()` body, absorbed by `for … in`'s step block). What the
// compiler owes is that the NAME resolves.
//
// ⭐ **AND IT RESOLVES TO THE CORPUS'S OWN DECLARATION.** `stdlib/Interfaces.maxon:28` declares it
// and the stdlib loader LISTS that module, so — unlike `ArrayError`/`StringError`/`MapError`, whose modules
// are unlistable because `Array`/`String`/`Map` are synthesized — this one has no seed in
// `Project.createEnumRegistry` and no transcription anywhere in the compiler. Its `extension
// Iterable` lands no second definition of `map` beside the compiler-owned `Array.map`: an interface
// extension is expanded onto the types whose `implements` clause REACHES that interface
// (`DeclaredConformerIndex.structConformersOf`), and `Array`/`Set`/`Map` are synthesized
// with no such clause — so `Iterable.map` reaches exactly the types that declare `implements
// Iterable`, of which the whole corpus and suite have none that also declare their own `map`.
//
// It is BARE rather than `__`-prefixed for `MapError`'s stated reason: a user `advance()` writes
// `throws IterationError` in its own source, so a reserved spelling would make one error type meet itself
// under two names. It stays on `TypeResolution.isCompilerOwnedTypeName` for a reason a listed module does
// not change: a USER declaration of the name would give one program two numberings of one enum.
let IterationErrorTypeName = b"IterationError"

// ⭐⭐ **DOES A DECLARED `throws` CLAUSE NAME `IterationError` — the ONE error type the traversal protocol's
// two fallible declarations may carry?** The loop absorbs what `advance()` and `createIterator()` throw
// WITHOUT binding it, which is sound for a compiler-owned payload-free enum and would leak for one carrying
// managed heap, so pinning the clause is what makes the absorption sound by construction.
//
// ⚠ **IT IS ASKED OF A CLAUSE, NOT OF A CALLEE NAME, BECAUSE THE TWO STORES THAT HOLD ONE ARE DIFFERENT
// STORES.** A struct source's protocol method is a DECLARED CALLEE (`ProgramSignatures.throwsOf`); an
// existential's is an interface REQUIREMENT, which is in no signature registry at all — its clause travels
// on the resolved `WitnessDispatchTarget`. One rule over the clause is what stops the two receiver kinds
// coming to accept different error types.
function throwsClauseIsIterationError(clause ThrowsClause) returns bool
	let thrown = try throwsClauseName(clause) otherwise return false
	return thrown.toByteArray().equals(IterationErrorTypeName)
end 'throwsClauseIsIterationError'

// ⭐⭐ **WHICH PREHEADER A `createIterator()` DECLARATION BUYS, read off its `throws` clause alone.** The
// three answers are separate because the loop emits three different preheaders: an INFALLIBLE factory seeds
// the header's error flag with a literal 0; a THROWING one seeds it with the call's own flag, so an empty
// collection — which `stdlib/Interfaces.maxon:132-134` says the constructor reports by throwing `exhausted`
// — runs zero trips through the very test that ends the walk; and a factory throwing anything ELSE is a real
// declaration the loop cannot use, so it is its own answer rather than being folded into `notDeclared`.
//
// Split from `ProgramSignatures.iterableFactory` at the same door `throwsClauseIsIterationError` was, and for
// the same reason: the EXISTENCE half differs per store (a declared callee against an interface requirement)
// while the classification is one rule.
function iterableFactoryFromClause(clause ThrowsClause) returns IterableFactory
	if not throwsClauseIsThrowing(clause) 'infallible'
		return IterableFactory.infallible
	end 'infallible'

	if not throwsClauseIsIterationError(clause) 'someOtherError'
		return IterableFactory.throwsSomethingElse(throwingClauseTypeName(clause))
	end 'someOtherError'

	return IterableFactory.throwsIterationError
end 'iterableFactoryFromClause'

// ⭐ **THE ERROR TYPE A CLAUSE ALREADY ESTABLISHED AS THROWING NAMES — the ONE spelling of that assertion in
// this file.** `none` here is never a program's property: every caller has already separated the two arms,
// either through `throwsClauseIsThrowing` (`iterableFactoryFromClause` above) or by reading the clause back
// out of a registry only a throwing declaration reaches (`ProgramSignatures.recordThrows` files nothing else
// and returns before writing). So the failure it names is two readings of ONE union disagreeing, and there is
// exactly one thing to say about that — which is why the panic is written here rather than at each door.
function throwingClauseTypeName(clause ThrowsClause) returns String
	return try throwsClauseName(clause) otherwise panic("throwingClauseTypeName: a clause answered `throwing` to `throwsClauseIsThrowing` and `none` to `throwsClauseName` — one union, two readings")
end 'throwingClauseTypeName'

// The `element_size@24` of a MANAGED-element array — a managed element (String / struct /
// union / instance / nested Array) is a HEAP BOX addressed by a POINTER, so a slot holds the 8-byte pointer,
// NOT the element's full logical size. A trivial element is stored inline and strides by its own size (an
// `int` 8, a `Byte = int(0 to u8.max)` 1). This is why `arrayElementSize` cannot simply be the source
// `sizeof`: the STORAGE width of a managed element is the pointer — a `String` element's slot is 8, where
// its `sizeof` is the whole record (`StringRuntime.StringRecordBytes`) — and the drop walk /
// accessors move exactly that pointer.
let ManagedArrayElementBytes = 8 as ElementStride

// ⭐ **A `bool` ELEMENT IS ONE BIT** — the width `Array with bool` packs at, and the only element whose
// packed width is not read off a declared range (`bool` is a TAG, not a ranged alias, so it has no `low`/
// `high` for `rangedAliasPackedBits` to read): the ranged widths are derived from bounds, this one
// is definitional.
let BooleanPacking = ElementPacking.oneBit

union InlineRecordShape
	notInline
	packed(bitWidths BitWidthArray)
end 'InlineRecordShape'

enum InlineFieldLookup implements Error
	notPackable
end 'InlineFieldLookup'

function inlineRangedAliasBits(alias RangedTypeAlias) returns BitWidth throws InlineFieldLookup
	if maxonTypeTag(alias.underlying) != ValueTypeTag.integer or alias.low != 0 'onlyAZeroBasedIntegerMapsOntoItsBits'
		throw InlineFieldLookup.notPackable
	end 'onlyAZeroBasedIntegerMapsOntoItsBits'

	return inlineFieldBits(rangedAliasPackedBits(alias.low, high: alias.high), storageBytes: rangedAliasStorageBytes(alias.low, high: alias.high))
end 'inlineRangedAliasBits'

// ⭐⭐ **THE SLOT A PAYLOAD-FREE ENUM'S VALUE OCCUPIES — the narrowest width holding every declared TAG
// (`ir-specs/enum-narrow-storage.md`).** A payload-free enum's value IS its tag (`Parser.emitEnumTagOf`), so
// the set the slot must hold is exactly `caseTags`, and the min/max of that set is what the ladder is asked.
//
// ⭐⭐ **THE TAG SET IS THE RIGHT QUESTION AT EVERY BACKING, AND THAT IS WHY THERE IS NO `EnumBacking`
// DISPATCH HERE — the general sentence, not a case list.** The ladder is asked about what is STORED, and
// what is stored is the tag (`Parser.emitEnumTagOf`: an unboxed enum's value IS its tag). So the answer is
// right whatever the tag MEANS, at every backing there is and at every backing there will be — which is a
// property this function has, where an enumeration of backings would be a claim it maintains by hand.
//
// The spec's ladder is written over "raw values"; for the INTEGER backing the tag IS the raw value, so the
// two readings coincide on every case the spec pins. Where they part it is still the tag that occupies the
// slot: a `character` tag is a codepoint, a `string`/`functionRef` tag is a declaration index (the value
// lives in `.rdata`, reached by a select over the tag), a `structRecord` tag likewise, and a `float` tag is
// an IEEE-754 bit pattern.
//
// ⛔ **DO NOT REPLACE THIS WITH A PER-BACKING ARGUMENT — THE ONE THAT STOOD HERE WAS FALSE.** It claimed a
// float backing lands on the machine word "because a double's pattern does not fit four bytes", and
// `enum Zero: float { z = 0.0 }` has `caseTags = [0]` ⇒ a **ONE-byte** slot. The answer was still correct —
// one byte holds that tag and the tag is what is stored — but for a reason the comment did not give, which
// is how a per-case argument here rots while the code stays right. (A narrow SIGNED float slot needs a tag
// in `[-2³¹, -1]`, i.e. a NEGATIVE NaN or a large-magnitude negative double's pattern; `-1.0` is
// `0xBFF0000000000000`, far outside it, so it is reachable in principle and by nothing anyone writes.)
//
// A declaration with NO cases has an empty value set, so every width holds it; the machine word is the
// answer because there is nothing to gain from narrowing a type no value inhabits, and it is what the
// walk below would otherwise have to invent a first bound out of.
function payloadFreeEnumTagSlot(layout EnumLayout) returns StorageSlot
	// ONE walk for both bounds — `Project.enumTagSpan`'s, shared with the synthesized error union that
	// measures a member the same way. `valueRangeStorageSlot`'s precondition (`low <= high`) is structural
	// because the two ends are derived together there.
	match enumTagSpan(layout) 'span'
		noCases then return StorageSlot.machineWord()
		spanning(low, high) then return valueRangeStorageSlot(low, high: high)
	end 'span'
end 'payloadFreeEnumTagSlot'

// ⭐⭐ **THE TWO NAMES the compiler GIVES A BYTE — the ROSTER, in one place.** `Byte` is the
// user-visible element a `b"…"` literal, a `ByteArray` and `__ManagedMemory` all share; `__ManagedByte` is
// the compiler-owned element EVERY COMPILER-SYNTHESIZED byte buffer wears (`SynthesizedByteElementName`; see its header below for the
// two sightings that forced the class name). Everything else a program can name is some OTHER type that
// happens to be narrow.
//
// ⚠ **IT IS A ROSTER AND NOT A WIDTH, AND CONFLATING THE TWO WAS A MEASURED WRONG ANSWER.**
// `rangedAliasStorageBytes` hands EVERY non-negative range that fits `u8.max` a one-byte slot, so "strides one
// byte" is a far larger set than "is a byte": `typealias Small = int(0 to 200)` is in the first and not the
// second. Both readers need the roster and neither may substitute the width for it — the width
// FALLBACK above, because these are the two names no file declares and whose stride is therefore the
// compiler's to state, and `byteBufferBoundaryAdmits`, because a door that read the width instead admitted a
// String's byte 223 into an element declared `int(0 to 200)` with no diagnostic.
//
// ⛔⛔ **AND THE ROSTER IS NOT A RANGE EITHER — IT DOES NOT CURE THAT READING.** It closes the 223 for
// `Small`, which is not a byte NAME, so the door refuses. Spell the very same declaration `Byte` and the
// roster answers YES — a roster is a question about the name, which is the whole point of the base-name
// strip below — the stride still answers YES, and **the identical 223 comes straight back** (MEASURED:
// `takes(<a cwd buffer>)` against `typealias Byte = int(0 to 200)`, exit 223, no diagnostic). The user's
// most natural spelling was the one nothing checked. What closes it is a third question that is neither a
// name nor a width — the element's declared BOUNDS
// (`RangedAliasRegistry.holdsEveryByteInEveryFile`, asked from `byteBufferBoundaryAdmits`). A cure claimed
// in a header is exactly how the next reader inherits the bug, so: this function is a NAME test, it is
// only ever one third of that door, and it must not be read as more.
//
// ⚠⚠ **IT ASKS ABOUT THE *BASE* NAME, AND WITHOUT THAT THE ROSTER SHUTS THE STDLIB'S OWN DOOR.** Once
// a contested `Byte` is qualified per claimant, the stdlib's element is spelled `Byte$0_255` — literally
// equal to neither roster entry — so `stdlib/File.maxon:140`'s `FileWriter.open(path.path.addressableBytes())`
// would stop compiling in exactly the program this scoping exists to fix. `Byte$0_255` IS `Byte`; the suffix
// says WHICH declaration of it, and a roster is a question about the name, never about the range. The two
// sides are asked the same way so a mint can never be on the roster from one side and off it from
// the other.
function isByteElementName(name ByteArray) returns bool
	let base = aliasBaseName(name)
	return base.equals(ByteElementTypeName) or base.equals(SynthesizedByteElementName)
end 'isByteElementName'

export enum ArrayBitwiseKind
	neither
	equalsOnly
	equalsAndHash
	floatHashOnly
end 'ArrayBitwiseKind'

let EightBitElementBytes = 1
let SixteenBitElementBytes = 2
let ThirtyTwoBitElementBytes = 4
let SixtyFourBitElementBytes = 8

enum ArrayElementClass
	notBitwise
	integer
	namedValue
	booleanOrExitCode
	floatValue
end 'ArrayElementClass'

// ⭐ **THE INCLUSIVE INTEGER VALUE SET A TRIVIAL ARRAY ELEMENT ADMITS, WHEN IT HAS ONE** — the answer
// `ProgramSignatures.elementIntegerValueRange` gives, and a UNION because *"this element has no integer
// value set"* is an ANSWER and not a failure: a `bool`, an enum and an `ExitCode` are perfectly good
// elements, they simply cannot be compared to another element by RANGE. `DeclaredAlias`'s shape, for
// `DeclaredAlias`'s reason.
union ElementIntegerRange
	notIntegerValued
	inclusive(low FullRangeInt, high FullRangeInt)
end 'ElementIntegerRange'

// The value set a BARE `int` element admits — the machine word's whole signed range, which is EXACTLY what
// `typealias Integer = int(i64.min to i64.max)` spells. Named because that identity is load-bearing rather
// than incidental: `[1, 2, 3]` mints `Array with int` and `IntArray.create()` mints `Array with Integer`,
// two instances over one value set, and `arrayAppendArgAdmits` joins them on these two numbers alone.
let BareIntegerElementLow = i64.min as FullRangeInt
let BareIntegerElementHigh = i64.max as FullRangeInt

// A ranged alias's declared bounds as a value set — `notIntegerValued` for a FLOAT alias, whose `low`/`high`
// are IEEE-754 bit patterns and order nothing like integers (`floatOrderKey` is where that is spelled
// out), so the honest answer is that there is no comparison to make rather than an invented one.
//
// ⚠ The float arm is LIVE — `typealias Reals = Array with Real` is a spellable element — and
// `error.a-raw-byte-write-is-refused-on-a-declared-float-element` is the program that reaches it.
function integerAliasValueRange(alias RangedTypeAlias) returns ElementIntegerRange
	if aliasIsFloat(alias) 'aFloatAliasHasNoIntegerValueSet'
		return ElementIntegerRange.notIntegerValued
	end 'aFloatAliasHasNoIntegerValueSet'

	return ElementIntegerRange.inclusive(alias.low, high: alias.high)
end 'integerAliasValueRange'

// ⭐ **DOES `[destLow, destHigh]` CONTAIN EVERY VALUE OF `[sourceLow, sourceHigh]`?**
//
// ⚠⚠ **A RAW-NEGATIVE BOUND IS AMBIGUOUS AND IS ANSWERED NO — the same conservative direction
// `rangeHoldsEveryByte` argues for at length, for the same reason.** Bounds ride as the RAW 64-bit pattern
// `FullRangeInt` holds, so `-1` and `u64.max` are the SAME BITS: `int(0 to u64.max)`'s `high` reads as `-1`,
// and a signed `>=` would cheerfully declare `int(0 to 100)` wide enough to hold it. This door ADMITS a run
// of values into a declared element, so the ambiguous answer has to be refusal.
//
// ⭐ **THE BIT-EQUALITY ARM RUNS FIRST, AND IT IS WHAT MAKES THE FULL-WIDTH CASE WORK AT ALL.** `int` and
// `int(i64.min to i64.max)` are one value set whose `low` IS raw-negative, so the ordered comparison could
// never reach it. Two identical bound pairs are one value set whatever the bits mean, which needs no
// interpretation of them.
function inclusiveRangeContains(destLow FullRangeInt, destHigh FullRangeInt, sourceLow FullRangeInt, sourceHigh FullRangeInt) returns bool
	if destLow == sourceLow and destHigh == sourceHigh 'oneValueSetSpelledTwice'
		return true
	end 'oneValueSetSpelledTwice'

	if destLow < 0 or destHigh < 0 or sourceLow < 0 or sourceHigh < 0 'aRawNegativeBoundIsAmbiguous'
		return false
	end 'aRawNegativeBoundIsAmbiguous'

	return destLow <= sourceLow and destHigh >= sourceHigh
end 'inclusiveRangeContains'

// ⭐⭐ **DOES `low to high` CONTAIN EVERY UNSIGNED VALUE OF A `slotBytes`-WIDE SLOT?** The range half of
// `ProgramSignatures.elementAdmitsEverySlotValue`, spelled apart from it because it is a statement about a
// RANGE and not about an instance — `Project.rangeHoldsEveryByte`'s own arrangement, which this is the
// general form of, and whose ONE-BYTE case it therefore asks rather than re-spelling. The slot's value set
// is UNSIGNED because the load of an unsigned slot zero-extends (`ManagedMemoryRuntime.emitStrideSlotLoad`).
//
// ⚠⚠ **THE WHOLE MACHINE WORD IS THE ONE SLOT TWO DIFFERENT DECLARATIONS FILL, AND NEITHER CAN BE ORDERED
// AGAINST IT.** `int(i64.min to i64.max)` fills it from the signed side and `int(0 to u64.max)` from the
// unsigned side; both carry a RAW-NEGATIVE bound (`RangedTypeAlias`'s header), so an ordered `>=` would read
// `int(0 to 100)` as wide enough for either. It is a bit EQUALITY against each spelling — the reason
// `inclusiveRangeContains` above opens with `oneValueSetSpelledTwice` — and every OTHER range at this width
// is refused, which is correct rather than conservative: `rangedAliasStorageBytes` is the UNSIGNED ladder, so
// `int(-5 to 5)` keeps the word without filling it, and MEASURED without this rule one raw byte reads back
// **223** out of an element declared `int(-5 to 5)`.
//
// ⚠ Below the word both bounds are honest small non-negative numbers, exactly BECAUSE the ladder gave the
// range a narrow slot at all — a raw-negative bound would have taken the word — so ordering is safe there,
// and the `>=` is the same shape (and, at one byte, literally the same call) `rangeHoldsEveryByte` uses.
//
// ⚠ The LOW end is `SlotUnsignedMin` and NOT `Project.ByteValueSetLow`:
// the two are the same zero for different reasons, and the reason a SLOT's is zero is the zero-extending
// loader's, not a byte's declared domain. `rawByteWriteSlotDomainMessage` already renders the slot's value
// set from `SlotUnsignedMin`, so with the byte's constant here the PREDICATE and the SENTENCE describing it
// would be two facts that happen to agree — the exact shape to avoid.
//
// ⚠⚠ **A SUB-BYTE-PACKED SLOT ANSWERS NO, AND THAT IS THE ONLY HONEST ANSWER RATHER THAN A CONSERVATIVE
// ONE.** This predicate's caller is admitting RAW BYTES into a declared element (`setByte`, and the byte
// boundary), and a packed element has no byte of its own to admit them into — 8, 4 or 2 of its fields SHARE
// one byte, so a byte write lands across several elements at once and the question "does this element's
// range hold every value of its slot" has no true answer, not merely an unknown one. It is tested first
// because every arm below reads `slotBytes` as a WIDTH, and a negative stride is a bit count.
function rangeHoldsEverySlotValue(low FullRangeInt, high FullRangeInt, slotBytes ElementStride) returns bool
	if slotBytes < 0 'aSubByteFieldSharesItsByteWithItsNeighbours'
		return false
	end 'aSubByteFieldSharesItsByteWithItsNeighbours'

	// Past the guard the stride is a genuine byte width (1/2/4/8), which is what the ladder below reads.
	let bytes = slotBytes as ByteOffset

	if bytes == (ByteStringElementSize as ByteOffset) 'aByteSlot'
		return rangeHoldsEveryByte(low, high: high)
	end 'aByteSlot'

	if bytes == MachineWordBytes 'theWholeWord'
		return (low == BareIntegerElementLow and high == BareIntegerElementHigh) or (low == SlotUnsignedMin and high == slotUnsignedMax(bytes))
	end 'theWholeWord'

	return low == SlotUnsignedMin and high >= slotUnsignedMax(bytes)
end 'rangeHoldsEverySlotValue'

// ⭐⭐ **THE ELEMENT OF EVERY COMPILER-SYNTHESIZED BYTE BUFFER — AND WHY IT IS NOT `Byte`.**
// A buffer the COMPILER mints is byte-packed by construction: `__str_bytes_view` publishes a record over a
// String's own buffer, whose `element_size@24` is 1 always, and the `__ManagedMemory` an OS runtime entry
// hands back (`emitOwnedManagedMemoryResult`) is a `mm_alloc`'d run of bytes. `Array with Byte` cannot carry
// either, because `Byte` is a name a USER PROGRAM may declare — `typealias Byte = int(0 to 1000)` makes
// `internArrayByteInstance()` stride TWO — and the buffer would then be a static type and a runtime record
// disagreeing about one instance's stride, which is the two-producer shape `arrayElementSize` exists to end.
//
// ⚠⚠ A wrong producer here breaks a STDLIB MODULE — which every program parses — because of a
// `Byte` alias in a program that never called it: `E3005 argument type mismatch for 'managed':
// expected '__ManagedMemory', got 'Array_Byte'`, raised inside the library.
// `specs/bytearray-element-size.md`'s two wide-`Byte` cases are the gate.
// ⇒ The first fix cured the ONE producer that had bitten, and the rule it wrote down was general while the
// name it wrote it under (`__ManagedByte`) was not — so the next synthesized byte buffer walked into the same
// wall. The element is now named for the CLASS, and every compiler-minted byte buffer wears it.
//
// ⚠ A `b"…"` literal meets the identical wall and is REFUSED for it (E2015, same spec), and that is not an
// inconsistency: a literal's element is the `Byte` the PROGRAM declares and the program can see the refusal.
// So is `__ManagedMemory.create(n, elementSize: 1)`, which is user-written and keeps `Byte`
// (`managedMemoryInstanceForElementSize`, pinned by `array-init.md`). The split is SYNTHESIZED vs WRITTEN,
// not string vs buffer: code the user did not write cannot be refused, so it takes an element the user
// cannot reach instead.
//
// ⚠⚠ Both producers ask `Parser.requireBytePackedRecordStridesLikeThisFilesByte`: a `create(n, 1)`
// that kept `Byte` unrefused would stamp stride 1 under a type striding 2, and `set(0, value: 300)`
// would read back **44**.
//
// It is `__`-RESERVED, so no program can declare it and `undeclaredNamedElementSlot` is the only
// answer for its width — the same reason `StringIndexTypeName` wears one. The rule is that a
// compiler-synthesized buffer's stride is the COMPILER's to state, never a function of which aliases the
// program happens to declare.
//
// ⚠ **THE RULE IS STATED HERE RATHER THAN BY REFERENCE TO ANY ONE APPLICATION OF IT.** `.codepoints()` /
// `.utf16()` are the corpus's lazy `CodepointView`/`UTF16View` and mint no array at all; a synthesized view
// of them would sit on the plain `integer` instance rather than on `Codepoint`/`CodeUnit16`, because those
// two element names are RANGED typealiases in stdlib modules — so its emitted element size would be a
// function of which files `stdlib/` happens to hold.
let SynthesizedByteElementName = b"__ManagedByte"

// ⭐⭐ **THE `StringIndex` TYPE — THE CORPUS'S DECLARATION, AND THE ONLY ONE.**
//
// `stdlib/String.maxon:931-964` declares it as an ordinary two-field `type` (`var charIdx as
// GraphemeIndex`, `var bytePosition as BytePos`), so the ordinary declaration sweep registers its
// `StructLayout` and the whole struct-value machinery follows — a binding's type, aggregate identity on a
// reassign, and a scope-exit drop through the trivial-struct `__mm_decref` — with no new `ValueTypeTag`
// and no new ownership rule.
//
// ⭐ **ONE DECLARATION, GUARDED BY THE ROUTE `String` AND `Character` ALREADY USE.** The registry is
// a MAP keyed by name, so a user's `type StringIndex` would land in the corpus's bucket and `slice`
// would then read a box through the USER's field table — silent memory corruption decided by file
// order. `StringIndex` is therefore on `TypeResolution.isCompilerOwnedTypeName`:
// `declarationContestsACompilerOwnedName` admits the corpus's declaration and drops a user's, and
// `requireTypeNameNotCompilerOwned` reports E2015
// at it. One declaration, one bucket, and the contest is unrepresentable rather than merely
// diagnosed. The bare name is what lets a `StringIndex` cross a function boundary: it is the name a
// parameter or return type spells.
let StringIndexTypeName = b"StringIndex"

// The two fields' declaration indices — what `Parser.dispatchStringIndexMethod` hands `emitFieldLoad`, against the layout the corpus's declaration registered. Named because an index IS
// the identity here (see `StructLayout.offsetOfField`), so a bare `0`/`1` at a read site is exactly the
// magic value the rule against them is for; and they are the CORPUS's declaration order
// (`stdlib/String.maxon:932-937`), which is the only thing that decides an offset.
let StringIndexCharIdxFieldIndex = 0 as FieldIndex
let StringIndexBytePosFieldIndex = 1 as FieldIndex

// ⭐⭐ **`CharacterSet`, AND WHY THERE IS NO SECOND, RESERVED LAYOUT BEHIND IT.** Registering a
// compiler-owned layout under the RESERVED name `__CharacterSet` beside this bare
// source spelling keeps a user `type CharacterSet` and the synthesized layout out of one bucket, and the
// cost is that such a type CANNOT CROSS A FUNCTION BOUNDARY: a parameter or return
// would have to NAME the reserved spelling, so every use has to flow from an accessor straight into a call
// or a local `let`.
//
// ⚠ Worse, once the corpus declares the type itself the reserved name buys no safety at all — it makes the
// declaration a SECOND one, as a corpus `type StringIndex` against a reserved `__StringIndex` makes
// `charAt(idx StringIndex)` unsatisfiable. The rule for both is **keep the
// RESERVATION, hold no second LAYOUT**; `stdlib/CharacterSet.maxon` is listed and declares this one. The
// reservation below is what `TypeResolution.isCompilerOwnedTypeName` reads.
//
// ⇒ What remains is the user-visible spelling: what a source `CharacterSet.letters` writes, resolved
// through the CORPUS declaration like any other listed type's name.
let CharacterSetBuiltinName = b"CharacterSet"

// ⭐ **THE COMPILER-OWNED `__ManagedFile` TYPE.** An 8-byte box holding one raw OS file HANDLE,
// with a runtime-owned destructor that closes it on drop — `specs/managed-file.md`'s "Type Structure"
// states the single `_handle` field and the RAII contract.
//
// ⚠ **THE REGISTRY NAME AND THE USER-FACING NAME ARE THE SAME BYTES HERE, AND THAT IS THE WHOLE REASON
// THIS TYPE CAN CROSS A BOUNDARY.** A type registered under a reserved
// `__`-prefixed name while the source spells a bare one cannot, and `CharacterSetBuiltinName`'s comment
// draws the consequence: such a type "cannot cross a function boundary, because a parameter or return type
// would have to NAME it". The corpus REQUIRES this one to cross — `specs/managed-file.md` writes
// `path __ManagedMemory` as a declared parameter and `export var file as __ManagedFile` as a field — and
// it can, because the name a user writes IS the name the layout is registered under, so there is no
// second spelling to fail to resolve.
// ⇒ **The `__` prefix is therefore NOT a barrier here, and that was MEASURED rather than assumed:**
// `requireUnreservedName`'s E2051 refuses a `__`-prefixed DECLARATION (`type __Foo`), not a `__`-prefixed
// name in a TYPE POSITION. A field declared at a reserved spelling nothing registers reports
// `E3011 Unknown type`, not E2051 — it fails to RESOLVE, and resolving is what registering the layout fixes.
// ⇒ And `StringIndex` is the third answer to the same question: it takes the bare name outright and
// crosses a boundary, because the CORPUS declares it and a reservation over *whose* declaration
// wins needs no second spelling at all (`StringIndexTypeName`).
let ManagedFileTypeName = b"__ManagedFile"

// ⭐ **`__ManagedMemory` IS AN `Array`, NOT A TYPE OF ITS OWN.** Registered as
// a builtin GENERIC ALIAS bound to
// the exact instance `internArrayByteInstance()` mints, which is the instance `"…".toByteArray()` already
// yields and the one a `b"…"` literal already has. So a `path __ManagedMemory` parameter and the argument
// handed to it are ONE type by construction, and `.managed` is an identity rather than a conversion.
//
// ⭐⭐ **THE BINDING IS ELEMENT-AGNOSTIC.** `__ManagedMemory` is generic over
// ONE parameter named `Element`, and `Array` is implemented ON it (`stdlib/Array.maxon:101-106`:
// `typealias ElementMemory = __ManagedMemory with Element`, `export var managed as ElementMemory`), so
// `__ManagedMemory with T` and `Array with T` describe ONE record. The compiler SYNTHESIZES that record
// instead of compiling `stdlib/Array.maxon`, so for the compiler they ARE one
// `GenericInstanceId` — which is what makes `.managed` an identity read at EVERY element type and leaves
// nothing to reconcile at `String.init`, `.toByteArray()`, `valueIsByteArray` or a `__ManagedFile`
// parameter. A distinct generic base would mint a second id at each of those.
// ⇒ The bare spelling (no `with`) keeps meaning the BYTE instance, because that is what every
// `__ManagedFile` signature declares and what a path buffer is.
//
// ⚠ **THE TWO SURFACES OF ONE RECORD ARE THEREFORE TOLD APART BY PROVENANCE, NOT BY TYPE** — see
// `Parser.valueIsBufferSurface`. Two TYPES would separate `Array.count()` from `ByteMemory.length()`;
// The compiler has ONE record, so it carries "this value denotes the BUFFER" on the value instead. That is the
// price of the binding, and it is the smaller one: the alternative is two ids for one record.
let ManagedMemoryTypeName = b"__ManagedMemory"

// ⭐⭐ **`__ManagedMemory with T` IS `Array with T`, WRITTEN OUT** — the generic-BASE spelling of the
// binding the bare name already has. The two describe ONE record and for the compiler they
// ARE one `GenericInstanceId`. Registering the ARITY-ZERO alias alone leaves the base spelling —
// which `stdlib/Map.maxon`, `Array.maxon`, `FixedArray.maxon`, `Character.maxon` and `String.maxon` all write —
// answering `E2055 "Type '__ManagedMemory' has no associated types"`. With the base spelling registered the
// annotation compiles and `stdlib/FixedArray.maxon` probes `E3001` and nothing else; why `FixedArray` is
// synthesized rather than read is a different fact entirely and is stated at `FixedArrayBuiltinBaseName`.
//
// ⭐ **CANONICALIZING AT THE READ IS WHAT KEEPS IT ONE INSTANCE.** Every downstream door — the arity check,
// the intern key, `genericInstanceBoxSize`, the drop callee, the element accessors — asks about a base NAME,
// so mapping the spelling once here means none of them learns a second name for one record. The alternative,
// teaching `isBuiltinGenericBaseName` a seventh base, would give `__ManagedMemory with Byte` and
// `Array with Byte` two ids and undo the binding at every one of those doors.
//
// ⚠ **THE SPELLING IS NOT MERELY DISCARDED — IT DECIDES THE MEMBER SURFACE**.
// It is carried to the declaration sites separately (`GenericAliasEntry.baseIsBuffer` ⇒
// `ProgramSignatures.aliasDenotesBufferSurface`), because a value's surface is a fact about the SPELLING and
// the type is deliberately the same either way.
//
// ⭐⭐⭐ **AND THE TARGET IS DISCOVERED, NOT WRITTEN DOWN — SEE
// `Parser.canonicalGenericBaseNameInThisFile`, WHICH IS THE WHOLE OF THE FOLD.** It reads the
// target off the `BuiltinArrayLiteral` conformance — the user's own stated exception to *"nothing
// array-specific in the compiler"* — and the rule lives in the parser because the answer depends on
// the READER (a stdlib file spells the corpus's declaration under the contest's mint) and on the
// ENCLOSING DECLARATION (inside a conformer's own body a written `__ManagedMemory` is that
// conformer), and neither is a fact a free function over one name can see.

// ⭐⭐ **ONE DECLARED TYPE POSITION'S PRE-ERASURE `__ManagedMemory` SPELLING.** A parameter's
// annotation, a struct field's, a return clause's: each is a place where the SOURCE said something no
// `MaxonType` can still say, because `parseTypeReference` folds `__ManagedMemory` into the very
// `genericInstance(Array with Byte)` a `ByteArray` resolves to (`registerManagedFileType`).
//
// TWO facts per position, because a declaration can name the buffer as the position itself or one container
// in, and each decides a different value's member roster:
//   • the position IS the buffer                  — `m __ManagedMemory`
//   • the position's ARRAY ELEMENT is the buffer  — `a BufArray`, `BufArray = Array with __ManagedMemory`
//
// ⭐⭐ **AND A TUPLE POSITION CARRIES ONE WHOLE SURFACE PER SLOT, WHICH IS WHY THIS IS A TREE AND NOT A
// MASK.** A flat mask of one BIT per slot could say "I am a buffer" and nothing else, so
// `(BufArray, Int)` and `((__ManagedMemory, Int), Int)` would lose their surfaces. A slot is a
// declared position like any other; it gets the same payload as any other, recursively.
//
// ⚠ **AND THAT REMOVES THE WIDTH QUESTION.** A mask has an arity ceiling and needs a REFUSAL to
// keep the slot past it from silently losing its bit — a lost bit being the wrong member roster
// with no diagnostic. A tree has one node per named position and no ceiling in either direction: no
// arity limit, no depth limit, nothing to truncate, and so nothing to refuse. The ceiling and its
// refusal are gone.
//
// ⚠ **THE TREE MAY NOT RIDE THE TUPLE'S `StructLayout` INSTEAD.** `(__ManagedMemory, Int)` and
// `(ByteArray, Int)` canonicalize to ONE interned tuple sharing ONE layout, so a surface written onto that
// layout would hand the buffer's roster to BOTH spellings — a wrong ACCEPTANCE, which no diagnostic reports
// and which `error.a-tuple-of-byte-arrays-keeps-the-array-surface` exists to hold shut. The declaration
// carries the fact and the VALUE carries it onward (`Parser.bufferSurfaceSlots`).

// ⭐ **ONE NODE OF THAT TREE, PACKED INTO A WORD.** Bit 0 is the position itself, bit 1 its array element,
// and everything above is the number of TUPLE SLOTS the node has — zero for a position that is not a tuple.
export typealias DeclaredSurfaceNode = int(0 to u64.max)

// ⭐⭐ **THE TREE, FLATTENED PRE-ORDER: node 0 is the position, and each node's slots follow it in order,
// each with its own subtree.** `(A, (B, C))` is `[tuple(2), A, tuple(2), B, C]`.
//
// ⚠ **FLAT AND PRE-ORDER RATHER THAN A RECORD THAT POINTS AT ITS CHILDREN, WHICH IS THIS COMPILER'S OWN
// ESTABLISHED SHAPE FOR EXACTLY THIS** — see `GenericArgNodeArray`, which flattens a nested `Base with (…)`
// the same way. It buys two things a record cannot: the element is an inline WORD, so a tree costs one
// allocation however deep it is; and a PLAIN position is the shared EMPTY tree, so it costs none at all.
// That matters because every door carries this fact as a column — one per parameter of every function in
// the program, one per field of every type — and all but a handful of them are plain.
export typealias DeclaredSurface = Array with DeclaredSurfaceNode

// @generated library-cache begin
function cacheWriteDeclaredSurface(writer LibraryCacheWriter, value DeclaredSurface)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		writer.unsigned(item as CacheUnsigned)
	end 'eachItem'
end 'cacheWriteDeclaredSurface'

// @generated library-cache end

// @generated library-cache begin
function cacheReadFrozenDeclaredSurface(reader LibraryCacheReader) returns immutable DeclaredSurface throws LibraryCacheDamage
	let count = try reader.count()
	let result = DeclaredSurface.create(count, zeroed: false) as isolated DeclaredSurface

	for _ in 0 upto count 'eachItem'
		let item = (try reader.unsigned()) as DeclaredSurfaceNode
		result.push(item)
	end 'eachItem'

	return freeze result
end 'cacheReadFrozenDeclaredSurface'

// @generated library-cache end

// One declared surface per declared POSITION, in declaration order — a struct's fields
// (`StructLayout.fieldDeclaredSurfaces`) and a function's parameters (`Parser.parseFunctionParameters`).
export typealias DeclaredSurfaceArray = Array with immutable DeclaredSurface

// @generated library-cache begin
function cacheWriteDeclaredSurfaceArray(writer LibraryCacheWriter, value DeclaredSurfaceArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		cacheWriteDeclaredSurface(writer, value: item)
	end 'eachItem'
end 'cacheWriteDeclaredSurfaceArray'

function cacheReadDeclaredSurfaceArray(reader LibraryCacheReader) returns DeclaredSurfaceArray throws LibraryCacheDamage
	let count = try reader.count()
	let result = DeclaredSurfaceArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try cacheReadFrozenDeclaredSurface(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadDeclaredSurfaceArray'

// @generated library-cache end

// Bit 0: the position itself was spelled `__ManagedMemory`.
let SurfaceBitIsBuffer = 1 as DeclaredSurfaceNode

// Bit 1: the position named a generic alias whose ELEMENT was spelled `__ManagedMemory`.
let SurfaceBitElementIsBuffer = 2 as DeclaredSurfaceNode

// ⭐⭐ **THE ONE GENERIC-ARGUMENT POSITION EITHER BIT EVER SPEAKS FOR, AND IT IS THE WHOLE REACH OF THE FACT
// RATHER THAN A FIRST CASE.** `SurfaceBitElementIsBuffer` says *argument 0 was spelled the buffer*, and
// argument 0 is the only argument any declaration RECORDS one for (`GenericAliasEntry.elementIsBuffer`, read
// off the first argument's token in `Parser.readGenericInstanceAlias`). So a reader that walked to argument 1
// would be asking about a fact nothing writes. Named here, once, so the recorder and the two readers below
// cannot come to hold different opinions about which argument the bit is about.
//
// ⚠ **THE BIT IS ABOUT AN ARGUMENT POSITION AND ITS NAME IS ABOUT AN ELEMENT, AND THE TWO COINCIDE ONLY
// BECAUSE OF WHO READS IT.** `Map with (__ManagedMemory, Int)` sets it for a KEY, since the recorder reads
// argument 0 whatever the base is. That is harmless and must stay so: every reader of the mark today is
// `Parser.emitContainerElementAccessor`, whose callers are `Array`, `List`, `FixedArray` and the array cursor —
// containers whose argument 0 IS their element. A derivation that narrowed itself to `Array` would make the
// derived answer disagree with the RECORDED one for the same declaration, which is worse than the overreach.
let BufferSurfaceArgPosition = 0

// Everything above the two flag bits is the node's SLOT COUNT. THE one speller of the shift, shared by the
// builder (`Parser.declaredSurfaceAt`) and the readers below, so the two cannot come to disagree about where
// a count ends and a flag begins.
let SurfaceSlotCountShift = 2 as DeclaredSurfaceNode

// The node a TUPLE position contributes: no flags of its own, and `slotCount` children behind it. A tuple
// value is an ordinary record whatever its slots denote, which is why its own two flag bits stay clear.
function tupleSurfaceNode(slotCount FieldIndex) returns DeclaredSurfaceNode
	// The count is bound rather than cast inline: a cast nested inside a shift draws a false E3010
	// (unneeded cast), the same reason `mixDefaultLiteral` binds a local.
	let widened = slotCount as DeclaredSurfaceNode
	return widened shl SurfaceSlotCountShift
end 'tupleSurfaceNode'

// Does this position name the buffer nowhere at all? The empty tree, which is what every plain declaration
// gets — asked wherever a caller wants to skip the whole mechanism for the overwhelmingly common case.
function surfaceIsPlain(surface DeclaredSurface) returns bool
	return surface.count() == 0
end 'surfaceIsPlain'

// Was the position ITSELF spelled `__ManagedMemory`?
function surfaceIsBuffer(surface DeclaredSurface) returns bool
	return (surfaceRootNode(surface) and SurfaceBitIsBuffer) != 0
end 'surfaceIsBuffer'

// Did the position name a generic alias whose ELEMENT was spelled `__ManagedMemory`?
function surfaceElementIsBuffer(surface DeclaredSurface) returns bool
	return (surfaceRootNode(surface) and SurfaceBitElementIsBuffer) != 0
end 'surfaceElementIsBuffer'

// How many TUPLE SLOTS this position has — zero for a position that is not a tuple, and zero for a plain
// one. It is what a reader asks before `surfaceSlot`, so a non-tuple never reaches the walk.
function surfaceSlotCount(surface DeclaredSurface) returns FieldIndex
	return surfaceNodeSlotCount(surfaceRootNode(surface))
end 'surfaceSlotCount'

// How many slots ONE node has. THE one decoder of the count field, so the root reader above and the
// pre-order subtree walk below cannot come to disagree about where a count ends and a flag begins.
function surfaceNodeSlotCount(node DeclaredSurfaceNode) returns FieldIndex
	return node shr SurfaceSlotCountShift
end 'surfaceNodeSlotCount'

// ⭐ **THE SURFACE OF TUPLE SLOT `slot` — A WHOLE SURFACE, WHICH IS THE POINT OF THE TREE.** The slot's own
// subtree, copied out so the result is rooted at node 0 and every reader can be handed a `DeclaredSurface`
// with no index alongside it. It allocates, and only here: a caller reaches this line only for a slot of a
// tuple that actually named the buffer somewhere.
//
// `slot` is a precondition, not a case — every caller asked `surfaceSlotCount` first.
function surfaceSlot(surface DeclaredSurface, slot FieldIndex) returns immutable DeclaredSurface
	let start = surfaceSlotStart(surface, slot: slot)
	let stop = start + surfaceSubtreeSize(surface, at: start)
	let out = DeclaredSurface.create(stop - start, zeroed: false) as isolated DeclaredSurface

	for i in start upto stop 'eachNode'
		out.push(surfaceNodeAt(surface, at: i))
	end 'eachNode'

	return freeze out
end 'surfaceSlot'

// ⭐ **THE SAME SURFACE WITH SPELLING BITS ADDED AT ITS ROOT.** The one WRITER outside the parser's builder,
// and it COPIES rather than mutating: the tree it is handed is the one stored on a `StructLayout` or in the
// whole-program return table, shared by every reader of that declaration, and setting a bit in place would
// teach one file's read to every other file's. Its caller is the door that must DERIVE the root's spelling
// bits rather than store them — see `ProgramSignatures.derivedAliasSurfaceBits`.
//
// ⚠ **IT TAKES THE BITS RATHER THAN NAMING ONE.** The element bit and its base-position twin are
// both underivable at the same door, off the same recorded name, and a second function beside this
// one would be a second copy of the copy-the-tree-and-OR-the-root rule — free to disagree the day
// the node grows a third bit.
function surfaceWithRootBits(surface DeclaredSurface, bits DeclaredSurfaceNode) returns immutable DeclaredSurface
	let out = DeclaredSurface.create(surface.count() + 1, zeroed: false) as isolated DeclaredSurface
	out.push(surfaceRootNode(surface) or bits)

	for i in 1 upto surface.count() 'eachRemainingNode'
		out.push(surfaceNodeAt(surface, at: i as FieldIndex))
	end 'eachRemainingNode'

	return freeze out
end 'surfaceWithRootBits'

// ⭐ **A WHOLE SURFACE FROM ROOT BITS ALONE — and the shared EMPTY tree when there are none, so a position
// that names the buffer nowhere allocates nothing.** THE one home for "bits ⇒ surface", shared by the token
// builder (`Parser.rootLeafSurfaceAt`) and by the two doors that DERIVE a root's bits rather than reading a
// stored tree: the instance-argument crossing (`Parser.slotSurfaceThroughReceiver`) and the alias-spelling
// stamp on a factory result. Written out, the emptiness test is the half a fourth site would forget — and it
// is not cosmetic, since it is what keeps every generic constructor call in the program allocation-free.
function plainDeclaredSurface() returns immutable DeclaredSurface
	return freeze DeclaredSurface.create(0)
end 'plainDeclaredSurface'

function surfaceOfRootBits(bits DeclaredSurfaceNode) returns immutable DeclaredSurface
	if bits == 0 'namesTheBufferNowhere'
		return plainDeclaredSurface()
	end 'namesTheBufferNowhere'

	return surfaceWithRootBits(plainDeclaredSurface(), bits: bits)
end 'surfaceOfRootBits'

// Node `at` of the tree. A precondition, not a case: every index handed here came from a walk that started
// at node 0 and advanced by whole subtrees.
function surfaceNodeAt(surface DeclaredSurface, at FieldIndex) returns DeclaredSurfaceNode
	return try surface.get(at) otherwise panic("surfaceNodeAt: node {at} is out of range for a {surface.count()}-node declared surface — every index came from a pre-order walk of this same tree")
end 'surfaceNodeAt'

// Node 0, or an all-clear node for the shared EMPTY tree. The empty tree is the plain answer, so reading it
// as a node with no flags and no slots is what makes every accessor above answer plainly without its own
// emptiness test.
function surfaceRootNode(surface DeclaredSurface) returns DeclaredSurfaceNode
	if surfaceIsPlain(surface) 'noNodes'
		return 0
	end 'noNodes'

	return surfaceNodeAt(surface, at: 0)
end 'surfaceRootNode'

// How many nodes the subtree rooted at `at` occupies — itself plus every descendant. THE one walk that knows
// pre-order layout, so `surfaceSlotStart` and `surfaceSlot` cannot come to disagree about where a subtree
// ends.
function surfaceSubtreeSize(surface DeclaredSurface, at FieldIndex) returns FieldIndex
	var size = 1 as FieldIndex
	let slots = surfaceNodeSlotCount(surfaceNodeAt(surface, at: at))

	for _ in 0 upto slots 'eachSlot'
		size = size + surfaceSubtreeSize(surface, at: at + size)
	end 'eachSlot'

	return size
end 'surfaceSubtreeSize'

// Fold a declared surface into a running hash — every node plus the node COUNT, so a tree that gained a
// slot cannot collide with the one it grew from (`mixBytes`' trailing length tag, for its reason). The
// surface is the one declaration fact `mixType` structurally cannot carry: `__ManagedMemory` and `ByteArray`
// fold to the identical `genericInstance`, so an edit between the two spellings would move no memo key while
// changing which member roster every caller's calls reach.
function mixSurface(state HashDigest, surface DeclaredSurface) returns HashDigest
	var h = state

	for node in surface 'eachNode'
		h = Hasher.combined(h, value: node as HashDigest)
	end 'eachNode'

	return Hasher.combined(h, value: surface.count() as HashDigest)
end 'mixSurface'

export type ProgramSignatures
	var ownSettled as OwnedDeclarations
	let sharedSettled as immutable SettledDeclarations
	var structSlots = StructSlotMap.create()
	var mintedTupleLayouts = StructLayoutArray.create(0)
	var published = SettledCellArray.create(0)

	// ⭐ Generic-instance interner — `Box with Integer` ⇒ a `GenericInstanceId`, id ⇒
	// `(baseId, argTypes)`. LIKE `structLayouts` IT CARRIES IDS (an arg is a `MaxonType`), so `foldFile`
	// remaps each entry's args into `typeNames` before interning. Read by the parser to resolve a
	// generic-alias call base and to check a generic instance's arity / managed args.
	var genericInstances as GenericInstanceRegistry

	// Each interned instance's COMPILED name, derived on first ask and kept — see `CompiledInstanceNameMap`
	// for the quadratic this removes. Empty for a program that instantiates no generic.
	var compiledInstanceNames as CompiledInstanceNameMap
	var canonicalInstanceNames as CanonicalInstanceNameMap

	// Which written instantiation each SUBSTITUTED instance came out of — see `SubstitutedInstanceOriginMap`.
	var substitutedInstanceOrigins as SubstitutedInstanceOriginMap

	// The reverse of `canonicalInstanceNames` — see `CanonicalInstanceNameIndex` for the quadratic it removes.
	// Filled by `indexCanonicalInstanceNames`, which is the ONLY writer, so the index and the watermark below
	// cannot disagree about which ids are in it.
	var canonicalInstanceNameIndex as CanonicalInstanceNameIndex

	// How far `canonicalInstanceNameIndex` has been filled: every id BELOW this is in the set. Instances are
	// append-only, so advancing it is monotone and the total work of keeping the set complete is O(instances)
	// across the whole compile however often it is asked.
	var canonicalNamesIndexedThrough as GenericInstanceId

	// ⭐ Every tuple name this index has seen ⇒ its CANONICAL one. A name the DECLARATION SWEEP minted
	// spells its elements the way the source wrote them (`__Tuple2.Integer.Integer`), because the alias
	// registry that says what `Integer` means is still being built when the sweep runs; `adoptType` rewrites
	// it to the canonical form (`__Tuple2.int.int`) at every read, and this memo is what makes that rewrite a
	// map hit rather than a re-derivation. A canonical name maps to itself, so one probe answers both
	// directions. Empty for a program with no tuples.
	var tupleCanonicalNames as TupleCanonicalNameMap

	// ⭐ Every registered tuple layout ⇒ the bounded token another tuple's name cites it by. A MEMO of
	// `tupleElementTokenFor` — see `TupleElementTokenMap` for the cost that buys. Empty for a
	// program with no tuples.
	var tupleElementTokens as TupleElementTokenMap

	// ⭐ Every minted token ⇒ its one owner, the half that makes a digest collision a DETECTED event: a tuple
	// name (`recordTupleElementToken` writes it and the map above in one act, so a divergence between them
	// stops the compile rather than handing two layouts one citation) or a separator-bearing element spelling
	// (`recordSeparatorBearingToken`, which has no forward memo).
	var tupleElementTokenOwners as TupleElementTokenOwnerMap

	// ⭐ A TUPLE typealias name ⇒ the tuple type it names — `Pair` ⇒ `__Tuple2.int.int`. The tuple
	// twin of `genericAliases`, and it exists for the same reason: a tuple type has no source-spellable name,
	// so `typealias Pair = (Num, Num)` is the only way to write one in a place that takes a bare identifier
	// (`Array with Pair`). Like a RANGED alias and unlike a function/generic one it mints NO nominal identity
	// — a `Pair` reference resolves straight through to the tuple's own `structRef` — so nothing downstream
	// ever sees the alias name. One row per name, LAST-WINS: which declaration a reader means is
	// `scopedTupleAlias`'s answer, and `tupleAliasTargetFrom` canonicalizes it — the sweep writes the spelling
	// it saw and the real parse the canonical one, exactly as every other tuple name does.
	var tupleAliases as DeclaredTupleAliasMap

	var multiplyDeclaredTupleAliases as MultiplyDeclaredTupleAliasMap

	// ⭐ **DOES ANY FILE IN THE PROGRAM MATERIALIZE A `[<identifier>…]` ARRAY LITERAL?** Set
	// by the sweep, read ONCE by `queryProgramSignatures` after the last file folds, which is what makes
	// `internLiteralContainerInstances` a single whole-program walk instead of a per-file one. A bool
	// and not a count: the over-interning is over every declared type, so one such file asks for exactly
	// what a thousand do.
	var sawAggregateArrayLiteral as bool

	// ⭐ **DOES ANY FILE IN THE PROGRAM MATERIALIZE A `List from […]` CONSTRUCTION?** The `List` half of the
	// bit above, read at the same moment and for the same reason: the construction's element type is the
	// source array literal's, so the `List with <T>` instances it may need are the same whole-program set of
	// declared types — one walk after the last file folds, not one per file.
	var sawListFromConstruction as bool

	// ⭐ **DOES ANY FILE IN THE PROGRAM NAME `<Enum>.allCases`?** The third bit of the same kind, read at the
	// same moment: the member's `Array with <Enum>` instance is one per declared enum and the sweep cannot
	// narrow which — its base may be a dotted `<Union>.unionCases` companion, and the enum registry is still
	// growing while the sweep runs — so it is the whole-program set, walked once.
	var sawEnumAllCasesAccess as bool

	// ⭐⭐ **THE OTHER EIGHT BITS OF THE SAME KIND — AND THEY BECAME WHOLE-PROGRAM FOR A CORRECTNESS REASON,
	// NOT THE THREE ABOVE'S MEASURED ONE.** Each names a construct whose instance the compiler MINTS,
	// because the source writes no type for it to be read from: a `[…]`, a `b"…"`, a `.bytes()`, a
	// `Set`/`List`/`FixedArray from […]`, or a producer of one of the three compiler-owned types. The mint's base
	// is the corpus's array record (`arrayRecordBaseName`), whose spelling the STDLIB/USER CONTEST may move —
	// and the contest is decided BETWEEN the two halves of the sweep, so a per-file mint in a USER file asked
	// before the answer existed and filed the program-wide memo under the pre-contest bare name. In a program
	// that declares its own `type Array` that name is the PROGRAM's container, so `b"Hi!".isEmpty()` was
	// refused as a member the program's own array does not have — a value whose type the reader never wrote.
	// ⇒ The file NOTES; `internWellKnownContainerInstances` interns, once, after the contest.
	var sawIntArrayLiteral as bool
	var sawByteStringLiteral as bool
	var sawStringArrayLiteral as bool
	var sawSetFromConstruction as bool
	var sawManagedFileProducer as bool
	var sawManagedDirectoryProducer as bool
	var sawManagedSocketProducer as bool
	var sawManagedHostResourceProducer as bool

	// ⛔⛔ **THE DECLARATION THE CONTEST FIXPOINT GAVE UP ON, OR `none`.** A round mints a contested
	// argument a spelling derived from that argument's instance, so each round adds one nesting level — which
	// converges on an acyclic declaration graph, whose nesting is bounded by its depth, and never converges on
	// a CYCLIC one. Recorded here rather than panicked, and answered by `firstCyclicAliasDecl`, because the
	// program that produces it is a program with a type cycle and **E3091 is the answer it is owed**.
	//
	// ⚠ **IT IS NOT REDUNDANT WITH THAT WALK, AND THE CASE THAT PROVES IT WAS MEASURED.** `buildInstanceArgGraph`
	// resolves a `named` argument through `denotedInstanceUnlessContested`, which gives a contested name no
	// edge — so two files declaring `P = Array with Q` / `Q = Array with P` between them, where one file's `P`
	// is `Array with High`, leave the graph without the edges through `P` and `Q` while the per-file view
	// cycles. The graph walk answers `none` there and the fixpoint is the only thing that can see it.
	var divergedGenericAliasDecl as AliasCycleResult

	// The nested cascade walks in flight, innermost last, and the shallowest optimistic break any of them has
	// taken — read together by `closeCascadeWalk` to decide which walks may memoize.
	//
	// ⚠ **BOTH ARE FRAME-LOCAL AND TOTAL**: every push is undone by its `truncate` and every break is merged
	// out by its frame, with nothing between that can throw, so both are clear at every fold boundary — which
	// is why neither is baselined or fingerprinted, unlike the sticky `deepCloneWalkReadInstances` below. A
	// path that left a root on the stack would poison every later answer about that name.
	var cascadeWalkRoots as NameRoster

	var cascadeBreakReached as CascadeWalkBreak

	// ⭐ `interfaceConformersSupportDeepClone`'s memo, kept on `deepCloneAnswers`' conditions and journaled
	// beside it.
	//
	// ⚠ **THE ROSTER IT ANSWERS OVER IS ONLY WHOLE ONCE EVERY FILE IS FOLDED**, which is the premise this memo
	// and `deepCloneAnswers`' `interfaceRef` arm both stand on: `Parser.parseTypeReference` mints an
	// `interfaceRef` tag only under `allFilesFolded`, so no question carrying one can be asked while
	// conformances are still arriving. Mint one earlier and both keep verdicts taken over half a program.
	var interfaceCloneAnswers as DeepCloneAnswerMap
	var uniqueTypeAnswers as DeepCloneAnswerMap

	var someRecordHoldsAnInterfaceValue as bool

	var recordsHoldingAnInterfaceValueCounted as bool

	// The interner every `named` id in `returnTypes` belongs to. PRIVATE, and it has to be: an id
	// may not leave this type. `returnTypeOf` re-interns it into the caller's own table.
	var typeNames as TypeNameInterner

	// The cross-file reads of INLINED constants — see `notedConstantValue` for why the IR cannot hold them.
	// Empty for every single-file program.
	var crossFileConstantReads as NameInFileArray

	var byRefNamesPublished as bool

	// ⚡ **HAS ANY RECORDED BODY RETURNED A BARE NAME AT ALL?** — the closure's precondition, raised at the
	// instant the fact arrives rather than re-derived by a pass over the map. Only a returned NAME can be a
	// seed (a `return f(…)` merely forwards), and reachability from an empty seed set marks nothing — so a
	// false here means the graph, its edge columns and the BFS are all skipped, which is every program whose
	// functions all return computed values. A stale TRUE builds a graph that marks nothing; a stale FALSE would
	// lose a refusal.
	var sawGlobalNameReturn as bool

	var globalAliasReturnsClosed as bool

	// ⭐ The deep-clone gate's answers, one per aggregate name. A pure MEMO of a walk over declarations — it
	// is written by `aggregateSupportsDeepClone` and read by nothing else, enters no hash, and a compile that
	// dropped it would answer identically and only slower.
	//
	// ⛔⛔ **THIS FIELD AND THE ONE BELOW ARE WRITTEN FROM THE PARSE PATH, WHICH IS THE ONE THING THIS
	// INDEX OTHERWISE FORBIDS.** `Parser.valueIsAnImageableDeepBox` reaches the gate at every durable-sink
	// value (`coOwnConcreteRecordForSink`) and every retain `emitRetainCall` and `holdRetainPlan` emit, so
	// these two words move while files are being parsed — against the invariant `deriveInstanceNames` and
	// `typeParamOwners` both state outright, that *"the per-file parse fan-out may READ this index and may
	// not write it"*. `deriveInstanceNames` exists solely to uphold it for memos of this class.
	//
	// ⚠ It is not a race: a front-end worker's parse writes the overlay's own copy of these two and
	// reads the base's, and `restoreBaseline` undoes what a parse on the index itself wrote. Moved
	// into `SettledDeclarations`, which every worker shares, they would be.
	var deepCloneAnswers as DeepCloneAnswerMap

	// Did the walk in flight READ the instance registry? Set by the two doors that scan a base’s row SET —
	// `instanceWithTypeArgKind` and `genericTypeIsInstantiated` — and read by `aggregateSupportsDeepClone` to
	// decide whether its answer may be kept. A parse-path write, exactly as the memo above is, and it carries
	// LESS state than the map but the same obligation: see there.
	var deepCloneWalkReadInstances as bool

	// `deepCloneAnswers` asked for the share walk, kept on that memo's conditions. The two walks answer differently for a graph that reaches an OS socket.
	var shareWalkAnswers as DeepCloneAnswerMap

	// Has the close run? It is a least fixpoint over the map above and its answer is memoized into
	// `funcReturnsFreshRecord` itself, so a second run would re-publish facts already published.
	var freshReturnForwardsClosed as bool

	var forwardedStoresClosed as bool

	// The content hash OF THE DECLARATIONS — not of the source they were read from. This is the
	// second half of a parse memo's key (`QueryEngine.parseMemoKey`), and hashing the folded
	// ENTRIES rather than the FILES is the whole point of it:
	//   • edit a function's BODY  ⇒ that file's content hash moves (it re-parses); this hash does
	//     NOT (no other file re-parses). Incrementality is preserved.
	//   • edit a RETURN TYPE      ⇒ this hash moves, and every file re-parses. Which is exactly
	//     right: every call to that function, in any file, may have changed meaning.
	// Keying the parse memo on the composite SOURCE hash instead would be sound and would throw
	// away the first property — one file's edit would re-parse the whole program.
	//
	// ⚠ A TOP-LEVEL CONSTANT PUTS ITS **VALUE** IN HERE, NOT JUST ITS NAME, AND THAT IS LOAD-BEARING
	// (`mixConstant`). A constant is the one declaration whose value is COPIED INTO its readers — a
	// use inlines it as a literal — so editing `export let MAGIC = 42` to `43` changes what every
	// other file COMPILES TO while leaving those files' own bytes, and so their own content hashes,
	// untouched. Only this hash can carry that. Measured, not assumed: with the warm-rebuild gate's
	// declaration probe pointed at a constant, a 7 → 8 edit re-parses every file in the project; the
	// gate's `invalidation` property is what keeps it that way.
	export var hash as HashDigest
	var hashSource as HashEventSource
	var authorChainState as HashDigest
	var libraryChainState as HashDigest
	var wholeChainState as HashDigest
	export var libraryHash as HashDigest
	export var libraryParseSharing as LibraryParseSharing
	var authorNameMeantByTheLibrary as bool

	// ⭐ **HOW MANY DECLARATIONS HAVE A `.data` SLOT** — written by `assignDataLabels`,
	// which is already the one walk that visits exactly them, and read once per compile by
	// `DeadGlobalElimination.liveGlobalLabels` to decide whether its module walk has anything to look
	// for. Zero for the whole existing corpus and for every rung of the scale ladder, which is what
	// keeps a dead-global pass free for a program that has no global.
	//
	// A COUNT rather than a bool because it is what the walk that produces it naturally has, and
	// because "how many slots does this program declare?" is the honest fact; the caller's question
	// ("any at all?") is one comparison away and does not need its own field.
	export var storedGlobalCount as StoredGlobalCount

	// ⭐ **HAS EVERY FILE BEEN FOLDED IN YET?** False while `queryProgramSignatures` is still sweeping
	// files into this index, true from the moment the last one lands. It is the index's own answer to
	// "can an absence be trusted?" — during the sweep a name that is genuinely declared reads as
	// undeclared simply because its file has not been folded yet (and a file's OWN declarations are
	// folded only after its whole token walk), so a `not declared` verdict there is a fact about the
	// sweep's progress, not about the program.
	//
	// It lives HERE and not on the `Parser` because it is a property of the INDEX, not of the reader:
	// three parsers read this index (the sweeper, the real parse, the initializer parses) and only the
	// index knows which side of the fold each of them is on. A flag threaded through `Parser.create`
	// would be the same fact written down at three call sites, free to be passed wrongly at any of them.
	export var allFilesFolded as bool

	export var inlineGeometrySettled = false

	export var rangeContestsSettled = false

	// ⭐ **IS THE PROJECT ROOT ITSELF UNDER `stdlib/`?** A per-COMPILE fact, probed once by
	// `Queries.queryProgramSignatures` and read at every `Parser.create` to derive that parser's
	// `livesUnderStdlibDirectory` — see `Queries.livesUnderStdlibDirectory` for the derivation, its proof and
	// the ladder measurement that rejected asking it per FILE instead.
	//
	// ⚠ It lives HERE rather than on `Project` because this index is the one thing already built once per
	// compile AND threaded to every `Parser.create` site, which is exactly the shape the fact has. It is set
	// before any file is swept, so no reader can see the seeded `false`.
	export var rootIsUnderStdlibDirectory as bool

	export var projectRootModuleDirectory as String

	// ⭐ **THE `Array with Byte` INSTANCE, DERIVED ONCE PER PROGRAM.** `internArrayByteInstance` is asked on
	// HOT parser paths — every byte-string literal, every `.toByteArray()`, and every array
	// METHOD dispatch (`dispatchArrayMethod`'s `isManagedMemory`) — and each ask built a one-element
	// `MaxonTypeArray` to key the registry with, which is a heap ALLOCATION per array method call. The
	// answer cannot change: `GenericInstanceRegistry` only ever grows and interning is idempotent, so the
	// id the first ask mints is the id for the life of this index (which is one compile —
	// `queryProgramSignatures` builds a fresh one per signatures miss).
	//
	// A `computed` flag beside the value rather than a sentinel id, following `TokenMemo`/`ParseMemo`:
	// **0 IS A REAL `GenericInstanceId`**, so there is no spare value to mean "not yet".
	var arrayByteInstance as GenericInstanceId
	var arrayByteInstanceComputed as bool

	var spawnsAnyServiceSettled = false
	var spawnsAnyServiceAnswer = false
	var byRefMasksSettled = false
	var functionValuedFieldNames = BareNameSet.create()
	var witnessByRefMasks = WitnessByRefMaskMap.create()
	var byRefConventionDigestAnswer = 0 as HashDigest
	var corpusByRefConventionDigestAnswer = 0 as HashDigest
	var liveDefaultKeyNames = LiveNameSet.create()
	var liveSpawnedTypeNames = LiveNameSet.create()
	var liveKeyAdoptions = 0 as LiveKeysRevision

	// Does any declaration OTHER than the corpus's carry the marker? The gate `isArrayBaseName` puts in front
	// of the scan — false for every program that declares no container of its own, which is the whole
	// existing corpus.
	var hasNonCorpusArrayConformer as bool

	var recordsTypeClaims = false

	// ⭐⭐ **THE SETTLED INDEX EVERY PARSE READS, AND WHAT HAS BEEN WRITTEN SINCE (B2).** A parse's output must
	// not depend on which other files were parsed first, so each one reads exactly this baseline plus its own
	// mints. Every write past the baseline is either an append a count restores or a key the journal lists, and
	// `restoreBaseline` puts the index back — after each parse, whose writes it hands to the artifact first, and
	// before each fold, whose merged writes the fold then redoes.
	var baseline as IndexBaseline
	var journal as IndexJournal

	// The row-set questions the open parse asked and what they were answered (`RowSetQuery`).
	var rowSetLog as RowSetLog

	// Whether a fold's merge has written this index since it was settled or last restored (`openParseBand`).
	var holdsAMerge = false

	var genericInstancesDigest = 0 as HashDigest

	// ⚠ **`os` IS THE COMPILE TARGET'S, AND IT IS HERE FOR EXACTLY ONE INDEX** — the
	// `RangedAliasRegistry` below, whose builtin `ExitCode` bound is platform-shaped and must be resolved
	// where a target is known (see `RangedAliasRegistry.exitCodeHigh`). This index is built once per
	// compile, so it costs one enum argument on a cold path.
	export static function create(os Os) returns ProgramSignatures
		let signatures = ProgramSignatures.freshIndexes(os)
		signatures.shareModuleDirectoriesWithProvenance()
		return signatures
	end 'create'

	// Every index, empty. Split out of `create` only so the seed stamping above reads as the two steps it
