	// THIS declaration is defective, and `error` is the positioned diagnostic for it. Held rather
	// than reported, because the sweep that found it is deliberately TOLERANT and has no business
	// vetoing a program (see `foldDeclaredSignaturesInto`). The REAL parse raises it, once, when it
	// reaches this line — which is also the only place that knows the diagnostic is about source the
	// user actually wrote rather than a name some other file mentioned.
	failed(error SourceParseError)

	// It has no value because a constant it READS has none. Silent by design: a second
	// diagnostic here would name a line whose only fault is mentioning a broken name.
	poisoned

	// ⭐ **IT EVALUATED TO A MANAGED LITERAL** — `bytes` is the decoded
	// payload and `kind` says which literal it came from. The `value` arm's twin, and a SEPARATE arm
	// rather than a widened one because the two payloads are different things: a number a reader copies
	// into a `literal` op, versus bytes a reader re-materializes as a record.
	managedValue(bytes immutable ByteArray, kind ManagedConstKind)

	// An initializer the sweep does not parse (a record, or anything with a call); `settleRecordInitializers`
	// replaces it with its settled answer.
	deferredRecord

	storedRecord(valueType MaxonType, brand immutable ByteArray, runsProgramCode bool, mapColumns MapLiteralColumns)

	imagedRecord(image TopLevelImageRecord)

	imagedBox(nodes ImmortalBoxNodeArray, root ElementIndex, typeName immutable ByteArray, tag ValueTypeTag)

	unvalidatedRecord(followUp InitializerFollowUp)

	// ⚠ **A NEW ARM GOES PAST THIS ONE, AND THAT IS THIS UNION'S OWN RULE:** declared at the END, no
	// existing arm names it, so every site that classifies this union fails to compile until it has been
	// visited and decided.
end 'TopLevelConstant'

// @generated library-cache begin
function cacheWriteTopLevelConstant(writer LibraryCacheWriter, value TopLevelConstant)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		pending then break
		evaluating then break
		value(a0, a1, a2) then cacheWriteTopLevelConstantValue(writer, a0: a0, a1: a1, a2: a2)
