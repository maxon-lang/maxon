		let f_enumConformers = try cacheReadConformerRosterMap(reader)
		let f_extensionConformers = try cacheReadConformerRosterMap(reader)
		let f_extensionsBuilt = try reader.flag()

		return Self{built: f_built, structConformers: f_structConformers, enumConformers: f_enumConformers, extensionConformers: f_extensionConformers, extensionsBuilt: f_extensionsBuilt}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize40
		return sizeof(DeclaredConformerIndex) as CacheSize40
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'DeclaredConformerIndex'

function appendConformerRoster(rosters ConformerRosterMap, interfaceName ByteArray, into NameRoster)
	if let roster = try rosters.get(interfaceName) 'hasConformers'
		for conformer in roster 'eachConformer'
			into.push(conformer)
		end 'eachConformer'
	end 'hasConformers'
end 'appendConformerRoster'

function groupConformersByInterface(names NameRoster, swept DeclaredConformanceMap, interfaces IrInterfaceMap) returns ConformerRosterMap
	let slotOfInterface = ConformerSlotByInterface.create()
	let interfaceNames = NameRoster.create(0)
	let pairSlots = ConformerPairArray.create(0)
	let pairConformers = NameRoster.create(0)
	let slotCursors = ConformerPairArray.create(0)

	for name in names 'eachDeclaredName'
		let declared = try swept.get(name) otherwise continue
		let reached = InterfaceNameSet.create()
		collectDeclaredInterfaceClosure(interfaces, declaredNames: declared, into: reached)

		for interfaceName in reached 'eachReachedInterface'
			pairConformers.push(name)

			if let slot = try slotOfInterface.get(interfaceName) 'knownInterface'
				pairSlots.push(slot)
				try slotCursors.set(slot, value: (try slotCursors.get(slot) otherwise panic("groupConformersByInterface: slotCursors.get OOB at {slot}")) + 1) otherwise panic("groupConformersByInterface: slotCursors.set OOB at {slot}")
			end 'knownInterface' else 'newInterface'
				slotOfInterface.upsert(interfaceName, value: interfaceNames.count())
				pairSlots.push(interfaceNames.count())
				interfaceNames.push(interfaceName)
				slotCursors.push(1)
			end 'newInterface'
		end 'eachReachedInterface'
	end 'eachDeclaredName'

	let slotStarts = ConformerPairArray.create(slotCursors.count() + 1, zeroed: false)
	var running = 0 as ElementIndex

	for slot in 0 upto slotCursors.count() 'eachSlotSize'
		let size = try slotCursors.get(slot) otherwise panic("groupConformersByInterface: slotCursors.get OOB at {slot}")
		slotStarts.push(running)
		try slotCursors.set(slot, value: running) otherwise panic("groupConformersByInterface: slotCursors.set OOB at {slot}")
		running = running + size
	end 'eachSlotSize'

	slotStarts.push(running)

	let placedPairs = PlacedPairColumn.create(pairSlots.count())

	for pair in 0 upto pairSlots.count() 'eachPair'
		let slot = try pairSlots.get(pair) otherwise panic("groupConformersByInterface: pairSlots.get OOB at {pair}")
		let position = try slotCursors.get(slot) otherwise panic("groupConformersByInterface: slotCursors.get OOB at {slot}")
		try placedPairs.set(position, value: pair) otherwise panic("groupConformersByInterface: placedPairs.set OOB at {position}")
		try slotCursors.set(slot, value: position + 1) otherwise panic("groupConformersByInterface: slotCursors.set OOB at {slot}")
	end 'eachPair'

	let rosters = ConformerRosterMap.create()

	for slot in 0 upto interfaceNames.count() 'eachInterface'
		let start = try slotStarts.get(slot) otherwise panic("groupConformersByInterface: slotStarts.get OOB at {slot}")
		let finish = try slotStarts.get(slot + 1) otherwise panic("groupConformersByInterface: slotStarts.get OOB past slot {slot}")
		let roster = NameRoster.create(finish - start, zeroed: false)

		for position in start upto finish 'eachPlacedPair'
			let pair = try placedPairs.get(position) otherwise panic("groupConformersByInterface: placedPairs.get OOB at {position}")
			roster.push(try pairConformers.get(pair) otherwise panic("groupConformersByInterface: pairConformers.get OOB at {pair}"))
		end 'eachPlacedPair'

		rosters.upsert(try interfaceNames.get(slot) otherwise panic("groupConformersByInterface: interfaceNames.get OOB at {slot}"), value: roster)
	end 'eachInterface'

	return rosters
end 'groupConformersByInterface'

function recordSweptConformances(declared DeclaredConformanceMap, name ByteArray, conformsTo NameRoster)
	if conformsTo.count() == 0 'declaresNone'
		return
	end 'declaresNone'

	let declaredInterfaces = InterfaceNameSet.create()

	for interfaceName in conformsTo 'eachInterface'
		declaredInterfaces.insert(interfaceName)
	end 'eachInterface'

	declared.upsert(name, value: declaredInterfaces)
end 'recordSweptConformances'

// ============================================================================================
// THE SETTLED BASELINE (B2)
// ============================================================================================

// ⭐ The first id a parse's own instance rows are handed out from (`GenericInstanceRegistry.parseBandOpen`):
// 2^40, far above any row count a program reaches, so no id a merge assigns is ever one.
let BandInstanceIdBase = 1099511627776 as GenericInstanceId

// ⚠ Nothing refuses a duplicate among the 64-bit marks (these, `CyclicGenericSlotMark` and the
// `RowSet*Mark`s) as E3031 does among `SignatureDiscriminator`'s, so a new one is checked against
// all of them by hand.
//
// The hash tag one settled instance row is mixed under, and the two marks its speculative flag is.
let DeclShapeInstanceRow = 0x5D1C34F0A9B2E781
let SpeculativeRowMark = 0x2F8A6C1D93E4B705 as HashDigest
let NamedRowMark = 0x71B3E95A0C2D48F6 as HashDigest
let DeclShapeFixedElementCountNeeds = 0x3C6EF372A54FF53A
let DeclShapeInstantiatedByAParse = 0xA54FF53A510E527F as HashDigest
let DeclShapeGenericInstances = 0x3C6EF372FE94F82B
let DeclShapeGenericTemplate = 0x9E3779B97F4A7C15 as HashDigest

export typealias LiveKeysRevision = int(0 to u64.max)

let LivenessSpawnsAService = 0x21BC50F31366E445
let LivenessBuildsADefault = 0x9B05688C2B3E6C1F as HashDigest
let LivenessTakesAParamByRef = 0x5BE0CD19137E2179
let LivenessMutableFunctionValues = 0x3C6EF372FE94F82B

let LivenessFunctionValuedField = 0x1F83D9AB5BE0CD19
let LivenessHandedOffSlots = 0xBB67AE8584CAA73B as HashDigest
let LivenessAuthorConformerConventions = 0x6A09E667F3BCC908

function nameIsExcluded(name ByteArray, excluded HashDigestSet) returns bool
	if excluded.contains(mixBytes(Hasher.empty(), bytes: name)) 'itself'
		return true
	end 'itself'

	let owner = try nameQualifierOf(name) otherwise return false

	return excluded.contains(mixBytes(Hasher.empty(), bytes: owner))
end 'nameIsExcluded'

// A set's digest whatever order it iterates in: each member is digested alone and the digests are combined by
// `xor`, which commutes.
function nameSetDigest(names BareNameSet) returns HashDigest
	var members = Hasher.empty()

	for name in names 'eachName'
		members = members xor mixBytes(Hasher.empty(), bytes: name)
	end 'eachName'

	return Hasher.combined(members, value: names.count() as HashDigest)
end 'nameSetDigest'

function nameSetDigestBeyond(names BareNameSet, excluded BareNameSet, among BareNameSet) returns HashDigest
	var members = Hasher.empty()
	var counted = 0 as Count

	for name in names 'eachName'
		if excluded.contains(name) or not among.contains(name) 'aNameNoCorpusParseReads'
			continue
		end 'aNameNoCorpusParseReads'

		members = members xor mixBytes(Hasher.empty(), bytes: name)
		counted = counted + 1
	end 'eachName'

	return Hasher.combined(members, value: counted as HashDigest)
end 'nameSetDigestBeyond'

let DeclarationSiteFieldSeparator = ":"

function declaringFileOfSite(site ByteArray) returns String
	let text = String.from(site)
	let columnSeparator = try text.findLast(DeclarationSiteFieldSeparator) otherwise panic("declaringFileOfSite: '{text}' is not a `path:line:column` declaration site")
	let beforeColumn = text.slice(text.startIndex(), endIndex: columnSeparator)
	let lineSeparator = try beforeColumn.findLast(DeclarationSiteFieldSeparator) otherwise panic("declaringFileOfSite: '{text}' is not a `path:line:column` declaration site")

	return beforeColumn.slice(beforeColumn.startIndex(), endIndex: lineSeparator)
end 'declaringFileOfSite'

function mixNameSet(state HashDigest, names DescriptorNeedNameSet, excluding HashDigestSet) returns HashDigest
	var members = Hasher.empty()
	var counted = 0 as Count

	for name in names 'eachName'
		if nameIsExcluded(name, excluded: excluding) 'anExcludedName'
			continue
		end 'anExcludedName'

		members = members xor mixBytes(Hasher.empty(), bytes: name)
		counted = counted + 1
	end 'eachName'

	return Hasher.combined(Hasher.combined(state, value: members), value: counted as HashDigest)
end 'mixNameSet'

// What `ProgramSignatures.settleBaseline` recorded: the scalars and append counts a restore puts
// back, and the fingerprint a restored index must match. An overlay's records the base it reads
// through.
type IndexBaseline
	export let settled as bool
	export let crossFileConstantReadCount as ElementIndex
	export let canonicalNamesIndexedThrough as GenericInstanceId
	export let arrayByteInstance as GenericInstanceId
	export let arrayByteInstanceComputed as bool
	export let deepCloneWalkReadInstances as bool
	export let someRecordHoldsAnInterfaceValue as bool
	export let recordsHoldingAnInterfaceValueCounted as bool
	export let fingerprint as IndexFingerprint
	export let overlaid as bool
	export let base as IndexBaseRef

	static function unsettled() returns IndexBaseline
		return Self{settled: false, crossFileConstantReadCount: 0, canonicalNamesIndexedThrough: 0, arrayByteInstance: 0, arrayByteInstanceComputed: false, deepCloneWalkReadInstances: false, someRecordHoldsAnInterfaceValue: false, recordsHoldingAnInterfaceValueCounted: false, fingerprint: IndexFingerprint.create(FingerprintDetail.valuesOnly), overlaid: false, base: IndexBaseRef.none}
	end 'unsettled'

	static function create(crossFileConstantReadCount ElementIndex, canonicalNamesIndexedThrough GenericInstanceId, arrayByteInstance GenericInstanceId, arrayByteInstanceComputed bool, deepCloneWalkReadInstances bool, someRecordHoldsAnInterfaceValue bool, recordsHoldingAnInterfaceValueCounted bool, fingerprint IndexFingerprint) returns IndexBaseline
		return Self{settled: true, crossFileConstantReadCount: crossFileConstantReadCount, canonicalNamesIndexedThrough: canonicalNamesIndexedThrough, arrayByteInstance: arrayByteInstance, arrayByteInstanceComputed: arrayByteInstanceComputed, deepCloneWalkReadInstances: deepCloneWalkReadInstances, someRecordHoldsAnInterfaceValue: someRecordHoldsAnInterfaceValue, recordsHoldingAnInterfaceValueCounted: recordsHoldingAnInterfaceValueCounted, fingerprint: fingerprint, overlaid: false, base: IndexBaseRef.none}
	end 'create'

	static function overlaying(settled IndexBaseline, base immutable IndexBase) returns IndexBaseline
		return Self{settled: true, crossFileConstantReadCount: 0, canonicalNamesIndexedThrough: settled.canonicalNamesIndexedThrough, arrayByteInstance: settled.arrayByteInstance, arrayByteInstanceComputed: settled.arrayByteInstanceComputed, deepCloneWalkReadInstances: settled.deepCloneWalkReadInstances, someRecordHoldsAnInterfaceValue: settled.someRecordHoldsAnInterfaceValue, recordsHoldingAnInterfaceValueCounted: settled.recordsHoldingAnInterfaceValueCounted, fingerprint: IndexFingerprint.create(FingerprintDetail.valuesOnly), overlaid: true, base: IndexBaseRef.over(base)}
	end 'overlaying'
end 'IndexBaseline'

// The tables and type names an overlay reads beside its own, published once and never written.
type IndexBase
	let tables as IndexTables
	let names as FrozenNames

	static function create(tables IndexTables, names FrozenNames) returns Self
		return Self{tables: tables, names: names}
	end 'create'

	// What a whole copy of the base's tables allocates. `FrontEndPool.pushHandoff` logs it, and
	// `front-end-copies-do-not-grow-with-workers` bounds a parse's overlay and an extra worker against
	// it.
	function copyAllocations() returns AllocCount
		let before = HeapStats.allocationsMade()
		let copy = self.tables.clone()
		let made = HeapStats.allocationsMade() - before
		copy.typeNames.releaseViewCache()

		return made as AllocCount
	end 'copyAllocations'
end 'IndexBase'

union IndexBaseRef
	none
	over(base immutable IndexBase)
end 'IndexBaseRef'

type IndexTables
	var structSlots as StructSlotMap
	var mintedTupleLayouts as StructLayoutArray
	var published as SettledCellArray
	var genericInstances as GenericInstanceRegistry
	var compiledInstanceNames as CompiledInstanceNameMap
	var canonicalInstanceNames as CanonicalInstanceNameMap
	var substitutedInstanceOrigins as SubstitutedInstanceOriginMap
	var canonicalInstanceNameIndex as CanonicalInstanceNameIndex
	var tupleCanonicalNames as TupleCanonicalNameMap
	var tupleElementTokens as TupleElementTokenMap
	var tupleElementTokenOwners as TupleElementTokenOwnerMap
	var tupleAliases as DeclaredTupleAliasMap
	var multiplyDeclaredTupleAliases as MultiplyDeclaredTupleAliasMap
	var cascadeWalkRoots as NameRoster
	var cascadeBreakReached as CascadeWalkBreak
	var interfaceCloneAnswers as DeepCloneAnswerMap
	var uniqueTypeAnswers as DeepCloneAnswerMap
	var typeNames as TypeNameInterner
	var crossFileConstantReads as NameInFileArray
	var deepCloneAnswers as DeepCloneAnswerMap
	var shareWalkAnswers as DeepCloneAnswerMap
	var witnessByRefMasks as WitnessByRefMaskMap
	var functionValuedFieldNames as BareNameSet
	var liveDefaultKeyNames as LiveNameSet

	static function create(structSlots StructSlotMap, mintedTupleLayouts StructLayoutArray, published SettledCellArray, genericInstances GenericInstanceRegistry, compiledInstanceNames CompiledInstanceNameMap, canonicalInstanceNames CanonicalInstanceNameMap, substitutedInstanceOrigins SubstitutedInstanceOriginMap, canonicalInstanceNameIndex CanonicalInstanceNameIndex, tupleCanonicalNames TupleCanonicalNameMap, tupleElementTokens TupleElementTokenMap, tupleElementTokenOwners TupleElementTokenOwnerMap, tupleAliases DeclaredTupleAliasMap, multiplyDeclaredTupleAliases MultiplyDeclaredTupleAliasMap, cascadeWalkRoots NameRoster, cascadeBreakReached CascadeWalkBreak, interfaceCloneAnswers DeepCloneAnswerMap, uniqueTypeAnswers DeepCloneAnswerMap, typeNames TypeNameInterner, crossFileConstantReads NameInFileArray, deepCloneAnswers DeepCloneAnswerMap, shareWalkAnswers DeepCloneAnswerMap, witnessByRefMasks WitnessByRefMaskMap, functionValuedFieldNames BareNameSet, liveDefaultKeyNames LiveNameSet) returns IndexTables
		return Self{structSlots: structSlots, mintedTupleLayouts: mintedTupleLayouts, published: published, genericInstances: genericInstances, compiledInstanceNames: compiledInstanceNames, canonicalInstanceNames: canonicalInstanceNames, substitutedInstanceOrigins: substitutedInstanceOrigins, canonicalInstanceNameIndex: canonicalInstanceNameIndex, tupleCanonicalNames: tupleCanonicalNames, tupleElementTokens: tupleElementTokens, tupleElementTokenOwners: tupleElementTokenOwners, tupleAliases: tupleAliases, multiplyDeclaredTupleAliases: multiplyDeclaredTupleAliases, cascadeWalkRoots: cascadeWalkRoots, cascadeBreakReached: cascadeBreakReached, interfaceCloneAnswers: interfaceCloneAnswers, uniqueTypeAnswers: uniqueTypeAnswers, typeNames: typeNames, crossFileConstantReads: crossFileConstantReads, deepCloneAnswers: deepCloneAnswers, shareWalkAnswers: shareWalkAnswers, witnessByRefMasks: witnessByRefMasks, functionValuedFieldNames: functionValuedFieldNames, liveDefaultKeyNames: liveDefaultKeyNames}
	end 'create'

	static function fresh(typeNames TypeNameInterner, liveDefaultKeyNames LiveNameSet) returns IndexTables
		return Self.create(StructSlotMap.create(), mintedTupleLayouts: StructLayoutArray.create(0), published: SettledCellArray.create(0), genericInstances: GenericInstanceRegistry.create(), compiledInstanceNames: CompiledInstanceNameMap.create(), canonicalInstanceNames: CanonicalInstanceNameMap.create(), substitutedInstanceOrigins: SubstitutedInstanceOriginMap.create(), canonicalInstanceNameIndex: CanonicalInstanceNameIndex.create(), tupleCanonicalNames: TupleCanonicalNameMap.create(), tupleElementTokens: TupleElementTokenMap.create(), tupleElementTokenOwners: TupleElementTokenOwnerMap.create(), tupleAliases: DeclaredTupleAliasMap.create(), multiplyDeclaredTupleAliases: MultiplyDeclaredTupleAliasMap.create(), cascadeWalkRoots: NameRoster.create(0), cascadeBreakReached: CascadeWalkBreak.nothingBroke(), interfaceCloneAnswers: DeepCloneAnswerMap.create(), uniqueTypeAnswers: DeepCloneAnswerMap.create(), typeNames: typeNames, crossFileConstantReads: NameInFileArray.create(0), deepCloneAnswers: DeepCloneAnswerMap.create(), shareWalkAnswers: DeepCloneAnswerMap.create(), witnessByRefMasks: WitnessByRefMaskMap.create(), functionValuedFieldNames: BareNameSet.create(), liveDefaultKeyNames: liveDefaultKeyNames)
	end 'fresh'
end 'IndexTables'

// What a map key held before a journaled write replaced it.
union PriorInstance
	absent
	held(id GenericInstanceId)
end 'PriorInstance'

union PriorTupleAlias
	absent
	held(alias DeclaredTupleAlias)
end 'PriorTupleAlias'

union PriorTupleAliasClaimants
	nameAbsent
	fileEntry(declPath String, prior PriorTupleAlias)
end 'PriorTupleAliasClaimants'

type CanonicalIndexWrite
	export let name as immutable ByteArray
	export let prior as PriorInstance

	static function create(name ByteArray, prior PriorInstance) returns CanonicalIndexWrite
		return Self{name: name, prior: prior}
	end 'create'
end 'CanonicalIndexWrite'

typealias CanonicalIndexWriteArray = Array with CanonicalIndexWrite

type TupleAliasWrite
	export let name as immutable ByteArray
	export let prior as PriorTupleAlias
	export let priorClaimants as PriorTupleAliasClaimants

	static function create(name ByteArray, prior PriorTupleAlias, priorClaimants PriorTupleAliasClaimants) returns TupleAliasWrite
		return Self{name: name, prior: prior, priorClaimants: priorClaimants}
	end 'create'
end 'TupleAliasWrite'

typealias TupleAliasWriteArray = Array with TupleAliasWrite

function priorInstanceAt(index CanonicalInstanceNameIndex, name ByteArray) returns PriorInstance
	if let id = try index.get(name) 'held'
		return PriorInstance.held(id)
	end 'held'

	return PriorInstance.absent
end 'priorInstanceAt'

function priorTupleAliasAt(aliases DeclaredTupleAliasMap, name ByteArray) returns PriorTupleAlias
	if let alias = try aliases.get(name) 'held'
		return PriorTupleAlias.held(alias)
	end 'held'

	return PriorTupleAlias.absent
end 'priorTupleAliasAt'

function priorTupleAliasClaimantsAt(claimants MultiplyDeclaredTupleAliasMap, name ByteArray, declPath String) returns PriorTupleAliasClaimants
	let byFile = try claimants.get(name) otherwise return PriorTupleAliasClaimants.nameAbsent

	if let held = try byFile.get(declPath) 'thisFileHadAnEntry'
		return PriorTupleAliasClaimants.fileEntry(declPath, prior: PriorTupleAlias.held(held))
	end 'thisFileHadAnEntry'

	return PriorTupleAliasClaimants.fileEntry(declPath, prior: PriorTupleAlias.absent)
end 'priorTupleAliasClaimantsAt'

// Every keyed write since the settle that a count cannot undo: the keys a write ADDED, and for each map a
// write can OVERWRITE, the value it replaced.
type IndexJournal
	export var tupleNames as NameRoster
	export var separatorBearingTokens as NameRoster
	export var canonicalTupleNames as NameRoster
	export var compiledNameIds as GenericInstanceIdArray
	export var canonicalNameIds as GenericInstanceIdArray
	export var canonicalIndexWrites as CanonicalIndexWriteArray
	export var originIds as GenericInstanceIdArray
	export var tupleAliasWrites as TupleAliasWriteArray
	export var deepCloneNames as NameRoster

	export var interfaceCloneNames as NameRoster
	export var uniqueTypeNames as NameRoster
	export var shareWalkNames as NameRoster

	static function create() returns IndexJournal
		return Self{tupleNames: NameRoster.create(0), separatorBearingTokens: NameRoster.create(0), canonicalTupleNames: NameRoster.create(0), compiledNameIds: GenericInstanceIdArray.create(0), canonicalNameIds: GenericInstanceIdArray.create(0), canonicalIndexWrites: CanonicalIndexWriteArray.create(0), originIds: GenericInstanceIdArray.create(0), tupleAliasWrites: TupleAliasWriteArray.create(0), deepCloneNames: NameRoster.create(0), shareWalkNames: NameRoster.create(0), interfaceCloneNames: NameRoster.create(0), uniqueTypeNames: NameRoster.create(0)}
	end 'create'

	function noteTupleName(name ByteArray)
		self.tupleNames.push(name)
	end 'noteTupleName'

	function noteSeparatorBearingToken(token ByteArray)
		self.separatorBearingTokens.push(token)
	end 'noteSeparatorBearingToken'

	function noteCanonicalTupleName(name ByteArray)
		self.canonicalTupleNames.push(name)
	end 'noteCanonicalTupleName'

	function noteCompiledName(id GenericInstanceId)
		self.compiledNameIds.push(id)
	end 'noteCompiledName'

	function noteCanonicalName(id GenericInstanceId)
		self.canonicalNameIds.push(id)
	end 'noteCanonicalName'

	function noteCanonicalIndexWrite(name ByteArray, prior PriorInstance)
		self.canonicalIndexWrites.push(CanonicalIndexWrite.create(name, prior: prior))
	end 'noteCanonicalIndexWrite'

	function noteOrigin(instance GenericInstanceId)
		self.originIds.push(instance)
	end 'noteOrigin'

	function noteTupleAliasWrite(name ByteArray, prior PriorTupleAlias, priorClaimants PriorTupleAliasClaimants)
		self.tupleAliasWrites.push(TupleAliasWrite.create(name, prior: prior, priorClaimants: priorClaimants))
	end 'noteTupleAliasWrite'

	function noteCascadeAnswer(name ByteArray, purpose GraphCascadePurpose)
		match purpose 'purpose'
			deepClone then self.deepCloneNames.push(name)
			shareWalk then self.shareWalkNames.push(name)
			send or
			sendPastFunctionValues or
			shareWalkPastFunctionValues then panic("IndexJournal.noteCascadeAnswer: the walk past function values names the obstacle of a refused transfer and is never memoized")
			sourceClone then panic("IndexJournal.noteCascadeAnswer: a source `.clone()` gate is asked once per receiver and is never memoized")
		end 'purpose'
	end 'noteCascadeAnswer'

	function noteInterfaceCloneAnswer(name ByteArray)
		self.interfaceCloneNames.push(name)
	end 'noteInterfaceCloneAnswer'

	function noteUniqueTypeAnswer(name ByteArray)
		self.uniqueTypeNames.push(name)
	end 'noteUniqueTypeAnswer'

	function mark() returns JournalMark
		return JournalMark.create(self.tupleNames.count(), separatorBearingTokens: self.separatorBearingTokens.count(), canonicalTupleNames: self.canonicalTupleNames.count(), compiledNameIds: self.compiledNameIds.count(), canonicalNameIds: self.canonicalNameIds.count(), canonicalIndexWrites: self.canonicalIndexWrites.count(), originIds: self.originIds.count(), tupleAliasWrites: self.tupleAliasWrites.count(), deepCloneNames: self.deepCloneNames.count(), interfaceCloneNames: self.interfaceCloneNames.count(), uniqueTypeNames: self.uniqueTypeNames.count(), shareWalkNames: self.shareWalkNames.count())
	end 'mark'

	function truncateTo(mark JournalMark)
		self.tupleNames.truncate(mark.tupleNames)
		self.separatorBearingTokens.truncate(mark.separatorBearingTokens)
		self.canonicalTupleNames.truncate(mark.canonicalTupleNames)
		self.compiledNameIds.truncate(mark.compiledNameIds)
		self.canonicalNameIds.truncate(mark.canonicalNameIds)
		self.canonicalIndexWrites.truncate(mark.canonicalIndexWrites)
		self.originIds.truncate(mark.originIds)
		self.tupleAliasWrites.truncate(mark.tupleAliasWrites)
		self.deepCloneNames.truncate(mark.deepCloneNames)
		self.interfaceCloneNames.truncate(mark.interfaceCloneNames)
		self.uniqueTypeNames.truncate(mark.uniqueTypeNames)
		self.shareWalkNames.truncate(mark.shareWalkNames)
	end 'truncateTo'

	function noteFingerprint(fingerprint IndexFingerprint, group String)
		fingerprint.openGroup(group)
		fingerprint.note("tupleNames", value: self.tupleNames.count() as EntryCount)
		fingerprint.note("separatorBearingTokens", value: self.separatorBearingTokens.count() as EntryCount)
		fingerprint.note("canonicalTupleNames", value: self.canonicalTupleNames.count() as EntryCount)
		fingerprint.note("compiledNameIds", value: self.compiledNameIds.count() as EntryCount)
		fingerprint.note("canonicalNameIds", value: self.canonicalNameIds.count() as EntryCount)
		fingerprint.note("canonicalIndexWrites", value: self.canonicalIndexWrites.count() as EntryCount)
		fingerprint.note("originIds", value: self.originIds.count() as EntryCount)
		fingerprint.note("tupleAliasWrites", value: self.tupleAliasWrites.count() as EntryCount)
		fingerprint.note("deepCloneNames", value: self.deepCloneNames.count() as EntryCount)
		fingerprint.note("shareWalkNames", value: self.shareWalkNames.count() as EntryCount)
		fingerprint.note("interfaceCloneNames", value: self.interfaceCloneNames.count() as EntryCount)
		fingerprint.note("uniqueTypeNames", value: self.uniqueTypeNames.count() as EntryCount)
		fingerprint.closeGroup()
	end 'noteFingerprint'
end 'IndexJournal'

type JournalMark
	let tupleNames as ElementIndex
	let separatorBearingTokens as ElementIndex
	let canonicalTupleNames as ElementIndex
	let compiledNameIds as ElementIndex
	let canonicalNameIds as ElementIndex
	let canonicalIndexWrites as ElementIndex
	let originIds as ElementIndex
	let tupleAliasWrites as ElementIndex
	let deepCloneNames as ElementIndex
	let interfaceCloneNames as ElementIndex
	let uniqueTypeNames as ElementIndex
	let shareWalkNames as ElementIndex

	static function create(tupleNames ElementIndex, separatorBearingTokens ElementIndex, canonicalTupleNames ElementIndex, compiledNameIds ElementIndex, canonicalNameIds ElementIndex, canonicalIndexWrites ElementIndex, originIds ElementIndex, tupleAliasWrites ElementIndex, deepCloneNames ElementIndex, interfaceCloneNames ElementIndex, uniqueTypeNames ElementIndex, shareWalkNames ElementIndex) returns JournalMark
		return Self{tupleNames: tupleNames, separatorBearingTokens: separatorBearingTokens, canonicalTupleNames: canonicalTupleNames, compiledNameIds: compiledNameIds, canonicalNameIds: canonicalNameIds, canonicalIndexWrites: canonicalIndexWrites, originIds: originIds, tupleAliasWrites: tupleAliasWrites, deepCloneNames: deepCloneNames, interfaceCloneNames: interfaceCloneNames, uniqueTypeNames: uniqueTypeNames, shareWalkNames: shareWalkNames}
	end 'create'

	static function empty() returns JournalMark
		return Self.create(0, separatorBearingTokens: 0, canonicalTupleNames: 0, compiledNameIds: 0, canonicalNameIds: 0, canonicalIndexWrites: 0, originIds: 0, tupleAliasWrites: 0, deepCloneNames: 0, interfaceCloneNames: 0, uniqueTypeNames: 0, shareWalkNames: 0)
	end 'empty'

	function total() returns ElementIndex
		return self.tupleNames + self.separatorBearingTokens + self.canonicalTupleNames + self.compiledNameIds + self.canonicalNameIds + self.canonicalIndexWrites + self.originIds + self.tupleAliasWrites + self.deepCloneNames + self.interfaceCloneNames + self.uniqueTypeNames + self.shareWalkNames
	end 'total'
end 'JournalMark'

type InstanceBandMark
	let rows as GenericInstanceId
	let named as ElementIndex
	let copyDemanded as ElementIndex

	static function create(rows GenericInstanceId, named ElementIndex, copyDemanded ElementIndex) returns InstanceBandMark
		return Self{rows: rows, named: named, copyDemanded: copyDemanded}
	end 'create'
end 'InstanceBandMark'

type ParseBandMark
	let instances as InstanceBandMark
	let journal as JournalMark
	let crossFileConstantReads as ElementIndex
	let mintedTupleLayouts as ElementIndex
	let typeNames as NameId
	let told as ElementIndex
	let canonicalNamesIndexedThrough as GenericInstanceId
