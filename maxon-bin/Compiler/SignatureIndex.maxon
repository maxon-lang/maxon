	end 'pair'
end 'mapLiteralColumnPair'

function declInitializerIsRefused(decl TopLevelDecl) returns bool
	return match decl.outcome 'state'
		failed or
		poisoned or
		unvalidatedRecord gives true
		pending or
		evaluating or
		value or
		managedValue or
		deferredRecord or
		storedRecord or
		imagedRecord or
		imagedBox gives false
	end 'state'
end 'declInitializerIsRefused'

function declInitializerIsParsedAgain(decl TopLevelDecl) returns bool
	return match decl.outcome 'state'
		pending or
		evaluating or
		value or
		failed or
		poisoned or
		managedValue or
		imagedRecord or
		imagedBox gives false
		deferredRecord or
		unvalidatedRecord or
		storedRecord gives true
	end 'state'
end 'declInitializerIsParsedAgain'

function declRunsProgramCode(decl TopLevelDecl) returns bool
	return match decl.outcome 'state'
		pending or
		evaluating or
		value or
		failed or
		poisoned or
		managedValue or
		deferredRecord or
		unvalidatedRecord or
		imagedRecord or
		imagedBox gives false
		storedRecord(_, _, runsProgramCode, _) gives runsProgramCode
