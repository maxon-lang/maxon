	for name in conformsTo 'eachConformance'
		out = mixBytes(Hasher.combined(out, value: shape), bytes: name)
	end 'eachConformance'

	return out
end 'mixDeclaredConformances'

function namesNotYetDeclared(declared NameRoster, extra NameRoster) returns NameRoster
	let merged = NameRoster.create(declared.count() + extra.count(), zeroed: false)
	merged.append(declared)

	for name in extra 'eachExtra'
		if not merged.contains(name) 'new'
			merged.push(name)
		end 'new'
	end 'eachExtra'

	return merged
end 'namesNotYetDeclared'

function mixVisibilityTier(state HashDigest, visibility Visibility) returns HashDigest
	return Hasher.combined(state, value: tierOrdinal(visibility) as HashDigest)
end 'mixVisibilityTier'

// Visibility verdicts read the declaring FILE as well as the tier, so a declaration that moves to
// another file must move the hash, or a warm parse keeps a verdict made against the file it left.
function mixDeclaringTier(state HashDigest, visibility Visibility, declFilePath FilePath) returns HashDigest
