// SignatureIndex — the WHOLE-PROGRAM DECLARATION index: every function, every ranged typealias and
// every top-level constant DECLARED in any file, read straight off the TOKENS before any body is
// parsed.
//
// WHY IT MUST EXIST, AND WHY IN THE PARSER. Three source-level decisions cannot be postponed past
// the parser, and each needs a declaration that may live in another file:
//
//   • A CALL'S RESULT TYPE. A bool `and`/`or` is CONTROL FLOW (`Parser.emitShortCircuit` — blocks
//     and a merge phi, which no later pass can retrofit); `not` picks a different OPCODE per
//     operand type; and every operand rule in TypeRules reads a value's tag. By the time a later
//     pass could supply a callee's return type, every decision that needed it has already been
//     made.
//
//   • A SHIFT'S FILL. `shr` is ARITHMETIC on a signed left operand and LOGICAL on an unsigned one
//     (TypeRules' ⭐ THE SHIFT RULE), and Maxon's unsigned type is a ranged alias whose low bound
//     is 0. The two are DIFFERENT x64 instructions, and the Std tier they lower into is TYPELESS —
//     an i64 there carries no signedness — so the opcode must be chosen while the declared type is
//     still in view, which is here. `u64.max shr 60` is 15 or -1 depending on it.
//
//   • A TOP-LEVEL CONSTANT'S VALUE. A `let` at module scope is a COMPILE-TIME CONSTANT that every
//     use INLINES as a literal (`Parser.topLevelBindingReference`), so the parser needs the NUMBER,
//     not a promise of one. It cannot fold the initializer itself: a forward reference
//     (`let TOTAL = FIRST + SECOND` above `let FIRST = 30`) and a cross-file `export let` are both
//     ordinary, and neither is in view while one file is parsed. So the fold happens HERE, after
//     every file's declarations are known — see `evaluateInitializers`.
//
// So the RANGES travel beside the return types, and the CONSTANTS beside both. An alias declared in
// `a.maxon` and used in `b.maxon` has to reach `b`'s parse, or the shift in `b` is a silent wrong
// answer — and reading the file-local alias table instead would be the identical mistake this index
// exists to fix, wearing a different hat.
//
// The FILE-LOCAL version of this — one token sweep of the file being parsed — serves the
// single-file case and not the cross-file one, where the failure is a WRONG ANSWER, not a
// rejection:
//
//     a.maxon:  export function isReady() returns bool
//     b.maxon:  let x = isReady()
//               return x + 41        ⇒ E2004: Cannot operate on bool and int
//                                    ⇒ without this index it compiles, and returns 42
//
// The parser reported an out-of-file callee as `MaxonType.unresolved`; TypeRules maps that to
// `TypeClass.unknown`; and `unknown` AGREES WITH EVERYTHING. That deferral is the right move for a
// type you genuinely cannot see, and a catastrophic one for a type you simply did not LOOK for.
// **The deferral was never the defect. Not looking was.** So this index looks — at every file's
// tokens, before any file's parse — and `unresolved` is no longer an answer for a callee some file
// declares. (Its twin was worse: agreement satisfied by deferral let `(boolean, unresolved)` reach
// `wordOpResultTag`'s bool-first arm, so `flag and crossFileInt()` MINTED a merge phi tagged
// `boolean` carrying the int 7.)
//
// THE ID PROBLEM — why a signature travels by NAME. A `MaxonType.named(id)` is meaningless outside
// the `TypeNameInterner` that minted the id, and this index is built BEFORE, and APART FROM, the
// per-file artifact interners the parser fills (ParseStaging's parallel-ready discipline: a file's
// parse touches no shared state). So the index owns its own interner, and a parser ADOPTS a
// callee's return type out of it — the type's NAME is re-interned into the parser's own artifact
// table, so the `MaxonType` handed back is indistinguishable from one that file had parsed itself.
// `returnTypeOf` is the one door, and it is the one place the two id spaces meet.

let TypeArgumentSeparator = ", "

let WrittenInstanceMarker = " with "

function rosterOfOneName(name ByteArray) returns NameRoster
	let roster = NameRoster.create(1, zeroed: false)
	roster.push(name)
	return roster
end 'rosterOfOneName'

function liftedFunctionHost(segments StringArray, name ByteArray) returns immutable ByteArray
	let host = try segments.get(0) otherwise panic("liftedFunctionHost: splitting '{String.from(name)}' at '{CompilerMintSeparator}' produced no segment")

	return freeze host.toByteArray()
end 'liftedFunctionHost'

// The marks the signature hash mixes before each declaration shape and fact, so two different
// shapes cannot produce the same byte stream. Every case shares one number space: a repeated value
// lets two shapes collide silently, so the compiler refuses one (E3031), and a new case takes the
// next free value. The values are written out rather than taken from case order, so reordering
// cases here or in a union they discriminate moves no parse memo.
enum SignatureDiscriminator
	returnShapeVoid = 1
	returnShapeValue = 2
	typeShapeBoolean = 3
	typeShapeInteger = 4
	typeShapeFloat = 5
	typeShapeNamed = 6
	typeShapeExitCode = 7
	typeShapeUnresolved = 8

	// A ranged typealias's declaration, mixed into the same hash as a function's. Its own
	// discriminator, so a file that replaces a function with an alias of the same name moves the hash
	// rather than colliding two differently-shaped declarations on it.
	declShapeAlias = 9

	// A declared struct type's shape discriminator — `declShapeAlias`'s twin, for its reason: a name
	// that stops being a `typealias` and starts being a `type` must move the hash, not collide on it.
	declShapeStruct = 14

	// A declared enum/union's shape discriminator — `declShapeStruct`'s twin, for its reason: a name
	// that stops being a `type` and starts being an `enum` must move the hash rather than collide.
	declShapeEnum = 20

	// Whether a declared type is a `union` (vs an `enum`), mixed into the hash beside its name. Two
	// distinct constants because the only thing separating a payload-free union from an enum is the
	// diagnostic WORDING, and a reader that meets a non-exhaustive match must re-parse — and so print
	// "union" rather than "enum" — when `enum` becomes `union`.
	enumKindEnum = 21
	enumKindUnion = 22

	// Whether any case of a declared enum/union WROTE a raw value — two distinct constants, mixed beside
	// the kind above and for exactly its reason: the two shapes are otherwise indistinguishable to this hash, and
	// what separates them is how a reading file renders an interpolated value of the type. See
	// `EnumLayout.declaresRawValues`.
	enumAutoTagged = 101
	enumDeclaresRawValues = 102

	// ⭐ **HOW A DECLARED ENUM'S TAGS ARE TO BE READ** (`EnumBacking`), mixed beside the case list for
	// `enumKindEnum`'s reason one step sharper: the two backings can produce the SAME tag column
	// (`z = 0` and `z = 0.0` both fold to 0), so without a discriminator of its own the edit between them is
	// invisible to every reading file's parse memo — while it changes what those files compile `"{z}"` and
	// `z * 2.0` to.
	enumBackingUnresolved = 67
	enumBackingInteger = 68
	enumBackingFloat = 69
	enumBackingString = 79
	enumBackingCharacter = 80
	enumBackingFunctionRef = 81
	enumBackingStructRecord = 82

	// ⭐ One FIELD of a constant struct backing, mixed per field so a second field cannot be absorbed by the
	// first. Its own discriminator for `payloadShapeSlot`'s reason: a reading file compiles `op.rawValue.latency`
	// down to the CONSTANTS this column holds, so `add = Meta{value: 1}` edited to `Meta{value: 2}` changes what
	// every other file emits while that file's own bytes never move — the staleness `mixEnumCase`'s raw-value
	// line already exists to catch, for the one backing whose value is not in `caseRawValues` at all.
	enumBackingFieldSlot = 83

	// The ENUM-CASE form of such a field's value (`Priority.low`), separated from the LITERAL form so
	// `Priority.low` and the bare number `0` cannot fold alike — they are resolved by different rules and one
	// of them moves when `Priority`'s case list is edited.
	enumBackingFieldEnumCase = 84

	// The NESTED STRUCT form (`inner: Inner{value: 1}`), separated from the other two for their reason: it holds
	// a type NAME where the enum-case form holds two, and an entry that owns a group must not fold like a leaf
	// that happens to carry the same bytes.
	enumBackingFieldNestedStruct = 88

	// ⭐ Which LITERAL a backing field was written as. `1` and `1.0` carry the same `FullRangeInt`, and they
	// type-check differently against the field's declared type — so without this they fold alike and a file that
	// edits one into the other leaves every reader's parse memo standing.
	enumBackingLiteralInteger = 85
	enumBackingLiteralFloat = 86
	enumBackingLiteralBoolean = 87

	// One `implements <Interface>` name on a declaration, mixed per name so a SECOND interface
	// moves the hash rather than being absorbed by the first. Its own discriminator for `declShapeStruct`'s
	// reason: the list is a distinct fact from the case or field list beside it. The KIND it hangs off is
	// already in the hash (`declShapeEnum` / `declShapeStruct`), so one discriminator serves both.
	declShapeDeclaredConformance = 55

	// One `with <TypeArg>` an `implements` clause BINDS (conditional extensions). ⚠ It needs a discriminator of
	// its OWN, and sharing the one above would be a live collision rather than a tidiness point:
	// `implements A, B` and `implements A with B` are two different declarations that both offer the byte
	// sequences `A` then `B` to this mixer, and they decide different things (which extensions apply, versus
	// what the extended interface's associated type is bound to).
	declShapeConformanceBinding = 72
	declShapeModuleDirectory = 128
	declShapeFileBoundary = 129
	authorChainSalt = 130
	libraryChainSalt = 131
	declShapeTypeNameTable = 132
	declShapeDefaultDeclaration = 133

	// The `MaxonType.structRef` arm's discriminator. It is DISTINCT from `typeShapeNamed`, and that is
	// load-bearing rather than tidy: `named(Point)` and `structRef(Point)` carry the same NAME and mean
	// different things in every reader — one is a ranged int, the other a pointer — so a hash that
	// could not tell them apart would hand a reader a memo built under the wrong one.
	typeShapeStructRef = 15

	// The `MaxonType.string` arm's discriminator. Distinct like every other shape: a
	// `String` return type hashes differently from an `int` one, so a memo built under one cannot be
	// served for the other.
	typeShapeString = 23

	// A FUNCTION value's type shape — so a `returns UnaryOp` return type hashes distinctly. Its
	// own discriminator for `typeShapeStructRef`'s reason. (A function type reaches the SCANNED signature
	// path only if a future producer stores one; the sweep records a function-alias reference as `named`
	// until the alias is known, so today this arm is exhaustiveness insurance, hashed not panicked.)
	typeShapeFunction = 29

	// A TYPE-PARAMETER reference's shape — `get() returns T` hashes distinctly. Its TOKEN is
	// mixed after the shape (a digest of `(declaring type, parameter name)`, so mixing it IS mixing
	// those two names and NOT an intern-order id — see `mixType`'s arm, which carries the argument), so
	// `uses A, B`'s `returns A` and `returns B` hash apart, and so do two DIFFERENT types' first
	// parameters. A distinct prime for `typeShapeStructRef`'s reason.
	typeShapeTypeParameter = 31

	// A GENERIC-INSTANCE's shape — a `returns IntBox` hashes distinctly. The BASE name and each
	// ARG's shape are mixed after it (names, never ids), so `Box with Integer` and `Box with Bool` hash
	// apart. A distinct prime for `typeShapeStructRef`'s reason.
	typeShapeGenericInstance = 37

	// A `Character`'s shape — a builtin with no name to mix, exactly like `typeShapeString`.
	// A DISTINCT prime from it, and that is the whole point: a Character and a String share a RECORD but not
	// a TYPE, so `returns String` and `returns Character` must hash apart or a signature change between them
	// would serve a stale parse from every other file's memo.
	typeShapeCharacter = 41

	// An EXISTENTIAL's shape — the INTERFACE's name is mixed after it, so
	// `returns Producer` and `returns Consumer` hash apart. A DISTINCT prime from `typeShapeStructRef`, and
	// for a sharper reason than that one's: an interface name and a struct name live in the same interner, so
	// sharing the prime would make `returns Backend` (the interface) and a hypothetical `returns Backend` (a
	// struct of that name) hash identically — and a declaration that changed which one the name denotes would
	// serve every other file a stale parse whose dispatch is a witness slot rather than a direct call.
	typeShapeInterfaceRef = 43

	// The shape byte a `cstring` mixes. Its own, and NOT `typeShapeInteger`: the two lower to one machine word
	// and are two types, which is the whole reason the tag exists — a signature hash that conflated them would
	// make `f(p cstring)` and `f(n i64)` one function.
	typeShapeCstring = 145

	// A declared FIELD's mutability, mixed into the hash beside its name and type. What rides is
	// ACCEPTANCE — `var count` → `let count` must turn every other file's
	// `c.count = 5` into E2013, and a reader whose memo did not move would go on compiling it.
	fieldShapeMutable = 16
	fieldShapeImmutable = 17

	// Whether a field declares a DEFAULT, mixed beside the payload when it does. Two constants and not
	// one, because "has no default" must hash differently from "defaults to 0" — the payload alone
	// cannot say so, and those two declarations accept different programs (`Self{}` is E3086 under the
	// first and legal under the second).
	fieldShapeNoDefault = 18
	fieldShapeDefaulted = 19

	// ⭐ A field whose default is an ARBITRARY EXPRESSION — a THIRD constant beside those two, for their
	// exact reason one step out: a field that gains an expression default accepts programs the other two do
	// not (`Self{}` is legal, and the box holds a freshly-called value rather than a folded constant), so it
	// must hash differently from both. It rides ALONE — see `mixFieldDefault` for why the expression must not.
	fieldShapeDefaultHelper = 75

	// ⭐ A field whose default is an empty `<Type>.create()`, written `create()`, `create(0)` or
	// `create(0, zeroed: …)` (`FieldDefault.emptyCreateHelper`) — a FOURTH constant
	// beside the three above, and the only one whose EXPRESSION a reader in another file depends on: the empty
	// container that call builds is laid down as bytes, so an edit between `IntArray.create()` and
	// `IntArray.create(4, zeroed: false)` changes what every reader emits and must move every reader's memo.
	fieldShapeDefaultEmptyCreate = 115

	// ⭐ Whether a LITERAL default's number was written with a leading minus, above `i64.max`, or
	// neither — three constants beside the pair above for their exact reason, one step further out:
	// `= -1` and `= 0xFFFFFFFFFFFFFFFE` store the same kind of negative `FullRangeInt` and accept
	// different programs (the first is E3005 in an `int(0 to u64.max)` field and the second is not,
	// `FieldDefault.literal`), so the payload alone cannot discriminate them and an edit between the
	// two spellings must move every reader's memo.
	fieldDefaultWrittenNegative = 110
	fieldDefaultWrittenPlain = 111
	fieldDefaultWrittenAboveSignedMax = 134

	// The two shapes a top-level constant's ANSWER hashes under: it evaluated to a value, or it did
	// not. Their own discriminators for `declShapeAlias`'s reason — a name that stops being a function
	// and starts being a constant must move the hash rather than collide.
	constShapeValue = 10
	constShapeNoValue = 11

	// The THIRD shape a top-level constant's answer hashes under: it folded to a managed LITERAL.
	// Its own discriminator for `constShapeValue`'s reason — a `let X = 0` that becomes `let X = "0"` must
	// move the hash, and the payload alone cannot say so (the bytes `"0"` and the number 0 are different
	// facts that a shared shape would let collide).
	constShapeManagedValue = 45

	// Which managed literal a constant folded to, mixed beside its bytes. Two constants because a
	// `String` and an `Array with Byte` over the SAME bytes are different types with different records, so
	// a reader that saw one must re-parse when it becomes the other.
	managedShapeString = 46
	managedShapeByteArray = 47
	managedShapeCharacter = 112

	// The FOURTH shape a top-level binding's answer hashes under: it folded to an ARRAY
	// LITERAL. Its own discriminator for `constShapeManagedValue`'s reason — `let X = "ab"` becoming
	// `let X = [1, 2]` turns every reader's materialized literal into a `.data` load, and nothing else on
	// the hash says so.
	constShapeArrayValue = 48

	// Which ELEMENT type an array literal folded to, mixed beside its label. Two constants
	// for `managedShapeString`/`managedShapeByteArray`'s reason: `Array with Integer` and `Array with String`
	// are different types, and a reader types its load from the instance this picks.
	arrayElementShapeInteger = 49
	arrayElementShapeString = 50
	arrayElementShapeEnumCase = 107

	// The FIFTH shape a top-level binding's answer hashes under: it folded to a
	// CONTAINER FACTORY CALL. Its own discriminator for `constShapeArrayValue`'s reason — `var g = [1, 2]`
	// becoming `var g = IntArray.create()` keeps the label and the load and changes the RECORD every reader's
	// program is built over, and nothing else on the hash says so.
	//
	// ⚠ What rides beside it is the instance's MANGLED NAME and not its gid: a gid is interned per compile and
	// is a function of what else the program happened to intern, so hashing one would invalidate every reader's
	// memo whenever an unrelated instance appeared ahead of it. The mangled name is a function of the type
	// alone, which is exactly what a reader depends on.
	constShapeContainerValue = 70

	// A top-level binding that folded to a USER STATIC FACTORY CALL. Its
	// own discriminator for `constShapeContainerValue`'s reason, one step further: `var db = IntArray.create()`
	// becoming `var db = Database.create(…)` keeps the label and the load and changes the slot's TYPE, so
	// every reader's field access is built over a different record.
	//
	// ⚠ What rides beside it is the CALLEE's mangled `Type.method` name — a function of the source alone, for
	// the reason stated above — and deliberately not the arguments, which reach only `__module_init`.
	constShapeFactoryValue = 71

	// A top-level binding that folded to a BOXED UNION'S PAYLOAD-FREE CASE. Its own discriminator for
	// `constShapeContainerValue`'s reason: `let t = MaxonType.unresolved` becoming `let t = SomeOther.case`
	// keeps the label and the load and changes the slot's TYPE, so every reader's `match` is built over a
	// different union.
	//
	// ⚠ What rides beside it is the UNION's NAME and deliberately NOT the case, which is the array arm's rule:
	// every reader emits `globalAddr <label>` + `loadIndirect` byte-identically whichever case was named, and
	// the case reaches only `__module_init`, which is rebuilt from this arena whenever this query misses.
	constShapeBoxedUnionValue = 108

	// Which of the two storage models a record binding took, mixed so a binding that crosses between them cannot
	// hash alike on the terms the two do not share. `ProgramSignatures.mixRecordStorage` carries the rule.
	recordStorageShapeSlot = 116
	recordStorageShapeImage = 117

	// Which image object one pointer slot of an imaged box addresses, mixed so a column and a nested box cannot
	// hash alike on the terms the two do not share.
	imageBoxSlotShapeEmptyArray = 118
	imageBoxSlotShapeNestedBox = 119

	// A function's PER-PARAMETER CONSUME BITS, mixed into the hash beside its name so a
	// cross-file caller re-parses when a callee's consume set changes. What rides is ACCEPTANCE and OWNERSHIP:
	// a param that becomes CONSUMED turns every caller's `f(ownedLocal)` into a move (the local is poisoned,
	// E3102 on reuse) and its `f(borrowedValue)` into E2015, while the caller's own bytes never move — so a
	// reader whose memo did not move would keep the old drop behaviour, a double-free or a leak. Its own
	// discriminator for `declShapeAlias`'s reason. `consumeBitSet`/`consumeBitClear` distinguish a set bit
	// from a clear one so "param 0 consumed, param 1 not" hashes differently from the reverse.
	declShapeParamConsume = 24
	consumeBitSet = 25
	consumeBitClear = 26
	handedOnBitSet = 124
	handedOnBitClear = 125
	forwardedStoreDiscriminator = 137

	// A function's `throws E` clause discriminator. Its own discriminator for `declShapeAlias`'s
	// reason: a callee that GAINS or CHANGES a throws type changes whether each call site needs a `try`
	// (E3055/E3057) and what type the `(e)` binding recovers, so a caller's parse memo must move when the
	// callee's throws clause does. Only THROWING functions are recorded (absence = non-throwing default),
	// exactly as `recordParamConsume` records only consuming ones — so a non-throwing function costs no
	// hash movement.
	declShapeThrows = 27

	// A function that NEVER RETURNS — `declShapeThrows`' discriminator one fact over, and its own for the
	// same reason: a callee that gains or loses divergence changes whether a bare call to it ENDS ITS CALLER'S
	// BLOCK, so a caller's parse memo must move when the callee's body stops (or starts) being able to return.
	// Only a proved-diverging declaration is recorded, so every ordinary function costs no hash movement.
	declShapeDiverges = 146

	// A function that can only ever THROW — `declShapeDiverges`' second way out, and its own tag for
	// the identical reason: a callee that gains or loses the property changes whether a PROPAGATING `try`
	// statement on it ENDS ITS CALLER'S BLOCK, so a caller's parse memo must move with it. Only a proved
	// always-throwing declaration is recorded, so every ordinary function costs no hash movement.
	declShapeAlwaysThrows = 147

	// ⭐ A function whose every `return` hands back a FRESH RECORD — the two above's third sibling, and its
	// own tag for their reason one fact over: a callee that gains or loses the property changes whether a SEND may
	// MOVE its result to another green thread, so a caller's parse memo must move with it. Only a proved
	// fresh-returning declaration is recorded, so every ordinary function costs no hash movement.
	declShapeReturnsFreshRecord = 109

	// The shape a CONDITIONAL fresh-return claim mixes, and its own rather than `declShapeReturnsFreshRecord`'s:
	// a body that stops building its record and starts forwarding to a callee is a different program, and a memo
	// that could not tell the two apart would serve the old answer.
	declShapeFreshReturnForward = 113

	// The `FreshReturnForward` spellings, as distinct marks: one call written two ways can reach two
	// different declarations.
	freshForwardUnqualifiedShape = 120
	freshForwardSelfReceiverShape = 121
	freshForwardSelfTypeShape = 122
	freshForwardNamedTypeShape = 123
	freshForwardFieldMemberShape = 140

	// ⭐ A static factory whose whole body is `return Self{p: p, …}` over its own parameters — the four
	// above's sibling, and its own tag for their reason one fact over: a callee that gains or loses the property
	// changes whether a top-level `let X = T.create(…)` FOLDS to a construction and is therefore imaged, so a
	// caller's parse memo must move with it.
	declShapeConstructsFromParams = 114
	declShapeReturnsReceiverField = 142
	declShapeReturnsParameter = 138
	declShapeFieldMoveOutForward = 139
	declShapeAliasImplements = 126
	declShapeTupleAlias = 127

	// ⭐ A declared RETURN TYPE's pre-erasure SPELLING — the `DeclaredSurface` word `mixDeclaration`
	// folds in beside the return type. It is the one declaration fact `mixReturnType` structurally cannot carry:
	// `__ManagedMemory` resolves to the SAME `genericInstance` a `ByteArray` does, so an edit between the two
	// spellings moves the return TYPE not at all while changing which member roster every caller's `let m = f()`
	// may then reach. A DISCRIMINATOR plus the word, rather than a tag pair, because the fact is a word
	// and not a bit: mixing the word alone would let a plain surface (0) collide with the seed.
	returnShapeSurface = 56

	// ⭐ A declared struct FIELD's pre-erasure SPELLING — `returnShapeSurface`'s twin, one
	// declaration kind over, and load-bearing for the identical reason: `var buf as __ManagedMemory` and
	// `var buf as ByteArray` fold identically through `mixField`'s type, while a read of that field reaches a
	// different roster. Mixed by `mixField`, so it rides `recordStruct`'s one hash write like every other
	// per-field fact.
	fieldShapeSurface = 58

	// ⭐ ONE union case PAYLOAD SLOT — the discriminator that opens a payload's contribution to
	// `mixEnumCase`, so a payload's NAME cannot be absorbed by the case name it follows and a case that GAINED a
	// slot cannot collide with the one it grew from. `declShapeDeclaredConformance`'s reason, one column over.
	payloadShapeSlot = 73

	// ⭐ A union PAYLOAD's pre-erasure SPELLING — `fieldShapeSurface`'s twin at the fifth declared
	// position, load-bearing for the identical reason: `mem(m __ManagedMemory)` and `mem(m ByteArray)` fold
	// identically through `mixPayloadField`'s type, while the `match` binding out of them reaches a different
	// member roster.
	payloadShapeSurface = 74

	// A FUNCTION typealias's shape discriminator — `declShapeAlias`'s twin, for its reason: a name
	// that stops being a ranged alias and becomes a function one, or whose function return type changes,
	// changes what a caller binding a value of it compiles to, so a caller's parse memo must move with it.
	declShapeFunctionAlias = 28

	// A generic-instance TYPEALIAS's shape discriminator — `declShapeAlias`'s twin. `IntBox =
	// Box with Integer` changing base or args changes what `IntBox.create(…)` resolves to and type-checks
	// against in ANY file, so a reader's parse memo must move with it.
	declShapeGenericAlias = 30

	// A declared generic type's TYPE-PARAMETER shape discriminator. A change to `type Box uses T`'s
	// param list — a rename or, load-bearingly, a change in COUNT — changes which `Box with …` instantiations
	// are the right arity in any file, so a reader's parse memo must move with the count.
	declShapeTypeParam = 32

	// A declared generic type's `where`-CONSTRAINT shape discriminator. A change to `type Box
	// uses T where T is Digest`'s constraint list — an interface swapped, added, or dropped — changes which
	// `Box with …` instantiations are LEGAL (E3017) in any file and which witness table each dispatch reads, so
	// a reader's parse memo must move with it. The `declShapeTypeParam` twin for the constraint half.
	declShapeWhereConstraint = 44

	// A constructor parameter's TYPE-PARAMETER-FEED shape discriminators. Which type-parameter
	// position a parameter feeds decides whether a caller consumes a managed argument there, so a change to a
	// constructor's feed map must move a caller's parse memo — the consume twin of `consumeBitSet`/`Clear`.
	feedShapeFeeds = 38
	feedShapeNone = 39

	// The feed's SINK. It decides whether the CALLEE is enrolled owner of the fed parameter, and
	// whether a BORROWED argument at that position is retained or given a scope lifetime — two
	// different emitted programs for the same position, so a change to it must move a caller's parse
	// memo exactly as the position does.
	feedSinkConstructedValueShape = 76
	feedSinkCalleeStorageShape = 77

	// A generic type's INNER ranged typealias shape discriminator — `declShapeAlias`'s twin, for its
	// reason: a change to `type Wrapper`'s `typealias Idx` (its range, or whether it exists) changes what
	// `Instance.Idx` resolves and type-checks against in ANY file, so a reader's parse memo must move with it.
	declShapeInnerAlias = 40

	// An `interface` DECLARATION's shape discriminator (its `uses` arity and its requirements) —
	// `declShapeTypeParam`'s twin, and load-bearing for exactly its reason. The arity decides how many arguments
	// an unparenthesized `implements I with A, B` binds (`Parser.interfaceUsesArity`), so adding or removing a
	// `uses` name changes what a conformance in ANY file PARSES — the comma after an argument stops being another
	// argument and becomes another interface. A reader that did not re-parse would go on binding the old count.
	declShapeInterface = 51

	// One interface METHOD's shape discriminator — `declShapeInterface`'s per-requirement twin, and its own
	// so that moving a requirement between two interfaces moves the hash. A witness dispatch in any file reads
	// this method's slot index, result type, formals and ABI (`Parser.findWitnessDispatchCandidates`) and bakes all of them
	// into its own emitted code, so a change here has to re-parse every reader. See `recordInterfaceDeclaration`
	// for which fields ride and which deliberately do not.
	declShapeInterfaceMethod = 52

	// One `extends` PARENT NAME's shape discriminator — `declShapeInterfaceMethod`'s twin, and its own
	// for that twin's reason: a witness dispatch numbers its slot against the interface's TRANSITIVE requirement
	// list (`interfaceWitnessSlots`), so gaining, losing or REORDERING a parent moves a slot index that another
	// file has already baked into its emitted code. Only the NAME is mixed — the parent's own requirements reach
	// this hash through the parent's own `recordInterfaceDeclaration`, one hash being folded over every
	// declaration in the program.
	declShapeInterfaceParent = 60

	// Does a declaration carry a hidden `self`? — a PRESENCE PAIR for `mixThrowsClause`'s reason and not a
	// marker on the receiverless arm alone: both kinds are possible in every position that mixes it, so a hash
	// that mixed nothing for the instance arm would let a declaration GAIN or LOSE `static` without any reader's
	// memo moving. ONE pair for both positions that ask it, because it is one distinction:
	//
	//   • an INTERFACE REQUIREMENT's. It rides because a PARSE reads it:
	//     `Parser.requireWitnessDispatchCandidates` REFUSES a dispatch whose requirements are all `static`
	//     (E3116) and `IrInterface.witnessTargetIsProtocol` refuses a `static` look-alike as
	//     `Equatable`/`Comparable` (E3005), so flipping the keyword in file A decides whether file B compiles at
	//     all while file B's own bytes stay put — this hash's stated rule, exactly.
	//   • a DECLARATION's, through `mixDeclaration` — see there for the bare-sibling-call reader that spends it.
	//
	// The receiverless arm covers a top-level free function as well as a `static` method, which is why the pair
	// is named for the RECEIVER rather than for the keyword.
	receiverShapeAbsent = 61
	receiverShapePresent = 62

	// ⭐ A function's PER-PARAMETER DEFAULTS, mixed into the hash beside its name for
	// `declShapeParamConsume`'s reason and with the identical PRESENCE-PAIR shape. What rides is what a CALL
	// SITE compiles to: a parameter that GAINS a default turns a caller's `f()` from E3036 into a legal call
	// that emits a helper invocation, and one that LOSES it does the reverse — in both directions the caller's
	// own bytes never move, so only this hash can carry it. The pair distinguishes "param 0 defaulted, param 1
	// not" from the reverse, exactly as `consumeBitSet`/`consumeBitClear` do.
	// ⭐ **AND THE TWO CALLER-LOCATION ARMS ARE THEIR OWN MARKS, NOT A THIRD SPELLING OF
	// `defaultBitSet`** — because what a caller COPIES differs between them. A `helper` slot compiles
	// to a `call` whose bytes never move; a `callerLine` slot compiles to the caller's own line NUMBER
	// and a `callerFile` slot to its path, so a declaration that changes `= __line__` to `= __file__`,
	// or either to an ordinary expression, changes what every caller emits while the callers' own bytes
	// stay put. That is exactly the condition this hash exists for, and a shared "has a default" bit
	// would fail it silently.
	declShapeParamDefault = 63
	defaultBitSet = 64
	defaultBitClear = 65
	defaultBitCallerLine = 99
	defaultBitCallerFile = 100

	// ⭐ A method's OPAQUE (bare type-parameter) PARAMETER POSITIONS, mixed for `declShapeParamConsume`'s
	// reason and carrying exactly what a CALL SITE compiles to: which `uses` slot a parameter names decides
	// which of the receiver instance's type arguments the range guard in front of that call is built from
	// (`Parser.recordOpaqueArgRangeChecks`). Retyping `put(value T)` to `put(value Integer)` — or moving `T` to
	// another `uses` slot — changes the caller's emitted code while the caller's own bytes never move, so only
	// this hash can carry it. The param NAMES ride for `recordParamConsume`'s reason: a rename changes which
	// labelled argument slots to the opaque position.
	declShapeOpaqueParams = 89

	// ⭐ A function's `mutable` parameter mask, mixed for `declShapeParamConsume`'s reason and carrying the
	// strongest thing in this table: the callee's ABI. A parameter that GAINS the `mutable` marker turns every
	// caller's argument from a value into a cell address — the caller's own bytes never move, so only this
	// hash can carry it, and a stale memo here is not a wrong diagnostic but a dereferenced integer. The param
	// NAMES ride for `recordParamConsume`'s reason (a rename moves which labelled argument slots to a by-ref
	// position). The PRESENCE PAIR distinguishes "param 0 by-ref, param 1 not" from the reverse, exactly as
	// `consumeBitSet`/`consumeBitClear` do.
	declShapeParamByRef = 90
	byRefBitSet = 91
	byRefBitClear = 92

	// The three `ForwardCall` shapes and the three `DeclCallability` answers, as distinct hash marks — a
	// declaration that MOVES into or out of a type body, and a call that gains or loses a receiver, each change
	// an ABI without changing a parameter name, so both must move the memo key.
	bareCallShape = 93
	receiverCallShape = 94
	selfCallShape = 95
	rootFreeFunctionDecl = 96
	routableFreeFunctionDecl = 97
	methodDecl = 98

	// ⭐ A function's IMMUTABLE-GLOBAL-RETURN raw material, mixed for `declShapeParamConsume`'s reason.
	// A body that starts or stops returning a `let` global — or starts returning what some OTHER function
	// returns — changes what every caller may do with the result while not one byte of any caller moves, so
	// only this hash can carry it. The declaring FILE rides because the same spelling resolves to different
	// declarations from different files (a name two directories declare resolves per reader), so two
	// identical bodies in two files genuinely state two different facts.
	declShapeGlobalAliasReturn = 104

