		typeArgKind(param, kind) then return freeze "kind:{param}:{kind.ordinal}".toByteArray()
		dropDiverges(typeName, index, sharedCallee) then return freeze "diverges:{index}:{String.from(typeName)}:{String.from(sharedCallee)}".toByteArray()
	end 'query'
end 'rowSetQueryKey'

function rowSetAnswerDisplay(answer RowSetAnswer) returns String
	match answer 'answer'
		noInstance then return "no instance"
		instance(site) then return "an instance {instantiationSiteDisplay(site)}"
		holds(value) then return "{value}"
	end 'answer'
end 'rowSetAnswerDisplay'

function instantiationSiteDisplay(site InstantiationSiteLookup) returns String
	match site 'site'
		unwritten then return "no source wrote"
		written(anchor) then return "written at {anchor.filePath.toString()}:{anchor.nameLine}:{anchor.nameColumn}"
	end 'site'
end 'instantiationSiteDisplay'

// The strength an answer is ordered by: some row matched, or none did.
function rowSetAnswerIsAffirmative(answer RowSetAnswer) returns bool
	match answer 'answer'
		noInstance then return false
		instance then return true
		holds(value) then return value
	end 'answer'
end 'rowSetAnswerIsAffirmative'

// One question a parse asked, and its answer over every row the parse minted.
export type RowSetRecord
	export let query as RowSetQuery
	export let answer as RowSetAnswer

	static function create(query RowSetQuery, answer RowSetAnswer) returns RowSetRecord
		return Self{query: query, answer: answer}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteRowSetQuery(writer, value: self.query)
		cacheWriteRowSetAnswer(writer, value: self.answer)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns RowSetRecord throws LibraryCacheDamage
		let f_query = try cacheReadRowSetQuery(reader)
		let f_answer = try cacheReadRowSetAnswer(reader)

		return Self{query: f_query, answer: f_answer}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(RowSetRecord) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'RowSetRecord'

export typealias RowSetRecordMap = Map with (ByteArray, RowSetRecord)

// @generated library-cache begin
function cacheWriteRowSetRecordMap(writer LibraryCacheWriter, value RowSetRecordMap)
	writer.unsigned(value.count() as CacheUnsigned)

	for (key, entry) in value 'eachEntry'
		writer.bytes(key)
		entry.cacheWrite(writer)
	end 'eachEntry'
end 'cacheWriteRowSetRecordMap'

function cacheReadRowSetRecordMap(reader LibraryCacheReader) returns RowSetRecordMap throws LibraryCacheDamage
	let count = try reader.count()
	let result = RowSetRecordMap.create()

	for _ in 0 upto count 'eachEntry'
		let key = try reader.bytes()
		let entry = try RowSetRecord.cacheRead(reader)
		result.upsert(key, value: entry)
	end 'eachEntry'

	return result
end 'cacheReadRowSetRecordMap'

// @generated library-cache end

// Every question one parse asked, in first-ask order.
export type RowSetAnswerLog
	export var order as NameRoster
	export var records as RowSetRecordMap

	static function create() returns RowSetAnswerLog
		return Self{order: NameRoster.create(0), records: RowSetRecordMap.create()}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteNameRoster(writer, value: self.order)
		cacheWriteRowSetRecordMap(writer, value: self.records)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns RowSetAnswerLog throws LibraryCacheDamage
		let f_order = try cacheReadNameRoster(reader)
		let f_records = try cacheReadRowSetRecordMap(reader)

		return Self{order: f_order, records: f_records}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(RowSetAnswerLog) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'RowSetAnswerLog'

// The questions the open parse asked, each with the answer its FIRST ask returned, and the whole-program answers
// it was handed; `parsing` false outside a parse.
type RowSetLog
	export let parsing as bool
	export let overrides as RowSetOverrideTable
	export var told as RowSetAnswerLog

	static function open(overrides RowSetOverrideTable) returns RowSetLog
		return Self{parsing: true, overrides: overrides, told: RowSetAnswerLog.create()}
	end 'open'

	static function closed() returns RowSetLog
		return Self{parsing: false, overrides: RowSetOverrideTable.create(), told: RowSetAnswerLog.create()}
	end 'closed'

	// The first answer is the one to keep: the parse acted on it, and a later ask of the same question can only
	// have been answered more strongly by rows the parse minted in between.
	function note(key ByteArray, query RowSetQuery, answer RowSetAnswer)
		if self.told.records.contains(key) 'askedBefore'
			return
		end 'askedBefore'

		// Copies, because a query and an answer name records this index holds and the log leaves in the parse's
		// artifact.
		self.told.order.push(key)
		self.told.records.upsert(key, value: RowSetRecord.create(query.clone(), answer: answer.clone()))
	end 'note'

	function noteFingerprint(fingerprint IndexFingerprint, group String)
		fingerprint.openGroup(group)
		fingerprint.noteFlag("parsing", flag: self.parsing)
		fingerprint.note("questions", value: self.told.records.count())
		fingerprint.closeGroup()
	end 'noteFingerprint'
end 'RowSetLog'

// ⭐ **THE WHOLE PROGRAM'S ANSWERS ONE FILE IS PARSED WITH** — filed by `rowSetAnswersThatMoved` for a question
// that file's own parse answered otherwise. `digest` is part of the file's parse memo key, because the parse's
// output depends on every answer here.
export type RowSetOverrideTable
	var answers as RowSetAnswerMap
	export var digest as HashDigest

	export static function create() returns RowSetOverrideTable
		return Self{answers: RowSetAnswerMap.create(), digest: Hasher.empty()}
	end 'create'

	function answerFor(key ByteArray) returns RowSetAnswer throws MapError
		return try self.answers.get(key)
	end 'answerFor'

	// Stand `answer` for `key`. The digest folds each entry in by `xor`, so the order entries arrive in cannot
	// move it.
	//
	// ⭐ **A KEY STANDS ONCE.** A parse of this file is told the standing answer, and the whole program can only
	// agree with it (`rowSetAnswersThatMoved`), so every fold that files anything files a (file, question) pair no
	// earlier fold did — which is what bounds the refolds by those pairs.
	function stand(key ByteArray, answer RowSetAnswer)
		if self.answers.contains(key) 'standingAlready'
			panic("RowSetOverrideTable.stand: `{String.from(key)}` already stands for this file, whose parse was therefore told it — the whole program cannot move an answer it was told")
		end 'standingAlready'

		self.answers.upsert(key, value: answer)
		self.digest = self.digest xor rowSetEntryDigest(key, answer: answer)
	end 'stand'
end 'RowSetOverrideTable'

// Unguarded against the other 64-bit marks: see `DeclShapeInstanceRow`.
let RowSetNoInstanceMark = 0x9A6E1A4BFECBDD4E as HashDigest
let RowSetUnwrittenMark = 0xA54FF53A5F1D36F1 as HashDigest
let RowSetWrittenMark = 0x510E527FADE682D1
let RowSetHoldsMark = 0xD28FC63EB2B902F5 as HashDigest
let RowSetFailsMark = 0x1F83D9ABFB41BD6B as HashDigest

function rowSetEntryDigest(key ByteArray, answer RowSetAnswer) returns HashDigest
	let keyed = mixBytes(Hasher.empty(), bytes: key)

	match answer 'answer'
		noInstance then return Hasher.combined(keyed, value: RowSetNoInstanceMark)
		instance(site) then return mixInstantiationSite(Hasher.combined(keyed, value: RowSetWrittenMark), site: site)
		holds(value) then return Hasher.combined(keyed, value: RowSetHoldsMark if value else RowSetFailsMark)
	end 'answer'
end 'rowSetEntryDigest'

function mixInstantiationSite(state HashDigest, site InstantiationSiteLookup) returns HashDigest
	match site 'site'
		unwritten then return Hasher.combined(state, value: RowSetUnwrittenMark)
		written(anchor) then return Hasher.combined(Hasher.combined(mixBytes(state, bytes: anchor.filePath.toString().toByteArray()), value: anchor.nameLine as HashDigest), value: anchor.nameColumn as HashDigest)
	end 'site'
end 'mixInstantiationSite'

let MapKeyColumnFieldName = b"keys"
let SetElementColumnFieldName = b"elements"

function layoutFieldIsAt(layout StructLayout, field ByteArray, offset ByteOffset) returns bool
	let index = try layout.indexOfField(field) otherwise return false
	return layout.offsetOfField(index) == offset
end 'layoutFieldIsAt'

function storedKeyColumnIsAt(baseName ByteArray, layout StructLayout, offset ByteOffset) returns bool
	if baseName.equals(MapBuiltinBaseName) 'aMap'
		return layoutFieldIsAt(layout, field: MapKeyColumnFieldName, offset: offset)
	end 'aMap'

	if baseName.equals(SetBuiltinBaseName) 'aSet'
		return layoutFieldIsAt(layout, field: SetElementColumnFieldName, offset: offset)
	end 'aSet'

	return false
end 'storedKeyColumnIsAt'

function layoutSlotIsImmutable(layout StructLayout, offset ByteOffset) returns bool
	let index = try layoutFieldAtOffset(layout, offset: offset) otherwise return false
	return layout.fieldTypeSites.capabilityAt(index) == ParamCapability.immutable
end 'layoutSlotIsImmutable'

function casePayloadSlotIsImmutable(layout EnumLayout, caseKey FullRangeInt, keyedByWord bool, offset ByteOffset) returns bool
	for caseIndex in 0 upto layout.caseCount() 'eachCase'
		let key = layout.wordKeyOfIndex(caseIndex) if keyedByWord else layout.tagOfIndex(caseIndex)

		if key != caseKey 'anotherCase'
			continue
		end 'anotherCase'

		let payloads = layout.payloadsAt(caseIndex)

		for slot in 0 upto payloads.count() 'eachPayload'
			if layout.payloadSlotOffset(slot as PayloadSlotIndex) == offset 'theSlot'
				return (try payloads.get(slot) otherwise panic("casePayloadSlotIsImmutable: payloads.get OOB at {slot} below the case's own count")).capability == ParamCapability.immutable
			end 'theSlot'
		end 'eachPayload'

		return false
	end 'eachCase'

	return false
end 'casePayloadSlotIsImmutable'

function layoutFieldAtOffset(layout StructLayout, offset ByteOffset) returns FieldIndex throws AbsentError
	for index in 0 upto layout.fieldCount() 'eachField'
		if layout.offsetOfField(index) == offset 'itsField'
			return index
		end 'itsField'
	end 'eachField'

	throw AbsentError.absent
end 'layoutFieldAtOffset'
