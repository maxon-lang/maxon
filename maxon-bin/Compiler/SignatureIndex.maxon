	let alreadyMinted = try minted.get(bare) otherwise 0
	minted.upsert(bareDataLabel(name), value: alreadyMinted + 1)

	if alreadyMinted == 0 'firstOfThisName'
		return bare
	end 'firstOfThisName'

	return freeze "{String.from(bare)}{DataLabelDisambiguator}{alreadyMinted}".toByteArray()
end 'uniqueDataLabel'

function bareDataLabel(name ByteArray) returns immutable ByteArray
	return freeze "{DataLabelPrefix}{String.from(name)}".toByteArray()
end 'bareDataLabel'

// A top-level constant's state, from `pending` through to its answer. ONE union rather than a value
// table plus a side set of in-progress names, because the two questions the initializer fold asks — "what
// is this worth?" and "am I already inside it?" — are the same question asked at different times,
// and a name that could be in one structure but not the other is exactly how a cycle goes undetected.
export union TopLevelConstant
	// Read by the sweep, not yet evaluated. Every decl starts here.
	pending

	// On the current evaluation's DFS stack: a reference that reaches this decl again is a CYCLE.
	evaluating

	// It evaluated. `payload` is the number (a bool's is its 0/1 — TypeRules' `BoolTrueValue`), and
	// `tag` says which of the two it is. This is what a use INLINES.
	//
	// ⭐ **`typeName` IS THE ENUM'S SPELLING WHEN THE TAG IS `named`, EMPTY OTHERWISE.** A payload-free enum
	// case folds to its tag — a number — and the number alone is a wrong answer about it: the use site has
	// to emit the literal typed as the ENUM or the value cannot be passed where the enum is declared. The
	// arm is WIDENED rather than duplicated because a folded enum case is not a second kind of scalar
	// constant, it is a scalar constant that names its type; two arms would be one fact with two spellings
	// free to drift. Bytes and not an id — see `ConstValue.typeName` for why the interner forbids an id here.
