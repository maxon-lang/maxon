	// `throwing(E)` cannot hash alike in a position where both are possible. `mixThrowsClause` is the one place a
	// throws clause enters a content hash.
	throwsShapeNone = 53
	throwsShapeThrowing = 54

	declShapeDeclaredParams = 149
	columnBoundsUnknown = 150
	columnBoundsIntegers = 151
	columnBoundsUnsignedIntegers = 152
	columnBoundsFloats = 153
	mapColumnsNone = 154
	mapColumnsColumns = 155
	declShapeUniqueType = 156
	declShapeMutableFunction = 157
	declShapeSelfCapability = 158
	declShapeHeaderSpelling = 159
	declShapeRegionBound = 161
	regionBoundSendable = 162
	regionBoundIsolated = 163
	declShapeExtensionConformance = 164
	declShapeExtensionHeldArgument = 165
	declShapeLinearType = 166
	declShapeLibraryBindingMint = 167
end 'SignatureDiscriminator'

// The discriminator for one backing. A `match` rather than a chained `if`, so a new backing cannot be added
// without being given a discriminator.
function enumBackingDiscriminator(backing EnumBacking) returns HashDigest
	return match backing 'b'
		unresolved gives SignatureDiscriminator.enumBackingUnresolved
		integer gives SignatureDiscriminator.enumBackingInteger
		float gives SignatureDiscriminator.enumBackingFloat
		string gives SignatureDiscriminator.enumBackingString
		character gives SignatureDiscriminator.enumBackingCharacter
		functionRef gives SignatureDiscriminator.enumBackingFunctionRef
		structRecord gives SignatureDiscriminator.enumBackingStructRecord
	end 'b'
end 'enumBackingDiscriminator'

function enumBackingLiteralDiscriminator(kind EnumBackingLiteralKind) returns HashDigest
	return match kind 'k'
		integerLiteral gives SignatureDiscriminator.enumBackingLiteralInteger
		floatLiteral gives SignatureDiscriminator.enumBackingLiteralFloat
		booleanLiteral gives SignatureDiscriminator.enumBackingLiteralBoolean
	end 'k'
end 'enumBackingLiteralDiscriminator'

