// @generated library-cache end

// Does this SLOTLESS binding hold an image-data record? Asked only of a decl resolved through
// `DeclKind.inlined`, so having no slot is the precondition and the outcome is the whole answer: a RECORD
// outcome with no slot is an imaged one by `settleImagedOutcome`'s construction, and a scalar or a managed
// literal has no shared record to alias at all. One record arm for `resolvedValueOf`'s reason — which
// shapes may be imaged is decided in one place, not restated here where a stale copy would be a silently
// missed immutable-global-return seed.
function declHoldsAnImageRecord(decl TopLevelDecl) returns bool
	return match decl.outcome 'state'
		pending or
		evaluating or
		value or
		failed or
		poisoned or
		managedValue gives false
		deferredRecord or
		unvalidatedRecord or
		storedRecord or
		imagedRecord or
		imagedBox gives true
	end 'state'
end 'declHoldsAnImageRecord'

function declHasInitializerFunction(decl TopLevelDecl) returns bool
	return match decl.outcome 'state'
		pending or
		evaluating or
		value or
		failed or
		poisoned or
		managedValue or
		deferredRecord or
		unvalidatedRecord or
		imagedRecord or
		imagedBox gives false
		storedRecord gives true
	end 'state'
end 'declHasInitializerFunction'

function mapLiteralColumnPair(columns MapLiteralColumns) returns ColumnPair throws AbsentError
