		0 gives InitializerFollowUp.none
		1 gives try cacheReadInitializerFollowUpNonConstantCall(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadInitializerFollowUp'

function cacheReadInitializerFollowUpNonConstantCall(reader LibraryCacheReader) returns InitializerFollowUp throws LibraryCacheDamage
	let a0 = freeze try reader.bytes()
	let a1 = (try reader.unsigned()) as LineNumber
	let a2 = (try reader.unsigned()) as ColumnNumber

	return InitializerFollowUp.nonConstantCall(a0, line: a1, column: a2)
end 'cacheReadInitializerFollowUpNonConstantCall'

// @generated library-cache end

export type NonConstantCallSite
	export let callee as immutable ByteArray
	export let filePath as FilePath
	export let line as LineNumber
	export let column as ColumnNumber

	export static function create(callee ByteArray, filePath FilePath, line LineNumber, column ColumnNumber) returns NonConstantCallSite
		return Self{callee: callee, filePath: filePath, line: line, column: column}
	end 'create'
end 'NonConstantCallSite'

export typealias NonConstantCallSiteArray = Array with NonConstantCallSite

union RecordInitializerProbe
	scalar(value ConstValue)
	record(settled ProbedRecord)
	unvalidated(followUp InitializerFollowUp)
end 'RecordInitializerProbe'

union ProbedScalarKind
	boolean
	integer
	float
	enumCase(typeName immutable ByteArray)

	function enumTypeName() returns immutable ByteArray
		return match self 'kind'
			enumCase(typeName) gives typeName
			boolean or
			integer or
			float gives EmptySourceText
		end 'kind'
	end 'enumTypeName'

	function agreesWith(other ProbedScalarKind) returns bool
		return self.ordinal == other.ordinal and self.enumTypeName().equals(other.enumTypeName())
	end 'agreesWith'
end 'ProbedScalarKind'

function probedScalarKindOfConst(value ConstValue) returns ProbedScalarKind
	if tagIsFloat(value.tag) 'aFloat'
		return ProbedScalarKind.float
	end 'aFloat'

	if value.tag == ValueTypeTag.boolean 'aBool'
		return ProbedScalarKind.boolean
	end 'aBool'

	if value.tag == ValueTypeTag.named and not value.typeName.isEmpty() 'anEnumCase'
		return ProbedScalarKind.enumCase(value.typeName)
	end 'anEnumCase'

	return ProbedScalarKind.integer
end 'probedScalarKindOfConst'

union ProbedSlot
	scalar(payload FullRangeInt, kind ProbedScalarKind)
	emptyContainer(valueType MaxonType)
	helperDefault(callee immutable ByteArray)
	unionCase(typeName immutable ByteArray, caseName immutable ByteArray)
	box(node ElementIndex)
	inlineWord(payload FullRangeInt, typeName immutable ByteArray)
end 'ProbedSlot'

function inlineWordOfProbedSlots(layout StructLayout, slots ProbedSlotArray) returns FullRangeInt throws AbsentError
	var word = 0 as FullRangeInt

	for i in 0 upto layout.fieldCount() 'eachField'
		let width = layout.fieldBitWidth(i)
		let payload = try inlineFieldPayloadOf(try slots.get(i) otherwise panic("inlineWordOfProbedSlots: slots.get OOB at {i} for `{String.from(layout.name)}` — the probe fills one slot per declared field"))
		let masked = payload if width == InlineRecordWordBits else (payload and inlineFieldMask(width as NarrowFieldWidth))
		word = word or (masked shl (layout.fieldBitOffset(i) as FullRangeInt))
	end 'eachField'

	return word
end 'inlineWordOfProbedSlots'

function inlineFieldPayloadOf(slot ProbedSlot) returns FullRangeInt throws AbsentError
	match slot 'slot'
		scalar(payload, _) then return payload
		helperDefault or
		emptyContainer or
		unionCase or
		box or
		inlineWord then throw AbsentError.absent
	end 'slot'
end 'inlineFieldPayloadOf'

typealias ProbedSlotArray = Array with ProbedSlot

type ProbedConstruction
	export let typeName as immutable ByteArray
	export let slots as ProbedSlotArray

	static function create(typeName ByteArray, slots ProbedSlotArray) returns ProbedConstruction
		return Self{typeName: typeName, slots: slots}
	end 'create'
end 'ProbedConstruction'

typealias ProbedConstructionArray = Array with ProbedConstruction

function pushProbedConstruction(nodes ProbedConstructionArray, construction ProbedConstruction) returns ElementIndex
	let id = nodes.count()
	nodes.push(construction)

	return id
end 'pushProbedConstruction'

union ProbedShape
	opaque
	constBlob(elementSize ElementStride, elementCount FullRangeInt, bytes immutable ByteArray, bounds ColumnBounds)
	stringTable(texts ByteBlobArray)
	emptyContainer
	payloadFreeUnionCase(typeName immutable ByteArray, caseName immutable ByteArray)
	construction(nodes ProbedConstructionArray)
end 'ProbedShape'

type ProbedRecord
	export let valueType as MaxonType
	export let brand as immutable ByteArray
	export let runsProgramCode as bool
	export let mapColumns as MapLiteralColumns
	export let shape as ProbedShape

	static function create(valueType MaxonType, brand ByteArray, runsProgramCode bool, mapColumns MapLiteralColumns, shape ProbedShape) returns ProbedRecord
		return Self{valueType: valueType, brand: brand, runsProgramCode: runsProgramCode, mapColumns: mapColumns, shape: shape}
	end 'create'
end 'ProbedRecord'

union ProbedImage
	none
	record(image TopLevelImageRecord)
	box(nodes ImmortalBoxNodeArray, root ElementIndex, typeName immutable ByteArray, tag ValueTypeTag)
end 'ProbedImage'

let GlobalInitializerPrefix = b"__global_init."
let ConstInitializerFunctionName = b"__const_initializer"

function isGlobalInitializerName(name ByteArray) returns bool
	return bytesStartWith(name, prefix: GlobalInitializerPrefix)
end 'isGlobalInitializerName'

function isInitializerFunctionName(name ByteArray) returns bool
	return name.equals(ConstInitializerFunctionName) or isGlobalInitializerName(name)
end 'isInitializerFunctionName'

function globalInitializerBindingOf(name ByteArray) returns String
	let label = try name.slice(GlobalInitializerPrefix.count(), endIndex: name.count()) otherwise panic("globalInitializerBindingOf: '{String.from(name)}' is not a '{String.from(GlobalInitializerPrefix)}' name — only a name isGlobalInitializerName admitted may be asked")
	let dataLabelPrefix = DataLabelPrefix.toByteArray()

	if bytesStartWith(label, prefix: dataLabelPrefix) 'aDataLabel'
		let labelled = try label.slice(dataLabelPrefix.count(), endIndex: label.count()) otherwise panic("globalInitializerBindingOf: '{String.from(label)}' starts with '{DataLabelPrefix}' and cannot be shorter than it")
		return try String.from(labelled).split(DataLabelDisambiguator).get(0) otherwise panic("globalInitializerBindingOf: splitting '{String.from(labelled)}' produced no segment")
	end 'aDataLabel'

	return try String.from(label).split(FileScopedKeySeparator).last() otherwise panic("globalInitializerBindingOf: splitting '{String.from(label)}' produced no segment")
end 'globalInitializerBindingOf'

function globalInitializerName(label ByteArray) returns immutable ByteArray
	return freeze "{String.from(GlobalInitializerPrefix)}{String.from(label)}".toByteArray()
end 'globalInitializerName'

// The result of asking the sweep for a constant's value. `failed` is not an error to report — the
// diagnostic is already recorded on the decl that owns it — it is the instruction to STOP.
union ConstEvalOutcome
	// `typeName` rides for `TopLevelConstant.value`'s reason: a constant that folded to an enum CASE is a
	// number whose type is the enum, and a reference from ANOTHER constant (`let B = A`) resolves through
	// this answer — so dropping the name here would silently retype `B` as a bare int.
	value(payload FullRangeInt, tag ValueTypeTag, typeName immutable ByteArray)
	failed
	notFound
end 'ConstEvalOutcome'

// Why a constant's initializer produced no value. Distinct from `SourceParseError` because the sweep
// has one outcome `SourceParseError` cannot express: "the defect is somewhere else, and is already
// reported".
union ConstEvalError implements Error
	// THIS initializer is defective; `error` is the positioned diagnostic for it.
	defective(error SourceParseError)

	// A constant this one READS has already been diagnosed. Carries no diagnostic of its own — see
	// `TopLevelConstant.poisoned`.
	dependencyFailed
end 'ConstEvalError'

export enum WalkedSibling
	notWalked
	takesReceiver
	takesNoReceiver
end 'WalkedSibling'

export enum SiblingKind
	notASibling
	staticSibling
	instanceSibling
end 'SiblingKind'

export enum BareCallKind
	topLevelBinding
	staticSibling
	instanceSibling
	reserved
	ambiguous
	genericTemplate
	declaredVisible
	builtin
	declaredHidden
	undeclared

	export function namesAVisibleFunction() returns bool
		return match self 'kind'
			declaredVisible or
			genericTemplate or
			ambiguous gives true
			topLevelBinding or
			staticSibling or
			instanceSibling or
			reserved or
			builtin or
			declaredHidden or
			undeclared gives false
		end 'kind'
	end 'namesAVisibleFunction'
end 'BareCallKind'

// The outcome of a USE-SITE constant lookup, after evaluation has finished. Deliberately NOT
// `ConstEvalOutcome`: a use site cannot trigger an evaluation (they are all done by then) and must
// not be able to, so it is given a type with no `failed` arm to mishandle.
export union TopLevelConstantLookup
	// `typeName` rides for `TopLevelConstant.value`'s reason — this is the answer a USE site reads, and it
	// is the one place the enum's spelling has to arrive for the emitted literal to be typed as the enum.
	found(payload FullRangeInt, tag ValueTypeTag, typeName immutable ByteArray)

	// The MANAGED twin of `found`: a use re-materializes the literal
	// from these bytes rather than inlining a number. It sits BESIDE `found` — unlike
	// `TopLevelConstant.managedValue`, which is appended — because the two "a constant of this name is
	// visible here" cases want to be one arm at the caller that only asks whether it EXISTS
	// (`Parser.rejectNonGlobalAssignment`: assigning to either is E2013).
	foundManaged(bytes immutable ByteArray, kind ManagedConstKind)
	notFound

	// ⭐⭐ **AN IMAGE-DATA RECORD `let`** — a constant array literal or an empty `Array with T`, whose bytes
	// the compiler lays down and whose read is one `.rdata` address. It carries the whole description
	// because the READER has no second door to ask: an imaged binding reserves no slot, so `globalDeclFor`
	// answers `notFound` for it and this is the only answer there is.
	//
	// ⚠ **DECLARED PAST `notFound`, which is where a new case goes** (`TopLevelConstant.managedValue`'s
	// rule): the two arms that ask only whether a constant EXISTS do not name this case, so each has to be
	// visited and decided.
	foundImageRecord(image TopLevelImageRecord)

	recordDeferred

	// ⭐⭐ **AN IMAGE-DATA `let` HOLDING A BOX** — a constructed struct whose every field was decided at
	// compile time, or a boxed union's payload-free case, whose bytes are its tag. Either way the whole
	// record TREE is `nodes`, `root` names the box the value stands at, and a read is one `.rdata` address.
	// It is a SEPARATE arm from `foundImageRecord` because the two describe different things: that one
	// carries a `__ManagedMemory`-shaped record's stride, count and element destructor, none of which a box
	// has.
	//
	// ⭐ **`tag` IS THE ONE THING THE TWO SHAPES DISAGREE ON** — a struct's value stands at `structRef` and a
	// union's at `named`, which is what routes its `match` and its drop — so it rides beside the bytes rather
	// than earning a second arm that would differ in nothing else.
	//
	// ⚠ APPENDED PAST `foundImageRecord`, which is where a new arm goes.
	// ⚠ **THE TYPE CROSSES AS A NAME, NOT AS AN INTERNED ID** — `found`'s rule, and it is the difference
	// between a value the reading file can mint and a panic: every `structRef` and `named` id is minted from
	// the FILE's own interner, and an id minted here names something else there.
	foundImageBox(nodes ImmortalBoxNodeArray, root ElementIndex, typeName immutable ByteArray, tag ValueTypeTag)

	// The binding's initializer, or one it reads, owns a diagnostic already (`TopLevelConstant.poisoned`). A
	// read mints a deferred value, so that diagnostic is not repeated at every use.
	poisoned
end 'TopLevelConstantLookup'

// ⭐⭐ **EVERYTHING A USE SITE NEEDS TO MATERIALIZE AN IMAGE-DATA `let`** — the record's SHAPE, its payload
// and the type the value is minted at, resolved together by the index that holds both the instance registry
// and the outcome. It is one description rather than three parameters because the shape decides which of the
// other two mean anything: a `constBlob`'s bytes are its payload, an `emptyContainer` has none and carries
// its element's destructor instead.
export type TopLevelImageRecord
	export let kind as ImmortalRecordKind
	export let elementSize as ElementStride
	export let elementCount as FullRangeInt
	export let bytes as immutable ByteArray
	export let valueType as MaxonType
	export let bounds as ColumnBounds

	// The generic-instance alias the initializer spelled (`Xs.create()`), or EMPTY — `TopLevelGlobalLookup`'s
	// `brand` and it rides for that field's reason: a read wears the alias it was declared under, and a value
	// that loses it decays into any brand of its instance.
	export let brand as immutable ByteArray

	export static function create(kind ImmortalRecordKind, elementSize ElementStride, elementCount FullRangeInt, bytes ByteArray, valueType MaxonType, brand ByteArray, bounds ColumnBounds) returns TopLevelImageRecord
		return Self{kind: kind, elementSize: elementSize, elementCount: elementCount, bytes: bytes, valueType: valueType, brand: brand, bounds: bounds}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteImmortalRecordKind(writer, value: self.kind)
		writer.signed(self.elementSize as CacheSigned)
		writer.signed(self.elementCount as CacheSigned)
		writer.bytes(self.bytes)
		cacheWriteMaxonType(writer, value: self.valueType)
		cacheWriteColumnBounds(writer, value: self.bounds)
		writer.bytes(self.brand)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns TopLevelImageRecord throws LibraryCacheDamage
		let f_kind = try cacheReadImmortalRecordKind(reader)
		let f_elementSize = (try reader.boundedSigned(-4, high: 8)) as ElementStride
		let f_elementCount = (try reader.signed()) as FullRangeInt
		let f_bytes = freeze try reader.bytes()
		let f_valueType = try cacheReadMaxonType(reader)
		let f_bounds = try cacheReadColumnBounds(reader)
		let f_brand = freeze try reader.bytes()

		return Self{kind: f_kind, elementSize: f_elementSize, elementCount: f_elementCount, bytes: f_bytes, valueType: f_valueType, bounds: f_bounds, brand: f_brand}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize56
		return sizeof(TopLevelImageRecord) as CacheSize56
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'TopLevelImageRecord'

// The outcome of a USE-SITE lookup for a stored top-level binding — `TopLevelConstantLookup`'s twin, and
// deliberately a DIFFERENT type carrying DIFFERENT payload. A constant's use needs its VALUE (it
// inlines a number); a stored binding's use needs its LABEL and TYPE (it emits a load against a slot). One
// union carrying both would have an arm every caller had to prove it was not holding.
//
// ⚠ **THE WHOLE `MaxonType`, NOT A BARE TAG**. A stored `Buffer` loads a value of the
// CONCRETE `Array with Byte` instance, and an instance is its gid — a tag alone cannot say which one, and
// a use site that re-derived it would be a second answer to "what type is this global?" free to name a
// different instance than the slot was laid out for.
export union TopLevelGlobalLookup
	// `brand` is the generic-instance alias the initializer spelled (`Xs.create()`), or empty.
	found(label immutable ByteArray, valueType MaxonType, brand immutable ByteArray)
	notFound

	// `TopLevelConstantLookup.poisoned`, for a binding with a slot.
	poisoned
end 'TopLevelGlobalLookup'

export type BindingTypeClaim
	export let valueType as MaxonType
	export let brand as immutable ByteArray

	export static function create(valueType MaxonType, brand ByteArray) returns BindingTypeClaim
		return Self{valueType: valueType, brand: brand}
	end 'create'
end 'BindingTypeClaim'

// Which kind of top-level declaration a lookup is asking for. The two are resolved by ONE probe
// (`declFor`) and are never interchangeable at a use site: an inlined binding materializes its value, a
// stored one loads from a slot.
//
// ⚠ **IT IS `inlined` vs `stored`, NOT scalar vs record**. A record a read cannot re-materialize gets a
// `.data` slot, while a `let` whose bytes the compiler can lay down is INLINED and gets none.
// `TopLevelDecl.hasStorage` is the one criterion.
//
// An enum, not a bare bool: at a CALL SITE `wanted: DeclKind.inlined` says what is being asked for, where
// `wanted: false` would be a magic value the reader has to decode against the field's polarity.
enum DeclKind
	inlined
	stored
	either
end 'DeclKind'

// The per-argument classification the "does any interned instance of `baseName` classify its type
// parameter at `position` as …?" instance-scan gates in `ProgramSignatures` differ on — the ONE thing that
// varies between them, named here so the registry SCAN (match base name, bounds-guard the arg) lives in one
// place (`instanceWithTypeArgKind`) and a fix to the loop or the bound cannot reach one gate and silently
// miss the others.
export enum TypeArgInstantiationKind
	// The box MOVES the argument in and the caller may not reuse it (`typeArgIsOwned`): a String, an owning
	// struct, a boxed union, a managed generic instance — the managed-field DROP and the reassign's
	// descriptor-gated old-value drop.
	consumeMoved

	// Not deep-cloneable at all (`not typeSupportsDeepClone`): a compiler-owned aggregate, an existential, or a
	// generic instance with no per-instance cloner behind it — the opaque-copy front-end reject.
	uncopyableElement

	// A HEAP AGGREGATE (`typeIsManaged`): a String, a struct, a boxed union, a nested container — anything
	// whose slot is a POINTER rather than the value.
	//
	// ⛔ **IT IS NOT `consumeMoved`, AND THE TWO ARE ONE WORD APART IN ENGLISH AND A WHOLE CLASS APART IN
	// FACT.** That one is the CONSUME boundary (`typeArgIsOwned` — does the box take the caller's value
	// away), and it answers FALSE for an all-scalar struct, which is BORROWED at the call site. A container
	// slot standing for one is still a pointer with a live `destroyFunc@40` behind it, so the boundary
	// this kind needs is the one `containerElementIsManaged` — the concrete container's own element gate —
	// already reads. The two gates then agree on what "managed" means, which is what a shared body's refusal
	// and a concrete instance's refusal must do.
	managedElement

	// A HEAP AGGREGATE again (`typeIsManaged`) — the SAME boundary as `managedElement`, asked in the EMITTING
	// direction: can the instance descriptor's `retainFunc@64` be non-zero for this parameter, so that a
	// shared body forwarding a borrowed `T` to a durable sink owes a reference?
	//
	// ⛔ **IT IS A SEPARATE KIND *BECAUSE OF `kindIsARefusal`*, which is the one axis that makes two gates over
	// one boundary two different questions.** `managedElement` REFUSES, so it must ignore rows that are not
	// facts about the program; ignoring one there costs a wrong ANSWER. This one EMITS, and its wrong direction
	// is a USE-AFTER-FREE — a managed instantiation whose row was skipped would leave the borrow unreferenced.
	// So it reads EVERY row, exactly as `consumeMoved` does.
	retainedFeed

	// Is or holds a promise (`sourceCloneVerdictOfType`): the opaque-copy refusal, E3141. Kept apart
	// from `uncopyableElement` because the `deepClone` walk that one reads takes a promise for a
	// cloneable leaf, so a copy it admits gives two owners one green thread.
	greenThreadElement

	// Is or holds a promise, for a shared body's constructor feed: the one answer that decides both
	// that the body keeps the feed, that its store is a refused-on-reuse move, and that a closure-captured
	// `T` may not be given away (E3141). Apart from
	// `greenThreadElement` because it must also see an instantiation reached through a declaration view.
	greenThreadFeed

	// Zero is no value of the argument: a managed type, or one `typeExcludesZero` answers for. The front-end
	// reject for a shared body that zeroes slots of a type parameter (`FixedArray with N <type parameter>`'s
	// `create()`, `Array.create(n)`, a user-tier `resize`), so one such instantiation refuses the body (E3106).
	noZeroElement
end 'TypeArgInstantiationKind'

// @generated library-cache begin
let CacheCasesTypeArgInstantiationKind = [TypeArgInstantiationKind.consumeMoved, TypeArgInstantiationKind.uncopyableElement, TypeArgInstantiationKind.managedElement, TypeArgInstantiationKind.retainedFeed, TypeArgInstantiationKind.greenThreadElement, TypeArgInstantiationKind.greenThreadFeed, TypeArgInstantiationKind.noZeroElement]

function cacheReadTypeArgInstantiationKind(reader LibraryCacheReader) returns TypeArgInstantiationKind throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesTypeArgInstantiationKind.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadTypeArgInstantiationKind'

function cacheTableAgreesTypeArgInstantiationKind() returns bool
	let declared = TypeArgInstantiationKind.allCases

	if CacheCasesTypeArgInstantiationKind.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesTypeArgInstantiationKind.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesTypeArgInstantiationKind'

// @generated library-cache end

// Whether an instance of the declaring base classified its argument as the asked-for kind, and for a REFUSING
// kind where the program wrote that instance. A UNION rather than a bool because the two questions have
// different answers to give: an EMISSION gate wants membership, and a REFUSAL wants the source anchor the
// author can read (`LibraryBlame`). The anchor rather than the instance id, because an id is one file's
// numbering and the anchor is the same in every file.
export union TypeArgKindMatch
	noInstance
	instance(site InstantiationSiteLookup)
end 'TypeArgKindMatch'

// ⭐ **WHICH OF THE KINDS REFUSE A PROGRAM RATHER THAN SHAPE AN EMISSION** — the direction test
// `instanceWithTypeArgKind` applies, stated here beside the kinds it splits so the reason travels with them.
//
// The emission kinds answer *"must this shared body carry a drop?"*, where a row describing a shape that
// never occurs buys a descriptor-gated drop nothing executes — a no-op at run time — and ignoring one would
// omit a drop that is owed. They therefore keep reading every row. The REFUSING kinds answer *"must this
// program be REFUSED?"*, where such a row is not a conservative margin but a wrong answer about a program
// that does not contain the instantiation being refused for.
//
// ⛔ **TWO CLASSES OF ROW ARE NOT FACTS ABOUT THE PROGRAM, AND ONLY A REFUSAL MAY NOT READ THEM** —
// a speculatively minted one and one minted by substituting into an instantiation E3017 already
// owns. They are unrelated in origin and identical in consequence, which is why one predicate
// answers for both; `instanceWithTypeArgKind` applies it twice.
function kindIsARefusal(kind TypeArgInstantiationKind) returns bool
	match kind 'kind'
		consumeMoved or
		retainedFeed then return false
		uncopyableElement or
		managedElement or
		noZeroElement or
		greenThreadElement or
		greenThreadFeed then return true
	end 'kind'
end 'kindIsARefusal'

// Does a row whose argument is another declaration's parameter answer this kind through that parameter's own
// rows (`ProgramSignatures.typeArgKindMatchThrough`)?
//
// ⭐ **THE TWO SHARED-BODY REASSIGNMENT KINDS DO.** The old value a reassignment displaces is released through
// the descriptor's `destroyFunc@40`, read at run time, so answering for every instantiation a view stands for
// adds only drops that are inert where nothing is owned — and the co-owned refusal has to see the instantiation
// that would leak.
//
// ⭐ **AND SO DOES THE RETAIN.** A nested declaration view's slot is released through that view's dictionary
// destructor against the parameter the view stands at (`MmRuntime.nestedViewDropKind`), so the reference its
// constructor feed takes must be decided by the same parameter's instantiations.
//
// ⭐ **AND SO DOES `greenThreadFeed`, THE ONE REFUSING KIND THAT DOES.** A promise reached only through a
// view still makes the shared body's store a move, so a reuse of the feed must be refused there too.
//
// ⛔ The other REFUSING kinds do not.
function kindFollowsADeclarationView(kind TypeArgInstantiationKind) returns bool
	match kind 'kind'
		consumeMoved or
		retainedFeed or
		greenThreadFeed then return true
		uncopyableElement or
		managedElement or
		noZeroElement or
		greenThreadElement then return false
	end 'kind'
end 'kindFollowsADeclarationView'

// The `StdType` a global whose `.data` bytes ARE ITS VALUE occupies its slot as — which is to say WHICH
// TAGS MAY BE A FOLDED GLOBAL AT ALL, because the width itself is not this function's to know.
//
// ⚠⚠ **IT ANSWERS FOR THE INLINE-VALUE PATH ONLY, AND SERVING BOTH PATHS IS WHAT GOES WRONG.**
// A RECORD-valued global reserves a POINTER instead, and its width is a fact about the SLOT rather than
// about the tag; it goes through `recordPointerSlotType`, which carries its own reachability guard. A door
// serving both applies this one's guard — written for a folded scalar and perfectly right about one — to
// a factory's declared RETURN type, where the `named` tag means a boxed union or a tuple alias
// and not a ranged alias at all: a legal program PANICS, told that its global is *"tagged 'int'"* in a
// program with no int in it. So the arms below say what is true of THIS caller, and the record
// tags that could break through here name the door that takes them.
//
// ⚠ **IT CARRIES NO TABLE OF ITS OWN, AND THAT IS THE POINT.** Answering `integer`→i64
// and `boolean`→i1 in its own two arms makes it a SECOND copy of the tag→`StdType` collapse
// that `LowerMaxonToStd.valueTagToStdType` already is — one fact written down twice, in the
// project's signature failure mode, and the two copies drift in the only way they
// can: a copy with no `float` arm panics on `var pi = 3.14` while the lowering is
// perfectly willing to give it an f64. A global's width and a value's width are THE SAME QUESTION,
// and `data-section-f64-8byte` pins the 8 bytes that answer proves.
//
// ⭐ **THE REACHABILITY GUARD IS WHAT IS LOCAL** — which folded constants may be a global's inline value
// — and that is a different question from how wide the type is. Every tag but the four a constant
// folds to panics by name; a bare `default` here would silently size a tag nothing in this door understands.
//
// `boolean` is ONE byte (`i1`, whose `storageBytes` is 1), which is what
// `static-variables.md`'s `data-section-bool-1byte` pins; `integer` is eight (`i64`); `float` is
// eight (`f64`); a payload-free case's ordinal is eight. All of them come from the one table.
function globalStdType(tag ValueTypeTag, name ByteArray) returns StdType
	match tag 'reachable'
		boolean or
		integer or
		float or

		// A payload-free enum or union case is the one `named` whose `.data` bytes are its value: its
		// value is its tag, a number fixed at declaration, so the slot holds the
		// ordinal and the machine word comes from `valueTagToStdType` below. That is the word
		// `declaredAggregateSlotWidth` states for a field holding the same enum, which keeps a global
		// and a field from storing one enum at two widths.
		//
		// ⚠ It is the only `named` a folded constant carries, and a second one would not be an int. A float
		// ranged alias also carries this tag, and the i64 collapse below would be a wrong answer about it, so
		// an `as` cast in a constant initializer owes this door an arm of its own rather than inheriting
		// this one.
		named or
		exitCode then break
		unresolved or
		void then panic("globalStdType: top-level var '{String.from(name)}' is tagged '{typeTagName(tag)}' — only booleans, integers, exit codes, floats and payload-free enum or union cases are ever folded")

		// A `structRef` global IS its value — a declared type that packs inline into one word. Sound only
		// because `foldedGlobalStdType` has already refused a declared type that does NOT pack: this tier
		// holds no name to ask.
		structRef then return valueTagToStdType(tag)

		// ⭐ THE RECORD TAGS. A `String` or `b"…"` literal, a character, a function value and an
		// array/container instance are globals whose `.data` bytes are a POINTER rather than a value, so
		// their width is `recordPointerSlotType`'s to answer and not this door's. Letting them break through
		// here is what applies this guard's `named` arm to a factory return type it is not written about — see
		// this function's header.
		//
		// ⚠ ONE SENTENCE, not one per tag: they differ by nothing the message does not already carry,
		// because `typeTagName(tag)` names which of them arrived.
		string or
		genericInstance or
		function or
		character then panic("{recordSlotGlobalPanic(name, tag: tag)}")

		// A TYPE-PARAMETER global is unreachable: a type parameter names no value outside a
		// generic body, and a global's inline value is a folded scalar constant.
		typeParameter then panic("globalStdType: top-level var '{String.from(name)}' is tagged '{typeTagName(tag)}' — a type parameter names no value at module scope")

		// An EXISTENTIAL global is unreachable: `Parser.requireGlobalIsNotAnExistential` refuses an
		// interface-typed initializer (E2015), because a `.data` slot for a fat pointer would be TWO
		// words, which neither single-width door can express.
		interfaceRef then panic("globalStdType: top-level var '{String.from(name)}' is tagged '{typeTagName(tag)}' — an interface-typed value is a two-word fat pointer, and a folded global's inferred type comes from a scalar constant")

		// A `cstring` is produced by a CALL (`String.cstr()`), and a call's result is never a folded
		// constant — so a folded global is never one.
		cstring then panic("globalStdType: top-level var '{String.from(name)}' is tagged '{typeTagName(tag)}' — a `cstring` comes out of a call, which is not a constant initializer")
	end 'reachable'

	return valueTagToStdType(tag)
end 'globalStdType'

// The one sentence the RECORD tags share when they reach the INLINE-VALUE door by mistake. Written
// once because the only thing that distinguishes them — which tag arrived — is already interpolated into
// it, and because the door it redirects to is a name that can be renamed.
function recordSlotGlobalPanic(name ByteArray, tag ValueTypeTag) returns String
	return "globalStdType: top-level var '{String.from(name)}' is tagged '{typeTagName(tag)}' — a record-valued global's slot holds a POINTER `__module_init` fills, so it is typed by `recordPointerSlotType`; this door answers only for a global whose `.data` bytes ARE its value"
end 'recordSlotGlobalPanic'

let FirstRunArgumentPosition = 0 as ElementIndex

function valueTypeOfReturn(returnType MaxonReturnType) returns MaxonType throws AbsentError
	match returnType 'returned'
		value(inner) then return inner
		void then throw AbsentError.absent
	end 'returned'
end 'valueTypeOfReturn'

// What the index knows about a callee — the TWO outcomes the old `MaxonType.unresolved` sentinel
// collapsed into one, plus the third (`void`) that it dropped on the floor.
export union CalleeReturn
	// Some file declares this function, and `returnType` is its declaration UNDISTORTED: `void`
	// means it returns nothing at all (using the call as a value is an error — `Parser.parseCall`),
	// `value(t)` means it returns a `t`. The old code mapped BOTH of these and the case below onto
	// one `unresolved`, which is how `let x = noop()` then `x + 4` compiled.
	declared(returnType MaxonReturnType)

	// NO file declares it. The parser DEFERS — it types the call `unresolved` — rather than
	// reporting, and that is deliberate: the authoritative answer belongs to
	// `SemanticCheck.validateCall`, which reads the registry the REAL parse built (E3004, "call to
	// undefined function"). This token sweep is the TOLERANT half of the pair (it records only the
	// exact `function NAME ( … ) returns TYPE` shape and skips anything else without complaint), so
	// it must never gain a veto: a sweep that missed a declaration the parser accepts would reject
	// a correct program. Two whole-program tables that could each veto a call would also be one
	// fact written down twice — and this one is not the authority.
	undeclared
end 'CalleeReturn'

// ⭐ **THE INSTANCE A BARE GENERIC TYPE NAME DENOTES IN A TYPE-PARAMETER SCOPE, or `notInScope`** —
// see `ProgramSignatures.scopedGenericInstanceOf`. A union rather than a sentinel for `DeclaredAlias`'s
// reason: "this scope binds nothing for that name" is an ANSWER — the name then means exactly what it always
// meant — and `GenericInstanceId` has no value free to say it with.
export union ScopedGenericInstance
	instance(id GenericInstanceId)
	notInScope
end 'ScopedGenericInstance'

// Does `scopeParamNames` bind every one of `paramNames`? — the ALL-OR-NOTHING half of
// `ProgramSignatures.scopedGenericInstanceOf`. A PARTIAL overlap binds nothing rather than binding
// what it can: `type Pair uses A, B` named inside `type Outer uses A` has no `B` for the scope to
// stand for, and inventing one would give the instance an argument the author never wrote. The name
// then stays what it was, and the ordinary refusals speak for it — a positioned `E3005` at the
// reference.
//
// A linear scan over both: a type declares a handful of parameters, so a name→index map would be a heap
// object bought to serve one or two lookups.
function scopeBindsEveryTypeParam(paramNames NameRoster, scopeParamNames NameRoster) returns bool
	for paramName in paramNames 'eachParam'
		if not scopeParamNames.contains(paramName) 'notInScope'
			return false
		end 'notInScope'
	end 'eachParam'

	return true
end 'scopeBindsEveryTypeParam'

// What the index knows about a NAMED type — `CalleeReturn`'s twin, and a union for the same
// reason: "no file declares this" is an ANSWER, not a failure, and spelling it as a sentinel range
// (`low: 0`) would make an undeclared name read as UNSIGNED, which is the one thing it must never
// silently do.
export union DeclaredAlias
	declared(alias RangedTypeAlias)
	undeclared
end 'DeclaredAlias'

// @generated library-cache begin
function cacheWriteDeclaredAlias(writer LibraryCacheWriter, value DeclaredAlias)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		declared(a0) then cacheWriteDeclaredAliasDeclared(writer, a0: a0)
		undeclared then break
	end 'payload'
end 'cacheWriteDeclaredAlias'

function cacheWriteDeclaredAliasDeclared(writer LibraryCacheWriter, a0 RangedTypeAlias)
	a0.cacheWrite(writer)
end 'cacheWriteDeclaredAliasDeclared'

function cacheReadDeclaredAlias(reader LibraryCacheReader) returns DeclaredAlias throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives try cacheReadDeclaredAliasDeclared(reader)
		1 gives DeclaredAlias.undeclared
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadDeclaredAlias'

function cacheReadDeclaredAliasDeclared(reader LibraryCacheReader) returns DeclaredAlias throws LibraryCacheDamage
	let a0 = try RangedTypeAlias.cacheRead(reader)

	return DeclaredAlias.declared(a0)
end 'cacheReadDeclaredAliasDeclared'

// @generated library-cache end

function requireDeclaredAlias(resolved DeclaredAlias) returns RangedTypeAlias throws MapError
	match resolved 'resolved'
		declared(alias) then return alias
		undeclared then throw MapError.keyNotFound
	end 'resolved'
end 'requireDeclaredAlias'

// What the index knows about a FUNCTION typealias — `DeclaredAlias`'s twin, and a union for
// the identical reason: "no file declares a function alias of this name" is an ANSWER, not a failure.
// THE door `Parser.parseTypeReference` asks "is this name a function type?" through — a hit re-tags the
// reference `MaxonType.function`; a miss leaves it a `named` for the ranged/struct/enum registries.
export union DeclaredFunctionAlias
	declared(alias FunctionTypeAlias)
	undeclared
end 'DeclaredFunctionAlias'

// What the index knows about a declared STRUCT TYPE — `DeclaredAlias`'s twin, and a union for the
// identical reason. "No file declares a `type` of this name" is an ANSWER: the name is probably a
// ranged alias, or `ExitCode`, or a typo — and each of those is somebody else's question. Handing
// back an empty layout instead would make an undeclared name read as a struct with NO FIELDS, so
// `p.x` would report "no field 'x'" for a type that is not a struct at all.
export union DeclaredStruct
	declared(layout StructLayout)
	undeclared
end 'DeclaredStruct'

// What the index knows about a declared ENUM/UNION type — `DeclaredStruct`'s twin, and a union for
// the identical reason. "No file declares an `enum`/`union` of this name" is an ANSWER: the name is
// probably a struct, a ranged alias, or a typo — each somebody else's question. THE door the parser
// asks every enum question through: is this scrutinee an enum? what are its cases and tags?
export union DeclaredEnum
	declared(layout immutable EnumLayout)
	undeclared
end 'DeclaredEnum'

union DeclaredBinding
	declared(declFilePath FilePath)
	undeclared
end 'DeclaredBinding'

union DeclaredTypeName
	declared(kind TypeDeclKind, visibility Visibility, declFilePath FilePath)
	undeclared
end 'DeclaredTypeName'

// ⭐ **THE KINDS OF RECORD THAT MAY LIE WITHIN A RECORD**
// (`ProgramSignatures.recordKindsWithinAggregate`). A kind is a declared struct's or union's name,
// a generic instance's canonical name (`canonicalInstanceName`, which a declaration may also spell,
// and one kind then stands for both), `HeldTupleKind` for every tuple, or `HeldByteRecordKind` for
// a `String` or a `Character`; `anything` says an opaque slot — a type parameter, an existential, a
// function value's environment, a compiler-owned aggregate — may hold any record.
export type HeldRecordKinds
	export var kinds as HeldRecordKindSet
	export var anything as bool

	static function create() returns HeldRecordKinds
		return Self{kinds: HeldRecordKindSet.create(), anything: false}
	end 'create'

	function mayHold(kind ByteArray) returns bool
		return self.anything or self.kinds.contains(kind)
	end 'mayHold'

	function holdsNothing() returns bool
		return not self.anything and self.kinds.count() == 0
	end 'holdsNothing'

	function mayHoldWritableRecord(kind ByteArray, writability RecordKindWritability) returns bool
		return self.mayHold(kind) and writability.isWritableState(kind)
	end 'mayHoldWritableRecord'

	function holdsNoWritableRecord(writability RecordKindWritability) returns bool
		if self.anything 'anOpaqueSlot'
			return false
		end 'anOpaqueSlot'

		for kind in self.kinds 'eachKind'
			if writability.isWritableState(kind) 'aWritableKind'
				return false
			end 'aWritableKind'
		end 'eachKind'

		return true
	end 'holdsNoWritableRecord'

	function overlaps(other HeldRecordKinds, writability RecordKindWritability) returns bool
		if self.holdsNoWritableRecord(writability) or other.holdsNoWritableRecord(writability) 'oneHoldsNothingWritable'
			return false
		end 'oneHoldsNothingWritable'

		if self.anything or other.anything 'anOpaqueSlot'
			return true
		end 'anOpaqueSlot'

		for kind in self.kinds 'eachKind'
			if other.mayHoldWritableRecord(kind, writability: writability) 'sharedWritableKind'
				return true
			end 'sharedWritableKind'
		end 'eachKind'

		return false
	end 'overlaps'
end 'HeldRecordKinds'

export typealias HeldRecordKindSet = Set with ByteArray

typealias RecordKindVerdicts = Map with (ByteArray, bool)

// A memo of `ProgramSignatures.recordKindIsWritableState`, sound only while the kinds it has
// answered cannot change. The provenance tracer keeps one for its life; the Parser makes one per
// question, because canonical instance names are journaled during a parse and can roll back in the
// middle of it.
type RecordKindWritability
	var signatures as ProgramSignatures
	var verdicts as RecordKindVerdicts

	static function of(signatures ProgramSignatures) returns RecordKindWritability
		return Self{signatures: signatures, verdicts: RecordKindVerdicts.create()}
	end 'of'

	function isWritableState(kind ByteArray) returns bool
		if let known = try self.verdicts.get(kind) 'asked'
			return known
		end 'asked'

		let verdict = self.signatures.recordKindIsWritableState(kind)
		self.verdicts.upsert(kind, value: verdict)
		return verdict
	end 'isWritableState'

	function namesAnImmutableAggregate(tag ValueTypeTag, nameId TypeNameId, from TypeNameInterner) returns bool
		if tag != ValueTypeTag.genericInstance and not self.signatures.tagMayNameAggregate(tag) 'namesNoAggregate'
			return false
		end 'namesNoAggregate'

		return not self.isWritableState(try self.signatures.heldRecordKindOfTag(tag, nameId: nameId, from: from) otherwise return false)
	end 'namesAnImmutableAggregate'
end 'RecordKindWritability'

// The sweep and the canonical pass spell one tuple differently, so every tuple is one kind.
let HeldTupleKind = b"(tuple)"
let HeldByteRecordKind = b"(bytes)"
let UniqueHoldingKeyPrefix = b"holds:"

// ⭐ **HOW A UNION PAYLOAD FIELD IS STORED AND DROPPED.** The ONE classifier the
// construct (move-in), the match extract (move-out), the drop routing, and the synthesized
// `__destruct_<U>` cascade all read, so "is field F managed, and if so String or struct?" is decided in
// exactly ONE place. That is the whole defence against a split decision: a field moved IN but
// not dropped leaks; dropped but not moved in double-frees — and neither can happen when one function
// decides both.
union PayloadClass
	// int / bool / exitCode / a ranged-int alias / a payload-free enum (whose value IS its i64 tag).
	// Stored inline; owns nothing; the cascade skips it.
	scalar(storage MaxonType)

	// A String (`isString`) or a struct box — an owned heap pointer. Construct MOVES it in (no incref);
	// a match binding MOVES it out; the cascade drops it (String via `__str_decref`, struct via
	// `__mm_decref`). `storage` is the field's own type, which `maxonTypeToStdType` gives a machine word.
	managed(storage MaxonType, isString bool)

	// A boxed-union field/payload (a nested payload-bearing union) — a MANAGED owned heap pointer, exactly
	// like a `managed` struct box: construct MOVES it in (no incref), and the cascade drops it through its
	// OWN `__destruct_<U>` (or the trivial `__mm_decref` for a scalar-only union box). `storage` is the
	// field's `named(<union>)` type — the value tag a slot type-check compares against the value and the tag
	// a moved-out load carries, which is what makes a nested `match` on the extracted payload work.
	//
	// ⚠ **IT IS A CASE DISTINCT FROM `managed` BECAUSE ITS SLOT WIDTH AND ITS VALUE TYPE ARE DIFFERENT
	// ANSWERS, AND FOR NO OTHER REASON** — stated in full, arm by arm, at `payloadStorageOf`, which is
	// the one home of that split. What is local to this case: nesting costs NO codegen at any depth, because a
	// nested box's drop closes at RUN TIME through the destructor pointer in its own allocation header.
	nestedUnion(storage MaxonType)

	// A name no file declares — `TypeResolution` reports it as E3011; the caller keeps the op
	// well-formed for the instant before the pipeline's error gate throws.
	undeclaredName

	// ⭐ **A STRUCT FIELD DECLARED AT AN INTERFACE TYPE** — the two-slot fat
	// pointer. MANAGED (`payloadClassIsManaged`), so the construct MOVES it in and the cascade drops it — but
	// kept a case DISTINCT from `managed` by ITS OWN arithmetic: a conformer takes TWO slots (a value half and
	// a witness half), and a union payload has exactly ONE, because every case of a union shares one slot
	// region and there is nowhere for a second word to widen into. So a union PAYLOAD at an interface type is
	// refused — at its DECLARATION (`Parser.requireStorableDeclaredType`) — while the STRUCT-field path carves
	// out both slots and lowers it. That refusal is PERMANENT and arithmetic. Its storage is the VALUE
	// half's machine word; the witness half is stored beside it by `Parser.emitFieldStore`, which is the only
	// site that knows the field's base offset.
	//
	// ⚠ **APPENDED AT THE END, per the band-append rule** — `payloadClassIsManaged`/`payloadClassIsString` are
	// exhaustive `match`es over this union, so a case inserted mid-list would be silently absorbed by nothing
	// while a case appended is a compile error at every one of them until it is answered.
	existential

	// ⭐⭐ **A SLOT DECLARED AT THE ENCLOSING GENERIC'S OWN TYPE PARAMETER** — one opaque machine
	// word in the shared body, whose ownership is a fact only the INSTANTIATION has. It is NOT
	// `payloadClassIsManaged`: nothing in the declaration view drops it (the base struct's own
	// `__destruct_<Base>` skips it — a per-INSTANCE cascade drops the substituted field, which is a different
	// symbol), so calling it managed here would drop it twice in the one view that can see neither.
	//
	// ⚠ **BUT IT IS NOT A PLAIN SCALAR EITHER, AND THAT WAS THE DEFECT.** It classified as `scalar` and so was
	// stored RAW — while the record it was stored into is CONCRETE at the caller (a `(String, Integer)` tuple,
	// a `Box with String`) and its destructor drops that slot. Two owners, one reference. The store now takes
	// its own reference through the descriptor's `retainFunc@64` (`Parser.moveInPayload`), which is inert on a
	// trivial instantiation and so leaves those instances storing exactly the word they always stored.
	//
	// `storage` is the `typeParameter` type itself — the same value the `scalar` arm carried, so every reader
	// asking about the SLOT (its width, a loaded value's type) is unchanged.
	typeParam(storage MaxonType)

	// ⭐⭐ **A GREEN-THREAD HANDLE — A ONE-WORD SLOT THAT OWES A RECLAIM AND MAY NOT BE RETAINED**.
	// It is not `scalar`: a scalar payload owns nothing, so a union holding one synthesizes no drop and the
	// construct copies the word in raw. MEASURED with the promise reading `scalar`: `union Slot { held(p
	// IntPromise) }` exited **92** — the spawn stayed the caller's statement-scoped pending temporary, the
	// drain cancelled it at the end of the constructing statement, and the `match`ed-out promise was awaited
	// dead. And it is not `managed`: there is no refcount to take, so a retain would write into the
	// scheduler's slab.
	//
	// ⚠ APPENDED, never inserted — the arms above are matched by ordinal in the storage band.
	greenThread(storage MaxonType)
end 'PayloadClass'

// Which ownership question a field walk is asking. The two are NOT degrees of one:
// `isAManagedRecord` is "may this be retained or cloned" and `owesDrop` is "must this be
// reclaimed", and a promise answers no to the first and yes to the second. See
// `ProgramSignatures.typeOwesDrop`.
enum FieldOwnershipQuestion
	owesDrop
	isAManagedRecord
end 'FieldOwnershipQuestion'

// ⭐⭐ **HOW A CONFORMER'S VALUE HALF IS OWNED AND RELEASED — ONE DECISION, TWO WITNESS WORDS.** The
// witness table carries a `destroyFunc@8` and a `retainFunc@16`, and both are derived from THIS
// answer (`ProgramSignatures.existentialOwnershipProtocol`) rather than each re-deciding "is this
// conformer managed, and how". A second independent derivation is exactly how the two words would
// come to disagree about a conformer — a table whose drop frees a record its retain never took.
//
// ⚠ **THE THREE CASES ARE THREE DIFFERENT PROTOCOLS, NOT THREE DEGREES OF ONE.** A byte record COPIES on
// co-ownership and an aggregate CO-OWNS, and the split is not a preference: a `String` LITERAL is a wholly
// immortal `.rdata` record, so an incref of one is a write to read-only memory (see
// `IrInterface.WitnessRetainFuncOffset` for the measured access violation). It is the same split
// `Parser.promoteBorrowedToOwned` makes for a CONCRETE String, reached here through a witness because the
// conformer is a run-time fact.
union ExistentialOwnershipProtocol
	// The value half is not a pointer at all — an `int`/`bool` conforming intrinsically
	// (`isIntrinsicBuiltinConformance`). BOTH words stay 0, and both runtime entries are inert on it.
	none

	// A `String`/`Character` fused byte record: released by `__str_decref`, co-owned by COPYING
	// (`__str_clone`), which is what an immortal literal source requires.
	byteRecord

	// A struct/union/generic-instance box: released by its own `__destruct_<T>`/`__mm_decref`, co-owned by
	// `__mm_retain` — an aggregate has no cheap owning copy and its alias is observable, so it must stay the
	// same box.
	aggregate

	// ⭐⭐ **A GREEN-THREAD HANDLE — THE ONE PROTOCOL THAT RELEASES WITHOUT EVER RETAINING**.
	// A promise is reclaimed by `__gt_promise_drop` (unlink, free the stack, cancel) and has NO refcount to
	// take a second reference through, because a green thread has exactly one owner at every instant.
	//
	// ⚠⚠ **IT IS THE ARM THAT BREAKS "THE TWO WORDS ARE NON-ZERO TOGETHER", DELIBERATELY.** Every other
	// protocol fills `destroyFunc` and `retainFunc` as a pair, and `instanceArgOwesDrop`'s header explains
	// why they must not be decided separately. This one fills the DESTROY word and leaves the RETAIN word 0
	// — which is sound only because the readers treat a zero retain as inert rather than as a promise to
	// call it, and is exactly why the arm lives HERE, in the single decision, instead of being a second
	// predicate bolted beside it. A promise that could be retained would be two owners of one thread, which
	// is the double reclaim `await`'s linearity exists to make unrepresentable.
	greenThread

	// ⭐⭐ **AN `Array` RECORD — RELEASED LIKE AN AGGREGATE, CO-OWNED THROUGH A RUNTIME TEST.** It is the
	// second representation in this language with an IMMORTAL member: a module-level managed constant
	// materializes as a `.rdata` buffer record (`Parser.emitManagedConstant`), and `__mm_retain` on
	// one is a refcount read-modify-write on a read-only page — the identical access violation the
	// `byteRecord` arm above exists to avoid. It cannot simply BE `byteRecord`: that arm's callees read a
	// String record's seventh slot and its release is `__str_decref`, where this record's is
	// `__managed_decref`. And it cannot be decided at the CALL SITE, because a witness word and a descriptor
	// word are read by a body that cannot name the type at all — which is why the fork is `__managed_retain`,
	// off the record's own `capacity@16`, exactly as `__str_retain` forks one representation over.
	//
	// ⚠ APPENDED, never inserted — the drop-side arms above are matched as the ordinal range
	// `byteRecord to greenThread`, and a case placed inside it would silently join a set that is about
	// something else.
	bufferRecord
	sharedValue
end 'ExistentialOwnershipProtocol'

// ⭐⭐ **THE ONE SPELLING OF "HOW DO I TAKE A REFERENCE UNDER THIS PROTOCOL".** Two runtime words
// are filled from it — a witness table's `retainFunc@16` (`existentialRetainCallee`) and a layout descriptor's
// `retainFunc@64` (`typeParamRetainCallee`) — and they are the same question asked of a conformer and of a
// type argument. Written twice, the pair's one genuinely surprising arm is what would drift: a `String`'s
// answer is a COPY and not an incref, because a literal's record is immortal `.rdata` and increfing one writes
// read-only memory (see `IrInterface.WitnessRetainFuncOffset`).
//
// `inert` is the complete answer for a protocol that owns nothing: both readers stamp nothing for
// it, and the zero word left behind is the encoding both runtime entries treat as inert.
function retainCalleeForProtocol(protocol ExistentialOwnershipProtocol) returns OwnershipCallee
	match protocol 'protocol'
		byteRecord then return OwnershipCallee.named(StrCloneName)
		aggregate or
		bufferRecord then return OwnershipCallee.named(ownershipDoorName(OwnershipDoor.boxRetain))
		sharedValue then return OwnershipCallee.named(SharedValueBoxRetainName)

		// A green thread is never co-owned — see the arm's own note.
		greenThread or
		none then return OwnershipCallee.inert
	end 'protocol'
end 'retainCalleeForProtocol'

// ⭐⭐ **THE CONCRETE `MaxonType` A SLOT HOLDING A `declared`-TYPED VALUE IS ACCESSED AS** — what a
// `loadIndirect`/`storeIndirect` carries, and the only type in the compiler that says how wide the access is.
// `Parser.fieldStorageType` is the parser-side door onto it and carries the rest of the argument; it is
// homed HERE, in `classifyUnionPayload`'s shape and for its stated reason, because the askers hold their
// layout ids in DIFFERENT interners and a name is the one currency all of them have.
//
// THREE kinds of slot ask it, and they are one question: a struct/union FIELD, a capturing closure's ENV
// SLOT, and a struct-literal BOX built by `__module_init`, whose asker has no `Parser` at all.
//
// It resolves a `named` alias through `signatures.aliasOf`, the SAME whole-program door THE SHIFT RULE asks
// (`valueIsUnsigned`), for the same reason: an alias declared in another file is still an alias here, and a
// single file's own table would answer for neither it nor a forward reference.
//
// ⚠ **IT IS THE SECOND STATEMENT OF "WHAT A `named` TYPE DENOTES", AND
// `TypeResolution.resolveNamedType` IS THE FIRST.** That is the standing shape of the two
// registries (see `SettledDeclarations.structLayouts`): the sweep answers the PARSER, the project
// registry answers the AUTHORITY, and the alias half is written in both places. What forces a
// slot's type to be resolved this early is the op: `resolveTypes` never rewrites an op's type, so
// whoever EMITS is the last tier that can make it concrete.
function slotStorageType(signatures ProgramSignatures, declared MaxonType, typeNames TypeNameInterner, readerFilePath FilePath) returns MaxonType
	match declared 'kind'
		// Already concrete: `maxonTypeToStdType` gives each its width without help. A struct, String,
		// Character, function or generic-instance field stores a pointer, a type-parameter field an
		// opaque i64, and a `cstring` slot the raw address.
		boolean or
		integer or
		float or
		exitCode or
		structRef or
		string or

		// `emitFieldLoad` functionizes a `named` function alias before this, so a function field arrives
		// here concrete.
		function or
		typeParameter or
		genericInstance or
		character or
		cstring then return declared
		unresolved then panic("slotStorageType: a slot is declared `unresolved` — a DECLARED slot type comes from `parseTypeReference`, which produces only `named`, `structRef` and the three primitive keywords, a word slot typed by a VALUE (a cell, a closure's env slot) answers a deferred value at `Parser.wordSlotStorageType` without asking here, and a global's type comes from a top-level initializer, which admits no call to an undeclared function")

		// ⭐ **AN INTERFACE-TYPED FIELD ACCESSES ITS VALUE HALF AS ONE MACHINE WORD**. The field occupies
		// TWO slots — `(value@+0, witness@+8)` — but a `loadIndirect`/`storeIndirect` moves ONE of them,
		// and `emitFieldLoad`/`emitFieldStore` emit two ops at the two offsets rather than one op of a
		// doubled width. So the width this answers is the word, exactly as a declared enum/union field's
		// is: `integer`, because `maxonTypeToStdType` panics on the declared `interfaceRef` the way it
		// panics on a `named`.
		//
		// ⚠ A CAPTURED interface binding — this function's other caller, a closure env slot — is still
		// refused by the capture path's own E2015, so no env slot reaches this arm.
		interfaceRef then return MaxonType.integer
		named then break
	end 'kind'

	let name = try typeNames.nameOf(typeNameIdOf(declared)) otherwise panic("slotStorageType: a slot's named type has an id that is not in the interner it was asked against — a field's type is adopted through `fieldTypeOf`, which re-interns into exactly that table, and a captured binding's was interned by its own file's `parseTypeReference`")

	match signatures.aliasOf(name, readerFilePath: readerFilePath) 'alias'
		declared(alias) then return alias.underlying
		undeclared then break
	end 'alias'

	// A declared enum/union field's width, through the accessor the UNION-PAYLOAD slot reads too
	// (`declaredAggregateSlotWidth`) — so the two slot kinds cannot come to store the SAME union at two
	// different widths, a divergence no diagnostic and no exit code can report. `TypeResolution.
	// resolveNamedType` is the third deriver; that accessor's header names it.
	// ⚠ `containsEnumFor` and not the bare probe: this function HOLDS a reader and spends it on `aliasOf`
	// above, so spending it here too is what stops a file that means neither declaration taking the enum's
	// WIDTH off another file's. The alias arm answering first is `aliasOf`'s kind gate, not an ordering.
	if signatures.containsEnumFor(name, readerFilePath: readerFilePath) 'enumOrUnion'
		return declaredAggregateSlotWidth()
	end 'enumOrUnion'

	// A name NO file declares, or a `type` the sweep recorded but whose reference the parser typed
	// `named` rather than `structRef` (a field declared with its own struct's name is `structRef` and
	// never reaches here). The first is a user error — E3011, which `TypeResolution` reports against
	// the merged registry, the authority — and it is not this routine's to report: the sweep is the
	// tolerant half. Returning `integer` keeps the op well-formed for the instant before the
	// pipeline's error gate throws, exactly as `resolveNamedType`'s own recovery does.
	return MaxonType.integer
end 'slotStorageType'

// Classify a union payload field's storage and ownership. `typeNames` resolves a `named` field's id to
// a NAME; pass the interner the LAYOUT's ids live in — the file-local artifact interner at the
// construct/extract sites, `project.typeNames` at the destructor-synthesis site. Every lookup
// below is keyed by that name, so they are interner-independent once the name is in hand.
//
// ⭐⭐ **A PAYLOAD IS A SLOT, AND WHAT ITS BARE `named` DENOTES IS ASKED THROUGH THE SLOT DOOR.**
// A cascade of its own here disagrees with the slot door exactly where the copy is
// thinner: `declaredSlotType` re-tags a function alias and a generic alias, and a copy that does not lets a
// `boxed(b PB)` payload fall through to `undeclaredName` — the construct stores the pointer without
// consuming the temporary (the box is freed at the end of the construct statement while the union keeps
// pointing at it), the cascade drops nothing, and reading the binding is `E3011 Unknown type 'PB'` on
// a program that must compile. See `denotedSlotType`, the one home of that
// resolution.
//
// `slotScopeFilePath` is the UNION's `declFilePath` — the file whose reading of a contested generic
// alias fixes this payload's identity, exactly as a struct field's is its own declaring file's. It is
// the same file `resolveRecordedGenericAliasTypes` settled the recorded payload column against, so
// the column and this classifier cannot come to mean two different declarations of one name.
function classifyUnionPayload(signatures ProgramSignatures, typeNames TypeNameInterner, fieldType MaxonType, slotScopeFilePath FilePath) returns PayloadClass
	match fieldType 'kind'
		boolean or
		integer or
		exitCode or

		// A `cstring` payload is a borrowed address: stored verbatim, moved out verbatim, and released
		// by nobody.
		cstring or
		float then return PayloadClass.scalar(fieldType)

		// A String / struct reference is a managed heap pointer — unless the named type packs inline into
		// a word, which owns no heap and moves as a scalar. A payload field of a struct's own name
		// resolves to `structRef` (`Self` and the enclosing type); a reference to ANOTHER struct arrives
		// as `named` and is resolved below.
		string or

		// ⚠ A Character payload is the same owned byte record a `string` payload is, so it takes
		// `isString: true`: `isString` selects the fused-record copy/drop protocol
		// (`promoteToOwnedString` in, `__str_decref` out), a question about the representation and not
		// the type. Answering `false` would take the aggregate path and co-own a record that has no
		// `__mm_retain` owner.
		character then return PayloadClass.managed(fieldType, isString: true)
		function then return PayloadClass.managed(fieldType, isString: false)
		structRef then return PayloadClass.scalar(fieldType) if signatures.nameIsInlineRecord(foreignNameOf(typeNames, id: typeNameIdOf(fieldType))) else PayloadClass.managed(fieldType, isString: false)
		unresolved then panic("classifyUnionPayload: a payload field is declared `unresolved` — `parseTypeReference` produces only `named`, `structRef` and the three primitive keywords, so no payload declaration can carry one")

		// ⭐ A TYPE-PARAMETER slot is its own class (`PayloadClass.typeParam`) — one opaque machine word in the
		// DECLARATION view, dropped by nothing there (the per-INSTANCE cascade drops the substituted field
		// instead), which is what keeps `type Box uses T`'s own destructor the trivial `__mm_decref`. What it is
		// NOT is a scalar: a MANAGED instantiation makes the concrete record the slot's owner, so a store into
		// it takes a reference through the descriptor at run time. See `PayloadClass.typeParam`, whose header
		// carries the double free the `scalar` classification was.
		typeParameter then return PayloadClass.typeParam(fieldType)

		// A generic-INSTANCE payload is an OWNED base-struct box, exactly like a `structRef`
		// payload: construct MOVES it in, a match binds it out, the cascade drops it through its own
		// `__destruct_<instance>` / `__mm_decref` (`managedFieldDropCallee` routes the `genericInstance`
		// tag). Its storage is the `genericInstance` type itself, which `maxonTypeToStdType` gives an i64
		// (a pointer), so `payloadStorageOf`/`payloadValueTypeOf` lower it like any managed pointer.
		//
		// ⚠ **EXCEPT A `Promise` INSTANCE, WHICH IS A SCALAR** — a green-thread handle owning no
		// heap record. It MUST agree with `typeIsManaged`'s instance arm: these are the two SEPARATE
		// implementations of "does this own heap?" that `Parser.requireContainerElementType`'s header warns
		// about, and a slot they classify differently is moved in by one protocol and dropped by the other.
		genericInstance then return promiseOrManagedInstanceClass(signatures, typeNames: typeNames, fieldType: fieldType)

		// ⭐ A STRUCT FIELD at an interface type is the two-slot fat pointer — see
		// `PayloadClass.existential`. A UNION PAYLOAD at one is still refused at the declaration
		// (`Parser.requireStorableDeclaredType`), because a payload slot IS one machine word — the case list
		// shares one slot region across every case, so a two-slot payload has nowhere to widen into — and this
		// classifier serves both, so the refusal lives at the declaration rather than here.
		interfaceRef then return PayloadClass.existential
		named then break
	end 'kind'

	let name = try typeNames.nameOf(typeNameIdOf(fieldType)) otherwise panic("classifyUnionPayload: a payload field's named type id is not in the interner it was resolved against — pass the interner the layout's ids live in")

	// ⭐⭐ **THE SHARED CASCADE, and it answers every payload whose name denotes a DIFFERENT type** — a
	// STRUCT (a managed heap pointer, re-tagged `structRef` because `maxonTypeToStdType` panics on a
	// `named` and a struct binding's field access requires the tag), a TUPLE alias (the tuple's own
	// `structRef` — `Pair` is a registered nothing, and unresolved it is `E3011 Unknown type 'Pair'`
	// on a program the other walk order runs), a GENERIC alias (the instance), a FUNCTION alias (a
	// function value), and a ranged FLOAT alias (a genuine f64). Re-entered rather than re-classified
	// by hand: `denotedSlotType` never answers with a `named`, so the recursion is exactly one deep
	// and the tag→class mapping above stays the only one there is.
	//
	// ⚠ **AND THAT TERMINATION FACT IS ASSERTED, NOT MERELY WRITTEN DOWN.** It holds by construction —
	// every arm of that door answers `function`, `genericInstance`, `structRef` or `float`, and each
	// is a RETURNING arm of the `match` above — but it is a property of the OTHER function's arms, and
	// that door serves `declaredSlotType` too. An arm added for that caller which answered with the
	// bare `named` it was handed (the int-alias shape its own header describes) would make this an
	// UNBOUNDED recursion: a compiler that hangs, with nothing naming the edit that did it. A `named`
	// here is loud instead — the same rule `resolveRecordedGenericAliasTypes` states for a spelling
	// its pass cannot reach.
	if let denoted = try signatures.denotedSlotType(name, into: typeNames, slotScopeFilePath: slotScopeFilePath) 'theNameDenotesAnotherType'
		if maxonTypeTag(denoted) == ValueTypeTag.named 'wouldNotTerminate'
			panic("classifyUnionPayload: `denotedSlotType('{String.from(name)}')` answered with a `named`, which this re-entry cannot make progress on — every arm of that door must answer with a type the tag match above RETURNS on")
		end 'wouldNotTerminate'

		return classifyUnionPayload(signatures, typeNames: typeNames, fieldType: denoted, slotScopeFilePath: slotScopeFilePath)
	end 'theNameDenotesAnotherType'

	// A ranged INT alias is a scalar of its underlying width. It is asked HERE and not in the shared door
	// because it is a different question: that door answers "what type does this name denote", and an int
	// alias's answer is the bare `named` it already is (its NAME carries the range) — what a PAYLOAD needs
	// on top is the STORAGE primitive the slot occupies, which only this side wants. A float-underlying
	// alias cannot reach this line; the door re-tagged it `float` and the `float` arm above took it.
	if let underlying = try signatures.aliasUnderlyingFor(name, readerFilePath: slotScopeFilePath) 'rangedIntAlias'
		return PayloadClass.scalar(underlying)
	end 'rangedIntAlias'

	// A payload-FREE enum's value is an i64 tag — a scalar; a BOXED union is a managed heap pointer
	// (its box carries the field's `named(<union>)` id, which `enumPayloadClass` reads off `fieldType`).
	// Also asked here rather than in the shared door, and for the same reason: an enum name denotes no
	// other type — a `named` IS what both forms are stored as — so there is nothing for that door to
	// re-tag, and only the CLASS differs between them. An undeclared name is a user error TypeResolution
	// reports as E3011; the caller keeps the op well-formed until the pipeline's error gate throws.
	match signatures.enumInAnyFile(name) 'asEnum'
		declared(enumLayout) then return enumPayloadClass(enumLayout, fieldType: fieldType)
		undeclared then return PayloadClass.undeclaredName
	end 'asEnum'
end 'classifyUnionPayload'

// The class of a generic-INSTANCE slot: an owned base-struct box, or the one instance that is a bare
// green-thread handle. Split out because the arm above sits in a `match` and the question needs
// a labelled `if`; it reads `typeIsManaged` rather than re-asking `instanceIsPromiseHandle`, so the two
// classifiers this file exports cannot come to disagree about which instances own heap.
function promiseOrManagedInstanceClass(signatures ProgramSignatures, typeNames TypeNameInterner, fieldType MaxonType) returns PayloadClass
	if signatures.typeIsManaged(fieldType, from: typeNames) 'aBox'
		return PayloadClass.managed(fieldType, isString: false)
	end 'aBox'

	// ⛔ **A PROMISE IS ITS OWN CLASS, AND FALLING THROUGH TO `scalar` COSTS AN EXIT 92** — see that arm for
	// the measurement. Asked of the TYPE through the shared resolver, so an `IntPromise` alias is recognised as
	// readily as a bare `Promise with Integer` instance.
	if signatures.typeIsAGreenThreadHandle(fieldType, from: typeNames) 'aGreenThread'
		return PayloadClass.greenThread(fieldType)
	end 'aGreenThread'

	return PayloadClass.scalar(fieldType)
end 'promiseOrManagedInstanceClass'

// A payload whose type is another enum/union: a payload-FREE enum is a scalar (its value is its i64
// tag, stored inline); a payload-bearing union is MANAGED, a heap pointer or a tagged word,
// carrying the field's own `named(<union>)` type (`fieldType`) — the value tag its
// move-in/move-out/drop all read.
function enumPayloadClass(enumLayout EnumLayout, fieldType MaxonType) returns PayloadClass
	if enumLayout.carriesPayloads() 'boxed'
		return PayloadClass.nestedUnion(fieldType)
	end 'boxed'

	return PayloadClass.scalar(MaxonType.integer)
end 'enumPayloadClass'

// ⭐ **THE ONE LOOP THREE QUESTIONS SHARE.** Does any case carry a payload that needs a DROP? Keeping it ONE
// function, not one copy per site, is what makes the destructor's dropped set, the construct's moved set and
// the union destructor's declared runtime needs agree on what "managed" means by construction.
//
// ⚠ **IT TAKES NO `wantStringOnly` FLAG, BECAUSE SUCH A FLAG IS A CASCADE-NEEDS DEFECT WEARING A
// PARAMETER'S CLOTHES.** Its `true` answer is "does this union's destructor call `__str_decref`?" —
// a question about `String` and about nothing else, so a payload of any OTHER managed type with its own
// install bit declares no bit at all and links against a runtime nothing installed (MEASURED:
// `resolveCallFixups: call to unknown function '__cs_decref'`). The caller derives its
// bits from the drop CALLEE instead (`MmRuntime.declareUnionPayloadDropNeeds`), which cannot have a
// favourite type.
function unionHasManagedField(signatures ProgramSignatures, typeNames TypeNameInterner, layout EnumLayout) returns bool
	for ci in 0 upto layout.caseCount() 'eachCase'
		if caseHasManagedField(signatures, typeNames: typeNames, layout: layout, ci: ci) 'found'
			return true
		end 'found'
	end 'eachCase'

	return false
end 'unionHasManagedField'

// The per-CASE half — the destructor's tag switch emits a drop block only for a case this answers true
// for, so the switch and the union-wide gate above read the exact same classification.
function caseHasManagedField(signatures ProgramSignatures, typeNames TypeNameInterner, layout EnumLayout, ci CaseIndex) returns bool
	let payloads = layout.payloadsAt(ci)

	for fi in 0 upto payloads.count() 'eachField'
		let field = try payloads.get(fi) otherwise panic("caseHasManagedField: payloadsAt count disagrees with get at {fi}")
		let class = classifyUnionPayload(signatures, typeNames: typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)

		// The DESTRUCTOR's own gate, so it asks the ownership question — a promise payload is not a box and
		// still owes a reclaim. See `PayloadClass.greenThread`.
		if payloadClassOwesDrop(class) 'found'
			return true
		end 'found'
	end 'eachField'

	return false
end 'caseHasManagedField'

typealias UnboxedWordAnswerMap = Map with (TypeNameId, bool)

type UnboxedWordMemo
	var answers as UnboxedWordAnswerMap

	static function create() returns Self
		return Self{answers: UnboxedWordAnswerMap.create()}
	end 'create'

	function nameIdIsAWord(signatures ProgramSignatures, typeNames TypeNameInterner, nameId TypeNameId, readerFilePath FilePath) returns bool
		let name = try typeNames.nameOf(nameId) otherwise return false

		if signatures.crossKindContested(name) 'readerDecides'
			return signatures.unionNameIsUnboxedFor(name, readerFilePath: readerFilePath)
		end 'readerDecides'

		if self.answers.contains(nameId) 'asked'
			return try self.answers.get(nameId) otherwise panic("UnboxedWordMemo.nameIdIsAWord: name {nameId} left the memo after `contains`")
		end 'asked'

		let unboxed = signatures.unionNameIsUnboxedFor(name, readerFilePath: readerFilePath)
		self.answers.upsert(nameId, value: unboxed)

		return unboxed
	end 'nameIdIsAWord'
end 'UnboxedWordMemo'

enum UnboxedPayloadShape
	leafBox
	recordBytes
	recordElements
	fieldRecord
end 'UnboxedPayloadShape'

function unboxedPayloadStorageOf(signatures ProgramSignatures, typeNames TypeNameInterner, layout EnumLayout, field PayloadField) returns MaxonType throws AbsentError
	match classifyUnionPayload(signatures, typeNames: typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath) 'class'
		managed(held, _) then return held
		scalar or
		nestedUnion or
		undeclaredName or
		existential or
		typeParam or
		greenThread then throw AbsentError.absent
	end 'class'
end 'unboxedPayloadStorageOf'

function unboxedPayloadShapeOf(signatures ProgramSignatures, typeNames TypeNameInterner, layout EnumLayout, field PayloadField) returns UnboxedPayloadShape throws AbsentError
	let storage = try unboxedPayloadStorageOf(signatures, typeNames: typeNames, layout: layout, field: field)

	match managedFieldCascadeStrategy(signatures, typeNames: typeNames, fieldType: storage, asElement: false, action: CascadeAction.shareWalk) 'strategy'
		direct(callee) then return try unboxedPayloadShapeOfEntry(callee, storage: storage)
		managedElements(container, _) then return try unboxedPayloadShapeOfContainer(container)
		throughWitness or
		unsupported then throw AbsentError.absent
	end 'strategy'
end 'unboxedPayloadShapeOf'

function unboxedPayloadShapeOfContainer(container ByteArray) returns UnboxedPayloadShape throws AbsentError
	if not container.equals(ManagedShareManagedName) 'notAManagedRecord'
		throw AbsentError.absent
	end 'notAManagedRecord'

	return UnboxedPayloadShape.recordElements
end 'unboxedPayloadShapeOfContainer'

function unboxedPayloadShapeOfEntry(callee ByteArray, storage MaxonType) returns UnboxedPayloadShape throws AbsentError
	if callee.equals(ManagedShareName) 'aRecord'
		return UnboxedPayloadShape.recordBytes
	end 'aRecord'

	if callee.equals(MmShareBoxName) 'aLeaf'
		return UnboxedPayloadShape.leafBox
	end 'aLeaf'

	let tag = maxonTypeTag(storage)

	if bytesStartWith(callee, prefix: ShareWalkPrefix) and (tag == ValueTypeTag.structRef or tag == ValueTypeTag.genericInstance) 'aFieldRecord'
		return UnboxedPayloadShape.fieldRecord
	end 'aFieldRecord'

	throw AbsentError.absent
end 'unboxedPayloadShapeOfEntry'

// Derived on every ask and never stored on the layout: eligibility depends on how each payload type
// classifies, which varies with the reader's file and the signatures, so a stored answer would go
// stale.
function unionRepresentationOf(signatures ProgramSignatures, typeNames TypeNameInterner, layout EnumLayout) returns UnionRepresentation
	let payloadCases = layout.payloadCasesBefore(layout.caseCount())

	if payloadCases == 0 'noPayloads'
		return UnionRepresentation.bareTag
	end 'noPayloads'

	if unionIsUnboxed(signatures, typeNames: typeNames, layout: layout, payloadCases: payloadCases) 'aWord'
		return UnionRepresentation.word
	end 'aWord'

	return UnionRepresentation.box
end 'unionRepresentationOf'

// A word needs at most `UnboxedMaxPayloadCases` payload cases (their keys fit the tag mask, with 0
// left for the empty word), at most `UnboxedMaxKey` cases in all, no `implements`, in its header or in an
// `extension` (a conformer, every error union included, stays a box), a union the
// author wrote, and per case no payload or one managed record payload that `unboxedPayloadShapeOf`
// can walk.
function unionIsUnboxed(signatures ProgramSignatures, typeNames TypeNameInterner, layout EnumLayout, payloadCases CaseIndex) returns bool
	if signatures.declaresAnyInterface(layout.name) or payloadCases > UnboxedMaxPayloadCases or (layout.caseCount() as FullRangeInt) > UnboxedMaxKey or not layout.tagsAreDeclarationIndices() 'notEligible'
		return false
	end 'notEligible'

	if layout.isSynthesized 'synthesized'
		return false
	end 'synthesized'

	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)

		if payloads.count() > 1 'tooWide'
			return false
		end 'tooWide'

		for field in payloads 'eachPayload'
			_ = try unboxedPayloadShapeOf(signatures, typeNames: typeNames, layout: layout, field: field) otherwise return false
		end 'eachPayload'
	end 'eachCase'

	return true
end 'unionIsUnboxed'

// Is a classified payload a managed (String/struct) one — the single reader of "does this class own a
// heap drop?", so every site testing it (the predicate above, the destructor synthesis, the usage scan)
// agrees.
function payloadClassIsManaged(class PayloadClass) returns bool
	return match class 'c'
		managed or
		nestedUnion or

		// An existential owns its conformer's record — see `PayloadClass.existential` and
		// `typeIsManaged`.
		existential gives true
		scalar or
		undeclaredName or

		// ⚠ `false` is the declaration view's answer rather than the slot's. Every reader here is a
		// declaration-view drop question — the base struct's own cascade, the usage gates,
		// `caseHasManagedField` — and a `T` slot is dropped by none of them:
		// `genericInstanceFieldOwesDrop` answers the substituted question for the per-instance cascade
		// that does drop it. Answering `true` would give `type Box uses T` a `__destruct_Box` that
		// decrefs an opaque word, which for a trivial instantiation is a raw scalar. The store-side
		// reference the slot does owe is taken by `Parser.moveInPayload`, which routes on this case by
		// name and not through this predicate.
		typeParam or

		// "Managed" here licenses a retain and a clone, and a green thread has neither. What it does owe
		// is a drop, which is `payloadClassOwesDrop` below.
		greenThread gives false
	end 'c'
end 'payloadClassIsManaged'

// ⭐ **DOES THIS PAYLOAD OWE A RECLAIM?** The union twin of `typeOwesDrop`, and the question a
// destructor cascade must ask — `payloadClassIsManaged` is the narrower "is it a box". A promise
// payload answers `false` there and `true` here, and reading the first as the second constructs
// `union Slot { held(p IntPromise) }` without moving the spawn in, and drops the union without
// dropping it.
function payloadClassOwesDrop(class PayloadClass) returns bool
	return payloadClassIsManaged(class) or payloadClassIsAGreenThread(class)
end 'payloadClassOwesDrop'

function payloadClassIsAGreenThread(class PayloadClass) returns bool
	return match class 'c'
		greenThread gives true
		managed or
		scalar or
		nestedUnion or
		existential or
		undeclaredName or
		typeParam gives false
	end 'c'
end 'payloadClassIsAGreenThread'

// Is a classified slot an EXISTENTIAL — the two-slot fat pointer, whose admitted values and whose
// DROP both differ from every other managed kind? Its reader is the field-type door
// (`Parser.requireFieldType`); it is a `match` like its two siblings rather than an `is` test so
// that a case appended to `PayloadClass` fails to compile here.
function payloadClassIsExistential(class PayloadClass) returns bool
	return match class 'c'
		existential gives true
		managed or
		nestedUnion or
		scalar or
		undeclaredName or
		typeParam or
		greenThread gives false
	end 'c'
end 'payloadClassIsExistential'

// Is a classified slot the enclosing generic's own TYPE PARAMETER — one opaque machine word whose
// reference protocol is a run-time fact? Its reader is the store door (`Parser.moveInPayload`) and nothing
// else: every OTHER question about the slot (its width, a loaded value's type, whether the DECLARATION view
// drops it) is answered identically to a scalar's, which is why those readers stay unaware of the case. A
// `match` like its siblings so a case appended to `PayloadClass` fails to compile here.
function payloadClassIsTypeParam(class PayloadClass) returns bool
	return match class 'c'
		typeParam gives true
		existential or
		managed or
		nestedUnion or
		scalar or
		undeclaredName or
		greenThread gives false
	end 'c'
end 'payloadClassIsTypeParam'

// Is a classified payload a STRING (drops through `__str_decref`) rather than a struct (`__mm_decref`)?
// The single reader of "which managed drop?", so the destructor synthesis and the usesStrDecref gate route
// the same way.
function payloadClassIsString(class PayloadClass) returns bool
	return match class 'c'
		managed(_, isString) gives isString
		scalar or
		nestedUnion or

		// ⚠ An existential's value half is a conformer's record, which may or may not be a String — the
		// fact only its witness knows, and the reason its drop is `__drop_existential` and its
		// co-ownership `__retain_existential`. `false` does not mean "the aggregate protocol applies":
		// for a byte-record conformer the protocol is copy, never co-own
		// (`ExistentialOwnershipProtocol`), since co-owning is an incref of read-only `.rdata` for a
		// literal. `false` means only "do not take the static String route", because the choice belongs
		// to the witness at run time.
		existential or
		undeclaredName or

		// An opaque `T` may be a String at some instantiation, which the shared body cannot know, so its
		// store dispatches through the descriptor's `retainFunc@64`: `false` means the same as for an
		// existential.
		typeParam or
		greenThread gives false
	end 'c'
end 'payloadClassIsString'

// ⭐⭐ **THE SLOT'S OWN WIDTH — the type a `loadIndirect`/`storeIndirect` through this slot
// CARRIES**, and nothing else. **THE ONE HOME of the width-vs-identity split**:
// `payloadValueTypeOf` answers the other half and points here rather than restating it, and so does
// `PayloadClass.nestedUnion`.
//
// ⛔ **THE WIDTH IS NOT THE IDENTITY, AND FOR MOST CLASSES IT IS NOT EVEN THE SAME TYPE.** Only `managed`
// (whose `storage` is already a concrete machine-word tag — `structRef`/`string`/`genericInstance`/
// `character`) and `typeParam` (one opaque word, whose declared type IS that word) answer identically at both
// doors. Every OTHER class answers a width here that is not what a value filling the slot must BE:
//
//   • `scalar` — a ranged alias classifies as `scalar(<underlying primitive>)`, so the width is the bare
//     `integer` while the IDENTITY keeps the alias NAME, which is what lets the shift rule read its low bound.
//     Ask this door the identity question and a `Byte` silently becomes an `int`.
//   • `existential` — the slot is a TWO-word fat pointer and a `storeIndirect` moves ONE word, so the width is
//     that word; the identity is the declared `interfaceRef` every witness-dispatching reader needs. The
//     witness half rides at `+InterfaceWitnessHalfOffset`, stored beside it by `Parser.emitFieldStore`, the
//     only site holding the field's base offset.
//   • `nestedUnion` — a boxed union IS a pointer, so the width is the word; the identity is the
//     union's own `named(<union>)`. ⚠ **The one class where handing the identity to an op does not
//     merely lose information but PANICS** (`maxonTypeToStdType` has no `named` arm) — so deriving
//     the width from the union's name makes a nested boxed-union payload unlowerable.
//   • `undeclaredName` — an error path: the width keeps the op well-formed for the instant before the
//     pipeline's error gate throws, while the identity stays the name the user wrote, for the diagnostic.
//
// ⇒ the three one-word answers below are different reasons that happen to share an answer.
//
// ⚠ **"A DECLARED ENUM/UNION OCCUPIES ONE MACHINE WORD" HAS TWO DERIVERS, AND THEY SHARE A HOME** —
// `declaredAggregateSlotWidth` below. Both are in these two files (`Parser.fieldStorageType`'s `containsEnum`
// arm, the STRUCT-FIELD slot, and the `nestedUnion` arm below, the UNION-PAYLOAD slot); *"a single home would
// have to sit where all three can reach it"* is a false dichotomy, because a third party out of reach never
// argues against unifying the two that are.
//
// That third party is `TypeResolution.resolveNamedType`, which erases a declared enum/union to `integer`.
// **What one accessor buys is that a struct field and a payload slot storing the SAME union at two different
// widths — reportable by no diagnostic and no exit code — is unrepresentable**, because there is one
// expression to change. Only the two-party agreement with `resolveNamedType` rests on prose.
// ⭐⭐ **THE WIDTH A SLOT HOLDING A DECLARED ENUM OR UNION IS ACCESSED AT — one machine word, stated ONCE.**
// A payload-FREE enum's value IS its i64 tag; a payload-bearing union's value is an i64 POINTER to its box
// — two different representations, one access width, and that coincidence is why the two slot
// kinds could drift apart while each looked right on its own.
//
// Its two callers are the two slot kinds: `Parser.fieldStorageType`'s `containsEnum` arm (a struct FIELD) and
// `payloadStorageOf`'s `nestedUnion` arm (a union PAYLOAD). See the ⚠ above for the third deriver that is out
// of reach and for what having one home for these two buys.
//
// ⚠ **IT IS A WIDTH AND NEVER AN IDENTITY.** `payloadValueTypeOf` answers the other half; handing this answer
// to a reader that needed the identity loses the union's NAME, and handing the identity to an op PANICS
// (`maxonTypeToStdType` has no `named` arm).
function declaredAggregateSlotWidth() returns MaxonType
	return MaxonType.integer
end 'declaredAggregateSlotWidth'

function payloadStorageOf(class PayloadClass) returns MaxonType
	match class 'c'
		scalar(storage) then return storage
		managed(storage, _) then return storage

		// The opaque word itself, the same width for every instantiation.
		typeParam(storage) then return storage
		greenThread(storage) then return storage

		// One machine word — the box POINTER. Not the `named(<union>)` the case carries: that is the slot's
		// IDENTITY, and it panics the lowering. See the ⛔ above. Through the shared accessor, so this width and
		// the STRUCT-FIELD one cannot come apart.
		nestedUnion then return declaredAggregateSlotWidth()

		// The value half's word, one of the fat pointer's two, and an error path's placeholder width. See
		// the ⛔ above.
		existential or
		undeclaredName then return MaxonType.integer
	end 'c'
end 'payloadStorageOf'

// ⭐ **THE MaxonType THE SLOT'S VALUE IS TAGGED WITH — read in BOTH directions**: what a LOADED payload
// reads back as, and what a value STORED into the slot must already be (`Parser.requireFieldType`,
// `requireContainerElementType`; `requirePayloadArgType` asks the same question but is itself a `match` over
// this union, so it reads the case's own field rather than calling in). It is one question — the slot's
// value IDENTITY — and asking it once is what keeps a slot from admitting a type it cannot hand back.
//
// A managed payload's concrete storage (so a struct binding reads as `structRef` — required by
// `requireStructBase` — and a String as `string`); a boxed-union payload's `named(<union>)` (so a moved-out
// load is recognized as a boxed union by `enumMatchFor`/`decrefCalleeFor`, and so a store into one is
// refused a DIFFERENT union — `requireSlotAggregateIdentity` compares that name); a scalar's DECLARED type
// (so a ranged alias's low bound stays readable by the shift rule, exactly as `emitFieldLoad` keeps a
// scalar field's alias).
//
// ⛔ **THIS IS NOT THE SLOT'S WIDTH, AND FOR EVERY CLASS BUT `managed`/`typeParam` IT IS NOT EVEN THE SAME
// TYPE** — `payloadStorageOf` is the one home of that split and states it arm by arm. Handing a `scalar`'s
// answer to an op loses a ranged alias's bound; handing a `nestedUnion`'s PANICS the lowering.
function payloadValueTypeOf(class PayloadClass, declared MaxonType) returns MaxonType
	match class 'c'
		scalar or

		// The declared `interfaceRef`, so a loaded existential is recognised as one by every reader that
		// dispatches on the tag (`witnessOfValue`'s pairing, the argument widening, the drop router).
		existential or
		undeclaredName or

		// A loaded `T` must read back as the opaque `typeParameter` its slot is declared at, which is
		// what the caller's `typeResultThroughInstance` substitutes and what `decrefCalleeFor` routes to
		// `__drop_type_param` on.
		typeParam then return declared
		managed(storage, _) then return storage
		nestedUnion(storage) then return storage
		greenThread(storage) then return storage
	end 'c'
end 'payloadValueTypeOf'

type ImageScalarSlot
	export let offset as ByteOffset
	export let storageType as MaxonType
	export let payload as FullRangeInt

	static function create(offset ByteOffset, storageType MaxonType, payload FullRangeInt) returns ImageScalarSlot
		return Self{offset: offset, storageType: storageType, payload: payload}
	end 'create'
end 'ImageScalarSlot'

typealias ImageScalarSlotArray = Array with ImageScalarSlot

function structBoxImageBytes(sizeBytes ByteOffset, fields ImageScalarSlotArray) returns immutable ByteArray
	let image = ByteArray.create(sizeBytes) as isolated ByteArray

	for field in fields 'eachSlot'
		writeImageSlot(image, offset: field.offset, value: field.payload, byteCount: stdTypeStorageBytes(maxonTypeToStdType(field.storageType)))
	end 'eachSlot'

	return freeze image
end 'structBoxImageBytes'

// ⭐⭐ **WHAT AN IMAGED BOX CONTRIBUTES TO ITS READERS' KEY IS THE TREE ITSELF** — the very arena the read
// emits (`Parser.emitImageBoxRead`), walked from the root the value stands at, so a key and the bytes it
// stands for cannot come to describe two records. Nodes the walk left orphaned contribute nothing, exactly
// as they reach no `.rdata` object.
//
// ⛔ **`below` IS THE SAME BOUND `LowerMaxonToStd.ensureImmortalBoxNode` HOLDS, CHECKED THE SAME WAY.** The
// two walk one arena, and a walk that trusted the bound its twin asserts would meet a broken arena as a
// stack overflow here and a named panic there.
function mixImageBoxTree(state HashDigest, nodes ImmortalBoxNodeArray, root ElementIndex, below ElementIndex) returns HashDigest
	if root >= below 'notBelowItsNamer'
		panic("mixImageBoxTree: node {root} is named from a slot that may only reach below {below}, in a {nodes.count()}-entry arena — the tree is built bottom-up, so a forward reference is a box that contains itself")
	end 'notBelowItsNamer'

	let node = try nodes.get(root) otherwise panic("mixImageBoxTree: node id {root} is outside a {nodes.count()}-entry arena — the walk that built it answers with a root it appended")
	var mixed = Hasher.combined(mixBytes(state, bytes: node.bytes), value: node.columns.count() as HashDigest)

	for column in node.columns 'eachSlot'
		mixed = mixImageBoxSlot(Hasher.combined(mixed, value: column.offset as HashDigest), nodes: nodes, below: root, value: column.value)
	end 'eachSlot'

	return mixed
end 'mixImageBoxTree'

// One slot's own contribution. A COLUMN is the two facts that identify its record; a nested BOX is that
// whole subtree, recursed through the door above under the bound that door enforces.
function mixImageBoxSlot(state HashDigest, nodes ImmortalBoxNodeArray, below ElementIndex, value ImmortalBoxSlotValue) returns HashDigest
	return match value 'slot'
		emptyArray(elementSize, elementDestroy) gives mixOwnershipCallee(Hasher.combined(Hasher.combined(state, value: SignatureDiscriminator.imageBoxSlotShapeEmptyArray), value: elementSize as HashDigest), callee: elementDestroy)
		box(child) gives mixImageBoxTree(Hasher.combined(state, value: SignatureDiscriminator.imageBoxSlotShapeNestedBox), nodes: nodes, root: child, below: below)
	end 'slot'
end 'mixImageBoxSlot'

function mixOwnershipCallee(state HashDigest, callee OwnershipCallee) returns HashDigest
	return match callee 'callee'
		inert gives mixBytes(state, bytes: EmptySourceText)
		named(name) gives mixBytes(state, bytes: name)
	end 'callee'
end 'mixOwnershipCallee'

// One slot, at the width the STORE would move. Narrow deliberately: a `bool` field is a byte and a negative
// value in a narrow slot must not sign-extend across its neighbours.
function writeImageSlot(image ByteArray, offset ByteOffset, value FullRangeInt, byteCount BytePos)
	var at = offset

	for b in scalarImage(value, byteCount: byteCount) 'eachByte'
		try image.set(at, value: b) otherwise panic("writeImageSlot: a {byteCount}-byte slot at offset {offset} runs past a {image.count()}-byte box — a caller reads the size and the offsets off ONE declaration's layout (a `StructLayout` for a struct, an `EnumLayout` for a union case), so a slot past the end means two were mixed")
		at = at + 1
	end 'eachByte'
end 'writeImageSlot'

function maxonTypeName(t MaxonType, typeNames TypeNameInterner) returns String
	let tag = maxonTypeTag(t)

	// ⭐ **AN EXISTENTIAL RENDERS AS ITS INTERFACE'S NAME, AND THAT MAKES THE RENDERING ORDER-INDEPENDENT.**
	// `parseTypeReference` mints `interfaceRef` only once the interface registry is whole (`allFilesFolded`),
	// so the SAME annotation is a `named` during the declaration sweep and an `interfaceRef` in the real
	// parse. Both spell the same interned name here, which is what keeps a rendered interface REQUIREMENT
	// (`Parser.renderInterfaceTypeName` → `renderDeclaredTypeName` → here) identical whichever pass produced
	// it — and conformance is decided by comparing two of those strings.
