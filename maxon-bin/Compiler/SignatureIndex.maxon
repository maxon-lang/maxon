// and the three answers are decided from two facts the sweep holds outright, with nothing resolved:
// whether the declaration sits inside a `type`/`extension` body, and whether its file has a directory
// namespace.
export union DeclCallability
	// A free function at the compile ANCHOR. Only a BARE call can name it: it has no qualified spelling
	// (`namespaceQualifiedName` panics if asked for one), so no dotted call anywhere can reach it. This is
	// the arm that stops a user program's free `swap` from marking `stdlib`'s `Array.swap`.
	bareCallOnly

	// A free function in a NON-ROOT directory: a bare call, or the directory route `utils.f(…)`.
	bareCallOrDirectoryRoute

	// A method of `typeName`: a bare call (implicit `self` reaches a sibling — MEASURED), any
	// receiver-qualified call, and a `self.`/`Self.`-qualified call inside `typeName`'s own body.
	methodOf(typeName immutable ByteArray)
end 'DeclCallability'

// @generated library-cache begin
function cacheWriteDeclCallability(writer LibraryCacheWriter, value DeclCallability)
