		return String.from(try typeNames.nameOf(typeNameIdOf(t)) otherwise panic("maxonTypeName: type-name id {typeNameIdOf(t)} is not in the interner — pass the interner the type's ids live in"))
	end 'namedType'

	return typeTagName(tag)
end 'maxonTypeName'

// How a type is spelled for a reader — `maxonTypeName` for every tag whose name the interner holds, and the
// whole-program instance name for the one it does not. A `genericInstance` has no interned name and falls
// through `maxonTypeName` to the bare tag word `struct`, so every instance of every base renders alike and a
// refusal between two instantiations reads `expected 'fn(int) returns struct', got 'fn(int) returns struct'`.
//
// ⚠ `instanceDisplayName`, never a value's brand, and the string's second job is why.
// `formatFnTypeDisplay`'s output is a comparison key as well as a caption (see there), so it must be a pure
// function of the type: a brand-scoped spelling would let one function type render two ways at two sites and
// make a merge disagree about a type it agrees about. The site-free door is exactly that pure function of the
// gid — and it is still the author's `typealias`, which is what a caption owes. For the same reason a
// compiler mint reaching a slot here is not stripped to its source spelling: two mints of one contested name
// would render alike, and a comparison this string decides would call two different function types equal.
function maxonTypeDisplayName(t MaxonType, typeNames TypeNameInterner, signatures ProgramSignatures) returns String
	if maxonTypeTag(t) == ValueTypeTag.genericInstance 'anInstantiationOfAGenericBase'
		return String.from(signatures.instanceDisplayName(genericInstanceIdOf(t)))
	end 'anInstantiationOfAGenericBase'

	if maxonTypeTag(t) == ValueTypeTag.named 'aNameThatMayBeAMint'
		return signatures.aliasIdentityDisplay(freeze maxonTypeName(t, typeNames: typeNames).toByteArray())
	end 'aNameThatMayBeAMint'

	if maxonTypeTag(t) == ValueTypeTag.structRef and isTupleTypeName(freeze maxonTypeName(t, typeNames: typeNames).toByteArray()) 'aTuple'
		return signatures.displayNameOfAggregate(ValueTypeTag.structRef, aggregate: freeze maxonTypeName(t, typeNames: typeNames).toByteArray())
	end 'aTuple'

	return maxonTypeName(t, typeNames: typeNames)
end 'maxonTypeDisplayName'

// Render a function type as `fn(P1, P2, …) returns R` from its parameter and return types. A void
// return carries no `returns` clause. The canonical signature STRING the merge check compares by name:
// two functions agree iff this string is equal.
function formatFnTypeDisplay(paramTypes MaxonTypeArray, returnType MaxonReturnType, byRefParams ParamPositionMask, typeNames TypeNameInterner, signatures ProgramSignatures) returns String
	var rendered = "fn("

	for i in 0 upto paramTypes.count() 'eachParam'
		if i > 0 'separator'
			rendered = "{rendered}, "
		end 'separator'

		let marker = "mutable " if maskHasParam(byRefParams, param: i as ParamCount) else ""
		rendered = "{rendered}{marker}{maxonTypeDisplayName(try paramTypes.get(i) otherwise panic("formatFnTypeDisplay: paramTypes.get OOB at {i}"), typeNames: typeNames, signatures: signatures)}"
	end 'eachParam'

	rendered = "{rendered})"

	match returnType 'return'
		value(returnValue) then rendered = "{rendered} returns {maxonTypeDisplayName(returnValue, typeNames: typeNames, signatures: signatures)}"
		void then break
	end 'return'

	return rendered
end 'formatFnTypeDisplay'

