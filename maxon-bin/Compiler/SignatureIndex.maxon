end 'declRunsProgramCode'

function nameRosterOf(name immutable ByteArray) returns NameRoster
	let roster = NameRoster.create(1, zeroed: false)
	roster.push(name)
	return roster
end 'nameRosterOf'

function declIsAPayloadFreeUnionCase(decl TopLevelDecl) returns bool
	return match decl.outcome 'state'
		pending or
		evaluating or
		value or
		failed or
		poisoned or
		managedValue or
		deferredRecord or
		unvalidatedRecord or
		storedRecord or
		imagedRecord gives false
		imagedBox(_, _, _, tag) gives tag == ValueTypeTag.named
