	let result = NameInFileArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try NameInFile.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadNameInFileArray'

// @generated library-cache end

typealias TopLevelDeclIndexMap = Map with (ByteArray, ElementIndex)

// @generated library-cache begin
function cacheWriteTopLevelDeclIndexMap(writer LibraryCacheWriter, value TopLevelDeclIndexMap)
