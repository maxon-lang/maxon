function noteRequirementByRefMasks(iface IrInterface, signatures ProgramSignatures, into WitnessByRefMaskMap)
	for method in iface.methods 'eachRequirement'
		if method.isStatic or method.byRefParams == NoParamPositions 'takesNothingByReference'
			continue
