end 'mixDeclaringTier'

let OperandAliasSetSeparator = 124

// The separator between a file's path and a declaration's bare name in `fileScopedDeclKey`. `|` is legal
// in neither a Maxon identifier nor a Windows path, so the composite is unambiguous.
let FileScopedKeySeparator = "|"

export typealias TopLevelDeclIndexArray = Array with ElementIndex

type SourceSite
	let filePath as FilePath
	let line as LineNumber
	let column as ColumnNumber

	static function of(filePath FilePath, line LineNumber, column ColumnNumber) returns SourceSite
		return Self{filePath: filePath, line: line, column: column}
	end 'of'

	function compare(other SourceSite) returns Ordering
		let byFile = comparePathIdentity(self.filePath, other: other.filePath)

		if byFile != Ordering.equalTo 'filesDiffer'
			return byFile
		end 'filesDiffer'

		let byLine = self.line.compare(other.line)

		if byLine != Ordering.equalTo 'linesDiffer'
			return byLine
		end 'linesDiffer'

		return self.column.compare(other.column)
	end 'compare'

	function precedes(other SourceSite) returns bool
		return self.compare(other) == Ordering.lessThan
	end 'precedes'
end 'SourceSite'

type DeclarationSite
	export let index as ElementIndex
	export let name as immutable ByteArray
	export let site as SourceSite

	static function of(decl TopLevelDecl, index ElementIndex) returns DeclarationSite
		return Self{index: index, name: decl.name, site: SourceSite.of(decl.declFilePath, line: decl.nameLine, column: decl.nameColumn)}
	end 'of'

	function compare(other DeclarationSite) returns Ordering
		return self.site.compare(other.site)
	end 'compare'

	function precedes(other DeclarationSite) returns bool
		return self.site.precedes(other.site)
	end 'precedes'
end 'DeclarationSite'

typealias DeclarationSiteArray = Array with DeclarationSite

// ONE name and the file that spelled it — the shape of every trace `checkUnusedExports` replays, because
// a reference is a name plus the reader that made it one. Two logs are kept in it, each recording a use
// that survives nowhere else: a cross-file read of an inlined top-level constant (the IR keeps none — see
// `notedConstantValue`), and a type name only a top-level initializer spells (the parse skips those tokens).
export type NameInFile
	export let name as immutable ByteArray
	export let readerFilePath as FilePath

	export static function create(name ByteArray, readerFilePath FilePath) returns NameInFile
		return Self{name: name, readerFilePath: readerFilePath}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.name)
		writer.text(self.readerFilePath.toString())
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns NameInFile throws LibraryCacheDamage
		let f_name = freeze try reader.bytes()
		let f_readerFilePath = try reader.path()

		return Self{name: f_name, readerFilePath: f_readerFilePath}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(NameInFile) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'NameInFile'

export typealias NameInFileArray = Array with NameInFile

// @generated library-cache begin
function cacheWriteNameInFileArray(writer LibraryCacheWriter, value NameInFileArray)
