		writer.text(self.declFilePath.toString())
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns GlobalAliasReturnInfo throws LibraryCacheDamage
		let f_returnedNames = try cacheReadNameRoster(reader)
		let f_returnCalls = try cacheReadForwardCallArray(reader)
		let f_bareName = freeze try reader.bytes()
		let f_callability = try cacheReadDeclCallability(reader)
		let f_declFilePath = try reader.path()

		return Self{returnedNames: f_returnedNames, returnCalls: f_returnCalls, bareName: f_bareName, callability: f_callability, declFilePath: f_declFilePath}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize40
		return sizeof(GlobalAliasReturnInfo) as CacheSize40
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'GlobalAliasReturnInfo'

