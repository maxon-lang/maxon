				withReceiver = maskWithParam(withReceiver, param: (formal + WitnessReceiverArgCount) as ParamCount)
			end 'aReferenceFormal'
		end 'eachFormal'

		into.upsert(witnessRequirementKey(iface.name, methodName: method.name), value: withReceiver)
