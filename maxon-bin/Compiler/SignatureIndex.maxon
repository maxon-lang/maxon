// statement (`return A`, `return T.member`) and why a name the body BINDS anywhere is dropped outright
// (`Parser.scanBodyFacts`). A later reader must not "simplify" the narrowness away by widening the scan
// and deleting the fallback: the narrowness is only safe while the fallback stands.
export type GlobalAliasReturnInfo
	// The names this body returns as a whole statement — `A`, or the joined `Box.shared` a static member is
	// read under (`Parser.parseStaticMemberAccess` looks a static member up under exactly that spelling).
	// Whether one of them DENOTES an immutable stored global is decided at closure time, because a file that
	// has not folded yet may be the one that declares it.
	export let returnedNames as NameRoster

	// The calls whose result this body returns — `return f(…)` — as the un-resolved shapes the source wrote
	// (see `ForwardCall`). A function that returns what a marked function returns is marked itself.
	export let returnCalls as ForwardCallArray

	// This declaration's own bare name and callability: the closure files its node in `DeclNodeSpace` from them.
	export let bareName as immutable ByteArray
	export let callability as DeclCallability

	// The file the declaration was swept from — the READER whose scope `returnedNames` must be resolved in.
	// A name two directories declare resolves per reader, so two directories' `A` are two different globals
	// and the answer is meaningless without the asking file.
	export let declFilePath as FilePath

	export static function create(returnedNames NameRoster, returnCalls ForwardCallArray, bareName ByteArray, callability DeclCallability, declFilePath FilePath) returns GlobalAliasReturnInfo
		return Self{returnedNames: returnedNames, returnCalls: returnCalls, bareName: bareName, callability: callability, declFilePath: declFilePath}
	end 'create'

	// Is there anything to record at all? A body that returns neither a bare name nor a call states nothing
	// and is not recorded — the "absence is the answer" default the whole registry rests on, and what keeps
	// the map empty for a program with no top-level aggregate at all.
	//
	// ⚡ **OVER THE TWO COLUMNS RATHER THAN OVER A BUILT `Self`, SO THE ANSWER IS AVAILABLE *BEFORE* THE
	// RECORD EXISTS.** The sweep asks it of the raw columns and builds nothing for a body that states nothing,
	// which is most of them; asked of a `Self` it would have cost a record and a `DeclCallability` per swept
	// declaration to discover that neither was wanted.
	export static function statesAnything(returnedNames NameRoster, returnCalls ForwardCallArray) returns bool
		return returnedNames.count() > 0 or returnCalls.count() > 0
	end 'statesAnything'

	// The closure interns a declaration's node from `bareName` (`closeGlobalAliasReturns`), so an
	// info filed under any other key must carry that key: otherwise no call reaches its node and
	// the mark is lost.
	export function declaredAs(declaredName ByteArray) returns GlobalAliasReturnInfo
		return Self.create(self.returnedNames, returnCalls: self.returnCalls, bareName: declaredName, callability: self.callability, declFilePath: self.declFilePath)
	end 'declaredAs'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		cacheWriteNameRoster(writer, value: self.returnedNames)
		cacheWriteForwardCallArray(writer, value: self.returnCalls)
		writer.bytes(self.bareName)
