		0 gives DataSlotLabel.unlabelled
		1 gives try cacheReadDataSlotLabelLabelled(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadDataSlotLabel'

function cacheReadDataSlotLabelLabelled(reader LibraryCacheReader) returns DataSlotLabel throws LibraryCacheDamage
