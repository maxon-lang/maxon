	match value 'payload'
		bareCallOnly then break
		bareCallOrDirectoryRoute then break
		methodOf(a0) then cacheWriteDeclCallabilityMethodOf(writer, a0: a0)
	end 'payload'
end 'cacheWriteDeclCallability'

function cacheWriteDeclCallabilityMethodOf(writer LibraryCacheWriter, a0 immutable ByteArray)
	writer.bytes(a0)
end 'cacheWriteDeclCallabilityMethodOf'

function cacheReadDeclCallability(reader LibraryCacheReader) returns DeclCallability throws LibraryCacheDamage
