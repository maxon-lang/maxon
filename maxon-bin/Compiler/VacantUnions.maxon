type VacantCopy
	let copy as ValueId
	let source as ValueId

	static function create(copy ValueId, source ValueId) returns Self
		return Self{copy: copy, source: source}
	end 'create'
end 'VacantCopy'

typealias VacantCopyArray = Array with VacantCopy

type VacantFill
	let binding as VarInfo
	let target as ValueId
	let value as ValueId
	let valueStart as ElementIndex
	let valueEnd as ElementIndex

	static function create(binding VarInfo, target ValueId, value ValueId, valueStart ElementIndex, valueEnd ElementIndex) returns Self
		return Self{binding: binding, target: target, value: value, valueStart: valueStart, valueEnd: valueEnd}
	end 'create'
end 'VacantFill'

typealias VacantFillArray = Array with VacantFill

function vacantUnionValuesIn(module MaxonModule, func IrFunction, constructed ValueIdArray, copies VacantCopyArray) returns ValueIdSet
	let vacant = ValueIdSet.create()

	if constructed.isEmpty() 'nothingIsVacant'
		return vacant
	end 'nothingIsVacant'

	for value in constructed 'eachConstructed'
		vacant.insert(value)
	end 'eachConstructed'

	for copied in copies 'eachCopy'
		vacant.insert(copied.copy)
	end 'eachCopy'

	let byId = module.blockIndexById(func)
	let fed = ValueIdSet.create()

	for blockRef in func.blockRefs 'eachFeedingBlock'
		let source = module.getBlock(blockRef)

		for edge in source.branchEdges 'eachFeedingEdge'
			let target = try module.getBlockByIdThrough(func, byId: byId, id: edge.targetBlockId) otherwise continue

			for position in 0 upto edge.argIds.count() 'eachFedPhi'
				fed.insert((try target.blockArgs.get(position) otherwise panic("vacantUnionValuesIn: an edge passes argument {position} to block {edge.targetBlockId}, which has {target.blockArgs.count()} block argument(s)")).valueId)
			end 'eachFedPhi'
		end 'eachFeedingEdge'
	end 'eachFeedingBlock'

	for blockRef in func.blockRefs 'eachPhiBlock'
		let holder = module.getBlock(blockRef)

		for arg in holder.blockArgs 'eachPhi'
			if fed.contains(arg.valueId) 'aFedPhi'
				vacant.insert(arg.valueId)
			end 'aFedPhi'
		end 'eachPhi'
	end 'eachPhiBlock'

	var changed = true

	while changed 'untilStable'
		changed = false

		for blockRef in func.blockRefs 'eachBlock'
			let source = module.getBlock(blockRef)

			for edge in source.branchEdges 'eachEdge'
				let target = try module.getBlockByIdThrough(func, byId: byId, id: edge.targetBlockId) otherwise continue

				for position in 0 upto edge.argIds.count() 'eachArgument'
					let argument = try edge.argIds.get(position) otherwise panic("vacantUnionValuesIn: argIds.get OOB at {position} despite the upto bound")
					let phi = (try target.blockArgs.get(position) otherwise panic("vacantUnionValuesIn: an edge passes argument {position} to block {edge.targetBlockId}, which has {target.blockArgs.count()} block argument(s)")).valueId

					if vacant.contains(phi) and not vacant.contains(argument) 'aValueThatMayHoldTheLinearCase'
						_ = vacant.remove(phi)
						changed = true
					end 'aValueThatMayHoldTheLinearCase'
				end 'eachArgument'
			end 'eachEdge'
		end 'eachBlock'

		for copied in copies 'eachCopyOfAValue'
			if vacant.contains(copied.copy) and not vacant.contains(copied.source) 'aCopyThatMayHoldTheLinearCase'
				_ = vacant.remove(copied.copy)
				changed = true
			end 'aCopyThatMayHoldTheLinearCase'
		end 'eachCopyOfAValue'
	end 'untilStable'

	return vacant
end 'vacantUnionValuesIn'
