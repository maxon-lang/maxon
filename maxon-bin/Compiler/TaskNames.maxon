export typealias TaskNameArray = Array with String

typealias TokenCursor = int(0 to u64.max)

// A task is declared at the left margin. Without the column test a `type`'s exported methods are
// offered as tasks, and asking for one compiles a manifest whose entry point is a method.
let TopLevelColumn = 1

let ReservedEntryPrefix = "__"
let EntryWordSeparator = "-"
let EntryNameSeparator = "_"

export union EntryRosterError implements Error
	unreadable(driverFile FilePath)
	unlexable(diagnostic Diagnostic)
end 'EntryRosterError'

export function entryNamesDeclaredIn(driverFile FilePath) returns TaskNameArray throws EntryRosterError
	let source = try File.readText(driverFile) otherwise throw EntryRosterError.unreadable(driverFile)

	let declared = try taskNamesIn(source) otherwise (e) 'unlexable'
		throw EntryRosterError.unlexable(lexerErrorDiagnostic(e, path: driverFile))
	end 'unlexable'

	var offered = TaskNameArray.create()

	for named in declared 'eachDeclaration'
		if not named.startsWith(ReservedEntryPrefix) 'anOfferedEntry'
			offered.push(named)
		end 'anOfferedEntry'
	end 'eachDeclaration'

	return offered
end 'entryNamesDeclaredIn'

export function entryNameOf(word String) returns String
	return word.replace(EntryWordSeparator, with: EntryNameSeparator)
end 'entryNameOf'

// Leading underscores stay underscores, so a listed word never begins with `-` and reads as an
// option.
function entryWordOf(name String) returns String
	var word = ""
	var leading = true

	for character in name 'eachCharacter'
		let spelled = "{character}"
		leading = leading and spelled == EntryNameSeparator
		word.append(EntryWordSeparator if spelled == EntryNameSeparator and not leading else spelled)
	end 'eachCharacter'

	return word
end 'entryWordOf'

export function printEntryWords(declared TaskNameArray)
	for offered in declared 'eachEntry'
		print("{entryWordOf(offered)}\n")
	end 'eachEntry'
end 'printEntryWords'

export function taskNamesIn(source String) returns TaskNameArray throws LexerError
	var names = TaskNameArray.create()

	let tokens = try tokenize(source, keywords: KeywordTable.create())
	let count = tokens.count()

	if count < 4 'tooShortToDeclareOne'
		return names
	end 'tooShortToDeclareOne'

	var i = 0 as TokenCursor

	while i + 3 < count 'scan'
		let named = try taskNameAt(tokens, at: i) otherwise 'notADeclaration'
			i = i + 1
			continue
		end 'notADeclaration'

		names.push(named)
		i = i + 4
	end 'scan'

	return names
end 'taskNamesIn'

union TaskScanError implements Error
	notATaskDeclaration
end 'TaskScanError'

function taskNameAt(tokens TokenArray, at TokenCursor) returns String throws TaskScanError
	let keyword = try tokens.get(at) otherwise throw TaskScanError.notATaskDeclaration

	if (keyword.kind != TokenKind.export and keyword.kind != TokenKind.public) or keyword.column != TopLevelColumn 'notAnExportedTopLevelDeclaration'
		throw TaskScanError.notATaskDeclaration
	end 'notAnExportedTopLevelDeclaration'

	let declaration = try tokens.get(at + 1) otherwise throw TaskScanError.notATaskDeclaration

	if declaration.kind != TokenKind.function 'notAFunction'
		throw TaskScanError.notATaskDeclaration
	end 'notAFunction'

	let named = try tokens.get(at + 2) otherwise throw TaskScanError.notATaskDeclaration

	if named.kind != TokenKind.identifier 'notANamedFunction'
		throw TaskScanError.notATaskDeclaration
	end 'notANamedFunction'

	let opened = try tokens.get(at + 3) otherwise throw TaskScanError.notATaskDeclaration

	if opened.kind != TokenKind.leftParen 'notAParameterList'
		throw TaskScanError.notATaskDeclaration
	end 'notAParameterList'

	return String.from(named.value)
end 'taskNameAt'
