// Compiler/Debug/MxdbgReader.maxon — read a `.mxdbg` image back.
//
// It holds the raw bytes and indexes them in place; nothing is copied out beyond the strings a caller
// asks for. Every table is found through its own header slot, so a writer may lay the tables out in any
// order.
//
// A file this reader cannot vouch for is refused at `parse` with a reason, never partly trusted: an
// instrument that answers confidently from a container it misread is worse than one that will not
// answer at all. Every cross-table reference and window is checked there, which is what lets the
// accessors treat a bad one as a panic.

export enum MxdbgReference
	siteParent
	siteCallFile
	rangeSite
	localSite
	localType
	fieldType
	elementType
	lineFile
	coverageFile
end 'MxdbgReference'

export enum MxdbgWindow
	functionLines
	functionLocals
	typeFields
	foldedWords
end 'MxdbgWindow'

export enum MxdbgOrderedTable
	functionLines
	inlineRanges
	functionRanges
	functionLineOutsideItsRange
	localScopes
end 'MxdbgOrderedTable'

function orderedTableText(table MxdbgOrderedTable, record MxdbgIndex) returns String
	return match table 'which'
		functionLines gives "line rows of function {record} are not in ascending code order"
		inlineRanges gives "inline range {record} is empty or overlaps the range before it"
		functionRanges gives "function {record}'s code range ends before it starts or overlaps the function below it"
		functionLineOutsideItsRange gives "a line row of function {record} lies outside that function's code range"
		localScopes gives "local {record}'s scope is empty or reaches outside its function's code range"
	end 'which'
end 'orderedTableText'

export union MxdbgReadError implements Error
	notASidecar
	unsupportedVersion(version MxdbgIndex)
	truncated
	danglingReference(reference MxdbgReference, record MxdbgIndex, names MxdbgIndex)
	windowPastTable(window MxdbgWindow, record MxdbgIndex)
	unknownOrigin(holder MxdbgOriginHolder, record MxdbgIndex, word MxdbgIndex)
	stringPastPool(string MxdbgPoolString, record MxdbgIndex)
	outOfOrder(table MxdbgOrderedTable, record MxdbgIndex)
	unknownLocKind(record MxdbgIndex, word MxdbgIndex)

	export function displayReason() returns String
		return match self 'k'
			notASidecar gives "not a .mxdbg file (bad magic)"
			unsupportedVersion(version) gives ".mxdbg format version {version} is not supported (this build speaks {MxdbgFormatVersion})"
			truncated gives "the .mxdbg header describes more data than the file holds"
			danglingReference(reference, record, names) gives "the .mxdbg {danglingReferenceText(reference, record: record, names: names)}"
			windowPastTable(window, record) gives "the .mxdbg {windowPastTableText(window, record: record)}"
			unknownOrigin(holder, record, word) gives "the .mxdbg {originHolderText(holder)} {record} names origin {word}, which is none this build knows"
			stringPastPool(string, record) gives "the .mxdbg {poolStringText(string, record: record)} runs past the string pool"
			outOfOrder(table, record) gives "the .mxdbg {orderedTableText(table, record: record)}"
			unknownLocKind(record, word) gives "the .mxdbg local {record} names location kind {word}, which is none this build knows"
		end 'k'
	end 'displayReason'
end 'MxdbgReadError'

export enum MxdbgPoolString
	targetTriple
	sourceRoot
	fileName
	functionName
	functionDisplayName
	typeName
	fieldName
	localName
	inlineSiteName
end 'MxdbgPoolString'

function poolStringText(string MxdbgPoolString, record MxdbgIndex) returns String
	return match string 'which'
		targetTriple gives "header's target triple"
		sourceRoot gives "header's source root"
		fileName gives "name of file {record}"
		functionName gives "name of function {record}"
		functionDisplayName gives "display name of function {record}"
		typeName gives "name of type {record}"
		fieldName gives "name of field {record}"
		localName gives "name of local {record}"
		inlineSiteName gives "name of inline site {record}"
	end 'which'
end 'poolStringText'

function requirePoolSliceFits(offset ByteOffset, length BytePos, poolSize BytePos, string MxdbgPoolString, record MxdbgIndex) throws MxdbgReadError
	if not spanFitsWithin(offset, count: length, total: poolSize) 'pastThePool'
		throw MxdbgReadError.stringPastPool(string, record: record)
	end 'pastThePool'
end 'requirePoolSliceFits'

export enum MxdbgOriginHolder
	functionRecord
	inlineSiteRecord
end 'MxdbgOriginHolder'

function originHolderText(holder MxdbgOriginHolder) returns String
	return match holder 'which'
		functionRecord gives "function"
		inlineSiteRecord gives "inline site"
	end 'which'
end 'originHolderText'

function requireKnownOrigin(word MxdbgIndex, holder MxdbgOriginHolder, record MxdbgIndex) throws MxdbgReadError
	match mxdbgOriginOfWord(word) 'known'
		unknown then throw MxdbgReadError.unknownOrigin(holder, record: record, word: word)
		known then return
	end 'known'
end 'requireKnownOrigin'

function validatedOrigin(word MxdbgIndex) returns MxdbgOrigin
	match mxdbgOriginOfWord(word) 'known'
		unknown then panic("MxdbgReader: origin word {word} was read from a record `requireReferencesHold` validated when the image was opened")
		known(origin) then return origin
	end 'known'
end 'validatedOrigin'

function danglingReferenceText(reference MxdbgReference, record MxdbgIndex, names MxdbgIndex) returns String
	return match reference 'which'
		siteParent gives "inline site {record} names {names} as its parent, which is not a site recorded before it"
		siteCallFile gives "inline site {record} was called from file {names}, past the file table"
		rangeSite gives "inline range {record} names site {names}, past the site table"
		localSite gives "local {record} belongs to inline site {names}, past the site table"
		localType gives "local {record} names type {names}, past the type table"
		fieldType gives "field {record} names type {names}, past the type table"
		elementType gives "type {record} names element type {names}, past the type table"
		lineFile gives "line row {record} names file {names}, past the file table"
		coverageFile gives "coverage point {record} names file {names}, past the file table"
	end 'which'
end 'danglingReferenceText'

function windowPastTableText(window MxdbgWindow, record MxdbgIndex) returns String
	return match window 'which'
		functionLines gives "function {record} claims line rows past the line table"
		functionLocals gives "function {record} claims locals past the local table"
		typeFields gives "type {record} claims fields past the field table"
		foldedWords gives "local {record} folds constant words past the constant table"
	end 'which'
end 'windowPastTableText'

export type MxdbgFunctionInfo
	export var name as String
	export var codeStart as MxdbgCodeOffset
	export var codeEnd as MxdbgCodeOffset
	export var frameSize as MxdbgIndex
	export var paramCount as MxdbgIndex
	export var lineFirst as MxdbgIndex
	export var lineCount as MxdbgIndex
	export var localFirst as MxdbgIndex
	export var localCount as MxdbgIndex
	export var displayName as String
	export var origin as MxdbgOrigin

	export static function create(name String, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, frameSize MxdbgIndex, paramCount MxdbgIndex, lineFirst MxdbgIndex, lineCount MxdbgIndex, localFirst MxdbgIndex, localCount MxdbgIndex, displayName String, origin MxdbgOrigin) returns MxdbgFunctionInfo
		return Self{name: name, codeStart: codeStart, codeEnd: codeEnd, frameSize: frameSize, paramCount: paramCount, lineFirst: lineFirst, lineCount: lineCount, localFirst: localFirst, localCount: localCount, displayName: displayName, origin: origin}
	end 'create'
end 'MxdbgFunctionInfo'

// One line record, materialized. `file` is the path the row's file id names, resolved here so a caller
// never has to hold the reader and an id together.
export type MxdbgLineInfo
	export var codeOffset as MxdbgCodeOffset
	export var file as String
	export var line as MxdbgIndex
	export var column as MxdbgIndex
	export var flags as MxdbgIndex

	export static function create(codeOffset MxdbgCodeOffset, file String, line MxdbgIndex, column MxdbgIndex, flags MxdbgIndex) returns MxdbgLineInfo
		return Self{codeOffset: codeOffset, file: file, line: line, column: column, flags: flags}
	end 'create'

	export function entersTheLine() returns bool
		return (self.flags and MxdbgLineFlagLineEntry) != 0
	end 'entersTheLine'
end 'MxdbgLineInfo'

// One type record, materialized. `kind` stays the raw word the file carries: this reader's job is to
// hand back what is written, and a kind it does not recognize must reach the caller rather than be
// folded into one it does.
export type MxdbgTypeInfo
	export var name as String
	export var kind as MxdbgIndex
	export var size as MxdbgIndex
	export var align as MxdbgIndex
	export var fieldFirst as MxdbgIndex
	export var fieldCount as MxdbgIndex
	export var elementTypeId as MxdbgIndex
	export var flags as MxdbgIndex

	export static function create(name String, kind MxdbgIndex, size MxdbgIndex, align MxdbgIndex, fieldFirst MxdbgIndex, fieldCount MxdbgIndex, elementTypeId MxdbgIndex, flags MxdbgIndex) returns MxdbgTypeInfo
		return Self{name: name, kind: kind, size: size, align: align, fieldFirst: fieldFirst, fieldCount: fieldCount, elementTypeId: elementTypeId, flags: flags}
	end 'create'

	export function describesAnElement() returns bool
		return self.elementTypeId != MxdbgNoElementType
	end 'describesAnElement'

	export function isSigned() returns bool
		return (self.flags and MxdbgTypeFlagSigned) != 0
	end 'isSigned'
end 'MxdbgTypeInfo'

// One field record, materialized. For an enum entry a "field" is a CASE and `offset` is its RAW TAG
// VALUE rather than its ordinal, which is what a renderer has to match a stopped discriminant against.
export type MxdbgFieldInfo
	export var name as String
	export var offset as MxdbgIndex
	export var typeId as MxdbgIndex

	export static function create(name String, offset MxdbgIndex, typeId MxdbgIndex) returns MxdbgFieldInfo
		return Self{name: name, offset: offset, typeId: typeId}
	end 'create'
end 'MxdbgFieldInfo'

export type MxdbgLocalInfo
	export var name as String
	export var locKind as MxdbgIndex
	export var locValue as MxdbgLocValue
	export var typeId as MxdbgIndex
	export var scopeStart as MxdbgCodeOffset
	export var scopeEnd as MxdbgCodeOffset
	export var flags as MxdbgIndex
	export var site as MxdbgInlineSiteLookup

	export static function create(name String, locKind MxdbgIndex, locValue MxdbgLocValue, typeId MxdbgIndex, scopeStart MxdbgCodeOffset, scopeEnd MxdbgCodeOffset, flags MxdbgIndex, site MxdbgInlineSiteLookup) returns MxdbgLocalInfo
		return Self{name: name, locKind: locKind, locValue: locValue, typeId: typeId, scopeStart: scopeStart, scopeEnd: scopeEnd, flags: flags, site: site}
	end 'create'

	export function holdsAPointer() returns bool
		return (self.flags and MxdbgLocalFlagIndirect) != 0
	end 'holdsAPointer'

	export function isAConstant() returns bool
		return self.locKind == MxdbgLocKindConstant
	end 'isAConstant'

	export function isAFoldedAggregate() returns bool
		return self.locKind == MxdbgLocKindFoldedAggregate
	end 'isAFoldedAggregate'

	export function covers(codeOffset MxdbgCodeOffset) returns bool
		return codeOffset >= self.scopeStart and codeOffset < self.scopeEnd
	end 'covers'
end 'MxdbgLocalInfo'

// One coverage point, materialized. Its COUNTER INDEX is its index in this table — the same number the
// emitted increment carries and the same slot of the `.mxcov` counter array, which is what binds a
// sidecar to a data file with no relationship field written down anywhere.
export type MxdbgCovPointInfo
	export var file as String
	export var line as MxdbgIndex
	export var column as MxdbgIndex

	// The position of the CONSTRUCT this point is an arm of. It identifies the branch exactly — two `if`s
	// or two `match`es cannot share one token position — so a report groups a branch's arms by it rather
	// than by a relationship the file would have to carry.
	export var branchLine as MxdbgIndex
	export var branchColumn as MxdbgIndex
	var flags as MxdbgIndex

	static function create(file String, line MxdbgIndex, column MxdbgIndex, branchLine MxdbgIndex, branchColumn MxdbgIndex, flags MxdbgIndex) returns MxdbgCovPointInfo
		return Self{file: file, line: line, column: column, branchLine: branchLine, branchColumn: branchColumn, flags: flags}
	end 'create'

	// No code was emitted for this point. Distinct from a zero counter, which is real code no run reached.
	export function eliminated() returns bool
		return (self.flags and MxdbgCovFlagEliminated) != 0
	end 'eliminated'

	export function isThenArm() returns bool
		return (self.flags and MxdbgCovFlagArmThen) != 0
	end 'isThenArm'

	export function isElseArm() returns bool
		return (self.flags and MxdbgCovFlagArmElse) != 0
	end 'isElseArm'

	export function isCaseArm() returns bool
		return (self.flags and MxdbgCovFlagArmCase) != 0
	end 'isCaseArm'

	// The arm the source never wrote — the `else` of an `if` that has none, which no line table can
	// describe because it has no source text to hold a row.
	export function isImplicitArm() returns bool
		return (self.flags and MxdbgCovFlagArmImplicit) != 0
	end 'isImplicitArm'

	export function isBranchArm() returns bool
		return self.isThenArm() or self.isElseArm() or self.isCaseArm()
	end 'isBranchArm'
end 'MxdbgCovPointInfo'

// A lookup that legitimately finds nothing: an offset in a gap (padding, the appended symbol table), or
// a function with no line rows. A union rather than a zero record, because "no code there" and "code at
// line 0" are different answers and a debugger must be able to say the first one.
export union MxdbgFunctionLookup
	none
	found(info MxdbgFunctionInfo)
end 'MxdbgFunctionLookup'

export type MxdbgInlineSiteInfo
	export var name as String
	export var parent as MxdbgInlineSiteLookup
	export var call as MxdbgCallPosition
	export var origin as MxdbgOrigin

	export static function create(name String, parent MxdbgInlineSiteLookup, call MxdbgCallPosition, origin MxdbgOrigin) returns MxdbgInlineSiteInfo
		return Self{name: name, parent: parent, call: call, origin: origin}
	end 'create'
end 'MxdbgInlineSiteInfo'

export union MxdbgCallPosition
	none
	at(file String, line MxdbgIndex, column MxdbgIndex)
end 'MxdbgCallPosition'

// A site index, or none: what an offset outside every inline range answers, and what a site spliced
// into the function's own text names as its parent.
export union MxdbgInlineSiteLookup
	none
	site(index MxdbgIndex)
end 'MxdbgInlineSiteLookup'

export union MxdbgLineLookup
	none
	found(info MxdbgLineInfo)
end 'MxdbgLineLookup'

// The function table read in CODE-START order — see `MxdbgReader.funcOrder`.
typealias MxdbgFuncOrder = Array with MxdbgIndex

export typealias MxdbgLineInfoArray = Array with MxdbgLineInfo

export type MxdbgReader
	var image as ByteArray
	export var buildId as HashDigest
	export var triple as String
	export var sourceRoot as String
	var stringPoolOff as ByteOffset
	var stringPoolSize as BytePos
	var fileTableOff as ByteOffset
	var fileTally as MxdbgIndex
	var funcTableOff as ByteOffset
	var funcTally as MxdbgIndex
	var lineTableOff as ByteOffset
	var lineTally as MxdbgIndex
	var typeTableOff as ByteOffset
	var typeTally as MxdbgIndex
	var fieldTableOff as ByteOffset
	var fieldTally as MxdbgIndex
	var localTableOff as ByteOffset
	var localTally as MxdbgIndex
	var covTableOff as ByteOffset
	var covTally as MxdbgIndex
	var inlineSiteTableOff as ByteOffset
	var inlineSiteTally as MxdbgIndex
	var inlineRangeTableOff as ByteOffset
	var inlineRangeTally as MxdbgIndex
	var constTableOff as ByteOffset
	var constTally as MxdbgIndex

	// Function indices in code-start order, which is what makes `functionContaining` a binary search. It is
	// a sort rather than a claim about the writer: a sidecar may store its table in emission order, so a walk
	// in file order would answer wrongly. A profiler resolves ten frames per sample at a kilohertz over a
	// table of thousands, so an O(F) scan here is the dominant cost of the whole instrument.
	var funcOrder as MxdbgFuncOrder

	export static function parse(image ByteArray) returns MxdbgReader throws MxdbgReadError
		if not mxdbgMagicMatches(image) 'badMagic'
			throw MxdbgReadError.notASidecar
		end 'badMagic'

		let version = imageReadU32(image, at: MxdbgOffVersion) as MxdbgIndex

		if version != MxdbgFormatVersion 'wrongVersion'
			throw MxdbgReadError.unsupportedVersion(version)
		end 'wrongVersion'

		let stringPoolOff = imageReadU32(image, at: MxdbgOffStringPoolOff) as ByteOffset
		let poolSize = imageReadU32(image, at: MxdbgOffStringPoolSize) as BytePos

		if not spanFitsWithin(stringPoolOff, count: poolSize, total: image.count()) 'poolPastEnd'
			throw MxdbgReadError.truncated
		end 'poolPastEnd'

		let fileTableOff = imageReadU32(image, at: MxdbgOffFileTableOff) as ByteOffset
		let fileTally = imageReadU32(image, at: MxdbgOffFileCount) as MxdbgIndex
		let funcTableOff = imageReadU32(image, at: MxdbgOffFuncTableOff) as ByteOffset
		let funcTally = imageReadU32(image, at: MxdbgOffFuncCount) as MxdbgIndex
		let lineTableOff = imageReadU32(image, at: MxdbgOffLineTableOff) as ByteOffset
		let lineTally = imageReadU32(image, at: MxdbgOffLineCount) as MxdbgIndex

		if not spanFitsWithin(fileTableOff, count: (fileTally * MxdbgFileEntrySize) as BytePos, total: image.count()) or not spanFitsWithin(funcTableOff, count: (funcTally * MxdbgFuncEntrySize) as BytePos, total: image.count()) or not spanFitsWithin(lineTableOff, count: (lineTally * MxdbgLineEntrySize) as BytePos, total: image.count()) 'tablePastEnd'
			throw MxdbgReadError.truncated
		end 'tablePastEnd'

		let typeTableOff = imageReadU32(image, at: MxdbgOffTypeTableOff) as ByteOffset
		let typeTally = imageReadU32(image, at: MxdbgOffTypeCount) as MxdbgIndex
		let fieldTableOff = imageReadU32(image, at: MxdbgOffFieldTableOff) as ByteOffset
		let fieldTally = imageReadU32(image, at: MxdbgOffFieldCount) as MxdbgIndex
		let localTableOff = imageReadU32(image, at: MxdbgOffLocalTableOff) as ByteOffset
		let localTally = imageReadU32(image, at: MxdbgOffLocalCount) as MxdbgIndex

		if not spanFitsWithin(typeTableOff, count: (typeTally * MxdbgTypeEntrySize) as BytePos, total: image.count()) or not spanFitsWithin(fieldTableOff, count: (fieldTally * MxdbgFieldEntrySize) as BytePos, total: image.count()) or not spanFitsWithin(localTableOff, count: (localTally * MxdbgLocalEntrySize) as BytePos, total: image.count()) 'recordTablePastEnd'
			throw MxdbgReadError.truncated
		end 'recordTablePastEnd'

		let covTableOff = imageReadU32(image, at: MxdbgOffCovTableOff) as ByteOffset
		let covTally = imageReadU32(image, at: MxdbgOffCovCount) as MxdbgIndex

		if not spanFitsWithin(covTableOff, count: (covTally * MxdbgCovEntrySize) as BytePos, total: image.count()) 'coverageTablePastEnd'
			throw MxdbgReadError.truncated
		end 'coverageTablePastEnd'

		let inlineSiteTableOff = imageReadU32(image, at: MxdbgOffInlineSiteTableOff) as ByteOffset
		let inlineSiteTally = imageReadU32(image, at: MxdbgOffInlineSiteCount) as MxdbgIndex
		let inlineRangeTableOff = imageReadU32(image, at: MxdbgOffInlineRangeTableOff) as ByteOffset
		let inlineRangeTally = imageReadU32(image, at: MxdbgOffInlineRangeCount) as MxdbgIndex

		if not spanFitsWithin(inlineSiteTableOff, count: (inlineSiteTally * MxdbgInlineSiteEntrySize) as BytePos, total: image.count()) or not spanFitsWithin(inlineRangeTableOff, count: (inlineRangeTally * MxdbgInlineRangeEntrySize) as BytePos, total: image.count()) 'inlineTablePastEnd'
			throw MxdbgReadError.truncated
		end 'inlineTablePastEnd'

		let constTableOff = imageReadU32(image, at: MxdbgOffConstTableOff) as ByteOffset
		let constTally = imageReadU32(image, at: MxdbgOffConstCount) as MxdbgIndex

		if not spanFitsWithin(constTableOff, count: (constTally * MxdbgConstEntrySize) as BytePos, total: image.count()) 'constTablePastEnd'
			throw MxdbgReadError.truncated
		end 'constTablePastEnd'

		let tripleOff = imageReadU32(image, at: MxdbgOffTripleOff) as ByteOffset
		let tripleLen = imageReadU32(image, at: MxdbgOffTripleLen) as BytePos
		let rootOff = imageReadU32(image, at: MxdbgOffSourceRootOff) as ByteOffset
		let rootLen = imageReadU32(image, at: MxdbgOffSourceRootLen) as BytePos

		try requirePoolSliceFits(tripleOff, length: tripleLen, poolSize: poolSize, string: MxdbgPoolString.targetTriple, record: 0)
		try requirePoolSliceFits(rootOff, length: rootLen, poolSize: poolSize, string: MxdbgPoolString.sourceRoot, record: 0)

		let reader = Self{image: image, buildId: imageReadU64(image, at: MxdbgOffBuildId) as HashDigest, triple: String.from(imageSlice(image, start: stringPoolOff + tripleOff, count: tripleLen)), sourceRoot: String.from(imageSlice(image, start: stringPoolOff + rootOff, count: rootLen)), stringPoolOff: stringPoolOff, stringPoolSize: poolSize, fileTableOff: fileTableOff, fileTally: fileTally, funcTableOff: funcTableOff, funcTally: funcTally, lineTableOff: lineTableOff, lineTally: lineTally, typeTableOff: typeTableOff, typeTally: typeTally, fieldTableOff: fieldTableOff, fieldTally: fieldTally, localTableOff: localTableOff, localTally: localTally, covTableOff: covTableOff, covTally: covTally, inlineSiteTableOff: inlineSiteTableOff, inlineSiteTally: inlineSiteTally, inlineRangeTableOff: inlineRangeTableOff, inlineRangeTally: inlineRangeTally, constTableOff: constTableOff, constTally: constTally, funcOrder: functionOrderByCodeStart(image, tableOff: funcTableOff, tally: funcTally)}
		try reader.requireReferencesHold()
		try reader.requireOrderedTables()

		return reader
	end 'parse'

	function requireRecordString(tableOff ByteOffset, stride ByteOffset, index MxdbgIndex, offsetAt ByteOffset, lengthAt ByteOffset, string MxdbgPoolString) throws MxdbgReadError
		try requirePoolSliceFits(self.tableWord(tableOff, stride: stride, index: index, at: offsetAt) as ByteOffset, length: self.tableWord(tableOff, stride: stride, index: index, at: lengthAt) as BytePos, poolSize: self.stringPoolSize, string: string, record: index)
	end 'requireRecordString'

	function requireReferencesHold() throws MxdbgReadError
		for file in 0 upto self.fileTally 'eachFile'
			try self.requireRecordString(self.fileTableOff, stride: MxdbgFileEntrySize, index: file, offsetAt: MxdbgFileNameOff, lengthAt: MxdbgFileNameLen, string: MxdbgPoolString.fileName)
		end 'eachFile'

		for site in 0 upto self.inlineSiteTally 'eachSite'
			try self.requireRecordString(self.inlineSiteTableOff, stride: MxdbgInlineSiteEntrySize, index: site, offsetAt: MxdbgInlineSiteNameOff, lengthAt: MxdbgInlineSiteNameLen, string: MxdbgPoolString.inlineSiteName)

			let parent = self.tableWord(self.inlineSiteTableOff, stride: MxdbgInlineSiteEntrySize, index: site, at: MxdbgInlineSiteParent)

			// An earlier parent is what keeps every parent chain acyclic, so a walk up one ends.
			if not mxdbgNoneOrBelow(parent, none: MxdbgNoInlineSite, bound: site) 'notAnEarlierSite'
				throw MxdbgReadError.danglingReference(MxdbgReference.siteParent, record: site, names: parent)
			end 'notAnEarlierSite'

			let callFile = self.tableWord(self.inlineSiteTableOff, stride: MxdbgInlineSiteEntrySize, index: site, at: MxdbgInlineSiteCallFileId)

			if not mxdbgNoneOrBelow(callFile, none: MxdbgNoSourceFile, bound: self.fileTally) 'noSuchCallFile'
				throw MxdbgReadError.danglingReference(MxdbgReference.siteCallFile, record: site, names: callFile)
			end 'noSuchCallFile'

			try requireKnownOrigin(self.tableWord(self.inlineSiteTableOff, stride: MxdbgInlineSiteEntrySize, index: site, at: MxdbgInlineSiteOrigin), holder: MxdbgOriginHolder.inlineSiteRecord, record: site)
		end 'eachSite'

		for range in 0 upto self.inlineRangeTally 'eachRange'
			try self.requireBelow(self.inlineRangeField(range, field: MxdbgInlineRangeSite), tally: self.inlineSiteTally, reference: MxdbgReference.rangeSite, record: range)
		end 'eachRange'

		for row in 0 upto self.lineTally 'eachRow'
			try self.requireBelow(self.tableWord(self.lineTableOff, stride: MxdbgLineEntrySize, index: row, at: MxdbgLineFileId), tally: self.fileTally, reference: MxdbgReference.lineFile, record: row)
		end 'eachRow'

		for point in 0 upto self.covTally 'eachPoint'
			try self.requireBelow(self.tableWord(self.covTableOff, stride: MxdbgCovEntrySize, index: point, at: MxdbgCovFileId), tally: self.fileTally, reference: MxdbgReference.coverageFile, record: point)
		end 'eachPoint'

		for fieldIndex in 0 upto self.fieldTally 'eachField'
			try self.requireRecordString(self.fieldTableOff, stride: MxdbgFieldEntrySize, index: fieldIndex, offsetAt: MxdbgFieldNameOff, lengthAt: MxdbgFieldNameLen, string: MxdbgPoolString.fieldName)
			try self.requireBelow(self.tableWord(self.fieldTableOff, stride: MxdbgFieldEntrySize, index: fieldIndex, at: MxdbgFieldTypeId), tally: self.typeTally, reference: MxdbgReference.fieldType, record: fieldIndex)
		end 'eachField'

		for entry in 0 upto self.typeTally 'eachType'
			try self.requireRecordString(self.typeTableOff, stride: MxdbgTypeEntrySize, index: entry, offsetAt: MxdbgTypeNameOff, lengthAt: MxdbgTypeNameLen, string: MxdbgPoolString.typeName)
			let element = self.tableWord(self.typeTableOff, stride: MxdbgTypeEntrySize, index: entry, at: MxdbgTypeElementTypeId)

			if not mxdbgNoneOrBelow(element, none: MxdbgNoElementType, bound: self.typeTally) 'noSuchElementType'
				throw MxdbgReadError.danglingReference(MxdbgReference.elementType, record: entry, names: element)
			end 'noSuchElementType'

			try self.requireWindowFits(self.tableWord(self.typeTableOff, stride: MxdbgTypeEntrySize, index: entry, at: MxdbgTypeFieldFirst), count: self.tableWord(self.typeTableOff, stride: MxdbgTypeEntrySize, index: entry, at: MxdbgTypeFieldCount), tally: self.fieldTally, window: MxdbgWindow.typeFields, record: entry)
		end 'eachType'

		for fn in 0 upto self.funcTally 'eachFunction'
			try self.requireRecordString(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, offsetAt: MxdbgFuncNameOff, lengthAt: MxdbgFuncNameLen, string: MxdbgPoolString.functionName)
			try self.requireRecordString(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, offsetAt: MxdbgFuncDisplayNameOff, lengthAt: MxdbgFuncDisplayNameLen, string: MxdbgPoolString.functionDisplayName)
			try self.requireWindowFits(self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLineFirst), count: self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLineCount), tally: self.lineTally, window: MxdbgWindow.functionLines, record: fn)
			try self.requireWindowFits(self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLocalFirst), count: self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLocalCount), tally: self.localTally, window: MxdbgWindow.functionLocals, record: fn)
			try requireKnownOrigin(self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncOrigin), holder: MxdbgOriginHolder.functionRecord, record: fn)
		end 'eachFunction'

		for local in 0 upto self.localTally 'eachLocal'
			try self.requireRecordString(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, offsetAt: MxdbgLocalNameOff, lengthAt: MxdbgLocalNameLen, string: MxdbgPoolString.localName)
			let site = self.tableWord(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, at: MxdbgLocalSite)

			if not mxdbgNoneOrBelow(site, none: MxdbgNoInlineSite, bound: self.inlineSiteTally) 'noSuchSite'
				throw MxdbgReadError.danglingReference(MxdbgReference.localSite, record: local, names: site)
			end 'noSuchSite'

			let typeId = self.tableWord(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, at: MxdbgLocalTypeId)
			try self.requireBelow(typeId, tally: self.typeTally, reference: MxdbgReference.localType, record: local)

			let locKind = self.tableWord(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, at: MxdbgLocalLocKind)

			if not mxdbgLocKindIsKnown(locKind) 'noSuchLocKind'
				throw MxdbgReadError.unknownLocKind(local, word: locKind)
			end 'noSuchLocKind'

			if locKind == MxdbgLocKindFoldedAggregate 'foldsConstantWords'
				try self.requireFoldedWordsFit(local, typeId: typeId)
			end 'foldsConstantWords'
		end 'eachLocal'
	end 'requireReferencesHold'

	function requireOrderedTables() throws MxdbgReadError
		var previousFunctionEnd = 0 as MxdbgCodeOffset

		for position in 0 upto self.funcOrder.count() 'eachFunctionInCodeOrder'
			let fn = try self.funcOrder.get(position) otherwise panic("MxdbgReader.requireOrderedTables: position {position} is inside a list of {self.funcOrder.count()} indices")
			let codeStart = self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncCodeStart) as MxdbgCodeOffset
			let codeEnd = self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncCodeEnd) as MxdbgCodeOffset

			if not mxdbgFunctionRangeFollows(codeStart, codeEnd: codeEnd, previousEnd: previousFunctionEnd) 'invertedOrOverlapping'
				throw MxdbgReadError.outOfOrder(MxdbgOrderedTable.functionRanges, record: fn)
			end 'invertedOrOverlapping'

			previousFunctionEnd = codeEnd
			try self.requireRowsInside(fn, codeStart: codeStart, codeEnd: codeEnd)
			try self.requireScopesInside(fn, codeStart: codeStart, codeEnd: codeEnd)
		end 'eachFunctionInCodeOrder'

		var previousEnd = 0 as MxdbgCodeOffset

		for range in 0 upto self.inlineRangeTally 'eachRange'
			let codeStart = self.inlineRangeField(range, field: MxdbgInlineRangeCodeStart) as MxdbgCodeOffset
			let codeEnd = self.inlineRangeField(range, field: MxdbgInlineRangeCodeEnd) as MxdbgCodeOffset

			if not mxdbgCodeRangeFollows(codeStart, codeEnd: codeEnd, previousEnd: previousEnd) 'emptyOrOverlapping'
				throw MxdbgReadError.outOfOrder(MxdbgOrderedTable.inlineRanges, record: range)
			end 'emptyOrOverlapping'

			previousEnd = codeEnd
		end 'eachRange'
	end 'requireOrderedTables'

	function requireRowsInside(fn MxdbgIndex, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset) throws MxdbgReadError
		let first = self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLineFirst)
		let count = self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLineCount)
		var previousRow = codeStart

		for row in first upto first + count 'eachRow'
			let offset = self.tableWord(self.lineTableOff, stride: MxdbgLineEntrySize, index: row, at: MxdbgLineCodeOffset) as MxdbgCodeOffset

			if not mxdbgRowIsInside(offset, codeStart: codeStart, codeEnd: codeEnd) 'outsideTheFunction'
				throw MxdbgReadError.outOfOrder(MxdbgOrderedTable.functionLineOutsideItsRange, record: fn)
			end 'outsideTheFunction'

			if not mxdbgRowFollows(offset, previousRow: previousRow) 'rowBehindItsPredecessor'
				throw MxdbgReadError.outOfOrder(MxdbgOrderedTable.functionLines, record: fn)
			end 'rowBehindItsPredecessor'

			previousRow = offset
		end 'eachRow'
	end 'requireRowsInside'

	function requireScopesInside(fn MxdbgIndex, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset) throws MxdbgReadError
		let first = self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLocalFirst)
		let count = self.tableWord(self.funcTableOff, stride: MxdbgFuncEntrySize, index: fn, at: MxdbgFuncLocalCount)

		for local in first upto first + count 'eachLocal'
			let scopeStart = self.tableWord(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, at: MxdbgLocalScopeStart) as MxdbgCodeOffset
			let scopeEnd = self.tableWord(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, at: MxdbgLocalScopeEnd) as MxdbgCodeOffset

			if not mxdbgScopeIsInside(scopeStart, scopeEnd: scopeEnd, codeStart: codeStart, codeEnd: codeEnd) 'emptyOrOutside'
				throw MxdbgReadError.outOfOrder(MxdbgOrderedTable.localScopes, record: local)
			end 'emptyOrOutside'
		end 'eachLocal'
	end 'requireScopesInside'

	function requireFoldedWordsFit(local MxdbgIndex, typeId MxdbgIndex) throws MxdbgReadError
		let first = mxdbgSignedWord(self.tableWord(self.localTableOff, stride: MxdbgLocalEntrySize, index: local, at: MxdbgLocalLocValue))

		if first < 0 'beforeTheTable'
			throw MxdbgReadError.windowPastTable(MxdbgWindow.foldedWords, record: local)
		end 'beforeTheTable'

		let words = mxdbgFoldedAggregateWordCount(self.tableWord(self.typeTableOff, stride: MxdbgTypeEntrySize, index: typeId, at: MxdbgTypeKindWord), fieldCount: self.tableWord(self.typeTableOff, stride: MxdbgTypeEntrySize, index: typeId, at: MxdbgTypeFieldCount))
		try self.requireWindowFits(first as MxdbgIndex, count: words, tally: self.constTally, window: MxdbgWindow.foldedWords, record: local)
	end 'requireFoldedWordsFit'

	function requireBelow(names MxdbgIndex, tally MxdbgIndex, reference MxdbgReference, record MxdbgIndex) throws MxdbgReadError
		if names >= tally 'pastTheTable'
			throw MxdbgReadError.danglingReference(reference, record: record, names: names)
		end 'pastTheTable'
	end 'requireBelow'

	function requireWindowFits(first MxdbgIndex, count MxdbgIndex, tally MxdbgIndex, window MxdbgWindow, record MxdbgIndex) throws MxdbgReadError
		if not spanFitsWithin(first as ByteOffset, count: count as BytePos, total: tally as BytePos) 'pastTheTable'
			throw MxdbgReadError.windowPastTable(window, record: record)
		end 'pastTheTable'
	end 'requireWindowFits'

	function tableWord(tableOff ByteOffset, stride ByteOffset, index MxdbgIndex, at ByteOffset) returns MxdbgIndex
		return imageReadU32(self.image, at: tableOff + (index as ByteOffset) * stride + at) as MxdbgIndex
	end 'tableWord'

	export function fileCount() returns MxdbgIndex
		return self.fileTally
	end 'fileCount'

	export function functionCount() returns MxdbgIndex
		return self.funcTally
	end 'functionCount'

	export function lineCount() returns MxdbgIndex
		return self.lineTally
	end 'lineCount'

	// How many source-level TYPES this sidecar describes.
	export function typeCount() returns MxdbgIndex
		return self.typeTally
	end 'typeCount'

	export function fieldCount() returns MxdbgIndex
		return self.fieldTally
	end 'fieldCount'

	export function localCount() returns MxdbgIndex
		return self.localTally
	end 'localCount'

	// How many coverage points this binary was instrumented with. ZERO on any build that was not
	// `--coverage`, which a report refuses by name rather than presenting as `0/0 lines covered`.
	export function coveragePointCount() returns MxdbgIndex
		return self.covTally
	end 'coveragePointCount'

	export function inlineSiteCount() returns MxdbgIndex
		return self.inlineSiteTally
	end 'inlineSiteCount'

	export function inlineRangeCount() returns MxdbgIndex
		return self.inlineRangeTally
	end 'inlineRangeCount'

	export function constantWordCount() returns MxdbgIndex
		return self.constTally
	end 'constantWordCount'

	export function constantWord(index MxdbgIndex) returns MxdbgLocValue
		if index >= self.constTally 'noSuchWord'
			panic("MxdbgReader.constantWord: word {index} is past the sidecar's {self.constTally} — every caller bounds itself by the window its local record names")
		end 'noSuchWord'

		return mxdbgSignedWord(self.tableWord(self.constTableOff, stride: MxdbgConstEntrySize, index: index, at: MxdbgConstWord))
	end 'constantWord'

	export function inlineSite(index MxdbgIndex) returns MxdbgInlineSiteInfo
		if index >= self.inlineSiteTally 'noSuchSite'
			panic("MxdbgReader.inlineSite: site {index} is past the sidecar's {self.inlineSiteTally} — every caller bounds itself by `inlineSiteCount` or by a lookup this reader answered")
		end 'noSuchSite'

		let rec = self.inlineSiteTableOff + (index * MxdbgInlineSiteEntrySize) as ByteOffset
		let callFileId = imageReadU32(self.image, at: rec + MxdbgInlineSiteCallFileId) as MxdbgIndex
		let call = MxdbgCallPosition.none if callFileId == MxdbgNoSourceFile else MxdbgCallPosition.at(self.fileName(callFileId), line: imageReadU32(self.image, at: rec + MxdbgInlineSiteCallLine) as MxdbgIndex, column: imageReadU32(self.image, at: rec + MxdbgInlineSiteCallCol) as MxdbgIndex)

		return MxdbgInlineSiteInfo.create(self.poolString(imageReadU32(self.image, at: rec + MxdbgInlineSiteNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgInlineSiteNameLen) as BytePos), parent: inlineSiteLookupOf(imageReadU32(self.image, at: rec + MxdbgInlineSiteParent) as MxdbgIndex), call: call, origin: validatedOrigin(imageReadU32(self.image, at: rec + MxdbgInlineSiteOrigin) as MxdbgIndex))
	end 'inlineSite'

	// The innermost spliced body `codeOffset` lies in, or none — a binary search over ranges that are
	// disjoint and ascend, so the greatest start not past the offset is the only candidate.
	export function inlineSiteContaining(codeOffset MxdbgCodeOffset) returns MxdbgInlineSiteLookup
		var lo = 0 as MxdbgIndex
		var hi = self.inlineRangeTally

		while lo < hi 'partition'
			let mid = lo + ((hi - lo) shr 1)

			if (self.inlineRangeField(mid, field: MxdbgInlineRangeCodeStart) as MxdbgCodeOffset) > codeOffset 'startsPastIt'
				hi = mid
			end 'startsPastIt' else 'startsAtOrBeforeIt'
				lo = mid + 1
			end 'startsAtOrBeforeIt'
		end 'partition'

		if lo == 0 'beforeEveryRange'
			return MxdbgInlineSiteLookup.none
		end 'beforeEveryRange'

		if codeOffset >= (self.inlineRangeField(lo - 1, field: MxdbgInlineRangeCodeEnd) as MxdbgCodeOffset) 'inAGap'
			return MxdbgInlineSiteLookup.none
		end 'inAGap'

		return MxdbgInlineSiteLookup.site(self.inlineRangeField(lo - 1, field: MxdbgInlineRangeSite))
	end 'inlineSiteContaining'

	export function inlineRangeStart(index MxdbgIndex) returns MxdbgCodeOffset
		return self.boundedInlineRangeField(index, field: MxdbgInlineRangeCodeStart) as MxdbgCodeOffset
	end 'inlineRangeStart'

	export function inlineRangeEnd(index MxdbgIndex) returns MxdbgCodeOffset
		return self.boundedInlineRangeField(index, field: MxdbgInlineRangeCodeEnd) as MxdbgCodeOffset
	end 'inlineRangeEnd'

	export function inlineRangeSite(index MxdbgIndex) returns MxdbgIndex
		return self.boundedInlineRangeField(index, field: MxdbgInlineRangeSite)
	end 'inlineRangeSite'

	function boundedInlineRangeField(index MxdbgIndex, field ByteOffset) returns MxdbgIndex
		if index >= self.inlineRangeTally 'noSuchRange'
			panic("MxdbgReader: inline range {index} is past the sidecar's {self.inlineRangeTally} — every caller bounds itself by `inlineRangeCount`")
		end 'noSuchRange'

		return self.inlineRangeField(index, field: field)
	end 'boundedInlineRangeField'

	export function inlineSitesCalledAt(fileIds MxdbgIndexArray, line MxdbgIndex) returns MxdbgIndexArray
		var sites = MxdbgIndexArray.create()

		for site in 0 upto self.inlineSiteTally 'eachSite'
			if self.tableWord(self.inlineSiteTableOff, stride: MxdbgInlineSiteEntrySize, index: site, at: MxdbgInlineSiteCallLine) != line 'anotherLine'
				continue
			end 'anotherLine'

			if fileIds.contains(self.tableWord(self.inlineSiteTableOff, stride: MxdbgInlineSiteEntrySize, index: site, at: MxdbgInlineSiteCallFileId)) 'calledFromThisFile'
				sites.push(site as MxdbgIndex)
			end 'calledFromThisFile'
		end 'eachSite'

		return sites
	end 'inlineSitesCalledAt'

	function inlineRangeField(index MxdbgIndex, field ByteOffset) returns MxdbgIndex
		return self.tableWord(self.inlineRangeTableOff, stride: MxdbgInlineRangeEntrySize, index: index, at: field)
	end 'inlineRangeField'

	export function typeRecord(index MxdbgIndex) returns MxdbgTypeInfo
		if index >= self.typeTally 'noSuchType'
			panic("MxdbgReader.typeRecord: type {index} is past the sidecar's {self.typeTally} — every caller bounds itself by `typeCount`")
		end 'noSuchType'

		let rec = self.typeTableOff + (index * MxdbgTypeEntrySize) as ByteOffset

		return MxdbgTypeInfo.create(self.poolString(imageReadU32(self.image, at: rec + MxdbgTypeNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgTypeNameLen) as BytePos), kind: imageReadU32(self.image, at: rec + MxdbgTypeKindWord) as MxdbgIndex, size: imageReadU32(self.image, at: rec + MxdbgTypeSize) as MxdbgIndex, align: imageReadU32(self.image, at: rec + MxdbgTypeAlign) as MxdbgIndex, fieldFirst: imageReadU32(self.image, at: rec + MxdbgTypeFieldFirst) as MxdbgIndex, fieldCount: imageReadU32(self.image, at: rec + MxdbgTypeFieldCount) as MxdbgIndex, elementTypeId: imageReadU32(self.image, at: rec + MxdbgTypeElementTypeId) as MxdbgIndex, flags: imageReadU32(self.image, at: rec + MxdbgTypeFlags) as MxdbgIndex)
	end 'typeRecord'

	export function fieldRecord(index MxdbgIndex) returns MxdbgFieldInfo
		if index >= self.fieldTally 'noSuchField'
			panic("MxdbgReader.fieldRecord: field {index} is past the sidecar's {self.fieldTally} — every caller bounds itself by `fieldCount` or by a type's field window")
		end 'noSuchField'

		let rec = self.fieldTableOff + (index * MxdbgFieldEntrySize) as ByteOffset

		return MxdbgFieldInfo.create(self.poolString(imageReadU32(self.image, at: rec + MxdbgFieldNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgFieldNameLen) as BytePos), offset: imageReadU32(self.image, at: rec + MxdbgFieldOffset) as MxdbgIndex, typeId: imageReadU32(self.image, at: rec + MxdbgFieldTypeId) as MxdbgIndex)
	end 'fieldRecord'

	export function localRecord(index MxdbgIndex) returns MxdbgLocalInfo
		let rec = self.localRecordAt(index)

		return MxdbgLocalInfo.create(self.poolString(imageReadU32(self.image, at: rec + MxdbgLocalNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgLocalNameLen) as BytePos), locKind: imageReadU32(self.image, at: rec + MxdbgLocalLocKind) as MxdbgIndex, locValue: mxdbgSignedWord(imageReadU32(self.image, at: rec + MxdbgLocalLocValue) as MxdbgIndex), typeId: imageReadU32(self.image, at: rec + MxdbgLocalTypeId) as MxdbgIndex, scopeStart: imageReadU32(self.image, at: rec + MxdbgLocalScopeStart) as MxdbgCodeOffset, scopeEnd: imageReadU32(self.image, at: rec + MxdbgLocalScopeEnd) as MxdbgCodeOffset, flags: imageReadU32(self.image, at: rec + MxdbgLocalFlags) as MxdbgIndex, site: inlineSiteLookupOf(imageReadU32(self.image, at: rec + MxdbgLocalSite) as MxdbgIndex))
	end 'localRecord'

	export function localBelongsTo(index MxdbgIndex, site MxdbgInlineSiteLookup) returns bool
		let written = imageReadU32(self.image, at: self.localRecordAt(index) + MxdbgLocalSite) as MxdbgIndex

		return match site 'which'
			none gives written == MxdbgNoInlineSite
			site(wanted) gives written == wanted
		end 'which'
	end 'localBelongsTo'

	function localRecordAt(index MxdbgIndex) returns ByteOffset
		if index >= self.localTally 'noSuchLocal'
			panic("MxdbgReader.localRecord: local {index} is past the sidecar's {self.localTally} — every caller bounds itself by `localCount` or by a function's local window")
		end 'noSuchLocal'

		return self.localTableOff + (index * MxdbgLocalEntrySize) as ByteOffset
	end 'localRecordAt'

	export function coveragePoint(index MxdbgIndex) returns MxdbgCovPointInfo
		if index >= self.covTally 'noSuchPoint'
			panic("MxdbgReader.coveragePoint: point {index} is past the sidecar's {self.covTally} — every caller bounds itself by `coveragePointCount`")
		end 'noSuchPoint'

		let rec = self.covTableOff + (index * MxdbgCovEntrySize) as ByteOffset

		return MxdbgCovPointInfo.create(self.fileName(imageReadU32(self.image, at: rec + MxdbgCovFileId) as MxdbgIndex), line: imageReadU32(self.image, at: rec + MxdbgCovLine) as MxdbgIndex, column: imageReadU32(self.image, at: rec + MxdbgCovCol) as MxdbgIndex, branchLine: imageReadU32(self.image, at: rec + MxdbgCovBranchLine) as MxdbgIndex, branchColumn: imageReadU32(self.image, at: rec + MxdbgCovBranchCol) as MxdbgIndex, flags: imageReadU32(self.image, at: rec + MxdbgCovFlags) as MxdbgIndex)
	end 'coveragePoint'

	export function fileName(fileId MxdbgIndex) returns String
		if fileId >= self.fileTally 'noSuchFile'
			panic("MxdbgReader.fileName: file {fileId} is past the sidecar's {self.fileTally} — every id a record names was checked against the file table when the image was opened, and every other caller bounds itself by `fileCount`")
		end 'noSuchFile'

		let rec = self.fileTableOff + (fileId * MxdbgFileEntrySize) as ByteOffset

		return self.poolString(imageReadU32(self.image, at: rec + MxdbgFileNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgFileNameLen) as BytePos)
	end 'fileName'

	export function functionRecord(index MxdbgIndex) returns MxdbgFunctionInfo
		if index >= self.funcTally 'noSuchFunction'
			panic("MxdbgReader.functionRecord: function {index} is past the sidecar's {self.funcTally} — every caller bounds itself by `functionCount`")
		end 'noSuchFunction'

		let rec = self.funcTableOff + (index * MxdbgFuncEntrySize) as ByteOffset

		return MxdbgFunctionInfo.create(self.poolString(imageReadU32(self.image, at: rec + MxdbgFuncNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgFuncNameLen) as BytePos), codeStart: imageReadU32(self.image, at: rec + MxdbgFuncCodeStart) as MxdbgCodeOffset, codeEnd: imageReadU32(self.image, at: rec + MxdbgFuncCodeEnd) as MxdbgCodeOffset, frameSize: imageReadU32(self.image, at: rec + MxdbgFuncFrameSize) as MxdbgIndex, paramCount: imageReadU32(self.image, at: rec + MxdbgFuncParamCount) as MxdbgIndex, lineFirst: imageReadU32(self.image, at: rec + MxdbgFuncLineFirst) as MxdbgIndex, lineCount: imageReadU32(self.image, at: rec + MxdbgFuncLineCount) as MxdbgIndex, localFirst: imageReadU32(self.image, at: rec + MxdbgFuncLocalFirst) as MxdbgIndex, localCount: imageReadU32(self.image, at: rec + MxdbgFuncLocalCount) as MxdbgIndex, displayName: self.poolString(imageReadU32(self.image, at: rec + MxdbgFuncDisplayNameOff) as ByteOffset, length: imageReadU32(self.image, at: rec + MxdbgFuncDisplayNameLen) as BytePos), origin: validatedOrigin(imageReadU32(self.image, at: rec + MxdbgFuncOrigin) as MxdbgIndex))
	end 'functionRecord'

	export function lineRecord(index MxdbgIndex) returns MxdbgLineInfo
		if index >= self.lineTally 'noSuchRow'
			panic("MxdbgReader.lineRecord: row {index} is past the sidecar's {self.lineTally} — every caller bounds itself by `lineCount` or by a function's line window")
		end 'noSuchRow'

		let rec = self.lineTableOff + (index * MxdbgLineEntrySize) as ByteOffset

		return MxdbgLineInfo.create(imageReadU32(self.image, at: rec + MxdbgLineCodeOffset) as MxdbgCodeOffset, file: self.fileName(imageReadU32(self.image, at: rec + MxdbgLineFileId) as MxdbgIndex), line: imageReadU32(self.image, at: rec + MxdbgLineLine) as MxdbgIndex, column: imageReadU32(self.image, at: rec + MxdbgLineCol) as MxdbgIndex, flags: imageReadU32(self.image, at: rec + MxdbgLineFlags) as MxdbgIndex)
	end 'lineRecord'

	// The function whose `.text` range contains `codeOffset`, or none in a gap — padding, or the
	// symbol table the backends append past the last chunk. `parse` refuses overlapping function
	// ranges, so the greatest code start not past the offset is the only candidate.
	export function functionContaining(codeOffset MxdbgCodeOffset) returns MxdbgFunctionLookup
		var lo = 0 as MxdbgIndex
		var hi = self.funcOrder.count() as MxdbgIndex

		while lo < hi 'partition'
			let mid = lo + ((hi - lo) shr 1)

			if self.funcCodeStartAt(mid) > codeOffset 'startsPastIt'
				hi = mid
			end 'startsPastIt' else 'startsAtOrBeforeIt'
				lo = mid + 1
			end 'startsAtOrBeforeIt'
		end 'partition'

		if lo == 0 'beforeEveryFunction'
			return MxdbgFunctionLookup.none
		end 'beforeEveryFunction'

		let candidate = try self.funcOrder.get(lo - 1) otherwise panic("MxdbgReader.functionContaining: the partition point {lo} is inside a list of {self.funcOrder.count()} indices")
		let rec = self.funcTableOff + (candidate * MxdbgFuncEntrySize) as ByteOffset

		if codeOffset >= (imageReadU32(self.image, at: rec + MxdbgFuncCodeEnd) as MxdbgCodeOffset) 'inAGap'
			return MxdbgFunctionLookup.none
		end 'inAGap'

		return MxdbgFunctionLookup.found(self.functionRecord(candidate))
	end 'functionContaining'

	// One function's code start WITHOUT decoding its name, which is what keeps the probe path above
	// free of the string materialization the range test never reads.
	function funcCodeStartAt(position MxdbgIndex) returns MxdbgCodeOffset
		let index = try self.funcOrder.get(position) otherwise panic("MxdbgReader.funcCodeStartAt: position {position} is inside a list of {self.funcOrder.count()} indices")

		return funcCodeStartOf(self.image, tableOff: self.funcTableOff, index: index)
	end 'funcCodeStartAt'

	// The source position of `codeOffset`: the last row at or before it inside the enclosing function.
	// None when no function covers the offset, or when the function has no row at or before it — which
	// is the honest answer at a prologue, where no statement has begun.
	export function pcToLine(codeOffset MxdbgCodeOffset) returns MxdbgLineLookup
		match self.functionContaining(codeOffset) 'enclosing'
			none then return MxdbgLineLookup.none
			found(fn) then return self.lastRowAtOrBefore(fn, codeOffset: codeOffset)
		end 'enclosing'
	end 'pcToLine'

	export function statementRowsOf(fileIds MxdbgIndexArray, line MxdbgIndex) returns MxdbgLineInfoArray
		var rows = MxdbgLineInfoArray.create()

		if fileIds.count() == 0 'noFileNamed'
			return rows
		end 'noFileNamed'

		for i in 0 upto self.lineTally 'eachRow'
			if (self.tableWord(self.lineTableOff, stride: MxdbgLineEntrySize, index: i, at: MxdbgLineFlags) and MxdbgLineFlagStatement) == 0 'notAStatement'
				continue
			end 'notAStatement'

			if self.tableWord(self.lineTableOff, stride: MxdbgLineEntrySize, index: i, at: MxdbgLineLine) != line or not fileIds.contains(self.tableWord(self.lineTableOff, stride: MxdbgLineEntrySize, index: i, at: MxdbgLineFileId)) 'anotherLine'
				continue
			end 'anotherLine'

			rows.push(self.lineRecord(i as MxdbgIndex))
		end 'eachRow'

		return rows
	end 'statementRowsOf'

	// The offset to look up for a code offset that is a RETURN address, stated once for every walker. A
	// return address is the instruction after the call, so resolving it unbiased names the next line — and
	// where the call is a function's last instruction, the next FUNCTION.
	export static function callSiteLookup(codeOffset MxdbgCodeOffset) returns MxdbgCodeOffset
		return codeOffset - ReturnAddrSymbolBias if codeOffset > 0 else codeOffset
	end 'callSiteLookup'

	function lastRowAtOrBefore(fn MxdbgFunctionInfo, codeOffset MxdbgCodeOffset) returns MxdbgLineLookup
		var best = MxdbgLineLookup.none

		for i in fn.lineFirst upto fn.lineFirst + fn.lineCount 'eachRow'
			let row = self.lineRecord(i as MxdbgIndex)

			if row.codeOffset > codeOffset 'pastTheOffset'
				break
			end 'pastTheOffset'

			best = MxdbgLineLookup.found(row)
		end 'eachRow'

		return best
	end 'lastRowAtOrBefore'

	function poolString(offset ByteOffset, length BytePos) returns String
		if length == 0 'theEmptyString'
			return ""
		end 'theEmptyString'

		return String.from(imageSlice(self.image, start: self.stringPoolOff + offset, count: length))
	end 'poolString'
end 'MxdbgReader'

function inlineSiteLookupOf(raw MxdbgIndex) returns MxdbgInlineSiteLookup
	return MxdbgInlineSiteLookup.none if raw == MxdbgNoInlineSite else MxdbgInlineSiteLookup.site(raw)
end 'inlineSiteLookupOf'

// The function table's indices sorted by code start, so `functionContaining` can partition them. Built at
// parse rather than on first use: a `MxdbgReader` is held through a `let` at every reader in this tree, so
// a lazily-filled field could not be written through one (E3063).
function functionOrderByCodeStart(image ByteArray, tableOff ByteOffset, tally MxdbgIndex) returns MxdbgFuncOrder
	var order = MxdbgFuncOrder.create()

	for i in 0 upto tally 'each'
		order.push(i as MxdbgIndex)
	end 'each'

	order.sort(function(left MxdbgIndex, right MxdbgIndex) gives funcCodeStartOf(image, tableOff: tableOff, index: left).compare(funcCodeStartOf(image, tableOff: tableOff, index: right)))

	return order
end 'functionOrderByCodeStart'

function funcCodeStartOf(image ByteArray, tableOff ByteOffset, index MxdbgIndex) returns MxdbgCodeOffset
	return imageReadU32(image, at: tableOff + (index * MxdbgFuncEntrySize + MxdbgFuncCodeStart) as ByteOffset) as MxdbgCodeOffset
end 'funcCodeStartOf'
