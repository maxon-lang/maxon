// Compiler/Debug/MxdbgFormat.maxon — the `.mxdbg` sidecar's byte layout.
//
// Position-independent, little-endian, mmap-friendly: a fixed header carrying absolute
// `(offset, count)` for each section, then arrays of fixed-width records, then one shared string
// pool addressed by `(offset, len)`. The line table is a fixed 20-byte stride, not delta-encoded,
// because the reader binary-searches it.
//
// The header slot order is not the section order: the slots run … lines, locals, types, coverage,
// fields; the sections run … lines, types, fields, locals, coverage. Matching one and not the other
// yields a file that loads and reads every later record as garbage.

// `MXDBG\0\0\0`, 8 bytes so the header stays 4/8-byte aligned. A reader that does not see this refuses
// the file. Written as codes rather than as a string literal because the trailing NULs are part of it.
let MxdbgMagicByte0 = 77
let MxdbgMagicByte1 = 88
let MxdbgMagicByte2 = 68
let MxdbgMagicByte3 = 66
let MxdbgMagicByte4 = 71

// Bumped on any change to what the file MEANS. A reader refuses a version it does not know rather than
// misreading it.
module let MxdbgFormatVersion = 7

// Appended to the binary's path WITH its extension still on: `foo.exe` -> `foo.exe.mxdbg`.
export let MxdbgSidecarExtension = ".mxdbg"

module let MxdbgOffVersion = 8

module let MxdbgOffReserved = 12

module let MxdbgOffBuildId = 16

module let MxdbgOffTripleOff = 24

module let MxdbgOffTripleLen = 28

module let MxdbgOffStringPoolOff = 32

module let MxdbgOffStringPoolSize = 36

module let MxdbgOffFileTableOff = 40

module let MxdbgOffFileCount = 44

export let MxdbgOffFuncTableOff = 48

module let MxdbgOffFuncCount = 52

export let MxdbgOffLineTableOff = 56

module let MxdbgOffLineCount = 60

export let MxdbgOffLocalTableOff = 64

module let MxdbgOffLocalCount = 68

module let MxdbgOffTypeTableOff = 72

module let MxdbgOffTypeCount = 76

module let MxdbgOffCovTableOff = 80

module let MxdbgOffCovCount = 84

export let MxdbgOffFieldTableOff = 88

module let MxdbgOffFieldCount = 92

// The inline sites and the code ranges under them: the sidecar's counterpart of `BacktraceFormat`'s
// `__inlframes`.
export let MxdbgOffInlineSiteTableOff = 96

module let MxdbgOffInlineSiteCount = 100

export let MxdbgOffInlineRangeTableOff = 104

module let MxdbgOffInlineRangeCount = 108

module let MxdbgOffConstTableOff = 112

module let MxdbgOffConstCount = 116

module let MxdbgOffSourceRootOff = 120

module let MxdbgOffSourceRootLen = 124

module let MxdbgHeaderSize = 128

module let MxdbgFileEntrySize = 8

module let MxdbgFileNameOff = 0

module let MxdbgFileNameLen = 4

export let MxdbgFuncEntrySize = 52

export let MxdbgLineEntrySize = 20

module let MxdbgTypeEntrySize = 36

export let MxdbgFieldEntrySize = 16

export let MxdbgLocalEntrySize = 36

// codeOffset fileId line col branchLine branchCol funcNameOff funcNameLen flags. A point's COUNTER
// INDEX is its record index, which is what binds this table to the `.mxcov` counter array
// position-for-position.
module let MxdbgCovEntrySize = 36

export let MxdbgInlineSiteEntrySize = 28

// Disjoint and ascending by `codeStart`; nesting lives in the site's `parent`.
export let MxdbgInlineRangeEntrySize = 12

module let MxdbgConstEntrySize = 4

module let MxdbgConstWord = 0

export let MxdbgNoInlineSite = 0xFFFFFFFF as MxdbgIndex

export let MxdbgNoSourceFile = 0xFFFFFFFF as MxdbgIndex

export let MxdbgNoElementType = 0xFFFFFFFF as MxdbgIndex

// Line-row flag bits. A row this compiler writes is always a statement boundary — see
// `DebugLineRowBuilder`, which is where that granularity is decided.
export let MxdbgLineFlagStatement = 1

// This row's source line is one a `--coverage` build COUNTS. Whether the counter increment sits AT the
// row's own offset or immediately ahead of it depends on whether the writer gives a counter the
// statement's span, so the dump reads this FLAG rather than inferring it from the offset.
export let MxdbgLineFlagCoverage = 2

// Control enters the row's source line here from another line; `DebugLineRowBuilder.note`
// decides it.
export let MxdbgLineFlagLineEntry = 4

// ⭐ **COVERAGE-POINT FLAG BITS. KIND AND STATE ARE ONE WORD BECAUSE THEY ARE ONE FACT ABOUT A POINT:**
// what the source construct is, and whether the compiler emitted code for it.
export let MxdbgCovFlagStatement = 1

export let MxdbgCovFlagArmThen = 2

export let MxdbgCovFlagArmElse = 4

// Set WITH `MxdbgCovFlagArmElse` for the arm the source does not write (`if c 'l' … end 'l'`).
// Instrumenting it is the whole reason a report can say "the false arm ran 4 times": the line table has
// no row for an arm that has no source text, and never can.
export let MxdbgCovFlagArmImplicit = 8

// No code was emitted for this point — the optimizer removed the code it anchored. Distinct from a zero
// counter, which means real code that never ran.
module let MxdbgCovFlagEliminated = 16

// One arm of a user `match`. ⛔ There is deliberately NO implicit counterpart: an `if` with no `else`
// still takes a false edge, so that arm exists and is instrumented, whereas Maxon's `match` is
// exhaustive and the fall-through past its last arm is unreachable. A flag that would always read the
// same value is not a fact, it is the same fact written twice.
export let MxdbgCovFlagArmCase = 32

module let MxdbgCovCodeOffset = 0

module let MxdbgCovFileId = 4

module let MxdbgCovLine = 8

module let MxdbgCovCol = 12

module let MxdbgCovBranchLine = 16

module let MxdbgCovBranchCol = 20

// The owning function is named by STRING rather than by a funcId into the function table, because an
// ELIMINATED point's function is not in that table at all and a funcId would have to be a sentinel
// pointing at some unrelated function.
module let MxdbgCovFuncNameOff = 24

module let MxdbgCovFuncNameLen = 28

module let MxdbgCovFlags = 32

module let MxdbgFuncNameOff = 0

export let MxdbgFuncNameLen = 4

export let MxdbgFuncCodeStart = 8

export let MxdbgFuncCodeEnd = 12

module let MxdbgFuncFrameSize = 16

module let MxdbgFuncParamCount = 20

module let MxdbgFuncLineFirst = 24

export let MxdbgFuncLineCount = 28

module let MxdbgFuncLocalFirst = 32

module let MxdbgFuncLocalCount = 36

module let MxdbgFuncDisplayNameOff = 40

module let MxdbgFuncDisplayNameLen = 44

module let MxdbgFuncOrigin = 48

module let MxdbgTypeNameOff = 0

module let MxdbgTypeNameLen = 4

module let MxdbgTypeKindWord = 8

module let MxdbgTypeSize = 12

module let MxdbgTypeAlign = 16

module let MxdbgTypeFieldFirst = 20

module let MxdbgTypeFieldCount = 24

module let MxdbgTypeElementTypeId = 28

module let MxdbgTypeFlags = 32

module let MxdbgFieldNameOff = 0

module let MxdbgFieldNameLen = 4

module let MxdbgFieldOffset = 8

export let MxdbgFieldTypeId = 12

module let MxdbgLocalNameOff = 0

module let MxdbgLocalNameLen = 4

export let MxdbgLocalLocKind = 8

module let MxdbgLocalLocValue = 12

export let MxdbgLocalTypeId = 16

export let MxdbgLocalScopeStart = 20

module let MxdbgLocalScopeEnd = 24

module let MxdbgLocalFlags = 28

module let MxdbgLocalSite = 32

module let MxdbgInlineSiteNameOff = 0

module let MxdbgInlineSiteNameLen = 4

export let MxdbgInlineSiteParent = 8

export let MxdbgInlineSiteCallFileId = 12

module let MxdbgInlineSiteCallLine = 16

module let MxdbgInlineSiteCallCol = 20

module let MxdbgInlineSiteOrigin = 24

export let MxdbgInlineRangeCodeStart = 0

module let MxdbgInlineRangeCodeEnd = 4

module let MxdbgInlineRangeSite = 8

export let MxdbgLineCodeOffset = 0

module let MxdbgLineFileId = 4

module let MxdbgLineLine = 8

module let MxdbgLineCol = 12

module let MxdbgLineFlags = 16

// An index into one of the sidecar's tables.
export typealias MxdbgIndex = int(0 to u32.max)

// A `.text` code offset as the sidecar records one.
export typealias MxdbgCodeOffset = int(0 to u32.max)

export typealias MxdbgCodeOffsetArray = Array with MxdbgCodeOffset
export typealias MxdbgIndexArray = Array with MxdbgIndex

// A local record's `locValue`: a stack displacement, a register number, or unused, per its `locKind`.
export typealias MxdbgLocValue = int(i32.min to i32.max)

// ⭐ **WHAT A TYPE RECORD'S `kind` WORD SAYS.** A renderer decides how
// to read the bytes at a local's location from this word alone, so a kind a reader does not know must
// reach it as the raw number rather than be folded into one it does.
//
// `string` and `array` name the fused heap records; `managedRecord` is the 8-byte-pointer catch-all (an
// interface value, a function value, an unresolved type parameter) that exists so a field or a local of
// such a type has a valid `typeId` to point at.
export let MxdbgTypeKindPrimitive = 0 as MxdbgIndex
export let MxdbgTypeKindIntRanged = 1 as MxdbgIndex
export let MxdbgTypeKindFloatRanged = 2 as MxdbgIndex
export let MxdbgTypeKindStruct = 3 as MxdbgIndex
export let MxdbgTypeKindEnum = 4 as MxdbgIndex
export let MxdbgTypeKindUnion = 5 as MxdbgIndex
export let MxdbgTypeKindString = 6 as MxdbgIndex

export let MxdbgTypeKindArray = 7 as MxdbgIndex
export let MxdbgTypeKindManagedRecord = 8 as MxdbgIndex

export let MxdbgLocKindStackSlot = 0 as MxdbgIndex
export let MxdbgLocKindRegister = 1 as MxdbgIndex
export let MxdbgLocKindOptimizedOut = 2 as MxdbgIndex
export let MxdbgLocKindConstant = 3 as MxdbgIndex
export let MxdbgLocKindFoldedAggregate = 4 as MxdbgIndex

export function mxdbgLocKindIsKnown(word MxdbgIndex) returns bool
	return word == MxdbgLocKindStackSlot or word == MxdbgLocKindRegister or word == MxdbgLocKindOptimizedOut or word == MxdbgLocKindConstant or word == MxdbgLocKindFoldedAggregate
end 'mxdbgLocKindIsKnown'

export function mxdbgNoneOrBelow(index MxdbgIndex, none MxdbgIndex, bound MxdbgIndex) returns bool
	return index == none or index < bound
end 'mxdbgNoneOrBelow'

export function mxdbgRowIsInside(offset MxdbgCodeOffset, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset) returns bool
	return offset >= codeStart and offset < codeEnd
end 'mxdbgRowIsInside'

export function mxdbgRowFollows(offset MxdbgCodeOffset, previousRow MxdbgCodeOffset) returns bool
	return offset >= previousRow
end 'mxdbgRowFollows'

export function mxdbgCodeRangeFollows(codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, previousEnd MxdbgCodeOffset) returns bool
	return codeStart < codeEnd and codeStart >= previousEnd
end 'mxdbgCodeRangeFollows'

export function mxdbgFunctionRangeFollows(codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, previousEnd MxdbgCodeOffset) returns bool
	return codeStart <= codeEnd and codeStart >= previousEnd
end 'mxdbgFunctionRangeFollows'

export function mxdbgScopeIsInside(scopeStart MxdbgCodeOffset, scopeEnd MxdbgCodeOffset, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset) returns bool
	return scopeStart < scopeEnd and scopeStart >= codeStart and scopeEnd <= codeEnd
end 'mxdbgScopeIsInside'

export let MxdbgLocalFlagIndirect = 1 as MxdbgIndex

export enum MxdbgOrigin
	authored
	test
	generated
	library
	synthesized
end 'MxdbgOrigin'

let MxdbgOriginWordAuthored = 0 as MxdbgIndex
let MxdbgOriginWordTest = 1 as MxdbgIndex
let MxdbgOriginWordGenerated = 2 as MxdbgIndex
let MxdbgOriginWordLibrary = 3 as MxdbgIndex
let MxdbgOriginWordSynthesized = 4 as MxdbgIndex

export union MxdbgOriginLookup
	unknown
	known(origin MxdbgOrigin)
end 'MxdbgOriginLookup'

export function mxdbgOriginWord(origin MxdbgOrigin) returns MxdbgIndex
	return match origin 'which'
		authored gives MxdbgOriginWordAuthored
		test gives MxdbgOriginWordTest
		generated gives MxdbgOriginWordGenerated
		library gives MxdbgOriginWordLibrary
		synthesized gives MxdbgOriginWordSynthesized
	end 'which'
end 'mxdbgOriginWord'

export function mxdbgOriginOfWord(word MxdbgIndex) returns MxdbgOriginLookup
	for origin in MxdbgOrigin.allCases 'eachOrigin'
		if mxdbgOriginWord(origin) == word 'thisOne'
			return MxdbgOriginLookup.known(origin)
		end 'thisOne'
	end 'eachOrigin'

	return MxdbgOriginLookup.unknown
end 'mxdbgOriginOfWord'

export function mxdbgOriginIsTheAuthors(origin MxdbgOrigin) returns bool
	return origin == MxdbgOrigin.authored or origin == MxdbgOrigin.test
end 'mxdbgOriginIsTheAuthors'

// Signedness is a property of the declared type and cannot be recovered from the bits, so a reader
// without this flag renders a narrow signed local as the unsigned pattern it holds.
export let MxdbgTypeFlagSigned = 1 as MxdbgIndex

export let MxdbgUnionAggregateWords = 2 as MxdbgIndex

export function mxdbgFoldedAggregateWordCount(typeKind MxdbgIndex, fieldCount MxdbgIndex) returns MxdbgIndex
	if typeKind == MxdbgTypeKindStruct 'aStruct'
		return fieldCount
	end 'aStruct'

	if typeKind == MxdbgTypeKindUnion 'aUnion'
		return MxdbgUnionAggregateWords
	end 'aUnion'

	return 0
end 'mxdbgFoldedAggregateWordCount'

export function mxdbgTypeKindIsIndirect(kind MxdbgIndex) returns bool
	return kind == MxdbgTypeKindStruct or kind == MxdbgTypeKindUnion or kind == MxdbgTypeKindString or kind == MxdbgTypeKindArray or kind == MxdbgTypeKindManagedRecord
end 'mxdbgTypeKindIsIndirect'

// The word a type record's kind renders as. A kind this build does not know renders as its NUMBER, which
// is the only honest answer for a file some other writer made.
export function mxdbgTypeKindName(kind MxdbgIndex) returns String
	if kind == MxdbgTypeKindPrimitive 'primitive'
		return "Primitive"
	end 'primitive'

	if kind == MxdbgTypeKindIntRanged 'intRanged'
		return "IntRanged"
	end 'intRanged'

	if kind == MxdbgTypeKindFloatRanged 'floatRanged'
		return "FloatRanged"
	end 'floatRanged'

	if kind == MxdbgTypeKindStruct 'struct'
		return "Struct"
	end 'struct'

	if kind == MxdbgTypeKindEnum 'enumeration'
		return "Enum"
	end 'enumeration'

	if kind == MxdbgTypeKindUnion 'union'
		return "Union"
	end 'union'

	if kind == MxdbgTypeKindString 'string'
		return "String"
	end 'string'

	if kind == MxdbgTypeKindArray 'array'
		return "Array"
	end 'array'

	return "ManagedRecord" if kind == MxdbgTypeKindManagedRecord else "{kind}"
end 'mxdbgTypeKindName'

let MxdbgSignedWordMax = i32.max as MxdbgIndex
let MxdbgWordModulus = 4294967296

// ⚠ **A `locValue` IS A SIGNED i32 STORED AS ITS TWO'S-COMPLEMENT u32.** A stack slot BELOW the frame
// pointer is a negative displacement, and reading that word unsigned places it 4 GB above instead.
module function mxdbgSignedWord(raw MxdbgIndex) returns MxdbgLocValue
	if raw > MxdbgSignedWordMax 'negative'
		return (raw - MxdbgWordModulus) as MxdbgLocValue
	end 'negative'

	return raw as MxdbgLocValue
end 'mxdbgSignedWord'

// The u32 word a `locValue` is STORED as — `mxdbgSignedWord`'s inverse, and the other half of the same
// rule: a displacement below the frame pointer is negative, and a word written unsigned places it 4 GB
// above instead.
module function mxdbgLocValueWord(value MxdbgLocValue) returns MxdbgIndex
	if value < 0 'negative'
		return (value + MxdbgWordModulus) as MxdbgIndex
	end 'negative'

	return value as MxdbgIndex
end 'mxdbgLocValueWord'

// Whether `image` opens with the sidecar magic. Split from the reader so a caller can ask before
// paying for a parse.
module function mxdbgMagicMatches(image ByteArray) returns bool
	if image.count() < MxdbgHeaderSize 'tooShort'
		return false
	end 'tooShort'

	return imageByteAt(image, at: 0) == MxdbgMagicByte0 and imageByteAt(image, at: 1) == MxdbgMagicByte1 and imageByteAt(image, at: 2) == MxdbgMagicByte2 and imageByteAt(image, at: 3) == MxdbgMagicByte3 and imageByteAt(image, at: 4) == MxdbgMagicByte4 and imageByteAt(image, at: 5) == 0 and imageByteAt(image, at: 6) == 0 and imageByteAt(image, at: 7) == 0
end 'mxdbgMagicMatches'

// Write the eight magic bytes.
module function writeMxdbgMagic(buf ByteArray)
	buf.push(MxdbgMagicByte0)
	buf.push(MxdbgMagicByte1)
	buf.push(MxdbgMagicByte2)
	buf.push(MxdbgMagicByte3)
	buf.push(MxdbgMagicByte4)
	buf.push(0)
	buf.push(0)
	buf.push(0)
end 'writeMxdbgMagic'
