module type DebugLayoutFigure
	export var name as String
	export var figure as MxdbgRecordFigure

	static function create(name String, figure MxdbgRecordFigure) returns DebugLayoutFigure
		return Self{name: name, figure: figure}
	end 'create'
end 'DebugLayoutFigure'

module typealias DebugLayoutFigureArray = Array with DebugLayoutFigure

export let ImageTextRvaFigureName = "ImageTextRva"

export let MOffCurrentGtFigureName = "MOffCurrentGt"
export let MOffAllNextFigureName = "MOffAllNext"
export let MOffOsThreadIdFigureName = "MOffOsThreadId"
export let MOffOsThreadUniqueIdFigureName = "MOffOsThreadUniqueId"

export let GtOffSpFigureName = "GtOffSp"
export let GtOffFpFigureName = "GtOffFp"
export let GtOffStatusFigureName = "GtOffStatus"
export let GtOffStackBaseFigureName = "GtOffStackBase"
export let GtOffStackSizeFigureName = "GtOffStackSize"
export let GtOffFuncPtrFigureName = "GtOffFuncPtr"
let GtOffStackGuardFigureName = "GtOffStackGuard"
export let GtOffParkKindFigureName = "GtOffParkKind"
let GtOffTibStackBaseFigureName = "GtOffTibStackBase"
export let GtOffHoldFigureName = "GtOffHold"
export let GtStatusCompletedFigureName = "GtStatusCompleted"
export let GtStatusWaitingFigureName = "GtStatusWaiting"
let GtStackGuardPreemptFigureName = "GtStackGuardPreempt"
export let GtHoldReleasedFigureName = "GtHoldReleased"
export let GtHoldRequestedFigureName = "GtHoldRequested"

export let DsOffWriteCursorFigureName = "DsOffWriteCursor"

module function debuggerReadableGlobals() returns StringArray
	var names = StringArray.create()
	names.push(String.from(GtAllGLabel))
	names.push(String.from(GtAllGLenLabel))
	names.push(String.from(GtHoldEpochLabel))
	names.push(String.from(SchedAsyncPreemptOffLabel))
	names.push(String.from(SchedAllMLabel))
	names.push(String.from(SchedProcsLabel))
	names.push(String.from(DsBaseLabel))

	return names
end 'debuggerReadableGlobals'

module function debuggerLayoutFigures() returns DebugLayoutFigureArray
	var out = DebugLayoutFigureArray.create()
	pushLayoutFigure(out, name: MOffCurrentGtFigureName, figure: MOffCurrentGt as MxdbgRecordFigure)
	pushLayoutFigure(out, name: MOffAllNextFigureName, figure: MOffAllNext as MxdbgRecordFigure)
	pushLayoutFigure(out, name: MOffOsThreadIdFigureName, figure: MOffOsThreadId as MxdbgRecordFigure)
	pushLayoutFigure(out, name: MOffOsThreadUniqueIdFigureName, figure: MOffOsThreadUniqueId as MxdbgRecordFigure)

	pushLayoutFigure(out, name: GtOffSpFigureName, figure: GtOffSp as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffFpFigureName, figure: GtOffFp as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffStatusFigureName, figure: GtOffStatus as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffStackBaseFigureName, figure: GtOffStackBase as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffStackSizeFigureName, figure: GtOffStackSize as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffFuncPtrFigureName, figure: GtOffFuncPtr as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffStackGuardFigureName, figure: GtOffStackGuard as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffParkKindFigureName, figure: GtOffParkKind as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffTibStackBaseFigureName, figure: GtOffTibStackBase as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtOffHoldFigureName, figure: GtOffHold as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtStatusCompletedFigureName, figure: GtStatusCompleted as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtStatusWaitingFigureName, figure: GtStatusWaiting as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtStackGuardPreemptFigureName, figure: GtStackGuardPreempt as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtHoldReleasedFigureName, figure: GtHoldReleased as MxdbgRecordFigure)
	pushLayoutFigure(out, name: GtHoldRequestedFigureName, figure: GtHoldRequested as MxdbgRecordFigure)

	pushLayoutFigure(out, name: DsOffWriteCursorFigureName, figure: DsOffWriteCursor as MxdbgRecordFigure)

	return out
end 'debuggerLayoutFigures'

function pushLayoutFigure(out DebugLayoutFigureArray, name String, figure MxdbgRecordFigure)
	out.push(DebugLayoutFigure.create(name, figure: figure))
end 'pushLayoutFigure'
