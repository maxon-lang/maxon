// Compiler/Debug/MxdbgEmit.maxon — write the `<output>.mxdbg` sidecar beside a finished executable.
//
// ⭐⭐ **EVERY INPUT IS A READ-ONLY OBSERVATION OF CODE THAT IS ALREADY EMITTED.** The function ranges
// come off the concat pass, the line rows off the chunks it stitched, the build-id off the `.text` bytes
// themselves. Nothing here can move an instruction, which is what makes
// `tests/debug/byte-identical-debug-info.test.maxon` a structural property rather than a hope.
//
// A write failure is REPORTED AND SWALLOWED, exactly as `MetricsEmit.writeMetrics` and the `.ir` sidecar
// are: debug info is a diagnostic side output, and a build that produced a correct executable must not
// be failed by a full disk under the sidecar path.

// The first REAL source file in a `DebugSpanTable`. Entry `NoDebugFileId` is the positionless file — the
// empty `sourceFilePath` a compiler-emitted function carries — and the sidecar's table holds real paths
// only, which is why its ids run one behind (`sidecarFileIdOf`).
let MxdbgFirstSourceFileId = 1 as DebugFileId

export function writeDebugInfoSidecar(project Project, codeResult CodeResult, outputPath FilePath)
	// The wasm lane emits a whole core module rather than a `.text` image and builds no function chunks,
	// so there is nothing for a `.text`-offset-keyed table to describe. Skipped rather than written empty:
	// a sidecar naming no function is one a driver would refuse anyway, at a step further from the reason.
	if codeResult.debugFunctions.count() == 0 'nothingToDescribe'
		return
	end 'nothingToDescribe'

	var signatures = try queryProgramSignatures(project) otherwise 'noSignatures'
		logError(LogCategory.compiler, message: function() gives "Could not read the program's signatures, so no debug-info sidecar was written beside {outputPath}")
		return
	end 'noSignatures'

	var writer = MxdbgWriter.create()

	// ⭐ **A COVERAGE POINT'S FILE IS REGISTERED BEFORE THE TABLE IS WALKED.** A point OUTLIVES its function
	// — a report must still say "these lines have no code" about a function nothing called — so a file whose
	// every function was pruned still owes its name to the file table the walk below writes. Empty, and so
	// invisible, on every build that was not asked to instrument.
	for point in project.covPoints.points 'eachCoveragePointsFile'
		_ = project.debugSpanTable.fileId(point.filePath)
	end 'eachCoveragePointsFile'

	// ⭐ **THE POSITIONLESS FILE IS NOT A SOURCE FILE AND IS NOT WRITTEN.** Emitting it would put a nameless
	// row at the head of a table the reference driver fills with real paths only, and a sidecar either
	// driver prints has to say the same thing about the same program.
	for fileId in MxdbgFirstSourceFileId upto project.debugSpanTable.fileCount() 'eachFile'
		writer.addFile(project.debugSpanTable.filePath(fileId as DebugFileId))
	end 'eachFile'

	// ⭐ **THE TYPE TABLE IS BUILT BEFORE ANY RECORD POINTS INTO IT.** A local names its type by ID, so
	// every id has to be fixed before the first local record is written.
	let functionsByName = mxdbgFunctionIndex(codeResult.targetModule)
	var types = MxdbgTypeTable.create()
	types.closeDeclaredTypes(project, signatures: signatures)

	for fn in codeResult.debugFunctions 'eachFunctionsTypes'
		match mxdbgFunctionOf(codeResult.targetModule, functionsByName: functionsByName, name: fn.name) 'itsIr'
			none then break 'itsIr'
			found(func) then closeLocalTypes(project, signatures: signatures, types: types, func: func)
		end 'itsIr'
	end 'eachFunctionsTypes'

	types.writeInto(writer)

	for fn in codeResult.debugFunctions 'eachFunction'
		writer.addFunction(String.from(fn.name), codeStart: fn.codeStart as MxdbgCodeOffset, codeEnd: fn.codeEnd as MxdbgCodeOffset, frameSize: fn.frameSize as MxdbgIndex, paramCount: fn.paramCount as MxdbgIndex)

		match mxdbgFunctionOf(codeResult.targetModule, functionsByName: functionsByName, name: fn.name) 'itsIr'
			none then break 'itsIr'
			found(func) then writeFunctionLocals(project, signatures: signatures, writer: writer, types: types, func: func, range: fn)
		end 'itsIr'
	end 'eachFunction'

	// ⭐⭐ **ONE READING OF `covPointOffsets` ANSWERS BOTH COVERAGE QUESTIONS** — which points got code, and
	// which line rows a counter sits on. The two are the same fact seen from the point's side and the row's
	// side, and deriving them separately is how they would come to disagree.
	let emittedPoints = emittedCoveragePointOffsets(codeResult)
	let countedRows = coverageCountedRows(codeResult, emitted: emittedPoints)

	// ⚠ The position is COUNTED rather than read off a `withIterator()` cursor: this loop runs once per
	// statement in the whole program, and that iterator allocates a `(Source, Element)` pair per step — a
	// heap record per row of the line table, for an index an integer already carries.
	var rowIndex = 0 as ElementIndex

	for row in codeResult.debugLineRows 'eachRow'
		writer.addLine(row.codeOffset as MxdbgCodeOffset, fileId: sidecarFileIdOf(project.debugSpanTable.fileIdOf(row.spanId)), line: project.debugSpanTable.lineOf(row.spanId) as MxdbgIndex, column: project.debugSpanTable.columnOf(row.spanId) as MxdbgIndex, flags: lineRowFlags(countedRows, at: rowIndex))
		rowIndex = rowIndex + 1
	end 'eachRow'

	writeCoveragePoints(project, writer: writer, emitted: emittedPoints)
	writeInlineFrames(writer, codeResult: codeResult)

	// The sidecar's build-id, and the `.mxcov`'s: one fold, so a driver joining the two cannot be handed
	// two numbers for one build.
	let image = writer.build(codeBuildId(codeResult.code), targetTriple: targetToString(project.target))

	let sidecarPath = try FilePath.from(sidecarPathOf(outputPath)) otherwise 'badPath'
		logError(LogCategory.compiler, message: function() gives "Could not spell the debug-info sidecar path for {outputPath}")
		return
	end 'badPath'

	try File.writeBinary(sidecarPath, content: image) otherwise 'writeErr'
		logError(LogCategory.compiler, message: function() gives "Failed to write the debug-info sidecar to {sidecarPath}")
		return
	end 'writeErr'

	logInfo(LogCategory.compiler, message: function() gives "Wrote {image.count()} bytes of debug info to {sidecarPath}")
end 'writeDebugInfoSidecar'

// The rows concat wrote into `__inlframes`, spelled the sidecar's way, so the profiler names the spliced
// body a sample landed in exactly as the panic runtime names the one a frame sits in.
function writeInlineFrames(writer MxdbgWriter, codeResult CodeResult)
	for site in codeResult.inlineSites 'eachSite'
		let parent = match site.parent 'p'
			none gives MxdbgNoParentSite
			site(index) gives index as MxdbgIndex
		end 'p'

		writer.addInlineSite(String.from(site.calleeName), parent: parent)
	end 'eachSite'

	for range in codeResult.inlineRanges 'eachRange'
		writer.addInlineRange(range.codeStart as MxdbgCodeOffset, codeEnd: range.codeEnd as MxdbgCodeOffset, site: range.site as MxdbgIndex)
	end 'eachRange'
end 'writeInlineFrames'

// ============================================================================================
// COVERAGE POINTS
// ============================================================================================

// A point's counter index -> where its increment landed in `.text`. A point ABSENT from it got no code at
// all, which is the ELIMINATED state — a different fact from a zero counter (real code that never ran).
typealias CovPointOffsetMap = Map with (CovPointId, MxdbgCodeOffset)

// A source path -> the id the SIDECAR's file table gives it, which is one behind the span table's.
typealias SidecarFileIdMap = Map with (String, MxdbgIndex)

// What an eliminated point's record carries where an offset would be. Zero rather than a sentinel: the
// flag is what says the field means nothing, and a reader that ignored the flag would be just as wrong
// about a real offset.
let NoCoverageCodeOffset = 0 as MxdbgCodeOffset

// ⚠ **THE FIRST OFFSET FILED FOR A POINT IS THE POINT'S.** A monomorphized generic body is emitted once
// per specialization and every copy steps the ONE counter its source text owns, so a later copy's offset
// describes the same point at a second address — and a record can carry one.
function emittedCoveragePointOffsets(codeResult CodeResult) returns CovPointOffsetMap
	var offsets = CovPointOffsetMap.create()

	for point in codeResult.covPointOffsets 'eachEmittedPoint'
		if not offsets.contains(point.pointId) 'itsFirstCopy'
			offsets.upsert(point.pointId, value: point.codeOffset as MxdbgCodeOffset)
		end 'itsFirstCopy'
	end 'eachEmittedPoint'

	return offsets
end 'emittedCoveragePointOffsets'

// ⭐⭐ **WHICH LINE ROWS A `--coverage` BUILD PUTS A COUNTER ON — the row column of the same fact the
// coverage table holds by point, which is why both are read off `covPointOffsets`.**
//
// ⚠ **A COUNTER HAS NO ROW OF ITS OWN HERE, SO THE ROW IT MARKS IS THE ONE IT IMMEDIATELY PRECEDES.** The
// increment op carries `SourceRange.none()` — a counter is the compiler's own instruction and must not be
// attributed to a source line (`Parser.mintCovPoint`) — and it is appended to its block AHEAD of the
// statement it counts, so the first row at or past it is that statement's. Two points legitimately land on
// one row: an arm's counter and its first statement's counter are adjacent, and the line really is counted
// by both.
function coverageCountedRows(codeResult CodeResult, emitted CovPointOffsetMap) returns BoolArray
	var counted = BoolArray.create()
	counted.refill(codeResult.debugLineRows.count(), value: false)

	for (_, codeOffset) in emitted 'eachEmittedPoint'
		markRowAtOrPast(codeResult.debugLineRows, counted: counted, codeOffset: codeOffset)
	end 'eachEmittedPoint'

	return counted
end 'coverageCountedRows'

// ⚠ **BINARY SEARCH, WHICH THE TABLE'S ASCENDING ORDER IS WHAT PERMITS** (`MxdbgWriter` refuses one that is
// not). A scan per point would be Θ(points × rows) on a table with one row per statement in the program.
// A point past the last row marks nothing: its statement emitted no row at all.
function markRowAtOrPast(rows DebugLineRowArray, counted BoolArray, codeOffset MxdbgCodeOffset)
	var low = 0 as ElementIndex
	var high = rows.count()

	while low < high 'narrow'
		let mid = low + (high - low) / 2
		let row = try rows.get(mid) otherwise panic("debug info: debugLineRows.get OOB at {mid} inside the search bound {high}")

		if (row.codeOffset as MxdbgCodeOffset) < codeOffset 'beforeThePoint'
			low = mid + 1
		end 'beforeThePoint' else 'atOrPastThePoint'
			high = mid
		end 'atOrPastThePoint'
	end 'narrow'

	if low < rows.count() 'itsStatementEmittedARow'
		try counted.set(low, value: true) otherwise panic("debug info: counted.set OOB at {low} of a column sized to the line table")
	end 'itsStatementEmittedARow'
end 'markRowAtOrPast'

// Every row this compiler writes is a statement boundary — see `DebugLineRowBuilder`, where that
// granularity is decided — and a row a counter runs into carries the coverage bit as well.
function lineRowFlags(counted BoolArray, at ElementIndex) returns MxdbgIndex
	return (MxdbgLineFlagStatement or MxdbgLineFlagCoverage) if (try counted.get(at) otherwise panic("debug info: counted.get OOB at {at} of a column sized to the line table")) else MxdbgLineFlagStatement
end 'lineRowFlags'

// ⭐⭐ **ONE RECORD PER MINTED POINT, IN COUNTER ORDER, WHETHER OR NOT ITS CODE SURVIVED.** The record's
// POSITION is the counter index the emitted increment steps, so the walk is over the MINT table and never
// over what was emitted: a table built from the emitted points alone would be dense where the counters are
// sparse, and every count past the first gap would be joined to another point's source line.
function writeCoveragePoints(project Project, writer MxdbgWriter, emitted CovPointOffsetMap)
	if project.covPoints.count() == 0 'notInstrumented'
		return
	end 'notInstrumented'

	let fileIds = sidecarFileIdsByPath(project)
	var id = 0 as CovPointId

	for point in project.covPoints.points 'eachPoint'
		var codeOffset = NoCoverageCodeOffset
		var flags = (point.flags as MxdbgIndex) or MxdbgCovFlagEliminated

		if let at = try emitted.get(id) 'itsCodeSurvived'
			codeOffset = at
			flags = point.flags as MxdbgIndex
		end 'itsCodeSurvived'

		writer.addCoveragePoint(codeOffset, fileId: coveragePointFileId(fileIds, point: point, id: id), line: point.line as MxdbgIndex, column: point.col as MxdbgIndex, branchLine: point.branchLine as MxdbgIndex, branchColumn: point.branchCol as MxdbgIndex, funcName: point.funcName, flags: flags)
		id = id + 1
	end 'eachPoint'
end 'writeCoveragePoints'

// The sidecar file id a point's record names. Every point's file is registered ahead of the walk that
// writes that table, so a miss is the two tables having been built from different sources.
function coveragePointFileId(fileIds SidecarFileIdMap, point CovPoint, id CovPointId) returns MxdbgIndex
	return try fileIds.get(point.filePath) otherwise panic("debug info: coverage point {id} in '{point.funcName}' names the file '{point.filePath}', which the sidecar's file table does not hold")
end 'coveragePointFileId'

// The sidecar file table, keyed by path — the id a coverage record names its file by. A point carries its
// path rather than a span id, so this is the only route from one to the other.
function sidecarFileIdsByPath(project Project) returns SidecarFileIdMap
	var byPath = SidecarFileIdMap.create()

	for fileId in MxdbgFirstSourceFileId upto project.debugSpanTable.fileCount() 'eachFile'
		byPath.upsert(project.debugSpanTable.filePath(fileId as DebugFileId), value: sidecarFileIdOf(fileId as DebugFileId))
	end 'eachFile'

	return byPath
end 'sidecarFileIdsByPath'

// ============================================================================================
// LOCALS
// ============================================================================================

// Every type a function's bindings are declared at, folded into the table so their records have a real
// entry to point at. A local's type is often a machine primitive or a ranged alias no declaration
// mentions, which is why the declared types alone are not enough.
function closeLocalTypes(project Project, signatures ProgramSignatures, types MxdbgTypeTable, func IrFunction)
	for local in func.debugLocals 'eachBinding'
		types.close(project, signatures: signatures, name: mxdbgTypeNameOf(project, signatures: signatures, ref: local.declaredType))
	end 'eachBinding'
end 'closeLocalTypes'

// ⭐⭐ **ONE RECORD PER DECLARED BINDING, INCLUDING THE ONES THE COMPILER CANNOT PLACE.** A binding with
// no honest location gets an `optimizedOut` record rather than no record at all, so a debugger says
// "optimized out" where the alternative is "no local named that here" — a name the user can see in their
// own source and cannot ask about.
function writeFunctionLocals(project Project, signatures ProgramSignatures, writer MxdbgWriter, types MxdbgTypeTable, func IrFunction, range DebugFunctionRange)
	if func.debugLocals.count() == 0 'noBindings'
		return
	end 'noBindings'

	var records = MxdbgLocalDraftArray.create()
	records.reserve(func.debugLocals.count())

	let runs = DebugRunsByOrdinal.over(range.localRanges, ordinalCount: func.debugLocalLocations.count())
	var at = 0 as ElementIndex

	for local in func.debugLocals 'eachBinding'
		let past = at + local.valueIds.count()
		let typeName = mxdbgTypeNameOf(project, signatures: signatures, ref: local.declaredType)
		let typeId = types.idOf(typeName)
		var rows = MxdbgLocalRowArray.create()

		if not local.heldInACell 'placeable'
			collectPlacedRows(rows, project: project, func: func, range: range, runs: runs, first: at, past: past)
		end 'placeable'

		if rows.count() == 0 'nothingPlaced'
			rows.push(unplacedRow(local, writer: writer, types: types, typeName: typeName, range: range))
		end 'nothingPlaced'

		rows.sort(function(left MxdbgLocalRow, right MxdbgLocalRow) gives left.codeStart.compare(right.codeStart))
		records.push(MxdbgLocalDraft.create(local.name, typeId: typeId, indirect: types.holdsAPointer(typeName), rows: rows))
		at = past
	end 'eachBinding'

	if at != func.debugLocalLocations.count() 'locationsOutOfStep'
		panic("debug info: '{String.from(func.name)}' names {at} value(s) across its bindings and the allocator answered for {func.debugLocalLocations.count()} — the roster and the location column describe different value spaces")
	end 'locationsOutOfStep'

	// Ordinal, by name — the reference's order, and the one a reader scans. Sorted STABLY, so two
	// bindings a nested scope gave the same name keep their declaration order.
	records.sort(function(left MxdbgLocalDraft, right MxdbgLocalDraft) gives compareBytesOrdinally(left.name, right: right.name))

	for record in records 'eachRecord'
		for row in record.rows 'eachRow'
			writer.addLocal(String.from(record.name), locKind: row.locKind, locValue: row.locValue, typeId: record.typeId, scopeStart: row.codeStart as MxdbgCodeOffset, scopeEnd: row.codeEnd as MxdbgCodeOffset, flags: MxdbgLocalFlagIndirect if record.indirect and mxdbgRowHasALocation(row.locKind) else 0)
		end 'eachRow'
	end 'eachRecord'
end 'writeFunctionLocals'

function mxdbgRowHasALocation(locKind MxdbgIndex) returns bool
	return locKind == MxdbgLocKindStackSlot or locKind == MxdbgLocKindRegister
end 'mxdbgRowHasALocation'

function collectPlacedRows(rows MxdbgLocalRowArray, project Project, func IrFunction, range DebugFunctionRange, runs DebugRunsByOrdinal, first ElementIndex, past ElementIndex)
	var ordinal = first

	while ordinal < past 'eachValue'
		let location = mxdbgLocationAt(func, at: ordinal)

		if location.kind == DebugValueNowhere 'notInTheCode'
			ordinal = ordinal + 1
			continue
		end 'notInTheCode'

		let placement = mxdbgPlacementOf(project, location: location, range: range)
		let spans = mergedLiveRanges(range, runs: runs, ordinal: ordinal)
		// A spill slot belongs to one lineage and is never written by another value (`SplitLiveRanges`),
		// so the bits in it stay that value's after liveness has let go of it: its last run is extended
		// to the end of the function rather than stopping at the last use.
		let holdsToTheEnd = location.kind == DebugValueInSpillSlot

		for (iter, span) in spans.withIterator() 'eachSpan'
			let last = iter.index() == spans.count() - 1
			rows.push(MxdbgLocalRow.create(placement, codeStart: span.codeStart, codeEnd: range.codeEnd if last and holdsToTheEnd else span.codeEnd))
		end 'eachSpan'

		ordinal = ordinal + 1
	end 'eachValue'
end 'collectPlacedRows'

function unplacedRow(local DebugLocalDecl, writer MxdbgWriter, types MxdbgTypeTable, typeName ByteArray, range DebugFunctionRange) returns MxdbgLocalRow
	match foldedAggregatePlacement(local, writer: writer, types: types, typeName: typeName) 'aggregate'
		none then break 'aggregate'
		placed(placement) then return MxdbgLocalRow.create(placement, codeStart: range.codeStart, codeEnd: range.codeEnd)
	end 'aggregate'

	if local.valueIds.count() == 1 'oneValueForTheWholeName'
		match local.foldedConstant 'folded'
			none then break 'folded'
			immediate(value) then return foldedRow(value, range: range)
		end 'folded'
	end 'oneValueForTheWholeName'

	return MxdbgLocalRow.create(MxdbgOptimizedOutPlacement, codeStart: range.codeStart, codeEnd: range.codeEnd)
end 'unplacedRow'

union MxdbgAggregatePlacement
	none
	placed(placement MxdbgPlacement)
end 'MxdbgAggregatePlacement'

function foldedAggregatePlacement(local DebugLocalDecl, writer MxdbgWriter, types MxdbgTypeTable, typeName ByteArray) returns MxdbgAggregatePlacement
	let words = types.aggregateWordCount(typeName)

	if words == 0 or (local.foldedRecord.count() as MxdbgIndex) != words 'notAFoldedAggregate'
		return MxdbgAggregatePlacement.none
	end 'notAFoldedAggregate'

	for word in local.foldedRecord 'eachWord'
		if word < MxdbgSmallestConstant or word > MxdbgLargestConstant 'notRepresentable'
			return MxdbgAggregatePlacement.none
		end 'notRepresentable'
	end 'eachWord'

	var first = 0 as MxdbgIndex
	var opened = false

	for word in local.foldedRecord 'eachWordWritten'
		let index = writer.addConstantWord(word as MxdbgLocValue)

		if not opened 'theFirst'
			first = index
			opened = true
		end 'theFirst'
	end 'eachWordWritten'

	if first > (MxdbgLargestConstant as MxdbgIndex) 'pastTheWordSpace'
		return MxdbgAggregatePlacement.none
	end 'pastTheWordSpace'

	return MxdbgAggregatePlacement.placed(MxdbgPlacement.create(MxdbgLocKindFoldedAggregate, locValue: first as MxdbgLocValue))
end 'foldedAggregatePlacement'

function foldedRow(value ParsedInt, range DebugFunctionRange) returns MxdbgLocalRow
	if value < MxdbgSmallestConstant or value > MxdbgLargestConstant 'notRepresentable'
		return MxdbgLocalRow.create(MxdbgOptimizedOutPlacement, codeStart: range.codeStart, codeEnd: range.codeEnd)
	end 'notRepresentable'

	return MxdbgLocalRow.create(MxdbgPlacement.create(MxdbgLocKindConstant, locValue: value as MxdbgLocValue), codeStart: range.codeStart, codeEnd: range.codeEnd)
end 'foldedRow'

let MxdbgSmallestConstant = i32.min as ParsedInt
let MxdbgLargestConstant = i32.max as ParsedInt

typealias MxdbgRunSlotColumn = Array with ElementIndex

type DebugRunsByOrdinal
	var starts as MxdbgRunSlotColumn
	var ordered as DebugLocalCodeRangeArray

	static function over(localRanges DebugLocalCodeRangeArray, ordinalCount ElementIndex) returns DebugRunsByOrdinal
		var starts = MxdbgRunSlotColumn.create()
		starts.refill(ordinalCount + 1, value: 0 as ElementIndex)

		for span in localRanges 'eachRange'
			let slot = runOrdinalOf(span, ordinalCount: ordinalCount) + 1
			try starts.set(slot, value: runSlotAt(starts, at: slot) + 1) otherwise panic("debug info: the run tally of ordinal {slot - 1} is outside a column sized to {ordinalCount}")
		end 'eachRange'

		for slot in 1 upto ordinalCount + 1 'eachOrdinal'
			try starts.set(slot, value: runSlotAt(starts, at: slot) + runSlotAt(starts, at: slot - 1)) otherwise panic("debug info: the run tally of ordinal {slot - 1} is outside a column sized to {ordinalCount}")
		end 'eachOrdinal'

		var filled = MxdbgRunSlotColumn.create()
		filled.refill(ordinalCount, value: 0 as ElementIndex)
		var ordered = DebugLocalCodeRangeArray.create()
		ordered.refill(localRanges.count(), value: DebugLocalCodeRange.create(0 as ElementIndex, codeStart: 0 as CodeOffset, codeEnd: 0 as CodeOffset))

		for span in localRanges 'eachRangePlaced'
			let ordinal = runOrdinalOf(span, ordinalCount: ordinalCount)
			let slot = runSlotAt(starts, at: ordinal) + runSlotAt(filled, at: ordinal)
			try ordered.set(slot, value: span) otherwise panic("debug info: run slot {slot} is outside the {localRanges.count()} runs this function's code ranges hold")
			try filled.set(ordinal, value: runSlotAt(filled, at: ordinal) + 1) otherwise panic("debug info: the fill cursor of ordinal {ordinal} is outside a column sized to {ordinalCount}")
		end 'eachRangePlaced'

		return Self{starts: starts, ordered: ordered}
	end 'over'

	export function first(ordinal ElementIndex) returns ElementIndex
		return runSlotAt(self.starts, at: ordinal)
	end 'first'

	export function past(ordinal ElementIndex) returns ElementIndex
		return runSlotAt(self.starts, at: ordinal + 1)
	end 'past'

	export function at(slot ElementIndex) returns DebugLocalCodeRange
		return try self.ordered.get(slot) otherwise panic("debug info: run slot {slot} is outside the {self.ordered.count()} this function's code ranges hold")
	end 'at'
end 'DebugRunsByOrdinal'

function runSlotAt(column MxdbgRunSlotColumn, at ElementIndex) returns ElementIndex
	return try column.get(at) otherwise panic("debug info: a run column was read at {at}, past the {column.count()} it was sized to")
end 'runSlotAt'

function runOrdinalOf(span DebugLocalCodeRange, ordinalCount ElementIndex) returns ElementIndex
	if span.valueOrdinal >= ordinalCount 'pastTheRoster'
		panic("debug info: a code range names value ordinal {span.valueOrdinal} where the function's roster holds {ordinalCount} — the ranges and the locations describe different value spaces")
	end 'pastTheRoster'

	return span.valueOrdinal
end 'runOrdinalOf'

// One run per block arrives here, and they are joined only now, over code offsets. `BranchCleanup`
// reorders blocks, so two runs that abut in the emitted code need not abut in the block order the
// allocator walked, and merging before layout would leave a hole a reader reports as "not live here".
function mergedLiveRanges(range DebugFunctionRange, runs DebugRunsByOrdinal, ordinal ElementIndex) returns DebugLocalCodeRangeArray
	var mine = DebugLocalCodeRangeArray.create()

	for slot in runs.first(ordinal) upto runs.past(ordinal) 'eachRange'
		let span = runs.at(slot)
		let codeStart = span.codeStart if span.codeStart > range.codeStart else range.codeStart
		let codeEnd = span.codeEnd if span.codeEnd < range.codeEnd else range.codeEnd

		if codeEnd <= codeStart 'outsideTheFunction'
			continue
		end 'outsideTheFunction'

		mine.push(DebugLocalCodeRange.create(ordinal, codeStart: codeStart, codeEnd: codeEnd))
	end 'eachRange'

	mine.sort(function(left DebugLocalCodeRange, right DebugLocalCodeRange) gives left.codeStart.compare(right.codeStart))

	var merged = DebugLocalCodeRangeArray.create()
	var openStart = 0 as CodeOffset
	var openEnd = 0 as CodeOffset
	var open = false

	for span in mine 'eachSorted'
		if not open 'theFirst'
			openStart = span.codeStart
			openEnd = span.codeEnd
			open = true
			continue
		end 'theFirst'

		if span.codeStart > openEnd 'disjoint'
			merged.push(DebugLocalCodeRange.create(ordinal, codeStart: openStart, codeEnd: openEnd))
			openStart = span.codeStart
			openEnd = span.codeEnd
			continue
		end 'disjoint'

		openEnd = span.codeEnd if span.codeEnd > openEnd else openEnd
	end 'eachSorted'

	if open 'oneStillOpen'
		merged.push(DebugLocalCodeRange.create(ordinal, codeStart: openStart, codeEnd: openEnd))
	end 'oneStillOpen'

	return merged
end 'mergedLiveRanges'

type MxdbgLocalRow
	export var locKind as MxdbgIndex
	export var locValue as MxdbgLocValue
	export var codeStart as CodeOffset
	export var codeEnd as CodeOffset

	export static function create(placement MxdbgPlacement, codeStart CodeOffset, codeEnd CodeOffset) returns MxdbgLocalRow
		return Self{locKind: placement.locKind, locValue: placement.locValue, codeStart: codeStart, codeEnd: codeEnd}
	end 'create'
end 'MxdbgLocalRow'

typealias MxdbgLocalRowArray = Array with MxdbgLocalRow

// One local record, before the roster is put in name order.
type MxdbgLocalDraft
	export var name as ByteArray
	export var typeId as MxdbgIndex
	export var indirect as bool
	export var rows as MxdbgLocalRowArray

	export static function create(name ByteArray, typeId MxdbgIndex, indirect bool, rows MxdbgLocalRowArray) returns MxdbgLocalDraft
		return Self{name: name, typeId: typeId, indirect: indirect, rows: rows}
	end 'create'
end 'MxdbgLocalDraft'

typealias MxdbgLocalDraftArray = Array with MxdbgLocalDraft

// A location as the sidecar states one.
type MxdbgPlacement
	export var locKind as MxdbgIndex
	export var locValue as MxdbgLocValue

	export static function create(locKind MxdbgIndex, locValue MxdbgLocValue) returns MxdbgPlacement
		return Self{locKind: locKind, locValue: locValue}
	end 'create'
end 'MxdbgPlacement'

let MxdbgOptimizedOutPlacement = MxdbgPlacement.create(MxdbgLocKindOptimizedOut, locValue: 0)

function mxdbgPlacementOf(project Project, location DebugValueLocation, range DebugFunctionRange) returns MxdbgPlacement
	if location.kind == DebugValueInRegister 'aRegister'
		return MxdbgPlacement.create(MxdbgLocKindRegister, locValue: location.number as MxdbgLocValue)
	end 'aRegister'

	if location.kind == DebugValueInSpillSlot 'aFrameSlot'
		return MxdbgPlacement.create(MxdbgLocKindStackSlot, locValue: mxdbgFrameDisplacement(project, frameSize: range.frameSize, spillSlotBase: range.spillSlotBase, frameLinkBytes: range.frameLinkBytes, slot: location.number as SpillSlot))
	end 'aFrameSlot'

	panic("debug info: the allocator answered location kind {location.kind}, which is none of the three `DebugValueLocation` has")
end 'mxdbgPlacementOf'

function mxdbgLocationAt(func IrFunction, at ElementIndex) returns DebugValueLocation
	return try func.debugLocalLocations.get(at) otherwise panic("debug info: '{String.from(func.name)}' has no location at {at} of the {func.debugLocalLocations.count()} the allocator answered for — the roster and the column are walked in one order")
end 'mxdbgLocationAt'

// ⭐⭐ **A SPILL SLOT AS A FRAME-POINTER-RELATIVE DISPLACEMENT, AND THIS IS WHERE THE TWO ISAs DIFFER.**
// The sidecar states one signed offset from the frame pointer and a driver labels it per target, so the
// per-ISA slot arithmetic has to be collapsed to that here rather than carried in the file.
//
// arm64's own displacement already is one: x29 points at the saved frame record and the slot area opens
// just past it. x64's is rsp-relative and call-dependent — a caller's slots sit above the shadow space and
// its outgoing arguments — so it is rebased by the frame the prologue reserves, which puts a slot BELOW
// the notional frame pointer exactly as the reference driver renders it.
function mxdbgFrameDisplacement(project Project, frameSize StackSize, spillSlotBase StackSize, frameLinkBytes StackSize, slot SpillSlot) returns MxdbgLocValue
	return match project.target.cpu 'isa'
		arm64 gives arm64SlotDisplacement(slot) as MxdbgLocValue
		x64 gives mxdbgX64FrameDisplacement(frameSize, spillSlotBase: spillSlotBase, frameLinkBytes: frameLinkBytes, slot: slot)
		wasm32 gives panicNoFrameOnWasm()
	end 'isa'
end 'mxdbgFrameDisplacement'

// ⚠ **THE SUBTRACTION IS DONE IN THE SIGNED WIDTH, AND THAT IS NOT A STYLE CHOICE.** A `StackSize` cannot
// hold a negative number, and a slot inside the frame the prologue reserved is BELOW the notional frame
// pointer — so computing it there would trap on the range check for the ordinary case rather than the
// exotic one.
function mxdbgX64FrameDisplacement(frameSize StackSize, spillSlotBase StackSize, frameLinkBytes StackSize, slot SpillSlot) returns MxdbgLocValue
	let fromStackPointer = (spillSlotBase + (slot as StackSize) * SpillSlotBytes) as MxdbgLocValue

	return fromStackPointer - (frameSize as MxdbgLocValue) - (frameLinkBytes as MxdbgLocValue)
end 'mxdbgX64FrameDisplacement'

// The wasm lane emits no `.text` image and writes no sidecar at all, so no spill slot of it can reach the
// arithmetic above. Its own function because the arm has to answer with a value.
function panicNoFrameOnWasm() returns MxdbgLocValue
	panic("debug info: a spill slot was asked for a frame displacement on wasm32, which writes no sidecar at all")
end 'panicNoFrameOnWasm'

// ============================================================================================
// FINDING A FUNCTION'S IR
// ============================================================================================

// The Target function each emitted chunk came from, by name. A chunk carries the ranges and the frame; the
// `IrFunction` carries the bindings and the locations the allocator sent home, and the two are joined
// nowhere else.
function mxdbgFunctionIndex(module TargetModule) returns MxdbgFunctionIndexMap
	var index = MxdbgFunctionIndexMap.create()

	for i in 0 upto module.funcCount() 'eachFunction'
		let func = try module.functions.get(i) otherwise panic("mxdbgFunctionIndex: functions.get OOB at {i} below the module's {module.funcCount()}")
		index.upsert(func.name, value: i as FuncIndex)
	end 'eachFunction'

	return index
end 'mxdbgFunctionIndex'

typealias MxdbgFunctionIndexMap = Map with (ByteArray, FuncIndex)

// ⚠ **A CHUNK NEED NOT HAVE AN `IrFunction` AT ALL.** The panic runtime and the entry stub are
// hand-assembled chunks the backends append past the module's own functions, and they have no bindings
// to describe — so "no IR" is an ANSWER here, not a failure.
function mxdbgFunctionOf(module TargetModule, functionsByName MxdbgFunctionIndexMap, name ByteArray) returns MxdbgIrLookup
	let at = try functionsByName.get(name) otherwise return MxdbgIrLookup.none

	return MxdbgIrLookup.found(try module.functions.get(at) otherwise panic("debug info: functions.get OOB at {at}, which this compile's own index answered with"))
end 'mxdbgFunctionOf'

union MxdbgIrLookup
	none
	found(func IrFunction)
end 'MxdbgIrLookup'

// A `DebugSpanTable` file id as the sidecar's file table numbers it: one behind, because that table
// holds the program's real files only and the span table reserves entry 0 for the positionless file.
// Every row that reaches here carries a POSITIONED span, so it can never name that entry.
function sidecarFileIdOf(fileId DebugFileId) returns MxdbgIndex
	if fileId == NoDebugFileId 'positionless'
		panic("debug info: a line row names the positionless file — only a positioned span becomes a row, and a positionless one interns to NoSpanId")
	end 'positionless'

	return (fileId - 1) as MxdbgIndex
end 'sidecarFileIdOf'

// ⭐ **BARE FNV-1a OVER THE `.text` BYTES — `ContentHash.mixBytes` IS THE WRONG FOLD HERE.** That one
// appends a length tag, which is right for a content-addressed cache key and wrong for a digest another
// implementation recomputes: the driver reads the code section back out of the binary and folds it plainly,
// so a tagged digest would never match and every artifact would be refused as belonging to a different
// build. Nothing is embedded in the executable — that would break byte-identity.
//
// ⭐ **BOTH ARTIFACTS A `--coverage` BUILD LEAVES BEHIND CARRY IT**, the `.mxdbg` sidecar and the `.mxcov`
// header the reserved `.data` run is stamped with, and a report REFUSES a pair whose ids differ — so the
// two must come from one spelling rather than from two that agree today.
export function codeBuildId(code ByteArray) returns HashDigest
	return Hasher.combined(Hasher.empty(), bytes: code)
end 'codeBuildId'

// The sidecar beside `outputPath`: the WHOLE output name with the suffix appended, extension and all
// (`foo.exe` -> `foo.exe.mxdbg`). Spelled once here because three readers need it — this writer, the
// `debug` command that finds a sidecar from a binary, and `discardPreviousOutput`, which clears a stale
// one ahead of every build.
export function sidecarPathOf(outputPath FilePath) returns String
	return "{outputPath.toString()}{MxdbgSidecarExtension}"
end 'sidecarPathOf'

// Remove the sidecar beside `outputPath`. Two callers clear one: `Compiler.discardPreviousOutput` ahead of
// every build, and the spec runner beside the executable it staged. Written here, with the path rule it
// depends on, rather than twice — and it is a REMOVAL, so an unspellable path is simply nothing to remove.
export function discardDebugInfoSidecar(outputPath FilePath)
	let sidecarPath = try FilePath.from(sidecarPathOf(outputPath)) otherwise return

	try File.delete(sidecarPath) otherwise ignore
end 'discardDebugInfoSidecar'
