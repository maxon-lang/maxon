// Compiler/Debug/MxdbgWriter.maxon — build a `.mxdbg` image.
//
// The compiler feeds it the source files, the functions and the line rows it OBSERVED of the already
// emitted `.text`, then asks for the bytes. Strictly additive: nothing here can influence a single
// emitted code byte, which is what the byte-identity gate rests on.
//
// ⭐ **THE LINE TABLE IS NOT SORTED HERE, IT IS ASSERTED ASCENDING.** The reference sorts because its
// caller adds rows in any order; this one's caller walks the chunks in `.text` order and each chunk's
// rows in emission order, so the table is ascending by construction. Sorting it would hide a caller
// that had stopped being — and the reader binary-searches, so an unsorted table is a wrong answer
// rather than a slow one.

// A `(offset, length)` pair into the string pool.
type MxdbgPoolSlice
	export var offset as MxdbgIndex
	export var length as MxdbgIndex

	static function create(offset MxdbgIndex, length MxdbgIndex) returns MxdbgPoolSlice
		return Self{offset: offset, length: length}
	end 'create'
end 'MxdbgPoolSlice'

typealias MxdbgPoolSliceArray = Array with MxdbgPoolSlice
typealias MxdbgPoolSliceMap = Map with (String, MxdbgPoolSlice)

// One function record, as the writer holds it before the line windows are computed. Its local
// window opens where the table stood when the function was added and `addLocal` grows it, which
// keeps the windows contiguous and disjoint by construction: a gap loses records and an overlap
// hands two functions the same ones, and neither reads as a defect in a dump.
type MxdbgFuncRecord
	export var name as MxdbgPoolSlice
	export var codeStart as MxdbgCodeOffset
	export var codeEnd as MxdbgCodeOffset
	export var frameSize as MxdbgIndex
	export var paramCount as MxdbgIndex
	export var localFirst as MxdbgIndex
	export var localCount as MxdbgIndex
	export var displayName as MxdbgPoolSlice
	export var origin as MxdbgOrigin

	static function create(name MxdbgPoolSlice, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, frameSize MxdbgIndex, paramCount MxdbgIndex, localFirst MxdbgIndex, displayName MxdbgPoolSlice, origin MxdbgOrigin) returns MxdbgFuncRecord
		return Self{name: name, codeStart: codeStart, codeEnd: codeEnd, frameSize: frameSize, paramCount: paramCount, localFirst: localFirst, localCount: 0, displayName: displayName, origin: origin}
	end 'create'
end 'MxdbgFuncRecord'

typealias MxdbgFuncRecordArray = Array with MxdbgFuncRecord

// One type record, with the field window its `addField` calls grow.
type MxdbgTypeRecord
	export var name as MxdbgPoolSlice
	export var kind as MxdbgIndex
	export var size as MxdbgIndex
	export var align as MxdbgIndex
	export var fieldFirst as MxdbgIndex
	export var fieldCount as MxdbgIndex
	export var elementTypeId as MxdbgIndex
	export var flags as MxdbgIndex

	static function create(name MxdbgPoolSlice, kind MxdbgIndex, size MxdbgIndex, align MxdbgIndex, fieldFirst MxdbgIndex, elementTypeId MxdbgIndex, flags MxdbgIndex) returns MxdbgTypeRecord
		return Self{name: name, kind: kind, size: size, align: align, fieldFirst: fieldFirst, fieldCount: 0, elementTypeId: elementTypeId, flags: flags}
	end 'create'
end 'MxdbgTypeRecord'

typealias MxdbgTypeRecordArray = Array with MxdbgTypeRecord

// One field record. `offset` is a byte displacement for a struct field and the case's RAW TAG for an enum
// entry — the value a renderer matches a stopped discriminant against.
type MxdbgFieldRecord
	export var name as MxdbgPoolSlice
	export var offset as MxdbgIndex
	export var typeId as MxdbgIndex

	static function create(name MxdbgPoolSlice, offset MxdbgIndex, typeId MxdbgIndex) returns MxdbgFieldRecord
		return Self{name: name, offset: offset, typeId: typeId}
	end 'create'
end 'MxdbgFieldRecord'

typealias MxdbgFieldRecordArray = Array with MxdbgFieldRecord

type MxdbgLocalRecord
	export var name as MxdbgPoolSlice
	export var locKind as MxdbgIndex
	export var locValue as MxdbgLocValue
	export var typeId as MxdbgIndex
	export var scopeStart as MxdbgCodeOffset
	export var scopeEnd as MxdbgCodeOffset
	export var flags as MxdbgIndex
	export var site as MxdbgIndex

	static function create(name MxdbgPoolSlice, locKind MxdbgIndex, locValue MxdbgLocValue, typeId MxdbgIndex, scopeStart MxdbgCodeOffset, scopeEnd MxdbgCodeOffset, flags MxdbgIndex, site MxdbgIndex) returns MxdbgLocalRecord
		return Self{name: name, locKind: locKind, locValue: locValue, typeId: typeId, scopeStart: scopeStart, scopeEnd: scopeEnd, flags: flags, site: site}
	end 'create'
end 'MxdbgLocalRecord'

typealias MxdbgLocalRecordArray = Array with MxdbgLocalRecord

// One line record.
type MxdbgLineRecord
	export var codeOffset as MxdbgCodeOffset
	export var fileId as MxdbgIndex
	export var line as MxdbgIndex
	export var column as MxdbgIndex
	export var flags as MxdbgIndex

	static function create(codeOffset MxdbgCodeOffset, fileId MxdbgIndex, line MxdbgIndex, column MxdbgIndex, flags MxdbgIndex) returns MxdbgLineRecord
		return Self{codeOffset: codeOffset, fileId: fileId, line: line, column: column, flags: flags}
	end 'create'
end 'MxdbgLineRecord'

typealias MxdbgLineRecordArray = Array with MxdbgLineRecord

// One coverage-point record. Its POSITION in the table is the point's counter index, which is what binds
// this section to the `.mxcov` counter array slot-for-slot — so nothing here carries an id.
//
// ⭐ **THE OWNING FUNCTION IS A POOL SLICE, NOT A FUNCTION-TABLE INDEX.** An ELIMINATED point's function
// may have been pruned out of the function table entirely, and a report must still be able to say which
// function's lines went uncovered.
type MxdbgCovRecord
	export var codeOffset as MxdbgCodeOffset
	export var fileId as MxdbgIndex
	export var line as MxdbgIndex
	export var column as MxdbgIndex
	export var branchLine as MxdbgIndex
	export var branchColumn as MxdbgIndex
	export var funcName as MxdbgPoolSlice
	export var flags as MxdbgIndex

	static function create(codeOffset MxdbgCodeOffset, fileId MxdbgIndex, line MxdbgIndex, column MxdbgIndex, branchLine MxdbgIndex, branchColumn MxdbgIndex, funcName MxdbgPoolSlice, flags MxdbgIndex) returns MxdbgCovRecord
		return Self{codeOffset: codeOffset, fileId: fileId, line: line, column: column, branchLine: branchLine, branchColumn: branchColumn, funcName: funcName, flags: flags}
	end 'create'
end 'MxdbgCovRecord'

typealias MxdbgCovRecordArray = Array with MxdbgCovRecord

type MxdbgInlineSiteRecord
	export var name as MxdbgPoolSlice
	export var parent as MxdbgIndex
	export var callFileId as MxdbgIndex
	export var callLine as MxdbgIndex
	export var callColumn as MxdbgIndex
	export var origin as MxdbgOrigin

	static function create(name MxdbgPoolSlice, parent MxdbgIndex, callFileId MxdbgIndex, callLine MxdbgIndex, callColumn MxdbgIndex, origin MxdbgOrigin) returns MxdbgInlineSiteRecord
		return Self{name: name, parent: parent, callFileId: callFileId, callLine: callLine, callColumn: callColumn, origin: origin}
	end 'create'
end 'MxdbgInlineSiteRecord'

typealias MxdbgInlineSiteRecordArray = Array with MxdbgInlineSiteRecord

type MxdbgInlineRangeRecord
	export var codeStart as MxdbgCodeOffset
	export var codeEnd as MxdbgCodeOffset
	export var site as MxdbgIndex

	static function create(codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, site MxdbgIndex) returns MxdbgInlineRangeRecord
		return Self{codeStart: codeStart, codeEnd: codeEnd, site: site}
	end 'create'
end 'MxdbgInlineRangeRecord'

typealias MxdbgInlineRangeRecordArray = Array with MxdbgInlineRangeRecord

typealias MxdbgConstWordArray = Array with MxdbgLocValue

export type MxdbgWriter
	var stringPool as ByteArray = ByteArray.create()
	var interned as MxdbgPoolSliceMap = MxdbgPoolSliceMap.create()
	var files as MxdbgPoolSliceArray = MxdbgPoolSliceArray.create()
	var funcs as MxdbgFuncRecordArray = MxdbgFuncRecordArray.create()
	var lines as MxdbgLineRecordArray = MxdbgLineRecordArray.create()
	var types as MxdbgTypeRecordArray = MxdbgTypeRecordArray.create()
	var fields as MxdbgFieldRecordArray = MxdbgFieldRecordArray.create()
	var locals as MxdbgLocalRecordArray = MxdbgLocalRecordArray.create()
	var covPoints as MxdbgCovRecordArray = MxdbgCovRecordArray.create()
	var inlineSites as MxdbgInlineSiteRecordArray = MxdbgInlineSiteRecordArray.create()
	var inlineRanges as MxdbgInlineRangeRecordArray = MxdbgInlineRangeRecordArray.create()
	var constWords as MxdbgConstWordArray = MxdbgConstWordArray.create()

	export static function create() returns MxdbgWriter
		return Self{}
	end 'create'

	// Intern `text` into the shared pool. The empty string interns to `(0, 0)` and writes nothing, so a
	// nameless entry costs no bytes and reads back as empty.
	function intern(text String) returns MxdbgPoolSlice
		if text.isEmpty() 'nothingToIntern'
			return MxdbgPoolSlice.create(0, length: 0)
		end 'nothingToIntern'

		if let hit = try self.interned.get(text) 'alreadyInterned'
			return hit
		end 'alreadyInterned' else 'firstSight'
			// The LENGTH is measured by pushing rather than asked of the String: a pool slice is a byte
			// range, and the count of bytes a String lays down is the only measure that can address it.
			let offset = self.stringPool.count() as MxdbgIndex

			for b in text.bytes() 'eachByte'
				self.stringPool.push(b)
			end 'eachByte'

			let slice = MxdbgPoolSlice.create(offset, length: (self.stringPool.count() - offset) as MxdbgIndex)
			self.interned.upsert(text, value: slice)

			return slice
		end 'firstSight'
	end 'intern'

	// Register a source file; its id is its position, which is what a line row names.
	export function addFile(path String)
		self.files.push(self.intern(path))
	end 'addFile'

	export function addFunction(name String, displayName String, origin MxdbgOrigin, codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, frameSize MxdbgIndex, paramCount MxdbgIndex)
		self.funcs.push(MxdbgFuncRecord.create(self.intern(name), codeStart: codeStart, codeEnd: codeEnd, frameSize: frameSize, paramCount: paramCount, localFirst: self.locals.count() as MxdbgIndex, displayName: self.intern(displayName), origin: origin))
	end 'addFunction'

	// One local of the function added LAST. There is no function id, because a record can only ever belong
	// to the function currently being described — so a window cannot be opened at the wrong place.
	export function addLocal(name String, locKind MxdbgIndex, locValue MxdbgLocValue, typeId MxdbgIndex, scopeStart MxdbgCodeOffset, scopeEnd MxdbgCodeOffset, flags MxdbgIndex, site MxdbgIndex)
		if self.funcs.count() == 0 'noFunctionYet'
			panic("MxdbgWriter.addLocal: a local record was added before any function — a local grows the window of the function it belongs to")
		end 'noFunctionYet'

		self.locals.push(MxdbgLocalRecord.create(self.intern(name), locKind: locKind, locValue: locValue, typeId: typeId, scopeStart: scopeStart, scopeEnd: scopeEnd, flags: flags, site: site))
		var func = try self.funcs.get(self.funcs.count() - 1) otherwise panic("MxdbgWriter.addLocal: funcs.get OOB at the last of {self.funcs.count()}")
		func.localCount = func.localCount + 1
	end 'addLocal'

	// Register a type; its id is its position, which is what a field or a local names it by.
	export function addType(name String, kind MxdbgIndex, size MxdbgIndex, align MxdbgIndex, elementTypeId MxdbgIndex, flags MxdbgIndex)
		self.types.push(MxdbgTypeRecord.create(self.intern(name), kind: kind, size: size, align: align, fieldFirst: self.fields.count() as MxdbgIndex, elementTypeId: elementTypeId, flags: flags))
	end 'addType'

	// One field of the type added LAST — `addLocal`'s twin, and structural for its reason.
	export function addField(name String, offset MxdbgIndex, typeId MxdbgIndex)
		if self.types.count() == 0 'noTypeYet'
			panic("MxdbgWriter.addField: a field record was added before any type — a field grows the window of the type it belongs to")
		end 'noTypeYet'

		self.fields.push(MxdbgFieldRecord.create(self.intern(name), offset: offset, typeId: typeId))
		var entry = try self.types.get(self.types.count() - 1) otherwise panic("MxdbgWriter.addField: types.get OOB at the last of {self.types.count()}")
		entry.fieldCount = entry.fieldCount + 1
	end 'addField'

	export function addLine(codeOffset MxdbgCodeOffset, fileId MxdbgIndex, line MxdbgIndex, column MxdbgIndex, flags MxdbgIndex)
		self.lines.push(MxdbgLineRecord.create(codeOffset, fileId: fileId, line: line, column: column, flags: flags))
	end 'addLine'

	// One coverage point. ⛔ **THEY MUST ARRIVE IN COUNTER ORDER**: the record's position IS the counter
	// index the emitted increment steps, and a table in any other order joins every count to another
	// point's source line — a report of REAL COUNTS ON THE WRONG LINES, which is worse than no report.
	export function addCoveragePoint(codeOffset MxdbgCodeOffset, fileId MxdbgIndex, line MxdbgIndex, column MxdbgIndex, branchLine MxdbgIndex, branchColumn MxdbgIndex, funcName String, flags MxdbgIndex)
		self.covPoints.push(MxdbgCovRecord.create(codeOffset, fileId: fileId, line: line, column: column, branchLine: branchLine, branchColumn: branchColumn, funcName: self.intern(funcName), flags: flags))
	end 'addCoveragePoint'

	// One spliced body; its index is its position, which is what a range, a nested site and a local
	// name.
	export function addInlineSite(name String, parent MxdbgIndex, callFileId MxdbgIndex, callLine MxdbgIndex, callColumn MxdbgIndex, origin MxdbgOrigin)
		self.inlineSites.push(MxdbgInlineSiteRecord.create(self.intern(name), parent: parent, callFileId: callFileId, callLine: callLine, callColumn: callColumn, origin: origin))
	end 'addInlineSite'

	export function addConstantWord(value MxdbgLocValue) returns MxdbgIndex
		self.constWords.push(value)

		return (self.constWords.count() - 1) as MxdbgIndex
	end 'addConstantWord'

	export function addInlineRange(codeStart MxdbgCodeOffset, codeEnd MxdbgCodeOffset, site MxdbgIndex)
		if site >= self.inlineSites.count() 'noSuchSite'
			panic("MxdbgWriter.addInlineRange: range [0x{codeStart:x}, 0x{codeEnd:x}) names site {site} of {self.inlineSites.count()} — every site is added before the ranges under it")
		end 'noSuchSite'

		self.inlineRanges.push(MxdbgInlineRangeRecord.create(codeStart, codeEnd: codeEnd, site: site))
	end 'addInlineRange'

	export function build(buildId HashDigest, targetTriple String, sourceRoot String) returns ByteArray
		self.requireAscendingTables()
		let windows = self.lineWindows()
		self.requireEveryRowInAWindow(windows)
		let triple = self.intern(targetTriple)
		let root = self.intern(sourceRoot)

		// Each offset is the previous section's plus its stride times its count, so this chain must list
		// the sections in the order the loops below append them — not the header slot order (see
		// `MxdbgFormat`).
		let fileTableOff = MxdbgHeaderSize as ByteOffset
		let funcTableOff = fileTableOff + (self.files.count() * MxdbgFileEntrySize) as ByteOffset
		let lineTableOff = funcTableOff + (self.funcs.count() * MxdbgFuncEntrySize) as ByteOffset
		let typeTableOff = lineTableOff + (self.lines.count() * MxdbgLineEntrySize) as ByteOffset
		let fieldTableOff = typeTableOff + (self.types.count() * MxdbgTypeEntrySize) as ByteOffset
		let localTableOff = fieldTableOff + (self.fields.count() * MxdbgFieldEntrySize) as ByteOffset
		let covTableOff = localTableOff + (self.locals.count() * MxdbgLocalEntrySize) as ByteOffset
		let inlineSiteTableOff = covTableOff + (self.covPoints.count() * MxdbgCovEntrySize) as ByteOffset
		let inlineRangeTableOff = inlineSiteTableOff + (self.inlineSites.count() * MxdbgInlineSiteEntrySize) as ByteOffset
		let constTableOff = inlineRangeTableOff + (self.inlineRanges.count() * MxdbgInlineRangeEntrySize) as ByteOffset
		let stringPoolOff = constTableOff + (self.constWords.count() * MxdbgConstEntrySize) as ByteOffset

		var buf = ByteArray.create()
		writeMxdbgMagic(buf)
		writeZeros(buf, n: (MxdbgHeaderSize - buf.count()) as BytePos)
		patchDword(buf, offset: MxdbgOffVersion, value: MxdbgFormatVersion as MachineWord)
		patchDword(buf, offset: MxdbgOffReserved, value: 0)
		patchQword(buf, offset: MxdbgOffBuildId, value: buildId as MachineWord)
		patchDword(buf, offset: MxdbgOffTripleOff, value: triple.offset as MachineWord)
		patchDword(buf, offset: MxdbgOffTripleLen, value: triple.length as MachineWord)
		patchDword(buf, offset: MxdbgOffSourceRootOff, value: root.offset as MachineWord)
		patchDword(buf, offset: MxdbgOffSourceRootLen, value: root.length as MachineWord)
		patchDword(buf, offset: MxdbgOffStringPoolOff, value: stringPoolOff as MachineWord)
		patchDword(buf, offset: MxdbgOffStringPoolSize, value: self.stringPool.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffFileTableOff, value: fileTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffFileCount, value: self.files.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffFuncTableOff, value: funcTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffFuncCount, value: self.funcs.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffLineTableOff, value: lineTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffLineCount, value: self.lines.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffTypeTableOff, value: typeTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffTypeCount, value: self.types.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffFieldTableOff, value: fieldTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffFieldCount, value: self.fields.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffLocalTableOff, value: localTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffLocalCount, value: self.locals.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffCovTableOff, value: covTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffCovCount, value: self.covPoints.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffInlineSiteTableOff, value: inlineSiteTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffInlineSiteCount, value: self.inlineSites.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffInlineRangeTableOff, value: inlineRangeTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffInlineRangeCount, value: self.inlineRanges.count() as MachineWord)
		patchDword(buf, offset: MxdbgOffConstTableOff, value: constTableOff as MachineWord)
		patchDword(buf, offset: MxdbgOffConstCount, value: self.constWords.count() as MachineWord)

		for file in self.files 'eachFile'
			let rec = appendedRecord(buf, stride: MxdbgFileEntrySize)
			patchDword(buf, offset: rec + MxdbgFileNameOff, value: file.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgFileNameLen, value: file.length as MachineWord)
		end 'eachFile'

		for i in 0 upto self.funcs.count() 'eachFunc'
			let f = try self.funcs.get(i) otherwise panic("MxdbgWriter.build: funcs.get OOB at {i} despite the upto bound")
			let window = try windows.get(i) otherwise panic("MxdbgWriter.build: windows.get OOB at {i} — one window is computed per function, in this very order")
			let rec = appendedRecord(buf, stride: MxdbgFuncEntrySize)
			patchDword(buf, offset: rec + MxdbgFuncNameOff, value: f.name.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncNameLen, value: f.name.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncCodeStart, value: f.codeStart as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncCodeEnd, value: f.codeEnd as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncFrameSize, value: f.frameSize as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncParamCount, value: f.paramCount as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncLineFirst, value: window.first as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncLineCount, value: window.count as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncLocalFirst, value: f.localFirst as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncLocalCount, value: f.localCount as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncDisplayNameOff, value: f.displayName.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncDisplayNameLen, value: f.displayName.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgFuncOrigin, value: mxdbgOriginWord(f.origin) as MachineWord)
		end 'eachFunc'

		for row in self.lines 'eachLine'
			let rec = appendedRecord(buf, stride: MxdbgLineEntrySize)
			patchDword(buf, offset: rec + MxdbgLineCodeOffset, value: row.codeOffset as MachineWord)
			patchDword(buf, offset: rec + MxdbgLineFileId, value: row.fileId as MachineWord)
			patchDword(buf, offset: rec + MxdbgLineLine, value: row.line as MachineWord)
			patchDword(buf, offset: rec + MxdbgLineCol, value: row.column as MachineWord)
			patchDword(buf, offset: rec + MxdbgLineFlags, value: row.flags as MachineWord)
		end 'eachLine'

		for entry in self.types 'eachType'
			let rec = appendedRecord(buf, stride: MxdbgTypeEntrySize)
			patchDword(buf, offset: rec + MxdbgTypeNameOff, value: entry.name.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeNameLen, value: entry.name.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeKindWord, value: entry.kind as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeSize, value: entry.size as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeAlign, value: entry.align as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeFieldFirst, value: entry.fieldFirst as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeFieldCount, value: entry.fieldCount as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeElementTypeId, value: entry.elementTypeId as MachineWord)
			patchDword(buf, offset: rec + MxdbgTypeFlags, value: entry.flags as MachineWord)
		end 'eachType'

		for field in self.fields 'eachField'
			let rec = appendedRecord(buf, stride: MxdbgFieldEntrySize)
			patchDword(buf, offset: rec + MxdbgFieldNameOff, value: field.name.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgFieldNameLen, value: field.name.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgFieldOffset, value: field.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgFieldTypeId, value: field.typeId as MachineWord)
		end 'eachField'

		for local in self.locals 'eachLocal'
			let rec = appendedRecord(buf, stride: MxdbgLocalEntrySize)
			patchDword(buf, offset: rec + MxdbgLocalNameOff, value: local.name.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalNameLen, value: local.name.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalLocKind, value: local.locKind as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalLocValue, value: mxdbgLocValueWord(local.locValue) as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalTypeId, value: local.typeId as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalScopeStart, value: local.scopeStart as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalScopeEnd, value: local.scopeEnd as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalFlags, value: local.flags as MachineWord)
			patchDword(buf, offset: rec + MxdbgLocalSite, value: local.site as MachineWord)
		end 'eachLocal'

		for point in self.covPoints 'eachCoveragePoint'
			let rec = appendedRecord(buf, stride: MxdbgCovEntrySize)
			patchDword(buf, offset: rec + MxdbgCovCodeOffset, value: point.codeOffset as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovFileId, value: point.fileId as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovLine, value: point.line as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovCol, value: point.column as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovBranchLine, value: point.branchLine as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovBranchCol, value: point.branchColumn as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovFuncNameOff, value: point.funcName.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovFuncNameLen, value: point.funcName.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgCovFlags, value: point.flags as MachineWord)
		end 'eachCoveragePoint'

		for site in self.inlineSites 'eachInlineSite'
			let rec = appendedRecord(buf, stride: MxdbgInlineSiteEntrySize)
			patchDword(buf, offset: rec + MxdbgInlineSiteNameOff, value: site.name.offset as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineSiteNameLen, value: site.name.length as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineSiteParent, value: site.parent as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineSiteCallFileId, value: site.callFileId as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineSiteCallLine, value: site.callLine as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineSiteCallCol, value: site.callColumn as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineSiteOrigin, value: mxdbgOriginWord(site.origin) as MachineWord)
		end 'eachInlineSite'

		for range in self.inlineRanges 'eachInlineRange'
			let rec = appendedRecord(buf, stride: MxdbgInlineRangeEntrySize)
			patchDword(buf, offset: rec + MxdbgInlineRangeCodeStart, value: range.codeStart as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineRangeCodeEnd, value: range.codeEnd as MachineWord)
			patchDword(buf, offset: rec + MxdbgInlineRangeSite, value: range.site as MachineWord)
		end 'eachInlineRange'

		for word in self.constWords 'eachConstantWord'
			let rec = appendedRecord(buf, stride: MxdbgConstEntrySize)
			patchDword(buf, offset: rec + MxdbgConstWord, value: mxdbgLocValueWord(word) as MachineWord)
		end 'eachConstantWord'

		buf.append(self.stringPool)

		return buf
	end 'build'

	// ⭐⭐ **EVERY FUNCTION'S `[first, first + count)` SLICE OF THE LINE TABLE, IN ONE SWEEP OF EACH.**
	//
	// Both tables are in code order — the functions because the concat pass laid `.text` out that way,
	// the rows because they were collected off those very chunks — so ONE cursor walks the rows once
	// across the whole function list and never goes back.
	//
	// ⚠ **SCANNING THE WHOLE LINE TABLE PER FUNCTION IS NOT A CONSTANT FACTOR, IT IS THE PRODUCT.**
	// MEASURED on this compiler compiling itself: that shape spent 23.4 G CPU ticks in the sidecar
	// phase, against 28.0 G for the WHOLE register allocator.
	function lineWindows() returns MxdbgLineWindowArray
		var windows = MxdbgLineWindowArray.create()
		windows.reserve(self.funcs.count())

		var at = 0 as ElementIndex

		for i in 0 upto self.funcs.count() 'eachFunc'
			let f = try self.funcs.get(i) otherwise panic("MxdbgWriter.lineWindows: funcs.get OOB at {i} despite the upto bound")
			at = self.firstRowAtOrPast(at, offset: f.codeStart)
			let first = at
			at = self.firstRowAtOrPast(at, offset: f.codeEnd)
			let count = (at - first) as MxdbgIndex

			// An empty window reports first = 0, matching the all-zero record the reference writes, so a
			// reader that trusts `count` alone cannot be led anywhere by the other field.
			windows.push(MxdbgLineWindow.create(first as MxdbgIndex if count > 0 else 0, count: count))
		end 'eachFunc'

		return windows
	end 'lineWindows'

	// The first row at or past `offset`, resuming from `from`. The cursor only ever moves forward across
	// the walk above, which is what makes that walk one sweep rather than one per function.
	function firstRowAtOrPast(from ElementIndex, offset MxdbgCodeOffset) returns ElementIndex
		var at = from

		while at < self.lines.count() 'eachRow'
			let row = try self.lines.get(at) otherwise panic("MxdbgWriter.firstRowAtOrPast: lines.get OOB at {at} despite the while guard")

			if row.codeOffset >= offset 'atOrPast'
				break
			end 'atOrPast'

			at = at + 1
		end 'eachRow'

		return at
	end 'firstRowAtOrPast'

	function requireAggregateWindowFits(local MxdbgLocalRecord, at ElementIndex)
		let described = try self.types.get(local.typeId as ElementIndex) otherwise panic("MxdbgWriter: local {at} is a folded aggregate of type {local.typeId}, which is past this file's {self.types.count()} type records")
		let words = mxdbgFoldedAggregateWordCount(described.kind, fieldCount: described.fieldCount)

		if words == 0 'notAnAggregateType'
			panic("MxdbgWriter: local {at} is a folded aggregate described as '{String.from(self.poolBytes(described.name))}', a {mxdbgTypeKindName(described.kind)} — only a struct and a union have fields for the constant words to belong to")
		end 'notAnAggregateType'

		if local.locValue < 0 or (local.locValue as MxdbgIndex) + words > self.constWords.count() 'windowPastTheSection'
			panic("MxdbgWriter: local {at} names constant words [{local.locValue}, {local.locValue} + {words}), which is outside the {self.constWords.count()} this file holds — a reader would fold whatever followed the section into the value")
		end 'windowPastTheSection'
	end 'requireAggregateWindowFits'

	function poolBytes(slice MxdbgPoolSlice) returns ByteArray
		var bytes = ByteArray.create()

		for i in slice.offset upto slice.offset + slice.length 'eachByte'
			bytes.push(try self.stringPool.get(i as ElementIndex) otherwise panic("MxdbgWriter.poolBytes: byte {i} of a slice this writer interned is past the {self.stringPool.count()}-byte pool it interned it into"))
		end 'eachByte'

		return bytes
	end 'poolBytes'

	function requireAscendingTables()
		var previousRow = 0 as MxdbgCodeOffset

		for i in 0 upto self.lines.count() 'eachRow'
			let row = try self.lines.get(i) otherwise panic("MxdbgWriter.requireAscendingTables: lines.get OOB at {i} despite the upto bound")

			if not mxdbgRowFollows(row.codeOffset, previousRow: previousRow) 'rowOutOfOrder'
				panic("MxdbgWriter: line row {i} is at 0x{row.codeOffset:x} behind 0x{previousRow:x} — the table is built by walking chunks in `.text` order, and both the reader's search and the window walk read it forward only")
			end 'rowOutOfOrder'

			previousRow = row.codeOffset
		end 'eachRow'

		var previousFunc = 0 as MxdbgCodeOffset

		for i in 0 upto self.funcs.count() 'eachFunc'
			let f = try self.funcs.get(i) otherwise panic("MxdbgWriter.requireAscendingTables: funcs.get OOB at {i} despite the upto bound")

			if not mxdbgFunctionRangeFollows(f.codeStart, codeEnd: f.codeEnd, previousEnd: previousFunc) 'funcOutOfOrder'
				panic("MxdbgWriter: function {i} is [0x{f.codeStart:x}, 0x{f.codeEnd:x}), inverted or starting behind 0x{previousFunc:x} where the function before it ended — the concat pass lays chunks out in `.text` order, and the window walk consumes both tables forward together")
			end 'funcOutOfOrder'

			previousFunc = f.codeEnd
		end 'eachFunc'

		for i in 0 upto self.funcs.count() 'eachFunctionsLocals'
			let f = try self.funcs.get(i) otherwise panic("MxdbgWriter.requireAscendingTables: funcs.get OOB at {i} despite the upto bound")

			for k in f.localFirst upto f.localFirst + f.localCount 'eachLocal'
				let local = try self.locals.get(k as ElementIndex) otherwise panic("MxdbgWriter.requireAscendingTables: locals.get OOB at {k} inside the window function {i} opened")

				if not mxdbgScopeIsInside(local.scopeStart, scopeEnd: local.scopeEnd, codeStart: f.codeStart, codeEnd: f.codeEnd) 'scopeOutsideTheFunction'
					panic("MxdbgWriter: local {k} states [0x{local.scopeStart:x}, 0x{local.scopeEnd:x}), which is empty or outside its function's [0x{f.codeStart:x}, 0x{f.codeEnd:x}) — a record covering code its function does not own is one a debugger reads at a PC the name never lived at")
				end 'scopeOutsideTheFunction'

				if not mxdbgLocKindIsKnown(local.locKind) 'noSuchLocKind'
					panic("MxdbgWriter: local {k} names location kind {local.locKind}, which is none the reader knows")
				end 'noSuchLocKind'

				if local.locKind == MxdbgLocKindFoldedAggregate 'anAggregate'
					self.requireAggregateWindowFits(local, at: k as ElementIndex)
				end 'anAggregate'

				if not mxdbgNoneOrBelow(local.site, none: MxdbgNoInlineSite, bound: self.inlineSites.count() as MxdbgIndex) 'siteOutsideTheTable'
					panic("MxdbgWriter: local {k} is attributed to inline site {local.site}, past the {self.inlineSites.count()} this file holds — a spliced body's binding names a site its function recorded")
				end 'siteOutsideTheTable'
			end 'eachLocal'
		end 'eachFunctionsLocals'

		for (iter, site) in self.inlineSites.withIterator() 'eachSite'
			if not mxdbgNoneOrBelow(site.parent, none: MxdbgNoInlineSite, bound: iter.index() as MxdbgIndex) 'notAnEarlierSite'
				panic("MxdbgWriter: inline site {iter.index()} names site {site.parent} as its parent, which is not recorded before it — the reader refuses a parent chain that could loop")
			end 'notAnEarlierSite'

			if not mxdbgNoneOrBelow(site.callFileId, none: MxdbgNoSourceFile, bound: self.files.count() as MxdbgIndex) 'noSuchCallFile'
				panic("MxdbgWriter: inline site {iter.index()} is called from file {site.callFileId}, past the {self.files.count()} this file holds")
			end 'noSuchCallFile'
		end 'eachSite'

		for (iter, described) in self.types.withIterator() 'eachType'
			if not mxdbgNoneOrBelow(described.elementTypeId, none: MxdbgNoElementType, bound: self.types.count() as MxdbgIndex) 'noSuchElementType'
				panic("MxdbgWriter: type {iter.index()} names element type {described.elementTypeId}, past the {self.types.count()} this file holds")
			end 'noSuchElementType'
		end 'eachType'

		var previousRangeEnd = 0 as MxdbgCodeOffset

		for i in 0 upto self.inlineRanges.count() 'eachRange'
			let range = try self.inlineRanges.get(i) otherwise panic("MxdbgWriter.requireAscendingTables: inlineRanges.get OOB at {i} despite the upto bound")

			if not mxdbgCodeRangeFollows(range.codeStart, codeEnd: range.codeEnd, previousEnd: previousRangeEnd) 'rangeOutOfOrder'
				panic("MxdbgWriter: inline range {i} is [0x{range.codeStart:x}, 0x{range.codeEnd:x}) behind 0x{previousRangeEnd:x} — the ranges are disjoint and ascending by construction, and the reader binary-searches them")
			end 'rangeOutOfOrder'

			previousRangeEnd = range.codeEnd
		end 'eachRange'
	end 'requireAscendingTables'

	function requireEveryRowInAWindow(windows MxdbgLineWindowArray)
		var windowed = 0 as MxdbgIndex

		for window in windows 'eachWindow'
			windowed = windowed + window.count
		end 'eachWindow'

		if windowed != self.lines.count() as MxdbgIndex 'rowsOutsideEveryFunction'
			panic("MxdbgWriter: the functions' windows hold {windowed} of the {self.lines.count()} line rows — a row outside every function's code is one no reader reaches and the file would drop it")
		end 'rowsOutsideEveryFunction'
	end 'requireEveryRowInAWindow'
end 'MxdbgWriter'

// Records are zero-filled here and then patched at the same named field offsets the reader reads,
// so the two ends cannot disagree on where a field sits.
function appendedRecord(buf ByteArray, stride ByteOffset) returns ByteOffset
	let rec = buf.count() as ByteOffset
	writeZeros(buf, n: stride as BytePos)

	return rec
end 'appendedRecord'

// One function's slice of the line table.
type MxdbgLineWindow
	export var first as MxdbgIndex
	export var count as MxdbgIndex

	static function create(first MxdbgIndex, count MxdbgIndex) returns MxdbgLineWindow
		return Self{first: first, count: count}
	end 'create'
end 'MxdbgLineWindow'

typealias MxdbgLineWindowArray = Array with MxdbgLineWindow
