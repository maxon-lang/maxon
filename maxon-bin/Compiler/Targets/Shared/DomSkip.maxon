let SkipMinBlocks = 48
let SkipMinSpan = 4
let EntryBlockLocal = 0 as ElementIndex

type DominatorTree
	var pre as CfgIndexArray
	var size as CfgIndexArray
	var reached as BoolArray
	export var blockAt as CfgIndexArray
	export var idom as CfgIndexArray
	export var reducible as bool

	static function empty() returns DominatorTree
		return Self{pre: CfgIndexArray.create(0), size: CfgIndexArray.create(0), reached: BoolArray.create(0), blockAt: CfgIndexArray.create(0), idom: CfgIndexArray.create(0), reducible: true}
	end 'empty'

	static function of(topo FuncTopology) returns DominatorTree
		let n = topo.numBlocks
		let visited = FixedBoolArray.create(n)
		let postorder = CfgIndexArray.create(n, zeroed: false)
		rpoDfs(topo, root: EntryBlockLocal, visited: visited, postorder: postorder)

		let postIndex = FixedCfgIndexArray.create(n)

		for (position, block) in postorder.withIterator() 'eachReached'
			try postIndex.set(block, value: position.index()) otherwise panic("DominatorTree.of: postIndex.set OOB at {block}")
		end 'eachReached'

		let idom = CfgIndexArray.create(n, zeroed: false)
		idom.refill(n, value: EntryBlockLocal)
		let settled = BoolArray.create(n)
		try settled.set(EntryBlockLocal, value: true) otherwise panic("DominatorTree.of: settled.set OOB at the entry")
		var changed = true

		while changed 'untilStable'
			changed = false

			for ri in 0 upto postorder.count() 'eachInReversePostorder'
				let block = try postorder.get(postorder.count() - 1 - ri) otherwise panic("DominatorTree.of: postorder.get OOB")

				if block == EntryBlockLocal 'theEntry'
					continue
				end 'theEntry'

				var candidate = 0 as ElementIndex
				var haveCandidate = false

				for k in 0 upto topo.pred.degree(block as CsrIndex) 'eachPredecessor'
					let pred = topo.pred.neighbour(block as CsrIndex, k: k)

					if not (try settled.get(pred) otherwise panic("DominatorTree.of: settled.get OOB at {pred}")) 'notYetReached'
						continue
					end 'notYetReached'

					if not haveCandidate 'theFirst'
						candidate = pred
						haveCandidate = true
						continue
					end 'theFirst'

					candidate = intersectDominators(idom, postIndex: postIndex, a: pred, b: candidate)
				end 'eachPredecessor'

				if not (try settled.get(block) otherwise panic("DominatorTree.of: settled.get OOB at {block}")) or (try idom.get(block) otherwise panic("DominatorTree.of: idom.get OOB at {block}")) != candidate 'moved'
					try idom.set(block, value: candidate) otherwise panic("DominatorTree.of: idom.set OOB at {block}")
					try settled.set(block, value: true) otherwise panic("DominatorTree.of: settled.set OOB at {block}")
					changed = true
				end 'moved'
			end 'eachInReversePostorder'
		end 'untilStable'

		let childOf = CsrColumn.create(0)
		let children = CsrColumn.create(0)

		for block in postorder 'eachDominated'
			if block != EntryBlockLocal 'notTheEntry'
				childOf.push((try idom.get(block) otherwise panic("DominatorTree.of: idom.get OOB at {block}")) as CsrIndex)
				children.push(block as CsrIndex)
			end 'notTheEntry'
		end 'eachDominated'

		let tree = buildCsr(childOf, to: children, nodeCount: n as CsrIndex)
		let pre = CfgIndexArray.create(n)
		let size = CfgIndexArray.create(n, zeroed: false)
		size.refill(n, value: 1)
		let blockAt = CfgIndexArray.create(postorder.count(), zeroed: false)
		let stack = CfgIndexArray.create(0)
		stack.push(EntryBlockLocal)

		while stack.count() > 0 'preorder'
			let node = try stack.pop() otherwise panic("DominatorTree.of: stack.pop on a non-empty stack failed")
			try pre.set(node, value: blockAt.count()) otherwise panic("DominatorTree.of: pre.set OOB at {node}")
			blockAt.push(node)

			for k in 0 upto tree.degree(node as CsrIndex) 'eachChild'
				stack.push(tree.neighbour(node as CsrIndex, k: tree.degree(node as CsrIndex) - 1 - k))
			end 'eachChild'
		end 'preorder'

		for ri in 0 upto blockAt.count() 'eachSubtree'
			let block = try blockAt.get(blockAt.count() - 1 - ri) otherwise panic("DominatorTree.of: blockAt.get OOB")

			if block != EntryBlockLocal 'notTheEntryEither'
				let parent = try idom.get(block) otherwise panic("DominatorTree.of: idom.get OOB at {block}")
				try size.set(parent, value: (try size.get(parent) otherwise panic("DominatorTree.of: size.get OOB at {parent}")) + (try size.get(block) otherwise panic("DominatorTree.of: size.get OOB at {block}"))) otherwise panic("DominatorTree.of: size.set OOB at {parent}")
			end 'notTheEntryEither'
		end 'eachSubtree'

		let tree = Self{pre: pre, size: size, reached: settled, blockAt: blockAt, idom: idom, reducible: true}
		tree.reducible = tree.everyRetreatingEdgeIsABackEdge(topo, postIndex: postIndex, postorder: postorder)
		return tree
	end 'of'

	function everyRetreatingEdgeIsABackEdge(topo FuncTopology, postIndex FixedCfgIndexArray, postorder CfgIndexArray) returns bool
		for block in postorder 'eachReached'
			let blockPost = try postIndex.get(block) otherwise panic("DominatorTree.everyRetreatingEdgeIsABackEdge: postIndex.get OOB at {block}")

			for k in 0 upto topo.succ.degree(block as CsrIndex) 'eachSuccessor'
				let next = topo.succ.neighbour(block as CsrIndex, k: k)

				if (try postIndex.get(next) otherwise panic("DominatorTree.everyRetreatingEdgeIsABackEdge: postIndex.get OOB at {next}")) >= blockPost and not self.dominates(next, y: block) 'aRetreatingEdgeToANonDominator'
					return false
				end 'aRetreatingEdgeToANonDominator'
			end 'eachSuccessor'
		end 'eachReached'

		return true
	end 'everyRetreatingEdgeIsABackEdge'

	export function isReached(x ElementIndex) returns bool
		return try self.reached.get(x) otherwise panic("DominatorTree.isReached: block {x} out of range")
	end 'isReached'

	export function dominates(x ElementIndex, y ElementIndex) returns bool
		if not (try self.reached.get(x) otherwise panic("DominatorTree.dominates: block {x} out of range")) or not (try self.reached.get(y) otherwise panic("DominatorTree.dominates: block {y} out of range")) 'unreached'
			return false
		end 'unreached'

		let preX = try self.pre.get(x) otherwise panic("DominatorTree.dominates: block {x} out of range")
		let preY = try self.pre.get(y) otherwise panic("DominatorTree.dominates: block {y} out of range")
		return preX <= preY and preY < preX + (try self.size.get(x) otherwise panic("DominatorTree.dominates: block {x} out of range"))
	end 'dominates'

	export function dominatedCount(x ElementIndex) returns ElementIndex
		return try self.size.get(x) otherwise panic("DominatorTree.dominatedCount: block {x} out of range")
	end 'dominatedCount'

	export function preorderOf(x ElementIndex) returns ElementIndex
		return try self.pre.get(x) otherwise panic("DominatorTree.preorderOf: block {x} out of range")
	end 'preorderOf'
end 'DominatorTree'

// Lets a liveness walk mark a value live over a stretch of blocks in one step (`coversUpTo`). Block
// indices are assumed to be a layout in which every reachable block has an earlier predecessor; a
// CFG that breaks that disables the skip.
type DomSkip
	export var enabled as bool
	export var tree as DominatorTree
	export var bounds as LayoutBounds

	static function disabled() returns DomSkip
		return Self{enabled: false, tree: DominatorTree.empty(), bounds: LayoutBounds.none()}
	end 'disabled'

	static function build(topo FuncTopology, force bool) returns DomSkip
		let n = topo.numBlocks

		if n < SkipMinBlocks and not force 'tooSmallToPay'
			return DomSkip.disabled()
		end 'tooSmallToPay'

		for b in 1 upto n 'eachBlock'
			var haveForward = false

			for k in 0 upto topo.pred.degree(b as CsrIndex) 'eachPred'
				if topo.pred.neighbour(b as CsrIndex, k: k) < b 'aForwardPred'
					haveForward = true
				end 'aForwardPred'
			end 'eachPred'

			if not haveForward 'unreachableByLayout'
				return DomSkip.disabled()
			end 'unreachableByLayout'
		end 'eachBlock'

		return Self{enabled: true, tree: DominatorTree.of(topo), bounds: LayoutBounds.build(topo)}
	end 'build'

	// Every block of `(floor, b]` reaches `b` by forward edges and has no predecessor at or beyond
	// `b`, so a value live into an untouched `b` is live into all of them, and a def inside that
	// dominates `b` truncates the span. Every predecessor entering the span from outside then lies at
	// or below `floor`, which is the only place `coversUpTo` looks; a retreating predecessor of `b`
	// would not, so it refuses.
	export function coverFloor(b ElementIndex) returns (bool, ElementIndex)
		if b < SkipMinSpan or self.bounds.hasRetreatingPred(b) 'nothingToCover'
			return (false, b)
		end 'nothingToCover'

		let stranded = try self.bounds.lastStrandedBelow(b) otherwise EntryBlockLocal
		let enteredFromBeyond = try self.bounds.lastEnteredFromBeyondBelow(b) otherwise EntryBlockLocal
		let limit = stranded if stranded > enteredFromBeyond else enteredFromBeyond

		if b - limit < SkipMinSpan 'tooShortToPay'
			return (false, b)
		end 'tooShortToPay'

		return (true, limit)
	end 'coverFloor'
end 'DomSkip'

function intersectDominators(idom CfgIndexArray, postIndex FixedCfgIndexArray, a ElementIndex, b ElementIndex) returns ElementIndex
	var finger = a
	var other = b

	while finger != other 'untilTheyMeet'
		while (try postIndex.get(finger) otherwise panic("intersectDominators: postIndex.get OOB at {finger}")) < (try postIndex.get(other) otherwise panic("intersectDominators: postIndex.get OOB at {other}")) 'fingerClimbs'
			finger = try idom.get(finger) otherwise panic("intersectDominators: idom.get OOB at {finger}")
		end 'fingerClimbs'

		while (try postIndex.get(other) otherwise panic("intersectDominators: postIndex.get OOB at {other}")) < (try postIndex.get(finger) otherwise panic("intersectDominators: postIndex.get OOB at {finger}")) 'otherClimbs'
			other = try idom.get(other) otherwise panic("intersectDominators: idom.get OOB at {other}")
		end 'otherClimbs'
	end 'untilTheyMeet'

	return finger
end 'intersectDominators'

type LayoutBounds
	var leafBase as ElementIndex
	var highestPred as CfgIndexArray
	var nearestForwardSucc as CfgIndexArray
	export var enteringPreds as PredLevels

	static function none() returns LayoutBounds
		return Self{leafBase: 1, highestPred: CfgIndexArray.create(0), nearestForwardSucc: CfgIndexArray.create(0), enteringPreds: PredLevels.none()}
	end 'none'

	static function build(topo FuncTopology) returns LayoutBounds
		let n = topo.numBlocks
		let leafBase = roundUpToPowerOfTwo(n as BytePos)
		let highestPred = CfgIndexArray.create(leafBase + leafBase)
		let nearestForwardSucc = CfgIndexArray.create(leafBase + leafBase)

		for y in 0 upto n 'eachBlock'
			var highest = 0 as ElementIndex
			var nearest = n
			let predDeg = topo.pred.degree(y as CsrIndex)

			for k in 0 upto predDeg 'eachPred'
				let q = topo.pred.neighbour(y as CsrIndex, k: k)

				if q > highest 'higher'
					highest = q
				end 'higher'
			end 'eachPred'

			let succDeg = topo.succ.degree(y as CsrIndex)

			for k in 0 upto succDeg 'eachSucc'
				let s = topo.succ.neighbour(y as CsrIndex, k: k)

				if s > y and s < nearest 'nearer'
					nearest = s
				end 'nearer'
			end 'eachSucc'

			try highestPred.set(leafBase + y, value: highest) otherwise panic("LayoutBounds.build: highestPred.set OOB at block {y}")
			try nearestForwardSucc.set(leafBase + y, value: nearest) otherwise panic("LayoutBounds.build: nearestForwardSucc.set OOB at block {y}")
		end 'eachBlock'

		foldMaxUp(highestPred, leafBase: leafBase)
		foldMaxUp(nearestForwardSucc, leafBase: leafBase)
		return Self{leafBase: leafBase, highestPred: highestPred, nearestForwardSucc: nearestForwardSucc, enteringPreds: PredLevels.build(topo, leafBase: leafBase)}
	end 'build'

	function hasRetreatingPred(b ElementIndex) returns bool
		return (try self.highestPred.get(self.leafBase + b) otherwise panic("LayoutBounds.hasRetreatingPred: highestPred.get OOB at block {b}")) >= b
	end 'hasRetreatingPred'

	function lastStrandedBelow(b ElementIndex) returns ElementIndex throws NoBlockExceeds
		return try lastExceedingBelow(self.nearestForwardSucc, leafBase: self.leafBase, below: b, bound: b)
	end 'lastStrandedBelow'

	function lastEnteredFromBeyondBelow(b ElementIndex) returns ElementIndex throws NoBlockExceeds
		return try lastExceedingBelow(self.highestPred, leafBase: self.leafBase, below: b, bound: b - 1)
	end 'lastEnteredFromBeyondBelow'
end 'LayoutBounds'

type PredLevels
	var blockStart as CfgIndexArray
	var sorted as CfgIndexArray
	let edgeCount as ElementIndex

	static function none() returns PredLevels
		return Self{blockStart: CfgIndexArray.create(0), sorted: CfgIndexArray.create(0), edgeCount: 0}
	end 'none'

	// Each block's predecessor list is a leaf of the merge-sort tree as it stands, so it must already
	// be ascending, which `permuteTopology` guarantees.
	static function build(topo FuncTopology, leafBase ElementIndex) returns PredLevels
		let n = topo.numBlocks
		let edgeCount = topo.pred.list.count()
		var levelCount = 1 as ElementIndex
		var width = 1 as ElementIndex

		while width < leafBase 'eachLevel'
			width = width + width
			levelCount = levelCount + 1
		end 'eachLevel'

		let blockStart = CfgIndexArray.create(leafBase + 1, zeroed: false)
		blockStart.refill(leafBase + 1, value: edgeCount)

		for z in 0 upto n 'eachBlockStart'
			try blockStart.set(z, value: try topo.pred.start.get(z) otherwise panic("PredLevels.build: pred.start.get OOB at block {z}")) otherwise panic("PredLevels.build: blockStart.set OOB at block {z}")
		end 'eachBlockStart'

		let sorted = CfgIndexArray.create(levelCount * edgeCount)

		for z in 0 upto n 'eachBlock'
			let degree = topo.pred.degree(z as CsrIndex)

			for k in 0 upto degree 'eachPred'
				let p = topo.pred.neighbour(z as CsrIndex, k: k)
				let at = (try blockStart.get(z) otherwise panic("PredLevels.build: blockStart.get OOB at block {z}")) + k

				if k > 0 and p < topo.pred.neighbour(z as CsrIndex, k: k - 1) 'unsorted'
					panic("PredLevels.build: the predecessors of block {z} are not in ascending order")
				end 'unsorted'

				try sorted.set(at, value: p) otherwise panic("PredLevels.build: sorted.set OOB at {at}")
			end 'eachPred'
		end 'eachBlock'

		var childWidth = 1 as ElementIndex

		for level in 0 upto levelCount - 1 'eachMerge'
			var first = 0 as ElementIndex

			while first < n 'eachParent'
				let lowStart = try blockStart.get(first) otherwise panic("PredLevels.build: blockStart.get OOB at {first}")
				let midStart = try blockStart.get(first + childWidth) otherwise panic("PredLevels.build: blockStart.get OOB at {first + childWidth}")
				let highStart = try blockStart.get(first + childWidth + childWidth) otherwise panic("PredLevels.build: blockStart.get OOB at {first + childWidth + childWidth}")
				mergeAscending(sorted, from: level * edgeCount, to: (level + 1) * edgeCount, low: lowStart, mid: midStart, high: highStart)
				first = first + childWidth + childWidth
			end 'eachParent'

			childWidth = childWidth + childWidth
		end 'eachMerge'

		return Self{blockStart: blockStart, sorted: sorted, edgeCount: edgeCount}
	end 'build'

	export function largestAtMost(lo ElementIndex, hi ElementIndex, bound ElementIndex) returns (bool, ElementIndex)
		var found = false
		var best = 0 as ElementIndex
		var left = lo
		var right = hi + 1
		var level = 0 as ElementIndex
		var width = 1 as ElementIndex

		while left < right 'eachLevel'
			if left mod 2 == 1 'leftIsARightChild'
				(found, best) = self.considerNode(found, best: best, level: level, node: left, width: width, bound: bound)
				left = left + 1
			end 'leftIsARightChild'

			if right mod 2 == 1 'rightIsARightChild'
				right = right - 1
				(found, best) = self.considerNode(found, best: best, level: level, node: right, width: width, bound: bound)
			end 'rightIsARightChild'

			left = left / 2
			right = right / 2
			level = level + 1
			width = width + width
		end 'eachLevel'

		return (found, best)
	end 'largestAtMost'

	function considerNode(found bool, best ElementIndex, level ElementIndex, node ElementIndex, width ElementIndex, bound ElementIndex) returns (bool, ElementIndex)
		let base = level * self.edgeCount
		var low = try self.blockStart.get(node * width) otherwise panic("PredLevels.considerNode: blockStart.get OOB at {node * width}")
		let segmentStart = low
		var high = try self.blockStart.get((node + 1) * width) otherwise panic("PredLevels.considerNode: blockStart.get OOB at {(node + 1) * width}")

		while low < high 'bisect'
			let mid = low + (high - low) / 2

			if (try self.sorted.get(base + mid) otherwise panic("PredLevels.considerNode: sorted.get OOB at {base + mid}")) <= bound 'rightHalf'
				low = mid + 1
			end 'rightHalf' else 'leftHalf'
				high = mid
			end 'leftHalf'
		end 'bisect'

		if low == segmentStart 'nothingAtMost'
			return (found, best)
		end 'nothingAtMost'

		let candidate = try self.sorted.get(base + low - 1) otherwise panic("PredLevels.considerNode: sorted.get OOB at {base + low - 1}")

		if found and candidate <= best 'notBetter'
			return (found, best)
		end 'notBetter'

		return (true, candidate)
	end 'considerNode'
end 'PredLevels'

function mergeAscending(sorted CfgIndexArray, from ElementIndex, to ElementIndex, low ElementIndex, mid ElementIndex, high ElementIndex)
	var left = low
	var right = mid
	var out = low

	while out < high 'eachOutput'
		var takeLeft = right >= high

		if left < mid and right < high 'bothRemain'
			takeLeft = (try sorted.get(from + left) otherwise panic("mergeAscending: sorted.get OOB at {from + left}")) <= (try sorted.get(from + right) otherwise panic("mergeAscending: sorted.get OOB at {from + right}"))
		end 'bothRemain'

		if takeLeft 'fromTheLeft'
			try sorted.set(to + out, value: try sorted.get(from + left) otherwise panic("mergeAscending: sorted.get OOB at {from + left}")) otherwise panic("mergeAscending: sorted.set OOB at {to + out}")
			left = left + 1
		end 'fromTheLeft' else 'fromTheRight'
			try sorted.set(to + out, value: try sorted.get(from + right) otherwise panic("mergeAscending: sorted.get OOB at {from + right}")) otherwise panic("mergeAscending: sorted.set OOB at {to + out}")
			right = right + 1
		end 'fromTheRight'

		out = out + 1
	end 'eachOutput'
end 'mergeAscending'

function foldMaxUp(tree CfgIndexArray, leafBase ElementIndex)
	for ri in 1 upto leafBase 'eachNode'
		let node = leafBase - ri
		let left = try tree.get(node + node) otherwise panic("foldMaxUp: tree.get OOB at {node + node}")
		let right = try tree.get(node + node + 1) otherwise panic("foldMaxUp: tree.get OOB at {node + node + 1}")
		try tree.set(node, value: left if left > right else right) otherwise panic("foldMaxUp: tree.set OOB at {node}")
	end 'eachNode'
end 'foldMaxUp'

enum NoBlockExceeds implements Error
	noneExceeds
end 'NoBlockExceeds'

function lastExceedingBelow(tree CfgIndexArray, leafBase ElementIndex, below ElementIndex, bound ElementIndex) returns ElementIndex throws NoBlockExceeds
	var x = leafBase + below

	while x > 1 'climb'
		if x mod 2 == 1 'aRightChild'
			var sibling = x - 1

			if (try tree.get(sibling) otherwise panic("lastExceedingBelow: tree.get OOB at {sibling}")) > bound 'itHoldsOne'
				while sibling < leafBase 'descend'
					let right = sibling + sibling + 1

					if (try tree.get(right) otherwise panic("lastExceedingBelow: tree.get OOB at {right}")) > bound 'inTheRightHalf'
						sibling = right
					end 'inTheRightHalf' else 'inTheLeftHalf'
						sibling = sibling + sibling
					end 'inTheLeftHalf'
				end 'descend'

				return sibling - leafBase
			end 'itHoldsOne'
		end 'aRightChild'

		x = x / 2
	end 'climb'

	throw NoBlockExceeds.noneExceeds
end 'lastExceedingBelow'
