// Register allocator (pure Design B: SSA chordal coloring + gap
// splitting + E5001; design in docs/internals/register-allocation.md). Spine:
// cold-spill splitting → liveness → biased forward-sweep coloring → SSA destruction. It uses
// the `Reuse` operand model, so there is no pre-emitted two-address seed `mov`: ISel
// emits ONE reuse-def op (`sub`/`imul`/`neg`) and THIS pass materializes the copy only
// when the reuse input outlives the op (`allocateReuseDef`).
//
// WHAT GATES IT. Two things, and they are the SUITE, not a pass inside the compiler:
//   * RUNNING a spec test proves the allocation is CORRECT. A value left in the wrong register
//     computes the wrong answer, and the test's exit-code assertion catches it end-to-end.
//   * The `TargetIr` pins in `ir-specs/` prove the code did not get WORSE, for the cases that carry
//     one. An extra spill, a lost coalesce, a needlessly widened live range: each still returns the
//     right answer, so only the pinned Target IR can see it. A pin also reaches where the run
//     cannot — one execution takes ONE path, but the pin covers EVERY block of the function.
//     `maxon spec-test ir-specs` FAILS on a mismatch; `--update-required` re-mints.
// (There is no third, symbolic gate: it would verify, at ~10% of every compile, a property the two
// above already decide. The one non-allocation check worth keeping, the CFG `condBranch`-index sweep,
// lives in `TargetLiveness.checkCondBranchIndex`, where it runs on EVERY build rather than only under
// `spec-test`.)
//
// The pieces:
//   • liveness/loops/pressure           — TargetLiveness.maxon
//   • dense bitsets + register masks     — RegBits.maxon
//   • the operand model                  — TargetOperands.maxon (Def/Use, Reuse)
//   • cold-spill live-range splitting    — SplitLiveRanges.maxon
//   • biased forward-sweep colorer       — this file
//   • SSA destruction (edge copies/xchg) — SsaDestruction.maxon
//
// What the colorer rests on (docs/internals/register-allocation.md; Rule 2, spill placement, is the
// splitter's):
//   RULE 1 (SSA). Every value has one def dominating its uses, so live ranges are
//     dominance-closed, the interference graph is CHORDAL, and dominance-order
//     greedy coloring is EXACT (χ = ω = maxPressure). Layout order is a perfect
//     elimination order, ASSERTED by "every use is already colored" at each op.
//   BIASED COLORING is CORRECTNESS, not optimization. Copy-related values
//     (a phi and its back-edge arg; a reuse def and its two-address input) hold the
//     same value; coloring them together (a) keeps a loop's back-edge / reuse copy
//     from landing IN the loop and (b) stops a false E5001 by not counting one value
//     as two. Hints come from block-arg/branch-arg pairs (collectPhiEdgeHints) and
//     from reuse-def/input pairs (collectReuseHints).
//
// The forms it is BUILT for: immediate operand forms + 3-operand lea + the `Reuse`-based
// seed-`mov` deletion; idiv/mod FIXED registers — RAX/RDX pinned via implicit masks +
// `forbidOperandsFromImplicit` + the clobber→forbidden path.
//
// The COLD-SPILL SPLITTER (`SplitLiveRanges`) runs BEFORE this colorer and relieves
// every over-pool program point — full-pool overflow at a normal op AND reduced-pool
// overflow at a FIXED-REGISTER point. `maxPressure ≤ pool` alone is NECESSARY but NOT
// SUFFICIENT at such a point: at an `idiv`, values live across it are forbidden {RAX,RDX}
// (effective pool `pool ∖ {RAX,RDX}`); at a call, the callee-saved subset (docs/internals/register-allocation.md,
// Effective pools). The splitter's peak-finder checks each op against its OWN
// reduced pool (`pool ∖ op.implicitDefs`) and splits values live across it, so by the time
// this colorer runs no point — normal or fixed-register — overflows its pool.
//
// ⛔⛔ **THAT IS NOT "COLORING CANNOT FAIL".** Pointwise feasibility says a
// colouring EXISTS; it does not say the greedy will FIND one, and no static order does —
// **`HallCondition.hallVerdictAt`'s header carries that argument and is the one place it is made.** So
// the colorer CAN fail on a point that fits, and when it does the value is a CONFINEMENT, not pressure:
// `reportExhaustion` runs the exact verdict to tell the two apart, records the value, and
// `colorRepairingConfinements` relieves it before colouring again. The half that IS true is asserted:
// reaching exhaustion with an OVERFLOW verdict is a splitter bug.
//
// A HOT overflow the splitter cannot relieve (a loop whose own working set does not fit) is
// NOT a panic: it is the E5001 compile error, source-mapped via `ValueOrigin` and rendered by
// `RegisterPressureDiagnostic`. Hence `throws CompileError` down this whole path.

// A per-function coloring: value id → physical register number, absent until the value is
// colored. A value holds ONE register for its whole range.
export type Allocation
	export var color as RegisterColumn
	export var valueCount as ValueId

	// The INVERSE of `color`, for the registers held RIGHT NOW: register number -> the value
	// occupying it. `colorFunction`'s in-use mask says a register is HELD; only this says by WHOM,
	// and "by whom" is the whole of the exhaustion diagnostic — without it the panic can only
	// GUESS which pass owns the failure, and the guess it shipped ("reaching this is a SPLITTER
	// BUG") was measured false on every program that reaches it (see `chooseRegister`).
	//
	// It is EXACT, not a last-writer approximation, because it is refreshed from the live-ins at
	// every block entry (`seedInUse`) as well as at every def: a register held at any point of a
	// block is held either by a live-in seeded there or by a def coloured since. A last-writer map
	// alone would name a sibling block's occupant for a live-in register and hand the diagnostic's
	// Hall verdict a live set the point does not have.
	var holderOfReg as FixedValueIdArray

	export static function create(valueCount ValueId) returns Allocation
		// Each column is BUILT as its own declared instance: `RegNum` strides ONE byte and `DenseInt` EIGHT
		// (`rangedAliasStorageBytes`), so a buffer filled as one and read as the other would hand every later
		// read a stride it was not written at.
		let color = RegisterColumn.absent(valueCount)
		var holderOfReg = FixedValueIdArray.create(RegisterFileSize)

		return Self{color: color, valueCount: valueCount, holderOfReg: holderOfReg}
	end 'create'

	export function isColored(v ValueId) returns bool
		return self.color.holds(v)
	end 'isColored'

	// The register NUMBER assigned to `v` (panics if uncolored — a coloring bug).
	export function regNumOf(v ValueId) returns RegNum
		return try self.color.get(v) otherwise panic("Allocation.regNumOf: value {v} is uncolored — a use was reached before its def was colored (dominance-order violation)")
	end 'regNumOf'

	export function assign(v ValueId, regNum RegNum)
		self.color.set(v, value: regNum)
		self.noteHolder(v, regNum: regNum)
	end 'assign'

	// `v` occupies `regNum` from here on. Called at every def (through `assign`) and, for a value
	// coloured in a dominator, at every block entry it is live into — see `holderOfReg`.
	export function noteHolder(v ValueId, regNum RegNum)
		try self.holderOfReg.set(regNum, value: v) otherwise panic("Allocation.noteHolder: register {regNum} is outside the unified register file")
	end 'noteHolder'

	// Which value occupies `regNum`. Only meaningful for a register the colorer's in-use mask says is
	// HELD; there is no "unoccupied" answer, and none is needed — every caller reads it through that
	// mask. `valuesHoldingRegisters` masks with `held and classPool`; `StuckValues.record` masks with
	// `A(v)`, which the exhaustion premise `classPool ⊆ held ∪ forbidden(v)` puts inside `held`;
	// `ColdCallBracketPlan.record` is handed only registers of the in-use mask.
	export function holderOf(regNum RegNum) returns ValueId
		return try self.holderOfReg.get(regNum) otherwise panic("Allocation.holderOf: register {regNum} is outside the unified register file")
	end 'holderOf'
end 'Allocation'

// The reuse-def copies the allocator must MATERIALIZE: `mov destReg, srcReg` spliced in BEFORE
// an op. One is recorded when a two-address reuse def (`sub`/`imul`/`neg`) could NOT be colored
// into its input's register — because the input OUTLIVES the op (its register is still
// occupied), or because a fixed hint (the R8 return value) claimed the destination first. The
// input must therefore be preserved in its own register and copied into the destination before
// the op runs on it. When the input DIES at the op and no fixed hint intervenes, biased coloring
// lands the destination in the input's register and NO copy is recorded — the common case, and
// the whole point of the reuse model. `destReg != srcReg` always (a same-register copy is a
// no-op, never recorded).
//
// KEYED BY THE OP'S LAYOUT SEQUENCE within the function (blocks in order, each block's body ops
// then its terminator — the `IrBlock.collectOpsInRunOrder` numbering), so the lookup is a column
// index rather than a scan. The colorer records at that sequence and `applyAllocation`'s splice walks the
// function in exactly that order and reads at exactly that sequence. It cannot be keyed by
// `module.ops` index instead: op
// indices are module-global and a function's are not contiguous (the splitter appends its spill
// ops at the end of the table), so a column keyed by them would be the size of the whole module,
// per function. A list scanned per op was O(ops × copies) — the same quadratic shape the splitter
// had.
export type ReuseCopyPlan
	var destRegs as RegisterColumn
	var srcRegs as RegisterColumn

	export static function create() returns ReuseCopyPlan
		return Self{destRegs: RegisterColumn.create(), srcRegs: RegisterColumn.create()}
	end 'create'

	// Record the copy for the op at layout sequence `seq`. The columns grow to fit rather than
	// being sized up front: a function with no reuse copy at all then allocates nothing.
	export function record(seq OpSeq, destReg RegNum, srcReg RegNum)
		self.destRegs.growAbsent((seq + 1) as ElementIndex)
		self.srcRegs.growAbsent((seq + 1) as ElementIndex)
		self.destRegs.set(seq, value: destReg)
		self.srcRegs.set(seq, value: srcReg)
	end 'record'

	// Is there a copy to splice before the op at layout sequence `seq`? A sequence past the last
	// recorded copy carries none by construction (the columns only grow to the last one). A bool and
	// two register reads rather than one union answer: a payload-bearing union heap-boxes every case
	// including the payload-free one (`CseLookup`), and this is asked at every body op of every function.
	export function hasCopyAt(seq OpSeq) returns bool
		if seq >= self.destRegs.count() as OpSeq 'pastLastCopy'
			return false
		end 'pastLastCopy'

		return self.destRegs.holds(seq)
	end 'hasCopyAt'

	// The two registers of the copy at `seq`; meaningful only where `hasCopyAt` holds.
	export function destRegAt(seq OpSeq) returns RegNum
		return try self.destRegs.get(seq) otherwise panic("ReuseCopyPlan.destRegAt: no copy recorded at sequence {seq} — ask `hasCopyAt` first")
	end 'destRegAt'

	export function srcRegAt(seq OpSeq) returns RegNum
		return try self.srcRegs.get(seq) otherwise panic("ReuseCopyPlan.srcRegAt: no copy recorded at sequence {seq} — ask `hasCopyAt` first")
	end 'srcRegAt'

	// Forget every copy — a colouring pass that ended with a value the colorer could not place is thrown
	// away, and its copies with it. Carrying one into the next pass would splice a `mov` between two
	// registers that pass never chose. `hasCopyAt` reads `count()` as "past the last copy", so emptying
	// the two columns is the whole of it, and the CAPACITY is kept: the pass that follows records into
	// the same function's sequence space.
	export function clear()
		self.destRegs.truncate(0)
		self.srcRegs.truncate(0)
	end 'clear'
end 'ReuseCopyPlan'

typealias BracketPayloadArray = Array with MachineWord

export enum BracketEntryKind
	slot
	immediate
end 'BracketEntryKind'

typealias BracketEntryKindArray = Array with BracketEntryKind

// ⭐ **THE COLD-RUN BRACKETS ONE COLOURING PASS PLANNED.** In a cold block (`BlockHeat.cold`) no op
// confines the values live across it (`opClobberMask`); instead every register a value holds across an
// op that writes it is SAVED before and RELOADED after (a constant is REBUILT after instead), and
// the unit of that is a RUN, not an op:
//
//   THE REGION RULE. A run is a maximal sequence of clobbering ops — argument pre-moves, the call, an
//   `idiv` — closed by the captures that read its call's answer and the spill stores of what they
//   captured; the runs of a cold block are computed
//   once, by one walk, and read by every consumer (`ColdBlockRuns`). The bracket saves, before the
//   run's FIRST op, every register that a value live at the run's start still holds at some run op that
//   writes it, and reloads them all after the run's LAST op — one save and one reload per register per
//   run, never a pair per op. A pre-move's own write is therefore paid exactly as the call's is, so
//   nothing in a run confines the hot path around it.
//
//   What the bracket cannot cover, liveness confines instead: a value the run's later ops READ after a
//   clobber it is live across — a survivor read by a pre-move after an earlier pre-move — which must not
//   sit in the clobbered register, since its read would see the argument (`ColdRunSweep`). And an op
//   that DEFINES A VIRTUAL is no run op at all: a value born inside a run would have no save point, so
//   such an op — a float negation through an xmm scratch, an arm64 atomic through x16/x17 — keeps its
//   implicit scratch confining exactly as in a normal block (`coldRunOpKind`).
//
// A bracket names REGISTERS: what it preserves is a register's contents over one run, so the
// colorer records the held mask and `record` reads each register's holder only to choose how its
// contents come back. A holder that is a constant rebuildable from an immediate
// (`UseIndex.isRebuildableFromImmediate`) needs no slot: `mov reg, imm` after the run restores
// exactly the bits the register held, with no store before and no load after. Every other holder
// gets a save slot, one per register for the whole function — two brackets never overlap (each is
// its stores, the run, its loads, with nothing of another bracket between), so one slot per
// register serves every cold run, and the frame grows by at most the register file, never by the
// number of cold sites.
//
// KEYED BY THE RUN'S LAYOUT SEQUENCES like `ReuseCopyPlan` — the first op's for the saves, the last
// op's for the reloads — but read back with a CURSOR rather than a dense column: the colorer records in
// layout order and the rewrite walks in the same order, so the next bracket is always the next entry.
// Cold runs are sparse, and a column the length of the function would be paid by every function for the
// few that have any — which is also why the per-register slot tables are sized by a pass's FIRST mint
// rather than at `beginPass`: most functions never mint one.
//
// The rewrite's read (`takeAt`) answers a bool and leaves the taken bracket OPEN for `openEntryCount` /
// `openRegAt` / `openKindAt` / `openSlotAt` / `openImmediateOpAt` / `openReloadSeq` rather than
// returning a union: a payload-bearing union heap-boxes every case including the payload-free one
// (`CseLookup`), and `takeAt` is asked at every body op of every function.
export type ColdCallBracketPlan
	var saveSeqs as OpSeqArray
	var reloadSeqs as OpSeqArray

	// CSR over `regs`/`kinds`/`payloads`: bracket k's entries are `[ends[k-1], ends[k])`, the first's
	// from 0. An entry's payload is its `SpillSlot` when its kind is `slot` and the `MachineWord` to
	// rebuild when it is `immediate`.
	var ends as ColumnLengthColumn
	var regs as RegNumColumn
	var kinds as BracketEntryKindArray
	var payloads as BracketPayloadArray

	// The ISA of the function's ops, which picks the encoding `openImmediateOpAt` builds.
	var isArm64 as bool

	// The save slot each register was given this pass, indexed by `RegNum` and meaningful only where
	// `regHasSlot` holds; both are empty until the pass's first mint.
	var slotOfReg as SpillSlotArray
	var regHasSlot as BoolArray
	var nextSlot as SpillSlot

	// The rewrite's position in `saveSeqs`: the bracket at `cursor - 1` is the one last taken.
	var cursor as ElementIndex

	export static function create(isArm64 bool) returns ColdCallBracketPlan
		return Self{saveSeqs: OpSeqArray.create(0), reloadSeqs: OpSeqArray.create(0), ends: ColumnLengthColumn.create(0), regs: RegNumColumn.create(0), kinds: BracketEntryKindArray.create(0), payloads: BracketPayloadArray.create(0), isArm64: isArm64, slotOfReg: SpillSlotArray.create(0), regHasSlot: BoolArray.create(0), nextSlot: 0, cursor: 0}
	end 'create'

	// Forget every bracket and every slot — a pass that ended with a stuck value is discarded whole — and
	// take the frame's current floor, which a repair between two passes may have raised. Every column
	// keeps its capacity, so a pass after the first allocates nothing here.
	export function beginPass(frameSlotCount SpillSlot)
		self.saveSeqs.clear()
		self.reloadSeqs.clear()
		self.ends.clear()
		self.regs.clear()
		self.kinds.clear()
		self.payloads.clear()
		self.regHasSlot.clear()
		self.slotOfReg.clear()
		self.nextSlot = frameSlotCount
		self.cursor = 0
	end 'beginPass'

	// Record the bracket of the run spanning layout sequences `[saveSeq, reloadSeq]`: every register in
	// `held`, each as one entry whose kind its holder decides. Runs arrive in increasing order and
	// never overlap, which is what the rewrite's cursor rests on.
	//
	// This is the only writer of `regs`, `kinds` and `payloads`; it appends one entry to each per
	// register, in ascending register order, so the three share the one CSR `ends`.
	export function record(saveSeq OpSeq, reloadSeq OpSeq, held RegMask, module TargetModule, alloc Allocation, liveness LivenessResult)
		if self.saveSeqs.count() > 0 and saveSeq <= (try self.reloadSeqs.get(self.reloadSeqs.count() - 1) otherwise panic("ColdCallBracketPlan.record: reloadSeqs.get OOB on the entry just counted")) 'outOfOrder'
			panic("ColdCallBracketPlan.record: a run starting at sequence {saveSeq} inside or before the run last recorded — the colorer records runs in layout order and they never overlap")
		end 'outOfOrder'

		if reloadSeq < saveSeq 'inverted'
			panic("ColdCallBracketPlan.record: a run whose reload sequence {reloadSeq} precedes its save sequence {saveSeq}")
		end 'inverted'

		self.saveSeqs.push(saveSeq)
		self.reloadSeqs.push(reloadSeq)
		var remaining = held

		while remaining != 0 'eachHeldRegister'
			let regNum = regMaskLowest(remaining)
			remaining = regMaskRemove(remaining, regNum: regNum)
			let holder = alloc.holderOf(regNum)
			self.regs.push(regNum)

			if liveness.useIndex.isRebuildableFromImmediate(holder) 'immediateHolder'
				requireIntegerRegister(regNum, holder: holder, liveness: liveness)
				self.kinds.push(BracketEntryKind.immediate)
				self.payloads.push(self.immediateOf(module, holder: holder, liveness: liveness))
			end 'immediateHolder' else 'slotHolder'
				self.kinds.push(BracketEntryKind.slot)
				self.payloads.push(self.slotFor(regNum) as MachineWord)
			end 'slotHolder'
		end 'eachHeldRegister'

		self.ends.push(self.regs.count())
	end 'record'

	// The rebuild is made by `openImmediateOpAt` in the plan's ISA, so the def's immediate must come
	// from that ISA's constant op.
	function immediateOf(module TargetModule, holder ValueId, liveness LivenessResult) returns MachineWord
		let (value, defIsArm64) = constDefInfo(module, opIdx: liveness.useIndex.requireDefOp(holder))

		if defIsArm64 != self.isArm64 'otherIsa'
			panic("ColdCallBracketPlan.immediateOf: value {holder} is defined by a constant materialization with arm64={defIsArm64} in a plan made for arm64={self.isArm64} — one function holds one ISA's ops")
		end 'otherIsa'

		return value
	end 'immediateOf'

	function slotFor(regNum RegNum) returns SpillSlot
		if self.regHasSlot.count() == 0 'firstMintOfThisPass'
			self.regHasSlot.refill(RegisterFileSize as ElementIndex, value: false)
			self.slotOfReg.refill(RegisterFileSize as ElementIndex, value: 0)
		end 'firstMintOfThisPass'

		let minted = try self.regHasSlot.get(regNum) otherwise panic("ColdCallBracketPlan.slotFor: regHasSlot.get OOB at register {regNum}")

		if minted 'alreadyHasASlot'
			return try self.slotOfReg.get(regNum) otherwise panic("ColdCallBracketPlan.slotFor: slotOfReg.get OOB at register {regNum}")
		end 'alreadyHasASlot'

		let slot = self.nextSlot
		self.nextSlot = self.nextSlot + 1
		try self.regHasSlot.set(regNum, value: true) otherwise panic("ColdCallBracketPlan.slotFor: regHasSlot.set OOB at register {regNum}")
		try self.slotOfReg.set(regNum, value: slot) otherwise panic("ColdCallBracketPlan.slotFor: slotOfReg.set OOB at register {regNum}")
		return slot
	end 'slotFor'

	// One past the highest slot this pass minted — what the frame must cover (`SplitDriver.extendFrameTo`).
	export function frameSlotCount() returns SpillSlot
		return self.nextSlot
	end 'frameSlotCount'

	// The rewrite's read: does the next run start at layout sequence `seq`? When it does, it becomes
	// the open bracket and the cursor moves past it.
	export function takeAt(seq OpSeq) returns bool
		if self.cursor >= (self.saveSeqs.count()) 'pastTheLastBracket'
			return false
		end 'pastTheLastBracket'

		let next = try self.saveSeqs.get(self.cursor) otherwise panic("ColdCallBracketPlan.takeAt: saveSeqs.get OOB at cursor {self.cursor}")

		if next != seq 'notThisOp'
			return false
		end 'notThisOp'

		self.cursor = self.cursor + 1
		return true
	end 'takeAt'

	// A bracket the rewrite never reached would be a save and a reload silently missing from a cold run,
	// so the walk that consumes the plan asks this when it is done.
	export function requireAllTaken()
		if self.cursor != (self.saveSeqs.count()) 'bracketsLeftOver'
			panic("ColdCallBracketPlan.requireAllTaken: {self.saveSeqs.count() - self.cursor} bracket(s) were planned at layout sequences the rewrite never visited — the colorer's numbering and the rewrite's have drifted")
		end 'bracketsLeftOver'
	end 'requireAllTaken'

	// The layout sequence of the open run's last op — the op its reloads land after.
	export function openReloadSeq() returns OpSeq
		return try self.reloadSeqs.get(self.openIndex()) otherwise panic("ColdCallBracketPlan.openReloadSeq: reloadSeqs.get OOB at the open bracket")
	end 'openReloadSeq'

	export function openEntryCount() returns ElementIndex
		let index = self.openIndex()
		return self.entryEnd(index) - self.entryStart(index)
	end 'openEntryCount'

	export function openRegAt(entry ElementIndex) returns RegNum
		return try self.regs.get(self.entryStart(self.openIndex()) + entry) otherwise panic("ColdCallBracketPlan.openRegAt: entry {entry} is past the {self.openEntryCount()} the open bracket holds")
	end 'openRegAt'

	export function openKindAt(entry ElementIndex) returns BracketEntryKind
		return try self.kinds.get(self.entryStart(self.openIndex()) + entry) otherwise panic("ColdCallBracketPlan.openKindAt: entry {entry} is past the {self.openEntryCount()} the open bracket holds")
	end 'openKindAt'

	export function openSlotAt(entry ElementIndex) returns SpillSlot
		match self.openKindAt(entry) 'kind'
			slot then return self.openPayloadAt(entry) as SpillSlot
			immediate then panic("ColdCallBracketPlan.openSlotAt: entry {entry} of the open bracket is an immediate, which owns no slot")
		end 'kind'
	end 'openSlotAt'

	export function openImmediateOpAt(entry ElementIndex) returns TargetOp
		match self.openKindAt(entry) 'kind'
			immediate then return freshConstOp(self.isArm64, dest: TargetVReg.physical(self.openRegAt(entry)), value: self.openPayloadAt(entry))
			slot then panic("ColdCallBracketPlan.openImmediateOpAt: entry {entry} of the open bracket is a saved register, which holds no immediate")
		end 'kind'
	end 'openImmediateOpAt'

	function openPayloadAt(entry ElementIndex) returns MachineWord
		return try self.payloads.get(self.entryStart(self.openIndex()) + entry) otherwise panic("ColdCallBracketPlan.openPayloadAt: entry {entry} is past the {self.openEntryCount()} the open bracket holds")
	end 'openPayloadAt'

	// The bracket `takeAt` last took.
	function openIndex() returns ElementIndex
		if self.cursor == 0 'nothingTaken'
			panic("ColdCallBracketPlan.openIndex: no bracket has been taken — the rewrite reads a bracket only after `takeAt` answered true for it")
		end 'nothingTaken'

		return self.cursor - 1
	end 'openIndex'

	function entryStart(index ElementIndex) returns ElementIndex
		return 0 if index == 0 else self.entryEnd(index - 1)
	end 'entryStart'

	function entryEnd(index ElementIndex) returns ElementIndex
		return try self.ends.get(index) otherwise panic("ColdCallBracketPlan.entryEnd: no bracket {index} of {self.saveSeqs.count()}")
	end 'entryEnd'
end 'ColdCallBracketPlan'

// The rebuild is an integer `mov reg, imm` written into the register the holder occupies. Nothing
// downstream would object to one written into a vector register, so a register outside the integer
// file, or in a different file from its holder's class, panics here.
function requireIntegerRegister(regNum RegNum, holder ValueId, liveness LivenessResult)
	let registerClass = regClassIn(regNum, file: liveness.registerFile)

	if registerClass != liveness.classOf(holder) 'wrongFile'
		panic("requireIntegerRegister: value {holder} is a {liveness.classOf(holder).name} value held in register {regNum}, which is in the {registerClass.name} file — a rematerialized constant is written into the register its holder occupies")
	end 'wrongFile'

	if registerClass != RegClass.gpr 'notInteger'
		panic("requireIntegerRegister: value {holder} is rebuilt from an immediate but register {regNum} is in the {registerClass.name} file — a constant materialization writes an integer register")
	end 'notInteger'
end 'requireIntegerRegister'

// The sub-phases the timers + counters attribute time to.
//
// In EXECUTION order, which is the order the whole-compile report prints them under
// the `regalloc` phase. They must together account for ALL of that phase's wall time:
// `criticalEdges` and `blockOrder` exist because they were once un-timed, and the
// module-wide edge split plus a per-function RPO reorder over thousands of blocks is
// not free — leaving them out put ~10% of the compile in a nameless remainder, the
// same "big cost hiding in the wrong bucket" defect this instrumentation exists to
// catch. Whatever these arms still do not claim surfaces as an explicit
// `(unattributed)` row (see CompileTimings.regAllocRemainder), never as silence.
//
// Ordinals index a per-run array and are persisted nowhere, so this list may be
// reordered freely — but every arm must stay a DISJOINT interval (see `allocateFunctionCore`,
// which subtracts liveness back out of the splitter's wall).
export enum RegAllocPhase
	criticalEdges
	blockOrder
	splitting
	liveness
	coloring
	ssaDestruction
	rewrite
end 'RegAllocPhase'

// The function name whose pressure was worst, per register class — a class row of names. `stdlib`'s
// `StringArray` is namespaced to Build and not visible here, and a name is not a `RegCount`, so the
// class rows above cannot carry it.
export typealias PressureFuncByClass = Array with String

// ONE FUNCTION'S ALLOCATOR COUNTERS - every figure the core moves, and nothing it does not.
//
// It is split from `RegAllocStats` because the two have different owners and different lifetimes. These
// are pure SUMS over one function, produced by code that runs on a pool worker, so they must be a value
// with no `Project` behind it and no module-wide maximum in it. `RegAllocStats.merge` folds one of
// these in when the function's result reaches the main thread.
//
// Every field is a scalar, which is also what lets one cross a message boundary whole.
export type RegAllocCounters
	export var copiesInserted as EventCount
	export var hintsHonoured as EventCount
	export var hintsMissed as EventCount
	export var valuesColored as EventCount
	export var registersUsed as RegMask

	// Cold-spill splitter counters: values spilled to a slot, reloads emitted for
	// them (one per use-block), and constants rematerialized instead of spilled.
	export var valuesSplit as EventCount
	export var reloadsInserted as EventCount
	export var rematerialized as EventCount

	// Of `valuesSplit`, how many were FORCED spills at a fixed-register point (a call / `idiv`)
	// rather than COLD splits of an idle value - the amended Rule 2's mechanism. These are the
	// spills permitted INSIDE a loop, so this is the counter to watch: it is the number of
	// store/reload brackets in hot code, and each one is a program that would otherwise have been
	// a FALSE E5001.
	export var forcedSpills as EventCount

	// Full-pool peaks relieved by the forced bracket because their values reach a cold run
	// (`SplitDriver.relievePressure`'s `forcedRatherThanRefused`).
	export var forcedInsteadOfRefused as EventCount

	// Values the COLORER could not place, split by one of the two cures. THE TWO CURES ARE COUNTED
	// APART, AND THAT IS THE WHOLE REASON THERE ARE TWO COUNTERS. Neither is pressure - every value they
	// relieve sat at a point Hall calls FEASIBLE - so both are counted beside `forcedSpills` rather than
	// inside it, and both are also included in it (a repair IS a forced bracket).
	//
	// `repairedByEviction` IS EXPECTED TO READ ZERO, AND THAT IS WHAT IT IS FOR. Cure (a) runs first
	// and handles everything the corpus produces, so a single merged counter could never tell a reader
	// that `SplitDriver.repairByEvictingOccupant` has never executed. Split, the zero
	// is legible: it is the standing evidence that the eviction path is UNEXERCISED by the suite, and the
	// only thing that will tell a future reader so. Do not merge them back to tidy the report.
	export var repairedByWidening as EventCount
	export var repairedByEviction as EventCount

	export static function create() returns RegAllocCounters
		return Self{copiesInserted: 0, hintsHonoured: 0, hintsMissed: 0, valuesColored: 0, registersUsed: 0, valuesSplit: 0, reloadsInserted: 0, rematerialized: 0, forcedSpills: 0, forcedInsteadOfRefused: 0, repairedByWidening: 0, repairedByEviction: 0}
	end 'create'

	export function noteRegisterUse(regNum RegNum)
		self.registersUsed = regMaskAdd(self.registersUsed, regNum: regNum)
	end 'noteRegisterUse'
end 'RegAllocCounters'

// ONE FUNCTION'S FIGURES THAT ARE NOT SUMS, which is why they are not counters. `maxPressure` is a
// maximum per register file and `livenessMarkSteps` feeds both a total and a maximum, so folding them
// is the module report's job and measuring them is the core's. The NAME that goes with the pressure is
// the main thread's to supply - the core has no `String` to spare and no report to write it into.
export type RegAllocFacts
	export var livenessMarkSteps as EventCount
	export var rowWordsVisited as EventCount
	export var maxPressure as FixedRegCountColumn
	export var maxLoopDepth as LoopDepth

	export static function create() returns RegAllocFacts
		return Self{livenessMarkSteps: 0, rowWordsVisited: 0, maxPressure: zeroClassRow(), maxLoopDepth: 0}
	end 'create'
end 'RegAllocFacts'

// Per-run counters + timers, logged under CompilerLogGroup.codegen. Counters matter more
// than the clock at sub-millisecond functions (design §"Stats").
export type RegAllocStats
	// Two scalar columns, not one Array with PhaseCost — see CompileTimings' note. These are
	// the per-FUNCTION probes, so a boxed pair here is what cost the compiler thousands of
	// allocations per rung and moved the trend log's reproducible column.
	export var phaseNanos as DurationNanosArray
	export var phaseCpuTicks as CpuTicksArray
	export var functionsAllocated as EventCount

	// SSA path-exploration cost (there is no liveness fixpoint — see TargetLiveness).
	export var livenessMarkStepsTotal as EventCount
	export var livenessMarkStepsMax as EventCount

	export var rowWordsVisitedTotal as EventCount
	export var rowWordsVisitedMax as EventCount

	// The worst per-FILE pressure seen, and the function it was seen in — one entry per register
	// class, because the peak of a mixed figure is no file's peak. `maxPressureFunc` names the
	// function per class for the same reason.
	export var maxPressure as FixedRegCountColumn
	export var maxPressureFunc as PressureFuncByClass
	export var maxLoopDepth as LoopDepth
	export var copiesInserted as EventCount
	export var hintsHonoured as EventCount
	export var hintsMissed as EventCount
	export var valuesColored as EventCount
	export var registersUsed as RegMask

	// Cold-spill splitter counters: values spilled to a slot, reloads emitted for
	// them (one per use-block), and constants rematerialized instead of spilled.
	export var valuesSplit as EventCount
	export var reloadsInserted as EventCount
	export var rematerialized as EventCount

	// Of `valuesSplit`, how many were FORCED spills at a fixed-register point (a call / `idiv`)
	// rather than COLD splits of an idle value — the amended Rule 2's mechanism. These are the
	// spills permitted INSIDE a loop, so this is the counter to watch: it is the number of
	// store/reload brackets in hot code, and each one is a program that would otherwise have been
	// a FALSE E5001.
	export var forcedSpills as EventCount

	// Full-pool peaks relieved by the forced bracket because their values reach a cold run
	// (`SplitDriver.relievePressure`'s `forcedRatherThanRefused`).
	export var forcedInsteadOfRefused as EventCount

	// Values the COLORER could not place, split by one of the two cures. ⭐⭐ THE TWO CURES ARE COUNTED
	// APART, AND THAT IS THE WHOLE REASON THERE ARE TWO COUNTERS. Neither is pressure — every value they
	// relieve sat at a point Hall calls FEASIBLE — so both are counted beside `forcedSpills` rather than
	// inside it, and both are also included in it (a repair IS a forced bracket).
	//
	// ⚠ `repairedByEviction` IS EXPECTED TO READ ZERO, AND THAT IS WHAT IT IS FOR. Cure (a) runs first
	// and handles everything the corpus produces, so a single merged counter could never tell a reader
	// that `SplitDriver.repairByEvictingOccupant` has never executed. Split, the zero
	// is legible: it is the standing evidence that the eviction path is UNEXERCISED by the suite, and the
	// only thing that will tell a future reader so. Do not merge them back to tidy the report.
	export var repairedByWidening as EventCount
	export var repairedByEviction as EventCount

	export static function create() returns RegAllocStats
		var phaseNanos = DurationNanosArray.create(RegAllocPhase.allCases.count())
		var phaseCpuTicks = CpuTicksArray.create(RegAllocPhase.allCases.count())
		var maxPressureFunc = PressureFuncByClass.create(RegClassCount, zeroed: false)

		for _ in 0 upto RegClassCount 'eachClass'
			maxPressureFunc.push("")
		end 'eachClass'

		return Self{phaseNanos: phaseNanos, phaseCpuTicks: phaseCpuTicks, functionsAllocated: 0, livenessMarkStepsTotal: 0, livenessMarkStepsMax: 0, rowWordsVisitedTotal: 0, rowWordsVisitedMax: 0, maxPressure: zeroClassRow(), maxPressureFunc: maxPressureFunc, maxLoopDepth: 0, copiesInserted: 0, hintsHonoured: 0, hintsMissed: 0, valuesColored: 0, registersUsed: 0, valuesSplit: 0, reloadsInserted: 0, rematerialized: 0, forcedSpills: 0, forcedInsteadOfRefused: 0, repairedByWidening: 0, repairedByEviction: 0}
	end 'create'

	// Scalars, not a PhaseCost — see CompileTimings.addPhaseCost. These are the per-function
	// probes, so this is the site where a boxed pair cost the most.
	export function addPhaseCost(phase RegAllocPhase, nanos DurationNanos, cpuTicks CpuTicks)
		let idx = phase.ordinal
		let curNanos = try self.phaseNanos.get(idx) otherwise panic("RegAllocStats.addPhaseCost: phase index OOB")
		try self.phaseNanos.set(idx, value: curNanos + nanos) otherwise panic("RegAllocStats.addPhaseCost: phase index OOB")
		let curCpu = try self.phaseCpuTicks.get(idx) otherwise panic("RegAllocStats.addPhaseCost: phase index OOB")
		try self.phaseCpuTicks.set(idx, value: curCpu + cpuTicks) otherwise panic("RegAllocStats.addPhaseCost: phase index OOB")
	end 'addPhaseCost'

	export function costOf(phase RegAllocPhase) returns PhaseCost
		let idx = phase.ordinal
		let nanos = try self.phaseNanos.get(idx) otherwise panic("RegAllocStats.costOf: phase index OOB")
		let cpuTicks = try self.phaseCpuTicks.get(idx) otherwise panic("RegAllocStats.costOf: phase index OOB")
		return PhaseCost.create(nanos, cpuTicks: cpuTicks)
	end 'costOf'

	export function recordLivenessMarkSteps(steps EventCount)
		self.livenessMarkStepsTotal = self.livenessMarkStepsTotal + steps

		if steps > self.livenessMarkStepsMax 'newMax'
			self.livenessMarkStepsMax = steps
		end 'newMax'
	end 'recordLivenessMarkSteps'

	export function recordRowWordsVisited(words EventCount)
		self.rowWordsVisitedTotal = self.rowWordsVisitedTotal + words

		if words > self.rowWordsVisitedMax 'newMax'
			self.rowWordsVisitedMax = words
		end 'newMax'
	end 'recordRowWordsVisited'

	export function recordPressure(pressure RegCount, class RegClass, funcName ByteArray)
		if pressure > classRowGet(self.maxPressure, class: class) 'newMax'
			classRowSet(self.maxPressure, class: class, value: pressure)
			try self.maxPressureFunc.set(class.ordinal, value: String.from(funcName)) otherwise panic("RegAllocStats.recordPressure: no maxPressureFunc entry for the {class.name} file")
		end 'newMax'
	end 'recordPressure'

	export function recordLoopDepth(depth LoopDepth)
		if depth > self.maxLoopDepth 'newMax'
			self.maxLoopDepth = depth
		end 'newMax'
	end 'recordLoopDepth'

	// Fold ONE function's counters in. Every field here is a plain sum except `registersUsed`, which is
	// a UNION: it names the distinct registers the whole module coloured into, and a function that used
	// rax does not stop the module having used it.
	export function merge(counters RegAllocCounters)
		self.copiesInserted = self.copiesInserted + counters.copiesInserted
		self.hintsHonoured = self.hintsHonoured + counters.hintsHonoured
		self.hintsMissed = self.hintsMissed + counters.hintsMissed
		self.valuesColored = self.valuesColored + counters.valuesColored
		self.registersUsed = self.registersUsed or counters.registersUsed
		self.valuesSplit = self.valuesSplit + counters.valuesSplit
		self.reloadsInserted = self.reloadsInserted + counters.reloadsInserted
		self.rematerialized = self.rematerialized + counters.rematerialized
		self.forcedSpills = self.forcedSpills + counters.forcedSpills
		self.forcedInsteadOfRefused = self.forcedInsteadOfRefused + counters.forcedInsteadOfRefused
		self.repairedByWidening = self.repairedByWidening + counters.repairedByWidening
		self.repairedByEviction = self.repairedByEviction + counters.repairedByEviction
	end 'merge'
end 'RegAllocStats'

// The allocatable register pool for `target` — the full 14 GPRs (every register except rsp/rbp, the
// frame): the 9 CALLER-saved {rax, rcx, rdx, rsi,
// rdi, r8, r9, r10, r11} PLUS the 5 CALLEE-saved {rbx, r12–r15}. The callee-saved half
// is what makes calls colorable: a value live ACROSS a call is forbidden every caller-
// saved register (`callDirect`'s `implicitDefs`), so its only home is a callee-saved
// register — the prologue/epilogue pass then push/pops exactly the callee-saved registers
// a function's coloring actually used. R8 is admitted because `ret`'s implicit-use mask
// proves nothing is live across the `mov r8, retval` return move. r10/r11 stay in the
// pool — the compiler needs no reserved scratch (SSA destruction breaks copy cycles with `xchg`,
// and the IAT call is RIP-relative), so the doc's r10/r11-as-scratch is a FUTURE tuning.
//
// The XMM file has the same two halves: 6 CALLER-saved {xmm0–5} and 10 CALLEE-saved
// {xmm6–15}, so a float live across a call has the same kind of home an int has
// instead of no home at all. The XMM half needs no `push` — there is no `push xmm` — so the prologue
// preserves it in ordinary 8-byte frame SLOTS, exactly as arm64 preserves d8–d15.
// The pool is a property of the target — arm64 declares its own when its backend lands.
module function allocatablePool(target Target) returns RegMask
	match target.cpu 'cpu'
		x64 then return x64AllocatablePool()
		arm64 then return arm64AllocatablePool()
		wasm32 then panic("allocatablePool: maxon has no register pool for wasm32 (got {targetToString(target)})")
	end 'cpu'
end 'allocatablePool'

// The x64 pool: every register except rsp/rbp (the frame) — 9 caller-saved + 5 callee-saved GPRs,
// and 6 caller-saved + 10 callee-saved XMMs.
//
// It is the UNION OF THE TWO HALVES AND NOTHING ELSE. OR-ing the whole XMM class mask in as a third
// term is a redundant restatement while every XMM is caller-saved — and it is also the XMM file
// written down a second time, exactly the term that would silently keep an XMM allocatable if one
// were dropped out of both halves. `assertCalleeSavedListsMatchMasks` proves the two halves partition the file, which is
// what makes this union the complete pool rather than merely a large one.
// EXPORTED for the same reason `calleeSavedMask` is: `Testing/ScaleCorpus` derives its register-pressure
// knob widths from the allocator's own masks rather than writing today's numbers down, so that the next
// move of this pool RETUNES those knobs instead of blinding them.
// The GPRs the allocator can hand out on `target` — what a Std pass budgets a loop's live-across set
// against (`unswitchInvariantGuards`), read off the pool itself so the two cannot disagree.
export function allocatableGprCount(target Target) returns RegCount
	return regMaskPopcount(poolOfClass(allocatablePool(target), class: RegClass.gpr, file: registerFileFor(target)))
end 'allocatableGprCount'

export function x64AllocatablePool() returns RegMask
	return callerSavedMask() or calleeSavedMask()
end 'x64AllocatablePool'

// The arm64 pool (AAPCS64-derived): allocatable GPRs x0..x14 ∪ x19..x28, and the WHOLE
// SIMD file d0..d31 (all 32 are allocatable — d0..d7/d16..d31 caller-saved, d8..d15 callee-saved).
// x15 (the asynchronous-preemption resume register), x16/x17 (IP scratch), x18 (the untouchable Darwin
// platform register), x29 (FP), x30 (LR) and sp are NOT in the pool. arm64 runs the allocator, so this
// pool is LIVE; x16/x17 being out of it is what lets the `arm64ImportCall`
// trampoline (`adrp/ldr/blr x16`) clobber x16 freely — no value is ever coloured there, so its omission
// from the caller-saved mask is sound.
function arm64AllocatablePool() returns RegMask
	return arm64AllocatableGprMask() or classRegisterMask(RegClass.xmm, file: arm64RegisterFile())
end 'arm64AllocatablePool'

// arm64 allocatable GPRs: x0..x14 (RegNum 0..14) ∪ x19..x28 (RegNum 19..28). x15/x16/x17/x18/x29/x30/sp
// are excluded (see `arm64AllocatablePool`). The caller-saved run ENDS at `Arm64AsyncPreemptScratch`, which
// is where that register's reservation is argued.
function arm64AllocatableGprMask() returns RegMask
	var mask = 0 as RegMask

	for reg in 0 upto Arm64AsyncPreemptScratch 'callerSavedGprs'
		mask = regMaskAdd(mask, regNum: reg)
	end 'callerSavedGprs'

	for reg in Arm64CalleeSavedGprLow upto Arm64CalleeSavedGprEnd 'calleeSavedGprs'
		mask = regMaskAdd(mask, regNum: reg)
	end 'calleeSavedGprs'

	return mask
end 'arm64AllocatableGprMask'

// The registers of ONE class that `pool` makes available — and the pool EVERY per-value question must
// be asked against, because a value can only ever take a register from its own file.
//
// ⚠ `allocatablePool` is the WHOLE MACHINE's pool, spanning both files. Asking a per-value question
// against it answers about registers the value can never have, and the two failures are OPPOSITE: an
// int's 14 allowed registers measured against a 30-register pool read CONSTRAINED forever (a
// permanent census over every operand of every op — a pure TIME cost, which `scale-test` measures no
// part of), while a 15-live-int pigeonhole measured against the same 30 never fires at all and lets
// the colorer run out of registers. Both are the same mistake: a class-agnostic denominator.
// The class split reads the TARGET's register file boundary — 16 for x64, 31 for arm64 — threaded in
// as `file` beside `pool` (both are per-ISA and travel together, sourced once from
// `registerFileFor(target)` and carried on `LivenessResult.registerFile`). Passing the wrong file
// files a register in the wrong class: an arm64 GPR x19..x28 would read as vector against x64's 16.
export function poolOfClass(pool RegMask, class RegClass, file RegisterFile) returns RegMask
	return pool and classRegisterMask(class, file: file)
end 'poolOfClass'

// How many registers a value of `class` could take if nothing were blocked — the denominator of every
// "is this value constrained?" and "is this point over its pool?" test.
//
// ⚠ IT TAKES THE POOL, AND THAT IS THE WHOLE POINT: A FILE'S WIDTH IS NOT A POOL'S. The GPR file is
// 16 wide, but rsp/rbp are the frame and are never allocatable, so a GPR value's pool is FOURTEEN.
// A `classPoolSize(class)` reading the width off `classRegisterMask` alone briefly lived in RegBits
// and returned 16 — under a comment that itself said "an int's 14 allowed registers". Measuring
// `constrained` against it reports every unconstrained int as constrained (14 < 16), which is the
// exact permanent-census regression the per-class denominator exists to prevent, reintroduced by a
// denominator off by two.
export function classPoolSizeOf(pool RegMask, class RegClass, file RegisterFile) returns RegCount
	return regMaskPopcount(poolOfClass(pool, class: class, file: file))
end 'classPoolSizeOf'

// Guard the load-bearing invariant that a call op's inline `implicitDefs` clobber
// mask (which the liveness pass forbids for every value live across a call) equals the
// CALLER-saved half of the allocatable pool: a value live across a call is forbidden the
// former and must find a home in `pool ∖ caller-saved` = the callee-saved half. If they
// drift, such a value is mis-constrained — a false E5001 later, or a real clobber. The
// mask is read from the op's own metadata (not re-spelled), and rbx is checked out of it
// explicitly. Runs once per
// module, so the check is free.
//
// ⭐ **BOTH CALL OPS ARE CHECKED, AND `iatCall` IS WHY THIS LOOP EXISTS.** It carried
// `implicitDefs: 0` while its own comment says "full call-barrier semantics" — inert for as long
// as the only `iatCall` is `mrt_start`'s hand-built `ExitProcess`, and a miscompile the moment one
// wraps `VirtualAlloc` inside `__slab_alloc` with values live across it. Checking only the op that
// happens to be right is what lets the other be wrong; a call is a call, so every op that IS one
// answers to this.
//
// The ops are named one by one because `TargetOp` offers no way to enumerate its arms. The one
// thing that can go wrong is a NEW call op landing without a line here — `isCall: true` is the
// property to grep for when adding one. The payloads are throwaway: only the metadata is read.
//
// ⭐ IT TAKES THE MASK THE COLORER WILL USE, RATHER THAN RE-DERIVING ITS OWN. An arm sourcing its own
// target's mask proves "arm64's call ops agree with arm64's mask" while the colorer, one screen away,
// asks the X64 one unconditionally — so the two spellings the check exists to hold together are never
// both under it. Sourced once in
// `lowerAndAllocateOnAWorkerPool` and passed in, the mask the ABI clobbers and the mask the colorer prefers are
// ONE value, and a target that got the wrong one fails the build here instead of colouring quietly.
//
// VERIFIED BY SABOTAGE: with `callerSavedMaskFor`'s arm64 arm put back to `callerSavedMask()`, an
// arm64 compile dies here — *"arm64BranchLink clobber mask 9223231846974816255 != caller-saved pool
// 4132807"* — before any function is coloured, and x64 is untouched.
function assertCallClobberConsistent(target Target, callerSaved RegMask)
	match target.cpu 'cpu'
		x64 then assertX64CallClobbers(callerSaved)
		arm64 then assertArm64CallClobbers(callerSaved)
		wasm32 then panic("assertCallClobberConsistent: maxon has no call ABI for wasm32 (got {targetToString(target)})")
	end 'cpu'
end 'assertCallClobberConsistent'

// The x64 call ops against the caller-saved pool the COLORER holds, with rbx (callee-saved) the
// drift witness.
function assertX64CallClobbers(pool RegMask)
	// BEFORE the clobber masks are read, for the reason `assertRegisterFacts`'s call order documents:
	// the caller-saved mask and the callee-saved lists are two halves of one fact, so a drifted list
	// makes the clobber check fail too — and it would blame `TargetDialect.callDirect`, sending the
	// reader to a file with nothing wrong in it. Checking the lists first means each panic accuses
	// the thing that actually moved.
	assertCalleeSavedListsMatchMasks()

	assertOneCallClobber(TargetOp.callDirect(ByteArray.create(0)), name: "callDirect", pool: pool, calleeWitness: X64Register.rbx.rawValue, calleeName: "rbx")
	assertOneCallClobber(TargetOp.iatCall(0), name: "iatCall", pool: pool, calleeWitness: X64Register.rbx.rawValue, calleeName: "rbx")

	// The register-indirect call carries the SAME caller-saved clobber mask as `callDirect`
	// (a call destroys the caller-saved set whether its target is a name or a register). Its callee
	// register (rbx here is just the callee-saved WITNESS the assert checks is NOT clobbered) is an
	// explicit USE, but the clobber assertion is about `implicitDefs`, which must equal the pool.
	assertOneCallClobber(TargetOp.callReg(TargetVReg.virtual(0)), name: "callReg", pool: pool, calleeWitness: X64Register.rbx.rawValue, calleeName: "rbx")

	// The Linux `syscall` (x64-linux `osExit`/`osWriteStdout`/`osAllocPages` and the entry stub's
	// `exit_group`) crosses the same barrier: the kernel returns in rax and the `syscall` instruction
	// clobbers rcx/r11, all inside the caller-saved pool, exactly as `iatCall` does — its
	// `0xFFFF0FC7` literal must equal the pool, or a value live across it is mis-constrained. The
	// arm64 twin holds `arm64Syscall` here for the identical reason (`assertArm64CallClobbers`).
	assertOneCallClobber(TargetOp.x64Syscall(0), name: "x64Syscall", pool: pool, calleeWitness: X64Register.rbx.rawValue, calleeName: "rbx")

	// The fused witness call's MEMORY-indirect form: a call destroys the caller-saved set
	// whether its target is a name, a register or a memory operand. Leaving it out makes the guard four
	// ops are covered by a mere sentence for the fifth — and an unguarded clobber literal is exactly
	// what gets hand-edited (0xFFFF0FC7 → 0x003F0FC7) while its header promises it cannot drift.
	assertOneCallClobber(TargetOp.callMem(TargetVReg.virtual(0), disp: 0), name: "callMem", pool: pool, calleeWitness: X64Register.rbx.rawValue, calleeName: "rbx")
end 'assertX64CallClobbers'

// The arm64 call ops against the caller-saved pool the COLORER holds, with x19 (callee-saved) the
// drift witness.
// It holds the same one-fact-one-place guard the x64 pair does: the `0x7FFF807F80007FFF` literal on
// `arm64BranchLink`/`arm64BranchLinkReg`/`arm64ImportCall` must equal `arm64CallerSavedMask`, or a value
// live across a call is mis-constrained. Both OS-call forms are calls and so answer here too —
// `arm64ImportCall` (the macOS mmap/write GOT call) is the case the x64 `iatCall` comment warns about
// on the arm64 side, and `arm64Syscall` (its Linux `svc #0` sibling) crosses the same barrier:
// the kernel clobbers the caller-saved half exactly as a libSystem call does.
function assertArm64CallClobbers(pool RegMask)
	assertOneCallClobber(TargetOp.arm64BranchLink(b""), name: "arm64BranchLink", pool: pool, calleeWitness: 19, calleeName: "x19")
	assertOneCallClobber(TargetOp.arm64BranchLinkReg(TargetVReg.virtual(0)), name: "arm64BranchLinkReg", pool: pool, calleeWitness: 19, calleeName: "x19")
	assertOneCallClobber(TargetOp.arm64ImportCall(0), name: "arm64ImportCall", pool: pool, calleeWitness: 19, calleeName: "x19")
	assertOneCallClobber(TargetOp.arm64Syscall(0), name: "arm64Syscall", pool: pool, calleeWitness: 19, calleeName: "x19")
end 'assertArm64CallClobbers'

// ⭐⭐ **EVERY MACRO-OP WHOSE ENCODER WRITES FIXED REGISTERS, AGAINST THE `implicitDefs` LITERAL THAT
// IS WHAT KEEPS A LIVE VALUE OUT OF THEM.** Six families answer here — the jump tables (r10/r11 on
// x64, x16/x17 on arm64), the byte-fill ladders (rax/rcx/rdx/rdi, x0..x3), the arm64 atomics
// (x16/x17), the x64 f64 negate's mask register (xmm5), the x64 unsigned int → f64 sequence
// (r11) and the indirect-jump return (rax on x64, nothing on arm64) — and they share ONE guard because they share one hazard, stated once: the inline
// `TargetOpMeta` literal is what `forbidOperandsFromImplicit` and the liveness clobber census read,
// the ENCODER is what actually writes those registers, and a drift between the two is a silent
// miscompile — a live value coloured onto a register the encoder then destroys. Two byte-identical
// helpers and two per-target dispatchers would differ only in the sentence in the panic, which is a
// parameter here instead.
//
// ⛔ **THE FILL LADDER's x64 HALF IS THE ONE THAT WOULD BITE.** rdi is an ARGUMENT register in this
// ABI, so it is allocatable and a live
// value genuinely can land there. Nothing else would notice. The jump-table and atomic scratches are
// outside every allocatable pool, so their declaration DOCUMENTS the encoder's use rather than reserving
// anything — which is exactly why it can drift unnoticed without a check like this one.
function assertEncoderScratchMasks(target Target)
	match target.cpu 'cpu'
		x64 then assertX64EncoderScratchMasks()
		arm64 then assertArm64EncoderScratchMasks()
		wasm32 then break
	end 'cpu'
end 'assertEncoderScratchMasks'

function assertX64EncoderScratchMasks()
	assertEncoderScratchMask(TargetOp.x64JumpTable(TargetVReg.virtual(0), defaultTarget: 0, caseTargets: BlockIdArray.create(0), tableLabel: b""), name: "x64JumpTable", expected: x64JumpTableScratchMask(), hazard: "the biased index could be colored onto a register the jump-table encoder clobbers")
	assertEncoderScratchMask(TargetOp.x64MemFill(0), name: "x64MemFill", expected: x64MemFillScratchMask(), hazard: "a value live across the fill could be colored onto a register the ladder clobbers")
	assertEncoderScratchMask(TargetOp.cvtu64sdRegReg(TargetVReg.virtual(0), src: TargetVReg.virtual(0)), name: "cvtu64sdRegReg", expected: x64UnsignedToFloatScratchMask(), hazard: "the source could be colored onto the register the halving sequence clobbers before its last read")

	// The f64 negate's mask register is ALLOCATABLE (xmm5 is a float argument register), so this is the
	// fill ladder's case rather than the jump table's: the declaration genuinely reserves it at the op.
	assertEncoderScratchMask(TargetOp.negF64RegReg(TargetVReg.virtual(0), src: TargetVReg.virtual(0)), name: "negF64RegReg", expected: x64NegF64ScratchMask(), hazard: "the operand, or a value live across the negate, could be colored onto the XMM the sign-mask build clobbers")
	assertEncoderScratchMask(TargetOp.ret(ReturnTransfer.indirectJump), name: "ret", expected: x64ReturnScratchMask(), hazard: "the return jump would write a register the allocator and the prologue census believe it leaves alone")
end 'assertX64EncoderScratchMasks'

function assertArm64EncoderScratchMasks()
	let ipPair = regMaskAdd(regMaskAdd(0, regNum: Arm64Ip0Reg), regNum: Arm64Ip1Reg)
	assertEncoderScratchMask(TargetOp.arm64JumpTable(TargetVReg.virtual(0), defaultTarget: 0, caseTargets: BlockIdArray.create(0), tableLabel: b""), name: "arm64JumpTable", expected: ipPair, hazard: "the biased index could be colored onto a register the jump-table encoder clobbers")
	assertEncoderScratchMask(TargetOp.arm64MemFill(0), name: "arm64MemFill", expected: arm64MemFillScratchMask(), hazard: "a value live across the fill could be colored onto a register the ladder clobbers")

	// Both atomics keep their working value in x16 and their store status in x17 — the SAME IP pair
	// the jump table uses, which is why one `let` serves all three.
	assertEncoderScratchMask(TargetOp.arm64AtomicCas(TargetVReg.virtual(0), addrReg: TargetVReg.virtual(0), expectedReg: TargetVReg.virtual(0), replacementReg: TargetVReg.virtual(0)), name: "arm64AtomicCas", expected: ipPair, hazard: "an operand of the retry loop could be colored onto a register the loop clobbers before its last read")
	assertEncoderScratchMask(TargetOp.arm64AtomicRmw(TargetVReg.virtual(0), addrReg: TargetVReg.virtual(0), operandReg: TargetVReg.virtual(0), opcode: StdAtomicRmwOpcode.add), name: "arm64AtomicRmw", expected: ipPair, hazard: "an operand of the retry loop could be colored onto a register the loop clobbers before its last read")

	// `br x30` reads the link register and writes none, so the return declares no scratch.
	assertEncoderScratchMask(TargetOp.arm64Ret(ReturnTransfer.indirectJump), name: "arm64Ret", expected: 0, hazard: "the return jump would write a register the allocator and the prologue census believe it leaves alone")
end 'assertArm64EncoderScratchMasks'

// `hazard` names what a drift would actually COST, because a union case cannot name itself and a panic
// that says only "masks differ" sends the reader to the right line with the wrong question.
function assertEncoderScratchMask(op TargetOp, name String, expected RegMask, hazard String)
	let clobber = op.rawValue.implicitDefs

	if clobber != expected 'drift'
		panic("assertEncoderScratchMasks: {name} implicitDefs {clobber} != the encoder's fixed registers {expected} — TargetDialect.{name}'s inline scratch mask and its encoder drifted apart, so {hazard}")
	end 'drift'
end 'assertEncoderScratchMask'

// The arm64 IP0/IP1 scratch register numbers (x16/x17), named here beside the assertion that reads them so
// this file states the scratch pair once rather than reaching into `Arm64Backend`'s encoder constants.
let Arm64Ip0Reg = 16
let Arm64Ip1Reg = 17

// One call op's clobber mask against its ABI's caller-saved `pool`, and against a `calleeWitness`
// register that must NOT be clobbered. `name`/`calleeName` are carried because a union case
// cannot name itself, and a panic that cannot say WHICH op drifted would send a reader to the wrong
// line of TargetDialect.
function assertOneCallClobber(op TargetOp, name String, pool RegMask, calleeWitness RegNum, calleeName String)
	let clobber = op.rawValue.implicitDefs

	if clobber != pool 'drift'
		panic("assertCallClobberConsistent: {name} clobber mask {clobber} != caller-saved pool {pool} — TargetDialect.{name}'s implicitDefs and RegisterAllocator's caller-saved mask drifted apart")
	end 'drift'

	if regMaskContains(clobber, regNum: calleeWitness) 'calleeClobbered'
		panic("assertCallClobberConsistent: {name} clobber mask wrongly includes {calleeName}, which is CALLEE-saved")
	end 'calleeClobbered'
end 'assertOneCallClobber'

// The CALLER-saved (volatile) half of `target`'s pool — the registers a call destroys, and so the
// registers the colorer should hand a value that does NOT cross one (`preferredVolatilityMask`).
// The twin of `allocatablePool` and `registerFileFor`: sourced ONCE per module in
// `lowerAndAllocateOnAWorkerPool` and carried beside `pool` through the whole colorer.
//
// ⭐⭐ **THE MASK MUST BE THE TARGET'S OWN: x64'S `callerSavedMask()` IS WRONG ON arm64, AND
// THE REGISTER NUMBERS DO NOT EVEN LINE UP.** x64's `xmm0..xmm5` are RegNums 16–21, which in the
// arm64 file are x16..x21: x64's mask reads three genuinely callee-saved arm64 GPRs (x19/x20/x21)
// as volatile and misses x3, x4, x5 and x12..x15, and on the SIMD side its intersection is EMPTY.
// That is not merely a worse allocation. The greedy colorer is exact for this constraint family
// only because *"it prefers caller-saved registers first, so an unconstrained value never takes a
// callee-saved one while a caller-saved one is free"* (`HallCondition.hallVerdictAt`) — and with
// the wrong half named, that premise is false: unconstrained values take x19/x20/x21 (or
// d8..d15), a later value confined to the callee-saved half finds none, and `chooseRegister` dies
// on a program Hall's condition declared feasible. Both halves are pinned by
// `register-volatility-preference`.
//
// ⚠ IT IS SOURCED PER MODULE, NOT PER VALUE, AND THAT IS THE REASON A PER-TARGET BRANCH IS FREE
// HERE. `preferredVolatilityMask` is on the colorer's per-value path (up to twice per
// `chooseRegister`); a `match` on `target.cpu` there would be a per-value cost, and
// `arm64CallerSavedMask`'s 40-iteration derivation would be a far larger one. Threaded as a plain
// `RegMask` beside `pool`, the per-value path does no work at all for it.
module function callerSavedMaskFor(target Target) returns RegMask
	match target.cpu 'cpu'
		x64 then return callerSavedMask()
		arm64 then return arm64CallerSavedMask()
		wasm32 then panic("callerSavedMaskFor: maxon has no call ABI for wasm32 (got {targetToString(target)})")
	end 'cpu'
end 'callerSavedMaskFor'

// The volatility split must be a real split OF THE POOL the colorer is about to colour out of, on
// every target and in every register FILE:
//
//   • no preferred register outside the pool. x64's mask names RegNums 16/17/18, which in the arm64
//     file are x16/x17 (the IP scratch) and x18 (Darwin's platform register) — none allocatable, so
//     the preference would steer values at registers no value may hold.
//   • no allocatable file without a volatile half. arm64's SIMD pool against x64's mask intersects
//     to ∅, and `preferredVolatilityMask` then returns the whole class pool at every value: a
//     preference that prefers nothing, and floats free to settle in registers the prologue must save.
//
// ⚠ IT IS NOT WHAT GUARDS THE PER-TARGET MASK, AND SAYING SO WOULD BE A FALSE CLAIM.
// `assertCallClobberConsistent`
// is: it pins the colorer's mask to the call ops' `implicitDefs` LITERAL, exactly, per target, so a
// target handed the wrong ISA's mask fails there first and this can never see it. What this adds is
// the pair that assert cannot see — `pool` against `callerSaved`. Change `allocatablePool` and leave
// the caller-saved mask alone (or the reverse) and the clobber literal still agrees with itself
// while the colorer prefers registers the pool no longer offers.
//
// It is the target-general half of what `assertCalleeSavedListsMatchMasks` does for x64. The OTHER
// half — that `pool ∖ caller-saved` is exactly the set the prologue preserves, so no register is
// coloured into and never saved — cannot be written here for arm64: `Arm64PrologueEpilogue`'s
// callee-saved bounds are file-private, and respelling them would be the fourth copy of a register
// file this family exists to prevent.
//
// Once per module, beside the other four asserts, so it costs nothing.
function assertVolatilitySplitsEveryClass(pool RegMask, callerSaved RegMask, file RegisterFile, target Target)
	if (callerSaved and not pool) != 0 'outsidePool'
		panic("assertVolatilitySplitsEveryClass: the caller-saved mask for {targetToString(target)} names {callerSaved and not pool}, which `allocatablePool` does not offer — the colorer's volatility preference would steer a value at a register no value may hold. The caller-saved half is a SUBSET of the pool, not an ABI list the pool happens to overlap.")
	end 'outsidePool'

	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		let classPool = poolOfClass(pool, class: class, file: file)

		if classPool != 0 and (classPool and callerSaved) == 0 'noVolatileInFile'
			panic("assertVolatilitySplitsEveryClass: {targetToString(target)} offers {regMaskPopcount(classPool)} allocatable {class.name} register(s) and NONE of them is caller-saved — `preferredVolatilityMask` then falls straight through to the whole class pool, so a value that never crosses a call is free to settle in a register the prologue must preserve, and the callee-saved half stops being reserved for the values that have nowhere else to go. A file the pool offers has both halves or the volatility preference is not a preference.")
		end 'noVolatileInFile'
	end 'eachClass'
end 'assertVolatilitySplitsEveryClass'

// The arm64 caller-saved set: GPRs x0..x14 (RegNum 0..14) ∪ SIMD d0..d7 (31..38) ∪ d16..d31
// (47..62) — d8..d15 and x19..x28 are callee-saved. Equals the `0x7FFF807F80007FFF` literal the
// arm64 call ops carry (asserted).
//
// ⚠ **IT STOPS AT `Arm64AsyncPreemptScratch`, NOT AT THE ABI's CALLER-SAVED BOUNDARY.** x15, x16 and x17
// really are caller-saved by AAPCS64 and are all absent here, for one reason: this mask constrains
// COLOURING, and no value is ever coloured into a register outside the pool — so naming one would only make
// the volatility split a claim about registers the colorer cannot reach.
//
// Derived by loop rather than spelled register by register the way x64's is, and the asymmetry is
// deliberate: the MEASURED trap `callerSavedMask`'s header records is a PER-VALUE one, and this is
// called once per module (`callerSavedMaskFor`). Forty iterations per compile buys the arm64 ABI
// stated as its four contiguous ranges instead of forty `or`s a reader must decode — and it
// allocates nothing either way, which is the property that trap was actually about.
function arm64CallerSavedMask() returns RegMask
	let fpBase = Arm64FirstVectorRegister
	var mask = 0 as RegMask

	for reg in 0 upto Arm64AsyncPreemptScratch 'callerGprs'
		mask = regMaskAdd(mask, regNum: reg)
	end 'callerGprs'

	for fpIndex in 0 upto 8 'fpLow'
		mask = regMaskAdd(mask, regNum: fpBase + fpIndex)
	end 'fpLow'

	for fpIndex in 16 upto 32 'fpHigh'
		mask = regMaskAdd(mask, regNum: fpBase + fpIndex)
	end 'fpHigh'

	return mask
end 'arm64CallerSavedMask'

// Every CALLER-saved register the X64 ABI clobbers across a call — the same set
// `callDirect`'s `implicitDefs` mask (0xFFFF0FC7) names, kept in ONE place so the pool and
// the clobber mask cannot drift (asserted equal by `assertCallClobberConsistent`). A
// value live across a call is forbidden all of these.
//
// ⚠ **THIS IS X64'S, AND ITS NAME DOES NOT SAY SO.** Ask
// `callerSavedMaskFor(target)`; this is one of its two arms, the twin of `x64AllocatablePool`. It is
// file-private for that reason: a target-neutral NAME on a target-specific FACT is what the colorer
// would read as "the caller-saved mask", and nothing outside this file has any business asking the
// question without naming a target.
//
// ⭐ SIX XMMs ARE CALLER-SAVED (xmm0–5), AND THE OTHER TEN ARE NOT. A float live across a call is
// therefore confined to xmm6–15 — ten registers, not ∅ — exactly as an int live across a call is
// confined to the five callee-saved GPRs. Taking all sixteen here forbids such a float its ENTIRE file
// and force-spills a store/reload bracket at EVERY call, which MEASURED `regalloc:splitting` as
// quadratic in the number of cross-call floats (x4.24 per doubling).
//
// ⚠ AN EMPTY ALLOWED SET IS THE CASE `valueConfinedTo` GUARDS, and it is not reachable
// through a float across a call. See `SplitLiveRanges.noVictimAtPeak` for what can still reach it.
//
// ⭐⭐ SPELLED REGISTER BY REGISTER BECAUSE THE DERIVED FORM **ALLOCATED**, AND THAT IS MEASURED, NOT
// STYLISTIC. This function is kept OFF the COLORER's per-value path (`preferredVolatilityMask`, up to
// twice per `chooseRegister`) by sourcing the mask once per module and threading it beside `pool`.
// **The ban below stands anyway**: nothing stops a future caller putting a derivation back on a
// per-value path, and the number that follows is what that costs. Building the XMM half as
// `classRegisterMask(RegClass.xmm, file: x64RegisterFile())` — and **`x64RegisterFile()` CONSTRUCTS A
// HEAP `RegisterFile`** — allocates one per colouring decision. Fifteen shifts and fifteen ors
// allocate nothing.
//
// MEASURED: a probe build of the BASE compiler changing only that one
// expression to a literal reproduces −10,358…−294,501 allocations across the scale ladder with
// `codeBytes` identical at all six rungs. The A/B attributes `regalloc:coloring` −10,369…−294,884 against
// `regalloc:splitting` −2,518…−93,023, so the saving lands three quarters in the coloring row.
//
// ⇒ **DO NOT "SIMPLIFY" THIS BACK TOWARDS `classRegisterMask(…, file: x64RegisterFile())`**, or any
// form that calls `x64RegisterFile()` per value; the operation COUNT was never the cost, the
// allocation was. Caching the mask in a module-level constant would be fine if it measured better,
// but that is an optimization on top of a large win, not a repair. `assertCalleeSavedListsMatchMasks`
// is what keeps the spelling honest — the derivation lives there, run once per module, where a heap
// `RegisterFile` costs nothing.
function callerSavedMask() returns RegMask
	var mask = 0 as RegMask
	mask = mask or regMaskOf(X64Register.xmm0)
	mask = mask or regMaskOf(X64Register.xmm1)
	mask = mask or regMaskOf(X64Register.xmm2)
	mask = mask or regMaskOf(X64Register.xmm3)
	mask = mask or regMaskOf(X64Register.xmm4)
	mask = mask or regMaskOf(X64Register.xmm5)
	mask = mask or regMaskOf(X64Register.rax)
	mask = mask or regMaskOf(X64Register.rcx)
	mask = mask or regMaskOf(X64Register.rdx)
	mask = mask or regMaskOf(X64Register.rsi)
	mask = mask or regMaskOf(X64Register.rdi)
	mask = mask or regMaskOf(X64Register.r8)
	mask = mask or regMaskOf(X64Register.r9)
	mask = mask or regMaskOf(X64Register.r10)
	mask = mask or regMaskOf(X64Register.r11)
	return mask
end 'callerSavedMask'

// The CALLEE-saved registers a function must preserve across its own body — the effective pool for a
// value live across a call, per file: 5 GPRs (rbx, r12–r15) and 10 XMMs (xmm6–15).
// The prologue/epilogue pass preserves exactly the ones a function's coloring used — the GPRs with
// `push`/`pop`, the XMMs in frame SLOTS (x86-64 has no `push xmm`). rsp/rbp are the frame and are
// never allocatable.
//
// Spelled register by register for the MEASURED reason `callerSavedMask` gives — the derived form
// allocated a heap `RegisterFile` per colouring decision. The ORDERED lists (`calleeSavedOrder`,
// `calleeSavedXmmOrder`) are what the prologue and the GT context switch walk, and
// `assertCalleeSavedListsMatchMasks` holds those lists and these two masks to one another.
//
// ⚠ **THIS IS X64'S, AND ITS NAME DOES NOT SAY SO EITHER** — the exact hazard its caller-saved twin
// avoids by being file-private. This one cannot be: `Testing/ScaleCorpus`'s
// `floatsLivePerSpillLoop` reads it to size the float-spill knob, and that reader is x64-specific IN ITS
// OWN TEXT (`classRegisterMask(RegClass.xmm, file: x64RegisterFile())` on the same line), so it names the
// ISA it means. That is the bar for reaching this from outside, and the only caller that clears it.
//
// There is deliberately no `calleeSavedMaskFor(target)`: the callee-saved half is `pool ∖ callerSaved`
// wherever the ALLOCATOR wants it (that is how `chooseRegister`'s confined-pool figure is computed),
// and a second target dispatch would be a second place for an ISA to be assumed. A TARGET-NEUTRAL
// caller must never reach for this — that is precisely how the colorer came to ask x64's volatility on
// every ISA.
export function calleeSavedMask() returns RegMask
	var mask = 0 as RegMask
	mask = mask or regMaskOf(X64Register.rbx)
	mask = mask or regMaskOf(X64Register.r12)
	mask = mask or regMaskOf(X64Register.r13)
	mask = mask or regMaskOf(X64Register.r14)
	mask = mask or regMaskOf(X64Register.r15)
	mask = mask or regMaskOf(X64Register.xmm6)
	mask = mask or regMaskOf(X64Register.xmm7)
	mask = mask or regMaskOf(X64Register.xmm8)
	mask = mask or regMaskOf(X64Register.xmm9)
	mask = mask or regMaskOf(X64Register.xmm10)
	mask = mask or regMaskOf(X64Register.xmm11)
	mask = mask or regMaskOf(X64Register.xmm12)
	mask = mask or regMaskOf(X64Register.xmm13)
	mask = mask or regMaskOf(X64Register.xmm14)
	mask = mask or regMaskOf(X64Register.xmm15)
	return mask
end 'calleeSavedMask'

// ⭐ THE ORDERED LISTS AND THE TWO MASKS ARE THE SAME FACT, so this derives one from the other once
// per module and panics on any drift. `calleeSavedOrder` / `calleeSavedXmmOrder` are what the
// prologue pass preserves and what the GT context switch saves across a stack switch; the masks are
// what the colorer subtracts from a value's pool. A register in a list but not in the mask is never
// coloured into (a wasted register); a register in the mask but not in a list is coloured into and
// NEVER SAVED — a function silently clobbering its caller's register, which is a wrong answer with
// no crash to find it by.
//
// It also asserts the two halves PARTITION the file: every x64 register except the frame (rsp/rbp)
// is either caller- or callee-saved, and none is both. Moving a register across that line by hand can
// leave it on neither side — allocatable
// (the pool IS the union) yet clobbered by nothing and saved by nobody.
function assertCalleeSavedListsMatchMasks()
	var listed = 0 as RegMask

	for reg in calleeSavedOrder 'gprs'
		listed = listed or regMaskOf(reg)
	end 'gprs'

	for reg in calleeSavedXmmOrder 'xmms'
		listed = listed or regMaskOf(reg)
	end 'xmms'

	if listed != calleeSavedMask() 'listDrift'
		panic("assertCalleeSavedListsMatchMasks: the ordered callee-saved lists cover {listed} but calleeSavedMask() is {calleeSavedMask()} — X64PrologueEpilogue's `calleeSavedOrder`/`calleeSavedXmmOrder` (what the prologue preserves and the GT context switch saves) and RegisterAllocator's mask (what the colorer treats as call-surviving) drifted apart. A register in the mask but not in a list is coloured into and never saved.")
	end 'listDrift'

	let file = x64RegisterFile()
	let realRegisters = classRegisterMask(RegClass.gpr, file: file) or classRegisterMask(RegClass.xmm, file: file)
	let allocatable = realRegisters and not (regMaskOf(X64Register.rsp) or regMaskOf(X64Register.rbp))

	if (callerSavedMask() or calleeSavedMask()) != allocatable 'notAPartition'
		panic("assertCalleeSavedListsMatchMasks: caller-saved u callee-saved is {callerSavedMask() or calleeSavedMask()} but the x64 file minus the frame (rsp/rbp) is {allocatable} — every register the pool offers must be on exactly one side of the call barrier. One on NEITHER side is allocatable, clobbered by no call and saved by no prologue.")
	end 'notAPartition'

	if (callerSavedMask() and calleeSavedMask()) != 0 'overlap'
		panic("assertCalleeSavedListsMatchMasks: {callerSavedMask() and calleeSavedMask()} is in BOTH the caller-saved and the callee-saved mask — a register cannot be destroyed by a call and preserved across it at once.")
	end 'overlap'
end 'assertCalleeSavedListsMatchMasks'

// ⭐ THE STRUCTURAL FACTS THE WHOLE ALLOCATOR RESTS ON, CHECKED ONCE PER COMPILE before the pool is
// spawned (`lowerAndAllocateOnAWorkerPool`).
//
// ORDER IS LOAD-BEARING: most primitive fact first. `callerSavedMask` is built from
// `classRegisterMask`, which is built from `RegisterFileSize` — so a drifted register file makes
// the clobber check fail TOO, and it fails first and blames `TargetDialect.callDirect`, sending
// the reader to a file with nothing wrong in it. Verified by sabotage: with `RegisterFileSize`
// set to 31, the clobber check reported "callDirect ... drifted apart" and named neither the
// constant nor the enum. Checking the file's own width before anything derived from it is read
// means each panic accuses the thing that actually moved.
module function assertRegisterFacts(target Target, pool RegMask, callerSaved RegMask, file RegisterFile)
	assertRegisterFileMatchesEnum()
	assertCallClobberConsistent(target, callerSaved: callerSaved)
	assertRegClassCountMatches()

	// AFTER `assertRegClassCountMatches`, which is the fact its per-class loop walks: a drifted class
	// count would make this report an empty file rather than the miscount that produced it.
	assertVolatilitySplitsEveryClass(pool, callerSaved: callerSaved, file: file, target: target)
	assertEncoderScratchMasks(target)
end 'assertRegisterFacts'

// RENDER THE E5001 A UNIT RUN REFUSED WITH, BY RUNNING THE WHOLE UNIT AGAIN ON THIS THREAD.
//
// The refusal's analysis state - the liveness it was measured against, the fresh-id lineage, the peak -
// is far too large to come back through a reply cell, and it is on a worker's green thread besides. What
// comes home is the bare `RegAllocRefusal`, so the second run is how the state is recovered — EXACTLY: the
// function is re-extracted from the untouched Std module and taken through the same isel, the same edge
// split and the same core, so it refuses at the same peak. A compile that reaches here is failing, so the
// second run (and the fresh variant memo it builds) costs nothing anybody will see.
module function refuseForRegisterPressure(project Project, stdModule StdModule, funcIndex ElementIndex, target Target, abi CalleeAbiTable, usesGt bool, pool RegMask, callerSaved RegMask, file RegisterFile) throws CompileError
	var body = BackendUnitBody.extract(stdModule, func: stdModule.getFunc(funcIndex), runtimeTier: project.libraryFacts.runtimeTier, spanTable: project.debugSpanTable)
	var costs = PoolPhaseCosts.create(RegAllocPhase.allCases.count())
	var iselCost = PhaseDelta.zero()
	var lowered = lowerAndSplitUnit(unitLoweringFor(target, abi: abi, usesGt: usesGt), unitModule: body.unitModule, permitsTailCalls: body.encoding.permitsTailCalls, target: target, costs: costs, iselCost: iselCost)
	try refuseLoweredUnit(project, lowered: lowered, authorFilePath: stdModule.getFunc(funcIndex).sourceFilePath, funcIndex: funcIndex, hasAuthor: body.hasAuthor, pool: pool, callerSaved: callerSaved, file: file, costs: costs)
end 'refuseForRegisterPressure'

// The re-run's allocation of the lowered unit, which rewrites the unit's module and function in place.
function refuseLoweredUnit(project Project, lowered LoweredUnit, authorFilePath FilePath, funcIndex ElementIndex, hasAuthor bool, pool RegMask, callerSaved RegMask, file RegisterFile, costs PoolPhaseCosts) throws CompileError
	var func = lowered.targetModule.getFunc(UnitFunctionIndex)

	// The unit's function is synthesized and names no file; the diagnostic locates the loop in the
	// author's, so the real function's path is put on the record the renderer reads.
	func.sourceFilePath = authorFilePath
	var opFacts = OpVariantFacts.create()
	var refusal = RegAllocRefusalSite.create()
	var counters = RegAllocCounters.create()
	var facts = RegAllocFacts.create()

	// It asks about no named value: the compile is failing, and a diagnostic run has no sidecar to fill.
	try allocateFunctionCore(lowered.targetModule, func: func, hasAuthor: hasAuthor, pool: pool, callerSaved: callerSaved, file: file, valueClass: lowered.valueClass, opFacts: opFacts, counters: counters, costs: costs, facts: facts, refusal: refusal, debugValues: DebugValueRoster.empty(), debugLocations: DebugValueLocationArray.create(0), debugRanges: DebugValueRangeArray.create(0), debugSpans: DebugSpanRows.create()) otherwise 'refusedAgain'
		try renderRegisterPressureRefusal(project, module: lowered.targetModule, func: func, funcIndex: funcIndex, pool: pool, refusal: refusal)
	end 'refusedAgain'

	panic("refuseForRegisterPressure: the core refused '{String.from(func.name)}' on a pool worker and then allocated it on this thread - the two runs saw the same input, so one refusing and the other not is a nondeterminism in the allocator, not a program the compiler can report on")
end 'refuseLoweredUnit'

// Render the E5001 a refused core run recorded. The core throws without a `Project` and leaves the
// analysis state in `refusal`; this is the only place that state is read.
function renderRegisterPressureRefusal(project Project, module TargetModule, func IrFunction, funcIndex ElementIndex, pool RegMask, refusal RegAllocRefusalSite) throws CompileError
	match refusal.refused 'what'
		none then panic("renderRegisterPressureRefusal: the core refused '{String.from(func.name)}' and left no site - `noVictimAtPeak` records the site and throws in one statement, so a `RegAllocRefusal` without one means a second thrower reached this path")
		at(liveness, lineage, peak) then try raiseRegisterPressure(project, module: module, func: func, funcIndex: funcIndex, liveness: liveness, peak: peak, pool: pool, lineage: lineage)
	end 'what'
end 'renderRegisterPressureRefusal'

// Fold ONE function's allocation into the compile: its sub-phase costs into both timing tables, its
// counters into the module's, and its per-function figures into the module's maxima.
//
// The trace event goes last because `arg1` is the CUMULATIVE `valuesSplit`, so the merge must already
// have happened - and this runs in FUNCTION-INDEX order, so the event stream is the same one a serial
// allocation produces whatever order a pool finished in.
module function foldFunctionAllocation(project Project, stats RegAllocStats, func IrFunction, counters RegAllocCounters, costs PoolPhaseCosts, facts RegAllocFacts)
	for phase in RegAllocPhase.allCases 'eachSubPhase'
		addRegAllocDelta(project, phase: phase, delta: costs.accumulated(phase.ordinal))
	end 'eachSubPhase'

	stats.merge(counters)
	stats.recordLivenessMarkSteps(facts.livenessMarkSteps)
	stats.recordRowWordsVisited(facts.rowWordsVisited)

	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		stats.recordPressure(classRowGet(facts.maxPressure, class: class), class: class, funcName: func.name)
	end 'eachClass'

	stats.recordLoopDepth(facts.maxLoopDepth)
	stats.functionsAllocated = stats.functionsAllocated + 1

	// PER-FUNCTION allocator facts, on the wire. The two numbers that decide whether this
	// function was hard - peak pressure, and how many values had to leave a register - are
	// exactly what you want when hunting a spill regression or a false E5001, and the counters
	// beside them are aggregated over the module. A formatted log line here would run once per
	// function and allocate a String into the very `mm` stream a memory investigation is reading.
	//
	// This event allocates NOTHING. `__DebugStream.nameId` is folded to a u16 by the compiler,
	// so the name below never exists at runtime - which is the whole reason the structured tier
	// exists, and why it can sit on a per-function path at all.
	let event = __DebugStream.nameId("regalloc.functionAllocated") as TraceName
	logEvent(CompilerLogGroup.codegen, level: LogLevel.trace, name: event, unit: project.traceUnit, arg0: classRowMax(facts.maxPressure) as TraceArg, arg1: stats.valuesSplit as TraceArg)
end 'foldFunctionAllocation'

// The whole per-function allocation, touching nothing the compile owns: a pool worker runs it.
// Everything it measures goes into values its caller hands it. A hot-loop overflow leaves through
// `refusal` and a `throw`, because E5001 can only be built from tables a `Project` holds.
module function allocateFunctionCore(module TargetModule, func IrFunction, hasAuthor bool, pool RegMask, callerSaved RegMask, file RegisterFile, valueClass ValueClassColumn, opFacts OpVariantFacts, counters RegAllocCounters, costs PoolPhaseCosts, facts RegAllocFacts, refusal RegAllocRefusalSite, debugValues DebugValueRoster, debugLocations DebugValueLocationArray, debugRanges DebugValueRangeArray, debugSpans DebugSpanRows) throws RegAllocRefusal
	// Reverse-postorder first, so layout order matches execution order: the cold-spill splitter's
	// before/after-peak classification and the colorer's dominance walk rest on it, and the parser
	// emits a nested loop's exit before its inner blocks, which would otherwise misclassify an idle
	// value's post-loop use into a false E5001. See `reorderFuncBlocksRpo`.
	//
	// The splitter completes the reordered skeleton into its `FuncCfg` rather than re-deriving it,
	// which is sound because it never adds or removes a block. `splitCriticalEdges` does add blocks,
	// which is why it runs before this.
	let orderProbe = PhaseProbe.beginCounters()
	let topo = reorderFuncBlocksRpo(module, func: func)
	costs.record(RegAllocPhase.blockOrder.ordinal, probe: orderProbe)

	// The splitter runs first because it mutates the IR: it splits idle values out or rematerializes
	// constants until `maxPressure ≤ pool`, and raises E5001 for hot pressure a loop cannot fit. It
	// owns the liveness build and bills it to `RegAllocPhase.liveness` itself, so `recordExcluding`
	// subtracts every quantity of that build, allocations as well as time, back out of `splitting`;
	// otherwise the allocator's biggest cost would hide in the wrong bucket.
	let livenessBefore = costs.accumulated(RegAllocPhase.liveness.ordinal)
	let splitProbe = PhaseProbe.beginCounters()
	var driver = SplitDriver.create(module, func: func, topo: topo, pool: pool, file: file, valueClass: valueClass, opFacts: opFacts, costs: costs)
	try driver.relievePressure(module, func: func, hasAuthor: hasAuthor, counters: counters, refusal: refusal)
	costs.recordExcluding(RegAllocPhase.splitting.ordinal, probe: splitProbe, innerIndex: RegAllocPhase.liveness.ordinal, innerBefore: livenessBefore)

	view liveness = driver.liveness

	// Reuse-def copies the colorer materializes (two-address inputs that outlive their
	// op) — consumed by the rewrite, which splices them. Populated during coloring.
	var reuseCopies = ReuseCopyPlan.create()

	// The save/reload brackets around calls in cold blocks — planned by the colorer, spliced by the
	// rewrite, sized into the frame below.
	var brackets = ColdCallBracketPlan.create(isArm64RegisterFile(file))

	let alloc = colorRepairingConfinements(module, driver: driver, func: func, pool: pool, callerSaved: callerSaved, counters: counters, reuseCopies: reuseCopies, brackets: brackets, costs: costs)

	// The frame is fixed only now, after the relief loop and every repair: a repair consumes a spill
	// slot after the splitter has finished (`SplitDriver.fixFrameSize`).
	driver.fixFrameSize(func)

	// The last point at which a source name can be joined to a machine location: `Allocation` is
	// discarded with this pass, and the encoder sees only physical registers. Read-only: nothing here
	// can move an instruction.
	harvestDebugValueLocations(alloc, liveness: liveness, valueIds: debugValues.valueIds, into: debugLocations)

	// Read after the colouring, because a repair is a split: it walks liveness, enumerates live rows
	// and lowers a block's demand, so figures read before the loop above would miss every repair's
	// cost and report the pre-repair pressure.
	facts.livenessMarkSteps = liveness.livenessMarkSteps
	facts.rowWordsVisited = driver.takeRowWordsVisited()

	// Per class, so the module report names the file that was tight: 14 live ints and 14 live floats
	// is at the limit in both files and over it in neither.
	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		classRowSet(facts.maxPressure, class: class, value: liveness.maxPressureOf(class))
	end 'eachClass'

	facts.maxLoopDepth = liveness.cfg.maxLoopDepth()

	let planProbe = PhaseProbe.beginCounters()
	let plans = buildSsaDestructionPlan(module, alloc: alloc, liveness: liveness, counters: counters)
	costs.record(RegAllocPhase.ssaDestruction.ordinal, probe: planProbe)

	let rewriteProbe = PhaseProbe.beginCounters()
	applyAllocation(module, func: func, alloc: alloc, plans: plans, reuseCopies: reuseCopies, brackets: brackets)

	// After the rewrite, which drops self-moves without renumbering: a run harvested before it would
	// span ops that never reach the encoder, and every window would name code that is not there.
	harvestDebugValueRanges(module, func: func, liveness: liveness, roster: debugValues, locations: debugLocations, opFacts: opFacts, into: debugRanges, spans: debugSpans)
	costs.record(RegAllocPhase.rewrite.ordinal, probe: rewriteProbe)
end 'allocateFunctionCore'

// Where each named value ended up, in the order it was asked about. Nothing is harvested on a build that
// named none, which is what makes the whole carrier cost an ordinary compile one branch.
function harvestDebugValueLocations(alloc Allocation, liveness LivenessResult, valueIds ValueIdArray, into DebugValueLocationArray)
	if valueIds.count() == 0 'nothingNamed'
		return
	end 'nothingNamed'

	into.reserve(valueIds.count())

	for value in valueIds 'eachNamedValue'
		into.push(debugValueLocationOf(alloc, liveness: liveness, value: value))
	end 'eachNamedValue'
end 'harvestDebugValueLocations'

typealias BlockIdColumn = Array with BlockId

typealias DebugNamedSlot = int(0 to u32.max) implements ElementIndex
typealias DebugNamedSlotColumn = Array with DebugNamedSlot
typealias DebugPlace = int(0 to u32.max) implements ElementIndex
typealias DebugPlaceColumn = OptionalIndexColumn with DebugPlace
typealias CopyPartnerColumn = OptionalIndexColumn with ValueId
typealias DebugAnchorColumn = OptionalIndexColumn with DebugOpAnchor

type DebugTouches
	var slots as CsrColumn
	var anchors as CsrColumn

	static function create() returns DebugTouches
		return Self{slots: CsrColumn.create(0), anchors: CsrColumn.create(0)}
	end 'create'

	function note(slot DebugNamedSlot, anchor DebugOpAnchor)
		self.slots.push(slot as CsrIndex)
		self.anchors.push(anchor as CsrIndex)
	end 'note'

	function byAnchor(anchorCount ElementIndex) returns CsrGraph
		return buildCsr(self.anchors, to: self.slots, nodeCount: anchorCount as CsrIndex)
	end 'byAnchor'
end 'DebugTouches'

typealias DebugSlotColumn = OptionalIndexColumn with SpillSlot

type DebugBlockPlaces
	export var ordinalOfOp as DebugAnchorColumn
	export var placeOfLocal as DebugPlaceColumn
	export var localOfPlace as CfgIndexArray
	export var blockIdOfPlace as BlockIdColumn
	export var siteKeyOfPlace as DebugSiteKeyColumn
	export var blockFirst as DebugAnchorColumn
	export var blockLast as DebugAnchorColumn
	export var storedSlotAt as DebugSlotColumn
	export var anchorCount as DebugOpAnchor

	static function over(module TargetModule, func IrFunction, topo FuncTopology, opFacts OpVariantFacts, noteStores bool) returns DebugBlockPlaces
		var places = Self{ordinalOfOp: DebugAnchorColumn.absent(module.ops.count()), placeOfLocal: DebugPlaceColumn.absent(topo.numBlocks), localOfPlace: CfgIndexArray.create(0), blockIdOfPlace: BlockIdColumn.create(0), siteKeyOfPlace: DebugSiteKeyColumn.create(0), blockFirst: DebugAnchorColumn.create(), blockLast: DebugAnchorColumn.create(), storedSlotAt: DebugSlotColumn.create(), anchorCount: 0}

		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("DebugBlockPlaces.over: blockRef from func.blockRefs not in module.blocks")
			let opened = places.anchorCount

			for opIdx in block.bodyOps() 'eachOp'
				places.noteOp(module, opIdx: opIdx, opFacts: opFacts, noteStores: noteStores)
			end 'eachOp'

			if block.hasTerminatorOp() 'hasTerminator'
				places.noteOp(module, opIdx: block.terminatorIndex(), opFacts: opFacts, noteStores: noteStores)
			end 'hasTerminator'

			places.placeOfLocal.set(localOfBlockId(topo, blockId: block.id), value: places.localOfPlace.count() as DebugPlace)
			places.localOfPlace.push(localOfBlockId(topo, blockId: block.id))
			places.blockIdOfPlace.push(block.id)
			places.siteKeyOfPlace.push(debugSiteKeyOf(block.inlineSite))

			if places.anchorCount == opened 'emitsNothing'
				places.blockFirst.pushAbsent()
				places.blockLast.pushAbsent()
			end 'emitsNothing' else 'emitsOps'
				places.blockFirst.push(opened)
				places.blockLast.push(places.anchorCount - 1)
			end 'emitsOps'
		end 'eachBlock'

		return places
	end 'over'

	function noteOp(module TargetModule, opIdx ElementIndex, opFacts OpVariantFacts, noteStores bool)
		self.ordinalOfOp.set(opIdx, value: self.anchorCount)
		self.anchorCount = self.anchorCount + 1

		if not noteStores 'storesNotAsked'
			self.storedSlotAt.pushAbsent()
			return
		end 'storesNotAsked'

		let op = try module.ops.get(opIdx) otherwise panic("DebugBlockPlaces.noteOp: ops.get OOB at {opIdx}")

		if opFacts.slotRoleOf(op) == OpSlotRole.spillStore 'aSpillStore'
			self.storedSlotAt.push(slotOfSlotOp(op))
		end 'aSpillStore' else 'anyOtherOp'
			self.storedSlotAt.pushAbsent()
		end 'anyOtherOp'
	end 'noteOp'
end 'DebugBlockPlaces'

function harvestDebugValueRanges(module TargetModule, func IrFunction, liveness LivenessResult, roster DebugValueRoster, locations DebugValueLocationArray, opFacts OpVariantFacts, into DebugValueRangeArray, spans DebugSpanRows)
	if roster.valueIds.count() == 0 'nothingNamed'
		return
	end 'nothingNamed'

	let topo = liveness.cfg.topo
	let names = DebugNameIndex.over(roster, valueCount: liveness.valueCount)
	let refining = debugRunsNeedRefining(roster, liveness: liveness, locations: locations, paramCount: func.paramCount, topo: topo)
	let places = DebugBlockPlaces.over(module, func: func, topo: topo, opFacts: opFacts, noteStores: refining)

	if not refining 'runsStandAsHarvested'
		collectDebugRuns(liveness, roster: roster, names: names, places: places, into: into)
		return
	end 'runsStandAsHarvested'

	var raw = DebugValueRangeArray.create(0)
	collectDebugRuns(liveness, roster: roster, names: names, places: places, into: raw)
	refineDebugRuns(raw, into: into, spans: spans, liveness: liveness, roster: roster, locations: locations, names: names, places: places, paramCount: func.paramCount)
end 'harvestDebugValueRanges'

function collectDebugRuns(liveness LivenessResult, roster DebugValueRoster, names DebugNameIndex, places DebugBlockPlaces, into DebugValueRangeArray)
	var scratch = DebugNamedSlotColumn.create(0)
	var touches = DebugTouches.create()
	collectDebugTouches(touches, liveness: liveness, names: names, ordinalOfOp: places.ordinalOfOp, placeOfLocal: places.placeOfLocal, blockFirst: places.blockFirst, siteKeyOfPlace: places.siteKeyOfPlace, scratch: scratch)
	let byAnchor = touches.byAnchor(places.anchorCount)

	var startOrd = DebugAnchorColumn.absent(roster.valueIds.count())
	var endOrd = DebugAnchorColumn.absent(roster.valueIds.count())
	var active = DebugNamedSlotColumn.create(0)
	var members = ValueIdArray.create(0)

	for (place, local) in places.localOfPlace.withIterator() 'eachBlocksRuns'
		let first = try places.blockFirst.get(place.index()) otherwise continue
		let last = try places.blockLast.get(place.index()) otherwise panic("collectDebugRuns: place {place.index()} opens at anchor {first} and records no last anchor — a block that emits an op has both")
		let siteKey = debugSiteKeyAt(places.siteKeyOfPlace, at: place.index())

		active.clear()

		liveness.live.liveInInto(local, out: members)

		for value in members 'eachLiveIn'
			openNamedRuns(active, startOrd: startOrd, endOrd: endOrd, names: names, value: value, siteKey: siteKey, at: first, scratch: scratch)
		end 'eachLiveIn'

		let liveOnEntry = active.count()

		for anchor in first upto last + 1 'eachAnchor'
			for k in 0 upto byAnchor.degree(anchor as CsrIndex) 'eachTouchHere'
				openDebugRun(active, startOrd: startOrd, endOrd: endOrd, slot: byAnchor.neighbour(anchor as CsrIndex, k: k) as DebugNamedSlot, at: anchor)
			end 'eachTouchHere'
		end 'eachAnchor'

		liveness.live.liveOutInto(local, out: members)

		for value in members 'eachLiveOut'
			openNamedRuns(active, startOrd: startOrd, endOrd: endOrd, names: names, value: value, siteKey: siteKey, at: last, scratch: scratch)
		end 'eachLiveOut'

		let blockId = try places.blockIdOfPlace.get(place.index()) otherwise panic("collectDebugRuns: blockIdOfPlace.get OOB at {place.index()} of {places.blockIdOfPlace.count()}")

		var opening = 0 as ElementIndex

		for slot in active 'eachRun'
			let opened = try startOrd.get(slot) otherwise panic("collectDebugRuns: slot {slot} is active with no opening anchor — `openDebugRun` sets both ends before it activates a slot")
			let closed = try endOrd.get(slot) otherwise panic("collectDebugRuns: slot {slot} is active with no closing anchor — `openDebugRun` sets both ends before it activates a slot")
			into.push(DebugValueRange.create(slot, blockId: blockId, first: opened, last: closed, fromBlockEntry: opening < liveOnEntry))
			opening = opening + 1
			startOrd.clear(slot)
			endOrd.clear(slot)
		end 'eachRun'
	end 'eachBlocksRuns'
end 'collectDebugRuns'

// `byValue` lists each value's names in ascending site key — `over` feeds them site by site and
// `buildCsr` keeps push order within a key — and `collectNamesAt` bisects on that order.
type DebugNameIndex
	var byValue as CsrGraph
	var siteKeys as DebugSiteKeyColumn
	var siteParents as DebugSiteKeyColumn

	static function over(roster DebugValueRoster, valueCount ValueId) returns DebugNameIndex
		var sites = CsrColumn.create(0)
		var names = CsrColumn.create(0)

		for (iter, value) in roster.valueIds.withIterator() 'eachName'
			if value < valueCount 'inThisFunction'
				sites.push(debugSiteKeyAt(roster.siteKeys, at: iter.index()) as CsrIndex)
				names.push(iter.index() as CsrIndex)
			end 'inThisFunction'
		end 'eachName'

		let bySite = buildCsr(sites, to: names, nodeCount: roster.siteKeyCount() as CsrIndex)
		var values = CsrColumn.create(0)
		var siteOrdered = CsrColumn.create(0)

		for site in 0 upto bySite.nodeCount() 'eachSite'
			for k in 0 upto bySite.degree(site) 'eachNameOfTheSite'
				let name = bySite.neighbour(site, k: k)
				values.push((try roster.valueIds.get(name) otherwise panic("DebugNameIndex.over: name {name} is past the roster's {roster.valueIds.count()} values")) as CsrIndex)
				siteOrdered.push(name)
			end 'eachNameOfTheSite'
		end 'eachSite'

		return Self{byValue: buildCsr(values, to: siteOrdered, nodeCount: valueCount as CsrIndex), siteKeys: roster.siteKeys, siteParents: siteParentsOf(roster)}
	end 'over'

	function isNamed(value ValueId) returns bool
		return (value as CsrIndex) < self.byValue.nodeCount() and self.byValue.degree(value as CsrIndex) > 0
	end 'isNamed'

	function collectApplicable(value ValueId, siteKey DebugSiteKey, into DebugNamedSlotColumn)
		into.clear()

		var enclosing = siteKey
		self.collectNamesAt(enclosing, value: value as CsrIndex, into: into)

		while enclosing != FunctionTextSiteKey 'eachEnclosingSite'
			enclosing = debugSiteKeyAt(self.siteParents, at: enclosing as ElementIndex)
			self.collectNamesAt(enclosing, value: value as CsrIndex, into: into)
		end 'eachEnclosingSite'
	end 'collectApplicable'

	function collectNamesAt(siteKey DebugSiteKey, value CsrIndex, into DebugNamedSlotColumn)
		let limit = self.byValue.degree(value)
		var low = 0 as CsrIndex
		var high = limit

		while low < high 'bisect'
			let middle = low + (high - low) / 2

			if self.siteKeyOf(self.byValue.neighbour(value, k: middle)) < siteKey 'below'
				low = middle + 1
			end 'below' else 'atOrAbove'
				high = middle
			end 'atOrAbove'
		end 'bisect'

		for k in low upto limit 'eachNameOfTheSite'
			let name = self.byValue.neighbour(value, k: k)

			if self.siteKeyOf(name) != siteKey 'pastTheSite'
				return
			end 'pastTheSite'

			into.push(name as DebugNamedSlot)
		end 'eachNameOfTheSite'
	end 'collectNamesAt'

	function siteKeyOf(name CsrIndex) returns DebugSiteKey
		return debugSiteKeyAt(self.siteKeys, at: name)
	end 'siteKeyOf'

	function siteCount() returns ElementIndex
		return self.siteParents.count()
	end 'siteCount'

	function parentOfSite(site ElementIndex) returns DebugSiteKey
		return debugSiteKeyAt(self.siteParents, at: site)
	end 'parentOfSite'

	function appliesAt(slot DebugNamedSlot, siteKey DebugSiteKey) returns bool
		let own = self.siteKeyOf(slot as CsrIndex)
		var enclosing = siteKey

		while enclosing != own and enclosing != FunctionTextSiteKey 'climbs'
			enclosing = debugSiteKeyAt(self.siteParents, at: enclosing as ElementIndex)
		end 'climbs'

		return enclosing == own
	end 'appliesAt'
end 'DebugNameIndex'

function siteParentsOf(roster DebugValueRoster) returns DebugSiteKeyColumn
	var parents = DebugSiteKeyColumn.create(roster.siteKeyCount(), zeroed: false)
	parents.push(FunctionTextSiteKey)

	for parent in roster.parentKeys 'eachSite'
		parents.push(parent)
	end 'eachSite'

	return parents
end 'siteParentsOf'

function debugSiteKeyAt(column DebugSiteKeyColumn, at ElementIndex) returns DebugSiteKey
	return try column.get(at) otherwise panic("harvestDebugValueRanges: a site column was read at {at}, past the {column.count()} it was sized to")
end 'debugSiteKeyAt'

function openNamedRuns(active DebugNamedSlotColumn, startOrd DebugAnchorColumn, endOrd DebugAnchorColumn, names DebugNameIndex, value ValueId, siteKey DebugSiteKey, at DebugOpAnchor, scratch DebugNamedSlotColumn)
	if not names.isNamed(value) 'unnamed'
		return
	end 'unnamed'

	names.collectApplicable(value, siteKey: siteKey, into: scratch)

	for slot in scratch 'eachApplicable'
		openDebugRun(active, startOrd: startOrd, endOrd: endOrd, slot: slot, at: at)
	end 'eachApplicable'
end 'openNamedRuns'

function openDebugRun(active DebugNamedSlotColumn, startOrd DebugAnchorColumn, endOrd DebugAnchorColumn, slot DebugNamedSlot, at DebugOpAnchor)
	if not startOrd.holds(slot) 'firstTouchInThisBlock'
		startOrd.set(slot, value: at)
		endOrd.set(slot, value: at)
		active.push(slot)

		return
	end 'firstTouchInThisBlock'

	if at > (try endOrd.get(slot) otherwise panic("openDebugRun: slot {slot} opened a run with no closing anchor — both ends are set together")) 'widens'
		endOrd.set(slot, value: at)
	end 'widens'
end 'openDebugRun'

type DebugDefSite
	export let local as ElementIndex
	export let anchor as DebugOpAnchor
	export let anchorKnown as bool
	export let afterPrevious as bool

	static function at(local ElementIndex, anchor DebugOpAnchor) returns DebugDefSite
		return Self{local: local, anchor: anchor, anchorKnown: true, afterPrevious: false}
	end 'at'

	static function after(local ElementIndex, op DebugOpAnchor) returns DebugDefSite
		return Self{local: local, anchor: op + 1, anchorKnown: true, afterPrevious: true}
	end 'after'

	static function somewhereIn(local ElementIndex) returns DebugDefSite
		return Self{local: local, anchor: 0, anchorKnown: false, afterPrevious: false}
	end 'somewhereIn'
end 'DebugDefSite'

function debugDefSiteOf(index UseIndex, value ValueId, ordinalOfOp DebugAnchorColumn, placeOfLocal DebugPlaceColumn, blockFirst DebugAnchorColumn) returns DebugDefSite
	return match index.defKindOf(value) 'def'
		none gives debugDefSiteAtBlockStart(EntryBlockLocal, placeOfLocal: placeOfLocal, blockFirst: blockFirst)
		opDef gives debugDefSiteOfOp(index, value: value, ordinalOfOp: ordinalOfOp)
		phiDef gives debugDefSiteAtBlockStart(index.defBlockOf(value), placeOfLocal: placeOfLocal, blockFirst: blockFirst)
	end 'def'
end 'debugDefSiteOf'

function debugDefSiteOfOp(index UseIndex, value ValueId, ordinalOfOp DebugAnchorColumn) returns DebugDefSite
	let anchor = try ordinalOfOp.get(index.requireDefOp(value)) otherwise return DebugDefSite.somewhereIn(index.defBlockOf(value))
	return DebugDefSite.at(index.defBlockOf(value), anchor: anchor)
end 'debugDefSiteOfOp'

function debugDefSiteAtBlockStart(local ElementIndex, placeOfLocal DebugPlaceColumn, blockFirst DebugAnchorColumn) returns DebugDefSite
	let place = try placeOfLocal.get(local) otherwise return DebugDefSite.somewhereIn(local)
	let anchor = try blockFirst.get(place) otherwise return DebugDefSite.somewhereIn(local)
	return DebugDefSite.at(local, anchor: anchor)
end 'debugDefSiteAtBlockStart'

enum DebugRunRefinement
	none
	clipsTheStart
	placesInTheFlow
end 'DebugRunRefinement'

typealias DebugRunRefinementColumn = Array with DebugRunRefinement

enum DebugRivalry
	placed
	vetoed
end 'DebugRivalry'

function debugCodeDefLocal(index UseIndex, value ValueId) returns ElementIndex
	return match index.defKindOf(value) 'def'
		none gives EntryBlockLocal
		opDef or
		phiDef gives index.defBlockOf(value)
	end 'def'
end 'debugCodeDefLocal'

function debugValueIsDefinedByTheCode(index UseIndex, value ValueId, valueCount ValueId, paramCount ParamCount) returns bool
	return value < valueCount and (index.defKindOf(value) != ValueDefKind.none or value < paramCount as ValueId)
end 'debugValueIsDefinedByTheCode'

function debugVersionMayBeBorrowed(roster DebugValueRoster, ordinal ElementIndex, value ValueId, index UseIndex, valueCount ValueId, paramCount ParamCount, topo FuncTopology) returns bool
	if not debugValueIsDefinedByTheCode(index, value: value, valueCount: valueCount, paramCount: paramCount) 'notDefinedByTheCode'
		return false
	end 'notDefinedByTheCode'

	let kind = try roster.versionKinds.get(ordinal) otherwise panic("debugVersionMayBeBorrowed: roster.versionKinds.get OOB at {ordinal}")

	return match kind 'kind'
		merged or
		definedSomewhere gives false
		definedAfter gives (try roster.versionAnchors.get(ordinal) otherwise panic("debugVersionMayBeBorrowed: roster.versionAnchors.get OOB at {ordinal}")) != value
		definedIn gives debugRecordedBlockDiffersFromTheDefinition(roster, ordinal: ordinal, value: value, index: index, topo: topo)
	end 'kind'
end 'debugVersionMayBeBorrowed'

function debugRecordedBlockDiffersFromTheDefinition(roster DebugValueRoster, ordinal ElementIndex, value ValueId, index UseIndex, topo FuncTopology) returns bool
	let (placed, recordedLocal) = debugRecordedBlockLocal(try roster.versionBlocks.get(ordinal) otherwise panic("debugRecordedBlockDiffersFromTheDefinition: roster.versionBlocks.get OOB at {ordinal}"), topo: topo)
	return placed and recordedLocal != debugCodeDefLocal(index, value: value)
end 'debugRecordedBlockDiffersFromTheDefinition'

function debugRunsNeedRefining(roster DebugValueRoster, liveness LivenessResult, locations DebugValueLocationArray, paramCount ParamCount, topo FuncTopology) returns bool
	for (iter, location) in locations.withIterator() 'eachLocation'
		if location.kind == DebugValueInSpillSlot 'spilled'
			return true
		end 'spilled'

		let value = try roster.valueIds.get(iter.index()) otherwise panic("debugRunsNeedRefining: roster.valueIds.get OOB at {iter.index()}")

		if debugVersionMayBeBorrowed(roster, ordinal: iter.index(), value: value, index: liveness.useIndex, valueCount: liveness.valueCount, paramCount: paramCount, topo: topo) 'borrowed'
			return true
		end 'borrowed'
	end 'eachLocation'

	var groupCount = 0 as ElementIndex

	for group in roster.groups 'eachGroup'
		if (group as ElementIndex) + 1 > groupCount 'moreGroups'
			groupCount = (group as ElementIndex) + 1
		end 'moreGroups'
	end 'eachGroup'

	return roster.valueIds.count() > groupCount
end 'debugRunsNeedRefining'

let DebugAnchorWalkLimit = 256

let DebugOrdinalSpan = 4294967296

typealias DebugVersionOrigins = Map with ElementIndex, ElementIndex

function debugBindingOrderKey(handoverAt DebugAnchorColumn, ordinal ElementIndex) returns ElementIndex
	return ((try handoverAt.get(ordinal) otherwise 0) as ElementIndex) * DebugOrdinalSpan + ordinal
end 'debugBindingOrderKey'

function debugSiteAfterAnchor(index UseIndex, anchor ValueId, recordedLocal ElementIndex, places DebugBlockPlaces, valueCount ValueId, dom DominatorTree) returns (bool, ValueId, DebugDefSite)
	var candidate = anchor

	for _ in 0 upto DebugAnchorWalkLimit 'eachEarlierValue'
		if candidate < valueCount and index.defKindOf(candidate) != ValueDefKind.none and dom.dominates(recordedLocal, y: index.defBlockOf(candidate)) 'definedBelowTheRecordedBlock'
			if index.defKindOf(candidate) == ValueDefKind.opDef 'byAnOp'
				if let ordinal = try places.ordinalOfOp.get(index.requireDefOp(candidate)) 'anOpTheCodeStillHolds'
					return (true, candidate, DebugDefSite.after(index.defBlockOf(candidate), op: ordinal))
				end 'anOpTheCodeStillHolds'
			end 'byAnOp' else 'byABlockArg'
				let blockStart = debugDefSiteAtBlockStart(index.defBlockOf(candidate), placeOfLocal: places.placeOfLocal, blockFirst: places.blockFirst)

				if blockStart.anchorKnown 'aBlockThatStillEmitsCode'
					return (true, candidate, blockStart)
				end 'aBlockThatStillEmitsCode'
			end 'byABlockArg'
		end 'definedBelowTheRecordedBlock'

		if candidate == 0 'noEarlierValue'
			break
		end 'noEarlierValue'

		candidate = candidate - 1
	end 'eachEarlierValue'

	return (false, anchor, DebugDefSite.somewhereIn(recordedLocal))
end 'debugSiteAfterAnchor'

function debugBorrowedSite(roster DebugValueRoster, ordinal ElementIndex, value ValueId, own DebugDefSite, index UseIndex, valueCount ValueId, places DebugBlockPlaces, topo FuncTopology, dom DominatorTree) returns (bool, DebugDefSite)
	let kind = try roster.versionKinds.get(ordinal) otherwise panic("debugBorrowedSite: roster.versionKinds.get OOB at {ordinal}")
	let (placed, recordedLocal) = debugRecordedBlockLocal(try roster.versionBlocks.get(ordinal) otherwise panic("debugBorrowedSite: roster.versionBlocks.get OOB at {ordinal}"), topo: topo)

	if not placed 'noBlockToPlaceItIn'
		return (false, own)
	end 'noBlockToPlaceItIn'

	return match kind 'kind'
		merged or
		definedSomewhere gives (false, own)
		definedIn gives debugSiteAtBlockStartIfMoved(recordedLocal, own: own, places: places)
		definedAfter gives debugSiteAfterAnchorIfMoved(roster, ordinal: ordinal, value: value, own: own, recordedLocal: recordedLocal, index: index, valueCount: valueCount, places: places, dom: dom)
	end 'kind'
end 'debugBorrowedSite'

function debugSiteAtBlockStartIfMoved(recordedLocal ElementIndex, own DebugDefSite, places DebugBlockPlaces) returns (bool, DebugDefSite)
	if recordedLocal == own.local 'whereTheValueIsDefined'
		return (false, own)
	end 'whereTheValueIsDefined'

	return (true, debugDefSiteAtBlockStart(recordedLocal, placeOfLocal: places.placeOfLocal, blockFirst: places.blockFirst))
end 'debugSiteAtBlockStartIfMoved'

function debugSiteAfterAnchorIfMoved(roster DebugValueRoster, ordinal ElementIndex, value ValueId, own DebugDefSite, recordedLocal ElementIndex, index UseIndex, valueCount ValueId, places DebugBlockPlaces, dom DominatorTree) returns (bool, DebugDefSite)
	let anchor = try roster.versionAnchors.get(ordinal) otherwise panic("debugSiteAfterAnchorIfMoved: roster.versionAnchors.get OOB at {ordinal}")

	if anchor == value 'theValueIsTheLastOne'
		return (false, own)
	end 'theValueIsTheLastOne'

	let (anchored, found, site) = debugSiteAfterAnchor(index, anchor: anchor, recordedLocal: recordedLocal, places: places, valueCount: valueCount, dom: dom)

	if not anchored or found == value 'positionLost'
		return (false, own)
	end 'positionLost'

	return (true, site)
end 'debugSiteAfterAnchorIfMoved'

function debugSpilledStartAnchor(site DebugDefSite, defKind ValueDefKind, places DebugBlockPlaces, number DebugValueNumber) returns DebugOpAnchor
	let storeAt = match defKind 'def'
		opDef gives site.anchor + 1
		none or
		phiDef gives site.anchor
	end 'def'

	let place = try places.placeOfLocal.get(site.local) otherwise return site.anchor
	let last = try places.blockLast.get(place) otherwise return site.anchor

	if storeAt > last 'noStoreInTheBlock'
		return site.anchor
	end 'noStoreInTheBlock'

	let stored = try places.storedSlotAt.get(storeAt as ElementIndex) otherwise return site.anchor

	if (stored as DebugValueNumber) != number 'anotherSlot'
		return site.anchor
	end 'anotherSlot'

	return storeAt + 1
end 'debugSpilledStartAnchor'

function debugRefinementOf(kind DebugValueLocationKind, borrowed bool, groupUnplaceable bool, groupShared bool) returns DebugRunRefinement
	if kind == DebugValueNowhere 'nothingToRefine'
		return DebugRunRefinement.none
	end 'nothingToRefine'

	if kind == DebugValueInSpillSlot and not groupUnplaceable 'aSlotInAGroupItCanBePlacedIn'
		return DebugRunRefinement.placesInTheFlow
	end 'aSlotInAGroupItCanBePlacedIn'

	if kind == DebugValueInSpillSlot and not borrowed 'aSlotAtItsOwnDefinition'
		return DebugRunRefinement.clipsTheStart
	end 'aSlotAtItsOwnDefinition'

	return DebugRunRefinement.placesInTheFlow if (borrowed or groupShared) and kind == DebugValueInRegister else DebugRunRefinement.none
end 'debugRefinementOf'

function debugSiteOfParsePlacedAnchor(roster DebugValueRoster, ordinal ElementIndex, recordedLocal ElementIndex, index UseIndex, valueCount ValueId, places DebugBlockPlaces, dom DominatorTree) returns DebugDefSite
	let (_, _, site) = debugSiteAfterAnchor(index, anchor: try roster.versionAnchors.get(ordinal) otherwise panic("debugSiteOfParsePlacedAnchor: roster.versionAnchors.get OOB at {ordinal}"), recordedLocal: recordedLocal, places: places, valueCount: valueCount, dom: dom)
	return site
end 'debugSiteOfParsePlacedAnchor'

function debugRecordedBlockLocal(block BlockId, topo FuncTopology) returns (bool, ElementIndex)
	let local = try topo.localByBlockId.get(block) otherwise return (false, EntryBlockLocal)
	return (local != topo.numBlocks, local)
end 'debugRecordedBlockLocal'

type DebugBindingSites
	export var defLocal as CfgIndexArray
	export var startAt as DebugAnchorColumn
	export var startAfterPrevious as FixedBoolArray
	export var handoverAt as DebugAnchorColumn
	export var parsePlaced as FixedBoolArray
	export var refinement as DebugRunRefinementColumn
	export var byGroup as CsrGraph
	export var byGroupInFlow as CsrGraph
	export var preOf as CfgIndexArray
	export var spanEnd as CfgIndexArray
	export var looseGroup as FixedBoolArray
	export var orderKey as FixedCfgIndexArray
	export var repeatsEarlier as FixedBoolArray

	static function over(roster DebugValueRoster, liveness LivenessResult, locations DebugValueLocationArray, places DebugBlockPlaces, topo FuncTopology, dom DominatorTree, paramCount ParamCount) returns DebugBindingSites
		let index = liveness.useIndex
		let count = roster.valueIds.count()
		var defLocal = CfgIndexArray.create(count, zeroed: false)
		var startAt = DebugAnchorColumn.absent(count)
		var startAfterPrevious = FixedBoolArray.create(count)
		var handoverAt = DebugAnchorColumn.absent(count)
		var borrowed = FixedBoolArray.create(count)
		var parsePlaced = FixedBoolArray.create(count)
		var groupOfOrdinal = CsrColumn.create(roster.valueIds.count(), zeroed: false)
		var ordinals = CsrColumn.create(roster.valueIds.count(), zeroed: false)
		var groupCount = 0 as CsrIndex
		var unplaceableGroups = CsrColumn.create(0)

		for (iter, value) in roster.valueIds.withIterator() 'eachNamedValue'
			let ordinal = iter.index()
			defLocal.push(EntryBlockLocal)
			let group = (try roster.groups.get(ordinal) otherwise panic("DebugBindingSites.over: roster.groups.get OOB at {ordinal}")) as CsrIndex

			if group + 1 > groupCount 'moreGroups'
				groupCount = group + 1
			end 'moreGroups'

			var site = DebugDefSite.somewhereIn(EntryBlockLocal)

			if debugValueIsDefinedByTheCode(index, value: value, valueCount: liveness.valueCount, paramCount: paramCount) 'placedByTheCode'
				site = debugDefSiteOf(index, value: value, ordinalOfOp: places.ordinalOfOp, placeOfLocal: places.placeOfLocal, blockFirst: places.blockFirst)
				let (moved, bound) = debugBorrowedSite(roster, ordinal: ordinal, value: value, own: site, index: index, valueCount: liveness.valueCount, places: places, topo: topo, dom: dom)

				if moved 'borrowedFromElsewhere'
					site = bound
					try borrowed.set(ordinal, value: true) otherwise panic("DebugBindingSites.over: borrowed.set OOB at {ordinal}")
				end 'borrowedFromElsewhere'

				if site.anchorKnown 'anAnchoredDefinition'
					startAt.set(ordinal, value: site.anchor)
					try startAfterPrevious.set(ordinal, value: site.afterPrevious) otherwise panic("DebugBindingSites.over: startAfterPrevious.set OOB at {ordinal}")
					handoverAt.set(ordinal, value: site.anchor + 1 if not moved and index.defKindOf(value) == ValueDefKind.opDef else site.anchor)
				end 'anAnchoredDefinition'

				let location = try locations.get(ordinal) otherwise panic("DebugBindingSites.over: locations.get OOB at {ordinal}")

				if location.kind == DebugValueInRegister and not moved and site.anchorKnown and index.defKindOf(value) == ValueDefKind.opDef 'aRegisterWrittenByTheDefinition'
					startAt.set(ordinal, value: site.anchor + 1)
					try startAfterPrevious.set(ordinal, value: true) otherwise panic("DebugBindingSites.over: startAfterPrevious.set OOB at {ordinal}")
				end 'aRegisterWrittenByTheDefinition'

				if location.kind == DebugValueInSpillSlot and not moved and site.anchorKnown 'aSlotWrittenAfterTheDefinition'
					let spilledStart = debugSpilledStartAnchor(site, defKind: index.defKindOf(value), places: places, number: location.number)
					startAt.set(ordinal, value: spilledStart)
					try startAfterPrevious.set(ordinal, value: spilledStart != site.anchor) otherwise panic("DebugBindingSites.over: startAfterPrevious.set OOB at {ordinal}")
				end 'aSlotWrittenAfterTheDefinition'
			end 'placedByTheCode' else 'placedByTheParse'
				let recordedKind = try roster.versionKinds.get(ordinal) otherwise panic("DebugBindingSites.over: roster.versionKinds.get OOB at {ordinal}")

				if recordedKind == DebugVersionKind.merged 'aMerge'
					continue
				end 'aMerge'

				let (placed, recordedLocal) = debugRecordedBlockLocal(try roster.versionBlocks.get(ordinal) otherwise panic("DebugBindingSites.over: roster.versionBlocks.get OOB at {ordinal}"), topo: topo)

				if recordedKind == DebugVersionKind.definedSomewhere or not placed 'anUnplaceableDefinition'
					unplaceableGroups.push(group)
					continue
				end 'anUnplaceableDefinition'

				site = debugDefSiteAtBlockStart(recordedLocal, placeOfLocal: places.placeOfLocal, blockFirst: places.blockFirst)

				if recordedKind == DebugVersionKind.definedAfter 'positionedByAnAnchor'
					site = debugSiteOfParsePlacedAnchor(roster, ordinal: ordinal, recordedLocal: recordedLocal, index: index, valueCount: liveness.valueCount, places: places, dom: dom)
				end 'positionedByAnAnchor'

				try parsePlaced.set(ordinal, value: true) otherwise panic("DebugBindingSites.over: parsePlaced.set OOB at {ordinal}")

				if site.anchorKnown 'anAnchoredParseSite'
					handoverAt.set(ordinal, value: site.anchor)
				end 'anAnchoredParseSite'
			end 'placedByTheParse'

			try defLocal.set(ordinal, value: site.local) otherwise panic("DebugBindingSites.over: defLocal.set OOB at {ordinal}")

			groupOfOrdinal.push(group)
			ordinals.push(ordinal as CsrIndex)
		end 'eachNamedValue'

		var unplaceable = FlagColumn.create(groupCount as ElementIndex)

		for group in unplaceableGroups 'eachUnplaceableGroup'
			try unplaceable.set(group, value: true) otherwise panic("DebugBindingSites.over: unplaceable.set OOB at {group}")
		end 'eachUnplaceableGroup'

		let byGroup = buildCsr(groupOfOrdinal, to: ordinals, nodeCount: groupCount)
		var preOf = CfgIndexArray.create(count, zeroed: false)
		var spanEnd = CfgIndexArray.create(count, zeroed: false)

		for local in defLocal 'eachDefinitionBlock'
			preOf.push(dom.preorderOf(local))
			spanEnd.push(dom.preorderOf(local) + dom.dominatedCount(local))
		end 'eachDefinitionBlock'

		var orderKey = FixedCfgIndexArray.create(count)
		var keyed = CfgIndexArray.create(ordinals.count(), zeroed: false)

		for grouped in ordinals 'eachGroupedOrdinal'
			let key = debugBindingOrderKey(handoverAt, ordinal: grouped as ElementIndex)
			try orderKey.set(grouped as ElementIndex, value: key) otherwise panic("DebugBindingSites.over: orderKey.set OOB at {grouped}")
			keyed.push(key)
		end 'eachGroupedOrdinal'

		keyed.sort()
		var inBindingOrder = CsrColumn.create(keyed.count(), zeroed: false)
		var preKeys = CsrColumn.create(keyed.count(), zeroed: false)

		for key in keyed 'eachKeyInOrder'
			let grouped = key mod DebugOrdinalSpan
			inBindingOrder.push(grouped as CsrIndex)
			preKeys.push((try preOf.get(grouped) otherwise panic("DebugBindingSites.over: preOf.get OOB at {grouped}")) as CsrIndex)
		end 'eachKeyInOrder'

		let byPre = buildCsr(preKeys, to: inBindingOrder, nodeCount: topo.numBlocks as CsrIndex)
		var flowGroups = CsrColumn.create(ordinals.count(), zeroed: false)
		var flowOrdinals = CsrColumn.create(ordinals.count(), zeroed: false)

		for position in 0 upto byPre.nodeCount() 'eachPreorderPosition'
			for k in 0 upto byPre.degree(position) 'eachOrdinalThere'
				let grouped = byPre.neighbour(position, k: k)
				flowOrdinals.push(grouped)
				flowGroups.push((try roster.groups.get(grouped as ElementIndex) otherwise panic("DebugBindingSites.over: roster.groups.get OOB at {grouped}")) as CsrIndex)
			end 'eachOrdinalThere'
		end 'eachPreorderPosition'

		let byGroupInFlow = buildCsr(flowGroups, to: flowOrdinals, nodeCount: groupCount)
		var looseGroup = FixedBoolArray.create(groupCount as ElementIndex)

		for (iter, parsed) in parsePlaced.withIterator() 'eachParsePlaced'
			if parsed and not handoverAt.holds(iter.index()) 'withoutAPosition'
				try looseGroup.set(try roster.groups.get(iter.index()) otherwise panic("DebugBindingSites.over: roster.groups.get OOB at {iter.index()}"), value: true) otherwise panic("DebugBindingSites.over: looseGroup.set OOB at {iter.index()}")
			end 'withoutAPosition'
		end 'eachParsePlaced'

		var repeatsEarlier = FixedBoolArray.create(count)
		var firstOfVersion = DebugVersionOrigins.create()

		for (iter, location) in locations.withIterator() 'eachSpilledVersion'
			if location.kind != DebugValueInSpillSlot 'notInASlot'
				continue
			end 'notInASlot'

			let spilled = iter.index()
			let versionKey = (try roster.groups.get(spilled) otherwise panic("DebugBindingSites.over: roster.groups.get OOB at {spilled}")) * DebugOrdinalSpan + (try roster.valueIds.get(spilled) otherwise panic("DebugBindingSites.over: roster.valueIds.get OOB at {spilled}"))

			if firstOfVersion.contains(versionKey) 'anEarlierOrdinalOfIt'
				try repeatsEarlier.set(spilled, value: true) otherwise panic("DebugBindingSites.over: repeatsEarlier.set OOB at {spilled}")
			end 'anEarlierOrdinalOfIt' else 'theFirstOrdinalOfIt'
				firstOfVersion.upsert(versionKey, value: spilled)
			end 'theFirstOrdinalOfIt'
		end 'eachSpilledVersion'

		var refinement = DebugRunRefinementColumn.create(count, zeroed: false)

		for (iter, location) in locations.withIterator() 'eachLocation'
			let ordinal = iter.index()
			let group = (try roster.groups.get(ordinal) otherwise panic("DebugBindingSites.over: roster.groups.get OOB at {ordinal}")) as CsrIndex
			refinement.push(debugRefinementOf(location.kind, borrowed: try borrowed.get(ordinal) otherwise panic("DebugBindingSites.over: borrowed.get OOB at {ordinal}"), groupUnplaceable: try unplaceable.get(group) otherwise panic("DebugBindingSites.over: unplaceable.get OOB at {group}"), groupShared: byGroup.degree(group) > 1))
		end 'eachLocation'

		return Self{defLocal: defLocal, startAt: startAt, startAfterPrevious: startAfterPrevious, handoverAt: handoverAt, parsePlaced: parsePlaced, refinement: refinement, byGroup: byGroup, byGroupInFlow: byGroupInFlow, preOf: preOf, spanEnd: spanEnd, looseGroup: looseGroup, orderKey: orderKey, repeatsEarlier: repeatsEarlier}
	end 'over'

	function refinementOf(ordinal ElementIndex) returns DebugRunRefinement
		return try self.refinement.get(ordinal) otherwise panic("DebugBindingSites.refinementOf: refinement.get OOB at {ordinal}")
	end 'refinementOf'
end 'DebugBindingSites'

typealias FixedDebugAnchorArray = FixedArray with DebugOpAnchor
typealias DebugAnchorArray = Array with DebugOpAnchor

enum DebugScopeState
	open
	ended
	lostSomewhere
end 'DebugScopeState'

type DebugRunRefiner
	var visited as FixedCfgIndexArray
	var revived as FixedCfgIndexArray
	var cutStamp as FixedCfgIndexArray
	var cutBefore as FixedDebugAnchorArray
	var stopStamp as FixedCfgIndexArray
	var pending as CfgIndexArray
	var rivals as CfgIndexArray
	var positionless as bool
	var resumeAfter as CfgIndexArray
	var scopeLocals as CfgIndexArray
	var rivalLocals as CfgIndexArray
	var rivalFirst as CfgIndexArray
	var rivalPast as CfgIndexArray
	var rivalCuts as DebugAnchorArray
	var rivalCutKnown as BoolArray
	var stopLocals as CfgIndexArray
	var holeStarts as CfgIndexArray
	var holeEnds as CfgIndexArray
	var candidates as CfgIndexArray
	var points as CfgIndexArray
	var frontier as CsrGraph
	var siteChildren as CsrGraph
	var siteLocals as CsrGraph
	var siteWalk as CfgIndexArray
	var viewOfSite as FixedCfgIndexArray
	var viewPreorders as CfgIndexArray

	static function over(topo FuncTopology, dom DominatorTree, places DebugBlockPlaces, names DebugNameIndex) returns DebugRunRefiner
		let blockCount = topo.numBlocks
		var visited = FixedCfgIndexArray.create(blockCount)
		var revived = FixedCfgIndexArray.create(blockCount)
		var cutStamp = FixedCfgIndexArray.create(blockCount)
		var cutBefore = FixedDebugAnchorArray.create(blockCount)
		var stopStamp = FixedCfgIndexArray.create(blockCount)
		let siteCount = names.siteCount()
		var viewOfSite = FixedCfgIndexArray.create(siteCount)
		var childOf = CsrColumn.create(siteCount - 1, zeroed: false)
		var children = CsrColumn.create(siteCount - 1, zeroed: false)

		for site in 1 upto siteCount 'eachInlineSite'
			childOf.push(names.parentOfSite(site) as CsrIndex)
			children.push(site as CsrIndex)
		end 'eachInlineSite'

		var siteOf = CsrColumn.create(places.localOfPlace.count(), zeroed: false)
		var localsOf = CsrColumn.create(places.localOfPlace.count(), zeroed: false)

		for (place, local) in places.localOfPlace.withIterator() 'eachPlace'
			siteOf.push(debugSiteKeyAt(places.siteKeyOfPlace, at: place.index()) as CsrIndex)
			localsOf.push(local as CsrIndex)
		end 'eachPlace'

		return Self{visited: visited, revived: revived, cutStamp: cutStamp, cutBefore: cutBefore, stopStamp: stopStamp, pending: CfgIndexArray.create(0), rivals: CfgIndexArray.create(0), positionless: false, resumeAfter: CfgIndexArray.create(0), scopeLocals: CfgIndexArray.create(0), rivalLocals: CfgIndexArray.create(0), rivalFirst: CfgIndexArray.create(0), rivalPast: CfgIndexArray.create(0), rivalCuts: DebugAnchorArray.create(0), rivalCutKnown: BoolArray.create(0), stopLocals: CfgIndexArray.create(0), holeStarts: CfgIndexArray.create(0), holeEnds: CfgIndexArray.create(0), candidates: CfgIndexArray.create(0), points: CfgIndexArray.create(0), frontier: debugDominanceFrontiers(topo, dom: dom), siteChildren: buildCsr(childOf, to: children, nodeCount: siteCount as CsrIndex), siteLocals: buildCsr(siteOf, to: localsOf, nodeCount: siteCount as CsrIndex), siteWalk: CfgIndexArray.create(0), viewOfSite: viewOfSite, viewPreorders: CfgIndexArray.create(0)}
	end 'over'

	function cutBlockBefore(local ElementIndex, anchor DebugOpAnchor, stamp ElementIndex)
		self.stopAt(local, stamp: stamp)

		let held = (try self.cutStamp.get(local) otherwise panic("DebugRunRefiner.cutBlockBefore: cutStamp.get OOB at {local}")) == stamp

		if held and (try self.cutBefore.get(local) otherwise panic("DebugRunRefiner.cutBlockBefore: cutBefore.get OOB at {local}")) <= anchor 'anEarlierCutStands'
			return
		end 'anEarlierCutStands'

		try self.cutStamp.set(local, value: stamp) otherwise panic("DebugRunRefiner.cutBlockBefore: cutStamp.set OOB at {local}")
		try self.cutBefore.set(local, value: anchor) otherwise panic("DebugRunRefiner.cutBlockBefore: cutBefore.set OOB at {local}")
	end 'cutBlockBefore'

	function stopAt(local ElementIndex, stamp ElementIndex)
		if (try self.stopStamp.get(local) otherwise panic("DebugRunRefiner.stopAt: stopStamp.get OOB at {local}")) != stamp 'aNewStop'
			self.stopLocals.push(local)
		end 'aNewStop'

		try self.stopStamp.set(local, value: stamp) otherwise panic("DebugRunRefiner.stopAt: stopStamp.set OOB at {local}")
	end 'stopAt'

	function lastAllowedIn(local ElementIndex, last DebugOpAnchor, stamp ElementIndex) returns (bool, DebugOpAnchor)
		if (try self.cutStamp.get(local) otherwise panic("DebugRunRefiner.lastAllowedIn: cutStamp.get OOB at {local}")) != stamp 'noCutHere'
			return (true, last)
		end 'noCutHere'

		let before = try self.cutBefore.get(local) otherwise panic("DebugRunRefiner.lastAllowedIn: cutBefore.get OOB at {local}")

		if before == 0 'nothingBefore'
			return (false, last)
		end 'nothingBefore'

		return (true, last if last < before else before - 1)
	end 'lastAllowedIn'

	function scopeStateOf(ordinal ElementIndex, roster DebugValueRoster, topo FuncTopology) returns DebugScopeState
		self.scopeLocals.clear()

		let first = try roster.scopeFirst.get(ordinal) otherwise panic("DebugRunRefiner.scopeStateOf: roster.scopeFirst.get OOB at {ordinal}")
		let count = try roster.scopeCount.get(ordinal) otherwise panic("DebugRunRefiner.scopeStateOf: roster.scopeCount.get OOB at {ordinal}")
		let lost = try roster.scopeLost.get(ordinal) otherwise panic("DebugRunRefiner.scopeStateOf: roster.scopeLost.get OOB at {ordinal}")

		if count == 0 and not lost 'scopeStillOpen'
			return DebugScopeState.open
		end 'scopeStillOpen'

		var state = DebugScopeState.lostSomewhere if lost else DebugScopeState.ended

		for k in first upto first + count 'eachScopeExit'
			let (placed, exitLocal) = debugRecordedBlockLocal(try roster.scopeEndBlocks.get(k) otherwise panic("DebugRunRefiner.scopeStateOf: roster.scopeEndBlocks.get OOB at {k}"), topo: topo)

			if placed 'aBlockTheCodeStillHolds'
				self.scopeLocals.push(exitLocal)
			end 'aBlockTheCodeStillHolds' else 'aBlockThatIsGone'
				state = DebugScopeState.lostSomewhere
			end 'aBlockThatIsGone'
		end 'eachScopeExit'

		return state
	end 'scopeStateOf'

	function settle(ordinal ElementIndex, roster DebugValueRoster, sites DebugBindingSites, topo FuncTopology, dom DominatorTree) returns DebugRivalry
		let ownLocal = debugLocalAt(sites, ordinal: ordinal)
		let stamp = ordinal + 1
		let group = debugGroupAt(roster, ordinal: ordinal)
		self.resumeAfter.clear()
		self.stopLocals.clear()

		let ownScope = self.scopeStateOf(ordinal, roster: roster, topo: topo)

		for exitLocal in self.scopeLocals 'eachOwnScopeExit'
			self.stopAt(exitLocal, stamp: stamp)
		end 'eachOwnScopeExit'

		if ownScope == DebugScopeState.lostSomewhere 'itsEndIsNotKnown'
			self.stopAt(ownLocal, stamp: stamp)
		end 'itsEndIsNotKnown'

		self.collectMaximalRivals(ordinal, rowsOnly: false, roster: roster, sites: sites)
		var vetoed = self.positionless

		for k in 0 upto self.rivals.count() 'eachMaximalRival'
			let rival = try self.rivals.get(k) otherwise panic("DebugRunRefiner.settle: rivals.get OOB at {k}")
			let rivalLocal = debugLocalAt(sites, ordinal: rival)
			self.cutBlockBefore(rivalLocal, anchor: self.cutOf(rival, sites: sites), stamp: stamp)

			if rivalLocal != ownLocal and (try roster.decls.get(rival) otherwise panic("DebugRunRefiner.settle: roster.decls.get OOB at {rival}")) != (try roster.decls.get(ordinal) otherwise panic("DebugRunRefiner.settle: roster.decls.get OOB at {ordinal}")) 'aShadowingDeclaration'
				self.resumeWhereTheScopeOfEnds(rival, roster: roster, topo: topo)
			end 'aShadowingDeclaration'
		end 'eachMaximalRival'

		if (try sites.looseGroup.get(group) otherwise panic("DebugRunRefiner.settle: looseGroup.get OOB at {group}")) and self.aLaterVersionMayLieBeyondTheSplit(ordinal, roster: roster, sites: sites, dom: dom) 'aLaterVersionMaybeBeyondTheSplit'
			vetoed = true
		end 'aLaterVersionMaybeBeyondTheSplit'

		return DebugRivalry.vetoed if vetoed else DebugRivalry.placed
	end 'settle'

	function resumeWhereTheScopeOfEnds(rival ElementIndex, roster DebugValueRoster, topo FuncTopology)
		if self.scopeStateOf(rival, roster: roster, topo: topo) != DebugScopeState.ended 'noKnownEnd'
			return
		end 'noKnownEnd'

		for exitLocal in self.scopeLocals 'eachExitOfTheShadowingScope'
			self.resumeAfter.push(exitLocal)
		end 'eachExitOfTheShadowingScope'
	end 'resumeWhereTheScopeOfEnds'

	function cutOf(rival ElementIndex, sites DebugBindingSites) returns DebugOpAnchor
		if sites.handoverAt.holds(rival) 'anExactPosition'
			return debugHandoverAt(sites, ordinal: rival)
		end 'anExactPosition'

		return 0
	end 'cutOf'

	function collectLaterRivals(ordinal ElementIndex, roster DebugValueRoster, sites DebugBindingSites, dom DominatorTree)
		self.rivalLocals.clear()
		self.rivalFirst.clear()
		self.rivalPast.clear()
		self.rivalCuts.clear()
		self.rivalCutKnown.clear()
		self.collectMaximalRivals(ordinal, rowsOnly: true, roster: roster, sites: sites)

		for k in 0 upto self.rivals.count() 'eachMaximalRival'
			let rival = try self.rivals.get(k) otherwise panic("DebugRunRefiner.collectLaterRivals: rivals.get OOB at {k}")
			let rivalLocal = debugLocalAt(sites, ordinal: rival)
			self.rivalLocals.push(rivalLocal)
			self.rivalFirst.push(dom.preorderOf(rivalLocal))
			self.rivalPast.push(dom.preorderOf(rivalLocal) + dom.dominatedCount(rivalLocal))
			self.rivalCutKnown.push(sites.handoverAt.holds(rival))
			self.rivalCuts.push(self.cutOf(rival, sites: sites))
		end 'eachMaximalRival'
	end 'collectLaterRivals'

	function collectMaximalRivals(ordinal ElementIndex, rowsOnly bool, roster DebugValueRoster, sites DebugBindingSites)
		self.rivals.clear()
		self.positionless = false

		let own = debugValueAt(roster, ordinal: ordinal)
		let group = debugGroupAt(roster, ordinal: ordinal)
		let ownFirst = debugPreorderOf(sites, ordinal: ordinal)
		let ownPast = debugSpanEndOf(sites, ordinal: ordinal)
		let ownKey = debugOrderKeyOf(sites, ordinal: ordinal)
		let size = sites.byGroupInFlow.degree(group)
		let blockStart = self.firstNotBefore(sites, group: group, from: 0, preorder: ownFirst, key: 0)
		let blockEnd = self.firstNotBefore(sites, group: group, from: blockStart, preorder: ownFirst + 1, key: 0)
		var at = blockStart

		while at < blockEnd and not (sites.handoverAt.holds(ordinal) and (sites.handoverAt.holds(sites.byGroupInFlow.neighbour(group, k: at) as ElementIndex))) 'eachRivalWithoutAPosition'
			if self.isARivalWorthCutting(sites.byGroupInFlow.neighbour(group, k: at) as ElementIndex, own: own, rowsOnly: rowsOnly, roster: roster, sites: sites) 'aPositionlessRival'
				self.positionless = true
			end 'aPositionlessRival'

			at = at + 1
		end 'eachRivalWithoutAPosition'

		if sites.handoverAt.holds(ordinal) 'positionedInItsBlock'
			var later = self.firstNotBefore(sites, group: group, from: at, preorder: ownFirst, key: ownKey + 1)

			while later < blockEnd 'eachLaterInTheBlock'
				let candidate = sites.byGroupInFlow.neighbour(group, k: later) as ElementIndex

				if self.isARivalWorthCutting(candidate, own: own, rowsOnly: rowsOnly, roster: roster, sites: sites) 'theNearestLaterVersion'
					self.rivals.push(candidate)
					break
				end 'theNearestLaterVersion'

				later = later + 1
			end 'eachLaterInTheBlock'
		end 'positionedInItsBlock'

		at = blockEnd

		while at < size 'eachCandidateBelow'
			let first = sites.byGroupInFlow.neighbour(group, k: at) as ElementIndex
			let candidateFirst = debugPreorderOf(sites, ordinal: first)

			if candidateFirst >= ownPast 'pastTheSubtree'
				break
			end 'pastTheSubtree'

			let past = self.firstNotBefore(sites, group: group, from: at + 1, preorder: candidateFirst + 1, key: 0)
			var scan = at
			var chosen = first
			var found = false

			while scan < past and not found 'theEarliestInTheBlock'
				let candidate = sites.byGroupInFlow.neighbour(group, k: scan) as ElementIndex

				if self.isARivalWorthCutting(candidate, own: own, rowsOnly: rowsOnly, roster: roster, sites: sites) 'worthCutting'
					self.rivals.push(candidate)
					chosen = candidate
					found = true
				end 'worthCutting'

				scan = scan + 1
			end 'theEarliestInTheBlock'

			at = self.firstNotBefore(sites, group: group, from: past, preorder: debugSpanEndOf(sites, ordinal: chosen), key: 0) if found else past
		end 'eachCandidateBelow'
	end 'collectMaximalRivals'

	function isARivalWorthCutting(rival ElementIndex, own ValueId, rowsOnly bool, roster DebugValueRoster, sites DebugBindingSites) returns bool
		if debugValueAt(roster, ordinal: rival) == own 'theSameVersion'
			return false
		end 'theSameVersion'

		return not (rowsOnly and (try sites.parsePlaced.get(rival) otherwise panic("DebugRunRefiner.isARivalWorthCutting: parsePlaced.get OOB at {rival}")))
	end 'isARivalWorthCutting'

	function firstNotBefore(sites DebugBindingSites, group CsrIndex, from CsrIndex, preorder ElementIndex, key ElementIndex) returns CsrIndex
		var low = from
		var high = sites.byGroupInFlow.degree(group)

		while low < high 'narrow'
			let middle = low + (high - low) / 2
			let entry = sites.byGroupInFlow.neighbour(group, k: middle) as ElementIndex
			let entryFirst = debugPreorderOf(sites, ordinal: entry)

			if entryFirst < preorder or (entryFirst == preorder and debugOrderKeyOf(sites, ordinal: entry) < key) 'before'
				low = middle + 1
			end 'before' else 'atOrAfter'
				high = middle
			end 'atOrAfter'
		end 'narrow'

		return low
	end 'firstNotBefore'

	function aLaterVersionMayLieBeyondTheSplit(ordinal ElementIndex, roster DebugValueRoster, sites DebugBindingSites, dom DominatorTree) returns bool
		let own = debugValueAt(roster, ordinal: ordinal)
		let ownLocal = debugLocalAt(sites, ordinal: ordinal)
		let group = debugGroupAt(roster, ordinal: ordinal)

		for k in 0 upto sites.byGroup.degree(group) 'eachVersionOfTheName'
			let rival = sites.byGroup.neighbour(group, k: k)

			if debugValueAt(roster, ordinal: rival) > own and (try sites.parsePlaced.get(rival) otherwise panic("DebugRunRefiner.aLaterVersionMayLieBeyondTheSplit: parsePlaced.get OOB at {rival}")) and not sites.handoverAt.holds(rival) and dom.dominates(debugLocalAt(sites, ordinal: rival), y: ownLocal) 'unplacedAndAbove'
				return true
			end 'unplacedAndAbove'
		end 'eachVersionOfTheName'

		return false
	end 'aLaterVersionMayLieBeyondTheSplit'

	function laterRivalsAllow(local ElementIndex, last DebugOpAnchor, dom DominatorTree) returns (bool, DebugOpAnchor)
		var allowed = last
		let position = dom.preorderOf(local)

		for k in 0 upto self.rivalLocals.count() 'eachLaterRival'
			let rivalLocal = try self.rivalLocals.get(k) otherwise panic("DebugRunRefiner.laterRivalsAllow: rivalLocals.get OOB at {k}")

			if rivalLocal != local 'inAnotherBlock'
				if (try self.rivalFirst.get(k) otherwise panic("DebugRunRefiner.laterRivalsAllow: rivalFirst.get OOB at {k}")) <= position and position < (try self.rivalPast.get(k) otherwise panic("DebugRunRefiner.laterRivalsAllow: rivalPast.get OOB at {k}")) 'belowTheRival'
					return (false, last)
				end 'belowTheRival'

				continue
			end 'inAnotherBlock'

			if not (try self.rivalCutKnown.get(k) otherwise panic("DebugRunRefiner.laterRivalsAllow: rivalCutKnown.get OOB at {k}")) 'cutUnknown'
				return (false, last)
			end 'cutUnknown'

			let before = try self.rivalCuts.get(k) otherwise panic("DebugRunRefiner.laterRivalsAllow: rivalCuts.get OOB at {k}")

			if before == 0 'nothingBefore'
				return (false, last)
			end 'nothingBefore'

			allowed = allowed if allowed < before else before - 1
		end 'eachLaterRival'

		return (true, allowed)
	end 'laterRivalsAllow'

	function refine(ordinal ElementIndex, runsOf CsrGraph, raw DebugValueRangeArray, into DebugValueRangeArray, spans DebugSpanRows, roster DebugValueRoster, locations DebugValueLocationArray, names DebugNameIndex, places DebugBlockPlaces, sites DebugBindingSites, topo FuncTopology, dom DominatorTree)
		let location = try locations.get(ordinal) otherwise panic("DebugRunRefiner.refine: locations.get OOB at {ordinal}")
		var cutsByLaterVersions = false
		var scopeBounded = false
		var settled = false

		if sites.refinementOf(ordinal) == DebugRunRefinement.placesInTheFlow and location.kind == DebugValueInRegister 'laterVersionsOfARegister'
			cutsByLaterVersions = true
			self.collectLaterRivals(ordinal, roster: roster, sites: sites, dom: dom)
			scopeBounded = self.markScopeRegion(ordinal, roster: roster, sites: sites, topo: topo, dom: dom)
		end 'laterVersionsOfARegister' else if sites.refinementOf(ordinal) == DebugRunRefinement.placesInTheFlow 'canBePlaced'
			settled = self.settle(ordinal, roster: roster, sites: sites, topo: topo, dom: dom) == DebugRivalry.placed
		end 'canBePlaced'

		if settled 'rowsOfTheFlow'
			if not (try sites.repeatsEarlier.get(ordinal) otherwise panic("DebugRunRefiner.refine: repeatsEarlier.get OOB at {ordinal}")) 'notRepeated'
				self.extend(ordinal, into: into, spans: spans, names: names, places: places, sites: sites, topo: topo, dom: dom)
			end 'notRepeated'

			return
		end 'rowsOfTheFlow'

		for k in 0 upto runsOf.degree(ordinal as CsrIndex) 'eachRawRun'
			let range = try raw.get(runsOf.neighbour(ordinal as CsrIndex, k: k) as ElementIndex) otherwise panic("DebugRunRefiner.refine: raw.get OOB for a run of {ordinal}")
			self.keepRun(ordinal, range: range, cutsByLaterVersions: cutsByLaterVersions, scopeBounded: scopeBounded, into: into, sites: sites, topo: topo, dom: dom)
		end 'eachRawRun'
	end 'refine'

	function markScopeRegion(ordinal ElementIndex, roster DebugValueRoster, sites DebugBindingSites, topo FuncTopology, dom DominatorTree) returns bool
		let scope = self.scopeStateOf(ordinal, roster: roster, topo: topo)

		if scope == DebugScopeState.open 'scopeStillOpen'
			return false
		end 'scopeStillOpen'

		let ownLocal = debugLocalAt(sites, ordinal: ordinal)
		let dominatedFirst = debugPreorderOf(sites, ordinal: ordinal)
		let dominatedPast = debugSpanEndOf(sites, ordinal: ordinal) if dom.isReached(ownLocal) else dominatedFirst
		let stamp = ordinal + 1
		self.pending.clear()
		self.stopLocals.clear()
		self.pending.push(ownLocal)
		try self.visited.set(ownLocal, value: stamp) otherwise panic("DebugRunRefiner.markScopeRegion: visited.set OOB at {ownLocal}")

		if scope == DebugScopeState.lostSomewhere 'nowhereToStop'
			return true
		end 'nowhereToStop'

		for exitLocal in self.scopeLocals 'eachScopeExit'
			self.stopAt(exitLocal, stamp: stamp)
		end 'eachScopeExit'

		while self.pending.count() > 0 'untilNothingIsPending'
			let local = try self.pending.pop() otherwise panic("DebugRunRefiner.markScopeRegion: pending.pop on a non-empty list failed")

			if (try self.stopStamp.get(local) otherwise panic("DebugRunRefiner.markScopeRegion: stopStamp.get OOB at {local}")) != stamp 'beforeTheScopeEnds'
				self.visitSuccessors(local, ownLocal: ownLocal, stamp: stamp, dominatedFirst: dominatedFirst, dominatedPast: dominatedPast, topo: topo, dom: dom)
			end 'beforeTheScopeEnds'
		end 'untilNothingIsPending'

		return true
	end 'markScopeRegion'

	function keepRun(ordinal ElementIndex, range DebugValueRange, cutsByLaterVersions bool, scopeBounded bool, into DebugValueRangeArray, sites DebugBindingSites, topo FuncTopology, dom DominatorTree)
		let local = localOfBlockId(topo, blockId: range.blockId)
		let ownLocal = debugLocalAt(sites, ordinal: ordinal)

		if cutsByLaterVersions and (not dom.dominates(ownLocal, y: local) or (scopeBounded and (try self.visited.get(local) otherwise panic("DebugRunRefiner.keepRun: visited.get OOB at {local}")) != ordinal + 1)) 'outsideWhereItIsBound'
			return
		end 'outsideWhereItIsBound'

		var first = range.first
		var last = range.last
		var fromBlockEntry = range.fromBlockEntry
		var behindAnOp = false

		if local == ownLocal and sites.startAt.holds(ordinal) 'inTheBindingBlock'
			let start = try sites.startAt.get(ordinal) otherwise panic("DebugRunRefiner.keepRun: startAt holds {ordinal} and yet does not give it")

			if first < start 'beginsBeforeItIsBound'
				first = start
				fromBlockEntry = false
				behindAnOp = try sites.startAfterPrevious.get(ordinal) otherwise panic("DebugRunRefiner.keepRun: startAfterPrevious.get OOB at {ordinal}")
			end 'beginsBeforeItIsBound'
		end 'inTheBindingBlock'

		if cutsByLaterVersions 'cutByALaterVersion'
			let (reaches, allowed) = self.laterRivalsAllow(local, last: last, dom: dom)

			if not reaches 'nothingLeft'
				return
			end 'nothingLeft'

			last = allowed
		end 'cutByALaterVersion'

		if first > last 'coversNothing'
			return
		end 'coversNothing'

		if first == range.first and last == range.last 'unchanged'
			into.push(range)
			return
		end 'unchanged'

		into.push(debugRunRange(range.valueOrdinal, blockId: range.blockId, first: first, last: last, fromBlockEntry: fromBlockEntry, behindAnOp: behindAnOp))
	end 'keepRun'

	function extendByFlood(ordinal ElementIndex, into DebugValueRangeArray, names DebugNameIndex, places DebugBlockPlaces, sites DebugBindingSites, topo FuncTopology, dom DominatorTree)
		let ownLocal = debugLocalAt(sites, ordinal: ordinal)
		let dominatedFirst = debugPreorderOf(sites, ordinal: ordinal)
		let dominatedPast = debugSpanEndOf(sites, ordinal: ordinal) if dom.isReached(ownLocal) else dominatedFirst
		let stamp = ordinal + 1
		self.pending.clear()
		self.pending.push(ownLocal)
		try self.visited.set(ownLocal, value: stamp) otherwise panic("DebugRunRefiner.extend: visited.set OOB at {ownLocal}")

		for resumed in self.resumeAfter 'eachScopeEnd'
			self.visitSuccessors(resumed, ownLocal: ownLocal, stamp: stamp, dominatedFirst: dominatedFirst, dominatedPast: dominatedPast, topo: topo, dom: dom)
		end 'eachScopeEnd'

		while self.pending.count() > 0 'untilNothingIsPending'
			let local = try self.pending.pop() otherwise panic("DebugRunRefiner.extend: pending.pop on a non-empty list failed")
			self.pushRowOfBlock(ordinal, local: local, ownLocal: ownLocal, into: into, names: names, places: places, sites: sites)

			if (try self.stopStamp.get(local) otherwise panic("DebugRunRefiner.extend: stopStamp.get OOB at {local}")) == stamp 'aVersionOrTheScopeEndsHere'
				continue
			end 'aVersionOrTheScopeEndsHere'

			self.visitSuccessors(local, ownLocal: ownLocal, stamp: stamp, dominatedFirst: dominatedFirst, dominatedPast: dominatedPast, topo: topo, dom: dom)
		end 'untilNothingIsPending'
	end 'extendByFlood'

	function extend(ordinal ElementIndex, into DebugValueRangeArray, spans DebugSpanRows, names DebugNameIndex, places DebugBlockPlaces, sites DebugBindingSites, topo FuncTopology, dom DominatorTree)
		if dom.reducible and dom.isReached(debugLocalAt(sites, ordinal: ordinal)) 'itsRegionHasAFrontier'
			self.extendByIntervals(ordinal, into: into, spans: spans, names: names, places: places, sites: sites, topo: topo, dom: dom)
			return
		end 'itsRegionHasAFrontier'

		self.extendByFlood(ordinal, into: into, names: names, places: places, sites: sites, topo: topo, dom: dom)
	end 'extend'

	function extendByIntervals(ordinal ElementIndex, into DebugValueRangeArray, spans DebugSpanRows, names DebugNameIndex, places DebugBlockPlaces, sites DebugBindingSites, topo FuncTopology, dom DominatorTree)
		let ownLocal = debugLocalAt(sites, ordinal: ordinal)
		let stamp = ordinal + 1
		let regionFirst = debugPreorderOf(sites, ordinal: ordinal)
		let regionPast = debugSpanEndOf(sites, ordinal: ordinal)
		self.pushRowOfBlock(ordinal, local: ownLocal, ownLocal: ownLocal, into: into, names: names, places: places, sites: sites)

		if (try self.stopStamp.get(ownLocal) otherwise panic("DebugRunRefiner.extendByIntervals: stopStamp.get OOB at {ownLocal}")) == stamp 'theRegionIsTheDefinitionBlock'
			self.holeStarts.clear()
			self.holeEnds.clear()
			self.holeStarts.push(regionFirst + 1)
			self.holeEnds.push(regionPast)
		end 'theRegionIsTheDefinitionBlock' else 'theRegionReachesFurther'
			self.findUnreachable(ownLocal, stamp: stamp, regionFirst: regionFirst, regionPast: regionPast, topo: topo, dom: dom)
		end 'theRegionReachesFurther'

		self.points.clear()
		self.points.push(regionFirst)

		for stop in self.stopLocals 'eachStop'
			if not self.isReachedInside(stop, regionFirst: regionFirst, regionPast: regionPast, dom: dom) 'outsideTheRegion'
				continue
			end 'outsideTheRegion'

			self.pushRowOfBlock(ordinal, local: stop, ownLocal: ownLocal, into: into, names: names, places: places, sites: sites)
			self.points.push(dom.preorderOf(stop))
		end 'eachStop'

		self.reviveAfterShadowingScopes(ordinal, ownLocal: ownLocal, stamp: stamp, regionFirst: regionFirst, regionPast: regionPast, into: into, names: names, places: places, sites: sites, topo: topo, dom: dom)
		let view = self.viewOf(names.siteKeyOf(ordinal as CsrIndex), spans: spans, places: places, dom: dom)

		for point in self.points 'eachPointRowedOnItsOwn'
			self.holeStarts.push(point)
			self.holeEnds.push(point + 1)
		end 'eachPointRowedOnItsOwn'

		self.normalizeHoles()
		var cursor = regionFirst

		for at in 0 upto self.holeStarts.count() 'eachHole'
			let holeStart = try self.holeStarts.get(at) otherwise panic("DebugRunRefiner.extendByIntervals: holeStarts.get OOB at {at}")
			let holeEnd = try self.holeEnds.get(at) otherwise panic("DebugRunRefiner.extendByIntervals: holeEnds.get OOB at {at}")

			if holeStart > cursor 'aStretchBeforeTheHole'
				self.pushSpanOver(ordinal, view: view, first: cursor, past: holeStart, spans: spans)
			end 'aStretchBeforeTheHole'

			cursor = holeEnd if holeEnd > cursor else cursor
		end 'eachHole'

		if cursor < regionPast 'aStretchToTheRegionsEnd'
			self.pushSpanOver(ordinal, view: view, first: cursor, past: regionPast, spans: spans)
		end 'aStretchToTheRegionsEnd'
	end 'extendByIntervals'

	function viewOf(siteKey DebugSiteKey, spans DebugSpanRows, places DebugBlockPlaces, dom DominatorTree) returns ElementIndex
		let known = try self.viewOfSite.get(siteKey as ElementIndex) otherwise panic("DebugRunRefiner.viewOf: viewOfSite.get OOB at {siteKey}")

		if known > 0 'aViewAlreadyBuilt'
			return known - 1
		end 'aViewAlreadyBuilt'

		var keyed = CfgIndexArray.create(0)
		self.siteWalk.clear()
		self.siteWalk.push(siteKey as ElementIndex)

		while self.siteWalk.count() > 0 'untilEverySiteIsWalked'
			let site = (try self.siteWalk.pop() otherwise panic("DebugRunRefiner.viewOf: siteWalk.pop on a non-empty list failed")) as CsrIndex

			for k in 0 upto self.siteLocals.degree(site) 'eachBlockOfTheSite'
				let local = self.siteLocals.neighbour(site, k: k) as ElementIndex

				if dom.isReached(local) and self.emitsOps(local, places: places) 'aBlockWithCode'
					keyed.push(dom.preorderOf(local) * DebugOrdinalSpan + local)
				end 'aBlockWithCode'
			end 'eachBlockOfTheSite'

			for k in 0 upto self.siteChildren.degree(site) 'eachNestedSite'
				self.siteWalk.push(self.siteChildren.neighbour(site, k: k) as ElementIndex)
			end 'eachNestedSite'
		end 'untilEverySiteIsWalked'

		keyed.sort()

		for key in keyed 'eachBlockInPreorder'
			let local = key mod DebugOrdinalSpan
			let place = try places.placeOfLocal.get(local) otherwise panic("DebugRunRefiner.viewOf: block {local} has no place")
			spans.blocks.push(try places.blockIdOfPlace.get(place) otherwise panic("DebugRunRefiner.viewOf: blockIdOfPlace.get OOB at {place}"))
			spans.lastAnchors.push((try places.blockLast.get(place) otherwise panic("DebugRunRefiner.viewOf: block {local} emits no ops")) as ElementIndex)
			self.viewPreorders.push(key / DebugOrdinalSpan)
		end 'eachBlockInPreorder'

		let view = spans.closeView()
		try self.viewOfSite.set(siteKey as ElementIndex, value: view + 1) otherwise panic("DebugRunRefiner.viewOf: viewOfSite.set OOB at {siteKey}")
		return view
	end 'viewOf'

	function emitsOps(local ElementIndex, places DebugBlockPlaces) returns bool
		if let place = try places.placeOfLocal.get(local) 'aPlace'
			return places.blockLast.holds(place)
		end 'aPlace'

		return false
	end 'emitsOps'

	function pushSpanOver(ordinal ElementIndex, view ElementIndex, first ElementIndex, past ElementIndex, spans DebugSpanRows)
		let viewFirst = spans.viewFirst(view)
		let viewPast = spans.viewPast(view)
		let rankFirst = self.firstPreorderAtLeast(first, from: viewFirst, past: viewPast)
		let rankPast = self.firstPreorderAtLeast(past, from: rankFirst, past: viewPast)

		if rankFirst < rankPast 'blocksInTheStretch'
			spans.spans.push(DebugValueSpan.create(ordinal, view: view, first: rankFirst - viewFirst, past: rankPast - viewFirst))
		end 'blocksInTheStretch'
	end 'pushSpanOver'

	function firstPreorderAtLeast(preorder ElementIndex, from ElementIndex, past ElementIndex) returns ElementIndex
		var low = from
		var high = past

		while low < high 'narrow'
			let middle = low + (high - low) / 2

			if (try self.viewPreorders.get(middle) otherwise panic("DebugRunRefiner.firstPreorderAtLeast: viewPreorders.get OOB at {middle}")) < preorder 'below'
				low = middle + 1
			end 'below' else 'atOrAbove'
				high = middle
			end 'atOrAbove'
		end 'narrow'

		return low
	end 'firstPreorderAtLeast'

	function reviveAfterShadowingScopes(ordinal ElementIndex, ownLocal ElementIndex, stamp ElementIndex, regionFirst ElementIndex, regionPast ElementIndex, into DebugValueRangeArray, names DebugNameIndex, places DebugBlockPlaces, sites DebugBindingSites, topo FuncTopology, dom DominatorTree)
		self.pending.clear()

		for resumed in self.resumeAfter 'eachScopeEnd'
			self.reviveSuccessors(resumed, ownLocal: ownLocal, stamp: stamp, regionFirst: regionFirst, regionPast: regionPast, topo: topo, dom: dom)
		end 'eachScopeEnd'

		while self.pending.count() > 0 'untilNothingIsPending'
			let local = try self.pending.pop() otherwise panic("DebugRunRefiner.reviveAfterShadowingScopes: pending.pop on a non-empty list failed")
			self.pushRowOfBlock(ordinal, local: local, ownLocal: ownLocal, into: into, names: names, places: places, sites: sites)

			if (try self.stopStamp.get(local) otherwise panic("DebugRunRefiner.reviveAfterShadowingScopes: stopStamp.get OOB at {local}")) == stamp 'aVersionOrTheScopeEndsHere'
				continue
			end 'aVersionOrTheScopeEndsHere'

			self.reviveSuccessors(local, ownLocal: ownLocal, stamp: stamp, regionFirst: regionFirst, regionPast: regionPast, topo: topo, dom: dom)
		end 'untilNothingIsPending'
	end 'reviveAfterShadowingScopes'

	function reviveSuccessors(local ElementIndex, ownLocal ElementIndex, stamp ElementIndex, regionFirst ElementIndex, regionPast ElementIndex, topo FuncTopology, dom DominatorTree)
		for k in 0 upto topo.succ.degree(local as CsrIndex) 'eachSuccessor'
			let next = topo.succ.neighbour(local as CsrIndex, k: k) as ElementIndex

			if next == ownLocal or not dom.isReached(next) 'notABlockOfTheRegion'
				continue
			end 'notABlockOfTheRegion'

			let at = dom.preorderOf(next)

			if at < regionFirst or at >= regionPast or not self.insideHole(at) or (try self.revived.get(next) otherwise panic("DebugRunRefiner.reviveSuccessors: revived.get OOB at {next}")) == stamp 'alreadyRowed'
				continue
			end 'alreadyRowed'

			try self.revived.set(next, value: stamp) otherwise panic("DebugRunRefiner.reviveSuccessors: revived.set OOB at {next}")
			self.pending.push(next)
		end 'eachSuccessor'
	end 'reviveSuccessors'

	function isReachedInside(local ElementIndex, regionFirst ElementIndex, regionPast ElementIndex, dom DominatorTree) returns bool
		if not dom.isReached(local) 'unreached'
			return false
		end 'unreached'

		let at = dom.preorderOf(local)
		return at > regionFirst and at < regionPast and not self.insideHole(at)
	end 'isReachedInside'

	function findUnreachable(ownLocal ElementIndex, stamp ElementIndex, regionFirst ElementIndex, regionPast ElementIndex, topo FuncTopology, dom DominatorTree)
		self.holeStarts.clear()
		self.holeEnds.clear()
		self.candidates.clear()

		for stop in self.stopLocals 'eachStop'
			if not dom.isReached(stop) or dom.preorderOf(stop) <= regionFirst or dom.preorderOf(stop) >= regionPast 'outsideTheRegion'
				continue
			end 'outsideTheRegion'

			self.candidates.push(stop)

			if dom.dominatedCount(stop) > 1 'dominatesSomethingElse'
				self.holeStarts.push(dom.preorderOf(stop) + 1)
				self.holeEnds.push(dom.preorderOf(stop) + dom.dominatedCount(stop))
			end 'dominatesSomethingElse'

			self.pushFrontierOf(stop)
		end 'eachStop'

		self.normalizeHoles()

		while self.candidates.count() > 0 'untilEveryCandidateIsJudged'
			let block = try self.candidates.pop() otherwise panic("DebugRunRefiner.findUnreachable: candidates.pop on a non-empty list failed")

			if block == ownLocal or not dom.isReached(block) 'notABlockToJudge'
				continue
			end 'notABlockToJudge'

			let first = dom.preorderOf(block)

			if first <= regionFirst or first >= regionPast or self.insideHole(first) or self.hasSupport(block, ownLocal: ownLocal, stamp: stamp, regionFirst: regionFirst, regionPast: regionPast, topo: topo, dom: dom) 'reachedOrOutside'
				continue
			end 'reachedOrOutside'

			self.holeStarts.push(first)
			self.holeEnds.push(first + dom.dominatedCount(block))
			self.normalizeHoles()
			self.pushFrontierOf(block)
		end 'untilEveryCandidateIsJudged'
	end 'findUnreachable'

	function pushFrontierOf(block ElementIndex)
		for k in 0 upto self.frontier.degree(block as CsrIndex) 'eachFrontierBlock'
			self.candidates.push(self.frontier.neighbour(block as CsrIndex, k: k) as ElementIndex)
		end 'eachFrontierBlock'
	end 'pushFrontierOf'

	function hasSupport(block ElementIndex, ownLocal ElementIndex, stamp ElementIndex, regionFirst ElementIndex, regionPast ElementIndex, topo FuncTopology, dom DominatorTree) returns bool
		let first = dom.preorderOf(block)
		let past = first + dom.dominatedCount(block)

		for k in 0 upto topo.pred.degree(block as CsrIndex) 'eachPredecessor'
			let pred = topo.pred.neighbour(block as CsrIndex, k: k) as ElementIndex

			if pred == ownLocal 'theDefinitionItself'
				return true
			end 'theDefinitionItself'

			if not dom.isReached(pred) 'deadCode'
				continue
			end 'deadCode'

			let at = dom.preorderOf(pred)

			if at < regionFirst or at >= regionPast or (at >= first and at < past) or self.insideHole(at) or (try self.stopStamp.get(pred) otherwise panic("DebugRunRefiner.hasSupport: stopStamp.get OOB at {pred}")) == stamp 'givesNothing'
				continue
			end 'givesNothing'

			return true
		end 'eachPredecessor'

		return false
	end 'hasSupport'

	function insideHole(position ElementIndex) returns bool
		var low = 0 as ElementIndex
		var high = self.holeStarts.count() as ElementIndex

		while low < high 'narrow'
			let middle = low + (high - low) / 2

			if (try self.holeStarts.get(middle) otherwise panic("DebugRunRefiner.insideHole: holeStarts.get OOB at {middle}")) <= position 'startsAtOrBefore'
				low = middle + 1
			end 'startsAtOrBefore' else 'startsAfter'
				high = middle
			end 'startsAfter'
		end 'narrow'

		if low == 0 'nothingStartsBefore'
			return false
		end 'nothingStartsBefore'

		return position < (try self.holeEnds.get(low - 1) otherwise panic("DebugRunRefiner.insideHole: holeEnds.get OOB at {low - 1}"))
	end 'insideHole'

	function normalizeHoles()
		if self.holeStarts.count() < 2 'alreadyOrdered'
			return
		end 'alreadyOrdered'

		var keyed = CfgIndexArray.create(self.holeStarts.count(), zeroed: false)

		for at in 0 upto self.holeStarts.count() 'eachHole'
			keyed.push((try self.holeStarts.get(at) otherwise panic("DebugRunRefiner.normalizeHoles: holeStarts.get OOB at {at}")) * DebugOrdinalSpan + at)
		end 'eachHole'

		keyed.sort()
		var starts = CfgIndexArray.create(0)
		var ends = CfgIndexArray.create(0)

		for key in keyed 'eachInOrder'
			let at = key mod DebugOrdinalSpan
			let start = try self.holeStarts.get(at) otherwise panic("DebugRunRefiner.normalizeHoles: holeStarts.get OOB at {at}")
			let stretchEnd = try self.holeEnds.get(at) otherwise panic("DebugRunRefiner.normalizeHoles: holeEnds.get OOB at {at}")

			if ends.count() > 0 and start <= (try ends.get(ends.count() - 1) otherwise panic("DebugRunRefiner.normalizeHoles: ends.get OOB")) 'touchesTheLast'
				if stretchEnd > (try ends.get(ends.count() - 1) otherwise panic("DebugRunRefiner.normalizeHoles: ends.get OOB")) 'reachesFurther'
					try ends.set(ends.count() - 1, value: stretchEnd) otherwise panic("DebugRunRefiner.normalizeHoles: ends.set OOB")
				end 'reachesFurther'

				continue
			end 'touchesTheLast'

			starts.push(start)
			ends.push(stretchEnd)
		end 'eachInOrder'

		self.holeStarts = starts
		self.holeEnds = ends
	end 'normalizeHoles'

	function visitSuccessors(local ElementIndex, ownLocal ElementIndex, stamp ElementIndex, dominatedFirst ElementIndex, dominatedPast ElementIndex, topo FuncTopology, dom DominatorTree)
		for k in 0 upto topo.succ.degree(local as CsrIndex) 'eachSuccessor'
			let next = topo.succ.neighbour(local as CsrIndex, k: k)
			let nextPreorder = dom.preorderOf(next)

			if next == ownLocal or nextPreorder < dominatedFirst or nextPreorder >= dominatedPast or (try self.visited.get(next) otherwise panic("DebugRunRefiner.visitSuccessors: visited.get OOB at {next}")) == stamp 'notToBeVisited'
				continue
			end 'notToBeVisited'

			try self.visited.set(next, value: stamp) otherwise panic("DebugRunRefiner.visitSuccessors: visited.set OOB at {next}")
			self.pending.push(next)
		end 'eachSuccessor'
	end 'visitSuccessors'

	function pushRowOfBlock(ordinal ElementIndex, local ElementIndex, ownLocal ElementIndex, into DebugValueRangeArray, names DebugNameIndex, places DebugBlockPlaces, sites DebugBindingSites)
		let place = try places.placeOfLocal.get(local) otherwise return
		var opening = try places.blockFirst.get(place) otherwise return
		let closing = try places.blockLast.get(place) otherwise return

		if not names.appliesAt(ordinal as DebugNamedSlot, siteKey: debugSiteKeyAt(places.siteKeyOfPlace, at: place)) 'notThisSite'
			return
		end 'notThisSite'

		var fromBlockEntry = true
		var behindAnOp = false

		if local == ownLocal 'theDefinitionBlock'
			if not sites.startAt.holds(ordinal) 'noKnownStart'
				return
			end 'noKnownStart'

			opening = try sites.startAt.get(ordinal) otherwise panic("DebugRunRefiner.pushRowOfBlock: startAt holds {ordinal} and yet does not give it")
			fromBlockEntry = false
			behindAnOp = try sites.startAfterPrevious.get(ordinal) otherwise panic("DebugRunRefiner.pushRowOfBlock: startAfterPrevious.get OOB at {ordinal}")
		end 'theDefinitionBlock'

		let (reaches, last) = self.lastAllowedIn(local, last: closing, stamp: ordinal + 1)

		if not reaches or opening > last 'coversNothing'
			return
		end 'coversNothing'

		into.push(debugRunRange(ordinal, blockId: try places.blockIdOfPlace.get(place) otherwise panic("DebugRunRefiner.pushRowOfBlock: blockIdOfPlace.get OOB at {place}"), first: opening, last: last, fromBlockEntry: fromBlockEntry, behindAnOp: behindAnOp))
	end 'pushRowOfBlock'
end 'DebugRunRefiner'

function debugRunRange(ordinal ElementIndex, blockId BlockId, first DebugOpAnchor, last DebugOpAnchor, fromBlockEntry bool, behindAnOp bool) returns DebugValueRange
	if behindAnOp 'opensWhereAnOpEnds'
		return DebugValueRange.createAfter(ordinal, blockId: blockId, after: first - 1, last: last)
	end 'opensWhereAnOpEnds'

	return DebugValueRange.create(ordinal, blockId: blockId, first: first, last: last, fromBlockEntry: fromBlockEntry)
end 'debugRunRange'

function debugValueAt(roster DebugValueRoster, ordinal ElementIndex) returns ValueId
	return try roster.valueIds.get(ordinal) otherwise panic("debugValueAt: roster.valueIds.get OOB at {ordinal}")
end 'debugValueAt'

function debugGroupAt(roster DebugValueRoster, ordinal ElementIndex) returns CsrIndex
	return (try roster.groups.get(ordinal) otherwise panic("debugGroupAt: roster.groups.get OOB at {ordinal}")) as CsrIndex
end 'debugGroupAt'

function debugLocalAt(sites DebugBindingSites, ordinal ElementIndex) returns ElementIndex
	return try sites.defLocal.get(ordinal) otherwise panic("debugLocalAt: defLocal.get OOB at {ordinal}")
end 'debugLocalAt'

function debugPreorderOf(sites DebugBindingSites, ordinal ElementIndex) returns ElementIndex
	return try sites.preOf.get(ordinal) otherwise panic("debugPreorderOf: preOf.get OOB at {ordinal}")
end 'debugPreorderOf'

function debugSpanEndOf(sites DebugBindingSites, ordinal ElementIndex) returns ElementIndex
	return try sites.spanEnd.get(ordinal) otherwise panic("debugSpanEndOf: spanEnd.get OOB at {ordinal}")
end 'debugSpanEndOf'

function debugHandoverAt(sites DebugBindingSites, ordinal ElementIndex) returns DebugOpAnchor
	return try sites.handoverAt.get(ordinal) otherwise panic("debugHandoverAt: handoverAt holds no anchor for {ordinal}")
end 'debugHandoverAt'

function debugOrderKeyOf(sites DebugBindingSites, ordinal ElementIndex) returns ElementIndex
	return try sites.orderKey.get(ordinal) otherwise panic("debugOrderKeyOf: orderKey.get OOB at {ordinal}")
end 'debugOrderKeyOf'

function debugDominanceFrontiers(topo FuncTopology, dom DominatorTree) returns CsrGraph
	var owners = CsrColumn.create(0)
	var members = CsrColumn.create(0)
	var recorded = IndexColumn.create(topo.numBlocks)

	if not dom.reducible 'noFrontierIsNeeded'
		return buildCsr(owners, to: members, nodeCount: topo.numBlocks as CsrIndex)
	end 'noFrontierIsNeeded'

	for block in 0 upto topo.numBlocks 'eachBlock'
		if not dom.isReached(block) or topo.pred.degree(block as CsrIndex) < 2 'contributesNothing'
			continue
		end 'contributesNothing'

		let stop = try dom.idom.get(block) otherwise panic("debugDominanceFrontiers: idom.get OOB at {block}")

		for k in 0 upto topo.pred.degree(block as CsrIndex) 'eachPredecessor'
			var runner = topo.pred.neighbour(block as CsrIndex, k: k) as ElementIndex

			if not dom.isReached(runner) 'deadCode'
				continue
			end 'deadCode'

			while runner != stop 'climb'
				if (try recorded.get(runner) otherwise panic("debugDominanceFrontiers: recorded.get OOB at {runner}")) == block + 1 'alreadyRecordedFromAnotherPredecessor'
					break
				end 'alreadyRecordedFromAnotherPredecessor'

				try recorded.set(runner, value: block + 1) otherwise panic("debugDominanceFrontiers: recorded.set OOB at {runner}")
				owners.push(runner as CsrIndex)
				members.push(block as CsrIndex)
				let above = try dom.idom.get(runner) otherwise panic("debugDominanceFrontiers: idom.get OOB at {runner}")

				if above == runner 'reachedTheEntry'
					break
				end 'reachedTheEntry'

				runner = above
			end 'climb'
		end 'eachPredecessor'
	end 'eachBlock'

	return buildCsr(owners, to: members, nodeCount: topo.numBlocks as CsrIndex)
end 'debugDominanceFrontiers'

function refineDebugRuns(raw DebugValueRangeArray, into DebugValueRangeArray, spans DebugSpanRows, liveness LivenessResult, roster DebugValueRoster, locations DebugValueLocationArray, names DebugNameIndex, places DebugBlockPlaces, paramCount ParamCount)
	let topo = liveness.cfg.topo
	let dom = DominatorTree.of(topo)
	let sites = DebugBindingSites.over(roster, liveness: liveness, locations: locations, places: places, topo: topo, dom: dom, paramCount: paramCount)
	var runOrdinals = CsrColumn.create(0)
	var runIndices = CsrColumn.create(0)

	for (iter, range) in raw.withIterator() 'eachRawRun'
		if sites.refinementOf(range.valueOrdinal) == DebugRunRefinement.none 'untouched'
			into.push(range)
			continue
		end 'untouched'

		runOrdinals.push(range.valueOrdinal as CsrIndex)
		runIndices.push(iter.index() as CsrIndex)
	end 'eachRawRun'

	let runsOf = buildCsr(runOrdinals, to: runIndices, nodeCount: roster.valueIds.count() as CsrIndex)
	var refiner = DebugRunRefiner.over(topo, dom: dom, places: places, names: names)

	for ordinal in 0 upto roster.valueIds.count() 'eachNamedValue'
		if sites.refinementOf(ordinal) != DebugRunRefinement.none 'refined'
			refiner.refine(ordinal, runsOf: runsOf, raw: raw, into: into, spans: spans, roster: roster, locations: locations, names: names, places: places, sites: sites, topo: topo, dom: dom)
		end 'refined'
	end 'eachNamedValue'
end 'refineDebugRuns'

function collectDebugTouches(touches DebugTouches, liveness LivenessResult, names DebugNameIndex, ordinalOfOp DebugAnchorColumn, placeOfLocal DebugPlaceColumn, blockFirst DebugAnchorColumn, siteKeyOfPlace DebugSiteKeyColumn, scratch DebugNamedSlotColumn)
	let index = liveness.useIndex

	for value in 0 upto liveness.valueCount 'eachValue'
		if not names.isNamed(value) 'unnamed'
			continue
		end 'unnamed'

		match index.defKindOf(value) 'def'
			none then break
			opDef then noteOpTouches(touches, names: names, value: value, placeOfLocal: placeOfLocal, local: index.defBlockOf(value), ordinalOfOp: ordinalOfOp, opIdx: index.requireDefOp(value), siteKeyOfPlace: siteKeyOfPlace, scratch: scratch)
			phiDef then notePhiDefTouches(touches, names: names, value: value, placeOfLocal: placeOfLocal, local: index.defBlockOf(value), blockFirst: blockFirst, siteKeyOfPlace: siteKeyOfPlace, scratch: scratch)
		end 'def'

		let useSites = index.useCount(value)

		if useSites == 0 'neverRead'
			continue
		end 'neverRead'

		var record = index.firstUseOf(value)

		for _ in 0 upto useSites 'eachUse'
			noteOpTouches(touches, names: names, value: value, placeOfLocal: placeOfLocal, local: index.useBlockAt(record), ordinalOfOp: ordinalOfOp, opIdx: index.useOpAt(record), siteKeyOfPlace: siteKeyOfPlace, scratch: scratch)
			record = index.nextUseOf(record)
		end 'eachUse'
	end 'eachValue'
end 'collectDebugTouches'

function noteOpTouches(touches DebugTouches, names DebugNameIndex, value ValueId, placeOfLocal DebugPlaceColumn, local ElementIndex, ordinalOfOp DebugAnchorColumn, opIdx ElementIndex, siteKeyOfPlace DebugSiteKeyColumn, scratch DebugNamedSlotColumn)
	let place = try placeOfLocal.get(local) otherwise return
	let ordinal = try ordinalOfOp.get(opIdx) otherwise return
	noteDebugTouches(touches, names: names, value: value, place: place, ordinal: ordinal, siteKeyOfPlace: siteKeyOfPlace, scratch: scratch)
end 'noteOpTouches'

function notePhiDefTouches(touches DebugTouches, names DebugNameIndex, value ValueId, placeOfLocal DebugPlaceColumn, local ElementIndex, blockFirst DebugAnchorColumn, siteKeyOfPlace DebugSiteKeyColumn, scratch DebugNamedSlotColumn)
	let place = try placeOfLocal.get(local) otherwise return
	let ordinal = try blockFirst.get(place) otherwise return
	noteDebugTouches(touches, names: names, value: value, place: place, ordinal: ordinal, siteKeyOfPlace: siteKeyOfPlace, scratch: scratch)
end 'notePhiDefTouches'

function noteDebugTouches(touches DebugTouches, names DebugNameIndex, value ValueId, place DebugPlace, ordinal DebugOpAnchor, siteKeyOfPlace DebugSiteKeyColumn, scratch DebugNamedSlotColumn)
	names.collectApplicable(value, siteKey: debugSiteKeyAt(siteKeyOfPlace, at: place), into: scratch)

	for slot in scratch 'eachApplicable'
		touches.note(slot, anchor: ordinal)
	end 'eachApplicable'
end 'noteDebugTouches'

// ⭐ **MEMORY BEFORE REGISTERS, AND `nowhere` RATHER THAN A GUESS.** A slot-resident value is one memory
// holds whatever register it was also coloured into, so the slot is the location a reader can act on at
// any PC in the function; a value this colouring never saw — folded away, or minted in a body the lowering
// skipped — has no location at all, and saying so is the whole point of the third answer.
function debugValueLocationOf(alloc Allocation, liveness LivenessResult, value ValueId) returns DebugValueLocation
	if value >= alloc.valueCount 'notInThisFunction'
		return DebugValueLocation.create(DebugValueNowhere, number: 0)
	end 'notInThisFunction'

	match liveness.useIndex.spillSlotOf(value) 'home'
		none then break
		slot(slot) then return DebugValueLocation.create(DebugValueInSpillSlot, number: slot as DebugValueNumber)
	end 'home'

	if not alloc.isColored(value) 'neverPlaced'
		return DebugValueLocation.create(DebugValueNowhere, number: 0)
	end 'neverPlaced'

	return DebugValueLocation.create(DebugValueInRegister, number: alloc.regNumOf(value) as DebugValueNumber)
end 'debugValueLocationOf'

// The values ONE colouring pass could not place — and, for each, the two things its failing POINT knew
// that no later pass can re-derive, because by then the point no longer exists.
//
//  • `free` — `classPool ∖ held`, the registers that were free there. Every one of them is a register
//    `v` is FORBIDDEN (that is what exhaustion means), so it is what the widening cure aims at:
//    `SplitDriver.repairAtExhaustion` cuts `v` across a clobber that covers one.
//  • `occupants` — who held each register `v` IS ALLOWED. That set, `A(v) = classPool ∖ forbidden(v)`,
//    is ENTIRELY HELD for the same reason (`classPool ⊆ held ∪ forbidden(v)`), and it is non-empty on
//    this path (an empty one cannot be matched, so Hall would have answered OVERFLOW). So there is
//    always at least one occupant to evict, which is the SECOND cure — see `repairStuckValues`.
//
// The occupants are a CSR: one contiguous run per stuck value, in ascending register order, so the
// choice among them is reproducible run to run.
type StuckValues
	var values as ValueIdArray
	var freeMasks as RegMaskColumn
	var occupantStart as ColumnLengthColumn
	var occupantCount as ColumnLengthColumn
	var occupants as ValueIdArray

	static function create() returns StuckValues
		return Self{values: ValueIdArray.create(0), freeMasks: RegMaskColumn.create(0), occupantStart: ColumnLengthColumn.create(0), occupantCount: ColumnLengthColumn.create(0), occupants: ValueIdArray.create(0)}
	end 'create'

	function clear()
		self.values.clear()
		self.freeMasks.clear()
		self.occupantStart.clear()
		self.occupantCount.clear()
		self.occupants.clear()
	end 'clear'

	// `allowedHeld` is `A(v)`, and every bit in it names a register some LIVE value is holding right now
	// — which is exactly what makes the eviction cure total. The holders are read here, at the point,
	// because `Allocation` is discarded with the pass.
	function record(v ValueId, free RegMask, allowedHeld RegMask, alloc Allocation)
		self.values.push(v)
		self.freeMasks.push(free)
		self.occupantStart.push(self.occupants.count())

		for regNum in 0 upto RegisterFileSize 'eachAllowedRegister'
			if regMaskContains(allowedHeld, regNum: regNum) 'heldByAnOccupant'
				self.occupants.push(alloc.holderOf(regNum))
			end 'heldByAnOccupant'
		end 'eachAllowedRegister'

		self.occupantCount.push(self.occupants.count() - (try self.occupantStart.get(self.occupantStart.count() - 1) otherwise panic("StuckValues.record: occupantStart.get OOB on the entry just pushed")))
	end 'record'

	function count() returns Count
		return self.values.count()
	end 'count'

	function valueAt(k ElementIndex) returns ValueId
		return try self.values.get(k) otherwise panic("StuckValues.valueAt: no stuck value at {k} of {self.values.count()}")
	end 'valueAt'

	function freeAt(k ElementIndex) returns RegMask
		return try self.freeMasks.get(k) otherwise panic("StuckValues.freeAt: no free mask at {k} of {self.freeMasks.count()}")
	end 'freeAt'

	function occupantCountAt(k ElementIndex) returns ElementIndex
		return try self.occupantCount.get(k) otherwise panic("StuckValues.occupantCountAt: no entry at {k} of {self.occupantCount.count()}")
	end 'occupantCountAt'

	// Occupant `j` of stuck value `k`, in ascending register order.
	function occupantAt(k ElementIndex, j ElementIndex) returns ValueId
		let start = try self.occupantStart.get(k) otherwise panic("StuckValues.occupantAt: no entry at {k} of {self.occupantStart.count()}")
		return try self.occupants.get(start + j) otherwise panic("StuckValues.occupantAt: occupant {j} of stuck value {k} is past the {self.occupantCountAt(k)} recorded for it")
	end 'occupantAt'
end 'StuckValues'

// ⭐⭐ **COLOUR THE FUNCTION, REPAIRING EVERY CONFINEMENT THE GREEDY CANNOT COLOUR AROUND.**
//
// The splitter's post-condition is that no program point exceeds its pool, and that is NOT enough to
// make a GREEDY colouring exist — see `HallCondition.hallVerdictAt`. So a value the colorer cannot place
// is an expected outcome, not a bug: it is relieved by splitting (`SplitDriver.repairAtExhaustion`) and
// the function is coloured again.
//
// ⚠⚠ **IT BATCHES, AND THAT IS THE WHOLE COST ARGUMENT.** One repair per re-colour is O(repairs ×
// function), and repairs are NOT O(1): `Testing/ScaleCorpus`'s `pressuredLoopsSource` and
// `floatSpillSource` emit ONE function with N loops each holding K values live across a call, so a
// single knob gives R = Θ(N) against a function of size Θ(N). That is the exact quadratic
// `SplitLiveRanges`'s header records REMOVING from the splitter (*"K splits × O(function) … a
// genuine QUADRATIC, and pure waste"*), and reintroducing it one pass over would be no better. So
// ONE colouring pass collects EVERY stuck value, the driver applies all their splits, and ONE
// re-colour follows.
//
// ⚠ **THE BATCH BOUNDS THE COMMON CASE, NOT THE WORST ONE, AND THAT IS DELIBERATE.** A pass that gets
// stuck gives the value a PROVISIONAL register so the sweep can carry on (see `reportExhaustion`), which
// can make a later value look stuck when it would not have been, and can equally hide one. Either way a
// round repairs at least one value or panics, Φ = Σ_v (clobbers `v` is live across) strictly falls, and
// the bound below is what makes a non-convergence loud rather than infinite. In practice the corpus
// converges in ONE round.
function colorRepairingConfinements(module TargetModule, driver SplitDriver, func IrFunction, pool RegMask, callerSaved RegMask, counters RegAllocCounters, reuseCopies ReuseCopyPlan, brackets ColdCallBracketPlan, costs PoolPhaseCosts) returns Allocation
	var stuck = StuckValues.create()

	// ⚠ THE COUNTERS ONE COLOURING PASS MOVES, SNAPSHOT BEFORE THE FIRST — because a pass that ends with
	// a stuck value is DISCARDED, and its decisions with it. Left in, the report would claim copies the
	// rewrite never spliced and hints honoured against an allocation nothing emitted. They are plain
	// locals rather than a snapshot object: this runs for EVERY function, and a heap object here would be
	// an allocation per function on the pass the scale ladder watches, to serve the few that repair.
	let colouredAtEntry = counters.valuesColored
	let copiesAtEntry = counters.copiesInserted
	let honouredAtEntry = counters.hintsHonoured
	let missedAtEntry = counters.hintsMissed
	let registersAtEntry = counters.registersUsed

	var alloc = colorOnce(module, driver: driver, pool: pool, callerSaved: callerSaved, counters: counters, reuseCopies: reuseCopies, brackets: brackets, stuck: stuck, costs: costs)

	// Each ROUND makes at least one repair (or panics), so the splitter's own runaway bound over the same
	// potential bounds the rounds too — see `splitRunawayBound`, which both loops now count against.
	let roundBound = splitRunawayBound(driver.liveness)
	var rounds = 0 as EventCount

	while stuck.count() > 0 'repairAndRecolour'
		if rounds >= roundBound 'runaway'
			panic("colorRepairingConfinements: '{String.from(func.name)}' still has {stuck.count()} value(s) the colorer cannot place after {rounds} repair round(s) — the repair potential (see `SplitDriver.repairAtExhaustion`) falls at every repair, so this cannot be reached by correct convergence")
		end 'runaway'

		rounds = rounds + 1

		// Billed to SPLITTING, because that is what it is: the same mutator, the same slots, the same
		// incremental repair. Only the reason for the cut is the colorer's.
		let repairProbe = PhaseProbe.beginCounters()
		repairStuckValues(module, driver: driver, func: func, stuck: stuck, counters: counters)
		costs.record(RegAllocPhase.splitting.ordinal, probe: repairProbe)

		// The pass just discarded is UN-COUNTED, so the counters describe the colouring that SURVIVES.
		counters.valuesColored = colouredAtEntry
		counters.copiesInserted = copiesAtEntry
		counters.hintsHonoured = honouredAtEntry
		counters.hintsMissed = missedAtEntry
		counters.registersUsed = registersAtEntry

		alloc = colorOnce(module, driver: driver, pool: pool, callerSaved: callerSaved, counters: counters, reuseCopies: reuseCopies, brackets: brackets, stuck: stuck, costs: costs)
	end 'repairAndRecolour'

	// The frame covers the save slots of the colouring that SURVIVES; a discarded pass's are re-minted
	// from the floor the next pass starts at.
	driver.extendFrameTo(brackets.frameSlotCount())

	return alloc
end 'colorRepairingConfinements'

// ONE colouring attempt, billed to `RegAllocPhase.coloring`. The plan and the stuck list are the
// caller's and BOTH are emptied here: a pass that ends with stuck values is discarded whole, and both
// were filled against the allocation it produced.
//
// ⚠ `counters` is NOT emptied, and cannot be — it is this FUNCTION's, and this is one of its passes.
// So a function that needed a repair counts its colouring decisions twice in `valuesColored` /
// `copiesInserted` / `hintsHonoured` / `hintsMissed`. That is a debug figure and it is the honest one to
// leave: the decisions really were made. The counter to read when asking how much a program paid for
// this is `repairedByWidening` / `repairedByEviction`, which count the repairs themselves and not the
// passes.
function colorOnce(module TargetModule, driver SplitDriver, pool RegMask, callerSaved RegMask, counters RegAllocCounters, reuseCopies ReuseCopyPlan, brackets ColdCallBracketPlan, stuck StuckValues, costs PoolPhaseCosts) returns Allocation
	driver.requireOpsFlushed()
	reuseCopies.clear()
	brackets.beginPass(driver.frameSlotCount())
	stuck.clear()
	let colorProbe = PhaseProbe.beginCounters()
	let alloc = colorFunction(module, liveness: driver.liveness, pool: pool, callerSaved: callerSaved, counters: counters, reuseCopies: reuseCopies, brackets: brackets, stuck: stuck)
	costs.record(RegAllocPhase.coloring.ordinal, probe: colorProbe)
	return alloc
end 'colorOnce'

// Repair every value one colouring pass got stuck on, trying BOTH cures at each — see
// `SplitDriver.repairAtExhaustion`'s header for why there are exactly two and why they are total:
//
//  (a) WIDEN the value's allowed set, by cutting it across a clobber in its own live range.
//  (b) FREE a register it is already allowed, by cutting the OCCUPANT of one across its def point.
//
// (a) is tried first because it is the cheaper cure in emitted code — it brackets the value that is
// actually confined, at the op that confines it, which is the ABI-forced shape the language already
// documents. (b) evicts a bystander, so it is the fallback.
//
// A value neither cure can relieve does not fail the ROUND on its own: a round that repairs anything
// makes progress, and the re-colour may well place that value once its neighbours have moved.
function repairStuckValues(module TargetModule, driver SplitDriver, func IrFunction, stuck StuckValues, counters RegAllocCounters)
	var repaired = 0 as EventCount

	for k in 0 upto stuck.count() 'eachStuckValue'
		let v = stuck.valueAt(k)

		if driver.repairAtExhaustion(module, v: v, free: stuck.freeAt(k), counters: counters) 'widened'
			repaired = repaired + 1
			continue
		end 'widened'

		// The occupants are offered in ascending REGISTER order, which is the whole of the choice: it
		// makes the pick reproducible run to run and it is deliberately not a cost model (see
		// `repairByEvictingOccupant`). The first one that takes it ends the search.
		var evicted = false

		for j in 0 upto stuck.occupantCountAt(k) 'eachOccupant'
			if evicted 'alreadyFreedOne'
				continue
			end 'alreadyFreedOne'

			if driver.repairByEvictingOccupant(module, v: v, w: stuck.occupantAt(k, j: j), counters: counters) 'freed'
				evicted = true
			end 'freed'
		end 'eachOccupant'

		if evicted 'freedARegister'
			repaired = repaired + 1
		end 'freedARegister'
	end 'eachStuckValue'

	if repaired == 0 'nothingRepairable'
		// ⚠ THIS IS A CONTRADICTION, NOT A SHORTFALL. Cure (b) always HAS a candidate — `A(v)` is
		// non-empty and every register in it is held — so a round can only come away empty if every
		// candidate was refused, and every refusal means the same thing: EVICTING THAT OCCUPANT WOULD
		// FREE NOTHING AT THIS POINT. It has three spellings and one cause, all read off the failing op
		// itself — the op READS `w` (`FailingPoint.readsOccupant`), or the op DEFINES `w` (a co-def of
		// `v`'s own op, whose span opens one slot after it), or `w`'s last use is at or before the point
		// (its span closes before it). Each needs `w` to be named by the failing op, an op names at most
		// two virtual registers, so reaching here needs `A(v)` to consist only of registers held by those
		// two — for EVERY stuck value at once.
		panic("repairStuckValues: '{String.from(func.name)}' — the colorer could not place {stuck.count()} value(s) and BOTH cures were refused for every one of them. Taking the first: {driver.describeUnrepairable(stuck.valueAt(0), free: stuck.freeAt(0), occupants: stuck.occupantCountAt(0))}")
	end 'nothingRepairable'

	driver.flushOps(module)

	// Every block's demand restated, and the function's per-file maximum re-folded from them.
	//
	// ⚠ ONCE PER ROUND, NOT ONCE PER REPAIR. It is a fold over EVERY block, so inside the loop above it
	// would be Θ(repairs × blocks) — the same shape of quadratic the batched repair loop exists to avoid,
	// bought back one line down. Nothing between the repairs reads it: a split can only LOWER a demand,
	// so the figure is a valid upper bound throughout the round.
	driver.refreshDemands()
end 'repairStuckValues'

// ==========================================================================
// Register hints (biased coloring) — a CORRECTNESS obligation, not an optimization
// ==========================================================================

enum RegisterHintLookup implements Error
	noHint
end 'RegisterHintLookup'

// Per-value coloring hints: a FIXED physical register (a value copied to/from a
// pinned register — the R8 return value), and a COPY PARTNER value (a two-address
// seed's source, or the value on the other end of a phi edge). At a def the fixed
// register is tried first, then the partner's register; taking one collapses
// copy-related values into a single register so the copy elides — for a loop back
// edge, that keeps the copy OUT of the loop.
type ColorHints
	export var fixedHint as RegisterColumn
	export var copyHint as CopyPartnerColumn
	export var fixedHintIsHot as BitRow

	// The registers that ops inside the value's live range want, filled by `computeBlockDeaths`. A
	// preference for `pickPreferredRegister` only: `forbidden`, which the splitter and Hall's condition
	// read, never includes it.
	export var contested as RegMaskColumn

	static function create(valueCount ValueId) returns ColorHints
		var fixedHintIsHot = BitRow.create()
		fixedHintIsHot.widen(bitsetWordsFor(valueCount as BitIndex))
		return Self{fixedHint: RegisterColumn.absent(valueCount), copyHint: CopyPartnerColumn.absent(valueCount), fixedHintIsHot: fixedHintIsHot, contested: makeRegMaskColumn(valueCount)}
	end 'create'

	function contestedOf(v ValueId) returns RegMask
		return try self.contested.get(v) otherwise panic("ColorHints.contestedOf: value {v} out of range")
	end 'contestedOf'

	function setFixed(v ValueId, regNum RegNum, sourceHeat BlockHeat)
		let sourceIsHot = sourceHeat != BlockHeat.cold

		if not self.fixedHint.holds(v) 'unset'
			self.fixedHint.set(v, value: regNum)

			if sourceIsHot 'hotSource'
				self.fixedHintIsHot.add(v as BitIndex)
			end 'hotSource'

			return
		end 'unset'

		if sourceIsHot and not self.fixedHintIsHot.test(v as BitIndex) 'hotOverCold'
			self.fixedHint.set(v, value: regNum)
			self.fixedHintIsHot.add(v as BitIndex)
		end 'hotOverCold'
	end 'setFixed'

	// A hint from a cold use costs only a cold-path move when missed, while contesting it would push
	// the values live across a normal def off that register on the hot path. A cold def has no hot
	// path to lose, so its hint always contests.
	function contendingFixedOf(v ValueId, defHeat BlockHeat) returns RegNum throws RegisterHintLookup
		let fr = try self.fixedOf(v)

		if defHeat != BlockHeat.cold and not self.fixedHintIsHot.test(v as BitIndex) 'coldSourceHotDef'
			throw RegisterHintLookup.noHint
		end 'coldSourceHotDef'

		return fr
	end 'contendingFixedOf'

	function setCopyIfUnset(v ValueId, partner ValueId)
		if v == partner 'selfPartner'
			return
		end 'selfPartner'

		if not self.copyHint.holds(v) 'unset'
			self.copyHint.set(v, value: partner)
		end 'unset'
	end 'setCopyIfUnset'

	function fixedOf(v ValueId) returns RegNum throws RegisterHintLookup
		return try self.fixedHint.get(v) otherwise throw RegisterHintLookup.noHint
	end 'fixedOf'

	function copyOf(v ValueId) returns ValueId throws RegisterHintLookup
		return try self.copyHint.get(v) otherwise throw RegisterHintLookup.noHint
	end 'copyOf'

	function hasFixed(v ValueId) returns bool
		return self.fixedHint.holds(v)
	end 'hasFixed'

	function hasCopy(v ValueId) returns bool
		return self.copyHint.holds(v)
	end 'hasCopy'
end 'ColorHints'

// Collect hints by scanning ops (seed copies + the R8 return move) and phi edges.
// Blocks are scanned in layout order so a phi's stored copy partner is its
// FORWARD-edge incoming (defined in a dominator) — the one already colored when the
// phi is reached.
function computeHints(module TargetModule, topo FuncTopology, valueCount ValueId) returns ColorHints
	var hints = ColorHints.create(valueCount)
	var buf = OperandList.create(0)

	for local in 0 upto topo.numBlocks 'eachBlock'
		let block = blockAt(module, topo: topo, local: local)

		var ordered = OpIndexArray.create(0)
		block.collectOpsInRunOrder(ordered)

		for opIdx in ordered 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("computeHints: opIdx not in module.ops")
			collectOpHints(op, heat: block.heat, hints: hints)
			collectReuseHints(op, hints: hints, buf: buf)
		end 'eachOp'

		collectPhiEdgeHints(module, topo: topo, predBlock: block, hints: hints)
	end 'eachBlock'

	return hints
end 'computeHints'

// A copy to a fixed register hints its virtual source to that register, so the R8 return move
// elides. No virtual-to-virtual copy exists at coloring time; the two-address hint comes from
// `collectReuseHints`.
function collectOpHints(op TargetOp, heat BlockHeat, hints ColorHints)
	match op 'hint'
		movRegReg(dst, src) then addCopyHint(dst, src: src, heat: heat, hints: hints)
		movReg32Reg32(dst, src) then addCopyHint(dst, src: src, heat: heat, hints: hints)

		// None of these is a move, so none carries a copy hint. A two-address reuse, `lock xadd`'s
		// included, is a constraint `collectReuseHints` reads off the operand model and the colorer
		// honours through `allocateReuseDef`, and a fixed register such as `divideReg`'s or
		// `mulHighReg`'s RAX/RDX is an implicit mask `forbidOperandsFromImplicit` enforces; a hint here
		// would restate either as a weaker preference. The arm64 moves that want a fixed register — the
		// param capture, the call-arg pre-move, the return move — are the shared `movRegReg` above.
		prologue or
		epilogue or
		ret or
		tailJmp or
		jmp or
		jcc or
		movRegImm or
		movRegImm32 or
		subRegReg or
		imulRegReg or
		negReg or
		cmpRegReg or
		leaRegRegReg or
		leaRegRegImm32 or
		imulRegRegImm32 or
		cmpRegImm32 or
		xchgRegReg or
		callDirect or
		iatCall or
		cqo or
		divideReg or
		pushReg or
		popReg or
		storeSlotReg or
		loadRegSlot or
		andRegReg or
		orRegReg or
		xorRegReg or
		notReg or
		byteSwapReg or
		andRegImm32 or
		orRegImm32 or
		xorRegImm32 or
		shlRegImm8 or
		sarRegImm8 or
		shrRegImm8 or
		shlRegCl or
		sarRegCl or
		shrRegCl or
		rolRegImm8 or
		rorRegImm8 or
		rolRegCl or
		rorRegCl or
		setccReg or
		leaRegGlobal or
		loadRegBaseDisp or
		storeBaseDispReg or
		addsdRegReg or
		subsdRegReg or
		mulsdRegReg or
		divsdRegReg or
		ucomisdRegReg or
		movsdRegRip or
		cvtsi2sdRegReg or
		cvtu64sdRegReg or
		cvttsd2siRegReg or
		sqrtsdRegReg or
		roundsdRegReg or
		movqGprXmm or
		absF64RegReg or
		leaRegRdata or
		minMaxSdRegReg or
		movqXmmGpr or
		negF64RegReg or
		arm64Ret or
		arm64TailBranch or
		arm64Branch or
		arm64CondBranch or
		arm64Cbz or
		arm64Cbnz or
		arm64MovImm or
		arm64Prologue or
		arm64Epilogue or
		arm64Add or
		arm64Sub or
		arm64Mul or
		arm64Sdiv or
		arm64Udiv or
		arm64Msub or
		arm64And or
		arm64Orr or
		arm64Eor or
		arm64Lslv or
		arm64Asrv or
		arm64Lsrv or
		arm64Rorv or
		arm64Neg or
		arm64Mvn or
		arm64Rev or
		arm64AddImm or
		arm64SubImm or
		arm64AndImm or
		arm64OrrImm or
		arm64EorImm or
		arm64LslImm or
		arm64AsrImm or
		arm64LsrImm or
		arm64RorImm or
		arm64Cmp or
		arm64CmpImm or
		arm64Cset or
		arm64LeaFuncAddr or
		arm64LeaRdata or
		arm64LeaGlobal or
		arm64BranchLink or
		arm64BranchLinkReg or
		arm64Fadd or
		arm64Fsub or
		arm64Fmul or
		arm64Fdiv or
		arm64Fcmp or
		arm64Scvtf or
		arm64Ucvtf or
		arm64Fcvtzs or
		arm64Fsqrt or
		arm64Frint or
		arm64Fabs or
		arm64FpLoadRdata or
		arm64ImportCall or
		arm64Syscall or
		arm64Fcsel or
		leaRegFunc or
		callReg or
		x64Syscall or
		x64JumpTable or
		arm64JumpTable or
		callMem or
		arm64StoreOutgoingArg or
		arm64LoadIncomingArg or
		arm64FmovGprFp or
		arm64FmovFpGpr or
		leaRegSlot or
		x64MemFill or
		arm64MemFill or
		x64LockCmpxchg or
		x64LockXadd or
		x64LockAdd or
		x64XchgByte or
		x64GsLoadRegBase or
		arm64AtomicCas or
		arm64AtomicRmw or
		arm64ThreadPointer or
		leaRegBaseIndexScale or
		loadRegBaseIndexScale or
		storeBaseIndexScaleReg or
		arm64AddLsl or
		mulHighReg or
		arm64Fneg or
		arm64LoadAcquire or
		arm64StoreRelease or
		arm64Mulh or
		covInc or
		x64AluBaseDispReg or
		x64AluBaseDispImm32 then break
	end 'hint'
end 'collectOpHints'

// The two-address biased-coloring hint (Phase 5, a CORRECTNESS obligation): for each
// REUSE def, hint the def and its reuse input to each other's register, so the colorer
// coalesces them and NO copy is materialized when the input dies at the op. Read
// straight off the operand model, so it covers every reuse op (`sub`/`imul`/`neg`)
// without a per-op arm.
function collectReuseHints(op TargetOp, hints ColorHints, buf OperandList)
	targetOpOperands(op, buf: buf)

	for o in buf 'eachOperand'
		if operandIsReuseDef(o) and operandIsVirtual(o) 'reuseDef'
			let destId = operandValueId(o)
			let inputId = operandReuseInputValueId(o, buf: buf)
			hints.setCopyIfUnset(destId, partner: inputId)
			hints.setCopyIfUnset(inputId, partner: destId)
		end 'reuseDef'
	end 'eachOperand'
end 'collectReuseHints'

function addCopyHint(dst TargetVReg, src TargetVReg, heat BlockHeat, hints ColorHints)
	match dst 'd'
		physical(dReg) then addFixedFromPhysDst(dReg, src: src, heat: heat, hints: hints)
		virtual(dId) then addCopyFromVirtualDst(dId, src: src, heat: heat, hints: hints)
	end 'd'
end 'addCopyHint'

// `mov <fixed physical>, <virtual src>`: the source wants that fixed register.
function addFixedFromPhysDst(dReg RegNum, src TargetVReg, heat BlockHeat, hints ColorHints)
	match src 's'
		virtual(sId) then hints.setFixed(sId, regNum: dReg, sourceHeat: heat)
		physical then break
	end 's'
end 'addFixedFromPhysDst'

// `mov <virtual dst>, <src>`: dst wants src's register (virtual src) or src's fixed
// register (physical src). No such op survives to coloring today (the two-address seed
// `mov` is retired and edge copies are post-coloring), but the handler stays general so
// a future virtual-to-virtual copy op is hinted correctly.
function addCopyFromVirtualDst(dId ValueId, src TargetVReg, heat BlockHeat, hints ColorHints)
	match src 's'
		virtual(sId) then hints.setCopyIfUnset(dId, partner: sId)
		physical(sReg) then hints.setFixed(dId, regNum: sReg, sourceHeat: heat)
	end 's'
end 'addCopyFromVirtualDst'

// Each phi and the value a predecessor passes it on an edge are copy-related — hint
// them to each other so the parallel edge copy elides (the loop back edge especially,
// where a surviving copy would land inside the loop body).
function collectPhiEdgeHints(module TargetModule, topo FuncTopology, predBlock IrBlock, hints ColorHints)
	for edge in predBlock.branchEdges 'eachEdge'
		let targetBlock = blockAt(module, topo: topo, local: localOfBlockId(topo, blockId: edge.targetBlockId))
		let view = PhiEdgeView.resolve(targetBlock, argIds: edge.argIds, context: PhiEdgeConsumer.coloringHints)

		for k in 0 upto view.count 'eachPhi'
			let phi = view.phiValueIdAt(k)
			let incoming = view.incomingAt(k)
			hints.setCopyIfUnset(phi, partner: incoming)
			hints.setCopyIfUnset(incoming, partner: phi)
		end 'eachPhi'
	end 'eachEdge'
end 'collectPhiEdgeHints'

// ==========================================================================
// The colorer — a forward sweep over a `RegMask` in-use mask, per block
// ==========================================================================

function colorFunction(module TargetModule, liveness LivenessResult, pool RegMask, callerSaved RegMask, counters RegAllocCounters, reuseCopies ReuseCopyPlan, brackets ColdCallBracketPlan, stuck StuckValues) returns Allocation
	view topo = liveness.cfg.topo
	let valueCount = liveness.valueCount
	let wordsPerRow = liveness.wordsPerRow
	var alloc = Allocation.create(valueCount)
	var hints = computeHints(module, topo: topo, valueCount: valueCount)
	var buf = OperandList.create(0)

	// Scratch reused across every block — the live-set walks, the op list, and the death sweep's
	// working row would otherwise each allocate once per block. `seenBelow` is ONE dense row (not a
	// matrix); `computeBlockDeaths` returns it to zero in O(live) before the next block.
	var liveBuf = ValueIdArray.create(0)
	var seedBuf = ValueIdArray.create(0)
	var ordered = OpIndexArray.create(0)
	var seenBelow = BitRow.create()
	seenBelow.widen(wordsPerRow)

	// The death scan's per-class live tally. It is never READ — the scan wants the row alone — but the
	// backward step maintains it as it flips bits and its decrements panic on underflow, so it must be
	// real and truthfully seeded. Allocated HERE and reused across every block, like every other
	// buffer in this sweep.
	var deathsLiveByClass = zeroClassRow()

	var events = ClobberEvents.create()
	events.widen(valueCount)

	var deathsOfBlock = BlockDeathsArray.create(topo.numBlocks, zeroed: false)

	// Every block's deaths come before any block is colored: `hints.contested` gathers wants from LATER
	// blocks, and a value is colored at its def. Run per block inside the sweep below, a value's
	// contested mask would be missing every want after its def's block.
	for local in 0 upto topo.numBlocks 'eachBlockForDeaths'
		let block = blockAt(module, topo: topo, local: local)

		ordered.clear()
		block.collectOpsInRunOrder(ordered)
		deathsOfBlock.push(computeBlockDeaths(module, ordered: ordered, liveness: liveness, local: local, block: block, buf: buf, seenBelow: seenBelow, seedBuf: seedBuf, liveByClass: deathsLiveByClass, hints: hints, events: events))
	end 'eachBlockForDeaths'

	// The op's LAYOUT SEQUENCE across the whole function — the key `reuseCopies` is recorded
	// under, and the same numbering the rewrite re-derives from `IrBlock.collectOpsInRunOrder`.
	var blockBaseSeq = 0 as OpSeq

	for local in 0 upto topo.numBlocks 'eachBlock'
		let block = blockAt(module, topo: topo, local: local)

		// Seed occupancy from the non-phi live-ins (each already colored in a
		// dominator), then allocate the block-arg phis defined at entry.
		var inUse = seedInUse(liveness, local: local, alloc: alloc, liveBuf: liveBuf)

		for arg in block.blockArgs 'eachPhi'
			inUse = allocateDef(arg.valueId, working: inUse, dyingRegs: 0, hints: hints, alloc: alloc, liveness: liveness, pool: pool, callerSaved: callerSaved, counters: counters, stuck: stuck)
		end 'eachPhi'

		ordered.clear()
		block.collectOpsInRunOrder(ordered)
		view deaths = try deathsOfBlock.get(local) otherwise panic("colorFunction: no deaths for block {local}")

		view runs = liveness.coldRuns.of(local)

		for pos in 0 upto ordered.count() 'eachOp'
			let opIdx = try ordered.get(pos) otherwise panic("colorFunction: ordered.get OOB")

			match runs.runAt(pos as ElementIndex) 'run'
				none then break
				run(id) then recordColdRunBracketIfFirst(module, ordered: ordered, runs: runs, id: id, pos: pos as ElementIndex, blockBaseSeq: blockBaseSeq, inUse: inUse, deaths: deaths, alloc: alloc, liveness: liveness, brackets: brackets, buf: buf)
			end 'run'

			inUse = colorOpForward(module, opIdx: opIdx, pos: pos, seq: blockBaseSeq + pos, inUse: inUse, deaths: deaths, hints: hints, alloc: alloc, liveness: liveness, pool: pool, callerSaved: callerSaved, counters: counters, buf: buf, reuseCopies: reuseCopies, stuck: stuck)
		end 'eachOp'

		blockBaseSeq = blockBaseSeq + ordered.count() as OpSeq
	end 'eachBlock'

	return alloc
end 'colorFunction'

// At a run's first op, plan the run's bracket (`ColdCallBracketPlan` states the region rule): every
// register that a value holds at the run's start and that some run op writes while that value is still
// live — `inUse` less the registers of the values dead by that op. A register is bracketed whichever
// value holds it, and `record` reads the holder only to choose a save or a rebuild; a dead phi's
// register, held for the whole block, is bracketed with the rest, which costs a store and a load
// in a block that seldom runs.
function recordColdRunBracketIfFirst(module TargetModule, ordered OpIndexArray, runs ColdBlockRuns, id ElementIndex, pos ElementIndex, blockBaseSeq OpSeq, inUse RegMask, deaths BlockDeaths, alloc Allocation, liveness LivenessResult, brackets ColdCallBracketPlan, buf OperandList)
	if pos != runs.firstOf(id) 'notTheFirstOp'
		return
	end 'notTheFirstOp'

	let last = runs.lastOf(id)
	var held = 0 as RegMask
	var dead = 0 as RegMask

	for k in pos upto last + 1 'eachRunOp'
		let op = try module.ops.get(try ordered.get(k) otherwise panic("recordColdRunBracketIfFirst: ordered.get OOB at {k}")) otherwise panic("recordColdRunBracketIfFirst: op at position {k} not in module.ops")
		targetOpOperands(op, buf: buf)
		dead = dead or deaths.dyingRegsAt(k, alloc: alloc)
		held = held or ((inUse and not dead) and rawClobberMask(op, buf: buf, opFacts: liveness.opFacts))
	end 'eachRunOp'

	if held == 0 'nothingToPreserve'
		return
	end 'nothingToPreserve'

	brackets.record(blockBaseSeq + (pos as OpSeq), reloadSeq: blockBaseSeq + (last as OpSeq), held: held, module: module, alloc: alloc, liveness: liveness)
end 'recordColdRunBracketIfFirst'

// The in-use mask at a block's entry: every non-phi live-in value occupies its
// color. A live-in value must already be colored (its def dominates) — the
// dominance-order assertion.
//
// Walks the SET BITS of the live-in row, not the value space. Testing every value id here would be
// O(blocks × values) — the quadratic that dominated register allocation on a large function — and
// a live set holds a handful of values out of thousands of ids. `liveBuf` is a scratch buffer
// reused across blocks, so this allocates nothing.
function seedInUse(liveness LivenessResult, local ElementIndex, alloc Allocation, liveBuf ValueIdArray) returns RegMask
	liveness.liveInInto(local, out: liveBuf)

	var mask = 0 as RegMask

	for v in liveBuf 'eachLiveIn'
		if not alloc.isColored(v) 'notColored'
			panic("seedInUse: value {v} is live-in to block {local} but was never colored — a use dominates its def (structured-layout invariant broken)")
		end 'notColored'

		// The occupant map is refreshed here, not only at defs: a live-in was coloured in a dominator
		// and a sibling block may have re-used its register since, so the last writer is not the
		// current holder (see `Allocation.holderOfReg`).
		alloc.noteHolder(v, regNum: alloc.regNumOf(v))
		mask = regMaskAdd(mask, regNum: alloc.regNumOf(v))
	end 'eachLiveIn'

	return mask
end 'seedInUse'

// Allocate a register for `v`. Every value has exactly ONE def (RULE 1), so `v` is
// never already colored here — that would be a double-def bug, which asserts. `blocked`
// = the currently-in-use registers (minus those DYING at this op, which a def may
// reuse) ∪ `v`'s forbidden set ∪ the non-pool registers. Returns `working` with the
// assigned register added, so the next def at the same op avoids it.
function allocateDef(v ValueId, working RegMask, dyingRegs RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, callerSaved RegMask, counters RegAllocCounters, stuck StuckValues) returns RegMask
	if alloc.isColored(v) 'doubleDef'
		panic("allocateDef: value {v} is already colored — a value has two defs, violating the single-def SSA invariant (RULE 1)")
	end 'doubleDef'

	// `v`'s POOL IS ITS OWN FILE'S, and blocking everything outside it is the ONE structural guard
	// that keeps an int out of an XMM. Every register `v` could take flows from this mask: the hint
	// paths test it (`hintIsTakeable`), and the fallback picks the lowest bit CLEAR in it
	// (`lowestClearRegister` scans both files and trusts the caller to have excluded the other one).
	// So a class filter here covers every route to a register, and the alternative — filtering at each
	// route — is the same fact written down four times, one of which will be forgotten.
	let class = liveness.classOf(v)
	let classPool = poolOfClass(pool, class: class, file: liveness.registerFile)

	// `held` is `working` minus what dies right here — the registers a def may NOT take. It is named
	// rather than folded into `blocked` because the exhaustion report needs the two apart: `blocked` is
	// their union, and a union cannot tell them apart. A value confined to the 5 callee-saved registers
	// has 9 caller-saved bits set by `forbiddenOf` ALONE, so `blocked` covers the whole pool whenever the
	// held set covers the other 5 — and the panic then blamed plain full-pool pigeonhole for a CONFINED
	// failure, sending its reader to `analyzeBlockPressure` instead of to the coloring order. MEASURED on
	// `while-loops.sequential-loops-across-a-call`'s own shape: 5 values live and 14 registers, reported
	// as a pool overflow.
	let held = working and not dyingRegs
	let blocked = held or liveness.forbiddenOf(v) or (fullRegisterMask() and not classPool)

	// ⭐⭐ **EXHAUSTION IS SCREENED HERE, NOT DISCOVERED INSIDE `chooseRegister`, AND THE TWO ARE THE
	// SAME EVENT.** `chooseRegister` can only fail when `blocked` covers the whole register file: every
	// hint path tests `blocked` FIRST (`hintIsTakeable`), the copy-group fallback measures a mask that is
	// a SUPERSET of `blocked`, and the last fallback is `lowestClearRegister(blocked)`. Screening it here
	// is what lets a value the colorer cannot place be REPORTED instead of panicked on — `chooseRegister`
	// returns a register number and has nowhere to put "there is none" that does not cost a heap object
	// on every colouring decision, which is a per-op allocation in the pass the scale ladder watches. The
	// assertion at the bottom of `chooseRegister` is what holds the two statements together.
	if blocked == fullRegisterMask() 'noRegisterForThisValue'
		return reportExhaustion(v, working: working, classPool: classPool, callerSaved: callerSaved, held: held, alloc: alloc, liveness: liveness, stuck: stuck)
	end 'noRegisterForThisValue'

	let reg = chooseRegister(v, classPool: classPool, callerSaved: callerSaved, blocked: blocked, dyingRegs: dyingRegs, hints: hints, alloc: alloc, liveness: liveness, counters: counters)
	assertColouredInClass(v, reg: reg, class: class, file: liveness.registerFile)
	alloc.assign(v, regNum: reg)
	counters.valuesColored = counters.valuesColored + 1
	counters.noteRegisterUse(reg)
	return regMaskAdd(working, regNum: reg)
end 'allocateDef'

// The colour `v` just took must be a register of `v`'s OWN file. This is the backstop on the class
// filter in `allocateDef`: every route to a register runs through that one `blocked` mask, so this
// can only fire if a route learned to bypass it — which is precisely what `pickPreferredRegister` and
// the hint path did when they each spelled "the whole pool" as `fullRegisterMask()`.
//
// ⚠ IT CANNOT CATCH A MIS-DECLARED CLASS. It compares the colour against the DECLARED class, so a
// float that was never declared `xmm` is coloured into a GPR and agrees with itself here. Declaring
// the class correctly is the op's job and nothing downstream can check it — see
// `TargetLiveness.assertClassColumnCovers`.
function assertColouredInClass(v ValueId, reg RegNum, class RegClass, file RegisterFile)
	if regClassIn(reg, file: file) != class 'wrongFile'
		panic("assertColouredInClass: value {v} is a {class.name} value but was coloured into register {reg}, which is in the {regClassIn(reg, file: file).name} file — a route to a register bypassed the class filter in `allocateDef`'s `blocked` mask. An int in an XMM (or a float in a GPR) encodes to a different instruction, so this is a silent miscompile, not a performance bug.")
	end 'wrongFile'
end 'assertColouredInClass'

// Pick a register for `v`. The hints come first, in this order — each is the register `v` must take
// for SOME copy to elide, most-certain first:
//
//   1. `v`'s OWN fixed hint — a physical operand pins it (the `mov r8, retval` return move).
//   2. its copy partner's REGISTER, when the partner is already colored (the back-edge arg taking
//      over the phi's register: this is what keeps a loop body copy-free).
//   3. its copy partner's PIN, when the partner is NOT yet colored (`pinnedPartnerRegister`).
//
// and the fallback is the lowest free register of `v`'s COPY GROUP's preferred VOLATILITY
// (`copyGroupBlocked`), skipping the registers the group contests (`copyGroupContested`) while the
// volatility has another free. Hints 3 and the group volatility are the BACKWARD half: a forward
// sweep in dominance order colors the def before the phi, so without them a phi's constraints can
// never reach the value that feeds it, and the pair costs two registers.
//
// The three hints ignore `contested`: only the fallback pick weighs it.
//
// **A hint may not ALLOCATE a register outside that class while the class still has one free — but
// it may always TRANSFER one that is being vacated at this very op.** Those are different acts and
// only the first one is harmful:
//
//  • TRANSFER (`hintReg ∈ dyingRegs`) — the partner dies right here, so `v` inherits the register it
//    was already holding. Total registers used: unchanged. This is the whole point of biased
//    coloring: a loop-carried accumulator's update takes over the phi's register, so SSA
//    destruction emits NO back-edge copy and the loop body stays copy-free. Always allow it.
//
//  • ALLOCATION (the register is merely idle) — `v` consumes a register nothing was holding. If
//    that register is CALLEE-SAVED and `v`'s copy group does not need one (nothing in it survives a
//    call), it has taken one of only FIVE registers that are the sole home for values which cross a
//    call. A value that can live NOWHERE else then finds none, and the colorer dies with every
//    register blocked. Gate this by the copy group's preferred volatility.
//
// The failure is not a pressure problem and the splitter cannot see it: at the failing point the
// values FIT (five confined values, five callee-saved registers). It is a COLORING ORDER problem —
// the place the chordal-exactness argument does not reach. χ = ω is a theorem for the UNCONSTRAINED
// problem; forbidden sets make this LIST colouring, and it is NP-hard —
// **`HallCondition.hallVerdictAt`'s header carries that argument and is the one place it is made.**
// Two sequential loops containing calls were enough to hit it
// (`while-loops.sequential-loops-across-a-call`).
//
// ⛔ SO THE VOLATILITY PREFERENCE IS A MITIGATION, NOT AN EXACTNESS RULE. *"Greedy is exact only if
// the scarce callee-saved half is protected"* reads as "protect it and greedy is exact", and that is
// false: MEASURED on four programs where the half IS protected and the greedy still loses. What
// protecting it buys is that the common shape stops reaching `reportExhaustion`; what catches the rest
// is the repair.
function chooseRegister(v ValueId, classPool RegMask, callerSaved RegMask, blocked RegMask, dyingRegs RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, counters RegAllocCounters) returns RegNum
	// The volatility preference is the COPY GROUP's, not `v`'s alone — see `copyGroupBlocked`.
	let groupBlocked = copyGroupBlocked(v, blocked: blocked, hints: hints, alloc: alloc, liveness: liveness)
	let takeable = preferredVolatilityMask(groupBlocked, classPool: classPool, callerSaved: callerSaved) or dyingRegs

	if let fr = try hints.fixedOf(v) 'fixed'
		if hintIsTakeable(fr, blocked: blocked, takeable: takeable) 'fixedFree'
			counters.hintsHonoured = counters.hintsHonoured + 1
			return fr
		end 'fixedFree'
	end 'fixed'

	if let p = try hints.copyOf(v) 'copy'
		if alloc.isColored(p) 'partnerColored'
			let cr = alloc.regNumOf(p)

			if hintIsTakeable(cr, blocked: blocked, takeable: takeable) 'copyFree'
				counters.hintsHonoured = counters.hintsHonoured + 1
				return cr
			end 'copyFree'
		end 'partnerColored'
	end 'copy'

	// The partner is not colored yet, but it is PINNED — take its register now (see
	// `pinnedPartnerRegister`).
	if let pinned = try pinnedPartnerRegister(v, hints: hints, alloc: alloc, liveness: liveness) 'aPinnedPartner'
		if hintIsTakeable(pinned, blocked: blocked, takeable: takeable) 'pinnedFree'
			counters.hintsHonoured = counters.hintsHonoured + 1
			return pinned
		end 'pinnedFree'
	end 'aPinnedPartner'

	if hints.hasFixed(v) or hints.hasCopy(v) 'missed'
		counters.hintsMissed = counters.hintsMissed + 1
	end 'missed'

	// Prefer the copy group's volatility. If nothing in it is free, `v` cannot coalesce with its
	// partner however it is colored, so fall back to `v`'s OWN constraint and let SSA destruction
	// emit the copy — which is strictly what would have happened without the group at all.
	let contested = copyGroupContested(v, hints: hints, alloc: alloc)

	if let grouped = try pickPreferredRegister(groupBlocked, classPool: classPool, callerSaved: callerSaved, contested: contested) 'gotGrouped'
		return grouped
	end 'gotGrouped'

	return try pickPreferredRegister(blocked, classPool: classPool, callerSaved: callerSaved, contested: contested) otherwise panic("chooseRegister: no register for value {v} (class pool {classPool}, blocked {blocked}) — but `allocateDef` screens `blocked == fullRegisterMask()` before it calls this, and that screen and this failure are the SAME event: every hint path tests `blocked` first (`hintIsTakeable`), the copy-group pick measures a superset of `blocked`, and this fallback is `lowestClearRegister(blocked)`. Reaching here means the screen and the pick have come apart.")
end 'chooseRegister'

// ⭐⭐ **THE COLORER RAN OUT OF REGISTERS FOR `v`. Decide WHOSE bug that is** — and, when it is the one
// that is nobody's bug, record `v` so the driver can relieve it and the function be coloured again.
//
// ⚠⚠ WHICH PASS OWNS THIS IS MEASURED HERE, NOT ASSERTED. Stating outright that *"reaching this is a
// SPLITTER BUG, not a colorer limitation"* would be FALSE, and would send every reader to
// `RegPoolCensus`/`HallCondition` on the strength of the two MASKS. The masks
// cannot carry that: a non-empty FORBIDDEN says the exhausted value is confined to a subset, which is
// true of every value live across a call, and says NOTHING about whether the point over-subscribes that
// subset. MEASURED, on the four programs that reach this path, with the exact verdict run at each
// failing point: all four come back FEASIBLE — a distinct allowed register exists for every value
// holding a register there, and the GREEDY has simply not found it.
//
// It runs the same `hallVerdictAt` the splitter runs, over the point's own OCCUPANTS
// (`Allocation.holderOf`) plus the value that could not be coloured — which is exactly the feasibility
// question the splitter is supposed to have already answered "yes" to. One implementation, two callers,
// so this cannot disagree with the pass it names.
//
// ⚠ A MESSAGE MUST NAME A CHECK THAT STILL EXISTS. Blaming `analyzePressure`'s "reduced-pool check,
// `pool ∖ op.implicitDefs`" names a check Hall's condition SUBSUMED and deleted (`HallCondition`'s
// header), and sends every reader to a pass that does not hold the code being blamed.
//
// The confined-pool figure is per CLASS, not the whole callee-saved set: that set spans both files (5 GPRs + 10 XMMs), and quoting 15 at a colorer that ran out of GPRs would name a number no
// value could ever have had.
//
// Returns `working` with a PROVISIONAL register added — see the bottom of the function.
function reportExhaustion(v ValueId, working RegMask, classPool RegMask, callerSaved RegMask, held RegMask, alloc Allocation, liveness LivenessResult, stuck StuckValues) returns RegMask
	// AN EMPTY CLASS POOL IS NOT A SPLITTER BUG, and blaming one would send the reader to the wrong pass
	// entirely. No amount of spilling can free a register from a file the pool does not offer, so this is
	// a MISSING POOL, diagnosed apart from a genuine over-pool point.
	if classPool == 0 'noPoolForThisClass'
		panic("reportExhaustion: value {v} is a {liveness.classOf(v).name} value but the allocatable pool offers NO register of that file (pool mask {classPool}). This is not pressure and no split can relieve it — the {liveness.classOf(v).name} pool is simply not enabled. A file becomes allocatable by having its registers in this TARGET's `allocatablePool` arm (on x64 that pool is `callerSavedMask` u `calleeSavedMask`, which `assertCalleeSavedListsMatchMasks` proves partition the file; arm64 spells its own); the call ops' `implicitDefs` must equal that target's caller-saved half — `callerSavedMaskFor`, held equal by `assertCallClobberConsistent` — or a value would silently survive a call in a register the callee clobbers.")
	end 'noPoolForThisClass'

	var occupants = valuesHoldingRegisters(held and classPool, alloc: alloc)
	let situation = "value {v} ({liveness.classOf(v).name} pool {classPool}, of which HELD {held and classPool} and FORBIDDEN {liveness.forbiddenOf(v) and classPool}; {v} is allowed {allowedRegistersOf(liveness, valueId: v, pool: classPool)}, and a value live across a call is confined to the {regMaskPopcount(classPool and not callerSaved)} callee-saved {liveness.classOf(v).name} register(s) while an idiv reserves RAX/RDX)"
	let occupancy = describeRegisterOccupants(occupants, liveness: liveness, alloc: alloc, classPool: classPool)
	occupants.push(v)

	var hall = HallScratch.create()
	view verdict = hallVerdictAt(liveness, live: occupants, pool: classPool, scratch: hall)

	if not verdict.feasible 'theExactVerdictIsOverflow'
		panic("reportExhaustion: no free register for {situation} — and Hall's EXACT verdict at this point is OVERFLOW: {verdict.tight} of the values here are confined to the witness {verdict.witness}, which offers {regMaskPopcount(verdict.witness)} register(s), so {verdict.tight - regMaskPopcount(verdict.witness)} of them must leave. THE SPLITTER LEFT AN OVER-POOL POINT UNRELIEVED — relieving every one of them before coloring is what `SplitDriver.relievePressure`'s post-condition claims. If the witness IS the whole class pool it is plain per-file pigeonhole and `analyzeBlockPressure`'s `classRowGet(effective, ...) > classPoolSizeOf(...)` owns it; if it is a proper subset, `RegPoolCensus.screenViolates` plus `HallCondition`'s exact confirmation own it. ⚠ AND A REGISTER HELD AT AN OP THAT IS IN NO LIVE SET IS INVISIBLE TO BOTH — a reuse copy and a DEAD DEF are the two, `addOpTransientPressure` and `opConfinedTransient` are the ONE place each is counted, and a demand they miss is one no popcount over a live set can ever see. Occupants:{occupancy}")
	end 'theExactVerdictIsOverflow'

	// ⭐ A REGISTER IS FREE, AND IT IS NECESSARILY ONE `v` IS FORBIDDEN. The greedy exhausted, so
	// `classPool ⊆ held ∪ forbidden(v)`, hence `classPool ∖ held ⊆ forbidden(v)`. And it is non-empty:
	// were every register of the class HELD, the occupants alone would fill the pool and the occupants
	// PLUS `v` would be one value too many for it — plain pigeonhole, which the verdict above would have
	// returned as OVERFLOW rather than FEASIBLE. The same argument in the other direction is why the
	// "unconstrained yet stuck" case cannot arise: `forbidden(v) ∩ classPool == 0` implies `classPool ⊆
	// held`, which is that same full pool.
	let free = classPool and not held

	if free == 0 'everyRegisterHeldYetFeasible'
		panic("reportExhaustion: {situation} — Hall's EXACT verdict is FEASIBLE, yet every register of the class pool is HELD: that is {regMaskPopcount(classPool)} occupants plus {v} on {regMaskPopcount(classPool)} registers, which is pigeonhole and could only have come back OVERFLOW. The two answers contradict each other over the same live set, so the colorer's in-use mask and `Allocation.holderOf` have come apart — a register the mask calls HELD must name a live holder, and the occupant map is refreshed at every block entry (`seedInUse`) and every def for exactly that reason. Occupants:{occupancy}")
	end 'everyRegisterHeldYetFeasible'

	// ⭐⭐ AND THE MIRROR OF IT: EVERY REGISTER `v` IS *ALLOWED* IS HELD, AND THERE IS ALWAYS AT LEAST
	// ONE. Same premise read the other way — `classPool ⊆ held ∪ forbidden(v)` gives
	// `A(v) = classPool ∖ forbidden(v) ⊆ held` — and `A(v)` cannot be empty, because a value allowed no
	// register cannot be matched and `hallVerdictAt` would have answered OVERFLOW. So the point always
	// offers an OCCUPANT to evict, and that is the second cure (`repairStuckValues`): the two together
	// are why a stuck value is never un-relievable.
	let allowedHeld = allowedRegistersOf(liveness, valueId: v, pool: classPool)

	if allowedHeld == 0 'allowedNothingYetFeasible'
		panic("reportExhaustion: {situation} — Hall's EXACT verdict is FEASIBLE, yet {v} is allowed NO register of its own file. A value with an empty allowed set cannot be given one, so the matching could not have saturated and the verdict could only have been OVERFLOW. `allowedRegistersOf` and `hallVerdictAt` read the same mask through the same function, so the two cannot disagree unless `forbiddenOf({v})` changed between them. Occupants:{occupancy}")
	end 'allowedNothingYetFeasible'

	// ⭐⭐ NOT A BUG, AND NOT THE SPLITTER'S: THE COLOURING ORDER. An earlier def took a register out of
	// `v`'s admissible set at a moment when one outside it was free or, more usually, when the
	// caller-saved half was momentarily full because of a value that has since died — and a colour, once
	// given, is held for the value's whole range. `preferredVolatilityMask` is the rule meant to prevent
	// that and it is a LOCAL rule: it cannot see a confined value that is not born yet, and no static
	// order fixes that (`HallCondition.hallVerdictAt`). So `v` is REPORTED, with both of the things its
	// point knows, and the driver relieves it.
	stuck.record(v, free: free, allowedHeld: allowedHeld, alloc: alloc)

	// ⚠⚠ A PROVISIONAL COLOUR — the lowest FREE register of `v`'s own file, which `v` is not allowed and
	// which it will never keep. It exists so that ONE colouring pass can collect EVERY stuck value
	// instead of aborting at the first, which is the difference between one re-colour and R of them (see
	// `colorRepairingConfinements` for why that is the whole cost argument).
	//
	// THREE things make it safe, and only the first is about the pass's OUTPUT:
	//
	//  • The allocation this pass produces is DISCARDED WHOLE. `colorRepairingConfinements` re-colours
	//    from a fresh `Allocation` whenever the stuck list is non-empty, and the list is non-empty
	//    exactly when a provisional colour was handed out — the two happen on this one line pair and
	//    cannot come apart.
	//  • ⭐ **WITHIN the pass, the provisional cannot flip a later value's DIAGNOSIS.** Multiple stuck
	//    values in one pass is the measured common case (the int fragment carries five slots), and `v`
	//    now sits in `held` and in `Allocation.holderOf`, so a LATER `reportExhaustion` will hand `v` to
	//    `hallVerdictAt` as one of its occupants. That is sound only because `hallVerdictAt` takes NO
	//    `Allocation`: it reads each value's ALLOWED SET, which the provisional does not touch. So which
	//    register `v` provisionally holds cannot move the verdict between FEASIBLE (record and carry on)
	//    and OVERFLOW (a hard panic naming the splitter). Were the verdict a function of the assignment,
	//    one provisional colour could turn a repairable point into a false splitter-bug panic.
	//  • ⚠⚠ **IT DOES REACH THE REPAIR'S INPUTS, AND THE ARGUMENT HAS TO COVER THAT RATHER THAN STOP AT
	//    THE VERDICT — this bullet was missing and the list above it said "TWO".** A provisional sits in
	//    `held` for every LATER def of the pass, so it shrinks a later stuck value's `free` and it can be
	//    the `holderOf` a register in a later `A(v)`. Both feed a PERMANENT mutation: `free` is
	//    `findConfiningClobber`'s tier-1 preference, and an occupant is a value cure (b) SPLITS. So a
	//    stuck value can be evicted on behalf of another stuck value, on the strength of a colour neither
	//    will keep. That is imprecision, not unsoundness, and each half is bounded by something that does
	//    not read the provisional: `findConfiningClobber` falls back to tier 2 when `free` misleads it
	//    (its header says `free` is a preference, not a premise), `repairByEvictingOccupant` re-derives
	//    "still live across the point" from the LIVENESS rather than from the allocation, every spill it
	//    then makes is legal in its own right, and Φ falls either way. What the provisional can cost is a
	//    split nothing needed; what it cannot do is make a wrong one.
	//
	// Colouring rather than leaving `v` blank is what keeps every downstream reader of the sweep honest:
	// `seedInUse`'s "a live-in must be coloured" and `colorOpForward`'s "every use is already coloured"
	// are real dominance assertions, and weakening them permanently to accommodate a rare path would
	// blind them on every ordinary function.
	let provisional = regMaskLowest(free)

	// CHECKED, not argued: `free` is a subset of `classPool`, so the pick is in `v`'s own file — and this
	// file's convention is that legality is asserted where it is available, discarded pass or not.
	assertColouredInClass(v, reg: provisional, class: liveness.classOf(v), file: liveness.registerFile)
	alloc.assign(v, regNum: provisional)
	return regMaskAdd(working, regNum: provisional)
end 'reportExhaustion'

// The values occupying the registers of `mask`, in ascending register order — this program point's
// own live set as the colorer sees it, which is the value list the exact Hall verdict must run over.
//
// Only the exhaustion path calls it, so allocating a fresh list is free: the compile is about to
// abort. Ascending register order is what makes the listing and the verdict reproducible run to run.
function valuesHoldingRegisters(mask RegMask, alloc Allocation) returns ValueIdArray
	var out = ValueIdArray.create(0)

	for regNum in 0 upto RegisterFileSize 'eachRegister'
		if regMaskContains(mask, regNum: regNum) 'occupied'
			out.push(alloc.holderOf(regNum))
		end 'occupied'
	end 'eachRegister'

	return out
end 'valuesHoldingRegisters'

// One line per occupied register: which value holds it, and what that value was ALLOWED to hold.
// That second column is the whole content of the FEASIBLE arm — a reader has to see that the
// occupants' admissible sets are WIDER than the exhausted value's to see that the order, and not the
// pressure, is the fault.
function describeRegisterOccupants(occupants ValueIdArray, liveness LivenessResult, alloc Allocation, classPool RegMask) returns String
	var text = ""

	for h in occupants 'eachOccupant'
		text = "{text}\n    register {alloc.regNumOf(h)} <- value {h}, allowed {allowedRegistersOf(liveness, valueId: h, pool: classPool)}"
	end 'eachOccupant'

	return text
end 'describeRegisterOccupants'

function uncoloredPartnerOf(v ValueId, hints ColorHints, alloc Allocation) returns ValueId throws RegisterHintLookup
	let p = try hints.copyOf(v)

	if alloc.isColored(p) 'partnerColored'
		throw RegisterHintLookup.noHint
	end 'partnerColored'

	return p
end 'uncoloredPartnerOf'

// The register `v`'s copy partner is PINNED to and will therefore take if it is free: the partner's
// OWN fixed hint, when the partner is not yet colored and is not forbidden that register.
//
// This is the hint-path half of `copyGroupBlocked` and `copyGroupContested`, and it exists for the
// same reason: the forward sweep colors the DEF before the phi, so a pin on the PHI can only reach
// the value that feeds it by being read AHEAD of time. `return sum` after a loop pins `sum`'s phi to
// R8 (the `mov r8, sum` return move); the initial `sum = 0` in the entry block is colored first,
// cannot see that pin, lands somewhere else, and the loop-entry edge copy survives — one value, two
// registers, for the second time. Predicting the pin removes it.
//
// It is safe even when the prediction is WRONG (the partner's pin turns out to be occupied at its
// own def, so the two do not coalesce after all): `v` still only ever takes a register that
// `hintIsTakeable` has cleared for `v` itself, so the worst case is the copy we already had.
function pinnedPartnerRegister(v ValueId, hints ColorHints, alloc Allocation, liveness LivenessResult) returns RegNum throws RegisterHintLookup
	let p = try uncoloredPartnerOf(v, hints: hints, alloc: alloc)
	let pr = try hints.fixedOf(p)

	if regMaskContains(liveness.forbiddenOf(p), regNum: pr) 'partnerCannotTakeIt'
		throw RegisterHintLookup.noHint
	end 'partnerCannotTakeIt'

	return pr
end 'pinnedPartnerRegister'

// `blocked`, WIDENED by the forbidden set of the copy partner `v` has not been colored with yet —
// so `v` picks a register its partner can also take, and the two coalesce.
//
// **A copy-related pair must be colored out of the registers BOTH ends can hold, or it costs two
// registers instead of one — and a wasted register is a false E5001 waiting to happen.** The hint
// path above can only fire when the partner is ALREADY colored, and a forward sweep in dominance
// order colors the DEFINITION first: a loop-carried accumulator's initial value is defined in the
// entry block, its loop-header phi later. So at the moment that matters there is no register to
// copy, only a constraint — and the constraint is the whole story:
//
//   var sum = 0                 // not live across any call -> prefers CALLER-saved -> rax
//   while i < n 'L'
//       sum = sum + f(i)        // the phi IS live across the call -> forbidden every caller-saved
//   end 'L'                     //   register -> must take a CALLEE-saved one -> r12
//
// The hint then misses (rax is forbidden for the phi), SSA destruction materializes `mov r12, rax`
// on the loop-entry edge, and the ONE value `sum` holds TWO registers. Widening the const's blocked
// mask by the phi's forbidden set makes it pick r12 directly, the edge copy self-elides, and the
// pair costs one register. Nothing else changes: a partner with no forbidden registers (the common
// case) widens nothing, and an ALREADY-colored partner is left to the hint path — which is what keeps
// the scarce-class protection intact.
//
// It cannot over-constrain: the widened mask is only a PREFERENCE (`chooseRegister` falls back to
// `blocked` when the group's preferred volatility is full), never a legality claim.
function copyGroupBlocked(v ValueId, blocked RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult) returns RegMask
	let p = try uncoloredPartnerOf(v, hints: hints, alloc: alloc) otherwise return blocked

	return blocked or liveness.forbiddenOf(p)
end 'copyGroupBlocked'

// The registers a value with this `blocked` mask should take from, BY VOLATILITY: the CALLER-saved
// (volatile) part of its own class pool when any of it is free (nothing in the value's copy group
// survives a call, so none of it needs a callee-saved register), otherwise the whole class pool (the
// group is confined, and the callee-saved half is its only home).
//
// This is `pickPreferredRegister`'s choice, named — so a HINT can be held to the same preference. The
// two must agree, or the hint path quietly bypasses the very protection the fallback path provides.
//
// ⚠ "VOLATILITY", NOT "CLASS", AND THE WORD IS THE POINT. Saying "class" for the caller/callee-saved
// split collides head-on with a register's CLASS — the file it lives in — and the collision is not
// cosmetic: spelling "the whole pool" as `fullRegisterMask()` is harmless while the file is 16 wide and
// the pool is every GPR, and becomes "hand an int an XMM" the moment the file spans two classes.
// `classPool` is the pool argument, and `fullRegisterMask()` appears here only as the complement base — the one honest
// whole-machine use, complementing a mask to block everything outside it.
//
// ⚠⚠ `callerSaved` IS AN ARGUMENT AND MUST STAY ONE. Spelling it `classPool and callerSavedMask()`
// is a call to X64's mask, on every target, from the colorer's per-value path. Both halves of the ISA
// disagreement then show: on arm64 GPRs the numbers land on x16..x21 rather than
// xmm0..xmm5, so x19/x20/x21 read as volatile and x3/x4/x5/x12..x15 did not; on arm64 SIMD the
// intersection is EMPTY, so `anyVolatileFree` is false at every value and this returns the whole
// class pool — a preference that prefers nothing. `chooseRegister` then died on programs that fit
// (`register-volatility-preference`). The mask is per ISA, so it arrives from `lowerAndAllocateOnAWorkerPool`
// with `pool`, and asking for it HERE — by any spelling, dispatched or not — is both the bug and a
// per-value cost.
function preferredVolatilityMask(blocked RegMask, classPool RegMask, callerSaved RegMask) returns RegMask
	let volatilePart = classPool and callerSaved
	let anyVolatileFree = hasAClearRegister(blocked or (fullRegisterMask() and not volatilePart))
	return volatilePart if anyVolatileFree else classPool
end 'preferredVolatilityMask'

// A hinted register is takeable iff it is free AND either inside the value's preferred volatility or
// being VACATED at this op — those are different acts, and only allocating outside the preference is
// harmful (see `chooseRegister`).
//
// It needs no class filter of its own: `blocked` already excludes every register outside the value's
// class pool (`allocateDef`), so a hint naming a foreign-file register is refused as "not free". The
// `takeable` mask may name foreign registers via `dyingRegs` — a value of the other class dying at
// this very op — and `blocked` is what stops one being taken.
function hintIsTakeable(reg RegNum, blocked RegMask, takeable RegMask) returns bool
	if regMaskContains(blocked, regNum: reg) 'notFree'
		return false
	end 'notFree'

	return regMaskContains(takeable, regNum: reg)
end 'hintIsTakeable'

// Pick a free register of the value's OWN class, preferring a CALLER-saved (volatile) one — it needs
// no prologue push/pop, so a value that does NOT outlive a call stays cheap. A value live ACROSS a
// call is forbidden every caller-saved register (it is in `blocked`), so none is free here and the
// pick falls through to the whole class pool — landing it in the callee-saved half, which the
// prologue then preserves. This is the standard "allocate volatiles first" bias; it keeps leaf and
// call-free functions off the callee-saved registers entirely.
//
// `contested` ranks the choices within that preference and removes none: the order is the preferred
// volatility without the contested registers, then the preferred volatility, then `blocked` alone. A
// value whose free registers are all contested still gets one, and contention never moves a value
// into the callee-saved half.
//
// The final fallback scans `blocked` alone and is class-safe BECAUSE of it: `allocateDef` put
// `fullRegisterMask() and not classPool` into that mask, so every foreign-file register is already
// blocked and `lowestClearRegister` — which reads every register of both files — cannot reach one.
//
// It ASKS `preferredVolatilityMask` rather than re-deriving the same preference, so the hint path and
// this one cannot disagree about what a value should take. Spelling the volatile probe twice makes
// "the two must agree" a comment instead of a property — and a second spelling of a pool is exactly
// how `fullRegisterMask()` comes to stand in for "the whole pool" in one of them and not the other.
function pickPreferredRegister(blocked RegMask, classPool RegMask, callerSaved RegMask, contested RegMask) returns RegNum throws RegisterSearch
	let preferred = preferredVolatilityMask(blocked, classPool: classPool, callerSaved: callerSaved)
	let outsidePreferred = fullRegisterMask() and not preferred

	if contested != 0 'anyContested'
		if let pick = try lowestClearRegister(blocked or contested or outsidePreferred) 'gotUncontested'
			return pick
		end 'gotUncontested'
	end 'anyContested'

	if let pick = try lowestClearRegister(blocked or outsidePreferred) 'gotPreferred'
		return pick
	end 'gotPreferred'

	return try lowestClearRegister(blocked)
end 'pickPreferredRegister'

function copyGroupContested(v ValueId, hints ColorHints, alloc Allocation) returns RegMask
	let own = hints.contestedOf(v)
	let p = try uncoloredPartnerOf(v, hints: hints, alloc: alloc) otherwise return own

	return own or hints.contestedOf(p)
end 'copyGroupContested'

// Color one op: assert its uses are already colored (dominance), free the operands
// that die here (so a def may reuse a dying use's register), allocate the def (a reuse
// def goes through `allocateReuseDef`, which may record a copy), then return the
// block's in-use mask for the point AFTER the op.
function colorOpForward(module TargetModule, opIdx ElementIndex, pos ElementIndex, seq OpSeq, inUse RegMask, deaths BlockDeaths, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, callerSaved RegMask, counters RegAllocCounters, buf OperandList, reuseCopies ReuseCopyPlan, stuck StuckValues) returns RegMask
	let op = try module.ops.get(opIdx) otherwise panic("colorOpForward: opIdx not in module.ops")
	targetOpOperands(op, buf: buf)

	for o in buf 'assertUses'
		if (not operandIsDef(o)) and operandIsVirtual(o) 'vu'
			if not alloc.isColored(operandValueId(o)) 'notColored'
				panic("colorOpForward: use of value {operandValueId(o)} before it was colored — dominance-order violation (a future block-reordering pass would need to preserve dominance layout)")
			end 'notColored'
		end 'vu'
	end 'assertUses'

	let dyingRegs = deaths.dyingRegsAt(pos, alloc: alloc)

	var working = inUse

	for o in buf 'allocDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd'
			if operandIsReuseDef(o) 'reuse'
				working = allocateReuseDef(o, seq: seq, pos: pos, deaths: deaths, buf: buf, working: working, hints: hints, alloc: alloc, liveness: liveness, pool: pool, callerSaved: callerSaved, counters: counters, reuseCopies: reuseCopies, stuck: stuck)
			end 'reuse' else 'plain'
				working = allocateDef(operandValueId(o), working: working, dyingRegs: dyingRegs, hints: hints, alloc: alloc, liveness: liveness, pool: pool, callerSaved: callerSaved, counters: counters, stuck: stuck)
			end 'plain'
		end 'vd'
	end 'allocDefs'

	// in-use after the op: drop the dying operands, keep the LIVE defs (a def that
	// is dead the instant it is written frees its register too, via `dyingRegs`).
	var liveDefRegs = 0 as RegMask

	for o in buf 'liveDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd2'
			let v = operandValueId(o)

			if not deaths.dies(pos, v: v) 'stillLive'
				liveDefRegs = regMaskAdd(liveDefRegs, regNum: alloc.regNumOf(v))
			end 'stillLive'
		end 'vd2'
	end 'liveDefs'

	return (inUse and not dyingRegs) or liveDefRegs
end 'colorOpForward'

// Allocate a REUSE def and, when it could not coalesce into its input's register,
// record the `mov dest, input` the encoder needs. The subtlety the whole rework rests
// on: the copy runs BEFORE the op, at a point where nothing has died yet, so `dest`
// must be a register that is free THERE. So the dest may reuse ONLY the input's dying
// register (never another dying operand's — a copy into it would clobber a value the op
// still reads); when the input OUTLIVES, no operand register is free before the op, so
// the dest may reuse none. `defDyingRegs` encodes exactly that.
function allocateReuseDef(o Operand, seq OpSeq, pos ElementIndex, deaths BlockDeaths, buf OperandList, working RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, callerSaved RegMask, counters RegAllocCounters, reuseCopies ReuseCopyPlan, stuck StuckValues) returns RegMask
	let destId = operandValueId(o)
	let inputId = operandReuseInputValueId(o, buf: buf)
	let inputReg = alloc.regNumOf(inputId)
	let inputDies = deaths.dies(pos, v: inputId)

	// ⭐ A REUSE DEF HOLDS ITS INPUT'S VALUE, SO THE TWO SHARE A REGISTER FILE — and this is the ONE
	// place that can say so. `assertColouredInClass` checks each value against its OWN declared class
	// and is therefore blind to a PAIR whose declarations disagree; the copy this function may record
	// is a `movRegReg` of two PHYSICAL registers, so a mismatched pair reaches the encoder as a
	// cross-file `mov xmm, r64` — which `emitRegRegMove` rejects with no way to name the values, the
	// op, or the pass that mis-declared them. Asserting the pair here fails where the fact is known.
	let destClass = liveness.classOf(destId)
	let inputClass = liveness.classOf(inputId)

	if destClass != inputClass 'reuseClassMismatch'
		panic("allocateReuseDef: the two-address op's def v{destId} is {destClass.name}-classed but its REUSE input v{inputId} is {inputClass.name}-classed — a reuse def holds its input's value, so the two must share a register file. The copy this would record is a cross-file `mov`, which the encoder rejects far from the cause. Look at whichever pass declared the two classes (the lowering's value-class column, or `growValueSpace`'s inherited class for a split's fresh ids).")
	end 'reuseClassMismatch'

	// The reuse copy (if the coalescing hint misses) runs BEFORE the op, so the dest
	// must be free at that point: it may reuse ONLY the input's dying register (never
	// another dying operand's, which the op still reads after the copy), and none at all
	// when the input outlives.
	var defDyingRegs = 0 as RegMask

	if inputDies 'inputDiesHere'
		defDyingRegs = regMaskAdd(defDyingRegs, regNum: inputReg)
	end 'inputDiesHere'

	let updated = allocateDef(destId, working: working, dyingRegs: defDyingRegs, hints: hints, alloc: alloc, liveness: liveness, pool: pool, callerSaved: callerSaved, counters: counters, stuck: stuck)

	let destReg = alloc.regNumOf(destId)

	if destReg != inputReg 'needsCopy'
		reuseCopies.record(seq, destReg: destReg, srcReg: inputReg)
		counters.copiesInserted = counters.copiesInserted + 1
	end 'needsCopy'

	return updated
end 'allocateReuseDef'

typealias BlockDeathsArray = Array with BlockDeaths

// Which values DIE at each op of a block — i.e. whose live range ENDS there (its last use, or a
// dead def) — as a CSR list keyed by the op's position: `list[start[pos] .. start[pos+1])`.
//
// **Not a bitset.** The obvious shape is an `ops × ceil(values/64)` matrix, one row of the whole
// value space per op — and that is what this was, allocated fresh for EVERY block, costing
// O(ops × values/64) memory and time per function. It was never needed: a value can only die where
// it APPEARS, so every query is about one of the op's own operands, of which there are at most a
// handful. The list is O(operands) per op and answers the same questions.
type BlockDeaths
	export var byPos as CsrGraph

	static function create(byPos CsrGraph) returns BlockDeaths
		return Self{byPos: byPos}
	end 'create'

	// True iff `v` dies at op position `pos`. A linear scan of the op's dying values — at most the
	// op's operand count, so this is O(1) in practice.
	function dies(pos ElementIndex, v ValueId) returns bool
		for k in 0 upto self.byPos.degree(pos as CsrIndex) 'each'
			if self.byPos.neighbour(pos as CsrIndex, k: k) as ValueId == v 'match'
				return true
			end 'match'
		end 'each'

		return false
	end 'dies'

	// The register mask of every COLORED value dying at op `pos` — the registers a def at this op
	// may reuse. (An uncolored dead def is handled by the caller's live-def computation, not here.)
	function dyingRegsAt(pos ElementIndex, alloc Allocation) returns RegMask
		var mask = 0 as RegMask

		for k in 0 upto self.byPos.degree(pos as CsrIndex) 'each'
			let v = self.byPos.neighbour(pos as CsrIndex, k: k)

			if alloc.isColored(v as ValueId) 'colored'
				mask = regMaskAdd(mask, regNum: alloc.regNumOf(v as ValueId))
			end 'colored'
		end 'each'

		return mask
	end 'dyingRegsAt'
end 'BlockDeaths'

// A backward scan from the block's live-out: a value dies at an op iff it is an operand there and
// is not live below it. `seenBelow` is a single dense row (bits flip at every op, so a bitset is the
// right shape INSIDE a block) — seeded from the SPARSE live-out list and cleared back to zero in
// O(live) by the caller, never copied a full value-space row at a time.
//
// It also closes each value's clobber windows into `hints.contested`; `colorFunction` runs it over
// every block before coloring any.
function computeBlockDeaths(module TargetModule, ordered OpIndexArray, liveness LivenessResult, local ElementIndex, block IrBlock, buf OperandList, seenBelow BitRow, seedBuf ValueIdArray, liveByClass FixedRegCountColumn, hints ColorHints, events ClobberEvents) returns BlockDeaths
	let n = ordered.count()

	liveness.liveOutInto(local, out: seedBuf)
	events.beginBlock()

	for v in seedBuf 'seed'
		seenBelow.add(v as BitIndex)
	end 'seed'

	events.enterLiveOut(seedBuf, pos: n)

	// ⚠ `liveByClass` HERE TALLIES THE ROW, AND THE ROW IS A LIVE SET ONLY BETWEEN OPS. At each op
	// boundary `seenBelow` is the live-after set, but the death scan ADDS to it itself (below) for the
	// values that die at the op — so mid-scan its population is not the live population and its tally
	// is not a pressure. Nothing reads it: the scan wants the row alone.
	//
	// It is maintained anyway, exactly, because `stepRowBackwardOverOperands` maintains a tally OF THE
	// ROW as it flips bits, and that tally's decrements PANIC on underflow. That guard is not
	// negotiable — it is what makes the per-class figures elsewhere trustworthy — so the contract is
	// simply that every mutator of a row keeps its tally in step, including this one. Seeding it
	// truthfully and bumping it on the scan's own adds costs one class read per death and keeps the
	// invariant exact; the alternative is a second step function that skips the tally, which is the
	// forked sweep this design exists to avoid.
	seedClassLive(liveByClass, classes: liveness.valueClass, values: seedBuf)

	// Collected backward as (pos, value) pairs, then bucketed by position — the scan discovers them
	// in reverse, and a counting sort restores order in O(pairs + ops). `posOf` is the CSR KEY column
	// (its entries are `ElementIndex`), `valueOf` the value column.
	var posOf = CsrColumn.create(0)
	var valueOf = CsrColumn.create(0)

	for ri in 0 upto n 'eachOpRev'
		let pos = n - 1 - ri
		let opIdx = try ordered.get(pos) otherwise panic("computeBlockDeaths: ordered.get OOB")
		let op = try module.ops.get(opIdx) otherwise panic("computeBlockDeaths: opIdx not in module.ops")
		targetOpOperands(op, buf: buf)

		// The window order is `stepBackwardOverOp`'s, which owns the reason for it.
		events.closeDefWindows(buf, row: seenBelow, forbidden: hints.contested)
		events.record(pos, mask: wantedByOp(op, heat: block.heat, buf: buf, hints: hints, liveness: liveness))
		events.openUseWindows(buf, row: seenBelow, pos: pos)

		for o in buf 'markDeaths'
			if operandIsVirtual(o) 'virt'
				let v = operandValueId(o)

				if not seenBelow.test(v as BitIndex) 'dies'
					posOf.push(pos as CsrIndex)
					valueOf.push(v as CsrIndex)

					// Mark it seen, so the SAME value appearing twice in this op (`sub x, x`) is
					// recorded as dying ONCE. The row's tally follows the row — see the note above.
					seenBelow.add(v as BitIndex)
					stepClassLive(liveByClass, classes: liveness.valueClass, v: v, entering: true)
				end 'dies'
			end 'virt'
		end 'markDeaths'

		// Transform `seenBelow` from live-below-this-op to live-below-the-op-above it —
		// the same backward SSA transfer the liveness pressure sweep uses.
		stepRowBackwardOverOperands(seenBelow, buf: buf, liveByClass: liveByClass, classes: liveness.valueClass)
	end 'eachOpRev'

	// Return the row to zero for the next block, in O(live + phis): what it holds now is this
	// block's live-in set plus any of its own block-args an op re-added.
	liveness.liveInInto(local, out: seedBuf)

	// The entry windows are read off the row, so they close before the clears below empty it.
	events.closeEntryWindows(seedBuf, block: block, row: seenBelow, forbidden: hints.contested)

	for v in seedBuf 'clearLiveIn'
		seenBelow.remove(v as BitIndex)
	end 'clearLiveIn'

	for arg in block.blockArgs 'clearPhis'
		seenBelow.remove(arg.valueId as BitIndex)
	end 'clearPhis'

	// The scan discovered the deaths in REVERSE op order; the counting sort in `buildCsr`
	// restores forward order in O(pairs + ops), keyed by the op's position in the block.
	return BlockDeaths.create(buildCsr(posOf, to: valueOf, nodeCount: n as CsrIndex))
end 'computeBlockDeaths'

// A bracketed cold-run op confines nothing (`opClobberMask`), so its clobbers reach the colorer only
// here, as a preference.
function wantedByOp(op TargetOp, heat BlockHeat, buf OperandList, hints ColorHints, liveness LivenessResult) returns RegMask
	var wanted = 0 as RegMask

	if opIsBracketed(op, heat: heat, buf: buf, opFacts: liveness.opFacts) 'bracketed'
		wanted = rawClobberMask(op, buf: buf, opFacts: liveness.opFacts)
	end 'bracketed'

	for o in buf 'eachOperand'
		if operandIsDef(o) and operandIsVirtual(o) 'virtualDef'
			let w = operandValueId(o)

			if let fr = try hints.contendingFixedOf(w, defHeat: heat) 'hinted'
				if not regMaskContains(liveness.forbiddenOf(w), regNum: fr) 'honourable'
					wanted = regMaskAdd(wanted, regNum: fr)
				end 'honourable'
			end 'hinted'
		end 'virtualDef'
	end 'eachOperand'

	return wanted
end 'wantedByOp'

// ==========================================================================
// Applying a coloring to an op (used by the rewrite in SsaDestruction.maxon)
// ==========================================================================

// Resolve one operand: a virtual register becomes its assigned physical register; a physical one (the R8
// return target) keeps its number.
//
// ⛔ **A PHYSICAL OPERAND IS RE-MINTED, NOT PASSED THROUGH.** A `TargetVReg` is a box, and the isel binds one
// to a local it names in several ops (`let scratch = x64PhysReg(rax)`), so the box has as many owners as
// ops. The coloured module travels home from a pool worker in a reply, and the transfer walk aborts the
// process on any record with a second owner (exit 96); minting every operand of every coloured op fresh
// is what leaves each box with exactly one.
function colorVRegWith(vreg TargetVReg, alloc Allocation) returns TargetVReg
	return match vreg 'v'
		physical(regNum) gives TargetVReg.physical(regNum)
		virtual(id) gives TargetVReg.physical(alloc.regNumOf(id))
	end 'v'
end 'colorVRegWith'

export function colorTargetOp(op TargetOp, alloc Allocation) returns TargetOp
	match op 'rewrite'
		// Returned verbatim because none carries a virtual register: the OS-call forms and
		// `x64Syscall` take their arguments pre-moved into fixed registers, a fill ladder's operands
		// arrive in fixed registers and its only field is a constant, and `xchgRegReg` is spliced in
		// after this rewrite.
		prologue or
		epilogue or
		ret or
		tailJmp or
		jmp or
		jcc or
		xchgRegReg or
		callDirect or
		iatCall or
		cqo or
		pushReg or
		popReg or
		arm64Ret or
		arm64TailBranch or
		arm64Branch or
		arm64CondBranch or
		arm64Prologue or
		arm64Epilogue or
		arm64BranchLink or
		arm64ImportCall or
		arm64Syscall or
		x64Syscall or
		x64MemFill or
		arm64MemFill then return op
		movRegImm(dest, value) then return TargetOp.movRegImm(colorVRegWith(dest, alloc: alloc), value: value)
		movRegImm32(dest, value) then return TargetOp.movRegImm32(colorVRegWith(dest, alloc: alloc), value: value)
		movRegReg(destReg, srcReg) then return TargetOp.movRegReg(colorVRegWith(destReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		movReg32Reg32(destReg, srcReg) then return TargetOp.movReg32Reg32(colorVRegWith(destReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		subRegReg(dest, lhs, rhs) then return TargetOp.subRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		imulRegReg(dest, lhs, rhs) then return TargetOp.imulRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		negReg(dest, src) then return TargetOp.negReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		cmpRegReg(lhsReg, rhsReg) then return TargetOp.cmpRegReg(colorVRegWith(lhsReg, alloc: alloc), rhsReg: colorVRegWith(rhsReg, alloc: alloc))
		leaRegRegReg(dest, base, index) then return TargetOp.leaRegRegReg(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc))
		leaRegRegImm32(dest, base, disp) then return TargetOp.leaRegRegImm32(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), disp: disp)
		imulRegRegImm32(dest, src, imm) then return TargetOp.imulRegRegImm32(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		cmpRegImm32(reg, imm) then return TargetOp.cmpRegImm32(colorVRegWith(reg, alloc: alloc), imm: imm)
		divideReg(divisor, signedness) then return TargetOp.divideReg(colorVRegWith(divisor, alloc: alloc), signedness: signedness)
		storeSlotReg(slot, srcReg) then return TargetOp.storeSlotReg(slot, srcReg: colorVRegWith(srcReg, alloc: alloc))
		loadRegSlot(destReg, slot) then return TargetOp.loadRegSlot(colorVRegWith(destReg, alloc: alloc), slot: slot)
		andRegReg(dest, lhs, rhs) then return TargetOp.andRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		orRegReg(dest, lhs, rhs) then return TargetOp.orRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		xorRegReg(dest, lhs, rhs) then return TargetOp.xorRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		notReg(dest, src) then return TargetOp.notReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		byteSwapReg(dest, src, width) then return TargetOp.byteSwapReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), width: width)
		andRegImm32(dest, lhs, imm) then return TargetOp.andRegImm32(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		orRegImm32(dest, lhs, imm) then return TargetOp.orRegImm32(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		xorRegImm32(dest, lhs, imm) then return TargetOp.xorRegImm32(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		shlRegImm8(dest, lhs, imm) then return TargetOp.shlRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		sarRegImm8(dest, lhs, imm) then return TargetOp.sarRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		shrRegImm8(dest, lhs, imm) then return TargetOp.shrRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		shlRegCl(dest, lhs) then return TargetOp.shlRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		sarRegCl(dest, lhs) then return TargetOp.sarRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		shrRegCl(dest, lhs) then return TargetOp.shrRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		rolRegImm8(dest, lhs, imm) then return TargetOp.rolRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		rorRegImm8(dest, lhs, imm) then return TargetOp.rorRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		rolRegCl(dest, lhs) then return TargetOp.rolRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		rorRegCl(dest, lhs) then return TargetOp.rorRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		setccReg(dest, cond) then return TargetOp.setccReg(colorVRegWith(dest, alloc: alloc), cond: cond)
		leaRegGlobal(dest, label) then return TargetOp.leaRegGlobal(colorVRegWith(dest, alloc: alloc), label: label)
		loadRegBaseDisp(dest, base, disp, width) then return TargetOp.loadRegBaseDisp(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), disp: disp, width: width)
		storeBaseDispReg(base, disp, src, width) then return TargetOp.storeBaseDispReg(colorVRegWith(base, alloc: alloc), disp: disp, src: colorVRegWith(src, alloc: alloc), width: width)

		// Coloring is class-blind: `colorVRegWith` substitutes whatever register the allocator
		// assigned, and the class column is what guaranteed an XMM operand an XMM register.
		addsdRegReg(dest, lhs, rhs) then return TargetOp.addsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		subsdRegReg(dest, lhs, rhs) then return TargetOp.subsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		mulsdRegReg(dest, lhs, rhs) then return TargetOp.mulsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		divsdRegReg(dest, lhs, rhs) then return TargetOp.divsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		ucomisdRegReg(lhs, rhs) then return TargetOp.ucomisdRegReg(colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		movsdRegRip(dest, label) then return TargetOp.movsdRegRip(colorVRegWith(dest, alloc: alloc), label: label)
		cvtsi2sdRegReg(dest, src) then return TargetOp.cvtsi2sdRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		cvtu64sdRegReg(dest, src) then return TargetOp.cvtu64sdRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		cvttsd2siRegReg(dest, src) then return TargetOp.cvttsd2siRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		sqrtsdRegReg(dest, src) then return TargetOp.sqrtsdRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		roundsdRegReg(dest, src, mode) then return TargetOp.roundsdRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), mode: mode)
		movqGprXmm(dest, src) then return TargetOp.movqGprXmm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		movqXmmGpr(dest, src) then return TargetOp.movqXmmGpr(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		negF64RegReg(dest, src) then return TargetOp.negF64RegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		absF64RegReg(dest, src) then return TargetOp.absF64RegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		leaRegRdata(dest, label) then return TargetOp.leaRegRdata(colorVRegWith(dest, alloc: alloc), label: label)

		// ⚠ Operand order is preserved verbatim: swapping `lhs` and `rhs` changes the answer on a NaN.
		minMaxSdRegReg(dest, lhs, rhs, kind) then return TargetOp.minMaxSdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc), kind: kind)

		// The rewrite substitutes `RegNum`s and never names an ISA register, so an arm64 op is rebuilt
		// exactly like its x64 twin.
		arm64Cbz(reg, targetBlockId) then return TargetOp.arm64Cbz(colorVRegWith(reg, alloc: alloc), targetBlockId: targetBlockId)
		arm64Cbnz(reg, targetBlockId) then return TargetOp.arm64Cbnz(colorVRegWith(reg, alloc: alloc), targetBlockId: targetBlockId)
		arm64MovImm(dest, value) then return TargetOp.arm64MovImm(colorVRegWith(dest, alloc: alloc), value: value)
		arm64Add(dest, lhs, rhs) then return TargetOp.arm64Add(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Sub(dest, lhs, rhs) then return TargetOp.arm64Sub(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Mul(dest, lhs, rhs) then return TargetOp.arm64Mul(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Sdiv(dest, lhs, rhs) then return TargetOp.arm64Sdiv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Udiv(dest, lhs, rhs) then return TargetOp.arm64Udiv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Msub(dest, mulLhs, mulRhs, minuend) then return TargetOp.arm64Msub(colorVRegWith(dest, alloc: alloc), mulLhs: colorVRegWith(mulLhs, alloc: alloc), mulRhs: colorVRegWith(mulRhs, alloc: alloc), minuend: colorVRegWith(minuend, alloc: alloc))
		arm64And(dest, lhs, rhs) then return TargetOp.arm64And(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Orr(dest, lhs, rhs) then return TargetOp.arm64Orr(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Eor(dest, lhs, rhs) then return TargetOp.arm64Eor(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Lslv(dest, lhs, rhs) then return TargetOp.arm64Lslv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Asrv(dest, lhs, rhs) then return TargetOp.arm64Asrv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Lsrv(dest, lhs, rhs) then return TargetOp.arm64Lsrv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Rorv(dest, lhs, rhs) then return TargetOp.arm64Rorv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Neg(dest, src) then return TargetOp.arm64Neg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Mvn(dest, src) then return TargetOp.arm64Mvn(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Rev(dest, src, width) then return TargetOp.arm64Rev(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), width: width)
		arm64AddImm(dest, src, imm) then return TargetOp.arm64AddImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64SubImm(dest, src, imm) then return TargetOp.arm64SubImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64AndImm(dest, src, imm) then return TargetOp.arm64AndImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64OrrImm(dest, src, imm) then return TargetOp.arm64OrrImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64EorImm(dest, src, imm) then return TargetOp.arm64EorImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64LslImm(dest, src, imm) then return TargetOp.arm64LslImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64AsrImm(dest, src, imm) then return TargetOp.arm64AsrImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64LsrImm(dest, src, imm) then return TargetOp.arm64LsrImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64RorImm(dest, src, imm) then return TargetOp.arm64RorImm(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		arm64Cmp(lhs, rhs) then return TargetOp.arm64Cmp(colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64CmpImm(reg, imm) then return TargetOp.arm64CmpImm(colorVRegWith(reg, alloc: alloc), imm: imm)
		arm64Cset(dest, cond) then return TargetOp.arm64Cset(colorVRegWith(dest, alloc: alloc), cond: cond)
		arm64LeaFuncAddr(dest, funcName) then return TargetOp.arm64LeaFuncAddr(colorVRegWith(dest, alloc: alloc), funcName: funcName)
		arm64LeaRdata(dest, label) then return TargetOp.arm64LeaRdata(colorVRegWith(dest, alloc: alloc), label: label)
		arm64LeaGlobal(dest, label) then return TargetOp.arm64LeaGlobal(colorVRegWith(dest, alloc: alloc), label: label)
		arm64BranchLinkReg(reg) then return TargetOp.arm64BranchLinkReg(colorVRegWith(reg, alloc: alloc))
		arm64Fadd(dest, lhs, rhs) then return TargetOp.arm64Fadd(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Fsub(dest, lhs, rhs) then return TargetOp.arm64Fsub(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Fmul(dest, lhs, rhs) then return TargetOp.arm64Fmul(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Fdiv(dest, lhs, rhs) then return TargetOp.arm64Fdiv(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Fcmp(lhs, rhs) then return TargetOp.arm64Fcmp(colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		arm64Scvtf(dest, src) then return TargetOp.arm64Scvtf(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Ucvtf(dest, src) then return TargetOp.arm64Ucvtf(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Fcvtzs(dest, src) then return TargetOp.arm64Fcvtzs(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Fsqrt(dest, src) then return TargetOp.arm64Fsqrt(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Fabs(dest, src) then return TargetOp.arm64Fabs(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64Frint(dest, src, mode) then return TargetOp.arm64Frint(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), mode: mode)
		arm64FpLoadRdata(dest, label) then return TargetOp.arm64FpLoadRdata(colorVRegWith(dest, alloc: alloc), label: label)

		// ⚠ `ifTrue`/`ifFalse` are ordered — swapping them turns `min` into `max`.
		arm64Fcsel(dest, ifTrue, ifFalse, cond) then return TargetOp.arm64Fcsel(colorVRegWith(dest, alloc: alloc), ifTrue: colorVRegWith(ifTrue, alloc: alloc), ifFalse: colorVRegWith(ifFalse, alloc: alloc), cond: cond)
		leaRegFunc(dest, funcName) then return TargetOp.leaRegFunc(colorVRegWith(dest, alloc: alloc), funcName: funcName)
		callReg(reg) then return TargetOp.callReg(colorVRegWith(reg, alloc: alloc))

		// Only the biased index is coloured; the jump sequence's scratch registers are fixed in the
		// encoder.
		x64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) then return TargetOp.x64JumpTable(colorVRegWith(indexReg, alloc: alloc), defaultTarget: defaultTarget, caseTargets: caseTargets, tableLabel: tableLabel)
		arm64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) then return TargetOp.arm64JumpTable(colorVRegWith(indexReg, alloc: alloc), defaultTarget: defaultTarget, caseTargets: caseTargets, tableLabel: tableLabel)
		callMem(baseReg, disp) then return TargetOp.callMem(colorVRegWith(baseReg, alloc: alloc), disp: disp)
		arm64StoreOutgoingArg(slot, srcReg) then return TargetOp.arm64StoreOutgoingArg(slot, srcReg: colorVRegWith(srcReg, alloc: alloc))
		arm64LoadIncomingArg(dest, slot) then return TargetOp.arm64LoadIncomingArg(colorVRegWith(dest, alloc: alloc), slot: slot)
		arm64FmovGprFp(dest, src) then return TargetOp.arm64FmovGprFp(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64FmovFpGpr(dest, src) then return TargetOp.arm64FmovFpGpr(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		leaRegSlot(destReg, slot) then return TargetOp.leaRegSlot(colorVRegWith(destReg, alloc: alloc), slot: slot)

		// The CAS's comparand is not an operand: x86 pins it to RAX, so it arrives in a `movRegReg` and
		// rides `implicitUses`.
		x64LockCmpxchg(addrReg, srcReg) then return TargetOp.x64LockCmpxchg(colorVRegWith(addrReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		x64LockXadd(dest, src, addrReg) then return TargetOp.x64LockXadd(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), addrReg: colorVRegWith(addrReg, alloc: alloc))
		x64LockAdd(addrReg, srcReg) then return TargetOp.x64LockAdd(colorVRegWith(addrReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		x64XchgByte(dest, src, addrReg) then return TargetOp.x64XchgByte(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), addrReg: colorVRegWith(addrReg, alloc: alloc))
		x64GsLoadRegBase(dest, base) then return TargetOp.x64GsLoadRegBase(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc))
		arm64AtomicCas(dest, addrReg, expectedReg, replacementReg) then return TargetOp.arm64AtomicCas(colorVRegWith(dest, alloc: alloc), addrReg: colorVRegWith(addrReg, alloc: alloc), expectedReg: colorVRegWith(expectedReg, alloc: alloc), replacementReg: colorVRegWith(replacementReg, alloc: alloc))
		arm64AtomicRmw(dest, addrReg, operandReg, opcode) then return TargetOp.arm64AtomicRmw(colorVRegWith(dest, alloc: alloc), addrReg: colorVRegWith(addrReg, alloc: alloc), operandReg: colorVRegWith(operandReg, alloc: alloc), opcode: opcode)
		arm64ThreadPointer(dest, source) then return TargetOp.arm64ThreadPointer(colorVRegWith(dest, alloc: alloc), source: source)
		leaRegBaseIndexScale(dest, base, index, scale) then return TargetOp.leaRegBaseIndexScale(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc), scale: scale)
		loadRegBaseIndexScale(dest, base, index, scale, disp, width) then return TargetOp.loadRegBaseIndexScale(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc), scale: scale, disp: disp, width: width)
		storeBaseIndexScaleReg(base, index, scale, disp, src, width) then return TargetOp.storeBaseIndexScaleReg(colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc), scale: scale, disp: disp, src: colorVRegWith(src, alloc: alloc), width: width)
		arm64AddLsl(dest, base, index, scale) then return TargetOp.arm64AddLsl(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc), scale: scale)
		mulHighReg(src, signedness) then return TargetOp.mulHighReg(colorVRegWith(src, alloc: alloc), signedness: signedness)
		arm64Fneg(dest, src) then return TargetOp.arm64Fneg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		arm64LoadAcquire(dest, base, width) then return TargetOp.arm64LoadAcquire(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), width: width)
		arm64StoreRelease(base, src, width) then return TargetOp.arm64StoreRelease(colorVRegWith(base, alloc: alloc), src: colorVRegWith(src, alloc: alloc), width: width)
		arm64Mulh(dest, lhs, rhs, signedness) then return TargetOp.arm64Mulh(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc), signedness: signedness)
		covInc(pointId) then return TargetOp.covInc(pointId)
		x64AluBaseDispReg(base, disp, src, alu) then return TargetOp.x64AluBaseDispReg(colorVRegWith(base, alloc: alloc), disp: disp, src: colorVRegWith(src, alloc: alloc), alu: alu)
		x64AluBaseDispImm32(base, disp, imm, alu) then return TargetOp.x64AluBaseDispImm32(colorVRegWith(base, alloc: alloc), disp: disp, imm: imm, alu: alu)
	end 'rewrite'
end 'colorTargetOp'

// ==========================================================================
// Stats logging
// ==========================================================================

module function regAllocStatsMessage(stats RegAllocStats) returns String
	var msg = StringBuilder.create()
	msg.append("regalloc stats: {stats.functionsAllocated} func(s), {stats.valuesColored} values colored, {regMaskPopcount(stats.registersUsed)} distinct regs used\n")

	// Iterated per class, not hand-listed: a hand-written pair of lines silently omits any register
	// file added later, which is the same way an unmeasured cost hides in the phase table below.
	msg.append("  pressure:")

	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		msg.append(" max {class.name}={classRowGet(stats.maxPressure, class: class)} (in '{try stats.maxPressureFunc.get(class.ordinal) otherwise panic("regAllocStatsMessage: no maxPressureFunc entry for the {class.name} file")}');")
	end 'eachClass'

	msg.append(" maxLoopDepth={stats.maxLoopDepth}; liveness mark-steps total={stats.livenessMarkStepsTotal} max={stats.livenessMarkStepsMax}; row-words visited total={stats.rowWordsVisitedTotal} max={stats.rowWordsVisitedMax}\n")
	msg.append("  splitter: valuesSplit={stats.valuesSplit} (forced at fixed-reg points={stats.forcedSpills}, of which colorer repairs by widening={stats.repairedByWidening} and by eviction={stats.repairedByEviction}, and full-pool peaks across a cold run={stats.forcedInsteadOfRefused}); reloadsInserted={stats.reloadsInserted}; rematerialized={stats.rematerialized}\n")
	msg.append("  copies inserted={stats.copiesInserted}; hints honoured={stats.hintsHonoured} missed={stats.hintsMissed}\n")

	// Iterated, not hand-listed: a hand-written line silently omits any phase added
	// later, which is how an unmeasured cost hides in the first place.
	msg.append("  phase ms:")

	for phase in RegAllocPhase.allCases 'eachPhase'
		msg.append(" {phase.name}={stats.costOf(phase).nanos}")
	end 'eachPhase'

	return msg.build()
end 'regAllocStatsMessage'
