// The disjoint segment-tree nodes whose leaves are exactly `[lo, hi]`. The path from any leaf in
// the range to the root meets exactly one of them, which is what lets a range add be read back as a
// sum along one leaf's path, counting each covering run once.
export function collectCoveringNodes(leafBase ElementIndex, lo ElementIndex, hi ElementIndex, out CfgIndexArray)
	out.clear()
	var left = leafBase + lo
	var right = leafBase + hi + 1

	while left < right 'decompose'
		if left mod 2 == 1 'leftIsARightChild'
			out.push(left)
			left = left + 1
		end 'leftIsARightChild'

		if right mod 2 == 1 'rightIsARightChild'
			right = right - 1
			out.push(right)
		end 'rightIsARightChild'

		left = left / 2
		right = right / 2
	end 'decompose'
end 'collectCoveringNodes'
