// BackendPool — INSTRUCTION SELECTION, CRITICAL-EDGE SPLITTING, REGISTER ALLOCATION, BRANCH
// CLEANUP, THE FRAME AND ENCODING ON A POOL OF WORKER SERVICES, one per processor: every function
// goes through all six on one worker, as ONE backend unit.
//
// ⚠ A run under `MAXON_MAX_PROCS=1` is THIS pool with one processor in it, not a serial fallback —
// which is what makes the pinned and the default lane the same code path and their outputs comparable
// at all.
//
// ⭐⭐ **WHY THESE SIX, TOGETHER.** The allocator is the largest pass in the compiler and it is PER
// FUNCTION; every step around it is per function too. Fusing them means a function crosses to a
// worker ONCE — as a Std unit — and comes home ONCE — as a finished Target function and its chunk.
//
// ⭐⭐ **WHAT MAKES IT SAFE IS THE UNIT, NOT LOCKING — there is none.** A message MOVES, so a worker
// is handed a `BackendUnit` nobody else can reach and hands back the same unit with its
// `FinishedUnit` filed in it. `BackendUnit`'s header owns that argument.
//
// ⭐⭐ **AND THE OUTPUT DOES NOT DEPEND ON THE POOL.** Splicing is order-independent — a reply appends its
// ops and blocks to the module's two arrays, and an index into either reaches no emitted byte
// (`BackendUnit`'s header) — and everything that is NOT order-independent is done in FUNCTION-INDEX ORDER
// on this thread after the drain: the `.rdata` registrations every isel made (`RdataRequests` — a jump
// table's label and every island's offset are minted off ONE counter, in registration order),
// `foldFunctionAllocation` (the per-function trace event carries a CUMULATIVE counter, and
// `RegAllocStats.recordPressure` keeps the FIRST function to reach a maximum), and the encoded
// chunks, whose order is `.text`'s. The two byte-identity gates pass on a pool of one
// (`tests/parallelCompile/byte-identical`, `rdata-order`).
//
// ⚠ **THE THREE THINGS A WORKER STRUCTURALLY CANNOT DO** are what shaped the split, and each is a
// rule with teeth rather than a preference. It holds no `Project`, and a green thread runs on
// whichever OS thread the scheduler gives it, which rules out the trace-span stack, the `.rdata`
// table and every `Project` table. It may not wait — E3221 refuses a service that waits on another
// party, and this one only sends its answer to the receiver. And it may not be handed anything a second frame still owns —
// refused at the send, exit 96 at run time in a seed-built binary — which is why a unit is an `isolated` value and each
// worker is handed its own clone of the callee ABI table.

// How many jobs are kept in flight PER WORKER.
//
// ⚠ **ONE IS TOO FEW, AND NOT AS A TUNING GUESS: with one, a worker is idle from the instant it posts a
// reply until the driver has landed it, SPLICED it — which walks the function's blocks —
// and extracted the next unit, which walks the next function's ops.** That is main-thread work proportional
// to the very function the worker just finished, so at one job in flight the pool's throughput is bounded
// by the main thread's serial half. Two means the next job is already in the worker's mailbox when it
// finishes one.
//
// More than two buys nothing and costs memory: a unit in flight is a full copy of one function's ops, so
// the queue depth IS the pool's peak memory over the module.
//
// `PoolDispatch` applies it to every pool.
let JobsInFlightPerWorker = 2

typealias BackendArrivedUnits = ArrivedUnits with TargetModule
typealias BackendWorkerHandleArray = Array with BackendWorker.handle

export typealias BackendRetirees = WorkerRetirees with BackendWorker.handle

export typealias InFlightCount = int(0 to u64.max)
typealias InFlightCountArray = FixedArray with InFlightCount

// How many workers a pool holds, or how many jobs it has to run. NARROWED to exclude zero, which is what
// lets the round-robin and the key unpacking DIVIDE by one: both are reached only past a guard that has
// already answered for an empty pool, and a range is how that guard is carried to the arithmetic instead
// of being remembered at it.
export typealias PoolSize = int(1 to u32.max)

typealias FixedPoolSlotArray = FixedArray with ElementIndex
export typealias PoolSlotArray = Array with ElementIndex

export typealias PoolJobArray = Array with ElementIndex

// How much work one job is — what the dispatch orders by: a function's live ops, a file's bytes or tokens.
export typealias PoolJobSize = int(0 to u64.max)
export typealias PoolJobSizeArray = Array with PoolJobSize

export typealias LandingSlotArray = FixedArray with ElementIndex

// ⭐ **WHERE EACH JOB'S ANSWER LANDED — the column that turns arrival order back into job order.** A drain
// pushes answers as they arrive and records the slot here; the fold after the drain walks the jobs in
// order and reads each one's answer through `slotOf`. One record for every pool.
export type LandingSlots
	var slotOfJob as LandingSlotArray
	let jobCount as ElementIndex

	// Filled with the one value no landing slot has — the job count — so a job that never landed is a panic
	// at the fold rather than job 0's answer folded twice.
	export static function create(jobCount ElementIndex) returns LandingSlots
		let slotOfJob = LandingSlotArray.create(jobCount)
		slotOfJob.refill(jobCount)
		return Self{slotOfJob: slotOfJob, jobCount: jobCount}
	end 'create'

	export function record(job ElementIndex, slot ElementIndex)
		try self.slotOfJob.set(job, value: slot) otherwise panic("LandingSlots.record: slotOfJob.set OOB at {job} below {self.jobCount}")
	end 'record'

	export function hasLanded(job ElementIndex) returns bool
		return self.rawSlotOf(job) != self.jobCount
	end 'hasLanded'

	function rawSlotOf(job ElementIndex) returns ElementIndex
		return try self.slotOfJob.get(job) otherwise panic("LandingSlots.rawSlotOf: slotOfJob.get OOB at {job} below {self.jobCount}")
	end 'rawSlotOf'

	export function slotOf(job ElementIndex) returns ElementIndex
		let slot = self.rawSlotOf(job)

		if slot == self.jobCount 'neverLanded'
			panic("LandingSlots.slotOf: job {job} never came home from the pool — the drain awaits every reply, so a job with no landing slot is a dispatch that never happened")
		end 'neverLanded'

		return slot
	end 'slotOf'
end 'LandingSlots'

union InFlightSizeBound
	unbounded
	upTo(size PoolJobSize)
end 'InFlightSizeBound'

// ⭐⭐ **THE HALF OF A POOL DRAIN THAT NAMES NO MESSAGE — one record for every drain: this pool's,
// `StdPassPool`'s and `FrontEndPool`'s.** A drain fills a pipeline of `JobsInFlightPerWorker` jobs
// per worker longest-first, then, as each answer arrives, hands its worker the next job its
// `PoolAssignment` gives it. Everything in that protocol that is not the answer itself lives here:
// the dispatch order and how far it has been consumed, and for each outstanding job which worker
// holds it.
//
// ⚠ **AN ANSWER NAMES ITS JOB, AND `landJob` LANDS THAT JOB.** The receiver is told once per answer, and
// the job index finds the outstanding entry here; `landJob` refuses a job that was never dispatched
// or has already landed.
export type PoolDispatch
	var order as PoolJobArray
	var sizeInDispatchOrder as PoolJobSizeArray
	let jobCount as PoolSize
	let workerCount as PoolSize
	let assignment as PoolAssignment
	var dispatched as ElementIndex
	var handedToWorker as FixedPoolSlotArray
	var positionOfJob as FixedPoolSlotArray
	var arrivedAtPosition as FixedBoolArray
	var settled as ElementIndex
	var replyJob as PoolJobArray
	var replyWorker as PoolSlotArray
	var replySize as PoolJobSizeArray
	var outstandingPerWorker as InFlightCountArray
	var inFlightSize as PoolJobSize
	var sizeBound as InFlightSizeBound

	// One size per job, in job order; the caller has already answered for an empty pool.
	export static function create(sizes PoolJobSizeArray, workerCount PoolSize, assignment PoolAssignment) returns PoolDispatch
		return Self.withBound(sizes, workerCount: workerCount, assignment: assignment, sizeBound: InFlightSizeBound.unbounded)
	end 'create'

	// A job in flight holds a worker's whole intermediate state, which is proportional to the function's op
	// count — so a count-only pipeline puts the LONGEST functions in flight together, the dispatch order
	// being longest-first, and the peak is set by the largest functions rather than by the average one. The
	// budget is what an average-sized job set would occupy at full pipeline depth.
	export static function boundedByInFlightSize(sizes PoolJobSizeArray, workerCount PoolSize, assignment PoolAssignment) returns PoolDispatch
		return Self.withBound(sizes, workerCount: workerCount, assignment: assignment, sizeBound: InFlightSizeBound.upTo(uniformPipelineSize(sizes, workerCount: workerCount)))
	end 'boundedByInFlightSize'

	static function withBound(sizes PoolJobSizeArray, workerCount PoolSize, assignment PoolAssignment, sizeBound InFlightSizeBound) returns PoolDispatch
		let jobCount = sizes.count() as PoolSize
		let order = PoolJobArray.create(0)
		let sizeInDispatchOrder = PoolJobSizeArray.create(0)
		fillLongestFirstOrder(sizes, jobCount: jobCount, order: order, sizeInDispatchOrder: sizeInDispatchOrder)
		let outstandingPerWorker = InFlightCountArray.create(workerCount as ElementIndex)
		let handedToWorker = FixedPoolSlotArray.create(workerCount as ElementIndex)
		let positionOfJob = FixedPoolSlotArray.create(jobCount as ElementIndex)

		for position in 0 upto order.count() 'eachPosition'
			let job = try order.get(position) otherwise panic("PoolDispatch.withBound: order.get OOB at {position} below {order.count()}")
			try positionOfJob.set(job, value: position) otherwise panic("PoolDispatch.withBound: positionOfJob.set OOB at job {job} below {jobCount}")
		end 'eachPosition'

		let arrivedAtPosition = FixedBoolArray.create(jobCount as ElementIndex)
		let depth = pipelineDepthOf(workerCount, jobCount: jobCount)
		let replyJob = PoolJobArray.create(depth, zeroed: false)
		let replyWorker = PoolSlotArray.create(depth, zeroed: false)
		let replySize = PoolJobSizeArray.create(depth, zeroed: false)
		return Self{handedToWorker: handedToWorker, positionOfJob: positionOfJob, arrivedAtPosition: arrivedAtPosition, settled: 0, order: order, sizeInDispatchOrder: sizeInDispatchOrder, jobCount: jobCount, workerCount: workerCount, assignment: assignment, dispatched: 0, replyJob: replyJob, replyWorker: replyWorker, replySize: replySize, outstandingPerWorker: outstandingPerWorker, inFlightSize: 0, sizeBound: sizeBound}
	end 'withBound'

	// The most answers a drain holds at once. The reply columns here are reserved to it: how many are
	// outstanding at a time depends on completion order, so growing them on demand would make
	// identical compiles report different allocation totals.
	export function pipelineDepth() returns ElementIndex
		return pipelineDepthOf(self.workerCount, jobCount: self.jobCount)
	end 'pipelineDepth'

	// How many jobs the fill hands out before the first await: the pipeline, or every job when there are
	// fewer.
	export function initialInFlight() returns InFlightCount
		match self.sizeBound 'bound'
			unbounded then break
			upTo(budget) then panic("PoolDispatch.initialInFlight: this dispatch is bounded at {budget} op(s) in flight, which a count-only fill cannot honour — fill it for as long as `fillAdmitsAnother` says so")
		end 'bound'

		return self.pipelineDepth() as InFlightCount
	end 'initialInFlight'

	export function fillAdmitsAnother() returns bool
		return self.admitsAJobFor(self.fillWorker())
	end 'fillAdmitsAnother'

	export function admitsAJobFor(worker ElementIndex) returns bool
		if not self.hasUndispatchedFor(worker) 'nothingLeftToHandOut'
			return false
		end 'nothingLeftToHandOut'

		let held = self.outstandingOf(worker)

		// ⛔ An idle worker is admitted whatever the budget says. One function larger than the whole budget
		// is ordinary — it is the first job in longest-first order — and a bound that could refuse it while
		// nothing was running would leave the drain with no reply to await and no job dispatched.
		if held == 0 'theWorkerHoldsNothing'
			return true
		end 'theWorkerHoldsNothing'

		if held >= JobsInFlightPerWorker as InFlightCount 'itsPipelineIsFull'
			return false
		end 'itsPipelineIsFull'

		return match self.sizeBound 'bound'
			unbounded gives true
			upTo(budget) gives self.inFlightSize < budget
		end 'bound'
	end 'admitsAJobFor'

	export function inFlightSizeBudget() returns PoolJobSize
		return match self.sizeBound 'bound'
			unbounded panic("PoolDispatch.inFlightSizeBudget: this dispatch carries no in-flight size bound — only a pool built by `boundedByInFlightSize` has one to report")
			upTo(budget) gives budget
		end 'bound'
	end 'inFlightSizeBudget'

	function outstandingOf(worker ElementIndex) returns InFlightCount
		return try self.outstandingPerWorker.get(worker) otherwise panic("PoolDispatch.outstandingOf: worker {worker} is not one of the {self.workerCount} this pool holds")
	end 'outstandingOf'

	// The worker the fill's next job goes to: round-robin over the pool.
	export function fillWorker() returns ElementIndex
		return try (self.dispatched mod (self.workerCount as ElementIndex)) otherwise panic("PoolDispatch.fillWorker: a pool of no workers never reaches the dispatch loop")
	end 'fillWorker'

	function positionOfNextJobFor(worker ElementIndex) returns ElementIndex
		return match self.assignment 'assignment'
			staticShare gives worker + self.handedTo(worker) * (self.workerCount as ElementIndex)
			firstFree gives self.dispatched
		end 'assignment'
	end 'positionOfNextJobFor'

	function handedTo(worker ElementIndex) returns ElementIndex
		return try self.handedToWorker.get(worker) otherwise panic("PoolDispatch.handedTo: worker {worker} is not one of the {self.workerCount} this pool holds")
	end 'handedTo'

	export function hasUndispatchedFor(worker ElementIndex) returns bool
		return self.positionOfNextJobFor(worker) < self.jobCount as ElementIndex
	end 'hasUndispatchedFor'

	// Take the next job in dispatch order for `worker`. The caller pushes the worker's reply now, at the
	// slot these columns just gained.
	export function nextJob(worker ElementIndex) returns ElementIndex
		let position = self.positionOfNextJobFor(worker)
		let job = try self.order.get(position) otherwise panic("PoolDispatch.nextJob: the dispatch order holds {self.order.count()} job(s) and slot {position} is past the end — ask `hasUndispatchedFor` first")
		let size = try self.sizeInDispatchOrder.get(position) otherwise panic("PoolDispatch.nextJob: the size column holds {self.sizeInDispatchOrder.count()} entry(ies) against {self.order.count()} job(s) — one walk fills both")
		let held = self.outstandingOf(worker)
		try self.handedToWorker.set(worker, value: self.handedTo(worker) + 1) otherwise panic("PoolDispatch.nextJob: handedToWorker.set OOB at worker {worker} below {self.workerCount}")
		self.dispatched = self.dispatched + 1
		self.replyJob.push(job)
		self.replyWorker.push(worker)
		self.replySize.push(size)
		self.inFlightSize = self.inFlightSize + size
		try self.outstandingPerWorker.set(worker, value: held + 1) otherwise panic("PoolDispatch.nextJob: outstandingPerWorker.set OOB at worker {worker} below {self.workerCount}")
		return job
	end 'nextJob'

	// The worker holding the reply at `ready`, free once the caller lands that slot.
	function workerAt(ready ElementIndex) returns ElementIndex
		return try self.replyWorker.get(ready) otherwise panic("PoolDispatch.workerAt: {ready} is not an outstanding slot — {self.replyWorker.count()} are in flight")
	end 'workerAt'

	export function inFlightCount() returns ElementIndex
		return self.replyJob.count()
	end 'inFlightCount'

	export function landJob(job ElementIndex) returns ElementIndex
		let position = self.replyPositionOf(job)
		let freed = self.workerAt(position)
		self.landAt(position)

		return freed
	end 'landJob'

	function replyPositionOf(job ElementIndex) returns ElementIndex
		for position in 0 upto self.replyJob.count() 'eachReply'
			let held = try self.replyJob.get(position) otherwise panic("PoolDispatch.replyPositionOf: replyJob.get OOB at {position} below {self.replyJob.count()}")

			if held == job 'theReply'
				return position
			end 'theReply'
		end 'eachReply'

		panic("PoolDispatch.replyPositionOf: job {job} has no reply in flight — it was never dispatched or has already landed")
	end 'replyPositionOf'

	function landAt(ready ElementIndex)
		let worker = try self.replyWorker.remove(ready) otherwise panic("PoolDispatch.land: replyWorker.remove({ready}) — the two columns are pushed and removed together")
		let held = self.outstandingOf(worker)

		if held == 0 'theWorkerHeldNothing'
			panic("PoolDispatch.land: worker {worker} landed a reply while holding none — a job is counted onto its worker at `nextJob` and off it here")
		end 'theWorkerHeldNothing'

		try self.outstandingPerWorker.set(worker, value: held - 1) otherwise panic("PoolDispatch.land: outstandingPerWorker.set OOB at worker {worker} below {self.workerCount}")
		let size = try self.replySize.remove(ready) otherwise panic("PoolDispatch.land: replySize.remove({ready}) — the three columns are pushed and removed together")
		self.inFlightSize = self.inFlightSize - size
		let job = try self.replyJob.remove(ready) otherwise panic("PoolDispatch.land: replyJob.remove({ready}) — the position `landJob` found names a slot of the three columns, which are pushed and removed together")
		let position = try self.positionOfJob.get(job) otherwise panic("PoolDispatch.land: positionOfJob.get OOB at job {job} below {self.jobCount}")
		try self.arrivedAtPosition.set(position, value: true) otherwise panic("PoolDispatch.land: arrivedAtPosition.set OOB at position {position} below {self.jobCount}")
	end 'landAt'

	// Replies are spliced in dispatch order, not arrival order: the module's arrays grow by the append
	// sequence, so an arrival-order splice makes the allocation totals differ between identical
	// compiles.
	export function hasNextToSettle() returns bool
		if self.settled >= self.jobCount as ElementIndex 'everyJobSettled'
			return false
		end 'everyJobSettled'

		return try self.arrivedAtPosition.get(self.settled) otherwise panic("PoolDispatch.hasNextToSettle: arrivedAtPosition.get OOB at {self.settled} below {self.jobCount}")
	end 'hasNextToSettle'

	export function takeNextToSettle() returns ElementIndex
		if not self.hasNextToSettle() 'nothingArrivedNext'
			panic("PoolDispatch.takeNextToSettle: the job at dispatch position {self.settled} of {self.jobCount} has not landed — ask `hasNextToSettle` first")
		end 'nothingArrivedNext'

		let job = try self.order.get(self.settled) otherwise panic("PoolDispatch.takeNextToSettle: order.get OOB at {self.settled} below {self.order.count()}")
		self.settled = self.settled + 1
		return job
	end 'takeNextToSettle'

	export function requireEveryJobSettled()
		if self.settled != self.jobCount as ElementIndex 'jobsLeftUnsettled'
			panic("PoolDispatch.requireEveryJobSettled: {self.settled} of {self.jobCount} job(s) were settled — the drain ended with a reply that never landed")
		end 'jobsLeftUnsettled'
	end 'requireEveryJobSettled'
end 'PoolDispatch'

export enum PoolKind
	regalloc
	stdFanOut
	frontEnd
end 'PoolKind'

// Which worker takes which job. `staticShare` gives worker w dispatch positions w, w + W, …, so
// what a worker's own scratch grows to depends on the job set alone — a pool whose workers keep
// scratch across jobs needs it, or identical compiles report different allocation totals.
// `firstFree` hands the next job to whichever worker frees first, so no worker idles behind
// another's share; its workers must size every scratch from the job in hand.
export enum PoolAssignment
	staticShare
	firstFree
end 'PoolAssignment'

// Every worker pool in the compiler is `min(P, jobs)` workers. P is the scheduler's resolved processor
// count, not the machine's: `MAXON_MAX_PROCS=1` resolves it to one and the pool is then one worker,
// which is the whole of what pinning does. The job count bounds it because a worker with no job to run
// is a mailbox and a green thread bought for nothing.
//
// `workerCount` is an `ElementIndex` rather than a `PoolSize` because zero is a legal answer: a caller with
// no jobs still logs its line, and each consumer casts to `PoolSize` past its own `> 0` guard.
export type PoolSizing
	export let workerCount as ElementIndex
	let processors as SchedulerProcessorCount
	let jobCount as ElementIndex

	export static function forJobs(jobCount ElementIndex) returns PoolSizing
		let processors = Scheduler.processorCount()

		let workerCount = processors if processors < jobCount else jobCount
		return Self{workerCount: workerCount, processors: processors, jobCount: jobCount}
	end 'forJobs'

	// The pool's one debug line, and the only evidence that a pool of many ran rather than a pool of one:
	// both compile byte-identically, so nothing else can tell the two apart. `tests/parallelCompile/`
	// reads this wording word by word, so rewording it fails that suite.
	export function line(kind PoolKind) returns String
		let name = match kind 'name'
			regalloc gives "regalloc"
			stdFanOut gives "stdFanOut"
			frontEnd gives "front end"
		end 'name'

		let job = match kind 'job'
			regalloc or
			stdFanOut gives "function"
			frontEnd gives "file"
		end 'job'

		return "{name}: {self.workerCount} worker(s) over {self.processors} processor(s), {self.jobCount} {job}(s)"
	end 'line'
end 'PoolSizing'

function pipelineDepthOf(workerCount PoolSize, jobCount PoolSize) returns ElementIndex
	let pipeline = (workerCount as ElementIndex) * JobsInFlightPerWorker
	return pipeline if pipeline < (jobCount as ElementIndex) else (jobCount as ElementIndex)
end 'pipelineDepthOf'

function uniformPipelineSize(sizes PoolJobSizeArray, workerCount PoolSize) returns PoolJobSize
	var total = 0 as PoolJobSize

	for size in sizes 'eachJob'
		total = total + size
	end 'eachJob'

	let mean = try (total / (sizes.count() as PoolJobSize)) otherwise panic("uniformPipelineSize: a pool of no jobs never reaches the dispatch")
	return mean * (workerCount as PoolJobSize) * (JobsInFlightPerWorker as PoolJobSize)
end 'uniformPipelineSize'

// A job's size and position packed into one longest-first sort key.
typealias LongestFirstKey = int(0 to u64.max)
typealias LongestFirstKeyArray = Array with LongestFirstKey

module union UnitLowering
	x64(lowering StdToX64Lowering)
	arm64(lowering StdToArm64Lowering)
end 'UnitLowering'

module function unitLoweringFor(target Target, abi immutable CalleeAbiTable, usesGt bool) returns UnitLowering
	return match target.cpu 'cpu'
		x64 gives UnitLowering.x64(StdToX64Lowering.create(target, abi: abi, usesGt: usesGt))
		arm64 gives UnitLowering.arm64(StdToArm64Lowering.create(target, abi: abi, usesGt: usesGt))
		wasm32 panic("unitLoweringFor: the wasm backend consumes the Std module directly and runs no backend unit (got {targetToString(target)})")
	end 'cpu'
end 'unitLoweringFor'

function lowerUnitWith(lowering UnitLowering, unitModule StdModule, permitsTailCalls bool) returns LoweredUnit
	return match lowering 'isa'
		x64(isel) gives isel.lowerUnit(unitModule, permitsTailCalls: permitsTailCalls)
		arm64(isel) gives isel.lowerUnit(unitModule, permitsTailCalls: permitsTailCalls)
	end 'isa'
end 'lowerUnitWith'

// ⭐ **THE ISEL AND THE EDGE SPLIT, AS ONE DOOR** — the worker's (`BackendWorker.finish`) and the E5001
// re-run's (`refuseForRegisterPressure`). The re-run recovers a refusal by taking the function through
// exactly what the worker did, so a step added here reaches both; one added beside it in a single caller
// would make the two runs disagree, which the re-run can only report as a nondeterminism in the allocator.
// The isel's bracket is closed into the caller's `iselCost`; the split's goes into `costs` under its own
// sub-phase.
module function lowerAndSplitUnit(lowering UnitLowering, unitModule StdModule, permitsTailCalls bool, target Target, costs PoolPhaseCosts, iselCost PhaseDelta) returns LoweredUnit
	let iselProbe = PhaseProbe.beginCounters()
	let lowered = lowerUnitWith(lowering, unitModule: unitModule, permitsTailCalls: permitsTailCalls)
	iselProbe.elapsedInto(iselCost)

	let edgeProbe = PhaseProbe.beginCounters()
	splitCriticalEdges(lowered.targetModule, target: target)
	costs.record(RegAllocPhase.criticalEdges.ordinal, probe: edgeProbe)
	return lowered
end 'lowerAndSplitUnit'

// ⭐⭐ **THE WORKER. Its state is the per-ISA facts the allocator runs on** — derived once from the
// two enums it is handed and never re-derived — plus the callee ABI table and the unit it is
// running.
//
// ⚠ **IT IS HANDED `cpu` AND `os`, NOT A `Target`, AND ITS OWN CLONE OF THE ABI TABLE.** A
// `spawn`'s factory arguments are MOVED, and the driver keeps its own `target` and its own table
// for the rest of the compile — so passing either record would be handing a box to a second green
// thread while this one still holds it, which the send refuses at best and aborts a seed-built binary at worst. Two enums are
// scalars and copy; the table arrives `isolated`, cloned per worker.
//
// ⛔ **THE ISEL IS BUILT PER MESSAGE AND NEVER HELD.** Its scratches (`CompareFusionCensus`,
// `ScaledIndexFolds`, `MemoryDestinationFolds`, …) are refilled per function and keep their
// capacity, so an isel kept across jobs makes a job's allocations depend on what its worker ran
// before — and under `PoolAssignment.firstFree` that is timing.
//
// ⚠ **AND WHAT IT DERIVES IS THE DRIVER'S OWN, NOT A SECOND OPINION OF IT.** `Target` has exactly
// those two fields, and each fact comes from the same pure function the driver called — so the
// reconstruction is exact, not approximate. That matters because the driver's copies are what a
// REFUSAL is rendered against (`refuseForRegisterPressure`): a pool colouring against one pool
// while E5001 measured a deficit against another would be a diagnostic about a machine nobody
// compiled for.
export type BackendWorker
	var target as Target
	let abi as immutable CalleeAbiTable
	var usesGt as bool
	let pool as RegMask
	let callerSaved as RegMask
	let file as RegisterFile
	var slot as isolated BackendUnit

	static function create(cpu CpuArch, os Os, abi isolated CalleeAbiTable, usesGt bool) returns Self
		let target = Target.create(cpu, os: os)
		return Self{target: target, abi: freeze abi, usesGt: usesGt, pool: allocatablePool(target), callerSaved: callerSavedMaskFor(target), file: registerFileFor(target), slot: BackendUnit.awaitingABody(0)}
	end 'create'

	// The isel is handed a `Target` of its own rather than this worker's: the driver's E5001 re-run builds
	// an isel the same way, and a record two fields hold would be a second owner at a walk.
	function lowering() returns UnitLowering
		return unitLoweringFor(Target.create(self.target.cpu, os: self.target.os), abi: self.abi, usesGt: self.usesGt)
	end 'lowering'

	export function runThen(unit isolated BackendUnit, job ElementIndex, receiver CompileReceiver.handle)
		let finished = try self.worked(unit) otherwise 'refused'
			self.answer(BackendUnit.awaitingABody(job), job: job, refused: true, receiver: receiver)
			return
		end 'refused'

		self.answer(finished, job: job, refused: false, receiver: receiver)
	end 'runThen'

	function answer(unit isolated BackendUnit, job ElementIndex, refused bool, receiver CompileReceiver.handle)
		try receiver.backendAnswered(job, answered: unit, refused: refused, receiver: receiver.clone()) otherwise (e) 'refused'
			match e 'why'
				mailboxFull then panicOnRefusedAnswer("BackendWorker.runThen")
				serviceStopped then return
			end 'why'
		end 'refused'
	end 'answer'

	function worked(unit isolated BackendUnit) returns isolated BackendUnit throws RegAllocRefusal
		let idle = swap self.slot with unit

		modify self.slot 'work'
			let body = self.slot.holder.take()
			let finished = try self.finish(body)
			self.slot.finished.fill(finished)
		end 'work'

		return swap self.slot with idle
	end 'worked'

	// Each stage is bracketed on this thread's counters into the same rows a serial run bills them to.
	//
	// The orphans are compacted away before the reply: the allocator's rewrite leaves the uncoloured
	// op in the flat array beside the coloured one that replaced it, sharing its managed payloads, and
	// a reply moves, so every record reachable from it must have one owner.
	module function finish(body BackendUnitBody) returns FinishedUnit throws RegAllocRefusal
		let costs = PoolPhaseCosts.create(RegAllocPhase.allCases.count())
		let iselCost = PhaseDelta.zero()

		// A `var`: the allocator rewrites its module and function in place.
		let lowered = lowerAndSplitUnit(self.lowering(), unitModule: body.unitModule, permitsTailCalls: body.encoding.permitsTailCalls, target: self.target, costs: costs, iselCost: iselCost)
		body.unitModule.releaseBody()
		let unitFunc = lowered.targetModule.getFunc(UnitFunctionIndex)
		let counters = RegAllocCounters.create()
		let facts = RegAllocFacts.create()
		let refusal = RegAllocRefusalSite.create()
		let debugLocations = DebugValueLocationArray.create(0)
		let debugRanges = DebugValueRangeArray.create(0)
		let debugSpans = DebugSpanRows.create()
		let opFacts = OpVariantFacts.create()
		try allocateFunctionCore(lowered.targetModule, func: unitFunc, hasAuthor: body.hasAuthor, pool: self.pool, callerSaved: self.callerSaved, file: self.file, valueClass: lowered.valueClass, opFacts: opFacts, counters: counters, costs: costs, facts: facts, refusal: refusal, debugValues: body.debugValues, debugLocations: debugLocations, debugRanges: debugRanges, debugSpans: debugSpans)
		unitFunc.debugLocalLocations = debugLocations
		unitFunc.debugLocalRanges = debugRanges
		unitFunc.debugLocalSpans = debugSpans

		// Asked HERE because the splitter and SSA destruction have both run, and both mint ops by pushing
		// onto `ops` directly.
		lowered.targetModule.spans.requireParallelTo(lowered.targetModule.ops.count(), what: "after allocation")
		lowered.targetModule.compactOps()

		// Before the tail: the ranges name live-op ordinals of the allocator's layout, which branch
		// cleanup rearranges, and a range resolved after it lands on the wrong op without a word.
		resolveDebugRanges(lowered.targetModule, unitFunc: unitFunc)

		let tail = self.finishFunction(lowered.targetModule, func: unitFunc, encoding: body.encoding)
		lowered.targetModule.spans.requireParallelTo(lowered.targetModule.ops.count(), what: "after the backend tail")
		lowered.targetModule.compactOps()

		// Resolved into the chunk by `encode`; the compaction above renumbers the ops these name.
		unitFunc.debugLocalRanges = DebugValueRangeArray.create(0)
		unitFunc.debugLocalSpans = DebugSpanRows.create()

		return FinishedUnit.create(lowered.targetModule, landing: BackendUnitLanding.create(lowered.rdata, counters: counters, facts: facts, costs: costs, iselCost: iselCost, tail: tail))
	end 'finish'

	// Cleanup before the frame: the frame pass then sees only the surviving blocks, so a callee-saved
	// register or a call that only unreachable code used is not paid for.
	function finishFunction(module TargetModule, func IrFunction, encoding FunctionEncodingFacts) returns BackendUnitTail
		let branchCleanupCost = PhaseDelta.zero()
		let cleanupProbe = PhaseProbe.beginCounters()
		cleanUpFunctionBranches(module, func: func)
		cleanupProbe.elapsedInto(branchCleanupCost)

		let prologueEpilogueCost = PhaseDelta.zero()
		let frameProbe = PhaseProbe.beginCounters()
		let frame = self.insertFrame(module, func: func)
		frameProbe.elapsedInto(prologueEpilogueCost)

		let encodeCost = PhaseDelta.zero()
		let encodeProbe = PhaseProbe.beginCounters()
		let chunk = self.encode(module, func: func, frame: frame, encoding: encoding)
		encodeProbe.elapsedInto(encodeCost)

		return BackendUnitTail.create(chunk, branchCleanupCost: branchCleanupCost, prologueEpilogueCost: prologueEpilogueCost, encodeCost: encodeCost)
	end 'finishFunction'

	function insertFrame(module TargetModule, func IrFunction) returns UnitFrame
		return match self.target.cpu 'cpu'
			x64 gives UnitFrame.x64(insertFrameForFunction(module, func: func))
			arm64 gives UnitFrame.arm64(insertArm64FrameForFunction(module, func: func))
			wasm32 panic("BackendWorker.insertFrame: the wasm backend consumes the Std module directly and runs no backend unit (got {targetToString(self.target)})")
		end 'cpu'
	end 'insertFrame'

	function encode(module TargetModule, func IrFunction, frame UnitFrame, encoding FunctionEncodingFacts) returns FunctionCodeChunk
		return match frame 'isa'
			x64(sized) gives emitFunctionChunk(module, func: func, frame: sized, encoding: encoding, usesGt: self.usesGt, target: self.target)
			arm64(frameBytes) gives emitArm64FunctionChunk(module, func: func, frameBytes: frameBytes, encoding: encoding, greenThreads: self.usesGt, target: self.target)
		end 'isa'
	end 'encode'
end 'BackendWorker'

union UnitFrame
	x64(frame X64PrologueFrame)
	arm64(frameBytes StackSize)
end 'UnitFrame'

typealias BackendPoolStateSlot = Slot with BackendPoolState

type BackendPoolState
	module let workers as BackendWorkerHandleArray
	module let landed as BackendUnitLandingArray
	module let dispatch as PoolDispatch
	module let arrivedUnits as BackendArrivedUnits
	module let stealsBefore as SchedulerEventCount
	module var refused as ElementIndex

	static function of(workers BackendWorkerHandleArray, landed BackendUnitLandingArray, dispatch PoolDispatch, arrivedUnits BackendArrivedUnits, stealsBefore SchedulerEventCount, refused ElementIndex) returns BackendPoolState
		return Self{workers: workers, landed: landed, dispatch: dispatch, arrivedUnits: arrivedUnits, stealsBefore: stealsBefore, refused: refused}
	end 'of'
end 'BackendPoolState'

// Take every function through the backend unit on a worker pool, and hand back the assembled Target
// module; `chunks` is filled in function-index order. The one entry both
// native backends call; `PoolSizing` owns how the pool is sized.
//
// `throws CompileError` because a genuine hot-loop overflow is E5001, reported onto `project.diagnostics`.
// Only USER functions are present here — x64's `mrt_start` is prepended AFTER this pass by
// `augmentWithRuntime` (it is hand-built in physical registers).
export type BackendRun
	let stdModule as StdModule
	let target as Target
	let globalData as GlobalDataTable
	let project as Project
	let usesGt as bool
	let chunks as FunctionCodeChunkArray
	let pool as RegMask
	let callerSaved as RegMask
	let file as RegisterFile
	let abi as immutable CalleeAbiTable
	let targetModule as TargetModule
	let funcCount as ElementIndex
	let sizing as PoolSizing
	let slots as LandingSlots
	let state as BackendPoolStateSlot

	export static function create(stdModule StdModule, target Target, globalData GlobalDataTable, project Project, funcNames FunctionNameIndex, usesGt bool, chunks FunctionCodeChunkArray) returns BackendRun
		if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'debugging'
			compilerLogger(CompilerLogGroup.codegen).debug("Register allocation ({targetToString(target)})")
		end 'debugging'

		let pool = allocatablePool(target)
		let file = registerFileFor(target)
		let callerSaved = callerSavedMaskFor(target)
		assertRegisterFacts(target, pool: pool, callerSaved: callerSaved, file: file)

		let funcCount = stdModule.funcCount()
		let sizing = PoolSizing.forJobs(funcCount)

		if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'poolDebugging'
			compilerLogger(CompilerLogGroup.codegen).debug(sizing.line(PoolKind.regalloc))
		end 'poolDebugging'

		return Self{stdModule: stdModule, target: target, globalData: globalData, project: project, usesGt: usesGt, chunks: chunks, pool: pool, callerSaved: callerSaved, file: file, abi: CalleeAbiTable.build(funcNames), targetModule: assembleTargetModule(stdModule), funcCount: funcCount, sizing: sizing, slots: LandingSlots.create(funcCount), state: BackendPoolStateSlot.create("BackendRun.state")}
	end 'create'

	export function begin(receiver CompileReceiver.handle) returns bool
		if self.funcCount == 0 'nothingToLower'
			return false
		end 'nothingToLower'

		let workers = BackendWorkerHandleArray.create(self.sizing.workerCount, zeroed: false)

		for _ in 0 upto self.sizing.workerCount 'eachWorker'
			workers.push(spawn BackendWorker.create(self.target.cpu, os: self.target.os, abi: self.abi.clone(), usesGt: self.usesGt))
		end 'eachWorker'

		let dispatch = PoolDispatch.boundedByInFlightSize(functionOpTallies(self.stdModule.functions, blocks: self.stdModule.blocks), workerCount: self.sizing.workerCount as PoolSize, assignment: PoolAssignment.firstFree)
		let opened = BackendPoolState.of(workers, landed: BackendUnitLandingArray.create(self.funcCount, zeroed: false), dispatch: dispatch, arrivedUnits: BackendArrivedUnits.create(self.funcCount, spent: TargetModule.create()), stealsBefore: Scheduler.counters().steals, refused: self.funcCount)
		self.state.fill(opened)

		while dispatch.fillAdmitsAnother() 'fillThePipeline'
			self.dispatchOne(dispatch.fillWorker(), receiver: receiver)
		end 'fillThePipeline'

		if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'debugging'
			compilerLogger(CompilerLogGroup.codegen).debug("regalloc pool: the fill put {dispatch.inFlightCount()} job(s) in flight over {self.sizing.workerCount} worker(s), bounded at {dispatch.inFlightSizeBudget()} op(s)")
		end 'debugging'

		return true
	end 'begin'

	export function answered(job ElementIndex, answered isolated BackendUnit, refused bool, receiver CompileReceiver.handle) returns bool
		let poolState = self.state.held()
		let freedWorker = poolState.dispatch.landJob(job)
		let returned = merge answered

		if refused 'aHotOverflow'
			poolState.refused = job if job < poolState.refused else poolState.refused
		end 'aHotOverflow' else 'aFinishedFunction'
			let done = returned.finished.take()
			self.slots.record(job, slot: poolState.landed.count())
			poolState.arrivedUnits.arrive(done.unitModule)
			poolState.landed.push(done.landing)
		end 'aFinishedFunction'

		while poolState.dispatch.admitsAJobFor(freedWorker) 'handTheFreedWorkerTheNextJob'
			self.dispatchOne(freedWorker, receiver: receiver)
		end 'handTheFreedWorkerTheNextJob'

		spliceSettledUnits(self.targetModule, dispatch: poolState.dispatch, slots: self.slots, arrivedUnits: poolState.arrivedUnits)

		return poolState.dispatch.inFlightCount() == 0
	end 'answered'

	export function finish() returns TargetModule throws CompileError
		if self.funcCount == 0 'nothingWasLowered'
			return self.targetModule
		end 'nothingWasLowered'

		let poolState = self.state.held()
		poolState.dispatch.requireEveryJobSettled()

		if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'debugging'
			compilerLogger(CompilerLogGroup.codegen).debug("regalloc pool: {Scheduler.counters().steals - poolState.stealsBefore} work-steal(s) while the pool drained")
		end 'debugging'

		self.project.retiredWorkers.backend.keep(poolState.workers)

		if poolState.refused < self.funcCount 'aFunctionDidNotFitTheMachine'
			try refuseForRegisterPressure(self.project, stdModule: self.stdModule, funcIndex: poolState.refused, target: self.target, abi: self.abi, usesGt: self.usesGt, pool: self.pool, callerSaved: self.callerSaved, file: self.file)
		end 'aFunctionDidNotFitTheMachine'

		self.chunks.reserve(self.funcCount)
		let stats = self.project.timings.regAlloc

		for funcIndex in 0 upto self.funcCount 'foldInIndexOrder'
			let landing = try poolState.landed.get(self.slots.slotOf(funcIndex)) otherwise panic("BackendRun.finish: landed.get OOB for function {funcIndex}")
			let func = self.targetModule.getFunc(funcIndex)
			performRdataRequests(self.globalData, module: self.targetModule, func: func, chunk: landing.tail.chunk, requests: landing.rdata)
			attachInlineSites(landing.tail.chunk, func: func)
			foldPoolPhaseDelta(self.project, phase: CompilePhase.isel, driver: CompilePhase.regalloc, delta: landing.iselCost)
			foldPoolPhaseDelta(self.project, phase: CompilePhase.branchCleanup, driver: CompilePhase.regalloc, delta: landing.tail.branchCleanupCost)
			foldPoolPhaseDelta(self.project, phase: CompilePhase.prologueEpilogue, driver: CompilePhase.regalloc, delta: landing.tail.prologueEpilogueCost)
			foldPoolPhaseDelta(self.project, phase: CompilePhase.encode, driver: CompilePhase.regalloc, delta: landing.tail.encodeCost)
			foldFunctionAllocation(self.project, stats: stats, func: func, counters: landing.counters, costs: landing.costs, facts: landing.facts)
			self.chunks.push(landing.tail.chunk)
		end 'foldInIndexOrder'

		if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'reporting'
			compilerLogger(CompilerLogGroup.codegen).debug(regAllocStatsMessage(stats))
		end 'reporting'

		return self.targetModule
	end 'finish'

	function dispatchOne(workerSlot ElementIndex, receiver CompileReceiver.handle)
		let poolState = self.state.held()
		let worker = try poolState.workers.get(workerSlot) otherwise panic("BackendRun.dispatchOne: workers.get OOB at {workerSlot} below count {poolState.workers.count()}")
		let funcIndex = poolState.dispatch.nextJob(workerSlot)
		try worker.runThen(BackendUnit.extract(self.stdModule, func: self.stdModule.getFunc(funcIndex), funcIndex: funcIndex, runtimeTier: self.project.libraryFacts.runtimeTier, spanTable: self.project.debugSpanTable), job: funcIndex, receiver: receiver.clone()) otherwise panic("{workerRefusedSendMessage("BackendRun.dispatchOne", subject: "the worker running function {funcIndex}")}")
	end 'dispatchOne'
end 'BackendRun'

// The Target module every reply is spliced into: the Std module's function table — the same `IrFunction`
// records, which the Target tier shares with the Std tier — over empty `ops` and `blocks`, carrying spans
// exactly when the Std module does.
function assembleTargetModule(stdModule StdModule) returns TargetModule
	let module = TargetModule.create()
	module.spans.armed = stdModule.spans.armed

	for func in stdModule.functions 'eachFunc'
		module.pushFunc(func)
	end 'eachFunc'

	return module
end 'assembleTargetModule'

function spliceSettledUnits(module TargetModule, dispatch PoolDispatch, slots LandingSlots, arrivedUnits BackendArrivedUnits)
	while dispatch.hasNextToSettle() 'eachSettledJob'
		let job = dispatch.takeNextToSettle()

		if slots.hasLanded(job) 'aUnitCameHome'
			let slot = slots.slotOf(job)
			spliceBackendUnit(module, func: module.getFunc(job), unitModule: arrivedUnits.unitAt(slot))
			arrivedUnits.spend(slot)
		end 'aUnitCameHome'
	end 'eachSettledJob'
end 'spliceSettledUnits'

export type ArrivedUnits uses Unit
	typealias UnitColumn = Array with Unit

	var units as UnitColumn
	var spent as Unit

	export static function create(capacity ElementIndex, spent Unit) returns Self
		let units = UnitColumn.create(capacity, zeroed: false)
		return Self{units: units, spent: spent}
	end 'create'

	export function arrive(unit Unit)
		self.units.push(unit)
	end 'arrive'

	export function unitAt(slot ElementIndex) returns Unit
		return try self.units.get(slot) otherwise panic("ArrivedUnits.unitAt: slot {slot} is past the {self.units.count()} unit(s) that arrived")
	end 'unitAt'

	export function spend(slot ElementIndex)
		try self.units.set(slot, value: self.spent) otherwise panic("ArrivedUnits.spend: slot {slot} is past the {self.units.count()} unit(s) that arrived")
	end 'spend'
end 'ArrivedUnits'

export function workerRefusedSendMessage(driver String, subject String) returns String
	return "{driver}: {subject} refused a send. This driver keeps at most {JobsInFlightPerWorker} jobs in flight per worker against a mailbox of {DefaultMailboxCapacity}, and drops no handle until every reply has landed, so a refusal means the worker's green thread ended on its own — look above for the panic it printed."
end 'workerRefusedSendMessage'

// ⭐⭐ **THE DISPATCH ORDER: LONGEST JOB FIRST (LPT).**
//
// A pool that takes jobs in declaration order finishes when its unluckiest worker finishes, and the
// worst case is the biggest job starting LAST: it then runs alone while every other worker idles.
// Starting the longest job first bounds that, and the small jobs behind it fill the gaps.
//
// ⚠ **IT IS A THROUGHPUT HEURISTIC AND CANNOT REACH THE OUTPUT.** The output is a function of the JOB
// order, which this does not change: every fold runs in job order and splicing is order-independent (see
// this file's header). A different order here is a different wall time and the same bytes.
//
// The key packs (size, job) into ONE integer, so ordering is a plain ascending sort of scalars with no
// comparator closure to carry: `size * jobCount + job` is injective for `job < jobCount`, and it is bounded
// by the total size times the job count. Read back DESCENDING, which is what makes it longest-first.
function fillLongestFirstOrder(sizes PoolJobSizeArray, jobCount PoolSize, order PoolJobArray, sizeInDispatchOrder PoolJobSizeArray)
	let keys = LongestFirstKeyArray.create(sizes.count(), zeroed: false)
	let keyStride = jobCount as LongestFirstKey

	for (position, size) in sizes.withIterator() 'eachJob'
		keys.push((size as LongestFirstKey) * keyStride + (position.index() as LongestFirstKey))
	end 'eachJob'

	keys.sort()

	for k in 0 upto keys.count() 'largestFirst'
		let key = try keys.get(keys.count() - 1 - k) otherwise panic("fillLongestFirstOrder: keys.get OOB walking back from {keys.count()}")
		order.push((try (key mod keyStride) otherwise panic("fillLongestFirstOrder: a pool of no jobs never reaches the ordering")) as ElementIndex)
		sizeInDispatchOrder.push((try (key / keyStride) otherwise panic("fillLongestFirstOrder: a pool of no jobs never reaches the ordering")) as PoolJobSize)
	end 'largestFirst'
end 'fillLongestFirstOrder'

function functionOpTallies(functions IrFunctionArray, blocks IrBlockArray) returns PoolJobSizeArray
	let sizes = PoolJobSizeArray.create(functions.count(), zeroed: false)

	for func in functions 'eachFunc'
		sizes.push(liveOpTallyOf(blocks, func: func) as PoolJobSize)
	end 'eachFunc'

	return sizes
end 'functionOpTallies'

export function noteFunctionsHoldingAnOp(functions IrFunctionArray, blocks IrBlockArray, jobs PoolJobArray, sizes PoolJobSizeArray)
	for (position, func) in functions.withIterator() 'eachFunc'
		let tally = liveOpTallyOf(blocks, func: func)

		if tally > 0 'holdsAnOp'
			noteJob(position.index(), size: tally as PoolJobSize, subjects: jobs, sizes: sizes)
		end 'holdsAnOp'
	end 'eachFunc'
end 'noteFunctionsHoldingAnOp'

export function noteJob(subject ElementIndex, size PoolJobSize, subjects PoolJobArray, sizes PoolJobSizeArray)
	subjects.push(subject)
	sizes.push(size)
end 'noteJob'

export function subjectOfJob(subjects PoolJobArray, job ElementIndex) returns ElementIndex
	return try subjects.get(job) otherwise panic("subjectOfJob: job {job} is not below the {subjects.count()} subject(s) dispatched")
end 'subjectOfJob'

// How many ops one function holds. Counted rather than collected: `IrModule.liveOpIndices` answers the
// same number and allocates an array per function to do it, and this runs on every function of every
// compile — here to order the dispatch, and in `extractUnitModule` to reserve a unit's op array.
export function liveOpTallyOf(blocks IrBlockArray, func IrFunction) returns ElementIndex
	var tally = 0 as ElementIndex

	for blockRef in func.blockRefs 'eachBlock'
		let block = try blocks.get(blockRef) otherwise panic("liveOpTallyOf: blockRef {blockRef} is not in the module's blocks")
		tally = tally + block.bodyOpCount()

		if block.hasTerminatorOp() 'hasTerminator'
			tally = tally + 1
		end 'hasTerminator'
	end 'eachBlock'

	return tally
end 'liveOpTallyOf'
