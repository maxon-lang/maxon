// PreemptionDepth — the compile-time certificate that the runtime code a green thread runs below
// its frames, with no guard of its own, cannot run it off its stack.
//
// A request is honoured at a prologue guard, before the guarded function has a frame
// (`GtRuntime.GtStackGuardPreempt`), and its whole call tree — `__gt_guard_tripped`'s preempt arm,
// `__gt_preempt` and everything the park reaches down to the context switch — runs on the thread's
// own stack riding the margin every guarded prologue projects (`GtRuntime.gtStackGuardMargin`).
// Those frames are the register allocator's to size, so the only honest answer is the one read off
// the frames this backend laid out, after the prologue pass.
//
// A call it cannot size is refused, never guessed. An indirect call, a callee that is neither a
// laid-out function nor a chunk whose depth is known here, and a tree deeper than any the runtime
// has are each a build failure naming what reached it, so a change that grows the tree has to state
// what it costs.
//
// There are three roots, each with its own room. A request honoured at a prologue rides the guard
// margin. A thread stopped where it stands has had nothing projected on its behalf, so the
// safe-point predicate demands `GtRuntime.gtAsyncPreemptMargin` outright and the trampoline's
// register block plus its park's tree must fit inside it. A debug trap on a green thread runs
// Windows exception dispatch, the trap thunk's frame and the deeper of the agent's claim and
// release trees on the interrupted stack, inside the reserve below its guard word
// (`GtRuntime.gtStackSystemBytes`). One walk serves all three; only the root and the room differ.

// One step down from a frame in the tree: a named callee whose own tree is added up, `below` bytes beneath its
// caller's frame; or a call whose whole depth on the thread's stack is known where it is emitted.
export union UnguardedCallStep
	callee(name ByteArray, below StackSize)
	fixed(bytes StackSize)
end 'UnguardedCallStep'

// How many more frames the walk may descend. Its bound is deeper than the preemption's tree has any reason to be —
// it is a handful of frames down to the context switch — and ends the walk on a recursive runtime function.
typealias UnguardedTreeFrames = int(0 to 16)

let MaxUnguardedTreeFrames = 16 as UnguardedTreeFrames

// Refuse the build when the preemption's whole tree is deeper than the guard margin. Called by both native
// backends of a green-thread program, after the prologue pass has fixed every frame.
export function requirePreemptionFitsTheGuardMargin(module TargetModule, funcNames FunctionNameIndex, target Target)
	let arm = preemptArmStackBytes(target)
	let tree = unguardedTreeBytes(module, funcNames: funcNames, name: GtPreemptName, root: GtPreemptName, target: target, framesLeft: MaxUnguardedTreeFrames)
	let margin = gtStackGuardMargin(target)
	logDebug(LogCategory.codegen, message: function() gives "preemption depth ({targetToString(target)}): arm {arm} + tree {tree} = {arm + tree} of a {margin}-byte guard margin")

	if (arm + tree) as ParsedInt > margin 'overflowsTheMargin'
		panic("requirePreemptionFitsTheGuardMargin: honouring a preemption request takes {arm} bytes for `{String.from(GtGuardTrippedName)}`'s preempt arm and {tree} for `{String.from(GtPreemptName)}`'s call tree on {targetToString(target)}, {arm + tree} in all, but it runs below a guarded function's entry inside the {margin}-byte guard margin — a thread preempted near its guard word would write past its stack. Shrink the tree, or raise GtRuntime.GtStackGuardMarginBytes and measure the self-compile")
	end 'overflowsTheMargin'
end 'requirePreemptionFitsTheGuardMargin'

// Refuse the build when an asynchronous stop's whole cost — the trampoline's own frame and everything
// `__gt_async_preempt_park` reaches — outgrows the room the safe-point predicate insisted on. Called by the
// backend of a green-thread program on a lane that stops threads, after the prologue pass.
export function requireAsyncPreemptionFitsItsMargin(module TargetModule, funcNames FunctionNameIndex, target Target)
	let trampoline = asyncPreemptTrampolineStackBytes(target)
	let tree = unguardedTreeBytes(module, funcNames: funcNames, name: AsyncPreemptParkName, root: AsyncPreemptParkName, target: target, framesLeft: MaxUnguardedTreeFrames)
	let margin = gtAsyncPreemptMargin(target)
	logDebug(LogCategory.codegen, message: function() gives "async preemption depth ({targetToString(target)}): trampoline {trampoline} + tree {tree} = {trampoline + tree} of a {margin}-byte stop margin")

	if (trampoline + tree) as ParsedInt > margin 'overflowsTheMargin'
		panic("requireAsyncPreemptionFitsItsMargin: stopping a thread where it stands takes {trampoline} bytes for `{String.from(AsyncPreemptName)}`'s register block and {tree} for `{String.from(AsyncPreemptParkName)}`'s call tree on {targetToString(target)}, {trampoline + tree} in all, but the safe-point predicate only refuses a stack pointer nearer its base than {margin} bytes — a thread stopped just above that floor would write past its stack. Shrink the tree, or raise GtRuntime.GtAsyncPreemptMarginBytes and measure the self-compile")
	end 'overflowsTheMargin'
end 'requireAsyncPreemptionFitsItsMargin'

export function requireDebugTrapFitsItsReserve(module TargetModule, funcNames FunctionNameIndex, target Target)
	let dispatch = gtWindowsExceptionDispatchMeasuredBytes()
	let thunk = debugTrapPreSwitchStackBytes(target)
	let claim = unguardedTreeBytes(module, funcNames: funcNames, name: DebugClaimStackName, root: DebugClaimStackName, target: target, framesLeft: MaxUnguardedTreeFrames)
	let release = unguardedTreeBytes(module, funcNames: funcNames, name: DebugReleaseStackName, root: DebugReleaseStackName, target: target, framesLeft: MaxUnguardedTreeFrames)
	let preSwitch = thunk + deeperOf(claim, other: release)
	let reserve = gtStackSystemBytes(target)
	logDebug(LogCategory.codegen, message: function() gives "debug trap depth ({targetToString(target)}): OS dispatch {dispatch} + thunk {thunk} + the deeper of claim {claim} and release {release} = {dispatch + preSwitch} of a {reserve}-byte reserve")

	if (dispatch + preSwitch) as ParsedInt > reserve 'overrunsTheReserve'
		panic("requireDebugTrapFitsItsReserve: a debug trap on a green thread costs {dispatch} bytes of Windows exception dispatch, {thunk} for `{String.from(DebugTrapThunkName)}`'s own frame and {deeperOf(claim, other: release)} for the deeper of `{String.from(DebugClaimStackName)}`'s call tree ({claim}) and `{String.from(DebugReleaseStackName)}`'s ({release}), both of which run on the interrupted stack, {dispatch + preSwitch} in all, but a green thread reserves only {reserve} bytes below its guard word for the OS. Shrink the thunk's pre-switch path, or raise GtRuntime.GtWindowsExceptionDispatchBytes and measure the self-compile")
	end 'overrunsTheReserve'
end 'requireDebugTrapFitsItsReserve'

function debugTrapPreSwitchStackBytes(target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives x64DebugTrapPreSwitchStackBytes()
		arm64 panic("debugTrapPreSwitchStackBytes: `TargetFacilities.targetProvidesFacility` denies `debugAgent` on every arm64 lane, so no trap thunk is laid out there")
		wasm32 panic("debugTrapPreSwitchStackBytes: wasm32-wasi lays out no native frames")
	end 'cpu'
end 'debugTrapPreSwitchStackBytes'

function asyncPreemptTrampolineStackBytes(target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives x64GtAsyncPreemptStackBytes()
		arm64 gives arm64GtAsyncPreemptStackBytes()
		wasm32 panic("asyncPreemptTrampolineStackBytes: wasm32-wasi has no green-thread stack to stop a thread on — `targetProvidesFacility` denies `greenThreads` there")
	end 'cpu'
end 'asyncPreemptTrampolineStackBytes'

function preemptArmStackBytes(target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives x64GtPreemptArmStackBytes()
		arm64 gives arm64GtPreemptArmStackBytes()
		wasm32 panic("preemptArmStackBytes: wasm32-wasi has no green-thread stack to preempt on — `targetProvidesFacility` denies `greenThreads` there")
	end 'cpu'
end 'preemptArmStackBytes'

// The deepest the tree under `name` reaches below its caller's frame: `name`'s own frame plus its deepest call.
function unguardedTreeBytes(module TargetModule, funcNames FunctionNameIndex, name ByteArray, root ByteArray, target Target, framesLeft UnguardedTreeFrames) returns StackSize
	if framesLeft == 0 'tooDeep'
		panic("PreemptionDepth: the tree under `{String.from(root)}` is more than {MaxUnguardedTreeFrames} frames deep at `{String.from(name)}` — a recursive runtime function has no bound this certificate can state")
	end 'tooDeep'

	if name.equals(GtContextSwitchName) 'theSwitch'
		return gtInitialFrameBytes(target) as StackSize
	end 'theSwitch'

	if name.equals(HostThreadCpuName) 'theThreadClock'
		return hostThreadCpuStackBytes(target)
	end 'theThreadClock'

	let index = try funcNames.byName.get(name) otherwise panic("PreemptionDepth: `{String.from(name)}`, in the tree under `{String.from(root)}`, is neither a function this module laid out nor a chunk whose stack this certificate knows — state its depth here")
	let func = try module.functions.get(index) otherwise panic("PreemptionDepth: `{String.from(name)}` is function {index} of the name index, past the {module.functions.count()} the target module holds")

	if not func.name.equals(name) 'indexDrifted'
		panic("PreemptionDepth: the name index places `{String.from(name)}` at function {index}, which the target module holds as `{String.from(func.name)}`")
	end 'indexDrifted'

	let framesBelow = framesLeft - 1
	var deepest = 0 as StackSize

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("requirePreemptionFitsTheGuardMargin: blockRef from func.blockRefs not in module.blocks")

		for opIdx in block.opRefs 'eachOp'
			deepest = deeperOf(deepest, other: unguardedCallBytes(module, funcNames: funcNames, opIdx: opIdx, root: root, target: target, framesLeft: framesBelow))
		end 'eachOp'

		if block.hasTerminatorOp() 'terminator'
			deepest = deeperOf(deepest, other: unguardedCallBytes(module, funcNames: funcNames, opIdx: block.terminatorIndex(), root: root, target: target, framesLeft: framesBelow))
		end 'terminator'
	end 'eachBlock'

	return callStackBytes(module, func: func, target: target) + deepest
end 'unguardedTreeBytes'

// What the op at `opIdx` adds below its function's frame: nothing unless it is a call.
function unguardedCallBytes(module TargetModule, funcNames FunctionNameIndex, opIdx OpIndex, root ByteArray, target Target, framesLeft UnguardedTreeFrames) returns StackSize
	let op = try module.ops.get(opIdx) otherwise panic("PreemptionDepth: opIdx {opIdx} not in module.ops")

	if not op.rawValue.isCall 'notACall'
		return 0
	end 'notACall'

	return match callStepOf(op, root: root) 'step'
		callee(name, below) gives below + unguardedTreeBytes(module, funcNames: funcNames, name: name, root: root, target: target, framesLeft: framesLeft)
		fixed(bytes) gives bytes
	end 'step'
end 'unguardedCallBytes'

// The step a call op takes, for every call op either native backend emits.
function callStepOf(op TargetOp, root ByteArray) returns UnguardedCallStep
	return match op 'call'
		callDirect(targetName) gives UnguardedCallStep.callee(targetName, below: 0)
		arm64BranchLink(targetName) gives UnguardedCallStep.callee(targetName, below: 0)
		iatCall(slotIndex) gives x64ShimmedImportStep(slotIndex)
		arm64ImportCall gives UnguardedCallStep.fixed(Arm64ImportCallGtStackBytes)
		x64Syscall or
			arm64Syscall gives UnguardedCallStep.fixed(0)
		callReg or
			callMem or
			arm64BranchLinkReg panic("PreemptionDepth: an indirect call in the tree under `{String.from(root)}` names no callee whose frame could be added up")
		default panic("PreemptionDepth: a call op this certificate does not know is in the tree under `{String.from(root)}` — state what it costs the thread's stack here")
	end 'call'
end 'callStepOf'

// `mrt_host_thread_cpu`'s whole depth on the thread's stack, on the lanes whose thread clock is a chunk — the
// park's clock read reaches it. x64-windows reads the clock through an import instead.
function hostThreadCpuStackBytes(target Target) returns StackSize
	return match target.os 'os'
		linux gives linuxThreadCpuStackBytes(target)
		macos gives arm64DarwinThreadCpuStackBytes()
		windows panic("hostThreadCpuStackBytes: {targetToString(target)} reads the thread clock through an import, so `{String.from(HostThreadCpuName)}` is not a chunk there")
		wasi panic("hostThreadCpuStackBytes: wasm32-wasi lays out no native frames")
	end 'os'
end 'hostThreadCpuStackBytes'

function linuxThreadCpuStackBytes(target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives x64LinuxThreadCpuStackBytes()
		arm64 gives arm64LinuxThreadCpuStackBytes()
		wasm32 panic("linuxThreadCpuStackBytes: there is no wasm32-linux lane")
	end 'cpu'
end 'linuxThreadCpuStackBytes'

// Everything one call of `func` puts on the stack below its caller's frame.
function callStackBytes(module TargetModule, func IrFunction, target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives x64CallStackBytes(module, func: func)
		arm64 gives arm64FunctionFrameBytes(module, func: func)
		wasm32 panic("callStackBytes: wasm32-wasi lays out no native frames")
	end 'cpu'
end 'callStackBytes'

function deeperOf(a StackSize, other StackSize) returns StackSize
	return a if a >= other else other
end 'deeperOf'
