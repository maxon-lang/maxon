function requireAsyncPreemptionFitsItsMargin(tree StackSize, target Target)
	let trampoline = asyncPreemptTrampolineStackBytes(target)
	let margin = gtAsyncPreemptMargin(target)

	if compilerLogEnabled(CompilerLogGroup.codegen, level: LogLevel.debug) 'debugging'
		compilerLogger(CompilerLogGroup.codegen).debug("async preemption depth ({targetToString(target)}): trampoline {trampoline} + tree {tree} = {trampoline + tree} of a {margin}-byte stop margin")
	end 'debugging'

	if (trampoline + tree) as FullRangeInt > margin 'overflowsTheMargin'
		panic("requireAsyncPreemptionFitsItsMargin: stopping a thread where it stands takes {trampoline} bytes for `{String.from(AsyncPreemptName)}`'s register block and {tree} for `{String.from(AsyncPreemptParkName)}`'s call tree on {targetToString(target)}, {trampoline + tree} in all, but the safe-point predicate only refuses a stack pointer nearer its base than {margin} bytes — a thread stopped just above that floor would write past its stack. Shrink the tree, or raise GtRuntime.GtAsyncPreemptMarginBytes and measure the self-compile")
	end 'overflowsTheMargin'
end 'requireAsyncPreemptionFitsItsMargin'

function requireAsyncPreemptionSavesEveryVectorValue(target Target)
	let slotBytes = asyncPreemptVectorSlotBytes(target)

	for stdType in StdType.allCases 'eachType'
		if stdTypeIsFloat(stdType) and (stdTypeStorageBytes(stdType) as FullRangeInt) > (slotBytes as FullRangeInt) 'widerThanTheSave'
			panic("requireAsyncPreemptionSavesEveryVectorValue: a `{stdType.name}` value is {stdTypeStorageBytes(stdType)} bytes and lives in a vector register, but the {targetToString(target)} async-preemption trampoline saves {slotBytes} bytes of each — a stop would lose the rest of the interrupted function's value. Save the register's full width in `{String.from(AsyncPreemptName)}`")
		end 'widerThanTheSave'
	end 'eachType'
end 'requireAsyncPreemptionSavesEveryVectorValue'

function asyncPreemptVectorSlotBytes(target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives XmmSaveSlotBytes
		arm64 gives SpillSlotBytes
		wasm32 panic("asyncPreemptVectorSlotBytes: wasm32-wasi has no green-thread stack to stop a thread on — `targetProvidesFacility` denies `greenThreads` there")
	end 'cpu'
end 'asyncPreemptVectorSlotBytes'

function asyncPreemptTrampolineStackBytes(target Target) returns StackSize
	return match target.cpu 'cpu'
		x64 gives x64GtAsyncPreemptStackBytes()
		arm64 gives arm64GtAsyncPreemptStackBytes()
		wasm32 panic("asyncPreemptTrampolineStackBytes: wasm32-wasi has no green-thread stack to stop a thread on — `targetProvidesFacility` denies `greenThreads` there")
	end 'cpu'
end 'asyncPreemptTrampolineStackBytes'
