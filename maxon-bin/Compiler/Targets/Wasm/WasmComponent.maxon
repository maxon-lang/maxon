// WasmComponent — the wasm target's object writer (`writeWasm`, the `wasi` arm of `writeExecutable`): it
// turns the backend's emitted CORE module into a runnable WASI-Preview2 COMPONENT on disk, plus the
// vendored-tool locators that step needs.
//
// The backend (`buildWasmBackend` → StdToWasm) emits a core module that imports the raw Preview2 interface
// funcs (`wasi:cli/exit`) and exports `wasi:cli/run`. wasmtime runs COMPONENTS, not bare core modules, so
// those bytes are staged to a scratch file and put through `wasm-tools component embed` (which records the
// `maxon:app/command` world, so the component model knows which interfaces the core lifts/lowers) and then
// `component new`, whose output is renamed onto the build's output path.
//
// `findFileUpward` / `hostWasmToolCandidates` are exported so every vendored-tool lookup (the spec-test
// runner's `wasmtime` included) uses the SAME upward walk: two searches are two answers to which vendored
// binary is "the" one.

// One candidate path expressed as its ordered path segments; `findFileUpward` joins each onto the
// level it is probing. An Array-of-Arrays so a caller can offer several spellings of the same file
// (e.g. `.exe` vs extensionless) and take the first that exists.
export typealias StringArrayArray = Array with StringArray

// The levels `findFileUpward` searches, the working directory included. Deep enough to reach the checkout
// root (which holds `vendor/`) from any build or spec-test working directory inside it.
let VendorSearchDepth = 10

// The directories a search covered: the working directory and each one above it, up to the last.
export union UpwardSearchError implements Error
	notFound(searchedFrom FilePath, searchedUpTo FilePath)
end 'UpwardSearchError'

// The first candidate that exists, searching the working directory and then each directory above it, at
// most `VendorSearchDepth` levels and never past the filesystem root. Each candidate's segments are
// joined onto the level's directory one at a time, so the join stays cross-platform.
export function findFileUpward(candidateSegments StringArrayArray) returns FilePath throws UpwardSearchError
	let start = Directory.currentPath()
	var dir = start.clone()

	for level in 0 upto VendorSearchDepth 'search'
		for segments in candidateSegments 'eachCandidate'
			// ⚠ `var candidate = dir` MOVES the search loop's directory out of it — a bare-local read is a
			// move whether or not it is in a loop body, and moving a value declared outside the loop is
			// E2015. The first segment is joined onto `dir` as a RECEIVER instead, which borrows it, and the
			// owned path that join mints is what the rest of the segments extend.
			let firstSegment = try segments.get(0) otherwise panic("findFileUpward: a candidate names no path segments — every candidate is at least one segment below the level's directory, and an empty one would test the directory itself")
			var candidate = dir.join(firstSegment)

			for i in 1 upto segments.count() 'join'
				let segment = try segments.get(i) otherwise panic("findFileUpward: segments.get OOB at {i} inside its own count()")
				candidate = candidate.join(segment)
			end 'join'

			if File.exists(candidate) 'found'
				return candidate
			end 'found'
		end 'eachCandidate'

		if level == VendorSearchDepth - 1 'deepestLevel'
			throw UpwardSearchError.notFound(start, searchedUpTo: dir.clone())
		end 'deepestLevel'

		dir = try dir.parent() otherwise throw UpwardSearchError.notFound(start, searchedUpTo: dir.clone())
	end 'search'

	panic("findFileUpward: the deepest level throws before the search loop can end")
end 'findFileUpward'

// Where a failed search looked, as the end of a sentence naming what it looked for.
export function searchedDirectories(search UpwardSearchError) returns String
	return match search 'search'
		notFound(searchedFrom, searchedUpTo) gives "in {searchedFrom} and each directory above it up to {searchedUpTo}"
	end 'search'
end 'searchedDirectories'

// The directory every vendored tool lives under, relative to the checkout root.
let VendorDirSegment = "vendor"

// ⭐ **THE HOST-ORDERED `.exe` / EXTENSIONLESS PAIR FOR ONE BINARY, over an arbitrary directory and
// stem.** The spelling this host can exec comes first, gated on `detectHostTarget()` (resolved per host
// at the compiler's own build), so a directory holding another platform's build by the same stem can
// never be exec'd here and faulted on.
//
// ⚠ **THAT ORDERING RULE IS THE WHOLE CONTENT OF THIS FUNCTION, AND IT IS WHAT A SECOND COPY WOULD COME
// TO DISAGREE ABOUT.** It stays parameterized on the DIRECTORY rather than hard-wired to `vendor/`,
// because the rule is about the HOST and not about where a binary happens to live.
function hostBinaryCandidates(dirSegments StringArray, stem String) returns StringArrayArray
	var exe = StringArray.create()
	var noExt = StringArray.create()

	for segment in dirSegments 'eachSegment'
		exe.push(segment)
		noExt.push(segment)
	end 'eachSegment'

	exe.push("{stem}.exe")
	noExt.push(stem)

	var candidates = StringArrayArray.create()

	if detectHostTarget().os == Os.windows 'winHost'
		candidates.push(exe)
		candidates.push(noExt)
	end 'winHost' else 'nativeHost'
		candidates.push(noExt)
		candidates.push(exe)
	end 'nativeHost'

	return candidates
end 'hostBinaryCandidates'

// A vendored tool's candidates: `vendor/<tool>/<tool>[.exe]`. `tool` is the vendor subdir, which equals
// the tool's basename (e.g. "wasm-tools" → `vendor/wasm-tools/wasm-tools`).
export function hostWasmToolCandidates(tool String) returns StringArrayArray
	var dir = StringArray.create()
	dir.push(VendorDirSegment)
	dir.push(tool)

	return hostBinaryCandidates(dir, stem: tool)
end 'hostWasmToolCandidates'

let WasmToolsName = "wasm-tools"
let WitDirSegment = "wasi-wit"
let WitWorldFileName = "world.wit"
let VendorStagingScript = "scripts/fetch-vendor.sh"

// The two things a component build runs besides the compiler: `wasm-tools`, and the WASI WIT package
// directory `component embed` reads the world from.
export type WasmComponentTools
	export let wasmTools as FilePath
	export let witDir as FilePath

	static function create(wasmTools FilePath, witDir FilePath) returns WasmComponentTools
		return Self{wasmTools: wasmTools, witDir: witDir}
	end 'create'
end 'WasmComponentTools'

typealias ToolExitCode = int(0 to u32.max)

// Why a component could not be produced. Each is the environment's or the toolchain's, never the program's.
export union WasmComponentError implements Error
	toolNotFound(tool String, spelledAs String, search UpwardSearchError)
	stepDidNotRun(step String, reason String)
	stepFailed(step String, exitCode ToolExitCode, stderr String)
	noComponentProduced(componentPath FilePath, outputPath FilePath)
	notPublished(componentPath FilePath, outputPath FilePath)
end 'WasmComponentError'

export function wasmComponentProblem(error WasmComponentError) returns String
	return match error 'problem'
		toolNotFound(tool, spelledAs, search) gives "a wasm32-wasi build wraps its core module into a WASI Preview2 component with {tool}, which was not found: looked for `{spelledAs}` {searchedDirectories(search)}. A Maxon source checkout stages it with `{VendorStagingScript}`; an installed compiler does not include it."
		stepDidNotRun(step, reason) gives "could not run `{WasmToolsName} {step}` to build the wasm32-wasi component: {reason}"
		stepFailed(step, exitCode, stderr) gives "`{WasmToolsName} {step}` exited {exitCode} building the wasm32-wasi component:\n{stderr}"
		noComponentProduced(componentPath, outputPath) gives "`{WasmToolsName} component new` exited 0 but produced no component at {componentPath}, so there is nothing to publish as {outputPath}"
		notPublished(componentPath, outputPath) gives "could not publish the finished component {componentPath} as {outputPath}: the output path is locked or read-only"
	end 'problem'
end 'wasmComponentProblem'

export function locateWasmComponentTools() returns WasmComponentTools throws WasmComponentError
	let wasmTools = try findFileUpward(hostWasmToolCandidates(WasmToolsName)) otherwise (e) 'noWasmTools'
		throw WasmComponentError.toolNotFound("`{WasmToolsName}`", spelledAs: "{VendorDirSegment}/{WasmToolsName}/{WasmToolsName}", search: e)
	end 'noWasmTools'

	var witCandidates = StringArrayArray.create()
	witCandidates.push([VendorDirSegment, WitDirSegment, WitWorldFileName])

	let witWorld = try findFileUpward(witCandidates) otherwise (e) 'noWit'
		throw WasmComponentError.toolNotFound("the WASI WIT package", spelledAs: "{VendorDirSegment}/{WitDirSegment}/{WitWorldFileName}", search: e)
	end 'noWit'

	// `component embed` wants the package root, not the world file inside it.
	let witDir = try witWorld.parent() otherwise panic("locateWasmComponentTools: a file found below a directory has a parent")
	return WasmComponentTools.create(wasmTools, witDir: witDir)
end 'locateWasmComponentTools'

// The three scratch files a component build passes through, named off the output so they share its
// (writable) directory: the emitted CORE module, the same module with the world's metadata EMBEDDED,
// and the finished COMPONENT before it is published.
let WasmCoreExtension = ".core.wasm"
let WasmEmbedExtension = ".embed.wasm"
let WasmComponentExtension = ".component.wasm"

// Write the CORE module to a scratch file, wrap it into a WASI Preview2 component (`component embed`, then
// `component new`), and PUBLISH that with a single rename onto `outputPath`. The `cli-exit-with-code`
// feature is enabled at embed time because the WIT gates the `wasi:cli/exit` import
// `@unstable(cli-exit-with-code)`.
//
// ⚠ **NOTHING IS WRITTEN TO `outputPath` UNTIL THERE IS A FINISHED COMPONENT TO PUT THERE.** Wrapping the
// core module IN PLACE would let a failing `wasm-tools` leave a BARE CORE MODULE at the output path — a
// wrong binary rather than a stale one, which fails at RUN time with `unknown import: wasi:cli/exit…` and
// says nothing about the toolchain. Publishing by rename is what lets `Compiler.requireOutputWritten` read
// the mere PRESENCE of `outputPath` as proof of a finished build on this target as on the others. A failed
// step leaves its scratch files for inspection.
export function writeWasm(outputPath FilePath, coreModule ByteArray, tools WasmComponentTools) throws WasmComponentError
	let corePath = outputPath.changeExtension(WasmCoreExtension)
	let embedPath = outputPath.changeExtension(WasmEmbedExtension)
	let componentPath = outputPath.changeExtension(WasmComponentExtension)

	// A failed core write returns without wrapping: `outputPath` stays absent, and
	// `Compiler.requireOutputWritten` turns that absence into the build's failure, as for every writer.
	try File.writeBinary(corePath, content: coreModule) otherwise 'coreWriteFailed'
		logError(LogCategory.binary, message: function() gives "Failed to write wasm core module: {corePath}")
		return
	end 'coreWriteFailed'

	try runWasmTool(tools, step: "component embed", arguments: ["component", "embed", tools.witDir.toString(), corePath.toString(), "-o", embedPath.toString(), "--world", "maxon:app/command", "--features", "cli-exit-with-code"])
	try runWasmTool(tools, step: "component new", arguments: ["component", "new", embedPath.toString(), "-o", componentPath.toString()])

	try File.rename(componentPath, to: outputPath) otherwise 'publishFailed'
		// The two ends want opposite investigations: a tool that exited 0 having written nothing is not a
		// lock on the output.
		if not File.exists(componentPath) 'noComponent'
			throw WasmComponentError.noComponentProduced(componentPath, outputPath: outputPath)
		end 'noComponent'

		throw WasmComponentError.notPublished(componentPath, outputPath: outputPath)
	end 'publishFailed'

	// A delete failure is ignored: litter is not worth failing a finished build over.
	try File.delete(embedPath) otherwise ignore
	try File.delete(corePath) otherwise ignore
end 'writeWasm'

function runWasmTool(tools WasmComponentTools, step String, arguments StringArray) throws WasmComponentError
	let result = try Subprocess.run(Executable.path(tools.wasmTools), arguments: arguments, workingDirectory: Directory.currentPath()) otherwise (err) 'didNotRun'
		throw WasmComponentError.stepDidNotRun(step, reason: err.displayReason())
	end 'didNotRun'

	if not result.succeeded() 'failed'
		throw WasmComponentError.stepFailed(step, exitCode: result.exitCode() as ToolExitCode, stderr: result.stderr)
	end 'failed'
end 'runWasmTool'
