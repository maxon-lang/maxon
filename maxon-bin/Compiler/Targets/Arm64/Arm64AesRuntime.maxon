let Arm64AesWordBytes = 4
let Arm64AesLongKeyWords = 8
let Arm64AesLongKeyMidWord = 4
let Arm64AesRotateOneByte = 1

let Arm64AesStateVector = 0
let Arm64AesKeyVector = 1
let Arm64AesSpareVector = 2
let Arm64AesZeroVector = 3
let Arm64AesCtrKeyVector = 16
let Arm64AesCtrDataVector = 17

enum Arm64VectorTransfer
	load
	store
end 'Arm64VectorTransfer'

function emitArm64VectorTransfer(asm Arm64RuntimeAsm, transfer Arm64VectorTransfer, vector MachineWord, base Arm64Register, byteOffset MachineWord)
	let opcode = match transfer 'transfer'
		load gives Arm64OpLdrQ
		store gives Arm64OpStrQ
	end 'transfer'

	arm64EmitScaledMem(asm.code, opcode: opcode, rt: vector, baseReg: arm64RuntimeReg(base), byteOffset: byteOffset, scale: AesBlockBytes)
end 'emitArm64VectorTransfer'

function emitArm64AesRoundAcross(asm Arm64RuntimeAsm, round MachineWord, mix MachineWord, mixes bool, states FullRangeInt, key MachineWord)
	for state in 0 upto states 'eachState'
		emitArm64Rr(asm.code, opcode: round, rd: state as MachineWord, rn: key)

		if mixes 'mixes'
			emitArm64Rr(asm.code, opcode: mix, rd: state as MachineWord, rn: state as MachineWord)
		end 'mixes'
	end 'eachState'
end 'emitArm64AesRoundAcross'

function emitArm64AesRoundPair(asm Arm64RuntimeAsm, round MachineWord, mix MachineWord, states FullRangeInt, key MachineWord, keys Arm64Register)
	for index in 0 upto 2 'eachRound'
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: key, base: keys, byteOffset: (index * AesBlockBytes) as MachineWord)
		emitArm64AesRoundAcross(asm, round: round, mix: mix, mixes: true, states: states, key: key)
	end 'eachRound'

	arm64EmitAddRuntimeImm(asm, dest: keys, base: keys, imm: AesRoundPairBytes)
end 'emitArm64AesRoundPair'

function emitArm64AesRounds(asm Arm64RuntimeAsm, round MachineWord, mix MachineWord, states FullRangeInt, key MachineWord, keys Arm64Register, rounds Arm64Register)
	let from192 = asm.newLabel()
	let from128 = asm.newLabel()

	arm64EmitCmpRuntimeImm(asm, reg: rounds, imm: AesMediumRounds)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: from128)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: from192)

	emitArm64AesRoundPair(asm, round: round, mix: mix, states: states, key: key, keys: keys)

	asm.placeLabel(from192)
	emitArm64AesRoundPair(asm, round: round, mix: mix, states: states, key: key, keys: keys)

	asm.placeLabel(from128)

	for index in 0 upto AesFullRoundsBeforeLast 'eachRound'
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: key, base: keys, byteOffset: (index * AesBlockBytes) as MachineWord)
		emitArm64AesRoundAcross(asm, round: round, mix: mix, mixes: true, states: states, key: key)
	end 'eachRound'

	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: key, base: keys, byteOffset: (AesFullRoundsBeforeLast * AesBlockBytes) as MachineWord)
	emitArm64AesRoundAcross(asm, round: round, mix: mix, mixes: false, states: states, key: key)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: key, base: keys, byteOffset: ((AesFullRoundsBeforeLast + 1) * AesBlockBytes) as MachineWord)

	for state in 0 upto states 'eachFinal'
		emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: state as MachineWord, rn: state as MachineWord, rm: key)
	end 'eachFinal'
end 'emitArm64AesRounds'

// Takes the round count, the round keys, the destination and the source in x0 to x3. The block chunks
// use x0 to x7 and v0 to v3 and the counter-mode chunks x0 to x7, v0 to v7, v16 and v17. The
// Galois-mode chunks use x0 to x15, v0 to v7 and v16 to v29. None keeps a stack, and all of those
// are caller-saved, so they preserve d8 to d15.
function buildArm64AesBlockChunk(name ByteArray, round MachineWord, mix MachineWord) returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()

	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64AesStateVector, base: Arm64Register.x3, byteOffset: 0)
	emitArm64AesRounds(asm, round: round, mix: mix, states: 1, key: Arm64AesKeyVector, keys: Arm64Register.x1, rounds: Arm64Register.x0)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64AesStateVector, base: Arm64Register.x2, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(name)
end 'buildArm64AesBlockChunk'

export function buildArm64AesEncryptBlockChunk() returns FunctionCodeChunk
	return buildArm64AesBlockChunk(AesEncryptBlockChunkName, round: Arm64OpAese, mix: Arm64OpAesmc)
end 'buildArm64AesEncryptBlockChunk'

export function buildArm64AesDecryptBlockChunk() returns FunctionCodeChunk
	return buildArm64AesBlockChunk(AesDecryptBlockChunkName, round: Arm64OpAesd, mix: Arm64OpAesimc)
end 'buildArm64AesDecryptBlockChunk'

export function buildArm64AesCtrChunk(blocks AesCtrGroupBlocks) returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let blockCount = blocks as FullRangeInt
	let control = Arm64Register.x0
	let keys = Arm64Register.x1
	let counterBlock = Arm64Register.x2
	let buffer = Arm64Register.x3
	let rounds = Arm64Register.x4
	let counter = Arm64Register.x5
	let walker = Arm64Register.x6
	let scratch = Arm64Register.x7

	arm64EmitMovRuntimeImm(asm, dest: rounds, value: AesControlRoundsMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: rounds, lhs: control, rhs: rounds)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(control), rn: arm64RuntimeReg(control), sh: AesControlFieldShift)
	arm64EmitLoadWord32At(asm, dest: counter, base: counterBlock, byteOffset: (AesBlockBytes - AesCtrCounterWordBytes) as MachineWord)
	emitArm64Rr(asm.code, opcode: Arm64OpRevW, rd: arm64RuntimeReg(counter), rn: arm64RuntimeReg(counter))
	arm64EmitAddRuntimeReg(asm, dest: counter, lhs: counter, rhs: control)

	for index in 0 upto blockCount 'eachCounter'
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: index as MachineWord, base: counterBlock, byteOffset: 0)
		arm64EmitAddRuntimeImm(asm, dest: scratch, base: counter, imm: index as Imm32)
		emitArm64Rr(asm.code, opcode: Arm64OpRevW, rd: arm64RuntimeReg(scratch), rn: arm64RuntimeReg(scratch))
		emitArm64Rr(asm.code, opcode: Arm64OpInsWordFromGpr, rd: index as MachineWord, rn: arm64RuntimeReg(scratch))
	end 'eachCounter'

	arm64EmitMovRuntimeReg(asm, dest: walker, src: keys)
	emitArm64AesRounds(asm, round: Arm64OpAese, mix: Arm64OpAesmc, states: blockCount, key: Arm64AesCtrKeyVector, keys: walker, rounds: rounds)

	for index in 0 upto blockCount 'eachBlock'
		let byteOffset = (index * AesBlockBytes) as MachineWord
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64AesCtrDataVector, base: buffer, byteOffset: byteOffset)
		emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64AesCtrDataVector, rn: Arm64AesCtrDataVector, rm: index as MachineWord)
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64AesCtrDataVector, base: buffer, byteOffset: byteOffset)
	end 'eachBlock'

	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(cryptoChunkName(aesCtrRoutine(blocks)))
end 'buildArm64AesCtrChunk'

// SubWord of x4 as `aese` against a zero key on the word repeated four times: ShiftRows leaves four
// identical columns unchanged, so only SubBytes acts.
function emitArm64SubWord(asm Arm64RuntimeAsm, rotates bool)
	emitArm64Rr(asm.code, opcode: Arm64OpDupWordsFromGpr, rd: Arm64AesKeyVector, rn: arm64RuntimeReg(Arm64Register.x4))
	emitArm64Rr(asm.code, opcode: Arm64OpAese, rd: Arm64AesKeyVector, rn: Arm64AesZeroVector)

	if rotates 'rotates'
		emitArm64Rrr(asm.code, opcode: Arm64OpExtVec16b or (Arm64AesRotateOneByte shl Arm64ExtImmShift), rd: Arm64AesKeyVector, rn: Arm64AesKeyVector, rm: Arm64AesKeyVector)
	end 'rotates'

	emitArm64Rr(asm.code, opcode: Arm64OpUmovWord, rd: arm64RuntimeReg(Arm64Register.x6), rn: Arm64AesKeyVector)
end 'emitArm64SubWord'

function emitArm64ExpandVariant(asm Arm64RuntimeAsm, rounds FullRangeInt)
	let keyWords = rounds - AesRoundsOverKeyWords
	let totalWords = (rounds + 1) * 4
	var roundConstant = AesFirstRoundConstant as MachineWord

	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64AesZeroVector, rn: Arm64AesZeroVector, rm: Arm64AesZeroVector)

	for index in 0 upto keyWords 'copyKey'
		arm64EmitLoadWord32At(asm, dest: Arm64Register.x5, base: Arm64Register.x1, byteOffset: (index * Arm64AesWordBytes) as MachineWord)
		arm64EmitStoreWord32At(asm, src: Arm64Register.x5, base: Arm64Register.x2, byteOffset: (index * Arm64AesWordBytes) as MachineWord)
	end 'copyKey'

	arm64EmitLoadWord32At(asm, dest: Arm64Register.x4, base: Arm64Register.x2, byteOffset: ((keyWords - 1) * Arm64AesWordBytes) as MachineWord)

	for word in keyWords upto totalWords 'eachWord'
		arm64EmitLoadWord32At(asm, dest: Arm64Register.x5, base: Arm64Register.x2, byteOffset: ((word - keyWords) * Arm64AesWordBytes) as MachineWord)

		let phase = try (word mod keyWords) otherwise panic("emitArm64ExpandVariant: a key of at least four words has no zero modulus")

		if phase == 0 'roundStart'
			emitArm64SubWord(asm, rotates: true)
			arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x7, value: roundConstant)
			arm64EmitRuntimeRrr(asm, opcode: Arm64OpEor, dest: Arm64Register.x6, lhs: Arm64Register.x6, rhs: Arm64Register.x7)
			arm64EmitRuntimeRrr(asm, opcode: Arm64OpEor, dest: Arm64Register.x4, lhs: Arm64Register.x5, rhs: Arm64Register.x6)
			roundConstant = nextAesRoundConstant(roundConstant)
		end 'roundStart' else if keyWords == Arm64AesLongKeyWords and phase == Arm64AesLongKeyMidWord 'midSubstitution'
			emitArm64SubWord(asm, rotates: false)
			arm64EmitRuntimeRrr(asm, opcode: Arm64OpEor, dest: Arm64Register.x4, lhs: Arm64Register.x5, rhs: Arm64Register.x6)
		end 'midSubstitution' else 'plain'
			arm64EmitRuntimeRrr(asm, opcode: Arm64OpEor, dest: Arm64Register.x4, lhs: Arm64Register.x5, rhs: Arm64Register.x4)
		end 'plain'

		arm64EmitStoreWord32At(asm, src: Arm64Register.x4, base: Arm64Register.x2, byteOffset: (word * Arm64AesWordBytes) as MachineWord)
	end 'eachWord'

	for round in 0 to rounds 'eachScheduleKey'
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64AesSpareVector, base: Arm64Register.x2, byteOffset: ((rounds - round) * AesBlockBytes) as MachineWord)

		if round != 0 and round != rounds 'middle'
			emitArm64Rr(asm.code, opcode: Arm64OpAesimc, rd: Arm64AesSpareVector, rn: Arm64AesSpareVector)
		end 'middle'

		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64AesSpareVector, base: Arm64Register.x3, byteOffset: (round * AesBlockBytes) as MachineWord)
	end 'eachScheduleKey'
end 'emitArm64ExpandVariant'

// Takes the round count, the key, the encryption keys and the decryption keys in x0 to x3.
export function buildArm64AesExpandKeyChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let from192 = asm.newLabel()
	let from128 = asm.newLabel()
	let done = asm.newLabel()

	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: AesMediumRounds)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: from128)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: from192)

	emitArm64ExpandVariant(asm, rounds: AesLongRounds)
	arm64EmitBranchTo(asm, label: done)

	asm.placeLabel(from192)
	emitArm64ExpandVariant(asm, rounds: AesMediumRounds)
	arm64EmitBranchTo(asm, label: done)

	asm.placeLabel(from128)
	emitArm64ExpandVariant(asm, rounds: AesShortRounds)

	asm.placeLabel(done)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(AesExpandKeyChunkName)
end 'buildArm64AesExpandKeyChunk'

let Arm64GcmAcc0 = 16
let Arm64GcmAcc1 = 17
let Arm64GcmAccM = 18
let Arm64GcmT0 = 19
let Arm64GcmT1 = 20
let Arm64GcmT2 = 21
let Arm64GcmT3 = 22
let Arm64GcmPoly = 23
let Arm64GcmZero = 24
let Arm64GcmInc = 25
let Arm64GcmCtr = 26
let Arm64GcmKey = 27
let Arm64GcmLoaded = 28
let Arm64GcmHashed = 29
let Arm64GcmOctetBlocks = 8
let Arm64GcmOctetBytes = 128
let Arm64GcmPairBytes = 32
let Arm64GcmHashSubkeyEntry = 14
let Arm64GcmPowerCount = 7
let Arm64GcmCountdownStep = 1
let Arm64GcmCounterStep = 1
let Arm64GcmPolyLow = 1
let Arm64GcmScheduleBlocksOverRounds = 1
let Arm64GcmPolyHighByte = 0xC2
let Arm64GcmPolyShift = 56
let Arm64GcmSignShift = 63
let Arm64GcmDoubleShift = 1
let Arm64GcmLengthBitsShift = 3
let Arm64GcmHalfBlockBytes = 8
let Arm64GcmLaneLow = 0
let Arm64GcmLaneHigh = 1
let Arm64GcmExtHalf = Arm64OpExtVec16b or (Arm64GcmHalfBlockBytes shl Arm64ExtImmShift)
let Arm64GcmCounterWordOffset = AesBlockBytes - AesCtrCounterWordBytes
let Arm64GcmControl = Arm64Register.x0
let Arm64GcmTable = Arm64Register.x1
let Arm64GcmMessage = Arm64Register.x2
let Arm64GcmBuffer = Arm64Register.x3
let Arm64GcmLength = Arm64Register.x4
let Arm64GcmRounds = Arm64Register.x5
let Arm64GcmWalker = Arm64Register.x6
let Arm64GcmScratch = Arm64Register.x7
let Arm64GcmKeys = Arm64Register.x8
let Arm64GcmCounterTemp = Arm64Register.x10
let Arm64GcmTailAccumulator = Arm64Register.x7
let Arm64GcmTailPointer = Arm64Register.x9
let Arm64GcmTailLow = Arm64Register.x11
let Arm64GcmTailHigh = Arm64Register.x12
let Arm64GcmTailShift = Arm64Register.x13
let Arm64GcmTailTemp = Arm64Register.x14
let Arm64GcmTailRest = Arm64Register.x15
let Arm64GcmRunBytes = Arm64Register.x12
let Arm64GcmRunPowers = Arm64Register.x13
let Arm64GcmWordBytes = 8
let Arm64GcmByteBits = 8
let Arm64GcmByteBitsShift = 3
let Arm64GcmPartialWordMask = 7
let Arm64GcmMaskSeed = 1
let Arm64GcmMaskBorrow = -1
let Arm64GcmMaskZero = 0
let Arm64GcmPartialBlockMax = AesBlockBytes - 1

enum Arm64GcmBlockSource
	registers
	memory
end 'Arm64GcmBlockSource'

enum Arm64GcmCopyWidth
	dword
	half
	byte
end 'Arm64GcmCopyWidth'

function arm64GcmCopyWidthBytes(width Arm64GcmCopyWidth) returns FullRangeInt
	return match width 'width'
		dword gives 4
		half gives 2
		byte gives 1
	end 'width'
end 'arm64GcmCopyWidthBytes'

function arm64GcmCopyLoadOpcode(width Arm64GcmCopyWidth) returns MachineWord
	return match width 'width'
		dword gives Arm64OpLdrW
		half gives Arm64OpLdrH
		byte gives Arm64OpLdrB
	end 'width'
end 'arm64GcmCopyLoadOpcode'

function arm64GcmCopyStoreOpcode(width Arm64GcmCopyWidth) returns MachineWord
	return match width 'width'
		dword gives Arm64OpStrW
		half gives Arm64OpStrH
		byte gives Arm64OpStrB
	end 'width'
end 'arm64GcmCopyStoreOpcode'

function emitArm64GcmAndImm(asm Arm64RuntimeAsm, dest Arm64Register, lhs Arm64Register, value MachineWord)
	arm64EmitLogicalImm(asm.code, opcode: Arm64OpAndImm, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(lhs), value: value)
end 'emitArm64GcmAndImm'

function emitArm64GcmLoadPartialWord(asm Arm64RuntimeAsm, dest Arm64Register)
	arm64EmitMovRuntimeImm(asm, dest: dest, value: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmTailShift, value: 0)

	for width in Arm64GcmCopyWidth.allCases 'eachWidth'
		let bytes = arm64GcmCopyWidthBytes(width)
		let skip = asm.newLabel()

		emitArm64GcmAndImm(asm, dest: Arm64GcmTailTemp, lhs: Arm64GcmTailRest, value: bytes as MachineWord)
		arm64EmitCbzTo(asm, reg: Arm64GcmTailTemp, label: skip)
		arm64EmitScaledMem(asm.code, opcode: arm64GcmCopyLoadOpcode(width), rt: arm64RuntimeReg(Arm64GcmTailTemp), baseReg: arm64RuntimeReg(Arm64GcmTailPointer), byteOffset: 0, scale: bytes as MachineWord)
		emitArm64Rrr(asm.code, opcode: Arm64OpLslv, rd: arm64RuntimeReg(Arm64GcmTailTemp), rn: arm64RuntimeReg(Arm64GcmTailTemp), rm: arm64RuntimeReg(Arm64GcmTailShift))
		arm64EmitRuntimeRrr(asm, opcode: Arm64OpOrr, dest: dest, lhs: dest, rhs: Arm64GcmTailTemp)
		arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailPointer, base: Arm64GcmTailPointer, imm: bytes as Imm32)
		arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailShift, base: Arm64GcmTailShift, imm: (bytes * Arm64GcmByteBits) as Imm32)
		asm.placeLabel(skip)
	end 'eachWidth'
end 'emitArm64GcmLoadPartialWord'

// Loads exactly `count` bytes, fewer than 16, zero-extended into `vector`: a partial block ends at the
// span, so a wider load would read past the end of the array.
function emitArm64GcmLoadTail(asm Arm64RuntimeAsm, vector MachineWord, source Arm64Register, count Arm64Register)
	let small = asm.newLabel()

	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmTailPointer, src: source)
	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmTailRest, src: count)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmTailLow, value: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmTailHigh, value: 0)
	arm64EmitCmpRuntimeImm(asm, reg: count, imm: Arm64GcmWordBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: small)
	arm64EmitLoadWord64At(asm, dest: Arm64GcmTailLow, base: Arm64GcmTailPointer, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailPointer, base: Arm64GcmTailPointer, imm: Arm64GcmWordBytes)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailRest, base: Arm64GcmTailRest, imm: -Arm64GcmWordBytes)

	asm.placeLabel(small)
	emitArm64GcmLoadPartialWord(asm, dest: Arm64GcmTailAccumulator)
	arm64EmitCmpRuntimeImm(asm, reg: count, imm: Arm64GcmWordBytes)
	arm64EmitCsel(asm.code, dest: arm64RuntimeReg(Arm64GcmTailHigh), ifTrue: arm64RuntimeReg(Arm64GcmTailAccumulator), ifFalse: arm64RuntimeReg(Arm64GcmTailHigh), cond: Arm64CondCode.hs)
	arm64EmitCsel(asm.code, dest: arm64RuntimeReg(Arm64GcmTailLow), ifTrue: arm64RuntimeReg(Arm64GcmTailLow), ifFalse: arm64RuntimeReg(Arm64GcmTailAccumulator), cond: Arm64CondCode.hs)
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneLow), rd: vector, rn: arm64RuntimeReg(Arm64GcmTailLow))
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneHigh), rd: vector, rn: arm64RuntimeReg(Arm64GcmTailHigh))
end 'emitArm64GcmLoadTail'

function emitArm64GcmStoreTail(asm Arm64RuntimeAsm, vector MachineWord, destination Arm64Register, count Arm64Register)
	let small = asm.newLabel()

	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmTailPointer, src: destination)
	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmTailRest, src: count)
	emitArm64Rr(asm.code, opcode: arm64UmovDwordOpcode(Arm64GcmLaneLow), rd: arm64RuntimeReg(Arm64GcmTailLow), rn: vector)
	emitArm64Rr(asm.code, opcode: arm64UmovDwordOpcode(Arm64GcmLaneHigh), rd: arm64RuntimeReg(Arm64GcmTailHigh), rn: vector)
	arm64EmitCmpRuntimeImm(asm, reg: count, imm: Arm64GcmWordBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: small)
	arm64EmitStoreWord64At(asm, src: Arm64GcmTailLow, base: Arm64GcmTailPointer, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailPointer, base: Arm64GcmTailPointer, imm: Arm64GcmWordBytes)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailRest, base: Arm64GcmTailRest, imm: -Arm64GcmWordBytes)
	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmTailLow, src: Arm64GcmTailHigh)

	asm.placeLabel(small)

	for width in Arm64GcmCopyWidth.allCases 'eachWidth'
		let bytes = arm64GcmCopyWidthBytes(width)
		let skip = asm.newLabel()

		emitArm64GcmAndImm(asm, dest: Arm64GcmTailTemp, lhs: Arm64GcmTailRest, value: bytes as MachineWord)
		arm64EmitCbzTo(asm, reg: Arm64GcmTailTemp, label: skip)
		arm64EmitScaledMem(asm.code, opcode: arm64GcmCopyStoreOpcode(width), rt: arm64RuntimeReg(Arm64GcmTailLow), baseReg: arm64RuntimeReg(Arm64GcmTailPointer), byteOffset: 0, scale: bytes as MachineWord)
		arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailPointer, base: Arm64GcmTailPointer, imm: bytes as Imm32)
		arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64GcmTailLow), rn: arm64RuntimeReg(Arm64GcmTailLow), sh: (bytes * Arm64GcmByteBits) as ShiftCount)
		asm.placeLabel(skip)
	end 'eachWidth'
end 'emitArm64GcmStoreTail'

// Clears the bytes of `vector` from `count` on, since GHASH reads a partial block zero-padded. Each lane
// mask is `(1 shl bits) - 1`, and a variable shift takes its amount modulo 64, so a lane that is entirely
// kept gets an all-ones mask from the `csel` rather than from a shift.
function emitArm64GcmMaskTail(asm Arm64RuntimeAsm, vector MachineWord, count Arm64Register)
	emitArm64Rr(asm.code, opcode: arm64UmovDwordOpcode(Arm64GcmLaneLow), rd: arm64RuntimeReg(Arm64GcmTailLow), rn: vector)
	emitArm64Rr(asm.code, opcode: arm64UmovDwordOpcode(Arm64GcmLaneHigh), rd: arm64RuntimeReg(Arm64GcmTailHigh), rn: vector)
	emitArm64GcmAndImm(asm, dest: Arm64GcmTailTemp, lhs: count, value: Arm64GcmPartialWordMask as MachineWord)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64GcmTailTemp), rn: arm64RuntimeReg(Arm64GcmTailTemp), sh: Arm64GcmByteBitsShift)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmTailShift, value: Arm64GcmMaskSeed)
	emitArm64Rrr(asm.code, opcode: Arm64OpLslv, rd: arm64RuntimeReg(Arm64GcmTailShift), rn: arm64RuntimeReg(Arm64GcmTailShift), rm: arm64RuntimeReg(Arm64GcmTailTemp))
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailShift, base: Arm64GcmTailShift, imm: Arm64GcmMaskBorrow)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmTailTemp, value: Arm64GcmMaskZero)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailTemp, base: Arm64GcmTailTemp, imm: Arm64GcmMaskBorrow)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmTailRest, value: Arm64GcmMaskZero)
	arm64EmitCmpRuntimeImm(asm, reg: count, imm: Arm64GcmWordBytes)
	arm64EmitCsel(asm.code, dest: arm64RuntimeReg(Arm64GcmTailTemp), ifTrue: arm64RuntimeReg(Arm64GcmTailTemp), ifFalse: arm64RuntimeReg(Arm64GcmTailShift), cond: Arm64CondCode.hs)
	arm64EmitCsel(asm.code, dest: arm64RuntimeReg(Arm64GcmTailRest), ifTrue: arm64RuntimeReg(Arm64GcmTailShift), ifFalse: arm64RuntimeReg(Arm64GcmTailRest), cond: Arm64CondCode.hs)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64GcmTailLow, lhs: Arm64GcmTailLow, rhs: Arm64GcmTailTemp)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64GcmTailHigh, lhs: Arm64GcmTailHigh, rhs: Arm64GcmTailRest)
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneLow), rd: vector, rn: arm64RuntimeReg(Arm64GcmTailLow))
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneHigh), rd: vector, rn: arm64RuntimeReg(Arm64GcmTailHigh))
end 'emitArm64GcmMaskTail'

function emitArm64GcmConstants(asm Arm64RuntimeAsm)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmScratch, value: Arm64GcmPolyHighByte)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64GcmScratch), rn: arm64RuntimeReg(Arm64GcmScratch), sh: Arm64GcmPolyShift)
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneLow), rd: Arm64GcmPoly, rn: arm64RuntimeReg(Arm64GcmScratch))
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmScratch, value: Arm64GcmPolyLow)
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneHigh), rd: Arm64GcmPoly, rn: arm64RuntimeReg(Arm64GcmScratch))
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmZero, rn: Arm64GcmZero, rm: Arm64GcmZero)
end 'emitArm64GcmConstants'

function emitArm64GcmReduce(asm Arm64RuntimeAsm)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAccM, rn: Arm64GcmAccM, rm: Arm64GcmAcc0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAccM, rn: Arm64GcmAccM, rm: Arm64GcmAcc1)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmT0, rn: Arm64GcmAccM, rm: Arm64GcmZero)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmAccM, rn: Arm64GcmZero, rm: Arm64GcmAccM)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: Arm64GcmAccM)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc1, rn: Arm64GcmAcc1, rm: Arm64GcmT0)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull, rd: Arm64GcmT0, rn: Arm64GcmAcc0, rm: Arm64GcmPoly)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: Arm64GcmAcc0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: Arm64GcmT0)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull, rd: Arm64GcmT0, rn: Arm64GcmAcc0, rm: Arm64GcmPoly)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc1, rn: Arm64GcmAcc1, rm: Arm64GcmT0)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmAcc1, rn: Arm64GcmAcc1, rm: Arm64GcmAcc1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: Arm64GcmAcc1)
end 'emitArm64GcmReduce'

function emitArm64GcmLoadPair(asm Arm64RuntimeAsm, pair FullRangeInt)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmT1, base: Arm64GcmTable, byteOffset: (pair * Arm64GcmPairBytes) as MachineWord)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmT2, base: Arm64GcmTable, byteOffset: (pair * Arm64GcmPairBytes + AesBlockBytes) as MachineWord)
end 'emitArm64GcmLoadPair'

function emitArm64GcmFirstProducts(asm Arm64RuntimeAsm, block MachineWord)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmT0, rn: block, rm: block)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmT0, rn: block, rm: Arm64GcmT0)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull, rd: Arm64GcmAcc1, rn: block, rm: Arm64GcmT1)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull2, rd: Arm64GcmAcc0, rn: block, rm: Arm64GcmT1)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull, rd: Arm64GcmAccM, rn: Arm64GcmT0, rm: Arm64GcmT2)
end 'emitArm64GcmFirstProducts'

function emitArm64GcmAccumulateSwapped(asm Arm64RuntimeAsm, block MachineWord)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmT0, rn: block, rm: block)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmT0, rn: block, rm: Arm64GcmT0)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull, rd: Arm64GcmT3, rn: block, rm: Arm64GcmT1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc1, rn: Arm64GcmAcc1, rm: Arm64GcmT3)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull2, rd: Arm64GcmT3, rn: block, rm: Arm64GcmT1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: Arm64GcmT3)
	emitArm64Rrr(asm.code, opcode: Arm64OpPmull, rd: Arm64GcmT3, rn: Arm64GcmT0, rm: Arm64GcmT2)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAccM, rn: Arm64GcmAccM, rm: Arm64GcmT3)
end 'emitArm64GcmAccumulateSwapped'

function emitArm64GcmAccumulate(asm Arm64RuntimeAsm, block MachineWord, pair FullRangeInt)
	emitArm64GcmLoadPair(asm, pair: pair)
	emitArm64Rr(asm.code, opcode: Arm64OpRev64Vec16b, rd: block, rn: block)
	emitArm64GcmAccumulateSwapped(asm, block: block)
end 'emitArm64GcmAccumulate'

function emitArm64GcmHashRun(asm Arm64RuntimeAsm)
	let loop = asm.newLabel()
	let accumulator = 1

	emitArm64Rrr(asm.code, opcode: Arm64OpOrrVec16b, rd: accumulator, rn: Arm64GcmAcc0, rm: Arm64GcmAcc0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: Arm64GcmAcc0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc1, rn: Arm64GcmAcc1, rm: Arm64GcmAcc1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAccM, rn: Arm64GcmAccM, rm: Arm64GcmAccM)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64GcmTailTemp), rn: arm64RuntimeReg(Arm64GcmRunBytes), sh: Arm64GcmDoubleShift)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmRunPowers, value: AesGcmTableBytes)
	arm64EmitSubRuntimeReg(asm, dest: Arm64GcmRunPowers, lhs: Arm64GcmRunPowers, rhs: Arm64GcmTailTemp)
	arm64EmitAddRuntimeReg(asm, dest: Arm64GcmRunPowers, lhs: Arm64GcmRunPowers, rhs: Arm64GcmTable)

	asm.placeLabel(loop)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: 0, base: Arm64GcmTailPointer, byteOffset: 0)
	emitArm64Rr(asm.code, opcode: Arm64OpRev64Vec16b, rd: 0, rn: 0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: 0, rn: 0, rm: accumulator)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: accumulator, rn: accumulator, rm: accumulator)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmT1, base: Arm64GcmRunPowers, byteOffset: 0)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmT2, base: Arm64GcmRunPowers, byteOffset: AesBlockBytes as MachineWord)
	emitArm64GcmAccumulateSwapped(asm, block: 0)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmTailPointer, base: Arm64GcmTailPointer, imm: AesBlockBytes)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmRunPowers, base: Arm64GcmRunPowers, imm: Arm64GcmPairBytes)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmRunBytes, base: Arm64GcmRunBytes, imm: -AesBlockBytes)
	arm64EmitCbnzTo(asm, reg: Arm64GcmRunBytes, label: loop)
	emitArm64GcmReduce(asm)
end 'emitArm64GcmHashRun'

function emitArm64GcmHashBlock(asm Arm64RuntimeAsm, block MachineWord)
	emitArm64Rr(asm.code, opcode: Arm64OpRev64Vec16b, rd: block, rn: block)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: block, rn: block, rm: Arm64GcmAcc0)
	emitArm64GcmFirstProducts(asm, block: block)
	emitArm64GcmReduce(asm)
end 'emitArm64GcmHashBlock'

function emitArm64GcmHashOctet(asm Arm64RuntimeAsm, source Arm64GcmBlockSource, base Arm64Register)
	for index in 0 upto Arm64GcmOctetBlocks 'eachBlock'
		var block = index as MachineWord

		if source == Arm64GcmBlockSource.memory 'fromMemory'
			block = Arm64GcmHashed
			emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: block, base: base, byteOffset: (index * AesBlockBytes) as MachineWord)
		end 'fromMemory'

		if index == 0 'first'
			emitArm64GcmLoadPair(asm, pair: 0)
			emitArm64Rr(asm.code, opcode: Arm64OpRev64Vec16b, rd: block, rn: block)
			emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: block, rn: block, rm: Arm64GcmAcc0)
			emitArm64GcmFirstProducts(asm, block: block)
		end 'first' else 'later'
			emitArm64GcmAccumulate(asm, block: block, pair: index)
		end 'later'
	end 'eachBlock'

	emitArm64GcmReduce(asm)
end 'emitArm64GcmHashOctet'

export function buildArm64AesGcmHashChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let octets = asm.newLabel()
	let singles = asm.newLabel()
	let singlesLoop = asm.newLabel()
	let tail = asm.newLabel()
	let done = asm.newLabel()

	emitArm64GcmConstants(asm)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	arm64EmitCbzTo(asm, reg: Arm64GcmControl, label: done)

	asm.placeLabel(octets)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmControl, imm: Arm64GcmOctetBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: singles)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmControl, base: Arm64GcmControl, imm: -Arm64GcmOctetBytes)

	for index in 0 upto Arm64GcmOctetBlocks 'eachLoad'
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: index as MachineWord, base: Arm64GcmBuffer, byteOffset: (index * AesBlockBytes) as MachineWord)
	end 'eachLoad'

	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmBuffer, base: Arm64GcmBuffer, imm: Arm64GcmOctetBytes)
	emitArm64GcmHashOctet(asm, source: Arm64GcmBlockSource.registers, base: Arm64GcmBuffer)
	arm64EmitBranchTo(asm, label: octets)

	asm.placeLabel(singles)
	emitArm64GcmLoadPair(asm, pair: Arm64GcmHashSubkeyEntry shr 1)

	asm.placeLabel(singlesLoop)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmControl, imm: AesBlockBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: tail)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmControl, base: Arm64GcmControl, imm: -AesBlockBytes)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: 0, base: Arm64GcmBuffer, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmBuffer, base: Arm64GcmBuffer, imm: AesBlockBytes)
	emitArm64GcmHashBlock(asm, block: 0)
	arm64EmitBranchTo(asm, label: singlesLoop)

	asm.placeLabel(tail)
	arm64EmitCbzTo(asm, reg: Arm64GcmControl, label: done)
	emitArm64GcmLoadTail(asm, vector: 0, source: Arm64GcmBuffer, count: Arm64GcmControl)
	emitArm64GcmHashBlock(asm, block: 0)

	asm.placeLabel(done)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(cryptoChunkName(CryptoRoutine.aesGcmHash))
end 'buildArm64AesGcmHashChunk'

export function buildArm64AesGcmFinishChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let additionalBytes = Arm64GcmControl
	let ciphertextBytes = Arm64GcmBuffer

	emitArm64GcmConstants(asm)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: 1, base: Arm64GcmMessage, byteOffset: AesGcmMaskOffset as MachineWord)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(additionalBytes), rn: arm64RuntimeReg(additionalBytes), sh: Arm64GcmLengthBitsShift)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(ciphertextBytes), rn: arm64RuntimeReg(ciphertextBytes), sh: Arm64GcmLengthBitsShift)
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneLow), rd: 0, rn: arm64RuntimeReg(additionalBytes))
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneHigh), rd: 0, rn: arm64RuntimeReg(ciphertextBytes))
	emitArm64GcmLoadPair(asm, pair: Arm64GcmHashSubkeyEntry shr 1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: 0, rn: 0, rm: Arm64GcmAcc0)
	emitArm64GcmFirstProducts(asm, block: 0)
	emitArm64GcmReduce(asm)
	emitArm64Rr(asm.code, opcode: Arm64OpRev64Vec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc0, rn: Arm64GcmAcc0, rm: 1)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(cryptoChunkName(CryptoRoutine.aesGcmFinish))
end 'buildArm64AesGcmFinishChunk'

function emitArm64GcmStorePowerPair(asm Arm64RuntimeAsm, power MachineWord, base Arm64Register, byteOffset MachineWord)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: power, base: base, byteOffset: byteOffset)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmT0, rn: power, rm: power)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmT0, rn: Arm64GcmT0, rm: power)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64GcmT0, base: base, byteOffset: byteOffset + AesBlockBytes)
end 'emitArm64GcmStorePowerPair'

export function buildArm64AesGcmInitChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let rounds = Arm64GcmControl
	let schedule = Arm64GcmMessage
	let copied = Arm64GcmKeys
	let blocksLeft = Arm64GcmCounterTemp
	let copy = asm.newLabel()
	let loop = asm.newLabel()
	let iterations = Arm64GcmLength
	let hash = 0

	emitArm64GcmConstants(asm)
	arm64EmitAddRuntimeImm(asm, dest: copied, base: Arm64GcmTable, imm: AesGcmTableBytes)
	arm64EmitAddRuntimeImm(asm, dest: blocksLeft, base: rounds, imm: Arm64GcmScheduleBlocksOverRounds)

	asm.placeLabel(copy)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: hash, base: schedule, byteOffset: 0)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: hash, base: copied, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: schedule, base: schedule, imm: AesBlockBytes)
	arm64EmitAddRuntimeImm(asm, dest: copied, base: copied, imm: AesBlockBytes)
	arm64EmitAddRuntimeImm(asm, dest: blocksLeft, base: blocksLeft, imm: -Arm64GcmCountdownStep)
	arm64EmitCbnzTo(asm, reg: blocksLeft, label: copy)

	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmWalker, base: Arm64GcmTable, imm: AesGcmTableBytes)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: hash, rn: hash, rm: hash)
	emitArm64AesRounds(asm, round: Arm64OpAese, mix: Arm64OpAesmc, states: 1, key: Arm64GcmKey, keys: Arm64GcmWalker, rounds: rounds)
	emitArm64Rr(asm.code, opcode: Arm64OpRev64Vec16b, rd: hash, rn: hash)

	emitArm64Rr(asm.code, opcode: arm64UmovDwordOpcode(Arm64GcmLaneLow), rd: arm64RuntimeReg(Arm64GcmScratch), rn: hash)
	arm64EmitAsrImm(asm.code, rd: arm64RuntimeReg(Arm64GcmScratch), rn: arm64RuntimeReg(Arm64GcmScratch), sh: Arm64GcmSignShift)
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneLow), rd: Arm64GcmT1, rn: arm64RuntimeReg(Arm64GcmScratch))
	emitArm64Rr(asm.code, opcode: arm64InsDwordOpcode(Arm64GcmLaneHigh), rd: Arm64GcmT1, rn: arm64RuntimeReg(Arm64GcmScratch))
	emitArm64Rrr(asm.code, opcode: Arm64OpAndVec16b, rd: Arm64GcmT1, rn: Arm64GcmT1, rm: Arm64GcmPoly)
	emitArm64Rr(asm.code, opcode: arm64UshrDwordsOpcode(Arm64GcmSignShift), rd: Arm64GcmT2, rn: hash)
	emitArm64Rrr(asm.code, opcode: Arm64GcmExtHalf, rd: Arm64GcmT2, rn: Arm64GcmT2, rm: Arm64GcmZero)
	emitArm64Rr(asm.code, opcode: arm64ShlDwordsOpcode(Arm64GcmDoubleShift), rd: hash, rn: hash)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: hash, rn: hash, rm: Arm64GcmT1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: hash, rn: hash, rm: Arm64GcmT2)

	emitArm64GcmStorePowerPair(asm, power: hash, base: Arm64GcmTable, byteOffset: (Arm64GcmHashSubkeyEntry * AesBlockBytes) as MachineWord)
	arm64EmitAddRuntimeImm(asm, dest: copied, base: Arm64GcmTable, imm: ((Arm64GcmHashSubkeyEntry - 2) * AesBlockBytes) as Imm32)
	arm64EmitMovRuntimeImm(asm, dest: iterations, value: Arm64GcmPowerCount)

	asm.placeLabel(loop)
	arm64EmitAddRuntimeImm(asm, dest: iterations, base: iterations, imm: -Arm64GcmCountdownStep)
	emitArm64GcmLoadPair(asm, pair: Arm64GcmHashSubkeyEntry shr 1)
	emitArm64GcmFirstProducts(asm, block: hash)
	emitArm64GcmReduce(asm)
	emitArm64Rrr(asm.code, opcode: Arm64OpOrrVec16b, rd: hash, rn: Arm64GcmAcc0, rm: Arm64GcmAcc0)
	emitArm64GcmStorePowerPair(asm, power: hash, base: copied, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: copied, base: copied, imm: -Arm64GcmPairBytes)
	arm64EmitCbnzTo(asm, reg: iterations, label: loop)

	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(cryptoChunkName(CryptoRoutine.aesGcmInit))
end 'buildArm64AesGcmInitChunk'

function emitArm64GcmCryptSetup(asm Arm64RuntimeAsm)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64GcmLength), rn: arm64RuntimeReg(Arm64GcmControl), sh: AesControlFieldShift)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmRounds, value: AesControlRoundsMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64GcmRounds, lhs: Arm64GcmControl, rhs: Arm64GcmRounds)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmKeys, base: Arm64GcmTable, imm: AesGcmTableBytes)
	emitArm64GcmConstants(asm)

	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAcc1, rn: Arm64GcmAcc1, rm: Arm64GcmAcc1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmAccM, rn: Arm64GcmAccM, rm: Arm64GcmAccM)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmCtr, base: Arm64GcmMessage, byteOffset: AesGcmCounterOffset as MachineWord)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: Arm64GcmInc, rn: Arm64GcmInc, rm: Arm64GcmInc)
	arm64EmitMovRuntimeImm(asm, dest: Arm64GcmScratch, value: Arm64GcmCounterStep)
	emitArm64Rr(asm.code, opcode: Arm64OpInsWordFromGpr, rd: Arm64GcmInc, rn: arm64RuntimeReg(Arm64GcmScratch))

	arm64EmitLoadWord32At(asm, dest: Arm64GcmScratch, base: Arm64GcmMessage, byteOffset: (AesGcmCounterOffset + Arm64GcmCounterWordOffset) as MachineWord)
	emitArm64Rr(asm.code, opcode: Arm64OpRevW, rd: arm64RuntimeReg(Arm64GcmScratch), rn: arm64RuntimeReg(Arm64GcmScratch))
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmCounterTemp, base: Arm64GcmLength, imm: Arm64GcmPartialBlockMax)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64GcmCounterTemp), rn: arm64RuntimeReg(Arm64GcmCounterTemp), sh: AesBlockShift)
	arm64EmitAddRuntimeReg(asm, dest: Arm64GcmScratch, lhs: Arm64GcmScratch, rhs: Arm64GcmCounterTemp)
	emitArm64Rr(asm.code, opcode: Arm64OpRevW, rd: arm64RuntimeReg(Arm64GcmScratch), rn: arm64RuntimeReg(Arm64GcmScratch))
	arm64EmitStoreWord32At(asm, src: Arm64GcmScratch, base: Arm64GcmMessage, byteOffset: (AesGcmCounterOffset + Arm64GcmCounterWordOffset) as MachineWord)

	emitArm64Rr(asm.code, opcode: Arm64OpRev32Vec16b, rd: Arm64GcmCtr, rn: Arm64GcmCtr)
	emitArm64Rrr(asm.code, opcode: Arm64OpAddVec4s, rd: Arm64GcmCtr, rn: Arm64GcmCtr, rm: Arm64GcmInc)
end 'emitArm64GcmCryptSetup'

function emitArm64GcmNextCounter(asm Arm64RuntimeAsm, block MachineWord)
	emitArm64Rr(asm.code, opcode: Arm64OpRev32Vec16b, rd: block, rn: Arm64GcmCtr)
	emitArm64Rrr(asm.code, opcode: Arm64OpAddVec4s, rd: Arm64GcmCtr, rn: Arm64GcmCtr, rm: Arm64GcmInc)
end 'emitArm64GcmNextCounter'

function emitArm64GcmEncipher(asm Arm64RuntimeAsm, states FullRangeInt)
	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmWalker, src: Arm64GcmKeys)
	emitArm64AesRounds(asm, round: Arm64OpAese, mix: Arm64OpAesmc, states: states, key: Arm64GcmKey, keys: Arm64GcmWalker, rounds: Arm64GcmRounds)
end 'emitArm64GcmEncipher'

function emitArm64GcmEightBlocks(asm Arm64RuntimeAsm)
	for index in 0 upto Arm64GcmOctetBlocks 'eachBlock'
		emitArm64GcmNextCounter(asm, block: index as MachineWord)
	end 'eachBlock'

	emitArm64GcmEncipher(asm, states: Arm64GcmOctetBlocks)
end 'emitArm64GcmEightBlocks'

// GHASH covers the ciphertext. Decrypting therefore hashes the whole blocks before the loop's in-place
// XOR overwrites them with plaintext, and the tail from the register it was loaded into; encrypting
// hashes both after.
function emitArm64GcmSingleBlockLoop(asm Arm64RuntimeAsm, decrypting bool, done BlockId)
	let loop = asm.newLabel()
	let tail = asm.newLabel()

	arm64EmitCbzTo(asm, reg: Arm64GcmLength, label: done)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmLength, imm: AesBlockBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: tail)
	arm64EmitMovRuntimeReg(asm, dest: Arm64GcmTailPointer, src: Arm64GcmBuffer)

	if decrypting 'hashesTheInput'
		arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64GcmRunBytes), rn: arm64RuntimeReg(Arm64GcmLength), sh: AesBlockShift)
		arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64GcmRunBytes), rn: arm64RuntimeReg(Arm64GcmRunBytes), sh: AesBlockShift)
		emitArm64GcmHashRun(asm)
	end 'hashesTheInput' else 'countsTheOutput'
		arm64EmitMovRuntimeImm(asm, dest: Arm64GcmRunBytes, value: 0)
	end 'countsTheOutput'

	asm.placeLabel(loop)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmLength, base: Arm64GcmLength, imm: -AesBlockBytes)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmLoaded, base: Arm64GcmBuffer, byteOffset: 0)
	emitArm64GcmNextCounter(asm, block: 0)
	emitArm64GcmEncipher(asm, states: 1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: 0, rn: 0, rm: Arm64GcmLoaded)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: 0, base: Arm64GcmBuffer, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmBuffer, base: Arm64GcmBuffer, imm: AesBlockBytes)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmRunBytes, base: Arm64GcmRunBytes, imm: AesBlockBytes)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmLength, imm: AesBlockBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.hs, label: loop)

	if not decrypting 'hashesTheOutput'
		emitArm64GcmHashRun(asm)
	end 'hashesTheOutput'

	asm.placeLabel(tail)
	emitArm64GcmLoadPair(asm, pair: Arm64GcmHashSubkeyEntry shr 1)
	arm64EmitCbzTo(asm, reg: Arm64GcmLength, label: done)
	emitArm64GcmLoadTail(asm, vector: Arm64GcmLoaded, source: Arm64GcmBuffer, count: Arm64GcmLength)
	emitArm64GcmNextCounter(asm, block: 0)
	emitArm64GcmEncipher(asm, states: 1)
	emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: 0, rn: 0, rm: Arm64GcmLoaded)
	emitArm64GcmStoreTail(asm, vector: 0, destination: Arm64GcmBuffer, count: Arm64GcmLength)

	if decrypting 'hashesTheInputTail'
		emitArm64GcmHashBlock(asm, block: Arm64GcmLoaded)
	end 'hashesTheInputTail' else 'hashesTheOutputTail'
		emitArm64GcmMaskTail(asm, vector: 0, count: Arm64GcmLength)
		emitArm64GcmHashBlock(asm, block: 0)
	end 'hashesTheOutputTail'
end 'emitArm64GcmSingleBlockLoop'

export function buildArm64AesGcmEncryptChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let octets = asm.newLabel()
	let singles = asm.newLabel()
	let done = asm.newLabel()

	emitArm64GcmCryptSetup(asm)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmLength, imm: Arm64GcmOctetBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: singles)

	asm.placeLabel(octets)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmLength, base: Arm64GcmLength, imm: -Arm64GcmOctetBytes)
	emitArm64GcmEightBlocks(asm)

	for pair in 0 upto Arm64GcmOctetBlocks shr 1 'eachPair'
		let byteOffset = (pair * Arm64GcmPairBytes) as MachineWord
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmT1, base: Arm64GcmBuffer, byteOffset: byteOffset)
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmT2, base: Arm64GcmBuffer, byteOffset: byteOffset + AesBlockBytes)
		emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: (pair * 2) as MachineWord, rn: (pair * 2) as MachineWord, rm: Arm64GcmT1)
		emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: (pair * 2 + 1) as MachineWord, rn: (pair * 2 + 1) as MachineWord, rm: Arm64GcmT2)
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: (pair * 2) as MachineWord, base: Arm64GcmBuffer, byteOffset: byteOffset)
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: (pair * 2 + 1) as MachineWord, base: Arm64GcmBuffer, byteOffset: byteOffset + AesBlockBytes)
	end 'eachPair'

	emitArm64GcmHashOctet(asm, source: Arm64GcmBlockSource.registers, base: Arm64GcmBuffer)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmBuffer, base: Arm64GcmBuffer, imm: Arm64GcmOctetBytes)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmLength, imm: Arm64GcmOctetBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.hs, label: octets)

	asm.placeLabel(singles)
	emitArm64GcmSingleBlockLoop(asm, decrypting: false, done: done)

	asm.placeLabel(done)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(cryptoChunkName(CryptoRoutine.aesGcmEncrypt))
end 'buildArm64AesGcmEncryptChunk'

export function buildArm64AesGcmDecryptChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginRawFunction()
	let octets = asm.newLabel()
	let singles = asm.newLabel()
	let done = asm.newLabel()

	emitArm64GcmCryptSetup(asm)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmLength, imm: Arm64GcmOctetBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lo, label: singles)

	asm.placeLabel(octets)
	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmLength, base: Arm64GcmLength, imm: -Arm64GcmOctetBytes)
	emitArm64GcmEightBlocks(asm)
	emitArm64GcmHashOctet(asm, source: Arm64GcmBlockSource.memory, base: Arm64GcmBuffer)

	for index in 0 upto Arm64GcmOctetBlocks 'eachBlock'
		let byteOffset = (index * AesBlockBytes) as MachineWord
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.load, vector: Arm64GcmLoaded, base: Arm64GcmBuffer, byteOffset: byteOffset)
		emitArm64Rrr(asm.code, opcode: Arm64OpEorVec16b, rd: index as MachineWord, rn: index as MachineWord, rm: Arm64GcmLoaded)
		emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: index as MachineWord, base: Arm64GcmBuffer, byteOffset: byteOffset)
	end 'eachBlock'

	arm64EmitAddRuntimeImm(asm, dest: Arm64GcmBuffer, base: Arm64GcmBuffer, imm: Arm64GcmOctetBytes)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64GcmLength, imm: Arm64GcmOctetBytes)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.hs, label: octets)

	asm.placeLabel(singles)
	emitArm64GcmSingleBlockLoop(asm, decrypting: true, done: done)

	asm.placeLabel(done)
	emitArm64VectorTransfer(asm, transfer: Arm64VectorTransfer.store, vector: Arm64GcmAcc0, base: Arm64GcmMessage, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitRet(asm.code)

	return asm.finishChunk(cryptoChunkName(CryptoRoutine.aesGcmDecrypt))
end 'buildArm64AesGcmDecryptChunk'
