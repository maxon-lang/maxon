// Arm64FaultRuntime — the emitted program's HARDWARE-FAULT path on arm64, hand-assembled into `.text`:
// the signal handler a trap enters, the diagnostic it prints, and the install `mrt_start` runs before
// any user code.
//
//     panic: nil pointer or invalid memory access at rip=0x… diag_base=0x…
//     Stack trace:
//       in maxon_force_segfault
//       in main
//       in mrt_start
//
// ⭐ **IT IS THE arm64 HALF OF ONE DIAGNOSTIC, NOT A SECOND DIAGNOSTIC.** The words, the two address
// tags, the hex format, the 64 MiB stack window and the `mrt_` names all come from
// `Targets/Shared/BacktraceFormat`, which x64's fault path reads too; the frames come from
// `Arm64PanicRuntime`'s walker and frame printer, which the software panic shares. What is written HERE
// is only what a hardware fault on AArch64 makes different: how the OS delivers it, and where the
// faulting PC/SP/FP are read from.
//
// ⭐ **NO CONTEXT REDIRECT, NO FAULT GLOBALS, NO RE-ENTRANCY GUARD** — `X64Runtime`'s three deliberate
// absences, for its reasons. Rewriting `mcontext->__ss.{pc,sp,fp}` to resume on a separate diagnostic
// function is what a handler needs in order to survive a STACK OVERFLOW whose own stack cannot be
// printed on. This handler prints on the spot and exits, so the context it read is the only
// context it needs and the faulting frames stay exactly as they are.
//
// ⚠ **TWO OF THE FOUR CHUNKS ARE OS-NEUTRAL AND TWO ARE DARWIN'S — THE HANDLER IS DARWIN'S.**
// `mrt_fault_backtrace` and `mrt_write_hex64` name no OS and an arm64-Linux lane reuses them verbatim,
// as it does `Arm64PanicRuntime`'s walker. `mrt_runtime_init` AND `mrt_fault_handler` are Darwin's
// three times over: the install is a libSystem call where Linux needs `svc`, the handler's terminal
// `exit` is the same GOT call, and its `DarwinUcontextOff*` reads are a layout Linux numbers
// differently. A Linux lane owes its own two, and `appendArm64FaultRuntimeChunks` refuses rather than
// hand it these.

// ⭐ **DOES `os` INSTALL A FAULT HANDLER?** The ONE door, asked by the entry stub (which emits the `bl
// mrt_runtime_init`) and by the chunk appender (which lays `mrt_runtime_init` down). A `bl` to a symbol
// nothing laid out is a link failure rather than a diagnostic, so the two must agree by construction.
export function arm64OsInstallsFaultHandler(os Os) returns bool
	return match os 'installs'
		macos gives true
		linux gives false
		windows panic("arm64OsInstallsFaultHandler: there is no arm64-Windows lane in this compiler — `Target` admits the pair only through `arm64OsCallKind`'s two OSes")
		wasi panic("arm64OsInstallsFaultHandler: `wasm32-wasi` is not an arm64 lane — a WASI component takes a wasm trap, not a signal")
	end 'installs'
end 'arm64OsInstallsFaultHandler'

// ⭐⭐ **DOES THIS PROGRAM CALL `mrt_runtime_init` BEFORE USER CODE?** The entry stub emits the `bl` and the
// chunk appender lays the chunk down, so one question answers both — a `bl` to a symbol nothing laid out is
// a link failure rather than a diagnostic.
//
// ⭐ **TWO REASONS TO HAVE AN INSTALL AND EITHER IS ENOUGH**: a fault handler, which every lane that has one
// registers unconditionally, and the preemption signal, which only a program that runs green threads has a
// sender for.
export function arm64RunsRuntimeInit(target Target, usesGt bool) returns bool
	return arm64OsInstallsFaultHandler(target.os) or programInstallsPreemptSignal(target, usesGt: usesGt)
end 'arm64RunsRuntimeInit'

// mrt_write_hex64(x0 = value) — `HexDigitsPerWord` zero-padded lowercase hex digits, formatted into a
// frame buffer and handed to `mrt_write_cstr_stderr` so the whole field costs one `write`, not sixteen.
//
// ⚠ **CONSTANT SHIFTS ONLY, WHERE x64 SHIFTS BY A VARIABLE COUNT.** The value is consumed from the TOP:
// `lsr #HexTopDigitShift` leaves the top nibble alone with nothing to mask off, and the value is shifted
// left by one digit for the next round. AArch64's variable-shift form would need the count in its own
// register and the result masked.
//
// Slots: 0.. = the output buffer. Nothing is live across the one call, which is the last instruction.
function buildArm64WriteHexChunk() returns FunctionCodeChunk
	let SlotBuffer = 0 as StackSize
	let bufferSlots = alignUp(HexBufferBytes, alignment: SpillSlotBytes) / SpillSlotBytes
	var asm = Arm64RuntimeAsm.beginFunction(bufferSlots as StackSize)

	let loop = asm.newLabel()
	let isDigit = asm.newLabel()
	let store = asm.newLabel()
	let loopDone = asm.newLabel()

	// x1 = the value being consumed, x2 = the write cursor, x3 = digits remaining, x4 = the nibble.
	arm64EmitMovRuntimeReg(asm, dest: Arm64Register.x1, src: Arm64Register.x0)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x2, slot: SlotBuffer)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: HexDigitsPerWord)

	asm.placeLabel(loop)
	arm64EmitCbzTo(asm, reg: Arm64Register.x3, label: loopDone)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x3, base: Arm64Register.x3, imm: -1)

	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x4), rn: arm64RuntimeReg(Arm64Register.x1), sh: HexTopDigitShift as ShiftCount)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x1), rn: arm64RuntimeReg(Arm64Register.x1), sh: HexBitsPerDigit as ShiftCount)

	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x4, imm: HexDigitTen)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lt, label: isDigit)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x4, base: Arm64Register.x4, imm: HexAsciiLowerAMinusTen)
	arm64EmitBranchTo(asm, label: store)

	asm.placeLabel(isDigit)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x4, base: Arm64Register.x4, imm: HexAsciiZero)

	asm.placeLabel(store)
	arm64EmitStoreByte(asm, src: Arm64Register.x4, base: Arm64Register.x2)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x2, base: Arm64Register.x2, imm: 1)
	arm64EmitBranchTo(asm, label: loop)

	// The cursor is one past the last digit, which is exactly where the terminator belongs.
	asm.placeLabel(loopDone)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x4, value: NulByte as MachineWord)
	arm64EmitStoreByte(asm, src: Arm64Register.x4, base: Arm64Register.x2)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x0, slot: SlotBuffer)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: WriteStderrName)

	return asm.finishFunction(WriteHexName)
end 'buildArm64WriteHexChunk'

// mrt_fault_backtrace(x0 = fault_pc, x1 = fault_fp, x2 = fault_sp) — `Stack trace:` and a symbolized
// backtrace for a hardware fault. The arm64 twin of `X64Runtime.buildFaultBacktraceChunk`.
//
// ⚠ **FRAME 0 IS SYMBOLIZED FROM `fault_pc` WITH NO BIAS.** A fault PC already points AT the trapping
// instruction, where a RETURN address points past its call and needs `ReturnAddrSymbolBias` — which is
// why this cannot simply seed the walker one frame lower. Frames 1..N come from the walker, seeded from
// `fault_fp` with `fault_sp` as the lowest address it believes.
//
// Slots: 0 = fault_pc, 1 = fault_fp, 2 = fault_sp, 3 = text_base, 4 = symtable.
function buildArm64FaultBacktraceChunk(globalData GlobalDataTable) returns FunctionCodeChunk
	let SlotFaultPc = 0 as StackSize
	let SlotFaultFp = 1 as StackSize
	let SlotFaultSp = 2 as StackSize
	let SlotTextBase = 3 as StackSize
	let SlotSymtable = 4 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(5)

	let walk = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotFaultPc)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotFaultFp)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: SlotFaultSp)

	arm64EmitPrintConstant(asm, globalData: globalData, bytes: BacktraceHeader)

	arm64EmitLeaRuntimeFuncAddr(asm, dest: Arm64Register.x0, funcName: EntryPointName)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotTextBase)
	arm64EmitLeaRuntimeFuncAddr(asm, dest: Arm64Register.x0, funcName: SymbolTableName)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotSymtable)

	// Frame 0. A fault whose PC is in a system library has no local symbol, so the bounds guard skips it
	// and the trace starts at the frame chain instead.
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotFaultPc)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: SlotTextBase)
	arm64EmitSubRuntimeReg(asm, dest: Arm64Register.x1, lhs: Arm64Register.x1, rhs: Arm64Register.x2)
	arm64EmitTextBoundsGuard(asm, offsetReg: Arm64Register.x1, scratchA: Arm64Register.x3, scratchB: Arm64Register.x4, textBaseSlot: SlotTextBase, symtableSlot: SlotSymtable, rejectLabel: walk)

	arm64EmitMovRuntimeReg(asm, dest: Arm64Register.x0, src: Arm64Register.x1)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotSymtable)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: PrintFrameName)

	asm.placeLabel(walk)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotFaultFp)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotFaultSp)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: WalkFramesName)

	return asm.finishFunction(FaultBacktraceName)
end 'buildArm64FaultBacktraceChunk'

// Everything a fault diagnostic prints AFTER its opening words: the two ADDRESSES that recover the ASLR
// slide (`at rip=0x` is already open when this is called), and the backtrace under them. Over the same
// shared tags as `X64Runtime.emitFaultAddressesAndBacktrace`, so the two lanes' lines cannot drift.
function arm64EmitFaultAddressesAndBacktrace(asm Arm64RuntimeAsm, globalData GlobalDataTable, pcSlot StackSize, fpSlot StackSize, spSlot StackSize)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: pcSlot)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: WriteHexName)
	arm64EmitPrintConstant(asm, globalData: globalData, bytes: FaultDiagBaseTag)
	arm64EmitLeaRuntimeFuncAddr(asm, dest: Arm64Register.x0, funcName: EntryPointName)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: WriteHexName)
	arm64EmitPrintConstant(asm, globalData: globalData, bytes: FaultLineTerminator)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: pcSlot)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: fpSlot)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: spSlot)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: FaultBacktraceName)
end 'arm64EmitFaultAddressesAndBacktrace'

// ==========================================================================
// The Darwin install and signal entry
// ==========================================================================
//
// ⚠ **EVERY DECLARATION BELOW IS A DARWIN STRUCT LAYOUT OR A DARWIN NUMBER**, transcribed from
// `<sys/_types/_ucontext64.h>`, `<arm/_mcontext.h>` and `<sys/signal.h>`. Linux numbers all of them
// differently, which is why its install is a separate mechanism rather than a second spelling.

// `ucontext_t.uc_mcontext` — a POINTER, after `uc_onstack`, `uc_sigmask`, `uc_stack`, `uc_link` and
// `uc_mcsize`.
export let DarwinUcontextOffMcontext = 0x30 as MachineWord

// The registers a backtrace and an asynchronous stop need, relative to `mcontext64`. `__ss` (the thread
// state) begins at +0x10, past the 16-byte `__es` exception state; within it the 29 general registers run
// first, then `__fp`, `__lr`, `__sp` and `__pc`. MEASURED by a C probe over the real headers: 0xF8, 0x100,
// 0x108, 0x110. EXPORTED for the preemption handler, which rewrites three of them
// (`Arm64GtRuntime.buildArm64PreemptHandlerChunk`).
let DarwinMcontextOffSsFp = 0xF8 as MachineWord
export let DarwinMcontextOffSsLr = 0x100 as MachineWord
export let DarwinMcontextOffSsSp = 0x108 as MachineWord
export let DarwinMcontextOffSsPc = 0x110 as MachineWord

// ⭐⭐ **THE STRUCT `_sigaction` TAKES IS THE 16-BYTE `struct sigaction`, NOT THE 24-BYTE `__sigaction`.**
// `MachOWriter.machoImportSymbol` binds the libc WRAPPER, and the wrapper supplies the trampoline itself —
// so the struct handed to it carries no `sa_tramp` and its flag word sits at 12, not at 20.
//
// ⛔ **THE FLAG WORD'S POSITION IS LOAD-BEARING TWICE OVER.** `SA_SIGINFO` is what gives a handler the
// `ucontext` it reads its registers out of, and `SA_ONSTACK` is what makes the kernel switch to the
// `sigaltstack` before entering one — so a flag word written past the struct leaves both unset while the
// install still SUCCEEDS, and the first signal enters a handler with a garbage third argument on a green
// thread's few kilobytes.
//
// MEASURED on the lane, by a C probe over the real headers: `sizeof(struct sigaction)` is 16,
// `offsetof(sa_mask)` 8 and `offsetof(sa_flags)` 12.
let DarwinSigactionOffHandler = 0x00 as MachineWord
let DarwinSigactionOffMask = 0x08 as MachineWord
let DarwinSigactionOffFlags = 0x0C as MachineWord
let DarwinSigactionBytes = 16 as StackSize

// `stack_t`: `ss_sp` (8), `ss_size` (8), `ss_flags` (a C `int`).
let DarwinSigstackOffSp = 0x00 as MachineWord
let DarwinSigstackOffSize = 0x08 as MachineWord
let DarwinSigstackOffFlags = 0x10 as MachineWord

// `SA_SIGINFO` gives the handler its third argument (the ucontext), which is the only thing that carries
// the faulting PC. `SA_ONSTACK` switches the kernel to the thread's `__signal_stack_install` stack.
// `SA_RESTART` resumes an interrupted slow system call rather than failing it — inert for a handler that
// never returns, and part of the flag word installed here.
let DarwinSaSiginfo = 0x40 as MachineWord
let DarwinSaOnstack = 0x01 as MachineWord
let DarwinSaRestart = 0x02 as MachineWord

// The three signals a hardware fault arrives as. `SIGSEGV` is an unmapped address and `SIGBUS` a mapped
// one the access is illegal for (an alignment fault, a mapping shorter than the file behind it); both
// mean the same thing to a Maxon program, so both classify to `accessViolation`.
let DarwinSignalBus = 10 as Imm32
let DarwinSignalSegv = 11 as Imm32
let DarwinSignalFpe = 8 as Imm32

// ⭐ SIGURG — what an asynchronous preemption is delivered as, and **16 on Darwin where it is 23 on Linux**.
// Go's choice, for its reason: the default disposition is to ignore it and no program in this tree has a
// socket urgent-data notion for a stray one to collide with.
export let DarwinSignalUrg = 16 as Imm32

// The `oldact`/`oss` out-parameter, declined: neither install reads back a previous disposition.
let PosixDeclinePrevious = 0 as MachineWord

// mrt_fault_handler (DARWIN) — `void handler(int sig, siginfo_t *info, void *ucontext)` in x0/x1/x2.
//
// ⚠ **THE ucontext IS READ BEFORE ANY CALL.** x2 is caller-saved and the first `bl` below would lose
// it, so the three registers a backtrace needs are lifted into frame slots first — which is also what
// lets the classification arms print and then converge on one address/backtrace tail. The signal number
// is compared W-form: AAPCS64 leaves bits 63:32 of a C `int` argument unspecified.
//
// ⚠ **IT CANNOT MAKE THE WINDOWS THUNK'S DIVIDE-BY-ZERO / OVERFLOW DISTINCTION, AND ON THIS LANE THAT
// COSTS NOTHING.** A correctly compiled Maxon divide never traps at all — `/` and `mod` throw at the
// language level (`specs/safety.md`) — so a `SIGFPE` here can only be a stray floating-point trap,
// and it reads as the divide-by-zero wording exactly as the x64-Linux handler's does.
//
// Slots: 0 = sig, 1 = fault_pc, 2 = fault_fp, 3 = fault_sp.
function buildArm64DarwinFaultHandlerChunk(globalData GlobalDataTable) returns FunctionCodeChunk
	let SlotSig = 0 as StackSize
	let SlotFaultPc = 1 as StackSize
	let SlotFaultFp = 2 as StackSize
	let SlotFaultSp = 3 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(4)

	let memoryFault = asm.newLabel()
	let arithmeticFault = asm.newLabel()
	let addresses = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotSig)

	arm64EmitLoadWord64At(asm, dest: Arm64Register.x3, base: Arm64Register.x2, byteOffset: DarwinUcontextOffMcontext)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x4, base: Arm64Register.x3, byteOffset: DarwinMcontextOffSsPc)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x4, slot: SlotFaultPc)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x4, base: Arm64Register.x3, byteOffset: DarwinMcontextOffSsFp)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x4, slot: SlotFaultFp)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x4, base: Arm64Register.x3, byteOffset: DarwinMcontextOffSsSp)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x4, slot: SlotFaultSp)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotSig)
	arm64EmitCmpRuntimeImm32(asm, reg: Arm64Register.x0, imm: DarwinSignalSegv)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: memoryFault)
	arm64EmitCmpRuntimeImm32(asm, reg: Arm64Register.x0, imm: DarwinSignalBus)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: memoryFault)
	arm64EmitCmpRuntimeImm32(asm, reg: Arm64Register.x0, imm: DarwinSignalFpe)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: arithmeticFault)

	// `brk #0` — the install below registers this handler for those three signals and nothing else, so
	// falling out of the arms is unreachable. Trapping is the entry stub's answer to the same shape of
	// impossibility, and it is strictly better than printing a fourth signal's fault as one of these.
	arm64EmitBrk(asm.code)

	asm.placeLabel(arithmeticFault)
	arm64EmitPrintConstant(asm, globalData: globalData, bytes: faultPanicLinePrefix(HardwareFaultKind.divideByZero))
	arm64EmitBranchTo(asm, label: addresses)

	asm.placeLabel(memoryFault)
	arm64EmitPrintConstant(asm, globalData: globalData, bytes: faultPanicLinePrefix(HardwareFaultKind.accessViolation))

	asm.placeLabel(addresses)
	arm64EmitFaultAddressesAndBacktrace(asm, globalData: globalData, pcSlot: SlotFaultPc, fpSlot: SlotFaultFp, spSlot: SlotFaultSp)

	// A converted fault is terminal — there is no `recover()` and nowhere to resume to — so the handler
	// exits rather than returning to a faulting instruction the kernel would simply re-execute.
	arm64EmitProcessExit(asm, os: Os.macos, exitCode: PanicExitCode)

	return asm.finishChunk(FaultHandlerName)
end 'buildArm64DarwinFaultHandlerChunk'

// __signal_stack_install — map this OS thread's alternate signal stack and register it, so an `SA_ONSTACK`
// handler runs there rather than on a green thread's stack. Called by `mrt_runtime_init` for the main thread
// and by every worker machine as it is born (`SignalStackInstallName`), under AAPCS64 with no argument.
//
// ⭐ **ONE BODY FOR BOTH POSIX LANES.** The call is a libSystem import on Darwin and an `svc` on Linux, which
// `arm64EmitOsPrimitive` already chooses between; what genuinely differs is where `stack_t` puts its three
// fields, and that is the one thing asked per OS.
//
// ⚠ **A FAILED `mmap` SKIPS THE `sigaltstack` RATHER THAN REGISTERING ITS ANSWER.** `MAP_FAILED` is -1 and a
// raw `svc` answers a negative errno; `sigaltstack` validates only the SIZE — it would accept either address
// happily, and the first signal would then be a kernel stack switch onto it.
//
// Slots: 0..2 = the `stack_t`.
function buildArm64SignalStackInstallChunk(os Os) returns FunctionCodeChunk
	let SlotSigstack = 0 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction((Arm64SigstackBytes / SpillSlotBytes) as StackSize)

	let done = asm.newLabel()

	// mmap(NULL, SignalStackBytes, RW, MAP_ANON|MAP_PRIVATE, -1, 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: MmapKernelChoosesBase)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: SignalStackBytes)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: MmapProtReadWrite)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: mmapAnonPrivateFlags(os))
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x4, value: MmapAnonFd)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x5, value: MmapNoOffset)
	arm64EmitOsPrimitive(asm, os: os, importSlot: OsImportSlot.mmap, syscallNumber: Arm64LinuxSyscallMmap)

	// A mapped page is a positive userspace address, so one signed test rejects both `MAP_FAILED` and a
	// zero answer.
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: 0)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.le, label: done)

	let sigstack = arm64SigstackLayout(os)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x9, slot: SlotSigstack)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: sigstack.sp)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: SignalStackBytes)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x1, base: Arm64Register.x9, byteOffset: sigstack.size)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: 0)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x1, base: Arm64Register.x9, byteOffset: sigstack.flags)

	// sigaltstack(&ss, NULL)
	arm64EmitMovRuntimeReg(asm, dest: Arm64Register.x0, src: Arm64Register.x9)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixDeclinePrevious)
	arm64EmitOsPrimitive(asm, os: os, importSlot: OsImportSlot.sigaltstack, syscallNumber: Arm64LinuxSyscallSigaltstack)

	asm.placeLabel(done)
	return asm.finishFunction(SignalStackInstallName)
end 'buildArm64SignalStackInstallChunk'

// `stack_t` is 24 bytes on both lanes and orders its three fields differently — Darwin puts the SIZE second
// and the flags last, Linux the other way round. One `struct`, two layouts, so each field is asked for.
let Arm64SigstackBytes = 24 as StackSize

// ⭐ **ONE LANE'S `stack_t`, ANSWERED ONCE.** The three fields are one record's layout and a lane that can
// place any of them can place all three — so asking them one at a time was three copies of one `match` and
// three copies of its two refusals.
type Arm64SigstackLayout
	export let sp as MachineWord
	export let size as MachineWord
	export let flags as MachineWord

	static function create(sp MachineWord, size MachineWord, flags MachineWord) returns Self
		return Self{sp: sp, size: size, flags: flags}
	end 'create'
end 'Arm64SigstackLayout'

function arm64SigstackLayout(os Os) returns Arm64SigstackLayout
	return match os 'os'
		macos gives Arm64SigstackLayout.create(DarwinSigstackOffSp, size: DarwinSigstackOffSize, flags: DarwinSigstackOffFlags)
		linux gives Arm64SigstackLayout.create(LinuxStackTOffSp as MachineWord, size: LinuxStackTOffSize as MachineWord, flags: LinuxStackTOffFlags as MachineWord)
		windows panic("arm64SigstackLayout: there is no arm64-Windows lane, and Windows has no `stack_t`")
		wasi panic("arm64SigstackLayout: `wasm32-wasi` is not an arm64 lane and takes no signal")
	end 'os'
end 'arm64SigstackLayout'

// mrt_runtime_init (DARWIN) — register the fault handler for SIGSEGV/SIGBUS/SIGFPE. `mrt_start` calls
// it before `main`, so the very first instruction of user code is already covered.
//
// ⚠ **THE MAIN THREAD's ALTERNATE STACK IS REGISTERED FIRST, AND THAT IS THE ONLY ORDER WITH NO WINDOW IN
// IT.** `SA_ONSTACK` is a promise that a stack exists to switch to, so making the handler reachable before
// providing one leaves an interval in which a fault would enter the kernel's stack switch with nothing
// registered.
//
// Slots: 0..2 = the `struct sigaction`.
function buildArm64DarwinRuntimeInitChunk(usesGt bool, target Target) returns FunctionCodeChunk
	let SlotSigaction = 0 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction((DarwinSigactionBytes / SpillSlotBytes) as StackSize)

	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: SignalStackInstallName)

	arm64EmitSlotAddr(asm, dest: Arm64Register.x9, slot: SlotSigaction)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitStoreWord32At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: DarwinSigactionOffMask)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: DarwinSaSiginfo or DarwinSaOnstack or DarwinSaRestart)
	arm64EmitStoreWord32At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: DarwinSigactionOffFlags)

	arm64EmitDarwinSigactionInstall(asm, handlerName: FaultHandlerName, signal: DarwinSignalSegv, actSlot: SlotSigaction)
	arm64EmitDarwinSigactionCall(asm, signal: DarwinSignalBus, actSlot: SlotSigaction)
	arm64EmitDarwinSigactionCall(asm, signal: DarwinSignalFpe, actSlot: SlotSigaction)

	// ⭐ **THE PREEMPTION SIGNAL SHARES THE STRUCT AND DIFFERS ONLY IN ITS HANDLER**, so the one field that
	// differs is stored again rather than a second struct being built.
	if programInstallsPreemptSignal(target, usesGt: usesGt) 'itCanStopAThread'
		arm64EmitDarwinSigactionInstall(asm, handlerName: PreemptHandlerName, signal: DarwinSignalUrg, actSlot: SlotSigaction)
	end 'itCanStopAThread'

	return asm.finishFunction(RuntimeInitName)
end 'buildArm64DarwinRuntimeInitChunk'

// Publish `handlerName` for `signal` through the struct already standing in `actSlot`.
function arm64EmitDarwinSigactionInstall(asm Arm64RuntimeAsm, handlerName ByteArray, signal Imm32, actSlot StackSize)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x9, slot: actSlot)
	arm64EmitLeaRuntimeFuncAddr(asm, dest: Arm64Register.x0, funcName: handlerName)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: DarwinSigactionOffHandler)
	arm64EmitDarwinSigactionCall(asm, signal: signal, actSlot: actSlot)
end 'arm64EmitDarwinSigactionInstall'

// `sigaction(signal, &act, NULL)`.
//
// ⚠ **`&act` IS RE-DERIVED PER CALL RATHER THAN HELD.** AAPCS64 makes x9..x15 caller-saved temporaries,
// so libSystem is free to clobber whatever register the address was parked in; an `add` off x29 costs
// one instruction and cannot be wrong.
function arm64EmitDarwinSigactionCall(asm Arm64RuntimeAsm, signal Imm32, actSlot StackSize)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: signal as MachineWord)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x1, slot: actSlot)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixDeclinePrevious)
	arm64DarwinCallImport(asm, slot: OsImportSlot.sigaction)
end 'arm64EmitDarwinSigactionCall'

// ==========================================================================
// The Linux install
// ==========================================================================

// ⭐⭐ **THE KERNEL'S `struct sigaction`, WHICH IS NOT libc's.** `rt_sigaction` takes `sa_handler`, then
// `sa_flags`, then the mask; AArch64 declares no `SA_RESTORER`, so there is no fourth field here and none of
// x86-64's mandatory restorer (`X64Runtime.buildLinuxRuntimeInitChunk` carries that lane's shape). VERIFIED
// on the lane: this struct, through syscall 134, installs a handler that really receives a `ucontext` and
// really runs on the alternate stack.
let Arm64LinuxSigactionOffHandler = 0x00 as MachineWord
let Arm64LinuxSigactionOffFlags = 0x08 as MachineWord
let Arm64LinuxSigactionOffMask = 0x10 as MachineWord
let Arm64LinuxSigactionSlots = 3 as StackSize

// mrt_runtime_init (LINUX) — publish the preemption signal's handler. This lane installs no FAULT handler
// (`arm64OsInstallsFaultHandler` says so), so SIGURG is the whole of what it registers and a hardware fault
// keeps its default disposition.
//
// ⚠ **THE MAIN THREAD's ALTERNATE STACK IS REGISTERED FIRST, AND THAT IS THE ONLY ORDER WITH NO WINDOW IN
// IT** — `SA_ONSTACK` is a promise that a stack exists to switch to.
//
// Slots: 0..2 = the `struct sigaction`, ascending from the lowest, so `&act` is slot 0's address.
function buildArm64LinuxRuntimeInitChunk() returns FunctionCodeChunk
	let SlotSigaction = 0 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(Arm64LinuxSigactionSlots)

	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: SignalStackInstallName)

	arm64EmitSlotAddr(asm, dest: Arm64Register.x9, slot: SlotSigaction)
	arm64EmitLeaRuntimeFuncAddr(asm, dest: Arm64Register.x0, funcName: PreemptHandlerName)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: Arm64LinuxSigactionOffHandler)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: Arm64LinuxSigactionFlags)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: Arm64LinuxSigactionOffFlags)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x9, byteOffset: Arm64LinuxSigactionOffMask)

	// rt_sigaction(SIGURG, &act, NULL, sizeof(kernel sigset_t)) — the kernel checks the size even when the
	// old disposition is declined.
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: LinuxSignalUrg as MachineWord)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x1, slot: SlotSigaction)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: LinuxSigsetBytes)
	arm64EmitSyscall(asm.code, number: Arm64LinuxSyscallRtSigaction)

	return asm.finishFunction(RuntimeInitName)
end 'buildArm64LinuxRuntimeInitChunk'

// ==========================================================================
// Assembly
// ==========================================================================

// Append the arm64 lane's SIGNAL INSTALLS and, where there is one, its fault path. Called AFTER the panic
// runtime, whose walker, frame printer and stderr writer every chunk here calls by name.
//
// ⭐ INSTALLED UNCONDITIONALLY on the lane that has a fault handler, exactly as x64's is and for x64's
// reason: "can this program fault" is not a question the encode phase can answer, and the cost is a few
// hundred bytes of `.text` plus one `SignalStackBytes` alternate stack per thread that installs one. The
// PREEMPTION signal is different — it is installed only for a program that runs green threads, because
// nothing else ever sends it.
//
// ⛔ **THE PER-OS HALF IS A `match`, NOT A FALL-THROUGH AFTER THE BOOLEAN GATE.** Each lane's install reads
// its own struct layout and reaches the kernel its own way, and an arm that inherited the other's would be
// a `sigaction` GOT call in an ELF image or a raw `svc` in a Mach-O one.
export function appendArm64FaultRuntimeChunks(chunks FunctionCodeChunkArray, globalData GlobalDataTable, usesGt bool, target Target)
	if not arm64RunsRuntimeInit(target, usesGt: usesGt) 'nothingToInstall'
		return
	end 'nothingToInstall'

	match target.os 'installLane'
		macos then appendArm64DarwinFaultChunks(chunks, globalData: globalData, usesGt: usesGt, target: target)
		linux then appendArm64LinuxSignalChunks(chunks, os: target.os)
		windows then panic("appendArm64FaultRuntimeChunks: there is no arm64-Windows lane in this compiler — `Target` admits the pair only through `arm64OsCallKind`'s two OSes")
		wasi then panic("appendArm64FaultRuntimeChunks: `wasm32-wasi` is not an arm64 lane — a WASI component takes a wasm trap, not a signal")
	end 'installLane'

	// The OS-NEUTRAL half: the diagnostic body a fault handler tail-calls into. A lane whose install exists
	// only for the preemption signal has no fault handler, and so no caller for either of these.
	if arm64OsInstallsFaultHandler(target.os) 'theFaultPath'
		chunks.push(buildArm64FaultBacktraceChunk(globalData))
		chunks.push(buildArm64WriteHexChunk())
	end 'theFaultPath'
end 'appendArm64FaultRuntimeChunks'

// macOS's three: the `sigaction` install, the per-thread `sigaltstack` install it and every worker machine
// call, and the signal entry that reads Darwin's ucontext.
function appendArm64DarwinFaultChunks(chunks FunctionCodeChunkArray, globalData GlobalDataTable, usesGt bool, target Target)
	chunks.push(buildArm64DarwinRuntimeInitChunk(usesGt, target: target))
	chunks.push(buildArm64SignalStackInstallChunk(Os.macos))
	chunks.push(buildArm64DarwinFaultHandlerChunk(globalData))
end 'appendArm64DarwinFaultChunks'

// Linux's two. It has no fault handler at all — `arm64OsInstallsFaultHandler` says so — so this install
// exists for the preemption signal alone, and a lane that grew one would owe a handler and a ucontext read
// of its own here.
function appendArm64LinuxSignalChunks(chunks FunctionCodeChunkArray, os Os)
	if arm64OsInstallsFaultHandler(os) 'aFaultHandlerAppeared'
		panic("appendArm64LinuxSignalChunks: `arm64OsInstallsFaultHandler` now admits `{os.name}`, but this lane installs only the preemption signal — a fault handler here owes its own `mrt_fault_handler` (a different `ucontext` layout from Darwin's, and `svc` rather than a GOT `exit`) and its registration beside SIGURG's")
	end 'aFaultHandlerAppeared'

	chunks.push(buildArm64LinuxRuntimeInitChunk())
	chunks.push(buildArm64SignalStackInstallChunk(os))
end 'appendArm64LinuxSignalChunks'
