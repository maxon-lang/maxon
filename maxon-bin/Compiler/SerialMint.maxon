export typealias MintedSerial = int(0 to u64.max)

export type SerialMint
	var minted as MintedSerial

	export static function create() returns SerialMint
		return Self{minted: 0}
	end 'create'

	export function mint() returns MintedSerial
		self.minted = self.minted + 1

		return self.minted
	end 'mint'
end 'SerialMint'
