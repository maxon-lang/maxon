export enum GenericArgumentKind
	integer
	float
	boolean
	string
	character
	rangedAlias
	record
	enumeration
end 'GenericArgumentKind'

// @generated library-cache begin
let CacheCasesGenericArgumentKind = [GenericArgumentKind.integer, GenericArgumentKind.float, GenericArgumentKind.boolean, GenericArgumentKind.string, GenericArgumentKind.character, GenericArgumentKind.rangedAlias, GenericArgumentKind.record, GenericArgumentKind.enumeration]

function cacheReadGenericArgumentKind(reader LibraryCacheReader) returns GenericArgumentKind throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesGenericArgumentKind.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadGenericArgumentKind'

function cacheTableAgreesGenericArgumentKind() returns bool
	let declared = GenericArgumentKind.allCases

	if CacheCasesGenericArgumentKind.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesGenericArgumentKind.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesGenericArgumentKind'

