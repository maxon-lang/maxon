export type GenericFunctionTemplate
	export let key as ByteArray
	export let declFilePath as FilePath
	export let line as LineNumber
	export let column as ColumnNumber
	export let typeParamNames as ByteArrayArray
	export let paramNames as ByteArrayArray
	export let paramSlots as GenericParamSlotArray
	export let paramTypeParams as TypeParamIndexArray
	export let constraints as WhereConstraintArray
	export let takesReceiver as bool
	export let visibility as Visibility

	export static function create(key ByteArray, declFilePath FilePath, line LineNumber, column ColumnNumber, typeParamNames ByteArrayArray, paramNames ByteArrayArray, paramSlots GenericParamSlotArray, paramTypeParams TypeParamIndexArray, constraints WhereConstraintArray, takesReceiver bool, visibility Visibility) returns Self
		return Self{key: key, declFilePath: declFilePath, line: line, column: column, typeParamNames: typeParamNames, paramNames: paramNames, paramSlots: paramSlots, paramTypeParams: paramTypeParams, constraints: constraints, takesReceiver: takesReceiver, visibility: visibility}
	end 'create'

	export function siteKey() returns ByteArray
		return declarationSiteKey(self.declFilePath, line: self.line, column: self.column)
	end 'siteKey'

	// A template below the program-wide tiers shares its key with every file declaring that name, and two
	// files can hold it at one line and column, so its instances also carry a hash of `declaringFile`:
	// the project-relative path (`ProgramSignatures.projectRelativeFileDisplay`), because two directories
	// can hold files of one name, and relative because the instance name reaches emitted symbols and
	// `TargetIr` pins, which must not depend on the host or the checkout's location.
	export function instanceName(arguments GenericFunctionArgumentArray, declaringFile String) returns ByteArray
		var suffix = "{GenericInstanceSuffixHead}{self.line}_{self.column}"

		if not isProgramWideTier(self.visibility) 'scopedBelowTheProgram'
			suffix = "{suffix}_{mixBytes(Hasher.empty(), bytes: declaringFile.toByteArray())}"
		end 'scopedBelowTheProgram'

		for argument in arguments 'eachArgument'
			suffix = "{suffix}#{String.from(argument.spelling())}"
		end 'eachArgument'

		return overloadRegistrationName(self.key, suffix: suffix.toByteArray())
	end 'instanceName'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.key)
		writer.text(self.declFilePath.toString())
		writer.unsigned(self.line as CacheUnsigned)
		writer.unsigned(self.column as CacheUnsigned)
		cacheWriteByteArrayArray(writer, value: self.typeParamNames)
		cacheWriteByteArrayArray(writer, value: self.paramNames)
		cacheWriteGenericParamSlotArray(writer, value: self.paramSlots)
		cacheWriteTypeParamIndexArray(writer, value: self.paramTypeParams)
		cacheWriteWhereConstraintArray(writer, value: self.constraints)
		writer.flag(self.takesReceiver)
		writer.unsigned(self.visibility.ordinal as CacheUnsigned)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns GenericFunctionTemplate throws LibraryCacheDamage
		let f_key = try reader.bytes()
		let f_declFilePath = try reader.path()
		let f_line = (try reader.unsigned()) as LineNumber
		let f_column = (try reader.unsigned()) as ColumnNumber
		let f_typeParamNames = try cacheReadByteArrayArray(reader)
		let f_paramNames = try cacheReadByteArrayArray(reader)
		let f_paramSlots = try cacheReadGenericParamSlotArray(reader)
		let f_paramTypeParams = try cacheReadTypeParamIndexArray(reader)
		let f_constraints = try cacheReadWhereConstraintArray(reader)
		let f_takesReceiver = try reader.flag()
		let f_visibility = try cacheReadVisibility(reader)

		return Self{key: f_key, declFilePath: f_declFilePath, line: f_line, column: f_column, typeParamNames: f_typeParamNames, paramNames: f_paramNames, paramSlots: f_paramSlots, paramTypeParams: f_paramTypeParams, constraints: f_constraints, takesReceiver: f_takesReceiver, visibility: f_visibility}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize88
		return sizeof(GenericFunctionTemplate) as CacheSize88
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'GenericFunctionTemplate'

