export type GenericFunctionArgument
	export let kind as GenericArgumentKind
	export let name as ByteArray

	export static function create(kind GenericArgumentKind, name ByteArray) returns Self
		return Self{kind: kind, name: name}
	end 'create'

	export function spelling() returns ByteArray
		return match self.kind 'kind'
			integer gives b"int"
			float gives b"float"
			boolean gives b"bool"
			string gives b"String"
			character gives b"Character"
			rangedAlias or
				record or
				enumeration gives self.name
		end 'kind'
	end 'spelling'

	export function sameAs(other GenericFunctionArgument) returns bool
		return self.kind == other.kind and self.name.equals(other.name)
	end 'sameAs'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.kind.ordinal as CacheUnsigned)
		writer.bytes(self.name)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns GenericFunctionArgument throws LibraryCacheDamage
		let f_kind = try cacheReadGenericArgumentKind(reader)
		let f_name = try reader.bytes()

		return Self{kind: f_kind, name: f_name}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(GenericFunctionArgument) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'GenericFunctionArgument'

