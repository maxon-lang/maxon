enum OpenGroupRole
	typeList
	expression
end 'OpenGroupRole'

typealias OpenGroupRoleArray = Array with OpenGroupRole

module type BracketTracker
	var groups as OpenGroupRoleArray
	var prevKind as TokenKind
	var prevQualifiesAType as bool
	var prevIsPrefixOperator as bool
	var lineBrokeSincePrev as bool
	var inTypealiasDeclaration as bool
	var inBareTypeList as bool

	module static function create() returns BracketTracker
		return Self{groups: OpenGroupRoleArray.create(0), prevKind: TokenKind.eof, prevQualifiesAType: false, prevIsPrefixOperator: false, lineBrokeSincePrev: false, inTypealiasDeclaration: false, inBareTypeList: false}
	end 'create'

	module function observe(token Token, nextKind TokenKind)
		let kind = token.kind

		if kind == TokenKind.newline 'statementEnds'
			self.inTypealiasDeclaration = false
			self.inBareTypeList = false
			self.lineBrokeSincePrev = true
			return
		end 'statementEnds'

		if kind == TokenKind.docComment 'prose'
			return
		end 'prose'

		let isQualifier = kind == TokenKind.identifier and self.qualifiesATypeHere(token.value, nextKind: nextKind)

		if tokenKindOpensABracket(kind) 'opensGroup'
			self.groups.push(self.roleOfGroupOpenedBy(kind))
		end 'opensGroup' else if tokenKindClosesABracket(kind) 'closesGroup'
			if self.groups.count() > 0 'notUnbalanced'
				_ = try self.groups.pop() otherwise panic("BracketTracker.observe: a group is open — the count is checked on the line above")
			end 'notUnbalanced'
		end 'closesGroup'

		// A typealias never sits inside a bracket, so clearing here keeps a bracket left unclosed in
		// half-typed code from misclassifying `readonly` in every typealias after it.
		if kind == TokenKind.typealias 'typealiasBegins'
			self.groups.clear()
			self.inTypealiasDeclaration = true
		end 'typealiasBegins' else if kind == TokenKind.with and self.inTypealiasDeclaration and self.groups.count() == 0 'bareTypeListBegins'
			self.inBareTypeList = true
		end 'bareTypeListBegins'

		self.prevQualifiesAType = isQualifier
		self.prevIsPrefixOperator = tokenIsAPrefixOperator(token)
		self.prevKind = kind
		self.lineBrokeSincePrev = false
	end 'observe'

	module function lastQualifiedAType() returns bool
		return self.prevQualifiesAType
	end 'lastQualifiedAType'

	function qualifiesATypeHere(word ByteArray, nextKind TokenKind) returns bool
		if not isTypeQualifierWord(word) or not readonlyOperandStartsWith(nextKind) 'notAQualifier'
			return false
		end 'notAQualifier'

		let inATypeList = self.prevKind == TokenKind.with or (readonlyMayFollow(self.prevKind) and self.innermostGroupIsTypeList())

		// `readonly` is also a call name, so it qualifies only inside a type list.
		if isReadonlyWord(word) 'readonly'
			return inATypeList
		end 'readonly'

		return inATypeList or self.followsATypedName() or self.followsAnAliasEquals(word)
	end 'qualifiesATypeHere'

	// `observe` leaves `prevKind` alone on a newline, so `lineBrokeSincePrev` is what keeps the last
	// word of one line from qualifying the first of the next. Region operators and `spawn` are
	// identifiers, so a capability word after one is its operand, not a typed name's qualifier.
	function followsATypedName() returns bool
		return not self.lineBrokeSincePrev and not self.prevIsPrefixOperator and (self.prevKind == TokenKind.identifier or self.prevKind == TokenKind.returns or self.prevKind == TokenKind.as)
	end 'followsATypedName'

	function followsAnAliasEquals(word ByteArray) returns bool
		return self.inTypealiasDeclaration and self.groups.count() == 0 and self.prevKind == TokenKind.equals and not word.equals(MutableMarkerWord)
	end 'followsAnAliasEquals'

	module function hasOpenGroup() returns bool
		return self.groups.count() > 0
	end 'hasOpenGroup'

	function innermostGroupIsTypeList() returns bool
		if self.groups.count() == 0 'atStatementLevel'
			return self.inBareTypeList
		end 'atStatementLevel'

		let role = try self.groups.get(self.groups.count() - 1) otherwise panic("BracketTracker.innermostGroupIsTypeList: the count is non-zero on the line above")
		return role == OpenGroupRole.typeList
	end 'innermostGroupIsTypeList'

	function roleOfGroupOpenedBy(kind TokenKind) returns OpenGroupRole
		if kind == TokenKind.leftParen and (self.prevKind == TokenKind.with or self.prevKind == TokenKind.function or self.prevQualifiesAType or self.innermostGroupIsTypeList()) 'typeListParenthesis'
			return OpenGroupRole.typeList
		end 'typeListParenthesis'

		return OpenGroupRole.expression
	end 'roleOfGroupOpenedBy'
end 'BracketTracker'

module function isTypeQualifierWord(word ByteArray) returns bool
	return isReadonlyWord(word) or spellsCapabilityWord(word)
end 'isTypeQualifierWord'

function tokenIsAPrefixOperator(token Token) returns bool
	return token.kind == TokenKind.identifier and (wordIsARegionOperator(token.value) or tokenIsTheSpawnKeyword(token))
end 'tokenIsAPrefixOperator'
