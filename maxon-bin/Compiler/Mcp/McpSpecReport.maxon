module typealias FailureLimit = int(0 to 1000)

module let LowestFailureLimit = 0 as FailureLimit
module let HighestFailureLimit = 1000 as FailureLimit
module let DefaultFailureLimit = 20 as FailureLimit
module let FailureMessageMaxBytes = 4000 as BytePos

export enum SpecDocumentError implements Error
	malformed
end 'SpecDocumentError'

export type SpecTestEntry
	export var spec as String
	export var name as String
	export var verdict as VerdictToken

	export static function create(spec String, name String, verdict VerdictToken) returns SpecTestEntry
		return Self{spec: spec, name: name, verdict: verdict}
	end 'create'
end 'SpecTestEntry'

export typealias SpecTestEntryArray = Array with SpecTestEntry

export type SpecFailureSummary
	export var spec as String
	export var test as String
	export var message as String

	export static function create(spec String, test String, message String) returns SpecFailureSummary
		return Self{spec: spec, test: test, message: message}
	end 'create'
end 'SpecFailureSummary'

export typealias SpecFailureSummaryArray = Array with SpecFailureSummary

export type SpecReport
	export var tally as ResultTally
	export var tests as SpecTestEntryArray
	export var failures as SpecFailureSummaryArray

	static function create(tally ResultTally, tests SpecTestEntryArray, failures SpecFailureSummaryArray) returns SpecReport
		return Self{tally: tally, tests: tests, failures: failures}
	end 'create'
end 'SpecReport'

function countIn(doc JsonDoc, key SpecResultKey) returns TestTally throws SpecDocumentError
	let value = try doc.getInt(doc.root, key: key.rawValue) otherwise throw SpecDocumentError.malformed

	if value < 0 or value > u32.max 'outOfRange'
		throw SpecDocumentError.malformed
	end 'outOfRange'

	return value as TestTally
end 'countIn'

function failureEntry(doc JsonDoc, caseId JsonNodeId, spec String, test String) returns SpecFailureSummary throws SpecDocumentError
	let reason = try doc.getString(caseId, key: SpecResultKey.reason.rawValue) otherwise throw SpecDocumentError.malformed

	return SpecFailureSummary.create(spec, test: test, message: reason)
end 'failureEntry'

function tallyOfEntries(tests SpecTestEntryArray) returns ResultTally
	var verdicts = VerdictTokenArray.create()

	for t in tests 'eachEntry'
		verdicts.push(t.verdict)
	end 'eachEntry'

	return tallyVerdicts(verdicts)
end 'tallyOfEntries'

function statedTallyIn(doc JsonDoc) returns ResultTally throws SpecDocumentError
	let stated = ResultTally.create(try countIn(doc, key: SpecResultKey.passed), failed: try countIn(doc, key: SpecResultKey.failed), skipped: try countIn(doc, key: SpecResultKey.skipped), notRunHere: try countIn(doc, key: SpecResultKey.notRun))
	let statedTotal = try countIn(doc, key: SpecResultKey.total)

	if statedTotal != stated.total() 'totalDisagrees'
		throw SpecDocumentError.malformed
	end 'totalDisagrees'

	return stated
end 'statedTallyIn'

export function readSpecReport(doc JsonDoc) returns SpecReport throws SpecDocumentError
	let casesId = try doc.getChild(doc.root, key: SpecResultKey.cases.rawValue) otherwise throw SpecDocumentError.malformed
	let caseCount = try doc.arrayLength(casesId) otherwise throw SpecDocumentError.malformed

	var tests = SpecTestEntryArray.create()
	var failures = SpecFailureSummaryArray.create()

	for i in 0 upto caseCount 'eachCase'
		let caseId = try doc.arrayAt(casesId, index: i) otherwise throw SpecDocumentError.malformed
		let spec = try doc.getString(caseId, key: SpecResultKey.spec.rawValue) otherwise throw SpecDocumentError.malformed
		let test = try doc.getString(caseId, key: SpecResultKey.test.rawValue) otherwise throw SpecDocumentError.malformed
		let verdictText = try doc.getString(caseId, key: SpecResultKey.verdict.rawValue) otherwise throw SpecDocumentError.malformed
		let verdict = try VerdictToken.fromRawValue(verdictText) otherwise throw SpecDocumentError.malformed

		tests.push(SpecTestEntry.create(spec, name: test, verdict: verdict))

		match verdict 'ofCase'
			fail then failures.push(try failureEntry(doc, caseId: caseId, spec: spec, test: test))
			pass or
				skip or
				notRun then break
		end 'ofCase'
	end 'eachCase'

	let counted = tallyOfEntries(tests)

	if not (try statedTallyIn(doc)).sameCountsAs(counted) 'countsDisagree'
		throw SpecDocumentError.malformed
	end 'countsDisagree'

	return SpecReport.create(counted, tests: tests, failures: failures)
end 'readSpecReport'
