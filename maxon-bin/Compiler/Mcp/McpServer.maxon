// `maxon mcp-server`: the Model Context Protocol server, over stdio or, with `--http`, loopback
// HTTP (`McpHttpServer.maxon`).
//
// The default mode serves someone writing Maxon; `--dev` adds the tools for someone working on the
// compiler, and the `repoRoot` argument that says which checkout those act in.

export let McpServerCommandName = "mcp-server"

function handleInitialize(reqDoc JsonDoc, idNode JsonNodeId) returns String
	var doc = JsonDoc.create()

	var emptyTools = JsonObjectBuilder.create()
	var caps = JsonObjectBuilder.create()
	caps.addNode("tools", node: emptyTools.build(doc))

	var serverInfo = JsonObjectBuilder.create()
	serverInfo.addString(doc, key: "name", value: ServerName)
	serverInfo.addString(doc, key: "version", value: CompilerVersion)

	var result = JsonObjectBuilder.create()
	result.addString(doc, key: "protocolVersion", value: McpProtocolVersion)
	result.addNode("capabilities", node: caps.build(doc))
	result.addNode("serverInfo", node: serverInfo.build(doc))

	return rpcResultText(reqDoc, idNode: idNode, resultDoc: doc, resultRoot: result.build(doc))
end 'handleInitialize'

// An argument accepting several JSON types is emitted as `oneOf`, which is what a client needs in
// order to offer every spelling rather than flagging one as a type error.
function propertySchema(doc JsonDoc, prop McpProperty) returns JsonNodeId
	var schema = JsonObjectBuilder.create()
	let types = prop.jsonTypes()

	if types.count() == 1 'oneType'
		addTypeFields(schema, doc: doc, jsonType: try types.get(0) otherwise panic("propertySchema: a one-type property has its type"))
	end 'oneType' else 'eitherType'
		var alternatives = JsonNodeIdArray.create()

		for jsonType in types 'eachType'
			alternatives.push(typeSchema(doc, jsonType: jsonType))
		end 'eachType'

		schema.addNode("oneOf", node: doc.add(JsonNode.arrayNode(alternatives)))
	end 'eitherType'

	schema.addString(doc, key: "description", value: prop.description)

	match prop.kind 'bounds'
		text or
			flag or
			textList or
			textOrTextList then break 'bounds'
		wholeNumber(least, most, _) then addNumberBounds(doc, schema: schema, least: least as JsonFloat, most: most as JsonFloat)
		seconds then addNumberBounds(doc, schema: schema, least: LeastTargetSeconds, most: MaxTargetSeconds)
	end 'bounds'

	return schema.build(doc)
end 'propertySchema'

function addNumberBounds(doc JsonDoc, schema JsonObjectBuilder, least JsonFloat, most JsonFloat)
	schema.addNumber(doc, key: "minimum", value: least)
	schema.addNumber(doc, key: "maximum", value: most)
end 'addNumberBounds'

function typeSchema(doc JsonDoc, jsonType String) returns JsonNodeId
	var schema = JsonObjectBuilder.create()
	addTypeFields(schema, doc: doc, jsonType: jsonType)
	return schema.build(doc)
end 'typeSchema'

// `items` is always a string: `validateToolArguments` refuses a list holding anything else.
function addTypeFields(schema JsonObjectBuilder, doc JsonDoc, jsonType String)
	schema.addString(doc, key: "type", value: jsonType)

	if jsonType.equals(JsonArrayType) 'needsItems'
		schema.addNode("items", node: typeSchema(doc, jsonType: JsonStringType))
	end 'needsItems'
end 'addTypeFields'

function toolDescriptor(doc JsonDoc, spec McpToolSpec, devMode bool) returns JsonNodeId
	var properties = JsonObjectBuilder.create()
	var requiredNames = JsonNodeIdArray.create()
	var anyRequired = false

	for prop in spec.properties 'each'
		if prop.devOnly and not devMode 'hidden'
			continue
		end 'hidden'

		properties.addNode(prop.name, node: propertySchema(doc, prop: prop))

		if prop.required 'isRequired'
			requiredNames.push(doc.add(JsonNode.stringNode(prop.name)))
			anyRequired = true
		end 'isRequired'
	end 'each'

	var schema = JsonObjectBuilder.create()
	schema.addString(doc, key: "type", value: JsonObjectType)
	schema.addNode("properties", node: properties.build(doc))

	if anyRequired 'hasRequired'
		schema.addNode("required", node: doc.add(JsonNode.arrayNode(requiredNames)))
	end 'hasRequired'

	var descriptor = JsonObjectBuilder.create()
	descriptor.addString(doc, key: "name", value: spec.name)
	descriptor.addString(doc, key: "description", value: spec.description)
	descriptor.addNode("inputSchema", node: schema.build(doc))

	return descriptor.build(doc)
end 'toolDescriptor'

function handleToolsList(reqDoc JsonDoc, idNode JsonNodeId, devMode bool) returns String
	var doc = JsonDoc.create()
	var descriptors = JsonNodeIdArray.create()

	for spec in mcpToolRoster() 'each'
		if not spec.visibleIn(devMode) 'hidden'
			continue
		end 'hidden'

		descriptors.push(toolDescriptor(doc, spec: spec, devMode: devMode))
	end 'each'

	var result = JsonObjectBuilder.create()
	result.addNode("tools", node: doc.add(JsonNode.arrayNode(descriptors)))

	return rpcResultText(reqDoc, idNode: idNode, resultDoc: doc, resultRoot: result.build(doc))
end 'handleToolsList'

function dispatchTool(reqDoc JsonDoc, idNode JsonNodeId, spec McpToolSpec, args OptionalNode, exePath FilePath, devMode bool, debug DebugSessionSlot) returns String
	if spec.name.equals(BuildToolName) 'tBuild'
		return withinContext(buildToolContext(reqDoc, idNode: idNode, args: args, exePath: exePath, devMode: devMode), reqDoc: reqDoc, idNode: idNode, args: args, tool: executeBuildToolWithin)
	end 'tBuild'

	if spec.name.equals(ExecuteToolName) 'tExecute'
		return withinHostOrTree(reqDoc, idNode: idNode, args: args, exePath: exePath, tool: executeExecuteToolWithin)
	end 'tExecute'

	if spec.name.equals(TestToolName) 'tTest'
		return withinHostOrTree(reqDoc, idNode: idNode, args: args, exePath: exePath, tool: executeTestToolWithin)
	end 'tTest'

	if spec.name.equals(FmtToolName) 'tFmt'
		return withinHostOrTree(reqDoc, idNode: idNode, args: args, exePath: exePath, tool: executeFmtToolWithin)
	end 'tFmt'

	if spec.name.equals(CheckToolName) 'tCheck'
		return executeCheckTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
	end 'tCheck'

	if spec.name.equals(DumpIrToolName) 'tDumpIr'
		return executeDumpIrTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
	end 'tDumpIr'

	if spec.name.equals(InfoToolName) 'tInfo'
		return executeInfoTool(reqDoc, idNode: idNode, exePath: exePath)
	end 'tInfo'

	if spec.name.equals(LookupErrorCodeToolName) 'tLookup'
		return executeLookupErrorCodeTool(reqDoc, idNode: idNode, args: args)
	end 'tLookup'

	if spec.name.equals(SpecTestToolName) 'tSpecTest'
		return withinTheTree(reqDoc, idNode: idNode, args: args, exePath: exePath, tool: executeSpecTestToolWithin)
	end 'tSpecTest'

	if spec.name.equals(ScaleTestToolName) 'tScaleTest'
		return withinTheTree(reqDoc, idNode: idNode, args: args, exePath: exePath, tool: executeScaleTestToolWithin)
	end 'tScaleTest'

	if spec.name.equals(SpecOutcomeToolName) 'tSpecOutcome'
		return withinTheTree(reqDoc, idNode: idNode, args: args, exePath: exePath, tool: executeSpecOutcomeToolWithin)
	end 'tSpecOutcome'

	if isDebugToolName(spec.name) 'tDebug'
		return executeDebugTool(reqDoc, idNode: idNode, name: spec.name, args: args, exePath: exePath, debug: debug)
	end 'tDebug'

	panic("dispatchTool: the roster advertises `{spec.name}` and nothing executes it")
end 'dispatchTool'

function withinHostOrTree(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath, tool ToolWithin) returns String
	return withinContext(hostOrTreeContext(reqDoc, idNode: idNode, args: args, exePath: exePath), reqDoc: reqDoc, idNode: idNode, args: args, tool: tool)
end 'withinHostOrTree'

function withinTheTree(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath, tool ToolWithin) returns String
	return withinContext(resolveTreeContext(reqDoc, idNode: idNode, args: args, exePath: exePath, compiler: TreeCompiler.ownSlot), reqDoc: reqDoc, idNode: idNode, args: args, tool: tool)
end 'withinTheTree'

function handleToolsCall(reqDoc JsonDoc, idNode JsonNodeId, paramsId JsonNodeId, exePath FilePath, devMode bool, debug DebugSessionSlot) returns String
	let toolName = try reqDoc.getString(paramsId, key: "name") otherwise 'noName'
		return rpcErrorText(reqDoc, idNode: idNode, code: RpcStandardErrorCode.invalidParams, message: "Missing 'name' in tools/call params")
	end 'noName'

	let spec = try findToolSpec(toolName, devMode: devMode) otherwise 'unknownTool'
		return rpcErrorText(reqDoc, idNode: idNode, code: RpcStandardErrorCode.methodNotFound, message: "Unknown tool: {toolName}")
	end 'unknownTool'

	let args = resolveChildKey(reqDoc, parent: paramsId, key: "arguments")

	// Before any argument is read: every reader defaults on a miss, so an argument reaching one
	// unchecked is one the caller set and nobody honoured.
	try validateToolArguments(reqDoc, args: args, spec: spec, devMode: devMode) otherwise (fault) 'badArgs'
		return rpcErrorText(reqDoc, idNode: idNode, code: RpcStandardErrorCode.invalidParams, message: argumentFaultReason(fault))
	end 'badArgs'

	return dispatchTool(reqDoc, idNode: idNode, spec: spec, args: args, exePath: exePath, devMode: devMode, debug: debug)
end 'handleToolsCall'

function handleRpcMessage(line String, exePath FilePath, devMode bool, debug DebugSessionSlot) returns RpcReply
	let doc = try Json.parse(line) otherwise return unattributedRpcError(RpcStandardErrorCode.parseError, message: "Parse error - invalid JSON")

	return handleRpcDocument(doc, exePath: exePath, devMode: devMode, debug: debug)
end 'handleRpcMessage'

function unattributedRpcError(code RpcStandardErrorCode, message String) returns RpcReply
	var errDoc = JsonDoc.create()
	let nullId = errDoc.add(JsonNode.nullNode())

	return RpcReply.body(rpcErrorText(errDoc, idNode: nullId, code: code, message: message))
end 'unattributedRpcError'

export function handleRpcDocument(doc JsonDoc, exePath FilePath, devMode bool, debug DebugSessionSlot) returns RpcReply
	let root = doc.root

	if doc.get(root).kind != JsonKind.jsonObject 'notObj'
		return unattributedRpcError(RpcStandardErrorCode.invalidRequest, message: "Invalid Request - expected JSON object")
	end 'notObj'

	// A request without an id is a notification, and JSON-RPC forbids answering one: a reply
	// carrying a null id matches no request the client sent.
	if rpcIsNotification(doc) 'nothingToAnswer'
		return RpcReply.none
	end 'nothingToAnswer'

	let idNode = rpcIdNodeOf(doc)

	return match rpcMethodOf(doc) 'asked'
		absent gives RpcReply.body(rpcErrorText(doc, idNode: idNode, code: RpcStandardErrorCode.invalidRequest, message: "Invalid Request - missing 'method'"))
		named(method) gives answeredRpcMethod(doc, idNode: idNode, method: method, exePath: exePath, devMode: devMode, debug: debug)
	end 'asked'
end 'handleRpcDocument'

function answeredRpcMethod(doc JsonDoc, idNode JsonNodeId, method String, exePath FilePath, devMode bool, debug DebugSessionSlot) returns RpcReply
	let root = doc.root

	if method.equals(RpcInitializeMethod) 'init'
		return RpcReply.body(handleInitialize(doc, idNode: idNode))
	end 'init'

	if method.equals("tools/list") 'tl'
		return RpcReply.body(handleToolsList(doc, idNode: idNode, devMode: devMode))
	end 'tl'

	if method.equals("tools/call") 'tc'
		return match resolveChildKey(doc, parent: root, key: "params") 'pr'
			none gives RpcReply.body(rpcErrorText(doc, idNode: idNode, code: RpcStandardErrorCode.invalidParams, message: "Missing 'params' for tools/call"))
			some(paramsId) gives RpcReply.body(handleToolsCall(doc, idNode: idNode, paramsId: paramsId, exePath: exePath, devMode: devMode, debug: debug))
		end 'pr'
	end 'tc'

	return RpcReply.body(rpcErrorText(doc, idNode: idNode, code: RpcStandardErrorCode.methodNotFound, message: "Method not found: {method}"))
end 'answeredRpcMethod'

let RpcMethodKey = "method"
export let RpcInitializeMethod = "initialize"
let RpcIdKey = "id"

union RpcMethodRead
	named(method String)
	absent
end 'RpcMethodRead'

function rpcMethodOf(doc JsonDoc) returns RpcMethodRead
	let method = try doc.getString(doc.root, key: RpcMethodKey) otherwise return RpcMethodRead.absent

	return RpcMethodRead.named(method)
end 'rpcMethodOf'

export function rpcNamesMethod(doc JsonDoc, method String) returns bool
	return match rpcMethodOf(doc) 'asked'
		named(asked) gives asked.equals(method)
		absent gives false
	end 'asked'
end 'rpcNamesMethod'

function rpcIdNodeOf(doc JsonDoc) returns JsonNodeId
	return match resolveChildKey(doc, parent: doc.root, key: RpcIdKey) 'ir'
		none gives doc.add(JsonNode.nullNode())
		some(id) gives id
	end 'ir'
end 'rpcIdNodeOf'

export function rpcIsNotification(doc JsonDoc) returns bool
	return match resolveChildKey(doc, parent: doc.root, key: RpcIdKey) 'ir'
		none gives true
		some(id) gives doc.get(id).kind == JsonKind.jsonNull
	end 'ir'
end 'rpcIsNotification'

export function runMcpServer(devMode bool, transport McpTransportChoice) returns ExitCode
	let exePath = try Process.executablePath() otherwise 'noExe'
		printError("maxon {McpServerCommandName}: failed to determine executable path\n")

		return OwnFailureExit
	end 'noExe'

	sweepStaleDebugBuilds()
	sweepStaleSnippets()

	return match transport 'which'
		stdio gives runMcpStdioServer(devMode, exePath: exePath)
		http(options) gives runMcpHttpServer(devMode, exePath: exePath, options: options)
	end 'which'
end 'runMcpServer'

// One JSON object per line in each direction: MCP's stdio transport does not use the Content-Length
// framing LSP and DAP do.
function runMcpStdioServer(devMode bool, exePath FilePath) returns ExitCode
	var stdin = Console.stdin()
	let debug = DebugSessionSlot.create()

	while true 'serverLoop'
		let line = try stdin.readLine() otherwise 'eof'
			break
		end 'eof'

		let trimmed = line.trim()

		if trimmed.isEmpty() 'blank'
			continue
		end 'blank'

		match handleRpcMessage(trimmed, exePath: exePath, devMode: devMode, debug: debug) 'answer'
			none then break 'answer'
			body(text) then print("{text}\n")
		end 'answer'
	end 'serverLoop'

	_ = debug.reap()

	return SucceededExit
end 'runMcpStdioServer'
