// `maxon mcp-server` — the Model Context Protocol server, spoken over newline-delimited stdio.
//
// Gives AI-assisted editors structured tools for working on Maxon code. The default mode serves
// someone WRITING Maxon; `--dev` adds the tools for someone working on the COMPILER, and the
// `repoRoot` argument that says which checkout those act in.

export let McpServerCommandName = "mcp-server"

function handleInitialize(reqDoc JsonDoc, idNode JsonNodeId)
	var doc = JsonDoc.create()

	var emptyTools = JsonObjectBuilder.create()
	var caps = JsonObjectBuilder.create()
	caps.addNode("tools", node: emptyTools.build(doc))

	var serverInfo = JsonObjectBuilder.create()
	serverInfo.addString(doc, key: "name", value: ServerName)
	serverInfo.addString(doc, key: "version", value: CompilerVersion)

	var result = JsonObjectBuilder.create()
	result.addString(doc, key: "protocolVersion", value: McpProtocolVersion)
	result.addNode("capabilities", node: caps.build(doc))
	result.addNode("serverInfo", node: serverInfo.build(doc))

	sendRpcResult(reqDoc, idNode: idNode, resultDoc: doc, resultRoot: result.build(doc))
end 'handleInitialize'

// Render one roster property as a JSON Schema fragment. An array's `items` says only that the entries
// are strings; no argument here takes a richer element type.
//
// An argument accepting two types is emitted as `oneOf`, which is what a client needs in order to
// offer both spellings rather than flagging one as a type error.
function propertySchema(doc JsonDoc, prop McpProperty) returns JsonNodeId
	var schema = JsonObjectBuilder.create()

	if prop.altType.isEmpty() 'oneType'
		schema.addString(doc, key: "type", value: prop.jsonType)
	end 'oneType' else 'eitherType'
		var alternatives = JsonNodeIdArray.create()
		alternatives.push(bareTypeSchema(doc, jsonType: prop.jsonType))
		alternatives.push(bareTypeSchema(doc, jsonType: prop.altType))
		schema.addNode("oneOf", node: doc.add(JsonNode.arrayNode(alternatives)))
	end 'eitherType'

	schema.addString(doc, key: "description", value: prop.description)

	if prop.jsonType.equals("array") 'needsItems'
		schema.addNode("items", node: bareTypeSchema(doc, jsonType: "string"))
	end 'needsItems'

	return schema.build(doc)
end 'propertySchema'

function bareTypeSchema(doc JsonDoc, jsonType String) returns JsonNodeId
	var schema = JsonObjectBuilder.create()
	schema.addString(doc, key: "type", value: jsonType)
	return schema.build(doc)
end 'bareTypeSchema'

function toolDescriptor(doc JsonDoc, spec McpToolSpec, devMode bool) returns JsonNodeId
	var properties = JsonObjectBuilder.create()
	var requiredNames = JsonNodeIdArray.create()
	var anyRequired = false

	for prop in spec.properties 'each'
		if prop.devOnly and not devMode 'hidden'
			continue
		end 'hidden'

		properties.addNode(prop.name, node: propertySchema(doc, prop: prop))

		if prop.required 'isRequired'
			requiredNames.push(doc.add(JsonNode.stringNode(prop.name)))
			anyRequired = true
		end 'isRequired'
	end 'each'

	var schema = JsonObjectBuilder.create()
	schema.addString(doc, key: "type", value: "object")
	schema.addNode("properties", node: properties.build(doc))

	if anyRequired 'hasRequired'
		schema.addNode("required", node: doc.add(JsonNode.arrayNode(requiredNames)))
	end 'hasRequired'

	var descriptor = JsonObjectBuilder.create()
	descriptor.addString(doc, key: "name", value: spec.name)
	descriptor.addString(doc, key: "description", value: spec.description)
	descriptor.addNode("inputSchema", node: schema.build(doc))

	return descriptor.build(doc)
end 'toolDescriptor'

function handleToolsList(reqDoc JsonDoc, idNode JsonNodeId, devMode bool)
	var doc = JsonDoc.create()
	var descriptors = JsonNodeIdArray.create()

	for spec in mcpToolRoster() 'each'
		if not spec.visibleIn(devMode) 'hidden'
			continue
		end 'hidden'

		descriptors.push(toolDescriptor(doc, spec: spec, devMode: devMode))
	end 'each'

	var result = JsonObjectBuilder.create()
	result.addNode("tools", node: doc.add(JsonNode.arrayNode(descriptors)))

	sendRpcResult(reqDoc, idNode: idNode, resultDoc: doc, resultRoot: result.build(doc))
end 'handleToolsList'

function dispatchTool(reqDoc JsonDoc, idNode JsonNodeId, spec McpToolSpec, args OptionalNode, exePath FilePath, devMode bool)
	if spec.name.equals("build") 'tBuild'
		executeBuildTool(reqDoc, idNode: idNode, args: args, exePath: exePath, devMode: devMode)
		return
	end 'tBuild'

	if spec.name.equals("run") 'tRun'
		executeRunTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tRun'

	if spec.name.equals("test") 'tTest'
		executeTestTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tTest'

	if spec.name.equals("fmt") 'tFmt'
		executeFmtTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tFmt'

	if spec.name.equals("check") 'tCheck'
		executeCheckTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tCheck'

	if spec.name.equals("dump_ir") 'tDumpIr'
		executeDumpIrTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tDumpIr'

	if spec.name.equals("info") 'tInfo'
		executeInfoTool(reqDoc, idNode: idNode, exePath: exePath)
		return
	end 'tInfo'

	if spec.name.equals("lookup_error_code") 'tLookup'
		executeLookupErrorCodeTool(reqDoc, idNode: idNode, args: args)
		return
	end 'tLookup'

	if spec.name.equals("run_spec_test") 'tSpecTest'
		executeSpecTestTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tSpecTest'

	if spec.name.equals("run_scale_test") 'tScaleTest'
		executeScaleTestTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tScaleTest'

	if spec.name.equals("spec_test_outcome") 'tSpecOutcome'
		executeSpecOutcomeTool(reqDoc, idNode: idNode, args: args, exePath: exePath)
		return
	end 'tSpecOutcome'

	// The roster handed this spec over, so a name with no arm is a tool declared and never wired up.
	panic("dispatchTool: the roster advertises `{spec.name}` and nothing executes it")
end 'dispatchTool'

function handleToolsCall(reqDoc JsonDoc, idNode JsonNodeId, paramsId JsonNodeId, exePath FilePath, devMode bool)
	let toolName = try reqDoc.getString(paramsId, key: "name") otherwise 'noName'
		sendRpcError(reqDoc, idNode: idNode, code: RpcStandardErrorCode.invalidParams, message: "Missing 'name' in tools/call params")
		return
	end 'noName'

	let spec = try findToolSpec(toolName, devMode: devMode) otherwise 'unknownTool'
		sendRpcError(reqDoc, idNode: idNode, code: RpcStandardErrorCode.methodNotFound, message: "Unknown tool: {toolName}")
		return
	end 'unknownTool'

	let args = resolveChildKey(reqDoc, parent: paramsId, key: "arguments")

	// ⛔ BEFORE the tool reads a single argument: every reader below defaults on a miss, so an argument
	// that reaches one unchecked is an argument the caller set and nobody honoured.
	try validateToolArguments(reqDoc, args: args, spec: spec, devMode: devMode) otherwise (fault) 'badArgs'
		sendRpcError(reqDoc, idNode: idNode, code: RpcStandardErrorCode.invalidParams, message: argumentFaultReason(fault))
		return
	end 'badArgs'

	dispatchTool(reqDoc, idNode: idNode, spec: spec, args: args, exePath: exePath, devMode: devMode)
end 'handleToolsCall'

function handleRpcMessage(line String, exePath FilePath, devMode bool)
	var doc = try Json.parse(line) otherwise 'badJson'
		var errDoc = JsonDoc.create()
		let nullId = errDoc.add(JsonNode.nullNode())
		sendRpcError(errDoc, idNode: nullId, code: RpcStandardErrorCode.parseError, message: "Parse error - invalid JSON")
		return
	end 'badJson'

	let root = doc.root

	if doc.get(root).kind != JsonKind.jsonObject 'notObj'
		var errDoc = JsonDoc.create()
		let nullId = errDoc.add(JsonNode.nullNode())
		sendRpcError(errDoc, idNode: nullId, code: RpcStandardErrorCode.invalidRequest, message: "Invalid Request - expected JSON object")
		return
	end 'notObj'

	let idNode = match resolveChildKey(doc, parent: root, key: "id") 'ir'
		none gives doc.add(JsonNode.nullNode())
		some(id) gives id
	end 'ir'

	// A request without an id is a NOTIFICATION, and JSON-RPC forbids answering one at all — a reply
	// carrying a null id is a reply the client has no request to match it to.
	let isNotification = doc.get(idNode).kind == JsonKind.jsonNull

	let method = try doc.getString(root, key: "method") otherwise 'noMethod'
		if not isNotification 'respond'
			sendRpcError(doc, idNode: idNode, code: RpcStandardErrorCode.invalidRequest, message: "Invalid Request - missing 'method'")
		end 'respond'

		return
	end 'noMethod'

	if method.equals("initialize") 'init'
		handleInitialize(doc, idNode: idNode)
		return
	end 'init'

	if method.equals("notifications/initialized") 'initd'
		return
	end 'initd'

	if method.equals("tools/list") 'tl'
		handleToolsList(doc, idNode: idNode, devMode: devMode)
		return
	end 'tl'

	if method.equals("tools/call") 'tc'
		if isNotification 'noAnswerWanted'
			return
		end 'noAnswerWanted'

		match resolveChildKey(doc, parent: root, key: "params") 'pr'
			none then sendRpcError(doc, idNode: idNode, code: RpcStandardErrorCode.invalidParams, message: "Missing 'params' for tools/call")
			some(paramsId) then handleToolsCall(doc, idNode: idNode, paramsId: paramsId, exePath: exePath, devMode: devMode)
		end 'pr'

		return
	end 'tc'

	if not isNotification 'unknownMethod'
		sendRpcError(doc, idNode: idNode, code: RpcStandardErrorCode.methodNotFound, message: "Method not found: {method}")
	end 'unknownMethod'
end 'handleRpcMessage'

export function runMcpServer(devMode bool) returns ExitCode
	let exePath = try Process.executablePath() otherwise 'noExe'
		printError("maxon {McpServerCommandName}: failed to determine executable path\n")
		return 1
	end 'noExe'

	var stdin = Console.stdin()

	while true 'serverLoop'
		let line = try stdin.readLine() otherwise 'eof'
			return 0
		end 'eof'

		let trimmed = line.trim()

		if trimmed.isEmpty() 'blank'
			continue
		end 'blank'

		handleRpcMessage(trimmed, exePath: exePath, devMode: devMode)
	end 'serverLoop'

	return 0
end 'runMcpServer'
