// THE ROSTER: every tool, every argument it accepts, and which mode exposes it.
//
// ⭐ ONE declaration serves BOTH directions. `tools/list` renders it into JSON Schema, and
// `tools/call` validates an incoming `arguments` object against it. A tool that reads an argument the
// roster does not declare cannot exist, and an argument the caller sets that no tool declares is
// REFUSED rather than dropped.
//
// ⛔ Dropping it is the worse failure and the reason this is a roster rather than a list of names to
// reject: a `mmTrace: true` run that never traced, reported back as a clean success, is
// indistinguishable from a leak-free run. Refusing by ARRIVAL — anything not declared — also covers
// the argument nobody thought to write a rejection for.

module let BuildToolName = "build"
module let ExecuteToolName = "execute"
module let TestToolName = "test"
module let FmtToolName = "fmt"
module let CheckToolName = "check"
module let LookupErrorCodeToolName = "lookup_error_code"
module let DumpIrToolName = "dump_ir"
module let InfoToolName = "info"
module let SpecTestToolName = "run_spec_test"
module let ScaleTestToolName = "run_scale_test"
module let SpecOutcomeToolName = "spec_test_outcome"

export union McpValueKind
	text
	flag
	textList
	textOrTextList

	// `alsoText` admits a string as well: an error code arrives as `3014` as readily as `"3014"`, and
	// refusing one spelling of the same digits helps nobody.
	wholeNumber(least JsonInt, most JsonInt, alsoText bool)
	seconds
end 'McpValueKind'

module let JsonStringType = "string"
let JsonBooleanType = "boolean"
module let JsonArrayType = "array"
module let JsonObjectType = "object"
let JsonIntegerType = "integer"
let JsonNumberType = "number"

export type McpProperty
	export var name as String
	export var kind as McpValueKind
	export var description as String
	export var required as bool
	export var devOnly as bool

	export static function create(name String, kind McpValueKind, description String, required bool = false, devOnly bool = false) returns McpProperty
		return Self{name: name, kind: kind, description: description, required: required, devOnly: devOnly}
	end 'create'

	export function accepts(arrived JsonKind) returns bool
		return match self.kind 'declared'
			text gives arrived == JsonKind.jsonString
			flag gives arrived == JsonKind.jsonBool
			textList gives arrived == JsonKind.jsonArray
			textOrTextList gives arrived == JsonKind.jsonString or arrived == JsonKind.jsonArray
			wholeNumber(_, _, alsoText) gives arrived == JsonKind.jsonNumber or (alsoText and arrived == JsonKind.jsonString)
			seconds gives arrived == JsonKind.jsonNumber
		end 'declared'
	end 'accepts'

	export function acceptedTypes() returns String
		return joinedWith(self.jsonTypes(), separator: " or ")
	end 'acceptedTypes'

	export function jsonTypes() returns StringArray
		return match self.kind 'declared'
			text gives [JsonStringType]
			flag gives [JsonBooleanType]
			textList gives [JsonArrayType]
			textOrTextList gives [JsonStringType, JsonArrayType]
			wholeNumber(_, _, alsoText) gives [JsonStringType, JsonIntegerType] if alsoText else [JsonIntegerType]
			seconds gives [JsonNumberType]
		end 'declared'
	end 'jsonTypes'
end 'McpProperty'

export typealias McpPropertyArray = Array with McpProperty

export type McpToolSpec
	export var name as String
	export var description as String
	export var properties as McpPropertyArray
	export var devOnly as bool

	export static function create(name String, description String, properties McpPropertyArray, devOnly bool = false) returns McpToolSpec
		return Self{name: name, description: description, properties: properties, devOnly: devOnly}
	end 'create'

	// Whether this tool is reachable in the mode the server was started in.
	export function visibleIn(devMode bool) returns bool
		return devMode or not self.devOnly
	end 'visibleIn'
end 'McpToolSpec'

export typealias McpToolSpecArray = Array with McpToolSpec

function str(name String, description String, required bool = false, devOnly bool = false) returns McpProperty
	return McpProperty.create(name, kind: McpValueKind.text, description: description, required: required, devOnly: devOnly)
end 'str'

function flag(name String, description String, devOnly bool = false) returns McpProperty
	return McpProperty.create(name, kind: McpValueKind.flag, description: description, devOnly: devOnly)
end 'flag'

function whole(name String, description String, least JsonInt, most JsonInt, devOnly bool = false) returns McpProperty
	return McpProperty.create(name, kind: McpValueKind.wholeNumber(least, most: most, alsoText: false), description: description, devOnly: devOnly)
end 'whole'

function seconds(name String, description String) returns McpProperty
	return McpProperty.create(name, kind: McpValueKind.seconds, description: description)
end 'seconds'

function list(name String, description String) returns McpProperty
	return McpProperty.create(name, kind: McpValueKind.textList, description: description)
end 'list'

function textOrList(name String, description String, required bool = false, devOnly bool = false) returns McpProperty
	return McpProperty.create(name, kind: McpValueKind.textOrTextList, description: description, required: required, devOnly: devOnly)
end 'textOrList'

function workersProperty() returns McpProperty
	return whole(WorkersOption, description: "Number of worker subprocesses (--workers=<n>), {MinWorkerCount}-{MaxWorkerCount}. A debugging tool; the suite's own count is the default.", least: MinWorkerCount, most: MaxWorkerCount, devOnly: true)
end 'workersProperty'

function childTimeoutProperty() returns McpProperty
	return seconds(ChildTimeoutOption, description: "Seconds the compiler this call runs may take before it is stopped and the call answers what it wrote (default {CompilerChildTimeoutMs / MillisecondsPerSecond}, {targetSecondsRange()}).")
end 'childTimeoutProperty'

// `repoRoot` reads the same on every tool that takes it, and a caller who learns it once should not have to
// read seven spellings of it. Only the sentence about what an ABSENT one means differs, because the two
// bands of tools genuinely differ there: a tool that acts on the TREE falls back to this compiler's own
// checkout, and one that acts on the CALLER's paths falls back to the host's working directory and names no
// tree at all.
let RepoRootDefaultsToOwnCheckout = "Defaults to the checkout this compiler sits in."
let RepoRootDefaultsToHostDirectory = "Defaults to the host's working directory, driven by this server's own compiler and naming no tree."

function repoRootProperty(whenAbsent String) returns McpProperty
	return str("repoRoot", description: "Absolute path of the Maxon checkout to act in; that tree's own compiler is the one that runs. {whenAbsent} Every answer echoes back the root it used.", devOnly: true)
end 'repoRootProperty'

export function mcpToolRoster() returns McpToolSpecArray
	var tools = McpToolSpecArray.create()

	var buildProps = McpPropertyArray.create()
	buildProps.push(str("path", description: "Source file or project directory to build. Defaults to '.'"))
	buildProps.push(str("source", description: "Inline Maxon source to build instead of a path. Mutually exclusive with `path`."))
	buildProps.push(str("output", description: "Output executable path (--output=<path>)"))
	buildProps.push(str("target", description: "Cross-compile target (--target=<cpu>-<os>), or the name of a target the .maxproj file declares, each `_` written `-`"))
	buildProps.push(flag("emitIr", description: "Emit intermediate representation (--emit-ir)"))
	buildProps.push(str("from", description: "Compiler binary to build WITH, instead of the target tree's own.", devOnly: true))
	buildProps.push(childTimeoutProperty())
	buildProps.push(repoRootProperty(RepoRootDefaultsToOwnCheckout))
	tools.push(McpToolSpec.create(BuildToolName, description: "Build a Maxon project, source file, or inline snippet using `maxon build`.", properties: buildProps))

	var executeProps = McpPropertyArray.create()
	executeProps.push(str("path", description: "Path to the .maxon file to run. Mutually exclusive with `source`."))
	executeProps.push(str("source", description: "Inline Maxon source to compile and run instead of a path."))
	executeProps.push(list("arguments", description: "Command-line arguments passed to the program"))
	executeProps.push(childTimeoutProperty())
	executeProps.push(repoRootProperty(RepoRootDefaultsToHostDirectory))
	tools.push(McpToolSpec.create(ExecuteToolName, description: "Compile and run a Maxon program, or an inline snippet, using `maxon execute`.", properties: executeProps))

	var testProps = McpPropertyArray.create()
	testProps.push(str("path", description: "Project directory containing tests. Defaults to '.'"))
	testProps.push(str("filter", description: "Substring pattern selecting tests by name or file (case-insensitive; comma-separated patterns are a union)"))
	testProps.push(childTimeoutProperty())
	testProps.push(repoRootProperty(RepoRootDefaultsToHostDirectory))
	tools.push(McpToolSpec.create(TestToolName, description: "Run unit tests in a Maxon project using `maxon test`.", properties: testProps))

	var fmtProps = McpPropertyArray.create()
	fmtProps.push(str("path", description: "File or directory to format in place. Defaults to '.'"))
	fmtProps.push(str("source", description: "Inline Maxon source to format, returned rather than written. Mutually exclusive with `path`."))
	fmtProps.push(childTimeoutProperty())
	fmtProps.push(repoRootProperty(RepoRootDefaultsToHostDirectory))
	tools.push(McpToolSpec.create(FmtToolName, description: "Format Maxon source in place, or format an inline snippet and return it.", properties: fmtProps))

	var checkProps = McpPropertyArray.create()
	checkProps.push(str("path", description: "The .maxon file or directory to check, compiled as `maxon build` would compile it", required: true))
	tools.push(McpToolSpec.create(CheckToolName, description: "Check a Maxon program for errors without writing anything, answering the diagnostics `maxon build` would print.", properties: checkProps))

	var lookupProps = McpPropertyArray.create()
	lookupProps.push(McpProperty.create(CodeArgument, kind: McpValueKind.wholeNumber(LowestErrorCodeNumber, most: HighestErrorCodeNumber, alsoText: true), description: "Error code to look up: 'E3014', '3014', 3014, or the registry case name 'semanticUnneededCast'", required: true))
	tools.push(McpToolSpec.create(LookupErrorCodeToolName, description: "Look up a Maxon compiler error code: its canonical registry name, compilation stage, and documentation.", properties: lookupProps))

	var irProps = McpPropertyArray.create()
	irProps.push(str("path", description: "The .maxon file or directory to compile, as `maxon build` would compile it", required: true))
	tools.push(McpToolSpec.create(DumpIrToolName, description: "Answer the Target IR a Maxon program compiles to for the host, the text `maxon build --emit-ir` writes, without writing anything.", properties: irProps))

	tools.push(McpToolSpec.create(InfoToolName, description: "Get Maxon compiler version, commit, executable path, and host target.", properties: McpPropertyArray.create()))

	var specProps = McpPropertyArray.create()
	specProps.push(textOrList("filter", description: "A pattern, or a list of patterns, each passed as its own --filter=<pattern>: a CASE-SENSITIVE substring of the `<spec>/<test>` label. The run takes every case any pattern selects, and a pattern that selects nothing refuses the run. A comma is part of a pattern.", devOnly: true))
	specProps.push(str("directory", description: "Spec directory to run (default: 'specs').", devOnly: true))
	specProps.push(flag("updateRequired", description: "Pass --update-required to rewrite the committed IR goldens under specs/fragments. ALWAYS pair with `filter`: unfiltered it rewrites every golden in the suite.", devOnly: true))
	specProps.push(str("log", description: "Passed to --log=<value> (e.g. 'ir:debug').", devOnly: true))
	specProps.push(flag("network", description: "Pass --network to ALSO run live network fragments.", devOnly: true))
	specProps.push(str("target", description: "Cross-compile target passed to --target=<value> (e.g. 'wasm32-wasi').", devOnly: true))
	specProps.push(workersProperty())
	specProps.push(childTimeoutProperty())
	specProps.push(repoRootProperty(RepoRootDefaultsToOwnCheckout))
	tools.push(McpToolSpec.create(SpecTestToolName, description: "Run the Maxon spec-test suite, optionally filtered, returning structured pass/fail counts.", properties: specProps, devOnly: true))

	var scaleProps = McpPropertyArray.create()
	scaleProps.push(whole(RungsOption, description: "How many rungs of the ladder to climb ({MinRungCount}-{MaxRungCount}, default {DefaultRungCount}). Each rung DOUBLES the program.", least: MinRungCount, most: MaxRungCount, devOnly: true))
	scaleProps.push(whole(RepeatOption, description: "How many times each rung is compiled ({MinRepeatCount}-{MaxRepeatCount}, default {DefaultRepeatCount}). CPU takes minimum; memory cross-checks.", least: MinRepeatCount, most: MaxRepeatCount, devOnly: true))
	scaleProps.push(str("note", description: "Record this run in docs/optimization-log.md with this text as the reason.", devOnly: true))
	scaleProps.push(str("emitCorpus", description: "Write the generated corpus to this directory and compile nothing.", devOnly: true))
	scaleProps.push(str("log", description: "Passed to --log=<value>.", devOnly: true))
	scaleProps.push(childTimeoutProperty())
	scaleProps.push(repoRootProperty(RepoRootDefaultsToOwnCheckout))
	tools.push(McpToolSpec.create(ScaleTestToolName, description: "Run the scaling INSTRUMENT: compile a doubling ladder and report per-phase memory and CPU. It has no verdict — the RATIO between rungs is the reading.", properties: scaleProps, devOnly: true))

	var outcomeProps = McpPropertyArray.create()
	outcomeProps.push(textOrList("filter", description: "A pattern, or a list of at least one, each passed as its own --filter=<pattern>: a CASE-SENSITIVE substring, typically a label like 'arithmetic/addition'. A pattern that selects nothing refuses the run.", required: true, devOnly: true))
	outcomeProps.push(str("target", description: "Cross-compile target passed to --target=<value>.", devOnly: true))
	outcomeProps.push(flag("network", description: "Pass --network to ALSO run live network fragments.", devOnly: true))
	outcomeProps.push(workersProperty())
	outcomeProps.push(childTimeoutProperty())
	outcomeProps.push(repoRootProperty(RepoRootDefaultsToOwnCheckout))
	tools.push(McpToolSpec.create(SpecOutcomeToolName, description: "Run spec-tests with a filter, returning structured per-test PASS/FAIL entries plus a failure summary.", properties: outcomeProps, devOnly: true))

	pushDebugTools(tools)

	return tools
end 'mcpToolRoster'

let DebugAnswerShape = "Answers the live session's `state`, the `events` the debugger produced for this call, and the debuggee's `output` lines since the previous call."

// Not `devOnly`: these debug a user's program, and the contributor band is for tools that drive a
// compiler checkout.
function pushDebugTools(tools McpToolSpecArray)
	var startProps = McpPropertyArray.create()
	startProps.push(str("executable", description: "Path to an already-built program to debug. Mutually exclusive with `source`."))
	startProps.push(str("source", description: "Path to a .maxon file or project directory to BUILD with this compiler and then debug. Mutually exclusive with `executable`."))
	startProps.push(list("args", description: "Command-line arguments passed to the program being debugged"))
	startProps.push(list("env", description: "Environment variables for the program being debugged, each spelled NAME=VALUE"))
	startProps.push(seconds(DebugStopTimeoutOption, description: "Seconds a command waits for the program to stop before reporting a timeout (default {DefaultStopTimeoutSeconds:.0}, {targetSecondsRange()})."))
	startProps.push(flag("trace", description: "Record the DebugStream ring, so `debug_trace` has events to report. A `source` is then built with --debugstream; an `executable` must already have been."))
	startProps.push(whole(DebugMaxProcsOption, description: "Pin the debuggee's scheduler to this many processors, through MAXON_MAX_PROCS.", least: LowestProcessorAsk, most: HighestProcessorAsk))
	startProps.push(childTimeoutProperty())
	tools.push(McpToolSpec.create(DebugStartToolName, description: "Launch a program under the debugger, parked before `main`. {DebugAnswerShape}", properties: startProps))

	var breakProps = McpPropertyArray.create()
	breakProps.push(str("target", description: "Where to break: {DebugBreakTargetSpellings}", required: true))
	breakProps.push(str("condition", description: "Break only when this holds, e.g. `i > 3`. The agent evaluates it itself."))
	tools.push(McpToolSpec.create(DebugBreakToolName, description: "Arm a breakpoint, optionally conditional. {DebugAnswerShape}", properties: breakProps))

	var clearProps = McpPropertyArray.create()
	clearProps.push(str("target", description: "The target the breakpoint was armed on: {DebugBreakTargetSpellings}", required: true))
	tools.push(McpToolSpec.create(DebugClearToolName, description: "Disarm a breakpoint. {DebugAnswerShape}", properties: clearProps))

	tools.push(McpToolSpec.create(DebugContinueToolName, description: "Let the program run: it STARTS a session that has not run yet, and resumes one that is stopped. {DebugAnswerShape}", properties: McpPropertyArray.create()))

	var stepProps = McpPropertyArray.create()
	stepProps.push(str("kind", description: "Which step: {joinedWith(debugWalkModePhrases(), separator: WordListSeparator)}. Default `{StepCommandWord}`."))
	tools.push(McpToolSpec.create(DebugStepToolName, description: "Advance the program one step. {DebugAnswerShape}", properties: stepProps))

	tools.push(McpToolSpec.create(DebugPauseToolName, description: "Interrupt a running program that stops on nothing. {DebugAnswerShape}", properties: McpPropertyArray.create()))
	tools.push(McpToolSpec.create(DebugBacktraceToolName, description: "Walk the stopped program's stack. {DebugAnswerShape}", properties: McpPropertyArray.create()))
	tools.push(McpToolSpec.create(DebugLocalsToolName, description: "Report every local of the stopped frame, with its value. {DebugAnswerShape}", properties: McpPropertyArray.create()))

	var evalProps = McpPropertyArray.create()
	evalProps.push(str("expression", description: "A local, or a dotted path through one, such as `config.retries`", required: true))
	tools.push(McpToolSpec.create(DebugEvalToolName, description: "Read one value out of the stopped frame. {DebugAnswerShape}", properties: evalProps))

	tools.push(McpToolSpec.create(DebugThreadsToolName, description: "List the program's green threads, with what each is doing. {DebugAnswerShape}", properties: McpPropertyArray.create()))

	var greenProps = McpPropertyArray.create()
	greenProps.push(str("action", description: "`select` a green thread, `clear` the selection, `park` one, `resume` one, or `backtrace` one", required: true))
	greenProps.push(str("thread", description: "The green-thread id `debug_threads` reported, or a selector. Not read by `clear`."))
	tools.push(McpToolSpec.create(DebugGreenThreadToolName, description: "Select, hold, release or walk one green thread. {DebugAnswerShape}", properties: greenProps))

	var traceProps = McpPropertyArray.create()
	traceProps.push(whole(TraceCountArgument, description: "How many of the most recent DebugStream events to report (default {DebugDefaultTraceEvents}). Needs a session started with `trace`.", least: LowestDebugTraceTally, most: HighestDebugTraceTally))
	tools.push(McpToolSpec.create(DebugTraceToolName, description: "Report the DebugStream events committed before the stop. {DebugAnswerShape}", properties: traceProps))

	tools.push(McpToolSpec.create(DebugStopToolName, description: "End the debug session and REAP the debuggee. {DebugAnswerShape}", properties: McpPropertyArray.create()))
end 'pushDebugTools'

export function findToolSpec(name String, devMode bool) returns McpToolSpec throws McpError
	for spec in mcpToolRoster() 'each'
		if spec.name.equals(name) and spec.visibleIn(devMode) 'hit'
			return spec
		end 'hit'
	end 'each'

	throw McpError.notFound
end 'findToolSpec'

// =============================================================================
// Argument validation
// =============================================================================

export union ArgumentFault
	unknown(key String, tool String)
	devOnly(key String, tool String)
	missing(key String, tool String)
	wrongType(key String, tool String, expected String)
	notAWholeNumberWithin(key String, tool String, least JsonInt, most JsonInt)
	notSecondsWithin(key String, tool String)
	wrongElementType(key String, tool String)
end 'ArgumentFault'

export function argumentFaultReason(fault ArgumentFault) returns String
	return match fault 'f'
		unknown(key, tool) gives "`{tool}` has no argument `{key}`. Setting an argument a tool does not read would be silently ignored, so it is refused instead."
		devOnly(key, tool) gives "`{key}` on `{tool}` is a compiler-contributor argument and this server was started without --dev."
		missing(key, tool) gives "`{tool}` requires the `{key}` argument."
		wrongType(key, tool, expected) gives "`{key}` on `{tool}` must be of type {expected}."
		notAWholeNumberWithin(key, tool, least, most) gives "`{key}` on `{tool}` must be a whole number from {least} to {most}."
		notSecondsWithin(key, tool) gives "{targetSecondsRefusal("`{key}` on `{tool}`")}."
		wrongElementType(key, tool) gives "`{key}` on `{tool}` must be a list of strings."
	end 'f'
end 'argumentFaultReason'

function requireOnlyStrings(doc JsonDoc, value JsonNode, key String, tool String) throws ArgumentFault
	if value.kind != JsonKind.jsonArray 'notAList'
		return
	end 'notAList'

	for childId in value.children 'eachElement'
		if doc.get(childId).kind != JsonKind.jsonString 'notAString'
			throw ArgumentFault.wrongElementType(key, tool: tool)
		end 'notAString'
	end 'eachElement'
end 'requireOnlyStrings'

function requireWholeWithin(value JsonNode, key String, tool String, least JsonInt, most JsonInt) throws ArgumentFault
	if value.kind != JsonKind.jsonNumber 'anotherSpelling'
		return
	end 'anotherSpelling'

	if not isWholeWithin(value.numberValue as AskedNumber, least: least as WholeBound, most: most as WholeBound) 'outside'
		throw ArgumentFault.notAWholeNumberWithin(key, tool: tool, least: least, most: most)
	end 'outside'
end 'requireWholeWithin'

function requireSecondsWithin(value JsonNode, key String, tool String) throws ArgumentFault
	match targetSecondsReading(value.numberValue as AskedSeconds) 'read'
		reading then break 'read'
		refused then throw ArgumentFault.notSecondsWithin(key, tool: tool)
	end 'read'
end 'requireSecondsWithin'

function findProperty(spec McpToolSpec, key String) returns McpProperty throws McpError
	for prop in spec.properties 'each'
		if prop.name.equals(key) 'hit'
			return prop
		end 'hit'
	end 'each'

	throw McpError.notFound
end 'findProperty'

export function validateToolArguments(doc JsonDoc, args OptionalNode, spec McpToolSpec, devMode bool) throws ArgumentFault
	let present = argumentsGiven(args)
	let argsId = argumentsNode(args)

	if present 'checkArrivals'
		let node = doc.get(argsId)

		for (iter, key) in node.keys.withIterator() 'eachArrival'
			let prop = try findProperty(spec, key: key) otherwise throw ArgumentFault.unknown(key, tool: spec.name)

			if prop.devOnly and not devMode 'refusedInUserMode'
				throw ArgumentFault.devOnly(key, tool: spec.name)
			end 'refusedInUserMode'

			let valueId = try node.children.get(iter.index()) otherwise panic("validateToolArguments: keys and children disagree in length")

			let value = doc.get(valueId)

			if not prop.accepts(value.kind) 'wrongShape'
				throw ArgumentFault.wrongType(key, tool: spec.name, expected: prop.acceptedTypes())
			end 'wrongShape'

			match prop.kind 'bounds'
				text or
					flag then break 'bounds'
				textList or
					textOrTextList then try requireOnlyStrings(doc, value: value, key: key, tool: spec.name)
				wholeNumber(least, most, _) then try requireWholeWithin(value, key: key, tool: spec.name, least: least, most: most)
				seconds then try requireSecondsWithin(value, key: key, tool: spec.name)
			end 'bounds'
		end 'eachArrival'
	end 'checkArrivals'

	for prop in spec.properties 'eachRequired'
		if not prop.required 'optional'
			continue
		end 'optional'

		if not present or not objectHasKey(doc, parent: argsId, key: prop.name) 'absent'
			throw ArgumentFault.missing(prop.name, tool: spec.name)
		end 'absent'
	end 'eachRequired'
end 'validateToolArguments'
