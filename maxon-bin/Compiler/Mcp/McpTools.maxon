// Running the compiler on a caller's behalf, and shaping what it said into JSON.

let StdlibRootUnresolved = "unresolved — this compiler does not sit inside a tree holding stdlib/, so it can compile nothing"

let ScaleResultStem = "scale-result"
let SpecResultStem = "spec-result"
let ResultExtension = ".json"
let SnippetStem = "mcp-snippet"
let SnippetExtension = ".maxon"
let SnippetStagedSeparator = "."
let StagedNameSeparator = "-"
let FromArgument = "from"

module let ChildTimeoutOption = "timeoutSeconds"
module let WorkersOption = "workers"
module let MaxFailuresOption = "maxFailures"
module let CasesOption = "cases"
module let RungsOption = "rungs"
module let RepeatOption = "repeat"
module let FilterOption = "filter"
module let TargetOption = "target"
module let RebuildOption = "rebuild"
module let LogOption = "log"
module let NoteOption = "note"
module let EmitCorpusOption = "emitCorpus"

typealias StagedSerial = int(0 to u64.max)

// =============================================================================
// Spawning
// =============================================================================

// `repoRootLabel` is `host` exactly when the tool acts in the host's working directory: there is no
// tree to name, and every answer leaves the key out rather than reporting an empty one
// (`addRepoRootIfKnown`).
module type ToolContext
	export var compiler as FilePath
	export var workingDir as FilePath
	export var repoRootLabel as ActingTree
	export var timeoutMs as DurationMs

	static function hostRelative(compiler FilePath) returns ToolContext
		return Self{compiler: compiler, workingDir: currentDirPath(), repoRootLabel: ActingTree.host, timeoutMs: CompilerChildTimeoutMs}
	end 'hostRelative'

	static function inTree(compiler FilePath, repoRoot FilePath) returns ToolContext
		return Self{compiler: compiler, workingDir: repoRoot, repoRootLabel: ActingTree.tree(repoRoot.path), timeoutMs: CompilerChildTimeoutMs}
	end 'inTree'

	function boundedBy(bound DurationMs) returns ToolContext
		return Self{compiler: self.compiler, workingDir: self.workingDir, repoRootLabel: self.repoRootLabel.clone(), timeoutMs: bound}
	end 'boundedBy'
end 'ToolContext'

typealias ToolAnswer = function(StringArray, CollectedOutput, DurationMs) returns String
module typealias ToolWithin = function(JsonDoc, JsonNodeId, OptionalNode, ToolContext) returns String

function runCompilerThen(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, what String, answer ToolAnswer) returns String
	let startTime = Clock.nowMs()

	let res = try Subprocess.run(Executable.path(ctx.compiler), arguments: argv, workingDirectory: ctx.workingDir, timeoutMs: ctx.timeoutMs) otherwise (err) 'unfinished'
		return toolErrorText(reqDoc, idNode: idNode, message: unfinishedChildReason(err, doing: "run {what}"), repoRoot: ctx.repoRootLabel)
	end 'unfinished'

	return answer(argv, res, Clock.elapsedMs(startTime))
end 'runCompilerThen'

function reportSubprocess(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, res CollectedOutput) returns String
	let payload = formatSubprocessResult(res, command: formatArgv(ctx.compiler, argv: argv), repoRoot: ctx.repoRootLabel)
	return toolResultText(reqDoc, idNode: idNode, payloadText: payload, isError: not res.succeeded())
end 'reportSubprocess'

function runAndReport(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, what String) returns String
	return runCompilerThen(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: what, answer: function(ranArgv StringArray, res CollectedOutput, _ DurationMs) gives reportSubprocess(reqDoc, idNode: idNode, ctx: ctx, argv: ranArgv, res: res))
end 'runAndReport'

module function withinContext(context TreeContext, reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, tool ToolWithin) returns String
	return match context 'tree'
		answered(reply) gives reply
		usable(ctx) gives tool(reqDoc, idNode, args, ctx.boundedBy(childTimeoutMsOf(reqDoc, args: args, unasked: ctx.timeoutMs)))
	end 'tree'
end 'withinContext'

function addTimedRunFields(doc JsonDoc, payload JsonObjectBuilder, ctx ToolContext, argv StringArray, res CollectedOutput, durationMs DurationMs)
	addRunFields(doc, payload: payload, command: formatArgv(ctx.compiler, argv: argv), repoRoot: ctx.repoRootLabel, res: res)
	payload.addNumber(doc, key: "durationMs", value: durationMs as JsonFloat)
	payload.addString(doc, key: "rawTail", value: lastBytes(combineStreams(res.stdout, stderr: res.stderr), max: RawTailMaxBytes))
end 'addTimedRunFields'

// =============================================================================
// Inline snippets
// =============================================================================

union StagedSnippet
	staged(path FilePath)
	refused(reason String)
end 'StagedSnippet'

// Staged in Maxon's cache directory on this host, never in or beside the caller's project: a tool
// has no business writing there, and `maxon cache clear` could not reach it.
function stageSnippet(source String) returns StagedSnippet
	let root = try hostCacheRoot() otherwise (e) 'noRoot'
		return StagedSnippet.refused("this host has no cache directory to stage it in ({e.name})")
	end 'noRoot'

	let dir = StagedFamily.snippet.directoryUnder(root)

	if not Directory.create(dir) 'unusable'
		return StagedSnippet.refused("could not create {dir.path}")
	end 'unusable'

	let file = try StagedFamily.snippet.reserveIn(dir, content: source) otherwise (e) 'unwritten'
		return StagedSnippet.refused("could not write it into {dir.path} ({e.name})")
	end 'unwritten'

	return StagedSnippet.staged(file)
end 'stageSnippet'

enum StagedFamily
	snippet
	specResult
	scaleResult

	function stem() returns String
		return match self 'family'
			snippet gives SnippetStem
			specResult gives SpecResultStem
			scaleResult gives ScaleResultStem
		end 'family'
	end 'stem'

	function suffix() returns String
		return match self 'family'
			snippet gives SnippetExtension
			specResult or
				scaleResult gives ResultExtension
		end 'family'
	end 'suffix'

	function directoryUnder(root FilePath) returns FilePath
		return match self 'family'
			snippet gives childPath(root, segment: SnippetStem)
			specResult gives childPath(root, segment: SpecScratchDirName)
			scaleResult gives childPath(root, segment: ScaleCorpusDirName)
		end 'family'
	end 'directoryUnder'

	function prefix() returns String
		return "{self.stem()}{StagedNameSeparator}"
	end 'prefix'

	function livenessOf(name String) returns OwnerLiveness
		if not name.startsWith(self.prefix()) 'notStagedHere'
			return OwnerLiveness.notOwned
		end 'notStagedHere'

		let owner = try name.replaceFirst(self.prefix(), with: "").split(StagedNameSeparator).get(0) otherwise panic("StagedFamily.livenessOf: a split answers at least one piece")

		return livenessOfOwner(ownerProcessNamed(owner))
	end 'livenessOf'

	function reserveIn(dir FilePath, content String) returns FilePath throws FileWriteError
		var serial = Clock.nowNanos() as StagedSerial

		while true 'untilReserved'
			let candidate = childPath(dir, segment: "{self.prefix()}{__Builtins.currentProcessId()}{StagedNameSeparator}{serial}{self.suffix()}")

			try File.createText(candidate, content: content) otherwise (e) 'notCreated'
				if e != FileWriteError.alreadyExists 'unusable'
					throw e
				end 'unusable'

				serial = serial + 1
				continue
			end 'notCreated'

			return candidate
		end 'untilReserved'

		panic("StagedFamily.reserveIn: the search returns from inside its loop")
	end 'reserveIn'
end 'StagedFamily'

export function sweepStaleSnippets()
	let root = try hostCacheRoot() otherwise return
	sweepLeftoversOfEndedOwners(StagedFamily.snippet.directoryUnder(root), livenessOf: function(name) gives StagedFamily.snippet.livenessOf(name), keyOf: snippetSourceOf, discardKeyed: discardSnippet)
end 'sweepStaleSnippets'

function snippetSourceOf(staged FilePath) returns FilePath
	let name = staged.filename()
	let stemEnds = try name.findFirst(SnippetStagedSeparator) otherwise name.endIndex()
	let directory = try staged.parent() otherwise panic("snippetSourceOf: {staged.path} was listed inside the snippet directory")

	return directory.join("{name.slice(name.startIndex(), endIndex: stemEnds)}{SnippetExtension}")
end 'snippetSourceOf'

function discardSnippet(source FilePath)
	let slot = discardRunSlotOf(source, entryFunction: MainFunctionName)
	let stem = pathWithoutSuffix(source, suffix: SnippetExtension)
	let stemName = stem.filename()

	discardBuildRecordsNamed(stem)

	let directory = try source.parent() otherwise panic("discardSnippet: {source.path} was staged inside the snippet directory")
	let entries = try Directory.list(directory) otherwise (e) 'unlisted'
		printError("maxon: could not list {directory.path} to delete what a snippet call staged there ({e.name}); the next server's sweep removes it once its owner has ended\n")

		return
	end 'unlisted'

	var productsRemain = slot == RunSlotDiscard.keptInPlace

	for entry in entries 'eachStaged'
		let name = entry.filename()

		if entry.equals(source) or not (name == stemName or name.startsWith("{stemName}{SnippetStagedSeparator}")) 'notThisCallsProduct'
			continue
		end 'notThisCallsProduct'

		removeOwnedFile(entry)
		productsRemain = productsRemain or File.exists(entry)
	end 'eachStaged'

	// The source is the key `sweepStaleSnippets` discards the run-cache slot by, so it stays while
	// anything this call could not remove does.
	if productsRemain 'keptForTheNextSweep'
		return
	end 'keptForTheNextSweep'

	removeOwnedFile(source)
end 'discardSnippet'

// Whether naming nothing is allowed is each tool's question, so this reports what arrived and each
// tool decides, rather than taking a flag that changes what it means.
type SourceTarget
	export var file as FilePath
	export var error as String
	export var named as bool
	export var isSnippet as bool

	static function nothing() returns SourceTarget
		return Self{file: currentDirPath(), error: "", named: false, isSnippet: false}
	end 'nothing'

	static function at(file FilePath) returns SourceTarget
		return Self{file: file, error: "", named: true, isSnippet: false}
	end 'at'

	static function staged(file FilePath) returns SourceTarget
		return Self{file: file, error: "", named: true, isSnippet: true}
	end 'staged'

	static function refused(reason String) returns SourceTarget
		return Self{file: currentDirPath(), error: reason, named: false, isSnippet: false}
	end 'refused'

	function ok() returns bool
		return self.error.isEmpty()
	end 'ok'

	export function answeredWith(reply String) returns String
		if self.isSnippet 'aStagedSnippet'
			discardSnippet(self.file)
		end 'aStagedSnippet'

		return reply
	end 'answeredWith'
end 'SourceTarget'

function resolveSourceTarget(reqDoc JsonDoc, args OptionalNode) returns SourceTarget
	// A tool silently preferring one would act on something the caller did not name.
	let source = statedTextArg(reqDoc, args: args, key: "source")
	let path = statedTextArg(reqDoc, args: args, key: "path")

	if path.isStated() and source.isStated() 'both'
		return SourceTarget.refused("`path` and `source` are mutually exclusive — give one.")
	end 'both'

	if let sourceArg = try source.text() 'inline'
		return match stageSnippet(sourceArg) 'staging'
			staged(file) gives SourceTarget.staged(file)
			refused(reason) gives SourceTarget.refused("could not stage the inline source: {reason}")
		end 'staging'
	end 'inline'

	// `.` names the working directory, which is what naming nothing already means.
	let pathArg = try path.text() otherwise return SourceTarget.nothing()

	if pathArg.equals(".") 'unnamed'
		return SourceTarget.nothing()
	end 'unnamed'

	let resolved = try FilePath.from(pathArg) otherwise return SourceTarget.refused("`{pathArg}` is not a valid filesystem path")
	return SourceTarget.at(resolved)
end 'resolveSourceTarget'

// =============================================================================
// Standard tools
// =============================================================================

function treeCompilerOf(reqDoc JsonDoc, args OptionalNode) returns TreeCompiler
	let fromArg = try statedStringArg(reqDoc, args: args, key: FromArgument) otherwise return TreeCompiler.ownSlot
	return TreeCompiler.named(fromArg)
end 'treeCompilerOf'

module function buildToolContext(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath, devMode bool) returns TreeContext
	if not devMode 'hostOnly'
		return TreeContext.usable(ToolContext.hostRelative(exePath))
	end 'hostOnly'

	// `from` names the compiler to build WITH — the seed case, where the tree's own slot may be
	// empty precisely because that is what is being fixed.
	return resolveTreeContext(reqDoc, idNode: idNode, args: args, exePath: exePath, compiler: treeCompilerOf(reqDoc, args: args))
end 'buildToolContext'

module function executeBuildToolWithin(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext) returns String
	let target = resolveSourceTarget(reqDoc, args: args)

	if not target.ok() 'badSource'
		return toolErrorText(reqDoc, idNode: idNode, message: "build: {target.error}", repoRoot: ctx.repoRootLabel)
	end 'badSource'

	var argv = StringArray.create()
	argv.push(BuildSubcommandName)

	// Naming nothing is legal here: it builds the working directory's manifest.
	if target.named 'hasSource'
		argv.push(target.file.path)
	end 'hasSource'

	if let outputArg = try statedStringArg(reqDoc, args: args, key: "output") 'hasOut'
		argv.push("{OutputFlagPrefix}{outputArg}")
	end 'hasOut' else if target.isSnippet 'besideTheSnippet'
		argv.push("{OutputFlagPrefix}{pathWithoutSuffix(target.file, suffix: SnippetExtension).path}")
	end 'besideTheSnippet'

	// A triple is a flag and a target name a positional: `maxon build` reads a bare word as a target
	// or else a source path, so a triple pushed positionally would compile a file named `wasm32-wasi`.
	if let targetArg = try statedStringArg(reqDoc, args: args, key: TargetOption) 'hasTgt'
		match parseBuildTarget(targetArg) 'targetKind'
			resolved then argv.push("{TargetFlagPrefix}{targetArg}")
			unrecognized then argv.push(targetArg)
		end 'targetKind'
	end 'hasTgt'

	if getOptionalBoolArg(reqDoc, args: args, key: "emitIr", defaultVal: false) 'hasIr'
		argv.push(EmitIrFlag)
	end 'hasIr'

	if getOptionalBoolArg(reqDoc, args: args, key: RebuildOption, defaultVal: false) 'rebuilds'
		argv.push(RebuildFlag)
	end 'rebuilds'

	return target.answeredWith(runAndReport(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: BuildSubcommandName))
end 'executeBuildToolWithin'

module function executeExecuteToolWithin(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext) returns String
	let target = resolveSourceTarget(reqDoc, args: args)

	if not target.ok() 'bad'
		return toolErrorText(reqDoc, idNode: idNode, message: "execute: {target.error}", repoRoot: ctx.repoRootLabel)
	end 'bad'

	if not target.named 'nothingToRun'
		return toolErrorText(reqDoc, idNode: idNode, message: "execute: give either `path` or `source`.", repoRoot: ctx.repoRootLabel)
	end 'nothingToRun'

	var argv = StringArray.create()
	argv.push(ExecuteCommandName)
	argv.push(target.file.path)

	for a in getOptionalStringListArg(reqDoc, args: args, key: "arguments") 'each'
		argv.push(a)
	end 'each'

	return target.answeredWith(runAndReport(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: "the program"))
end 'executeExecuteToolWithin'

module function numberAskOf(reqDoc JsonDoc, args OptionalNode, key String) returns NumberAsk
	return match args 'a'
		none gives NumberAsk.absent
		some(id) gives (try numberAskIn(reqDoc, node: id, key: key) otherwise panic("numberAskOf: `{key}` passed the roster's number check before it was read"))
	end 'a'
end 'numberAskOf'

module function childTimeoutMsOf(reqDoc JsonDoc, args OptionalNode, unasked DurationMs) returns DurationMs
	return match numberAskOf(reqDoc, args: args, key: ChildTimeoutOption) 'bound'
		absent gives unasked
		given(seconds) gives stopTimeoutMsOf(boundSecondsOf(targetSecondsReading(seconds.value as AskedSeconds))) as DurationMs
	end 'bound'
end 'childTimeoutMsOf'

function boundSecondsOf(parse TargetSecondsParse) returns TargetSeconds
	return match parse 'read'
		refused panic("boundSecondsOf: `{ChildTimeoutOption}` passed the roster's seconds check before it was read")
		reading(value) gives value.seconds
	end 'read'
end 'boundSecondsOf'

module function executeTestToolWithin(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext) returns String
	var argv = StringArray.create()
	argv.push(TestCommandName)

	let pathArg = getOptionalStringArg(reqDoc, args: args, key: "path", defaultVal: ".")

	if not pathArg.isEmpty() and not pathArg.equals(".") 'hasPath'
		argv.push(pathArg)
	end 'hasPath'

	argv.append(valuedOptionOf(reqDoc, args: args, key: FilterOption, prefix: FilterFlagPrefix))

	return runAndReport(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: "tests")
end 'executeTestToolWithin'

function valuedOptionOf(reqDoc JsonDoc, args OptionalNode, key String, prefix String) returns StringArray
	let value = try statedStringArg(reqDoc, args: args, key: key) otherwise return StringArray.create()
	return ["{prefix}{value}"]
end 'valuedOptionOf'

function wholeOptionOf(reqDoc JsonDoc, args OptionalNode, key String, prefix String) returns StringArray
	return match optionalWholeArg(reqDoc, args: args, key: key) 'whole'
		absent gives StringArray.create()
		given(value) gives ["{prefix}{value}"]
	end 'whole'
end 'wholeOptionOf'

module function executeFmtToolWithin(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext) returns String
	let target = resolveSourceTarget(reqDoc, args: args)

	if not target.ok() 'badSource'
		return toolErrorText(reqDoc, idNode: idNode, message: "fmt: {target.error}", repoRoot: ctx.repoRootLabel)
	end 'badSource'

	var argv = StringArray.create()
	argv.push(FmtCommandName)

	// ⚠ With no path `fmt` formats the whole working directory. That is its documented default.
	if target.named 'hasPath'
		argv.push(target.file.path)
	end 'hasPath'

	if not target.isSnippet 'inPlace'
		return runAndReport(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: FmtCommandName)
	end 'inPlace'

	// A snippet is formatted in its scratch file and read back: `fmt` rewrites in place and prints
	// nothing, so the formatted text is the file's new contents.
	return target.answeredWith(formatStagedSnippet(reqDoc, idNode: idNode, ctx: ctx, argv: argv, staged: target.file))
end 'executeFmtToolWithin'

function formatStagedSnippet(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, staged FilePath) returns String
	return runCompilerThen(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: FmtCommandName, answer: function(ranArgv StringArray, res CollectedOutput, _ DurationMs) gives formattedSnippetReply(reqDoc, idNode: idNode, ctx: ctx, argv: ranArgv, staged: staged, res: res))
end 'formatStagedSnippet'

function formattedSnippetReply(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, staged FilePath, res CollectedOutput) returns String
	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	var succeeded = res.succeeded()

	if succeeded 'readBack'
		if let formatted = try File.readText(staged) 'wasRead'
			payload.addString(doc, key: "formatted", value: formatted)
		end 'wasRead' else 'unread'
			succeeded = false
			payload.addString(doc, key: "error", value: "fmt succeeded, but the formatted snippet could not be read back from {staged.path}")
		end 'unread'
	end 'readBack'

	payload.addBool(doc, key: "success", value: succeeded)
	addRunFields(doc, payload: payload, command: formatArgv(ctx.compiler, argv: argv), repoRoot: ctx.repoRootLabel, res: res)
	payload.addString(doc, key: "stderr", value: res.stderr)

	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: not succeeded)
end 'formattedSnippetReply'

// What `check` and `dump_ir` compiled. `diagnostics` is the text the command line would have printed on
// stderr for the same build.
union InProcessCompile
	compiled(project Project, codeResult CodeResult, diagnostics String)
	refused(diagnostics String)
end 'InProcessCompile'

// ⭐ **`check` AND `dump_ir` COMPILE IN THIS PROCESS, AND WRITE NOTHING.** Both answer a question about a
// program rather than producing or running one, so there is no binary, no `.ir` file and no child whose
// output has to be read back: the pipeline stops at a `CodeResult`, exactly as `maxon lsp-server` compiles
// a buffer. The capture keeps the pipeline's diagnostics off this server's own streams.
function compileInProcess(reqDoc JsonDoc, args OptionalNode, rendersTargetIr bool, fileMemos SharedFileMemoMap) returns InProcessCompile
	let pathArg = requiredStringArg(reqDoc, args: args, key: "path")
	var session = CompileSession.create(DiagnosticSink.capturing(), fileMemos: fileMemos, treeLock: LockHold.none())

	let path = try FilePath.from(pathArg) otherwise 'badPath'
		session.diagnostics.emit("error: invalid path: {pathArg}")
		return InProcessCompile.refused(session.diagnostics.text())
	end 'badPath'

	var paths = MaxonSourcePathArray.create()
	paths.push(path)

	var project = try loadProject(paths, target: detectHostTarget(), session: session) otherwise (e) 'notLoaded'
		reportCompileError(e, sink: session.diagnostics)
		return InProcessCompile.refused(session.diagnostics.text())
	end 'notLoaded'

	project.rendersTargetIr = rendersTargetIr

	return match checkWithoutWriting(project) 'compile'
		compiled(codeResult) gives InProcessCompile.compiled(project, codeResult: codeResult, diagnostics: session.diagnostics.text())
		refused gives InProcessCompile.refused(session.diagnostics.text())
	end 'compile'
end 'compileInProcess'

// `success` and `diagnostics`, which both answers carry. Answers whether the compile succeeded.
function addCompileOutcome(doc JsonDoc, payload JsonObjectBuilder, compile InProcessCompile) returns bool
	let (succeeded, diagnostics) = match compile 'outcome'
		compiled(_, _, text) gives (true, text)
		refused(text) gives (false, text)
	end 'outcome'

	payload.addBool(doc, key: "success", value: succeeded)
	payload.addString(doc, key: "diagnostics", value: diagnostics)
	return succeeded
end 'addCompileOutcome'

function stdlibRootLabel() returns String
	let located = try locateStdlibDir() otherwise return StdlibRootUnresolved
	return located.toString()
end 'stdlibRootLabel'

// `check` and `dump_ir` compile IN this process, so they can honour no `repoRoot` and nothing else in their
// answer says whose verdict it is. One server serves every worktree, so without these two fields a diagnostic
// read in one tree cannot be attributed to the compiler and the library tier that produced it.
function addInProcessAttribution(doc JsonDoc, payload JsonObjectBuilder, exePath FilePath)
	payload.addString(doc, key: "executable", value: exePath.toString())
	payload.addString(doc, key: "stdlibRoot", value: stdlibRootLabel())
end 'addInProcessAttribution'

export function executeCheckTool(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath, fileMemos SharedFileMemoMap) returns String
	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	let succeeded = addCompileOutcome(doc, payload: payload, compile: compileInProcess(reqDoc, args: args, rendersTargetIr: false, fileMemos: fileMemos))
	addInProcessAttribution(doc, payload: payload, exePath: exePath)

	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: not succeeded)
end 'executeCheckTool'

export function executeDumpIrTool(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath, fileMemos SharedFileMemoMap) returns String
	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	let compile = compileInProcess(reqDoc, args: args, rendersTargetIr: true, fileMemos: fileMemos)
	let succeeded = addCompileOutcome(doc, payload: payload, compile: compile)
	addInProcessAttribution(doc, payload: payload, exePath: exePath)

	let irText = match compile 'ir'
		compiled(project, codeResult, _) gives try renderTargetIr(project, codeResult: codeResult) otherwise panic("executeDumpIrTool: the tool names no runtime function to render, so the render has nothing to refuse")
		refused gives ""
	end 'ir'

	payload.addString(doc, key: "ir", value: irText)
	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: not succeeded)
end 'executeDumpIrTool'

export function executeInfoTool(reqDoc JsonDoc, idNode JsonNodeId, exePath FilePath) returns String
	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	payload.addBool(doc, key: "success", value: true)
	payload.addString(doc, key: "name", value: CompilerProductName)
	payload.addString(doc, key: "version", value: CompilerVersion)
	payload.addString(doc, key: "commit", value: CompilerCommit)
	payload.addString(doc, key: "commitDate", value: CompilerCommitDate)
	payload.addString(doc, key: "executable", value: exePath.toString())
	payload.addString(doc, key: "hostTarget", value: targetToString(detectHostTarget()))

	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: false)
end 'executeInfoTool'

// =============================================================================
// Contributor tools
// =============================================================================

module union TreeContext
	usable(ctx ToolContext)
	answered(reply String)
end 'TreeContext'

module union TreeCompiler
	ownSlot
	named(spelling String)
end 'TreeCompiler'

// The tree's own compiler unless `from` names one: this server's binary run against another tree's
// sources would compile them against this checkout's `stdlib/` and `runtime/`.
module function resolveTreeContext(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath, compiler TreeCompiler) returns TreeContext
	let root = resolveTargetRepoRoot(reqDoc, args: args, exePath: exePath)

	if not root.ok() 'badRoot'
		return TreeContext.answered(toolErrorText(reqDoc, idNode: idNode, message: root.error, repoRoot: ActingTree.host))
	end 'badRoot'

	return match compiler 'which'
		ownSlot gives slotCompilerContext(reqDoc, idNode: idNode, repoRoot: root.path)
		named(spelling) gives namedCompilerContext(reqDoc, idNode: idNode, repoRoot: root.path, spelling: spelling)
	end 'which'
end 'resolveTreeContext'

function slotCompilerContext(reqDoc JsonDoc, idNode JsonNodeId, repoRoot FilePath) returns TreeContext
	let binary = try compilerBinary(repoRoot) otherwise 'notBuilt'
		return TreeContext.answered(toolErrorText(reqDoc, idNode: idNode, message: compilerBinaryMissingReason(repoRoot), repoRoot: ActingTree.tree(repoRoot.path)))
	end 'notBuilt'

	return TreeContext.usable(ToolContext.inTree(binary, repoRoot: repoRoot))
end 'slotCompilerContext'

function namedCompilerContext(reqDoc JsonDoc, idNode JsonNodeId, repoRoot FilePath, spelling String) returns TreeContext
	let candidate = try FilePath.from(spelling) otherwise 'badFrom'
		return TreeContext.answered(toolErrorText(reqDoc, idNode: idNode, message: "`{FromArgument}` is not a valid filesystem path: {spelling}", repoRoot: ActingTree.tree(repoRoot.path)))
	end 'badFrom'

	if not File.exists(candidate) 'noFrom'
		return TreeContext.answered(toolErrorText(reqDoc, idNode: idNode, message: "compiler binary in `{FromArgument}` does not exist: {spelling}", repoRoot: ActingTree.tree(repoRoot.path)))
	end 'noFrom'

	return TreeContext.usable(ToolContext.inTree(candidate, repoRoot: repoRoot))
end 'namedCompilerContext'

// ⚠ An absent `repoRoot` means the host's working directory, not this server's own checkout:
// `execute`, `test` and `fmt` resolve their paths against the caller's cwd, so falling back to the
// tree this binary sits in would run the command somewhere the argument was never written for.
module function hostOrTreeContext(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, exePath FilePath) returns TreeContext
	if not statedTextArg(reqDoc, args: args, key: "repoRoot").isStated() 'noTreeNamed'
		return TreeContext.usable(ToolContext.hostRelative(exePath))
	end 'noTreeNamed'

	return resolveTreeContext(reqDoc, idNode: idNode, args: args, exePath: exePath, compiler: TreeCompiler.ownSlot)
end 'hostOrTreeContext'

module function executeSpecTestToolWithin(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext) returns String
	let dirArg = getOptionalStringArg(reqDoc, args: args, key: "directory", defaultVal: DefaultSpecDir)

	match specToolArgv(reqDoc, idNode: idNode, args: args, ctx: ctx, directory: dirArg) 'argv'
		refused(reply) then return reply
		built(argv) then return runWithResultDocument(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: SpecTestCommandName, family: StagedFamily.specResult, answer: function(parsed JsonDoc, ranArgv StringArray, res CollectedOutput, took DurationMs) gives specReportReply(reqDoc, idNode: idNode, args: args, ctx: ctx, parsed: parsed, argv: ranArgv, res: res, durationMs: took))
	end 'argv'
end 'executeSpecTestToolWithin'

union SpecToolArgv
	built(argv StringArray)
	refused(reply String)
end 'SpecToolArgv'

function specToolArgv(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext, directory String) returns SpecToolArgv
	let filterPatterns = getOptionalStringListArg(reqDoc, args: args, key: FilterOption) as FilterPatternArray

	return match specFilterVerdict(filterPatterns) 'filter'
		usable gives SpecToolArgv.built(specTestArgv(reqDoc, args: args, directory: directory, filterPatterns: filterPatterns))
		refused(reason) gives SpecToolArgv.refused(toolErrorText(reqDoc, idNode: idNode, message: reason, repoRoot: ctx.repoRootLabel))
	end 'filter'
end 'specToolArgv'

union SpecFilterVerdict
	usable
	refused(reason String)
end 'SpecFilterVerdict'

function specFilterVerdict(patterns FilterPatternArray) returns SpecFilterVerdict
	for pattern in patterns 'eachPattern'
		if pattern.isEmpty() 'emptyPattern'
			return SpecFilterVerdict.refused("{SpecTestToolName}: `{FilterOption}` holds an empty pattern, which would select every case.")
		end 'emptyPattern'
	end 'eachPattern'

	return SpecFilterVerdict.usable
end 'specFilterVerdict'

function specTestArgv(reqDoc JsonDoc, args OptionalNode, directory String, filterPatterns FilterPatternArray) returns StringArray
	var argv = StringArray.create()
	argv.push(SpecTestCommandName)

	let updateRequired = getOptionalBoolArg(reqDoc, args: args, key: "updateRequired", defaultVal: false)
	let batchRuns = getOptionalBoolArg(reqDoc, args: args, key: "batch", defaultVal: true)
	let includeNetwork = getOptionalBoolArg(reqDoc, args: args, key: "network", defaultVal: false)
	argv.append(specSelectionArgv(directory, filterPatterns: filterPatterns, mode: SpecRunMode.create(updateRequired, batchRuns: batchRuns), includeNetwork: includeNetwork))

	argv.append(valuedOptionOf(reqDoc, args: args, key: TargetOption, prefix: TargetFlagPrefix))
	argv.append(wholeOptionOf(reqDoc, args: args, key: WorkersOption, prefix: WorkersFlagPrefix))
	argv.append(valuedOptionOf(reqDoc, args: args, key: LogOption, prefix: LogFlagPrefix))

	return argv
end 'specTestArgv'

typealias ResultAnswer = function(JsonDoc, StringArray, CollectedOutput, DurationMs) returns String

union ResultText
	found(text String)
	missing
	unreadable(reason String)
end 'ResultText'

// Each call reads only the document it reserved: one server serves many agents, other servers and
// CLI runs act on the same tree, and a spec dir outside a checkout takes no tree lock. At a shared
// path, a run refused on a busy lock would answer with the lock holder's document.
function runWithResultDocument(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, what String, family StagedFamily, answer ResultAnswer) returns String
	let resultDir = family.directoryUnder(ctx.workingDir)

	if not Directory.create(resultDir) 'unusable'
		return toolErrorText(reqDoc, idNode: idNode, message: "{what}: could not create {resultDir.path}, where the run's result document is written.", repoRoot: ctx.repoRootLabel)
	end 'unusable'

	let resultPath = try family.reserveIn(resultDir, content: "") otherwise (e) 'unreserved'
		return toolErrorText(reqDoc, idNode: idNode, message: "{what}: could not reserve a name for the run's result document in {resultDir.path} ({e.name}).", repoRoot: ctx.repoRootLabel)
	end 'unreserved'

	sweepLeftoversOfEndedOwners(resultDir, livenessOf: function(entry) gives family.livenessOf(entry), keyOf: function(entry) gives entry, discardKeyed: removeOwnedFile)

	var ranArgv = StringArray.create()
	ranArgv.append(argv)
	ranArgv.push("{ResultJsonFlagPrefix}{resultPath.path}")

	let readFrom = resultPath.clone()
	let reply = runCompilerThen(reqDoc, idNode: idNode, ctx: ctx, argv: ranArgv, what: what, answer: function(shownArgv StringArray, res CollectedOutput, took DurationMs) gives resultDocumentReply(reqDoc, idNode: idNode, ctx: ctx, argv: shownArgv, res: res, durationMs: took, what: what, resultPath: readFrom, answer: answer))

	removeOwnedFile(resultPath)

	return reply
end 'runWithResultDocument'

function readResultText(path FilePath) returns ResultText
	if not File.exists(path) 'absent'
		return ResultText.missing
	end 'absent'

	let text = try File.readText(path) otherwise (e) 'unread'
		return ResultText.unreadable(e.name)
	end 'unread'

	if text.isEmpty() 'onlyTheReservation'
		return ResultText.missing
	end 'onlyTheReservation'

	return ResultText.found(text)
end 'readResultText'

function resultDocumentReply(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, res CollectedOutput, durationMs DurationMs, what String, resultPath FilePath, answer ResultAnswer) returns String
	return match readResultText(resultPath) 'document'
		missing gives unusableResultReply(reqDoc, idNode: idNode, ctx: ctx, argv: argv, res: res, durationMs: durationMs, why: noResultDocumentText(what, exitCode: res.exitCode() as ExitCode))
		unreadable(reason) gives unusableResultReply(reqDoc, idNode: idNode, ctx: ctx, argv: argv, res: res, durationMs: durationMs, why: "{what}: could not read {resultPath.path} ({reason})")
		found(text) gives parsedResultReply(reqDoc, idNode: idNode, ctx: ctx, argv: argv, res: res, durationMs: durationMs, what: what, text: text, answer: answer)
	end 'document'
end 'resultDocumentReply'

function noResultDocumentText(what String, exitCode ExitCode) returns String
	if exitCode == 0 'exitedCleanly'
		return "{what} exited 0 without writing a result document. The tail of its output is in `rawTail`."
	end 'exitedCleanly'

	return "{what} exited {exitCode} before writing a result document. The tail of its output is in `rawTail`."
end 'noResultDocumentText'

function parsedResultReply(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, res CollectedOutput, durationMs DurationMs, what String, text String, answer ResultAnswer) returns String
	let parsed = try Json.parse(text) otherwise return unusableResultReply(reqDoc, idNode: idNode, ctx: ctx, argv: argv, res: res, durationMs: durationMs, why: "{what}'s result document is not valid JSON.")

	return answer(parsed, argv, res, durationMs)
end 'parsedResultReply'

function unusableResultReply(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, res CollectedOutput, durationMs DurationMs, why String) returns String
	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	addTimedRunFields(doc, payload: payload, ctx: ctx, argv: argv, res: res, durationMs: durationMs)
	payload.addBool(doc, key: "success", value: false)
	payload.addString(doc, key: "error", value: why)

	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: true)
end 'unusableResultReply'

function specReportReply(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext, parsed JsonDoc, argv StringArray, res CollectedOutput, durationMs DurationMs) returns String
	let report = try readSpecReport(parsed) otherwise return unusableResultReply(reqDoc, idNode: idNode, ctx: ctx, argv: argv, res: res, durationMs: durationMs, why: "{SpecTestCommandName}'s result document does not have the shape this server reads.")

	return specTestReply(reqDoc, idNode: idNode, args: args, ctx: ctx, argv: argv, res: res, durationMs: durationMs, report: report)
end 'specReportReply'

function specTestReply(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext, argv StringArray, res CollectedOutput, durationMs DurationMs, report SpecReport) returns String
	let listed = listedFailureCount(report.failures, limit: failureLimitOf(reqDoc, args: args) as Count)

	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	payload.addBool(doc, key: "success", value: res.succeeded())
	addTimedRunFields(doc, payload: payload, ctx: ctx, argv: argv, res: res, durationMs: durationMs)
	payload.addNumber(doc, key: "passed", value: report.tally.passed as JsonFloat)
	payload.addNumber(doc, key: "failed", value: report.tally.failed as JsonFloat)
	payload.addNumber(doc, key: "skipped", value: report.tally.skipped as JsonFloat)
	payload.addNumber(doc, key: "notRun", value: report.tally.notRunHere as JsonFloat)
	payload.addNumber(doc, key: "total", value: report.tally.total() as JsonFloat)
	payload.addBool(doc, key: "memoryLeak", value: isLeakDetectedExit(res.exitCode() as ExitCode))
	payload.addNode("failures", node: failureArrayNode(doc, failures: report.failures, listed: listed))
	payload.addNumber(doc, key: "failuresOmitted", value: (report.failures.count() - listed) as JsonFloat)

	if getOptionalBoolArg(reqDoc, args: args, key: CasesOption, defaultVal: false) 'wantsCases'
		payload.addNode("cases", node: caseArrayNode(doc, tests: report.tests))
	end 'wantsCases'

	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: not res.succeeded())
end 'specTestReply'

function caseArrayNode(doc JsonDoc, tests SpecTestEntryArray) returns JsonNodeId
	var nodeIds = JsonNodeIdArray.create()

	for t in tests 'eachTest'
		var entry = JsonObjectBuilder.create()
		entry.addString(doc, key: "spec", value: t.spec)
		entry.addString(doc, key: "test", value: t.name)
		entry.addString(doc, key: "status", value: t.verdict.rawValue)
		nodeIds.push(entry.build(doc))
	end 'eachTest'

	return doc.add(JsonNode.arrayNode(nodeIds))
end 'caseArrayNode'

function failureLimitOf(reqDoc JsonDoc, args OptionalNode) returns FailureLimit
	return match optionalWholeArg(reqDoc, args: args, key: MaxFailuresOption) 'limit'
		absent gives DefaultFailureLimit
		given(value) gives value as FailureLimit
	end 'limit'
end 'failureLimitOf'

function listedFailureCount(failures SpecFailureSummaryArray, limit Count) returns Count
	if failures.count() <= limit 'allFit'
		return failures.count()
	end 'allFit'

	return limit
end 'listedFailureCount'

function failureArrayNode(doc JsonDoc, failures SpecFailureSummaryArray, listed Count) returns JsonNodeId
	var nodeIds = JsonNodeIdArray.create()

	for (iter, f) in failures.withIterator() 'eachFailure'
		if iter.index() >= listed 'pastWhatIsListed'
			break
		end 'pastWhatIsListed'

		var entry = JsonObjectBuilder.create()
		entry.addString(doc, key: "spec", value: f.spec)
		entry.addString(doc, key: "test", value: f.test)
		entry.addString(doc, key: "message", value: firstBytesMarked(f.message, max: FailureMessageMaxBytes))
		nodeIds.push(entry.build(doc))
	end 'eachFailure'

	return doc.add(JsonNode.arrayNode(nodeIds))
end 'failureArrayNode'

module function executeScaleTestToolWithin(reqDoc JsonDoc, idNode JsonNodeId, args OptionalNode, ctx ToolContext) returns String
	var argv = StringArray.create()
	argv.push(ScaleTestCommandName)

	argv.append(wholeOptionOf(reqDoc, args: args, key: RungsOption, prefix: RungsFlagPrefix))
	argv.append(wholeOptionOf(reqDoc, args: args, key: RepeatOption, prefix: RepeatFlagPrefix))
	argv.append(valuedOptionOf(reqDoc, args: args, key: NoteOption, prefix: NoteFlagPrefix))
	argv.append(valuedOptionOf(reqDoc, args: args, key: EmitCorpusOption, prefix: EmitCorpusFlagPrefix))
	argv.append(valuedOptionOf(reqDoc, args: args, key: LogOption, prefix: LogFlagPrefix))

	return runWithResultDocument(reqDoc, idNode: idNode, ctx: ctx, argv: argv, what: ScaleTestCommandName, family: StagedFamily.scaleResult, answer: function(parsed JsonDoc, ranArgv StringArray, res CollectedOutput, took DurationMs) gives scaleTestReply(reqDoc, idNode: idNode, ctx: ctx, argv: ranArgv, res: res, durationMs: took, parsed: parsed))
end 'executeScaleTestToolWithin'

function scaleTestReply(reqDoc JsonDoc, idNode JsonNodeId, ctx ToolContext, argv StringArray, res CollectedOutput, durationMs DurationMs, parsed JsonDoc) returns String
	var doc = JsonDoc.create()
	var payload = JsonObjectBuilder.create()
	addTimedRunFields(doc, payload: payload, ctx: ctx, argv: argv, res: res, durationMs: durationMs)
	payload.addBool(doc, key: "success", value: res.succeeded())
	payload.addNode("result", node: copyJsonNode(parsed, srcId: parsed.root, dst: doc))

	return toolResultText(reqDoc, idNode: idNode, payloadText: payload.buildAsRoot(doc), isError: not res.succeeded())
end 'scaleTestReply'
