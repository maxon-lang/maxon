		let rivals = self.nameableFiles.count() - 1 if isOneOfThem else self.nameableFiles.count()

		if rivals == 0 'noRival'
			return false
		end 'noRival'

		let sharing = try self.nameableFilesByNamespace.get(namespace) otherwise 0
		let sharingRivals = sharing - 1 if isOneOfThem else sharing

		return sharingRivals == 0
	end 'tellsApart'
