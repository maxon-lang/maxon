		fingerprint.note("argLists", value: self.argLists.count() as EntryCount)
		fingerprint.note("fixedSizes", value: self.fixedSizes.count() as EntryCount)
		fingerprint.note("frozenArgs", value: self.frozenArgs.count() as EntryCount)
		fingerprint.note("runtimeSized", value: self.runtimeSized.count() as EntryCount)
		fingerprint.note("speculative", value: self.speculative.count() as EntryCount)
		fingerprint.note("index", value: self.index.count())
		fingerprint.note("byBase", value: self.byBase.count())
		fingerprint.note("parseNamedRows", value: self.parseNamedRows.count())
		fingerprint.note("parseNamedOrder", value: self.parseNamedOrder.count() as EntryCount)
		fingerprint.note("parseCopyDemandedOrder", value: self.parseCopyDemandedOrder.count() as EntryCount)
		fingerprint.note("mergeNamedRows", value: self.mergeNamedRows.count() as EntryCount)
		fingerprint.note("copyDemanded", value: self.copyDemanded.count())
		fingerprint.note("parseCopyDemandedRows", value: self.parseCopyDemandedRows.count())
