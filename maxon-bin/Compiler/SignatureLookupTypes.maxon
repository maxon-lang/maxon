end 'typeMeaningsAgree'

// The second half of the pair, written out because Maxon matches ONE scrutinee at a time.
function declaredInstanceMeaningAgrees(declared DeclaredTypeMeaning, baseName ByteArray, args GenericArgNodeArray, argCount FieldIndex) returns bool
	match declared 'declared'
		nominalIdentity then return false
		genericInstance(otherBase, otherArgs, otherCount) then return baseName.equals(otherBase) and argCount == otherCount and genericArgNodesDenoteSame(args, other: otherArgs)
	end 'declared'
end 'declaredInstanceMeaningAgrees'

// Node for node over the two pre-order argument trees. The COUNT is compared first because a nested instance
// contributes nodes past the top-level arity, so equal `argCount`s do not imply equal trees.
function genericArgNodesDenoteSame(args GenericArgNodeArray, other GenericArgNodeArray) returns bool
	if args.count() != other.count() 'differentTrees'
		return false
	end 'differentTrees'

	for i in 0 upto args.count() 'eachNode'
		let node = try args.get(i) otherwise panic("genericArgNodesDenoteSame: args.get OOB at {i} below count {args.count()}")
		let peer = try other.get(i) otherwise panic("genericArgNodesDenoteSame: other.get OOB at {i} below the count this loop already matched")

		if not genericArgNodeDenotesSame(node, other: peer) 'differs'
			return false
		end 'differs'
	end 'eachNode'

	return true
end 'genericArgNodesDenoteSame'

function genericArgNodeDenotesSame(node GenericArgNode, other GenericArgNode) returns bool
	match node 'node'
		leaf(argType) then return declaredLeafDenotesSame(other, argType: argType)
		instanceHeader(baseName, argCount, shape) then return declaredHeaderDenotesSame(other, baseName: baseName, argCount: argCount, shape: shape)
	end 'node'
end 'genericArgNodeDenotesSame'

function declaredLeafDenotesSame(other GenericArgNode, argType MaxonType) returns bool
	match other 'other'
		leaf(otherType) then return maxonTypesDenoteSame(argType, b: otherType)
		instanceHeader then return false
	end 'other'
end 'declaredLeafDenotesSame'

function declaredHeaderDenotesSame(other GenericArgNode, baseName ByteArray, argCount FieldIndex, shape InstanceShape) returns bool
	match other 'other'
		leaf then return false
		instanceHeader(otherBase, otherCount, otherSize) then return baseName.equals(otherBase) and argCount == otherCount and shape.sameAs(otherSize)
	end 'other'
end 'declaredHeaderDenotesSame'

typealias InterfaceDeclIndexMap = Map with (ByteArray, ElementIndex)

// @generated library-cache begin
function cacheWriteInterfaceDeclIndexMap(writer LibraryCacheWriter, value InterfaceDeclIndexMap)
	writer.unsigned(value.count() as CacheUnsigned)

	for (key, entry) in value 'eachEntry'
		writer.bytes(key)
		writer.unsigned(entry as CacheUnsigned)
	end 'eachEntry'
end 'cacheWriteInterfaceDeclIndexMap'

function cacheReadInterfaceDeclIndexMap(reader LibraryCacheReader) returns InterfaceDeclIndexMap throws LibraryCacheDamage
	let count = try reader.count()
	let result = InterfaceDeclIndexMap.create()

	for _ in 0 upto count 'eachEntry'
		let key = try reader.bytes()
		let entry = (try reader.unsigned()) as ElementIndex
		result.upsert(key, value: entry)
	end 'eachEntry'

	return result
end 'cacheReadInterfaceDeclIndexMap'

// @generated library-cache end

// The name → position map for the SYNTHESIZED protocols, built from the very roster that seeds the ordered
// list so the two halves of the relation are one act here exactly as they are in
// `recordInterfaceDeclaration`. `ProgramSignatures.create` is the only caller.
function builtinInterfaceDeclIndices() returns InterfaceDeclIndexMap
	let indices = InterfaceDeclIndexMap.create()
	let names = builtinInterfaceNames()

	for i in 0 upto names.count() 'eachProtocol'
		indices.upsert(try names.get(i) otherwise panic("builtinInterfaceDeclIndices: builtinInterfaceNames().get OOB at {i} below count {names.count()}"), value: i)
	end 'eachProtocol'

	return indices
end 'builtinInterfaceDeclIndices'

// ⭐ **THE ONE PLACE A `throws` CLAUSE ENTERS A CONTENT HASH.** Both arms are marked, because both are
// possible in the positions this is asked from and a hash that mixed nothing for `none` would let a
// requirement LOSE its `throws` without any reader's memo moving — and the ABI a witness dispatch picks is
// exactly that fact (`WitnessDispatchTarget.throwsClause`).
function mixThrowsClause(state HashDigest, clause ThrowsClause) returns HashDigest
	return match clause 'k'
		none gives Hasher.combined(state, value: SignatureDiscriminator.throwsShapeNone)
		throwing(throwsName) gives mixBytes(Hasher.combined(state, value: SignatureDiscriminator.throwsShapeThrowing), bytes: throwsName.toByteArray())
	end 'k'
end 'mixThrowsClause'

function mixCapabilities(state HashDigest, params ParamCapabilityArray, result ResultCapability) returns HashDigest
	var out = Hasher.combined(state, value: result.ordinal as HashDigest)

	for capability in params 'eachParam'
		out = Hasher.combined(out, value: capability.ordinal as HashDigest)
	end 'eachParam'

	return out
end 'mixCapabilities'

// The rendered FORMALS of one interface requirement, in declaration order. BOTH columns ride and they
// are parallel: a witness dispatch slots its call's arguments against the NAMES (`WitnessDispatchTarget`'s
// authoritative label vocabulary — the interface's names, never a conformer's) and rejects a concrete value
// against the TYPES, so renaming a formal in file A changes what `f(x, other: y)` means in file B. The COUNT
// leads because arity alone decides E3036 at every dispatch; per-slot markers are unnecessary because
// `mixBytes` already carries a length tag, which is what keeps `("ab","c")` apart from `("a","bc")`.
function mixInterfaceFormals(state HashDigest, names NameRoster, types NameRoster) returns HashDigest
	var out = Hasher.combined(state, value: names.count() as HashDigest)

	for i in 0 upto names.count() 'eachFormal'
		let name = try names.get(i) otherwise panic("mixInterfaceFormals: names.get OOB at {i} below count {names.count()}")
		let typeName = try types.get(i) otherwise panic("mixInterfaceFormals: types.get OOB at {i} — an InterfaceMethodSig's paramNames and paramTypeNames are parallel by construction ({names.count()} names, {types.count()} types)")
		out = mixBytes(mixBytes(out, bytes: name), bytes: typeName)
	end 'eachFormal'

	return out
end 'mixInterfaceFormals'

// The "." that joins a per-instance / inner alias's parts. Its own constant so the JOIN and the
// SPLIT below cannot spell the qualifier two ways; it is also what `Parser.parseTypeReference` reads an
// `Instance.Member` type reference off, so all three agree by construction.
let QualifiedAliasSeparator = "."

// The BYTE value of `QualifiedAliasSeparator` (ASCII '.'), for the allocation-free pre-check
// `containsQualifier`. Named so the byte and the string form of the separator cannot drift.
let QualifiedAliasSeparatorByte = 46

// The byte a compound NAME is divided at — the argument `lastSeparatorIndex` takes so the two divided
// namespaces this file mints ("." for a namespace chain, "$" for a range-qualified element) share one scan.
// ASCII by construction: both separators are punctuation the lexer can spell, and a name is UTF-8, so a
// separator is never a continuation byte.
typealias NameSeparatorByte = int(0 to 127)

// ⭐ **THE INDEX OF THE LAST `separator` BYTE IN `name`** — the scan every separator-divided name in this
// file is split at, so "where?" and "what is the part before it?" cannot come to disagree about which byte
// the separator is.
//
// ⚠ **IT TAKES THE SEPARATOR RATHER THAN NAMING ONE, BECAUSE THIS FILE MINTS TWO DIVIDED NAMESPACES.**
// The "." divides a namespace-qualified name (`lib.fmt.Score`) and the "$" divides a range-qualified element
// (`Byte$0_255`); they are two separators, not two algorithms, and a second hand-rolled "find the byte,
// slice before it" is exactly the shape whose copies drift into a WRONG ANSWER rather than a compile error —
// the split silently lands one byte off and a name roster quietly stops matching.
//
// ⚠ **THE *LAST*, NOT THE FIRST.** A namespace is a DIRECTORY CHAIN — `lib.fmt.Score`,
// `lib.inner.deepHelper` — so the qualifier is everything before the final separator and the member is the
// final segment. For a two-segment name (`Wrapper.Idx`, `Point.create`) first and last are the same byte;
// for a three-segment one the last is the only split that names the member the author wrote.
// For the "$" reader the two coincide unconditionally: a mint's base is a name `multiplyDeclared` holds,
// and a mint itself is never contested (it has exactly one declaration), so no name carries two of them.
//
// An INDEX loop over a byte range, not `for b in name`: this is a per-named-value-coercion hot path, and an
// index range allocates no iterator object where the collection form might.
function lastSeparatorIndex(name ByteArray, separator NameSeparatorByte) returns ElementIndex throws MapError
	var i = name.count()

	while i > 0 'scanBack'
		i = i - 1

		if (try name.get(i) otherwise panic("lastSeparatorIndex: get OOB despite i < count()")) == separator as Byte 'here'
			return i
		end 'here'
	end 'scanBack'

	throw MapError.keyNotFound
end 'lastSeparatorIndex'

// `lastSeparatorIndex`'s twin from the other end, and the one `sourceSpelledAliasName` divides at (see there
// for why the two ends differ).
function firstSeparatorIndex(name ByteArray, separator NameSeparatorByte) returns ElementIndex throws MapError
	for i in 0 upto name.count() 'scan'
		if (try name.get(i) otherwise panic("firstSeparatorIndex: get OOB despite i < count()")) == separator as Byte 'here'
			return i
		end 'here'
	end 'scan'

	throw MapError.keyNotFound
end 'firstSeparatorIndex'

// ⭐ Does `name` contain the qualifier byte at all? The cheap, ALLOCATION-FREE guard that keeps the
// per-instance machinery off the plain-alias hot path: a plain name (`Score`) has no ".", so this
// returns false WITHOUT the two slices `splitQualifiedName` would otherwise allocate on every named-type
// resolution and every aggregate coercion.
function containsQualifier(name ByteArray) returns bool
	return name.contains(QualifiedAliasSeparatorByte as Byte)
end 'containsQualifier'

// `prefix.member` — the base-qualified name of an inner alias ("Wrapper.Idx") and the qualified name of a
// per-instance alias ("IntWrapper.Idx"), built the ONE way so the value column, the registries and the
// checks cannot disagree. `prefix`/`member` are identifiers and carry no ".", so `splitQualifiedName`
// inverts it exactly.
function joinQualifiedName(prefix ByteArray, member ByteArray) returns immutable ByteArray
	return freeze "{String.from(prefix)}{QualifiedAliasSeparator}{String.from(member)}".toByteArray()
end 'joinQualifiedName'

// ⭐ **`{namespace}.{name}` — THE DIRECTORY-QUALIFIED SPELLING OF A DECLARATION.** `utils` + `helper`
// ⇒ `utils.helper`; `lib.fmt` + `Score` ⇒ `lib.fmt.Score`.
//
// It routes through `joinQualifiedName` rather than spelling a separator of its own, so the JOIN and the
// SPLIT stay one fact however many segments the namespace brought with it: a namespace's own internal
// separators come from `namespaceForModuleDirectory` (which renders the `/`-joined module directory), and
// this adds the LAST one — which is exactly the one `splitQualifiedName` divides at.
//
// ⚠ **THE NON-EMPTY PRECONDITION IS CHECKED HERE AND NOT MERELY WRITTEN DOWN**, because it is a rule with
// TWO INDEPENDENT GUARDS in front of it — `Parser.recordScannedSignature`'s `not self.namespace.isEmpty()`
// and `Parser.pushNamespaceQualifiedAlias`'s `self.namespace.isEmpty()` — and a third caller that forgot
// would file a declaration under `.helper`, a key no call site can ever spell, with nothing red anywhere.
// A root-level file's namespace is `""`; there is no qualified spelling of a root declaration, because the
// root IS the unqualified namespace. Once per DECLARATION, so the test is free.
function namespaceQualifiedName(namespace String, name ByteArray) returns immutable ByteArray
	if namespace.isEmpty() 'noNamespaceToQualifyWith'
		panic("namespaceQualifiedName: '{String.from(name)}' was asked for its directory-qualified spelling with an EMPTY namespace — a root-level declaration has none, and every caller must have gated on that before reaching here")
	end 'noNamespaceToQualifyWith'

	return joinQualifiedName(namespace.toByteArray(), member: name)
end 'namespaceQualifiedName'

// The TYPE half of a `Type.method` callee, or the callee itself when it names a free function. Written
// through `splitQualifiedName` rather than as a second scan for the separator, so the one inverse of
// `joinQualifiedName` stays the only place the split is spelled.
function qualifiedCalleeHead(callee immutable ByteArray) returns immutable ByteArray
	return match splitQualifiedName(callee) 'shape'
		parts(prefix, _) gives prefix
		notQualified gives callee
	end 'shape'
end 'qualifiedCalleeHead'

export union NamespaceMember
	none
	one(kind TypeDeclKind, declFilePath FilePath, name immutable ByteArray)
	several(candidates StringArray)
	hidden(symbolKind HiddenSymbolKind, tier Visibility, kind TypeDeclKind, declFilePath FilePath, name immutable ByteArray)
end 'NamespaceMember'

enum TypeHeadKind
	absent
	nominal
	other
end 'TypeHeadKind'

function claimIsNominal(claim TypeNameClaim) returns bool
	return match claim.kind 'kind'
		structType or
		enumType or
		unionType gives true
		interfaceType or
		rangedAlias or
		functionAlias or
		genericAlias or
		tupleAlias gives false
	end 'kind'
end 'claimIsNominal'

// The (prefix, member) of a `prefix.member` name, or `notQualified`. An identifier carries no ".",
// so the split at the LAST separator is EXACT: a plain alias (`Score`) yields `notQualified`, a
// per-instance/inner name (`Wrapper.Idx`) yields its two parts, and a namespace-qualified one
// (`lib.fmt.Score`) yields the whole directory chain and the member — which is what every reader of
// this union wants (the unqualified name for a diagnostic, the receiver half for a per-instance
// probe).
export union DeclaringType
	method(typeName immutable ByteArray)
	freeFunction
	undeclared
end 'DeclaringType'

export enum CalleeReceiver
	takesReceiver
	takesNone
	undeclared
end 'CalleeReceiver'

export enum ContainerCreateRoute
	opaqueElement
	composedFromTheCaller
	staticStamp
end 'ContainerCreateRoute'

union QualifiedNameParts
	parts(prefix immutable ByteArray, member immutable ByteArray)
	notQualified
end 'QualifiedNameParts'

// ⚠ **IT ADMITS ANY NUMBER OF SEGMENTS, AND A TWO-SEGMENT CAP IS A SILENT WRONG ANSWER.** Under a cap a
// three-segment name answers `notQualified` — so a diagnostic that quotes a callee's member
// quotes `lib.inner.deepHelper` where the user reads `deepHelper`, and every "is this qualified?"
// probe says no about a name that plainly is. A cap is correct only while the sole producers
// join two identifiers; the split is the inverse of the join for any number of them.
function splitQualifiedName(name immutable ByteArray) returns QualifiedNameParts
	// The allocation-free short-circuit: a name with no "." is not qualified, so it never reaches the two
	// slices below — the plain-alias hot path pays only the byte scan.
	let split = try lastSeparatorIndex(name, separator: QualifiedAliasSeparatorByte) otherwise return QualifiedNameParts.notQualified

	let prefix = freeze try name.slice(0, endIndex: split) otherwise panic("splitQualifiedName: slice [0, {split}) of a {name.count()}-byte name is in range by the index `lastSeparatorIndex` just found")
	let member = freeze try name.slice(split + 1, endIndex: name.count()) otherwise panic("splitQualifiedName: slice [{split + 1}, {name.count()}) is in range by the index `lastSeparatorIndex` just found")
	return QualifiedNameParts.parts(prefix, member: member)
end 'splitQualifiedName'

function nameIsQualifiedBy(name ByteArray, qualifier ByteArray) returns bool
	let split = try lastSeparatorIndex(name, separator: QualifiedAliasSeparatorByte) otherwise return false
	return split == qualifier.count() and bytesStartWith(name, prefix: qualifier)
end 'nameIsQualifiedBy'

function unqualifiedMemberOf(name immutable ByteArray) returns immutable ByteArray
	return match splitQualifiedName(name) 'shape'
		parts(_, member) gives member
		notQualified gives name
	end 'shape'
end 'unqualifiedMemberOf'

function leadingSegmentOf(name immutable ByteArray) returns immutable ByteArray
	let split = try firstSeparatorIndex(name, separator: QualifiedAliasSeparatorByte) otherwise return name
	return freeze try name.slice(0, endIndex: split) otherwise panic("leadingSegmentOf: slice [0, {split}) of a {name.count()}-byte name is in range by the index `firstSeparatorIndex` just found")
end 'leadingSegmentOf'

function nameQualifierOf(name ByteArray) returns immutable ByteArray throws AbsentError
	match splitQualifiedName(name) 'qualified'
		parts(prefix, _) then return prefix
		notQualified then throw AbsentError.absent
	end 'qualified'
end 'nameQualifierOf'

// ⭐⭐ **THE "$" EVERY COMPILER MINT JOINS THROUGH** — a range-qualified element name (`Byte$0_255`), an
// alias minted inside an instance, a lifted closure (`f$closure_0`).
//
// ⚠ **IT MAY NOT BE THE "." ABOVE, AND THAT IS NOT A PREFERENCE.** `splitQualifiedName` reads a dotted name
// as `<directory chain>.<member>`, so a mint spelled `Byte.0_255` would present itself to every
// qualified-name reader in the compiler as the member `0_255` of a namespace `Byte`.
//
// ⭐ **AND NO SOURCE CAN COLLIDE WITH A MINT.** The lexer's identifier run admits letters, digits, `_` and
// `.` and nothing else, so a `$` cannot appear in a declared name at all: the minted half of the element
// namespace and the declarable half are disjoint BY CONSTRUCTION rather than by a check, which is the
// property `ReservedTypeNamePrefix` buys one namespace over.
let CompilerMintSeparator = "$"

// The BYTE value of `CompilerMintSeparator` (ASCII '$'), for the allocation-free scan below. Named
// so the byte and the string form cannot drift — `QualifiedAliasSeparatorByte`'s discipline.
let CompilerMintSeparatorByte = 36

function qualifiedMintName(name ByteArray, qualifier String) returns immutable ByteArray
	return freeze "{String.from(name)}{CompilerMintSeparator}{qualifier}".toByteArray()
end 'qualifiedMintName'

let AuthorExtensionMemberQualifier = "author"

function ordinalMintSpelling(spelling ByteArray, place ElementIndex) returns immutable ByteArray
	return qualifiedMintName(spelling, qualifier: "{place}")
end 'ordinalMintSpelling'

function isMintName(name ByteArray) returns bool
	let at = try firstSeparatorIndex(name, separator: CompilerMintSeparatorByte) otherwise return false
	return at > 0 and not isLiftedClosureName(name)
end 'isMintName'

// ⭐⭐ **THE RANGE-QUALIFIED SPELLING OF ONE DECLARATION OF A CONTESTED ALIAS** — `Byte` +
// `int(0 to 255)` ⇒ `Byte$0_255`. The ONE speller, so the MINT that registers the declaration
// (`mintedDeclaration`) and the READ that resolves an element to it (`rangeScopedName`) build the same
// bytes; a second spelling would be a name the registry holds and no instance ever asks for.
//
// ⭐ **IT IS DERIVED FROM THE RANGE, WHICH IS WHAT MAKES IT ORDER-FREE.** Two library declarations over one
// range mint one name and are one element type. Where an author's declaration takes part every declaration
// is its own type, and `ClaimantProvenance.ordinalMints` separates two over one range by fold position —
// never by which claimant the sweep reached first, the filesystem order `StdlibLoader`'s header forbids
// relying on.
//
// A float range carries its primitive (`$float…`) and an int range does not: an int spelling starts with a
// digit or '-', a float one with 'f', so an `int` and a `float` declaration over one range never mint one
// name. A bit-pattern domain adds its width (`b8_`) for the same reason.
function rangeQualifiedAliasName(name ByteArray, alias RangedTypeAlias) returns immutable ByteArray
	return qualifiedMintName(name, qualifier: "{rangeQualifierPrimitivePrefix(alias.underlying)}{alias.domain.qualifierPrefix()}{alias.low}_{alias.high}")
end 'rangeQualifiedAliasName'

function rangeQualifierPrimitivePrefix(underlying MaxonType) returns String
	let tag = maxonTypeTag(underlying)

	if tag == ValueTypeTag.integer 'anIntegerRange'
		return ""
	end 'anIntegerRange'

	if tag == ValueTypeTag.float 'aFloatRange'
		return rangedAliasUnderlyingName(underlying)
	end 'aFloatRange'

	panic("rangeQualifierPrimitivePrefix: a ranged alias whose underlying type is neither `int` nor `float`")
end 'rangeQualifierPrimitivePrefix'

// The qualifier is the shape DIGEST in hex, not the shape spelled out. This mint ends up inside a
// mangled symbol, where the separators a spelled-out signature needs (`:`, `|`, parentheses) are
// not symbol characters — and a `function`-tagged element spells only the bare word `function`,
// which collides.
function shapeQualifiedAliasName(name ByteArray, shape HashDigest) returns immutable ByteArray
	return qualifiedMintName(name, qualifier: "{shape:x}")
end 'shapeQualifiedAliasName'

// The same range as a reader SEES it -- `int(0 to 255)`, the syntax the source declares it in.
//
// ⭐⭐ **TWO SPELLINGS OF ONE RANGE, AND THE SPLIT IS THE SAME ONE `mangleGenericInstance` AND
// `canonicalNameWithin` HAVE.** `rangeQualifiedAliasName` above is a KEY: it must be unspellable in source,
// so it wears `CompilerMintSeparator` and is never shown to anyone. This one is DISPLAY: it goes
// into diagnostics, so it must read like a type and must not carry a separator no author has ever seen.
// Neither can serve as the other, and a single spelling would have to fail at one of the two jobs.
function rangeSourceSpelling(alias RangedTypeAlias) returns immutable ByteArray
	let primitive = rangedAliasUnderlyingName(alias.underlying)
	let isFloat = maxonTypeTag(alias.underlying) == ValueTypeTag.float

	if rangeIsThePrimitivesOwn(alias.low, high: alias.high, isFloat: isFloat) 'thePrimitiveItself'
		return freeze primitive.toByteArray()
	end 'thePrimitiveItself'

	return freeze rangedAliasRangeDisplay(alias.low, high: alias.high, isFloat: isFloat, domain: alias.domain).toByteArray()
end 'rangeSourceSpelling'

// The `int`/`float` keyword a ranged alias is declared over, spelled as the source writes it. Only those two
// forms can reach here: nothing but a `typealias <name> = int(…)`/`float(…)` builds a
// `RangedTypeAlias` at all.
function rangedAliasUnderlyingName(underlying MaxonType) returns String
	let tag = maxonTypeTag(underlying)

	if tag == ValueTypeTag.integer 'anIntegerRange'
		return "int"
	end 'anIntegerRange'

	if tag == ValueTypeTag.float 'aFloatRange'
		return "float"
	end 'aFloatRange'

	panic("rangedAliasUnderlyingName: a ranged alias whose underlying type is neither `int` nor `float`")
end 'rangedAliasUnderlyingName'

// ⭐⭐ **THE INSTANCE-QUALIFIED SPELLING OF ONE DECLARATION OF A CONTESTED GENERIC ALIAS** — `Bag` +
// `Array with String` ⇒ `Bag$Array_String`. `rangeQualifiedAliasName`'s sibling one layer up, sharing its
// separator and therefore its strip, and derived from the same principle: the qualifier is the very thing
// the declarations DISAGREE about, so two declarations that name one instance mint one name and only a real
// disagreement splits the namespace.
//
// ⭐ **THE QUALIFIER IS THE INSTANCE'S CANONICAL NAME AND NOT THE DECLARING FILE'S PATH.** A path would be
// unique per declaration, which is more than the question needs — and it would put a machine-specific
// absolute path into a type-name key, where a spec fragment staged in a temp directory would spell one thing
// here and another on the next host. `canonicalInstanceName` is structural over the base and the args, so it
// is a fact about the program and about nothing else.
function instanceQualifiedAliasName(name ByteArray, canonicalInstance ByteArray) returns immutable ByteArray
	return qualifiedMintName(name, qualifier: String.from(canonicalInstance))
end 'instanceQualifiedAliasName'

function rangePrimitiveName(isFloat bool, low FullRangeInt) returns String
	if isFloat 'aFloatRange'
		return "a `float` range"
	end 'aFloatRange'

	if rangeIsUnsigned(low) 'anUnsignedRange'
		return "an unsigned `int` range"
	end 'anUnsignedRange'

	return "a signed `int` range"
end 'rangePrimitiveName'

function implementsClauseVerdict(clause AliasImplementsClause, parent RangedTypeAlias) returns AliasImplementsVerdict
	let parentIsFloat = aliasIsFloat(parent)
	let own = rangePrimitiveName(clause.isFloat, low: clause.low)
	let parents = rangePrimitiveName(parentIsFloat, low: parent.low)

	if parent.domain.isPattern() or not own.equals(parents) 'anotherPrimitive'
		return AliasImplementsVerdict.primitiveDiffers(own, parents: "a `bits` pattern" if parent.domain.isPattern() else parents)
	end 'anotherPrimitive'

	let unsignedDomain = not clause.isFloat and rangeIsUnsigned(clause.low)
	let lowFits = rangeBoundOrderKey(parent.low, isFloat: clause.isFloat, unsignedDomain: unsignedDomain) <= rangeBoundOrderKey(clause.low, isFloat: clause.isFloat, unsignedDomain: unsignedDomain)
	let highFits = rangeBoundOrderKey(clause.high, isFloat: clause.isFloat, unsignedDomain: unsignedDomain) <= rangeBoundOrderKey(parent.high, isFloat: clause.isFloat, unsignedDomain: unsignedDomain)

	if lowFits and highFits 'insideTheParent'
		return AliasImplementsVerdict.resolved
	end 'insideTheParent'

	return AliasImplementsVerdict.rangeDoesNotFit
end 'implementsClauseVerdict'

function rangeBoundOrderKey(bound FullRangeInt, isFloat bool, unsignedDomain bool) returns FullRangeInt
	if isFloat 'aFloatBound'
		return floatOrderKey(bound)
	end 'aFloatBound'

	if unsignedDomain 'anUnsignedBound'
		return bound xor i64.min
	end 'anUnsignedBound'

	return bound
end 'rangeBoundOrderKey'

function isOperandAliasSetBrand(brand ByteArray) returns bool
	let first = try brand.get(0) otherwise return false
	return first == OperandAliasSetSeparator as Byte
end 'isOperandAliasSetBrand'

function isCompilerReservedName(name ByteArray) returns bool
	return bytesStartWith(name, prefix: ReservedTypeNamePrefix)
end 'isCompilerReservedName'

function declaresAnAuthorNominalName(decl TypeNameDecl) returns bool
	return not decl.claim.declaredByTheCorpus and not isTypeAliasDecl(decl.claim.kind) and not isCompilerOwnedTypeName(decl.name) and not isCompilerReservedName(decl.name)
end 'declaresAnAuthorNominalName'

let BufferViewBrandSeparator = "@"
let BufferViewBrandSeparatorByte = 64

function isBufferViewBrand(brand ByteArray) returns bool
	if not bytesStartWith(brand, prefix: ManagedMemoryTypeName) 'notAView'
		return false
	end 'notAView'

	let next = try brand.get(ManagedMemoryTypeName.count()) otherwise return false
	return next == BufferViewBrandSeparatorByte as Byte
end 'isBufferViewBrand'

function bufferViewBrandOver(origin immutable ByteArray) returns immutable ByteArray
	if isBufferViewBrand(origin) 'alreadyAView'
		return origin
	end 'alreadyAView'

	if origin.isEmpty() or isOperandAliasSetBrand(origin) 'noOriginToKeep'
		return EmptySourceText
	end 'noOriginToKeep'

	return freeze "{String.from(ManagedMemoryTypeName)}{BufferViewBrandSeparator}{String.from(origin)}".toByteArray()
end 'bufferViewBrandOver'

function brandBeneathBufferView(brand immutable ByteArray) returns immutable ByteArray
	if not isBufferViewBrand(brand) 'nothingBeneath'
		return brand
	end 'nothingBeneath'

	return freeze try brand.slice(ManagedMemoryTypeName.count() + 1, endIndex: brand.count()) otherwise panic("brandBeneathBufferView: '{String.from(brand)}' is longer than the view prefix and its separator, because isBufferViewBrand read the separator there")
end 'brandBeneathBufferView'

function brandOfDeclaredSpelling(spelled immutable ByteArray) returns immutable ByteArray
	return EmptySourceText if isCompilerReservedName(spelled) else spelled
end 'brandOfDeclaredSpelling'

function declaredBrandOf(declaredName immutable ByteArray, paramTag ValueTypeTag) returns immutable ByteArray
	return brandOfDeclaredSpelling(declaredName) if paramTag == ValueTypeTag.genericInstance else EmptySourceText
end 'declaredBrandOf'

function brandIsTheType(brand ByteArray) returns bool
	return not brand.isEmpty() and not isOperandAliasSetBrand(brand)
end 'brandIsTheType'

// A mixed expression's operand aliases, carried in its brand slot as `|A|B`: the leading separator
// tells it from a spelling brand, and the members arrive sorted (`insertOperandAliasSetMembers`) so
// one set has one spelling whatever the operand order. No diagnostic shows it; the value's type is
// the nearest common ancestor, and that is what is named.
function operandAliasSetBrand(members NameRoster) returns immutable ByteArray
	let brand = ByteArray.create(0) as isolated ByteArray

	for member in members 'eachMember'
		if member.isEmpty() or member.contains(OperandAliasSetSeparator as Byte) 'notASplittableMember'
			panic("operandAliasSetBrand: member '{String.from(member)}' is empty or holds the operand-set separator, so the brand could not be split back into the members it was built from")
		end 'notASplittableMember'

		brand.push(OperandAliasSetSeparator as Byte)
		brand.append(member)
	end 'eachMember'

	return freeze brand
end 'operandAliasSetBrand'

function operandAliasSetMembers(brand immutable ByteArray) returns NameRoster
	let members = NameRoster.create(0)
	var rest = freeze try brand.slice(1, endIndex: brand.count()) otherwise panic("operandAliasSetMembers: '{String.from(brand)}' is not an operand-set brand — every caller asks isOperandAliasSetBrand first")

	while true 'eachMember'
		let split = try firstSeparatorIndex(rest, separator: OperandAliasSetSeparator) otherwise break
		members.push(freeze try rest.slice(0, endIndex: split) otherwise panic("operandAliasSetMembers: slice [0, {split}) of {rest.count()} bytes is in range by the index firstSeparatorIndex just found"))
		rest = freeze try rest.slice(split + 1, endIndex: rest.count()) otherwise panic("operandAliasSetMembers: slice [{split + 1}, {rest.count()}) is in range because a separator sits at {split}")
	end 'eachMember'

	members.push(rest)
	return members
end 'operandAliasSetMembers'

function operandAliasSetUnion(left ByteArray, right ByteArray) returns NameRoster
	let members = NameRoster.create(0)

	insertOperandAliasSetMembers(members, answers: operandAliasAnswerMembers(left))
	insertOperandAliasSetMembers(members, answers: operandAliasAnswerMembers(right))
	return members
end 'operandAliasSetUnion'

function insertOperandAliasSetMembers(members NameRoster, answers NameRoster)
	for member in answers 'eachAnswerMember'
		var at = 0 as ElementIndex

		for existing in members 'eachExisting'
			match compareBytesOrdinally(existing, right: member) 'order'
				lessThan then at = at + 1
				equalTo then continue 'eachAnswerMember'
				greaterThan then break 'eachExisting'
			end 'order'
		end 'eachExisting'

		members.insert(at, value: member)
	end 'eachAnswerMember'
end 'insertOperandAliasSetMembers'

function operandAliasAnswerMembers(answer ByteArray) returns NameRoster
	if isOperandAliasSetBrand(answer) 'anOperandSet'
		return operandAliasSetMembers(answer)
	end 'anOperandSet'

	let members = NameRoster.create(1, zeroed: false)
	members.push(answer)
	return members
end 'operandAliasAnswerMembers'

// A stored alias name as bare source text, every mint and family suffix stripped. A diagnostic that must
// tell two declarations of one name apart quotes `ProgramSignatures.aliasIdentityDisplay` instead.
function sourceSpelledAliasText(name immutable ByteArray) returns String
	return String.from(aliasBaseName(name))
end 'sourceSpelledAliasText'

// ⭐⭐ **THE NAME AS *SOURCE* SPELLS IT** — `Byte$0_255` ⇒ `Byte`, and any name the compiler never
// qualified handed back UNCHANGED, by reference, so an unqualified name costs one byte scan and no
// allocation. The exact inverse of every mint (`rangeQualifiedAliasName`, `shapeQualifiedAliasName`,
// `instanceQualifiedAliasName`), so a mint and the strip cannot come to disagree about where a name divides.
//
// ⚠ **IT DIVIDES AT THE FIRST `$`, NOT THE LAST.** A generic alias's qualifier is an instance's canonical name, which CONTAINS a range qualifier whenever its
// element is a contested one — `Bytes$Array_Byte$0_255`. Splitting at the last `$` hands that back as
// `Bytes$Array_Byte`, a name no source line holds and no registry answers for. `$` is unspellable in an
// identifier, so every `$` in a name begins the compiler's own bookkeeping and the SOURCE spelling is
// everything before the first one — one rule, whatever depth the mints reach.
//
// **ITS READERS WANT THE SAME THING FOR TWO REASONS, AND THAT IS WHY THERE IS ONE FUNCTION:**
//
//   • A name ROSTER (`isByteElementName`) asks about `Byte`, and must go on getting a yes after the
//     element it names has been qualified — without the roster learning anything about ranges.
//   • A DIAGNOSTIC quotes a typealias back at the author, and a mint is a name NO SOURCE LINE HOLDS.
function sourceSpelledAliasName(name immutable ByteArray) returns immutable ByteArray
	let split = try firstSeparatorIndex(name, separator: CompilerMintSeparatorByte) otherwise return name

	return freeze try name.slice(0, endIndex: split) otherwise panic("sourceSpelledAliasName: slice [0, {split}) of a {name.count()}-byte name is in range by the index `firstSeparatorIndex` just found")
end 'sourceSpelledAliasName'

// A set of declared type NAMES, for a walk that has to recognize a name it has already reached
// (`ProgramSignatures.structIsConstructibleWithin`). The `Set with ByteArray` the compiler's other
// name-set walks are spelled with — `ClonerSet` (the deep-clone walk over this very field graph),
// `LiveGlobalLabelSet`, `InterfaceNameSet` — rather than a list plus a linear scan, which is what makes
// "linear in the graph" a fact about this walk rather than a hope.
typealias StructNameSet = Set with ByteArray

