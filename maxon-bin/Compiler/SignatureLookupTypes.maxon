// instance method denied one is called on nothing. `Parser.ensureSiblingReceivers` reads the same fact off
// a TOKEN walk for a declaration whose body it can see; this is the answer for one it cannot.
export type FunctionDeclSite
	export let visibility as Visibility
	export let declFilePath as FilePath
	export let takesReceiver as bool
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export let enclosingTypeName as immutable ByteArray

	static function create(visibility Visibility, declFilePath FilePath, takesReceiver bool, nameLine LineNumber, nameColumn ColumnNumber, enclosingTypeName ByteArray) returns FunctionDeclSite
		return Self{visibility: visibility, declFilePath: declFilePath, takesReceiver: takesReceiver, nameLine: nameLine, nameColumn: nameColumn, enclosingTypeName: enclosingTypeName}
	end 'create'

	// @generated library-cache begin
