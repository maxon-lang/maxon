	var instantiatedByAParse = InstantiatedTypeNameSet.create()

	var genericTemplates = GenericFunctionTemplateMap.create()
	var genericInstancesBySite = GenericFunctionInstancesBySite.create()
	var genericInstancesByName = GenericFunctionInstanceMap.create()

