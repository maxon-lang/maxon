		writer.unsigned(self.visibility.ordinal as CacheUnsigned)
		writer.text(self.declFilePath.toString())
		writer.flag(self.takesReceiver)
		writer.unsigned(self.nameLine as CacheUnsigned)
		writer.unsigned(self.nameColumn as CacheUnsigned)
		writer.bytes(self.enclosingTypeName)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FunctionDeclSite throws LibraryCacheDamage
		let f_visibility = try cacheReadVisibility(reader)
		let f_declFilePath = try reader.path()
		let f_takesReceiver = try reader.flag()
		let f_nameLine = (try reader.unsigned()) as LineNumber
		let f_nameColumn = (try reader.unsigned()) as ColumnNumber
		let f_enclosingTypeName = freeze try reader.bytes()

		return Self{visibility: f_visibility, declFilePath: f_declFilePath, takesReceiver: f_takesReceiver, nameLine: f_nameLine, nameColumn: f_nameColumn, enclosingTypeName: f_enclosingTypeName}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize48
		return sizeof(FunctionDeclSite) as CacheSize48
