// The node index tuple slot `slot` starts at — node 0's first child, advanced past each earlier sibling's
// whole subtree.
function surfaceSlotStart(surface DeclaredSurface, slot FieldIndex) returns FieldIndex
	var at = 1 as FieldIndex

	for _ in 0 upto slot 'skipEarlierSlots'
		at = at + surfaceSubtreeSize(surface, at: at)
	end 'skipEarlierSlots'

	return at
end 'surfaceSlotStart'

// The fifteen `__ManagedFile` methods: ten statics and five instance methods. A name outside this
// set is refused by name at its own span rather than mangled into a callee no file declares
// (`Parser.resolveStaticMember` / `Parser.dispatchManagedFileMethod`).
//
// ⚠ There is deliberately no `seek`. A fourteenth method here would be surface the language does
// not have.
let ManagedFileOpenReadMethod = b"openRead"
let ManagedFileOpenWriteMethod = b"openWrite"

// ⭐ Its only difference from `openWrite` is a Unix 0755 permission bit, and it lowers on its own —
// `__mf_open_write_exec` and `StdOp.osFileOpenWriteExecutable` — because a POSIX lane makes the
// permission mask observable.
let ManagedFileOpenWriteExecutableMethod = b"openWriteExecutable"
let ManagedFileOpenCreateNewMethod = b"openCreateNew"
let ManagedFileExistsMethod = b"exists"
let ManagedFileDeleteMethod = b"delete"
let ManagedFileRenameMethod = b"rename"
let ManagedFileStatMethod = b"stat"
let ManagedFileStatFieldMethod = b"statField"
let ManagedFileStatFreeMethod = b"statFree"
let ManagedFileCloseMethod = b"close"
let ManagedFileSizeMethod = b"size"
let ManagedFileReadMethod = b"read"
let ManagedFileReadAppendingMethod = b"readAppending"
let ManagedFileWriteMethod = b"write"

// ⭐ **THE PARAMETER NAMES A `__ManagedFile` ARGUMENT MISMATCH QUOTES BACK.** They are what
// `builtin-type-checking.error-managed-file-*` pins: the diagnostic reports `argument type mismatch for
// 'path'`, so the name is a fact about the SIGNATURE, not a word this compiler picks.
// ⚠ Shared with `__ManagedDirectory`: `openSearch`, `exists` and `create` name their path
// parameter `path` too, so this is one word for one fact rather than a per-family copy.
let ManagedFilePathParamName = b"path"
let ManagedFileOldPathParamName = b"oldPath"
let ManagedFileNewPathParamName = b"newPath"
let ManagedFileManagedParamName = b"managed"
let ManagedFileSizeParamName = b"size"
let ManagedFileBufferParamName = b"buffer"
let ManagedFileIndexParamName = b"index"

// ⭐ **THE `__ManagedMemory` OBJECT SURFACE** — the twelve members the corpus
// reaches. SIX of them are spelled IDENTICALLY to an `Array` method and dispatch to the
// identical runtime entry (`capacity`, `get`, `set`, `append`, `slice`, `clear`); `length` shares the ENTRY
// with `Array.count` under a DIFFERENT spelling, which is why `mm.count()` is refused (`error.buffer-has-no-count`) — a shared emission is not a shared name; four are the buffer's own
// (`setLength`, `setByte`, `grow`, `byteAt`); the twelfth is the `create` static.
//
// ⚠⚠ **THE SET IS NOT STATED HERE — IT IS `Parser.bufferSurfaceMemberNames`, WHICH IS ALSO WHAT THE REFUSAL
// PRINTS.** This block declares the SPELLINGS; the roster declares MEMBERSHIP, and the paragraph
// above is a reader's summary of it rather than a second authority: a count written here contradicts the
// roster the moment either moves, and the dispatch accepts `Array` names a stale summary would deny.
//
// ⚠ **`elementSize`, `remove`, `swap`, `shiftLeft`/`shiftRight`, `toCString` and `makeCharFromBytes` are
// DELIBERATELY ABSENT.** None has a caller the compiler can reach: `elementSize` has twelve
// (`specs/ranged-int-bit-packing.md`, whose subject is ranged-int bit packing the compiler does not have) and
// the rest have `stdlib/Array.maxon`. A member with no
// reachable caller is a mechanism handed a consumer that cannot exercise it.
//
// ⭐⭐ **`fromCString` AND `createCursor` ARE NOT ON THAT LIST, AND *"they need a `cstring` type the compiler
// has no producer for"* IS NOT A REASON TO PUT THEM BACK.** `parseTypeReference` resolves `cstring`, the
// lexer carries the keyword, and `String.cstr()` PRODUCES one through `__mm_to_cstring`; `fromCString` is
// `__mm_from_cstring`, whose whole body is the strlen-and-copy
// builder `__md_filename` uses. ⇒ **That gap was never a missing type — it is a
// conversion the runtime already performs, with no Maxon-reachable name on it.** Re-measure a blocker
// before repeating it.
// ⚠ **NOR IS `stdlib/Array.maxon` A MODULE *"no whitelisted module imports and the compiler cannot
// compile at all"*** — the loader takes all of `stdlib/`, so it is loaded by every compile. What stands is
// the narrower claim, that nothing REACHES those calls, and it is not re-measured here: measure it before
// calling any of the eight absent again. `Parser.handleStaticRefusal` (the statics) and `Parser.dispatchArrayMethod`
// (the members) name them in their refusals so the gap is a diagnostic rather than a silence.
//
// ⚠ **THE TWO REFUSALS EACH MISFILE ONE NAME:** `createCursor` is an INSTANCE method that the
// static refusal calls a static, and `fromCString` (genuinely `isStatic: true`) is what the member
// refusal calls a member. Neither is a false statement about BUILDABILITY, which
// is what the sentences are for; correcting the category changes the message, since the
// `are not built` clause is a literal in the message rather than rendered from a list the way the
// roster is.
let ManagedMemoryCreateMethod = b"create"

// ⭐ **`fromCString(cstr)` — A NUL-TERMINATED POINTER BACK INTO A BUFFER**, `toCString()`'s dual and the
// second `__ManagedMemory` static. Its parameter's spelling is load-bearing because the arm
// accepts it as an argument label.
let ManagedMemoryFromCStringMethod = b"fromCString"
let ManagedMemoryCStringParamName = b"cstr"
let ManagedMemorySetLengthMethod = b"setLength"
let ManagedMemorySetByteMethod = b"setByte"
let ManagedMemoryLengthMethod = b"length"
let ManagedMemoryGrowMethod = b"grow"

// ⭐⭐ **`fill(start, count:, value:)` — A BULK ELEMENT WRITE, AND THE ONE MEMBER NO TABLE ASKED FOR.**
// The compiler keeps ONE shared generic body, so `Array.refill`'s per-element store is a CALL per
// element rather than an inlined `mov`, and this fused member is what a shared body reaches
// instead.
//
// ⚠ Its `start` is the only parameter name here not read back from the corpus, because nothing else
// writes this member down. It is spelled to say what the OTHER two
// parameters mean — a window `[start, start + count)` — where `index`/`offset` would each have claimed a
// neighbouring member's noun (`ManagedMemoryIndexParamName` is a single slot's, `offset`'s is a BYTE).
// ⚠ **AND IT IS NOT `from`, WHICH IS WHAT THE WINDOW WANTS TO BE CALLED: `from` IS A KEYWORD** (the lexer
// hands it back as one, so `E2010: Expected identifier but got 'from'` refuses the parameter, the local and
// any label spelled with it). The name a diagnostic prints has to be one the reader could type.
let ManagedMemoryFillMethod = b"fill"

// ⭐ **`toCString()` — THE BUFFER'S NUL-TERMINATED VIEW**, and the corpus's only producer of a `cstring`
// (`stdlib/String.maxon:195`, whose `cstr()` is its one caller). Named here beside its siblings rather than
// at the arm, so the roster, the dispatch and the refusal all read one spelling.
let ManagedMemoryToCStringMethod = b"toCString"

// ⭐ **`makeCharFromBytes(pos, len)` — MINT ONE `Character` FROM A BYTE WINDOW** (`stdlib/String.maxon:315`,
// an unmarked function whose whole body forwards to the buffer). Its two parameter names are the corpus's,
// read back rather than invented, because the arm accepts them as argument LABELS.
let ManagedMemoryMakeCharFromBytesMethod = b"makeCharFromBytes"

let ManagedMemoryCharPosParamName = b"pos"
let ManagedMemoryCharLenParamName = b"len"
let ManagedMemoryElementSizeMethod = b"elementSize"

// ⭐⭐ **THE THREE RELOCATORS' SPELLINGS.** `swap` is what every sort moves elements with
// (`stdlib/helpers/sort/smallSort.maxon:31`) and the two shifts are what `stdlib/Array.maxon`'s
// `insert`/`remove` open and close a hole with (`:312`) — so all three are corpus spellings read back, never
// invented, and the roster, the dispatch, the refusal and `ManagedMemoryRuntime.managedMemorySourceMethodName` all
// read these.
let ManagedMemorySwapMethod = b"swap"
let ManagedMemoryShiftRightMethod = b"shiftRight"
let ManagedMemoryShiftLeftMethod = b"shiftLeft"

// ⚠ **`swap`'s SECOND PARAMETER IS LABELLED AND ITS FIRST IS NOT, WHICH IS THE CORPUS'S OWN CALL AND NOT A
// CHOICE.** `smallSort.maxon:31` writes `managed.swap(i, j: j)`. Both shifts take `(index, count)`
// and the corpus labels neither
// (`stdlib/Array.maxon:307` writes `managed.shiftRight(index, len - index)`), which the shared
// `parseTwoBuiltinIntegerArgList` already permits — it consumes a matching label when one is written and
// requires none. Their two labels are `ManagedMemoryIndexParamName`/`ManagedMemoryCountParamName`, already
// declared below for `get`/`create` — a parameter-name constant is about a SPELLING, and a second `b"count"`
// beside the first is the drift these blocks exist to prevent.
let ManagedMemorySwapFirstParamName = b"i"
let ManagedMemorySwapSecondParamName = b"j"

// ⭐⭐ **`createCursor()` AND THE SIX MEMBERS OF WHAT IT HANDS BACK.** Every spelling is
// `stdlib/Array.maxon:485-531`'s, read back rather than invented: `ArrayIterator` is the cursor's only
// consumer and forwards each member one-for-one, so its declarations ARE the surface.
//
// ⚠ `peek`'s parameter name is the corpus's too, and the arm accepts it as an argument LABEL, which is why
// it is named here beside the methods rather than at the arm. `seek`'s is `index`, which is
// `ManagedMemoryIndexParamName` already — a parameter-name constant is about a SPELLING, and a second
// `b"index"` beside the first is the drift these blocks exist to prevent.
let ManagedMemoryCreateCursorMethod = b"createCursor"
let CursorCurrentMethod = b"current"
let CursorIndexMethod = b"index"
let CursorAdvanceMethod = b"advance"
let CursorRetreatMethod = b"retreat"
let CursorSeekMethod = b"seek"
let CursorPeekMethod = b"peek"
let CursorPeekParamName = b"ahead"

// ⭐ **THE `Array` SPELLINGS A SOURCE-METHOD MAP HAS TO NAME.** The parser and a runtime family's
// source-method map answer with one constant: a second `b"set"` beside the first is exactly the drift these
// blocks exist to prevent.
//
// `set` and `append` serve `ManagedMemoryRuntime.managedMemorySourceMethodName` (the buffer's two
// shared spellings); the other six serve `ManagedMemoryRuntime.arrayAccessorSourceMethodName`,
// which answers for all nine throwing `Array` accessors rather than for the buffer subset alone — see that
// map for why the array family needs a spelling at all.
//
// ⚠ **`append` HAS NO SOURCE-METHOD ARM — the buffer's `append` is NON-THROWING and lowers straight to
// `ManagedMemoryRuntime.ManagedAppendName` — AND IT STAYS HERE ON THE
// BLOCK'S OWN RULE RATHER THAN ON A MAP'S.** A source-method map is only ever the FIRST
// reason a spelling is kept in this block; the standing one is below, and it is why
// `AppendMemoryMethod`, `ArrayPopMethod` and `ListPrependMethod` — none of which any map names — sit here too.
//
// ⚠ None carries a family prefix, and that is the fact rather than an omission: ONE spelling serves
// `String.append`, `List.append` and `Array.append`/`Array.set` — and the buffer's `append` as well — and
// the parser dispatches all of them on this one byte string. `RemoveMethod` and
// `SliceMethod` are unprefixed for the same reason: the buffer and the `Array` both spell `slice`.
let ArraySetMethod = b"set"
let AppendMethod = b"append"

// ⭐ **`appendMemory(source)` — APPEND ENTERED THROUGH THE MEMORY RATHER THAN THE ARRAY.** It is
// `stdlib/Array.maxon:267`'s member and `append`'s whole body (`:262` is `appendMemory(other.managed)`), so
// the two are ONE emission under two names — `length`/`count`'s arrangement, one member over. Since the
// envelope collapse an `Array` IS its `__ManagedMemory`, which is why the corpus keeps both: a caller already
// holding the memory would otherwise allocate an `Array` record per call to hand it over, and
// `StringBuilder.appendBytes` paid exactly that (`stdlib/String.maxon:844`, this member's one corpus caller).
//
// ⚠ **IT IS AN `Array` MEMBER AND ONLY AN `Array` MEMBER, WHICH IS THE OTHER HALF OF `length`/`count`'s
// ARRANGEMENT.** The buffer shares the EMISSION, never the name: no corpus caller writes
// `mm.appendMemory(…)`, so `Parser.bufferSurfaceMemberNames` deliberately omits it and
// `managed-memory-methods.error.buffer-has-no-appendMemory` is the program that says so. It is nonetheless
// unprefixed for this block's rule — one spelling, whichever surfaces come to serve it — as `set`, `append`,
// `slice` and `byteAt` above it each record.
let AppendMemoryMethod = b"appendMemory"
let GetMethod = b"get"
let ArrayFirstMethod = b"first"
let ArrayPopMethod = b"pop"
let RemoveMethod = b"remove"
let SliceMethod = b"slice"

// ⚠ **`insert` IS IN THIS BLOCK FOR THE BLOCK'S OWN REASON**: it is the very byte string the
// parser's dispatch matches. `Array`, `Set` and `Map` all spell it, which is why it carries no
// family prefix — the rule `set`/`append`/`slice`/`remove` above it already state.
let InsertMethod = b"insert"

let UpsertMethod = b"upsert"
let MapUpsertValueLabel = b"value"

// Where a pair's two halves sit in a CALL-ALIGNED argument list for `Map.upsert` — past the receiver, which
// `recordScannedSignature` records as `SelfParamName` at slot 0 for every instance method. They are
// deliberately NOT `HashTableKeyArgPosition`/`MapValueArgPosition`: those two number `Map with (K, V)`'s TYPE
// arguments, and a reader that used them here would be off by the receiver and would ask about the wrong
// parameter's consume bit — silently, because 0 and 1 are both valid positions.

// ⚠ **`byteAt` IS IN THIS BLOCK.** It belongs here for the same reason `set`,
// `append` and `slice` do — the buffer and the `String` spell it identically and the parser dispatches both
// on this one byte string — and a family-prefixed constant serving two families is the drift these blocks
// exist to prevent, one rename away from a second `b"byteAt"` beside the first.
let ByteAtMethod = b"byteAt"

// The four spellings only a `List` has. They live in THIS block for the reason the eight above them do:
// `ListRuntime.listAccessorSourceMethodName` names `removeFirst`, `removeLast` and `last` with the very
// constants the parser dispatches on. `prepend` sits beside them so the
// vocabulary a list adds to the language is read in one place; `append`/`get`/`first`/`count`/`create` are
// already shared above, and so are `insert`/`remove` — a `List` dispatches on the very same byte strings an
// `Array` and a `Map` do, which is this block's standing rule.
//
// ⚠ **`last` IS `List`-PREFIXED THOUGH `first` ABOVE IS `Array`-PREFIXED, and the asymmetry is real rather
// than an oversight**: `Array.first` is still a compiler-dispatched member and `Array.last` is a CORPUS one
// (`stdlib/Array.maxon`), so no `Array` dispatch matches `b"last"` and there is no second surface for an
// unprefixed constant to serve yet. A second one that spelled it would take this constant rather than mint a
// fifth, exactly as `ClearMethod` was un-prefixed the day the chain spelled it.
let ListPrependMethod = b"prepend"

let ListLastMethod = b"last"

let ListRemoveFirstMethod = b"removeFirst"
let ListRemoveLastMethod = b"removeLast"

function isElementMoveOutName(name ByteArray) returns bool
	return name.equals(ArrayPopMethod) or name.equals(RemoveMethod) or name.equals(ListRemoveFirstMethod) or name.equals(ListRemoveLastMethod)
end 'isElementMoveOutName'

// The spellings only the `__ManagedList` surface has (`/specs/managed-list.md`).
// They live here beside `List`'s pair so the chain's whole vocabulary is read in one place. `create`,
// `count`, `remove`, `clear` and `isEmpty` are NOT among them: those are already spelled once above (or in
// `Parser`'s shared block) and the managed list dispatches on the very same byte strings, which is this
// block's rule.
//
// ⚠ `value` is a METHOD name, and the three other `b"value"` constants in this compiler are a print
// PARAMETER name, a `Map.upsert` argument LABEL and a `__ManagedMemory` parameter name — different name
// spaces, already kept apart here and in `Parser`. This is the first method of that spelling; a second
// container spelling it would share this constant rather than mint a fifth.
//
// ⚠ **`head`/`tail`/`next`/`prev` ARE HERE AND NOT IN `Parser.maxon` FOR `removeFirst`'s REASON, VERBATIM**:
// `ListRuntime.listAccessorSourceMethodName` has to name all four — they are the surface's four THROWING
// navigators.
//
// ⚠ **`next` IS ALSO A `__ManagedDirectory` MEMBER (`ManagedDirectoryNextMethod`), AND THE TWO ARE
// DELIBERATELY NOT SHARED.** A directory's `next` yields the next ENTRY and throws when the walk is done;
// a node's yields a node HANDLE. One byte string, two surfaces, two dispatchers — and the shared-constant
// rule this block states is about a member two surfaces spell to mean THE SAME THING (`get`, `remove`,
// `insert`), which these do not.
let ManagedListInsertFirstMethod = b"insertFirst"
let ManagedListInsertLastMethod = b"insertLast"
let ManagedListInsertAfterMethod = b"insertAfter"
let ManagedListInsertBeforeMethod = b"insertBefore"
let ManagedListReinsertFirstMethod = b"reinsertFirst"
let ManagedListReinsertLastMethod = b"reinsertLast"
let ManagedListHeadMethod = b"head"
let ManagedListTailMethod = b"tail"
let ManagedListNodeValueMethod = b"value"
let ManagedListNodeSetValueMethod = b"setValue"
let ManagedListNodeNextMethod = b"next"
let ManagedListNodePrevMethod = b"prev"

// The one member a per-node refcount buys and an unrefcounted node could not have: unlink WITHOUT freeing,
// so the caller's handle keeps the node and its element alive (`/specs/managed-list.md:core.detach`).
let ManagedListDetachMethod = b"detach"

// Its parameter names are pinned for the same reason the file's are: a mismatch diagnostic quotes them
// back. ⚠ **THE SLICE LABEL IS `endIndex`, NOT `end`** — `specs/managed-memory-builtin.md:slice` writes
// `endIndex:`, and it is also `Array.slice`'s own label (`EndIndexArgLabel`), which the SAME
// dispatch arm serves.
let ManagedMemoryCountParamName = b"count"
let ManagedMemoryElementSizeParamName = b"elementSize"
let ManagedMemoryNewLengthParamName = b"newLength"
let ManagedMemoryNewCapacityParamName = b"newCapacity"
let ManagedMemoryOffsetParamName = b"offset"
let ManagedMemoryIndexParamName = b"index"
let ManagedMemoryStartParamName = b"start"

// ⚠ `Array.append`'s parameter carries this SAME label, so both append doors reach this one constant (through
// `Parser.appendArgParamName`) rather than minting a second `b"other"` — one label, one spelling. It is in
// this block because the buffer surface is where the label was first written down, not because the `Array`
// surface has another.
let ManagedMemoryOtherParamName = b"other"

// ⭐ **`appendMemory`'s PARAMETER, AND THE ONE THING THE `append` FOLD MUST NOT LOSE.** The two spellings
// share an emission and an argument RULE, but the corpus declares two names for the one operation —
// `append(other Self)` at `stdlib/Array.maxon:258`, `appendMemory(source ElementMemory)` at `:272` — and the
// refusal's whole job is to name the parameter the author can act on. `Parser.appendArgParamName` reads the
// spelling off the method token so neither door can answer for the other.
let ArrayAppendMemorySourceParamName = b"source"
let ManagedMemoryValueParamName = b"value"

// ⭐ **THE MACHINE-WORD ELEMENT WIDTH A `__ManagedMemory.create(count, 8)` NAMES** — the
// second and last of the two widths the compiler can give a buffer an element TYPE for, `ByteStringElementSize`
// being the first. It is `LayoutDescriptor.MachineWordBytes`, spelled here for the reason
// `ManagedArrayElementBytes` is spelled in this file: a `ByteOffset` and a `FullRangeInt` are distinct
// types, and the comparison happens on the parsed side.
// ⇒ Read by `managedMemoryInstanceForElementSize` (which width maps to which instance) and by
// `managedMemoryElementSizeIsTypeable` (which widths are admitted at all), so those two answer about ONE
// set of widths rather than two lists that can drift.
let ManagedMemoryWordElementSize = 8

// ⭐ **THE ERROR A `__ManagedMemory` MEMBER THROWS** — `stdlib/Builtins.maxon:151-160`, and NOT
// `ArrayError`: `invalidLength` and `invalidByteRange` name conditions `ArrayError` has no case for, so a
// handler that binds the error would be shown cases the operation cannot report. The eight cases keep
// `stdlib/Builtins.maxon`'s ORDER, because the ordinal IS the error flag the runtime returns — the same
// wire format `__ManagedFileError`'s order is.
//
// ⚠ Every case is declared whether or not a member throws it yet: the ordinals are positional, so a
// case inserted between two of them later would silently reroute every handler already written
// against the others.
let ManagedMemoryErrorTypeName = b"__ManagedMemoryError"

// ⭐⭐ **`ArrayError` — WHAT EVERY THROWING `Array` ACCESSOR THROWS, AND WHY IT WEARS A RESERVED NAME.**
// `stdlib/Array.maxon:6-9` declares it with exactly two cases, and `specs/array-slots.md` discriminates
// both (`emptySlot` for an index INSIDE `[0, count())` whose slot was never filled, `indexOutOfBounds` for one
// that is not) — so the enum has to be REGISTERED, or `match e` over an `arr.get` failure reports a missing
// FEATURE for a program whose feature is present — the same reason `__ManagedFileError` and
// `__ManagedMemoryError` are registered.
//
// ⚠⚠ **IT IS THE BARE NAME, NOT A RESERVED `__ArrayError`, AND THAT WAS MEASURED RATHER THAN CHOSEN.** The
// two sibling builtin error enums are `__`-prefixed (`StringIndexTypeName` gives the argument: a user
// declaration of the same name would land in the same map bucket and the later write would win). This one
// cannot be, because USER SOURCE ALREADY NAMES IT: four committed cases declare `function … throws ArrayError`
// and PROPAGATE an array accessor's failure through it (`array-slice-managed-elements.md` ×3,
// `borrow-liveness.md`). Under `__ArrayError` every one of them became
// `E3059: try propagates '__ArrayError' but enclosing function throws 'ArrayError'` — one error type under two
// spellings, which is the very confusion the prefix exists to prevent.
// ⇒ So `ArrayError` is RESERVED PROGRAM-WIDE here, exactly as a stdlib module reserves its type
// names (`StdlibLoader`'s collision rule) and as `CharSet` already is — and for the same reason: The compiler
// synthesizes what `stdlib/Array.maxon` declares, so it owes that file's exported names.
let ArrayErrorTypeName = b"ArrayError"

// `RunProcessError` is reserved for `ArrayError`'s reason: `__gt_process_run` throws its ordinals.
let RunProcessErrorTypeName = b"RunProcessError"

// ⚠ **NO `StringError` CONSTANT STANDS HERE EITHER, FOR `MapError`'S REASON ABOVE, AND IT IS THE SHARPER
// CASE OF THE TWO.** `stdlib/String.maxon:6-9` declares it; `__strix_first`/`__strix_last`/`__strix_after`
// stopped transcribing its ordinals when their members retired onto that module, so no literal error flag
// stands against the declared case order; and neither the case names nor the type name has a reader left. A
// constant whose only mention is its own declaration is a second copy of the case order waiting to disagree
// with the first, which is the defect this whole neighbourhood exists to prevent.

// ⭐ **`ArrayError`'s TWO CASES ARE `__ManagedMemoryError`'s FIRST TWO, IN THE SAME ORDER, AND THAT IS THE
// REFERENCE'S OWN ARRANGEMENT** (`stdlib/Array.maxon:6-9` against `stdlib/Builtins.maxon:151-153`). So ONE pair
// of name constants serves both enums: writing them twice would let the two orders drift apart while each file
// still read "correct", and the ordinal IS the error flag a throwing runtime returns in both families.
let ManagedMemoryIndexOutOfBoundsCaseName = b"indexOutOfBounds"

let ManagedMemoryEmptySlotCaseName = b"emptySlot"

let ManagedMemorySliceOutOfBoundsCaseName = b"sliceOutOfBounds"

let ManagedMemoryInvalidLengthCaseName = b"invalidLength"

let ManagedMemoryInvalidCapacityCaseName = b"invalidCapacity"

let ManagedMemoryShiftOutOfBoundsCaseName = b"shiftOutOfBounds"

let ManagedMemoryInvalidByteRangeCaseName = b"invalidByteRange"

let ManagedMemoryInvalidAllocationCaseName = b"invalidAllocation"

let InitMethod = b"init"

// `String.init(managed ByteMemory)` — `stdlib/String.maxon:114`, the corpus's way back from a
// `__ManagedMemory` to a `String`.
let StringInitManagedParamName = b"managed"

// ⭐ **`c.asciiValue()` — `stdlib/Character.maxon:154-166`, the one THROWING member left with a SYNTHESIZED
// arm.** `GtRuntime.runtimeCalleeSourceMethod` has to answer E3057 with the very constant
// `dispatchCharacterMethod` matches the source token against — one fact in one place.
//
// ⚠ **IT IS THE ONLY SUCH CONSTANT, BECAUSE A MEMBER WHOSE BODY IS THE CORPUS'S NEEDS NONE.**
// `findFirst`/`findLast`/`indexAfter` are `stdlib/String.maxon`'s, so their E3057 comes from the ORDINARY
// declared-function path, which reads the callee's real name; only a member whose throwing callee is a
// SYNTHESIZED runtime entry needs a constant here and a map back to the source spelling.
let CharacterAsciiValueMethod = b"asciiValue"

// ⭐ **THE ERROR EVERY `__ManagedFile` OPERATION THROWS**, and the type a handler's `match e`
// discriminates. It is DECLARED at `stdlib/Builtins.maxon:175` and read from there; the reason its
// case ORDER is load-bearing is `Project.BuiltinErrorOrdinalCheck`'s, which holds this file's ordinals to it.
let ManagedFileErrorTypeName = b"__ManagedFileError"

// The three case names, in the order `specs/managed-file.md` states them — which IS their ordinal order,
// and therefore the error flag the runtime returns. Not reorderable; see the layout's comment.
let ManagedFileNotFoundCaseName = b"notFound"

let ManagedFileAccessDeniedCaseName = b"accessDenied"

let ManagedFileOpenFailedCaseName = b"openFailed"

// The remaining cases, APPENDED rather than inserted. That is not a style choice: the ordinal IS
// the wire format the runtime returns as an error flag, so inserting or reordering one silently
// reroutes every handler in the corpus.
let ManagedFileReadFailedCaseName = b"readFailed"

let ManagedFileWriteFailedCaseName = b"writeFailed"

let ManagedFileSizeFailedCaseName = b"sizeFailed"

let ManagedFileDeleteFailedCaseName = b"deleteFailed"

let ManagedFileStatFailedCaseName = b"statFailed"

let ManagedFileInvalidStatBufferCaseName = b"invalidStatBuffer"

let ManagedFileInvalidStatIndexCaseName = b"invalidStatIndex"

let ManagedFileClosedCaseName = b"closed"

let ManagedFileAlreadyExistsCaseName = b"alreadyExists"

let ManagedFileBusyCaseName = b"busy"

// The FIELD that yields it from a byte array — `stdlib/String.maxon:68`'s `var managed as ByteMemory`,
// which the corpus reaches as `"…".toByteArray().managed`. An identity read; see the arm in
// `Parser.dispatchArrayMethod`.
let ManagedMemoryFieldName = b"managed"

// ⭐ **THE ONE PLACE THAT ANSWERS "is this a compiler builtin MANAGED type?"** — read by
// `Parser.requireConstructible` to raise E3072.
//
// ⚠⚠ **IT NAMES ALL FOUR, BECAUSE THE SPEC NAMES THEM ALL.**
// `specs/struct-construction-restriction.md:29` reads *"Compiler builtin managed types
// (`__ManagedMemory`, `__ManagedFile`, ...) are never constructible with a struct literal and report E3072
// instead"* — naming `__ManagedMemory` FIRST — so a roster holding only file and directory would answer
// `__ManagedMemory{_block: 0}` **E3076** (*"use a static factory method instead"*, a cure that
// cannot be written for an OS-handle type). MEASURED, with no `maxoncstderr` block pinning the
// wrong answer, which is exactly how prose comes to disagree with code unwatched. ⇒ **Every such name
// belongs on this roster**, and the roster carries NO CENSUS of itself (*"a later change extends the
// list"*) — a roster that states its own completeness is the thing that rots.
//
// ⚠ **DELIBERATELY NOT FOLDED INTO `isCompilerOwnedTypeName`, and the distinction is load-bearing rather
// than tidy.** That predicate answers "does the compiler RESERVE this name?" — it gates the
// undeclared-name verdict and `requireTypeNameNotCompilerOwned`'s refusal of a user declaration binding
// one of its six. This one answers "is this an opaque OS-handle type a struct literal may never build?".
// The two sets are disjoint today (none of those six is managed, and this type is not reserved under a
// bare alias) and they are asked at different doors for different reasons; merging them would give one
// predicate two meanings and make the next `CharacterSet`-shaped misreport inevitable.
function isBuiltinManagedTypeName(name ByteArray) returns bool
	return isRawHandleName(name) or name.equals(ManagedMemoryTypeName)
end 'isBuiltinManagedTypeName'

// Its one field, per the spec's "Type Structure". Unexported and immutable: the corpus never reads or
// writes it — `__ManagedFile{_handle: 0}` is E3072 (`managed-file.error-direct-construction`) precisely
// so the handle cannot be forged — and the runtime reaches it through `ManagedFileHandleOffset`.
let ManagedFileHandleFieldName = b"_handle"
let ManagedFileHandleFieldIndex = 0

// ⭐ **THE COMPILER-OWNED `__ManagedDirectory` TYPE** — an 8-byte box holding one pointer to a
// separately allocated FIND BLOCK (the search handle, the `WIN32_FIND_DATAW` the OS refills, and the
// advance-first pending flag), with a runtime-owned destructor that closes the search on drop.
// `specs/managed-directory.md`'s "Type Structure" states the single `_block` field and the RAII contract;
// `ManagedDirectoryRuntime`'s header states why the record is two-level.
//
// ⚠ Like `__ManagedFile` and unlike the retired `__StringIndex`/`__CharacterSet`, the registry name and the user-facing
// name are the SAME bytes — which is what lets the type cross a function boundary, and the corpus requires
// exactly that: `specs/managed-directory.md`'s `search-and-list` declares `export var dir as
// __ManagedDirectory` and returns a `TestDir` built from one.
let ManagedDirectoryTypeName = b"__ManagedDirectory"

// The nine `__ManagedDirectory` methods: six statics and three instance methods. A name outside
// this set is refused by name at its own span rather than mangled into a callee no file declares
// (`Parser.resolveStaticMember` / `Parser.dispatchManagedDirectoryMethod`).
let ManagedDirectoryOpenSearchMethod = b"openSearch"
let ManagedDirectoryExistsMethod = b"exists"
let ManagedDirectoryCreateMethod = b"create"
let ManagedDirectoryDeleteMethod = b"delete"
let ManagedDirectoryCurrentPathMethod = b"currentPath"
let ManagedDirectoryResolveMethod = b"resolve"
let ManagedDirectoryNextMethod = b"next"
let ManagedDirectoryFilenameMethod = b"filename"
let ManagedDirectoryCloseMethod = b"close"

// ⭐ **THE ERROR EVERY THROWING `__ManagedDirectory` OPERATION THROWS**, and the type a handler's
// `match e` discriminates. It is DECLARED in `stdlib/Builtins.maxon` and read from there; the
// reason its case ORDER is load-bearing is `Project.BuiltinErrorOrdinalCheck`'s, which holds this file's
// ordinals to it.
let ManagedDirectoryErrorTypeName = b"__ManagedDirectoryError"

// The eleven case names in `__ManagedDirectoryError`'s declaration order — which IS their ordinal order, and
// therefore the error flag the runtime returns. Not reorderable; see the layout's comment.
let ManagedDirectoryNotFoundCaseName = b"notFound"

let ManagedDirectoryAccessDeniedCaseName = b"accessDenied"

let ManagedDirectoryOpenSearchFailedCaseName = b"openSearchFailed"

let ManagedDirectoryNextFailedCaseName = b"nextFailed"

let ManagedDirectoryIteratorInvalidCaseName = b"iteratorInvalid"

let ManagedDirectoryCreateFailedCaseName = b"createFailed"

let ManagedDirectoryCurrentPathFailedCaseName = b"currentPathFailed"

let ManagedDirectoryClosedCaseName = b"closed"

let ManagedDirectoryDeleteFailedCaseName = b"deleteFailed"

let ManagedDirectoryDeleteNotEmptyCaseName = b"deleteNotEmpty"

let ManagedDirectoryResolveFailedCaseName = b"resolveFailed"

// ⭐ **THE PER-STREAM END-STATE `subprocessStdoutState`/`subprocessStderrState` ANSWER**, declared in
// `stdlib/Builtins.maxon` and read from there. It is not an ERROR family: a stopped stream is a fact the
// three `StreamingSubprocess` readers decide on, and `stdlib/Subprocess.maxon`'s `finishRead` is what turns
// one of these four cases into a `SubprocessError` or into an answer.
//
// ⚠ **ITS CASE ORDER IS THE RUNTIME'S STATE WORD, AND `GtRuntime` DOES NOT TRANSCRIBE IT.** A streaming
// slot holds the ordinal itself, so every emitter that stores or tests one reads the tag out of this
// declaration through `Project.requireCorpusDeclaredEnum` — `Ordering`'s arrangement, and for `Ordering`'s
// reason: a site that must EMIT a number has no degraded answer to give, so there is nothing for a
// transcription-drift check to catch and nothing to drift.
let SubprocessStreamStateTypeName = b"__SubprocessStreamState"

// The four case names, as `stdlib/Builtins.maxon` spells them. The NAMES are stated here (an emitter has to
// ask for a case by some spelling); the ORDINALS behind them are not — see the type name above.
let SubprocessStreamOpenCaseName = b"open"

let SubprocessStreamAtEofCaseName = b"atEof"

let SubprocessStreamReadFailedCaseName = b"readFailed"

let SubprocessStreamNoSuchChildCaseName = b"noSuchChild"

let StdioStreamTypeName = b"StdioStream"

let StdioStreamStdoutCaseName = b"stdout"

let StdioStreamStderrCaseName = b"stderr"

// ⭐ **THE COMPILER-OWNED `__ManagedSocket` TYPE** — an 8-byte box holding one raw OS socket handle, with
// a runtime-owned destructor that closes it on drop. `specs/managed-socket.md`’s "Type Structure" states the
// single `_handle` field and the RAII contract; it is the `__ManagedFile` handle mechanism one type over,
// and deliberately NOT the two-level box `__ManagedDirectory` needs (a socket has no find-block to carry).
//
// ⚠ Like `__ManagedFile` and `__ManagedDirectory`, the registry name and the user-facing name are the SAME
// bytes — which is what lets the type cross a function boundary, and `stdlib/TcpClient.maxon:16` requires
// exactly that: it declares `var socket as __ManagedSocket` as a field of `TcpClient`.
let ManagedSocketTypeName = b"__ManagedSocket"

// Its one field, per the spec’s "Type Structure". No corpus file writes it — `__ManagedSocket{_handle: 0}`
// is E3072 (`managed-socket.error-direct-construction`) precisely so the handle cannot be forged.
let ManagedSocketHandleFieldName = b"_handle"
let ManagedSocketHandleFieldIndex = 0

// The `__ManagedSocket` methods a PEER connection uses: one static and seven instance methods. A
// name outside the whole set — these plus the server side's three below — is refused by name at its
// own span rather than mangled into a callee no file declares.
//
// ⚠ `stdlib/TcpClient.maxon` calls every one of them and nothing else, so this half is the whole contract
// the client corpus needs.
let ManagedSocketTcpConnectMethod = b"tcpConnect"
let ManagedSocketSendFromMethod = b"sendFrom"
let ManagedSocketRecvMethod = b"recv"
let ManagedSocketCloseMethod = b"close"
let ManagedSocketShutdownWriteMethod = b"shutdownWrite"
let ManagedSocketSetReadDeadlineMethod = b"setReadDeadline"
let ManagedSocketSetWriteDeadlineMethod = b"setWriteDeadline"

// ⭐⭐ **THE TIMEOUT CROSSES AS A PREDICATE AND NOT AS AN ERROR CASE — Go's `net.Error.Timeout()`.** It asks
// whether the operation that just failed ended in its deadline, which `stdlib/TcpClient.maxon` maps onto
// `NetworkError.timedOut`; the builtin enum keeps its seven committed cases. See
// `ManagedSocketRuntime.claimManagedSocketOrdinals` for why that matters to a bootstrap.
let ManagedSocketTimedOutMethod = b"timedOut"

// ⭐⭐ **THE SERVER SIDE's THREE, AND THEY HANG OFF THIS TYPE RATHER THAN OFF A `__ManagedListener` OF THEIR
// OWN — WHICH IS A SEED CONSTRAINT AND NOT A PREFERENCE.** A stdlib file may CALL a surface the compiler in
// the slot has never heard of (an unreached body is never parsed), but it may not ANNOTATE a TYPE that
// compiler cannot resolve — a field or a parameter written `__ManagedListener` is E3011 in every compile,
// including the one a released seed makes of this tree. MEASURED with the v0.1.0 seed against this checkout:
// a stdlib type holding a `__ManagedListener` field refused hello-world, while the same file CALLING
// `__ManagedListener.bind` compiled clean.
//
// ⇒ **THE DISTINCTION USERS SEE IS `stdlib/TcpListener.maxon` AGAINST `stdlib/TcpClient.maxon`**, which is
// Go's `net.Listener` against `net.Conn` and is where it belongs: a `TcpListener` has no `send` and no
// `recv`. What is shared is the BOX — one OS socket, closed on drop — and that really is one type.
//
// ⚠ **THEY THROW `__ManagedListenerError`, NOT `__ManagedSocketError`**, because the facts they report are
// new ones and that enum's case list is fixed by every compiler that transcribes it. See
// `ManagedListenerRuntime.claimManagedListenerOrdinals`.
let ManagedSocketBindListenerMethod = b"bindListener"
let ManagedSocketBoundPortMethod = b"boundPort"
let ManagedSocketAcceptMethod = b"accept"

// ⭐ **THE ERROR EVERY THROWING SERVER-SIDE OPERATION THROWS.** DECLARED in `stdlib/Builtins.maxon` and read
// from there, exactly as the four families above are; its case ORDER is load-bearing for
// `Project.BuiltinErrorOrdinalCheck`'s reason.
let ManagedListenerErrorTypeName = b"__ManagedListenerError"

// The six case names in the declaration's order — which IS their ordinal order, and therefore the
// error flag the runtime returns. Not reorderable; the ordinal guard checks this list against the
// declaration.
let ManagedListenerResolveFailedCaseName = b"resolveFailed"

let ManagedListenerBindFailedCaseName = b"bindFailed"

let ManagedListenerAcceptFailedCaseName = b"acceptFailed"

let ManagedListenerAddressFailedCaseName = b"addressFailed"

let ManagedListenerClosedCaseName = b"closed"

let ManagedListenerAcceptRetriableCaseName = b"acceptRetriable"

// ⭐ **THE ERROR EVERY THROWING `__ManagedSocket` OPERATION THROWS**, and the type a handler’s `match e`
// discriminates. DECLARED at `stdlib/Builtins.maxon:164` and read from there, exactly as the file and
// directory families are; the reason its case ORDER is load-bearing is `Project.BuiltinErrorOrdinalCheck`’s,
// which holds this file’s ordinals to it.
let ManagedSocketErrorTypeName = b"__ManagedSocketError"

// The seven case names in `stdlib/Builtins.maxon:165-171`’s order — which IS their ordinal order, and
// therefore the error flag the runtime returns. Not reorderable.
//
// ⚠ **`bufferOutOfBounds` IS ORDINAL 0, NOT A LATER ONE.** It reads like a rare edge case and sits first,
// so a transcription that "tidied" the order would silently re-point every other flag by one. The
// declaration is the authority; this list is checked against it by the ordinal guard.
let ManagedSocketBufferOutOfBoundsCaseName = b"bufferOutOfBounds"

let ManagedSocketResolveFailedCaseName = b"resolveFailed"

let ManagedSocketConnectFailedCaseName = b"connectFailed"

let ManagedSocketSendFailedCaseName = b"sendFailed"

let ManagedSocketRecvFailedCaseName = b"recvFailed"

let ManagedSocketConnectionClosedCaseName = b"connectionClosed"

let ManagedSocketClosedCaseName = b"closed"

let ManagedSocketTimedOutCaseName = b"timedOut"

// The parameter names a `__ManagedSocket` argument mismatch quotes back. Each is part of the
// declared signature — `tcpConnect(host, port)`, `sendFrom(managed, offset, length)` — and each is
// also the label an author may write at the call site (`stdlib/TcpClient.maxon:23` writes `port:`).
//
// ⚠ **ONLY THREE ARE DECLARED HERE, AND THE OTHER TWO ARE DELIBERATELY NOT COPIES.** `sendFrom`'s buffer is
// `ManagedFileManagedParamName` and its byte offset is `ManagedMemoryOffsetParamName` — the same words for
// the same two concepts (a `__ManagedMemory` argument, a byte offset into one), reused for
// `ManagedFilePathParamName`'s stated reason: one word for one fact rather than a per-family copy.
let ManagedSocketHostParamName = b"host"
let ManagedSocketPortParamName = b"port"
let ManagedSocketLengthParamName = b"length"
let ManagedSocketDeadlineParamName = b"milliseconds"
let ManagedSocketNoDeadlineMs = 0

let ManagedPagesTypeName = b"__ManagedPages"
let ManagedPagesBaseFieldName = b"_base"
let ManagedPagesBytesFieldName = b"_bytes"
let ManagedPagesBaseFieldIndex = 0
let ManagedPagesBytesFieldIndex = 1
let ManagedPagesReserveMethod = b"reserve"
let ManagedPagesBaseMethod = b"base"
let ManagedPagesBytesMethod = b"bytes"
let ManagedPagesLendMethod = b"lend"
let ManagedPagesReleaseMethod = b"release"
let ManagedPagesBytesParamName = b"bytes"

let ManagedHandleTypeName = b"__ManagedHandle"
let ManagedHandleWordFieldName = b"_handle"
let ManagedHandleWordFieldIndex = 0
let ManagedHandleTimerMethod = b"timer"
let ManagedHandleAdoptMethod = b"adopting"
let ManagedHandleWordParamName = b"handle"
let ManagedHandleWordMethod = b"handle"
let ManagedHandleReleaseMethod = b"release"

let ManagedPinTypeName = b"__ManagedPin"
let ManagedPinTokenFieldName = b"_token"
let ManagedPinTokenFieldIndex = 0
let ManagedPinAcquireMethod = b"acquire"
let ManagedPinTokenMethod = b"token"
let ManagedPinReleaseMethod = b"release"
let ManagedPinSurrenderMethod = b"surrender"

// ⭐ **THE ERROR A POSSIBLY-ZERO `/` OR `mod` THROWS**, and the type an `otherwise (e)` handler's
// `match e` discriminates. Its ONE case lives with the layout, in `Project.builtinDivisionByZeroErrorEnum`.
//
// ⚠ The `__` prefix is what keeps this name out of user source (`requireUnreservedName`, E2051) — the same
// reason the file/directory/memory families wear it, and the reason `ArrayError` (which cannot, because the
// corpus spells it) needed a place in `isCompilerOwnedTypeName` instead.
let DivisionByZeroErrorTypeName = b"__DivisionByZeroError"

// The single case name. Its ordinal is 0 because it is the enum's first (and only) case, which the layout
// DERIVES from declaration position (`addBuiltinEnumCase`) and `verifyDivisionByZeroOrdinals` holds the
// lowering's transcription to.
let DivisionByZeroCaseName = b"divisionByZero"

// ⭐ **THE ERROR `<Enum>.fromRawValue(raw)` THROWS WHEN NO CASE CARRIES THAT RAW VALUE.** Declared in no
// corpus file, so it is SEEDED (`Project.builtinEnumLookupErrorEnum`) exactly as the division one above is,
// and its ordinal is transcribed in exactly one place (`Runtime/EnumLookupRuntime.maxon`).
//
// ⚠ **IT WEARS THE `__` PREFIX, WHERE `ArrayError`/`MapError` COULD NOT, AND THE TEST IS WHO WRITES THE NAME.**
// Those two are spelled by CORPUS source (`stdlib/Array.maxon`, `stdlib/Map.maxon`) and by any user function
// that propagates one, so a reserved spelling would make one error type meet itself under two names. Every
// use of `fromRawValue` in the corpus CATCHES rather than propagates — `try … otherwise throw` at the
// call site — and `/specs` names no type for it at all, so nothing outside this compiler spells it. The
// prefix therefore
// keeps it out of user source (`requireUnreservedName`, E2051) at no cost, which is the division family's
// position exactly.
let EnumLookupErrorTypeName = b"__EnumLookupError"

// The two case names, in the order `builtinEnumLookupErrorEnum` declares them — position IS the ordinal
// (`addBuiltinEnumCase`), so `noSuchRawValue` is 0 and `noSuchCaseName` is 1.
//
// ⭐ **ONE ERROR TYPE, TWO CASES, BECAUSE THE FAMILY HAS TWO LOOKUPS AND THEY FAIL FOR DIFFERENT
// REASONS.** `fromRawValue` fails when no case carries a raw value; `fromName` when no case bears a name.
// Sharing one type is right — both are "this lookup found nothing", and a handler that wants to treat them
// alike may — but sharing one CASE would make an `otherwise (e) match e … noSuchRawValue then …`
// on a `fromName` call name a fact that is not true of the program. The case an author reads back is the
// only externally visible thing this type has; it may not lie.
let EnumLookupNoSuchRawValueCaseName = b"noSuchRawValue"
let EnumLookupNoSuchCaseNameCaseName = b"noSuchCaseName"

// ⭐ **THE ERROR `Character.asciiValue()` THROWS ON A CLUSTER THAT IS NOT ONE ASCII BYTE.** The CORPUS
// declares it (`stdlib/Character.maxon:15-17`), so it cannot wear the `__` prefix — `ArrayError`'s position
// exactly — and `Runtime/GraphemeRuntime.buildCharAscii` transcribes its ordinal as the literal error flag
// `__char_ascii` returns on the failure edge. That is the two-halves shape `BuiltinErrorOrdinalCheck` exists
// for, and it is the criterion `prepareLowering`'s roster states for itself when it explains why
// `StringError` and `MapError` LEFT: a family is on the roster exactly while a throwing runtime graph
// transcribes its ordinals.
//
// ⛔ **IT WAS THE ONE FAMILY MEETING THAT CRITERION AND MISSING FROM THAT ROSTER — MEASURED.**
// Inserting a case ahead of `notAscii` in `stdlib/Character.maxon` moved the declared ordinal to 1 while
// `buildCharAscii` went on emitting 0, and the compile exited **0 with no diagnostic**. No wrong answer was
// reachable on that tree only because the decode half is unbuilt — `match e` over this enum is E2015, since
// `runtimeThrowsClause` does not seed it — so the drift was a wire format waiting for a reader, which is
// precisely what a guard is for rather than an argument that one is unnecessary.
let CharacterErrorTypeName = b"CharacterError"

// The single case name. Its ordinal is 0 because it is the enum's first and only case — a fact about the
// DECLARATION, which is the direction `verifyCharacterErrorOrdinals` reads it in: the corpus states the
// order and the runtime's literal is held to it, never the reverse.
let CharacterNotAsciiCaseName = b"notAscii"

// Its one field, per the spec's "Type Structure". Unexported and immutable: the corpus never reads or writes
// it — `__ManagedDirectory{_block: 0}` is E3072 (`managed-directory.error-direct-construction`) precisely so
// the block pointer cannot be forged — and the runtime reaches it through `ManagedDirectoryBlockOffset`.
let ManagedDirectoryBlockFieldName = b"_block"
let ManagedDirectoryBlockFieldIndex = 0

// The alias for a `CharacterSet`'s member set — `typealias CharSet = Set with Character`, which
// `stdlib/CharacterSet.maxon:19` declares and the corpus spells (`specs/unicode-category.md:121`). The
// corpus declaration is the authority, and this constant is the RESERVATION's key:
// `TypeResolution.isCompilerOwnedTypeName` names it, and `compilerOwnedTypeMeaning` gives it the
// one non-`nominalIdentity` meaning in that whole set — so a USER file writing the SAME alias is
// admitted and one writing `Set with String` is refused.
let CharacterMemberSetAliasName = b"CharSet"

let FullRangeIntAliasName = b"FullRangeInt"

let FullRangeFloatAliasName = b"FullRangeFloat"

// The one-element `[integer]` argument list of the `Array with integer` literal instance — built fresh
// per call (a `MaxonTypeArray` is owned by the instance it is interned into).
function singletonInteger() returns MaxonTypeArray
	let args = MaxonTypeArray.create(1, zeroed: false)
	args.push(MaxonType.integer)
	return args
end 'singletonInteger'

// ⭐⭐ **A TUPLE IS A SYNTHESIZED STRUCT, NOT A STRUCTURAL TYPE VARIANT.** `(10, 32)` mints a
// `StructLayout` under a reserved, MANGLED name and the value is typed with the existing
// `MaxonType.structRef(TypeNameId)` — so a tuple adds no `MaxonType.tuple` / `ValueTypeTag.tuple` arm, and
// none of the ~25 exhaustive `match` sites over those two unions grows a case. Every tuple mechanism then
// falls out of machinery that already exists and is already debugged: the box is `emitStructLiteral`'s
// `__mm_alloc` plus one `storeIndirect` per element, `t.0` is `emitFieldLoad` at `offsetOfField(0)`, and a
// tuple holding a `String` gets its whole drop cascade from `installStructDestructors`, which synthesizes one
// for any layout in `project.structTypes` that owns a managed field.
//
// The form is MONOMORPHIC — one mangled `__Tuple_<elem>_<elem>` layout with positional fields
// `_0`/`_1` — rather than a `__TupleN` base plus a `genericInstance` over the element types, for
// two reasons: `StructLayoutMap` is name-keyed and `structRef` already resolves id → name → layout,
// so a mangled name drops straight in; and a generic instance's RANGED argument is part of its
// identity, which would make `(Integer, Integer)` and `(int, int)` two different tuple types — the
// very thing `specs/tuples.md`'s `tuple-as-param` requires them not to be.
//
// ⚠ A nested element is INTERNED, not inlined. Spelling a nested tuple by its whole name flattens a
// DAG of tuple types into a TREE — see `tupleElementTokenFor`. The element is instead an interned
// integer that names one entry however deep it is. The two halves are independent: the LAYOUT stays
// monomorphic and name-keyed (both reasons above still hold), and only the way one tuple's identity
// CITES another's changes.
let TupleTypeNamePrefix = b"__Tuple"

// ⚠ **THE ARITY RIDES IN FRONT AND THE ELEMENTS JOIN WITH A CHARACTER NO ELEMENT NAME CAN HOLD** — the
// injectivity rule the Architecture states for `witnessTableLabel`, spent here. An `_` join is NOT injective
// (`_` is inside the identifier alphabet), so `(A_B, C)` and `(A, B_C)` would both spell `__Tuple_A_B_C` and
// the second would silently BECOME the first: one layout, two element lists, and a drop cascade taken from
// whichever registered last. `.` is outside the alphabet the lexer admits inside an identifier.
//
// ⭐ **THE RULE IS TOTAL: NO element token holds the separator.** An element whose own spelling does — a
// nested tuple's name, a dotted companion type, an instance rendering one inline — is cited by a single
// `.`-free token (`tupleElementTokenFor`) instead, so splitting the join on `.` recovers the element list
// outright; leaning on the leading arity to make a flattened list self-delimiting would not.
//
// ⚠ Deliberately its own constant rather than `IrInterface`'s `WitnessLabelSeparator` or the parser's
// `MethodNameSeparator`, for the reason the first of those states at length: three joins whose admissible
// sets differ are three facts, and one constant would couple them so a change to any moved the others.
let TupleElementSeparator = "."

let TupleElementBrandMark = "@"

let TupleCapabilityMark = "@@"
let TupleItemFrozenMark = "i"
let TupleItemPlainMark = "u"

// The positional field name of tuple element `indexDigits` — `_0`, `_1`, … THE one speller, shared by the
// layout builder here and the parser's `.N` → field-name rewrite (`Parser.consumeMemberNameToken`), so the
// slot a literal fills and the slot `t.0` reads cannot come to disagree. It is also the name the SOURCE may
// spell directly (`p._0`, which `specs/tuples.md` writes in five cases): a tuple's fields are ordinary
// struct fields, so the positional sugar and the bare name resolve through one `indexOfField`.
//
// ⚠ **IT TAKES THE INDEX AS ITS DIGITS, and that is what makes it genuinely the ONE speller.** The parser
// holds exactly that — the `intLiteral` token's own text — so a `FieldIndex` parameter would leave it
// re-rendering `_`+digits for itself — a second speller wearing a shared one's clothes — and decoding the
// text to a number first would turn `t.<huge>` from the "no field named
// '_<huge>'" it reports today into a ranged-cast panic.
function tupleFieldName(indexDigits ByteArray) returns immutable ByteArray
	return freeze "_{String.from(indexDigits)}".toByteArray()
end 'tupleFieldName'

// `__Tuple<N>` — the head BOTH tuple-name builders start from: the mangled NAME (which appends its
// elements, `ProgramSignatures.tupleTypeNameOf`) and the ELEMENT TOKEN (read back off a built name by
// `citedNameHeadOf`, so that only ONE of the two ever spells it). One speller, so the two cannot come
// to disagree about how a tuple's arity is written — `instanceNameStem`'s arrangement, for its reason.
function tupleTypeNameHead(arity FieldIndex) returns String
	return "{String.from(TupleTypeNamePrefix)}{arity}"
end 'tupleTypeNameHead'

// The head READ BACK OFF a cited name: for a tuple NAME the very `tupleTypeNameHead` it starts with, for a
// separator-bearing element spelling its first segment. `tupleElementTokenFor` needs it and holds only the name.
//
// ⚠ **THE REASON IS NOT "ONE SPELLER" — `tupleTypeNameHead` IS ALREADY THAT, AND AN ARITY PARAMETER WOULD
// CALL IT TOO.** The reason is that an arity parameter is an input NOTHING TIES TO `name`: a
// caller that passed an arity the name was not built from would mint a token whose head contradicts the
// very string it digests, and no compile error anywhere would say so — the lossy-key shape this file's join
// rules exist to make unstateable. Read back, the head and the name's head are the same bytes by
// construction, and the question cannot be asked wrong.
//
// The first separator always exists: a tuple has at least two elements (`()` and `(x)` are both refused), so
// every tuple name holds at least two of them — and a sweep key's `#<ordinal>` rides at the END, behind every
// element, so it can never arrive in front of the head's terminator. An element spelling is cited by token
// only because it holds one.
function citedNameHeadOf(name immutable ByteArray) returns immutable ByteArray
	let separator = try TupleElementSeparator.toByteArray().get(0) otherwise panic("citedNameHeadOf: `TupleElementSeparator` renders no byte, so nothing ends a cited name's head")

	for i in 0 upto name.count() 'eachByte'
		let b = try name.get(i) otherwise panic("citedNameHeadOf: i < name.count() by the loop bound, but get({i}) failed")

		if b == separator 'headEnds'
			return freeze try name.slice(0, endIndex: i) otherwise panic("citedNameHeadOf: slice [0, {i}) is in range by the loop bound")
		end 'headEnds'
	end 'eachByte'

	panic("citedNameHeadOf: `{String.from(name)}` holds no `{TupleElementSeparator}`, so it is neither a tuple name `tupleTypeNameOf` built nor an element spelling `tupleElementCitationOf` cites by token")
end 'citedNameHeadOf'

// ⭐⭐ **THE BOUNDED TOKEN ONE TUPLE'S NAME CITES ANOTHER BY, AND A PURE FUNCTION OF THE TUPLE'S OWN
// NAME.**
//
// A tuple's identity is its element list, and an element that is ITSELF a tuple must NOT contribute its
// whole name: that flattens a DAG of tuple types into a TREE. `typealias A_k = (A_{k-1}, int)` gives d
// names of Θ(d) bytes, and `typealias A_k = (A_{k-1}, A_{k-1})` — a program whose SOURCE is linear —
// doubles the name at every level.
//
// ⚠ **IT ALSO CITES AN ELEMENT WHOSE SPELLING HOLDS THE SEPARATOR** (`tupleElementCitationOf`) — there for
// injectivity rather than for size, on the same digest, in the same owner ledger.
//
// ⭐ **WHY A DIGEST OF THE NAME IS BOTH BOUNDED AND STRUCTURAL, AND WHY THE RECURSION CLOSES.** `name` is
// what `tupleTypeNameOf` built, and it renders a NESTED element as this very token — so a depth-0 tuple's
// name is fully structural, its digest therefore is, so a depth-1 tuple's name is, and so on by induction.
// The digest is a fixed 64 bits however deep the nesting goes, which is the whole asymptote above; and it
// names nothing but the program.
//
// ⚠ **THE INDUCTION'S BASE CASE IS THE NAME `tupleTypeNameOf` BUILT, AND A SWEEP-PHASE NAME IS NOT YET
// RESOLVED — SO ONE CITATION IN THE TREE STILL CARRIES A SOURCE SPELLING.** Before
// `allFilesFolded` an element renders as the bare name the source wrote, and `sweepScopedTupleName` may add
// its first-free `#<ordinal>`; such a name reaches a citation through exactly one door —
// `canonicalTupleName`'s re-entry, which resolves a SELF-REFERENTIAL tuple alias's element back to
// the sweep spelling it already carries. ⛔ MEASURED on `tuples.md`'s
// `error.self-referential-tuple-alias`: renaming `typealias Int` to `Signed` and `P` to `Q` — which
// changes no type's SHAPE — moves the declared type's citation from `#41e3ea25fc813804` to
// `#303df4d4860b223c`, because the chain bottoms out at the sweep name `__Tuple2.P.Int`. A
// self-referential tuple alias is an infinite type, so nothing constructible reaches that door; the
// residue is therefore confined to spellings the program itself wrote, and the remaining FILESYSTEM
// half of it (a CONTESTED sweep key taking `#<ordinal>` by walk order) is `sweepScopedTupleName`'s,
// filed as its own row rather than fixed here.
//
// ⚠⚠ **IT IS A DIGEST AND NOT A MINT-ORDERED ORDINAL, BECAUSE AN ORDINAL IS A WALK-ORDER ARTIFACT.** A
// token spelled `tupleElementTokens.count()` — the map's own size — is the order `Directory.list` hands the
// files over in. MEASURED: two projects differing only in WHICH sibling file declares
// which tuple alias give ONE type two names, `__Tuple2.__Tuple2#0.int` in one walk order and
// `__Tuple2.__Tuple2#2.int` in the other, reaching an `E3005` sentence, an emitted `__destruct_` symbol and
// (through `mangleTypeArg`) a descriptor label. That sits against the standing user ruling recorded
// in `StdlibLoader`'s header — *"the compiler must not depend on file order to work correctly ... the
// repair belongs at the point of emission, deriving the order from something stable"*. A digest of the name
// IS that stable thing, and `specs/tuples.md`'s
// `error.nested-tuple-name-does-not-depend-on-which-file-declares-it{,-swapped}` pair pins it: the same
// program, the same file names, the contents swapped, ONE byte-identical sentence.
//
// ⚠ A dense interning id cannot serve here: interning order is not stable across build scenarios
// and this token enters a NAME. The token is a pure function of the instance's structural shape, so
// interning order cannot reach a diagnostic, an emitted symbol or `.rdata`.
//
// ⚠ **THE ARITY RIDES IN FRONT SO THE TOKEN STILL SAYS SOMETHING TO A READER.** A tuple's name reaches
// diagnostics and emitted symbols (`__destruct_<name>`), and `__Tuple2.__Tuple2#<digest>.int` at least
// tells its reader that element 0 is a 2-tuple. It is not free of cost: the inner element TYPES do not
// appear, which is a real loss of detail at nesting depth ≥ 2 — bought with the asymptote above, and paid
// only by nested tuples, since a depth-1 tuple's name carries no digest at all.
//
// ⭐ **THE DIGEST IS `Hasher`'s FNV-1a, NOT A SECOND HAND-ROLLED HASH.** `mixBytes` takes the
// `ByteArray` a name already is (no `String` round-trip), folds a trailing LENGTH TAG so a prefix cannot
// alias its extension, and runs in `int(0 to u64.max)` where the multiply WRAPS rather than traps — the one
// arithmetic property a cross-target-identical digest needs, already shipping on every target because the
// query spine keys on it. 64 bits is the width the collision argument rests on: at N = 10^4 distinct tuple
// types P(collision) ≈ N²/2^65 ≈ 5×10⁻¹², where a 40-bit digest would be ≈ 5×10⁻⁵ — a number a real program
// can hit. Do not shorten it to make the rendered Target IR prettier; `recordTupleElementToken`
// panics on a collision, and that panic is a compile that STOPS.
//
// ⚠ The basis and prime are baked into emitted symbols on every target:
// changing either renames every nested tuple in the tree.
//
// The rendering is HEX, the same `0-9a-f` the compiler already spells a machine value in. The alphabet is
// what matters and hex satisfies it exactly: no `.`, so a token cannot hold the element separator, and no
// `#`, so `mintedName`'s join stays the only one in the string. It is `"{n:x}"` — the
// stdlib's own unsigned rendering — rather than a nibble loop here, because a third speller of "a value in
// hex" is a third copy of a fact this tree already writes twice (`TargetPrinter.hexDigit` for a chunk dump,
// the format specifier for everything else), and a frontend door reaching into the TARGET tier for it would
// be a worse coupling than reusing the language's own.
//
// The join is `mintedName`'s for `sweepScopedTupleName`'s reason: `#` appears in no source
// identifier and — critically — in no `TupleElementSeparator`, so the token cannot collide with a spelled
// element and cannot be mistaken for two. It cannot collide with a registered tuple NAME either, by
// character count rather than by convention: a tuple has at least two elements, so every registered name
// holds at least two separators and a token holds none.
//
// It is derived here and NOT in `mangleTypeArg` for the reason that function's own header gives: a
// descriptor label must never come "from a gid number ... a build-order artifact". This token is not one.
function tupleElementTokenFor(name ByteArray) returns immutable ByteArray
	let digest = mixBytes(Hasher.empty(), bytes: name)
	return mintedName(citedNameHeadOf(name), suffix: "{digest:x}".toByteArray())
end 'tupleElementTokenFor'

// Is `name` a synthesized tuple type's name? The prefix is inside the `__` reserved space `E2051` bars every
// declaration from (`Parser.requireUnreservedName`), so a user `type` can never contest one and this test can
// never answer yes for a declared name.
function isTupleTypeName(name ByteArray) returns bool
	return bytesStartWith(name, prefix: TupleTypeNamePrefix)
end 'isTupleTypeName'

// The prefix is compared against the table's arena, so an asker holding only an id materializes no name.
function internedNameIsATupleTypeName(names TypeNameInterner, id TypeNameId) returns bool
	return names.startsWith(id, prefix: TupleTypeNamePrefix)
end 'internedNameIsATupleTypeName'

// The layout of a tuple whose elements are `elements`, ALREADY canonical and already interned against the
// table the caller wants the layout to live in. Fields are positional (`_0`, `_1`, …) in element order — which
// IS the layout, since `StructLayout.offsetOfField` derives an offset from the index — and every one is
// `export var`: a tuple has no encapsulation to enforce (`requireFieldAccessible` must let `t.0` through from
// anywhere) and `t.0 = 20` is legal on a `var` binding.
//
// The ONE builder, called once per interner: `ProgramSignatures` builds its own copy against its own table and
// the parser builds the artifact's against the file's, because `remapArtifact` REWRITES an artifact layout's
// field types in place and a shared object would corrupt the index's copy.
//
// ⚠⚠ **EVERY ELEMENT'S DECLARED SURFACE IS PLAIN HERE, AND IT MUST STAY THAT WAY.**
// `(__ManagedMemory, Int)` and `(ByteArray, Int)` CANONICALIZE TO ONE NAME and therefore to THIS ONE
// LAYOUT — the spelling is already gone from `elements`, which holds the resolved types. Writing a buffer
// surface into this column would hand the buffer's roster to both spellings, decided by whichever interned
// first: a wrong ACCEPTANCE, which no diagnostic reports. A tuple slot's surface rides the VALUE instead
// (`Parser.bufferSurfaceSlots`), and `error.a-tuple-of-byte-arrays-keeps-the-array-surface` is what holds
// this shut.
// ⚠⚠ **`declFilePath` IS THE FILE WHOSE SPELLING MINTED THIS TUPLE, AND IT IS NOT
// `CompilerOwnedDeclFilePath`.** A tuple TYPE is synthesized and declared in no file, but a tuple
// ELEMENT can name a per-file thing: `(Bag, Num)` written in `adef.maxon` means adef's `Bag`, and
// resolving it as a file declaring no `Bag` at all leaves the DECLARING file unable to construct
// its own field. What a tuple has is not a declaration site but a SPELLING site, and every spelling
// has one — so the path a tuple layout carries is the file that wrote the element list.
//
// It is the same column a declared `type` uses because it answers the same question at the same doors:
// `resolveRecordedGenericAliasTypes` re-scopes this layout's recorded `named` elements against it (which is
// what settles a SWEEP-minted spelling, whose elements are still bare names), and `fieldTypeOf` scopes an
// element read through it. Visibility is `global` — a tuple is nameable wherever its
// elements are, and the path is read for SCOPING, never for reach.
function tupleStructLayout(name ByteArray, elements MaxonTypeArray, brands NameRoster, capabilities ParamCapabilityArray, declFilePath FilePath) returns StructLayout
	let layout = StructLayout.create(name, visibility: Visibility.global, declFilePath: declFilePath)

	for i in 0 upto elements.count() 'eachElement'
		// Positionless: every declaration writing this tuple shares the layout (see `WrittenTupleType`).
		layout.addField(tupleFieldName("{i}".toByteArray()), declaredType: try elements.get(i) otherwise panic("tupleStructLayout: elements.get OOB at {i} below count {elements.count()}"), mutable: true, tier: Visibility.global, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: try brands.get(i) otherwise panic("tupleStructLayout: brands.get OOB at {i} below count {brands.count()}"), spelledName: SpelledFieldName.unnamed, typeSite: PositionlessSite)
		layout.fieldTypeSites.noteCapabilityOfLatest(declaredCapabilityAt(capabilities, position: i as ParamCount))
	end 'eachElement'

	return layout
end 'tupleStructLayout'

function tupleItemCapabilitiesOf(layout StructLayout) returns ParamCapabilityArray
	let capabilities = ParamCapabilityArray.create(layout.fieldCount(), zeroed: false)

	for i in 0 upto layout.fieldCount() 'eachItem'
		capabilities.push(layout.fieldTypeSites.capabilityAt(i))
	end 'eachItem'

	return capabilities
end 'tupleItemCapabilitiesOf'

function tupleCapabilitySuffix(capabilities ParamCapabilityArray, count ElementIndex) returns String
	var marks = ""
	var marked = false

	for i in 0 upto count 'eachItem'
		if declaredCapabilityAt(capabilities, position: i as ParamCount) == ParamCapability.immutable 'aFrozenItem'
			marks.append(TupleItemFrozenMark)
			marked = true
		end 'aFrozenItem' else 'aPlainItem'
			marks.append(TupleItemPlainMark)
		end 'aPlainItem'
	end 'eachItem'

	return "{TupleCapabilityMark}{marks}" if marked else ""
end 'tupleCapabilitySuffix'

function rowMentions(baseId TypeNameId, args MaxonTypeArray) returns TypeIdRemap
	let watcher = TypeIdRemap.watching(i64.max)
	_ = remapMaxonTypes(args, remap: watcher)
	watcher.seenNames.insert(baseId)

	return watcher
end 'rowMentions'

function instanceBrandsOf(elements MaxonTypeArray, written NameRoster) returns NameRoster
	let brands = NameRoster.create(elements.count(), zeroed: false)

	for i in 0 upto elements.count() 'eachElement'
		let element = try elements.get(i) otherwise panic("instanceBrandsOf: elements.get OOB at {i} below count {elements.count()}")
		let brand = try written.get(i) otherwise panic("instanceBrandsOf: written.get OOB at {i} below count {written.count()} — a tuple's brand column is built in lockstep with its element column")
		brands.push(brand if maxonTypeTag(element) == ValueTypeTag.genericInstance else EmptySourceText)
	end 'eachElement'

	return brands
end 'instanceBrandsOf'

// ⚠ **A TUPLE HAS AT LEAST TWO ELEMENTS, AND `(a)` STAYS GROUPING FOREVER.** `(2 + 3) * 4` means 20 because
// the parentheses group; a one-element tuple would make that spelling ambiguous with nothing to disambiguate
// it, so it is refused at the one place a tuple is minted.
let MinTupleArity = 2 as FieldIndex

// Why a type cannot be a tuple ELEMENT — raised by `ProgramSignatures.internTupleType` and turned into a
// positioned `E2015` by the parser, which is the only party holding a token to anchor it on.
//
// It is a THROW rather than a `panic` because it is reachable from source: a tuple built out of a value whose
// type the front end never resolved.
export union TupleElementRejection
	// The element's type tag has no place in a tuple's identity — an `unresolved` (nothing to mangle) or a
	// `void` (no value at all). See `requireTupleElementType`.
	unsupportedTag(position FieldIndex, tagName String)
end 'TupleElementRejection'

// What a rejection says — the one sentence both the parser's positioned E2015 and the index's own invariant
// panic render.
function tupleElementRejectionSentence(rejection TupleElementRejection) returns String
	return match rejection 'why'
		unsupportedTag(position, tagName) gives "a tuple whose element {position} is '{tagName}': a tuple's identity IS its element types, and neither an unresolved type nor `void` can key one"
	end 'why'
end 'tupleElementRejectionSentence'

// How a tuple's name cites one canonical element — `ProgramSignatures.tupleElementCitationOf` decides it once
// for the reader that renders the name and the writer that records the token ledger.
union TupleElementCitation
	// A nested tuple, cited by the token its registered layout owns.
	nestedTuple(name immutable ByteArray)

	// A spelling holding `TupleElementSeparator`, cited by its digest token.
	separatorBearing(spelling immutable ByteArray)

	asSpelled(spelling String)
end 'TupleElementCitation'

// The name id `id` denotes in the interner it was MINTED against — `ProgramSignatures.nameOfId`'s twin for the
// direction that reads a FOREIGN table (`adoptTypeFrom`). A miss is an invariant break, not a case: every id
// handed to that door was minted by the caller's own `parseTypeReference` against exactly this table.
function foreignNameOf(typeNames TypeNameInterner, id TypeNameId) returns immutable ByteArray
	return try typeNames.nameOf(id) otherwise panic("foreignNameOf: type-name id {id} is not in the interner it was passed with — a type crossing INTO the signature index must carry ids minted against the interner named alongside it")
end 'foreignNameOf'

// Is `element` a type a tuple can be keyed on? An `unresolved` is not: there is nothing to mangle. A `void`
// is not: it is no value at all. Both are reachable from source, so each is a positioned rejection rather
// than a panic.
//
// ⭐⭐ **A `typeParameter` IS ONE, AND THE THREE ARGUMENTS FOR REFUSING IT ARE EACH ANSWERED.**
//
//   • **IDENTITY.** *"`mangleTypeArg` would spell it by POSITION, so two instantiations would silently
//     share one layout"* is true of a position and false of the digest token: two distinct parameters
//     mangle and intern apart.
//   • **LAYOUT — measured, not argued.** `LowerMaxonToStd.maxon:142` lowers a
//     type parameter to `StdType.i64`, "AN OPAQUE MACHINE WORD", and `Project.fieldSlotCount` gives
//     every non-existential field exactly one 8-byte slot. So `(Key, Value)` has a statically known 16-byte
//     layout; there is no layout to be missing.
//   • **DROP CASCADE — the real one, and it is answered by the LAYOUT DESCRIPTOR the
//     instance already carries**, not by knowing the concrete type here. A tuple over parameters is dropped
//     the way every other opaque aggregate is: through the per-instance descriptor. Refusing the TYPE to
//     avoid a question about a VALUE is a category error — the two are separable, and the value-side
//     hazard keeps its own refusal at the construction site (see the borrowed-opaque rule), which is where
//     ownership is actually decided.
//
// ⚠ **The value-side refusal is NOT lifted here and must not be**: aliasing a BORROWED opaque element into a
// tuple is still refused where it is built, because the tuple would store the borrow without a reference and
// its caller's concrete drop would release it twice. That is a claim about a construction, and this function
// is asked about a TYPE.
function requireTupleElementType(element MaxonType, position FieldIndex) throws TupleElementRejection
	let tag = maxonTypeTag(element)

	if tag == ValueTypeTag.unresolved or tag == ValueTypeTag.void 'unsupported'
		throw TupleElementRejection.unsupportedTag(position, tagName: typeTagName(tag))
	end 'unsupported'
end 'requireTupleElementType'

// The composite-key index a `GenericInstanceRegistry` interns through, and the alias-name map that
// resolves `IntBox` to its interned instance. Keyed on `ByteArray` — a cheap string key built from
// the base id and the arg (tag, id) pairs — so interning is O(1) amortized rather than a linear
// structural scan over every prior entry.
typealias GenericInstanceIndexMap = Map with (ByteArray, GenericInstanceId)

// @generated library-cache begin
function cacheWriteGenericInstanceIndexMap(writer LibraryCacheWriter, value GenericInstanceIndexMap)
	writer.unsigned(value.count() as CacheUnsigned)

	for (key, entry) in value 'eachEntry'
		writer.bytes(key)
		writer.unsigned(entry as CacheUnsigned)
	end 'eachEntry'
end 'cacheWriteGenericInstanceIndexMap'

function cacheReadGenericInstanceIndexMap(reader LibraryCacheReader) returns GenericInstanceIndexMap throws LibraryCacheDamage
