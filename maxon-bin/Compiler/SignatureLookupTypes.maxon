		if from == to 'ontoItself'
			panic("Set.moveMember: moving a member onto itself would delete it")
		end 'ontoItself'

		if not self.contains(from) 'absent'
			return
		end 'absent'

		self.insert(to)
		_ = self.remove(from)
	end 'moveMember'
end 'Set'

