	// not (⇒ contested, and from then on the answer lives in `contestedFreeFunctions`). A per-name array of
	// every directory would allocate for every free function in the program to record a fact almost no name
	// has.
	var freeFunctionDirectories as FreeFunctionDirectoryMap

	// ⭐⭐ **THE BARE NAMES DECLARED AS A FREE FUNCTION IN MORE THAN ONE DIRECTORY ⇒ THOSE DIRECTORIES, IN
	// DECLARATION ORDER, THE ROOT LISTED AS THE EMPTY DIRECTORY.** EMPTY for every program in the corpus, which
	// is what makes this mechanism byte-neutral: a name nobody contests is registered under exactly the bytes
	// it had.
	//
	// ⭐ **MEMBERSHIP IS THE FLAG AND THE VALUE IS THE CANDIDATE LIST — one structure, not two.** A separate
	// "is contested" set beside a directories map would be the same fact filed twice, which is the shape every
	// cross-file defect in this compiler has had.
	//
	// ⚠ **THE ROOT CONTRIBUTES NO MINT**: it IS the unqualified namespace, so its entries keep the BARE key
	// (`freeFunctionRegistrationName`).
	var contestedFreeFunctions as ContestedFreeFunctionMap

	var functionDirectoryHolders as DirectoryHolderMap

	// The generic types an earlier fold of these sources found a parse instantiating that no declaration did
