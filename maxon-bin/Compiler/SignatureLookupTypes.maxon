	let result = GenericInstanceIndexMap.create()

	for _ in 0 upto count 'eachEntry'
		let key = try reader.bytes()
		let entry = (try reader.unsigned()) as GenericInstanceId
		result.upsert(key, value: entry)
	end 'eachEntry'

	return result
end 'cacheReadGenericInstanceIndexMap'

