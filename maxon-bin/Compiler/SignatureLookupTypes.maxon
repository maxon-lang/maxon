// only for a name the first pass has already condemned, which is why it may
// afford a map and a `FilePath.toString()` per declaration where that pass may not.
type GenericAliasDeclarationGroup
	// Declaring file path ⇒ the instance that file's declaration names — published verbatim as this name's
	// entry in `ContestedGenericAliasMap`.
	export var byDeclaringFile as GenericAliasByDeclaringFile

	// ⭐ **THE BUFFER-SPELLING BITS OF EACH DECLARATION, KEYED BY THE INSTANCE.** Keyed by instance and
	// not by file because the MINT this feeds is derived from the instance
