	// (`ProgramSignatures.rewriteSweptDeclarationReturnTypes`). A fresh record rather than a field write,
	// because every column here is a `let`: what a declaration SAID does not change, only what the index has
	// since worked out that it MEANS.
	export function withReturnType(rewritten MaxonReturnType) returns SweptDeclaration
		return Self{paramNames: self.paramNames, paramTypes: self.paramTypes, paramSpellings: self.paramSpellings, paramDefaults: self.paramDefaults, takesReceiver: self.takesReceiver, returnType: rewritten, visibility: self.visibility, declFilePath: self.declFilePath, site: self.site, selfCapability: self.selfCapability, paramCapabilities: self.paramCapabilities, returnCapability: self.returnCapability}
	end 'withReturnType'

	export function withParamTypes(rewritten MaxonTypeArray) returns SweptDeclaration
		return Self{paramNames: self.paramNames, paramTypes: rewritten, paramSpellings: self.paramSpellings, paramDefaults: self.paramDefaults, takesReceiver: self.takesReceiver, returnType: self.returnType, visibility: self.visibility, declFilePath: self.declFilePath, site: self.site, selfCapability: self.selfCapability, paramCapabilities: self.paramCapabilities, returnCapability: self.returnCapability}
