	// A nested `typealias UArr = Array with U`, keyed `Inner.UArr` by `Parser.qualifiedInnerGenericAlias`.
	// Claimed SECOND, so it names an instance only when nothing unscoped does — "the only name".
	typeScoped
end 'DisplayNameRound'

export enum RecordedReturnTypeRule
	// ⭐ **The contested generic ALIAS a `returns` clause names, rescoped against the file that
	// DECLARED the function.** See `rewrittenReturnTypeUnder`'s `contestScopedAlias` arm and the two walks
	// that supply it a file (`recordedReturnDeclFileOf`, and an `SweptDeclaration`'s own).
	contestScopedAlias

	// ⭐⭐ **SETTLE WHAT A RECORDED RETURN TYPE NAMING A STRUCT BOX IS SPELLED AS: the ONE repair
	// that makes a `returns Inner` and a `returns Self` be the same recorded declaration.**
	//
	// It claims TWO shapes: a bare `named` that denotes a
	// declared `type` OR a tuple typealias (re-tagged to the box's `structRef`), and an already-`structRef`
	// TUPLE whose name is not yet the canonical spelling. Both are the same defect — the sweep recorded a
	// type before it could say what everything downstream would call it — and neither is visible from the
	// tag alone, which is why `sweptStructTypeOf` asks "what should this name be?" rather than "is this tag
	// still bare?". See there for the two measurements.
	//
	// `Parser.parseTypeReference` resolves the enclosing type's own name — `Self`, and the type's own
	// spelling — to a `structRef` SYNTACTICALLY, because that is a fact about the tokens and needs no
	// registry, and the declaration sweep therefore answers it identically to the real parse. A FOREIGN
	// name it cannot: the sweep reads a `returns` clause while `structLayouts` is still being filled, so the
	// answer would depend on the filesystem's walk order, and the arm deliberately records a bare `named`
	// instead. ⇒ **one struct, two recorded spellings**, and this rule is where the second becomes the
	// first.
	//
	// ⚠ **IT IS A NORMALIZATION, NOT A SECOND RESOLUTION RULE** — `declaredInterface`'s words below, and
	// the same discipline. The rule is the READ DOOR's, statement for statement: a `named` naming a
	// declared `type` becomes a `structRef`; a `named` naming a UNION or a ranged int ALIAS stays a
	// `named`, because that IS the tag those carry (`enumMatchFor` reads a union's, and a ranged alias is
	// the integer). It asks `containsStruct` — the same door that read door asks — so the two cannot come
	// to disagree about which names move.
	//
	// ⚠⚠ **IT RUNS EARLY AND `declaredInterface` RUNS LATE, AND NEITHER POSITION IS FREE.** Each
	// normalization can only run once the registry it consults is whole: `structLayouts` is filled by the
	// sweep itself, so this may run the moment every file is folded, while `interfaces` is filled by
	// `foldInterfaceDeclarations`, which runs later. They do not race: a name is a struct or an interface
	// and never both (`declaredFormOf` answers one form, and E3006/E3061 refuse a name two registries
	// hold), so this walk leaves every interface name a `named` for the rule below to claim.
	declaredStruct

	// ⭐⭐ **RE-TAG EVERY SWEPT `named` THAT DENOTES AN `interface` AS AN
	// `interfaceRef`.** The return-type half of `normalizeSweptInterfaceTypes`, whose header carries the
	// wrong SIZE this closes and why the field half cannot ride this walk (it writes through a layout, not
	// through this map).
	declaredInterface
end 'RecordedReturnTypeRule'

// ⛔ **ONLY A WRITTEN-OUT DEFAULT MAY BE REPLACED**, which is exactly one token of `kind` spanning the whole
// initializer. An expression is refused rather than overridden because its value is derived from the source:
// replacing `let V = base + suffix` would leave a binary saying something no reading of the code produces.
// `initEnd` is EXCLUSIVE — `requireInitializerConsumed` compares `pos >= initEnd` — so one token is
// `initStart + 1`.
//
// ⚠ An INTERPOLATION does not slip through: the lexer splits `"a{x}b"` into
// `stringLiteral stringInterpStart …`, so its range is several tokens and the count test refuses it.
function initializerIsLoneTokenOf(decl TopLevelDecl, tokens TokenArray, kind TokenKind) returns bool
	if decl.initEnd != decl.initStart + 1 'notExactlyOneToken'
		return false
	end 'notExactlyOneToken'

	let tok = try tokens.get(decl.initStart) otherwise panic("initializerIsLoneTokenOf: initializer token {decl.initStart} is not below the declaring file's {tokens.count()} tokens")
	return tok.kind == kind
end 'initializerIsLoneTokenOf'

// The declarations one define name reached, and what a refusal names them by.
type DefineClaimants
	export var decls as TopLevelDeclIndexArray
	export var list as String
	export var anyAtTheRoot as bool

	static function create() returns DefineClaimants
		return Self{decls: TopLevelDeclIndexArray.create(0), list: "", anyAtTheRoot: false}
	end 'create'

	// Asked only once the count is known to be one.
	function sole() returns ElementIndex
		if self.decls.count() != 1 'notOne'
			panic("DefineClaimants.sole: {self.decls.count()} declarations claim the name")
		end 'notOne'

		return try self.decls.get(0) otherwise panic("DefineClaimants.sole: decls.get OOB at 0 below count 1")
	end 'sole'
end 'DefineClaimants'

type MisclosedBlockSite
	let filePath as String
	let refusal as SourceParseError
	let bodyStart as PositionKey
	let closer as PositionKey
	let corruptibleNames as NameRoster

	static function create(filePath String, refusal SourceParseError, bodyStart PositionKey, closer PositionKey, corruptibleNames NameRoster) returns Self
		return Self{filePath: filePath, refusal: refusal, bodyStart: bodyStart, closer: closer, corruptibleNames: corruptibleNames}
	end 'create'

	function encloses(position PositionKey) returns bool
		return position >= self.bodyStart and position < self.closer
	end 'encloses'

	function couldHaveCorrupted(message String) returns bool
		for name in self.corruptibleNames 'eachName'
			if textMentionsIdentifier(message, identifier: name) 'mentionsIt'
				return true
			end 'mentionsIt'
		end 'eachName'

		return false
	end 'couldHaveCorrupted'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.refuse()
	end 'cacheWrite'

	static function cacheRead(_ LibraryCacheReader) returns MisclosedBlockSite throws LibraryCacheDamage
		throw LibraryCacheDamage.unrepresentable
	end 'cacheRead'

	// @generated library-cache end
end 'MisclosedBlockSite'

typealias MisclosedBlockSiteArray = Array with MisclosedBlockSite

// @generated library-cache begin
function cacheWriteMisclosedBlockSiteArray(writer LibraryCacheWriter, value MisclosedBlockSiteArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteMisclosedBlockSiteArray'

function cacheReadMisclosedBlockSiteArray(reader LibraryCacheReader) returns MisclosedBlockSiteArray throws LibraryCacheDamage
	let count = try reader.count()
	let result = MisclosedBlockSiteArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try MisclosedBlockSite.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadMisclosedBlockSiteArray'

// @generated library-cache end

// The part of the signature index only the sweep and the settle write. Every front-end worker reads
// one frozen copy of it once `ProgramSignatures.publishedDeclarations` runs, so nothing past the
// parse baseline may write here (`ProgramSignatures.requireBeforeTheBaseline`).
export type SettledDeclarations
	var misclosedBlocks = MisclosedBlockSiteArray.create(0)

	// Function name -> its declared return type. First-wins on a duplicate name; the duplicate itself is
	// reported by `commitFuncSignatures` (E3006), which fails the build.
	var returnTypes as FuncReturnTypeMap

	// Typealias name -> its declaration, with the RANGE the shift rule needs. It carries no
	// type-name IDS — a ranged alias's underlying type is always the `int` KEYWORD, never a name —
	// so unlike `returnTypes` it needs no interner and no remap: it travels by name and arrives by
	// name.
	var typeAliases as RangedAliasRegistry

	// Every FUNCTION typealias in the program, keyed by (name, declaring file) for `typeAliases`' reason: a
	// non-exported one is file-local, so two files declaring one name are two types and a bare key would
	// hand one file the other's shape. Like `typeAliases` it carries NO type-name ids — a function alias's
	// return type is stored interner-free as a (tag, name-ByteArray) pair (see FunctionTypeAlias) — so it
	// travels by name and arrives by name, needing no interner and no remap. THE door
	// `Parser.parseTypeReference` asks "is this name a function alias?" through, and the one an indirect
	// call recovers the callee's return type from.
	var functionTypeAliases as FunctionAliasRegistry

	// The `<Type>.<member>` spellings `Parser.publishNestedFunctionAlias` mints beside a nested function
	// alias's bare name. A name in here is NOT a brand: no source position outside the declaring type can
	// write it, so it can never be the name an author chose to tell two shapes apart, and a value of any
	// other function alias of that shape decays into it (`functionBrandsConflict`).
	//
	// ⚠ Membership, never a test for a dot. `functionTypeAliases` also holds the directory-qualified mirror
	// `Parser.pushNamespaceQualifiedFunctionAlias` mints, and `api.Score` IS writable in a type position — a
	// real brand, which has to keep refusing a `legacy.Score`. This set is the exact roster of the spellings
	// the nested minter wrote.
	//
	// It folds nothing into `self.hash`, for `recordExtensionInnerAliasMember`'s reason:
	// `recordFunctionTypeAlias` mixes the same qualified spelling off the very push this sits beside, so a
	// second mix would key one parse memo twice on one declaration. It is not rewound past the parse
	// baseline either, because nothing past it adds to it: `recordNestedFunctionAlias` answers a name
	// it already holds and refuses a new one.
	var nestedFunctionAliasMembers as NestedFunctionAliasNameSet

	var pendingImplementsClauses as AliasImplementsClauseArray
	var implementsParents as AliasImplementsParentMap
	var implementsVerdicts as AliasImplementsVerdictMap

	// ⭐ Every swept struct type's declaration, at the slot `ProgramSignatures.structSlots` files its
	// name under, with the FIELD ORDER the parser needs. THE door `p.x` asks through, and the reason
	// it must be here rather than in `Project`: a field's offset is needed at PARSE time, and
	// `type Point` may be declared BELOW the function that reads a `Point` or in another file
	// entirely. The same argument the header makes for a callee's return type, about a different
	// declaration.
	//
	// ⚠ **UNLIKE `typeAliases`, IT CARRIES IDS** — a field's declared type is a `MaxonType`, and
	// `named(Integer)` is meaningless outside the interner that minted it. So it obeys the header's
	// ID PROBLEM: `foldFile` remaps each file's ids into `typeNames` on the way in, and
	// `fieldTypeOf` re-interns on the way out. It is the second table to need that treatment, and
	// it needs it for exactly `returnTypes`' reason.
	var structLayouts as StructLayoutArray

	// ⭐ **EVERY DECLARED `type`'s NAME, IN SWEEP ORDER — the ORDERED key list `structSlots` cannot be.** One
	// reader: an INTERFACE EXTENSION expands onto every conformer of its interface, and the ORDER it finds
	// them in is the order the monomorphized methods are emitted in — a fact that reaches the object file.
	// Walking the map instead would make the emitted function order a property of a hash table's bucket
	// layout rather than of the program, which is exactly the shape `interfaceNamesInDeclOrder` exists to
	// avoid one registry over. Written only by `recordStruct`, in the same act as the map entry.
	var structNamesInDeclOrder as NameRoster

	// ⭐ Enum/union name -> its declaration, with the CASE ORDER and TAGS the parser needs. THE door
	// an enum `match` asks through — is `c` an enum? what tag is `red`? which cases does `low to
	// high` cover? — and here for `structLayouts`' reason: the answer is needed at PARSE time and the
	// `enum` may be declared below its use or in another file.
	//
	// ⚠ **LIKE `structLayouts`, IT CARRIES IDS** — a case NAME and a tag INT carry none, but a
	// PAYLOAD field's declared type is a `MaxonType`, and `holds(inner BoxA)`'s `named(BoxA)` is
	// meaningless outside the interner that minted it. So a payload-bearing union obeys the header's
	// ID PROBLEM exactly as `structLayouts` does: `foldFile` remaps each file's payload ids into
	// `typeNames` on the way in (`remapEnumLayoutPayloadTypes`, the enum twin of
	// `remapStructLayoutFieldTypes`), and the parser re-interns on the way out (`adoptType`, the
	// same door `fieldTypeOf` uses). A payload-FREE enum carries no ids and travels by name alone.
	//
	// ⭐ **SEEDED, NOT EMPTY**: `createEnumRegistry` builds it holding the
	// compiler-known `Ordering`, so the parser resolves `Ordering.lessThan`, `match <compare result>` and a
	// `o Ordering` parameter through the ordinary enum doors. The seed deliberately does NOT ride
	// `self.hash` (which `recordEnum` folds a DECLARED enum into): the hash exists to invalidate a parse
	// memo when a declaration a reader COPIED FROM changes, and this declaration is byte-identical in every
	// program — mixing a constant would move every program's hash and invalidate nothing.
	// ⚠ **EXPORTED FOR ONE READER**: `requireCorpusDeclaredEnum`, the single door to a compiler-owned
	// enum's corpus declaration, which serves the PARSER off this index and the Std tier off
	// `Project.enumTypes` — one function over one type, rather than a message written twice. Everything else
	// still goes through `enumOf`/`containsEnum` below.
	export var enumTypes as EnumLayoutMap

	// ⭐ The generic-alias DECLARATIONS, in record order — the deterministic list `firstCyclicAliasDecl`
	// walks. `genericAliases` is keyed by NAME and is a Map, so it can answer "which instance?" but never
	// "which alias was declared first?"; the E3091 blame must be a property of the program, not of a map's
	// iteration, so the order is kept explicitly here.
	var genericAliasDecls as GenericAliasEntryArray

	var genericAliasDeclIndexByName as GenericAliasDeclIndexMap
	var genericAliasDeclsIndexedThrough as ElementIndex

	// ⭐ Each interned instance's DISPLAY name — the `typealias` an author declared for it. See
	// `InstanceDisplayNameMap`. Filled once by `deriveInstanceDisplayNames`, which is the only writer, so the
	// parse (which fans out per file) only ever reads it.
	var instanceDisplayNames as InstanceDisplayNameMap
	var funcReturnAliasNames as FuncReturnAliasNameMap

	// ⭐⭐ **EVERY TYPE-PARAMETER TOKEN ⇒ THE `(declaring type, parameter, position)` THAT MINTED IT** —
	// `tupleElementTokenOwners`' twin one digest over, and it earns its keep twice. It makes a 64-bit digest
	// collision a DETECTED event (`recordTypeParamToken` STOPS the compile on one rather than handing two
	// parameters one identity), and it is the ONLY route from a token back to its declaration for a reader
	// holding nothing else — which is what let the three `genericTypeFieldHas…Instantiation` gates stop
	// taking a `(baseName, position)` PAIR their callers had to pair up by hand.
	//
	// ⚠ **WRITTEN AT THE FOLD, READ DURING THE PARSE — never the other way round.** `recordStruct` and
	// `recordInterfaceDeclaration` are its only writers, and both run while the declaration sweep is folding,
	// single-threaded. That is the same discipline `deriveInstanceNames` states for the name memos: the
	// per-file parse fan-out may READ this index and may not write it. Empty for a program with no generics.
	var typeParamOwners as TypeParamOwnerMap

	// ⭐ Which type names more than one KIND of declaration holds — see `settleCrossKindContests`, its one
	// writer. Born `unwritten`, which is where it stays for every program in the corpus.
	var crossKindContests as CrossKindContestTable

	// Every name more than one declaration claims, with its claims by bare name and by namespace
	// spelling. Collected per reference instead, the claims cost O(references × directories). It is
	// built in `settleBaseline`, once every registry it reads is final, because no parse may write
	// the index it shares, and the fingerprint notes it so `requireAtBaseline` names a write past
	// that point. A name it does not hold is collected on demand.
	var typeNameClaimIndex as TypeNameClaimIndex

	// The one need with a PAYLOAD rather than a bit: a fixed array's instance is keyed by its SIZE as well as its
	// element, so the set of sizes the program constructs is what has to be carried (see
	// `Parser.foldDeclaredSignaturesInto`'s `fixedArrayFromSizes`). Accumulated across files with duplicates left
	// in — interning is idempotent, and a `Set` here would trade a handful of repeated interns for a hash of
	// every size in the program.
	var fixedArrayFromSizes as FixedSizeArray

	// The names written as the head of a `<Name> from […]` construction, in any file
	// (`Parser.foldDeclaredSignaturesInto`'s `fromHeadNames`). Read once every file has folded, when a name can
	// be asked which alias it is.
	var fromHeadNames as FromHeadNameSet

	// ⭐ Generic-instance TYPEALIAS name ⇒ its interned instance — `IntBox` ⇒ the giid for
	// `Box with Integer`. THE door `Parser.parseQualifiedCall` resolves `IntBox.create` to `Box.create`
	// through, and the one the instantiation checks read the base + args from. It carries no ids of its
	// own (the giid indexes `genericInstances`), so it travels by name.
	var genericAliases as GenericAliasMap

	// ⭐⭐ **`<Interface>.<member>` ⇒ THE INSTANCE ITS RIGHT-HAND SIDE NAMES** — `Holder.ElementArray`
	// ⇒ the giid for `Array with <Holder's Element>`, from `typealias ElementArray = Array with Element`
	// written inside `interface Holder uses Element`.
	//
	// ⚖ **IT IS A SEPARATE MAP FROM `genericAliases` ABOVE, AND THE SPLIT IS THE USER RULING.** That map is
	// the set of names a READER may write, and putting an interface's member in it would make
	// `parseTypeReference` resolve the requirement's `ElementArray` to a `genericInstance` — which would
	// render the requirement as a mangled `Array_T…` and leave a diagnostic quoting a digest at an author who
	// wrote a name. An interface's `typealias` is LOCAL SHORTHAND: it names no type outside its own body, and
	// its one job downstream is to say what a requirement that spells it actually requires. So the requirement
	// keeps rendering `Holder.ElementArray`, and exactly one consumer — `ConformanceCheck` — expands it.
	//
	// ⛔ **CONFORMANCE IS DECIDED ON THE UNDERLYING TYPE, NEVER ON THE ALIAS'S SPELLING** (⚖ user ruling).
	// A conformer CANNOT avoid inventing a name — `value Array with Element` is E2010 in a parameter list
	// and E3005 in a field — so matching spellings would force every conformer to guess the interface's
	// private one, and `stdlib/Set.maxon` and `stdlib/List.maxon` would conform through
	// `InitableFromArrayLiteral` only by having independently written `ElementArray`.
	// `specs/associated-types.md`'s `w61.*` cases are the gate.
	var interfaceAliases as GenericAliasMap

	// Which interfaces declared one of the above — the per-interface half of the same fact, and the only
	// form of it the conformance check's fast path can use (see `interfaceDeclaresAlias`). Derived in the
	// same act as the map, so the two cannot disagree about whether an interface has an alias.
	var interfaceAliasOwners as InterfaceNameSet

	// ⭐⭐ **THE GENERIC-ALIAS NAMES TWO FILES DISAGREE ABOUT** — the map above is keyed by the bare NAME
	// alone, which is exactly what `RangedAliasRegistry` was before file scoping and had exactly its defect:
	// the last file folded won and every other file silently got its instance. A non-exported `typealias` is
	// FILE-LOCAL whatever it aliases (`specs/duplicate-typealias.md`), so a generic one is no more
	// whole-program than a ranged one is.
	//
	// A derived index over `genericAliasDecls`, settled in ONE pass once every file has folded
	// (`settleGenericAliasContest`) rather than maintained per declaration: whether a name is contested is a
	// fact about ALL of its declarations at once, exactly as `RangedAliasRegistry.rangeContested` is.
	//
	// ⭐ **A NAME WHOSE DECLARATIONS NAME ONE INSTANCE IS NOT IN HERE**, and that is the load-bearing half.
	// Two files declaring `typealias Counts = Array with Count` over one `Count` intern the SAME instance, so
	// there is nothing to choose between and nothing moves — which is the entire existing corpus.
	var contestedGenericAliases as GenericAliasContestTable

	// ⭐⭐ **THE GENERIC-ALIAS NAMES MORE THAN ONE DECLARATION MENTIONS** — the gate that makes the whole
	// contest cost NOTHING for a program that has none, which is every program in the corpus. A name only one
	// declaration mentions cannot disagree with anything, so an EMPTY set here is a complete answer and
	// `settleGenericAliasContest` returns on its first line.
	//
	// ⭐ **MAINTAINED BY `recordGenericAlias` AND DERIVED FROM A PROBE IT ALREADY MAKES** — the `upsert` into
	// `genericAliases` needs the name hashed either way, so "have I seen this name before?" is one extra probe
	// of a map already in hand rather than a second index of its own. It is `RangedAliasRegistry`'s
	// `multiplyDeclared` invariant exactly, narrowed to the half this side needs: WHICH names, not which
	// declarations, because the declarations are retained in `genericAliasDecls` already.
	var multiplyDeclaredGenericAliases as DisagreeingAliasNameRoster
	var sharedInstanceGenericAliases as DisagreeingAliasNameSet
	var genericAliasMints as GenericAliasMintTable
	var runtimeFilePaths as LibraryFilePathSet
	var scriptlibFilePaths as LibraryFilePathSet

	// ⭐ Every `typealias X = Base with Args` INSTANTIATION SITE, with its source anchor — the
	// list the where-constraint check (E3017) walks to validate each concrete argument conforms to the
	// interface its type parameter is constrained to. A LIST, not a map: an instance may be named by several
	// aliases, each a distinct site to check + anchor; a `Box with Foo` with no `where` constraint contributes
	// entries the check skips in O(1) (empty constraint list). Empty for a program with no generic aliases.
	var genericAliasSites as GenericInstantiationSiteArray
	var genericWithSites as GenericWithSiteArray

	// The same list for the instantiations a TOP-LEVEL literal inferred, which no `typealias` names and no
	// parse artifact can carry — see `constInferredInstantiationSites` for both halves of why it lives here.
	var constLiteralSites as GenericInstantiationSiteArray

	// ⭐ INNER ranged typealias registry — a RANGED `typealias Idx` declared INSIDE a generic
	// type, keyed by its BASE-QUALIFIED name ("Wrapper.Idx"). It is what makes a per-instance alias
	// (`IntWrapper.Idx`) nominal: `isPerInstanceAlias` composes an instance alias's base with this
	// registry to decide whether `Instance.Member` names one. Like `typeAliases` it carries no ids and
	// travels by name. The stored `RangedTypeAlias.name` is the BARE member ("Idx") — the piece the
	// method-return retype re-qualifies with a concrete receiver's alias.
	var innerAliases as RangedTypeAliasMap

	// ⭐⭐ **THE `<Conformer>.<member>` NAME OF EVERY PER-INSTANCE NESTED `typealias` AN `extension` BODY
	// DECLARES — THE SCOPE, RECORDED AHEAD OF THE DECLARATIONS.** A nested `typealias` is a MEMBER of
	// the type it is written in, and `stdlib/helpers/sort/` is where that stops being a same-body question:
	// several files each write `export extension Array`, `insertionSort.maxon` declares `SortComparator` and
	// the others spell it BARE from their own bodies. The three registries above answer *what*
	// `Array.SortComparator` resolves to; this set answers the question that comes first — *is
	// `SortComparator` a member of `Array` here?* —
	// and it has to be answerable before any of them is filled.
	//
	// ⚠ **A SEPARATE SET BECAUSE OF WHEN IT IS WRITTEN, NOT BECAUSE OF WHAT IT HOLDS.** A `type` body's nested
	// aliases are folded with their file (`recordScannedType` ⇒ `foldFile`), so `declaresInnerAlias` already
	// answers for them whole-program. An `extension` body's are folded one site at a time by
	// `Queries.foldExtensionDeclarations`, which READS each body's signatures as it goes — so a body folded
	// before `insertionSort.maxon`'s would resolve `SortComparator` differently from one folded after it, and the
	// answer would be the directory walk's order (`StdlibLoader`'s header rules that out). This set is filled by
	// a pre-pass over every extension site before the first body is read, which is what makes the answer a
	// property of the program.
	//
	// ⚠ **PER-INSTANCE FORMS ONLY — a nested FUNCTION alias is deliberately absent**, for the reason
	// `readNestedTypeAlias` keeps one out of `Parser.enclosingInnerAliases`: it is a file-scope name written
	// inside a body (`publishNestedFunctionAlias` files it BARE as well as qualified, which is already why a
	// cross-file `SortComparator` resolves today), and `parseTypeReference`'s inner-alias arm would stamp it
	// `named(...)` where it must reach the `function` arm and carry a `function` tag.
	var extensionInnerAliasMembers as ExtensionInnerAliasNameSet

	// The declaration that keeps each `<Conformer>.<member>`, filed by author sites only: the library
	// declares one member from several extension files, so recording its sites would refuse them.
	var extensionInnerAliasKeepers as ExtensionInnerAliasSiteMap

	// The `<Type>.<member>` of every nested typealias a `type` body declares, filed by the declaration
	// sweep alone. An extension's member never enters it: the type-extension refusal asks whether the
	// type's OWN body declares the name.
	var typeBodyInnerAliasMembers as ExtensionInnerAliasNameSet

	// The `<Conformer>.<member>` keys the library's `extension` bodies and the program's declare, and the keys
	// both declare. Filled by the pre-pass of `Queries.foldExtensionDeclarations`, conformers a conditional
	// extension withholds included, so the answer does not depend on fold order. `innerAliasMemberFor` reads the
	// shadowed set.
	var libraryExtensionInnerAliasMembers as ExtensionInnerAliasNameSet

	var authorExtensionInnerAliasMembers as ExtensionInnerAliasNameSet

	var authorShadowedInnerAliases as ExtensionInnerAliasNameSet

	// ⭐ **EVERY SIGNATURE THE SWEEP DROPPED FOR A RETURN TYPE IT COULD NOT READ** — see `DroppedSignature`
	// for what that tolerance is for and what it was absorbing. EMPTY for a healthy compile, which is what
	// lets every reader gate on `hasDroppedSignatures` and pay one emptiness test rather than a lookup per
	// refused member.
	//
	// ⚠ **RETURN TYPES ONLY, AND THE OTHER DROP IS EXCLUDED ON PURPOSE.** `recordScannedSignature` has a
	// second tolerant exit — a parameter list `skipBalancedParens` cannot balance — which loses a signature
	// by the identical route and is deliberately NOT recorded here. A return type the DEFERRED fold could not
	// canonicalize is a COMPILER fault the real parse never re-raises, which is why the loss needs a record to
	// be attributable at all; an unbalanced parameter list is a SYNTAX error the real parse reports on its own,
	// with a position, and recording it would let E9002 — an internal-error code — reach a use site ahead of
	// that report and describe a plain typo as a compiler bug. The narrower map is the honest one, so this
	// comment states its scope rather than letting `hasDroppedSignatures` be read as *nothing was dropped*.
	var droppedSignatures as DroppedSignatureMap

	// ⭐ Per-method INNER-ALIAS PARAMETER info — for a method/factory that declares a parameter
	// whose type is a bare inner alias of the enclosing generic type (`setTag(t Idx)`), the source
	// parameter NAMES and, per source position, the inner-alias MEMBER (`Idx`) or empty. Keyed by the
	// method's qualified name (`Wrapper.setTag`). THE door the parser's per-instance argument check asks
	// through at a concrete call site: the shared method signature is opaque to the receiver's instance,
	// so the check needs the parameter's inner-alias member here (params are SKIPPED by the sweep's
	// return-type read, so nothing else records them at this phase). Only methods that HAVE such a
	// parameter get an entry — absence is "no inner-alias parameter", the common case.
	var methodInnerAliasParams as InnerAliasParamInfoMap

	// ⭐⭐ **INTERFACE NAME -> ITS WHOLE DECLARATION** — the one whole-program answer to *"which
	// interface does this name denote?"* at PARSE time, and here for `structLayouts`' reason exactly:
	// the answer is needed while a file is being parsed and the `interface` may be declared BELOW its
	// use or in another file.
	// Two parse-time doors read it, and neither may answer at its own scope:
	//   • `Parser.interfaceUsesArity` — `associatedTypeNames.count()`, how many arguments an unparenthesized
	//     `implements Duo with A, B` binds;
	//   • `Parser.requireInterfaceForParse` — the METHOD SIGNATURES a witness dispatch resolves against
	//     (`findWitnessDispatchCandidates` reads a method's name, return type, formal types, formal names and `throws`).
	//     Scanning the PARSING FILE's `artifact.interfaces` instead reads a table that fills as the linear
	//     parse reaches each declaration — so `type Box uses T where T is Digest` with `interface Digest`
	//     written below it is `E2015 … not declared before its constrained use` on a program that compiles
	//     with the two lines swapped, and every cross-file spelling is the same reject.
	//
	// ⚠ **THE WHOLE `IrInterface`, NOT THE FIVE FIELDS THE DISPATCH READS, AND THAT IS THE LESS DUPLICATIVE
	// CHOICE.** A bespoke record holding exactly what `findWitnessDispatchCandidates` consumes would need its own
	// builder, and a SECOND builder of an interface signature is precisely what drifts from the real parse's —
	// the standing hazard of having a pre-scan at all. `foldInterfaceDeclarations` runs the parser's OWN
	// `readInterfaceDeclaration`, the same function `parseInterfaceDeclaration` calls, so what lands here is
	// the declaration the real parse would build, field for field. What is deliberately narrow is the HASH:
	// only the fields a PARSE copies ride it (see `recordInterfaceDeclaration`).
	var interfaces as IrInterfaceMap

	// ⭐⭐ **EVERY INTERFACE NAME THE PROGRAM CAN DISPATCH THROUGH, IN ONE FIXED ORDER — the interner-FREE
	// scalar handle a witness dispatch names its requirement's interface by.** A `witnessDispatch` op has to
	// say WHICH interface's slot list its `methodIndex` indexes, so that `LowerMaxonToStd` can recover the
	// requirement's declared FORMALS and collapse them to ABI widths where that collapse belongs. It may not
	// say so with a NAME, and it does not say so with a `TypeNameId`, which is file-local until the merge
	// renumbers it (`ParseStaging.renumberedOp`). An INDEX into this list needs no renumbering: it is
	// whole-program by construction, fixed before the first body is parsed, and identical for every file.
	//
	// ⭐ **IT STORES NAMES, NOT DECLARATIONS, SO THAT AN INDEX RESOLVES BY THE ONE RULE.** `lookupInterface`
	// answers a SYNTHESIZED protocol before it consults any registry, and a user may declare a type of the same
	// name; storing the declaration here would let an index resolve to the user's while every other reader saw
	// the builtin's. A name goes through `lookupInterface` at the asking end instead — with whichever map that
	// caller's PHASE holds, which is exactly the split `IrInterface.lookupInterface`'s header defends.
	//
	// The SYNTHESIZED protocols occupy the fixed prefix (`builtinInterfaceNames`) because they are in no
	// registry and would otherwise have no position; `recordInterfaceDeclaration` — the SINGLE writer of
	// `interfaces` above — appends every declared name after them, in the same act, so the two cannot come to
	// hold different sets. A name already present keeps its index, so an index always names one interface.
	//
	// ⚠ **A PARSE MEMO CANNOT SERVE A STALE INDEX.** `ParseMemo.keyHash` mixes `ProgramSignatures.hash`, and
	// `recordInterfaceDeclaration` folds every interface into that hash — so an added, removed or reordered
	// interface re-parses every file, and no cached op can survive holding an index into a list it no longer
	// describes.
	var interfaceNamesInDeclOrder as NameRoster

	// Name → its position in `interfaceNamesInDeclOrder`. The reverse direction of the one relation above,
	// filled in the same single act; the parser asks it once per resolved dispatch target, so the answer is
	// O(1) rather than a scan of every declared interface per dispatch.
	var interfaceDeclIndexByName as InterfaceDeclIndexMap

	// ⭐ Where each `interface` declaration sits, as the tolerant sweep passed it — see
	// `InterfaceDeclSite` for why a POSITION and not the declaration. Read once, by
	// `foldInterfaceDeclarations`, after the last file folds.
	export var interfaceDeclSites as InterfaceDeclSiteArray

	// The names `interfaceDeclSites` declare, filled in the same act — `nameDeclaresAnInterface`'s probe
	// before `interfaces` is folded.
	var interfaceDeclSiteNames as InterfaceNameSet

	var interfaceDeclSiteIndexByName as InterfaceDeclSiteIndexMap
	var interfaceDeclSitesIndexedThrough as ElementIndex

	// ⭐ Where each `extension <Interface>` declaration sits, as the tolerant sweep passed it — see
	// `ExtensionDeclSite`. Read once, by `foldExtensionDeclarations`, after the last file folds, because an
	// extension's methods belong to conformers the per-file sweep has not necessarily met yet.
	export var extensionDeclSites as ExtensionDeclSiteArray

	// ⭐ Where each `type`/`enum`/`union` that writes an `implements` clause sits — see
	// `ConformanceClauseDeclSite`. Read once, by `Queries.foldConformanceClauses`, after the INTERFACE fold,
	// because the clause's own extent depends on an interface arity only that pass knows.
	export var conformanceClauseSites as ConformanceClauseDeclSiteArray

	// ⭐ Where the SIZED CONTAINER's method list begins — its own body, and every extension body over it. See
	// `DescriptorScanSite`. Read once, by `Queries.foldFixedElementCountNeeds`, after the extension fold has
	// put every extension method into the program.
	export var descriptorScanSites as DescriptorScanSiteArray

	// ⭐⭐ **WHICH METHODS CARRY THE HIDDEN FIXED-ELEMENT-COUNT PARAMETER — the count `countof(Self)`
	// reads, keyed by the qualified `Type.method` name and solved by a fixpoint over the sized container's
	// self-call graph.**
	//
	// ⛔⛔ **IT IS A SECOND PARAMETER RATHER THAN A DESCRIPTOR WORD, AND THAT IS A MEASUREMENT AND NOT A
	// PREFERENCE.** A count is a fact about the INSTANCE; every word the layout descriptor carries is a fact
	// about the type ARGUMENT, and that difference is exactly what `MaxonToStdLowering.emitInstanceDescriptorAddr`
	// relies on when it FORWARDS the caller's own blocks to a callee whose instance is written over the
	// caller's parameters. Put the count in that blob and a `FixedArray with 4 Element` reached from inside
	// `type Holder uses Element` reads HOLDER's count — none — instead of 4: **MEASURED, exit 64
	// where the answer is 68.** And the obvious repair (refuse the forward, mint instead) is unreachable in
	// exactly the case the forward fires: the forward arm requires argument 0 to be a type PARAMETER, and
	// minting a single-argument instance whose argument is one PANICS at
	// `genericInstanceArgLogicalSize` — a type parameter's size is itself a descriptor read.
	//
	// ⭐ **A PARAMETER HAS NONE OF THAT, BECAUSE THE COUNT IS A COMPILE-TIME CONSTANT AT EVERY CALL SITE.**
	// The receiver's instance states it (`FixedArray with 4 Element` states 4 even though its ARGUMENT is a
	// parameter), a static's RESULT instance states it, and a self-call inside the sized container's own body
	// forwards the caller's own slot. It also costs the descriptor nothing: a `countof`-reading method that
	// needs no OTHER dictionary word reserves no descriptor at all, so it can be called from a frame that has
	// none.
	var fixedElementCountNeeds as DescriptorNeedNameSet

	// ⭐ Every (conformer, method) a CONDITIONAL extension was withheld from, under the qualified name a call
	// to it resolves to — see `ConditionalExtensionSkip`. Written by `foldExtensionDeclarations`, read at the
	// one door a call to a missing method goes through.
	var conditionalExtensionSkips as ConditionalExtensionSkipMap

	// ⭐ Which interface each of an interface's associated positions is HELD AT, keyed by the interface NAME
	// — see `settleAssociatedTypeHoldings`. An interface holding NOTHING has no entry at all, so the whole
	// corpus but the held-associated-type specs leaves this map empty and every probe is one miss.
	var associatedTypeHoldings as AssociatedTypeHoldingMap

	// ⭐ The type -> declared-interface index as THIS phase can see it, memoized — see `sweptConformanceIndex`.
	var sweptConformances as DeclaredConformanceMap

	// Whether the field above has been built. A FLAG rather than an emptiness test, because a program in which
	// no type declares a conformance builds a genuinely empty index and must not rebuild it per question.
	var sweptConformancesBuilt as bool

	var conformerIndex as DeclaredConformerIndex

	// ⭐⭐ **THE CONFORMANCES AN `extension <T> implements <I>` DECLARES, CONDITIONAL ONES INCLUDED — the half
	// `sweptConformances` above CANNOT HOLD, and without which a SUPPRESSION reads a weaker index than the
	// report it defers to.** `sweptConformances` holds the declarations' own clauses and the unconditional
	// `implements` of an extension of a type, enum, union or primitive (`typeExtensionConformances`); every
	// other extension conformance is recorded per CONFORMER by the REAL PARSE
	// (`Parser.recordExtensionConformance` into `project.conformances`), so the swept index misses it —
	// `extension Array implements Hashable, Equatable where Element is Hashable and Equatable` most of all.
	//
	// ⚠ **IT IS DELIBERATELY UNCONDITIONAL — the `where` clause is NOT applied.** The one reader
	// (`instantiationViolatesItsOwnWhereClause`) needs a SUPERSET of what E3017's merged index holds, because
	// its suppression is only sound when `unmet here` implies `unmet there`. Granting a conditional
	// conformance the conformer may not have earned can therefore only WITHHOLD a suppression, which falls
	// back to an over-refusal — loud, and never a silent accept. See `instantiationMeetsConstraint`.
	var extensionDeclaredConformances as DeclaredConformanceMap

	var typeExtensionConformances as DeclaredConformanceMap

	// ⭐ The witness constraints of each TYPE-extension method — see `ExtensionMethodConstraintMap`. Written by
	// the same fold, in the same act that publishes the method's signature, so a method cannot be published
	// with one witness count and called with another.
	var extensionMethodConstraints as ExtensionMethodConstraintMap

	// THE TOP-LEVEL CONSTANT ARENA — every `let` declared at module scope in any file, in
	// DECLARATION order (source-path order, then in-file order).
	//
	// An ARRAY is the driver and a map is only the index into it, which is the opposite of the two
	// tables above and is deliberate: the E2012 cycle message names its members in the order the DFS
	// met them, so the evaluation order is part of what the compiler PRINTS. Driving from a map would
	// make it depend on hash order. There is nothing to sort here: the sweep builds the array in
	// the order the message needs.
	var decls as TopLevelDeclArray

	// Storage key -> its index in `decls`. One declaration per key (see `recordDecl`).
	var declIndex as TopLevelDeclIndexMap

	// ⭐ Function name -> its per-parameter CONSUME bits — what `consumeOf(callee)` answers a call site
	// asking "does the callee take ownership of my argument at position i?". Filled by
	// `recordParamConsume` as each file is folded; last-wins on a duplicate name.
	// `declParamConsumes` keeps the same facts per declaration SITE, so
	// each declaration of a name keeps its own (`consumeOfDeclaration`).
	var funcParamConsumes as ParamConsumeMap
	var declParamConsumes as ParamConsumeMap

	// ⭐⭐ Declaration SITE -> its `mutable` parameter mask, and `byRefSitesOfKey` the sites filed under
	// each registration key. `byRefOf` / `byRefOfDeclaration` answer BOTH ends of the ABI — the callee's own
	// `bindParameters`, deciding whether a parameter arrives as a cell address, and the call site,
	// deciding whether to hand one over. Filled by `recordParamReassign` as each file is folded. Only a
	// function that declares a `mutable` parameter is recorded — the "absence is the answer" default
	// `funcParamConsumes` rests on.
	var funcParamReassigns as ParamReassignMap
	var byRefSitesOfKey as DeclarationSitesByKeyMap

	var sawMutableMarker as bool
	var sawMutableFunctionValue as bool

	// ⭐⭐ **THE IMMUTABLE-GLOBAL-RETURN FIELDS** — see `GlobalAliasReturnInfo` for what is recorded and
	// `closeGlobalAliasReturns` for what closes it.
	var funcGlobalAliasReturns as GlobalAliasReturnMap

	// The settled answer, by registration key. Empty until the closure runs.
	var globalAliasReturnKeys as GlobalAliasReturnKeySet

	// ⭐ **THE BARE NAMES OF EVERY FUNCTION THAT DECLARES A `mutable` PARAMETER**, kept because the PARSER's
	// local-cell prescan needs exactly it. That prescan reads a callee out of TOKENS, so all it has is what the
	// source wrote before the `(` (`reassign`), never the registration key a method is filed under
	// (`Forwarder.reassign`); a lookup by the qualified key would answer false for every method call and the
	// caller's `var` would never get a cell. Matching by bare name over-approximates, which is sound: a cell is
	// a legal home for any value, so an unrelated same-named callee costs an allocation and nothing else.
	var byRefBareNames as BareNameSet
	var opaqueByRefBareNames as BareNameSet
	var corpusHandOffsByCallee = HandOffsByCallee.create()
	var corpusIndirectHandOffs = HandOffPositionsByArity.create()
	var freeFunctionByRefPositions = HandOffPositionsByArity.create()
	let genericInstanceNameMarker as immutable ByteArray

	// ⭐ Function name -> its `throws E` clause. `throwsOf(callee)` is the door a call site asks
	// "does this callee throw, and what error type?". Filled by `recordThrows` from each file's scanned
	// signatures; last-wins on a duplicate name (E3006 reported elsewhere).
	// Only THROWING functions are recorded — a callee with no entry is non-throwing, the safe default that
	// makes recording only the throwing ones correct (the same "absence is the answer" `funcParamConsumes`
	// rests on).
	var funcThrows as FuncThrowsMap

	// ⭐ The functions that NEVER RETURN — see `SweptBodyFactEntry`. `functionNeverReturns(callee)` is
	// the door a bare-call STATEMENT asks before deciding the call ends its block. Only a proved-diverging
	// declaration is recorded, so a program with no `panic` helper carries an empty set.
	var funcDiverges as DeclaredBodyFactNameSet

	// ⭐ The functions that can only ever THROW — `funcDiverges`' second way out, on its own registry
	// because its door is a different call shape: `functionAlwaysThrows(callee)` is what a PROPAGATING `try`
	// STATEMENT asks before deciding the call ends its block. Empty for a program with no such helper.
	var funcAlwaysThrows as DeclaredBodyFactNameSet

	// ⭐⭐ The functions whose every `return` hands back a record built in the `return` itself — the
	// third `SweptBodyFactEntry` fact, on its own registry for its siblings' reason: `returnsFreshValue(callee)`
	// is what a SEND asks before it may MOVE a call's result to another green thread. Empty for a program with
	// no service in it, and for every declaration whose returns the sweep could not read that exactly.
	var funcReturnsFreshRecord as DeclaredBodyFactNameSet

	// ⭐⭐ **THE CONDITIONAL HALF OF THAT FACT: declaration key → the callees its forwarding `return`s hand
	// their answer straight back from** (see `SweptBodyFact.returnsAFreshRecordIfCalleeDoes`). Written by the
	// merge, READ ONCE by `closeFreshReturnForwards`, and empty for every program whose bodies build every
	// record they return — which is nearly all of them, so the close's own guard is this map's count.
	var funcFreshReturnForwards as FreshReturnForwardMap

	// ⭐⭐ The static factories that are nothing but the construction they perform — see
	// `SweptBodyFact.constructsSelfFromItsParameters`. `functionConstructsFromParams(callee)` is what the
	// record probe asks before imaging a top-level `T.create(…)` as the construction it stands
	// for. Empty for a program whose factories do anything else.
	var funcConstructsFromParams as DeclaredBodyFactNameSet

	var funcReturnsReceiverField as DeclaredBodyFactNameSet

	var funcReturnsParameter as DeclaredBodyFactNameSet

	var funcFieldMoveOutForwards as FreshReturnForwardMap

	var interfaceRequirementNames as MethodNameSet

	// ⭐ Function name -> its per-parameter DEFAULTS. `defaultsOf(callee)` is the door
	// `Parser.emitCall` asks before deciding an under-supplied call is an arity error. Filled by
	// `recordParamDefaults` from each file's scanned signatures; only the declaration that holds a
	// name's key records (a later declaration of the name is E3006). Only functions that declare AT LEAST ONE
	// default are recorded — a callee with no entry has no defaults, the "absence is the answer" default
	// `funcParamConsumes` rests on — so the overwhelming majority of programs carry an empty map.
	var funcParamDefaults as ParamDefaultMap

	// ⭐ Method name -> which of its parameters are declared as a bare TYPE PARAMETER. See
	// `OpaqueParamInfo`. `opaqueParamsOf(callee)` is the door `Parser.recordOpaqueArgRangeChecks` asks before
	// building a range guard out of the receiver instance's own type argument. Filled by `record` from each
	// file's scanned signatures, beside the return type it accompanies; only the declaration that holds a
	// name's key records (a later declaration of the name is E3006). Only a
	// declaration that HAS such a parameter is recorded — the "absence is the answer" default
	// `funcParamConsumes` rests on — so every program that declares no generic type carries an empty map.
	var funcOpaqueParams as OpaqueParamMap

	// ⭐ **EVERY FUNCTION WHOSE DECLARED RETURN TYPE NAMED `__ManagedMemory` ANYWHERE, AND WHERE.**
	// `declaredReturnSurface(callee)` is the door `Parser.emitCall` asks "does this call's result denote the
	// BUFFER, or a tuple with a buffer in it, or the `Array` around it?" — a question no `MaxonReturnType` can
	// answer, because the alias resolves to `Array with Byte` and the spelling is gone (see
	// `registerManagedFileType`).
	//
	// ONLY A NON-PLAIN SURFACE GETS AN ENTRY, for `managedTopLevelNames`'s measured reason: the reader is on the
	// hot path (every direct, method and static call in the program), and a program that never writes the alias
	// must not pay per call for an answer that is always no. Written by `record`, in BOTH directions, so it can
	// never outlive the return type it describes.
	var declaredReturnSurfaces as DeclaredReturnSurfaceMap

	// ⭐⭐ **WHICH FILE DECLARED EACH FUNCTION WHOSE RECORDED RETURN TYPE IS STILL A BARE `named` — the
	// column that makes a return type answer to ITS OWN file rather than to its READER'S.**
	//
	// ⛔ **WITHOUT IT A CROSS-FILE RETURN OF A CONTESTED GENERIC ALIAS IS A SILENT WRONG ANSWER.** The sweep
	// records `returns Bytes` before any generic alias is interned, so it stores a bare `named("Bytes")`.
	// Two files each declaring `typealias Bytes = Array with Byte` over a DIFFERENT `Byte` range then hold
	// one name for two element widths, and a return resolved anywhere but its own declaring file hands the
	// caller its OWN homonym — two instances that compare equal over records of different stride.
	//
	// `resolveRecordedGenericAliasTypes` is what spends it, rewriting such a return type to the minted
	// spelling its declaring file means — the same repair that pass already makes for a struct FIELD and a
	// union PAYLOAD, whose header states the rule this column supplies the missing input for: **the scope
	// file is the SLOT's declaring file and never a reader's.** A return type is a slot of the declaring
	// FUNCTION, and it was the one recorded declared type that pass could not reach.
	//
	// ⚠ **ONLY BARE-`named` RETURNS GET AN ENTRY**, `declaredReturnSurfaces`' discipline and its reason: a
	// `returns int` / `returns bool` / already-concrete return carries no name for a reader to re-resolve, so
	// there is nothing a rescope could do with its file. Written and MOVED by `record` and by the three sites
	// that refile a `returnTypes` entry under a new key, so it can never outlive or lag the return type it
	// describes.
	var funcReturnDeclFiles as FuncReturnDeclFileMap

	// ⭐⭐ **EVERY DECLARED FUNCTION'S TIER AND DECLARING FILE, under its registration key.**
	// `SemanticCheck.calleeVisibleFrom` answers the same question for a call in a BODY, off `FunctionNameIndex`;
	// the sweep publishes the two facts here for the askers that index does not serve
	// (`calleeVisibilityFrom`), and both feed them to the very same `isVisibleFrom`: two SOURCES for one
	// declaration, never two RULES.
	//
	// ⚠ Written for every name by `record` — `returnTypes`' discipline rather than `funcReturnDeclFiles`',
	// because "no entry" has to mean "no file declares this name" for the answer to be exact. It is moved by
	// the same three refiles that move a `returnTypes` entry, so it can never lag the declaration it
	// describes.
	var funcDeclSites as FunctionDeclSiteMap

	// ⭐⭐ **THE DECLARATION FILED UNDER EACH REGISTRATION KEY, AS A CALL SITE HAS TO SEE IT.** See
	// `SweptDeclaration` for what it holds.
	//
	// ⚠ It is an array per key and still holds the FIRST declaration only: `record` appends nothing for a
	// second declaration of a key, which is E3006, so `returnTypes`, `funcDeclSites` and this list never
	// describe two declarations at once.
	var sweptDeclarations as SweptDeclarationMap

	// ⭐ **EVERY GENERIC-INSTANCE ALIAS WHOSE ELEMENT WAS SPELLED `__ManagedMemory`** — written by
	// `recordGenericAlias`, read by `aliasElementIsBufferSurface`. See `BufferElementAliasNameSet` for why the
	// key is the alias NAME and can never be the instance.
	var bufferElementAliases as BufferElementAliasNameSet

	// ⭐ The NAMES of every generic-instance typealias whose BASE was SPELLED `__ManagedMemory` —
	// `typealias KeyMemory = __ManagedMemory with Key`. Written by `recordGenericAlias`, read by
	// `aliasDenotesBufferSurface`. The twin of the set above and keyed the same way and for the same reason:
	// `__ManagedMemory with T` and `Array with T` intern to ONE instance, so the id cannot carry the spelling.
	var bufferSurfaceAliases as BufferElementAliasNameSet

	// ⭐⭐ **THE `<Conformer>.<method>` NAMES AN `extension` PUBLISHED, AND THE ONES IT WITHHELD BECAUSE THE
	// CONFORMER DECLARES ITS OWN.** Two sets rather than one because they answer two different halves of
	// one question, and both halves are needed:
	//
	//   • `extensionPublishedMethods` is what tells the CONFORMER'S OWN declaration from an extension's. The
	//     extension fold runs strictly after every type is swept, so "a signature already exists under this
	//     name" is ambiguous without it — it could be the type's, or an earlier extension's. Two extensions
	//     publishing one name stay a genuine E3006, in EITHER fold order, because neither is shadowed.
	//   • `extensionShadowedMethods` is the DECISION, recorded rather than re-derived. `parseExtensionDeclaration`
	//     must emit exactly the bodies `foldExtensionDeclarationInto` published signatures for, and by the time
	//     it runs the first set can no longer answer the question (the fold's own entries are in the index).
	//     One recorded fact, read by both, is the only shape in which they cannot come apart.
	var extensionPublishedMethods as ExtensionMethodNameSet
	var extensionShadowedMethods as ExtensionMethodNameSet

	// Per conformer, interface and associated position, the container arguments an extension body
	// writes over that associated type: a conformer binding it to an interface is E2015 at the binding
	// (`Parser.refuseBindingAnExtensionStoresAsAnArgument`), since no written instance spells the
	// pair.
	var extensionHeldArguments as ExtensionHeldArgumentMap

	var extensionMethodDeclFiles as ExtensionMethodDeclFileMap
	var interfaceExtensionMembers as InterfaceExtensionMemberMap

	// ⭐ Which `<Conformer>.<method>` names a STDLIB file's `extension` published, kept as a set rather than
	// derived from `extensionMethodDeclFiles` because `isStdlibSourceFile` is a memo probe on a `FilePath`
	// key — which clones and lower-cases the path —
	// and this is asked per extension member, where a set on the name needs no path at all.
	var stdlibPublishedExtensionMethods as ExtensionMethodNameSet

	var authorDeclaredNames as HashDigestSet
	var libraryMeantNames as HashDigestSet

	// ⭐ **THE NAMES OF EVERY MANAGED TOP-LEVEL BINDING IN THE PROGRAM** — written
	// once per managed binding by `settleManagedValue`, read once per probe by
	// `Parser.managedTopLevelBaseAt`.
	//
	// It exists because the reader is on a HOT path: `methodCallsAt` runs at every dotted-call shape in
	// the program, and the probe behind it (`declFor`) asks the declaration index and the visibility rule
	// before it knows whether the name is a constant at all.
	//
	// ⚠ **A BOOL IS NOT ENOUGH, AND THE DIFFERENCE IS A WHOLE-PROGRAM CLIFF.** This was first written as
	// `anyManagedConstant as bool`, which spares a program that declares NO managed constant — but the
	// moment ONE exists anywhere, a bool is permanently true and every *static* dotted call in the whole
	// program (`Widget.create(…)`, `String.from(…)` — a base that is neither a local nor a capture) pays
	// the full scoped probe to be told "not a constant". **MEASURED at ~5 allocations per static
	// dotted-call site, linear in call sites** (+390/+710/+1,350/+2,630/+5,190 over a 64→1,024 ladder).
	// A NAME set answers the same question for the same one bool's worth of work in the empty case, and
	// keeps answering it cheaply once the set is non-empty: a base whose spelling matches no managed
	// constant costs ONE hash of bytes it already holds and allocates nothing.
	//
	// It is a FILTER, never the answer: a hit still goes through `constantValueOf`, which is what applies
	// directory scoping and `let`-vs-`var`. So a false positive (this file cannot see that other
	// file's constant) costs one wasted probe and resolves correctly, and there is no second copy of the
	// resolution rule to drift.
	var managedTopLevelNames as ManagedTopLevelNameSet

	// The shape of each closure a top-level initializer's probe lifts, by lifted name. The probe's
	// parse ends with it, and a later parse that reads the closure finds its shape here
	// (`initializerClosureShapeFor`).
	var initializerClosureShapes as FunctionValueShapeMap

	// ⭐⭐ **WHAT EACH CORPUS SLOT'S INITIALIZER CALLS, BY LABEL** — filled by `assignDataLabels`, which is the
	// walk that MINTS the labels, so the key and the slot are created in one act. It exists because those
	// callees are deliberately NOT program roots (`globalInitCallees`) and have to be credited at the READ
	// that keeps the slot alive instead — see `initCalleesOfCorpusSlot`.
	export var corpusSlotInitCallees as SlotInitCalleeMap

	var inlineRecordByTypeNameId = BoolArray.create(0)

	// The `--define`s that could not bind, kept rather than reported: this index is memoized and settled more
	// than once per compile, and a problem belongs to the compile (`Compiler.reportDefineProblems`).
	export var defineProblems = DefineProblemArray.create(0)

	// ⭐ **THE TYPE NAMES TOP-LEVEL INITIALIZERS WRITE** — the one `use` neither export check can get from
	// the real parse, because an initializer parse's artifact is discarded. Written by
	// `recordConstInitializerTypeName` from inside an initializer parse.
	//
	// TWO INDEXES OF ONE FACT, because the two readers ask incompatible questions: the SET answers
	// membership for one file (`Parser.reportUnusedTypeAliases`, E3062, once per unexported typealias
	// declared), and the ordered LOG is what `checkUnusedExports` (E3092) replays, since "did any OTHER
	// file name it?" is a walk and not a probe.
	var constInitializerTypeNames as ConstInitializerTypeNameSet
	var constInitializerTypeSites as NameInFileArray

	// ⭐⭐ **WHICH TYPE NAMES A *USER* FILE DECLARES** — one half of the shadow contest. Filled by
	// `Queries.noteTopLevelTypeDeclaration` for every non-stdlib declaration, and read only while
	// deciding which of a LISTED STDLIB module's declarations a user program has taken the name of.
	// See `StdlibShadowRenameMap`.
	//
	// ⚠ **IT HOLDS EVERY NAME A USER DECLARATION WRITES, INCLUDING THE ILLEGAL ONES, AND THE LEGALITY
	// FILTER LIVES AT THE DECISION INSTEAD.** The set answers two questions and they want
	// opposite treatments of a `__` name: "may a user declaration TAKE this name from the stdlib?" (no — the
	// declaration is E2051) and "is this candidate reserved name already SPOKEN FOR?" (yes — the user wrote
	// it, legally or not). Filtering on the way IN would get the second wrong silently, so the filter is
	// `contestStdlibTypeName`'s, the only reader that wants it.
	var userDeclaredTypeNames as DeclaredTypeNameSet

	// The other half: every type name a LISTED STDLIB module declares, collected by the contest's own token
	// walk (`Queries.contestStdlibDeclarationsAgainstUserNames`) before any name is contested. Read only by
	// `shadowRenameIsTaken` — a mint must not land on a name the stdlib ALREADY declares, which is the third
	// claimant on the reserved space and the one no re-probe of the other two would ever notice.
	var stdlibDeclaredTypeNames as DeclaredTypeNameSet

	// ⭐⭐ **EVERY DECLARATION IN THIS PROGRAM THAT CARRIES THE ARRAY-LITERAL MARKER** — filled from
	// the TOKENS by `Queries.discoverWholeProgramTokenFacts` before the first file is folded, because the
	// fold itself has to know the answer (`Parser.canonicalGenericBaseNameInThisFile`, `isArrayBaseName`).
	// The declared spelling, not the post-contest one: the contest is decided between the two halves of the
	// sweep and this runs ahead of both, so the rename is applied at the READ exactly as it is for the
	// corpus name below.
	//
	// ⚠ **AN ARRAY AND NOT A SET, BECAUSE ITS READERS NEED A STABLE ORDER.** A hash set's iteration order
	// would make the order of what they report a function of the hash rather than of the program. A whole
	// program declares one such type, or two under a contest, so membership is a scan of one or two names —
	// cheaper than the hash it replaces and one representation instead of two.
	var arrayLiteralConformers as NameRoster

	// ⭐⭐ **EVERY `spawn <T>.<member>(…)` THE PROGRAM WRITES** — noted by the whole-program token walk
	// that runs AHEAD of both fold halves (`Queries.discoverWholeProgramTokenFacts`), performed once by
	// `synthesizeServiceCompanions`. It is what makes "is `T` a service?" a whole-program question the parser
	// can ask before the first file is parsed, which it must be: `Calc.handle` is a nameable TYPE in files
	// that write no `spawn` at all.
	//
	// ⚠ **AN ARRAY AND NOT A SET, for `arrayLiteralConformers`' reason one line up**: the perform half
	// registers companions in this order, so the order reaches `structNamesInDeclOrder` and the rolling
	// declaration hash. A hash set's iteration order would make a compiler's own output a function of the
	// hash. Duplicates are dropped at the note — a program spawns one type from many sites — through
	// `serviceSpawnCandidateKeys`, which holds `spawnCandidateKey` of every entry so membership is one lookup.
	var serviceSpawnCandidateList as ServiceSpawnCandidateArray
	var serviceSpawnCandidateKeys as ServiceSpawnCandidateKeyIndex

	// ⭐⭐ **THE `<T>.handle` NAMES THIS SWEEP MINTED** — the exact set, filled by the one act
	// that creates them (`recordServiceHandle`), so `isServiceHandle` answers by MEMBERSHIP rather than by
	// recognising a spelling. A name-shaped test would claim every `X.handle` a future companion scheme might
	// mint, and would answer for one no `spawn` produced.
	//
	// ⚡ A MAP and not a scan of `serviceSpawnCandidateList`, because the reader is
	// `compilerOwnedAggregateOf` — asked for every managed name in every program — and building
	// `<T>.handle` per candidate to compare would allocate a String on a path that answers `false` for every
	// program with no service in it. Empty, it costs one `contains` on an empty table.
	var serviceHandleOwners as ServiceHandleOwnerMap

	var defaultDeclarationList = DefaultDeclarationArray.create(0)

	var serviceMessages = ServiceMessageIndex.create()
	var interfaceHandleOwners = ServiceHandleOwnerMap.create()
	var interfaceHandleRepresentatives = ServiceHandleOwnerMap.create()
	var interfaceHandleOrder = NameRoster.create(0)
	var serviceSendErrorNames = DeclaredTypeNameSet.create()

	// ⭐⭐ **THE NAME A LISTED STDLIB MODULE DECLARES THE RECORD UNDER — the fold target for every
	// `__ManagedMemory` written OUTSIDE a conformer's own body.** `stdlib/Array.maxon:101` gives it today, so
	// this reads `Array` and every emitted per-type symbol keeps the spelling it had.
	//
	// ⚠ **SEEDED WITH `SynthesizedArrayRecordSeed`, AND THAT SEED IS THE COMPILER'S SYNTHESIZED RECORD AND NOT
	// A FALLBACK TO A CONSTANT.** A program compiled against a corpus that declares no
	// `BuiltinArrayLiteral` conformer at all is that program, and it still needs a name for the record it
	// mints. Discovery REPLACES the seed the moment a listed module declares one.
