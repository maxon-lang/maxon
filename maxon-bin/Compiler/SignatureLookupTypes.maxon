	end 'create'

	// A file counts once however many claims it holds, because `tellsApart` discounts the asking
	// file's own entry exactly once.
	function noteNameableFile(file FilePath, namespace String)
		if self.nameableFiles.contains(file) 'alreadyNoted'
			return
		end 'alreadyNoted'

		self.nameableFiles.insert(file)

		let sharing = try self.nameableFilesByNamespace.get(namespace) otherwise 0
		self.nameableFilesByNamespace.upsert(namespace, value: sharing + 1)
	end 'noteNameableFile'

	// `namespace` must be `file`'s own namespace key. True when another nameable file claims the name
	// and none of those others shares that namespace.
	function tellsApart(file FilePath, namespace String) returns bool
