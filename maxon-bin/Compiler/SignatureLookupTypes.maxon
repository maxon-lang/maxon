	function spellingBitsOf(instance GenericInstanceId) returns DeclaredSurfaceNode
		return try self.bitsByInstance.get(instance) otherwise 0 as DeclaredSurfaceNode
	end 'spellingBitsOf'
end 'GenericAliasDeclarationGroup'

