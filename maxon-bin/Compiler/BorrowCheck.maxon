// @generated library-cache end

// A write the parser saw go through a borrow subject. Recorded ONLY while the enclosing function
// already holds at least one completed borrow — a write above every borrow's activation can never
// conflict, so recording one would be work with no question attached.
//
// ⚠ A record `type` rather than the dense scalar columns `CallParamEdges` and `SourceRangeTable`
// insist on, and the gate above is exactly why: those two are built over EVERY call / EVERY op in
// the program, where a heap box per entry is a per-op allocation. This list is empty in every
// function that borrows nothing, which is almost all of them.
export type MutationSite
	export let subject as BorrowSubjectId

	// The name the SOURCE wrote at this write, which is what the diagnostic blames. It may differ
	// from the spelling the borrow used (`items` vs `self.items`) while naming the one subject.
	export let subjectName as ByteArray
	export let token as ElementIndex
	export let line as LineNumber
	export let column as ColumnNumber

	// The `via '<x>'` text: the METHOD name for a container write, the trimmed callee for a free
	// call, `=` for a rebind; for a move, what the value moved into.
	export let display as ByteArray

	// ⭐ **`throughCall` ⇒ THIS SITE IS ONLY A WRITE IF THE CALLEE SAYS SO.** A container method and a
	// rebind are decided by the parser, which holds the whole question; `grow(arr)` is not — whether
	// it writes depends on `grow`'s BODY, possibly in another file. Those sites carry the callee and
	// the argument's column, and `mutationSiteWrites` settles them against the whole-program
	// `ParamMutationSummary` — the SAME summary E3019's call-site half reads, never a second one.
	export let write as MutationSiteWrite

	export static function createContainerWrite(subject BorrowSubjectId, subjectName ByteArray, token ElementIndex, line LineNumber, column ColumnNumber, display ByteArray) returns MutationSite
		return Self{subject: subject, subjectName: subjectName, token: token, line: line, column: column, display: display, write: MutationSiteWrite.settledAtTheParse}
	end 'createContainerWrite'

	export static function createMovedOut(subject BorrowSubjectId, subjectName ByteArray, token ElementIndex, line LineNumber, column ColumnNumber, display ByteArray) returns MutationSite
		return Self{subject: subject, subjectName: subjectName, token: token, line: line, column: column, display: display, write: MutationSiteWrite.movedOut}
	end 'createMovedOut'

	export static function createDroppedAtBlockEnd(subject BorrowSubjectId, subjectName ByteArray, token ElementIndex, line LineNumber, column ColumnNumber) returns MutationSite
		return Self{subject: subject, subjectName: subjectName, token: token, line: line, column: column, display: EmptySourceText, write: MutationSiteWrite.droppedAtBlockEnd}
	end 'createDroppedAtBlockEnd'

	export static function createCallArgWrite(subject BorrowSubjectId, subjectName ByteArray, token ElementIndex, line LineNumber, column ColumnNumber, callee ByteArray, argColumn ParamCount, argLabel ByteArray) returns MutationSite
		return Self{subject: subject, subjectName: subjectName, token: token, line: line, column: column, display: unqualifiedMemberOf(callee), write: MutationSiteWrite.throughCall(callee, argColumn: argColumn, argLabel: argLabel)}
	end 'createCallArgWrite'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.subject as CacheUnsigned)
		writer.bytes(self.subjectName)
		writer.unsigned(self.token as CacheUnsigned)
		writer.unsigned(self.line as CacheUnsigned)
		writer.unsigned(self.column as CacheUnsigned)
		writer.bytes(self.display)
		cacheWriteMutationSiteWrite(writer, value: self.write)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns MutationSite throws LibraryCacheDamage
		let f_subject = (try reader.unsigned()) as BorrowSubjectId
		let f_subjectName = try reader.bytes()
		let f_token = (try reader.unsigned()) as ElementIndex
		let f_line = (try reader.unsigned()) as LineNumber
		let f_column = (try reader.unsigned()) as ColumnNumber
		let f_display = try reader.bytes()
		let f_write = try cacheReadMutationSiteWrite(reader)

		return Self{subject: f_subject, subjectName: f_subjectName, token: f_token, line: f_line, column: f_column, display: f_display, write: f_write}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize56
		return sizeof(MutationSite) as CacheSize56
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'MutationSite'

export typealias MutationSiteArray = Array with MutationSite

