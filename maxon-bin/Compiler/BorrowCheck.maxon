// ⭐⭐⭐ **"THE CALLER'S PARAMETER `p` OWNS THE ARRAY THIS CALL'S RECEIVER DENOTES" — the SECOND edge kind
// the storage column is closed over, and the one without which a retired member's write stops reaching
// the caller.**
//
// `SemanticCheck.collectCallParamEdges` records an edge only for an argument that IS one of the caller's
// own parameters, because that is the whole of what E3019's column needs. E3070's column needs more: a
// write reaches a caller through any array the caller's parameter OWNS, and `self.items` is such an array
// while being a FIELD LOAD rather than a parameter value. While every array mutator was a roster arm the
// gap was invisible — `Parser.noteBorrowSubjectWrite` stamps the enclosing method's bit directly, off a
// `receiverStorage` mask the parser had already derived. A member served from `stdlib/Array.maxon` reaches
// no such door, and nothing carried the fact.
//
// ⛔ **MEASURED — a use-after-free with the suite green over it.** `type Bag`'s `wipe()` whose body
// is `items.truncate(0)`, called while the caller holds `let s = try b.items.get(0) otherwise ""`,
// compiled clean and printed 4557430888798830399 (`__mm_free`'s `0x3F` poison read back as a byte
// length) where 44 is correct. `truncate` is not on `Parser.arraySurfaceMemberNames`, so this was
// live on `main` with no roster strike at all.
// `borrow-liveness.receiver-method-writing-its-own-field-through-a-corpus-member` and
// `.a-free-callee-writing-a-field-of-its-parameter` are the two programs, seen RED before the edge.
//
// ⚠ **STORAGE-ONLY, AND THAT IS THE RULING RATHER THAN A CONSERVATISM.** Feeding this edge into
// `writtenParamMask` would make a caller's `let b` an E3019 for a method writing its own field — the
// answer `specs/self-keyword.md:self-with-params` and
// `parameter-mutation:let-struct-with-array-field-to-mutating-method-ok` both pin the other way. See
// `IrFunction`'s two-mask table, whose first row is exactly this write.
//
// ⚠ **IT SAYS NOTHING ABOUT WHETHER THE CALLEE WRITES** — that is the fixpoint's answer, arrived at
// through this edge, and asking it here would need a summary that does not exist until every file is
// parsed. `borrow-liveness.a-corpus-served-read-only-member-is-not-a-conflict` is the over-rejection
// guard: `items.capacity()` records an edge and no bit ever travels it.
export type StorageReachEdge
	// The callee this receiver was handed to, as the call op spells it.
	export let callee as ByteArray

	// The argument column the RECEIVER fills in the call op's own columns — the index `argSlotPosition`
	// maps to a parameter POSITION of the callee, exactly as `MutationSite.argColumn` is.
	export let argColumn as ParamCount

	// Which of the CALLER's parameters own the storage that receiver denotes (`Parser.subjectStorageMask`).
	export let callerParams as ParamPositionMask

	export static function create(callee ByteArray, argColumn ParamCount, callerParams ParamPositionMask) returns StorageReachEdge
		return Self{callee: callee, argColumn: argColumn, callerParams: callerParams}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.callee)
		writer.unsigned(self.argColumn as CacheUnsigned)
		writer.unsigned(self.callerParams as CacheUnsigned)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns StorageReachEdge throws LibraryCacheDamage
		let f_callee = try reader.bytes()
		let f_argColumn = (try reader.unsigned()) as ParamCount
		let f_callerParams = (try reader.unsigned()) as ParamPositionMask

		return Self{callee: f_callee, argColumn: f_argColumn, callerParams: f_callerParams}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize24
		return sizeof(StorageReachEdge) as CacheSize24
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'StorageReachEdge'

export typealias StorageReachEdgeArray = Array with StorageReachEdge

// @generated library-cache begin
function cacheWriteStorageReachEdgeArray(writer LibraryCacheWriter, value StorageReachEdgeArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteStorageReachEdgeArray'

function cacheReadStorageReachEdgeArray(reader LibraryCacheReader) returns StorageReachEdgeArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = StorageReachEdgeArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try StorageReachEdge.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadStorageReachEdgeArray'

// @generated library-cache end

// ⭐ **THE PER-FUNCTION BORROW FACTS — written by the PARSER, read HERE.** They ride on `IrFunction`
// for the reason `writtenParamMask` does: the parser holds the only view in which a binding exists,
// and the merged module is the only place the whole program does.
//
// ⚠ **EVERY FUNCTION ONE PARSER BUILDS THAT BORROWS NOTHING SHARES ONE OBJECT** (`FunctionPlaceholders.noBorrows`)
// and allocates nothing at all, so every mutation door's `borrows.count() == 0` gate is one read against a
// permanently empty array. It is COPY-ON-WRITE (`Parser.borrowFactsOf`) and the shared instance is NEVER
// mutated. It is the PARSER's and not the module's: a parse runs on a pool worker and its artifact crosses
// back, so a record every parse shared would have owners on every worker at once.
export type BorrowFacts
	// The distinct storages this body borrows from or writes, in first-seen order — the id space
	// `BorrowSubjectId` indexes. Parser working state; the resolver reads only its COUNT, as the key
	// space the borrow buckets are built over.
	export var subjects as VarInfoArray
	export var pending as PendingBorrowArray
	export var borrows as BorrowRecordArray
	export var mutations as MutationSiteArray

	// ⚠ **THE ONE COLUMN HERE THAT IS NOT ABOUT THIS BODY'S OWN BORROWS** — see `StorageReachEdge`. It
	// rides on the same record for the same reason the rest do (the parser holds the only view in which a
	// binding exists) and, unlike them, it is recorded whether or not this body borrows anything: the
	// borrow it protects belongs to a CALLER. It is empty for every function that calls no array member on
	// storage a parameter owns, which is nearly all of them, so the shared-empty gate still pays for itself.
	export var storageReach as StorageReachEdgeArray

	export static function create() returns BorrowFacts
		return Self{subjects: VarInfoArray.create(), pending: PendingBorrowArray.create(), borrows: BorrowRecordArray.create(), mutations: MutationSiteArray.create(), storageReach: StorageReachEdgeArray.create()}
	end 'create'

	export function renumberBindingTypeIds(remap TypeIdRemap, epoch RenumberingEpoch)
		for subject in self.subjects 'eachSubject'
			subject.renumberTypeIds(remap, epoch: epoch)
		end 'eachSubject'

		for borrow in self.borrows 'eachBorrow'
			borrow.borrower.renumberTypeIds(remap, epoch: epoch)
		end 'eachBorrow'
	end 'renumberBindingTypeIds'

	// @generated library-cache begin
	module function cacheWrite(writer LibraryCacheWriter)
		cacheWriteVarInfoArray(writer, value: self.subjects)
		cacheWritePendingBorrowArray(writer, value: self.pending)
		cacheWriteBorrowRecordArray(writer, value: self.borrows)
		cacheWriteMutationSiteArray(writer, value: self.mutations)
		cacheWriteStorageReachEdgeArray(writer, value: self.storageReach)
	end 'cacheWrite'

	module static function cacheRead(reader LibraryCacheReader) returns BorrowFacts throws LibraryCacheDamage
		let f_subjects = try cacheReadVarInfoArray(reader)
		let f_pending = try cacheReadPendingBorrowArray(reader)
		let f_borrows = try cacheReadBorrowRecordArray(reader)
		let f_mutations = try cacheReadMutationSiteArray(reader)
		let f_storageReach = try cacheReadStorageReachEdgeArray(reader)

		return Self{subjects: f_subjects, pending: f_pending, borrows: f_borrows, mutations: f_mutations, storageReach: f_storageReach}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize40
		return sizeof(BorrowFacts) as CacheSize40
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'BorrowFacts'

// The E3070 wire text, in ONE place. `maxoncstderr` blocks pin every word of it.
function borrowConflictMessage(site MutationSite, borrowerName ByteArray, borrowLine LineNumber) returns String
	return match site.write 'write'
		movedOut gives "cannot move '{String.from(site.subjectName)}' into {String.from(site.display)} while it is borrowed by '{String.from(borrowerName)}' (borrowed at line {borrowLine})"
		droppedAtBlockEnd gives "cannot drop '{String.from(site.subjectName)}' at the end of its block while it is borrowed by '{String.from(borrowerName)}' (borrowed at line {borrowLine})"
		settledAtTheParse or
			throughCall gives "cannot mutate '{String.from(site.subjectName)}' via '{String.from(site.display)}' while it is borrowed by '{String.from(borrowerName)}' (borrowed at line {borrowLine})"
	end 'write'
end 'borrowConflictMessage'

// ⭐ **THE ONE RESOLVER.** Every E3070 in the program comes out of `reportFirstLiveBorrow` below, so
// there is exactly one message format and one anchor rule however the write was spelled.
//
// Run from `semanticCheck`, and it must be: the free-call half needs the whole-program
// `ParamMutationSummary`, which does not exist until every file is parsed. It adds no `CompilePhase`
// for that reason too — the timing tables and `docs/optimization-log.md` stay comparable.
export function checkBorrowConflicts(project Project, module MaxonModule, mutationSummary ParamMutationSummary)
	let noSites = ProvenanceSites.create(ProvenanceColumns.create())

	for func in module.functions 'eachFunc'
		checkFunctionBorrowConflicts(project, func: func, mutationSummary: mutationSummary, noSites: noSites)
	end 'eachFunc'
end 'checkBorrowConflicts'

function checkFunctionBorrowConflicts(project Project, func IrFunction, mutationSummary ParamMutationSummary, noSites ProvenanceSites)
	let facts = func.borrowFacts

	if facts.borrows.count() == 0 'borrowsNothing'
		return
	end 'borrowsNothing'

	let loops = func.provenanceSites(noSites).loops
	var liveUntil = TokenIndexArray.create()

	// ⭐ **THE BORROWS, BUCKETED BY SUBJECT — built ONCE per function, never per site.** A site then
	// walks only the borrows of the storage it writes, instead of every borrow in the body. The
	// bucket order is the borrows' own append order, which is activation order, which is what makes
	// "blame the FIRST active borrow" a property of the program rather than of a
	// map's iteration: `multiple-refs-survive-array-growth` blames `'a'`, not `'c'`.
	//
	// Nothing is allocated per site here.
	var subjectKeys = CsrColumn.create()
	var borrowRows = CsrColumn.create()
	var previousActivation = 0

	for i in 0 upto facts.borrows.count() 'eachBorrow'
		let borrow = borrowAt(facts, index: i)

		// ⚠ **THE ORDER THE WALK BELOW IS AMORTIZED ON, CHECKED WHERE IT IS ESTABLISHED.** See
		// `reportFirstLiveBorrow`: it stops at the first not-yet-active borrow instead of walking past it,
		// which is only equivalent because activation is non-decreasing. It is, because every activation is
		// `Parser.attachPendingBorrows`'s `self.pos` and the cursor is monotone through a function body — the
		// same invariant `Parser.requireBindingLive`'s forward-only rule rests on. A parser change that
		// rewound the cursor mid-body would silently STOP REPORTING conflicts, which is a use-after-free
		// nobody would be told about, so it says so here instead.
		if borrow.activationToken < previousActivation 'borrowsOutOfActivationOrder'
			panic("checkFunctionBorrowConflicts: borrow {i} activates at token {borrow.activationToken}, below its predecessor's {previousActivation} — the parse cursor rewound inside a function body and the live-borrow walk's ordering no longer holds")
		end 'borrowsOutOfActivationOrder'

		previousActivation = borrow.activationToken
		liveUntil.push(liveUntilAcrossLoops(borrow.activationToken, lastUse: borrow.borrower.lastUseToken, loops: loops))

		subjectKeys.push(borrow.subject)
		borrowRows.push(i)
	end 'eachBorrow'

	let bySubject = buildCsr(subjectKeys, to: borrowRows, nodeCount: facts.subjects.count() as CsrIndex)

	// ⭐⭐ **THE PER-SUBJECT WALK CURSOR — what makes this pass LINEAR instead of sites × borrows.** A
	// borrow that is DEAD at one site is dead at every LATER site (its last use is fixed once parsing ends,
	// and the sites are visited in token order), so the walk below never has to look at it again: the cursor
	// only ever moves FORWARD, and across the whole function it advances at most once per borrow. The pass
	// is therefore O(borrows + sites) rather than O(sites × borrows-of-that-subject).
	//
	// One entry per subject, so a body that borrows one array pays one word.
	var walked = CsrColumn.create()
	walked.resize(facts.subjects.count())

	var previousSiteToken = 0

	for s in 0 upto facts.mutations.count() 'eachSite'
		let site = try facts.mutations.get(s) otherwise panic("checkFunctionBorrowConflicts: mutations.get OOB at {s}")

		// The other half of the same invariant, and it carries the same consequence — see the borrow loop.
		//
		// ⚠ **BUT NOT THE SAME CAUSE.** A borrow's activation is the parse cursor, so a decrease there
		// means the cursor rewound. A SITE's token is the closing `)` of its argument list
		// (`Parser.containerWriteToken`), which is NOT the order the sites are recorded in: a container
		// write nested inside another's arguments is recorded second and happens FIRST. So this order is
		// a POSTCONDITION of `Parser.pushMutationSiteInTokenOrder`, which restores it at the one push,
		// and a decrease here means that recorder is broken rather than the cursor. MEASURED, with the
		// ordered insert removed: `xs.set(1, value: try ys.pop() otherwise "z")` under a live borrow of
		// `xs` panicked here — site 1 at token 55 below its predecessor's 58.
		if site.token < previousSiteToken 'sitesOutOfTokenOrder'
			panic("checkFunctionBorrowConflicts: mutation site {s} is at token {site.token}, below its predecessor's {previousSiteToken} — `Parser.pushMutationSiteInTokenOrder` did not keep the sites non-decreasing, and the live-borrow walk's cursor no longer holds")
		end 'sitesOutOfTokenOrder'

		previousSiteToken = site.token

		if not mutationSiteWrites(project, site: site, mutationSummary: mutationSummary) 'notAWriteAfterAll'
			continue
		end 'notAWriteAfterAll'

		reportFirstLiveBorrow(project, func: func, facts: facts, liveUntil: liveUntil, bySubject: bySubject, walked: walked, site: site)
	end 'eachSite'
end 'checkFunctionBorrowConflicts'

// Does this recorded site actually WRITE its subject? A container method and a rebind were settled
// by the parser, which held the whole question. A call ARGUMENT was not: it writes iff the callee
// writes the parameter it fills, which is what the whole-program summary answers — and it is
// answered through the SAME `argSlotPosition` bridge `checkImmutableArgToMutatingParam` uses, so
// the source-order column and the declaration-order mask are never bridged twice.
function mutationSiteWrites(project Project, site MutationSite, mutationSummary ParamMutationSummary) returns bool
	return match site.write 'write'
		settledAtTheParse or
			movedOut or
			droppedAtBlockEnd gives true
		throughCall(callee, argColumn, argLabel) gives callWritesArgument(project, callee: callee, argColumn: argColumn, argLabel: argLabel, mutationSummary: mutationSummary)
	end 'write'
end 'mutationSiteWrites'

function callWritesArgument(project Project, callee ByteArray, argColumn ParamCount, argLabel ByteArray, mutationSummary ParamMutationSummary) returns bool
	// ⭐⭐ **THE STORAGE COLUMN, NOT E3019's** — the two ask different questions and the compiler answers them
	// differently (`IrFunction`'s table). `Bag.wipe`'s `maskOf` is 0 by the ruling
	// `self-keyword.md:self-with-params` pins, and reading it here is what let `b.wipe()` free a borrowed
	// element in silence. Its `storageMaskOf` carries the receiver's bit, so the same call is refused.
	//
	// It is the storage column for EVERY call site, argument and receiver alike: E3070's question is always
	// "does the callee write the array I handed it?", and that is the one this column answers.
	//
	// ⚠ **NOT because the storage mask contains the other one — it does not** (`IrFunction`'s table lists
	// four divergences in both directions). `grow(arr)` is unaffected for a concrete reason instead: the
	// ARRAY dispatcher records BOTH masks for a parameter receiver, so a plain mutating callee carries its
	// bit in each. Do not restate this as containment; the `String`/`Set` rows go the other way.
	let mask = mutationSummary.storageMaskOf(callee)

	if mask == NoParamPositions 'writesNoParameter'
		return false
	end 'writesNoParameter'

	// An undeclared callee is E3004 from `validateCall`; there is no signature to slot against and no
	// second diagnostic to add here.
	let sig = try project.funcSignatures.get(callee) otherwise return false
	let pos = try argSlotPosition(sig.paramNames, argIndex: argColumn, label: argLabel) otherwise return false
	return maskHasParam(mask, param: pos)
end 'callWritesArgument'

// Report the FIRST borrow of this site's subject that is already active and not yet dead, and stop —
// one diagnostic per write, naming one borrow. Anchored on the WRITE,
// which is the line:col the `maxoncstderr` blocks pin.
//
// ⭐ `walked` is the per-subject cursor described at its declaration: the count of this subject's
// borrows already proved DEAD, which no later site need look at again. It is advanced here and read
// nowhere else.
function reportFirstLiveBorrow(project Project, func IrFunction, facts BorrowFacts, liveUntil TokenIndexArray, bySubject CsrGraph, walked CsrColumn, site MutationSite)
	let degree = bySubject.degree(site.subject as CsrIndex)
	var k = try walked.get(site.subject) otherwise panic("reportFirstLiveBorrow: walked.get OOB at subject {site.subject}, a key the CSR was built over")

	while k < degree 'eachBorrowOfThisSubject'
		let index = bySubject.neighbour(site.subject as CsrIndex, k: k)
		let borrow = borrowAt(facts, index: index)

		// NOT YET BOUND at this write (a `try` handler's, or anything earlier in the body): the
		// borrowing name does not exist there, so there is nothing to conflict with — and neither is any
		// borrow BEHIND it, because activation is non-decreasing along a bucket (checked where the buckets
		// are built). The cursor is NOT advanced: this borrow becomes live at a later site.
		if borrow.activationToken > site.token 'notBorrowedYet'
			return
		end 'notBorrowedYet'

		// NON-LEXICAL LIFETIMES: the borrow ends at the borrowing binding's LAST USE, stretched across the
		// loops it outlives, not at its scope's end. `lastUseToken` is seeded to the activation, so a binding
		// never read again is dead the instant it is bound — which is what makes `borrow-nll-allowed` compile.
		//
		// ⭐ **AND IT IS DEAD FOR EVERY LATER SITE TOO**, since `lastUseToken` is final once parsing ends and
		// the sites arrive in token order — so the cursor steps over it once and for all. That is the whole
		// of what makes this pass linear.
		if (try liveUntil.get(index) otherwise panic("reportFirstLiveBorrow: liveUntil.get OOB at {index}, a column built over every borrow")) <= site.token 'borrowAlreadyDead'
			k = k + 1
			try walked.set(site.subject, value: k) otherwise panic("reportFirstLiveBorrow: walked.set OOB at subject {site.subject}, the index just read")
			continue
		end 'borrowAlreadyDead'

		reportPositioned(project, code: ErrorCode.semanticBorrowConflict, message: borrowConflictMessage(site, borrowerName: borrow.borrower.name, borrowLine: borrow.borrowLine), line: site.line, column: site.column, filePath: func.sourceFilePath)
		return
	end 'eachBorrowOfThisSubject'
end 'reportFirstLiveBorrow'

// The one indexed read of the borrow column, so the two walks above share its bound message.
function borrowAt(facts BorrowFacts, index CsrIndex) returns BorrowRecord
	return try facts.borrows.get(index) otherwise panic("BorrowCheck: borrows.get OOB at {index} — the subject buckets are built over this very column")
end 'borrowAt'

// The one indexed read of the pending-claim column — `borrowAt`'s twin, and for its reason: four walks
// index this list (`Parser.retargetPendingBorrow`, `.attachPendingBorrows`, and the two halves of the
// composition rule below) and each had spelled its own bound message.
export function pendingAt(facts BorrowFacts, index PendingBorrowCount) returns PendingBorrow
	return try facts.pending.get(index) otherwise panic("BorrowCheck: pending.get OOB at {index} — every walk of this list is bounded by its own count()")
end 'pendingAt'

// ⭐⭐⭐ **THE COMPOSITION RULE: A BORROW OF STORAGE THAT IS ITSELF BORROWED IS A BORROW OF ITS BASE TOO,
// UP TO THE ROOT.** Given the entries `Parser.mintPendingBorrow` has just pushed from `firstPending` on,
// push one more for every storage those subjects are themselves borrowed out of.
//
// ⛔ **MEASURED 0xC0000005 WITHOUT IT**: `let c = try xs.managed.createCursor()`, `let s =
// c.current()`, `xs.clear()`, `print(s)`. `c`'s borrow of `xs` is NLL and dies at `c`'s last use —
// line 4, above the write — while `s`, keyed on `c` alone, names an element still living inside
// `xs`. Neither borrow refused the write and the element was freed under `s`.
// `borrow-liveness.error.a-borrow-taken-out-of-a-borrow-holds-the-root` is that program, seen RED
// first.
//
// ⭐ **IT IS THE ONE HOME OF THE RULE, AND IT IS THE MINT AND NOT THE RESOLVER.** Composing here means a
// composed borrow is an ORDINARY `BorrowRecord` from the instant it exists — same bucket, same activation
// order, same NLL expiry, same diagnostic — so `reportFirstLiveBorrow` needs no second notion of a borrow
// and `a-composed-borrow-expires-at-its-own-last-use` (the over-rejection guard) holds by construction
// rather than by a second rule agreeing with the first. The binding is in hand at the mint and
// there is no liveness pass to re-derive it in, so the chain is walked once, where it is created,
// over a relation the parser already holds.
//
// ⚠ **IT IS A WALK OVER PENDINGS AND NOT A `baseOf` CHAIN, because a binding may borrow MORE THAN ONE
// STORAGE** — `let s = match m 'p' first gives try a.get(0) … second gives try b.get(0) … end 'p'` leaves
// `s` borrowing both (`attachPendingBorrows`'s ⚠ block, which is why that walk runs past its first match).
// A single-successor `baseOf` would silently drop one of the two arms, waving through a write to it.
//
// ⚠ **A FUNCTION THAT HOLDS NO BORROW PAYS ONE COMPARISON.** `facts.borrows` is empty in almost every body,
// so the inner walk does nothing and the outer loop runs exactly once over the entry just pushed — the same
// reading `functionHoldsABorrow`'s gate states, at the one door that cannot be gated on it (a mint happens
// precisely when no borrow exists yet).
export function composePendingBorrowOntoBases(facts BorrowFacts, firstPending PendingBorrowCount, borrowValue ValueId, range SourceRange)
	var scan = firstPending

	while scan < facts.pending.count() as PendingBorrowCount 'eachLinkOfTheChain'
		let borrowedSubject = pendingAt(facts, index: scan).subject

		for k in 0 upto facts.borrows.count() 'eachBorrowOfThisBody'
			let base = borrowAt(facts, index: k)

			// Object identity, the key `borrowSubjectIdOf` mints its ids under: this is "is the storage that
			// element came out of the SAME BINDING some earlier borrow named as its borrower?". Read on every
			// trip, because the push below writes `facts` and a read held across it would be a live borrow.
			if not (base.borrower is (try facts.subjects.get(borrowedSubject) otherwise panic("composePendingBorrowOntoBases: subjects.get OOB at the subject of pending {scan} — a subject id is minted by `Parser.borrowSubjectIdOf` against this very column"))) 'someOtherBorrower'
				continue
			end 'someOtherBorrower'

			// Already on this chain. The test is what makes the walk terminate at all — a `var` rebound to
			// something borrowed out of its own borrower is a CYCLE in this relation, and without it the loop
			// would push for ever. It also keeps one base from being pushed twice when two links share it.
			if pendingCarriesSubject(facts, from: firstPending, subject: base.subject) 'alreadyOnTheChain'
				continue
			end 'alreadyOnTheChain'

			// The BORROW LINE stays the reading's own — the element the user is about to hold was read HERE,
			// and `borrowed at line N` must send them to the line they wrote, never to the base's own mint.
			facts.pending.push(PendingBorrow.create(base.subject, borrowValue: borrowValue, borrowLine: range.line))
		end 'eachBorrowOfThisBody'

		scan = scan + 1
	end 'eachLinkOfTheChain'
end 'composePendingBorrowOntoBases'

// ⭐ **THE STORAGE THE PENDING BORROW AT `index` NAMES, or `none` when that entry is not a borrow of
// `value`** — the test that says an element accessor's result is being consumed by something no BINDING
// will claim, which at a call argument means the callee is handed a pointer into a container nothing in
// this frame is keeping alive (`Parser.borrowedArgumentIsAtRisk`).
//
// It is asked of the PENDING list rather than of `borrows`, and that is the whole distinction: a borrow a
// name took is a `BorrowRecord` and E3070 already reports the writes under it; one still pending when the
// value reaches a call has no borrower to blame and no diagnostic to raise — it is dropped unclaimed when
// the statement ends (`Parser.dropUnclaimedPendingBorrows`).
//
// ⚠⚠ **IT ANSWERS FOR ONE ENTRY AND NOT FOR THE VALUE, ON PURPOSE: SEVERAL ENTRIES CARRY ONE VALUE.** A
// composed borrow files one per link of the chain (`composePendingBorrowOntoBases`) and a `match` merge
// retargets every arm onto one phi, all keyed on the same id — which is exactly why
// `Parser.retargetPendingBorrow` and `attachPendingBorrows` both run past their first match, and why a
// by-value spelling of this function would let its caller stop at whichever link push order happened to put
// first. The caller walks the whole list; this answers the one question it cannot ask itself.
//
// An empty answer is unambiguous: a subject is minted only from a NON-EMPTY storage name
// (`Parser.borrowSubjectNameAt` gates on it), so no live subject can be named by the empty string.
//
// ⚠ A function that borrowed nothing never enters the caller's loop at all — `pending.count()` is 0 — which
// is the same reading every other gate over this list states, and the reason it can sit on the argument path.
export function pendingBorrowStorageOf(facts BorrowFacts, index PendingBorrowCount, value ValueId) returns BorrowSubject
	let pending = pendingAt(facts, index: index)

	if pending.borrowValue != value 'someOtherValue'
		return BorrowSubject.none
	end 'someOtherValue'

	return BorrowSubject.storage((try facts.subjects.get(pending.subject) otherwise panic("pendingBorrowStorageOf: subjects.get OOB at {pending.subject} — every pending borrow's subject is minted against this very column")).name)
end 'pendingBorrowStorageOf'

export function borrowSubjectIdIfRecorded(facts BorrowFacts, binding VarInfo) returns BorrowSubjectId throws MapError
	for k in 0 upto facts.subjects.count() 'eachSubject'
		if (try facts.subjects.get(k) otherwise panic("borrowSubjectIdIfRecorded: subjects.get OOB at {k} inside count()")) is binding 'thisBinding'
			return k
		end 'thisBinding'
	end 'eachSubject'

	throw MapError.keyNotFound
end 'borrowSubjectIdIfRecorded'

export function carryBorrowsOnto(facts BorrowFacts, source BorrowSubjectId, target BorrowSubjectId, activation ElementIndex)
	let held = facts.borrows.count()

	for k in 0 upto held 'eachBorrowHeldBeforeTheMove'
		let borrow = borrowAt(facts, index: k)

		if borrow.subject == source 'aBorrowOfTheMovedRecord'
			facts.borrows.push(BorrowRecord.create(target, borrower: borrow.borrower, activationToken: activation, borrowLine: borrow.borrowLine))
		end 'aBorrowOfTheMovedRecord'
	end 'eachBorrowHeldBeforeTheMove'
end 'carryBorrowsOnto'

// Does the chain built from `from` on already name `subject`? See the ⚠ block above — this is the
// termination condition, not a tidiness check.
function pendingCarriesSubject(facts BorrowFacts, from PendingBorrowCount, subject BorrowSubjectId) returns bool
	for k in from upto facts.pending.count() as PendingBorrowCount 'eachLinkSoFar'
		if pendingAt(facts, index: k).subject == subject 'alreadyNamed'
			return true
		end 'alreadyNamed'
	end 'eachLinkSoFar'

	return false
end 'pendingCarriesSubject'
