// CompileMemory — allocation attribution for the WHOLE compile pipeline. The twin of
// CompileTimings, phase for phase, and it exists for a reason that file cannot serve.
//
// WHY MEMORY AND NOT JUST TIME. A quadratic in ALLOCATIONS is what actually kills a
// self-compile, and it is invisible to a clock until it is fatal.
//
// AND WHY MEMORY IS THE STRONGER SIGNAL. Wall time is not reproducible: the same compile
// on the same machine varies by several percent between runs, so nothing about it is worth
// stating more precisely than a growth exponent. Allocation counts and byte volumes ARE
// reproducible — bit for bit, on an idle machine or a loaded one, because the counters
// behind them only rise and are order-independent (see PhaseProbe's `CounterSource`, and
// `SlabRuntime`'s traffic columns for why they are exact rather than approximate). So a
// per-rung memory number that MOVED, moved for a reason, every time — which is what makes
// it the one column of the scale instrument's trend log worth explaining line by line.
// That is the whole reason the scale suite leans on this table.
//
// THE DISJOINTNESS CONTRACT IS THE SAME, and here it is even sharper. CompileTimings
// panics when its phases sum to MORE than the whole compile, because phases are disjoint
// sub-intervals and a sum that exceeds the total means two brackets double-count. The
// same holds here, and the reconciliation is STRICTER than the clock's: a delta of a
// monotonic counter over a set of disjoint intervals sums to at most the counter's delta
// over their union, with no measurement error in the way. Where the clock's `unattributed`
// row absorbs a few microseconds of scheduling noise, this one's absorbs only real,
// unbracketed allocation.
//
// Phases are bracketed by PhaseProbe, jointly with the clock, so a phase cannot be timed
// at one boundary and metered at another. See PhaseProbe's header.

// Column widths for the report table. Its own set: the memory table has four numeric
// columns to the timing table's two, and its numbers are counts and byte volumes rather
// than milliseconds. The widths differ; how a cell is PADDED and how a rule is DRAWN do not, so
// `padRight`/`padLeft`/`horizontalRule` are CompileTimings' and shared.
let MemPhaseNameWidth = 22 as ColumnWidth
let MemAllocsWidth = 12 as ColumnWidth
let MemFreesWidth = 12 as ColumnWidth
let MemBytesWidth = 14 as ColumnWidth
let MemRuleWidth = (MemPhaseNameWidth + MemAllocsWidth + MemFreesWidth + MemBytesWidth) as ColumnWidth

let ResidencyRuleWidth = (MemPhaseNameWidth + 5 * MemBytesWidth) as ColumnWidth

let MemRowIndent = "  "
let MemSubPhaseIndent = "    "

// One phase's memory, in the three quantities the gate rests on. A dense column per
// quantity, indexed by the phase enum's ordinal — the same shape as CompileTimings'
// `phaseNanos` and RegAllocStats' `phaseNanos`, so a new CompilePhase extends all of them
// identically and none can silently fall behind.
export type PhaseMemoryColumns
	export var allocs as AllocCountArray
	export var frees as AllocCountArray
	export var bytes as ByteCountArray

	export static function create(phaseCount PhaseIndex) returns PhaseMemoryColumns
		var allocs = AllocCountArray.create()
		var frees = AllocCountArray.create()
		var bytes = ByteCountArray.create()
		allocs.resize(phaseCount)
		frees.resize(phaseCount)
		bytes.resize(phaseCount)
		return Self{allocs: allocs, frees: frees, bytes: bytes}
	end 'create'

	// The index, not the phase's NAME. `phase.name` builds a String, and a parameter is
	// evaluated EAGERLY — so naming the phase here cost one heap String per phase record,
	// on every compile, purely to decorate a panic that cannot fire (the columns are
	// resized to the enum's own case count and indexed by its `ordinal`). The instrument
	// was polluting the very number it exists to report. CompileTimings never had the bug:
	// it interpolates `{phase.name}` INSIDE the panic string, where it stays lazy.
	//
	// The index and the column width are what actually diagnose the violation anyway — a
	// column that was not sized to its enum.
	export function add(index PhaseIndex, delta PhaseDelta)
		let curAllocs = try self.allocs.get(index) otherwise panic("PhaseMemoryColumns.add: phase index {index} OOB — the columns hold {self.allocs.count()}, so they were not sized to their phase enum")
		try self.allocs.set(index, value: curAllocs + delta.allocs) otherwise panic("PhaseMemoryColumns.add: allocs.set({index}) failed at an index allocs.get just accepted")

		let curFrees = try self.frees.get(index) otherwise panic("PhaseMemoryColumns.add: phase index {index} OOB in the frees column")
		try self.frees.set(index, value: curFrees + delta.frees) otherwise panic("PhaseMemoryColumns.add: frees.set({index}) failed at an index frees.get just accepted")

		let curBytes = try self.bytes.get(index) otherwise panic("PhaseMemoryColumns.add: phase index {index} OOB in the bytes column")
		try self.bytes.set(index, value: curBytes + delta.bytes) otherwise panic("PhaseMemoryColumns.add: bytes.set({index}) failed at an index bytes.get just accepted")
	end 'add'

	export function allocsAt(index PhaseIndex) returns AllocCount
		return try self.allocs.get(index) otherwise panic("PhaseMemoryColumns.allocsAt: phase index {index} OOB — the allocs column holds {self.allocs.count()}, so it was not sized to its phase enum")
	end 'allocsAt'

	export function freesAt(index PhaseIndex) returns AllocCount
		return try self.frees.get(index) otherwise panic("PhaseMemoryColumns.freesAt: phase index {index} OOB — the frees column holds {self.frees.count()}, so it was not sized to its phase enum")
	end 'freesAt'

	export function bytesAt(index PhaseIndex) returns HeapByteCount
		return try self.bytes.get(index) otherwise panic("PhaseMemoryColumns.bytesAt: phase index {index} OOB — the bytes column holds {self.bytes.count()}, so it was not sized to its phase enum")
	end 'bytesAt'

	// What the instrumentation actually claimed, summed over every phase.
	export function totalDelta() returns PhaseDelta
		var sum = PhaseDelta.zero()

		for index in 0 upto self.allocs.count() 'eachPhase'
			sum = deltaSum(sum, other: self.deltaAt(index as PhaseIndex))
		end 'eachPhase'

		return sum
	end 'totalDelta'

	// The same sum over the phases `selected` flags — one half of the table, for a table whose other half
	// is a breakdown of a row already in it (`CompileTimings.poolRowMask`).
	export function totalDeltaWhere(selected BoolArray, wanted bool) returns PhaseDelta
		var sum = PhaseDelta.zero()

		for index in 0 upto self.allocs.count() 'eachPhase'
			let flagged = try selected.get(index) otherwise panic("PhaseMemoryColumns.totalDeltaWhere: the selection holds {selected.count()} flags against {self.allocs.count()} phases — both are sized to the phase enum")

			if flagged == wanted 'counted'
				sum = deltaSum(sum, other: self.deltaAt(index as PhaseIndex))
			end 'counted'
		end 'eachPhase'

		return sum
	end 'totalDeltaWhere'

	function deltaAt(index PhaseIndex) returns PhaseDelta
		return PhaseDelta.create(0, cpuTicks: 0, allocs: self.allocsAt(index), frees: self.freesAt(index), bytes: self.bytesAt(index))
	end 'deltaAt'
end 'PhaseMemoryColumns'

// The three memory quantities of `a` and `b` added — a delta of monotonic counters over two intervals.
function deltaSum(a PhaseDelta, other PhaseDelta) returns PhaseDelta
	return PhaseDelta.create(0, cpuTicks: 0, allocs: a.allocs + other.allocs, frees: a.frees + other.frees, bytes: a.bytes + other.bytes)
end 'deltaSum'

// Index into a dense per-phase column. Bounded by the enums it indexes, both of which are
// a couple of dozen arms.
typealias PhaseIndex = int(0 to 1024)

typealias ColumnCell = int(0 to u64.max)
typealias PhaseColumnArray = Array with ColumnCell

// The allocator's own sub-phase memory, nested under the `regalloc` phase exactly as
// RegAllocStats' timers nest under it. A breakdown OF that phase's allocations, never
// six additional phases — adding them to the phase they live inside is the double-count
// this file's header exists to prevent.
export type RegAllocMemory
	export var columns as PhaseMemoryColumns

	export static function create() returns RegAllocMemory
		return Self{columns: PhaseMemoryColumns.create(RegAllocPhase.allCases.count())}
	end 'create'

	export function addPhase(phase RegAllocPhase, delta PhaseDelta)
		self.columns.add(phase.ordinal, delta: delta)
	end 'addPhase'

	export function allocsOf(phase RegAllocPhase) returns AllocCount
		return self.columns.allocsAt(phase.ordinal)
	end 'allocsOf'

	export function freesOf(phase RegAllocPhase) returns AllocCount
		return self.columns.freesAt(phase.ordinal)
	end 'freesOf'

	export function bytesOf(phase RegAllocPhase) returns HeapByteCount
		return self.columns.bytesAt(phase.ordinal)
	end 'bytesOf'

	export function deltaOf(phase RegAllocPhase) returns PhaseDelta
		return PhaseDelta.create(0, cpuTicks: 0, allocs: self.allocsOf(phase), frees: self.freesOf(phase), bytes: self.bytesOf(phase))
	end 'deltaOf'
end 'RegAllocMemory'

// What the heap holds at one instant, which the three columns above structurally cannot report: they are
// deltas of counters that only rise, so a phase that allocates a gigabyte and frees it moves them exactly
// as far as one that keeps it. `free - cachedFree` is what no processor can reach and
// `committed - (live + free)` is the allocator's own overhead, which is what makes this a diagnosis rather
// than a number. `SlabRuntime.SlabLiveBytesName` owns what each figure counts.
export type PhaseResidency
	export var liveBytes as HeapByteCount
	export var freeBytes as HeapByteCount
	export var cachedFreeBytes as HeapByteCount
	export var parkedBytes as HeapByteCount
	export var committedBytes as HeapByteCount

	export static function zero() returns PhaseResidency
		return Self{liveBytes: 0, freeBytes: 0, cachedFreeBytes: 0, parkedBytes: 0, committedBytes: 0}
	end 'zero'

	export static function create(liveBytes HeapByteCount, freeBytes HeapByteCount, cachedFreeBytes HeapByteCount, parkedBytes HeapByteCount, committedBytes HeapByteCount) returns PhaseResidency
		return Self{liveBytes: liveBytes, freeBytes: freeBytes, cachedFreeBytes: cachedFreeBytes, parkedBytes: parkedBytes, committedBytes: committedBytes}
	end 'create'

	// Five separate walks rather than one: a shared record would have to live between the calls, which is
	// state a second thread could read half-written.
	export static function sample() returns PhaseResidency
		return Self{
			liveBytes: __Builtins.slabLiveBytes() as HeapByteCount,
			freeBytes: __Builtins.slabFreeBytes() as HeapByteCount,
			cachedFreeBytes: __Builtins.slabCachedFreeBytes() as HeapByteCount,
			parkedBytes: __Builtins.slabParkedBytes() as HeapByteCount,
			committedBytes: __Builtins.slabCommittedBytes() as HeapByteCount
		}
	end 'sample'
end 'PhaseResidency'

// Indexed by the phase enum's ordinal, the dense shape `PhaseMemoryColumns` has, so a new `CompilePhase`
// extends both identically.
//
// ⚠ A phase that ran twice keeps its highest reading, not its last. These are levels rather than deltas,
// so they cannot be summed.
export type PhaseResidencyColumns
	export var live as PhaseColumnArray
	export var free as PhaseColumnArray
	export var cachedFree as PhaseColumnArray
	export var parked as PhaseColumnArray
	export var committed as PhaseColumnArray

	export static function create(phaseCount PhaseIndex) returns PhaseResidencyColumns
		return Self{
			live: phaseColumn(phaseCount as ColumnLength),
			free: phaseColumn(phaseCount as ColumnLength),
			cachedFree: phaseColumn(phaseCount as ColumnLength),
			parked: phaseColumn(phaseCount as ColumnLength),
			committed: phaseColumn(phaseCount as ColumnLength)
		}
	end 'create'

	export function raiseTo(index PhaseIndex, reading PhaseResidency)
		let slot = index as ColumnSlot

		raiseColumn(self.live, index: slot, value: reading.liveBytes as ColumnCell)
		raiseColumn(self.free, index: slot, value: reading.freeBytes as ColumnCell)
		raiseColumn(self.cachedFree, index: slot, value: reading.cachedFreeBytes as ColumnCell)
		raiseColumn(self.parked, index: slot, value: reading.parkedBytes as ColumnCell)
		raiseColumn(self.committed, index: slot, value: reading.committedBytes as ColumnCell)
	end 'raiseTo'

	export function at(index PhaseIndex) returns PhaseResidency
		let slot = index as ColumnSlot

		return PhaseResidency.create(readColumn(self.live, index: slot) as HeapByteCount, freeBytes: readColumn(self.free, index: slot) as HeapByteCount, cachedFreeBytes: readColumn(self.cachedFree, index: slot) as HeapByteCount, parkedBytes: readColumn(self.parked, index: slot) as HeapByteCount, committedBytes: readColumn(self.committed, index: slot) as HeapByteCount)
	end 'at'
end 'PhaseResidencyColumns'

function phaseColumn(cells ColumnLength) returns PhaseColumnArray
	var column = PhaseColumnArray.create()
	column.resize(cells)
	return column
end 'phaseColumn'

function raiseColumn(column PhaseColumnArray, index ColumnSlot, value ColumnCell)
	if value > readColumn(column, index: index) 'higher'
		writeColumn(column, index: index, value: value)
	end 'higher'
end 'raiseColumn'

function readColumn(column PhaseColumnArray, index ColumnSlot) returns ColumnCell
	return try column.get(index) otherwise panic("a per-phase column was read at slot {index} and holds {column.count()} — it was not sized to its phase enum")
end 'readColumn'

function writeColumn(column PhaseColumnArray, index ColumnSlot, value ColumnCell)
	try column.set(index, value: value) otherwise panic("a per-phase column was written at slot {index} and holds {column.count()} — it was not sized to its phase enum")
end 'writeColumn'

let TagCensusTopRows = 5
let TagCensusTopSeparator = ", "
let TagCensusUnattributableLabel = "(unattributable)"
let TagCensusOverflowLabel = "(overflow)"

let TagLabelWidth = 34 as ColumnWidth
let TagCensusRuleWidth = (TagLabelWidth + MemAllocsWidth + MemBytesWidth) as ColumnWidth

typealias TagBucketIndex = int(0 to 2047)
typealias TagCensusMode = int(0 to 1)
typealias TagRowCount = int(0 to 5)
typealias ColumnSlot = int(0 to 2099199)
typealias ColumnLength = int(0 to 2099200)

let TagBucketIndexCeiling = 2048
let TagRowCountCeiling = 5
let ColumnSlotCeiling = 2099200

// A typealias bound may not name a constant (E2010), so the ranges above are written out and checked
// here instead. Without this a bucket count the tier raised would be a range panic at the first sampling
// rather than a refusal.
function requireTagCensusRangesCoverTheTable(phaseCount PhaseIndex)
	if TagBucketIndexCeiling != SlabCensusTagBuckets 'bucketRangeDrifted'
		panic("CompileMemory: `TagBucketIndex` is `int(0 to {TagBucketIndexCeiling - 1})` and the tier's bucket count is {SlabCensusTagBuckets} — the typealias no longer covers a bucket")
	end 'bucketRangeDrifted'

	if TagRowCountCeiling != TagCensusTopRows 'topRowRangeDrifted'
		panic("CompileMemory: `TagRowCount` is `int(0 to {TagRowCountCeiling})` and the line shows {TagCensusTopRows} rows — the typealias no longer covers what `tagCensusTopLine` counts")
	end 'topRowRangeDrifted'

	if (phaseCount as ColumnLength) * (SlabCensusTagBuckets as ColumnLength) > ColumnSlotCeiling 'slotRangeDrifted'
		panic("CompileMemory: `ColumnLength` is `int(0 to {ColumnSlotCeiling})` and {phaseCount} phases of {SlabCensusTagBuckets} buckets need {phaseCount * SlabCensusTagBuckets} cells")
	end 'slotRangeDrifted'
end 'requireTagCensusRangesCoverTheTable'

function tagCensusSlotOf(index PhaseIndex, bucket TagBucketIndex) returns ColumnSlot
	return ((index as ColumnSlot) * (SlabCensusTagBuckets as ColumnSlot) + (bucket as ColumnSlot)) as ColumnSlot
end 'tagCensusSlotOf'

export union TagCensusPhases
	everyPhase
	only(phase CompilePhase)
end 'TagCensusPhases'

function tagCensusModeForThisBuild() returns TagCensusMode
	#if debugstream(true)
		return SlabCensusTagMode
	#else
		return SlabCensusClassMode
	#endif
end 'tagCensusModeForThisBuild'

export type PhaseTagCensus
	export var counts as PhaseColumnArray
	export var bytes as PhaseColumnArray
	export var tallyBytes as HeapByteCount
	export var liveBytes as HeapByteCount
	export var rawLiveSlots as AllocCount

	export static function empty() returns PhaseTagCensus
		return Self{counts: PhaseColumnArray.create(), bytes: PhaseColumnArray.create(), tallyBytes: 0, liveBytes: 0, rawLiveSlots: 0}
	end 'empty'

	export static function sized() returns PhaseTagCensus
		return Self{counts: phaseColumn(SlabCensusTagBuckets), bytes: phaseColumn(SlabCensusTagBuckets), tallyBytes: 0, liveBytes: 0, rawLiveSlots: 0}
	end 'sized'

	// Allocates nothing — `sized()` gave the columns their full width — because a sampling that grew an
	// array would enter the very heap it is reading. The level is taken on the statement after the tally
	// so the self-check compares two derivations of ONE instant.
	export function take()
		self.tallyBytes = __Builtins.slabCensusTally(tagCensusModeForThisBuild()) as HeapByteCount
		self.liveBytes = __Builtins.slabLiveBytes() as HeapByteCount

		for bucket in 0 upto SlabCensusTagBuckets 'eachBucket'
			writeColumn(self.counts, index: bucket as ColumnSlot, value: __Builtins.slabCensusBucketCount(bucket) as ColumnCell)
			writeColumn(self.bytes, index: bucket as ColumnSlot, value: __Builtins.slabCensusBucketBytes(bucket) as ColumnCell)
		end 'eachBucket'

		self.rawLiveSlots = __Builtins.mmRawAllocLive() as AllocCount
	end 'take'
end 'PhaseTagCensus'

export type PhaseTagCensusColumns
	export var enabled as bool
	export var mode as TagCensusMode
	export var counts as PhaseColumnArray
	export var bytes as PhaseColumnArray
	export var liveBytes as PhaseColumnArray
	export var rawLiveSlots as PhaseColumnArray
	export var tallyBytes as PhaseColumnArray
	export var sampled as BoolArray
	export var scratch as PhaseTagCensus
	export var names as StringArray

	export static function off() returns PhaseTagCensusColumns
		return Self{enabled: false, mode: SlabCensusClassMode, counts: PhaseColumnArray.create(), bytes: PhaseColumnArray.create(), liveBytes: PhaseColumnArray.create(), rawLiveSlots: PhaseColumnArray.create(), tallyBytes: PhaseColumnArray.create(), sampled: BoolArray.create(), scratch: PhaseTagCensus.empty(), names: StringArray.create()}
	end 'off'

	export function enable(phaseCount PhaseIndex, tallyMode TagCensusMode)
		requireTagCensusRangesCoverTheTable(phaseCount)

		self.enabled = true
		self.mode = tallyMode
		self.counts = phaseColumn((phaseCount * SlabCensusTagBuckets) as ColumnLength)
		self.bytes = phaseColumn((phaseCount * SlabCensusTagBuckets) as ColumnLength)
		self.liveBytes = phaseColumn(phaseCount as ColumnLength)
		self.rawLiveSlots = phaseColumn(phaseCount as ColumnLength)
		self.tallyBytes = phaseColumn(phaseCount as ColumnLength)
		self.sampled.resize(phaseCount)
		self.scratch = PhaseTagCensus.sized()
		self.names = tagCensusNames(tallyMode)
	end 'enable'

	export function takeAt(index PhaseIndex)
		self.scratch.take()
		self.keepIfHighest(index, reading: self.scratch)
	end 'takeAt'

	// ⚠ A phase that ran twice keeps ONE whole sampling — the one with the highest live level — and never
	// a per-bucket maximum. Maxima taken bucket by bucket come from different samplings and sum to a
	// figure no instant of the heap ever held, which the report's own self-check would then report as a
	// disagreement it cannot explain.
	function keepIfHighest(index PhaseIndex, reading PhaseTagCensus)
		if self.sampledAt(index) and reading.liveBytes <= self.liveBytesAt(index) 'notTheHighest'
			return
		end 'notTheHighest'

		for bucket in 0 upto SlabCensusTagBuckets 'eachBucket'
			let slot = tagCensusSlotOf(index, bucket: bucket)
			writeColumn(self.bytes, index: slot, value: readColumn(reading.bytes, index: bucket as ColumnSlot))
			writeColumn(self.counts, index: slot, value: readColumn(reading.counts, index: bucket as ColumnSlot))
		end 'eachBucket'

		writeColumn(self.liveBytes, index: index as ColumnSlot, value: reading.liveBytes as ColumnCell)
		writeColumn(self.rawLiveSlots, index: index as ColumnSlot, value: reading.rawLiveSlots as ColumnCell)
		writeColumn(self.tallyBytes, index: index as ColumnSlot, value: reading.tallyBytes as ColumnCell)
		try self.sampled.set(index, value: true) otherwise panic("PhaseTagCensusColumns.keepIfHighest: the sampled column holds {self.sampled.count()} flags, so it was not sized to its phase enum")
	end 'keepIfHighest'

	export function countAt(index PhaseIndex, bucket TagBucketIndex) returns AllocCount
		return readColumn(self.counts, index: tagCensusSlotOf(index, bucket: bucket)) as AllocCount
	end 'countAt'

	export function bytesAt(index PhaseIndex, bucket TagBucketIndex) returns HeapByteCount
		return readColumn(self.bytes, index: tagCensusSlotOf(index, bucket: bucket)) as HeapByteCount
	end 'bytesAt'

	export function liveBytesAt(index PhaseIndex) returns HeapByteCount
		return readColumn(self.liveBytes, index: index as ColumnSlot) as HeapByteCount
	end 'liveBytesAt'

	export function rawLiveSlotsAt(index PhaseIndex) returns AllocCount
		return readColumn(self.rawLiveSlots, index: index as ColumnSlot) as AllocCount
	end 'rawLiveSlotsAt'

	export function tallyBytesAt(index PhaseIndex) returns HeapByteCount
		return readColumn(self.tallyBytes, index: index as ColumnSlot) as HeapByteCount
	end 'tallyBytesAt'

	export function sampledAt(index PhaseIndex) returns bool
		return try self.sampled.get(index) otherwise panic("PhaseTagCensusColumns.sampledAt: phase index {index} OOB — the column holds {self.sampled.count()}")
	end 'sampledAt'
end 'PhaseTagCensusColumns'

// Per-compile memory attribution, owned by `Project` beside `timings` — for the same
// reason: Project is already threaded through every phase, so no pass needs a new
// parameter merely to be metered, and each compile gets its own table instead of the
// per-file fan-out driver contending on a global.
export type CompileMemory
	export var columns as PhaseMemoryColumns

	// Zero unless `Project.samplesResidency`.
	export var residency as PhaseResidencyColumns

	export var tagCensus as PhaseTagCensusColumns

	// The whole compile's memory, stamped once by `compile` — the denominator every
	// phase's share is taken against, and the total the phases must reconcile to. Zero
	// until then: the warm-rebuild gate drives `compileToCodeResult` directly and never
	// reports, so a zero total means "not a reported build", not "an allocation-free one".
	export var total as PhaseDelta
	export var regAlloc as RegAllocMemory

	export static function create() returns CompileMemory
		return Self{
			columns: PhaseMemoryColumns.create(CompilePhase.allCases.count()),
			residency: PhaseResidencyColumns.create(CompilePhase.allCases.count()),
			tagCensus: PhaseTagCensusColumns.off(),
			total: PhaseDelta.zero(),
			regAlloc: RegAllocMemory.create()
		}
	end 'create'

	export function addPhase(phase CompilePhase, delta PhaseDelta)
		self.columns.add(phase.ordinal, delta: delta)
	end 'addPhase'

	export function recordResidency(phase CompilePhase, reading PhaseResidency)
		self.residency.raiseTo(phase.ordinal, reading: reading)
	end 'recordResidency'

	export function residencyOf(phase CompilePhase) returns PhaseResidency
		return self.residency.at(phase.ordinal)
	end 'residencyOf'

	export function enableTagCensus()
		self.tagCensus.enable(CompilePhase.allCases.count(), tallyMode: tagCensusModeForThisBuild())
	end 'enableTagCensus'

	export function recordTagCensus(phase CompilePhase)
		self.tagCensus.takeAt(phase.ordinal)
	end 'recordTagCensus'

	export function deltaOf(phase CompilePhase) returns PhaseDelta
		let allocs = self.columns.allocsAt(phase.ordinal)
		let frees = self.columns.freesAt(phase.ordinal)
		return PhaseDelta.create(0, cpuTicks: 0, allocs: allocs, frees: frees, bytes: self.columns.bytesAt(phase.ordinal))
	end 'deltaOf'

	// What the DISJOINT phases claimed between them. `poolRows` is the timing table's mask
	// (`CompileTimings.poolRowMask`): a phase folded from pool workers is a breakdown of the driver phase
	// the pool ran inside, whose row is already in this sum.
	export function attributed(poolRows BoolArray) returns PhaseDelta
		return self.columns.totalDeltaWhere(poolRows, wanted: false)
	end 'attributed'

	// Allocations no phase claimed: the glue between phases (project construction, output
	// path resolution, the query spine's own cache/hash bookkeeping). Visible as its own
	// row, so a growing gap shows up instead of hiding inside a neighbour.
	//
	// Phases are disjoint intervals, and these are deltas of MONOTONIC counters, so their
	// sum can never exceed the whole compile's. If it does, two probes overlap and are
	// double-counting — the exact failure this file's header describes, so it panics
	// rather than clamp to zero.
	export function unattributed(poolRows BoolArray) returns PhaseDelta
		let claimed = self.attributed(poolRows)

		if claimed.allocs > self.total.allocs 'overlapAllocs'
			panic("CompileMemory: the phases claim {claimed.allocs} allocations but the whole compile made {self.total.allocs} — two phase probes OVERLAP and are double-counting. Phases must be disjoint intervals (see CompileMemory's header, and CompileTimings' for the original of this rule).")
		end 'overlapAllocs'

		if claimed.bytes > self.total.bytes 'overlapBytes'
			panic("CompileMemory: the phases claim {claimed.bytes} allocated bytes but the whole compile allocated {self.total.bytes} — two phase probes OVERLAP and are double-counting (see CompileMemory's header).")
		end 'overlapBytes'

		if claimed.frees > self.total.frees 'overlapFrees'
			panic("CompileMemory: the phases claim {claimed.frees} frees but the whole compile freed {self.total.frees} — two phase probes OVERLAP and are double-counting (see CompileMemory's header).")
		end 'overlapFrees'

		let allocs = self.total.allocs - claimed.allocs
		let frees = self.total.frees - claimed.frees
		return PhaseDelta.create(0, cpuTicks: 0, allocs: allocs, frees: frees, bytes: self.total.bytes - claimed.bytes)
	end 'unattributed'
end 'CompileMemory'

// Allocations inside a pool phase's wall that none of its breakdown rows claimed: the driver loop
// itself. Same contract as `CompileMemory.unattributed`, enforced the same way. The breakdown's memory
// columns are per-worker counts (`PoolPhaseCosts`), so summed over the workers they partition what the
// driver's process-wide bracket saw and can never exceed it — unlike the time columns, which overlap.
function poolMemoryUnattributed(wall PhaseDelta, claimed PhaseDelta, breakdown String) returns PhaseDelta
	if claimed.allocs > wall.allocs 'overlap'
		panic("CompileMemory: {breakdown} claim {claimed.allocs} allocations but the phase they break down made {wall.allocs} — two probes OVERLAP (see RegisterAllocator.allocateFunctionCore, which subtracts liveness back out of the splitter's bracket precisely to keep the sub-phases disjoint).")
	end 'overlap'

	let allocs = wall.allocs - claimed.allocs
	let frees = wall.frees - claimed.frees
	return PhaseDelta.create(0, cpuTicks: 0, allocs: allocs, frees: frees, bytes: wall.bytes - claimed.bytes)
end 'poolMemoryUnattributed'

// What a driver phase's breakdown claimed: its pool rows, and for `regalloc` the allocator's own
// sub-phase rows besides — the memory twin of `CompileTimings.claimedUnder`.
function claimedMemoryUnder(memory CompileMemory, timings CompileTimings, driver CompilePhase) returns PhaseDelta
	var claimed = memory.columns.totalDeltaWhere(timings.poolRowsUnder(driver), wanted: true)

	if driver == CompilePhase.regalloc 'theAllocatorsOwnRows'
		for sub in RegAllocPhase.allCases 'eachSub'
			claimed = deltaSum(claimed, other: memory.regAlloc.deltaOf(sub))
		end 'eachSub'
	end 'theAllocatorsOwnRows'

	return claimed
end 'claimedMemoryUnder'

// The whole-compile memory table: every phase's allocations, frees and byte volume, the
// allocator's sub-phases nested under `regalloc`, and a TOTAL / attributed / unattributed
// footer that makes any gap explicit. Printed beside the timing table, under the same
// `--log=compiler:debug`, and built lazily behind it so a plain build never formats a row.
//
// `timings` is read for one column: which phases were measured on a pool, and which driver's row each is
// a breakdown of rather than an interval beside it (`PhaseRowKind`).
export function compileMemoryReport(memory CompileMemory, timings CompileTimings) returns String
	let total = memory.total

	var msg = StringBuilder.create()
	msg.append("compile memory — {total.allocs} allocs, {total.frees} frees, {total.bytes} bytes\n")
	msg.append("{padRight("{MemRowIndent}phase", width: MemPhaseNameWidth)}{padLeft("allocs", width: MemAllocsWidth)}{padLeft("frees", width: MemFreesWidth)}{padLeft("bytes", width: MemBytesWidth)}\n")
	msg.append(horizontalRule(MemRuleWidth))

	for phase in CompilePhase.allCases 'eachPhase'
		msg.append(memoryRow("{MemRowIndent}{phase.name}{PoolMeasuredSuffix if timings.isMeasuredOnAPool(phase) else ""}", delta: memory.deltaOf(phase)))

		if phase == CompilePhase.regalloc 'nestRegAlloc'
			msg.append(regAllocSubPhaseMemoryRows(memory))
		end 'nestRegAlloc'

		if phase == CompilePhase.regalloc or timings.drivesAPool(phase) 'nestPool'
			msg.append(memoryRow("{MemSubPhaseIndent}(unattributed)", delta: poolMemoryUnattributed(memory.deltaOf(phase), claimed: claimedMemoryUnder(memory, timings: timings, driver: phase), breakdown: "the rows breaking `{phase.name}` down")))
		end 'nestPool'
	end 'eachPhase'

	let poolRows = timings.poolRowMask()
	msg.append(horizontalRule(MemRuleWidth))
	msg.append(memoryRow("{MemRowIndent}TOTAL", delta: total))
	msg.append(memoryRow("{MemRowIndent}attributed", delta: memory.attributed(poolRows)))
	msg.append(memoryRow("{MemRowIndent}unattributed", delta: memory.unattributed(poolRows)))
	msg.append(compileResidencyReport(memory))
	return msg.build()
end 'compileMemoryReport'

// Empty for a build that did not sample, rather than a table of zeroes that reads as an allocation-free
// compile.
function compileResidencyReport(memory CompileMemory) returns String
	var peak = PhaseResidency.zero()
	var peakCommittedPhase = ""
	var peakLivePhase = CompilePhase.load
	var msg = StringBuilder.create()

	msg.append("\ncompile residency — the heap's LEVEL at each phase boundary, in bytes\n")
	msg.append("{padRight("{MemRowIndent}phase", width: MemPhaseNameWidth)}{padLeft("live", width: MemBytesWidth)}{padLeft("free", width: MemBytesWidth)}{padLeft("cachedFree", width: MemBytesWidth)}{padLeft("parked", width: MemBytesWidth)}{padLeft("committed", width: MemBytesWidth)}\n")
	msg.append(horizontalRule(ResidencyRuleWidth))

	for phase in CompilePhase.allCases 'eachPhase'
		let reading = memory.residencyOf(phase)
		let committed = reading.committedBytes
		let live = reading.liveBytes

		msg.append(residencyRow("{MemRowIndent}{phase.name}", reading: reading))

		if committed > peak.committedBytes 'highestCommitted'
			peak = memory.residencyOf(phase)
			peakCommittedPhase = phase.name
		end 'highestCommitted'

		if live > memory.residencyOf(peakLivePhase).liveBytes 'highestLive'
			peakLivePhase = phase
		end 'highestLive'
	end 'eachPhase'

	if peakCommittedPhase.isEmpty() 'neverSampled'
		return ""
	end 'neverSampled'

	msg.append(horizontalRule(ResidencyRuleWidth))
	msg.append(residencyRow("{MemRowIndent}PEAK committed", reading: peak))
	msg.append("{MemRowIndent}peak committed {peak.committedBytes} at {peakCommittedPhase}; peak live {memory.residencyOf(peakLivePhase).liveBytes} at {peakLivePhase.name}; held-not-live {peak.committedBytes - peak.liveBytes}\n")
	msg.append(tagCensusReport(memory, peakLivePhase: peakLivePhase))
	return msg.build()
end 'compileResidencyReport'

type TagCensusRow
	export var bucket as TagBucketIndex
	export var count as AllocCount
	export var bytes as HeapByteCount

	export static function create(bucket TagBucketIndex, count AllocCount, bytes HeapByteCount) returns TagCensusRow
		return Self{bucket: bucket, count: count, bytes: bytes}
	end 'create'
end 'TagCensusRow'

typealias TagCensusRowArray = Array with TagCensusRow

function tagCensusReport(memory CompileMemory, peakLivePhase CompilePhase) returns String
	let census = memory.tagCensus

	if not census.enabled 'notRequested'
		return ""
	end 'notRequested'

	let names = census.names
	var msg = StringBuilder.create()

	msg.append("\n{tagCensusHeadline(census.mode)}\n")

	if census.mode == SlabCensusTagMode and names.count() == 0 'noNameTable'
		msg.append("{MemRowIndent}this binary carries no interned-name table, so every bucket is shown as `tag=<n>` — the same table `maxon monitor` reads to name a traced allocation\n")
	end 'noNameTable'

	let peakSampled = census.sampledAt(peakLivePhase.ordinal)
	var peakRows = TagCensusRowArray.create()

	if peakSampled 'rankThePeakOnce'
		peakRows = tagCensusRanked(census, index: peakLivePhase.ordinal, wholeTable: true)
	end 'rankThePeakOnce'

	for phase in CompilePhase.allCases 'eachPhase'
		if not census.sampledAt(phase.ordinal) 'neverSampled'
			continue
		end 'neverSampled'

		var line = ""

		if phase == peakLivePhase and peakSampled 'thePeakIsAlreadyRanked'
			line = tagCensusTopLine(peakRows, mode: census.mode, names: names)
		end 'thePeakIsAlreadyRanked' else 'rankedForTheLineAlone'
			line = tagCensusTopLine(tagCensusRanked(census, index: phase.ordinal, wholeTable: false), mode: census.mode, names: names)
		end 'rankedForTheLineAlone'

		msg.append("{MemRowIndent}{phase.name}: {line}\n")
	end 'eachPhase'

	if not peakSampled 'peakNeverSampled'
		msg.append("{MemRowIndent}the peak-live phase {peakLivePhase.name} was not censused, so there is no table to print for it\n")
		return msg.build()
	end 'peakNeverSampled'

	msg.append("{MemRowIndent}the whole table at {peakLivePhase.name}, the peak-LIVE phase\n")
	msg.append("{padRight("{MemRowIndent}{tagCensusColumnTitle(census.mode)}", width: TagLabelWidth)}{padLeft("live", width: MemAllocsWidth)}{padLeft("bytes", width: MemBytesWidth)}\n")
	msg.append(horizontalRule(TagCensusRuleWidth))

	for row in peakRows 'eachRow'
		msg.append(tagCensusRowText(row, mode: census.mode, names: names))
	end 'eachRow'

	msg.append(tagCensusRowText(tagCensusRowAt(census, index: peakLivePhase.ordinal, bucket: SlabCensusImplausibleBucket), mode: census.mode, names: names))
	msg.append(tagCensusRowText(tagCensusRowAt(census, index: peakLivePhase.ordinal, bucket: SlabCensusOverflowBucket), mode: census.mode, names: names))
	msg.append(horizontalRule(TagCensusRuleWidth))

	let committed = memory.residencyOf(peakLivePhase).committedBytes
	msg.append("{MemRowIndent}os-direct: no row above counts a mapping the slab did not serve — committed {committed} bytes at this phase INCLUDES the OS-direct road's live mappings and the allocator's own overhead\n")
	msg.append("{MemRowIndent}{census.rawLiveSlotsAt(peakLivePhase.ordinal)} live slots carry no box header — the rows above attribute each of them by whatever its first word holds, so they land in {TagCensusUnattributableLabel} or in a tag bucket that is not theirs\n")
	msg.append("{MemRowIndent}{tagCensusSelfCheck(tagCensusTotalBytes(census, index: peakLivePhase.ordinal), tallyBytes: census.tallyBytesAt(peakLivePhase.ordinal), liveBytes: census.liveBytesAt(peakLivePhase.ordinal))}\n")
	return msg.build()
end 'tagCensusReport'

function tagCensusHeadline(mode TagCensusMode) returns String
	if mode == SlabCensusTagMode 'byTag'
		return "census by tag — the live heap by ALLOCATION TAG at each phase boundary, in bytes"
	end 'byTag'

	return "census by size class — this compiler carries no {DebugStreamFlag}, so no allocation has a tag and the tally attributes each live slot by SIZE CLASS instead"
end 'tagCensusHeadline'

function tagCensusColumnTitle(mode TagCensusMode) returns String
	if mode == SlabCensusTagMode 'byTag'
		return "tag"
	end 'byTag'

	return "size class"
end 'tagCensusColumnTitle'

export function tagCensusLabel(mode TagCensusMode, bucket TagBucketIndex, names StringArray, count AllocCount, bytes HeapByteCount) returns String
	if bucket == SlabCensusImplausibleBucket 'noPackedIdExplainsIt'
		return TagCensusUnattributableLabel
	end 'noPackedIdExplainsIt'

	if bucket == SlabCensusOverflowBucket 'pastTheTable'
		return TagCensusOverflowLabel
	end 'pastTheTable'

	if mode == SlabCensusTagMode 'byTag'
		let named = try names.get(bucket) otherwise ""

		if named.isEmpty() 'unnamed'
			return "tag={bucket}"
		end 'unnamed'

		return named
	end 'byTag'

	if count == 0 'noSlotToDivideBy'
		return "class {bucket}"
	end 'noSlotToDivideBy'

	let slotBytes = try (bytes / (count as HeapByteCount)) otherwise panic("tagCensusLabel: bucket {bucket} holds {count} slots and {bytes} bytes, and the zero-count arm above did not answer")

	return "class {bucket} ({slotBytes} bytes)"
end 'tagCensusLabel'

function tagCensusRowAt(census PhaseTagCensusColumns, index PhaseIndex, bucket TagBucketIndex) returns TagCensusRow
	return TagCensusRow.create(bucket, count: census.countAt(index, bucket: bucket), bytes: census.bytesAt(index, bucket: bucket))
end 'tagCensusRowAt'

function tagCensusRanked(census PhaseTagCensusColumns, index PhaseIndex, wholeTable bool) returns TagCensusRowArray
	var rows = TagCensusRowArray.create()

	for bucket in 0 upto SlabCensusTagBuckets 'eachBucket'
		if bucket == SlabCensusImplausibleBucket or bucket == SlabCensusOverflowBucket 'itsOwnRow'
			continue
		end 'itsOwnRow'

		let row = tagCensusRowAt(census, index: index, bucket: bucket)

		if row.bytes == 0 and row.count == 0 'empty'
			continue
		end 'empty'

		if wholeTable 'everyLiveBucket'
			rows.push(row)
		end 'everyLiveBucket' else 'theTopRowsAlone'
			keepTagCensusTopRow(rows, row: row)
		end 'theTopRowsAlone'
	end 'eachBucket'

	if wholeTable 'sortWhatWasPushed'
		rows.sort(function(left TagCensusRow, right TagCensusRow) gives tagCensusRank(left, against: right))
	end 'sortWhatWasPushed'

	return rows
end 'tagCensusRanked'

function tagCensusRank(row TagCensusRow, against TagCensusRow) returns Ordering
	if row.bytes != against.bytes 'byBytes'
		return against.bytes.compare(row.bytes)
	end 'byBytes'

	return row.bucket.compare(against.bucket)
end 'tagCensusRank'

function keepTagCensusTopRow(top TagCensusRowArray, row TagCensusRow)
	var at = top.count()

	while at > 0 'findItsPlace'
		let ahead = try top.get(at - 1) otherwise panic("keepTagCensusTopRow: slot {at - 1} of {top.count()} is not readable")

		if tagCensusRank(ahead, against: row) == Ordering.lessThan 'inPlace'
			break
		end 'inPlace'

		at = at - 1
	end 'findItsPlace'

	if at >= TagCensusTopRows 'belowEveryRowKept'
		return
	end 'belowEveryRowKept'

	top.insert(at, value: row)

	if top.count() > TagCensusTopRows 'oneTooMany'
		_ = try top.pop() otherwise panic("keepTagCensusTopRow: {top.count()} rows are held and none can be dropped")
	end 'oneTooMany'
end 'keepTagCensusTopRow'

function tagCensusRowText(row TagCensusRow, mode TagCensusMode, names StringArray) returns String
	return "{padRight("{MemRowIndent}{tagCensusLabel(mode, bucket: row.bucket, names: names, count: row.count, bytes: row.bytes)}", width: TagLabelWidth)}{padLeft("{row.count}", width: MemAllocsWidth)}{padLeft("{row.bytes}", width: MemBytesWidth)}\n"
end 'tagCensusRowText'

function tagCensusTopLine(rows TagCensusRowArray, mode TagCensusMode, names StringArray) returns String
	if rows.count() == 0 'nothingLive'
		return "nothing live"
	end 'nothingLive'

	var shown = 0 as TagRowCount
	var line = ""

	for row in rows 'eachRow'
		if shown == TagCensusTopRows 'enough'
			break
		end 'enough'

		line.append("{TagCensusTopSeparator if shown > 0 else ""}{tagCensusLabel(mode, bucket: row.bucket, names: names, count: row.count, bytes: row.bytes)} {row.bytes}B/{row.count}")
		shown = shown + 1
	end 'eachRow'

	return line
end 'tagCensusTopLine'

function tagCensusTotalBytes(census PhaseTagCensusColumns, index PhaseIndex) returns HeapByteCount
	var total = 0 as HeapByteCount

	for bucket in 0 upto SlabCensusTagBuckets 'eachBucket'
		total = total + census.bytesAt(index, bucket: bucket)
	end 'eachBucket'

	return total
end 'tagCensusTotalBytes'

function tagCensusSelfCheck(totalBytes HeapByteCount, tallyBytes HeapByteCount, liveBytes HeapByteCount) returns String
	return "Σ bytes = {totalBytes}, the tally walked {tallyBytes}, slabLiveBytes = {liveBytes}{tagCensusAgainstTheLevel("Σ bytes", figure: totalBytes, liveBytes: liveBytes)}{tagCensusAgainstTheLevel("the tally's own walk", figure: tallyBytes, liveBytes: liveBytes)}"
end 'tagCensusSelfCheck'

function tagCensusAgainstTheLevel(what String, figure HeapByteCount, liveBytes HeapByteCount) returns String
	if figure == liveBytes 'agrees'
		return ""
	end 'agrees'

	if figure > liveBytes 'higher'
		return " — {what} is {figure - liveBytes} bytes HIGHER than the level it decomposes, which no correct pair of walks can be"
	end 'higher'

	return " — {what} is {liveBytes - figure} bytes SHORT of the live level it decomposes"
end 'tagCensusAgainstTheLevel'

function tagCensusNames(mode TagCensusMode) returns StringArray
	if mode != SlabCensusTagMode 'sizeClassesAreNotNamed'
		return StringArray.create()
	end 'sizeClassesAreNotNamed'

	let exe = try Process.executablePath() otherwise 'noIntrospection'
		return StringArray.create()
	end 'noIntrospection'

	let symdata = try readLinkedSection(exe, target: detectHostTarget(), section: LinkedSectionKind.internedNames) otherwise 'noSection'
		return StringArray.create()
	end 'noSection'

	return nameBlobIn(symdata, magic: DsTagBlobMagic)
end 'tagCensusNames'

function residencyRow(label String, reading PhaseResidency) returns String
	return "{padRight(label, width: MemPhaseNameWidth)}{padLeft("{reading.liveBytes}", width: MemBytesWidth)}{padLeft("{reading.freeBytes}", width: MemBytesWidth)}{padLeft("{reading.cachedFreeBytes}", width: MemBytesWidth)}{padLeft("{reading.parkedBytes}", width: MemBytesWidth)}{padLeft("{reading.committedBytes}", width: MemBytesWidth)}\n"
end 'residencyRow'

function regAllocSubPhaseMemoryRows(memory CompileMemory) returns String
	var msg = StringBuilder.create()

	for sub in RegAllocPhase.allCases 'eachSub'
		msg.append(memoryRow("{MemSubPhaseIndent}{sub.name}", delta: memory.regAlloc.deltaOf(sub)))
	end 'eachSub'

	return msg.build()
end 'regAllocSubPhaseMemoryRows'

function memoryRow(label String, delta PhaseDelta) returns String
	return "{padRight(label, width: MemPhaseNameWidth)}{padLeft("{delta.allocs}", width: MemAllocsWidth)}{padLeft("{delta.frees}", width: MemFreesWidth)}{padLeft("{delta.bytes}", width: MemBytesWidth)}\n"
end 'memoryRow'
