	var filled = BoolArray.create()

	for _ in 0 upto paramCount 'initSlots'
		slotIds.push(0 as ValueId)
		filled.push(false)
	end 'initSlots'

	// The author's arguments are everything before the compiler's trailing run of defaults. The subtraction
	// cannot underflow (`ParamCount` is unsigned, so it would be a range panic rather than a wrap): every
	// entry of `argDefaultSlots` was pushed by `Parser.fillArgsFromParamDefaults` in lockstep with an
	// argument APPENDED to this same list, so the column is never longer than `args`. That invariant is
	// stated where the column is declared (`MaxonOp.call`) and named here because this is where it is spent.
	let sourceCount = args.count() - argDefaultSlots.count()

	for i in 0 upto args.count() 'placeArgs'
		let argId = try args.get(i) otherwise panic("slotCallArgs: args.get OOB at {i}")
		let label = try argLabels.get(i) otherwise panic("slotCallArgs: argLabels.get OOB at {i}")

		// A SYNTHESIZED default names its slot outright; only a SOURCE-written argument is resolved by label.
		// That split is what keeps two `_` parameters apart: `_` binds nothing, so a signature may declare it
		// twice, and a name lookup then cannot tell the two apart (`MaxonOp.call`'s `argDefaultSlots`).
		let pos = try callArgSlot(paramNames, argDefaultSlots: argDefaultSlots, sourceCount: sourceCount, argIndex: i, label: label) otherwise return ArgSlotResult.unknownLabel(i, label: String.from(label))

		let alreadyFilled = try filled.get(pos) otherwise panic("slotCallArgs: filled.get OOB at {pos}")

		if alreadyFilled 'dup'
			let paramName = try paramNames.get(pos) otherwise panic("slotCallArgs: paramNames.get OOB at {pos}")
			return ArgSlotResult.duplicateArg(i, paramName: String.from(paramName))
		end 'dup'

		try slotIds.set(pos, value: argId) otherwise panic("slotCallArgs: slotIds.set OOB at {pos}")
		try filled.set(pos, value: true) otherwise panic("slotCallArgs: filled.set OOB at {pos}")
	end 'placeArgs'

	return ArgSlotResult.ordered(slotIds)
end 'slotCallArgs'

// A synthesized default's slot is checked against `paramNames` because the parser filled the defaults
// from one overload member, and the member resolved later can declare fewer parameters.
function callArgSlot(paramNames ByteArrayArray, argDefaultSlots ParamCountArray, sourceCount ElementIndex, argIndex ParamCount, label ByteArray) returns ParamCount throws MapError
	if argIndex < sourceCount 'sourceWritten'
		return try argSlotPosition(paramNames, argIndex: argIndex, label: label)
	end 'sourceWritten'

	let slot = try argDefaultSlots.get(argIndex - sourceCount) otherwise panic("callArgSlot: argDefaultSlots.get OOB at {argIndex - sourceCount} — the synthesized defaults are the trailing run of args")

	if slot >= paramNames.count() 'pastTheResolvedSignature'
		throw MapError.keyNotFound
	end 'pastTheResolvedSignature'

	return slot
end 'callArgSlot'

export type Project
	// Incremental query plumbing (source inputs + memo caches + dep graph).
	export var db as QueryDatabase

	// The checkout's `stdlib/` directory, located once at load time (`locateStdlibDir`). Read by the
	// stdlib loader, which enumerates it, and by nothing else — every later pass asks about a
	// FUNCTION, not a path (`isLibraryFunction`).
	export var stdlibDir as FilePath

	// The checkout's `runtime/` directory — the language runtime, the second source tier every compile
	// loads. DERIVED from `stdlibDir`'s location rather than located on its own (`locateRuntimeDir`), so
	// a compile cannot pair one tree's stdlib with another tree's runtime.
	export var runtimeDir as FilePath

	// Every file the library loader parsed out of those two directories — which is exactly "the LIBRARY
	// source this compile contains", established by construction rather than by re-testing paths later
	// (see StdlibSource). One array and not one per root, because every reader asks the same question of
	// it: which of this compile's files did the program's author not write. Empty until the loader runs.
	export var librarySourcePaths as MaxonSourcePathArray

	// What THIS compile knows about the stdlib source it loaded (`deriveLibraryFacts`), computed once
	// after the module is merged: which stdlib functions the program cannot reach, and which of the
	// ones it CAN reach need the x64-windows substrate. Every PRE-elimination pass that examines
	// function BODIES for a target/runtime decision — `scanRuntimeUsage`'s floor scan, `checkCalls`'s
	// E3104 target-support gate — consults it, so unreachable stdlib code decides nothing about a
	// program that does not contain it. Both halves are empty for stdlib-free code and neither ever
	// holds a USER function, so no user-only program's checks change.
	export var libraryFacts as LibraryFacts

	// This compile's live managed globals in initialization order, set before the pipeline runs, for the service
	// rules `semanticCheck` asks about module `let`s and global initializers.
	export var managedGlobals as ManagedGlobalArray

	// Declared function return types (the parse-staging registry).
	export var funcReturnTypes as FuncReturnTypeMap

	// Declared function parameter signatures (names + types), keyed by name.
	// The parse-staging registry the call machinery reads (see FuncSignature).
	export var funcSignatures as FuncSignatureMap
	export var funcSignatureFloors as FuncSignatureFloorMap

	// ⭐ Every OVERLOADED bare name in the program ⇒ its members' registration names (see OverloadSetMap for
	// what the two names are and why this one registry is not reset with the others). Empty unless the
	// program declares one name twice with different signatures.
	export var overloadSets as OverloadSetMap

	// ⭐ Which member `checkConformance` accepted for each witness-table slot — see WitnessSlotImplMap
	// for why the lowering reads this instead of re-deriving the impl symbol. Empty for every program that
	// declares no conformance.
	export var witnessSlotImpls as WitnessSlotImplMap

	// ⭐ Recorded function-value merges awaiting whole-program signature agreement. Filled by
	// `mergeArtifact` (each file's `pendingFnMergeChecks` appended in order); drained by
	// `checkValueMergeSignatures` before the pipeline runs. Reset with the other merge targets.
	export var pendingFnMergeChecks as PendingFnMergeCheckArray

	// ⭐ Recorded function-type doors awaiting whole-program shape agreement (see PendingFunctionTypeDoor).
	// Filled by `mergeArtifact` (each file's `pendingFunctionTypeDoors` appended in order); drained by
	// `SemanticCheck.checkFunctionTypeDoors`, which is AFTER `resolveTypes` because the shapes are compared
	// resolved — the one thing that keeps it out of `checkValueMergeSignatures`' pre-resolution sweep. Reset
	// with the other push-merge targets so a warm rebuild does not double it.
	export var pendingFunctionTypeDoors as PendingFunctionTypeDoorArray

	// ⭐ Recorded sites that used none of a call's result, awaiting the whole-program effect summary (see
	// PendingDiscardedResult). Filled and drained exactly as the list above.
	export var pendingDiscardedResults as PendingDiscardedResultArray

	// ⭐ THE TWO DEFERRED NAME DIAGNOSTIC LISTS — E3062 candidates and hidden type names,
	// appended per file by `mergeArtifact` and drained, in this order, by
	// `TypeResolution.reportDeferredNameDiagnostics`. `DeferredNameDiagnostic` carries the argument for
	// why they are held back rather than reported where they are found. Reset with the other push-merge
	// targets so a warm rebuild does not double them.
	export var unusedTypeAliasDiagnostics as DeferredNameDiagnosticArray
	export var hiddenTypeNameDiagnostics as DiagnosticArray

	export var deferredParseErrors as DeferredParseErrorArray

	// The generic-instance alias names some file wrote in a type position — one half of the cross-file
	// E3062 credit, which `TypeResolution.reportDeferredNameDiagnostics` completes by asking the
	// candidate's OWN file the same question. Only a name
	// `ProgramSignatures.fileMeansTheSoleGenericAliasDeclaration` admits of the SPELLING file is inserted
	// (`ParseStaging.noteWrittenGenericAliasNames`); a wider insert silently drops a true E3062.
	export var genericAliasNamesWrittenByAFile as UsedTypeNameSet

	// ⭐⭐ **THE DECLARATION-HYGIENE DIAGNOSTICS (E3012 unused, E3077 var-should-be-let), HELD BACK UNTIL
	// EVERY CHECK THAT COULD EXPLAIN THE BODY HAS RUN** — appended per file by `mergeArtifact` and drained
	// by `Compiler.reportBindingHygieneDiagnostics`, the last thing `compileToCodeResult` does — AFTER the
	// backend, which is where the reason lives and where the four measurements that fixed the position are
	// written down. ⛔ Moving the drain earlier re-breaks `type-casting.md`; read that header first.
	//
	// ⚠ **REPORTING THEM WHERE THEY ARE FOUND IS A MEASURED CASCADE, and it is why this list exists.** They
	// are decided at a function's `end` DURING THE PARSE, and the parser's diagnostics gate the pipeline
	// before `resolveTypes`/`semanticCheck` ever run — so `let x = 256 as Byte`, whose whole point is the
	// out-of-range cast, reported `unused variable: 'x'` and the E3005 it is a test OF never happened. 26
	// committed error-cases moved that way the first time locals were admitted, `type-casting.md` (a
	// canonical `/specs` port) among them.
	//
	// ⇒ **A body the compiler had a real complaint about never also reports its hygiene diagnostics**, which
	// is the drain's one rule (see there for why the suppression is whole-program rather than per function).
	export var bindingHygieneDiagnostics as DiagnosticArray

	// ⭐ Every declaration a type-name COLLISION was reported for (E3061/E3006,
	// `reportTypeNameCollision`) — the suppression set the unused-typealias drain reads, so one mistake
	// earns one diagnostic. Keyed by `fileScopedDeclKey`, per DECLARING FILE: a bare name would let one
	// file's duplicate `Byte` swallow another file's genuinely-unused one, two files being entitled to
	// declare that name (see `TypeNameRegistry`). Reset with `typeNameDecls`, whose walk is its only
	// writer.
	export var collidedTypeNames as CollidedTypeNameSet

	// Declared ranged typealiases, keyed by name (see RangedTypeAlias). The registry
	// TypeResolution resolves every `MaxonType.named` against.
	export var typeAliases as RangedAliasRegistry

	// Every declaration that minted a TYPE NAME, whatever keyword minted it (see TypeNameRegistry).
	// The one decider of "is this type name already declared?", which each per-kind registry above
	// structurally cannot answer — it sees only its own kind. Reset with the other merge targets: it
	// is FIRST-WINS, so a warm rebuild that re-merged the same files would report every declaration
	// in the program as a duplicate of itself.
	export var typeNameDecls as TypeNameRegistry

	// Range-check sites, keyed by function name (see FunctionRangeChecks). The parser
	// records every `as` cast into a ranged alias and every ranged `return`; `InsertRangeChecks`
	// (Std tier) reads this to emit the guards / E3005. Kept SEPARATE from `funcReturnTypes`
	// because that registry is COLLAPSED to primitives by `resolveTypes`, which discards the
	// alias name a check needs; this one is written once at merge and never resolved away.
	export var rangeChecks as RangeCheckPlanMap

	// Declared FUNCTION typealiases, keyed by name (see FunctionTypeAlias). Its OWN registry,
	// not folded into `typeAliases`, because a function alias is not a ranged numeric one (see
	// FunctionTypeAlias). The parser reads it to resolve a function-typed place and to type an indirect
	// call's result.
	export var functionTypeAliases as FunctionTypeAliasMap

	// The RESOLVED shape of each function typealias (see FunctionShapeMap) — derived from the registry
	// above by `TypeResolution.resolveTypes`, not merged, so it is rebuilt whenever resolution runs and
	// there is no second copy of a declaration to keep in step.
	export var functionAliasShapes as FunctionShapeMap

	// Declared struct types, keyed by name (see StructLayout). The registry's OTHER half: a
	// `MaxonType.named` resolves against the aliases above OR against this, and a name in neither
	// is E3011.
	export var structTypes as StructLayoutMap

	// Declared enum/union types, keyed by name (see EnumLayout). The struct registry's twin: a
	// `MaxonType.named` naming a declared `enum`/`union` resolves to `integer` here (an enum value
	// is its i64 tag), and the parser reads the cases through the whole-program signature index.
	export var enumTypes as EnumLayoutMap

	// Declared `interface` types, keyed by name (see IrInterface). Holds only
	// USER-declared interfaces; the stdlib protocol interfaces (Stringable, Hashable, …) are
	// synthesized on lookup (`builtinInterface`) rather than merged here, so they never ride the
	// merge/reset machinery. Read whole-program by `checkConformance`.
	export var interfaces as IrInterfaceMap

	// Declared `implements` conformances, one per `type X implements …` (see ConformanceDecl). An
	// ARRAY, not a map: the conformance check drains it once whole-program, and a type declaring
	// conformance twice is two decls to report, not one to overwrite. Reset with the other push-merge
	// targets (`pendingFnMergeChecks`) so a warm rebuild does not double it.
	export var conformances as ConformanceDeclArray

	// ⭐ **THE MEMOIZED `type -> interfaces it declares` INDEX** derived from `conformances`.
	// Built on first ask by `ConformanceCheck.declaredConformanceIndex` and
	// reset with `conformances` itself, so the two cannot come to describe different programs. The
	// `…Built` flag is what distinguishes "not built yet" from "built, and this program declares none" —
	// `ProgramSignatures.arrayByteInstanceComputed`'s arrangement, and for its reason: an empty map is a
	// legitimate answer, so emptiness cannot double as the validity bit.
	export var declaredConformances as DeclaredConformanceMap
	export var declaredConformanceIndexBuilt as bool

	// Every `<Type> from "…"` construction the program writes (see LiteralInitSite), one per site, in
	// merge order. An ARRAY for `conformances`' reason: the check drains it once whole-program and two
	// constructions of one type are two positions to report. Read by `checkLiteralInitConformance`.
	export var literalInitSites as LiteralInitSiteArray

	// ⭐ **EVERY INSTANTIATION A BRACKETED LITERAL INFERRED** — one per literal, in merge order,
	// an ARRAY for `literalInitSites`' reason. It is the PARSER-side half of
	// `ProgramSignatures.instantiationSites`, which holds the ones a `typealias` wrote; the two are read
	// together by `checkWhereConstraints`, because a `where` clause binds an instance however it was
	// spelled and a literal is the one spelling that writes no type name.
	export var inferredInstantiationSites as GenericInstantiationSiteArray

	// id <-> name table behind every `MaxonType.named`. Folded from per-file
	// artifact interners at merge time (see TypeNameInterner.maxon).
	export var typeNames as TypeNameInterner

	export var signatureTypeDemands as SignatureTypeDemandArray

	// Source span of every op in the whole-program Maxon module, parallel by op
	// index. Folded from the per-file artifact tables by `mergeArtifact`, in the
	// same source-path order the module itself merges. A MAXON-TIER table: the Std
	// and Target modules carry no spans (see SourceRangeTable). Read on the cold
	// path only — diagnostics and, later, LSP queries.
	export var opRanges as SourceRangeTable

	// Whether this build emits the green-thread async trace (`--async-trace`). Set by the driver right after the
	// project is loaded and read once, by `installGtRuntime`. A per-BUILD switch rather than a per-file one, so
	// it lives here beside `target` rather than on any artifact.
	export var asyncTrace as bool

	// ⭐ Whether this build emits the DebugStream producer (`--debugstream`). A per-BUILD switch, so it
	// belongs beside `target` and not on any artifact — and a `let` fixed at creation for `target`'s reason:
	// the `#if debugstream(...)` predicate reads it at the token tier, and `Queries.queryActiveTokens`' memo
	// omits it from its key on the strength of its never changing.
	export let debugStream as bool

	// ⭐ Whether this build writes the `<output>.mxdbg` debug-info sidecar. Set by the driver right after
	// the project is loaded, exactly as `asyncTrace` is, and a per-BUILD switch for the same reason. It ARMS
	// the span columns and nothing else: no pass reads a span and nothing branches on one, so the executable
	// is byte-identical whichever way this is set — which is the whole reason the sidecar may exist at all.
	export var debugInfo as bool

	// The withheld bodies this build was asked to print (`--emit-ir-runtime=`, a ```RequiredRuntime
	// block's request). A name here is a REFERENCE the inliner's census must see: a called-once callee
	// spliced away is dropped by dead-function elimination, and the printer has no body to render.
	export var requestedRuntimeBodies as RuntimeFunctionNameArray

	// A caller that wants the Target IR text must set this before `compileToCodeResult` runs; the backends
	// keep their `codeChunks` and `releaseEncodedTargetModule` keeps the module's body only where it holds.
	// `renderTargetIr` panics rather than rendering an empty module to a caller that forgot.
	export var rendersTargetIr as bool

	// This process compiles once and exits, so `compileToCodeResult` may drop the front-end caches the
	// moment the Maxon module is folded. ⚠ A driver that re-queries after a compile — the LSP, the MCP
	// check, `run`'s cache, any recheck — must leave it false: the next query silently re-parses the cone
	// it paid to memoize.
	export var compilesOnceAndExits as bool

	// Every plain function used as a first-class VALUE (`collectFnRefThunkTargets`). Its `__fnref_` thunk is
	// installed after the pipeline and `call`s it directly, so the inliner's census must count that call
	// before the thunk exists: a callee spliced away on the strength of its one visible site would leave
	// the thunk calling an emptied body.
	export var functionValueTargets as ByteArrayArray

	// The calls the entry stub makes by name in THIS build (`DeadFunctionElimination.EntryStubCalls`), set
	// once from the usage record before the lowering pipeline runs: the reachability roots and the
	// inliner's called-once census both read it, and the census runs mid-pipeline where no usage record is
	// in reach.
	export var entryStubCalls as EntryStubCalls

	// ⭐ Whether this build instruments for code coverage (`--coverage`). Set by the driver right after the
	// project is loaded, exactly as `debugInfo` is, and a per-BUILD switch for the same reason.
	//
	// ⚠ It REQUIRES `debugInfo`, and the driver refuses the pair rather than resolving it here: what each
	// counter counts lives in the sidecar's coverage-point table, so counters without a sidecar are a data
	// file nothing could ever interpret.
	export var coverage as bool

	// Whether this build samples the allocator's census at every phase boundary. Set by the driver beside
	// `debugInfo`; `Compiler.compileMeasured` carries which flag raises it and why `--metrics` does not.
	export var samplesResidency as bool

	export var censusByTag as bool

	export var censusPhase as TagCensusPhases

	export var allocationsByTag as bool

	export var allocationsPhase as TagCensusPhases

	// The counter slots this build minted, in mint order — empty for every build `coverage` is off for.
	// A point's INDEX here is its counter slot, its `.mxdbg` coverage record and its `.mxcov` counter, so
	// this array's order is the binding between all three.
	export var covPoints as CovPointTable

	// ⭐ **WHERE AN INSTRUMENTED BINARY WRITES ITS `.mxcov`, BAKED INTO THE IMAGE AS AN `.rdata` CSTRING.**
	// ABSOLUTE, so a program run from any directory still publishes beside its own binary, and empty for
	// every build `coverage` is off for. It is resolved beside the output path and held here because the
	// runtime install that bakes it runs three phases later, with only the project in hand.
	//
	// ⛔ It is NOT derived from argv[0] at run time: deriving it means a heap allocation on a path the dump
	// must be able to take after a fault, for a fact the compiler already knows.
	export var coverageDataPath as String

	// ⭐ **WHAT `--define` SAID, FOR THE WHOLE COMPILE.** One set per `Project`, exactly as `target` is
	// one per `Project`: `queryProgramSignatures` hands these to the index that folds every top-level
	// constant, and its memo lives on `project.db` rather than in any process-wide store — so two
	// compiles differing only in their defines cannot serve each other a folded value.
	export var defines as DefineArray = DefineArray.create()

	// ⭐ WHAT THE BUILD MANIFEST SAID THIS PROGRAM'S VERSION IS, for the binary's own metadata: a Windows
	// `VS_VERSIONINFO` resource and a Mach-O `LC_SOURCE_VERSION`, already checked against this target's field
	// (`productVersionFor`). Empty when nobody said, which is most programs, and the writers then stamp a zero
	// version.
	export var productVersion as VersionComponentArray = VersionComponentArray.create()

	// The last merge renumbering this project walked an artifact with. See `VarInfo.renumberedIn`.
	export var lastRenumbering as RenumberingEpoch = 0

	// Where each source file's block of counter slots begins in `covPoints` — the FILE-LOCAL id a
	// `MaxonOp.covPoint` carries plus this file's base is the whole-program id. Written by `mergeArtifact`
	// in the same call that appends the file's points, so the two cannot disagree, and read once per
	// instrumented function by the lowering.
	//
	// ⚠ Keyed by the path STRING for `RangedAliasByDeclaringFile`'s reason: a `Map with (FilePath, V)`
	// allocates a lower-cased string on every probe.
	export var covPointBases as CovPointBaseMap

	// The interned `(file, line, column)` pool every span column below the Maxon tier indexes into. It is
	// FILLED at the lowering and READ by the sidecar builder; a build with `debugInfo` off never interns.
	export var debugSpanTable as DebugSpanTable

	// ⭐⭐ **THE FUNCTION THIS BUILD ENTERS AT — `main` for every ordinary build, and the ONE place that
	// name is written down for a compile to read.** Spelled once per tier instead — a constant in the
	// backend, one in `SemanticCheck`, one in the wasm lowering — it is this project's signature bug
	// wearing an entry point's clothes: the entry stub, the two reachability walks, E3001 and the
	// unused-export audit could each come to mean a different function.
	//
	// ⭐ **IT IS A PER-BUILD SWITCH, EXACTLY AS `asyncTrace` AND `debugStream` ARE** — set by the driver
	// right after the project is loaded and never per file, so it lives here beside `target`.
	//
	// ⚠ **A NON-`main` ENTRY DOES NOT REMOVE THE PROGRAM'S OWN `main`; IT STOPS REACHING IT.** Both
	// reachability walks seed from this name alone, so an unnamed `main` is simply pruned — which is what
	// lets `maxon test` compile a project that HAS a `main` and enter at the generated dispatcher instead.
	// `main` also keeps its unqualified registration name whatever the entry is
	// (`Parser.recordScannedSignature`): that exclusion is about the NAME `main`, not about the entry.
	export var entryFunctionName as ByteArray

	// The source files this compile itself wrote, and the reserved names it minted into each: the
	// third provenance the reserved-name doors read. Empty for every ordinary build; filled only by a
	// caller that staged generated Maxon source (`TestDispatcher.stageTestBuild`).
	//
	// ⚠ The two doors read it differently (see `CompilerWrittenSource`). Calling a `__` name is a
	// per-file exemption: the generated dispatcher has to reach names other files declare, and the
	// call door conjoins `declaresCallee`, so it grants only a `__` name some file in this program
	// declares. Declaring one is per-name, because a staged `.maxtest` file is the author's bytes with
	// a dispatcher appended, and a per-file exemption would hand the author the reserved space.
	//
	// Keyed by the very spellings the caller hands `compileToProduct` as input paths, which are the
	// paths the loader registers: one construction, never two derivations of one path.
	export var compilerWrittenSources as CompilerWrittenIndex

	// Which of this compile's sources are copies, and whose files they are copies of. Empty for every
	// ordinary build; filled by the one caller that compiles a staged tree
	// (`TestDispatcher.stageTestBuild`). `reportDiagnostic` rewrites every reported path through it,
	// and the debug sidecar names the author's file through it.
	//
	// ⚠ It never changes which bytes are compiled, which names are minted, or where the loader looks:
	// the compile works entirely in the staged paths it was handed and registered. Anything that
	// wanted to open the file a diagnostic names would want the staged spelling, which is why the
	// rewrite happens at the sink and not at the load.
	export var stagedSourceOrigins as StagedOriginIndex

	export var stdlibShadowSpellings as StdlibShadowSpellingArray
	export var shadowRespellingMemos as ShadowRespellingMemoMap
	export var shadowMints as WrittenMintSet

	// ⭐ The SOURCE TEXT of every `async <call>` spawn, keyed by its `asyncCall` op index — what E3073 quotes
	// back at the author (`'async heavyCompute(5)'`). SPARSE, unlike `opRanges`: only spawn sites have an
	// entry, so it is a map rather than a parallel array.
	//
	// ⚠ **IT IS A SIDE TABLE BECAUSE THE TEXT CANNOT BE RECOVERED LATER, AND BOTH OTHER ROUTES WERE MEASURED
	// DEAD.** Slicing the file at the op's own span does not work: `asyncCall`'s range is
	// `SourceRange.between(anchor, last: rparenTok)` and a PUNCTUATOR carries no byte offsets (`Token.startByte`
	// is 0 for every one), so the span's end byte is 0. Rebuilding the text from the op's own fields does not
	// work either — the arguments are `ValueId`s, so a literal `5` has no spelling left by then. The parser is
	// the last place the text exists, so it is captured there (`Parser.tokenTextFrom`, which lays each token at
	// the column its author wrote it) and carried here. Folded from the per-file artifact by `mergeArtifact`
	// with the same op offset `opRanges` uses. Cold path only.
	export var asyncSpawnSites as AsyncSpawnSiteMap

	// ⭐ Every `await` of a SERVICE REPLY in the program, by op index — the seed set of the acyclic
	// blocking graph. Folded from the per-file artifact with the merge's op offset, exactly as
	// `asyncSpawnSites` is. EMPTY for every program that awaits no reply, which is every program with no
	// service in it, and the check reads that count as its own gate.
	export var serviceAwaitSites as ServiceAwaitSiteMap

	// The calls `SemanticCheck.reportAmbiguousOverload` refused (E3007), by op index — reset with the
	// other op-keyed tables each fold round.
	export var refusedOverloadCalls as RefusedOverloadCallSet = RefusedOverloadCallSet.create()

	// ⭐ Every author-written READ OR WRITE of mutable module storage in the program, by op index (E3143) —
	// the candidate set of the shared-global rule. Folded from the per-file artifact with the merge's op
	// offset, exactly as `asyncSpawnSites` is. EMPTY for every program that names no module `var`, and the
	// check reads that count as its own gate. See `ModuleVarAccessSite`.
	export var moduleVarAccessSites as ModuleVarAccessSiteMap

	// The source file an op was synthesized on behalf of, by op index (`ModuleInit.recordOpTables`) —
	// what `authoredFileOf` answers for an op the function holding it was not written in.
	export var synthesizedOpFiles as SynthesizedOpFileMap

	export var registryUseSites as RegistryUseSiteMap

	// ⭐⭐ **THE mm-trace TAG FOR A BOX THE PARSER MINTS THAT IS NOT ANY DECLARED TYPE'S** — an interpolated
	// part's scratch byte run, a closure's captured environment, and the one-slot cell a reassigned
	// by-reference parameter is promoted into. Keyed by the `__mm_alloc` call's own op index, SPARSE like
	// `asyncSpawnSites` (only those three sites have an entry), folded from the per-file artifact by
	// `mergeArtifact` with the same op offset.
	//
	// ⛔⛔ **IT IS A SIDE CHANNEL BECAUSE A TRACE TAG IS NOT A TYPE, AND THE FIRST ATTEMPT PROVED IT THE
	// HARD WAY.** The tag was briefly carried in the value's `nameId` — the slot `valueNameIds` holds and
	// the TYPE CHECKER reads — on the argument that every reader of that column is gated on the value's
	// tag. It is not: a promoted parameter cell then WAS of type `ParameterCell` for argument checking
	// (`expected 'Node', got 'ParameterCell'`, nine cases) and its real type stopped being visible to
	// field access (E2015, one more). A debugging LABEL and a semantic FACT may not share a slot; this
	// table is read by exactly one function (`LowerMaxonToStd.allocTagIndexOf`) and by nothing else in the
	// compiler.
	//
	// ⚠ **RECORDED UNCONDITIONALLY, never under `--debugstream`.** A parser artifact is CACHED across
	// builds and keyed on the file's content, not the build's flags — so a parser that recorded only when
	// traced would serve one build's artifact to the other. It costs one map entry per closure, per
	// interpolated part and per promoted parameter, and is READ only by a traced build.
	export var allocTagSites as AllocTagSiteMap

	// ⭐⭐ **`__DebugStream.nameId("…")` call op index ⇒ the LITERAL that call names.** The parser reads the
	// name off its own token and emits a `__ds_name_id` marker call carrying NO arguments, because the name
	// is not a value: materializing it as one would mint the `.rdata` String record and the runtime
	// allocation the whole zero-alloc trace tier exists to avoid. The bytes ride here instead, and
	// `LowerMaxonToStd` — the first tier holding the whole-program interner — turns the marker into the
	// constant index.
	//
	// ⚠ **A SIDE TABLE FOR `allocTagSites`' REASON, not for want of a place on the op.** A `MaxonOp.call`
	// has no payload slot for a name that is not a callee, and widening the op — or minting a variant — for
	// one intrinsic would put the cost on every call in every program. Its cost here is one map entry per
	// `nameId` call, in the programs that write one.
	//
	// ⚠ **RECORDED UNCONDITIONALLY, never under `--debugstream`**, for the exact reason stated above it: a
	// parser artifact is CACHED across builds and keyed on the file's content, not the build's flags.
	export var debugStreamNameSites as DebugStreamNameSiteMap

	// ⭐⭐ **WHICH `constArrayLiteral` OPS MATERIALIZE AN IMMORTAL `.rdata` RECORD INSTEAD OF ALLOCATING
	// ONE, AND WHICH SHAPE OF ONE.** A module-level `let` the compiler can lay down as bytes reserves no
	// storage, so every READ of it re-emits its literal (`Parser.emitManagedConstant`,
	// `Parser.emitImageRecordRead`) — and the record those reads share is image data: no `__mm_alloc`, no
	// refcount, nothing to drop. An INLINE `b"…"` and a STORED global's initializer emit the identical op and
	// must keep their private heap record, which a `var` mutates in place, so the two cannot be told apart by
	// the op and this says which is which. The VALUE says which record to build, which the op cannot carry
	// either: an empty container names no blob and carries its element's destructor.
	//
	// ⚠ **A SIDE TABLE FOR `allocTagSites`' REASON, and recorded UNCONDITIONALLY for its second one**: a
	// parser artifact is CACHED across builds and keyed on the file's content, so a table written under a
	// flag would serve one build's artifact to another. It costs one entry per read of an imaged binding.
	export var immortalConstArraySites as ImmortalConstArraySiteMap

	// ⭐⭐ **THE COMPILE-TIME `element_size@24` STAMP OF A MANAGED-PRIMITIVE CALL'S CONTAINER** —
	// what lets `inlineManagedPrimitives` emit ONE of `emitStrideDispatch`'s arms instead of forking on a
	// stride the compiler already knows. `Array with Integer` is 8 at compile time and the pass was emitting a
	// `loadIndirect` of the field, two compares and two branches at every element access in every program.
	//
	// ⚠⚠ **IT IS KEYED BY AN INDEX INTO THE *STD* MODULE'S `ops`, WHICH THE THREE MAPS ABOVE ARE NOT.**
	// `asyncSpawnSites` / `allocTagSites` / `debugStreamNameSites` are written by the PARSER against MAXON op
	// indices and folded per file by `mergeArtifact`; this one is written by `LowerMaxonToStd` against the Std
	// op it has just appended, and is never merged — there is one Std module per compile. The field name
	// carries that difference rather than leaving it to this comment.
	//
	// ⭐⭐ **WHY A SIDE TABLE AND NOT A FIELD ON THE OP: `StdOp.call` CARRIES `callee` AND `args` AND NO
	// TYPE.** The Std tier is deliberately type-free — a stride slot on `call` would be a container fact on
	// every call in every program — and the tier that still HAS the type is the lowering, which is where this
	// is written. The parser is one tier further up and knows it too, but it is NOT the producer: every
	// `__managed_*` call reaches Std through `appendRuntimeCall` / `appendThrowingCall`, so recording it there
	// is one complete door rather than an enumeration of the parser's several element-access sites.
	//
	// ⚠⚠ **THE KEY IS DURABLE BECAUSE `IrModule.ops` ALLOCATES INDICES BY `push` AND THE ONE PASS IN
	// BETWEEN NEITHER CLONES NOR REPLACES A CALL.** `insertRangeChecks` appends guard ops and splits blocks
	// (which moves `opRefs`, never ops). ⇒ every op index recorded here still names the very call the
	// lowering appended.
	//
	// ⭐ **`inlineLeaves` IS NOT ON THAT LIST: IT RUNS AFTER `inlineManagedPrimitives`** — i.e. after this
	// table has been read and spent — so a splice cannot reach a live key at all. **A leaf holds no call BY
	// RULE** (`LeafOpRole.calling` refuses the callee outright), so it could neither clone nor re-issue a
	// managed primitive either; that rule is what makes the ordering safe in the OTHER direction (see
	// `PassPipeline`'s `inlineManagedPrimitives` entry), not what protects this key.
	//
	// ⚠⚠ **A STAMP IS RECORDED, NOT A VERDICT — AND THE STAMP IS NOT ALWAYS THE RECORD'S.** What may be
	// concluded from it is `strideDispatchPlanForStamp`'s to say, and the answer is not simply "this width":
	// a container declared over a TYPE PARAMETER is created at the machine-word slot inside a shared generic
	// body and read back under a SUBSTITUTED concrete type, so what is provable is
	// `actual ∈ {stamp, MachineWordBytes}`. That function carries the measurement (a byte-typed field
	// answering 0 where 7 is correct) and the three answers that survive it. The sign is part of the value
	// too (`LayoutDescriptor.elementStrideOf`: negative is `-(bits per element)`, a SUB-BYTE PACKED element
	// that must still go to the runtime) — a reader treating a negative stamp as an error rather than as a
	// width would specialize a packed array onto a byte access.
	export var stdOpElementStrides as StdOpElementStrideMap

	// ⭐⭐ **THE SITES WHOSE CONTAINER'S ELEMENT OWES NO DROP** — what lets `inlineManagedPrimitives` omit
	// the `element_destroy@40` guard from a fast arm instead of loading and comparing, at every element
	// access in every program, a field the compiler stamped from the element type. Keyed exactly as
	// `stdOpElementStrides` is — the Std op index of the call `LowerMaxonToStd` is appending, recorded by
	// the same door under the same gate — so every argument above for why that key survives to the read is
	// this table's too.
	//
	// ⭐ **A SECOND COLUMN RATHER THAN A STRUCT VALUE IN THE STRIDE MAP, AND THAT IS A COST DECISION.** A
	// Maxon struct value is a heap record, so a map carrying `(stride, owesDrop)` would allocate one per
	// element-access site in every program; a `Set` of the trivial sites costs a word per site and nothing
	// for the sites that are not.
	//
	// ⭐ **UNLIKE THE STRIDE, THIS STAMP IS ALWAYS THE RECORD'S.** Every writer of `element_destroy@40`
	// stamps it from the element type of the record's own instance: a concrete creation site from
	// `containerElementOwesDrop`, a creation inside a shared generic body from the threaded layout
	// descriptor's `destroyFunc@40` (0 for a trivial instantiation), an image-data record from
	// `columnDestroyStamp`, and a view or clone copies its source's slot. So the reading that keeps a
	// byte stride from fixing a width does not arise: the slot WIDTH inside a shared body is the body's,
	// but the element's OWNERSHIP is the instantiation's, and the descriptor carries that per
	// instantiation.
	export var stdOpTrivialElementSites as StdOpTrivialElementSiteSet

	// (funcIndex, ValueId) -> Maxon op index for every op-defined value in the
	// whole-program Maxon module (see ValueOrigin). Folded from the per-file artifact
	// tables by `mergeArtifact`, in the same source-path order the module merges. A
	// MAXON-TIER table read on the cold path only — today the backend's E5001
	// (register-pressure) diagnostic maps a Target ValueId back to its source span
	// through it.
	export var valueOrigins as ValueOriginTable
	export var deferralSources as DeferralSourceTable

	// The compile root: the file or directory this build was invoked on. Used to
	// derive per-file namespaces and the default output path.
	export var rootPath as FilePath

	// Target CPU/OS this build emits for.
	//
	// ⭐ **`let`, AND THAT IS LOAD-BEARING RATHER THAN TIDY.** `queryActiveTokens`' memo holds a
	// TARGET-DEPENDENT token stream under a key that is only the file's content hash, which is sound
	// exactly because a `Project` is aimed once and never re-aimed — two targets are two `Project`s
	// and two `QueryDatabase`s, so one cache can never be asked about a target it was not filled for.
	// As a `var` with no writer but `create`, that argument would be a survey of the current source
	// rather than a property of the type. Re-aiming a live `Project` does not
	// compile; if it ever must, mix the target into that memo's key rather than deleting this word.
	export let target as Target

	// Accumulated user-facing diagnostics; a non-empty set fails the build.
	export var diagnostics as DiagnosticArray

	// ⭐ **THE USER CONSTRUCT THE DIAGNOSTICS REPORTED RIGHT NOW ARE ON BEHALF OF** — see
	// `LibraryBlame`. Ambient rather than a parameter on `reportDiagnostic` because the front-end
	// mappers reach that sink through `parseErrorDiagnostic`'s ~200 match arms, and threading a blame
	// through every one of them would put the rule in 200 places instead of one; it is SET at exactly
	// one site (`Queries.queryParseOps`' parse-failure arm) and cleared on the next line, so the only
	// diagnostic it can reach is the one that arm reports.
	export var libraryBlame as LibraryBlame

	// Backend rdata/global constant table, threaded to `buildBackend`. Empty for
	// the `return 42` slice (no floats / string literals / static globals yet).
	export var globalData as GlobalDataTable

	// Wall-clock attribution for this compile (see CompileTimings). It lives on
	// Project because Project is ALREADY threaded through every phase — the frontend
	// queries, the pass pipeline, and the backend all take it — so no pass needs a new
	// parameter merely to be timed, and each compile gets its own timings instead of
	// the per-file fan-out driver contending on a global.
	export var timings as CompileTimings

	// Allocation attribution for this compile (see CompileMemory) — the twin of
	// `timings`, phase for phase, and here for the same reason. The two are written
	// TOGETHER, from one `PhaseProbe`, so a phase can never be timed at one boundary and
	// metered at another; see PhaseProbe's header for why that is worth a type.
	export var memory as CompileMemory

	export var retiredWorkers as RetiredWorkers

	// WHICH COMPILE this is, on the DebugStream wire (see DebugTrace). Every trace event this
	// build emits carries it, so a run that compiles N units in one process reads back as N
	// timelines instead of one shuffled pile. Derived from the compile ROOT, not handed out by a
	// counter: a counter is shared mutable state, and this field exists precisely to survive the
	// day N compiles run at once.
	export var traceUnit as TraceUnit

	export var openPhaseSpans as TraceNameArray

	export var session as CompileSession

	// The reserved words every lex of this compile, and every diagnostic naming an expected keyword, reads.
	export let keywords as KeywordTable

	// The anchors of every parser the query layer builds to fold a file into the index — the sweep, the declaration
	// folds and the constant evaluator. A real parse builds its own (`ParseStaging.parseFile`).
	export var readerAnchors as ParserAnchors

	export static function create(db QueryDatabase, rootPath FilePath, target Target, stdlibDir FilePath, runtimeDir FilePath, debugStream bool, session CompileSession) returns Project
		return Self{
			db: db,
			stdlibDir: stdlibDir,
			runtimeDir: runtimeDir,
			librarySourcePaths: MaxonSourcePathArray.create(),
			libraryFacts: LibraryFacts.empty(),
			managedGlobals: ManagedGlobalArray.create(),
			funcReturnTypes: FuncReturnTypeMap.create(),
			funcSignatures: FuncSignatureMap.create(),
			funcSignatureFloors: FuncSignatureFloorMap.create(),
			overloadSets: OverloadSetMap.create(),
			witnessSlotImpls: WitnessSlotImplMap.create(),
			pendingFnMergeChecks: PendingFnMergeCheckArray.create(),
			unusedTypeAliasDiagnostics: DeferredNameDiagnosticArray.create(),
			hiddenTypeNameDiagnostics: DiagnosticArray.create(),
			deferredParseErrors: DeferredParseErrorArray.create(),
			genericAliasNamesWrittenByAFile: UsedTypeNameSet.create(),
			bindingHygieneDiagnostics: DiagnosticArray.create(),
			collidedTypeNames: CollidedTypeNameSet.create(),
			pendingFunctionTypeDoors: PendingFunctionTypeDoorArray.create(),
			pendingDiscardedResults: PendingDiscardedResultArray.create(),
			// Aimed at the TARGET this project was created for, never the host — see `exitCodeHigh`.
			typeAliases: RangedAliasRegistry.create(target.os),
			typeNameDecls: TypeNameRegistry.create(),
			signatureTypeDemands: SignatureTypeDemandArray.create(),
			rangeChecks: RangeCheckPlanMap.create(),
			functionTypeAliases: FunctionTypeAliasMap.create(),
			functionAliasShapes: FunctionShapeMap.create(),
			structTypes: StructLayoutMap.create(),
			enumTypes: createEnumRegistry(),
			interfaces: IrInterfaceMap.create(),
			conformances: ConformanceDeclArray.create(),
			declaredConformances: DeclaredConformanceMap.create(),
			declaredConformanceIndexBuilt: false,
			literalInitSites: LiteralInitSiteArray.create(),
			inferredInstantiationSites: GenericInstantiationSiteArray.create(),
			typeNames: TypeNameInterner.createForSource(0),
			opRanges: SourceRangeTable.create(),
			asyncTrace: false,
			debugStream: debugStream,
			debugInfo: false,
			requestedRuntimeBodies: RuntimeFunctionNameArray.create(),
			rendersTargetIr: false,
			compilesOnceAndExits: false,
			functionValueTargets: ByteArrayArray.create(),
			entryStubCalls: EntryStubCalls.none(),
			coverage: false,
			samplesResidency: false,
			censusByTag: false,
			censusPhase: TagCensusPhases.everyPhase,
			allocationsByTag: false,
			allocationsPhase: TagCensusPhases.everyPhase,
			covPoints: CovPointTable.create(),
			coverageDataPath: "",
			covPointBases: CovPointBaseMap.create(),
			debugSpanTable: DebugSpanTable.create(),
			// The DEFAULT entry, read off the one constant that also states which name stays unqualified —
			// so `checkMainFunction`, the entry stub and the parser's exclusion cannot come to name three
			// different functions. A caller that enters somewhere else overwrites it after the load.
			entryFunctionName: MainFunctionName,
			compilerWrittenSources: CompilerWrittenIndex.empty(),
			stagedSourceOrigins: StagedOriginIndex.empty(),
			stdlibShadowSpellings: StdlibShadowSpellingArray.create(),
			shadowRespellingMemos: ShadowRespellingMemoMap.create(),
			shadowMints: WrittenMintSet.create(),
			asyncSpawnSites: AsyncSpawnSiteMap.create(),
			serviceAwaitSites: ServiceAwaitSiteMap.create(),
			moduleVarAccessSites: ModuleVarAccessSiteMap.create(),
			synthesizedOpFiles: SynthesizedOpFileMap.create(),
			registryUseSites: RegistryUseSiteMap.create(),
			allocTagSites: AllocTagSiteMap.create(),
			debugStreamNameSites: DebugStreamNameSiteMap.create(),
			immortalConstArraySites: ImmortalConstArraySiteMap.create(),
			stdOpElementStrides: StdOpElementStrideMap.create(),
			stdOpTrivialElementSites: StdOpTrivialElementSiteSet.create(),
			valueOrigins: ValueOriginTable.create(),
			deferralSources: DeferralSourceTable.create(),
			rootPath: rootPath,
			target: target,
			diagnostics: DiagnosticArray.create(),
			libraryBlame: LibraryBlame.unblamed,
			globalData: GlobalDataTable.create(),
			timings: CompileTimings.create(),
			memory: CompileMemory.create(),
			retiredWorkers: RetiredWorkers.create(),
			traceUnit: traceUnitOf(rootPath),
			openPhaseSpans: TraceNameArray.create(),
			session: session,
			keywords: KeywordTable.create(),
			readerAnchors: ParserAnchors.create()
		}
	end 'create'
end 'Project'

// Construct a fresh Project rooted at `rootPath` for `target`. The single
// constructor a driver needs.
// Both library roots are passed IN rather than located here so the project is born
// with valid ones: the library loader reads them before the first pass runs, and a
// field that is briefly wrong is a field something can read while it is wrong.
export function createProject(rootPath FilePath, target Target, stdlibDir FilePath, runtimeDir FilePath, debugStream bool, session CompileSession) returns Project
	return Project.create(QueryDatabase.create(target.os), rootPath: rootPath, target: target, stdlibDir: stdlibDir, runtimeDir: runtimeDir, debugStream: debugStream, session: session)
end 'createProject'

// Asking a `whileCurrent` interest is a round trip to the stdout writer's service, and the checkpoints
// are far denser than a lapse needs noticing.
let CompileInterestPollMs = 50 as DurationMs

export union CompileInterest
	always
	whileCurrent(writer LspStdoutWriter.handle, uri String, version LspDocumentVersion)

	export function stillWanted() returns bool
		match self 'interest'
			always then return true
			whileCurrent(writer, uri, version) then return try await writer.isCurrent(uri.clone(), version: version) otherwise false
		end 'interest'
	end 'stillWanted'
end 'CompileInterest'

export type CompileSession
	export var diagnostics as DiagnosticSink
	export var fileMemos as SharedFileMemoMap
	export var treeLock as LockHold
	var interest as CompileInterest
	var interestAskedMs as InstantMs
	var abandoned as bool

	export static function create(diagnostics DiagnosticSink, fileMemos SharedFileMemoMap, treeLock LockHold) returns CompileSession
		return Self{diagnostics: diagnostics, fileMemos: fileMemos, treeLock: treeLock, interest: CompileInterest.always, interestAskedMs: Clock.nowMs(), abandoned: false}
	end 'create'

	export static function printing() returns CompileSession
		return Self.create(DiagnosticSink.printing(), fileMemos: SharedFileMemoMap.forOneCompile(), treeLock: LockHold.none())
	end 'printing'

	// For a check whose memo counters assume every memo lives in this process (`verify-warm-rebuild`).
	export static function printingWithoutLibraryCache() returns CompileSession
		return Self.create(DiagnosticSink.printing(), fileMemos: SharedFileMemoMap.withoutLibraryCache(), treeLock: LockHold.none())
	end 'printingWithoutLibraryCache'

	export static function discarding() returns CompileSession
		return Self.create(DiagnosticSink.discarding(), fileMemos: SharedFileMemoMap.create(), treeLock: LockHold.none())
	end 'discarding'

	// `always` answers before any clock is read: checkpoints sit in per-function loops, and a build must
	// not pay for them.
	export function stillWanted() returns bool
		match self.interest 'interest'
			always then return true
			whileCurrent then return self.polledStillWanted()
		end 'interest'
	end 'stillWanted'

	function polledStillWanted() returns bool
		if self.abandoned 'abandonedAlready'
			return false
		end 'abandonedAlready'

		if Clock.elapsedMs(self.interestAskedMs) < CompileInterestPollMs 'askedRecently'
			return true
		end 'askedRecently'

		self.interestAskedMs = Clock.nowMs()
		self.abandoned = not self.interest.stillWanted()

		return not self.abandoned
	end 'polledStillWanted'

	export function wantedBy(asker CompileInterest)
		self.interest = asker
		self.abandoned = false
		self.interestAskedMs = Clock.nowMs()
	end 'wantedBy'
end 'CompileSession'

// Every call sits ahead of the work it guards, never between a stage and the memo that keeps it:
// `lowerTheProgram` asks before `invalidateAllModuleCache`, so an abandoned check leaves the merged
// module for the next one.
export function requireStillWanted(project Project) throws CompileError
	if project.session.stillWanted() 'wanted'
		return
	end 'wanted'

	throw CompileError.abandoned
end 'requireStillWanted'

// Is the project root itself under a library tier, as in `maxon build stdlib/URL.maxon`? Asked in
// this one place because four rules turn on it:
//
//   * `StdlibLoader.setAsideTheUsersOwnLibraryFiles` — the library walk does not load the
//     project's own files a second time.
//   * `Queries.isStdlibRootFile` — such a project keeps its own files as the user's, so only what
//     the loader pulled in from outside the root is stdlib for visibility.
//   * `Queries.livesUnderStdlibDirectory` — for the two `module`-visible `String` methods those
//     same files are under `stdlib/`, a fact about the path and not about visibility.
//   * `Compiler.loadProject` — a project rooted under `runtime/` is refused.
//
// ⚠ The third rule's soundness is a claim about the second: `livesUnderStdlibDirectory` is
// `isStdlibSource OR rootIsUnderStdlibDirectory`, and the two differ exactly when this predicate
// holds for `stdlib/`. A second spelling taught about symlinks, case or a trailing separator would
// leave that proof reading as if it held while the stdlib-only gate refused `stdlib/URL.maxon`, or
// opened for a user file.
//
// `cwd` is passed in because the per-file provenance derivation already holds it, and a second
// `Directory.currentPath()` would sit on that per-file path. Resolving is not optional: `isInside`
// compares spellings, so a relative and an absolute spelling of one root would answer differently.
export function rootIsUnder(project Project, libraryRoot FilePath, cwd FilePath) returns bool
	return project.rootPath.resolve(cwd).isInside(libraryRoot)
end 'rootIsUnder'

// Append a diagnostic to the project's sink. The single funnel every reporting
// pass routes through, so diagnostic bookkeeping lives in one place — which is
// why the library-blame swap (`Diagnostic.blamedAt`) and the staged-source path
// rewrite (`Diagnostic.reportedUnder`) are both applied HERE and not at each of
// the parse mappers, semantic checks and conformance checks that report.
//
// ⭐ **IT IS THE ONLY DOOR INTO `project.diagnostics`, and the lists that look
// like a second one are not.** `ParseStaging.commitDiagnostics` folds the
// parser's own into this function; `Compiler.reportBindingHygieneDiagnostics`
// drains the hygiene list through it as well; and the deferred name diagnostics
// reach it via `TypeResolution.reportDeferredNameDiagnostics` calling
// `reportPositioned`.
//
// ⛔ **BUT IT IS NOT EVERY LINE THIS COMPILER PRINTS, AND THE EXCEPTION CARRIES
// PATHS.** The `CompileError` arms other than `compileError` never become
// a `Diagnostic` at all: `Main.reportCompileError` writes them straight to
// the caller's `DiagnosticSink`, whose own header owns that argument. They therefore
// bypass BOTH rules stated here, so a staged path in one of them is still
// printed as the staged path. Nothing has been measured reaching that state
// under `maxon test`; it is written down because a rule stated at a funnel
// invites the assumption that the funnel is total.
export function reportDiagnostic(project Project, diagnostic Diagnostic)
	// AFTER the blame swap, never before: `blamedAt` moves one location into the note and promotes
	// another into the primary slot, so a rewrite applied first would leave whichever path it moved
	// still spelled as the staged copy.
	project.diagnostics.push(respelledForItsReaders(project, diagnostic: diagnostic.blamedAt(project.libraryBlame)).reportedUnder(project.stagedSourceOrigins))
end 'reportDiagnostic'

// A library declaration an author's name shadows is renamed
// (`ProgramSignatures.contestStdlibTypeName`), so every diagnostic is respelled for the reader of
// each file it names, and an author never sees the rename.
function respelledForItsReaders(project Project, diagnostic Diagnostic) returns Diagnostic
	if project.stdlibShadowSpellings.isEmpty() 'nothingIsRenamed'
		return diagnostic
	end 'nothingIsRenamed'

	return diagnostic.respelledFor(authorCodeRespellings(project.stdlibShadowSpellings), respellingsOf: function(path) gives shadowRespellingsFor(project, path: path))
end 'respelledForItsReaders'

function shadowRespellingsFor(project Project, path FilePath) returns ShadowRespellingArray
	let entry = try sourceEntryOf(project, path: path) otherwise return shadowRespellingsGiven(project, path: path, written: WrittenMintSet.create())

	if let memo = try project.shadowRespellingMemos.get(path.toString()) 'memoized'
		if memo.contentHash == entry.contentHash 'currentForThisContent'
			return memo.respellings
		end 'currentForThisContent'
	end 'memoized'

	let spellings = try reservedSpellingsOf(project, path: path, entry: entry) otherwise return shadowRespellingsGiven(project, path: path, written: WrittenMintSet.create())
	var written = WrittenMintSet.create()

	for spelling in spellings 'eachSpelling'
		if project.shadowMints.contains(spelling) 'theAuthorWroteAMint'
			written.insert(spelling)
		end 'theAuthorWroteAMint'
	end 'eachSpelling'

	let respellings = shadowRespellingsGiven(project, path: path, written: written)
	project.shadowRespellingMemos.upsert(path.toString(), value: ShadowRespellingMemo.create(entry.contentHash, respellings: respellings))
	return respellings
end 'shadowRespellingsFor'

function shadowRespellingsGiven(project Project, path FilePath, written WrittenMintSet) returns ShadowRespellingArray
	return shadowRespellings(project.stdlibShadowSpellings, reader: shadowSpellingReaderOf(project, path: path), written: written)
end 'shadowRespellingsGiven'

module function textAsItsReaderSpellsIt(project Project, path FilePath, text String) returns String
	if project.stdlibShadowSpellings.isEmpty() 'nothingIsRenamed'
		return text
	end 'nothingIsRenamed'

	return respelledText(text, respellings: shadowRespellingsFor(project, path: path))
end 'textAsItsReaderSpellsIt'

module function aliasSpelledForReader(project Project, alias RangedTypeAlias, readerFilePath FilePath) returns String
	let base = aliasBaseName(alias.name)
	let signatures = programSignaturesIn(project, asker: "aliasSpelledForReader")

	if isMintName(alias.name) 'aMintNamesItsDeclaration'
		return signatures.contestedDeclarationSpelling(base, declFilePath: alias.declFilePath)
	end 'aMintNamesItsDeclaration'

	if base.equals(sourceSpelledAliasName(alias.name)) or not signatures.declaredInTheStdlib(alias.declFilePath) or signatures.declaredInTheStdlib(readerFilePath) 'theBareNameIsTheReadersSpelling'
		return String.from(base)
	end 'theBareNameIsTheReadersSpelling'

	return String.from(namespaceQualifiedName(StdlibDirName, name: base))
end 'aliasSpelledForReader'

module function shadowSpellingReaderOf(project Project, path FilePath) returns ShadowSpellingReader
	return ShadowSpellingReader.libraryCode if not path.isEmpty() and isStdlibSourceFile(project, path: path) else ShadowSpellingReader.authorCode
end 'shadowSpellingReaderOf'

export function adoptShadowSpellings(project Project, spellings StdlibShadowSpellingArray)
	var mints = WrittenMintSet.create()

	for spelling in spellings 'eachSpelling'
		mints.insert(spelling.minted)
	end 'eachSpelling'

	project.stdlibShadowSpellings = spellings
	project.shadowMints = mints
	project.shadowRespellingMemos = ShadowRespellingMemoMap.create()
end 'adoptShadowSpellings'

type ShadowRespellingMemo
	export let contentHash as HashDigest
	export let respellings as ShadowRespellingArray

	static function create(contentHash HashDigest, respellings ShadowRespellingArray) returns ShadowRespellingMemo
		return Self{contentHash: contentHash, respellings: respellings}
	end 'create'
end 'ShadowRespellingMemo'

typealias ShadowRespellingMemoMap = Map with (String, ShadowRespellingMemo)

export function authoredFileOf(project Project, func IrFunction, opIndex ElementIndex) returns FilePath
	return try project.synthesizedOpFiles.get(opIndex) otherwise func.sourceFilePath
end 'authoredFileOf'

// True once any diagnostic has been reported. The pipeline's error gate reads
// this after each pass to stop before lowering an invalid module.
export function projectHasErrors(project Project) returns bool
	return project.diagnostics.count() > 0
end 'projectHasErrors'

// Render every accumulated diagnostic, one per line, in report order. The driver calls this on the
// failure path so the exact `error EXXXX: ...` lines the spec compares against reach the user.
//
// ⚠ It writes through the session's `DiagnosticSink` rather than to stderr directly, which is what
// lets a caller compiling IN PROCESS read the same bytes a subprocess would have printed — see that
// type, which owns the argument. There is no second route: the line ending is decided there too.
export function printDiagnostics(project Project)
	var sink = project.session.diagnostics

	for diagnostic in distinctDiagnostics(project.diagnostics) 'each'
		sink.emit(diagnostic.render())
	end 'each'
end 'printDiagnostics'

typealias DiagnosticIdentitySet = Set with String

module function distinctDiagnostics(diagnostics DiagnosticArray) returns DiagnosticArray
	var seen = DiagnosticIdentitySet.create()
	var distinct = DiagnosticArray.create()

	for diagnostic in diagnostics 'each'
		let identity = diagnostic.identityText()

		if seen.contains(identity) 'reportedAlready'
			continue
		end 'reportedAlready'

		seen.insert(identity)
		distinct.push(diagnostic)
	end 'each'

	return distinct
end 'distinctDiagnostics'
