	export var value as ValueId
	export var target as RangeCheckSiteTarget
	export var block as BlockId
	export var maxonOpPos as ElementIndex
	export var stdOpPos as ElementIndex
	export var line as LineNumber
	export var column as ColumnNumber

	// `stdOpPos` is not a parameter: it is the LOWERING's to write, and the parser has no way to know it.
	export static function create(value ValueId, target RangeCheckSiteTarget, block BlockId, maxonOpPos ElementIndex, line LineNumber, column ColumnNumber) returns RangeCheckSite
