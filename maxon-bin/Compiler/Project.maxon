// Project.maxon — foundational compiler-wide types.

// Array alias over `bool`. Cross-cutting; used by the IR containers (BoolArray
// for the compaction liveness bitmaps).
export typealias BoolArray = Array with bool

// @generated library-cache begin
module function cacheWriteBoolArray(writer LibraryCacheWriter, value BoolArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		writer.flag(item)
	end 'eachItem'
end 'cacheWriteBoolArray'

module function cacheReadBoolArray(reader LibraryCacheReader) returns BoolArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = BoolArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try reader.flag()
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadBoolArray'

// @generated library-cache end

// Visibility tier of a top-level declaration. Stamped by the parser at
// declaration time; consumed by cross-file name resolution and the unused-export
// check. `file` is the default (positively widened to `module`/`global`).
//
// ⭐ **FOUR TIERS, AND THE MODIFIER THAT SELECTS EACH (`specs/module-keyword.md`,
// `specs/public-keyword.md`):**
//   • `file`   — no modifier. Visible only inside the declaring FILE.
//   • `module` — the `module` modifier. Visible to every file in the declaring file's DIRECTORY and
//                in every subdirectory of it — i.e. every file whose NAMESPACE is the declaring
//                file's namespace or a descendant of it.
//   • `global` — the `export` modifier. Visible everywhere.
//   • `public` — the `public` modifier. Visible everywhere, EXACTLY as `global` is.
// The three modifiers are mutually exclusive (E2001, `Parser.consumeOptionalVisibility`).
//
// ⭐⭐ **`global` AND `public` ARE THE SAME VISIBILITY AND A DIFFERENT CLAIM, WHICH IS WHY THEY ARE
// TWO CASES AND NOT ONE.** `visibleThroughModuleDirectories` answers `true` for both and always
// will; anything that asks *"can this file name that symbol?"* must treat them as identical, and a
// reader that distinguishes them there is a bug. The ONE question they answer differently is the
// unused-export family's:
//   • `export` — other files may see this, **and I expect this program to use it**. Linted: if nothing
//     outside the declaring file references it, that is E3092, and it is a real finding.
//   • `public` — this is **API surface**. Exempt from E3092/E3093, because "no caller in THIS
//     compilation" is not the same fact as "dead" — it could be a shared module an app happens not to
//     use. `public` lets the author say which of the two things they meant.
//
// ⚠ **THERE IS DELIBERATELY NO `module public`.** E3094 (an unused `module` decl) keeps its full force; a
// `module` declaration that wants exemption is PROMOTED to `public`, which changes its visibility and
// says so. A tier and an exemption flag would be two axes, and every reader would then have to know it
// must ask about both — the `public` case exists precisely so there is one axis to ask about.
//
// ⚠ **THE TIERS FEED THE INCREMENTAL-BUILD CONTENT HASH** (`tierOrdinal`, `mixDeclaration`), so a
// tier's number is never reused for another: a renumbering silently serves every cached signature
// under a name that still looks current.
//
// ⚠ **EACH CASE MEANS WHAT ITS NAME SAYS, AND THE ONE PLACE A TIER IS TURNED INTO AN ANSWER IS
// `visibleThroughModuleDirectories`** — never a reader's own `!= Visibility.file`.
//
// ⚠ **A FIELD'S `file` TIER MEANS ITS DECLARING TYPE, NOT ITS DECLARING FILE**, and that asymmetry
// is measured rather than chosen — see `Parser.requireFieldAccessible`, whose gate is the TYPE.
export enum Visibility
	file
	module
	global
	public
end 'Visibility'

// @generated library-cache begin
let CacheCasesVisibility = [Visibility.file, Visibility.module, Visibility.global, Visibility.public]

module function cacheReadVisibility(reader LibraryCacheReader) returns Visibility throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesVisibility.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadVisibility'

function cacheTableAgreesVisibility() returns bool
	let declared = Visibility.allCases

	if CacheCasesVisibility.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesVisibility.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesVisibility'

// @generated library-cache end

// ⭐ **"IS THIS DECLARATION VISIBLE OUTSIDE ITS DECLARING FILE'S SUBTREE?" — ASKED ONCE.** `global` and
// `public` are the same visibility (see the header above), so every reader that cares about REACH rather
// than about the unused-export claim asks here instead of spelling `== global or == public`. That
// disjunction written out at N sites is a set written down N times, and the N+1th tier reaches N-1 of them.
// ⚠ `module`, not file-private: the message-roster test asks it from
// `Parser.recordScannedSignature`, which is the whole point of the function — the disjunction
// written out at a second site is the set written down twice.
module function isProgramWideTier(visibility Visibility) returns bool
	return visibility == Visibility.global or visibility == Visibility.public
end 'isProgramWideTier'

// The three WORDS that select a tier — the source-level surface of `Visibility`, which the tier enum
// itself cannot carry because `file` has no word and `global` is not spelled "global".
//
// ⚠ **DECLARATION ORDER IS THE ORDER A COMBINED-MODIFIER DIAGNOSTIC NAMES THEM**, and it is NOT encounter
// order. `'export' and 'module' cannot be combined` is pinned byte-for-byte by six live cases, so
// `module export` has to render the same sentence as `export module`. `Parser.refuseSecondVisibilityModifier`
// sorts the pair by `.ordinal` before throwing, which is the only reason this order is load-bearing.
//
// Cases are prefixed `word` because the unprefixed spellings are keywords.
export enum VisibilityModifierWord
	wordExport
	wordModule
	wordPublic
end 'VisibilityModifierWord'

// The quoted spelling a diagnostic prints. The words themselves are reserved in `Lexer.KeywordTable`
// (`export`, `public`) and in `Parser.ModuleModifierName` (`module`, which is contextual and so has no
// keyword entry) — two different mechanisms, which is why the display spelling is written here once
// rather than derived from whichever of them happens to hold a given word.
export function visibilityModifierSpelling(word VisibilityModifierWord) returns String
	match word 'word'
		wordExport then return "'export'"
		wordModule then return "'module'"
		wordPublic then return "'public'"
	end 'word'
end 'visibilityModifierSpelling'

export union SpelledFieldName
	named(name ByteArray)
	unnamed
end 'SpelledFieldName'

// @generated library-cache begin
function cacheWriteSpelledFieldName(writer LibraryCacheWriter, value SpelledFieldName)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		named(a0) then cacheWriteSpelledFieldNameNamed(writer, a0: a0)
		unnamed then break 'payload'
	end 'payload'
end 'cacheWriteSpelledFieldName'

function cacheWriteSpelledFieldNameNamed(writer LibraryCacheWriter, a0 ByteArray)
	writer.bytes(a0)
end 'cacheWriteSpelledFieldNameNamed'

function cacheReadSpelledFieldName(reader LibraryCacheReader) returns SpelledFieldName throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives try cacheReadSpelledFieldNameNamed(reader)
		1 gives SpelledFieldName.unnamed
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadSpelledFieldName'

function cacheReadSpelledFieldNameNamed(reader LibraryCacheReader) returns SpelledFieldName throws LibraryCacheDamage
	let a0 = try reader.bytes()

	return SpelledFieldName.named(a0)
end 'cacheReadSpelledFieldNameNamed'

// @generated library-cache end

export typealias SpelledFieldNameArray = Array with SpelledFieldName

// @generated library-cache begin
function cacheWriteSpelledFieldNameArray(writer LibraryCacheWriter, value SpelledFieldNameArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		cacheWriteSpelledFieldName(writer, value: item)
	end 'eachItem'
end 'cacheWriteSpelledFieldNameArray'

function cacheReadSpelledFieldNameArray(reader LibraryCacheReader) returns SpelledFieldNameArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = SpelledFieldNameArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try cacheReadSpelledFieldName(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadSpelledFieldNameArray'

// @generated library-cache end

// ⭐⭐ **WHAT JOINS A MODULE DIRECTORY'S SEGMENTS — AND IT IS `/`, NOT `.`, BECAUSE THE JOIN HAS TO BE
// INVERTIBLE.** `moduleDirectoryContains` is a SEGMENT test, and a segment test on a joined string is
// only sound if no segment can contain the joiner.
//
// ⚠ **`.` WOULD BE A WRONG ANSWER: A DIRECTORY NAME MAY CONTAIN ONE** on every host the compiler
// targets — this very repository holds `.maxon/` and `.claude/`. Two failures would follow, both
// silent:
//
//   • `feature/` and `feature.extra/` are SIBLINGS. Joined with `.` the second reads as `feature.extra`,
//     which starts with `feature.` — so a `module` declaration in `feature/` would be visible from
//     `feature.extra/`, the exact widening the separator guard exists to prevent.
//   • `my.dir/` and `my/dir/` would both join to `my.dir`, so two structurally different
//     directories would become ONE module and each could see the other's `module` declarations.
//
// `/` cannot appear in a path SEGMENT on any host the compiler targets: it is the separator itself on
// Linux, macOS and WASI, and on Windows it is both an accepted separator and one of the characters a
// file or directory name may not contain. So the join is injective and the segment test is sound. The
// `.`-joined spelling the language shows a user is DERIVED from this one
// (`namespaceForModuleDirectory`) and is never what a visibility question is asked on.
let ModuleDirectorySeparator = "/"

// The one spelling that has to be rewritten: `FilePath` normalizes to the PLATFORM separator on
// construction, so a Windows host hands back `feature\sub` where a POSIX host hands back `feature/sub`,
// and a spec fixture's `// --- file: feature/sub/deep.maxon` must derive the same module directory on
// either. `/` needs no rewrite because it IS the joined form.
let WindowsPathSeparatorText = "\\"

// What joins a NAMESPACE's segments — the spelling `specs/namespaces.md` gives (`stdlib.fmt`) and the one
// a qualified reference will be written with. It is a RENDERING of a module directory and nothing reads a
// visibility answer off it; see `ModuleDirectorySeparator` for why the two cannot be the same character.
let NamespaceSeparator = "."

// ⭐ **A FILE'S MODULE DIRECTORY IS ITS DIRECTORY, RELATIVE TO ITS COMPILE ANCHOR, `/`-JOINED** —
// `math.maxon` at root ⇒ `""`, `utils/helpers.maxon` ⇒ `utils`, `stdlib/fmt/integer.maxon` ⇒ `stdlib/fmt`.
// It is the string every `Visibility.module` question is decided on.
//
// The `notUnderRoot` fallback: a file outside its declared anchor falls back to its immediate
// parent's NAME, so a misconfigured anchor can never produce a `..` segment. `namespaceAnchorFor`
// gives stdlib its own anchor, so the arm covers only a genuinely misconfigured caller.
//
// ⚠ **THE ANCHOR IS THE ARGUMENT, AND GETTING IT WRONG IS SILENT** — every file would get a plausible
// module directory and the wrong one. `Queries.namespaceAnchorFor` is its single producer, and states the
// three anchors it derives.
export function deriveModuleDirectory(filePath FilePath, rootPath FilePath) returns String
	let relative = try filePath.relativeTo(rootPath) otherwise 'notUnderRoot'
		let parent = try filePath.parent() otherwise panic("deriveModuleDirectory: '{filePath.toString()}' names no directory it sits in — a source file is always read out of one")
		return parent.filename()
	end 'notUnderRoot'

	// No separator left in the relative path ⇒ the file sits AT the anchor, which is the root module.
	let directory = try relative.parent() otherwise return ""
	return directory.toString().replace(WindowsPathSeparatorText, with: ModuleDirectorySeparator)
end 'deriveModuleDirectory'

// The `.`-joined NAMESPACE a module directory is shown as — `stdlib/fmt` ⇒ `stdlib.fmt`. Derived from the
// directory rather than stored beside it, so the two cannot come to disagree: the directory is the fact
// (it is invertible), and this is one rendering of it.
export function namespaceForModuleDirectory(moduleDirectory String) returns String
	if moduleDirectory.isEmpty() 'rootModule'
		return ""
	end 'rootModule'

	return moduleDirectory.replace(ModuleDirectorySeparator, with: NamespaceSeparator)
end 'namespaceForModuleDirectory'

export let RootNamespaceQualifier = "export"

export function qualifierForNamespace(namespace String) returns String
	return RootNamespaceQualifier if namespace.isEmpty() else namespace
end 'qualifierForNamespace'

// ⭐⭐ **ONE `--define <name>=<value>`: A TOP-LEVEL `String` CONSTANT'S VALUE, SUPPLIED BY WHOEVER RAN
// THE BUILD.** The version a compiler reports is the reason this exists. It cannot be a file the build
// GENERATES, because generating it needs a compiler and the compiler cannot be built without it — so
// the value arrives beside the sources rather than among them, and a fresh clone compiles with the
// default the declaration already carries.
//
// ⚠ **THE NAME IS AN EXISTING DECLARATION'S, AND `--define` MINTS NOTHING.** It is matched against
// both the bare name and the namespace-qualified one, so `CompilerVersion` and `Compiler.CompilerVersion`
// reach the same `let`. A name matching NO declaration is refused, and so is one matching TWO — a
// namespace is a DIRECTORY, so qualifying is not by itself uniqueness, and silently picking one of two
// would bake a version into a binary nobody chose.
export type Define
	export let name as String
	export let value as String

	export static function create(name String, value String) returns Define
		return Self{name: name, value: value}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.text(self.name)
		writer.text(self.value)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns Define throws LibraryCacheDamage
		let f_name = try reader.text()
		let f_value = try reader.text()

		return Self{name: f_name, value: f_value}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(Define) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'Define'

export typealias DefineArray = Array with Define

// @generated library-cache begin
module function cacheWriteDefineArray(writer LibraryCacheWriter, value DefineArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteDefineArray'

module function cacheReadDefineArray(reader LibraryCacheReader) returns DefineArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = DefineArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try Define.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadDefineArray'

// @generated library-cache end

// One reason a `--define` could not be honoured, carrying the wording as well as the code: the facts a
// message needs — which declarations a name reached, and where they are — are known only where the
// resolution happens, and a caller handed a code alone could only re-derive them.
export type DefineProblem
	export let code as ErrorCode
	export let message as String

	export static function create(code ErrorCode, message String) returns DefineProblem
		return Self{code: code, message: message}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.code.ordinal as CacheUnsigned)
		writer.text(self.message)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns DefineProblem throws LibraryCacheDamage
		let f_code = try cacheReadErrorCode(reader)
		let f_message = try reader.text()

		return Self{code: f_code, message: f_message}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(DefineProblem) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'DefineProblem'

export typealias DefineProblemArray = Array with DefineProblem

// @generated library-cache begin
module function cacheWriteDefineProblemArray(writer LibraryCacheWriter, value DefineProblemArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteDefineProblemArray'

module function cacheReadDefineProblemArray(reader LibraryCacheReader) returns DefineProblemArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = DefineProblemArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try DefineProblem.cacheRead(reader)
		result.push(item)
