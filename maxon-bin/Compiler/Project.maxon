// @generated library-cache end

// ⭐ **IS `inner` THE SAME MODULE AS `outer`, OR ONE BENEATH IT?** — the whole of what `Visibility.module`
// means, asked on module directories rather than on `FilePath`s.
//
// ⚠ **THE SEPARATOR IN THE PREFIX IS THE POINT**: without it `feature` would contain `featureX`, a
// sibling directory that merely shares a character prefix. It is asked of a `/`-joined RELATIVE
// directory, derived ONCE PER FILE and indexed, rather than of a stringified parent `FilePath`
// recomputed on both sides of every ask. `ModuleDirectorySeparator` is what keeps the guard sound.
//
// The empty module directory is the ROOT, and every file in the program is under the root — so a
// `module` declaration in a root-level file is visible program-wide, which is what "same directory and
// every subdirectory" says when the directory is the root.
export function moduleDirectoryContains(outer String, inner String) returns bool
	if outer.isEmpty() 'rootIsEveryFilesModule'
		return true
	end 'rootIsEveryFilesModule'

	if inner.equals(outer) 'sameDirectory'
		return true
	end 'sameDirectory'

	return inner.startsWith("{outer}{ModuleDirectorySeparator}")
end 'moduleDirectoryContains'

module enum CandidateReach
	hidden
	library
	author
end 'CandidateReach'

module enum MeaningsReached
	none
	theLibrarys
	oneAuthors
	several
end 'MeaningsReached'

module function meaningsAfter(sofar MeaningsReached, reach CandidateReach) returns MeaningsReached
	match reach 'reach'
		hidden then return sofar
		library then return libraryMeaningAfter(sofar)
		author then return authorMeaningAfter(sofar)
	end 'reach'
end 'meaningsAfter'

function libraryMeaningAfter(sofar MeaningsReached) returns MeaningsReached
	match sofar 'sofar'
		none or
			theLibrarys then return MeaningsReached.theLibrarys
		oneAuthors then return MeaningsReached.oneAuthors
		several then return MeaningsReached.several
	end 'sofar'
end 'libraryMeaningAfter'

function authorMeaningAfter(sofar MeaningsReached) returns MeaningsReached
	match sofar 'sofar'
		none or
			theLibrarys then return MeaningsReached.oneAuthors
		oneAuthors or
			several then return MeaningsReached.several
	end 'sofar'
end 'authorMeaningAfter'

module function severalMeanings(reached MeaningsReached) returns bool
	match reached 'reached'
		several then return true
		none or
			theLibrarys or
			oneAuthors then return false
	end 'reached'
end 'severalMeanings'

// ⭐ **ONE E3063 CANDIDATE, AS THE USER WOULD HAVE TO WRITE IT** — `api.Score`, `lib.fmt.Score`,
// `export.Score`.
//
// ⚠ **E3095 DOES NOT USE THIS, and the asymmetry is the shapes' asymmetry.** A contested FUNCTION already
// carries its qualified spelling as its registration NAME (`ProgramSignatures.contestedFreeFunctions`), so
// its candidate list is read off the index; a contested ALIAS is filed under its bare name and the qualified
// form has to be RENDERED from the declaring file's directory. Handing the function side this renderer would
// have it re-derive a string it is already holding, and the two could then disagree.
//
// ⚠ **THE LAST JOIN GOES THROUGH `joinQualifiedName`, AND THE CONSTANT IT DOES *NOT* USE IS THE
// POINT.** `NamespaceSeparator` is the byte a module DIRECTORY renders its own internal separators
// as (`namespaceForModuleDirectory`); `QualifiedAliasSeparator`, inside `joinQualifiedName`, is the
// byte that divides a namespace from the NAME it qualifies — the one `splitQualifiedName` inverts
// and the one a registry key actually carries. `namespaceQualifiedName` states that split and
// routes the last join the same way. Spelled here with the directory's constant instead, this
// renders a candidate the moment those two ever differ that no user could act on: the message would
// offer `api:Score` while the key that resolves is `api.Score` — a diagnostic whose whole content
// is a fix, prescribing one that does not work.
//
// The root's `export` qualifier is substituted BEFORE the join, so the root's candidate is a
// spelling that resolves.
export function qualifiedCandidateName(moduleDirectory String, bare ByteArray) returns String
	return String.from(joinQualifiedName(qualifierForNamespace(namespaceForModuleDirectory(moduleDirectory)).toByteArray(), member: bare))
end 'qualifiedCandidateName'

// ⭐⭐ **CANDIDATES ARE RENDERED IN LEXICOGRAPHIC ORDER, AND THE SORT IS DELIBERATE.**
//
// ⚠ **AN UNORDERED LIST WOULD NOT BE STABLE: `Map` is OPEN-ADDRESSED, so iteration is SLOT order —
// a function of the hashes of two file paths.** An unsorted list would therefore reorder itself
// when a directory is renamed, when the table grows, or on a host whose paths hash differently, and
// the message is pinned. A diagnostic a user reads twice must read the same way twice;
// sorting is the cheapest property that makes that true of a set the compiler discovered in an
// arbitrary order.
//
// ⭐⭐ **AND THE LIST IS A SET: AN EXACT DUPLICATE IS DROPPED, WHICH IS A CORRECTNESS RULE AND NOT A TIDY-UP.**
// Two declarations can render the SAME candidate: for E3095, a name contested across directories that is
// ALSO declared twice inside one of them files that directory's spelling once per declaration, and whether
// both copies reach the list depends on the order the two files were swept in, which is the filesystem's.
//
// Insertion sort into an array of at most a handful of entries, on a path that has already decided to fail
// the build — so the `toByteArray()` per comparison is paid only by a program that is about to be
// rejected, and never by one that compiles.
export function insertCandidateName(candidates StringArray, candidate String)
	var at = 0 as ElementIndex

	while at < candidates.count() and stringBytesPrecede(try candidates.get(at) otherwise panic("insertCandidateName: get OOB at {at} inside its own count()"), later: candidate) 'findPosition'
		at = at + 1
	end 'findPosition'

	if at < candidates.count() and (try candidates.get(at) otherwise panic("insertCandidateName: get OOB at {at} inside its own count()")).equals(candidate) 'alreadyOffered'
		return
	end 'alreadyOffered'

	candidates.insert(at, value: candidate)
end 'insertCandidateName'

// ⭐ **BYTE-WISE `<` OVER TWO STRINGS — the compiler's ONE lexicographic order.** `String` declares no
// `Comparable` conformance and the byte door that would avoid these two conversions (`String.byteAt`) is
// `module`-scoped inside `stdlib/`, so the comparison is made on the byte arrays.
//
// ⚠ The per-comparison `toByteArray()` is affordable only because every reader is rare.
// `insertCandidateName` orders an ambiguity message's candidates and
// `TypeCycleCheck.typeDeclEarlier` breaks the cross-file tie between two cyclic declarations, both
// on a build already failing; `foldsLaterThan` breaks a tie between two declarations of one
// type name, on programs that compile. A reader asked once per reference would need a cheaper
// comparison.
export function stringBytesPrecede(earlier String, later String) returns bool
	let a = earlier.toByteArray()
	let b = later.toByteArray()
	var i = 0 as ElementIndex

	while i < a.count() and i < b.count() 'compareByte'
		let left = try a.get(i) otherwise panic("stringBytesPrecede: get OOB at {i} inside its own count()")
		let right = try b.get(i) otherwise panic("stringBytesPrecede: get OOB at {i} inside its own count()")

		if left != right 'decided'
			return left < right
		end 'decided'

		i = i + 1
	end 'compareByte'

	return a.count() < b.count()
end 'stringBytesPrecede'

// Joins the candidate trailer every ambiguity message ends with: the diagnostics say the identical
// sentence about different kinds of declaration.
module let CandidateListSeparator = ", "

module let RenameOwnDeclarationAdvice = "or rename this file's own declaration"

// ⭐ THE ONE EMPTY `StringArray` every UNAMBIGUOUS name answers with — so the common path allocates
// nothing. NEVER mutated: the only writer builds a fresh array.
export let sharedEmptyCandidateNames = StringArray.create()

// A `Visibility` as a small dense number, for the one reader that must MIX a tier into a content hash
// (`ProgramSignatures.recordAlias`) rather than branch on it. Spelled here, beside the enum, so a fourth
// tier is one arm in one place instead of a silently stale literal in a hashing routine.
export function tierOrdinal(visibility Visibility) returns VisibilityTier
	return match visibility 'tier'
		file gives 0
		module gives 1
		global gives 2
		public gives 3
	end 'tier'
end 'tierOrdinal'

export typealias VisibilityTier = int(0 to 3)

// ⚠ **THE ONE READER THAT RANKS `public` ABOVE `global`** — E3167 asks a CLAIM question, not a REACH one,
// so the equivalence `isProgramWideTier` states does not hold here: a `public` signature naming an
// `export` type is refused. Folding this into that predicate makes `public` unenforceable in a signature,
// with nothing to fail.
//
// Written as a match rather than as `tierOrdinal(tier) >= tierOrdinal(floor)` so no ordering is read off
// `tierOrdinal`: those numbers are mixed into the incremental-build hash, and a renumbering made to suit a
// comparison would silently serve every cached signature under a name that still looks current.
export function tierIsAtLeastAsVisible(tier Visibility, floor Visibility) returns bool
	return match floor 'floor'
		file gives true
		module gives tier != Visibility.file
		global gives isProgramWideTier(tier)
		public gives tier == Visibility.public
	end 'floor'
end 'tierIsAtLeastAsVisible'

export function narrowerTier(tier Visibility, other Visibility) returns Visibility
	return other if tierIsAtLeastAsVisible(tier, floor: other) else tier
end 'narrowerTier'

// The word E3167's message calls each tier. Pinned byte-for-byte by `specs/signature-type-visibility.md`,
// so these are not the source-level modifiers and may not be re-spelled as them.
export function visibilityTierWord(tier Visibility) returns String
	return match tier 'word'
		file gives "file-private"
		module gives "module"
		global gives "exported"
		public gives "public"
	end 'word'
end 'visibilityTierWord'

// One `Visibility` per struct field, in declaration order. See `StructLayout.fieldVisibility`.
export typealias VisibilityArray = Array with Visibility

// @generated library-cache begin
function cacheWriteVisibilityArray(writer LibraryCacheWriter, value VisibilityArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		writer.unsigned(item.ordinal as CacheUnsigned)
	end 'eachItem'
end 'cacheWriteVisibilityArray'

function cacheReadVisibilityArray(reader LibraryCacheReader) returns VisibilityArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = VisibilityArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try cacheReadVisibility(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadVisibilityArray'

// @generated library-cache end

// The declaring file of a type NO FILE DECLARES — the compiler-synthesized layouts (`StringIndex`,
// a tuple, `__ManagedFile`, `__ManagedDirectory`, `Ordering`, the builtin error enums).
// Each is `Visibility.global`, so no tier ever reads this path; it is the same "empty path means the
// compiler built it" statement `IrFunction.SourcePosition.synthesized` makes, spelled once for layouts.
//
// ⭐ **IT IS ALSO HOW A READER THAT DECLARES NOTHING ASKS, and that is the same fact rather than a
// second use.** `RangedAliasRegistry.lookup` probes its by-file index with the reader's path, so an
// EMPTY path matches no declaration and is answered by the ranking (`scopedClaimant`) — which is
// exactly the rule a non-declaring file resolves a contested name by. A type the compiler built is
// a reader with no file, so it resolves like one; spelling a second empty path for that would be
// the same value written down twice.
export let CompilerOwnedDeclFilePath = FilePath from ""

export union PayloadBindingSlot
	unbound
	inBox(scrutBox ValueId, offset ByteOffset, storage MaxonType)
end 'PayloadBindingSlot'

// @generated library-cache begin
function cacheWritePayloadBindingSlot(writer LibraryCacheWriter, value PayloadBindingSlot)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		unbound then break 'payload'
		inBox(a0, a1, a2) then cacheWritePayloadBindingSlotInBox(writer, a0: a0, a1: a1, a2: a2)
	end 'payload'
end 'cacheWritePayloadBindingSlot'

function cacheWritePayloadBindingSlotInBox(writer LibraryCacheWriter, a0 ValueId, a1 ByteOffset, a2 MaxonType)
	writer.unsigned(a0 as CacheUnsigned)
	writer.unsigned(a1 as CacheUnsigned)
	cacheWriteMaxonType(writer, value: a2)
end 'cacheWritePayloadBindingSlotInBox'

function cacheReadPayloadBindingSlot(reader LibraryCacheReader) returns PayloadBindingSlot throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives PayloadBindingSlot.unbound
		1 gives try cacheReadPayloadBindingSlotInBox(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadPayloadBindingSlot'

function cacheReadPayloadBindingSlotInBox(reader LibraryCacheReader) returns PayloadBindingSlot throws LibraryCacheDamage
	let a0 = (try reader.unsigned()) as ValueId
	let a1 = (try reader.unsigned()) as ByteOffset
	let a2 = try cacheReadMaxonType(reader)

	return PayloadBindingSlot.inBox(a0, offset: a1, storage: a2)
end 'cacheReadPayloadBindingSlotInBox'

// @generated library-cache end

export typealias DebugLocalSlot = int(0 to u64.max) implements ElementIndex

// Which merge renumbering an artifact walk is: one per walk per `Project`, counting up from 1, so no record a
// parse built starts out marked as rewritten.
export typealias RenumberingEpoch = int(0 to u64.max)

function remappedPayloadSlot(slot PayloadBindingSlot, remap TypeIdRemap) returns PayloadBindingSlot
	return match slot 'slot'
		unbound gives PayloadBindingSlot.unbound
		inBox(scrutBox, offset, storage) gives PayloadBindingSlot.inBox(scrutBox, offset: offset, storage: remapMaxonType(storage, remap: remap))
	end 'slot'
end 'remappedPayloadSlot'

export union CellEpoch
	notACell
	current(epoch ValueId)

	export function epochValue() returns ValueId
		match self 'epoch'
			notACell then panic("CellEpoch.epochValue: asked of a binding that holds no cell — only a cell binding carries an epoch")
			current(epoch) then return epoch
		end 'epoch'
	end 'epochValue'
end 'CellEpoch'

// @generated library-cache begin
function cacheWriteCellEpoch(writer LibraryCacheWriter, value CellEpoch)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		notACell then break 'payload'
		current(a0) then cacheWriteCellEpochCurrent(writer, a0: a0)
	end 'payload'
end 'cacheWriteCellEpoch'

function cacheWriteCellEpochCurrent(writer LibraryCacheWriter, a0 ValueId)
	writer.unsigned(a0 as CacheUnsigned)
end 'cacheWriteCellEpochCurrent'

function cacheReadCellEpoch(reader LibraryCacheReader) returns CellEpoch throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives CellEpoch.notACell
		1 gives try cacheReadCellEpochCurrent(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadCellEpoch'

function cacheReadCellEpochCurrent(reader LibraryCacheReader) returns CellEpoch throws LibraryCacheDamage
	let a0 = (try reader.unsigned()) as ValueId

	return CellEpoch.current(a0)
end 'cacheReadCellEpochCurrent'

// @generated library-cache end

// VarInfo — one entry in a function's `Scope` symbol table.
//
// The parser tracks every local by its source-level `MaxonType`; that type is
// carried to lowerMaxonToStd, which resolves the concrete `StdType` (int vs
// float, width) through the typealias registry after resolution. The parser
// never branches on int-vs-float.
//
export type VarInfo
	// A zero-copy slice of the source, straight off the declaring token — names are
	// KEYS, and ByteArray hashes/compares by content, so no String is ever built for one.
	export var name as ByteArray
	export var varType as MaxonType
	export var mutable as bool
	export var slot as VarSlot

	// The SSA ValueId this binding aliases: a `let`/`var x = <expr>` binds `x` directly to the ValueId
	// its initializer produced, so a reference to `x` resolves to that value at parse time and no `x`
	// op ever enters the IR (`let x = 42; return x` lowers identically to `return 42`). A match-arm
	// PAYLOAD binding aliases the value the arm loaded out of the box. It is 0 and unread for a
	// self-field alias, whose reads and writes go through the receiver instead, and it is the CELL for
	// a cell binding (`isCellBinding`).
	export var boundValue as ValueId

	// ⭐ **THE DEBUG-INFO RECORD THIS BINDING FEEDS**, set for a source `let` / `var`
	// / parameter of a build writing a sidecar and for nothing else. `boundValue` is the CURRENT value and
	// is overwritten in place, so it alone cannot say where a debugger should look: a `var` written in both
	// arms of an `if` and read past the join is three values under one name, and the value the read holds
	// is the one the merge minted rather than the one the declaration produced. `Parser.recordDebugRebind`
	// is what keeps the whole sequence, and this is what tells it which record to keep it in.
	export var debugLocalRecorded = false
	export var debugLocalSlot as DebugLocalSlot = 0

	// ⭐ **THE ONE BIT WAVE C READS (static single-owner MOVES).** Set true when this binding has been
	// MOVED FROM — its owned heap value was transferred to another binding by a `let u = t` / `s = t`
	// whose RHS was a bare reference to it. A moved-from binding STAYS in `ownedBindings` (mid-stack
	// removal would desync the block/loop drop marks — see `reassignBindingValue`/`removeFromOwnedBindings`)
	// but is SKIPPED by `emitScopeDrops` (its value drops via its NEW owner, exactly once) and REJECTED
	// at EVERY use — a bare read, a field read/write through it, a method call on it (E3102 use-after-move,
	// via the one `Parser.requireBindingLive` guard both `parseVariableReference` and `requireStructBase`
	// ask). A FULL reassignment `t = <expr>` revives it (`reassignBindingValue` clears the bit — the
	// binding then owns the new value); a field store `t.x = …` is a USE, not a revive. Always false for a
	// trivial/scalar binding, because only an owned heap value is ever moved.
	export var movedFrom as bool

	// ⭐ **PARTIALLY MOVED (a binding-match that moved a managed payload OUT of this union).** Distinct
	// from `movedFrom` in exactly one respect, and that respect is the whole reason it is a second
	// bit: a `partiallyMoved` union is REJECTED at every use (E3102 — a later `match`/read would deref
	// a nulled slot) via the SAME `requireBindingLive` guard, but it is STILL DROPPED at scope exit
	// (`emitScopeDrops` does NOT skip it). Its box, and any managed fields the match left in place,
	// are freed by its `__destruct_<U>` cascade — the moved-out slots were nulled, so the cascade
	// skips them. `movedFrom` means "another binding owns this value, drop nothing"; `partiallyMoved`
	// means "this binding still owns the box, but its contents may not be read again". Always false
	// for a scalar binding or a union whose match bound no managed payload.
	export var partiallyMoved as bool

	// True when this name is a self-field alias inside an instance method — the bare `width`
	// inside `function area()` of `type Rect`, which means `self.width`.
	//
	// Reads emit loadIndirect through `__self` at the field's offset; writes emit storeIndirect —
	// the SAME two ops `p.x` already rides (there is no `fieldLoad`/`fieldStore` op and there is
	// not going to be one; the memory band is the general pair, per StdDialect). Concretely they
	// ride the same two ROUTINES, `Parser.emitFieldLoad`/`emitFieldStore`, which is the stronger
	// statement and the one that matters: a bare-name access stays visible to E3014's visibility
	// walker, and closure lowering needs no re-route around a hardcoded receiver slot.
	//
	// ⭐ **IT CARRIES THE FIELD'S INDEX, NOT ITS OFFSET**, and that is what keeps the two spellings
	// on one path. The index IS the field's identity (see `FieldIndex`); the offset, the declared
	// type, the mutability and the `export` bit are all DERIVED from `(layout, index)` by the four
	// accessors `p.x` already asks. An offset here would answer only the first of those four, and
	// would answer it a SECOND time — `binding.fieldOffset` beside `layout.offsetOfField(index)`,
	// two numbers for one fact, with the write path left needing the index anyway to reach
	// `fieldMutable`. One number, one lookup, no column to keep in step.
	export var isSelfField as bool
	export var fieldIndex as FieldIndex

	// ⭐ **THIS NAME IS A MATCH-ARM PAYLOAD BINDING, AND A WRITE TO IT GOES BACK INTO THE BOX** — the
	// whole of `specs/mutable-enums.md`. `full(value) then value = 42` on a `var` union rebinds the
	// SSA name AND stores 42 into the scrutinee's heap block, so a later `match` reads the new value.
	//
	// ⭐ **KEYED ON THE SCRUTINEE'S SSA VALUE, NOT ON ITS NAME.** Names are resolved at parse time and
	// `ValueId`s are passed everywhere else, so the box is named by the id the LOAD read from. A name
	// would have to be looked up again in a scope the write may have shadowed, and a scrutinee that
	// has no name at all (a temporary) would need a second answer.
	//
	// ⭐ **THE OFFSET AND THE STORAGE TYPE ARE CARRIED RATHER THAN RE-DERIVED, and that is the opposite
	// of `fieldIndex` above ON PURPOSE.** A self-field alias re-derives from `(layout, index)` because
	// its use site HOLDS the layout; an assignment holds nothing but the binding — reaching a layout
	// would mean re-resolving the union off the box AND re-classifying the slot, i.e. a second
	// derivation of the two numbers the load already committed to. The store must hit exactly the
	// address and width `emitUnionPayloadLoad` read, so they are computed ONCE, at the bind, from the
	// one `PayloadClass` that load classified.
	export var payload as PayloadBindingSlot

	// ⭐ **IS THIS BINDING'S SLOT IN THE BOX CURRENTLY NULL?** True from the moment a MANAGED payload is
	// moved out of an OWNED scrutinee (`Parser.moveOutManagedPayload` nulls the slot) until a write-back
	// refills it. It is what lets the write-back answer the scrutinee's `partiallyMoved` question
	// HONESTLY: a case with two managed payloads of which only one is assigned still has a hole, and
	// clearing the scrutinee's bit there would hand a later match a null slot to dereference.
	export var payloadSlotVacated as bool

	// ⭐ **IS THIS NAME A PARAMETER?** — set only by `Parser.bindParameters`.
	//
	// It exists because `mutable` answers a DIFFERENT question and the two diverge on exactly one
	// binding kind. `mutable` is "may this NAME be rebound?", and a parameter's answer is NO (a
	// reassignment to one is E2013, and `ParametersAreMutable` is false for the loop-phi reason
	// `bindParameters` documents at length). But "may the CONTAINER this name denotes be written?" is
	// a different question, and a parameter's answer is YES: it is a borrowed reference to the
	// caller's record, and `dest.append(src)` inside a helper is ordinary Maxon.
	//
	// **MEASURED against the runnable oracle**: a mutating `String`/`Array`/`Set` method is accepted on a
	// PARAMETER receiver and rejected (E3019) on a `let` LOCAL — including a `let` that merely aliases a
	// field, another local, or THE PARAMETER ITSELF. Read by `Parser.immutableReceiverNameOf`, the one
	// home of that rule; without it every container-mutating helper in the corpus is rejected (measured:
	// 3 `array-append-managed-elements` cases).
	//
	// ⚠ It is deliberately NOT derived from the parameter ValueId convention (`boundValue < paramCount`,
	// `requireReceiverValue`), which looks like the same fact and is not: `let a = p` carries the
	// PARAMETER's ValueId while being a `let`, and `a.push(9)` is still E3019. See
	// `Parser.immutableReceiverNameOf`.
	export var isParameter as bool

	// ⭐ **THE TOKEN OF THIS BINDING'S LAST USE — the NON-LEXICAL half of E3070** (`BorrowCheck`).
	// Written at `Parser.requireBindingLive`, the one chokepoint every USE of a local binding funnels
	// through (a bare read, a field read or write through it, a method call on it), so "was this name
	// read?" is answered exactly once in the parser and never re-derived.
	//
	// ⭐ It lives on the BINDING and not on the borrow record because a borrow is recorded when it is
	// TAKEN and the last use happens later: a name copied onto the record at record time would be a
	// second fact, free to disagree with the binding it describes. A `BorrowRecord` therefore holds
	// the `VarInfo` itself and reads this through it.
	//
	// ⚠ **BOTH WRITERS MOVE IT FORWARD ONLY, AND THAT IS A CORRECTNESS RULE RATHER THAN TIDINESS.**
	// `requireBindingLive` records an ordinary use at the cursor; `attachPendingBorrows` SEEDS it when a
	// borrow is taken — to the activation for a `let`/`var` (so a name never read again is dead the instant
	// it is bound, which is what makes `borrow-checker.md:borrow-nll-allowed` compile) and to the LOOP'S
	// `end` for a `for … in` element, whose liveness is lexical. A writer that moved it BACKWARDS would
	// expire a borrow the program is still holding — a use-after-free with no diagnostic anywhere.
	//
	// Constructed 0, and left 0 for every binding kind no borrow can name, where nothing reads it.
	export var lastUseToken as ElementIndex

	// The last token at which the program itself reads this name — `lastUseToken` without the lexical extent a
	// `for … in` element's borrow is seeded with. A mutable door asks whether an immutable name is READ after it
	// (`StorageProvenance`), and the iteration reading the container is no read of the element's record.
	export var lastReadToken as ElementIndex = 0

	// ⭐ **DOES THIS NAME DENOTE MODULE STORAGE — a top-level `var` — RATHER THAN A BINDING OF THIS
	// FRAME?** True only for the E3070 subject stand-in `Parser.topLevelBorrowSubjectOf` mints.
	//
	// ⚠ **IT IS READ TO SUPPRESS THE `boundValue` TEST, NOT MERELY TO LABEL THE BINDING.** A stand-in
	// has no SSA value at all, so its `boundValue` is 0 — and 0 is `self`'s own parameter id, the very
	// coincidence `receiverOwnerMask`'s ⚠ block records three measured miscompiles from. Without this
	// bit `Parser.receiverStorageMask` would read a global's write as a write of parameter 0's storage
	// and refuse every call that hands that parameter anywhere: a false rejection with no compile error.
	//
	// False for every binding a `Scope` holds, which is every other constructor here.
	export var namesModuleStorage as bool

	// ⭐ **WAS THIS BINDING EVER MENTIONED? — HALF of E3012's evidence** (`Parser.reportUnusedBindings`).
	//
	// ⚠ **THE OTHER HALF IS NAME-SCOPED, AND IT HAS TO BE.** "Referenced" is a fact about the NAME within the
	// enclosing function, not about the individual binding: two sequential `for i` loops are legal
	// when only the SECOND reads `i`. This bit cannot express that (each loop mints its own
	// `VarInfo`), so the parser also keeps
	// `referencedNames`, the per-function list of names a mention has recorded. The two cannot disagree:
	// `Parser.markBindingReferenced` is the SINGLE writer of both, and it appends the name exactly where it
	// flips this bit. This bit is what makes that append once-per-binding rather than once-per-mention.
	//
	// ⚠ **IT IS A SECOND BIT BESIDE `lastUseToken` RATHER THAN THAT FIELD TESTED AGAINST 0, and the two are
	// NOT the same question.** `attachPendingBorrows` SEEDS a last use ahead of any read — to the activation
	// for a `let`/`var`, to the loop's `end` for a `for … in` element — so a binding that is never read can
	// carry a non-zero `lastUseToken`, and E3012 would then wave through exactly the declarations it exists
	// to catch. The forward-only rule that field is written under is a BORROW's lifetime rule; this bit
	// answers "did the source mention it", and only a real mention sets it.
	//
	// ⭐ **THREE DOORS, BECAUSE A NAME CAN BE MENTIONED IN EXACTLY THREE PLACES THE OTHERS CANNOT SEE** — each
	// measured to matter, and all three routed through `Parser.markBindingReferenced` so the bit and the
	// name list are written together or not at all:
	//
	//   • `Parser.requireBindingLive` — every READ inside the declaring function (a bare reference, a field
	//     read or write through it, a method call on it). The chokepoint that already exists for that
	//     question.
	//   • `Parser.emitCaptureRead` — a CLOSURE BODY reading an enclosing binding. It deliberately does not
	//     route through the first (a capture is not subject to the move guard), and without this bit a
	//     parameter read ONLY inside a closure — `function f(x Integer)` whose body is
	//     `let g = function(n Integer) gives n + x` — is a false rejection.
	//   • `Parser.parseAssignment` — a WRITE, `x = 2`. It must not route through the first either: an
	//     assignment REVIVES a moved-from binding, and the guard would refuse it. MEASURED against the
	//     oracle: `var x = 1` alone is E3012 and `var x = 1` + `x = 2` compiles, so a write counts as a
	//     mention. ⚠ It cannot decide a verdict TODAY — the compiler parameters are immutable
	//     (`ParametersAreMutable`), so assigning one is E2013 before this bit is read — but the rule is the
	//     measured one and this is where it lives when `unused-variables.md` brings locals in.
	export var referenced as bool

	// ⭐⭐ **DID THIS BINDING EVER NEED TO BE WRITABLE? — E3077's evidence** (`Parser.reportVarShouldBeLet`).
	//
	// Set at every door that REQUIRES a binding to be writable and lets the program through: the assignment
	// / field-assignment door (`Parser.requireMutableBinding`), the method RECEIVER door (the dispatchers,
	// where a `let` receiver of a mutating method is E3019) and the call-ARGUMENT door (`parseCallArgs`,
	// where a `let` argument to a mutating parameter is E3019). A `var` none of them ever admitted could
	// have been written `let`, which is precisely what E3077 says.
	//
	// ⚠ **A RECEIVER AND AN ARGUMENT ARE MARKED WITHOUT ASKING WHETHER THE CALLEE ACTUALLY WRITES.**
	// Whether a callee mutates its parameter is a WHOLE-PROGRAM fact
	// (`SemanticCheck.checkImmutableArgToMutatingParam` holds it, one phase later); the parser cannot
	// know it at the `end` this diagnostic is decided at. Being stricter here would refuse programs
	// the language admits — `stdlib/` among them, which every program links.
	//
	// ⚠ **IT IS THE DEDUP, NOT THE AUTHORITY.** The verdict is name-scoped for the reason `referenced`'s
	// note gives one door up — a shadowing inner `var x` that IS written must excuse the outer `x` —
	// so `Parser.mutabilityExercisedNames` holds the answer and this bit only keeps the append
	// once-per-binding instead of once-per-mention.
	export var mutabilityExercised as bool

	// ⭐⭐ **THIS NAME LIVES IN A HEAP CELL, NOT IN AN SSA VALUE — the third memory-resident binding
	// kind, beside the self-field alias and the payload binding.**
	//
	// A cell is a `__mm_param_cell` box (`ParameterCell.maxon`) holding the binding's CURRENT value. A
	// read is a `loadIndirect` through `boundValue` and a rebind is a `storeIndirect`, so the name
	// aliases no SSA value at all and `boundValue` holds the CELL rather than the contents — which is
	// why every reader of `boundValue` on this path must test this bit first, exactly as the
	// self-field alias made them test `isSelfField`.
	//
	// ⚠ **THE CELL'S ADDRESS IS `boundValue` AND IS STORED ONCE.** A second copy of it would be kept
	// equal by nothing: every writer of `boundValue` — the loop-phi mint, the merge snapshots' restore
	// — would move one and leave the other, and a frame would write one box and free another. Nothing
	// reaches a cell binding with those writers, which is an invariant of `declareCellLocal`'s keeping
	// it off `mutableVars` and not a property of this record — so the record holds the address once
	// and cannot express the disagreement.
	//
	// ⭐ **A BINDING WANTS ONE BECAUSE ANOTHER FRAME MUST SEE THE WRITES:** it is passed to a parameter
	// some callee REASSIGNS, so the callee is handed the cell and its `x = 99` lands in this frame's
	// cell (`ProgramSignatures.paramIsByRef`).
	//
	// ⚠ **IT IS ALSO WHAT TAKES THE BINDING OUT OF THE PHI-TRACKED CLASS, AND THAT IS LOAD-BEARING RATHER
	// THAN INCIDENTAL.** `assignedBindingsIn` decides a loop's carried vars by scanning tokens for
	// `identifier =`, which cannot see the write a callee performs through a by-reference argument
	// (`bindParameters`' tripwire states the hazard). A cell-resident binding needs no phi: the POINTER is
	// loop-invariant and the value is read out of memory at each use, so the phi the scan cannot mint is one
	// nothing wanted. This is why the design is cells and not a call-site write-back.
	//
	// ⚠ A PARAMETER that is by-reference is cell-resident too, and its cell is the CALLER's — `boundValue` is
	// the incoming parameter value itself. That is the one cell this frame does not own and must not drop.
	export var isCellBinding as bool
	export var cellCrossesByReference as bool

	// A cell binding's `boundValue` never changes, so what a move mark records for it is this epoch,
	// which a store into the cell re-mints and a merge settles (`moveStateValue`).
	export var cellEpoch as CellEpoch = CellEpoch.notACell

	// ⭐ **AN OWNED ENTRY THAT OWNS NOTHING: THE PROMISE TO MATCH A COMBINED ERROR EXACTLY ONCE.** A handler whose
	// caught error may be a boxed member's box leaves the release to the arm of the one `match e` that runs, so
	// `e` rides the owned-binding stack for its move state alone: the match MOVES it, and a second match, a
	// join whose paths disagree, or an exit that reaches it live is refused where a drop would be emitted
	// (`Parser.consumeErrorMatchObligation`). Its `boundValue` is the caught flag, which no drop may touch.
	export var isErrorMatchObligation as bool

	// The brand this binding was DECLARED under — its initial value's brand for a local, the spelled
	// parameter type's for a parameter — which every rebind is checked against and every merge phi wears.
	export var brandId as TypeNameId

	// ⭐ **THE DOORS THIS BINDING WAS HANDED TO WHOLE ON THE CURRENT PATH AND NOT READ SINCE** (`MoveSite`), as the
	// index of their list in the parser's `moveSiteLists` — `NoMoveSiteList` for none. Its next read is the first
	// after each of them, which is where a door that turns out to have moved the binding is observed (E3102).
	// Path-sensitive like `movedFrom`, and carried by `Parser.MoveMark` for the same reason: a door on one branch
	// of an `if` is not before a read on the other. An index rather than the list, so a binding holds no record a
	// parse worker would share.
	export var awaitingMoveReads as ElementIndex = NoMoveSiteList

	// The merge renumbering that last rewrote this binding's type ids (`ParseStaging.renumberArtifact`). One
	// binding is filed in several places, and a name renumbering applied twice moves an id it already moved.
	export var renumberedIn as RenumberingEpoch = 0

	// ⭐⭐ **THE ONE PLACE A `VarInfo` LITERAL IS SPELLED.** Every constructor below names ONLY the fields
	// its binding kind actually differs on; everything else — the whole inert tail, and every per-path bit
	// that starts cleared — comes from a default here.
	//
	// ⚠ **IT IS A DEFENCE, NOT A TIDY-UP.** This record has many constructors, and a field given the
	// WRONG default in ONE spelled-out literal is not a compile error and not a crash — it is a
	// binding that quietly claims to be a parameter in exactly one code path. A new field is one
	// default and one line, and the kinds that care name it.
	//
	// `ownership`, `movedFrom`, `partiallyMoved`, `payloadSlotVacated`, `lastUseToken`, `referenced` and
	// `mutabilityExercised` take no parameter at all: they are per-path STATE the parser writes as it goes,
	// and every binding starts with them clear. A constructor argument for one of them would be a way to
	// start a binding already moved-from, which nothing means.
	//
	// The type is the binding's own copy: a binding rides its body's artifact, and its type is often a record the
	// signature index holds (`ParseStaging.artifactOwnedOp`).
	static function make(name ByteArray, varType MaxonType, mutable bool, slot VarSlot = 0, boundValue ValueId = 0, isSelfField bool = false, fieldIndex FieldIndex = 0, payload PayloadBindingSlot = PayloadBindingSlot.unbound, isParameter bool = false, namesModuleStorage bool = false, isCellBinding bool = false, cellCrossesByReference bool = false, brandId TypeNameId = UnnamedTypeId, isErrorMatchObligation bool = false) returns VarInfo
		return Self{name: name, varType: varType.clone(), mutable: mutable, slot: slot, boundValue: boundValue, movedFrom: false, partiallyMoved: false, isSelfField: isSelfField, fieldIndex: fieldIndex, payload: payload, payloadSlotVacated: false, isParameter: isParameter, lastUseToken: 0, namesModuleStorage: namesModuleStorage, referenced: false, mutabilityExercised: false, isCellBinding: isCellBinding, cellCrossesByReference: cellCrossesByReference, brandId: brandId, isErrorMatchObligation: isErrorMatchObligation}
	end 'make'

