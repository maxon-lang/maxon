// ⭐ **WHICH KIND OF DECLARATION AN E3012 CANDIDATE IS — and the only thing that turns on it is the
// INTERFACE WAIVER.** An implementer is forced to declare every parameter its contract names, so an unused
// PARAMETER of a contract-dictated method is waived; a `for` binding inside that same method is the author's
// own and is still refused: `error E3012: unused variable: 'i'` for an unread
// `for i in 0 upto limit 'l'` inside an interface-dictated `tally`.
export enum UnusedBindingKind
	parameter

	// A `for x in …` element.
	loopVariable

	// ⭐⭐ **A body `var` the author wrote — and a body `let` is DELIBERATELY NOT ONE.**
	//
	// This kind exists because E3077 owes it: `var` locals are that rule's candidate set, and for a
	// candidate nothing mentions the honest sentence is not *"use `let`"* — the fix is to delete it — so it
	// reports E3012 instead. That IS the precedence `specs/var-should-be-let.md:unused-takes-precedence`
	// pins, and it is the whole of why a `var` local is checked here.
	//
	// ✅ **THE UNUSED-`let` HALF LANDED (user ruling, 2026-08-19), and the blocker written here was wrong
	// on BOTH of its claims.** It said admitting body `let`s costs 82 cases in EXPRESSIVENESS, because a
	// leak gate binds an owned value and deliberately never touches it, and because "adding a mention moves
	// the drop, so the test silently stops testing the drop". MEASURED at the IR, both are false:
	//
	//   • **A mention does not move the drop.** For the one shape that HAS a drop — a heap-allocated
	//     managed value, e.g. an interpolated `String` — the IR with `print(s)` added is byte-identical to
	//     the IR without it except for the two inserted instructions of the call. `__str_decref` stays the
	//     last thing in the block, in the same position. Reading a value does not re-home its drop.
	//   • **The named exemplars had no drop to move.** `block-scope-drops.owned-struct-in-block` emits NO
	//     `__mm_alloc` and NO decref at all on the compiler — the struct is a STACK SLOT — and a `String` bound from
	//     a literal is `.rdata` and immortal. Those cases were already inert as drop gates, which is the
	//     `spec-can-pass-without-testing-its-subject` shape, not an expressiveness cost.
	//
	// ⇒ The cases that DID trip the rule were rewritten to read their binding, because **the binding not
	// being read was never the test**. `specs/unused-variables.md` carries the rule.
	mutableLocal

	// ⭐ **A body `let` the author wrote.** Enrolled at the same door as `mutableLocal` above and exempt on
	// the same `_` discard; it is a separate KIND only because E3077 (`var` should be `let`) must never
	// speak about one — that rule's filter is `binding.mutable`, which a `let` fails, so the split costs no
	// test there.
	immutableLocal

	// ⭐ **THE OPTIONAL `( e )` OF A CATCHING FORM** — a divergent `otherwise (e) panic("…")`, an
	// `otherwise (e) 'h' … end 'h'` block, and a catching `if`'s `else (e) 'err'` alike. It is checked where
	// a body `let` deliberately is not, and the difference is that this binding is OPTIONAL: an author who
	// declares one and never reads it wrote the parentheses for nothing, which is a different sentence from
	// the general unused-`let` rule the kind above defers.
	//
	// ⭐ **ONE KIND BECAUSE THERE IS ONE DOOR.** Every form declares its binding through
	// `Parser.declareCaughtError`, which is where the enrolment lives, so no form can acquire a binding
	// without acquiring the check with it.
	caughtError

	// ⭐ **A `match` ARM'S PAYLOAD BINDER — the `n` of `value(n) then …`.** An arm that names a payload it
	// never reads meant `_`, which is the discard `declarePayloadBindings` already skips.
	//
	// ⚠ **ITS MUTABILITY IS THE SCRUTINEE'S, NOT THE AUTHOR'S**, which is why E3077's candidate test is this
	// KIND and not `binding.mutable` — see `Parser.reportVarShouldBeLet`.
	payloadBinding
end 'UnusedBindingKind'

// ⭐ **ONE DECLARATION THE UNUSED CHECK (E3012) MUST ACCOUNT FOR** — paired with the span of the NAME the
// author wrote, which is where the diagnostic lands.
//
// It holds the `VarInfo` itself rather than the name, because one half of the verdict is
// `binding.referenced`, a bit written LATER (at every mention door) through the same heap object; a name
// copied here would have to be looked up again in a `Scope` an inner block may since have shadowed — and the
// shadow is a different declaration with its own answer.
//
// The RANGE rides here and not on `VarInfo` because only these binding kinds are candidates: a self-field
// alias, the destructuring temp and the module-storage stand-in all construct a `VarInfo` and none of them
// is checked, so a declaration span on the record would be a column most constructors fill with nothing.
//
// ⭐ **E3077 WALKS THIS SAME LIST** (`Parser.reportVarShouldBeLet`), and that is the shape that makes the
// precedence between the two rules structural rather than stated: "an unused `var` reports as UNUSED, not
// as should-be-let" is one list scanned twice in a fixed order, not two lists that could disagree about
// which declarations exist.
export type UnusedBindingCandidate
	export let binding as VarInfo
	export let nameRange as SourceRange
	export let kind as UnusedBindingKind
	export let declToken as ElementIndex

	export static function create(binding VarInfo, nameRange SourceRange, kind UnusedBindingKind, declToken ElementIndex) returns UnusedBindingCandidate
		return Self{binding: binding, nameRange: nameRange, kind: kind, declToken: declToken}
	end 'create'
end 'UnusedBindingCandidate'

export typealias UnusedBindingCandidateArray = Array with UnusedBindingCandidate

// --- Ranged typealiases ---
//
// `typealias Score = int(0 to 100)` — the declaration form nearly every real Maxon
// file opens with, and the reason `int` is almost never written bare in a type
// position. A DECLARATION, not an op: it contributes a registry entry, and
// TypeResolution collapses every `MaxonType.named(Score)` to the primitive below.
//
// TWO ALIASES OVER THE SAME RANGE ARE TWO TYPES — the DECLARATION is the type, so an `Age`
// never reaches a `Year` slot unless the author writes `as`. Resolution still erases
// the name to `underlying`; the identity survives in the value column and in the
// pre-erasure signature columns (`ProgramSignatures.rangedIdentityOfSpelling` is the one
// door that spells it). The BOUNDS are a separate fact and are carried because they
// ARE the alias's definition: they are what a narrowing conversion is checked against,
// and a name is never a proof that a value lies inside them.
//
// `low`/`high` are INCLUSIVE and stored as the raw 64-bit pattern `ParsedInt` holds:
// `upto` (an exclusive upper bound) is normalized to `high - 1` at parse time so the
// registry has ONE representation, and an unsigned-domain bound such as `u64.max`
// rides as the signed value with the same bits (which is exactly how a cast against
// it must compare — see specs/ranged-typealias.md's sentinel case).
// ⭐ **A `bits(n)` WIDTH** — 1, 2, 4, 8, 16, 32 or 64. The legal widths are exactly what the two
// storage ladders produce (`rangedAliasStorageBytes`' 1/2/4/8-byte slots and
// `rangedAliasPackedBits`' 1/2/4 sub-byte widths), which is why the set is what it is rather than
// every n up to 64: a width outside it has nowhere to be stored.
export typealias BitWidth = int(0 to 64)

// The one width at which a pattern's door tests nothing — every 64-bit value is a value of `bits(64)`.
let FullWordBitWidth = 64 as BitWidth

export union RangedAliasDomain
	quantity
	pattern(width BitWidth)

	export function isPattern() returns bool
		return match self 'domain'
			quantity gives false
			pattern gives true
		end 'domain'
	end 'isPattern'

	export function isFullWordPattern() returns bool
		return match self 'domain'
			quantity gives false
			pattern(width) gives width == FullWordBitWidth
		end 'domain'
	end 'isFullWordPattern'

	export function qualifierPrefix() returns String
		return match self 'domain'
			quantity gives ""
			pattern(width) gives "b{width}_"
		end 'domain'
	end 'qualifierPrefix'

	export function isTheSameDomainAs(other RangedAliasDomain) returns bool
		return match self 'domain'
			quantity gives not other.isPattern()
			pattern(width) gives other.isPatternOfWidth(width)
		end 'domain'
	end 'isTheSameDomainAs'

	function isPatternOfWidth(width BitWidth) returns bool
		return match self 'domain'
			quantity gives false
			pattern(own) gives own == width
		end 'domain'
	end 'isPatternOfWidth'
end 'RangedAliasDomain'

// @generated library-cache begin
function cacheWriteRangedAliasDomain(writer LibraryCacheWriter, value RangedAliasDomain)
	writer.unsigned(value.ordinal as CacheUnsigned)

	match value 'payload'
		quantity then break 'payload'
		pattern(a0) then cacheWriteRangedAliasDomainPattern(writer, a0: a0)
	end 'payload'
end 'cacheWriteRangedAliasDomain'

function cacheWriteRangedAliasDomainPattern(writer LibraryCacheWriter, a0 BitWidth)
	writer.unsigned(a0 as CacheUnsigned)
end 'cacheWriteRangedAliasDomainPattern'

function cacheReadRangedAliasDomain(reader LibraryCacheReader) returns RangedAliasDomain throws LibraryCacheDamage
	let tag = try reader.unsigned()

	return match tag 'case'
		0 gives RangedAliasDomain.quantity
		1 gives try cacheReadRangedAliasDomainPattern(reader)
		default throws LibraryCacheDamage.unknownTag(tag)
	end 'case'
end 'cacheReadRangedAliasDomain'

function cacheReadRangedAliasDomainPattern(reader LibraryCacheReader) returns RangedAliasDomain throws LibraryCacheDamage
	let a0 = (try reader.boundedUnsigned(0, high: 64)) as BitWidth

	return RangedAliasDomain.pattern(a0)
end 'cacheReadRangedAliasDomainPattern'

// @generated library-cache end

export type RangedTypeAlias
	export var name as ByteArray

	// The primitive the alias resolves to — the `int` / `float` keyword it was
	// declared over. What TypeResolution substitutes for `named(alias)`.
	export var underlying as MaxonType
	export var low as ParsedInt
	export var high as ParsedInt

	// WHERE it was declared. The file makes resolution file-scoped (`RangedAliasRegistry.lookup` — a
	// use resolves to its OWN file's alias before anyone else's), and the name's position anchors the
	// E3061 a same-file redeclaration raises, exactly as `FuncSignatureEntry` carries both for E3006.
	//
	// ⚠ The position must be the alias NAME's, not the `typealias` keyword's: E3061 blames the
	// redeclaration the user wrote, so it anchors on the name (`…:3:11` for `typealias Score`, column
	// 11 being the `S`).
	export var declFilePath as FilePath
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber

	export var visibility as Visibility

	// ⭐⭐ **A RAW BIT-PATTERN ALIAS (`typealias Hash = bits(64)`) AND ITS WIDTH, OR A QUANTITY.**
	// It is the ONE thing that tells a PATTERN from a QUANTITY, and it has to be CARRIED rather than
	// derived: at 64 both store the identical `(0, UnsignedFullUpperPattern)` range, and the whole
	// guard rule turns on which of the two a value came from.
	//
	// A pattern's door admits every value its width can hold — vacuous at 64, which is what an
	// address, a hash, a mask or a wrapped relocation displacement needs. A quantity's door refuses a
	// value that arrived from a SIGNED domain, because a negative is not a quantity. Below 64 the two
	// agree on every observable, and the width is carried there for the same reason it is carried at
	// 64: so a reader never has to guess which one a range meant.
	export var domain as RangedAliasDomain

	export static function create(name ByteArray, underlying MaxonType, low ParsedInt, high ParsedInt, visibility Visibility, declFilePath FilePath, nameLine LineNumber, nameColumn ColumnNumber, domain RangedAliasDomain = RangedAliasDomain.quantity) returns RangedTypeAlias
		return Self{name: name, underlying: underlying, low: low, high: high, visibility: visibility, declFilePath: declFilePath, nameLine: nameLine, nameColumn: nameColumn, domain: domain}
	end 'create'

	export function isTheSameDeclarationAs(other RangedTypeAlias) returns bool
		let spelled = sourceSpelledAliasName(self.name)

		if not spelled.equals(sourceSpelledAliasName(other.name)) 'twoNames'
			return false
		end 'twoNames'

		return self.declFilePath == other.declFilePath and self.nameLine == other.nameLine and self.nameColumn == other.nameColumn
	end 'isTheSameDeclarationAs'

	export function hasSameRangeAs(other RangedTypeAlias) returns bool
		return self.low == other.low and self.high == other.high and maxonTypeTag(self.underlying) == maxonTypeTag(other.underlying) and self.domain.isTheSameDomainAs(other.domain)
