	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteFunctionAliasParamArray'

function cacheReadFunctionAliasParamArray(reader LibraryCacheReader) returns FunctionAliasParamArray throws LibraryCacheDamage
