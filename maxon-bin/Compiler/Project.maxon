	end 'create'

	// ⭐⭐ **THE SAME DECLARATION UNDER A SECOND KEY.** Two callers mint one, and they are two SCOPES
	// rather than two acts: `Parser.publishNestedFunctionAlias` files a nested alias under its
	// enclosing type's name (`Config.FnTypeAlias1`; that function is the one home of why), and
	// `Parser.pushNamespaceQualifiedFunctionAlias` files a visible one under its DIRECTORY's
	// (`legacy.Score`, so `api.Score` and `legacy.Score` can be two forms of one bare name).
	// `GenericAliasEntry.scopedToEnclosingType` is the nested form's twin.
	//
	// ⚠ Everything but the name is carried through UNCHANGED, and it must be: the SIGNATURE is what the two
	// keys disagree about only across separate folds (`extension Iterable` read once per conformer), never
	// between the two copies of ONE fold. A rebuild through `create` with anything defaulted would make the
	// qualified copy answer a different shape from the bare one for the same written declaration.
	export function underName(qualifiedName ByteArray) returns FunctionTypeAlias
		return Self{name: qualifiedName, returnTag: self.returnTag, returnTypeName: self.returnTypeName, returnIdentity: self.returnIdentity.clone(), returnAggregateName: self.returnAggregateName, paramTypes: self.paramTypes, paramSpelling: self.paramSpelling, declFilePath: self.declFilePath, visibility: self.visibility, written: self.written}
	end 'underName'

	// The same declaration with its instance ids renumbered — `underName`'s carry-everything rule, for its reason.
	export function withInstancesRenumbered(remap TypeIdRemap) returns FunctionTypeAlias
		var params = FunctionAliasParamArray.create()

		for param in self.paramTypes 'eachParam'
			params.push(FunctionAliasParam.create(param.tag, typeName: param.typeName, identity: remappedAliasSlotIdentity(param.identity, remap: remap), aggregateName: param.aggregateName))
		end 'eachParam'

		return Self{name: self.name, returnTag: self.returnTag, returnTypeName: self.returnTypeName, returnIdentity: remappedAliasSlotIdentity(self.returnIdentity, remap: remap), returnAggregateName: self.returnAggregateName, paramTypes: params, paramSpelling: self.paramSpelling, declFilePath: self.declFilePath, visibility: self.visibility, written: self.written}
	end 'withInstancesRenumbered'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.bytes(self.name)
		writer.unsigned(self.returnTag.ordinal as CacheUnsigned)
		writer.bytes(self.returnTypeName)
		cacheWriteAliasSlotIdentity(writer, value: self.returnIdentity)
		writer.bytes(self.returnAggregateName)
		cacheWriteFunctionAliasParamArray(writer, value: self.paramTypes)
		writer.unsigned(self.paramSpelling as CacheUnsigned)
		writer.text(self.declFilePath.toString())
		writer.unsigned(self.visibility.ordinal as CacheUnsigned)
		self.written.cacheWrite(writer)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FunctionTypeAlias throws LibraryCacheDamage
		let f_name = try reader.bytes()
		let f_returnTag = try cacheReadValueTypeTag(reader)
		let f_returnTypeName = try reader.bytes()
		let f_returnIdentity = try cacheReadAliasSlotIdentity(reader)
		let f_returnAggregateName = try reader.bytes()
		let f_paramTypes = try cacheReadFunctionAliasParamArray(reader)
		let f_paramSpelling = (try reader.unsigned()) as HashDigest
		let f_declFilePath = try reader.path()
		let f_visibility = try cacheReadVisibility(reader)
		let f_written = try WrittenTypeNames.cacheRead(reader)

		return Self{name: f_name, returnTag: f_returnTag, returnTypeName: f_returnTypeName, returnIdentity: f_returnIdentity, returnAggregateName: f_returnAggregateName, paramTypes: f_paramTypes, paramSpelling: f_paramSpelling, declFilePath: f_declFilePath, visibility: f_visibility, written: f_written}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize80
		return sizeof(FunctionTypeAlias) as CacheSize80
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FunctionTypeAlias'

// ONE parameter of a function typealias, stored the way the alias's RETURN type is and for the same
// reason: a function alias travels by NAME through both fold paths and is remapped by neither, so a
// `MaxonType` here would carry the DECLARING file's interner ids into registries that never rewrite
// them. The parameter's own NAME is deliberately absent — a function TYPE's parameter names are
// documentation (`Parser.readFunctionTypeParam` discards them, and `parseIndirectCall` passes arguments
// positionally because of it), so a diagnostic names the POSITION, which is the only thing that binds.
export type FunctionAliasParam
	export let tag as ValueTypeTag

	// The declared type's NAME for a `named`/`structRef`/`function` parameter, EMPTY for a primitive —
	// exactly `FunctionTypeAlias.returnTypeName`'s convention, produced by the same
	// `Parser.functionAliasTypeName`.
	export let typeName as ByteArray

	// ⭐ **THE IDENTITY RESOLUTION ERASES — this parameter's contribution to `FunctionShape.paramAggregateNames`.**
	// NOT the same thing as `typeName` above, and the difference is the point: `typeName` is what a reader's
	// interner must re-intern to rebuild the TYPE (a struct's name is there, a primitive's is not), while this
	// is what survives NOTHING and therefore has to be carried (a boxed union/enum, a per-instance ranged
	// alias). A struct is empty here and non-empty there. Filled by `Parser.erasedAggregateNameOf`, the one
	// extraction the declared-function tier fills `FuncSignature.paramAggregateNames` through — see there for
	// why sharing the EXTRACTION rather than loosening the comparison is what keeps the two tiers from
	// classifying one parameter two ways.
	export let aggregateName as ByteArray

	// ⭐⭐ **THE IDENTITY `typeName` CANNOT CARRY** — a type parameter's digest (`Element` in `typealias
	// ElementTransform = function(Element) returns Element`) or a generic instance's id
	// (`AliasSlotIdentity`). `typeName` is "the name a reader's interner must re-intern to rebuild the
	// type", and neither has one: `Parser.functionAliasTypeName` yields the EMPTY STRING for both,
	// which alone rebuilds as id 0, and storing `Element` there would make every reader intern a name
	// that denotes no type.
	//
	// ⚠ Neither is a per-file interner id, so it rides the alias fold exactly as the names beside it
	// do: a digest of two source spellings is the same number in every file that computes it, and a
	// gid indexes the ONE `ProgramSignatures.genericInstances` every file interns into.
	export let identity as AliasSlotIdentity

	export static function create(tag ValueTypeTag, typeName ByteArray, identity AliasSlotIdentity, aggregateName ByteArray) returns FunctionAliasParam
		return Self{tag: tag, typeName: typeName, identity: identity, aggregateName: aggregateName}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.tag.ordinal as CacheUnsigned)
		writer.bytes(self.typeName)
		writer.bytes(self.aggregateName)
		cacheWriteAliasSlotIdentity(writer, value: self.identity)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FunctionAliasParam throws LibraryCacheDamage
		let f_tag = try cacheReadValueTypeTag(reader)
		let f_typeName = try reader.bytes()
		let f_aggregateName = try reader.bytes()
		let f_identity = try cacheReadAliasSlotIdentity(reader)

		return Self{tag: f_tag, typeName: f_typeName, aggregateName: f_aggregateName, identity: f_identity}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize32
		return sizeof(FunctionAliasParam) as CacheSize32
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FunctionAliasParam'

export typealias FunctionAliasParamArray = Array with FunctionAliasParam

// @generated library-cache begin
function cacheWriteFunctionAliasParamArray(writer LibraryCacheWriter, value FunctionAliasParamArray)
