	var result = FunctionAliasParamArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try FunctionAliasParam.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadFunctionAliasParamArray'

// @generated library-cache end

