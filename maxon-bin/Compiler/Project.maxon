typealias ShapeKeySet = Set with HashDigest

let sharedEmptyFunctionAliasDeclarations = FunctionAliasByDeclaringFile.create()

typealias MultiplyDeclaredFunctionAliasMap = Map with (ByteArray, FunctionAliasByDeclaringFile)

// @generated library-cache begin
function cacheWriteMultiplyDeclaredFunctionAliasMap(writer LibraryCacheWriter, value MultiplyDeclaredFunctionAliasMap)
