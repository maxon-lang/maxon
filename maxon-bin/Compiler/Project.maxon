		constBlob then break 'payload'
		emptyContainer(a0) then cacheWriteImmortalRecordKindEmptyContainer(writer, a0: a0)
		stringTable(a0, a1) then cacheWriteImmortalRecordKindStringTable(writer, a0: a0, a1: a1)
		containerBox(a0, a1) then cacheWriteImmortalRecordKindContainerBox(writer, a0: a0, a1: a1)
	end 'payload'
end 'cacheWriteImmortalRecordKind'

function cacheWriteImmortalRecordKindEmptyContainer(writer LibraryCacheWriter, a0 OwnershipCallee)
