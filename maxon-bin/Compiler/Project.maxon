	// tier: a builtin enum is declared in no file, so no file may be refused it.
	//
	// ⚠ It states `integer` rather than `unresolved`, because a builtin's cases are appended through
	// `addBuiltinEnumCase` — which bypasses the case READER that would otherwise fix the backing — and every
	// one of them is a declaration-index tag. An `unresolved` builtin would be a layout whose tag column
	// exists and whose reading rule does not.
	export static function createCompilerOwned(name ByteArray, conformsTo ByteArrayArray) returns EnumLayout
		return EnumLayout.create(name, isUnion: false, conformsTo: conformsTo, visibility: Visibility.global, declFilePath: CompilerOwnedDeclFilePath, backing: EnumBacking.integer)
	end 'createCompilerOwned'

	// The whole-program re-read's answer replacing the sweep's, which is a SUBSET of the clause when a `with`
	// stopped the reader early (`Queries.foldConformanceClauses`). It takes no bindings — see `conformsTo`.
	export function recordConformances(names ByteArrayArray)
