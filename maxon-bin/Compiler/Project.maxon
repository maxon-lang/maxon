		writer.unsigned(self.block as CacheUnsigned)
		writer.unsigned(self.maxonOpPos as CacheUnsigned)
		writer.unsigned(self.stdOpPos as CacheUnsigned)
		writer.unsigned(self.line as CacheUnsigned)
