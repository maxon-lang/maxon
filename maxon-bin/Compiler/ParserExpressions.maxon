extension Parser
	// A shift whose count the compiler could neither fold NOR PROVE (`shiftCountIsProvenUnguarded`) —
	// the runtime half of THE SHIFT RULE, and the half that has to fight the hardware.
	//
	// x64 masks a 64-bit shift's count to its low 6 bits, so the instruction cannot be handed the
	// count as written: `x shl 64` would compute `x shl 0` (x, UNCHANGED) and `x shl 100` would
	// compute `x shl 36`. The count is SATURATED first, by the same rule `evalShift` folds by, and
	// with only the ops the Maxon tier already has (there is no `cmov` and no select in this
	// compiler — see TargetDialect's op inventory):
	//
	//   outOfRange = (count and -64) != 0        — one `and` decides BOTH ends at once: a count is
	//                                              outside 0..63 exactly when a bit above the low 6
	//                                              is set, and a NEGATIVE count has its sign bit
	//                                              set, so it lands out-of-range too.
	//   mask       = (t or -t) shr 63            — an ARITHMETIC shr turns "t is non-zero" into
	//                                              all-ones, and "t is zero" into all-zeros.
	//   ZERO-FILL: (x <shift> count) and not mask   — `shl`, and an UNSIGNED `shrLogical`. Both
	//                                                 shift every bit out, so both saturate to 0.
	//   SIGN-FILL: x shr (count or mask)            — a signed `shr` saturates to the SIGN, and a
	//                                                 count of -1 masks to 63, which IS the sign.
	//
	// Which one applies is read off the OPCODE, which is where `emitShift` already wrote the answer:
	// `shr` is the arithmetic right shift by definition of the enum, and every other shift opcode
	// zero-fills. THE SHIFT RULE was asked once, of the left operand; this is not a second reading
	// of it but a reading of its result.
	//
	// Cost, on top of the shift: 4 ops for the mask, plus 2 (zero-fill) or 1 (sign-fill). Only a
	// count the compiler can neither SEE nor BOUND pays it — every `x shr 8` and `x shl 3` is folded
	// and untouched, and so is every `x shr n` whose `n` denotes an alias or carries a recorded interval
	// inside the counts the instruction takes as written (`emitShift`, via `shiftCountIsProvenUnguarded`).
	//
	// ⭐⭐ **A NEGATIVE COUNT PANICS, WHICH THE SATURATION BELOW DOES NOT SAY.** Go: *"if the shift count
	// is negative at run time, a run-time panic occurs"*, and the runnable oracle does exactly that
	// (MEASURED: `panic at a.maxon:4: negative shift count`, exit 1). The mask below reads a negative count
	// as out-of-range and saturates it, which is defined and deterministic and NOT the masked `x shl 63`
	// this rule exists to kill — but it is an ANSWER where the language promises an abort.
	//
	// ⚠ **THE GUARD IS `count < 0` AND NOT "out of range", WHICH IS A NARROWER TEST THAN THE MASK'S.** A
	// count of 64 or more is LEGAL and shifts every bit out — measured on the oracle, `4 shl 70` exits 0 —
	// so the two questions have different answers and the saturation goes on serving the second.
	function emitGuardedShift(func IrFunction, lhs ValueId, count ValueId, op MaxonBinOp, opTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(opTok)

		try self.emitNegativeShiftCountGuard(func, count: count, opTok: opTok)

		let outOfRangeBits = self.emitLiteral(-ShiftCountBits, valueType: MaxonType.integer, range: range)
		let bitsAboveCount = try self.emitBinOp(count, rhs: outOfRangeBits, op: MaxonBinOp.bitAnd, opTok: opTok)
		let negatedBits = self.emitUnaryOp(bitsAboveCount, op: MaxonUnaryOp.neg, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(opTok))
		let signCarrier = try self.emitBinOp(bitsAboveCount, rhs: negatedBits, op: MaxonBinOp.bitOr, opTok: opTok)
		let signBit = self.emitLiteral(MaxUnguardedShiftCount, valueType: MaxonType.integer, range: range)

		// ARITHMETIC, and unconditionally so: this `shr` is not the user's shift but the MASK's, and
		// it works precisely BECAUSE it replicates the sign — `signCarrier shr 63` is all-ones when
		// the count is out of range and all-zeros when it is not. It is a fact about `signCarrier`
		// (a plain `int`, and therefore signed) and never about `lhs`, so the user's shift opcode has
		// no say in it.
		let mask = try self.emitBinOp(signCarrier, rhs: signBit, op: MaxonBinOp.shr, opTok: opTok)
		self.markUnsignedPattern(mask)

		if op == MaxonBinOp.shr 'signFilling'
			// A count of -1 masks to 63 in the hardware, and `x shr 63` IS the sign — so saturating
			// a sign-filling shift is a CLAMP OF THE COUNT, and needs no select of the result.
			let saturatedCount = try self.emitBinOp(count, rhs: mask, op: MaxonBinOp.bitOr, opTok: opTok)
			return try self.emitBinOp(lhs, rhs: saturatedCount, op: op, opTok: opTok)
		end 'signFilling'

		// A zero-filling shift — `shl`, or an unsigned `shrLogical`. Both shift every bit out for
		// an out-of-range count, so both saturate to 0 by masking the RESULT. The shift itself is
		// `op`, which is why one branch serves the two of them.
		let raw = try self.emitBinOp(lhs, rhs: count, op: op, opTok: opTok)
		let keep = self.emitUnaryOp(mask, op: MaxonUnaryOp.bitNot, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(opTok))
		self.markUnsignedPattern(keep)
		return try self.emitBinOp(raw, rhs: keep, op: MaxonBinOp.bitAnd, opTok: opTok)
	end 'emitGuardedShift'

	// ⚠ **IT IS EMITTED BEFORE THE SATURATION, NOT AFTER, and the order is the point**: past this branch the
	// count is known non-negative, so the mask below is doing only the job it can still do — clamping a
	// count of 64 or more, which is legal.
	function emitNegativeShiftCountGuard(func IrFunction, count ValueId, opTok Token) throws SourceParseError
		let floor = self.emitLiteral(MinShiftCount, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
		let isNegative = try self.emitCompare(count, rhs: floor, op: MaxonCmpOp.lt, opTok: opTok)
		self.emitPanicBranch(func, condition: isNegative, panicLine: panicMessageLine(self.job.path, line: opTok.line, text: NegativeShiftCountPanicText), panicLabel: NegativeShiftPanicBlockLabel, continueLabel: GuardedShiftBlockLabel, opTok: opTok)
	end 'emitNegativeShiftCountGuard'

	// ⭐ **`i64.min / -1` — THE ONE SIGNED QUOTIENT THAT DOES NOT EXIST.** Both operands are tested in one
	// word: `(dividend xor i64.min) or (divisor xor -1)` is zero exactly at the pair, so the divide pays one
	// compare-and-branch. The line is the fault diagnostic's own words, without the addresses a hardware
	// trap adds, so a guarded quotient and a trapping one read alike.
	function emitQuotientOverflowGuard(func IrFunction, dividend ValueId, divisor ValueId, opTok Token) throws SourceParseError
		let range = SourceRange.ofToken(opTok)
		let intMin = self.emitLiteral(OverflowingDividendPattern, valueType: MaxonType.integer, range: range)
		let minusOne = self.emitLiteral(OverflowingDivisorPattern, valueType: MaxonType.integer, range: range)
		let dividendBits = try self.emitBinOp(dividend, rhs: intMin, op: MaxonBinOp.bitXor, opTok: opTok)
		let divisorBits = try self.emitBinOp(divisor, rhs: minusOne, op: MaxonBinOp.bitXor, opTok: opTok)
		let pairBits = try self.emitBinOp(dividendBits, rhs: divisorBits, op: MaxonBinOp.bitOr, opTok: opTok)
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: range)
		let isOverflowPair = try self.emitCompare(pairBits, rhs: zero, op: MaxonCmpOp.eq, opTok: opTok)

		self.emitPanicBranch(func, condition: isOverflowPair, panicLine: faultLineOf(HardwareFaultKind.overflow, tail: PanicMessageLineTerminator), panicLabel: QuotientOverflowPanicBlockLabel, continueLabel: GuardedQuotientBlockLabel, opTok: opTok)
	end 'emitQuotientOverflowGuard'

	// ⭐ **THE COMPARE'S TWO-WAY BRANCH AND ITS PANIC BLOCK — the shape `InsertRangeChecks` builds one tier
	// down, built here because the MESSAGE is the operator's.** Nothing crosses the join, so there is no phi
	// to mint: the panic block never merges (it ends on `mrt_panic`, which exits the process, behind a dead
	// return that keeps the block well-formed), and every value the continuation reads was defined in the
	// block that branched to it. Control is left in the continuation.
	function emitPanicBranch(func IrFunction, condition ValueId, panicLine ByteArray, panicLabel ByteArray, continueLabel ByteArray, opTok Token)
		let range = SourceRange.ofToken(opTok)

		// `var`, not `let`: the panic op is emitted INTO it, and a `let` binding cannot be forwarded to a
		// mutating parameter (E3207) — `emitShortCircuit`'s entry block for its reason.
		let panicBlock = self.artifact.module.addBlock(func, label: panicLabel, heat: BlockHeat.normal)
		let continueBlock = self.artifact.module.addBlock(func, label: continueLabel, heat: BlockHeat.normal)
		self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.condBranch(condition, thenBlockId: panicBlock.id, elseBlockId: continueBlock.id), range: range)

		self.bodyState.currentBlock = panicBlock
		self.bodyState.currentBlock.heat = BlockHeat.cold
		self.emitBodyOp(panicBlock, op: MaxonOp.panicAbort(panicLine), range: range)
		self.emitDeadReturn(func, anchor: opTok)

		self.bodyState.currentBlock = continueBlock
	end 'emitPanicBranch'

	// WHERE E2054 POINTS: the first token of the count as WRITTEN. `x shl SHIFT` points at `SHIFT`,
	// where the programmer would look, and not at the `let` that gave it its value. Redundant
	// parentheses are not part of what was written, so `x shl (-1)` points at the `-1`.
	function shiftCountAnchor(countStart ElementIndex, countEnd ElementIndex) returns Token
		var lo = countStart
		var hi = countEnd

		// Strip redundant outer parentheses so `x shl (-1)` anchors E2054 on the `-1`, not the `(`. The
		// same 4-line idiom `rhsWasBareLocalReference` uses to see a move through `(t)` — NOT factored
		// into a shared helper on purpose: the only the compiler return shape that could hand back both narrowed
		// bounds is a tuple, and a tuple return HEAP-ALLOCATES per call, which on the per-bind/assign
		// gate path reintroduces exactly the linear compile-time allocation the move-poison optimizer
		// removed. Each copy is independently pinned by specs (shift `maxoncstderr` blocks here;
		// `paren-move` there), so a divergence cannot pass unnoticed, and the two serve unrelated ends
		// (diagnostic anchor vs move soundness) — a benign shared mechanic, not a shared fact that must
		// agree.
		while lo + 2 <= hi and self.kindAt(lo) == TokenKind.leftParen and self.kindAt(hi - 1) == TokenKind.rightParen 'stripParens'
			lo = lo + 1
			hi = hi - 1
		end 'stripParens'

		return self.tokenAt(lo)
	end 'shiftCountAnchor'

	// Lower a BOOL `and`/`or` to SHORT-CIRCUIT control flow. `a and
	// b` must not evaluate `b` when `a` is false, so it is not an operator at all: it is a
	// branch, a block, and a merge phi, minted on the same on-the-fly SSA machinery `if` and
	// `while` mint theirs.
	//
	//     entry:  <lhs already evaluated>
	//             cond_br lhs ? rhs   : merge   -- `and`: a FALSE lhs skips the rhs
	//             cond_br lhs ? merge : rhs     -- `or` : a TRUE  lhs skips the rhs
	//     rhsEnd: <the rhs is evaluated HERE, and on no other path>
	//             br merge(rhsValue)
	//     merge:  phi <- [seed from entry] [rhsValue from rhsEnd]
	//
	// The SEED is the answer the skipped path already determined: `false` for `and`, `true`
	// for `or`.
	//
	// The merge value is a BLOCK ARG fed by each predecessor's branch edge: the parser IS
	// the SSA constructor, so there is no slot to store into and reload at the merge.
	//
	// `condBranch` names both targets and `lowerCondBranch` emits `jcc` + `jmp` for EVERY
	// layout, so `and` and `or` differ only in which target each edge names — the lhs is
	// never negated.
	//
	// The rhs block is created BEFORE the rhs is parsed and the merge block AFTER, so a
	// NESTED short-circuit inside the rhs slots its own blocks between them and `.text` still
	// lays out in evaluation order.
	function emitShortCircuit(func IrFunction, leftValue ValueId, opTok Token, rhsMinPrec InfixPrecedence) returns ValueId throws SourceParseError
		let takesRhsWhenTrue = opTok.kind == TokenKind.and

		if self.constIsKnown(leftValue) 'leftIsKnown'
			return try self.foldShortCircuitOnKnownLeft(func, leftValue: leftValue, opTok: opTok, rhsMinPrec: rhsMinPrec)
		end 'leftIsKnown'

		// The seed literal and the two-way branch are emitted INTO this block.
		let entry = self.bodyState.currentBlock
		let range = SourceRange.ofToken(opTok)

		// The value the SKIPPED path yields, materialized in the entry block: `false and _`
		// is false, `true or _` is true. It is the entry edge's phi operand.
		let seed = self.emitLiteralIn(entry, value: shortCircuitSeed(takesRhsWhenTrue), valueType: MaxonType.boolean, range: range)

		let rhs = try self.parseShortCircuitRhs(func, leftValue: leftValue, opTok: opTok, rhsMinPrec: rhsMinPrec)
		let rhsEnd = self.bodyState.currentBlock

		let merge = self.artifact.module.addBlock(func, label: b"scmerge", heat: BlockHeat.normal)
		let result = self.mintPhi(merge, tag: rhs.resultTag, nameId: UnnamedTypeId)

		// A binding the rhs moved is dropped on the skip edge, which then needs a block of its own: `entry` already
		// dominates the rhs. A short-circuit that moves nothing keeps the direct edge — `finalizeIfNoElse`'s shape.
		if self.movesALiveBinding(rhs.skippedMoveMark, after: rhs.rhsMoveMark) 'skipEdgeDrops'
			let skip = self.artifact.module.addBlock(func, label: b"scskip", heat: BlockHeat.normal)
			self.reconcileMovesAtTwoEdgeMerge(skip, markA: rhs.skippedMoveMark, b: rhsEnd, markB: rhs.rhsMoveMark, anchor: opTok)
			self.recordBranchEdge(skip, targetId: merge.id, argIds: argsOf(seed))
			self.emitBranch(skip, targetId: merge.id)
			self.emitShortCircuitBranch(entry, cond: leftValue, rhsId: rhs.rhsId, mergeId: skip.id, takesRhsWhenTrue: takesRhsWhenTrue, range: range)
		end 'skipEdgeDrops' else 'directSkipEdge'
			self.recordBranchEdge(entry, targetId: merge.id, argIds: argsOf(seed))
			self.emitShortCircuitBranch(entry, cond: leftValue, rhsId: rhs.rhsId, mergeId: merge.id, takesRhsWhenTrue: takesRhsWhenTrue, range: range)
		end 'directSkipEdge'

		self.recordBranchEdge(rhsEnd, targetId: merge.id, argIds: argsOf(rhs.value))
		self.emitBranch(rhsEnd, targetId: merge.id)

		self.bodyState.currentBlock = merge

		if not rhs.orders.holdsNothing() 'somethingIsEstablished'
			self.recordConditionOrders(result, orders: rhs.orders)
		end 'somethingIsEstablished'

		return result
	end 'emitShortCircuit'

	// A known left operand decides the result with no branch, so `let BOTH = true and true` is a constant
	// at file scope. A skipped rhs is still parsed, so it earns every diagnostic a body gives it, into a
	// block nothing branches to.
	function foldShortCircuitOnKnownLeft(func IrFunction, leftValue ValueId, opTok Token, rhsMinPrec InfixPrecedence) returns ValueId throws SourceParseError
		let takesRhsWhenTrue = opTok.kind == TokenKind.and
		let rhsDecides = (self.constOf(leftValue) == BoolTrueValue) == takesRhsWhenTrue

		if rhsDecides 'rhsIsTheResult'
			let rhsValue = try self.parseUnclaimedBinary(func, minPrec: rhsMinPrec)
			try self.requireBinOpOperands(infixMaxonOp(opTok.kind), left: ValueTypeTag.boolean, leftValue: leftValue, right: self.tagOf(rhsValue), rightValue: rhsValue, opTok: opTok)
			return rhsValue
		end 'rhsIsTheResult'

		let entry = self.bodyState.currentBlock
		let rhs = try self.parseShortCircuitRhs(func, leftValue: leftValue, opTok: opTok, rhsMinPrec: rhsMinPrec)
		let rhsEnd = self.bodyState.currentBlock

		if self.movesALiveBinding(rhs.skippedMoveMark, after: rhs.rhsMoveMark) 'rhsMovedABinding'
			self.reconcileMovesAtTwoEdgeMerge(entry, markA: rhs.skippedMoveMark, b: rhsEnd, markB: rhs.rhsMoveMark, anchor: opTok)
		end 'rhsMovedABinding'

		self.emitDeadReturn(func, anchor: opTok)
		self.bodyState.currentBlock = entry
		return leftValue
	end 'foldShortCircuitOnKnownLeft'

	function parseShortCircuitRhs(func IrFunction, leftValue ValueId, opTok Token, rhsMinPrec InfixPrecedence) returns ShortCircuitRhs throws SourceParseError
		let takesRhsWhenTrue = opTok.kind == TokenKind.and
		let rhsBlock = self.artifact.module.addBlock(func, label: shortCircuitLabel(takesRhsWhenTrue), heat: BlockHeat.normal)
		let rhsId = rhsBlock.id
		self.bodyState.currentBlock = rhsBlock
		let rhsTempFloor = self.bodyState.pendingTempDrops.count()

		// ⭐ **AND THE OWNED-BINDING HEIGHT — the twin floor, for the list whose entries drop at a SCOPE exit.**
		// The `for`/`match`/ternary reason, one construct over: `giveTemporaryScopeLifetime` holds the
		// container a borrow was taken out of, and `a or (try make().get(0) otherwise d).count() == 3` takes
		// one INSIDE the rhs. Left to the enclosing scope, that record's decref would run on the path that
		// short-circuited past its definition — MEASURED as the allocator's `seedInUse: a use dominates its
		// def`, the same complaint the pending-temp drain below was written for.
		let rhsOwnedFloor = self.bodyState.ownedBindings.count()

		// The move state the SKIP edge carries: the rhs runs on one path only, so a binding it moves is still
		// owned where it was skipped. Captured only where a binding could be moved at all.
		var skippedMoveMark = self.emptyMoveMark

		if rhsOwnedFloor > 0 'bindingsToMove'
			skippedMoveMark = self.captureMoveMark()
		end 'bindingsToMove'

		let leftOrders = self.conditionOrdersOf(leftValue)
		let rhsOrderFloor = self.assumeOrders(leftOrders.whenTrue if takesRhsWhenTrue else leftOrders.whenFalse)
		let rhsValue = try self.parseUnclaimedBinary(func, minPrec: rhsMinPrec)
		let rhsOrders = self.conditionOrdersOf(rhsValue)
		self.bodyState.orderFacts.forgetAbove(rhsOrderFloor)

		// NOT `rhsBlock`: the rhs may itself have short-circuited (`a or b or c`), leaving
		// control in a merge block of its own. That is the block the value is defined in, and
		// the one that must branch here.
		let rhsEnd = self.bodyState.currentBlock

		// ⭐ **THE RIGHT-HAND SIDE RUNS ON ONE PATH, SO ITS TEMPORARIES DIE ON THAT PATH.** `a or [4,5].count()
		// == 2` builds its array only when the lhs was false; on the short-circuit path the value does not
		// exist at all. Releasing it after the merge is therefore not a leak but the OPPOSITE mistake — a
		// release of something never built, which is a use of a register the skipped path never wrote. It was
		// caught downstream, loudly, by the allocator's dominance invariant ("a use dominates its def"), which
		// is exactly the right complaint: `rhsEnd` is the only block the rhs's definitions dominate, so this
		// is the only place the release can go. A bool operand is never owned heap, so `rhsValue` itself is
		// never in this list and cannot be released out from under the merge phi.
		self.drainPendingTemps(rhsTempFloor, anchor: opTok)

		// The same argument for the rhs's own SCOPE-lifetime holds, in the same block. The merge phi is a
		// BOOL, so no borrow can leave the rhs through it — which is why the record a borrow was taken out of
		// may be released here rather than laundered on the way out, unlike a ternary arm's give.
		self.dropArmScopedOwned(rhsOwnedFloor, exitBlock: rhsEnd, anchor: opTok)

		// The SHORT-CIRCUIT half of the same rule `emitBinOp` enforces — ASKED, not restated
		// (see `requireBinOpOperands`). The left operand is already known to be a bool: that is
		// what brought control here.
		let op = infixMaxonOp(opTok.kind)
		let rhsTag = self.tagOf(rhsValue)
		try self.requireBinOpOperands(op, left: ValueTypeTag.boolean, leftValue: leftValue, right: rhsTag, rightValue: rhsValue, opTok: opTok)

		// The merge phi IS the operator's result, so its TAG is the operator's result type — and
		// it is ASKED of the same `binOpResultTag` the `binOp` path asks, not restated as a
		// literal `boolean` here. Restating it left a word operator's result type with TWO
		// deciders, one per path, and nothing making them agree: they answer the same thing today
		// only because a bool left operand makes `wordOpResultTag`'s first arm fire for every rhs
		// that survives the check above. The day that rule changes — deferring on an `unresolved`
		// rhs, say (see TypeRules' `wordOpResultTag`, and the cross-file gap in
		// `calleeResultType`) — the `binOp` path would move and this one would go on ASSERTING
		// `boolean` about a value it cannot type. A wrong tag is not a compile error; it is a
		// wrong answer at whatever reads the tag next, which is every rule that reads it.
		let resultTag = binOpResultTag(op, left: ValueTypeTag.boolean, right: rhsTag)

		var rhsMoveMark = self.emptyMoveMark

		if rhsOwnedFloor > 0 'bindingsMayHaveMoved'
			rhsMoveMark = self.captureMoveMark()
		end 'bindingsMayHaveMoved'

		return ShortCircuitRhs.create(rhsId, value: rhsValue, resultTag: resultTag, skippedMoveMark: skippedMoveMark, rhsMoveMark: rhsMoveMark, orders: leftOrders.whenAndHolds(rhsOrders) if takesRhsWhenTrue else leftOrders.whenOrFails(rhsOrders))
	end 'parseShortCircuitRhs'

	// The two-way branch out of a short-circuit's entry block. `and` takes the rhs when the
	// lhs is TRUE; `or` takes it when the lhs is FALSE — so the two differ by nothing but
	// which target sits in which slot.
	function emitShortCircuitBranch(entry IrBlock, cond ValueId, rhsId BlockId, mergeId BlockId, takesRhsWhenTrue bool, range SourceRange)
		var thenId = mergeId
		var elseId = rhsId

		if takesRhsWhenTrue 'isAnd'
			thenId = rhsId
			elseId = mergeId
		end 'isAnd'

		self.emitBodyTerminator(entry, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: range)
	end 'emitShortCircuitBranch'

	// A prefix-operator operand — the climber's leaf.
	//
	// The two prefix operators bind their operands DIFFERENTLY, and both readings are pinned
	// by a spec:
	//   • `-` takes a PRIMARY, so `- -x` fails at the second `-` (parsePrimary raises E2004)
	//     — specs/unary-operators.md's double-negation case.
	//   • `not` takes another UNARY, so `not not a` is legal and is 42 for a == 42
	//     — specs/bitwise-operators.md's `bitwise-not-double`.
	//
	// `not` is TYPE-DIRECTED, like `and`/`or`/`xor`: on a bool it flips bit 0 (`not true` is
	// false), on an integer it complements all 64 (`not 5` is -6). The two are different
	// instructions, and choosing the integer one for a bool would give -1/-2 — both of which
	// still read as TRUE in a condition. So the parser, which is the tier that knows the
	// type, picks the opcode; the Std tier just lowers what it is given.
	//
	// `-` is NOT type-directed: it is ARITHMETIC, so its operand must be a number. `-flag` has
	// no reading — it negated the bool's 1 payload and produced -1, which is still TRUE in a
	// condition — so it is rejected by the same numeric-domain rule the binary arithmetic
	// operators use (TypeRules' `typeClassAdmits`).
	// The `as`-cast layer, LOOSER than unary `-`/`not` but TIGHTER than every binary operator: `-5 as
	// Age` is `(-5) as Age`, so a negative literal narrowed into a ranged alias is checked as the
	// NEGATIVE value — which is what `error.negative-out-of-range` pins. The cast is therefore NOT a
	// `parsePostfix` operator (that band — the indirect call `f(x)` — stays TIGHTER than `-`, so
	// `-f()` is `-(f())`); it wraps the whole unary result here. `applyCast` retags / range-checks /
	// float-converts.
	function parseCast(func IrFunction) returns ValueId throws SourceParseError
		let operandStart = self.pos
		let operand = try self.parseUnary(func)

		// ⚠ Asked only once an `as` is actually there, and this is a HOT path — `parseCast` wraps every
		// expression leaf in the program, while a cast is rare. `rhsWasBareLocalReference` walks tokens and
		// probes the scope; paying that per leaf would be a cost the feature does not earn.
		if not self.at(TokenKind.as) 'noCast'
			return operand
		end 'noCast'

		// ⭐ **WAS THE OPERAND A BARE REFERENCE TO A LOCAL?** Asked HERE, while the cursor still sits just
		// past the operand, because `applyCast` may not stamp a declared alias onto a value that another
		// BINDING also names (see `ValueDeclaredAliasMap`).
		let operandEnd = self.pos
		let operandIsBareLocal = self.rhsWasBareLocalReference(operandStart)
		let operandIsALiteral = self.spansANumericLiteral(operandStart)
		let castLetReads = self.letCastReadsOfOperand(operand, first: operandStart, pastEnd: operandEnd) if self.trackedLetCasts() else LetCastRoster.none
		let castReadsAwait = not rosterIsEmpty(castLetReads)
		let asTok = try self.consume(TokenKind.as)

		if self.paramCapabilityAt(self.pos) != ParamCapability.unmarked 'aCapabilityAnnotation'
			return try self.parseCapabilityAnnotation(operand)
		end 'aCapabilityAnnotation'

		// Captured BEFORE the target is parsed: E2003 anchors on the TARGET NAME, and by the time
		// `parseTypeReference` returns the cursor is past it. (For a two-token `Wrapper.Idx` target this
		// is the first of the two.)
		let targetTok = self.current()
		let targetStart = self.pos
		let targetType = try self.parseTypeReference(BarePrimitiveVoice.asACastTarget)

		if self.operandIsACast(operandStart, operandEnd: operandEnd) 'aParenthesizedCast'
			throw castOfACast(asTok, targetName: self.tokenTextFrom(targetStart, endIndex: self.pos))
		end 'aParenthesizedCast'

		if self.castEmitsAnOp(operand, targetType: targetType, sourceIsBareLocal: operandIsBareLocal) 'theCastProducesTheValue'
			self.releaseCompletedOperand()
		end 'theCastProducesTheValue'

		// Asked of the literal before the cast: the cast's result denotes the target alias itself, so it
		// would admit an out-of-range literal too.
		let admittingAlias = self.aliasAdmittingLiteral(operand, targetType: targetType) if operandIsALiteral else self.anchors.undeclaredAlias
		let admittingLetCast = self.aliasAdmittingLiteral(operand, targetType: targetType) if castReadsAwait else self.anchors.undeclaredAlias
		let literalConstant = self.foldedConstantOf(operand) if operandIsALiteral else LetCastConstant.unknown
		let result = try self.applyCast(operand, targetType: targetType, asTok: asTok, targetTok: targetTok, sourceIsBareLocal: operandIsBareLocal)
		self.statement.lastCast = RecordedCast.recorded(operandStart, pastEnd: self.pos)

		if castReadsAwait 'aCastConstantRead'
			self.claimLetCastsThroughACast(castLetReads, admitted: admittingLetCast)
		end 'aCastConstantRead'

		if self.at(TokenKind.as) 'aCastOfACast'
			let outerAsTok = try self.consume(TokenKind.as)
			let outerTargetStart = self.pos
			_ = try self.parseTypeReference(BarePrimitiveVoice.asACastTarget)
			throw castOfACast(outerAsTok, targetName: self.tokenTextFrom(outerTargetStart, endIndex: self.pos))
		end 'aCastOfACast'

		match admittingAlias 'aLiteralTheTargetAlreadyAdmits'
			undeclared then return result
			declared(alias) then self.recordLiteralCast(result, alias: alias, first: operandStart, asTok: asTok, constant: literalConstant)
		end 'aLiteralTheTargetAlreadyAdmits'

		return result
	end 'parseCast'

	function operandIsACast(operandStart ElementIndex, operandEnd ElementIndex) returns bool
		return match self.statement.lastCast 'recorded'
			nothingRecorded gives false
			recorded(first, pastEnd) gives self.onlyParenthesesSurround(first, pastEnd: pastEnd, operandStart: operandStart, operandEnd: operandEnd)
		end 'recorded'
	end 'operandIsACast'

	function onlyParenthesesSurround(first ElementIndex, pastEnd ElementIndex, operandStart ElementIndex, operandEnd ElementIndex) returns bool
		if first < operandStart or pastEnd > operandEnd or first - operandStart != operandEnd - pastEnd 'notTheOperandsWholeSpan'
			return false
		end 'notTheOperandsWholeSpan'

		for index in operandStart upto first 'opening'
			if self.kindAt(index) != TokenKind.leftParen 'notAnOpeningParenthesis'
				return false
			end 'notAnOpeningParenthesis'
		end 'opening'

		for index in pastEnd upto operandEnd 'closing'
			if self.kindAt(index) != TokenKind.rightParen 'notAClosingParenthesis'
				return false
			end 'notAClosingParenthesis'
		end 'closing'

		return true
	end 'onlyParenthesesSurround'

	function spansANumericLiteral(first ElementIndex) returns bool
		let literalAt = self.literalPastItsSign(first)

		if literalAt + 1 != self.pos 'moreThanOneLiteral'
			return false
		end 'moreThanOneLiteral'

		let kind = self.kindAt(literalAt)
		return kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral
	end 'spansANumericLiteral'

	function literalPastItsSign(first ElementIndex) returns ElementIndex
		return first + 1 if self.kindAt(first) == TokenKind.minus else first
	end 'literalPastItsSign'

	function aliasAdmittingLiteral(literal ValueId, targetType MaxonType) returns DeclaredAlias
		let alias = try self.rangeCheckedAliasOf(targetType) otherwise return self.anchors.undeclaredAlias

		if not (self.edgeProvesAlias(literal, alias: alias) or self.integerLiteralWidensInto(literal, alias: alias)) 'theLiteralFallsOutside'
			return self.anchors.undeclaredAlias
		end 'theLiteralFallsOutside'

		return DeclaredAlias.declared(alias)
	end 'aliasAdmittingLiteral'

	function foldLiteralToFloatBits(literal ValueId) returns FullRangeInt
		if self.valueConvertsAsUnsigned(literal) 'anUnsignedLiteral'
			return foldUiToFp(self.constOf(literal))
		end 'anUnsignedLiteral'

		return foldSiToFp(self.constOf(literal))
	end 'foldLiteralToFloatBits'

	function integerLiteralWidensInto(literal ValueId, alias RangedTypeAlias) returns bool
		return aliasIsFloat(alias) and self.constIsKnown(literal) and literalInRange(self.foldLiteralToFloatBits(literal), low: alias.low, high: alias.high, isFloat: true, writtenNegative: false, writtenAboveSignedMax: false)
	end 'integerLiteralWidensInto'

	function literalCastOver(first ElementIndex, alias RangedTypeAlias, asTok Token) returns LiteralCast
		let literalAt = self.literalPastItsSign(first)
		let literalTok = self.tokenAt(literalAt)
		let literalTag = ValueTypeTag.float if literalTok.kind == TokenKind.floatLiteral else ValueTypeTag.integer
		return LiteralCast.create(literalTok.value, negative: literalAt != first, target: alias.clone(), asRange: SourceRange.ofToken(asTok), literalTag: literalTag)
	end 'literalCastOver'

	function foldedConstantOf(value ValueId) returns LetCastConstant
		if self.valueConvertsAsUnsigned(value) 'mayExceedTheSignedTop'
			return LetCastConstant.unknown
		end 'mayExceedTheSignedTop'

		if self.constIsKnown(value) 'anInteger'
			return LetCastConstant.integer(self.constOf(value))
		end 'anInteger'

		if self.floatConstIsKnown(value) 'aFloat'
			return LetCastConstant.real(self.floatConstBitsOf(value))
		end 'aFloat'

		return LetCastConstant.unknown
	end 'foldedConstantOf'

	function recordLiteralCast(result ValueId, alias RangedTypeAlias, first ElementIndex, asTok Token, constant LetCastConstant)
		let recorded = self.literalCastsForWrite()
		recorded.upsert(result, value: LiteralCastSpan.create(self.literalCastOver(first, alias: alias, asTok: asTok), constant: constant, first: first, pastEnd: self.pos))
	end 'recordLiteralCast'

	function recordedLiteralCast(value ValueId) returns LiteralCastSpan throws MapError
		match self.bodyState.literalCasts 'function'
			unwritten then throw MapError.keyNotFound
			entries(recorded) then return try recorded.get(value)
		end 'function'
	end 'recordedLiteralCast'

	function literalCastSpanning(value ValueId, first ElementIndex) returns LiteralCastSpan throws MapError
		let span = try self.recordedLiteralCast(value)

		if not span.covers(first, expressionPastEnd: self.pos) 'aDifferentExpression'
			throw MapError.keyNotFound
		end 'aDifferentExpression'

		return span
	end 'literalCastSpanning'

	function reportUnneededLiteralCastAt(value ValueId, first ElementIndex, declared MaxonType)
		let destination = try self.rangeCheckedAliasOf(declared) otherwise return
		self.reportUnneededLiteralCastInto(value, first: first, destination: destination)
	end 'reportUnneededLiteralCastAt'

	function reportUnneededLiteralCastInto(value ValueId, first ElementIndex, destination RangedTypeAlias)
		self.claimLetCastReads(value, first: first, destination: destination)
		let span = try self.literalCastSpanning(value, first: first) otherwise return
		self.reportUnneededLiteralCast(span.cast, destination: destination)
	end 'reportUnneededLiteralCastInto'

	function reportUnneededLiteralCast(cast LiteralCast, destination RangedTypeAlias)
		if not cast.repeats(destination) 'theDestinationDeclaresAnotherType'
			return
		end 'theDestinationDeclaresAnotherType'

		self.recordArtifactDiagnostic(ErrorCode.semanticUnneededCast, message: unneededLiteralCastMessage(cast), range: cast.asRange)
	end 'reportUnneededLiteralCast'

	function noteLiteralCastArgument(value ValueId, passed ValueId, first ElementIndex)
		let span = try self.literalCastSpanning(value, first: first) otherwise return
		let cast = span.cast
		let confirmed = self.literalCastArgumentsForWrite()
		confirmed.upsert(passed, value: cast)
	end 'noteLiteralCastArgument'

	function moveLiteralCastArgument(value ValueId, to ValueId)
		match self.bodyState.literalCastArguments 'function'
			unwritten then return
			entries then break
		end 'function'

		let confirmed = self.literalCastArgumentsForWrite()
		moveLiteralCastEntry(confirmed, from: value, to: to)
	end 'moveLiteralCastArgument'

	function stampLetCastScopes(firstLine LineNumber, lastLine LineNumber)
		match self.bodyState.letCasts 'tracking'
			none then return
			tracking(state) then state.stampScope(LetCastScope.lines(firstLine, last: lastLine))
		end 'tracking'
	end 'stampLetCastScopes'

	function trackedLetCasts() returns bool
		return match self.bodyState.letCasts 'tracking'
			none gives false
			tracking gives true
		end 'tracking'
	end 'trackedLetCasts'

	function letCastState() returns LetCastState
		return match self.bodyState.letCasts 'tracking'
			tracking(state) gives state
			none panic("letCastState: no literal-cast `let` is tracked in this body — callers ask `trackedLetCasts` first")
		end 'tracking'
	end 'letCastState'

	function letCastStateForWrite() returns LetCastState
		match self.bodyState.letCasts 'tracking'
			tracking(state) then return state
			none then break
		end 'tracking'

		let fresh = LetCastState.create()
		self.bodyState.letCasts = LetCastTracking.tracking(fresh)
		return fresh
	end 'letCastStateForWrite'

	function registerLetCast(nameTok Token, initializer ValueId, first ElementIndex)
		let span = try self.literalCastSpanning(initializer, first: first) otherwise return

		if not letCastTracksAConstant(span.cast, constant: span.constant) 'aConstantThatConvertsOrExceedsTheSignedTop'
			return
		end 'aConstantThatConvertsOrExceedsTheSignedTop'

		let binding = self.bodyState.scope.getInfo(nameTok.value)

		if binding.isCellBinding or binding.isSelfField 'readsThroughMemory'
			return
		end 'readsThroughMemory'

		let state = self.letCastStateForWrite()
		state.bindings.upsert(binding.boundValue, value: LetCastSubject.create(span.cast, name: nameTok.value, declFile: self.job.path, scope: LetCastScope.wholeFile, constant: span.constant))
	end 'registerLetCast'

	function noteLocalLetCastRead(binding VarInfo, nameTok Token)
		if binding.isMutable() 'aVar'
			return
		end 'aVar'

		let state = self.letCastState()
		let subject = try state.bindings.get(binding.boundValue) otherwise return
		self.noteLetCastRead(subject, nameTok: nameTok, claimable: true)
	end 'noteLocalLetCastRead'

	function noteCapturedLetCastRead(binding VarInfo, frame ElementIndex, nameTok Token)
		if binding.isMutable() 'aVar'
			return
		end 'aVar'

		match self.capturedFrame(frame).body.letCasts 'enclosing'
			none then return
			tracking(enclosing) then self.noteCapturedSubject(enclosing, value: binding.boundValue, nameTok: nameTok)
		end 'enclosing'
	end 'noteCapturedLetCastRead'

	function noteCapturedSubject(enclosing LetCastState, value ValueId, nameTok Token)
		let subject = try enclosing.bindings.get(value) otherwise return
		self.noteLetCastRead(subject, nameTok: nameTok, claimable: false)
	end 'noteCapturedSubject'

	function noteModuleLetCastRead(tok Token, typeName ByteArray)
		if typeName.isEmpty() 'anUncastConstant'
			return
		end 'anUncastConstant'

		match self.signatures.letCastDeclarationOf(tok.value, readerFilePath: self.job.path) 'declaration'
			none then return
			declared(subject) then self.noteLetCastRead(subject.clone(), nameTok: tok, claimable: true)
		end 'declaration'
	end 'noteModuleLetCastRead'

	function noteLetCastRead(subject LetCastSubject, nameTok Token, claimable bool)
		let state = self.letCastStateForWrite()
		let findable = claimable and nameTok.endByte > nameTok.startByte

		if findable and state.sites.contains(nameTok.startByte) 'alreadyNoted'
			return
		end 'alreadyNoted'

		if findable 'aSiteAClaimCanFind'
			state.sites.upsert(nameTok.startByte, value: state.reads.count())
		end 'aSiteAClaimCanFind'

		state.reads.push(LetCastRead.create(subject, site: nameTok.startByte))
	end 'noteLetCastRead'

	function claimLetCastReads(value ValueId, first ElementIndex, destination RangedTypeAlias)
		if not self.trackedLetCasts() 'nothingTracked'
			return
		end 'nothingTracked'

		let reads = self.letCastReadsOfOperand(value, first: first, pastEnd: self.pos)

		if rosterIsEmpty(reads) or not self.readsFitDestination(value, first: first, destination: destination) 'nothingTheConstantServes'
			return
		end 'nothingTheConstantServes'

		self.claimLetCastReadsBy(reads, rule: LetCastClaimRule.readsRepeating(destination))
	end 'claimLetCastReads'

	function claimLetCastArgument(target CallArgTarget, column ParamCount, label ByteArray, value ValueId, first ElementIndex)
		if not self.trackedLetCasts() 'nothingTracked'
			return
		end 'nothingTracked'

		let callee = try target.calleeName() otherwise return
		let declaration = try self.signatures.soleCandidateOf(callee) otherwise return

		match self.signatures.declaredAliasAtArgument(declaration, argIndex: column, label: label) 'parameter'
			undeclared then return
			declared(alias) then self.claimLetCastReads(value, first: first, destination: alias)
		end 'parameter'
	end 'claimLetCastArgument'

	function claimLetCastReadsBy(reads LetCastRoster, rule LetCastClaimRule)
		let state = self.letCastState()

		for index in state.readsIn(reads) 'eachRead'
			if rule.claims(state.readAt(index).subject.cast) 'theRuleServesIt'
				state.claim(index)
			end 'theRuleServesIt'
		end 'eachRead'
	end 'claimLetCastReadsBy'

	function letCastReadsOfOperand(value ValueId, first ElementIndex, pastEnd ElementIndex) returns LetCastRoster
		let state = self.letCastState()

		if pastEnd == first + 1 'aSingleToken'
			let tok = self.tokenAt(first)

			if tok.kind != TokenKind.identifier 'notAName'
				return LetCastRoster.none
			end 'notAName'

			let index = try state.sites.get(tok.startByte) otherwise return LetCastRoster.none
			return LetCastRoster.single(index)
		end 'aSingleToken'

		if let derivation = try state.derived.get(value) 'aDerivedConstant'
			if derivation.first == first and derivation.pastEnd == pastEnd 'wholeExpression'
				return derivation.reads
			end 'wholeExpression'
		end 'aDerivedConstant'

		return LetCastRoster.none
	end 'letCastReadsOfOperand'

	function valueIsAPlainConstant(value ValueId) returns bool
		return self.valueIsAPlainNumber(value) and (self.constIsKnown(value) or self.floatConstIsKnown(value))
	end 'valueIsAPlainConstant'

	function settleLetCastComparison(lhs ValueId, lhsFirst ElementIndex, lhsPast ElementIndex, rhs ValueId, rhsFirst ElementIndex, rhsPast ElementIndex)
		let leftReads = self.letCastReadsOfOperand(lhs, first: lhsFirst, pastEnd: lhsPast)
		let rightReads = self.letCastReadsOfOperand(rhs, first: rhsFirst, pastEnd: rhsPast)
		self.claimBesideATypedPartner(leftReads, tracked: lhs, partner: rhs, partnerReads: rightReads)
		self.claimBesideATypedPartner(rightReads, tracked: rhs, partner: lhs, partnerReads: leftReads)
	end 'settleLetCastComparison'

	function settleLetCastArithmetic(result ValueId, op MaxonBinOp, lhs ValueId, lhsFirst ElementIndex, lhsPast ElementIndex, rhs ValueId, rhsFirst ElementIndex, rhsPast ElementIndex)
		if op != MaxonBinOp.add and op != MaxonBinOp.sub and op != MaxonBinOp.mul 'anOperatorTheConstantFolds'
			return
		end 'anOperatorTheConstantFolds'

		let leftReads = self.letCastReadsOfOperand(lhs, first: lhsFirst, pastEnd: lhsPast)
		let rightReads = self.letCastReadsOfOperand(rhs, first: rhsFirst, pastEnd: rhsPast)
		let leftIsConstant = not rosterIsEmpty(leftReads) or self.valueIsAPlainConstant(lhs)
		let rightIsConstant = not rosterIsEmpty(rightReads) or self.valueIsAPlainConstant(rhs)

		if leftIsConstant and rightIsConstant 'aConstantExpression'
			let folded = foldLetCastConstants(op, lhs: self.operandLetCastConstant(lhs, reads: leftReads), rhs: self.operandLetCastConstant(rhs, reads: rightReads))
			self.deriveLetCastConstant(result, reads: leftReads, alsoReads: rightReads, first: lhsFirst, pastEnd: rhsPast, constant: folded)
			return
		end 'aConstantExpression'

		self.claimBesideATypedPartner(leftReads, tracked: lhs, partner: rhs, partnerReads: rightReads)
		self.claimBesideATypedPartner(rightReads, tracked: rhs, partner: lhs, partnerReads: leftReads)
	end 'settleLetCastArithmetic'

	function operandLetCastConstant(operand ValueId, reads LetCastRoster) returns LetCastConstant
		let state = self.letCastState()

		if let derivation = try state.derived.get(operand) 'aDerivedOperand'
			if not rosterIsEmpty(reads) 'itsWholeExpression'
				return derivation.constant
			end 'itsWholeExpression'
		end 'aDerivedOperand'

		match reads 'roster'
			single(index) then return state.readAt(index).subject.constant
			joined then panic("operandLetCastConstant: a joined roster is only ever a derivation's, and the operand has none")
			none then break
		end 'roster'

		return self.foldedConstantOf(operand)
	end 'operandLetCastConstant'

	function deriveLetCastConstant(result ValueId, reads LetCastRoster, alsoReads LetCastRoster, first ElementIndex, pastEnd ElementIndex, constant LetCastConstant)
		if rosterIsEmpty(reads) and rosterIsEmpty(alsoReads) 'nothingTracked'
			return
		end 'nothingTracked'

		let state = self.letCastState()
		let joined = state.join(reads, right: alsoReads)
		let kept = constant if constantFitsEveryRange(constant, ranges: state.rangesOf(joined)) else LetCastConstant.unknown
		state.derived.upsert(result, value: LetCastDerivation.create(joined, first: first, pastEnd: pastEnd, constant: kept))
	end 'deriveLetCastConstant'

	function derivedConstantIsUnproven(value ValueId) returns bool
		let derivation = try self.letCastState().derived.get(value) otherwise return false

		return match derivation.constant 'kind'
			unknown gives true
			integer or
			real gives false
		end 'kind'
	end 'derivedConstantIsUnproven'

	function readsFitDestination(value ValueId, first ElementIndex, destination RangedTypeAlias) returns bool
		if self.pos == first + 1 'aSingleRead'
			return true
		end 'aSingleRead'

		let derivation = try self.letCastState().derived.get(value) otherwise return false
		return letCastConstantFits(derivation.constant, alias: destination)
	end 'readsFitDestination'

	function claimBesideATypedPartner(reads LetCastRoster, tracked ValueId, partner ValueId, partnerReads LetCastRoster)
		if rosterIsEmpty(reads) or not rosterIsEmpty(partnerReads) or self.valueIsAPlainConstant(partner) or self.derivedConstantIsUnproven(tracked) 'noTypedPartner'
			return
		end 'noTypedPartner'

		let identity = self.operandAliasName(partner)

		if identity.isEmpty() or not identity.equals(self.operandAliasName(tracked)) 'aDifferentType'
			return
		end 'aDifferentType'

		self.claimLetCastReadsBy(reads, rule: LetCastClaimRule.everyRead)
	end 'claimBesideATypedPartner'

	function claimLetCastsThroughACast(reads LetCastRoster, admitted DeclaredAlias)
		match admitted 'target'
			undeclared then return
			declared(alias) then self.claimLetCastReadsBy(reads, rule: LetCastClaimRule.readsNamingAnotherThan(alias))
		end 'target'
	end 'claimLetCastsThroughACast'

	// ⭐⭐ **REFUSE A BARE TYPE NAME MORE THAN ONE VISIBLE DECLARATION COULD MEAN — E3063.**
	//
	// ⭐ **ONE RAISE SITE COVERS ALL THREE POSITIONS**, because a cast TARGET is read through
	// `parseTypeReference` like any other type reference (`parseCast` calls it directly). So a parameter, a
	// field, a return clause, a body `as` and a top-level constant's `as` all arrive here, and the anchor is
	// the NAME token — the one the user has to rewrite.
	//
	// ⚠ **GATED ON `allFilesFolded`, and that is the only correct answer rather than a defensive one**: the
	// tolerant declaration sweep reads declared types through this same routine while the very index this
	// verdict is taken from is still being built, so a refusal there would be a fact about how far the sweep
	// had got — the identical argument the alias-registry arms above it make for themselves.
	//
	// The NAME is a parameter rather than read off `anchor`, because the two can differ: an extension body's
	// associated type is substituted to the conformer's binding before any arm resolves it
	// (`parseTypeReference`), and it is that BINDING whose meaning has to be unambiguous — the author's
	// `Element` names one thing by construction. `anchor` stays the token a reader is pointed at, which is
	// still the one they wrote.
	function requireUnambiguousTypeName(name ByteArray, anchor Token) throws SourceParseError
		try self.settleTypeNameVerdict(try self.bareTypeNameVerdict(name, anchor: anchor))
	end 'requireUnambiguousTypeName'

	function bareTypeNameVerdict(name ByteArray, anchor Token) returns TypeNameVerdict throws SourceParseError
		if not self.signatures.allFilesFolded 'theIndexIsStillBeingBuilt'
			return TypeNameVerdict.nameable
		end 'theIndexIsStillBeingBuilt'

		let hiding = try self.settledTypeNameHiding(name, anchor: anchor)

		if not anchor.value.equals(name) 'notTheAuthorsSpellingOfTheName'
			return TypeNameVerdict.nameable
		end 'notTheAuthorsSpellingOfTheName'

		return typeNameVerdictOf(hiding, noun: name, anchor: anchor)
	end 'bareTypeNameVerdict'

	function refuseHiddenTypeName(verdict TypeNameVerdict) throws ConstEvalError
		try self.requireTypeNameVerdictNameable(verdict) otherwise (err) 'hidden'
			throw ConstEvalError.defective(err)
		end 'hidden'
	end 'refuseHiddenTypeName'

	function requireTypeNameVerdictNameable(verdict TypeNameVerdict) throws SourceParseError
		match verdict 'verdict'
			nameable then return
			hidden(kind, tier, noun, _, anchor) then throw SourceParseError.symbolNotVisible(kind, symbol: String.from(noun), tier: tier, line: anchor.line, column: anchor.column)
		end 'verdict'
	end 'requireTypeNameVerdictNameable'

	function settledTypeNameHiding(name ByteArray, anchor Token) returns TypeNameHiding throws SourceParseError
		if let settled = try self.settledTypeNames.get(name) 'settledInThisFile'
			return settled
		end 'settledInThisFile'

		let candidates = self.signatures.ambiguousAliasCandidates(name, readerFilePath: self.job.path)

		if candidates.isAmbiguous() 'severalMeanings'
			throw ambiguousTypeNameRefusal(name, candidates: candidates.names, anchor: anchor)
		end 'severalMeanings'

		let hiding = self.signatures.typeNameHidingFrom(name, readerFilePath: self.job.path)
		self.settledTypeNames.upsert(name, value: hiding)
		return hiding
	end 'settledTypeNameHiding'

	function resolveChainAt(index ElementIndex, use ChainUse) returns ChainResolution
		return resolveChain(self.tokens, at: index, signatures: self.signatures, readerFilePath: self.job.path, headIsAValue: use == ChainUse.memberReference and self.baseNamesAValueAt(index), use: use)
	end 'resolveChainAt'

	function chainTypeVerdict(declaration ChainType, anchor Token) returns TypeNameVerdict
		return match declaration.standing 'standing'
			nameable gives TypeNameVerdict.nameable
			hidden(kind, tier) gives TypeNameVerdict.hidden(kind, tier: tier, noun: declaration.written, nominal: self.nominalOfHiddenChain(declaration), anchor: anchor)
		end 'standing'
	end 'chainTypeVerdict'

	function namesThisBodysNestedFunctionAlias(name ByteArray) returns bool
		if not self.signatures.allFilesFolded or not self.signatures.isFunctionAliasInAnyFile(name) 'noFunctionAliasHoldsTheName'
			return false
		end 'noFunctionAliasHoldsTheName'

		if not self.enclosingType.isType() 'noEnclosingType'
			return false
		end 'noEnclosingType'

		return self.signatures.isFunctionAliasInAnyFile(self.innerAliasKey(name))
	end 'namesThisBodysNestedFunctionAlias'

	function namespaceQualifiedType(kind TypeDeclKind, declFilePath FilePath, name ByteArray) returns MaxonType
		match kind 'kind'
			rangedAlias then return MaxonType.named(self.artifact.typeNames.intern(self.signatures.declarationIdentityOf(name, kind: kind, declFilePath: declFilePath)))
			functionAlias then return MaxonType.function(self.artifact.typeNames.intern(self.signatures.declarationIdentityOf(name, kind: kind, declFilePath: declFilePath)))
			genericAlias then return self.genericAliasDenotedType(self.signatures.aliasFamilyIdentity(name), readerFilePath: declFilePath)
			tupleAlias then return self.signatures.tupleAliasDenotedType(self.signatures.aliasFamilyIdentity(name), readerFilePath: declFilePath, into: self.artifact.typeNames)
			structType or
			enumType or
			unionType or
			interfaceType then return self.qualifiedNominalType(name, kind: kind)
		end 'kind'
	end 'namespaceQualifiedType'

	function qualifiedNominalType(name ByteArray, kind TypeDeclKind) returns MaxonType
		match kind 'kind'
			structType then return MaxonType.structRef(self.artifact.typeNames.intern(name))
			enumType or
			unionType then return MaxonType.named(self.artifact.typeNames.intern(name))
			interfaceType then return MaxonType.interfaceRef(self.artifact.typeNames.intern(name))
			rangedAlias or
			functionAlias or
			genericAlias or
			tupleAlias then panic("Parser.qualifiedNominalType: '{String.from(name)}' is filed as a {kind.name} — a qualified nominal is one of the four nominal kinds")
		end 'kind'
	end 'qualifiedNominalType'

	function typeNameReaderAt(index ElementIndex) returns FilePath
		if self.qualifiedTypeBaseIsAt(index) 'theQualifiedBase'
			return self.qualifiedTypeBaseFile()
		end 'theQualifiedBase'

		return self.job.path
	end 'typeNameReaderAt'

	function enterQualifiedChainAtCursor(minimumDots ElementIndex) returns ChainResolution throws SourceParseError
		let chain = self.resolveQualifiedChainAtCursor(minimumDots)
		try self.enterResolvedChain(chain)
		return chain
	end 'enterQualifiedChainAtCursor'

	function resolveQualifiedChainAtCursor(minimumDots ElementIndex) returns ChainResolution
		if self.dottedChainLengthAt(self.pos) < minimumDots 'tooShortToResolveHere'
			return UnqualifiedChain
		end 'tooShortToResolveHere'

		return self.resolveChainAt(self.pos, use: ChainUse.memberReference)
	end 'resolveQualifiedChainAtCursor'

	function enterResolvedChain(chain ChainResolution) throws SourceParseError
		match chain 'chain'
			declaredType(declaration, consumed) then try self.settleTypeNameVerdict(self.enterChainType(declaration, consumed: consumed, anchor: self.current()))
			ambiguous(written, candidates) then throw ambiguousTypeNameRefusal(written, candidates: candidates, anchor: self.current())
			nothing(qualifier) then try self.requireNoCallToNothing(qualifier)
			unqualified or
			value or
			declaredFunction then break
		end 'chain'
	end 'enterResolvedChain'

	function settleTypeNameVerdict(verdict TypeNameVerdict) throws SourceParseError
		if self.job.initializerRole != InitializerRole.ordinary 'aDiscardedArtifact'
			try self.requireTypeNameVerdictNameable(verdict)
			return
		end 'aDiscardedArtifact'

		match verdict 'verdict'
			nameable then return
			hidden(kind, tier, noun, nominal, anchor) then self.recordRefusedHiddenTypeName(kind, tier: tier, noun: noun, nominal: nominal, anchor: anchor)
		end 'verdict'
	end 'settleTypeNameVerdict'

	function recordRefusedHiddenTypeName(kind HiddenSymbolKind, tier Visibility, noun ByteArray, nominal HiddenNominal, anchor Token)
		let site = positionKey(anchor.line, column: anchor.column)

		if self.refusedHiddenSites.contains(site) 'alreadyRefusedHere'
			return
		end 'alreadyRefusedHere'

		self.refusedHiddenSites.insert(site)
		self.artifact.recordHiddenTypeName(hiddenSymbolDiagnostic(kind, noun: String.from(noun), tier: tier, line: anchor.line, column: anchor.column, filePath: self.job.path))

		match kind 'kind'
			typeDeclaration or
			typeAliasDeclaration then self.recordHiddenNominal(nominal)
			functionDeclaration or
			staticMember then panic("recordRefusedHiddenTypeName: a type-name verdict is hidden as a type or a typealias, never as a function or a static")
		end 'kind'
	end 'recordRefusedHiddenTypeName'

	function recordHiddenNominal(nominal HiddenNominal)
		match nominal 'nominal'
			none then return
			named(name) then self.artifact.hiddenTypeDeclarations.push(name)
			aliasSpelled(written) then self.recordNominalOfSpelledAlias(written)
		end 'nominal'
	end 'recordHiddenNominal'

	function recordNominalOfSpelledAlias(written ByteArray)
		if not self.signatures.allFilesFolded 'theIndexIsStillBeingBuilt'
			return
		end 'theIndexIsStillBeingBuilt'

		if not self.signatures.isAliasOfFormFor(written, readerFilePath: self.job.path, wanted: FormAliasKind.generic) 'noInstanceToDenote'
			return
		end 'noInstanceToDenote'

		self.artifact.hiddenTypeDeclarations.push(self.signatures.genericInstanceBaseName(self.signatures.genericAliasInstanceFrom(written, readerFilePath: self.job.path)))
	end 'recordNominalOfSpelledAlias'

	function nominalOfHiddenChain(declaration ChainType) returns HiddenNominal
		match declaration.kind 'kind'
			structType or
			enumType or
			unionType or
			interfaceType then return HiddenNominal.named(declaration.name)
			genericAlias then return self.nominalOfHiddenGenericAlias(declaration)
			rangedAlias or
			functionAlias or
			tupleAlias then return HiddenNominal.none
		end 'kind'
	end 'nominalOfHiddenChain'

	function nominalOfHiddenGenericAlias(declaration ChainType) returns HiddenNominal
		if not self.signatures.allFilesFolded 'theIndexIsStillBeingBuilt'
			return HiddenNominal.none
		end 'theIndexIsStillBeingBuilt'

		return HiddenNominal.named(self.signatures.genericInstanceBaseName(self.signatures.genericAliasInstanceFrom(self.signatures.aliasFamilyIdentity(declaration.name), readerFilePath: declaration.declFilePath)))
	end 'nominalOfHiddenGenericAlias'

	function requireNoCallToNothing(qualifier ByteArray) throws SourceParseError
		if not self.chainCallFollowsAt(self.pos) 'notACall'
			return
		end 'notACall'

		throw self.chainNamesNothingRefusal(self.pos, qualifier: qualifier)
	end 'requireNoCallToNothing'

	function chainNamesNothingRefusal(headIndex ElementIndex, qualifier ByteArray) returns SourceParseError
		let dots = self.dottedChainLengthAt(headIndex)
		let memberTok = self.tokenAt(headIndex + dots * TokensPerQualifierSegment)
		return SourceParseError.undefinedQualifiedFunction(String.from(self.assembleDottedChainAt(headIndex, dots: dots)), qualifier: String.from(qualifier), line: memberTok.line, column: memberTok.column)
	end 'chainNamesNothingRefusal'

	function enterQualifiedTypeHead(form TypeNameHeadForm) returns TypeNameVerdict throws SourceParseError
		if not self.qualifiedTypeHeadAt(self.pos, form: form) 'noQualifiedHead'
			return TypeNameVerdict.nameable
		end 'noQualifiedHead'

		match self.resolveChainAt(self.pos, use: ChainUse.typeReference) 'chain'
			declaredType(declaration, consumed) then return self.enterChainType(declaration, consumed: consumed, anchor: self.current())
			ambiguous(written, candidates) then throw ambiguousTypeNameRefusal(written, candidates: candidates, anchor: self.current())
			unqualified or
			value or
			declaredFunction or
			nothing then return TypeNameVerdict.nameable
		end 'chain'
	end 'enterQualifiedTypeHead'

	function enterChainType(declaration ChainType, consumed ElementIndex, anchor Token) returns TypeNameVerdict
		let typeIndex = self.pos + consumed * TokensPerQualifierSegment

		if isTypeAliasDecl(declaration.kind) 'anAliasBase'
			self.recordQualifiedTypeNameUse(declaration.written)
		end 'anAliasBase' else 'aNominalBase'
			self.recordTypeNameUse(declaration.written)
		end 'aNominalBase'

		self.statement.qualifiedTypeBase = QualifiedTypeBase.at(typeIndex, name: self.namespaceQualifiedBaseName(declaration.written, kind: declaration.kind, declFilePath: declaration.declFilePath, name: declaration.name), declFilePath: declaration.declFilePath.clone())
		self.pos = typeIndex
		return self.chainTypeVerdict(declaration, anchor: anchor)
	end 'enterChainType'

	function namespaceQualifiedBaseName(qualified immutable ByteArray, kind TypeDeclKind, declFilePath FilePath, name immutable ByteArray) returns immutable ByteArray
		match kind 'kind'
			rangedAlias or
			functionAlias then return self.signatures.declarationIdentityOf(name, kind: kind, declFilePath: declFilePath)
			genericAlias or
			tupleAlias then return qualified
			structType or
			enumType or
			unionType or
			interfaceType then return name
		end 'kind'
	end 'namespaceQualifiedBaseName'

	function parseUnary(func IrFunction) returns ValueId throws SourceParseError
		if self.at(TokenKind.minus) 'neg'
			let opTok = try self.consume(TokenKind.minus)

			// ⭐ **A LEADING `-` ON A LITERAL IS PART OF THE LITERAL**, not an operator over it. Treating it as an operator
			// gives two wrong answers:
			//
			//   • `-9223372036854775808` is exactly `i64.min`, but its MAGNITUDE (`i64.max + 1`) does
			//     not fit a positive i64 — so reading the magnitude first would report E2011 on a literal
			//     that is perfectly in range. `parseNegatedInt` knows this, and the range-bound
			//     reader and the expression parser ask the same decoder.
			//   • `-0.0` read as an operator is `0.0 - 0.0`, which IEEE-754 says is `+0.0`. A sign flip is
			//     `negatedFloatBits`, and the declaration/range-bound paths spell it that way;
			//     a subtract-from-zero loses the zero's sign. (A
			//     non-literal `-x` also flips the bit at run time — `MaxonUnaryOp.fneg`, below — so
			//     the fold here is an op saved, not the only correct spelling.)
			//
			// It also costs one op fewer for every negative literal, which is why `let x = -5` emits a single
			// negative immediate rather than `mov 5; neg`.
			if self.at(TokenKind.intLiteral) or self.at(TokenKind.floatLiteral) 'negatedLiteral'
				return try self.parseNegatedNumericLiteral(opTok)
			end 'negatedLiteral'

			let operand = try self.parseUnclaimedPrimaryChain(func)

			// ⭐ **A PREFIX `-` IS A QUESTION ABOUT THE NUMBER, SO IT ASKS `numberTagOf`.** Both
			// PREFIX operators are emitted here rather than through `emitBinOp`/`emitShift`, and reading
			// `tagOf` would be a SECOND answer to the operand-domain question those two ask through
			// the door: a float-backed enum's `named` tag is not `tagIsFloat`, so `-Weight.light` would take the
			// integer arm and print `-4612811918334230528` — the negated IEEE-754 bits.
			let operandTag = self.numberTagOf(operand)

			if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
				throw SourceParseError.nonNumericNegation(self.valueKindWordAt(operand, tag: operandTag), line: opTok.line, column: opTok.column)
			end 'notANumber'

			// The DECODE is paid only past that refusal, for `emitBinOp`'s stated reason: a rejected
			// program must leave no ops behind. Every non-enum value passes through untouched, so the
			// integer arm below negates exactly what it negated before.
			//
			// ⭐ A float `-x` is `MaxonUnaryOp.fneg` — a SIGN-BIT FLIP, not `0.0 - x`. The subtract was
			// wrong on exactly one input (`0.0 - (+0.0)` is `+0.0`), and `print` made that observable:
			// `let z = 0.0; print("{-z}")` printed `0.0`. See the enum member for the trade it replaced.
			if tagIsFloat(operandTag) 'float'
				let decoded = self.floatBehindEnumValue(operand, anchor: opTok)
				let flipped = self.emitUnaryOp(decoded, op: MaxonUnaryOp.fneg, resultTag: ValueTypeTag.float, range: SourceRange.ofToken(opTok))
				self.adoptOperandAlias(flipped, alias: OperandAlias.named(self.operandAliasName(operand)), resultTag: ValueTypeTag.float)
				self.settleFloatUnaryOp(flipped, operand: decoded, op: MaxonUnaryOp.fneg)
				return flipped
			end 'float'

			// ⭐⭐ **THE NEGATION OF AN INTEGRAL VALUE IS AN `integer`, WHATEVER TYPE IT WAS SPELLED WITH —
			// the answer `notOperatorFor` already gives the OTHER prefix operator for `named to exitCode`,
			// and it has to be this one's too.** The float arm has returned, so every tag still
			// here is integral, and negating leaves the declared type in every case that had one: `-x` for
			// an `int(0 to 255)` x is not an `int(0 to 255)`, and `-Level.high` is not a `Level`.
			//
			// ⛔ **CARRYING THE OPERAND'S TAG IS A WRONG ANSWER, AND IT IS THE NAME COLUMN THAT MAKES IT
			// ONE.** `emitUnaryOp` mints with `nameId: UnnamedTypeId` — correct, the result names no type —
			// so a `named` result tag leaves the value claiming a declared type with the FILLER id in its name
			// column. Every reader of a declared alias gates on the tag and then reads that id, and the
			// filler is INDISTINGUISHABLE from the first real name the file interned (`UnnamedTypeId` is 0
			// and `TypeNameInterner` starts empty), so the alias registry answers about a stranger.
			// **MEASURED:** `enum Level  high = 200` then `print("{-Level.high}")` printed
			// `18446744073709551416` — the unsigned rendering, selected because the file's id 0 happened to
			// be a non-negative ranged alias. The decimal
			// formatter, a consumer of the domain besides the divide, is what reaches it. Pinned by `enums-simple/float-backed-negation`, whose int-backed
			// half is exactly this value.
			let negatedAlias = self.operandAliasName(operand)

			if self.namesAFullWidthAlias(OperandAlias.named(negatedAlias)) 'aFullWidthQuantity'
				throw SourceParseError.registryRefused(ErrorCode.semanticUnsignedNegation, explanation: unsignedNegationMessage(String.from(negatedAlias)), line: opTok.line, column: opTok.column, note: DiagnosticNote.none)
			end 'aFullWidthQuantity'

			let negated = self.emitUnaryOp(operand, op: MaxonUnaryOp.neg, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(opTok))

			// ⭐⭐ **A NEGATION KEEPS ITS OPERAND'S TYPEALIAS ONLY WHERE THAT ALIAS HOLDS THE RESULT** — a
			// full-width alias closed under word arithmetic, or one whose range covers the negated interval.
			// `-d` over an `int(-100 to 100)` is a `Delta`; `-b` over an `int(0 to 100)` is an unnamed signed
			// value whose range is [-100, 0], and it needs `as` to reach an alias slot.
			self.adoptUnaryResultAlias(negated, operand: operand, op: MaxonUnaryOp.neg, resultTag: ValueTypeTag.integer)

			// ⭐ **A `-` OVER A FOLDABLE NON-LITERAL IS STILL A NEGATIVE THE SOURCE WROTE** — `-K` for a
			// top-level `let K = 1` folds to the same `-1` the literal arm above mints, and a mark on only one
			// of the two would refuse `f(-1)` while accepting `f(-K)`. ⚠ Only `neg` earns the mark, never `bitNot`: `~0` is
			// `0xFFFFFFFFFFFFFFFF` written as an all-ones MASK, and reading it as `-1` would refuse a value
			// `int(0 to u64.max)` exists to hold.
			if self.constIsKnown(negated) 'foldedToAConstant'
				self.markWrittenNegative(negated, value: self.constOf(negated))
			end 'foldedToAConstant'

			return negated
		end 'neg'

		if self.at(TokenKind.not) 'not'
			let opTok = try self.consume(TokenKind.not)
			let operand = try self.parseUnclaimedUnary(func)

			// `numberTagOf` for the `-` arm's reason, and it decides the same thing `emitShift` decides
			// with it: `not` is a bitwise operator, a double's bits are a sign/exponent/mantissa triple,
			// so a float-backed enum is REFUSED here in `not`'s own words rather than complementing an
			// encoding. Nothing is emitted on this path for a float, so there is no decode to place.
			let operandTag = self.numberTagOf(operand)

			match notOperatorFor(operandTag) 'which'
				op(kind, resultTag) then return self.emitNot(operand, op: kind, resultTag: resultTag, opTok: opTok)
				unknownOperandType then return try self.deferredResultOrRefusal(SourceParseError.notOnUnknownType(opTok.line, column: opTok.column), value: operand)
				nonIntegralOperand then throw SourceParseError.nonIntegralOperands(opTok.kind.rawValue, operand: self.valueKindWordAt(operand, tag: operandTag), line: opTok.line, column: opTok.column)
			end 'which'
		end 'not'

		// `async <call>` SPAWNS a green thread and yields a Promise; `await <expr>` blocks on one.
		// Both are prefix operators, alongside `-`/`not`. `async` must be followed by a call — a free one or a
		// `<Type>.<static>` — while `await` takes a unary operand (so `await async f()` — spawn then immediately
		// await — parses).
		if self.at(TokenKind.async) 'async'
			try self.consume(TokenKind.async)
			return try self.parseAsyncCall(func)
		end 'async'

		// `spawn <T>.<factory>(…)` STARTS A SERVICE and yields a `<T>.handle` — the third prefix operator, and
		// the only one that is not a lexer keyword (see `SpawnKeywordName` for the two live declarations of
		// the word that forbid one).
		if self.atSpawnPrefix() 'spawn'
			return try self.parseSpawn(func, handling: SpawnStartHandling.routed)
		end 'spawn'

		if self.at(TokenKind.await) 'await'
			return try self.parseAwait(func)
		end 'await'

		if regionOperatorAt(self.tokens, index: self.pos) 'regionOperator'
			return try self.parseRegionOperator(func)
		end 'regionOperator'

		let operandStart = self.bodyState.operandOrder.eventCount()
		return try self.parsePostfix(func, operandStart: operandStart, value: try self.parsePrimary(func), resultUsed: true)
	end 'parseUnary'

	function parseRegionOperator(func IrFunction) returns ValueId throws SourceParseError
		let opTok = self.current()
		self.advance()

		if opTok.value.equals(FreezeOperatorWord) 'freeze'
			return try self.parseFreeze(func, opTok: opTok)
		end 'freeze'

		if opTok.value.equals(MergeOperatorWord) 'merge'
			return try self.parseMerge(func, opTok: opTok)
		end 'merge'

		return try self.parseSwap(func, opTok: opTok)
	end 'parseRegionOperator'

	function parseFreeze(func IrFunction, opTok Token) returns ValueId throws SourceParseError
		let operandStart = self.pos
		let tempFloor = self.bodyState.pendingTempDrops.count()
		let ownedFloor = self.bodyState.ownedBindings.count()
		let operand = try self.parseUnclaimedUnary(func)

		if self.valueIsAValueType(operand) 'aValue'
			throw self.regionRefusal(ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, message: "'{self.pathTextOf(operandStart)}' is a value and is already immutable; `freeze` applies to a record", line: opTok.line, column: opTok.column)
		end 'aValue'

		if self.effectiveCapabilityOf(operand) != ValueCapability.immutable 'notYetFrozen'
			try self.recoverIsolated(operand, startIndex: operandStart, site: IsolatedRecoverySite.freeze)
		end 'notYetFrozen'

		try self.requireNotUniqueFor(operand, verb: "frozen", anchor: self.tokenAt(operandStart))

		let frozenOperand = ValueIdArray.create(1, zeroed: false)
		frozenOperand.push(operand)
		self.releaseHandOffBuildTemps(tempFloor, ownedFloor: ownedFloor, handedOff: frozenOperand, anchor: opTok)

		match self.transferWalkOfValue(operand) 'graph'
			refused(noun) then throw self.unwalkableTransferGraphError(operand, blame: "a `freeze`", noun: noun, anchor: opTok)
			closed or
			walkedBy or
			walkedThroughWitness then break
		end 'graph'

		self.emitTransferGraphProof(operand, anchor: opTok)

		var frozen = operand

		if self.rhsWasBareLocalReference(operandStart) 'movesTheLocal'
			frozen = self.movedAliasOf(operand, range: SourceRange.ofToken(opTok))
		end 'movesTheLocal'

		self.setValueCapability(frozen, capability: ValueCapability.immutable)
		self.forgetUndecidedResult(frozen)
		return frozen
	end 'parseFreeze'

	function movedAliasOf(value ValueId, range SourceRange) returns ValueId
		let owned = self.valueIsOwnedHeap(value)
		let exclusivity = OwnedHeapExclusivity.sole if self.valueIsSoleHeapOwner(value) else OwnedHeapExclusivity.coOwned

		self.poisonMoveSource(value)

		let alias = self.emitRetaggedCastValue(value, targetType: self.typeOf(value), range: range)
		self.carryInterfaceWitness(alias, from: value)
		self.carryFromSharedRecord(alias, from: value, source: self.bodyState, path: ValueCarryPath.copy)

		if owned 'handsOverTheDrop'
			self.trackOwnedTemp(alias, exclusivity: exclusivity)
		end 'handsOverTheDrop'

		return alias
	end 'movedAliasOf'

	function parseMerge(func IrFunction, opTok Token) returns ValueId throws SourceParseError
		let operandStart = self.pos
		let operand = try self.parseUnclaimedUnary(func)
		try self.requireNotAnAcquiredState(operand, verb: "merged", anchor: self.tokenAt(operandStart))
		try self.requireNotAnIsolatedSlotRead(operand, startIndex: operandStart, endIndex: self.pos, anchor: opTok)

		if self.valueIsAValueType(operand) or self.effectiveCapabilityOf(operand) != ValueCapability.isolated 'notIsolated'
			throw self.regionRefusal(ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, message: "'{self.pathTextOf(operandStart)}' is not an isolated value; `merge` moves an isolated region into the current one", line: opTok.line, column: opTok.column)
		end 'notIsolated'

		var merged = operand

		if self.rhsWasBareLocalReference(operandStart) 'movesTheLocal'
			merged = self.movedAliasOf(operand, range: SourceRange.ofToken(opTok))
		end 'movesTheLocal'

		self.setValueCapability(merged, capability: ValueCapability.mutable)
		self.regionFactsForWrite().mergedValues.insert(merged)
		return merged
	end 'parseMerge'

	function parseSwap(func IrFunction, opTok Token) returns ValueId throws SourceParseError
		let pathStart = self.pos
		let old = try self.parseUnclaimedUnary(func)
		let pathText = self.pathTextOf(pathStart)
		let origin = try self.regionFactsForRead().fieldOrigins.get(old) otherwise throw self.regionRefusal(ErrorCode.semanticIsolatedReadOutsideBlock, message: "`swap` takes the isolated field or element '{pathText}' names out of its slot, and '{pathText}' is neither", line: opTok.line, column: opTok.column)

		if origin.slot != ParamCapability.isolated 'notAnIsolatedSlot'
			throw self.regionRefusal(ErrorCode.semanticIsolatedReadOutsideBlock, message: "'{pathText}' is not an isolated field, so there is no region for `swap` to take out", line: opTok.line, column: opTok.column)
		end 'notAnIsolatedSlot'

		try self.requireSlotHolderWritable(old, placeText: pathText, pathText: pathText, action: "swapped", line: opTok.line, column: opTok.column)
		try self.requireIsolatedSlotHolderWritable(origin.holder, placeText: pathText, line: opTok.line, column: opTok.column)

		try self.consume(TokenKind.with)
		let valueStart = self.pos
		let replacement = try self.parseUnclaimedUnary(func)
		try self.recoverIsolated(replacement, startIndex: valueStart, site: IsolatedRecoverySite.swapReplacement)

		self.notePassedParamNeed(func, value: origin.holder, mutable: true, line: opTok.line)
		self.emitIncref(old, range: SourceRange.ofToken(opTok))
		try self.emitFieldWrite(origin.holder, layout: self.layoutOfOrigin(origin), index: origin.field, value: replacement, argBareLocal: self.rhsWasBareLocalReference(valueStart), anchor: opTok, range: SourceRange.ofToken(opTok))
		self.trackOwnedTemp(old, exclusivity: OwnedHeapExclusivity.sole)
		self.setValueCapability(old, capability: ValueCapability.isolated)
		_ = self.regionFactsForWrite().fieldOrigins.remove(old)
		return old
	end 'parseSwap'

	function requireNotUniqueFor(value ValueId, verb String, anchor Token) throws SourceParseError
		try self.requireNoUniqueCause(self.uniqueCauseOfValue(value), subject: self.valueDisplayTypeName(value), verb: verb, anchor: anchor)
	end 'requireNotUniqueFor'

	function uniqueCauseOfValue(value ValueId) returns UniqueCause
		return self.signatures.valueUniqueCause(self.tagOf(value), nameId: self.valueNameId(value), from: self.artifact.typeNames)
	end 'uniqueCauseOfValue'

	function requireNoUniqueCause(cause UniqueCause, subject String, verb String, anchor Token) throws SourceParseError
		match cause 'cause'
			none then return
			declared then throw self.regionRefusal(ErrorCode.semanticUniqueValueRefused, message: "'{subject}' is unique and cannot be {verb}", line: anchor.line, column: anchor.column)
			holds(field, held) then throw self.regionRefusal(ErrorCode.semanticUniqueValueRefused, message: "'{subject}' is unique (its field '{String.from(field)}' holds a unique '{String.from(held)}') and cannot be {verb}", line: anchor.line, column: anchor.column)
		end 'cause'
	end 'requireNoUniqueCause'

	function receiverIsPassed(receiver ReceiverArg) returns bool
		return match receiver 'shape'
			none or
			unavailable gives false
			value gives true
		end 'shape'
	end 'receiverIsPassed'

	function receiverTokenOf(receiver ReceiverArg, fallback Token) returns Token
		return match receiver 'shape'
			none or
			unavailable gives fallback
			value(_, _, tok, _) gives tok
		end 'shape'
	end 'receiverTokenOf'

	function receiverSpanOf(receiver ReceiverArg) returns TokenSpan
		return match receiver 'shape'
			none or
			unavailable panic("receiverSpanOf: a call with no receiver has no receiver span — every caller asks only after `receiverIsPassed`")
			value(_, _, _, extent) gives self.receiverExtentSpan(extent)
		end 'shape'
	end 'receiverSpanOf'

	function receiverExtentSpan(extent ReceiverExtent) returns TokenSpan
		return match extent 'shape'
			writtenBefore(dotIndex) gives TokenSpan.create(self.receiverStartBefore(dotIndex), endIndex: dotIndex)
			implicitAt(nameIndex) gives TokenSpan.create(nameIndex, endIndex: nameIndex + 1)
		end 'shape'
	end 'receiverExtentSpan'

	function writtenReceiver(value ValueId, immutableName immutable ByteArray, anchor Token) returns ReceiverArg
		return ReceiverArg.value(value, immutableName: immutableName, anchor: anchor, extent: ReceiverExtent.writtenBefore(self.pos - 1))
	end 'writtenReceiver'

	function receiverStartBefore(dotIndex ElementIndex) returns ElementIndex
		var start = dotIndex

		while start > 0 'eachChainPart'
			let last = start - 1
			let kind = self.kindAt(last)

			if tokenKindClosesAGroup(kind) 'aGroup'
				start = self.parenGroups.openOf(self.tokens, close: last)

				if start == 0 or not self.chainContinuesBefore(start) 'theGroupOpensTheChain'
					break
				end 'theGroupOpensTheChain'
			end 'aGroup' else if tokenKindIsPostfixChainPart(kind) and kind != TokenKind.dot 'aName'
				start = last

				if start == 0 or self.kindAt(start - 1) != TokenKind.dot 'theNameOpensTheChain'
					break
				end 'theNameOpensTheChain'

				start = start - 1
			end 'aName' else 'notPartOfTheChain'
				break
			end 'notPartOfTheChain'
		end 'eachChainPart'

		return start
	end 'receiverStartBefore'

	function chainContinuesBefore(opener ElementIndex) returns bool
		let kind = self.kindAt(opener - 1)
		return tokenKindClosesAGroup(kind) or (tokenKindIsPostfixChainPart(kind) and kind != TokenKind.dot)
	end 'chainContinuesBefore'

	function declaredResultCapability(callee ByteArray, declaration SweptDeclaration) returns ResultCapability
		if declaration.returnCapability != ResultCapability.unmarked 'writtenOnTheFunction'
			return declaration.returnCapability
		end 'writtenOnTheFunction'

		let aliasName = try self.signatures.returnAliasNameOf(callee) otherwise return ResultCapability.unmarked
		return resultCapabilityOf(self.signatures.aliasCapabilityOf(aliasName, readerFilePath: declaration.declFilePath))
	end 'declaredResultCapability'

	function resultCapabilityDeclaredFor(callee ByteArray) returns ResultCapability
		let declaration = try self.declarationNameableHere(callee) otherwise return ResultCapability.unmarked
		return self.declaredResultCapability(callee, declaration: declaration)
	end 'resultCapabilityDeclaredFor'

	function declaredArgumentCapability(declaration SweptDeclaration, argColumn ParamCount, label ByteArray) returns ParamCapability
		let position = try argSlotPosition(declaration.paramNames, argIndex: argColumn, label: label) otherwise return ParamCapability.unmarked
		return self.signatures.declaredParamCapability(declaration, position: position)
	end 'declaredArgumentCapability'

	function parameterIsOpaque(declaration SweptDeclaration, argColumn ParamCount, label ByteArray) returns bool
		let position = try argSlotPosition(declaration.paramNames, argIndex: argColumn, label: label) otherwise return false
		let paramType = try declaration.paramTypes.get(position) otherwise return false
		return maxonTypeTag(paramType) == ValueTypeTag.typeParameter
	end 'parameterIsOpaque'

	function checkCallCapabilities(func IrFunction, callee ByteArray, args ValueIdArray, argAnchors TokenIndexArray, argLabels NameRoster, receiver ReceiverArg, anchor Token, spawning CallSpawning) returns bool throws SourceParseError
		let declaration = try self.declarationNameableHere(callee) otherwise return false
		let receiverFirst = self.receiverIsPassed(receiver)

		if receiverFirst and declaration.selfCapability == ParamCapability.immutable 'aFrozenSelf'
			self.notePassedParamNeed(func, value: try args.get(0) otherwise panic("checkCallCapabilities: a call with a receiver carries it at argument 0"), mutable: false, line: anchor.line)
		end 'aFrozenSelf'

		let opensAnIsolatedValue = try self.openIsolatedPositions(callee, args: args, declaration: declaration, argAnchors: argAnchors, argLabels: argLabels, receiver: receiver, spawning: spawning)
		let firstSource = 1 if receiverFirst else 0

		for position in firstSource upto args.count() 'eachSourceArgument'
			let argument = try args.get(position) otherwise panic("checkCallCapabilities: args.get OOB at {position} below the count just read")
			let column = (position - firstSource) as ParamCount
			let declared = self.declaredArgumentCapability(declaration, argColumn: column, label: try argLabels.get(position) otherwise EmptySourceText)
			let writtenAtTheCall = position < argAnchors.count()

			if declared == ParamCapability.isolated and writtenAtTheCall and not self.declarationByRefConvention(callee).takesArgumentByRef(position as ParamCount, label: try argLabels.get(position) otherwise EmptySourceText) 'aMovedArgument'
				try self.requireByReferenceIsolatedStaysPut(func, value: argument, at: self.tokenAt(try argAnchors.get(position) otherwise panic("checkCallCapabilities: argAnchors.get OOB at {position} below the count just checked")))
			end 'aMovedArgument'

			if declared == ParamCapability.immutable and writtenAtTheCall and self.parameterIsOpaque(declaration, argColumn: column, label: try argLabels.get(position) otherwise EmptySourceText) 'aFrozenOpaqueParameter'
				try self.requireArgumentFrozen(func, callee: callee, declaration: declaration, argument: argument, anchorIndex: try argAnchors.get(position) otherwise panic("checkCallCapabilities: argAnchors.get OOB at {position} below the count just checked"), argColumn: column, label: try argLabels.get(position) otherwise EmptySourceText)
				self.noteStoredIntoImmutableSlot(argument)
			end 'aFrozenOpaqueParameter'

			if declared == ParamCapability.isolated and writtenAtTheCall 'anIsolatedArgument'
				try self.recoverIsolated(argument, startIndex: try argAnchors.get(position) otherwise panic("checkCallCapabilities: argAnchors.get OOB at {position} below the count just checked"), site: IsolatedRecoverySite.argument)
			end 'anIsolatedArgument'

			match declared 'declared'
				immutable then self.notePassedParamNeed(func, value: argument, mutable: false, line: anchor.line)
				mutable then self.notePassedParamNeed(func, value: argument, mutable: true, line: anchor.line)
				isolated or
				unmarked or
				consuming then break
			end 'declared'
		end 'eachSourceArgument'

		return opensAnIsolatedValue
	end 'checkCallCapabilities'

	function positionOpensItsValue(args ValueIdArray, declaration SweptDeclaration, argLabels NameRoster, receiverFirst bool, position ElementIndex) returns bool
		let argument = try args.get(position) otherwise panic("positionOpensItsValue: args.get OOB at {position}")

		if not self.valueIsIsolatedRegionData(argument) 'notAnIsolatedRegion'
			return false
		end 'notAnIsolatedRegion'

		if receiverFirst and position == 0 'theReceiver'
			return true
		end 'theReceiver'

		let firstSource = 1 if receiverFirst else 0
		let column = (position - firstSource) as ParamCount
		return self.declaredArgumentCapability(declaration, argColumn: column, label: try argLabels.get(position) otherwise EmptySourceText) == ParamCapability.unmarked
	end 'positionOpensItsValue'

	function nextOpenedPosition(args ValueIdArray, declaration SweptDeclaration, argLabels NameRoster, receiverFirst bool, start ElementIndex) returns ElementIndex throws AbsentError
		for position in start upto args.count() 'eachPosition'
			if self.positionOpensItsValue(args, declaration: declaration, argLabels: argLabels, receiverFirst: receiverFirst, position: position) 'anOpenedPosition'
				return position
			end 'anOpenedPosition'
		end 'eachPosition'

		throw AbsentError.absent
	end 'nextOpenedPosition'

	function positionIsTheReceiver(position ElementIndex, receiver ReceiverArg) returns bool
		return self.receiverIsPassed(receiver) and position == 0
	end 'positionIsTheReceiver'

	function openedPositionSpan(position ElementIndex, argAnchors TokenIndexArray, receiver ReceiverArg) returns TokenSpan
		if self.positionIsTheReceiver(position, receiver: receiver) 'theReceiver'
			return self.receiverSpanOf(receiver)
		end 'theReceiver'

		let startIndex = try argAnchors.get(position) otherwise panic("openedPositionSpan: argAnchors.get OOB at {position}")
		return TokenSpan.create(startIndex, endIndex: self.argumentEndIndex(startIndex))
	end 'openedPositionSpan'

	function openIsolatedPositions(callee ByteArray, args ValueIdArray, declaration SweptDeclaration, argAnchors TokenIndexArray, argLabels NameRoster, receiver ReceiverArg, spawning CallSpawning) returns bool throws SourceParseError
		let receiverFirst = self.receiverIsPassed(receiver)
		let first = try self.nextOpenedPosition(args, declaration: declaration, argLabels: argLabels, receiverFirst: receiverFirst, start: 0) otherwise return false
		let firstValue = try args.get(first) otherwise panic("openIsolatedPositions: args.get OOB at {first}")
		let firstSpan = self.openedPositionSpan(first, argAnchors: argAnchors, receiver: receiver)
		let firstTok = self.tokenAt(firstSpan.startIndex)

		match spawning 'spawning'
			spawned then throw self.regionRefusal(ErrorCode.semanticArgumentCapabilityRefused, message: "'{calleeSourceName(callee)}' is spawned with `async`, and '{String.from(firstTok.value)}' is isolated; an `async` call takes an isolated value only in an `isolated` parameter, which moves it", line: firstTok.line, column: firstTok.column)
			direct then break
		end 'spawning'

		let rootName = self.openedRootName(firstValue, openedTok: firstTok)

		if let second = try self.nextOpenedPosition(args, declaration: declaration, argLabels: argLabels, receiverFirst: receiverFirst, start: first + 1) 'aSecondRegion'
			let secondTok = self.tokenAt(self.openedPositionSpan(second, argAnchors: argAnchors, receiver: receiver).startIndex)
			let secondName = self.openedRootName(try args.get(second) otherwise panic("openIsolatedPositions: args.get OOB at {second}"), openedTok: secondTok)
			throw self.regionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: self.twoRootsMessage(rootName, second: secondName), line: secondTok.line, column: secondTok.column)
		end 'aSecondRegion'

		try self.recordCallOpen(firstValue, openedTok: firstTok)
		self.noteStateReached(firstValue, line: firstTok.line, column: firstTok.column)
		let facts = self.regionFactsForWrite()
		facts.pendingCallOpen = PendingCallOpen.opened(firstValue, range: SourceRange.ofToken(firstTok), label: rootName)

		for position in 0 upto args.count() 'eachOtherArgument'
			if position == first or self.valueIsCleanIntoARegion(try args.get(position) otherwise panic("openIsolatedPositions: args.get OOB at {position}")) 'staysInsideOrIsClean'
				continue
			end 'staysInsideOrIsClean'

			let span = self.openedPositionSpan(position, argAnchors: argAnchors, receiver: receiver)
			let argTok = self.tokenAt(span.startIndex)
			throw self.regionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: "'{self.tokenTextFrom(span.startIndex, endIndex: span.endIndex)}' is mutable outside '{String.from(rootName)}'; a call into an isolated region takes values, immutable or isolated", line: argTok.line, column: argTok.column)
		end 'eachOtherArgument'

		return true
	end 'openIsolatedPositions'

	function valueIsReadFromAnImmutableSlot(value ValueId) returns bool
		if valueIsMarked(self.bodyState.immutableSlotReads, value: value) 'anElementOrValueRead'
			return true
		end 'anElementOrValueRead'

		let origin = try self.regionFactsForRead().fieldOrigins.get(value) otherwise return false
		return origin.slot == ParamCapability.immutable
	end 'valueIsReadFromAnImmutableSlot'

	function notePassedParamNeed(func IrFunction, value ValueId, mutable bool, line LineNumber)
		if self.valueIsAnImmutableAggregate(value) or (not mutable and self.valueIsAValueType(value)) 'aValueNeedsNoFrozenData'
			return
		end 'aValueNeedsNoFrozenData'

		if not mutable and self.valueIsOpaque(value) and not valueIsAParameter(value, paramCount: func.paramCount) 'anOpaqueElementOfAParameter'
			return
		end 'anOpaqueElementOfAParameter'

		if not mutable and self.valueIsReadFromAnImmutableSlot(value) 'frozenByItsOwnSlot'
			return
		end 'frozenByItsOwnSlot'

		let reached = self.paramSourcesOf(func, value: value)

		if mutable or self.valueHasOtherPath(value) 'needsAWritableOne'
			func.needsMutableParamMask = func.needsMutableParamMask or reached
		end 'needsAWritableOne' else 'needsAFrozenOne'
			func.needsFrozenParamMask = func.needsFrozenParamMask or reached
		end 'needsAFrozenOne'

		self.noteUseSite(func, value: value, mutable: mutable, line: line)
	end 'notePassedParamNeed'

	function checkSendArgumentCapabilities(func IrFunction, callee ByteArray, args ValueIdArray, argAnchors TokenIndexArray, argLabels NameRoster, anchor Token) throws SourceParseError
		_ = try self.checkCallCapabilities(func, callee: callee, args: args, argAnchors: argAnchors, argLabels: argLabels, receiver: ReceiverArg.none, anchor: anchor, spawning: CallSpawning.direct)
		let declaration = try self.declarationNameableHere(callee) otherwise return

		for position in 0 upto argAnchors.count() 'eachSourceArgument'
			let label = try argLabels.get(position) otherwise EmptySourceText

			if self.declaredArgumentCapability(declaration, argColumn: position as ParamCount, label: label) != ParamCapability.immutable 'nothingToRefuse'
				continue
			end 'nothingToRefuse'

			try self.requireArgumentFrozen(func, callee: callee, declaration: declaration, argument: try args.get(position) otherwise panic("checkSendArgumentCapabilities: args.get OOB at {position} below the count just read"), anchorIndex: try argAnchors.get(position) otherwise panic("checkSendArgumentCapabilities: argAnchors.get OOB at {position} below its own count"), argColumn: position as ParamCount, label: label)
		end 'eachSourceArgument'
	end 'checkSendArgumentCapabilities'

	function requireArgumentFrozen(func IrFunction, callee ByteArray, declaration SweptDeclaration, argument ValueId, anchorIndex ElementIndex, argColumn ParamCount, label ByteArray) throws SourceParseError
		if self.valueIsAValueType(argument) or self.valueIsOpaque(argument) or paramMaskOfValue(func, value: self.rootValueOf(argument)) != NoParamPositions 'nothingToRefuse'
			return
		end 'nothingToRefuse'

		let given = self.effectiveCapabilityOf(argument)

		if given == ValueCapability.immutable 'frozenEnough'
			return
		end 'frozenEnough'

		let argTok = self.tokenAt(anchorIndex)
		let word = capabilityWord(given)
		let slot = try argSlotPosition(declaration.paramNames, argIndex: argColumn, label: label) otherwise panic("requireArgumentFrozen: argument {argColumn} of '{String.from(callee)}' fills no declared parameter")
		let paramName = displayParamName(try declaration.paramNames.get(slot) otherwise panic("requireArgumentFrozen: paramNames.get OOB at {slot}"))

		if self.valueIsAnUndecidedResult(argument) 'settledAfterParsing'
			self.fileResultUse(argument, slot: ParamCapability.immutable, sends: true, judged: true, place: "'{calleeSourceName(callee)}' takes `immutable` '{paramName}'; '{String.from(argTok.value)}' is ", line: argTok.line, column: argTok.column)
			return
		end 'settledAfterParsing'

		throw self.regionRefusal(ErrorCode.semanticArgumentCapabilityRefused, message: "'{calleeSourceName(callee)}' takes `immutable` '{paramName}'; {frozenSubject("'{String.from(argTok.value)}'", capability: given)} is {word}{freezeAdvice(given, phrase: ". Freeze it first")}", line: argTok.line, column: argTok.column)
	end 'requireArgumentFrozen'

	function pausedOperandsOf(args ValueIdArray) returns ParamPositionMask
		var paused = NoParamPositions

		for operand in 0 upto args.count() 'eachOperand'
			let value = try args.get(operand) otherwise panic("pausedOperandsOf: args.get OOB at {operand}")

			if self.effectiveCapabilityOf(value) == ValueCapability.paused or self.isolatedSlotReadThroughReadOnlyData(value) or self.valueIsBesideAnotherStatesWindow(value) 'aPausedOperand'
				paused = maskWithParam(paused, param: operand as ParamCount)
			end 'aPausedOperand'
		end 'eachOperand'

		return paused
	end 'pausedOperandsOf'

	function notesForWrite(func IrFunction) returns CapabilityNotes
		if func.capabilityNotes is self.anchors.functions.noCapabilityNotes 'firstNote'
			func.capabilityNotes = CapabilityNotes.create()
		end 'firstNote'

		return func.capabilityNotes
	end 'notesForWrite'

	function noteUseSite(func IrFunction, value ValueId, mutable bool, line LineNumber)
		let reached = self.paramSourcesOf(func, value: value)

		if reached == NoParamPositions 'reachesNoParameter'
			return
		end 'reachesNoParameter'

		let notes = self.notesForWrite(func)

		for param in 0 upto func.paramCount 'eachReachedParameter'
			if not maskHasParam(reached, param: param) or notes.hasUseSite(param, mutable: mutable) 'notNewForThisParameter'
				continue
			end 'notNewForThisParameter'

			notes.useSiteParams.push(param)
			notes.useSiteMutable.push(mutable)
			notes.useSiteLines.push(line)
			notes.useSitePhrases.push(freeze self.tokenTextFrom(self.bodyState.statementStart, endIndex: self.useSiteEndFrom(self.pos)).toByteArray())
		end 'eachReachedParameter'
	end 'noteUseSite'

	function useSiteEndFrom(index ElementIndex) returns ElementIndex
		var stop = index

		while not self.statementEndsAt(stop) and self.kindAt(stop) != TokenKind.otherwise 'toTheUseSiteEnd'
			stop = stop + 1
		end 'toTheUseSiteEnd'

		var firstLineEnd = self.bodyState.statementStart + 1

		while firstLineEnd < stop and not tokenKindEndsALine(self.kindAt(firstLineEnd)) 'toTheFirstLineBreak'
			firstLineEnd = firstLineEnd + 1
		end 'toTheFirstLineBreak'

		return firstLineEnd
	end 'useSiteEndFrom'

	function argumentSpanStart(anchorIndex ElementIndex) returns ElementIndex
		if self.kindAt(anchorIndex) == TokenKind.try 'skipTheTry'
			return anchorIndex + 1
		end 'skipTheTry'

		return anchorIndex
	end 'argumentSpanStart'

	function argumentIsACall(anchorIndex ElementIndex) returns bool
		let start = self.argumentSpanStart(anchorIndex)
		let stop = self.argumentSpanEnd(start)

		return self.kindAt(start) == TokenKind.identifier and stop > start + 1 and self.kindAt(stop - 1) == TokenKind.rightParen
	end 'argumentIsACall'

	function argumentSpanText(anchorIndex ElementIndex) returns String
		let start = self.argumentSpanStart(anchorIndex)
		return self.tokenTextFrom(start, endIndex: self.argumentSpanEnd(start))
	end 'argumentSpanText'

	function argumentSpanEnd(start ElementIndex, throughOtherwise bool = false) returns ElementIndex
		var depth = 0 as FullRangeInt
		var stop = start

		while true 'toTheArgumentEnd'
			let kind = self.kindAt(stop)

			if tokenKindEndsALine(kind) or kind == TokenKind.eof or (kind == TokenKind.otherwise and not throughOtherwise) 'atAnEnd'
				break
			end 'atAnEnd'

			if depth == 0 and (kind == TokenKind.comma or kind == TokenKind.rightParen or kind == TokenKind.rightBracket) 'atTheNextArgument'
				break
			end 'atTheNextArgument'

			if kind == TokenKind.leftParen or kind == TokenKind.leftBracket 'opens'
				depth = depth + 1
			end 'opens' else if kind == TokenKind.rightParen or kind == TokenKind.rightBracket 'closes'
				depth = depth - 1
			end 'closes'

			stop = stop + 1
		end 'toTheArgumentEnd'

		return stop
	end 'argumentSpanEnd'

	function fileCallNotes(func IrFunction, opIdx ElementIndex, args ValueIdArray, argAnchors TokenIndexArray, stored StoredSlotArgArray, receiver ReceiverArg, anchor Token, callOpen PendingCallOpen)
		let notes = self.notesForWrite(func)
		let receiverFirst = self.receiverIsPassed(receiver)
		let receiverTok = self.receiverTokenOf(receiver, fallback: anchor)

		for position in 0 upto argAnchors.count() 'eachWrittenArgument'
			let anchorIndex = try argAnchors.get(position) otherwise panic("fileCallNotes: argAnchors.get OOB at {position} below its own count")
			let spelledTok = receiverTok if receiverFirst and position == 0 else self.tokenAt(anchorIndex)

			notes.noteArgumentName(opIdx, position: position as ParamCount, name: self.spelledArgumentName(spelledTok, anchorIndex: anchorIndex, namesItself: receiverFirst and position == 0))
		end 'eachWrittenArgument'

		for candidate in stored 'eachStoredSlotArg'
			notes.storedSlotArgs.push(candidate.atOp(opIdx))

			if self.valueIsCarried(candidate.argValue) 'aLoopMayRejudgeIt'
				let table = self.regionFactsForWrite()
				table.carriedStoredSlots.push(CarriedStoredSlot.create(notes.storedSlotArgs.count() - 1, value: candidate.argValue, windows: table.windows.clone()))
			end 'aLoopMayRejudgeIt'
		end 'eachStoredSlotArg'

		self.noteWindowCall(func, opIdx: opIdx, args: args, callOpen: callOpen)
		self.noteKeptArgumentSites(func, opIdx: opIdx, args: args, argAnchors: argAnchors, receiver: receiver, anchor: anchor)
	end 'fileCallNotes'

	function noteKeptArgumentSites(func IrFunction, opIdx ElementIndex, args ValueIdArray, argAnchors TokenIndexArray, receiver ReceiverArg, anchor Token)
		for position in 0 upto args.count() 'eachArgument'
			let argValue = try args.get(position) otherwise panic("noteKeptArgumentSites: args.get OOB at {position} below its own count")

			if not (self.valueHoldsAUniqueRecord(argValue) or self.valueIsAnOwnedIsolatedLocal(argValue)) 'cannotBeMoved'
				continue
			end 'cannotBeMoved'

			let passesTheReceiver = self.positionIsTheReceiver(position, receiver: receiver)

			if not passesTheReceiver 'aWrittenArgument'
				let anchorIndex = try argAnchors.get(position) otherwise panic("noteKeptArgumentSites: argAnchors.get OOB at {position} below its own count")
				let origin = self.uniqueOriginOf(argValue, namesABinding: self.argumentNamesABindingAt(anchorIndex))

				if origin != UniqueOrigin.owned 'onlyLentToTheCaller'
					self.fileLentKeptArgument(func, opIdx: opIdx, position: position, origin: origin, anchorIndex: anchorIndex)
					continue
				end 'onlyLentToTheCaller'
			end 'aWrittenArgument'

			let spelled = try self.keptArgumentTokenAt(position, argAnchors: argAnchors, receiver: receiver, anchor: anchor) otherwise continue

			if not tokenCanBeAName(spelled) or not self.bodyState.scope.contains(spelled.value) 'notABinding'
				continue
			end 'notABinding'

			let binding = self.bodyState.scope.getInfo(spelled.value)

			if binding.boundValue != argValue or binding.movedFrom or binding.isSelfField or binding.isCellBinding 'notThisFramesToGive'
				continue
			end 'notThisFramesToGive'

			self.fileKeptArgumentSite(func, opIdx: opIdx, position: position, anchor: spelled, argValue: argValue, holder: binding.payloadScrutBox() if binding.isPayloadBinding() else argValue, argAnchors: argAnchors)
		end 'eachArgument'
	end 'noteKeptArgumentSites'

	function argumentNamesABindingAt(anchorIndex ElementIndex) returns bool
		let tok = self.tokenAt(anchorIndex)
		return self.argumentSpanEnd(anchorIndex) == anchorIndex + 1 and tokenCanBeAName(tok) and self.bodyState.scope.contains(tok.value)
	end 'argumentNamesABindingAt'

	function uniqueOriginOf(value ValueId, namesABinding bool) returns UniqueOrigin
		let facts = self.regionFactsForRead()

		if facts.lentUniques.contains(value) 'aLoopVariable'
			return UniqueOrigin.lentByLoop
		end 'aLoopVariable'

		if facts.destructuredUniques.contains(value) 'aDestructuredElement'
			return UniqueOrigin.lentByTuple
		end 'aDestructuredElement'

		if not namesABinding and self.valueIsAUniqueStorageRead(value) 'aSlotRead'
			return UniqueOrigin.readFromSlot
		end 'aSlotRead'

		return UniqueOrigin.owned
	end 'uniqueOriginOf'

	function fileLentKeptArgument(func IrFunction, opIdx ElementIndex, position ElementIndex, origin UniqueOrigin, anchorIndex ElementIndex)
		let notes = self.notesForWrite(func)
		let anchorTok = self.tokenAt(anchorIndex)
		let subject = self.tokenTextFrom(anchorIndex, endIndex: self.argumentSpanEnd(anchorIndex, throughOtherwise: true))

		notes.keptArgOps.push(opIdx)
		notes.keptArgPositions.push(position as ParamCount)
		notes.keptArgNames.push(freeze subject.toByteArray())
		notes.keptArgLines.push(anchorTok.line)
		notes.keptArgColumns.push(anchorTok.column)
		notes.keptArgOrigins.push(origin)
		notes.keptNextLap.push(false)
	end 'fileLentKeptArgument'

	function keptArgumentTokenAt(position ElementIndex, argAnchors TokenIndexArray, receiver ReceiverArg, anchor Token) returns Token throws AbsentError
		if self.positionIsTheReceiver(position, receiver: receiver) 'theReceiver'
			return self.receiverTokenOf(receiver, fallback: anchor)
		end 'theReceiver'

		let index = try argAnchors.get(position) otherwise throw AbsentError.absent

		if self.argumentSpanEnd(index) != index + 1 'notABareName'
			throw AbsentError.absent
		end 'notABareName'

		return self.tokenAt(index)
	end 'keptArgumentTokenAt'

	function fileKeptArgumentSite(func IrFunction, opIdx ElementIndex, position ElementIndex, anchor Token, argValue ValueId, holder ValueId, argAnchors TokenIndexArray)
		let notes = self.notesForWrite(func)
		let site = notes.keptArgOps.count() as ElementIndex

		notes.keptArgOps.push(opIdx)
		notes.keptArgPositions.push(position as ParamCount)
		notes.keptArgNames.push(anchor.value)
		notes.keptArgLines.push(anchor.line)
		notes.keptArgColumns.push(anchor.column)
		notes.keptArgOrigins.push(UniqueOrigin.owned)
		notes.keptNextLap.push(self.moveOfValueEscapesLoop(argValue) and not self.valueIsCarried(argValue))

		for later in (position + 1) upto argAnchors.count() 'eachLaterArgument'
			self.fileReadsInArgument(notes, site: site, value: argValue, holder: holder, argStart: try argAnchors.get(later) otherwise panic("fileKeptArgumentSite: argAnchors.get OOB at {later} below its own count"))
		end 'eachLaterArgument'

		self.bodyState.openKeptSites.push(OpenKeptSite.create(site, value: argValue, holder: holder))
	end 'fileKeptArgumentSite'

	function fileReadsInArgument(notes CapabilityNotes, site ElementIndex, value ValueId, holder ValueId, argStart ElementIndex)
		let stop = self.argumentSpanEnd(argStart)

		for index in argStart upto stop 'eachToken'
			let tok = self.tokenAt(index)

			if not tokenCanBeAName(tok) or not self.bodyState.scope.contains(tok.value) 'notABinding'
				continue
			end 'notABinding'

			if self.kindAt(index + 1) == TokenKind.colon or self.kindAt(index - 1) == TokenKind.dot 'aLabelOrAField'
				continue
			end 'aLabelOrAField'

			if self.bindingReadsValue(self.bodyState.scope.getInfo(tok.value), value: value, holder: holder) 'theKeptValue'
				self.fileKeptRead(notes, site: site, tok: tok)
			end 'theKeptValue'
		end 'eachToken'
	end 'fileReadsInArgument'

	function bindingReadsValue(binding VarInfo, value ValueId, holder ValueId) returns bool
		return binding.boundValue == value or binding.boundValue == holder or (binding.isPayloadBinding() and binding.payloadScrutBox() == value)
	end 'bindingReadsValue'

	function fileKeptRead(notes CapabilityNotes, site ElementIndex, tok Token)
		notes.keptReadSites.push(site)
		notes.keptReadLines.push(tok.line)
		notes.keptReadColumns.push(tok.column)
		notes.keptReadBlocks.push(self.bodyState.currentBlock.id as ElementIndex)
	end 'fileKeptRead'

	function noteLentUniqueMoved(value ValueId)
		if self.bodyState.lentUniqueParams.isEmpty() 'noLentUniqueHere'
			return
		end 'noLentUniqueHere'

		let holders = self.uniquePayloadSubjectsOf(value)
		holders.push(value)

		for holder in holders 'eachHolder'
			for index in 0 upto self.bodyState.lentUniqueParams.count() 'eachLentParameter'
				if (try self.bodyState.lentUniqueParams.get(index) otherwise panic("noteLentUniqueMoved: lentUniqueParams.get OOB at {index} below its own count")) != holder 'anotherParameter'
					continue
				end 'anotherParameter'

				let name = try self.bodyState.lentUniqueParamNames.get(index) otherwise panic("noteLentUniqueMoved: lentUniqueParamNames.get OOB at {index} — the columns are pushed together")
				self.fileMovedLentUniqueSite(value, holder: holder, name: name)
				return
			end 'eachLentParameter'
		end 'eachHolder'
	end 'noteLentUniqueMoved'

	function fileMovedLentUniqueSite(value ValueId, holder ValueId, name immutable ByteArray)
		let notes = self.notesForWrite(self.bodyFunction())
		let anchorTok = self.tokenAt(self.pos - 1)
		let site = notes.keptArgOps.count() as ElementIndex

		// The site is the next op to be emitted, never the last one: the last op can lie in a predecessor
		// block that also reaches a sibling branch, which would flag a read on a path that never moved.

		notes.keptArgOps.push(self.artifact.module.ops.count())
		notes.keptArgPositions.push(holder as ParamCount)
		notes.keptArgNames.push(name)
		notes.keptArgLines.push(anchorTok.line)
		notes.keptArgColumns.push(anchorTok.column)
		notes.keptArgOrigins.push(UniqueOrigin.owned)
		notes.keptNextLap.push(false)
		notes.sparseForWrite().keptMovedSites.push(site)
		self.bodyState.openKeptSites.push(OpenKeptSite.create(site, value: value, holder: holder))
	end 'fileMovedLentUniqueSite'

	function noteReadOfKeptArgument(binding VarInfo, nameTok Token)
		if self.bodyState.openKeptSites.isEmpty() 'nothingKept'
			return
		end 'nothingKept'

		let notes = self.notesForWrite(self.bodyFunction())

		for open in self.bodyState.openKeptSites 'eachOpenSite'
			if self.bindingReadsValue(binding, value: open.value, holder: open.holder) 'aReadOfTheKeptValue'
				self.fileKeptRead(notes, site: open.site, tok: nameTok)
			end 'aReadOfTheKeptValue'
		end 'eachOpenSite'
	end 'noteReadOfKeptArgument'

	function storedSlotInstanceOf(args ValueIdArray, receiver ReceiverArg, constructorInstance ConstructorInstance) returns (GenericInstanceId, ElementIndex) throws AbsentError
		if self.receiverIsPassed(receiver) 'instantiatedByTheReceiver'
			let receiverValue = try args.get(0) otherwise panic("storedSlotInstanceOf: a call with a receiver carries it at argument 0")

			if self.tagOf(receiverValue) != ValueTypeTag.genericInstance 'notAnInstance'
				throw AbsentError.absent
			end 'notAnInstance'

			return (self.valueInstanceId(receiverValue), 1)
		end 'instantiatedByTheReceiver'

		match constructorInstance 'constructed'
			instance(id) then return (id, 0)
			none then throw AbsentError.absent
		end 'constructed'
	end 'storedSlotInstanceOf'

	function storedSlotCandidates(func IrFunction, callee ByteArray, args ValueIdArray, argAnchors TokenIndexArray, argLabels NameRoster, receiver ReceiverArg, constructorInstance ConstructorInstance) returns StoredSlotArgArray
		let candidates = StoredSlotArgArray.create(0)
		let declaration = try self.declarationNameableHere(callee) otherwise return candidates
		let (instance, firstSource) = try self.storedSlotInstanceOf(args, receiver: receiver, constructorInstance: constructorInstance) otherwise return candidates

		for argIndex in firstSource upto args.count() 'eachSourceArgument'
			let argument = try args.get(argIndex) otherwise panic("storedSlotCandidates: args.get OOB at {argIndex} below the count just read")

			if self.valueIsAValueType(argument) or self.valueIsOpaque(argument) 'carriesNoCapability'
				continue
			end 'carriesNoCapability'

			let slotPosition = try argSlotPosition(declaration.paramNames, argIndex: (argIndex - firstSource) as ParamCount, label: try argLabels.get(argIndex) otherwise panic("storedSlotCandidates: argLabels.get OOB at {argIndex}")) otherwise continue
			let declared = try declaration.paramTypes.get(slotPosition) otherwise continue
			let slot = try self.signatures.typeParameterSlotIn(instance, declared: declared) otherwise continue
			let storedSlot = qualifierSlot(slot.1)

			let given = self.effectiveCapabilityOf(argument)
			let undecided = self.valueIsAnUndecidedParameter(func, value: argument, capability: given) and not (storedSlot == ParamCapability.immutable and self.valueHasOtherPath(argument))

			if storedSlot == ParamCapability.unmarked and (given == ValueCapability.mutable or given == ValueCapability.temporary) and not undecided and not self.valueIsCarried(argument) 'cannotFailAMutableSlot'
				continue
			end 'cannotFailAMutableSlot'

			let argTok = self.tokenAt(try argAnchors.get(argIndex) otherwise panic("storedSlotCandidates: argAnchors.get OOB at {argIndex}"))
			candidates.push(StoredSlotArg.create(0, argIndex: argIndex as ParamCount, slot: storedSlot, argValue: argument, sources: self.paramSourcesOf(func, value: argument), capability: given, undecided: undecided, valueType: self.valueDisplayTypeName(argument), readOnlyReason: readOnlyReasonSuffix(self.readOnlyReason()), line: argTok.line, column: argTok.column))
		end 'eachSourceArgument'

		return candidates
	end 'storedSlotCandidates'

	function pausedRegionLabel(windows WindowStack, callOpen PendingCallOpen) returns immutable ByteArray throws AbsentError
		if windowIsOpen(windows) 'aWindow'
			return innermostWindowOf(windows).label
		end 'aWindow'

		if self.statement.drainingLoops > 0 'aDrainedArray'
			return self.statement.drainingLabel
		end 'aDrainedArray'

		match callOpen 'callOpen'
			opened(_, _, label) then return label
			none then throw AbsentError.absent
		end 'callOpen'
	end 'pausedRegionLabel'

	function noteWindowCall(func IrFunction, opIdx ElementIndex, args ValueIdArray, callOpen PendingCallOpen)
		let label = try self.pausedRegionLabel(self.regionFactsForRead().windows, callOpen: callOpen) otherwise return
		let notes = self.notesForWrite(func)
		notes.windowCallOps.push(opIdx)
		notes.windowCallLabels.push(label)
		notes.windowCallPausedOperands.push(self.pausedOperandsOf(args))
	end 'noteWindowCall'

	function finishCapabilityFacts(func IrFunction)
		self.flushUnreturnedHeldLiterals(func)
		self.noteHeldParams(func)
		func.needsMutableParamMask = func.needsMutableParamMask or func.writesThroughParamMask

		func.resultFromParamMask = self.bodyState.returnsFromParams
		func.resultHasOtherPath = self.bodyState.returnsOtherwise
		func.resultMayBeFrozen = self.bodyState.returnsFrozenData and (self.bodyState.returnsMutableData or self.bodyState.resultFreezesWithItsInstance)
		func.resultMayBeUnknown = self.bodyState.returnsAnUnknownValue

		match self.bodyState.regionFacts 'facts'
			unwritten then return
			entries(table) then self.fileJoinedSources(func, table: table)
		end 'facts'
	end 'finishCapabilityFacts'

	function fileJoinedSources(func IrFunction, table RegionFactTable)
		for mixed in table.paramSources.mixedJoinSources() 'eachMixedJoin'
			self.notesForWrite(func).joinedSources.push(mixed)
		end 'eachMixedJoin'
	end 'fileJoinedSources'

	function openedRootName(openedValue ValueId, openedTok Token) returns immutable ByteArray
		if let origin = try self.regionFactsForRead().fieldOrigins.get(openedValue) 'aFieldPath'
			return try self.layoutOfOrigin(origin).fieldNames.get(origin.field) otherwise panic("openedRootName: fieldNames.get OOB at {origin.field}")
		end 'aFieldPath'

		return openedTok.value
	end 'openedRootName'

	function isolateIfPossible(value ValueId) returns bool
		let capability = self.effectiveCapabilityOf(value)

		if self.valueIsAValueType(value) or self.valueIsAnOwnedIsolatedRegion(value) 'alreadyIsolated'
			return true
		end 'alreadyIsolated'

		if capability == ValueCapability.temporary 'aCleanTemporary'
			self.recoverAsIsolated(value)
			return true
		end 'aCleanTemporary'

		return false
	end 'isolateIfPossible'

	function noteCallResultCapability(result ValueId, callee ByteArray, args ValueIdArray, opensAnIsolatedValue bool, opFloor ElementIndex, anchor Token, argLabels NameRoster, receiver ReceiverArg)
		if self.valueIsAValueType(result) 'aValue'
			return
		end 'aValue'

		if valueIsMarked(self.bodyState.immutableSlotReads, value: result) 'readsAnImmutableSlot'
			self.setValueCapability(result, capability: ValueCapability.immutable)
			return
		end 'readsAnImmutableSlot'

		let declared = self.resultCapabilityDeclaredFor(callee)

		if declared == ResultCapability.isolated 'anIsolatedResult'
			self.setValueCapability(result, capability: ValueCapability.isolated)
			self.carryWindowBirth(result, sources: args)
			return
		end 'anIsolatedResult'

		if declared == ResultCapability.immutable 'aFrozenResult'
			self.setValueCapability(result, capability: ValueCapability.immutable)
			return
		end 'aFrozenResult'

		let returnsFresh = self.signatures.returnsFreshValue(callee)

		if opensAnIsolatedValue and not qualifiedMemberIs(callee, member: CloneMethodName) 'leavesTheOpenedRegion'
			self.noteViewOfTheOpenedRegion(result, callee: callee, args: args, anchor: anchor)
			return
		end 'leavesTheOpenedRegion'

		let sources = self.argumentsThatCanReachTheResult(callee, args: args, argLabels: argLabels, receiver: receiver)

		if not returnsFresh 'mayHandBackAnArgument'
			if self.carryPartReadThroughACall(result, sources: sources) 'aPartReadReachesTheResult'
				return
			end 'aPartReadReachesTheResult'

			if let readOnly = try self.readOnlyInputCapability(sources, resultKeepsItsItemCapabilities: self.valueHoldsAFrozenTupleItem(result)) 'readsReadOnlyData'
				self.setValueCapability(result, capability: readOnly)

				if not self.anyArgumentHoldsAFrozenItem(sources) 'judgedByTheArgumentsThemselves'
					self.noteUndecidedResult(result, opFloor: opFloor)

					if self.valueIsAnUndecidedResult(result) 'readOnlyUntilSettled'
						self.setValueCapability(result, capability: ProvisionalForAUse)
					end 'readOnlyUntilSettled'
				end 'judgedByTheArgumentsThemselves'

				return
			end 'readsReadOnlyData'
		end 'mayHandBackAnArgument' else if not qualifiedMemberIs(callee, member: CloneMethodName) and self.carryPartReadThroughACall(result, sources: sources) 'aFreshRecordHoldingAPartRead'
			return
		end 'aFreshRecordHoldingAPartRead'

		let inputsAreClean = self.inputsAreClean(sources)

		if inputsAreClean and self.callResultMayViewItsInputs(result, callee: callee) 'aViewIsNotFresh'
			return
		end 'aViewIsNotFresh'

		if inputsAreClean 'allClean'
			self.markFresh(result)
		end 'allClean'

		let aFreshRecordHoldingItsArguments = returnsFresh and not qualifiedMemberIs(callee, member: CloneMethodName) and not self.signatures.isArrayInstanceAt(self.tagOf(result), nameId: self.valueNameId(result)) and self.anyArgumentConstrainsTheResult(sources)

		if (not returnsFresh and self.capabilityOfValue(result) != ValueCapability.temporary) or aFreshRecordHoldingItsArguments 'judgedOnceEveryBodyIsRead'
			self.noteUndecidedResult(result, opFloor: opFloor)
		end 'judgedOnceEveryBodyIsRead'
	end 'noteCallResultCapability'

	function anyArgumentConstrainsTheResult(arguments ValueIdArray) returns bool
		for argument in arguments 'eachArgument'
			if self.valueIsAValueType(argument) or self.valueIsOpaque(argument) 'noRecordToHold'
				continue
			end 'noRecordToHold'

			if capabilityIsReadOnly(self.effectiveCapabilityOf(argument)) or self.valueSettlesAfterParsing(argument) or self.paramSourcesOf(self.bodyFunction(), value: argument) != NoParamPositions 'dataTheResultMayNotWrite'
				return true
			end 'dataTheResultMayNotWrite'
		end 'eachArgument'

		return false
	end 'anyArgumentConstrainsTheResult'

	function forgetUndecidedResult(value ValueId)
		let opIdx = try self.bodyState.undecidedResults.get(value) otherwise return
		_ = self.bodyState.undecidedResults.remove(value)
		let notes = self.notesForWrite(self.bodyFunction())
		let kept = FuncIndexArray.create(0)

		for registered in notes.undecidedResultOps 'eachRegisteredOp'
			if registered != opIdx 'anotherResult'
				kept.push(registered)
			end 'anotherResult'
		end 'eachRegisteredOp'

		notes.undecidedResultOps = kept
	end 'forgetUndecidedResult'

	function argumentsThatCanReachTheResult(callee immutable ByteArray, args ValueIdArray, argLabels NameRoster, receiver ReceiverArg) returns ValueIdArray
		let declaration = try self.declarationNameableHere(callee) otherwise return args
		let receiverFirst = self.receiverIsPassed(receiver)
		let sources = ValueIdArray.create(args.count(), zeroed: false)
		var droppedAny = false

		for position in 0 upto args.count() 'eachArgument'
			let argument = try args.get(position) otherwise panic("argumentsThatCanReachTheResult: args.get OOB at {position} below the count just read")

			if self.declaredCapabilityOfArgument(declaration, position: position, receiverFirst: receiverFirst, label: try argLabels.get(position) otherwise EmptySourceText) == ParamCapability.immutable 'cannotReachTheResult'
				droppedAny = true
				continue
			end 'cannotReachTheResult'

			sources.push(argument)
		end 'eachArgument'

		return sources if droppedAny else args
	end 'argumentsThatCanReachTheResult'

	function declaredCapabilityOfArgument(declaration SweptDeclaration, position ElementIndex, receiverFirst bool, label immutable ByteArray) returns ParamCapability
		if receiverFirst and position == 0 'theReceiver'
			return declaration.selfCapability
		end 'theReceiver'

		let firstSource = 1 if receiverFirst else 0
		return self.declaredArgumentCapability(declaration, argColumn: (position - firstSource) as ParamCount, label: label)
	end 'declaredCapabilityOfArgument'

	function anyArgumentHoldsAFrozenItem(args ValueIdArray) returns bool
		for arg in args 'eachArg'
			if self.valueHoldsAFrozenTupleItem(arg) 'aFrozenItem'
				return true
			end 'aFrozenItem'
		end 'eachArg'

		return false
	end 'anyArgumentHoldsAFrozenItem'

	function noteUndecidedResult(result ValueId, opFloor ElementIndex)
		let opIdx = try firstOpDefiningSince(self.artifact.module, value: result, floor: opFloor) otherwise return
		let op = try self.artifact.module.ops.get(opIdx) otherwise panic("noteUndecidedResult: ops.get OOB at {opIdx}")
		try requireCallOrTryCall(op) otherwise return
		self.notesForWrite(self.bodyFunction()).undecidedResultOps.push(opIdx)
		self.noteCallArgSources(opIdx, op: op)
		self.bodyState.undecidedResults.upsert(result, value: opIdx)
	end 'noteUndecidedResult'

	function noteCallArgSources(opIdx ElementIndex, op MaxonOp)
		let parts = try directCallPartsOf(op) otherwise return
		let notes = self.notesForWrite(self.bodyFunction())

		for position in 0 upto parts.1.count() 'eachArgument'
			let sources = self.paramSourcesOf(self.bodyFunction(), value: try parts.1.get(position) otherwise panic("noteCallArgSources: args.get OOB at {position}"))

			if sources != NoParamPositions 'aParametersData'
				notes.callArgSources.push(CallArgSource.create(opIdx, position: position, sources: sources))
			end 'aParametersData'
		end 'eachArgument'
	end 'noteCallArgSources'

	function noteDeferredResultWrite(box ValueId, fieldName String, placeText String, line LineNumber, column ColumnNumber)
		let ops = try self.settlingOpsOf(box) otherwise panic("noteDeferredResultWrite: a deferred write names a result that was never registered undecided")
		let notes = self.notesForWrite(self.bodyFunction())
		let writableNow = not capabilityIsReadOnly(self.effectiveCapabilityOf(box))

		for opIdx in ops 'eachSettlingOp'
			notes.resultWriteWritable.push(writableNow)
			notes.resultWriteOps.push(opIdx)
			notes.resultWriteLines.push(line)
			notes.resultWriteColumns.push(column)
			notes.resultWriteFields.push(freeze fieldName.toByteArray())
			notes.resultWritePlaces.push(freeze placeText.toByteArray())
		end 'eachSettlingOp'
	end 'noteDeferredResultWrite'

	function noteResultCapabilityThrough(result ValueId, carrier ValueId, declared ResultCapability)
		if self.valueIsAValueType(result) or self.tagOf(result) == ValueTypeTag.void 'nothingToQualify'
			return
		end 'nothingToQualify'

		match declared 'declared'
			isolated then self.setValueCapability(result, capability: ValueCapability.isolated)
			immutable then self.setValueCapability(result, capability: ValueCapability.immutable)
			mutable then break
			unmarked then self.noteResultTakesItsCarriersCapability(result, carrier: carrier)
		end 'declared'
	end 'noteResultCapabilityThrough'

	function noteResultTakesItsCarriersCapability(result ValueId, carrier ValueId)
		let given = self.effectiveCapabilityOf(carrier)

		if capabilityIsReadOnly(given) or windowIsOpen(self.regionFactsForRead().windows) 'readOnlyThroughIt'
			self.setValueCapability(result, capability: ValueCapability.paused)
			return
		end 'readOnlyThroughIt'

		self.carryParamSources(result, source: carrier)
	end 'noteResultTakesItsCarriersCapability'

	function indirectResultCapabilityDeclared(governing TypeNameId) returns ResultCapability
		return match self.functionAliasForName(self.internedName(governing)) 'alias'
			declared(alias) gives alias.returnCapability
			undeclared gives ResultCapability.unmarked
		end 'alias'
	end 'indirectResultCapabilityDeclared'

	function noteClosureCapture(closureName immutable ByteArray, position ParamCount, value ValueId, name immutable ByteArray, anchor Token)
		if self.valueIsAValueType(value) 'nothingToJudge'
			return
		end 'nothingToJudge'

		let notes = self.notesForWrite(self.bodyFunction())
		notes.captureSites.push(CaptureSite.create(closureName, position: position, value: value, name: name, line: anchor.line, column: anchor.column, pausedWhenCaptured: self.effectiveCapabilityOf(value) == ValueCapability.paused))

		if self.valueIsAnUndecidedParameter(self.bodyFunction(), value: value, capability: self.effectiveCapabilityOf(value)) 'aParameterTheClosureKeeps'
			self.notePassedParamNeed(self.bodyFunction(), value: value, mutable: true, line: anchor.line)
		end 'aParameterTheClosureKeeps'

		if self.valueIsAnUndecidedResult(value) 'aResultTheClosureKeeps'
			self.fileResultUse(value, slot: ParamCapability.mutable, sends: false, judged: false, place: String.from(name), line: anchor.line, column: anchor.column)
		end 'aResultTheClosureKeeps'
	end 'noteClosureCapture'

	function carryReadOnlyCaptures(closure ValueId, captured CapturedValueArray, captureNames NameRoster, captureAnchors TokenArray)
		var meet = ValueCapability.immutable
		var capturesRecordData = false
		var capturesUncleanData = false

		for (iter, slot) in captured.withIterator() 'eachCapture'
			let value = try self.capturedRecordOf(slot) otherwise continue
			capturesRecordData = true
			meet = meetOfCaptureCapabilities(meet, captured: self.effectiveCapabilityOf(value))
			capturesUncleanData = capturesUncleanData or not self.valueIsCleanInput(value)

			if self.valueIsAnIsolatedSlotRead(value) and not self.bodyState.isolatedPartOrigins.contains(closure) 'capturesAPartRead'
				let name = try captureNames.get(iter.index()) otherwise panic("carryReadOnlyCaptures: captureNames.get OOB at {iter.index()} — filled in lockstep with the captured values")
				let anchor = try captureAnchors.get(iter.index()) otherwise panic("carryReadOnlyCaptures: captureAnchors.get OOB at {iter.index()} — filled in lockstep with the captured values")
				self.noteIsolatedPartReadAt(closure, read: IsolatedPartRead.at(displayParamName(name), anchor: anchor))
			end 'capturesAPartRead'
		end 'eachCapture'

		if not capturesUncleanData 'theClosureHoldsNothingTheCallerWrites'
			self.regionFactsForWrite().cleanFunctionValues.insert(closure)
		end 'theClosureHoldsNothingTheCallerWrites'

		if capturesRecordData and meet != ValueCapability.mutable 'readOnlyThroughTheCaptures'
			self.setValueCapability(closure, capability: meet)
		end 'readOnlyThroughTheCaptures'
	end 'carryReadOnlyCaptures'

	function capturedRecordOf(slot CapturedValue) returns ValueId throws AbsentError
		match slot 'slot'
			unfilled then throw AbsentError.absent
			filled(value) then return try self.recordCapturedBy(value)
		end 'slot'
	end 'capturedRecordOf'

	function recordCapturedBy(value ValueId) returns ValueId throws AbsentError
		if self.valueIsAValueType(value) 'aCopy'
			throw AbsentError.absent
		end 'aCopy'

		return value
	end 'recordCapturedBy'

	function dispatchArrayRosterMethod(func IrFunction, recv MethodReceiver, resultUsed bool) returns ValueId throws SourceParseError
		let elementOpFloor = self.artifact.module.ops.count()
		let arrayCallResult = try self.dispatchArrayMethod(func, arr: recv.value, giid: recv.nameId as GenericInstanceId, resultUsed: resultUsed, immutableReceiverName: recv.immutableName, receiverOwner: recv.owner, receiverStorage: self.subjectStorageMask(func, subjectName: recv.subjectName), viaManagedField: false)
		self.adaptElementRead(arrayCallResult, receiver: recv.value, opFloor: elementOpFloor)
		return arrayCallResult
	end 'dispatchArrayRosterMethod'

	function adaptElementRead(result ValueId, receiver ValueId, opFloor ElementIndex)
		if not self.resultIsABorrowedElementRead(opFloor) 'nothingToAdapt'
			return
		end 'nothingToAdapt'

		self.adaptBorrowedElement(result, receiver: receiver)
	end 'adaptElementRead'

	function adaptBorrowedElement(result ValueId, receiver ValueId)
		if self.valueIsAValueType(result) or valueIsMarked(self.bodyState.immutableSlotReads, value: result) 'nothingToAdapt'
			return
		end 'nothingToAdapt'

		self.carryParamSources(result, source: receiver)
		let given = self.effectiveCapabilityOf(receiver)

		if capabilityIsReadOnly(given) 'readOnlyContainer'
			self.setValueCapability(result, capability: given)
		end 'readOnlyContainer' else if given == ValueCapability.isolated 'anIsolatedContainer'
			self.noteIsolatedPartRead(result)
		end 'anIsolatedContainer'

		self.carryUndecidedResult(receiver, target: result)
	end 'adaptBorrowedElement'

	function resultIsABorrowedElementRead(opFloor ElementIndex) returns bool
		match self.opProducingTheValue(opFloor) 'producer'
			noOwnOp then return false
			at(opIdx) then return self.opReadsAnElementInPlace(opIdx)
		end 'producer'
	end 'resultIsABorrowedElementRead'

	function opReadsAnElementInPlace(opIdx ElementIndex) returns bool
		let producer = try self.artifact.module.ops.get(opIdx) otherwise panic("opReadsAnElementInPlace: ops.get OOB at {opIdx} — the producer came from `opProducingTheValue`")
		let edge = try callEdgeOf(producer) otherwise return false

		return borrowedElementReadCallee(edge.0)
	end 'opReadsAnElementInPlace'

	function readOnlyInputCapability(inputs ValueIdArray, resultKeepsItsItemCapabilities bool) returns ValueCapability throws AbsentError
		var anyReadOnly = false

		for input in inputs 'eachInput'
			if self.valueIsAValueType(input) 'aValue'
				continue
			end 'aValue'

			let capability = self.effectiveCapabilityOf(input)

			if capability == ValueCapability.paused 'readOnlyOuterData'
				return ValueCapability.paused
			end 'readOnlyOuterData'

			if capability == ValueCapability.immutable or (not resultKeepsItsItemCapabilities and self.valueHoldsAFrozenTupleItem(input)) 'frozenData'
				anyReadOnly = true
			end 'frozenData'
		end 'eachInput'

		if not anyReadOnly 'nothingReadOnly'
			throw AbsentError.absent
		end 'nothingReadOnly'

		return ValueCapability.immutable
	end 'readOnlyInputCapability'

	function valueHoldsAFrozenTupleItem(value ValueId) returns bool
		let tag = self.tagOf(value)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.instanceHoldsAFrozenTupleItem(self.valueNameId(value) as GenericInstanceId)
		end 'anInstance'

		return tag == ValueTypeTag.structRef and self.valueTypeNameIsATuple(value) and self.signatures.tupleNameHoldsAFrozenItem(self.valueTypeName(value))
	end 'valueHoldsAFrozenTupleItem'

	function markFresh(value ValueId)
		if self.valueIsAValueType(value) 'nothingToMark'
			return
		end 'nothingToMark'

		self.setValueCapability(value, capability: ValueCapability.temporary)
	end 'markFresh'

	function inputsAreClean(inputs ValueIdArray) returns bool
		for input in inputs 'eachInput'
			if not self.valueIsCleanInput(input) 'anUncleanInput'
				return false
			end 'anUncleanInput'
		end 'eachInput'

		return true
	end 'inputsAreClean'

	function markFreshWhenInputsClean(value ValueId, inputs ValueIdArray)
		if self.inputsAreClean(inputs) 'allClean'
			self.markFresh(value)
		end 'allClean'
	end 'markFreshWhenInputsClean'

	function callResultMayViewItsInputs(result ValueId, callee ByteArray) returns bool
		return self.valueIsBufferSurface(result) and not self.signatures.returnsFreshValue(callee)
	end 'callResultMayViewItsInputs'

	function layoutOfOrigin(origin FieldOrigin) returns StructLayout
		match self.signatures.structFor(origin.layoutName, readerFilePath: self.job.path) 'declaration'
			undeclared then panic("layoutOfOrigin: a field was read out of a record the index no longer declares")
			declared(layout) then return layout
		end 'declaration'
	end 'layoutOfOrigin'

	function parseModifyStatement(func IrFunction, block IrBlock) returns IrBlock throws SourceParseError
		try self.consume(TokenKind.modify)
		let targetStart = self.pos
		let targetTok = self.tokenAt(targetStart)
		let target = try self.parseExpression(func, block: block)
		let targetEnd = self.pos
		let rootText = self.pathTextOf(targetStart)
		let labelTok = try self.consume(TokenKind.charLiteral)

		if self.valueIsAValueType(target) or self.effectiveCapabilityOf(target) != ValueCapability.isolated 'notIsolated'
			throw self.regionRefusal(ErrorCode.semanticIsolatedReadOutsideBlock, message: "'{rootText}' is not isolated; 'modify' opens an isolated value. Declare it `as isolated {self.valueDisplayTypeName(target)}`", line: targetTok.line, column: targetTok.column)
		end 'notIsolated'

		if self.valueIsBesideAnotherStatesWindow(target) 'anotherStatesData'
			try self.requireHolderCapabilityWritable(ValueCapability.paused, pathText: rootText, action: "opened", joinedAtALoop: false, line: targetTok.line, column: targetTok.column)
		end 'anotherStatesData'

		var holderValue = 0 as ValueId
		var holderField = 0 as FieldIndex
		var opensAField = false

		if let origin = try self.regionFactsForRead().fieldOrigins.get(target) 'aFieldPath'
			try self.requireSlotHolderWritable(target, placeText: rootText, pathText: rootText, action: "opened", line: targetTok.line, column: targetTok.column)
			try self.requireIsolatedSlotHolderWritable(origin.holder, placeText: rootText, line: targetTok.line, column: targetTok.column)

			self.notePassedParamNeed(func, value: origin.holder, mutable: true, line: targetTok.line)
			holderValue = origin.holder
			holderField = origin.field
			opensAField = true
		end 'aFieldPath'

		let rootName = targetTok.value if targetEnd == targetStart + 1 and targetTok.kind == TokenKind.identifier else EmptySourceText
		let windows = self.regionFactsForWrite().windows
		windows.push(OpenWindow.create(labelTok.value, rootText: freeze rootText.toByteArray(), rootName: rootName, kind: WindowKind.modify, floor: self.bodyState.valueCapabilities.count() as ValueId, openedValue: target, holderValue: holderValue, holderField: holderField, opensAField: opensAField, ownerStatement: self.bodyState.statementStart))

		self.emitStrandGuard(GtStrandGuardEnterName, range: SourceRange.ofToken(targetTok))
		let bodyEnd = try self.parseBlockBody(func, block: self.bodyState.currentBlock, label: labelTok.value)
		_ = try windows.pop() otherwise panic("parseModifyStatement: the window this statement pushed is gone from the stack it popped")
		self.bodyState.currentBlock = bodyEnd

		if bodyEnd.isTerminated() 'leavesOnEveryPath'
			self.bodyState.currentBlock = self.newDeadBlock(func, label: b"modifycont")
			return self.bodyState.currentBlock
		end 'leavesOnEveryPath'

		self.emitStrandGuard(GtStrandGuardExitName, range: SourceRange.ofToken(labelTok))
		return bodyEnd
	end 'parseModifyStatement'

	function parseAcquireStatement(func IrFunction) returns IrBlock throws SourceParseError
		let acquireIndex = self.pos
		let acquireTok = try self.consume(TokenKind.acquire)
		try self.requireNoWaitInsideWindow(acquireTok)

		let constructEnd = self.acquireConstructEndIndex(acquireIndex)
		let assignedBindings = self.assignedBindingsIn(acquireIndex, endIndex: constructEnd)
		let names = try self.parseAcquireNames(func)
		let labelTok = try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		let range = SourceRange.between(acquireTok, last: labelTok)
		let (cowns, word) = self.emitAcquireCall(names, range: range)
		let granted = self.emitCompareAgainstLiteral(word, literal: 0, op: MaxonCmpOp.ge, opTok: acquireTok)

		let entry = self.bodyState.currentBlock
		let entryVals = self.snapshotBindings(assignedBindings)
		let entryMoveMark = self.captureMoveMark()
		let bodyBlock = self.artifact.module.addBlock(func, label: labelTok.value, heat: BlockHeat.normal)

		if self.coverageActive() 'instrumentTheGrantedArm'
			self.mintCovPoint(bodyBlock, funcName: func.name, flags: MxdbgCovFlagArmThen, line: acquireTok.line, col: acquireTok.column, branchLine: acquireTok.line, branchCol: acquireTok.column)
		end 'instrumentTheGrantedArm'

		let bodyEnd = try self.parseAcquireBody(func, bodyBlock: bodyBlock, names: names, cowns: cowns, group: word, labelTok: labelTok, acquireTok: acquireTok)
		let bodyVals = self.snapshotBindings(assignedBindings)
		let bodyMoveMark = self.captureMoveMark()
		self.restoreBindings(assignedBindings, snapshot: entryVals)
		self.restoreMoveMark(entryMoveMark)

		let otherwiseTok = try self.consume(TokenKind.otherwise)
		let handlerBlock = self.artifact.module.addBlock(func, label: b"acquirestopped", heat: BlockHeat.normal)
		self.mintElseArmPoint(handlerBlock, funcName: func.name, ifTok: acquireTok, elseTok: otherwiseTok, written: true)
		let handlerEnd = try self.parseAcquireHandler(func, handlerBlock: handlerBlock, stopped: word, names: names, otherwiseTok: otherwiseTok)
		let handlerVals = self.snapshotBindings(assignedBindings)
		let handlerMoveMark = self.captureMoveMark()

		let cont = self.finalizeIfElse(func, entry: entry, cond: granted, ifTok: acquireTok, thenBlock: bodyBlock, thenEnd: bodyEnd, elseBlock: handlerBlock, elseEnd: handlerEnd, bindings: assignedBindings, thenVals: bodyVals, elseVals: handlerVals, thenMoveMark: bodyMoveMark, elseMoveMark: handlerMoveMark)
		self.assertScanAligned("parseAcquireStatement", predictedEnd: constructEnd)
		return cont
	end 'parseAcquireStatement'

	function acquireConstructEndIndex(acquireIndex ElementIndex) returns ElementIndex
		let bodyEnd = self.blockStatementEndIndex(acquireIndex, continuesAtElse: false)
		var handlerIndex = bodyEnd + 1

		if self.kindAt(handlerIndex) == TokenKind.charLiteral 'aLabelledCloser'
			handlerIndex = handlerIndex + 1
		end 'aLabelledCloser'

		if self.kindAt(handlerIndex) != TokenKind.otherwise 'noHandler'
			return bodyEnd
		end 'noHandler'

		return self.blockStatementEndIndex(handlerIndex, continuesAtElse: false)
	end 'acquireConstructEndIndex'

	function parseAcquireNames(func IrFunction) returns AcquiredNameArray throws SourceParseError
		let names = AcquiredNameArray.create(0)

		while true 'eachName'
			let nameIndex = self.pos
			let nameTok = try self.consume(TokenKind.identifier)

			if not self.at(TokenKind.comma) and not self.at(TokenKind.charLiteral) 'notTheEndOfTheName'
				let stray = self.current()
				throw SourceParseError.unexpectedToken(TokenKind.charLiteral.rawValue, got: tokenDisplayText(stray), line: stray.line, column: stray.column)
			end 'notTheEndOfTheName'

			self.pos = nameIndex
			let handle = try self.parsePrimary(func)
			names.push(AcquiredName.create(nameTok, handle: handle, stateType: try self.acquiredStateTypeOf(handle, nameTok: nameTok)))

			if not self.at(TokenKind.comma) 'lastName'
				break
			end 'lastName'

			try self.consume(TokenKind.comma)
		end 'eachName'

		return names
	end 'parseAcquireNames'

	function acquiredStateTypeOf(handle ValueId, nameTok Token) returns MaxonType throws SourceParseError
		if not self.valueIsAServiceHandle(handle) 'notAHandle'
			throw SourceParseError.unsupported(acquireNameNotAServiceHandleRefusal(nameTok.value, typeName: self.valueDisplayTypeName(handle)), line: nameTok.line, column: nameTok.column)
		end 'notAHandle'

		let handleName = self.signatures.genericInstanceBaseName(self.valueInstanceId(handle)) if self.tagOf(handle) == ValueTypeTag.genericInstance else self.valueTypeName(handle)

		if self.signatures.isInterfaceHandle(handleName) 'anInterfaceHandle'
			throw SourceParseError.unsupported(acquireInterfaceHandleRefusal(nameTok.value, handleName: handleName), line: nameTok.line, column: nameTok.column)
		end 'anInterfaceHandle'

		let typeName = self.signatures.serviceOfHandle(handleName)

		return match self.serviceInstanceOfHandle(handle, typeName: typeName) 'instance'
			monomorphic gives MaxonType.structRef(self.artifact.typeNames.intern(typeName))
			at(id) gives MaxonType.genericInstance(id)
		end 'instance'
	end 'acquiredStateTypeOf'

	function emitAcquireCall(names AcquiredNameArray, range SourceRange) returns (ValueIdArray, ValueId)
		let cownBox = self.emitBoxAlloc(self.emitLiteral((names.count() * PointerFieldBytes) as FullRangeInt, valueType: MaxonType.integer, range: range), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		let cowns = ValueIdArray.create(names.count(), zeroed: false)

		for position in 0 upto names.count() 'eachName'
			let name = try names.get(position) otherwise panic("emitAcquireCall: names.get OOB at {position} below the count just read")
			let cown = self.emitIndirectLoad(MaxonType.integer, box: name.handle, offset: ServiceHandleCownOffset, storageType: MaxonType.integer, range: range)
			self.emitIndirectStore(cownBox, offset: (position * PointerFieldBytes) as ByteOffset, value: cown, storageType: MaxonType.integer, range: range)
			cowns.push(cown)
		end 'eachName'

		let count = self.emitLiteral(names.count() as FullRangeInt, valueType: MaxonType.integer, range: range)
		let word = self.emitRuntimeCall(CownAcquireName, args: twoArgs(cownBox, second: count), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		let acquireOp = self.artifact.module.opCount() - 1
		self.noteWaitSeed(self.bodyFunction(), site: WaitSite.acquire(acquireOp))
		let current = self.bodyFunction()
		current.mayYieldSeed = true
		self.emitOwnershipRuntimeCall(MmDecrefName, args: argsOf(cownBox), range: range)
		return (cowns, word)
	end 'emitAcquireCall'

	function parseAcquireBody(func IrFunction, bodyBlock IrBlock, names AcquiredNameArray, cowns ValueIdArray, group ValueId, labelTok Token, acquireTok Token) returns IrBlock throws SourceParseError
		self.bodyState.currentBlock = bodyBlock
		let range = SourceRange.ofToken(acquireTok)
		let floor = self.bodyState.valueCapabilities.count() as ValueId
		self.bodyState.scope.pushScope()

		for position in 0 upto names.count() 'eachName'
			let name = try names.get(position) otherwise panic("parseAcquireBody: names.get OOB at {position} below the count just read")
			let cown = try cowns.get(position) otherwise panic("parseAcquireBody: cowns.get OOB at {position} below the count just read")
			let state = self.emitIndirectLoad(name.stateType, box: cown, offset: CownOffState, storageType: MaxonType.integer, range: range)
			self.setValueCapability(state, capability: ValueCapability.isolated)
			self.bodyState.acquiredStates = withValueMarked(self.bodyState.acquiredStates, value: state)
			self.regionFactsForWrite().acquiredNames.push(AcquiredStateName.create(state, name: name.token.value))
			_ = try self.declareCaughtErrorBinding(name.token.value, anchor: name.token, varType: name.stateType, value: state)
		end 'eachName'

		let guardFloor = self.openWindowCount()
		let windows = self.regionFactsForWrite().windows
		windows.push(OpenWindow.create(labelTok.value, rootText: EmptySourceText, rootName: EmptySourceText, kind: WindowKind.acquire, floor: floor, openedValue: 0, holderValue: 0, holderField: 0, opensAField: false, ownerStatement: self.bodyState.statementStart))
		self.emitStrandGuard(GtStrandGuardEnterName, range: range)
		self.bodyState.heldAcquire = HeldAcquire.held(group, guardFloor: guardFloor)

		let bodyEnd = try self.parseBlockBody(func, block: self.bodyState.currentBlock, label: labelTok.value)

		if not bodyEnd.isTerminated() 'fallsThrough'
			self.emitWindowExitsInto(bodyEnd, floor: guardFloor, anchor: labelTok)
		end 'fallsThrough'

		self.bodyState.heldAcquire = HeldAcquire.none
		_ = try windows.pop() otherwise panic("parseAcquireBody: the window this statement pushed is gone from the stack it popped")
		self.bodyState.scope.popScope()
		self.bodyState.currentBlock = bodyEnd
		return bodyEnd
	end 'parseAcquireBody'

	function parseAcquireHandler(func IrFunction, handlerBlock IrBlock, stopped ValueId, names AcquiredNameArray, otherwiseTok Token) returns IrBlock throws SourceParseError
		let binder = try self.parseOptionalCaughtErrorBinder(otherwiseTok)
		let labelTok = try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		self.bodyState.currentBlock = handlerBlock
		self.bodyState.scope.pushScope()

		if let name = try binder.boundName() 'aNamedPosition'
			let range = SourceRange.ofToken(binder.anchor)
			let position = self.emitMachineWordBinOp(stopped, rhs: self.emitLiteral(AcquireStoppedBit, valueType: MaxonType.integer, range: range), op: MaxonBinOp.bitXor, resultType: MaxonType.integer, range: range)
			self.recordProvenIntRange(position, low: 0, high: (names.count() - 1) as FullRangeInt)
			_ = try self.declareCaughtErrorBinding(name, anchor: binder.anchor, varType: MaxonType.integer, value: position)
			self.bodyState.unusedCandidates.push(UnusedBindingCandidate.create(self.bodyState.scope.getInfo(name), nameRange: range, kind: UnusedBindingKind.caughtError, declToken: self.pos))
		end 'aNamedPosition'

		let handlerEnd = try self.parseBlockBody(func, block: self.bodyState.currentBlock, label: labelTok.value)
		self.bodyState.scope.popScope()
		return handlerEnd
	end 'parseAcquireHandler'

	function emitStrandGuard(callee ByteArray, range SourceRange)
		_ = self.emitRuntimeCall(callee, args: ValueIdArray.create(0), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitStrandGuard'

	function openWindowCount() returns ElementIndex
		let table = self.regionFactsForWrite()
		return modifyWindowCount(table.windows) + table.callGuards
	end 'openWindowCount'

	function callNeedsAStrandGuard(opensAnIsolatedValue bool) returns bool
		if opensAnIsolatedValue 'anOpenedValue'
			return true
		end 'anOpenedValue'

		let windows = self.regionFactsForRead().windows
		return modifyWindowCount(windows) == 0 and statementWindowIsOpen(windows)
	end 'callNeedsAStrandGuard'

	function enterCallGuard(range SourceRange)
		let table = self.regionFactsForWrite()
		table.callGuards = table.callGuards + 1
		self.emitStrandGuard(GtStrandGuardEnterName, range: range)
	end 'enterCallGuard'

	function leaveCallGuard(range SourceRange)
		let table = self.regionFactsForWrite()
		table.callGuards = table.callGuards - 1

		if not self.bodyState.currentBlock.isTerminated() 'stillFlowing'
			let exitOp = self.artifact.module.ops.count()
			self.emitStrandGuard(GtStrandGuardExitName, range: range)
			self.bodyState.callTrailerOps.insert(exitOp)
		end 'stillFlowing'
	end 'leaveCallGuard'

	function sameHolderPath(first ValueId, second ValueId) returns bool
		if first == second 'sameValue'
			return true
		end 'sameValue'

		let origins = self.regionFactsForRead().fieldOrigins
		let firstOrigin = try origins.get(first) otherwise return false
		let secondOrigin = try origins.get(second) otherwise return false

		if firstOrigin.field != secondOrigin.field 'differentField'
			return false
		end 'differentField'

		return self.sameHolderPath(firstOrigin.holder, second: secondOrigin.holder)
	end 'sameHolderPath'

	function fieldWindowState(windows WindowStack, holder ValueId, field FieldIndex) returns FieldWindowState
		var position = windows.count()
		var innerBlockOpen = false

		while position > 0 'outwardFromTheInnermost'
			position = position - 1
			let window = try windows.get(position) otherwise panic("fieldWindowState: windows.get OOB at {position} below the count just read")

			if window.opensAField and window.holderField == field and self.sameHolderPath(window.holderValue, second: holder) 'theOpenedPath'
				return FieldWindowState.paused if innerBlockOpen else FieldWindowState.open
			end 'theOpenedPath'

			if window.kind == WindowKind.modify 'anInnerBlock'
				innerBlockOpen = true
			end 'anInnerBlock'
		end 'outwardFromTheInnermost'

		return FieldWindowState.notOpen
	end 'fieldWindowState'

	function slotRootsDiffer(firstHolder ValueId, firstField FieldIndex, secondHolder ValueId, secondField FieldIndex) returns bool
		return firstField != secondField or not self.sameHolderPath(firstHolder, second: secondHolder)
	end 'slotRootsDiffer'

	function otherRootOfThisStatement(holder ValueId, field FieldIndex, countingCalls bool) returns immutable ByteArray throws AbsentError
		let table = self.regionFactsForWrite()

		for window in table.windows 'eachWindow'
			if window.kind == WindowKind.oneStatement and window.opensAField and window.ownerStatement == self.bodyState.statementStart and self.slotRootsDiffer(window.holderValue, firstField: window.holderField, secondHolder: holder, secondField: field) 'aDifferentRoot'
				return window.label
			end 'aDifferentRoot'
		end 'eachWindow'

		if not countingCalls 'windowsOnly'
			throw AbsentError.absent
		end 'windowsOnly'

		for opened in table.callOpens 'eachCallOpen'
			if opened.ownerStatement == self.bodyState.statementStart and self.slotRootsDiffer(opened.holderValue, firstField: opened.holderField, secondHolder: holder, secondField: field) 'aDifferentCallRoot'
				return opened.label
			end 'aDifferentCallRoot'
		end 'eachCallOpen'

		throw AbsentError.absent
	end 'otherRootOfThisStatement'

	function recordCallOpen(openedValue ValueId, openedTok Token) throws SourceParseError
		let origin = try self.regionFactsForRead().fieldOrigins.get(openedValue) otherwise return
		let rootName = try self.layoutOfOrigin(origin).fieldNames.get(origin.field) otherwise panic("recordCallOpen: fieldNames.get OOB at {origin.field}")

		if let first = try self.otherRootOfThisStatement(origin.holder, field: origin.field, countingCalls: false) 'aStatementOpenElsewhere'
			throw self.regionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: self.twoRootsMessage(first, second: rootName), line: openedTok.line, column: openedTok.column)
		end 'aStatementOpenElsewhere'

		let opened = self.regionFactsForWrite().callOpens

		if not opened.isEmpty() and (innermostWindowOf(opened)).ownerStatement != self.bodyState.statementStart 'staleStatement'
			opened.clear()
		end 'staleStatement'

		opened.push(OpenWindow.create(rootName, rootText: EmptySourceText, rootName: EmptySourceText, kind: WindowKind.oneStatement, floor: 0, openedValue: openedValue, holderValue: origin.holder, holderField: origin.field, opensAField: true, ownerStatement: self.bodyState.statementStart))
	end 'recordCallOpen'

	function twoRootsMessage(first ByteArray, second ByteArray) returns String
		return "one statement reaches through two isolated values, '{String.from(first)}' and '{String.from(second)}'; a statement opens one isolated value, so open one with `modify` or split the statement"
	end 'twoRootsMessage'

	function noteSecondRootOfAStatement(holder ValueId, field FieldIndex, name ByteArray, range SourceRange)
		let first = try self.otherRootOfThisStatement(holder, field: field, countingCalls: true) otherwise return
		self.deferRegionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: self.twoRootsMessage(first, second: name), line: range.line, column: range.column)
	end 'noteSecondRootOfAStatement'

	function deferRegionRefusal(code ErrorCode, message String, line LineNumber, column ColumnNumber)
		let table = self.regionFactsForWrite()

		match table.deferredRefusal 'state'
			at then return
			none then break
		end 'state'

		table.deferredRefusal = DeferredRefusal.at(line, column: column, code: code, message: message)
	end 'deferRegionRefusal'

	function requireNoDeferredRefusal() throws SourceParseError
		try self.requireNoHandedBackResult()

		match self.regionFactsForWrite().deferredRefusal 'state'
			none then return
			at(line, column, code, message) then throw self.regionRefusal(code, message: message, line: line, column: column)
		end 'state'
	end 'requireNoDeferredRefusal'

	function statementWindowFloor() returns ElementIndex
		return self.regionFactsForRead().windows.count()
	end 'statementWindowFloor'

	function closeWindowsTo(floor ElementIndex)
		let windows = self.regionFactsForWrite().windows

		while windows.count() > floor 'eachWindowThisStatementOpened'
			_ = try windows.pop() otherwise panic("closeWindowsTo: the stack holds more than {floor} windows and cannot pop one")
		end 'eachWindowThisStatementOpened'

		self.forgetStatementFacts()
	end 'closeWindowsTo'

	function openStatementWindowThrough(box ValueId, floor ValueId, range SourceRange)
		if self.valueIsAValueType(box) or self.effectiveCapabilityOf(box) != ValueCapability.isolated 'notAnUnopenedIsolated'
			return
		end 'notAnUnopenedIsolated'

		self.noteStateReached(box, line: range.line, column: range.column)
		let windows = self.regionFactsForWrite().windows

		if let origin = try self.regionFactsForWrite().fieldOrigins.get(box) 'aSlotRead'
			if self.fieldWindowState(windows, holder: origin.holder, field: origin.field) != FieldWindowState.notOpen 'alreadyOpen'
				return
			end 'alreadyOpen'

			let rootName = try self.layoutOfOrigin(origin).fieldNames.get(origin.field) otherwise panic("openStatementWindowThrough: fieldNames.get OOB at {origin.field}")
			self.noteSecondRootOfAStatement(origin.holder, field: origin.field, name: rootName, range: range)
			windows.push(OpenWindow.create(rootName, rootText: EmptySourceText, rootName: EmptySourceText, kind: WindowKind.oneStatement, floor: floor, openedValue: box, holderValue: origin.holder, holderField: origin.field, opensAField: true, ownerStatement: self.bodyState.statementStart))
			return
		end 'aSlotRead'

		if windowOpensValue(windows, value: box) 'alreadyOpenValue'
			return
		end 'alreadyOpenValue'

		if self.valueIsAValueType(floor) and valueIsAParameter(box, paramCount: self.bodyFunction().paramCount) 'aNumberReadFromAnIsolatedParameter'
			return
		end 'aNumberReadFromAnIsolatedParameter'

		windows.push(OpenWindow.create(IsolatedValueLabel, rootText: EmptySourceText, rootName: EmptySourceText, kind: WindowKind.oneStatement, floor: floor, openedValue: box, holderValue: 0, holderField: 0, opensAField: false, ownerStatement: self.bodyState.statementStart))
	end 'openStatementWindowThrough'

	function emitWindowExitsInto(block IrBlock, floor ElementIndex, anchor Token)
		let openNow = self.openWindowCount()

		if openNow <= floor 'nothingOpenedSince'
			return
		end 'nothingOpenedSince'

		let previous = self.swapCurrentBlock(block)

		for _ in floor upto openNow 'eachWindowLeft'
			self.emitStrandGuard(GtStrandGuardExitName, range: SourceRange.ofToken(anchor))
		end 'eachWindowLeft'

		match self.bodyState.heldAcquire 'acquire'
			none then break
			held(group, guardFloor) then self.emitAcquireRelease(group, guardFloor: guardFloor, floor: floor, anchor: anchor)
		end 'acquire'

		_ = self.swapCurrentBlock(previous)
	end 'emitWindowExitsInto'

	function emitAcquireRelease(group ValueId, guardFloor ElementIndex, floor ElementIndex, anchor Token)
		if floor > guardFloor 'staysInsideTheBlock'
			return
		end 'staysInsideTheBlock'

		_ = self.emitRuntimeCall(CownAcquireReleaseName, args: argsOf(group), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
	end 'emitAcquireRelease'

	function emitNot(operand ValueId, op MaxonUnaryOp, resultTag ValueTypeTag, opTok Token) returns ValueId
		let complemented = self.emitUnaryOp(operand, op: op, resultTag: resultTag, range: SourceRange.ofToken(opTok))
		self.adoptUnaryResultAlias(complemented, operand: operand, op: op, resultTag: resultTag)

		if op == MaxonUnaryOp.logicalNot 'aBoolNegation'
			self.negateConditionOrders(operand, result: complemented)
		end 'aBoolNegation'

		return complemented
	end 'emitNot'

	// ⭐⭐ **`spawn <T>.<factory>(…)` — the ONE reader, for the TWO positions that admit it**
	// (`parseAwait`'s precedent, and its reason: a statement-position copy is exactly the shape that
	// drifts). The cursor sits on the word `spawn`, which `atSpawnPrefix` has already recognized. An
	// optional `(capacity: n)` group between the word and the target sets the mailbox's capacity;
	// without one it is `DefaultMailboxCapacity`.
	//
	// ⭐⭐ **EVERY SERVICE REFUSAL IS RAISED HERE, AT THE SITE THE AUTHOR WROTE — and that is forced twice
	// over.** The classification is a WHOLE-PROGRAM fact and could only be computed by the declaration sweep;
	// but the sweep is MEMOIZED and reports nothing (see `ServiceCompanions`' header, and
	// `ProgramSignatures.evaluateInitializers`, which records the trap for itself). And the design requires a
	// service diagnostic to NAME the spawn that made the type a service, because whether a type is a service
	// is decided by a `spawn` that may be in a different file from the method the finding is about. Raising at
	// the spawn site satisfies both: the sweep decides, this speaks, and the diagnostic is at the site by
	// construction rather than by carrying one around.
	//
	// ⚠ **IT REFUSES BEFORE IT EMITS, AND THE ROSTER IS ASKED TWICE SO THAT STAYS TRUE OF EVERY VERDICT A
	// DECLARATION DECIDES.** The first ask precedes the factory call and condemns a redeclared message, an
	// untransferable parameter and a reply the cell cannot carry — every refusal a monomorphic service can
	// earn, which is every one the corpus pins. That is `emitBinOp`'s ordering rule, which every door that
	// can throw mid-expression keeps.
	//
	// ⚠ **ONE VERDICT CANNOT BE ASKED THERE.** Whether a generic
	// service's `returns T` fits the cell's single integer word is a fact about the CONCRETE type, and
	// nothing fixes it until the factory's ARGUMENTS have been read — so that question is deferred
	// (`ServiceRosterKnowledge`) and re-asked below, after the call has emitted its ops. A `spawn` refused
	// there leaves those ops behind; they reach nothing, because a `SourceParseError` either rewinds
	// its region, truncating them, or discards the whole artifact (`abortedParseArtifact`).
	function parseSpawn(func IrFunction, handling SpawnStartHandling) returns ValueId throws SourceParseError
		let tryTok = self.tokenAt(self.pos - 1)
		let spawnTok = self.current()
		self.advance()
		let capacity = try self.parseSpawnCapacity(func, spawnTok: spawnTok)

		// ⛔ **`spawn Self.create()` IS REFUSED, AND THE REFUSAL IS THE DISCOVERY WALK'S SHAPE RATHER THAN A
		// GAP IN THIS READER.** Which types are services is decided before any file is parsed, by a walk over
		// raw tokens (`Queries.serviceSpawnFollowing`) that has no type scope to resolve `Self` against — so a
		// `Self` spawn would name a service nothing minted companions for. Admitted by `atSpawnPrefix` purely
		// so it can be refused in its own words instead of dying as `E2001 unexpected token: 'Self'`.
		if self.at(TokenKind.selfType) 'selfTarget'
			throw SourceParseError.unsupported("`spawn Self.…` — the whole-program walk that decides which types are services reads tokens with no type scope, so `Self` names nothing there. Write the type outright (`spawn Calc.create()`)", line: spawnTok.line, column: spawnTok.column)
		end 'selfTarget'

		let spawned = try self.spawnedTypeAt(self.pos, spawnTok: spawnTok)

		match spawned 'entry'
			declared(declaration, consumed) then try self.settleTypeNameVerdict(self.enterChainType(declaration, consumed: consumed, anchor: self.current()))
			named then break
		end 'entry'

		let baseIndex = self.pos
		let typeTok = try self.consumeSpawnTypeToken(baseIndex)
		let typeName = spawned.typeName()

		try self.consume(TokenKind.dot)

		// ⚠ **PEEKED AND NOT CONSUMED — the cursor is left ON the factory name deliberately.** The call below
		// goes through `parseCallNamed`, the door every other static call comes through, and that door
		// consumes its own callee token (`dispatchMethodOnBase` says so where it hands the cursor over).
		// Consuming it here would leave the factory's arguments to a second reader.
		let memberTok = try self.memberNameTokenAt(self.pos)

		// ⭐ **THE SAME CLASSIFICATION THE SWEEP MINTED COMPANIONS FROM.** Asked through the one function so a
		// target this refuses can never be one the sweep minted for, nor the other way round. The verdict is
		// BOUND rather than matched in place, so each arm hands the WORDS routine the value it matched instead
		// of rebuilding it — a rebuilt verdict is a second statement of which arm fired.
		let target = classifyServiceTarget(self.signatures, typeName: typeName, member: memberTok.value)

		match target 'target'
			startsAService then break

			// ⚖ A constrained generic is E2015 — the witness threading a synthesized loop would need is a
			// thing that could be built. Every other refusing arm is E3134: not what `spawn` means, ever, so
			// they share one throw.
			typeIsNotAStruct or
			memberIsNotDeclared or
			memberTakesAReceiver or
			memberDoesNotReturnTheType then throw SourceParseError.serviceTypeNotASpawnTarget(serviceTargetRefusalMessage(target, typeName: typeName, member: memberTok.value), typeName: String.from(typeName), line: spawnTok.line, column: spawnTok.column)
			typeIsAConstrainedGeneric then throw SourceParseError.unsupported(serviceTargetRefusalMessage(target, typeName: typeName, member: memberTok.value), line: spawnTok.line, column: spawnTok.column)
		end 'target'

		// ⭐⭐ **THE FACTORY CALL IS READ THROUGH THE ORDINARY STATIC-CALL DOOR.** The arguments, the
		// labels, the defaults and the diagnostics are all the ordinary call's;
		// the door then emits a `serviceSpawn` op in place of the call (`emitServiceSpawnOp`), because
		// the factory runs as the service's start behaviour, on a runner green thread. Every argument moves
		// there (`CallArgTarget.movedInto`): the factory runs after this frame may have released a borrowed
		// argument, or a parameter cell it made. `inferInstanceOf` because a generic target's type
		// arguments exist nowhere but this argument list.
		let launch = ServiceSpawnLaunch.create(typeName, capacity: capacity, cown: self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId), tempFloor: self.bodyState.pendingTempDrops.count(), ownedFloor: self.bodyState.ownedBindings.count())

		// A field read off a temporary crosses as an argument only because
		// `releaseHandOffBuildTemps` releases that temporary with the spawn — so the marks are
		// cleared to those this argument list makes, and an enclosing `spawn`'s are restored after it.
		let outerTemporaryFieldReads = self.bodyState.temporaryFieldReads
		self.bodyState.temporaryFieldReads = noValueMarks
		let state = try self.parseCallNamed(func, callee: qualifiedMethodName(typeName, methodName: memberTok.value), anchor: memberTok, receiver: ReceiverArg.none, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: self.staticCallHeadMint(baseIndex, typeTok: typeTok), inferInstanceOf: FactoryInference.of(typeName), serviceSite: ServiceSpawnSite.at(spawnTok, launch: launch))
		self.bodyState.temporaryFieldReads = outerTemporaryFieldReads
		try self.requireServiceRosterIsDispatchable(typeName, factory: memberTok.value, knowledge: ServiceRosterKnowledge.declarationOnly, spawnTok: spawnTok)
		let instance = self.serviceStateInstanceOf(state)

		// The deferred half, asked only where something was deferred: a monomorphic service has no type
		// parameter for the first ask to have left open, so it is judged once and exactly as it always was.
		match instance 'fixed'
			monomorphic then break
			at then try self.requireServiceRosterIsDispatchable(typeName, factory: memberTok.value, knowledge: ServiceRosterKnowledge.atInstance(instance), spawnTok: spawnTok)
		end 'fixed'

		match self.statement.lastSpawnStart 'reply'
			noReply then return try self.finishImmediateSpawn(typeName, launch: launch, instance: instance, spawnTok: spawnTok, memberTok: memberTok, handling: handling, tryTok: tryTok)
			viaCell(callee) then return try self.awaitServiceStart(typeName, factory: callee, cell: launch.cown, instance: instance, spawnTok: spawnTok, handling: handling)
		end 'reply'
	end 'parseSpawn'

	function finishImmediateSpawn(typeName ByteArray, launch ServiceSpawnLaunch, instance ServiceStateInstance, spawnTok Token, memberTok Token, handling SpawnStartHandling, tryTok Token) returns ValueId throws SourceParseError
		match handling 'handling'
			routed then break
			caught then throw SourceParseError.tryOnNonThrowing(String.from(self.signatures.diagnosticCalleeSpelling(qualifiedMethodName(typeName, methodName: memberTok.value))), line: tryTok.line, column: tryTok.column)
		end 'handling'

		return self.emitServiceHandle(typeName, cown: launch.cown, instance: instance, spawnTok: spawnTok, memberTok: memberTok)
	end 'finishImmediateSpawn'

	function awaitServiceStart(typeName ByteArray, factory ByteArray, cell ValueId, instance ServiceStateInstance, spawnTok Token, handling SpawnStartHandling) returns ValueId throws SourceParseError
		let handleType = self.serviceHandleValueType(self.serviceHandleLayout(typeName), instance: instance)
		let facts = AwaitedPromise.create(AwaitedResult.declared(MaxonReturnType.value(handleType)), tryTarget: TryTarget.serviceStart(factory, awaitedService: typeName))
		let handle = try self.emitStartAwait(cell, facts: facts, awaitTok: spawnTok, handling: handling)
		self.markValueOwnsHeap(handle, exclusivity: OwnedHeapExclusivity.sole)
		return handle
	end 'awaitServiceStart'

	function emitStartAwait(cell ValueId, facts AwaitedPromise, awaitTok Token, handling SpawnStartHandling) returns ValueId throws SourceParseError
		match handling 'handling'
			routed then return try self.emitRoutedAwait(cell, facts: facts, awaitTok: awaitTok)
			caught then break
		end 'handling'

		let (handle, _) = try self.emitAwaitOp(cell, facts: facts, awaitTok: awaitTok)
		return handle
	end 'emitStartAwait'

	function spawnedTypeAt(headIndex ElementIndex, spawnTok Token) returns SpawnedType throws SourceParseError
		let dots = self.dottedChainLengthAt(headIndex)

		if dots == 0 or not self.chainCallFollowsAt(headIndex) 'notATypeAndAFactory'
			throw SourceParseError.serviceNotASpawnTarget(spawnShapeRefusalMessage(String.from(self.tokenAt(headIndex).value)), line: spawnTok.line, column: spawnTok.column)
		end 'notATypeAndAFactory'

		if dots == MethodQualifierDots 'aBareTypeName'
			return SpawnedType.named(self.tokenAt(headIndex).value)
		end 'aBareTypeName'

		let written = self.assembleDottedChainAt(headIndex, dots: dots)
		let qualifierText = chainSpellingAt(self.tokens, at: headIndex, segments: dots - 1)

		match self.resolveChainAt(headIndex, use: ChainUse.memberReference) 'chain'
			declaredType(declaration, consumed) then return SpawnedType.declared(declaration, consumed: consumed)
			ambiguous(ambiguousWritten, candidates) then throw ambiguousTypeNameRefusal(ambiguousWritten, candidates: candidates, anchor: self.tokenAt(headIndex))
			value then throw SourceParseError.serviceNotASpawnTarget(spawnChainRefusalMessage(written, reason: chainHeadIsAValueText(self.tokenAt(headIndex).value, qualifier: qualifierText)), line: spawnTok.line, column: spawnTok.column)
			nothing(qualifier) then throw SourceParseError.serviceNotASpawnTarget(spawnChainRefusalMessage(written, reason: chainNamesNothingText(qualifier)), line: spawnTok.line, column: spawnTok.column)
			unqualified or
			declaredFunction then return SpawnedType.named(qualifierText)
		end 'chain'
	end 'spawnedTypeAt'

	// Through `consumeNameToken`, not `consume(identifier)`: BOTH halves of `<Type>.<factory>` may be
	// spelled with a keyword, and `stdlib/FilePath.maxon`'s `from` is the live proof for the member
	// half. It is the same reader every other declaration and member position uses.
	function consumeSpawnTypeToken(baseIndex ElementIndex) returns Token throws SourceParseError
		if self.qualifiedTypeBaseIsAt(baseIndex) 'anEnteredQualifiedBase'
			return try self.consumeTypeBaseToken()
		end 'anEnteredQualifiedBase'

		return try self.consumeNameToken(NamePosition.declaration)
	end 'consumeSpawnTypeToken'

	function parseSpawnCapacity(func IrFunction, spawnTok Token) returns ValueId throws SourceParseError
		if not self.at(TokenKind.leftParen) 'noCapacityGroup'
			return self.emitDefaultMailboxCapacity(spawnTok)
		end 'noCapacityGroup'

		try self.consume(TokenKind.leftParen)
		let labelTok = try self.consume(TokenKind.identifier)

		if not labelTok.value.equals(SpawnCapacityLabel) 'notTheCapacityLabel'
			panic("parseSpawnCapacity: the group opens with `{String.from(labelTok.value)}`, and `atSpawnPrefix` admits a group only when its label is `{String.from(SpawnCapacityLabel)}`")
		end 'notTheCapacityLabel'

		try self.consume(TokenKind.colon)
		let valueTok = self.current()
		let capacity = try self.parseValueExpression(func)
		try self.requireArgumentFitsDeclaredAlias(capacity, alias: self.mailboxCapacityAlias(), paramName: labelTok.value, anchor: valueTok)
		try self.consume(TokenKind.rightParen)

		return capacity
	end 'parseSpawnCapacity'

	function mailboxCapacityAlias() returns RangedTypeAlias
		return try requireDeclaredAlias(self.signatures.libraryAliasDeclaration(MailboxCapacityAliasName)) otherwise panic("mailboxCapacityAlias: no library file declares the ranged typealias `{String.from(MailboxCapacityAliasName)}`, which stdlib/Builtins.maxon declares")
	end 'mailboxCapacityAlias'

	function emitDefaultMailboxCapacity(spawnTok Token) returns ValueId
		let alias = self.mailboxCapacityAlias()

		return match self.signatures.constantValueOf(DefaultMailboxCapacityName, readerFilePath: alias.declFilePath) 'constant'
			found(payload, tag, typeName) gives self.emitFoldedConstant(payload, tag: tag, typeName: typeName, range: SourceRange.ofToken(spawnTok))
			foundManaged or
			foundImageRecord or
			foundImageBox or
			recordDeferred or
			poisoned or
			notFound panic("emitDefaultMailboxCapacity: `{String.from(DefaultMailboxCapacityName)}` is not an integer constant beside `{String.from(MailboxCapacityAliasName)}` in stdlib/Builtins.maxon")
		end 'constant'
	end 'emitDefaultMailboxCapacity'

	// ⭐ **THE ROSTER'S REFUSALS, IN ONE PLACE BECAUSE THE `spawn` ASKS TWICE.** Both asks raise the
	// same diagnostics at the same site; a second copy of these arms would be a second chance for the
	// two asks to report one verdict two ways.
	function requireServiceRosterIsDispatchable(typeName ByteArray, factory ByteArray, knowledge ServiceRosterKnowledge, spawnTok Token) throws SourceParseError
		let roster = classifyServiceRoster(self.signatures, typeName: typeName, factory: factory, knowledge: knowledge)

		match roster 'roster'
			rosterIsDispatchable then return
			messageParameterIsNotTransferable or
			messageReplyIsNotTransferable or
			factoryParameterIsNotTransferable or
			messageParameterNeedsACapability or
			messageReplyNeedsACapability or
			factoryParameterNeedsACapability then throw SourceParseError.registryRefused(ErrorCode.semanticMessageNeedsACapability, explanation: serviceRosterRefusalMessage(roster, typeName: typeName), line: spawnTok.line, column: spawnTok.column, note: DiagnosticNote.none)
			messageReplyIsNotCarriable then throw SourceParseError.serviceReplyNotCarriable(serviceRosterRefusalMessage(roster, typeName: typeName), line: spawnTok.line, column: spawnTok.column)
			messageDeclaresTheSendTimeoutLabel then throw SourceParseError.registryRefused(ErrorCode.semanticServiceSendTimeoutReserved, explanation: serviceRosterRefusalMessage(roster, typeName: typeName), line: spawnTok.line, column: spawnTok.column, note: DiagnosticNote.none)
			stateFieldHoldsAPromise then throw SourceParseError.registryRefused(ErrorCode.semanticServiceStateHoldsAPromise, explanation: serviceRosterRefusalMessage(roster, typeName: typeName), line: spawnTok.line, column: spawnTok.column, note: DiagnosticNote.none)
		end 'roster'
	end 'requireServiceRosterIsDispatchable'

	// ⭐ **WHICH INSTANTIATION A VALUE OF A SERVICE'S OWN SHAPE NAMES** — this tier's two columns, handed to
	// the ONE classifier the lowering and `ServiceBehaviour` also read (`serviceStateInstanceOfValueType`), so
	// the `<T>.__behave` that is built is the one that is called.
	function serviceStateInstanceOf(value ValueId) returns ServiceStateInstance
		return serviceStateInstanceOfValueType(self.tagOf(value), nameId: self.valueNameId(value))
	end 'serviceStateInstanceOf'

	// ⭐⭐ **WRAP A STARTED SERVICE'S COWN IN A HANDLE BOX** — for a factory that cannot throw, whose
	// `serviceSpawn` answers the COWN, a bare machine word. `emitBoxAllocWithDestructor` is the one
	// `__mm_alloc` door — it is where a box's destructor argument is decided, and this box's
	// (`__cown_handle_destruct`) gives back the cown share the spawn's initial counts hold.
	// Enrolling the result through `trackOwnedTemp` is what makes a handle an ORDINARY owned value:
	// `let h = …` binds it, a second read after a move is E3102, an array element drop reaches it, and
	// its scope-exit drop is what shuts the service down. A throwing factory's handle is minted by the
	// start behaviour on a runner green thread and comes back through the start's await, which marks it sole
	// (`awaitServiceStart`).
	function emitServiceHandle(typeName ByteArray, cown ValueId, instance ServiceStateInstance, spawnTok Token, memberTok Token) returns ValueId
		let range = SourceRange.between(spawnTok, last: memberTok)

		let handle = self.serviceHandleLayout(typeName)
		let handleType = self.serviceHandleValueType(handle, instance: instance)
		let box = self.emitBoxAllocWithDestructor(self.emitLiteral(handle.sizeBytes() as FullRangeInt, valueType: MaxonType.integer, range: range), destructor: self.emitCodeAddress(CownHandleDestructName, range: range), resultTag: maxonTypeTag(handleType), resultNameId: typeNameIdOf(handleType), range: range, tag: MmTag.Untagged)
		self.trackOwnedTemp(box, exclusivity: OwnedHeapExclusivity.sole)
		self.emitIndirectStore(box, offset: ServiceHandleCownOffset, value: cown, storageType: MaxonType.integer, range: range)
		return box
	end 'emitServiceHandle'

	// ⭐⭐ **THE TYPE A HANDLE VALUE CARRIES — AND FOR A GENERIC SERVICE IT IS AN INSTANCE OF THE ONE
	// COMPANION, NOT A SECOND COMPANION.** `<T>.handle` is minted once, whatever `<T>` is instantiated at;
	// the value stands at `<T>.handle with <Args>` so that a send can resolve a `returns T` reply against
	// the very instantiation the `spawn` started. The layout has ONE integer field either way, so the box is
	// the same eight bytes and `ProgramSignatures.isServiceHandle` still recognises it by base name.
	function serviceHandleValueType(handle StructLayout, instance ServiceStateInstance) returns MaxonType
		return match instance 'i'
			monomorphic gives MaxonType.structRef(self.artifact.typeNames.intern(handle.name))
			at(id) gives MaxonType.genericInstance(self.signatures.internInstanceOverArgsOf(handle.name, likeInstance: id))
		end 'i'
	end 'serviceHandleValueType'

	// The `<T>.handle` layout, or a panic: the companions were minted for every ACCEPTED spawn target inside
	// `queryProgramSignatures`, and every caller here has just been through `classifyServiceTarget`.
	function serviceHandleLayout(typeName ByteArray) returns StructLayout
		return match self.signatures.structInAnyFile(serviceHandleCompanionName(typeName)) 'lookup'
			declared(layout) gives layout
			undeclared panic("serviceHandleLayout: nothing declares `type {String.from(serviceHandleCompanionName(typeName))}` — `ServiceCompanions.synthesizeServiceCompanions` mints it for every accepted spawn target before any body is parsed, and this caller has already accepted one")
		end 'lookup'
	end 'serviceHandleLayout'

	// `await <unary>` — the operand grammar and the emit, written ONCE for the TWO positions that admit it:
	// the prefix operator above, and the bare `await p` STATEMENT (`parseStatement`'s `awaitStmt` arm). The
	// cursor sits on `await`.
	//
	// Single-homing it is the point. A statement-position copy is exactly the shape that drifts — it would
	// be spelled `await <primary>` by whoever wrote it next and then `await async f()` would parse in one
	// position and not the other, for no reason anyone could state.
	function parseAwait(func IrFunction) returns ValueId throws SourceParseError
		try self.requireNoWaitInsideWindow(self.current())
		let awaitTok = try self.consume(TokenKind.await)
		let promise = try self.parseUnclaimedUnary(func)
		return try self.emitAwait(func, promise: promise, awaitTok: awaitTok)
	end 'parseAwait'

	// A primary followed by any trailing INDIRECT CALL `(args)` through a function VALUE. This
	// is the ONE place a trailing `(` on a function value becomes an indirect call, which is what makes
	// every producer of a function value callable UNIFORMLY: a local (`f(21)`), a call result
	// (`pick()(21)`), and a field read (`h.op(21)`, `o.inner.op(21)`, `self.op(x)`) all reach here holding
	// a `function`-tagged value, and the trailing `(` is applied the same way regardless of how the value
	// was produced. It also chains — `pick()(2)` or a curried `g(1)(2)` — because an indirect call's
	// result is itself a value the loop re-examines.
	//
	// ⚠ The `as`-CAST is NOT handled here — it is a LOOSER operator than unary `-` (see `parseCast`), so
	// `-5 as Age` is `(-5) as Age`. An indirect call, by contrast, binds TIGHTER than `-` (`-f()` is
	// `-(f())`), which is why it stays in this postfix band and the cast does not.
	//
	// `resultUsed` is whether this postfix chain's FINAL value is read — `false` only for a bare-call
	// STATEMENT (`callStmt`), `true` in every expression. It gates ONLY a VOID indirect-call / container-
	// mutator result, and forwarding it uniformly to every hop is correct wherever a void result is
	// TERMINAL: the loop does continue past one — every `.member` is a hop — but the next hop refuses
	// a `void`-TAGGED value (`structBaseOfReceiver` reports a member access on it, positioned at the
	// member).
	//
	// ⚠ **THAT ARGUMENT DOES NOT COVER THE CONTAINER VOID MUTATORS, AND THE GAP IS AN OVER-ACCEPTANCE
	// RATHER THAN A WRONG VALUE** (measured). `emitArrayVoidCall` and
	// `Set.insert` deliberately hand back the RECEIVER — "what the statement still denotes" — so their
	// result is NOT void-tagged and the next hop is perfectly happy: `arr.push(2).count()` as a STATEMENT
	// compiles here, where the oracle refuses it (`E2001 unexpected token: '.'`). Nothing wrong is
	// computed — the chain pushes, counts and discards — and the VALUE spelling is still refused, because
	// `let n = arr.push(2).count()` forwards `resultUsed: true` to the `push` hop, which is E2004 at
	// `push`. The honest statement is that `resultUsed` describes the chain's LAST hop and the
	// receiver-returning arms make the earlier hops' own use invisible to it.
	function parsePostfix(func IrFunction, operandStart ElementIndex, value ValueId, resultUsed bool) returns ValueId throws SourceParseError
		var current = value

		while true 'postfix'
			let continuesAsAnIndirectCall = self.at(TokenKind.leftParen) and self.tagOf(current) == ValueTypeTag.function

			if not continuesAsAnIndirectCall and not self.at(TokenKind.dot) 'theChainEnds'
				break
			end 'theChainEnds'

			self.releaseCompletedOperand()
			let argumentsStart = self.bodyState.operandOrder.eventCount()

			// A trailing `(` on a FUNCTION value is an indirect call; on anything else it is not a postfix
			// operator at all and the loop ends (a `(` after a non-function value is left for the caller,
			// which is a syntax error there — calling a non-function).
			if continuesAsAnIndirectCall 'indirectCall'
				current = try self.parseIndirectCall(func, callee: current, resultUsed: resultUsed)
				self.noteReceiverWrittenAfterArguments(operandStart, argumentsStart: argumentsStart)
				continue
			end 'indirectCall'

			// ⭐⭐ **A `.member` ON A VALUE — ONE ARM, THE SAME SWITCH A BINDING RECEIVER GOES THROUGH.** The
			// receiver is whatever the expression just built: a `"…"` / `[…]` / `b"…"` LITERAL, a CALL RESULT
			// (`Inner.make(9).get()`), a PARENTHESISED expression (`(i).get()`), a FIELD read
			// (`o.inner.get()`, whose chain stops one hop early exactly so the receiver arrives here), an
			// array element, or a previous hop of this very loop.
			//
			// A per-receiver-type set of arms is not a design, and everything outside it `break`s with the cursor
			// still on the `.` — which is how the nonsensical `E2015: Unsupported: . statement` is reached for
			// `"abc".byteLength()`. Routing every tag through
			// `dispatchMethodOnReceiver` means a type that gains a method gains it in BOTH spellings at once,
			// and a receiver that genuinely has no members gets a positioned diagnostic naming it.
			//
			// A postfix receiver is bound to no name, so it carries no E3207 blame name and no storage subject
			// — see `valueReceiver`.
			// ⭐⭐ **AN ENUM ACCESSOR ON A VALUE — `b.c.name`, and it is asked BEFORE the method dispatch for
			// the reason `parseDottedPrimary` asks its own enum arm before the field arm: a declared enum
			// erases to `integer`, so a value of one reaching the method door has no receiver type that could
			// serve `.name`. The two arms are disjoint by the `(` — `atEnumInstanceAccessor` excludes a call,
			// so an enum's real METHOD still goes to `dispatchMethodOnReceiver`.
			//
			// This is the THIRD spelling of an enum member read and it shares the other two's answer: the
			// binding's (`s.ordinal`), the type-qualified case's (`Op.doubleOp.rawValue`) and this one differ
			// ONLY in how the tag is obtained, and all three hand that tag to `emitEnumInstanceAccessor`.
			// The anchor is the `.` itself — a postfix receiver is bound to no name, so there is no earlier
			// token the read can honestly be said to span from.
			if self.atEnumAccessorHopOn(current) 'enumAccessorHop'
				let hopLayout = requireEnumLayout(self.enumMatchFor(current))
				let hopAnchor = self.current()
				current = try self.consumeEnumAccessorHop(hopLayout, tag: try self.emitEnumTagOf(current, layout: hopLayout, anchor: self.tokenAt(self.pos + 1), range: SourceRange.ofToken(hopAnchor), reach: EnumTagReach.written), anchorTok: hopAnchor)
				continue
			end 'enumAccessorHop'

			current = try self.dispatchMethodOnReceiver(func, recv: self.valueReceiver(current, immutableName: EmptySourceText, subjectName: StorageSubject.none), resultUsed: resultUsed)
			self.noteReceiverWrittenAfterArguments(operandStart, argumentsStart: argumentsStart)
		end 'postfix'

		return current
	end 'parsePostfix'

	// Apply one `as <targetType>` cast to `value`. Four shapes, decided by the source value's
	// domain and the target's:
	//   • int → float  — emit `promoteToFloat` (`cvtsi2sd`, or the unsigned conversion for a value above
	//     `i64.max`); the value BECOMES a float. This is the conversion a no-op `as` would skip
	//     (`explicit-cast-int-to-float`).
	//   • float → int  — emit `trunc` (`cvttsd2si`), the truncating bridge out of the float domain.
	//   • same representation (int→int, float→float) — the value flows on UNCHANGED, keeping its own tag,
	//     UNLESS the target type says something the source's tag does not. Then the cast MINTS a distinct
	//     value carrying the target type (`emitRetaggedCastValue`) — see the two predicates below for
	//     exactly when, and the paragraph after this one for why "unchanged" is a wrong answer.
	//     The value's alias name is what a narrowing check needs, and it rides the recorded site rather
	//     than the tag: when the target is a ranged alias that site is recorded so `InsertRangeChecks`
	//     guards / E3005s it.
	//
	//     ⚠ **A RE-TAG CANNOT BE DONE IN PLACE.** `let w = x as Word`
	//     leaves `w` and `x` naming ONE SSA value under two declared types (a binding names a value
	//     and emits no load), so re-recording that value's tag would make `x` unsigned too.
	//     `(w shr 62) + (x shr 62)` of `0xC000000000000000` is `3 + -1`; an in-place
	//     re-tag answers `3 + 3` and a dropped tag `-1 + -1`. Only a DISTINCT value gives both halves
	//     their own answer, which is why this mints one exactly as the per-instance cast does.
	//
	// `sourceIsBareLocal` is whether the OPERAND was written as a bare reference to a local — the one fact
	// `applyCast` cannot recover for itself (it holds a ValueId, and a ValueId does not say how many names
	// point at it). It gates the declared-alias record the result carries; see `finishCast`.
	function applyCast(value ValueId, targetType MaxonType, asTok Token, targetTok Token, sourceIsBareLocal bool) returns ValueId throws SourceParseError
		// ⭐ REJECT A FUNDAMENTALLY-INCOMPATIBLE KIND CAST FIRST (E3009), before any conversion is chosen. A
		// managed aggregate (String/struct/function) has no conversion to or from a scalar, nor to a
		// DIFFERENT aggregate; letting such a cast reach the float/no-op branches below would emit a
		// `promoteToFloat` or a range check on a POINTER, or leave a mismatched drop (a String drop run on a
		// struct box — a double free). See `castHasNoLegalConversion` and `SourceParseError.invalidCast`.
		// ⭐ The legality guards are NOT here — they moved INTO `convertValueToDeclaredType` with the
		// conversion they protect, so the second position that performs this conversion cannot be given
		// fewer of them than this one. See that function's ⛔⛔ block.
		let sourceTag = self.tagOf(value)
		let widened = self.interfaceHandleOf(value, declared: targetType, first: asTok, last: targetTok)

		if widened != value 'aHandleWidenedToItsInterface'
			return widened
		end 'aHandleWidenedToItsInterface'

		// ⭐ **`xs as Ys` OVER ONE INSTANCE IS A RE-BRAND**: the same record, the same layout, a different name.
		// Asked ahead of every conversion rule, because none of them has anything to say about a value that
		// keeps its representation — and ahead of the container refusal, which is about a DIFFERENT instance.
		if self.castIsARebrand(value, targetType: targetType) 'aBrandOfTheSameInstance'
			return self.rebrandValue(value, targetType: targetType, brand: self.declaredBrand(targetTok.value, resolved: targetType, readerFilePath: self.job.path), sourceIsBareLocal: sourceIsBareLocal, opTok: asTok)
		end 'aBrandOfTheSameInstance'

		// The target's ranged-alias declaration, resolved ONCE for every question that needs it — WHICH
		// alias a narrowing check names, and WHAT its range says about the shift fill. Each ask
		// CONSTRUCTS a `DeclaredAlias`, so a repeat is an allocation and not a field read.
		//
		// ⚠ It reads the RESOLVED target type and not the target TOKEN, which is what makes a qualified
		// `x as Wrapper.Idx` ask about the joined name rather than about `Wrapper`.
		let targetAlias = self.declaredAliasOfType(targetType)

		if let ownType = try self.ownTypeNamedByCast(value, targetType: targetType) 'aCastToTheValuesOwnType'
			if not self.castIsTheWholeOfAFieldDefault(asTok) 'theCastGivesTheFieldItsType'
				self.recordArtifactDiagnostic(ErrorCode.semanticUnneededCast, message: unneededAliasCastMessage(ownType, targetName: ownType), range: SourceRange.ofToken(asTok))
			end 'theCastGivesTheFieldItsType'

			return value
		end 'aCastToTheValuesOwnType'

		// ⭐ **E3010, ABOVE THE THREE CONVERSION ARMS** — because it is a question about the two DECLARED
		// types and not about the conversion any arm chooses: the int→float widening `i as JsonFloat` is as
		// unneeded as the identity `b as Byte`. RECORDED rather than thrown, so the parse walks on and every
		// unneeded cast in the file is reported by ONE compile — which is exactly what
		// `error.unneeded.multiple-in-one-function` (three of them) and `.multiple-across-functions` (two,
		// in two functions) pin, and what type-casting.md's prose calls a recoverable diagnostic.
		//
		// ⭐ **AND IT IS A DIFFERENT QUESTION FROM THE RANGE-CHECK SITE BELOW.** This one asks whether
		// the cast NAMES the value's own alias; that one asks whether the source range is provably inside the
		// target's. A widening cast between two names answers "no" here and "elide the guard" there, which is
		// exactly the pair `a-widening-cast-emits-no-guard` pins: a real door, and no instruction behind it.
		if not self.castIsTheWholeOfAFieldDefault(asTok) 'theCastGivesTheFieldItsType'
			let castTarget = self.fileScopedOrInnerAliasOfType(targetAlias, t: targetType)
			self.reportUnneededCast(self.unneededCastSourceAlias(value, target: castTarget), target: castTarget, asTok: asTok)
		end 'theCastGivesTheFieldItsType'

		return try self.convertValueToDeclaredType(value, sourceTag: sourceTag, targetType: targetType, targetAlias: targetAlias, opTok: asTok, sourceIsBareLocal: sourceIsBareLocal, mustCarryTargetType: false)
	end 'applyCast'

	// The conversion itself: the three arms and the two records that turn a value of one declared type
	// into a value of another. Split from `applyCast` because positions with no written `as` perform
	// exactly this conversion and must not perform the step left behind: a return whose value
	// names another scalar alias (`admitReturnedAggregate`), an array literal's element under an
	// `<alias> from […]` head (`admitArrayLiteralElement`), and a `processIsAlive` pid.
	//
	// ⚠ What stays in `applyCast` is what is about the `as` the author wrote, and that is a record
	// rather than a guard. `reportUnneededCast` is E3010 against a cast the source does not contain,
	// so `ByteArray from [10 as Byte, …]` would be refused for a redundancy the language accepts.
	//
	// ⛔ Every legality guard lives here, below, so every caller gets all of them. Spelled in
	// `applyCast` instead, `admitArrayLiteralElement` would re-spell one of the three
	// (`requireCastKindsConvert`) and drop `requireCastSourceIsNotEnum` and the function-type door,
	// and the element position would accept a conversion refused when it is written: `Color.green as
	// Byte` is E3009, while `ByteArray from [Color.red, Color.green]` would compile and stamp `Byte`
	// onto an enum. A guard added below is a guard every position gets; there is no second list to
	// forget.
	//
	// `sourceTag` is passed rather than re-read for `applyCast`'s stated reason — nothing between its binding
	// and here re-tags `value`, so a re-read is the same answer twice.
	function convertValueToDeclaredType(value ValueId, sourceTag ValueTypeTag, targetType MaxonType, targetAlias DeclaredAlias, opTok Token, sourceIsBareLocal bool, mustCarryTargetType bool) returns ValueId throws SourceParseError
		// ⭐ REJECT A FUNDAMENTALLY-INCOMPATIBLE KIND CONVERSION FIRST (E3009), before any arm is chosen. A
		// managed aggregate (String/struct/function) has no conversion to or from a scalar, nor to a
		// DIFFERENT aggregate; letting one reach the float or no-op arms below would emit a `promoteToFloat`
		// or a range check on a POINTER, or leave a mismatched drop (a String drop run on a struct box — a
		// double free). See `castHasNoLegalConversion` and `SourceParseError.invalidCast`.
		//
		// ⭐ **AN ENUM SOURCE IS ITS OWN REFUSAL** — `requireCastSourceIsNotEnum` carries why both backings
		// share one rule. It is the guard the element door was missing.
		self.admitUnsignedLiteral(value)

		let targetTag = try self.castTargetTag(targetType, asTok: opTok)
		try self.requireCastSourceIsNotEnum(value, targetTag: targetTag, asTok: opTok)
		try self.requireCastTargetIsNotAContainer(value, targetType: targetType, targetTag: targetTag, asTok: opTok)
		try self.requireCastKindsConvert(value, targetTag: targetTag, asTok: opTok)
		try self.requireCastTargetIsNotAnEnumOrUnion(value, targetType: targetType, asTok: opTok)
		try self.requireCastIsNotBetweenInterfaces(value, targetType: targetType, asTok: opTok)

		// ⭐ **A FUNCTION-TO-FUNCTION CONVERSION IS THE ONE `requireCastKindsConvert` LETS THROUGH
		// UNEXAMINED.** Both ends are `TypeClass.function`, so `castHasNoLegalConversion` sees the same class
		// and stands aside, and the value then falls all the way to the representational no-op at the end of
		// this function — untouched, and now claiming to be a function type it may share nothing with but its
		// tag. `intish as FloatFn` compiled clean and the integer `intish` returns was read back out of the
		// float return register. The id `castTargetTag` discards is exactly what names the target's
		// signature, which is why this reads `targetType` and not the reduced tag.
		if isFunctionTypeDoor(targetTag, got: sourceTag) 'functionTypeDoor'
			self.recordFunctionTypeDoor(typeNameIdOf(targetType), gotNameId: self.valueNameId(value), door: FunctionTypeDoor.cast, place: FunctionTypeDoorPlace.unnamed, anchor: opTok, handedAt: opTok)
			return self.rebrandValue(value, targetType: targetType, brand: EmptySourceText, sourceIsBareLocal: sourceIsBareLocal, opTok: opTok)
		end 'functionTypeDoor'

		let sourceIsFloat = tagIsFloat(sourceTag)
		let targetIsFloat = self.typeIsFloatDomain(targetType)

		if sourceIsFloat and not targetIsFloat 'floatToInt'
			// ⚠ **A CONCRETE INTEGER TARGET NO LONGER REACHES HERE — it is E3009 above** (`float → int` is
			// lossy; the language's answer is `trunc`/`round`/`floor`/`ceil`). What still does is a target no
			// tag can judge: an opaque type parameter `T`, whose cast `castHasNoLegalConversion` deliberately
			// stands aside from. The truncation is kept for it rather than deleted, because it is the only
			// reading `f as T` has ever had and nothing in the corpus asks for a different one.
			//
			// The trunc RESULT is the narrowed integer, so it — not the float source — is what a ranged INT
			// target checks (`500.7 as Byte` guards `500`). The result has its own Std op, but the guard still
			// anchors at the cast's BLOCK (below) for the same reason an int->int cast does.
			//
			// ⚠ **AND THE SOURCE RANGE THE ELISION READS IS THE `trunc` RESULT'S, WHICH IS NONE — NOT the
			// float operand's.** `trunc` changes the number, so the operand's alias describes a value this
			// door is no longer checking; anchoring on the result is what stops a `float(0.0 to 1.0)` operand
			// vouching for an integer, and a freshly minted result denotes no alias at all.
			let narrowed = self.emitUnaryOp(value, op: MaxonUnaryOp.trunc, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(opTok))
			self.recordCastRangeCheckSite(narrowed, targetAlias: targetAlias, targetType: targetType, opTok: opTok)
			return self.finishCast(narrowed, source: value, targetAlias: targetAlias, targetType: targetType, sourceIsBareLocal: sourceIsBareLocal)
		end 'floatToInt'

		if not sourceIsFloat and targetIsFloat 'intToFloat'
			return self.finishCast(self.promoteToFloat(value, opTok: opTok), source: value, targetAlias: targetAlias, targetType: targetType, sourceIsBareLocal: sourceIsBareLocal)
		end 'intToFloat'

		// ⚠ **THE RANGE-CHECK SITE IS THE SOURCE, NOT THE MINTED RESULT, AND THAT IS A CORRECTNESS
		// REQUIREMENT** — which is why it is recorded HERE, once, above a branch whose two arms both
		// anchor on the same value. The source and the mint hold the same number by construction, so
		// either would guard correctly at RUN time; but `InsertRangeChecks` decides COMPILE-TIME E3005
		// versus a runtime guard by looking the site's value up in a map built from Std `const` ops (plus
		// `neg` of one). A constant that arrived through the mint's `add` is in neither, so anchoring on
		// the result would silently downgrade `3 as Big` from a diagnostic to a guard that fires at run
		// time — `ranged-typealias.error.unsigned-max-upper-literal-out-of-range` is the case that says
		// so. The float→int cast above anchors on its RESULT for the opposite reason, stated there:
		// `trunc` changes the number, so the source is not the value being checked.
		try self.requireConstantCastInRange(value, targetAlias: targetAlias, asTok: opTok)
		self.recordCastRangeCheckSite(value, targetAlias: targetAlias, targetType: targetType, opTok: opTok)

		return self.nameValueAsDeclaredType(value, targetType: targetType, targetAlias: targetAlias, opTok: opTok, sourceIsBareLocal: sourceIsBareLocal, mustCarryTargetType: mustCarryTargetType)
	end 'convertValueToDeclaredType'

	function requireConstantCastInRange(value ValueId, targetAlias DeclaredAlias, asTok Token) throws SourceParseError
		if self.job.initializerRole == InitializerRole.ordinary 'aBodyGuardsItAtRunTime'
			return
		end 'aBodyGuardsItAtRunTime'

		let alias = try requireDeclaredAlias(targetAlias) otherwise return
		let isFloat = aliasIsFloat(alias)

		let known = self.floatConstIsKnown(value) if isFloat else self.constIsKnown(value)

		if not known 'notConstantInTheAliasDomain'
			return
		end 'notConstantInTheAliasDomain'

		let payload = self.floatConstBitsOf(value) if isFloat else self.constOf(value)
		let writtenNegative = valueIsMarked(self.bodyState.writtenNegativeLiterals, value: value) and not isFloat

		if literalInRange(payload, low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: writtenNegative, writtenAboveSignedMax: self.valueIsAboveSignedMax(value) and not isFloat) 'inRange'
			return
		end 'inRange'

		throw SourceParseError.constantCastOutOfRange(payload, aliasName: self.signatures.aliasIdentityDisplay(alias.name), low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: writtenNegative, domain: alias.domain, line: asTok.line, column: asTok.column)
	end 'requireConstantCastInRange'

	function nameValueAsDeclaredType(value ValueId, targetType MaxonType, targetAlias DeclaredAlias, opTok Token, sourceIsBareLocal bool, mustCarryTargetType bool) returns ValueId
		// ⭐ **A CAST THAT CHANGES WHAT THE VALUE'S TYPE SAYS IS A CONVERSION, NOT A RE-TAG.** It yields a
		// DISTINCT result value of the target type and leaves the SOURCE untouched, because the source
		// binding stays usable under its own identity: `let b = aTag as WB.Idx` must not corrupt `aTag`
		// (still `WA.Idx`), and `let w = x as Word` must not make `x` unsigned. SIX things a target can
		// say, and each has its own predicate rather than one blurred test — the NOMINAL NAME, a
		// per-instance IDENTITY, a SHIFT FILL, whether a DIVISION by the value can fail,
		// at what SIGNEDNESS a division of the value runs, and (`ranged-int-bit-packing`) how the
		// value would be STORED as an array element — because they are answered from different registries
		// and none implies the others.
		// Everything else is the representational no-op below, with no new value and no new op.
		//
		// ⭐ **`mustCarryTargetType` IS THE CALLER'S DEMAND, NOT A SIXTH QUESTION.** The five above are asked
		// of a value to decide whether an `as` MEANS anything; a caller passing `true` has already decided —
		// `admitArrayLiteralElement` reaches this only when the element's storage differs from the instance's
		// slot, and its result has to be TYPED as that element or the literal's own homogeneity check refuses
		// a value it just converted. It is a parameter rather than a predicate here because the fact lives at
		// the POSITION, and no reading of the value could recover it. ⛔ It is deliberately not folded into the
		// five: `applyCast` passes `false`, which is what keeps a plain `x as Byte` a no-op — see
		// `castChangesTheElementPacking`'s ⛔⛔ block for the two programs that broke when every cast retagged.
		if mustCarryTargetType or self.castRetags(value, targetType: targetType, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal) 'retaggingCast'
			if not mustCarryTargetType and self.castRenamesInPlace(value, targetType: targetType, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal) 'thisExpressionsOwnInteger'
				self.retypeValue(value, valueType: targetType)
				return self.finishCast(value, source: value, targetAlias: targetAlias, targetType: targetType, sourceIsBareLocal: sourceIsBareLocal)
			end 'thisExpressionsOwnInteger'

			return self.finishCast(self.emitRetaggedCastValue(value, targetType: targetType, range: SourceRange.ofToken(opTok)), source: value, targetAlias: targetAlias, targetType: targetType, sourceIsBareLocal: sourceIsBareLocal)
		end 'retaggingCast'

		// ⭐⭐ **RENAME, NOT MINT — the third answer, and the one a narrowing `as` needs.** A cast to an
		// alias that STORES the value differently has to be visible on the value, because
		// `arrayLiteralInstanceFor` types a bare `[…]` from its first element and nothing downstream can
		// recover what the author wrote. Minting says so and costs an op, a live range and an owned
		// temporary; `retypeValue` says the same thing by rewriting this value's two type columns in
		// place, emitting nothing. Nothing else changes: the bits are identical, and the value had no
		// other reader (below). An unnamed integer cast to a ranged alias is renamed on the same terms,
		// because every cast names its value.
		if self.mayRetypeForNarrowerStorage(value, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal) or (not sourceIsBareLocal and self.castNamesAnUnnamedInteger(value, targetType: targetType, targetAlias: targetAlias)) 'renameInPlace'
			self.retypeValue(value, valueType: targetType)
		end 'renameInPlace'

		return self.finishCast(value, source: value, targetAlias: targetAlias, targetType: targetType, sourceIsBareLocal: sourceIsBareLocal)
	end 'nameValueAsDeclaredType'

	function castRetags(value ValueId, targetType MaxonType, targetAlias DeclaredAlias, sourceIsBareLocal bool) returns bool
		return self.castChangesTheNominalIdentity(value, targetType: targetType) or self.castConvertsPerInstance(value, targetType: targetType) or self.castChangesTheShiftFill(value, targetAlias: targetAlias) or self.castChangesTheDivisionProof(value, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal) or self.castChangesTheDivisionSignedness(value, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal) or self.castChangesTheElementPacking(value, targetAlias: targetAlias) or self.castNamesItsValue(value, targetType: targetType, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal)
	end 'castRetags'

	function castNamesItsValue(value ValueId, targetType MaxonType, targetAlias DeclaredAlias, sourceIsBareLocal bool) returns bool
		if not sourceIsBareLocal or maxonTypeTag(targetType) != ValueTypeTag.named 'nothingToNameInPlace'
			return false
		end 'nothingToNameInPlace'

		if tagIsFloat(self.tagOf(value)) 'aFloatSource'
			return self.namedIsFloatAlias(typeNameIdOf(targetType)) and self.valueNameId(value) != typeNameIdOf(targetType)
		end 'aFloatSource'

		return self.castNamesAnUnnamedInteger(value, targetType: targetType, targetAlias: targetAlias)
	end 'castNamesItsValue'

	function castNamesAnUnnamedInteger(value ValueId, targetType MaxonType, targetAlias DeclaredAlias) returns bool
		return self.tagOf(value) == ValueTypeTag.integer and maxonTypeTag(targetType) == ValueTypeTag.named and not self.typeIsFloatDomain(targetType) and self.declaresARangedAlias(targetAlias, t: targetType)
	end 'castNamesAnUnnamedInteger'

	// Must answer as `applyCast` will: a cast that emits an op of its own takes over as the value's
	// producer, so its operand is complete and is released (`releaseCompletedOperand`); a cast that
	// emits nothing leaves the operand as the producer, so `try f() as Brand` still rewrites `f`.
	// Answering wrong either way refuses a legal `try` as not a call or leaves a throwing op plain for
	// E3057.
	function castEmitsAnOp(value ValueId, targetType MaxonType, sourceIsBareLocal bool) returns bool
		if self.castIsARebrand(value, targetType: targetType) or self.tagOf(value) == ValueTypeTag.function 'aRebrand'
			return sourceIsBareLocal
		end 'aRebrand'

		if tagIsFloat(self.tagOf(value)) != self.typeIsFloatDomain(targetType) 'aConversion'
			return true
		end 'aConversion'

		let targetAlias = self.declaredAliasOfType(targetType)
		return self.castRetags(value, targetType: targetType, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal) and not self.castRenamesInPlace(value, targetType: targetType, targetAlias: targetAlias, sourceIsBareLocal: sourceIsBareLocal)
	end 'castEmitsAnOp'

	// A cast of the expression's own integer temporary renames it in place, so `try ((8 / d) as Wide)`
	// still sees the division as the call `try` rewrites. A bare local mints because renaming it
	// renames the binding; a known constant mints so that `InsertRangeChecks` keeps its runtime guard.
	function castRenamesInPlace(value ValueId, targetType MaxonType, targetAlias DeclaredAlias, sourceIsBareLocal bool) returns bool
		if sourceIsBareLocal or self.constIsKnown(value) or not self.valueIsAnIntegerScalar(value) 'mustMint'
			return false
		end 'mustMint'

		if not (maxonTypeTag(targetType) == ValueTypeTag.integer or self.declaresARangedAlias(targetAlias, t: targetType)) 'targetIsNoRangedInteger'
			return false
		end 'targetIsNoRangedInteger'

		return not (self.castConvertsPerInstance(value, targetType: targetType) or self.castChangesTheElementPacking(value, targetAlias: targetAlias))
	end 'castRenamesInPlace'

	function valueIsAnIntegerScalar(value ValueId) returns bool
		return match self.declaredAliasOfValue(value) 'a'
			declared(alias) gives not aliasIsFloat(alias)
			undeclared gives self.tagOf(value) == ValueTypeTag.integer
		end 'a'
	end 'valueIsAnIntegerScalar'

	// ⭐⭐ **MAY THIS VALUE BE RENAMED TO THE TARGET IN PLACE?** Three conditions, each with its own reason,
	// and all three are necessary — each was measured by a program that broke without it.
	//
	//   • **THE STORAGE MUST ACTUALLY DIFFER.** Otherwise the rename says nothing and only costs a wrong
	//     answer later: `x as Integer` must leave a plain `int` a plain `int`.
	//   • **THE SOURCE MUST NOT BE A BARE LOCAL**, because with no mint the "result" IS the source `ValueId`
	//     — renaming it renames the BINDING. `let a = 42` then `let b = a as Byte` must not make `a` a `Byte`
	//     for its later readers. This is the identical condition, for the identical reason, that
	//     `finishCast` withholds its alias record on; a non-bare-local operand is this expression's own
	//     fresh result, which in the parser's on-the-fly SSA has exactly one consumer — the cast.
	//   • **THE SOURCE MUST BE A PLAIN INTEGER.** A managed or opaque type-parameter value is not a number
	//     in a slot; relabelling one as a narrow integer alias would tell the ownership layer it has nothing
	//     to release. `generic-type-substitution/error.a-name-the-scope-does-not-bind-binds-nothing` casts an
	//     opaque `U` to `ExitCode` and is exactly this case.
	//
	// ⚠ **IT IS NOT "IS THE SOURCE A CONSTANT", AND THAT DISTINCTION IS THE WHOLE DESIGN.** Gating on
	// constants restores the three-answers bug `castChangesTheElementPacking` records — `[7 as Byte, 3 as Byte]`
	// would type differently from `[v as Byte, w as Byte]` and refuse `[v as Byte, 3 as Byte]` outright.
	// Single-use and constant are different questions and only the first is sound; both literals and locals
	// reach the rename here, so all three spellings agree.
	function mayRetypeForNarrowerStorage(value ValueId, targetAlias DeclaredAlias, sourceIsBareLocal bool) returns bool
		if sourceIsBareLocal 'wouldRenameTheBinding'
			return false
		end 'wouldRenameTheBinding'

		if self.tagOf(value) != ValueTypeTag.integer 'notANumberInASlot'
			return false
		end 'notANumberInASlot'

		return self.storageDiffersFromAlias(value, targetAlias: targetAlias)
	end 'mayRetypeForNarrowerStorage'

	// ⭐ **THE CAST'S RESULT DENOTES THE TARGET ALIAS — recorded on the result, and read by E3010 and by
	// `arrayLiteralInstanceFor`** (the second reader arrived with `ranged-int-bit-packing`; see
	// `ValueDeclaredAliasMap` for what the withhold below costs it, which is NOT a missing diagnostic).
	// It emits no op and moves no bit: `ValueDeclaredAliasMap` exists precisely so that knowing
	// `let b = 42 as Byte` makes `b` a `Byte` costs no instruction, where minting a value to carry it would
	// have cost one at every ranged cast in the corpus.
	//
	// ⚠ **THREE OF THE FOUR ARMS MINT A FRESH VALUE**, which nothing else names, so the record is
	// unambiguous there. The fourth flows the SOURCE value on unchanged, and there the record is WITHHELD
	// when the operand was a bare local: `let a = 42` then `let b = a as Byte` leaves ONE value under two
	// names, and stamping it would make a later `a as Byte` — a narrowing the program genuinely needs —
	// report E3010 against a plain `int`. See `ValueDeclaredAliasMap` for the false negative that trades for.
	//
	// ⚠ Only a target spelled by NAME is recorded: a target handed over as a resolved type
	// (`processIsAlive`'s `alias.underlying`) carries no name id, and its 0 would name whatever this
	// file interned first.
	function finishCast(result ValueId, source ValueId, targetAlias DeclaredAlias, targetType MaxonType, sourceIsBareLocal bool) returns ValueId
		if result == source and sourceIsBareLocal 'sharedWithABinding'
			return result
		end 'sharedWithABinding'

		self.shedOperandAliasSet(result)
		self.carryProvenIntRange(result, source: source)

		if maxonTypeTag(targetType) == ValueTypeTag.named and self.declaresARangedAlias(targetAlias, t: targetType) 'theTargetNamesARangedAlias'
			self.recordValueDeclaredAliasId(result, aliasId: typeNameIdOf(targetType))
			self.wearDeclaredFloatAlias(result, declared: targetType, scopeFilePath: self.job.path)
		end 'theTargetNamesARangedAlias'

		return result
	end 'finishCast'

	function carryProvenIntRange(result ValueId, source ValueId)
		if result == source or tagIsFloat(self.tagOf(source)) or tagIsFloat(self.tagOf(result)) 'noIntegerToCarry'
			return
		end 'noIntegerToCarry'

		let proven = try provenIntRangeOf(self.bodyState.countedValueRanges, value: source) otherwise return
		self.recordProvenIntRange(result, low: proven.low, high: proven.high)
	end 'carryProvenIntRange'

	// ⭐⭐ **E3010 — "unneeded cast: 'A' already fits in 'B'".** This form fires only when BOTH ends are
	// DECLARED ranged typealiases, and that gate is the whole discriminator rather than a convenience:
	// `let x = 42` then `x as Float` is LEGAL — the source is a bare `int`, which names no alias and
	// so states nothing the cast could be repeating — while `let i = identity(42)`, whose callee
	// DECLARES `returns Integer`, then `i as JsonFloat` is E3010. The two programs differ in nothing
	// else.
	function reportUnneededCast(source DeclaredAlias, target DeclaredAlias, asTok Token)
		match source 's'
			undeclared then break
			declared(sourceAlias) then self.reportUnneededCastFrom(sourceAlias, target: target, asTok: asTok)
		end 's'
	end 'reportUnneededCast'

	// The second unwrap. A `match` arm carries one expression and there are two unions to open, so the pair
	// reads as the two sentences it is rather than as a nested match.
	function reportUnneededCastFrom(source RangedTypeAlias, target DeclaredAlias, asTok Token)
		match target 't'
			undeclared then break
			declared(targetAlias) then self.reportUnneededCastBetween(source, target: targetAlias, asTok: asTok)
		end 't'
	end 'reportUnneededCastFrom'

	function unneededCastSourceAlias(value ValueId, target DeclaredAlias) returns DeclaredAlias
		let proven = self.valueDenotedAlias(value)

		match proven 'denoted'
			declared then return proven
			undeclared then break
		end 'denoted'

		let claimed = self.domainDeclaringAlias(value)

		match claimed 'declaredType'
			declared(alias) then return claimed if self.fullRangeCheckCannotFail(value, alias: alias, target: target) else DeclaredAlias.undeclared
			undeclared then return DeclaredAlias.undeclared
		end 'declaredType'
	end 'unneededCastSourceAlias'

	function fullRangeCheckCannotFail(value ValueId, alias RangedTypeAlias, target DeclaredAlias) returns bool
		return match target 'targetType'
			undeclared gives false
			declared(targetAlias) gives alias.isTheSameDeclarationAs(targetAlias) and (aliasAdmitsEveryValue(alias) or (aliasIsUnsignedFullQuantity(alias) and valueIsMarked(self.bodyState.unsignedPatternValues, value: value)))
		end 'targetType'
	end 'fullRangeCheckCannotFail'

	function ownTypeNamedByCast(value ValueId, targetType MaxonType) returns immutable ByteArray throws AbsentError
		let valueTag = self.tagOf(value)
		let targetTag = maxonTypeTag(targetType)

		if valueTag == ValueTypeTag.boolean and targetTag == ValueTypeTag.boolean 'aBool'
			return b"bool"
		end 'aBool'

		if valueTag == ValueTypeTag.string and targetTag == ValueTypeTag.string 'aString'
			return b"String"
		end 'aString'

		if valueTag == ValueTypeTag.character and targetTag == ValueTypeTag.character 'aCharacter'
			return b"Character"
		end 'aCharacter'

		if not tagMayNameADeclaredType(valueTag) or not tagMayNameADeclaredType(targetTag) 'notDeclaredTypes'
			throw AbsentError.absent
		end 'notDeclaredTypes'

		match self.declaredAliasOfValue(value) 'alias'
			declared then throw AbsentError.absent
			undeclared then break
		end 'alias'

		let valueName = self.internedName(self.valueNameId(value))

		if not valueName.equals(self.internedName(typeNameIdOf(targetType))) 'aDifferentType'
			throw AbsentError.absent
		end 'aDifferentType'

		return valueName
	end 'ownTypeNamedByCast'

	// Is `xs as Ys` a cast between two brands of ONE generic instance, or between two instances whose elements
	// are same-named declarations of one layout? Then nothing converts. Compared on the CANONICAL name, which is what `aggregateNameIn` compares: `Box with N0` and `Box with (Box with S0)`
	// are one instance under two gids, as `both-spellings-agree-at-the-comparison` pins.
	function castIsARebrand(value ValueId, targetType MaxonType) returns bool
		if maxonTypeTag(targetType) != ValueTypeTag.genericInstance or self.tagOf(value) != ValueTypeTag.genericInstance 'notTwoInstances'
			return false
		end 'notTwoInstances'

		return self.signatures.canonicalInstanceName(self.valueInstanceId(value)).equals(self.signatures.canonicalInstanceName(genericInstanceIdOf(targetType))) or self.signatures.instancesDifferOnlyByElementDeclaration(self.valueInstanceId(value), target: genericInstanceIdOf(targetType), readerFilePath: self.job.path)
	end 'castIsARebrand'

	// A `typealias` IS ITS OWN TYPE AND `as` IS THE ONE DOOR BETWEEN TWO OF THEM. Two function aliases govern
	// one shape and one code pointer; two brands of a generic instance govern one record. Nothing converts;
	// what changes is the NAME every later door reads off the value — a function value's type name, an
	// instance's brand — and a cast that left it saying `Handler` would be refused by the very check it
	// answers.
	//
	// A BARE LOCAL GETS A FRESH ID, because renaming the binding's own value in place would make `h` a
	// `Callback` for its later readers too. The fresh id is a BORROW of the same record.
	//
	// ⚠ **A FUNCTION VALUE KEEPS ITS OWN TYPE AND WEARS THE TARGET AS ITS BRAND.** Its own type is its SHAPE,
	// which every later call (arity, argument types) and the recorded cast door (E3009, whole-program) read;
	// retyped to the target, a mismatched cast would surface as an arity error at the next call instead of as
	// the cast refusal it is. The brand is what the doors compare by name (`functionValueGoverningId`).
	function rebrandValue(value ValueId, targetType MaxonType, brand ByteArray, sourceIsBareLocal bool, opTok Token) returns ValueId
		let isFunction = self.tagOf(value) == ValueTypeTag.function
		let rebrandedType = self.typeOf(value) if isFunction else targetType
		let rebrandedBrand = self.internedName(typeNameIdOf(targetType)) if isFunction else brand

		if not sourceIsBareLocal 'thisExpressionsOwnResult'
			self.retypeValue(value, valueType: rebrandedType)
			self.brandValue(value, brand: rebrandedBrand)
			return value
		end 'thisExpressionsOwnResult'

		let rebranded = self.emitRetaggedCastValue(value, targetType: rebrandedType, range: SourceRange.ofToken(opTok))
		self.carryImmortalFunctionMark(rebranded, source: value)
		self.brandValue(rebranded, brand: rebrandedBrand)
		return rebranded
	end 'rebrandValue'

	// The name a FUNCTION value answers to at a door: the alias it was cast to when it was, else its own type.
	function functionValueGoverningId(value ValueId) returns TypeNameId
		let brandId = self.brandIdOf(value)
		return brandId if brandId != UnnamedTypeId and self.tagOf(value) == ValueTypeTag.function else self.valueNameId(value)
	end 'functionValueGoverningId'

	// The two function-value marks travel to a rebranded id. They key on the ID, so a fresh one that did not
	// carry them would call the closure with no environment. Copied SEPARATELY because their producers differ:
	// a capturing literal sets both, a function-typed parameter sets only the env.
	function carryImmortalFunctionMark(rebranded ValueId, source ValueId)
		if self.valueIsImmortalFunction(source) 'anImmortalRecord'
			self.markImmortalFunction(rebranded)
		end 'anImmortalRecord'
	end 'carryImmortalFunctionMark'

	// The verdict and the words. Every `typealias` declaration is its own type, so the ONLY cast that says
	// nothing is one naming the value's OWN declaration: a cast between two declarations is the single door
	// between two types and carries the program's meaning whichever way the two ranges lie. The message
	// names the ALIASES the program wrote — not the erased primitives `typeTagName` prints for E3009.
	//
	// ⚠ **BOTH NAMES SPELL THROUGH `sourceSpelledAliasText`, for the reason `literalOutOfRangeMessage`
	// states.** A RANGE-CONTESTED name reaches here wearing the compiler's mint (`Byte$0_200`), which names
	// no line the author wrote, and "the alias is quoted as SOURCE spells it" is a property of the
	// DIAGNOSTIC vocabulary, not of one diagnostic — two E-codes naming one alias two ways is the same fact
	// written twice.
	function reportUnneededCastBetween(source RangedTypeAlias, target RangedTypeAlias, asTok Token)
		if not source.isTheSameDeclarationAs(target) 'aDoorBetweenTwoTypes'
			return
		end 'aDoorBetweenTwoTypes'

		self.recordArtifactDiagnostic(ErrorCode.semanticUnneededCast, message: unneededAliasCastMessage(source.name, targetName: target.name), range: SourceRange.ofToken(asTok))
	end 'reportUnneededCastBetween'

	// ⭐ **THE CAST TARGET'S KIND AS THE AUTHORITY DENOTES IT — not as `maxonTypeTag` reads the
	// SPELLING.** `parseTypeReference` answers a handful of type spellings syntactically (`Self`, the
	// enclosing type's own name, `String`, a type parameter, a generic-instance alias, a function
	// alias) and hands back a bare `MaxonType.named` for everything else — a declared `type` named
	// from OUTSIDE its own body, a declared enum/union, a ranged typealias, a qualified inner alias,
	// and a name nothing declares at all. `maxonTypeTag` reads all five as one tag, so the legality
	// gate asks about a NAME, and its answer for a name that denotes nothing would be the same as
	// for a ranged int alias: convert nothing, flow the value on. `5 as CompletelyMadeUpNameXyz`
	// would compile and return 5; so would `5 as Point`, which `applyCast`'s own header claims to reject.
	//
	// `denotedNamedType` is THE list of the sources a named type can come from — the same list whose
	// `unknown` verdict is `TypeResolution`'s E3011 — so a cast site and the resolution pass cannot
	// come to disagree about what a name means. There is deliberately no second cascade here.
	//
	// ⚠ **THE RESOLVED TYPE IS FOR THIS GATE ONLY and is NOT substituted for `targetType`.** The
	// conversion below still reads the `named` type, because that is what carries the alias NAME a
	// narrowing check records (`recordRangeCheckSite`) and the nominal identity a per-instance cast stamps
	// (`castConvertsPerInstance`). Erasing it here would silently drop both — the erasure is the
	// SIGNATURE's, not the cast's.
	function castTargetTag(targetType MaxonType, asTok Token) returns ValueTypeTag throws SourceParseError
		let spelledTag = maxonTypeTag(targetType)

		if spelledTag != ValueTypeTag.named 'alreadyConcrete'
			return spelledTag
		end 'alreadyConcrete'

		let nameId = typeNameIdOf(targetType)

		if let answered = try self.memos.castTargetTags.get(nameId) 'alreadyAsked'
			return answered
		end 'alreadyAsked'

		let tag = try self.denotedCastTargetTag(self.internedName(nameId), id: nameId, asTok: asTok)
		self.memos.castTargetTags.file(nameId, value: tag)

		return tag
	end 'castTargetTag'

	// The KIND a NAMED cast target denotes, or E3011 anchored on the `as` — the half of the cast-target
	// decision that ASKS THE AUTHORITY.
	//
	// ⭐ **AND IT FLOAT-RESOLVES WHAT IT ANSWERS.** A ranged FLOAT alias denotes a `float`, and the `named`
	// tag cannot say so — `tagIsIntegral` reads every `named` as an int (its own header says why it cannot
	// do otherwise). That is `castHasNoLegalConversion`'s stated precondition, and it decides two things at
	// once: `f as Float` stays the identity conversion instead of being refused as the lossy `float → int`,
	// and `true as Float` says "Cannot cast from bool to **float**" instead of naming the alias's erased
	// `int`. Resolved HERE, at the one door every cast asks, so none can skip it.
	function denotedCastTargetTag(name ByteArray, id TypeNameId, asTok Token) returns ValueTypeTag throws SourceParseError
		let denoted = try denotedNamedType(self.signatures, name: name, id: id, readerFilePath: self.job.path) otherwise 'undeclared'
			throw SourceParseError.unknownTypeName(self.signatures.aliasIdentityDisplay(name), line: asTok.line, column: asTok.column)
		end 'undeclared'

		return self.floatResolvedTagOfNameFrom(maxonTypeTag(denoted), name: name, scopeFilePath: self.job.path)
	end 'denotedCastTargetTag'

	// ⛔⛔ **A CAST WHOSE SOURCE IS AN ENUM/UNION IS E3009, WHATEVER THE TARGET** — the oracle's rule,
	// word for word (`Cannot cast from enum to float` / `… to int`, MEASURED on both backings).
	//
	// It cannot be `castHasNoLegalConversion`'s job, because that rule reads only the TAG and an enum wears
	// the same `named` tag a ranged alias does — which is exactly why every enum cast fell through to the
	// representational no-op at the end of `applyCast` and handed back the raw i64 wearing the target's
	// type. For a FLOAT-backed enum that was a silent wrong answer: `Weight.light as Real` printed
	// `4612811918334231000.0`, the bit pattern of 2.5 widened as if it were a magnitude.
	//
	// ⚠ **BOTH BACKINGS, ONE RULE.** An int-backed enum's no-op returned the right NUMBER, so refusing it
	// looks like a loss — but what that spelling provided was `.rawValue` under another name, an accessor
	// this compiler does not have and the oracle does not reach this way either. Two rules ("a float-backed
	// enum may not be cast, an int-backed one may") would be one fact written twice, and the day
	// `.rawValue` lands the wrong half would still be here.
	function requireCastSourceIsNotEnum(value ValueId, targetTag ValueTypeTag, asTok Token) throws SourceParseError
		// `valueIsUnion`'s measured allocation guard: `enumMatchFor` boxes a `DeclaredEnum` even to answer
		// `undeclared`, and only a `named` value can be an enum at all.
		if self.tagOf(value) != ValueTypeTag.named 'notNamed'
			return
		end 'notNamed'

		let decl = self.enumMatchFor(value)

		if not enumMatchIsDeclared(decl) 'notAnEnum'
			return
		end 'notAnEnum'

		throw SourceParseError.invalidCast(requireEnumLayout(decl).kindWord(), targetType: typeTagName(targetTag), line: asTok.line, column: asTok.column)
	end 'requireCastSourceIsNotEnum'

	// ⛔⛔ **A CONTAINER IS NOT A RETAGGING, AND THIS SPELLING USED TO BE ACCEPTED AND THEN IGNORED.**
	// `col as RegNumColumn` parsed, produced a value still wearing its ORIGINAL type, and failed later at
	// whatever use site first noticed — naming neither the cast nor its target. Every other cast here is a
	// retagging or a scalar conversion of ONE value; a container is neither.
	//
	// ⚠ **AND IT COULD NOT BE MADE A RETAGGING, WHICH IS WHY THIS IS A REFUSAL RATHER THAN A GAP.**
	// `Array with int(0 to u64.max)` strides EIGHT bytes per element and `Array with int(0 to 63)` strides
	// ONE (`rangedAliasStorageBytes`), so a retag hands every later read a stride the buffer was not written
	// at — the silent wrong answer `specs/bytearray-element-size.md` measures at length. Converting
	// would mean a second buffer and a range check per element: a real operation, and not one an `as`
	// should perform in silence.
	//
	// ⚠ It reads the TARGET's tag as `castTargetTag` resolved it, so `as SomeAlias` is judged by what the
	// alias denotes rather than by its spelling, and names the two types as the SOURCE writes them —
	// `invalidCast`'s tag words would say `Cannot cast from int to int` here.
	function requireCastTargetIsNotAContainer(value ValueId, targetType MaxonType, targetTag ValueTypeTag, asTok Token) throws SourceParseError
		if targetTag != ValueTypeTag.genericInstance 'theTargetIsNotAContainer'
			return
		end 'theTargetIsNotAContainer'

		let written = String.from(self.internedName(typeNameIdOf(targetType))) if maxonTypeTag(targetType) == ValueTypeTag.named else self.displayTypeNameOf(maxonTypeTag(targetType), nameId: typeNameIdOf(targetType))
		throw SourceParseError.castTargetIsAContainer(self.valueDisplayTypeName(value), targetType: written, line: asTok.line, column: asTok.column)
	end 'requireCastTargetIsNotAContainer'

	function requireCastTargetIsNotAnEnumOrUnion(value ValueId, targetType MaxonType, asTok Token) throws SourceParseError
		if maxonTypeTag(targetType) != ValueTypeTag.named 'notANominalName'
			return
		end 'notANominalName'

		try self.requireCastTargetNameIsNotAnEnumOrUnion(value, name: self.internedName(typeNameIdOf(targetType)), asTok: asTok)
	end 'requireCastTargetIsNotAnEnumOrUnion'

	function requireCastTargetNameIsNotAnEnumOrUnion(value ValueId, name ByteArray, asTok Token) throws SourceParseError
		let decl = self.signatures.enumFor(name, readerFilePath: self.job.path)

		if not enumMatchIsDeclared(decl) 'notAnEnumOrUnion'
			return
		end 'notAnEnumOrUnion'

		let layout = requireEnumLayout(decl)
		let written = self.signatures.aliasIdentityDisplay(name)

		let remedy = "a union value is built by its case constructor" if layout.isUnion else "an integer is not a case; use '{written}.fromRawValue(raw)', which throws '{String.from(EnumLookupNoSuchRawValueCaseName)}' for a value no case carries"

		throw SourceParseError.castFormsAValue(self.valueKindWord(value), targetType: "{layout.kindWord()} '{written}'", remedy: remedy, line: asTok.line, column: asTok.column)
	end 'requireCastTargetNameIsNotAnEnumOrUnion'

	function requireCastIsNotBetweenInterfaces(value ValueId, targetType MaxonType, asTok Token) throws SourceParseError
		if self.tagOf(value) != ValueTypeTag.interfaceRef or maxonTypeTag(targetType) != ValueTypeTag.interfaceRef 'notTwoInterfaces'
			return
		end 'notTwoInterfaces'

		let source = self.valueTypeName(value)
		let target = self.internedName(typeNameIdOf(targetType))

		if source.equals(target) 'theSameInterface'
			return
		end 'theSameInterface'

		throw SourceParseError.castFormsAValue("interface '{self.signatures.aliasIdentityDisplay(source)}'", targetType: "interface '{self.signatures.aliasIdentityDisplay(target)}'", remedy: "an interface value converts to no other interface", line: asTok.line, column: asTok.column)
	end 'requireCastIsNotBetweenInterfaces'

	function requireCastKindsConvert(value ValueId, targetTag ValueTypeTag, asTok Token) throws SourceParseError
		if castHasNoLegalConversion(self.tagOf(value), target: targetTag) 'incompatibleKinds'
			throw SourceParseError.invalidCast(self.valueKindWord(value), targetType: typeTagName(targetTag), line: asTok.line, column: asTok.column)
		end 'incompatibleKinds'
	end 'requireCastKindsConvert'

	// ⭐⭐ **DOES THE CAST CHANGE WHAT THE VALUE'S TYPE IS CALLED?** A `typealias` names its own type and `as`
	// is the one door between two of them, so a cast that left the value's own type column saying `Narrow`
	// would have `takesWide(n as Wide)` refused by the very diagnostic the cast was written to answer.
	//
	// ⚠ **`identitiesConflict` AND NOT BARE INEQUALITY.** Naming an UNNAMED source is
	// `castNamesItsValue`'s question: it mints for a bare local, and `convertValueToDeclaredType`
	// renames an expression's own integer in place.
	function castChangesTheNominalIdentity(value ValueId, targetType MaxonType) returns bool
		return self.signatures.identitiesConflict(aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: maxonTypeTag(targetType), nameId: typeNameIdOf(targetType), readerFilePath: self.job.path), got: aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: self.tagOf(value), nameId: self.valueNameId(value), readerFilePath: self.job.path), readerFilePath: self.job.path) or self.castNamesAnImplementedAlias(value, targetType: targetType)
	end 'castChangesTheNominalIdentity'

	function castNamesAnImplementedAlias(value ValueId, targetType MaxonType) returns bool
		if self.tagOf(value) != ValueTypeTag.named or maxonTypeTag(targetType) != ValueTypeTag.named or self.valueNameId(value) == typeNameIdOf(targetType) 'nothingToRename'
			return false
		end 'nothingToRename'

		return self.valueIsAnIntegerScalar(value) and self.declaresARangedAlias(self.declaredAliasOfType(targetType), t: targetType) and not self.typeIsFloatDomain(targetType)
	end 'castNamesAnImplementedAlias'

	// Does this int→int `as` convert per-instance identity — either STAMPING a per-instance target
	// onto the result (`x as StrWrapper.Idx`) or STRIPPING a per-instance source into a plain target
	// (`idx as ExitCode`)? Only then does the cast mint a distinct value; a plain-to-plain `as` stays a no-op.
	function castConvertsPerInstance(value ValueId, targetType MaxonType) returns bool
		if maxonTypeTag(targetType) == ValueTypeTag.named and self.signatures.isPerInstanceAlias(self.internedName(typeNameIdOf(targetType)), readerFilePath: self.job.path) 'stampTarget'
			return true
		end 'stampTarget'

		return self.tagOf(value) == ValueTypeTag.named and self.signatures.isPerInstanceAlias(self.valueTypeName(value), readerFilePath: self.job.path)
	end 'castConvertsPerInstance'

	// ⭐ **DOES THIS int→int `as` CHANGE HOW A RIGHT SHIFT OF THE VALUE FILLS?** The shift rule reads
	// the value's TAG (`valueIsUnsigned`), so a cast that drops the target alias drops the SIGNEDNESS
	// with it: `let w = x as Word` (`Word = int(0 to u64.max)`) then `w shr 62` of
	// `0xC000000000000000` must answer **3** and not -1, and the other direction — an unsigned
	// parameter cast to a signed alias — must answer **-1** and not 3. A silent wrong answer, in the
	// one place no diagnostic can catch it.
	//
	// ⭐ **THE FILL IS THE ONLY ANSWER THAT CAN MOVE INSIDE THIS GATE, AND THAT IS WHY THE GATE IS A
	// DECLARED RANGED ALIAS AND NOTHING ELSE.** A value's tag also picks its DROP routing
	// (`decrefCalleeFor`), its builtin-conformance dispatch (`builtinConformerOfType`) and its float
	// register class — so a broader "always re-tag" would be a different change with a different blast
	// radius. Inside the gate all three are provably fixed: a ranged INT alias is unmanaged (its name is
	// an alias, never an enum/union — `resolveNamedAlias`'s header states a name is one of those, never
	// two — so `valueIsBoxedUnion` cannot start answering `true`), it reduces to `integer` for the
	// conformer exactly as a bare `int` does, and it is not float (a float alias is refused below, since
	// its bounds are f64 BIT PATTERNS that the integer range predicates would read as signed integers).
	// A target OUTSIDE the gate is left alone for the same reason it always was — a `structRef` target
	// would re-point a drop at another type's destructor, and `ExitCode` would trade a fill that cannot
	// differ (see the observability rule below) for a conformer it does not have (`notAConformer`).
	//
	// ⭐ **AND IT ASKS WHETHER THE FILL CAN BE OBSERVED, NOT MERELY WHETHER THE SIGNEDNESS DIFFERS.** An
	// arithmetic and a logical shift differ only on an operand whose bit 63 is set, so a target whose
	// range cannot hold such a value answers the same under either reading — `bitwise-operators.md` says
	// exactly this ("a value of `int(0 to 100)` is provably non-negative, so an arithmetic and a logical
	// shift of it agree bit for bit"), and the cast is guarded INTO that range by the site
	// `recordRangeCheckSite` records, so the premise is enforced rather than hoped for. That is what keeps
	// `x as Byte`, `x as Age` and `x as U32` the byte-for-byte no-ops they have always been while
	// `x as Word` is not.
	//
	// It is handed the ALREADY-RESOLVED alias (`declaredAliasOfType`) rather than the target type: the
	// narrowing-check site needs the identical resolution, and `applyCast` is where the two meet.
	function castChangesTheShiftFill(value ValueId, targetAlias DeclaredAlias) returns bool
		return match targetAlias 'a'
			declared(alias) gives self.aliasChangesTheShiftFill(value, alias: alias)

			// Not a declared ranged alias — a bare primitive, a struct, a name nothing declares. Nothing the
			// tag column would read differently, so the cast stays the no-op. (⚠ `ExitCode` is not on this
			// list: it arrives as a DECLARED alias and is answered above — unsigned, and topped below
			// `i64.max`, so `aliasChangesTheShiftFill` still says no.)
			undeclared gives false
		end 'a'
	end 'castChangesTheShiftFill'

	// The half of the question above that is about the ALIAS. Split out because the two arms below read
	// as the two sentences they are.
	function aliasChangesTheShiftFill(value ValueId, alias RangedTypeAlias) returns bool
		if aliasIsFloat(alias) 'floatAlias'
			return false
		end 'floatAlias'

		if not rangeIsUnsigned(alias.low) 'targetIsSigned'
			// A signed range admits negatives, so bit 63 is reachable and the two fills genuinely differ.
			// The cast is load-bearing exactly when the source reads UNSIGNED and the target does not.
			return self.valueIsUnsigned(value)
		end 'targetIsSigned'

		// The target is unsigned. A signed source can only be told apart from it by a bit-63-set value,
		// which an unsigned range admits ONLY with an upper bound above `i64.max` — the same shape the
		// runtime cascade and the compile-time literal check both key on, asked here through the same
		// predicate so a fourth reading of it cannot appear.
		return not self.valueIsUnsigned(value) and rangeIsUnsignedTopped(alias.low, high: alias.high)
	end 'aliasChangesTheShiftFill'

	// ⭐⭐ **DOES THIS int→int `as` CHANGE WHETHER A DIVISION BY THE VALUE CAN FAIL?** — the third thing a
	// cast target can say, and the one that makes `let d = z as NonZero` the language's escape hatch from a
	// checked divide rather than a no-op the divide cannot see.
	//
	// Only a bare-local source mints. `divisorProof` reads the alias through `valueDenotedAlias`,
	// which takes the record `finishCast` writes, and `finishCast` withholds that record when the
	// result is the bare local itself. Without a mint, `100 / d` after `let d = z as NonZero` would
	// demand a `try`, as in `specs/ranged-typealias.md`'s `cast-guard-fires-before-the-division`.
	// Every other source carries the alias in the record and needs no new value.
	//
	// ⚠ **THE SAFETY ARGUMENT IS `aliasChangesTheShiftFill`'s, VERBATIM, FOR AN INT TARGET** — a DECLARED
	// RANGED INT alias and nothing else. Inside that gate a value's other tag-dispatched answers are provably
	// fixed: the alias is unmanaged (so `decrefCalleeFor` cannot start routing a drop), and it reduces to
	// `integer` for `builtinConformerOfType` exactly as a bare `int` does.
	//
	// ⭐⭐ **A RANGED FLOAT TARGET IS IN, AND IT MINTS A `float`-TAGGED VALUE RATHER THAN A `named` ONE.** The
	// two shift-fill siblings refuse a float because their question is about a fill an f64 has not got; this
	// question is `safety.md`'s escape hatch, which `specs/arithmetic-operators.md` states "for both integer
	// and float division". A float alias cannot ride the TAG — a `named`-tagged double would be given
	// `StdType.i64` and land in a GPR — so `emitRetaggedFloatCastValue` types the mint `float` and the alias
	// travels in `ValueDeclaredAliasMap`, which is the column that exists for exactly that.
	//
	// ⚠ **AND IT ASKS WHETHER THE PROOF CAN MOVE, NOT MERELY WHETHER THE TARGET EXCLUDES ZERO.** A source
	// already provably non-zero (a non-zero literal) gains nothing from the retag, and a target that ADMITS
	// zero can only ever weaken the answer — so neither mints. That is what keeps `x as Byte`, `x as Percent`
	// and `x as AsciiCode` the byte-for-byte no-ops they have always been while `z as NonZero` is not.
	function castChangesTheDivisionProof(value ValueId, targetAlias DeclaredAlias, sourceIsBareLocal bool) returns bool
		if not sourceIsBareLocal 'theRecordCanCarryIt'
			return false
		end 'theRecordCanCarryIt'

		return match targetAlias 'a'
			declared(alias) gives self.aliasChangesTheDivisionProof(value, alias: alias)
			undeclared gives false
		end 'a'
	end 'castChangesTheDivisionProof'

	// ⭐⭐ **DOES THIS int→int `as` CHANGE THE SIGNEDNESS A DIVISION OF THE VALUE RUNS AT, IN THE ONE
	// SPELLING NO RECORD CAN CARRY?** — the FOURTH of `applyCast`'s five questions, and the
	// one whose READER (`integerValueDomain`) has no writer but this.
	//
	// ⚠⚠ **MEASURED AGAINST THE BOOTSTRAP ORACLE, AND IT WAS A SILENT WRONG ANSWER.** With
	// `Word = int(0 to u64.max)` holding `u64.max` and a divisor cast to a non-negative alias that
	// ADMITS ZERO (`int(0 to 255)`, or the builtin `ExitCode`), `try (w / d)` answered **0 here and
	// 6148914691236517205 there** — the signed reading of `-1 / 8` against the unsigned reading the
	// oracle picks from the same two declared ranges.
	//
	// ⭐ **THE OTHER THREE SPELLINGS NEED NO MINT, AND THAT IS WHY THIS ONE IS NARROW.** A cast of a call
	// result, of a literal or of another cast's temporary is recorded in `ValueDeclaredAliasMap`, and
	// `integerValueDomain` reads it through `domainDeclaringAlias` — no new value, no new op, no
	// codegen movement anywhere the answer does not actually change. `finishCast` WITHHOLDS that record
	// for exactly one shape: an operand that was a BARE LOCAL REFERENCE, where the result IS the source
	// and stamping it would make `a` claim the alias `b` was given. A fresh value is the only identity
	// that shape can be given, so it is the only shape that mints.
	//
	// ⭐ **AND IT COSTS AN EXTRA OP ONLY WHERE A RANGE GUARD IS ALREADY BEING EMITTED.** It fires only
	// when the source's domain is `signed` — the source declares no non-negative range — against an
	// unsigned target, which is exactly the containment `rangeCoversRange` cannot prove, so the range-check
	// elision never applies and the cast emits a runtime guard (or an E3005) regardless. `n as Byte`
	// off an already-non-negative alias, and `3 as Byte`, stay the byte-for-byte no-ops they were.
	function castChangesTheDivisionSignedness(value ValueId, targetAlias DeclaredAlias, sourceIsBareLocal bool) returns bool
		if not sourceIsBareLocal 'theRecordCanCarryIt'
			return false
		end 'theRecordCanCarryIt'

		return match targetAlias 'a'
			declared(alias) gives self.aliasChangesTheDivisionSignedness(value, alias: alias)
			undeclared gives false
		end 'a'
	end 'castChangesTheDivisionSignedness'

	// The half of the question above that is about the ALIAS, split out exactly as its two siblings are.
	//
	// ⚠ The float arm is `aliasChangesTheDivisionProof`'s, for its reason: a ranged FLOAT alias's bounds
	// are f64 BIT PATTERNS, which `rangeIsUnsigned` would read as a signed integer — and a `named`-tagged
	// float would be given `StdType.i64` and land in a GPR.
	function aliasChangesTheDivisionSignedness(value ValueId, alias RangedTypeAlias) returns bool
		if aliasIsFloat(alias) 'floatAlias'
			return false
		end 'floatAlias'

		if not rangeIsUnsigned(alias.low) 'targetAdmitsNegatives'
			return false
		end 'targetAdmitsNegatives'

		return self.integerValueDomain(value) == IntegerValueDomain.signed
	end 'aliasChangesTheDivisionSignedness'

	// ⭐⭐ **DOES THIS `as` MOVE THE VALUE BETWEEN THE BYTE AND SUB-BYTE STORAGE LADDERS?** The FIFTH of
	// `applyCast`'s five questions — the count is stated in `applyCast` alone so the two cannot drift apart.
	// An `Array with T` literal types its element off the values it is given, so a cast that moves an
	// element between the two ladders has to be visible ON THE VALUE.
	//
	// ⛔⛔ **IT WAS WIDENED TO COMPARE THE WHOLE ELEMENT STRIDE AND THAT WAS WITHDRAWN — MEASURED, TWICE, AND
	// DO NOT RETRY IT WITHOUT READING THIS.** The widening looked obviously right: this predicate's headline
	// asks how a value is STORED, a stride is `elementStrideOf(packedBits, storageBytes)`, and comparing only
	// the packed half is half of its own sentence. It made `[10 as Byte, …]` mint an `Array with Byte`, which
	// `specs/codegen-internals.md`'s `rdata-byte-array-uses-i8` pins and the runnable oracle agrees with.
	//
	// **It broke two programs, because `emitRetaggedCastValue` EMITS AN OP** (`binOp add 0`) — so firing on
	// every narrowing ranged cast in the language creates a SECOND VALUE at each one:
	//   • `ranged-typealias/many-live-guarded-casts` — 24 `let w = widen(i)` then 24 `let s = w as Small`.
	//     Source and retag are both live across the same point, so the function needed **10 more registers
	//     than exist** and would not compile at all (E5001).
	//   • `generic-type-substitution/error.a-name-the-scope-does-not-bind-binds-nothing` — its
	//     `(try w.first() otherwise panic(…)) as ExitCode` casts an OPAQUE type-parameter value. Splitting it
	//     in two left the opaque source an owned temporary `main` must release, which `main` reserves no
	//     layout descriptor for: a spurious E2015 during the PARSE, which preempted the E3005 that case
	//     exists to pin. **A refusal appeared to fail open when what actually happened is that an earlier
	//     tier rejected the program first, for a reason invented by this predicate.**
	//
	// ⇒ **THE BYTE-WIDTH HALF IS SERVED BY A RENAME INSTEAD, AND THAT IS WHERE IT BELONGS** —
	// `mayRetypeForNarrowerStorage` + `retypeValue`, which rewrites the value's two type columns in place and
	// emits nothing. Both broken programs stay fixed because neither reaches it: the 24-cast function casts
	// BARE LOCALS (renaming one would rename the binding, so it is refused), and the opaque-`U` cast is not a
	// plain integer (relabelling it would tell the ownership layer it has nothing to release). ⇒ **the answer
	// was never "which casts should mint" but "minting is the wrong instrument for a representational
	// no-op".** This predicate stays narrow: it fires only where the two PACKING ladders differ, which is a
	// question about the value's own type and genuinely does need a distinct value.
	//
	// ⚠ And the obvious narrowing does not work: gating on a CONSTANT source restores the exact three-answers
	// inconsistency the paragraph below records — it would make `[7 as Byte, 3 as Byte]` an `Array with Byte`,
	// `[v as Byte, w as Byte]` an `Array with int`, and `[v as Byte, 3 as Byte]` a false refusal of a
	// legal program. Single-use and constant are different questions; only the first is
	// sound, and it is the one the rename asks.
	//
	// ⚠⚠ **WITHOUT IT THE SAME WRITTEN TYPE PRODUCED THREE DIFFERENT ANSWERS — MEASURED, and one of them
	// REFUSED A LEGAL PROGRAM.** The alternative was to read the alias out of `ValueDeclaredAliasMap`, and
	// that map cannot answer this: `finishCast` deliberately WITHHOLDS the entry when the result IS the
	// source and the source is a bare local (one value under two names — see that map's header). So the
	// alias survived a cast of a LITERAL and vanished on a cast of a LOCAL, for `N = int(0 to 15)`:
	//   • `[7 as N, 3 as N]`  →  `Array with N`,   element_size **-4**
	//   • `[v as N, w as N]`  →  `Array with int`, element_size **8**
	//   • `[v as N, 3 as N]`  →  refused as an element of another type — on a literal whose two elements
	//     are written with the SAME type, so the refusal is of a legal program.
	// Minting settles all three at once, because the result then carries the alias in its own TAG and the
	// element type is read off the VALUE rather than off a record a sharing rule may withhold. ⭐ It is also
	// what keeps `ValueDeclaredAliasMap` to the ONE reader its safety argument assumes: a missing entry there
	// is again only a missing E3010, never a silently different representation.
	//
	// ⚠ It asks the SOURCE as well as the target, so it fires only where the answer would actually move —
	// a cast between two aliases that pack identically stays the no-op it always was. That narrowness is
	// load-bearing, not incidental: every firing costs an op and a live range (see the ⛔⛔ block above).
	function castChangesTheElementPacking(value ValueId, targetAlias DeclaredAlias) returns bool
		return match targetAlias 'a'
			declared(alias) gives rangedAliasPackedBits(alias.low, high: alias.high) != self.elementPackingOfValue(value)
			undeclared gives false
		end 'a'
	end 'castChangesTheElementPacking'

	// The packed width the value ALREADY carries — the source half of the question above. A value with no
	// PROVEN ranged alias (a bare `int`, a call result, a parameter typed `int`, an arithmetic result that
	// merely adopted its operands' alias) is byte-strided, which is `ElementPacking.byteStrided`, so a
	// cast to a packing alias is a genuine move between the two ladders.
	function elementPackingOfValue(value ValueId) returns ElementPacking
		return match self.provenAliasOfValue(value) 'a'
			declared(alias) gives rangedAliasPackedBits(alias.low, high: alias.high)
			undeclared gives ElementPacking.byteStrided
		end 'a'
	end 'elementPackingOfValue'

	// ⭐⭐ **WOULD THIS VALUE BE STORED DIFFERENTLY FROM WHAT THIS ALIAS SAYS?** — the WHOLE element stride,
	// both ladders. Two callers: `admitArrayLiteralElement`, which asks it of a stated instance's element slot,
	// and `mayRetypeForNarrowerStorage`, which asks it of an `as` target.
	//
	// ⛔ **IT IS NOT ONE OF `applyCast`'s FIVE MINT QUESTIONS, AND MUST NOT BECOME ONE.** It was, briefly, and
	// the ⛔⛔ block on `castChangesTheElementPacking` records the two programs that stopped compiling: an arm
	// of that list MINTS a value, and asking this there doubled the live values at every narrowing ranged cast
	// in the language. The question itself is asked freely — `mayRetypeForNarrowerStorage` puts it to every
	// `as` — because its yes now costs a RENAME rather than a value.
	//
	// ⚠ The two predicates are not redundant and neither subsumes the other: `castChangesTheElementPacking`
	// asks whether an `as` moved a value between the byte and sub-byte LADDERS, which is a question about the
	// value's own type; this asks whether a value fits the slot an instance declares, which is a question
	// about a position. `ByteArray from [10, 20, 30]` is the case that separates them — the packing answer is
	// "no" (both sides are byte-strided) while the storage answer is "yes" (8 bytes into a 1-byte slot).
	function storageDiffersFromAlias(value ValueId, targetAlias DeclaredAlias) returns bool
		return match targetAlias 'a'
			declared(alias) gives aliasElementStride(alias) != self.elementStrideOfValue(value)
			undeclared gives false
		end 'a'
	end 'storageDiffersFromAlias'

	// The stride the value ALREADY occupies — the source half of the question above. A value with no PROVEN
	// ranged alias takes a full machine word.
	//
	// ⛔ **PROVEN, NOT DECLARED.** An adopted arithmetic result (`s + 1` over a `Small`) and a merge nothing
	// proved WEAR the alias and may hold a value outside it. Read off the DECLARED alias, `[s + 1]` would
	// type its literal `Array with Small` and store 256 into a one-byte slot as 0 — no guard, no diagnostic.
	// Read as a machine word, the same element reaches `convertValueToDeclaredType`, whose range check fires.
	function elementStrideOfValue(value ValueId) returns ElementStride
		return match self.provenAliasOfValue(value) 'a'
			declared(alias) gives aliasElementStride(alias)
			undeclared gives MachineWordBytes as ElementStride
		end 'a'
	end 'elementStrideOfValue'

	// The half of the question above that is about the ALIAS, split out exactly as
	// `aliasChangesTheShiftFill` is and for the same reason: the arms read as the sentences they are.
	//
	// ⚠⚠ **IT ASKS ONLY THE ZERO HALF OF THE PROOF, AND THAT IS DELIBERATE.** A cast target can
	// move the OTHER hazard too — `z as SmallCount` for an `int(0 to 100)` would tell a `mod` its divisor is
	// never `-1` and save it the overflow guard — and this predicate answers `false` for it, because the
	// target admits zero. The consequence is a needless 4-op guard on that one shape and NOTHING else: no
	// wrong answer, no lost diagnostic, and the divide there is already paying a full checked expansion.
	// Widening it would cost far more than it saves — every zero-admitting narrowing cast of a bare
	// local (`x as Byte`, `x as Percent`, `x as AsciiCode`) would start MINTING a value where it is a
	// byte-for-byte no-op today, which is the property the header above exists to protect.
	function aliasChangesTheDivisionProof(value ValueId, alias RangedTypeAlias) returns bool
		if not aliasExcludesZero(alias) 'admitsZero'
			return false
		end 'admitsZero'

		return divisorProofZeroVerdict(self.divisorProof(value)) != DivisorZeroVerdict.neverZero
	end 'aliasChangesTheDivisionProof'

	// ⭐ **EMIT A REPRESENTATIONALLY-NO-OP CAST AS A DISTINCT VALUE.** The conversion moves no bits, so
	// its RESULT is the arithmetic identity — one op, minted with a FRESH ValueId typed as the target
	// — which leaves the source ValueId's identity untouched (an in-place re-tag would corrupt `aTag`
	// when a later use reads it as `WA.Idx`, and would make `x` unsigned after `let w = x as Word`).
	// ONE emitter for every reason a cast mints, in both domains. Both directions of the per-instance
	// case ride it — STAMP (`x as StrWrapper.Idx`, result typed the per-instance alias) and STRIP
	// (`idx as ExitCode`, result the plain target, so a per-instance Idx decays to the numeric it is).
	// `foldConstOperands` folds the op to a single `binOpImm add 0`.
	//
	// ⭐ **AND IT HAS A CALLER THAT IS NOT A CAST AT ALL: `emitFieldLoad`'s PROMISE ARM.** Reading
	// `p.inner` off an unboxed promise is the same problem in different words — the value already IS the
	// answer, and what is wanted is a DISTINCT ValueId wearing the field's declared type, so the handle does
	// not arrive carrying the promise's own marks (`valueOwnsGreenThread`, `valueIsPromise`), which would
	// enrol a second owner of one green thread and double-drop it. This is the compiler's one debugged
	// spelling of "the same bits, a new identity, a new type"; a second would be a second thing to get right.
	// ⚠ Its `range` is a SourceRange rather than the cast's `asTok`, for that caller: a field read is
	// anchored `SourceRange.between(baseTok, last: memberTok)` and has no single token to point at.
	//
	// ⚠ **IT RECORDS NO RANGE-CHECK SITE, AND THAT IS DELIBERATE.** The site is the SOURCE, not this
	// mint, so `applyCast` records it above the branch — see the ⚠ there for why anchoring on the result
	// would downgrade `3 as Big` from an E3005 to a runtime guard.
	//
	// ⚠ **THE PARSER'S CONSTANT VIEW CROSSES THE MINT**, and that is not an optimization either. `x + 0`
	// is `x`, so a constant source names a constant result — and the parser's const table is what turns a
	// shift COUNT into a compile-time decision (`emitShift` rejects a negative count and folds an
	// over-wide one, both guarded on `constIsKnown`). Without this, `a shl (0 - 1 as Word)` would trade
	// its diagnostic for a runtime guard purely because the cast started minting. `recordFold` is what
	// `emitBinOp` does with the same `+`, so the two agree on what a folded `add` knows.
	//
	// ⚠ The base-range compatibility check the spec names (`fooIdx as BarContainer.Idx` requires the SAME
	// low/high) is inert while every inner alias is `int(0 to u64.max)`, and its diagnostic form is
	// deferred until a narrower inner range exists.
	function emitRetaggedCastValue(value ValueId, targetType MaxonType, range SourceRange) returns ValueId
		if self.typeIsFloatDomain(targetType) 'floatDomain'
			return self.emitRetaggedFloatCastValue(value, range: range)
		end 'floatDomain'

		let result = self.mintValueOfType(targetType)
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: range)
		let sourceIsNarrowerThanAWord = self.tagOf(value) == ValueTypeTag.boolean

		// ⚠ The WIDE operand has to be on the LEFT: `LowerMaxonToStd.appendStdBinOp` takes the op's operand
		// type from its left operand alone, so an i1 lhs declares the whole `add` i1 and wasm then truncates
		// the widened value back to one bit. The i64 literal on the left declares it i64.
		if sourceIsNarrowerThanAWord 'widenFromTheLiteralsWidth'
			self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(result, lhs: zero, rhs: value, op: MaxonBinOp.add), range: range)
		end 'widenFromTheLiteralsWidth' else 'sameWidth'
			self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(result, lhs: value, rhs: zero, op: MaxonBinOp.add), range: range)
		end 'sameWidth'

		if self.constIsKnown(value) 'constantSource'
			self.recordConst(result, folded: self.constOf(value))
		end 'constantSource'

		return result
	end 'emitRetaggedCastValue'

	// ⭐⭐ **THE FLOAT DOMAIN'S FORM OF THE SAME MINT — `x - 0.0`, AND THE SUBTRACTION IS NOT THE ADDITION.**
	// IEEE-754 makes `x - (+0.0)` the identity for every input INCLUDING `-0.0`, where `x + 0.0` would answer
	// `+0.0` and lose a sign the language can print — the same distinction `MaxonUnaryOp.fneg` records from
	// the other side.
	//
	// ⚠ **THE MINT IS TYPED `float`, NEVER THE TARGET'S `named` ALIAS.** A value's register class comes from
	// its tag, and a `named`-tagged double would be given `StdType.i64` and land in a GPR; the alias travels
	// in `ValueDeclaredAliasMap` instead, which `finishCast` writes because this result is not the source.
	function emitRetaggedFloatCastValue(value ValueId, range SourceRange) returns ValueId
		let result = self.mintValueOfType(MaxonType.float)
		let zero = self.emitLiteral(0, valueType: MaxonType.float, range: range)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(result, lhs: value, rhs: zero, op: MaxonBinOp.sub), range: range)

		if self.floatConstIsKnown(value) 'constantSource'
			self.recordFloatConst(result, bits: self.floatConstBitsOf(value))
		end 'constantSource'

		return result
	end 'emitRetaggedFloatCastValue'

	// ⭐ **THE ONE PLACE A RANGE-CHECK SITE IS APPENDED** for a position whose declared alias the parser
	// already holds — an `as` cast, a struct-literal field, a field store, a self-field store, a field's
	// declared default, an array element, and an argument at an OPAQUE type parameter (whose alias is
	// the receiver instance's substituted type argument rather than anything the callee declared). Each
	// caller decides exactly ONE thing: which alias (through
	// `declaredAliasOfType`, the one asker, so every door resolves the question the same way).
	// `undeclared` — a bare primitive, a struct, a name nothing declares — records nothing.
	//
	// ⚠ **IT DECIDES NOTHING ABOUT WHICH HALVES THE SITE OWES.** Every door that reaches here owes BOTH. A
	// `guard` field carrying one value at every site is a fact written twice, one copy of which goes stale
	// against the prose. `RangeCheckGuard` itself stays: the CALL-ARGUMENT door owes the compile-time half
	// alone, and it asks `guardVerdict` directly, holding no site
	// (`InsertRangeChecks.checkArgAgainstParamRange`).
	//
	// ⭐ **EVERY ONE OF THOSE DOORS STILL HOLDS THE UN-ERASED TYPE, which is precisely why they can resolve
	// for themselves and the CALL-ARGUMENT door cannot.** A cast names its target outright, and a struct
	// field's declared type is never rewritten (`TypeResolution.checkStructFieldTypes` validates and
	// discards its result), so `ProgramSignatures.fieldTypeOf` still answers `named(Percent)` for the whole
	// compile. A parameter's does not survive `resolveTypes` — see `recordConstantArgRangeChecks`.
	//
	// `block` is the value's CHECKING block (`self.bodyState.currentBlock`), so a runtime guard runs on the path the
	// value is on — a cast in an unselected ternary arm / if-branch does not fire it. `maxonOpPos` is WHERE
	// in that block: the block's op count RIGHT NOW, which is the ordinal the op that spends the value is
	// about to take, because every door here records BEFORE it emits that op (`applyCast` above its two
	// conversion arms, `requireFieldType` before its caller stores, `fillFieldDefault` before the literal
	// reaches the slot). Anchoring on the block alone puts the guard at the block's END and lets the whole
	// rest of the body run first — see `RangeCheckSite`.
	//
	// The anchor arrives as line/column rather than a `Token` because the field-DEFAULT door has no token
	// of its own: the default is a literal from a declaration that may live in another file, so its
	// diagnostic is anchored on the struct literal that took it, which that door holds as a `SourceRange`.
	//
	// ⭐⭐ **A SITE THE DESTINATION PROVABLY ADMITS IS NOT A SITE AT ALL, AND IT IS DECIDED BELOW
	// BECAUSE THIS IS WHERE ALL FIVE ALIAS-NAMED DOORS MEET.** The rule is `rangeCoversDenotedRange`, which
	// is the containment E3010 reports, asked of the pair every door already holds — so *"unneeded cast:
	// 'Byte' already fits in 'ExitCode'"* and the runtime cascade behind it can no longer be two answers to
	// one question. (That cascade spells `0 ≤ x ≤ 4294967295` on WINDOWS only — `ExitCode`'s high bound is
	// platform-shaped, `Project.exitCodeAliasHigh` — and the bound it carries is not what makes it dead; the
	// containment is, on every target.) Removing the redundant cast would otherwise ADD that cascade, on a
	// value whose declared type cannot fail it.
	//
	// ⚠ **IT SKIPS THE COMPILE-TIME HALF TOO, AND THAT COSTS NO DIAGNOSTIC.** `InsertRangeChecks` reports
	// E3005 only for a value it can FOLD, and a folded literal denotes no alias (`valueDenotedAlias` falls
	// through to its `integer` tag) — so containment cannot hold for one, and every literal door still
	// records. Where a folded constant DOES carry an alias it got it from a cast, whose own site reported
	// the E3005 already; a range inside the destination cannot then put it outside the destination.
	function recordRangeCheckSite(value ValueId, destination MaxonType, line LineNumber, column ColumnNumber)
		let alias = try self.rangeCheckedAliasOf(destination) otherwise return
		self.recordRangedTargetSite(value, target: alias, line: line, column: column)
	end 'recordRangeCheckSite'

	// The cast door hands over the alias `applyCast` already resolved: its shift-fill predicate asks
	// the identical question of the identical type, and `signatures.aliasOf` allocates per call.
	function recordCastRangeCheckSite(value ValueId, targetAlias DeclaredAlias, targetType MaxonType, opTok Token)
		let alias = try self.rangeCheckedAlias(targetAlias, t: targetType) otherwise return
		self.recordRangedTargetSite(value, target: alias, line: opTok.line, column: opTok.column)
	end 'recordCastRangeCheckSite'

	// ⚠ **THE SOURCE RANGE IS RESOLVED HERE AND NOT ONE FRAME UP, BECAUSE A DESTINATION THAT NAMES NO
	// RANGED ALIAS MUST NOT PAY FOR IT.** `valueDenotedAlias` CONSTRUCTS a `DeclaredAlias`, and the doors
	// above it are the ordinary field store and array-element store — almost every one of which writes an
	// `int` slot and has nothing to prove. MEASURED on the scale ladder: asking unconditionally read
	// **+3,848 `phase:parse` allocations at rung 5, doubling per rung**, for a question whose answer was
	// `undeclared` at every one of those sites.
	function recordRangedTargetSite(value ValueId, target RangedTypeAlias, line LineNumber, column ColumnNumber)
		self.admitUnsignedLiteral(value)
		self.recordLiteralCounterUse(value, target: target, line: line, column: column)

		if self.valueIsProvablyInRange(value, target: target) 'provablyInRange'
			return
		end 'provablyInRange'

		// The site's own copy: the alias is the signature index's record, and the site rides the
		// artifact, which may hold no record from outside itself.
		self.recordResolvedRangeCheckSite(value, target: RangeCheckSiteTarget.alias(target.clone()), line: line, column: column)
	end 'recordRangedTargetSite'

	// Is `t` in the FLOAT domain — the bare `float` keyword, or a `named` type that denotes a ranged
	// float alias? Everything else (bare int, an int alias, `ExitCode`, an opaque type parameter, a
	// struct/String/Character/function/existential pointer) is the integer/pointer domain. Exhaustive
	// over `ValueTypeTag`, so a new tag cannot slip through as a silent `false`. `namedIsFloatAlias`
	// is asked only on the `named` arm, where its interner precondition holds.
	function typeIsFloatDomain(t MaxonType) returns bool
		return match maxonTypeTag(t) 'k'
			boolean or
			integer or
			exitCode or
			unresolved or
			void or
			structRef or
			string or
			function or
			typeParameter or
			genericInstance or
			character or
			interfaceRef or
			cstring gives false
			float gives true
			named gives self.namedIsFloatAlias(typeNameIdOf(t))
		end 'k'
	end 'typeIsFloatDomain'

	// Emit `a / b` or `a mod b` — the one place the divide-by-zero policy lives. Three ways out,
	// decided per site from what the compiler can prove about the divisor:
	//
	//   • provably zero (a folded `0`, `0.0` or `-0.0`) — E3103 at compile time. A divide that can
	//     only ever fail is a bug, and a catchable error would offer the program a recovery from one.
	//   • provably non-zero (a non-zero folded constant, or a ranged type or recorded interval that
	//     excludes 0) — a bare `binOp`: no guard, no branch, no call. This is the language's escape hatch
	//     and it costs nothing; a `try` on it is E3055.
	//   • anything else — the divide throws `__DivisionByZeroError`, so it must be caught: by a `try`,
	//     an enclosing `try` block or a test body's implied handler, and otherwise it is E3057.
	//
	// The throwing form is emitted call-shaped, and that is structural: only a `call`, a witness
	// dispatch or an `await` can be rewritten into the try channel (`routableOpAt`). Riding the ordinary `call` → `tryCall` ABI also gives it the
	// `try` requirement, the `otherwise (e)` binding, the propagate path, the router and the fork's
	// drop sets every other throwing callee has.
	//
	// A divide nothing catches stays a plain `call`, and `SemanticCheck.validatePlainCall` reports
	// E3057 off the same `isThrowingRuntimeCallee` every other throwing builtin is reported through —
	// one gate, which cannot disagree with the parser's E3055 accept.
	function emitDivOrMod(func IrFunction, dividend ValueId, divisor ValueId, op MaxonBinOp, opTok Token) returns ValueId throws SourceParseError
		// The OPERAND rule first, for `emitShift`'s stated reason: a rejected program must leave no ops
		// behind, and the proof below would otherwise decide the fallibility of operands that are not numbers.
		// Through `numberTagOf`, and the DECODE below it, for `emitBinOp`'s reason: a `/` is a question
		// about the number, so `Weight.light / 2.0` divides 2.5 rather than an encoding.
		let leftTag = self.numberTagOf(dividend)
		let rightTag = self.numberTagOf(divisor)
		try self.requireBinOpOperands(op, left: leftTag, leftValue: dividend, right: rightTag, rightValue: divisor, opTok: opTok)

		// The nominal rule, asked of the operands the SOURCE wrote and above every emit, exactly as
		// `emitBinOp` asks it — a `/` over two different typealiases is refused there and must be here.
		let operandAlias = try self.operandAliasIdentity(dividend, rhs: divisor, opName: opTok.kind.rawValue, opTok: opTok)

		// ⭐⭐ **THE DIVISION SIGNEDNESS RULE, ASKED ONCE AND THEN CARRIED.** This is the last tier that
		// CAN ask it: the rule reads each operand's DECLARED ranged type, and an alias name resolves against
		// the file that is being parsed (`aliasOf(…, readerFilePath:)`) — by the Std tier one module holds
		// every file's values and there is no reader to resolve against. So the answer is written into the
		// OPCODE here, exactly as `emitShift` writes the shift's fill into `shrLogical`, and the fold, the
		// `-1` overflow gate, the expansion's callee and the Std lowering all READ it rather than re-deriving
		// it. Two readers of one rule reaching two answers is the class of bug this file has already paid for.
		//
		// It is asked BEFORE the divide-by-zero proof because the two are independent — a range's SIGN and
		// its zero are different questions about it — and because the proof's `-1` half is answered in terms
		// of the opcode this line mints.
		let divideOp = divisionOpcodeFor(op, unsigned: self.divisionRunsUnsigned(dividend, divisor: divisor, leftTag: leftTag, rightTag: rightTag))

		// ⭐⭐ **ONE PROOF, TWO HAZARDS, THREE ROUTES.** The verdict is asked ONCE and both of its facts
		// are read here, because this is the only place that knows which OPERATOR is being emitted — and the
		// two operators want different halves of it. Reading the zero half alone is precisely how
		// `i64.min mod -1` came to die on the `neverZero` route: a divisor proven non-zero is not a divisor
		// proven not `-1`, and `mod`'s answer at `-1` exists while `/`'s does not.
		let proof = self.divisorProof(divisor)
		let zeroVerdict = divisorProofZeroVerdict(proof)

		// A SIGNED REMAINDER whose divisor is proven non-zero but might still be `-1` is TOTAL and needs a
		// guard, so it is neither refused, nor thrown from, nor emitted bare — it takes the expansion route
		// below with a callee of its own. Asked before the zero verdict's `neverZero` arm can send it to the
		// bare emitter.
		//
		// ⚠ **`== MaxonBinOp.mod` NOW MEANS "A SIGNED `mod`", AND THAT IS THE OPCODE DOING ITS JOB** — an
		// unsigned remainder is `modUnsigned` and is EXCLUDED here on purpose. `idiv`'s `#DE` at `-1` is an
		// overflow of the SIGNED quotient; read unsigned, `-1` is `u64.max` and `a mod u64.max` is an ordinary
		// answer (`5`, not `0`). Guarding it would not merely be wasted work — the guard ANSWERS `0` at that
		// divisor, so it would turn every `a mod u64.max` into a wrong answer.
		let remainderNeedsOverflowGuard = divideOp == MaxonBinOp.mod and divisorProofMayBeNegativeOne(proof)

		// ⚠ A provably-zero divisor is refused whatever the other hazard says: `a mod 0` has no answer at all,
		// so there is nothing for the overflow guard to guard and E3103 is still the whole verdict. Kept an
		// EXHAUSTIVE match over the verdict rather than an `== alwaysZero` test, so a fourth answer to "can it
		// be zero?" cannot reach the routing below by omission.
		match zeroVerdict 'verdict'
			alwaysZero then throw SourceParseError.divisionByProvableZero(opTok.kind.rawValue, line: opTok.line, column: opTok.column)
			neverZero or
			possiblyZero then break
		end 'verdict'

		// ⭐ **THE FLOAT-BACKED ENUM DECODE, PAID ONCE FOR BOTH ROUTES BELOW.** It sits past every
		// refusal in this function — the operand rule and E3103 — so a rejected program still leaves no ops
		// behind, and past `divisorProof`, which must read the value the SOURCE wrote. Every other value
		// passes through unchanged, so the two routes divide it unchanged.
		let dividendNumber = self.floatBehindEnumValue(dividend, anchor: opTok)
		let divisorNumber = self.floatBehindEnumValue(divisor, anchor: opTok)

		// ⭐ **A SIGNED QUOTIENT PANICS AT `i64.min / -1`, AHEAD OF EITHER ROUTE.** No quotient exists there, so
		// the guard branches to a panic rather than repairing an operand, and it is emitted in the dividing
		// function so the backtrace names that function first. `divUnsigned` has no such pair, and a proof
		// that rules out either operand of the pair removes the guard.
		if divideOp == MaxonBinOp.div and not operandsAreFloat(leftTag, right: rightTag) and divisorProofMayBeNegativeOne(proof) and self.dividendMayBeIntMin(dividend) 'quotientMayOverflow'
			try self.emitQuotientOverflowGuard(func, dividend: dividendNumber, divisor: divisorNumber, opTok: opTok)
		end 'quotientMayOverflow'

		// The BARE divide goes to `emitBinOpOverCheckedOperands`, not to `emitBinOp` — which REFUSES a
		// division outright, so that a division reaching the general emitter is a loud parser bug rather
		// than an unguarded `idiv`. The operand rule this verdict sits behind is the one that door would
		// have asked, so nothing is skipped by entering past it.
		//
		// ⭐ **NEITHER HAZARD OPEN IS THE ONLY ROUTE TO A BARE `idiv`**: the zero divisor closed by the proof, and
		// the `-1` divisor closed by the proof or, for `/`, by the quotient guard above. The zero half alone would
		// wave `i64.min mod -1` through.
		if zeroVerdict == DivisorZeroVerdict.neverZero and not remainderNeedsOverflowGuard 'noHazardLeftOpen'
			return self.emitBinOpOverCheckedOperands(dividendNumber, rhs: divisorNumber, op: divideOp, leftTag: leftTag, rightTag: rightTag, opTok: opTok, operandAlias: operandAlias)
		end 'noHazardLeftOpen'

		// ⭐ **THE PROMOTION IS THE SAME ONE `emitBinOp` OWES, PAID HERE FOR THE SAME REASON.** The Std
		// expansion divides the two argument values directly, so a mixed `1.0 / n` must hand it an f64 on both
		// sides or the emitted `divsd` would read an i64 out of a GPR. `promotedOperand` is idempotent and is
		// asked of both sides, exactly as in `emitBinOp`, so the two paths cannot promote differently.
		//
		// It happens AFTER the verdict, which reads the operand the SOURCE wrote: the divisor's own constant
		// domain is what says whether it is zero, and a promotion would only move the same value into a
		// different domain's spelling.
		let promotedDividend = self.promotedOperand(dividendNumber, left: leftTag, right: rightTag, opTok: opTok)
		let promotedDivisor = self.promotedOperand(divisorNumber, left: leftTag, right: rightTag, opTok: opTok)

		let args = ValueIdArray.create(0)
		args.push(promotedDividend)
		args.push(promotedDivisor)

		// ⭐ **THE ZERO VERDICT ALONE PICKS THE NAME, and that is what keeps the error channel a property of
		// the divisor's ZERO hazard only.** A guarded remainder reaching here is `neverZero` by construction —
		// the bare route above is the only other thing a `neverZero` divisor can take — so it gets the TOTAL
		// callee and, downstream, no `throws` clause and no E3057.
		let callee = divisionExpansionCalleeForOp(divideOp, fallible: zeroVerdict == DivisorZeroVerdict.possiblyZero)
		let resultTag = binOpResultTag(divideOp, left: leftTag, right: rightTag)
		let result = self.emitRuntimeCall(callee, args: args, resultTag: resultTag, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(opTok))

		// The expansion's result wears the adopted alias exactly as the bare divide's does: which route a
		// division takes is a hazard question, and the type of the answer is not.
		self.adoptOperandAlias(result, alias: operandAlias, resultTag: resultTag)
		self.settleFloatBinOp(result, lhs: promotedDividend, rhs: promotedDivisor, op: divideOp)

		// ⭐ **AN EXPANSION IS STILL A FOLD SITE — see `recordBinOpFold` for the diagnostic that was lost
		// when it was not.** Asked on BOTH expansion routes and not only the guarded one: a `possiblyZero`
		// divisor is by definition not a constant, so the fallible route simply never folds, and gating it
		// would be a second copy of that reasoning rather than a saving.
		self.recordBinOpFold(result, lhs: dividend, rhs: divisor, op: divideOp, resultTag: resultTag)

		return result
	end 'emitDivOrMod'

	// ⭐⭐ **DOES THIS `/` OR `mod` RUN UNSIGNED?** — the parser's half of TypeRules' ⭐⭐ THE DIVISION
	// SIGNEDNESS RULE: it reads each operand's domain and hands the pair to the rule, which is stated once,
	// there, over `IntegerValueDomain` alone.
	//
	// The FLOAT gate is not a shortcut. `divsd` has no signedness, a ranged float alias carries tag `float`
	// rather than `named` (so `integerValueDomain` would answer `signed` for it anyway, for the wrong
	// reason), and the answer must be `false` on this path or `lowerDivisionExpansion` would meet an
	// unsigned float divide — which it panics on, and rightly. Asked through `operandsAreFloat`, the same
	// predicate `promotedOperand` uses to decide whether the pair meets in the float domain at all.
	function divisionRunsUnsigned(dividend ValueId, divisor ValueId, leftTag ValueTypeTag, rightTag ValueTypeTag) returns bool
		if operandsAreFloat(leftTag, right: rightTag) 'floatDivide'
			return false
		end 'floatDivide'

		return divisionOperandsAreUnsigned(self.integerValueDomain(dividend), divisor: self.integerValueDomain(divisor))
	end 'divisionRunsUnsigned'

	// ⭐⭐ **WHAT ONE VALUE'S DECLARED TYPE SAYS ABOUT ITS SIGNEDNESS** — the value-level twin of
	// `valueIsUnsigned`, and three-valued where that one is two-valued, because both consumers have to
	// tell "this value ASKS for an unsigned reading" apart from "this value merely FITS one".
	//
	// ⭐ **TWO CONSUMERS READ IT, AND THE SECOND IS WHY IT IS NAMED FOR THE VALUE.** The DIVIDE
	// asks it of both operands (`divisionRunsUnsigned` → `divisionOperandsAreUnsigned`); the DECIMAL
	// RENDERER asks it of one (`materializeInterpExpr` → `valueRendersUnsigned`), which is what makes
	// `"{w}"` for a `w` of `int(0 to u64.max)` holding `u64.max` print `18446744073709551615` rather
	// than `-1`. They read ONE walk rather than two, because a second spelling of "is this value
	// unsigned" is a second place for the answer to drift.
	//
	// ⚠ **A DECLARED RANGE ANSWERS ALONE, BOTH WAYS, AND THE ORDER IS THE RULE.** A value of `int(-10
	// to 10)` that happens to hold `3` is an operand whose TYPE admits negatives, so it reads `signed`
	// and the folded `3` is never consulted: letting the value speak over the declaration would make
	// `w / a` unsigned on the strength of a NUMBER where the language's answer comes from a TYPE.
	//
	// `exitCode` is the builtin `ExitCode` — a declared non-negative range with no alias declaration to look
	// up, placed here exactly as `valueIsUnsigned` places it. Its HIGH bound is platform-shaped (`u32.max` on
	// Windows, 255 elsewhere — `Project.exitCodeAliasHigh`) and none of that reaches this decision:
	// "non-negative" is a statement about the LOW bound, which is 0 on every target.
	//
	// ⚠⚠ **IT READS THE CAST-RECORDED ALIAS AS WELL AS THE TAG COLUMN, AND THAT DIFFERENCE IS A
	// SILENT WRONG ANSWER.** A cast to a non-negative alias that ADMITS ZERO — `int(0 to 255)`, or
	// the builtin `ExitCode` — is deliberately a representational NO-OP (`applyCast`: it changes
	// neither the shift fill nor the divide-by-zero proof nor the element packing), so it mints no
	// value and the tag column still says what the SOURCE was. Read from the tag alone the operand
	// answers `signed`, which drags the whole divide signed and misreads the OTHER operand: with
	// `Word = int(0 to u64.max)` holding `u64.max`, `try (w / d)` answers **0** where the answer is
	// **6148914691236517205**. `domainDeclaringAlias` reads the record the cast already leaves, and
	// the entry IS a proof — the `as` emits the range guard. The one spelling no record can carry, a
	// cast of a BARE LOCAL (one value under two names), is what `castChangesTheDivisionSignedness`
	// mints for.
	function integerValueDomain(value ValueId) returns IntegerValueDomain
		if self.tagOf(value) == ValueTypeTag.exitCode 'exitCode'
			return IntegerValueDomain.declaredNonNegative
		end 'exitCode'

		match self.domainDeclaringAlias(value) 'declaredType'
			declared(alias) then return IntegerValueDomain.declaredNonNegative if rangeIsUnsigned(alias.low) else IntegerValueDomain.signed
			undeclared then break
		end 'declaredType'

		// ⭐⭐ **`u64.max` IS A NON-NEGATIVE CONSTANT WHOSE PATTERN IS NEGATIVE, and the test below is a
		// SIGNED read of a pattern.** Asked FIRST, because `constOf` would answer `-1` for it and send the
		// whole comparison down the signed arm — see `unsignedMaxLiterals` for the wrong answer that is.
		// It answers `provablyNonNegative` rather than `declaredNonNegative` for the same reason every
		// other folded constant does: a LITERAL fits an unsigned reading and does not ASK for one, so
		// `u64.max > u64.max` (two literals, no declared type anywhere) keeps the signed compare it has
		// always emitted — and answers `false`, which is right in both readings.
		if self.valueCarriesAnUnsignedPattern(value) and not self.constIsKnown(value) 'anUnsignedRead'
			return IntegerValueDomain.declaredNonNegative
		end 'anUnsignedRead'

		if valueIsMarked(self.bodyState.unsignedMaxLiterals, value: value) 'theUnsignedExtreme'
			return IntegerValueDomain.provablyNonNegative
		end 'theUnsignedExtreme'

		if self.constIsKnown(value) and self.constOf(value) >= 0 'fitsWithoutAsking'
			return IntegerValueDomain.provablyNonNegative
		end 'fitsWithoutAsking'

		return IntegerValueDomain.signed
	end 'integerValueDomain'

	// ⭐⭐ **THE WHOLE DIVIDE-BY-ZERO PROOF, IN ONE WALK.** Asked of the divisor's OWN constant domain,
	// never of the divide's RESULT kind — which is what lets `1.0 / n` and `n / 2` each be decided by
	// the operand actually written. Asking by RESULT kind instead cannot prove `1.0 / 2`'s integer
	// literal non-zero at all.
	//
	// The float arm reads BOTH zeros: `floatOrderKey` maps `+0.0` and `-0.0` to 0 (IEEE-754 makes them equal),
	// and `x / ±0.0` is `±inf` either way, so both must read as zero. `-0.0` reaches here as a single literal
	// with its sign bit set — `parseNegatedNumericLiteral` folds the sign into the literal — so no float
	// arithmetic has to be folded to see it.
	//
	// ⚠ **EVERY GAP FALLS TO `possiblyZero`, AND THE TWO DIRECTIONS ARE NOT SYMMETRIC.** See the union's own
	// header: a wrong `neverZero` is a silent hardware trap, a wrong `possiblyZero` is a visible needless `try`.
	//
	// ⭐⭐ **A RANGED FLOAT ALIAS IS PROVEN HERE THROUGH `valueDenotedAlias`.** A value of a ranged
	// FLOAT alias carries tag `float`, not `named` — its register class depends on the tag, so the
	// alias name cannot ride there (see `aliasChangesTheShiftFill`'s float arm) — so
	// `declaredAliasOfValue`, which reads the TAG, has nothing to look up. `ValueDeclaredAliasMap`
	// holds it (`applyCast`, and the `returns <float alias>` result at the call door), and
	// `valueDenotedAlias` is the reader that consults it BEFORE falling back to the tag.
	//
	// ⛔ The float arm is asked too. `specs/safety.md` owns the rule: float `/` is fallible on the same
	// terms as integer `/`, so a divisor whose ranged type excludes 0 compiles to a bare divide.
	// Demanding a `try` there refuses a program that no source spelling satisfies, since a proved
	// range means there is no throw to catch.
	//
	// ⚠ **THE ALIAS-CLAIM WITHHOLD STILL APPLIES, because it lives in the FALLBACK.** `valueDenotedAlias` is a
	// recorded cast alias first and `provenAliasOfValue` second (`denotedAliasId`), so a merge whose
	// declared alias nothing proved still answers `undeclared` here and still gets `possiblyZero`.
	// What the recorded arm adds is a value whose range WAS enforced — an `as` cast and a ranged
	// `return` both emit the guard, which is the same enforcement the list below turns on.
	//
	// ⚠⚠ **THE ALIAS ARM IS ONLY AS SOUND AS THE RANGE IS ENFORCED, AND THE ENFORCEMENT IS NOT THIS
	// FUNCTION'S — it is `InsertRangeChecks`', and this verdict is WRONG rather than merely coarse
	// wherever that enforcement has a hole.** A `NonZero` value reaching here is proof only because
	// every door it could have come through checks the range at RUNTIME: the `as` cast, the field
	// store, the field default and the ranged `return` each emit a guard where the value lands, and a
	// narrowed PARAMETER is guarded at its function's ENTRY — one guard in front of every caller,
	// direct, indirect and witness-dispatched alike, which is what makes `neverZero` off a `d NonZero`
	// parameter a real proof rather than an assumption. Unguarded, a runtime 0 reaches the bare `idiv`
	// and dies `panic: integer divide by zero` — an UNCATCHABLE fault where the language promises a
	// catchable `DivisionByZero`.
	//
	// ⚠ **EVERY DOOR IS SHUT — the ARRAY ELEMENT is shut at the
	// STORE** (`requireContainerElementType`), which is the one place that still knows the element type: the
	// callee-entry cure cannot reach it, because the element travels into a shared `Array` body whose
	// parameter is the opaque element type. A runtime 0 `push`/`set`/`insert`ed into an `Array with NonZero`
	// is refused where it is written.
	//
	// ⚠ **THE SLOTS NO VALUE CROSSES INTO ARE REFUSED AT THEIR PRODUCER.** `Array.resize`,
	// `__ManagedMemory.setLength` and `FixedArray.create` expose zero-initialized slots with nothing for a store
	// guard to stand in front of, so each is E3106 for an element range that excludes zero — an
	// `Array with NonZero` never holds a `0` this verdict did not see.
	function divisorProof(divisor ValueId) returns DivisorProof
		return match self.knownValueOf(divisor) 'known'
			// A FLOAT divisor cannot reach a `mod` at all (`requireBinOpOperands` refuses it), and `divsd`
			// cannot fault, so the overflow hazard has no float form to admit.
			floatConstant(bits) gives divisorProofOf(DivisorZeroVerdict.alwaysZero if floatOrderKey(bits) == 0 else DivisorZeroVerdict.neverZero, mayBeNegativeOne: false)
			integerConstant(value) gives divisorProofOf(DivisorZeroVerdict.alwaysZero if value == 0 else DivisorZeroVerdict.neverZero, mayBeNegativeOne: value == OverflowingDivisorPattern)

			// One alias, both bounds tests — and the float arm answers `mayBeNegativeOne: false` for the same
			// reason the float CONSTANT arm does, not because a float range was examined and cleared.
			rangedAlias(alias) gives divisorProofOfRange(alias.low, high: alias.high, isFloat: aliasIsFloat(alias))
			integerInterval(low, high) gives divisorProofOfRange(low, high: high, isFloat: false)

			// Nothing known: BOTH hazards admitted. This is the answer every gap in the proof falls to, and
			// the second fact is exactly as conservative as the first for the same stated reason.
			unknown gives divisorProofOf(DivisorZeroVerdict.possiblyZero, mayBeNegativeOne: true)
		end 'known'
	end 'divisorProof'

	// ⚠ **`valueDenotedAlias` (a recorded cast alias, else `provenAliasOfValue`), NOT `declaredAliasOfValue` —
	// A MERGE'S DECLARED ALIAS IS NOT A PROOF, AND THIS IS THE READER WHERE THAT COSTS AN UNCATCHABLE FAULT.**
	// MEASURED: a `NonZero` binding decremented to `0` around a loop kept the alias on its header phi, the
	// divisor proof answered `neverZero`, `100 / d` compiled to a BARE `idiv` needing no `throws
	// DivisionByZero` at all — and the runtime `0` died `panic: integer divide by zero`, the exact uncatchable
	// fault the PARAMETER door is closed to prevent. The withheld claim falls to `unknown`, which is the
	// conservative arm every proof reading this falls to.
	function knownValueOf(value ValueId) returns KnownValue
		if self.floatConstIsKnown(value) 'floatConstant'
			return KnownValue.floatConstant(self.floatConstBitsOf(value))
		end 'floatConstant'

		if self.constIsKnown(value) 'intConstant'
			return KnownValue.integerConstant(self.constOf(value))
		end 'intConstant'

		let denoted = self.valueDenotedAlias(value)

		if let proven = try provenIntRangeOf(self.bodyState.countedValueRanges, value: value) 'aProvenInterval'
			return knownIntervalWithinAlias(proven.low, high: proven.high, denoted: denoted)
		end 'aProvenInterval'

		return match denoted 'a'
			declared(alias) gives KnownValue.rangedAlias(alias)
			undeclared gives KnownValue.unknown
		end 'a'
	end 'knownValueOf'

	// A fixed array's size is part of its type, so an index proven inside it is a typing fact, not an
	// optimization: it decides whether a bare call compiles and whether `try` is legal (E3055). It is made
	// here at the call site because `stdlib/FixedArray.maxon`'s `get`/`set` are one shared body that takes
	// `index` as a runtime parameter and cannot see the caller's proof.
	// A ranged-alias index proves its range only because every door into the alias guards it; for a
	// parameter that is `InsertRangeChecks.guardRangedParams`' entry guard.
	// It returns before computing a verdict for every call that is not a sized-`FixedArray` `get`/`set`:
	// the verdict is a boxed union and this is asked of every call in the program.
	function fixedArrayAccessProof(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token) returns FixedArrayAccessProof throws SourceParseError
		let receiver = try args.get(0) otherwise return FixedArrayAccessProof.notProven
		let accessor = try sizedAccessorOf(self.signatures, receiverTag: self.tagOf(receiver), receiverNameId: self.valueNameId(receiver), callee: callee) otherwise return FixedArrayAccessProof.notProven

		if not fixedArrayAccessorShapeIsExact(accessor.accessor, args: args, argLabels: argLabels) 'notTheDeclaredShape'
			return FixedArrayAccessProof.notProven
		end 'notTheDeclaredShape'

		let index = try args.get(1) otherwise panic("fixedArrayAccessProof: an accessor of the exact shape carries its index")

		match fixedArrayIndexVerdictOf(self.knownValueOf(index), count: accessor.count) 'verdict'
			pastTheSize(value, count) then throw SourceParseError.fixedArrayIndexPastTheSize(value, count: count, line: anchor.line, column: anchor.column)
			proven then return FixedArrayAccessProof.proven(accessor)
			notProven then return FixedArrayAccessProof.notProven
		end 'verdict'
	end 'fixedArrayAccessProof'

	// The dividend's half of the quotient overflow pair, read the way `divisorProof` reads its divisor
	// (`knownValueOf`); nothing known leaves the pair admitted. Asked only of an integer dividend, so a
	// float constant is nothing this question can say anything about.
	function dividendMayBeIntMin(dividend ValueId) returns bool
		return match self.knownValueOf(dividend) 'known'
			integerConstant(value) gives value == OverflowingDividendPattern
			integerInterval(low, high) gives not rangeExcludesIntMin(low, high: high)
			rangedAlias(alias) gives not rangeExcludesIntMin(alias.low, high: alias.high)
			floatConstant or
			unknown gives true
		end 'known'
	end 'dividendMayBeIntMin'

	// Append a `binOp` op combining two SSA values; return the ValueId it defines. The
	// result's TYPE is the operator's: arithmetic and shifts are integer; `and`/`or`/`xor`
	// follow their operands (see `wordOpResultTag`) — the ONE place a bitwise op's result
	// could be a bool, which is what `consume(f.a or f.b)` against a `bool` parameter needs.
	// The source range anchors on the operator token (the conventional binop anchor).
	//
	// ⭐⭐ **A `/` OR `mod` CANNOT BE EMITTED THROUGH THIS DOOR AT ALL — REFUSED, NOT DOCUMENTED.** This
	// function is the emitter for the fourteen operators whose result is just a number; `emitDivOrMod` owns
	// the divide-by-zero policy and reaches the bare emit below through `emitBinOpOverCheckedOperands`, past
	// this refusal, on its provably-non-zero verdict alone.
	//
	// ⚠ **A COMMENT ASKING CALLERS NOT TO BRING A DIVISION HERE IS NOT ENOUGH, SO THIS DOOR REFUSES.** A division path
	// outside `emitDivOrMod` is a second division path in a compiler whose whole claim is that there is one, and a new
	// intrinsic that divides is easy to write by accident; it would be found by reading or not at all. A `panic`
	// names the caller, on the first program that compiles it, and needs nobody to be reading.
	function emitBinOp(lhs ValueId, rhs ValueId, op MaxonBinOp, opTok Token) returns ValueId throws SourceParseError
		// ⭐ **THE OPERAND RULE IS ASKED OF THE NUMBER, NOT OF THE ENCODING.** `numberTagOf` answers
		// `float` for a float-backed enum, which decides two things at once and both match the oracle:
		// `Weight.light + Weight.heavy` is float addition (6.5 — MEASURED, against the sum of two bit
		// patterns the compiler answered), and `Weight.light shl 1` becomes the E3005 `lacksIntegralReading` refuses
		// a float with, instead of shifting a mantissa. UNCONDITIONAL here because every operator this
		// emitter serves is a question about the number; only `emitCompare`'s equality has an identity
		// reading, and it gates.
		let leftTag = self.numberTagOf(lhs)
		let rightTag = self.numberTagOf(rhs)
		try self.requireBinOpOperands(op, left: leftTag, leftValue: lhs, right: rightTag, rightValue: rhs, opTok: opTok)

		if divisionOperator(op) 'divisionSkippedItsPolicy'
			panic("emitBinOp: '{op.rawValue}' is a DIVISION, and reaching this emitter is how one gets emitted with NO divide-by-zero verdict asked — an unguarded `idiv` where a catchable `DivisionByZero` was promised. Route it through `emitDivOrMod`, which owns the rule for every `/` and `mod` in the language; `parseBinary`'s `divisionOperator` gate is the source-level door and `emitMonotonicMs` is the intrinsic-level one.")
		end 'divisionSkippedItsPolicy'

		// The DECODE is paid only past the rule, so a refused program leaves no ops behind — the property
		// `emitShift`'s header states and the reason the tag question above is asked without emitting. Bound
		// to locals rather than written inline, because each one may EMIT and the left operand's
		// reinterpretation has to reach the block before the right one's.
		let left = self.floatBehindEnumValue(lhs, anchor: opTok)
		let right = self.floatBehindEnumValue(rhs, anchor: opTok)

		// ⭐⭐ **THE NOMINAL RULE, ASKED AFTER THE CLASS RULE SO A `3 + true` KEEPS ITS OWN WORDING.** A SHIFT
		// adopts its LEFT operand alone and asks no agreement: the right operand is a BIT COUNT, not a value
		// of the result's type, so `n shl w` is `n`'s type whatever `w` was declared. Every other operator
		// here is a question about two values of one type — and `or`/`xor` ask it and then keep the alias only
		// where it holds every result (`adoptBinaryResultAlias`).
		let agreed = self.operandAliasOf(lhs) if shiftOperator(op) else try self.operandAliasIdentity(lhs, rhs: rhs, opName: opTok.kind.rawValue, opTok: opTok)

		return self.emitBinOpOverCheckedOperands(left, rhs: right, op: op, leftTag: leftTag, rightTag: rightTag, opTok: opTok, operandAlias: agreed)
	end 'emitBinOp'

	// The emit itself, entered only with the operand rule ALREADY asked — so a caller that has done the
	// checking itself reaches the emit without either re-asking `requireBinOpOperands` or carrying a
	// "trust me" flag through the door above. The result's TYPE is the operator's: arithmetic and
	// shifts are integer; `and`/`or`/`xor` follow their operands (`wordOpResultTag`).
	//
	// ⭐ **ITS TWO CALLERS TAKE IT FOR DIFFERENT REASONS, and neither is "convenience".**
	//   • `emitDivOrMod` — because `emitBinOp` REFUSES `/` and `mod` outright (it panics on them), so
	//     this is the only route to the emit, taken on its provably-non-zero verdict alone.
	//   • `emitBinaryMathIntrinsic` — because `min`/`max` are BUILTIN CALLS, not operators. `emitBinOp`
	//     would accept them, but `requireBinOpOperands` words its rejection in terms of an OPERATOR
	//     ("the operands of '<op>' …"), and there is no operator symbol anywhere in `min(3.0, true)`.
	//     The builtin path has already rejected a non-numeric operand in the callee's own name
	//     (`numericBuiltinOperandAt`), which is the sentence the user can act on.
	// So the door is not "the division door" — it is the door for a caller that owns its own operand
	// rule, and the division was merely the first such caller.
	function emitBinOpOverCheckedOperands(lhs ValueId, rhs ValueId, op MaxonBinOp, leftTag ValueTypeTag, rightTag ValueTypeTag, opTok Token, operandAlias OperandAlias) returns ValueId
		let resultTag = binOpResultTag(op, left: leftTag, right: rightTag)

		// ⭐ **NUMERIC PROMOTION, PAID FOR.** `TypeRules.arithResultTag` answering `float` is a
		// PROMISE that both operands are already in the float domain, and this is the one place
		// it is kept: an i64 in a GPR is not an f64 in an XMM, and `addsd` cannot read one. It
		// happens HERE, in the parser, because this is the last tier that knows each operand's
		// source type — by the Std tier `operandType` is a single answer for the whole op, and
		// there is no longer a mixed pair to see.
		let left = self.promotedOperand(lhs, left: leftTag, right: rightTag, opTok: opTok)
		let right = self.promotedOperand(rhs, left: leftTag, right: rightTag, opTok: opTok)

		let result = self.mintValue(resultTag, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(result, lhs: left, rhs: right, op: op), range: SourceRange.ofToken(opTok))

		// The result WEARS its operands' typealias and PROVES nothing about it — see `adoptOperandAlias`.
		self.adoptBinaryResultAlias(result, lhs: lhs, rhs: rhs, op: op, alias: operandAlias, resultTag: resultTag)
		self.markUnsignedArithmeticResult(result, lhs: left, rhs: right, op: op)

		var borrowRuledOut = false

		if op == MaxonBinOp.sub and not (self.constIsKnown(left) and self.constIsKnown(right)) and self.operandsAreInTheUnsignedDomain(left, rhs: right) 'aRunTimeBorrow'
			borrowRuledOut = self.settleRunTimeBorrow(result, lhs: left, rhs: right)
		end 'aRunTimeBorrow'

		self.guardUnsignedArithmetic(result, lhs: left, rhs: right, op: op, alias: operandAlias, resultTag: resultTag, opTok: opTok, borrowRuledOut: borrowRuledOut)

		// ⭐ **THE ONE OPERATOR WHOSE RESULT INHERITS ITS OPERANDS' RANGED ALIAS AS A PROOF.** See
		// `bitAndInheritedAliasId` — and `rangeIsClosedUnderBitAnd`, which is the proof that makes the
		// inheritance a fact about the VALUE rather than a label on it.
		if let inherited = try self.bitAndInheritedAliasId(op, lhs: lhs, rhs: rhs, resultTag: resultTag) 'inheritsAnAlias'
			self.recordValueDeclaredAliasId(result, aliasId: inherited)
		end 'inheritsAnAlias'

		self.recordBinOpFold(result, lhs: lhs, rhs: rhs, op: op, resultTag: resultTag)
		self.settleFloatBinOp(result, lhs: left, rhs: right, op: op)
		self.recordLiteralRangeOfBinOp(result, lhs: lhs, rhs: rhs, op: op, resultTag: resultTag)
		self.recordBitAndMaskRange(result, lhs: lhs, rhs: rhs, op: op, resultTag: resultTag)

		return result
	end 'emitBinOpOverCheckedOperands'

	// ⭐⭐ **THE RANGED ALIAS `a and b` INHERITS FROM ITS OPERANDS — and `and` is the ONLY operator that
	// hands one down as a proof.** `and` can only CLEAR bits, so the result is bounded by each operand and the AND of
	// two `MachineWord`s genuinely IS a `MachineWord`: `rangeIsClosedUnderBitAnd` states the proof, and
	// names the two low bounds it does not hold for.
	//
	// ⚠ **WITHOUT IT, `let imm = value and elementMask` MINTS A VALUE WITH NO TYPE — AND EVERY LATER
	// QUESTION ABOUT ITS SIGNEDNESS ANSWERS "SIGNED".** That is not one wrong instruction, it is three, and
	// all three were MEASURED on this tree over two `int(0 to u64.max)` parameters: `imm shr 16` filled with
	// the SIGN (arm64 `asrv`, x64 `sar`, wasm `i64.shr_s`), `imm / 3` divided SIGNED, and `"{imm}"` printed
	// `-1` where the runnable oracle prints `18446744073709551615`. The first of those is what mis-encoded
	// AArch64's own logical-immediate encoder — `arm64EncodeLogicalImm` is exactly this expression, and its
	// `imms` came out 63 (the RESERVED encoding) instead of 47.
	//
	// It reads `denotedAliasId` of each operand rather than the tag column, so an operand that
	// acquired its alias through an `as` cast hands it down too — and an operand that is a merge
	// nothing proved hands down nothing. See `aliasIdClosedUnderBitAnd` for why that door and not the
	// signedness one: the answer is RECORDED, and a recorded alias is spent as a proof.
	//
	// The gate is the BITWISE reading (`tagIsInteger(resultTag)`), not the operator alone: `wordOpResultTag`
	// answers `boolean` for `flagA and flagB`, and a bool carries no ranged-integer identity to inherit.
	function bitAndInheritedAliasId(op MaxonBinOp, lhs ValueId, rhs ValueId, resultTag ValueTypeTag) returns TypeNameId throws MapError
		if op != MaxonBinOp.bitAnd or not tagIsInteger(resultTag) 'notABitwiseAnd'
			throw MapError.keyNotFound
		end 'notABitwiseAnd'

		if let fromLeft = try self.aliasIdClosedUnderBitAnd(lhs) 'theLeftOperandsAlias'
			return fromLeft
		end 'theLeftOperandsAlias'

		return try self.aliasIdClosedUnderBitAnd(rhs)
	end 'bitAndInheritedAliasId'

	// One operand's contribution to the rule above: the alias it declares, WITHHELD unless that alias is
	// closed under `and`. A float alias is withheld too — `and` has no float reading at all, so a `named`
	// float value reaching here would be handing down an identity its own operator does not admit.
	//
	// ⛔⛔ **`valueDenotedAlias`, NOT `domainDeclaringAlias` — WHAT THIS FUNCTION HANDS BACK IS WRITTEN INTO
	// THE RECORDED-ALIAS MAP, AND THAT MAP IS SPENT AS A PROOF.** The two
	// readers of `valueDeclaredAlias` do not carry the same burden: `domainDeclaringAlias` answers a
	// DECLARED-TYPE question (signedness — which instruction the type the program WROTE selects), and it
	// deliberately does NOT withhold a merge nothing proved. `valueDenotedAlias` answers the PROOF question,
	// and withholds one. Reading the declared-type door here and then RECORDING the answer would launder an
	// unproven phi's alias into a recorded-cast alias — which `valueDenotedAlias` takes AHEAD of
	// `provenAliasOfValue`, so the withhold would not merely be bypassed, it would be outranked.
	//
	// MEASURED on this tree, the `a-merged-count-is-not-proven-around-a-loop` program with the count
	// laundered through `and`: `n` is a phi declaring `int(0 to 63)` and holding **71**, and `m = n and 127`
	// holds the SAME 71 — yet `1 shl n` answered the saturated **0** while `1 shl m` answered **128**, the
	// hardware's masked `1 shl 7`. One value, one declared type, two answers, differing only by an `and`
	// that changed nothing. Pinned by `an-and-does-not-launder-an-unproven-merge-into-a-proof`.
	//
	// ⭐ It costs the rule NOTHING it exists for. A parameter is guarded at the callee's entry and a
	// cast site guards its result, so every operand the encoder case is built from — `arm64EncodeLogicalImm`'s
	// `value and elementMask`, and `bitwise-operators.md`'s `andThenShift`/`andThenDivide` — is proven and
	// still hands its alias down. Only a merge nothing proved is withheld, and a withheld operand leaves the
	// `and` result exactly where it is without this rule: a bare `int`.
	function aliasIdClosedUnderBitAnd(value ValueId) returns TypeNameId throws MapError
		let aliasId = try self.denotedAliasId(value)
		let alias = try requireDeclaredAlias(self.castAliasNamedBy(aliasId)) otherwise panic("aliasIdClosedUnderBitAnd: v{value}'s denoted alias id {aliasId} resolves to no alias — denotedAliasId answers only an id castAliasNamedBy resolves")

		if aliasIsFloat(alias) or not rangeIsClosedUnderBitAnd(alias.low) 'notClosedUnderBitAnd'
			throw MapError.keyNotFound
		end 'notClosedUnderBitAnd'

		return aliasId
	end 'aliasIdClosedUnderBitAnd'

	// Fold, when the parser holds both operands — so `x shl 63 + 1` is a count of 64 and not an unknown.
	// RECORDED, not rewritten: the fold's answer lands in the parser's CONSTANT DOMAIN, where diagnostics
	// read it, and the `add` is emitted either way.
	//
	// ⭐⭐ **AND THE Std TIER REWRITES, THROUGH THIS SAME EVALUATOR.** `foldConstants`
	// (`IR/Std/FoldConstants.maxon`) evaluates `const <op> const` and replaces the op — the expressions
	// INLINING makes constant, which this site never sees because at parse time they were parameters. It
	// calls `foldIntBinOp`/`evalShift`/`foldIntCompare` rather than carrying its own arithmetic, and it
	// says at length why: a second answer to "what does `const <op> const` evaluate to" is this project's
	// signature bug.
	//
	// It reads the ORIGINAL ids, not the promoted ones, and it cannot confuse the two: the gate is
	// `tagIsInteger(resultTag)`, and a promotion happens only when the result is a float — so on every path
	// that folds, the promoted operands ARE the originals.
	//
	// ⭐⭐ **IT IS A SHARED METHOD BECAUSE TWO EMIT ROUTES REACH IT, AND A ROUTE THAT LEAVES IT BEHIND LOSES
	// A DIAGNOSTIC.** A `mod` by a constant `-1` does not reach the bare emitter above — it is expanded with
	// the overflow guard — and it is the ONLY constant divisor that does, so a guarded route skipping this
	// fold stops recording a value the constant domain holds: `let z = 10 mod -1` then
	// `try (100 / z) otherwise 7` then COMPILES AND PRINTS 7 where the program is **E3103** ("the divisor of
	// '/' is always 0") — a provable divide-by-zero downgraded to a catchable runtime throw. One emit site,
	// two routes, one fold.
	function recordBinOpFold(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, resultTag ValueTypeTag)
		if not tagIsInteger(resultTag) or not self.constIsKnown(lhs) or not self.constIsKnown(rhs) 'notBothKnown'
			return
		end 'notBothKnown'

		self.recordFold(result, fold: foldIntBinOp(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs)))

		if not self.constIsKnown(result) 'notFolded'
			return
		end 'notFolded'

		self.markUnsignedArithmeticResult(result, lhs: lhs, rhs: rhs, op: op)

		if valueIsMarked(self.bodyState.unsignedPatternValues, value: result) 'anUnsignedFold'
			self.markUnnamedFoldAboveSignedMax(result)
		end 'anUnsignedFold' else 'aSignedFold'
			self.markWrittenNegative(result, value: self.constOf(result))
		end 'aSignedFold'
	end 'recordBinOpFold'

	function recordBitAndMaskRange(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, resultTag ValueTypeTag)
		if op != MaxonBinOp.bitAnd or not tagIsInteger(resultTag) or valueIsMarked(self.bodyState.literalCounters, value: result) 'notAnIntegerMask'
			return
		end 'notAnIntegerMask'

		let mask = try self.bitAndMaskBound(lhs, rhs: rhs) otherwise return
		self.recordResultInterval(result, low: 0, high: mask, provenance: IntervalProvenance.operandRanges)
	end 'recordBitAndMaskRange'

	function bitAndMaskBound(lhs ValueId, rhs ValueId) returns FullRangeInt throws AbsentError
		if let leftMask = try self.nonNegativeConstantOf(lhs) 'leftIsAMask'
			if let rightMask = try self.nonNegativeConstantOf(rhs) 'bothAreMasks'
				return leftMask if leftMask < rightMask else rightMask
			end 'bothAreMasks'

			return leftMask
		end 'leftIsAMask'

		return try self.nonNegativeConstantOf(rhs)
	end 'bitAndMaskBound'

	function nonNegativeConstantOf(value ValueId) returns FullRangeInt throws AbsentError
		if not self.constIsKnown(value) or self.constOf(value) < 0 or self.valueCarriesAnUnsignedPattern(value) 'notAMask'
			throw AbsentError.absent
		end 'notAMask'

		return self.constOf(value)
	end 'nonNegativeConstantOf'

	function recordLiteralRangeOfBinOp(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, resultTag ValueTypeTag)
		if resultTag != ValueTypeTag.integer or self.valueNameId(result) != UnnamedTypeId or self.constIsKnown(result) 'notAPlainComputedInteger'
			return
		end 'notAPlainComputedInteger'

		if not valueIsMarked(self.bodyState.literalCounters, value: lhs) and not valueIsMarked(self.bodyState.literalCounters, value: rhs) 'noCounterInvolved'
			return
		end 'noCounterInvolved'

		let left = try self.literalIntervalOf(lhs) otherwise return
		let right = try self.literalIntervalOf(rhs) otherwise return
		let bounds = try binOpBounds(op, left: left, right: right) otherwise return
		self.recordResultInterval(result, low: bounds.lo, high: bounds.hi, provenance: IntervalProvenance.literalCounters)
	end 'recordLiteralRangeOfBinOp'

	function markLiteralInterval(value ValueId, low FullRangeInt, high FullRangeInt)
		self.recordProvenIntRange(value, low: low, high: high)
		self.bodyState.literalCounters = withValueMarked(self.bodyState.literalCounters, value: value)
	end 'markLiteralInterval'

	function recordLiteralRangeOfMerge(phi ValueId, incoming ValueIdArray)
		if self.tagOf(phi) != ValueTypeTag.integer or self.valueNameId(phi) != UnnamedTypeId 'notAPlainInteger'
			return
		end 'notAPlainInteger'

		let first = try incoming.get(0) otherwise return
		var joined = self.boundsOfValue(first)

		for i in 1 upto incoming.count() 'eachGive'
			let give = try incoming.get(i) otherwise panic("recordLiteralRangeOfMerge: incoming.get OOB at {i}")
			joined = joined.joinedWith(self.boundsOfValue(give))
		end 'eachGive'

		match joined 'state'
			integers(low, high) then self.recordResultInterval(phi, low: low, high: high, provenance: IntervalProvenance.literalCounters)
			unsignedIntegers(low, high) then self.markUnsignedBounds(phi, low: low, high: high)
			unknown or
			floats then return
		end 'state'
	end 'recordLiteralRangeOfMerge'

	function constantIntervalOf(value ValueId) returns Interval throws AbsentError
		if not self.constIsKnown(value) or valueIsMarked(self.bodyState.unsignedMaxLiterals, value: value) or valueIsMarked(self.bodyState.unsignedPatternValues, value: value) 'notASignedConstant'
			throw AbsentError.absent
		end 'notASignedConstant'

		let interval = Interval.create()
		interval.setBounds(self.constOf(value), high: self.constOf(value))
		return interval
	end 'constantIntervalOf'

	function literalIntervalOf(value ValueId) returns Interval throws AbsentError
		if self.tagOf(value) != ValueTypeTag.integer or self.valueNameId(value) != UnnamedTypeId 'notAPlainNumber'
			throw AbsentError.absent
		end 'notAPlainNumber'

		if let constant = try self.constantIntervalOf(value) 'aConstant'
			return constant
		end 'aConstant'

		return try self.counterIntervalOf(value)
	end 'literalIntervalOf'

	function counterIntervalOf(value ValueId) returns Interval throws AbsentError
		if not valueIsMarked(self.bodyState.literalCounters, value: value) 'nothingKnown'
			throw AbsentError.absent
		end 'nothingKnown'

		return try self.provenIntervalOf(value)
	end 'counterIntervalOf'

	function provenIntervalOf(value ValueId) returns Interval throws AbsentError
		let proven = try provenIntRangeOf(self.bodyState.countedValueRanges, value: value) otherwise throw AbsentError.absent

		if rangeIsUnsignedTopped(proven.low, high: proven.high) 'notASignedInterval'
			throw AbsentError.absent
		end 'notASignedInterval'

		let interval = Interval.create()
		interval.setBounds(proven.low, high: proven.high)
		return interval
	end 'provenIntervalOf'

	function markUnnamedFoldAboveSignedMax(result ValueId)
		if self.tagOf(result) != ValueTypeTag.integer or self.constOf(result) >= 0 'namedOrWithinTheSignedRange'
			return
		end 'namedOrWithinTheSignedRange'

		self.markAboveSignedMax(result)
	end 'markUnnamedFoldAboveSignedMax'

	// One operand of a binary op or comparison, moved into the float domain if the PAIR meets
	// there. Takes both tags because promotion is a property of the pair, not of the operand —
	// `5` stays an int in `5 + 3` and becomes an f64 in `5 + 2.0`, and only the other side says
	// which.
	//
	// Both operands go through it unconditionally, and `promoteToFloat` is idempotent, so the
	// already-float side costs nothing and no caller has to work out which side to convert.
	function promotedOperand(value ValueId, left ValueTypeTag, right ValueTypeTag, opTok Token) returns ValueId
		if not operandsAreFloat(left, right: right) 'integral'
			return value
		end 'integral'

		return self.promoteToFloat(value, opTok: opTok)
	end 'promotedOperand'

	// Move a value into the float domain — the int→f64 half of the implicit-conversion lattice.
	// `TypeRules.arithResultTag` states the TYPE rule; this emits the INSTRUCTION that makes it true
	// (`cvtsi2sd`, via `MaxonUnaryOp.promoteToFloat`) — or `promoteUnsignedToFloat` for a value that
	// may hold a pattern above `i64.max`, which a signed conversion reads as a negative number.
	//
	// A value already there is returned untouched, which is what makes it idempotent — and it is
	// also what keeps `siToFp` from ever naming a float→float conversion (`lowerUnaryOp`'s
	// `assertConversionCrossesDomain` is the backstop that says so).
	//
	// Promotion happens in the PARSER, off the `valueTags` column already kept for the word operators,
	// rather than during LOWERING off a second `isFloat` side-map. Same op, same place in the value
	// graph, one type oracle instead of two.
	function promoteToFloat(value ValueId, opTok Token) returns ValueId
		// ⚠⚠ **THE ENUM DECODE COMES FIRST, AND SKIPPING IT IS A SILENT WRONG ANSWER BY ~300 ORDERS OF
		// MAGNITUDE.** A float-backed enum value is an f64 already — in the WRONG REGISTER FILE — so the
		// move into the float domain is a reinterpretation, never the `cvtsi2sd` below. This is the same
		// hazard `coerceToDeclared` PANICS against for an unlifted ranged float alias; an enum cannot take
		// that cure (its value must stay a GPR i64 for `match`), so it takes this one.
		let number = self.floatBehindEnumValue(value, anchor: opTok)

		if tagIsFloat(self.tagOf(number)) 'alreadyFloat'
			return number
		end 'alreadyFloat'

		let unsigned = self.valueConvertsAsUnsigned(number)
		let conversion = MaxonUnaryOp.promoteUnsignedToFloat if unsigned else MaxonUnaryOp.promoteToFloat
		let promoted = self.emitUnaryOp(number, op: conversion, resultTag: ValueTypeTag.float, range: SourceRange.ofToken(opTok))

		if self.constIsKnown(number) 'aKnownConstant'
			self.recordFloatConst(promoted, bits: self.foldLiteralToFloatBits(number))
		end 'aKnownConstant' else if not unsigned 'aBoundedInteger'
			self.recordPromotedIntegerRange(promoted, source: number)
		end 'aBoundedInteger'

		return promoted
	end 'promoteToFloat'

	function valueConvertsAsUnsigned(value ValueId) returns bool
		return valueIsMarked(self.bodyState.unsignedPatternValues, value: value) or self.operandReachesAboveSignedMax(value)
	end 'valueConvertsAsUnsigned'

	// ⭐⭐ **THE ONE DOOR EVERY SITE THAT READS A FLOAT-BACKED ENUM AS A NUMBER GOES THROUGH.** The
	// value is an i64 carrying the f64's IEEE-754 bits (`EnumLayout`'s header states why the representation
	// is uniform), so the read is a `movq xmm, r64` REINTERPRETATION — `MaxonUnaryOp.bitsToFloat`, the same
	// op `emitContainerElementAccessor` reads a float array element back through. Any other value passes
	// through untouched, which is what lets a caller apply it unconditionally.
	//
	// ⚠ **IT IS A DECODE, NOT A PROMOTION, AND THE TWO ARE NOT INTERCHANGEABLE.** `promoteToFloat`'s
	// `cvtsi2sd` reads the operand as a MAGNITUDE: applied to `light = 2.5`'s bits it answers
	// 4612811918334231000.0. MEASURED without this door, all four silently: `"{w}"` printed
	// `4612811918334230528`; `Weight.light * scale` and `Weight.light + Weight.heavy` multiplied and added
	// bit patterns; `takesFloat(Weight.light)` widened the encoding; and `below < mid` ordered `-2.2`
	// against `-1.1` BACKWARDS, because a negative double's bits do not order like the double.
	//
	// ⚠ **THE `==`/`!=` OF ONE ENUM DELIBERATELY DOES NOT COME HERE** — an enum's equality is its IDENTITY,
	// answered by the i64 tag compare that `match` dispatch uses, and routing it through a float compare
	// would make `SignedZero.negz == SignedZero.posz` disagree with `match negz` (`enums-simple.md`'s
	// `float-backed-signed-zero` pins that single equality). See `emitCompare`'s gate.
	function floatBehindEnumValue(value ValueId, anchor Token) returns ValueId
		if not self.valueIsFloatBackedEnum(value) 'notAFloatBackedEnum'
			return value
		end 'notAFloatBackedEnum'

		return self.emitUnaryOp(value, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: SourceRange.ofToken(anchor))
	end 'floatBehindEnumValue'

	// ⭐ **THE TAG OF THE NUMBER BEHIND A VALUE — the question every OPERAND RULE asks, and the one
	// `tagOf` cannot answer for a float-backed enum.** The value's own tag is `named` and its register file
	// is a GPR, both truthfully; what the rule needs to know is the DOMAIN the operator will work in, and
	// for a float-backed enum that is `float`. A union has no number behind it, so it answers `structRef`
	// and every operand rule refuses it as it refuses a struct; `tagOf`'s `named` would admit a union's
	// tag or box address as an integer.
	//
	// ⚠ **IT IS SPLIT FROM `floatBehindEnumValue` SO THE RULE CAN BE ASKED WITHOUT EMITTING** — a refused
	// program must leave no ops behind (`emitShift`'s header), and a decode placed before the verdict would
	// leave a stray `bitsToFloat` in the block of every program rejected for its operands. Same split, same
	// reason, as `rangedAliasResolvedTag` beside `promoteToFloat`.
	function numberTagOf(value ValueId) returns ValueTypeTag
		let tag = self.tagOf(value)

		if tag != ValueTypeTag.named 'notNamed'
			return tag
		end 'notNamed'

		return self.signatures.enumOperandTagFor(self.valueTypeName(value), readerFilePath: self.job.path)
	end 'numberTagOf'

	// Is `value` a FLOAT-BACKED enum's value — `valueIsUnion`'s twin, answered through `numberTagOf` for the
	// same allocation reason: the `named` test is what tells it from a plain `float`, which `numberTagOf`
	// also answers `float` for.
	function valueIsFloatBackedEnum(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.named and self.numberTagOf(value) == ValueTypeTag.float
	end 'valueIsFloatBackedEnum'

	// Append a `unaryOp` op over one SSA value; return the ValueId it defines. The source
	// range anchors on the operator token, mirroring emitBinOp.
	function emitUnaryOp(operand ValueId, op MaxonUnaryOp, resultTag ValueTypeTag, range SourceRange) returns ValueId
		let result = self.mintValue(resultTag, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.unaryOp(result, operand: operand, op: op), range: range)

		// `-1` is `neg` of the literal 1, not a negative literal — so without this arm the parser
		// could not see the count in `x shl -1` at all.
		if tagIsInteger(resultTag) and self.constIsKnown(operand) 'known'
			self.recordFold(result, fold: foldIntUnaryOp(op, operand: self.constOf(operand)))
		end 'known' else if tagIsBool(resultTag) and op == MaxonUnaryOp.logicalNot and self.constIsKnown(operand) 'knownBool'
			self.recordConst(result, folded: foldLogicalNot(self.constOf(operand)))
		end 'knownBool'

		return result
	end 'emitUnaryOp'

	// Append a `compare` op over two SSA values; return the BOOLEAN ValueId it defines.
	// Mirrors emitBinOp but emits the distinct comparison variant (a comparison is not a
	// `binOp` — see MaxonCmpOp). The source range anchors on the comparison operator.
	//
	// A comparison is STRICT IN BOTH ITS CLASS AND ITS DOMAIN — `TypeRules.comparableOperands`,
	// which is a third question and not `typesAgree`. Two bools compare fine (`a == b`); two ints
	// compare; two floats compare. A MIXTURE does not, in either of the two ways a pair can be
	// mixed:
	//
	//   • a bool against a number — the only thing there is to compare is the bool's 0/1 payload,
	//     which is not what the source wrote: `4 < flag` is `4 < 1`, i.e. always false. Comparisons
	//     are category-strict: both sides must land in the same class.
	//
	//   • ⭐ an int against a FLOAT — and this one is the rule that ARITHMETIC does not share.
	//     `5 + 2.0` promotes and is 7.0; `f > i` is E3005 (specs/contextual-literal-typing.md,
	//     four cases). A promotion inside a comparison would be INVISIBLE — the result is a bool
	//     either way, so nothing in the program would show that the int had been converted, and
	//     `3.5 > i` would silently answer a question about `3.5 > 2.0` nobody asked.
	//
	// ⚠ THIS FUNCTION DOES NOT PROMOTE. The promotion built for `emitBinOp` does not belong here, although a compare's
	// operands look like a binOp's. They are not: one produces a number, the other a verdict.
	// ⭐⭐ **THE TWO QUESTIONS THAT COME BEFORE "ARE THESE OPERANDS COMPARABLE?"** — one refusal and one
	// coercion, both about what an ENUM value means at a comparison, and both settled here so the rules
	// below see operands that are already in one domain.
	function emitCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws SourceParseError
		// E3097, asked at the TOP — ahead of the byte-record interception below, so the `.name` (String)
		// spelling is refused by the same line as the `.ordinal` (integer) one rather than by a second rule
		// on the other side of a fork. See `requireNotAnEnumAccessorComparison`.
		if op == MaxonCmpOp.eq or op == MaxonCmpOp.ne 'aCaseTestSpelling'
			try self.requireNotAnEnumAccessorComparison(lhs, rhs: rhs, opTok: opTok)
		end 'aCaseTestSpelling'

		// ⚠ **THE SECOND COERCION IS ASKED AGAINST THE FIRST'S ANSWER**, so `ContentType.json == ct` and
		// `ct == ContentType.json` reach the compare identically. Only one side can ever move: a case
		// coerced against a byte record leaves a byte record behind, and the other side was one already.
		let left = try self.enumCaseAtItsBacking(lhs, against: self.tagOf(rhs), opTok: opTok)
		let verdict = try self.emitComparableCompare(left, rhs: try self.enumCaseAtItsBacking(rhs, against: self.tagOf(left), opTok: opTok), op: op, opTok: opTok)

		// Unconditional, unlike `dischargeHandedBack`: E3187 forbids an `equals` or `compare` that writes or
		// keeps either operand, so the verdict holds nothing of a handed-back region.
		self.withdrawHandedBack(twoArgs(lhs, second: rhs))
		return verdict
	end 'emitCompare'

	// ⭐⭐ **A CHAR- OR STRING-BACKED ENUM CASE COMPARES AT ITS RAW VALUE.** For an INT-backed enum the tag
	// IS the raw value, so `n == HttpStatus.ok` needs nothing and gets nothing; for these two backings the
	// tag is a declaration index and the raw value lives in a COLUMN, so the case has to be read before the
	// two sides are in one domain at all. Without it `ct == ContentType.json` is *"cannot compare String
	// with int"* — a sentence naming an int the program does not contain.
	//
	// ⚠ **ONLY AGAINST AN OPERAND OF THE BACKING'S OWN TYPE.** Two cases of one enum compared with each
	// other is a CASE TEST and stays one — coercing there would compare two raw values to answer the same
	// question more slowly, and against any other type it would invent a comparison the language has not got.
	//
	// ⚠ It reaches `emitEnumRawValue` and NOT the accessor door, so the value it mints carries no E3097
	// taint: the author wrote no accessor, and marking one here would refuse the comparison this exists to
	// admit.
	function enumCaseAtItsBacking(value ValueId, against ValueTypeTag, opTok Token) returns ValueId throws SourceParseError
		// The tag pre-check is the hot-path allocation guard `valueIsUnion` documents: `enumMatchFor`
		// returns a union VALUE, so asking it for the `int`/`bool` operands of every comparison in the
		// program would allocate two throwaway boxes per compare.
		if self.tagOf(value) != ValueTypeTag.named or not tagIsByteRecord(against) 'notTheShape'
			return value
		end 'notTheShape'

		match self.enumMatchFor(value) 'declared'
			undeclared then return value
			declared(layout) then return try self.enumCaseRawValueAgainst(layout, value: value, against: against, opTok: opTok)
		end 'declared'
	end 'enumCaseAtItsBacking'

	// The arm above with a layout in hand — a `match` arm is one statement and this is a test and an emit.
	function enumCaseRawValueAgainst(layout EnumLayout, value ValueId, against ValueTypeTag, opTok Token) returns ValueId throws SourceParseError
		if not enumBackingProduces(layout.backing, tag: against) 'aDifferentDomain'
			return value
		end 'aDifferentDomain'

		let range = SourceRange.ofToken(opTok)
		return try self.emitEnumRawValue(layout, tag: try self.emitEnumTagOf(value, layout: layout, anchor: opTok, range: range, reach: EnumTagReach.written), anchor: opTok, range: range)
	end 'enumCaseRawValueAgainst'

	function emitComparableCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws SourceParseError
		let leftTag = self.tagOf(lhs)
		let rightTag = self.tagOf(rhs)

		// ⭐ A BYTE RECORD'S `==`/`!=` IS A RUNTIME BYTE COMPARE, not a `compare` op (which would compare two
		// box POINTERS — reference equality answering a question about VALUES). Handled at the TOP, before
		// `comparableOperands`: a matching STRING pair does not `comparableOperands` at all (that rule
		// governs ORDERING, which a String has none of), so it must be intercepted here or it would be
		// rejected as a mismatch — and a matching CHARACTER pair, which DOES `comparableOperands`,
		// must be intercepted for the opposite reason: it would otherwise fall through to the raw
		// `MaxonOp.compare` below and order two clusters by their ADDRESSES. A byte-record-vs-anything-else
		// pair falls through to the mismatch gate below — a clean type error, not a crash.
		//
		// ⚠ **`leftTag == rightTag` IS THE HALF THAT KEEPS A STRING AND A CHARACTER APART, AND WITHOUT IT
		// THIS IS A SILENT WRONG ANSWER.** They share a record, so `__str_eq` would happily compare a
		// one-cluster String against a Character and report `true` for two values whose TYPES disagree —
		// admitting `s == c` to the language through the back door, where every other rule refuses it
		// (`typeClassOf` gives them different classes precisely so it is E3005). The equality of the two tags
		// is what makes the interception a rule about ONE type at a time.
		//
		// ⚠ It is spelled `tagIsByteRecord(leftTag) and leftTag == rightTag` rather than testing each side,
		// because the property being asserted is "both operands are the SAME byte-record type" — one
		// sentence, not two that a later edit could widen independently.
		if tagIsByteRecord(leftTag) and leftTag == rightTag 'byteRecordCompare'
			return self.emitByteRecordCompare(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'byteRecordCompare'

		// ⭐⭐ **A `StringIndex` COMPARES BY ITS GRAPHEME INDEX, AND ONLY BY THAT** —
		// `stdlib/String.maxon:947-964`'s `equals`/`compare` read `charIdx` and never `bytePosition`, so
		// this follows a stated rule rather than taking a shortcut. Handled at the TOP, beside the
		// byte-record arm and before every rule below, because those rules would answer WRONGLY rather
		// than not at all: two `structRef`s reach `comparableOperands`, which refuses them — so
		// `idx2 == s.endIndex()`, the commonest thing there is to do
		// with an index and the one `string-type/find` pins, would be a type error against a perfectly
		// good program.
		//
		// ⚠ **A GENERAL STRUCT `==` WOULD NOT HAVE SERVED, AND WOULD HAVE BEEN WRONG.** Whatever shape it
		// took — a box-pointer compare or a memberwise one — it could not give this answer: two indices
		// carrying the same `charIdx` are equal here even when their `bytePosition`s differ, which is
		// precisely what an index into a DIFFERENT string can do. The type declares `equals` for a reason,
		// and that reason is that its two fields do not both carry identity.
		//
		// ⭐ ALL SIX operators route here, not just `==`/`!=`: the type declares `implements Equatable,
		// Comparable` and its `compare` orders by the same one field, so `<` on two indices is a real
		// question with the same answer shape. Restricting to equality would need a bespoke rejection for
		// four operators the type genuinely has — vocabulary WITHHELD from its consumer, which is the
		// opposite error to shipping it ahead of one.
		//
		// ⚠ Spelled as BOTH operands rather than either, exactly as the byte-record arm above is: the
		// property is "both sides are indices". An index against anything else falls through to the
		// mismatch gate below — a clean type error, not a compare of one field against a whole box.
		if self.valueIsStringIndex(lhs) and self.valueIsStringIndex(rhs) 'stringIndexCompare'
			return try self.emitStringIndexCompare(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'stringIndexCompare'

		// ⭐ A `union` VALUE HAS NO COMPARISON — of ANY kind (E3066). Refused BEFORE `comparableOperands`,
		// which would pass a `named`-vs-`named` pair (they agree) and lower to a compare of two BOX
		// ADDRESSES — the same reference-equality wrong answer that rule already refuses for two structs.
		// `==`/`!=` have no synthesized equality; `<`/`>`/`<=`/`>=` a fortiori have no meaning either, so
		// ALL of them reject here (the message names whichever operator the author wrote). An ENUM's value
		// IS its i64 tag, so `Color.red == c` is a real tag compare and stays legal; only a `union`
		// (`isUnion`) is rejected. The match dispatch (`emitCompareAgainstLiteral`) builds its tag compare with
		// its own `MaxonOp.compare` and never routes through here, so a `match` arm is unaffected.
		if self.valueIsUnion(lhs) or self.valueIsUnion(rhs) 'unionCompare'
			throw SourceParseError.unionNotComparable(comparisonOpSpelling(op), line: opTok.line, column: opTok.column)
		end 'unionCompare'

		// ⭐ **EVERY COMPARISON ON AN ENCLOSING (opaque) TYPE PARAMETER dispatches through a witness** — `==`/`!=`
		// through `Equatable.equals`, `<`/`>`/`<=`/`>=` through `Comparable.compare`
		// — the SAME tables `<T>.equals()` / `<T>.compare()` use. Inside the shared body `T`'s concrete
		// type is unknown, so a scalar `compare` would compare two opaque WORDS: right for an `int` by luck, a
		// POINTER compare for a struct `T` (a silent wrong answer). An UNCONSTRAINED enclosing `T` has no witness
		// and is E3005.
		//
		// ⚠ ALL SIX operators are gated, and the ordering half is why: ungated, `<` on a type parameter
		// would fall straight past here to the raw `MaxonOp.compare` below, because `typeClassesAgree` lets a
		// `typeParameter` agree with anything (TypeRules) — the same pointer-compare wrong answer the equality
		// half already refuses, reachable the moment anything can conform to `Comparable`.
		// ⚠ Only a value of an ENCLOSING type parameter opts in: a `typeParameter`-tagged value in a NON-generic
		// caller is a concrete generic-method result (`let v = intBox.get()`) whose real type IS known (`int`) —
		// it must stay a scalar compare (`isEnclosingTypeParam` is false there, so it falls through to
		// `comparableOperands`).
		if self.isEnclosingTypeParam(lhs) or self.isEnclosingTypeParam(rhs) 'typeParamComparison'
			return try self.emitTypeParamComparison(lhs, rhs: rhs, op: op, opTok: opTok, leftIsParam: self.isEnclosingTypeParam(lhs))
		end 'typeParamComparison'

		// ⭐⭐ **`a == b` ON TWO VALUES OF ONE USER STRUCT DISPATCHES ITS OWN `equals`.**
		// Without this, `comparableOperands` would refuse the pair for a program the oracle compiles and
		// runs; `specs/filepath.md`'s `filepath-equality` /
		// `filepath-inequality` are the corpus cases that reach it, and `FilePath.equals` is the
		// `equals` they mean to run (case-insensitive on Windows, so a POINTER compare or a memberwise one
		// would both be the WRONG ANSWER, not merely a different one).
		//
		// ⚠ **THE RULE IS "HAS AN `equals` METHOD", NOT "DECLARES `implements Equatable`" — MEASURED AGAINST
		// THE ORACLE, one program each.** A struct with an `equals` and NO conformance clause compiles and
		// prints `equal`; it is exactly the rule `materializeStructToStringPart` already states for
		// interpolation (`toString` by NAME, not by `Stringable`), and stating it the other way would refuse
		// a legal program. It is also why this needs no site record: unlike `<Type> from "…"`, whose oracle
		// DOES demand the conformance (E3005, measured), the question here is answerable from the
		// whole-program signature index at the cursor, order-independently.
		//
		// ⚠ **ORDERING ASKS A DIFFERENT METHOD.** `<`/`>`/`<=`/`>=` on two structs dispatch to the type's
		// `compare` (`structComparisonMethodName`), whose `Ordering` verdict `emitOrderingVerdict` reads,
		// and a type that declares no `compare` stays the E3005 below; answering the four operators
		// through `equals` would silently turn them into an EQUALITY test. `!=` is the negation of the
		// same call, built from it, so the two can never come to disagree about what equality means —
		// `emitByteRecordCompare`'s rule.
		if self.structComparisonOperands(lhs, rhs: rhs, op: op) 'structComparison'
			return try self.emitStructComparisonCall(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'structComparison'

		// ⭐⭐ **`a == b` ON TWO ARRAYS IS A CONTENT COMPARE; A REFERENCE COMPARE WOULD BE A SILENT WRONG
		// ANSWER.** Two `genericInstance` operands AGREE and are neither float, so they would fall straight through
		// to the raw `MaxonOp.compare` below — an integer compare of two RECORD ADDRESSES. MEASURED on
		// `let a = [1, 2, 3]` beside `let b = [1, 2, 3]`: `a == b` answered **false** and `a != b` **true**,
		// for two arrays whose contents are identical. It is exactly the reference-identity hazard
		// `comparableOperands` already refuses for two structs and two existentials, except that here it
		// COMPILES, so nothing says so.
		//
		// ⚠ **THE FIX IS A DISPATCH, NOT A REFUSAL, and that is what separates this case from those
		// two.** A struct has no synthesized structural equality and an existential cannot prove its two
		// dynamic types match, so both are refused; an `Array` DECLARES `equals` (conditionally on its
		// element). `!=` is that same call negated, built from it, so the two operators can never come to
		// disagree — `emitByteRecordCompare`'s rule.
		//
		// ⚠ **ONLY `Array` INSTANCES, AND ONLY EQUALITY.** A `Set`/`Map`/`List`/user-generic pair keeps
		// the fall-through, because none of them has an `equals` for this to reach; ordering has no
		// `equals` reading at all (`stdlib/Array.maxon` declares no `Comparable`), so `<`/`>`/`<=`/`>=` on
		// two arrays stay the E3005 below.
		if self.arrayEqualityOperands(lhs, rhs: rhs, op: op) 'arrayEquality'
			return try self.emitArrayEqualityCall(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'arrayEquality'

		// ⭐⭐ **A COMPARISON OF TWO EXISTENTIALS IS REFUSED WITH ITS OWN REASON, NOT WITH "cannot compare
		// Comparable with Comparable".** `comparableOperands` already returns false for the pair (see there for
		// the measured wrong answers), so this changes no verdict — it changes what the author is told. The
		// generic mismatch message names the two tags, which for a pair of existentials reads as though the
		// types disagree when in fact they agree perfectly and the OPERATION is what has no meaning. Asked
		// before that message for the same reason `unionNotComparable` is.
		//
		// ⚠ The predicate is BOTH-operands, and `comparableOperands` asks the SAME one — spelled `or` there and
		// `and` here they are two spellings of one fact, agreeing only because `typesAgree` runs first.
		// A MIXED pair (an existential against an `int`) really is a type mismatch and keeps the
		// message below, which names the two tags.
		if operandsAreInterfaceRef(leftTag, right: rightTag) 'existentialComparison'
			throw SourceParseError.existentialNotComparable(comparisonOpSpelling(op), line: opTok.line, column: opTok.column)
		end 'existentialComparison'

		if leftTag == ValueTypeTag.genericInstance and rightTag == ValueTypeTag.genericInstance 'genericInstanceComparison'
			try self.requireSameInstanceToCompare(lhs, rhs: rhs, opTok: opTok)
			throw SourceParseError.genericInstanceNotComparable(comparisonOpSpelling(op), typeName: String.from(self.signatures.instanceDisplayName(self.valueInstanceId(lhs))), orderingOp: not comparisonIsEquality(op), line: opTok.line, column: opTok.column)
		end 'genericInstanceComparison'

		// ⭐⭐ **A FLOAT-BACKED ENUM IS COMPARED AS ITS NUMBER — EXCEPT WHERE THE COMPARISON IS AN IDENTITY
		// TEST.** Everything else here is exact for an enum already, because an enum value IS its i64
		// tag; this is the one question the tag cannot answer, and it splits by operator:
		//
		//   • ORDERING (`<`/`>`/`<=`/`>=`) has no identity reading at all, so it is always the number.
		//     MEASURED without this arm, on `below = -2.2` and `mid = -1.1`: The compiler answered `below < mid`
		//     FALSE, because a negative double's bit pattern does not order like the double. The oracle
		//     answers true. A bit-pattern order that happens to agree for POSITIVE cases is exactly why
		//     `enum-match-exhaustive`'s float-backed case passes under both readings and pins neither.
		//   • EQUALITY between two values of ONE enum stays the TAG compare, and that is not a concession:
		//     `x == Type.case` is the language's way of asking which CASE a value is, and it must agree
		//     with `match`, whose dispatch is an i64 compare (`emitCompareAgainstLiteral`). Routing it through
		//     `ucomisd` would make `SignedZero.negz == SignedZero.posz` TRUE while `match negz` selects
		//     `negz` — `enums-simple.md`'s `float-backed-signed-zero` pins that single equality.
		//   • EQUALITY against anything else (`w == 2.5`) names no case, so it is the number, which is what
		//     lets the oracle's `w == 2.5` compile here too.
		//
		// ⚠ The VERDICT is asked of the number TAGS and the decode is paid only past it, so a comparison
		// rejected for its operands still leaves no ops behind — `emitBinOp`'s split, for its reason. The
		// message names those same tags, so a refused float-backed enum reads "cannot compare float with
		// bool" rather than the `int` `typeTagName` prints for every `named`.
		let identityEquality = comparisonIsEquality(op) and leftTag == ValueTypeTag.named and self.valueNameId(lhs) == self.valueNameId(rhs)
		let leftNumberTag = leftTag if identityEquality else self.numberTagOf(lhs)
		let rightNumberTag = rightTag if identityEquality else self.numberTagOf(rhs)

		if not comparableOperands(leftNumberTag, right: rightNumberTag) 'mismatch'
			throw SourceParseError.comparisonTypeMismatch(self.valueKindWordAt(lhs, tag: leftNumberTag), right: self.valueKindWordAt(rhs, tag: rightNumberTag), line: opTok.line, column: opTok.column)
		end 'mismatch'

		// ⭐ **A COMPARISON IS A QUESTION ABOUT TWO VALUES OF ONE TYPE**, so the nominal rule binds it exactly
		// as it binds `+`: `a < y` over two different typealiases is refused, and `as` is the door. Asked
		// after the class rule so a genuine tag mismatch keeps its own wording, and above the emit so a
		// rejected program leaves no ops behind. The identity itself is spent on the result, where
		// `adoptOperandAlias` no-ops — a `bool` wears no ranged-integer alias.
		let comparedAlias = try self.operandAliasIdentity(lhs, rhs: rhs, opName: comparisonOpSpelling(op), opTok: opTok)

		let left = lhs if identityEquality else self.floatBehindEnumValue(lhs, anchor: opTok)
		let right = rhs if identityEquality else self.floatBehindEnumValue(rhs, anchor: opTok)

		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		let signedness = self.comparisonSignedness(left, rhs: right, op: op, leftTag: leftNumberTag, rightTag: rightNumberTag)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.compare(result, lhs: left, rhs: right, op: op, signedness: signedness), range: SourceRange.ofToken(opTok))
		self.adoptOperandAlias(result, alias: comparedAlias, resultTag: ValueTypeTag.boolean)
		self.recordCompareFold(result, lhs: left, rhs: right, op: op, signedness: signedness)
		self.recordComparisonOrders(result, lhs: left, rhs: right, op: op, signedness: signedness)
		return result
	end 'emitComparableCompare'

	function recordCompareFold(result ValueId, lhs ValueId, rhs ValueId, op MaxonCmpOp, signedness IntegerSignedness)
		if self.floatConstIsKnown(lhs) and self.floatConstIsKnown(rhs) 'floatOperands'
			self.recordConst(result, folded: foldFloatCompare(op, lhs: self.floatConstBitsOf(lhs), rhs: self.floatConstBitsOf(rhs)))
		end 'floatOperands' else if self.constIsKnown(lhs) and self.constIsKnown(rhs) 'integerOperands'
			let folded = foldIntCompare(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs)) if signedness == IntegerSignedness.signed else foldUnsignedIntCompare(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs))
			self.recordConst(result, folded: folded)
		end 'integerOperands'
	end 'recordCompareFold'

	// ⭐⭐ **DOES THIS SOURCE COMPARISON RUN UNSIGNED?** — the parser's half of `TypeRules`' ⭐⭐ THE
	// ORDERING-COMPARISON SIGNEDNESS RULE, and the exact shape of `divisionRunsUnsigned` one operator
	// family over: it reads each operand's domain and hands the PAIR to the rule, which is stated once,
	// there, over `IntegerValueDomain` alone.
	//
	// ⚠ **TWO GATES COME FIRST, AND NEITHER IS A SHORTCUT.**
	//
	//   • FLOAT. `ucomisd` has no signedness at all — it answers in ZF/PF/CF whatever the operands are —
	//     and a float compare ALREADY uses the unsigned condition family for that reason
	//     (`floatCondCodeForPred`). Asking the integer question of it would be asking which of two
	//     readings a comparison has when it has one; `unsignedStdTypeOf` panics on a float precisely so
	//     a future edit that dropped this gate is a loud failure rather than a wrong condition code.
	//     Asked through `operandsAreFloat`, the same predicate `divisionRunsUnsigned` uses.
	//   • ORDERING. `==`/`!=` read ZF alone, which `cmp` writes identically in both readings, so they
	//     are already right at every value. See the rule's ⚠⚠ note.
	//
	// ⚠ **IT ASKS THE NUMBER TAGS, NOT THE RAW ONES, and that is `emitCompare`'s own float-backed-enum
	// split arriving here.** By this point a float-backed enum operand has been decoded to its number
	// (`floatBehindEnumValue`), so the tag that says whether this pair meets in the float domain is the
	// NUMBER tag the caller already computed — the same pair it type-checked with. Reading the raw tags
	// would ask about a `named` enum value that no longer reaches the compare.
	function comparisonSignedness(lhs ValueId, rhs ValueId, op MaxonCmpOp, leftTag ValueTypeTag, rightTag ValueTypeTag) returns IntegerSignedness
		if operandsAreFloat(leftTag, right: rightTag) 'floatCompare'
			return IntegerSignedness.signed
		end 'floatCompare'

		if not comparisonReadsOrdering(op) 'equalityReadsOneFlag'
			return IntegerSignedness.signed
		end 'equalityReadsOneFlag'

		if not comparisonOperandsAreUnsigned(self.integerValueDomain(lhs), right: self.integerValueDomain(rhs)) 'signedReading'
			return IntegerSignedness.signed
		end 'signedReading'

		if not self.operandReachesAboveSignedMax(lhs) and not self.operandReachesAboveSignedMax(rhs) 'bothReadingsAgree'
			return IntegerSignedness.signed
		end 'bothReadingsAgree'

		return IntegerSignedness.unsigned
	end 'comparisonSignedness'

	// ⭐⭐ **CAN THE TWO READINGS ACTUALLY DISAGREE HERE?** — the last gate `comparisonSignedness` asks,
	// and the one that keeps this rule off every comparison whose answer it would not change. `jl` and
	// `jb` order every value below `i64.max` identically, so unless SOME operand can hold a value above
	// it the two readings agree everywhere the pair can reach and the signed instruction is already
	// right. That is what keeps `int(0 to 100) < int(0 to 100)` on `jl`.
	//
	// ⚠ **THIS GATE BELIEVES THE DECLARATION, AND THE DECLARATION IS TRUE.** Every stdlib alias that
	// would carry a negative sentinel is narrowed to a range it actually keeps — `Map.findSlot` THROWS
	// instead of encoding a miss — so a value outside one is refused at that alias's own door
	// (`Range check failed: value outside typealias 'X'`) instead of arriving intact. The aliases that
	// are raw PATTERNS instead are rostered at `stdlib/Builtins.maxon`, with the `grep` that keeps the
	// roster honest, and none of them has a negative to decode. ⚠ The COUNT of them is deliberately
	// not repeated here: it is the roster written twice, and the copy over here goes stale first. A
	// sentinel is written in a range that ADMITS it (`int(-1 to 4095)`), and this rule reads that
	// admission as the operand itself refusing the unsigned reading — which is
	// `comparisonOperandsAreUnsigned`'s job, one gate earlier, rather than a guess made from a
	// constant.
	//
	// Only two things can say a value above `i64.max` is reachable: a DECLARED range whose upper bound
	// has wrapped past it (`rangeIsUnsignedTopped`), and an integer the source wrote above it
	// (`unsignedMaxLiterals` — a constant whose stored pattern is negative and whose value is not).
	function operandReachesAboveSignedMax(value ValueId) returns bool
		if valueIsMarked(self.bodyState.unsignedMaxLiterals, value: value) 'theUnsignedExtreme'
			return true
		end 'theUnsignedExtreme'

		match self.domainDeclaringAlias(value) 'declaredType'
			declared(alias) then return rangeIsUnsignedTopped(alias.low, high: alias.high)
			undeclared then return false
		end 'declaredType'
	end 'operandReachesAboveSignedMax'

	// ⭐⭐ **`a is b` / `a is not b` — DO THESE TWO NAMES DENOTE ONE OBJECT?** (`specs/reference-identity.md`.)
	// The deliberate opposite of `emitCompare`: that one answers about CONTENTS and dispatches a type's own
	// `equals`, this one compares the two POINTERS and dispatches nothing. So it is a sibling of `emitCompare`
	// rather than an arm of it — routing `is` through that function would have to bypass, in order, the
	// byte-record compare, the `StringIndex` compare, the struct-`equals` dispatch and the `Array`-`equals`
	// dispatch, i.e. every arm that function has.
	//
	// ⭐ **WHAT IS COMPARED IS THE VALUE'S OWN WORD, WHICH FOR EVERY ADMITTED TAG IS THE OBJECT'S ADDRESS:**
	// a struct's `__mm_alloc`'d box, a generic instance's record, and — for a `String` and a `Character` — the
	// address of the 56-byte FUSED RECORD, not of the `buffer@0` it points at. The record is the object: two
	// String records legitimately SHARE one buffer (a view carries its source in `parent@32`), so a buffer
	// compare would report a substring and its source as the same object. That the value in the register
	// already IS that address is what makes this one `MaxonOp.compare`, with no load anywhere: there is one
	// spelling of a `String`, so `s is s` cannot come out unequal through two routes to one value.
	//
	// ⭐ **AND THE ANSWER IS OBSERVABLE FOR LITERALS, WHICH THE SPEC PINS.** `"hello" is "hello"` is TRUE
	// because `lowerStringLiteral` registers the blob and the record through `registerRdataConstant`, which
	// DEDUPES by bytes — every occurrence of one literal shares one immortal `.rdata` record. That is a
	// property this operator only reveals; nothing here arranges it.
	//
	// The `eq`/`ne` split is the whole of `is not`: one operand pair, one compare, the predicate inverted —
	// so the two spellings cannot come to disagree the way a separate negation emit could.
	function emitReferenceIdentity(lhs ValueId, rhs ValueId, negate bool, opTok Token) returns ValueId throws SourceParseError
		let op = referenceIdentityOpSpelling(negate)
		let leftTag = self.tagOf(lhs)
		let rightTag = self.tagOf(rhs)

		// Asked of BOTH operands and BEFORE the agreement test below, because a pair of `int`s AGREES and the
		// thing wrong with `a is b` there is not that the types differ — it is that neither value is an object.
		// A deferred operand passes both tests: the E3004 at its call is the program's diagnostic.
		if not self.valueMayBeAReference(lhs, tag: leftTag) or not self.valueMayBeAReference(rhs, tag: rightTag) 'notAReference'
			throw SourceParseError.refIdentityOnPrimitive(op, line: opTok.line, column: opTok.column)
		end 'notAReference'

		if not tagIsUnresolved(leftTag) and not tagIsUnresolved(rightTag) and not self.valuesNameOneType(lhs, rhs: rhs) 'typeMismatch'
			throw SourceParseError.refIdentityTypeMismatch(op, left: self.valueDisplayTypeName(lhs), right: self.valueDisplayTypeName(rhs), line: opTok.line, column: opTok.column)
		end 'typeMismatch'

		// SIGNED, and unconditionally: `is` is an EQUALITY of two addresses, and `cmp`+`je` answers the
		// same for two bit patterns in either reading. There is no ordering spelling of this operator to
		// which the question could apply.
		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.compare(result, lhs: lhs, rhs: rhs, op: MaxonCmpOp.ne if negate else MaxonCmpOp.eq, signedness: IntegerSignedness.signed), range: SourceRange.ofToken(opTok))
		return result
	end 'emitReferenceIdentity'

	function valueMayBeAReference(value ValueId, tag ValueTypeTag) returns bool
		return tagIsUnresolved(tag) or (tagHasReferenceIdentity(tag) and not self.valueIsAnInlineRecord(value))
	end 'valueMayBeAReference'

	// ⭐⭐ **DO THESE TWO VALUES NAME ONE TYPE? — THE ONE HOME for a question three operator gates
	// ask.** `structComparisonOperands`, `arrayEqualityOperands` and the `is` rule's second half
	// (*"both operands must be the same type"*) each need `tagOf(a) == X and tagOf(b) == X and
	// valueNameId(a) == valueNameId(b)`, and the promise that *"a later edit cannot widen one side
	// alone"* is one three copies of it would break. The two comparison gates keep their own TAG
	// clause, which is what makes each about ONE family; the agreement itself is here.
	//
	// The tag decides it outright for the two builtin byte records: there is exactly one `String` type and
	// exactly one `Character` type, so a matching tag IS a matching type. The two NOMINAL tags
	// (`tagIdentityIsNominal`) name a family and additionally need the declared name — `Point` against `Box`,
	// `Array with int` against `Array with String`.
	//
	// ⚠ **IT IS NOT A CONVENIENCE — WITHOUT THE TAG CLAUSE `s is c` IS A SILENT WRONG ANSWER.** A `String` and
	// a `Character` are the same 56-byte record, so a raw pointer compare across them would answer a question
	// about two values whose types every other rule keeps apart. `emitCompare`'s byte-record arm spells the
	// same guard for the same reason.
	function valuesNameOneType(lhs ValueId, rhs ValueId) returns bool
		let leftTag = self.tagOf(lhs)

		if leftTag != self.tagOf(rhs) 'differentTags'
			return false
		end 'differentTags'

		if not tagIdentityIsNominal(leftTag) 'theTagIsTheType'
			return true
		end 'theTagIsTheType'

		return self.valueNameId(lhs) == self.valueNameId(rhs)
	end 'valuesNameOneType'

	// Is this a comparison between two values of ONE user struct, or of ONE instance of a user
	// generic, that declares the method the operator reads? The gate in front of the dispatch below,
	// and every clause is load-bearing:
	//
	//   • the METHOD follows the operator (`structComparisonMethodName`): `equals` for `==`/`!=`,
	//     `compare` for the four ordering operators, which have no `equals` reading (see the call
	//     site).
	//   • BOTH operands of the SAME type — spelled as one property, exactly as the byte-record and
	//     `StringIndex` arms above spell theirs, so a later edit cannot widen one side alone into a
	//     compare of one type's box against another's. An `Array` is `arrayEqualityOperands`'.
	//   • the type DECLARES the method, asked of the WHOLE-PROGRAM index (`declaresCallee`) rather
	//     than of this file — the method may be declared in any file, including the one using it,
	//     which is `materializeStructToStringPart`'s reason for asking the same question the same way.
	//     A struct without it falls through to E3005, and so does a generic instance without it
	//     (`genericInstanceNotComparable`).
	function structComparisonOperands(lhs ValueId, rhs ValueId, op MaxonCmpOp) returns bool
		// The agreement is the shared `valuesNameOneType`, which supplies the other side's tag and the
		// declared name together; the TAG clauses below are this gate's own.
		if not self.valuesNameOneType(lhs, rhs: rhs) 'notOneTypesPair'
			return false
		end 'notOneTypesPair'

		let tag = self.tagOf(lhs)

		if tag == ValueTypeTag.structRef or (tag == ValueTypeTag.genericInstance and not self.signatures.isArrayInstance(self.valueInstanceId(lhs))) 'aStructOrAUserGenericInstance'
			return self.signatures.declaresCallee(qualifiedMethodName(self.comparedTypeName(lhs), methodName: structComparisonMethodName(op)))
		end 'aStructOrAUserGenericInstance'

		return false
	end 'structComparisonOperands'

	function comparedTypeName(value ValueId) returns immutable ByteArray
		let tag = self.tagOf(value)

		if tag == ValueTypeTag.structRef 'aStruct'
			return self.internedName(self.valueNameId(value))
		end 'aStruct'

		if tag == ValueTypeTag.genericInstance 'aGenericInstance'
			return self.signatures.genericInstanceBaseName(self.valueInstanceId(value))
		end 'aGenericInstance'

		panic("Parser.comparedTypeName: a {typeTagName(tag)} value is neither a struct nor a generic instance")
	end 'comparedTypeName'

	// A comparison on one user struct or user generic instance, as the ORDINARY instance call
	// `a.equals(b)` for `==`/`!=` and `a.compare(b)` for an ordering operator (read by
	// `emitOrderingVerdict`) — same callee key, same argument slotting, so nothing downstream learns
	// that an operator produced it. The receiver is argument 0, which is the whole of the compiler's
	// method-dispatch convention (`parseCallNamed`).
	//
	// ⚠⚠ **AND `equals`' `bool` RESULT IS CHECKED HERE, NOT ASSUMED.** See
	// `structEqualsResultNotBool`: the WITNESS form of this same dispatch already refuses a
	// name-matched `equals` that returns anything but `bool` (`witnessTargetIsProtocol`, whose header
	// carries the measurement), because matching by METHOD NAME is what both forms do and a bare name
	// proves nothing about a result. The direct form without it would go silently wrong in both
	// operators: `==` would evaluate to whatever `equals` returned, and `!=` would `logicalNot` that
	// value while stamping the result `boolean`.
	//
	// ⚠ **IT TAKES NO E3207 BLAME NAMES, and that is `emitTypeParamComparison`'s answer to the same
	// question two screens up, not a shortcut.** A blame name describes a callee that WRITES through an
	// argument and names the binding to blame; an OPERATOR wrote this call, its operands are values the
	// climber already produced, and the witness form of exactly this dispatch passes empty for the identical
	// reason. So the compiler-written-call columns (`emptyArgLabels` / `uniformArgRanges` /
	// an empty blame column) are the honest ones here — every argument shares the operator's own span,
	// because that IS where each came from.
	function emitStructComparisonCall(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws SourceParseError
		let structName = self.comparedTypeName(lhs)
		let methodName = structComparisonMethodName(op)
		try self.requireImplicitMethodReachable(structName, methodName: methodName, anchor: opTok)
		let callee = qualifiedMethodName(structName, methodName: methodName)
		let range = SourceRange.ofToken(opTok)
		let args = twoArgs(lhs, second: rhs)
		let argLabels = emptyArgLabels(args)
		let argRanges = uniformArgRanges(args, range: range)
		let verdict = try self.emitCall(callee, anchor: opTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: opTok, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: CalleeMint.resolvedTypeQualifier, places: self.placesOfArguments(args, anchor: opTok))
		let resultTag = self.tagOf(verdict)

		if comparisonIsEquality(op) and resultTag != ValueTypeTag.boolean 'equalsResultNotBool'
			throw SourceParseError.structEqualsResultNotBool(String.from(structName), got: self.valueKindWord(verdict), op: comparisonOpSpelling(op), line: opTok.line, column: opTok.column)
		end 'equalsResultNotBool'

		return match op 'op'
			eq gives verdict
			ne gives self.emitUnaryOp(verdict, op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, range: range)
			lt or
			gt or
			le or
			ge gives self.emitOrderingVerdict(verdict, op: op, opTok: opTok)
		end 'op'
	end 'emitStructComparisonCall'

	function structComparisonMethodName(op MaxonCmpOp) returns immutable ByteArray
		return EqualsMethodName if comparisonIsEquality(op) else CompareMethodName
	end 'structComparisonMethodName'

	// Is this an `==`/`!=` between two values of ONE `Array` instance? `structComparisonOperands`'
	// twin, one tag over, and narrower by one clause: EQUALITY only, BOTH operands the SAME generic
	// instance (spelled as one property so a later edit cannot widen one side into a compare of one
	// instance's record against another's), and the instance an `Array` rather than any other builtin
	// or user generic.
	//
	// ⚠ It does NOT ask whether the element conforms. That is the availability question, and it is asked at
	// the emit below so that a non-conforming element gets `Array.equals`'s own E4006 rather than falling
	// through to a comparison type mismatch naming two identical instance names.
	function arrayEqualityOperands(lhs ValueId, rhs ValueId, op MaxonCmpOp) returns bool
		if not comparisonIsEquality(op) 'notEquality'
			return false
		end 'notEquality'

		// The TAG clause is this gate's own and the agreement is shared — `structComparisonOperands`'
		// split, one tag over.
		if not (self.tagOf(lhs) == ValueTypeTag.genericInstance and self.valuesNameOneType(lhs, rhs: rhs)) 'notOneInstancesPair'
			return false
		end 'notOneInstancesPair'

		// The bare `isArrayInstance` and not `isArrayInstanceAt`: the tag half of that two-part test is the
		// line above, already asked of BOTH operands, so routing through the combined door would ask it a
		// third time over an id it has already qualified.
		return self.signatures.isArrayInstance(self.valueInstanceId(lhs))
	end 'arrayEqualityOperands'

	// `a == b` / `a != b` on one `Array` instance, as `a.equals(b)` — `__managed_eq` for an element
	// `arrayEqualityIsBitwise` admits, the element-wise `Array.equals` otherwise.
	//
	// ⚠ **THE AVAILABILITY RULE IS THE METHOD'S, ASKED AT THE OPERATOR'S SPAN.** `==` on an array means
	// `Array.equals`, which exists only where the element satisfies the conditional conformance — so an
	// array of a non-conforming element is E4006 here, naming `equals` and the clause, rather than the
	// pointer compare.
	//
	// ⚠ Both operands are BORROWED (neither `__managed_eq` nor `Array.equals` frees one), so each
	// stays whatever pending temporary the climber made it and drops at statement end, AFTER the
	// compare — `emitBuiltinConformanceCall`'s contract for a managed receiver.
	function emitArrayEqualityCall(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws SourceParseError
		let instance = self.valueInstanceId(lhs)
		try self.requireArrayConformanceAvailable(instance, methodName: EqualsMethodName, anchor: opTok)

		let range = SourceRange.ofToken(opTok)
		let equal = try self.emitArrayEquals(lhs, rhs: rhs, instance: instance, opTok: opTok)

		return match op 'op'
			eq gives equal
			ne gives self.emitUnaryOp(equal, op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, range: range)

			// Unreachable: `arrayEqualityOperands` admits only `eq`/`ne`, and it is the one gate in front of
			// this function.
			lt or
			gt or
			le or
			ge panic("emitArrayEqualityCall: reached with the ordering operator {comparisonOpSpelling(op)}, which `arrayEqualityOperands` refuses")
		end 'op'
	end 'emitArrayEqualityCall'

	function emitArrayEquals(lhs ValueId, rhs ValueId, instance GenericInstanceId, opTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(opTok)

		if self.signatures.arrayEqualityIsBitwise(instance) 'theBytesAreTheContent'
			return self.emitRuntimeCall(ManagedEqName, args: twoArgs(lhs, second: rhs), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'theBytesAreTheContent'

		let args = twoArgs(lhs, second: rhs)
		return try self.emitCall(qualifiedMethodName(self.signatures.genericInstanceBaseName(instance), methodName: EqualsMethodName), anchor: opTok, args: args, argLabels: emptyArgLabels(args), argRanges: uniformArgRanges(args, range: range), argImmutableNames: NameRoster.create(0), rparenTok: opTok, resultUsed: true, constructorInstance: ConstructorInstance.instance(instance), mint: CalleeMint.resolvedTypeQualifier, places: self.placesOfArguments(args, anchor: opTok))
	end 'emitArrayEquals'

	function requireSameInstanceToCompare(lhs ValueId, rhs ValueId, opTok Token) throws SourceParseError
		if self.valueInstanceId(lhs) == self.valueInstanceId(rhs) 'oneInstance'
			return
		end 'oneInstance'

		throw SourceParseError.comparisonTypeMismatch(String.from(self.signatures.instanceDisplayName(self.valueInstanceId(lhs))), right: String.from(self.signatures.instanceDisplayName(self.valueInstanceId(rhs))), line: opTok.line, column: opTok.column)
	end 'requireSameInstanceToCompare'

	// The one place the comparison operators are split into equality and ordering, because both
	// readers derive a consequence from it: a struct's own dispatch calls `equals` for one and
	// `compare` for the other (`structComparisonMethodName`), and the witness dispatch picks
	// `Equatable` here and `Comparable` there (`requireOperatorWitness`).
	function comparisonIsEquality(op MaxonCmpOp) returns bool
		return match op 'op'
			eq or
			ne gives true
			lt or
			gt or
			le or
			ge gives false
		end 'op'
	end 'comparisonIsEquality'

	// Two `StringIndex`es compared through their `charIdx` fields — the `equals`/`compare` bodies read
	// that one field and never `bytePosition`. Two field loads and the ORDINARY integer `compare` op
	// the operator would have produced on two ints, so every operator keeps its own meaning and none
	// of them needs an arm here.
	function emitStringIndexCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(opTok)
		return try self.emitCompare(self.emitStringIndexField(lhs, index: StringIndexCharIdxFieldIndex, range: range), rhs: self.emitStringIndexField(rhs, index: StringIndexCharIdxFieldIndex, range: range), op: op, opTok: opTok)
	end 'emitStringIndexCompare'

	// ⭐ **EVERY COMPARISON ON A MATCHED PAIR OF BYTE RECORDS** — a `String` pair or a `Character` pair, which
	// `emitCompare`'s one interception hands here. `==` is the `__str_eq` runtime call (content equality:
	// equal lengths, then equal bytes) and `!=` is its logical negation, built from the SAME call so the two
	// can never disagree about what equality means; both answer for either type, because the two share the
	// record. ORDERING is where they part (see `emitByteRecordOrdering`).
	//
	// ⚠ **THE NAME SAYS WHICH QUESTION THIS ANSWERS, NOT WHICH CALLER ARRIVED FIRST.** It serves `Character` as well as
	// `String` — `tagIsByteRecord` is what routes here — so a function named for one of its two types would write its
	// diagnostic in that type's noun and report *"cannot compare String with String"* for a program that mentions no
	// String. The message is the operand's own (`emitByteRecordOrdering`).
	function emitByteRecordCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId
		match op 'op'
			eq then return self.emitStrEqCall(lhs, rhs: rhs, opTok: opTok)
			ne then return self.emitUnaryOp(self.emitStrEqCall(lhs, rhs: rhs, opTok: opTok), op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, range: SourceRange.ofToken(opTok))
			lt or
			gt or
			le or
			ge then return self.emitByteRecordOrdering(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'op'
	end 'emitByteRecordCompare'

	// ⭐⭐ **`<`/`>`/`<=`/`>=` ON A BYTE-RECORD PAIR — WHERE `Character` AND `String` PART COMPANY.**
	// The two types share a 56-byte record and every other rule in this file treats them as one thing; this
	// is the single question whose answer differs, and it differs because the CORPUS says so:
	// `stdlib/Character.maxon:19` declares `implements … Comparable` and writes the order out at `:80-104`,
	// while `stdlib/String.maxon:49` declares no such conformance. The oracle answers both accordingly —
	// `'é' < 'ü'` runs, `"apple" < "banana"` is refused.
	//
	// ⭐ **A CHARACTER'S ORDERING IS THE `Comparable` CASCADE, NOT AN INLINE COMPARE.** `__char_cmp` is the
	// SAME graph installed under `Character.compare` for the witness door
	// (`BuiltinConformanceRuntime.buildByteRecordCompare`), and the verdict is read off its `Ordering` by the
	// SAME `emitOrderingVerdict` a `where T is Comparable` dispatch uses — so `c < d`, `c.compare(d)` through
	// a witness, and a `match` range arm over Characters cannot come to mean three different things.
	//
	// ⚠ **A POINTER COMPARE HERE WOULD HAVE COMPILED AND ANSWERED NONSENSE**, which is the hazard
	// `comparableOperands` already names for two structs and two existentials: a Character's value is its
	// RECORD'S ADDRESS, so `MaxonOp.compare` would order two clusters by where they happen to be allocated.
	// That is why the operator is never let through as a raw compare.
	function emitByteRecordOrdering(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId
		// Typed through `interfaceReturnMaxonType`, the SAME typer `emitBuiltinConformanceCall` gives
		// `i.compare(j)`'s result, so the `Ordering` this hands `emitOrderingVerdict` carries the enum's
		// `named` tag exactly as a witness dispatch's does.
		let orderingType = self.interfaceReturnMaxonType(RequirementType.ofNominal(self.signatures.interfaceMap().synthesizedNominalOf(OrderingTypeName)))
		let ordering = self.emitRuntimeCall(CharCmpName, args: twoArgs(lhs, second: rhs), resultTag: maxonTypeTag(orderingType), resultNameId: typeNameIdOf(orderingType), range: SourceRange.ofToken(opTok))

		return self.emitOrderingVerdict(ordering, op: op, opTok: opTok)
	end 'emitByteRecordOrdering'

	// Is `v` a value of one of the ENCLOSING type's parameters (`self.item`, `other T` inside `type Box uses T`)
	// — a genuinely opaque `T`, NOT a concrete generic-method result that the parser happens to tag
	// `typeParameter` in a non-generic caller? The gate that keeps `==` a scalar compare for
	// `let v = intBox.get(); v == 42` while making it a witness dispatch for `item == other` inside `Box`'s own
	// body.
	//
	// ⭐ **IT IS AN IDENTITY QUESTION AND IT IS ASKED AS ONE.** A RANGE test
	// (`valueNameId(v) < enclosingTypeParams.count()`) stands in for an identity test and answers yes for any
	// other type's parameter at a position this type also has. The token is re-spelled against THIS
	// declaration's own `uses` names instead, so the answer is "does this token name one of MY parameters"
	// and nothing weaker. Outside a generic body the list is empty and the scan cannot match.
	function isEnclosingTypeParam(v ValueId) returns bool
		if self.tagOf(v) != ValueTypeTag.typeParameter 'notParam'
			return false
		end 'notParam'

		// The EXISTENCE door, not a discarded `typeParamPositionIn`: the POSITION is not wanted here, only
		// whether the token names one of this declaration's parameters at all — and a PURE result may not be
		// dropped in any spelling (E3064).
		return namesTypeParamOf(self.valueTypeParamId(v), declarationName: try self.enclosingType.typeName() otherwise return false, paramNames: self.enclosingTypeParams)
	end 'isEnclosingTypeParam'

	// ⭐ **LOWER A COMPARISON ON A CONSTRAINED TYPE PARAMETER TO A WITNESS DISPATCH.**
	// ONE shape serves both operator families, because both are "dispatch one interface method through the
	// constraint's witness, then read a verdict off its result": `==`/`!=` dispatch `Equatable.equals` and take
	// (or negate) its bool; `<`/`>`/`<=`/`>=` dispatch `Comparable.compare` and test its `Ordering` against a
	// case tag. The receiver choice, the constraint search, the `Self`-argument check, the result typing and the
	// emit are therefore written ONCE, and only the (method, interface) pair and the verdict differ. The
	// dispatch shape is exactly what `dispatchWitnessMethod` builds for `<T>.equals(other)` /
	// `<T>.compare(other)`, so the operator form and the method form cannot come to mean different things.
	//
	// The `typeParameter` operand is the witness receiver. Equality is symmetric, so a `T`-vs-value mix may use
	// whichever side is the parameter; ORDERING IS NOT — `self.a < self.b` must dispatch on the LEFT operand —
	// and the shared `Self`-argument check is what guarantees it does: `compare`'s formal is `Self`, so an actual
	// that is not a value of the RECEIVER'S OWN parameter is rejected BEFORE anything is emitted. The emit is
	// therefore only ever reached with both operands values of the SAME enclosing parameter, where `leftIsParam`
	// holds and the receiver IS `lhs`; a `42 < self.item` never reaches it to be silently flipped into
	// `self.item > 42`, and neither does a `self.a < self.b` over two DIFFERENT parameters (see
	// `isReceiverTypeParamValue`).
	function emitTypeParamComparison(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token, leftIsParam bool) returns ValueId throws SourceParseError
		let receiver = lhs if leftIsParam else rhs
		let other = rhs if leftIsParam else lhs
		let receiverParam = self.valueNameId(receiver)
		let target = try self.requireOperatorWitness(receiver, op: op, opTok: opTok)

		// The `other` operand fills the method's `Self`-typed formal, so it must be a value of the receiver's own
		// `T` — a concrete literal (`item == 42`, `item < 42`) would be marshalled into the `Self` pointer and
		// faulted. Same reject the method-call form runs, one shared helper.
		let args = twoArgs(receiver, second: other)
		try self.requireGenuineSelfArgs(target, args: args, what: comparisonOpSpelling(op), receiverParam: receiverParam as TypeParamId, errorTok: opTok)

		// Typed through the SAME witness-dispatch result typer the `.method()` form uses, so `equals`'s `bool`
		// and `compare`'s `Ordering` are minted here exactly as they are there (the `Ordering` result carries the
		// enum's `named` tag, which is what lets a `match` on a `compare()` result recognize it). Its void and
		// `Self` arms cannot fire for an operator: `Equatable`/`Comparable` each declare one value-returning
		// method, and `resultUsed` is true because a comparison is only ever parsed for its verdict.
		let dispatchResult = try self.mintWitnessDispatchResult(target, receiver: receiver, methodTok: opTok, resultUsed: true)
		_ = self.emitWitnessDispatch(dispatchResult, args: args, blames: NameRoster.create(0), target: target, range: SourceRange.ofToken(opTok), siteTok: opTok)

		// The verdict. `==` is the dispatch's own bool and `!=` negates that SAME dispatch, so the two can never
		// disagree about what equality means (the `emitByteRecordCompare` shape); the four ordering operators read
		// the `Ordering` (below).
		match op 'verdict'
			eq then return dispatchResult
			ne then return self.emitUnaryOp(dispatchResult, op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, range: SourceRange.ofToken(opTok))
			lt or
			gt or
			le or
			ge then return self.emitOrderingVerdict(dispatchResult, op: op, opTok: opTok)
		end 'verdict'
	end 'emitTypeParamComparison'

	// The ordinal test that turns a `compare` result's `Ordering` into an ordering operator's bool.
	// Its two callers are the two ways a `compare` is reached — the WITNESS dispatch on a
	// constrained type parameter (`emitTypeParamComparison`) and the DIRECT `__char_cmp` call a `Character`
	// pair lowers to (`emitByteRecordOrdering`) — and they share this because the verdict is a fact
	// about `Ordering`, not about how the ordering was obtained.
	//
	// It reads the THREE-VALUED result: `<` is `lessThan` and `>` is `greaterThan`, while the
	// INCLUSIVE pair is the NEGATION of the strict opposite — `<=` is "not greaterThan", `>=` is "not
	// lessThan" — which is what makes `equalTo` satisfy both without a second compare.
	//
	// Every tag is read OFF the `Ordering` layout (`EnumLayout.tagOfCase`), never written as a literal; the layout is
	// fetched ONCE here rather than per arm. The compare itself is `emitCompareAgainstLiteral`, the SAME tag compare
	// an enum `match` arm emits — so `a < b` and a hand-written `match a.compare(b)` agree by construction.
	//
	// ⭐ **AND THE LAYOUT IS THE CORPUS'S OWN** — `stdlib/Interfaces.maxon`'s declaration, out of the
	// whole-program index. The Std-tier
	// `compare` impls whose result this tests read the SAME declaration
	// (`BuiltinConformanceRuntime.installBuiltinConformanceRuntime`), so the producer and the consumer of
	// this tag cannot come to number the cases differently.
	function emitOrderingVerdict(orderingResult ValueId, op MaxonCmpOp, opTok Token) returns ValueId
		let ordering = requireCorpusDeclaredEnum(self.signatures.settledDeclarations().enumTypes, typeName: OrderingTypeName, reader: "the `<`/`>`/`<=`/`>=` lowering")
		let lessThanTag = ordering.tagOfCase(OrderingLessThanCaseName)
		let greaterThanTag = ordering.tagOfCase(OrderingGreaterThanCaseName)

		match op 'ordinal'
			eq or
			ne then panic("emitOrderingVerdict: `==`/`!=` are the equality verdict, answered by each caller's own equality path (`emitTypeParamComparison`'s `Equatable` dispatch, `emitByteRecordCompare`'s `__str_eq`) before an ORDERING operator is routed here")
			lt then return self.emitCompareAgainstLiteral(orderingResult, literal: lessThanTag, op: MaxonCmpOp.eq, opTok: opTok)
			gt then return self.emitCompareAgainstLiteral(orderingResult, literal: greaterThanTag, op: MaxonCmpOp.eq, opTok: opTok)
			le then return self.emitCompareAgainstLiteral(orderingResult, literal: greaterThanTag, op: MaxonCmpOp.ne, opTok: opTok)
			ge then return self.emitCompareAgainstLiteral(orderingResult, literal: lessThanTag, op: MaxonCmpOp.ne, opTok: opTok)
		end 'ordinal'
	end 'emitOrderingVerdict'

	// The witness a comparison operator on the type-parameter value `receiver` dispatches through,
	// or E3005 when the parameter carries no constraint that PROVIDES THE OPERATOR'S PROTOCOL — `Equatable` for
	// `==`/`!=`, `Comparable` for `<`/`>`/`<=`/`>=`.
	//
	// ⭐ **THE PROTOCOL IS FETCHED, NOT DESCRIBED.** The method name the constraints are searched for, the
	// result type the verdict reads and the FORMALS the operator can fill are ALL taken off the interface
	// `IrInterfaceMap.protocolDeclaration` synthesizes — the whole `InterfaceMethodSig` is handed on rather
	// than picked apart into parallel `want*` arguments, so this function names ONE fact (which protocol the operator belongs
	// to) instead of several parallel spellings of it.
	function requireOperatorWitness(receiver ValueId, op MaxonCmpOp, opTok Token) returns WitnessDispatchTarget throws SourceParseError
		let protocol = self.signatures.interfaceMap().protocolDeclaration(BuiltinInterfaceKind.equatable if comparisonIsEquality(op) else BuiltinInterfaceKind.comparable)
		let method = try protocol.methods.get(0) otherwise panic("requireOperatorWitness: the synthesized protocol '{String.from(protocol.name)}' declares no method — a comparison operator dispatches its SOLE method (`singleMethodInterface`), so `IrInterfaceMap.protocolDeclaration` must give it exactly one")

		// The search itself runs by METHOD (the shared core the `.equals()`/`.compare()` dispatch uses), so a hit
		// still has to be PROVED to be the protocol's — see `witnessTargetIsProtocol`. It is now the FILTER
		// rather than a check applied to whichever candidate came first, which is strictly stronger: checked
		// after the fact, a constraint declaring a non-protocol `equals` MASKS a genuinely `Equatable` constraint
		// written after it, because the search stops at the first name match and then rejects it.
		let protocolShaped = WitnessDispatchTargetArray.create(0)
		let candidates = try self.findWitnessDispatchCandidates(receiver, methodName: method.name, errorTok: opTok)

		for i in 0 upto candidates.count() 'eachCandidate'
			let candidate = try candidates.get(i) otherwise panic("requireOperatorWitness: candidates.get OOB at {i} below count {candidates.count()}")

			if witnessTargetIsProtocol(candidate, want: method) 'isTheProtocol'
				protocolShaped.push(candidate)
			end 'isTheProtocol'
		end 'eachCandidate'

		match pickSoleWitnessCandidate(protocolShaped) 'pick'
			one(target) then return target

			// A near-miss reports the SAME E3005 as no constraint at all, because the author's cure is the
			// same sentence: constrain the parameter with the protocol. (Constructed inline rather than
			// through a shared factory — `throw self.helperReturningAParseError(…)` leaks the boxed union.)
			none then throw SourceParseError.operatorRequiresConformance(comparisonOpSpelling(op), typeParamName: String.from(self.typeParamDisplayName(self.valueTypeParamId(receiver))), interfaceName: String.from(protocol.name), line: opTok.line, column: opTok.column)

			// TWO constraints genuinely shaped like the protocol. They are two DISTINCT witness slots holding
			// two DISTINCT conformers' impls, so "they are both `Equatable`" does not make them interchangeable
			// — the operator would silently take whichever was written first. Same reject as the `.method()`
			// form's, for the same reason.
			ambiguous(first, second) then throw SourceParseError.ambiguousWitnessDispatch(String.from(method.name), provider: self.witnessDispatchProviderPhrase(receiver), argCount: method.paramTypes.count() as ParamCount, first: renderWitnessRequirement(first, signatures: self.signatures), second: renderWitnessRequirement(second, signatures: self.signatures), line: opTok.line, column: opTok.column)
		end 'pick'
	end 'requireOperatorWitness'

	// ⭐ **A CONSTRAINT DECLARING A METHOD OF THE PROTOCOL'S NAME IS NOT THE PROTOCOL** — and the verdict below
	// reads the dispatch result as if it were. `findWitnessDispatchCandidates` matches by METHOD NAME because the
	// `.method()` dispatch it is shared with must, so a USER interface with its own `compare`/`equals` satisfies
	// it: an `interface Weird` declaring `function compare(other Self) returns Integer` makes
	// `a < b` mean `a.compare(b) == 0`, i.e. "less than" whenever the author's `compare` says EQUAL; the twin
	// with `equals` makes `a == b` evaluate to the raw `7` that `equals` returns. Both are silent wrong
	// answers, not crashes, so nothing downstream is ever going to catch them.
	//
	// Requiring the found method's RESULT to be the protocol's own declared result is what makes the
	// target genuinely the protocol's — `equals` must yield the `bool` the `eq`/`ne` arms take,
	// `compare` the `Ordering` whose tags `emitOrderingVerdict` tests. A near-miss reports the SAME
	// E3005 as no constraint at all, because the author's cure is the same sentence: constrain the
	// parameter with the protocol. (Constructed inline at both sites rather than through a shared
	// factory — `throw self.helperReturningAParseError(…)` leaks the boxed union.)
	//
	// ⚠ **A THROWING METHOD IS REFUSED HERE FOR THE SAME REASON A WRONG-RESULT ONE IS.**
	// `Equatable.equals` and `Comparable.compare` are synthesized non-throwing, so a user interface whose
	// `equals` declares `throws E` is no more the protocol than one returning `7` is — and there is no
	// spelling that would make it safe: an OPERATOR has nowhere to put a `try`, so the dispatch would be
	// emitted single-register against a callee returning through the dual-register error ABI, dropping the
	// error. Same E3005, because the author's cure is the same sentence.
	//
	// ⚠⚠ **AND SO ARE THE FORMALS — BOTH HOW MANY AND WHAT TYPE — WHICH ARE THE THIRD AND FOURTH HOLES IN
	// THE SAME WALL.** An operator has exactly one
	// operand to give and that operand is a value of `T`, so the formal LIST is as much a part of "is this
	// the protocol?" as the result type is. Both halves are one question, asked once, against the
	// SYNTHESIZED interface's own `paramTypeNames` — never written as a literal `1` or a literal `Self`, for
	// the reason this function's header gives. Neither is cosmetic; both are silent wrong answers:
	//
	// - **ARITY.** `interface Weird { function equals(a Self, b Self) returns bool }` under `where T is
	//   Weird` compiles CLEAN and the impl reads its unsupplied second `Self` formal out of an uninitialised
	//   argument register, dereferencing it (a fault away from a crash).
	// - **FORMAL TYPE.** `interface WeirdEq { function equals(other int) returns bool }` under `where T is
	//   WeirdEq` compiles CLEAN and `self.item == self.other` hands the RECEIVER'S `T` POINTER to a formal
	//   the impl reads as an `int` — `equals(other int) { return other == 7 }` answers `false` for two
	//   equal values. `requireGenuineSelfArgs` cannot cover
	//   it: it validates the actuals at `Self` formals, and this interface declares none. The `float` twin
	//   is worse — `floatWidenedWitnessArgs` sees a `float` formal and `cvtsi2sd`s the pointer — and a
	//   `String` formal is a type confusion, an unmanaged struct pointer read through a managed header.
	//
	// The `.method()` form reaches neither: `slottedWitnessArgs` checks its arity against the interface, and
	// its `Self` formals really are `Self`. The arity half here is what makes `requireGenuineSelfArgs`'
	// missing-actual case unrepresentable.
	//
	// ⚠ **IT IS A PREDICATE AND NOT A REJECT, AND IT LIVES IN `IrInterface`.** As the FILTER the name search
	// feeds, a program constraining a parameter by BOTH a real protocol and a look-alike picks the real one
	// instead of being refused by whichever the author wrote first. The reject stays here, in
	// `requireOperatorWitness`'s empty arm, where "nothing here is the protocol" is the same fact as "no
	// constraint declares it"; the shape TEST lives in `IrInterface.witnessTargetIsProtocol`, because it
	// reads no `self`.

	// ⭐ **REJECT ANY NON-`Self` VALUE SUPPLIED FOR A `Self`-TYPED WITNESS-METHOD ARGUMENT.** A
	// witness-dispatched method whose formal is `Self` (`Equatable.equals`'s and `Comparable.compare`'s `other
	// Self`) requires an ACTUAL argument that is a value of the receiver's OWN enclosing type parameter — the
	// only thing the `where` constraint proves. Anything else marshalled into that `Self` pointer/slot is a
	// MISCOMPILE: the callee's `equals(other Point)` dereferences whatever word it was handed as its `other`
	// pointer (0xC0000005). Run UNIFORMLY for the operator (`T == 42`, `T < 42`) and method-call
	// (`T.equals(42)`, `T.compare(42)`) forms — their one shared arg-validation point. It also carries a SECOND
	// guarantee for the asymmetric ordering operators: rejecting a non-`Self` actual is what proves the ordering
	// dispatch's receiver is always the LEFT operand (see `emitTypeParamComparison`). `args[0]` is the receiver;
	// interface formal `j` maps to `args[j+1]`.
	//
	// ⭐ **EVERY FORMAL HAS AN ACTUAL BY THE TIME THIS RUNS, AND BOTH CALLERS GUARANTEE IT**:
	// `slottedWitnessArgs` slots against the interface's `paramNames`, and `witnessTargetIsProtocol` requires
	// the protocol's own formals. So a missing actual is a compiler defect rather than a program's, and it
	// panics instead of quietly passing an under-supplied dispatch through to the emit.
	function requireGenuineSelfArgs(target WitnessDispatchTarget, args ValueIdArray, what String, receiverParam TypeParamId, errorTok Token) throws SourceParseError
		for j in 0 upto target.paramTypes.count() 'eachFormal'
			let formalType = try target.paramTypes.get(j) otherwise panic("requireGenuineSelfArgs: paramTypes.get OOB at {j}")

			if not formalType.isSelf() 'notSelfFormal'
				continue
			end 'notSelfFormal'

			let actual = try args.get(j + 1) otherwise panic("requireGenuineSelfArgs: formal {j} of '{what}' has no actual — args holds {args.count()} entries (receiver + {args.count() - 1}) for {target.paramTypes.count()} formals, so the caller's arity check did not run")

			if not self.isReceiverTypeParamValue(actual, receiverParam: receiverParam) 'notSelfArg'
				throw SourceParseError.witnessSelfArgNotTypeParam(what, typeParamName: String.from(self.typeParamDisplayName(receiverParam)), got: self.selfArgActualDescription(actual), line: errorTok.line, column: errorTok.column)
			end 'notSelfArg'
		end 'eachFormal'
	end 'requireGenuineSelfArgs'

	// ⭐ **THE `.method(…)` FORM'S `Self`-FORMAL GATE, SPLIT BY RECEIVER KIND.**
	// A `Self`-typed formal demands an argument of the receiver's OWN dynamic type, and only one of the two
	// receivers can supply that proof:
	//
	//   • a CONSTRAINED TYPE PARAMETER can — every value of `T` in the body IS the receiver's type, so
	//     `isReceiverTypeParamValue` decides it exactly (see `requireGenuineSelfArgs`);
	//   • an EXISTENTIAL cannot, and no compiler can. Two values held at one interface may have DIFFERENT
	//     dynamic types, so `b.equals(c)` over two `Backend`s would marshal one conformer's box into the
	//     other's `other Self` and dereference it as the wrong type — a fault, or worse a wrong
	//     answer. It is refused here, because the check that would make it sound is a runtime type
	//     test the language has no expression for.
	//
	// Refused with the "unsupported construct" code rather than an argument-type mismatch, because nothing the
	// author could write at the ARGUMENT would fix it — the requirement itself is undispatchable through an
	// existential.
	function requireWitnessSelfArgs(target WitnessDispatchTarget, args ValueIdArray, receiver ValueId, methodTok Token) throws SourceParseError
		if self.tagOf(receiver) != ValueTypeTag.interfaceRef 'constrainedTypeParameter'
			try self.requireGenuineSelfArgs(target, args: args, what: String.from(methodTok.value), receiverParam: self.valueTypeParamId(receiver), errorTok: methodTok)
			return
		end 'constrainedTypeParameter'

		for j in 0 upto target.paramTypes.count() 'eachFormal'
			let formalType = try target.paramTypes.get(j) otherwise panic("requireWitnessSelfArgs: paramTypes.get OOB at {j} below count {target.paramTypes.count()}")

			if not formalType.isSelf() 'notSelfFormal'
				continue
			end 'notSelfFormal'

			throw SourceParseError.unsupported("a `Self`-typed parameter of '{self.witnessCalleeName(target)}' dispatched on a value held at {self.witnessDispatchReceiverPhrase(receiver)} — a `Self` formal requires an argument of the RECEIVER's own dynamic type, and {ExistentialPairUnprovableReason}. Dispatch it on a concrete value, or on a type parameter constrained to the interface", line: methodTok.line, column: methodTok.column)
		end 'eachFormal'
	end 'requireWitnessSelfArgs'

	// ⭐ **IS `actual` A VALUE OF THE RECEIVER'S OWN TYPE PARAMETER — the ONLY thing a `Self`-typed formal
	// accepts?** "A value of SOME enclosing type parameter" is not enough, and the difference is a **MEASURED
	// 0xC0000005**: in `type Mix uses A, B where A is Comparable, B is Comparable` instantiated at
	// `(Point, Integer)`, `self.a < self.b` dispatched `A`'s witness — `Point.compare` — with a `B` actual, so
	// the callee dereferenced the integer `9` as its `other Point`. Reversed to `(Integer, Point)` it does not
	// fault but silently compares an int against a heap pointer, and the `.compare()` METHOD form takes the same
	// route. `Self` means the receiver's parameter, not "a type parameter", and the witness table it dispatches
	// through belongs to ONE parameter, so the position must match.
	//
	// (A genuine cross-parameter COMPARISON — `A` vs `B` where both conform — is a real feature and needs a
	// second witness plus a conversion; it is not this, and refusing it is what keeps the door shut until then.)
	//
	// ⚠ **THE COMPARISON IS BETWEEN TWO IDENTITIES.** Comparing two POSITIONS is the same answer only while both come from one declaration —
	// the property this door exists to check rather than to assume.
	function isReceiverTypeParamValue(actual ValueId, receiverParam TypeParamId) returns bool
		return self.isEnclosingTypeParam(actual) and self.valueNameId(actual) == receiverParam as TypeNameId
	end 'isReceiverTypeParamValue'

	// WHAT was supplied where a `Self` was required, for `witnessSelfArgNotTypeParam`'s message — the two ways
	// an actual fails `isReceiverTypeParamValue`, described in ONE place so the diagnostic never calls a value
	// of another type parameter "a concrete value".
	function selfArgActualDescription(actual ValueId) returns String
		if not self.isEnclosingTypeParam(actual) 'concrete'
			return "a concrete value"
		end 'concrete'

		return "a value of type parameter '{String.from(self.typeParamDisplayName(self.valueTypeParamId(actual)))}'"
	end 'selfArgActualDescription'

	// The declared NAME the type-parameter token `param` was minted from — `T` in `type Box
	// uses T`.
	//
	// ⛔⛔ **IT DOES NOT RE-SPELL THE TOKEN AGAINST THE *READER'S* ENCLOSING DECLARATION, WHICH RENDERS EMPTY FOR A READER
	// THAT ENCLOSES NOTHING.** Not every caller reaches here past `isEnclosingTypeParam` — the three DIAGNOSTIC PHRASE
	// builders below and `requireDefaultableFieldType` do not — and at FILE SCOPE `self.enclosingType` is
	// `EmptySourceText`, so a read against it would panic with `names no parameter of '', which declares 0`. A value
	// whose type a substitution gap left as a bare `Bag.Element` can reach `main`, a member call on it finds no
	// witness, and the compiler would die BUILDING THE SENTENCE THAT WOULD HAVE SAID SO — a diagnostic the program
	// has already earned, replaced by a stack trace.
	//
	// ⭐⭐ **A PARAMETER'S NAME IS A PROPERTY OF THE TOKEN, NOT OF WHOEVER IS LOOKING AT IT.** A
	// token IS a digest of `(declaring type, parameter name)`, so the name is answerable wherever the token
	// is — inside the declaring body, in a sibling generic, or in a `main` that declares nothing. TWO tables
	// can invert it, and the order below is not a preference: it is the only order that is TOTAL.
	//
	// ⛔⛔ **AND THE ORDER IS MEASURED, NOT ARGUED — REGISTRY-FIRST PANICS DURING THE SWEEP.** The obvious
	// simplification is to read `typeParamOwnerOf` alone and call the local list redundant. It is not:
	// `requireDefaultableFieldType` runs inside `foldDeclaredSignaturesInto`, which is the pass that FILES
	// those owners, so the registry is empty for the very declaration being folded. MEASURED on this branch:
	// `field-initialization/type-parameter-field-{literal,expression}-default-errors` — two committed cases
	// expecting a positioned E2015 naming `'T'` — died with `typeParamDisplayName: type-parameter token
	// -5864020729385773348 has no owner`, inside `readStructFieldInto`. **`enclosingTypeParams` is what a
	// sweep-time reader has and the registry is what a post-fold reader has**, and neither covers the other's
	// phase.
	//
	// ⇒ The DECLARATION the cursor is inside answers first (available from the moment the `uses` clause is
	// read, and correct by construction for its own parameters); the whole-program registry answers for every
	// OTHER token, which is what a file-scope reader holding a foreign parameter needs. The two agree wherever both can
	// answer, because both spell the same half of the same digest.
	//
	// Absence from BOTH is an invariant break: a token neither this declaration nor any fold has seen was
	// minted inside a declaration that never reached either.
	function typeParamDisplayName(param TypeParamId) returns immutable ByteArray
		if let typeName = try self.enclosingType.typeName() 'insideAType'
			if let position = try typeParamPositionIn(param, declarationName: typeName, paramNames: self.enclosingTypeParams) 'oneOfTheCursorsOwn'
				return try self.enclosingTypeParams.get(position) otherwise panic("typeParamDisplayName: enclosingTypeParams.get OOB at {position}, a position `typeParamPositionIn` just read out of the same list")
			end 'oneOfTheCursorsOwn'
		end 'insideAType'

		return (try self.signatures.typeParamOwnerOf(param) otherwise panic("typeParamDisplayName: type-parameter token {param} names no parameter of the declaration being parsed ('{String.from(self.enclosingTypeName())}') and has no owner in the whole-program registry either — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds, so a token missing from both was minted inside a declaration neither fold saw")).paramName
	end 'typeParamDisplayName'

	// ⭐ **WHAT PROVIDES THE REQUIREMENTS A WITNESS DISPATCH SEARCHED — for the diagnostics that have to name
	// it.** One dispatch mechanism serves two receivers and only this differs:
	// a constrained type parameter's requirements come from its `where` constraints, an existential's from the
	// one interface the value is held at. Built on the FAILURE path only, exactly as
	// `IrInterface.separatorFreedomSubjectOf` is, so the success path allocates no String.
	function witnessDispatchProviderPhrase(receiver ValueId) returns String
		if self.tagOf(receiver) == ValueTypeTag.interfaceRef 'existential'
			return "interface '{String.from(self.internedName(self.valueNameId(receiver)))}'"
		end 'existential'

		return "the constraints on type parameter '{String.from(self.typeParamDisplayName(self.valueTypeParamId(receiver)))}'"
	end 'witnessDispatchProviderPhrase'

	// The same receiver in the other grammatical slot — "a value OF this cannot reach a `static` requirement".
	// Two phrases rather than one for the reason `SourceParseError.staticRequirementNotDispatchable` states.
	function witnessDispatchReceiverPhrase(receiver ValueId) returns String
		if self.tagOf(receiver) == ValueTypeTag.interfaceRef 'existential'
			return "interface '{String.from(self.internedName(self.valueNameId(receiver)))}'"
		end 'existential'

		return "type parameter '{String.from(self.typeParamDisplayName(self.valueTypeParamId(receiver)))}'"
	end 'witnessDispatchReceiverPhrase'

	// Emit the `__str_eq(lhs, rhs)` runtime call, typed `boolean` (its i64 result is 0/1). The one
	// caller-typed emit site for both `==` and `!=`, and for a `string`-scrutinee `match` pattern.
	function emitStrEqCall(lhs ValueId, rhs ValueId, opTok Token) returns ValueId
		let args = ValueIdArray.create(0)
		args.push(lhs)
		args.push(rhs)
		return self.emitRuntimeCall(StrEqName, args: args, resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(opTok))
	end 'emitStrEqCall'

	// ⭐ **IS THE IDENTIFIER AT THE CURSOR A FUNCTION-TYPED LOCAL — the callee of an INDIRECT call?** A
	// call on such a name (`let f = double; f(21)`) goes THROUGH the value, not to a function
	// NAMED by the identifier. It is the ONE diversion that turns `<name>(` from a direct call into an
	// indirect one, and it must read the SAME in both positions the grammar reaches a bare `<name>(`:
	// EXPRESSION position (`parsePrimary`'s `namedPrimary`) and STATEMENT position (`parseStatement`'s
	// `callStmt`). A non-function local of the same name keeps the direct-call path (`x(5)` with an int
	// `x` is still "call function x", E3004), and a name that is no local at all is a plain direct call —
	// so a genuinely undefined statement-position call is still E3004, not silently accepted.
	//
	// The cursor must sit on the identifier: both callers guard with `at(identifier)` and a `(` peeked
	// behind it, so `current().value` is the callee name and `getInfo` is reached only past `contains`.
	function calleeIsFunctionTypedLocal() returns bool
		let name = self.current().value

		if self.bodyState.scope.contains(name) 'aBindingOfThisBody'
			return maxonTypeTag(self.bodyState.scope.getInfo(name).varType) == ValueTypeTag.function
		end 'aBindingOfThisBody'

		match self.captureScopeOf(name) 'captured'
			found(enclosing, _) then return maxonTypeTag(enclosing.getInfo(name).varType) == ValueTypeTag.function
			notCaptured then break
		end 'captured'

		if self.job.initializerRole == InitializerRole.recordProbe 'aBindingTheProbeHasNotSettled'
			self.signatures.settleBindingDuringProbe(name, readerFilePath: self.job.path, stack: self.constEvalStack, anchors: self.anchors)
		end 'aBindingTheProbeHasNotSettled'

		return self.signatures.functionTypedBindingVisibleFrom(name, readerFilePath: self.job.path, into: self.artifact.typeNames)
	end 'calleeIsFunctionTypedLocal'

	// A primary expression: an integer literal, a `true`/`false` literal, a CHARACTER literal,
	// a parenthesized sub-expression, a type-qualified numeric bound (`u16.max`), a call, or a
	// variable reference. Anything else where an operand is required (an operator, a delimiter,
	// EOF) is E2004 — "Expected expression but got '<got>'". This is the site `- -x` hits
	// at its second `-`: unary minus's operand is a primary, and a leading `-` is not one.
	function parsePrimary(func IrFunction) returns ValueId throws SourceParseError
		if self.at(TokenKind.intLiteral) 'intLit'
			return try self.parseIntLiteral()
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			return try self.parseFloatLiteral()
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return try self.parseBoolLiteral()
		end 'boolLit'

		// A charLiteral HERE — where an operand is required — is a character literal. The
		// same token kind is a BLOCK LABEL elsewhere, and the two never collide because a
		// label never sits in operand position (see the CharLiteralValue header).
		if self.at(TokenKind.charLiteral) 'charLit'
			return try self.parseCharLiteral()
		end 'charLit'

		// A `String` LITERAL. A pure literal is a SINGLE `stringLiteral` token; an
		// INTERPOLATED string (`"{x}"`) is the same token followed by `stringInterpStart`, which
		// `parseStringLiteral` hands to `parseStringInterpolation`.
		if self.at(TokenKind.stringLiteral) 'strLit'
			return try self.parseStringLiteral(func)
		end 'strLit'

		// A `b"…"` BYTE-STRING LITERAL — its own token kind, so it cannot ride the string arm
		// above. It materializes as an owned `Array with Byte` over an immortal rdata blob.
		if self.at(TokenKind.byteStringLiteral) 'byteStrLit'
			return try self.parseByteStringLiteral()
		end 'byteStrLit'

		// `[a, b, c]` — an ARRAY LITERAL. Its own arm because `[` is its own token. It
		// desugars to `__managed_create` + a `__managed_push` per element, yielding an owned `Array with integer`.
		if self.at(TokenKind.leftBracket) 'arrayLiteral'
			return try self.parseArrayLiteral(func, element: ArrayLiteralElementSource.inferred)
		end 'arrayLiteral'

		if self.at(TokenKind.leftParen) 'group'
			return try self.parseParenthesizedExpression(func)
		end 'group'

		// `match <expr> 'label' … end 'label'` in value position — `let r = match …`, `return
		// match …`, `match … * 2`. A distinct parser gap from the statement form: the expression
		// parser had no `match` arm at all (E2004 `Expected expression but got 'match'`), where the
		// statement parser reached lowering before failing (E2015). It leaves control in the merge
		// block and yields the merge's result phi, exactly as `emitShortCircuit` does.
		if self.at(TokenKind.match) 'matchExpr'
			return try self.parseMatchExpression(func)
		end 'matchExpr'

		// `try <call> [otherwise <handler>]` in value position — `let r = try f() otherwise 0`, `return try
		// f() otherwise 42`. Yields the merged result value and leaves control in the merge (or the ok block
		// for a terminating/propagate handler), exactly as `parseMatchExpression` does.
		if self.at(TokenKind.try) 'tryExpr'
			return try self.parseTry(func, resultUsed: true)
		end 'tryExpr'

		// `function(params) gives <expr>` — a CLOSURE LITERAL in value position. `function` is
		// its own keyword, so it cannot ride the identifier arm below. A closure lifts to a
		// top-level function; one that captures enclosing locals reads them out of a trailing `__env` slot.
		// See `parseClosureExpression`.
		if self.at(TokenKind.function) 'closureLiteral'
			return try self.parseClosureExpression(func)
		end 'closureLiteral'

		// `Self{…}` — a struct literal naming the enclosing type — and `Self.<member>`, which is every DOTTED
		// form the enclosing type's own NAME has. `Self` is its own KEYWORD token, not an identifier, so
		// it cannot ride the identifier arm below; but the `{`-vs-`.` lookahead that splits the two here is
		// the SAME split that arm makes for a name, and it routes to the SAME two routines. (`Self` in a TYPE
		// position never reaches an expression at all.)
		if self.at(TokenKind.selfType) 'selfPrimary'
			if self.peekKind() == TokenKind.dot 'selfDotted'
				return try self.parseDottedPrimary(func, resultUsed: true)
			end 'selfDotted'

			return try self.parseStructLiteral(func)
		end 'selfPrimary'

		// `self.x` / `self.m(…)` — the RECEIVER, which is a different keyword from `Self` the TYPE
		// (`self` vs `selfType`; the lexer splits them, so nothing here has to). Its own arm for the
		// same reason `Self{…}` has one: a keyword cannot ride the identifier arm below.
		if self.at(TokenKind.self) 'selfReceiver'
			return try self.parseSelfPrimary(func, resultUsed: true)
		end 'selfReceiver'

		// `sizeof(Type)` — its own arm because `sizeof` is a KEYWORD, so it cannot ride the
		// identifier arm below (which would treat it as a value-position call to a function named `sizeof`,
		// leaving `T` an "undefined variable").
		if self.at(TokenKind.sizeof) 'sizeofExpr'
			return try self.parseSizeof()
		end 'sizeofExpr'

		// `countof(Type)` — its own arm for `sizeof`'s reason, one line up: `countof` is a KEYWORD, so
		// it cannot ride the identifier arm below, which would read `countof(Self)` as a value-position call
		// to a function nobody declares.
		if self.at(TokenKind.countof) 'countofExpr'
			return try self.parseCountof()
		end 'countofExpr'

		// ⭐ **`int.fromString(s)` — A STATIC ON A PRIMITIVE TYPE.** Its own arm for `Self`'s
		// reason, one arm up: `int`/`float`/`bool` are KEYWORDS, so they cannot ride the identifier arm
		// below — and `keywordIsANameInOperandPosition` cannot admit them either, because it requires the
		// next token to be `(` or the name to be bound, and `int` followed by `.` is neither. It routes to
		// `parseDottedPrimary`, which is where every OTHER type-named dotted form is split, so the scope
		// shadowing rule and the arm order are read from one place rather than restated. `byte.fromString(…)`
		// needs no arm at all — `byte` is an identifier here, so it is already below.
		if self.primitiveStaticReadAt(self.pos) 'primitiveStaticRead'
			return try self.parseDottedPrimary(func, resultUsed: true)
		end 'primitiveStaticRead'

		// ⭐ **A KEYWORD JOINS THE NAMED ARM WHEN A NAME IS ALL IT CAN BE** — `return type` reading the
		// parameter of `function identity(type Integer)`, `return from(41)` calling a function named `from`.
		// It is the SAME arm and not a parallel one, so a keyword-named value gets the four forms an
		// identifier gets (call, struct literal, dotted, bare read) rather than a subset that would diverge.
		// See `keywordIsANameInOperandPosition` for why the ORDER of the arms above is the whole safety
		// argument.
		if self.at(TokenKind.identifier) or try self.keywordIsANameInOperandPosition() 'namedPrimary'
			// `Set from [1, 2, 3]` — a builtin `Set` CONSTRUCTED from an array literal or an `Array` value.
			// The bare `Set` identifier followed by `from` is a construction, NOT a variable reference
			// (`Set` names no binding, so the plain path below reports E2004 `Undefined variable 'Set'`).
			// Its element type is inferred from the source.
			try self.settleTypeNameVerdict(try self.enterQualifiedTypeHead(TypeNameHeadForm.construction))

			if self.atRefusedInstanceConstruction() 'refusedInstanceConstruction'
				_ = try self.consumeConstructionHead()
				_ = try self.parseValueExpression(func)

				return self.mintDeferredValue()
			end 'refusedInstanceConstruction'

			if self.atContainerFromConstruction(FromHeadContainer.set) 'setFromConstruction'
				return try self.parseSetFromConstruction(func)
			end 'setFromConstruction'

			// `List from [a, b, c]` — the same shape one container over, and it is here rather than folded into
			// the arm above because the two build DIFFERENT things from the same tokens; sharing an arm would
			// mean a runtime callee chosen by re-testing the base name that already picked the arm.
			if self.atContainerFromConstruction(FromHeadContainer.list) 'listFromConstruction'
				return try self.parseListFromConstruction(func)
			end 'listFromConstruction'

			// `FixedArray from [10, 20, 30]` — the same shape a third container over, and its own arm for the
			// `List` arm's reason: the three build different things from the same tokens.
			if self.atContainerFromConstruction(FromHeadContainer.fixedArray) 'fixedArrayFromConstruction'
				return try self.parseFixedArrayFromConstruction(func)
			end 'fixedArrayFromConstruction'

			// `ByteArray from [10, 20, 30]` — the ALIAS-headed form, whose head names an `Array` instance
			// rather than a builtin base name. Its own arm for the reason the three above are three arms, and
			// it cannot collide with any of them: the bases are disjoint, and a name that aliases an `Array`
			// is not `Set`, `List` or `FixedArray`.
			if self.atContainerFromConstruction(FromHeadContainer.array) 'arrayFromConstruction'
				return try self.parseArrayFromConstruction(func)
			end 'arrayFromConstruction'

			// `FilePath from "C:\\x.txt"` — the `InitableFromStringLiteral` construction (see
			// `atLiteralInitConstruction`). It is asked AFTER the `Set` arm because that arm claims a name no
			// `type` declares, so the order is a reading order and not a precedence.
			if self.atLiteralInitConstruction(LiteralInitForm.stringLiteral) 'literalInitConstruction'
				return try self.parseLiteralInitConstruction(func, form: LiteralInitForm.stringLiteral)
			end 'literalInitConstruction'

			// `CharWrapper from 'X'` — the same sugar over a CHARACTER literal. Its own arm rather than a
			// widening of the one above because the two forms differ in the token they claim and in the
			// conformance they require, and both facts are the form's.
			if self.atLiteralInitConstruction(LiteralInitForm.charLiteral) 'charLiteralInitConstruction'
				return try self.parseLiteralInitConstruction(func, form: LiteralInitForm.charLiteral)
			end 'charLiteralInitConstruction'

			// `Digits from [4, 0, 7]` — the same sugar over an ARRAY literal, for a declared type implementing
			// `InitableFromArrayLiteral`. After the collection arms above, which claim their own heads.
			if self.atLiteralInitConstruction(LiteralInitForm.arrayLiteral) 'arrayLiteralInitConstruction'
				return try self.parseLiteralInitConstruction(func, form: LiteralInitForm.arrayLiteral)
			end 'arrayLiteralInitConstruction'

			// One-token lookaheads split the four forms an identifier can open. `(` makes it a CALL
			// (the same shape the statement parser uses to tell a call apart from a bare name); `{`
			// makes it a STRUCT LITERAL; `.` makes it one of the three DOTTED forms
			// (`parseDottedPrimary` splits those); anything else is a variable reference.
			if self.peekKind() == TokenKind.leftParen 'callExpr'
				// A LOCAL binding of FUNCTION type shadowed by the same name is called THROUGH its value
				// — an INDIRECT call (`f(21)` where `let f = double`), not a direct call to a function
				// NAMED `f`. Resolve it as a variable reference and let the postfix loop
				// (`parsePostfix`) apply the `(args)`. The same diversion — reading the SAME predicate —
				// runs at statement position (`parseStatement`'s `callStmt`); see `calleeIsFunctionTypedLocal`.
				if self.calleeIsFunctionTypedLocal() 'functionLocalCall'
					return try self.parseVariableReference()
				end 'functionLocalCall'

				// A call in an EXPRESSION — its result IS the expression, so a void callee has nothing
				// to give and `parseCall` rejects it (E2004).
				return try self.parseCall(func, resultUsed: true)
			end 'callExpr'

			if self.peekKind() == TokenKind.leftBrace 'structLiteral'
				return try self.parseStructLiteral(func)
			end 'structLiteral'

			if self.peekKind() == TokenKind.dot 'dotted'
				return try self.parseDottedPrimary(func, resultUsed: true)
			end 'dotted'

			return try self.parseVariableReference()
		end 'namedPrimary'

		let tok = self.current()
		throw SourceParseError.expectedExpression(expressionOperandDisplayText(tok), line: tok.line, column: tok.column)
	end 'parsePrimary'

	// ⭐ **IS THE KEYWORD AT THE CURSOR A NAME HERE, in OPERAND position?** A keyword-named PARAMETER
	// has to be readable or the declaration is decoration (`return type`), and a keyword-named FUNCTION has
	// to be callable or it is dead code the author cannot reach (`return from(41)`).
	//
	// ⭐⭐ **THE SAFETY ARGUMENT IS THE ARM ORDER ABOVE, AND IT IS THE SAME POSITION-SENSITIVITY
	// ARGUMENT `tokenCanBeAName` rests on.** Every keyword with an expression meaning of its own has
	// already been claimed by the time this is asked: `match`, `try`, `function`, `Self`, `self`,
	// `sizeof`, `true` and `false` by the arms directly above; `not`, `async`, `await` and a prefix
	// `-` by `parseUnary`, which runs before `parsePrimary` is ever reached. So a keyword still
	// standing at an operand's first token opens NOTHING, and a name is the only reading left. Those
	// eight therefore may be DECLARED as names but not READ bare.
	//
	// ⚠ **IT IS GATED ON THE NAME ACTUALLY RESOLVING, so no diagnostic moves.** A keyword that names nothing
	// falls through to the same `expectedExpression` it reports, on the same token. Two shapes
	// resolve, and they are the two the grammar can distinguish without a signature lookup:
	//   • a `(` after it makes it a CALL — the callee's existence is `SemanticCheck`'s to answer (E3004,
	//     which names the callee and is the better message anyway), exactly as it is for an identifier;
	//   • a BINDING of that name, local or captured, makes it a value READ.
	//
	// ⚠ A keyword-named free function called as a STATEMENT (`from(3)` on a line of its own) is NOT
	// covered, and cannot be by this argument: the statement dispatcher's own arms mean `while (…)`
	// and `if (…)` are a loop and a conditional with a parenthesized condition, so `<keyword> (` at
	// statement start is genuinely ambiguous rather than merely unclaimed. No corpus file calls a
	// keyword-named function for its effect, and the whole shape is rejected (see the file header).
	//
	// ⛔ **AND ONE SHAPE IS REFUSED HERE RATHER THAN ACCEPTED, BECAUSE THE TOKEN SCANS CANNOT SEE IT.** A BARE
	// read of a binding named `while`/`match`/`for`/`end` — `acc + while` — is a NAME to this arm and BLOCK
	// STRUCTURE to `opensBlockAt`/`closesBlockAt`, whose verdict for those four is position-INDEPENDENT
	// (`alwaysOpens`, and `end` closes wherever it stands). The scans run over raw tokens with no scope, so
	// they cannot know the name is bound; accepted here, the program panics in `assertScanAligned` instead of
	// compiling. `if` and `else` need no such care and are never refused — their POSITION tests already answer
	// no for an operand (`ifBeginsStatementIn`, `elseFollowsBlockEnd`).
	//
	// ⚠ **`otherwise` IS REFUSED IN EXACTLY ONE POSITION, AND THE DERIVATION IS WHY THAT COMES OUT RIGHT
	// WITHOUT ANYONE KNOWING IT.** `otherwiseOpensBlockIn`'s labelled-handler form is `otherwise 'label'`, and
	// a bare `otherwise` read as a WHOLE block condition is followed by that block's own label — so
	// `while otherwise 'loop'` is refused while `acc + otherwise` compiles. The code asks the scans rather
	// than consulting a list, so it comes out right with nobody having worked it out. **That is the argument
	// for deriving a set: a list carries whatever its author believed into the behaviour.**
	//
	// ⭐ **THE SET IS DERIVED, NOT LISTED**: the question is exactly "would a scan read THIS token, HERE, as
	// block structure?", so it is asked of the scans themselves. A change that teaches them the operand-position
	// exclusion turns this refusal off by construction, with nothing to remember.
	function keywordIsANameInOperandPosition() returns bool throws SourceParseError
		let tok = self.current()

		if tok.kind == TokenKind.identifier or not tokenCanBeAName(tok) 'notAnUnclaimedKeyword'
			return false
		end 'notAnUnclaimedKeyword'

		if not (self.peekKind() == TokenKind.leftParen or self.nameBindsOrIsCaptured(tok.value)) 'namesNothingHere'
			return false
		end 'namesNothingHere'

		if self.opensBlockAt(self.pos) or self.closesBlockAt(self.pos) 'readAsBlockStructure'
			self.blockStructureMisread = true
			throw SourceParseError.unsupported("reading '{String.from(tok.value)}' as a value here — it is a legal DECLARED name, but the token scans that re-derive Maxon's block structure read a bare `{String.from(tok.value)}` in this position as block structure and have no scope to tell them otherwise. Pass it under a different name, or read a differently-named binding", line: tok.line, column: tok.column)
		end 'readAsBlockStructure'

		return true
	end 'keywordIsANameInOperandPosition'

	// ⭐ **`sizeof(Type)`** — the byte size of a type. Two outcomes, decided by the operand:
	//
	//   • A CONCRETE type (a primitive, a ranged alias, a declared struct) is a COMPILE-TIME CONSTANT,
	//     folded to a `literal` right HERE — which is where the struct registry lives. It must fold here
	//     and cannot ride the `sizeofType` op as a `structRef(id)`: `mergeArtifact` remaps signatures and
	//     field types but NOT op operands, so a file-local struct id would survive into a multi-file
	//     lowering as garbage. A concrete `sizeof` is a constant anyway, exactly like `let n = 42`.
	//   • A TYPE PARAMETER (`sizeof(T)` inside `type Sizer uses T`) has NO single compile-time answer — the
	//     body compiles ONCE against an opaque `T` — so it emits a `sizeofType(typeParameter)` op that
	//     lowers to a runtime read of the instance's layout descriptor. `typeParameter` carries a POSITION,
	//     not an interned id, so it survives the merge unremapped.
	function parseSizeof() returns ValueId throws SourceParseError
		let sizeofTok = try self.consume(TokenKind.sizeof)
		try self.consume(TokenKind.leftParen)
		let operand = resolveNamedStruct(try self.parseTypeReference(BarePrimitiveVoice.admitted), typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: self.job.path)
		try self.consume(TokenKind.rightParen)

		if maxonTypeTag(operand) == ValueTypeTag.typeParameter 'runtimeSize'
			if not self.closureEnclosingFrames.isEmpty() 'readInsideAClosure'
				_ = self.closureHiddenWordSlot(ClosureHiddenWord.descriptor)
			end 'readInsideAClosure'

			let result = self.mintValueOfType(MaxonType.integer)
			self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.sizeofType(result, targetType: operand), range: SourceRange.ofToken(sizeofTok))
			return self.retypeAsLibraryAlias(result, aliasName: CountAliasName)
		end 'runtimeSize'

		return self.retypeAsLibraryAlias(self.emitLiteral(try self.concreteSizeofBytes(operand, sizeofTok: sizeofTok), valueType: MaxonType.integer, range: SourceRange.ofToken(sizeofTok)), aliasName: CountAliasName)
	end 'parseSizeof'

	function emitIntrinsicAnswer(runtimeName ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultAlias ByteArray, resultNameId TypeNameId, range SourceRange) returns ValueId
		if not resultAlias.isEmpty() 'anAliasedAnswer'
			return self.emitLibraryAliasedRuntimeCall(runtimeName, args: args, alias: resultAlias, range: range)
		end 'anAliasedAnswer'

		if resultTag == ValueTypeTag.integer 'aBareNumber'
			panic("emitIntrinsicAnswer: `{String.from(runtimeName)}` answers a bare integer, and no program may hold one — name the alias its answer belongs to")
		end 'aBareNumber'

		return self.emitRuntimeCall(runtimeName, args: args, resultTag: resultTag, resultNameId: resultNameId, range: range)
	end 'emitIntrinsicAnswer'

	function emitLibraryAliasedRuntimeCall(callee ByteArray, args ValueIdArray, alias ByteArray, range SourceRange) returns ValueId
		let answer = self.signatures.libraryAliasType(alias, into: self.artifact.typeNames)
		return self.emitRuntimeCall(callee, args: args, resultTag: maxonTypeTag(answer), resultNameId: typeNameIdOf(answer), range: range)
	end 'emitLibraryAliasedRuntimeCall'

	function retypeAsLibraryAlias(value ValueId, aliasName ByteArray) returns ValueId
		self.retypeValue(value, valueType: self.signatures.libraryAliasType(aliasName, into: self.artifact.typeNames))
		return value
	end 'retypeAsLibraryAlias'

	// The byte size of a CONCRETE `sizeof` operand, computed at parse time. A struct is its full laid-out
	// box (`StructLayout.sizeBytes`); a generic INSTANCE is the base struct's box; every non-aggregate type
	// is its `primitiveTypeByteSize`. `typeParameter` never reaches here (its caller routes it to the
	// descriptor path); `unresolved` is a TypeResolution bug and `void` is not a value type.
	function concreteSizeofBytes(t MaxonType, sizeofTok Token) returns FullRangeInt throws SourceParseError
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.structRef 'struct'
			return self.namedStructSizeBytes(typeNameIdOf(t))
		end 'struct'

		if tag == ValueTypeTag.genericInstance 'instance'
			// ⚠ **AN INSTANCE IS INTERNED FOR WHATEVER A `with` NAMED, SO THE BASE MAY BE NOTHING AT ALL**, and
			// this fold runs at PARSE time while the E2055 `checkGenericSpellings` reports against that `with`
			// comes whole-program, later — so without a refusal here `sizeof(IntMap)` for `typealias IntMap =
			// Map with (Int, Int)` reaches `genericInstanceBoxSize` and dies with a stack trace and no
			// `error E….` at all. The refusal is that E2055's own text, so the drain drops it once that E2055
			// is reported (`Parser.missingBaseLayout`). A BUILTIN base is NOT refused: its box is the fixed record
			// and `sizeof(Array with Int)` is 48 — which is why the gate is `genericInstanceBaseIsKnown` and not
			// the field walks' `genericInstanceHasBaseLayout`.
			if not self.signatures.genericInstanceBaseIsKnown(genericInstanceIdOf(t)) 'unknownBase'
				throw self.undeclaredGenericBaseRefusal(self.signatures.genericInstanceBaseName(genericInstanceIdOf(t)), tok: sizeofTok)
			end 'unknownBase'

			// The instance's box size is THE one authority on ProgramSignatures — the same
			// `genericInstanceBoxSize` the descriptor's `size@0` slot is emitted through — so a concrete
			// `sizeof(Box with Integer)` folded here and a `sizeof(T)` descriptor read for the same instance
			// cannot drift apart. The gid is whole-program (resolved in the real parse), so it needs no
			// file-local interner, unlike the `structRef` arm above.
			return self.signatures.genericInstanceBoxSize(genericInstanceIdOf(t)) as FullRangeInt
		end 'instance'

		// ⭐ **`sizeof(byte)` IS ONE, AND THE SPELLING ARRIVES HERE AS A BARE NAME.** The compiler has no `byte`
		// keyword (`ByteTypeName`), so it resolves to no declaration and reaches the tag table below as
		// `named`, which sizes a machine word. `specs/sizeof.md` says one byte.
		if tag == ValueTypeTag.named and self.namesTheBytePrimitive(t) 'aBytePrimitive'
			return BytePrimitiveSizeBytes as FullRangeInt
		end 'aBytePrimitive'

		return primitiveTypeByteSize(tag) as FullRangeInt
	end 'concreteSizeofBytes'

	// Whether a `named` type is the bare `byte` primitive rather than a DECLARATION of that spelling. A
	// program is free to declare `typealias byte = …` or `enum byte`, and then the size is that
	// declaration's — the primitive is only what the name means when nothing else claims it.
	function namesTheBytePrimitive(t MaxonType) returns bool
		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(t)) otherwise panic("namesTheBytePrimitive: a `named` operand's id is not in this file's interner — `parseTypeReference` interned it there")

		if not name.equals(ByteTypeName) 'notTheSpelling'
			return false
		end 'notTheSpelling'

		if self.signatures.containsEnumFor(name, readerFilePath: self.job.path) 'aDeclaredEnum'
			return false
		end 'aDeclaredEnum'

		return match self.signatures.aliasOf(name, readerFilePath: self.job.path) 'alias'
			declared gives false
			undeclared gives true
		end 'alias'
	end 'namesTheBytePrimitive'

	// The full box byteSize of a declared struct, by its interned name id (a `structRef` operand's id is
	// against THIS file's interner, so it resolves through the file table, not the merged one).
	function namedStructSizeBytes(id TypeNameId) returns FullRangeInt
		let name = try self.artifact.typeNames.nameOf(id) otherwise panic("namedStructSizeBytes: a `structRef` id is not in this file's interner — `resolveNamedStruct` interned it from a name in the same table")

		match self.signatures.structFor(name, readerFilePath: self.job.path) 'lookup'
			declared(layout) then return layout.sizeBytes() as FullRangeInt
			undeclared then panic("namedStructSizeBytes: `structRef` names '{String.from(name)}', which `resolveNamedStruct` only tags for a declared struct")
		end 'lookup'
	end 'namedStructSizeBytes'

	// ⭐⭐ **`countof(Type)`** — how many ELEMENTS a fixed-size container type holds, `sizeof`'s twin
	// one axis over: that one answers in BYTES per value, this one in ELEMENTS per instance. Three
	// outcomes, decided by where the operand's count lives:
	//
	//   • An instance that states one (`FixedArray with 3 Int`, and every alias for it) is a COMPILE-TIME
	//     CONSTANT folded to a `literal` right here, which is where the instance registry lives. It cannot
	//     ride the op for `parseSizeof`'s reason one door over.
	//   • The sized container's OWN `Self` states none — `ProgramSignatures.ownRecordSelfInstance`
	//     interns at `InstanceShape.unsized`, deliberately, so ONE shared body serves every size
	//     (`substitutedShape`) — so inside `type FixedArray uses Element` there is no compile-time answer,
	//     and the expression IS the hidden FIXED-ELEMENT-COUNT parameter every call site fills in — a
	//     constant from a receiver that states its count, the record's length from a runtime-sized
	//     receiver — so it emits NO OP AT ALL, the way a `let` bound to a literal emits none: the
	//     value is already defined, by the entry block's `param`.
	//   • A runtime-sized instance (`FixedArray with Int`) is refused (E2015): its length belongs to
	//     the value, so there is no type-level answer to fold.
	//
	// ⛔⛔ **THE COUNT TRAVELS IN ITS OWN HIDDEN PARAMETER AND NOT AS A LAYOUT-DESCRIPTOR WORD, AND THAT
	// IS A MEASUREMENT.** See `ProgramSignatures.fixedElementCountNeeds`: a descriptor word describes the type
	// ARGUMENT, is FORWARDED wholesale to a callee whose instance is written over the caller's parameters, and
	// therefore cannot carry a fact about the INSTANCE — a `FixedArray with 4 Element` reached from inside
	// `type Holder uses Element` read Holder's count, 0, instead of 4.
	//
	// ⭐ Its gate is the count slot. A static fills it from
	// the instance it returns (`FixedArray.create()`, the whole reason this expression exists) or the
	// instance its call names. A body the count scan did not see gets a positioned refusal rather than
	// a compiler abort.
	function parseCountof() returns ValueId throws SourceParseError
		let operand = try self.parseCountofOperand()
		let countofTok = operand.0
		let count = try self.fixedElementCountValue(operand.1, anchor: countofTok)

		if self.constIsKnown(count) 'aStatedCount'
			return self.retypeAsLibraryAlias(count, aliasName: CountAliasName)
		end 'aStatedCount'

		return self.emitRetaggedCastValue(count, targetType: self.signatures.libraryAliasType(CountAliasName, into: self.artifact.typeNames), range: SourceRange.ofToken(countofTok))
	end 'parseCountof'

	function parseCountofOperand() returns (Token, GenericInstanceId) throws SourceParseError
		let countofTok = try self.consume(TokenKind.countof)
		try self.consume(TokenKind.leftParen)
		let operand = resolveNamedStruct(try self.parseTypeReference(BarePrimitiveVoice.admitted), typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: self.job.path)
		try self.consume(TokenKind.rightParen)

		// ⚠ **A COUNT IS A COORDINATE OF THE INSTANCE, SO ONLY AN INSTANCE CAN HAVE ONE.** A primitive, a
		// declared struct, a type PARAMETER and an unsized container all answer nothing here — and answering 0
		// would be a sentinel the caller has no way to tell from a real count.
		//
		// ⛔ Asked through `isFixedArrayInstanceAt`, the (tag, id) PAIR door, and not through `isFixedArrayInstance`
		// plus a hand-written tag test: a `TypeNameId` and a `GenericInstanceId` share one numeric space, so
		// the id half alone can answer TRUE about an instance this operand is not. That door exists for
		// exactly this shape and stating the pairing here again would be the same rule written twice.
		if not self.signatures.isFixedArrayInstanceAt(maxonTypeTag(operand), nameId: typeNameIdOf(operand)) 'noElementCount'
			throw self.countofStatesNoCount(countofTok)
		end 'noElementCount'

		match self.signatures.elementCountSourceOf(maxonTypeTag(operand), nameId: typeNameIdOf(operand)) 'source'
			inTheRecord then throw SourceParseError.unsupported("countof of a runtime-sized fixed array — its length is part of the value and not of the type, so ask the value for its `count()`, or name a sized alias (`typealias Sized = FixedArray with 4 Int`) and take `countof(Sized)`", line: countofTok.line, column: countofTok.column)
			stated or
			callerSlot then break
		end 'source'

		return (countofTok, genericInstanceIdOf(operand))
	end 'parseCountofOperand'

	function countofStatesNoCount(countofTok Token) returns SourceParseError
		return SourceParseError.unsupported("countof of a type that states no element count — only a fixed-size container type has one (`FixedArray with 3 Int`, or `Self` inside the sized container's own body). A growable `Array`'s length is a runtime field of the record, not part of its type, so ask it for its `count()`", line: countofTok.line, column: countofTok.column)
	end 'countofStatesNoCount'

	// The count of one sized instance, at the parse: a literal when the instance states one, this
	// function's own hidden slot when the caller supplies it, and a refusal for a runtime-sized
	// instance, whose length is the building call's own argument. Two askers and one answer: the
	// `countof(T)` expression a program writes, and the `Self{}` construction
	// `stdlib/FixedArray.maxon`'s `create()` is. They must agree exactly — a record built with one
	// number and read back through another is a `count()` that disagrees with `get()`, a silent wrong
	// answer.
	//
	// A closure body is emitted as its own top-level function, so it reads the enclosing method's slot out
	// of its environment (`enclosingThroughEnv`), captured at the literal.
	function fixedElementCountValue(giid GenericInstanceId, anchor Token) returns ValueId throws SourceParseError
		match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: giid as TypeNameId) 'source'
			stated(count) then return self.emitLiteral(count as FullRangeInt, valueType: MaxonType.integer, range: SourceRange.ofToken(anchor))
			inTheRecord then throw runtimeSizedCreateNeedsALength(String.from(anchor.value), memberTok: anchor)
			callerSlot then break
		end 'source'

		match self.bodyState.fixedElementCountParam 'countParam'
			slot(valueId) then return valueId
			enclosingThroughEnv then return self.closureEnvWord(self.closureHiddenWordSlot(ClosureHiddenWord.fixedElementCount), anchor: anchor)
			none then throw SourceParseError.unsupported("countof of the sized container's own `Self`, in a function that carries no fixed-element-count parameter — the count of a countless `Self` is the RECEIVER's, and it reaches a shared body through a hidden argument every call site fills in from the instance it holds. A default argument is evaluated in a helper function of its own, which holds no such argument to read: read `countof(Self)` in the body of a method of the sized container", line: anchor.line, column: anchor.column)
		end 'countParam'
	end 'fixedElementCountValue'

	// `( <expr> )` — grouping, which is what makes `(2 + 3) * 4` mean 20 rather than 14.
	// The parentheses produce NO op: the group's value IS the inner expression's, so the
	// only thing they change is the shape of the tree the climber builds.
	//
	// It re-enters the climber at the LOOSEST level (via `parseValueExpression`, so `(a if c else b)`
	// groups a ternary), restoring every operator — `not (a or b)` is the `or` of two bools, `(x > 0)
	// and (y > 0)` groups explicitly. It does NOT go through `parseExpression`, which would re-seed
	// `currentBlock` and undo any short-circuit that moved it.
	//
	// ⭐ **A COMMA AFTER THE FIRST INNER EXPRESSION IS WHAT MAKES IT A TUPLE INSTEAD**, and that is the
	// whole disambiguator. It is decided AFTER the first element is parsed rather than by a lookahead,
	// because no bounded lookahead can find the comma: `(f(a, b), c)` has one at depth 1 first.
	function parenGroupWrapsOneGroup(open ElementIndex) returns bool
		let inner = open + 1

		if self.kindAt(inner) != TokenKind.leftParen 'notAGroupInAGroup'
			return false
		end 'notAGroupInAGroup'

		return self.kindAt(self.parenGroups.closeOf(self.tokens, open: inner) + 1) == TokenKind.rightParen
	end 'parenGroupWrapsOneGroup'

	function parseParenthesizedExpression(func IrFunction) returns ValueId throws SourceParseError
		let openIndex = self.pos
		let target = self.takeTupleLiteralTargetAt(self.pos)
		let openTok = try self.consume(TokenKind.leftParen)

		// Captured before the element is parsed so `rhsWasBareLocalReference` can decide, afterwards, whether
		// it was a bare local — which is what a MANAGED element's move-in poisons. The struct literal's
		// discipline (`parseStructLiteralFields`), for the identical reason.
		let firstStart = self.pos

		if self.parenGroupWrapsOneGroup(openIndex) 'aWrappedGroup'
			self.stateTupleLiteralTargetAt(target, tokenIndex: firstStart)
		end 'aWrappedGroup' else 'theFirstColumn'
			self.stateTupleColumnTargetAt(target, column: 0, valueStart: firstStart)
		end 'theFirstColumn'

		let value = try self.parseClaimedValueExpression(func, rangeIsAValue: true)

		if not self.at(TokenKind.comma) 'grouping'
			try self.consume(TokenKind.rightParen)
			return value
		end 'grouping'

		self.releaseCompletedOperand()
		return try self.parseTupleLiteral(func, first: value, firstStart: firstStart, openTok: openTok, target: target)
	end 'parseParenthesizedExpression'

	// ⭐ **`(e0, e1, …)` — A TUPLE LITERAL, WHICH IS A STRUCT LITERAL OF A SYNTHESIZED TYPE.** The cursor sits
	// on the comma after the first element, which the caller has already parsed.
	//
	// It ends at `emitStructLiteral` — the very routine `Self{…}` uses — so the box, its `__mm_alloc`, the
	// per-element `storeIndirect` at `offsetOfField(i)` and the STORE of a managed element (`moveInPayload`,
	// which promotes a borrowed String literal, co-owns a value a live binding keeps and adopts an owned
	// temporary) are all the machinery that already exists. A tuple gets nothing of its own, which is the point of `TupleTypeNamePrefix`.
	//
	// ⚠ **THE ELEMENT TYPES ARE THE VALUES' OWN, so there is no declared type to coerce against** — the one
	// step a struct literal takes that this cannot (`requireFieldType`). A tuple declares no field types; it
	// ADOPTS them, which is what makes `(40, 2.5)` a `(int, float)` and not an ill-typed `(int, int)`.
	// A function value is the exception: it takes the column type a receiving slot declares
	// (`declaredTupleColumnType`).
	function parseTupleLiteral(func IrFunction, first ValueId, firstStart ElementIndex, openTok Token, target DeclaredTupleTarget) returns ValueId throws SourceParseError
		let elementValues = ValueIdArray.create(0)
		let elementBareLocal = BoolArray.create(0)
		let elementTypes = MaxonTypeArray.create(0)
		let elementBrands = NameRoster.create(0)
		let elementStarts = TokenIndexArray.create(0)
		let elementCapabilities = ParamCapabilityArray.create(0)

		// ⭐ The values already stored into an owning slot of this literal — `parseStructLiteralFields`'
		// `movedOwningValues`, for its reason and with its gate: a slot that takes its OWN reference may be
		// repeated freely (`(s, s)` over a String now co-owns twice and is released twice), and only a slot
		// that INHERITS this frame's single reference makes a second occurrence E3102
		// (`repeatedOwningDestinationWouldDoubleFree`).
		let movedOwningValues = ValueIdArray.create(0)

		if self.valueIsDeferred(first) 'aDeferredFirstElement'
			return try self.deferredLiteralRest(func, entry: LiteralEntryShape.tupleElement)
		end 'aDeferredFirstElement'

		try self.collectTupleElement(elementValues, elementBareLocal: elementBareLocal, elementTypes: elementTypes, elementBrands: elementBrands, movedOwningValues: movedOwningValues, elementCapabilities: elementCapabilities, value: first, valueStart: firstStart, target: target)
		elementStarts.push(firstStart)

		while self.at(TokenKind.comma) 'eachElement'
			try self.consume(TokenKind.comma)
			let valueStart = self.pos
			self.stateTupleColumnTargetAt(target, column: elementValues.count() as FieldIndex, valueStart: valueStart)
			let value = try self.parseValueExpression(func)

			if self.valueIsDeferred(value) 'aDeferredElement'
				return try self.deferredLiteralRest(func, entry: LiteralEntryShape.tupleElement)
			end 'aDeferredElement'

			try self.collectTupleElement(elementValues, elementBareLocal: elementBareLocal, elementTypes: elementTypes, elementBrands: elementBrands, movedOwningValues: movedOwningValues, elementCapabilities: elementCapabilities, value: value, valueStart: valueStart, target: target)
			elementStarts.push(valueStart)
		end 'eachElement'

		let closeTok = try self.consume(TokenKind.rightParen)
		let layout = try self.internTupleLayout(elementTypes, brands: elementBrands, capabilities: elementCapabilities, anchor: openTok)
		try self.requireTupleColumns(layout, elementValues: elementValues, elementStarts: elementStarts, anchor: openTok)

		let literal = try self.emitStructLiteral(layout, fieldValues: elementValues, fieldBareLocal: elementBareLocal, anchor: openTok, range: SourceRange.between(openTok, last: closeTok))
		self.bodyState.lastTupleLiteral = LastTupleLiteral.built(literal, elements: elementValues)
		return literal
	end 'parseTupleLiteral'

	function tupleItemSlotOf(value ValueId, target DeclaredTupleTarget, column FieldIndex) returns ParamCapability
		match target 'target'
			layout(name) then return self.declaredTupleItemSlot(name, column: column)
			none then break
		end 'target'

		if self.valueIsAValueType(value) or self.valueIsOpaque(value) 'carriesNoCapability'
			return ParamCapability.unmarked
		end 'carriesNoCapability'

		return ParamCapability.immutable if self.effectiveCapabilityOf(value) == ValueCapability.immutable else ParamCapability.unmarked
	end 'tupleItemSlotOf'

	function declaredTupleItemSlot(declaredName ByteArray, column FieldIndex) returns ParamCapability
		let layout = self.registeredTupleLayout(declaredName)
		return layout.fieldTypeSites.capabilityAt(column)
	end 'declaredTupleItemSlot'

	// Append one parsed element to the four lockstep columns a tuple literal builds, having first refused a
	// repeated owning move. One writer, so a caller that pushed a value and forgot its type would be
	// unrepresentable — `StructLayout.addField`'s discipline applied to the literal side — and one gate, so
	// the first element (parsed by the caller before it knew this was a tuple) is checked exactly as the rest.
	//
	// The element's own type is what is passed as `fieldType`: a tuple ADOPTS its element types, so the slot
	// a value moves into is owning iff the value itself owns heap.
	function collectTupleElement(elementValues ValueIdArray, elementBareLocal BoolArray, elementTypes MaxonTypeArray, elementBrands NameRoster, movedOwningValues ValueIdArray, elementCapabilities ParamCapabilityArray, value ValueId, valueStart ElementIndex, target DeclaredTupleTarget) throws SourceParseError
		if self.valueIsLinear(value) 'aLinearItem'
			let itemTok = self.tokenAt(valueStart)
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "a tuple holds no linear value: a linear value {LinearValueResidence}, so no tuple item keeps one", line: itemTok.line, column: itemTok.column)
		end 'aLinearItem'

		try self.rejectDoubleOwningStore(movedOwningValues, value: value, valueStart: valueStart)
		let slot = self.tupleItemSlotOf(value, target: target, column: elementValues.count() as FieldIndex)
		try self.admitStore(self.bodyFunction(), slot: slot, value: value, valueStart: valueStart, place: TupleItemPlace, holder: StoreHolder.unheld)
		elementCapabilities.push(slot)
		try requireMemberCount(elementValues.count() + 1, limit: MaxDeclaredMembers, members: "tuple elements", anchor: self.tokenAt(valueStart))
		elementTypes.push(self.tupleElementColumnType(value, target: target, column: elementValues.count() as FieldIndex, anchor: self.tokenAt(valueStart)))
		elementBrands.push(self.tupleElementColumnBrand(value, target: target, column: elementValues.count() as FieldIndex))
		elementValues.push(self.holdStorageReadForStatement(value, kind: HoldKind.listOperand, range: SourceRange.ofToken(self.tokenAt(valueStart)), position: OperandSuccession.beforeComma))
		elementBareLocal.push(self.rhsWasBareLocalReference(valueStart))
	end 'collectTupleElement'

	// ⭐ **`(T0, T1, …)` IN A TYPE POSITION** — a parameter, a return type, a `typealias` RHS. It
	// resolves to the SAME `structRef` a literal of those element types mints, which is what makes
	// `sum(t (Integer, Integer))` accept the `(10, 32)` a caller built.
	// One element of a tuple TYPE, refused through the family door if it is an existential — the eighth
	// interface-typed position. An element read straight from `parseTypeReference` without that check would send an
	// `interfaceRef` into `internTupleType` → `mangleTypeArg` and PANIC in `LayoutDescriptor.primitiveTypeTagName`,
	// on an assertion that a container of existentials is refused at the front end, which holds of every OTHER
	// container. All three spellings — a `typealias`, a parameter, a return — reach it.
	//
	// Both element reads come through this one function so the first element and the rest cannot come to be
	// checked differently, which is the shape the loop above already had for `parseTypeReference`.
	function readTupleElementType(voice BarePrimitiveVoice, brands NameRoster, sites DeclaredTypeSites, capabilities ParamCapabilityArray) returns MaxonType throws SourceParseError
		let wordTok = self.current()
		let written = self.paramCapabilityAt(self.pos)

		if written == ParamCapability.isolated or written == ParamCapability.mutable 'aWordNoItemTakes'
			throw notATypeError(wordTok)
		end 'aWordNoItemTakes'

		let start = self.pos + 1 if written != ParamCapability.unmarked else self.pos
		let anchor = self.tokenAt(start)
		let (element, capability) = try self.readCapabilityQualifiedType(voice)

		if capability == ParamCapability.isolated 'anIsolatedAlias'
			throw notATypeError(wordTok)
		end 'anIsolatedAlias'

		capabilities.push(ParamCapability.immutable if capability == ParamCapability.immutable else ParamCapability.unmarked)
		try self.requireStorableDeclaredType(element, position: DeclaredStoragePosition.tupleElement, line: anchor.line, column: anchor.column)
		brands.push(self.declaredBrandAt(start, resolved: element))
		sites.noteWrittenType(anchor)
		return element
	end 'readTupleElementType'

	function parseTupleTypeReference(voice BarePrimitiveVoice) returns MaxonType throws SourceParseError
		let openTok = try self.consume(TokenKind.leftParen)

		// ⚠ `()` is not the empty tuple — the compiler has no unit type, and `void` is not a `MaxonType`
		// (`MaxonReturnType.void` carries it). Reported before the element loop so the message names the
		// construct rather than a missing type.
		if self.at(TokenKind.rightParen) 'emptyTuple'
			throw SourceParseError.unsupported("an empty tuple type '()' (a tuple has at least {MinTupleArity} elements; a function that returns nothing simply omits its `returns` clause)", line: openTok.line, column: openTok.column)
		end 'emptyTuple'

		let elements = MaxonTypeArray.create(0)
		let brands = NameRoster.create(0)
		let sites = DeclaredTypeSites.create()
		let capabilities = ParamCapabilityArray.create(0)
		elements.push(try self.readTupleElementType(voice, brands: brands, sites: sites, capabilities: capabilities))

		while self.at(TokenKind.comma) 'eachElement'
			try self.consume(TokenKind.comma)
			try requireMemberCount(elements.count() + 1, limit: MaxDeclaredMembers, members: "tuple elements", anchor: openTok)
			elements.push(try self.readTupleElementType(voice, brands: brands, sites: sites, capabilities: capabilities))
		end 'eachElement'

		try self.consume(TokenKind.rightParen)

		// ⚠ **A ONE-ELEMENT TUPLE TYPE IS REFUSED, AND `(a)` STAYS GROUPING FOREVER** — see `MinTupleArity`.
		// The EXPRESSION side needs no such check: a literal is only a tuple once a comma has been seen.
		if elements.count() < MinTupleArity 'singleElement'
			throw SourceParseError.unsupported("a one-element tuple type (a tuple has at least {MinTupleArity} elements, and parentheses around a single type would be indistinguishable from grouping)", line: openTok.line, column: openTok.column)
		end 'singleElement'

		let tupleName = (try self.internTupleLayout(elements, brands: brands, capabilities: capabilities, anchor: openTok)).name
		self.artifact.writtenTupleTypes.push(WrittenTupleType.create(tupleName, filePath: self.job.path, sites: sites))

		return MaxonType.structRef(self.artifact.typeNames.intern(tupleName))
	end 'parseTupleTypeReference'

	// ⭐ **THE DOOR A PARSED TUPLE TYPE IS MINTED THROUGH** — a literal, a type annotation, a `typealias` RHS.
	// It interns the type whole-program through `internedTupleName`, and files THIS FILE's own copy of the layout as an artifact contribution, so `mergeArtifact`
	// commits it to `project.structTypes` and `installStructDestructors` synthesizes the drop cascade for a
	// tuple that owns a String. Both registrations happen here, together, because a layout in one and not the
	// other is what makes the destructor installer ask a question the index cannot answer.
	//
	// ⛔ **THE LAYOUT HANDED BACK IS THE INDEX'S OWN, NEVER THE ARTIFACT COPY FILED HERE.** The copy's
	// field-type ids are this file's numbering of the names, and every reader of a layout's field types
	// resolves them against the index's interner (`ProgramSignatures.fieldTypeOf`'s precondition). Read that
	// way, a sweep-minted `named` element denotes whichever name the index numbered alike — a record element
	// classified scalar is stored raw and released at scope exit.
	function internTupleLayout(elements MaxonTypeArray, brands NameRoster, capabilities ParamCapabilityArray, anchor Token) returns StructLayout throws SourceParseError
		let name = try self.internedTupleName(elements, brands: brands, capabilities: capabilities, from: self.artifact.typeNames, anchor: anchor)

		if not self.memos.filedTupleNames.contains(name) 'firstMintInThisFile'
			self.memos.filedTupleNames.insert(name)
			self.artifact.recordStructType(self.signatures.adoptTupleLayout(name, into: self.artifact.typeNames))
		end 'firstMintInThisFile'

		return self.registeredTupleLayout(name)
	end 'internTupleLayout'

	function internedTupleName(elements MaxonTypeArray, brands NameRoster, capabilities ParamCapabilityArray, from TypeNameInterner, anchor Token) returns immutable ByteArray throws SourceParseError
		let name = try self.signatures.internTupleType(elements, written: brands, capabilities: capabilities, from: from, slotScopeFilePath: self.job.path) otherwise (rejection) 'rejected'
			throw self.tupleElementError(rejection, anchor: anchor)
		end 'rejected'

		return name
	end 'internedTupleName'

	// The index's layout for the tuple type `name`. Precondition: `name` is a tuple `structRef`'s name, which
	// is why a miss is a panic — every tuple type in the compiler is registered by `internTupleType` before
	// anything is typed with it. A tuple's name is unspellable in source, so no alias can shadow it and the
	// reader-scoped `structFor` has nothing to add.
	function registeredTupleLayout(name ByteArray) returns StructLayout
		match self.signatures.structInAnyFile(name) 'registered'
			declared(layout) then return layout
			undeclared then panic("registeredTupleLayout: the tuple `{String.from(name)}` is not registered — every tuple `structRef` in the compiler names a layout `internTupleType` registered before it handed the name back")
		end 'registered'
	end 'registeredTupleLayout'

	// Does the enclosing declaration declare any nested typealias at all?
	function scopeDeclaresAnInnerAlias() returns bool
		match self.enclosingInnerAliases 'scope'
			unwritten then return false
			entries(declared) then return declared.count() != 0
		end 'scope'
	end 'scopeDeclaresAnInnerAlias'

	// The declared buffer surface recorded for the slots `value` holds, or the empty one.
	function slotSurfaceOf(value ValueId) returns immutable DeclaredSurface
		return bodySlotSurface(self.bodyState, value: value)
	end 'slotSurfaceOf'

	// Does that member take a receiver?
	function siblingReceiverTakesReceiver(name ByteArray) returns bool throws MapError
		match self.siblingReceivers 'declaration'
			unwritten then throw MapError.keyNotFound
			entries(members) then return try members.get(name)
		end 'declaration'
	end 'siblingReceiverTakesReceiver'

	// Must a local called `name` live in a cell?
	function nameLivesInACell(name ByteArray) returns bool
		match self.bodyState.cellLocalNames 'body'
			unwritten then return false
			entries(names) then return names.contains(name)
		end 'body'
	end 'nameLivesInACell'

	// ⭐⭐ **THE INSTALL DOORS.** A `match` arm binds its payload IMMUTABLY and is ONE statement
	// (E3207), so a table cannot be written in the arm that reads it. Each door below installs the
	// table on the first write and ANSWERS it; the caller binds the answer to a `var` and writes
	// through that.

	// The counted-loop interval column.
	function countedValueRangesForWrite() returns ProvenIntRangeMap
		match self.bodyState.countedValueRanges 'state'
			unwritten then break
			entries(proven) then return proven
		end 'state'

		let fresh = ProvenIntRangeMap.create()
		self.bodyState.countedValueRanges = ProvenIntRangeColumn.entries(fresh)
		return fresh
	end 'countedValueRangesForWrite'

	// Did a counted loop prove an interval anywhere in this function?
	function functionProvedAnInterval() returns bool
		match self.bodyState.countedValueRanges 'function'
			unwritten then return false
			entries(proven) then return proven.count() != 0
		end 'function'
	end 'functionProvedAnInterval'

	// The parameterized-interface instance column.
	function valueExistentialInstancesForWrite() returns ValueExistentialInstanceMap
		match self.bodyState.valueExistentialInstance 'state'
			unwritten then break
			entries(byValue) then return byValue
		end 'state'

		let fresh = ValueExistentialInstanceMap.create()
		self.bodyState.valueExistentialInstance = ValueExistentialInstanceColumn.entries(fresh)
		return fresh
	end 'valueExistentialInstancesForWrite'

	function recordValueCallInstance(result ValueId, instance GenericInstanceId)
		let byValue = self.valueCallInstancesForWrite()
		byValue.upsert(result, value: instance)
	end 'recordValueCallInstance'

	function valueCallInstancesForWrite() returns ValueCallInstanceMap
		match self.bodyState.valueCallInstance 'state'
			unwritten then break
			entries(byValue) then return byValue
		end 'state'

		let fresh = ValueCallInstanceMap.create()
		self.bodyState.valueCallInstance = ValueCallInstanceColumn.entries(fresh)
		return fresh
	end 'valueCallInstancesForWrite'

	// The instance `value`'s declared existential type named, if one did.
	function existentialInstanceOfValue(value ValueId) returns GenericInstanceId throws MapError
		match self.bodyState.valueExistentialInstance 'function'
			unwritten then throw MapError.keyNotFound
			entries(byValue) then return try byValue.get(value)
		end 'function'
	end 'existentialInstanceOfValue'

	function existentialClaimOfValue(value ValueId) returns ExistentialClaim throws MapError
		let instance = try self.existentialInstanceOfValue(value)

		match self.bodyState.valueExistentialScope 'function'
			unwritten then panic("existentialClaimOfValue: v{value} holds an existential instance but the scope column was never written — `recordValueExistentialInstance` writes both")
			entries(byValue) then return ExistentialClaim.create(instance, scopeFilePath: try byValue.get(value) otherwise panic("existentialClaimOfValue: v{value} holds an existential instance and no scope — `recordValueExistentialInstance` writes both"))
		end 'function'
	end 'existentialClaimOfValue'

	function valueExistentialScopesForWrite() returns ValueExistentialScopeMap
		match self.bodyState.valueExistentialScope 'state'
			unwritten then break
			entries(byValue) then return byValue
		end 'state'

		let fresh = ValueExistentialScopeMap.create()
		self.bodyState.valueExistentialScope = ValueExistentialScopeColumn.entries(fresh)
		return fresh
	end 'valueExistentialScopesForWrite'

	// The deferred-diagnostic candidate list.
	function declaredTypeAliasesForWrite() returns DeferredNameDiagnosticArray
		match self.declaredTypeAliases 'state'
			unwritten then break
			entries(recorded) then return recorded
		end 'state'

		let fresh = DeferredNameDiagnosticArray.create(0)
		self.declaredTypeAliases = DeferredNameDiagnosticRoster.entries(fresh)
		return fresh
	end 'declaredTypeAliasesForWrite'

	// The tuple-slot surface column.
	function bufferSurfaceSlotsForWrite() returns ValueSlotSurfaceMap
		match self.bodyState.bufferSurfaceSlots 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = ValueSlotSurfaceMap.create()
		self.bodyState.bufferSurfaceSlots = ValueSlotSurfaceColumn.entries(fresh)
		return fresh
	end 'bufferSurfaceSlotsForWrite'

	// The character-literal op table.
	function charLiteralOpsForWrite() returns CharLiteralOpMap
		match self.bodyState.charLiteralOps 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = CharLiteralOpMap.create()
		self.bodyState.charLiteralOps = CharLiteralOpTable.entries(fresh)
		return fresh
	end 'charLiteralOpsForWrite'

	// The folded index-call site table.
	function foldedIndexCallSitesForWrite() returns FoldedIndexCallSiteMap
		match self.bodyState.foldedIndexCallSites 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = FoldedIndexCallSiteMap.create()
		self.bodyState.foldedIndexCallSites = FoldedIndexCallSiteTable.entries(fresh)
		return fresh
	end 'foldedIndexCallSitesForWrite'

	// The nested-typealias roster of the enclosing declaration.
	function innerAliasesForWrite() returns InnerAliasNameSet
		match self.enclosingInnerAliases 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = InnerAliasNameSet.create()
		self.enclosingInnerAliases = InnerAliasRoster.entries(fresh)
		return fresh
	end 'innerAliasesForWrite'

	// The mutable-binding name index.
	function mutableVarIndexForWrite() returns MutableVarPositionByName
		match self.bodyState.mutableVarInnermost 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = MutableVarPositionByName.create()
		self.bodyState.mutableVarInnermost = MutableVarNameIndex.entries(fresh)
		return fresh
	end 'mutableVarIndexForWrite'

	// The byte-view op table.
	function stringBytesViewOpsForWrite() returns StringBytesViewOpMap
		match self.bodyState.stringBytesViewOps 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = StringBytesViewOpMap.create()
		self.bodyState.stringBytesViewOps = StringBytesViewOpTable.entries(fresh)
		return fresh
	end 'stringBytesViewOpsForWrite'

	// The declared-alias column.
	function valueDeclaredAliasesForWrite() returns ValueDeclaredAliasMap
		match self.bodyState.valueDeclaredAlias 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = ValueDeclaredAliasMap.create()
		self.bodyState.valueDeclaredAlias = ValueDeclaredAliasTable.entries(fresh)
		return fresh
	end 'valueDeclaredAliasesForWrite'

	function literalCastsForWrite() returns LiteralCastSpanMap
		match self.bodyState.literalCasts 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = LiteralCastSpanMap.create()
		self.bodyState.literalCasts = LiteralCastTable.entries(fresh)
		return fresh
	end 'literalCastsForWrite'

	function literalCastArgumentsForWrite() returns LiteralCastMap
		match self.bodyState.literalCastArguments 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = LiteralCastMap.create()
		self.bodyState.literalCastArguments = LiteralCastArgumentTable.entries(fresh)
		return fresh
	end 'literalCastArgumentsForWrite'

	// The witness-slot memo.
	function witnessSlotsForWrite() returns WitnessSlotsByDeclIndex
		match self.witnessSlotsByInterface 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = WitnessSlotsByDeclIndex.create()
		self.witnessSlotsByInterface = WitnessSlotTable.entries(fresh)
		return fresh
	end 'witnessSlotsForWrite'

	// Is `name` a nested typealias of the enclosing declaration?
	function namesAnEnclosingInnerAlias(name ByteArray) returns bool
		match self.enclosingInnerAliases 'scope'
			unwritten then return false
			entries(declared) then return declared.contains(name)
		end 'scope'
	end 'namesAnEnclosingInnerAlias'

	// The ranged alias a cast recorded on `value`.
	function castAliasOf(value ValueId) returns TypeNameId throws MapError
		match self.bodyState.valueDeclaredAlias 'function'
			unwritten then throw MapError.keyNotFound
			entries(recorded) then return try recorded.get(value)
		end 'function'
	end 'castAliasOf'

	// The op `emitCharacterLiteral` filed for `value`.
	function filedCharLiteralOp(value ValueId) returns ElementIndex throws MapError
		match self.bodyState.charLiteralOps 'function'
			unwritten then throw MapError.keyNotFound
			entries(filed) then return try filed.get(value)
		end 'function'
	end 'filedCharLiteralOp'

	// The op the byte-view producer filed for `value`.
	function filedStringBytesViewOp(value ValueId) returns ElementIndex throws MapError
		match self.bodyState.stringBytesViewOps 'function'
			unwritten then throw MapError.keyNotFound
			entries(filed) then return try filed.get(value)
		end 'function'
	end 'filedStringBytesViewOp'

	// Where the index call that produced `value` was emitted.
	function filedIndexCallSite(value ValueId) returns FoldedIndexCallSite throws MapError
		match self.bodyState.foldedIndexCallSites 'function'
			unwritten then throw MapError.keyNotFound
			entries(filed) then return try filed.get(value)
		end 'function'
	end 'filedIndexCallSite'

	// Turn a whole-program tuple-element rejection into a POSITIONED diagnostic. The index raises it (only it
	// knows what a canonical element is); the parser is the only party holding a token to anchor it on, which
	// is why the two halves are split at all.
	//
	// ⚠ **IT MINTS `tupleElementRejected` AND NOT `unsupported`, AND THE TWO RENDER IDENTICALLY** — see that
	// case. The sentence and the code are unchanged; what the dedicated case buys is that the declaration
	// sweep can tell this failure (which the real parse does not re-raise) from a malformed return type
	// (which it does). This is THE one minter of it.
	function tupleElementError(rejection TupleElementRejection, anchor Token) returns SourceParseError
		return SourceParseError.tupleElementRejected(tupleElementRejectionSentence(rejection), line: anchor.line, column: anchor.column)
	end 'tupleElementError'

	// ⭐⭐ **EVERY CHARACTER LITERAL IS A `Character`, AND AN INTEGER-EXPECTING POSITION COERCES IT TO ITS
	// CODEPOINT AT COMPILE TIME** (user ruling 2026-08-05). `'a'`, `'\n'`, `'0'`, `'é'`, `'🎉'` and a
	// whole EGC all materialize the same way: an immortal `.rdata` byte record, typed `character`.
	//
	// It is what `specs/char-literal-to-int.md`'s own Documentation describes — *"the compiler
	// automatically converts the character literal to its Unicode codepoint value at compile time"*,
	// which is a statement about a CONVERSION and therefore about a literal that was something else
	// first.
	//
	// ⚠ **A WIDTH RULE — one byte an `int`, wider a `Character` — WOULD LEAVE A TYPE HOLE, not a divergence in wording.**
	// `'A'.asciiValue()` would be *"'int' has no method named 'asciiValue'"* where the oracle prints 65; `let c = 'G'` would
	// bind an `int` so a Character `match` arm could not see it; `for c in 'a' to 'e'` would print `97 98 99 100 101`;
	// and `Self{ch: 'e'}` / `f(target: 'a')` would be refused at a `Character` field and a `Character` parameter. All
	// five are one fact — the literal is typed by what it IS rather than by its bytes — and all five close here.
	//
	// ⚠ **THE INTEGER DIRECTION IS `integerizedOperand`, AND IT REWRITES RATHER THAN ORPHANS.** See there: a
	// discarded `stringLiteral` op still registers `.rdata`, so `cp == '-'` must never MATERIALIZE a record it
	// does not use. `cp == '-'`, `cp - '0'` and `if c >= '0'` therefore emit exactly the op an integer literal does.
	function parseCharLiteral() returns ValueId throws SourceParseError
		let tok = try self.consume(TokenKind.charLiteral)
		return self.emitCharacterLiteral(try self.charLiteralBytes(tok), range: SourceRange.ofToken(tok))
	end 'parseCharLiteral'

	// A `charLiteral` token's payload decoded to the UTF-8 bytes of the one character it holds, or the
	// positioned diagnostic the literal earned. THE one door onto `decodeCharLiteral` for every site that
	// wants BYTES — `parseCharLiteral` and `charLiteralCodepoint` — so a literal one of them accepts and
	// the other rejects cannot differ (`decodedStringLiteralBytes` is the String
	// twin, and exists for the same reason).
	//
	// The `byte`/`multiByte` split survives only INSIDE here, where it is what it always was: a fact about
	// how many bytes the character occupies, and no longer a fact about its type.
	function charLiteralBytes(tok Token) returns immutable ByteArray throws SourceParseError
		match decodeCharLiteral(tok.value) 'decoded'
			byte(value) then return byteSlice(value)
			multiByte(bytes) then return bytes
			empty then throw SourceParseError.invalidCharacterLiteral("a character literal must contain exactly one character", line: tok.line, column: tok.column)
			badEscape(text) then throw SourceParseError.invalidCharacterLiteral("unknown escape sequence '{text}'", line: tok.line, column: tok.column)
			badDigitEscape(text, offset, marker) then throw invalidDigitEscapeError(text, kind: LiteralEscapeKind.characterLiteral, offset: offset, marker: marker, tok: tok)
			malformedText then throw malformedLiteralTextError(LiteralEscapeKind.characterLiteral, tok: tok)
		end 'decoded'
	end 'charLiteralBytes'

	// ⭐⭐ **A CHARACTER LITERAL IN AN INTEGER-EXPECTING POSITION IS ITS CODEPOINT** — the whole of the
	// ruling's second half, at the one kind of site that can unambiguously ask for it.
	//
	// Every character literal materializes as a `Character` (`parseCharLiteral`). What `cp == '-'`,
	// `cp - '0'` and `if c >= '0'` need is the other direction, and it is the direction
	// `specs/char-literal-to-int.md` names outright: *"the compiler automatically converts the
	// character literal to its Unicode codepoint value at compile time"*. The coercion happens here
	// and nowhere else: `cp == 'é'` compares against **233** and `'A' + 1` is **66**, while `f(x
	// Small)` called as `f('A')` is refused (*"expected 'Small', got 'Character'"*). So this is a rule
	// about OPERANDS and DECLARED SLOTS, never a general int↔Character conversion.
	//
	// ⚠ **IT KEYS ON THE OPERAND BEING A LITERAL, NEVER ON THE TWO TAGS.** `c == 45` where `c` is a
	// Character binding stays a type error, so nothing here makes two different tags comparable, and
	// `character-ownership.md`'s `string-and-character-do-not-compare` still pins its half.
	//
	// ⚠⚠ **THE `.rdata` RECORD IS REWRITTEN, NOT ORPHANED, AND THAT IS NOT A TIDINESS CHOICE.**
	// `LowerMaxonToStd.lowerStringLiteral` walks `block.opRefs` and registers a blob + a 56-byte record +
	// a fixup for EVERY `stringLiteral` op it finds, read or not; `foldConstOperands`'s const DCE
	// deliberately excludes `rdataAddr`, and no general DCE pass is scheduled. One orphan in a
	// stdlib module would therefore renumber every later `__str_blob_`/`__jumptable_` label in EVERY
	// program off the single `GlobalDataTable.nextStringId` counter. Rewriting the op in place leaves
	// the op stream, the op INDEX, the ValueId and the source range exactly as an integer literal's
	// are, so `cp == '-'` emits the code an integer literal emits.
	function integerizedOperand(value ValueId, expected ValueTypeTag, start ElementIndex, pastEnd ElementIndex) returns ValueId throws SourceParseError
		if not tagIsIntegral(expected) or self.tagOf(value) != ValueTypeTag.character 'notAnIntegerPosition'
			return value
		end 'notAnIntegerPosition'

		// The operand must be the character literal ITSELF and nothing else: exactly one token, and that
		// token a `charLiteral`. A compound expression that merely CONTAINS one spans more than one token
		// and is left alone, which is what keeps this a rule about literals — and, with the tag test above,
		// what stops a Character BINDING (`let c = 'a'` then `c == 45`) from being silently re-typed.
		if pastEnd != start + 1 or self.kindAt(start) != TokenKind.charLiteral 'notALoneLiteral'
			return value
		end 'notALoneLiteral'

		let tok = self.tokenAt(start)

		match try self.charLiteralCodepoint(tok) 'converted'
			codepoint(cp) then return self.retypeCharLiteralAsCodepoint(value, codepoint: cp, tok: tok)

			// A cluster the coercion cannot express stays a `Character`, and the operator raises its own
			// type error over it — see `CharLiteralCodepoint`.
			cluster then return value
		end 'converted'
	end 'integerizedOperand'

	// ⭐⭐ **THE CODEPOINT A CHARACTER LITERAL DENOTES — THE one door, because two readers ask.**
	// `integerizedOperand` asks it for an operand or a declared slot; `decodeCharPatternValue` asks it for a
	// `match` INTERVAL bound, which emits no op and so cannot go through the operand path at all. Written
	// twice, one of them would have coerced `'é'` and the other refused it.
	//
	// ⚠ **A MULTI-CODEPOINT CLUSTER HAS NONE.** `'é'` and `'中'` are one codepoint each and convert (MEASURED
	// on the oracle: `cp == 'é'` compares against **233**); a ZWJ family emoji or a regional-indicator flag is
	// a SEQUENCE of codepoints, and answering with the FIRST would be a wrong number wearing a conversion's
	// name. Each caller decides what to do with that answer — stay a `Character`, or raise E2028.
	function charLiteralCodepoint(tok Token) returns CharLiteralCodepoint throws SourceParseError
		let bytes = try self.charLiteralBytes(tok)
		let decoded = decodeUtf8Sequence(bytes, start: 0)

		if decoded.byteLength != bytes.count() as ByteOffset 'notOneCodepoint'
			return CharLiteralCodepoint.cluster
		end 'notOneCodepoint'

		return CharLiteralCodepoint.codepoint(decoded.codepoint)
	end 'charLiteralCodepoint'

	function nameUnaliasedCharacterOperandsAsCodepoints(lhs ValueId, rhs ValueId)
		if not (self.operandAliasAnswer(lhs).isEmpty() and self.operandAliasAnswer(rhs).isEmpty()) 'someOperandNamesAnAlias'
			return
		end 'someOperandNamesAnAlias'

		for operand in twoArgs(lhs, second: rhs) 'eachOperand'
			if self.valueIsAnIntegerizedCharacterLiteral(operand) 'aCodepoint'
				self.retypeValue(operand, valueType: self.signatures.libraryAliasType(CodepointTypeName, into: self.artifact.typeNames))
			end 'aCodepoint'
		end 'eachOperand'
	end 'nameUnaliasedCharacterOperandsAsCodepoints'

	function valueIsAnIntegerizedCharacterLiteral(value ValueId) returns bool
		if self.tagOf(value) != ValueTypeTag.integer 'notAnInteger'
			return false
		end 'notAnInteger'

		return match self.bodyState.charLiteralOps 'column'
			unwritten gives false
			entries(filed) gives filed.contains(value)
		end 'column'
	end 'valueIsAnIntegerizedCharacterLiteral'

	// ⭐⭐ **REPLACE A CHARACTER LITERAL'S `stringLiteral` OP WITH THE INTEGER `literal` OP IT WOULD HAVE
	// BEEN, IN PLACE** — the write `integerizedOperand`'s header argues for. Everything an emitted integer
	// literal carries is restored on the SAME ValueId: the op, the two type columns, and the parser's
	// constant view (without which `53 - '0'` would stop folding and every fold-sensitive `TargetIr`
	// pin would move).
	//
	// The op INDEX comes from `charLiteralOps`, filed by `emitCharacterLiteral` — an O(1) read where
	// `ValueOriginTable.lookup` is a linear scan its own header calls THE COLD PATH.
	function retypeCharLiteralAsCodepoint(value ValueId, codepoint FullRangeInt, tok Token) returns ValueId
		let opIndex = try self.filedCharLiteralOp(value) otherwise panic("retypeCharLiteralAsCodepoint: v{value} is tagged `character` at a lone charLiteral token '{String.from(tok.value)}' but `emitCharacterLiteral` filed no op for it — every character-tagged literal is minted there")
		try self.artifact.module.ops.set(opIndex, value: MaxonOp.literal(value, value: codepoint, valueType: MaxonType.integer)) otherwise panic("retypeCharLiteralAsCodepoint: ops.set({opIndex}) OOB — the index was filed by `emitCharacterLiteral` as it appended that very op")
		self.retypeValue(value, valueType: MaxonType.integer)
		self.recordConst(value, folded: codepoint)

		return value
	end 'retypeCharLiteralAsCodepoint'

	// ⭐ Append the `stringLiteral` op a character literal materializes as, and mint a `character`-tagged
	// value for it. It is the SAME op a String literal emits — one immortal `.rdata` byte record,
	// `capacity@16 = ImmortalRecordCapacity`, never allocated or dropped — because a Character IS that record
	// (see `GraphemeRuntime`'s header). Only the value's TAG differs, and the tag is what every rule reads,
	// so `'é' == "é"` is a type error and `print(c)` is refused while `"{c}"` works.
	function emitCharacterLiteral(bytes ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.character, nameId: UnnamedTypeId)

		// Filed BEFORE the emit, off the count that IS the index the append will land at — the same
		// `module.ops.count()` floor `parseTry` reads for the same reason.
		self.recordCharLiteralOp(result, opIndex: self.artifact.module.opCount())
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.stringLiteral(result, bytes: bytes), range: range)
		return result
	end 'emitCharacterLiteral'

	// File the op a byte-view value was produced by, so the stream-write intrinsic can rewrite it in place.
	// `recordCharLiteralOp`'s twin — same COW-off-the-shared-empty discipline, same reason.
	function recordStringBytesViewOp(value ValueId, opIndex ElementIndex)
		let filed = self.stringBytesViewOpsForWrite()
		filed.upsert(value, value: opIndex)
	end 'recordStringBytesViewOp'

	function recordCharLiteralOp(value ValueId, opIndex ElementIndex)
		// Allocated on the first write (`charLiteralOpsForWrite`), so a function that writes no character
		// literal never allocates one.
		let filed = self.charLiteralOpsForWrite()
		filed.upsert(value, value: opIndex)
	end 'recordCharLiteralOp'

	// Decode a character literal to the CODEPOINT its pattern bound denotes, or the same positioned
	// diagnostic `parseCharLiteral` gives for an empty/bad-escape literal. Its one caller is the match
	// INTERVAL plan, which needs the VALUE (a pattern bound) rather than an emitted `literal` op — which is
	// why it reaches `charLiteralCodepoint` directly instead of through `integerizedOperand`.
	//
	// ⚠ **THE INTERVAL PLAN IS ONLY EVER BUILT FOR AN INTEGER-LIKE SCRUTINEE** (`matchUsesIntervalPlan`), so
	// `scrut` here is an `int`/`bool`/`ExitCode`/ranged-alias and never a `character`. A `match` over a
	// CHARACTER scrutinee keeps the linear compare chain, whose bounds come from `emitPatternValue` and whose
	// compares are `emitCompare`'s — which is what makes a Character range arm work at all.
	function decodeCharPatternValue(tok Token, scrut ValueId) returns FullRangeInt throws SourceParseError
		match try self.charLiteralCodepoint(tok) 'converted'
			codepoint(value) then return value

			// ⚠ **A MULTI-CODEPOINT CLUSTER HERE IS A `Character` PATTERN AGAINST A NON-CHARACTER SCRUTINEE,
			// AND THAT IS AN ORDINARY TYPE MISMATCH.** An `unsupported` naming a missing feature would be the
			// wrong noun: the capability is built, and what is wrong with a cluster pattern over an `int`
			// scrutinee is that an `int` and a `Character` do not compare, exactly as a `String` pattern against
			// an `int` does not (`decodeScalarPatternBound`'s own string arm, one screen up, says it in the same
			// words).
			cluster then throw SourceParseError.matchPatternTypeMismatch(typeTagName(ValueTypeTag.character), scrutineeType: self.valueKindWord(scrut), line: tok.line, column: tok.column)
		end 'converted'
	end 'decodeCharPatternValue'

	// `"hello"`, `""`, `"Use \{expr\} for interpolation"` — a `String` LITERAL in operand position.
	// It materializes as a `stringLiteral` op carrying the DECODED bytes, typed `string`;
	// lowering turns it into an immortal `.rdata` record + a `lea` of its address (see
	// `LowerMaxonToStd.lowerStringLiteral`). No heap, no ownership — a literal is never allocated or
	// dropped.
	//
	// ⚠ AN INTERPOLATED STRING IS NOT A PLAIN LITERAL. The lexer splits `"a{x}b"` into `stringLiteral("a")`,
	// `stringInterpStart`, the `x` tokens, `stringInterpEnd`, `stringLiteral("b")` — so a `stringLiteral`
	// token FOLLOWED BY `stringInterpStart` is an interpolation, which builds an owned HEAP string and is
	// handled separately. `escaped-braces` (`\{`/`\}`) is NOT interpolation: the lexer's escape handling means the
	// braces never open one, so it is a single `stringLiteral` fragment and `decodeEscapes` turns `\{`
	// into `{` here.
	function parseStringLiteral(func IrFunction) returns ValueId throws SourceParseError
		// A `stringLiteral` FOLLOWED BY `stringInterpStart` is an interpolation (`"a{x}b"`), which builds
		// the first OWNED heap String. A lone `stringLiteral` is an immortal rdata literal.
		if self.peekKind() == TokenKind.stringInterpStart 'interpolated'
			return try self.parseStringInterpolation(func, prefix: EmptySourceText, suffix: EmptySourceText)
		end 'interpolated'

		return try self.consumeStringLiteralValue()
	end 'parseStringLiteral'

	// Consume the current NON-interpolated `stringLiteral` token and emit its decoded bytes as an immortal
	// rdata String. The shared body of the two callers that reach a plain literal — value position
	// (`parseStringLiteral`) and match-pattern position (`emitPatternValue`) — so the decode-and-emit lives
	// in one place.
	function consumeStringLiteralValue() returns ValueId throws SourceParseError
		let tok = try self.consume(TokenKind.stringLiteral)
		return self.emitStringLiteral(try self.decodedStringLiteralBytes(tok), range: SourceRange.ofToken(tok))
	end 'consumeStringLiteralValue'

	// A `stringLiteral` token's payload with its escapes resolved, or the positioned diagnostic the escape
	// earned. THE one door onto `decodeEscapes` for string literals, because there are two callers with
	// nothing else in common: the value path above, which emits a record, and `panic("…")`'s message, which
	// bakes bytes and emits no value at all. Written twice, the panic path would have been free to accept an
	// escape the value path rejects.
	function decodedStringLiteralBytes(tok Token) returns immutable ByteArray throws SourceParseError
		match decodeEscapes(tok.value, kind: LiteralEscapeKind.stringInterpolation) 'decoded'
			bytes(buf) then return buf
			unknownEscape(text) then throw SourceParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column)
			badDigitEscape(text, offset, marker) then throw invalidDigitEscapeError(text, kind: LiteralEscapeKind.stringInterpolation, offset: offset, marker: marker, tok: tok)
			malformedText then throw malformedLiteralTextError(LiteralEscapeKind.stringInterpolation, tok: tok)
		end 'decoded'
	end 'decodedStringLiteralBytes'

	// Append a `stringLiteral` op carrying the DECODED bytes; return the `string`-typed ValueId it
	// defines. The one emit site, so a caller that already holds decoded bytes
	// reaches the type + op in one
	// place.
	function emitStringLiteral(bytes ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.string, nameId: UnnamedTypeId)

		// ⭐ **THE ONE SITE THAT MINTS A `string`-TAGGED LITERAL IS THE ONE SITE THAT CAN CLAIM ITS BYTES.**
		// Filed BEFORE the emit, off the count that IS the index the append will land at —
		// `emitCharacterLiteral`'s discipline, for its reason. It is what makes `knownLiteralBytes` a fact
		// about provenance rather than a guess, and it applies to a FOLDED slice too: a fold emits through
		// this door, so the value it produces is a literal in every sense the rest of the parser can ask.
		self.recordConstPayload(result, payload: self.artifact.module.opCount() as FullRangeInt, domain: ConstPayloadDomain.stringLiteralOp)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.stringLiteral(result, bytes: bytes), range: range)
		return result
	end 'emitStringLiteral'

	// ⭐ **`b"hello"`, `b""`, `b"\xc0"`, `b"À"` — a BYTE-STRING LITERAL in operand position.**
	// It decodes to a raw byte sequence (escapes resolved, one Latin-1 byte per source codepoint) and
	// materializes as an OWNED `Array with Byte` value: a `constArrayLiteral` op that lowers to a heap 48-byte
	// Array record over an IMMORTAL rdata blob (see `LowerMaxonToStd.lowerConstArrayLiteral`). Its value type
	// is pinned to the concrete `Array with Byte` gid so `.count()`/`.get()` dispatch through a real generic
	// instance — a bare `named(Array)` would trip the generics machinery. Enrolled as an owned temp so a
	// scope-exit / statement-end drop (`__managed_decref`) frees the record (the rdata buffer is left alone).
	// A module-level CONSTANT's read reaches the same emitter with the other storage class — see
	// `ByteStringRecordStorage`. Its `Byte` is the one the file's bare `Byte` names
	// (`ProgramSignatures.internArrayByteInstance`), so an ambiguous bare `Byte` refuses the literal (E3063).
	//
	// A codepoint above 0xFF (`b"Ā"`, a `\uNNNN` naming one, an emoji) has no single-byte encoding and
	// is REJECTED with E1004 rather than silently Latin-1 best-fit-transliterated away. Use `\xNN` to
	// embed an exact raw byte.
	function parseByteStringLiteral() returns ValueId throws SourceParseError
		let tok = try self.consume(TokenKind.byteStringLiteral)
		try self.requireUnambiguousTypeName(ByteElementTypeName, anchor: tok)
		let bytes = try decodeByteStringLiteral(tok.value, tok: tok)
		return try self.emitByteStringLiteralValue(bytes, range: SourceRange.ofToken(tok))
	end 'parseByteStringLiteral'

	// Append a `constArrayLiteral` op carrying the DECODED bytes at a one-byte stride; return the owned `Array with Byte`
	// ValueId it defines. `emitStringLiteral`'s twin, and split out for its reason: a second caller
	// already holds decoded bytes — a use of a top-level managed constant (`emitManagedConstant`), whose
	// bytes were decoded once by the declaration sweep. One emit site, so the value's TYPE — the concrete
	// `Array with Byte` gid — cannot drift between the two spellings of the same literal. Their STORAGE is
	// exactly what does differ, which is why it is a parameter and not a fact this function decides
	// (`ByteStringRecordStorage`).
	function emitByteStringLiteralValue(bytes ByteArray, range SourceRange) returns ValueId throws SourceParseError
		try self.requireByteStringBlobFitsItsElement(bytes, line: range.line, column: range.column)

		let giid = self.signatures.internArrayByteInstance(self.job.path)
		let result = self.mintValue(ValueTypeTag.genericInstance, nameId: giid as TypeNameId)

		// Filed BEFORE the emit, off the count that IS the index the append will land at —
		// `recordAllocTagSite`'s contract, for its reason. The check above may throw, so it is asked first.
		self.artifact.recordImmortalConstArraySite(ImmortalRecordKind.constBlob)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.constArrayLiteral(result, elementSize: ByteStringElementSize as ElementStride, elementCount: bytes.count() as FullRangeInt, bytes: bytes), range: range)
		self.setValueCapability(result, capability: ValueCapability.immutable)
		return result
	end 'emitByteStringLiteralValue'

	// ⭐⭐ **EVERYTHING A `b"…"` BLOB MUST SATISFY TO BE A VALUE OF `Array with Byte`, ASKED IN ONE PLACE.**
	// Two rules, and they are two halves of one question — *"is this run of raw bytes a legal value of the
	// element THIS file's `Byte` denotes?"* — so they are asked together or the literal has been let through
	// on half an answer:
	//
	//   1. **THE STRIDE.** The blob is byte-PACKED by construction, so the record it produces strides 1 while
	//      every other `Array with Byte` record strides whatever `Byte`'s declared range needs. The rule, the
	//      silent wrong answer it costs, and why it is a refusal rather than a widened blob are all on
	//      `bytePackedRecordStrideMessage`, beside the words it emits.
	//   2. **THE BOUNDS.** ⛔ **A ONE-BYTE SLOT IS NOT A BYTE, AND THE STRIDE CANNOT SEE THE
	//      DIFFERENCE.** `rangedAliasStorageBytes` gives EVERY non-negative range that fits `u8.max` a
	//      one-byte slot, so `typealias Byte = int(0 to 100)` passes rule 1 and cannot hold `223`. MEASURED
	//      on `origin/main`: `takes(b"\xdf")` into `takes(b Array with Byte)` returned **223** out of an
	//      element declared `int(0 to 100)` — exit 223, no diagnostic. It is the same reading
	//      `SignatureIndex.isByteElementName`'s header records twice for the boundary door, reached this time
	//      with no compiler-synthesized buffer at all.
	//
	// ⚠ **RULE 2 IS PER-VALUE, NOT PER-TYPE, AND THAT ASYMMETRY WITH RULE 1 IS THE POINT.** A wide `Byte`
	// makes EVERY literal unemittable (the blob's layout is wrong whatever bytes are in it); a narrow one
	// makes only the literals that overflow it wrong — `b"abc"` under `int(0 to 100)` is three bytes that all
	// fit and must keep compiling. So this is the ordinary compile-time narrowing every other literal gets
	// (`literalInRange` against the element's DECLARED bounds, E3005), applied once per byte, and NOT a
	// second `unsupported`: E2015 would say *"the compiler cannot emit this"*, which is true of a wide `Byte` and
	// false here — the emission is fine and the program is wrong.
	//
	// ⚠ **THE STRIDE IS ASKED FIRST, AND THE BOUNDS TEST DEPENDS ON IT HAVING PASSED.** Bounds ride as RAW
	// 64-bit patterns (`RangedTypeAlias`), so `int(0 to u64.max)` carries `high == -1` and a negative lower
	// bound is indistinguishable from one above `i64.max`. `rangedAliasStorageBytes` gives every such range
	// the machine word, so a stride of 1 is exactly the proof that `low` and `high` are honest small
	// non-negative numbers — `literalInRange` is handed no ambiguous pattern to mis-order.
	function requireByteStringBlobFitsItsElement(bytes ByteArray, line LineNumber, column ColumnNumber) throws SourceParseError
		// ONE read of the instance, so the stride and the bounds are provably the same element's — the
		// coupling `bytearray-element-size.md` names as the thing that would go quiet if the literal ever
		// stopped resolving through `ProgramSignatures.internArrayByteInstance(readerFilePath)`.
		let giid = self.signatures.internArrayByteInstance(self.job.path)

		// Rule 1 is the shared byte-packed producers' rule (`bytePackedRecordStrideMessage`), asked of the
		// instance already in hand rather than of a second mint of it — which is the coupling above.
		try self.requireBytePackedRecordStridesLikeThisFilesByte(giid, producer: BytePackedProducer.byteStringLiteral, line: line, column: column)

		match self.signatures.arrayElementAliasOf(giid, readerFilePath: self.job.path) 'element'
			// No declared range constrains the element, so no byte can be outside one. It is the program
			// that declares no `Byte` at all, whose only `Array with Byte` record is the literal's own
			// (`SignatureIndex.undeclaredNamedElementSlot`).
			undeclared then return
			declared(alias) then try self.requireEveryByteInRange(bytes, alias: alias, line: line, column: column)
		end 'element'
	end 'requireByteStringBlobFitsItsElement'

	// ⭐⭐ **THE RULE BOTH BYTE-PACKED PRODUCERS ASK** — the `b"…"` literal above, whose blob is packed
	// by CONSTRUCTION, and `__ManagedMemory.create(count, elementSize: 1)`, whose buffer is packed by its own
	// ARGUMENT. One rule, one sentence (`bytePackedRecordStrideMessage`), because the two producers must not disagree about it:
	// a record striding 1
	// under a type striding N is what makes every question further down, including E3118's slot question,
	// unanswerable.
	//
	// ⚠ It takes the INSTANCE rather than minting one, so the literal's caller can hand over the very giid its
	// bounds clause reads and the two provably speak about one element. `create`'s caller hands over the
	// instance its own `elementSize` picked, which is the same requirement seen from the other side: the
	// refusal must be about the type the result will WEAR, not about a fresh derivation of it.
	function requireBytePackedRecordStridesLikeThisFilesByte(giid GenericInstanceId, producer BytePackedProducer, line LineNumber, column ColumnNumber) throws SourceParseError
		let declaredStride = self.signatures.arrayElementSize(giid)

		if declaredStride == (ByteStringElementSize as ElementStride) 'thisFilesByteIsOneByte'
			return
		end 'thisFilesByteIsOneByte'

		throw SourceParseError.unsupported(bytePackedRecordStrideMessage(producer, declaredStride: declaredStride as FullRangeInt), line: line, column: column)
	end 'requireBytePackedRecordStridesLikeThisFilesByte'

	// Rule 2's walk, split out so the rule above reads as its two clauses. EVERY byte is tested and the FIRST
	// offending one is reported: a blob is a run the source never spelled out, so a diagnostic naming one byte
	// of it has to name WHICH (`byteStringByteOutOfRangeMessage`).
	function requireEveryByteInRange(bytes ByteArray, alias RangedTypeAlias, line LineNumber, column ColumnNumber) throws SourceParseError
		let isFloat = aliasIsFloat(alias)
		let len = bytes.count()
		var i = 0 as ByteOffset

		while i < len as ByteOffset 'eachByte'
			let value = try bytes.get(i) otherwise panic("requireEveryByteInRange: i < len just held but get({i}) failed")

			// A byte read out of a `b"…"` blob is a 0-255 number the source never spelled with a sign, so no
			// written-negative mark can exist for it and `false` is the fact rather than a default.
			if not literalInRange(value as FullRangeInt, low: alias.low, high: alias.high, isFloat: isFloat, writtenNegative: false, writtenAboveSignedMax: false) 'outsideTheElementsRange'
				throw SourceParseError.byteStringByteOutOfRange(value as FullRangeInt, offset: i as FullRangeInt, aliasName: self.signatures.aliasIdentityDisplay(alias.name), low: alias.low, high: alias.high, isFloat: isFloat, domain: alias.domain, line: line, column: column)
			end 'outsideTheElementsRange'

			i = i + 1
		end 'eachByte'
	end 'requireEveryByteInRange'

	// ⭐⭐ **`"prefix {x} suffix"` — WHERE THE FIRST OWNED HEAP STRING IS BUILT.** An interpolation lowers to
	// ONE `__mm_alloc`'d fused record: the 56-byte String record with its UTF-8 bytes INLINE right behind it
	// (`buffer@0 = record + StringRecordBytes`), the concatenation of every part's bytes. It is an owned
	// TEMPORARY — `emitStringInterp` enrolls it for the statement-scoped drop — so `print("{x}")` frees it
	// at statement end and `let s = "{x}"` transfers it to a scope-exit drop (`parseBinding`).
	//
	// The lexer splits `"a{x}b"` into `stringLiteral("a") stringInterpStart <expr> stringInterpEnd
	// stringLiteral("b")` — a leading fragment, then any number of `(expr, fragment)` pairs. Each part is
	// materialized to a `(buffer, length)` pair as it is parsed (a literal fragment and a `{s}` String part
	// alike load `buffer@0`/`length@8` from a String record; a primitive renders into a freed scratch
	// buffer), and `emitStringInterp` sums the lengths, allocates once, and copies the parts in.
	//
	// Each `{expr}` is parsed in the block control CURRENTLY occupies, not the entry block — an expression
	// that opens blocks (a short-circuit `{a and b}`) leaves control in its merge, and the next part and the
	// assembly must chain off that merge (the `multiple-try-fragments` regression, deferred here for `try`).
	// ⭐ `prefix`/`suffix` BRACKET the interpolation's own parts with literal bytes the SOURCE does not
	// contain. Exactly one caller passes them: an interpolated `panic(…)`, whose runtime line must carry the
	// `panic at <file>:<line>: ` location and the trailing newline — two parse-time facts no later tier
	// holds (`renderedPanicMessagePointer`). An EMPTY one materializes NO part at all, because
	// `materializeFragmentBytes` skips a zero-length run, so every other caller emits byte-identical IR.
	function parseStringInterpolation(func IrFunction, prefix ByteArray, suffix ByteArray) returns ValueId throws SourceParseError
		let startTok = self.current()
		let range = SourceRange.ofToken(startTok)

		let partBufs = ValueIdArray.create(0)
		let partLens = ValueIdArray.create(0)

		// The OWNED scratch buffers a primitive part rendered into. Freed after the copy in
		// `emitStringInterp` — they are consumed by the blit and otherwise leak (the interp-scratch-buffer
		// leak the leak gate would catch). A literal or String part collects none (its bytes are borrowed).
		let scratchIds = ValueIdArray.create(0)
		let partHolds = ValueIdArray.create(0)

		self.materializeFragmentBytes(prefix, partBufs: partBufs, partLens: partLens, range: range)
		try self.materializeLiteralFragment(partBufs, partLens: partLens, range: range)

		while self.at(TokenKind.stringInterpStart) 'parts'
			try self.consume(TokenKind.stringInterpStart)
			let exprTok = self.current()
			let exprVal = try self.parseExpression(func, block: self.bodyState.currentBlock)
			let format = try self.acceptInterpFormatSpec()
			try self.consume(TokenKind.stringInterpEnd)
			try self.materializeInterpExpr(exprVal, exprTok: exprTok, format: format, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			try self.materializeLiteralFragment(partBufs, partLens: partLens, range: range)

			if self.at(TokenKind.stringInterpStart) 'anotherPartFollows'
				self.holdInterpolationPart(exprVal, into: partHolds, range: range)
			end 'anotherPartFollows'
		end 'parts'

		self.materializeFragmentBytes(suffix, partBufs: partBufs, partLens: partLens, range: range)

		let record = self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
		self.releaseInterpolationHolds(partHolds, range: range)
		return record
	end 'parseStringInterpolation'

	function holdInterpolationPart(part ValueId, into ValueIdArray, range SourceRange)
		if not tagIsByteRecord(self.tagOf(part)) or not self.valueIsAStorageRead(part) or not self.holdIsOwed(part) 'nothingToHold'
			return
		end 'nothingToHold'

		let held = self.emitHoldMarker(part, kind: HoldKind.interpolationPart, range: range)
		self.trackOwnedTemp(held, exclusivity: OwnedHeapExclusivity.coOwned)
		into.push(held)
	end 'holdInterpolationPart'

	function releaseInterpolationHolds(holds ValueIdArray, range SourceRange)
		for held in holds 'eachHold'
			self.emitDecref(held, range: range)
			self.removeFromPendingTemps(held)
		end 'eachHold'
	end 'releaseInterpolationHolds'

	// The `:08x` of `"{n:08x}"`, if the author wrote one. The lexer has already decided WHERE the
	// expression stopped and the specifier began (`Lexer.scanInterp`), so this is a token test and not a
	// second reading of the same boundary question.
	function acceptInterpFormatSpec() returns InterpFormat throws SourceParseError
		if not self.at(TokenKind.stringFormatSpec) 'noSpecifier'
			return InterpFormat.plain
		end 'noSpecifier'

		return InterpFormat.specified(try InterpFormatSpec.parse(try self.consume(TokenKind.stringFormatSpec)))
	end 'acceptInterpFormatSpec'

	// Consume the current literal fragment token and, if it decodes to a non-empty byte run,
	// materialize it as a part. An EMPTY fragment (the `""` the lexer emits around adjacent
	// interpolations, `"{a}{b}"`) contributes nothing and is skipped.
	function materializeLiteralFragment(partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws SourceParseError
		let tok = try self.consume(TokenKind.stringLiteral)

		match decodeEscapes(tok.value, kind: LiteralEscapeKind.stringInterpolation) 'decoded'
			bytes(buf) then self.materializeFragmentBytes(buf, partBufs: partBufs, partLens: partLens, range: range)
			unknownEscape(text) then throw SourceParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column)
			badDigitEscape(text, offset, marker) then throw invalidDigitEscapeError(text, kind: LiteralEscapeKind.stringInterpolation, offset: offset, marker: marker, tok: tok)
			malformedText then throw malformedLiteralTextError(LiteralEscapeKind.stringInterpolation, tok: tok)
		end 'decoded'
	end 'materializeLiteralFragment'

	function materializeFragmentBytes(buf ByteArray, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange)
		if buf.count() == 0 'empty'
			return
		end 'empty'

		self.materializeStringRecordPart(self.emitStringLiteral(buf, range: range), partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeFragmentBytes'

	// A `{expr}` part. A String value (a literal or an interpolation result) is copied by its bytes
	// exactly as a literal fragment is — `materializeStringRecordPart` reads `buffer@0`/`length@8`
	// from either. An integer renders to decimal text via `__int_to_string` into a scratch buffer, a
	// bool via `__bool_to_string`, a float via `__float_toString` and a user struct via its own
	// `toString`. An enum renders by its backing (`materializeEnumPart`).
	function materializeInterpExpr(exprVal ValueId, exprTok Token, format InterpFormat, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) throws SourceParseError
		// ⚠ **THE RAW TAG IS CORRECT HERE, AND THAT WAS MEASURED RATHER THAN ASSUMED.** `tagIsIntegral`
		// answers `true` for a `named` tag deliberately (its own header records the trade), so a float
		// carrying one would be claimed by the INTEGRAL arm below and rendered through `__int_to_string`
		// — the IEEE bit pattern printed as a decimal integer. No shape reaches that: a ranged FLOAT
		// alias is resolved to a `float` tag before it can arrive here — a call result by
		// `resolveFloatAliasType`, a parameter and a field by the same erasure — and interpolating a
		// `Percent` parameter, a `Percent` field and a `Percent` return all print correctly with the raw
		// tag (`specs/string-interpolation.md`'s `float-ranged-alias-positions`, which is the pin).
		// Resolving again here would be a second answer to a question already answered upstream.
		//
		// ⚠⚠ **AN ENUM IS THE ONE SHAPE THAT DOES ARRIVE `named` CARRYING AN f64, AND THAT REASONING NEVER
		// COVERED IT.** A float-backed enum's value cannot be lifted at its producer the way an alias
		// is — it must stay a GPR i64 for `match` — so it is DECODED here instead, and the `float` arm below
		// then renders it through the one `__float_toString` every float in the language uses. MEASURED
		// without this decode: `enum Weight  light = 2.5` then `"{w}"` printed `4612811918334230528`. An
		// int-backed enum passes through untouched and keeps the integral arm, which is what
		// `constants/string-interpolation` and `string-interpolation/int-enum-interpolation` pin.
		let value = self.floatBehindEnumValue(exprVal, anchor: exprTok)

		// ⭐ **AN ENUM RENDERS BY ITS BACKING, NOT THROUGH THE INTEGRAL ARM BELOW.** The rule is
		// `/specs/string-interpolation.md:89`: *"For int-backed enums, the numeric value is shown. For
		// simple enums, the case name is shown. For string-backed enums, the raw string value is
		// displayed"*. Rendering the raw i64 for all of them is the right answer for exactly one:
		//
		//   | declaration                         | oracle   | the compiler      |
		//   | `enum Plain  red  green`            | `green`  | `1`       |
		//   | `enum IntB  low = 5  high = 9`      | `9`      | `9`  ✓    |
		//   | `enum StrB  active = "Active"`      | `Active` | `0`       |
		//   | `enum ChrB  comma = ','  dot = '.'` | `.`      | `46`      |
		//   | `union Payloadless  alpha  beta`    | `beta`   | `1`       |
		//   | `union Shape  circle(r Small)  blank` | `circle` | `5111832` |
		//
		// ⛔ **THE LAST ROW IS A HEAP ADDRESS**, and it MOVES between runs — the same defect
		// `emitEnumInstanceAccessor`'s header records for `.ordinal` ("every boxed union's `.ordinal` was
		// a box pointer"), reached again through the interpolation door because this site read `tagOf`
		// where the accessor asks `emitEnumTagOf`. That is why the boxed question is asked FIRST here.
		// ⚠ The `named` pre-check is `valueIsUnion`'s measured allocation guard, for its reason: `enumMatchFor`
		// returns a union VALUE, so asking it of the `int` and `String` holes that are almost every hole in
		// the corpus would box a `DeclaredEnum.undeclared` per hole.
		if self.tagOf(value) == ValueTypeTag.named 'possiblyAnEnum'
			let decl = self.enumMatchFor(value)

			if enumMatchIsDeclared(decl) 'anEnumPart'
				try self.materializeEnumPart(requireEnumLayout(decl), value: value, exprTok: exprTok, format: format, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
				return
			end 'anEnumPart'
		end 'possiblyAnEnum'

		let tag = self.tagOf(value)

		// ⚠ `tagIsByteRecord`, NOT `tagIsText`: this asks whether `buffer@0`/`length@8` can be read off the
		// value and blitted, which is a question about the RECORD. A Character carries the same record, so
		// `"{c}"` is the identical two loads — and interpolation is how a Character reaches stdout at all,
		// `print` itself taking a String and refusing one.
		//
		// ⚠ **A SPECIFIER ON TEXT IS IGNORED.** `print("[{s:8}]")` on a `String` prints `[hi]`, as do
		// `"{b:8}"` on a bool and `"{c:8}"` on a Character — a field width is a NUMERIC field, and no
		// spec pins any other reading. Refusing one here would refuse programs the language accepts;
		// padding one would be this compiler inventing a rule. It is named rather than left to fall
		// through.
		if tagIsByteRecord(tag) 'byteRecordPart'
			if let spec = try format.spec() 'aSpecifier'
				if spec.quotes 'quotedText'
					try self.materializeQuotedTextPart(value, tag: tag, spec: spec, exprTok: exprTok, partBufs: partBufs, partLens: partLens, range: range)
					return
				end 'quotedText'
			end 'aSpecifier'

			self.materializeStringRecordPart(value, partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'byteRecordPart'

		// ⭐⭐ **WHICH DECIMAL RENDERER — DECIDED HERE, ONCE, FROM THE VALUE'S DECLARED TYPE.**
		// `__int_to_string` is SIGNED by construction (see `buildIntegerToString`: it derives a sign and
		// multiplies each digit back by it), so a value of `int(0 to u64.max)` holding `u64.max` would
		// print `-1` rather than `18446744073709551615`. Whose question that is, is
		// `integerValueDomain`'s — the very walk the DIVIDE's signedness already comes from, so this
		// reuses the rule rather than respelling it. Only a DECLARED non-negative range selects the
		// unsigned entry point; a folded constant that merely FITS one does not (`valueRendersUnsigned`),
		// which keeps the corpus movement to the values that actually carry a declared type.
		if tagIsIntegral(tag) 'intPart'
			// ⭐⭐ **ONLY THE FORMATTED SPELLING MOVES TO stdlib, AND THAT IS THE REFERENCES' TRADE TOO.**
			// `"{n}"` keeps `__int_to_string` into a scratch buffer, whose budget is bounded BY
			// CONSTRUCTION (an i64 has at most 20 digits and a sign) — it is the hot path the fused
			// single-allocation record rests on, and the defect a field width introduces cannot exist
			// there. A FIELD has no such bound (`"{n:200}"`), so it is built over a String that grows.
			//
			// ⚠ The two cannot drift the way a second hand-written converter would: decimal conversion of a
			// magnitude has exactly one answer, and signedness is decided HERE, once, off the value's
			// declared type, and handed over as an argument rather than re-derived from bit 63 at the far
			// end.
			// ⚠ **BOTH BRANCHES LIVE IN `materializeIntegerPart`, BECAUSE THE ENUM ARM NEEDS THE SAME
			// ANSWER.** An int-backed enum renders EXACTLY as the integer it is — specifier included — so if
			// the choice between the formatted and the scratch path were spelled here, the enum arm would
			// have to spell it a second time. It did, and the second spelling silently DROPPED the
			// specifier: `"{code:08}"` on an int-backed enum prints `404` where `00000404` is required
			// (`string-interpolation/int-format-enum-backing`).
			try self.materializeIntegerPart(value, exprTok: exprTok, format: format, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			return
		end 'intPart'

		// A specifier on a bool is ignored — see the byte-record arm above for the measurement.
		if tagIsBool(tag) 'boolPart'
			self.materializeScratchPart(value, converter: BoolToStringName, scratchBytes: BoolToStringScratchBytes, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			return
		end 'boolPart'

		// ⭐⭐ **A FLOAT — `"{x}"` → a DIRECT `__float_toString(x)` CALL, NOT a `materializeScratchPart`
		// CONVERTER.** Its two neighbours above render into a fixed-size scratch buffer because their
		// worst cases are 21 and 5 bytes and their algorithms are a loop of divides. A float's is
		// neither: the shortest decimal that reads back as the same double is found with EXACT
		// arbitrary-precision arithmetic (`stdlib/Builtins.maxon`'s float-text band), it allocates as it
		// goes, and its fixed-notation spelling runs to ~325 characters for the least subnormal. A
		// hand-built Std-tier graph would be a second implementation of a routine the COMPILER already
		// needs and has — so the routine lives in `stdlib/` and both callers reach the one copy.
		//
		// The call is the same door `materializeStructToStringPart` takes one arm down: an ordinary
		// `emitCall` whose String result is classified +1 OWNED (`enrolOwnedCallTemp` →
		// `trackOwnedTemp`) and freed at statement end, its bytes spliced by
		// `materializeStringRecordPart` exactly as any other String part's are.
		if tagIsFloat(tag) 'floatPart'
			try self.materializeFloatToStringPart(value, exprTok: exprTok, format: format, partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'floatPart'

		// ⭐ **A USER STRUCT — `"{p}"` → a DIRECT `<Type>.toString()` CALL.** The concrete type is
		// statically known here, so dispatch is a plain method call, NOT a witness. Witnesses are needed
		// only for an UNKNOWN concrete type — a constrained type parameter.
		if tag == ValueTypeTag.structRef 'structPart'
			try self.materializeStructToStringPart(value, exprTok: exprTok, format: format, partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'structPart'

		if tagIsUnresolved(tag) 'deferredCallError'
			return
		end 'deferredCallError'

		// ⚠ NAMES WHAT IS UNSUPPORTED, NOT WHAT IS SUPPORTED. A message enumerating the handled types goes
		// stale every time an arm is added above — which is exactly how its predecessor came to promise
		// float and struct interpolation as future work while both arms sat directly above it.
		throw SourceParseError.unsupported("interpolating a value of type '{self.valueKindWord(exprVal)}' — no conversion to text exists for it", line: exprTok.line, column: exprTok.column)
	end 'materializeInterpExpr'

	// ⭐⭐ **RENDER AN INTEGER — FORMATTED OR PLAIN — AND IT IS THE ENUM ARM'S `rawNumber` ANSWER TOO.**
	// The integral arm and an int-backed enum are the SAME question: an enum with a raw number renders
	// exactly as that number, specifier and all. Keeping the formatted/plain choice here rather than at
	// the two call sites is not tidiness — when the enum arm spelled it separately it simply had no
	// formatted branch, so `"{code:08}"` printed `404` against the oracle's `00000404`.
	//
	// ⚠ The NAME and the SCRATCH BUDGET are two halves of ONE signedness choice: the signed budget
	// carries a sign byte the unsigned rendering never writes, and the signed renderer taken with the
	// unsigned budget would write one byte past `i64.min`'s scratch. The FORMATTED path cannot select an
	// entry point that way — it needs the signedness as a VALUE to hand on — which is why the two
	// branches ask `valueRendersUnsigned` separately rather than sharing a local.
	function materializeIntegerPart(value ValueId, exprTok Token, format InterpFormat, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) throws SourceParseError
		if let spec = try format.spec() 'formatted'
			try self.materializeFormattedIntPart(value, exprTok: exprTok, format: spec, rendersUnsigned: valueRendersUnsigned(self.integerValueDomain(value)), partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'formatted'

		let signedness = IntegerSignedness.unsigned if valueRendersUnsigned(self.integerValueDomain(value)) else IntegerSignedness.signed
		self.materializeScratchPart(value, converter: integerToStringName(signedness), scratchBytes: integerToStringScratchBytes(signedness), partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'materializeIntegerPart'

	// ⭐⭐ **INTERPOLATE AN ENUM / UNION VALUE** — see `materializeInterpExpr`'s arm for the measured
	// table this dispatch was written from. The rendering is decided by `enumInterpRendering` below and the
	// CONSTANT is selected by the machinery `.name` and `.rawValue` already use
	// (`emitEnumCaseTypedSelect`), so the three spellings of "what does case `i` render as" stay one answer.
	//
	// ⭐ **THE TAG COMES FROM `emitEnumTagOf`, WHICH IS THE WHOLE FIX FOR THE BOXED ROW.** A payload-bearing
	// union's VALUE is a heap box and its tag is the i64 at offset 0; reading the value as a number printed
	// the address. That door is the same one `emitEnumInstanceAccessor` asks question 1 through, so the
	// interpolation and the accessor agree about where a union keeps its tag by construction.
	//
	// A selected case NAME or raw TEXT is an immortal `.rdata` String record, so its bytes are spliced by
	// `materializeStringRecordPart` exactly as a `{s}` part's are and nothing is owned or dropped.
	// ⚠ **THE SPECIFIER REACHES THE `rawNumber` ARM AND NOTHING ELSE, AND THAT IS MEASURED RATHER THAN
	// ASSUMED.** A format specifier is a NUMERIC one, so the two TEXT arms have nothing to do with it.
	// The oracle, on one program carrying all three backings: `"{code:08}"` on an int-backed enum gives
	// `00000404`, while `"{p:6}"` on a plain enum gives `green` and `"{t:6}"` on a string-backed one
	// gives `Active` — both IGNORING the specifier, exactly as the bool and byte-record arms above do.
	function materializeEnumPart(layout EnumLayout, value ValueId, exprTok Token, format InterpFormat, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) throws SourceParseError
		let tag = try self.emitEnumTagOf(value, layout: layout, anchor: exprTok, range: range, reach: EnumTagReach.languageMade)

		match enumInterpRendering(layout) 'rendering'
			caseName then self.materializeStringRecordPart(try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.caseName, valueType: MaxonType.string, anchor: exprTok, range: range), partBufs: partBufs, partLens: partLens, range: range)
			declaredText then self.materializeStringRecordPart(try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.declaredRawValue, valueType: MaxonType.string, anchor: exprTok, range: range), partBufs: partBufs, partLens: partLens, range: range)
			rawNumber then try self.materializeIntegerPart(tag, exprTok: exprTok, format: format, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
		end 'rendering'
	end 'materializeEnumPart'

	// ⭐ **INTERPOLATE A FLOAT VIA `stdlib/Builtins.maxon`'s `__float_toString`** — see the arm in
	// `materializeInterpExpr` for why this is a call rather than a scratch-buffer converter.
	//
	// ⚠ **IT IS MINTED `CalleeMint.primitiveStatic`, WHICH IS WHAT LETS A RESERVED CALLEE THROUGH** — and
	// the classification is a claim, not a trick: `"{x}"` on a float MEANS `float.toString(x)`, the
	// primitive static whose body `stdlib/Builtins.maxon` declares in the reserved space, exactly as
	// `int.fromString(s)` means `__int_fromString(s)`. A user cannot write `__float_toString(x)` (E3004
	// refuses it, unminted); the compiler spells it out of a source `"{x}"` carrying no `__`, which is the
	// case that mint exists for. A diagnostic about the call therefore quotes `float.toString(…)`
	// (`SemanticCheck` → `primitiveStaticSourceSpelling`) — the noun for what the interpolation does,
	// rather than a reserved symbol nobody wrote. The struct arm one function down takes the same view of
	// its own call for the same reason.
	function pushFloatFieldArguments(format InterpFormat, args ValueIdArray, range SourceRange) returns immutable ByteArray
		let spec = try format.spec() otherwise return ToStringMethodName

		if let decimals = try spec.precision.decimalCount() 'fixedDecimals'
			args.push(self.emitLiteral(decimals as FullRangeInt, valueType: MaxonType.integer, range: range))
			self.pushFieldWidthArguments(spec, args: args, range: range)

			return FloatToStringFixedMethodName
		end 'fixedDecimals'

		self.pushFieldWidthArguments(spec, args: args, range: range)

		return FloatToStringPaddedMethodName
	end 'pushFloatFieldArguments'

	function pushFieldWidthArguments(spec InterpFormatSpec, args ValueIdArray, range SourceRange)
		args.push(self.emitLiteral(spec.width as FullRangeInt, valueType: MaxonType.integer, range: range))
		args.push(self.emitLiteral(boolPayload(spec.zeroFill), valueType: MaxonType.boolean, range: range))
	end 'pushFieldWidthArguments'

	function materializeFloatToStringPart(exprVal ValueId, exprTok Token, format InterpFormat, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws SourceParseError
		let args = ValueIdArray.create(0)
		args.push(exprVal)

		// The callee is spelled by `primitiveStaticCallee`, the ONE speller of a primitive's reserved-space
		// static, out of the same two components a source `float.toString(x)` would join — so this lowering
		// cannot come to name a function the mint would spell differently.
		//
		// ⭐ **A PRECISION IS ABSENT RATHER THAN DEFAULTED, AND THAT IS WHY THERE ARE TWO CALLEES.**
		// `"{f:8}"` is the language's own spelling of the value — the shortest decimal that reads back —
		// right-aligned in a field; `"{f:.2}"` is two decimals. Giving the padded form a default number of
		// decimals is what would let a WIDTH silently change the DIGITS, so the two are different
		// functions rather than one with a sentinel precision.
		let method = self.pushFloatFieldArguments(format, args: args, range: range)

		try self.materializeCallPart(primitiveStaticCallee(FloatConformerName, methodName: method), args: args, mint: CalleeMint.primitiveStatic, exprTok: exprTok, partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeFloatToStringPart'

	// ⭐⭐ **`"{n:08x}"` → `stdlib/Builtins.maxon`'s `__int_toStringFormatted`, WHICH TAKES CONSTANTS AND
	// READS NO TEXT.** Every one of its five trailing arguments is a compile-time answer this parse
	// already has: the width and the fill from the specifier, the base and its letter case from the
	// specifier, and the SIGNEDNESS from the value's declared type.
	//
	// ⚠ **`signed` IS THE COMPILER'S ANSWER, NOT A RE-READING OF BIT 63, AND IT IS AN `and` OF TWO
	// FACTS.** A base that spells the bit pattern (`x`, `X`, `o`, `b`) never writes a sign whatever
	// the value's type — `"{allBits:x}"` on `0 - 1` is `ffffffffffffffff`. And a DECIMAL rendering of
	// a value whose declared range is non-negative is unsigned — `"{u:d}"` on `u64.max` is
	// `18446744073709551615`, the same number `"{u}"` prints, because a format specifier never changes
	// WHICH number is being printed. Deriving signedness from the sign bit instead answers `-1`.
	//
	// ⚠ **THE VALUE IS HANDED OVER STRIPPED OF ITS ALIAS.** The renderer's `value` parameter is the
	// compiler's own `FullRangeInt`, and a `Wide` or a `Bits` is not one: the argument door would refuse the
	// alias-typed value, and there is no `as` an author could write at a `{n:x}`. A fresh unnamed value
	// (`emitRetaggedCastValue`, folded away at the Std tier) is the same bits under no name; an already
	// unnamed value is passed as it is.
	function materializeFormattedIntPart(exprVal ValueId, exprTok Token, format InterpFormatSpec, rendersUnsigned bool, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws SourceParseError
		let args = ValueIdArray.create(0)
		args.push(self.emitRetaggedCastValue(exprVal, targetType: MaxonType.integer, range: range) if self.tagOf(exprVal) == ValueTypeTag.named else exprVal)
		args.push(self.emitLiteral(boolPayload(format.spellsASign and not rendersUnsigned), valueType: MaxonType.boolean, range: range))
		args.push(self.emitLiteral(format.halfRadix as FullRangeInt, valueType: MaxonType.integer, range: range))
		args.push(self.emitLiteral(boolPayload(format.uppercase), valueType: MaxonType.boolean, range: range))
		args.push(self.emitLiteral(format.width as FullRangeInt, valueType: MaxonType.integer, range: range))
		args.push(self.emitLiteral(boolPayload(format.zeroFill), valueType: MaxonType.boolean, range: range))

		try self.materializeCallPart(primitiveStaticCallee(IntConformerName, methodName: IntToStringFormattedMethodName), args: args, mint: CalleeMint.primitiveStatic, exprTok: exprTok, partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeFormattedIntPart'

	function materializeQuotedTextPart(exprVal ValueId, tag ValueTypeTag, spec InterpFormatSpec, exprTok Token, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws SourceParseError
		let args = ValueIdArray.create(0)
		args.push(exprVal)
		args.push(self.emitLiteral(spec.width as FullRangeInt, valueType: MaxonType.integer, range: range))

		let conformer = StringConformerName if tag == ValueTypeTag.string else CharacterConformerName

		try self.materializeCallPart(primitiveStaticCallee(conformer, methodName: QuotedTextMethodName), args: args, mint: CalleeMint.primitiveStatic, exprTok: exprTok, partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeQuotedTextPart'

	// ⭐⭐ **ONE PART, RENDERED BY A CALL — the shared spelling of every `toString`-shaped arm.** The
	// float arms, the formatted-integer arm and the user-struct arm choose a different callee and hand
	// over different arguments; every step after that is the SAME protocol, and the steps are not
	// optional: the call's String result is classified +1 OWNED by `emitCall` (`enrolOwnedCallTemp` →
	// `trackOwnedTemp`) so it is freed at STATEMENT END, after `emitStringInterp` has copied its
	// bytes, and its bytes are spliced by `materializeStringRecordPart` exactly as any other String
	// part's are. Written once because a step added to one copy and not the others is a leak or a
	// use-after-free at RUNTIME rather than a compile error.
	//
	// ⚠ **THE LABELS ARE EMPTY AND THE ARGUMENTS ARE THEREFORE POSITIONAL** (`argSlotPosition`), which is
	// what a compiler-minted call wants: these arguments have no author-written spelling to agree with,
	// and binding them by NAME would couple this lowering to the parameter names `stdlib` happens to use.
	function materializeCallPart(callee ByteArray, args ValueIdArray, mint CalleeMint, exprTok Token, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws SourceParseError
		let argLabels = NameRoster.create(args.count(), zeroed: false)
		let argRanges = SourceRangeArray.create(args.count(), zeroed: false)

		for _ in 0 upto args.count() 'eachArg'
			argLabels.push(EmptySourceText)
			argRanges.push(range)
		end 'eachArg'

		let result = try self.emitCall(callee, anchor: exprTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: exprTok, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: mint, places: self.placesOfArguments(args, anchor: exprTok))
		self.materializeStringRecordPart(result, partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeCallPart'

	// ⭐ **INTERPOLATE A USER STRUCT VIA A DIRECT `<Type>.toString()` CALL.** A struct is interpolable
	// iff it HAS a `toString` method (by NAME, not by declaring `Stringable`); a struct WITHOUT one is
	// E3016, positioned at the interpolated expression. The call's result is classified +1 OWNED by
	// `emitCall` (`enrolOwnedCallTemp` → `trackOwnedTemp`), so the fresh String is freed at STATEMENT
	// END — after `emitStringInterp` has copied its bytes into the interp result. Its bytes are
	// spliced exactly as a `{s}` String part's are (`materializeStringRecordPart`), the same machinery
	// a String-returning call already interpolates through. Without the owned classify, one String
	// leaks per interpolated struct.
	//
	// ⭐⭐ **A FORMAT SPECIFIER IS THE CALL'S ARGUMENT — `"{c:verbose}"` IS `c.toString("verbose")`.** The
	// specifier's text is handed over as an ordinary `String` argument to the bare `<Type>.toString`
	// callee. A method is declared once per type, so the type's own `toString` decides what the call
	// takes: a quoting specifier over a `toString()` that takes no parameter hands none over.
	//
	// ⚠ A type that declares only `toString()` and is interpolated with any other specifier is
	// reported by the ordinary argument-count check against the member it does declare, not by a rule
	// here.
	function materializeStructToStringPart(exprVal ValueId, exprTok Token, format InterpFormat, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws SourceParseError
		let structName = self.internedName(self.valueNameId(exprVal))
		let callee = qualifiedMethodName(structName, methodName: ToStringMethodName)

		// Asked of the WHOLE-PROGRAM index, not of this file: a struct's `toString` may be declared anywhere,
		// including in the file that uses it in an interpolation. `declaresCallee` answers exactly that with a
		// `Map.contains`; the return type it does not fetch is fetched a few lines down by `emitCall`'s
		// `mintCallResult`, which is where it is actually needed.
		if not self.signatures.declaresCallee(callee) 'noToString'
			self.recordArtifactDiagnostic(ErrorCode.semanticPartialInterfaceImpl, message: "Type '{self.valueDisplayTypeName(exprVal) if self.valueTypeNameIsATuple(exprVal) else String.from(structName)}' used in string interpolation must have a toString method", range: SourceRange.ofToken(exprTok))

			// The recorded diagnostic fails the build; materialize an EMPTY placeholder part so the interp
			// assembly (which needs at least one part) does not panic on a bare `"{s}"`.
			self.materializeStringRecordPart(self.emitStringLiteral(EmptySourceText, range: range), partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'noToString'

		try self.requireImplicitMethodReachable(structName, methodName: ToStringMethodName, anchor: exprTok)

		let args = ValueIdArray.create(0)
		args.push(exprVal)

		if let spec = try format.spec() 'aFormatSpec'
			if not (spec.quotes and self.signatures.calleeTakesNoExplicitParam(callee)) 'aFormatIsHandedOver'
				// ⚠ **THESE BYTES ARE RAW, AND `emitStringLiteral`'s header asks for DECODED ones.** Every
				// other caller hands it the output of `decodeEscapes`, because every other caller is
				// emitting a string LITERAL the author quoted and `\n` in one means a newline. A specifier
				// is not quoted: `Lexer.scanInterpFormatSpec` takes its bytes verbatim and stops at the
				// first `}` whatever precedes it, so there is no escape grammar over them to decode and
				// `"{c:a\nb}"` names a three-character format `a\nb` — which is the string the author's
				// `toString(format String)` compares against. Decoding here would hand it a different one.
				args.push(self.emitStringLiteral(spec.text, range: range))
			end 'aFormatIsHandedOver'
		end 'aFormatSpec'

		// `resolvedTypeQualifier`: the reserved-space door must judge this exactly as it judges the same call
		// spelled out (`p.toString()`), and that is the same mint the written form takes — the head is the
		// interpolated value's resolved type, and here the author wrote no member name either.
		try self.materializeCallPart(callee, args: args, mint: CalleeMint.resolvedTypeQualifier, exprTok: exprTok, partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeStructToStringPart'

	// ⭐ **ONE VALUE'S TEXT, WITH NOTHING AROUND IT — `"{x}"` MINUS THE LITERAL FRAGMENTS.** The whole of
	// `x.toString()` on a builtin-typed receiver (`dispatchBuiltinConformanceMethod`), and it is the
	// interpolation path rather than a path LIKE it: the same `materializeInterpExpr` chooses the same arm
	// per tag (`__int_to_string` for an integer and for a ranged `Byte` alias, `__bool_to_string` for a
	// bool, the `stdlib/Builtins.maxon` `__float_toString` call for a float), and the same
	// `emitStringInterp` assembles the same fused owned record and frees the same scratch. So there is no
	// second formatter to keep in step, and `x.toString()` cannot come to disagree with `"{x}"` — the
	// property this project has already paid to learn the cost of.
	//
	// The result is an owned temporary exactly as an interpolation's is (`emitStringInterp` →
	// `trackOwnedTemp`): `let s = x.toString()` transfers it to a scope-exit drop through `parseBinding`,
	// and a bare `x.toString()` statement drops at statement end.
	//
	// ⚠ A format specifier is a property of an INTERPOLATION HOLE, and `x.toString()` is not one — the
	// spelling that takes one is `x.toString(spec)`, a written call this lowering is not on the path of.
	function emitValueToString(exprVal ValueId, exprTok Token, range SourceRange) returns ValueId throws SourceParseError
		let partBufs = ValueIdArray.create(0)
		let partLens = ValueIdArray.create(0)
		let scratchIds = ValueIdArray.create(0)
		try self.materializeInterpExpr(exprVal, exprTok: exprTok, format: InterpFormat.plain, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'emitValueToString'

	// A String-record part: load `buffer@0` and `length@8` off the record. Shared by literal fragments and
	// `{s}` String parts — both are pointers to the fused 56-byte record, so both read the same two fields.
	function materializeStringRecordPart(rec ValueId, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange)
		partBufs.push(self.emitLoadStringField(rec, offset: StringBufferOffset, range: range))
		partLens.push(self.emitLoadStringField(rec, offset: StringLengthOffset, range: range))
	end 'materializeStringRecordPart'

	// Render a primitive part into a freshly `__mm_alloc`'d scratch buffer via a `(value, dest) -> length`
	// converter runtime function, enroll the scratch for the post-copy free (it is an owned buffer the blit
	// consumes — otherwise the interp-scratch-buffer leak), and record `(scratch, length)`. The shared shape
	// of every primitive part — int, bool, float — differing only in the converter and its worst-case byte
	// budget. A `named` integer alias is already i64, so the value needs no widening.
	function materializeScratchPart(exprVal ValueId, converter ByteArray, scratchBytes FullRangeInt, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange)
		let scratchSize = self.emitLiteral(scratchBytes, valueType: MaxonType.integer, range: range)
		let scratch = self.emitBoxAlloc(scratchSize, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range, tag: MmTag.InterpolationScratch)

		let convArgs = ValueIdArray.create(0)
		convArgs.push(exprVal)
		convArgs.push(scratch)
		let length = self.emitRuntimeCall(converter, args: convArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		partBufs.push(scratch)
		partLens.push(length)
		scratchIds.push(scratch)
	end 'materializeScratchPart'

	// ⭐ **ASSEMBLE THE FUSED OWNED STRING.** Sum the part lengths, allocate ONE `__mm_alloc` record big
	// enough for the 56-byte record + the bytes + a NUL, copy every part into the inline region at a running
	// cursor, write the record fields, and free the scratch. The result is an owned temporary
	// (`trackOwnedTemp`) — an INLINE String (`capacity@16 = InlineBufferCapacity`) whose bytes die with the
	// record's slot, so its destructor is `TrivialDestructor` (0), exactly a struct's: `__mm_decref` →
	// `__mm_free` reclaims record and bytes together, with no external buffer and no destructor cascade.
	function emitStringInterp(partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange, resultTag ValueTypeTag = ValueTypeTag.string) returns ValueId
		let totalLen = self.sumPartLengths(partLens, range: range)

		let overhead = self.emitLiteral(StringInterpOverheadBytes, valueType: MaxonType.integer, range: range)
		let allocSize = self.emitMachineWordBinOp(totalLen, rhs: overhead, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)
		let result = self.emitBoxAlloc(allocSize, resultTag: resultTag, resultNameId: UnnamedTypeId, range: range)
		self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.sole)

		// The inline byte region begins right after the record. Copy each part in at a cursor that advances
		// by the part's length; the NUL at `buffer[totalLen]` is already zero (the slab zeroes the payload).
		let recordBytes = self.emitLiteral(StringRecordBytes as FullRangeInt, valueType: MaxonType.integer, range: range)
		let inlineBuf = self.emitMachineWordBinOp(result, rhs: recordBytes, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)
		var cursor = inlineBuf

		for i in 0 upto partBufs.count() 'copyParts'
			let buf = try partBufs.get(i) otherwise panic("emitStringInterp: partBufs.get OOB at {i} — partBufs and partLens grow in lockstep")
			let length = try partLens.get(i) otherwise panic("emitStringInterp: partLens.get OOB at {i} — partBufs and partLens grow in lockstep")
			let copyArgs = ValueIdArray.create(0)
			copyArgs.push(cursor)
			copyArgs.push(buf)
			copyArgs.push(length)
			_ = self.emitRuntimeCall(StrCopyName, args: copyArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			cursor = self.emitMachineWordBinOp(cursor, rhs: length, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)
		end 'copyParts'

		self.emitStoreStringField(result, offset: StringBufferOffset, value: inlineBuf, range: range)
		self.emitStoreStringField(result, offset: StringLengthOffset, value: totalLen, range: range)

		// ⭐ **`capacity@16 = InlineBufferCapacity` — the buffer-ownership encoding's INLINE provenance**
		// (`BufferOwnership`), and the one fact the whole record has to publish about its bytes: they are
		// part of this box, so they are neither writable in place beyond their exact length nor separately
		// releasable. `__managed_grow` reads it — the growth every String append reaches through
		// `String.append` -> `managed.append` -> `__managed_append` -> `__managed_reserve` — and any negative
		// capacity is below every required length, so an inline String always detaches into a private buffer
		// before it grows. `__str_decref` reads it (a negative capacity sends it to `parent@32`, which is
		// `NoOwedAllocation` here, so the record's own free reclaims record and bytes together).
		// `parent@32` needs no store at all: `NoOwedAllocation` is 0, which `__mm_alloc`'s zeroing
		// contract already supplies (the same reason `__managed_create` leaves four of its six fields alone).
		let capacity = self.emitLiteral(InlineBufferCapacity as FullRangeInt, valueType: MaxonType.integer, range: range)
		self.emitStoreStringField(result, offset: StringCapacityOffset, value: capacity, range: range)
		let elementSize = self.emitLiteral(ByteStringElementSize, valueType: MaxonType.integer, range: range)
		self.emitStoreStringField(result, offset: StringElementSizeOffset, value: elementSize, range: range)

		// `element_destroy@40 = TrivialElementDestroy` and `singleByteGraphemes@48 = 0` (conservative) both come
		// from the slab's zeroing — a String's elements are `Byte`s, so the first is the TRUTH about this
		// record and not a placeholder.

		// Free the owned scratch now its bytes are copied. A `__mm_decref` (rc 0 → `__mm_free`), never a raw
		// free, so the leak counter stays balanced — the same door `emitScopeDrops` drops through.
		for i in 0 upto scratchIds.count() 'freeScratch'
			let scratch = try scratchIds.get(i) otherwise panic("emitStringInterp: scratchIds.get OOB at {i}")
			self.emitDecref(scratch, range: range)
		end 'freeScratch'

		return result
	end 'emitStringInterp'

	function sumPartLengths(partLens ValueIdArray, range SourceRange) returns ValueId
		if partLens.isEmpty() 'noPartMaterialized'
			return self.emitLiteral(EmptyInterpolationLength, valueType: MaxonType.integer, range: range)
		end 'noPartMaterialized'

		var total = try partLens.get(0) otherwise panic("sumPartLengths: a non-empty part list has a first part")

		for i in 1 upto partLens.count() 'sum'
			let length = try partLens.get(i) otherwise panic("sumPartLengths: partLens.get OOB at {i}")
			total = self.emitMachineWordBinOp(total, rhs: length, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)
		end 'sum'

		return total
	end 'sumPartLengths'

	// A raw MACHINE-WORD `binOp` — the interpolation's cursor advance, buffer offset and size math, a `for`
	// loop's index step, and an inline record's shift/or/mask assembly. It emits `MaxonOp.binOp` DIRECTLY,
	// bypassing `emitBinOp`'s operand type rules, because the operands are compiler-owned words (a String
	// pointer `result + StringRecordBytes`, a byte length, a loop counter, a packed field) rather than a
	// source-level `a + b` whose two sides must be shown to agree. The Std tier reads a String lhs as its
	// i64 pointer (`valueTagToStdType`), so the op is a clean i64 one either way.
	function emitMachineWordBinOp(lhs ValueId, rhs ValueId, op MaxonBinOp, resultType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(resultType)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(result, lhs: lhs, rhs: rhs, op: op), range: range)
		return result
	end 'emitMachineWordBinOp'

	function emitSurrogateBlockSkip(next ValueId, range SourceRange) returns ValueId
		let blockShift = self.emitLiteral(SurrogateBlockShift, valueType: MaxonType.integer, range: range)
		let blockNumberOfSurrogates = self.emitLiteral(SurrogateFloor shr SurrogateBlockShift, valueType: MaxonType.integer, range: range)
		let one = self.emitLiteral(1, valueType: MaxonType.integer, range: range)
		let signShift = self.emitLiteral(WordSignBitShift, valueType: MaxonType.integer, range: range)
		let blockNumber = self.emitMachineWordBinOp(next, rhs: blockShift, op: MaxonBinOp.shr, resultType: MaxonType.integer, range: range)
		let blockDifference = self.emitMachineWordBinOp(blockNumber, rhs: blockNumberOfSurrogates, op: MaxonBinOp.bitXor, resultType: MaxonType.integer, range: range)
		let belowOne = self.emitMachineWordBinOp(blockDifference, rhs: one, op: MaxonBinOp.sub, resultType: MaxonType.integer, range: range)
		let insideBlock = self.emitMachineWordBinOp(belowOne, rhs: signShift, op: MaxonBinOp.shrLogical, resultType: MaxonType.integer, range: range)
		let skipped = self.emitMachineWordBinOp(insideBlock, rhs: blockShift, op: MaxonBinOp.shl, resultType: MaxonType.integer, range: range)

		return self.emitMachineWordBinOp(next, rhs: skipped, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)
	end 'emitSurrogateBlockSkip'

	// Load an 8-byte field of a String record — `buffer@0`, `length@8`. Integer-tagged: the values are a raw
	// pointer and a byte count. The `rec` addr is a String pointer, read by the Std tier as an i64.
	//
	// It routes through `emitIndirectLoad` rather than emitting the op itself, exactly as `emitFieldLoad`
	// does: a String record is a BOX like any other, and its declared type and its storage type coincide
	// at `integer` only because a raw pointer and a byte count are both machine words. That is a fact
	// about this box, and it belongs here — not a reason to own a second copy of the emit.
	function emitLoadStringField(rec ValueId, offset ByteOffset, range SourceRange) returns ValueId
		return self.emitIndirectLoad(MaxonType.integer, box: rec, offset: offset, storageType: MaxonType.integer, range: range)
	end 'emitLoadStringField'

	// Store an 8-byte field of a String record — the mirror of `emitLoadStringField`, the one place
	// `emitStringInterp` writes the fused record's SEVEN fields. It writes FOUR of them
	// (`buffer@0`, `length@8`, `capacity@16`, `element_size@24`); `parent@32`, `element_destroy@40` and
	// `singleByteGraphemes@48` all ride the slab's zeroing, which is the right value for each.
	function emitStoreStringField(rec ValueId, offset ByteOffset, value ValueId, range SourceRange)
		self.emitIndirectStore(rec, offset: offset, value: value, storageType: MaxonType.integer, range: range)
	end 'emitStoreStringField'

	// `true` / `false`. A bool is an i1 carrying 1 or 0 — the same `literal` op an
	// integer uses, typed `boolean` so the Maxon→Std collapse gives it i1 rather than
	// i64. The `bool` TYPE already existed (a comparison produces one, an `if` consumes
	// one); these are the literals that let a program NAME one.
	// ONE emit site, not one per arm: the two literals differ only in the token they
	// consume and the payload they carry, so a change to how a bool is materialized (its
	// MaxonType, its op) lands in a single place and cannot apply to `true` but not `false`.
	function parseBoolLiteral() returns ValueId throws SourceParseError
		let tok = self.current()
		var value = BoolTrueValue

		if self.at(TokenKind.true) 'isTrue'
			try self.consume(TokenKind.true)
		end 'isTrue' else 'isFalse'
			try self.consume(TokenKind.false)
			value = BoolFalseValue
		end 'isFalse'

		return self.emitLiteral(value, valueType: MaxonType.boolean, range: SourceRange.ofToken(tok))
	end 'parseBoolLiteral'

	// ⭐⭐ **`Self{x: x, y: y}` — WHERE THE HEAP ENTERS THE LANGUAGE.** It allocates the struct's box.
	//
	// It lowers to exactly four kinds of op, none of them new:
	//
	//     literal   16                 -- the box's payload size (StructLayout.sizeBytes)
	//     literal   0                  -- the destructor (TrivialDestructor; see there)
	//     call      __mm_alloc         -- returns the PAYLOAD pointer; field i is at [ptr + i*8]
	//     storeIndirect <ptr> 0 <x>    -- one per field, at StructLayout.offsetOfField(i)
	//     storeIndirect <ptr> 8 <y>
	//
	// ⚠ **THE FIELDS ARE STORED IN DECLARATION ORDER, NOT IN THE ORDER THEY WERE WRITTEN**, and the
	// values are parsed in the order they were written. Both are true at once because the values are
	// evaluated into SSA ids as the literal is read, and the STORES are emitted afterwards by walking
	// the layout — so `Point{y: 4, x: 3}` evaluates `4` first and still puts `3` in slot 0. Emitting
	// each store as its field was parsed would have written the box in source order, which is the same
	// thing for these two cases and the wrong thing for one field in a slot the layout disagrees about.
	//
	// ⚠ **EVERY FIELD MUST END UP INITIALIZED, and the allocator's zeroing guarantee is what makes
	// that a RULE rather than a nicety.** An omitted slot reads back as a clean 0 — a plausible
	// number — so `Point{x: 1}` would silently have `y == 0`. E3086 rejects it.
	//
	// A slot gets its value from one of TWO sources, asked in this order: the literal
	// (`parseStructLiteralFields`), then the field's declared DEFAULT (`applyFieldDefaults`). The
	// literal always wins — the default is consulted only for a slot `filled` says nothing wrote.
	// `requireAllFieldsInitialized` then rejects whatever neither supplied.
	//
	// ⭐ **A MANAGED FIELD IS MOVED IN** (`emitStructLiteral` → `moveInPayload`), not stored raw — the
	// CONSUME-into-field half of cross-call ownership. Every managed field kind is constructible: a
	// `String` (promoted/moved in, dropped through `__str_decref`), a `struct` (moved in, dropped through
	// its own `__destruct_<Struct>`), and a payload-bearing (boxed) UNION field (moved in, dropped through
	// the union's `__destruct_<U>` or the trivial `__mm_decref` for a scalar-only box). The
	// box holds exactly ONE reference to each and its `__destruct_<Struct>` cascade releases exactly those. A
	// borrowed struct/union value has no `clone`, so it is CO-OWNED rather than copied (`moveInPayload` — the
	// transitive-consume ruling of 2026-08-04).
	function parseStructLiteral(func IrFunction) returns ValueId throws SourceParseError
		// `Self{…}` and `Point{…}` arrive as ONE token here — `typeBaseTokenAt` has already turned the keyword
		// into the name it denotes — so the literal's own reader knows nothing about `Self`.
		let typeIndex = self.pos
		let typeTok = try self.consumeTypeBaseToken()

		// ⭐⭐ **`<InnerAlias>{}` — A TYPEALIAS IS CONSTRUCTIBLE IN THE BODY THAT DECLARES IT.** E3076's
		// rule is about WHERE the literal is written, and a `typealias` a type body declares is written
		// inside that body: `stdlib/Set.maxon:43` opens `var elems = ElementArray{}` two lines below its
		// own `typealias ElementArray = Array with Element`. **The rule is about the alias's DECLARATION
		// SITE and NOT about genericity** — `inner-alias-construction.nongeneric-inner-array-alias` is
		// the identical program with no type parameters anywhere. A TOP-LEVEL alias is declared in no
		// body, so no body may construct it and it stays E3076 below.
		//
		// ⚠ **IT IS ROUTED BEFORE `requireConstructible` BECAUSE THAT ROUTINE RETURNS A `StructLayout` AND AN
		// ALIAS TO `Array with X` HAS NONE.** Widening its location test alone would carry the literal into the
		// struct registry asking for a name only the generic-instance index holds. What the construct MEANS is
		// the alias's EMPTY CONTAINER — measured: the oracle's value is then `resize`d and `count()`s back —
		// so it is served by the producer `<InnerAlias>.create()` already goes through, never a second one.
		//
		// ⚠ **THE TYPE'S OWN NAME — AND ITS TYPE PARAMETERS — WIN OVER AN ALIAS SHADOWING THEM, and that
		// precedence is READ OFF `parseTypeReference` RATHER THAN CHOSEN HERE**: `namesInnerAliasHere` is
		// the one home of it, so this door, the static-call door and `parseTypeReference` itself cannot
		// come to disagree about what one written name denotes. Without it, `Self{}` in a body declaring
		// `typealias Holder = Array with ExitCode` (which arrives here as `Holder`) built an ARRAY, and
		// the type's own `create` was refused for returning `Holder.Holder` where it declared `Holder`.
		// The shadowing declaration itself is not refused, so this guard is what keeps the two spellings
		// agreeing.
		if self.namesInnerAliasHere(typeTok.value) 'innerAliasLiteral'
			return try self.parseInnerAliasLiteral(func, aliasTok: typeTok)
		end 'innerAliasLiteral'

		let layout = try self.requireConstructible(typeTok)

		// ⭐ **E3086 ANCHORS ON THE `{`, WHERE THE MISSING FIELD WOULD BE WRITTEN** — not on the type
		// name, which is not the thing that is wrong.
		let lbraceTok = self.current()
		try self.consume(TokenKind.leftBrace)

		// Parallel to the LAYOUT, not to the source: `fieldValues[i]` is the value for the field the
		// type declares at `i`, whatever position the literal wrote it in. `filled` is what turns an
		// unwritten slot into E3086 rather than into a zero nobody chose. `fieldBareLocal[i]` records
		// whether the literal's value for field `i` was a bare reference to a local binding — what a
		// managed field's move-in poisons (`moveInPayload`), captured here because only the parse can see it.
		let fieldValues = ValueIdArray.create(layout.fieldCount())
		let filled = FixedBoolArray.create(layout.fieldCount())
		let fieldBareLocal = BoolArray.create(layout.fieldCount())

		let heldFloor = self.regionFactsForRead().pendingHeld.count()
		try self.parseStructLiteralFields(func, layout: layout, fieldValues: fieldValues, filled: filled, fieldBareLocal: fieldBareLocal)
		let rbraceTok = try self.consume(TokenKind.rightBrace)
		let returnedDirectly = self.literalIsTheReturnedValue(func, typeIndex: typeIndex)

		// Defaults are applied BEFORE the check, which is what makes an omitted-but-defaulted field
		// legal without teaching `requireAllFieldsInitialized` a second rule. That one goes on
		// asking exactly what it always asked — "does every slot have a value by now?" — and a
		// default is simply one of the two ways a slot comes to have one.
		//
		// ⚠⚠ **A DEFAULT CAN BE A MANAGED VALUE, AND ITS `fieldBareLocal` STAYING FALSE IS WHAT MAKES THAT
		// SAFE RATHER THAN A COINCIDENCE.** A default is not always a scalar literal:
		// `as IntArray = IntArray.create(0)` emits a CALL, whose result the mint already
		// owns and lists as this statement's temporary (`mintOwnedCallResult` → `trackOwnedTemp`). The
		// store loop below cannot tell that slot from a written one, and must not: it moves the value in
		// exactly as it moves a written `Self{items: makeItems()}`, and `fieldBareLocal` false is the
		// correct answer for BOTH — a call result names no binding, so there is nothing to poison and the
		// temp is simply consumed out of the pending drops (`transferOwnedInto`).
		//
		// ⭐ **AND THE DEFAULTS RUN AFTER EVERY WRITTEN FIELD'S EXPRESSION, DELIBERATELY.** The literal's
		// own values are evaluated as it is read (`parseStructLiteralFields`), so a side-effecting
		// default runs after every side-effecting value the author actually wrote — source order for what
		// is written, then the defaults, in declaration order. Splicing the default-init in immediately
		// after the allocation instead, AHEAD of the written fields, is indistinguishable to every corpus
		// case; this order is the one that keeps the two fills independent passes over the same two
		// columns rather than one interleaved walk.
		try self.applyFieldDefaults(layout, fieldValues: fieldValues, filled: filled, anchor: typeTok)

		// ⭐⭐ **`Self{}` INSIDE `type Array` IS THE EMPTY CONTAINER** — the very answer `<InnerAlias>{}`
		// gets one door down (`parseInnerAliasLiteral`), and for the same reason: `Array`'s sole field IS
		// its record, so an empty literal leaves no slot unwritten — it names the empty buffer, which is what
		// `Array.create()` builds. `stdlib/Array.maxon` opens both `create()` and `from(source)` with it.
		//
		// ⚠ It is an arm here rather than a field DEFAULT in the corpus, and the difference is not style: a
		// default is source the OTHER two compilers read as well, and it would cost a `coOwnAggregateAsTemp`
		// retain on a record the default had just built. The NON-empty spelling (`Self{managed: m}`) keeps the
		// ordinary path and reaches `emitFusedWrapperLiteral`'s identity arm, so the two forms stay the two
		// statics they mirror — `create()` and `init(managed)`.
		// ⭐⭐ **AND `Self{}` INSIDE `stdlib/FixedArray.maxon` IS THE SAME FORM ON THE SIZED CONTAINER, AND IT IS
		// THE WHOLE OF `Vec3.create()`.** The literal PUBLISHES its slots rather than building a countless
		// container: `emitOwnedContainerCreate`'s sized-container arm sizes the record from
		// `fixedElementCountValue`: a folded literal at a concrete `Vec3{}`, and the hidden count parameter
		// inside `FixedArray.create`, whose `Self` states none (`ownRecordSelfInstance`) so ONE body serves every
		// size. The declaration's `return Self{}` is unchanged, which is what lets the BOOTSTRAP compile the
		// same corpus line — it has no `countof` and needs none, because the count is the literal's.
		if self.signatures.declarationsValueIsTheManagedRecord(layout.name) and not (try filled.get(0) otherwise panic("parseStructLiteral: filled.get OOB at 0 — `declarationIsTheManagedRecord` established a sole field and the column is sized to the layout's field count")) 'theEmptyContainer'
			return try self.emitOwnedContainerCreate(self.signatures.ownRecordSelfInstance(layout.name), aliasTok: typeTok, aliasName: layout.name, range: SourceRange.between(typeTok, last: rbraceTok), sizing: ValueIdArray.create(0))
		end 'theEmptyContainer'

		self.fillFromNascentSelfSlots(layout, fieldValues: fieldValues, filled: filled, fieldBareLocal: fieldBareLocal, anchor: lbraceTok)
		try self.requireAllFieldsInitialized(layout, filled: filled, anchor: lbraceTok)

		let literal = try self.emitStructLiteral(layout, fieldValues: fieldValues, fieldBareLocal: fieldBareLocal, anchor: typeTok, range: SourceRange.between(typeTok, last: rbraceTok))
		self.markFreshWhenInputsClean(literal, inputs: fieldValues)
		self.settleHeldStores(func, literal: literal, floor: heldFloor, returnedDirectly: returnedDirectly)

		return literal
	end 'parseStructLiteral'

	function literalIsTheReturnedValue(func IrFunction, typeIndex ElementIndex) returns bool
		let statementStart = self.bodyState.statementStart

		if self.kindAt(statementStart) != TokenKind.return or typeIndex != statementStart + 1 or not self.statementEndsAt(self.pos) 'notTheWholeReturnedExpression'
			return false
		end 'notTheWholeReturnedExpression'

		if self.bodyState.declaredReturnCapability != ResultCapability.unmarked or maxonReturnTypeTag(func.maxonReturnType) == ValueTypeTag.interfaceRef 'aResultTheCallerJudgesBySomethingElse'
			return false
		end 'aResultTheCallerJudgesBySomethingElse'

		match self.bodyState.closureEnv 'body'
			param then return false
			none then break
		end 'body'

		return not windowIsOpen(self.regionFactsForRead().windows) and self.statement.drainingLoops == 0
	end 'literalIsTheReturnedValue'

	function settleHeldStores(func IrFunction, literal ValueId, floor ElementIndex, returnedDirectly bool)
		if self.regionFactsForRead().pendingHeld.count() <= floor 'nothingHeld'
			return
		end 'nothingHeld'

		let table = self.regionFactsForWrite()
		let stores = HeldStoreArray.create(0)

		while table.pendingHeld.count() > floor 'eachPendingStore'
			stores.push(try table.pendingHeld.pop() otherwise panic("settleHeldStores: pendingHeld.pop failed above the floor"))
		end 'eachPendingStore'

		if returnedDirectly 'heldByTheReturnedLiteral'
			table.heldLiterals.upsert(literal, value: stores)
			return
		end 'heldByTheReturnedLiteral'

		self.flushHeldStores(func, stores: stores)
	end 'settleHeldStores'

	function flushHeldStores(func IrFunction, stores HeldStoreArray)
		for store in stores 'eachHeldStore'
			if self.valueSettlesAfterParsing(store.value) 'aResultTheRecordKept'
				self.fileResultStore(store.value, slot: ParamCapability.unmarked, place: store.place, valueStart: store.valueStart)
				continue
			end 'aResultTheRecordKept'

			let enclosingStart = self.bodyState.statementStart
			self.bodyState.statementStart = store.statementStart
			self.notePassedParamNeed(func, value: store.value, mutable: true, line: store.line)
			self.bodyState.statementStart = enclosingStart
		end 'eachHeldStore'
	end 'flushHeldStores'

	function takeHeldLiteral(func IrFunction, value ValueId) returns (ParamPositionMask, bool)
		let stores = try self.regionFactsForRead().heldLiterals.get(value) otherwise return (NoParamPositions, false)
		let table = self.regionFactsForWrite()
		_ = table.heldLiterals.remove(value)
		var held = NoParamPositions
		var holdsAResult = false

		for store in stores 'eachHeldStore'
			if self.valueSettlesAfterParsing(store.value) 'aResultTheRecordKeeps'
				self.noteHeldResult(store.value)
				holdsAResult = true
				continue
			end 'aResultTheRecordKeeps'

			held = held or self.paramSourcesOf(func, value: store.value)
		end 'eachHeldStore'

		table.paramSources.heldReturned = table.paramSources.heldReturned or held
		return (held, holdsAResult)
	end 'takeHeldLiteral'

	function noteHeldResult(value ValueId)
		let ops = try self.settlingOpsOf(value) otherwise panic("noteHeldResult: a held result is registered with its defining op")
		let notes = self.notesForWrite(self.bodyFunction())

		for opIdx in ops 'eachSettlingOp'
			notes.heldResultOps.push(opIdx)
		end 'eachSettlingOp'
	end 'noteHeldResult'

	function flushUnreturnedHeldLiterals(func IrFunction)
		if self.regionFactsForRead().heldLiterals.count() == 0 'nothingLeft'
			return
		end 'nothingLeft'

		let table = self.regionFactsForWrite()

		for (_, stores) in table.heldLiterals 'eachLeftover'
			self.flushHeldStores(func, stores: stores)
		end 'eachLeftover'

		table.heldLiterals = HeldLiteralMap.create()
	end 'flushUnreturnedHeldLiterals'

	function noteHeldParams(func IrFunction)
		let held = self.regionFactsForRead().paramSources.heldReturned

		if held == NoParamPositions 'nothingHeld'
			return
		end 'nothingHeld'

		let notes = self.notesForWrite(func)

		for param in 0 upto func.paramCount 'eachParam'
			if maskHasParam(held, param: param) 'aHeldParam'
				notes.heldParams.push(param)
			end 'aHeldParam'
		end 'eachParam'
	end 'noteHeldParams'

	// ⭐⭐ **THE THIRD SOURCE OF A SLOT'S VALUE (`/specs/field-initialization.md`, rule 3): a `self.<field> = …`
	// THIS FACTORY RAN EARLIER.** Asked after the literal's own fields and after the declared defaults, and
	// before `requireAllFieldsInitialized`, which is the precedence the spec states — the literal always
	// wins, and a deferred assignment is what a slot neither of them filled falls back to.
	//
	// ⚠ **IT FILLS, AND THE PROOF IS OWED SEPARATELY.** Whether the assignment REACHES this literal on every
	// path is a question about control flow, and the parse is in the middle of the body — so the site is
	// recorded and `validateNascentSelfAssignments` discharges it once the blocks exist.
	//
	// ⚠ The slot is a bare LOCAL, so the field is marked `fieldBareLocal`: a managed field would be moved out
	// of it, which is exactly what the literal spelling of the same value does. (No managed field reaches
	// here today — `declareNascentSelfSlots` opens no slot for one — but the mark is the honest description
	// of where the value came from, not a bet on which types arrive.)
	function fillFromNascentSelfSlots(layout StructLayout, fieldValues ValueIdArray, filled FixedBoolArray, fieldBareLocal BoolArray, anchor Token)
		if not self.bodyState.inNascentSelfFactory 'notAFactory'
			return
		end 'notAFactory'

		let deferred = NameRoster.create(0)

		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("fillFromNascentSelfSlots: filled.get OOB at {i} — the columns are sized to the layout's field count")

			if wasFilled 'alreadyGiven'
				continue
			end 'alreadyGiven'

			let fieldName = try layout.fieldNames.get(i) otherwise panic("fillFromNascentSelfSlots: fieldNames.get OOB at {i}")
			let slotName = nascentSelfSlotName(fieldName)

			if not self.bodyState.scope.contains(slotName) 'notDeferred'
				continue
			end 'notDeferred'

			try fieldValues.set(i, value: self.bodyState.scope.getInfo(slotName).boundValue) otherwise panic("fillFromNascentSelfSlots: fieldValues.set OOB at {i}")
			try filled.set(i, value: true) otherwise panic("fillFromNascentSelfSlots: filled.set OOB at {i}")
			try fieldBareLocal.set(i, value: true) otherwise panic("fillFromNascentSelfSlots: fieldBareLocal.set OOB at {i}")
			deferred.push(fieldName)
		end 'eachField'

		if deferred.count() == 0 'nothingDeferred'
			return
		end 'nothingDeferred'

		self.bodyState.nascentSelfChecks.push(NascentSelfCheck.create(deferred, typeName: layout.name, block: self.bodyState.currentBlock.id, position: self.bodyState.currentBlock.bodyOpCount(), line: anchor.line, column: anchor.column))
	end 'fillFromNascentSelfSlots'

	// ⭐⭐ **`<InnerAlias>{}` IS THE ALIAS'S EMPTY CONTAINER — the very value `<InnerAlias>.create()` builds**
	// A TOTAL router, so a form nobody thought about meets a sentence naming what it is rather than
	// E3076's "use a static factory", a cure that exists for exactly one of the four arms below.
	//
	// `enclosingInnerAliases` holds two FORMS (`readNestedTypeAlias`: a GENERIC-INSTANCE alias and a RANGED
	// numeric one — a nested TUPLE alias is refused at its declaration and a nested FUNCTION alias is a
	// file-scope name that never enters the set). They split four ways here, because a generic instance is
	// either a container this compiler OWNS or a user type's, and because an alias declared in an `extension`
	// body reaches this set without reaching either whole-program registry.
	function parseInnerAliasLiteral(func IrFunction, aliasTok Token) returns ValueId throws SourceParseError
		// The whole-program key an inner alias is registered under — the SAME name `parseTypeReference`'s
		// inner-alias arm stamps a field type with and `parseQualifiedCall`'s `<InnerAlias>.create()` looks the
		// instance up by, because a bare member collides with a same-named inner alias of another type.
		let qualified = self.innerAliasKey(aliasTok.value)

		// ⛔ A RANGED NUMERIC ALIAS DECLARES NO FIELDS, so there is nothing for a literal to write and no
		// container for `{}` to mean. No spelling is pinned for it, so the message names the cure instead
		// — the enum/union refusal in `requireConstructible` one door over is the same shape for the same
		// reason.
		if self.signatures.isInnerAlias(qualified) 'rangedNumeric'
			throw SourceParseError.unsupported("a struct literal naming `{String.from(aliasTok.value)}`, a ranged numeric typealias declared by `{String.from(self.enclosingTypeName())}` — a number declares no fields to write, so write the number itself. `\{\}` on an inner alias builds the EMPTY CONTAINER a container alias denotes, and a numeric alias denotes no container", line: aliasTok.line, column: aliasTok.column)
		end 'rangedNumeric'

		// ⛔ THE ALIAS IS IN NEITHER WHOLE-PROGRAM REGISTRY, so there is no interned instance to create.
		//
		// ⭐ **AN `extension` BODY'S NESTED ALIAS IS KEYED PER CONFORMER** (`foldExtensionDeclarationInto`), which is what makes
		// `stdlib/Interfaces.maxon`'s `extension Iterable` compile
		// (`map`/`filter` open with `var result = ElementArray\{\}`). What can arrive here is the
		// declaration sweep having failed to publish an alias the REAL parse went on to accept locally: both
		// walks are tolerant by design (`recordScannedType`, `foldExtensionDeclarationInto`), and a malformed
		// member earlier in the body ends the sweep's walk while `enclosingInnerAliases` is filled by the parse
		// that reaches this literal. That program is being refused for its real fault a moment later; this arm
		// exists so the refusal it gets HERE is not E3076's: that one prescribes a static factory, and the
		// factory an unkeyed alias would need (`{alias}.create()`) has nothing to resolve to either.
		if not self.signatures.isGenericAliasInAnyFile(qualified) 'notKeyedWholeProgram'
			throw SourceParseError.unsupported("a struct literal naming `{String.from(aliasTok.value)}`, an inner typealias of `{String.from(self.enclosingTypeName())}` that the whole-program declaration sweep did not key — so there is no container instance for the literal to build. A sweep stops early at a member it cannot read, so the declaration this one shares a body with is the fault to look for", line: aliasTok.line, column: aliasTok.column)
		end 'notKeyedWholeProgram'

		let giid = self.signatures.genericAliasInstanceFrom(qualified, readerFilePath: self.job.path)

		if self.defersOnRefusedInstance(giid) 'aRefusedInstance'
			try self.absorbStructLiteralFields(func)

			return self.mintDeferredValue()
		end 'aRefusedInstance'

		// ⛔ A USER TYPE'S GENERIC INSTANCE KEEPS E3076, and that is the ONE inner-alias form the widening
		// deliberately does not reach. `typealias IntPair = Pair with Count` denotes `Pair`, whose invariants
		// are `Pair`'s own to establish — writing its literal here is exactly what the restriction is for, and
		// the static factory it prescribes IS WRITABLE HERE (`IntPair.create(…)`): it resolves through
		// `genericAliasKeyFor` and is pinned by `user-generic-inner-alias-create-is-the-cure`.
		// (The oracle ACCEPTS it, which voids its own E3076 for
		// any type willing to declare an alias; that divergence is deliberate — and it is why no oracle pin
		// covers this anchor.) Anchored inside the brace, which is where `requireConstructible` anchors the
		// same refusal, so ONE rule places E3076 wherever it is raised from rather than two arms each
		// matching their own pins.
		if not self.signatures.isBuiltinGenericBaseName(self.signatures.genericInstanceBaseName(giid)) 'userType'
			let insideBrace = self.structLiteralBraceInteriorToken()
			throw SourceParseError.constructorRestricted(String.from(aliasTok.value), line: insideBrace.line, column: insideBrace.column)
		end 'userType'

		try self.consume(TokenKind.leftBrace)

		// ⛔ The literal is the container's EMPTY value and nothing else — a builtin container's record is the
		// runtime's, with no user-writable field for a `name: value` pair to name. Anchored at the field the
		// author wrote, which is the token that is inadmissible.
		if not self.at(TokenKind.rightBrace) 'writtenField'
			let fieldTok = self.current()
			throw SourceParseError.unsupported("a field written inside `{String.from(aliasTok.value)}\{…\}` — the literal builds the EMPTY container `{String.from(aliasTok.value)}.{String.from(CreateMethod)}()` builds, and a builtin container has no user-writable fields; fill it after creating it", line: fieldTok.line, column: fieldTok.column)
		end 'writtenField'

		let rbraceTok = try self.consume(TokenKind.rightBrace)
		return try self.emitOwnedContainerCreate(giid, aliasTok: aliasTok, aliasName: qualified, range: SourceRange.between(aliasTok, last: rbraceTok), sizing: ValueIdArray.create(0))
	end 'parseInnerAliasLiteral'

	// ⭐⭐ **WHERE AN INADMISSIBLE STRUCT LITERAL IS BLAMED: THE TOKEN FOLLOWING THE `{`, NOT THE TYPE
	// NAME.** The line and the column both come off the token after the `{`, for E3072 and E3076
	// alike: `let b = Box{v: 5}` blames column 14 (`v`) where `Box` is 10, `let bb = Box{v: 5, w: 6}`
	// blames 15, and `let e = Empty{}` blames the `}` — which is what says the rule is *the token
	// after the brace* rather than *the first field label*. `specs/struct-construction-restriction.md`
	// and `specs/managed-file.md` pin those columns, so it is the acceptance criterion and not a
	// preference; anchoring at the type name would read better to me, and that is not an argument.
	//
	// For a multi-line literal the token after the `{` is the first field on the next line: the lexer
	// drops the layout inside the braces (`Lexer.dropBracketedLayout`).
	function structLiteralBraceInteriorToken() returns Token
		// ⛔ **THE PREMISE IS THE ROUTE, NOT THE PAIR OF CALL SITES.** Every caller reached its literal
		// through `parsePrimary`'s `{`-LOOKAHEAD arm (`peekKind() == leftBrace`), which is what puts the
		// cursor on the brace. Being "a refusal raised between `consumeTypeBaseToken` and the literal's own
		// `consume(leftBrace)`" does NOT imply it and must not be read as implying it: the `enumBody` arm
		// below is exactly such a refusal and is reachable with the cursor on ANY token, through the
		// braceless `Self` route — see the reason recorded there for why it keeps its own anchor.
		//
		// Asserted rather than asserted-in-prose: a future arm moved onto this reader from the braceless
		// route would otherwise silently blame a token from the middle of an unrelated construct.
		if not self.at(TokenKind.leftBrace) 'cursorNotOnBrace'
			panic("Parser.structLiteralBraceInteriorToken: the cursor is on '{tokenDisplayText(self.current())}', not the '\{' of a struct literal — this reader is only meaningful between `consumeTypeBaseToken` and the brace's own `consume`")
		end 'cursorNotOnBrace'

		return self.tokenAt(self.pos + 1)
	end 'structLiteralBraceInteriorToken'

	// ⭐ **E3076 — CONSTRUCTION IS RESTRICTED TO THE TYPE'S OWN BODY.** `Self{…}` and `Point{…}`
	// inside `type Point`; nothing anywhere else. An external caller goes through
	// `Point.create(…)`.
	//
	// The point is that a type gets ONE place its invariants are established. Both reference
	// compilers impose exactly this restriction under exactly this code, and it is what makes
	// `static function create` the universal shape of the corpus rather than a convention.
	//
	// The order of the two rejections is the decision: a name that is not a struct AT ALL is not a
	// constructor-restriction violation, so it reports what it actually is.
	// ⚠ It takes the TOKEN and reads the name off it, rather than taking both: the name and the position are
	// one fact about one token, and a second parameter is a licence for a later caller to make a diagnostic
	// NAME one token while POINTING AT another.
	function requireConstructible(typeTok Token) returns StructLayout throws SourceParseError
		let typeName = typeTok.value

		// The RESTRICTION is checked before the LOOKUP, and the order is the decision: `Foo{…}`
		// outside `type Foo` is E3076 whether or not `Foo` exists, because the restriction is about
		// WHERE the literal is written, not about what it names. Asking the registry first would
		// report "no such type" for a `Point{…}` written in `main` — naming a type that is right
		// there in the file, which is a confusing answer to a question the user did not ask.
		// ⭐ **A COMPILER BUILTIN MANAGED TYPE IS REFUSED BEFORE THE LOCATION CHECK (E3072).** The
		// order is the decision, exactly as the paragraph above makes one: E3076 says "not HERE" and
		// prescribes a static factory THE USER COULD WRITE, but `__ManagedFile` has NO source body for a
		// literal to be legal in and no user-writable static at all — its handle comes from the OS. So the
		// location question never applies to it, and asking it first would answer a program's
		// `__ManagedFile{_handle: 0}` with a cure that cannot be written for that type at all.
		// ⚠ **BOTH REFUSALS ARE ANCHORED INSIDE THE BRACE, NOT AT THE TYPE NAME** — the oracle's choice, read
		// off its emitter once and written down once in `structLiteralBraceInteriorToken`. The reader is asked
		// INSIDE each arm and not once above them, because this routine is ALSO reached with no brace in
		// sight: `parsePrimary`'s `selfPrimary` arm routes a bare `Self` here on the token alone, and the
		// missing brace is the E2010 from the `consume` below. Hoisting the read would turn that program's
		// diagnostic into this file's panic. Which arms are safe on that route is a question per arm:
		//
		//   • **E3076 (`outsideItsOwnBody`) — STRUCTURALLY unreachable there.** `typeBaseTokenAt` mints a
		//     bare `Self`'s token from `requireEnclosingTypeName`, so the name it carries IS the enclosing
		//     declaration and `namesEnclosingType` cannot be false.
		//   • **E3072 (`builtinManagedType`) — unreachable only CONTINGENTLY, and the premise is scheduled to
		//     weaken.** It rests on no `__`-prefixed type being declarable outside `stdlib/Builtins.maxon`
		//     (`requireUnreservedName`) and on Builtins declaring none of these names — while
		//     `isBuiltinManagedTypeName`'s own header (`SignatureIndex.maxon`) says the list grows as those
		//     types arrive in the corpus. ⇒ **The day one is declared as a `type`, a bare `Self` in its body
		//     panics here.** The durable fix is `selfPrimary` gating on `peekKind() == leftBrace`, which is
		//     NOT a ride-along: it moves a bare `Self` in an enum body off the `enumBody` sentence below and
		//     onto E2010, and that needs a pin sweep first.
		//   • **The `enumBody` arm keeps its own anchor for this reason** — see it below.
		try self.requireTypeSpellingIsNotRawBuffer(typeTok)

		if isBuiltinManagedTypeName(typeName) 'builtinManagedType'
			let insideBrace = self.structLiteralBraceInteriorToken()
			throw SourceParseError.builtinTypeConstruction(String.from(typeName), line: insideBrace.line, column: insideBrace.column)
		end 'builtinManagedType'

		if not self.namesEnclosingType(typeName) 'outsideItsOwnBody'
			let insideBrace = self.structLiteralBraceInteriorToken()
			throw SourceParseError.constructorRestricted(String.from(typeName), line: insideBrace.line, column: insideBrace.column)
		end 'outsideItsOwnBody'

		// ⛔ **AN `enum`/`union` HAS NO FIELDS TO WRITE, SO A STRUCT LITERAL CANNOT CONSTRUCT ONE** — the
		// exact twin of `enclosingLayout`'s enum guard, one door over, and reached the same way: the check
		// above has just established the name IS the enclosing declaration, which for an enum body means the
		// lookup below asks the STRUCT registry for a name only the ENUM registry holds. It would take the compiler
		// down at the panic below while blaming the declaration sweep for a disagreement that never happened —
		// `Self{}` and `Toggle{}` inside `enum Toggle`'s own body, both of them.
		//
		// A positioned refusal, because the source can perfectly well write it. No spelling is pinned for
		// it, so the message names the cure instead.
		//
		// ⛔⛔ **THIS ARM ANCHORS AT THE TYPE TOKEN AND MUST NOT BE MOVED ONTO `structLiteralBraceInteriorToken`
		// — IT IS THE ONE ARM DEMONSTRABLY REACHED WITH NO BRACE AT ALL.** A bare `Self` inside an enum body
		// arrives through `parsePrimary`'s `selfPrimary` route, which routes on the token alone with no `{`
		// lookahead, and lands here: MEASURED, `let x = Self` in `enum Color`'s own method answers
		// `E2015 …:6:11: Unsupported: a struct literal naming `enum`/`union` `Color` …`. Routing it through
		// the brace reader would turn that program into a compiler panic. The anchor differing from E3076's
		// two arms above is therefore a consequence of the ROUTE, not a spec pin this arm happens to match.
		if self.enclosingTypeIsEnum 'enumBody'
			throw SourceParseError.unsupported("a struct literal naming `enum`/`union` `{String.from(typeName)}` — an enum/union declares no fields to write; a value of it is a CASE (`{String.from(typeName)}.<case>`, or `Self.<case>` from inside its own body)", line: typeTok.line, column: typeTok.column)
		end 'enumBody'

		match self.signatures.structFor(typeName, readerFilePath: self.job.path) 'declared'
			declared(layout) then return layout

			// Unreachable: `namesEnclosingType` held and the enclosing declaration is a `type`, so this IS
			// the struct currently being declared — and the declaration sweep recorded every `type` in the
			// program before this file's parse began. A miss means the sweep and the real parse disagree
			// about what a type declaration is, which is the drift `ProgramSignatures.declaredOutcome`
			// panics on for a constant, stated here for a type.
			undeclared then panic("requireConstructible: `type {String.from(typeName)}` is being parsed right now, but the declaration sweep never recorded it — `recordScannedType` and `parseTypeDeclaration` disagree about what opens a type declaration")
		end 'declared'
	end 'requireConstructible'

	// The `name: value` pairs inside the braces, into the LAYOUT-parallel columns. The caller has
	// consumed `{`; this leaves the cursor on `}`.
	//
	// ⚠ **EVERY FIELD IS LABELLED, INCLUDING THE FIRST — which is the opposite of a CALL's rule**
	// (`ArgLabelRule`: the first argument is positional unless its parameter has a default). They
	// are two syntaxes, not one: a call's arguments are ordered by the DECLARATION and the first needs
	// no name to find its place, while a struct literal names slots outright. So this reads its own
	// labels rather than reusing the call's, and `slotCallArgs` is not involved — there is nothing
	// to reorder, because the label IS the destination.
	function parseStructLiteralFields(func IrFunction, layout StructLayout, fieldValues ValueIdArray, filled FixedBoolArray, fieldBareLocal BoolArray) throws SourceParseError
		if self.at(TokenKind.rightBrace) 'noFields'
			return
		end 'noFields'

		// ⭐ **THE VALUES ALREADY STORED INTO AN OWNING FIELD OF THIS LITERAL.** A
		// field that takes its OWN reference may hold a value a second field holds too — `Self{a: v, b: v}` over
		// a concrete managed `v` increfs per slot and is released per slot (the 2026-08-12 ruling). What is
		// still refused is a repeat at a field that INHERITS this frame's single reference, which would drop it
		// twice; `rejectDoubleOwningStore` asks that through the gate the ARGUMENT guard asks too.
		let movedOwningValues = ValueIdArray.create(0)

		while true 'fieldLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.colon)

			let index = try self.requireFieldIndex(layout, name: nameTok.value, anchor: nameTok)

			let alreadyFilled = try filled.get(index) otherwise panic("parseStructLiteralFields: filled.get OOB at {index} — the columns are sized to the layout's field count")

			if alreadyFilled 'duplicate'
				throw SourceParseError.duplicateFieldInitializer(String.from(layout.name), fieldName: String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			end 'duplicate'

			// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
			// `parseCallArgs`' reason: a field's value is parsed INSIDE an expression that has already
			// seeded `currentBlock`, and re-seeding it would discard a short-circuit an earlier field
			// performed — while `T{f: a if c else b}` still needs the ternary. The value's start position is
			// captured first so `rhsWasBareLocalReference` can decide, after the value is parsed, whether
			// it was a bare local — a managed field's move-in poisons that source.
			let valueStart = self.pos
			let fieldType = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)
			self.stateDeclaredLiteralTarget(fieldType, scopeFilePath: layout.declFilePath, valueStart: valueStart)
			let parsed = try self.parseValueExpression(func)

			// The COERCED value is what fills the slot — `Self{v: 3}` into a `float` field stores the
			// widened f64, not the integer's bytes. A widening only ever produces a fresh scalar, so the
			// ownership questions below still read the value the source actually named.
			let value = try self.requireFieldType(layout, index: index, fieldType: fieldType, value: parsed, valueStart: valueStart, anchor: nameTok)

			try self.admitStore(func, slot: layout.fieldTypeSites.capabilityAt(index), value: parsed, valueStart: valueStart, place: "{String.from(layout.name)}.{String.from(self.fieldNameAt(layout, index: index))}", holder: StoreHolder.building)
			try self.rejectDoubleOwningStore(movedOwningValues, value: parsed, valueStart: valueStart)

			let bareLocal = self.rhsWasBareLocalReference(valueStart)

			let held = self.holdStorageReadForStatement(value, kind: HoldKind.listOperand, range: SourceRange.ofToken(nameTok), position: self.literalSuccession(layout, filled: filled, current: index))

			try fieldValues.set(index, value: held) otherwise panic("parseStructLiteralFields: fieldValues.set OOB at {index} — the columns are sized to the layout's field count")
			try filled.set(index, value: true) otherwise panic("parseStructLiteralFields: filled.set OOB at {index} — the columns are sized to the layout's field count")
			try fieldBareLocal.set(index, value: bareLocal) otherwise panic("parseStructLiteralFields: fieldBareLocal.set OOB at {index} — the columns are sized to the layout's field count")

			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'

			try self.consume(TokenKind.comma)
		end 'fieldLoop'
	end 'parseStructLiteralFields'

	function absorbStructLiteralFields(func IrFunction) throws SourceParseError
		try self.consume(TokenKind.leftBrace)

		while not self.at(TokenKind.rightBrace) 'eachField'
			try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.colon)
			_ = try self.parseValueExpression(func)

			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'

			try self.consume(TokenKind.comma)
		end 'eachField'

		try self.consume(TokenKind.rightBrace)
	end 'absorbStructLiteralFields'

	function requireFieldType(layout StructLayout, index FieldIndex, fieldType MaxonType, value ValueId, valueStart ElementIndex, anchor Token) returns ValueId throws SourceParseError
		let site = self.slotStoreSiteOf(layout, index: index, valueStart: valueStart, anchor: anchor)

		return try self.requireFieldTypeFit(layout, index: index, fieldType: fieldType, value: value, valueStart: valueStart, anchor: anchor, site: site)
	end 'requireFieldType'

	// A field initializer / assignment must agree with the field's DECLARED type. A SCALAR field takes the
	// `checkDeclaredType` coercion-site rule (the same one a call argument, a `return` and an assignment
	// ask). A MANAGED field (a `String` or a `struct`) takes the tag-AND-name check `requirePayloadArgType`
	// uses for a union payload — a struct field's declared type is `named(<Struct>)` (unresolved), which the
	// tag path would read as `int` (`typeTagName(named)`), so it MUST classify first (`classifyUnionPayload`
	// resolves it to `managed(structRef)`) rather than compare the raw tag.
	//
	// It is the parser's to check and not SemanticCheck's, unlike a call ARGUMENT: a call's callee
	// may be declared in another file, but a struct literal's layout is already in hand here — the
	// parser had to have it to know the field exists at all.
	//
	// ⭐ **IT RETURNS THE VALUE THE FIELD WANTS, AND EVERY CALLER REBINDS.** A scalar field is a coercion
	// site like any other, so an int meeting a declared `float` widens (`assignableValue`) — and the
	// promoted id is a DIFFERENT SSA value from the one that was parsed. A caller that stores the value it
	// already held writes the integer's raw bytes into an f64 slot. Answering with the coerced value makes
	// the check and the conversion ONE call, in ONE place, for every door.
	//
	// A MANAGED field returns its value untouched — there is no scalar widening on a pointer, and the
	// move-in the callers perform is a separate decision made downstream.
	function requireFieldTypeFit(layout StructLayout, index FieldIndex, fieldType MaxonType, value ValueId, valueStart ElementIndex, anchor Token, site SlotStoreSite) returns ValueId throws SourceParseError
		let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: fieldType, slotScopeFilePath: layout.declFilePath)

		// ⭐⭐ **AN INTERFACE-TYPED FIELD ASKS ITS OWN QUESTION** — it is the one
		// field whose slot has TWO words, so what it admits is decided by which values carry both
		// (`widenValueIntoExistentialField`), not by the storage-type comparison below. Routed out FIRST
		// because that comparison would otherwise be asked with a one-word storage type it has no answer for.
		if payloadClassIsExistential(class) 'existentialField'
			return try self.widenValueIntoExistentialField(layout, index: index, fieldType: fieldType, value: value, site: site)
		end 'existentialField'

		if payloadClassIsManaged(class) 'managed'
			let widened = self.interfaceHandleOf(try self.destinationTemporary(value, declared: fieldType, anchor: anchor), declared: fieldType, first: anchor, last: anchor)
			try self.requireManagedSlotValueMatches(class, declared: fieldType, value: widened, placeDoor: FunctionTypeDoor.field, placeName: self.fieldNameAt(layout, index: index), placeOwner: site.owner, placeBrand: self.fieldPlaceBrand(layout, index: index, resolved: fieldType), placeSpelling: self.fieldPlaceSpelling(layout, index: index, fieldType: fieldType), voice: SlotMismatchVoice.assignedPlace, anchor: site.anchor)
			return widened
		end 'managed'

		// The SAME verdict-plus-coercion the assignment doors ask, through the `field` door — which is what it always
		// was, spelled out a second time: the four `DeclaredTypeMatch` arms that stood here were a
		// character-for-character copy of `requireAssignable`'s, and a rule with two homes drifts.
		let stored = try self.assignableValue(site.anchor, value: value, declared: maxonTypeTag(fieldType), declaredNameId: typeNameIdOf(self.fieldTypeKeepingAlias(layout, index: index, collapsed: fieldType)), door: FunctionTypeDoor.field, placeOwner: site.owner, voice: SlotMismatchVoice.assignedPlace)

		// ⭐⭐ **AND THE IDENTITY THAT VERDICT CANNOT SEE — the door `parseAssignment` also has
		// and this one needs.** `assignableValue`'s verdict is tag-based, and a payload-free ENUM field is
		// `named` + SCALAR, so it takes the arm above rather than the managed one: `checkDeclaredType(named,
		// named)` AGREES for any two enums, and `h.c = Shade.light` on a `Color` field compiled and stored
		// (MEASURED 2026-08-06, `requireSlotAggregateIdentity` carries the full note). All three
		// field doors funnel through here, so the literal and the two writes are closed by the one check.
		try self.requireSlotAggregateIdentity(self.fieldTypeKeepingAlias(layout, index: index, collapsed: fieldType), value: value, placeDoor: FunctionTypeDoor.field, placeName: self.fieldNameAt(layout, index: index), placeOwner: site.owner, placeBrand: self.fieldPlaceBrand(layout, index: index, resolved: fieldType), placeSpelling: self.fieldPlaceSpelling(layout, index: index, fieldType: fieldType), voice: SlotMismatchVoice.assignedPlace, anchor: site.anchor)

		// ⭐ **THE FIELD'S DECLARED RANGE BINDS WHAT IS STORED IN IT.** The site is recorded on the
		// COERCED value, not the parsed one: that is the value the slot receives, and for a widening door
		// (an int meeting a declared float) it is a different SSA id. All three field doors — the struct
		// literal, the field write, the self-field write — funnel through here, so one record covers them.
		//
		// ⚠ The alias is read off the field's DECLARED spelling, in the declaring file: `fieldType` has a
		// ranged float alias erased to bare `float` (`declaredSlotType`), and a store written in another
		// file must not be checked against that file's same-named alias.
		self.recordFieldRangeChecks(value, stored: stored, valueStart: valueStart, layout: layout, index: index, storedType: fieldType, anchor: site.anchor)
		return stored
	end 'requireFieldTypeFit'

	function slotStoreSiteOf(layout StructLayout, index FieldIndex, valueStart ElementIndex, anchor Token) returns SlotStoreSite
		if isTupleTypeName(layout.name) 'aTupleElement'
			let elementPlace = "element {index} of tuple {self.signatures.displayNameOfAggregate(ValueTypeTag.structRef, aggregate: layout.name)}"
			return SlotStoreSite.create(elementPlace, anchor: self.tokenAt(valueStart), owner: SlotOwner.tupleElement(elementPlace.clone()))
		end 'aTupleElement'

		return SlotStoreSite.create("{String.from(layout.name)}.{String.from(anchor.value)}", anchor: anchor, owner: SlotOwner.declaredBy(layout.name))
	end 'slotStoreSiteOf'

	function fieldTypeKeepingAlias(layout StructLayout, index FieldIndex, collapsed MaxonType) returns MaxonType
		let declared = try layout.fieldTypes.get(index) otherwise panic("Parser.fieldTypeKeepingAlias: field {index} is out of range for `type {String.from(layout.name)}`, which declares {layout.fieldCount()}")
		return self.typeKeepingAlias(declared, collapsed: collapsed, scopeFilePath: layout.declFilePath)
	end 'fieldTypeKeepingAlias'

	function typeKeepingAlias(declared MaxonType, collapsed MaxonType, scopeFilePath FilePath) returns MaxonType
		if not tagIsFloat(maxonTypeTag(collapsed)) or not self.signatures.typeIsARangedAlias(declared, slotScopeFilePath: scopeFilePath) 'aBareFloatSlot'
			return collapsed
		end 'aBareFloatSlot'

		return self.signatures.adoptType(declared, into: self.artifact.typeNames)
	end 'typeKeepingAlias'

	function payloadPlaceText(layout EnumLayout, field PayloadField, caseTok Token) returns String
		return "{String.from(layout.name)}.{String.from(caseTok.value)}.{String.from(field.name)}"
	end 'payloadPlaceText'

	function valueIsOpaque(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.typeParameter
	end 'valueIsOpaque'

	function recordFieldRangeChecks(value ValueId, stored ValueId, valueStart ElementIndex, layout StructLayout, index FieldIndex, storedType MaxonType, anchor Token)
		if let declaredName = try self.signatures.declaredFieldTypeName(layout, index: index) 'theFieldNamesItsType'
			let destination = try self.signatures.rangeCheckedAliasNamed(declaredName, readerFilePath: layout.declFilePath) otherwise return
			self.reportUnneededLiteralCastInto(value, first: valueStart, destination: destination)
			self.recordRangedTargetSite(stored, target: destination, line: anchor.line, column: anchor.column)
			return
		end 'theFieldNamesItsType'

		self.recordRangeCheckSite(stored, destination: storedType, line: anchor.line, column: anchor.column)
	end 'recordFieldRangeChecks'

	// ⭐ **REJECT A REPEATED OWNING STORE OF ONE VALUE INTO TWO FIELDS OF ONE LITERAL** — a clean E3102
	// on `Self{a: v, b: v}` instead of a double-free, for the ONE class of value whose store still
	// INHERITS this frame's reference rather than taking its own. Which class that is, is not this
	// door's to decide: `repeatedOwningDestinationWouldDoubleFree` is the shared gate, and the
	// ARGUMENT guard asks it too. It runs at PARSE, before any move-in, so the value is still live at
	// both uses; `valueStart`'s token names and positions the second use.
	//
	// ⛔⛔ **IT DOES NOT REFUSE AN OWNED CONCRETE MANAGED VALUE (⚖ user ruling, 2026-08-12).** A durable store takes its
	// own reference (`moveManagedValueInto`), so `Self{a: v, b: v}` over a concrete managed `v` increfs twice, the record
	// ends at refcount 3 against two slots plus the source binding and is released exactly three times. A refusal here
	// would be a diagnostic whose stated reason the file next door contradicts, which is this project's signature defect
	// rather than a conservative choice.
	//
	// ⛔ **IT ASKS ABOUT THE VALUE AND NOT THE FIELD'S DECLARED TYPE, AS ITS SIBLING DOES — ANYTHING ELSE IS TWO
	// ANSWERS TO ONE QUESTION.** An opaque field holding a value the descriptor CAN retain
	// (`opaqueSlotTakesItsOwnReference`) takes one reference per slot, so refusing it here while the identical
	// repeat at two consuming ARGUMENTS is accepted would be inconsistent; a substituted-concrete value in an opaque field
	// has the same non-reason. Both doors read the value, through one predicate.
	function rejectDoubleOwningStore(movedOwningValues ValueIdArray, value ValueId, valueStart ElementIndex) throws SourceParseError
		if not self.repeatedOwningDestinationWouldDoubleFree(value) 'everyDestinationTakesItsOwnReference'
			return
		end 'everyDestinationTakesItsOwnReference'

		if self.isRepeatedOwningMove(movedOwningValues, value: value) 'doubleMove'
			let valueTok = self.tokenAt(valueStart)
			throw SourceParseError.useAfterMove(String.from(valueTok.value), line: valueTok.line, column: valueTok.column)
		end 'doubleMove'
	end 'rejectDoubleOwningStore'

	// ⭐ **THE ONE "this value has ALREADY reached an owning destination in this construct" LEDGER**
	// Returns true when `value` was ALREADY recorded in `movedOwningValues` (the caller throws its own
	// positioned E3102), else records it and returns false. Shared by the STRUCT-LITERAL guard
	// (`rejectDoubleOwningStore` — `Self{a: v, b: v}`) and the CALL-ARGUMENT double-consume guard
	// (`transferConsumedArgs` — `Pair.create(box, b: box)`), so the two sites cannot drift on what a REPEAT is —
	// and they do not drift on WHICH VALUES it is asked of either: both gate on the one shared
	// `repeatedOwningDestinationWouldDoubleFree`. What each caller still keeps is its own diagnostic name and
	// position — the name is resolved only on a repeat, where the value is always a bound local (a temporary is
	// minted by one expression and cannot reach two destinations), never an anonymous temp.
	//
	// ⛔ **BOTH GATES ADMIT THE OPAQUE CASE ALONE, NOT A CONCRETE OWNED MANAGED VALUE.** A concrete durable store takes
	// its own reference, so two of them are two references and nothing is dropped twice. The opaque case is guarded
	// for a MISSING DESCRIPTOR rather than a missing instruction.
	function isRepeatedOwningMove(movedOwningValues ValueIdArray, value ValueId) returns bool
		for prior in movedOwningValues 'eachPrior'
			if prior == value 'doubleMove'
				return true
			end 'doubleMove'
		end 'eachPrior'

		movedOwningValues.push(value)
		return false
	end 'isRepeatedOwningMove'

	// ⭐⭐ **WHAT MAY STAND IN AN INTERFACE-TYPED FIELD.** A value already held at an interface must be held at
	// THIS one, EXACTLY, and deliberately not by the `extends`-transitive rule: a `Derived` witness addresses
	// `Derived`'s table, whose slot ORDER is not `Base`'s, so forwarding one into a `Base` slot is a wrong
	// function pointer rather than a widening.
	// `requireManagedValueMatches` decides that, over the DECLARED interface type.
	//
	// A CONCRETE value is admitted and widened at the store (`fieldStoreWitness`). Whether it conforms is
	// decided whole-program, for the reason `parseReturnStatement` gives at the other widening position the
	// parser admits unjudged.
	function widenValueIntoExistentialField(layout StructLayout, index FieldIndex, fieldType MaxonType, value ValueId, site SlotStoreSite) returns ValueId throws SourceParseError
		if self.tagOf(value) != ValueTypeTag.interfaceRef 'aConcreteConformer'
			return value
		end 'aConcreteConformer'

		try self.requireManagedValueMatches(fieldType, isString: false, value: value, placeDoor: FunctionTypeDoor.field, placeName: self.fieldNameAt(layout, index: index), placeOwner: site.owner, placeBrand: self.fieldPlaceBrand(layout, index: index, resolved: fieldType), placeSpelling: self.fieldPlaceSpelling(layout, index: index, fieldType: fieldType), voice: SlotMismatchVoice.assignedPlace, anchor: site.anchor)
		return value
	end 'widenValueIntoExistentialField'

	// The `<Struct>.<field>` label a managed-field type mismatch names.
	// The declared name of one field — the single `get` that both the dotted prose name below and the
	// assignment sentence's place are built from (`assignedPlacePhrase`, which the field doors reach through
	// `placeName`). It is the NAME and not the phrase, because the sentence is worded only where the voice
	// quotes a place at all.
	function fieldNameAt(layout StructLayout, index FieldIndex) returns immutable ByteArray
		return try layout.fieldNames.get(index) otherwise panic("fieldNameAt: fieldNames.get OOB at {index}")
	end 'fieldNameAt'

	function fieldSiteName(layout StructLayout, index FieldIndex) returns String
		return "{String.from(layout.name)}.{String.from(self.fieldNameAt(layout, index: index))}"
	end 'fieldSiteName'

	// ⭐⭐ **A CLASSIFIED MANAGED SLOT'S THREE-PART IDENTITY CHECK, IN ONE PLACE — the value type, the String
	// flag and the check itself.** A struct FIELD (`requireFieldType`) and a CONTAINER ELEMENT
	// (`requireContainerElementType`) ask the identical question of a `PayloadClass`: may this value fill this
	// slot? They differ only in the three things a diagnostic needs — the label, the voice and the anchor — so
	// those are threaded and the derivation is not.
	//
	// ⛔ **ONE PLACE, BECAUSE TWO COPIES DRIFT: A CORRECTION FROM `payloadStorageOf` TO `payloadValueTypeOf` HAS TO LAND
	// IN BOTH AT ONCE.** That is the failure mode this door removes —
	// two independently-correct-looking lines that must agree about which of the two answers
	// `SignatureIndex`'s width-vs-identity split gives, where getting it wrong is a nonsense tag mismatch on a
	// slot the language admits (`struct-managed-field.md`) rather than a compile error.
	//
	// ⚠ **`requirePayloadArgType`'s ARMS ARE DELIBERATELY NOT ROUTED THROUGH HERE.** It is itself a `match`
	// over `PayloadClass`, so each arm reads the case's OWN fields — which is what lets the `nestedUnion` arm
	// state `isString: false` as a fact about union boxes rather than deriving it — and folding it in would
	// trade a legible exhaustive match for a call that re-derives what the arm already destructured.
	function requireManagedSlotValueMatches(class PayloadClass, declared MaxonType, value ValueId, placeDoor FunctionTypeDoor, placeName ByteArray, placeOwner SlotOwner, placeBrand ByteArray, placeSpelling ByteArray, voice SlotMismatchVoice, anchor Token) throws SourceParseError
		// `payloadValueTypeOf`, NEVER `payloadStorageOf`: the question is what a value filling the slot must
		// BE, and for a boxed-union slot those two part company because the payload slot's WIDTH is the machine
		// word a box is. Asked of the width, a `Ty` box meets `integer`; asked of the identity, it meets `Ty` —
		// and the identity is also what `containerSlotValueType` types the value a read hands BACK, so a slot
		// admits exactly what it can return. `SignatureIndex.payloadStorageOf` is the one home of that split.
		try self.requireManagedValueMatches(payloadValueTypeOf(class, declared: declared), isString: payloadClassIsString(class), value: value, placeDoor: placeDoor, placeName: placeName, placeOwner: placeOwner, placeBrand: placeBrand, placeSpelling: placeSpelling, voice: voice, anchor: anchor)
	end 'requireManagedSlotValueMatches'

	// A deferred value — a call no file declares, or a value derived from one — is refused once, by the
	// E3004 `SemanticCheck.checkCalls` reports at the call, so a type rule that meets it reports nothing: a
	// throw would end the file's parse before that E3004 is found.
	// `mintCallResult` owns the rule.
	function refuseUnlessDeferred(error SourceParseError, value ValueId) throws SourceParseError
		if not self.valueIsDeferred(value) 'notADeferredCallResult'
			throw error
		end 'notADeferredCallResult'
	end 'refuseUnlessDeferred'

	// The operand twin of `refuseUnlessDeferred`: a construct applied to a deferred operand reports nothing
	// and yields a deferred value.
	function deferredResultOrRefusal(error SourceParseError, value ValueId) returns ValueId throws SourceParseError
		if not self.valueIsDeferred(value) 'aKnownOperand'
			throw error
		end 'aKnownOperand'

		return self.mintDeferredValue()
	end 'deferredResultOrRefusal'

	// Once an entry is deferred the literal's type is unknowable, so nothing more is built:
	// the remaining entries are parsed for their own diagnostics and the whole literal answers a
	// deferred value.
	function deferredLiteralRest(func IrFunction, entry LiteralEntryShape) returns ValueId throws SourceParseError
		while try self.atAnotherLiteralEntry() 'moreEntries'
			_ = try self.parseExpression(func, block: self.bodyState.currentBlock)

			match entry 'entry'
				element or
				tupleElement then break
				pair then try self.skipDeferredPairValue(func)
			end 'entry'
		end 'moreEntries'

		try self.consume(literalEntryCloser(entry))

		return self.mintDeferredValue()
	end 'deferredLiteralRest'

	function skipDeferredPairValue(func IrFunction) throws SourceParseError
		try self.consume(TokenKind.colon)
		_ = try self.parseExpression(func, block: self.bodyState.currentBlock)
	end 'skipDeferredPairValue'

	function deferredMapLiteralFromKey(func IrFunction) returns ValueId throws SourceParseError
		try self.skipDeferredPairValue(func)

		return try self.deferredLiteralRest(func, entry: LiteralEntryShape.pair)
	end 'deferredMapLiteralFromKey'

	function atAnotherLiteralEntry() returns bool throws SourceParseError
		if not self.at(TokenKind.comma) 'theLastEntry'
			return false
		end 'theLastEntry'

		try self.consume(TokenKind.comma)
		return true
	end 'atAnotherLiteralEntry'

	// ⭐ **A MANAGED VALUE MUST BE THE MATCHING HEAP KIND** — the ONE check a struct FIELD and a union
	// PAYLOAD share: a `String` slot takes a `string`; a `struct` slot takes a `structRef` of the SAME struct
	// name (a pointer of the wrong struct would pass a tag-only check). The names are compared through this
	// file's interner, the one the classifier's `structRef` id and the value's own id were both minted from.
	// `assignedPlace` is the `<Type>.<field>` / `<Union>.<case>(<field>)` label the ASSIGNMENT voice quotes;
	// the argument voice names the mutator's parameter instead, which `slotMismatchError` decides.
	function requireManagedValueMatches(storage MaxonType, isString bool, value ValueId, placeDoor FunctionTypeDoor, placeName ByteArray, placeOwner SlotOwner, placeBrand ByteArray, placeSpelling ByteArray, voice SlotMismatchVoice, anchor Token) throws SourceParseError
		let got = self.tagOf(value)
		let wantTag = maxonTypeTag(storage)

		if got != wantTag 'tagMismatch'
			// ⚠ **`got` NAMES THE TYPE, NOT THE TAG'S CLASS WORD.** Reading `typeTagName(got)` instead
			// answers `got 'struct'` for the very struct the arm below answers `got 'Other'` for — one door,
			// two sentences, sixty lines apart in `specs/arrays.md`. The sentence is `expected 'String', got
			// 'Item'`.
			let mismatch = self.slotMismatchError(voice, placeDoor: placeDoor, placeName: placeName, placeOwner: placeOwner, placeBrand: placeBrand, placeSpelling: placeSpelling, got: self.valueDisplayTypeName(value), gotNote: "", resolvedExpected: self.declaredSlotDisplayName(wantTag, nameId: typeNameIdOf(storage), fallback: typeTagName(wantTag)), expectedNote: "", declared: wantTag, declaredNameId: typeNameIdOf(storage), line: anchor.line, column: anchor.column, crossesRange: false)

			try self.refuseUnlessDeferred(mismatch, value: value)
			return
		end 'tagMismatch'

		// The tag check above passes any two function shapes. Without this record a wrongly shaped
		// function is stored, and a later call through the slot runs it with the wrong arguments.
		if isFunctionTypeDoor(wantTag, got: got) 'functionIntoFunctionSlot'
			self.recordFunctionStoreDoor(typeNameIdOf(storage), value: value, door: placeDoor, placeName: placeName, placeOwner: placeOwner, anchor: anchor)
		end 'functionIntoFunctionSlot'

		if isString 'stringOk'
			return
		end 'stringOk'

		// The tag check above (`got != wantTag`) is EXACT, so a value reaching the identity question from
		// HERE shares its tag with the slot — and the only tag a struct/union storage and a value can share
		// while disagreeing on aggregate identity is the overloaded `named` (a boxed union slot met by a
		// ranged-int alias value, or the reverse). `namedAggregatesConflict` catches that
		// scalar-vs-aggregate case as well as two distinct aggregates.
		try self.requireSlotAggregateIdentity(storage, value: value, placeDoor: placeDoor, placeName: placeName, placeOwner: placeOwner, placeBrand: placeBrand, placeSpelling: placeSpelling, voice: voice, anchor: anchor)
	end 'requireManagedValueMatches'

	// ⭐⭐ **THE AGGREGATE-IDENTITY HALF OF A SLOT STORE, ASKED BY THE MANAGED FIELD DOOR AND BY THE SCALAR
	// ONE — because a `named` ENUM FIELD IS SCALAR, SO THE COERCION SITE MUST ASK TOO.**
	// `aggregatesConflict`'s header names the parser's five symmetric doors, and the fifth is the
	// "union-payload / struct-literal store" — which reaches only the MANAGED path. A payload-free enum's
	// value is its i64 tag, so an enum-typed field is not managed and falls through `requireFieldType`'s
	// scalar arm, where `assignableValue`'s verdict is `checkDeclaredType(named, named)` — and that AGREES
	// for any two enums.
	//
	// On `type Holder` with `export var c as Color`, `h.c = Shade.light` and `Self{c: Shade.light}`
	// must both be refused (`error E3005 … to field 'c' of 'Holder', which holds 'Color'`); unchecked,
	// both COMPILE and store. The stored tag then reads back under the other enum's name —
	// `specs/assignment.md`'s own `error.retype-enum-field-errors` and
	// `error.wrong-enum-in-struct-literal-field-errors` are the pair that names it, and it is the
	// identical defect `parseAssignment`'s door was given this check for one slot up.
	//
	// It is EXTRACTED rather than copied for the reason `requireFieldType`'s own header gives about the four
	// `DeclaredTypeMatch` arms that once stood there: a rule with two homes drifts, and this one already had
	// two readers before it had a name.
	//
	// ⚠ **THE TWO NAMES DECIDE THE VERDICT AND DO NOT SPELL IT** — `parseAssignment`'s aggregate-retype
	// check carries the identical note for the identical reason (user ruling, 2026-08-04): an aggregate
	// name is the IDENTITY two values are compared on, and a generic instance's identity is a canonical
	// mint no source line holds. Both sides render through `displayTypeNameOf` so this door and the
	// ARGUMENT door spell one type one way — and where the DECLARED side is the scalar half of the
	// mismatch, that renderer prints its primitive rather than the empty name the verdict was decided on.
	//
	// ⚠ It reads the PARSED value at both call sites and never a coerced one, exactly as
	// `parseAssignment`'s check does: a widening only ever produces a float scalar, whose aggregate name is
	// empty either way, so the question is the same one before and after the coercion.
	function requireSlotAggregateIdentity(storage MaxonType, value ValueId, placeDoor FunctionTypeDoor, placeName ByteArray, placeOwner SlotOwner, placeBrand ByteArray, placeSpelling ByteArray, voice SlotMismatchVoice, anchor Token) throws SourceParseError
		let got = self.tagOf(value)
		let wantTag = maxonTypeTag(storage)

		// ⛔⛔ **AN OPAQUE `T` SLOT IS NOT EXEMPT FROM THIS QUESTION, AND EXEMPTING IT WAS A WILD WRITE.**
		// This door briefly opened `if wantTag == typeParameter then return`, because the unsubstituted
		// `T` answers an EMPTY aggregate name and so conflicted with the very `Label` a `Box with Label`
		// exists to accept. The argument written beside it — *"the concrete identity is pinned at the
		// CALL SITE by `SemanticCheck.checkTypeParameterArgsAt`"* — is FALSE, and falsifiable in one
		// line: **a field WRITE has no call site**. `checkTypeParameterArgsAt` is reached only from
		// `checkTypeParameterArgs` on a CALL's arguments, so `b.value = Other.create(99)` is pinned by
		// nothing. Exempted, it compiles and exits **0xC0000005**.
		//
		// ⇒ the cure is to SUBSTITUTE rather than to skip: `storedFieldType` binds `T` from the box before the
		// check is asked, so a concrete instance arrives here already spelling `Label` and the two legal
		// `generic-types` cases pass on the identity they actually have. What still reaches this line opaque is
		// the SHARED BODY, where `self.value = v` meets a `T`-typed value — and there BOTH names are empty, so
		// `namedAggregatesConflict` defers to the caller's tag check with no special case needed. A CONCRETE
		// value in that body (`self.value = Label.create(77)` inside `Box uses T`) is a genuine mismatch the
		// shared body cannot justify for every instantiation, and it is refused here: unguarded it had compiled
		// and exited **101, a leak**, printing a box pointer as an integer.
		let wantName = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: wantTag, nameId: typeNameIdOf(storage), readerFilePath: self.job.path)
		let gotName = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: got, nameId: self.valueNameId(value), readerFilePath: self.job.path)

		if not placeBrand.isEmpty() and got == ValueTypeTag.genericInstance 'aBrandedPlaceMayMeetAnUnadoptedRead'
			self.recordUnadoptedBrandDoor(value, expected: placeBrand, door: placeDoor, placeName: placeName, owner: placeOwner, anchor: anchor)
		end 'aBrandedPlaceMayMeetAnUnadoptedRead'

		if self.signatures.aggregatesConflict(wantName, expectedTag: wantTag, expectedNameId: typeNameIdOf(storage), expectedBrand: placeBrand, got: gotName, gotTag: got, gotNameId: self.valueNameId(value), gotBrand: self.brandOf(value), readerFilePath: self.job.path) 'nameMismatch'
			let wantShown = self.brandedDisplayTypeName(wantTag, nameId: typeNameIdOf(storage), brand: placeBrand)
			let paired = self.pairedDisplays(value, declaredTag: wantTag, declaredNameId: typeNameIdOf(storage), declaredBrand: placeBrand, declaredIdentity: wantName, declaredShown: wantShown)
			throw self.slotMismatchError(voice, placeDoor: placeDoor, placeName: placeName, placeOwner: placeOwner, placeBrand: placeBrand, placeSpelling: placeSpelling, got: paired.got, gotNote: paired.gotNote, resolvedExpected: paired.declared, expectedNote: paired.declaredNote, declared: wantTag, declaredNameId: typeNameIdOf(storage), line: anchor.line, column: anchor.column, crossesRange: self.signatures.crossesIntegerRange(wantTag, expected: wantName, gotTag: got, got: gotName))
		end 'nameMismatch'
	end 'requireSlotAggregateIdentity'

	// ⭐ **FILL EVERY OMITTED SLOT THAT DECLARES A DEFAULT** — `export var value = 0` + `Self{}`.
	//
	// **A LITERAL-PROVIDED VALUE ALWAYS BEATS THE DEFAULT**, and `filled` is what says so: this only
	// ever looks at slots the literal did not write, so an override is not a race between two stores
	// — the default's `literal` op is never emitted at all. That is the rule
	// `field-initialization.md` states ("A literal-provided value always overrides a declared
	// default") and `literal-overrides-default` pins.
	//
	// The literal is minted at the field's STORAGE type, not its declared one: `emitLiteral` uses
	// one `MaxonType` for both the value's tag and the op's, and `maxonTypeToStdType` PANICS on a
	// `named` — so a field declared `as Integer = 7` would otherwise carry an alias into an op that
	// must be concrete by lowering. Nothing reads this value's tag (it flows straight into the
	// store), and `emitFieldStore` independently derives the same storage type for the slot, so the
	// two agree by construction.
	//
	// The span is the LITERAL's anchor — the `Self` token — and not the field declaration's, which
	// may be in another file entirely: a `SourceRange` is an offset into THIS file's bytes.
	function applyFieldDefaults(layout StructLayout, fieldValues ValueIdArray, filled FixedBoolArray, anchor Token) throws SourceParseError
		let range = SourceRange.ofToken(anchor)

		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("applyFieldDefaults: filled.get OOB at {i} — the column is sized to the layout's field count")

			if wasFilled 'literalWins'
				continue
			end 'literalWins'

			match fieldDefaultFill(layout, index: i) 'declared'
				// The literal did not fill this slot and the declaration offers nothing. That is
				// E3086, and `requireAllFieldsInitialized` is what says so — not this function.
				none then continue
				literal(given) then self.fillFieldDefault(layout, index: i, given: given, fieldValues: fieldValues, filled: filled, range: range)

				// A bare `<Type>.create()` default is CALLED here exactly as any other expression default is:
				// the fold that describes it instead belongs to a top-level `let`, which builds no box at all.
				callsHelper(helperName) then try self.fillFieldDefaultFromHelper(helperName, index: i, fieldValues: fieldValues, filled: filled, anchor: anchor)
			end 'declared'
		end 'eachField'
	end 'applyFieldDefaults'

	// ⭐⭐ **EMIT THE CALL THAT PRODUCES ONE FIELD'S ARBITRARY DEFAULT** — an ORDINARY `MaxonOp.call`
	// to the nullary helper the declaration synthesized, exactly as an omitted ARGUMENT emits one
	// (`fillArgsFromParamDefaults`), and by the same door for the same reasons: `emitCall` is what OWNS the
	// result (`mintCallResult` → `mintOwnedCallResult` → `trackOwnedTemp`), so a managed default arrives
	// enrolled as this statement's owned temporary and is then CONSUMED into the box by the store loop.
	//
	// ⛔ **IT MUST NOT BE `emitRuntimeCall`.** That door mints its result type by hand and enrols nothing,
	// so the box would end up holding a value nobody owns — a leak or a double free, decided by whatever
	// the field's type turns out to be.
	//
	// ⭐ **EACH CONSTRUCTION GETS ITS OWN VALUE**, which is `field-defaults.fresh-per-construction`'s whole
	// point, and it is a property of emitting a CALL rather than a rule stated anywhere: two `Bag.create()`
	// calls parse two `Self{}` literals, emit two calls, and the helper allocates on each.
	//
	// ⚠ **THE ANCHOR IS THE `Self` TOKEN AND NOT THE FIELD'S DECLARATION**, for `applyFieldDefaults`'
	// stated reason: a `SourceRange` is an offset into THIS file's bytes, and it also serves as the call's
	// `rparenTok` because the call has no parentheses in the source at all — nobody wrote it.
	function fillFieldDefaultFromHelper(helperName ByteArray, index FieldIndex, fieldValues ValueIdArray, filled FixedBoolArray, anchor Token) throws SourceParseError
		let value = try self.emitCall(helperName, anchor: anchor, args: ValueIdArray.create(0), argLabels: NameRoster.create(0), argRanges: SourceRangeArray.create(0), argImmutableNames: NameRoster.create(0), rparenTok: anchor, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: CalleeMint.fieldDefaultHelper)
		self.recordFieldDefaultValue(index, value: value, fieldValues: fieldValues, filled: filled)
	end 'fillFieldDefaultFromHelper'

	// Record `value` as slot `index`'s value and mark the slot filled — the last two lines of BOTH ways a
	// declared default becomes one (a folded literal, a call to the synthesized helper), so the two columns
	// are written from one place and the out-of-bounds sentence is stated once.
	function recordFieldDefaultValue(index FieldIndex, value ValueId, fieldValues ValueIdArray, filled FixedBoolArray)
		try fieldValues.set(index, value: value) otherwise panic("recordFieldDefaultValue: fieldValues.set OOB at {index} — the column is sized to the layout's field count")
		try filled.set(index, value: true) otherwise panic("recordFieldDefaultValue: filled.set OOB at {index} — the column is sized to the layout's field count")
	end 'recordFieldDefaultValue'

	// A `ConstValue`'s payload as f64 BITS — the CONSTANT half of the `TypeRules.widensIntToFloat`
	// obligation (its SSA half is `promoteToFloat`). A float carries its bits already; an INT is
	// promoted to its f64 value first, so a float-alias field defaulted `3 as Ratio` fills its slot with
	// 3.0 rather than with eight bytes of two's complement.
	//
	// ⚠ **THE CONVERSION ITSELF IS `TypeRules.foldSiToFp`'s** (`foldUiToFp`'s for a value above
	// `i64.max`), not this function's — `IR/Std/FoldConstants` folds the SSA conversion the inliner
	// makes constant, and the two must not compute int→f64 separately. What is this function's own is
	// the TAG question: which side of the conversion the caller is holding.
	function constFloatBits(value ConstValue) returns FullRangeInt
		if tagIsFloat(value.tag) 'alreadyFloat'
			return value.payload
		end 'alreadyFloat'

		if value.aboveSignedMax 'anUnsignedLiteral'
			return foldUiToFp(value.payload)
		end 'anUnsignedLiteral'

		return foldSiToFp(value.payload)
	end 'constFloatBits'

	// Emit one default's `literal` and record it as slot `index`'s value. Split out so the payload
	// is bound by the match arm that proved there IS one, rather than read back out of the union
	// through an accessor with a `none` case to mishandle.
	//
	// ⭐ **THE ONE PLACE A FIELD DEFAULT IS COERCED**, and the only place it can be: `readStructFieldInto`
	// records the literal exactly as the source wrote it, because the declaration sweep it shares cannot
	// resolve a ranged-alias field type. Here the whole program IS known — `fieldTypeOf` answers `float`
	// for a `float(low to high)` alias — so a `= 3` against it widens to the f64 bit pattern. Left unpaid
	// it wrote the integer's raw bytes into an f64 slot and read back 1.5e-323.
	//
	// ⚠ **TWO QUESTIONS, AND EACH IS ASKED EXACTLY ONCE.** The RESOLVED type says whether the slot is an
	// f64 at all; the RECORDED TAG — inside `constFloatBits`, the shared primitive — says whether putting
	// `given` in it is a conversion or a no-op. That second read is the whole reason the tag is stored:
	// `= 3` and `= 3.0` are two `FullRangeInt`s and nothing else once the tag is gone, so no rule anywhere
	// else in the compiler could tell them apart, and none is consulted.
	//
	// ⚠ It does NOT re-ask `widensIntToFloat` on the way in, and that is deliberate rather than an
	// oversight: `constFloatBits` already turns away a float, so a guard naming the literal's tag as well
	// would be a second, REDUNDANT read that merely LOOKS load-bearing — measured, replacing it with a
	// constant changed no test. A condition that cannot fail is worse than no condition, because the next
	// reader trusts it.
	function fillFieldDefault(layout StructLayout, index FieldIndex, given ConstValue, fieldValues ValueIdArray, filled FixedBoolArray, range SourceRange)
		let declared = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)
		let bits = self.constFloatBits(given) if tagIsFloat(maxonTypeTag(declared)) else given.payload
		let value = self.emitLiteral(bits, valueType: self.fieldStorageType(declared), range: range)

		// The default's written marks (`writtenNegative`, `aboveSignedMax`), re-stamped onto the value
		// this line mints. Both are keyed by ValueId, and this id did not exist when the declaration
		// was read — possibly in another file — so they travel in `FieldDefault.literal`'s ConstValue.
		// Without them `export var v = -1 as Idx` would fill an unsigned slot with the wrapped bits
		// while `Self{v: -1}` is E3005. A float default's payload is an IEEE-754 pattern, so the marks
		// are taken from the declaration rather than re-derived from `bits`.
		if given.writtenNegative 'declaredNegative'
			self.markWrittenNegative(value, value: bits)
		end 'declaredNegative'

		if given.aboveSignedMax and not tagIsFloat(maxonTypeTag(declared)) 'declaredAboveSignedMax'
			self.markAboveSignedMax(value)
		end 'declaredAboveSignedMax'

		// A declared default is a value coming to rest in the slot exactly as a written one is, so the
		// field's range binds it — `export var v = 500 as Percent` is the same E3005 `Self{v: 500}` gets.
		// It is always a LITERAL, so `InsertRangeChecks` settles it entirely at compile time and the
		// runtime half it is nominally owed is never emitted; it is recorded exactly as the WRITTEN field
		// store is (`requireFieldType`), so the two doors say one thing rather than two.
		//
		// ⭐⭐ **AND THAT SENTENCE IS WHY A LITERAL DEFAULT KEEPS ITS OWN ARM.** Everything else a
		// field can default to is a synthesized nullary helper, which is one mechanism where the
		// parameter twin has one too (`SignatureIndex.ParamDefaultInfo` argues at length that a constant
		// fast path is not worth having, and for a PARAMETER it is right). A field's literal is the case
		// that argument does not cover: it is the arm that makes the range check DISAPPEAR. A call result
		// cannot be constant-folded, so routing `= 500` through a helper would emit — in 158 spec files —
		// a runtime range check that costs nothing today. The fast path is not redundant; it is the only
		// path on which `InsertRangeChecks` can see a constant.
		//
		// ⚠ **THE CONTAINMENT ELISION CANNOT FIRE HERE**: `emitLiteral` mints the value two lines up, and a
		// freshly minted literal denotes no ranged alias — so the compile-time half this door exists for is
		// untouched.
		self.recordRangeCheckSite(value, destination: declared, line: range.line, column: range.column)

		self.recordFieldDefaultValue(index, value: value, fieldValues: fieldValues, filled: filled)
	end 'fillFieldDefault'

	// Every declared field must have been given a value — see `parseStructLiteral` for why the
	// allocator's zeroing guarantee makes an omission a WRONG ANSWER rather than a safe default,
	// and `applyFieldDefaults` for the other way a slot comes to have one.
	// Reports the FIRST omitted field, in declaration order, so the message is a function of the
	// type rather than of a hash walk.
	function requireAllFieldsInitialized(layout StructLayout, filled FixedBoolArray, anchor Token) throws SourceParseError
		let unfilled = NameRoster.create(0)

		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("requireAllFieldsInitialized: filled.get OOB at {i} — the column is sized to the layout's field count")

			if wasFilled 'given'
				continue
			end 'given'

			unfilled.push(try layout.fieldNames.get(i) otherwise panic("requireAllFieldsInitialized: fieldNames.get OOB at {i}"))
		end 'eachField'

		if unfilled.count() == 0 'everySlotHasAValue'
			return
		end 'everySlotHasAValue'

		// ⭐ **EVERY UNFILLED FIELD IN ONE SENTENCE, not the first one.** They are one edit for the author —
		// a literal that omits two slots is fixed by writing both — and reporting the first would make the
		// second a surprise on the next compile.
		throw SourceParseError.fieldsNotInitialized(String.from(layout.name), fields: nameList(unfilled, quote: DiagnosticNameQuote), plural: unfilled.count() > 1, line: anchor.line, column: anchor.column)
	end 'requireAllFieldsInitialized'

	// ⭐⭐ **THE PROOF A DEFERRED FIELD OWES: it is assigned on EVERY path reaching the literal that takes
	// it** (`/specs/field-initialization.md`, rule 3). A forward dataflow over the blocks the body actually
	// built, meeting at joins by INTERSECTION — which is what makes a single-branch write and a loop-only
	// write not count, while a write in both arms of an `if` does.
	//
	// ⭐ **IT READS THE PARSE'S OWN CFG AND MODELS NOTHING.** The GEN sets were recorded as the writes
	// happened (`NascentSelfWrite`) and the successors come off each block's terminator, so a construct that
	// branches in a way this pass has never heard of is still analysed correctly — the alternative, a second
	// token-level model of control flow, is a model that can disagree with the one the program compiled to.
	//
	// ⚠ **IT IS QUADRATIC IN THIS FUNCTION'S BLOCK COUNT, DELIBERATELY.** Predecessors are found by scanning
	// for them rather than indexed, because the pass runs only for a factory that defers a field — no other
	// body in any program reaches it — and a CSR graph built per such function would cost more than it saves.
	function validateNascentSelfAssignments(func IrFunction) throws SourceParseError
		if self.bodyState.nascentSelfChecks.count() == 0 'nothingDeferred'
			return
		end 'nothingDeferred'

		let fields = self.nascentSelfFieldRoster()
		let blockCount = func.blockRefs.count()
		let width = fields.count()

		// `entryIn` starts EMPTY at the entry block and FULL everywhere else, which is the initial condition an
		// intersection dataflow needs: a block whose predecessors have not been visited must not yet constrain
		// anything, and the entry block has none to be constrained by.
		let entryIn = BoolArray.create(blockCount * width, zeroed: false)
		let exitOut = BoolArray.create(blockCount * width, zeroed: false)

		for b in 0 upto blockCount 'seedBlocks'
			for f in 0 upto width 'seedFields'
				entryIn.push(b > 0)
				exitOut.push(b > 0 or self.nascentWriteReaches(func, blockOrdinal: b, field: try fields.get(f) otherwise panic("validateNascentSelfAssignments: fields.get OOB at {f}"), position: NascentWholeBlock))
			end 'seedFields'
		end 'seedBlocks'

		var changed = true

		while changed 'fixpoint'
			changed = false

			for b in 1 upto blockCount 'eachBlock'
				for f in 0 upto width 'eachField'
					let field = try fields.get(f) otherwise panic("validateNascentSelfAssignments: fields.get OOB at {f}")
					let reaching = self.nascentReachesEveryPredecessor(func, blockOrdinal: b, field: f, width: width, exitOut: exitOut)
					let slot = b * width + f

					if (try entryIn.get(slot) otherwise panic("validateNascentSelfAssignments: entryIn.get OOB at {slot}")) == reaching 'settled'
						continue
					end 'settled'

					try entryIn.set(slot, value: reaching) otherwise panic("validateNascentSelfAssignments: entryIn.set OOB at {slot}")
					try exitOut.set(slot, value: reaching or self.nascentWriteReaches(func, blockOrdinal: b, field: field, position: NascentWholeBlock)) otherwise panic("validateNascentSelfAssignments: exitOut.set OOB at {slot}")
					changed = true
				end 'eachField'
			end 'eachBlock'
		end 'fixpoint'

		for check in self.bodyState.nascentSelfChecks 'eachSite'
			try self.reportNascentSelfCheck(func, check: check, fields: fields, width: width, entryIn: entryIn)
		end 'eachSite'
	end 'validateNascentSelfAssignments'

	// Does `field` reach the ENTRY of block `b` on every predecessor edge? A block with no predecessor at all
	// is unreachable code, and an unreachable literal owes no proof — so it answers `true` rather than
	// constraining anything.
	function nascentReachesEveryPredecessor(func IrFunction, blockOrdinal ElementIndex, field ElementIndex, width ElementIndex, exitOut BoolArray) returns bool
		let target = self.nascentBlockIdAt(func, ordinal: blockOrdinal)
		var sawOne = false
		var everyOne = true

		for p in 0 upto func.blockRefs.count() 'eachPossiblePredecessor'
			if not self.nascentBranchesTo(func, fromOrdinal: p, target: target) 'notAPredecessor'
				continue
			end 'notAPredecessor'

			sawOne = true

			if not (try exitOut.get(p * width + field) otherwise panic("nascentReachesEveryPredecessor: exitOut.get OOB")) 'missesOnThisEdge'
				everyOne = false
			end 'missesOnThisEdge'
		end 'eachPossiblePredecessor'

		return everyOne if sawOne else true
	end 'nascentReachesEveryPredecessor'

	// Does the block at `fromOrdinal` transfer to `target`? Read off its TERMINATOR and its conditional-branch
	// body op, plus the fall-through edge to the next block in layout order — the three ways a block in this
	// tier names a successor.
	function nascentBranchesTo(func IrFunction, fromOrdinal ElementIndex, target BlockId) returns bool
		let block = self.artifact.module.blockAtPosition(func, position: fromOrdinal)

		if block.hasTerminatorOp() and nascentOpBranchesTo(try self.artifact.module.ops.get(block.terminatorIndex()) otherwise panic("nascentBranchesTo: terminator op not in module.ops"), target: target) 'viaTerminator'
			return true
		end 'viaTerminator'

		if block.hasCondBranchOp() and nascentOpBranchesTo(try self.artifact.module.ops.get(block.condBranchIndex()) otherwise panic("nascentBranchesTo: condBranch op not in module.ops"), target: target) 'viaCondBranch'
			return true
		end 'viaCondBranch'

		if not blockFallsThrough(block.terminator) 'noFallThroughEdge'
			return false
		end 'noFallThroughEdge'

		let next = fromOrdinal + 1
		return next < func.blockRefs.count() and self.nascentBlockIdAt(func, ordinal: next) == target
	end 'nascentBranchesTo'

	function nascentBlockIdAt(func IrFunction, ordinal ElementIndex) returns BlockId
		return self.artifact.module.blockAtPosition(func, position: ordinal).id
	end 'nascentBlockIdAt'

	// Was `field` written in block `blockOrdinal` at or before `position`? `NascentWholeBlock` asks about the
	// block entire, which is the GEN set the dataflow needs; a real position asks about the prefix a literal
	// sits at the end of.
	function nascentWriteReaches(func IrFunction, blockOrdinal ElementIndex, field ByteArray, position ElementIndex) returns bool
		let id = self.nascentBlockIdAt(func, ordinal: blockOrdinal)

		for write in self.bodyState.nascentSelfWrites 'eachWrite'
			if write.block == id and write.field.equals(field) and (position == NascentWholeBlock or write.position <= position) 'thisOne'
				return true
			end 'thisOne'
		end 'eachWrite'

		return false
	end 'nascentWriteReaches'

	// Every field this body deferred, once each — the dataflow's column set.
	function nascentSelfFieldRoster() returns NameRoster
		let roster = NameRoster.create(0)

		for write in self.bodyState.nascentSelfWrites 'eachWrite'
			if not roster.contains(write.field) 'newField'
				roster.push(write.field)
			end 'newField'
		end 'eachWrite'

		return roster
	end 'nascentSelfFieldRoster'

	// One literal's verdict: every field it took must reach it — through the block's entry, or through a
	// write earlier in the block itself.
	function reportNascentSelfCheck(func IrFunction, check NascentSelfCheck, fields NameRoster, width ElementIndex, entryIn BoolArray) throws SourceParseError
		let missing = NameRoster.create(0)

		for taken in check.fields 'eachTakenField'
			if self.nascentFieldReachesCheck(func, check: check, field: taken, fields: fields, width: width, entryIn: entryIn) 'assigned'
				continue
			end 'assigned'

			missing.push(taken)
		end 'eachTakenField'

		if missing.count() == 0 'everyFieldProven'
			return
		end 'everyFieldProven'

		throw SourceParseError.fieldsNotDefinitelyAssigned(String.from(check.typeName), fields: nameList(missing, quote: DiagnosticNameQuote), firstField: String.from(try missing.get(0) otherwise panic("reportNascentSelfCheck: missing.get(0) on a non-empty list")), plural: missing.count() > 1, line: check.line, column: check.column)
	end 'reportNascentSelfCheck'

	function nascentFieldReachesCheck(func IrFunction, check NascentSelfCheck, field ByteArray, fields NameRoster, width ElementIndex, entryIn BoolArray) returns bool
		for b in 0 upto func.blockRefs.count() 'eachBlock'
			if self.nascentBlockIdAt(func, ordinal: b) != check.block 'notTheSiteBlock'
				continue
			end 'notTheSiteBlock'

			if self.nascentWriteReaches(func, blockOrdinal: b, field: field, position: check.position) 'writtenAbove'
				return true
			end 'writtenAbove'

			for f in 0 upto width 'eachColumn'
				if (try fields.get(f) otherwise panic("nascentFieldReachesCheck: fields.get OOB at {f}")).equals(field) 'thisColumn'
					return try entryIn.get(b * width + f) otherwise panic("nascentFieldReachesCheck: entryIn.get OOB")
				end 'thisColumn'
			end 'eachColumn'
		end 'eachBlock'

		panic("nascentFieldReachesCheck: the literal's block is not in this function's own block list, or field '{String.from(field)}' is absent from a roster built out of the very writes that produced it")
	end 'nascentFieldReachesCheck'

	// Emit the box: allocate, then fill every slot. `fieldValues` is parallel to the LAYOUT, and `layout` is
	// the index's own (`ProgramSignatures.fieldTypeOf`'s precondition) — what `requireConstructible` and
	// `internTupleLayout` both hand back.
	//
	// The result is typed `structRef(layout.name)` — which is what makes `let p = Point.create(…)`
	// bind a Point rather than an integer, since the factory returns this value and
	// `parseTypeReference` typed its `returns Self` the same way. The two meet at
	// `parseReturnStatement`'s `checkDeclaredType`, and they agree because both came from the
	// enclosing type's name.
	//
	// ⭐ **THE BOX IS ENROLLED AS AN OWNED HEAP TEMPORARY** (`trackOwnedTemp`), exactly as a boxed union
	// construct and an interpolation String are: it sets the provenance bit `valueIsOwnedHeap` reads, so a
	// binding of it drops at scope exit and an UNBOUND `Self{…}` (a struct literal passed as a borrowed
	// call argument) is freed at statement end. A `return Self{…}` moves it back OUT of the pending list
	// (`parseReturnStatement`), so the factory does not drop what it hands to its caller. It is the bit —
	// not the `structRef` tag — that owns the drop, because a borrowed struct PARAMETER also carries the
	// tag and owns nothing.
	// ⭐ **A MANAGED FIELD IS MOVED IN** (`moveInPayload`) — the struct half of static single-owner
	// ownership, the exact mirror of `emitEnumBox`'s payload move. A scalar field is stored as-is; a managed
	// field (a `String` or a nested `struct`) stores its value into the box: a borrowed String literal is
	// promoted to an owned copy, an owned TEMPORARY is adopted out of the pending drops, an owned value a LIVE
	// BINDING keeps is CO-OWNED (the binding stays readable and releases its own reference at scope exit — the
	// 2026-08-12 ruling), and a borrowed struct is CO-OWNED as well (`moveInPayload` — the cross-call consume,
	// the transitive-consume ruling of 2026-08-04). Whichever arm runs, the
	// box holds exactly ONE reference per field and its `__destruct_<Struct>` cascade releases exactly that.
	function emitStructLiteral(layout StructLayout, fieldValues ValueIdArray, fieldBareLocal BoolArray, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		// ⭐⭐ **A FUSED WRAPPER'S LITERAL IS NOT A STRUCT LITERAL, AND THE LOOP BELOW WOULD CORRUPT IT.**
		// `type String`'s `managed` is embedded whole at offset 0 (`StructLayout.isInlineManagedField`), so
		// offset 0 is the RECORD'S OWN `buffer@0` — the ordinary field store would put a `__ManagedMemory`
		// POINTER there and every later read would take that pointer for a byte buffer. The wrapper's record
		// is built by its own producer instead.
		if layout.conformsToBuiltinManagedWrapper() 'fusedWrapper'
			return try self.emitFusedWrapperLiteral(layout, fieldValues: fieldValues, anchor: anchor, range: range)
		end 'fusedWrapper'

		if self.signatures.layoutPacksInlineIntoAWord(layout) 'inlinePacked'
			let word = self.emitInlinePackedLiteral(layout, fieldValues: fieldValues, range: range)
			self.noteConstructionImage(word, layout: layout, fields: fieldValues)

			return word
		end 'inlinePacked'

		let box = self.emitOwnedStructBox(layout, range: range)

		for i in 0 upto layout.fieldCount() 'eachField'
			let value = try fieldValues.get(i) otherwise panic("emitStructLiteral: fieldValues.get OOB at {i} — the column is sized to the layout's field count")
			let bareLocal = try fieldBareLocal.get(i) otherwise panic("emitStructLiteral: fieldBareLocal.get OOB at {i} — the column is sized to the layout's field count")
			let fieldType = self.signatures.fieldTypeOf(layout, index: i, into: self.artifact.typeNames)
			let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: fieldType, slotScopeFilePath: layout.declFilePath)
			let stored = try self.moveInPayload(class, arg: value, argBareLocal: bareLocal, owner: box, anchor: anchor, range: range)
			self.emitFieldStore(box, layout: layout, index: i, value: stored, range: range)
		end 'eachField'

		self.noteConstructionImage(box, layout: layout, fields: fieldValues)

		return box
	end 'emitStructLiteral'

	function notingImages() returns bool
		return self.job.initializerRole == InitializerRole.recordProbe
	end 'notingImages'

	function noteConstructionImage(box ValueId, layout StructLayout, fields ValueIdArray)
		if self.notingImages() 'theProbeReadsNotes'
			self.imageNotes.upsert(box, value: ImageNote.construction(layout.clone(), fields: fields.clone()))
		end 'theProbeReadsNotes'
	end 'noteConstructionImage'

	function noteCallImage(result ValueId, callee ByteArray, args ValueIdArray, labels NameRoster)
		if self.notingImages() 'theProbeReadsNotes'
			self.imageNotes.upsert(result, value: ImageNote.call(callee, args: args.clone(), labels: labels.clone()))
		end 'theProbeReadsNotes'
	end 'noteCallImage'

	function noteUnionCaseImage(box ValueId, typeName ByteArray, caseName ByteArray)
		if self.notingImages() 'theProbeReadsNotes'
			self.imageNotes.upsert(box, value: ImageNote.unionCase(typeName, caseName: caseName))
		end 'theProbeReadsNotes'
	end 'noteUnionCaseImage'

	function noteEmptyContainerImage(container ValueId)
		if self.notingImages() 'theProbeReadsNotes'
			self.imageNotes.upsert(container, value: ImageNote.emptyContainer)
		end 'theProbeReadsNotes'
	end 'noteEmptyContainerImage'

	function noteInlineWordImage(word ValueId, payload FullRangeInt, typeName ByteArray)
		if self.notingImages() 'theProbeReadsNotes'
			self.imageNotes.upsert(word, value: ImageNote.inlineWord(payload, typeName: typeName))
		end 'theProbeReadsNotes'
	end 'noteInlineWordImage'

	// The ONE writer of `recordsOwningOpaqueSlots` — `markOverwritableSlotRead`'s twin, through
	// the same install door discipline (`ValueMarkColumn`).
	function markRecordOwningOpaqueSlots(box ValueId)
		self.bodyState.recordsOwningOpaqueSlots = withValueMarked(self.bodyState.recordsOwningOpaqueSlots, value: box)
	end 'markRecordOwningOpaqueSlots'

	// The ONE writer of `recordsHoldingReferencedOpaqueSlots` — its twin above, through the same copy-on-write
	// home and for the identical reason.
	function markRecordHoldingReferencedOpaqueSlot(box ValueId)
		self.bodyState.recordsHoldingReferencedOpaqueSlots = withValueMarked(self.bodyState.recordsHoldingReferencedOpaqueSlots, value: box)
	end 'markRecordHoldingReferencedOpaqueSlot'

	// ⭐ **ALLOCATE THE HEAP RECORD A STRUCT-SHAPED LITERAL LIVES IN, AND ENROL IT AS THIS STATEMENT'S OWNED
	// TEMPORARY** — the three steps that MUST happen together (the size literal read off the layout, the
	// `__mm_alloc`, and `trackOwnedTemp`, which sets the provenance bit AND the statement's drop obligation
	// in one call). Shared by `emitStructLiteral` (a `Self{…}` and a tuple literal) and `copyTupleValue` (the
	// value-semantics copy), because a second copy of the sequence is how a change to what a record
	// costs — a header, an alignment, a different allocator door — reaches one producer and not the other,
	// and a box allocated without the enrolment simply leaks (exit 101).
	// ⭐⭐ **BUILD A FUSED WRAPPER'S RECORD — `String{managed: X, singleByteGraphemesFlag: F}` and
	// `Character{managed: X}` (THE ENVELOPE COLLAPSE).** The result IS the 56-byte byte record, so its
	// value tag is `string`/`character` and NOT `structRef`: that is the whole of what keeps
	// `String.from`'s return (`stdlib/String.maxon`) from an E3005 mismatch against `String`, and it is
	// not a cast — a corpus `String` and the compiler's builtin `String` are one type with one layout,
	// which is what convergence MEANS.
	//
	// ⚠ **THE FLAG IS OPTIONAL AND ITS ABSENCE IS `Character`'s CASE, NOT AN ERROR.** `type Character`
	// declares `managed` alone, so there is no flag value to pass and the bytes must be classified instead —
	// which is exactly `__str_from_bytes`. Two producers, chosen by whether the declaration HAS the field,
	// rather than one producer with a sentinel meaning "scan it yourself".
	//
	// ⭐⭐⭐ **`BuiltinArrayLiteral` NEEDS NO PRODUCER AT ALL, WHICH IS WHY IT IS AN ARM AND NOT A THIRD
	// `__str_*` ENTRY.** The two `String` producers exist because a `String` record is BUILT from its
	// buffer: `__str_from_bytes` classifies the bytes and writes its own answer at `@48`, `__str_of_buffer`
	// writes the flag it was handed there. An `Array` record has nothing of the sort to write —
	// `Array with T` and `__ManagedMemory with T` are ONE `GenericInstanceId`
	// (`SignatureIndex.canonicalGenericBaseName`), so `Array{managed: m}` is not a construction but an
	// IDENTITY on the record, and the only work left is the pair `parseArrayInitStatic` already does for the
	// same identity written as a static call: a FRESH `ValueId` (which is what flips the surface, since the
	// ARRAY surface is the ABSENCE of `markBufferSurface`) and a refcount that balances.
	//
	// ⚠ **AND THE REFUSAL BELOW STILL COVERS EVERY OTHER `BuiltinArrayLiteral` CONFORMER, BECAUSE THE HAZARD
	// IT NAMES IS REAL FOR THEM AND VACUOUS HERE.** That hazard is that construction DISCARDS every declared
	// field the fused record has no slot for. `stdlib/Array.maxon:101-106` declares exactly ONE field and it
	// IS the record, so there is nothing to discard — which is precisely what
	// `ProgramSignatures.firstFieldIsItsOwnBuffer` tests, structurally, rather than trusting the name alone.
	// A conformer that declares a second field meets the sentence, because for it the sentence is
	// true.
	//
	// ⚠⚠ **THE GATE IS THE FIELD, NOT THE NAME.** A gate on `isArrayBaseName(layout.name)` that then admitted on a sole
	// `managed` field would ask about the field's NAME and the declaration's MARKER, never about its TYPE. So
	// `type Array uses Element implements BuiltinArrayLiteral` with `var managed as Num` would take this arm and
	// `coOwnAggregateAsTemp` would hand the raw `Num` back AS the array. See `ProgramSignatures.declarationIsTheManagedRecord` for
	// the two measurements. Keyed on the field, such a declaration never reaches the identity at all.
	function emitFusedWrapperLiteral(layout StructLayout, fieldValues ValueIdArray, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		if self.signatures.firstFieldIsItsOwnBuffer(layout) 'theBufferRecord'
			try self.requireBufferIsItsOwnRecord(layout, anchor: anchor)
			let buffer = try fieldValues.get(0) otherwise panic("emitFusedWrapperLiteral: fieldValues.get OOB at 0 — `requireBufferIsItsOwnRecord` established a sole field and the column is sized to the layout's field count")
			try self.requireBufferElementIsTheDeclarationsOwn(layout, buffer: buffer, anchor: anchor)
			return self.coOwnAggregateAsTemp(buffer, range: range)
		end 'theBufferRecord'

		// ⭐⭐ **THE SIZED CONTAINER'S OWN RECORD IS THE SAME IDENTITY, RETYPED.** `stdlib/FixedArray.maxon`'s
		// `init(managed ElementMemory)` writes `return Self{managed: managed}`, and a `FixedArray`'s runtime
		// representation IS an `Array`'s — the same 48-byte fused record, dropped by the same
		// `__managed_decref` — so there is nothing to construct here either. What the array arm above cannot do
		// is hand the value back with the RIGHT identity: the buffer is an `Array with Element` and `Self` is a
		// `FixedArray`, whose gid carries the SIZE as a second coordinate. So the identity is taken and the value is
		// retyped to the declaration's own instance, exactly as `parseFixedArrayFromConstruction` retypes the array
		// literal it is handed.
		//
		// ⚠ **STDLIB SOURCE ONLY, AND THE GATE IS PROVENANCE RATHER THAN SHAPE.** A USER `type FixedArray uses
		// Element implements BuiltinArrayLiteral` is shaped identically and must go on meeting
		// `requireNameIsNotABuiltinContainerBase` below — admitting it lets a fixed-size
		// three-element fixed array grow to nine through `push`/`resize`, compiling clean and printing the wrong
		// answer. The corpus declaration is not a second conformer competing with the compiler's container; it
		// is the DECLARATION OF that container, which is what listing the module means.
		if self.job.isStdlibSource and self.signatures.declarationIsASizedContainerRecord(layout) 'theSizedContainersOwnRecord'
			try self.requireBufferIsItsOwnRecord(layout, anchor: anchor)
			let sizedBuffer = try fieldValues.get(0) otherwise panic("emitFusedWrapperLiteral: fieldValues.get OOB at 0 — `requireBufferIsItsOwnRecord` established a sole field and the column is sized to the layout's field count")
			let record = self.coOwnAggregateAsTemp(sizedBuffer, range: range)
			self.retypeValue(record, valueType: MaxonType.genericInstance(self.signatures.ownRecordSelfInstance(layout.name)))
			return record
		end 'theSizedContainersOwnRecord'

		try self.requireNameIsNotABuiltinContainerBase(layout, anchor: anchor)
		try self.requireArrayMarkerDeclaresTheBuffer(layout, anchor: anchor)
		let tag = try self.requireFusedWrapperTag(layout, anchor: anchor)

		// A wrapper conformer with no `managed` field declares itself the compiler's byte record and then
		// does not carry one. Nothing in the corpus does this; a stdlib edit that did would otherwise
		// reach `fieldValues.get` past its end.
		let managedIndex = try layout.inlineManagedFieldIndex() otherwise throw SourceParseError.unsupported("`{String.from(layout.name)}` names a builtin literal marker, so its record is the fused byte record, but it declares no `managed` field for that record's buffer to come from", line: anchor.line, column: anchor.column)

		let source = try fieldValues.get(managedIndex) otherwise panic("emitFusedWrapperLiteral: fieldValues.get OOB at {managedIndex} — the column is sized to the layout's field count")

		let flagIndex = try layout.indexOfField(SingleByteGraphemesFieldName) otherwise return self.emitOwnedRuntimeResult(StrFromBytesName, args: argsOf(source), resultTag: tag, resultNameId: self.fusedWrapperNameId(tag, layout: layout), range: range)

		let flag = try fieldValues.get(flagIndex) otherwise panic("emitFusedWrapperLiteral: fieldValues.get OOB at {flagIndex} — the column is sized to the layout's field count")
		return self.emitOwnedRuntimeResult(StrOfBufferName, args: twoArgs(source, second: flag), resultTag: tag, resultNameId: self.fusedWrapperNameId(tag, layout: layout), range: range)
	end 'emitFusedWrapperLiteral'

	// ⭐⭐ **THE IDENTITY ARM HANDS THE BUFFER BACK *AS* `Self`, SO THE TWO MUST BE THE SAME INSTANCE.** A
	// `type Bag uses Element implements BuiltinArrayLiteral` whose sole field is the BARE `__ManagedMemory` has
	// the buffer SURFACE — which is what `firstFieldIsItsOwnBuffer` tests — while its element is `Byte` and
	// `Self`'s is `Element`. The bytes and the identity are each internally consistent; they are simply not the
	// container the declaration promised.
	//
	// ⛔ **WITHOUT THIS THE PROGRAM WAS STILL REFUSED, BY THE LATER RETURN COMPARE, IN A SENTENCE THAT NAMED
	// NEITHER FAULT**: `E3005 Cannot return 'ByteArray' from function declared to return
	// 'MyCollection_Te051b2272b3afaf0'` — a mangled instance name at the author, about a RETURN, in a program
	// whose fault is a FIELD. That is the same shape `firstFieldIsItsOwnBuffer`'s own header records for the
	// `var managed as Num` case it was tightened to catch, one field type over.
	//
	// ⚠ The sized-container arm below does NOT ask this and must not: a `FixedArray`'s buffer is an
	// `Array with Element` and its `Self` carries a SIZE the array has no column for, so there the difference
	// is the point and the value is RETYPED instead.
	function requireBufferElementIsTheDeclarationsOwn(layout StructLayout, buffer ValueId, anchor Token) throws SourceParseError
		let held = self.typeOf(buffer)

		if maxonTypeTag(held) == ValueTypeTag.genericInstance and genericInstanceIdOf(held) == self.signatures.ownRecordSelfInstance(layout.name) 'theSameContainer'
			return
		end 'theSameContainer'

		throw SourceParseError.unsupported("the field '{String.from(layout.fieldNameAt(0))}' of `{String.from(layout.name)}`, which declares itself the compiler's array record — such a literal IS its buffer and is handed back as `Self`, so the field's element must be the type parameter `{String.from(layout.name)}` is generic over, and this one's is not. The value would wear an identity its bytes do not have. Declare the field through an inner `typealias` over the parameter, which is `stdlib/Array.maxon`'s own spelling", line: anchor.line, column: anchor.column)
	end 'requireBufferElementIsTheDeclarationsOwn'

	// A byte-record tag carries no name (`String` and `Character` are their own `MaxonType` arms); a
	// `structRef` is nothing BUT its name, and `p.flag` on the result needs it to find the layout. One place
	// decides, so the two producers above cannot disagree about which values carry one.
	function fusedWrapperNameId(tag ValueTypeTag, layout StructLayout) returns TypeNameId
		if tag == ValueTypeTag.structRef 'nominal'
			return self.artifact.typeNames.intern(layout.name)
		end 'nominal'

		return UnnamedTypeId
	end 'fusedWrapperNameId'

	// ⭐⭐ **A LITERAL MARKER ON A NAME THE COMPILER ALREADY SERVES A CONTAINER UNDER** — asked FIRST of this
	// family's sentences, because the NAME disqualifies the declaration whatever its fields say.
	//
	// The others each presume the compiler could own the record if the declaration were shaped right:
	// `requireArrayMarkerDeclaresTheBuffer` tells a conformer to make its first field the buffer,
	// `requireBufferIsItsOwnRecord` tells it to drop its second field, and `requireFusedWrapperTag` says the
	// compiler owns no record under that name. **All three are the wrong advice here.** A declaration named
	// `FixedArray` or `List` may be perfectly shaped — `stdlib/FixedArray.maxon`'s is, to the field — and it is still
	// not the array record, because the compiler serves a container of its own under that name and a `FixedArray with 3 T`
	// carries a SIZE the record has no coordinate for.
	//
	// ⚠ **THIS IS A NOUN, NOT A GATE, AND THE MEASUREMENT SAYS SO — READ IT BEFORE ASSUMING WHAT IT BUYS.**
	// The rule that actually keeps a container off the array surface is
	// `ProgramSignatures.noteArrayLiteralConformer`'s skip, and it is also what makes this door REACHABLE:
	// without the skip, `isArrayBaseName` answers TRUE for the name, `firstFieldIsItsOwnBuffer` follows, and
	// the caller returns down its IDENTITY arm before any of these sentences is asked. **Sabotage-measured on
	// the three `array-declared-record.error.a-conformer-named-for-…` cases**: with the skip reverted and this
	// refusal in place, the two constructing cases COMPILE CLEAN; with the skip in place and this refusal
	// reverted, they are refused with `requireFusedWrapperTag`'s `String`/`Character` sentence — accurate
	// about a `Holder` and misleading about a `FixedArray`, which is the whole of what this door adds. The
	// conformance REQUIRES `static init(value __ManagedMemory) returns Self`, so a conformer that constructs
	// always reaches here; one that DELEGATES never does, and rests on the skip alone (that case's table).
	//
	// ⛔⛔ **IT IS GATED ON THE ARRAY MARKER, AND RENDERING THE MARKER INTO THE SENTENCE IS NOT ENOUGH.** The
	// marker's NAME interpolates correctly while the REASON below it stays hardcoded to the array surface, so
	// a `BuiltinStringLiteral` conformer named for a container does NOT meet its own marker in the sentence.
	// Ungated, `type FixedArray implements BuiltinStringLiteral` with a `managed` + `flag` pair — the
	// `interface-conformance.error.literal-marker-conformer-…` shape with only the name changed — is answered
	// *"…not the `__ManagedMemory` record a `BuiltinStringLiteral` conformer's literal is an identity on.
	// Honouring the marker would put every `FixedArray` on the growable array's surface — `push`, `resize`"*.
	// Every clause of that is wrong for it: the declaration is NOT generic, so there is no `FixedArray with …`;
	// `noteArrayLiteralConformer` is never called for a string marker, so no array surface is at stake; and it
	// PREEMPTS `requireFusedWrapperTag`'s sentence, which is the right one and is what the identical
	// declaration named `Wrapped` gets. The wrong NOUN is the one failure this door exists to prevent.
	//
	// ⇒ **The gate is the array marker, the same opening clause `requireArrayMarkerDeclaresTheBuffer` has**,
	// because the hazard the sentence names — the growable surface reached through
	// `isArrayBaseName`'s widening — is reachable through no other marker. A container-named conformer of any
	// OTHER literal marker falls through to `requireFusedWrapperTag`, whose subject is the byte record and
	// whose sentence is true of it.
	// (`array-declared-record.error.a-string-marker-conformer-named-for-a-container-is-not-this-doors-subject`)
	//
	// ⚠ **THE REFUSAL RESTS ON THE RECORD, NOT ON A RUNTIME SURFACE.** `stdlib/FixedArray.maxon` serves
	// `create`, `count`, `get` and `set`, so there is no runtime surface left to name. What the compiler
	// SYNTHESIZES is the RECORD: a `FixedArray with …` is this compiler's instance whatever a declaration of that
	// name says, which is exactly why the marker's identity cannot be honoured on it.
	function requireNameIsNotABuiltinContainerBase(layout StructLayout, anchor Token) throws SourceParseError
		if not layout.requireBuiltinManagedWrapperInterfaceName().equals(BuiltinArrayLiteralInterfaceName) 'notTheArrayMarker'
			return
		end 'notTheArrayMarker'

		if not self.signatures.isBuiltinGenericBaseNameBesidesTheRecord(layout.name) 'aNameNoContainerHolds'
			return
		end 'aNameNoContainerHolds'

		throw SourceParseError.unsupported("`{String.from(layout.name)}` is a generic container the compiler SYNTHESIZES the record for, so a `{String.from(layout.name)} with …` is already this compiler's own instance and not the `{String.from(ManagedMemoryTypeName)}` record a `{String.from(BuiltinArrayLiteralInterfaceName)}` conformer's literal is an identity on. Honouring the marker would put every `{String.from(layout.name)}` on the growable array's surface — `push`, `resize` — under the container's own name, which is a wrong answer rather than a refusal. Rename the declaration, or drop the marker", line: anchor.line, column: anchor.column)
	end 'requireNameIsNotABuiltinContainerBase'

	// ⭐⭐ **A GENERIC `BuiltinArrayLiteral` CONFORMER WHOSE FIRST FIELD IS NOT THE BUFFER** — it exists
	// because the family's other sentences are each about something this declaration does not get wrong.
	//
	// `requireBufferIsItsOwnRecord` is about a SECOND field, and there is only one here.
	// `requireFusedWrapperTag` is about the two NAMES the compiler owns a byte record for, and it would say
	// "a conformer of any other name" to a declaration whose name is beside the point — what is wrong is
	// that its one field is a `Num`, or a `String`, where the record it claims requires a `__ManagedMemory`
	// over the very parameter it declares. A NAME-keyed admission ADMITS this shape and the identity hands
	// the raw field value back as the container; the only thing that then refuses it is a later type compare,
	// whose sentence is about a return (see `ProgramSignatures.declarationIsTheManagedRecord`).
	//
	// ⚠ **THE TYPE-PARAMETER GATE IS THE WHOLE OF WHY THIS DOES NOT SWALLOW `Holder`.** A NON-generic
	// conformer cannot be the buffer record at all — the record is generic over its element — so nothing
	// about its field could be repaired and the name sentence is the right one for it. That is the boundary
	// `array-declared-record.error.a-conformer-of-another-name-is-still-refused` pins.
	function requireArrayMarkerDeclaresTheBuffer(layout StructLayout, anchor Token) throws SourceParseError
		if not layout.requireBuiltinManagedWrapperInterfaceName().equals(BuiltinArrayLiteralInterfaceName) 'notTheArrayMarker'
			return
		end 'notTheArrayMarker'

		if self.signatures.declaredFieldsBeginWithABuffer(layout) 'theFirstFieldIsABuffer'
			return
		end 'theFirstFieldIsABuffer'

		// A declaration with no type parameter is `Holder`'s case, above: it is not this refusal's subject,
		// and its element name — which the sentence has to spell — does not exist to be spelled.
		let element = try self.signatures.structTypeParamsOf(layout.name).get(0) otherwise return

		throw SourceParseError.unsupported("`{String.from(layout.name)}` implements `{String.from(BuiltinArrayLiteralInterfaceName)}` over the parameter `{String.from(element)}` it declares, so its record IS a `{String.from(ManagedMemoryTypeName)} with {String.from(element)}` and its literal is an identity on that buffer — but its first field is not one. A value whose bytes are the buffer's and whose declared fields say otherwise has those fields discarded at construction and read back past the record's end when it is cloned or destroyed. Declare exactly one field, `{String.from(InlineManagedFieldName)} as {String.from(ManagedMemoryTypeName)} with {String.from(element)}`, or drop the marker so the declaration keeps the box its fields describe", line: anchor.line, column: anchor.column)
	end 'requireArrayMarkerDeclaresTheBuffer'

	// ⭐⭐ **IS THIS DECLARATION THE BUFFER RECORD IT ALREADY IS?** — the
	// admission test for `emitFusedWrapperLiteral`'s identity arm, and the SECOND half of a shape the arm
	// has already asked the first half of. The arm's gate is `ProgramSignatures.firstFieldIsItsOwnBuffer`;
	// what is left to demand is that the buffer is the declaration's ONLY field.
	//
	// ⭐ **THIS IS ITS POSITIONED HALF — A REFUSAL WHOSE NOUN IS THE SHAPE, NOT THE NAME.**
	// `requireFusedWrapperTag`'s sentence is about which NAMES the compiler owns a record for, and it would
	// be actively misleading here: this declaration's first field IS the buffer, so the compiler owns its
	// record and the extra FIELDS are what disagree. Such a declaration would have every field past the
	// buffer discarded by the identity — the very hazard the sibling sentence names — so it is refused with
	// the field it is about.
	function requireBufferIsItsOwnRecord(layout StructLayout, anchor Token) throws SourceParseError
		if layout.fieldCount() == 1 'itsOwnRecord'
			return
		end 'itsOwnRecord'

		throw SourceParseError.unsupported("`{String.from(layout.name)}` implements `{String.from(layout.requireBuiltinManagedWrapperInterfaceName())}`, and a record whose first field IS its `{String.from(ManagedMemoryTypeName)}` is that buffer — one record under two names — so its literal is an identity on the buffer that field names. This declaration has {layout.fieldCount()} field(s), and every one past the buffer would be silently dropped at construction and then read back past the record's end when the value is cloned or destroyed. Declare the buffer alone, or drop the literal marker so the declaration keeps the box its fields describe", line: anchor.line, column: anchor.column)
	end 'requireBufferIsItsOwnRecord'

	// ⭐⭐ **WHICH TAG A FUSED LITERAL PRODUCES — DECIDED BY THE TYPE'S NAME, AND A NAME THE COMPILER DOES NOT
	// OWN THE RECORD FOR IS REFUSED OUTRIGHT.** The marker cannot decide it: keying on the marker alone gave
	// EVERY `BuiltinStringLiteral` conformer the `string` tag, so a type of any other name got a `string`-tagged
	// value out of its own `Self{…}` while `returns Self` still resolved to its struct —
	// `E3005 Cannot return 'String' from function declared to return 'struct'`, measured on a corpus-provenanced
	// probe.
	//
	// ⚠⚠ **AND KEYING ON THE NAME WHILE STILL BUILDING THE RECORD IS THE OTHER HALF OF THE SAME DEFECT, WHICH
	// IS WHY THIS REFUSES RATHER THAN FALLING BACK TO `structRef`.** A conformer of any other name was handed a
	// value whose BYTES are the fused byte record's and whose IDENTITY is a struct's, and the three consumers of
	// that value each read it as the thing it is not — measured, all three, on ordinary user programs:
	//   * **Construction DISCARDS every field the fused record has no slot for.** `emitFusedWrapperLiteral`
	//     takes `managed` as its source and `singleByteGraphemesFlag` as its flag and passes on nothing else, so
	//     a conformer whose second field is named anything else reaches `__str_from_bytes`, which CLASSIFIES the
	//     bytes and writes its OWN answer at @40 — the offset that field occupies. `Self{flag: false}` read
	//     back **TRUE**: exit 7 on a program whose only literal wrote `false`, no fault, no leak, no diagnostic.
	//   * **The DROP is `__destruct_<T>`**, built from the DECLARED field list rather than from the record that
	//     was actually built, so a third field is loaded from past the fused record's end and handed to
	//     `__str_decref`: **0xC0000005**.
	//   * **The CLONE is `__clone_<T>`**, built from the identical list, and faults identically.
	// There is no tag that fixes this: the value is one record and two descriptions of it. The DECLARATION
	// stays legal (its layout is a real answer, which is what `sizeof` reports) and the CONSTRUCTION is refused.
	//
	// ⚠ **THIS IS REACHED ONLY BY A CONFORMER THE IDENTITY ARM DID NOT TAKE.** The corpus's own
	// `type Array` does not arrive here at all: its record needs no producer, so it is served one door up by
	// `ProgramSignatures.firstFieldIsItsOwnBuffer`. What arrives is every OTHER `BuiltinArrayLiteral`
	// conformer — a type whose first field is not the buffer over its own type parameter, whatever it is
	// named — and for each of those the three consequences above hold, so the sentence they meet is
	// the same. (A conformer whose first field IS that buffer but which declares a SECOND one is served
	// by `requireBufferIsItsOwnRecord`, whose noun is the extra field rather than the name.)
	//
	// ⇒ Only the two names the compiler already owns denote a builtin byte record: `String` and `Character`
	// are on `TypeResolution.isCompilerOwnedTypeName`, which is what guarantees no USER file can mint one, so a
	// layout carrying one of those names IS the corpus's own declaration — and its values are tagged
	// `string`/`character` and dropped through `__str_decref`, never through a struct cascade.
	//
	// The two byte-record names get DISTINCT tags for `IrInterface.CharacterConformerName`'s stated reason: a
	// `Character` and a `String` share one representation and are told apart only by their type — and the
	// name→tag decision is `byteRecordTagOfTypeName`'s, shared with the two type-reference doors so a literal's
	// tag and its declared type's tag are one answer. That same call is the ADMISSION test here, so the set of
	// names that may be constructed and the set that may be REFERENCED cannot drift apart.
	function requireFusedWrapperTag(layout StructLayout, anchor Token) returns ValueTypeTag throws SourceParseError
		let byteRecord = byteRecordTagOfTypeName(layout.name)

		if byteRecord != ValueTypeTag.unresolved 'theCompilersOwnByteRecord'
			return byteRecord
		end 'theCompilersOwnByteRecord'

		throw SourceParseError.unsupported("`{String.from(layout.name)}` implements `{String.from(layout.requireBuiltinManagedWrapperInterfaceName())}`, one of `stdlib/Builtins.maxon`'s literal markers, so its record would be the compiler's own fused byte record rather than the fields it declares. The compiler mints that record only for the two names it owns the record FOR — `{String.from(StringConformerName)}` and `{String.from(CharacterConformerName)}` — because a conformer of any other name gets a VALUE whose bytes are a byte record's and whose IDENTITY is a struct's: every declared field the fused record has no slot for is discarded at construction, and the struct cascade that later drops or clones it reads past the record's end", line: anchor.line, column: anchor.column)
	end 'requireFusedWrapperTag'

	function emitInlinePackedLiteral(layout StructLayout, fieldValues ValueIdArray, range SourceRange) returns ValueId
		let recordType = MaxonType.structRef(self.artifact.typeNames.intern(layout.name))
		let last = layout.fieldCount() - 1
		var word = self.emitInlinePackedTerm(layout, fieldValues: fieldValues, index: 0, range: range)

		if last == 0 'aSoleField'
			return self.emitRetaggedCastValue(word, targetType: recordType, range: range)
		end 'aSoleField'

		for i in 1 upto layout.fieldCount() 'eachFurtherField'
			word = self.emitMachineWordBinOp(word, rhs: self.emitInlinePackedTerm(layout, fieldValues: fieldValues, index: i, range: range), op: MaxonBinOp.bitOr, resultType: recordType if i == last else MaxonType.integer, range: range)
		end 'eachFurtherField'

		return word
	end 'emitInlinePackedLiteral'

	function emitInlinePackedTerm(layout StructLayout, fieldValues ValueIdArray, index FieldIndex, range SourceRange) returns ValueId
		let value = try fieldValues.get(index) otherwise panic("emitInlinePackedTerm: fieldValues.get OOB at {index} — the column is sized to the layout's field count")
		let widened = self.emitInlineFieldAsAWord(value, range: range)
		let offset = layout.fieldBitOffset(index)

		if offset == 0 'alreadyInTheLowBits'
			return widened
		end 'alreadyInTheLowBits'

		return self.emitMachineWordBinOp(widened, rhs: self.emitLiteral(offset as FullRangeInt, valueType: MaxonType.integer, range: range), op: MaxonBinOp.shl, resultType: MaxonType.integer, range: range)
	end 'emitInlinePackedTerm'

	function emitInlineFieldAsAWord(value ValueId, range SourceRange) returns ValueId
		if self.tagOf(value) != ValueTypeTag.boolean 'alreadyAMachineWord'
			return value
		end 'alreadyAMachineWord'

		return self.emitRetaggedCastValue(value, targetType: MaxonType.integer, range: range)
	end 'emitInlineFieldAsAWord'

	function emitInlinePackedFieldRead(box ValueId, layout StructLayout, index FieldIndex, declared MaxonType, range SourceRange) returns ValueId
		let offset = layout.fieldBitOffset(index)
		let width = layout.fieldBitWidth(index)
		let isBool = maxonTypeTag(declared) == ValueTypeTag.boolean
		var extracted = box

		if offset != 0 'aboveTheLowBits'
			extracted = self.emitMachineWordBinOp(box, rhs: self.emitLiteral(offset as FullRangeInt, valueType: MaxonType.integer, range: range), op: MaxonBinOp.shrLogical, resultType: MaxonType.integer, range: range)
		end 'aboveTheLowBits'

		if width != InlineRecordWordBits 'narrowerThanTheWord'
			extracted = self.emitMachineWordBinOp(extracted, rhs: self.emitLiteral(inlineFieldMask(width as NarrowFieldWidth), valueType: MaxonType.integer, range: range), op: MaxonBinOp.bitAnd, resultType: MaxonType.integer if isBool else declared, range: range)
		end 'narrowerThanTheWord'

		if not isBool 'aNumericField'
			return self.emitRetaggedCastValue(extracted, targetType: declared, range: range) if extracted == box else extracted
		end 'aNumericField'

		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.compare(result, lhs: extracted, rhs: self.emitLiteral(0, valueType: MaxonType.integer, range: range), op: MaxonCmpOp.ne, signedness: IntegerSignedness.signed), range: range)
		return result
	end 'emitInlinePackedFieldRead'

	function emitOwnedStructBox(layout StructLayout, range SourceRange) returns ValueId
		let size = self.emitLiteral(layout.sizeBytes() as FullRangeInt, valueType: MaxonType.integer, range: range)
		let box = self.emitBoxAlloc(size, resultTag: ValueTypeTag.structRef, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)
		self.trackOwnedTemp(box, exclusivity: OwnedHeapExclusivity.sole)
		return box
	end 'emitOwnedStructBox'

	// ⭐ **THE THREE DOTTED EXPRESSIONS**, split here and nowhere else. The cursor is on an
	// identifier followed by `.`, and the language spells three unrelated things that way:
	//
	//   1. `Point.create(3, y: 4)` — a QUALIFIED STATIC CALL. Recognized by the `(` at +3, which is
	//      the token neither of the others can have: `u16.max(` is not legal Maxon (a bound is a
	//      value, not a callee) and `p.x(` would be a call THROUGH a field, which needs the
	//      function-typed values.
	//   2. `p.x` — a FIELD ACCESS, when the base name is bound in this function's scope. Asked
	//      SECOND and by SCOPE, which is the same "LOCAL FIRST" rule `parseVariableReference`
	//      already resolves a bare name by: a local named `u16` would shadow the sized type, exactly
	//      as a local `OFFSET` shadows a top-level constant of that name.
	//   3. `u16.max` — a TYPE-QUALIFIED NUMERIC BOUND, the fallback for a sized base that is neither
	//      callable nor bound. Any other such base is refused for the member it lacks.
	//
	// The order is the decision. Testing the bound table FIRST would have to guess whether `p` is a
	// sized type before knowing `p` is a local, and `sizedTypeBound` answers `notASizedType` for
	// every struct — so `p.x` would have reported "expected a sized numeric type (u8/u16/…)" for a
	// perfectly good field read.
	//
	// `resultUsed` is passed through to the two CALL forms (the method call and the qualified static
	// call) and means what it means everywhere else: is this call's value read? It is `true` from
	// expression position and `false` from a `try` TARGET, where the try's own position decides value
	// usability (`parseTryCallTarget`). Threaded rather than pre-dispatched by the caller: an arm
	// order lives in ONE place, so a form added ahead of the method arm here cannot be silently
	// skipped by a second copy of the split. Hard-coding it `true` is what rejected a VOID throwing
	// static under `try` — `try Gate.check(1)` reported E2004 "does not return a value" for a
	// statement whose value nobody wanted, while its instance twin `try g.bump(1)` was accepted. Both
	// spellings are legal.
	function parseDottedPrimary(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		// ⭐ **A BOUND BASE IS A VALUE, AND A VALUE OUTRANKS A TYPE NAME.** `p.x` and `p.add(10)` are
		// an instance's field and an instance's METHOD; `Point.create(10)` is a static method, and
		// `u16.max` is a bound. The base being IN SCOPE is what tells the first two from the last
		// two, and it is asked FIRST for `parseVariableReference`'s stated reason: a local binding
		// shadows a name from any wider scope, which is what every language with both does.
		//
		// ⚠ **THE `(` AT +3 IS NOT ENOUGH TO FIND A STATIC CALL**, and that is the trap this order
		// avoids: `p.add(10)` and `Point.create(10)` have IDENTICAL token shapes. Testing `(` first
		// sends `p.add(10)` to `parseQualifiedCall`, which would mangle the callee out of the
		// VARIABLE's name — `p.add`, which no file declares — and report E3004 against a method that
		// is right there in the type. `methodCallsAt` is where that scope test lives, shared with the
		// statement dispatcher.
		// `arr.managed` joins the method arm rather than the field arm below — see `arrayManagedFieldAt`. It is
		// asked WITH `methodCallsAt` because both route to `parseMethodCall` and the two shapes are disjoint.
		// This is the ONE position that reads the UNCHAINED predicate: an expression is where a bare
		// `arr.managed` is a value somebody wants (`f(content.managed)`), which the two call-only positions
		// (`methodCallStmt`, the `try` target) are not.
		if self.methodCallsAt(self.pos) or self.arrayManagedFieldAt(self.pos) 'methodCall'
			return try self.parseMethodCall(func, resultUsed: resultUsed)
		end 'methodCall'

		// A base that names a VALUE — a this-frame binding, or a CAPTURED enclosing one, whose field read
		// `parseFieldAccess` takes out of the env via `resolveFieldChain`'s captured arm. `valueBaseAt` is where
		// the shadowing rule lives and `Self` is excluded.
		// `s.ordinal` on an enum or union value — asked BEFORE the field arm on both routes and never instead
		// of it. The two are disjoint by the member name, and the order is what matters: an enum base
		// reaching `parseFieldAccess` is refused by `requireStructBase` (a declared enum has no struct layout
		// to find), which is the E2015 this arm exists to route past. See `enumMemberReadableOff`.
		match self.valueBaseAt(self.pos) 'valueBase'
			thisFrame then return try self.parseThisFrameDottedPrimary(func)
			captured(frame) then return try self.parseCapturedDottedPrimary(func, enclosing: self.capturedFrame(frame).scope, frame: frame)
			unbound or
			alwaysAType then break
		end 'valueBase'

		let chain = try self.enterQualifiedChainAtCursor(MethodQualifierDots)

		// ⭐ **EVERY FORM BELOW NAMES A TYPE, AND ITS BASE IS READ THROUGH `typeBaseTokenAt` — WHICH IS WHERE
		// `Self` BECOMES THE TYPE IT DENOTES.** So `Self.off` inside `enum Toggle` takes the enum-case arm
		// `Toggle.off` takes, and `Self.make(v)` inside `type Box` takes the static-call arm `Box.make(v)`
		// takes. There is deliberately no `Self` arm anywhere: the two spellings converge at the ONE token a
		// type-named form reads its base from, so an arm added here serves both without knowing that.
		//
		// ⚠ **THE VALUE-BASED ARM ABOVE IS ASKED FIRST, AND `Self` IS THE ONE BASE IT MAY NOT CLAIM.** A local
		// named after the enclosing type (`let Box = 1` inside `type Box`) shadows `Box.` — that is the "a value
		// outranks a type name" rule — while `Self.` cannot mean a local under any spelling, and a parameter
		// named `Self` is admitted by the keyword-as-a-declared-name rule, so the exclusion has to be stated
		// rather than assumed. It is stated once, in `valueBaseAt`.
		let baseTok = try self.typeBaseTokenAt(self.pos)
		let memberIndex = self.pos + TokensPerQualifierSegment

		// ⭐ **A DOTTED PRIMARY WHOSE HEAD NAMES A TYPE IS A MENTION OF THAT TYPE** — `Color.blue`,
		// `Point.create(…)`, `Config.MAX_SIZE`. Recorded HERE, above the arms that decide WHICH of those
		// it is, for exactly the reason `recordTypeNameUse` states about its other site: a recording site
		// does not know what a written name denotes and must not have to ask, and hooking the arms instead
		// would need one hook per arm and silently miss the next one added.
		//
		// ⚠ **AN EXPRESSION-POSITION MENTION COUNTS, AND IT DID NOT BEFORE.** Only type POSITIONS were
		// recorded, which is all E3062 needs — an alias is used when something is typed by it. But
		// `checkUnusedExports` asks the wider question, and an enum used cross-file is used almost entirely
		// from expression position: MEASURED, `export enum Color` read as `Color.blue` in another file was
		// reported E3092 by `export-keyword/exported-enum-cross-file`, whose whole subject is that the
		// cross-file reference WORKS. E3062 only ever filters this set against a file's own non-exported
		// typealiases, so a widened set can make it report LESS, never wrongly — and a name mentioned in
		// any position is a name the file uses, which is the question E3062 asks too.
		let baseReader = self.typeNameReaderAt(self.pos)

		if self.signatures.containsStructFor(baseTok.value, readerFilePath: baseReader) or self.signatures.containsEnumFor(baseTok.value, readerFilePath: baseReader) 'headNamesAType'
			self.recordBaseTypeNameUse(self.pos, resolved: baseTok)
		end 'headNamesAType'

		// `Color.red` and `Move.walk(Direction.east)` — an ENUM CASE reference or a UNION CONSTRUCT,
		// the base being a declared enum/union. Asked AFTER the scope-based forms above (a bound base
		// outranks a type name, exactly as `u16.max` is the last resort) but BEFORE the qualified STATIC
		// CALL below, because a payload construct `Move.walk(…)` has the SAME `<name>.<name>(` shape a
		// static call does: testing `(` at +3 first would mangle it to a callee `Move.walk` no file
		// declares (E3004) rather than building the box. The two are disjoint by name — a name is one
		// type, so a struct's `Point.create(…)` never resolves as an enum here.
		// Gated on the non-allocating `containsEnum` rather than `enumOf` directly: this runs for EVERY
		// dotted primary, and `enumOf` would box a throwaway `DeclaredEnum.undeclared` for every
		// `Point.create(...)` (scale-test charged exactly that — see `ProgramSignatures.containsEnum`).
		// The `enumOf` inside the guard runs only for a real enum reference, which is rare.
		// ⛔ **`containsEnumFor`, NOT THE BARE PROBE.** An `export enum` another file declares is visible
		// here, so only the reader-aware probe stops `Status.big`, written where `Status` means a ranged
		// `int(0 to 5)`, from reaching that enum and storing 200 into the alias's slot.
		if self.signatures.containsEnumFor(baseTok.value, readerFilePath: baseReader) 'enumRef'
			match self.signatures.enumFor(baseTok.value, readerFilePath: baseReader) 'declared'
				declared(layout) then return try self.parseEnumLiteral(func, declaredLayout: layout)
				undeclared then panic("parseDottedPrimary: containsEnum answered yes but enumOf answered undeclared — the two read the same enum registry, under the same key")
			end 'declared'
		end 'enumRef'

		// ⭐⭐ **`Calc.request.unionCases.bump` — A TYPE WHOSE NAME CARRIES A DOT.** A service's
		// request union is a synthesized companion, named `<T>.request`, and it is an ordinary union in every
		// other respect: it has cases, tags and a `unionCases` companion of its own. The arm above cannot claim
		// it because `containsEnum` is asked of the FIRST token alone, and `Calc` is a struct.
		//
		// ⚡ **THE GATE IS A `count()`, AND THAT IS THE WHOLE COST MODEL** — this line runs at every dotted
		// primary in every program, and the QUESTION needs two tokens joined into a name. Only a companion type
		// carries a dot, so `declaresACompanionType` is false for every program with no `spawn` in it and nothing
		// is built.
		//
		// ⚠ The trailing `.` is part of the SHAPE and not decoration: `Calc.request` with nothing after it names
		// a type and denotes no value, which is a different mistake and takes a different arm.
		if self.dottedCompanionTypeAt(baseTok) 'companionTypeRef'
			return try self.parseCompanionTypeLiteral(func)
		end 'companionTypeRef'

		// ⭐⭐ **`utils.helper()` / `lib.inner.deepHelper()` — A DIRECTORY-QUALIFIED FREE CALL, at any segment
		// count.** Asked above the `Type.method` arm, which mangles a static's callee out of the first two tokens
		// and has no reading of a free function.
		//
		// ⚠ **THE CLAIMANTS ARE SEPARATED BY ORDER AND BY THE RESOLVER, AND NEVER BY "IS THE HEAD A
		// NAMESPACE?"** A value base and an enum reference are claimed above; this then demands a trailing `(`
		// (which a bound has not) AND the directory-qualified free function `resolveChain` answered (which a
		// bound's `u64` is not). Anything it declines falls through untouched to the arms that follow.
		if self.chainIsADirectoryQualifiedCall(chain) 'multiSegmentNamespaceCall'
			return try self.parseNamespaceQualifiedCall(func, chain: chain, resultUsed: resultUsed)
		end 'multiSegmentNamespaceCall'

		if self.kindAt(self.pos + 3) == TokenKind.leftParen and not self.chainHeadsAValue(chain) 'qualifiedCall'
			return try self.parseQualifiedCall(func, resultUsed: resultUsed)
		end 'qualifiedCall'

		// ⭐ **`Counter.count` — A READ OF A STATIC MEMBER, which is a read of a top-level binding whose
		// NAME happens to carry a dot.** So it routes to `topLevelBindingReference`, the very door a bare
		// global name uses: a `static let` INLINES its folded value or LOADS from its `.data`
		// slot, through the same two probes and the same emitted ops. Nothing about this arm is static-member
		// machinery — it only spells the name.
		//
		// Placed with the type-based arms and BELOW the call shapes, which is the precedence
		// `top-level-let-name-shadowed-by-type` already pins: a form that names a TYPE is tried before the
		// managed-global fallback beneath it, and a base bound to a VALUE has already claimed the whole
		// expression above.
		if self.namesStaticMemberAt(baseTok, memberIndex: memberIndex) 'staticMemberRead'
			if self.staticMemberHeadsAFieldChain(baseTok, memberIndex: memberIndex) 'aFieldChainOffAStaticRecord'
				return try self.parseFieldAccess(func)
			end 'aFieldChainOffAStaticRecord'

			return try self.parseStaticMemberAccess(func, baseTok: baseTok, resultUsed: resultUsed)
		end 'staticMemberRead'

		// ⭐ **A TOP-LEVEL MANAGED GLOBAL'S FIELD — `db.sourceFiles`** (spec-port `map-struct-bytearray`), the
		// one value base that is neither in scope nor captured. Asked HERE, below every type-based arm, and
		// that placement is the rule rather than an accident: see `chainBaseNamesAValue`.
		if self.managedTopLevelBaseAt(self.pos) 'managedTopLevelField'
			return try self.parseFieldAccess(func)
		end 'managedTopLevelField'

		if self.chainHeadsAValue(chain) 'aBindingHeadsIt'
			return try self.parseVariableReference()
		end 'aBindingHeadsIt'

		if self.qualifiedBindingIdentityIsAt(self.pos) 'namespaceQualifiedBinding'
			return try self.parseNamespaceQualifiedBindingRead()
		end 'namespaceQualifiedBinding'

		// `beta.helper` READ AS A VALUE — asked below every type-named arm, so the type reading keeps every chain
		// it claims.
		if self.chainNamesADirectoryQualifiedFunction(chain) and not self.chainCallFollowsAt(self.pos) 'namespaceQualifiedFunctionValue'
			return try self.parseNamespaceQualifiedFunctionValue(chain)
		end 'namespaceQualifiedFunctionValue'

		// ⭐ **A BASE NAMING A TYPE THIS FILE MAY NOT SEE IS REFUSED HERE, AT ITS TIER.**
		//
		// ⚠ **A HIDDEN TYPE HIDES ITS STATICS AND ITS CASES, WHATEVER THEIR OWN TIER.** The call shape
		// (`Hidden.create(…)`, via `parseQualifiedCall`) and an enum case (`Hidden.ok`, via `parseEnumLiteral`)
		// never reach this line, but both read their base through `consumeTypeBaseToken`, which refuses a hidden
		// type the same way — E3008 "type is not exported" — so an `export`ed static on a hidden type is not
		// callable from another file. Asked LAST so a visible type still takes whichever arm above claims it.
		try self.requireTypeNameVerdictNameable(try self.typeNameVerdictAt(self.pos, written: baseTok.value, anchor: baseTok))

		// ⭐⭐ **A DECLARED TYPE ANSWERS FROM ITS OWN STATIC ROSTER RATHER THAN FROM THE BOUND GRAMMAR.** Asked
		// LAST among the type-named arms and immediately before the sized-bound last resort, and every step of
		// that placement is load-bearing: after `staticMemberRead`, so a LEGAL read is already gone and a
		// `visible` verdict here can only mean "no such member"; after the type-name verdict above, so
		// the sentence's premise — that the base is a type this file may name — is true when it is
		// spoken.
		//
		// What the arm claims is stated at `staticRosterVerdictFor`. Of the residual, a sized-type base keeps
		// the bound grammar and every other base is refused for what it is (`nonBoundMemberRefusal`).
		let rosterVerdict = self.staticRosterVerdictFor(baseTok, memberIndex: memberIndex)

		match rosterVerdict 'roster'
			notADeclaredTypeMember then break
			undeclaredMember or
			hidden or
			declaredMethod or
			declaredInstanceMethod or
			hiddenMethod or
			refused or
			requirement then throw self.staticRosterRefusal(rosterVerdict, baseTok: baseTok, memberTok: self.tokenAt(memberIndex), written: self.writtenSpellingOfMemberAt(memberIndex), use: StaticMemberUse.read)
		end 'roster'

		if isSizedTypeName(baseTok.value) 'aSizedBound'
			return try self.parseTypeQualifiedBoundExpression()
		end 'aSizedBound'

		throw self.nonBoundMemberRefusal(baseTok, baseIndex: self.pos)
	end 'parseDottedPrimary'

	function parseThisFrameDottedPrimary(func IrFunction) returns ValueId throws SourceParseError
		if self.enumMemberReadableOff(self.thisFrameBindingOf(self.current()), atBase: self.pos) 'enumAccessor'
			return try self.parseEnumAccessor(EnumAccessorBase.thisFrame)
		end 'enumAccessor'

		return try self.parseFieldAccess(func)
	end 'parseThisFrameDottedPrimary'

	// Does `<baseTok> . <member> .` name a declared UNION under its joined name? The SHAPE and the REGISTRY,
	// both behind the program-wide gate that keeps the join off every other dotted primary's path.
	function dottedCompanionTypeAt(baseTok Token) returns bool
		if not self.signatures.declaresACompanionType() 'noDottedTypeNamesInThisProgram'
			return false
		end 'noDottedTypeNamesInThisProgram'

		if self.kindAt(self.pos + 1) != TokenKind.dot or not tokenCanBeAName(self.tokenAt(self.pos + 2)) or self.kindAt(self.pos + 3) != TokenKind.dot 'notTwoSegmentsAndAMember'
			return false
		end 'notTwoSegmentsAndAMember'

		return self.signatures.containsEnumFor(qualifiedMethodName(baseTok.value, methodName: self.tokenAt(self.pos + 2).value), readerFilePath: self.job.path)
	end 'dottedCompanionTypeAt'

	// Consume the two-segment head and hand the rest to the member reader every one-segment head uses. The
	// lookup cannot fail: `dottedCompanionTypeAt` has just asked the same registry with the same joined name.
	//
	// The head is re-read through `consumeTypeBaseToken` rather than taken from the caller's `baseTok`, which
	// is the same token: that door is where `Self` becomes the type it denotes, and reading it here keeps
	// the two-segment head on exactly the road the one-segment head takes.
	function parseCompanionTypeLiteral(func IrFunction) returns ValueId throws SourceParseError
		let headTok = try self.consumeTypeBaseToken()
		try self.consume(TokenKind.dot)
		let memberTok = try self.consumeMemberNameToken()
		try self.consume(TokenKind.dot)

		let joined = qualifiedMethodName(headTok.value, methodName: memberTok.value)
		return match self.signatures.enumFor(joined, readerFilePath: self.job.path) 'declared'
			declared(layout) gives try self.parseEnumLiteralMember(func, declaredLayout: layout, typeTok: headTok)
			undeclared panic("parseCompanionTypeLiteral: `{String.from(joined)}` is declared by no enum registry — `dottedCompanionTypeAt` answered `containsEnum` for this very name two tokens ago, and the two read one registry under one key")
		end 'declared'
	end 'parseCompanionTypeLiteral'

	function chainHeadsAValue(chain ChainResolution) returns bool
		return match chain 'chain'
			value gives true
			unqualified or
			declaredType or
			ambiguous or
			declaredFunction or
			nothing gives false
		end 'chain'
	end 'chainHeadsAValue'
end 'Parser'
