let IsolatedCapabilityWord = b"isolated"

let ImmutableCapabilityWord = b"immutable"

let MutableMarkerWord = b"mutable"

let MutatesClauseWord = b"mutates"

let CapturesClauseWord = b"captures"

let ModifyBlockWord = b"modify"

let AcquireBlockWord = b"acquire"

let FreezeOperatorWord = b"freeze"

let ConsumingReceiverWord = b"consuming"

let DestructStatementWord = b"destruct"

let SwapOperatorWord = b"swap"

let MergeOperatorWord = b"merge"

let UniqueDeclarationWord = b"unique"

let SendableBoundWord = b"sendable"

let IsolatedValueLabel = b"the isolated value"

let JoinedReadOnlyReason = ", as it joins immutable and mutable data"

let IsolatedJoinRefusal = "a join of an isolated value with data that is not isolated is refused: every arm must be isolated, or a fresh value"

function capabilityWord(capability ValueCapability) returns String
	return match capability 'capability'
		mutable or
		temporary gives "mutable"
		immutable gives "immutable"
		paused gives "read-only"
		isolated gives "isolated"
		unknown panic("capabilityWord: an unknown capability is never reported")
	end 'capability'
end 'capabilityWord'

function freezeAdvice(capability ValueCapability, phrase String) returns String
	if capability == ValueCapability.paused 'readOnlyDataCannotBeFrozen'
		return ""
	end 'readOnlyDataCannotBeFrozen'

	if capability == ValueCapability.temporary 'aFreshValue'
		return "{phrase}: write `freeze` before the fresh expression (`freeze Box.create(1)`), or around a receiver (`(freeze Table.create()).submit(a)`)"
	end 'aFreshValue'

	return phrase
end 'freezeAdvice'

function isolatedRecoveryRefusal(subject String, advice String) returns String
	return "{subject} is not isolated: only a clean call, a `swap` or an `isolated` local goes where an isolated value is wanted{advice}"
end 'isolatedRecoveryRefusal'

function handedBackRefusal(callee String) returns String
	return "'{callee}' hands back mutable data of the isolated region it opens; use it inside a `modify` block"
end 'handedBackRefusal'

function calleeSourceName(callee immutable ByteArray) returns String
	return String.from(unqualifiedMemberOf(genericTemplateName(callee)))
end 'calleeSourceName'

let IsolatedBindingAdvice = "; initialize it with a fresh value, a clean call, a `swap` or an `isolated` local, or pass a copy"

function isolatedMoveAdvice(declarableLocal bool, typeName String) returns String
	return (". Declare it `as isolated {typeName}`, or pass a copy" if declarableLocal else "; use a fresh value, a clean call, a `swap` or an `isolated` local, or pass a copy")
end 'isolatedMoveAdvice'

function uniqueAliasMessage(action String) returns String
	return "cannot {action} a unique value read out of a field or an element: the field or element goes on owning it, and a unique value has one name; read what is needed through the field without binding it, or move it out with `pop` or `remove`"
end 'uniqueAliasMessage'

export enum UniqueOrigin
	owned
	lentByLoop
	lentByTuple
	readFromSlot
end 'UniqueOrigin'

// @generated library-cache begin
let CacheCasesUniqueOrigin = [UniqueOrigin.owned, UniqueOrigin.lentByLoop, UniqueOrigin.lentByTuple, UniqueOrigin.readFromSlot]

function cacheReadUniqueOrigin(reader LibraryCacheReader) returns UniqueOrigin throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesUniqueOrigin.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadUniqueOrigin'

function cacheTableAgreesUniqueOrigin() returns bool
	let declared = UniqueOrigin.allCases

	if CacheCasesUniqueOrigin.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesUniqueOrigin.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesUniqueOrigin'

function cacheEnumTablesAgreeInCompilerCapabilityRules() returns bool
	if not cacheTableAgreesUniqueOrigin() 'disagreesCacheTableAgreesUniqueOrigin'
		return false
	end 'disagreesCacheTableAgreesUniqueOrigin'

	return true
end 'cacheEnumTablesAgreeInCompilerCapabilityRules'

// @generated library-cache end

export typealias UniqueOriginArray = Array with UniqueOrigin

// @generated library-cache begin
function cacheWriteUniqueOriginArray(writer LibraryCacheWriter, value UniqueOriginArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		writer.unsigned(item.ordinal as CacheUnsigned)
	end 'eachItem'
end 'cacheWriteUniqueOriginArray'

function cacheReadUniqueOriginArray(reader LibraryCacheReader) returns UniqueOriginArray throws LibraryCacheDamage
	let count = try reader.count()
	let result = UniqueOriginArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachItem'
		let item = try cacheReadUniqueOrigin(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadUniqueOriginArray'

// @generated library-cache end

function keptUniqueRefusalSentence(origin UniqueOrigin, subject String) returns String
	match origin 'origin'
		lentByLoop then return "'{subject}' is only lent by the loop; move it out with `pop` or `remove`"
		lentByTuple then return "'{subject}' is only lent by the tuple it was destructured from; move it out with `pop` or `remove`"
		readFromSlot then return "a unique value cannot be moved out of a field or an element it was only read from; move it out with `pop` or `remove`, or `swap` it out of an isolated field"
		owned then panic("keptUniqueRefusalSentence: an owned unique value has nothing to refuse")
	end 'origin'
end 'keptUniqueRefusalSentence'

function spellsCapabilityWord(word ByteArray) returns bool
	return word.equals(IsolatedCapabilityWord) or word.equals(ImmutableCapabilityWord) or word.equals(MutableMarkerWord)
end 'spellsCapabilityWord'

function spellsReceiverWord(word ByteArray) returns bool
	return spellsCapabilityWord(word) or word.equals(ConsumingReceiverWord)
end 'spellsReceiverWord'

function capabilityOfWord(word ByteArray) returns ParamCapability throws AbsentError
	if word.equals(ConsumingReceiverWord) 'consuming'
		return ParamCapability.consuming
	end 'consuming'

	if word.equals(IsolatedCapabilityWord) 'isolated'
		return ParamCapability.isolated
	end 'isolated'

	if word.equals(ImmutableCapabilityWord) 'immutable'
		return ParamCapability.immutable
	end 'immutable'

	if word.equals(MutableMarkerWord) 'mutable'
		return ParamCapability.mutable
	end 'mutable'

	throw AbsentError.absent
end 'capabilityOfWord'

function declarationWordOf(capability ParamCapability) returns String
	return match capability 'capability'
		mutable gives String.from(MutableMarkerWord)
		immutable gives String.from(ImmutableCapabilityWord)
		isolated gives String.from(IsolatedCapabilityWord)
		consuming gives String.from(ConsumingReceiverWord)
		unmarked panic("declarationWordOf: an unmarked position declares no word")
	end 'capability'
end 'declarationWordOf'

function paramCapabilityOfResult(capability ResultCapability) returns ParamCapability
	return match capability 'capability'
		unmarked gives ParamCapability.unmarked
		mutable gives ParamCapability.mutable
		isolated gives ParamCapability.isolated
		immutable gives ParamCapability.immutable
	end 'capability'
end 'paramCapabilityOfResult'

function resultCapabilityOf(capability ParamCapability) returns ResultCapability
	return match capability 'capability'
		unmarked gives ResultCapability.unmarked
		mutable gives ResultCapability.mutable
		isolated gives ResultCapability.isolated
		immutable gives ResultCapability.immutable
		consuming panic("resultCapabilityOf: a `consuming` word marks a receiver, never a result")
	end 'capability'
end 'resultCapabilityOf'

enum StoreVerdict
	fits
	recovers
	notRecoverable
	mutableIntoImmutable
	isolatedIntoMutable
	immutableIntoMutable
	pausedIntoMutable
	isolatedPartRead
end 'StoreVerdict'

function storeMismatchMessage(verdict StoreVerdict, fieldName String, valueType String, readOnlyReason String, holderNoun String) returns String
	return match verdict 'verdict'
		mutableIntoImmutable gives "cannot store a mutable '{valueType}' into '{fieldName}', which holds an immutable '{valueType}'; freeze it"
		isolatedIntoMutable gives "cannot store an isolated '{valueType}' into '{fieldName}', which holds a mutable '{valueType}'; `merge` it first"
		immutableIntoMutable gives "cannot store an immutable '{valueType}' into '{fieldName}', which holds a mutable '{valueType}'; declare the {holderNoun} `immutable {valueType}`"
		pausedIntoMutable gives "cannot store a read-only '{valueType}' into '{fieldName}'{readOnlyReason}; store a copy"
		fits or
		recovers or
		notRecoverable or
		isolatedPartRead panic("storeMismatchMessage: a {verdict.name} verdict is not a mismatch")
	end 'verdict'
end 'storeMismatchMessage'

let ItemPlacePrefix = "an item of "

let ValuePlacePrefix = "a value of "

let PayloadPlaceParts = 3

let ByteLiteralSubject = b"a byte-string literal"

let ClosureLiteralSubject = b"a closure literal"

function holderNounOf(place String) returns String
	if place.startsWith(ItemPlacePrefix) 'anItem'
		return "item"
	end 'anItem'

	if place.startsWith(ValuePlacePrefix) 'aValue'
		return "value"
	end 'aValue'

	if place.startsWith("a ") or place.startsWith("an ") 'anElement'
		return "element"
	end 'anElement'

	if place.split(".").count() == PayloadPlaceParts 'aPayload'
		return "payload"
	end 'aPayload'

	return "field"
end 'holderNounOf'

function qualifierSlot(qualifier GenericArgQualifier) returns ParamCapability
	return match qualifier 'qualifier'
		plain gives ParamCapability.unmarked
		frozen gives ParamCapability.immutable
	end 'qualifier'
end 'qualifierSlot'

function storeRefusalOf(verdict StoreVerdict, fieldName String, valueType String, readOnlyReason String, subject String, holderNoun String) returns (ErrorCode, String) throws AbsentError
	match verdict 'verdict'
		fits or
		recovers then throw AbsentError.absent
		notRecoverable then return (ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, isolatedRecoveryRefusal(subject, advice: "; declare it `as isolated {valueType}`, or store a copy"))
		isolatedPartRead then panic("storeRefusalOf: an isolated part read is refused by the reader that knows where the part was read")
		mutableIntoImmutable or
		isolatedIntoMutable or
		immutableIntoMutable or
		pausedIntoMutable then return (ErrorCode.semanticCapabilityMismatchAtStore, storeMismatchMessage(verdict, fieldName: fieldName, valueType: valueType, readOnlyReason: readOnlyReason, holderNoun: holderNoun))
	end 'verdict'
end 'storeRefusalOf'

function capabilityIsReadOnly(capability ValueCapability) returns bool
	return capability == ValueCapability.immutable or capability == ValueCapability.paused
end 'capabilityIsReadOnly'

function capabilityBreaksAFrozenNeed(capability ValueCapability) returns bool
	return capability != ValueCapability.immutable and capability != ValueCapability.unknown
end 'capabilityBreaksAFrozenNeed'

function needsWritableRefusal(head String, subject String, capability ValueCapability) returns String
	return "{head}; {subject} is {capabilityWord(capability)}"
end 'needsWritableRefusal'

function frozenSubject(subject String, capability ValueCapability) returns String
	return "a fresh value" if capability == ValueCapability.temporary else subject
end 'frozenSubject'

function needsFrozenRefusal(head String, subject String, capability ValueCapability) returns String
	return "{head}; {frozenSubject(subject, capability: capability)} is {capabilityWord(capability)}{freezeAdvice(capability, phrase: ". Freeze it first")}"
end 'needsFrozenRefusal'

function slotCapabilityOf(slot ParamCapability) returns ValueCapability
	return match slot 'slot'
		unmarked or
		mutable gives ValueCapability.mutable
		isolated gives ValueCapability.isolated
		immutable gives ValueCapability.immutable
		consuming panic("slotCapabilityOf: a `consuming` word marks a receiver, never a slot")
	end 'slot'
end 'slotCapabilityOf'

function markedParamTakesAReference(capability ParamCapability, headTakesAReference bool) returns bool
	return capability == ParamCapability.isolated or headTakesAReference
end 'markedParamTakesAReference'

function verdictBeforeCapability(isValueType bool, isSlotRead bool) returns StoreVerdict throws AbsentError
	if isValueType 'aValue'
		return StoreVerdict.fits
	end 'aValue'

	if isSlotRead 'aPartRead'
		return StoreVerdict.isolatedPartRead
	end 'aPartRead'

	throw AbsentError.absent
end 'verdictBeforeCapability'

function assignmentVerdict(variable ValueCapability, value ValueCapability, isValueType bool, isSlotRead bool) returns StoreVerdict
	if variable == ValueCapability.isolated 'anIsolatedVariable'
		return storeVerdict(ParamCapability.isolated, value: value, isValueType: isValueType, isSlotRead: isSlotRead)
	end 'anIsolatedVariable'

	if let decided = try verdictBeforeCapability(isValueType, isSlotRead: isSlotRead) 'decidedByTheValueAlone'
		return decided
	end 'decidedByTheValueAlone'

	if joinMixesIsolatedWithData(variable, second: value) 'isolatedIntoData'
		return StoreVerdict.isolatedIntoMutable
	end 'isolatedIntoData'

	return StoreVerdict.fits
end 'assignmentVerdict'

function adaptedCapability(holder ValueCapability, slot ValueCapability) returns ValueCapability
	if slot == ValueCapability.immutable or holder == ValueCapability.immutable 'frozenData'
		return ValueCapability.immutable
	end 'frozenData'

	if holder == ValueCapability.paused 'readOnlyHolder'
		return ValueCapability.isolated if slot == ValueCapability.isolated else ValueCapability.paused
	end 'readOnlyHolder'

	return slot
end 'adaptedCapability'

function windowedReadCapability(window ValueCapability, slot ParamCapability) returns ValueCapability
	return ValueCapability.immutable if slot == ParamCapability.immutable else window
end 'windowedReadCapability'

function joinedCapability(first ValueCapability, second ValueCapability) returns ValueCapability
	if first == ValueCapability.unknown or second == ValueCapability.unknown 'anUnknownArm'
		return ValueCapability.unknown
	end 'anUnknownArm'

	if first == second 'agree'
		return first
	end 'agree'

	if first == ValueCapability.isolated or second == ValueCapability.isolated 'anIsolatedArm'
		return ValueCapability.isolated
	end 'anIsolatedArm'

	if capabilityIsReadOnly(first) or capabilityIsReadOnly(second) 'aReadOnlyArm'
		return ValueCapability.paused
	end 'aReadOnlyArm'

	return ValueCapability.mutable
end 'joinedCapability'

function meetOfCaptureCapabilities(running ValueCapability, captured ValueCapability) returns ValueCapability
	if running == ValueCapability.paused or captured == ValueCapability.paused 'readOnlyOuterData'
		return ValueCapability.paused
	end 'readOnlyOuterData'

	if captured == ValueCapability.immutable 'frozenToo'
		return running
	end 'frozenToo'

	return ValueCapability.mutable
end 'meetOfCaptureCapabilities'

function refreshedCapability(current ValueCapability, holder ValueCapability, slot ParamCapability, joins bool) returns ValueCapability
	let derived = holder if joins else adaptedCapability(holder, slot: slotCapabilityOf(slot))

	if not capabilityIsReadOnly(derived) 'staysAsWritable'
		return current
	end 'staysAsWritable'

	if current != ValueCapability.mutable and current != ValueCapability.temporary 'alreadyReadOnly'
		return current
	end 'alreadyReadOnly'

	return joinedCapability(current, second: derived) if joins else derived
end 'refreshedCapability'

function joinMixesIsolatedWithData(first ValueCapability, second ValueCapability) returns bool
	if (first == ValueCapability.isolated) == (second == ValueCapability.isolated) 'bothOrNeither'
		return false
	end 'bothOrNeither'

	let other = second if first == ValueCapability.isolated else first
	return other != ValueCapability.temporary
end 'joinMixesIsolatedWithData'

function isCleanInput(capability ValueCapability, isValueType bool, isSlotRead bool) returns bool
	if isValueType 'aValue'
		return true
	end 'aValue'

	if isSlotRead 'aPartRead'
		return false
	end 'aPartRead'

	return capability == ValueCapability.isolated or capability == ValueCapability.immutable or capability == ValueCapability.temporary
end 'isCleanInput'

function storeVerdict(slot ParamCapability, value ValueCapability, isValueType bool, isSlotRead bool) returns StoreVerdict
	if let decided = try verdictBeforeCapability(isValueType, isSlotRead: isSlotRead) 'decidedByTheValueAlone'
		return decided
	end 'decidedByTheValueAlone'

	if value == ValueCapability.unknown 'anUnknown'
		return StoreVerdict.fits
	end 'anUnknown'

	if slot == ParamCapability.isolated 'anIsolatedSlot'
		if value == ValueCapability.isolated 'anIsolatedValue'
			return StoreVerdict.fits
		end 'anIsolatedValue'

		return StoreVerdict.recovers if value == ValueCapability.temporary else StoreVerdict.notRecoverable
	end 'anIsolatedSlot'

	if slot == ParamCapability.immutable 'aFrozenSlot'
		return StoreVerdict.fits if value == ValueCapability.immutable else StoreVerdict.mutableIntoImmutable
	end 'aFrozenSlot'

	if value == ValueCapability.isolated 'isolatedData'
		return StoreVerdict.isolatedIntoMutable
	end 'isolatedData'

	if value == ValueCapability.immutable 'frozenData'
		return StoreVerdict.immutableIntoMutable
	end 'frozenData'

	return StoreVerdict.pausedIntoMutable if value == ValueCapability.paused else StoreVerdict.fits
end 'storeVerdict'
