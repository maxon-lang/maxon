// ⭐⭐ **`__Raw` — THE CLOSED TABLE OF RAW MACHINE AND OS OPERATIONS, AND THE ONE SURFACE BELOW WHICH
// THERE IS NO MAXON.** It is the floor a `runtime/` source file is written on top of, and only such a
// file may reach it: a call from anywhere else is E3152
// (`Parser.requireCalleeIsNotReservedName`), because a raw machine operation in user code has no
// runtime between it and the machine.
//
// ⚠ **TWO ROWS ARE DIRECTIVES INSTEAD — `ownFrame` and `splicedAtEverySite`**, which emit nothing and
// state opposite facts about the function that spells them: its frame is its product, or it has none worth
// keeping. The table is the only vocabulary a runtime body has, so a thing a body must say and cannot
// otherwise express belongs in it; a body spelling both says two contradictory things and is refused at the
// declaration.
//
// ⭐ **THE TABLE IS WHAT EVERY READER ASKS.** Recognition, the statement door, the argument shape check
// and the lowering all read the four functions below, so "which intrinsics exist", "how is one written"
// and "what does one answer" are one fact in one place rather than a roster restated per site. The
// lowering's own `match` over `RawIntrinsic` is the fifth reader and the one that says what each row
// BECOMES — a Std op for an operation, and nothing at all for the directive; it is exhaustive, so a row
// added here does not compile until it is lowered.
//
// ⭐ A name NOT in the table is not silently a link error and earns no second error code: the call falls
// through to `emitCall`, whose reserved-callee rejection already answers the positioned E3004 that names
// it (`reservedCalleeReasonOf` ⇒ `unknownCompilerIntrinsic`). "An intrinsic of that name does not exist"
// is one rule, and numbering it twice is the disease one level up.
//
// `__Raw` reaches the parser as an ORDINARY QUALIFIED CALLEE — the mangled bytes `__Raw.osTickCountMs` —
// exactly as `__Builtins` and `__DebugStream` do, which is why a row is spelled as the whole mangled
// name and the family is gated behind ONE prefix compare that allocates nothing.

let RawQualifierPrefix = b"__Raw."

let RawOsTickCountMsName = b"__Raw.osTickCountMs"
let RawOsReadWallClockName = b"__Raw.osReadWallClock"
let RawOsThreadCpuTicksName = b"__Raw.osThreadCpuTicks"
let RawOsCpuCountName = b"__Raw.osCpuCount"
let RawOsGetPidName = b"__Raw.osGetPid"
let RawOsEnterBackgroundPriorityName = b"__Raw.osEnterBackgroundPriority"
let RawOsExitName = b"__Raw.osExit"
let RawScratchName = b"__Raw.scratch"
let RawSchedNumProcsAddrName = b"__Raw.schedNumProcsAddr"
let RawSchedMaxActiveWorkersAddrName = b"__Raw.schedMaxActiveWorkersAddr"
let RawSlabArenaListAddrName = b"__Raw.slabArenaListAddr"
let RawSlabArenaMapL1AddrName = b"__Raw.slabArenaMapL1Addr"
let RawSlabStateAddrName = b"__Raw.slabStateAddr"
let RawSlabSizeToClass8AddrName = b"__Raw.slabSizeToClass8Addr"
let RawSlabSizeToClass128AddrName = b"__Raw.slabSizeToClass128Addr"
let RawSlabClassGeomAddrName = b"__Raw.slabClassGeomAddr"
let RawDsBaseAddrName = b"__Raw.dsBaseAddr"
let RawDsAllocIdAddrName = b"__Raw.dsAllocIdAddr"
let RawTlsSlotLoadName = b"__Raw.tlsSlotLoad"
let RawLoadWordName = b"__Raw.loadWord"
let RawStoreWordName = b"__Raw.storeWord"
let RawLoadByteName = b"__Raw.loadByte"
let RawStoreByteName = b"__Raw.storeByte"
let RawAtomicAddWordName = b"__Raw.atomicAddWord"
let RawAtomicCasName = b"__Raw.atomicCas"
let RawMemFillName = b"__Raw.memFill"
let RawOsAllocPagesName = b"__Raw.osAllocPages"
let RawOsReservePagesName = b"__Raw.osReservePages"
let RawOsCommitPagesName = b"__Raw.osCommitPages"
let RawOsDecommitPagesName = b"__Raw.osDecommitPages"
let RawOsFreePagesName = b"__Raw.osFreePages"
let RawOsLockInitName = b"__Raw.osLockInit"
let RawOsLockEnterName = b"__Raw.osLockEnter"
let RawOsLockLeaveName = b"__Raw.osLockLeave"
let RawOwnFrameName = b"__Raw.ownFrame"
let RawSplicedAtEverySiteName = b"__Raw.splicedAtEverySite"

export enum RawIntrinsic
	osTickCountMs
	osReadWallClock
	osThreadCpuTicks
	osCpuCount
	osGetPid

	// ⭐ **THE ONE OS ROW THAT CHANGES THE PROCESS RATHER THAN REPORTING ON IT, AND IT STILL ANSWERS A
	// WORD.** A `void` set would leave a tier body nothing to return and a spec nothing to name, so the op
	// sets the priority and READS IT BACK; the word is the second reading. See
	// `StdOp.osEnterBackgroundPriority`, which owns that argument.
	osEnterBackgroundPriority

	// ⭐⭐ **THE TIER'S ONLY WAY OUT, AND IT IS AN EXIT RATHER THAN A PANIC.** A `panic` builds a message
	// and walks a stack, and both allocate — which the allocator cannot do while reporting that allocation
	// has failed. So a body that has established it cannot continue names a code and the process ends.
	//
	// ⚠ **IT ANSWERS NOTHING AND DOES NOT RETURN, AND THE BLOCK STILL NEEDS A TERMINATOR**, so a tier body
	// writes a `return` under it that never runs — the shape `RuntimeAbort.emitRuntimeAbort` emits one tier
	// down.
	osExit

	scratch

	// ⭐⭐ **A COMPILER-OWNED `.data` WORD IS ADDRESSED BY ITS OWN ROW, NOT BY A LABEL A BODY WRITES.** The
	// address of a runtime global is minted by the compiler and resolved by the linker, so a tier body has no
	// way to compute one; what it can do is name the word. A label ARGUMENT would put every global the emitted
	// runtime lays out within reach of a runtime file — a wider privilege than any other row grants, and wider
	// than any family needs — and would need a second closed roster beside this one to take it back. A row per
	// readable word keeps the roster closed by construction, and the lowering's exhaustive match is what makes
	// a row that exists name a LABEL. That the label is LAID OUT follows from the body surviving: a runtime
	// word is kept exactly where a function dead-function elimination keeps names it (`DataReach.walked`).
	schedNumProcsAddr
	schedMaxActiveWorkersAddr

	// The page layer's two words — the arena LIST head and the reverse map's L1 table pointer. Their zero
	// initializer IS the initial state rather than a default: `list == 0` means "no arena mapped yet" and
	// `map l1 == 0` means "nothing registered yet", and both are what the first call on each path tests for.
	// Each is laid out where a surviving arena body names it, so a body reading them never ships without its
	// slots.
	slabArenaListAddr
	slabArenaMapL1Addr

	// The object layer's one word — the base of the allocator's lazily committed state region, or zero.
	// `runtime/SlabRuntime.maxon`'s `__slab_state_base` is its only reader and its only writer, and the zero
	// IS the initial state rather than a default. `SlabRuntime.slabRuntimeGlobals` lays the slot out where
	// that body survives — so a surviving body cannot address a word the image omitted.
	slabStateAddr

	// ⭐⭐ **THE ALLOCATOR'S THREE `.rdata` TABLES — the two reverse size lookups and the packed class
	// geometry.** A ladder entry is a pure function of its index, so the tables are baked into the read-only
	// image by `SlabRuntime.installSlabRuntime` and a body needs their ADDRESS rather than their bytes.
	//
	// ⚠ **A BUILDER REGISTERS THEM AND A BODY NAMES THEM, AND ONE BIT DECIDES BOTH.** The registration sits
	// behind `usage.usesHeap`, and `LibraryFacts.withCompilerCalledTierUnreached` files every name of
	// `runtime/SlabRuntime.maxon` unreached on that same bit — so a program with no allocator registers no
	// table and lowers no body that could name one.
	slabSizeToClass8Addr
	slabSizeToClass128Addr
	slabClassGeomAddr

	// The DebugStream producer's two words — the ring BASE, whose zero IS "no monitor attached" and is what
	// every event site tests before it computes anything, and the allocation-id counter the monitor reads
	// events back by. `DebugStreamRuntime.debugStreamRuntimeGlobals` is in the data roster unconditionally
	// with `DataReach.walked`, so each is laid out wherever a surviving body names it — a traced build and an
	// untraced one alike.
	dsBaseAddr
	dsAllocIdAddr

	// ⭐⭐ **WHICH MACHINE AM I — the read every allocation and every free begins with.** The scheduler
	// publishes a TEB/TCB offset; this answers the word stored there for THIS OS thread. It is the one row in
	// the addressing band that names a host facility, because a lane with one thread has no per-thread
	// storage to read and a constant would hand every reader the same slot rather than answer the question.
	tlsSlotLoad

	loadWord
	storeWord

	// ⭐ **A BYTE IS NOT A NARROW WORD.** An allocator's bitmaps, headers and poison bytes are addressed one
	// byte at a time, and a masked `storeWord` writes the seven neighbours too — so the byte width is its own
	// pair of rows rather than something a body can build out of the word rows.
	loadByte
	storeByte

	// ⚠ **NEITHER ATOMIC TAKES AN OFFSET, AND THE TWO ANSWER IN OPPOSITE CONVENTIONS.** An atomic names ONE
	// word, so a caller addressing a field computes `addr + k` itself; `atomicAddWord` answers the PRIOR
	// value and `atomicCas` answers 1/0 SUCCESS. Both are `StdOp`'s own contracts — see `StdOp.atomicRmw`
	// and `StdOp.atomicCas` for why reversing either costs an instruction on both ISAs.
	atomicAddWord
	atomicCas

	// ⭐ **THE FILL IS A ROW BECAUSE WHAT IT BECOMES IS A SIZE LADDER**, and choosing an instruction sequence
	// by size is not something this floor can say. Its byte is the shape's CONSTANT position, which is what
	// lets the selector broadcast it into a 64-bit immediate at compile time.
	memFill

	// ⭐⭐ **FIVE PAGE ROWS, BECAUSE RESERVING ADDRESS SPACE AND BACKING IT ARE DIFFERENT QUESTIONS.**
	// `osAllocPages` does both at once and charges the process for the whole arena on the day it maps it;
	// the reserve/commit pair lets an arena be sized for the address space it wants while a small program
	// commits a fraction of it. `osDecommitPages` returns the backing and KEEPS the reservation, so the base
	// stays valid, where `osFreePages` returns both.
	//
	// ⛔ **`osCommitPages` DESTROYS THE CONTENTS OF THE RANGE ON THE THREE POSIX LANES**, where a commit is a
	// `MAP_FIXED` mapping that replaces whatever was there with fresh zeroed pages; Windows keeps every byte.
	// A caller may commit only a range it holds no data in.
	osAllocPages
	osReservePages
	osCommitPages
	osDecommitPages
	osFreePages

	// The lock is the REGION the caller set aside, not a handle the OS hands back: the host object behind it
	// differs in size and shape per platform, so each row takes an address and answers nothing.
	osLockInit
	osLockEnter
	osLockLeave

	// ⭐⭐ **THE ONE ROW THAT IS A DIRECTIVE RATHER THAN AN OPERATION.** It emits no instruction; it states
	// that the enclosing function's FRAME is its product, so nothing may splice the body away. A runtime
	// body whose whole contract is the call itself — a checkpoint a profile attaches to, a stack-walk entry
	// a backtrace prints — has no other way to say so, and every alternative keys the fact on a NAME the
	// compiler would have to remember instead of on the body that owns it.
	ownFrame

	// ⭐⭐ **`ownFrame`'s OPPOSITE, AND THE SECOND DIRECTIVE.** It states that this body has no frame worth
	// keeping: the inliner must splice it into every one of its call sites whatever its size, so a family
	// written as tier source is emitted the way a BUILDER emitted it — spliced inline at each site, with no
	// call, no frame and no `ret` around it.
	//
	// ⭐ **IT OVERRIDES THE COMPILER'S COST RULES AND NEVER A CORRECTNESS RULE.** The op budget, the
	// called-once pressure budget and the inline-frame-record rule are judgements about what inlining is
	// WORTH, and a body that says its whole existence depends on being spliced overrules them. The safe-point
	// provenance rule, a by-reference parameter, the green-thread stack guard and the
	// `isUnsupportedInInlineBody` roster are judgements about what inlining would BREAK, and each still
	// refuses — after which the promise cannot be kept and
	// `InlineLeaves.requireAlwaysSplicedBodiesAreGone` ends the compile naming the body. A row that degraded
	// quietly to a call would ship the family at the cost the port exists to remove, with nothing saying so.
	//
	// ⛔ Spelling it beside `ownFrame` is a contradiction and is refused at the declaration (E3157).
	splicedAtEverySite
end 'RawIntrinsic'

// ⭐ **EVERY ARGUMENT SHAPE A ROW CAN WEAR, ENUMERATED RATHER THAN DERIVED from an arity plus a per-position
// kind column.** A shape is what the parser's one reader switches on, and an (arity, kinds) pair would let
// a row state a combination no reader can build.
//
// A WORD position is an ordinary SSA value — an address, a handle, the word being stored. A CONSTANT
// position is a compile-time integer the emitted instruction CARRIES in place of an operand: a scratch
// record's size fixes a frame slot, a field offset is encoded in the addressing mode, and a fill byte is
// broadcast into an immediate, so none of the three can be a value computed at run time.
enum RawArgShape
	nothing
	oneWord
	twoWords
	threeWords
	oneConstant
	wordThenConstant
	wordConstantWord
	twoWordsThenConstant
end 'RawArgShape'

// What a row ANSWERS. `nothing` is a void intrinsic — legal as a statement and refused in value position,
// which is `emitVoidZeroArgIntrinsic`'s rule one family over.
export enum RawResultKind
	machineWord
	nothing
end 'RawResultKind'

// The roster's answer. Every case of a boxed union allocates, payload-free ones included — affordable here
// and nowhere hotter, because the roster is reached only behind `isRawIntrinsicCallee`, i.e. for a call
// whose callee already begins `__Raw.`.
union RawIntrinsicLookup
	absent
	found(intrinsic RawIntrinsic)
end 'RawIntrinsicLookup'

// Is this callee a member of the `__Raw` family? The membership question, asked by the three doors that
// must never disagree about it: the dispatch table in `Parser.parseCallNamed`, the STATEMENT door
// `Parser.qualifiedStaticCallsAt` — without which a `__Raw.storeWord(a, 0, v)` on a line of its own is not
// a statement at all — and the E3152 refusal.
export function isRawIntrinsicCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: RawQualifierPrefix)
end 'isRawIntrinsicCallee'

// THE roster — the one scan, read by the predicate and the accessor below and by nothing else.
function rawIntrinsicLookupOf(callee ByteArray) returns RawIntrinsicLookup
	if callee.equals(RawOsTickCountMsName) 'osTickCountMs'
		return RawIntrinsicLookup.found(RawIntrinsic.osTickCountMs)
	end 'osTickCountMs'

	if callee.equals(RawOsReadWallClockName) 'osReadWallClock'
		return RawIntrinsicLookup.found(RawIntrinsic.osReadWallClock)
	end 'osReadWallClock'

	if callee.equals(RawOsThreadCpuTicksName) 'osThreadCpuTicks'
		return RawIntrinsicLookup.found(RawIntrinsic.osThreadCpuTicks)
	end 'osThreadCpuTicks'

	if callee.equals(RawOsCpuCountName) 'osCpuCount'
		return RawIntrinsicLookup.found(RawIntrinsic.osCpuCount)
	end 'osCpuCount'

	if callee.equals(RawOsGetPidName) 'osGetPid'
		return RawIntrinsicLookup.found(RawIntrinsic.osGetPid)
	end 'osGetPid'

	if callee.equals(RawOsEnterBackgroundPriorityName) 'osEnterBackgroundPriority'
		return RawIntrinsicLookup.found(RawIntrinsic.osEnterBackgroundPriority)
	end 'osEnterBackgroundPriority'

	if callee.equals(RawOsExitName) 'osExit'
		return RawIntrinsicLookup.found(RawIntrinsic.osExit)
	end 'osExit'

	if callee.equals(RawScratchName) 'scratch'
		return RawIntrinsicLookup.found(RawIntrinsic.scratch)
	end 'scratch'

	if callee.equals(RawSchedNumProcsAddrName) 'schedNumProcsAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.schedNumProcsAddr)
	end 'schedNumProcsAddr'

	if callee.equals(RawSchedMaxActiveWorkersAddrName) 'schedMaxActiveWorkersAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.schedMaxActiveWorkersAddr)
	end 'schedMaxActiveWorkersAddr'

	if callee.equals(RawSlabArenaListAddrName) 'slabArenaListAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.slabArenaListAddr)
	end 'slabArenaListAddr'

	if callee.equals(RawSlabArenaMapL1AddrName) 'slabArenaMapL1Addr'
		return RawIntrinsicLookup.found(RawIntrinsic.slabArenaMapL1Addr)
	end 'slabArenaMapL1Addr'

	if callee.equals(RawSlabStateAddrName) 'slabStateAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.slabStateAddr)
	end 'slabStateAddr'

	if callee.equals(RawSlabSizeToClass8AddrName) 'slabSizeToClass8Addr'
		return RawIntrinsicLookup.found(RawIntrinsic.slabSizeToClass8Addr)
	end 'slabSizeToClass8Addr'

	if callee.equals(RawSlabSizeToClass128AddrName) 'slabSizeToClass128Addr'
		return RawIntrinsicLookup.found(RawIntrinsic.slabSizeToClass128Addr)
	end 'slabSizeToClass128Addr'

	if callee.equals(RawSlabClassGeomAddrName) 'slabClassGeomAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.slabClassGeomAddr)
	end 'slabClassGeomAddr'

	if callee.equals(RawDsBaseAddrName) 'dsBaseAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.dsBaseAddr)
	end 'dsBaseAddr'

	if callee.equals(RawDsAllocIdAddrName) 'dsAllocIdAddr'
		return RawIntrinsicLookup.found(RawIntrinsic.dsAllocIdAddr)
	end 'dsAllocIdAddr'

	if callee.equals(RawTlsSlotLoadName) 'tlsSlotLoad'
		return RawIntrinsicLookup.found(RawIntrinsic.tlsSlotLoad)
	end 'tlsSlotLoad'

	if callee.equals(RawLoadWordName) 'loadWord'
		return RawIntrinsicLookup.found(RawIntrinsic.loadWord)
	end 'loadWord'

	if callee.equals(RawStoreWordName) 'storeWord'
		return RawIntrinsicLookup.found(RawIntrinsic.storeWord)
	end 'storeWord'

	if callee.equals(RawLoadByteName) 'loadByte'
		return RawIntrinsicLookup.found(RawIntrinsic.loadByte)
	end 'loadByte'

	if callee.equals(RawStoreByteName) 'storeByte'
		return RawIntrinsicLookup.found(RawIntrinsic.storeByte)
	end 'storeByte'

	if callee.equals(RawAtomicAddWordName) 'atomicAddWord'
		return RawIntrinsicLookup.found(RawIntrinsic.atomicAddWord)
	end 'atomicAddWord'

	if callee.equals(RawAtomicCasName) 'atomicCas'
		return RawIntrinsicLookup.found(RawIntrinsic.atomicCas)
	end 'atomicCas'

	if callee.equals(RawMemFillName) 'memFill'
		return RawIntrinsicLookup.found(RawIntrinsic.memFill)
	end 'memFill'

	if callee.equals(RawOsAllocPagesName) 'osAllocPages'
		return RawIntrinsicLookup.found(RawIntrinsic.osAllocPages)
	end 'osAllocPages'

	if callee.equals(RawOsReservePagesName) 'osReservePages'
		return RawIntrinsicLookup.found(RawIntrinsic.osReservePages)
	end 'osReservePages'

	if callee.equals(RawOsCommitPagesName) 'osCommitPages'
		return RawIntrinsicLookup.found(RawIntrinsic.osCommitPages)
	end 'osCommitPages'

	if callee.equals(RawOsDecommitPagesName) 'osDecommitPages'
		return RawIntrinsicLookup.found(RawIntrinsic.osDecommitPages)
	end 'osDecommitPages'

	if callee.equals(RawOsFreePagesName) 'osFreePages'
		return RawIntrinsicLookup.found(RawIntrinsic.osFreePages)
	end 'osFreePages'

	if callee.equals(RawOsLockInitName) 'osLockInit'
		return RawIntrinsicLookup.found(RawIntrinsic.osLockInit)
	end 'osLockInit'

	if callee.equals(RawOsLockEnterName) 'osLockEnter'
		return RawIntrinsicLookup.found(RawIntrinsic.osLockEnter)
	end 'osLockEnter'

	if callee.equals(RawOsLockLeaveName) 'osLockLeave'
		return RawIntrinsicLookup.found(RawIntrinsic.osLockLeave)
	end 'osLockLeave'

	if callee.equals(RawOwnFrameName) 'ownFrame'
		return RawIntrinsicLookup.found(RawIntrinsic.ownFrame)
	end 'ownFrame'

	if callee.equals(RawSplicedAtEverySiteName) 'splicedAtEverySite'
		return RawIntrinsicLookup.found(RawIntrinsic.splicedAtEverySite)
	end 'splicedAtEverySite'

	return RawIntrinsicLookup.absent
end 'rawIntrinsicLookupOf'

// ⭐ Does the table carry this `__Raw.` member? The parser's dispatch gate: a member that is NOT listed is
// left to fall through to `emitCall`'s reserved-callee door, which answers the positioned E3004 that names
// it. The predicate and the accessor below read ONE roster, the `constIsKnown` / `constOf` discipline.
export function rawIntrinsicIsListed(callee ByteArray) returns bool
	match rawIntrinsicLookupOf(callee) 'row'
		found then return true
		absent then return false
	end 'row'
end 'rawIntrinsicIsListed'

// The row for a mangled callee. Only meaningful when `rawIntrinsicIsListed(callee)` — asking otherwise is
// a caller bug, and there is no row to answer with, so it panics rather than inventing one.
export function rawIntrinsicNamed(callee ByteArray) returns RawIntrinsic
	match rawIntrinsicLookupOf(callee) 'row'
		found(intrinsic) then return intrinsic
		absent then panic("rawIntrinsicNamed: '{String.from(callee)}' is not a listed __Raw intrinsic — guard the call with rawIntrinsicIsListed")
	end 'row'
end 'rawIntrinsicNamed'

// The mangled spelling of a row, for a diagnostic that must quote the intrinsic rather than the bytes at
// a call site the compiler itself may have minted.
export function rawIntrinsicCalleeName(intrinsic RawIntrinsic) returns ByteArray
	return match intrinsic 'name'
		osTickCountMs gives RawOsTickCountMsName
		osReadWallClock gives RawOsReadWallClockName
		osThreadCpuTicks gives RawOsThreadCpuTicksName
		osCpuCount gives RawOsCpuCountName
		osGetPid gives RawOsGetPidName
		osEnterBackgroundPriority gives RawOsEnterBackgroundPriorityName
		osExit gives RawOsExitName
		scratch gives RawScratchName
		schedNumProcsAddr gives RawSchedNumProcsAddrName
		schedMaxActiveWorkersAddr gives RawSchedMaxActiveWorkersAddrName
		slabArenaListAddr gives RawSlabArenaListAddrName
		slabArenaMapL1Addr gives RawSlabArenaMapL1AddrName
		slabStateAddr gives RawSlabStateAddrName
		slabSizeToClass8Addr gives RawSlabSizeToClass8AddrName
		slabSizeToClass128Addr gives RawSlabSizeToClass128AddrName
		slabClassGeomAddr gives RawSlabClassGeomAddrName
		dsBaseAddr gives RawDsBaseAddrName
		dsAllocIdAddr gives RawDsAllocIdAddrName
		tlsSlotLoad gives RawTlsSlotLoadName
		loadWord gives RawLoadWordName
		storeWord gives RawStoreWordName
		loadByte gives RawLoadByteName
		storeByte gives RawStoreByteName
		atomicAddWord gives RawAtomicAddWordName
		atomicCas gives RawAtomicCasName
		memFill gives RawMemFillName
		osAllocPages gives RawOsAllocPagesName
		osReservePages gives RawOsReservePagesName
		osCommitPages gives RawOsCommitPagesName
		osDecommitPages gives RawOsDecommitPagesName
		osFreePages gives RawOsFreePagesName
		osLockInit gives RawOsLockInitName
		osLockEnter gives RawOsLockEnterName
		osLockLeave gives RawOsLockLeaveName
		ownFrame gives RawOwnFrameName
		splicedAtEverySite gives RawSplicedAtEverySiteName
	end 'name'
end 'rawIntrinsicCalleeName'

export function rawArgShapeOf(intrinsic RawIntrinsic) returns RawArgShape
	return match intrinsic 'shape'
		osTickCountMs gives RawArgShape.nothing
		osReadWallClock gives RawArgShape.oneWord
		osThreadCpuTicks gives RawArgShape.twoWords
		osCpuCount or
			osGetPid or
			osEnterBackgroundPriority gives RawArgShape.nothing
		osExit gives RawArgShape.oneWord
		scratch gives RawArgShape.oneConstant
		schedNumProcsAddr or
			schedMaxActiveWorkersAddr or
			slabArenaListAddr or
			slabArenaMapL1Addr or
			slabStateAddr or
			slabSizeToClass8Addr or
			slabSizeToClass128Addr or
			slabClassGeomAddr or
			dsBaseAddr or
			dsAllocIdAddr gives RawArgShape.nothing
		tlsSlotLoad gives RawArgShape.oneWord
		loadWord or
			loadByte gives RawArgShape.wordThenConstant
		storeWord or
			storeByte gives RawArgShape.wordConstantWord
		atomicAddWord gives RawArgShape.twoWords
		atomicCas gives RawArgShape.threeWords
		memFill gives RawArgShape.twoWordsThenConstant
		osAllocPages or
			osReservePages or
			osLockInit or
			osLockEnter or
			osLockLeave gives RawArgShape.oneWord
		osCommitPages or
			osDecommitPages or
			osFreePages gives RawArgShape.twoWords
		ownFrame or
			splicedAtEverySite gives RawArgShape.nothing
	end 'shape'
end 'rawArgShapeOf'

export function rawResultKindOf(intrinsic RawIntrinsic) returns RawResultKind
	return match intrinsic 'result'
		osTickCountMs gives RawResultKind.machineWord
		osReadWallClock or
			osThreadCpuTicks or
			osExit gives RawResultKind.nothing
		osCpuCount or
			osGetPid or
			osEnterBackgroundPriority or
			scratch or
			schedNumProcsAddr or
			schedMaxActiveWorkersAddr or
			slabArenaListAddr or
			slabArenaMapL1Addr or
			slabStateAddr or
			slabSizeToClass8Addr or
			slabSizeToClass128Addr or
			slabClassGeomAddr or
			dsBaseAddr or
			dsAllocIdAddr or
			tlsSlotLoad or
			loadWord or
			loadByte or
			atomicAddWord or
			atomicCas or
			osAllocPages or
			osReservePages or
			osCommitPages gives RawResultKind.machineWord
		storeWord or
			storeByte or
			memFill or
			osDecommitPages or
			osFreePages or
			osLockInit or
			osLockEnter or
			osLockLeave or
			ownFrame or
			splicedAtEverySite gives RawResultKind.nothing
	end 'result'
end 'rawResultKindOf'

// How many arguments a shape is written with, and which position (if any) carries the compile-time
// constant. Both are derived from the shape rather than stated per row, so a row cannot declare an arity
// that contradicts the shape its arguments are read under.
export function rawArgCountOf(shape RawArgShape) returns ParamCount
	return match shape 'count'
		nothing gives 0 as ParamCount
		oneWord gives 1 as ParamCount
		oneConstant gives 1 as ParamCount
		twoWords gives 2 as ParamCount
		wordThenConstant gives 2 as ParamCount
		threeWords or
			wordConstantWord or
			twoWordsThenConstant gives 3 as ParamCount
	end 'count'
end 'rawArgCountOf'

// Is argument `position` of this shape the COMPILE-TIME CONSTANT one? Asked per argument by the parser's
// one reader, which is why it is a predicate over the pair rather than a position to compare against: a
// shape with no constant has no position for a caller to accidentally match.
export function rawArgumentIsTheConstant(shape RawArgShape, position ParamCount) returns bool
	return match shape 'position'
		nothing or
			oneWord or
			twoWords or
			threeWords gives false
		oneConstant gives position == 0
		wordThenConstant or
			wordConstantWord gives position == 1
		twoWordsThenConstant gives position == 2
	end 'position'
end 'rawArgumentIsTheConstant'

// ⭐⭐ **THE HOST FACILITY A ROW'S INSTRUCTION NEEDS.** It is the same question `TargetFacilities` answers
// for every runtime entry, asked of an op instead — every OS row names a facility that exists for exactly
// these Std ops.
//
// ⭐⭐ **IT REPORTS AT THE CROSSING, BECAUSE AN OP HAS NO CALLEE FOR A GATE TO MEET BY NAME.**
// `maxonOpCalleeKind` answers `noCallee`, so no door keyed on a callee can ever see one, and a gate placed
// at the op itself could never fire: a `__Raw` op stands only in a `runtime/` file, which is library source,
// and `SemanticCheck.blameTargetErrorsIn` is false there for the reason it is false for `stdlib/` — a
// diagnostic in a file the user never opened. So `StdlibSource.noteSubstrateRawIntrinsic` SEEDS the
// substrate fixpoint with the row's own mangled spelling, `TargetFacilities.calleeHostFacility` reads this
// column when that entry comes back, and `SemanticCheck.requireTargetSupportsCallee` answers E3104 at the
// first call from user code into the library body that reaches the op — in its own wording, naming the row
// rather than a runtime entry that does not exist.
//
// ⛔⛔ **ONE ROAD IS STILL UNREACHED BY THAT, AND ITS PROTECTION IS A BUILDER'S GATE RATHER THAN A
// DIAGNOSTIC: A TIER BODY WHOSE ONLY CALLER IS AN INSTALLER-MINTED `StdOp.call`.** The slab allocator is
// the family in that position — no Maxon call site crosses into it, so there is no crossing to report at.
// What keeps a lane from meeting an op it cannot lower there is that the installer forks on
// `TargetFacilities.machineModel` before it mints anything. ⇒ **A ROW SPELLED FROM SUCH A BODY OWES THAT
// FORK, and the row's facility column is the statement of which lanes the fork must exclude.**
//
// ⚠ **THREE ROWS NAME A FACILITY A SUPPORTED LANE DOES NOT PROVIDE AND ARE MET EARLIER BY A SECOND
// ROUTE.** `osCpuCount`, `osGetPid` and `osEnterBackgroundPriority` have no wasm lowering, and a program
// asking for one is refused at the call to `__cpu_count`, `__proc_pid` or `__proc_bg_priority` by
// `calleeHostFacility`'s CALLEE bands, which rank above a raw seed (`SemanticCheck.substrateEntryRank`) so
// the sharper sentence wins. `osThreadCpuTicks` is spelled by no REACHED tier body at all.
//
// ⚠ **`none` IS "NO HOST FACILITY", NOT "EVERY TARGET", AND ONE ROW IS STILL OUTSIDE WHAT THIS COLUMN CAN
// SAY.** The word and address rows are pure code generation on the lanes that have an addressable frame, and
// wasm is not one of them: a wasm local has no address, so `StdOp.stackRecordAddr` cannot be selected there
// at all. `__Raw.scratch` therefore answers `none` while a REACHED tier body spelling it would die in that
// backend — a MISSING FACILITY ROW (no `HostFacility` case names an addressable frame) rather than a wrong
// answer here.
union RawHostFacility
	none
	required(facility HostFacility)
end 'RawHostFacility'

export function rawHostFacilityOf(intrinsic RawIntrinsic) returns RawHostFacility
	return match intrinsic 'facility'
		osTickCountMs gives RawHostFacility.required(HostFacility.uptimeClock)
		osReadWallClock gives RawHostFacility.required(HostFacility.wallClock)
		osThreadCpuTicks gives RawHostFacility.required(HostFacility.threadCpuClock)
		osCpuCount gives RawHostFacility.required(HostFacility.cpuCount)
		osGetPid gives RawHostFacility.required(HostFacility.processInfo)
		osEnterBackgroundPriority gives RawHostFacility.required(HostFacility.processPriority)

		// Every supported lane lowers `StdOp.osExit` unconditionally — it is the floor under every `panic`
		// and every range check, so a target that could not end its own process could compile no program at
		// all. There is no facility to name and no lane to withhold it.
		osExit gives RawHostFacility.none

		osAllocPages or
			osReservePages or
			osCommitPages or
			osDecommitPages or
			osFreePages gives RawHostFacility.required(HostFacility.pageMemory)
		osLockInit or
			osLockEnter or
			osLockLeave gives RawHostFacility.required(HostFacility.hostMutex)
		tlsSlotLoad gives RawHostFacility.required(HostFacility.threadLocalSlot)
		scratch or
			schedNumProcsAddr or
			schedMaxActiveWorkersAddr or
			slabArenaListAddr or
			slabArenaMapL1Addr or
			slabStateAddr or
			slabSizeToClass8Addr or
			slabSizeToClass128Addr or
			slabClassGeomAddr or
			dsBaseAddr or
			dsAllocIdAddr or
			loadWord or
			storeWord or
			loadByte or
			storeByte or
			atomicAddWord or
			atomicCas or
			memFill or
			ownFrame or
			splicedAtEverySite gives RawHostFacility.none
	end 'facility'
end 'rawHostFacilityOf'
