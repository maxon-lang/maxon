// StorageProvenance — which roots a value may share a record with, and where a call stores what it was handed.
//
// A `return` retains a borrow rather than copying it, so a call's result may be a second reference to what
// its caller handed over: an argument, a receiver, a capture, a payload. A call may also STORE what it was
// handed — into another argument, into module storage, into its result — or BIND it to a mutable name. E3078
// and E3019 ask of a VALUE what the parser asks of a name it can see. One trace per function ranks its roots —
// its parameters (the summary's bit order) then module `var` storage, or its `let` bindings in declaration
// order, then the parameters, then writable storage — and each value carries a set per column over them:
//
// | set | the value may … the root's record | read by |
// |---|---|---|
// | `identity` | be | E3078, E3019, the parameter-mutation edges |
// | `inside` | lie within, read out of it | E3078 |
// | `placedWithin` | lie within, stored into it | the summary |
// | `holds` | contain, in a field no load can name | a load, whose `identity` it becomes |
// | `storedHolds` | contain, stored into it by this body (field-exact through `storeSlots`) | a load |
// | `deepHolds` | contain inside a record it contains | a load, whose `holds` it becomes |
// | `storedDeep` | contain inside, stored there through a record lying within it | the summary |
// | `holdsWithin` | contain a record lying within | a load, whose `inside` it becomes |
// | `shares` | overlap, at any depth | a caller, deciding whether a summary relates it to an argument |
//
// ⭐ **E3078 ASKS `identity` AND `inside`, NOT WHAT A VALUE HOLDS** — a `var` may not BE a `let`'s record or lie
// within one, which are the two shapes `Parser.requireMutableBindingSource` refuses by name (`var b = a`,
// `var i = o.inner`). A `var` that merely CONTAINS one is what `var t = (a, 1)` and a field store of a `let`
// already build without refusal, so a call that builds the same box answers the same.
//
// ⭐ **A READ OUT OF A `var`'S STORAGE MAY BE A `let`'S RECORD.** A store co-owns what it is handed, so a `let`
// stored into a `var`'s record or module `var` storage is still that `let`'s: a read out of such storage — a load,
// a call that may hand back what its argument holds — is what the storage holds, as a read out of any root is, and
// it also lies within the storage. A read out of a PARAMETER's record takes only what this body stored into that
// field (`storeSlots`): what the caller's record held is the caller's to judge, at its own doors, and a parameter's
// fields are rebound under the body's own reads (`let old = states` then `states = fresh`).
//
// ⭐ **A VALUE READ OUT OF A ROOT AND ONE STORED INTO IT BOTH LIE WITHIN IT, AND ONLY THE FIRST MAY BE WHAT
// ELSE IT HOLDS.** `inside` says the value came out of the root, so a call handing it back may hand back
// anything the root contains; `placedWithin` says it was put there, which is all it says — else a function
// that registers a record and returns it (`addBlock`) would return everything its registry holds.
//
// ⭐ **A STORE IS FIELD-EXACT FOR THE VALUE IT WENT INTO.** A store into `box` at offset k is filed under
// `(box, k)`, and a load of `box` at offset k reads exactly those — so writing a `let` into one field of a box
// does not make every other field of it that `let`. Only the value itself is exact: a name derived from it
// carries what was stored into it collapsed (`storedHolds`), since its fields are no longer the box's. A store
// a CALL makes names no field, so it lands in `holds`, which every load reads.
//
// ⭐ **CLOSED BY DEFAULT.** A value is fresh only where the ownership model says so
// (`IrFunction.valueMintedSole`), and a callee whose body was read answers through its summary — a witness
// dispatch, or a call through a function value, through the summary of every body it may land on. Every other
// op that defines a value — a runtime entry, an op added later — may be any record reachable from its operands
// (`maxonOpOperandValues`), and a call with no summary may store what it was handed wherever
// `runtimeCalleeStoreShape` does not rule out. A new door is refused until proven fresh, never the reverse.
//
// ⭐ **WHAT A SET CANNOT TYPE, THE TYPES DO.** A root set collapses fields and depths, so a door asks it only of
// roots the value's type admits: a record of another type is not the root's own (`valuesMayBeOneRecord`), and
// one of a kind the root's type cannot hold does not lie within it (`ProgramSignatures.recordKindsWithinAggregate`).
//
// ⚠ **ONE SET PER VALUE FOR THE WHOLE BODY, SO THE DOORS ARE FLOW-INSENSITIVE**: a `var` is refused if its
// value may be a `let`'s record anywhere in the body, before the `let` is declared as well as after it.

typealias RootRank = int(0 to u64.max)
typealias MaskWordCount = int(0 to u64.max)
typealias MaskWordCountArray = Array with MaskWordCount

// One root set of a walk, and one nonzero word of one (`RootSets`).
typealias RootSetId = int(0 to u64.max)
typealias RootChunk = int(0 to u64.max)
typealias RootChunkArray = Array with RootChunk

// Chunk 0 is the pool's placeholder and never a set's word, so a link to it ends a set.
let NoRootChunk = 0 as RootChunk

// A store's field, as one key: the address value in the high word, the byte offset in the low one.
typealias StoreSlotKey = int(0 to u64.max)
typealias StoreSlotKeyArray = Array with StoreSlotKey

// ⭐ **ONE INDEX FOR EVERY WALK, EACH ENTRY STAMPED WITH THE WALK THAT FILED IT** — the walk in the high word, its
// set in the low one — so a walk starts with none of the last walk's slots without a new map: an entry stamped
// with another walk is none of this one's.
typealias StampedStoreSlot = int(0 to u64.max)
typealias StoreSlotIndex = Map with (StoreSlotKey, StampedStoreSlot)
typealias StoreSlotWalk = int(0 to u32.max)

let StoreSlotWalkShift = 32 as StampedStoreSlot
let StoreSlotSetMask = u32.max as StampedStoreSlot

// No slot of the walk being traced: a stamp no walk carries, and no set.
let NoStampedStoreSlot = 0 as StampedStoreSlot
let NoStoreSlotSet = i64.max as RootSetId

// Whether a `named` type holds a record, by its interned name — asked of every value of every walk — and
// whether a container instance can, by its instance — asked of every operand of every call with no summary.
typealias NamedTypeRecordMemo = Map with (TypeNameId, bool)
typealias InstanceRecordMemo = Map with (GenericInstanceId, bool)

// Whether a record of a `named` type holds nothing a statement can write — asked of every door the freeze on a
// lent graph considers, and answered by a walk over the whole field graph.
typealias WriteFreeGraphMemo = Map with (TypeNameId, bool)

// One op's place in its body's control flow as ONE key — the block in the high bits, the position within it in the
// low ones. Packed rather than a `FlowPoint`, so indexing a body allocates nothing per op.
typealias FlowPointKey = int(0 to u64.max)
typealias FlowPointByOp = Map with (OpIndex, FlowPointKey)

let FlowPointBlockShift = 32 as FlowPointKey
let FlowPointPositionMask = 4294967295 as FlowPointKey

// What may lie within a record of an aggregate or an instance — asked of every immutable root of every walk
// (`ProgramSignatures.recordKindsWithinAggregate`).
typealias AggregateRecordKindsMemo = Map with (ByteArray, HeldRecordKinds)
typealias InstanceRecordKindsMemo = Map with (GenericInstanceId, HeldRecordKinds)
typealias HeldRecordKindsArray = Array with HeldRecordKinds

// The bodies one witness slot can land on, by `(interfaceDeclIndex, methodIndex)` — a whole-program fact asked
// at every dispatch of every walk, and `witnessDispatchImpls` builds it from scratch.
typealias WitnessSlotKey = int(0 to u64.max)
typealias WitnessImplsMemo = Map with (WitnessSlotKey, CallLandingBodies)

// The bodies a call through a function value can land on, by how many arguments it passes
// (`functionValueBodiesFor`).
typealias FunctionValueBodiesMemo = Map with (ParamCount, CallLandingBodies)

// One mask per parameter of a function: which of its parameters its body stores into that one's record.
typealias ParamMaskRows = Array with ParamPositionMaskArray

typealias RootRankArray = Array with RootRank
// Positions into another column: its entries, or the start of each group of them.
typealias EntryIndexArray = Array with ElementIndex

// One step of an access path: the byte offset of a field read, or `ElementAccessStep` for an element of a
// container.
typealias AccessStep = int(0 to u64.max)
typealias AccessStepArray = Array with AccessStep

let ElementAccessStep = i64.max as AccessStep
let NoAccessStep = 0 as AccessStep
let MaxAccessPathSteps = 32 as ElementIndex

// The op that defines no value, and the block that merges none.
let NoDefiningOp = i64.max as OpIndex
let NoMergingBlock = i64.max as BlockId

typealias HygieneIndexByPosition = Map with (PositionKey, ElementIndex)
typealias HygieneIndexArray = Array with ElementIndex
typealias MoveSiteIndexArray = Array with ElementIndex

// The token a root is taken to be moved at when no door moved it: past every token of any body. A door asking
// about every root, moved or not, asks before the first token.
let NeverMovedToken = i64.max as TokenIndex
let AskAboutEveryRoot = 0 as TokenIndex

// One refusal a door made, held until the function's doors have all asked so they report in source order.
type PendingRefusal
	export let at as PositionKey
	export let line as LineNumber
	export let column as ColumnNumber
	export let code as ErrorCode
	export let message as String

	export static function create(line LineNumber, column ColumnNumber, code ErrorCode, message String) returns PendingRefusal
		return Self{at: positionKey(line, column: column), line: line, column: column, code: code, message: message}
	end 'create'
end 'PendingRefusal'

typealias PendingRefusalArray = Array with PendingRefusal

// One door a value passes in a body the freeze on a lent graph asks about (`ProvenanceTracer.freezeDoorsOf`):
// the parser's, a receiver a container method writes, or an argument its callee keeps or writes. `callee` is the
// callee's spelling in the sentence, empty for a door no callee owns; `point` is where the door stands in the
// body's control flow and `token` orders two doors standing at one point.
type FreezeDoorAt
	export let value as ValueId
	export let door as FreezeDoor
	export let callee as String
	export let line as LineNumber
	export let column as ColumnNumber
	export let token as TokenIndex
	export let point as FlowPoint

	export static function create(value ValueId, door FreezeDoor, callee String, line LineNumber, column ColumnNumber, token TokenIndex, point FlowPoint) returns FreezeDoorAt
		return Self{value: value, door: door, callee: callee, line: line, column: column, token: token, point: point}
	end 'create'
end 'FreezeDoorAt'

typealias FreezeDoorAtArray = Array with FreezeDoorAt

// Where a lent binding is bound to a record again, from which point a door reaches a DIFFERENT record than the one
// the send lent: a `let` bound inside a loop is a fresh graph on every trip.
union Rebinding
	never
	at(point FlowPoint)
end 'Rebinding'

typealias RebindingArray = Array with Rebinding

// Where a message's lent parameter first escapes, or that it stays in the handler.
union HandlerEscape
	stays
	at(door FreezeDoorAt, filePath FilePath)
end 'HandlerEscape'

// A lent (handler, parameter) pair as one key: the handler's function index in the high bits, the parameter in the
// low ones.
typealias HandlerParamKey = int(0 to u64.max)
typealias HandlerEscapeMemo = Map with (HandlerParamKey, HandlerEscape)

let HandlerParamKeyShift = 16 as HandlerParamKey

function handlerParamKey(index FuncIndex, param ParamCount) returns HandlerParamKey
	return ((index as HandlerParamKey) shl HandlerParamKeyShift) or (param as HandlerParamKey)
end 'handlerParamKey'

// The handler a lend's message runs, and the position of its lent parameter.
type LentHandler
	export let name as ByteArray
	export let index as FuncIndex
	export let param as ParamCount

	export static function create(name ByteArray, index FuncIndex, param ParamCount) returns LentHandler
		return Self{name: name, index: index, param: param}
	end 'create'
end 'LentHandler'

// No frozen lend a door breaks, and a position past every source position.
let NoFrozenLend = i64.max as ElementIndex
let NoPositionKey = i64.max as PositionKey

let WitnessSlotKeyShift = 16 as WitnessSlotKey

let StoreSlotValueShift = 32 as StoreSlotKey

// A container mutator stores into its first operand, and an interior insertion's second operand is the node
// it inserts beside, which it only reads (`RuntimeStoreShape`).
let RuntimeStoreReceiverIndex = 0 as ParamCount
let RuntimeStoreAnchorIndex = 1 as ParamCount

// A mask word holds 64 roots: rank `r` is bit `r and RootBitIndexMask` of word `r shr RootWordShift`.
let RootWordShift = 6 as RootRank
let RootBitIndexMask = 63 as RootRank

// A PARAMETER trace ranks only the parameters, which fill word 0 — the summary's own bit order — so module
// `var` storage takes the first rank past them: no parameter bit can collide with it, and `storeIntoRoot`
// routes a store through it to the escaped set.
let ParameterTraceWritableRank = RootBitIndexMask + 1

// The row of a function whose body stores no parameter into another. Shared and never mutated: a widening
// REPLACES a function's row before writing it. A `var`, because a row read back to be widened may be this one.
var NoStoredParameters = ParamPositionMaskArray.create()

// The sets each value carries, one root set apiece — see the table above.
enum ProvenanceColumn
	shares
	identity
	holds
	storedHolds
	deepHolds
	storedDeep
	inside
	placedWithin
	holdsWithin
end 'ProvenanceColumn'

// What one trace of a function found, in the summary's bit order — the row `ProvenanceSummary.widen` ORs in.
type TracedSummaryRow
	export var shares as ParamPositionMask = NoParamPositions
	export var identity as ParamPositionMask = NoParamPositions
	export var holds as ParamPositionMask = NoParamPositions
	export var inside as ParamPositionMask = NoParamPositions
	export var holdsWithin as ParamPositionMask = NoParamPositions
	export var placedWithin as ParamPositionMask = NoParamPositions
	export var escapes as ParamPositionMask = NoParamPositions
	export var binds as ParamPositionMask = NoParamPositions
	export var stores as ParamPositionMaskArray = ParamPositionMaskArray.create()
	export var deepStores as ParamPositionMaskArray = ParamPositionMaskArray.create()

	static function create() returns TracedSummaryRow
		return Self{}
	end 'create'
end 'TracedSummaryRow'

// ⭐ **A ROOT SET HOLDS ONLY ITS NONZERO WORDS.** An immutable-binding trace ranks every `let` of the function,
// so a dense mask per value would cost values × lets / 64 words — quadratic in one function's size, and nearly
// all of them zero, since a value reaches the few `let`s it was built from. A set here is a list of its nonzero
// words in ascending word order, pooled across every set of one walk, so a walk costs what its sets hold.
type RootSets
	var heads as RootChunkArray
	var words as ParamPositionMaskArray
	var wordIndices as MaskWordCountArray
	var links as RootChunkArray
	var grew as bool

	static function create() returns RootSets
		return Self{heads: RootChunkArray.create(), words: ParamPositionMaskArray.create(), wordIndices: MaskWordCountArray.create(), links: RootChunkArray.create(), grew: false}
	end 'create'

	// `setCount` empty sets, and nothing else: the pool keeps its storage, never its chunks.
	function reset(setCount RootSetId)
		self.heads.refill(setCount as ElementIndex, value: NoRootChunk)
		self.words.clear()
		self.wordIndices.clear()
		self.links.clear()
		self.words.push(NoParamPositions)
		self.wordIndices.push(0)
		self.links.push(NoRootChunk)
	end 'reset'

	function addSet() returns RootSetId
		self.heads.push(NoRootChunk)
		return (self.heads.count() - 1) as RootSetId
	end 'addSet'

	function first(set RootSetId) returns RootChunk
		return try self.heads.get(set) otherwise panic("RootSets.first: set {set} is past the {self.heads.count()} sets of this walk")
	end 'first'

	function next(chunk RootChunk) returns RootChunk
		return try self.links.get(chunk) otherwise panic("RootSets.next: chunk {chunk} is past the pool")
	end 'next'

	function wordOf(chunk RootChunk) returns ParamPositionMask
		return try self.words.get(chunk) otherwise panic("RootSets.wordOf: chunk {chunk} is past the pool")
	end 'wordOf'

	function indexOf(chunk RootChunk) returns MaskWordCount
		return try self.wordIndices.get(chunk) otherwise panic("RootSets.indexOf: chunk {chunk} is past the pool")
	end 'indexOf'

	function wordAt(set RootSetId, word MaskWordCount) returns ParamPositionMask
		var chunk = self.first(set)

		while chunk != NoRootChunk and self.indexOf(chunk) < word 'toTheWord'
			chunk = self.next(chunk)
		end 'toTheWord'

		if chunk != NoRootChunk and self.indexOf(chunk) == word 'present'
			return self.wordOf(chunk)
		end 'present'

		return NoParamPositions
	end 'wordAt'

	function hasRank(set RootSetId, rank RootRank) returns bool
		return maskHasParam(self.wordAt(set, word: (rank shr RootWordShift) as MaskWordCount), param: (rank and RootBitIndexMask) as ParamCount)
	end 'hasRank'

	function addRank(set RootSetId, rank RootRank)
		_ = self.orWordFrom(set, from: NoRootChunk, index: (rank shr RootWordShift) as MaskWordCount, word: maskWithParam(NoParamPositions, param: (rank and RootBitIndexMask) as ParamCount))
	end 'addRank'

	// `to` gains every root `from` holds, in one ascending pass over both. True iff `to` grew.
	function union(to RootSetId, from RootSetId) returns bool
		self.grew = false

		if to == from 'itself'
			return false
		end 'itself'

		var at = NoRootChunk
		var source = self.first(from)

		while source != NoRootChunk 'eachSourceWord'
			at = self.orWordFrom(to, from: at, index: self.indexOf(source), word: self.wordOf(source))
			source = self.next(source)
		end 'eachSourceWord'

		return self.grew
	end 'union'

	// OR a nonzero `word` into `set`'s word `index`, minting that word in order when the set has none, and
	// searching from past `from` — a chunk of `set` below `index`, or `NoRootChunk` for the head — so a caller
	// adding ascending indices resumes where the last one stopped. Answers the chunk that holds `index`.
	function orWordFrom(set RootSetId, from RootChunk, index MaskWordCount, word ParamPositionMask) returns RootChunk
		var before = from
		var cursor = self.first(set) if from == NoRootChunk else self.next(from)

		while cursor != NoRootChunk and self.indexOf(cursor) < index 'toTheWord'
			before = cursor
			cursor = self.next(cursor)
		end 'toTheWord'

		if cursor != NoRootChunk and self.indexOf(cursor) == index 'present'
			let held = self.wordOf(cursor)

			if (held or word) != held 'widens'
				try self.words.set(cursor, value: held or word) otherwise panic("RootSets.orWordFrom: words.set OOB at chunk {cursor}")
				self.grew = true
			end 'widens'

			return cursor
		end 'present'

		let minted = self.links.count() as RootChunk
		self.words.push(word)
		self.wordIndices.push(index)
		self.links.push(cursor)

		if before == NoRootChunk 'atTheHead'
			try self.heads.set(set, value: minted) otherwise panic("RootSets.orWordFrom: heads.set OOB at set {set}")
		end 'atTheHead' else 'afterAWord'
			try self.links.set(before, value: minted) otherwise panic("RootSets.orWordFrom: links.set OOB at chunk {before}")
		end 'afterAWord'

		self.grew = true
		return minted
	end 'orWordFrom'
end 'RootSets'

// What each function's RESULT is to its own parameters, by function index, and where its body STORES them:
// into a field of another parameter's record (`storesInto`, one mask per receiving parameter), deeper inside
// it (`storesDeep`), into module storage (`escapes`) — and which it BINDS to a mutable name that outlives the
// call, a module `var` or a by-reference parameter's cell (`binds`).
module type ProvenanceSummary
	var shares as ParamPositionMaskArray
	var identity as ParamPositionMaskArray
	var holds as ParamPositionMaskArray
	var inside as ParamPositionMaskArray
	var holdsWithin as ParamPositionMaskArray
	var placedWithin as ParamPositionMaskArray
	var escapes as ParamPositionMaskArray
	var binds as ParamPositionMaskArray
	var storesInto as ParamMaskRows
	var storesDeep as ParamMaskRows

	export static function create(funcCount FuncIndex) returns ProvenanceSummary
		return Self{shares: emptySummaryColumn(funcCount), identity: emptySummaryColumn(funcCount), holds: emptySummaryColumn(funcCount), inside: emptySummaryColumn(funcCount), holdsWithin: emptySummaryColumn(funcCount), placedWithin: emptySummaryColumn(funcCount), escapes: emptySummaryColumn(funcCount), binds: emptySummaryColumn(funcCount), storesInto: emptyStoreRows(funcCount), storesDeep: emptyStoreRows(funcCount)}
	end 'create'

	export function sharesAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.shares, index: index)
	end 'sharesAt'

	export function identityAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.identity, index: index)
	end 'identityAt'

	export function holdsAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.holds, index: index)
	end 'holdsAt'

	export function insideAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.inside, index: index)
	end 'insideAt'

	export function holdsWithinAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.holdsWithin, index: index)
	end 'holdsWithinAt'

	export function placedWithinAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.placedWithin, index: index)
	end 'placedWithinAt'

	export function escapesAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.escapes, index: index)
	end 'escapesAt'

	export function bindsAt(index FuncIndex) returns ParamPositionMask
		return summaryMaskAt(self.binds, index: index)
	end 'bindsAt'

	// The parameters function `index` stores into a field of parameter `into`'s record.
	export function storesAt(index FuncIndex, into ParamCount) returns ParamPositionMask
		return storeRowMaskAt(self.storesInto, index: index, into: into)
	end 'storesAt'

	// The parameters function `index` stores deeper inside parameter `into`'s record.
	export function storesDeepAt(index FuncIndex, into ParamCount) returns ParamPositionMask
		return storeRowMaskAt(self.storesDeep, index: index, into: into)
	end 'storesDeepAt'

	// Widen function `index` by what one trace of it found. True iff a mask grew — the only event that can
	// change a caller's answer.
	export function widen(index FuncIndex, row TracedSummaryRow) returns bool
		var grew = widenSummaryColumn(self.shares, index: index, by: row.shares)
		grew = widenSummaryColumn(self.identity, index: index, by: row.identity) or grew
		grew = widenSummaryColumn(self.holds, index: index, by: row.holds) or grew
		grew = widenSummaryColumn(self.inside, index: index, by: row.inside) or grew
		grew = widenSummaryColumn(self.holdsWithin, index: index, by: row.holdsWithin) or grew
		grew = widenSummaryColumn(self.placedWithin, index: index, by: row.placedWithin) or grew
		grew = widenSummaryColumn(self.escapes, index: index, by: row.escapes) or grew
		grew = widenSummaryColumn(self.binds, index: index, by: row.binds) or grew
		grew = widenStoreRow(self.storesInto, index: index, by: row.stores) or grew
		return widenStoreRow(self.storesDeep, index: index, by: row.deepStores) or grew
	end 'widen'
end 'ProvenanceSummary'

function emptyStoreRows(funcCount FuncIndex) returns ParamMaskRows
	var rows = ParamMaskRows.create()
	rows.refill(funcCount as ElementIndex, value: NoStoredParameters)
	return rows
end 'emptyStoreRows'

// A row shorter than `into` is one no store has reached that far along.
function storeRowMaskAt(rows ParamMaskRows, index FuncIndex, into ParamCount) returns ParamPositionMask
	let row = try rows.get(index) otherwise panic("ProvenanceSummary: function index {index} is outside the store rows — they are built over `funcNames.functions`")
	return try row.get(into) otherwise NoParamPositions
end 'storeRowMaskAt'

function widenStoreRow(rows ParamMaskRows, index FuncIndex, by ParamPositionMaskArray) returns bool
	var row = try rows.get(index) otherwise panic("widenStoreRow: function index {index} is outside the store rows — they are built over `funcNames.functions`")
	var grew = false

	for into in 0 upto by.count() 'eachReceivingParameter'
		let stored = try by.get(into) otherwise panic("widenStoreRow: by.get OOB at {into}")

		if stored == NoParamPositions 'nothingStoredHere'
			continue
		end 'nothingStoredHere'

		if row is NoStoredParameters 'firstStore'
			row = ParamPositionMaskArray.create()
			row.refill(by.count(), value: NoParamPositions)
			try rows.set(index, value: row) otherwise panic("widenStoreRow: rows.set OOB at {index}")
		end 'firstStore'

		let before = try row.get(into) otherwise panic("widenStoreRow: row of function {index} is shorter than its {by.count()} parameters")

		if (before or stored) != before 'widens'
			try row.set(into, value: before or stored) otherwise panic("widenStoreRow: row.set OOB at {into}")
			grew = true
		end 'widens'
	end 'eachReceivingParameter'

	return grew
end 'widenStoreRow'

function emptySummaryColumn(funcCount FuncIndex) returns ParamPositionMaskArray
	var column = ParamPositionMaskArray.create()
	column.refill(funcCount as ElementIndex, value: NoParamPositions)
	return column
end 'emptySummaryColumn'

function summaryMaskAt(column ParamPositionMaskArray, index FuncIndex) returns ParamPositionMask
	return try column.get(index) otherwise panic("ProvenanceSummary: function index {index} is outside the column — it is built over `funcNames.functions`")
end 'summaryMaskAt'

function widenSummaryColumn(column ParamPositionMaskArray, index FuncIndex, by ParamPositionMask) returns bool
	let before = summaryMaskAt(column, index: index)
	let after = before or by

	if after == before 'nothingNew'
		return false
	end 'nothingNew'

	try column.set(index, value: after) otherwise panic("ProvenanceSummary.widen: set OOB at {index}")
	return true
end 'widenSummaryColumn'

// ⭐ **THE SUMMARY IS A LEAST FIXPOINT OVER THE CALL GRAPH**, for `buildParamMutationSummary`'s reason: a
// callee may be declared after its caller, or be it. Every function with a parameter that can hold a record is
// traced once, recording the callees it consulted; then the callers of every function whose masks grew are
// traced again until nothing grows. Masks only gain bits, so the re-traces are bounded by the call edges times
// the mask width.
//
// ⭐ **A CALLER IS RE-TRACED ONLY WHILE STALE** — while a summary it consults has grown since its last trace
// began. Its dependency rows repeat per call site and per pass of its walk, and a trace whose every input is
// as it last read them answers the masks it already widened by, so skipping it leaves every summary exactly
// as tracing it would.
module function buildStorageProvenance(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex) returns ProvenanceTracer
	let funcCount = funcNames.functions.count()
	var tracer = ProvenanceTracer.create(project, module: module, signatures: signatures, funcIndexByName: funcNames.byName, funcCount: funcCount)
	var worklist = FuncIndexArray.create()
	var queued = BoolArray.create()

	for i in 0 upto funcCount 'firstTrace'
		let func = try funcNames.functions.get(i) otherwise panic("buildStorageProvenance: functions.get OOB at {i} below its own count")
		queued.push(false)

		if not tracer.anyParameterHoldsARecord(func) 'nothingOfItsOwnToHandOn'
			continue
		end 'nothingOfItsOwnToHandOn'

		tracer.recordDependenciesOf(i)
		tracer.traceParameters(func)

		if tracer.widenSummary(i) 'grew'
			worklist.push(i)
			try queued.set(i, value: true) otherwise panic("buildStorageProvenance: queued.set OOB at {i} — pushed one per function above")
		end 'grew'
	end 'firstTrace'

	let callersByCallee = buildCsr(tracer.dependencyCallees, to: tracer.dependencyCallers, nodeCount: funcCount)
	var stale = BoolArray.create()
	stale.refill(funcCount as ElementIndex, value: false)

	// The first pass traced in index order and widened each function straight after its own trace, so a
	// callee that grew there is news to exactly the callers at or below its index.
	for calleeIndex in worklist 'eachFirstPassGrowth'
		markCallersStale(callersByCallee, calleeIndex: calleeIndex, through: calleeIndex, stale: stale)
	end 'eachFirstPassGrowth'

	var head = 0 as CsrIndex

	while head < worklist.count() 'drain'
		let calleeIndex = try worklist.get(head) otherwise panic("buildStorageProvenance: worklist.get OOB at {head}")
		head = head + 1
		try queued.set(calleeIndex, value: false) otherwise panic("buildStorageProvenance: queued.set OOB at {calleeIndex}")

		for k in 0 upto callersByCallee.degree(calleeIndex as CsrIndex) 'eachCaller'
			let callerIndex = callersByCallee.neighbour(calleeIndex as CsrIndex, k: k) as FuncIndex

			if not (try stale.get(callerIndex) otherwise panic("buildStorageProvenance: stale.get OOB at {callerIndex}")) 'readsNothingNew'
				continue
			end 'readsNothingNew'

			try stale.set(callerIndex, value: false) otherwise panic("buildStorageProvenance: stale.set OOB at {callerIndex}")
			tracer.traceParameters(try funcNames.functions.get(callerIndex) otherwise panic("buildStorageProvenance: functions.get OOB at caller {callerIndex}"))

			if not tracer.widenSummary(callerIndex) 'nothingGrew'
				continue
			end 'nothingGrew'

			markCallersStale(callersByCallee, calleeIndex: callerIndex, through: funcCount, stale: stale)

			if not (try queued.get(callerIndex) otherwise panic("buildStorageProvenance: queued.get OOB at {callerIndex}")) 'callersMustLookAgain'
				worklist.push(callerIndex)
				try queued.set(callerIndex, value: true) otherwise panic("buildStorageProvenance: queued.set OOB at {callerIndex}")
			end 'callersMustLookAgain'
		end 'eachCaller'
	end 'drain'

	return tracer
end 'buildStorageProvenance'

// Every caller of `calleeIndex` at or below index `through` now reads a summary that grew after it was traced.
function markCallersStale(callersByCallee CsrGraph, calleeIndex FuncIndex, through FuncIndex, stale BoolArray)
	for k in 0 upto callersByCallee.degree(calleeIndex as CsrIndex) 'eachCaller'
		let callerIndex = callersByCallee.neighbour(calleeIndex as CsrIndex, k: k) as FuncIndex

		if callerIndex <= through 'tracedBeforeTheGrowth'
			try stale.set(callerIndex, value: true) otherwise panic("markCallersStale: stale.set OOB at {callerIndex}")
		end 'tracedBeforeTheGrowth'
	end 'eachCaller'
end 'markCallersStale'

// ⭐ **ONE FUNCTION'S PROVENANCE WALK, and the scratch it reuses across every function it walks.** Each value
// holds one root set per `ProvenanceColumn`, one bit per root; a walk iterates the body until no set grows,
// which a loop's back edge needs and a straight-line body settles in one extra pass.
module type ProvenanceTracer
	var project as Project
	var module as MaxonModule
	var signatures as ProgramSignatures
	var funcIndexByName as FuncIndexByName
	var conformers as ConformersByInterface
	var witnessSlots as WitnessSlotsByDeclIndex
	var witnessImpls as WitnessImplsMemo

	// Every body a `functionRef` names, gathered at the first call through a function value.
	var functionRefBodies as CallLandingBodies
	var functionRefBodiesGathered as bool
	var functionValueBodies as FunctionValueBodiesMemo
	var summary as ProvenanceSummary

	// Value `v`'s set in column `c` is `c.ordinal * setsPerColumn + v`, one per value; a store slot's set
	// follows them. `columnCount` is read once, because `allCases` builds an array at every read.
	var sets as RootSets
	var columnCount as RootSetId
	var setsPerColumn as RootSetId

	// What each `(address, offset)` was handed, and what was stored inside the record a load of it yields
	// (`deepSlots`, keyed by the load's own `(address, offset)`, which `loadOrigins` keeps per loaded value).
	var storeSlots as StoreSlotIndex
	var deepSlots as StoreSlotIndex
	var storeSlotWalk as StoreSlotWalk
	var loadOrigins as StoreSlotKeyArray
	var hasLoadOrigin as BoolArray
	var tracked as BoolArray
	var namedTypeHoldsARecord as NamedTypeRecordMemo
	var instanceHoldsARecord as InstanceRecordMemo
	var notARootValue as BoolArray
	var rootValues as ValueIdArray

	// The `let` bindings' names, by rank: an immutable-binding trace ranks them first, so a rank is a binding's
	// exactly when it is below this column's count. The parameters follow them there, then writable storage.
	var rootNames as ByteArrayArray

	// By rank, the kinds of record that may lie within a root's record — a binding's or a parameter's.
	var rootRecordKinds as HeldRecordKindsArray
	var recordKindsByAggregate as AggregateRecordKindsMemo
	var recordKindsByInstance as InstanceRecordKindsMemo
	var noRecordKinds as HeldRecordKinds
	var anyRecordKinds as HeldRecordKinds
	var rootRankOfValue as RootRankArray
	var tracingImmutableBindings as bool
	var writableRank as RootRank

	// Which values a `var` binding holds: the door that bound it (E3078) answers for a write through one, so
	// E3019 leaves it alone.
	var isWritableValue as BoolArray

	// By rank, for an immutable-binding trace: whether a binding root is a module-level `let`, whether a second
	// `let` names its very value, its binding record and declaration token, how far it stays live
	// (`liveUntilOf`), whether its record is its own (`soleBase`), and the earliest door that moved it.
	var rootIsModuleLet as BoolArray
	var rootIsImage as BoolArray
	var rootIsImmutableRecord as BoolArray

	// The last use of each root through a second name for its record (`let u = t`), which keeps it live as its own does.
	var rootAliasLastUse as TokenIndexArray
	var rootBorrows as BoolArray
	var rootAliased as BoolArray
	var rootInfos as VarInfoArray
	var rootDeclTokens as TokenIndexArray
	var rootLiveUntil as TokenIndexArray
	var rootSoleBase as BoolArray
	var rootMovedAt as TokenIndexArray

	// By rank, whether a closure literal captured the binding: the closure reads it wherever it is called.
	var rootCaptured as BoolArray

	// By value, the rank of a `var`'s own record in an immutable-binding trace — one each, so two reads out of one
	// `var` can be told to lie within the same storage (E3078 while a borrow is live, E3159).
	var writableRankOfValue as RootRankArray
	var firstWritableValueRank as RootRank

	// By word, the ranks that are storage something may write: every `var`'s record, module `var` storage and a
	// parameter the body writes. A `let` whose record lies within one is a borrow of mutable storage.
	var mutablePlaceWords as ParamPositionMaskArray

	// By word, the ranks of an immutable-binding trace that are parameters.
	var parameterRankWords as ParamPositionMaskArray

	// ⭐ **THE DOOR BEING ASKED ABOUT** (`askAtDoor`). A root counts there when no door moved it by
	// `askedBeforeToken`, when it is live at or after `liveAfterToken`, and — at a write through a record
	// (`doorSkipsImages`) — when it is no image. `AskAboutEveryRoot` in both asks about every root.
	var askedBeforeToken as TokenIndex
	var liveAfterToken as TokenIndex
	var doorSkipsImages as bool

	// The `.data` labels of the `let` globals, whose `globalAddr` is module storage no write reaches.
	var immutableGlobalLabels as GlobalDataLabelSet

	// Everything a store put where module storage holds it: a parameter trace's `escapes`.
	var escapedSet as RootSetId
	var operands as ValueIdArray

	// One function's refusals, reported in source order once every door has asked.
	var refusals as PendingRefusalArray

	// Each argument's parameter position in the callee being asked about, and how many parameters it has: a
	// position at or past that count fills none (a label no parameter carries, which E3037 reports).
	var argPositions as ParamCountArray
	var calleeParamCount as ParamCount
	var changed as bool

	var returnedShares as ParamPositionMask
	var returnedIdentity as ParamPositionMask
	var returnedHolds as ParamPositionMask
	var returnedInside as ParamPositionMask
	var returnedHoldsWithin as ParamPositionMask
	var returnedPlacedWithin as ParamPositionMask
	var returnedEscapes as ParamPositionMask
	var returnedBinds as ParamPositionMask
	var storedRow as ParamPositionMaskArray
	var storedDeepRow as ParamPositionMaskArray

	// The callee -> caller pairs of the fixpoint's first pass, recorded while `recording` names the caller.
	var recording as bool
	var recordingCaller as FuncIndex
	export var dependencyCallees as CsrColumn
	export var dependencyCallers as CsrColumn

	// E3019's per-argument question (`immutableIdentityOf`) is asked of the function `checkCalls` has entered,
	// and traced once for it however many of its arguments ask.
	var enteredIndex as FuncIndex
	var bindingsTraceValid as bool
	var bindingsTraceIndex as FuncIndex
	var bindingsRootCount as RootRank

	// By function index, the parameters a receiver-writing call writes through a value that may be their
	// record (`collectProvenanceParamEdges`).
	export var receiverWriteSeeds as ParamPositionMaskArray

	// Every argument a call hands to a parameter its callee writes, by the function the call is in — in function
	// order, since `checkCalls` walks the functions in the order `checkStorageDoors` does — and, for the function
	// being asked about, every rank a value a write goes through may be: those, receivers and field-written boxes,
	// as one set, so a `var` asks it once rather than once per write.
	var writtenArgFuncs as FuncIndexArray
	var writtenArgValues as ValueIdArray
	var writtenArgCalls as SourceRangeArray
	var writtenArgParams as ByteArrayArray
	var writtenArgJudged as BoolArray
	var writtenArgsHere as EntryIndexArray

	// Every rank a refused `var` door took over — the `var`'s own record, and a name it was handed whole — so a
	// write through that record is not refused a second time: the door that bound it already was.
	var refusedDoorRanks as RootSetId

	// Each binding root's reads, by rank: `rootReads` from `rootReadStarts[rank]` up to `rootReadStarts[rank + 1]`.
	var rootReadStarts as EntryIndexArray
	var rootReads as TokenIndexArray
	var tracedSites as ProvenanceSites
	var refusedDoorValues as BoolArray

	// Per value of the function `indexedDefinitionsOf` names: the op that defines it, the hop that op takes toward the
	// record the value was read out of (`indexDefinition`, by kind, base and step), and — for a merge — the one value
	// every edge into it hands it (`soleIncomingValue`). Built once per function asked, so a question along an access
	// path reads columns rather than scanning the body.
	var indexedDefinitionsOf as ByteArray
	var definingOps as OpIndexArray
	var mergingBlocks as BlockIdArray
	var hopKinds as AccessHopKindArray
	var hopBases as ValueIdArray
	var hopSteps as AccessStepArray
	var soleIncomings as ValueIdArray
	var soleIncomingSeen as BoolArray

	// Scratch the write-time questions reuse from one question to the next: the two access paths compared, the records
	// stored into the two fields compared, the arguments a call is handed a record at, the fill of each root's reads,
	// and the reachability walk's worklist and visited blocks.
	var pathSteps as AccessStepArray
	var otherPathSteps as AccessStepArray
	var fieldStored as ValueIdArray
	var otherFieldStored as ValueIdArray
	var handedPositions as ParamCountArray
	var rootReadFill as EntryIndexArray
	var reachWorklist as BlockIdArray
	var reachVisited as BoolArray
	var writtenArgCursor as ElementIndex
	var writtenRanks as RootSetId

	// Where each binding-hygiene diagnostic sits, by its position — the first at a position, and the next at the same
	// one in `hygieneNextAtPosition` — indexed at the first E3077 a door settles (`hygieneIndexOf`), and which of them
	// a door withdrew (`dropWithdrawnHygiene`).
	var hygieneIndexed as bool
	var hygieneFirstAtPosition as HygieneIndexByPosition
	var hygieneNextAtPosition as HygieneIndexArray
	var hygieneWithdrawn as BoolArray

	// What the last trace found, refilled by every widening (`widenSummary`).
	var summaryRow as TracedSummaryRow

	// Each block of the function being walked by its id, refilled for every walk (`IrModule.refillBlockIndexById`).
	var blockIndex as BlockIndexById

	// The calls `callTokenAt` last indexed, and that index.
	var indexedCalls as CallTokenColumns
	var callTokenIndex as TokenByPosition

	// The labelled arguments `argumentValueAt` last indexed, and that index.
	var indexedLabelledArguments as LabelledArgumentValues
	var labelledArgumentRows as LabelledValueRowByPosition

	// The body `indexFlowPoints` last indexed, and where each of its ops stands in its control flow.
	var indexedFlowPointsOf as ByteArray
	var flowPoints as FlowPointByOp

	// Whether a record of a named type holds nothing a statement can write, by type name
	// (`valueHoldsNothingWritable`).
	var writeFreeGraphs as WriteFreeGraphMemo

	// The lends of the function being judged whose record the trace ranks, by rank and site (`checkLentGraphs`); the
	// blocks each of them reaches and where its binding is bound again (`mapLendFlow`, one row of `frozenReach` per
	// lend over the function's `frozenBlockCount` block ids); the `var` doors a freeze refused (`doorWasFrozen`);
	// and where each lent handler parameter first escapes (`traceLentHandlers`).
	var frozenRanks as RootRankArray
	var frozenLends as LendSiteArray
	var frozenReach as BoolArray
	var frozenRebinds as RebindingArray
	var frozenBlockCount as ElementIndex
	var frozenDoorValues as BoolArray
	var handlerEscapes as HandlerEscapeMemo

	static function create(project Project, module MaxonModule, signatures ProgramSignatures, funcIndexByName FuncIndexByName, funcCount FuncIndex) returns ProvenanceTracer
		return Self{project: project, module: module, signatures: signatures, funcIndexByName: funcIndexByName, conformers: ConformersByInterface.create(), witnessSlots: WitnessSlotsByDeclIndex.create(), witnessImpls: WitnessImplsMemo.create(), functionRefBodies: CallLandingBodies.create(), functionRefBodiesGathered: false, functionValueBodies: FunctionValueBodiesMemo.create(), summary: ProvenanceSummary.create(funcCount), sets: RootSets.create(), columnCount: ProvenanceColumn.allCases.count() as RootSetId, setsPerColumn: 0, storeSlots: StoreSlotIndex.create(), deepSlots: StoreSlotIndex.create(), storeSlotWalk: 0, loadOrigins: StoreSlotKeyArray.create(), hasLoadOrigin: BoolArray.create(), tracked: BoolArray.create(), namedTypeHoldsARecord: NamedTypeRecordMemo.create(), instanceHoldsARecord: InstanceRecordMemo.create(), notARootValue: BoolArray.create(), rootValues: ValueIdArray.create(), rootNames: ByteArrayArray.create(), rootRecordKinds: HeldRecordKindsArray.create(), recordKindsByAggregate: AggregateRecordKindsMemo.create(), recordKindsByInstance: InstanceRecordKindsMemo.create(), noRecordKinds: HeldRecordKinds.create(), anyRecordKinds: anyHeldRecordKinds(), rootRankOfValue: RootRankArray.create(), tracingImmutableBindings: false, writableRank: ParameterTraceWritableRank, isWritableValue: BoolArray.create(), rootIsModuleLet: BoolArray.create(), rootIsImage: BoolArray.create(), rootIsImmutableRecord: BoolArray.create(), rootAliasLastUse: TokenIndexArray.create(), rootBorrows: BoolArray.create(), rootAliased: BoolArray.create(), rootInfos: VarInfoArray.create(), rootDeclTokens: TokenIndexArray.create(), rootLiveUntil: TokenIndexArray.create(), rootSoleBase: BoolArray.create(), rootMovedAt: TokenIndexArray.create(), rootCaptured: BoolArray.create(), writableRankOfValue: RootRankArray.create(), firstWritableValueRank: 0, mutablePlaceWords: ParamPositionMaskArray.create(), parameterRankWords: ParamPositionMaskArray.create(), askedBeforeToken: AskAboutEveryRoot, liveAfterToken: AskAboutEveryRoot, doorSkipsImages: false, immutableGlobalLabels: signatures.immutableGlobalDataLabels(), escapedSet: 0, operands: ValueIdArray.create(), refusals: PendingRefusalArray.create(), argPositions: ParamCountArray.create(), calleeParamCount: 0, changed: false, returnedShares: NoParamPositions, returnedIdentity: NoParamPositions, returnedHolds: NoParamPositions, returnedInside: NoParamPositions, returnedHoldsWithin: NoParamPositions, returnedPlacedWithin: NoParamPositions, returnedEscapes: NoParamPositions, returnedBinds: NoParamPositions, storedRow: ParamPositionMaskArray.create(), storedDeepRow: ParamPositionMaskArray.create(), recording: false, recordingCaller: 0, dependencyCallees: CsrColumn.create(), dependencyCallers: CsrColumn.create(), enteredIndex: 0, bindingsTraceValid: false, bindingsTraceIndex: 0, bindingsRootCount: 0, receiverWriteSeeds: emptySummaryColumn(funcCount), writtenArgFuncs: FuncIndexArray.create(), writtenArgValues: ValueIdArray.create(), writtenArgCalls: SourceRangeArray.create(), writtenArgParams: ByteArrayArray.create(), writtenArgJudged: BoolArray.create(), writtenArgsHere: EntryIndexArray.create(), refusedDoorRanks: 0, rootReadStarts: EntryIndexArray.create(), rootReads: TokenIndexArray.create(), tracedSites: ProvenanceSites.create(), refusedDoorValues: BoolArray.create(), indexedDefinitionsOf: EmptySourceText, definingOps: OpIndexArray.create(), mergingBlocks: BlockIdArray.create(), hopKinds: AccessHopKindArray.create(), hopBases: ValueIdArray.create(), hopSteps: AccessStepArray.create(), soleIncomings: ValueIdArray.create(), soleIncomingSeen: BoolArray.create(), pathSteps: AccessStepArray.create(), otherPathSteps: AccessStepArray.create(), fieldStored: ValueIdArray.create(), otherFieldStored: ValueIdArray.create(), handedPositions: ParamCountArray.create(), rootReadFill: EntryIndexArray.create(), reachWorklist: BlockIdArray.create(), reachVisited: BoolArray.create(), writtenArgCursor: 0, writtenRanks: 0, hygieneIndexed: false, hygieneFirstAtPosition: HygieneIndexByPosition.create(), hygieneNextAtPosition: HygieneIndexArray.create(), hygieneWithdrawn: BoolArray.create(), summaryRow: TracedSummaryRow.create(), blockIndex: BlockIndexById.create(), indexedCalls: CallTokenColumns.create(), callTokenIndex: TokenByPosition.create(), indexedLabelledArguments: LabelledArgumentValues.create(), labelledArgumentRows: LabelledValueRowByPosition.create(), indexedFlowPointsOf: EmptySourceText, flowPoints: FlowPointByOp.create(), writeFreeGraphs: WriteFreeGraphMemo.create(), frozenRanks: RootRankArray.create(), frozenLends: LendSiteArray.create(), frozenReach: BoolArray.create(), frozenRebinds: RebindingArray.create(), frozenBlockCount: 0, frozenDoorValues: BoolArray.create(), handlerEscapes: HandlerEscapeMemo.create()}
	end 'create'

	// The next trace records every callee it consults as a dependency of `caller`.
	function recordDependenciesOf(caller FuncIndex)
		self.recording = true
		self.recordingCaller = caller
	end 'recordDependenciesOf'

	function widenSummary(index FuncIndex) returns bool
		var row = self.summaryRow
		row.shares = self.returnedShares
		row.identity = self.returnedIdentity
		row.holds = self.returnedHolds
		row.inside = self.returnedInside
		row.holdsWithin = self.returnedHoldsWithin
		row.placedWithin = self.returnedPlacedWithin
		row.escapes = self.returnedEscapes
		row.binds = self.returnedBinds
		row.stores = self.storedRow
		row.deepStores = self.storedDeepRow
		return self.summary.widen(index, row: row)
	end 'widenSummary'

	// A function with no parameter that holds a record has nothing of its caller's to hand back or store, so it
	// is not traced and keeps empty masks.
	function anyParameterHoldsARecord(func IrFunction) returns bool
		for p in 0 upto func.paramCount 'eachParam'
			if self.valueTagCarriesProvenance(func, value: valueIdAtParamPosition(p)) 'holdsARecord'
				return true
			end 'holdsARecord'
		end 'eachParam'

		return false
	end 'anyParameterHoldsARecord'

	// Roots are the parameters that hold a record, ranked by position — the summary's own bit order — and
	// module `var` storage past them: a parameter stored into a `var` of this body has not left it.
	function traceParameters(func IrFunction)
		self.bindingsTraceValid = false

		if func.paramCount > RootBitIndexMask + 1 'moreParametersThanAMaskHolds'
			panic("ProvenanceTracer.traceParameters: '{String.from(func.name)}' takes {func.paramCount} parameters, past the {RootBitIndexMask + 1} a `ParamPositionMask` holds — `Parser.requireAbiParamCount` bounds it by `MaxAbiArgs`")
		end 'moreParametersThanAMaskHolds'

		self.begin(func)
		self.rootValues.clear()
		self.rootNames.clear()
		self.tracingImmutableBindings = false
		self.writableRank = ParameterTraceWritableRank

		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)
			self.rootValues.push(param)

			if self.isTracked(param) 'holdsARecord'
				self.seedParameter(func, param: param, rank: p)
			end 'holdsARecord'
		end 'eachParam'

		self.markVarsOwn(func, sites: func.provenanceSites(), into: self.isWritableValue)
		self.walk(func, ir: self.module)
		self.gatherStores(func)
	end 'traceParameters'

	// What the body stored into each parameter's record — into a field of it, or deeper — into module storage,
	// and bound to a mutable name that outlives the call, in the summary's bit order. A parameter's own bit is
	// not its store: a by-reference parameter's cell holds its own record from the start. A part of one stored
	// is read as the whole of it.
	function gatherStores(func IrFunction)
		self.storedRow.refill(func.paramCount as ElementIndex, value: NoParamPositions)
		self.storedDeepRow.refill(func.paramCount as ElementIndex, value: NoParamPositions)

		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)
			let direct = self.wordAt(ProvenanceColumn.holds, value: param, word: 0) or self.wordAt(ProvenanceColumn.storedHolds, value: param, word: 0)
			let deep = self.wordAt(ProvenanceColumn.deepHolds, value: param, word: 0) or self.wordAt(ProvenanceColumn.storedDeep, value: param, word: 0) or self.wordAt(ProvenanceColumn.holdsWithin, value: param, word: 0)
			try self.storedRow.set(p, value: maskWithoutParam(direct, param: p)) otherwise panic("ProvenanceTracer.gatherStores: storedRow.set OOB at {p}")
			try self.storedDeepRow.set(p, value: maskWithoutParam(deep, param: p)) otherwise panic("ProvenanceTracer.gatherStores: storedDeepRow.set OOB at {p}")
		end 'eachParam'

		self.returnedEscapes = self.sets.wordAt(self.escapedSet, word: 0)

		for site in func.provenanceSites().nameBindSites 'eachNameBind'
			self.returnedBinds = self.returnedBinds or self.wordAt(ProvenanceColumn.identity, value: site.value, word: 0)
		end 'eachNameBind'
	end 'gatherStores'

	// Roots are the immutable names of the body — the `let` bindings the author wrote and the module-level `let`s
	// it read, ranked in declaration order — then the parameters, then each `var`'s own record, then module `var`
	// storage. A value a `var` holds (`let u = t`, which moves `t`) is a binding made FROM that `var`, and a
	// function value names no storage a write could reach, so neither is a root. Answers how many binding roots
	// there are.
	function traceImmutableBindings(func IrFunction) returns RootRank
		self.bindingsTraceValid = false
		let sites = func.provenanceSites()
		let bindings = sites.immutableBindings
		self.notARootValue.refill(func.valueTags.count(), value: false)
		self.rootValues.clear()
		self.rootNames.clear()
		self.rootRecordKinds.clear()
		self.rootIsModuleLet.clear()
		self.rootIsImage.clear()
		self.rootIsImmutableRecord.clear()
		self.rootAliasLastUse.clear()
		self.rootBorrows.clear()
		self.rootAliased.clear()
		self.rootInfos.clear()
		self.rootDeclTokens.clear()

		self.rootRankOfValue.refill(func.valueTags.count(), value: NoRootRank)
		self.writableRankOfValue.refill(func.valueTags.count(), value: NoRootRank)

		self.markVarsOwn(func, sites: sites, into: self.notARootValue)

		for i in 0 upto bindings.values.count() 'eachBinding'
			let value = try bindings.values.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: values.get OOB at {i}")

			if valueTagOf(func, value: value) == ValueTypeTag.function or not self.valueTagCarriesProvenance(func, value: value) 'noRecord'
				continue
			end 'noRecord'

			let first = self.bindingRankOf(value)

			if first != NoRootRank 'aSecondName'
				try self.rootAliased.set(first, value: true) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootAliased.set OOB at {first}")
				let alias = try bindings.infos.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: infos.get OOB at {i}")
				let before = try self.rootAliasLastUse.get(first) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootAliasLastUse.get OOB at {first}")

				if alias.lastReadToken > before 'readLater'
					try self.rootAliasLastUse.set(first, value: alias.lastReadToken) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootAliasLastUse.set OOB at {first}")
				end 'readLater'

				continue
			end 'aSecondName'

			let aVarsOwn = try self.notARootValue.get(value) otherwise panic("ProvenanceTracer.traceImmutableBindings: v{value} of '{String.from(func.name)}' is past its value columns")

			if aVarsOwn 'madeFromAVar'
				continue
			end 'madeFromAVar'

			try self.rootRankOfValue.set(value, value: self.rootValues.count() as RootRank) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootRankOfValue.set OOB at v{value}")
			self.rootValues.push(value)
			self.rootNames.push(try bindings.names.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: names.get OOB at {i} — the columns are pushed together"))
			self.rootRecordKinds.push(self.recordKindsWithinValue(func, value: value))
			self.rootIsModuleLet.push(try bindings.moduleLets.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: moduleLets.get OOB at {i}"))
			self.rootIsImage.push(try bindings.images.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: images.get OOB at {i}"))
			self.rootIsImmutableRecord.push(self.valueIsAnImmutableRecord(func, value: value))
			self.rootAliasLastUse.push(0)
			self.rootBorrows.push(try bindings.borrows.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: borrows.get OOB at {i}"))
			self.rootAliased.push(false)
			self.rootInfos.push(try bindings.infos.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: infos.get OOB at {i}"))
			self.rootDeclTokens.push(try bindings.declTokens.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: declTokens.get OOB at {i}"))
		end 'eachBinding'

		let bindingCount = self.rootValues.count()

		for p in 0 upto func.paramCount 'eachParam'
			self.rootValues.push(valueIdAtParamPosition(p))
			self.rootRecordKinds.push(self.recordKindsWithinValue(func, value: valueIdAtParamPosition(p)))
		end 'eachParam'

		self.firstWritableValueRank = self.rootValues.count()

		for value in sites.writableValues 'eachWritable'
			if self.writableRankOf(value) != NoRootRank or not self.valueTagCarriesProvenance(func, value: value) 'rankedOrNoRecord'
				continue
			end 'rankedOrNoRecord'

			try self.writableRankOfValue.set(value, value: self.rootValues.count() as RootRank) otherwise panic("ProvenanceTracer.traceImmutableBindings: writableRankOfValue.set OOB at v{value}")
			self.rootValues.push(value)
			self.rootRecordKinds.push(self.recordKindsWithinValue(func, value: value))
		end 'eachWritable'

		self.begin(func)
		self.tracingImmutableBindings = true
		self.writableRank = self.rootValues.count() as RootRank
		let wordCount = ((self.writableRank + RootBitIndexMask + 1) shr RootWordShift) as ElementIndex
		self.mutablePlaceWords.refill(wordCount, value: NoParamPositions)
		self.parameterRankWords.refill(wordCount, value: NoParamPositions)
		let writtenParams = func.writtenParamMask or func.writesThroughParamMask or func.storageWrittenParamMask

		for rank in bindingCount upto self.writableRank + 1 'eachWritableRank'
			if rank < self.firstWritableValueRank 'aParameter'
				addRankToWords(self.parameterRankWords, rank: rank)
			end 'aParameter'

			if rank >= self.firstWritableValueRank or maskHasParam(writtenParams, param: (rank - bindingCount) as ParamCount) 'aMutablePlace'
				addRankToWords(self.mutablePlaceWords, rank: rank)
			end 'aMutablePlace'
		end 'eachWritableRank'

		for rank in 0 upto bindingCount 'eachBinding'
			let value = self.rootValueAt(rank)
			self.setBit(ProvenanceColumn.identity, value: value, rank: rank)
			self.setBit(ProvenanceColumn.shares, value: value, rank: rank)
		end 'eachBinding'

		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)

			if self.isTracked(param) 'holdsARecord'
				self.seedParameter(func, param: param, rank: bindingCount + p)
			end 'holdsARecord'
		end 'eachParam'

		for rank in self.firstWritableValueRank upto self.writableRank 'eachVarsOwn'
			let value = self.rootValueAt(rank)
			self.setBit(ProvenanceColumn.identity, value: value, rank: rank)
			self.setBit(ProvenanceColumn.shares, value: value, rank: rank)
		end 'eachVarsOwn'

		self.markVarsOwn(func, sites: sites, into: self.isWritableValue)
		self.walk(func, ir: self.module)
		self.settleBindingRoots(func, bindingCount: bindingCount)
		return bindingCount
	end 'traceImmutableBindings'

	// ⭐ **A `let` OWNS ITS RECORD WHEN NOTHING ELSE MAY BE IT: no second name, no provenance but its own** — it was
	// bound to a fresh record, not to a borrow, an element, a field, a parameter or a call result that hands one
	// back. Such a `let` is its record's sole reference, which is what a mutable door may take by move. Asked
	// after the walk, when the sets are settled; which other `let`s are live at a door is the door's to ask
	// (`rootIsSoleAt`). And how long each binding stays live: to its last use, and to the end of every loop it
	// was bound before and used inside, since the next trip reads it again.
	function settleBindingRoots(func IrFunction, bindingCount RootRank)
		self.rootSoleBase.refill(bindingCount as ElementIndex, value: false)
		self.rootLiveUntil.refill(bindingCount as ElementIndex, value: 0)
		self.rootMovedAt.refill(bindingCount as ElementIndex, value: NeverMovedToken)
		self.rootCaptured.refill(bindingCount as ElementIndex, value: false)
		let loops = func.provenanceSites().loops

		for captured in func.provenanceSites().letCaptures.values 'eachCapture'
			let rank = self.bindingRankOf(captured)

			if rank != NoRootRank and rank < bindingCount 'aRootCaptured'
				try self.rootCaptured.set(rank, value: true) otherwise panic("ProvenanceTracer.settleBindingRoots: rootCaptured.set OOB at {rank}")
			end 'aRootCaptured'
		end 'eachCapture'

		for rank in 0 upto bindingCount 'eachBinding'
			let value = self.rootValueAt(rank)
			let aliased = try self.rootAliased.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootAliased.get OOB at {rank}")
			let moduleLet = try self.rootIsModuleLet.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootIsModuleLet.get OOB at {rank}")
			let ownsItsRecord = not aliased and not moduleLet and self.setIsExactlyRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) and self.sets.first(self.setOf(ProvenanceColumn.inside, value: value)) == NoRootChunk
			try self.rootSoleBase.set(rank, value: ownsItsRecord) otherwise panic("ProvenanceTracer.settleBindingRoots: rootSoleBase.set OOB at {rank}")

			if moduleLet or self.rootIsCaptured(rank) 'liveEverywhere'
				try self.rootLiveUntil.set(rank, value: NeverMovedToken) otherwise panic("ProvenanceTracer.settleBindingRoots: rootLiveUntil.set OOB at {rank}")
				continue
			end 'liveEverywhere'

			let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootDeclTokens.get OOB at {rank}")
			let info = try self.rootInfos.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootInfos.get OOB at {rank}")
			let aliasLastUse = try self.rootAliasLastUse.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootAliasLastUse.get OOB at {rank}")
			let named = info.lastReadToken if info.lastReadToken > aliasLastUse else aliasLastUse
			let lastUse = named if named > declared else declared
			try self.rootLiveUntil.set(rank, value: liveUntilAcrossLoops(declared, lastUse: lastUse, loops: loops)) otherwise panic("ProvenanceTracer.settleBindingRoots: rootLiveUntil.set OOB at {rank}")
		end 'eachBinding'

		self.tracedSites = func.provenanceSites()
		self.gatherRootReads(func, bindingCount: bindingCount)
	end 'settleBindingRoots'

	// Each root's reads out of the body's `LetReads`, grouped by rank.
	function gatherRootReads(func IrFunction, bindingCount RootRank)
		let reads = func.provenanceSites().letReads
		self.rootReadStarts.refill((bindingCount as ElementIndex) + 1, value: 0)
		self.rootReads.refill(reads.values.count(), value: 0)

		for value in reads.values 'countEach'
			let rank = self.bindingRankOf(value)

			if rank != NoRootRank and rank < bindingCount 'aRootsRead'
				let next = (rank as ElementIndex) + 1
				try self.rootReadStarts.set(next, value: (try self.rootReadStarts.get(next) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB")) + 1) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.set OOB")
			end 'aRootsRead'
		end 'countEach'

		for i in 1 upto (bindingCount as ElementIndex) + 1 'prefixSum'
			try self.rootReadStarts.set(i, value: (try self.rootReadStarts.get(i) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB")) + (try self.rootReadStarts.get(i - 1) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB"))) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.set OOB")
		end 'prefixSum'

		var filled = self.rootReadFill
		filled.refill(bindingCount as ElementIndex, value: 0)

		for k in 0 upto reads.values.count() 'placeEach'
			let rank = self.bindingRankOf(try reads.values.get(k) otherwise panic("ProvenanceTracer.gatherRootReads: values.get OOB at {k}"))

			if rank != NoRootRank and rank < bindingCount 'aRootsRead'
				let at = (try self.rootReadStarts.get(rank as ElementIndex) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB")) + (try filled.get(rank as ElementIndex) otherwise panic("ProvenanceTracer.gatherRootReads: filled.get OOB"))
				try self.rootReads.set(at, value: try reads.tokens.get(k) otherwise panic("ProvenanceTracer.gatherRootReads: tokens.get OOB at {k}")) otherwise panic("ProvenanceTracer.gatherRootReads: rootReads.set OOB at {at}")
				try filled.set(rank as ElementIndex, value: (try filled.get(rank as ElementIndex) otherwise panic("ProvenanceTracer.gatherRootReads: filled.get OOB")) + 1) otherwise panic("ProvenanceTracer.gatherRootReads: filled.set OOB")
			end 'aRootsRead'
		end 'placeEach'
	end 'gatherRootReads'

	// ⭐ **IS BINDING ROOT `rank` READ ON SOME PATH FROM `token`?** Its last read in the text — stretched to the end of
	// a loop it was bound before and read in — bounds the answer. Within that bound a read counts only where some path
	// reaches it: a later read on the other arm of an `if` the door is on one arm of does not, unless a loop the
	// root was bound before encloses both, whose next trip may take the other arm. A root the body filed no read of
	// is answered by the bound alone. A module-level `let`, and a `let` a closure captured — whose reads are wherever
	// the closure is called — are read everywhere.
	function rootReadAfter(rank RootRank, token TokenIndex) returns bool
		if (try self.rootLiveUntil.get(rank) otherwise panic("ProvenanceTracer.rootReadAfter: rootLiveUntil.get OOB at {rank}")) <= token 'readForTheLastTimeBefore'
			return false
		end 'readForTheLastTimeBefore'

		if self.rootIsModuleLetAt(rank) or self.rootIsCaptured(rank) 'liveEverywhere'
			return true
		end 'liveEverywhere'

		let first = try self.rootReadStarts.get(rank as ElementIndex) otherwise panic("ProvenanceTracer.rootReadAfter: rootReadStarts.get OOB at {rank}")
		let bound = try self.rootReadStarts.get((rank as ElementIndex) + 1) otherwise panic("ProvenanceTracer.rootReadAfter: rootReadStarts.get OOB at {rank}")

		if first == bound 'noReadFiled'
			return true
		end 'noReadFiled'

		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootReadAfter: rootDeclTokens.get OOB at {rank}")
		let sites = self.tracedSites

		for k in first upto bound 'eachRead'
			let read = try self.rootReads.get(k) otherwise panic("ProvenanceTracer.rootReadAfter: rootReads.get OOB at {k}")

			if (read > token and not onExclusiveArms(sites.exclusiveArms, door: token, read: read)) or readOnALaterTrip(sites.loops, declared: declared, door: token, read: read) 'reachable'
				return true
			end 'reachable'
		end 'eachRead'

		return false
	end 'rootReadAfter'

	// Is `set` exactly the one rank `rank`?
	function setIsExactlyRank(set RootSetId, rank RootRank) returns bool
		let chunk = self.sets.first(set)

		if chunk == NoRootChunk or self.sets.next(chunk) != NoRootChunk 'notOneWord'
			return false
		end 'notOneWord'

		return self.sets.indexOf(chunk) == (rank shr RootWordShift) as MaskWordCount and self.sets.wordOf(chunk) == maskWithParam(NoParamPositions, param: (rank and RootBitIndexMask) as ParamCount)
	end 'setIsExactlyRank'

	// Every value a `var` binding holds, and every value a mutable-binding site bound.
	function markVarsOwn(func IrFunction, sites ProvenanceSites, into BoolArray)
		for value in sites.writableValues 'eachWritable'
			try into.set(value, value: true) otherwise panic("ProvenanceTracer.markVarsOwn: writable value v{value} of '{String.from(func.name)}' is past its value columns")
		end 'eachWritable'

		for site in sites.mutableBindingSites 'eachSite'
			try into.set(site.value, value: true) otherwise panic("ProvenanceTracer.markVarsOwn: site value v{site.value} of '{String.from(func.name)}' is past its value columns")
		end 'eachSite'
	end 'markVarsOwn'

	// The immutable-binding trace of `func` at `index`, once however many questions ask it. Answers how many
	// roots it has.
	function bindingsTraceOf(func IrFunction, index FuncIndex) returns RootRank
		if not self.bindingsTraceValid or self.bindingsTraceIndex != index 'traceThisFunction'
			self.bindingsRootCount = self.traceImmutableBindings(func)
			self.bindingsTraceValid = true
			self.bindingsTraceIndex = index
		end 'traceThisFunction'

		return self.bindingsRootCount
	end 'bindingsTraceOf'

	export function enterFunction(funcIndex FuncIndex)
		self.enteredIndex = funcIndex
	end 'enterFunction'

	// `value` is handed, in the entered function, by the call at `call`, to a parameter its callee writes —
	// `paramName`, or the parameter at its position when that is unknown (empty).
	export function noteArgumentWritten(value ValueId, call SourceRange, paramName ByteArray)
		self.writtenArgFuncs.push(self.enteredIndex)
		self.writtenArgValues.push(value)
		self.writtenArgCalls.push(call)
		self.writtenArgParams.push(paramName)
		self.writtenArgJudged.push(false)
	end 'noteArgumentWritten'

	// The argument noted last was refused where it was noted (E3019 by name or by identity): the write-through door
	// leaves it be.
	export function noteLastArgumentJudged()
		try self.writtenArgJudged.set(self.writtenArgJudged.count() - 1, value: true) otherwise panic("ProvenanceTracer.noteLastArgumentJudged: no argument was noted")
	end 'noteLastArgumentJudged'

	// ⭐ **A CALL THAT NAMES NO SINGLE CALLEE WRITES AN ARGUMENT WHERE ANY BODY IT MAY LAND ON WRITES THAT
	// POSITION** — a witness dispatch's conformers and a function value's bodies, their arguments positional. A
	// body no summary describes may write any argument (`unresolvedMayStore`); a compiler-synthesized witness is
	// built to the requirement's shape and writes none. Asked, like `noteArgumentWritten`, only of a function
	// with an immutable name to guard.
	export function noteDispatchedArgumentsWritten(func IrFunction, op MaxonOp, opIndex OpIndex, mutationSummary ParamMutationSummary)
		if func.provenanceSites().immutableBindings.values.count() == 0 'nothingAsks'
			return
		end 'nothingAsks'

		match op 'op'
			witnessDispatch(_, args, _, methodIndex, interfaceDeclIndex, _, _) then self.noteLandingArgumentsWritten(args, bodies: self.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), call: self.project.opRanges.get(opIndex), mutationSummary: mutationSummary)
			witnessTryDispatch(_, _, args, _, methodIndex, interfaceDeclIndex, _) then self.noteLandingArgumentsWritten(args, bodies: self.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), call: self.project.opRanges.get(opIndex), mutationSummary: mutationSummary)

			// Its `args` is the variant's TAIL field, so it is bound in a small match — see
			// `LowerMaxonToStd.lowerIndirectCall`.
			indirectCall then self.noteFunctionValueArgumentsWritten(op, call: self.project.opRanges.get(opIndex), mutationSummary: mutationSummary)

			call or
				tryCall or
				asyncCall or
				literal or
				ret or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				loadIndirect or
				storeIndirect or
				stringLiteral or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic then break 'op'
		end 'op'
	end 'noteDispatchedArgumentsWritten'

	function noteFunctionValueArgumentsWritten(op MaxonOp, call SourceRange, mutationSummary ParamMutationSummary)
		match op 'indirect'
			indirectCall(_, _, args) then self.noteLandingArgumentsWritten(args, bodies: self.functionValueBodiesFor(args.count()), call: call, mutationSummary: mutationSummary)
			default panic("ProvenanceTracer.noteFunctionValueArgumentsWritten: handed an op that is not an indirect call")
		end 'indirect'
	end 'noteFunctionValueArgumentsWritten'

	function noteLandingArgumentsWritten(args ValueIdArray, bodies CallLandingBodies, call SourceRange, mutationSummary ParamMutationSummary)
		let written = mutationSummary.writtenMaskAtAnyOf(bodies.impls)

		for i in 0 upto args.count() 'eachArg'
			if bodies.unresolvedMayStore or maskHasParam(written, param: i) 'written'
				self.noteArgumentWritten(try args.get(i) otherwise panic("ProvenanceTracer.noteLandingArgumentsWritten: args.get OOB at {i}"), call: call, paramName: self.landingParamName(bodies, position: i))
			end 'written'
		end 'eachArg'
	end 'noteLandingArgumentsWritten'

	// The name a body the call may land on gives the parameter at `position`, or empty when none is known.
	function landingParamName(bodies CallLandingBodies, position ElementIndex) returns ByteArray
		if bodies.impls.count() == 0 'noDeclaredBody'
			return EmptySourceText
		end 'noDeclaredBody'

		let body = try self.module.functions.get(try bodies.impls.get(0) otherwise panic("ProvenanceTracer.landingParamName: impls.get OOB below its own count")) otherwise panic("ProvenanceTracer.landingParamName: a landing body is not a module function")
		let sig = try self.project.funcSignatures.get(body.name) otherwise return EmptySourceText
		return try sig.paramNames.get(position) otherwise EmptySourceText
	end 'landingParamName'

	// The values `func` (at `index`) writes through: a receiver-writing call's receiver, a field write's box, and
	// an argument at a written parameter.
	function gatherWrittenTargets(func IrFunction, index FuncIndex)
		self.writtenRanks = self.sets.addSet()
		self.refusedDoorRanks = self.sets.addSet()
		self.refusedDoorValues.refill(func.valueTags.count(), value: false)
		self.writtenArgsHere.clear()

		for site in func.provenanceSites().receiverWrites 'eachReceiver'
			self.noteWrittenTarget(site.receiver)
		end 'eachReceiver'

		for box in func.provenanceSites().fieldWrites 'eachBox'
			self.noteWrittenTarget(box)
		end 'eachBox'

		while self.writtenArgCursor < self.writtenArgFuncs.count() 'eachArgument'
			let owner = try self.writtenArgFuncs.get(self.writtenArgCursor) otherwise panic("ProvenanceTracer.gatherWrittenTargets: writtenArgFuncs.get OOB below its own count")

			if owner > index 'aLaterFunctions'
				break
			end 'aLaterFunctions'

			if owner == index 'thisFunctions'
				self.noteWrittenTarget(try self.writtenArgValues.get(self.writtenArgCursor) otherwise panic("ProvenanceTracer.gatherWrittenTargets: the two columns are pushed together"))
				self.writtenArgsHere.push(self.writtenArgCursor)
			end 'thisFunctions'

			self.writtenArgCursor = self.writtenArgCursor + 1
		end 'eachArgument'
	end 'gatherWrittenTargets'

	function noteWrittenTarget(target ValueId)
		self.unionInto(self.writtenRanks, from: self.setOf(ProvenanceColumn.identity, value: target))
	end 'noteWrittenTarget'

	// ⭐ **IS THE RECORD A `var` WAS BOUND TO WRITTEN THROUGH WHILE IT HOLDS IT?** A `var` only rebound and read —
	// a chain cursor, `cur = try cur.next()` — is a rebindable shared reference and mutates nothing a live `let`
	// reads. Its record is written where a field write, a receiver-writing call or a written parameter reaches a
	// value that may be it — the `var`'s own rank, which follows the record wherever it flows. A value no local
	// `var` holds as its own (a module `var`'s, written wherever the program likes) is taken as written.
	function boundValueIsWrittenThrough(value ValueId) returns bool
		let own = self.writableRankOf(value)

		if own == NoRootRank 'noLocalVarsOwn'
			return true
		end 'noLocalVarsOwn'

		return self.sets.hasRank(self.writtenRanks, rank: own)
	end 'boundValueIsWrittenThrough'

	// E3019's question of one argument of the entered function's call at `call`: the first `let` in declaration order
	// live after the call whose own record it may be, or empty. A value a `var` holds answers empty: the door that
	// bound it (E3078) answers for it, since that asks `identity` too.
	export function immutableIdentityOf(func IrFunction, value ValueId, call SourceRange) returns ByteArray
		if func.provenanceSites().immutableBindings.values.count() == 0 or self.bindingsTraceOf(func, index: self.enteredIndex) == 0 or self.valueIsAVarsOwn(value) 'noImmutableRootToBlame'
			return EmptySourceText
		end 'noImmutableRootToBlame'

		self.askAtDoor(self.callTokenAt(func, at: call), skipsImages: false)
		let blamed = self.firstRootWrittenThrough(func, target: value)
		self.leaveDoor()
		return blamed
	end 'immutableIdentityOf'

	// The rank of the binding whose own record `value` is, or `NoRootRank`, in the last immutable-binding trace.
	function bindingRankOf(value ValueId) returns RootRank
		return try self.rootRankOfValue.get(value) otherwise panic("ProvenanceTracer.bindingRankOf: v{value} is past the traced function's value count")
	end 'bindingRankOf'

	// The rank of the `var` whose own record `value` is, or `NoRootRank`, in the last immutable-binding trace.
	function writableRankOf(value ValueId) returns RootRank
		return try self.writableRankOfValue.get(value) otherwise panic("ProvenanceTracer.writableRankOf: v{value} is past the traced function's value count")
	end 'writableRankOf'

	function valueIsAVarsOwn(value ValueId) returns bool
		return try self.isWritableValue.get(value) otherwise panic("ProvenanceTracer.valueIsAVarsOwn: v{value} is past the traced function's value count")
	end 'valueIsAVarsOwn'

	function seedParameter(func IrFunction, param ValueId, rank RootRank)
		self.setBit(ProvenanceColumn.identity, value: param, rank: rank)
		self.setBit(ProvenanceColumn.shares, value: param, rank: rank)

		// A by-reference parameter is the address of the caller's cell, so what a read of it yields IS the record.
		if maskHasParam(func.reassignedParamMask, param: paramPositionOfValueId(param)) 'aCell'
			self.setBit(ProvenanceColumn.holds, value: param, rank: rank)
		end 'aCell'

		// A function parameter's environment arrives as a companion parameter, and lies within the closure.
		let env = try func.valueClosureEnv.get(param) otherwise panic("ProvenanceTracer.seedParameter: v{param} of '{String.from(func.name)}' has no closure-environment slot — the column is dense by value")

		if env != 0 'carriesAnEnvironment'
			self.setBit(ProvenanceColumn.inside, value: env, rank: rank)
			self.setBit(ProvenanceColumn.shares, value: env, rank: rank)
		end 'carriesAnEnvironment'
	end 'seedParameter'

	function begin(func IrFunction)
		let valueCount = func.valueTags.count()
		self.setsPerColumn = valueCount as RootSetId
		self.sets.reset(self.columnCount * self.setsPerColumn)
		self.escapedSet = self.sets.addSet()

		self.storeSlotWalk = self.storeSlotWalk + 1

		self.hasLoadOrigin.refill(valueCount, value: false)
		self.loadOrigins.refill(valueCount, value: 0)

		self.returnedShares = NoParamPositions
		self.returnedIdentity = NoParamPositions
		self.returnedHolds = NoParamPositions
		self.returnedInside = NoParamPositions
		self.returnedHoldsWithin = NoParamPositions
		self.returnedPlacedWithin = NoParamPositions
		self.returnedEscapes = NoParamPositions
		self.returnedBinds = NoParamPositions
		self.tracked.refill(valueCount, value: false)
		self.isWritableValue.refill(valueCount, value: false)

		if func.valueMintedSole.count() != valueCount 'columnsOutOfStep'
			panic("ProvenanceTracer.begin: '{String.from(func.name)}' has {valueCount} value types but {func.valueMintedSole.count()} sole-owner marks — both are pushed by `Parser.mintValue`/`recordValueType`")
		end 'columnsOutOfStep'

		for v in 0 upto valueCount 'eachValue'
			let soleOwner = try func.valueMintedSole.get(v) otherwise panic("ProvenanceTracer.begin: valueMintedSole.get OOB at {v}")
			try self.tracked.set(v, value: soleOwner or self.valueTagCarriesProvenance(func, value: v)) otherwise panic("ProvenanceTracer.begin: tracked.set OOB at {v}")
		end 'eachValue'
	end 'begin'

	// ⚠ The module is handed in rather than read off `self`, so a block borrowed out of it is not a borrow of
	// the tracer the walk writes (E3070): the walk writes only its own scratch, never the module.
	function walk(func IrFunction, ir MaxonModule)
		ir.refillBlockIndexById(func, into: self.blockIndex)
		self.changed = true

		while self.changed 'untilNothingGrows'
			self.changed = false

			for blockRef in func.blockRefs 'eachBlock'
				let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.walk: blockRef from func.blockRefs not in module.blocks")
				self.traceBlock(func, ir: ir, block: block)
			end 'eachBlock'

			self.carryClosureEnvironments(func)
		end 'untilNothingGrows'

		for blockRef in func.blockRefs 'eachReturningBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.walk: blockRef from func.blockRefs not in module.blocks")

			if block.hasTerminatorOp() 'terminated'
				self.recordReturn(try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.walk: terminatorIndex not in module.ops"))
			end 'terminated'
		end 'eachReturningBlock'

		self.recording = false
	end 'walk'

	function traceBlock(func IrFunction, ir MaxonModule, block IrBlock)
		for opIdx in block.opRefs 'eachOp'
			self.traceOp(func, op: try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.traceBlock: opIdx {opIdx} not in module.ops"))
		end 'eachOp'

		for edge in block.branchEdges 'eachEdge'
			let position = try self.blockIndex.get(edge.targetBlockId) otherwise panic("ProvenanceTracer.traceBlock: edge target {edge.targetBlockId} is not a block of '{String.from(func.name)}'")
			let targetRef = try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.traceBlock: blockIndexById placed a block at {position}, past func.blockRefs")
			let target = try ir.blocks.get(targetRef) otherwise panic("ProvenanceTracer.traceBlock: blockRef {targetRef} not in module.blocks")

			for k in 0 upto edge.argIds.count() 'eachPhi'
				let incoming = try edge.argIds.get(k) otherwise panic("ProvenanceTracer.traceBlock: argIds.get OOB at {k}")
				let phi = try target.blockArgs.get(k) otherwise panic("ProvenanceTracer.traceBlock: edge into block {edge.targetBlockId} carries more values than it has block args")

				if self.isTracked(phi.valueId) 'phiHoldsARecord'
					self.flowIdentity(phi.valueId, from: incoming)
				end 'phiHoldsARecord'
			end 'eachPhi'
		end 'eachEdge'
	end 'traceBlock'

	// A closure value contains its environment (`IrFunction.valueClosureEnv`), which a call through it hands
	// the body — the one relation between two values that no op states.
	function carryClosureEnvironments(func IrFunction)
		for v in 0 upto func.valueClosureEnv.count() 'eachValue'
			let env = try func.valueClosureEnv.get(v) otherwise panic("ProvenanceTracer.carryClosureEnvironments: valueClosureEnv.get OOB at {v}")

			if env != 0 'carriesAnEnvironment'
				self.flowContents(v, from: env)
			end 'carriesAnEnvironment'
		end 'eachValue'
	end 'carryClosureEnvironments'

	function traceOp(func IrFunction, op MaxonOp)
		match op 'op'
			loadIndirect(result, addr, offset, _) then self.traceLoad(func, result: result, addr: addr, offset: offset)
			storeIndirect(addr, offset, value, _) then self.traceStore(addr, offset: offset, value: value)
			call(result, callee, args, argLabels, _, _, _, _) then self.traceCall(func, op: op, result: result, callee: callee, args: args, argLabels: argLabels)
			tryCall(result, _, callee, args, argLabels, _, _, _, _) then self.traceCall(func, op: op, result: result, callee: callee, args: args, argLabels: argLabels)

			// ⭐ **A SPAWN IS TRACED AS THE CALL IT IS.** Its target takes a reference to a managed argument
			// (`Parser.transferAsyncSpawnArgs`), so what that target KEEPS — stores into another parameter, binds
			// to a mutable name, hands back inside its result — is kept out of this frame just as a direct call's
			// is, and the summary must carry it one frame out or a caller that only spawns reads as keeping
			// nothing.
			asyncCall(result, callee, args, argLabels, _, _, _) then self.traceCall(func, op: op, result: result, callee: callee, args: args, argLabels: argLabels)
			witnessDispatch(result, args, _, methodIndex, interfaceDeclIndex, _, _) then self.traceWitnessDispatch(func, op: op, result: result, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex)
			witnessTryDispatch(result, _, args, _, methodIndex, interfaceDeclIndex, _) then self.traceWitnessDispatch(func, op: op, result: result, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex)

			// A module `var` is writable storage, and every read or write of it goes through its address.
			globalAddr(result, label) then self.traceGlobalAddress(result, label: label)

			// Every other op that defines a value may define any record its operands reach. The result is bound
			// per arm rather than through `maxonOpResultValue`, whose answer is a union — a heap box per op per
			// walk on the hottest path this pass has. A raw intrinsic is the runtime tier's, which holds no
			// managed value.
			literal(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			binOp(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			unaryOp(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			compare(result, _, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			stringLiteral(result, _) then self.flowFromOperands(func, op: op, result: result)
			functionRef(result, _) then self.flowFromOperands(func, op: op, result: result)
			await(result, _) then self.flowFromOperands(func, op: op, result: result)
			tryAwait(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			sizeofType(result, _) then self.flowFromOperands(func, op: op, result: result)
			constArrayLiteral(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			errorFlagEncode(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			serviceSpawn(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			serviceSend(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			serviceReplyCell(result, _) then self.flowFromOperands(func, op: op, result: result)
			immortalStructRecord(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			immortalStringTable(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			rawIntrinsic(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)

			// Its `args` is the variant's TAIL field, so it is bound in a small match — see
			// `LowerMaxonToStd.lowerIndirectCall`.
			indirectCall then self.traceIndirectCall(func, op: op)
			ret or
				retVoid or
				condBranch or
				branch or
				throwError or
				propagateError or
				panicAbort or
				switch or
				panicAbortValue or
				covPoint then break 'op'
		end 'op'
	end 'traceOp'

	// A module `let`'s slot is storage no write reaches, so only a module `var`'s address is writable storage.
	function traceGlobalAddress(result ValueId, label ByteArray)
		if not self.immutableGlobalLabels.contains(label) 'aModuleVar'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.writableRank)
		end 'aModuleVar'
	end 'traceGlobalAddress'

	function traceIndirectCall(func IrFunction, op MaxonOp)
		match op 'indirect'
			indirectCall(result, callee, args) then self.traceFunctionValueCall(func, op: op, result: result, callee: callee, args: args)
			default panic("ProvenanceTracer.traceIndirectCall: handed an op that is not an indirect call")
		end 'indirect'
	end 'traceIndirectCall'

	// ⭐ **A FUNCTION VALUE IS MINTED ONLY BY A `functionRef`** — a closure literal's lifted body, a named function
	// or a runtime entry referenced as a value — so a call through one lands on a body some `functionRef` named,
	// and answers as a witness dispatch does.
	//
	// ⚠ **WHAT A CLOSURE CAPTURED IS NOT IN ANY BODY'S SUMMARY.** Its environment is a word the lifted body reads
	// through, no record a summary ranks, and it arrives as the call's last argument. A body may hand back a
	// capture, or store one into an argument — a capture is never written from source, so nothing is stored into
	// one — and the function value itself carries the same records.
	function traceFunctionValueCall(func IrFunction, op MaxonOp, result ValueId, callee ValueId, args ValueIdArray)
		self.traceThroughLandingBodies(func, op: op, result: result, args: args, bodies: self.functionValueBodiesFor(args.count()))

		let environment = try args.get(args.count() - 1) otherwise panic("ProvenanceTracer.traceFunctionValueCall: a call through a function value passes its environment last, so it has an argument")

		if self.definesAnAlias(func, value: result) 'mayHandACaptureBack'
			self.flowFromWithin(result, from: environment)
			self.flowFromWithin(result, from: callee)
		end 'mayHandACaptureBack'

		for receiver in args 'eachReceiver'
			if receiver != environment and self.isTracked(receiver) 'mayReceiveACapture'
				self.unionContents(self.setOf(ProvenanceColumn.holds, value: receiver), source: environment)
				self.unionContents(self.setOf(ProvenanceColumn.holds, value: receiver), source: callee)
			end 'mayReceiveACapture'
		end 'eachReceiver'
	end 'traceFunctionValueCall'

	// The bodies a call through a function value passing `argCount` arguments can land on. The uniform ABI passes
	// the environment after the declared arguments, and a body appends its own companion parameters after its
	// declared ones, so a body declaring fewer parameters than the call passes is none it can land on.
	function functionValueBodiesFor(argCount ParamCount) returns CallLandingBodies
		if let memoized = try self.functionValueBodies.get(argCount) 'asked'
			return memoized
		end 'asked'

		self.gatherFunctionRefBodies()
		var found = CallLandingBodies.create()
		found.unresolved = self.functionRefBodies.unresolved

		for index in self.functionRefBodies.impls 'eachBody'
			if (try self.module.functions.get(index) otherwise panic("ProvenanceTracer.functionValueBodiesFor: function index {index} is past the module's functions")).paramCount + 1 >= argCount 'takesTheDeclaredArguments'
				found.impls.push(index)
			end 'takesTheDeclaredArguments'
		end 'eachBody'

		found.unresolvedMayStore = self.functionRefBodies.unresolvedMayStore
		self.functionValueBodies.upsert(argCount, value: found)
		return found
	end 'functionValueBodiesFor'

	function gatherFunctionRefBodies()
		if self.functionRefBodiesGathered 'gathered'
			return
		end 'gathered'

		self.functionRefBodiesGathered = true
		var bodies = CallLandingBodies.create()
		var named = BoolArray.create()
		named.refill(self.module.functions.count(), value: false)

		for op in self.module.ops 'eachOp'
			if maxonOpCalleeKind(op) == MaxonCalleeKind.functionValue 'aFunctionRef'
				noteFunctionRefBody(maxonOpCalleeName(op), byName: self.funcIndexByName, named: named, into: bodies)
			end 'aFunctionRef'
		end 'eachOp'

		self.functionRefBodies = bodies
	end 'gatherFunctionRefBodies'

	// A value this op defines that may share a record with another: tracked, and not a record the op minted.
	function definesAnAlias(func IrFunction, value ValueId) returns bool
		return self.isTracked(value) and not (try func.valueMintedSole.get(value) otherwise panic("ProvenanceTracer.definesAnAlias: valueMintedSole.get OOB at v{value}"))
	end 'definesAnAlias'

	// Anything reachable from any operand.
	function flowFromOperands(func IrFunction, op MaxonOp, result ValueId)
		if not self.definesAnAlias(func, value: result) 'fresh'
			return
		end 'fresh'

		maxonOpOperandValues(op, into: self.operands)

		for operand in self.operands 'eachOperand'
			self.flowFromWithin(result, from: operand)

			if mayBeOneRecord(valueTagOf(func, value: result), other: valueTagOf(func, value: operand)) 'mayBeTheOperand'
				self.unionMask(ProvenanceColumn.identity, to: result, from: ProvenanceColumn.identity, source: operand)
			end 'mayBeTheOperand'
		end 'eachOperand'
	end 'flowFromOperands'

	// ⭐ **A RETAIN, AN OWN, A CLONE HANDS BACK ITS OPERAND'S RECORD OR A COPY OF IT — NEVER A RECORD THE OPERAND
	// HOLDS.** So what the result may BE is what the operand may be, and what the operand holds the result holds:
	// `elements = newElements` retains the new array, which is not the old one it was filled from. A co-own that
	// forks image data (`forksImages`) hands back a copy of a module-level `let`'s image, never the image: a
	// durable store of one (`coOwnConcreteRecordForSink`) holds a record of its own.
	function flowThroughBookkeeping(func IrFunction, op MaxonOp, result ValueId, forksImages bool)
		if not self.definesAnAlias(func, value: result) 'fresh'
			return
		end 'fresh'

		maxonOpOperandValues(op, into: self.operands)

		for operand in self.operands 'eachOperand'
			self.unionShares(result, source: operand)
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.identity, source: operand)
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.inside, source: operand)

			if forksImages and self.tracingImmutableBindings 'aCopyOfAnImage'
				self.flowIdentityButImages(result, from: operand)
			end 'aCopyOfAnImage' else 'mayBeTheOperand'
				if mayBeOneRecord(valueTagOf(func, value: result), other: valueTagOf(func, value: operand)) 'oneRecord'
					self.unionMask(ProvenanceColumn.identity, to: result, from: ProvenanceColumn.identity, source: operand)
				end 'oneRecord'
			end 'mayBeTheOperand'

			if not self.readsParameterStorage(operand) 'whatItHolds'
				self.unionContents(self.setOf(ProvenanceColumn.holds, value: result), source: operand)
				self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.holdsWithin, source: operand)
				self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: operand)
			end 'whatItHolds'
		end 'eachOperand'
	end 'flowThroughBookkeeping'

	// Every rank `from` may be, as one `to` may be too — but a module-level `let` whose record is image data.
	function flowIdentityButImages(to ValueId, from ValueId)
		var chunk = self.sets.first(self.setOf(ProvenanceColumn.identity, value: from))

		while chunk != NoRootChunk 'eachWord'
			let mask = self.sets.wordOf(chunk)
			let firstRank = (self.sets.indexOf(chunk) as RootRank) shl RootWordShift

			for bit in 0 upto RootBitIndexMask + 1 'eachBit'
				let rank = firstRank + bit

				if maskHasParam(mask, param: bit) and not (self.isImmutableBindingRank(rank) and self.rootIsImageAt(rank)) 'notAnImage'
					self.seedBit(ProvenanceColumn.identity, value: to, rank: rank)
				end 'notAnImage'
			end 'eachBit'

			chunk = self.sets.next(chunk)
		end 'eachWord'
	end 'flowIdentityButImages'

	// `result` was read out of `addr` at `offset`: a record `addr` holds there, lying within it.
	function traceLoad(func IrFunction, result ValueId, addr ValueId, offset ByteOffset)
		if not self.definesAnAlias(func, value: result) 'fresh'
			return
		end 'fresh'

		self.unionShares(result, source: addr)
		self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.identity, source: addr)
		self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.inside, source: addr)
		let key = storeSlotKey(addr, offset: offset)

		if not self.readsParameterStorage(addr) 'whatTheRecordHolds'
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.holdsWithin, source: addr)
			self.unionMask(ProvenanceColumn.identity, to: result, from: ProvenanceColumn.holds, source: addr)
			self.unionMask(ProvenanceColumn.holds, to: result, from: ProvenanceColumn.holds, source: addr)
			self.unionMask(ProvenanceColumn.holds, to: result, from: ProvenanceColumn.deepHolds, source: addr)
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: addr)
			try self.hasLoadOrigin.set(result, value: true) otherwise panic("ProvenanceTracer.traceLoad: hasLoadOrigin.set OOB at v{result}")
			try self.loadOrigins.set(result, value: key) otherwise panic("ProvenanceTracer.traceLoad: loadOrigins.set OOB at v{result}")
		end 'whatTheRecordHolds'

		let stored = self.slotOfThisWalk(self.storeSlots, key: key)

		if stored != NoStoreSlotSet 'storedInto'
			self.unionInto(self.setOf(ProvenanceColumn.identity, value: result), from: stored)
		end 'storedInto'

		let storedInside = self.slotOfThisWalk(self.deepSlots, key: key)

		if storedInside != NoStoreSlotSet 'storedInsideIt'
			self.unionInto(self.setOf(ProvenanceColumn.holds, value: result), from: storedInside)
		end 'storedInsideIt'
	end 'traceLoad'

	// `value` now lies within `addr`, in the field `offset` names.
	function traceStore(addr ValueId, offset ByteOffset, value ValueId)
		if not self.isTracked(value) 'storesNoRecord'
			return
		end 'storesNoRecord'

		let key = storeSlotKey(addr, offset: offset)
		self.unionInto(self.slotFor(key), from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(self.deepSlotFor(key), source: value)
		self.unionMask(ProvenanceColumn.storedHolds, to: addr, from: ProvenanceColumn.identity, source: value)
		self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: addr), source: value)
		self.unionOverlap(addr, value: value)
		self.recordWhereValueLies(addr, value: value)
	end 'traceStore'

	// `value` now lies within `addr` — in a field no load can name, a store a call made, or deeper still.
	function traceWholeStore(addr ValueId, value ValueId, deep bool)
		if not self.isTracked(value) 'storesNoRecord'
			return
		end 'storesNoRecord'

		let contents = self.setOf(ProvenanceColumn.deepHolds, value: addr)
		self.unionInto(contents if deep else self.setOf(ProvenanceColumn.holds, value: addr), from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(contents, source: value)
		self.unionOverlap(addr, value: value)
		self.recordWhereValueLies(addr, value: value)
	end 'traceWholeStore'

	// What `addr` holds besides the stored record itself: the part of `value` that lies within something, and
	// the overlap. A record a load yielded is where the next load of the same field looks too.
	function unionOverlap(addr ValueId, value ValueId)
		self.unionContainedParts(addr, source: value)
		self.unionMask(ProvenanceColumn.shares, to: addr, from: ProvenanceColumn.shares, source: value)

		let loaded = try self.hasLoadOrigin.get(addr) otherwise panic("ProvenanceTracer.unionOverlap: hasLoadOrigin.get OOB at v{addr}")

		if loaded 'aLoadedRecord'
			let deep = self.deepSlotFor(try self.loadOrigins.get(addr) otherwise panic("ProvenanceTracer.unionOverlap: loadOrigins.get OOB at v{addr}"))
			self.unionInto(deep, from: self.setOf(ProvenanceColumn.identity, value: value))
			self.unionContents(deep, source: value)
		end 'aLoadedRecord'
	end 'unionOverlap'

	// `to` gains every record `source` contains, at whatever depth, that a read of it could reach.
	function unionContents(to RootSetId, source ValueId)
		self.unionInto(to, from: self.setOf(ProvenanceColumn.holds, value: source))
		self.unionInto(to, from: self.setOf(ProvenanceColumn.storedHolds, value: source))
		self.unionInto(to, from: self.setOf(ProvenanceColumn.deepHolds, value: source))
	end 'unionContents'

	// What every store owes whichever field it went into: where `value` now lies, and every root `addr` is or
	// lies within, whose own value is where a read through another name of that root looks.
	function recordWhereValueLies(addr ValueId, value ValueId)
		self.unionMask(ProvenanceColumn.placedWithin, to: value, from: ProvenanceColumn.identity, source: addr)
		self.unionMask(ProvenanceColumn.placedWithin, to: value, from: ProvenanceColumn.inside, source: addr)
		self.unionMask(ProvenanceColumn.placedWithin, to: value, from: ProvenanceColumn.placedWithin, source: addr)
		self.unionMask(ProvenanceColumn.shares, to: value, from: ProvenanceColumn.identity, source: addr)
		self.unionMask(ProvenanceColumn.shares, to: value, from: ProvenanceColumn.inside, source: addr)
		self.storeIntoEnclosingRoots(addr, value: value)
	end 'recordWhereValueLies'

	// Every root `addr` is or lies within now holds `value` — a root that is `value` itself widens what the roots
	// read through it hold, which the walk's fixpoint settles in whatever order the sets grow. Writable storage
	// past the parameters has no root value of its own; what a parameter trace stores there — module storage —
	// is its `escapes`.
	//
	// ⭐ **HOW DEEP THE STORE WENT DECIDES WHICH SET THE ROOT GAINS.** A store into another name for the root's
	// own record put `value` in one of its fields, which a load of the root may yield (`holds`). A store into a
	// record lying WITHIN the root reached it through that record, whose own sets and deep slot already say
	// so to a read along the same path; the root files it only for the summary (`storedDeep`). Were a read of
	// the root to see it, a body's LATER `self.keys.set(k, …)` would make an EARLIER call result drawn from
	// `self` contain `k`, and every field read out of that `k` — one set per value serves the whole body. The
	// root's own value needs neither for a store through it: the store already filed it on that value.
	function storeIntoEnclosingRoots(addr ValueId, value ValueId)
		self.storeIntoRootsOf(ProvenanceColumn.identity, addr: addr, value: value)
		self.storeIntoRootsOf(ProvenanceColumn.inside, addr: addr, value: value)
		self.storeIntoRootsOf(ProvenanceColumn.placedWithin, addr: addr, value: value)
	end 'storeIntoEnclosingRoots'

	// Every root in `addr`'s set in `enclosing`: a field of it when `addr` is that root's record, deeper otherwise.
	function storeIntoRootsOf(enclosing ProvenanceColumn, addr ValueId, value ValueId)
		let intoAField = enclosing == ProvenanceColumn.identity
		var chunk = self.sets.first(self.setOf(enclosing, value: addr))

		while chunk != NoRootChunk 'eachWord'
			let mask = self.sets.wordOf(chunk)
			let firstRank = (self.sets.indexOf(chunk) as RootRank) shl RootWordShift

			for bit in 0 upto RootBitIndexMask + 1 'eachBit'
				if maskHasParam(mask, param: bit) 'enclosedByThisRoot'
					self.storeIntoRoot(firstRank + bit, addr: addr, value: value, intoAField: intoAField)
				end 'enclosedByThisRoot'
			end 'eachBit'

			chunk = self.sets.next(chunk)
		end 'eachWord'
	end 'storeIntoRootsOf'

	function storeIntoRoot(rank RootRank, addr ValueId, value ValueId, intoAField bool)
		if rank == self.writableRank 'writableStorage'
			self.storeIntoEscapedSet(value)
			return
		end 'writableStorage'

		let root = self.rootValueAt(rank)

		if root == addr 'storedThroughTheRootItself'
			return
		end 'storedThroughTheRootItself'

		self.unionMask(ProvenanceColumn.shares, to: root, from: ProvenanceColumn.shares, source: value)

		if intoAField 'aFieldOfThisRoot'
			self.unionMask(ProvenanceColumn.holds, to: root, from: ProvenanceColumn.identity, source: value)
			self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: root), source: value)
			self.unionContainedParts(root, source: value)
			return
		end 'aFieldOfThisRoot'

		let deep = self.setOf(ProvenanceColumn.storedDeep, value: root)
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(deep, source: value)
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.inside, value: value))
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.placedWithin, value: value))
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.holdsWithin, value: value))
	end 'storeIntoRoot'

	function storeIntoEscapedSet(value ValueId)
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(self.escapedSet, source: value)
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.storedDeep, value: value))
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.inside, value: value))
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.holdsWithin, value: value))
	end 'storeIntoEscapedSet'

	// ⭐ **A CALL'S STORES COME FIRST, AND A VOID CALL HAS NOTHING ELSE.** A callee that stores one argument into
	// another launders it exactly as one that hands it back does — `arr.push(p)` then `arr.get(0)`, a setter then
	// a getter — so what the callee stores is applied before, and independently of, what it returns.
	function traceCall(func IrFunction, op MaxonOp, result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray)
		if not self.calleeHasSummary(callee) 'noSummary'
			let shape = runtimeCalleeStoreShape(callee)
			self.storeConservatively(func, args: args, shape: shape)

			if ownershipBookkeepingCallee(callee) 'theOperandsRecordOrACopy'
				self.flowThroughBookkeeping(func, op: op, result: result, forksImages: forksImageData(callee))
			end 'theOperandsRecordOrACopy' else 'anyRecordItReaches'
				self.flowFromOperands(func, op: op, result: result)
			end 'anyRecordItReaches'

			self.placeWhatTheResultMayBe(func, result: result, args: args, shape: shape)

			// ⭐ **AN INSERTION LINKS A NEW NODE INTO THE RECEIVER CHAIN AND HANDS BACK A HANDLE TO IT** — a
			// node the chain holds, as a reinsertion's is (`runtimeCalleeStoreShape`), and one the handle lies
			// within the chain as (`flowFromOperands`). So a walk of the chain may reach the node a `let`
			// handle names.
			if linksANewNodeCallee(callee) and args.count() > 0 'theChainHoldsTheNode'
				self.traceWholeStore(try args.get(0) otherwise panic("ProvenanceTracer.traceCall: an insertion has no receiver chain"), value: result, deep: false)
			end 'theChainHoldsTheNode'

			return
		end 'noSummary'

		let calleeIndex = try self.funcIndexByName.get(callee) otherwise panic("ProvenanceTracer.traceCall: '{String.from(callee)}' left the function index after `contains`")
		let sig = try self.project.funcSignatures.get(callee) otherwise panic("ProvenanceTracer.traceCall: '{String.from(callee)}' left the signature registry after `contains`")
		self.noteDependency(calleeIndex)
		self.slotNamedArgs(sig, args: args, argLabels: argLabels)
		self.storeThroughSummary(calleeIndex, args: args)
		self.bindThroughSummary(calleeIndex, args: args)

		if not self.definesAnAlias(func, value: result) 'returnsNoAlias'
			return
		end 'returnsNoAlias'

		for i in 0 upto args.count() 'eachArg'
			if self.argIsSlotted(i) 'slotted'
				self.flowThroughSummary(func, result: result, arg: try args.get(i) otherwise panic("ProvenanceTracer.traceCall: args.get OOB at {i}"), calleeIndex: calleeIndex, pos: self.argPositionAt(i))
			end 'slotted'
		end 'eachArg'
	end 'traceCall'

	// ⭐ **A RECORD A RUNTIME ENTRY HANDS BACK MAY BE THE ONE IT WAS HANDED** — a retain, an own — so where the
	// result is put, that one is: a body that pushes `__mm_own(block)` and returns `block` returns a record its
	// container holds. Placement and overlap flow back from result to operand, and the walk's fixpoint carries a
	// store made after the call.
	function placeWhatTheResultMayBe(func IrFunction, result ValueId, args ValueIdArray, shape RuntimeStoreShape)
		if shape != RuntimeStoreShape.nothing or not self.isTracked(result) 'notAHandBack'
			return
		end 'notAHandBack'

		for operand in args 'eachOperand'
			if self.isTracked(operand) and self.valuesMayBeOneRecord(func, value: result, other: operand) 'mayBeIt'
				self.unionMask(ProvenanceColumn.placedWithin, to: operand, from: ProvenanceColumn.placedWithin, source: result)
				self.unionMask(ProvenanceColumn.shares, to: operand, from: ProvenanceColumn.shares, source: result)
			end 'mayBeIt'
		end 'eachOperand'
	end 'placeWhatTheResultMayBe'

	// ⭐ **WHERE A CALL WITH NO SUMMARY MAY STORE WHAT IT WAS HANDED** — where its `RuntimeStoreShape` allows,
	// and only into an argument that can hold a record. A runtime entry writes only the container records it
	// manages — a struct's or a union's box is written by ops, never by the runtime — so an argument that is no
	// container, or a container of values that hold no record (`Array with Byte`), cannot receive one.
	function storeConservatively(func IrFunction, args ValueIdArray, shape RuntimeStoreShape)
		for j in 0 upto args.count() 'eachReceiver'
			let receiver = try args.get(j) otherwise panic("ProvenanceTracer.storeConservatively: args.get OOB at {j}")

			if not shapeStoresInto(shape, receiverIndex: j) or not self.isTracked(receiver) or not self.mayHoldARecord(func, value: receiver) 'cannotHoldARecord'
				continue
			end 'cannotHoldARecord'

			for i in 0 upto args.count() 'eachStored'
				if i != j and shapeStoresOperand(shape, storedIndex: i) 'another'
					self.traceWholeStore(receiver, value: try args.get(i) otherwise panic("ProvenanceTracer.storeConservatively: args.get OOB at {i}"), deep: false)
				end 'another'
			end 'eachStored'
		end 'eachReceiver'
	end 'storeConservatively'

	// ⭐ **A PARAMETER HANDED ON TO A CALLEE THAT BINDS IT TO A MUTABLE NAME IS BOUND BY THIS BODY TOO** — the
	// `binds` column's transitive half; the direct half is `gatherStores`' name-bind sites. Only a parameter
	// trace ranks what a summary means.
	function bindThroughSummary(calleeIndex FuncIndex, args ValueIdArray)
		let binds = self.summary.bindsAt(calleeIndex)

		if self.tracingImmutableBindings or binds == NoParamPositions 'bindsNothingOfOurs'
			return
		end 'bindsNothingOfOurs'

		for i in 0 upto args.count() 'eachArg'
			if self.argIsSlotted(i) and maskHasParam(binds, param: self.argPositionAt(i)) 'boundByTheCallee'
				self.returnedBinds = self.returnedBinds or self.wordAt(ProvenanceColumn.identity, value: try args.get(i) otherwise panic("ProvenanceTracer.bindThroughSummary: args.get OOB at {i}"), word: 0)
			end 'boundByTheCallee'
		end 'eachArg'
	end 'bindThroughSummary'

	// Can a runtime entry store a record into `value`? A container instance can when an element may be one, and
	// an opaque value may stand for such a container.
	function mayHoldARecord(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tagIsOpaqueRecord(tag) 'mayBeAContainer'
			return true
		end 'mayBeAContainer'

		if tag != ValueTypeTag.genericInstance 'notAContainer'
			return false
		end 'notAContainer'

		let gid = self.instanceIdOf(func, value: value)

		if self.instanceHoldsARecord.contains(gid) 'asked'
			return try self.instanceHoldsARecord.get(gid) otherwise panic("ProvenanceTracer.mayHoldARecord: instance {gid} left the memo after `contains`")
		end 'asked'

		let holds = self.signatures.instanceArgsMayHoldARecord(gid)
		self.instanceHoldsARecord.upsert(gid, value: holds)
		return holds
	end 'mayHoldARecord'

	// What a callee's summary says it stores, said of the arguments in `argPositions`: a parameter stored into
	// module storage escapes, and one stored into another parameter's record is stored into that argument.
	function storeThroughSummary(calleeIndex FuncIndex, args ValueIdArray)
		let escapes = self.summary.escapesAt(calleeIndex)

		for i in 0 upto args.count() 'eachStored'
			let stored = try args.get(i) otherwise panic("ProvenanceTracer.storeThroughSummary: args.get OOB at {i}")

			if not self.argIsSlotted(i) or not self.isTracked(stored) 'notAStoredRecord'
				continue
			end 'notAStoredRecord'

			let pos = self.argPositionAt(i)

			if maskHasParam(escapes, param: pos) 'escapes'
				self.storeIntoEscapedSet(stored)
			end 'escapes'

			for j in 0 upto args.count() 'eachReceiver'
				if j == i or not self.argIsSlotted(j) 'notAnotherParameter'
					continue
				end 'notAnotherParameter'

				let receiver = try args.get(j) otherwise panic("ProvenanceTracer.storeThroughSummary: args.get OOB at {j}")
				let into = self.argPositionAt(j)

				if maskHasParam(self.summary.storesAt(calleeIndex, into: into), param: pos) 'intoAField'
					self.traceWholeStore(receiver, value: stored, deep: false)
				end 'intoAField' else if maskHasParam(self.summary.storesDeepAt(calleeIndex, into: into), param: pos) 'deeperIn'
					self.traceWholeStore(receiver, value: stored, deep: true)
				end 'deeperIn'
			end 'eachReceiver'
		end 'eachStored'
	end 'storeThroughSummary'

	// Each argument's parameter position, by its label.
	function slotNamedArgs(sig FuncSignature, args ValueIdArray, argLabels ByteArrayArray)
		self.argPositions.clear()
		self.calleeParamCount = sig.paramCount()

		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("ProvenanceTracer.slotNamedArgs: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
			self.argPositions.push(argSlotPosition(sig.paramNames, argIndex: i, label: label))
		end 'eachArg'
	end 'slotNamedArgs'

	// A witness dispatch's arguments are positional, the receiver first.
	function slotPositionalArgs(args ValueIdArray)
		self.argPositions.clear()
		self.calleeParamCount = args.count()

		for i in 0 upto args.count() 'eachArg'
			self.argPositions.push(i)
		end 'eachArg'
	end 'slotPositionalArgs'

	function argPositionAt(i ParamCount) returns ParamCount
		return try self.argPositions.get(i) otherwise panic("ProvenanceTracer.argPositionAt: argument {i} is past the {self.argPositions.count()} slotted")
	end 'argPositionAt'

	function argIsSlotted(i ParamCount) returns bool
		return self.argPositionAt(i) < self.calleeParamCount
	end 'argIsSlotted'

	// A witness dispatch lands on one conformer's implementation, so its result is whatever any of them may
	// hand back and its stores whatever any of them may make. A conformer this module declares no body for is
	// described by no summary, so its result may be anything the operands reach; it stores nothing, being
	// compiler-synthesized to the requirement's shape (`addWitnessParamEdges` rests on the same fact).
	function traceWitnessDispatch(func IrFunction, op MaxonOp, result ValueId, args ValueIdArray, methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex)
		self.traceThroughLandingBodies(func, op: op, result: result, args: args, bodies: self.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex))
	end 'traceWitnessDispatch'

	// Through every body a call may land on, its arguments positional. A body the parser skipped as unreached is
	// one no call here can land on (`WitnessDispatchTargets.candidatesFor`).
	function traceThroughLandingBodies(func IrFunction, op MaxonOp, result ValueId, args ValueIdArray, bodies CallLandingBodies)
		if bodies.unresolvedMayStore 'aBodyMayStoreAnything'
			self.storeConservatively(func, args: args, shape: RuntimeStoreShape.intoAnyOperand)
		end 'aBodyMayStoreAnything'

		if bodies.unresolved 'aBodyNoSummaryDescribes'
			self.flowFromOperands(func, op: op, result: result)
		end 'aBodyNoSummaryDescribes'

		for impl in bodies.impls 'eachImpl'
			if self.implWasSkippedAsUnreached(impl) 'notInThisProgram'
				continue
			end 'notInThisProgram'

			if not self.implHasSummary(impl) 'noSummary'
				self.storeConservatively(func, args: args, shape: RuntimeStoreShape.intoAnyOperand)
				self.flowFromOperands(func, op: op, result: result)
				continue
			end 'noSummary'

			self.noteDependency(impl)
			self.slotPositionalArgs(args)
			self.storeThroughSummary(impl, args: args)
			self.bindThroughSummary(impl, args: args)

			if self.definesAnAlias(func, value: result) 'returnsAnAlias'
				for i in 0 upto args.count() 'eachArg'
					self.flowThroughSummary(func, result: result, arg: try args.get(i) otherwise panic("ProvenanceTracer.traceThroughLandingBodies: args.get OOB at {i}"), calleeIndex: impl, pos: i)
				end 'eachArg'
			end 'returnsAnAlias'
		end 'eachImpl'
	end 'traceThroughLandingBodies'

	// A callee answers through its summary only when the program declares it, with a signature to slot its
	// arguments by and a body the trace read.
	function calleeHasSummary(callee ByteArray) returns bool
		if not self.funcIndexByName.contains(callee) or not self.project.funcSignatures.contains(callee) 'undeclared'
			return false
		end 'undeclared'

		return self.implHasSummary(try self.funcIndexByName.get(callee) otherwise panic("ProvenanceTracer.calleeHasSummary: '{String.from(callee)}' left the function index after `contains`"))
	end 'calleeHasSummary'

	// ⚠ A body the parser skipped as unreached is one empty block, which a trace would summarise as handing
	// back nothing — so the answer would turn on whether some other call made the body reachable.
	function implHasSummary(index FuncIndex) returns bool
		return not bodyIsUnreadable(try self.module.functions.get(index) otherwise panic("ProvenanceTracer.implHasSummary: function index {index} is past the module's functions"))
	end 'implHasSummary'

	function implWasSkippedAsUnreached(index FuncIndex) returns bool
		return (try self.module.functions.get(index) otherwise panic("ProvenanceTracer.implWasSkippedAsUnreached: function index {index} is past the module's functions")).bodyWasSkippedAsUnreached
	end 'implWasSkippedAsUnreached'

	function implsOf(methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex) returns CallLandingBodies
		let key = ((interfaceDeclIndex as WitnessSlotKey) shl WitnessSlotKeyShift) or (methodIndex as WitnessSlotKey)

		if self.witnessImpls.contains(key) 'asked'
			return try self.witnessImpls.get(key) otherwise panic("ProvenanceTracer.implsOf: slot {key} left the memo after `contains`")
		end 'asked'

		let found = witnessDispatchImpls(self.project, signatures: self.signatures, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, funcIndexByName: self.funcIndexByName, conformers: self.conformers, witnessSlots: self.witnessSlots)
		self.witnessImpls.upsert(key, value: found)
		return found
	end 'implsOf'

	// What the callee's summary says its result is to parameter `pos`, said of `arg`.
	function flowThroughSummary(func IrFunction, result ValueId, arg ValueId, calleeIndex FuncIndex, pos ParamCount)
		if not maskHasParam(self.summary.sharesAt(calleeIndex), param: pos) 'unrelated'
			return
		end 'unrelated'

		let isTheArgument = maskHasParam(self.summary.identityAt(calleeIndex), param: pos)
		let holdsTheArgument = maskHasParam(self.summary.holdsAt(calleeIndex), param: pos)
		let withinTheArgument = maskHasParam(self.summary.insideAt(calleeIndex), param: pos)
		let takesItsContents = not self.readsParameterStorage(arg)
		self.unionShares(result, source: arg)

		if isTheArgument 'isIt'
			self.flowIdentity(result, from: arg)
		end 'isIt'

		if holdsTheArgument 'holdsIt'
			self.flowContents(result, from: arg)
		end 'holdsIt'

		// Within the argument, or overlapping it: either way a record the argument holds may be reached.
		if takesItsContents and (withinTheArgument or not (isTheArgument or holdsTheArgument)) 'reachesWhatItHolds'
			self.unionContents(self.setOf(ProvenanceColumn.holds, value: result), source: arg)
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: arg)
		end 'reachesWhatItHolds'

		if withinTheArgument 'withinIt'
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.identity, source: arg)
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.inside, source: arg)
		end 'withinIt'

		if takesItsContents and withinTheArgument 'withinWhatItHolds'
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.holdsWithin, source: arg)
		end 'withinWhatItHolds'

		// ⚠ **A RESULT THAT IS THE ARGUMENT IS NOT ALSO ONE OF ITS ELEMENTS.** A retain is an op this walk
		// cannot see into, so a callee that returns its parameter through one is summarised as possibly lying
		// within it too; read as "may be anything the argument holds", that turns every record a caller put into
		// a box into the box itself. Only a result that CAN be the argument is taken for it, though: a generic
		// body's `T` may be anything, so `Array.pop` is summarised as possibly returning its receiver, and at a
		// call whose types say the element is no array, the element is what it returns.
		let mayBeTheArgument = isTheArgument and self.valuesMayBeOneRecord(func, value: result, other: arg)

		if takesItsContents and withinTheArgument and not mayBeTheArgument 'anElementOfIt'
			self.unionHolds(ProvenanceColumn.identity, to: result, source: arg)
		end 'anElementOfIt'

		// A result the callee stored into the argument lies within it, and says nothing more about what it holds.
		if maskHasParam(self.summary.placedWithinAt(calleeIndex), param: pos) 'placedInIt'
			self.unionMask(ProvenanceColumn.placedWithin, to: result, from: ProvenanceColumn.identity, source: arg)
			self.unionMask(ProvenanceColumn.placedWithin, to: result, from: ProvenanceColumn.inside, source: arg)
			self.unionMask(ProvenanceColumn.placedWithin, to: result, from: ProvenanceColumn.placedWithin, source: arg)
		end 'placedInIt'

		// A result holding a record that lies within the argument reaches the argument's storage, whichever of it.
		if maskHasParam(self.summary.holdsWithinAt(calleeIndex), param: pos) 'holdsAPartOfIt'
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.identity, source: arg)
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.inside, source: arg)

			if takesItsContents 'andWhatItHolds'
				self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: arg)
				self.unionContents(self.setOf(ProvenanceColumn.holdsWithin, value: result), source: arg)
			end 'andWhatItHolds'
		end 'holdsAPartOfIt'
	end 'flowThroughSummary'

	// `to` may be `from`'s own record: every fact carries.
	function flowIdentity(to ValueId, from ValueId)
		self.unionShares(to, source: from)
		self.unionMask(ProvenanceColumn.identity, to: to, from: ProvenanceColumn.identity, source: from)
		self.unionHolds(ProvenanceColumn.holds, to: to, source: from)
		self.unionMask(ProvenanceColumn.deepHolds, to: to, from: ProvenanceColumn.deepHolds, source: from)
		self.unionMask(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.inside, source: from)
		self.unionMask(ProvenanceColumn.placedWithin, to: to, from: ProvenanceColumn.placedWithin, source: from)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.holdsWithin, source: from)
	end 'flowIdentity'

	// `to` was built containing `from`, and so `from`'s record, and deeper everything `from` contains.
	function flowContents(to ValueId, from ValueId)
		self.unionMask(ProvenanceColumn.holds, to: to, from: ProvenanceColumn.identity, source: from)
		self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: to), source: from)
		self.unionContainedParts(to, source: from)
		self.unionShares(to, source: from)
	end 'flowContents'

	// `to` may be a record `from` holds, or contain what it contains.
	function flowFromWithin(to ValueId, from ValueId)
		self.unionShares(to, source: from)
		self.unionMask(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.identity, source: from)
		self.unionMask(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.inside, source: from)

		if self.readsParameterStorage(from) 'theCallersToJudge'
			return
		end 'theCallersToJudge'

		self.unionHolds(ProvenanceColumn.identity, to: to, source: from)
		self.unionContents(self.setOf(ProvenanceColumn.holds, value: to), source: from)
		self.unionMask(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.holdsWithin, source: from)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.holdsWithin, source: from)
	end 'flowFromWithin'

	// Is a read out of `from` a read out of a parameter's record — in a trace of the immutable bindings, whose
	// parameter ranks follow the bindings (see the header)?
	function readsParameterStorage(from ValueId) returns bool
		return self.tracingImmutableBindings and (self.namesAParameter(ProvenanceColumn.identity, value: from) or self.namesAParameter(ProvenanceColumn.inside, value: from))
	end 'readsParameterStorage'

	function namesAParameter(column ProvenanceColumn, value ValueId) returns bool
		var chunk = self.sets.first(self.setOf(column, value: value))

		while chunk != NoRootChunk 'eachWord'
			let word = self.sets.indexOf(chunk)

			if word >= self.parameterRankWords.count() 'pastEveryParameter'
				return false
			end 'pastEveryParameter'

			if (self.sets.wordOf(chunk) and (try self.parameterRankWords.get(word) otherwise panic("ProvenanceTracer.namesAParameter: parameterRankWords.get OOB at {word}"))) != NoParamPositions 'aParameter'
				return true
			end 'aParameter'

			chunk = self.sets.next(chunk)
		end 'eachWord'

		return false
	end 'namesAParameter'

	function unionShares(to ValueId, source ValueId)
		self.unionMask(ProvenanceColumn.shares, to: to, from: ProvenanceColumn.shares, source: source)
	end 'unionShares'

	// Everything `source` contains, however it came to: produced so, or stored into it since.
	function unionHolds(column ProvenanceColumn, to ValueId, source ValueId)
		self.unionMask(column, to: to, from: ProvenanceColumn.holds, source: source)
		self.unionMask(column, to: to, from: ProvenanceColumn.storedHolds, source: source)
	end 'unionHolds'

	// `to` now contains `source`, so it holds a part of every root `source` lies within or holds a part of.
	function unionContainedParts(to ValueId, source ValueId)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.inside, source: source)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.placedWithin, source: source)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.holdsWithin, source: source)
	end 'unionContainedParts'

	function recordReturn(terminator MaxonOp)
		match terminator 'term'
			ret(returned) then self.addReturned(returned)
			call or
				literal or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				loadIndirect or
				storeIndirect or
				stringLiteral or
				tryCall or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				indirectCall or
				asyncCall or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				witnessDispatch or
				witnessTryDispatch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic then break 'term'
		end 'term'
	end 'recordReturn'

	// A parameter trace ranks only the parameters in word 0, so a value's word 0 IS its summary mask.
	function addReturned(value ValueId)
		self.returnedShares = self.returnedShares or self.wordAt(ProvenanceColumn.shares, value: value, word: 0)
		self.returnedIdentity = self.returnedIdentity or self.wordAt(ProvenanceColumn.identity, value: value, word: 0)
		self.returnedHolds = self.returnedHolds or self.wordAt(ProvenanceColumn.holds, value: value, word: 0) or self.wordAt(ProvenanceColumn.storedHolds, value: value, word: 0) or self.wordAt(ProvenanceColumn.deepHolds, value: value, word: 0)
		self.returnedInside = self.returnedInside or self.wordAt(ProvenanceColumn.inside, value: value, word: 0)
		self.returnedHoldsWithin = self.returnedHoldsWithin or self.wordAt(ProvenanceColumn.holdsWithin, value: value, word: 0)
		self.returnedPlacedWithin = self.returnedPlacedWithin or self.wordAt(ProvenanceColumn.placedWithin, value: value, word: 0)
	end 'addReturned'

	function noteDependency(callee FuncIndex)
		if self.recording 'firstPass'
			self.dependencyCallees.push(callee)
			self.dependencyCallers.push(self.recordingCaller)
		end 'firstPass'
	end 'noteDependency'

	// ⭐ **A WRITE THROUGH A VALUE THAT MAY BE A PARAMETER'S RECORD IS A WRITE OF THAT PARAMETER.** `var x =
	// pass(p)` then `x.append(…)` writes `p`, so the call handing `x` to a written position is an edge from
	// `p` exactly as `grow(p)` is, and a container method writing `x` as its receiver writes `p` exactly as
	// `p.push(9)` does (`receiverWriteSeeds`). `collectCallParamEdges` records an argument that IS a parameter,
	// and the parser a receiver that is one; this adds every argument and receiver whose `identity` names one.
	// Identity only: a write through a field is not a write of the root (`IrFunction.writtenParamMask`'s table).
	// Returns `base` itself when no edge is added.
	export function collectProvenanceParamEdges(base CallParamEdges, funcNames FunctionNameIndex) returns CallParamEdges
		let ir = self.module
		var edges = base
		var copied = false

		for i in 0 upto funcNames.functions.count() 'eachFunc'
			let func = try funcNames.functions.get(i) otherwise panic("collectProvenanceParamEdges: functions.get OOB at {i} below its own count")

			if not self.anyParameterHoldsARecord(func) 'nothingOfItsOwnToWrite'
				continue
			end 'nothingOfItsOwnToWrite'

			self.traceParameters(func)
			self.seedReceiverWrites(func, index: i)

			for blockRef in func.blockRefs 'eachBlock'
				let block = try ir.blocks.get(blockRef) otherwise panic("collectProvenanceParamEdges: blockRef from func.blockRefs not in module.blocks")

				for opIdx in block.opRefs 'eachOp'
					let op = try ir.ops.get(opIdx) otherwise panic("collectProvenanceParamEdges: opIdx {opIdx} not in module.ops")

					if not self.passesAParameterAlias(func, op: op) 'noAliasedArgument'
						continue
					end 'noAliasedArgument'

					if not copied 'firstAliasEdge'
						edges = base.copy()
						copied = true
					end 'firstAliasEdge'

					self.addAliasEdgesAt(func, op: op, callerIndex: i, edges: edges)
				end 'eachOp'
			end 'eachBlock'
		end 'eachFunc'

		return edges
	end 'collectProvenanceParamEdges'

	function seedReceiverWrites(func IrFunction, index FuncIndex)
		var written = NoParamPositions

		for site in func.provenanceSites().receiverWrites 'eachWrite'
			written = written or self.parameterAliasOf(func, arg: site.receiver)
		end 'eachWrite'

		if written != NoParamPositions 'writesAParameter'
			let before = try self.receiverWriteSeeds.get(index) otherwise panic("ProvenanceTracer.seedReceiverWrites: receiverWriteSeeds.get OOB at {index}")
			try self.receiverWriteSeeds.set(index, value: before or written) otherwise panic("ProvenanceTracer.seedReceiverWrites: receiverWriteSeeds.set OOB at {index}")
		end 'writesAParameter'
	end 'seedReceiverWrites'

	function passesAParameterAlias(func IrFunction, op MaxonOp) returns bool
		return match op 'op'
			call(_, _, args, _, _, _, _, _) gives self.argsAliasAParameter(func, args: args)
			tryCall(_, _, _, args, _, _, _, _, _) gives self.argsAliasAParameter(func, args: args)
			witnessDispatch(_, args, _, _, _, _, _) gives self.argsAliasAParameter(func, args: args)
			witnessTryDispatch(_, _, args, _, _, _, _) gives self.argsAliasAParameter(func, args: args)

			// ⭐ **A SPAWN CARRIES THE ALIAS EDGE TOO, AND NEEDS IT MORE THAN A DIRECT CALL DOES**: the spawn takes
			// its own reference to a managed argument (`Parser.transferAsyncSpawnArgs`), so the value standing at
			// the op is that RETAIN and never the parameter's own — without this arm nothing relates the two and
			// the target's writes stop at its own frame.
			asyncCall(_, _, args, _, _, _, _) gives self.argsAliasAParameter(func, args: args)

			// An indirect call has no summary to carry an edge to, for `collectCallParamEdgesAt`'s reason, and a
			// message hands its arguments to another green thread.
			literal or
				ret or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				loadIndirect or
				storeIndirect or
				stringLiteral or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				indirectCall or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic gives false
		end 'op'
	end 'passesAParameterAlias'

	function argsAliasAParameter(func IrFunction, args ValueIdArray) returns bool
		for arg in args 'eachArg'
			if self.parameterAliasOf(func, arg: arg) != NoParamPositions 'aliased'
				return true
			end 'aliased'
		end 'eachArg'

		return false
	end 'argsAliasAParameter'

	// The parameters a value may be the record of, when it is not a parameter itself — that case is the
	// parser's own edge or seed already. A record of another type is not the parameter's.
	function parameterAliasOf(func IrFunction, arg ValueId) returns ParamPositionMask
		if arg < valueIdAtParamPosition(func.paramCount) 'itIsTheParameter'
			return NoParamPositions
		end 'itIsTheParameter'

		let mayBe = self.wordAt(ProvenanceColumn.identity, value: arg, word: 0)
		var typed = NoParamPositions

		for p in 0 upto func.paramCount 'eachParam'
			if maskHasParam(mayBe, param: p) and self.valuesMayBeOneRecord(func, value: arg, other: valueIdAtParamPosition(p)) 'ofItsType'
				typed = maskWithParam(typed, param: p)
			end 'ofItsType'
		end 'eachParam'

		return typed
	end 'parameterAliasOf'

	function addAliasEdgesAt(func IrFunction, op MaxonOp, callerIndex FuncIndex, edges CallParamEdges)
		match op 'op'
			call(_, callee, args, argLabels, _, _, _, _) then self.addNamedCallAliasEdges(func, callee: callee, args: args, argLabels: argLabels, callerIndex: callerIndex, edges: edges)
			tryCall(_, _, callee, args, argLabels, _, _, _, _) then self.addNamedCallAliasEdges(func, callee: callee, args: args, argLabels: argLabels, callerIndex: callerIndex, edges: edges)
			witnessDispatch(_, args, _, methodIndex, interfaceDeclIndex, _, _) then self.addWitnessAliasEdges(func, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, callerIndex: callerIndex, edges: edges)
			witnessTryDispatch(_, _, args, _, methodIndex, interfaceDeclIndex, _) then self.addWitnessAliasEdges(func, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, callerIndex: callerIndex, edges: edges)
			asyncCall(_, callee, args, argLabels, _, _, _) then self.addNamedCallAliasEdges(func, callee: callee, args: args, argLabels: argLabels, callerIndex: callerIndex, edges: edges)
			default panic("ProvenanceTracer.addAliasEdgesAt: `passesAParameterAlias` admits only the five call shapes above")
		end 'op'
	end 'addAliasEdgesAt'

	function addNamedCallAliasEdges(func IrFunction, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, callerIndex FuncIndex, edges CallParamEdges)
		if not self.calleeHasSummary(callee) 'noSummary'
			return
		end 'noSummary'

		let calleeIndex = try self.funcIndexByName.get(callee) otherwise panic("ProvenanceTracer.addNamedCallAliasEdges: '{String.from(callee)}' left the function index after `contains`")
		let sig = try self.project.funcSignatures.get(callee) otherwise panic("ProvenanceTracer.addNamedCallAliasEdges: '{String.from(callee)}' left the signature registry after `contains`")
		self.slotNamedArgs(sig, args: args, argLabels: argLabels)

		for i in 0 upto args.count() 'eachArg'
			if self.argIsSlotted(i) 'slotted'
				recordAliasEdges(self.parameterAliasOf(func, arg: try args.get(i) otherwise panic("ProvenanceTracer.addNamedCallAliasEdges: args.get OOB at {i}")), calleeIndex: calleeIndex, callerIndex: callerIndex, calleeParam: self.argPositionAt(i), edges: edges)
			end 'slotted'
		end 'eachArg'
	end 'addNamedCallAliasEdges'

	function addWitnessAliasEdges(func IrFunction, args ValueIdArray, methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex, callerIndex FuncIndex, edges CallParamEdges)
		for impl in self.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex).impls 'eachImpl'
			for i in 0 upto args.count() 'eachArg'
				recordAliasEdges(self.parameterAliasOf(func, arg: try args.get(i) otherwise panic("ProvenanceTracer.addWitnessAliasEdges: args.get OOB at {i}")), calleeIndex: impl, callerIndex: callerIndex, calleeParam: i, edges: edges)
			end 'eachArg'
		end 'eachImpl'
	end 'addWitnessAliasEdges'

	// ⭐⭐ **THE OWNERSHIP MODEL'S DOORS, WHERE THE PARSER COULD NOT DECIDE BY NAME.** A record is reachable through
	// immutable names or through mutable paths, never both at once: mutable holders may share it, and so may
	// immutable names, but a mutable door takes an immutable name's record only by moving the name. Every door is
	// asked by LIVENESS: it is refused only where a record the value may be or lie within is reached by an
	// immutable name live after it — a `let` to its last use (and to the end of a loop it was bound before and used
	// in), a module-level `let` everywhere. Each function is traced once and asked at every door it recorded and
	// every call it makes; its refusals are reported in source order.
	//
	// | door | a sole `let` handed whole | a value an immutable name live after it reaches | code |
	// |---|---|---|---|
	// | a `var` bound or assigned | moves it | refused | E3078 |
	// | a container method writing its receiver | — | refused, E3019 when it may BE the record | E3159 |
	// | a field write through a record | — | refused | E3159 |
	//
	// A moved name read afterwards is E3102, and a move out of a loop the name was declared outside of is E2015. A
	// store and an argument co-own what they are handed — mutable holders may share a record — so neither is a door:
	// what the program writes through what they took is. A module-level `let` that is image data is copied by every
	// store, so a write never reaches it; a `var` door can still alias it. A value that is an immutable record
	// (`ProgramSignatures.recordTypeIsImmutable`) is written by nothing, and meets no door.
	//
	// A graph LENT to a service is frozen from its send on, liveness or not (`checkLentGraphs`), and asked first, so a
	// door it refuses is not asked again as one of the doors above.
	export function checkStorageDoors(mutationSummary ParamMutationSummary)
		let ir = self.module
		self.traceLentHandlers(mutationSummary)

		for i in 0 upto ir.functions.count() 'eachFunc'
			let func = try ir.functions.get(i) otherwise panic("ProvenanceTracer.checkStorageDoors: functions.get OOB at {i} below its own count")
			let sites = func.provenanceSites()
			let lends = sites.lendSites.count() > 0

			if sites.immutableBindings.values.count() == 0 and not sites.hasVarCandidates and not lends 'nothingToAsk'
				continue
			end 'nothingToAsk'

			let bindingCount = self.bindingsTraceOf(func, index: i)
			self.refusals.clear()
			self.leaveDoor()
			self.frozenDoorValues.refill(func.valueTags.count(), value: false)

			if bindingCount > 0 or lends 'rootsToReach'
				self.gatherWrittenTargets(func, index: i)
			end 'rootsToReach'

			if lends 'lentGraphs'
				self.checkLentGraphs(func, ir: ir, mutationSummary: mutationSummary)
			end 'lentGraphs'

			if bindingCount > 0 'bindingRootsToReach'
				self.checkMoveSites(func)
				self.checkMutableBindingSites(func, ir: ir)
				self.checkReceiverWrites(func, ir: ir)
				self.checkWriteThroughSites(func, ir: ir)
				self.checkWrittenArguments(func, ir: ir)
			end 'bindingRootsToReach'

			self.reportRefusals(func)

			if sites.hasVarCandidates 'mayWithholdE3077'
				self.settleVarShouldBeLet(func)
			end 'mayWithholdE3077'
		end 'eachFunc'

		self.dropWithdrawnHygiene()
	end 'checkStorageDoors'

	// ⭐⭐⭐ **THE FREEZE ON A LENT GRAPH, WHOLE-PROGRAM (E3160).** A message argument that is a `let` local is LENT:
	// the sender goes on reading it and the service reads the same graph, so from the send on nothing may reach it
	// through storage that could write it. The parser refused the lent binding itself at a door after the send
	// (`Parser.requireNotLentThrough`); what needs every body is asked here, of each send the function made:
	//
	//   • the HANDLER at the other end, whose parameter is frozen for its whole body — one it writes refuses the
	//     send E3019, and one that escapes through a door refuses it E3160 naming the escape (`traceLentHandlers`);
	//   • every door of this body a value reaches after the send that may be, lie within or hold the lent record —
	//     a value read out of the binding, a door a loop's next trip reaches, and a callee that keeps or writes what
	//     it is handed.
	//
	// A value whose type holds nothing a statement can write is frozen by its type (`valueHoldsNothingWritable`).
	// A door FOLLOWS a send where the control flow reaches it from the send (`doorFollowsLend`), so a door on
	// another arm of the `if` or `match` the send is on is not one, and a door the next trip of a loop reaches is.
	function checkLentGraphs(func IrFunction, ir MaxonModule, mutationSummary ParamMutationSummary)
		self.frozenRanks.clear()
		self.frozenLends.clear()

		for site in func.provenanceSites().lendSites 'eachLend'
			if self.valueHoldsNothingWritable(func, value: site.value) 'frozenByItsType'
				continue
			end 'frozenByItsType'

			self.judgeLentHandler(func, site: site, mutationSummary: mutationSummary)
			let rank = self.lentRankOf(site.value)

			// Only a `let` local owning a managed record lends (`Parser.ownerLendsValue`), and the trace ranks every
			// one of those — as an immutable binding, or as the record a `var` gave it. A lend with no rank would be
			// a graph frozen by nothing, which is the refusal going silently missing.
			if rank == NoRootRank 'noRecordToFreeze'
				panic("ProvenanceTracer.checkLentGraphs: `{String.from(site.root)}`, lent to `{String.from(qualifiedMethodName(site.serviceType, methodName: site.message))}` at {site.line}:{site.column} of '{String.from(func.name)}', has no traced record — every lending binding is a ranked root")
			end 'noRecordToFreeze'

			self.frozenRanks.push(rank)
			self.frozenLends.push(site)
		end 'eachLend'

		if self.frozenRanks.count() == 0 'nothingFrozenHere'
			return
		end 'nothingFrozenHere'

		self.mapLendFlow(func, ir: ir)

		for door in self.freezeDoorsOf(func, ir: ir, mutationSummary: mutationSummary, includeWrites: true) 'eachDoor'
			let k = self.lendFreezing(func, door: door)

			if k != NoFrozenLend 'afterALend'
				self.refuseFrozenDoor(func, door: door, lend: try self.frozenLends.get(k) otherwise panic("ProvenanceTracer.checkLentGraphs: frozenLends.get OOB at {k}"))
			end 'afterALend'
		end 'eachDoor'
	end 'checkLentGraphs'

	// ⭐⭐ **WHICH BLOCKS EACH SEND'S FREEZE REACHES, ONCE PER LEND** — every block the control flow can enter after
	// the send, a loop's back edge included, stopping where the lent binding is bound again (`rebindingOf`): past
	// that the name holds a record the send never lent. One row of `frozenReach` per lend, so each door is then a
	// lookup.
	function mapLendFlow(func IrFunction, ir MaxonModule)
		ir.refillBlockIndexById(func, into: self.blockIndex)
		self.frozenBlockCount = func.nextBlockId as ElementIndex
		self.frozenReach.refill(self.frozenLends.count() * self.frozenBlockCount, value: false)
		self.frozenRebinds.clear()

		for k in 0 upto self.frozenLends.count() 'eachLend'
			let sendBlock = (try self.frozenLends.get(k) otherwise panic("ProvenanceTracer.mapLendFlow: frozenLends.get OOB at {k}")).point.block
			let rebinding = self.rebindingOf(func, ir: ir, rank: try self.frozenRanks.get(k) otherwise panic("ProvenanceTracer.mapLendFlow: frozenRanks.get OOB at {k} — pushed with the lends"))
			self.frozenRebinds.push(rebinding)
			self.markBlocksAfterLend(func, ir: ir, from: sendBlock, rebinding: rebinding, row: k * self.frozenBlockCount)
		end 'eachLend'
	end 'mapLendFlow'

	// Every block reachable from the one the send stands in — its own included, when a back edge returns to it —
	// marked into `row`. A block the binding is bound again in is marked and not expanded past: what follows it
	// holds another record.
	function markBlocksAfterLend(func IrFunction, ir MaxonModule, from BlockId, rebinding Rebinding, row ElementIndex)
		var worklist = self.reachWorklist
		worklist.clear()
		collectMaxonBlockSuccessors(ir, block: self.blockById(func, ir: ir, blockId: from), into: worklist)
		var head = 0 as ElementIndex

		while head < worklist.count() 'eachBlock'
			let blockId = try worklist.get(head) otherwise panic("ProvenanceTracer.markBlocksAfterLend: worklist.get OOB at {head}")
			head = head + 1
			let slot = row + (blockId as ElementIndex)
			let marked = try self.frozenReach.get(slot) otherwise panic("ProvenanceTracer.markBlocksAfterLend: block {blockId} is past the function's {self.frozenBlockCount} block ids")

			if marked 'seen'
				continue
			end 'seen'

			try self.frozenReach.set(slot, value: true) otherwise panic("ProvenanceTracer.markBlocksAfterLend: frozenReach.set OOB at {slot}")

			if blockIsReboundIn(rebinding, block: blockId) 'boundAgainHere'
				continue
			end 'boundAgainHere'

			collectMaxonBlockSuccessors(ir, block: self.blockById(func, ir: ir, blockId: blockId), into: worklist)
		end 'eachBlock'
	end 'markBlocksAfterLend'

	// ⭐ **WHERE THE LENT BINDING IS BOUND TO A RECORD AGAIN**, past which a door on a later trip reaches a graph the
	// send never lent: the binding's own definition — a `let` that lends solely owns a fresh record, so running its
	// definition again makes another one. A record a `var` holds is not the trace's to say, so every trip of it is
	// taken to hold the lent one.
	function rebindingOf(func IrFunction, ir MaxonModule, rank RootRank) returns Rebinding
		if not self.isImmutableBindingRank(rank) 'aVarsRecord'
			return Rebinding.never
		end 'aVarsRecord'

		let value = self.rootValueAt(rank)
		self.indexDefinitions(func, ir: ir)
		let merging = try self.mergingBlocks.get(value) otherwise NoMergingBlock

		// A binding the arms of an `if` hand a record is bound at its merge block's head, so the whole block is past
		// the binding.
		if merging != NoMergingBlock 'boundAtABlocksHead'
			return Rebinding.at(FlowPoint.create(merging, at: 0))
		end 'boundAtABlocksHead'

		let definingOp = try self.definingOps.get(value) otherwise NoDefiningOp

		if definingOp == NoDefiningOp 'definedByNoOp'
			return Rebinding.never
		end 'definedByNoOp'

		return self.rebindingAtOp(func, ir: ir, definingOp: definingOp)
	end 'rebindingOf'

	// The position after the op that binds the record: everything below it in that block still holds the lent one.
	function rebindingAtOp(func IrFunction, ir MaxonModule, definingOp OpIndex) returns Rebinding
		self.indexFlowPoints(func, ir: ir)
		let at = try self.flowPoints.get(definingOp) otherwise return Rebinding.never
		return Rebinding.at(FlowPoint.create((at shr FlowPointBlockShift) as BlockId, at: ((at and FlowPointPositionMask) + 1) as BlockOpPos))
	end 'rebindingAtOp'

	// Where each op of `func` stands in its control flow, indexed once per body: a scan for one op would walk the
	// whole body again for every send it makes.
	function indexFlowPoints(func IrFunction, ir MaxonModule)
		if self.indexedFlowPointsOf.equals(func.name) 'indexed'
			return
		end 'indexed'

		self.flowPoints = FlowPointByOp.create()

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexFlowPoints: blockRef from func.blockRefs not in module.blocks")

			for pos in 0 upto block.opCountInRunOrder() 'eachOp'
				self.flowPoints.upsert(block.opInRunOrderAt(pos), value: ((block.id as FlowPointKey) shl FlowPointBlockShift) or (pos as FlowPointKey))
			end 'eachOp'
		end 'eachBlock'

		self.indexedFlowPointsOf = func.name
	end 'indexFlowPoints'

	// ⭐ **A HANDLER'S VERDICT, ASKED AT THE SEND THAT LENDS TO IT.** A parameter it writes by any means, a field write
	// included, would write the sender's graph from another green thread (E3019, which a `let` handed to a writing
	// parameter is refused under); one that escapes lets it be written later (E3160, naming the escape).
	function judgeLentHandler(func IrFunction, site LendSite, mutationSummary ParamMutationSummary)
		let handler = self.lentHandlerOf(site)
		let written = mutationSummary.maskOf(handler.name) or mutationSummary.recordWriteMaskOf(handler.name)

		if maskHasParam(written, param: handler.param) 'writesIt'
			self.refuse(site.sendLine, column: site.sendColumn, code: ErrorCode.semanticImmutableRefToMutatingParam, message: immutableMutatingCallMessage(String.from(site.root), paramName: displayParamName(site.param), functionName: String.from(func.name)))
			return
		end 'writesIt'

		let escape = try self.handlerEscapes.get(handlerParamKey(handler.index, param: handler.param)) otherwise panic("ProvenanceTracer.judgeLentHandler: `{String.from(handler.name)}` was not traced — `traceLentHandlers` traces the handler of every send before any function is judged")

		match escape 'escape'
			stays then return
			at(door, filePath) then self.refuseOnce(site.line, column: site.column, message: lentToEscapingHandlerMessage(String.from(site.root), message: String.from(qualifiedMethodName(site.serviceType, methodName: site.message)), param: String.from(site.param), escapeAt: sourcePositionText(filePath, line: door.line, column: door.column), door: freezeDoorPhrase(door.door, callee: door.callee)))
		end 'escape'
	end 'judgeLentHandler'

	// ⭐⭐ **EVERY MESSAGE A SEND LENDS TO, TRACED BEFORE ANY FUNCTION IS JUDGED** — each lent parameter's first
	// escape (`firstEscapeOf`), so the sends can be refused naming it. Every other walk traces the function being
	// judged, which is why the handlers are traced ahead of all of them.
	function traceLentHandlers(mutationSummary ParamMutationSummary)
		let ir = self.module

		for i in 0 upto ir.functions.count() 'eachFunc'
			let func = try ir.functions.get(i) otherwise panic("ProvenanceTracer.traceLentHandlers: functions.get OOB at {i} below its own count")

			for site in func.provenanceSites().lendSites 'eachLend'
				let handler = self.lentHandlerOf(site)
				let key = handlerParamKey(handler.index, param: handler.param)

				if self.handlerEscapes.contains(key) 'traced'
					continue
				end 'traced'

				let body = try ir.functions.get(handler.index) otherwise panic("ProvenanceTracer.traceLentHandlers: handler index {handler.index} is past the module's functions")
				let bindingCount = self.bindingsTraceOf(body, index: handler.index)
				self.handlerEscapes.upsert(key, value: self.firstEscapeOf(body, ir: ir, rank: bindingCount + (handler.param as RootRank), mutationSummary: mutationSummary))
			end 'eachLend'
		end 'eachFunc'
	end 'traceLentHandlers'

	// The first door of `body` — by position — a value reaching parameter root `rank` passes: a parser door, or an
	// argument a callee keeps. Writes are the handler's E3019, asked separately.
	function firstEscapeOf(body IrFunction, ir MaxonModule, rank RootRank, mutationSummary ParamMutationSummary) returns HandlerEscape
		var first = HandlerEscape.stays
		var firstAt = NoPositionKey

		for door in self.freezeDoorsOf(body, ir: ir, mutationSummary: mutationSummary, includeWrites: false) 'eachDoor'
			let at = positionKey(door.line, column: door.column)

			if at < firstAt and self.valueReachesFrozenRank(body, value: door.value, rank: rank) and not self.valueHoldsNothingWritable(body, value: door.value) 'earlier'
				first = HandlerEscape.at(door, filePath: body.sourceFilePath)
				firstAt = at
			end 'earlier'
		end 'eachDoor'

		return first
	end 'firstEscapeOf'

	// The handler a lend's message runs, and the position of its lent parameter.
	function lentHandlerOf(site LendSite) returns LentHandler
		let name = qualifiedMethodName(site.serviceType, methodName: site.message)
		let index = try self.funcIndexByName.get(name) otherwise panic("ProvenanceTracer.lentHandlerOf: no body is registered for the message `{String.from(name)}` a send lent to — the loop calls every message of a spawned type")
		let sig = try self.project.funcSignatures.get(name) otherwise panic("ProvenanceTracer.lentHandlerOf: no signature is registered for the message `{String.from(name)}`")

		for p in 0 upto sig.paramNames.count() 'eachParam'
			if (try sig.paramNames.get(p) otherwise panic("ProvenanceTracer.lentHandlerOf: paramNames.get OOB at {p}")).equals(site.param) 'theLentOne'
				return LentHandler.create(name, index: index, param: p as ParamCount)
			end 'theLentOne'
		end 'eachParam'

		panic("ProvenanceTracer.lentHandlerOf: `{String.from(name)}` declares no parameter `{String.from(site.param)}` — a message's payload fields are its parameters")
	end 'lentHandlerOf'

	// ⭐ **EVERY DOOR OF `func` A VALUE PASSES** — the parser's (`FreezeDoorSite`), a receiver a container method
	// writes, and every argument a callee keeps; with `includeWrites`, every argument a callee writes too. A callee
	// answers through its summary and its mutation mask, and a call through an interface or a function value through
	// those of every body it may land on.
	function freezeDoorsOf(func IrFunction, ir MaxonModule, mutationSummary ParamMutationSummary, includeWrites bool) returns FreezeDoorAtArray
		var into = FreezeDoorAtArray.create()

		for site in func.provenanceSites().freezeDoors 'eachParserDoor'
			into.push(FreezeDoorAt.create(site.value, door: site.door, callee: "", line: site.line, column: site.column, token: site.token, point: site.point))
		end 'eachParserDoor'

		if includeWrites 'receiversWritten'
			for site in func.provenanceSites().receiverWrites 'eachReceiverWrite'
				into.push(FreezeDoorAt.create(site.receiver, door: FreezeDoor.writtenAsReceiver, callee: calleeSpelling(site.method), line: site.line, column: site.column, token: site.token, point: site.point))
			end 'eachReceiverWrite'
		end 'receiversWritten'

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.freezeDoorsOf: blockRef from func.blockRefs not in module.blocks")

			for pos in 0 upto block.opCountInRunOrder() 'eachOp'
				let opIdx = block.opInRunOrderAt(pos)
				self.gatherCallDoorsOf(func, op: try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.freezeDoorsOf: opIdx {opIdx} not in module.ops"), opIndex: opIdx, point: FlowPoint.create(block.id, at: pos), mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)
			end 'eachOp'
		end 'eachBlock'

		return into
	end 'freezeDoorsOf'

	function gatherCallDoorsOf(func IrFunction, op MaxonOp, opIndex OpIndex, point FlowPoint, mutationSummary ParamMutationSummary, includeWrites bool, into FreezeDoorAtArray)
		match op 'op'
			call(_, callee, args, argLabels, argRanges, _, _, mint) then self.gatherNamedCallDoors(func, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, mint: mint, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)
			tryCall(_, _, callee, args, argLabels, argRanges, _, _, mint) then self.gatherNamedCallDoors(func, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, mint: mint, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)
			witnessDispatch(_, args, _, methodIndex, interfaceDeclIndex, _, _) then self.gatherLandingCallDoors(func, args: args, argCount: args.count(), bodies: self.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), callee: calleeSpelling(self.witnessMethodName(methodIndex, interfaceDeclIndex: interfaceDeclIndex).toByteArray()), receiverFirst: true, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)
			witnessTryDispatch(_, _, args, _, methodIndex, interfaceDeclIndex, _) then self.gatherLandingCallDoors(func, args: args, argCount: args.count(), bodies: self.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), callee: calleeSpelling(self.witnessMethodName(methodIndex, interfaceDeclIndex: interfaceDeclIndex).toByteArray()), receiverFirst: true, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)

			// ⭐ **AN `async` SPAWN IS THE SAME DOOR AS A DIRECT CALL.** The coroutine runs on this green thread and
			// the caller hands it a reference (`Parser.transferAsyncSpawnArgs`), so a managed argument is legal — and
			// what the target KEEPS outlives the await while what it WRITES lands in the caller's own graph. The op
			// carries no `CalleeMint`, and none is needed: an `async` names a function the author wrote.
			asyncCall(_, callee, args, argLabels, argRanges, _, _) then self.gatherNamedCallDoors(func, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, mint: CalleeMint.notMinted, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)

			// Its `args` is the variant's TAIL field, so it is bound in a small match — see
			// `LowerMaxonToStd.lowerIndirectCall`.
			indirectCall then self.gatherFunctionValueCallDoors(func, op: op, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)
			literal or
				ret or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				loadIndirect or
				storeIndirect or
				stringLiteral or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic then break 'op'
		end 'op'
	end 'gatherCallDoorsOf'

	// A declared callee's doors, each argument at its own position. A runtime entry keeps nothing a parser door did
	// not already file — its stores are a container's, which the parser's door is.
	function gatherNamedCallDoors(func IrFunction, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, mint CalleeMint, opIndex OpIndex, point FlowPoint, mutationSummary ParamMutationSummary, includeWrites bool, into FreezeDoorAtArray)
		if not self.calleeHasSummary(callee) 'aRuntimeEntry'
			return
		end 'aRuntimeEntry'

		let index = try self.funcIndexByName.get(callee) otherwise panic("ProvenanceTracer.gatherNamedCallDoors: '{String.from(callee)}' left the function index after `calleeHasSummary`")
		let sig = try self.project.funcSignatures.get(callee) otherwise panic("ProvenanceTracer.gatherNamedCallDoors: '{String.from(callee)}' left the signature registry after `calleeHasSummary`")
		let written = (mutationSummary.maskOf(callee) or mutationSummary.recordWriteMaskOf(callee)) if includeWrites else NoParamPositions
		let spelled = calleeSpelling(calleeDisplayName(overloadRegistrationBaseName(callDiagnosticNoun(callee, mint: mint))))
		let call = self.project.opRanges.get(opIndex)
		let token = self.callTokenAt(func, at: call)

		for i in 0 upto args.count() 'eachArg'
			let pos = argSlotPosition(sig.paramNames, argIndex: i, label: try argLabels.get(i) otherwise panic("ProvenanceTracer.gatherNamedCallDoors: argLabels.get OOB at {i} — a call's argument columns are parallel by construction"))

			if pos >= sig.paramCount() 'fillsNoParameter'
				continue
			end 'fillsNoParameter'

			let at = self.argumentValueAt(func, argRange: try argRanges.get(i) otherwise call)
			let value = try args.get(i) otherwise panic("ProvenanceTracer.gatherNamedCallDoors: args.get OOB at {i}")

			if maskHasParam(written, param: pos) 'writesIt'
				let door = FreezeDoor.writtenAsReceiver if pos == 0 and sig.takesReceiver() else FreezeDoor.writtenByCallee
				into.push(FreezeDoorAt.create(value, door: door, callee: spelled, line: at.line, column: at.column, token: token, point: point))
			end 'writesIt' else if self.calleeKeeps(index, param: pos, paramCount: sig.paramCount()) 'keepsIt'
				into.push(FreezeDoorAt.create(value, door: FreezeDoor.keptByCallee, callee: spelled, line: at.line, column: at.column, token: token, point: point))
			end 'keepsIt'
		end 'eachArg'
	end 'gatherNamedCallDoors'

	// Where an argument's value starts: a call's range for it is its label's where it has one, and the parser filed
	// where each labelled value starts (`LabelledArgumentValues`). A defaulted argument has no value the author wrote.
	// Indexed at the body's first question, because every argument of every call asks it.
	function argumentValueAt(func IrFunction, argRange SourceRange) returns SourceRange
		let values = func.provenanceSites().labelledArguments

		if values is not self.indexedLabelledArguments 'anotherFunctionsArguments'
			self.labelledArgumentRows = values.byPosition()
			self.indexedLabelledArguments = values
		end 'anotherFunctionsArguments'

		let k = try self.labelledArgumentRows.get(positionKey(argRange.line, column: argRange.column)) otherwise return argRange
		return SourceRange.create(argRange.startByte, endByte: argRange.endByte, line: try values.lines.get(k) otherwise panic("ProvenanceTracer.argumentValueAt: lines.get OOB at {k} — the columns are pushed together"), column: try values.columns.get(k) otherwise panic("ProvenanceTracer.argumentValueAt: columns.get OOB at {k} — the columns are pushed together"))
	end 'argumentValueAt'

	// A call through a function value: its declared arguments, each positional — the environment it passes last is
	// the closure's, whose captures were each a door where the closure was made.
	function gatherFunctionValueCallDoors(func IrFunction, op MaxonOp, opIndex OpIndex, point FlowPoint, mutationSummary ParamMutationSummary, includeWrites bool, into FreezeDoorAtArray)
		match op 'indirect'
			indirectCall(_, _, args) then self.gatherLandingCallDoors(func, args: args, argCount: args.count() - 1, bodies: self.functionValueBodiesFor(args.count()), callee: FunctionValueCalleeSpelling, receiverFirst: false, opIndex: opIndex, point: point, mutationSummary: mutationSummary, includeWrites: includeWrites, into: into)
			default panic("ProvenanceTracer.gatherFunctionValueCallDoors: handed an op that is not an indirect call")
		end 'indirect'
	end 'gatherFunctionValueCallDoors'

	// The doors of a call that lands on any of `bodies`: a position one of them writes or keeps, and every position
	// where a body no summary describes may land.
	function gatherLandingCallDoors(func IrFunction, args ValueIdArray, argCount ParamCount, bodies CallLandingBodies, callee String, receiverFirst bool, opIndex OpIndex, point FlowPoint, mutationSummary ParamMutationSummary, includeWrites bool, into FreezeDoorAtArray)
		let written = mutationSummary.writtenMaskAtAnyOf(bodies.impls) if includeWrites else NoParamPositions
		let call = self.project.opRanges.get(opIndex)
		let token = self.callTokenAt(func, at: call)

		for i in 0 upto argCount 'eachArg'
			let value = try args.get(i) otherwise panic("ProvenanceTracer.gatherLandingCallDoors: args.get OOB at {i}")

			if includeWrites and (bodies.unresolvedMayStore or maskHasParam(written, param: i)) 'writesIt'
				let door = FreezeDoor.writtenAsReceiver if receiverFirst and i == 0 else FreezeDoor.writtenByCallee
				into.push(FreezeDoorAt.create(value, door: door, callee: callee, line: call.line, column: call.column, token: token, point: point))
			end 'writesIt' else if bodies.unresolvedMayStore or self.landingBodyKeeps(bodies, param: i) 'keepsIt'
				into.push(FreezeDoorAt.create(value, door: FreezeDoor.keptByCallee, callee: callee, line: call.line, column: call.column, token: token, point: point))
			end 'keepsIt'
		end 'eachArg'
	end 'gatherLandingCallDoors'

	function landingBodyKeeps(bodies CallLandingBodies, param ParamCount) returns bool
		for impl in bodies.impls 'eachImpl'
			if self.implWasSkippedAsUnreached(impl) 'notInThisProgram'
				continue
			end 'notInThisProgram'

			if not self.implHasSummary(impl) 'mayStoreAnything'
				return true
			end 'mayStoreAnything'

			let paramCount = (try self.module.functions.get(impl) otherwise panic("ProvenanceTracer.landingBodyKeeps: function index {impl} is past the module's functions")).paramCount

			if param < paramCount and self.calleeKeeps(impl, param: param, paramCount: paramCount) 'keepsIt'
				return true
			end 'keepsIt'
		end 'eachImpl'

		return false
	end 'landingBodyKeeps'

	// Does function `index` keep what parameter `param` is handed past the call — store it into module storage, bind
	// it to a mutable name that outlives the call, store it into another parameter's record, or hand back a record
	// holding it or a part of it (a factory building one around it)?
	function calleeKeeps(index FuncIndex, param ParamCount, paramCount ParamCount) returns bool
		if maskHasParam(self.summary.escapesAt(index), param: param) or maskHasParam(self.summary.bindsAt(index), param: param) or maskHasParam(self.summary.holdsAt(index), param: param) or maskHasParam(self.summary.holdsWithinAt(index), param: param) 'outlivesTheCall'
			return true
		end 'outlivesTheCall'

		for into in 0 upto paramCount 'eachReceiver'
			if into != param and (maskHasParam(self.summary.storesAt(index, into: into), param: param) or maskHasParam(self.summary.storesDeepAt(index, into: into), param: param)) 'intoAnotherParameter'
				return true
			end 'intoAnotherParameter'
		end 'eachReceiver'

		return false
	end 'calleeKeeps'

	// The frozen lend `door` breaks, or `NoFrozenLend`: one whose send the door may run after, and whose record the
	// door's value may be, lie within or hold.
	function lendFreezing(func IrFunction, door FreezeDoorAt) returns ElementIndex
		if self.valueHoldsNothingWritable(func, value: door.value) 'frozenByItsType'
			return NoFrozenLend
		end 'frozenByItsType'

		for k in 0 upto self.frozenRanks.count() 'eachLend'
			let rank = try self.frozenRanks.get(k) otherwise panic("ProvenanceTracer.lendFreezing: frozenRanks.get OOB at {k}")

			if self.doorFollowsLend(k, door: door) and self.valueReachesFrozenRank(func, value: door.value, rank: rank) 'breaksIt'
				return k
			end 'breaksIt'
		end 'eachLend'

		return NoFrozenLend
	end 'lendFreezing'

	// ⭐⭐ **MAY THE DOOR RUN AFTER THE SEND?** — asked of the CONTROL FLOW, so a legal program is never refused for
	// standing later in the text: below the send in the send's own block, or in a block the flow reaches from it
	// (`mapLendFlow`) at a position the binding has not been bound again by. Two doors at one point — nothing the
	// body emits stands between them — are ordered by their tokens.
	//
	// ⚠ **THE SEND'S OWN BLOCK ASKS NO REBINDING QUESTION, AND MUST NOT.** A door below the send there runs on the
	// SAME trip, over the record the send lent, and the binding's definition cannot stand between the two: the
	// send READS the binding, so it stands below that definition, and a root bound at a block's head (one the arms
	// of an `if` hand a record) is bound above both. Asking `reboundBefore` here would read that same-trip
	// definition as a rebinding and refuse nothing at all — `borrow.error.a-lent-let-may-not-be-stored-in-a-container`
	// and its siblings are one block each.
	function doorFollowsLend(k ElementIndex, door FreezeDoorAt) returns bool
		let lend = try self.frozenLends.get(k) otherwise panic("ProvenanceTracer.doorFollowsLend: frozenLends.get OOB at {k}")

		if door.point.block == lend.point.block and (door.point.at > lend.point.at or (door.point.at == lend.point.at and door.token > lend.token)) 'belowTheSend'
			return true
		end 'belowTheSend'

		let reached = try self.frozenReach.get((k * self.frozenBlockCount) + (door.point.block as ElementIndex)) otherwise panic("ProvenanceTracer.doorFollowsLend: block {door.point.block} is past the function's {self.frozenBlockCount} block ids")

		if not reached 'theFlowNeverReachesIt'
			return false
		end 'theFlowNeverReachesIt'

		return not self.reboundBefore(k, point: door.point)
	end 'doorFollowsLend'

	// Is the lent binding bound again above `point` in its own block, so what stands there is another record?
	function reboundBefore(k ElementIndex, point FlowPoint) returns bool
		return match try self.frozenRebinds.get(k) otherwise panic("ProvenanceTracer.reboundBefore: frozenRebinds.get OOB at {k} — pushed with the lends") 'rebinding'
			never gives false
			at(bound) gives bound.block == point.block and point.at >= bound.at
		end 'rebinding'
	end 'reboundBefore'

	// ⭐ **MAY `value` BE ROOT `rank`'s RECORD, OR LIE WITHIN IT — as far as the types allow?** A value that only HOLDS
	// the record is not asked: a record comes to be held only through a door — a store, a capture, a callee that keeps
	// it — and that door is the one refused. One held before the send is a second owner, which the send's walk aborts
	// on.
	function valueReachesFrozenRank(func IrFunction, value ValueId, rank RootRank) returns bool
		if self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) and self.valuesMayBeOneRecord(func, value: value, other: self.rootValueAt(rank)) 'mayBeIt'
			return true
		end 'mayBeIt'

		return self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: value), rank: rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: false)
	end 'valueReachesFrozenRank'

	// The rank a lent record has in the trace: the `let`'s own, or — for a `let` made from a `var` — the `var`'s
	// record's; `NoRootRank` for a record the trace does not rank.
	function lentRankOf(value ValueId) returns RootRank
		let named = self.bindingRankOf(value)
		return named if named != NoRootRank else self.writableRankOf(value)
	end 'lentRankOf'

	// A record whose type holds nothing a statement can write (`ProgramSignatures.aggregateGraphIsWriteFree`).
	// Memoized by type name: every door of every lending body asks it, and the answer walks the whole field graph
	// and allocates a visited set to reach it.
	//
	// ⚠ **`Parser.valueHoldsNothingWritable` IS ITS TWIN AND THE TWO MUST ANSWER ALIKE**: the parse-time tier of
	// the freeze exempts a door this tier would otherwise refuse, and the reverse. They are two spellings of one
	// question because the type NAME is read out of a different place in each — the parser's own interned columns
	// there, the merged module's type names here — and the tag test is what guards that read, a struct reference
	// being the only value whose name denotes an aggregate.
	function valueHoldsNothingWritable(func IrFunction, value ValueId) returns bool
		if not tagIsStructRef(valueTagOf(func, value: value)) 'notAStruct'
			return false
		end 'notAStruct'

		let nameId = self.nameIdOf(func, value: value)

		if self.writeFreeGraphs.contains(nameId) 'asked'
			return try self.writeFreeGraphs.get(nameId) otherwise panic("ProvenanceTracer.valueHoldsNothingWritable: name {nameId} left the memo after `contains`")
		end 'asked'

		let writeFree = self.signatures.aggregateGraphIsWriteFree(try self.project.typeNames.nameOf(nameId) otherwise return false)
		self.writeFreeGraphs.upsert(nameId, value: writeFree)
		return writeFree
	end 'valueHoldsNothingWritable'

	// E3160 at a door after the send `lend`; a `var` door it refuses is not asked again as one (`doorWasFrozen`).
	function refuseFrozenDoor(func IrFunction, door FreezeDoorAt, lend LendSite)
		if door.door == FreezeDoor.bindToVar or door.door == FreezeDoor.assignToVar 'aVarDoor'
			try self.frozenDoorValues.set(door.value, value: true) otherwise panic("ProvenanceTracer.refuseFrozenDoor: frozenDoorValues.set OOB at v{door.value}")
		end 'aVarDoor'

		self.refuseOnce(door.line, column: door.column, message: lentGraphEscapesMessage(String.from(lend.root), lentAt: sourcePositionText(func.sourceFilePath, line: lend.line, column: lend.column), door: freezeDoorPhrase(door.door, callee: door.callee)))
	end 'refuseFrozenDoor'

	// Was the `var` door that took `value` refused as a freeze (E3160)?
	function doorWasFrozen(value ValueId) returns bool
		return try self.frozenDoorValues.get(value) otherwise panic("ProvenanceTracer.doorWasFrozen: frozenDoorValues.get OOB at v{value}")
	end 'doorWasFrozen'

	// One E3160 at a position: two doors at one value are one finding.
	function refuseOnce(line LineNumber, column ColumnNumber, message String)
		let at = positionKey(line, column: column)

		for refusal in self.refusals 'eachRefusal'
			if refusal.at == at and refusal.code == ErrorCode.semanticLentGraphEscapes 'alreadyRefused'
				return
			end 'alreadyRefused'
		end 'eachRefusal'

		self.refuse(line, column: column, code: ErrorCode.semanticLentGraphEscapes, message: message)
	end 'refuseOnce'

	// ⭐⭐ **A NAME HANDED WHOLE TO A MUTABLE DOOR: MOVED IF IT IS ITS RECORD'S SOLE REFERENCE, REFUSED OTHERWISE.**
	// A `let` bound to a fresh record and named by nothing else live moves: its next read is E3102, and a move out
	// of a loop it was declared outside of is E2015, as the parser's own is. A `let` that aliases, borrows, lies
	// within another name's record or is a module-level `let` cannot move, and is refused at the door. A `var`'s
	// door is asked only for E3077 (`varIsNeededMutable`).
	function checkMoveSites(func IrFunction)
		let sites = func.provenanceSites().moveSites

		for k in moveSitesInTokenOrder(sites) 'eachSite'
			let site = try sites.get(k) otherwise panic("ProvenanceTracer.checkMoveSites: moveSites.get OOB at {k}")

			if not site.sourceIsMutable and not self.doorWasFrozen(site.value) 'aLetsDoor'
				self.decideMoveSite(func, site: site)
			end 'aLetsDoor'
		end 'eachSite'
	end 'checkMoveSites'

	// Moves or refuses the name `site` bound or assigned to a mutable name.
	function decideMoveSite(func IrFunction, site MoveSite)
		// A `let` made from a `var` (`let u = t`, which moved `t`) is no root: it is its record's owner.
		let rank = self.bindingRankOf(site.sourceValue)

		if rank == NoRootRank 'ownsWhatTheVarGaveIt'
			self.moveAt(site, rank: NoRootRank)
			return
		end 'ownsWhatTheVarGaveIt'

		if self.rootIsModuleLetAt(rank) 'cannotMove'
			self.refuseBinding(site)
			return
		end 'cannotMove'

		// A name an earlier door moved is read by this one, which that door's E3102 already reports.
		if (try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.decideMoveSite: rootMovedAt.get OOB at {rank}")) < site.token 'alreadyMoved'
			return
		end 'alreadyMoved'

		if self.rootIsSoleAt(rank, token: site.token) 'theRecordsOwner'
			self.moveAt(site, rank: rank)
			return
		end 'theRecordsOwner'

		if self.rootIsWatchedAfter(func, rank: rank, token: site.token) 'stillImmutable'
			self.refuseBinding(site)
		end 'stillImmutable'
	end 'decideMoveSite'

	function refuseBinding(site MoveSite)
		self.noteRefusedDoor(site.value)
		self.noteRefusedDoor(site.sourceValue)
		self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: varFromImmutableMessage("immutable variable '{String.from(site.source)}'", binding: String.from(site.destination)))
	end 'refuseBinding'

	// The name `site` handed over is moved there: a read of it after is E3102, a move out of a loop it outlives is
	// E2015.
	function moveAt(site MoveSite, rank RootRank)
		if rank != NoRootRank 'aRoot'
			let before = try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.moveAt: rootMovedAt.get OOB at {rank}")

			if site.token < before 'earlier'
				try self.rootMovedAt.set(rank, value: site.token) otherwise panic("ProvenanceTracer.moveAt: rootMovedAt.set OOB at {rank}")
			end 'earlier'
		end 'aRoot'

		if site.escapesLoop 'outOfALoop'
			self.refuse(site.line, column: site.column, code: ErrorCode.parserUnsupportedFeature, message: unsupportedFeatureMessage(LoopEscapingMoveDetail))
			return
		end 'outOfALoop'

		if site.readAfter 'readOnceMoved'
			self.refuse(site.readLine, column: site.readColumn, code: ErrorCode.useAfterMove, message: useOfMovedValueMessage(String.from(site.source)))
		end 'readOnceMoved'
	end 'moveAt'

	// ⭐ **IS BINDING ROOT `rank` ITS RECORD'S SOLE REFERENCE AT `token`?** It owns its record
	// (`settleBindingRoots`), and no other immutable name live there may be it, lie within it or hold it — a
	// `let u = relay(t)` still reading `t`'s record would watch what the mutable door writes.
	function rootIsSoleAt(rank RootRank, token TokenIndex) returns bool
		if not (try self.rootSoleBase.get(rank) otherwise panic("ProvenanceTracer.rootIsSoleAt: rootSoleBase.get OOB at {rank}")) 'notItsOwn'
			return false
		end 'notItsOwn'

		for other in 0 upto self.rootNames.count() 'eachOtherName'
			if other == rank or self.rootIsModuleLetAt(other) or not self.rootIsLiveAt(other, token: token) 'cannotWatch'
				continue
			end 'cannotWatch'

			if self.valueReachesRank(self.rootValueAt(other), rank: rank) 'watches'
				return false
			end 'watches'
		end 'eachOtherName'

		return true
	end 'rootIsSoleAt'

	// Was binding root `rank` bound before `token`, is it read after it, and was it not moved before it? A read
	// that ends at `token` is the door's own.
	function rootIsLiveAt(rank RootRank, token TokenIndex) returns bool
		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootIsLiveAt: rootDeclTokens.get OOB at {rank}")
		let movedAt = try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.rootIsLiveAt: rootMovedAt.get OOB at {rank}")
		return declared < token and movedAt >= token and self.rootReadAfter(rank, token: token)
	end 'rootIsLiveAt'

	function rootIsCaptured(rank RootRank) returns bool
		return try self.rootCaptured.get(rank) otherwise panic("ProvenanceTracer.rootIsCaptured: rootCaptured.get OOB at {rank}")
	end 'rootIsCaptured'

	function rootIsModuleLetAt(rank RootRank) returns bool
		return try self.rootIsModuleLet.get(rank) otherwise panic("ProvenanceTracer.rootIsModuleLetAt: rootIsModuleLet.get OOB at {rank}")
	end 'rootIsModuleLetAt'

	// Was binding root `rank` moved by a door no later than the one being asked about (`askedBeforeToken`)?
	function rootMovedBeforeAsked(rank RootRank) returns bool
		if rank >= self.rootMovedAt.count() 'notABinding'
			return false
		end 'notABinding'

		return (try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.rootMovedBeforeAsked: rootMovedAt.get OOB at {rank}")) <= self.askedBeforeToken
	end 'rootMovedBeforeAsked'

	// The door at `token` is the one asked about until `leaveDoor`. `skipsImages`: it is a write through a record,
	// which never reaches a module-level `let`'s image, since every store of one copied it.
	function askAtDoor(token TokenIndex, skipsImages bool)
		self.askedBeforeToken = token
		self.liveAfterToken = token
		self.doorSkipsImages = skipsImages
	end 'askAtDoor'

	function leaveDoor()
		self.askedBeforeToken = AskAboutEveryRoot
		self.liveAfterToken = AskAboutEveryRoot
		self.doorSkipsImages = false
	end 'leaveDoor'

	// ⭐ **DOES ROOT `rank` MATTER AT THE DOOR BEING ASKED?** Not once a door moved it. A module-level `let` is live
	// everywhere, but its image is reached by no write-through (`askAtDoor`). Any other `let` only while it is live
	// after the door: a record no live immutable name reaches is only its mutable holders' to share.
	function rootCountsAtDoor(rank RootRank) returns bool
		if not self.isImmutableBindingRank(rank) 'aParameterOrAVarsRecord'
			return true
		end 'aParameterOrAVarsRecord'

		if self.rootMovedBeforeAsked(rank) 'moved'
			return false
		end 'moved'

		if self.rootIsModuleLetAt(rank) 'liveEverywhere'
			return not (self.doorSkipsImages and self.rootIsImageAt(rank))
		end 'liveEverywhere'

		// A `let` bound after the door — later in the body of a loop the door is in, too — reads nothing yet: the
		// binding a previous trip made was read for the last time on that trip.
		if self.liveAfterToken == AskAboutEveryRoot 'everyRootCounts'
			return true
		end 'everyRootCounts'

		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootCountsAtDoor: rootDeclTokens.get OOB at {rank}")
		return declared < self.liveAfterToken and self.rootReadAfter(rank, token: self.liveAfterToken)
	end 'rootCountsAtDoor'

	function rootIsImageAt(rank RootRank) returns bool
		return try self.rootIsImage.get(rank) otherwise panic("ProvenanceTracer.rootIsImageAt: rootIsImage.get OOB at {rank}")
	end 'rootIsImageAt'

	// ⭐ **IS A `let` THAT IS NOT ITS RECORD'S SOLE REFERENCE WATCHED AFTER THE DOOR AT `token`?** Read there
	// again, or its record reached by another immutable name bound before the door and live after it. A borrow
	// nothing reads again hands the door a record only mutable holders go on reaching.
	function rootIsWatchedAfter(func IrFunction, rank RootRank, token TokenIndex) returns bool
		if self.rootReadAfter(rank, token: token) 'readAgain'
			return true
		end 'readAgain'

		self.askAtDoor(token, skipsImages: false)
		var watched = false

		for other in 0 upto self.rootNames.count() 'eachOtherName'
			let declared = try self.rootDeclTokens.get(other) otherwise panic("ProvenanceTracer.rootIsWatchedAfter: rootDeclTokens.get OOB at {other}")

			if other == rank or declared >= token or not self.rootCountsAtDoor(other) 'cannotWatch'
				continue
			end 'cannotWatch'

			if self.rootsShareARecord(func, rank: rank, other: other) 'watches'
				watched = true
				break
			end 'watches'
		end 'eachOtherName'

		self.leaveDoor()
		return watched
	end 'rootIsWatchedAfter'

	// May root `other`'s record be root `rank`'s, lie within it, or hold it — or the reverse? Asked of each pair
	// only as far as their types allow: one record is never two declared types, and a record holds only the kinds
	// its type can.
	function rootsShareARecord(func IrFunction, rank RootRank, other RootRank) returns bool
		return self.rootReachesRoot(func, holder: other, rank: rank) or self.rootReachesRoot(func, holder: rank, rank: other)
	end 'rootsShareARecord'

	function rootReachesRoot(func IrFunction, holder RootRank, rank RootRank) returns bool
		let value = self.rootValueAt(holder)

		if self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) and self.valuesMayBeOneRecord(func, value: value, other: self.rootValueAt(rank)) 'mayBeIt'
			return true
		end 'mayBeIt'

		if self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: value), rank: rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: false) 'liesWithinIt'
			return true
		end 'liesWithinIt'

		return self.valueHoldsRank(value, rank: rank) and self.typeAdmits(func, value: self.rootValueAt(rank), rank: holder, asksIdentity: false)
	end 'rootReachesRoot'

	// May `value` be, lie within, or hold root `rank`'s record?
	function valueReachesRank(value ValueId, rank RootRank) returns bool
		return self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: value), rank: rank) or self.valueHoldsRank(value, rank: rank)
	end 'valueReachesRank'

	function valueHoldsRank(value ValueId, rank RootRank) returns bool
		return self.sets.hasRank(self.setOf(ProvenanceColumn.holds, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.storedHolds, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.deepHolds, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.holdsWithin, value: value), rank: rank)
	end 'valueHoldsRank'

	// ⭐⭐ **A MUTABLE NAME MAY NOT TAKE AN IMMUTABLE NAME'S STORAGE THROUGH A VALUE, WHERE THE PARSER JUDGES A NAME.**
	// Each site is a `var` bound or assigned a value no bare `let` names. It is refused when that value may be or lie
	// within the record of an immutable name live after it (a module `let` read here is one), or when it may be the
	// record a live `let` borrows out of mutable storage. A value that only HOLDS such a record is no door: what is
	// written through it is (`checkWriteThroughSites`).
	function checkMutableBindingSites(func IrFunction, ir MaxonModule)
		for site in func.provenanceSites().mutableBindingSites 'eachSite'
			if self.doorWasFrozen(site.value) 'refusedAsAFreeze'
				continue
			end 'refusedAsAFreeze'

			self.askAtDoor(site.token, skipsImages: false)

			let rank = self.bindingRankOf(site.value)

			if rank != NoRootRank 'anImmutableNamesOwnRecord'
				if self.isImmutableBindingRank(rank) and self.rootCountsAtDoor(rank) 'stillImmutable'
					self.noteRefusedDoor(site.value)
					self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: varFromImmutableMessage("immutable variable '{String.from(self.rootNameAt(rank))}'", binding: String.from(site.name)))
				end 'stillImmutable'

				continue
			end 'anImmutableNamesOwnRecord'

			// Only a record the `var` goes on to write reaches what a live `let` reads (`boundValueIsWrittenThrough`).
			if not self.boundValueIsWrittenThrough(site.value) 'onlyReadAndRebound'
				continue
			end 'onlyReadAndRebound'

			if not self.firstRootName(func, value: site.value, reach: RootReach.identityOrInside).isEmpty() 'reachesARoot'
				self.noteRefusedDoor(site.value)
				self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: varFromImmutableMessage(self.sharedStorageSubject(func, ir: ir, value: site.value), binding: String.from(site.name)))
				continue
			end 'reachesARoot'

			let borrower = self.liveBorrowerOf(func, ir: ir, value: site.value, token: site.token, orWithin: true)

			if borrower != NoRootRank 'borrowedByALiveLet'
				self.noteRefusedDoor(site.value)
				self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: varFromImmutableMessage(self.borrowedStorageSubject(func, ir: ir, value: site.value, borrower: borrower), binding: String.from(site.name)))
			end 'borrowedByALiveLet'
		end 'eachSite'

		self.leaveDoor()
	end 'checkMutableBindingSites'

	// The token the call at `at` ends at (`Parser.noteCallToken`), out of the calls of `func` indexed by position at
	// its first question. A call the parser filed none for — one it synthesized — is taken to end where every root is
	// still live and none is moved yet.
	function callTokenAt(func IrFunction, at SourceRange) returns TokenIndex
		return self.callTokenAtPosition(func, line: at.line, column: at.column)
	end 'callTokenAt'

	function callTokenAtPosition(func IrFunction, line LineNumber, column ColumnNumber) returns TokenIndex
		let calls = func.provenanceSites().calls

		if calls is not self.indexedCalls 'anotherFunctionsCalls'
			self.callTokenIndex = calls.byPosition()
			self.indexedCalls = calls
		end 'anotherFunctionsCalls'

		return try self.callTokenIndex.get(positionKey(line, column: column)) otherwise AskAboutEveryRoot
	end 'callTokenAtPosition'

	// E3019 at a container method writing a receiver the parser could name no binding for — `pass(a).push(9)` — where
	// the receiver may BE the record of an immutable name read after the call. Identity only, for the top-level-base
	// rule `specs/immutable-method-call.md` pins: a field of a `let` is not the `let`. Any other receiver such a name
	// may reach is written through (E3159). A receiver a `var` holds is answered where that binding took it (E3078).
	function checkReceiverWrites(func IrFunction, ir MaxonModule)
		for site in func.provenanceSites().receiverWrites 'eachWrite'
			if not site.blameable or self.writeWasRefusedAtItsDoor(func, target: site.receiver) 'answeredElsewhere'
				continue
			end 'answeredElsewhere'

			self.askAtDoor(site.token, skipsImages: false)
			let blamed = self.firstRootWrittenThrough(func, target: site.receiver)
			self.leaveDoor()

			if not blamed.isEmpty() 'aBindingsRecord'
				self.refuse(site.line, column: site.column, code: ErrorCode.semanticImmutableRefToMutatingParam, message: immutableMutatingCallMessage(String.from(blamed), paramName: String.from(ReceiverSourceSpelling), functionName: String.from(func.name)))
				continue
			end 'aBindingsRecord'

			self.refuseAWriteThrough(func, ir: ir, target: site.receiver, place: site.place, line: site.line, column: site.column, token: site.token)
		end 'eachWrite'
	end 'checkReceiverWrites'

	// The first immutable name counting at the door being asked whose record a write through `target` writes: one
	// `target` may be, unless the slot both were read out of was replaced in between (`slotRewrittenSinceRootRead`)
	// — or empty.
	function firstRootWrittenThrough(func IrFunction, target ValueId) returns ByteArray
		let own = self.bindingRankOf(target)

		if own != NoRootRank 'aBindingsOwnValue'
			return self.rootNameAt(own) if self.rootCountsAtDoor(own) else EmptySourceText
		end 'aBindingsOwnValue'

		let bound = self.rootNames.count() as RootRank
		let rank = self.leastAdmittedRank(func, column: ProvenanceColumn.identity, value: target, bound: bound, also: RootCondition.slotNotRewritten)
		return self.rootNameAt(rank) if rank < bound else EmptySourceText
	end 'firstRootWrittenThrough'

	// The first `let` holding an immutable record that `value` may lie within, and that counts at the door being
	// asked — or empty.
	function firstImmutableRecordHolding(func IrFunction, value ValueId) returns ByteArray
		let bound = self.rootNames.count() as RootRank
		let rank = self.leastAdmittedRank(func, column: ProvenanceColumn.inside, value: value, bound: bound, also: RootCondition.immutableRecord)
		return self.rootNameAt(rank) if rank < bound else EmptySourceText
	end 'firstImmutableRecordHolding'

	function checkWriteThroughSites(func IrFunction, ir MaxonModule)
		for site in func.provenanceSites().writeThroughSites 'eachSite'
			self.refuseAWriteThrough(func, ir: ir, target: site.value, place: site.name, line: site.line, column: site.column, token: site.token)
		end 'eachSite'
	end 'checkWriteThroughSites'

	// ⭐ **E3159: A WRITE THROUGH A RECORD AN IMMUTABLE NAME READ AFTER IT MAY REACH** — one the target may be, one
	// it may lie within when that name holds an immutable record, or the record a live `let` borrows out of the same
	// mutable storage. A `let` of a record with `var` fields is shallow: a write inside it through its own fields is
	// the language's (`borrow-liveness.md`, `let-receiver-still-takes-mutating-methods`). A module-level `let`'s image
	// is no such record, since every store copied it; an immutable record is never a target.
	function refuseAWriteThrough(func IrFunction, ir MaxonModule, target ValueId, place ByteArray, line LineNumber, column ColumnNumber, token TokenIndex)
		if self.valueIsAnImmutableRecord(func, value: target) or self.writeWasRefusedAtItsDoor(func, target: target) 'writtenByNothingOrRefused'
			return
		end 'writtenByNothingOrRefused'

		self.askAtDoor(token, skipsImages: true)
		var blamed = self.firstRootWrittenThrough(func, target: target)

		if blamed.isEmpty() 'notItsRecord'
			blamed = self.firstImmutableRecordHolding(func, value: target)
		end 'notItsRecord'

		self.leaveDoor()

		if blamed.isEmpty() 'noNamedRecord'
			let watcher = self.liveWatcherOf(func, ir: ir, value: target, token: token)

			if watcher == NoRootRank 'nothingReadsIt'
				return
			end 'nothingReadsIt'

			blamed = self.rootNameAt(watcher)
		end 'noNamedRecord'

		self.refuse(line, column: column, code: ErrorCode.semanticWriteThroughImmutableRecord, message: writeThroughImmutableMessage(String.from(place), root: String.from(blamed)))
	end 'refuseAWriteThrough'

	// The live `let` a write through `value` would change what it reads — one borrowing the record out of the same
	// mutable storage (`liveBorrowerOf`), or one that may be the same record as `value` by another road: both may
	// be the record of a third name, a moved `let` whose record went into a container and came back out — or
	// `NoRootRank`. Asked of every `let` live after the write, whichever of the two was declared first.
	function liveWatcherOf(func IrFunction, ir MaxonModule, value ValueId, token TokenIndex) returns RootRank
		let borrower = self.liveBorrowerOf(func, ir: ir, value: value, token: token, orWithin: false)

		if borrower != NoRootRank 'aBorrow'
			return borrower
		end 'aBorrow'

		return self.liveLetSharingARecord(func, ir: ir, value: value, token: token)
	end 'liveWatcherOf'

	function liveLetSharingARecord(func IrFunction, ir MaxonModule, value ValueId, token TokenIndex) returns RootRank
		let identity = self.setOf(ProvenanceColumn.identity, value: value)

		if self.sets.first(identity) == NoRootChunk 'mayBeNothingNamed'
			return NoRootRank
		end 'mayBeNothingNamed'

		for rank in 0 upto self.rootNames.count() 'eachName'
			let other = self.rootValueAt(rank)

			// A root whose `identity` meets `value`'s nowhere shares no rank with it (`mayHoldOneRankAtTheirReads`) —
			// asked first, since a set meet is cheaper than a liveness question.
			if other == value or not self.setsShareARank(identity, other: self.setOf(ProvenanceColumn.identity, value: other)) or not self.rootIsLiveAt(rank, token: token) or (self.rootIsModuleLetAt(rank) and self.rootIsImageAt(rank)) 'cannotBeWatching'
				continue
			end 'cannotBeWatching'

			if self.valuesMayBeOneRecord(func, value: value, other: other) and self.mayHoldOneRankAtTheirReads(func, ir: ir, value: value, other: other) and not self.slotRewrittenSinceRootRead(func, ir: ir, rank: rank, target: value) and not self.accessPathsDiverge(func, ir: ir, value: value, other: other) 'mayBeOneRecord'
				return rank
			end 'mayBeOneRecord'
		end 'eachName'

		return NoRootRank
	end 'liveLetSharingARecord'

	// ⭐ **TWO READS DOWN TWO DIFFERENT FIELDS OF ONE RECORD ARE TWO PLACES WHEN THE FIELDS HOLD TWO RECORDS.** A
	// value's access path is the root value it was read out of and the steps from there — a field's offset, or an
	// element of a container — through retains, which hand back the record they were handed, and merges whose every
	// incoming value is one value. Two paths from one root overlap only where one is a prefix of the other; where they
	// part at two different fields, what each reaches is its own field's — distinct records unless one record went
	// into both (`fieldsHoldDistinctRecords`). An element step matches any other step.
	function accessPathsDiverge(func IrFunction, ir MaxonModule, value ValueId, other ValueId) returns bool
		var steps = self.pathSteps
		var otherSteps = self.otherPathSteps
		steps.clear()
		otherSteps.clear()
		let base = self.accessPathOf(func, ir: ir, value: value, into: steps)
		let otherBase = self.accessPathOf(func, ir: ir, value: other, into: otherSteps)

		if base != otherBase 'twoRoots'
			return false
		end 'twoRoots'

		let shared = steps.count() if steps.count() < otherSteps.count() else otherSteps.count()

		for i in 1 upto shared + 1 'eachStepFromTheRoot'
			let step = try steps.get(steps.count() - i) otherwise panic("ProvenanceTracer.accessPathsDiverge: steps.get OOB")
			let otherStep = try otherSteps.get(otherSteps.count() - i) otherwise panic("ProvenanceTracer.accessPathsDiverge: otherSteps.get OOB")

			if step != otherStep and step != ElementAccessStep and otherStep != ElementAccessStep 'twoFields'
				return self.fieldsHoldDistinctRecords(func, ir: ir, root: base, sharedSteps: (i - 1) as ElementIndex, field: step, otherField: otherStep)
			end 'twoFields'
		end 'eachStepFromTheRoot'

		return false
	end 'accessPathsDiverge'

	// ⭐ **DO TWO FIELDS HOLD TWO RECORDS?** Proven only of a root this body made — a record a call or an allocation
	// here handed back fresh — whose every use is in view: loads, retains, and stores into it. Its fields then hold
	// two records when no record stored into one, and no argument the call that made it was handed, may be one
	// stored into the other: two records minted here, each by its own op, are two.
	//
	// ⚠ **A ROOT WHOSE FIELDS THIS BODY DID NOT FILL IS TAKEN TO HOLD DISTINCT RECORDS IN DISTINCT FIELDS** — a
	// parameter's record, module storage, and what a callee stored into the record it returns beyond the arguments
	// it was handed — the stated limit in `docs/LANGUAGE_REFERENCE.md` (Immutable XOR Mutable). A record inside a
	// root this body made is not followed, so its fields are not proven apart.
	function fieldsHoldDistinctRecords(func IrFunction, ir MaxonModule, root ValueId, sharedSteps ElementIndex, field AccessStep, otherField AccessStep) returns bool
		let opIdx = try self.definingOps.get(root) otherwise NoDefiningOp
		let isParameter = root < valueIdAtParamPosition(func.paramCount)

		if isParameter or (opIdx != NoDefiningOp and opDefinesAGlobalAddress(try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.fieldsHoldDistinctRecords: op {opIdx} not in module.ops"))) 'filledElsewhere'
			return true
		end 'filledElsewhere'

		if sharedSteps > 0 or opIdx == NoDefiningOp or not self.valueIsAFreshRecord(root) 'notInView'
			return false
		end 'notInView'

		var stored = self.fieldStored
		var otherStored = self.otherFieldStored
		stored.clear()
		otherStored.clear()

		if not self.collectFieldStores(func, ir: ir, root: root, makerOp: opIdx, field: field, otherField: otherField, into: stored, otherInto: otherStored) 'aUseOutOfView'
			return false
		end 'aUseOutOfView'

		for one in stored 'eachStored'
			for another in otherStored 'eachOtherStored'
				if not self.provablyTwoRecords(func, value: one, other: another) 'mayBeOne'
					return false
				end 'mayBeOne'
			end 'eachOtherStored'
		end 'eachStored'

		return true
	end 'fieldsHoldDistinctRecords'

	// The records stored into `root`'s `field` and `otherField`: by the stores this body makes into it, and — for
	// every argument of the call that made it, which may have put that argument into either — both. False when a
	// value that is `root`'s record is used where a record may be put into it out of view
	// (`opKeepsFieldStoresInView`).
	function collectFieldStores(func IrFunction, ir MaxonModule, root ValueId, makerOp OpIndex, field AccessStep, otherField AccessStep, into ValueIdArray, otherInto ValueIdArray) returns bool
		ir.refillBlockIndexById(func, into: self.blockIndex)
		maxonOpOperandValues(try ir.ops.get(makerOp) otherwise panic("ProvenanceTracer.collectFieldStores: op {makerOp} not in module.ops"), into: self.operands)

		for handed in self.operands 'eachArgument'
			if self.isTracked(handed) 'aRecord'
				into.push(handed)
				otherInto.push(handed)
			end 'aRecord'
		end 'eachArgument'

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.collectFieldStores: blockRef not in module.blocks")

			for opIdx in block.opRefs 'eachOp'
				let op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.collectFieldStores: op {opIdx} not in module.ops")

				if not self.opKeepsFieldStoresInView(func, ir: ir, op: op, root: root, field: field, otherField: otherField, into: into, otherInto: otherInto) 'outOfView'
					return false
				end 'outOfView'
			end 'eachOp'

			for edge in block.branchEdges 'eachEdge'
				for incoming in edge.argIds 'eachIncoming'
					if self.sameRecordBase(func, ir: ir, value: incoming) == root and not self.edgeKeepsTheRecordInView(func, ir: ir, targetBlockId: edge.targetBlockId, incoming: incoming, root: root) 'mergedAway'
						return false
					end 'mergedAway'
				end 'eachIncoming'
			end 'eachEdge'
		end 'eachBlock'

		return true
	end 'collectFieldStores'

	// Is `op` no use of `root`'s record, a load out of it, a store into it or a call that keeps its fields in view —
	// noting what may have been stored into either field?
	function opKeepsFieldStoresInView(func IrFunction, ir MaxonModule, op MaxonOp, root ValueId, field AccessStep, otherField AccessStep, into ValueIdArray, otherInto ValueIdArray) returns bool
		match op 'op'
			loadIndirect then return true
			storeIndirect(addr, offset, value, _) then return self.noteFieldStore(func, ir: ir, root: root, addr: addr, offset: offset as AccessStep, value: value, field: field, otherField: otherField, into: into, otherInto: otherInto)
			call(result, callee, args, argLabels, _, _, _, _) then return self.callKeepsFieldStoresInView(func, ir: ir, result: result, callee: callee, args: args, argLabels: argLabels, root: root, into: into, otherInto: otherInto)
			tryCall(result, _, callee, args, argLabels, _, _, _, _) then return self.callKeepsFieldStoresInView(func, ir: ir, result: result, callee: callee, args: args, argLabels: argLabels, root: root, into: into, otherInto: otherInto)

			literal or
				ret or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				stringLiteral or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				indirectCall or
				asyncCall or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				witnessDispatch or
				witnessTryDispatch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic then return not self.operandsReachRecord(func, ir: ir, op: op, root: root)
		end 'op'
	end 'opKeepsFieldStoresInView'

	// ⭐ **A CALL HANDED `root`'s RECORD KEEPS ITS FIELDS IN VIEW WHEN WHAT IT DOES WITH THE RECORD IS KNOWN**: a
	// retain hands it back, and any other call may store into it only the arguments its summary — or a runtime entry's
	// `RuntimeStoreShape` — says it stores there, which are noted as stored into either field. A call that may hand the
	// record back, keep it, or put it into another argument makes a second road to its fields, and is out of view.
	function callKeepsFieldStoresInView(func IrFunction, ir MaxonModule, result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, root ValueId, into ValueIdArray, otherInto ValueIdArray) returns bool
		if ownershipBookkeepingCallee(callee) 'theSameRecordBack'
			return true
		end 'theSameRecordBack'

		var handed = self.handedPositions
		handed.clear()

		for j in 0 upto args.count() 'eachArgument'
			if self.sameRecordBase(func, ir: ir, value: try args.get(j) otherwise panic("ProvenanceTracer.callKeepsFieldStoresInView: args.get OOB at {j}")) == root 'itsRecord'
				handed.push(j)
			end 'itsRecord'
		end 'eachArgument'

		if handed.count() == 0 'notHandedIt'
			return true
		end 'notHandedIt'

		if not self.calleeHasSummary(callee) 'aRuntimeEntry'
			return self.runtimeCallKeepsFieldStoresInView(result, shape: runtimeCalleeStoreShape(callee), args: args, handed: handed, into: into, otherInto: otherInto)
		end 'aRuntimeEntry'

		let calleeIndex = try self.funcIndexByName.get(callee) otherwise panic("ProvenanceTracer.callKeepsFieldStoresInView: '{String.from(callee)}' left the function index after `contains`")
		self.slotNamedArgs(try self.project.funcSignatures.get(callee) otherwise panic("ProvenanceTracer.callKeepsFieldStoresInView: '{String.from(callee)}' left the signature registry after `contains`"), args: args, argLabels: argLabels)

		for j in handed 'eachHanded'
			if not self.argIsSlotted(j) 'unslotted'
				continue
			end 'unslotted'

			let at = self.argPositionAt(j)

			if maskHasParam(self.summary.sharesAt(calleeIndex) or self.summary.escapesAt(calleeIndex) or self.summary.bindsAt(calleeIndex), param: at) 'aSecondRoad'
				return false
			end 'aSecondRoad'

			for i in 0 upto args.count() 'eachOther'
				if i == j or not self.argIsSlotted(i) 'notAnother'
					continue
				end 'notAnother'

				let other = self.argPositionAt(i)

				if maskHasParam(self.summary.storesAt(calleeIndex, into: other) or self.summary.storesDeepAt(calleeIndex, into: other), param: at) 'storedAway'
					return false
				end 'storedAway'

				let stored = try args.get(i) otherwise panic("ProvenanceTracer.callKeepsFieldStoresInView: args.get OOB at {i}")

				if self.isTracked(stored) and maskHasParam(self.summary.storesAt(calleeIndex, into: at) or self.summary.storesDeepAt(calleeIndex, into: at), param: other) 'storedIntoIt'
					into.push(stored)
					otherInto.push(stored)
				end 'storedIntoIt'
			end 'eachOther'
		end 'eachHanded'

		return true
	end 'callKeepsFieldStoresInView'

	function runtimeCallKeepsFieldStoresInView(result ValueId, shape RuntimeStoreShape, args ValueIdArray, handed ParamCountArray, into ValueIdArray, otherInto ValueIdArray) returns bool
		if self.isTracked(result) 'mayHandItBack'
			return false
		end 'mayHandItBack'

		for j in handed 'eachHanded'
			for i in 0 upto args.count() 'eachOther'
				if i == j 'itself'
					continue
				end 'itself'

				if shapeStoresInto(shape, receiverIndex: i) and shapeStoresOperand(shape, storedIndex: j) 'storedAway'
					return false
				end 'storedAway'

				let stored = try args.get(i) otherwise panic("ProvenanceTracer.runtimeCallKeepsFieldStoresInView: args.get OOB at {i}")

				if self.isTracked(stored) and shapeStoresInto(shape, receiverIndex: j) and shapeStoresOperand(shape, storedIndex: i) 'storedIntoIt'
					into.push(stored)
					otherInto.push(stored)
				end 'storedIntoIt'
			end 'eachOther'
		end 'eachHanded'

		return true
	end 'runtimeCallKeepsFieldStoresInView'

	function noteFieldStore(func IrFunction, ir MaxonModule, root ValueId, addr ValueId, offset AccessStep, value ValueId, field AccessStep, otherField AccessStep, into ValueIdArray, otherInto ValueIdArray) returns bool
		if self.sameRecordBase(func, ir: ir, value: value) == root 'theRecordStoredAway'
			return false
		end 'theRecordStoredAway'

		if self.sameRecordBase(func, ir: ir, value: addr) != root or not self.isTracked(value) 'anotherRecordsField'
			return true
		end 'anotherRecordsField'

		if offset == field 'intoTheField'
			into.push(value)
		end 'intoTheField'

		if offset == otherField 'intoTheOtherField'
			otherInto.push(value)
		end 'intoTheOtherField'

		return true
	end 'noteFieldStore'

	function operandsReachRecord(func IrFunction, ir MaxonModule, op MaxonOp, root ValueId) returns bool
		maxonOpOperandValues(op, into: self.operands)

		for operand in self.operands 'eachOperand'
			if self.sameRecordBase(func, ir: ir, value: operand) == root 'itsRecord'
				return true
			end 'itsRecord'
		end 'eachOperand'

		return false
	end 'operandsReachRecord'

	// An edge handing `root`'s record to a block argument keeps it in view when that argument is one every edge
	// into its block hands the same record, whose uses the scan then meets as the record's own.
	function edgeKeepsTheRecordInView(func IrFunction, ir MaxonModule, targetBlockId BlockId, incoming ValueId, root ValueId) returns bool
		let position = try self.blockIndex.get(targetBlockId) otherwise panic("ProvenanceTracer.edgeKeepsTheRecordInView: edge target {targetBlockId} is not a block of '{String.from(func.name)}'")
		let target = try ir.blocks.get(try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.edgeKeepsTheRecordInView: blockRefs.get OOB at {position}")) otherwise panic("ProvenanceTracer.edgeKeepsTheRecordInView: blockRef not in module.blocks")

		for arg in target.blockArgs 'eachArg'
			if self.soleIncomingValue(arg.valueId) == incoming and self.sameRecordBase(func, ir: ir, value: arg.valueId) == root 'thisOne'
				return true
			end 'thisOne'
		end 'eachArg'

		return false
	end 'edgeKeepsTheRecordInView'

	// Two values that are two records for certain: two different values, each minted by its own op.
	function provablyTwoRecords(func IrFunction, value ValueId, other ValueId) returns bool
		return value != other and (try func.valueMintedSole.get(value) otherwise panic("ProvenanceTracer.provablyTwoRecords: valueMintedSole.get OOB at v{value}")) and (try func.valueMintedSole.get(other) otherwise panic("ProvenanceTracer.provablyTwoRecords: valueMintedSole.get OOB at v{other}"))
	end 'provablyTwoRecords'

	// The value whose record `value` is, through retains and merges whose every incoming value is one value.
	function sameRecordBase(func IrFunction, ir MaxonModule, value ValueId) returns ValueId
		var current = value
		var hops = 0 as ElementIndex

		while hops < MaxAccessPathSteps 'eachHop'
			let next = self.sameRecordStep(func, ir: ir, value: current)

			if next == current 'itsBase'
				return current
			end 'itsBase'

			current = next
			hops = hops + 1
		end 'eachHop'

		return current
	end 'sameRecordBase'

	// The value a retain or a single-source merge took `value`'s record from, or `value` itself.
	function sameRecordStep(func IrFunction, ir MaxonModule, value ValueId) returns ValueId
		self.indexDefinitions(func, ir: ir)
		let opIdx = try self.definingOps.get(value) otherwise NoDefiningOp

		if opIdx == NoDefiningOp 'aMerge'
			return self.soleIncomingValue(value)
		end 'aMerge'

		return self.hopBaseOf(value) if self.hopKindOf(value) == AccessHopKind.same else value
	end 'sameRecordStep'

	function hopKindOf(value ValueId) returns AccessHopKind
		return try self.hopKinds.get(value) otherwise panic("ProvenanceTracer.hopKindOf: v{value} has a defining op but no hop")
	end 'hopKindOf'

	function hopBaseOf(value ValueId) returns ValueId
		return try self.hopBases.get(value) otherwise panic("ProvenanceTracer.hopBaseOf: v{value} has a defining op but no hop")
	end 'hopBaseOf'

	// The root `value` was read out of, with the steps from it into `steps`, the last step first.
	function accessPathOf(func IrFunction, ir MaxonModule, value ValueId, into AccessStepArray) returns ValueId
		self.indexDefinitions(func, ir: ir)
		var current = value

		while into.count() < MaxAccessPathSteps 'eachHop'
			let opIdx = try self.definingOps.get(current) otherwise NoDefiningOp

			if opIdx == NoDefiningOp 'noOpDefinesIt'
				let merged = self.soleIncomingValue(current)

				if merged == current 'itsRoot'
					return current
				end 'itsRoot'

				current = merged
				continue
			end 'noOpDefinesIt'

			let kind = self.hopKindOf(current)

			if kind == AccessHopKind.stop 'itsRoot'
				return current
			end 'itsRoot'

			if kind == AccessHopKind.field or kind == AccessHopKind.element 'aStep'
				into.push(try self.hopSteps.get(current) otherwise panic("ProvenanceTracer.accessPathOf: hopSteps.get OOB at v{current}"))
			end 'aStep'

			current = self.hopBaseOf(current)
		end 'eachHop'

		return current
	end 'accessPathOf'

	// The one value every edge into the merge `value` is an argument of hands it — `value` itself when there are two
	// or more, when an edge hands it none, or when it is no merge (`indexSoleIncomings`).
	function soleIncomingValue(value ValueId) returns ValueId
		if (try self.mergingBlocks.get(value) otherwise NoMergingBlock) == NoMergingBlock or not (try self.soleIncomingSeen.get(value) otherwise panic("ProvenanceTracer.soleIncomingValue: soleIncomingSeen.get OOB at v{value}")) 'noneHandedIt'
			return value
		end 'noneHandedIt'

		return try self.soleIncomings.get(value) otherwise panic("ProvenanceTracer.soleIncomingValue: soleIncomings.get OOB at v{value}")
	end 'soleIncomingValue'

	// Which op defines each value of `func`, the hop it takes, and which block argument each merge is, once per
	// function asked. The first op to define a value is its defining op.
	function indexDefinitions(func IrFunction, ir MaxonModule)
		if self.indexedDefinitionsOf.equals(func.name) and self.definingOps.count() == func.valueTags.count() 'indexed'
			return
		end 'indexed'

		let valueCount = func.valueTags.count()
		self.definingOps.refill(valueCount, value: NoDefiningOp)
		self.mergingBlocks.refill(valueCount, value: NoMergingBlock)
		self.hopKinds.refill(valueCount, value: AccessHopKind.stop)
		self.hopBases.refill(valueCount, value: 0)
		self.hopSteps.refill(valueCount, value: NoAccessStep)

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexDefinitions: blockRef not in module.blocks")

			for arg in block.blockArgs 'eachArg'
				if (arg.valueId as ElementIndex) < valueCount 'aValueOfIt'
					try self.mergingBlocks.set(arg.valueId, value: block.id) otherwise panic("ProvenanceTracer.indexDefinitions: mergingBlocks.set OOB at v{arg.valueId}")
				end 'aValueOfIt'
			end 'eachArg'

			for opIdx in block.opRefs 'eachOp'
				self.indexDefinition(try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.indexDefinitions: op {opIdx} not in module.ops"), opIdx: opIdx, valueCount: valueCount)
			end 'eachOp'
		end 'eachBlock'

		self.indexSoleIncomings(func, ir: ir, valueCount: valueCount)
		self.indexedDefinitionsOf = func.name
	end 'indexDefinitions'

	// The result arms mirror `maxonOpResultValue`, bound here because that answers in a union — a heap box per op of
	// every function indexed.
	function indexDefinition(op MaxonOp, opIdx OpIndex, valueCount ElementIndex)
		match op 'op'
			loadIndirect(result, addr, offset, _) then self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.field, base: addr, step: offset as AccessStep)
			call(result, callee, args, _, _, _, _, _) then self.indexCallDefinition(result, opIdx: opIdx, valueCount: valueCount, callee: callee, args: args)
			tryCall(result, _, callee, args, _, _, _, _, _) then self.indexCallDefinition(result, opIdx: opIdx, valueCount: valueCount, callee: callee, args: args)
			literal(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			binOp(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			unaryOp(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			compare(result, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			globalAddr(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			stringLiteral(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			functionRef(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			indirectCall(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			asyncCall(result, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			await(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			tryAwait(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			sizeofType(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			constArrayLiteral(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			witnessDispatch(result, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			witnessTryDispatch(result, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			errorFlagEncode(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			serviceSpawn(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			serviceSend(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			serviceReplyCell(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			immortalStructRecord(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			immortalStringTable(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			rawIntrinsic(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)

			ret or
				retVoid or
				condBranch or
				branch or
				storeIndirect or
				throwError or
				propagateError or
				panicAbort or
				switch or
				panicAbortValue or
				covPoint then break 'op'
		end 'op'
	end 'indexDefinition'

	// A retain hands back the record it was handed; an element read, a record within its container's.
	function indexCallDefinition(result ValueId, opIdx OpIndex, valueCount ElementIndex, callee ByteArray, args ValueIdArray)
		if args.count() == 0 'noOperand'
			self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			return
		end 'noOperand'

		let operand = try args.get(0) otherwise panic("ProvenanceTracer.indexCallDefinition: args.get OOB below a positive count")

		if ownershipBookkeepingCallee(callee) 'theSameRecord'
			self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.same, base: operand, step: NoAccessStep)
			return
		end 'theSameRecord'

		if callee.equals(ManagedGetName) or callee.equals(ManagedGetUncheckedName) or callee.equals(ManagedFirstName) 'anElement'
			self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.element, base: operand, step: ElementAccessStep)
			return
		end 'anElement'

		self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
	end 'indexCallDefinition'

	function noteRootDefinition(result ValueId, opIdx OpIndex, valueCount ElementIndex)
		self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.stop, base: result, step: NoAccessStep)
	end 'noteRootDefinition'

	function noteDefiningOp(result ValueId, opIdx OpIndex, valueCount ElementIndex, kind AccessHopKind, base ValueId, step AccessStep)
		if (result as ElementIndex) >= valueCount or (try self.definingOps.get(result) otherwise panic("ProvenanceTracer.noteDefiningOp: definingOps.get OOB at v{result}")) != NoDefiningOp 'notItsFirstDefinition'
			return
		end 'notItsFirstDefinition'

		try self.definingOps.set(result, value: opIdx) otherwise panic("ProvenanceTracer.noteDefiningOp: definingOps.set OOB at v{result}")
		try self.hopKinds.set(result, value: kind) otherwise panic("ProvenanceTracer.noteDefiningOp: hopKinds.set OOB at v{result}")
		try self.hopBases.set(result, value: base) otherwise panic("ProvenanceTracer.noteDefiningOp: hopBases.set OOB at v{result}")
		try self.hopSteps.set(result, value: step) otherwise panic("ProvenanceTracer.noteDefiningOp: hopSteps.set OOB at v{result}")
	end 'noteDefiningOp'

	// What every edge of `func` hands each merge, in one pass over the edges: the first value handed, then the merge
	// itself once a second value — or an edge handing it none — says there is no one value.
	function indexSoleIncomings(func IrFunction, ir MaxonModule, valueCount ElementIndex)
		ir.refillBlockIndexById(func, into: self.blockIndex)
		self.soleIncomings.refill(valueCount, value: 0)
		self.soleIncomingSeen.refill(valueCount, value: false)

		for blockRef in func.blockRefs 'eachBlock'
			let source = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexSoleIncomings: blockRef not in module.blocks")

			for edge in source.branchEdges 'eachEdge'
				let position = try self.blockIndex.get(edge.targetBlockId) otherwise panic("ProvenanceTracer.indexSoleIncomings: edge target {edge.targetBlockId} is not a block of '{String.from(func.name)}'")
				let target = try ir.blocks.get(try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.indexSoleIncomings: blockRefs.get OOB at {position}")) otherwise panic("ProvenanceTracer.indexSoleIncomings: blockRef not in module.blocks")

				for k in 0 upto target.blockArgs.count() 'eachArg'
					let merge = (try target.blockArgs.get(k) otherwise panic("ProvenanceTracer.indexSoleIncomings: blockArgs.get OOB at {k}")).valueId

					if (merge as ElementIndex) < valueCount 'aValueOfIt'
						self.noteIncoming(merge, incoming: try edge.argIds.get(k) otherwise merge, handed: k < edge.argIds.count())
					end 'aValueOfIt'
				end 'eachArg'
			end 'eachEdge'
		end 'eachBlock'
	end 'indexSoleIncomings'

	// One edge hands `merge` the value `incoming` — or, `handed` false, none at all.
	function noteIncoming(merge ValueId, incoming ValueId, handed bool)
		if handed and incoming == merge 'itself'
			return
		end 'itself'

		let seen = try self.soleIncomingSeen.get(merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomingSeen.get OOB at v{merge}")

		if not seen 'theFirst'
			try self.soleIncomingSeen.set(merge, value: true) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomingSeen.set OOB at v{merge}")
			try self.soleIncomings.set(merge, value: incoming if handed else merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomings.set OOB at v{merge}")
			return
		end 'theFirst'

		if not handed or (try self.soleIncomings.get(merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomings.get OOB at v{merge}")) != incoming 'noOneValue'
			try self.soleIncomings.set(merge, value: merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomings.set OOB at v{merge}")
		end 'noOneValue'
	end 'noteIncoming'

	// Is there an immutable name whose record both `value` and `other` may be — as far as a read out of a parameter's
	// slot goes, one put into the slot before that read (`slotMayHoldRoot`)? A parameter's record or a `var`'s is
	// `liveBorrowerOf`'s to judge, as mutable storage both may lie within.
	function mayHoldOneRankAtTheirReads(func IrFunction, ir MaxonModule, value ValueId, other ValueId) returns bool
		let otherIdentity = self.setOf(ProvenanceColumn.identity, value: other)
		var chunk = self.sets.first(self.setOf(ProvenanceColumn.identity, value: value))

		while chunk != NoRootChunk 'eachWord'
			let mask = self.sets.wordOf(chunk) and self.sets.wordAt(otherIdentity, word: self.sets.indexOf(chunk))
			let firstRank = (self.sets.indexOf(chunk) as RootRank) shl RootWordShift

			for bit in 0 upto RootBitIndexMask + 1 'eachBit'
				let rank = firstRank + bit

				if maskHasParam(mask, param: bit) and self.isImmutableBindingRank(rank) and self.slotMayHoldRoot(func, ir: ir, rank: rank, value: value) and self.slotMayHoldRoot(func, ir: ir, rank: rank, value: other) 'bothMayBeIt'
					return true
				end 'bothMayBeIt'
			end 'eachBit'

			chunk = self.sets.next(chunk)
		end 'eachWord'

		return false
	end 'mayHoldOneRankAtTheirReads'

	function setsShareARank(set RootSetId, other RootSetId) returns bool
		var chunk = self.sets.first(set)

		while chunk != NoRootChunk 'eachWord'
			if (self.sets.wordOf(chunk) and self.sets.wordAt(other, word: self.sets.indexOf(chunk))) != NoParamPositions 'shared'
				return true
			end 'shared'

			chunk = self.sets.next(chunk)
		end 'eachWord'

		return false
	end 'setsShareARank'

	// A door that bound or assigned a `var` was refused for what it took: `value` came from it.
	function noteRefusedDoor(value ValueId)
		try self.refusedDoorValues.set(value, value: true) otherwise panic("ProvenanceTracer.noteRefusedDoor: refusedDoorValues.set OOB at v{value}")
		let own = self.writableRankOf(value)

		if own != NoRootRank 'aVarsOwn'
			self.sets.addRank(self.refusedDoorRanks, rank: own)
		end 'aVarsOwn'

		let named = self.bindingRankOf(value)

		if named != NoRootRank 'aNamesOwn'
			self.sets.addRank(self.refusedDoorRanks, rank: named)
		end 'aNamesOwn'
	end 'noteRefusedDoor'

	// May a write through `target` be one through a record a refused `var` door took — the value that door took, a
	// retain of it, or a merge of nothing else? That door's refusal answers it.
	function writeWasRefusedAtItsDoor(func IrFunction, target ValueId) returns bool
		if self.setsShareARank(self.setOf(ProvenanceColumn.identity, value: target), other: self.refusedDoorRanks) 'aRefusedRecord'
			return true
		end 'aRefusedRecord'

		var current = target
		var hops = 0 as ElementIndex

		while hops < MaxAccessPathSteps 'eachHop'
			let refused = try self.refusedDoorValues.get(current) otherwise false

			if refused 'theRefusedValue'
				return true
			end 'theRefusedValue'

			let next = self.sameRecordStep(func, ir: self.module, value: current)

			if next == current 'noFurther'
				return false
			end 'noFurther'

			current = next
			hops = hops + 1
		end 'eachHop'

		return false
	end 'writeWasRefusedAtItsDoor'

	// ⭐ **E3019 AT AN ARGUMENT A CALLEE WRITES, WHICHEVER NAME HOLDS IT** — asked of what `checkCalls` left
	// unjudged: a value a `var` holds, which may be the record of an immutable name live after the call, and any
	// value a live `let` borrows out of the same mutable storage or shares a record with (`liveWatcherOf`).
	function checkWrittenArguments(func IrFunction, ir MaxonModule)
		for k in self.writtenArgsHere 'eachArgument'
			let judged = try self.writtenArgJudged.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgJudged.get OOB at {k}")

			if judged 'judgedAtTheCall'
				continue
			end 'judgedAtTheCall'

			let value = try self.writtenArgValues.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgValues.get OOB at {k}")

			if self.valueIsAnImmutableRecord(func, value: value) or self.writeWasRefusedAtItsDoor(func, target: value) 'writtenByNothingOrRefused'
				continue
			end 'writtenByNothingOrRefused'

			let call = try self.writtenArgCalls.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgCalls.get OOB at {k}")
			let callLine = call.line
			let callColumn = call.column
			let token = self.callTokenAtPosition(func, line: callLine, column: callColumn)
			self.askAtDoor(token, skipsImages: false)
			var blamed = self.firstRootWrittenThrough(func, target: value)

			// A value no `var` holds, that may be a live name's own record, is `checkCalls`' to answer — it did.
			if not blamed.isEmpty() and not self.valueIsAVarsOwn(value) 'answeredAtTheCall'
				self.leaveDoor()
				continue
			end 'answeredAtTheCall'

			self.leaveDoor()

			if blamed.isEmpty() 'notItsRecord'
				let watcher = self.liveWatcherOf(func, ir: ir, value: value, token: token)

				if watcher == NoRootRank 'nothingReadsIt'
					continue
				end 'nothingReadsIt'

				blamed = self.rootNameAt(watcher)
			end 'notItsRecord'

			let paramName = try self.writtenArgParams.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgParams.get OOB at {k}")
			let message = immutableMutatingCallMessage(String.from(blamed), paramName: displayParamName(paramName if not paramName.isEmpty() else ReceiverSourceSpelling), functionName: String.from(func.name))
			self.refuse(callLine, column: callColumn, code: ErrorCode.semanticImmutableRefToMutatingParam, message: message)
		end 'eachArgument'
	end 'checkWrittenArguments'

	// ⭐ **THE LIVE `let` WHOSE BORROWED RECORD `value` MAY BE, OR LIE WITHIN — or `NoRootRank`.** A `let` bound to a
	// borrow out of mutable storage — a field read, an element read, a loop variable, anything that takes no
	// reference of its own — holds a record it does not own, for as long as it is used (NLL, stretched to the end of
	// a loop it was bound before). A value read out of the same mutable storage may be that record, unless both are
	// direct reads of two different fields of one record; a write through it, or a mutable name for it, would change
	// what the `let` reads. A `let` holding a counted reference of its own — a list node's handle — is no borrow.
	// A write asks only whether `value` may BE the borrowed record (`orWithin` false): a `let` is shallow, so what
	// lies within its record is written freely. A record made at the site — derived from no name and no storage —
	// is nothing a `let` bound before it can be reading.
	function liveBorrowerOf(func IrFunction, ir MaxonModule, value ValueId, token TokenIndex, orWithin bool) returns RootRank
		if self.valueIsAFreshRecord(value) 'madeHere'
			return NoRootRank
		end 'madeHere'

		for rank in 0 upto self.rootNames.count() 'eachName'
			let borrowed = self.rootValueAt(rank)

			if borrowed == value or not (try self.rootBorrows.get(rank) otherwise panic("ProvenanceTracer.liveBorrowerOf: rootBorrows.get OOB at {rank}")) or not self.meetInMutableStorage(value, other: borrowed) 'cannotBeWatching'
				continue
			end 'cannotBeWatching'

			if not self.rootIsLiveAt(rank, token: token) 'notLive'
				continue
			end 'notLive'

			if not self.valuesMayBeOneRecord(func, value: value, other: borrowed) and not (orWithin and self.typeAdmits(func, value: value, rank: rank, asksIdentity: false)) 'anotherKindOfRecord'
				continue
			end 'anotherKindOfRecord'

			if self.slotRewrittenSinceRootRead(func, ir: ir, rank: rank, target: value) or self.accessPathsDiverge(func, ir: ir, value: value, other: borrowed) 'anotherRecord'
				continue
			end 'anotherRecord'

			return rank
		end 'eachName'

		return NoRootRank
	end 'liveBorrowerOf'

	// Is `value` a record nothing it was derived from names — a call's fresh result, which may be only itself?
	function valueIsAFreshRecord(value ValueId) returns bool
		if self.sets.first(self.setOf(ProvenanceColumn.inside, value: value)) != NoRootChunk 'liesWithinSomething'
			return false
		end 'liesWithinSomething'

		let identity = self.setOf(ProvenanceColumn.identity, value: value)

		if self.sets.first(identity) == NoRootChunk 'nothingAtAll'
			return true
		end 'nothingAtAll'

		let own = self.writableRankOf(value)
		return own != NoRootRank and self.setIsExactlyRank(identity, rank: own)
	end 'valueIsAFreshRecord'

	// Do `value` and `other` both lie within — or are both — one storage something may write?
	function meetInMutableStorage(value ValueId, other ValueId) returns bool
		return self.setsMeetInMutableStorage(self.setOf(ProvenanceColumn.identity, value: value), other: self.setOf(ProvenanceColumn.identity, value: other)) or self.setsMeetInMutableStorage(self.setOf(ProvenanceColumn.identity, value: value), other: self.setOf(ProvenanceColumn.inside, value: other)) or self.setsMeetInMutableStorage(self.setOf(ProvenanceColumn.inside, value: value), other: self.setOf(ProvenanceColumn.identity, value: other)) or self.setsMeetInMutableStorage(self.setOf(ProvenanceColumn.inside, value: value), other: self.setOf(ProvenanceColumn.inside, value: other))
	end 'meetInMutableStorage'

	function setsMeetInMutableStorage(set RootSetId, other RootSetId) returns bool
		var chunk = self.sets.first(set)

		while chunk != NoRootChunk 'eachWord'
			let word = self.sets.indexOf(chunk)

			if word < self.mutablePlaceWords.count() 'mayHoldAMutablePlace'
				let shared = self.sets.wordOf(chunk) and self.sets.wordAt(other, word: word) and (try self.mutablePlaceWords.get(word) otherwise panic("ProvenanceTracer.setsMeetInMutableStorage: mutablePlaceWords.get OOB at {word}"))

				if shared != NoParamPositions 'meet'
					return true
				end 'meet'
			end 'mayHoldAMutablePlace'

			chunk = self.sets.next(chunk)
		end 'eachWord'

		return false
	end 'setsMeetInMutableStorage'

	// ⭐ **WAS THE SLOT `target` IS READ OUT OF STORED ON EVERY PATH SINCE ROOT `rank` READ IT?** Both are reads of
	// one slot — the `let`'s directly or through the retain its binding took — and `target` can be the `let`'s record
	// only along a path from the `let`'s read to it that stores nothing there but a value that may be that record:
	// `let old = states`, then `states = fresh`, then `states.set(…)` writes the fresh record. A store the path makes
	// through a call is not seen, so the answer errs towards "not stored".
	function slotRewrittenSinceRootRead(func IrFunction, ir MaxonModule, rank RootRank, target ValueId) returns bool
		match self.slotReadUnder(func, ir: ir, value: self.rootValueAt(rank)) 'borrowedRead'
			load(borrowOp, addr, offset) then return self.slotRewrittenBefore(func, ir: ir, from: borrowOp, to: self.slotReadUnder(func, ir: ir, value: target), addr: addr, offset: offset, rank: rank)

			none or
				store or
				retainOf then return false
		end 'borrowedRead'
	end 'slotRewrittenSinceRootRead'

	function slotRewrittenBefore(func IrFunction, ir MaxonModule, from OpIndex, to SlotRead, addr ValueId, offset ByteOffset, rank RootRank) returns bool
		match to 'targetRead'
			load(targetOp, targetAddr, targetOffset) then return targetAddr == addr and targetOffset == offset and not self.slotReachedUnstored(func, ir: ir, from: from, to: targetOp, addr: addr, offset: offset, rank: rank)

			none or
				store or
				retainOf then return false
		end 'targetRead'
	end 'slotRewrittenBefore'

	// The field read `value` is: the load itself, or the load a retain of it was taken of.
	function slotReadUnder(func IrFunction, ir MaxonModule, value ValueId) returns SlotRead
		self.indexDefinitions(func, ir: ir)
		let opIndex = try self.definingOps.get(value) otherwise NoDefiningOp

		if opIndex == NoDefiningOp 'notAnOp'
			return SlotRead.none
		end 'notAnOp'

		return self.slotReadThrough(func, ir: ir, read: slotReadOfOp(try ir.ops.get(opIndex) otherwise panic("ProvenanceTracer.slotReadUnder: opIndex {opIndex} not in module.ops"), opIndex: opIndex))
	end 'slotReadUnder'

	function slotReadThrough(func IrFunction, ir MaxonModule, read SlotRead) returns SlotRead
		match read 'read'
			retainOf(operand) then return self.slotReadUnder(func, ir: ir, value: operand)

			none or
				load or
				store then return read
		end 'read'
	end 'slotReadThrough'

	// Is there a path from op `from` to op `to` along which nothing stores into `(addr, offset)`?
	function slotReachedUnstored(func IrFunction, ir MaxonModule, from OpIndex, to OpIndex, addr ValueId, offset ByteOffset, rank RootRank) returns bool
		ir.refillBlockIndexById(func, into: self.blockIndex)
		var worklist = self.reachWorklist
		var visited = self.reachVisited
		worklist.clear()
		visited.refill(func.nextBlockId as ElementIndex, value: false)

		for blockRef in func.blockRefs 'findTheRead'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.slotReachedUnstored: blockRef from func.blockRefs not in module.blocks")

			for at in 0 upto block.opRefs.count() 'eachOp'
				if (try block.opRefs.get(at) otherwise panic("ProvenanceTracer.slotReachedUnstored: opRefs.get OOB at {at}")) != from 'anotherOp'
					continue
				end 'anotherOp'

				match self.scanForSlotRead(ir, block: block, start: (at + 1) as ElementIndex, to: to, addr: addr, offset: offset, rank: rank) 'tail'
					reached then return true
					stored then return false
					ranOff then collectMaxonBlockSuccessors(ir, block: block, into: worklist)
				end 'tail'

				break 'findTheRead'
			end 'eachOp'
		end 'findTheRead'

		var head = 0 as ElementIndex

		while head < worklist.count() 'eachBlock'
			let blockId = try worklist.get(head) otherwise panic("ProvenanceTracer.slotReachedUnstored: worklist.get OOB at {head}")
			head = head + 1

			let seen = try visited.get(blockId) otherwise panic("ProvenanceTracer.slotReachedUnstored: block {blockId} is past the function's {func.nextBlockId} block ids")

			if seen 'seen'
				continue
			end 'seen'

			try visited.set(blockId, value: true) otherwise panic("ProvenanceTracer.slotReachedUnstored: visited.set OOB at block {blockId}")
			let block = self.blockById(func, ir: ir, blockId: blockId)

			match self.scanForSlotRead(ir, block: block, start: 0, to: to, addr: addr, offset: offset, rank: rank) 'body'
				reached then return true
				stored then continue
				ranOff then collectMaxonBlockSuccessors(ir, block: block, into: worklist)
			end 'body'
		end 'eachBlock'

		return false
	end 'slotReachedUnstored'

	// The block of `func` with id `blockId`, through the id index the caller refilled (`refillBlockIndexById`).
	function blockById(func IrFunction, ir MaxonModule, blockId BlockId) returns IrBlock
		let position = try self.blockIndex.get(blockId) otherwise panic("ProvenanceTracer.blockById: block {blockId} is not a block of '{String.from(func.name)}'")
		let blockRef = try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.blockById: blockIndexById placed a block at {position}, past func.blockRefs")
		return try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.blockById: blockRef {blockRef} not in module.blocks")
	end 'blockById'

	// ⭐ **A READ OUT OF A PARAMETER'S SLOT IS A `let`'S RECORD ONLY WHERE SOMETHING PUT IT THERE FIRST.** What such
	// a read may be is what any store into that slot stored (`traceLoad`), wherever the store is; the record of root
	// `rank` is really there only along a path to the read from a store of a value that may be it — or from the
	// `let`'s own read of the slot — that no other store of the slot cuts: `var entry = self.currentBlock` is not
	// the `rhsBlock` a later `self.currentBlock = rhsBlock` stores. Any other value is answered as the sets say.
	function slotMayHoldRoot(func IrFunction, ir MaxonModule, rank RootRank, value ValueId) returns bool
		match self.slotReadUnder(func, ir: ir, value: value) 'read'
			load(readOp, addr, offset) then return not self.readsParameterStorage(addr) or self.rootPutIntoSlotBefore(func, ir: ir, rank: rank, to: readOp, addr: addr, offset: offset)

			none or
				store or
				retainOf then return true
		end 'read'
	end 'slotMayHoldRoot'

	function rootPutIntoSlotBefore(func IrFunction, ir MaxonModule, rank RootRank, to OpIndex, addr ValueId, offset ByteOffset) returns bool
		let rootRead = self.slotReadUnder(func, ir: ir, value: self.rootValueAt(rank))

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.rootPutIntoSlotBefore: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.opRefs 'eachOp'
				let op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.rootPutIntoSlotBefore: opIdx {opIdx} not in module.ops")

				if opLoadsOrStoresASlot(op) and self.putsRootIntoSlot(slotReadOfOp(op, opIndex: opIdx), rootRead: rootRead, addr: addr, offset: offset, rank: rank) and self.slotReachedUnstored(func, ir: ir, from: opIdx, to: to, addr: addr, offset: offset, rank: rank) 'reachesTheRead'
					return true
				end 'reachesTheRead'
			end 'eachOp'
		end 'eachBlock'

		return false
	end 'rootPutIntoSlotBefore'

	// Does `read` put root `rank`'s record into `(addr, offset)` — a store of a value that may be it, or the root's
	// own read of the slot (`rootRead`)?
	function putsRootIntoSlot(read SlotRead, rootRead SlotRead, addr ValueId, offset ByteOffset, rank RootRank) returns bool
		return match read 'read'
			store(storeAddr, storeOffset, stored) gives storeAddr == addr and storeOffset == offset and self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: stored), rank: rank)
			load(loadOp, loadAddr, loadOffset) gives loadAddr == addr and loadOffset == offset and slotReadIsLoadOp(rootRead, opIndex: loadOp)

			none or
				retainOf gives false
		end 'read'
	end 'putsRootIntoSlot'

	// What `block`'s ops from `start` meet first: op `to`, a store into `(addr, offset)` of a value that cannot be root
	// `rank`'s record, or neither.
	function scanForSlotRead(ir MaxonModule, block IrBlock, start ElementIndex, to OpIndex, addr ValueId, offset ByteOffset, rank RootRank) returns SlotScan
		for i in start upto block.opRefs.count() 'eachOp'
			let opIdx = try block.opRefs.get(i) otherwise panic("ProvenanceTracer.scanForSlotRead: opRefs.get OOB at {i}")

			if opIdx == to 'theRead'
				return SlotScan.reached
			end 'theRead'

			let op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.scanForSlotRead: opIdx {opIdx} not in module.ops")

			if opLoadsOrStoresASlot(op) and self.replacesTheRecordOf(slotReadOfOp(op, opIndex: opIdx), addr: addr, offset: offset, rank: rank) 'thisSlot'
				return SlotScan.stored
			end 'thisSlot'
		end 'eachOp'

		return SlotScan.ranOff
	end 'scanForSlotRead'

	function replacesTheRecordOf(read SlotRead, addr ValueId, offset ByteOffset, rank RootRank) returns bool
		return match read 'read'
			store(storeAddr, storeOffset, stored) gives storeAddr == addr and storeOffset == offset and not self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: stored), rank: rank)

			none or
				load or
				retainOf gives false
		end 'read'
	end 'replacesTheRecordOf'

	// "the result of '<callee>', which may share storage with immutable variable '<borrower>'," — E3078's clause for
	// a `var` read out of storage a live `let` borrows.
	function borrowedStorageSubject(func IrFunction, ir MaxonModule, value ValueId, borrower RootRank) returns String
		return "{self.producerOf(func, ir: ir, value: value)}, which may share storage with immutable variable '{String.from(self.rootNameAt(borrower))}',"
	end 'borrowedStorageSubject'

	function producerOf(func IrFunction, ir MaxonModule, value ValueId) returns String
		match self.definingOpOf(func, ir: ir, value: value) 'producer'
			notAnOp then return NoProducerSubject
			op(opIndex) then return self.producerOfOp(func, op: try ir.ops.get(opIndex) otherwise panic("ProvenanceTracer.producerOf: opIndex {opIndex} not in module.ops"))
		end 'producer'
	end 'producerOf'

	// The producer E3078 names for a value an op made: a declared callee by the noun every call message uses, a
	// runtime entry by the member the author wrote, a witness by its requirement, a function value by the `let` it
	// is bound to — else "a value".
	function producerOfOp(func IrFunction, op MaxonOp) returns String
		return match op 'op'
			call(_, callee, _, _, _, _, _, mint) gives self.namedCallSubject(callee, mint: mint)
			tryCall(_, _, callee, _, _, _, _, _, mint) gives self.namedCallSubject(callee, mint: mint)
			witnessDispatch(_, _, _, methodIndex, interfaceDeclIndex, _, _) gives "the result of '{self.witnessMethodName(methodIndex, interfaceDeclIndex: interfaceDeclIndex)}'"
			witnessTryDispatch(_, _, _, _, methodIndex, interfaceDeclIndex, _) gives "the result of '{self.witnessMethodName(methodIndex, interfaceDeclIndex: interfaceDeclIndex)}'"
			indirectCall gives self.boundFunctionValueSubject(func, op: op)
			literal or
				ret or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				loadIndirect or
				storeIndirect or
				stringLiteral or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				asyncCall or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic gives NoProducerSubject
		end 'op'
	end 'producerOfOp'

	// ⭐ **E3077 IS WITHHELD WHERE `let` WOULD NOT COMPILE.** A `var` the author never reassigned is still
	// legitimately mutable when a `let` there would meet a mutable door that moves it or refuses it: handed whole
	// to a door and read afterwards, or — while it is live after the door — handed whole while it borrows rather
	// than owns, or reached by a value another `var` door takes. The parser reported its first candidate; the
	// first one that does NEED `let` is reported instead, or none.
	function settleVarShouldBeLet(func IrFunction)
		let candidates = func.provenanceSites().varCandidates
		var firstUnexcused = candidates.values.count()

		for c in 0 upto candidates.values.count() 'eachCandidate'
			let value = try candidates.values.get(c) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: values.get OOB at {c}")
			let name = try candidates.names.get(c) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: names.get OOB at {c}")
			let declared = try candidates.declTokens.get(c) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: declTokens.get OOB at {c}")
			let lastUse = (try candidates.infos.get(c) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: infos.get OOB at {c}")).lastReadToken
			let liveUntil = liveUntilAcrossLoops(declared, lastUse: lastUse if lastUse > declared else declared, loops: func.provenanceSites().loops)

			if not self.varIsNeededMutable(func, value: value, name: name, liveUntil: liveUntil) 'couldBeALet'
				firstUnexcused = c
				break
			end 'couldBeALet'
		end 'eachCandidate'

		if firstUnexcused == 0 'theReportedOneStands'
			return
		end 'theReportedOneStands'

		let at = self.hygieneIndexOf(candidates.reported)

		if at == NoHygieneDiagnostic 'reportedNothing'
			return
		end 'reportedNothing'

		if firstUnexcused == candidates.values.count() 'everyOneIsNeeded'
			try self.hygieneWithdrawn.set(at, value: true) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: hygieneWithdrawn.set OOB at {at}")
			return
		end 'everyOneIsNeeded'

		let name = try candidates.names.get(firstUnexcused) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: names.get OOB at {firstUnexcused}")
		let range = try candidates.ranges.get(firstUnexcused) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: ranges.get OOB at {firstUnexcused}")
		try self.project.bindingHygieneDiagnostics.set(at, value: Diagnostic.create(ErrorCode.semanticVarShouldBeLet, message: varShouldBeLetMessage(String.from(name)), line: range.line, column: range.column, filePath: candidates.reported.filePath)) otherwise panic("ProvenanceTracer.settleVarShouldBeLet: bindingHygieneDiagnostics.set OOB at {at}")
	end 'settleVarShouldBeLet'

	function hygieneIndexOf(reported Diagnostic) returns ElementIndex
		self.indexHygieneDiagnostics()
		var at = try self.hygieneFirstAtPosition.get(positionKey(reported.line, column: reported.column)) otherwise NoHygieneDiagnostic

		while at != NoHygieneDiagnostic 'eachAtThePosition'
			if (try self.project.bindingHygieneDiagnostics.get(at) otherwise panic("ProvenanceTracer.hygieneIndexOf: bindingHygieneDiagnostics.get OOB at {at}")) is reported 'thisOne'
				return at
			end 'thisOne'

			at = try self.hygieneNextAtPosition.get(at) otherwise panic("ProvenanceTracer.hygieneIndexOf: hygieneNextAtPosition.get OOB at {at}")
		end 'eachAtThePosition'

		return NoHygieneDiagnostic
	end 'hygieneIndexOf'

	// Index the binding-hygiene diagnostics by position, once: a position's chain starts at the first of them.
	function indexHygieneDiagnostics()
		if self.hygieneIndexed 'indexed'
			return
		end 'indexed'

		self.hygieneIndexed = true
		let count = self.project.bindingHygieneDiagnostics.count()
		self.hygieneNextAtPosition.refill(count, value: NoHygieneDiagnostic)
		self.hygieneWithdrawn.refill(count, value: false)
		var i = count

		while i > 0 'eachFromTheLast'
			i = i - 1
			let diagnostic = try self.project.bindingHygieneDiagnostics.get(i) otherwise panic("ProvenanceTracer.indexHygieneDiagnostics: bindingHygieneDiagnostics.get OOB at {i}")
			let key = positionKey(diagnostic.line, column: diagnostic.column)
			try self.hygieneNextAtPosition.set(i, value: try self.hygieneFirstAtPosition.get(key) otherwise NoHygieneDiagnostic) otherwise panic("ProvenanceTracer.indexHygieneDiagnostics: hygieneNextAtPosition.set OOB at {i}")
			self.hygieneFirstAtPosition.upsert(key, value: i)
		end 'eachFromTheLast'
	end 'indexHygieneDiagnostics'

	// The diagnostics a door withdrew, dropped in one pass once every function has settled.
	function dropWithdrawnHygiene()
		if not self.hygieneIndexed 'noneWithdrawn'
			return
		end 'noneWithdrawn'

		var kept = DiagnosticArray.create()

		for i in 0 upto self.project.bindingHygieneDiagnostics.count() 'eachDiagnostic'
			if not (try self.hygieneWithdrawn.get(i) otherwise panic("ProvenanceTracer.dropWithdrawnHygiene: hygieneWithdrawn.get OOB at {i}")) 'kept'
				kept.push(try self.project.bindingHygieneDiagnostics.get(i) otherwise panic("ProvenanceTracer.dropWithdrawnHygiene: bindingHygieneDiagnostics.get OOB at {i}"))
			end 'kept'
		end 'eachDiagnostic'

		self.project.bindingHygieneDiagnostics = kept
	end 'dropWithdrawnHygiene'

	// Would a `let` in place of the `var` named `name` holding `value`, live until `liveUntil`, meet a mutable door that
	// moves or refuses it?
	function varIsNeededMutable(func IrFunction, value ValueId, name ByteArray, liveUntil TokenIndex) returns bool
		let rank = self.writableRankOf(value)

		if rank == NoRootRank 'noVarsOwnRecord'
			return false
		end 'noVarsOwnRecord'

		let sites = func.provenanceSites()

		for k in 0 upto sites.moveSites.count() 'eachDoor'
			let site = try sites.moveSites.get(k) otherwise panic("ProvenanceTracer.varIsNeededMutable: moveSites.get OOB at {k}")

			if not site.sourceIsMutable or site.sourceValue != value or not site.source.equals(name) 'anotherDoor'
				continue
			end 'anotherDoor'

			if site.readAfter or (liveUntil > site.token and not self.wouldOwnItsRecord(value, rank: rank)) 'aLetWouldNotCompile'
				return true
			end 'aLetWouldNotCompile'
		end 'eachDoor'

		let ownsItsRecord = self.wouldOwnItsRecord(value, rank: rank)

		for site in sites.mutableBindingSites 'eachBinding'
			if liveUntil > site.token and self.aLetWouldMeetThisDoor(site.value, varValue: value, rank: rank, ownsItsRecord: ownsItsRecord) 'derivedIntoAMutableName'
				return true
			end 'derivedIntoAMutableName'
		end 'eachBinding'

		return false
	end 'varIsNeededMutable'

	// A door handed `door`: a `let` bound where the `var` holding `varValue` is would be refused there when it may
	// reach the record without being it, or when it is the record and borrows rather than owns it. Handed whole and
	// owning its record, the `let` would move — which needs a read after to matter, and that is its `MoveSite`'s.
	function aLetWouldMeetThisDoor(door ValueId, varValue ValueId, rank RootRank, ownsItsRecord bool) returns bool
		if door == varValue 'handedWhole'
			return not ownsItsRecord
		end 'handedWhole'

		return self.valueReachesRank(door, rank: rank)
	end 'aLetWouldMeetThisDoor'

	// Would a `let` bound to `value` — a `var`'s record, at `rank` — own it outright?
	function wouldOwnItsRecord(value ValueId, rank RootRank) returns bool
		return self.setIsExactlyRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) and self.sets.first(self.setOf(ProvenanceColumn.inside, value: value)) == NoRootChunk
	end 'wouldOwnItsRecord'

	// A refusal, held in source order until the function's doors have all asked. Equal positions keep the order
	// the doors asked in.
	function refuse(line LineNumber, column ColumnNumber, code ErrorCode, message String)
		let refusal = PendingRefusal.create(line, column: column, code: code, message: message)
		var at = self.refusals.count()

		while at > 0 and (try self.refusals.get(at - 1) otherwise panic("ProvenanceTracer.refuse: refusals.get OOB at {at - 1}")).at > refusal.at 'pastLaterOnes'
			at = at - 1
		end 'pastLaterOnes'

		self.refusals.insert(at, value: refusal)
	end 'refuse'

	function reportRefusals(func IrFunction)
		for refusal in self.refusals 'eachRefusal'
			reportPositioned(self.project, code: refusal.code, message: refusal.message, line: refusal.line, column: refusal.column, filePath: func.sourceFilePath)
		end 'eachRefusal'
	end 'reportRefusals'

	function witnessMethodName(methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex) returns String
		let slot = witnessSlotAt(self.signatures, witnessSlots: self.witnessSlots, dispatched: dispatchedInterfaceAt(self.signatures, interfaceDeclIndex: interfaceDeclIndex), interfaceDeclIndex: interfaceDeclIndex, methodIndex: methodIndex)
		return String.from(slot.method.name)
	end 'witnessMethodName'

	// "the result of '<callee>', which may share storage with …" — the call as written, and the binding the
	// storage belongs to when the call was handed it whole rather than a field of it.
	function sharedStorageSubject(func IrFunction, ir MaxonModule, value ValueId) returns String
		match self.definingOpOf(func, ir: ir, value: value) 'producer'
			notAnOp then return self.sharedStorageClause(func, producer: NoProducerSubject, value: value, producerOperands: singletonValue(value))
			op(opIndex) then return self.sharedStorageSubjectOfOp(func, value: value, op: try ir.ops.get(opIndex) otherwise panic("ProvenanceTracer.sharedStorageSubject: opIndex {opIndex} not in module.ops"))
		end 'producer'
	end 'sharedStorageSubject'

	function sharedStorageSubjectOfOp(func IrFunction, value ValueId, op MaxonOp) returns String
		return self.sharedStorageClause(func, producer: self.producerOfOp(func, op: op), value: value, producerOperands: self.producerOperandsOf(op, value: value))
	end 'sharedStorageSubjectOfOp'

	// What the call that made `value` was handed, which a binding it names must have reached it through; a value
	// no call made stands for itself.
	function producerOperandsOf(op MaxonOp, value ValueId) returns ValueIdArray
		return match op 'op'
			call(_, _, args, _, _, _, _, _) gives args
			tryCall(_, _, _, args, _, _, _, _, _) gives args
			witnessDispatch(_, args, _, _, _, _, _) gives args
			witnessTryDispatch(_, _, args, _, _, _, _) gives args

			// Its `args` is the variant's tail field, so it is read in a small match (`LowerMaxonToStd.lowerIndirectCall`).
			indirectCall gives self.indirectCallOperands(op)
			literal or
				ret or
				retVoid or
				binOp or
				unaryOp or
				compare or
				condBranch or
				branch or
				globalAddr or
				loadIndirect or
				storeIndirect or
				stringLiteral or
				throwError or
				propagateError or
				panicAbort or
				functionRef or
				asyncCall or
				await or
				tryAwait or
				sizeofType or
				constArrayLiteral or
				switch or
				panicAbortValue or
				errorFlagEncode or
				serviceSpawn or
				serviceSend or
				serviceReplyCell or
				immortalStructRecord or
				immortalStringTable or
				covPoint or
				rawIntrinsic gives singletonValue(value)
		end 'op'
	end 'producerOperandsOf'

	function indirectCallOperands(op MaxonOp) returns ValueIdArray
		maxonOpOperandValues(op, into: self.operands)
		return self.operands
	end 'indirectCallOperands'

	// The member the author wrote: a declared callee through the diagnostic noun every call message uses, a
	// runtime entry through the method it serves. An entry that serves no method was never written as a call.
	function namedCallSubject(callee ByteArray, mint CalleeMint) returns String
		if self.funcIndexByName.contains(callee) 'declared'
			return "the result of '{String.from(calleeDisplayName(overloadRegistrationBaseName(callDiagnosticNoun(callee, mint: mint))))}'"
		end 'declared'

		return match runtimeCalleeSourceMethod(callee) 'written'
			found(method) gives "the result of '{String.from(method)}'"
			sharedByTwoSpellings(spelling, alsoSpelled) gives "the result of '{String.from(spelling)}' or '{String.from(alsoSpelled)}'"
			notFound gives NoProducerSubject
		end 'written'
	end 'namedCallSubject'

	// A call through a function value is named by the `let` its callee is bound to; one read out of anything else
	// has no name to give. The callee is read in a small match, for `producerOperandsOf`'s reason.
	function boundFunctionValueSubject(func IrFunction, op MaxonOp) returns String
		match op 'indirect'
			indirectCall(_, callee, _) then return self.letNamedSubject(func, callee: callee)
			default panic("ProvenanceTracer.boundFunctionValueSubject: handed an op that is not an indirect call")
		end 'indirect'
	end 'boundFunctionValueSubject'

	function letNamedSubject(func IrFunction, callee ValueId) returns String
		let bindings = func.provenanceSites().immutableBindings

		for i in 0 upto bindings.values.count() 'eachBinding'
			if (try bindings.values.get(i) otherwise panic("ProvenanceTracer.letNamedSubject: values.get OOB at {i}")) == callee 'namesTheCallee'
				return "the result of '{String.from(try bindings.names.get(i) otherwise panic("ProvenanceTracer.letNamedSubject: names.get OOB at {i} — the two columns are pushed together"))}'"
			end 'namesTheCallee'
		end 'eachBinding'

		return NoProducerSubject
	end 'letNamedSubject'

	// The binding is named when the producer was handed it — or a record it holds — as an operand; a producer
	// handed only a field of one says so instead, since a field has no binding to name.
	function sharedStorageClause(func IrFunction, producer String, value ValueId, producerOperands ValueIdArray) returns String
		let byIdentity = self.leastHandedBindingRank(func, column: ProvenanceColumn.identity, value: value, producerOperands: producerOperands, bound: self.rootNames.count() as RootRank)
		let rank = self.leastHandedBindingRank(func, column: ProvenanceColumn.inside, value: value, producerOperands: producerOperands, bound: byIdentity)

		if self.isImmutableBindingRank(rank) 'handedTheBinding'
			return "{producer}, which may share storage with immutable variable '{String.from(self.rootNameAt(rank))}',"
		end 'handedTheBinding'

		return "{producer}, which may share storage with a field of an immutable variable,"
	end 'sharedStorageClause'

	// The least rank below `bound` of `value`'s set in `column` that names a binding of a type `value` could be
	// or lie within, and the producer was handed — or `bound` itself, so two sets are searched as one by passing
	// the first one's answer to the second.
	function leastHandedBindingRank(func IrFunction, column ProvenanceColumn, value ValueId, producerOperands ValueIdArray, bound RootRank) returns RootRank
		var chunk = self.sets.first(self.setOf(column, value: value))
		let asksIdentity = column == ProvenanceColumn.identity

		while chunk != NoRootChunk 'eachWord'
			let mask = self.sets.wordOf(chunk)
			let firstRank = (self.sets.indexOf(chunk) as RootRank) shl RootWordShift

			for bit in 0 upto RootBitIndexMask + 1 'eachBit'
				let rank = firstRank + bit

				if rank >= bound 'pastTheBound'
					return bound
				end 'pastTheBound'

				if maskHasParam(mask, param: bit) and self.rootCountsAtDoor(rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: asksIdentity) and self.anOperandIsOrHolds(producerOperands, rank: rank) 'handed'
					return rank
				end 'handed'
			end 'eachBit'

			chunk = self.sets.next(chunk)
		end 'eachWord'

		return bound
	end 'leastHandedBindingRank'

	function anOperandIsOrHolds(producerOperands ValueIdArray, rank RootRank) returns bool
		for operand in producerOperands 'eachOperand'
			if self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.holds, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.storedHolds, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.deepHolds, value: operand), rank: rank) 'reached'
				return true
			end 'reached'
		end 'eachOperand'

		return false
	end 'anOperandIsOrHolds'

	// The op whose result `value` is, out of the function's definitions (`indexDefinitions`).
	function definingOpOf(func IrFunction, ir MaxonModule, value ValueId) returns DefiningOp
		self.indexDefinitions(func, ir: ir)
		let opIdx = try self.definingOps.get(value) otherwise NoDefiningOp
		return DefiningOp.notAnOp if opIdx == NoDefiningOp else DefiningOp.op(opIdx)
	end 'definingOpOf'

	function isTracked(value ValueId) returns bool
		return try self.tracked.get(value) otherwise panic("ProvenanceTracer.isTracked: v{value} is past the traced function's value count")
	end 'isTracked'

	function setOf(column ProvenanceColumn, value ValueId) returns RootSetId
		return (column.ordinal as RootSetId) * self.setsPerColumn + (value as RootSetId)
	end 'setOf'

	function wordAt(column ProvenanceColumn, value ValueId, word MaskWordCount) returns ParamPositionMask
		return self.sets.wordAt(self.setOf(column, value: value), word: word)
	end 'wordAt'

	function unionInto(to RootSetId, from RootSetId)
		if self.sets.union(to, from: from) 'grew'
			self.changed = true
		end 'grew'
	end 'unionInto'

	function unionMask(column ProvenanceColumn, to ValueId, from ProvenanceColumn, source ValueId)
		self.unionInto(self.setOf(column, value: to), from: self.setOf(from, value: source))
	end 'unionMask'

	// `key`'s set, minted empty on the first store into it.
	function slotFor(key StoreSlotKey) returns RootSetId
		let known = self.slotOfThisWalk(self.storeSlots, key: key)

		if known != NoStoreSlotSet 'known'
			return known
		end 'known'

		let slot = self.sets.addSet()
		self.storeSlots.upsert(key, value: self.stampedWithThisWalk(slot))
		return slot
	end 'slotFor'

	function deepSlotFor(key StoreSlotKey) returns RootSetId
		let known = self.slotOfThisWalk(self.deepSlots, key: key)

		if known != NoStoreSlotSet 'known'
			return known
		end 'known'

		let slot = self.sets.addSet()
		self.deepSlots.upsert(key, value: self.stampedWithThisWalk(slot))
		return slot
	end 'deepSlotFor'

	// `index`'s set for `key` in the walk being traced, or `NoStoreSlotSet`.
	function slotOfThisWalk(index StoreSlotIndex, key StoreSlotKey) returns RootSetId
		let stamped = try index.get(key) otherwise NoStampedStoreSlot

		if (stamped shr StoreSlotWalkShift) != (self.storeSlotWalk as StampedStoreSlot) 'anotherWalks'
			return NoStoreSlotSet
		end 'anotherWalks'

		return (stamped and StoreSlotSetMask) as RootSetId
	end 'slotOfThisWalk'

	function stampedWithThisWalk(slot RootSetId) returns StampedStoreSlot
		if slot > (StoreSlotSetMask as RootSetId) 'pastTheLowWord'
			panic("ProvenanceTracer.stampedWithThisWalk: set {slot} does not fit the low word of a stamped slot")
		end 'pastTheLowWord'

		return ((self.storeSlotWalk as StampedStoreSlot) shl StoreSlotWalkShift) or (slot as StampedStoreSlot)
	end 'stampedWithThisWalk'

	function setBit(column ProvenanceColumn, value ValueId, rank RootRank)
		self.sets.addRank(self.setOf(column, value: value), rank: rank)
	end 'setBit'

	// `setBit` from inside a walk, where a set that grows must be read again.
	function seedBit(column ProvenanceColumn, value ValueId, rank RootRank)
		let set = self.setOf(column, value: value)

		if not self.sets.hasRank(set, rank: rank) 'new'
			self.sets.addRank(set, rank: rank)
			self.changed = true
		end 'new'
	end 'seedBit'

	// ⭐ **THE BINDING A DOOR BLAMES FOR `value`:** the `let` whose own record `value` is, when it is one; else the
	// first in declaration order it may BE (`RootReach.identity`) — only a binding whose record could have
	// `value`'s type, since one record is never two declared types — or, reaching further, may lie within.
	// Empty when there is none.
	function firstRootName(func IrFunction, value ValueId, reach RootReach) returns ByteArray
		let bound = self.rootNames.count() as RootRank

		let own = self.bindingRankOf(value)

		if own != NoRootRank 'aBindingsOwnValue'
			return self.rootNameAt(own) if self.rootCountsAtDoor(own) else EmptySourceText
		end 'aBindingsOwnValue'

		var rank = self.leastAdmittedRank(func, column: ProvenanceColumn.identity, value: value, bound: bound, also: RootCondition.none)

		if reach == RootReach.identityOrInside 'withinToo'
			rank = self.leastAdmittedRank(func, column: ProvenanceColumn.inside, value: value, bound: rank, also: RootCondition.none)
		end 'withinToo'

		return self.rootNameAt(rank) if self.isImmutableBindingRank(rank) else EmptySourceText
	end 'firstRootName'

	// The least rank below `bound` in `value`'s set in `column` that names a binding `value`'s type admits, or
	// `bound` itself — so several sets are searched as one by passing each one's answer to the next. What `value`
	// may BE is asked of a binding whose record could have `value`'s type, and what it lies within of a binding
	// whose record can hold one. `also` is what else the door asks of the root. The set is walked by its bits, so a
	// question costs what the set holds rather than every binding of the function.
	function leastAdmittedRank(func IrFunction, column ProvenanceColumn, value ValueId, bound RootRank, also RootCondition) returns RootRank
		var chunk = self.sets.first(self.setOf(column, value: value))
		let asksIdentity = column == ProvenanceColumn.identity

		while chunk != NoRootChunk 'eachWord'
			let mask = self.sets.wordOf(chunk)
			let firstRank = (self.sets.indexOf(chunk) as RootRank) shl RootWordShift

			for bit in 0 upto RootBitIndexMask + 1 'eachBit'
				let rank = firstRank + bit

				if rank >= bound 'pastTheBound'
					return bound
				end 'pastTheBound'

				if maskHasParam(mask, param: bit) and self.rootCountsAtDoor(rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: asksIdentity) and self.rootMeets(also, rank: rank, value: value, func: func) and (not asksIdentity or self.slotMayHoldRoot(func, ir: self.module, rank: rank, value: value)) 'admitted'
					return rank
				end 'admitted'
			end 'eachBit'

			chunk = self.sets.next(chunk)
		end 'eachWord'

		return bound
	end 'leastAdmittedRank'

	function rootMeets(condition RootCondition, rank RootRank, value ValueId, func IrFunction) returns bool
		return match condition 'condition'
			none gives true
			slotNotRewritten gives not self.slotRewrittenSinceRootRead(func, ir: self.module, rank: rank, target: value)
			immutableRecord gives try self.rootIsImmutableRecord.get(rank) otherwise panic("ProvenanceTracer.rootMeets: rootIsImmutableRecord.get OOB at {rank}")
		end 'condition'
	end 'rootMeets'

	function typeAdmits(func IrFunction, value ValueId, rank RootRank, asksIdentity bool) returns bool
		if asksIdentity 'mayBeIt'
			return self.valuesMayBeOneRecord(func, value: value, other: self.rootValueAt(rank))
		end 'mayBeIt'

		let within = try self.rootRecordKinds.get(rank) otherwise panic("ProvenanceTracer.typeAdmits: rootRecordKinds.get OOB at {rank} — it is pushed with the roots")
		let tag = valueTagOf(func, value: value)

		if tagIsByteRecord(tag) 'bytes'
			return within.mayHold(HeldByteRecordKind)
		end 'bytes'

		if tag != ValueTypeTag.genericInstance and not self.signatures.tagMayNameAggregate(tag) 'anyOtherKind'
			return true
		end 'anyOtherKind'

		return within.mayHold(try self.heldRecordKindOf(func, value: value) otherwise return true)
	end 'typeAdmits'

	// Can `value` BE the record `other` holds? Two records of different declared types are two records; an opaque
	// `T` or an existential may stand for any, and a byte record's identity is its bytes' holder whatever it is
	// spelled as. Two `named` values are compared by the record their names denote.
	function valuesMayBeOneRecord(func IrFunction, value ValueId, other ValueId) returns bool
		let tag = valueTagOf(func, value: value)
		let otherTag = valueTagOf(func, value: other)

		if not mayBeOneRecord(tag, other: otherTag) 'twoRepresentations'
			return false
		end 'twoRepresentations'

		if tagIsOpaqueRecord(tag) or tagIsOpaqueRecord(otherTag) or tagIsByteRecord(tag) 'anyOfItsKind'
			return true
		end 'anyOfItsKind'

		if tag == otherTag and tag != ValueTypeTag.named 'oneRepresentation'
			return self.nameIdOf(func, value: value) == self.nameIdOf(func, value: other)
		end 'oneRepresentation'

		let kind = try self.heldRecordKindOf(func, value: value) otherwise return true
		return kind.equals(try self.heldRecordKindOf(func, value: other) otherwise return true)
	end 'valuesMayBeOneRecord'

	// The kind `value`'s record is, as `HeldRecordKinds` names kinds. A name that denotes no record a value can
	// have throws.
	function heldRecordKindOf(func IrFunction, value ValueId) returns ByteArray throws MapError
		if valueTagOf(func, value: value) == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.mangleGenericInstance(self.instanceIdOf(func, value: value))
		end 'anInstance'

		return try self.signatures.heldRecordKindOfDeclaredName(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise throw MapError.keyNotFound)
	end 'heldRecordKindOf'

	// The kinds of record that may lie within `value`'s record, by its type: none within a byte record, any within
	// one of an opaque type. `ProgramSignatures` answers once per type per compile.
	function recordKindsWithinValue(func IrFunction, value ValueId) returns HeldRecordKinds
		let tag = valueTagOf(func, value: value)

		if tagIsByteRecord(tag) 'bytes'
			return self.noRecordKinds
		end 'bytes'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.recordKindsWithinInstanceOf(self.instanceIdOf(func, value: value))
		end 'anInstance'

		if not self.signatures.tagMayNameAggregate(tag) 'anyOtherKind'
			return self.anyRecordKinds
		end 'anyOtherKind'

		return self.recordKindsWithinAggregateNamed(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise return self.anyRecordKinds)
	end 'recordKindsWithinValue'

	function recordKindsWithinInstanceOf(id GenericInstanceId) returns HeldRecordKinds
		if let memoized = try self.recordKindsByInstance.get(id) 'asked'
			return memoized
		end 'asked'

		let within = self.signatures.recordKindsWithinInstance(id)
		self.recordKindsByInstance.upsert(id, value: within)
		return within
	end 'recordKindsWithinInstanceOf'

	function recordKindsWithinAggregateNamed(name ByteArray) returns HeldRecordKinds
		if let memoized = try self.recordKindsByAggregate.get(name) 'asked'
			return memoized
		end 'asked'

		let within = self.signatures.recordKindsWithinAggregate(name)
		self.recordKindsByAggregate.upsert(name, value: within)
		return within
	end 'recordKindsWithinAggregateNamed'

	function nameIdOf(func IrFunction, value ValueId) returns TypeNameId
		return try func.valueNameIds.get(value) otherwise panic("ProvenanceTracer.nameIdOf: v{value} of '{String.from(func.name)}' has no type name — the type columns are minted in lockstep")
	end 'nameIdOf'

	function instanceIdOf(func IrFunction, value ValueId) returns GenericInstanceId
		return self.nameIdOf(func, value: value) as GenericInstanceId
	end 'instanceIdOf'

	function rootValueAt(rank RootRank) returns ValueId
		return try self.rootValues.get(rank) otherwise panic("ProvenanceTracer.rootValueAt: rank {rank} is past the {self.rootValues.count()} roots traced")
	end 'rootValueAt'

	function isImmutableBindingRank(rank RootRank) returns bool
		return rank < self.rootNames.count()
	end 'isImmutableBindingRank'

	function rootNameAt(rank RootRank) returns ByteArray
		return try self.rootNames.get(rank) otherwise panic("ProvenanceTracer.rootNameAt: rank {rank} is past the {self.rootNames.count()} named roots — only an immutable-binding trace names its roots")
	end 'rootNameAt'

	// Every value that may denote a record, a function value (which carries its closure's environment)
	// included. A `named` type may be a boxed union or a ranged scalar, and only the first holds one.
	function typeCarriesProvenance(t MaxonType) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.named 'namedType'
			return self.signatures.typeIsManaged(t, from: self.project.typeNames)
		end 'namedType'

		return tagCarriesProvenance(tag)
	end 'typeCarriesProvenance'

	// A record nothing writes (`ProgramSignatures.recordTypeIsImmutable`).
	function valueIsAnImmutableRecord(func IrFunction, value ValueId) returns bool
		if not tagIsStructRef(valueTagOf(func, value: value)) 'notAStruct'
			return false
		end 'notAStruct'

		return self.signatures.recordTypeIsImmutable(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise return false)
	end 'valueIsAnImmutableRecord'

	function valueTagCarriesProvenance(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tag == ValueTypeTag.named 'namedType'
			let nameId = self.nameIdOf(func, value: value)

			if self.namedTypeHoldsARecord.contains(nameId) 'asked'
				return try self.namedTypeHoldsARecord.get(nameId) otherwise panic("ProvenanceTracer.valueTagCarriesProvenance: name {nameId} left the memo after `contains`")
			end 'asked'

			let holdsARecord = self.typeCarriesProvenance(maxonTypeOfTag(tag, nameId: nameId))
			self.namedTypeHoldsARecord.upsert(nameId, value: holdsARecord)
			return holdsARecord
		end 'namedType'

		return tagCarriesProvenance(tag)
	end 'valueTagCarriesProvenance'
end 'ProvenanceTracer'

// The body a `functionRef` names, once. A compiler-internal address is a container descriptor's release or copy
// routine, which the runtime's own walk calls and no function value reaches (`Parser.emitRuntimeFuncAddr`); any
// other name no function of the module answers to is a body no summary describes.
function noteFunctionRefBody(name ByteArray, byName FuncIndexByName, named BoolArray, into CallLandingBodies)
	if reservedCalleeReasonOf(name) == ReservedCalleeReason.compilerInternalPrefix 'aDescriptorRoutine'
		return
	end 'aDescriptorRoutine'

	let index = try byName.get(name) otherwise 'noBodyOfThisModule'
		into.unresolved = true
		into.unresolvedMayStore = true
		return
	end 'noBodyOfThisModule'

	if not (try named.get(index) otherwise panic("noteFunctionRefBody: function index {index} is past the module's functions")) 'firstMention'
		try named.set(index, value: true) otherwise panic("noteFunctionRefBody: named.set OOB at {index}")
		into.impls.push(index)
	end 'firstMention'
end 'noteFunctionRefBody'

function anyHeldRecordKinds() returns HeldRecordKinds
	var kinds = HeldRecordKinds.create()
	kinds.anything = true
	return kinds
end 'anyHeldRecordKinds'

// The rank no root holds, and the diagnostic no index names.
let NoRootRank = i64.max as RootRank
let NoHygieneDiagnostic = i64.max as ElementIndex

// What E3078 names a value by when no call the author wrote made it.
let NoProducerSubject = "a value"

// E3159's sentence.
function writeThroughImmutableMessage(place String, root String) returns String
	return "cannot write through '{place}', which may be the record of immutable variable '{root}'; use clone()"
end 'writeThroughImmutableMessage'

// The indices of `sites` in token order, and in recorded order among equal tokens.
function moveSitesInTokenOrder(sites MoveSiteArray) returns MoveSiteIndexArray
	var order = MoveSiteIndexArray.create()

	for k in 0 upto sites.count() 'eachSite'
		let token = (try sites.get(k) otherwise panic("moveSitesInTokenOrder: sites.get OOB at {k}")).token
		var at = order.count()

		while at > 0 and (try sites.get(try order.get(at - 1) otherwise panic("moveSitesInTokenOrder: order.get OOB at {at - 1}")) otherwise panic("moveSitesInTokenOrder: a sorted index is past the sites")).token > token 'pastLaterOnes'
			at = at - 1
		end 'pastLaterOnes'

		order.insert(at, value: k)
	end 'eachSite'

	return order
end 'moveSitesInTokenOrder'

// Set rank `rank`'s bit in a dense per-word mask column.
function addRankToWords(words ParamPositionMaskArray, rank RootRank)
	let word = (rank shr RootWordShift) as ElementIndex
	let before = try words.get(word) otherwise panic("addRankToWords: words.get OOB at {word}")
	try words.set(word, value: maskWithParam(before, param: (rank and RootBitIndexMask) as ParamCount)) otherwise panic("addRankToWords: words.set OOB at {word}")
end 'addRankToWords'

// Is the lent binding bound again in `block`, so nothing the flow reaches past that block is the record the send
// lent?
function blockIsReboundIn(rebinding Rebinding, block BlockId) returns bool
	return match rebinding 'rebinding'
		never gives false
		at(bound) gives bound.block == block
	end 'rebinding'
end 'blockIsReboundIn'

// Is `door` on one arm of an `if` and `read` on its other arm (`DeferredProvenance.noteExclusiveArms`)?
function onExclusiveArms(arms TokenSpans, door TokenIndex, read TokenIndex) returns bool
	var k = 0 as ElementIndex

	while k + 1 < arms.starts.count() 'eachIf'
		let thenStart = try arms.starts.get(k) otherwise panic("onExclusiveArms: starts.get OOB at {k}")
		let thenEnd = try arms.ends.get(k) otherwise panic("onExclusiveArms: ends.get OOB at {k}")
		let elseStart = try arms.starts.get(k + 1) otherwise panic("onExclusiveArms: starts.get OOB at {k + 1}")
		let elseEnd = try arms.ends.get(k + 1) otherwise panic("onExclusiveArms: ends.get OOB at {k + 1}")
		let doorInThen = door >= thenStart and door < thenEnd
		let doorInElse = door >= elseStart and door < elseEnd
		let readInThen = read >= thenStart and read < thenEnd
		let readInElse = read >= elseStart and read < elseEnd

		if (doorInThen and readInElse) or (doorInElse and readInThen) 'otherArm'
			return true
		end 'otherArm'

		k = k + 2
	end 'eachIf'

	return false
end 'onExclusiveArms'

// Does a loop bound after `declared` enclose both `door` and `read`, so a later trip reaches the read?
function readOnALaterTrip(loops TokenSpans, declared TokenIndex, door TokenIndex, read TokenIndex) returns bool
	for i in 0 upto loops.starts.count() 'eachLoop'
		let start = try loops.starts.get(i) otherwise panic("readOnALaterTrip: starts.get OOB at {i}")
		let finish = try loops.ends.get(i) otherwise panic("readOnALaterTrip: ends.get OOB at {i}")

		if start > declared and door >= start and door < finish and read >= start and read < finish 'bothInIt'
			return true
		end 'bothInIt'
	end 'eachLoop'

	return false
end 'readOnALaterTrip'

// ⭐ **A BINDING BOUND BEFORE A LOOP AND USED INSIDE IT IS LIVE TO THE LOOP'S END**, since the next trip reads it
// again — the one place source order and run order part. Widened to a fixpoint, so a loop enclosing that loop
// widens it again.
function liveUntilAcrossLoops(declared TokenIndex, lastUse TokenIndex, loops TokenSpans) returns TokenIndex
	var until = lastUse
	var widened = true

	while widened 'untilSettled'
		widened = false

		for i in 0 upto loops.starts.count() 'eachLoop'
			let start = try loops.starts.get(i) otherwise panic("liveUntilAcrossLoops: starts.get OOB at {i}")
			let finish = try loops.ends.get(i) otherwise panic("liveUntilAcrossLoops: ends.get OOB at {i} — the spans are pushed together")

			if start > declared and start <= until and until < finish 'usedInsideALoopItOutlives'
				until = finish
				widened = true
			end 'usedInsideALoopItOutlives'
		end 'eachLoop'
	end 'untilSettled'

	return until
end 'liveUntilAcrossLoops'

// What a door asks of a root besides that it counts there and that its type admits the value (`leastAdmittedRank`):
// nothing, that the slot both were read out of was not replaced in between, or that its record is immutable.
enum RootCondition
	none
	slotNotRewritten
	immutableRecord
end 'RootCondition'

// How far a door's question reaches from a value: to the bindings it may be, or to those it may also lie within.
enum RootReach
	identity
	identityOrInside
end 'RootReach'

// Does a callee of this shape store into argument `receiverIndex`?
function shapeStoresInto(shape RuntimeStoreShape, receiverIndex ParamCount) returns bool
	return match shape 'shape'
		intoAnyOperand gives true
		intoTheReceiver or
			intoTheReceiverPastAnAnchor gives receiverIndex == RuntimeStoreReceiverIndex
		nothing gives false
	end 'shape'
end 'shapeStoresInto'

// Does a callee of this shape store argument `storedIndex` (into a receiver other than it)?
function shapeStoresOperand(shape RuntimeStoreShape, storedIndex ParamCount) returns bool
	return match shape 'shape'
		intoAnyOperand or
			intoTheReceiver gives true
		intoTheReceiverPastAnAnchor gives storedIndex > RuntimeStoreAnchorIndex
		nothing gives false
	end 'shape'
end 'shapeStoresOperand'

// Every tag but `named`, which `ProvenanceTracer.typeCarriesProvenance` asks the declaration about.
function tagCarriesProvenance(tag ValueTypeTag) returns bool
	return tagIsByteRecord(tag) or tagIsStructRef(tag) or tag == ValueTypeTag.genericInstance or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.function
end 'tagCarriesProvenance'

// Can a value of one tag be the very record a value of the other is? Only a record of one representation
// is — an opaque `T` and an existential may stand for any — so an op's result is not its operand merely
// for having one: an indirect call's `String` is not the closure it called through.
function mayBeOneRecord(tag ValueTypeTag, other ValueTypeTag) returns bool
	if tag == other or (tagIsByteRecord(tag) and tagIsByteRecord(other)) 'oneRepresentation'
		return true
	end 'oneRepresentation'

	return tagIsOpaqueRecord(tag) or tagIsOpaqueRecord(other)
end 'mayBeOneRecord'

function tagIsOpaqueRecord(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef
end 'tagIsOpaqueRecord'

union DefiningOp
	notAnOp
	op(index OpIndex)
end 'DefiningOp'

// What an op does with a field slot: reads it, stores into it, or retains a value — which a `let` bound out of a
// rebindable slot is (W41) — or none of these.
union SlotRead
	none
	load(opIndex OpIndex, addr ValueId, offset ByteOffset)
	store(addr ValueId, offset ByteOffset, value ValueId)
	retainOf(operand ValueId)
end 'SlotRead'

// What a block's ops met first, scanning for one read of a slot: that read, a store into the slot, or neither.
enum SlotScan
	reached
	stored
	ranOff
end 'SlotScan'

// Is `op` a load out of a slot or a store into one — the only ops whose `SlotRead` a scan over a body asks about
// beyond its own read? Asked first there, so every other op builds no `SlotRead` box.
function opLoadsOrStoresASlot(op MaxonOp) returns bool
	return match op 'op'
		loadIndirect or
			storeIndirect gives true

		call or
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			stringLiteral or
			tryCall or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic gives false
	end 'op'
end 'opLoadsOrStoresASlot'

function slotReadOfOp(op MaxonOp, opIndex OpIndex) returns SlotRead
	match op 'op'
		loadIndirect(_, addr, offset, _) then return SlotRead.load(opIndex, addr: addr, offset: offset)
		storeIndirect(addr, offset, value, _) then return SlotRead.store(addr, offset: offset, value: value)
		call(_, callee, args, _, _, _, _, _) then return SlotRead.retainOf(try args.get(0) otherwise panic("slotReadOfOp: a retain has no operand")) if ownershipBookkeepingCallee(callee) and args.count() > 0 else SlotRead.none
		literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			stringLiteral or
			tryCall or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic then return SlotRead.none
	end 'op'
end 'slotReadOfOp'

// The co-owns that copy a module-level `let`'s image rather than share it: the buffer record's retain forks off
// `capacity@16`, and the box entries off the allocation header (`Parser.coOwnConcreteRecordForSink`).
function forksImageData(callee ByteArray) returns bool
	return callee.equals(ManagedRetainName) or callee.equals(MmOwnDeepName) or callee.equals(MmOwnName)
end 'forksImageData'

// The `__ManagedList` entries that link a new node into their receiver chain and hand back its handle.
function linksANewNodeCallee(callee ByteArray) returns bool
	return callee.equals(ListAppendName) or callee.equals(ListPrependName) or callee.equals(ListInsertAfterName) or callee.equals(ListInsertBeforeName)
end 'linksANewNodeCallee'

// What the op defining a value does toward the record it was read out of, as an access path sees it: nothing — the
// value is a root — a step into a field of its base, an element of it, or the base's own record handed back.
enum AccessHopKind
	stop
	field
	element
	same
end 'AccessHopKind'

typealias AccessHopKindArray = Array with AccessHopKind

function slotReadIsLoadOp(read SlotRead, opIndex OpIndex) returns bool
	return match read 'read'
		load(loadOp, _, _) gives loadOp == opIndex

		none or
			store or
			retainOf gives false
	end 'read'
end 'slotReadIsLoadOp'

function storeSlotKey(addr ValueId, offset ByteOffset) returns StoreSlotKey
	return ((addr as StoreSlotKey) shl StoreSlotValueShift) or (offset as StoreSlotKey)
end 'storeSlotKey'

function opDefinesAGlobalAddress(op MaxonOp) returns bool
	return match op 'op'
		globalAddr gives true

		call or
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			tryCall or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic gives false
	end 'op'
end 'opDefinesAGlobalAddress'

function valueTagOf(func IrFunction, value ValueId) returns ValueTypeTag
	return try func.valueTags.get(value) otherwise panic("StorageProvenance.valueTagOf: v{value} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
end 'valueTagOf'

function singletonValue(value ValueId) returns ValueIdArray
	var values = ValueIdArray.create()
	values.push(value)
	return values
end 'singletonValue'

function recordAliasEdges(aliased ParamPositionMask, calleeIndex FuncIndex, callerIndex FuncIndex, calleeParam ParamCount, edges CallParamEdges)
	if aliased == NoParamPositions 'noParameterAliased'
		return
	end 'noParameterAliased'

	for p in 0 upto RootBitIndexMask + 1 'eachCallerParam'
		if maskHasParam(aliased, param: p) 'mayBeThisParameter'
			edges.record(calleeIndex, callerIndex: callerIndex, callerParam: p, calleeParam: calleeParam)
		end 'mayBeThisParameter'
	end 'eachCallerParam'
end 'recordAliasEdges'
