	end 'create'

	function tracesFirst(index ElementIndex) returns bool
		view func = self.functionAt(index)
		let filed = func.keepsSoleOwnerMarks()

		if not filed and (self.anyParameterHoldsARecord(func) or self.resultMayHandBackAModuleLetsRecord(func)) 'unfiledYetRecordHolding'
			panic("ProvenanceTracer.tracesFirst: '{String.from(func.name)}' holds a record in a parameter or its result but `Parser.fileDeferredProvenance` filed no sole-owner marks for it — the parser's filing decision must cover every function this pass would trace")
		end 'unfiledYetRecordHolding'

		return filed
	end 'tracesFirst'

	function traceAndWiden(index ElementIndex) returns bool
		view func = self.functionAt(index)
		self.traceParameters(func, index: index)
		self.stageParamEdges(func, index: index)
		return self.widenSummary(index)
	end 'traceAndWiden'

	module function functionAt(index ElementIndex) returns IrFunction
		return try self.module.functions.get(index) otherwise panic("ProvenanceTracer.functionAt: function index {index} is past the module's functions")
	end 'functionAt'

	function callSiteCursor() returns CallSiteCursor
		return self.calls
	end 'callSiteCursor'

	function tracksValue(value ValueId) returns bool
		return self.isTracked(value)
	end 'tracksValue'

	function applyCalleeSummary(func IrFunction, calleeIndex ElementIndex, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, argRanges SourceRangeArray)
		let declaredResult = self.landingKeeps.declaredResult()
		let inElements = self.readOnlyElementParametersOfCall(func, calleeIndex: calleeIndex, args: args)
		self.storeThroughSummary(func, calleeIndex: calleeIndex, args: args, result: result, except: inElements)
		self.bindThroughSummary(calleeIndex, args: args, except: inElements)
		self.keepThroughSummary(func, calleeIndex: calleeIndex, args: args, inElements: inElements)

		if declaredResult != ResultCapability.unqualified 'theBoundaryDeclaresTheResult'
			if self.definesAnAlias(func, value: result) 'aRecordResult'
				self.flowDeclaredResult(result, capability: declaredResult)
			end 'aRecordResult'

			return
		end 'theBoundaryDeclaresTheResult'

		if not self.definesAnAlias(func, value: result) 'returnsNoAlias'
			self.holdArgumentsThroughSummary(result, args: args, calleeIndex: calleeIndex)
			return
		end 'returnsNoAlias'

		self.flowModuleLets(result, calleeIndex: calleeIndex)
		self.seedReadOnlyElementRead(func, result: result, callee: self.functionAt(calleeIndex).name, args: args)

		for (iter, arg) in args.withIterator() 'eachArg'
			let pos = try self.calls.argPositionAt(iter.index() as ParamCount) otherwise continue
			self.flowThroughSummary(func, result: result, arg: arg, calleeIndex: calleeIndex, pos: pos)
		end 'eachArg'
	end 'applyCalleeSummary'

	function storeHandedValue(func IrFunction, receiver ValueId, stored ValueId, sharesItsElements bool, opIdx ElementIndex)
		if self.tracingImmutableBindings and self.isTracked(stored) and not self.elementsAreReadOnlyIn(func, container: receiver) 'aSinkToJudge'
			self.viewSinks.upsert(opIdx, value: stored)
		end 'aSinkToJudge'

		if not self.tracingImmutableBindings and not sharesItsElements and self.isTracked(stored) and self.elementsAreReadOnlyIn(func, container: receiver) 'keptInAReadOnlyElement'
			self.returnedElementKeeps = self.returnedElementKeeps or self.parametersAValueMayBe(func, value: stored)
			return
		end 'keptInAReadOnlyElement'

		if sharesItsElements 'itsElements'
			self.traceSharedElements(func, addr: receiver, source: stored)
			return
		end 'itsElements'

		self.traceWholeStore(func, addr: receiver, value: stored, deep: false, content: KeptContent.ofItsOwnType)
	end 'storeHandedValue'

	function elementsAreReadOnlyIn(func IrFunction, container ValueId) returns bool
		return valueTagOf(func, value: container) == ValueTypeTag.genericInstance and self.signatures.containerElementIsReadOnly(self.instanceIdOf(func, value: container))
	end 'elementsAreReadOnlyIn'

	function seedReadOnlyElementRead(func IrFunction, result ValueId, callee ByteArray, args ValueIdArray)
		if args.isEmpty() or not self.isTracked(result) 'readsNoElement'
			return
		end 'readsNoElement'

		if self.callReadsAReadOnlyInstanceElement(func, callee: callee, receiver: try args.get(0) otherwise panic("ProvenanceTracer.seedReadOnlyElementRead: args.get(0) on a non-empty list")) 'aReadOnlyElement'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.readOnlyElementRank())
			self.moduleLetStorageReached = true
		end 'aReadOnlyElement'
	end 'seedReadOnlyElementRead'

	function readOnlyElementParametersOfCall(func IrFunction, calleeIndex ElementIndex, args ValueIdArray) returns ParamPositionMask
		if self.tracingImmutableBindings 'aBindingsTrace'
			return NoParamPositions
		end 'aBindingsTrace'

		view callee = self.functionAt(calleeIndex).name
		view sig = try self.project.funcSignatures.get(callee) otherwise return NoParamPositions
		return self.elementKeptParameters(func, calleeIndex: calleeIndex, callee: callee, sig: sig, args: args)
	end 'readOnlyElementParametersOfCall'

	function resultFromOperands(func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId)
		if self.landingKeeps.declaredResult() != ResultCapability.unqualified 'theBoundaryDeclaresTheResult'
			self.flowDeclaredResult(result, capability: self.landingKeeps.declaredResult())
			return
		end 'theBoundaryDeclaresTheResult'

		self.flowFromOperands(func, op: op, result: result)
	end 'resultFromOperands'

	function flowDeclaredResult(result ValueId, capability ResultCapability)
		match capability 'capability'
			unqualified then panic("ProvenanceTracer.flowDeclaredResult: an unqualified result declares nothing to honour")
			sole then break
			readonly then self.seedBit(ProvenanceColumn.identity, value: result, rank: self.readOnlyElementRank())
		end 'capability'
	end 'flowDeclaredResult'

	function resultOfRuntimeCall(func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, site ElementIndex)
		view sites = self.calls.resolution.sites

		if sites.isBookkeepingAt(site) 'theOperandsRecordOrACopy'
			self.flowThroughBookkeeping(func, op: op, result: result)
		end 'theOperandsRecordOrACopy' else 'anyRecordItReaches'
			self.flowFromOperands(func, op: op, result: result)
		end 'anyRecordItReaches'

		self.placeWhatTheResultMayBe(func, result: result, args: args, shape: sites.shapeAt(site))

		if self.isTracked(result) and self.opReadsASharedView(op) 'aSharedViewRead'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.sharedViewRank())
			self.moduleLetStorageReached = true
		end 'aSharedViewRead'

		self.seedReadOnlyElementRead(func, result: result, callee: maxonOpCalleeName(op), args: args)

		if maxonOpCalleeName(op).equals(ManagedCursorCreateName) and args.count() > 0 'aCursorHoldsItsBuffer'
			let buffer = try args.get(0) otherwise panic("ProvenanceTracer.resultOfRuntimeCall: a cursor is created over no buffer")
			self.unionShares(result, source: buffer)
			self.holdPartsOf(result, arg: buffer)
		end 'aCursorHoldsItsBuffer'

		// ⭐ **AN INSERTION LINKS A NEW NODE INTO THE RECEIVER CHAIN AND HANDS BACK A HANDLE TO IT** — a
		// node the chain holds, as a reinsertion's is (`runtimeCalleeStoreShape`), and one the handle lies
		// within the chain as (`flowFromOperands`). So a walk of the chain may reach the node a `let`
		// handle names.
		if sites.linksANewNodeAt(site) and args.count() > 0 'theChainHoldsTheNode'
			self.traceWholeStore(func, addr: try args.get(0) otherwise panic("ProvenanceTracer.resultOfRuntimeCall: an insertion has no receiver chain"), value: result, deep: false, content: KeptContent.ofItsOwnType)
		end 'theChainHoldsTheNode'
	end 'resultOfRuntimeCall'

	function widenSummary(index ElementIndex) returns bool
		var row = self.summaryRow
		row.shares = self.returnedShares
		row.identity = self.returnedIdentity
		row.holds = self.returnedHolds
		row.inside = self.returnedInside
		row.holdsWithin = self.returnedHoldsWithin
		row.placedWithin = self.returnedPlacedWithin
		row.escapes = self.returnedEscapes
		row.binds = self.returnedBinds
		row.letKeeps = self.returnedLetKeeps or self.sharedSendParameters(self.functionAt(index))
		row.payloadKeeps = self.returnedPayloadKeeps
		row.elementKeeps = self.returnedElementKeeps
		let sent = self.sharedSendParameters(self.functionAt(index))
		row.keeps = maskWithout(self.returnedKeeps, removed: sent)
		row.otherKeeps = maskWithout(self.returnedOtherKeeps, removed: sent)
		row.recordKeeps = maskWithout(self.returnedRecordKeeps, removed: sent)
		row.moduleLets = self.returnedModuleLets
		row.stores = self.storedRow
		row.deepStores = self.storedDeepRow
		self.keepStoredKeyLikeALetField(self.functionAt(index), row: row)
		return self.summary.widen(index, row: row)
	end 'widenSummary'

	function sharedSendParameters(func IrFunction) returns ParamPositionMask
		var shared = NoParamPositions

		for site in func.provenanceSites(self.noSites).moveSites 'eachSite'
			if site.destinationKind == MoveDestinationKind.sharedSend 'aParameterSentShared'
				shared = maskWithParam(shared, param: paramPositionOfValueId(site.value))
			end 'aParameterSentShared'
		end 'eachSite'

		return shared
	end 'sharedSendParameters'

	function keepStoredKeyLikeALetField(func IrFunction, row TracedSummaryRow)
		let position = try self.storedKeyParameterOf(func) otherwise return
		row.letKeeps = maskWithParam(row.letKeeps, param: position)
		row.keeps = maskWithoutParam(row.keeps, param: position)
		row.escapes = maskWithoutParam(row.escapes, param: position)
		row.binds = maskWithoutParam(row.binds, param: position)

		for target in 0 upto row.stores.count() 'eachStoreTarget'
			try row.stores.set(target, value: maskWithoutParam(try row.stores.get(target) otherwise panic("ProvenanceTracer.keepStoredKeyLikeALetField: stores.get OOB at {target}"), param: position)) otherwise panic("ProvenanceTracer.keepStoredKeyLikeALetField: stores.set OOB at {target}")
		end 'eachStoreTarget'

		for target in 0 upto row.deepStores.count() 'eachDeepStoreTarget'
			try row.deepStores.set(target, value: maskWithoutParam(try row.deepStores.get(target) otherwise panic("ProvenanceTracer.keepStoredKeyLikeALetField: deepStores.get OOB at {target}"), param: position)) otherwise panic("ProvenanceTracer.keepStoredKeyLikeALetField: deepStores.set OOB at {target}")
		end 'eachDeepStoreTarget'
	end 'keepStoredKeyLikeALetField'

	function storedKeyParameterOf(func IrFunction) returns ParamCount throws AbsentError
		let wanted = match storedKeyColumnOwnerOf(func.name) 'owner'
			map gives StoredKeyParameterName
			set gives StoredElementParameterName
			neither throws AbsentError.absent
		end 'owner'

		let sig = try self.project.funcSignatures.get(func.name) otherwise throw AbsentError.absent

		for position in 0 upto sig.paramNames.count() 'eachParameter'
			if (try sig.paramNames.get(position) otherwise panic("ProvenanceTracer.storedKeyParameterOf: paramNames.get OOB at {position}")).equals(wanted) 'theKey'
				return position as ParamCount
			end 'theKey'
		end 'eachParameter'

		throw AbsentError.absent
	end 'storedKeyParameterOf'

	// A function with no parameter that holds a record has nothing of its caller's to hand back or store.
	function anyParameterHoldsARecord(func IrFunction) returns bool
		if func.closureEnvFields.count() > 0 'aLiftedClosure'
			return func.keepsSoleOwnerMarks()
		end 'aLiftedClosure'

		for p in 0 upto func.paramCount 'eachParam'
			if self.valueTagCarriesProvenance(func, value: valueIdAtParamPosition(p)) 'holdsARecord'
				return true
			end 'holdsARecord'
		end 'eachParam'

		return false
	end 'anyParameterHoldsARecord'

	// A result that holds a record may hand back what a module-level `let` holds, whatever the
	// parameters are. A declared type that `resolveTypes` has erased to `integer` holds one only when the body
	// returns a value that does. `Parser.resultMayHoldARecord` answers yes wherever this does: at parse time
	// such a type is still `named`.
	function resultMayHandBackAModuleLetsRecord(func IrFunction) returns bool
		return match func.maxonReturnType 'result'
			void gives false
			value(inner) gives self.typeCarriesProvenance(inner) or (maxonTypeTag(inner) == ValueTypeTag.integer and self.returnsARecordValue(func))
		end 'result'
	end 'resultMayHandBackAModuleLetsRecord'

	// Roots are the parameters that hold a record, ranked by position — the summary's own bit order — and
	// module `var` storage past them: a parameter stored into a `var` of this body has not left it.
	function traceParameters(func IrFunction, index ElementIndex)
		self.bindingsTraceValid = false

		if func.paramCount > RootBitIndexMask + 1 'moreParametersThanAMaskHolds'
			panic("ProvenanceTracer.traceParameters: '{String.from(func.name)}' takes {func.paramCount} parameters, past the {RootBitIndexMask + 1} a `ParamPositionMask` holds — `Parser.requireAbiParamCount` bounds it by `MaxAbiArgs`")
		end 'moreParametersThanAMaskHolds'

		self.begin(func)
		self.rootValues.clear()
		self.rootNames.clear()
		self.rootRecordKinds.clear()
		self.tracingImmutableBindings = false
		self.writableRank = ParameterTraceWritableRank
		self.rankParameters(func)
		self.rankCapturedSlots(func)

		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)

			if self.isTracked(param) 'holdsARecord'
				self.seedParameter(func, param: param, rank: p)
			end 'holdsARecord'
		end 'eachParam'

		ProvenanceTracer.markVarsOwn(func, sites: func.provenanceSites(self.noSites), into: self.isWritableValue)
		self.markImmutableBindingValues(func)
		self.seedModuleLetReads(func)
		self.walk(func, index: index, ir: self.module)
		self.settleKeeps(func)
		self.gatherStores(func)
	end 'traceParameters'

	function markVarsMovedIntoLetSlots(sites ProvenanceSites)
		self.varMovedAt.refill(self.writableRank + 1, value: NeverMovedToken)
		self.varDeadFrom.refill(self.writableRank + 1, value: NeverMovedToken)

		for site in sites.moveSites 'eachSite'
			if not site.sourceIsMutable or site.readAfter or site.readInALaterIteration or not moveKindHandsTheVarOver(site.destinationKind) 'notAMove'
				continue
			end 'notAMove'

			let rank = try self.writableRankOf(site.sourceValue) otherwise continue

			if site.token < (try self.varMovedAt.get(rank) otherwise panic("ProvenanceTracer.markVarsMovedIntoLetSlots: varMovedAt.get OOB at {rank}")) 'earlier'
				try self.varMovedAt.set(rank, value: site.token) otherwise panic("ProvenanceTracer.markVarsMovedIntoLetSlots: varMovedAt.set OOB at {rank}")
			end 'earlier'
		end 'eachSite'

		for (iter, value) in sites.writableValues.withIterator() 'eachVar'
			let rank = try self.writableRankOf(value) otherwise continue
			view info = try sites.writableInfos.get(iter.index()) otherwise panic("ProvenanceTracer.markVarsMovedIntoLetSlots: writableInfos.get OOB at {iter.index()}")
			let lastUse = info.lastReadToken if info.lastReadToken > info.declaredToken else info.declaredToken
			let deadFrom = liveUntilAcrossLoops(info.declaredToken, lastUse: lastUse, loops: sites.loops)

			if deadFrom < (try self.varDeadFrom.get(rank) otherwise panic("ProvenanceTracer.markVarsMovedIntoLetSlots: varDeadFrom.get OOB at {rank}")) 'diesEarlier'
				try self.varDeadFrom.set(rank, value: deadFrom) otherwise panic("ProvenanceTracer.markVarsMovedIntoLetSlots: varDeadFrom.set OOB at {rank}")
			end 'diesEarlier'
		end 'eachVar'

		for refused in self.keptRefusedValues 'eachRefusedStore'
			let rank = try self.writableRankOf(refused) otherwise continue
			try self.varMovedAt.set(rank, value: FirstToken) otherwise panic("ProvenanceTracer.markVarsMovedIntoLetSlots: varMovedAt.set OOB at {rank}")
		end 'eachRefusedStore'
	end 'markVarsMovedIntoLetSlots'

	function settleVarLiveness()
		if self.writableRank <= self.firstWritableValueRank 'noVars'
			return
		end 'noVars'

		var order = VarDeathArray.create()

		for rank in self.firstWritableValueRank upto self.writableRank 'eachVar'
			order.push(VarDeath.create(rank, until: try self.varDeadFrom.get(rank) otherwise panic("ProvenanceTracer.settleVarLiveness: varDeadFrom.get OOB at {rank}")))
		end 'eachVar'

		order.sort(function(left VarDeath, right VarDeath) gives right.until.compare(left.until))

		var settled = BoolArray.create()
		settled.refill(self.writableRank, value: false)
		var frontier = EntryIndexArray.create()

		for death in order 'eachVarLatestDyingFirst'
			let source = death.rank

			if (try settled.get(source) otherwise panic("ProvenanceTracer.settleVarLiveness: settled.get OOB at {source}")) 'reachedFromALaterOne'
				continue
			end 'reachedFromALaterOne'

			try settled.set(source, value: true) otherwise panic("ProvenanceTracer.settleVarLiveness: settled.set OOB at {source}")
			let until = death.until
			frontier.push(source)

			while frontier.count() > 0 'eachReached'
				let derived = try frontier.pop() otherwise panic("ProvenanceTracer.settleVarLiveness: frontier.pop on a non-empty frontier")
				self.extendLivenessOfTheVarsItLiesWithin(derived, until: until, settled: settled, frontier: frontier)
			end 'eachReached'
		end 'eachVarLatestDyingFirst'
	end 'settleVarLiveness'

	function extendLivenessOfTheVarsItLiesWithin(derived ElementIndex, until ElementIndex, settled BoolArray, frontier EntryIndexArray)
		for column in AliasLivenessColumns 'eachColumn'
			if var chunk = try self.sets.first(self.setOf(column, value: self.rootValueAt(derived))) 'hasWords'
				while true 'eachWord'
					let firstRank = (self.sets.indexOf(chunk)) shl RootWordShift
					let bits = self.sets.wordOf(chunk)

					for bit in 0 upto RootBitIndexMask + 1 'eachBit'
						let container = firstRank + bit

						if not maskHasParam(bits, param: bit as ParamCount) or container == derived or container < self.firstWritableValueRank or container >= self.writableRank 'notAnotherVar'
							continue
						end 'notAnotherVar'

						if (try settled.get(container) otherwise panic("ProvenanceTracer.extendLivenessOfTheVarsItLiesWithin: settled.get OOB at {container}")) 'alreadySettled'
							continue
						end 'alreadySettled'

						try settled.set(container, value: true) otherwise panic("ProvenanceTracer.extendLivenessOfTheVarsItLiesWithin: settled.set OOB at {container}")
						frontier.push(container)

						if (try self.varDeadFrom.get(container) otherwise panic("ProvenanceTracer.extendLivenessOfTheVarsItLiesWithin: varDeadFrom.get OOB at {container}")) < until 'diesBeforeItsAlias'
							try self.varDeadFrom.set(container, value: until) otherwise panic("ProvenanceTracer.extendLivenessOfTheVarsItLiesWithin: varDeadFrom.set OOB at {container}")
						end 'diesBeforeItsAlias'
					end 'eachBit'

					chunk = try self.sets.next(chunk) otherwise break
				end 'eachWord'
			end 'hasWords'
		end 'eachColumn'
	end 'extendLivenessOfTheVarsItLiesWithin'

	function varMovedBeforeDoor(rank ElementIndex) returns bool
		if rank < self.firstWritableValueRank or rank >= self.varMovedAt.count() 'notAVarsRecord'
			return false
		end 'notAVarsRecord'

		return (try self.varMovedAt.get(rank) otherwise panic("ProvenanceTracer.varMovedBeforeDoor: varMovedAt.get OOB at {rank}")) <= self.doorToken
	end 'varMovedBeforeDoor'

	function varGoneBeforeDoor(rank ElementIndex) returns bool
		if self.varMovedBeforeDoor(rank) 'moved'
			return true
		end 'moved'

		if rank < self.firstWritableValueRank or rank >= self.varDeadFrom.count() 'notAVarsRecord'
			return false
		end 'notAVarsRecord'

		return (try self.varDeadFrom.get(rank) otherwise panic("ProvenanceTracer.varGoneBeforeDoor: varDeadFrom.get OOB at {rank}")) <= self.doorToken
	end 'varGoneBeforeDoor'

	function markImmutableBindingValues(func IrFunction)
		view bindings = func.provenanceSites(self.noSites).immutableBindings

		for i in 0 upto bindings.values.count() 'eachName'
			if not (try bindings.moduleLets.get(i) otherwise panic("ProvenanceTracer.markImmutableBindingValues: moduleLets.get OOB at {i}")) 'aLocalName'
				try self.isImmutableBindingValue.set(try bindings.values.get(i) otherwise panic("ProvenanceTracer.markImmutableBindingValues: values.get OOB at {i}"), value: true) otherwise panic("ProvenanceTracer.markImmutableBindingValues: isImmutableBindingValue.set OOB at {i}")
			end 'aLocalName'
		end 'eachName'
	end 'markImmutableBindingValues'

	// An imaged `let` has no slot, so its read carries no label for `immutableGlobalLabels` to match:
	// its module-let identity is seeded from the immutable binding it was read through.
	function seedModuleLetReads(func IrFunction)
		view bindings = func.provenanceSites(self.noSites).immutableBindings

		for i in 0 upto bindings.values.count() 'eachName'
			let value = try bindings.values.get(i) otherwise panic("ProvenanceTracer.seedModuleLetReads: values.get OOB at {i}")

			if not (try bindings.moduleLets.get(i) otherwise panic("ProvenanceTracer.seedModuleLetReads: moduleLets.get OOB at {i}")) or not self.isTracked(value) or not self.signatures.nameIsAnImagedRecordLet(try bindings.names.get(i) otherwise panic("ProvenanceTracer.seedModuleLetReads: names.get OOB at {i}"), readerFilePath: func.sourceFilePath) 'notAModuleLetsRecord'
				continue
			end 'notAModuleLetsRecord'

			self.seedBit(ProvenanceColumn.identity, value: value, rank: self.moduleLetRank())
		end 'eachName'
	end 'seedModuleLetReads'

	// The parameters as the next ranks, each with the kinds of record that may lie within it (`typeAdmits`).
	function rankParameters(func IrFunction)
		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)
			self.rootValues.push(param)
			self.rootRecordKinds.push(self.recordKindsWithinValue(func, value: param))
		end 'eachParam'
	end 'rankParameters'

	function rankCapturedSlots(func IrFunction)
		self.rankCount = func.paramCount
		self.capturedPositions = CapturedLoadMap.create()

		if func.closureEnvFields.count() == 0 'notALiftedClosure'
			return
		end 'notALiftedClosure'

		self.capturedPositions = collectedCapturedLoadsOf(self.module, func: func)
		let env = valueIdAtParamPosition((func.paramCount - 1) as ParamCount)

		for (_, position) in self.capturedPositions 'eachCapture'
			while self.rankCount <= position 'eachRankUpToIt'
				self.rootValues.push(env)
				self.rootRecordKinds.push(self.noRecordKinds)
				self.rankCount = self.rankCount + 1
			end 'eachRankUpToIt'
		end 'eachCapture'

		for (value, position) in self.capturedPositions 'eachCapturedValue'
			if position < func.paramCount or not self.isTracked(value) 'notACapturedRecord'
				continue
			end 'notACapturedRecord'

			try self.rootValues.set(position, value: value) otherwise panic("ProvenanceTracer.rankCapturedSlots: rootValues.set OOB at {position}")
			try self.rootRecordKinds.set(position, value: self.recordKindsWithinValue(func, value: value)) otherwise panic("ProvenanceTracer.rankCapturedSlots: rootRecordKinds.set OOB at {position}")
			self.setBit(ProvenanceColumn.identity, value: value, rank: position)
			self.setBit(ProvenanceColumn.shares, value: value, rank: position)
		end 'eachCapturedValue'
	end 'rankCapturedSlots'

	// What the body stored into each parameter's record — into a field of it, or deeper — into module storage,
	// and bound to a mutable name that outlives the call, in the summary's bit order. A parameter's own bit is
	// not its store: a by-reference parameter's cell holds its own record from the start. A part of one stored
	// is read as the whole of it.
	function gatherStores(func IrFunction)
		self.storedRow.refill(func.paramCount, value: NoParamPositions)
		self.storedDeepRow.refill(func.paramCount, value: NoParamPositions)

		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)
			let direct = self.wordAt(ProvenanceColumn.holds, value: param, word: 0) or self.wordAt(ProvenanceColumn.storedHolds, value: param, word: 0)
			let deep = self.wordAt(ProvenanceColumn.deepHolds, value: param, word: 0) or self.wordAt(ProvenanceColumn.storedDeep, value: param, word: 0) or self.wordAt(ProvenanceColumn.holdsWithin, value: param, word: 0)
			try self.storedRow.set(p, value: maskWithoutParam(direct, param: p)) otherwise panic("ProvenanceTracer.gatherStores: storedRow.set OOB at {p}")
			try self.storedDeepRow.set(p, value: maskWithoutParam(deep, param: p)) otherwise panic("ProvenanceTracer.gatherStores: storedDeepRow.set OOB at {p}")
		end 'eachParam'

		self.returnedEscapes = self.sets.wordAt(self.escapedSet, word: 0)

		for site in func.provenanceSites(self.noSites).nameBindSites 'eachNameBind'
			let bound = self.wordAt(ProvenanceColumn.identity, value: site.value, word: 0)
			self.returnedBinds = self.returnedBinds or bound

			if not self.valueIsBuiltOnATypeParameter(func, value: site.value) 'aRecordOfItsOwn'
				self.returnedRecordKeeps = self.returnedRecordKeeps or bound
			end 'aRecordOfItsOwn'
		end 'eachNameBind'
	end 'gatherStores'

	// Roots are the immutable names of the body — the `let` bindings the author wrote and the module-level `let`s
	// it read, ranked in declaration order — then the parameters, then each `var`'s own record, then module `var`
	// storage. A value a `var` holds (`let u = t`, which moves `t`) is a binding made FROM that `var`, and a
	// function value names no storage a write could reach, so neither is a root. Answers how many binding roots
	// there are.
	function traceImmutableBindings(func IrFunction, index ElementIndex) returns ElementIndex
		self.bindingsTraceValid = false
		self.handedOutComputed = false
		var sites = func.provenanceSites(self.noSites)
		var bindings = sites.immutableBindings
		self.rootValues.clear()
		self.rootNames.clear()
		self.rootRecordKinds.clear()
		self.rootIsModuleLet.clear()
		self.rootAliasLastUse.clear()
		self.rootAliased.clear()
		self.rootInfos.clear()
		self.rootDeclTokens.clear()

		self.rootRankOfValue.makeAbsent(func.valueTags.count())
		self.writableRankOfValue.makeAbsent(func.valueTags.count())
		self.viewSinks = ViewSinkMap.create()

		for i in 0 upto bindings.values.count() 'eachBinding'
			let value = try bindings.values.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: values.get OOB at {i}")

			if valueTagOf(func, value: value) == ValueTypeTag.function or not self.valueTagCarriesProvenance(func, value: value) 'noRecord'
				continue
			end 'noRecord'

			if let first = try self.bindingRankOf(value) 'aSecondName'
				try self.rootAliased.set(first, value: true) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootAliased.set OOB at {first}")
				view alias = try bindings.infos.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: infos.get OOB at {i}")
				let before = try self.rootAliasLastUse.get(first) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootAliasLastUse.get OOB at {first}")

				if alias.lastReadToken > before 'readLater'
					try self.rootAliasLastUse.set(first, value: alias.lastReadToken) otherwise panic("ProvenanceTracer.traceImmutableBindings: rootAliasLastUse.set OOB at {first}")
				end 'readLater'

				continue
			end 'aSecondName'

			self.rootRankOfValue.set(value, value: self.rootValues.count())
			self.rootValues.push(value)
			self.rootNames.push(try bindings.names.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: names.get OOB at {i} — the columns are pushed together"))
			self.rootRecordKinds.push(self.recordKindsWithinValue(func, value: value))
			self.rootIsModuleLet.push(try bindings.moduleLets.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: moduleLets.get OOB at {i}"))
			self.rootAliasLastUse.push(0)
			self.rootAliased.push(false)
			self.rootInfos.push(try bindings.infos.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: infos.get OOB at {i}"))
			self.rootDeclTokens.push(try bindings.declTokens.get(i) otherwise panic("ProvenanceTracer.traceImmutableBindings: declTokens.get OOB at {i}"))
		end 'eachBinding'

		let bindingCount = self.rootValues.count()
		self.rankParameters(func)
		self.firstWritableValueRank = self.rootValues.count()

		for value in sites.writableValues 'eachWritable'
			if self.hasWritableRank(value) or not self.valueTagCarriesProvenance(func, value: value) 'rankedOrNoRecord'
				continue
			end 'rankedOrNoRecord'

			self.writableRankOfValue.set(value, value: self.rootValues.count())
			self.rootValues.push(value)
			self.rootRecordKinds.push(self.recordKindsWithinValue(func, value: value))
		end 'eachWritable'

		self.begin(func)
		self.tracingImmutableBindings = true
		self.writableRank = self.rootValues.count()
		let wordCount = (self.writableRank + RootBitIndexMask + 1) shr RootWordShift
		self.mutablePlaceWords.refill(wordCount, value: NoParamPositions)
		self.callWrittenPlaceWords.refill(wordCount, value: NoParamPositions)
		self.parameterRankWords.refill(wordCount, value: NoParamPositions)
		let writtenParams = func.writtenParamMask or func.writesThroughParamMask
		let calledToWrite = self.parametersWrittenByCalls(index)

		for rank in bindingCount upto self.writableRank + 1 'eachWritableRank'
			if rank < self.firstWritableValueRank 'aParameter'
				addRankToWords(self.parameterRankWords, rank: rank)
			end 'aParameter'

			if (rank >= self.firstWritableValueRank and not self.varHoldsAViewOfItsSource(func, rank: rank)) or (rank < self.firstWritableValueRank and maskHasParam(writtenParams, param: (rank - bindingCount) as ParamCount)) 'aMutablePlace'
				addRankToWords(self.mutablePlaceWords, rank: rank)
				addRankToWords(self.callWrittenPlaceWords, rank: rank)
			end 'aMutablePlace' else if rank < self.firstWritableValueRank and maskHasParam(calledToWrite, param: (rank - bindingCount) as ParamCount) 'aParameterACallWrites'
				addRankToWords(self.callWrittenPlaceWords, rank: rank)
			end 'aParameterACallWrites'
		end 'eachWritableRank'

		for rank in 0 upto bindingCount 'eachBinding'
			let value = self.rootValueAt(rank)
			self.setBit(ProvenanceColumn.identity, value: value, rank: rank)
			self.setBit(ProvenanceColumn.shares, value: value, rank: rank)
		end 'eachBinding'

		for p in 0 upto func.paramCount 'eachParam'
			let param = valueIdAtParamPosition(p)

			if self.isTracked(param) 'holdsARecord'
				self.seedParameter(func, param: param, rank: bindingCount + p)
			end 'holdsARecord'
		end 'eachParam'

		for rank in self.firstWritableValueRank upto self.writableRank 'eachVarsOwn'
			let value = self.rootValueAt(rank)
			self.setBit(ProvenanceColumn.identity, value: value, rank: rank)
			self.setBit(ProvenanceColumn.shares, value: value, rank: rank)
		end 'eachVarsOwn'

		ProvenanceTracer.markVarsOwn(func, sites: sites, into: self.isWritableValue)
		self.markImmutableBindingValues(func)
		self.markVarsMovedIntoLetSlots(sites)
		self.walk(func, index: index, ir: self.module)
		self.settleVarLiveness()
		self.settleBindingRoots(func, bindingCount: bindingCount)
		return bindingCount
	end 'traceImmutableBindings'

	// ⭐ **A `let` OWNS ITS RECORD WHEN NOTHING ELSE MAY BE IT: no second name, no provenance but its own** — it was
	// bound to a fresh record, not to a borrow, an element, a field, a parameter or a call result that hands one
	// back. Such a `let` is its record's sole reference, which is what a mutable door may take by move. Asked
	// after the walk, when the sets are settled; which other `let`s are live at a door is the door's to ask
	// (`rootIsSoleAt`). And how long each binding stays live: to its last use, and to the end of every loop it
	// was bound before and used inside, since the next trip reads it again.
	function settleBindingRoots(func IrFunction, bindingCount ElementIndex)
		self.rootSoleBase.refill(bindingCount, value: false)
		self.rootLiveUntil.refill(bindingCount, value: 0)
		self.rootMovedAt.refill(bindingCount, value: NeverMovedToken)
		self.rootCaptured.refill(bindingCount, value: false)
		view loops = func.provenanceSites(self.noSites).loops

		for captured in func.provenanceSites(self.noSites).letCaptures.values 'eachCapture'
			let rank = try self.bindingRankOf(captured) otherwise continue

			if rank < bindingCount 'aRootCaptured'
				try self.rootCaptured.set(rank, value: true) otherwise panic("ProvenanceTracer.settleBindingRoots: rootCaptured.set OOB at {rank}")
			end 'aRootCaptured'
		end 'eachCapture'

		for rank in 0 upto bindingCount 'eachBinding'
			let value = self.rootValueAt(rank)
			let aliased = try self.rootAliased.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootAliased.get OOB at {rank}")
			let moduleLet = try self.rootIsModuleLet.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootIsModuleLet.get OOB at {rank}")
			let ownsItsRecord = not aliased and not moduleLet and self.setIsOnlyRankOrItsMovedVar(self.setOf(ProvenanceColumn.identity, value: value), rank: rank, value: value) and not self.sets.hasWords(self.setOf(ProvenanceColumn.inside, value: value))
			try self.rootSoleBase.set(rank, value: ownsItsRecord) otherwise panic("ProvenanceTracer.settleBindingRoots: rootSoleBase.set OOB at {rank}")

			if moduleLet or self.rootIsCaptured(rank) or self.rootIsViewAt(rank) 'liveEverywhere'
				try self.rootLiveUntil.set(rank, value: NeverMovedToken) otherwise panic("ProvenanceTracer.settleBindingRoots: rootLiveUntil.set OOB at {rank}")
				continue
			end 'liveEverywhere'

			let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootDeclTokens.get OOB at {rank}")
			view info = try self.rootInfos.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootInfos.get OOB at {rank}")
			let aliasLastUse = try self.rootAliasLastUse.get(rank) otherwise panic("ProvenanceTracer.settleBindingRoots: rootAliasLastUse.get OOB at {rank}")
			let named = info.lastReadToken if info.lastReadToken > aliasLastUse else aliasLastUse
			let lastUse = named if named > declared else declared
			try self.rootLiveUntil.set(rank, value: liveUntilAcrossLoops(declared, lastUse: lastUse, loops: loops)) otherwise panic("ProvenanceTracer.settleBindingRoots: rootLiveUntil.set OOB at {rank}")
		end 'eachBinding'

		self.tracedSites = func.provenanceSites(self.noSites)
		self.gatherRootReads(func, bindingCount: bindingCount)
	end 'settleBindingRoots'

	// Each root's reads out of the body's `LetReads`, grouped by rank.
	function gatherRootReads(func IrFunction, bindingCount ElementIndex)
		view reads = func.provenanceSites(self.noSites).letReads
		self.rootReadStarts.refill(bindingCount + 1, value: 0)
		self.rootReads.refill(reads.values.count(), value: 0)

		for value in reads.values 'countEach'
			let rank = try self.bindingRankOf(value) otherwise continue

			if rank < bindingCount 'aRootsRead'
				let next = rank + 1
				try self.rootReadStarts.set(next, value: (try self.rootReadStarts.get(next) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB")) + 1) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.set OOB")
			end 'aRootsRead'
		end 'countEach'

		for i in 1 upto bindingCount + 1 'prefixSum'
			try self.rootReadStarts.set(i, value: (try self.rootReadStarts.get(i) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB")) + (try self.rootReadStarts.get(i - 1) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB"))) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.set OOB")
		end 'prefixSum'

		self.rootReadFill.refill(bindingCount, value: 0)

		for k in 0 upto reads.values.count() 'placeEach'
			let rank = try self.bindingRankOf(try reads.values.get(k) otherwise panic("ProvenanceTracer.gatherRootReads: values.get OOB at {k}")) otherwise continue

			if rank < bindingCount 'aRootsRead'
				let at = (try self.rootReadStarts.get(rank) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadStarts.get OOB")) + (try self.rootReadFill.get(rank) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadFill.get OOB"))
				try self.rootReads.set(at, value: try reads.tokens.get(k) otherwise panic("ProvenanceTracer.gatherRootReads: tokens.get OOB at {k}")) otherwise panic("ProvenanceTracer.gatherRootReads: rootReads.set OOB at {at}")
				try self.rootReadFill.set(rank, value: (try self.rootReadFill.get(rank) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadFill.get OOB")) + 1) otherwise panic("ProvenanceTracer.gatherRootReads: rootReadFill.set OOB")
			end 'aRootsRead'
		end 'placeEach'
	end 'gatherRootReads'

	// ⭐ **IS BINDING ROOT `rank` READ ON SOME PATH FROM `token`?** Its last read in the text — stretched to the end of
	// a loop it was bound before and read in — bounds the answer. Within that bound a read counts only where some path
	// reaches it: a later read on the other arm of an `if` the door is on one arm of does not, unless a loop the
	// root was bound before encloses both, whose next trip may take the other arm. A root the body filed no read of
	// is answered by the bound alone. A module-level `let`, and a `let` a closure captured — whose reads are wherever
	// the closure is called — are read everywhere.
	function rootReadAfter(rank ElementIndex, token ElementIndex) returns bool
		if (try self.rootLiveUntil.get(rank) otherwise panic("ProvenanceTracer.rootReadAfter: rootLiveUntil.get OOB at {rank}")) <= token 'readForTheLastTimeBefore'
			return false
		end 'readForTheLastTimeBefore'

		if self.rootIsLiveEverywhere(rank) 'liveEverywhere'
			return true
		end 'liveEverywhere'

		let first = try self.rootReadStarts.get(rank) otherwise panic("ProvenanceTracer.rootReadAfter: rootReadStarts.get OOB at {rank}")
		let bound = try self.rootReadStarts.get(rank + 1) otherwise panic("ProvenanceTracer.rootReadAfter: rootReadStarts.get OOB at {rank}")

		if first == bound 'noReadFiled'
			return true
		end 'noReadFiled'

		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootReadAfter: rootDeclTokens.get OOB at {rank}")
		let sites = self.tracedSites

		for k in first upto bound 'eachRead'
			let read = try self.rootReads.get(k) otherwise panic("ProvenanceTracer.rootReadAfter: rootReads.get OOB at {k}")

			if (read > token and not onExclusiveArms(sites.exclusiveArms, door: token, read: read)) or readOnALaterTrip(sites.loops, declared: declared, door: token, read: read) 'reachable'
				return true
			end 'reachable'
		end 'eachRead'

		return false
	end 'rootReadAfter'

	function setIsOnlyRankOrItsMovedVar(set ElementIndex, rank ElementIndex, value ValueId) returns bool
		if self.setIsExactlyRank(set, rank: rank) 'exactlyIt'
			return true
		end 'exactlyIt'

		let moved = try self.writableRankOf(value) otherwise return false
		var found = false

		if var chunk = try self.sets.first(set) 'hasWords'
			while true 'eachWord'
				var expected = NoParamPositions
				let word = self.sets.indexOf(chunk)

				if word == (rank shr RootWordShift) as MaskWordCount 'itsWord'
					expected = maskWithParam(expected, param: (rank and RootBitIndexMask) as ParamCount)
					found = true
				end 'itsWord'

				if word == (moved shr RootWordShift) as MaskWordCount 'theVarsWord'
					expected = maskWithParam(expected, param: (moved and RootBitIndexMask) as ParamCount)
				end 'theVarsWord'

				if self.sets.wordOf(chunk) != expected 'anotherRoot'
					return false
				end 'anotherRoot'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return found
	end 'setIsOnlyRankOrItsMovedVar'

	// Is `set` exactly the one rank `rank`?
	function setIsExactlyRank(set ElementIndex, rank ElementIndex) returns bool
		let chunk = try self.sets.first(set) otherwise return false

		if self.sets.hasNext(chunk) 'notOneWord'
			return false
		end 'notOneWord'

		return self.sets.indexOf(chunk) == (rank shr RootWordShift) as MaskWordCount and self.sets.wordOf(chunk) == maskWithParam(NoParamPositions, param: (rank and RootBitIndexMask) as ParamCount)
	end 'setIsExactlyRank'

	// Every value a `var` binding holds, and every value a mutable-binding site bound.
	static function markVarsOwn(func IrFunction, sites ProvenanceSites, into BoolArray)
		for value in sites.writableValues 'eachWritable'
			try into.set(value, value: true) otherwise panic("ProvenanceTracer.markVarsOwn: writable value v{value} of '{String.from(func.name)}' is past its value columns")
		end 'eachWritable'

		for site in sites.mutableBindingSites 'eachSite'
			try into.set(site.value, value: true) otherwise panic("ProvenanceTracer.markVarsOwn: site value v{site.value} of '{String.from(func.name)}' is past its value columns")
		end 'eachSite'
	end 'markVarsOwn'

	function immutableBindingsAreTraced(func IrFunction) returns bool
		return func.filesImmutableBindings() and self.bindingsTraceOf(func, index: self.enteredIndex) != 0
	end 'immutableBindingsAreTraced'

	// The immutable-binding trace of `func` at `index`, once however many questions ask it. Answers how many
	// roots it has.
	function bindingsTraceOf(func IrFunction, index ElementIndex) returns ElementIndex
		if not self.bindingsTraceValid or self.bindingsTraceIndex != index 'traceThisFunction'
			self.bindingsRootCount = self.traceImmutableBindings(func, index: index)
			self.bindingsTraceValid = true
			self.bindingsTraceIndex = index
			self.checkLetBindings(func, bindingCount: self.bindingsRootCount, index: index)
		end 'traceThisFunction'

		return self.bindingsRootCount
	end 'bindingsTraceOf'

	module function keptParameters(calleeIndex ElementIndex, paramCount ParamCount) returns ParamPositionMask
		var kept = self.summary.escapesAt(calleeIndex) or self.summary.bindsAt(calleeIndex) or self.summary.keepsAt(calleeIndex)

		for into in 0 upto paramCount 'eachReceivingParameter'
			kept = kept or self.summary.storesAt(calleeIndex, into: into) or self.summary.storesDeepAt(calleeIndex, into: into)
		end 'eachReceivingParameter'

		return kept
	end 'keptParameters'

	function elementKeptParameters(func IrFunction, calleeIndex ElementIndex, callee ByteArray, sig FuncSignature, args ValueIdArray) returns ParamPositionMask
		let kept = self.keptParameters(calleeIndex, paramCount: sig.paramCount())

		if kept == NoParamPositions 'keepsNothingWhereItIsWritten'
			return NoParamPositions
		end 'keepsNothingWhereItIsWritten'

		return kept and self.readOnlyElementParameters(func, callee: callee, sig: sig, args: args)
	end 'elementKeptParameters'

	module function keepsAt(func IrFunction, calleeIndex ElementIndex, callee ByteArray, sig FuncSignature, args ValueIdArray, argLabels NameRoster, result ValueId) returns (ParamPositionMask, ParamPositionMask, ParamPositionMask, ParamPositionMask)
		let inElements = self.elementKeptParameters(func, calleeIndex: calleeIndex, callee: callee, sig: sig, args: args)
		var mutablyKept = self.keptParameters(calleeIndex, paramCount: sig.paramCount()) xor inElements
		mutablyKept = maskWithout(mutablyKept, removed: self.valueTypedContentParameters(func, calleeIndex: calleeIndex, sig: sig, args: args, argLabels: argLabels))
		let heldByTheResult = self.summary.keepsAt(calleeIndex) and mutablyKept and not self.summary.otherKeepsAt(calleeIndex)

		// A closure in a read-only holder still writes what it captures when called.
		if heldByTheResult != NoParamPositions and self.resultIsBoundByALet(func, result: result) and not self.functionHoldings.mayHoldAFunction(valueTagOf(func, value: result), nameId: self.nameIdOf(func, value: result), signatures: self.signatures, from: self.project.typeNames) 'theResultIsReadOnly'
			mutablyKept = mutablyKept xor heldByTheResult
		end 'theResultIsReadOnly'

		return (self.summary.letKeepsAt(calleeIndex), self.summary.payloadKeepsAt(calleeIndex), self.summary.elementKeepsAt(calleeIndex) or inElements, mutablyKept)
	end 'keepsAt'

	function valueTypedContentParameters(func IrFunction, calleeIndex ElementIndex, sig FuncSignature, args ValueIdArray, argLabels NameRoster) returns ParamPositionMask
		let typeParameterOnly = maskWithout(self.summary.keepsAt(calleeIndex) or self.summary.bindsAt(calleeIndex), removed: self.summary.recordKeepsAt(calleeIndex))
		var valueTyped = NoParamPositions

		if typeParameterOnly == NoParamPositions 'nothingKeptAsTypeParameterContent'
			return valueTyped
		end 'nothingKeptAsTypeParameterContent'

		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("ProvenanceTracer.valueTypedContentParameters: argLabels.get OOB at {i}")
			let pos = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

			if maskHasParam(typeParameterOnly, param: pos) and self.contentIsAValueType(func, value: try args.get(i) otherwise panic("ProvenanceTracer.valueTypedContentParameters: args.get OOB at {i}"), declared: try sig.paramTypes.get(pos) otherwise panic("ProvenanceTracer.valueTypedContentParameters: paramTypes.get OOB at {pos}")) 'noRecordInTheContent'
				valueTyped = maskWithParam(valueTyped, param: pos)
			end 'noRecordInTheContent'
		end 'eachArg'

		return valueTyped
	end 'valueTypedContentParameters'

	function contentIsAValueType(func IrFunction, value ValueId, declared MaxonType) returns bool
		if maxonTypeTag(declared) == ValueTypeTag.typeParameter 'theValueItself'
			return self.valueGivesAStoreNoWriter(func, value: value)
		end 'theValueItself'

		return not self.valueMayHoldACapabilityRecord(func, value: value)
	end 'contentIsAValueType'

	function valueMayHoldACapabilityRecord(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tagIsOpaqueRecord(tag) 'mayBeAContainer'
			return true
		end 'mayBeAContainer'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.instanceArgsMayHoldARecord(self.instanceIdOf(func, value: value), textIsARecord: false)
		end 'anInstance'

		return (tag == ValueTypeTag.named or tagNamesADeclaredType(tag)) and self.valueTagCarriesProvenance(func, value: value)
	end 'valueMayHoldACapabilityRecord'

	function readOnlyElementParameters(func IrFunction, callee ByteArray, sig FuncSignature, args ValueIdArray) returns ParamPositionMask
		if args.isEmpty() 'noReceiver'
			return NoParamPositions
		end 'noReceiver'

		let receiver = try args.get(0) otherwise panic("ProvenanceTracer.readOnlyElementParameters: args.get(0) on a non-empty list")

		if valueTagOf(func, value: receiver) != ValueTypeTag.genericInstance 'notAContainerInstance'
			return NoParamPositions
		end 'notAContainerInstance'

		let instance = self.instanceIdOf(func, value: receiver)

		if not self.signatures.genericInstanceSpellsReadOnly(instance) or not self.signatures.declaresCallee(callee) or not self.signatures.declaredMethodTakesReceiver(callee) 'storesNothingReadOnly'
			return NoParamPositions
		end 'storesNothingReadOnly'

		var stored = NoParamPositions

		for position in 0 upto sig.paramCount() 'eachParameter'
			let declared = try sig.paramTypes.get(position) otherwise panic("ProvenanceTracer.readOnlyElementParameters: paramTypes.get OOB at {position} below paramCount")

			if self.signatures.typeParameterIsReadOnlyIn(instance, declared: declared) 'storedReadOnly'
				stored = maskWithParam(stored, param: position)
			end 'storedReadOnly'
		end 'eachParameter'

		return stored
	end 'readOnlyElementParameters'

	module function enterFunction(funcIndex ElementIndex)
		self.enteredIndex = funcIndex
	end 'enterFunction'

	module function adoptParameterWrites(writes ParamMutationSummary)
		self.writtenMasks = writes.masks.clone()
		self.recordWrittenMasks = writes.recordWriteMasks.clone()
	end 'adoptParameterWrites'

	function parametersWrittenByCalls(index ElementIndex) returns ParamPositionMask
		return (try self.writtenMasks.get(index) otherwise panic("ProvenanceTracer.parametersWrittenByCalls: writtenMasks.get OOB at {index}")) or (try self.recordWrittenMasks.get(index) otherwise panic("ProvenanceTracer.parametersWrittenByCalls: recordWrittenMasks.get OOB at {index}"))
	end 'parametersWrittenByCalls'

	// `value` is handed, in the entered function, by the call at `call`, to a parameter its callee writes —
	// `parameter`, `unnamed` when its name is unknown.
	module function noteArgumentWritten(value ValueId, call SourceRange, parameter ArgumentParameter)
		self.writtenArgFuncs.push(self.enteredIndex)
		self.writtenArgValues.push(value)
		self.writtenArgCalls.push(call)
		self.writtenArgParams.push(parameter)
		self.writtenArgJudged.push(false)
	end 'noteArgumentWritten'

	module function noteKeptArgument(value ValueId, call SourceRange, parameter ArgumentParameter, callee ByteArray, keep ArgumentKeep)
		self.keptArgKinds.push(keep)
		self.keptArgFuncs.push(self.enteredIndex)
		self.keptArgValues.push(value)
		self.keptArgCalls.push(call)
		self.keptArgParams.push(parameter)
		self.keptArgCallees.push(callee)
	end 'noteKeptArgument'

	// The argument noted last was refused where it was noted (E3159 by name or by identity): the write-through door
	// leaves it be.
	module function noteLastArgumentJudged()
		try self.writtenArgJudged.set(self.writtenArgJudged.count() - 1, value: true) otherwise panic("ProvenanceTracer.noteLastArgumentJudged: no argument was noted")
	end 'noteLastArgumentJudged'

	// ⭐ **A CALL THAT NAMES NO SINGLE CALLEE WRITES AN ARGUMENT WHERE ANY BODY IT MAY LAND ON WRITES THAT
	// POSITION** — a witness dispatch's conformers and a function value's bodies, their arguments positional. A
	// body no summary describes may write any argument (`unresolvedMayStore`); a compiler-synthesized witness is
	// built to the requirement's shape and writes none. Asked, like `noteArgumentWritten`, only where a door will
	// read the answer (`enteredFunctionAsksWrittenArguments`).
	// It answers the positions already judged: those in `ownedElsewhere`, refused where a callback was
	// handed in, and those refused here by identity. `SemanticCheck.checkLandingArguments` judges the
	// rest by name.
	module function noteLandingArgumentsWritten(func IrFunction, args ValueIdArray, argCount ParamCount, bodies CallLandingBodies, call SourceRange, mutationSummary ParamMutationSummary, ownedElsewhere ParamPositionMask, keeps LandingKeeps, calleeText String) returns ParamPositionMask
		self.landingNotedPositions.clear()
		self.landingNotedRows.clear()

		if not self.enteredFunctionAsksWrittenArguments(func) 'nothingAsks'
			return ownedElsewhere
		end 'nothingAsks'

		let written = mutationSummary.writtenMaskAtAnyOf(bodies.impls)
		var judged = ownedElsewhere

		for i in 0 upto argCount 'eachArg'
			if bodies.unresolvedMayStore or maskHasParam(written, param: i) 'written'
				let value = try args.get(i) otherwise panic("ProvenanceTracer.noteLandingArgumentsWritten: args.get OOB at {i}")
				view parameters = self.landingParamNames(bodies, position: i, mutationSummary: mutationSummary)
				self.landingNotedPositions.push(i)
				self.landingNotedRows.push(self.writtenArgJudged.count())
				self.noteArgumentWritten(value, call: call, parameter: firstArgumentParameter(parameters))

				if maskHasParam(ownedElsewhere, param: i) 'reportedWhereItWasHandedIn'
					self.noteLastArgumentJudged()
				end 'reportedWhereItWasHandedIn' else if self.refuseAnImmutableWrittenArgument(func, value: value, call: call, parameters: parameters) 'refusedHere'
					judged = maskWithParam(judged, param: i)
				end 'refusedHere'
			end 'written'
		end 'eachArg'

		self.noteLandingArgumentsKept(func, args: args, argCount: argCount, bodies: bodies, call: call, mutationSummary: mutationSummary, keeps: keeps, calleeText: calleeText)
		return judged
	end 'noteLandingArgumentsWritten'

	// The rows it marks are the last landing's, cleared by the next `noteLandingArgumentsWritten`, so
	// a refusal by name is noted before the next landing is.
	module function noteLandingArgumentJudged(position ParamCount)
		for k in 0 upto self.landingNotedPositions.count() 'eachNoted'
			if (try self.landingNotedPositions.get(k) otherwise panic("ProvenanceTracer.noteLandingArgumentJudged: landingNotedPositions.get OOB at {k}")) == position 'thisPosition'
				try self.writtenArgJudged.set(try self.landingNotedRows.get(k) otherwise panic("ProvenanceTracer.noteLandingArgumentJudged: landingNotedRows.get OOB at {k}"), value: true) otherwise panic("ProvenanceTracer.noteLandingArgumentJudged: writtenArgJudged.set OOB")
				return
			end 'thisPosition'
		end 'eachNoted'

		panic("ProvenanceTracer.noteLandingArgumentJudged: position {position} was not noted as written by the last landing")
	end 'noteLandingArgumentJudged'

	function noteLandingArgumentsKept(func IrFunction, args ValueIdArray, argCount ParamCount, bodies CallLandingBodies, call SourceRange, mutationSummary ParamMutationSummary, keeps LandingKeeps, calleeText String)
		var letKeeps = NoParamPositions
		var payloadKeeps = NoParamPositions
		var elementKeeps = NoParamPositions
		var mutablyKept = NoParamPositions

		for impl in bodies.impls 'eachBody'
			letKeeps = letKeeps or self.summary.letKeepsAt(impl)
			payloadKeeps = payloadKeeps or self.summary.payloadKeepsAt(impl)
			elementKeeps = elementKeeps or self.summary.elementKeepsAt(impl)
			mutablyKept = mutablyKept or self.keptParameters(impl, paramCount: self.functionAt(impl).paramCount)
		end 'eachBody'

		let declaredByBoundary = keeps.isDeclared()

		if not declaredByBoundary and bodies.impls.count() == 0 'noBodyToJudge'
			return
		end 'noBodyToJudge'

		let masks = KeptMasks.create(letKeeps, letPayload: payloadKeeps, readOnlyElement: elementKeeps, mutable: keeps.keptOr(mutablyKept), anyPosition: bodies.unresolvedMayStore and not declaredByBoundary)
		view noteCallee = calleeText.toByteArray() if declaredByBoundary else self.functionAt(try bodies.impls.get(0) otherwise panic("ProvenanceTracer.noteLandingArgumentsKept: impls.get(0) on a non-empty list")).name

		for i in 0 upto argCount 'eachArg'
			let value = try args.get(i) otherwise panic("ProvenanceTracer.noteLandingArgumentsKept: args.get OOB at {i}")

			if self.valueIsInertAtADoor(func, value: value) 'keptWithoutAWriter'
				continue
			end 'keptWithoutAWriter'

			view parameter = keeps.declaredParameterAt(i) if declaredByBoundary else firstArgumentParameter(self.landingParamNames(bodies, position: i, mutationSummary: mutationSummary))
			let refusal = KeptRefusal.wording(declaredKeptWording(keeps, position: i, callee: calleeText)) if declaredByBoundary else KeptRefusal.none
			let refused = self.noteArgumentKept(func, value: value, call: call, parameter: parameter, callee: noteCallee, position: i, masks: masks, refusal: refusal)

			if not refused and declaredByBoundary and keeps.consumes(i) 'aSoleParameterTakesIt'
				self.noteKeptArgument(value, call: call, parameter: parameter, callee: noteCallee, keep: ArgumentKeep.consumed)
			end 'aSoleParameterTakesIt'
		end 'eachArg'
	end 'noteLandingArgumentsKept'

	module function noteArgumentKept(func IrFunction, value ValueId, call SourceRange, parameter ArgumentParameter, callee ByteArray, position ParamCount, masks KeptMasks, refusal KeptRefusal) returns bool
		let keptWhereSomethingMayWriteIt = (masks.anyPosition or maskHasParam(masks.mutable, param: position)) and value >= valueIdAtParamPosition(func.paramCount)

		let refused = match refusal 'refusal'
			wording(kept) gives keptWhereSomethingMayWriteIt and self.refuseKeptLetArgument(func, value: value, call: call, parameter: parameter, wording: kept)
			none gives false
		end 'refusal'

		if refused 'refusedAsALet'
			return true
		end 'refusedAsALet'

		if maskHasParam(masks.letField, param: position) 'keptInALetField'
			self.noteKeptArgument(value, call: call, parameter: parameter, callee: callee, keep: ArgumentKeep.letField)
		end 'keptInALetField' else if maskHasParam(masks.letPayload, param: position) 'keptInALetPayload'
			self.noteKeptArgument(value, call: call, parameter: parameter, callee: callee, keep: ArgumentKeep.letPayload)
		end 'keptInALetPayload' else if maskHasParam(masks.readOnlyElement, param: position) 'keptInAReadOnlyElement'
			self.noteKeptArgument(value, call: call, parameter: parameter, callee: callee, keep: ArgumentKeep.readOnlyElement)
		end 'keptInAReadOnlyElement'

		if keptWhereSomethingMayWriteIt and not self.valueWasMintedSole(func, value: value) 'mayShareStorage'
			self.noteKeptArgument(value, call: call, parameter: parameter, callee: callee, keep: ArgumentKeep.mutablePlace)
		end 'mayShareStorage'

		return false
	end 'noteArgumentKept'

	module function calleeValueName(func IrFunction, callee ValueId) returns String
		view sites = func.provenanceSites(self.noSites)

		if callee < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return self.parameterNameAt(func, position: paramPositionOfValueId(callee))
		end 'aParameter'

		for i in 0 upto sites.immutableBindings.values.count() 'eachBinding'
			if (try sites.immutableBindings.values.get(i) otherwise panic("ProvenanceTracer.calleeValueName: values.get OOB at {i}")) == callee 'namesTheCallee'
				return String.from(try sites.immutableBindings.names.get(i) otherwise panic("ProvenanceTracer.calleeValueName: names.get OOB at {i} — the two columns are pushed together"))
			end 'namesTheCallee'
		end 'eachBinding'

		if let name = try self.writableNameOf(func, value: callee) 'aVar'
			return name
		end 'aVar'

		if let field = try self.fieldNameLoadedBy(func, value: callee) 'aFieldRead'
			return String.from(field)
		end 'aFieldRead'

		return String.from(functionValueOwnTypeName(self.project, func: func, value: callee))
	end 'calleeValueName'

	function fieldNameLoadedBy(func IrFunction, value ValueId) returns ByteArray throws AbsentError
		self.indexDefinitions(func, ir: self.module)
		let defining = try self.definingOpIndexOf(value)
		view op = try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.fieldNameLoadedBy: op {defining} not in module.ops")

		match slotReadOfOp(op, opIndex: defining) 'read'
			load(_, addr, offset) then return try self.fieldNameAt(func, record: addr, offset: offset)
			retainOf(operand) then return try self.fieldNameLoadedBy(func, value: operand)
			none or
			store then throw AbsentError.absent
		end 'read'
	end 'fieldNameLoadedBy'

	function fieldNameAt(func IrFunction, record ValueId, offset ByteOffset) returns ByteArray throws AbsentError
		if not tagNamesADeclaredType(valueTagOf(func, value: record)) 'notADeclaredRecord'
			throw AbsentError.absent
		end 'notADeclaredRecord'

		let typeName = try self.project.typeNames.nameOf(self.nameIdOf(func, value: record)) otherwise throw AbsentError.absent
		return try self.signatures.fieldNameAtOffset(typeName, offset: offset)
	end 'fieldNameAt'

	module function resultMeetsCapability(index ElementIndex, capability ResultCapability) returns bool
		if not self.resultMayHandBackAModuleLetsRecord(self.functionAt(index)) 'carriesNoRecord'
			return true
		end 'carriesNoRecord'

		return match capability 'capability'
			unqualified gives true
			sole gives try self.freshReturns.get(index) otherwise panic("ProvenanceTracer.resultMeetsCapability: freshReturns.get OOB at {index}")
			readonly gives self.permanentWhateverItIsHanded(index, allowFresh: true)
		end 'capability'
	end 'resultMeetsCapability'

	function refuseAnImmutableWrittenArgument(func IrFunction, value ValueId, call SourceRange, parameters ArgumentParameterArray) returns bool
		view blamed = self.immutableRootWrittenThrough(func, value: value, call: call)

		if not blamed.isBlamed() 'nothingBlamed'
			return false
		end 'nothingBlamed'

		self.noteLastArgumentJudged()

		for parameter in parameters 'eachWritersName'
			reportPositioned(self.project, code: ErrorCode.semanticWriteThroughImmutableRecord, message: writtenArgumentMessage(self.blamedSubject(func, value: value, blamed: blamed, call: call), parameter: parameter, functionName: self.signatures.sourceNameOfFunction(func.name)), line: call.line, column: call.column, filePath: func.sourceFilePath)
		end 'eachWritersName'

		return true
	end 'refuseAnImmutableWrittenArgument'

	module function landingParamNames(bodies CallLandingBodies, position ParamCount, mutationSummary ParamMutationSummary) returns ArgumentParameterArray
		var names = ArgumentParameterArray.create()

		for index in bodies.impls 'eachWriter'
			let (mask, recordWriteMask) = mutationSummary.writesOf(self.functionAt(index).name)

			if maskHasParam(mask or recordWriteMask, param: position) and self.bodyNamesPosition(index, position: position) 'aWriterNamingIt'
				names.push(self.bodyParamName(index, position: position))
			end 'aWriterNamingIt'
		end 'eachWriter'

		if names.count() > 0 'namedByItsWriters'
			return names
		end 'namedByItsWriters'

		for index in bodies.impls 'eachBody'
			if self.bodyNamesPosition(index, position: position) 'aBodyNamingIt'
				names.push(self.bodyParamName(index, position: position))
				return names
			end 'aBodyNamingIt'
		end 'eachBody'

		names.push(ArgumentParameter.unnamed)
		return names
	end 'landingParamNames'

	function bodyNamesPosition(index ElementIndex, position ParamCount) returns bool
		let sig = try self.project.funcSignatures.get(self.functionAt(index).name) otherwise return false
		return position < sig.paramNames.count()
	end 'bodyNamesPosition'

	module function bodyParamName(index ElementIndex, position ParamCount) returns ArgumentParameter
		let sig = try self.project.funcSignatures.get(self.functionAt(index).name) otherwise return ArgumentParameter.unnamed
		return ArgumentParameter.named(try sig.paramNames.get(position) otherwise return ArgumentParameter.unnamed)
	end 'bodyParamName'

	// The values `func` (at `index`) writes through: a receiver-writing call's receiver, a field write's box, and
	// an argument at a written parameter.
	function gatherWrittenTargets(func IrFunction, index ElementIndex)
		self.writtenRanks = self.sets.addSet()
		self.writtenWithinRanks = self.sets.addSet()
		self.refusedDoorRanks = self.sets.addSet()
		self.refusedDoorValues.refill(func.valueTags.count(), value: false)
		self.writtenArgsHere.clear()

		self.keptRefusedRanks = self.sets.addSet()

		for refused in self.keptRefusedValues 'eachRefusedKeep'
			self.noteRefusedKeep(refused)
		end 'eachRefusedKeep'

		for site in func.provenanceSites(self.noSites).receiverWrites 'eachReceiver'
			self.noteWrittenTarget(site.receiver)
		end 'eachReceiver'

		for box in func.provenanceSites(self.noSites).fieldWrites 'eachBox'
			self.noteWrittenTarget(box)
		end 'eachBox'

		while self.writtenArgCursor < self.writtenArgFuncs.count() 'eachArgument'
			let owner = try self.writtenArgFuncs.get(self.writtenArgCursor) otherwise panic("ProvenanceTracer.gatherWrittenTargets: writtenArgFuncs.get OOB below its own count")

			if owner > index 'aLaterFunctions'
				break
			end 'aLaterFunctions'

			if owner == index 'thisFunctions'
				self.noteWrittenTarget(try self.writtenArgValues.get(self.writtenArgCursor) otherwise panic("ProvenanceTracer.gatherWrittenTargets: the two columns are pushed together"))
				self.writtenArgsHere.push(self.writtenArgCursor)
			end 'thisFunctions'

			self.writtenArgCursor = self.writtenArgCursor + 1
		end 'eachArgument'
	end 'gatherWrittenTargets'

	function noteWrittenTarget(target ValueId)
		self.unionInto(self.writtenRanks, from: self.setOf(ProvenanceColumn.identity, value: target))
		self.unionInto(self.writtenWithinRanks, from: self.setOf(ProvenanceColumn.inside, value: target))
	end 'noteWrittenTarget'

	// ⭐ **IS THE RECORD A `var` WAS BOUND TO WRITTEN THROUGH WHILE IT HOLDS IT?** A `var` only rebound and read —
	// a chain cursor, `cur = try cur.next()` — is a rebindable shared reference and mutates nothing a live `let`
	// reads. Its record is written where a field write, a receiver-writing call or a written parameter reaches a
	// value that may be it — the `var`'s own rank, which follows the record wherever it flows. A value no local
	// `var` holds as its own (a module `var`'s, written wherever the program likes) is taken as written.
	function boundValueIsWrittenThrough(value ValueId) returns bool
		let own = try self.writableRankOf(value) otherwise return true
		return self.sets.hasRank(self.writtenRanks, rank: own)
	end 'boundValueIsWrittenThrough'

	function boundRecordOrAnyPartOfItIsWrittenThrough(value ValueId) returns bool
		let own = try self.writableRankOf(value) otherwise return false
		return self.sets.hasRank(self.writtenRanks, rank: own) or self.sets.hasRank(self.writtenWithinRanks, rank: own)
	end 'boundRecordOrAnyPartOfItIsWrittenThrough'

	// E3159's question of one argument of the entered function's call at `call`: the first `let` in
	// declaration order live after the call whose own record it may be or lie within, or `unblamed`. A value a
	// `var` holds answers `unblamed`: the door that bound it (E3078) answers for it, since that asks `identity`
	// and `inside` too.
	module function immutableRootWrittenThrough(func IrFunction, value ValueId, call SourceRange) returns WriteBlame
		if not self.immutableBindingsAreTraced(func) or self.valueIsAVarsOwn(value) or self.valueReachesAKeptRecordRefusedBefore(value, write: positionKey(call.line, column: call.column)) 'noImmutableRootToBlame'
			return WriteBlame.unblamed
		end 'noImmutableRootToBlame'

		self.askAtDoor(self.callTokenAtPosition(func, line: call.line, column: call.column))
		let blamed = self.blameWrite(func, target: value, own: self.firstRootWrittenThrough(func, target: value))
		self.leaveDoor()
		return blamed
	end 'immutableRootWrittenThrough'

	function resultIsBoundByALet(func IrFunction, result ValueId) returns bool
		if not self.immutableBindingsAreTraced(func) 'noImmutableName'
			return false
		end 'noImmutableName'

		let rank = try self.bindingRankOf(result) otherwise return false
		return self.rootKindAt(rank) == ReadOnlyRootKind.letBinding or self.rootKindAt(rank) == ReadOnlyRootKind.destructuredTuple
	end 'resultIsBoundByALet'

	module function valueMayBeABuiltModuleLetsRecord(func IrFunction, value ValueId) returns bool
		if not self.immutableBindingsAreTraced(func) 'noRootsTraced'
			return false
		end 'noRootsTraced'

		return self.valueIsOrLiesWithinAModuleLet(func, value: value)
	end 'valueMayBeABuiltModuleLetsRecord'

	function bindingRankOf(value ValueId) returns ElementIndex throws RootRankLookup
		if value >= self.rootRankOfValue.count() 'pastTheValues'
			panic("ProvenanceTracer.bindingRankOf: v{value} is past the traced function's value count")
		end 'pastTheValues'

		return try self.rootRankOfValue.get(value) otherwise throw RootRankLookup.noRoot
	end 'bindingRankOf'

	function writableRankOf(value ValueId) returns ElementIndex throws RootRankLookup
		if value >= self.writableRankOfValue.count() 'pastTheValues'
			panic("ProvenanceTracer.writableRankOf: v{value} is past the traced function's value count")
		end 'pastTheValues'

		return try self.writableRankOfValue.get(value) otherwise throw RootRankLookup.noRoot
	end 'writableRankOf'

	function hasWritableRank(value ValueId) returns bool
		try self.writableRankOf(value) otherwise return false
		return true
	end 'hasWritableRank'

	function valueIsAVarsOwn(value ValueId) returns bool
		return try self.isWritableValue.get(value) otherwise panic("ProvenanceTracer.valueIsAVarsOwn: v{value} is past the traced function's value count")
	end 'valueIsAVarsOwn'

	function seedParameter(func IrFunction, param ValueId, rank ElementIndex)
		self.setBit(ProvenanceColumn.identity, value: param, rank: rank)
		self.setBit(ProvenanceColumn.shares, value: param, rank: rank)

		// A by-reference parameter is the address of the caller's cell, so what a read of it yields IS the record.
		if maskHasParam(func.reassignedParamMask, param: paramPositionOfValueId(param)) 'aCell'
			self.setBit(ProvenanceColumn.holds, value: param, rank: rank)
		end 'aCell'
	end 'seedParameter'

	function begin(func IrFunction)
		let valueCount = func.valueTags.count()
		self.setsPerColumn = valueCount
		self.sets.reset(self.columnCount * self.setsPerColumn)
		self.escapedSet = self.sets.addSet()
		self.storeSlots.reset()
		self.deepSlots.reset()
		self.hasLoadOrigin.refill(valueCount, value: false)
		self.loadOrigins.refill(valueCount, value: 0)

		self.returnedShares = NoParamPositions
		self.returnedIdentity = NoParamPositions
		self.returnedHolds = NoParamPositions
		self.returnedInside = NoParamPositions
		self.returnedHoldsWithin = NoParamPositions
		self.returnedPlacedWithin = NoParamPositions
		self.returnedEscapes = NoParamPositions
		self.returnedBinds = NoParamPositions
		self.returnedLetKeeps = NoParamPositions
		self.returnedPayloadKeeps = NoParamPositions
		self.returnedElementKeeps = NoParamPositions
		self.returnedKeeps = NoParamPositions
		self.returnedOtherKeeps = NoParamPositions
		self.returnedRecordKeeps = NoParamPositions
		self.returnedModuleLets = NoParamPositions
		self.pendingKeeps.clear()
		self.returnedValues.clear()
		self.keptEscapes.refill(valueCount, value: false)
		self.keptReturned.refill(valueCount, value: false)
		self.keptEverythingEscapes = false
		self.moduleLetStorageReached = false
		self.tracked.refill(valueCount, value: false)
		self.isWritableValue.refill(valueCount, value: false)
		self.isImmutableBindingValue.refill(valueCount, value: false)

		if not func.keepsSoleOwnerMarks() 'columnsOutOfStep'
			panic("ProvenanceTracer.begin: '{String.from(func.name)}' has {valueCount} value types but {func.valueMintedSole.count()} sole-owner marks — both are pushed by `Parser.mintValue`/`recordValueType`")
		end 'columnsOutOfStep'

		for v in 0 upto valueCount 'eachValue'
			let soleOwner = try func.valueMintedSole.get(v) otherwise panic("ProvenanceTracer.begin: valueMintedSole.get OOB at {v}")
			try self.tracked.set(v, value: (soleOwner or self.valueTagCarriesProvenance(func, value: v as ValueId)) and not self.valueIsAnImmutableAggregate(func, value: v as ValueId)) otherwise panic("ProvenanceTracer.begin: tracked.set OOB at {v}")
		end 'eachValue'
	end 'begin'

	function walk(func IrFunction, index ElementIndex, ir MaxonModule)
		self.indexDefinitions(func, ir: ir)
		self.calls.beginWalk(index)
		self.changed = true
		let order = callSiteWalkOrder(ir, func: func)

		while self.changed 'untilNothingGrows'
			self.changed = false
			self.pendingKeeps.clear()
			self.calls.startPass()

			for position in order 'eachBlock'
				let blockRef = try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.walk: position {position} from the walk order is past func.blockRefs")
				let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.walk: blockRef from func.blockRefs not in module.blocks")
				self.traceBlock(func, ir: ir, block: block, position: position)
			end 'eachBlock'

			self.calls.finishPass(index)
		end 'untilNothingGrows'

		for blockRef in func.blockRefs 'eachReturningBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.walk: blockRef from func.blockRefs not in module.blocks")

			if block.hasTerminatorOp() 'terminated'
				self.recordReturn(func, terminator: try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.walk: terminatorIndex not in module.ops"))
			end 'terminated'
		end 'eachReturningBlock'
	end 'walk'

	function traceBlock(func IrFunction, ir MaxonModule, block IrBlock, position ElementIndex)
		for opIdx in block.bodyOps() 'eachOp'
			self.traceOp(func, op: try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.traceBlock: opIdx {opIdx} not in module.ops"), opIdx: opIdx)
		end 'eachOp'

		for pair in self.pairsFrom(position) upto self.pairsUpTo(position) 'eachPhi'
			let phi = self.pairMergeAt(pair)

			if self.pairIsHanded(pair) and self.isTracked(phi) 'phiHoldsARecord'
				self.flowIdentity(phi, from: self.pairIncomingAt(pair))
			end 'phiHoldsARecord'
		end 'eachPhi'
	end 'traceBlock'

	function traceOp(func IrFunction, op MaxonOp, opIdx ElementIndex)
		match op 'op'
			loadIndirect(result, addr, offset, _) then self.traceLoad(func, result: result, addr: addr, offset: offset)
			storeIndirect(addr, offset, value, _) then self.traceStore(func, addr: addr, offset: offset, value: value)
			call(result, callee, args, argLabels, argRanges, _, _, _) then dispatchNamedCall(self, func: func, op: op, opIdx: opIdx, result: result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges)
			tryCall(result, _, callee, args, argLabels, argRanges, _, _, _) then dispatchNamedCall(self, func: func, op: op, opIdx: opIdx, result: result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges)

			// ⭐ **A SPAWN IS TRACED AS THE CALL IT IS.** Its target takes a reference to a managed argument
			// (`Parser.transferAsyncSpawnArgs`), so what that target KEEPS — stores into another parameter, binds
			// to a mutable name, hands back inside its result — is kept out of this frame just as a direct call's
			// is, and the summary must carry it one frame out or a caller that only spawns reads as keeping
			// nothing.
			asyncCall(result, callee, args, argLabels, argRanges, _, _, _) then dispatchNamedCall(self, func: func, op: op, opIdx: opIdx, result: result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges)
			witnessDispatch(result, args, _, _, methodIndex, interfaceDeclIndex, _, _) then self.traceLandingCall(func, op: op, opIdx: opIdx, result: result, args: args, bodies: self.calls.resolution.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex))
			witnessTryDispatch(result, _, args, _, _, methodIndex, interfaceDeclIndex, _) then self.traceLandingCall(func, op: op, opIdx: opIdx, result: result, args: args, bodies: self.calls.resolution.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex))

			// A module `var` is writable storage, and every read or write of it goes through its address.
			globalAddr(result, label) then self.traceGlobalAddress(result, label: label)

			// Every other op that defines a value may define any record its operands reach. A raw
			// intrinsic is the runtime tier's, which holds no managed value.
			literal(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			binOp(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			unaryOp(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			compare(result, _, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			stringLiteral(result, _) then self.flowFromOperands(func, op: op, result: result)
			functionRef(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			await (result, _) then self.flowFromOperands(func, op: op, result: result)
			tryAwait(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			sizeofType(result, _) then self.flowFromOperands(func, op: op, result: result)
			constArrayLiteral(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			errorFlagEncode(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			serviceSpawn(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			serviceSend(result, _, _, _, _, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			serviceReplyCell(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			immortalStructRecord(result, _, _) then self.flowFromOperands(func, op: op, result: result)
			immortalStringTable(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			rawIntrinsic(result, _, _, _) then self.flowFromOperands(func, op: op, result: result)
			holdValue(result, _, _, _, _) then self.flowThroughBookkeeping(func, op: op, result: result)
			holdEnd(result, _, _, _, _) then self.flowFromOperands(func, op: op, result: result)

			// Its `args` is the variant's TAIL field, so it is bound in a small match — see
			// `LowerMaxonToStd.lowerIndirectCall`.
			indirectCall then self.traceIndirectCall(func, op: op, opIdx: opIdx)
			ret or
			retVoid or
			condBranch or
			branch or
			throwError or
			propagateError or
			panicAbort or
			switch or
			panicAbortValue or
			covPoint or
			existentialWitness then break
		end 'op'
	end 'traceOp'

	// A module `let`'s slot is storage no write reaches, so only a module `var`'s address is writable storage. A
	// parameter trace takes what a `let`'s slot holds for one more root, so a read of the slot may BE its record —
	// which is what the summary's `moduleLets` is read off; an immutable-binding trace ranks each `let` its body
	// reads as a binding of its own instead.
	function traceGlobalAddress(result ValueId, label ByteArray)
		if not self.immutableGlobalLabels.contains(label) 'aModuleVar'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.writableRank)
			return
		end 'aModuleVar'

		if not self.tracingImmutableBindings and not self.inertGlobalLabels.contains(label) 'aParameterTrace'
			self.seedBit(ProvenanceColumn.holds, value: result, rank: self.moduleLetRank())
		end 'aParameterTrace'
	end 'traceGlobalAddress'

	// The rank past writable storage: every record a module-level `let` holds, which no root value names.
	function moduleLetRank() returns ElementIndex
		return self.writableRank + 1
	end 'moduleLetRank'

	// ⭐ **A CALLEE WHOSE RESULT MAY REACH A MODULE-LEVEL `let`'S RECORD HANDS THAT TO ITS CALLER**, as the rank that
	// stands for every record the `let`s hold: a result that may be or lie within one may BE such a record, and one
	// that may hold one HOLDS such a record. Identity and holds are the two sets a store into a `var`'s cell and the
	// load back out of it carry.
	function flowModuleLets(result ValueId, calleeIndex ElementIndex)
		let reach = self.summary.moduleLetsAt(calleeIndex)

		if reach == NoParamPositions 'reachesNoLet'
			return
		end 'reachesNoLet'

		self.moduleLetStorageReached = true

		if (reach and ResultLiesWithinAModuleLet) != NoParamPositions 'liesWithinOne'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.moduleLetRank())
		end 'liesWithinOne'

		if (reach and ResultHoldsAModuleLet) != NoParamPositions 'holdsOne'
			self.seedBit(ProvenanceColumn.holds, value: result, rank: self.moduleLetRank())
		end 'holdsOne'

		if (reach and ResultLiesWithinASharedView) != NoParamPositions 'liesWithinAView'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.sharedViewRank())
		end 'liesWithinAView'

		if (reach and ResultHoldsASharedView) != NoParamPositions 'holdsAView'
			self.seedBit(ProvenanceColumn.holds, value: result, rank: self.sharedViewRank())
		end 'holdsAView'

		if (reach and ResultLiesWithinALetField) != NoParamPositions 'liesWithinALetField'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.letFieldRank())
		end 'liesWithinALetField'

		if (reach and ResultHoldsALetField) != NoParamPositions 'holdsALetField'
			self.seedBit(ProvenanceColumn.holds, value: result, rank: self.letFieldRank())
		end 'holdsALetField'

		if (reach and ResultLiesWithinALetPayload) != NoParamPositions 'liesWithinALetPayload'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.letPayloadRank())
		end 'liesWithinALetPayload'

		if (reach and ResultHoldsALetPayload) != NoParamPositions 'holdsALetPayload'
			self.seedBit(ProvenanceColumn.holds, value: result, rank: self.letPayloadRank())
		end 'holdsALetPayload'

		if (reach and ResultLiesWithinAReadOnlyElement) != NoParamPositions 'liesWithinAReadOnlyElement'
			self.seedBit(ProvenanceColumn.identity, value: result, rank: self.readOnlyElementRank())
		end 'liesWithinAReadOnlyElement'

		if (reach and ResultHoldsAReadOnlyElement) != NoParamPositions 'holdsAReadOnlyElement'
			self.seedBit(ProvenanceColumn.holds, value: result, rank: self.readOnlyElementRank())
		end 'holdsAReadOnlyElement'

		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			if maskHasParam(reach, param: ResultTupleKindFirstBit + kind as ParamCount) 'aTupleWithAKind'
				self.seedBit(ProvenanceColumn.identity, value: result, rank: self.tupleLetFieldRank() + kind)
			end 'aTupleWithAKind'

			if maskHasParam(reach, param: ResultMayBeKindFirstBit + kind as ParamCount) 'mayBeOfAKind'
				self.seedBit(ProvenanceColumn.identity, value: result, rank: self.maybeLetFieldRank() + kind)
			end 'mayBeOfAKind'
		end 'eachSlotKind'

		if (reach shr TupleColumnSummaryFirstBit) == NoParamPositions 'noColumnIsMarked'
			return
		end 'noColumnIsMarked'

		for column in 0 upto TupleColumnMarkCount 'eachColumn'
			if maskHasParam(reach, param: TupleColumnSummaryFirstBit + column as ParamCount) 'aMarkedColumn'
				self.seedBit(ProvenanceColumn.identity, value: result, rank: self.tupleColumnRank(column))
			end 'aMarkedColumn'
		end 'eachColumn'
	end 'flowModuleLets'

	function setHasRank(column ProvenanceColumn, value ValueId, rank ElementIndex) returns bool
		return self.sets.hasRank(self.setOf(column, value: value), rank: rank)
	end 'setHasRank'

	function valueIsOrLiesWithin(value ValueId, rank ElementIndex) returns bool
		return self.setHasRank(ProvenanceColumn.identity, value: value, rank: rank) or self.setHasRank(ProvenanceColumn.inside, value: value, rank: rank)
	end 'valueIsOrLiesWithin'

	// The ranks past `moduleLetRank` stand for the records of each read-only kind that no root value
	// names, and for a tuple's marks over them; `isPermanentViewRank` and `permanentViewOf` list them.
	// `unionMaskWithoutLetFields` skips `HiddenViewRankCount` ranks as one run from `letFieldRank`, so
	// every rank from there through the last tuple column stays consecutive.
	function sharedViewRank() returns ElementIndex
		return self.writableRank + 2
	end 'sharedViewRank'

	function opReadsASharedView(op MaxonOp) returns bool
		return match maxonOpCalleeKind(op) 'kind'
			direct gives maxonOpCalleeName(op).equals(SharedValueCurrentName)
			functionValue or
			noCallee gives false
		end 'kind'
	end 'opReadsASharedView'

	function letFieldRank() returns ElementIndex
		return self.writableRank + 3
	end 'letFieldRank'

	function letPayloadRank() returns ElementIndex
		return self.letFieldRank() + 1
	end 'letPayloadRank'

	function readOnlyElementRank() returns ElementIndex
		return self.letFieldRank() + 2
	end 'readOnlyElementRank'

	function maybeLetFieldRank() returns ElementIndex
		return self.letFieldRank() + ReadOnlySlotKindCount
	end 'maybeLetFieldRank'

	function tupleLetFieldRank() returns ElementIndex
		return self.maybeLetFieldRank() + ReadOnlySlotKindCount
	end 'tupleLetFieldRank'

	function tupleColumnRank(column ElementIndex) returns ElementIndex
		return self.tupleLetFieldRank() + ReadOnlySlotKindCount + column
	end 'tupleColumnRank'

	// Columns past the last share its rank, which can only refuse more, never less.
	function tupleColumnOfOffset(offset ByteOffset) returns ElementIndex
		let slot = (offset / FieldSlotBytes) as ElementIndex
		return slot if slot < TupleColumnMarkCount else TupleColumnMarkCount - 1
	end 'tupleColumnOfOffset'

	function seedLetSlotRead(result ValueId, rank ElementIndex)
		self.seedBit(ProvenanceColumn.identity, value: result, rank: rank)
		self.moduleLetStorageReached = true
	end 'seedLetSlotRead'

	function isPermanentViewRank(rank ElementIndex) returns bool
		return rank == self.moduleLetRank() or rank == self.sharedViewRank() or (rank >= self.letFieldRank() and rank < self.letFieldRank() + HiddenViewRankCount)
	end 'isPermanentViewRank'

	function permanentViewOf(value ValueId) returns PermanentView
		if self.valueIsOrLiesWithin(value, rank: self.sharedViewRank()) 'aSharedView'
			return PermanentView.sharedView
		end 'aSharedView'

		return self.readOnlySlotViewOf(value, firstRank: self.letFieldRank(), lyingWithin: true)
	end 'permanentViewOf'

	function maybePermanentViewOf(value ValueId) returns PermanentView
		let proven = self.permanentViewOf(value)

		if proven != PermanentView.none 'provenReadOnly'
			return proven
		end 'provenReadOnly'

		let element = self.readOnlySlotViewOf(value, firstRank: self.maybeLetFieldRank(), lyingWithin: true)

		if element != PermanentView.none 'anElementThatMayBeReadOnly'
			return element
		end 'anElementThatMayBeReadOnly'

		return self.readOnlySlotViewOf(value, firstRank: self.tupleLetFieldRank(), lyingWithin: false)
	end 'maybePermanentViewOf'

	function readOnlySlotViewOf(value ValueId, firstRank ElementIndex, lyingWithin bool) returns PermanentView
		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			let marked = self.valueIsOrLiesWithin(value, rank: firstRank + kind) if lyingWithin else self.setHasRank(ProvenanceColumn.identity, value: value, rank: firstRank + kind)

			if marked 'aMarkedKind'
				return readOnlySlotViewOfKind(kind)
			end 'aMarkedKind'
		end 'eachSlotKind'

		return PermanentView.none
	end 'readOnlySlotViewOf'

	function slotIsALetSlot(func IrFunction, addr ValueId, offset ByteOffset, held ValueId) returns bool
		return self.letSlotKindMemoized(func, addr: addr, offset: offset, held: held) != LetSlotKind.none
	end 'slotIsALetSlot'

	function letSlotKindMemoized(func IrFunction, addr ValueId, offset ByteOffset, held ValueId) returns LetSlotKind
		let tag = valueTagOf(func, value: addr)

		if tag == ValueTypeTag.named 'aUnionBox'
			return LetSlotKind.payload if self.slotIsALetPayload(func, box: addr, offset: offset, held: held) else LetSlotKind.none
		end 'aUnionBox'

		let key = try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return LetSlotKind.none

		if let known = try self.letFieldSlots.get(key) 'asked'
			return known
		end 'asked'

		let kind = LetSlotKind.field if self.slotIsALetField(func, addr: addr, offset: offset) else LetSlotKind.none
		self.letFieldSlots.upsert(key, value: kind)
		return kind
	end 'letSlotKindMemoized'

	function declaredSlotKeyOf(func IrFunction, addr ValueId, offset ByteOffset) returns StoreSlotKey throws AbsentError
		let tag = valueTagOf(func, value: addr)

		if tag != ValueTypeTag.genericInstance and not tagNamesADeclaredType(tag) 'notADeclaredRecord'
			throw AbsentError.absent
		end 'notADeclaredRecord'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			let baseId = self.signatures.genericInstanceBaseId(self.instanceIdOf(func, value: addr))
			return (((baseId as StoreSlotKey) shl LetFieldSlotNameShift) or (offset as StoreSlotKey)) or LetFieldSlotInstanceBit
		end 'anInstance'

		return ((self.nameIdOf(func, value: addr) as StoreSlotKey) shl LetFieldSlotNameShift) or (offset as StoreSlotKey)
	end 'declaredSlotKeyOf'

	// May `value` BE a record a module-level `let` holds — as a binding root's record is asked of by its type, here
	// of a kind some `let` is or holds? The rank collapses every such record into one, so the kind is what tells
	// the `let`s' records from a record of another type read out of the same box.
	function valueMayBeAModuleLetsRecord(func IrFunction, value ValueId) returns bool
		if not self.setHasRank(ProvenanceColumn.identity, value: value, rank: self.moduleLetRank()) 'notOne'
			return false
		end 'notOne'

		let tag = valueTagOf(func, value: value)

		if tagIsOpaqueRecord(tag) 'anyRecord'
			return true
		end 'anyRecord'

		if tagIsByteRecord(tag) 'bytes'
			return self.moduleLetRecordKinds.mayHold(HeldByteRecordKind)
		end 'bytes'

		return self.moduleLetRecordKinds.mayHold(try self.heldRecordKindOf(func, value: value) otherwise return true)
	end 'valueMayBeAModuleLetsRecord'

	function traceIndirectCall(func IrFunction, op MaxonOp, opIdx ElementIndex)
		match op 'indirect'
			indirectCall(result, callee, args, _) then self.traceFunctionValueCall(func, op: op, opIdx: opIdx, result: result, callee: callee, args: args)
			default panic("ProvenanceTracer.traceIndirectCall: handed an op that is not an indirect call")
		end 'indirect'
	end 'traceIndirectCall'

	// ⭐ **A FUNCTION VALUE IS MINTED ONLY BY A `functionRef`** — a closure literal's lifted body, a named function
	// or a runtime entry referenced as a value — so a call through one lands on a body some `functionRef` named,
	// and answers as a witness dispatch does.
	//
	// ⚠ **WHAT A CLOSURE CAPTURED IS NOT IN ANY BODY'S SUMMARY.** Its captures sit in the function
	// value's own record, which the lifted body reads through, no record a summary ranks, and it
	// arrives as the call's last argument. A body may hand back a capture, or store one into an
	// argument — a capture is never written from source, so nothing is stored into one — and the
	// function value itself carries the same records.
	function functionValueBodiesThatCanCarry(func IrFunction, callee ValueId, args ValueIdArray, result ValueId) returns CallLandingBodies
		var resolution = self.calls.resolution
		var bodies = resolution.functionValueBodiesCalledThrough(func, callee: callee)

		if self.valueTagCarriesProvenance(func, value: result) 'theResultMayAlias'
			return bodies
		end 'theResultMayAlias'

		for i in 0 upto userArityOfIndirectCall(args) 'eachUserArg'
			if self.valueTagCarriesProvenance(func, value: try args.get(i) otherwise panic("ProvenanceTracer.functionValueBodiesThatCanCarry: args.get OOB at {i}")) 'anArgumentMayAlias'
				return bodies
			end 'anArgumentMayAlias'
		end 'eachUserArg'

		return resolution.closureBodiesOf(bodies)
	end 'functionValueBodiesThatCanCarry'

	function traceLandingCall(func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, args ValueIdArray, bodies CallLandingBodies)
		self.landingKeeps = self.calls.resolution.landingKeepsOf(func, op: op)
		dispatchLandingCall(self, func: func, op: op, opIdx: opIdx, result: result, args: args, bodies: bodies)

		match self.landingKeeps 'keeps'
			fromBodies then break
			declared(mask, _, _, _, _) then self.noteDeclaredKeeps(func, args: args, mask: mask)
		end 'keeps'

		self.landingKeeps = LandingKeeps.fromBodies
	end 'traceLandingCall'

	function noteDeclaredKeeps(func IrFunction, args ValueIdArray, mask ParamPositionMask)
		for (iter, arg) in args.withIterator() 'eachArg'
			if maskHasParam(mask, param: iter.index() as ParamCount) and self.isTracked(arg) 'declaredKept'
				self.noteKept(func, value: arg, holders: NoParamPositions, destination: KeepDestination.unknown, content: KeptContent.ofItsOwnType)
			end 'declaredKept'
		end 'eachArg'
	end 'noteDeclaredKeeps'

	function traceFunctionValueCall(func IrFunction, op MaxonOp, opIdx ElementIndex, result ValueId, callee ValueId, args ValueIdArray)
		self.traceLandingCall(func, op: op, opIdx: opIdx, result: result, args: args, bodies: self.functionValueBodiesThatCanCarry(func, callee: callee, args: args, result: result))

		let environment = try args.get(args.count() - 1) otherwise panic("ProvenanceTracer.traceFunctionValueCall: a call through a function value passes its environment last, so it has an argument")

		if self.calls.resolution.landingKeepsOf(func, op: op).declaredResult() == ResultCapability.unqualified and self.definesAnAlias(func, value: result) 'mayHandACaptureBack'
			self.flowFromWithin(result, from: environment)
			self.flowFromWithin(result, from: callee)
		end 'mayHandACaptureBack'

		for receiver in args 'eachReceiver'
			if receiver != environment and self.isTracked(receiver) 'mayReceiveACapture'
				self.unionContents(self.setOf(ProvenanceColumn.holds, value: receiver), source: environment)
				self.unionContents(self.setOf(ProvenanceColumn.holds, value: receiver), source: callee)
			end 'mayReceiveACapture'
		end 'eachReceiver'
	end 'traceFunctionValueCall'

	// A value this op defines that may share a record with another: tracked, and not a record the op minted.
	function definesAnAlias(func IrFunction, value ValueId) returns bool
		return self.isTracked(value) and not (try func.valueMintedSole.get(value) otherwise panic("ProvenanceTracer.definesAnAlias: valueMintedSole.get OOB at v{value}"))
	end 'definesAnAlias'

	// Anything reachable from any operand.
	function flowFromOperands(func IrFunction, op MaxonOp, result ValueId)
		if not self.definesAnAlias(func, value: result) 'fresh'
			return
		end 'fresh'

		maxonOpOperandValues(op, into: self.operands)

		for operand in self.operands 'eachOperand'
			self.flowFromWithin(result, from: operand)

			if mayBeOneRecord(valueTagOf(func, value: result), other: valueTagOf(func, value: operand)) 'mayBeTheOperand'
				self.unionMask(ProvenanceColumn.identity, to: result, from: ProvenanceColumn.identity, source: operand)
			end 'mayBeTheOperand'
		end 'eachOperand'
	end 'flowFromOperands'

	// ⭐ **A RETAIN, AN OWN, A CLONE HANDS BACK ITS OPERAND'S RECORD OR A COPY OF IT — NEVER A RECORD THE OPERAND
	// HOLDS, AND NEVER A RECORD WITHIN IT.** So what the result may BE is what the operand may be, what it lies within
	// is what the operand lies within, and what the operand holds the result holds — read as lying within the
	// operand, a retained parameter stored into a fresh record would make every field of that record a part of the
	// parameter, and a write to one a write of it:
	// `elements = newElements` retains the new array, which is not the old one it was filled from.
	function flowThroughBookkeeping(func IrFunction, op MaxonOp, result ValueId)
		if not self.definesAnAlias(func, value: result) 'fresh'
			return
		end 'fresh'

		maxonOpOperandValues(op, into: self.operands)

		for operand in self.operands 'eachOperand'
			self.unionShares(result, source: operand)
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.inside, source: operand)

			if mayBeOneRecord(valueTagOf(func, value: result), other: valueTagOf(func, value: operand)) 'mayBeTheOperand'
				self.unionMask(ProvenanceColumn.identity, to: result, from: ProvenanceColumn.identity, source: operand)
			end 'mayBeTheOperand'

			if not self.readsParameterStorage(operand) 'whatItHolds'
				self.unionContents(self.setOf(ProvenanceColumn.holds, value: result), source: operand)
				self.unionMaskWithoutLetFields(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.holdsWithin, source: operand)
				self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: operand)
			end 'whatItHolds'
		end 'eachOperand'
	end 'flowThroughBookkeeping'

	// `result` was read out of `addr` at `offset`: a record `addr` holds there, lying within it.
	function traceLoad(func IrFunction, result ValueId, addr ValueId, offset ByteOffset)
		if not self.definesAnAlias(func, value: result) 'fresh'
			return
		end 'fresh'

		self.unionShares(result, source: addr)
		self.unionInsideOfIdentity(result, source: addr, reach: TupleColumnReach.columnAt(offset))
		self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.inside, source: addr)

		match self.letSlotKindMemoized(func, addr: addr, offset: offset, held: result) 'slotKind'
			field then self.seedLetSlotRead(result, rank: self.letFieldRank())
			payload then self.seedLetSlotRead(result, rank: self.letPayloadRank())
			none then break
		end 'slotKind'

		let key = storeSlotKey(addr, offset: offset)

		if not self.readsParameterStorage(addr) 'whatTheRecordHolds'
			self.unionMaskWithoutLetFields(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.holdsWithin, source: addr)
			self.unionMaskWithoutLetFields(ProvenanceColumn.identity, to: result, from: ProvenanceColumn.holds, source: addr)
			self.unionMask(ProvenanceColumn.holds, to: result, from: ProvenanceColumn.holds, source: addr)
			self.unionMask(ProvenanceColumn.holds, to: result, from: ProvenanceColumn.deepHolds, source: addr)
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: addr)
			try self.hasLoadOrigin.set(result, value: true) otherwise panic("ProvenanceTracer.traceLoad: hasLoadOrigin.set OOB at v{result}")
			try self.loadOrigins.set(result, value: key) otherwise panic("ProvenanceTracer.traceLoad: loadOrigins.set OOB at v{result}")
		end 'whatTheRecordHolds'

		if let stored = try self.storeSlots.setAt(key) 'storedInto'
			self.unionInto(self.setOf(ProvenanceColumn.identity, value: result), from: stored)
		end 'storedInto'

		if let storedInside = try self.deepSlots.setAt(key) 'storedInsideIt'
			self.unionInto(self.setOf(ProvenanceColumn.holds, value: result), from: storedInside)
		end 'storedInsideIt'
	end 'traceLoad'

	// The tuple and column ranks stay on identity: in `inside` they would make every element and field
	// below the tuple read as read-only, refusing a store into a writable column.
	function unionInsideOfIdentity(to ValueId, source ValueId, reach TupleColumnReach)
		if self.sets.unionWithoutRanks(self.setOf(ProvenanceColumn.inside, value: to), from: self.setOf(ProvenanceColumn.identity, value: source), firstSkipped: self.tupleLetFieldRank(), skippedCount: TupleMarkRankCount) 'grew'
			self.changed = true
		end 'grew'

		if self.valueMarksSomeTupleColumn(source) and not self.tupleColumnsMissReach(source, reach: reach) 'aColumnThatMayBeReadOnly'
			self.markFromTupleKinds(to, tuple: source)
		end 'aColumnThatMayBeReadOnly'
	end 'unionInsideOfIdentity'

	function valueIsReadOnlyOfKind(value ValueId, kind ElementIndex) returns bool
		return self.valueIsOrLiesWithin(value, rank: self.letFieldRank() + kind) or self.valueIsOrLiesWithin(value, rank: self.maybeLetFieldRank() + kind) or self.setHasRank(ProvenanceColumn.identity, value: value, rank: self.tupleLetFieldRank() + kind)
	end 'valueIsReadOnlyOfKind'

	function valueMayBeReadOnly(value ValueId) returns bool
		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			if self.valueIsReadOnlyOfKind(value, kind: kind) 'readOnly'
				return true
			end 'readOnly'
		end 'eachSlotKind'

		return false
	end 'valueMayBeReadOnly'

	function valueMarksSomeTupleColumn(value ValueId) returns bool
		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			if self.setHasRank(ProvenanceColumn.identity, value: value, rank: self.tupleLetFieldRank() + kind) 'marked'
				return true
			end 'marked'
		end 'eachSlotKind'

		return false
	end 'valueMarksSomeTupleColumn'

	function markTupleColumn(tuple ValueId, offset ByteOffset, from ValueId)
		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			if self.valueIsReadOnlyOfKind(from, kind: kind) 'readOnly'
				self.seedBit(ProvenanceColumn.identity, value: tuple, rank: self.tupleLetFieldRank() + kind)
				self.seedBit(ProvenanceColumn.identity, value: tuple, rank: self.tupleColumnRank(self.tupleColumnOfOffset(offset)))
			end 'readOnly'
		end 'eachSlotKind'
	end 'markTupleColumn'

	function tupleColumnsAreRecorded(tuple ValueId) returns bool
		for column in 0 upto TupleColumnMarkCount 'eachColumn'
			if self.setHasRank(ProvenanceColumn.identity, value: tuple, rank: self.tupleColumnRank(column)) 'recorded'
				return true
			end 'recorded'
		end 'eachColumn'

		return false
	end 'tupleColumnsAreRecorded'

	function tupleColumnsMissReach(tuple ValueId, reach TupleColumnReach) returns bool
		return match reach 'reach'
			anyColumn gives false
			columnAt(offset) gives self.tupleColumnsAreRecorded(tuple) and not self.setHasRank(ProvenanceColumn.identity, value: tuple, rank: self.tupleColumnRank(self.tupleColumnOfOffset(offset)))
		end 'reach'
	end 'tupleColumnsMissReach'

	function markFromTupleKinds(result ValueId, tuple ValueId)
		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			if self.setHasRank(ProvenanceColumn.identity, value: tuple, rank: self.tupleLetFieldRank() + kind) 'aKindThisTupleHolds'
				self.seedBit(ProvenanceColumn.identity, value: result, rank: self.maybeLetFieldRank() + kind)
			end 'aKindThisTupleHolds'
		end 'eachSlotKind'
	end 'markFromTupleKinds'

	function valueIsATuple(func IrFunction, value ValueId) returns bool
		if valueTagOf(func, value: value) != ValueTypeTag.structRef 'notATupleRecord'
			return false
		end 'notATupleRecord'

		return isTupleTypeName(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise panic("ProvenanceTracer.valueIsATuple: the structRef v{value} names a type the interner never assigned"))
	end 'valueIsATuple'

	// `value` now lies within `addr`, in the field `offset` names.
	function traceStore(func IrFunction, addr ValueId, offset ByteOffset, value ValueId)
		if not self.isTracked(value) 'storesNoRecord'
			return
		end 'storesNoRecord'

		// A tuple has no `let` slots, so a load out of it drops the read-only ranks of what it holds
		// (`unionMaskWithoutLetFields`). The tuple's identity keeps the kinds it holds and the columns
		// holding them, which a call result inherits; a load takes "may be read-only" from a marked column
		// (`unionInsideOfIdentity`).
		if self.valueMayBeReadOnly(value) and self.valueIsATuple(func, value: addr) 'aTupleIsAsReadOnlyAsWhatItHolds'
			self.markTupleColumn(addr, offset: offset, from: value)
		end 'aTupleIsAsReadOnlyAsWhatItHolds'

		let slotKind = LetSlotKind.none if self.tracingImmutableBindings else self.letSlotKindMemoized(func, addr: addr, offset: offset, held: value)
		let keptReadOnly = slotKind != LetSlotKind.none

		if keptReadOnly and not self.valueGivesAStoreNoWriter(func, value: value) 'keptInALetSlot'
			let keptValue = self.parametersAValueMayBe(func, value: value)

			match slotKind 'slotKind'
				field then self.returnedLetKeeps = self.returnedLetKeeps or keptValue
				payload then self.returnedPayloadKeeps = self.returnedPayloadKeeps or keptValue
				none then panic("ProvenanceTracer.traceStore: a slot kept read-only has a kind")
			end 'slotKind'
		end 'keptInALetSlot'

		let key = storeSlotKey(addr, offset: offset)
		self.unionInto(self.slotIn(self.storeSlots, key: key), from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(self.slotIn(self.deepSlots, key: key), source: value)

		if not keptReadOnly 'aWritableSlot'
			self.noteKeptUnlessViewed(func, value: value, addr: addr, content: KeptContent.ofItsOwnType)
			self.unionMask(ProvenanceColumn.storedHolds, to: addr, from: ProvenanceColumn.identity, source: value)
			self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: addr), source: value)
		end 'aWritableSlot'

		self.unionOverlap(addr, value: value, intoAWritableSlot: not keptReadOnly)
		self.recordWhereValueLies(func, addr: addr, value: value, intoAWritableSlot: not keptReadOnly)
	end 'traceStore'

	function slotIsALetPayload(func IrFunction, box ValueId, offset ByteOffset, held ValueId) returns bool
		view kinds = self.letPayloadKindsAt(func, box: box, offset: offset)

		if kinds.holdsNothing() 'noLetPayloadHere'
			return false
		end 'noLetPayloadHere'

		if kinds.anything 'anOpaqueLetPayload'
			return true
		end 'anOpaqueLetPayload'

		if tagIsByteRecord(valueTagOf(func, value: held)) 'aByteRecord'
			return kinds.mayHold(HeldByteRecordKind)
		end 'aByteRecord'

		return kinds.mayHold(try self.heldRecordKindOf(func, value: held) otherwise return true)
	end 'slotIsALetPayload'

	function letPayloadKindsAt(func IrFunction, box ValueId, offset ByteOffset) returns HeldRecordKinds
		let key = ((self.nameIdOf(func, value: box) as StoreSlotKey) shl LetFieldSlotNameShift) or (offset as StoreSlotKey)

		if let known = try self.letPayloadKinds.get(key) 'asked'
			return known
		end 'asked'

		let unionName = try self.project.typeNames.nameOf(self.nameIdOf(func, value: box)) otherwise return self.noRecordKinds
		var kinds = self.signatures.letPayloadKindsAt(unionName, offset: offset)
		self.letPayloadKinds.upsert(key, value: kinds)
		return kinds
	end 'letPayloadKindsAt'

	function slotIsALetField(func IrFunction, addr ValueId, offset ByteOffset) returns bool
		let tag = valueTagOf(func, value: addr)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			let id = self.instanceIdOf(func, value: addr)
			return self.signatures.genericInstanceHasBaseLayout(id) and self.signatures.instanceFieldAtOffsetIsALet(id, offset: offset)
		end 'anInstance'

		if not tagNamesADeclaredType(tag) 'notADeclaredRecord'
			return false
		end 'notADeclaredRecord'

		let name = try self.project.typeNames.nameOf(self.nameIdOf(func, value: addr)) otherwise return false
		return self.signatures.fieldAtOffsetIsALet(name, offset: offset)
	end 'slotIsALetField'

	// `value` now lies within `addr` — in a field no load can name, a store a call made, or deeper still.
	function traceWholeStore(func IrFunction, addr ValueId, value ValueId, deep bool, content KeptContent)
		if not self.isTracked(value) 'storesNoRecord'
			return
		end 'storesNoRecord'

		self.noteKeptUnlessViewed(func, value: value, addr: addr, content: content)

		let contents = self.setOf(ProvenanceColumn.deepHolds, value: addr)
		self.unionInto(contents if deep else self.setOf(ProvenanceColumn.holds, value: addr), from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(contents, source: value)
		self.unionOverlap(addr, value: value, intoAWritableSlot: true)
		self.recordWhereValueLies(func, addr: addr, value: value, intoAWritableSlot: true)
	end 'traceWholeStore'

	// An append that shares its source's elements: what lies within `source` comes to lie within `addr`'s
	// records, and in every root that encloses them.
	function traceSharedElements(func IrFunction, addr ValueId, source ValueId)
		if not self.isTracked(source) 'sharesNoRecord'
			return
		end 'sharesNoRecord'

		self.noteKeptUnlessViewed(func, value: source, addr: addr, content: KeptContent.ofItsOwnType)

		self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: addr), source: source)
		self.unionMask(ProvenanceColumn.holdsWithin, to: addr, from: ProvenanceColumn.holdsWithin, source: source)
		self.storeElementsIntoRootsOf(ProvenanceColumn.identity, addr: addr, source: source)
		self.storeElementsIntoRootsOf(ProvenanceColumn.inside, addr: addr, source: source)
		self.storeElementsIntoRootsOf(ProvenanceColumn.placedWithin, addr: addr, source: source)
	end 'traceSharedElements'

	function storeElementsIntoRootsOf(enclosing ProvenanceColumn, addr ValueId, source ValueId)
		if var chunk = try self.sets.first(self.setOf(enclosing, value: addr)) 'hasWords'
			while true 'eachWord'
				let mask = self.sets.wordOf(chunk)
				let firstRank = (self.sets.indexOf(chunk)) shl RootWordShift

				for bit in 0 upto RootBitIndexMask + 1 'eachBit'
					if maskHasParam(mask, param: bit as ParamCount) 'enclosedByThisRoot'
						self.storeElementsIntoRoot(firstRank + bit, addr: addr, source: source)
					end 'enclosedByThisRoot'
				end 'eachBit'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'
	end 'storeElementsIntoRootsOf'

	function storeElementsIntoRoot(rank ElementIndex, addr ValueId, source ValueId)
		if rank == self.writableRank 'writableStorage'
			self.unionContents(self.escapedSet, source: source)
			self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.holdsWithin, value: source))
			return
		end 'writableStorage'

		if self.isPermanentViewRank(rank) or self.rootValueAt(rank) == addr 'notAnotherRootsRecord'
			return
		end 'notAnotherRootsRecord'

		let deep = self.setOf(ProvenanceColumn.storedDeep, value: self.rootValueAt(rank))
		self.unionContents(deep, source: source)
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.holdsWithin, value: source))
	end 'storeElementsIntoRoot'

	// What `addr` holds besides the stored record itself: the part of `value` that lies within something, and
	// the overlap. A record a load yielded is where the next load of the same field looks too.
	function unionOverlap(addr ValueId, value ValueId, intoAWritableSlot bool)
		if intoAWritableSlot 'writableContents'
			self.unionContainedParts(addr, source: value)
		end 'writableContents'

		self.unionMask(ProvenanceColumn.shares, to: addr, from: ProvenanceColumn.shares, source: value)

		let loaded = try self.hasLoadOrigin.get(addr) otherwise panic("ProvenanceTracer.unionOverlap: hasLoadOrigin.get OOB at v{addr}")

		if loaded 'aLoadedRecord'
			let deep = self.slotIn(self.deepSlots, key: try self.loadOrigins.get(addr) otherwise panic("ProvenanceTracer.unionOverlap: loadOrigins.get OOB at v{addr}"))
			self.unionInto(deep, from: self.setOf(ProvenanceColumn.identity, value: value))
			self.unionContents(deep, source: value)
		end 'aLoadedRecord'
	end 'unionOverlap'

	// `to` gains every record `source` contains, at whatever depth, that a read of it could reach.
	function unionContents(to ElementIndex, source ValueId)
		self.unionInto(to, from: self.setOf(ProvenanceColumn.holds, value: source))
		self.unionInto(to, from: self.setOf(ProvenanceColumn.storedHolds, value: source))
		self.unionInto(to, from: self.setOf(ProvenanceColumn.deepHolds, value: source))
	end 'unionContents'

	// What every store owes whichever field it went into: where `value` now lies, and every root `addr` is or
	// lies within, whose own value is where a read through another name of that root looks.
	function recordWhereValueLies(func IrFunction, addr ValueId, value ValueId, intoAWritableSlot bool)
		if valueTagOf(func, value: value) != ValueTypeTag.function 'aFunctionValueIsAValue'
			self.unionMask(ProvenanceColumn.placedWithin, to: value, from: ProvenanceColumn.identity, source: addr)
			self.unionMask(ProvenanceColumn.placedWithin, to: value, from: ProvenanceColumn.inside, source: addr)
			self.unionMask(ProvenanceColumn.placedWithin, to: value, from: ProvenanceColumn.placedWithin, source: addr)
		end 'aFunctionValueIsAValue'

		self.unionMask(ProvenanceColumn.shares, to: value, from: ProvenanceColumn.identity, source: addr)
		self.unionMask(ProvenanceColumn.shares, to: value, from: ProvenanceColumn.inside, source: addr)

		if intoAWritableSlot 'rootsHoldIt'
			self.storeIntoEnclosingRoots(addr, value: value)
		end 'rootsHoldIt'
	end 'recordWhereValueLies'

	// Every root `addr` is or lies within now holds `value` — a root that is `value` itself widens what the roots
	// read through it hold, which the walk's fixpoint settles in whatever order the sets grow. Writable storage
	// past the parameters has no root value of its own; what a parameter trace stores there — module storage —
	// is its `escapes`.
	//
	// ⭐ **HOW DEEP THE STORE WENT DECIDES WHICH SET THE ROOT GAINS.** A store into another name for the root's
	// own record put `value` in one of its fields, which a load of the root may yield (`holds`). A store into a
	// record lying WITHIN the root reached it through that record, whose own sets and deep slot already say
	// so to a read along the same path; the root files it only for the summary (`storedDeep`). Were a read of
	// the root to see it, a body's LATER `self.keys.set(k, …)` would make an EARLIER call result drawn from
	// `self` contain `k`, and every field read out of that `k` — one set per value serves the whole body. The
	// root's own value needs neither for a store through it: the store already filed it on that value.
	function storeIntoEnclosingRoots(addr ValueId, value ValueId)
		self.storeIntoRootsOf(ProvenanceColumn.identity, addr: addr, value: value)
		self.storeIntoRootsOf(ProvenanceColumn.inside, addr: addr, value: value)
		self.storeIntoRootsOf(ProvenanceColumn.placedWithin, addr: addr, value: value)
	end 'storeIntoEnclosingRoots'

	// Every root in `addr`'s set in `enclosing`: a field of it when `addr` is that root's record, deeper otherwise.
	function storeIntoRootsOf(enclosing ProvenanceColumn, addr ValueId, value ValueId)
		let intoAField = enclosing == ProvenanceColumn.identity

		if var chunk = try self.sets.first(self.setOf(enclosing, value: addr)) 'hasWords'
			while true 'eachWord'
				let mask = self.sets.wordOf(chunk)
				let firstRank = (self.sets.indexOf(chunk)) shl RootWordShift

				for bit in 0 upto RootBitIndexMask + 1 'eachBit'
					if maskHasParam(mask, param: bit as ParamCount) 'enclosedByThisRoot'
						self.storeIntoRoot(firstRank + bit, addr: addr, value: value, intoAField: intoAField)
					end 'enclosedByThisRoot'
				end 'eachBit'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'
	end 'storeIntoRootsOf'

	function storeIntoRoot(rank ElementIndex, addr ValueId, value ValueId, intoAField bool)
		if rank == self.writableRank 'writableStorage'
			self.storeIntoEscapedSet(value)
			return
		end 'writableStorage'

		// A store into a `let`'s record reaches no parameter's, and the summary's `moduleLets` is about the result.
		if self.isPermanentViewRank(rank) 'moduleLetStorage'
			return
		end 'moduleLetStorage'

		let root = self.rootValueAt(rank)

		if root == addr 'storedThroughTheRootItself'
			return
		end 'storedThroughTheRootItself'

		self.unionMask(ProvenanceColumn.shares, to: root, from: ProvenanceColumn.shares, source: value)

		if intoAField 'aFieldOfThisRoot'
			self.unionMask(ProvenanceColumn.holds, to: root, from: ProvenanceColumn.identity, source: value)
			self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: root), source: value)
			self.unionContainedParts(root, source: value)
			return
		end 'aFieldOfThisRoot'

		let deep = self.setOf(ProvenanceColumn.storedDeep, value: root)
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(deep, source: value)
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.inside, value: value))
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.placedWithin, value: value))
		self.unionInto(deep, from: self.setOf(ProvenanceColumn.holdsWithin, value: value))
	end 'storeIntoRoot'

	function storeIntoEscapedSet(value ValueId)
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.identity, value: value))
		self.unionContents(self.escapedSet, source: value)
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.storedDeep, value: value))
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.inside, value: value))
		self.unionInto(self.escapedSet, from: self.setOf(ProvenanceColumn.holdsWithin, value: value))
	end 'storeIntoEscapedSet'

	// ⭐ **A RECORD A RUNTIME ENTRY HANDS BACK MAY BE THE ONE IT WAS HANDED** — a retain, an own — so where the
	// result is put, that one is: a body that pushes `__mm_own(block)` and returns `block` returns a record its
	// container holds. Placement and overlap flow back from result to operand, and the walk's fixpoint carries a
	// store made after the call.
	function placeWhatTheResultMayBe(func IrFunction, result ValueId, args ValueIdArray, shape RuntimeStoreShape)
		if shape != RuntimeStoreShape.nothing or not self.isTracked(result) 'notAHandBack'
			return
		end 'notAHandBack'

		for operand in args 'eachOperand'
			if self.isTracked(operand) and self.valuesMayBeOneRecord(func, value: result, other: operand) 'mayBeIt'
				self.unionMask(ProvenanceColumn.placedWithin, to: operand, from: ProvenanceColumn.placedWithin, source: result)
				self.unionMask(ProvenanceColumn.shares, to: operand, from: ProvenanceColumn.shares, source: result)
			end 'mayBeIt'
		end 'eachOperand'
	end 'placeWhatTheResultMayBe'

	// ⭐ **A PARAMETER HANDED ON TO A CALLEE THAT BINDS IT TO A MUTABLE NAME IS BOUND BY THIS BODY TOO** — the
	// `binds` column's transitive half; the direct half is `gatherStores`' name-bind sites. Only a parameter
	// trace ranks what a summary means.
	function bindThroughSummary(calleeIndex ElementIndex, args ValueIdArray, except ParamPositionMask)
		let binds = self.summary.bindsAt(calleeIndex)

		if self.tracingImmutableBindings or binds == NoParamPositions 'bindsNothingOfOurs'
			return
		end 'bindsNothingOfOurs'

		for i in 0 upto args.count() 'eachArg'
			let pos = try self.calls.argPositionAt(i as ParamCount) otherwise continue

			if maskHasParam(binds, param: pos) and not maskHasParam(except, param: pos) 'boundByTheCallee'
				let bound = self.wordAt(ProvenanceColumn.identity, value: try args.get(i) otherwise panic("ProvenanceTracer.bindThroughSummary: args.get OOB at {i}"), word: 0)
				self.returnedBinds = self.returnedBinds or bound

				if maskHasParam(self.summary.recordKeepsAt(calleeIndex), param: pos) 'aRecordOfItsOwn'
					self.returnedRecordKeeps = self.returnedRecordKeeps or bound
				end 'aRecordOfItsOwn'
			end 'boundByTheCallee'
		end 'eachArg'
	end 'bindThroughSummary'

	function keptByBodies(calleeIndex ElementIndex) returns ParamPositionMask
		return match self.landingKeeps 'keeps'
			fromBodies gives self.summary.keepsAt(calleeIndex)
			declared gives NoParamPositions
		end 'keeps'
	end 'keptByBodies'

	function varHoldsAViewOfItsSource(func IrFunction, rank ElementIndex) returns bool
		return rank < self.writableRank and self.recordIsAViewOfItsSource(func, record: self.rootValueAt(rank))
	end 'varHoldsAViewOfItsSource'

	function noteKeptUnlessViewed(func IrFunction, value ValueId, addr ValueId, content KeptContent)
		if not self.recordIsAViewOfItsSource(func, record: addr) 'anIteratorHoldsNoKeep'
			self.noteKept(func, value: value, holders: self.parametersAValueIsOrLiesWithin(func, value: addr), destination: KeepDestination.within(addr), content: content)
		end 'anIteratorHoldsNoKeep'
	end 'noteKeptUnlessViewed'

	function recordIsAViewOfItsSource(func IrFunction, record ValueId) returns bool
		let tag = valueTagOf(func, value: record)

		if tag != ValueTypeTag.genericInstance and not self.signatures.tagMayNameAggregate(tag) 'notADeclaredType'
			return false
		end 'notADeclaredType'

		return self.signatures.typeImplementsInterface(self.baseNameOfInstanceOrDeclaration(func, value: record), interfaceName: IteratorInterfaceName)
	end 'recordIsAViewOfItsSource'

	function noteKept(func IrFunction, value ValueId, holders ParamPositionMask, destination KeepDestination, content KeptContent)
		if self.tracingImmutableBindings 'aBindingsTrace'
			if not self.valueIsAFreshTemporary(func, value: value) 'namedOrSharedElsewhere'
				self.seedBit(ProvenanceColumn.placedWithin, value: value, rank: self.writableRank)
			end 'namedOrSharedElsewhere'

			return
		end 'aBindingsTrace'

		match destination 'destination'
			unknown then self.keepWhereverItLands(func, value: value, holders: holders, content: content)
			within(record) then self.pendingKeeps.push(PendingKeep.create(value, holders: holders, destination: self.recordHoldingAt(func, address: record), content: content))
		end 'destination'
	end 'noteKept'

	function keepWhereverItLands(func IrFunction, value ValueId, holders ParamPositionMask, content KeptContent)
		self.markKeptEscape(func, value: value)
		self.addKept(func, value: value, holders: holders, elsewhere: true, content: content)
	end 'keepWhereverItLands'

	function addKept(func IrFunction, value ValueId, holders ParamPositionMask, elsewhere bool, content KeptContent)
		// A value nothing can write gives a holder nothing to write, so it is no keep — the rule
		// `callersOwnNoWriterOrDeferred` applies at the caller — and E3189 never sees it either.
		if self.permanentViewOf(value) != PermanentView.none or self.valueGivesAStoreNoWriter(func, value: value) 'storedWhereItIsRefusedAnyway'
			return
		end 'storedWhereItIsRefusedAnyway'

		let kept = self.parametersAValueIsOrLiesWithin(func, value: value)
		let mask = kept xor (kept and holders)
		self.returnedKeeps = self.returnedKeeps or mask

		if content == KeptContent.ofItsOwnType and not self.valueIsBuiltOnATypeParameter(func, value: value) 'aRecordOfItsOwn'
			self.returnedRecordKeeps = self.returnedRecordKeeps or mask
		end 'aRecordOfItsOwn'

		if elsewhere 'outlivesTheResult'
			self.returnedOtherKeeps = self.returnedOtherKeeps or mask
		end 'outlivesTheResult'
	end 'addKept'

	function recordHoldingAt(func IrFunction, address ValueId) returns ValueId
		var steps = self.pathSteps
		steps.clear()
		return self.accessPathOf(func, ir: self.module, value: address, into: steps)
	end 'recordHoldingAt'

	function markKeptEscape(func IrFunction, value ValueId)
		self.markRecordKeptEscape(self.recordHoldingAt(func, address: value))
	end 'markKeptEscape'

	function markRecordKeptEscape(record ValueId)
		try self.keptEscapes.set(record, value: true) otherwise panic("ProvenanceTracer.markRecordKeptEscape: keptEscapes.set OOB at v{record}")

		if self.isAMerge(record) 'itsOriginsAreUnknown'
			self.keptEverythingEscapes = true
		end 'itsOriginsAreUnknown'
	end 'markRecordKeptEscape'

	function keptMarkOf(mark KeptMark, record ValueId) returns bool
		return match mark 'mark'
			escapes gives try self.keptEscapes.get(record) otherwise panic("ProvenanceTracer.keptMarkOf: keptEscapes.get OOB at v{record}")
			returned gives try self.keptReturned.get(record) otherwise panic("ProvenanceTracer.keptMarkOf: keptReturned.get OOB at v{record}")
		end 'mark'
	end 'keptMarkOf'

	function setKeptMark(mark KeptMark, record ValueId)
		match mark 'mark'
			escapes then self.markRecordKeptEscape(record)
			returned then try self.keptReturned.set(record, value: true) otherwise panic("ProvenanceTracer.setKeptMark: keptReturned.set OOB at v{record}")
		end 'mark'
	end 'setKeptMark'

	function carryKeptMark(mark KeptMark, records ValueIdArray, starts EntryIndexArray, byDestination EntryIndexArray)
		var worklist = ValueIdArray.create()

		for destination in 0 upto starts.count() - 1 'eachDestination'
			let first = try starts.get(destination) otherwise panic("ProvenanceTracer.carryKeptMark: starts.get OOB at {destination}")
			let past = try starts.get(destination + 1) otherwise panic("ProvenanceTracer.carryKeptMark: starts.get OOB at {destination + 1}")

			if first < past and self.keptMarkOf(mark, record: destination as ValueId) 'storedIntoAMarkedPlace'
				worklist.push(destination as ValueId)
			end 'storedIntoAMarkedPlace'
		end 'eachDestination'

		while worklist.count() > 0 'eachMarkedPlace'
			let destination = try worklist.pop() otherwise panic("ProvenanceTracer.carryKeptMark: worklist.pop on a non-empty worklist")
			let first = try starts.get(destination) otherwise panic("ProvenanceTracer.carryKeptMark: starts.get OOB at v{destination}")
			let past = try starts.get(destination + 1) otherwise panic("ProvenanceTracer.carryKeptMark: starts.get OOB at v{destination + 1}")

			for slot in first upto past 'eachStoreIntoIt'
				let store = try byDestination.get(slot) otherwise panic("ProvenanceTracer.carryKeptMark: byDestination.get OOB at {slot}")
				let record = try records.get(store) otherwise panic("ProvenanceTracer.carryKeptMark: records.get OOB at {store}")

				if not self.keptMarkOf(mark, record: record) 'newlyMarked'
					self.setKeptMark(mark, record: record)
					worklist.push(record)
				end 'newlyMarked'
			end 'eachStoreIntoIt'
		end 'eachMarkedPlace'
	end 'carryKeptMark'

	function settleKeeps(func IrFunction)
		if self.tracingImmutableBindings or self.pendingKeeps.count() == 0 'nothingDeferred'
			return
		end 'nothingDeferred'

		self.indexDefinitions(func, ir: self.module)

		for returned in self.returnedValues 'eachReturned'
			try self.keptReturned.set(self.recordHoldingAt(func, address: returned), value: true) otherwise panic("ProvenanceTracer.settleKeeps: keptReturned.set OOB at v{returned}")
		end 'eachReturned'

		for pending in self.pendingKeeps 'eachSeed'
			if pending.holders != NoParamPositions or self.setHasRank(ProvenanceColumn.identity, value: pending.destination, rank: self.writableRank) or self.setHasRank(ProvenanceColumn.inside, value: pending.destination, rank: self.writableRank) 'placedWhereTheCallOutlives'
				self.markKeptEscape(func, value: pending.value)
			end 'placedWhereTheCallOutlives'
		end 'eachSeed'

		let valueCount = func.valueTags.count()
		var records = ValueIdArray.create()
		var starts = EntryIndexArray.create()
		starts.refill(valueCount + 1, value: 0)

		for pending in self.pendingKeeps 'eachStoreRecord'
			records.push(self.recordHoldingAt(func, address: pending.value))
			let after = pending.destination + 1
			try starts.set(after, value: (try starts.get(after) otherwise panic("ProvenanceTracer.settleKeeps: starts.get OOB at {after}")) + 1) otherwise panic("ProvenanceTracer.settleKeeps: starts.set OOB at {after}")
		end 'eachStoreRecord'

		for value in 0 upto valueCount 'eachRunningTotal'
			let next = value + 1
			try starts.set(next, value: (try starts.get(next) otherwise panic("ProvenanceTracer.settleKeeps: starts.get OOB at {next}")) + (try starts.get(value) otherwise panic("ProvenanceTracer.settleKeeps: starts.get OOB at {value}"))) otherwise panic("ProvenanceTracer.settleKeeps: starts.set OOB at {next}")
		end 'eachRunningTotal'

		var filled = starts.clone()
		var byDestination = EntryIndexArray.create()
		byDestination.refill(self.pendingKeeps.count(), value: 0)

		for (iter, pending) in self.pendingKeeps.withIterator() 'eachStoreByDestination'
			let slot = try filled.get(pending.destination) otherwise panic("ProvenanceTracer.settleKeeps: filled.get OOB at v{pending.destination}")
			try byDestination.set(slot, value: iter.index()) otherwise panic("ProvenanceTracer.settleKeeps: byDestination.set OOB at {slot}")
			try filled.set(pending.destination, value: slot + 1) otherwise panic("ProvenanceTracer.settleKeeps: filled.set OOB at v{pending.destination}")
		end 'eachStoreByDestination'

		self.carryKeptMark(KeptMark.escapes, records: records, starts: starts, byDestination: byDestination)
		self.carryKeptMark(KeptMark.returned, records: records, starts: starts, byDestination: byDestination)

		for pending in self.pendingKeeps 'eachKeep'
			if self.keptEverythingEscapes or self.keptMarkOf(KeptMark.escapes, record: pending.destination) or self.isAMerge(pending.destination) 'outlivesTheCall'
				self.addKept(func, value: pending.value, holders: pending.holders, elsewhere: true, content: pending.content)
			end 'outlivesTheCall' else if self.keptMarkOf(KeptMark.returned, record: pending.destination) 'handedBackInTheResult'
				self.addKept(func, value: pending.value, holders: pending.holders, elsewhere: false, content: pending.content)
			end 'handedBackInTheResult' else if valueTagOf(func, value: pending.destination) != ValueTypeTag.function and not (try self.isImmutableBindingValue.get(pending.destination) otherwise false) 'aMutablePlaceOfItsOwn'
				self.addKept(func, value: pending.value, holders: pending.holders, elsewhere: true, content: pending.content)
			end 'aMutablePlaceOfItsOwn'
		end 'eachKeep'
	end 'settleKeeps'

	function valueWasMintedSole(func IrFunction, value ValueId) returns bool
		return try func.valueMintedSole.get(value) otherwise panic("ProvenanceTracer.valueWasMintedSole: valueMintedSole.get OOB at v{value} — `begin` proved the column is one entry per value")
	end 'valueWasMintedSole'

	function valueIsAFreshTemporary(func IrFunction, value ValueId) returns bool
		self.indexDefinitions(func, ir: self.module)
		let record = self.sameRecordBase(func, ir: self.module, value: value)

		if record < valueIdAtParamPosition(func.paramCount) or self.bindsAName(record) 'aParameterOrANamedValue'
			return false
		end 'aParameterOrANamedValue'

		return self.recordIsMintedHere(func, base: record, usesFreshReturns: true)
	end 'valueIsAFreshTemporary'

	function valueIsANamedRoot(value ValueId) returns bool
		let own = try self.bindingRankOf(value) otherwise return false
		return self.rootIsAKeptName(own)
	end 'valueIsANamedRoot'

	function bindsAName(value ValueId) returns bool
		try self.bindingRankOf(value) otherwise return self.hasWritableRank(value)
		return true
	end 'bindsAName'

	function parametersAValueIsOrLiesWithin(func IrFunction, value ValueId) returns ParamPositionMask
		var may = self.parametersAValueMayBe(func, value: value)
		let within = self.wordAt(ProvenanceColumn.inside, value: value, word: 0)

		for position in 0 upto func.paramCount 'eachParameter'
			if maskHasParam(within, param: position) and self.kindsMayHoldValue(func, kinds: try self.rootRecordKinds.get(position) otherwise panic("ProvenanceTracer.parametersAValueIsOrLiesWithin: rootRecordKinds.get OOB at {position} — a parameter trace ranks every parameter"), value: value) 'liesWithinIt'
				may = maskWithParam(may, param: position)
			end 'liesWithinIt'
		end 'eachParameter'

		return may
	end 'parametersAValueIsOrLiesWithin'

	function parametersAValueMayBe(func IrFunction, value ValueId) returns ParamPositionMask
		let candidates = self.wordAt(ProvenanceColumn.identity, value: value, word: 0)
		var may = NoParamPositions

		for position in 0 upto func.paramCount 'eachParameter'
			if maskHasParam(candidates, param: position) and self.valuesMayBeOneRecord(func, value: value, other: valueIdAtParamPosition(position)) 'mayBeIt'
				may = maskWithParam(may, param: position)
			end 'mayBeIt'
		end 'eachParameter'

		return may
	end 'parametersAValueMayBe'

	function keepThroughSummary(func IrFunction, calleeIndex ElementIndex, args ValueIdArray, inElements ParamPositionMask)
		let inFields = self.summary.letKeepsAt(calleeIndex)
		let inPayloads = self.summary.payloadKeepsAt(calleeIndex)
		let elements = self.summary.elementKeepsAt(calleeIndex) or inElements

		if self.tracingImmutableBindings or (inFields or inPayloads or elements) == NoParamPositions 'keepsNothingReadOnly'
			return
		end 'keepsNothingReadOnly'

		for i in 0 upto args.count() 'eachArg'
			let pos = try self.calls.argPositionAt(i as ParamCount) otherwise continue

			if not (maskHasParam(inFields, param: pos) or maskHasParam(inPayloads, param: pos) or maskHasParam(elements, param: pos)) 'keptNowhereReadOnly'
				continue
			end 'keptNowhereReadOnly'

			let passed = self.parametersAValueMayBe(func, value: try args.get(i) otherwise panic("ProvenanceTracer.keepThroughSummary: args.get OOB at {i}"))

			if maskHasParam(inFields, param: pos) 'keptInALetField'
				self.returnedLetKeeps = self.returnedLetKeeps or passed
			end 'keptInALetField'

			if maskHasParam(inPayloads, param: pos) 'keptInALetPayload'
				self.returnedPayloadKeeps = self.returnedPayloadKeeps or passed
			end 'keptInALetPayload'

			if maskHasParam(elements, param: pos) 'keptInAReadOnlyElement'
				self.returnedElementKeeps = self.returnedElementKeeps or passed
			end 'keptInAReadOnlyElement'
		end 'eachArg'
	end 'keepThroughSummary'

	function keptContentOf(calleeIndex ElementIndex, position ParamCount) returns KeptContent
		return KeptContent.ofItsOwnType if maskHasParam(self.summary.recordKeepsAt(calleeIndex), param: position) else KeptContent.typeParameterOnly
	end 'keptContentOf'

	function noteKeptThroughSummary(func IrFunction, calleeIndex ElementIndex, args ValueIdArray, result ValueId, stored ValueId, pos ParamCount)
		let keptInTheResult = not maskHasParam(self.summary.otherKeepsAt(calleeIndex), param: pos)
		let content = self.keptContentOf(calleeIndex, position: pos)
		var storedIntoAReceiver = false

		for (iter, receiver) in args.withIterator() 'eachReceiver'
			let into = try self.calls.argPositionAt(iter.index() as ParamCount) otherwise continue

			if into != pos and (maskHasParam(self.summary.storesAt(calleeIndex, into: into), param: pos) or maskHasParam(self.summary.storesDeepAt(calleeIndex, into: into), param: pos)) 'storedIntoIt'
				storedIntoAReceiver = true
				self.noteKept(func, value: stored, holders: self.parametersAValueIsOrLiesWithin(func, value: receiver), destination: KeepDestination.within(receiver), content: content)
			end 'storedIntoIt'
		end 'eachReceiver'

		if keptInTheResult 'heldByTheResult'
			self.noteKept(func, value: stored, holders: NoParamPositions, destination: KeepDestination.within(result), content: content)
		end 'heldByTheResult' else if not storedIntoAReceiver 'keptWhereTheSummarySaysNothing'
			self.noteKept(func, value: stored, holders: NoParamPositions, destination: KeepDestination.unknown, content: content)
		end 'keptWhereTheSummarySaysNothing'
	end 'noteKeptThroughSummary'

	// What a callee's summary says it stores, said of the arguments in `argPositions`: a parameter stored into
	// module storage escapes, and one stored into another parameter's record is stored into that argument.
	function storeThroughSummary(func IrFunction, calleeIndex ElementIndex, args ValueIdArray, result ValueId, except ParamPositionMask)
		if self.landingKeeps.isDeclared() 'theBoundaryDeclaresWhatIsKept'
			return
		end 'theBoundaryDeclaresWhatIsKept'

		let escapes = self.summary.escapesAt(calleeIndex)

		for i in 0 upto args.count() 'eachStored'
			let stored = try args.get(i) otherwise panic("ProvenanceTracer.storeThroughSummary: args.get OOB at {i}")

			if not self.isTracked(stored) 'notAStoredRecord'
				continue
			end 'notAStoredRecord'

			let pos = try self.calls.argPositionAt(i as ParamCount) otherwise continue

			if maskHasParam(except, param: pos) 'keptReadOnly'
				continue
			end 'keptReadOnly'

			let storedContent = self.keptContentOf(calleeIndex, position: pos)

			if maskHasParam(self.keptByBodies(calleeIndex), param: pos) 'keptByTheCallee'
				self.noteKeptThroughSummary(func, calleeIndex: calleeIndex, args: args, result: result, stored: stored, pos: pos)
			end 'keptByTheCallee'

			if maskHasParam(escapes, param: pos) 'escapes'
				self.storeIntoEscapedSet(stored)
			end 'escapes'

			for j in 0 upto args.count() 'eachReceiver'
				if j == i 'notAnotherParameter'
					continue
				end 'notAnotherParameter'

				let into = try self.calls.argPositionAt(j as ParamCount) otherwise continue
				let receiver = try args.get(j) otherwise panic("ProvenanceTracer.storeThroughSummary: args.get OOB at {j}")

				if maskHasParam(self.summary.storesAt(calleeIndex, into: into), param: pos) 'intoAField'
					self.traceWholeStore(func, addr: receiver, value: stored, deep: false, content: storedContent)
				end 'intoAField' else if maskHasParam(self.summary.storesDeepAt(calleeIndex, into: into), param: pos) 'deeperIn'
					self.traceWholeStore(func, addr: receiver, value: stored, deep: true, content: storedContent)
				end 'deeperIn'
			end 'eachReceiver'
		end 'eachStored'
	end 'storeThroughSummary'

	// What the callee's summary says its result is to parameter `pos`, said of `arg`.
	function flowThroughSummary(func IrFunction, result ValueId, arg ValueId, calleeIndex ElementIndex, pos ParamCount)
		if not maskHasParam(self.summary.sharesAt(calleeIndex), param: pos) 'unrelated'
			return
		end 'unrelated'

		let isTheArgument = maskHasParam(self.summary.identityAt(calleeIndex), param: pos)
		let mayBeTheArgument = isTheArgument and self.valuesMayBeOneRecord(func, value: result, other: arg)
		let holdsTheArgument = maskHasParam(self.summary.holdsAt(calleeIndex), param: pos)
		let withinTheArgument = maskHasParam(self.summary.insideAt(calleeIndex), param: pos)
		let takesItsContents = not self.readsParameterStorage(arg)
		self.unionShares(result, source: arg)

		if mayBeTheArgument 'isIt'
			self.flowIdentity(result, from: arg)
		end 'isIt'

		self.flowHeldThroughSummary(result, arg: arg, calleeIndex: calleeIndex, pos: pos)

		// Within the argument, or overlapping it: either way a record the argument holds may be reached.
		if takesItsContents and (withinTheArgument or not (isTheArgument or holdsTheArgument)) 'reachesWhatItHolds'
			self.unionContents(self.setOf(ProvenanceColumn.holds, value: result), source: arg)
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: arg)
		end 'reachesWhatItHolds'

		if withinTheArgument 'withinIt'
			self.unionInsideOfIdentity(result, source: arg, reach: TupleColumnReach.anyColumn)
			self.unionMask(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.inside, source: arg)
		end 'withinIt'

		if takesItsContents and withinTheArgument 'withinWhatItHolds'
			self.unionMaskWithoutLetFields(ProvenanceColumn.inside, to: result, from: ProvenanceColumn.holdsWithin, source: arg)
		end 'withinWhatItHolds'

		// ⚠ **A RESULT THAT IS THE ARGUMENT IS NOT ALSO ONE OF ITS ELEMENTS.** A retain is an op this walk
		// cannot see into, so a callee that returns its parameter through one is summarised as possibly lying
		// within it too; read as "may be anything the argument holds", that turns every record a caller put into
		// a box into the box itself. Only a result that CAN be the argument is taken for it, though: a generic
		// body's `T` may be anything, so `Array.pop` is summarised as possibly returning its receiver, and at a
		// call whose types say the element is no array, the element is what it returns.
		if takesItsContents and withinTheArgument and not mayBeTheArgument 'anElementOfIt'
			self.unionHeldAsIdentity(result, source: arg)
		end 'anElementOfIt'

		// A result the callee stored into the argument lies within it, and says nothing more about what it holds.
		if maskHasParam(self.summary.placedWithinAt(calleeIndex), param: pos) 'placedInIt'
			self.unionMask(ProvenanceColumn.placedWithin, to: result, from: ProvenanceColumn.identity, source: arg)
			self.unionMask(ProvenanceColumn.placedWithin, to: result, from: ProvenanceColumn.inside, source: arg)
			self.unionMask(ProvenanceColumn.placedWithin, to: result, from: ProvenanceColumn.placedWithin, source: arg)
		end 'placedInIt'
	end 'flowThroughSummary'

	function holdArgumentsThroughSummary(result ValueId, args ValueIdArray, calleeIndex ElementIndex)
		if not self.isTracked(result) 'holdsNoRecord'
			return
		end 'holdsNoRecord'

		for (iter, arg) in args.withIterator() 'eachArg'
			let pos = try self.calls.argPositionAt(iter.index() as ParamCount) otherwise continue
			self.flowHeldThroughSummary(result, arg: arg, calleeIndex: calleeIndex, pos: pos)
		end 'eachArg'
	end 'holdArgumentsThroughSummary'

	function flowHeldThroughSummary(result ValueId, arg ValueId, calleeIndex ElementIndex, pos ParamCount)
		let holdsTheArgument = maskHasParam(self.summary.holdsAt(calleeIndex), param: pos)
		let holdsAPartOfIt = maskHasParam(self.summary.holdsWithinAt(calleeIndex), param: pos)

		if holdsTheArgument or holdsAPartOfIt 'holdsSomething'
			self.unionShares(result, source: arg)
		end 'holdsSomething'

		if holdsTheArgument 'holdsIt'
			self.flowContents(result, from: arg)
		end 'holdsIt'

		if holdsAPartOfIt 'holdsAPartOfIt'
			self.holdPartsOf(result, arg: arg)
		end 'holdsAPartOfIt'
	end 'flowHeldThroughSummary'

	function holdPartsOf(result ValueId, arg ValueId)
		self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.identity, source: arg)
		self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.inside, source: arg)

		if not self.readsParameterStorage(arg) 'andWhatItHolds'
			self.unionMask(ProvenanceColumn.holdsWithin, to: result, from: ProvenanceColumn.holdsWithin, source: arg)
			self.unionContents(self.setOf(ProvenanceColumn.holdsWithin, value: result), source: arg)
		end 'andWhatItHolds'
	end 'holdPartsOf'

	// `to` may be `from`'s own record: every fact carries.
	function flowIdentity(to ValueId, from ValueId)
		self.unionShares(to, source: from)
		self.unionMask(ProvenanceColumn.identity, to: to, from: ProvenanceColumn.identity, source: from)
		self.unionMask(ProvenanceColumn.holds, to: to, from: ProvenanceColumn.holds, source: from)
		self.unionMask(ProvenanceColumn.holds, to: to, from: ProvenanceColumn.storedHolds, source: from)
		self.unionMask(ProvenanceColumn.deepHolds, to: to, from: ProvenanceColumn.deepHolds, source: from)
		self.unionMask(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.inside, source: from)
		self.unionMask(ProvenanceColumn.placedWithin, to: to, from: ProvenanceColumn.placedWithin, source: from)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.holdsWithin, source: from)
	end 'flowIdentity'

	// `to` was built containing `from`, and so `from`'s record, and deeper everything `from` contains.
	function flowContents(to ValueId, from ValueId)
		self.unionMask(ProvenanceColumn.holds, to: to, from: ProvenanceColumn.identity, source: from)
		self.unionContents(self.setOf(ProvenanceColumn.deepHolds, value: to), source: from)
		self.unionContainedParts(to, source: from)
		self.unionShares(to, source: from)
	end 'flowContents'

	// `to` may be a record `from` holds, or contain what it contains.
	function flowFromWithin(to ValueId, from ValueId)
		self.unionShares(to, source: from)
		self.unionInsideOfIdentity(to, source: from, reach: TupleColumnReach.anyColumn)
		self.unionMask(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.inside, source: from)

		if self.readsParameterStorage(from) 'theCallersToJudge'
			return
		end 'theCallersToJudge'

		self.unionHeldAsIdentity(to, source: from)
		self.unionContents(self.setOf(ProvenanceColumn.holds, value: to), source: from)
		self.unionMaskWithoutLetFields(ProvenanceColumn.inside, to: to, from: ProvenanceColumn.holdsWithin, source: from)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.holdsWithin, source: from)
	end 'flowFromWithin'

	// Is a read out of `from` a read out of a parameter's record — in a trace of the immutable bindings, whose
	// parameter ranks follow the bindings (see the header)?
	function readsParameterStorage(from ValueId) returns bool
		return self.tracingImmutableBindings and (self.namesAParameter(ProvenanceColumn.identity, value: from) or self.namesAParameter(ProvenanceColumn.inside, value: from))
	end 'readsParameterStorage'

	function namesAParameter(column ProvenanceColumn, value ValueId) returns bool
		if var chunk = try self.sets.first(self.setOf(column, value: value)) 'hasWords'
			while true 'eachWord'
				let word = self.sets.indexOf(chunk)

				if word >= self.parameterRankWords.count() as MaskWordCount 'pastEveryParameter'
					return false
				end 'pastEveryParameter'

				if (self.sets.wordOf(chunk) and (try self.parameterRankWords.get(word) otherwise panic("ProvenanceTracer.namesAParameter: parameterRankWords.get OOB at {word}"))) != NoParamPositions 'aParameter'
					return true
				end 'aParameter'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return false
	end 'namesAParameter'

	function unionShares(to ValueId, source ValueId)
		self.unionMask(ProvenanceColumn.shares, to: to, from: ProvenanceColumn.shares, source: source)
	end 'unionShares'

	// `to` may be a record `source` contains: what it holds, whether produced so or stored into it since.
	function unionHeldAsIdentity(to ValueId, source ValueId)
		self.unionMaskWithoutLetFields(ProvenanceColumn.identity, to: to, from: ProvenanceColumn.holds, source: source)
		self.unionMaskWithoutLetFields(ProvenanceColumn.identity, to: to, from: ProvenanceColumn.storedHolds, source: source)
	end 'unionHeldAsIdentity'

	function unionMaskWithoutLetFields(column ProvenanceColumn, to ValueId, from ProvenanceColumn, source ValueId)
		if self.sets.unionWithoutRanks(self.setOf(column, value: to), from: self.setOf(from, value: source), firstSkipped: self.letFieldRank(), skippedCount: HiddenViewRankCount) 'grew'
			self.changed = true
		end 'grew'
	end 'unionMaskWithoutLetFields'

	// `to` now contains `source`, so it holds a part of every root `source` lies within or holds a part of.
	function unionContainedParts(to ValueId, source ValueId)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.inside, source: source)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.placedWithin, source: source)
		self.unionMask(ProvenanceColumn.holdsWithin, to: to, from: ProvenanceColumn.holdsWithin, source: source)
	end 'unionContainedParts'

	function recordReturn(func IrFunction, terminator MaxonOp)
		match terminator 'term'
			ret(returned) then self.addReturned(func, value: returned)
			call or
			literal or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			tryCall or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd then break
		end 'term'
	end 'recordReturn'

	// A parameter trace ranks only the parameters in word 0, so a value's word 0 IS its summary mask.
	function addReturned(func IrFunction, value ValueId)
		self.returnedValues.push(value)
		let frozen = self.valueIsAnImmutableBindingsOwn(func, value: value)
		let written = func.writtenParamMask or func.writesThroughParamMask if frozen else NoParamPositions
		self.returnedShares = self.returnedShares or maskWithout(self.wordAt(ProvenanceColumn.shares, value: value, word: 0), removed: written)
		self.returnedIdentity = self.returnedIdentity or maskWithout(self.wordAt(ProvenanceColumn.identity, value: value, word: 0), removed: written)
		self.returnedHolds = self.returnedHolds or maskWithout(self.wordAt(ProvenanceColumn.holds, value: value, word: 0) or self.wordAt(ProvenanceColumn.storedHolds, value: value, word: 0) or self.wordAt(ProvenanceColumn.deepHolds, value: value, word: 0), removed: written)
		self.returnedInside = self.returnedInside or maskWithout(self.wordAt(ProvenanceColumn.inside, value: value, word: 0), removed: written)
		self.returnedHoldsWithin = self.returnedHoldsWithin or maskWithout(self.wordAt(ProvenanceColumn.holdsWithin, value: value, word: 0), removed: written)

		if not frozen 'aFrozenResultIsPlacedNowhere'
			self.returnedPlacedWithin = self.returnedPlacedWithin or self.wordAt(ProvenanceColumn.placedWithin, value: value, word: 0)
		end 'aFrozenResultIsPlacedNowhere'

		if self.valueIsOrLiesWithin(value, rank: self.moduleLetRank()) 'withinALet'
			self.returnedModuleLets = self.returnedModuleLets or ResultLiesWithinAModuleLet
		end 'withinALet'

		if self.valueHoldsRank(value, rank: self.moduleLetRank()) 'holdsALet'
			self.returnedModuleLets = self.returnedModuleLets or ResultHoldsAModuleLet
		end 'holdsALet'

		if self.valueIsOrLiesWithin(value, rank: self.sharedViewRank()) 'withinAView'
			self.returnedModuleLets = self.returnedModuleLets or ResultLiesWithinASharedView
		end 'withinAView'

		if self.valueHoldsRank(value, rank: self.sharedViewRank()) 'holdsAView'
			self.returnedModuleLets = self.returnedModuleLets or ResultHoldsASharedView
		end 'holdsAView'

		if self.valueIsOrLiesWithin(value, rank: self.letFieldRank()) 'withinALetField'
			self.returnedModuleLets = self.returnedModuleLets or ResultLiesWithinALetField
		end 'withinALetField'

		if self.valueHoldsRank(value, rank: self.letFieldRank()) 'holdsALetField'
			self.returnedModuleLets = self.returnedModuleLets or ResultHoldsALetField
		end 'holdsALetField'

		if self.valueIsOrLiesWithin(value, rank: self.letPayloadRank()) 'withinALetPayload'
			self.returnedModuleLets = self.returnedModuleLets or ResultLiesWithinALetPayload
		end 'withinALetPayload'

		if self.valueHoldsRank(value, rank: self.letPayloadRank()) 'holdsALetPayload'
			self.returnedModuleLets = self.returnedModuleLets or ResultHoldsALetPayload
		end 'holdsALetPayload'

		if self.valueIsOrLiesWithin(value, rank: self.readOnlyElementRank()) 'withinAReadOnlyElement'
			self.returnedModuleLets = self.returnedModuleLets or ResultLiesWithinAReadOnlyElement
		end 'withinAReadOnlyElement'

		if self.valueHoldsRank(value, rank: self.readOnlyElementRank()) 'holdsAReadOnlyElement'
			self.returnedModuleLets = self.returnedModuleLets or ResultHoldsAReadOnlyElement
		end 'holdsAReadOnlyElement'

		for kind in 0 upto ReadOnlySlotKindCount 'eachSlotKind'
			if self.setHasRank(ProvenanceColumn.identity, value: value, rank: self.tupleLetFieldRank() + kind) 'aTupleWithAKind'
				self.returnedModuleLets = maskWithParam(self.returnedModuleLets, param: ResultTupleKindFirstBit + kind as ParamCount)
			end 'aTupleWithAKind'

			if self.valueIsOrLiesWithin(value, rank: self.maybeLetFieldRank() + kind) 'mayBeOfAKind'
				self.returnedModuleLets = maskWithParam(self.returnedModuleLets, param: ResultMayBeKindFirstBit + kind as ParamCount)
			end 'mayBeOfAKind'
		end 'eachSlotKind'

		if not self.valueMarksSomeTupleColumn(value) 'noColumnIsMarked'
			return
		end 'noColumnIsMarked'

		for column in 0 upto TupleColumnMarkCount 'eachColumn'
			if self.setHasRank(ProvenanceColumn.identity, value: value, rank: self.tupleColumnRank(column)) 'aMarkedColumn'
				self.returnedModuleLets = maskWithParam(self.returnedModuleLets, param: TupleColumnSummaryFirstBit + column as ParamCount)
			end 'aMarkedColumn'
		end 'eachColumn'
	end 'addReturned'

	function recordHeldIn(func IrFunction, value ValueId) returns ValueId
		var steps = self.pathSteps
		steps.clear()
		let base = self.accessPathOf(func, ir: self.module, value: value, into: steps)
		return base if steps.count() == 0 else value
	end 'recordHeldIn'

	function valueIsAnImmutableBindingsOwn(func IrFunction, value ValueId) returns bool
		return try self.isImmutableBindingValue.get(self.recordHeldIn(func, value: value)) otherwise panic("ProvenanceTracer.valueIsAnImmutableBindingsOwn: isImmutableBindingValue.get OOB at v{value}")
	end 'valueIsAnImmutableBindingsOwn'

	// ⭐ **A WRITE THROUGH A VALUE THAT MAY BE A PARAMETER'S RECORD IS A WRITE OF THAT PARAMETER.** `var x =
	// pass(p)` then `x.append(…)` writes `p`, so the call handing `x` to a written position is an edge from
	// `p` exactly as `grow(p)` is, and a container method writing `x` as its receiver writes `p` exactly as
	// `p.push(9)` does (`stageParamEdges`). `collectCallParamEdges` records an argument that IS a parameter,
	// and the parser a receiver that is one; this adds every argument and receiver whose `identity` names one.
	//
	// ⚖ **AN ARGUMENT OR RECEIVER THAT MAY LIE WITHIN A PARAMETER'S RECORD WRITES THE RECORD RELATION ONLY.**
	// `t.inner.bump()` and `pick(t).push(1)` write the graph `t` denotes, which a `let` global is
	// refused by; neither is a write of the `let` binding `t` was handed, which a field chain off a local `let` is
	// not either (`specs/immutable-method-call.md`), so the narrow and binding columns close over the identity
	// edges and seeds alone.
	//
	// Answers (the identity relation, the record relation), each `base` itself when it gained no row.
	module function collectProvenanceParamEdges(base CallParamEdges, funcNames FunctionNameIndex) returns (CallParamEdges, CallParamEdges)
		var aliasRows = CallParamEdges.create()
		var withinRows = CallParamEdges.create()

		for i in 0 upto funcNames.functions.count() 'eachFunc'
			_ = widenSummaryColumn(self.receiverWrites.identity, index: i, by: summaryMaskAt(self.stagedEdges.written, index: i))
			_ = widenSummaryColumn(self.receiverWrites.within, index: i, by: summaryMaskAt(self.stagedEdges.writtenWithin, index: i))
			self.stagedEdges.alias.appendRowsOf(i, into: aliasRows)
			self.stagedEdges.within.appendRowsOf(i, into: withinRows)
		end 'eachFunc'

		self.stagedEdges.release()
		let identityEdges = base.widenedBy(aliasRows)
		return (identityEdges, identityEdges.widenedBy(withinRows))
	end 'collectProvenanceParamEdges'

	// Files what the parameter trace just made of `func` reaches — see `StagedParamEdges`. It reads the call
	// sites that trace's walk just filed, in the order the walk met them, so a callee is resolved once for both.
	function stageParamEdges(func IrFunction, index ElementIndex)
		if not self.anyParameterHoldsARecord(func) 'nothingOfItsOwnToWrite'
			return
		end 'nothingOfItsOwnToWrite'

		view ir = self.module
		let aliasStart = self.stagedEdges.alias.rows.count()
		let withinStart = self.stagedEdges.within.rows.count()
		var written = NoParamPositions
		var writtenWithin = NoParamPositions
		view sites = func.provenanceSites(self.noSites)

		for site in sites.receiverWrites 'eachWrite'
			written = written or self.parametersReachedBy(func, arg: site.receiver, asksIdentity: true)
			writtenWithin = writtenWithin or self.parametersReachedBy(func, arg: site.receiver, asksIdentity: false)
		end 'eachWrite'

		for site in sites.writeThroughSites 'eachFieldStore'
			writtenWithin = writtenWithin or self.parametersReachedBy(func, arg: site.target, asksIdentity: true) or self.parametersReachedBy(func, arg: site.target, asksIdentity: false)
		end 'eachFieldStore'

		self.calls.replay(index)
		var writesARawResource = false

		for position in callSiteWalkOrder(ir, func: func) 'eachBlock'
			let blockRef = try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.stageParamEdges: position {position} from the walk order is past func.blockRefs")
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.stageParamEdges: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				view op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.stageParamEdges: opIdx {opIdx} not in module.ops")
				self.addParameterRecordEdgesAt(func, op: op, callerIndex: index)
				writesARawResource = writesARawResource or opWritesARawResource(op)
			end 'eachOp'
		end 'eachBlock'

		if writesARawResource 'aRawFreeOrStore'
			written = written or self.recordParameters(func)
		end 'aRawFreeOrStore'

		self.calls.requireMetEveryCallSite(index)
		self.stagedEdges.file(index, aliasStart: aliasStart, withinStart: withinStart, receiverWritten: written, receiverWrittenWithin: writtenWithin)
	end 'stageParamEdges'

	function recordParameters(func IrFunction) returns ParamPositionMask
		var records = NoParamPositions
		let firstParam = 0
		let isAMethod = self.signatures.declaresCallee(func.name) and self.signatures.declaredMethodTakesReceiver(func.name)

		for p in 0 upto func.paramCount 'eachParam'
			if isAMethod and p != firstParam 'onlyTheReceiverOwnsTheResource'
				break
			end 'onlyTheReceiverOwnsTheResource'

			if self.valueTagCarriesProvenance(func, value: valueIdAtParamPosition(p)) and not tagIsByteRecord(valueTagOf(func, value: valueIdAtParamPosition(p))) 'holdsAStructuredRecord'
				records = maskWithParam(records, param: p)
			end 'holdsAStructuredRecord'
		end 'eachParam'

		return records
	end 'recordParameters'

	// Fill `argIdentityReach` and `argWithinReach` for `args`, answering whether any argument reaches a parameter —
	// the gate in front of every summary lookup, since almost no argument does.
	function argumentsReachAParameter(func IrFunction, args ValueIdArray) returns bool
		self.argIdentityReach.clear()
		self.argWithinReach.clear()
		var reached = NoParamPositions

		for arg in args 'eachArg'
			let identity = self.parametersReachedBy(func, arg: arg, asksIdentity: true)
			let within = self.parametersReachedBy(func, arg: arg, asksIdentity: false)
			self.argIdentityReach.push(identity)
			self.argWithinReach.push(within)
			reached = reached or identity or within
		end 'eachArg'

		return reached != NoParamPositions
	end 'argumentsReachAParameter'

	// The parameters a value may BE the record of (`asksIdentity`), or may lie within, when it is not a parameter
	// itself — that case is the parser's own edge or seed already. A kind of record the parameter's type rules out is
	// not the parameter's.
	function parametersReachedBy(func IrFunction, arg ValueId, asksIdentity bool) returns ParamPositionMask
		if arg < valueIdAtParamPosition(func.paramCount) 'itIsTheParameter'
			return NoParamPositions
		end 'itIsTheParameter'

		let mayReach = self.wordAt(ProvenanceColumn.identity if asksIdentity else ProvenanceColumn.inside, value: arg, word: 0)
		var typed = NoParamPositions

		for p in 0 upto self.rankCount 'eachParam'
			if maskHasParam(mayReach, param: p) and self.typeAdmits(func, value: arg, rank: p, asksIdentity: asksIdentity) 'ofItsType'
				typed = maskWithParam(typed, param: p)
			end 'ofItsType'
		end 'eachParam'

		return typed
	end 'parametersReachedBy'

	function kindsMayHoldValue(func IrFunction, kinds HeldRecordKinds, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tagIsByteRecord(tag) 'bytes'
			return kinds.mayHold(HeldByteRecordKind)
		end 'bytes'

		if tag != ValueTypeTag.genericInstance and not self.signatures.tagMayNameAggregate(tag) 'anyOtherKind'
			return true
		end 'anyOtherKind'

		return kinds.mayHold(try self.heldRecordKindOf(func, value: value) otherwise return true)
	end 'kindsMayHoldValue'

	function addParameterRecordEdgesAt(func IrFunction, op MaxonOp, callerIndex ElementIndex)
		match op 'op'
			call(_, _, args, _, _, _, _, _) then self.addNamedCallRecordEdges(func, args: args, callerIndex: callerIndex)
			tryCall(_, _, _, args, _, _, _, _, _) then self.addNamedCallRecordEdges(func, args: args, callerIndex: callerIndex)
			witnessDispatch(_, args, _, _, methodIndex, interfaceDeclIndex, _, _) then self.addWitnessRecordEdges(func, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, callerIndex: callerIndex)
			witnessTryDispatch(_, _, args, _, _, methodIndex, interfaceDeclIndex, _) then self.addWitnessRecordEdges(func, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, callerIndex: callerIndex)

			// ⭐ **A SPAWN CARRIES THE ALIAS EDGE TOO, AND NEEDS IT MORE THAN A DIRECT CALL DOES**: the spawn takes
			// its own reference to a managed argument (`Parser.transferAsyncSpawnArgs`), so the value standing at
			// the op is that RETAIN and never the parameter's own — without this arm nothing relates the two and
			// the target's writes stop at its own frame.
			asyncCall(_, _, args, _, _, _, _, _) then self.addNamedCallRecordEdges(func, args: args, callerIndex: callerIndex)
			indirectCall then self.addFunctionValueRecordEdges(func, op: op, callerIndex: callerIndex)

			// A message hands its arguments to another green thread.
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd then break
		end 'op'
	end 'addParameterRecordEdgesAt'

	function addNamedCallRecordEdges(func IrFunction, args ValueIdArray, callerIndex ElementIndex)
		let site = self.calls.takeCallSite()

		if not self.calls.resolution.sites.rowIsDescribed(site) 'noSummaryToCarryAnEdge'
			return
		end 'noSummaryToCarryAnEdge'

		if not self.argumentsReachAParameter(func, args: args) 'noEdgeToRecord'
			return
		end 'noEdgeToRecord'

		let calleeIndex = self.calls.resolution.sites.calleeAt(site)
		self.calls.slotCallSiteArgs(site, argCount: args.count() as ParamCount)

		for i in 0 upto args.count() 'eachArg'
			let pos = try self.calls.argPositionAt(i as ParamCount) otherwise continue
			self.addArgumentRecordEdges(i as ParamCount, calleeIndex: calleeIndex, callerIndex: callerIndex, calleeParam: pos)
		end 'eachArg'
	end 'addNamedCallRecordEdges'

	function addWitnessRecordEdges(func IrFunction, args ValueIdArray, methodIndex WitnessMethodIndex, interfaceDeclIndex ElementIndex, callerIndex ElementIndex)
		self.addLandingRecordEdges(func, args: args, argCount: args.count() as ParamCount, bodies: self.calls.resolution.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), callerIndex: callerIndex)
	end 'addWitnessRecordEdges'

	function addFunctionValueRecordEdges(func IrFunction, op MaxonOp, callerIndex ElementIndex)
		match op 'indirect'
			indirectCall(_, callee, args, _) then self.addLandingRecordEdges(func, args: args, argCount: userArityOfIndirectCall(args), bodies: self.calls.resolution.functionValueBodiesCalledThrough(func, callee: callee), callerIndex: callerIndex)
			default panic("ProvenanceTracer.addFunctionValueRecordEdges: handed an op that is not an indirect call")
		end 'indirect'
	end 'addFunctionValueRecordEdges'

	function addLandingRecordEdges(func IrFunction, args ValueIdArray, argCount ParamCount, bodies CallLandingBodies, callerIndex ElementIndex)
		if not self.argumentsReachAParameter(func, args: args) 'noEdgeToRecord'
			return
		end 'noEdgeToRecord'

		for impl in bodies.impls 'eachImpl'
			for i in 0 upto argCount 'eachArg'
				self.addArgumentRecordEdges(i, calleeIndex: impl, callerIndex: callerIndex, calleeParam: i)
			end 'eachArg'
		end 'eachImpl'
	end 'addLandingRecordEdges'

	// Argument `argIndex`'s edges, off the reach `argumentsReachAParameter` recorded for it.
	function addArgumentRecordEdges(argIndex ParamCount, calleeIndex ElementIndex, callerIndex ElementIndex, calleeParam ParamCount)
		let within = try self.argWithinReach.get(argIndex) otherwise panic("ProvenanceTracer.addArgumentRecordEdges: within reach OOB at argument {argIndex}")
		recordAliasEdges(try self.argIdentityReach.get(argIndex) otherwise panic("ProvenanceTracer.addArgumentRecordEdges: identity reach OOB at argument {argIndex}"), calleeIndex: calleeIndex, callerIndex: callerIndex, calleeParam: calleeParam, edges: self.stagedEdges.alias.rows)

		for p in 0 upto self.rankCount 'eachParam'
			if maskHasParam(within, param: p) 'withinThisOne'
				self.stagedEdges.within.rows.record(calleeIndex, callerIndex: callerIndex, callerParam: p, calleeParam: calleeParam)
			end 'withinThisOne'
		end 'eachParam'
	end 'addArgumentRecordEdges'

	// ⭐⭐ **THE OWNERSHIP MODEL'S DOORS, WHERE THE PARSER COULD NOT DECIDE BY NAME.** A record is
	// reachable through immutable names or through mutable paths, never both at once: mutable holders
	// may share it, and so may immutable names, but a mutable door takes an immutable name's record
	// only by moving the name. Every door is asked by LIVENESS: it is refused only where a record the
	// value may be or lie within is reached by an immutable name live after it — a `let` to its last
	// use (and to the end of a loop it was bound before and used in), a `view` from its declaration
	// on, a module-level `let` everywhere. Each function is traced once and asked at every door it
	// recorded and every call it makes; its refusals are reported in source order.
	//
	// | door | a sole `let` handed whole | a value an immutable name live after it reaches | code |
	// |---|---|---|---|
	// | a `var` bound or assigned | moves it | refused | E3078 |
	// | a store into writable storage | moves it | refused | E3078 |
	// | an argument a callee keeps or a `sole` parameter takes | moves it | refused | E3078 |
	// | a container method writing its receiver | — | refused | E3159 |
	// | a field write through a record | — | refused | E3159 |
	//
	// A moved name read afterwards is E3102, and a move out of a loop the name was declared outside of
	// is E2015. A `let` bound to a value that may reach writable state is refused where it is bound
	// (E3188, `checkLetBindings`). The record of a `var` or parameter that a `view` declared earlier
	// reaches into is not sent (E3138), published (E3174) or handed to a `sole` parameter (E3078) —
	// `refuseViewedHandOff`, `judgeConsumedArgument` — and a value that is or lies within a `view`'s
	// record is not returned (E3078, `decideReturnedValue`). A value that is an immutable record
	// (`ProgramSignatures.aggregateTypeIsImmutable`) is written by nothing, and meets no door.
	module function beginStorageDoors()
		self.opaqueBoundBodies.refill(self.module.functions.count(), value: false)
		self.refusedBodies.refill(self.module.functions.count(), value: false)
	end 'beginStorageDoors'

	module function checkFunctionDoors(i ElementIndex, mutationSummary ParamMutationSummary)
		view ir = self.module
		var func = try self.module.functions.get(i) otherwise panic("ProvenanceTracer.checkFunctionDoors: functions.get OOB at {i} below its own count")
		view sites = func.provenanceSites(self.noSites)
		self.readOnlyKeptBases.clear()
		self.readOnlyKeptAt.clear()

		if func.isCompilerBuilt() or self.project.libraryFacts.bodyIsSwept(func.name) 'noAuthorToBlameOrNothingReaches'
			self.refusals.clear()
			self.clearKeptRefused()
			return
		end 'noAuthorToBlameOrNothingReaches'

		self.decideLetFieldMoves(func, index: i, sites: sites, mutationSummary: mutationSummary)
		self.reportWriteRefusals(sites)
		self.decideLetKeptArguments(func, index: i)

		if sites.immutableBindings.values.count() == 0 and not filesVarCandidates(sites) and not self.mayWriteThroughAModuleLetsRecord(i, sites: sites) and sites.writeThroughSites.count() == 0 'nothingToAsk'
			self.reportRefusals(func)
			self.clearKeptRefused()
			return
		end 'nothingToAsk'

		let bindingCount = self.bindingsTraceOf(func, index: i)
		self.leaveDoor()

		let recordsToWriteThrough = bindingCount > 0 or self.moduleLetStorageReached

		if recordsToWriteThrough or filesVarCandidates(sites) 'rootsToReach'
			self.gatherWrittenTargets(func, index: i)
		end 'rootsToReach'

		if bindingCount > 0 'bindingRootsToReach'
			self.checkMoveSites(func)
		end 'bindingRootsToReach'

		if recordsToWriteThrough 'bindingsAndWritesToJudge'
			self.checkMutableBindingSites(func, ir: ir, index: i)
			self.checkReceiverWrites(func)
			self.checkWriteThroughSites(func, index: i)
			self.checkWrittenArguments(func, ir: ir)
			self.checkViewSinks(func, index: i)
		end 'bindingsAndWritesToJudge'

		self.reportRefusals(func)
		self.clearKeptRefused()

		match sites.varCandidates 'mayWithholdE3077'
			none then break
			filed(candidates) then self.withholdVarShouldBeLet(func, candidates: candidates)
		end 'mayWithholdE3077'
	end 'checkFunctionDoors'

	module function endStorageDoors()
		self.reportOpaqueInstantiations()
		self.dropWithdrawnHygiene()
	end 'endStorageDoors'

	function decideLetKeptArguments(func IrFunction, index ElementIndex)
		var traced = false

		while self.keptArgCursor < self.keptArgFuncs.count() 'eachNote'
			let owner = try self.keptArgFuncs.get(self.keptArgCursor) otherwise panic("ProvenanceTracer.decideLetKeptArguments: keptArgFuncs.get OOB below its own count")

			if owner > index 'aLaterFunctions'
				break
			end 'aLaterFunctions'

			if owner == index 'thisFunctions'
				if not traced 'firstNote'
					_ = self.bindingsTraceOf(func, index: index)
					traced = true
				end 'firstNote'

				self.judgeKeptArgument(func, note: self.keptArgCursor)
			end 'thisFunctions'

			self.keptArgCursor = self.keptArgCursor + 1
		end 'eachNote'
	end 'decideLetKeptArguments'

	function reportWriteRefusals(sites ProvenanceSites)
		for site in sites.writeRefusals 'eachRefusal'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticWriteThroughImmutableRecord, message: deepLetWriteMessage(String.from(site.place), root: String.from(site.root), kind: site.kind))
		end 'eachRefusal'
	end 'reportWriteRefusals'

	function decideLetFieldMoves(func IrFunction, index ElementIndex, sites ProvenanceSites, mutationSummary ParamMutationSummary)
		for site in sites.moveSites 'eachSite'
			match site.destinationKind 'kind'
				letField then self.decideLetFieldMove(func, index: index, site: site, into: ReadOnlyRootKind.letField)
				letFieldValue then self.decideLetFieldValue(func, index: index, site: site, into: ReadOnlyRootKind.letField)
				letPayload then self.decideLetFieldMove(func, index: index, site: site, into: ReadOnlyRootKind.letPayload)
				letPayloadValue then self.decideLetFieldValue(func, index: index, site: site, into: ReadOnlyRootKind.letPayload)
				readOnlyElement then self.decideLetFieldMove(func, index: index, site: site, into: ReadOnlyRootKind.readOnlyElement)
				readOnlyElementValue then self.decideLetFieldValue(func, index: index, site: site, into: ReadOnlyRootKind.readOnlyElement)
				serviceReply then self.decideServiceReply(func, site: site)
				sharedSend then self.decideSharedSend(func, site: site, mutationSummary: mutationSummary)
				sentMessage or
				publishedValue then self.decideHandedOff(func, index: index, site: site)
				mutablePlace then self.decideMutablePlaceStore(func, index: index, site: site)
				returnedValue then self.decideReturnedValue(func, index: index, site: site)
				mutableName or
				keptArgument then break
			end 'kind'
		end 'eachSite'
	end 'decideLetFieldMoves'

	function viewDecisionApplies(func IrFunction, index ElementIndex, value ValueId) returns bool
		if self.valueHoldsNoRecord(func, value: value) 'aValueTypeHasNoCapability'
			return false
		end 'aValueTypeHasNoCapability'

		_ = self.bindingsTraceOf(func, index: index)
		return true
	end 'viewDecisionApplies'

	function decideReturnedValue(func IrFunction, index ElementIndex, site MoveSite)
		if not self.viewDecisionApplies(func, index: index, value: site.value) 'nothingForAViewToEscapeThrough'
			return
		end 'nothingForAViewToEscapeThrough'

		if let name = try self.viewRootReachedBy(site.value) 'aViewEscapes'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: viewReturnedMessage(String.from(name)))
		end 'aViewEscapes'
	end 'decideReturnedValue'

	function decideHandedOff(func IrFunction, index ElementIndex, site MoveSite)
		let code = handOffRefusalCode(site.destinationKind)

		if self.viewDecisionApplies(func, index: index, value: site.value) and self.refuseViewedHandOff(func, site: site, code: code) 'theViewIsBlamed'
			return
		end 'theViewIsBlamed'

		if site.refused 'theParserCouldNotProveItSole'
			self.refuse(site.line, column: site.column, code: code, message: String.from(site.refusal))
		end 'theParserCouldNotProveItSole'
	end 'decideHandedOff'

	function refuseViewedHandOff(func IrFunction, site MoveSite, code ErrorCode) returns bool
		let sent = site.destinationKind == MoveDestinationKind.sentMessage

		if sent 'aSentValue'
			if let name = try self.viewRootReachedBy(site.value) 'aViewIsSent'
				self.refuse(site.line, column: site.column, code: code, message: viewSentMessage(String.from(name), message: String.from(site.destination)))
				return true
			end 'aViewIsSent'
		end 'aSentValue'

		let reach = try self.viewOfHandedOffValue(func, value: site.value, before: site.token) otherwise return false
		let viewName = String.from(self.rootNameAt(reach.viewRank))
		self.refuse(site.line, column: site.column, code: code, message: viewedVarSentMessage(reach.rootName, view: viewName, argumentOf: String.from(site.destination)) if sent else viewedVarPublishedExplanation(String.from(site.destination), view: viewName))
		return true
	end 'refuseViewedHandOff'

	function viewOfHandedOffValue(func IrFunction, value ValueId, before ElementIndex) returns ViewReach throws AbsentError
		if let reach = try self.viewReaching(func, value: value, before: before) 'aSharedRoot'
			return reach
		end 'aSharedRoot'

		return try self.viewOfTheSameRecord(func, value: value, before: before)
	end 'viewOfHandedOffValue'

	function viewOfTheSameRecord(func IrFunction, value ValueId, before ElementIndex) returns ViewReach throws AbsentError
		let base = self.sameRecordBase(func, ir: self.module, value: value)
		let rootName = try self.baseRootName(func, base: base)

		for viewRank in 0 upto self.rootNames.count() 'eachBindingRoot'
			if self.viewIsDeclaredBefore(viewRank, before: before) and self.recordLiesWithin(func, record: self.rootValueAt(viewRank), base: base) 'itsRecord'
				return ViewReach.create(viewRank, rootName: rootName, rootIsParameter: base < valueIdAtParamPosition(func.paramCount))
			end 'itsRecord'
		end 'eachBindingRoot'

		throw AbsentError.absent
	end 'viewOfTheSameRecord'

	function baseRootName(func IrFunction, base ValueId) returns String throws AbsentError
		if base < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return self.parameterNameAt(func, position: paramPositionOfValueId(base))
		end 'aParameter'

		return try self.writableNameOf(func, value: base)
	end 'baseRootName'

	function recordLiesWithin(func IrFunction, record ValueId, base ValueId) returns bool
		var current = self.sameRecordBase(func, ir: self.module, value: record)
		var hops = 0 as ElementIndex

		while hops < MaxAccessPathSteps 'eachHop'
			if current == base 'itsBase'
				return true
			end 'itsBase'

			if not self.hasDefiningOp(current) 'noOpDefinesIt'
				return false
			end 'noOpDefinesIt'

			match self.hopKindOf(current) 'hop'
				field or
				element then current = self.sameRecordBase(func, ir: self.module, value: self.hopBaseOf(current))
				stop or
				same then return false
			end 'hop'

			hops = hops + 1
		end 'eachHop'

		return false
	end 'recordLiesWithin'

	function viewIsDeclaredBefore(viewRank ElementIndex, before ElementIndex) returns bool
		return self.rootKindAt(viewRank) == ReadOnlyRootKind.view and (try self.rootDeclTokens.get(viewRank) otherwise panic("ProvenanceTracer.viewIsDeclaredBefore: rootDeclTokens.get OOB at {viewRank}")) < before
	end 'viewIsDeclaredBefore'

	function viewReaching(func IrFunction, value ValueId, before ElementIndex) returns ViewReach throws AbsentError
		for viewRank in 0 upto self.rootNames.count() 'eachBindingRoot'
			if not self.viewIsDeclaredBefore(viewRank, before: before) 'notAViewDeclaredBefore'
				continue
			end 'notAViewDeclaredBefore'

			if let rootRank = try self.recordSharedWithView(viewRank, value: value) 'aViewOfItsRecord'
				return ViewReach.create(viewRank, rootName: self.writableRootName(func, rank: rootRank), rootIsParameter: rootRank < self.firstWritableValueRank)
			end 'aViewOfItsRecord'
		end 'eachBindingRoot'

		throw AbsentError.absent
	end 'viewReaching'

	function recordSharedWithView(viewRank ElementIndex, value ValueId) returns ElementIndex throws AbsentError
		let viewValue = self.rootValueAt(viewRank)

		for valueColumn in HandedOffRecordColumns 'eachValueColumn'
			for viewColumn in ViewReachColumns 'eachViewColumn'
				return try self.firstVarOrParameterRankShared(self.setOf(valueColumn, value: value), other: self.setOf(viewColumn, value: viewValue)) otherwise continue
			end 'eachViewColumn'
		end 'eachValueColumn'

		throw AbsentError.absent
	end 'recordSharedWithView'

	function firstVarOrParameterRankShared(set ElementIndex, other ElementIndex) returns ElementIndex throws AbsentError
		if var chunk = try self.sets.first(set) 'hasWords'
			while true 'eachWord'
				let word = self.sets.indexOf(chunk)
				let firstRank = (word as ElementIndex) shl RootWordShift
				let shared = self.sets.wordOf(chunk) and self.sets.wordAt(other, word: word)

				for bit in 0 upto RootBitIndexMask + 1 'eachBit'
					let rank = firstRank + bit

					if maskHasParam(shared, param: bit as ParamCount) and rank >= self.rootNames.count() and rank < self.writableRank 'aVarOrParameter'
						return rank
					end 'aVarOrParameter'
				end 'eachBit'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		throw AbsentError.absent
	end 'firstVarOrParameterRankShared'

	function viewRootReachedBy(value ValueId) returns ByteArray throws AbsentError
		for rank in 0 upto self.rootNames.count() 'eachBindingRoot'
			if self.viewReaches(rank, value: value) 'aViewItReaches'
				return self.rootNameAt(rank)
			end 'aViewItReaches'
		end 'eachBindingRoot'

		throw AbsentError.absent
	end 'viewRootReachedBy'

	function viewOfAPlaceReachedBy(func IrFunction, value ValueId) returns ByteArray throws AbsentError
		for rank in 0 upto self.rootNames.count() 'eachBindingRoot'
			if self.viewReaches(rank, value: value) and self.valueNamesAPlace(func, value: self.rootValueAt(rank)) 'aViewOfAPlaceItReaches'
				return self.rootNameAt(rank)
			end 'aViewOfAPlaceItReaches'
		end 'eachBindingRoot'

		throw AbsentError.absent
	end 'viewOfAPlaceReachedBy'

	function viewReaches(rank ElementIndex, value ValueId) returns bool
		return self.rootKindAt(rank) == ReadOnlyRootKind.view and self.valueIsOrLiesWithin(value, rank: rank)
	end 'viewReaches'

	function valueNamesAPlace(func IrFunction, value ValueId) returns bool
		if value < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return true
		end 'aParameter'

		self.indexDefinitions(func, ir: self.module)

		if not self.hasDefiningOp(value) 'aMergedValue'
			return true
		end 'aMergedValue'

		return match self.hopKindOf(value) 'hop'
			stop gives false
			field or
			element gives true
			same gives self.valueNamesAPlace(func, value: self.hopBaseOf(value))
		end 'hop'
	end 'valueNamesAPlace'

	function decideSharedSend(func IrFunction, site MoveSite, mutationSummary ParamMutationSummary)
		let (senderMask, senderRecordMask) = mutationSummary.writesOf(func.name)
		let (handlerType, handlerMember) = match splitQualifiedName(site.destination) 'handler'
			parts(prefix, member) gives (prefix, member)
			notQualified panic("ProvenanceTracer.decideSharedSend: the handler '{String.from(site.destination)}' is not a qualified message name")
		end 'handler'

		let parameterSpelling = argLabelSpelling(site.source)
		let blame = serviceSendArgumentBlame(handlerType, methodName: handlerMember, paramName: parameterSpelling)

		let aParameter = valueIsAParameter(site.value, paramCount: func.paramCount)

		if aParameter and maskHasParam(senderMask or senderRecordMask, param: paramPositionOfValueId(site.value)) 'theSenderWritesIt'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticServiceArgumentNotUnique, message: serviceSharedParameterWrittenMessage(blame))
			return
		end 'theSenderWritesIt'

		if self.handlerWritesOrKeeps(mutationSummary, handler: site.destination, parameter: site.source) 'theHandlerWritesIt'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticServiceArgumentNotUnique, message: serviceSharedValueHandledMessage(blame, handler: String.from(site.destination), parameter: String.from(parameterSpelling), shared: "a PARAMETER" if aParameter else "a read-only value"))
		end 'theHandlerWritesIt'
	end 'decideSharedSend'

	function handlerWritesOrKeeps(mutationSummary ParamMutationSummary, handler ByteArray, parameter ByteArray) returns bool
		let handlerIndex = try mutationSummary.funcIndexByName.get(handler) otherwise return true
		let sig = try self.project.funcSignatures.get(handler) otherwise return true
		let position = try positionOfArgLabel(sig.paramNames, label: parameter) otherwise return true
		let (mask, recordMask) = mutationSummary.writesOf(handler)

		return maskHasParam(mask or recordMask or self.keptParameters(handlerIndex, paramCount: sig.paramCount()), param: position)
	end 'handlerWritesOrKeeps'

	function decideServiceReply(func IrFunction, site MoveSite)
		if self.valueIsSwappedOut(func, value: site.value) 'theOnlyHolder'
			return
		end 'theOnlyHolder'

		view spawnSite = serviceSpawnSiteOf(self.signatures, typeName: site.destination)
		reportPositionedWithNote(self.project, code: ErrorCode.semanticServiceReplyAliasesState, message: serviceReplyAliasesStateRefusal(site.destination, methodName: site.source), line: site.line, column: site.column, filePath: func.sourceFilePath, note: DiagnosticNote.at(serviceSpawnNoteText(site.destination), line: spawnSite.line, column: spawnSite.column, filePath: spawnSite.declFilePath))
	end 'decideServiceReply'

	function decideLetFieldMove(func IrFunction, index ElementIndex, site MoveSite, into ReadOnlyRootKind)
		if not (site.readAfter or site.readInALaterIteration) or self.deferToInstantiation(func, value: site.value, owner: index) 'movedHere'
			return
		end 'movedHere'

		self.noteKeptRefused(site.sourceValue, line: site.line, column: site.column)
		self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetKeptStoreMessage(into, subject: "the `var` '{String.from(site.source)}', which is read again,", place: String.from(site.destination)))
	end 'decideLetFieldMove'

	function decideMutablePlaceStore(func IrFunction, index ElementIndex, site MoveSite)
		if site.value < valueIdAtParamPosition(func.paramCount) or self.valueIsInertAtADoor(func, value: site.value) 'callersOwnOrNoWriter'
			return
		end 'callersOwnOrNoWriter'

		_ = self.bindingsTraceOf(func, index: index)
		view blamed = self.firstKeptRoot(func, value: site.value, token: site.token, names: RootCondition.aStoredName)
		let subject = try self.storedValueSubject(func, value: site.value, blamed: blamed, token: site.token) otherwise return

		if self.deferToInstantiation(func, value: site.value, owner: index) 'decidedWhereItIsInstantiated'
			return
		end 'decidedWhereItIsInstantiated'

		self.noteKeptRefused(site.value, line: site.line, column: site.column)
		self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetStoreMessage(subject, place: String.from(site.destination)))
	end 'decideMutablePlaceStore'

	function storedValueSubject(func IrFunction, value ValueId, blamed WriteBlame, token ElementIndex) returns String throws AbsentError
		if blamed.isBlamed() and self.valueIsANamedRoot(value) 'theStoredName'
			let own = try self.bindingRankOf(value) otherwise panic("ProvenanceTracer.storedValueSubject: a named root has a rank")
			return self.storedRootSubject(func, value: value, root: String.from(self.rootNameAt(own)), kind: self.rootKindAt(own), token: token)
		end 'theStoredName'

		if let name = try blamed.blamedName() 'aNamedRoot'
			return self.storedRootSubject(func, value: value, root: String.from(name), kind: blamed.rootKind(), token: token)
		end 'aNamedRoot'

		if self.valueIsOrLiesWithinAModuleLet(func, value: value) 'aModuleLetsRecordHandedBack'
			return self.storedRootSubject(func, value: value, root: "", kind: ReadOnlyRootKind.moduleLet, token: token)
		end 'aModuleLetsRecordHandedBack'

		throw AbsentError.absent
	end 'storedValueSubject'

	function firstKeptRoot(func IrFunction, value ValueId, token ElementIndex, names RootCondition) returns WriteBlame
		if self.hasWritableRank(value) 'aVarHoldsAWritableRecord'
			return WriteBlame.unblamed
		end 'aVarHoldsAWritableRecord'

		let bound = self.rootNames.count() as ElementIndex
		var rank = bound
		self.askAtDoor(token)

		if let own = try self.bindingRankOf(value) 'aBindingsOwnValue'
			if self.rootCountsAtDoor(own) and self.rootMeets(names, rank: own, value: value, func: func) 'itCounts'
				rank = own
			end 'itCounts'
		end 'aBindingsOwnValue'

		if rank == bound 'notOneBindingsOwn'
			rank = self.leastAdmittedRank(func, column: ProvenanceColumn.identity, value: value, bound: bound, also: names)
			rank = self.leastAdmittedRank(func, column: ProvenanceColumn.inside, value: value, bound: rank, also: names)
		end 'notOneBindingsOwn'

		self.leaveDoor()

		if rank >= bound 'noKeptName'
			return WriteBlame.unblamed
		end 'noKeptName'

		return self.blameOfRootAt(rank)
	end 'firstKeptRoot'

	function decideLetFieldValue(func IrFunction, index ElementIndex, site MoveSite, into ReadOnlyRootKind)
		if site.value < valueIdAtParamPosition(func.paramCount) or self.valueGivesAStoreNoWriter(func, value: site.value) or self.deferToInstantiation(func, value: site.value, owner: index) 'callersOwnNoWriterOrDeferred'
			return
		end 'callersOwnNoWriterOrDeferred'

		_ = self.bindingsTraceOf(func, index: index)

		if let name = try self.viewOfAPlaceReachedBy(func, value: site.value) 'aViewIsKept'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetKeptStoreMessage(into, subject: deepLetStoredRootSubject(String.from(name), kind: ReadOnlyRootKind.view), place: String.from(site.destination)))
			return
		end 'aViewIsKept'

		if self.acceptsAsSole(func, value: site.value) 'soleToTheStore'
			return
		end 'soleToTheStore'

		self.noteKeptReadOnly(func, value: site.value, at: positionKey(site.line, column: site.column))

		if self.keptValueIsReadOnly(func, value: site.value) or (not self.valueIsHandedOut(func, value: site.value) and self.valueTakesNoOtherWriter(func, value: site.value, placedByTheStore: true)) 'readOnlyOrNoOtherWriter'
			return
		end 'readOnlyOrNoOtherWriter'

		self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetKeptStoreMessage(into, subject: "a value other names may still write", place: String.from(site.destination)))
	end 'decideLetFieldValue'

	// Does the body at `index` write through a record — a field, a receiver, an argument a callee writes — while it
	// may be handed one a module-level `let` holds?
	function mayWriteThroughAModuleLetsRecord(index ElementIndex, sites ProvenanceSites) returns bool
		if not self.mayBeHandedAModuleLetsRecordAt(index) 'handedNone'
			return false
		end 'handedNone'

		return sites.writeThroughSites.count() > 0 or sites.receiverWrites.count() > 0 or self.writesAnArgumentAt(index)
	end 'mayWriteThroughAModuleLetsRecord'

	// The written arguments are noted in function order, so once the entries of every earlier function are passed —
	// the doors of a function they skipped ask nothing of its entries — the next one is this function's when it has
	// any.
	function writesAnArgumentAt(index ElementIndex) returns bool
		while self.writtenArgCursor < self.writtenArgFuncs.count() 'passEarlierFunctions'
			let owner = try self.writtenArgFuncs.get(self.writtenArgCursor) otherwise panic("ProvenanceTracer.writesAnArgumentAt: writtenArgFuncs.get OOB below its own count")

			if owner >= index 'reachedThisFunction'
				return owner == index
			end 'reachedThisFunction'

			self.writtenArgCursor = self.writtenArgCursor + 1
		end 'passEarlierFunctions'

		return false
	end 'writesAnArgumentAt'

	// ⭐ **E3078: A `var` WHOSE INITIALIZER MAY HAND IT A MODULE-LEVEL `let`'S RECORD.** `__module_init` is traced like
	// any body, so each value it stores into a `var`'s slot carries what its call tree may hand it — a nested call's
	// result through the summary of the call it was handed to, and nothing for a number read out of a `let`.
	module function checkVarInitializersTakeNoSharedRecord(funcNames FunctionNameIndex)
		// Every record-holding `let` may be imaged, and then the program has no `__module_init` to trace.
		let initIndex = try funcNames.byName.get(ModuleInitName) otherwise return
		let init = try funcNames.functions.get(initIndex) otherwise panic("ProvenanceTracer.checkVarInitializersTakeNoSharedRecord: functions.get OOB at {initIndex}")
		var varsByLabel = ManagedGlobalByLabel.create()

		for global in self.project.managedGlobals 'eachGlobal'
			if global.isAVar() 'aVar'
				varsByLabel.upsert(global.label, value: global)
			end 'aVar'
		end 'eachGlobal'

		self.traceParameters(init, index: initIndex)

		for blockRef in init.blockRefs 'eachBlock'
			view block = self.module.getBlock(blockRef)

			for opIdx in block.bodyOps() 'eachOp'
				view op = try self.module.ops.get(opIdx) otherwise panic("ProvenanceTracer.checkVarInitializersTakeNoSharedRecord: opRef {opIdx} not in module.ops")

				if not opLoadsOrStoresASlot(op) 'neitherLoadsNorStores'
					continue
				end 'neitherLoadsNorStores'

				match slotReadOfOp(op, opIndex: opIdx) 'slot'
					store(addr, _, value) then self.refuseAVarTakingASharedRecord(init, addr: addr, value: value, varsByLabel: varsByLabel)
					none or
					load or
					retainOf then continue
				end 'slot'
			end 'eachOp'
		end 'eachBlock'
	end 'checkVarInitializersTakeNoSharedRecord'

	module function bodyWasRefused(name ByteArray) returns bool
		let index = try self.calls.resolution.functionIndexNamed(name) otherwise return false
		return try self.refusedBodies.get(index) otherwise panic("ProvenanceTracer.bodyWasRefused: refusedBodies.get OOB at {index}")
	end 'bodyWasRefused'

	function refuseAVarTakingASharedRecord(init IrFunction, addr ValueId, value ValueId, varsByLabel ManagedGlobalByLabel)
		let takesAViewsRecord = self.valueReachesRank(value, rank: self.sharedViewRank())
		let takesALetFieldsRecord = not takesAViewsRecord and self.valueReachesRank(value, rank: self.letFieldRank())
		let takesALetPayloadsRecord = not takesAViewsRecord and not takesALetFieldsRecord and self.valueReachesRank(value, rank: self.letPayloadRank())
		let takesAReadOnlyElementsRecord = not takesAViewsRecord and not takesALetFieldsRecord and not takesALetPayloadsRecord and self.valueReachesRank(value, rank: self.readOnlyElementRank())

		if not takesAViewsRecord and not takesALetFieldsRecord and not takesALetPayloadsRecord and not takesAReadOnlyElementsRecord and not self.valueReachesRank(value, rank: self.moduleLetRank()) 'takesNoSharedRecord'
			return
		end 'takesNoSharedRecord'

		view addressOp = self.definingOpIn(init, value: addr, subject: "a slot address")

		if not maxonOpNamesAGlobalLabel(addressOp) 'notAGlobalsSlot'
			return
		end 'notAGlobalsSlot'

		let global = try varsByLabel.get(maxonOpGlobalLabelName(addressOp)) otherwise 'notAVarsSlot'
			return
		end 'notAVarsSlot'

		let varName = String.from(global.declName)
		view producer = self.definingOpIn(init, value: value, subject: "the record `{varName}` is filled with")

		if maxonOpCalleeKind(producer) == MaxonCalleeKind.direct and self.bodyWasRefused(maxonOpCalleeName(producer)) 'theProducerAlreadyAnswered'
			return
		end 'theProducerAlreadyAnswered'

		let callee = String.from(maxonOpCalleeName(producer)) if maxonOpCalleeKind(producer) == MaxonCalleeKind.direct else "a field read"
		let message = varInitializerTakesAViewsRecordMessage(varName, callee: callee) if takesAViewsRecord else varInitializerTakesALetFieldRecordMessage(varName, callee: callee) if takesALetFieldsRecord else varInitializerTakesALetPayloadRecordMessage(varName, callee: callee) if takesALetPayloadsRecord else varInitializerTakesAReadOnlyElementRecordMessage(varName, callee: callee) if takesAReadOnlyElementsRecord else varInitializerTakesALetRecordMessage(varName, callee: callee)
		reportPositioned(self.project, code: ErrorCode.semanticVarFromImmutable, message: message, line: global.nameLine, column: global.nameColumn, filePath: global.declFilePath)
	end 'refuseAVarTakingASharedRecord'

	// The op of `__module_init` that defines `value`, which every value a store there names has.
	function definingOpIn(init IrFunction, value ValueId, subject String) returns MaxonOp
		return match self.definingOpOf(init, ir: self.module, value: value) 'defined'
			op(opIndex) gives try self.module.ops.get(opIndex) otherwise panic("ProvenanceTracer.definingOpIn: op {opIndex} not in module.ops")
			notAnOp panic("ProvenanceTracer.definingOpIn: {subject} in `__module_init` is defined by no op — every value a store there names is one an op of it defines")
		end 'defined'
	end 'definingOpIn'

	// ⭐ **WHICH BODIES MAY BE HANDED A MODULE-LEVEL `let`'S RECORD BY A CALL** — a callee whose summary says it may
	// hand one back, or a dispatch, whose landing bodies only a trace resolves. Settled once the
	// summaries are.
	function markBodiesHandedAModuleLetsRecord(funcNames FunctionNameIndex)
		for func in funcNames.functions 'eachFunc'
			self.handedAModuleLetsRecord.push(self.callMayHandBackAModuleLetsRecord(func))
		end 'eachFunc'
	end 'markBodiesHandedAModuleLetsRecord'

	function callMayHandBackAModuleLetsRecord(func IrFunction) returns bool
		for blockRef in func.blockRefs 'eachBlock'
			view block = try self.module.blocks.get(blockRef) otherwise panic("ProvenanceTracer.callMayHandBackAModuleLetsRecord: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				view op = try self.module.ops.get(opIdx) otherwise panic("ProvenanceTracer.callMayHandBackAModuleLetsRecord: opRef {opIdx} not in module.ops")

				if self.opLoadsALetFieldRecord(func, op: op) 'readsALetField'
					return true
				end 'readsALetField'

				if self.opReadsAReadOnlyElement(func, op: op) 'readsAReadOnlyElement'
					return true
				end 'readsAReadOnlyElement'

				match runTimeTargetOf(op) 'target'
					closureValue or
					witnessSlot then return true
					named then break
				end 'target'

				match maxonOpCalleeKind(op) 'kind'
					direct then break
					functionValue or
					noCallee then continue
				end 'kind'

				if self.opReadsASharedView(op) 'readsAView'
					return true
				end 'readsAView'

				if let calleeIndex = try self.calls.resolution.functionIndexNamed(maxonOpCalleeName(op)) 'aDeclaredCallee'
					if self.summary.resultMayReachAModuleLet(calleeIndex) 'handsOneBack'
						return true
					end 'handsOneBack'
				end 'aDeclaredCallee'
			end 'eachOp'
		end 'eachBlock'

		return false
	end 'callMayHandBackAModuleLetsRecord'

	function mayBeHandedAModuleLetsRecordAt(index ElementIndex) returns bool
		return try self.handedAModuleLetsRecord.get(index) otherwise panic("ProvenanceTracer.mayBeHandedAModuleLetsRecordAt: handedAModuleLetsRecord.get OOB at {index} — it is filled over every function")
	end 'mayBeHandedAModuleLetsRecordAt'

	// Are the arguments a call of the entered function hands a writing parameter asked about — because it holds an
	// immutable name, or because a call may hand it a module-level `let`'s record?
	module function enteredFunctionAsksWrittenArguments(func IrFunction) returns bool
		return func.filesImmutableBindings() or filesVarCandidates(func.provenanceSites(self.noSites)) or self.mayBeHandedAModuleLetsRecordAt(self.enteredIndex)
	end 'enteredFunctionAsksWrittenArguments'

	// ⭐⭐ **A NAME HANDED WHOLE TO A MUTABLE DOOR: MOVED IF IT IS ITS RECORD'S SOLE REFERENCE, REFUSED OTHERWISE.**
	// A `let` bound to a fresh record and named by nothing else live moves: its next read is E3102, and a move out
	// of a loop it was declared outside of is E2015, as the parser's own is. A `let` that aliases, borrows, lies
	// within another name's record or is a module-level `let` cannot move, and is refused at the door. A `var`'s
	// door is asked only for E3077 (`varIsNeededMutable`).
	function checkMoveSites(func IrFunction)
		view sites = func.provenanceSites(self.noSites).moveSites

		for k in moveSitesInTokenOrder(sites) 'eachSite'
			view site = try sites.get(k) otherwise panic("ProvenanceTracer.checkMoveSites: moveSites.get OOB at {k}")

			if not site.sourceIsMutable and site.destinationKind == MoveDestinationKind.mutableName 'aLetsDoor'
				self.decideMoveSite(func, site: site)
			end 'aLetsDoor'
		end 'eachSite'
	end 'checkMoveSites'

	// Moves or refuses the name `site` bound or assigned to a mutable name.
	function decideMoveSite(func IrFunction, site MoveSite)
		// A `let` made from a `var` (`let u = t`, which moved `t`) is no root: it is its record's owner.
		let rank = try self.bindingRankOf(site.sourceValue) otherwise 'ownsWhatTheVarGaveIt'
			self.reportReadAfterMove(site)
			return
		end 'ownsWhatTheVarGaveIt'

		if self.rootIsModuleLetAt(rank) 'cannotMove'
			self.refuseBinding(site)
			return
		end 'cannotMove'

		// A name an earlier door moved is read by this one, which that door's E3102 already reports.
		if (try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.decideMoveSite: rootMovedAt.get OOB at {rank}")) < site.token 'alreadyMoved'
			return
		end 'alreadyMoved'

		if self.rootIsKeptReadOnlyBefore(func, rank: rank, door: positionKey(site.line, column: site.column)) 'keptByALetSlot'
			self.refuseBinding(site)
			return
		end 'keptByALetSlot'

		if self.rootIsSoleAt(func, rank: rank, token: site.token) or self.rootReachesTheDoorUnhanded(func, rank: rank, site: site) 'theRecordsOwner'
			self.moveAt(site, rank: rank)
			return
		end 'theRecordsOwner'

		if self.rootIsWatchedAfter(func, rank: rank, token: site.token) 'stillImmutable'
			self.refuseBinding(site)
		end 'stillImmutable'
	end 'decideMoveSite'

	function refuseBinding(site MoveSite)
		self.noteRefusedDoor(site.value)
		self.noteRefusedDoor(site.sourceValue)
		self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetBindMessage(readOnlyNameSubject(String.from(site.source)), binding: String.from(site.destination)))
	end 'refuseBinding'

	// The name `site` handed over is moved there: a read of it after is E3102, a move out of a loop it outlives is
	// E2015.
	function moveAt(site MoveSite, rank ElementIndex)
		let before = try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.moveAt: rootMovedAt.get OOB at {rank}")

		if site.token < before 'earlier'
			try self.rootMovedAt.set(rank, value: site.token) otherwise panic("ProvenanceTracer.moveAt: rootMovedAt.set OOB at {rank}")
		end 'earlier'

		self.reportReadAfterMove(site)
	end 'moveAt'

	function reportReadAfterMove(site MoveSite)
		if site.readAfter 'readOnceMoved'
			self.refuse(site.readLine, column: site.readColumn, code: ErrorCode.useAfterMove, message: movedValueReadMessage(site))
		end 'readOnceMoved'
	end 'reportReadAfterMove'

	// ⭐ **IS BINDING ROOT `rank` ITS RECORD'S SOLE REFERENCE AT `token`?** It owns its record
	// (`settleBindingRoots`), and no other immutable name live there may be it, lie within it or hold it — a
	// `let u = relay(t)` still reading `t`'s record would watch what the mutable door writes.
	function rootIsSoleAt(func IrFunction, rank ElementIndex, token ElementIndex) returns bool
		if not (try self.rootSoleBase.get(rank) otherwise panic("ProvenanceTracer.rootIsSoleAt: rootSoleBase.get OOB at {rank}")) 'notItsOwn'
			return false
		end 'notItsOwn'

		for other in 0 upto self.rootNames.count() 'eachOtherName'
			if other == rank or self.rootIsModuleLetAt(other) or not self.rootIsLiveAt(other, token: token) 'cannotWatch'
				continue
			end 'cannotWatch'

			if self.rootReachesRoot(func, holder: other, rank: rank) 'watches'
				return false
			end 'watches'
		end 'eachOtherName'

		return true
	end 'rootIsSoleAt'

	function rootReachesTheDoorUnhanded(func IrFunction, rank ElementIndex, site MoveSite) returns bool
		if not (try self.rootSoleBase.get(rank) otherwise panic("ProvenanceTracer.rootReachesTheDoorUnhanded: rootSoleBase.get OOB at {rank}")) 'notItsOwn'
			return false
		end 'notItsOwn'

		view ir = self.module
		let value = self.rootValueAt(rank)
		self.indexDefinitions(func, ir: ir)
		let defining = try self.definingOpIndexOf(value) otherwise return false
		let bound = try self.opPositionKeyAt(defining) otherwise return false
		let door = positionKey(site.line, column: site.column)

		if bound >= door 'noSpanToRead'
			return false
		end 'noSpanToRead'

		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootReachesTheDoorUnhanded: rootDeclTokens.get OOB at {rank}")

		for other in 0 upto self.rootNames.count() 'eachOtherName'
			let otherDeclared = try self.rootDeclTokens.get(other) otherwise panic("ProvenanceTracer.rootReachesTheDoorUnhanded: rootDeclTokens.get OOB at {other}")

			if other != rank and otherDeclared > declared and otherDeclared < site.token and self.rootValueAt(other) == value 'boundAgain'
				return false
			end 'boundAgain'
		end 'eachOtherName'

		for blockRef in func.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.rootReachesTheDoorUnhanded: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				if opIdx == defining or not self.opLiesBetween(opIdx, bound: bound, door: door) 'outsideTheSpan'
					continue
				end 'outsideTheSpan'

				if self.operandsCarryRank(try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.rootReachesTheDoorUnhanded: opIdx {opIdx} not in module.ops"), rank: rank) 'handedOn'
					return false
				end 'handedOn'
			end 'eachOp'
		end 'eachBlock'

		return true
	end 'rootReachesTheDoorUnhanded'

	function opLiesBetween(opIndex ElementIndex, bound PositionKey, door PositionKey) returns bool
		let at = try self.opPositionKeyAt(opIndex) otherwise return true
		return at > bound and at < door
	end 'opLiesBetween'

	function opPositionKeyAt(opIndex ElementIndex) returns PositionKey throws AbsentError
		match self.project.opRanges.placementOf(opIndex) 'placed'
			unplaced then throw AbsentError.absent
			at(line, column) then return positionKey(line, column: column)
		end 'placed'
	end 'opPositionKeyAt'

	function operandsCarryRank(op MaxonOp, rank ElementIndex) returns bool
		maxonOpOperandValues(op, into: self.operands)

		for operand in self.operands 'eachOperand'
			if self.isTracked(operand) and (self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: operand), rank: rank)) 'carriesIt'
				return true
			end 'carriesIt'
		end 'eachOperand'

		return false
	end 'operandsCarryRank'

	// Was binding root `rank` bound before `token`, is it read after it, and was it not moved before it? A read
	// that ends at `token` is the door's own.
	function rootIsLiveAt(rank ElementIndex, token ElementIndex) returns bool
		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootIsLiveAt: rootDeclTokens.get OOB at {rank}")
		let movedAt = try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.rootIsLiveAt: rootMovedAt.get OOB at {rank}")
		return declared < token and movedAt >= token and self.rootReadAfter(rank, token: token)
	end 'rootIsLiveAt'

	function rootIsCaptured(rank ElementIndex) returns bool
		return try self.rootCaptured.get(rank) otherwise panic("ProvenanceTracer.rootIsCaptured: rootCaptured.get OOB at {rank}")
	end 'rootIsCaptured'

	function rootIsModuleLetAt(rank ElementIndex) returns bool
		return try self.rootIsModuleLet.get(rank) otherwise panic("ProvenanceTracer.rootIsModuleLetAt: rootIsModuleLet.get OOB at {rank}")
	end 'rootIsModuleLetAt'

	function rootIsViewAt(rank ElementIndex) returns bool
		return (try self.rootInfos.get(rank) otherwise panic("ProvenanceTracer.rootIsViewAt: rootInfos.get OOB at {rank}")).isView()
	end 'rootIsViewAt'

	function rootIsLiveEverywhere(rank ElementIndex) returns bool
		return self.rootIsModuleLetAt(rank) or self.rootIsCaptured(rank) or self.rootIsViewAt(rank)
	end 'rootIsLiveEverywhere'

	function rootIsAKeptName(rank ElementIndex) returns bool
		return not self.rootIsModuleLetAt(rank) and (self.rootKindAt(rank) == ReadOnlyRootKind.letBinding or self.rootKindAt(rank) == ReadOnlyRootKind.view)
	end 'rootIsAKeptName'

	function rootIsAStoredName(rank ElementIndex) returns bool
		return self.rootIsModuleLetAt(rank) or self.rootIsAKeptName(rank)
	end 'rootIsAStoredName'

	// Was binding root `rank` moved by a door no later than the one being asked about (`doorToken`)?
	function rootMovedBeforeAsked(rank ElementIndex) returns bool
		if rank >= self.rootMovedAt.count() 'notABinding'
			return false
		end 'notABinding'

		return (try self.rootMovedAt.get(rank) otherwise panic("ProvenanceTracer.rootMovedBeforeAsked: rootMovedAt.get OOB at {rank}")) <= self.doorToken
	end 'rootMovedBeforeAsked'

	// The door at `token` is the one asked about until `leaveDoor`.
	function askAtDoor(token ElementIndex)
		self.doorToken = token
	end 'askAtDoor'

	function leaveDoor()
		self.doorToken = NoDoorToken
	end 'leaveDoor'

	// ⭐ **DOES ROOT `rank` MATTER AT THE DOOR BEING ASKED?** Not once a door moved it, nor when it was
	// refused where it is bound (`checkLetBindings`), whose refusal answers for it, nor for a `let` tuple's
	// hidden temp, whose named elements answer for it. A module-level
	// `let` is live everywhere, and a `view` at every door past its declaration. Any other `let` only
	// while it is live after the door: a record no live immutable name reaches is only its mutable
	// holders' to share.
	function rootCountsAtDoor(rank ElementIndex) returns bool
		if not self.isImmutableBindingRank(rank) 'aParameterOrAVarsRecord'
			return true
		end 'aParameterOrAVarsRecord'

		if self.rootKindAt(rank) == ReadOnlyRootKind.destructuredTuple 'itsNamesAreJudgedOnTheirOwn'
			return false
		end 'itsNamesAreJudgedOnTheirOwn'

		if rank < self.letRefused.count() and (try self.letRefused.get(rank) otherwise panic("ProvenanceTracer.rootCountsAtDoor: letRefused.get OOB at {rank}")) 'refusedWhereItIsBound'
			return false
		end 'refusedWhereItIsBound'

		if self.rootMovedBeforeAsked(rank) 'moved'
			return false
		end 'moved'

		if self.rootIsViewAt(rank) 'aViewIsLiveOnceDeclared'
			return self.doorToken == NoDoorToken or (try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootCountsAtDoor: rootDeclTokens.get OOB at {rank}")) < self.doorToken
		end 'aViewIsLiveOnceDeclared'

		if self.rootIsModuleLetAt(rank) 'liveEverywhere'
			return true
		end 'liveEverywhere'

		// A `let` bound after the door — later in the body of a loop the door is in, too — reads nothing yet: the
		// binding a previous trip made was read for the last time on that trip.
		if self.doorToken == NoDoorToken 'everyRootCounts'
			return true
		end 'everyRootCounts'

		let declared = try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.rootCountsAtDoor: rootDeclTokens.get OOB at {rank}")
		return declared < self.doorToken and self.rootReadAfter(rank, token: self.doorToken)
	end 'rootCountsAtDoor'

	// ⭐ **IS A `let` THAT IS NOT ITS RECORD'S SOLE REFERENCE WATCHED AFTER THE DOOR AT `token`?** Read there
	// again, or its record reached by another immutable name bound before the door and live after it. A borrow
	// nothing reads again hands the door a record only mutable holders go on reaching.
	function rootIsWatchedAfter(func IrFunction, rank ElementIndex, token ElementIndex) returns bool
		if self.rootReadAfter(rank, token: token) 'readAgain'
			return true
		end 'readAgain'

		self.askAtDoor(token)
		var watched = false

		for other in 0 upto self.rootNames.count() 'eachOtherName'
			let declared = try self.rootDeclTokens.get(other) otherwise panic("ProvenanceTracer.rootIsWatchedAfter: rootDeclTokens.get OOB at {other}")

			if other == rank or declared >= token or not self.rootCountsAtDoor(other) 'cannotWatch'
				continue
			end 'cannotWatch'

			if self.rootsShareARecord(func, rank: rank, other: other) 'watches'
				watched = true
				break
			end 'watches'
		end 'eachOtherName'

		self.leaveDoor()
		return watched
	end 'rootIsWatchedAfter'

	// May root `other`'s record be root `rank`'s, lie within it, or hold it — or the reverse? Asked of each pair
	// only as far as their types allow: one record is never two declared types, and a record holds only the kinds
	// its type can.
	function rootsShareARecord(func IrFunction, rank ElementIndex, other ElementIndex) returns bool
		return self.rootReachesRoot(func, holder: other, rank: rank) or self.rootReachesRoot(func, holder: rank, rank: other)
	end 'rootsShareARecord'

	function rootReachesRoot(func IrFunction, holder ElementIndex, rank ElementIndex) returns bool
		let value = self.rootValueAt(holder)

		if self.rootValueMayBeRank(func, holder: holder, rank: rank) and self.valuesMayBeOneRecord(func, value: value, other: self.rootValueAt(rank)) 'mayBeIt'
			return true
		end 'mayBeIt'

		if self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: value), rank: rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: false) 'liesWithinIt'
			return true
		end 'liesWithinIt'

		return self.valueHoldsRank(value, rank: rank) and self.typeAdmits(func, value: self.rootValueAt(rank), rank: holder, asksIdentity: false)
	end 'rootReachesRoot'

	function rootValueMayBeRank(func IrFunction, holder ElementIndex, rank ElementIndex) returns bool
		let value = self.rootValueAt(holder)
		return self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) and self.slotMayHoldRoot(func, ir: self.module, rank: rank, value: value)
	end 'rootValueMayBeRank'

	// May `value` be, lie within, or hold root `rank`'s record?
	function valueReachesRank(value ValueId, rank ElementIndex) returns bool
		return self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: value), rank: rank) or self.valueHoldsRank(value, rank: rank)
	end 'valueReachesRank'

	function valueHoldsRank(value ValueId, rank ElementIndex) returns bool
		return self.sets.hasRank(self.setOf(ProvenanceColumn.holds, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.storedHolds, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.deepHolds, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.holdsWithin, value: value), rank: rank)
	end 'valueHoldsRank'

	// ⭐⭐ **A MUTABLE NAME MAY NOT TAKE AN IMMUTABLE NAME'S STORAGE THROUGH A VALUE, WHERE THE PARSER
	// JUDGES A NAME.** Each site is a `var` bound or assigned a value no bare `let` names. It is
	// refused when that value may be or lie within the record of an immutable name live after it (a
	// module `let` read here is one). A value that only HOLDS such a record is no door: what is
	// written through it is (`checkWriteThroughSites`).
	function checkMutableBindingSites(func IrFunction, ir MaxonModule, index ElementIndex)
		for site in func.provenanceSites(self.noSites).mutableBindingSites 'eachSite'
			self.askAtDoor(site.token)

			if self.valueIsInertAtADoor(func, value: site.value) 'noWriterToShare'
				continue
			end 'noWriterToShare'

			let view = self.maybePermanentViewOf(site.value)

			if view != PermanentView.none and self.deferToInstantiation(func, value: site.value, owner: index) 'decidedWhereItIsInstantiated'
				continue
			end 'decidedWhereItIsInstantiated'

			if view != PermanentView.none 'aPermanentViewsRecord'
				self.noteRefusedDoor(site.value)
				self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetBindMessage(unattributedSharingSubject(viewRootKind(view)), binding: String.from(site.name)))
				continue
			end 'aPermanentViewsRecord'

			if let rank = try self.bindingRankOf(site.value) 'anImmutableNamesOwnRecord'
				if self.isImmutableBindingRank(rank) and self.rootCountsAtDoor(rank) 'stillImmutable'
					self.noteRefusedDoor(site.value)
					self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetBindMessage(readOnlyNameSubject(String.from(self.rootNameAt(rank))), binding: String.from(site.name)))
				end 'stillImmutable'

				continue
			end 'anImmutableNamesOwnRecord'

			if self.valueReachesARefusedKeep(site.value) 'answeredByTheRefusedKeep'
				continue
			end 'answeredByTheRefusedKeep'

			let aModuleLetsRecord = self.valueIsOrLiesWithinAModuleLet(func, value: site.value)

			// Only a record the `var` goes on to write reaches what a live `let` reads (`boundValueIsWrittenThrough`);
			// a module-level `let` is read-only for the program's whole life, so a `var` may not hold its record at all.
			if not aModuleLetsRecord and not self.boundValueIsWrittenThrough(site.value) 'onlyReadAndRebound'
				continue
			end 'onlyReadAndRebound'

			if aModuleLetsRecord or self.firstRootName(func, value: site.value, reach: RootReach.identityOrInside).isBlamed() 'sharesAnImmutableNamesStorage'
				self.noteRefusedDoor(site.value)
				self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetBindMessage(self.sharedStorageSubject(func, ir: ir, value: site.value, token: site.token), binding: String.from(site.name)))
			end 'sharesAnImmutableNamesStorage'
		end 'eachSite'

		self.leaveDoor()
	end 'checkMutableBindingSites'

	function checkLetBindings(func IrFunction, bindingCount ElementIndex, index ElementIndex)
		self.indexDefinitions(func, ir: self.module)
		self.letRefused.refill(bindingCount, value: false)
		let alreadyReported = self.letCheckedValid and self.letCheckedIndex == index
		self.letCheckedValid = true
		self.letCheckedIndex = index

		for rank in 0 upto bindingCount 'eachBinding'
			if self.rootKindAt(rank) != ReadOnlyRootKind.letBinding 'notALetBinding'
				continue
			end 'notALetBinding'

			self.askAtDoor(try self.rootDeclTokens.get(rank) otherwise panic("ProvenanceTracer.checkLetBindings: rootDeclTokens.get OOB at {rank}"))
			let reached = try self.firstWritableStateReached(func, value: self.rootValueAt(rank), rank: rank) otherwise continue
			try self.letRefused.set(rank, value: true) otherwise panic("ProvenanceTracer.checkLetBindings: letRefused.set OOB at {rank}")

			if alreadyReported 'queuedByAnEarlierTrace'
				continue
			end 'queuedByAnEarlierTrace'

			view info = try self.rootInfos.get(rank) otherwise panic("ProvenanceTracer.checkLetBindings: rootInfos.get OOB at {rank}")
			self.refuse(info.declaredLine, column: info.declaredColumn, code: ErrorCode.semanticLetBindsWritableState, message: letBindsWritableStateMessage(String.from(self.rootNameAt(rank)), through: self.writableRootName(func, rank: reached)))
		end 'eachBinding'

		self.leaveDoor()
	end 'checkLetBindings'

	function firstWritableStateReached(func IrFunction, value ValueId, rank ElementIndex) returns ElementIndex throws AbsentError
		if self.valueIsInertAtADoor(func, value: value) or self.permanentViewOf(value) != PermanentView.none 'nothingWritableCanBeReached'
			throw AbsentError.absent
		end 'nothingWritableCanBeReached'

		let beyondEveryRank = self.writableRank + 1
		var varsOwnRank = beyondEveryRank

		if let own = try self.writableRankOf(value) 'theValueOfAVar'
			varsOwnRank = own
		end 'theValueOfAVar'

		var found = beyondEveryRank

		for column in LetReachColumns 'eachColumn'
			found = self.lowestWritableRankIn(func, column: column, value: value, rank: rank, skipped: varsOwnRank, bound: found)
		end 'eachColumn'

		found = self.lowestWritableRankPlacedByTheCall(func, value: value, rank: rank, skipped: varsOwnRank, bound: found)

		if varsOwnRank < found and self.sets.hasWords(self.setOf(ProvenanceColumn.placedWithin, value: value)) 'theVarsRecordWasStoredElsewhere'
			found = varsOwnRank
		end 'theVarsRecordWasStoredElsewhere'

		if found >= beyondEveryRank 'nothingWritableIsReached'
			throw AbsentError.absent
		end 'nothingWritableIsReached'

		return found
	end 'firstWritableStateReached'

	function valueReachesWritableState(func IrFunction, value ValueId, rank ElementIndex) returns bool
		self.indexDefinitions(func, ir: self.module)
		_ = try self.firstWritableStateReached(func, value: value, rank: rank) otherwise return false
		return true
	end 'valueReachesWritableState'

	function lowestWritableRankPlacedByTheCall(func IrFunction, value ValueId, rank ElementIndex, skipped ElementIndex, bound ElementIndex) returns ElementIndex
		let defining = try self.definingOpIndexOf(value) otherwise return bound
		view op = try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.lowestWritableRankPlacedByTheCall: op {defining} not in module.ops")
		view callee = try freshCalleeOf(op) otherwise return bound
		let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) otherwise return bound
		let placed = self.summary.placedWithinAt(calleeIndex)

		if placed == NoParamPositions 'placesNothingInItsArguments'
			return bound
		end 'placesNothingInItsArguments'

		view sig = self.calls.resolution.signatureOf(callee)
		var lowest = bound

		for position in 0 upto sig.paramCount() 'eachParameter'
			if not maskHasParam(placed, param: position) 'notPlacedIn'
				continue
			end 'notPlacedIn'

			let argument = try calledArgumentAt(op, sig: sig, position: position) otherwise continue

			if let own = try self.writableRankOf(argument) 'aVarsOwnRecord'
				if own < lowest and not self.varMovedBeforeDoor(own) 'lower'
					lowest = own
				end 'lower'
			end 'aVarsOwnRecord'

			lowest = self.lowestWritableRankIn(func, column: ProvenanceColumn.identity, value: argument, rank: rank, skipped: skipped, bound: lowest)
			lowest = self.lowestWritableRankIn(func, column: ProvenanceColumn.inside, value: argument, rank: rank, skipped: skipped, bound: lowest)
		end 'eachParameter'

		return lowest
	end 'lowestWritableRankPlacedByTheCall'

	function lowestWritableRankIn(func IrFunction, column ProvenanceColumn, value ValueId, rank ElementIndex, skipped ElementIndex, bound ElementIndex) returns ElementIndex
		var lowest = bound

		if var chunk = try self.sets.first(self.setOf(column, value: value)) 'hasWords'
			while true 'eachWord'
				let word = self.sets.indexOf(chunk)

				if word < self.mutablePlaceWords.count() as MaskWordCount 'mayHoldAMutablePlace'
					let candidates = self.sets.wordOf(chunk) and (try self.callWrittenPlaceWords.get(word) otherwise panic("ProvenanceTracer.lowestWritableRankIn: callWrittenPlaceWords.get OOB at {word}"))
					let firstRank = (word) shl RootWordShift

					for bit in 0 upto RootBitIndexMask + 1 'eachBit'
						let candidate = firstRank + bit

						if candidate >= lowest 'pastTheLowest'
							break
						end 'pastTheLowest'

						if maskHasParam(candidates, param: bit as ParamCount) and candidate != skipped and not (self.varMovedBeforeDoor(candidate) if column == ProvenanceColumn.placedWithin else self.varGoneBeforeDoor(candidate)) and not self.isTheParameterItselfWrittenOnlyByACall(column, value: value, candidate: candidate) and self.writableRankAdmits(func, column: column, value: value, rank: rank, candidate: candidate) 'admitted'
							lowest = candidate
							break
						end 'admitted'
					end 'eachBit'
				end 'mayHoldAMutablePlace'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return lowest
	end 'lowestWritableRankIn'

	function isTheParameterItselfWrittenOnlyByACall(column ProvenanceColumn, value ValueId, candidate ElementIndex) returns bool
		if column != ProvenanceColumn.identity or candidate >= self.writableRank or self.rootValueAt(candidate) != value 'notTheParameterAlias'
			return false
		end 'notTheParameterAlias'

		return not maskHasParam(try self.mutablePlaceWords.get(candidate shr RootWordShift) otherwise panic("ProvenanceTracer.isTheParameterItselfWrittenOnlyByACall: mutablePlaceWords.get OOB at {candidate}"), param: (candidate and RootBitIndexMask) as ParamCount)
	end 'isTheParameterItselfWrittenOnlyByACall'

	function writableRankAdmits(func IrFunction, column ProvenanceColumn, value ValueId, rank ElementIndex, candidate ElementIndex) returns bool
		if candidate == self.writableRank 'moduleVarStorage'
			return self.moduleVarKinds.mayHold(try self.heldRecordKindOf(func, value: value) otherwise return true)
		end 'moduleVarStorage'

		return match column 'column'
			identity gives self.valuesMayBeOneRecord(func, value: value, other: self.rootValueAt(candidate))
			inside or
			placedWithin gives self.kindsMayHoldValue(func, kinds: try self.rootRecordKinds.get(candidate) otherwise panic("ProvenanceTracer.writableRankAdmits: rootRecordKinds.get OOB at {candidate}"), value: value)
			holds or
			storedHolds or
			deepHolds gives self.kindsMayHoldValue(func, kinds: try self.rootRecordKinds.get(rank) otherwise panic("ProvenanceTracer.writableRankAdmits: rootRecordKinds.get OOB at {rank}"), value: self.rootValueAt(candidate))
			holdsWithin gives (try self.rootRecordKinds.get(rank) otherwise panic("ProvenanceTracer.writableRankAdmits: rootRecordKinds.get OOB at {rank}")).overlaps(try self.rootRecordKinds.get(candidate) otherwise panic("ProvenanceTracer.writableRankAdmits: rootRecordKinds.get OOB at {candidate}"))
			shares or
			storedDeep panic("ProvenanceTracer.writableRankAdmits: the '{column.name}' set says nothing about what a record holds or lies within")
		end 'column'
	end 'writableRankAdmits'

	function blameOfRootAt(rank ElementIndex) returns WriteBlame
		return WriteBlame.blamed(self.rootNameAt(rank), holder: holderOfRootKind(self.rootKindAt(rank)))
	end 'blameOfRootAt'

	function parameterNameAt(func IrFunction, position ParamCount) returns String
		let sig = try self.project.funcSignatures.get(func.name) otherwise panic("ProvenanceTracer.parameterNameAt: '{String.from(func.name)}' has no signature")
		return displayParamName(try sig.paramNames.get(position) otherwise panic("ProvenanceTracer.parameterNameAt: paramNames.get OOB at {position}"))
	end 'parameterNameAt'

	function writableNameOf(func IrFunction, value ValueId) returns String throws AbsentError
		let sites = func.provenanceSites(self.noSites)

		for (iter, written) in sites.writableValues.withIterator() 'eachWritable'
			if written == value 'itsName'
				return String.from(try sites.writableNames.get(iter.index()) otherwise panic("ProvenanceTracer.writableNameOf: writableNames.get OOB at {iter.index()}"))
			end 'itsName'
		end 'eachWritable'

		throw AbsentError.absent
	end 'writableNameOf'

	function writableRootName(func IrFunction, rank ElementIndex) returns String
		if rank >= self.writableRank 'moduleVarStorage'
			return ModuleVariableSubject
		end 'moduleVarStorage'

		if rank < self.firstWritableValueRank 'aParameter'
			return self.parameterNameAt(func, position: (rank - self.rootNames.count()) as ParamCount)
		end 'aParameter'

		let value = self.rootValueAt(rank)
		return try self.writableNameOf(func, value: value) otherwise panic("ProvenanceTracer.writableRootName: v{value} is a var's record and no var of '{String.from(func.name)}' filed it")
	end 'writableRootName'

	// The token the call at `line`:`column` ends at (`Parser.noteCallToken`), out of the calls of
	// `func` indexed by position at its first question.
	function callTokenAtPosition(func IrFunction, line LineNumber, column ColumnNumber) returns ElementIndex
		var siteCalls = func.provenanceSites(self.noSites).calls

		if siteCalls is not self.indexedCalls 'anotherFunctionsCalls'
			self.callTokenIndex = siteCalls.byPosition()
			self.callStartIndex = siteCalls.startsByPosition()
			self.indexedCalls = siteCalls
		end 'anotherFunctionsCalls'

		return try self.callTokenIndex.get(positionKey(line, column: column)) otherwise panic("ProvenanceTracer.callTokenAtPosition: '{String.from(func.name)}' files no call at {line}:{column}")
	end 'callTokenAtPosition'

	module function definingRangeOf(func IrFunction, value ValueId, fallback SourceRange) returns SourceRange
		self.indexDefinitions(func, ir: self.module)
		let defining = try self.definingOpIndexOf(value) otherwise return fallback
		return self.project.opRanges.get(defining)
	end 'definingRangeOf'

	function calleeStartOf(func IrFunction, call SourceRange) returns SourceRange
		_ = self.callTokenAtPosition(func, line: call.line, column: call.column)
		let start = try self.callStartIndex.get(positionKey(call.line, column: call.column)) otherwise panic("ProvenanceTracer.calleeStartOf: no call start is filed at {call.line}:{call.column}")
		return SourceRange.create(call.startByte, endByte: call.endByte, line: positionKeyLine(start), column: positionKeyColumn(start))
	end 'calleeStartOf'

	// E3159 at a container method writing a receiver the parser could name no binding for —
	// `pass(a).push(9)`. A receiver a `var` holds is answered where that binding took it (E3078).
	function checkReceiverWrites(func IrFunction)
		for site in func.provenanceSites(self.noSites).receiverWrites 'eachWrite'
			self.refuseAWriteThrough(func, target: site.receiver, place: site.place, line: site.line, column: site.column, token: site.token, door: WriteDoor.aReceiver)
		end 'eachWrite'
	end 'checkReceiverWrites'

	// The first immutable name counting at the door being asked whose record a write through `target` writes: one
	// `target` may be, unless the slot both were read out of was replaced in between (`slotRewrittenSinceRootRead`)
	// — or `unblamed`.
	function firstRootWrittenThrough(func IrFunction, target ValueId) returns WriteBlame
		if let own = try self.bindingRankOf(target) 'aBindingsOwnValue'
			return self.blameOfRootAt(own) if self.rootCountsAtDoor(own) else WriteBlame.unblamed
		end 'aBindingsOwnValue'

		let bound = self.rootNames.count()
		let rank = self.leastAdmittedRank(func, column: ProvenanceColumn.identity, value: target, bound: bound, also: RootCondition.slotNotRewritten)
		return self.blameOfRootAt(rank) if rank < bound else WriteBlame.unblamed
	end 'firstRootWrittenThrough'

	function firstRootHolding(func IrFunction, value ValueId) returns WriteBlame
		let bound = self.rootNames.count()
		let rank = self.leastAdmittedRank(func, column: ProvenanceColumn.inside, value: value, bound: bound, also: RootCondition.slotNotRewritten)
		return self.blameOfRootAt(rank) if rank < bound else WriteBlame.unblamed
	end 'firstRootHolding'

	function checkWriteThroughSites(func IrFunction, index ElementIndex)
		for site in func.provenanceSites(self.noSites).writeThroughSites 'eachSite'
			self.refuseAWriteThrough(func, target: site.target, place: site.place, line: site.line, column: site.column, token: site.token, door: WriteDoor.aTarget)
			self.refuseASharedRecordStoredIntoAField(func, index: index, site: site)
		end 'eachSite'
	end 'checkWriteThroughSites'

	function refuseASharedRecordStoredIntoAField(func IrFunction, index ElementIndex, site FieldWriteSite)
		if not self.isTracked(site.stored) or self.valueIsInertAtADoor(func, value: site.stored) or self.recordWasRefusedAtItsDoor(func, record: site.stored) 'nothingWritableIsSharedOrItIsRefused'
			return
		end 'nothingWritableIsSharedOrItIsRefused'

		let field = "{String.from(site.place)}.{String.from(site.field)}"

		let view = self.maybePermanentViewOf(site.stored)

		if view != PermanentView.none and self.deferToInstantiation(func, value: site.stored, owner: index) 'decidedWhereItIsInstantiated'
			return
		end 'decidedWhereItIsInstantiated'

		if view != PermanentView.none 'aPermanentViewsRecord'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: storedIntoWritableFieldMessage(unattributedSharingSubject(viewRootKind(view)), field: field))
			return
		end 'aPermanentViewsRecord'

		if self.valueIsOrLiesWithinAModuleLet(func, value: site.stored) 'aModuleLetsRecord'
			self.refuse(site.line, column: site.column, code: ErrorCode.semanticVarFromImmutable, message: storedIntoWritableFieldMessage(self.sharedStorageSubject(func, ir: self.module, value: site.stored, token: site.token), field: field))
		end 'aModuleLetsRecord'
	end 'refuseASharedRecordStoredIntoAField'

	function valueIsOrLiesWithinAModuleLet(func IrFunction, value ValueId) returns bool
		if self.valueMayBeAModuleLetsRecord(func, value: value) 'handedBackByACall'
			return true
		end 'handedBackByACall'

		for rank in 0 upto self.rootNames.count() 'eachBinding'
			if not (try self.rootIsModuleLet.get(rank) otherwise panic("ProvenanceTracer.valueIsOrLiesWithinAModuleLet: rootIsModuleLet.get OOB at {rank}")) 'notAWritableLet'
				continue
			end 'notAWritableLet'

			if self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: value), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.inside, value: value), rank: rank) 'itsRecord'
				return true
			end 'itsRecord'
		end 'eachBinding'

		return false
	end 'valueIsOrLiesWithinAModuleLet'

	function refuseAWriteThrough(func IrFunction, target ValueId, place ByteArray, line LineNumber, column ColumnNumber, token ElementIndex, door WriteDoor)
		if self.writeWasRefusedAtItsDoor(func, target: target) 'refusedAtItsDoor'
			return
		end 'refusedAtItsDoor'

		self.askAtDoor(token)
		self.refuseAWriteThroughAtTheDoor(func, target: target, place: place, line: line, column: column, token: token, door: door)
		self.leaveDoor()
	end 'refuseAWriteThrough'

	function refuseAWriteThroughAtTheDoor(func IrFunction, target ValueId, place ByteArray, line LineNumber, column ColumnNumber, token ElementIndex, door WriteDoor)
		let own = self.firstRootWrittenThrough(func, target: target)

		if door == WriteDoor.aReceiver and own.isBlamed() 'aReceiversOwnRecord'
			self.refuse(line, column: column, code: ErrorCode.semanticWriteThroughImmutableRecord, message: self.writeThroughBlameMessage(func, target: target, place: place, blamed: own, token: token))
			return
		end 'aReceiversOwnRecord'

		if self.valueIsAnImmutableAggregate(func, value: target) 'writtenByNothing'
			return
		end 'writtenByNothing'

		let view = self.maybePermanentViewOf(target)

		if view != PermanentView.none 'aPermanentViewsRecord'
			self.refuse(line, column: column, code: ErrorCode.semanticWriteThroughImmutableRecord, message: writeThroughViewMessage(view, place: String.from(place)))
			return
		end 'aPermanentViewsRecord'

		let blamed = self.blameWrite(func, target: target, own: own)

		if blamed.isBlamed() 'aNamedRecord'
			self.refuse(line, column: column, code: ErrorCode.semanticWriteThroughImmutableRecord, message: self.writeThroughBlameMessage(func, target: target, place: place, blamed: blamed, token: token))
		end 'aNamedRecord' else if self.valueMayBeAModuleLetsRecord(func, value: target) 'aLetsRecordACallHandedBack'
			self.refuse(line, column: column, code: ErrorCode.semanticWriteThroughImmutableRecord, message: deepLetWriteSharedStorageMessage(String.from(place), subject: self.sharedStorageSubject(func, ir: self.module, value: target, token: token)))
		end 'aLetsRecordACallHandedBack'
	end 'refuseAWriteThroughAtTheDoor'

	// The value whose record `value` is, through retains and merges whose every incoming value is one value.
	function sameRecordBase(func IrFunction, ir MaxonModule, value ValueId) returns ValueId
		var current = value
		var hops = 0 as ElementIndex

		while hops < MaxAccessPathSteps 'eachHop'
			let next = self.sameRecordStep(func, ir: ir, value: current)

			if next == current 'itsBase'
				return current
			end 'itsBase'

			current = next
			hops = hops + 1
		end 'eachHop'

		return current
	end 'sameRecordBase'

	// The value a retain or a single-source merge took `value`'s record from, or `value` itself.
	function sameRecordStep(func IrFunction, ir MaxonModule, value ValueId) returns ValueId
		self.indexDefinitions(func, ir: ir)

		if not self.hasDefiningOp(value) 'aMerge'
			return self.soleIncomingValue(value)
		end 'aMerge'

		if self.valueWasMintedSole(func, value: value) 'aRecordOfItsOwn'
			return value
		end 'aRecordOfItsOwn'

		return self.hopBaseOf(value) if self.hopKindOf(value) == AccessHopKind.same else value
	end 'sameRecordStep'

	function hopKindOf(value ValueId) returns AccessHopKind
		return try self.hopKinds.get(value) otherwise panic("ProvenanceTracer.hopKindOf: v{value} has a defining op but no hop")
	end 'hopKindOf'

	function hopBaseOf(value ValueId) returns ValueId
		return try self.hopBases.get(value) otherwise panic("ProvenanceTracer.hopBaseOf: v{value} has a defining op but no hop")
	end 'hopBaseOf'

	// The root `value` was read out of, with the steps from it into `steps`, the last step first.
	function accessPathOf(func IrFunction, ir MaxonModule, value ValueId, into PathStepArray) returns ValueId
		self.indexDefinitions(func, ir: ir)
		var current = value

		while into.count() < MaxAccessPathSteps 'eachHop'
			if not self.hasDefiningOp(current) 'noOpDefinesIt'
				let merged = self.soleIncomingValue(current)

				if merged == current 'itsRoot'
					return current
				end 'itsRoot'

				current = merged
				continue
			end 'noOpDefinesIt'

			let kind = self.hopKindOf(current)

			if kind == AccessHopKind.stop 'itsRoot'
				return current
			end 'itsRoot'

			if kind == AccessHopKind.field 'aFieldStep'
				into.push(PathStep.field(try self.hopSteps.get(current) otherwise panic("ProvenanceTracer.accessPathOf: v{current} takes a field hop and records no offset")))
			end 'aFieldStep' else if kind == AccessHopKind.element 'anElementStep'
				into.push(PathStep.element)
			end 'anElementStep'

			current = self.hopBaseOf(current)
		end 'eachHop'

		return current
	end 'accessPathOf'

	// The one value every edge into the merge `value` is an argument of hands it — `value` itself when there are two
	// or more, when an edge hands it none, or when it is no merge (`indexSoleIncomings`).
	function soleIncomingValue(value ValueId) returns ValueId
		if not self.isAMerge(value) or not (try self.soleIncomingSeen.get(value) otherwise panic("ProvenanceTracer.soleIncomingValue: soleIncomingSeen.get OOB at v{value}")) 'noneHandedIt'
			return value
		end 'noneHandedIt'

		return try self.soleIncomings.get(value) otherwise panic("ProvenanceTracer.soleIncomingValue: soleIncomings.get OOB at v{value}")
	end 'soleIncomingValue'

	// Which op defines each value of `func`, the hop it takes, and which block argument each merge is, once per
	// function asked. The first op to define a value is its defining op.
	function indexDefinitions(func IrFunction, ir MaxonModule)
		if self.indexedDefinitionsOf.isOf(func.name) and self.definingOps.count() == func.valueTags.count() 'indexed'
			return
		end 'indexed'

		let valueCount = func.valueTags.count()
		self.definingOps.makeAbsent(valueCount)
		self.mergingBlocks.makeAbsent(valueCount)
		self.hopKinds.refill(valueCount, value: AccessHopKind.stop)
		self.hopBases.refill(valueCount, value: 0)
		self.hopSteps.makeAbsent(valueCount)

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexDefinitions: blockRef not in module.blocks")

			for arg in block.blockArgs 'eachArg'
				if (arg.valueId) < valueCount 'aValueOfIt'
					self.mergingBlocks.set(arg.valueId, value: block.id)
				end 'aValueOfIt'
			end 'eachArg'

			for opIdx in block.bodyOps() 'eachOp'
				self.indexDefinition(try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.indexDefinitions: op {opIdx} not in module.ops"), opIdx: opIdx, valueCount: valueCount)
			end 'eachOp'
		end 'eachBlock'

		ir.refillBlockIndexById(func, into: self.blockIndex)
		self.indexEdgePairs(func, ir: ir)
		self.indexSoleIncomings(valueCount)
		self.useCountsIndexed = false
		self.indexedDefinitionsOf = IndexedFunctionBody.body(func.name.clone())
	end 'indexDefinitions'

	function indexUseCounts(func IrFunction, ir MaxonModule, valueCount ElementIndex)
		self.useCounts.refill(valueCount, value: 0)

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexUseCounts: blockRef not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				self.countUsesOf(try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.indexUseCounts: op {opIdx} not in module.ops"), valueCount: valueCount)
			end 'eachOp'

			if block.hasTerminatorOp() 'terminated'
				self.countUsesOf(try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.indexUseCounts: terminatorIndex not in module.ops"), valueCount: valueCount)
			end 'terminated'

			for edge in block.branchEdges 'eachEdge'
				for argument in edge.argIds 'eachArgument'
					self.noteUse(argument, valueCount: valueCount)
				end 'eachArgument'
			end 'eachEdge'
		end 'eachBlock'
	end 'indexUseCounts'

	function countUsesOf(op MaxonOp, valueCount ElementIndex)
		let use = self.operandUseOf(op)

		if use == OperandUse.placesNone 'nothingIsPlaced'
			return
		end 'nothingIsPlaced'

		maxonOpOperandValues(op, into: self.operands)

		for (iter, operand) in self.operands.withIterator() 'eachOperand'
			if use == OperandUse.placesAllButItsAddress and iter.index() == 0 'itsAddress'
				continue
			end 'itsAddress'

			self.noteUse(operand, valueCount: valueCount)
		end 'eachOperand'
	end 'countUsesOf'

	function operandUseOf(op MaxonOp) returns OperandUse
		return match op 'op'
			storeIndirect gives OperandUse.placesAllButItsAddress

			loadIndirect or
			holdEnd gives OperandUse.placesNone

			call(_, callee, _, _, _, _, _, _) gives self.callOperandUse(callee)
			tryCall(_, _, callee, _, _, _, _, _, _) gives self.callOperandUse(callee)

			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue gives OperandUse.placesEveryOperand
		end 'op'
	end 'operandUseOf'

	function callOperandUse(callee ByteArray) returns OperandUse
		if releasesItsOperandCallee(callee) 'aRelease'
			return OperandUse.placesNone
		end 'aRelease'

		return OperandUse.placesEveryOperand
	end 'callOperandUse'

	function noteUse(value ValueId, valueCount ElementIndex)
		if value < valueCount 'aValueOfIt'
			try self.useCounts.set(value, value: (try self.useCounts.get(value) otherwise panic("ProvenanceTracer.noteUse: useCounts.get OOB at v{value}")) + 1) otherwise panic("ProvenanceTracer.noteUse: useCounts.set OOB at v{value}")
		end 'aValueOfIt'
	end 'noteUse'

	function valueIsUsedOnce(func IrFunction, value ValueId) returns bool
		self.indexDefinitions(func, ir: self.module)

		if not self.useCountsIndexed 'notCountedYet'
			self.indexUseCounts(func, ir: self.module, valueCount: func.valueTags.count())
			self.useCountsIndexed = true
		end 'notCountedYet'

		return value < self.useCounts.count() and (try self.useCounts.get(value) otherwise panic("ProvenanceTracer.valueIsUsedOnce: useCounts.get OOB at v{value}")) == 1
	end 'valueIsUsedOnce'

	function indexDefinition(op MaxonOp, opIdx ElementIndex, valueCount ElementIndex)
		match op 'op'
			loadIndirect(result, addr, offset, _) then self.noteFieldOp(result, opIdx: opIdx, valueCount: valueCount, base: addr, offset: offset as AccessStep)
			call(result, callee, args, _, _, _, _, _) then self.indexCallDefinition(result, opIdx: opIdx, valueCount: valueCount, callee: callee, args: args)
			tryCall(result, _, callee, args, _, _, _, _, _) then self.indexCallDefinition(result, opIdx: opIdx, valueCount: valueCount, callee: callee, args: args)
			literal(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			binOp(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			unaryOp(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			compare(result, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			globalAddr(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			stringLiteral(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			functionRef(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			indirectCall(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			asyncCall(result, _, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			await (result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			tryAwait(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			sizeofType(result, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			constArrayLiteral(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			witnessDispatch(result, _, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			witnessTryDispatch(result, _, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			errorFlagEncode(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			serviceSpawn(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			serviceSend(result, _, _, _, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			serviceReplyCell(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			immortalStructRecord(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			immortalStringTable(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			rawIntrinsic(result, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			existentialWitness(result, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			holdValue(result, held, _, _, _) then self.noteHeldDefinition(result, opIdx: opIdx, valueCount: valueCount, held: held)
			holdEnd(result, _, _, _, _) then self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)

			ret or
			retVoid or
			condBranch or
			branch or
			storeIndirect or
			throwError or
			propagateError or
			panicAbort or
			switch or
			panicAbortValue or
			covPoint then break
		end 'op'
	end 'indexDefinition'

	// A retain hands back the record it was handed; an element read, a record within its container's.
	function indexCallDefinition(result ValueId, opIdx ElementIndex, valueCount ElementIndex, callee ByteArray, args ValueIdArray)
		if args.count() == 0 'noOperand'
			self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			return
		end 'noOperand'

		let operand = try args.get(0) otherwise panic("ProvenanceTracer.indexCallDefinition: args.get OOB below a positive count")

		if callee.equals(MmAllocName) 'aFreshBox'
			self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
			return
		end 'aFreshBox'

		if ownershipBookkeepingCallee(callee) 'theSameRecord'
			_ = self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.same, base: operand)
			return
		end 'theSameRecord'

		if indexedElementReadCallee(callee) 'anElement'
			_ = self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.element, base: operand)
			return
		end 'anElement'

		self.noteRootDefinition(result, opIdx: opIdx, valueCount: valueCount)
	end 'indexCallDefinition'

	function noteHeldDefinition(result ValueId, opIdx ElementIndex, valueCount ElementIndex, held ValueId)
		_ = self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.same, base: held)
	end 'noteHeldDefinition'

	function noteRootDefinition(result ValueId, opIdx ElementIndex, valueCount ElementIndex)
		_ = self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.stop, base: result)
	end 'noteRootDefinition'

	function noteFieldOp(result ValueId, opIdx ElementIndex, valueCount ElementIndex, base ValueId, offset AccessStep)
		if self.noteDefiningOp(result, opIdx: opIdx, valueCount: valueCount, kind: AccessHopKind.field, base: base) 'itsFirstDefinition'
			self.hopSteps.set(result, value: offset)
		end 'itsFirstDefinition'
	end 'noteFieldOp'

	function noteDefiningOp(result ValueId, opIdx ElementIndex, valueCount ElementIndex, kind AccessHopKind, base ValueId) returns bool
		if (result) >= valueCount or self.definingOps.holds(result) 'notItsFirstDefinition'
			return false
		end 'notItsFirstDefinition'

		self.definingOps.set(result, value: opIdx)
		try self.hopKinds.set(result, value: kind) otherwise panic("ProvenanceTracer.noteDefiningOp: hopKinds.set OOB at v{result}")
		try self.hopBases.set(result, value: base) otherwise panic("ProvenanceTracer.noteDefiningOp: hopBases.set OOB at v{result}")
		return true
	end 'noteDefiningOp'

	function definingOpIndexOf(value ValueId) returns ElementIndex throws AbsentError
		if value >= self.definingOps.count() 'pastTheIndexedValues'
			throw AbsentError.absent
		end 'pastTheIndexedValues'

		return try self.definingOps.get(value)
	end 'definingOpIndexOf'

	function hasDefiningOp(value ValueId) returns bool
		try self.definingOpIndexOf(value) otherwise return false
		return true
	end 'hasDefiningOp'

	function mergingBlockOf(value ValueId) returns BlockId throws AbsentError
		if value >= self.mergingBlocks.count() 'pastTheIndexedValues'
			throw AbsentError.absent
		end 'pastTheIndexedValues'

		return try self.mergingBlocks.get(value)
	end 'mergingBlockOf'

	function isAMerge(value ValueId) returns bool
		try self.mergingBlockOf(value) otherwise return false
		return true
	end 'isAMerge'

	// What the edges hand each merge (`indexEdgePairs`): every value handed (`incomingAt`), and the one value — the
	// first handed, then the merge itself once a second value, or an edge handing it none, says there is no one value.
	function indexSoleIncomings(valueCount ElementIndex)
		self.soleIncomings.refill(valueCount, value: 0)
		self.soleIncomingSeen.refill(valueCount, value: false)
		self.incomingStart.refill(valueCount, value: 0)
		self.incomingLength.refill(valueCount, value: 0)
		self.incomingComplete.refill(valueCount, value: true)

		for pair in 0 upto self.pairMerge.count() 'eachSlot'
			let merge = self.pairMergeAt(pair)

			if (merge) < valueCount 'aValueOfIt'
				try self.incomingLength.set(merge, value: (try self.incomingLength.get(merge) otherwise panic("ProvenanceTracer.indexSoleIncomings: incomingLength.get OOB at v{merge}")) + 1) otherwise panic("ProvenanceTracer.indexSoleIncomings: incomingLength.set OOB at v{merge}")
			end 'aValueOfIt'
		end 'eachSlot'

		var total = 0 as ElementIndex

		for value in 0 upto valueCount 'eachValue'
			try self.incomingStart.set(value, value: total) otherwise panic("ProvenanceTracer.indexSoleIncomings: incomingStart.set OOB at v{value}")
			total = total + (try self.incomingLength.get(value) otherwise panic("ProvenanceTracer.indexSoleIncomings: incomingLength.get OOB at v{value}"))
			try self.incomingLength.set(value, value: 0) otherwise panic("ProvenanceTracer.indexSoleIncomings: incomingLength.set OOB at v{value}")
		end 'eachValue'

		self.incomingValues.refill(total, value: 0)

		for pair in 0 upto self.pairMerge.count() 'eachPair'
			let merge = self.pairMergeAt(pair)

			if (merge) < valueCount 'aValueOfIt'
				self.noteIncoming(merge, incoming: self.pairIncomingAt(pair), handed: self.pairIsHanded(pair))
			end 'aValueOfIt'
		end 'eachPair'
	end 'indexSoleIncomings'

	// Every edge's value for each block argument of its target, grouped by SOURCE block in `func.blockRefs` order:
	// `pairsFrom` and `pairsUpTo` take that position, not the target's.
	function indexEdgePairs(func IrFunction, ir MaxonModule)
		self.pairMerge.clear()
		self.pairIncoming.clear()
		self.pairHanded.clear()
		self.blockPairStart.clear()

		for blockRef in func.blockRefs 'eachBlock'
			self.blockPairStart.push(self.pairMerge.count())
			let source = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexEdgePairs: blockRef not in module.blocks")

			for edge in source.branchEdges 'eachEdge'
				let position = try self.blockIndex.get(edge.targetBlockId) otherwise panic("ProvenanceTracer.indexEdgePairs: edge target {edge.targetBlockId} is not a block of '{String.from(func.name)}'")
				let target = try ir.blocks.get(try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.indexEdgePairs: blockRefs.get OOB at {position}")) otherwise panic("ProvenanceTracer.indexEdgePairs: blockRef not in module.blocks")

				if edge.argIds.count() > target.blockArgs.count() 'moreValuesThanArguments'
					panic("ProvenanceTracer.indexEdgePairs: an edge into block {edge.targetBlockId} of '{String.from(func.name)}' carries {edge.argIds.count()} values for {target.blockArgs.count()} block args")
				end 'moreValuesThanArguments'

				for k in 0 upto target.blockArgs.count() 'eachArg'
					let merge = (try target.blockArgs.get(k) otherwise panic("ProvenanceTracer.indexEdgePairs: blockArgs.get OOB at {k}")).valueId
					self.pairMerge.push(merge)
					self.pairHanded.push(k < edge.argIds.count())
					self.pairIncoming.push(try edge.argIds.get(k) otherwise merge)
				end 'eachArg'
			end 'eachEdge'
		end 'eachBlock'

		self.blockPairStart.push(self.pairMerge.count())
	end 'indexEdgePairs'

	function pairsFrom(position ElementIndex) returns ElementIndex
		return try self.blockPairStart.get(position) otherwise panic("ProvenanceTracer.pairsFrom: blockPairStart.get OOB at {position}")
	end 'pairsFrom'

	function pairsUpTo(position ElementIndex) returns ElementIndex
		return try self.blockPairStart.get(position + 1) otherwise panic("ProvenanceTracer.pairsUpTo: blockPairStart.get OOB past {position}")
	end 'pairsUpTo'

	function pairMergeAt(pair ElementIndex) returns ValueId
		return try self.pairMerge.get(pair) otherwise panic("ProvenanceTracer.pairMergeAt: pairMerge.get OOB at {pair}")
	end 'pairMergeAt'

	function pairIncomingAt(pair ElementIndex) returns ValueId
		return try self.pairIncoming.get(pair) otherwise panic("ProvenanceTracer.pairIncomingAt: pairIncoming.get OOB at {pair}")
	end 'pairIncomingAt'

	function pairIsHanded(pair ElementIndex) returns bool
		return try self.pairHanded.get(pair) otherwise panic("ProvenanceTracer.pairIsHanded: pairHanded.get OOB at {pair}")
	end 'pairIsHanded'

	function recordIncoming(merge ValueId, incoming ValueId, handed bool)
		if not handed 'noValueHanded'
			try self.incomingComplete.set(merge, value: false) otherwise panic("ProvenanceTracer.recordIncoming: incomingComplete.set OOB at v{merge}")
			return
		end 'noValueHanded'

		let length = try self.incomingLength.get(merge) otherwise panic("ProvenanceTracer.recordIncoming: incomingLength.get OOB at v{merge}")
		try self.incomingValues.set((try self.incomingStart.get(merge) otherwise panic("ProvenanceTracer.recordIncoming: incomingStart.get OOB at v{merge}")) + length, value: incoming) otherwise panic("ProvenanceTracer.recordIncoming: incomingValues.set OOB for v{merge}")
		try self.incomingLength.set(merge, value: length + 1) otherwise panic("ProvenanceTracer.recordIncoming: incomingLength.set OOB at v{merge}")
	end 'recordIncoming'

	function incomingCountOf(merge ValueId) returns ElementIndex
		return try self.incomingLength.get(merge) otherwise panic("ProvenanceTracer.incomingCountOf: incomingLength.get OOB at v{merge}")
	end 'incomingCountOf'

	function incomingAt(merge ValueId, k ElementIndex) returns ValueId
		return try self.incomingValues.get((try self.incomingStart.get(merge) otherwise panic("ProvenanceTracer.incomingAt: incomingStart.get OOB at v{merge}")) + k) otherwise panic("ProvenanceTracer.incomingAt: incomingValues.get OOB for v{merge} at {k}")
	end 'incomingAt'

	function incomingsAreKnown(merge ValueId) returns bool
		return self.isAMerge(merge) and (try self.incomingComplete.get(merge) otherwise panic("ProvenanceTracer.incomingsAreKnown: incomingComplete.get OOB at v{merge}"))
	end 'incomingsAreKnown'

	// One edge hands `merge` the value `incoming` — or, `handed` false, none at all.
	function noteIncoming(merge ValueId, incoming ValueId, handed bool)
		self.recordIncoming(merge, incoming: incoming, handed: handed)

		if handed and incoming == merge 'itself'
			return
		end 'itself'

		let seen = try self.soleIncomingSeen.get(merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomingSeen.get OOB at v{merge}")

		if not seen 'theFirst'
			try self.soleIncomingSeen.set(merge, value: true) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomingSeen.set OOB at v{merge}")
			try self.soleIncomings.set(merge, value: incoming if handed else merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomings.set OOB at v{merge}")
			return
		end 'theFirst'

		if not handed or (try self.soleIncomings.get(merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomings.get OOB at v{merge}")) != incoming 'noOneValue'
			try self.soleIncomings.set(merge, value: merge) otherwise panic("ProvenanceTracer.noteIncoming: soleIncomings.set OOB at v{merge}")
		end 'noOneValue'
	end 'noteIncoming'

	function setsShareARank(set ElementIndex, other ElementIndex) returns bool
		if var chunk = try self.sets.first(set) 'hasWords'
			while true 'eachWord'
				if (self.sets.wordOf(chunk) and self.sets.wordAt(other, word: self.sets.indexOf(chunk))) != NoParamPositions 'shared'
					return true
				end 'shared'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return false
	end 'setsShareARank'

	// A door that bound or assigned a `var` was refused for what it took: `value` came from it.
	function noteRefusedDoor(value ValueId)
		try self.refusedDoorValues.set(value, value: true) otherwise panic("ProvenanceTracer.noteRefusedDoor: refusedDoorValues.set OOB at v{value}")

		if let own = try self.writableRankOf(value) 'aVarsOwn'
			self.sets.addRank(self.refusedDoorRanks, rank: own)
		end 'aVarsOwn'

		if let named = try self.bindingRankOf(value) 'aNamesOwn'
			self.sets.addRank(self.refusedDoorRanks, rank: named)
		end 'aNamesOwn'
	end 'noteRefusedDoor'

	function noteRefusedKeep(value ValueId)
		self.noteRefusedDoor(value)

		let identity = self.setOf(ProvenanceColumn.identity, value: value)
		let inside = self.setOf(ProvenanceColumn.inside, value: value)

		for rank in 0 upto self.rootNames.count() 'eachStoredName'
			if self.rootIsAStoredName(rank) and (self.sets.hasRank(identity, rank: rank) or self.sets.hasRank(inside, rank: rank)) 'itsRecord'
				self.sets.addRank(self.keptRefusedRanks, rank: rank)
				self.sets.addRank(self.refusedDoorRanks, rank: rank)
			end 'itsRecord'
		end 'eachStoredName'
	end 'noteRefusedKeep'

	function valueReachesAKeptRecordRefusedBefore(value ValueId, write PositionKey) returns bool
		for index in 0 upto self.keptRefusedValues.count() 'eachRefusedKeep'
			if (try self.keptRefusedAt.get(index) otherwise panic("ProvenanceTracer.valueReachesAKeptRecordRefusedBefore: keptRefusedAt.get OOB at {index} — pushed with keptRefusedValues")) > write 'afterTheWrite'
				continue
			end 'afterTheWrite'

			let refused = try self.keptRefusedValues.get(index) otherwise panic("ProvenanceTracer.valueReachesAKeptRecordRefusedBefore: keptRefusedValues.get OOB at {index}")

			for rank in 0 upto self.rootNames.count() 'eachStoredName'
				if self.rootIsAStoredName(rank) and self.valueIsOrLiesWithin(refused, rank: rank) and self.valueIsOrLiesWithin(value, rank: rank) 'theRefusedRecord'
					return true
				end 'theRefusedRecord'
			end 'eachStoredName'
		end 'eachRefusedKeep'

		return false
	end 'valueReachesAKeptRecordRefusedBefore'

	function valueReachesARefusedKeep(value ValueId) returns bool
		return self.setsShareARank(self.setOf(ProvenanceColumn.identity, value: value), other: self.keptRefusedRanks) or self.setsShareARank(self.setOf(ProvenanceColumn.inside, value: value), other: self.keptRefusedRanks)
	end 'valueReachesARefusedKeep'

	// May a write through `target` be one through a record a refused `var` door took — the value that door took, a
	// retain of it, or a merge of nothing else? That door's refusal answers it.
	function writeWasRefusedAtItsDoor(func IrFunction, target ValueId) returns bool
		if self.recordWasRefusedAtItsDoor(func, record: target) 'theRecordItself'
			return true
		end 'theRecordItself'

		var steps = self.pathSteps
		steps.clear()
		let base = self.accessPathOf(func, ir: self.module, value: target, into: steps)

		return base != target and self.recordWasRefusedAtItsDoor(func, record: base)
	end 'writeWasRefusedAtItsDoor'

	function recordWasRefusedAtItsDoor(func IrFunction, record ValueId) returns bool
		if self.setsShareARank(self.setOf(ProvenanceColumn.identity, value: record), other: self.refusedDoorRanks) or self.setsShareARank(self.setOf(ProvenanceColumn.inside, value: record), other: self.refusedDoorRanks) 'aRefusedRecord'
			return true
		end 'aRefusedRecord'

		var current = record
		var hops = 0 as ElementIndex

		while hops < MaxAccessPathSteps 'eachHop'
			let refused = try self.refusedDoorValues.get(current) otherwise false

			if refused 'theRefusedValue'
				return true
			end 'theRefusedValue'

			let next = self.sameRecordStep(func, ir: self.module, value: current)

			if next == current 'noFurther'
				return false
			end 'noFurther'

			current = next
			hops = hops + 1
		end 'eachHop'

		return false
	end 'recordWasRefusedAtItsDoor'

	// ⭐ **E3159 AT AN ARGUMENT A CALLEE WRITES, WHICHEVER NAME HOLDS IT** — asked of what `checkCalls`
	// left unjudged: a value a `var` holds, which may be the record of an immutable name live after
	// the call, and a value a call handed back out of a module-level `let`.
	function checkWrittenArguments(func IrFunction, ir MaxonModule)
		for k in self.writtenArgsHere 'eachArgument'
			let judged = try self.writtenArgJudged.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgJudged.get OOB at {k}")

			if judged 'judgedAtTheCall'
				continue
			end 'judgedAtTheCall'

			let value = try self.writtenArgValues.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgValues.get OOB at {k}")
			let call = try self.writtenArgCalls.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgCalls.get OOB at {k}")
			let callLine = call.line
			let callColumn = call.column

			let view = self.maybePermanentViewOf(value)

			if view != PermanentView.none and not self.writeWasRefusedAtItsDoor(func, target: value) 'aPermanentViewsRecord'
				let viewMessage = writtenArgumentMessage(readOnlyRootSubject(try self.viewRootName(func, ir: ir, value: value) otherwise "", kind: viewRootKind(view)), parameter: try self.writtenArgParams.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgParams.get OOB at {k}"), functionName: self.signatures.sourceNameOfFunction(func.name))
				self.refuse(callLine, column: callColumn, code: ErrorCode.semanticWriteThroughImmutableRecord, message: viewMessage)
				continue
			end 'aPermanentViewsRecord'

			if self.valueIsAnImmutableAggregate(func, value: value) or self.writeWasRefusedAtItsDoor(func, target: value) 'writtenByNothingOrRefused'
				continue
			end 'writtenByNothingOrRefused'

			let token = self.callTokenAtPosition(func, line: callLine, column: callColumn)
			self.askAtDoor(token)
			var blamed = self.blameWrite(func, target: value, own: self.firstRootWrittenThrough(func, target: value))

			// A value no `var` holds, that may be a live name's own record, is `checkCalls`' to answer — it did.
			if blamed.isBlamed() and not self.valueIsAVarsOwn(value) 'answeredAtTheCall'
				self.leaveDoor()
				continue
			end 'answeredAtTheCall'

			if not blamed.isBlamed() and self.valueMayBeAModuleLetsRecord(func, value: value) 'aLetsRecordACallHandedBack'
				blamed = WriteBlame.blamed(EmptySourceText, holder: WriteBlameHolder.moduleLet)
			end 'aLetsRecordACallHandedBack'

			if not blamed.isBlamed() 'noNamedRecord'
				self.leaveDoor()
				continue
			end 'noNamedRecord'

			view parameter = try self.writtenArgParams.get(k) otherwise panic("ProvenanceTracer.checkWrittenArguments: writtenArgParams.get OOB at {k}")
			let message = writtenArgumentMessage(self.blamedSubject(func, value: value, blamed: blamed, call: call), parameter: parameter, functionName: self.signatures.sourceNameOfFunction(func.name))
			self.refuse(callLine, column: callColumn, code: ErrorCode.semanticWriteThroughImmutableRecord, message: message)
			self.leaveDoor()
		end 'eachArgument'
	end 'checkWrittenArguments'

	function accessRootOf(func IrFunction, ir MaxonModule, value ValueId) returns AccessRoot
		self.indexDefinitions(func, ir: ir)
		var current = value

		for _ in 0 upto MaxAccessPathSteps 'eachHop'
			if let rank = try self.bindingRankOf(current) 'itsRoot'
				return AccessRoot.binding(rank)
			end 'itsRoot'

			if not self.hasDefiningOp(current) 'aMergeOrAParameter'
				let merged = self.soleIncomingValue(current)

				if merged == current 'noSingleSource'
					return AccessRoot.computed if self.isAMerge(current) else AccessRoot.ground
				end 'noSingleSource'

				current = merged
				continue
			end 'aMergeOrAParameter'

			match self.hopKindOf(current) 'hop'
				same or
				field then break
				element then return AccessRoot.computed
				stop then return self.accessRootOfStop(func, ir: ir, value: current)
			end 'hop'

			current = self.hopBaseOf(current)
		end 'eachHop'

		return AccessRoot.unknown
	end 'accessRootOf'

	function accessRootOfStop(func IrFunction, ir MaxonModule, value ValueId) returns AccessRoot
		let opIndex = try self.definingOpIndexOf(value) otherwise panic("ProvenanceTracer.accessRootOfStop: a value that takes a stop hop has a defining op")
		view op = try ir.ops.get(opIndex) otherwise panic("ProvenanceTracer.accessRootOfStop: op {opIndex} not in module.ops")
		return AccessRoot.computed if self.producerOfOp(func, op: op).isACall() else AccessRoot.ground
	end 'accessRootOfStop'

	function viewRootName(func IrFunction, ir MaxonModule, value ValueId) returns String throws AbsentError
		match self.accessRootOf(func, ir: ir, value: value) 'root'
			binding(rank) then return String.from(self.rootNameAt(rank))
			computed or
			ground or
			unknown then throw AbsentError.absent
		end 'root'
	end 'viewRootName'

	function valueReachesAMutablePlace(value ValueId) returns bool
		return self.setReachesAMutablePlace(self.setOf(ProvenanceColumn.identity, value: value)) or self.setReachesAMutablePlace(self.setOf(ProvenanceColumn.inside, value: value))
	end 'valueReachesAMutablePlace'

	function setReachesAMutablePlace(set ElementIndex) returns bool
		if var chunk = try self.sets.first(set) 'hasWords'
			while true 'eachWord'
				let word = self.sets.indexOf(chunk)

				if word < self.mutablePlaceWords.count() as MaskWordCount 'mayHoldAMutablePlace'
					if (self.sets.wordOf(chunk) and (try self.mutablePlaceWords.get(word) otherwise panic("ProvenanceTracer.setReachesAMutablePlace: mutablePlaceWords.get OOB at {word}"))) != NoParamPositions 'reaches'
						return true
					end 'reaches'
				end 'mayHoldAMutablePlace'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return false
	end 'setReachesAMutablePlace'

	// ⭐ **WAS THE SLOT `target` IS READ OUT OF STORED ON EVERY PATH SINCE ROOT `rank` READ IT?** Both are reads of
	// one slot — the binding's directly or through the retain it took — and `target` can be the binding's record
	// only along a path from the binding's read to it that stores nothing there but a value that may be that record:
	// `view old = states`, then `states = fresh`, then `states.set(…)` writes the fresh record. A store the path makes
	// through a call is not seen, so the answer errs towards "not stored".
	function slotRewrittenSinceRootRead(func IrFunction, ir MaxonModule, rank ElementIndex, target ValueId) returns bool
		if self.rootIsModuleLetAt(rank) 'aSlotNothingStoresTo'
			return false
		end 'aSlotNothingStoresTo'

		match self.slotReadUnder(func, ir: ir, value: self.rootValueAt(rank)) 'borrowedRead'
			load(borrowOp, addr, offset) then return self.slotRewrittenAlongThePath(func, ir: ir, from: borrowOp, addr: addr, offset: offset, rank: rank, target: target)

			none or
			store or
			retainOf then return false
		end 'borrowedRead'
	end 'slotRewrittenSinceRootRead'

	function slotRewrittenAlongThePath(func IrFunction, ir MaxonModule, from ElementIndex, addr ValueId, offset ByteOffset, rank ElementIndex, target ValueId) returns bool
		self.indexDefinitions(func, ir: ir)
		var current = target
		var hops = 0 as ElementIndex

		while hops < MaxAccessPathSteps 'eachHop'
			if self.slotRewrittenBefore(func, ir: ir, from: from, to: self.slotReadUnder(func, ir: ir, value: current), addr: addr, offset: offset, rank: rank) 'rewrittenHere'
				return true
			end 'rewrittenHere'

			if not self.hasDefiningOp(current) or self.hopKindOf(current) == AccessHopKind.stop 'noFurtherHop'
				return false
			end 'noFurtherHop'

			current = self.hopBaseOf(current)
			hops = hops + 1
		end 'eachHop'

		return false
	end 'slotRewrittenAlongThePath'

	function slotRewrittenBefore(func IrFunction, ir MaxonModule, from ElementIndex, to SlotRead, addr ValueId, offset ByteOffset, rank ElementIndex) returns bool
		match to 'targetRead'
			load(targetOp, targetAddr, targetOffset) then return targetAddr == addr and targetOffset == offset and not self.slotReachedUnstored(func, ir: ir, from: from, to: targetOp, addr: addr, offset: offset, rank: rank)

			none or
			store or
			retainOf then return false
		end 'targetRead'
	end 'slotRewrittenBefore'

	// The field read `value` is: the load itself, or the load a retain of it was taken of.
	function slotReadUnder(func IrFunction, ir MaxonModule, value ValueId) returns SlotRead
		self.indexDefinitions(func, ir: ir)
		let opIndex = try self.definingOpIndexOf(value) otherwise return SlotRead.none

		return self.slotReadThrough(func, ir: ir, read: slotReadOfOp(try ir.ops.get(opIndex) otherwise panic("ProvenanceTracer.slotReadUnder: opIndex {opIndex} not in module.ops"), opIndex: opIndex))
	end 'slotReadUnder'

	function slotReadThrough(func IrFunction, ir MaxonModule, read SlotRead) returns SlotRead
		match read 'read'
			retainOf(operand) then return self.slotReadUnder(func, ir: ir, value: operand)

			none or
			load or
			store then return read
		end 'read'
	end 'slotReadThrough'

	// Is there a path from op `from` to op `to` along which nothing stores into `(addr, offset)`?
	function slotReachedUnstored(func IrFunction, ir MaxonModule, from ElementIndex, to ElementIndex, addr ValueId, offset ByteOffset, rank ElementIndex) returns bool
		self.indexDefinitions(func, ir: ir)
		var worklist = self.reachWorklist
		var visited = self.reachVisited
		worklist.clear()
		visited.refill(func.nextBlockId, value: false)

		for blockRef in func.blockRefs 'findTheRead'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.slotReachedUnstored: blockRef from func.blockRefs not in module.blocks")

			for at in 0 upto block.bodyOpCount() 'eachOp'
				if (try block.bodyOpAt(at) otherwise panic("ProvenanceTracer.slotReachedUnstored: bodyOpAt OOB at {at}")) != from 'anotherOp'
					continue
				end 'anotherOp'

				match self.scanForSlotRead(ir, block: block, start: (at + 1) as ElementIndex, to: to, addr: addr, offset: offset, rank: rank) 'tail'
					reached then return true
					stored then return false
					ranOff then collectMaxonBlockSuccessors(ir, block: block, into: worklist)
				end 'tail'

				break 'findTheRead'
			end 'eachOp'
		end 'findTheRead'

		var head = 0 as ElementIndex

		while head < worklist.count() 'eachBlock'
			let blockId = try worklist.get(head) otherwise panic("ProvenanceTracer.slotReachedUnstored: worklist.get OOB at {head}")
			head = head + 1

			let seen = try visited.get(blockId) otherwise panic("ProvenanceTracer.slotReachedUnstored: block {blockId} is past the function's {func.nextBlockId} block ids")

			if seen 'seen'
				continue
			end 'seen'

			try visited.set(blockId, value: true) otherwise panic("ProvenanceTracer.slotReachedUnstored: visited.set OOB at block {blockId}")
			let block = self.blockById(func, ir: ir, blockId: blockId)

			match self.scanForSlotRead(ir, block: block, start: 0, to: to, addr: addr, offset: offset, rank: rank) 'body'
				reached then return true
				stored then continue
				ranOff then collectMaxonBlockSuccessors(ir, block: block, into: worklist)
			end 'body'
		end 'eachBlock'

		return false
	end 'slotReachedUnstored'

	// The block of `func` with id `blockId`, through the id index the caller refilled (`indexDefinitions`).
	function blockById(func IrFunction, ir MaxonModule, blockId BlockId) returns IrBlock
		let position = try self.blockIndex.get(blockId) otherwise panic("ProvenanceTracer.blockById: block {blockId} is not a block of '{String.from(func.name)}'")
		let blockRef = try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.blockById: blockIndexById placed a block at {position}, past func.blockRefs")
		return try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.blockById: blockRef {blockRef} not in module.blocks")
	end 'blockById'

	// ⭐ **A READ OUT OF A PARAMETER'S SLOT IS A `let`'S RECORD ONLY WHERE SOMETHING PUT IT THERE FIRST.** What such
	// a read may be is what any store into that slot stored (`traceLoad`), wherever the store is; the record of root
	// `rank` is really there only along a path to the read from a store of a value that may be it — or from the
	// `let`'s own read of the slot — that no other store of the slot cuts: `var entry = self.currentBlock` is not
	// the `rhsBlock` a later `self.currentBlock = rhsBlock` stores. Any other value is answered as the sets say.
	function slotMayHoldRoot(func IrFunction, ir MaxonModule, rank ElementIndex, value ValueId) returns bool
		match self.slotReadUnder(func, ir: ir, value: value) 'read'
			load(readOp, addr, offset) then return not self.readsParameterStorage(addr) or self.rootPutIntoSlotBefore(func, ir: ir, rank: rank, to: readOp, addr: addr, offset: offset)

			none or
			store or
			retainOf then return true
		end 'read'
	end 'slotMayHoldRoot'

	function rootPutIntoSlotBefore(func IrFunction, ir MaxonModule, rank ElementIndex, to ElementIndex, addr ValueId, offset ByteOffset) returns bool
		let rootRead = self.slotReadUnder(func, ir: ir, value: self.rootValueAt(rank))

		for blockRef in func.blockRefs 'eachBlock'
			let block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.rootPutIntoSlotBefore: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				let op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.rootPutIntoSlotBefore: opIdx {opIdx} not in module.ops")

				if opLoadsOrStoresASlot(op) and self.putsRootIntoSlot(slotReadOfOp(op, opIndex: opIdx), rootRead: rootRead, addr: addr, offset: offset, rank: rank) and self.slotReachedUnstored(func, ir: ir, from: opIdx, to: to, addr: addr, offset: offset, rank: rank) 'reachesTheRead'
					return true
				end 'reachesTheRead'
			end 'eachOp'
		end 'eachBlock'

		return false
	end 'rootPutIntoSlotBefore'

	// Does `read` put root `rank`'s record into `(addr, offset)` — a store of a value that may be it, or the root's
	// own read of the slot (`rootRead`)?
	function putsRootIntoSlot(read SlotRead, rootRead SlotRead, addr ValueId, offset ByteOffset, rank ElementIndex) returns bool
		return match read 'read'
			store(storeAddr, storeOffset, stored) gives storeAddr == addr and storeOffset == offset and self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: stored), rank: rank)
			load(loadOp, loadAddr, loadOffset) gives loadAddr == addr and loadOffset == offset and slotReadIsLoadOp(rootRead, opIndex: loadOp)

			none or
			retainOf gives false
		end 'read'
	end 'putsRootIntoSlot'

	// What `block`'s ops from `start` meet first: op `to`, a store into `(addr, offset)` of a value that cannot be root
	// `rank`'s record, or neither.
	function scanForSlotRead(ir MaxonModule, block IrBlock, start ElementIndex, to ElementIndex, addr ValueId, offset ByteOffset, rank ElementIndex) returns SlotScan
		for i in start upto block.bodyOpCount() 'eachOp'
			let opIdx = try block.bodyOpAt(i) otherwise panic("ProvenanceTracer.scanForSlotRead: bodyOpAt OOB at {i}")

			if opIdx == to 'theRead'
				return SlotScan.reached
			end 'theRead'

			let op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.scanForSlotRead: opIdx {opIdx} not in module.ops")

			if opLoadsOrStoresASlot(op) and self.replacesTheRecordOf(slotReadOfOp(op, opIndex: opIdx), addr: addr, offset: offset, rank: rank) 'thisSlot'
				return SlotScan.stored
			end 'thisSlot'
		end 'eachOp'

		return SlotScan.ranOff
	end 'scanForSlotRead'

	function replacesTheRecordOf(read SlotRead, addr ValueId, offset ByteOffset, rank ElementIndex) returns bool
		return match read 'read'
			store(storeAddr, storeOffset, stored) gives storeAddr == addr and storeOffset == offset and not self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: stored), rank: rank)

			none or
			load or
			retainOf gives false
		end 'read'
	end 'replacesTheRecordOf'

	// The producer E3078 names for a value an op made: a declared callee by the noun every call message uses, a
	// runtime entry by the member the author wrote, a witness by its requirement, a function value by the `let` it
	// is bound to — else "a value".
	function producerOfOp(func IrFunction, op MaxonOp) returns CallProducer
		return match op 'op'
			call(_, callee, _, _, _, _, _, mint) gives self.namedCallSubject(callee, mint: mint)
			tryCall(_, _, callee, _, _, _, _, _, mint) gives self.namedCallSubject(callee, mint: mint)
			witnessDispatch(_, _, _, _, methodIndex, interfaceDeclIndex, _, _) gives CallProducer.written("the result of '{self.calls.resolution.witnessMethodName(methodIndex, interfaceDeclIndex: interfaceDeclIndex)}'")
			witnessTryDispatch(_, _, _, _, _, methodIndex, interfaceDeclIndex, _) gives CallProducer.written("the result of '{self.calls.resolution.witnessMethodName(methodIndex, interfaceDeclIndex: interfaceDeclIndex)}'")
			indirectCall gives self.boundFunctionValueSubject(func, op: op)
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd gives CallProducer.notACall
		end 'op'
	end 'producerOfOp'

	// ⭐ **E3077 IS WITHHELD WHERE `let` WOULD NOT COMPILE.** A `var` the author never reassigned is
	// still legitimately mutable when a `let` there would be refused: bound to a value that reaches
	// writable state (E3188), handed whole to a door and read afterwards, written through, or — while
	// it is live after the door — stored into writable storage or reached by a value another `var`
	// door takes. The parser reported its first candidate; the first one that does NEED `let` is
	// reported instead, or none.
	function withholdVarShouldBeLet(func IrFunction, candidates VarShouldBeLetCandidates)
		var firstUnexcused = candidates.values.count()

		for c in 0 upto candidates.values.count() 'eachCandidate'
			let value = try candidates.values.get(c) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: values.get OOB at {c}")
			let name = try candidates.names.get(c) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: names.get OOB at {c}")
			let declared = try candidates.declTokens.get(c) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: declTokens.get OOB at {c}")
			let lastUse = (try candidates.infos.get(c) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: infos.get OOB at {c}")).lastReadToken
			let liveUntil = liveUntilAcrossLoops(declared, lastUse: lastUse if lastUse > declared else declared, loops: func.provenanceSites(self.noSites).loops)

			if not self.varIsNeededMutable(func, value: value, name: name, liveUntil: liveUntil) 'couldBeALet'
				firstUnexcused = c
				break
			end 'couldBeALet'
		end 'eachCandidate'

		if firstUnexcused == 0 'theReportedOneStands'
			return
		end 'theReportedOneStands'

		let at = try self.hygieneIndexOf(candidates.reported) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: the E3077 the parser filed with these candidates is not among the project's binding-hygiene diagnostics — `commitDiagnostics` merges every artifact's")

		if firstUnexcused == candidates.values.count() 'everyOneIsNeeded'
			try self.hygieneWithdrawn.set(at, value: true) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: hygieneWithdrawn.set OOB at {at}")
			return
		end 'everyOneIsNeeded'

		let name = try candidates.names.get(firstUnexcused) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: names.get OOB at {firstUnexcused}")
		let range = try candidates.ranges.get(firstUnexcused) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: ranges.get OOB at {firstUnexcused}")
		try self.project.bindingHygieneDiagnostics.set(at, value: Diagnostic.create(ErrorCode.semanticVarShouldBeLet, message: varShouldBeLetMessage(String.from(name)), line: range.line, column: range.column, filePath: hygieneSiteOf(candidates.reported).0)) otherwise panic("ProvenanceTracer.withholdVarShouldBeLet: bindingHygieneDiagnostics.set OOB at {at}")
	end 'withholdVarShouldBeLet'

	function hygieneIndexOf(reported Diagnostic) returns ElementIndex throws AbsentError
		self.indexHygieneDiagnostics()
		var at = try self.hygieneFirstAtPosition.get(hygienePositionKeyOf(reported)) otherwise throw AbsentError.absent

		while not hygieneDiagnosticsAreOne(try self.project.bindingHygieneDiagnostics.get(at) otherwise panic("ProvenanceTracer.hygieneIndexOf: bindingHygieneDiagnostics.get OOB at {at}"), reported: reported) 'eachAtThePosition'
			at = try self.hygieneNextAtPosition.get(at)
		end 'eachAtThePosition'

		return at
	end 'hygieneIndexOf'

	// Index the binding-hygiene diagnostics by position, once: a position's chain starts at the first of them.
	function indexHygieneDiagnostics()
		if self.hygieneIndexed 'indexed'
			return
		end 'indexed'

		self.hygieneIndexed = true
		let count = self.project.bindingHygieneDiagnostics.count()
		self.hygieneNextAtPosition.makeAbsent(count)
		self.hygieneWithdrawn.refill(count, value: false)
		var i = count

		while i > 0 'eachFromTheLast'
			i = i - 1
			let diagnostic = try self.project.bindingHygieneDiagnostics.get(i) otherwise panic("ProvenanceTracer.indexHygieneDiagnostics: bindingHygieneDiagnostics.get OOB at {i}")
			let key = hygienePositionKeyOf(diagnostic)

			if let following = try self.hygieneFirstAtPosition.get(key) 'aLaterOneAtThePosition'
				self.hygieneNextAtPosition.set(i, value: following)
			end 'aLaterOneAtThePosition'

			self.hygieneFirstAtPosition.upsert(key, value: i)
		end 'eachFromTheLast'
	end 'indexHygieneDiagnostics'

	// The diagnostics a door withdrew, dropped in one pass once every function has settled.
	function dropWithdrawnHygiene()
		if not self.hygieneIndexed 'noneWithdrawn'
			return
		end 'noneWithdrawn'

		var kept = DiagnosticArray.create()

		for i in 0 upto self.project.bindingHygieneDiagnostics.count() 'eachDiagnostic'
			if not (try self.hygieneWithdrawn.get(i) otherwise panic("ProvenanceTracer.dropWithdrawnHygiene: hygieneWithdrawn.get OOB at {i}")) 'kept'
				kept.push(try self.project.bindingHygieneDiagnostics.get(i) otherwise panic("ProvenanceTracer.dropWithdrawnHygiene: bindingHygieneDiagnostics.get OOB at {i}"))
			end 'kept'
		end 'eachDiagnostic'

		self.project.bindingHygieneDiagnostics = kept
	end 'dropWithdrawnHygiene'

	// Would a `let` in place of the `var` named `name` holding `value`, live until `liveUntil`, be
	// refused where it is bound, or meet a mutable door that moves or refuses it?
	function varIsNeededMutable(func IrFunction, value ValueId, name ByteArray, liveUntil ElementIndex) returns bool
		let rank = try self.writableRankOf(value) otherwise return false

		if self.valueReachesWritableState(func, value: value, rank: rank) 'aLetWouldBeRefused'
			return true
		end 'aLetWouldBeRefused'

		view sites = func.provenanceSites(self.noSites)

		for k in 0 upto sites.moveSites.count() 'eachDoor'
			view site = try sites.moveSites.get(k) otherwise panic("ProvenanceTracer.varIsNeededMutable: moveSites.get OOB at {k}")

			if not site.sourceIsMutable or site.destinationKind == MoveDestinationKind.keptArgument or site.sourceValue != value or not site.source.equals(name) 'anotherDoor'
				continue
			end 'anotherDoor'

			if site.readAfter 'aLetWouldNotCompile'
				return true
			end 'aLetWouldNotCompile'
		end 'eachDoor'

		if self.boundRecordOrAnyPartOfItIsWrittenThrough(value) 'aLetWouldBeWrittenThrough'
			return true
		end 'aLetWouldBeWrittenThrough'

		for k in 0 upto sites.moveSites.count() 'eachStore'
			view site = try sites.moveSites.get(k) otherwise panic("ProvenanceTracer.varIsNeededMutable: moveSites.get OOB at {k}")

			if site.destinationKind == MoveDestinationKind.mutablePlace and liveUntil > site.token and self.valueReachesRank(site.value, rank: rank) 'aLetWouldBeStoredAndReadAgain'
				return true
			end 'aLetWouldBeStoredAndReadAgain'
		end 'eachStore'

		for site in sites.mutableBindingSites 'eachBinding'
			if liveUntil > site.token and site.value != value and self.valueReachesRank(site.value, rank: rank) 'derivedIntoAMutableName'
				return true
			end 'derivedIntoAMutableName'
		end 'eachBinding'

		return false
	end 'varIsNeededMutable'

	// A refusal, held in source order until the function's doors have all asked. Equal positions keep the order
	// the doors asked in.
	module function refuse(line LineNumber, column ColumnNumber, code ErrorCode, message String)
		self.holdRefusal(PendingRefusal.create(line, column: column, code: code, message: message))
	end 'refuse'

	function holdRefusal(refusal PendingRefusal)
		var at = self.refusals.count()

		while at > 0 and (try self.refusals.get(at - 1) otherwise panic("ProvenanceTracer.holdRefusal: refusals.get OOB at {at - 1}")).at > refusal.at 'pastLaterOnes'
			at = at - 1
		end 'pastLaterOnes'

		self.refusals.insert(at, value: refusal)
	end 'holdRefusal'

	function reportRefusals(func IrFunction)
		if self.refusals.count() > 0 and self.enteredIndex < self.refusedBodies.count() 'thisBodyIsRefused'
			try self.refusedBodies.set(self.enteredIndex, value: true) otherwise panic("ProvenanceTracer.reportRefusals: refusedBodies.set OOB at {self.enteredIndex}")
		end 'thisBodyIsRefused'

		for refusal in self.refusals 'eachRefusal'
			reportPositioned(self.project, code: refusal.code, message: refusal.message, line: refusal.line, column: refusal.column, filePath: func.sourceFilePath)
		end 'eachRefusal'

		self.refusals.clear()
	end 'reportRefusals'

	// "the result of '<callee>', which may share storage with …" — the call as written, and the binding the
	// storage belongs to when the call was handed it whole rather than a field of it. It restores the door it was
	// asked under, since its callers ask it with their own door still open.
	function sharedStorageSubject(func IrFunction, ir MaxonModule, value ValueId, token ElementIndex) returns String
		let outerDoor = self.doorToken
		self.askAtDoor(token)
		let subject = self.sharedStorageSubjectAtTheDoor(func, ir: ir, value: value)
		self.doorToken = outerDoor
		return subject
	end 'sharedStorageSubject'

	function sharedStorageSubjectAtTheDoor(func IrFunction, ir MaxonModule, value ValueId) returns String
		let produced = self.producingValueOf(func, ir: ir, value: value)

		let opIndex = try self.definingOpIndexOf(produced) otherwise return self.sharedStorageClause(func, producer: UnattributedProducer, value: produced, producerOperands: singletonValue(produced))
		view op = try ir.ops.get(opIndex) otherwise panic("ProvenanceTracer.sharedStorageSubjectAtTheDoor: opIndex {opIndex} not in module.ops")
		return self.sharedStorageClause(func, producer: self.producerOfOp(func, op: op).subject(), value: produced, producerOperands: self.producerOperandsOf(op, value: produced))
	end 'sharedStorageSubjectAtTheDoor'

	function producingValueOf(func IrFunction, ir MaxonModule, value ValueId) returns ValueId
		self.indexDefinitions(func, ir: ir)
		var produced = value

		for _ in 0 upto MaxAccessPathSteps 'eachHop'
			let base = self.sameRecordBase(func, ir: ir, value: produced)
			let incoming = self.reachingIncomingOf(func, merge: base) if self.immutableBindingsAreTraced(func) else base

			if incoming == produced 'noFurtherHop'
				break
			end 'noFurtherHop'

			produced = incoming
		end 'eachHop'

		return produced
	end 'producingValueOf'

	function derivesFromAModuleLet(func IrFunction, value ValueId, root String, kind ReadOnlyRootKind) returns bool
		if kind != ReadOnlyRootKind.moduleLet 'notAModuleLet'
			return false
		end 'notAModuleLet'

		if not self.immutableBindingsAreTraced(func) 'nothingToProveItBy'
			return root.isEmpty()
		end 'nothingToProveItBy'

		return match self.accessRootOf(func, ir: self.module, value: value) 'root'
			binding(rank) gives not (self.rootIsModuleLetAt(rank) or String.from(self.rootNameAt(rank)) == root)
			computed gives true
			ground or
			unknown gives root.isEmpty()
		end 'root'
	end 'derivesFromAModuleLet'

	module function blamedSubject(func IrFunction, value ValueId, blamed WriteBlame, call SourceRange) returns String
		let root = blamed.rootName()
		let kind = blamed.rootKind()

		if self.derivesFromAModuleLet(func, value: value, root: root, kind: kind) 'sharesAModuleLetsStorage'
			return self.sharedStorageSubject(func, ir: self.module, value: value, token: self.callTokenAtPosition(func, line: call.line, column: call.column))
		end 'sharesAModuleLetsStorage'

		return readOnlyRootSubject(root, kind: kind)
	end 'blamedSubject'

	function writeThroughBlameMessage(func IrFunction, target ValueId, place ByteArray, blamed WriteBlame, token ElementIndex) returns String
		let root = blamed.rootName()
		let kind = blamed.rootKind()

		if self.derivesFromAModuleLet(func, value: target, root: root, kind: kind) 'sharesAModuleLetsStorage'
			return deepLetWriteSharedStorageMessage(String.from(place), subject: self.sharedStorageSubject(func, ir: self.module, value: target, token: token))
		end 'sharesAModuleLetsStorage'

		return deepLetWriteMessage(String.from(place), root: root, kind: kind)
	end 'writeThroughBlameMessage'

	module function keptArgumentSubject(func IrFunction, value ValueId, blamed WriteBlame, wording KeptWording, call SourceRange) returns String
		match wording 'wording'
			element then return self.storedRootSubject(func, value: value, root: blamed.rootName(), kind: blamed.rootKind(), token: self.callTokenAtPosition(func, line: call.line, column: call.column))
			call or
			consumed then return self.blamedSubject(func, value: value, blamed: blamed, call: call)
		end 'wording'
	end 'keptArgumentSubject'

	function storedRootSubject(func IrFunction, value ValueId, root String, kind ReadOnlyRootKind, token ElementIndex) returns String
		if self.derivesFromAModuleLet(func, value: value, root: root, kind: kind) 'sharesAModuleLetsStorage'
			return self.sharedStorageSubject(func, ir: self.module, value: value, token: token)
		end 'sharesAModuleLetsStorage'

		return deepLetStoredRootSubject(root, kind: kind)
	end 'storedRootSubject'

	function blameWrite(func IrFunction, target ValueId, own WriteBlame) returns WriteBlame
		if own.isBlamed() 'itsOwnRecord'
			return own
		end 'itsOwnRecord'

		return self.firstRootHolding(func, value: target)
	end 'blameWrite'

	// What the call that made `value` was handed, which a binding it names must have reached it through; a value
	// no call made stands for itself.
	function producerOperandsOf(op MaxonOp, value ValueId) returns ValueIdArray
		return match op 'op'
			call(_, _, args, _, _, _, _, _) gives args
			tryCall(_, _, _, args, _, _, _, _, _) gives args
			witnessDispatch(_, args, _, _, _, _, _, _) gives args
			witnessTryDispatch(_, _, args, _, _, _, _, _) gives args

			// Its `args` is the variant's tail field, so it is read in a small match (`LowerMaxonToStd.lowerIndirectCall`).
			indirectCall gives self.indirectCallOperands(op)
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd gives singletonValue(value)
		end 'op'
	end 'producerOperandsOf'

	function indirectCallOperands(op MaxonOp) returns ValueIdArray
		maxonOpOperandValues(op, into: self.operands)
		return self.operands
	end 'indirectCallOperands'

	// The member the author wrote: a declared callee through the diagnostic noun every call message uses, a
	// runtime entry through the method it serves. An entry that serves no method, and the helper that fills a
	// default, were never written as calls.
	function namedCallSubject(callee ByteArray, mint CalleeMint) returns CallProducer
		if calleeMintIsDefaultHelper(mint) 'aFilledDefault'
			return CallProducer.unwritten
		end 'aFilledDefault'

		if self.calls.resolution.declaresFunction(callee) 'declared'
			return CallProducer.written("the result of '{String.from(unqualifiedMemberOf(overloadRegistrationBaseName(callDiagnosticNoun(callee, mint: mint))))}'")
		end 'declared'

		return match runtimeCalleeSourceMethod(callee) 'written'
			found(method) gives CallProducer.written("the result of '{String.from(method)}'")
			sharedByTwoSpellings(spelling, alsoSpelled) gives CallProducer.written("the result of '{String.from(spelling)}' or '{String.from(alsoSpelled)}'")
			notFound gives CallProducer.unwritten
		end 'written'
	end 'namedCallSubject'

	// A call through a function value is named by the `let` its callee is bound to; one read out of anything else
	// has no name to give. The callee is read in a small match, for `producerOperandsOf`'s reason.
	function boundFunctionValueSubject(func IrFunction, op MaxonOp) returns CallProducer
		match op 'indirect'
			indirectCall(_, callee, _, _) then return self.letNamedSubject(func, callee: callee)
			default panic("ProvenanceTracer.boundFunctionValueSubject: handed an op that is not an indirect call")
		end 'indirect'
	end 'boundFunctionValueSubject'

	function letNamedSubject(func IrFunction, callee ValueId) returns CallProducer
		let bindings = func.provenanceSites(self.noSites).immutableBindings

		for i in 0 upto bindings.values.count() 'eachBinding'
			if (try bindings.values.get(i) otherwise panic("ProvenanceTracer.letNamedSubject: values.get OOB at {i}")) == callee 'namesTheCallee'
				return CallProducer.written("the result of '{String.from(try bindings.names.get(i) otherwise panic("ProvenanceTracer.letNamedSubject: names.get OOB at {i} — the two columns are pushed together"))}'")
			end 'namesTheCallee'
		end 'eachBinding'

		return CallProducer.unwritten
	end 'letNamedSubject'

	// The binding is named when the producer was handed it — or a record it holds — as an operand; a producer
	// handed only a field of one says so instead, since a field has no binding to name.
	function sharedStorageClause(func IrFunction, producer String, value ValueId, producerOperands ValueIdArray) returns String
		if not self.immutableBindingsAreTraced(func) 'noBindingToName'
			return sharingStorageSubject(producer, storage: readOnlyRootDescription(ReadOnlyRootKind.moduleLet))
		end 'noBindingToName'

		let byIdentity = self.leastHandedBindingRank(func, column: ProvenanceColumn.identity, value: value, producerOperands: producerOperands, bound: self.rootNames.count())
		let rank = self.leastHandedBindingRank(func, column: ProvenanceColumn.inside, value: value, producerOperands: producerOperands, bound: byIdentity)

		if self.isImmutableBindingRank(rank) 'handedTheBinding'
			return sharingStorageSubject(producer, storage: "immutable variable '{String.from(self.rootNameAt(rank))}'")
		end 'handedTheBinding'

		return sharingStorageSubject(producer, storage: self.reachedStorageNoun(func, value: value))
	end 'sharedStorageClause'

	function reachedStorageNoun(func IrFunction, value ValueId) returns String
		let reached = try self.firstRootRank(func, value: value, reach: RootReach.identityOrInside) otherwise return readOnlyRootDescription(ReadOnlyRootKind.moduleLet)

		if self.rootKindAt(reached) == ReadOnlyRootKind.moduleLet 'aModuleLetsField'
			return readOnlyRootDescription(ReadOnlyRootKind.moduleLet)
		end 'aModuleLetsField'

		return FieldOfImmutableVariableStorage
	end 'reachedStorageNoun'

	// The least rank below `bound` of `value`'s set in `column` that names a binding of a type `value` could be
	// or lie within, and the producer was handed — or `bound` itself, so two sets are searched as one by passing
	// the first one's answer to the second.
	function leastHandedBindingRank(func IrFunction, column ProvenanceColumn, value ValueId, producerOperands ValueIdArray, bound ElementIndex) returns ElementIndex
		let asksIdentity = column == ProvenanceColumn.identity

		if var chunk = try self.sets.first(self.setOf(column, value: value)) 'hasWords'
			while true 'eachWord'
				let mask = self.sets.wordOf(chunk)
				let firstRank = (self.sets.indexOf(chunk)) shl RootWordShift

				for bit in 0 upto RootBitIndexMask + 1 'eachBit'
					let rank = firstRank + bit

					if rank >= bound 'pastTheBound'
						return bound
					end 'pastTheBound'

					if maskHasParam(mask, param: bit as ParamCount) and self.rootCountsAtDoor(rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: asksIdentity) and self.anOperandIsOrHolds(producerOperands, rank: rank) 'handed'
						return rank
					end 'handed'
				end 'eachBit'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return bound
	end 'leastHandedBindingRank'

	function anOperandIsOrHolds(producerOperands ValueIdArray, rank ElementIndex) returns bool
		for operand in producerOperands 'eachOperand'
			if self.sets.hasRank(self.setOf(ProvenanceColumn.identity, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.holds, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.storedHolds, value: operand), rank: rank) or self.sets.hasRank(self.setOf(ProvenanceColumn.deepHolds, value: operand), rank: rank) 'reached'
				return true
			end 'reached'
		end 'eachOperand'

		return false
	end 'anOperandIsOrHolds'

	// The op whose result `value` is, out of the function's definitions (`indexDefinitions`).
	function definingOpOf(func IrFunction, ir MaxonModule, value ValueId) returns DefiningOp
		self.indexDefinitions(func, ir: ir)
		let opIdx = try self.definingOpIndexOf(value) otherwise return DefiningOp.notAnOp
		return DefiningOp.op(opIdx)
	end 'definingOpOf'

	function isTracked(value ValueId) returns bool
		return try self.tracked.get(value) otherwise panic("ProvenanceTracer.isTracked: v{value} is past the traced function's value count")
	end 'isTracked'

	function setOf(column ProvenanceColumn, value ValueId) returns ElementIndex
		return column.ordinal * self.setsPerColumn + (value)
	end 'setOf'

	function wordAt(column ProvenanceColumn, value ValueId, word MaskWordCount) returns ParamPositionMask
		return self.sets.wordAt(self.setOf(column, value: value), word: word)
	end 'wordAt'

	function unionInto(to ElementIndex, from ElementIndex)
		if self.sets.union(to, from: from) 'grew'
			self.changed = true
		end 'grew'
	end 'unionInto'

	function unionMask(column ProvenanceColumn, to ValueId, from ProvenanceColumn, source ValueId)
		self.unionInto(self.setOf(column, value: to), from: self.setOf(from, value: source))
	end 'unionMask'

	// `key`'s set in `table`, minted empty on the first store into it.
	function slotIn(table StoreSlotTable, key StoreSlotKey) returns ElementIndex
		if let known = try table.setAt(key) 'known'
			return known
		end 'known'

		let slot = self.sets.addSet()
		table.file(key, slot: slot)
		return slot
	end 'slotIn'

	function setBit(column ProvenanceColumn, value ValueId, rank ElementIndex)
		self.sets.addRank(self.setOf(column, value: value), rank: rank)
	end 'setBit'

	// `setBit` from inside a walk, where a set that grows must be read again.
	function seedBit(column ProvenanceColumn, value ValueId, rank ElementIndex)
		let set = self.setOf(column, value: value)

		if not self.sets.hasRank(set, rank: rank) 'new'
			self.sets.addRank(set, rank: rank)
			self.changed = true
		end 'new'
	end 'seedBit'

	// ⭐ **THE BINDING A DOOR BLAMES FOR `value`:** the `let` whose own record `value` is, when it is one; else the
	// first in declaration order it may BE (`RootReach.identity`) — only a binding whose record could have
	// `value`'s type, since one record is never two declared types — or, reaching further, may lie within.
	// `unblamed` when there is none.
	function firstRootName(func IrFunction, value ValueId, reach RootReach) returns WriteBlame
		let rank = try self.firstRootRank(func, value: value, reach: reach) otherwise return WriteBlame.unblamed
		return self.blameOfRootAt(rank)
	end 'firstRootName'

	function firstRootRank(func IrFunction, value ValueId, reach RootReach) returns ElementIndex throws AbsentError
		let bound = self.rootNames.count()

		if let own = try self.bindingRankOf(value) 'aBindingsOwnValue'
			if self.rootCountsAtDoor(own) 'itCounts'
				return own
			end 'itCounts'

			throw AbsentError.absent
		end 'aBindingsOwnValue'

		var rank = self.leastAdmittedRank(func, column: ProvenanceColumn.identity, value: value, bound: bound, also: RootCondition.none)

		if reach == RootReach.identityOrInside 'withinToo'
			rank = self.leastAdmittedRank(func, column: ProvenanceColumn.inside, value: value, bound: rank, also: RootCondition.none)
		end 'withinToo'

		if not self.isImmutableBindingRank(rank) 'notAnImmutableName'
			throw AbsentError.absent
		end 'notAnImmutableName'

		return rank
	end 'firstRootRank'

	// The least rank below `bound` in `value`'s set in `column` that names a binding `value`'s type admits, or
	// `bound` itself — so several sets are searched as one by passing each one's answer to the next. What `value`
	// may BE is asked of a binding whose record could have `value`'s type, and what it lies within of a binding
	// whose record can hold one. `also` is what else the door asks of the root. The set is walked by its bits, so a
	// question costs what the set holds rather than every binding of the function.
	function leastAdmittedRank(func IrFunction, column ProvenanceColumn, value ValueId, bound ElementIndex, also RootCondition) returns ElementIndex
		let asksIdentity = column == ProvenanceColumn.identity

		if var chunk = try self.sets.first(self.setOf(column, value: value)) 'hasWords'
			while true 'eachWord'
				let mask = self.sets.wordOf(chunk)
				let firstRank = (self.sets.indexOf(chunk)) shl RootWordShift

				for bit in 0 upto RootBitIndexMask + 1 'eachBit'
					let rank = firstRank + bit

					if rank >= bound 'pastTheBound'
						return bound
					end 'pastTheBound'

					if maskHasParam(mask, param: bit as ParamCount) and self.rootCountsAtDoor(rank) and self.typeAdmits(func, value: value, rank: rank, asksIdentity: asksIdentity) and self.rootMeets(also, rank: rank, value: value, func: func) and (not asksIdentity or self.slotMayHoldRoot(func, ir: self.module, rank: rank, value: value)) 'admitted'
						return rank
					end 'admitted'
				end 'eachBit'

				chunk = try self.sets.next(chunk) otherwise break
			end 'eachWord'
		end 'hasWords'

		return bound
	end 'leastAdmittedRank'

	function rootMeets(condition RootCondition, rank ElementIndex, value ValueId, func IrFunction) returns bool
		return match condition 'condition'
			none gives true
			slotNotRewritten gives not self.slotRewrittenSinceRootRead(func, ir: self.module, rank: rank, target: value)
			aKeptName gives self.rootIsAKeptName(rank)
			aStoredName gives self.rootIsAStoredName(rank)
		end 'condition'
	end 'rootMeets'

	function typeAdmits(func IrFunction, value ValueId, rank ElementIndex, asksIdentity bool) returns bool
		if asksIdentity 'mayBeIt'
			return self.valuesMayBeOneRecord(func, value: value, other: self.rootValueAt(rank))
		end 'mayBeIt'

		return self.kindsMayHoldValue(func, kinds: try self.rootRecordKinds.get(rank) otherwise panic("ProvenanceTracer.typeAdmits: rootRecordKinds.get OOB at {rank} — it is pushed with the roots"), value: value)
	end 'typeAdmits'

	// Can `value` BE the record `other` holds? Two records of different declared types are two records; an opaque
	// `T` or an existential may stand for any, and a byte record's identity is its bytes' holder whatever it is
	// spelled as. Two `named` values are compared by the record their names denote.
	function valuesMayBeOneRecord(func IrFunction, value ValueId, other ValueId) returns bool
		let tag = valueTagOf(func, value: value)
		let otherTag = valueTagOf(func, value: other)

		if not mayBeOneRecord(tag, other: otherTag) 'twoRepresentations'
			return false
		end 'twoRepresentations'

		if self.opaqueElementIsWithin(func, element: value, container: other) or self.opaqueElementIsWithin(func, element: other, container: value) 'anElementOfTheOther'
			return false
		end 'anElementOfTheOther'

		if tagIsOpaqueRecord(tag) or tagIsOpaqueRecord(otherTag) or tagIsByteRecord(tag) 'anyOfItsKind'
			return true
		end 'anyOfItsKind'

		if tag == otherTag and tag != ValueTypeTag.named and tag != ValueTypeTag.genericInstance 'oneRepresentation'
			return self.nameIdOf(func, value: value) == self.nameIdOf(func, value: other)
		end 'oneRepresentation'

		view kind = try self.heldRecordKindOf(func, value: value) otherwise return true
		return kind.equals(try self.heldRecordKindOf(func, value: other) otherwise return true)
	end 'valuesMayBeOneRecord'

	function opaqueElementIsWithin(func IrFunction, element ValueId, container ValueId) returns bool
		if valueTagOf(func, value: element) != ValueTypeTag.typeParameter or valueTagOf(func, value: container) != ValueTypeTag.genericInstance 'notAnElementInAnInstance'
			return false
		end 'notAnElementInAnInstance'

		return self.signatures.instanceArgsMentionTypeParameter(self.instanceIdOf(func, value: container), param: self.nameIdOf(func, value: element) as TypeParamId)
	end 'opaqueElementIsWithin'

	// The kind `value`'s record is, as `HeldRecordKinds` names kinds. A name that denotes no record a value can
	// have throws.
	function heldRecordKindOf(func IrFunction, value ValueId) returns ByteArray throws MapError
		if valueTagOf(func, value: value) == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.canonicalInstanceName(self.instanceIdOf(func, value: value))
		end 'anInstance'

		return try self.signatures.heldRecordKindOfDeclaredName(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise throw MapError.keyNotFound)
	end 'heldRecordKindOf'

	// The kinds of record that may lie within `value`'s record, by its type: none within a byte record, any within
	// one of an opaque type. `ProgramSignatures` answers once per type per compile.
	function recordKindsWithinValue(func IrFunction, value ValueId) returns HeldRecordKinds
		let tag = valueTagOf(func, value: value)

		if tagIsByteRecord(tag) 'bytes'
			return self.noRecordKinds
		end 'bytes'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.recordKindsWithinInstanceOf(self.instanceIdOf(func, value: value))
		end 'anInstance'

		if not self.signatures.tagMayNameAggregate(tag) 'anyOtherKind'
			return self.anyRecordKinds
		end 'anyOtherKind'

		return self.recordKindsWithinAggregateNamed(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise return self.anyRecordKinds)
	end 'recordKindsWithinValue'

	function recordKindsWithinInstanceOf(id GenericInstanceId) returns HeldRecordKinds
		if let memoized = try self.recordKindsByInstance.get(id) 'asked'
			return memoized
		end 'asked'

		var within = self.signatures.recordKindsWithinInstance(id)
		self.recordKindsByInstance.upsert(id, value: within)
		return within
	end 'recordKindsWithinInstanceOf'

	function recordKindsWithinAggregateNamed(name ByteArray) returns HeldRecordKinds
		if let memoized = try self.recordKindsByAggregate.get(name) 'asked'
			return memoized
		end 'asked'

		var within = self.signatures.recordKindsWithinAggregate(name)
		self.recordKindsByAggregate.upsert(name, value: within)
		return within
	end 'recordKindsWithinAggregateNamed'

	function nameIdOf(func IrFunction, value ValueId) returns TypeNameId
		return try func.valueNameIds.get(value) otherwise panic("ProvenanceTracer.nameIdOf: v{value} of '{String.from(func.name)}' has no type name — the type columns are minted in lockstep")
	end 'nameIdOf'

	function instanceIdOf(func IrFunction, value ValueId) returns GenericInstanceId
		return self.nameIdOf(func, value: value) as GenericInstanceId
	end 'instanceIdOf'

	function rootValueAt(rank ElementIndex) returns ValueId
		return try self.rootValues.get(rank) otherwise panic("ProvenanceTracer.rootValueAt: rank {rank} is past the {self.rootValues.count()} roots traced")
	end 'rootValueAt'

	function isImmutableBindingRank(rank ElementIndex) returns bool
		return rank < self.rootNames.count()
	end 'isImmutableBindingRank'

	function rootKindAt(rank ElementIndex) returns ReadOnlyRootKind
		if self.rootIsModuleLetAt(rank) 'aModuleLet'
			return ReadOnlyRootKind.moduleLet
		end 'aModuleLet'

		return (try self.rootInfos.get(rank) otherwise panic("ProvenanceTracer.rootKindAt: rootInfos.get OOB at {rank} — it is pushed with the roots")).rootKind
	end 'rootKindAt'

	function rootNameAt(rank ElementIndex) returns ByteArray
		return try self.rootNames.get(rank) otherwise panic("ProvenanceTracer.rootNameAt: rank {rank} is past the {self.rootNames.count()} named roots — only an immutable-binding trace names its roots")
	end 'rootNameAt'

	// Every value that may denote a record, a function value (which carries its closure's environment)
	// included. A `named` type may be a boxed union or a ranged scalar, and only the first holds one.
	function typeCarriesProvenance(t MaxonType) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.named or tagNamesADeclaredType(tag) 'namesADeclaration'
			return self.signatures.typeIsManaged(t, from: self.project.typeNames)
		end 'namesADeclaration'

		return tagCarriesProvenance(tag)
	end 'typeCarriesProvenance'

	// A record nothing writes (`ProgramSignatures.aggregateTypeIsImmutable`).
	function valueIsAnImmutableAggregate(func IrFunction, value ValueId) returns bool
		if valueTagOf(func, value: value) == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.genericInstanceIsImmutable(self.instanceIdOf(func, value: value))
		end 'anInstance'

		if not self.signatures.tagMayNameAggregate(valueTagOf(func, value: value)) 'namesNoAggregate'
			return false
		end 'namesNoAggregate'

		let nameId = self.nameIdOf(func, value: value)

		if let known = try self.namedTypeIsUnwritable.get(nameId) 'asked'
			return known
		end 'asked'

		let verdict = self.signatures.aggregateTypeIsImmutable(try self.project.typeNames.nameOf(nameId) otherwise return false)
		self.namedTypeIsUnwritable.upsert(nameId, value: verdict)
		return verdict
	end 'valueIsAnImmutableAggregate'

	module function valueGivesAStoreNoWriter(func IrFunction, value ValueId) returns bool
		return self.valueHoldsNoRecord(func, value: value) or self.valueIsAnImmutableAggregate(func, value: value)
	end 'valueGivesAStoreNoWriter'

	function valueHoldsNoRecord(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)
		return tagIsAScalarWhateverIsDeclared(tag) or tagIsByteRecord(tag) or not self.valueTagCarriesProvenance(func, value: value)
	end 'valueHoldsNoRecord'

	module function valueTagCarriesProvenance(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tag == ValueTypeTag.named or tagNamesADeclaredType(tag) 'namesADeclaration'
			let nameId = self.nameIdOf(func, value: value)

			if self.namedTypeHoldsARecord.contains(nameId) 'asked'
				return try self.namedTypeHoldsARecord.get(nameId) otherwise panic("ProvenanceTracer.valueTagCarriesProvenance: name {nameId} left the memo after `contains`")
			end 'asked'

			let holdsARecord = self.typeCarriesProvenance(maxonTypeOfTag(tag, nameId: nameId))
			self.namedTypeHoldsARecord.upsert(nameId, value: holdsARecord)
			return holdsARecord
		end 'namesADeclaration'

		return tagCarriesProvenance(tag)
	end 'valueTagCarriesProvenance'

	function opReadsAReadOnlyElement(func IrFunction, op MaxonOp) returns bool
		match maxonOpCalleeKind(op) 'kind'
			direct then break
			functionValue or
			noCallee then return false
		end 'kind'

		maxonOpOperandValues(op, into: self.operands)

		if self.operands.isEmpty() 'noReceiver'
			return false
		end 'noReceiver'

		return self.callReadsAReadOnlyInstanceElement(func, callee: maxonOpCalleeName(op), receiver: try self.operands.get(0) otherwise panic("ProvenanceTracer.opReadsAReadOnlyElement: operands.get(0) on a non-empty list"))
	end 'opReadsAReadOnlyElement'

	function opLoadsALetFieldRecord(func IrFunction, op MaxonOp) returns bool
		return match op 'op'
			loadIndirect(result, addr, offset, _) gives self.valueTagCarriesProvenance(func, value: result) and self.slotIsALetSlot(func, addr: addr, offset: offset, held: result)

			call or
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			storeIndirect or
			stringLiteral or
			tryCall or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd gives false
		end 'op'
	end 'opLoadsALetFieldRecord'

	module function settleFreshReturns(funcNames FunctionNameIndex)
		let funcCount = funcNames.functions.count()
		var needCallers = FuncIndexArray.create()
		var needCallees = FuncIndexArray.create()
		self.freshReturns.refill(funcCount, value: false)

		for index in 0 upto funcCount 'eachFunction'
			view func = self.functionAt(index)

			if bodyIsUnreadable(func) or not self.resultMayHandBackAModuleLetsRecord(func) 'returnsNoRecord'
				continue
			end 'returnsNoRecord'

			if self.signatures.returnsFreshValue(func.name) 'sweptFresh'
				try self.freshReturns.set(index, value: true) otherwise panic("ProvenanceTracer.settleFreshReturns: freshReturns.set OOB at {index}")
				continue
			end 'sweptFresh'

			if not self.returnsAFreshGraph(func) 'notProvenFresh'
				continue
			end 'notProvenFresh'

			try self.freshReturns.set(index, value: true) otherwise panic("ProvenanceTracer.settleFreshReturns: freshReturns.set OOB at {index}")

			for need in self.freshNeeds 'eachNeed'
				needCallers.push(index)
				needCallees.push(need)
			end 'eachNeed'
		end 'eachFunction'

		var refutedSomething = true

		while refutedSomething 'untilNothingIsRefuted'
			refutedSomething = false

			for k in 0 upto needCallers.count() 'eachNeedEdge'
				let caller = try needCallers.get(k) otherwise panic("ProvenanceTracer.settleFreshReturns: needCallers.get OOB at {k}")
				let callee = try needCallees.get(k) otherwise panic("ProvenanceTracer.settleFreshReturns: needCallees.get OOB at {k}")

				if (try self.freshReturns.get(caller) otherwise panic("ProvenanceTracer.settleFreshReturns: freshReturns.get OOB at {caller}")) and not (try self.freshReturns.get(callee) otherwise panic("ProvenanceTracer.settleFreshReturns: freshReturns.get OOB at {callee}")) 'refuted'
					try self.freshReturns.set(caller, value: false) otherwise panic("ProvenanceTracer.settleFreshReturns: freshReturns.set OOB at {caller}")
					refutedSomething = true
				end 'refuted'
			end 'eachNeedEdge'
		end 'untilNothingIsRefuted'
	end 'settleFreshReturns'

	function returnsAFreshGraph(func IrFunction) returns bool
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		let valueCount = func.valueTags.count()
		self.freshMember.refill(valueCount, value: false)
		self.freshRequired.refill(valueCount, value: false)
		self.freshChecked.refill(valueCount, value: false)
		self.freshNeeds.clear()
		var returnsARecord = false

		for blockRef in func.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.returnsAFreshGraph: blockRef from func.blockRefs not in module.blocks")

			if block.hasTerminatorOp() 'terminated'
				returnsARecord = self.seedReturnedFreshGraph(func, terminator: try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.returnsAFreshGraph: terminatorIndex not in module.ops")) or returnsARecord
			end 'terminated'
		end 'eachBlock'

		if not returnsARecord 'returnsNoRecord'
			return false
		end 'returnsNoRecord'

		var rounds = 0 as ElementIndex
		self.freshChanged = true

		while self.freshChanged 'untilNothingGrows'
			self.freshChanged = false
			rounds = rounds + 1

			if rounds > MaxFreshRounds 'tooManyRounds'
				return false
			end 'tooManyRounds'

			if not self.sweepFreshGraph(func, ir: ir) 'aUseKeepsItElsewhere'
				return false
			end 'aUseKeepsItElsewhere'

			for value in 0 upto valueCount 'eachValue'
				if not (try self.freshRequired.get(value) otherwise panic("ProvenanceTracer.returnsAFreshGraph: freshRequired.get OOB at v{value}")) or (try self.freshChecked.get(value) otherwise panic("ProvenanceTracer.returnsAFreshGraph: freshChecked.get OOB at v{value}")) 'nothingToCheck'
					continue
				end 'nothingToCheck'

				try self.freshChecked.set(value, value: true) otherwise panic("ProvenanceTracer.returnsAFreshGraph: freshChecked.set OOB at v{value}")

				if not self.freshOriginHolds(func, ir: ir, value: value as ValueId) 'notFreshAtItsOrigin'
					return false
				end 'notFreshAtItsOrigin'
			end 'eachValue'
		end 'untilNothingGrows'

		return true
	end 'returnsAFreshGraph'

	function seedReturnedFreshGraph(func IrFunction, terminator MaxonOp) returns bool
		let returned = try returnedValueOf(terminator) otherwise return false
		return self.seedReturnedFreshValue(func, value: returned)
	end 'seedReturnedFreshGraph'

	function returnsARecordValue(func IrFunction) returns bool
		return anyReturnedValue(func, ir: self.module, test: function(returned) gives self.valueTagCarriesProvenance(func, value: returned))
	end 'returnsARecordValue'

	function seedReturnedFreshValue(func IrFunction, value ValueId) returns bool
		if not self.valueTagCarriesProvenance(func, value: value) 'aScalar'
			return false
		end 'aScalar'

		self.requireFreshMember(value)
		return true
	end 'seedReturnedFreshValue'

	function isFreshMember(value ValueId) returns bool
		return try self.freshMember.get(value) otherwise panic("ProvenanceTracer.isFreshMember: freshMember.get OOB at v{value}")
	end 'isFreshMember'

	function joinFreshMember(value ValueId)
		if not self.isFreshMember(value) 'newMember'
			try self.freshMember.set(value, value: true) otherwise panic("ProvenanceTracer.joinFreshMember: freshMember.set OOB at v{value}")
			self.freshChanged = true
		end 'newMember'
	end 'joinFreshMember'

	function requireFreshMember(value ValueId)
		self.joinFreshMember(value)

		if not (try self.freshRequired.get(value) otherwise panic("ProvenanceTracer.requireFreshMember: freshRequired.get OOB at v{value}")) 'newRequirement'
			try self.freshRequired.set(value, value: true) otherwise panic("ProvenanceTracer.requireFreshMember: freshRequired.set OOB at v{value}")
			self.freshChanged = true
		end 'newRequirement'
	end 'requireFreshMember'

	function anOperandIsAFreshMember() returns bool
		for operand in self.operands 'eachOperand'
			if self.isFreshMember(operand) 'aMember'
				return true
			end 'aMember'
		end 'eachOperand'

		return false
	end 'anOperandIsAFreshMember'

	function sweepFreshGraph(func IrFunction, ir MaxonModule) returns bool
		for position in 0 upto func.blockRefs.count() 'eachBlock'
			let block = try ir.blocks.get(try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.sweepFreshGraph: blockRefs.get OOB at {position}")) otherwise panic("ProvenanceTracer.sweepFreshGraph: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				if not self.sweepFreshOp(func, op: try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.sweepFreshGraph: opIdx {opIdx} not in module.ops")) 'aUseKeepsItElsewhere'
					return false
				end 'aUseKeepsItElsewhere'
			end 'eachOp'

			for pair in self.pairsFrom(position) upto self.pairsUpTo(position) 'eachPhi'
				if self.pairIsHanded(pair) 'handed'
					self.joinFreshPhi(func, phi: self.pairMergeAt(pair), incoming: self.pairIncomingAt(pair))
				end 'handed'
			end 'eachPhi'
		end 'eachBlock'

		return true
	end 'sweepFreshGraph'

	function joinFreshPhi(func IrFunction, phi ValueId, incoming ValueId)
		if not self.valueTagCarriesProvenance(func, value: phi) 'aScalar'
			return
		end 'aScalar'

		if self.isFreshMember(phi) or self.isFreshMember(incoming) 'oneOfTheGraph'
			self.joinFreshMember(phi)
			self.joinFreshMember(incoming)
		end 'oneOfTheGraph'

		if (try self.freshRequired.get(phi) otherwise false) 'aRequiredMerge'
			self.requireFreshMember(incoming)
		end 'aRequiredMerge'
	end 'joinFreshPhi'

	function sweepFreshOp(func IrFunction, op MaxonOp) returns bool
		maxonOpOperandValues(op, into: self.operands)

		if not self.anOperandIsAFreshMember() 'touchesNoMember'
			return true
		end 'touchesNoMember'

		return match op 'op'
			loadIndirect(result, _, _, _) gives self.joinDerivedFreshValue(func, result: result)
			holdValue(result, _, _, _, _) gives self.joinDerivedFreshValue(func, result: result)
			storeIndirect(addr, _, value, _) gives self.sweepFreshStore(func, addr: addr, value: value)
			call(result, callee, args, argLabels, _, _, _, _) gives self.sweepFreshCall(func, result: result, callee: callee, args: args, argLabels: argLabels)
			tryCall(result, _, callee, args, argLabels, _, _, _, _) gives self.sweepFreshCall(func, result: result, callee: callee, args: args, argLabels: argLabels)

			ret or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			switch or
			covPoint or
			holdEnd gives true

			literal or
			retVoid or
			globalAddr or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			rawIntrinsic or
			existentialWitness gives false
		end 'op'
	end 'sweepFreshOp'

	function joinDerivedFreshValue(func IrFunction, result ValueId) returns bool
		if self.valueTagCarriesProvenance(func, value: result) and not self.valueGivesAStoreNoWriter(func, value: result) 'aRecord'
			self.joinFreshMember(result)
		end 'aRecord'

		return true
	end 'joinDerivedFreshValue'

	function sweepFreshStore(func IrFunction, addr ValueId, value ValueId) returns bool
		if self.isFreshMember(value) and not self.isFreshMember(addr) 'storedOutside'
			return false
		end 'storedOutside'

		if self.isFreshMember(addr) and self.valueTagCarriesProvenance(func, value: value) and not self.valueGivesAStoreNoWriter(func, value: value) 'storedInside'
			self.joinFreshMember(value)
		end 'storedInside'

		return true
	end 'sweepFreshStore'

	function sweepFreshCall(func IrFunction, result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster) returns bool
		if let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) 'described'
			return self.sweepFreshDescribedCall(func, calleeIndex: calleeIndex, callee: callee, result: result, args: args, argLabels: argLabels)
		end 'described'

		return self.sweepFreshRuntimeCall(func, callee: callee, result: result, args: args)
	end 'sweepFreshCall'

	function sweepFreshDescribedCall(func IrFunction, calleeIndex ElementIndex, callee ByteArray, result ValueId, args ValueIdArray, argLabels NameRoster) returns bool
		view sig = self.calls.resolution.signatureOf(callee)
		let escapesOrBinds = self.summary.escapesAt(calleeIndex) or self.summary.bindsAt(calleeIndex)
		let letKept = self.summary.anyKeepsAt(calleeIndex)
		let shares = self.summary.sharesAt(calleeIndex)

		for i in 0 upto args.count() 'eachArg'
			let arg = try args.get(i) otherwise panic("ProvenanceTracer.sweepFreshDescribedCall: args.get OOB at {i}")

			if not self.isFreshMember(arg) 'notOfTheGraph'
				continue
			end 'notOfTheGraph'

			let label = try argLabels.get(i) otherwise panic("ProvenanceTracer.sweepFreshDescribedCall: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
			let pos = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise return false

			if maskHasParam(escapesOrBinds, param: pos) or maskHasParam(letKept, param: pos) 'keptElsewhere'
				return false
			end 'keptElsewhere'

			if not self.sweepFreshStoresAround(func, calleeIndex: calleeIndex, sig: sig, args: args, argLabels: argLabels, pos: pos) 'storedOutside'
				return false
			end 'storedOutside'

			if maskHasParam(shares, param: pos) and self.valueTagCarriesProvenance(func, value: result) and not self.valueGivesAStoreNoWriter(func, value: result) 'theResultOverlapsIt'
				self.joinFreshMember(result)
			end 'theResultOverlapsIt'
		end 'eachArg'

		return true
	end 'sweepFreshDescribedCall'

	function sweepFreshStoresAround(func IrFunction, calleeIndex ElementIndex, sig FuncSignature, args ValueIdArray, argLabels NameRoster, pos ParamCount) returns bool
		for other in 0 upto sig.paramCount() 'eachOtherParameter'
			let storedIntoOther = maskHasParam(self.summary.storesAt(calleeIndex, into: other), param: pos) or maskHasParam(self.summary.storesDeepAt(calleeIndex, into: other), param: pos)
			let storesOther = maskHasParam(self.summary.storesAt(calleeIndex, into: pos), param: other) or maskHasParam(self.summary.storesDeepAt(calleeIndex, into: pos), param: other)

			if not storedIntoOther and not storesOther 'unrelated'
				continue
			end 'unrelated'

			let counterpart = try freshArgAt(args, argLabels: argLabels, sig: sig, position: other) otherwise return not storedIntoOther

			if storedIntoOther and not self.isFreshMember(counterpart) 'storedOutside'
				return false
			end 'storedOutside'

			if storesOther and self.valueTagCarriesProvenance(func, value: counterpart) and not self.valueGivesAStoreNoWriter(func, value: counterpart) 'joinsTheGraph'
				self.joinFreshMember(counterpart)
			end 'joinsTheGraph'
		end 'eachOtherParameter'

		return true
	end 'sweepFreshStoresAround'

	function sweepFreshRuntimeCall(func IrFunction, callee ByteArray, result ValueId, args ValueIdArray) returns bool
		let shape = self.calls.resolution.runtimeShapeOf(func, callee: callee, args: args)

		if shape != RuntimeStoreShape.nothing 'storesSomewhere'
			for receiverIndex in 0 upto args.count() 'eachReceiver'
				if not shapeStoresInto(shape, receiverIndex: receiverIndex as ParamCount) 'notAReceiver'
					continue
				end 'notAReceiver'

				let receiver = try args.get(receiverIndex) otherwise panic("ProvenanceTracer.sweepFreshRuntimeCall: args.get OOB at receiver {receiverIndex}")

				for storedIndex in 0 upto args.count() 'eachStored'
					if storedIndex == receiverIndex or not shapeStoresOperand(shape, storedIndex: storedIndex as ParamCount) 'notStoredHere'
						continue
					end 'notStoredHere'

					let stored = try args.get(storedIndex) otherwise panic("ProvenanceTracer.sweepFreshRuntimeCall: args.get OOB at operand {storedIndex}")

					if self.isFreshMember(stored) and not self.isFreshMember(receiver) 'storedOutside'
						return false
					end 'storedOutside'

					if self.isFreshMember(receiver) and self.valueTagCarriesProvenance(func, value: stored) and not self.valueGivesAStoreNoWriter(func, value: stored) 'joinsTheGraph'
						self.joinFreshMember(stored)
					end 'joinsTheGraph'
				end 'eachStored'
			end 'eachReceiver'
		end 'storesSomewhere'

		return self.joinDerivedFreshValue(func, result: result)
	end 'sweepFreshRuntimeCall'

	function freshOriginHolds(func IrFunction, ir MaxonModule, value ValueId) returns bool
		if value < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return false
		end 'aParameter'

		if self.valueWasMintedSole(func, value: value) 'minted'
			return true
		end 'minted'

		let defining = try self.definingOpIndexOf(value) otherwise 'noDefiningOp'
			return self.isAMerge(value)
		end 'noDefiningOp'

		let op = try ir.ops.get(defining) otherwise panic("ProvenanceTracer.freshOriginHolds: op {defining} not in module.ops")

		return match op 'op'
			loadIndirect(_, addr, _, _) gives self.requireFreshSource(addr)
			holdValue(_, held, _, _, _) gives self.requireFreshSource(held)
			immortalStructRecord(result, _, _) gives valueTagOf(func, value: result) == ValueTypeTag.named
			call(_, callee, args, _, _, _, _, _) gives self.freshOriginOfCall(callee, args: args)
			tryCall(_, _, callee, args, _, _, _, _, _) gives self.freshOriginOfCall(callee, args: args)

			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			storeIndirect or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdEnd gives false
		end 'op'
	end 'freshOriginHolds'

	function requireFreshSource(source ValueId) returns bool
		self.requireFreshMember(source)
		return true
	end 'requireFreshSource'

	function freshOriginOfCall(callee ByteArray, args ValueIdArray) returns bool
		if let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) 'described'
			self.freshNeeds.push(calleeIndex)
			return true
		end 'described'

		if runtimeCalleeMintsARecord(callee) 'aRuntimeMint'
			return true
		end 'aRuntimeMint'

		if ownershipBookkeepingCallee(callee) and args.count() > 0 'aRetain'
			self.requireFreshMember(try args.get(0) otherwise panic("ProvenanceTracer.freshOriginOfCall: a retain has no operand"))
			return true
		end 'aRetain'

		return false
	end 'freshOriginOfCall'

	function acceptsAsSole(func IrFunction, value ValueId) returns bool
		if not self.valueIsSoleOrAParameter(func, value: value, usesFreshReturns: true) 'notSole'
			return self.valueIsSwappedOut(func, value: value)
		end 'notSole'

		return true
	end 'acceptsAsSole'

	function valueIsSwappedOut(func IrFunction, value ValueId) returns bool
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		let swapped = self.baseIsSwappedOut(func, base: self.sameRecordBase(func, ir: ir, value: value), depth: 0)
		self.indexDefinitions(func, ir: ir)
		return swapped
	end 'valueIsSwappedOut'

	function baseIsSwappedOut(func IrFunction, base ValueId, depth ElementIndex) returns bool
		if depth > MaxFreshRounds 'tooDeep'
			return false
		end 'tooDeep'

		self.indexDefinitions(func, ir: self.module)
		let defining = try self.definingOpIndexOf(base) otherwise return false
		view op = try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.baseIsSwappedOut: op {defining} not in module.ops")

		if let callee = try freshCalleeOf(op) 'aCall'
			return self.callResultIsSwappedOut(callee, depth: depth)
		end 'aCall'

		if not opLoadsOrStoresASlot(op) 'notASlotRead'
			return false
		end 'notASlotRead'

		match slotReadOfOp(op, opIndex: defining) 'read'
			load(loadOp, addr, offset) then return self.loadedRecordIsOwned(func, loadOp: loadOp, result: base, addr: addr, offset: offset, depth: depth)

			none or
			store or
			retainOf then return false
		end 'read'
	end 'baseIsSwappedOut'

	function callResultIsSwappedOut(callee ByteArray, depth ElementIndex) returns bool
		let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) otherwise return false

		if let known = try self.swappedOutReturns.get(calleeIndex) 'asked'
			return known
		end 'asked'

		self.swappedOutReturns.upsert(calleeIndex, value: false)
		let verdict = self.functionReturnsOnlySwappedOutRecords(self.functionAt(calleeIndex), depth: depth + 1)
		self.swappedOutReturns.upsert(calleeIndex, value: verdict)
		return verdict
	end 'callResultIsSwappedOut'

	function functionReturnsOnlySwappedOutRecords(func IrFunction, depth ElementIndex) returns bool
		view ir = self.module
		var returnsARecord = false

		for blockRef in func.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.functionReturnsOnlySwappedOutRecords: blockRef from func.blockRefs not in module.blocks")

			if not block.hasTerminatorOp() 'unterminated'
				continue
			end 'unterminated'

			let returned = try returnedValueOf(try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.functionReturnsOnlySwappedOutRecords: terminatorIndex not in module.ops")) otherwise continue

			if not self.valueTagCarriesProvenance(func, value: returned) 'aScalar'
				continue
			end 'aScalar'

			returnsARecord = true
			self.indexDefinitions(func, ir: ir)
			let base = self.sameRecordBase(func, ir: ir, value: returned)

			if not self.baseIsSwappedOut(func, base: base, depth: depth) 'notSwappedOut'
				return false
			end 'notSwappedOut'
		end 'eachBlock'

		return returnsARecord
	end 'functionReturnsOnlySwappedOutRecords'

	function loadedRecordIsOwned(func IrFunction, loadOp ElementIndex, result ValueId, addr ValueId, offset ByteOffset, depth ElementIndex) returns bool
		if not self.valueTagCarriesProvenance(func, value: result) 'holdsNoRecord'
			return false
		end 'holdsNoRecord'

		let key = try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return false
		let moves = self.loadMovesOutOfAnOwner(func, loadOp: loadOp, result: result, addr: addr, key: key, depth: depth + 1)
		return moves and self.slotIsExclusive(key)
	end 'loadedRecordIsOwned'

	function loadMovesOutOfAnOwner(func IrFunction, loadOp ElementIndex, result ValueId, addr ValueId, key StoreSlotKey, depth ElementIndex) returns bool
		if self.loadIsSwappedOut(func, loadOp: loadOp, result: result, addr: addr, key: key) 'swappedOut'
			return true
		end 'swappedOut'

		return self.ownerRecordIsOwned(func, ownerBase: self.sameRecordBase(func, ir: self.module, value: addr), depth: depth) and self.ownerIsDeadAfterTheLoad(func, loadOp: loadOp, addr: addr, key: key)
	end 'loadMovesOutOfAnOwner'

	function ownerIsDeadAfterTheLoad(func IrFunction, loadOp ElementIndex, addr ValueId, key StoreSlotKey) returns bool
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		let ownerBase = self.sameRecordBase(func, ir: ir, value: addr)
		let mint = try self.definingOpIndexOf(ownerBase) otherwise return false
		return self.ownerIsUntouchedFrom(func, byId: ir.blockIndexById(func), loadOp: loadOp, mint: mint, ownerBase: ownerBase, key: key)
	end 'ownerIsDeadAfterTheLoad'

	function ownerIsUntouchedFrom(func IrFunction, byId BlockIndexById, loadOp ElementIndex, mint ElementIndex, ownerBase ValueId, key StoreSlotKey) returns bool
		view ir = self.module
		var worklist = BlockIdArray.create()
		var visited = BoolArray.create()
		visited.refill(func.nextBlockId, value: false)

		for blockRef in func.blockRefs 'findTheLoad'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: blockRef from func.blockRefs not in module.blocks")

			for at in 0 upto block.bodyOpCount() 'eachOp'
				if (try block.bodyOpAt(at) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: bodyOpAt OOB at {at}")) != loadOp 'anotherOp'
					continue
				end 'anotherOp'

				match self.scanOwnerBlock(func, block: block, from: (at + 1) as ElementIndex, mint: mint, ownerBase: ownerBase, key: key) 'tail'
					touched then return false
					remintsTheOwner then return true
					untouched then collectMaxonBlockSuccessors(ir, block: block, into: worklist)
				end 'tail'

				break 'findTheLoad'
			end 'eachOp'
		end 'findTheLoad'

		var head = 0 as ElementIndex

		while head < worklist.count() 'eachBlock'
			let blockId = try worklist.get(head) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: worklist.get OOB at {head}")
			head = head + 1

			let seen = try visited.get(blockId) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: block {blockId} is past the function's {func.nextBlockId} block ids")

			if seen 'alreadyScanned'
				continue
			end 'alreadyScanned'

			try visited.set(blockId, value: true) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: visited.set OOB at block {blockId}")
			let position = try byId.get(blockId) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: successor {blockId} is not a block of '{String.from(func.name)}'")
			let blockRef = try func.blockRefs.get(position) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: blockIndexById placed a block at {position}, past func.blockRefs")
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.ownerIsUntouchedFrom: blockRef {blockRef} not in module.blocks")

			match self.scanOwnerBlock(func, block: block, from: 0, mint: mint, ownerBase: ownerBase, key: key) 'body'
				touched then return false
				remintsTheOwner then continue
				untouched then collectMaxonBlockSuccessors(ir, block: block, into: worklist)
			end 'body'
		end 'eachBlock'

		return true
	end 'ownerIsUntouchedFrom'

	function scanOwnerBlock(func IrFunction, block IrBlock, from ElementIndex, mint ElementIndex, ownerBase ValueId, key StoreSlotKey) returns OwnerBlockScan
		view ir = self.module

		for at in from upto block.bodyOpCount() 'eachOp'
			let opIdx = try block.bodyOpAt(at) otherwise panic("ProvenanceTracer.scanOwnerBlock: bodyOpAt OOB at {at}")

			if opIdx == mint 'theOwnerIsMintedAgain'
				return OwnerBlockScan.remintsTheOwner
			end 'theOwnerIsMintedAgain'

			if self.opTouchesTheOwner(func, op: try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.scanOwnerBlock: opIdx {opIdx} not in module.ops"), opIdx: opIdx, ownerBase: ownerBase, key: key) 'theOwnerIsUsed'
				return OwnerBlockScan.touched
			end 'theOwnerIsUsed'
		end 'eachOp'

		if block.hasTerminatorOp() and self.opTouchesTheOwner(func, op: try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.scanOwnerBlock: terminatorIndex not in module.ops"), opIdx: block.terminatorIndex(), ownerBase: ownerBase, key: key) 'theOwnerIsReturnedOrBranchedOn'
			return OwnerBlockScan.touched
		end 'theOwnerIsReturnedOrBranchedOn'

		for edge in block.branchEdges 'eachEdge'
			for argument in edge.argIds 'eachArgument'
				if self.sameRecordBase(func, ir: ir, value: argument) == ownerBase 'theOwnerIsCarriedOn'
					return OwnerBlockScan.touched
				end 'theOwnerIsCarriedOn'
			end 'eachArgument'
		end 'eachEdge'

		return OwnerBlockScan.untouched
	end 'scanOwnerBlock'

	function opTouchesTheOwner(func IrFunction, op MaxonOp, opIdx ElementIndex, ownerBase ValueId, key StoreSlotKey) returns bool
		match slotReadOfOp(op, opIndex: opIdx) 'access'
			load(_, addr, offset) then return self.sameRecordBase(func, ir: self.module, value: addr) == ownerBase and self.accessIsOfSlot(func, addr: addr, offset: offset, key: key)

			store(addr, offset, value) then return self.sameRecordBase(func, ir: self.module, value: value) == ownerBase or (self.sameRecordBase(func, ir: self.module, value: addr) == ownerBase and self.accessIsOfSlot(func, addr: addr, offset: offset, key: key) and not self.storedValueIsFreshAndUnshared(func, value: value))

			none or
			retainOf then break
		end 'access'

		return self.operandsNameTheOwner(func, op: op, ownerBase: ownerBase)
	end 'opTouchesTheOwner'

	function accessIsOfSlot(func IrFunction, addr ValueId, offset ByteOffset, key StoreSlotKey) returns bool
		return (try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return true) == key
	end 'accessIsOfSlot'

	function operandsNameTheOwner(func IrFunction, op MaxonOp, ownerBase ValueId) returns bool
		let use = self.operandUseOf(op)

		if use == OperandUse.placesNone 'releasesOrEndsAHold'
			return false
		end 'releasesOrEndsAHold'

		maxonOpOperandValues(op, into: self.swapOperands)

		for operand in self.swapOperands 'eachOperand'
			if self.sameRecordBase(func, ir: self.module, value: operand) == ownerBase 'itNamesTheOwner'
				return true
			end 'itNamesTheOwner'
		end 'eachOperand'

		return false
	end 'operandsNameTheOwner'

	function ownerRecordIsOwned(func IrFunction, ownerBase ValueId, depth ElementIndex) returns bool
		self.indexDefinitions(func, ir: self.module)

		if ownerBase < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return false
		end 'aParameter'

		let varsOwn = self.varsOwnValues(func)
		let isAVarsRecord = try varsOwn.get(ownerBase) otherwise true

		if isAVarsRecord 'aVarsRecord'
			return false
		end 'aVarsRecord'

		return self.recordIsMintedHere(func, base: ownerBase, usesFreshReturns: true) or self.baseIsSwappedOut(func, base: ownerBase, depth: depth)
	end 'ownerRecordIsOwned'

	function varsOwnValues(func IrFunction) returns BoolArray
		var varsOwn = BoolArray.create()
		varsOwn.refill(func.valueTags.count(), value: false)
		ProvenanceTracer.markVarsOwn(func, sites: func.provenanceSites(self.noSites), into: varsOwn)
		return varsOwn
	end 'varsOwnValues'

	function loadIsSwappedOut(func IrFunction, loadOp ElementIndex, result ValueId, addr ValueId, key StoreSlotKey) returns bool
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		let ownerBase = self.sameRecordBase(func, ir: ir, value: addr)
		view ownerKind = try self.heldRecordKindOf(func, value: ownerBase) otherwise return false
		var aliases = BoolArray.create()
		aliases.refill(func.valueTags.count(), value: false)
		self.addAlias(aliases, value: result)

		for blockRef in func.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.loadIsSwappedOut: blockRef from func.blockRefs not in module.blocks")
			var inWindow = false

			for opIdx in block.bodyOps() 'eachOp'
				if opIdx == loadOp 'theLoad'
					inWindow = true
					continue
				end 'theLoad'

				if not inWindow 'beforeTheLoad'
					continue
				end 'beforeTheLoad'

				view stepOp = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.loadIsSwappedOut: opIdx {opIdx} not in module.ops")
				let stepResult = self.windowStepOf(func, op: stepOp, ownerBase: ownerBase, ownerKind: ownerKind, key: key, aliases: aliases)

				match stepResult 'step'
					passes then continue
					swapsOut then return true
					touches then return false
				end 'step'
			end 'eachOp'

			if inWindow 'endedBeforeAStore'
				return false
			end 'endedBeforeAStore'
		end 'eachBlock'

		return false
	end 'loadIsSwappedOut'

	function windowStepOf(func IrFunction, op MaxonOp, ownerBase ValueId, ownerKind ByteArray, key StoreSlotKey, aliases BoolArray) returns WindowStep
		match op 'op'
			loadIndirect(result, addr, offset, _) then return self.windowLoadStep(func, result: result, addr: addr, offset: offset, key: key, aliases: aliases)
			storeIndirect(addr, offset, value, _) then return self.windowStoreStep(func, addr: addr, offset: offset, value: value, ownerBase: ownerBase, key: key, aliases: aliases)
			holdValue(result, held, _, _, _) then return self.windowHoldStep(func, op: op, result: result, held: held, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases)
			call(result, callee, args, _, _, _, _, _) then return self.windowCallStep(func, op: op, result: result, callee: callee, args: args, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases)
			tryCall(result, _, callee, args, _, _, _, _, _) then return self.windowCallStep(func, op: op, result: result, callee: callee, args: args, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases)
			holdEnd then return self.windowOperandsStep(func, op: op, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases, reachesModuleVars: false)

			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness then return self.windowOperandsStep(func, op: op, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases, reachesModuleVars: true)
		end 'op'
	end 'windowStepOf'

	function windowLoadStep(func IrFunction, result ValueId, addr ValueId, offset ByteOffset, key StoreSlotKey, aliases BoolArray) returns WindowStep
		if self.isAliasBase(func, aliases: aliases, value: addr) 'readsTheRecord'
			return WindowStep.touches
		end 'readsTheRecord'

		let slot = try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return WindowStep.passes

		if slot != key or not self.valueTagCarriesProvenance(func, value: result) or self.recordUseOf(func, root: result) == RecordUse.dropped 'unrelatedOrDropped'
			return WindowStep.passes
		end 'unrelatedOrDropped'

		return WindowStep.touches
	end 'windowLoadStep'

	function windowStoreStep(func IrFunction, addr ValueId, offset ByteOffset, value ValueId, ownerBase ValueId, key StoreSlotKey, aliases BoolArray) returns WindowStep
		if self.isAliasBase(func, aliases: aliases, value: value) or self.isAliasBase(func, aliases: aliases, value: addr) 'movesOrWritesTheRecord'
			return WindowStep.touches
		end 'movesOrWritesTheRecord'

		let slot = try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return WindowStep.passes

		if slot != key 'anotherSlot'
			return WindowStep.passes
		end 'anotherSlot'

		if self.sameRecordBase(func, ir: self.module, value: addr) == ownerBase and self.storedValueIsFreshAndUnshared(func, value: value) 'theReplacement'
			return WindowStep.swapsOut
		end 'theReplacement'

		return WindowStep.touches
	end 'windowStoreStep'

	function windowHoldStep(func IrFunction, op MaxonOp, result ValueId, held ValueId, ownerBase ValueId, ownerKind ByteArray, aliases BoolArray) returns WindowStep
		if self.isAliasBase(func, aliases: aliases, value: held) 'holdsTheRecord'
			self.addAlias(aliases, value: result)
			return WindowStep.passes
		end 'holdsTheRecord'

		return self.windowOperandsStep(func, op: op, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases, reachesModuleVars: false)
	end 'windowHoldStep'

	function windowCallStep(func IrFunction, op MaxonOp, result ValueId, callee ByteArray, args ValueIdArray, ownerBase ValueId, ownerKind ByteArray, aliases BoolArray) returns WindowStep
		if droppingBookkeepingCallee(callee) 'aRelease'
			return WindowStep.passes
		end 'aRelease'

		if ownershipBookkeepingCallee(callee) and not copyingBookkeepingCallee(callee) and args.count() > 0 and self.isAliasBase(func, aliases: aliases, value: try args.get(0) otherwise panic("ProvenanceTracer.windowCallStep: args.get(0) on a non-empty list")) 'retainsTheRecord'
			self.addAlias(aliases, value: result)
			return WindowStep.passes
		end 'retainsTheRecord'

		return self.windowOperandsStep(func, op: op, ownerBase: ownerBase, ownerKind: ownerKind, aliases: aliases, reachesModuleVars: not ownershipBookkeepingCallee(callee))
	end 'windowCallStep'

	function windowOperandsStep(func IrFunction, op MaxonOp, ownerBase ValueId, ownerKind ByteArray, aliases BoolArray, reachesModuleVars bool) returns WindowStep
		maxonOpOperandValues(op, into: self.swapOperands)

		for operand in self.swapOperands 'eachOperand'
			if not self.valueTagCarriesProvenance(func, value: operand) 'notARecord'
				continue
			end 'notARecord'

			if self.isAliasBase(func, aliases: aliases, value: operand) or self.sameRecordBase(func, ir: self.module, value: operand) == ownerBase 'namesTheRecordOrItsOwner'
				return WindowStep.touches
			end 'namesTheRecordOrItsOwner'

			view kind = try self.heldRecordKindOf(func, value: operand) otherwise return WindowStep.touches

			if kind.equals(ownerKind) or self.recordKindsWithinValue(func, value: operand).mayHold(ownerKind) 'mayReachTheOwner'
				return WindowStep.touches
			end 'mayReachTheOwner'
		end 'eachOperand'

		if reachesModuleVars and self.moduleVarKinds.mayHold(ownerKind) 'ownerMayLiveInAModuleVar'
			return WindowStep.touches
		end 'ownerMayLiveInAModuleVar'

		return WindowStep.passes
	end 'windowOperandsStep'

	function isAlias(aliases BoolArray, value ValueId) returns bool
		return value < aliases.count() and (try aliases.get(value) otherwise false)
	end 'isAlias'

	function isAliasBase(func IrFunction, aliases BoolArray, value ValueId) returns bool
		return self.isAlias(aliases, value: self.sameRecordBase(func, ir: self.module, value: value))
	end 'isAliasBase'

	function addAlias(aliases BoolArray, value ValueId)
		if value < aliases.count() and not (try aliases.get(value) otherwise true) 'aNewAlias'
			try aliases.set(value, value: true) otherwise panic("ProvenanceTracer.addAlias: aliases.set OOB at v{value}")
			self.aliasesGrew = true
		end 'aNewAlias'
	end 'addAlias'

	function storedValueIsFreshAndUnshared(func IrFunction, value ValueId) returns bool
		view ir = self.module
		self.indexDefinitions(func, ir: ir)

		if self.valueReadsAnInertModuleLet(func, value: value) or self.baseIsAnImageRecord(self.sameRecordBase(func, ir: ir, value: value)) 'nothingToShare'
			return true
		end 'nothingToShare'

		var current = value

		for _ in 0 upto MaxAccessPathSteps 'eachHop'
			if not self.valueIsUsedOnce(func, value: current) 'usedAgain'
				return false
			end 'usedAgain'

			let next = self.sameRecordStep(func, ir: ir, value: current)

			if next == current 'itsBase'
				return current >= valueIdAtParamPosition(func.paramCount) and self.recordIsMintedHere(func, base: current, usesFreshReturns: true)
			end 'itsBase'

			current = next
		end 'eachHop'

		return false
	end 'storedValueIsFreshAndUnshared'

	function baseIsAnImageRecord(base ValueId) returns bool
		let defining = try self.definingOpIndexOf(base) otherwise return false
		return opProducesAnImage(try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.baseIsAnImageRecord: op {defining} not in module.ops"))
	end 'baseIsAnImageRecord'

	// A slot key is a declared type and a field offset, not one record, so the slot is exclusive only
	// when that field of every record of the type, anywhere in the program, is filled only with fresh
	// unshared records and every read that keeps what it read moves it out of its owner. One
	// record-holding access through an address no key names makes every slot shared.
	function slotIsExclusive(key StoreSlotKey) returns bool
		if let known = try self.slotExclusivity.get(key) 'asked'
			return known == SlotExclusivity.exclusive
		end 'asked'

		self.slotExclusivity.upsert(key, value: SlotExclusivity.pending)
		let verdict = SlotExclusivity.exclusive if self.everyAccessKeepsSlotExclusive(key) else SlotExclusivity.shared
		self.slotExclusivity.upsert(key, value: verdict)
		return verdict == SlotExclusivity.exclusive
	end 'slotIsExclusive'

	function indexSlotAccesses()
		view ir = self.module
		self.slotAccessesIndexed = true

		for index in 0 upto ir.functions.count() 'eachFunction'
			view func = self.functionAt(index)

			if bodyIsUnreadable(func) 'nothingToRead'
				continue
			end 'nothingToRead'

			for blockRef in func.blockRefs 'eachBlock'
				view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.indexSlotAccesses: blockRef from func.blockRefs not in module.blocks")

				for opIdx in block.bodyOps() 'eachOp'
					self.indexSlotAccess(func, functionIndex: index, opIdx: opIdx)
				end 'eachOp'
			end 'eachBlock'
		end 'eachFunction'
	end 'indexSlotAccesses'

	function indexSlotAccess(func IrFunction, functionIndex ElementIndex, opIdx ElementIndex)
		view op = try self.module.ops.get(opIdx) otherwise panic("ProvenanceTracer.indexSlotAccess: opIdx {opIdx} not in module.ops")

		if not opLoadsOrStoresASlot(op) 'neitherLoadsNorStores'
			return
		end 'neitherLoadsNorStores'

		let key = try self.slotKeyOfAccess(func, op: op, opIdx: opIdx) otherwise 'unkeyed'
			self.noteUnkeyedSlotAccess(func, op: op, opIdx: opIdx)
			return
		end 'unkeyed'

		let head = try self.slotAccessHeads.get(key) otherwise NoSlotAccess
		let position = self.slotAccessPacked.count() as StoreSlotKey
		self.slotAccessPacked.push((functionIndex as StoreSlotKey shl SlotAccessFunctionShift) or (opIdx as StoreSlotKey))
		self.slotAccessNext.push(head)
		self.slotAccessHeads.upsert(key, value: position)
	end 'indexSlotAccess'

	function noteUnkeyedSlotAccess(func IrFunction, op MaxonOp, opIdx ElementIndex)
		match slotReadOfOp(op, opIndex: opIdx) 'access'
			load(_, addr, _) then self.noteUnkeyedSlotAccessOf(func, addr: addr, value: loadResultOf(op))
			store(addr, _, value) then self.noteUnkeyedSlotAccessOf(func, addr: addr, value: value)

			none or
			retainOf then panic("ProvenanceTracer.noteUnkeyedSlotAccess: op {opIdx} was handed here as a slot access and is not one")
		end 'access'
	end 'noteUnkeyedSlotAccess'

	function noteUnkeyedSlotAccessOf(func IrFunction, addr ValueId, value ValueId)
		if tagIsKnownNotToAddressADeclaredRecord(valueTagOf(func, value: addr)) or not self.valueTagCarriesProvenance(func, value: value) 'harmless'
			return
		end 'harmless'

		self.slotAccessedThroughAnUnkeyedAddress = true
	end 'noteUnkeyedSlotAccessOf'

	function slotKeyOfAccess(func IrFunction, op MaxonOp, opIdx ElementIndex) returns StoreSlotKey throws AbsentError
		match slotReadOfOp(op, opIndex: opIdx) 'access'
			load(_, addr, offset) then return try self.declaredSlotKeyOf(func, addr: addr, offset: offset)
			store(addr, offset, _) then return try self.declaredSlotKeyOf(func, addr: addr, offset: offset)

			none or
			retainOf then throw AbsentError.absent
		end 'access'
	end 'slotKeyOfAccess'

	function everyAccessKeepsSlotExclusive(key StoreSlotKey) returns bool
		if not self.slotAccessesIndexed 'notIndexedYet'
			self.indexSlotAccesses()
		end 'notIndexedYet'

		if self.slotAccessedThroughAnUnkeyedAddress 'someAccessNamesNoSlot'
			return false
		end 'someAccessNamesNoSlot'

		var position = try self.slotAccessHeads.get(key) otherwise return true

		while position != NoSlotAccess 'eachAccess'
			let packed = try self.slotAccessPacked.get(position) otherwise panic("ProvenanceTracer.everyAccessKeepsSlotExclusive: slotAccessPacked.get OOB at {position}")
			view func = self.functionAt((packed shr SlotAccessFunctionShift) as ElementIndex)
			self.indexDefinitions(func, ir: self.module)

			if not self.accessKeepsSlotExclusive(func, opIdx: packed and SlotAccessOpMask, key: key) 'aLeakingAccess'
				return false
			end 'aLeakingAccess'

			position = try self.slotAccessNext.get(position) otherwise panic("ProvenanceTracer.everyAccessKeepsSlotExclusive: slotAccessNext.get OOB at {position}")
		end 'eachAccess'

		return true
	end 'everyAccessKeepsSlotExclusive'

	function accessKeepsSlotExclusive(func IrFunction, opIdx ElementIndex, key StoreSlotKey) returns bool
		view op = try self.module.ops.get(opIdx) otherwise panic("ProvenanceTracer.accessKeepsSlotExclusive: opIdx {opIdx} not in module.ops")

		return match slotReadOfOp(op, opIndex: opIdx) 'access'
			load(loadOp, addr, offset) gives self.loadKeepsSlotExclusive(func, op: op, loadOp: loadOp, addr: addr, offset: offset, key: key)
			store(addr, offset, value) gives self.storeKeepsSlotExclusive(func, addr: addr, offset: offset, value: value, key: key)

			none or
			retainOf panic("ProvenanceTracer.accessKeepsSlotExclusive: op {opIdx} was indexed as a slot access and is not one")
		end 'access'
	end 'accessKeepsSlotExclusive'

	function loadKeepsSlotExclusive(func IrFunction, op MaxonOp, loadOp ElementIndex, addr ValueId, offset ByteOffset, key StoreSlotKey) returns bool
		let slot = try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return true

		if slot != key 'anotherSlot'
			return true
		end 'anotherSlot'

		let result = loadResultOf(op)

		if not self.valueTagCarriesProvenance(func, value: result) or self.recordUseOf(func, root: result) != RecordUse.kept 'neverKept'
			return true
		end 'neverKept'

		return self.loadMovesOutOfAnOwner(func, loadOp: loadOp, result: result, addr: addr, key: key, depth: 1)
	end 'loadKeepsSlotExclusive'

	function storeKeepsSlotExclusive(func IrFunction, addr ValueId, offset ByteOffset, value ValueId, key StoreSlotKey) returns bool
		let slot = try self.declaredSlotKeyOf(func, addr: addr, offset: offset) otherwise return true
		return slot != key or not self.valueTagCarriesProvenance(func, value: value) or self.storedValueIsFreshAndUnshared(func, value: value)
	end 'storeKeepsSlotExclusive'

	function recordUseOf(func IrFunction, root ValueId) returns RecordUse
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		var aliases = BoolArray.create()
		aliases.refill(func.valueTags.count(), value: false)
		self.addAlias(aliases, value: root)
		var worst = RecordUse.dropped
		self.aliasesGrew = true

		while self.aliasesGrew 'untilNoNewAlias'
			self.aliasesGrew = false

			for blockRef in func.blockRefs 'eachBlock'
				view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.recordUseOf: blockRef from func.blockRefs not in module.blocks")

				for opIdx in block.bodyOps() 'eachOp'
					worst = worseRecordUse(worst, next: self.useOfAliasIn(func, op: try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.recordUseOf: opIdx {opIdx} not in module.ops"), aliases: aliases))
				end 'eachOp'

				if block.hasTerminatorOp() 'terminated'
					worst = worseRecordUse(worst, next: self.useOfAliasIn(func, op: try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.recordUseOf: terminatorIndex not in module.ops"), aliases: aliases))
				end 'terminated'

				for edge in block.branchEdges 'eachEdge'
					for argument in edge.argIds 'eachArgument'
						if self.isAlias(aliases, value: argument) 'handedToAMerge'
							worst = RecordUse.kept
						end 'handedToAMerge'
					end 'eachArgument'
				end 'eachEdge'
			end 'eachBlock'
		end 'untilNoNewAlias'

		return worst
	end 'recordUseOf'

	function useOfAliasIn(func IrFunction, op MaxonOp, aliases BoolArray) returns RecordUse
		match op 'op'
			loadIndirect(_, addr, _, _) then return RecordUse.readOnly if self.isAlias(aliases, value: addr) else RecordUse.dropped
			storeIndirect(addr, _, value, _) then return RecordUse.kept if self.isAlias(aliases, value: value) else (RecordUse.readOnly if self.isAlias(aliases, value: addr) else RecordUse.dropped)
			holdValue(result, held, _, _, _) then return self.holdUse(result, held: held, aliases: aliases)
			call(result, callee, args, argLabels, _, _, _, _) then return self.callUse(func, result: result, callee: callee, args: args, argLabels: argLabels, aliases: aliases)
			tryCall(result, _, callee, args, argLabels, _, _, _, _) then return self.callUse(func, result: result, callee: callee, args: args, argLabels: argLabels, aliases: aliases)
			holdEnd then return RecordUse.dropped

			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness then return self.operandsUse(op, aliases: aliases)
		end 'op'
	end 'useOfAliasIn'

	function operandsUse(op MaxonOp, aliases BoolArray) returns RecordUse
		maxonOpOperandValues(op, into: self.swapOperands)

		for operand in self.swapOperands 'eachOperand'
			if self.isAlias(aliases, value: operand) 'handedOn'
				return RecordUse.kept
			end 'handedOn'
		end 'eachOperand'

		return RecordUse.dropped
	end 'operandsUse'

	function holdUse(result ValueId, held ValueId, aliases BoolArray) returns RecordUse
		if self.isAlias(aliases, value: held) 'holdsTheRecord'
			self.addAlias(aliases, value: result)
		end 'holdsTheRecord'

		return RecordUse.dropped
	end 'holdUse'

	function callUse(func IrFunction, result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, aliases BoolArray) returns RecordUse
		var use = RecordUse.dropped

		for index in 0 upto args.count() 'eachArgument'
			if not self.isAlias(aliases, value: try args.get(index) otherwise panic("ProvenanceTracer.callUse: args.get OOB at {index}")) 'notTheRecord'
				continue
			end 'notTheRecord'

			use = worseRecordUse(use, next: self.argumentUse(func, result: result, callee: callee, args: args, argLabels: argLabels, index: index, aliases: aliases))
		end 'eachArgument'

		return use
	end 'callUse'

	function argumentUse(func IrFunction, result ValueId, callee ByteArray, args ValueIdArray, argLabels NameRoster, index ElementIndex, aliases BoolArray) returns RecordUse
		if ownershipBookkeepingCallee(callee) 'bookkeeping'
			if not droppingBookkeepingCallee(callee) and not copyingBookkeepingCallee(callee) 'handsTheRecordBack'
				self.addAlias(aliases, value: result)
			end 'handsTheRecordBack'

			return RecordUse.dropped
		end 'bookkeeping'

		if let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) 'summarized'
			return self.summarizedArgumentUse(calleeIndex, callee: callee, argLabels: argLabels, index: index)
		end 'summarized'

		return self.runtimeArgumentUse(func, result: result, callee: callee, args: args, index: index)
	end 'argumentUse'

	function summarizedArgumentUse(calleeIndex ElementIndex, callee ByteArray, argLabels NameRoster, index ElementIndex) returns RecordUse
		let sig = try self.project.funcSignatures.get(callee) otherwise return RecordUse.kept
		let label = try argLabels.get(index) otherwise return RecordUse.kept
		let position = try argSlotPosition(sig.paramNames, argIndex: index as ParamCount, label: label) otherwise return RecordUse.kept
		var leaked = self.keptParameters(calleeIndex, paramCount: sig.paramCount())
		leaked = leaked or self.summary.sharesAt(calleeIndex) or self.summary.identityAt(calleeIndex) or self.summary.holdsAt(calleeIndex) or self.summary.insideAt(calleeIndex) or self.summary.holdsWithinAt(calleeIndex) or self.summary.placedWithinAt(calleeIndex) or self.summary.anyKeepsAt(calleeIndex)
		return RecordUse.kept if maskHasParam(leaked, param: position) else RecordUse.readOnly
	end 'summarizedArgumentUse'

	function runtimeArgumentUse(func IrFunction, result ValueId, callee ByteArray, args ValueIdArray, index ElementIndex) returns RecordUse
		let shape = self.calls.resolution.runtimeShapeOf(func, callee: callee, args: args)
		let operand = try args.get(index) otherwise panic("ProvenanceTracer.runtimeArgumentUse: args.get OOB at {index}")
		let storesOnlyScalars = shape == RuntimeStoreShape.theSourcesElementsIntoTheReceiver and not self.calls.resolution.mayHoldARecord(func, value: operand)

		for receiver in 0 upto args.count() 'eachReceiver'
			if receiver != index and not storesOnlyScalars and shapeStoresInto(shape, receiverIndex: receiver as ParamCount) and shapeStoresOperand(shape, storedIndex: index as ParamCount) 'storedAway'
				return RecordUse.kept
			end 'storedAway'
		end 'eachReceiver'

		if self.valueTagCarriesProvenance(func, value: result) and not containerReadCallee(callee) and mayBeOneRecord(valueTagOf(func, value: result), other: valueTagOf(func, value: operand)) 'mayHandItBack'
			return RecordUse.kept
		end 'mayHandItBack'

		return RecordUse.readOnly
	end 'runtimeArgumentUse'

	function valueIsSoleOrAParameter(func IrFunction, value ValueId, usesFreshReturns bool) returns bool
		return self.recordIsSoleOrAParameter(func, base: self.sameRecordBase(func, ir: self.module, value: value), depth: 0, usesFreshReturns: usesFreshReturns)
	end 'valueIsSoleOrAParameter'

	function recordIsSoleOrAParameter(func IrFunction, base ValueId, depth ElementIndex, usesFreshReturns bool) returns bool
		if base < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return true
		end 'aParameter'

		if self.isAMerge(base) and not self.valueWasMintedSole(func, value: base) 'aMerge'
			return self.mergeMeetsClaim(func, phi: base, depth: depth, claim: RecordClaim.soleByFreshReturn if usesFreshReturns else RecordClaim.soleByToken)
		end 'aMerge'

		return self.recordIsMintedHere(func, base: base, usesFreshReturns: usesFreshReturns)
	end 'recordIsSoleOrAParameter'

	function recordIsMintedHere(func IrFunction, base ValueId, usesFreshReturns bool) returns bool
		if self.valueWasMintedSole(func, value: base) 'minted'
			return true
		end 'minted'

		let defining = try self.definingOpIndexOf(base) otherwise return false
		let op = try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.recordIsMintedHere: op {defining} not in module.ops")

		if opProducesAnImage(op) 'neverWritten'
			return true
		end 'neverWritten'

		let callee = try freshCalleeOf(op) otherwise return false
		return (usesFreshReturns and self.calleeReturnsFresh(callee)) or runtimeCalleeMintsARecord(callee)
	end 'recordIsMintedHere'

	function recordMeetsClaim(func IrFunction, base ValueId, depth ElementIndex, claim RecordClaim) returns bool
		return match claim 'claim'
			soleByToken gives self.recordIsSoleOrAParameter(func, base: base, depth: depth, usesFreshReturns: false)
			soleByFreshReturn gives self.recordIsSoleOrAParameter(func, base: base, depth: depth, usesFreshReturns: true)
			permanent gives self.recordIsPermanentlyReadOnly(func, base: base, depth: depth, allowFresh: false)
			permanentOrFresh gives self.recordIsPermanentlyReadOnly(func, base: base, depth: depth, allowFresh: true)
			inertModuleLet gives self.recordReadsAnInertModuleLet(func, base: base, depth: depth)
		end 'claim'
	end 'recordMeetsClaim'

	function reachingIncomingOf(func IrFunction, merge ValueId) returns ValueId
		self.indexDefinitions(func, ir: self.module)

		if not self.incomingsAreKnown(merge) 'notAWhollyKnownMerge'
			return merge
		end 'notAWhollyKnownMerge'

		for k in 0 upto self.incomingCountOf(merge) 'eachIncoming'
			let value = self.incomingAt(merge, k: k)

			if not incomingIsTheMerge(merge, incoming: value, incomingBase: self.sameRecordBase(func, ir: self.module, value: value)) and self.firstRootName(func, value: value, reach: RootReach.identityOrInside).isBlamed() 'reachesAName'
				return value
			end 'reachesAName'
		end 'eachIncoming'

		return merge
	end 'reachingIncomingOf'

	function mergeMeetsClaim(func IrFunction, phi ValueId, depth ElementIndex, claim RecordClaim) returns bool
		if depth > MaxFreshRounds 'tooDeep'
			return false
		end 'tooDeep'

		self.indexDefinitions(func, ir: self.module)

		if not self.incomingsAreKnown(phi) 'notAWhollyKnownMerge'
			return false
		end 'notAWhollyKnownMerge'

		var sawAnIncoming = false

		for k in 0 upto self.incomingCountOf(phi) 'eachIncoming'
			let incoming = self.incomingAt(phi, k: k)
			let incomingBase = self.sameRecordBase(func, ir: self.module, value: incoming)

			if incomingIsTheMerge(phi, incoming: incoming, incomingBase: incomingBase) 'itself'
				continue
			end 'itself'

			sawAnIncoming = true

			if not self.recordMeetsClaim(func, base: incomingBase, depth: depth + 1, claim: claim) 'notSole'
				return false
			end 'notSole'
		end 'eachIncoming'

		return sawAnIncoming
	end 'mergeMeetsClaim'

	function recordIsPermanentlyReadOnly(func IrFunction, base ValueId, depth ElementIndex, allowFresh bool) returns bool
		if depth > MaxFreshRounds 'tooDeep'
			return false
		end 'tooDeep'

		if base < valueIdAtParamPosition(func.paramCount) 'aParameter'
			return self.parameterIsPermanentGivenItsArgument(base)
		end 'aParameter'

		if self.valueWasMintedSole(func, value: base) 'minted'
			return allowFresh
		end 'minted'

		if self.isAMerge(base) 'aMerge'
			return self.mergeMeetsClaim(func, phi: base, depth: depth, claim: RecordClaim.permanentOrFresh if allowFresh else RecordClaim.permanent)
		end 'aMerge'

		let defining = try self.definingOpIndexOf(base) otherwise return false
		view op = try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.recordIsPermanentlyReadOnly: op {defining} not in module.ops")

		if opProducesAnImage(op) or (maxonOpNamesAGlobalLabel(op) and self.immutableGlobalLabels.contains(maxonOpGlobalLabelName(op))) 'neverWritten'
			return true
		end 'neverWritten'

		match slotReadOfOp(op, opIndex: defining) 'read'
			load(_, addr, offset) then return self.slotHoldsAPermanentRecord(func, addr: addr, offset: offset, held: base, depth: depth)
			none then break
			store or
			retainOf then return false
		end 'read'

		view callee = try freshCalleeOf(op) otherwise return false
		return self.callResultIsPermanentlyReadOnly(func, op: op, callee: callee, depth: depth, allowFresh: allowFresh)
	end 'recordIsPermanentlyReadOnly'

	function parameterIsPermanentGivenItsArgument(param ValueId) returns bool
		if not self.settlingGivenArguments() 'aDoorJudgesItsCallersArgument'
			return false
		end 'aDoorJudgesItsCallersArgument'

		self.permanentParamsNeeded = maskWithParam(self.permanentParamsNeeded, param: paramPositionOfValueId(param))
		return true
	end 'parameterIsPermanentGivenItsArgument'

	function settlingGivenArguments() returns bool
		return self.permanentSettling == PermanenceSettling.strictGivenArguments or self.permanentSettling == PermanenceSettling.orFreshGivenArguments
	end 'settlingGivenArguments'

	function slotHoldsAPermanentRecord(func IrFunction, addr ValueId, offset ByteOffset, held ValueId, depth ElementIndex) returns bool
		if self.slotIsALetSlot(func, addr: addr, offset: offset, held: held) 'aLetSlot'
			return true
		end 'aLetSlot'

		return self.recordIsPermanentlyReadOnly(func, base: self.sameRecordBase(func, ir: self.module, value: addr), depth: depth + 1, allowFresh: false)
	end 'slotHoldsAPermanentRecord'

	function callResultIsPermanentlyReadOnly(func IrFunction, op MaxonOp, callee ByteArray, depth ElementIndex, allowFresh bool) returns bool
		if self.opReadsASharedView(op) 'aSharedRead'
			return true
		end 'aSharedRead'

		maxonOpOperandValues(op, into: self.operands)

		if self.operands.count() > 0 and self.callReadsAReadOnlyElement(func, callee: callee, receiver: try self.operands.get(0) otherwise panic("ProvenanceTracer.callResultIsPermanentlyReadOnly: operands.get(0) on a non-empty list")) 'aReadOnlyElement'
			return true
		end 'aReadOnlyElement'

		if self.operands.count() > 0 and indexedElementReadCallee(callee) and self.receiverIsAStoredKeyColumn(func, receiver: try self.operands.get(0) otherwise panic("ProvenanceTracer.callResultIsPermanentlyReadOnly: operands.get(0) on a non-empty list")) 'aStoredKey'
			return true
		end 'aStoredKey'

		if allowFresh and self.operands.count() > 0 and indexedElementReadCallee(callee) and self.valueIsSwappedOut(func, value: try self.operands.get(0) otherwise panic("ProvenanceTracer.callResultIsPermanentlyReadOnly: operands.get(0) on a non-empty list")) 'outOfASwappedOutContainer'
			return true
		end 'outOfASwappedOutContainer'

		if allowFresh and runtimeCalleeMintsARecord(callee) 'aRuntimeMint'
			return true
		end 'aRuntimeMint'

		let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) otherwise return false

		if allowFresh and self.calleeReturnsFresh(callee) 'aFreshReturn'
			return true
		end 'aFreshReturn'

		if self.permanentSettling == (PermanenceSettling.orFresh if allowFresh else PermanenceSettling.strict) 'assumedUntilRefuted'
			self.permanentNeeds.push(calleeIndex)
			return true
		end 'assumedUntilRefuted'

		return self.permanentWhateverItIsHanded(calleeIndex, allowFresh: allowFresh) or self.callResultIsPermanentGivenArguments(func, op: op, calleeIndex: calleeIndex, callee: callee, depth: depth, allowFresh: allowFresh)
	end 'callResultIsPermanentlyReadOnly'

	function permanentWhateverItIsHanded(index ElementIndex, allowFresh bool) returns bool
		if allowFresh 'orFresh'
			return try self.permanentOrFreshReturns.get(index) otherwise false
		end 'orFresh'

		return try self.permanentReturns.get(index) otherwise false
	end 'permanentWhateverItIsHanded'

	function callResultIsPermanentGivenArguments(func IrFunction, op MaxonOp, calleeIndex ElementIndex, callee ByteArray, depth ElementIndex, allowFresh bool) returns bool
		view answers = self.permanentOrFreshGivenReturns if allowFresh else self.permanentGivenReturns

		if not (try answers.get(calleeIndex) otherwise false) 'notPermanentWhateverItIsHanded'
			return false
		end 'notPermanentWhateverItIsHanded'

		if self.settlingGivenArguments() 'aSettlingPass'
			self.permanentUsedGiven = true
		end 'aSettlingPass'

		let wanted = summaryMaskAt(self.permanentOrFreshGivenParams if allowFresh else self.permanentGivenParams, index: calleeIndex)
		view sig = try self.project.funcSignatures.get(callee) otherwise return false

		for position in 0 upto sig.paramCount() 'eachParameter'
			if not maskHasParam(wanted, param: position) 'notReturned'
				continue
			end 'notReturned'

			let argument = try calledArgumentAt(op, sig: sig, position: position) otherwise return false
			let argumentBase = self.sameRecordBase(func, ir: self.module, value: argument)

			if self.doorAcceptsParameters and argumentBase < valueIdAtParamPosition(func.paramCount) and maskHasParam(self.summary.identityAt(calleeIndex), param: position) 'handedOnByIdentity'
				continue
			end 'handedOnByIdentity'

			if allowFresh and self.valueIsUsedOnce(func, value: argument) and self.recordIsPermanentlyReadOnly(func, base: argumentBase, depth: depth + 1, allowFresh: true) 'aTemporaryNothingElseNames'
				continue
			end 'aTemporaryNothingElseNames'

			if not self.recordIsPermanentlyReadOnly(func, base: argumentBase, depth: depth + 1, allowFresh: false) 'argumentNotPermanent'
				return false
			end 'argumentNotPermanent'
		end 'eachParameter'

		return true
	end 'callResultIsPermanentGivenArguments'

	function receiverIsAStoredKeyColumn(func IrFunction, receiver ValueId) returns bool
		if not isStdlibSourceFile(self.project, path: func.sourceFilePath) 'notTheLibrary'
			return false
		end 'notTheLibrary'

		let base = self.sameRecordBase(func, ir: self.module, value: receiver)
		let defining = try self.definingOpIndexOf(base) otherwise return false

		match slotReadOfOp(try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.receiverIsAStoredKeyColumn: op {defining} not in module.ops"), opIndex: defining) 'read'
			load(_, addr, offset) then return self.fieldHoldsStoredKeys(func, addr: addr, offset: offset)

			none or
			store or
			retainOf then return false
		end 'read'
	end 'receiverIsAStoredKeyColumn'

	function fieldHoldsStoredKeys(func IrFunction, addr ValueId, offset ByteOffset) returns bool
		let tag = valueTagOf(func, value: addr)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.instanceFieldHoldsStoredKeys(self.instanceIdOf(func, value: addr), offset: offset)
		end 'anInstance'

		if not tagNamesADeclaredType(tag) 'notADeclaredRecord'
			return false
		end 'notADeclaredRecord'

		return self.signatures.declaredFieldHoldsStoredKeys(try self.project.typeNames.nameOf(self.nameIdOf(func, value: addr)) otherwise return false, offset: offset)
	end 'fieldHoldsStoredKeys'

	function callReadsAReadOnlyElement(func IrFunction, callee ByteArray, receiver ValueId) returns bool
		return calleeReadsAStoredSetElement(callee) or self.callReadsAReadOnlyInstanceElement(func, callee: callee, receiver: receiver)
	end 'callReadsAReadOnlyElement'

	function callReadsAReadOnlyInstanceElement(func IrFunction, callee ByteArray, receiver ValueId) returns bool
		if valueTagOf(func, value: receiver) != ValueTypeTag.genericInstance 'notAContainerInstance'
			return false
		end 'notAContainerInstance'

		let instance = self.instanceIdOf(func, value: receiver)

		if indexedElementReadCallee(callee) 'aRuntimeElementRead'
			return self.signatures.containerElementIsReadOnly(instance)
		end 'aRuntimeElementRead'

		let declared = try self.signatures.declaredValueReturnOf(callee, into: self.project.typeNames) otherwise return false

		if not self.signatures.typeParameterIsReadOnlyIn(instance, declared: declared) 'notAReadOnlyElementType'
			return false
		end 'notAReadOnlyElementType'

		_ = try self.signatures.storedElementPositionOf(callee, instance: instance, declared: declared) otherwise return self.resultLiesWithinTheReceiver(callee)
		return true
	end 'callReadsAReadOnlyInstanceElement'

	function resultLiesWithinTheReceiver(callee ByteArray) returns bool
		let calleeIndex = try self.calls.resolution.summarizedCalleeIndex(callee) otherwise return false
		return maskHasParam(self.summary.insideAt(calleeIndex), param: ReceiverParamPosition)
	end 'resultLiesWithinTheReceiver'

	module function settlePermanentReturns(funcNames FunctionNameIndex)
		self.settlePermanence(funcNames, mode: PermanenceSettling.strict)
		self.settlePermanence(funcNames, mode: PermanenceSettling.orFresh)
		self.settlePermanenceGivenArguments(funcNames, mode: PermanenceSettling.strictGivenArguments)
		self.settlePermanenceGivenArguments(funcNames, mode: PermanenceSettling.orFreshGivenArguments)
	end 'settlePermanentReturns'

	function settlePermanenceGivenArguments(funcNames FunctionNameIndex, mode PermanenceSettling)
		let funcCount = funcNames.functions.count()
		let allowFresh = mode == PermanenceSettling.orFreshGivenArguments
		var answers = self.permanentOrFreshGivenReturns if allowFresh else self.permanentGivenReturns
		var wanted = self.permanentOrFreshGivenParams if allowFresh else self.permanentGivenParams
		var pending = FuncIndexArray.create()
		answers.refill(funcCount, value: false)
		wanted.refill(funcCount, value: NoParamPositions)

		for index in 0 upto funcCount 'eachFunction'
			view func = self.functionAt(index)

			if bodyIsUnreadable(func) or not self.resultMayHandBackAModuleLetsRecord(func) or self.permanentWhateverItIsHanded(index, allowFresh: allowFresh) 'settledWithoutArguments'
				continue
			end 'settledWithoutArguments'

			try answers.set(index, value: true) otherwise panic("ProvenanceTracer.settlePermanenceGivenArguments: answers.set OOB at {index}")
			pending.push(index)
		end 'eachFunction'

		self.permanentSettling = mode
		var dependent = FuncIndexArray.create()
		var anAnswerMoved = self.judgeGivenAnswers(pending, allowFresh: allowFresh, answers: answers, wanted: wanted, dependent: dependent)

		while anAnswerMoved 'untilNothingMoves'
			var next = FuncIndexArray.create()
			anAnswerMoved = self.judgeGivenAnswers(dependent, allowFresh: allowFresh, answers: answers, wanted: wanted, dependent: next)
			dependent = next
		end 'untilNothingMoves'

		self.permanentSettling = PermanenceSettling.none
	end 'settlePermanenceGivenArguments'

	function judgeGivenAnswers(judged FuncIndexArray, allowFresh bool, answers BoolArray, wanted ParamPositionMaskArray, dependent FuncIndexArray) returns bool
		var anAnswerMoved = false

		for index in judged 'eachJudged'
			if not (try answers.get(index) otherwise panic("ProvenanceTracer.judgeGivenAnswers: answers.get OOB at {index}")) 'alreadyRefuted'
				continue
			end 'alreadyRefuted'

			self.permanentParamsNeeded = NoParamPositions
			self.permanentUsedGiven = false

			if not self.returnsOnlyPermanentRecords(self.functionAt(index), allowFresh: allowFresh) 'refuted'
				try answers.set(index, value: false) otherwise panic("ProvenanceTracer.judgeGivenAnswers: answers.set OOB at {index}")
				anAnswerMoved = true
				continue
			end 'refuted'

			let before = summaryMaskAt(wanted, index: index)
			let after = before or self.permanentParamsNeeded

			if after != before 'moreArgumentsNeeded'
				try wanted.set(index, value: after) otherwise panic("ProvenanceTracer.judgeGivenAnswers: wanted.set OOB at {index}")
				anAnswerMoved = true
			end 'moreArgumentsNeeded'

			if self.permanentUsedGiven 'readsAnotherAnswer'
				dependent.push(index)
			end 'readsAnotherAnswer'
		end 'eachJudged'

		return anAnswerMoved
	end 'judgeGivenAnswers'

	function settlePermanence(funcNames FunctionNameIndex, mode PermanenceSettling)
		let funcCount = funcNames.functions.count()
		var needCallers = FuncIndexArray.create()
		var needCallees = FuncIndexArray.create()
		var column = self.permanentOrFreshReturns if mode == PermanenceSettling.orFresh else self.permanentReturns
		column.refill(funcCount, value: false)
		self.permanentSettling = mode

		for index in 0 upto funcCount 'eachFunction'
			view func = self.functionAt(index)
			self.permanentNeeds.clear()

			if bodyIsUnreadable(func) or not self.resultMayHandBackAModuleLetsRecord(func) 'returnsNoRecord'
				continue
			end 'returnsNoRecord'

			if mode == PermanenceSettling.orFresh and (try self.permanentReturns.get(index) otherwise panic("ProvenanceTracer.settlePermanence: permanentReturns.get OOB at {index}")) 'alreadyPermanent'
				try column.set(index, value: true) otherwise panic("ProvenanceTracer.settlePermanence: column.set OOB at {index}")
				continue
			end 'alreadyPermanent'

			if not self.returnsOnlyPermanentRecords(func, allowFresh: mode == PermanenceSettling.orFresh) 'notPermanent'
				continue
			end 'notPermanent'

			try column.set(index, value: true) otherwise panic("ProvenanceTracer.settlePermanence: column.set OOB at {index}")

			for need in self.permanentNeeds 'eachNeed'
				needCallers.push(index)
				needCallees.push(need)
			end 'eachNeed'
		end 'eachFunction'

		self.permanentSettling = PermanenceSettling.none
		var refutedSomething = true

		while refutedSomething 'untilNothingIsRefuted'
			refutedSomething = false

			for k in 0 upto needCallers.count() 'eachNeedEdge'
				let caller = try needCallers.get(k) otherwise panic("ProvenanceTracer.settlePermanence: needCallers.get OOB at {k}")
				let callee = try needCallees.get(k) otherwise panic("ProvenanceTracer.settlePermanence: needCallees.get OOB at {k}")

				if (try column.get(caller) otherwise panic("ProvenanceTracer.settlePermanence: column.get OOB at {caller}")) and not (try column.get(callee) otherwise panic("ProvenanceTracer.settlePermanence: column.get OOB at {callee}")) 'refuted'
					try column.set(caller, value: false) otherwise panic("ProvenanceTracer.settlePermanence: column.set OOB at {caller}")
					refutedSomething = true
				end 'refuted'
			end 'eachNeedEdge'
		end 'untilNothingIsRefuted'
	end 'settlePermanence'

	function returnsOnlyPermanentRecords(func IrFunction, allowFresh bool) returns bool
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		var returnsARecord = false

		for blockRef in func.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.returnsOnlyPermanentRecords: blockRef from func.blockRefs not in module.blocks")

			if not block.hasTerminatorOp() 'unterminated'
				continue
			end 'unterminated'

			let returned = try returnedValueOf(try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.returnsOnlyPermanentRecords: terminatorIndex not in module.ops")) otherwise continue

			if not self.valueTagCarriesProvenance(func, value: returned) 'aScalar'
				continue
			end 'aScalar'

			returnsARecord = true

			if not self.recordIsPermanentlyReadOnly(func, base: self.sameRecordBase(func, ir: ir, value: returned), depth: 0, allowFresh: allowFresh) 'notPermanent'
				return false
			end 'notPermanent'
		end 'eachBlock'

		return returnsARecord
	end 'returnsOnlyPermanentRecords'

	function valueReadsAnInertModuleLet(func IrFunction, value ValueId) returns bool
		if self.inertGlobalLabels.count() == 0 'noInertLets'
			return false
		end 'noInertLets'

		return self.recordMeetsClaim(func, base: self.sameRecordBase(func, ir: self.module, value: value), depth: 0, claim: RecordClaim.inertModuleLet)
	end 'valueReadsAnInertModuleLet'

	function recordReadsAnInertModuleLet(func IrFunction, base ValueId, depth ElementIndex) returns bool
		if depth > MaxFreshRounds 'tooDeep'
			return false
		end 'tooDeep'

		if self.isAMerge(base) 'aMerge'
			return self.mergeMeetsClaim(func, phi: base, depth: depth, claim: RecordClaim.inertModuleLet)
		end 'aMerge'

		let defining = try self.definingOpIndexOf(base) otherwise return false

		match slotReadOfOp(try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.recordReadsAnInertModuleLet: op {defining} not in module.ops"), opIndex: defining) 'read'
			load(_, addr, _) then return self.addressNamesAnInertModuleLet(func, addr: addr)

			none or
			store or
			retainOf then return false
		end 'read'
	end 'recordReadsAnInertModuleLet'

	function addressNamesAnInertModuleLet(func IrFunction, addr ValueId) returns bool
		let owner = self.sameRecordBase(func, ir: self.module, value: addr)
		let defining = try self.definingOpIndexOf(owner) otherwise return false
		view op = try self.module.ops.get(defining) otherwise panic("ProvenanceTracer.addressNamesAnInertModuleLet: op {defining} not in module.ops")
		return maxonOpNamesAGlobalLabel(op) and self.inertGlobalLabels.contains(maxonOpGlobalLabelName(op))
	end 'addressNamesAnInertModuleLet'

	module function valueIsInertAtADoor(func IrFunction, value ValueId) returns bool
		return self.valueGivesAStoreNoWriter(func, value: value) or self.valueReadsAnInertModuleLet(func, value: value) or self.valueIsAPromiseHandle(func, value: value)
	end 'valueIsInertAtADoor'

	function valueIsAPromiseHandle(func IrFunction, value ValueId) returns bool
		return valueTagOf(func, value: value) == ValueTypeTag.genericInstance and typeIsPromiseStorage(self.signatures, t: maxonTypeOfTag(ValueTypeTag.genericInstance, nameId: self.nameIdOf(func, value: value)))
	end 'valueIsAPromiseHandle'

	function calleeReturnsFresh(callee ByteArray) returns bool
		let index = try self.calls.resolution.functionIndexNamed(callee) otherwise return false
		return try self.freshReturns.get(index) otherwise panic("ProvenanceTracer.calleeReturnsFresh: freshReturns.get OOB at {index} — it is filled over every function")
	end 'calleeReturnsFresh'

	function keptArgumentSiteOf(func IrFunction, value ValueId, call SourceRange) returns ElementIndex throws AbsentError
		self.indexKeptArgumentSites(func)
		let wanted = self.sameRecordBase(func, ir: self.module, value: value)
		view sites = func.provenanceSites(self.noSites).moveSites
		var next = try self.keptSiteHeads.get(positionKey(call.line, column: call.column)) otherwise throw AbsentError.absent

		while true 'eachSiteOfTheCall'
			if self.sameRecordBase(func, ir: self.module, value: (try sites.get(next) otherwise panic("ProvenanceTracer.keptArgumentSiteOf: moveSites.get OOB at {next}")).value) == wanted 'itsSite'
				return next
			end 'itsSite'

			next = try self.keptSiteNext.get(next) otherwise break
		end 'eachSiteOfTheCall'

		throw AbsentError.absent
	end 'keptArgumentSiteOf'

	function indexKeptArgumentSites(func IrFunction)
		if self.keptSitesValid and self.keptSitesIndex == self.enteredIndex 'alreadyIndexed'
			return
		end 'alreadyIndexed'

		view sites = func.provenanceSites(self.noSites).moveSites
		self.keptSiteHeads = KeptSiteHeadsByCall.create()
		self.keptSiteNext.makeAbsent(sites.count())

		for offset in 0 upto sites.count() 'eachSiteNewestFirst'
			let index = sites.count() - 1 - offset
			view site = try sites.get(index) otherwise panic("ProvenanceTracer.indexKeptArgumentSites: moveSites.get OOB at {index}")

			if site.destinationKind != MoveDestinationKind.keptArgument 'notAnArgument'
				continue
			end 'notAnArgument'

			let key = positionKey(site.line, column: site.column)

			if let head = try self.keptSiteHeads.get(key) 'alsoAtThisCall'
				self.keptSiteNext.set(index, value: head)
			end 'alsoAtThisCall'

			self.keptSiteHeads.upsert(key, value: index)
		end 'eachSiteNewestFirst'

		self.keptSitesValid = true
		self.keptSitesIndex = self.enteredIndex
	end 'indexKeptArgumentSites'

	function keptArgumentParameterName(note ElementIndex) returns String
		return (try self.keptArgParams.get(note) otherwise panic("ProvenanceTracer.keptArgumentParameterName: keptArgParams.get OOB at {note}")).displayName()
	end 'keptArgumentParameterName'

	function judgeKeptArgument(func IrFunction, note ElementIndex)
		let value = try self.keptArgValues.get(note) otherwise panic("ProvenanceTracer.judgeKeptArgument: keptArgValues.get OOB at {note}")

		if (try self.keptArgKinds.get(note) otherwise panic("ProvenanceTracer.judgeKeptArgument: keptArgKinds.get OOB at {note}")) == ArgumentKeep.consumed 'aConsumingParameter'
			self.judgeConsumedArgument(func, note: note, value: value)
			return
		end 'aConsumingParameter'

		if value < valueIdAtParamPosition(func.paramCount) or self.valueIsInertAtADoor(func, value: value) 'theCallersOwnOrNoWriter'
			return
		end 'theCallersOwnOrNoWriter'

		match try self.keptArgKinds.get(note) otherwise panic("ProvenanceTracer.judgeKeptArgument: keptArgKinds.get OOB at {note}") 'keep'
			letField then self.judgeLetFieldKeptArgument(func, note: note, value: value, into: ReadOnlyRootKind.letField)
			letPayload then self.judgeLetFieldKeptArgument(func, note: note, value: value, into: ReadOnlyRootKind.letPayload)
			readOnlyElement then self.judgeLetFieldKeptArgument(func, note: note, value: value, into: ReadOnlyRootKind.readOnlyElement)
			mutablePlace then self.judgeMutablyKeptArgument(func, note: note, value: value)
			consumed then panic("ProvenanceTracer.judgeKeptArgument: a consumed argument is judged before the match")
		end 'keep'
	end 'judgeKeptArgument'

	function judgeConsumedArgument(func IrFunction, note ElementIndex, value ValueId)
		let call = try self.keptArgCalls.get(note) otherwise panic("ProvenanceTracer.judgeConsumedArgument: keptArgCalls.get OOB at {note}")
		var parserRefused = false

		if let siteIndex = try self.keptArgumentSiteOf(func, value: value, call: call) 'aNamedVar'
			view site = try func.provenanceSites(self.noSites).moveSites.get(siteIndex) otherwise panic("ProvenanceTracer.keptArgumentSiteOf: moveSites.get OOB at {siteIndex}")

			if site.readAfter 'readOnceMoved'
				self.reportReadAfterMove(site)
				return
			end 'readOnceMoved'

			parserRefused = site.refused
		end 'aNamedVar'

		if not self.valueHoldsNoRecord(func, value: value) 'aRecordAViewMayHold'
			if let reach = try self.viewOfHandedOffValue(func, value: value, before: self.callTokenAtPosition(func, line: call.line, column: call.column)) 'aViewHoldsItAReference'
				self.refuseConsumedArgument(func, note: note, subject: self.viewedRootSubject(reach))
				return
			end 'aViewHoldsItAReference'
		end 'aRecordAViewMayHold'

		if parserRefused or value < valueIdAtParamPosition(func.paramCount) or not self.acceptsAsSole(func, value: value) 'notTheCallersToGiveAway'
			self.refuseConsumedArgument(func, note: note, subject: "a value other names may still write")
		end 'notTheCallersToGiveAway'
	end 'judgeConsumedArgument'

	function viewedRootSubject(reach ViewReach) returns String
		let viewName = String.from(self.rootNameAt(reach.viewRank))

		if reach.rootIsParameter 'aParameter'
			return viewedParameterSubject(reach.rootName, view: viewName)
		end 'aParameter'

		return viewedVarSubject(reach.rootName, view: viewName)
	end 'viewedRootSubject'

	function refuseConsumedArgument(func IrFunction, note ElementIndex, subject String)
		let call = try self.keptArgCalls.get(note) otherwise panic("ProvenanceTracer.refuseConsumedArgument: keptArgCalls.get OOB at {note}")
		let at = self.calleeStartOf(func, call: call)
		let calleeText = String.from(try self.keptArgCallees.get(note) otherwise panic("ProvenanceTracer.refuseConsumedArgument: keptArgCallees.get OOB at {note}"))
		self.refuse(at.line, column: at.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetPassedMessage(subject, paramName: self.keptArgumentParameterName(note), functionName: calleeText, fate: ArgumentFate.consumed))
	end 'refuseConsumedArgument'

	function judgeLetFieldKeptArgument(func IrFunction, note ElementIndex, value ValueId, into ReadOnlyRootKind)
		let call = try self.keptArgCalls.get(note) otherwise panic("ProvenanceTracer.judgeLetFieldKeptArgument: keptArgCalls.get OOB at {note}")
		self.noteKeptReadOnly(func, value: value, at: positionKey(call.line, column: call.column))

		if self.keptValueIsReadOnly(func, value: value) 'alreadyReadOnly'
			return
		end 'alreadyReadOnly'

		if self.valueIsHandedOut(func, value: value) 'alsoHandedOut'
			self.refuseLetFieldKeptArgument(func, note: note, value: value, into: into, subject: "a value this function also hands out")
			return
		end 'alsoHandedOut'

		if let siteIndex = try self.keptArgumentSiteOf(func, value: value, call: call) 'aNamedVar'
			view site = try func.provenanceSites(self.noSites).moveSites.get(siteIndex) otherwise panic("ProvenanceTracer.keptArgumentSiteOf: moveSites.get OOB at {siteIndex}")

			if site.readAfter or site.readInALaterIteration 'readAgain'
				self.refuseLetFieldKeptArgument(func, note: note, value: value, into: into, subject: "the `var` '{String.from(site.source)}', which is read again,")
				return
			end 'readAgain'
		end 'aNamedVar'

		if self.valueTakesNoOtherWriter(func, value: value, placedByTheStore: false) 'soleOrAParameter'
			return
		end 'soleOrAParameter'

		self.refuseLetFieldKeptArgument(func, note: note, value: value, into: into, subject: "a value other names may still write")
	end 'judgeLetFieldKeptArgument'

	function valueTakesNoOtherWriter(func IrFunction, value ValueId, placedByTheStore bool) returns bool
		if not (self.acceptsAsSole(func, value: value) or self.valueIsPermanentOrFresh(func, value: value)) 'neitherSoleNorFresh'
			return false
		end 'neitherSoleNorFresh'

		return placedByTheStore or self.valueIsUsedOnce(func, value: value) or not self.sets.hasWords(self.setOf(ProvenanceColumn.placedWithin, value: value))
	end 'valueTakesNoOtherWriter'

	function valueIsPermanentOrFresh(func IrFunction, value ValueId) returns bool
		self.doorAcceptsParameters = true
		let verdict = self.recordMeetsClaim(func, base: self.sameRecordBase(func, ir: self.module, value: value), depth: 0, claim: RecordClaim.permanentOrFresh)
		self.doorAcceptsParameters = false
		return verdict
	end 'valueIsPermanentOrFresh'

	function keptValueIsReadOnly(func IrFunction, value ValueId) returns bool
		self.doorAcceptsParameters = true
		let provenPermanent = self.recordIsPermanentlyReadOnly(func, base: self.sameRecordBase(func, ir: self.module, value: value), depth: 0, allowFresh: false)
		self.doorAcceptsParameters = false

		if provenPermanent 'provenPermanent'
			return true
		end 'provenPermanent'

		if self.valueReachesAMutablePlace(value) 'viewsWritableStorage'
			return false
		end 'viewsWritableStorage'

		return self.permanentViewOf(value) != PermanentView.none or self.valueMayBeAModuleLetsRecord(func, value: value) or self.rootHoldsTheViewReadOnly(func, value: value)
	end 'keptValueIsReadOnly'

	function rootHoldsTheViewReadOnly(func IrFunction, value ValueId) returns bool
		let rank = try self.firstRootRank(func, value: value, reach: RootReach.identityOrInside) otherwise return false

		if holderIsPermanent(holderOfRootKind(self.rootKindAt(rank))) 'permanentHolder'
			return true
		end 'permanentHolder'

		return not self.valueIsHandedOut(func, value: self.rootValueAt(rank))
	end 'rootHoldsTheViewReadOnly'

	function valueIsHandedOut(func IrFunction, value ValueId) returns bool
		if not self.handedOutComputed 'notScannedYet'
			self.scanHandedOutValues(func)
			self.handedOutComputed = true
		end 'notScannedYet'

		let base = self.sameRecordBase(func, ir: self.module, value: value)

		if base < valueIdAtParamPosition(func.paramCount) 'theCallersOwn'
			return false
		end 'theCallersOwn'

		return try self.valueHandedOut.get(base) otherwise panic("ProvenanceTracer.valueHandedOut: valueHandedOut.get OOB at v{base}")
	end 'valueIsHandedOut'

	function noteKeptReadOnly(func IrFunction, value ValueId, at PositionKey)
		self.readOnlyKeptBases.push(self.sameRecordBase(func, ir: self.module, value: value))
		self.readOnlyKeptAt.push(at)
	end 'noteKeptReadOnly'

	function rootIsKeptReadOnlyBefore(func IrFunction, rank ElementIndex, door PositionKey) returns bool
		let base = self.sameRecordBase(func, ir: self.module, value: self.rootValueAt(rank))

		for (iter, kept) in self.readOnlyKeptBases.withIterator() 'eachKept'
			if kept == base and (try self.readOnlyKeptAt.get(iter.index()) otherwise panic("ProvenanceTracer.rootIsKeptReadOnlyBefore: readOnlyKeptAt.get OOB at {iter.index()}")) < door 'keptEarlier'
				return true
			end 'keptEarlier'
		end 'eachKept'

		return false
	end 'rootIsKeptReadOnlyBefore'

	function scanHandedOutValues(func IrFunction)
		view ir = self.module
		self.indexDefinitions(func, ir: ir)
		self.valueHandedOut.refill(func.valueTags.count(), value: false)

		for blockRef in func.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.scanHandedOutValues: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				match slotReadOfOp(try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.scanHandedOutValues: opIdx {opIdx} not in module.ops"), opIndex: opIdx) 'access'
					store(addr, offset, value) then self.noteStoreHandsOut(func, addr: addr, offset: offset, value: value)

					none or
					load or
					retainOf then continue
				end 'access'
			end 'eachOp'

			if block.hasTerminatorOp() 'terminated'
				if let returned = try returnedValueOf(try ir.ops.get(block.terminatorIndex()) otherwise panic("ProvenanceTracer.scanHandedOutValues: terminatorIndex not in module.ops")) 'aReturn'
					self.noteValueHandedOut(func, value: returned)
				end 'aReturn'
			end 'terminated'
		end 'eachBlock'

		var grew = true

		while grew 'untilNoMergeHandsMore'
			grew = self.handOutThroughMerges(func)
		end 'untilNoMergeHandsMore'
	end 'scanHandedOutValues'

	function noteStoreHandsOut(func IrFunction, addr ValueId, offset ByteOffset, value ValueId)
		if self.slotIsALetField(func, addr: addr, offset: offset) or self.slotIsALetPayload(func, box: addr, offset: offset, held: value) 'intoAPlaceNothingWrites'
			return
		end 'intoAPlaceNothingWrites'

		self.noteValueHandedOut(func, value: value)
	end 'noteStoreHandsOut'

	function noteValueHandedOut(func IrFunction, value ValueId)
		let base = self.sameRecordBase(func, ir: self.module, value: value)
		try self.valueHandedOut.set(base, value: true) otherwise panic("ProvenanceTracer.noteValueHandedOut: valueHandedOut.set OOB at v{base}")
	end 'noteValueHandedOut'

	function handOutThroughMerges(func IrFunction) returns bool
		var grew = false

		for pair in 0 upto self.pairMerge.count() 'eachPair'
			if not self.pairIsHanded(pair) 'nothingHanded'
				continue
			end 'nothingHanded'

			let merge = self.pairMergeAt(pair)
			let base = self.sameRecordBase(func, ir: self.module, value: self.pairIncomingAt(pair))

			let mergeHanded = try self.valueHandedOut.get(merge) otherwise continue
			let baseHanded = try self.valueHandedOut.get(base) otherwise panic("ProvenanceTracer.handOutThroughMerges: valueHandedOut.get OOB at v{base}")

			if mergeHanded and not baseHanded 'aMergeHandsOutAnIncomingValue'
				try self.valueHandedOut.set(base, value: true) otherwise panic("ProvenanceTracer.handOutThroughMerges: valueHandedOut.set OOB at v{base}")
				grew = true
			end 'aMergeHandsOutAnIncomingValue'
		end 'eachPair'

		return grew
	end 'handOutThroughMerges'

	function refuseLetFieldKeptArgument(func IrFunction, note ElementIndex, value ValueId, into ReadOnlyRootKind, subject String)
		if self.deferToInstantiation(func, value: value, owner: try self.keptArgFuncs.get(note) otherwise panic("ProvenanceTracer.refuseLetFieldKeptArgument: keptArgFuncs.get OOB at {note}")) 'decidedWhereItIsInstantiated'
			return
		end 'decidedWhereItIsInstantiated'

		let call = try self.keptArgCalls.get(note) otherwise panic("ProvenanceTracer.refuseLetFieldKeptArgument: keptArgCalls.get OOB at {note}")
		let calleeText = String.from(try self.keptArgCallees.get(note) otherwise panic("ProvenanceTracer.refuseLetFieldKeptArgument: keptArgCallees.get OOB at {note}"))
		let paramName = self.keptArgumentParameterName(note)
		self.refuse(call.line, column: call.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetKeptArgumentMessage(into, subject: subject, paramName: paramName, functionName: calleeText))
	end 'refuseLetFieldKeptArgument'

	function judgeMutablyKeptArgument(func IrFunction, note ElementIndex, value ValueId)
		let view = self.maybePermanentViewOf(value)

		if view == PermanentView.none or self.deferToInstantiation(func, value: value, owner: try self.keptArgFuncs.get(note) otherwise panic("ProvenanceTracer.judgeMutablyKeptArgument: keptArgFuncs.get OOB at {note}")) 'nothingToRefuseHere'
			return
		end 'nothingToRefuseHere'

		let call = try self.keptArgCalls.get(note) otherwise panic("ProvenanceTracer.judgeMutablyKeptArgument: keptArgCalls.get OOB at {note}")
		let calleeText = String.from(try self.keptArgCallees.get(note) otherwise panic("ProvenanceTracer.judgeMutablyKeptArgument: keptArgCallees.get OOB at {note}"))
		let paramName = self.keptArgumentParameterName(note)
		self.refuse(call.line, column: call.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetPassedMessage(readOnlyRootSubject("", kind: viewRootKind(view)), paramName: paramName, functionName: calleeText, fate: ArgumentFate.keptWhereWritable))
	end 'judgeMutablyKeptArgument'

	module function noteKeptRefused(value ValueId, line LineNumber, column ColumnNumber)
		self.keptRefusedValues.push(value)
		self.keptRefusedAt.push(positionKey(line, column: column))
	end 'noteKeptRefused'

	function clearKeptRefused()
		self.keptRefusedValues.clear()
		self.keptRefusedAt.clear()
	end 'clearKeptRefused'

	module function refuseKeptLetArgument(func IrFunction, value ValueId, call SourceRange, parameter ArgumentParameter, wording KeptWording) returns bool
		if not self.immutableBindingsAreTraced(func) 'noImmutableRootToBlame'
			return false
		end 'noImmutableRootToBlame'

		view blamed = self.firstKeptRoot(func, value: value, token: self.callTokenAtPosition(func, line: call.line, column: call.column), names: RootCondition.aKeptName)

		if not blamed.isBlamed() 'nothingBlamed'
			return false
		end 'nothingBlamed'

		if self.deferToInstantiation(func, value: value, owner: self.enteredIndex) 'decidedWhereItIsInstantiated'
			return false
		end 'decidedWhereItIsInstantiated'

		let paramName = parameter.displayName()

		self.noteKeptRefused(value, line: call.line, column: call.column)
		let at = self.calleeStartOf(func, call: call)
		reportPositioned(self.project, code: ErrorCode.semanticVarFromImmutable, message: keptArgumentMessage(wording, subject: self.keptArgumentSubject(func, value: value, blamed: blamed, wording: wording, call: call), paramName: paramName), line: at.line, column: at.column, filePath: func.sourceFilePath)
		return true
	end 'refuseKeptLetArgument'

	function checkViewSinks(func IrFunction, index ElementIndex)
		for (opIdx, stored) in self.viewSinks 'eachSink'
			let view = self.maybePermanentViewOf(stored)

			if view == PermanentView.none or self.valueIsInertAtADoor(func, value: stored) or self.deferToInstantiation(func, value: stored, owner: index) 'nothingShared'
				continue
			end 'nothingShared'

			let at = self.project.opRanges.get(opIdx)
			self.refuse(at.line, column: at.column, code: ErrorCode.semanticVarFromImmutable, message: deepLetStoreMessage(readOnlyRootDescription(viewRootKind(view)), place: "an element of the container this call writes"))
		end 'eachSink'
	end 'checkViewSinks'

	// A door cannot judge a value built on a type parameter in the generic body, so it accepts it
	// there and marks the body. `reportOpaqueInstantiations`, run after every door, refuses each call
	// or interface conversion that instantiates a marked body with a type that may carry a writable
	// record.
	function deferToInstantiation(func IrFunction, value ValueId, owner ElementIndex) returns bool
		if not self.valueIsBuiltOnATypeParameter(func, value: value) 'concrete'
			return false
		end 'concrete'

		try self.opaqueBoundBodies.set(owner, value: true) otherwise panic("ProvenanceTracer.deferToInstantiation: opaqueBoundBodies.set OOB at {owner}")
		return true
	end 'deferToInstantiation'

	function valueIsBuiltOnATypeParameter(func IrFunction, value ValueId) returns bool
		let tag = valueTagOf(func, value: value)

		if tag == ValueTypeTag.typeParameter 'theParameterItself'
			return true
		end 'theParameterItself'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.typeIsBuiltOnATypeParameter(maxonTypeOfTag(tag, nameId: self.nameIdOf(func, value: value)))
		end 'anInstance'

		if not tagNamesADeclaredType(tag) 'nothingToWalk'
			return false
		end 'nothingToWalk'

		return self.signatures.aggregateNameIsBuiltOnATypeParameter(try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise return false)
	end 'valueIsBuiltOnATypeParameter'

	function reportOpaqueInstantiations()
		let bodyCount = self.opaqueBoundBodies.count()
		var anyBound = false

		for i in 0 upto bodyCount 'eachBody'
			anyBound = anyBound or (try self.opaqueBoundBodies.get(i) otherwise panic("ProvenanceTracer.reportOpaqueInstantiations: opaqueBoundBodies.get OOB at {i}"))
		end 'eachBody'

		if not anyBound 'nothingBound'
			return
		end 'nothingBound'

		var grew = true

		while grew 'untilNothingNewIsBound'
			grew = false

			for callerIndex in 0 upto bodyCount 'eachInheritingCaller'
				grew = self.judgeInstantiationsIn(callerIndex, reporting: false) or grew
			end 'eachInheritingCaller'
		end 'untilNothingNewIsBound'

		for callerIndex in 0 upto bodyCount 'eachReportingCaller'
			_ = self.judgeInstantiationsIn(callerIndex, reporting: true)
		end 'eachReportingCaller'
	end 'reportOpaqueInstantiations'

	function opaqueBoundBodyAt(index ElementIndex) returns bool
		return try self.opaqueBoundBodies.get(index) otherwise panic("ProvenanceTracer.opaqueBoundBodyAt: opaqueBoundBodies.get OOB at {index}")
	end 'opaqueBoundBodyAt'

	function opaqueBoundCalleeNamed(name ByteArray) returns ElementIndex throws MapError
		let calleeIndex = try self.calls.resolution.functionIndexNamed(name)

		if not self.opaqueBoundBodyAt(calleeIndex) 'notBound'
			throw MapError.keyNotFound
		end 'notBound'

		return calleeIndex
	end 'opaqueBoundCalleeNamed'

	function judgeInstantiationsIn(callerIndex ElementIndex, reporting bool) returns bool
		view caller = self.functionAt(callerIndex)

		if caller.isCompilerBuilt() 'noAuthorToBlame'
			return false
		end 'noAuthorToBlame'

		view ir = self.module
		var grew = false

		for blockRef in caller.blockRefs 'eachBlock'
			view block = try ir.blocks.get(blockRef) otherwise panic("ProvenanceTracer.judgeInstantiationsIn: blockRef from func.blockRefs not in module.blocks")

			for position in 0 upto block.opCountInRunOrder() 'eachOp'
				let opIdx = block.opInRunOrderAt(position)
				view op = try ir.ops.get(opIdx) otherwise panic("ProvenanceTracer.judgeInstantiationsIn: opIdx {opIdx} not in module.ops")

				match op 'op'
					call(result, callee, args, argLabels, _, _, _, _) then grew = self.judgeNamedInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, result: result, called: callee, args: args, argLabels: argLabels, reporting: reporting) or grew
					tryCall(result, _, callee, args, argLabels, _, _, _, _) then grew = self.judgeNamedInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, result: result, called: callee, args: args, argLabels: argLabels, reporting: reporting) or grew
					asyncCall(result, callee, args, argLabels, _, _, _, _) then grew = self.judgeNamedInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, result: result, called: callee, args: args, argLabels: argLabels, reporting: reporting) or grew
					witnessDispatch(result, args, _, _, methodIndex, interfaceDeclIndex, _, _) then grew = self.judgeLandingInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, result: result, args: args, bodies: self.calls.resolution.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), reporting: reporting) or grew
					witnessTryDispatch(result, _, args, _, _, methodIndex, interfaceDeclIndex, _) then grew = self.judgeLandingInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, result: result, args: args, bodies: self.calls.resolution.implsOf(methodIndex, interfaceDeclIndex: interfaceDeclIndex), reporting: reporting) or grew

					ret(retVal) then grew = self.judgeInterfaceReturn(caller, callerIndex: callerIndex, opIdx: opIdx, returned: retVal, reporting: reporting) or grew

					literal or
					retVoid or
					binOp or
					unaryOp or
					compare or
					condBranch or
					branch or
					globalAddr or
					loadIndirect or
					storeIndirect or
					stringLiteral or
					throwError or
					propagateError or
					panicAbort or
					functionRef or
					indirectCall or
					await or
					tryAwait or
					sizeofType or
					constArrayLiteral or
					switch or
					panicAbortValue or
					errorFlagEncode or
					serviceSpawn or
					serviceSend or
					serviceReplyCell or
					immortalStructRecord or
					immortalStringTable or
					covPoint or
					rawIntrinsic or
					holdValue or
					holdEnd then break

					existentialWitness(_, interfaceName, conformer) then grew = self.judgeConversion(caller, callerIndex: callerIndex, opIdx: opIdx, interfaceName: interfaceName, conformer: conformer, reporting: reporting) or grew
				end 'op'
			end 'eachOp'
		end 'eachBlock'

		return grew
	end 'judgeInstantiationsIn'

	function judgeInterfaceReturn(caller IrFunction, callerIndex ElementIndex, opIdx ElementIndex, returned ValueId, reporting bool) returns bool
		return match caller.maxonReturnType 'returned'
			void gives false
			value(declared) gives maxonTypeTag(declared) == ValueTypeTag.interfaceRef and self.judgeConversion(caller, callerIndex: callerIndex, opIdx: opIdx, interfaceName: interfaceNameOfType(declared, typeNames: self.project.typeNames), conformer: returned, reporting: reporting)
		end 'returned'
	end 'judgeInterfaceReturn'

	function judgeConversion(caller IrFunction, callerIndex ElementIndex, opIdx ElementIndex, interfaceName ByteArray, conformer ValueId, reporting bool) returns bool
		let tag = valueTagOf(caller, value: conformer)

		if tag != ValueTypeTag.genericInstance and not tagNamesADeclaredType(tag) 'notAnInstance'
			return false
		end 'notAnInstance'

		let base = self.baseNameOfInstanceOrDeclaration(caller, value: conformer)

		if self.signatures.structTypeParamsOf(base).count() == 0 'notGeneric'
			return false
		end 'notGeneric'

		view required = match lookupInterface(self.project.interfaces, name: interfaceName) 'lookup'
			found(iface) gives iface.methods
			notFound gives InterfaceMethodSigArray.create()
		end 'lookup'

		var filled = ValueIdArray.create()
		filled.push(conformer)
		var positions = ParamCountArray.create()
		positions.push(0 as ParamCount)
		var grew = false

		for impl in 0 upto self.opaqueBoundBodies.count() 'eachFunction'
			if impl == callerIndex or not self.opaqueBoundBodyAt(impl) or not self.functionImplementsAnInstanceRequirement(impl, owner: base, required: required) 'notABoundRequirement'
				continue
			end 'notABoundRequirement'

			grew = self.judgeInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, calleeIndex: impl, result: conformer, filled: filled, positions: positions, reporting: reporting, door: InstantiationDoor.aConversion(interfaceName)) or grew
		end 'eachFunction'

		return grew
	end 'judgeConversion'

	function functionImplementsAnInstanceRequirement(index ElementIndex, owner ByteArray, required InterfaceMethodSigArray) returns bool
		return match splitQualifiedName(self.functionAt(index).name) 'qualified'
			parts(declaring, member) gives declaring.equals(owner) and self.requirementsNameAnInstanceMethod(required, member: member)
			notQualified gives false
		end 'qualified'
	end 'functionImplementsAnInstanceRequirement'

	function requirementsNameAnInstanceMethod(required InterfaceMethodSigArray, member ByteArray) returns bool
		for requirement in required 'eachRequirement'
			if not requirement.isStatic and requirement.name.equals(member) 'itIsThisOne'
				return true
			end 'itIsThisOne'
		end 'eachRequirement'

		return false
	end 'requirementsNameAnInstanceMethod'

	function judgeInterfaceArguments(caller IrFunction, callerIndex ElementIndex, opIdx ElementIndex, called ByteArray, args ValueIdArray, argLabels NameRoster, reporting bool) returns bool
		let calleeIndex = try self.calls.resolution.functionIndexNamed(called) otherwise return false
		view calleeFunc = self.functionAt(calleeIndex)
		view signature = self.calls.resolution.signatureOf(called)
		var grew = false

		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("ProvenanceTracer.judgeInterfaceArguments: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
			let slot = try argSlotPosition(signature.paramNames, argIndex: i as ParamCount, label: label) otherwise continue
			let declared = try calleeFunc.maxonParamTypes.get(slot) otherwise continue

			if maxonTypeTag(declared) == ValueTypeTag.interfaceRef 'anInterfaceParameter'
				let conformer = try args.get(i) otherwise panic("ProvenanceTracer.judgeInterfaceArguments: args.get OOB at {i}")
				grew = self.judgeConversion(caller, callerIndex: callerIndex, opIdx: opIdx, interfaceName: interfaceNameOfType(declared, typeNames: self.project.typeNames), conformer: conformer, reporting: reporting) or grew
			end 'anInterfaceParameter'
		end 'eachArg'

		return grew
	end 'judgeInterfaceArguments'

	function judgeNamedInstantiation(caller IrFunction, callerIndex ElementIndex, opIdx ElementIndex, result ValueId, called ByteArray, args ValueIdArray, argLabels NameRoster, reporting bool) returns bool
		let grewByConversion = self.judgeInterfaceArguments(caller, callerIndex: callerIndex, opIdx: opIdx, called: called, args: args, argLabels: argLabels, reporting: reporting)
		let calleeIndex = try self.opaqueBoundCalleeNamed(called) otherwise return grewByConversion

		if calleeIndex == callerIndex 'itself'
			return grewByConversion
		end 'itself'

		view signature = self.calls.resolution.signatureOf(called)
		var filled = ValueIdArray.create()
		var positions = ParamCountArray.create()

		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("ProvenanceTracer.judgeNamedInstantiation: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")

			if let slot = try argSlotPosition(signature.paramNames, argIndex: i as ParamCount, label: label) 'fillsAParameter'
				filled.push(try args.get(i) otherwise panic("ProvenanceTracer.judgeNamedInstantiation: args.get OOB at {i}"))
				positions.push(slot)
			end 'fillsAParameter'
		end 'eachArg'

		return self.judgeInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, calleeIndex: calleeIndex, result: result, filled: filled, positions: positions, reporting: reporting, door: InstantiationDoor.aCall) or grewByConversion
	end 'judgeNamedInstantiation'

	function instantiationMessage(calleeText String, door InstantiationDoor) returns String
		return match door 'door'
			aCall gives deepLetInstantiationMessage(calleeText)
			aConversion(interfaceName) gives deepLetConversionMessage(calleeText, interfaceName: String.from(interfaceName))
		end 'door'
	end 'instantiationMessage'

	function ownerIsGeneric(index ElementIndex) returns bool
		return match splitQualifiedName(self.functionAt(index).name) 'qualified'
			parts(declaring, _) gives self.signatures.structTypeParamsOf(declaring).count() > 0
			notQualified gives false
		end 'qualified'
	end 'ownerIsGeneric'

	function judgeLandingInstantiation(caller IrFunction, callerIndex ElementIndex, opIdx ElementIndex, result ValueId, args ValueIdArray, bodies CallLandingBodies, reporting bool) returns bool
		var positions = ParamCountArray.create()

		for i in 0 upto args.count() 'eachArg'
			positions.push(i as ParamCount)
		end 'eachArg'

		var grew = false

		for impl in bodies.impls 'eachImpl'
			if impl != callerIndex and self.opaqueBoundBodyAt(impl) and not self.ownerIsGeneric(impl) 'aBoundLanding'
				grew = self.judgeInstantiation(caller, callerIndex: callerIndex, opIdx: opIdx, calleeIndex: impl, result: result, filled: args, positions: positions, reporting: reporting, door: InstantiationDoor.aCall) or grew
			end 'aBoundLanding'
		end 'eachImpl'

		return grew
	end 'judgeLandingInstantiation'

	function judgeInstantiation(caller IrFunction, callerIndex ElementIndex, opIdx ElementIndex, calleeIndex ElementIndex, result ValueId, filled ValueIdArray, positions ParamCountArray, reporting bool, door InstantiationDoor) returns bool
		view calleeFunc = self.functionAt(calleeIndex)
		var verdict = OpaqueBoundClass.satisfied
		var relevant = false

		for i in 0 upto filled.count() 'eachArg'
			let position = try positions.get(i) otherwise panic("ProvenanceTracer.judgeInstantiation: positions.get OOB at {i}")
			let value = try filled.get(i) otherwise panic("ProvenanceTracer.judgeInstantiation: filled.get OOB at {i}")
			var shape = OpaqueShape.none

			if let declared = try calleeFunc.maxonParamTypes.get(position) 'aDeclaredType'
				shape = self.opaqueShapeOf(declared)

				if shape == OpaqueShape.element and positions.count() > 0 and (try positions.get(0) otherwise panic("ProvenanceTracer.judgeInstantiation: positions.get OOB at 0")) == 0 and self.elementParameterIsReadOnlyInReceiver(caller, declared: declared, receiver: try filled.get(0) otherwise panic("ProvenanceTracer.judgeInstantiation: filled.get OOB at 0")) 'keptReadOnlyByTheInstance'
					continue
				end 'keptReadOnlyByTheInstance'
			end 'aDeclaredType'

			if shape == OpaqueShape.none and self.valueIsAnInstanceOfTheOwner(caller, value: value, calleeFunc: calleeFunc) 'theReceiverOfAGenericType'
				shape = OpaqueShape.container
			end 'theReceiverOfAGenericType'

			if shape == OpaqueShape.none 'independentOfTheTypeParameter'
				continue
			end 'independentOfTheTypeParameter'

			relevant = true
			verdict = worseOpaqueBoundClass(verdict, next: self.boundClassOfValue(caller, value: value, container: shape == OpaqueShape.container))
		end 'eachArg'

		let returnedShape = self.returnedOpaqueShape(calleeFunc)

		if returnedShape != OpaqueShape.none 'resultDependsOnTheTypeParameter'
			relevant = true
			verdict = worseOpaqueBoundClass(verdict, next: self.boundClassOfValue(caller, value: result, container: returnedShape == OpaqueShape.container))
		end 'resultDependsOnTheTypeParameter'

		if not relevant 'nothingToJudgeBy'
			verdict = OpaqueBoundClass.writable
		end 'nothingToJudgeBy'

		match verdict 'verdict'
			satisfied then return false
			opaque then return self.inheritOpaqueBound(callerIndex)
			writable then return self.refuseInstantiation(caller, opIdx: opIdx, calleeFunc: calleeFunc, reporting: reporting, door: door)
		end 'verdict'
	end 'judgeInstantiation'

	function elementParameterIsReadOnlyInReceiver(func IrFunction, declared MaxonType, receiver ValueId) returns bool
		if valueTagOf(func, value: receiver) != ValueTypeTag.genericInstance 'notAnInstance'
			return false
		end 'notAnInstance'

		return self.signatures.typeParameterIsReadOnlyIn(self.instanceIdOf(func, value: receiver), declared: declared)
	end 'elementParameterIsReadOnlyInReceiver'

	function valueIsAnInstanceOfTheOwner(func IrFunction, value ValueId, calleeFunc IrFunction) returns bool
		let tag = valueTagOf(func, value: value)

		if tag != ValueTypeTag.genericInstance and not tagNamesADeclaredType(tag) 'notAnInstance'
			return false
		end 'notAnInstance'

		return match splitQualifiedName(calleeFunc.name) 'qualified'
			parts(owner, _) gives owner.equals(self.baseNameOfInstanceOrDeclaration(func, value: value))
			notQualified gives false
		end 'qualified'
	end 'valueIsAnInstanceOfTheOwner'

	function baseNameOfInstanceOrDeclaration(func IrFunction, value ValueId) returns ByteArray
		if valueTagOf(func, value: value) == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.genericInstanceBaseName(self.instanceIdOf(func, value: value))
		end 'anInstance'

		return try self.project.typeNames.nameOf(self.nameIdOf(func, value: value)) otherwise panic("ProvenanceTracer.baseNameOfInstanceOrDeclaration: type name {self.nameIdOf(func, value: value)} is not in the project interner")
	end 'baseNameOfInstanceOrDeclaration'

	function inheritOpaqueBound(callerIndex ElementIndex) returns bool
		if self.opaqueBoundBodyAt(callerIndex) 'alreadyBound'
			return false
		end 'alreadyBound'

		try self.opaqueBoundBodies.set(callerIndex, value: true) otherwise panic("ProvenanceTracer.inheritOpaqueBound: opaqueBoundBodies.set OOB at {callerIndex}")
		return true
	end 'inheritOpaqueBound'

	function refuseInstantiation(caller IrFunction, opIdx ElementIndex, calleeFunc IrFunction, reporting bool, door InstantiationDoor) returns bool
		if not reporting 'stillSettling'
			return false
		end 'stillSettling'

		let at = self.project.opRanges.get(opIdx)
		let calleeText = String.from(calleeFunc.name)
		reportPositioned(self.project, code: ErrorCode.semanticVarFromImmutable, message: self.instantiationMessage(calleeText, door: door), line: at.line, column: at.column, filePath: caller.sourceFilePath)
		return false
	end 'refuseInstantiation'

	function returnedOpaqueShape(calleeFunc IrFunction) returns OpaqueShape
		return match calleeFunc.maxonReturnType 'returned'
			void gives OpaqueShape.none
			value(inner) gives self.opaqueShapeOf(inner)
		end 'returned'
	end 'returnedOpaqueShape'

	function opaqueShapeOf(declared MaxonType) returns OpaqueShape
		if maxonTypeTag(declared) == ValueTypeTag.typeParameter 'anElement'
			return OpaqueShape.element
		end 'anElement'

		if maxonTypeTag(declared) == ValueTypeTag.genericInstance and self.signatures.typeIsBuiltOnATypeParameter(declared) 'aContainerOfOne'
			return OpaqueShape.container
		end 'aContainerOfOne'

		return OpaqueShape.none
	end 'opaqueShapeOf'

	function boundClassOfValue(func IrFunction, value ValueId, container bool) returns OpaqueBoundClass
		let tag = valueTagOf(func, value: value)

		if tag == ValueTypeTag.typeParameter 'stillOpaque'
			return OpaqueBoundClass.opaque
		end 'stillOpaque'

		if not container 'theElementItself'
			return OpaqueBoundClass.satisfied if self.valueGivesAStoreNoWriter(func, value: value) else OpaqueBoundClass.writable
		end 'theElementItself'

		if tag != ValueTypeTag.genericInstance and tagNamesADeclaredType(tag) and self.signatures.structTypeParamsOf(self.baseNameOfInstanceOrDeclaration(func, value: value)).count() > 0 'theOwnersOwnRecord'
			return OpaqueBoundClass.opaque
		end 'theOwnersOwnRecord'

		if tag != ValueTypeTag.genericInstance 'notAContainerOfOne'
			return OpaqueBoundClass.writable
		end 'notAContainerOfOne'

		let id = self.instanceIdOf(func, value: value)
		var verdict = OpaqueBoundClass.satisfied

		for position in 0 upto self.signatures.genericInstanceArgCount(id) 'eachArgument'
			if self.signatures.genericInstanceArgIsReadOnly(id, position: position) 'storesReadOnlyValues'
				continue
			end 'storesReadOnlyValues'

			verdict = worseOpaqueBoundClass(verdict, next: self.boundClassOfType(self.signatures.substitutedInstanceArg(id, position: position)))
		end 'eachArgument'

		return verdict
	end 'boundClassOfValue'

	function boundClassOfType(argument MaxonType) returns OpaqueBoundClass
		if maxonTypeTag(argument) == ValueTypeTag.typeParameter or self.signatures.typeIsBuiltOnATypeParameter(argument) 'stillOpaque'
			return OpaqueBoundClass.opaque
		end 'stillOpaque'

		var types = MaxonTypeArray.create()
		types.push(argument)
		let within = self.signatures.recordKindsOfTypes(types)

		if within.anything 'anyRecord'
			return OpaqueBoundClass.writable
		end 'anyRecord'

		for kind in within.kinds 'eachKind'
			if not kind.equals(HeldByteRecordKind) and not self.signatures.aggregateTypeIsImmutable(kind) 'writable'
				return OpaqueBoundClass.writable
			end 'writable'
		end 'eachKind'

		return OpaqueBoundClass.satisfied
	end 'boundClassOfType'
end 'ProvenanceTracer'

union InstantiationDoor
	aCall
	aConversion(let interfaceName ByteArray)
end 'InstantiationDoor'

// Ordered best to worst: `worseOpaqueBoundClass` keeps the higher ordinal.
enum OpaqueBoundClass
	satisfied
	opaque
	writable
end 'OpaqueBoundClass'

enum OpaqueShape
	none
	element
	container
end 'OpaqueShape'

function worseOpaqueBoundClass(held OpaqueBoundClass, next OpaqueBoundClass) returns OpaqueBoundClass
	return next if next.ordinal > held.ordinal else held
end 'worseOpaqueBoundClass'

function incomingIsTheMerge(merge ValueId, incoming ValueId, incomingBase ValueId) returns bool
	return incoming == merge or incomingBase == merge
end 'incomingIsTheMerge'

function opProducesAnImage(op MaxonOp) returns bool
	return match op 'op'
		constArrayLiteral or
		immortalStructRecord or
		immortalStringTable or
		literal or
		stringLiteral gives true

		call or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		loadIndirect or
		storeIndirect or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives false
	end 'op'
end 'opProducesAnImage'

function freshCalleeOf(op MaxonOp) returns ByteArray throws AbsentError
	match op 'op'
		call(_, callee, _, _, _, _, _, _) then return callee
		tryCall(_, _, callee, _, _, _, _, _, _) then return callee

		literal or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd then throw AbsentError.absent
	end 'op'
end 'freshCalleeOf'

function calledArgumentAt(op MaxonOp, sig FuncSignature, position ParamCount) returns ValueId throws AbsentError
	match op 'op'
		call(_, _, args, argLabels, _, _, _, _) then return try freshArgAt(args, argLabels: argLabels, sig: sig, position: position)
		tryCall(_, _, _, args, argLabels, _, _, _, _) then return try freshArgAt(args, argLabels: argLabels, sig: sig, position: position)
		default throws AbsentError.absent
	end 'op'
end 'calledArgumentAt'

function freshArgAt(args ValueIdArray, argLabels NameRoster, sig FuncSignature, position ParamCount) returns ValueId throws AbsentError
	for i in 0 upto args.count() 'eachArg'
		let label = try argLabels.get(i) otherwise panic("freshArgAt: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
		let slot = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

		if slot == position 'itsArgument'
			return try args.get(i) otherwise panic("freshArgAt: args.get OOB at {i}")
		end 'itsArgument'
	end 'eachArg'

	throw AbsentError.absent
end 'freshArgAt'

// The body a `functionRef` names, once. A name `isFunctionValueBodyName` refuses is a container
// descriptor's release or copy routine, which the runtime's own walk calls and no function value
// reaches (`Parser.emitCodeAddress`). The `__` prefix alone does not decide it: a batched spec case
// runs inside `__spec_case_<n>`, so its lifted closures wear the prefix and are ordinary function
// values. Any other name no function of the module answers to is a body no summary describes.
module function noteFunctionRefBody(name ByteArray, byName FuncIndexByName, named BoolArray, funcSignatures FuncSignatureMap, into CallLandingBodies, bodiless NameRoster)
	if not isFunctionValueBodyName(name, funcSignatures: funcSignatures) 'aDescriptorRoutine'
		return
	end 'aDescriptorRoutine'

	let index = try byName.get(name) otherwise 'noBodyOfThisModule'
		into.unresolved = true
		into.unresolvedMayStore = true
		bodiless.push(name)
		return
	end 'noBodyOfThisModule'

	if not (try named.get(index) otherwise panic("noteFunctionRefBody: function index {index} is past the module's functions")) 'firstMention'
		try named.set(index, value: true) otherwise panic("noteFunctionRefBody: named.set OOB at {index}")
		into.impls.push(index)
	end 'firstMention'
end 'noteFunctionRefBody'

function anyHeldRecordKinds() returns HeldRecordKinds
	var kinds = HeldRecordKinds.create()
	kinds.anything = true
	return kinds
end 'anyHeldRecordKinds'

export union ArgumentParameter
	unnamed
	named(let name ByteArray)

	function displayName() returns String
		return match self 'parameter'
			named(name) gives displayParamName(name)
			unnamed gives "the parameter"
		end 'parameter'
	end 'displayName'
end 'ArgumentParameter'

module union KeptWording
	call(callee String)
	consumed(callee String)
	element(method String)
end 'KeptWording'

module union KeptRefusal
	none
	wording(let wording KeptWording)
end 'KeptRefusal'

export type KeptMasks
	export let letField as ParamPositionMask
	export let letPayload as ParamPositionMask
	export let readOnlyElement as ParamPositionMask
	export let mutable as ParamPositionMask
	export let anyPosition as bool

	export static function create(letField ParamPositionMask, letPayload ParamPositionMask, readOnlyElement ParamPositionMask, mutable ParamPositionMask, anyPosition bool) returns KeptMasks
		return Self{letField: letField, letPayload: letPayload, readOnlyElement: readOnlyElement, mutable: mutable, anyPosition: anyPosition}
	end 'create'
end 'KeptMasks'

function declaredKeptWording(keeps LandingKeeps, position ParamCount, callee String) returns KeptWording
	if keeps.consumes(position) 'consumedByTheBoundary'
		return KeptWording.consumed(callee)
	end 'consumedByTheBoundary'

	return KeptWording.call(callee)
end 'declaredKeptWording'

module function keptArgumentMessage(wording KeptWording, subject String, paramName String) returns String
	return match wording 'wording'
		call(callee) gives deepLetPassedMessage(subject, paramName: paramName, functionName: callee, fate: ArgumentFate.keptWhereWritable)
		consumed(callee) gives deepLetPassedMessage(subject, paramName: paramName, functionName: callee, fate: ArgumentFate.consumed)
		element(method) gives deepLetElementKeptMessage(subject, method: method)
	end 'wording'
end 'keptArgumentMessage'

module function keptWordingOf(func IrFunction, callee ByteArray, sig FuncSignature, args ValueIdArray, position ParamCount) returns KeptWording
	if sig.takesReceiver() and not args.isEmpty() and maxonTypeTag(try sig.paramTypes.get(position) otherwise panic("keptWordingOf: paramTypes.get OOB at {position}")) == ValueTypeTag.typeParameter and valueTagOf(func, value: try args.get(0) otherwise panic("keptWordingOf: args.get(0) on a non-empty list")) == ValueTypeTag.genericInstance 'anElementOfAContainer'
		let member = match splitQualifiedName(overloadRegistrationBaseName(callee)) 'qualified'
			parts(_, member) gives member
			notQualified gives callee
		end 'qualified'

		return KeptWording.element(String.from(member))
	end 'anElementOfAContainer'

	return KeptWording.call(String.from(callee))
end 'keptWordingOf'

module function writtenArgumentMessage(subject String, parameter ArgumentParameter, functionName String) returns String
	return match parameter 'parameter'
		named(name) gives deepLetCallMessage(subject, paramName: displayParamName(name), functionName: functionName)
		unnamed gives "cannot pass {subject} to a call that may write that argument (in {functionName})"
	end 'parameter'
end 'writtenArgumentMessage'

module function callbackWritesHandedValueMessage(writer String, parameter ArgumentParameter, callee String, blamed String) returns String
	return match parameter 'parameter'
		named(name) gives "'{writer}' writes its parameter '{displayParamName(name)}', but '{callee}' passes it the immutable '{blamed}'"
		unnamed gives "'{writer}' may write its arguments, but '{callee}' passes it the immutable '{blamed}'"
	end 'parameter'
end 'callbackWritesHandedValueMessage'

module typealias ArgumentParameterArray = Array with ArgumentParameter

function firstArgumentParameter(parameters ArgumentParameterArray) returns ArgumentParameter
	return try parameters.get(0) otherwise panic("firstArgumentParameter: `landingParamNames` answers at least one parameter")
end 'firstArgumentParameter'

let FieldOfImmutableVariableStorage = "a field of an immutable variable"

typealias ManagedGlobalByLabel = Map with (ByteArray, ManagedGlobal)

// Of the module-level `let`s, `managedGlobals` holds only those `__module_init` builds; an imaged
// `let`'s record kinds come from its declaration.
function moduleLetKindsOf(project Project, signatures ProgramSignatures) returns HeldRecordKinds
	var kinds = signatures.recordKindsOfTypes(moduleGlobalTypesOf(project.managedGlobals, vars: false))
	signatures.addImagedModuleLetKinds(kinds)
	return kinds
end 'moduleLetKindsOf'

function inertGlobalLabelsOf(project Project) returns GlobalDataLabelSet
	var labels = GlobalDataLabelSet.create()

	for global in project.managedGlobals 'eachGlobal'
		if not global.isAVar() and initializerIsAPayloadFreeUnionCase(global.initializer) 'anInertLet'
			labels.insert(global.label)
		end 'anInertLet'
	end 'eachGlobal'

	return labels
end 'inertGlobalLabelsOf'

function initializerIsAPayloadFreeUnionCase(initializer ManagedGlobalInitializer) returns bool
	return match initializer 'initializer'
		record(build) gives recordIsAPayloadFreeUnionCase(build)
		factoryCall gives false
	end 'initializer'
end 'initializerIsAPayloadFreeUnionCase'

function recordIsAPayloadFreeUnionCase(build ManagedGlobalRecord) returns bool
	return match build 'record'
		boxedUnionCaseRecord gives true
		stringRecord or
		constArrayRecord or
		containerRecord gives false
	end 'record'
end 'recordIsAPayloadFreeUnionCase'

function moduleGlobalTypesOf(globals ManagedGlobalArray, vars bool) returns MaxonTypeArray
	var types = MaxonTypeArray.create()

	for global in globals 'eachGlobal'
		if global.isAVar() == vars 'ofTheAskedKind'
			types.push(global.valueType)
		end 'ofTheAskedKind'
	end 'eachGlobal'

	return types
end 'moduleGlobalTypesOf'

function readOnlySlotViewOfKind(kind ElementIndex) returns PermanentView
	return match kind 'kind'
		0 gives PermanentView.letField
		1 gives PermanentView.letPayload
		2 gives PermanentView.readOnlyElement
		default panic("readOnlySlotViewOfKind: {kind} is not one of the {ReadOnlySlotKindCount} read-only slot kinds")
	end 'kind'
end 'readOnlySlotViewOfKind'

function viewRootKind(view PermanentView) returns ReadOnlyRootKind
	return match view 'view'
		none panic("viewRootKind: a value that reaches no permanent view has no root kind")
		sharedView gives ReadOnlyRootKind.sharedView
		letField gives ReadOnlyRootKind.letField
		letPayload gives ReadOnlyRootKind.letPayload
		readOnlyElement gives ReadOnlyRootKind.readOnlyElement
	end 'view'
end 'viewRootKind'

function writeThroughViewMessage(view PermanentView, place String) returns String
	return match view 'view'
		none panic("writeThroughViewMessage: a value that reaches no permanent view is not refused here")
		sharedView gives writeThroughSharedViewMessage(place)
		letField gives "cannot write through '{place}', which may be a record read out of a `let` field that a call or a merge handed back; nothing reachable through a `let` field may be written; use clone()"
		letPayload gives "cannot write through '{place}', which may be a record read out of a `let` payload that a call or a merge handed back; nothing reachable through a `let` payload may be written; use clone()"
		readOnlyElement gives "cannot write through '{place}', which may be a record read out of a `readonly` element that a call or a merge handed back; nothing reachable through a `readonly` element may be written; use clone()"
	end 'view'
end 'writeThroughViewMessage'

function storedIntoWritableFieldMessage(producer String, field String) returns String
	return "cannot store {producer} into writable field '{field}'; use clone()"
end 'storedIntoWritableFieldMessage'

function writeThroughSharedViewMessage(place String) returns String
	return "cannot write through '{place}', which may be the record of a `SharedValue` or registry value a call handed back; use clone()"
end 'writeThroughSharedViewMessage'

function varInitializerTakesAViewsRecordMessage(varName String, callee String) returns String
	return "the initializer of the module-level `var` `{varName}` may hand it a record {readOnlyRootDescription(ReadOnlyRootKind.sharedView)} holds, through `{callee}` — every thread reads that record at once and a `var` may write what it holds, so the two may not share a record. Build the value from a clone() of the read, or make `{varName}` a `let`"
end 'varInitializerTakesAViewsRecordMessage'

function varInitializerTakesALetFieldRecordMessage(varName String, callee String) returns String
	return "the initializer of the module-level `var` `{varName}` may hand it a record a `let` field holds, through `{callee}` — nothing reachable through a `let` field may be written and a `var` may write what it holds, so the two may not share a record. Build the value from a clone() of the read, or make `{varName}` a `let`"
end 'varInitializerTakesALetFieldRecordMessage'

function varInitializerTakesALetPayloadRecordMessage(varName String, callee String) returns String
	return "the initializer of the module-level `var` `{varName}` may hand it a record a `let` payload holds, through `{callee}` — nothing reachable through a `let` payload may be written and a `var` may write what it holds, so the two may not share a record. Build the value from a clone() of the read, or make `{varName}` a `let`"
end 'varInitializerTakesALetPayloadRecordMessage'

function varInitializerTakesAReadOnlyElementRecordMessage(varName String, callee String) returns String
	return "the initializer of the module-level `var` `{varName}` may hand it a record a `readonly` element holds, through `{callee}` — nothing reachable through a `readonly` element may be written and a `var` may write what it holds, so the two may not share a record. Build the value from a clone() of the read, or make `{varName}` a `let`"
end 'varInitializerTakesAReadOnlyElementRecordMessage'

function varInitializerTakesALetRecordMessage(varName String, callee String) returns String
	return "the initializer of the module-level `var` `{varName}` may hand it a record a module-level `let` holds, through `{callee}` — a `let` is fixed at startup and a `var` may write what it holds, so the two may not share a record. Build the value without taking the `let`'s record, or make `{varName}` a `let`"
end 'varInitializerTakesALetRecordMessage'

// The indices of `sites` in token order, and in recorded order among equal tokens.
function moveSitesInTokenOrder(sites MoveSiteArray) returns MoveSiteIndexArray
	var order = MoveSiteIndexArray.create()

	for k in 0 upto sites.count() 'eachSite'
		let token = (try sites.get(k) otherwise panic("moveSitesInTokenOrder: sites.get OOB at {k}")).token
		var at = order.count()

		while at > 0 and (try sites.get(try order.get(at - 1) otherwise panic("moveSitesInTokenOrder: order.get OOB at {at - 1}")) otherwise panic("moveSitesInTokenOrder: a sorted index is past the sites")).token > token 'pastLaterOnes'
			at = at - 1
		end 'pastLaterOnes'

		order.insert(at, value: k)
	end 'eachSite'

	return order
end 'moveSitesInTokenOrder'

// Set rank `rank`'s bit in a dense per-word mask column.
function addRankToWords(words ParamPositionMaskArray, rank ElementIndex)
	let word = rank shr RootWordShift
	let before = try words.get(word) otherwise panic("addRankToWords: words.get OOB at {word}")
	try words.set(word, value: maskWithParam(before, param: (rank and RootBitIndexMask) as ParamCount)) otherwise panic("addRankToWords: words.set OOB at {word}")
end 'addRankToWords'

// Is `door` on one arm of an `if` and `read` on its other arm (`DeferredProvenance.noteExclusiveArms`)?
function onExclusiveArms(arms TokenSpans, door ElementIndex, read ElementIndex) returns bool
	var k = 0 as ElementIndex

	while k + 1 < arms.starts.count() 'eachIf'
		let thenStart = try arms.starts.get(k) otherwise panic("onExclusiveArms: starts.get OOB at {k}")
		let thenEnd = try arms.ends.get(k) otherwise panic("onExclusiveArms: ends.get OOB at {k}")
		let elseStart = try arms.starts.get(k + 1) otherwise panic("onExclusiveArms: starts.get OOB at {k + 1}")
		let elseEnd = try arms.ends.get(k + 1) otherwise panic("onExclusiveArms: ends.get OOB at {k + 1}")
		let doorInThen = door >= thenStart and door < thenEnd
		let doorInElse = door >= elseStart and door < elseEnd
		let readInThen = read >= thenStart and read < thenEnd
		let readInElse = read >= elseStart and read < elseEnd

		if (doorInThen and readInElse) or (doorInElse and readInThen) 'otherArm'
			return true
		end 'otherArm'

		k = k + 2
	end 'eachIf'

	return false
end 'onExclusiveArms'

// Does a loop bound after `declared` enclose both `door` and `read`, so a later trip reaches the read?
function readOnALaterTrip(loops TokenSpans, declared ElementIndex, door ElementIndex, read ElementIndex) returns bool
	for i in 0 upto loops.starts.count() 'eachLoop'
		let start = try loops.starts.get(i) otherwise panic("readOnALaterTrip: starts.get OOB at {i}")
		let finish = try loops.ends.get(i) otherwise panic("readOnALaterTrip: ends.get OOB at {i}")

		if start > declared and door >= start and door < finish and read >= start and read < finish 'bothInIt'
			return true
		end 'bothInIt'
	end 'eachLoop'

	return false
end 'readOnALaterTrip'

function liveUntilAcrossLoops(declared ElementIndex, lastUse ElementIndex, loops TokenSpans) returns ElementIndex
	var until = lastUse
	var widened = true

	while widened 'untilSettled'
		widened = false

		for i in 0 upto loops.starts.count() 'eachLoop'
			let start = try loops.starts.get(i) otherwise panic("liveUntilAcrossLoops: starts.get OOB at {i}")
			let finish = try loops.ends.get(i) otherwise panic("liveUntilAcrossLoops: ends.get OOB at {i} — the spans are pushed together")

			if start > declared and start <= until and until < finish 'usedInsideALoopItOutlives'
				until = finish
				widened = true
			end 'usedInsideALoopItOutlives'
		end 'eachLoop'
	end 'untilSettled'

	return until
end 'liveUntilAcrossLoops'

// What a door asks of a root besides that it counts there and that its type admits the value (`leastAdmittedRank`):
// nothing, or that the slot both were read out of was not replaced in between.
enum RootCondition
	none
	slotNotRewritten
	aKeptName
	aStoredName
end 'RootCondition'

// How far a door's question reaches from a value: to the bindings it may be, or to those it may also lie within.
enum RootReach
	identity
	identityOrInside
end 'RootReach'

// Does a callee of this shape store into argument `receiverIndex`?
module function shapeStoresInto(shape RuntimeStoreShape, receiverIndex ParamCount) returns bool
	return match shape 'shape'
		intoAnyOperand gives true
		intoTheReceiver or
		intoTheReceiverPastAnAnchor or
		theSourcesElementsIntoTheReceiver gives receiverIndex == RuntimeStoreReceiverIndex
		nothing gives false
	end 'shape'
end 'shapeStoresInto'

// Does a callee of this shape store argument `storedIndex` (into a receiver other than it)?
module function shapeStoresOperand(shape RuntimeStoreShape, storedIndex ParamCount) returns bool
	return match shape 'shape'
		intoAnyOperand or
		intoTheReceiver gives true
		intoTheReceiverPastAnAnchor gives storedIndex > RuntimeStoreAnchorIndex
		theSourcesElementsIntoTheReceiver gives storedIndex == RuntimeStoreSourceIndex
		nothing gives false
	end 'shape'
end 'shapeStoresOperand'

// Every tag but `named`, which `ProvenanceTracer.typeCarriesProvenance` asks the declaration about.
function tagCarriesProvenance(tag ValueTypeTag) returns bool
	return tagIsByteRecord(tag) or tagNamesADeclaredType(tag) or tag == ValueTypeTag.genericInstance or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.function
end 'tagCarriesProvenance'

module typealias ReturnedValueTest = function(ValueId) returns bool

module function anyReturnedValue(func IrFunction, ir MaxonModule, test ReturnedValueTest) returns bool
	for blockRef in func.blockRefs 'eachBlock'
		view block = try ir.blocks.get(blockRef) otherwise panic("anyReturnedValue: blockRef from func.blockRefs not in module.blocks")

		if not block.hasTerminatorOp() 'unterminated'
			continue
		end 'unterminated'

		let returned = try returnedValueOf(try ir.ops.get(block.terminatorIndex()) otherwise panic("anyReturnedValue: terminatorIndex not in module.ops")) otherwise continue

		if test(returned) 'aMatch'
			return true
		end 'aMatch'
	end 'eachBlock'

	return false
end 'anyReturnedValue'

function returnedValueOf(terminator MaxonOp) returns ValueId throws AbsentError
	match terminator 'term'
		ret(returned) then return returned

		call or
		literal or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd then throw AbsentError.absent
	end 'term'
end 'returnedValueOf'

let MapInsertName = b"Map.insert"
let MapUpsertName = b"Map.upsert"
let MapInsertAtSlotName = b"Map.insertAtSlot"
let SetInsertName = b"Set.insert"
let SetInsertAtSlotName = b"Set.insertAtSlot"

enum StoredKeyColumnOwner
	map
	set
	neither
end 'StoredKeyColumnOwner'

function opWritesARawResource(op MaxonOp) returns bool
	return match maxonOpCalleeKind(op) 'kind'
		direct gives rawResourceWritingCallee(maxonOpCalleeName(op))
		functionValue or
		noCallee gives false
	end 'kind'
end 'opWritesARawResource'

function calleeReadsAStoredSetElement(callee ByteArray) returns bool
	return match splitQualifiedName(callee) 'shape'
		parts(prefix, member) gives member.equals(CursorCurrentMethod) and String.from(prefix).startsWith(SetCursorTypePrefix)
		notQualified gives false
	end 'shape'
end 'calleeReadsAStoredSetElement'

function storedKeyColumnOwnerOf(name ByteArray) returns StoredKeyColumnOwner
	if name.equals(MapInsertName) or name.equals(MapUpsertName) or name.equals(MapInsertAtSlotName) 'aMapStore'
		return StoredKeyColumnOwner.map
	end 'aMapStore'

	if name.equals(SetInsertName) or name.equals(SetInsertAtSlotName) 'aSetStore'
		return StoredKeyColumnOwner.set
	end 'aSetStore'

	return StoredKeyColumnOwner.neither
end 'storedKeyColumnOwnerOf'

// Can a value of one tag be the very record a value of the other is? Only a record of one representation
// is — an opaque `T` and an existential may stand for any — so an op's result is not its operand merely
// for having one: an indirect call's `String` is not the closure it called through.
function mayBeOneRecord(tag ValueTypeTag, other ValueTypeTag) returns bool
	if tag == other or (tagIsByteRecord(tag) and tagIsByteRecord(other)) 'oneRepresentation'
		return true
	end 'oneRepresentation'

	return tagIsOpaqueRecord(tag) or tagIsOpaqueRecord(other)
end 'mayBeOneRecord'

module function tagIsOpaqueRecord(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef
end 'tagIsOpaqueRecord'

union DefiningOp
	notAnOp
	op(index ElementIndex)
end 'DefiningOp'

// What an op does with a field slot: reads it, stores into it, or retains a value — which a `let` bound out of a
// rebindable slot is — or none of these.
export union SlotRead
	none
	load(opIndex ElementIndex, addr ValueId, offset ByteOffset)
	store(addr ValueId, offset ByteOffset, value ValueId)
	retainOf(operand ValueId)
end 'SlotRead'

// What a block's ops met first, scanning for one read of a slot: that read, a store into the slot, or neither.
enum SlotScan
	reached
	stored
	ranOff
end 'SlotScan'

function tagIsKnownNotToAddressADeclaredRecord(tag ValueTypeTag) returns bool
	return match tag 'tag'
		named or
		string or
		character or
		function or
		boolean or
		integer or
		float or
		exitCode or
		void or
		cstring gives true

		unresolved or
		typeParameter or
		interfaceRef or
		structRef or
		genericInstance gives false
	end 'tag'
end 'tagIsKnownNotToAddressADeclaredRecord'

// Is `op` a load out of a slot or a store into one — the only ops whose `SlotRead` a scan over a body asks about
// beyond its own read? Asked first there, so every other op builds no `SlotRead` box.
function opLoadsOrStoresASlot(op MaxonOp) returns bool
	return match op 'op'
		loadIndirect or
		storeIndirect gives true

		call or
		literal or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives false
	end 'op'
end 'opLoadsOrStoresASlot'

export function slotReadOfOp(op MaxonOp, opIndex ElementIndex) returns SlotRead
	match op 'op'
		loadIndirect(_, addr, offset, _) then return SlotRead.load(opIndex, addr: addr, offset: offset)
		storeIndirect(addr, offset, value, _) then return SlotRead.store(addr, offset: offset, value: value)
		call(_, callee, args, _, _, _, _, _) then return SlotRead.retainOf(try args.get(0) otherwise panic("slotReadOfOp: a retain has no operand")) if ownershipBookkeepingCallee(callee) and args.count() > 0 else SlotRead.none
		holdValue(_, held, _, _, _) then return SlotRead.retainOf(held)
		literal or
		ret or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdEnd then return SlotRead.none
	end 'op'
end 'slotReadOfOp'

// The `__ManagedList` entries that link a new node into their receiver chain and hand back its handle.
module function linksANewNodeCallee(callee ByteArray) returns bool
	return callee.equals(ListAppendName) or callee.equals(ListPrependName) or callee.equals(ListInsertAfterName) or callee.equals(ListInsertBeforeName)
end 'linksANewNodeCallee'

// What the op defining a value does toward the record it was read out of, as an access path sees it: nothing — the
// value is a root — a step into a field of its base, an element of it, or the base's own record handed back.
enum AccessHopKind
	stop
	field
	element
	same
end 'AccessHopKind'

typealias AccessHopKindArray = Array with AccessHopKind

function slotReadIsLoadOp(read SlotRead, opIndex ElementIndex) returns bool
	return match read 'read'
		load(loadOp, _, _) gives loadOp == opIndex

		none or
		store or
		retainOf gives false
	end 'read'
end 'slotReadIsLoadOp'

function storeSlotKey(addr ValueId, offset ByteOffset) returns StoreSlotKey
	return ((addr as StoreSlotKey) shl StoreSlotValueShift) or (offset as StoreSlotKey)
end 'storeSlotKey'

function storeSlotAddress(key StoreSlotKey) returns ValueId
	return (key shr StoreSlotValueShift) as ValueId
end 'storeSlotAddress'

function storeSlotOffset(key StoreSlotKey) returns StoreSlotKey
	return key and StoreSlotOffsetMask
end 'storeSlotOffset'

module function valueTagOf(func IrFunction, value ValueId) returns ValueTypeTag
	return try func.valueTags.get(value) otherwise panic("StorageProvenance.valueTagOf: v{value} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
end 'valueTagOf'

function loadResultOf(op MaxonOp) returns ValueId
	match op 'op'
		loadIndirect(result, _, _, _) then return result
		default panic("loadResultOf: handed an op that is not a load")
	end 'op'
end 'loadResultOf'

function worseRecordUse(held RecordUse, next RecordUse) returns RecordUse
	return next if next.ordinal > held.ordinal else held
end 'worseRecordUse'

function singletonValue(value ValueId) returns ValueIdArray
	var values = ValueIdArray.create()
	values.push(value)
	return values
end 'singletonValue'

function recordAliasEdges(aliased ParamPositionMask, calleeIndex ElementIndex, callerIndex ElementIndex, calleeParam ParamCount, edges CallParamEdges)
	if aliased == NoParamPositions 'noParameterAliased'
		return
	end 'noParameterAliased'

	for p in 0 upto RootBitIndexMask + 1 'eachCallerParam'
		if maskHasParam(aliased, param: p as ParamCount) 'mayBeThisParameter'
			edges.record(calleeIndex, callerIndex: callerIndex, callerParam: p as ParamCount, calleeParam: calleeParam)
		end 'mayBeThisParameter'
	end 'eachCallerParam'
end 'recordAliasEdges'

function movedValueReadMessage(site MoveSite) returns String
	if site.readInALaterIteration 'inALaterIteration'
		return movedInAnEarlierIterationMessage(String.from(site.source))
	end 'inALaterIteration'

	return useOfMovedValueMessage(String.from(site.source))
end 'movedValueReadMessage'

function filesVarCandidates(sites ProvenanceSites) returns bool
	return match sites.varCandidates 'candidates'
		none gives false
		filed gives true
	end 'candidates'
end 'filesVarCandidates'

function hygienePositionKeyOf(diagnostic Diagnostic) returns PositionKey
	let site = hygieneSiteOf(diagnostic)
	return positionKey(site.1, column: site.2)
end 'hygienePositionKeyOf'

function hygieneDiagnosticsAreOne(recorded Diagnostic, reported Diagnostic) returns bool
	let (recordedFile, recordedLine, recordedColumn) = hygieneSiteOf(recorded)
	let (reportedFile, reportedLine, reportedColumn) = hygieneSiteOf(reported)
	return recorded.code == reported.code and recordedLine == reportedLine and recordedColumn == reportedColumn and recordedFile == reportedFile
end 'hygieneDiagnosticsAreOne'

function hygieneSiteOf(diagnostic Diagnostic) returns (FilePath, LineNumber, ColumnNumber)
	match diagnostic.anchor 'anchor'
		at(filePath, line, column) then return (filePath, line, column)
		programWide or
		file then panic("binding hygiene: {diagnostic.code.rawValue} is recorded at a binding's own span by `Parser.recordBindingHygieneDiagnostic`, so it has a line to be indexed by")
	end 'anchor'
end 'hygieneSiteOf'
